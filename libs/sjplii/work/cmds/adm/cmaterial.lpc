// create material
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string cname,*name;
        string f_name;
        string filename;
        int level,type,clvl,name1,weit,base_damage,max_enchant;
        string ccolor,material,cid,newfile;
        
        string *sword_name = ({ "木剑" ,"wood",
                                "铁剑" ,"iron",
                                "长剑" ,"iron",
                                "白刃剑","steel",
                                "巨剑", "steel",
                                "宽刃剑" , "iron",
                                "护手剑","steel",
                                "锯齿剑","heavyiron",
                                "邪神剑","heavyiron",
                                "寒冰剑","adularia",});
        string *blade_name = ({ "木刀" , "wood",
                                "铁刀" , "iron",
                                "弯月刀" , "steel",
                                "淬毒刀" , "iron",
                                "双刃刀" , "steel",
                                "大斩马刀" , "steel",
                                "龙牙刀" , "dragonbone",
                                "日轮刀" , "crystal",
                                "水晶刀" , "crystal",
                                "破魔刀" , "heavyiron",}        );
        string *axe_name =   ({ "铁斧" , "iron",
                                "大斧" , "iron",
                                "烈刃斧" , "heavyiron",
                                "双刃斧" , "heavyiron",
                                "龙牙斧" , "dragonbone",
                                "日轮斧" , "crystal", });
        string *hammer_name =({ "木鱼" , "iron",
                                "石锤" , "iron",
                                "铁锤" , "iron",
                                "大铁锤" , "iron",
                                "流星锤" , "heavyiron",
                                "狼牙锤" , "steel",
                                "日月锤" , "copper", });
        string *spear_name = ({ "木枪" , "wood",
                                "长矛" , "iron",
                                "钢矛" , "steel",  
                                "骑士枪","steel",
                                "战矛" , "steel",
                                "白银枪","silver",});
        string *staff_name = ({ "木杖" , "wood",
                                "铁杖" , "iron",
                                "铜杖" , "copper", 
                                "老藤杖" , "wood", 
                                "蛟龙杖" , "stone",
                                "龙牙杖" , "dragonbone",
                                "钻石杖" , "jade", });
        string *banzhi_name= ({ "大理石板指" , "stone",
                                "铜指环" , "copper",
                                "刺针指环" , "copper",
                                "白银指环" , "silver",
                                "精钢指环" , "steel",
                                "淬毒指环" , "steel",
                                "皇帝指环" , "jade",
                                "诅咒指环" , "stone"});
        string *armor_name = ({ "铁板甲" , "iron",
                                "青镫甲" , "steel",
                                "重镫甲" , "heavyiron",
                                "精钢镫甲" , "steel",
                                "魔法镫甲" , "magicstone",
                                "龙鳞镫甲" , "dragonbone", });
        string *surcoat_name=({ "布袍" , "cloth",
                                "法师袍" , "cloth",
                                "僧侣袍" , "cotton",
                                "祭师袍" , "cloth",
                                "贤哲袍" , "silk",
                                "星月袍" , "silk",
                                "圣袍" , "cloth",
                                "金缕袍" , "cloth",
                                "武道服" , "cotton",
                                "锈龙道服" , "cotton", });
        string *ring_name  = ({ "光之水晶" , "crystal",
                                "炎之魔石" , "stone",
                                "雷之魔石" , "stone",
                                "冰之魔石" , "stone",
                                "空之宝石" , "stone",
                                "风精之羽" , "silk", });
        
        string *first_name = ({ "","圣光","地狱","大地","精灵","天空","封魔","黑暗","日轮","光明"});

        sscanf(arg,"%d %d",clvl, type);
        
        for (name1 =0 ;name1 < 10; name1++){
                for (level =0; level < 20; level+=2 ) {
        switch(clvl){
        case 0:
                ccolor = "GRN";
                filename = "/obj/material/normal/material";
                break;
        case 1:
                ccolor = "HIW";
                filename = "/obj/material/silver/material";
                break;
        case 2:
                ccolor = "HIC";
                filename = "/obj/material/bronze/material";
                break;
        case 3:
                ccolor = "HIG";
                filename = "/obj/material/green/material";
                break;
        case 4:
                ccolor = "HIY";
                filename = "/obj/material/gold/material";
                break;
        }
        
        f_name = first_name[name1];
        
        switch( type ) {
                case 0:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","AXE");
                        newfile = replace_string(newfile,"init_type","init_axe");
                        newfile = replace_string(newfile,"UNIT","把");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        base_damage = 25;
                        if (level >= sizeof(axe_name)) continue;
                        cname = f_name + axe_name[level];
                        material = axe_name[level+1];
                        cid = "axe";
                        break;
                case 1:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","BLADE");
                        newfile = replace_string(newfile,"init_type","init_blade");
                        newfile = replace_string(newfile,"UNIT","把");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(blade_name)) continue;
                        cname = f_name + blade_name[level];
                        material = blade_name[level+1];
                        base_damage = 10;
                        cid = "blade";
                        break;
                case 2:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","HAMMER");
                        newfile = replace_string(newfile,"init_type","init_hammer");
                        newfile = replace_string(newfile,"UNIT","把");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(hammer_name)) continue;
                        cname = f_name + hammer_name[level];
                        material = hammer_name[level+1];
                        base_damage = 20;
                        cid = "hammer";
                        break;
                case 3:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","STAFF");
                        newfile = replace_string(newfile,"init_type","init_staff");
                        newfile = replace_string(newfile,"UNIT","把");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(staff_name)) continue;
                        cname = f_name + staff_name[level];
                        material = staff_name[level+1];
                        base_damage = 18;
                        cid = "staff";
                        break;
                case 4:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","SWORD");
                        newfile = replace_string(newfile,"init_type","init_sword");
                        newfile = replace_string(newfile,"UNIT","把");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(sword_name)) continue;
                        cname = f_name + sword_name[level];
                        material = sword_name[level+1];
                        base_damage = 8;
                        cid = "sword";
                        break;
                case 5:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","SPEAR");
                        newfile = replace_string(newfile,"init_type","init_spear");
                        newfile = replace_string(newfile,"UNIT","杆");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(spear_name)) continue;
                        cname = f_name + spear_name[level];
                        material = spear_name[level+1];
                        base_damage = 12;
                        cid = "spear";
                        break;
                case 6:
                        newfile = read_file("/obj/weaponskin.o");
                        newfile = replace_string(newfile,"WEAPONTYPE","RING");
                        newfile = replace_string(newfile,"init_type","init_ring");
                        newfile = replace_string(newfile,"UNIT","个");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_weapon\",1);" );
                        if (level >= sizeof(banzhi_name)) continue;
                        cname = f_name + banzhi_name[level];
                        material = banzhi_name[level+1];
                        base_damage = 5;
                        cid = "banzhi";
                        break;
                case 7:
                        newfile = read_file("/obj/clothskin.o");
                        newfile = replace_string(newfile,"CLOTHTYPE","ARMOR");
                        newfile = replace_string(newfile,"UNIT","件");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_armor\",1);" );
                        if (level >= sizeof(armor_name)) continue;
                        cname = f_name + armor_name[level];
                        material = armor_name[level+1];
                        base_damage = 25;
                        cid = "armor";
                        break;
                case 8:
                        newfile = read_file("/obj/clothskin.o");
                        newfile = replace_string(newfile,"CLOTHTYPE","SURCOAT");
                        newfile = replace_string(newfile,"UNIT","件");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_armor\",1);" );
                        if (level >= sizeof(surcoat_name)) continue;
                        cname = f_name + surcoat_name[level];
                        material = surcoat_name[level+1];
                        base_damage = 20;
                        cid = "surcoat";
                        break;
                case 9:
                        newfile = read_file("/obj/clothskin.o");
                        newfile = replace_string(newfile,"CLOTHTYPE","NECK");
                        newfile = replace_string(newfile,"UNIT","个");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_armor\",1);" );
                        if (level >= sizeof(ring_name)) continue;
                        cname = ring_name[level];
                        material = ring_name[level+1];
                        base_damage = 6;
                        cid = "gemneck";
                        break;
                case 10:
                        newfile = read_file("/obj/clothskin.o");
                        newfile = replace_string(newfile,"CLOTHTYPE","FINGER");
                        newfile = replace_string(newfile,"UNIT","个");
                        newfile = replace_string( newfile, "set(\"timestamp\",\"STAMP\");","set(\"forge_for_armor\",1);" );
                        if (level >= sizeof(ring_name)) continue;
                        cname = ring_name[level];
                        material = ring_name[level+1];
                        base_damage = 2;
                        cid = "ring";
                        break;
        }
        
        switch( material) {
                case "wood":
                        weit = 500;
                case "crystal":
                        weit = 500;
                case "jade":
                        weit = 500;
                case "quartz":
                        weit = 750;
                case "stone":
                        weit = 550;
                case "steel":
                        weit = 1500;
                case "iron":
                        weit = 1200;
                case "copper":
                        weit = 1200;
                case "silver":
                        weit = 1500;
                case "gold":
                        weit = 2000;
                case "heavyiron":
                        weit = 2500;
                case "silk":
                        weit = 200;
                case "cloth":
                        weit = 500;
                case "cotton":
                        weit = 500;
                default:
                        weit = 1500;
        }
                
        newfile = replace_string( newfile, "模板", cname);
        newfile = replace_string( newfile, "order", cid);
        newfile = replace_string( newfile, "COR", ccolor);
        newfile = replace_string( newfile, "MATERIAL", material);
        newfile = replace_string( newfile, "BASE_DAMAGE","" + base_damage);
        newfile = replace_string( newfile, "BASE_ARMOR","" + base_damage);
        newfile = replace_string( newfile, "VALUE", ""+ ((name1+1+random(5)) * 500 + random(1000)));
        newfile = replace_string( newfile, "MAX_ENCHANT", ""+clvl);
        newfile = replace_string( newfile, "RIGIDITY", ""+ ((level+1) * 200) );
        newfile = replace_string( newfile, "WEIGHT", ""+ (weit*base_damage));
        if (type <7 )
                newfile = replace_string( newfile, "set(\"owner\",\"darks\");", "set(\"weapon_prop/attack\","+ level*2 + ");");
        else newfile = replace_string( newfile, "set(\"owner\",\"darks\");", "set(\"armor_prop/defense\","+ level*2 + ");");
        newfile = replace_string( newfile, "WEAPON_DAMAGE", ""+ (base_damage*clvl + (level+1)*(name1+1) ) );
        newfile = replace_string( newfile, "CLOTH_ARMOR", ""+ (base_damage*clvl + (level+1)*(name1+1) ) );
        
        filename += "_"+ type + name1 + (level/2) + ".lpc";
        write_file(filename, newfile,1);
}
}
        write("OK now\n");
        return 1;
}

