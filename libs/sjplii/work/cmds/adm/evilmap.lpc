// /cmds/arch/evilmap
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  string file, new_file;
  int i;
  if (!arg)
    return 0;
  file = read_file(arg + "evil00.lpc");
  for (i = 1; i < 100; i++) {
    if (i < 10)
      new_file = arg + "evil0" + i;
    else new_file = arg + "evil" + i;
    "/cmds/wiz/dest"->main(me, new_file + ".lpc");
    write_file(new_file + ".lpc", file, 1);
  }
  write("ok\n");
  return 1;
}
