// more /cmds/arch/getallskills
// overview.c
#include <ansi.h>
inherit F_CLEAN_UP;
string my_status(object me, string type);

int main(object me, string arg) {
  string *files, file, *performs;
  int i, j;
  string all_skills = "";

  files = get_dir("/daemon/skill/");
  for (i = 0; i < sizeof(files); i++) {
    file = replace_string(files[i], ".lpc", "");
    all_skills += to_chinese(file) + "(" + file + ")\n特殊技";
    if (!(SKILL_D(file)->perform_action_file(""))) {
      if (!(SKILL_D(file)->exert_function_file(""))) {
        if (!(SKILL_D(file)->cast_spell_file(""))) {
          if (!(SKILL_D(file)->curse_curses_file(""))) {
            if (!(SKILL_D(file)->conjure_magic_file(""))) {
              if (!(SKILL_D(file)->scribe_spell_file(""))) {
                all_skills += "无。\n\n";
              } else {
                all_skills += "(scribe)：";
                performs = get_dir(SKILL_D(file)->scribe_spell_file(""));
                for (j = 0; j < sizeof(performs); j++)
                  all_skills += replace_string(performs[j], ".lpc", "") + " ";
                all_skills += "。\n";
              }
            } else {
              all_skills += "(conjure)：";
              performs = get_dir(SKILL_D(file)->conjure_magic_file(""));
              for (j = 0; j < sizeof(performs); j++)
                all_skills += replace_string(performs[j], ".lpc", "") + " ";
              all_skills += "。\n\n";
            }
          } else {
            all_skills += "(curse)：";
            performs = get_dir(SKILL_D(file)->curse_curses_file(""));
            for (j = 0; j < sizeof(performs); j++)
              all_skills += replace_string(performs[j], ".lpc", "") + " ";

            all_skills += "。\n\n";
          }
        } else {
          all_skills += "(cast)：";
          performs = get_dir(SKILL_D(file)->cast_spell_file(""));
          for (j = 0; j < sizeof(performs); j++)
            all_skills += replace_string(performs[j], ".lpc", "") + " ";
          all_skills += "。\n\n";
        }
      } else {
        all_skills += "(exert)：";
        performs = get_dir(SKILL_D(file)->exert_function_file(""));
        for (j = 0; j < sizeof(performs); j++)
          all_skills += replace_string(performs[j], ".lpc", "") + " ";
        all_skills += "。\n\n";
      }
    } else {
      all_skills += "(perform)：";
      performs = get_dir(SKILL_D(file)->perform_action_file(""));
      for (j = 0; j < sizeof(performs); j++)
        all_skills += replace_string(performs[j], ".lpc", "") + " ";
      all_skills += "。\n\n";

    }

  }
  write_file("/doc/all_perform.lpc", all_skills, 1);
  write("ok\n");
  return 1;
}

string my_status(object me, string type) {
  string line = "─";
  int i, max, c, e, m;
  max = me->query("max_" + type);
  m = max / 20;
  c = me->query(type) / m;
  e = me->query("eff_" + type) / m;
  switch (type) {
    case "gin":
      line = NOR + HIC + line;
      break;
    case "kee":
      line = NOR + HIY + line;
      break;
    case "sen":
      line = NOR + HIG + line;
      break;
  }
  for (i = 0; i < c; i++)
    line += "─";
  line += BLU;
  for (i = 0; i < (e - c); i++)
    line += "─";
  if (e < 20) {
    line += NOR + RED;
    for (i = 0; i < (20 - e); i++)
      line += "─";
  }
  return line;
}

void show() {
  int i;
  for (i = 0; i < 10; i++)
    write(ESC + "[1A" + ESC + "[200D" + ESC + "[K" NOR);
}

int help() {
  write(@TEXT
指令格式：overview <主题>

user:           userp()
living:         living()
room:           function_exists("create_door", ob);
TEXT
  );
  return 1;
}
