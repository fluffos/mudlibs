// edit.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string file) {
  string pf;
  if (!file) return notify_fail("指令格式：edit <档名>\n");

  if (in_edit(me)) return notify_fail("你已经在使用编辑器了。\n");

  pf = resolve_path(me->query("cwd"), file);
  printf("编辑: %s \n", pf);
  seteuid(geteuid(me));
  if (file_size(pf) > 0 && !read_file(pf))
    return notify_fail("【安全系统】你不能编辑这个文件！\n");
  ed(pf);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令(v2.0)可直接在线上编辑档案。
HELP
  );
  return 1;
}
