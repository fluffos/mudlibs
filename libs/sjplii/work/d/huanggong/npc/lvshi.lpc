#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("吕史", ({ "lv shi", "lv" }) );
        set("gender", "男性");
        set("age", 55);
        set("long","吕史是殿前都护，当年闯荡江湖时曾被誉为［南枪北拐］中的南枪。\n");
        set("combat_exp", 1350000);
	set("title", "殿前都护");
	set("nickname", YEL"金枪将"NOR);
        set("attitude", "friendly");
	set("vendetta_mark", "authority");
	set("class", "official");
	set("id_type", 4);
	set("per", 25);
        set("str", 65);
        set("max_kee", 850);
        set("max_gin", 600);
	set("max_mana", 500);
	set("mana", 500);
        set("force", 600);
        set("max_force", 600);
        set("force_factor", 35);
        set_skill("spear", 300);
        set_skill("unarmed", 200);
	set_skill("yuanyang_tui", 200);
	set_skill("officialism",120);
	set_skill("strategy",120);
        set_skill("parry", 80);
        set_skill("dodge", 80);
	set_skill("bainiao_spear", 300);
	map_skill("spear", "bainiao_spear");
	map_skill("parry", "bainiao_spear");
	map_skill("unarmed", "yuanyang_tui");
        setup();

        carry_object("/d/city/obj/weapon/spear/jinspear")->wield();
        carry_object("/d/city/obj/armor/tongjia")->wear();
}
void attempt_apprentice(object me)
{
       if(me->query_skill("officialism",1)< 70) {
	    command("say 你的为官之道太差了。\n");
	    return;
	}	
       if(me->query_skill("strategy",1)< 70) {
	    command("say 你的兵法战策太差了。\n");
	    return;
	}	
 	if( me->query("class")=="official" && me->query("id_type")==4)
	{
	command("smile");
	command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
	}
	if(me->query("id_type") == 3)
	{
	command("say 你已经是吏部的官员了！\n");
	}
	if(me->query("id_type") == 5)
	{
	command("say 你已经是刑部的官员了！\n");
	}
	else
	command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
		ob->set("vendetta_mark", "authority");
                ob->set("id_type", 4);
                ob->set("title", "小兵");
}
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("relation_exp")*2+(int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","小兵");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","校尉");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","中郎将");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","牙将");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","偏将");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","参将");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","副将");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","大将军");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","兵马统领");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","兵马大都督");
                return ;
        } else if ( exp <= 16244000 ) {
                student->set("title","平西王");
                return ;
}
}
int accept_fight(object me)
{
        command("say 我为殿前将军，岂能与你村野匹夫较艺！");
        return 0;
}


