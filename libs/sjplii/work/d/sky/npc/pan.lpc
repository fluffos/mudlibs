#include <ansi.h>
inherit NPC;
int about_he();

void create() {
  set_name("飞鸿", ({ "fei hong", "fei", "hong" }));
  set("title", "义薄云天");
  set("nickname", HIR "弹剑神侠" NOR);
  set("gender", "男性");
  set("age", 30);
  set("str", 30);
  set("int", 30);
  set("per", 30);
  set("long",
    "他是书剑飘零的天神。\n");
  set("attitude", "peaceful");
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 90);
  set("mana", 2000);
  set("max_mana", 2000);
  set("mana_factor", 20);

  set("combat_exp", 9000000);
  set("score", 90000);
  set_skill("sword", 350);
  /*
        set("chat_chance", 10);
        set("chat_msg", ({
                GRN"飞鸿(pan)告诉你：\n"NOR,
        }) );
*/
  set("inquiry", ([
    "home": (: about_he :),
  ]));
  create_family("飞白工作室", 1, "创始人");
  setup();
}

int recognize_apprentice(object ob) {
  return 1;
}
int about_he() {
  object me;
  string sleeproom;
  me = this_player();
  sleeproom = me->query_temp("in_sleeping");
  if (me->query_temp("in_sleeping")) {
    tell_object(me, MAG "\n飞鸿微笑着点了点头。\n" NOR);
    tell_object(me, CYN "\n你慢慢睁开眼来，刚才梦里的一切仿佛还历历在目。\n" NOR);
    tell_object(me, "\n你从睡梦中醒过来，该活动一下手脚了。\n\n");
    message("vision",
      me->name() + "从睡梦中醒过来，揉了揉眼睛，伸展了一下手脚。\n",
      environment(me), ({ me }));
    me->move(sleeproom);
    me->delete_temp("in_sleeping");
    me->delete_temp("sleeping");
    return 1;
  } else
    tell_object(me, MAG "\n飞鸿奇怪地看着你，说道：你是怎么来到这里的？\n" NOR);
  return 1;
}
