#include <ansi.h>
inherit NPC;
int about_quest();

void create()
{
  set_name("孟庭坚", ({ "meng tingjian", "meng", "tingjian", "da chen" }));
  set("title", "大臣");
  set("gender", "男性");
  set("age", 60);
  set("per", 30);
  set("combat_exp", 300000);
  set_skill("force", 80);
  set_skill("spells", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("gin", 3000);
  set("max_gin", 3000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 80);
         set("inquiry", ([
                "quest" : (: about_quest :),
        ]));
 setup();
  carry_object("/d/city/obj/cloth/jinpao")->wear();
}
void init()
{
	add_action("do_cancel", "cancel");
}

int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!me->query("quest/guanfu")||(int)me->query("quest/guanfu")==0)
          return notify_fail("你现在没有任务。\n");
	message_vision("\n$N向孟庭坚请罪。\n",me);
	say( CYN"\n孟庭坚冷冷说道：哼，你还有何面目回来见我？推出去斩了！\n"NOR);
	message_vision(RED"\n两旁刀斧手一涌而上，将$N押往午门。\n"HIW,me);
	me->move("/d/city/wumen");
	message_vision(HIR"\n$N被五花大绑推上了断头台。\n"NOR,me);
	message_vision(HIR"\n刀斧手手起刀落，将$N的人头砍了下来。。。\n"NOR,me);
	me->set("quest/battle", 0);
	me->die();
	return 1;
}

int about_quest()
{
	object money;
	object me=this_player();
	int rate;
	rate = random(50);

	if( me->query("class") != "official" ) return 0;
	if( (int)me->query("id_type") != 3 ) return 0;
	if( (int)me->query("combat_exp") > 30000000 ) 
	{
	command("say 大人功勋卓著，国家大事已无需再操劳了。\n");
	return 1;
	}
	if( rate < 20 ) 
		{command("say 速去军校场听候浑缄元帅调遣。\n");
		me->set("quest/battle", "masterhun");
		return 1;}

	if( me->query("quest/guanfu")=="done" )
	{
	command("say 很好，你治国有功，赏赐白银一百两，进爵二十点！\n");
	money=new("/obj/money/hundred-cash");
	money->move(me);
	me->add("relation_exp", 20);
	me->delete("quest/guanfu");
	return 1;
	}
	if( me->query("quest/guanfu") && (int)me->query("quest/guanfu")!=0 )
	{
	command("say 你正有重任在身，快去完成它吧！\n");
	return 1;
	}
	command("say 今秋农业大丰收，你速去太室山脚的粮田指挥收稻。\n");
	me->set("quest/guanfu","farm");
        say( "孟庭坚转身离开了。\n");
	this_object()->move("/u/baiwt/npc_hut.lpc");
	return 1;
}

int accept_object(object who, object ob)
{
        int val;
        val = ob->value();
        if( !val )
                return 0;
        else if( val >= 100000) {
	if( who->query("relation_exp") < 500000 )
	who->add("relation_exp", -random(10));
        }
        say( "孟庭坚说道：这位" + RANK_D->query_respect(who)
                + "胆子可真不小，竟然在皇宫内行贿。\n");
        return 1;
}

