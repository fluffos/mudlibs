// Room: /u/shandong/hl-dong1.c

inherit ROOM;
int do_climb(string str);
int do_search(string str);

void create()
{
	set("short", "黑龙潭的山洞");
	set("long", @LONG
这里是黑龙潭的山洞。进了这山洞你不禁有点害怕，这里黑压压的
满地都是白骨。北面的洞壁上好象还有些字迹。你心下嘀咕着：“不是
啥好玩的地方，快跑吧。”
    现在你只能爬下去(climb down)。
LONG
	);
       set("item_desc",([ /* sizeof() == 1 */
  "字迹" : "这里竟然有一行用大力金刚手法刻上去的字！
            黑龙居士，隐居于此，若等闲人，请速离去！
",
]));
	set("hell", 1);

	setup();
}
void init()
{
	add_action("do_climb", "climb");
	add_action("do_search", "search");
}
int do_climb(string str)
{
	object room, me=this_player();

	if( str != "down") return 0;
	if(me->query_skill("move",1)<10) 
	{
	message_vision("$N抓住长藤往下爬去，结果手一滑，笔直朝山下跌了下去！\n",me);
	me->die();
	return 1;
	}
	else
	message_vision("$N抓住长藤往下爬去。\n",me);
	if(!( room = find_object(__DIR__"hl-pubu")) )
		room = load_object(__DIR__"hl-pubu");
	me->move(room);
	return 1;
}
int do_search(string str)
{
	object room, me=this_player();

	if( str != "洞壁") return 0;
	message_vision("$N贴着洞壁朝黑暗处摸索了进去。\n",me);
	if(!( room = find_object(__DIR__"hl-dong2")) )
		room = load_object(__DIR__"hl-dong2");
	me->move(room);
	return 1;
}
