// meat.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("生肉", ({ "fresh meat","meat" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块鲜血淋漓的生肉。\n");
		set("unit", "块");
		set("value", 20);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
