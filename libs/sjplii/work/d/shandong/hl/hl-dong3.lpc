// Room: /u/shandong/hl-dong3.c

inherit ROOM;
int do_hole(string str);

void create()
{
	set("short", "黑龙洞");
	set("long", @LONG
你从洞口钻了进来。这个洞洞口虽小里面却大得很。地上都是些白骨、
青苔之类。
    现在你只能钻出去(hole out)。
LONG
	);
	set("hell", 1);

	setup();
}
void init()
{
	add_action("do_hole", "hole");
}
int do_hole(string str)
{
	object room, me=this_player();

	if( str != "out") return 0;
	if(me->query_skill("move",1)<2) 
	{
	message_vision("$N缩身往外一钻，结果通地一声头撞在石壁上，起了个大包！\n",me);
	return 1;
	}
	else
	message_vision("$N缩身往外一钻，从狭小的洞口钻出去了。\n",me);
	if(!( room = find_object(__DIR__"hl-tan")) )
		room = load_object(__DIR__"hl-tan");
	me->move(room);
	return 1;
}
