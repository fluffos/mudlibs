inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("水壶", ({"shuihu", "hu"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "跟外省人学的，一个用竹子做的水壶\n");
		set("unit", "个");
		set("value", 100);
		set("max_liquid", 15);
	}

	set("liquid", ([
		"type": "alcohol",
		"name": "趵突泉水",
		"remaining": 15,
	]));
}
