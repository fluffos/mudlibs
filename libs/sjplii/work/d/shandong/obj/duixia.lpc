inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("盐局对虾", ({ "duixia" }));
    set_weight(2000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "哇！这可是山东渤海湾的名产呀！一个一斤多呢！\n");
          set("unit", "盘");
          set("value", 2000);
          set("food_remaining", 30);
          set("food_supply", 300);
     }
}


