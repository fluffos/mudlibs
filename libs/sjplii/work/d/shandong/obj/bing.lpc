inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("芝麻烧饼", ({ "bing" }));
    set_weight(1000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "一个沾满芝麻的大烧饼\n");
          set("unit", "个");
          set("value", 50);
          set("food_remaining", 5);
          set("food_supply", 80);
     }
}


