// Room: /u/shandong/ta-inn2.c

inherit ROOM;

void create() {
  set("short", "宏泰酒楼二楼");
  set("long", @LONG
这里是“宏泰酒楼”二楼的雅座。这里经常是招待沈三娘的一些
江湖朋友的地方，当然如果有钱也是都可以来的。旁边还有一位漂亮
的歌女在为大家弹唱时新的曲子。这里的客人同一楼一样满满的。透
过北面的阳台还能远远的望见泰山，云遮雾绕很是神秘。几位食客正
在边喝酒边天南地北的闲扯。西面墙上挂着一副对联。(duilian)   
    楼下是散座。
LONG
  );
  set("exits", ([
    "down": __DIR__ "ta-inn1",
  ]));
  set("item_desc", ([
    "duilian": "               宏扬中华武学，报我国泰民安。\n",
  ]));
  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/boss": 1,
      "/d/city/obj/misc/tables": 1,
      "/d/city/obj/misc/chairs": 2,
    ]));
  set("hell", 1);
  setup();
  replace_program(ROOM);
}
