#include <ansi.h>
inherit NPC;
string do_learnbook();

void create()
{
	set_name("王夫人",({ "wang furen","wang" }) );
        set("gender", "女性" );
        set("age", 32);
	set("long", "这是个城里的典型妇女。\n");
        set_temp("apply/defense", 5);
	set("combat_exp", 100);
	set("str", 64);
	set("per", 25);
	set("con", 16);
        set("int", 15);
        set("attitude", "friendly");
        set("chat_chance", 5);
        set("chat_msg", ({
		"王夫人幽幽叹息道：我那苦命的孩儿啊。。。\n",
		"王夫人幽幽叹息道：要是有好心人肯教教我的宝宝就好了。。。\n",
        }) );
    set("inquiry", ([
        "宝宝" : (:do_learnbook:),
        "教书" : (:do_learnbook:),
]) );
	setup();
	carry_object("/d/city/obj/cloth/pink_cloth")->wear();
	add_money("coin", 50);
}

string do_learnbook()
{
  object me=this_player(); 
  string *chats = ({
  "人之初，性本善",
  "道相近，习相远",
  "床前明月光，疑是地上霜",
  "举头望明月，低头思故乡",
  "轻则失根，躁则失君",
  "持而盈之，不如其已",
  "揣而锐之，不可长保",
  "金玉满堂，莫之能守",
  "富贵而骄，自遗其咎",
  "功遂身退，天之道也",
  "孔德之容，惟道是从",
  "知人者智，自知者明",
  "胜人者有力，自胜者强",
  "上德不德，是以有德",
  "失道而后德，失德而后仁",
  "失仁而后义，失义而后礼",
  "反者道之动，弱者道之用",
  "天下万物生于有，有生于无",
  "物或损之而益，或益之而损",
  "人之所教，我亦教之",
  "大直若屈，大巧若拙，大辩若讷",
  "圣人常无心，以百姓心为心",
  "知者不言，言者不知",
  "善者不辩，辩者不善",
  "圣人终不为大，故能成其大",
  "勇于敢则杀，勇于不敢则活",
  "人之生也柔弱，其死也坚强",
  "以正治国，以奇用兵，以无事取天下",
 });
 string teachchat = chats[random(sizeof(chats))];
  if(me->query_temp("newbie_quest/teach"))
          return "你还没去教我的孩儿吗？\n";
  if(me->query_skill("literate",1) < 3)
          return "你的学问这么低，怎么能教我的孩儿呢？\n";

  message_vision(CYN"$N对$n微笑道：你愿意教宝宝吗？太谢谢你了。\n",this_object(),me);
  message_vision("$N叹道：宝宝喜欢玩，不太听我话。你帮我把要教的传给他吧！\n",this_object(),me);
  message_vision("$N道：我想让他学会“"+ teachchat +"”。\n"NOR,this_object(),me);
  me->set_temp("newbie_quest/teach",teachchat);
  return "拜托你了。\n";
}  
