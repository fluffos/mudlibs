inherit NPC;

void create()
{
        set_name("小衙役", ({ "yayi"}) );
        set("gender", "男性" );
        set("age", 32+ random(10));
        set("long", "这是一位知府大人门前的小衙役。\n");
        set("combat_exp", 5000);
        set("attitude", "aggrensive");
        set_skill("unarmed", 30 + random(100));
        set("chat_chance", 10);
        set("chat_msg", ({
                "小衙役突然向你喝道：站住，你是哪里来的！\n",
                (: random_move :),
        }) );
	setup();
	add_money("silver", 10);
        carry_object("/obj/cloth")->wear();
}

