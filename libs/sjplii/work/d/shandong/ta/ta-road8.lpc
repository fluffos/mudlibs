inherit ROOM;

void create()
{
        set("short", "泰安城里");
        set("long", @LONG
这里是泰安城中的一个十字路口。西面是一家小酒店，是平民百姓
平时聚会小沽的地方。从门面上看去也是十分简陋的，生意到也还说的
过去，到底还是穷人多吗。东面则是间小赌场，吆三喝五的声音不断的
从里面传出来，看来还挺热闹。门口的布幌子上大言不惭的写着四个字
“只赚不赔”？！
    往北走是城中心，
    往南走是南门，
    往西走是一家小酒店，
    往东走是一家赌场。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"ta-inn3",
  "east" : __DIR__"ta-duchang",
  "north" : __DIR__"ta-road3", 
  "south" : __DIR__"ta-nanmen",
]));
        set("outdoors", "shandong");
        set("objects", 
        ([ //sizeof() == 1
		"/obj/npc/shangren" : 1,
        ]));
	set("hell", 1);

        setup();
        replace_program(ROOM);
}
