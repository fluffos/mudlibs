
inherit ROOM;

void create()
{
        set("short", "青石官道");
        set("long", @LONG
这是一条宽敞坚实的青石大道，向南延伸。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "north" : "/d/shandong/hl/hl-shulin1",
  "south" : __DIR__"boat_north",
]));
        set("outdoors", "shandong");
	set("hell", 1);

        setup();
//        replace_program(ROOM);
}
void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}
