// master-2.c

inherit NPC;
void consider();

void create() {
  object ob;

  set_name("万兽尊者", ({ "master wanshou", "master", "wanshou" }));
  set("titile", "十万大山山人");
  set("gender", "男性");
  set("age", 55);
  set("str", 95);
  set("long",
    "这是万兽庄的第一代掌门。\n");
  set("combat_exp", 3000000);
  set("score", 1500);
  set("force", 12000);
  set("max_force", 8000);
  set("force_factor", 230);

  set("bellicosity", 100);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: consider :),
    (: exert_function, "recover" :)
  }));

  set_skill("unarmed", 280);
  set_skill("blade", 250);
  set_skill("sword", 280);
  set_skill("throwing", 280);
  set_skill("literate", 50);
  set_skill("parry", 280);
  set_skill("dodge", 280);
  //       map_skill("force", "tg-force");
  //       map_skill("dodge", "wave-step");
  create_family("万兽庄", 1, "掌门");

  setup();
  carry_object("/obj/longsword");

}


void killed_enemy(object who) {
  command("say 哈哈哈, 不要命的家伙！");
}

void attempt_apprentice(object ob) {
  if (ob->query("combat_exp") < 30000) {
    command("say " + RANK_D->query_respect(ob) + "还要再勤学苦练，拜师的事以后再提吧。\n");
    return;
  }
  command("smile");
  command("say " + RANK_D->query_respect(ob) + "果然是个练武奇才！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "xiaoyao");
}

void consider() {
  int i, flag = 0;
  object *enemy;

  enemy = query_enemy() - ({ 0 });
  for (i = 0; i < sizeof(enemy); i++) {
    if (!living(enemy[i])) continue;
    if (enemy[i]->query_temp("weapon")) {
      flag++;
      if (!query_temp("weapon")) {
        command("say " + RANK_D->query_respect(enemy[i]) + "既然使兵刃，在下空手接招未免不敬。");
        command("wield sword");
        command("say 进招吧！");
        break;
      }
    }
  }
  if (!flag && query_temp("weapon")) {
    if (sizeof(enemy) > 1)
      command("say 嗯... 既然" + chinese_number(sizeof(enemy)) + "位都是空手，在下理当奉陪！");
    else
      command("say 既然" + RANK_D->query_respect(enemy[0]) + "不使兵刃，在下自然奉陪！\n");
    command("unwield sword");
  }
}
