
inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "黄土路");
	set("long", @LONG
这是一条黄土铺成的大道，路边有个牌子(sign)，牌子上写着几
个大字。北面就是十万大山，山上长满了茂密的大树。
LONG
	);
       set("item_desc", ([
                "sign": (: look_sign :)
        ]) );

	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"spath3",
  "south" : __DIR__"spath5",
]));
	set("outdoors", "shiwan");

	setup();
//	replace_program(ROOM);
}
string look_sign(object me)
{
        return "牌上写着:  大理城--南 80 里\n";
}


