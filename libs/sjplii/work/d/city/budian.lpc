//changan city

inherit ROOM;

void create ()
{
        set ("short", "水家布店");
        set ("long", @LONG
这是一家很小的店。但你千万别小看它，它可是御用布店。它所染的布
料，每年都进贡。这都得益与它的老板娘水夫人，水夫人的染布技术堪称天
下一绝。这里出品的布料价格昂贵，但却都是极品。
LONG);

  set("item_desc",([
      "bian" : "布料货量少质次，暂停消售。现售祖传布料：\n"+
               "白色布料：三十两银子\n",
      ]));

        set("exits", 
        ([ //sizeof() == 4
                "west" : __DIR__"zhuque-s3",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/budian_boss" : 1,
        ]));

	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

