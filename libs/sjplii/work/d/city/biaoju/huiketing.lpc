//biaoju huiketing.c
inherit ROOM;

void create ()
{
        set ("short", "会客厅");
        set ("long", @LONG
会客厅是局主接待重要客人的所在,整个房间现的典雅庄重.靠墙有一张
红木茶几,几上放着几杯清茶,茶香阵阵, 另人心旷神怡在茶几的两旁放着几
把太师椅, 局中大的买卖几乎都在这里谈成的。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "north" : __DIR__"changlang2",
        ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/xiao" : 1,
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}


