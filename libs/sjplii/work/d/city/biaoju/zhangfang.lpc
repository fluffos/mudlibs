//biaoju zhangfang.c
inherit ROOM;

void create() {
  set("short", "帐房");
  set("long", @LONG
这里是红旗镖局的帐房。帐房光线不怎么明亮，满屋子的柜子和架子。
帐房先生岳久公是这里的主管，镖局里的伙计结帐和领薪水都来找他。
他的右手侧放有一个牌子(sign)。
LONG);


  set("exits",
    ([  //sizeof() == 4
    "north": __DIR__ "changlang3",
    ]));
  set("item_desc", ([
    "sign": @TEXT
这里是帐房，在这里可以：
shenqing   申请做镖师（不用拜师）
tuichu      申请不做镖师了
bai yue         拜师进入镖局，不但能学到镖局的武功，还可在镖局出入自由。
TEXT
  ]));



  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yue": 1,
    ]));


  set("outdoors", "biaoju");
  set("no_clean_up", 0);
  setup();
}
