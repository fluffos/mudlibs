           	"west" : __DIR__"changlang6",
		"east" : __DIR__"changlang7",
 	"north" : __DIR__"xiaoyuan",


        ]));

        set("objects", 
        ([ //sizeof() == 1
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}


