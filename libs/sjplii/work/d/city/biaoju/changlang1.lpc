inherit ROOM;

void create ()
{
        set ("short", "长廊");
        set ("long", @LONG
这是一条宽阔的长廊。不时你能看到有人沿着这里匆匆走过。沿着这里
你能通往镖局的每一个地方。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
           	"east" : __DIR__"changlang2",
		"west" : __DIR__"xiuxishi",
 	"south" : __DIR__"changlang4",


        ]));

        set("objects", 
        ([ //sizeof() == 1
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}


