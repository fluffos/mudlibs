#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void re_rank(object student);

void create() {
  set_name("邱震海", ({ "master qiu", "qiu", "master" }));
  set("title", "红旗镖局总镖头");
  set("nickname", HIR "红旗铁枪震中州" NOR);
  set("gender", "男性");
  set("age", 64);
  //	set("skill_public",1);
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("agi", 30);
  set("max_kee", 900);
  set("max_gin", 900);
  set("max_sen", 900);
  set("kee", 900);
  set("gin", 900);
  set("sen", 900);
  set("class", "biaoju");
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("score", 10000);
  set("combat_exp", 3500000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);
  //	set_temp("apply/damage",30);

  create_family("红旗镖局", 2, "局主");
  set("long",
    "红旗铁枪邱震海是红旗镖局创始人司马中天的关门弟子，人不但性情豪爽，且广交朋友.
 凡是想向他求教的，只要为镖局出点力，他就肯教．\n"
  );
  set("chat_chance", 2);
  set("chat_msg", ({
    "邱震海说道：这个月镖局生意不错！\n",
  }));
  set("attitude", "peaceful");
  set_skill("unarmed", 200);
  set_skill("yuanyang_tui", 180);
  set_skill("literate", 60);
  set_skill("force", 190);
  set_skill("move", 120);
  set_skill("dodge", 160);
  set_skill("parry", 180);
  set_skill("spear", 220);
  set_skill("chaos-steps", 180);
  set_skill("bainiao_spear", 210);
  set_skill("bixueforce", 170);
  map_skill("unarmed", "yuanyang_tui");
  map_skill("force", "bixueforce");
  map_skill("spear", "bainiao_spear");
  map_skill("parry", "bainiao_spear");
  map_skill("dodge", "chaos-steps");
  setup();
  carry_object(__DIR__ "obj/jinzhuang")->wear();
  carry_object("/obj/weapon/iron_spear")->wield();
}

void attempt_apprentice(object me) {
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "biaoju");
  ob->set("id_type", 1);
  //                ob->set("title","红旗镖局趟子手");
}

/*
void init()
{
        add_action("give_quest", "quest");
}

*/

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 20000) {
    student->set("title", "红旗镖局趟子手");
    return;
  } else if (exp <= 100000) {
    student->set("title", "红旗镖局镖师");
    return;
  } else if (exp <= 300000) {
    student->set("title", "红旗镖局大镖师");
    return;
  } else if (exp <= 600000) {
    student->set("title", "红旗镖局镖头");
    return;
  } else if (exp <= 1500000) {
    student->set("title", "红旗镖局副总镖头");
    return;
  }
}
