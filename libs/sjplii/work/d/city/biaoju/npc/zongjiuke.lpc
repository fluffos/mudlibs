#include <ansi.h>

inherit NPC;

void create()
{
        set_name("纵酒客", ({ "zongjiu ke", "ke"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位浪迹江湖的游客。\n");
        set("str", 60);
        set("combat_exp", 5000000);
	set("title", "五湖三散人");
//	set("nickname", "");
        set("attitude", "friendly");
        set_skill("unarmed", 200);
	set_skill("force", 200);
	set_skill("literate", 200);
	set_skill("dodge", 200);
	set_skill("parry", 200);
        set("chat_chance", 30);
        set("chat_msg", ({
                (:random_move :)
        }) );
	setup();
	add_money("silver", 50);
}
int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	if( ob->query("id") == "biao huo") {
	if((int)ob->query("objattrib") !=1 )  return 0;
	me = this_player();
	if (!(int)me->query("quest/biaoju")||(int)me->query("quest/biaoju")==0)
	return 0;
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
me->set("combat_exp", (int) score + 60);
me->set("potential", (int) pot + 50);
		me->set("quest/biaoju",0);
	command("say 酒仙瓶，酒仙瓶，真是久违了！多谢你啦！");
        say( "纵酒客扬长而去。。。\n");
	this_object()->move("/u/baiwt/npc_hut.lpc");
	return 1;
        }
		else {
			command("say 这不是我的东西。");
			return 0;
                }
        return 1;
}

