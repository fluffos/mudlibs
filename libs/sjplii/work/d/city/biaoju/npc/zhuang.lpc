inherit NPC;
inherit F_MASTER;

void create() {
  set_name("庄容", ({ "zhuang rong", "zhuang" }));
  set("gender", "男性");
  set("nickname", "链子枪");
  set("age", 26);
  set("long",
    "庄容是邱震海的大弟子，也是镖局里出类拔萃的人物。\n");
  set("attitude", "peaceful");
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 15);
  set("combat_exp", 200000);

  set_skill("unarmed", 60);
  set_skill("yuanyang_tui", 60);
  set_skill("literate", 60);
  set_skill("force", 60);
  set_skill("move", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("spear", 60);
  set_skill("bainiao_spear", 60);
  set_skill("bixueforce", 60);
  map_skill("unarmed", "yuanyang_tui");
  map_skill("force", "bixueforce");
  map_skill("spear", "bainiao_spear");
  map_skill("parry", "bainiao_spear");

  create_family("红旗镖局", 3, "镖师");

  setup();

  carry_object("/obj/weapon/longspear")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  command("smile");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "biaoju");
  ob->set("class1", "biaoju");
  ob->set("id_type", 1);
  ob->set("title", "红旗镖局趟子手");
}
