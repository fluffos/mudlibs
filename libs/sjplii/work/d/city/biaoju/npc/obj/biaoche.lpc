inherit NPC;
int robber();
void create()
{
        set_name("镖车", ({ "biao che" }) );
	set("gender", "男性");
	set("age", 40);
	seteuid(getuid());
        set("long",
                "这是一两满载货物的镖车，车头插着一面红色的小旗。\n");
        set("chat_chance", 5);
        set("chat_msg", ({
		(: robber :)	
        }) );
	set("no_living",1);
	set("quest/biaoju",1);
	set("arrive_msg","缓缓行驶了过来");
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
	add_action("do_look","look");
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
	this_object()->start_busy(1);
}

int do_look(string arg)
{
if (arg == "biao che" )
{
write("这是一两满载货物的镖车，车头插着一面红色的小旗。\n");
return 1;
}
return 0;
}

void die()
{
	destruct(this_object());
	return;
}
int robber()
{
	object ob;
	ob=new(__DIR__"robber");
	if( random(4)<=1 )	ob=new(__DIR__"robber2");
	ob->move(environment(this_object()));
	this_object()->start_busy(1);
	return 1;
}
int accept_fight(object me)
{
	return notify_fail("你看花眼了吗？那是一辆车！\n");
}
