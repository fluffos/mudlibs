#include <armor.h>

inherit CLOTH;

void create() {
  set_name("灰色包裹", ({ "biao huo", "parcel", "huo" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一个灰色包裹。\n");
    set("objattrib", 1);
    set("value", 1);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
