
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("岳九公", ({ "yue jiugong", "yue" }) );
	 set("title","红旗镖局管帐");
        set("gender", "男性");
        set("age", 56);
        set("long",
"岳九公主要负责红旗镖局日常帐务事宜，在镖局里德高望重。\n" );
        set("attitude", "peaceful");
        set("force", 700);
        set("max_force", 700);
        set("force_factor",20);
        set("combat_exp",400000);

	set_skill("unarmed", 70);
	set_skill("yuanyang_tui", 70);
	set_skill("literate", 70);
	set_skill("force", 70);
	set_skill("move",70);
	set_skill("dodge",70);
	set_skill("parry",70);
	set_skill("spear",70);
	set_skill("bainiao_spear",70);
	set_skill("bixueforce",70);
	map_skill("unarmed", "yuanyang_tui");
	map_skill("force", "bixueforce");
	map_skill("spear", "bainiao_spear");
	map_skill("parry", "bainiao_spear");

        create_family("红旗镖局", 3, "镖师");

        setup();

        carry_object("/obj/weapon/longspear")->wield();
        carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要多为镖局出力！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "biaoju");
                ob->set("id_type", 1);
                ob->set("title","红旗镖局镖师");
}


