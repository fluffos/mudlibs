#include <ansi.h>

inherit NPC;

void create()
{
        set_name("胡海秋", ({ "hu haiqiu", "hu"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位高达六尺的镖师。\n");
        set("combat_exp", 50000);
	set("title", "红旗镖局镖师");
//	set("nickname", "");
        set("attitude", "friendly");
        set_skill("spear", 90);
	set_skill("dodge", 100);
        set("iron-cloth", 200);
//                (:random_move :)
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
        carry_object("/obj/weapon/longspear")->wield();
}

