//biaoju wuqiku.c
inherit ROOM;

void create ()
{
        set ("short", "武器库");
        set ("long", @LONG
这是一间木制的建筑，看上去坚固异常，没有窗，靠墙是一排排的兵器
架，各色各样的兵器被擦拭得雪亮，摆放的整整齐齐，通常镖局的弟子都到
这里来取自己称手的武器。不过一次只能拿一样。此地还供应防具。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "east" : __DIR__"lianwuchang",
        ]));

        set("objects", 
        ([ //sizeof() == 1
		"/obj/weapon/thin_sword":1,
		"/obj/weapon/sword":1,
		"/obj/weapon/shield":1,
		"/obj/weapon/blade":1,
		"/obj/weapon/bamboo_sword":1,
		"/obj/weapon/spear":1,
		"/obj/weapon/whip":1,

	//	__DIR__"npc/zhuang" : 1,
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}

void init()
{
	add_action("do_get", "get");
	add_action("do_drop", "drop");
}
int do_get(string arg)
{
	object ob,me;
	me = this_player();
	if( arg == "all" ) {
		write("每次只允许拿一件武器。\n");
		return 1; }
	if( !arg || !(ob = present(arg, environment(me))) ) {
		write("你要拿什么物品？\n");
		return 1; }
	if( !objectp(ob) ) {
	       write("这里没有这样东西。\n");
		return 1; }	
	if(!ob->query("no_get")) {
if(me->query_temp("get")>0) {
		    write("某人：嘿嘿，你拿得太多了吧！\n");
		    return 1; }
		ob->move(me);
	       message_vision( "$N拣起了一"+ob->query("unit")+ob->name()+"。\n",me);
		me->set_temp("get",me->query_temp("get") + 1 );
		return 1;
	}

}
int do_drop(string arg)
{
	object ob,me;
	me = this_player();
	if(arg =="all") {
		me->set_temp("get",0);
		return 0; }
	if(!arg || !(ob = present(arg, me)) ) {
		write("你要丢弃什么物品？\n");
		return 1; }
	if( !objectp(ob) ) {
	       write("这里没有这样东西。\n");
		return 1; }	
	if(!ob->query("no_drop")) {
		if(me->query_temp("get")<=0) return 0;
		ob->move(environment(me));
	       message_vision( "$N丢下了一"+ob->query("unit")+ob->name()+"。\n",me);
		me->set_temp("get",me->query_temp("get") - 1 );
		return 1;
	}
	return 0;

}

