//changan city

inherit ROOM;

void create ()
{
        set ("short", "青龙大街");
        set ("long", @LONG

你走在一条宽阔的石板大街上，这是青龙大街的南段。西面是一家
大珠宝行，陈列着各式各样的名贵珠宝。东面静静的坐落着一家书店，
这年头天下安定，买书求学的人真是不少，书店也算生意兴隆。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"qinglong-s3",
                "north" : __DIR__"qinglong-s1",
                "west" : __DIR__"zhubao",
                "east" : __DIR__"shudian",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//                __DIR__"npc/libai" : 1,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

