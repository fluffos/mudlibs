//ROOM:/u/changan/bingbu/yardb.c

inherit ROOM;

void create()
{
 set("short","甬道");
 set("long",@LONG
转过了前面的竹林,一个平静如箔的镜湖,微微的波浪,撞击着岸
边的石堤,哗哗的响,完全没有了外府庄严肃穆的氛围.完全是一片
欤妮的风景.湖的周围隐隐有几座建筑.
LONG
);
set("item_desc",([
"镜湖":"静谧的一片小湖,微风轻轻鼓起了层层轻浪,湖面上一簇一簇的漂浮着
叶片巨大的睡莲,湖的中间有一座太湖石作的假山.水烟朦胧中却也看不真切.\n",
]));
set("outdoors","changan");
set("exits",([
"northeast":__DIR__"ymei",
"southeast":__DIR__"wdd",
"northwest":__DIR__"yongdao2",
]));
set("no_clean_up", 0);
setup();

}

void init()
{
  add_action("do_jump",({"jump"}));
}

int do_jump(string arg)
{
  object ob;    
  if(!arg) return notify_fail("没什么事你蹦什么蹦?\n");
  if(arg !="睡莲") return notify_fail("要跳到什么上面呢?\n");
  if((int)this_player()->query_skill("dodge")<150){
   write("想自杀么,也不选个好地方,死在这里你不杀风景么?俗人!\n");
   return 1;
   }
   message_vision("$N轻轻一跃,脚尖点在湖中的睡莲上,身形一晃,已经到了湖中的假山上.\n",this_player());
   this_player()->move(__DIR__"jiashan");
   message("vision",this_player()->name()+"身形迅捷的从对面岸上,几个起落就跳了过来.\n",environment(this_player()),this_player());
   return 1;
}


  