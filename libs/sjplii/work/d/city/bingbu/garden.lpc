inherit ROOM;

void create() {
  set("short", "梅园内");
  set("long", @LONG
进到沁梅园,里面种满了梅树,据说路大人年轻时曾到扬州梅园,
被梅花冰清玉洁的神姿深深打动,留恋往返于梅间,迟迟不肯离去.
开国后就在自己的后园内开出了这片园子,聊为魂牵梦绕的思念.
LONG
  );
  set("exits", ([
    "out": __DIR__ "ymei",
  ]));
  set("outdoors", "changan");
  setup();
}
