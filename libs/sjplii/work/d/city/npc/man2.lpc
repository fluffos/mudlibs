#include <ansi.h>
inherit NPC;
int about_he();
void create() {
  set_name("中年男士", ({ "man" }));
  set("gender", "男性");
  set("age", 45);
  set("long",
    "这是一个和蔼的中年男士\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 100);
  set("inquiry", ([
    "help": (: about_he :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("say 孩子，你在江湖上闯荡要自己照顾好自己啊！。\n");

}
int about_he() {
  object me;
  object obj;
  me = this_player();
  if (me->query("be_born") > 0)
    return 0;
  say(CYN "中年男士微微一笑。\n" NOR);
  say("中年男士把一件物事塞在你手里，说道：这是我们的家传之物，孩子你收着吧！\n");
  obj = new("/obj/stick");
  obj->move(me);
  me->add("be_born", 1);
  if (!me->query_skill("unarmed"))
    me->set_skill("unarmed", 3);
  return 1;
}
