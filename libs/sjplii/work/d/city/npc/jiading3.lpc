// jiading.c

inherit NPC;
string reward_more( object who);
void create()
{
        set_name("紫衣家丁", ({ "jiading" }) );
        set("gender", "男性" );
        set("age", 38);
        set("str", 28);
        set("cor", 27);
        set("cps", 25);
        set("int", 23);

        set("max_force", 100);
        set("force", 100);
        set("force_factor", 10);

        set("attitude", "heroism");

        set("long",@LONG
这是一位赵王府的家丁。
LONG);

        set("combat_exp", 3000);
        set("score", 50);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );

        set_skill("hammer", 20);
	set_skill("dodge", 20);
	set_skill("parry", 20);
	setup();
        add_money( "coin" , 50);
        carry_object("/obj/cloth")->wear();
        carry_object(__DIR__"obj/8hammer")->wield();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 5000 ) return "1";
			if( enemy[i]->query("combat_exp") > 10000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
				enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}

