
//ghost.c 吊死鬼

inherit NPC;
void create()
{
        set_name("吊死鬼", ({ "ghost" }) );
        set("gender", "男性" );
        set("str", 66);
        set("combat_exp", 1000000);
        set("attitude", "friendly");
        set("max_force", 1000);
        set("force", 1000);
        set("force_factor", 10);
//        set("no_shown",1);
        set_skill("force", 120);
        set_skill("whip", 200);
        set_skill("dodge", 200);
        set_skill("ghostclaw", 100);
        map_skill("unarmed", "ghostclaw");
        setup();
        carry_object(__DIR__"obj/ghostwhip")->wield();
}

int is_ghost() { return 1; }

void init()
{
        add_action("do_lay","lay");
}

int do_lay(string arg)
{
        int amount;
        object me,ghost,seal;
        if( !arg || arg!="ghost" ) return 0;
        ghost = this_object();
        me = this_player();
        if( ghost -> query( "already_laid" ) )
             return notify_fail("吊死鬼已经受到了重创，快点动手干掉它吧！\n");
        if( me -> query("class") != "taoist" )
             return notify_fail("你不是道士，不会驱鬼！\n");
        if( me -> query_skill("spells") < 60 || me -> query_skill("scratching") < 60 )
             return notify_fail("你的符之术和咒术不够高，不能驱鬼！\n");
        if( !(seal = present("paper seal",me)) )
             return notify_fail("你身上没有桃符纸，怎么能画符驱鬼！\n");
        amount = seal->query_amount();
        if( amount == 1 ) destruct(seal);
        else seal -> set_amount( amount - 1 );
        ghost -> set( "already_laid" , 1 );
        me -> receive_wound( "kee", 20 );
        me -> receive_wound( "gin", 20 );
        me -> receive_wound( "sen", 20 );
        message_vision("$N磕破中指，在一张桃符纸上飞快地写下一道驱鬼符，接着几个手指\n飞快地转动，口中一边还念念有词。突然间符咒烧了起来，放出耀眼\n的光芒，将周遭照得如同白昼一般，只听见一声惨叫，$n显然受\n到了重创，显出了原形！\n",me,ghost);
        ghost -> set_skill("dodge",20);
        ghost -> set_skill("whip",20);
        ghost -> set_skill("force",20);
        ghost -> set_skill("ghostclaw",20);
        ghost -> set_skill("unarmed",20);
        ghost -> set("combat_exp",10000);
        ghost -> set("max_force",100);
        ghost -> set("force",100);
        ghost -> set("force_factor",2);
        ghost -> set("str",24);
        ghost -> receive_wound("kee", ghost->query("eff_kee")*3/4);
        ghost -> receive_wound("gin", ghost->query("eff_gin")*3/4);
        ghost -> receive_wound("sen", ghost->query("eff_sen")*3/4);
//      ghost -> delete("no_shown");
        ghost -> kill_ob(me);
        me -> kill_ob(ghost);
        return 1;
}

void die()
{
        object killer;
        int bonus;
        if( objectp(killer = query_temp("last_damage_from")) ) {
                bonus=killer->query("life_exp");
                bonus=((bonus>10000)?10000:bonus)/100;
                bonus=random(bonus);
                killer->add("life_exp",2+bonus);
                killer->add("combat_exp",10+bonus);
                killer->add("potential",1+bonus);
                killer->add("score",1);
        }
        ::die();
}
