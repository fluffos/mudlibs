#include <ansi.h>

inherit NPC;
int about_tool1();
int about_tool2();
int about_tool3();
int about_tool4();
int about_tool5();

void create()
{
        set_name("年雪丰", ({ "nian xuefeng","nian" }) );
        set("age", 20);
	set("title","大内“神驹四捕”之四");
        set("long",
                "大内“神驹四捕”之四\n");

        set("attitude", "heroism");
	set("vendetta_mark", "authority");
        set("pursuer", 1);
	create_family("朝廷",7,"官员");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", random(50)*10000);

        set_skill("blade", 50+random(40));
        set_skill("unarmed", 40+random(40));
	set_skill("xingyi-ken",100);
        set_skill("spring-blade", 100);
        set_skill("parry", 40+random(40));
        set_skill("dodge", 40+random(40));
        set_skill("move", 50+random(40));
	map_skill("blade","spring-blade");
	map_skill("unarmed","xingyi-ken");
	map_skill("parry","spring-blade");
        set("inquiry", ([
                "袖箭" : (: about_tool1 :),
                "流星矢" : (: about_tool2 :),
                "硫磺焰硝丸" : (: about_tool3 :),
                "火铳" : (: about_tool4 :),
                "雷火珠" : (: about_tool5 :),
        ]));

        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/damage", 10+random(20));
        set_temp("apply/armor", 30);
        set_temp("apply/move", 30);
        set("chat_chance", 3);
        set("chat_msg", ({
"年雪丰叹了口气，说道：白大哥不在，我会保护好师父的。\n"
        }) );

        setup();

        carry_object(__DIR__"obj/blade")->wield();
        carry_object(__DIR__"obj/yafu")->wear();
}

int about_tool1()
{
        object me;
        object tool;
	int officialism,leadership, exp;
	me = this_player();
	exp = (int)me->query("combat_exp");
	officialism = (int)me->query_skill("officialism");
	leadership = (int)me->query_skill("leadership");

	if(me->query("id_type") != 5)
	{
	command("say 你不是刑部的官员！\n");
        return 1;
	}

	if(exp < 32000 )
      {
        command("say 你经验还不够。\n");
        return 1;
      }

	if(officialism < 30 || leadership < 30)
      {
        command("say 你“为官之道”和“用人之技”太差了，再好好努力吧。\n");
        return 1;
      }

	if( me->query_temp("guanfu/borrow_tool") )
      {
        command("say 你上次从衙门借出去的武器还没归还呢！\n");
        return 1;
      }

	else{
        command("say 好吧，这件武器你拿去，别忘了用完后归还（return）。\n");
	   me->set_temp("guanfu/borrow_tool", "袖箭");
          tool = new("/obj/guanfu/obj/sleeve");
          tool->move(me);
          return 1;
		}
	return 0;
}

