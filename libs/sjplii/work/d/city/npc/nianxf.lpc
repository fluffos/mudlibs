int accept_object(object who, object ob)
{
        string toolname;
	toolname=(string)who->query_temp("guanfu/borrow_tool");
	if( toolname && (ob->name() == toolname)) {
        say( "年雪丰点头说道：有借有还，你很守信用。下次要用可再向我借。\n");
	if( who->query("guanfu/borrow_tool") )
	   who->delete("guanfu/borrow_tool");
	if( who->query_temp("guanfu/borrow_tool") )
	   who->delete_temp("guanfu/borrow_tool");
	return 1;
        }
		else {
			say("年雪丰摇了摇头，说道：我不要你的东西。\n");
			return 0;
                }

        return 1;
}
