#include <weapon.h>
inherit STICK;
void create()
{
	set_name("订作的" , ({ "order" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "一条又粗又长的精铁棍。\n");
                set("no_drop",1);
                set("no_get",1);
                set("owner","sjpl");
                set("rigidity",300);
                set("value", 1);
		set("material", "iron");
		set("wield_msg", "$N拿出一根结实的$n握在手中。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
	}
	init_stick(30);
	setup();
}
