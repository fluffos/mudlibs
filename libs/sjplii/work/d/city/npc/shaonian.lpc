inherit NPC;

void create()
{
        set_name("江湖少年", ({ "shaonian" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long", "一个英豪的江湖少年.\n");

        set("combat_exp", 2000);
        set("attitude", "heroism");
        set_skill("unarmed", 20);
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );

	setup();
	add_money("silver", 1);
        carry_object(__DIR__"obj/cloth")->wear();
        
}
