//changan city

inherit ROOM;

void create ()
{
        set ("short", "玄武大街");
        set ("long", @LONG

这里的路相当的宽，能容好几匹马车并行，长长的道路贯穿东西。
这是玄武大街的西段，北面是一家棺材店，南面是一家粮店，目前正缺
打工的人手。往东是西市中心，往西是金光门，从那里可以直通岷江。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"liangdian",
                "north" : __DIR__"guancai",
                "west" : __DIR__"ximen",
                "east" : __DIR__"xishi-center",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//	   __DIR__"npc/japan":2,
          __DIR__"npc/huoji2" : 2,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

