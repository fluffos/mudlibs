//changan city

inherit ROOM;

void create ()
{
        set ("short", "安化门");
        set ("long", @LONG

这里是长安的安化门。北面就到了城中，远望人山人海，往来行人车
流不绝。西南一条大路通向川中。城门下有一些执勤的兵士。时下虽
已天下太平，但一干兵将还是英姿勃勃，警惕的盯着往来人士。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "north" : __DIR__"qinglong-s3",
                "southwest" : __DIR__"machang",//goto emei and qingcheng
        ]));

        set("objects", 
        ([ //sizeof() == 1
//                __DIR__"npc/wujiang" : 1,
		__DIR__"npc/bing" : 3,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}



