#include <room.h>

inherit ROOM;

void create ()
{
        set ("short", "珠宝行");
        set ("long", @LONG
珠宝店用用青石为墙，白玉为柱，一派富丽堂皇的景象，柜台里坐着
一个老者，手持碧玉旱烟袋，双目微合，好一副悠闲自得的模样。在柜台
的后面有一扇小门紧紧的关着。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "east" : __DIR__"qinglong-s2",
                "northwest" : __DIR__"zb_mishi",
       ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/zhubao_boss" : 1,
        ]));

	set("no_clean_up", 0);
  create_door("northwest","木门","southeast",DOOR_CLOSED);
        setup();
	replace_program(ROOM);
}

