inherit ROOM;

void create() {
  set("short", "采石矶");
  set("long", @LONG
采石矶位于翠螺山麓，相传古时曾有金牛在此出渚，故名牛渚
矶。后又传说山上井中曾汐出五彩石，又改今名。这里悬崖峭壁，
突入江中，形势险要，是兵家必争之地。悬崖下激流滚滚，拍岸有
声，令人惊心动魄。登矶顶纵览长江景色，则水天一色，万里长江
一泻而下，令人胸襟宽敞。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": "/d/poemplace/taibailou",
    "west": __DIR__ "guanroad5",
  ]));
  set("outdoors", "changan");

  setup();
  replace_program(ROOM);
}
