#include <ansi.h>
inherit NPC;

void create() {
  set_name("宁九如", ({ "ning jiuru", "ning", "jiuru" }));
  set("long",
    "这是一个四十多岁的怪人, 据说他善于装神弄鬼,\n" +
    "他衣衫上沾满了油污，目光贪婪地扫视着四周。\n");
  set("title", "饿鬼帮传功使");
  set("gender", "男性");
  set("age", 44);
  set("nickname", HIG "九头怪鸟" NOR);
  set("attitude", "peaceful");
  create_family("饿鬼帮", 2, "帮众");

  set("str", 40);
  set("int", 30);
  set("cor", 20);
  set("spi", 30);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("kee", 3000);
  set("gin", 3000);
  set("sen", 3000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);

  set("combat_exp", 2000000);
  set("score", 2000);

  set_skill("literate", 80);
  set_skill("force", 150);
  set_skill("unarmed", 150);
  set_skill("axe", 140);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("guiyu_force", 110);
  set_skill("shengui_axe", 140);
  set_skill("sanlianhuan", 100);
  set_skill("chaos-steps", 120);

  map_skill("force", "guiyu_force");
  map_skill("parry", "shengui_axe");
  map_skill("axe", "shengui_axe");
  map_skill("unarmed", "sanlianhuan");
  map_skill("dodge", "chaos-steps");

  setup();
  carry_object("/obj/weapon/axe")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object me) {
  if (me->query("id_type") == 1) {
    command("say 本派乃绿林帮会，不收正道人物。\n");
    return;
  }
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "egui");
  ob->set("title", "饿鬼帮帮众");
}
int recognize_apprentice(object ob)

{

  return 1;

}
