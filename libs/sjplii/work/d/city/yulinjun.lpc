    "west": __DIR__ "baihu-n2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yulin_master": 1,
      __DIR__ "npc/qipaiguan": 1,
      __DIR__ "npc/armymen": 5,
    ]));

  set("NONPC", 1);
