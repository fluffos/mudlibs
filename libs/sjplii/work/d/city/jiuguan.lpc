#include <room.h>

inherit ROOM;

void create() {
  set("short", "酒馆");
  set("long", @LONG

酒馆不大，屋中零乱的摆了几张方桌，几条长凳。小柜台上摆了些
酒坛，所卖也不过是些花生米，老白干之类。累了一天的苦力人总爱
凑到一起喝几杯，吹吹牛，消磨时光。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "eastdown": __DIR__ "jg_mishi",
      "west": __DIR__ "baihu-s1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/jiubao": 1,
    ]));


  //        set("outdoors", "changan");
  set("no_clean_up", 0);
  create_door("eastdown", "青石地板", "westup", DOOR_CLOSED);
  setup();
}
