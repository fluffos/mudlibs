// Room: /u/fuzhou/jiyuan.c

inherit ROOM;
string look_sign(object me);

void create()
{
	set("short", "醉春楼");
	set("long", @LONG
你现在正站在醉春楼里
    靠近门口的地方有一块乌木雕成的招牌(sign)。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "sign" : (: look_sign :),
]));
	set("exits", ([ /* sizeof() == 2 */
  "up" : __DIR__"jiyuan2",
  "south" : __DIR__"eroad1",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/mother" : 1,
]));
	set("no_clean_up", 0);
	set("hell", 1);

	setup();
}
string look_sign(object me)
{
        return "牌匾上写着:  醉春楼\n";
}

