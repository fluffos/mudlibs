// airplane.c

inherit ITEM;

void create()
{
    set_name("鬼符", ({ "hong", "air" }) );
    set_weight(100);
    set("long", @LONG 
这是一张洪武邪常用的符咒，使用后可瞬间到达洪武邪的家。
使用方法：    fly hong	fly back
LONG
  );
    set("value", 300);
    set("unit", "张");
    set("material", "paper");
}

void init()
{
    add_action("do_fly", "fly");
}

int do_fly(string arg)
{
    string obj;
    if( !arg )
        return notify_fail("你想飞到哪里 ？\n");

	if( this_player()->is_fighting() )
        return notify_fail("你在战斗中，无法使用风之符。\n");
    switch(arg) {
             case "hong":
		obj="/u/fuzhou/hongl";
		break;
		case "back":
		obj="/new/hangzhou/lane";
		break;
		default:
             return notify_fail("你不能飞到那个地方 !\n");
             return 1;

    }
    message_vision("在一阵烟幕中，只见$N的身影忽然消失了。\n", this_player());

    this_player()->move(obj);

    message_vision("$N的身影忽然在一阵烟幕中神秘地出现了。\n", this_player());

    return 1;
}


