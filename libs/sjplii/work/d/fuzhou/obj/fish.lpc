// fish.c
#include <weapon.h>
inherit DAGGER;
inherit F_FOOD;

void create()
{
	set_name("鲜鱼", ({ "fresh fish", "fish" }) );
	set_weight(70);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一尾新鲜的大鱼。\n");
		set("unit", "条");
		set("value", 80);
		set("food_remaining", 3);
		set("food_supply", 30);
		set("wield_msg", "$N抓起一条$n，握在手中当武器。\n");
		set("material", "bone");
	}
	init_dagger(1);
	setup();
}

int finish_eat()
{
	if( !query("weapon_prop") ) return 0;
	set_name("啃得精光的鱼骨头", ({ "bone" }) );
	set_weight(50);
	set("long", "一条啃得精光的鱼骨头。\n");
	return 1;
}
