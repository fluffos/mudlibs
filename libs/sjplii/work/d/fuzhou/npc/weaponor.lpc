// weaponor.c
#include <ansi.h>

inherit NEW_VENDOR;

void create() {
  set_name("尉迟平", ({ "yuchi ping", "yuchi" }));
  set("title", "普通百姓");
  set("nickname", HIM "长剑飞虹" NOR);
  set("gender", "男性");
  set("age", 42);
  set("str", 92);
  set("long", "卖兵器的是个中年人，满脸伤疤。\n");
  set("combat_exp", 1200000);
  set("attitude", "friendly");
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("sword", 160);
  set_skill("dafu-sword", 100);
  map_skill("sword", "dafu-sword");
  map_skill("parry", "dafu-sword");

  set("inquiry", ([
    "兵器屋": "本店专卖各种长短兵器",
  ]));

  set("merchandise", ([
    "/obj/weapon/whip": 20,
    "/obj/weapon/longsword": 20,
    "/obj/weapon/dart": 20,
    "/obj/weapon/shield": 20,
    "/obj/weapon/sixhammer": 20,
    "/obj/weapon/thin_sword": 20,
    "/obj/weapon/dagger.lpc": 20,
  ]));

  setup();
  add_money("silver", 5);
  add_money("coin", 300);
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");


}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(4)) {
    case 0:
      say("尉迟平道：这位"
        +RANK_D->query_respect(ob)
        + "，自个儿挑一件称手的兵器吧\n");
      break;
    case 1:
      say("尉迟平突然间出了神，好象想起了他的往事\n");
      break;
  }
}
