// teacher.c

inherit NPC;
#include <ansi.h>

void create()
{
	set_name("聂方标", ({ "nie fangbiao", "nie","master" }) );
	set("nickname", HIC "入云龙" NOR);
	set("gender", "男性" );
	set("age", 42);
	set("skill_public",1);
	set("str", 90);
	set("int", 30);
	set("force", 1000);
        create_family("振远镖局", 3, "总镖头");
	set("long",
		"入云龙聂方标原来是少林俗家弟子，人不但性情豪爽，且广交朋友．
凡是想向他求教的，只要为镖局出点力，他就肯教．\n"
		);
       set("chat_chance", 3);
        set("chat_msg", ({
                "聂方标说道：这个月镖局生意不错！\n",
        }) );
	set("attitude", "peaceful");
	set_skill("unarmed", 30);
	set_skill("luohan-ken", 22);
	set_skill("literate", 3);
	set_skill("force", 30);
	set_skill("xiaochengforce", 22);
	set_skill("dodge",30);
	set_skill("parry",30);
	map_skill("force", "xiaochengforce");
	map_skill("unarmed", "luohan-ken");
	set("combat_exp", 90000);
	setup();
	carry_object(__DIR__"obj/jinzhuang")->wear();
}

int recognize_apprentice(object ob)
{
        if((time() - ob->query("marks/振远") ) > 1800  ){
                say("聂方标说道：你．．你好象很久没为镖局出过力了....\n");
                return 0;
        }

        return 1;
}
