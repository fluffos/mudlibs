// chess_player.c
#include <ansi.h>

inherit NPC;

string play_chess();

void create() {
  set_name("韦守儒", ({ "wei shouru", "wei" }));
  set("gender", "男性");
  set("title", "普通百姓");
  set("nickname", HIG "铁指金丸" NOR);
  set("age", 43);
  set("long", "一位十分文气的男子，装束象个雅儒。\n");
  set("str", 72);
  set("int", 28);
  set("combat_exp", 150000);
  set("attitude", "friendly");
  set_skill("unarmed", 100);
  set_skill("dodge", 80);
  set_skill("throwing", 130);

  set("inquiry", ([
    "下棋": (: play_chess :),
  ]));

  setup();
  add_money("coin", 50);
  carry_object("/obj/cloth")->wear();
  for (int i = 1; i <= 10; i++) {
    carry_object("/d/fuzhou/obj/npc/chess_player/chess")->wield();
  }
}

string play_chess() {
  command("say 要比试一盘？好啊！");
  if (random(100) < 50) {
    command("say 好棋技！佩服。无以为报，就给您两枚棋子防身吧！");
    printf("%s", name(this_player()));
    command("give chess to " + name(this_player()));
    return "0";
  } else
    command("say 承让承让！");
  return "1";
}
