inherit ROOM;
void create()
{
        set("short", "小山坡");
        set("long", @LONG
北面是长安方向，天气好时隐隐约约地还可以看到长安城的黑色纶廓
。再向东则是一个光秃秃的小山坡，坡上已被路过的行人踏出了一条黄土
路。路的两边还长了一些半人高的焦黄茅草。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "eastup" : __DIR__"libaimu",
  "west" : __DIR__"taibailou",
]));
        set("objects", ([
        __DIR__"obj/grass" : 1,
                        ]) );
        set("outdoors", "changan");
        setup();
}

void reset()
{
object con, item, *inv;
::reset();
if( con = present("grass",this_object()))
if( inv = all_inventory(con))
if( !sizeof(inv))
	{
	item = new(__DIR__"obj/poem");
	item->move(con);
	}	
}

