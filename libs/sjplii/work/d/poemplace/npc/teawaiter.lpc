inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("茶博士", ({ "cha boshi", "waiter" }));
  set("shop_id", ({ "cha boshi", "waiter" }));
  set("gender", "男性");
  set("class", "scholar");
  set("combat_exp", 1000);
  set("age", 26);
  set("per", 14);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);
  set("rank_info/respect", "茶博士");
  set("vendor_goods", ([
    "/obj/example/teapot": 20,
    "/obj/example/dumpling": 10,
    "/obj/example/chicken_leg": 20,
  ]));

  setup();
}
void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");
}
