//法术：［狂风卷地］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name(HIG"风神"NOR, ({ "wind god" }) );
	set("gender", "男性");
	set("age", 30);
        set("attitude", "peaceful");
        set("long", "天界之风神，掌管自然界之风势。\n");

 	set("mguard", "mguard61");
 	set("mguard_level", 61);
	set("magic_power", 3000);

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 9000);
	set("max_gin", 9000);
	set("max_sen", 9000);
	set("max_mana", 9000);
	set("mana", 9000);

         set("last_load_time", uptime());

        set("combat_exp", 3000000);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("move", 300);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	message_vision(HIR"\n$N喃喃念动咒语，一会儿只见四周狂风大作，吹得令人窒息，"NOR,who,enemy[i]);
	message_vision(HIR"\n呼啸的狂风挟着摧毁一切的气势朝$n卷了过来！\n"NOR,who,enemy[i]);
	message_vision(HIG"［狂风卷地］！\n\n"NOR,who);
			enemy[i]->receive_wound("kee", enemy[i]->query("max_kee"),who);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > 300 )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}
void leave()
{
	message("vision",
		 name() + "的身影渐渐虚化，变做了一道轻烟。\n\n"
		 "轻烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

