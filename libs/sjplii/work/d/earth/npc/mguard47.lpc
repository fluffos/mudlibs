// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［化妖大法］ 属性：attack  对象：all  克星：无
//法术：［星影遁法］ 属性：busy5  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("魍魉", ({ "wangliang", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard47");
 	set("mguard_level", 47);
	set("magic_power", 230);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

           set("last_load_time", uptime());
	set("max_mana", 2300);
	set("mana", 2300);

        set("combat_exp", 470000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( random(9)<4 )
	{
	message_vision(HIR"\n$N将披风一展，顿时一张无形巨网从天而降，落到$n身上变成了"NOR,who,enemy[i]);
	message_vision(HIR"\n一丝丝毒汁，$n只感到全身剧痛，肌肉腐烂，身体各处都流出脓血！\n"NOR,who,enemy[i]);
	message_vision(HIG"［化妖大法］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(750) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
	 return 1;
	}
	else
	if( random(enemy[i]->query("magic_defense"))< random(650) && !enemy[i]->is_busy())
	{
	message_vision(HIC"\n$N伸手一摘，竟摘得一束闪亮的星光，那星光霍忽变地极亮，"NOR,who,enemy[i]);
	message_vision(HIC"\n把$N的身影完全笼罩其中。$n只感到光芒耀眼夺目，登时手忙脚乱。\n"NOR,who,enemy[i]);
	message_vision(HIG"［星影遁法］！\n\n"NOR,who);
			enemy[i]->start_busy(5);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

