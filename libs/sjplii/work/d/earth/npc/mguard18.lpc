//法术：［气还符］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("冥府狱卒", ({ "mingfuyuzu", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard18");
 	set("mguard_level", 18);
	set("magic_power", 90);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

            set("last_load_time", uptime());
	set("max_mana", 900);
	set("mana", 900);

        set("combat_exp", 180000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N脸上一阵白，一阵青，口中吐出一股气流。"NOR,who,enemy[i]);
	message_vision(HIC"\n那气流围着$N头顶转了一圈，又被$N吸入鼻中。"NOR,who,enemy[i]);
	message_vision(HIC"\n$N的伤势似乎全部恢复了。\n"NOR,who,enemy[i]);
	message_vision(HIG"［气还符］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

