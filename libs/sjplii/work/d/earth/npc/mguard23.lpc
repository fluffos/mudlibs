// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［入眠符］ 属性：busy4  对象：all  克星：无
//法术：［伏虎符］ 属性：attack  对象：all  克星：无
//法术：［调气通神］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("延维", ({ "yanwei", "taoist guard" }) );
	set("gender", "女性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard23");
 	set("mguard_level", 23);
	set("magic_power", 110);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw" }) );
            set("last_load_time", uptime());
	set("max_mana", 1100);
	set("mana", 1100);

        set("combat_exp", 230000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N猛吸一口气，脸上登时增了血色。"NOR,who,enemy[i]);
	message_vision(HIC"\n只见那股气在$N身上循环了个大周天，伤口渐渐愈合了！\n"NOR,who,enemy[i]);
	message_vision(HIG"［调气通神］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	 return 1;
	}
	if( random(9)<4 )
	{
	message_vision(HIR"\n$N对着$n凌空一指，$n只感到全身肌肉骨骼一阵扭曲，竟然变成了一只"NOR,who,enemy[i]);
	message_vision(HIR"\n伤痕累累的病虎，$N一脚便将那病虎踢得满嘴掉牙，$n才回复了人形。\n"NOR,who,enemy[i]);
	message_vision(HIG"［伏虎符］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< 100 )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
	 return 1;
	}
	else
	if( random(enemy[i]->query("magic_defense"))< 100 && !enemy[i]->is_busy())
	{
	message_vision(HIM"\n$N喃喃念了几句咒语，只见一张符纸缓缓升上半空，"NOR,who,enemy[i]);
	message_vision(HIM"\n眨眼化做无数只瞌睡虫，一齐向$n飞了过来。\n"NOR,who,enemy[i]);
	message_vision(HIG"［入眠符］！\n\n"NOR,who);
			enemy[i]->start_busy(6);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

