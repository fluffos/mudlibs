//法术：［五毒符］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("肥遗", ({ "feiyi", "taoist guard" }) );
	set("race", "野兽");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard20");
 	set("mguard_level", 20);
	set("magic_power", 100);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("limbs", ({ "头部", "身体", "七寸", "尾巴" }) );
        set("verbs", ({ "bite" }) );
            set("last_load_time", uptime());
	set("max_mana", 1000);
	set("mana", 1000);

        set("combat_exp", 200000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	message_vision(HIR"\n$N展开庞大的身体，皮肤上渗出一滴滴毒液。"NOR,who,enemy[i]);
	message_vision(HIR"\n那毒液越聚越多，慢慢流到$n脚下，顿时毒蝎、毒蜈蚣、"NOR,who,enemy[i]);
	message_vision(HIR"\n毒蜘蛛、毒蚂蚁、毒蚯蚓纷纷破土而出，向$n乱咬。\n"NOR,who,enemy[i]);
	message_vision(HIG"［五毒符］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

