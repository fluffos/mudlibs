// luojia.c

inherit ROOM;

void create() {
  set("short", "珞珈山--小路");
  set("long", @LONG 
你上了珞珈山. 四周都是苍天的大树, 路旁开着迷人的野花. 阳光从叶间洒下来,
在地上投下斑驳的阴影. 你走到东山头, 站在一块突起的岩石上, 视线中竟出现一个好
大好大的湖, 粼光闪闪, 千帆竞逐, 真是一番好景.
    西方的林子里透出点炊烟, 好象有户人家.
LONG
  );
  set("exits", ([
    //	"westdown"  : __DIR__"myroom_st",
    "southdown": __DIR__ "wsroad2",
    "up": __DIR__ "ljup",
    "northdown": __DIR__ "ljguilin1",
  ]));
  set("objects", ([
    __DIR__ "npc/luhuinan": 1,
  ]));
  setup();
}
