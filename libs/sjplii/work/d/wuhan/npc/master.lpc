// master.c
#include <ansi.h>
//#include "quest.lpc"
//#include "quest.h"
inherit NPC;
inherit F_MASTER;
int about_quest();
mapping *quest = ({
([
	"name":  "长剑",  
	"id"  :  "sword",
	"tit" :  "第二代弟子",
	"pot" :  1,
	"exp" :  10,
	"exp_required" : 0,
]),
([
	"name":  "鲜鱼",  
	"id"  :  "fish",
	"tit" :  "第二代弟子",
	"pot" :  5,
	"exp" :  20,
	"exp_required" : 0,
]),

});

void create()
{
        set_name("余志枭", ({"master whale", "master","whale" }) );
        set("nickname", HIR"百变蛟龙"NOR);
        set("gender", "男性" );
	set("attitude", "friendly");
	set("class", "haijing");
        set("age", 43);
        set("str", 190);
        set("cor", 60);
        set("cps", 27);
        set("int", 30);

        set("max_force", 16000);
        set("force", 19000);
        set("force_factor", 100);
        set("max_atman", 16000);
        set("atman", 19000);
        set("atman_factor", 50);
	
	set("water", 200);
	set("food", 200);

        set("rank_info/respect", "余帮主");

        set("long", @LONG
余志枭是一个不高不矮的中年人, 粗看一眼好象觉得他也很普通, 仔细一打量
你却发现他浑身上下都充满了魅力. 难怪他四十岁出头居然能独创海鲸帮, 崛
起江湖, 作了长江十八盘连营三十六环水寨的总头领. 
LONG
);
        create_family("海鲸帮",1 , "帮主");

        set("combat_exp", 1900000);
        set("score", 20000);

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
"余志枭轻笑道: 阁下自己来找麻烦, 就别怪我手下不留情了!!!\n",
                (: perform_action, "unarmed.youqian" :),
        }) ); 

        set_skill("unarmed", 250);
        set_skill("dodge", 250);
        set_skill("force", 250);
        set_skill("literate", 170);

        set_skill("dragonforce", 250 );
        set_skill("dragon_strike", 250);
        set_skill("dragon-steps", 250);
	set_skill("diving", 150);
	set_skill("swimming", 180);
	set_skill("trade", 200);
	
	map_skill("force", "dragonforce");
        map_skill("unarmed", "dragon_strike");
        map_skill("dodge", "dragon-steps");

        set("inquiry", ([
                "quest" : (: about_quest :),
                "name": "你既然知道我余帮主，怎麽不知道我是余志枭？",
                "here": "这里便是海鲸帮总舵。",
		"瞎老头" : "唉！这件事你就不要问了！不过这位老先生功夫\n"
			"惊世骇俗，和他交交手会大有进益的！\n",
        ]) );

        setup();
        carry_object(__DIR__"obj/jasmine_hat")->wear();
        carry_object(__DIR__"obj/jasmine_cloth")->wear();
	carry_object(__DIR__"obj/jasmine_boots")->wear();
}


void attempt_apprentice(object ob)
{
        if( ob->query("betrayer"))
		message_vision("余志枭轻蔑地看着$N道: 我帮不收不忠之徒!\n",
		ob);
       else{
//        command("smile");
        command("say " + RANK_D->query_respect(ob)
        +"愿为鄙帮效力, 在下自是求之不得!!!"
);
        command("recruit " + ob->query("id") );
}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ){
	        message_vision("余志枭又道: 入得我帮, 当知论功而行赏"
		"有德有才而据高位, 切记切记!!!\n", this_player() );
		if( !ob->query("haijing/finished") ){
		tell_object(ob, "你第一个任务: 将长剑找来给我!\n");
                ob->set("class", "haijing");
                ob->set("title", "海鲸帮记名弟子");
		ob->set("haijing/quest", 0);
		}
		else 
			ob->set("class", "haijing");
			this_player()->set("id_type", 2);
		return;
	}
}
int about_quest()
{
	int task;
	object me=this_player();
	if( !me->query("marks/hjjob") && !me->query_quest_time() )
	{
	command("say 本帮以打渔为生，你去江里抓些鲜鱼来给我。");
	me->set("marks/hjjob","fish");
	me->set_temp("workobj_name","fish");
	return 1;
	}
	else{
	command("say 你还站在这里干什么？还不快去江里捕鲜鱼去！");
	return 1;
	}
	return 1;
}

int accept_object(object who, object ob)
{
         int n;
	mapping qu;
	if(who->query("class") != "haijing")return 0;
       
	n = who->query("haijing/quest");
	qu = quest[n];
	if( ob->query("id") == (string)who->query_temp("workobj_name") && ob->query("objattrib")){
		say( CYN"余志枭微笑点头，说道：很好，继续努力。\n"NOR);
		who->add("combat_exp", random(30) + 20);
		who->add("potential", random(20) + 10);
		who->add("score", random(10));
		who->add("life_exp", random(20));
		who->set_quest_time(random(120)+60);
		if( who->query("marks/hjjob") )
		who->delete("marks/hjjob");
		if( who->query_temp("workobj_name") )
		who->delete_temp("workobj_name");
		return 1;
		}

	if( ob->query("name") == qu["name"] 
	&& ob->id(qu["id"])
	&&who->query("haijing/finished") != qu["name"]){
		message_vision("余志枭微笑着点了点头。\n",who);
		message_vision("余志枭轻拍了一下$N的肩膀，说道: 干得不错！\n",who);
		command("say 从现在起你就是我帮" + qu["tit"] + "了！\n");
		who->set("title", "海鲸帮"+qu["tit"]);
		tell_object(who, 
		sprintf(HIY"你被奖励了：\n%s点潜能\n%s点经验,\n"NOR, 
                         chinese_number(qu["pot"]),
			chinese_number(qu["exp"])));
		who->add("combat_exp", qu["exp"]);	
		who->add("potential", qu["pot"]);
		who->set("haijing/finished", qu["name"]);
		return 1;
	}
	return 0;
}
 
int accept_fight(object ob)
{
	object token;

	if ((int)ob->query("combat_exp") < 10000){
		command("say "+ RANK_D->query_respect(ob) +
		"功夫还得练练, 要动手去找本帮香主去吧!!");
		command("pat " + ob->query("id") );
		return 0;}
	if ((int)ob->query("combat_exp") < 100000){
		command("say "+ RANK_D->query_respect(ob) +
		"功夫还得练练, 要动手去找本帮舵主去吧!!");
		command("pat " + ob->query("id") );
		return 0;}
	if ((int)ob->query("combat_exp") < 200000){
		command("say "+ RANK_D->query_respect(ob) +
                "功夫还得练练, 要动手去找本帮护法去吧!!");
                command("pat " + ob->query("id") );
                return 0;}
	else{
		if( query("fight/"+ob->query("id")) < 10 ){
			command("say 好！你接我一招！");
			add("fight/"+ob->query("id"), 1);
			COMBAT_D->do_attack( this_object(), ob);
			if( (int)ob->query("kee") < 1 
                	|| environment(ob)!= environment() ) 
			command("say 哈哈！又一个自不量力的家伙");
			else {
			command("say 哈哈！你不错！来！我给你一块保命金牌，"
				"可不要随便给人");
			token =  new(__DIR__"obj/token3");
			token->set("owner", ob->query("id"));
			token->move(ob);
			}
		}
		else {
			command("say 哈哈！你已经接过我九招了");
			return 0;
		}
	}
}
		
