#include <ansi.h>
inherit NPC;

void create()
{
        set_name("瞎老头", ({"xiazi"}));
        set("long", "这是一个形容憔粹的老头子, 双目灰蒙蒙的, 好象是被什么药物"
"给弄瞎的\n");
	set("attitude", "aggresive");
	set("kee", 1000);
	set("max_force", 4000);
	set("force", 6000);
	set("force_factor", 5);
	set("str", 29);
	set_skill("dodge", 80);
	set_skill("unarmed", 120);
	set("combat_exp", 300000);
	set("water", 600);
	set("food", 1000);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 45);
	set_temp("apply/damage", 40);
        setup();
}

void init()
{
        object ob;

        ::init();
	if(interactive(ob = this_player()) &&living(this_object())){
		tell_object(ob, HIR"\n瞎老头吼道：又有人想要来害我吗?\n\n");
		message("vision", HIR"\n瞎老头吼道：又有人想要来害我吗?\n\n"HIR
		    ,environment(), ob);
		kill_ob(ob);
		ob->fight_ob(this_object());
        call_out("addexp", 9);
	}
}

int addexp()
{
        object ob;
        int i, n = sizeof(enemy);
        int value;        
        
        remove_call_out("addexp");
        value = (int) 4/n;
        
        for( i = 0; i<n; i++ ){
          ob = enemy[i];
          if( userp(ob) &&  environment(ob)==  environment() 
                && living(ob)&& ob->query("combat_exp")<200000 ){
                ob->add("combat_exp", value);
                ob->add("life_exp", value/2);
                ob->add("relation_exp", value/2);
          }     
        }
        call_out("addexp", 9);
}

