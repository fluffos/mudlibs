// npc.c

inherit NPC;

void create()
{
    set_name("南宫无妄",({"nangong"}));
    set("long", "南宫无妄锦缎貂裘，却是副病疡疡的样子\n");
    set("title", "南宫钱庄");
    set("gender", "男性");

    set("attitude", "friendly");
    set("food", 500);
    set("water", 500);
    set("str", 20);
    set("per", 20);
    set("con", 20);
    set("int", 20);
    set("cps", 20);

    set_temp("combat_exp", 200000);
    set_temp("apply/attack", 100);
    set_temp("apply/defense", 100);
    set_temp("apply/damage", 30);
    set_temp("apply/armor", 40);

    set_skill("dodge", 100);
    set_skill("unarmed", 100);
    set_skill("parry", 100);
    set_skill("blade", 100);
    
    
    setup();
    add_money("gold", 5);
    carry_object(__DIR__"obj/ngblade")->wield();
}
