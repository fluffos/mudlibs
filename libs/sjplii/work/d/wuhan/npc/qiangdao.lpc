// bandit.c

inherit NPC;

void create() {
  set_name("强盗", ({ "qiang dao", "dao" }));
  set("gender", "男性");
  set("age", 33);
  set("long",
    "这家伙满脸横肉，一付凶神恶煞的模样，令人望而生畏。\n");
  set("combat_exp", 5000);
  set("score", 50);
  set("daode", -10);
  set("attitude", "aggressive");
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set("score", 100);
  set("daode", -20);
  setup();
  carry_object("/obj/longsword")->wield();
  add_money("silver", 10);
}
