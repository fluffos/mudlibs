// yachai.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("捕快", ({ "bu kuai","bu" }) );
        set("long",               
"这是一个精明老练的衙门捕快，小偷大盗都逃不过他们的追捕。\n");

        set("attitude", "heroism");
        set("vendetta_mark", "authority");
        set("pursuer", 1);

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 100000);
	 set("score",2000);
	 set("daode",400);
        set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :),
        }) );

        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "捕快喝道：还不快放下武器束手就缚？\n",
                "捕快喝道：大胆刁民竟敢拒捕？反了！反了！\n"
        }) );

        set_skill("unarmed", 100);
        set_skill("blade", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);

        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 70);

        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/blade")->wield();
}

 
