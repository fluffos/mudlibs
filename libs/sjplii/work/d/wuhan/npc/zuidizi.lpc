// zuidizi.c

inherit NPC;

void create()
{
        set_name("海鲸帮弟子",({ "whale dizi","dizi"}));
	set("gender", "男性" );
        set("chat_chance", 3);
	set("chat_msg", ({
	"海鲸帮弟子说: 嘿嘿! 被抓进来了吧...\n"
}) );
	set("age", 25);
        set("str", 30);
        set("cor", 30);
        set("cps", 27);
        set("per", 27);
        set("int", 10);

        set("attitude", "friendly");

        set("max_force", 200);
        set("force", 200);
        set("force_factor", 2);
	
	set("combat_exp", 2000);
	
	set_skill("unarmed", 40);
	set_skill("dragon-steps", 40);
	set_skill("dodge", 40);
	set_skill("force", 40);
	set_skill("dragonforce", 30);
	set_skill("dragon_strike",30);
	set_skill("swimming", 50);

	map_skill("unarmed", "dragon_strike");
	map_skill("force", "dragonforce");
	map_skill("dodge", "dragon-steps");
	setup();

	carry_object(__DIR__"obj/zicloth")->wear();
}

int accept_fight(object ob)
{
	if(ob->query("class")=="haijing")
	{
		command("say 好, 自帮兄弟点到为止!");
		return 1;
	}
	return 0;
}
