// serpent.c

inherit NPC;

void create()
{
	set_name("水蛇", ({ "shuishe" }) );
	set("long", "一条黑得发亮的大水蛇\n");

	set("race", "野兽");
	set("age", 100);
	set("attitude", "aggressive");

	set("max_gin", 900);
	set("max_kee", 900);
	set("max_sen", 500);

	set("str", 30);
	set("cor", 70);
	set("spi", 20);
	set("int", 10);

	set("limbs", ({ "头部", "躯干", "尾巴" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 50);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 20);

	set("combat_exp", 10000);
	set("score", 1000);
	setup();
}
