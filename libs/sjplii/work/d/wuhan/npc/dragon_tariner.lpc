// dragon_trainer.c

inherit NPC;

void create()
{
        set_name("海鲸帮陪练",({ "trainer"}));
	set("gender", "男性" );
	set("title", "可打不可杀");
        set("age", 25);
        set("str", 2);
        set("cor", 50);
        set("cps", 20);
	set("con", 50);
        set("per", 27);
        set("int", 30);
	set("max_kee", 20000);
	set("kee", 20000); 
	set("food", 500);
	set("water", 500);
        set("attitude", "peaceful");
	setup();
	carry_object(__DIR__"obj/zicloth")->wear();
}


int accept_fight(object ob)
{
	int myattack, mydefense, myexp;
    object weapon;


    if(ob->query("class")!="haijing"){
	set("combat_exp", ob->query("combat_exp")*10);
	command("say 什么人? 竟敢闯到这里来?");
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	kill_ob(ob);
	return 0;
    }
    else if( ob->query("combat_exp") > 70000){
	command("say 你武功已小有所成，该出去历练了！");
	return 0;
    }
    else{
	set("kee", 20000); 
//	set("combat_exp", ob->query("combat_exp") + 100);
//	set_temp("apply/dodge", ob->query_skill("unarmed", 1) + 2);
//		           + ob->query_skill("dragon_strike", 1) * 2);	
//	set_temp("apply/unarmed", ob->query_skill("dodge", 1)
//		           + ob->query_skill("dragon-steps", 1) * 2 
//
//	                   );
        myexp = ob->query("combat_exp");
	myattack = ob->query_skill("unarmed");
	mydefense = ob->query_skill("dodge");
	set("combat_exp", myexp + 300);
	set_temp("apply/attack", mydefense);
	set_temp("apply/defense", myattack);
	return ::accept_fight(ob);
    }
}
