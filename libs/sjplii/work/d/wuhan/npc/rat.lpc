// rat.c

inherit NPC;

void create()
{
        set_name("大老鼠", ({ "big rat", "rat" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只一尺长的大老鼠。\n");

        set("limbs", ({ "头部", "身体"  }) );
        set("verbs", ({ "bite" }) );
        set("score",100); 
	set("combat_exp", 100);
        set_skill("dodge", 30);
        set_skill("unarmed", 20);

        setup();
}

