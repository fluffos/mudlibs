// npc.c

inherit NPC;

void create()
{
    set_name("卢会南",({"lu"}));
    set("long", "这是个憨态可掬的年轻道士，身受极重的伤，蜷曲在地上\n");
    set("gender", "男性");

    set("class", "taoist");
    create_family("茅山派", 6, "弟子");

    set("age", 30);
    set("attitude", "friendly");
    set("food", 500);
    set("water", 500);
    set("str", 20);
    set("per", 15);
    set("con", 20);
    set("int", 10);
    set("cps", 20);
    set("kee", 30);
    set("eff_kee", 30);
    set("max_gin", 1400);
    set("gin", 1400);
    set("sen", 1400);
    set("max_sen", 1400);
    set("force", 2000);
    set("combat_exp", 500000);
        set("max_force", 1000);
        set("force_factor", 30);

        set("atman", 1400);
        set("max_atman", 1400);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 5);
	set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "drainerbolt" :),
                (: cast_spell, "netherbolt" :),
                (: cast_spell, "feeblebolt" :),
                (: cast_spell, "invocation" :),
        }) );

	set_skill("literate", 10);
        set_skill("magic", 50);
        set_skill("force", 30);
        set_skill("spells", 80);
        set_skill("scratching", 80);
        set_skill("unarmed", 30);
        set_skill("sword", 40);
        set_skill("parry", 40);
        set_skill("dodge", 40);
        set_skill("gouyee", 60);
	set_skill("sanqing-jian", 100);
        set_skill("taoism", 80);
        set_skill("necromancy", 80);

        map_skill("spells", "necromancy");
	map_skill("sword", "sanqing-jian");
	map_skill("parry", "sanqing-jian");

	set("inquiry", ([
	    "前辈" : "呀！我可啥也没说！\n",
	    "郑寡妇" : "呀！我可啥也没说！\n",
	    "剑" : "呀！我可啥也没说！\n",
	    "线索" : "呀！我可啥也没说！\n",
	    ]) );
    set("chat_chance", 5);
    set("chat_msg", ({
	"卢会南说：没想到我千辛万苦好不容易找到了线索，郑寡妇却把它弄丢了\n",
        "卢会南说：前辈说过只要找到这把剑，就可以...\n",
})    );
    
    setup();
    carry_object("/obj/sword")->wield();
}

int accept_object(object who, object ob)
{
    if( ob->query("name") == "烂铁剑" ){
	command("say 谢谢你找到这把剑，可惜我不行了... 这样吧，我先把这身功夫传了你!");
	who->set("marks/卢会南", 1);
	return 1;
    }
    return 0;
}

int recognize_apprentice(object ob)
{
        if( !ob->query("marks/卢会南") ) return 0;
        return 1;
}
