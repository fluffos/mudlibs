// dragon_guard.c

inherit NPC;

void create()
{
        set_name("海鲸帮舵主", ({ "whale commander","commander"}));
	set("gender", "男性" );
        set("age", 42);
        set("str", 55);
        set("cor", 30);
        set("cps", 27);
        set("per", 2);
        set("int", 10);
	set("attitude", "friendly");

	set("max_force", 1000);
        set("force", 1000);
        set("force_factor", 10);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 50000);
	
	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_skill("dragon-steps", 80);
	set_skill("force", 100);
	set_skill("dragonforce", 80);
	set_skill("dragon_strike",80);
	set_skill("diving", 100);;
        set_skill("zgongsword", 80);
        set_skill("parry", 80);
        set_skill("sword", 80);

        map_skill("sword", "zgongsword");
        map_skill("parry", "zgongsword");

	map_skill("unarmed", "dragon_strike");
	map_skill("force", "dragonforce");
        map_skill("dodge", "dragon-steps");

	setup();
	carry_object(__DIR__"obj/zicloth")->wear();
	carry_object("/obj/sword");
}

void init()
{
    add_action("dokill", ({"kill"}));
}

int accept_fight(object ob)
{
    object weapon;

        if(ob->query("class")=="haijing")
        {
                command("say 好, 自帮兄弟点到为止!");
		if( weapon = query_temp("weapon") )
		    command("unwield sword");
		set("force_factor", 0);
                return 1;
        }
        return 0;
}

int dokill(string arg)
{
    object weapon;

    if(!this_object()->id(arg))return 0;
    message_vision("\n$N对著$n喝道：「" 
                + RANK_D->query_rude(this_object())
		   + "！今日不是你死就是我活！」\n\n", this_player(), this_object());

    command("laugh");
    set("force_factor", 5);
    if( weapon = present("sword", this_object()))
	command("wield sword");
    this_object()->kill_ob(this_player());
    this_player()->kill_ob(this_object());
    return 1;
}
