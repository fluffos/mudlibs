// guohong.c

#include <ansi.h>
inherit NPC;

void create()
{
	set_name("郭宏", ({"guo hong", "guo"}));
	set("gender", "男性");
	set("age", 50);
	set("long", "郭宏是个大财主, 但是乐善好施, 在武昌颇有善名.\n");
	set("str", 30);
        set("cor", 30);
        set("cps", 29);
        set("int", 20);
	set("max_kee", 600);
	set("kee", 600);
	set("food", 400);
	set("water", 400);

	set("combat_exp", 20000);
	set_skill("dodge", 90);
	set_skill("unarmed", 100);

	set("inquiry", ([
	    "胭脂" :  "胭脂吗? 您不知道汉口有一家香粉店卖胭脂特别有名吗?",
]) );
	set("attitude", "friendly");
	setup();
//	add_money("gold", 1);
}

void die()
{ 
        object killer, ob, room;
	
        if(objectp(killer = query_temp("last_damage_from")))
            killer->set_temp("marks/murder", 1);
	if( !(room = find_object("/d/wuhan/gbedroom") ))
	    "/d/wuhan/gbedroom"->set("???", 0);
	if( (room = find_object("/d/wuhan/gbedroom") ))
	if((ob = present("guotai", room) )
	   && !ob->query("titile")){
	    tell_object(environment(), HIY"\n里屋传来一声惊叫: 杀人啦!!!救命啊!!!\n"NOR);
	    tell_room("/d/wuhan/gbedroom", "郭太太突然惊叫道: 杀人啦!!!救命啊!!!再看她时, 竟然疯了.\n");
	    ob->set("title", "疯了的");
	    ob->set("chat_chance", 15);
	    ob->set("chat_msg", ({"郭太太失神落魄道: 杀人了...杀人了...\n"}));
	}
        ::die();
}
