// dukous.c

inherit ROOM;

void create()
{
        set("short", "长江大渡口--武昌");
        set("long", @LONG
这里是著名的长江大渡口。长江浩荡东去，蔚为壮观，你不禁有诗兴大发
之感。一位商贾立时看出端详, 连忙对你说: 您且打住吧! 咱们过江可是要把
半条性命丢在江面上的, 莫要再用之乎者也来烦我。要吟诗您尽可以去蛇山黄
鹤楼。那里什么疯子都有。
    这里人多口杂, 有各种来历的人。一根柱子上贴着张告示(sign).
LONG
        );
	set("item_desc", ([
	"sign":
@LONG
                告示
   最近大渡口不断发生抢劫事件, 请客人们注意好     
身边行李.
   客人们可以喊船过江(guojiang).
   特此通告!
                        长江大渡口
LONG
	]) );
        set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"snakec1",
  "west"  : __DIR__"jiangbian1",
]));
        set("objects", ([
			 __DIR__"npc/shangren" : 1,
			 __DIR__"npc/youngman" : 1,
			 __DIR__"obj/boat"     :1
        ]) );
        setup();
}

void init()
{
         add_action("do_shang", ({"shangchuan"}));
         add_action("do_jiaochuan", ({"guojiang"}) );
}

int do_shang()
{
	object ob, ob1;
	
	if(!(ob1 = present("boat",this_object())))
		return notify_fail("船还没来呢!!\n");
	if( ob = find_object(__DIR__"boatin")){
		destruct(ob1);
		this_player()->move(ob);
		tell_object( this_player(), "你上了船。\n");
		ob->delete("exits/out");
	
		if( ob1 = present("boater", ob) ) destruct(ob1);
		
		ob1 = new(__DIR__"npc/boater1");
		ob1->move(ob);
		ob = new(__DIR__"npc/obj/nticket");
		ob->move(ob1);
	}
	return 1;
}	


int do_jiaochuan()
{
	object ob,ob1;
	message_vision("$N对着江面喊道: 过江...\n", this_player());
	if( present("boat",this_object() ) )
		return notify_fail("船已经在这儿了, 你可以上船(shangchuan).\n");
	if( ob = find_object(__DIR__"dukoun") ){
	    if (!ob = present("boat",ob) )
	    		return notify_fail("请等一会再叫! 船还在江上.\n");
	    destruct(ob);
	    if( ob = find_object(__DIR__"boatin") ){
// 		if( !ob->sizeof(exits) )
//			return notify_fail("请等一会再叫! 船还在江上.\n");
	     if( !ob1 = present("boater", ob) ) ob1 = new(__DIR__"npc/boater1");
		ob1->move(ob);
		
		ob = new(__DIR__"npc/obj/sticket");
		ob->move(ob1);
	    }
	}
	return 1;
}
