// leiting.c

inherit NPC;
void create()
{
        set_name("雷挺",({"lei ting"}));
	set("gender", "男性" );
        set("age", 45);
        set("str", 35);
        set("cor", 30);
        set("cps", 27);
	set("per", 28);
        set("int", 27);
	set("attitude", "friendly");
set("max_kee", 3000);
        set("eff_kee", 3000);
	set("max_force", 4000);
        set("force", 4000);
        set("force_factor", 10);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 1000000);
	
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
        set_skill("parry", 100);
	set_skill("sword", 100);
	set_skill("six-chaos-sword", 200);
	set_temp("apply/dammage", 100);
	map_skill("parry", "six-chaos-sword");
	map_skill("sword", "six-chaos-sword");
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/gangjian")->wield();
}
