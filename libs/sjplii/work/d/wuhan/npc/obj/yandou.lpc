// yandou.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("烟斗", ({"yandou"}));
	set_weight(10);
	set("value", 500);
	if( clonep() )
		set_default_object(__FILE__);
	else{ 
		set("unit","只");
		set("long", "一只香木烟斗, 可以抽(chou)\n");
	}
	init_hammer(2);
	setup();
}

void init()
{
    add_action("do_chou", "chou");
}

int do_chou(string arg)
{
	object ob = environment();

  if(arg != "yandou")return 0;
  tell_room(environment(ob), ob->query("name")+"含了一口烟斗.\n");
return 1;
}
