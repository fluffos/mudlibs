// guijiu.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("桂花醇酒", ({ "jiudai" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶桂花醇酒\n");
    set("unit", "瓶");
    set("value", 20);
    set("max_liquid", 15);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "alcohol",
    "name": "桂花醇酒",
    "remaining": 15,
    "drunk_apply": 6,
  ]));
}
