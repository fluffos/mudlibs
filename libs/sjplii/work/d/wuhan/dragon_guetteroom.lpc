// dragon_guetteroom.c

inherit ROOM;

void create()
{
	set("short", "密室");
	set("long", @LONG
这是一个秘密的所在, 一个海鲸帮弟子在这里监视书房的动静.
LONG );
	set("exits", ([
	"out": __DIR__"dragon_library"
]) );
	set("objects", ([
	__DIR__"npc/dragon_guard" : 1,
]) );
	setup();
}

int valid_leave(object me, string exit)
{
	object ob;
	if(!present("dragon guard", this_object()) )
		if (ob = find_object(__DIR__"dragon_library") )
			ob->set("free", 1);	
	return 1;
}

void reset()
{
	object ob;

	::reset();
	if (ob = find_object(__DIR__"dragon_library") )
		ob->delete("free");
}
