// wduguan.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "好再来");
  set("long", @LONG
这是武昌最大的赌场。你来这里只要是赌, 就没有不欢迎的。你若是
在这里输掉千儿八百两金子, 也没人会奇怪。要是你只想赌一两银子也不
会有人嫌你押得小。
    门边摆着张紫楠木的长桌, 桌上只放了个翡翠雕琢成的小碗, 碗边放
着副翡翠骰子。桌旁雄赳赳气昂昂地站着好再来的大老板。有一块乌木雕
成的小招牌(sign)挂在一边的墙上。
    正在装修扩建.
LONG);
  set("exits", ([
    "north": __DIR__ "wroad4",
  ]));

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("objects", ([
    __DIR__ "npc/judge": 1,
  ]));

  setup();

}

string look_sign(object me) {
  return "赌大小\n"
    "\n"
    "ｂｅｔ <银子数>\n"
    "ｓａ 骰子\n";
}
