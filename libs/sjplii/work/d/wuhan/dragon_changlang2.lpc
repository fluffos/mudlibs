// Room: /u/wuhan/dragon_changlang2.c

inherit ROOM;

void create()
{
	set("short", "长廊");
	set("long", @LONG
这是一条深邃的长廊, 你的四周是一个好大的院落.
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"dragon_changlang",
  "west" : __DIR__"dragon_library2",
]));
	
        set("objects", ([
	__DIR__"npc/dragon_commander" : 2,
]) );
	set("no_clean_up", 0);
        set("outdoors", "wuhan");
	setup();
	replace_program(ROOM);
}

int valid_leave(object who, string exit)
{
        if( exit != "south" 
        && who->query("class") != "haijing" 
	&& present("dragon commander", this_object()) )
	    return notify_fail("海鲸帮舵主喝道：什么人？竟敢闯到这里来？\n");
        return ::valid_leave(who, exit);
}
