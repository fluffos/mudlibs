// /d/wuhan/yinwusecret.c

inherit ROOM;

void create()
{
        set("short", "暗道");
        set("long",@LONG
这里是一个地下暗道, 黑咕隆冬. 暗道很长, 不知通向何处. 你往
前走了一会儿, 却发现乱石密布, 污泥纵横, 再也走不通了.
LONG);
        set("exits", ([
        "up"    : __DIR__"yinwuzhou3",
]) );
        set("no_clean_up",0);
        setup();
}       
        
void init()
{
        object who;
     if( who= this_player()){
        who->delete_temp("qian");
      who->delete_temp("you");
      who->delete_temp("precedent");
      who->delete_temp("jue");
     }
     add_action("do_jue", "jue");
     add_action("do_qian", "qian");
     add_action("do_you", "you");
     add_action("putput", "put");
}

int do_qian()
{
    this_player()->add_temp("qian", 1);
    message_vision ("$N向前走了一步。\n", this_player());
    tell_object(this_player(), "你前走第" 
                + chinese_number(this_player()->query_temp("qian"))
                + "步\n");
    if( this_player()->query_temp("precedent") == "you" ){
        tell_object(this_player(), 
                    "你这一步也不知是大了还是小了，总之有点不对劲\n");
        this_player()->set_temp("jue", "luanzou");
    }
    this_player()->set_temp("precedent", "qian");
    return 1;
}

int do_you()
{
    this_player()->add_temp("you", 1);
    message_vision ("$N向右走了一步。\n", this_player());
    tell_object(this_player(), "你右走第" 
                + chinese_number(this_player()->query_temp("you"))
                + "步\n");
    this_player()->set_temp("precedent", "you");
    return 1;
}

int do_jue()
{
    object ob, * list, me = this_player(), victim;
    int n, idx, t;
    int you, qian;
    if( !(ob = this_player()->query_temp("weapon") ) ){
        message_vision("$N用双手在地上乱刨一阵，好象没有什么办法\n",
             this_player());
        return 1;
    }
    message_vision("$N用" + ob->query("name") + "在地上刨起来\n", this_player());
    if( ob->query("name") != "铁锹" ){
        n = 50;
        tell_object(this_player(), "结果好象效果不大\n");
    }
    else{
        you = this_player()->query_temp("you");
    qian = this_player()->query_temp("qian");
    if( this_player()->query_temp("jue", "luanzou") )
        n = 5;
    else if( you <=  28 )
        n = 8;
    else if( qian  >= 16 )
        n = 5;
    else if( you != 30 )
        n = 20;
    else if( qian != 13 )
        n = 100;
    else if( !query("exits/west")){
        if(present("yin zhuzi", this_object()))
                return notify_fail("都挖出来了还挖?\n");
        tell_object(__FILE__,
                    "只听当的一声，铁锹触到什么东西！\n");
        __DIR__"obj/silverzhuzi"->move(this_object());
        return 1;
    }
    else return 1;
    }
    
    t = random(n);
    if( t < 2 ){
        tell_object(__FILE__, "突然，地底下叮当一响，随后轰隆一声...一片火光和气浪迎面扑来...\n");
        if( t == 0 ) { //this_player()->die();
                victim = this_player();
                victim->clear_condition();
                // Give the death penalty to the dying user.
                victim->set("bellicosity", 0);
                victim->add("combat_exp", -(int)victim->query("combat_exp") / 
20);
                victim->delete("vendetta");
                if( victim->query("thief") )
                        victim->set("thief", (int)victim->query("thief") / 2);
                if( (int)victim->query("potential") > 
(int)victim->query("learned_points"))
                        victim->add("potential",
                                ((int)victim->query("learned_points") - 
(int)victim->query("potential"))/2 );
                victim->skill_death_penalty();

                CHANNEL_D->do_channel(this_object(), "rumor",
                        sprintf("%s被炸弹炸死了！\n", victim->name(1)));
                victim->die();
        }
        list = all_inventory(this_object());
        for(idx=0; idx<sizeof(list); idx++) {
                me = list[idx];
                if (!userp(me))
                        continue;
                me->unconcious();
        }
        
    }
    else 
        tell_object(this_player(), "结果什么也没有！\n");
    return 1;
}

int putput(string arg)
{
        object ofrom;
        object oin;
        string aa,bb;
        if(sscanf(arg,"%s in %s", aa, bb) != 2 ) return 0;
        if( !( oin = present("yin zhuzi", this_object()) ) ) return 0;
        if( !( ofrom = present("silver club", this_player()) ) ) return 0;
        if( random(4) == 0 ){
        message_vision("$N试着把银棍插如柱中，轻轻一转，只听一声轻响"
                       + "西边一扇石门大开，出现一个石室！\n", this_player());
        set("exits/west", __DIR__"yinwubao");
        }
        else{
        message_vision("$N试着把银棍插如柱中，转过来转过去却什么也没发生！"
        "$N惨叫一声：又错了！\n", this_player());
        }
        destruct(ofrom);
        destruct(oin);
        return 1;
}

void reset()
{
        ::reset();
        delete("exits/west");
}
