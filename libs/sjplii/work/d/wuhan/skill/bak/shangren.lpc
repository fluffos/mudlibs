// bandit_guard.c

inherit NPC;

void create() {
  set_name("商人", ({ "shangren" }));
  set("gender", "男性");
  set("age", 41);
  set("long",
    "一个肥肥胖胖的有钱人。\n");
  set("str", 26);
  set("cor", 14);
  set("cps", 29);
  set("int", 25);

  set("combat_exp", 3600);

  set("attitude", "aggressive");
  set_skill("force", 60);
  set_skill("unarmed", 80);
  set_skill("dodge", 60);

  setup();
  carry_object(__DIR__ "obj/goldcloth")->wear();
  add_money("gold", 1);
  carry_object(__DIR__ "obj/letter");
}
