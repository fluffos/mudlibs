// gaolao.c

inherit NPC;
void dochou();
void create()
{
	set_name("高老者", ({"oldman"}));
	set("long", "一位清瘦的老者\n");
	set("age", 101);
	set("chat_chance", 5);
	set("chat_msg", ({
		(: dochou :),
}) );
	setup();
	carry_object(__DIR__"obj/yandou")->wield();
	carry_object("/obj/cloth")->wear();
}

void init()
{
	object me;
	::init();
	if(interactive(me)){
	command("sigh");
	command("say 这两位先人退隐江湖算来也有千儿八百年了吧");
	}
}

void dochou()
{
	if(present("yandou", this_object()))
		command("chou yandou");
}
