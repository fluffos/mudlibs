// Room: /u/wuhan/shui4.c

inherit ROOM;

void create()
{
	set("short", "沉船");
	set("long", @LONG
你眼前出现一艘沉船. 它至少有三层楼高, 如今卧在这里就如同礁石一般.
一边船舷完全被礁石撞得稀烂, 大大小小的鱼在船里船外游来游去, 几片残存的
船帆在江流中幽灵般地飘荡. 你缓缓地游过去如同游向一个神话.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "up" : __DIR__"shui3",
]));
        set("objects", ([
	__DIR__"npc/guaiyu"  : 1,
	__DIR__"obj/yinarmor": 1,
	__DIR__"obj/unarmed_b2" : 1,
]) );

	set("no_clean_up", 0);

	setup();
}

void init()
{
     add_action("do_dive", ({"enter"}));
}

int do_dive(string arg)
{
        object ob;

	if( !arg)return 0;
	if( arg != "石缝")return 0;
        if((int) this_player()->query_skill("diving", 1)<70)    
            return notify_fail("你的水下功夫不够!\n");

       tell_room(__DIR__"shui5",
                this_player()->query("name")+"一个猛子扎下来!\n");
       message_vision("$N深吸了一口气, 一个猛子向礁石中扎下去\n", this_player());
                this_player()->move(__DIR__"shui5");
       		this_player()->start_busy(3); 
       return 1;
}

