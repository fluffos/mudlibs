// Room: /u/wuhan/ljlianya.c

inherit ROOM;

void create()
{
	set("short", "掷剑崖");
	set("long", @LONG
这里是山顶的一快空地, 前面霍然是个小小的陡崖, 象是被
人用剑拦腰砍去一半。空地中间是一块巨石, 石上竟然插着一把
宝剑, 只露出剑柄。旁边镂着几行字, 仔细看时, 却是人用手指
写的。
LONG
	);
        set("item_desc", ([
	"剑柄" : "这是个蛇皮包裹的剑柄, 你试试看能不能拔(pull)出来。\n",
	"字" :  @LONG
	原唯愿携伊之手爱伊至老奈何天
        不从人愿奈何世事不如我愿奈何
        情之变竟有于此余之心天地可鉴
        耶为何君再不回头情为何物情为
        何物余问于苍天苍天无语乃大哭
        大醉狂舞不止舞毕掷剑于此去矣
LONG
]) );
	set("exits", ([ /* sizeof() == 1 */
  "westdown" : __DIR__"ljyinyuan",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("pull", "pull");
}

int pull( string arg)
{
    if(arg != "剑柄")return 0;
    if(this_player()->query_str() < 150 )
	return notify_fail("你的力量不够\n");
    if(query("nohere"))return notify_fail("宝剑已被人拔走了!\n");
    message_vision
	("$N双手握住剑柄, 大喝一声, 用力一拔, 居然拔出把精光闪闪的宝剑\n",
	    this_player());
    __DIR__"obj/zsword"->move(this_player());
    set("nohere", 1);
    return 1;
}

void reset()
{
    ::reset();
    delete("nohere");
}
