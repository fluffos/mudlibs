// wtangwu.c

inherit ROOM;

create() {
  set("short", "堂屋");
  set("long", @LONG
一间很普通的堂屋。墙上悬着些文家大少爷的墨宝，果然令人倾倒。
LONG);
  set("exits", ([
    "west": __DIR__ "wyard",
    "east": __DIR__ "wbedroom",
  ]));
  set("objects", ([
    __DIR__ "npc/wtai": 1,
  ]));
  set("outdoors", "hankou");
  setup();
}
