// Room: /d/wuhan/hankou/guic2.c

inherit ROOM;
void sherevive();
void create()
{
	set("short", "龟山");
	set("long", @LONG
山路蜿蜒而上，到得山腰. 这里林木森森，茅草齐腰，草丛中
隐约可见一泓泉水，水声叮咚，甚为悦耳. 
LONG);
        set("item_desc", ([
	  "泉水" :  "那是一汪清泉, 清得看不见底\n",
]) );
	set("exits", ([ /* sizeof() == 1 */
  "down" : __DIR__"guic1",
]));
	set("objects", ([
	__DIR__"npc/qingshe" : 1,
]) );
        set("resource/water",1);
        set("outdoors", "hankou");
	setup();
}

void do_escape()
{    object ob;
 
    if( !(ob = present("qingshe", this_object())))return;
    if(living(ob)){
       if(ob->query("kee") < (int)ob->query("max_kee") / 2 ){
	   tell_room(__FILE__, "大青蛇见势不妙，嗖的一声窜进草丛中不见了!\n");
	   call_out("do_loujia", 30 );
	   call_out("sherevive", 60);
	   destruct(ob);
       }
    }
    return;
}


void do_loujia()
{
    object ob;
    
    if( !(ob = find_object("/d/wuhan/lj_dongkou")) )
	"/d/wuhan/lj_dongkou"->set("???", 1);
    if(ob = find_object("/d/wuhan/lj_dongkou"))
	ob->set("she", 1);
    return;
}



void sherevive()
{
    object ob;
    if( (ob = find_object("/d/wuhan/lj_dongkou")) && ob->query("she")){
	ob->delete("she");
	tell_room(__FILE__,"\n一条青蛇从草丛中钻出来!\n\n");
	ob = new(__DIR__"npc/qingshe");
	ob->move(this_object());
    }
    return;
}

void reset()
{
    object ob;
    ::reset();
    if( ob = find_object("/d/wuhan/lj_dongkou") ){
	ob->delete("she");
    }
}
