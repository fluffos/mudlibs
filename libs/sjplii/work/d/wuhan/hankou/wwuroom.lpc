inherit ROOM;

create()
{
    set("short", "书房");
    set("long", @LONG
这间屋子窗明几亮，清新雅质。文学武经常在这儿读书作赋，倒也自得其乐。
LONG );
    set("exits", ([
        "north"     :  __DIR__"wyard",
]) );
    set("objects", ([
        __DIR__"npc/xuewu"  : 1,
]) );
    set("outdoors", "hankou");
    setup();
}
