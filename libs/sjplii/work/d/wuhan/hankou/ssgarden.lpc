// Room: /u/wuhan/hankou/ssgarden.c

inherit ROOM;

void create()
{
	set("short", "花园");
	set("long", @LONG
园子里种些奇花异草，两个园工在这里忙碌着。北边是书房，从打
开的窗子里可以看到里面的动静。靠东的院墙上有个洞(hole)。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"sshall",
]));
	set("item_desc", ([
	"hole" : "从这里可以看到破祠堂的动静\n",
	]) );
	set("no_clean_up", 0);
	set("outdoors", "hankou");
	set("objects", ([
	__DIR__"npc/ssguard6.lpc" : 2,
	__DIR__"npc/ssguard5.lpc" : 2,
	]) );
	setup();
}

void init()
{
	add_action("do_enter", "enter");
}

int do_enter(string arg)
{
	object me = this_player();
	object ob;
	if( me->is_fighting() )return 0;
	if( arg != "窗子" && arg != "窗" && arg != "window" )return 0;
	message_vision("$N想从窗子里翻进去\n", me);
	if( ob=present("laonianren", this_object())){
	 	ob->kill_ob(me);
		return notify_fail("但是有人大叫一声：干什么？\n");
	}
	me->move(__DIR__"sslibrary");
	message_vision("$N翻了进来\n", me);
	return 1;
}	
