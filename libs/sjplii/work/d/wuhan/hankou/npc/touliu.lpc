// daoliu.c

inherit NPC;


void create()
{
        set_name("刘比", ({"liu"}) );
        set("title", "小偷");
        set("gender", "男性");
        set("long", "这个小偷长得堂堂正正\n");
        set("age", 25);
	set("per", 30);

	set("attitude", "agressive");
        set("combat_exp", 300);
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        setup();
        carry_object(__DIR__"obj/qcloth")->wear();
}

void init()
{
    object ob;

    ::init();
    if( interactive(ob=this_player())){
	command("giggle");
	command("whisper " + ob->query("id") +
		" 嘿嘿, 偷了啥啦? 告诉我!");
    }
}
