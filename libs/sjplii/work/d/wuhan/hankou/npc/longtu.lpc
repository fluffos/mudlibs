// huanglx.c

inherit NPC;

void create()
{
        set_name("点龙图", ({"dian"}) );
        set("title", "龙图武馆");
        set("long", 
        "点龙图是个很豪爽的汉子, 开这家武馆已有些年头了。\n"   
	    "不少年轻人都在这里学艺。\n");
        
        set("statue", "friendly");
        set("age", 43);
        
        set("str", 30);
        set("int", 30);
        set("combat_exp", 300000);
        set("max_force", 2000);
        set("force", 2000);
       
        
        set_skill("force", 50);
        set_skill("unarmed", 100);
        set_skill("sword", 100);
        set_skill("dodge", 100);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/dammage", 50);
        
        set("inquiry", ([
	    "学艺" : "您只用交一两银子就可以在我这儿学武了。\n",
	    "萍姑" : "哼, 我大姐的闺名也是你这样叫的么? 这么没有礼貌！\n",
	    "点萍姑" : "我姐乃是我点家庄的族长\n",
	    "点家庄" : "武昌城南点家庄你没听说过吗? 那里上至八九十老人下至七八岁儿童\n"
	    "都是好身手呢\n",
]) );
        setup();
//        carry_object(__DIR__"obj/goldc")->wear();
//        carry_object(__DIR__"obj/goldh")->wear();
}

int accept_object(object who, object ob)
{
    if( ob->value()< 100)return notify_fail("点龙图哈哈大笑道：你不要这么小气嘛\n");
    command("say 好! 从现在起你就可在本武馆学武了!");
    who->set("marks/龙图", 1);
    return 1;
}

int recognize_apprentice(object ob)
{
    if( !ob->query("marks/龙图") )return 0;
    if(random(2))
	command("say 你去找候大鹏学去吧, 我是不教功夫的!");
    else command("say 我的功夫是不足挂齿的, 我那堂姐萍姑的本事才叫惊天动地呢!");
    return 0;
}
