// girl.c

inherit NPC;

void create() {
  set_name("黄家小姐", ({ "huang xiaojie", "huang", "xiaojie" }));
  set("gender", "女性");
  set("age", 24);
  set("str", 27);
  set("cor", 24);
  set("cps", 11);
  set("per", 27);
  set("int", 20);

  set("attitude", "peaceful");
  set("inquiry", ([
    "冬叶": "你问冬啊? 他这些天都不知道在哪儿鬼混, 也没来看过我!\n"
  ]));

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);

  set("long", "黄小姐因为吃得比较好的缘故略微有些显胖, 不过她也不太\n"
    "在乎, 反正她总是个标致的人物, 胖一点是叫作丰满的.\n");

  set("combat_exp", 50000);

  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "黄小姐撇撇嘴, 一副不屑的样子\n"
  }));

  set_skill("unarmed", 200);
  set_skill("parry", 40);
  set_skill("dodge", 150);
  set_skill("sword", 200);
  set_skill("force", 200);
  set_skill("literate", 40);

  setup();

  carry_object("/d/city/npc/obj/pink_cloth")->wear();
  carry_object("/d/city/npc/obj/shoe")->wear();
}

int accept_fight(object me) {
  command("say 哼! 比就比, 难道小姐我还怕你不成.");
  return 0;
}
