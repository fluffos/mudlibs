// longtu.c

inherit NPC;

void create()
{
        set_name("候大鹏", ({"trainer"}) );
        set("title", "龙图武馆");
        set("long", 
        "一个精壮的汉子, 正在教弟子们武功\n");
        
        set("attitude", "friendly");
        set("age", 43);
        
        set("str", 20);
        set("int", 30);
        set("combat_exp", 5000);
        set("max_force", 2000);
        set("force", 2000);	
	set("force_factor", 3);
        
        set_skill("force", 30);
        set_skill("unarmed", 30);
        set_skill("sword", 30);
        set_skill("dodge", 30);
	set_skill("stealing", 20);
        setup();
}

int recognize_apprentice(object ob)
{
    if( !ob->query("marks/龙图") ){
	command("say 您还不是我们武馆的人吧!");
	return 0;
    }
    return 1;
}
