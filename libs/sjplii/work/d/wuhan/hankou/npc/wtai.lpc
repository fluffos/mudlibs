// wtai.c

inherit NPC;

void create() {
  set_name("文大太太", ({ "wentai" }));
  set("long", "一位清丽的女子.\n");
  set("gender", "女性");
  set("age", 35);
  set("chat_chance", 5);
  set("chat_msg", ({
    "文大太太皱皱眉道: 英志这孩子也越来越不象话了, 总在家里翻箱倒柜的\n" }));
  set("per", 27);
  set("combat_exp", 5000);
  set_skill("dodge", 50);
  set_skill("unarmed", 50);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  setup();
}
