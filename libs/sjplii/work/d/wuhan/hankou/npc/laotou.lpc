// laotou.C

inherit NPC;
void create()
{
        set_name("牢头", ({"laotou"}) );
        set("title", "武汉府");
        set("long", "一个精明强干的牢头\n"); 
        set("age",  40);
        
        set("str", 30);
        set("cor", 30);
        set("combat_exp", 800000);
        set("max_force", 1000);
        set("force", 1000);
	set("force_factor", 20);
	set("max_gin", 800);
	set("gin", 800);
	set("max_sen", 800);
	set("sen", 800);
        
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
	set_skill("force", 300);
        set_temp("apply/attack", 120);
	set_temp("apply/dodge", 100);
	set_temp("apply/defense", 300);
	set_temp("apply/damage", 100);

        setup();
        carry_object(__DIR__"obj/ycloth")->wear();
 }

