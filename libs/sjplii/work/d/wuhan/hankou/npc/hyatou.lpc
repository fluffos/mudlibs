// hyatou.c

inherit NPC;

void create()
{
        set_name("丫头", ({"yatou"}) );
	set("title" , "黄府");
        set("gender", "女性" );
        set("age", 15);
        set("str", 10);
        set("cor", 24);
        set("cps", 11);
        set("per", 27);
        set("int", 21);

        set("max_force", 100);
        set("force", 100);

        set("long", "甜甜的小丫头.\n");

        set("combat_exp", 10000);

        set("chat_chance_combat", 5);
        set("chat_msg_combat", ({
        "咱们只是闹着玩喔, 不要拚死拚活的奥.\n" }) );

        set_skill("unarmed", 60);
        set_skill("parry", 40);
        set_skill("dodge", 50);
        set_skill("sword", 30);
        set_skill("force", 30);
        set_skill("literate", 10);


        setup();

        carry_object(__DIR__"obj/red_cloth")->wear();
        carry_object(__DIR__"obj/shoe")->wear();
}

