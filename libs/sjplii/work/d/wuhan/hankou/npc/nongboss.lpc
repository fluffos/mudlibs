// boaer.c

inherit NEW_VENDOR;

void create()
{
	set_name("龙老头", ({"long"}) );
	set("long", "龙老头在这里作农具的营生已经有四十多个年头儿了, 人缘特别好.\n");
	set("title", "农具店");
        set("age", 70);
        set("max_kee", 500);
        set("max_force", 1000);
        set("force_factor", 1);
	set("water", 600);
	set("food", 600);
        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("force", 90);
        set_temp("apply/attack", 75);
        set_temp("apply/defense", 75);
        set("combat_exp", 150000);

	set("merchandise", ([
  	 __DIR__"obj/chutou" :20, 
	 __DIR__"obj/tieqiao":20 ,
	__DIR__"obj/shanfu":20, 
]) );
	setup();
}


void init()
{
	::init();
	add_action("do_vendor_list", "list" );
        add_action("do_buy", "buy");
}
