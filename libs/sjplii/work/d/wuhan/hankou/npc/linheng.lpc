// linheng.c

inherit NEW_VENDOR;

void create()
{
        set_name("林亨", ({"lin"}) );
        set("long", @LONG
这么有名的书局的主人居然是这样一个肥肥胖胖的俗人，颇有些让人奇怪。
其实林亨本来就只是个商人而已，只不过碰巧和夫子们打上交道罢了。
LONG);
        set("title", "大学书局");
        set("age", 41);
        set("max_force", 1000);
        set("force", 1000);
        set("combat_exp", 5000);
        set_skill("sword", 50);
        set_skill("parry", 50);
        set_skill("dodge", 50);
        set("apply/attack", 50);
        set("apply/defence", 50);
        
        set("merchandise", ([
                __DIR__"obj/sanzi_b":30,
              __DIR__"obj/daode_b":30,
              __DIR__"obj/parry_b":30,
                  __DIR__"obj/dodge_b":30,
                 __DIR__"obj/unarmed_b":30,
]) );
        setup();
        carry_object(__DIR__"obj/zheshan")->wield();
} 

void init()
{
        ::init();
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");
}
