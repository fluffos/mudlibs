// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
void create() {
  set_name("青年人", ({ "qingnianren", "ssguard" }));
  set("gender", "男性");
  set("long", "他很不和善\n");
  set("age", 35);
  set("combat_exp", 300000);

  set("str", 25);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("force", 300);
  set("max_force", 3000);
  set("force", 6000);
  set("force_factor", 30);
  set_temp("apply/dammage", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/attack", 100);
  setup();
  carry_object(__DIR__ "obj/token2");
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object()))
    if (!ob->query("wuhankiller"))
      kill_ob(ob);

}
