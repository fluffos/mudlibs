// /d/wuhan/hankou/npc/xiaoboss.c

inherit F_VENDOR;
inherit NPC;

void create()
{
        set_name("李铭安", ({"li"}) );
        set("long", @LONG
李铭安是个很和气的中年人, 早年也曾行走江湖, 据说他还略通
医术, 点穴内功又都很高明, 所以疗治外伤很有一手.
LONG );
        set("title", "小桃园");
        set("age", 39);
        set("max_kee", 800);
        set("max_force", 1000);
        set("force", 2000);
        set("force_factor", 4);
        set("water", 600);
        set("food", 600);
        set_skill("unarmed", 100);
        set_skill("blade", 100);
        set_skill("dodge", 70);
        set_skill("parry", 50);
        set_skill("force", 100);
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set("combat_exp", 200000);

        set("inquiry", ([
        "疗治外伤" : "这很简单, 您给我20两银子, 我替您包扎. 2两金子我包给你治好.\n"
]) );

        set("vendor_list", ([
         __DIR__"obj/wjitang" :25 , 
        __DIR__"obj/jitang"   :25   ,
]) );
        setup();
        carry_object(__DIR__"obj/blade")->wield();
}


void init()
{
        ::init();
        add_action("do_vendor_list", "list" );
        add_action("do_buy", "buy");
}


int accept_object(object me, object ob)
{
    int n = ob->value();
    int ma , diff, value;
    
    if(is_fighting(this_object()))return notify_fail("李铭安说 没看我正忙着吗?\n");
    if(!living(this_object())) return 0;
    if(n< 2000)return notify_fail("李铭安笑道：这么点钱怎么够?\n");
    command("nod");
    ma = me->query("max_kee");
    diff= ma - me->query("eff_kee");
    if( !diff ){
            command("say 您没有受伤啊!");
            return 1;
    }

    if( n < 20000 ){
        message_vision("李铭安运指如风, 点了$N伤口附近几处大穴, 又上了点伤药.\n", this_player());
        tell_object(me, "你觉得好多了\n");
       
        value = (diff>25)?25:diff;
        me->add("eff_kee", value);
    }
    else{
        message_vision("李铭安运指如风, 点了$N伤口附近几处大穴,"
                "止住流血. 然后盘膝坐下, 运功替$N疗伤\n"
                "\n过了一盏茶的工夫, 李铭安站起身来笑道：好了!\n",this_player());
        me->start_busy(3);
        me->set("eff_kee", ma);
        me->add("kee", diff/2);
    }
    return 1;
}
