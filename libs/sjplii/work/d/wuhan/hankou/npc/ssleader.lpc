// hjiaren.c
inherit NPC;
int haha();

void create()
{
        set_name("项城隍", ({"xiang", "ssleader"}) );
        set("gender", "男性");
        set("long", "威严，残酷，智慧\n");
        set("age", 45);
        set("combat_exp", 100000);
       
	set("inquiry", ([
	"我也来帮你" : (:haha:),
	]) ); 
	set("str", 25);
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
	set_skill("throwing", 300);
	set_skill("parry", 300);
	set_skill("force", 300);
	set("max_force", 4000);
	set("force", 8000);
	set("force_factor", 100);
	set_temp("apply/dammage", 130);
	set_temp("apply/defense", 150);
	set_temp("apply/attack", 150);
        setup();
	carry_object(__DIR__"obj/token2");
	carry_object(__DIR__"obj/liuye")->wield();
}

void init()
{
	object ob;

        ::init();
/*        if( interactive(ob = this_player()) && living(this_object())) 
       		if( !ob->query("wuhankiller") )
	         kill_ob(ob);
*/        
}

int haha()
{
	if(query("ok")){delete("ok");
	command("say 很好，我去叫些人");
	return 1;
	}
	return 0;
}

int accept_object( object who, object ob)
{
	if( ob->name()!= "密信"|| ob->query("id")!= "letter")return 0;
	tell_object(environment(),
	"项城隍接过信来，然后起身向书房离去，过了一会儿，他走回来\n"
	"问道：你有什么事要问\n");
	set("ok", 1);
	call_out("sha", 10, who);
	return 1;
}

void sha(object who)
{
	object king, guard, ob,where;
	remove_call_out("sha");
	if( environment()!=environment(who))return;
	if( query("ok")){
		command("say 哼，原来你是个假的");
		kill_ob(who);
		who->fight_ob(this_object());
		delete("ok");
	}
	else{
		command("say 好，我们一起去杀昏君");
		tell_object("/d/wuhan/lou4",
           "一大群人突然出现在你面前，叫道：昏君，你纳命来！\n");
		where = find_object("/d/wuhan/lou4"); 
                  if( !( king = present("heng", where)) ){
                        king = new("/d/wuhan/npc/king");
                        king ->move(where);
                  }
                  if( !( guard = present("peng daneng", where)) ){
                        guard = new("/d/wuhan/npc/baobiao");
                        guard ->move(where);
                  }
		 ob = who;
		 ob->move(where);
		 guard->kill_ob(ob);
		 king->kill_ob(ob);
		 ob->kill_ob(king);	
		 ob->kill_ob(guard);
		 ob = new(__DIR__"ssguard1");
		 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
		 ob = new(__DIR__"ssguard2");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
		ob = new(__DIR__"ssguard3");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
		ob = new(__DIR__"ssguard4");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
 		 ob = new(__DIR__"ssguard5");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
		 ob = new(__DIR__"ssguard6");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);     
                 ob->kill_ob(guard);
		 ob = new(__DIR__"ssguard6");
                 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);    
                 ob->kill_ob(guard);
		 ob = this_object();
		 ob->move(where);
                 guard->kill_ob(ob);
                 king->kill_ob(ob);
                 ob->kill_ob(king);
                 ob->kill_ob(guard);

		 who->set_temp("killingking",1);
		 return;
	}
}
