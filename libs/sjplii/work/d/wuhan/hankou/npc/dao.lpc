// dao.c

inherit NPC;


void create()
{
        set_name("王三", ({"wang"}) );
        set("title", "大盗");
        set("gender", "男性");
        set("long", "一个结结实实的年轻人, 如今一脸倒霉的样子.\n");
        set("age", 25);
	set("per", 10);

	set("attitude", "friendly");
        set("combat_exp", 50000);
	set("max_force", 4000);
	set("force", 4000);
        
        set_skill("unarmed", 150);
        set_skill("dodge", 150);
	set_skill("blade", 200);
	set_skill("parry", 200);
        setup();
        carry_object(__DIR__"obj/qcloth")->wear();
}
