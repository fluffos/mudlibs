// wlaotai.c

inherit NPC; 

void create()
{
	set_name("文老太太", ({"wen laotai"}) );
	set("long", "一个满脸皱纹的老奶奶\n");
	set("gender", "女性");
	set("age", 63);
	set("per", 25);
	set("str", 24);
	set("lit", 28);
	set("combat_exp", 500000);
	set("max_force", 2000);
	set("force", 3000);
	set("force_factor", 4);
	set_skill("dodge", 100);
	set_skill("unarmed", 100);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/damage", 50);
	setup();
}
