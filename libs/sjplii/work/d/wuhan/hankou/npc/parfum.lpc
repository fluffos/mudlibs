// parfum.c

inherit NEW_VENDOR;

int on_service = 0;

void create()
{
	set_name("凌芳", ({"ling"}) );
	set("long", "凌芳是个很讨人喜爱的女孩, 香粉店的生意总是很好.\n");
	set("gender", "女性");
	set("title", "香粉店");
        set("age", 21);
        set("max_kee", 400);
        set("max_force", 500);
        set("force_factor", 1);
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set_skill("force", 100);
        set_temp("apply/attack", 60);
        set_temp("apply/defense", 60);
        set("combat_exp", 10000);

	set("merchandise", ([
  	__DIR__"obj/xiangfen" :20 , 
	 __DIR__"obj/yanzhi"  :20   ,
 	 __DIR__"obj/xuehua"  :20   , 
]) );
	setup();
}


void init()
{
	::init();
	add_action("do_vendor_list", "list" );
        add_action("do_buy", "buy");
}
