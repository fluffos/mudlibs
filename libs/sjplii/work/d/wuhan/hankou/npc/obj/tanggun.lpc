// blade.c

#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("堂棍", ({ "tanggun" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	       
		set("unit", "根");
		set("value", 20000);
		set("material", "iron");
		set("long", "这是衙役们上堂用的堂棍\n");
	}
	init_staff(20);
	setup();
}
