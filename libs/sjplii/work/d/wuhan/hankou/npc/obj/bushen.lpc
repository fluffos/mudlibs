// bushen.c

inherit ITEM;

void create()
{
	set_name("鹿茸",({"lurong"}));
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
     	        "一颗鹿茸, 可以用来(use)补神。\n");
	    set("unit","颗");
	    set("value", 2000);
	}
}

void init()
{
	add_action("apply_medicine","use");
}

int apply_medicine()
{
	int value = 20;
	int diff;

	if(this_player()->is_fighting())
	    return notify_fail("战斗中不能用药治伤!\n");
	diff = this_player()->query("max_sen")-this_player()->query("eff_sen");
	if(!(diff))    return notify_fail("你没有受伤啊?\n");
	if(value > diff) value = diff;
	    
	message_vision("$N用鹿茸补神.\n",this_player());
	this_player()->add("eff_sen",value);
	destruct(this_object());
	return 1;
}


