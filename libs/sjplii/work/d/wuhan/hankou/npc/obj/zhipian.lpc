// map1.c

inherit ITEM;

void create() {
  set_name("纸片", ({ "pozhipian" }));
  set("long", "你可以在上面写字(print)\n");
  set("unit", "片");
  setup();
}

init() {
  add_action("do_print", "print");
}

int do_print(string arg) {
  message_vision("$N把" + arg + "的名字写在破纸片上\n", this_player());
  this_object()->set("victime", arg);
  return 1;
}
