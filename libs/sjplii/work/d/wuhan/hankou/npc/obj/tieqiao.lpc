// tieqiao.c
#include <weapon.h>

inherit STAFF;

void create() {
  set_name("铁锹", ({ "tieqiao" }));
  set_weight(22000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是用来挖土的铁锹\n");
    set("value", 400);
  }
  init_staff(5, TWO_HANDED);
  setup();
}
