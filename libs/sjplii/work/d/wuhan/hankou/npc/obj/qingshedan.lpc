// baotang.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("青蛇胆", ({"qingshedan"}) );
        set_weight(250);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "个");
                set("long", "一个新鲜活嫩的蛇胆\n");
                set("value", 1000);
                set("food_remaining", 1);
                set("food_supply", 5);
	}
	setup();
}

void init()
{
      	add_action("do_eat", ({"eat"}));
}


int do_eat(string arg)
{
	if(!id(arg))return 0;
	if( (int)this_player()->query("food") >= (int)this_player()->max_food_capacity() )
	return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

        tell_object(this_player(), "你皱皱眉头, 怎么这么苦?\n");
	if( random(9)>4)
	{
	switch(random(4)){
	case 1: 
		{
             int  limit;
             limit = (int)(this_player()->query_skill("force", 1) +
this_player()->query_skill("force")/5) * 13 - this_player()->query("max_force");
             if( limit > 1 ) limit = 1;
             if( limit < 0 ) limit = 0;
             this_player()->add("max_force", limit);
}
 
	     this_player()->add("combat_exp", 1);
	     this_player()->add("potential", 1);
	break;
        case 2:   this_player()->add("combat_exp", 1);
        break;  
        case 3:   this_player()->add("potential", 1);
        break;  
	case 0:   this_player()->add("life_exp", 1);
             this_player()->add("combat_exp", 1); 
	break;  
}}
this_player()->add("food", query("food_supply"));
        if( this_player()->is_fighting() ) this_player()->start_busy(2);     
        message_vision("$N将剩下的" + name() + "吃得乾乾净净。\n", this_player());
        destruct(this_object());
        return 1;

}
