// yanzhi.c

inherit ITEM;

void create()
{
	set_name("雪花膏", ({"xuehua"}));
	set("long", "一盒男用雪花膏, 涂(tu)在脸上会让人美一些\n");
	if( clonep() )
		set_default_object(__FILE__);
	else{
		set("value", 1000);
		set("weight", 10);
                set("unit", "盒");
	}
	setup();
}

void init()
{
	add_action("do_tu", ({"tu"}) );
}

int do_tu(string arg)
{
	if(!id(arg))
		return notify_fail("你涂什么?\n");
	if(this_player()->query("gender") != "男性")
		return notify_fail("这是男用的, 女孩子不好用吧?\n");
	message_vision("$N一本正经地把雪花膏涂在脸上\n", this_player());
	this_player()->add_temp("mark/雪花膏", 1);
	if(this_player()->query_temp("mark/雪花膏") == 1){
		this_player()->add_temp("apply/personality", 1);
		call_out("huifu",1000,this_player());
	}
	else {
		this_player()->add_temp("apply/personality", -1);
		tell_object(this_player(),"你变丑了\n");
		call_out("jia",1000, this_player() );
	}
	return 1;
}

int huifu(object me)
{
	me->add_temp("mark/雪花膏", -1);
	me->add_temp("apply/personality", -1);
	tell_object(me, "雪花膏的作用失效了\n");
	return 1;
}

int jia( object me )
{
	me->add_temp("mark/雪花膏", -1);
	tell_object(me,"雪花膏的作用失效了\n");
        me->add_temp("apply/personality", 1);
	return 1;
} 
