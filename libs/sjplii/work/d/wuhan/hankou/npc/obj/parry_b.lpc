// sanzi_b.c

inherit ITEM;

void create()
{
	set_name("防身术", ({ "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("value", 70);
		set("long",
		"这是一本薄薄的书卷.\n");
		set("material", "paper");
		set("skill", ([
			"name": 		"parry",
			"exp_required":	10,
			"sen_cost":		30,
			"difficulty":	25,
			"max_skill":	11
		]) );
	}
}


