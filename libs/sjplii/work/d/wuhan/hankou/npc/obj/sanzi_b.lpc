// blade_book.c

inherit ITEM;

void create() {
  set_name("三字经", ({ "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 70);
    set("long",
      "这是海鲸帮弟子学习水下功夫的书\n");
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "exp_required": 1000,
      "sen_cost": 30,
      "difficulty": 30,
      "max_skill": 11
    ]));
  }
}
