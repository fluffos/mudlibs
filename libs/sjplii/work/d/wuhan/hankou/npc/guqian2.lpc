// guqian2.C

inherit NPC;
string guqian();
void create() {
  set_name("金先生", ({ "jin xiansheng", "jin" }));
  set("long", @LONG
金先生住在黄家已有近一个多月了。从黄老先生对他的态度来看，他们之间的
交情非同一般。金先生白天很少在外走动，晚上则门窗紧闭，细心的丫环留意过，
一到晚上南厢房总是出其的安静，也不知金先生在里面做什么。
    他一张堂堂正正的国字脸，天庭饱满，浓眉豹眼。他身上的肌肉决不会该多的
地方少一点也决不会在该少的地方多一点，浑身上下好象充满了无穷的精力。他只
穿了一件好象很普通的麻布长衫，但是他那么高高大大地往里一站，你便觉得盛气
逼人，让人不可仰视。你想了一想，就觉得  威风凛凛  说的就是他。
LONG);
  set("age", 56);

  set("guqian2", 1);

  set("str", 31);
  set("cor", 30);
  set("combat_exp", 1000000);
  set("max_force", 3000);
  set("force", 5000);
  set("force_factor", 10);

  set_skill("dodge", 100);
  set_skill("blade", 150);
  set_skill("spring-blade", 150);
  set_skill("unarmed", 100);
  set_skill("parry", 150);
  set_skill("force", 100);
  map_skill("blade", "spring-blade");
  map_skill("parry", "spring-blade");

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/dammage", 60);

  set("inquiry", ([
    "name": "金狂！\n",
    "古谦": (: guqian :),
  ]));
  setup();
  carry_object(__DIR__ "obj/mabuc.lpc")->wear();
  carry_object(__DIR__ "obj/qingblade.lpc")->wield();
}

string guqian() {
  command("heng");
  this_object()->kill_ob(this_player());
  this_player()->kill_ob(this_object());
  return "你找死啊";
}

void init() {
  add_action("do_nod", "nod");
  add_action("do_shake", "shake");
}

int do_nod() {
  object gu, lei, king, guard;
  object where;

  if (query("killer") == this_player()->query("id")) {
    message_vision("$N点点头，好！我也去！", this_player());

    tell_object("/d/wuhan/lou4",
      "三个人突然出现在你面前，叫道：昏君，你纳命来！\n");
    where = find_object("/d/wuhan/lou4");
    if (!(king = present("heng", where))) {
      king = new("/d/wuhan/npc/king");
      king->move(where);
    }
    if (!(guard = present("peng daneng", where))) {
      guard = new("/d/wuhan/npc/baobiao");
      guard->move(where);
    }
    gu = new("/d/wuhan/npc/guqian");
    gu->move(where);
    lei = new("/d/wuhan/npc/leiting");
    lei->move(where);
    this_player()->move(where);
    guard->kill_ob(gu);
    guard->kill_ob(lei);
    guard->kill_ob(this_player());
    king->kill_ob(gu);
    king->kill_ob(lei);
    king->kill_ob(this_player());
    gu->kill_ob(king);
    gu->kill_ob(guard);
    lei->kill_ob(king);
    lei->kill_ob(guard);
    this_player()->kill_ob(king);
    this_player()->kill_ob(guard);
    if (lei = present("yu", environment())) destruct(lei);
    king->set("killer", this_player()->query("id"));
    this_player()->set_temp("killingking");
    destruct(this_object());
    return 1;
  } else
    return 0;
}

int do_shake() {
  object gu, lei, king, guard;
  object where;

  if (query("killer") == this_player()->query("id")) {
    message_vision("$N摇摇头，说道：那是戮君之罪啊！\n", this_player());
    command("say 好吧！我也不难为你！这是件宝物，送给你！");
    __DIR__ "obj/watercarf"->move(this_player());
    if (lei = present("yu", environment())) destruct(lei);
    tell_object("/d/wuhan/lou4",
      "两个人突然出现在你面前，叫道：昏君，你纳命来！\n");
    where = find_object("/d/wuhan/lou4");
    if (!(king = present("heng", where))) {
      king = new("/d/wuhan/npc/king");
      king->move(where);
    }
    if (!(guard = present("peng daneng", where))) {
      guard = new("/d/wuhan/npc/baobiao");
      guard->move(where);
    }
    gu = new("/d/wuhan/npc/guqian");
    gu->move(where);
    lei = new("/d/wuhan/npc/leiting");
    lei->move(where);
    guard->kill_ob(gu);
    guard->kill_ob(lei);
    king->kill_ob(gu);
    king->kill_ob(lei);
    gu->kill_ob(king);
    gu->kill_ob(guard);
    lei->kill_ob(king);
    lei->kill_ob(guard);
    delete("killer");
    return 1;
  } else return 0;
}
