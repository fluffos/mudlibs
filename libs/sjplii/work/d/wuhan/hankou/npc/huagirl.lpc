// huagirl.c

inherit NEW_VENDOR;

void create()
{
	set_name("翠翠", ({"cuicui"}));
	set("long", "翠翠只有十六岁, 开花店却已经有四年了."
		"花店的客人很多, 一来信誉很好, 二来大家都愿意来这儿看看翠翠的笑脸\n");
	set("title", "花店老板");
	set("combat_exp", 8000);
	set("unarmed", 60);
	set("dodge", 100);
	set("max_force", 300);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 30);
	
	set("merchandise", ([
	   __DIR__"obj/rrose":20,
	  __DIR__"obj/wrose":20,
]) );
	setup();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");
}
