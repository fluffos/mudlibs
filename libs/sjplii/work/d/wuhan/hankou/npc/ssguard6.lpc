// hjiaren.c
inherit NPC;


void do_permit();
void create() {
  set_name("园丁", ({ "yuanding", "ssguard" }));
  set("gender", "男性");
  set("long", "他很不和善\n");
  set("age", 45);
  set("combat_exp", 800000);

  set("str", 25);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("staff", 300);
  set_skill("parry", 250);
  set_skill("force", 300);
  set("max_force", 3000);
  set("force", 6000);
  set("force_factor", 50);
  set_temp("apply/dammage", 130);
  set_temp("apply/defense", 130);
  set_temp("apply/attack", 130);
  setup();
  carry_object(__DIR__ "obj/token2");
  carry_object(__DIR__ "obj/chutou2")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object()))
    if (!ob->query("wuhankiller"))
      kill_ob(ob);

}
