inherit NEW_VENDOR;

string jieyao();
string dujin();

void create()
{
	set("title", "药铺掌柜");
	set_name("风拂柳", ({"feng"}));
	set("long", "他看起来有点心不在焉\n");
	set("combat_exp", 10000);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("force", 100);
	set("max_force", 500);
	set("force_factor", 10);

	set("chat_msg", "嗨！卖药罗！卖药罗！祖传秘方！祖传秘方！\n");
	set("chat_chance", 10);
	set("inquiry", ([
		"风大仙"  : "哼！不提这个败家子也罢\n",
		"毒经"    : (:dujin:),
		"铜牌" 	  : "这是我们帮中的信物，不能随便丢弃的\n"
			"我们提供买杀手的服务。你如果感兴趣，可以找\n"
			"王老二join我们，他若再问，你就低声告诉他杀手\n",
		"买杀手" : "我们的价钱是:\n"
			"      50两金子    :    10k 经验的杀手\n"
			"     100两金子    :    50k 经验的杀手\n"
			"     200两金子    :   100k 经验的杀手\n" 
			"     500两金子    :   300k 经验的杀手\n"	
			"    1000两金子    :   700k 经验的杀手\n"
			"    2000两金子    :  2000k 经验的杀手\n",
 
	]) );
	set("merchandise", ([
		__DIR__"obj/bujin" : 100,
		__DIR__"obj/bushen"     : 100,
		__DIR__"obj/buqi"  : 100,
	]) );
	setup();
	carry_object("/obj/cloth")->wear();
}


void init()
{
	::init();
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");
}

int accept_object(object who, object ob)
{
	object book, zhipian;
	int som;

	if( ob->query("long") == "一块锈迹斑斑的铜牌\n" ){
	command("say 啊！真是太好了！您这是救了我一命呐");
	if( who->query_temp("dujin") ){
		command("say 好!我就把祖传的毒经送给您");
		__DIR__"obj/dujin"->move(who);
	}
	return 1;
	}
	else {
		som = ob->value();
		som /= 10000;
		zhipian = new(__DIR__"obj/zhipian");

		switch(som){
		case   50 : zhipian->set("level", "1");break;
		case  100 : zhipian->set("level", "2");break;
		case  200 : zhipian->set("level", "3");break; 
		case  500 : zhipian->set("level", "4");break; 
		case 1000 : zhipian->set("level", "5");break; 
		case 2000 : zhipian->set("level", "6");break; 
		default : return 0;
		}
		if( objectp(zhipian) ){
			 zhipian->move( who);
			 command("say 你把要杀的人的名字写上(id),哈哈，接下来我就不告诉你了");
		}
		return 1;
	}
}

string dujin()
{
	if(this_player()->query_temp("fengfuliu")){
		this_player()->set_temp("dujin", 1);
		return "毒经？我是不会给你的！不过．．．\n"
"我遗失了很重要的一块铜．．．算了，不说也罢！\n";
	}
	else return "你问什么？我不知道\n";
}
