//andao.c
#include <room.h>
inherit ROOM;

create()
{
    set("short", "暗道");
    set("long", @LONG
一条长长的暗道. 黄家的地窖拦腰挖过来. 东北面的一段不长, 走一下
就在头顶处封死了.
LONG );
    set("exits", ([
       "north"      :  __DIR__"hdijiao",
       "southwest"  :  __DIR__"anshi",
]) );
    create_door("north", "木板", "south", DOOR_CLOSED);
    set("no_clean_up", 0);
    setup();
}
