// Room: /u/wuhan/hankou/ssyard.c

inherit ROOM;

void create()
{
	set("short", "院落");
	set("long", @LONG
院子四周可以看到很阔气的屋宇，但是院子里杂七杂八地种着好多
树，找一条路出去并不容易。院子当中有个小水池，水池里漂满了浮萍
，中间则有一个精美的假山。旁边有个亭子，几个人很悠闲地坐着。
如果你找不着路，就爬出去吧。
LONG
	);
	set("objects", ([
	__DIR__"npc/ssguard1"  : 2,
	__DIR__"npc/ssguard2"  : 2,
	__DIR__"npc/ssguard3"  : 2,
	__DIR__"npc/ssguard4"  : 2,
	__DIR__"npc/ssguard5"  : 2,
	]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_climb", "climb");
	add_action("do_enter", "enter");
}

int do_climb(string arg)
{
        if( arg != "wall" && arg != "院墙" )return 0;
        message_vision("$N试了试院墙的高度，纵身跃了过去\n", this_player());
        this_player()->move(__DIR__"ssstreet");
        message_vision("$N纵身跃了出来。\n", this_player());

        return 1;
}

int do_enter(string arg)
{
	object ob, where, me = this_player();
	if( arg != "假山" ) return 0;
	if( !me->query("wuhankiller") )
		if(present("ssguard", this_object()))
			return notify_fail("架没打完就跑?\n");
	message_vision("$N一闪身，忽然不见了\n", me);
	
	me->start_busy(2);
	me->move(__DIR__"sshall");
	message_vision("$N闪身进来\n", me);
	if( !me->query("wuhanrealkiller") ){
	where = find_object(__DIR__"sshall");
	if( ! ( ob = present("ssleader", where) ) ){
		ob = new( __DIR__"npc/ssleader");
		ob->move(where);
	}
	ob->kill_ob(me);
	}
	return 1;
}
