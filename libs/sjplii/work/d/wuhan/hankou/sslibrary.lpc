// Room: /u/wuhan/hankou/sslibrary.c

inherit ROOM;

void create()
{
	set("short", "书房");
	set("long", @LONG
这是一间安静的书房，窗外鲜花澜漫，幽香扑鼻。屋里除了一张太
师椅和一张小几，是一架一架的书。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"sshall",
]));
	set("item_desc", ([
	"书" : "那里面有些很难懂的，诸如：本草纲目，水经注\n",
	]) );
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_open", "open");
}

int do_open(string arg)
{
	if( arg == "本草纲目")
		return notify_fail("你翻翻本草，发现太难懂了\n");
	if( arg == "水经注" ){
		message_vision("$N将水经注打开，发现那里面竟然是空的！\n",
		this_player());
		if( !query("found")){
		tell_room(__FILE__,"里面掉出来个东西\n");
		set("found", 1);
		__DIR__"obj/drug"->move(this_object());
		}
		return 1;
	}
	return 0;
}
		
void reset()
{
	delete("found");
}
