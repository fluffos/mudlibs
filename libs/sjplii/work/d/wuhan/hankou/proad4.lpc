// proad4.c

inherit ROOM;

void create()
{
  set("short", "汉口主街");
  set("long", @LONG
这是汉口最大的一条街，街两旁住的都是汉口最有钱最有势的人家，
开的铺面都是汉口最叫得响的字号。
    西边是武汉府知府衙门, 大门八字大开, 门前气势汹汹地卧着两
座石狮子. 门柱上贴这一张告示, 一堆人正围着看热闹.
    东边是武汉著名的禅寺－－归元寺。
LONG );
  set("item_desc", ([
  "告示" :  @LONG
    本城近月来, 盗匪猖獗, 民怨甚深, 不抓不足以平民愤. 本府已
调动全城捕快, 擒得大小盗贼百余名. 百姓始得安居. 特此召告全城
流窜盗匪, 凡自首者从轻发落, 顽固不化者终将难逃法网. 
                                     武汉府 知府印
LONG
]) );
        set("exits", ([
        "north" :       __DIR__"proad5",
        "south" :       __DIR__"proad3",
        "west"  :       __DIR__"yamen",
	"east"  :      	__DIR__"gyenter",
])   );
        set("objects", 
        ([
              "/npc/nknpc" : 1,
        ]));
        setup();
}




