inherit ITEM;

void create()
{
	object ob;
    set_name("杜家隆的尸体", ({"corpse", "ducorpse"}));
    set("long", "八臂金刀杜家隆是封迟汀的至交老友\n"
	"一手犀牛刀法也曾威镇江湖\n"
	"然而，他已经死了，只剩下一具尸体静静地躺在这里。\n");
	set_max_encumbrance(10000);
    set("no_get", 1);
    setup();
	ob = new(__DIR__"xiniu" );
    ob->move(this_object());
}

int is_container() { return 1; }
