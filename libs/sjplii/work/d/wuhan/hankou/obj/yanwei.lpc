// yanwei.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("燕尾金镖", ({ "dart" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","造型古怪的飞镖, 金光闪闪, 却是纯金造的.\n");
		set("unit", "些");
		set("base_unit", "枝");
		set("base_weight", 50);
		set("base_value", 1000);
	}
	set_amount(5);
	init_throwing(50);
	setup();
}
