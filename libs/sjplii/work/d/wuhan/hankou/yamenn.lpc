// Room: /u/wuhan/hankou/yamenn.c
#include <room.h>
inherit ROOM;

string lookdesk(object me);

void create()
{
	set("short", "内室");
	set("long", @LONG
这里是知府大人的书房. 墙上挂着三副古画, 皆为上品. 书桌乃上等红
木所制, 文房四宝无不是极品. 桌上摞着厚厚一叠案卷, 看得出大人也还辛
苦. 窗台上摆着个青瓷花瓶, 插着几朵红花, 窗外是个梅园, 梅花开得正是
热闹, 其香醇厚, 好是惬意.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"yamenhall",
]));

        set("item_desc", ([
	"desk" : (: lookdesk :),
	"书桌" : (: lookdesk :),
]) );
        set("objects", ([
	__DIR__"npc/ypuren" : 1,
]) );
	setup();
}

void init()
{
        add_action("getyan", "get");
}

string lookdesk(object me)
{
        if(query("noyan")) return "一张上等红木的书桌(desk)\n";
	
	else return 
"一张上等红木的书桌(desk)\n"
"里面有:\n"
"        七星古砚     (7yan)\n";
}

int getyan(string arg)
{
    string from;
    object puren;
    
    if( sscanf(arg, "%s from %s", arg, from)==2 
    && arg == "7yan"
    && from == "desk"
    && !query("noyan")){
	message_vision("$N从书桌上拿出一方七星古砚。\n"
        "忽然一个声音响起来: 抓贼啊!\n" , this_player());
	set("noyan", 1);
	__DIR__"obj/7yan"->move(this_player());
	if( puren = present("puren", this_object()) )
	    puren->kill_ob(this_player());
	return 1;
    }
}
