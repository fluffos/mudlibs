// Room: /u/wuhan/shanzhai/downcliff.c

inherit ROOM;

void create() {
  set("short", "崖底");
  set("long", @LONG
这里绝无鸟兽人烟的迹象，地上是厚厚的松针。你发现一处向
内倾斜的崖壁上有个浅浅的洞穴，那里霍然有一具骷髅。
LONG
  );
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg != "up") return 0;

  message_vision("$N攀着藤蔓向山崖上爬去\n", this_player());
  tell_room(__DIR__ "path6", "有人从山下爬上来\n");
  this_player()->move(__DIR__ "path6");
  return 1;
}

void reset() {
  object sk, ob;
  ::reset();
  if (sk = present("corpse", this_object()))
    destruct(sk);
  sk = new("/obj/corpse");
  sk->move(this_object());
  ob = new("/d/wuhan/hankou/obj/yanwei");
  ob->set_amount(3);
  ob->move(sk);
  //	__DIR__"yinsword"->move(sk);
}
