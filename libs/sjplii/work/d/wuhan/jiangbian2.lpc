// jiangbian1.c

inherit ROOM;

void create()
{
        set("short", "江边");
        set("long", @LONG
你顺着江边来到这里, 江面在这儿愈发开阔奇险. 奇怪的是居然有几个人不怕死,
正往水里跳. 江里会有什么呢? 你不觉问自己. 江中一艘船在波浪中时起时伏, 你如果
眼力好的话可以看到船上飘着一面绣着海鲸的大旗.
LONG
        );
        set("exits", ([ /* sizeof() == 3 */
  "west" : __DIR__"jiangbian3",
  "east" : __DIR__"jiangbian1",
  "south": __DIR__"wsroad1.lpc",
]));
        set("objects", ([
	__DIR__"npc/dragon_guard" :1,
	  __DIR__"npc/dragon_leader":1
	]) );
        setup();

}


void init()
{
add_action("do_dive", ({"dive","tiao","tiaoshui"}) );
}

int do_dive()
{
        object ob;

        message_vision("$N扑通一声跳进江里..\n",this_player());
	if((int) this_player()->query_skill("diving", 1)<10){
	  tell_object(this_player(), @LONG

你还没在水里呆一会儿, 就憋不住了. 看来你得学学水下功夫.

LONG
         );
         this_player()->move(this_object());
         message_vision("$N非常狼狈的从水中爬上岸来.\n", this_player());
         return 1;
       }
       tell_room(__DIR__"shui1",
		this_player()->query("name")+"一个猛子扎下来!\n");
       this_player()->move(__DIR__"shui1");
       return 1;
}
