//  chito.c

inherit ROOM;

void create()
{
	set("short", "阿无的家");
	set("long", @LONG
这是阿无的家,北面有一张书桌,书桌上摆满了书，看得出主人是很爱读书的,
书桌前有把椅子，房间里还有张床，除此看不出有什么东西.
LONG);
	set("exits",([
	"out":	"/d/wuhan/dragon_residence"]) );
	set("owner", "river");
	set("refusemsg", 
"一个声音传来，主人不再家不要乱闯，你被一掌打了出去.");
	set("sleep_room", 1);
	setup();
}

void init()
{
	object ob;

	add_action("allowin", "allowin");
	add_action("privatehere", "privatehere");
	add_action("preventin", "preventin");
	add_action("savehere", "savehere");
}

int savehere(string arg)
{
	string meid = this_player()->query("id");

	if(meid != query("owner"))
		return notify_fail("你没有权利这样做！\n");
	if(arg)return notify_fail("Error: type only  savehere!\n");
	this_player()->set("startroom", __FILE__);
	write("当你下次连线进来时，会从这里开始。\n");
	return 1;
}

int allowin( string arg )
{
	string meid = this_player()->query("id");
	
	if(!wizardp(this_player()) && meid != query("owner"))
		return notify_fail("你没有权利这样做！\n");
	if(!arg) return notify_fail("让谁进?\n");
	set("right/" + arg, 1);
	message_vision("$N给" + arg + "以来串门的权利\n", this_player());
	return 1;
}

int preventin( string arg )
{
	string meid = this_player()->query("id");      
        
        if(!wizardp(this_player()) && meid != query("owner"))
                return notify_fail("你没有权利这样做！\n"); 
	if(!arg) return notify_fail("不让谁进?\n"); 
	delete("right/" + arg );
	message_vision("$N取消" + arg + "来串门的权利\n", this_player());
	return 1;
}

int privatehere( string arg )
{
	string meid = this_player()->query("id");      
               
        if(!wizardp(this_player()) && meid != query("owner"))  
                return notify_fail("你没有权利这样做！\n"); 
	delete("right");
	message_vision("$N取消了所有人来串门的权利\n", this_player());
	return 1;
}	
void reset()
{
}


