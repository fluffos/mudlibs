// wroad4.c

inherit ROOM;

void create()
{
        set("short", "青石马路");
        set("long", @LONG
这是一条青石大马路, 可以并排跑五匹高头大马。街道两侧的梧桐十步一株, 茂密的
阔叶遮起一路阴凉。由于武昌海鲸帮在长江水道上的兴起, 这一带到处都是江湖人物。
    南边是一家赌馆, 两个打手站在门边, 只听见里面苦的笑的叫的闹的什么都有。你若
是赌了个精光, 北边特地为你准备了当铺。你就是当老婆那儿也收。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
