// yinwuzhou.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "鹦鹉洲北");
	set("long", @LONG
这里已是鹦鹉洲的尽头. 一个老乌鸦蹲在一棵枯藤老树上"嗄嗄"
地叫, 不知道今天又有什么倒霉事.
LONG);
	set("item_desc", ([
	"老树"	:  "一棵老槐, 大概有一千多岁吧.\n",
]) );
	set("exits", ([
	"south"	: __DIR__"yinwuzhou2"
]) );
        set("no_clean_up",0);
	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	object ob;
	
	if(arg != "老树")return notify_fail("你爬什么?\n");
	add("climb_tigger", 1);
	message_vision("$N往树上爬, 弄得老树吱嘎吱嘎的响, 看看树要塌了,\n"
		      "$N只有悻悻地滑下来.\n", this_player() );
	if(query("climb_tigger") ==3){
		delete("climb_tigger");
		tell_object(this_player(),
		 HIY"只听的「轰隆」一声, 老树裂了一个窟窿, 你重重的摔下去"NOR
		);
		{
			this_player()->move(__DIR__"yinwusecret");
			this_player()->unconcious();
		}
	}
	return 1;
}

void reset()
{
	::reset();
	delete("climb_tigger");
}
