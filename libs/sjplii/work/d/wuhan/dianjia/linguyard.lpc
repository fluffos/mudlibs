// Room: /u/wuhan/dianjia/linguyard.c

inherit ROOM;

void create()
{
	set("short", "小院");
	set("long", @LONG
这是一方宁静的院落。左手边种三两海棠，右手植四五菜蔬。
一块空地上树着几根竹竿，晒着些陈年的旧衣服，几只空木箱摆在
一边。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"lingu",
  "north" : __DIR__"street2",
]));
	set("item_desc", ([
	"旧衣服" : "那是一些袄子，长袍，旧盔甲，和些女人的衣物\n",
	]) );
	set("no_clean_up", 0);

	setup();
	set("kui", 1);
}

void init()
{
	add_action("do_get", "get");
}

int do_get(string arg)
{
	
	if( arg!= "旧盔甲" )return 0;
	if( !query("kui") ) {
		tell_object(this_player(),"被人拿走了!\n");
		return 1;
	}
	else{
		message_vision("$N从旧衣物中拿了一件偷偷的藏在身上\n",
		this_player() );
		__DIR__"obj/oldarmor"->move(this_player() );
		set("kui", 0);
		return 1;
	}
}

void reset()
{
	::reset();
	set("kui", 1);
}
