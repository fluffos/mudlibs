// keren.c

inherit NPC;
void create()
{
        set_name("点龙印的客人", ({ "keren"}));
	set("gender", "男性" );
	set("long", "一个白净面皮, 双腿修长的年轻人\n");
        set("age", 32);
        set("str", 20);
        set("cor", 30);
        set("cps", 27);
        set("int", 30);
	set("attitude", "friendly");

	set("max_force", 1000);
        set("force", 1000);
        set("force_factor", 2);
        
	set("combat_exp", 100000);
	
	set_skill("unarmed", 60);
	set_skill("dodge", 60);
        set_skill("parry", 80);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 100);
        set_temp("apply/dodge", 200);


	setup();
	carry_object(__DIR__"obj/qingcloth")->wear();
}
