// lantiejian.c :

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("烂铁剑", ({ "lantiejian" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是把好象很普通的铁剑, 握在手上沉甸甸的\n");
		set("value", 400);
		set("material", "steel");
	}
	init_sword(35);

	set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");

	setup();
}
