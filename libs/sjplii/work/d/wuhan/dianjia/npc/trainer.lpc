// zhuanghu.c

inherit NPC;

string first_name = "点";

string *name_words = ({ "风", "莘", "雯", "央" });

string last_name = "姑";
void create() {
  string name;
  name = first_name + name_words[random(sizeof(name_words))] + last_name;
  set_name(name, ({ "dian" }));
  set("gender", "女性");
  set("title", "点家庄");
  set("age", 35);
  set("str", 25);
  set("cor", 30);
  set("cps", 27);
  set("int", 10);
  set("attitude", "friendly");

  set("max_kee", 1300);
  set("kee", 1300);

  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 3);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 200000);

  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("parry", 300);
  set_skill("sword", 250);
  set_skill("force", 200);

  set_temp("apply/attack", 60);
  set_temp("apply/defense", 60);
  set_temp("apply/damage", 15);

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/sword")->wield();
}

void reset() {
  set("water", 40000);
  set("food", 40000);
}
