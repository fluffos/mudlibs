// zhuangzhu.c
#include <ansi.h>
inherit NPC;
string jian();
void create() {
  set_name("狮面人", ({ "man" }));
  set("gender", "男性");
  set("long", "这是个雄狮般威武的中年人, 如今却躺在床上动弹不得\n");
  set("age", 54);
  set("str", 25);
  set("cor", 30);
  set("cps", 27);
  set("per", 26);
  set("int", 25);
  set("attitude", "friendly");

  set("max_force", 4000);
  set("force", 4000);
  set("eff_kee", 40);
  set("force_factor", 20);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 100000);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);

  set("inquiry", ([
    "name": "唉, 老夫便是封迟汀\n",
    "烂铁剑": (: jian :),
  ]));
  setup();
  carry_object("/obj/sword")->wield();
}


string jian() {
  this_player()->set_temp("lantiejian", 1);
  return "嗯....这我可不清楚，你最好问问别人吧。\n";
}

int accept_object(object who, object ob) {
  if (ob->query("name") != "犀牛望月") return 0;
  command("sigh");
  command("say 原来杜贤弟到底还是没有逃出来!");
  if (who->query_temp("lantiejian")) {
    command("sigh");
    command("say 看来这把剑命中就不该我得, 我不仅家破人亡还害得朋友为我所累\n"
      "罢罢罢, 我也再不相瞒, 这把剑就给你罢");
    __DIR__ "obj/lantiejian"->move(who);
    who->set_temp("lantiejian", 0);
  }

  return 1;
}
