// leiting.c

inherit NPC;
string kuijia();

void create() {
  set_name("于天尺", ({ "yu" }));
  set("gender", "男性");
  set("title", "点家庄");
  set("long", "于天尺是点灵姑的丈夫，这是一个高高大大威风凛凛的壮汉\n");
  set("age", 45);
  set("str", 35);
  set("cor", 30);
  set("cps", 27);
  set("per", 28);
  set("int", 27);
  set("attitude", "friendly");

  set("inquiry", ([
    "带兵": "以前的事不要再提了!\n",
    "旧盔甲": (: kuijia :),
  ]));
  set("max_force", 4000);
  set("force", 4000);
  set("force_factor", 3);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 1000000);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("blade", 100);
  set_temp("apply/attack", 120);

  setup();
  carry_object("/obj/cloth")->wear();
}

string kuijia() {
  object ob;
  if (ob = present("jiu kuijia", this_player())) {
    destruct(ob);
    message_vision("于天尺从$N身上收走旧盔甲\n", this_player());
    return "哦！这是我当年的军服！\n";
  } else
    return "不知道\n";
}

int accept_object(object who, object ob) {
  if (ob->query("name") != "兵符") return 0;
  call_out("killking", 1, who);
  return 1;
}

void killking(object who) {
  object where, king, guard;
  object ob, gu, lei;

  if (living(this_object())
    && environment() == environment(who)
    && living(who)) {
    command("say 好！既然古大人叫我，我万死也不辞！");
    command("say 我跟你去");
    tell_object("/d/wuhan/hankou/hsgr",
      "一行人匆匆走过来\n");
    where = find_object("d/wuhan/hankou/hsgr");
    if (!where) {
      write("errro: cann't find object!\n");
      return;
    }
    if (ob = present("jin xiansheng", where)) {
      if (ob->query("guqian2")) {
        command("hmm");
        command("say 于天尺突然道：此事有诈\n");
        return;
      } else destruct(ob);
    }
    ob = new("/d/wuhan/hankou/npc/guqian2");
    ob->move(where);
    this_object()->move(where);
    who->move(where);

    tell_object(where, "于天尺对金先生倒头就拜，说道：古大人\n");
    tell_object(where, "金先生连忙扶起他来，说道：你愿意和我去\n");
    tell_object(where, "杀那昏君吗？虽然危险却也不是不能！\n");
    command("nod");
    command("say 好！");

    tell_object(where, "于天尺从床头取出一把青光闪闪的宝刀\n"
      "出刀．．．收刀．．．\n"
      "你之觉空中青光一闪即逝，好象什么也没发生．．．\n"
      "正疑惑间，金先生说道：好！我们走！\n"
      "说罢，携起于天尺的手，翩然而去．．．\n"
      "风过后，八仙桌喀嚓一声，裂成九块，轰然倒地！\n"
    );

    tell_object(where, "\n"
      "猛然间你眼前又一花，金先生出现在你面前\n");

    if (who->query("combat_exp") > 100000) {
      ob->set("killer", who->query("id"));
      message_vision("于天尺对$N"
        "说道：你功夫也不错，你愿意跟我们去吗?\n", who);
    }

    else {
      tell_object(where, "于天尺说道：这本书送给你作个纪念吧！\n");
      __DIR__ "obj/parry_book"->move(who);
      tell_object("/d/wuhan/lou4",
        "两个人突然出现在你面前，叫道：昏君，你纳命来！\n");
      where = find_object("/d/wuhan/lou4");
      if (!(king = present("heng", where))) {
        king = new("/d/wuhan/npc/king");
        king->move(where);
      }
      if (!(guard = present("peng daneng", where))) {
        guard = new("/d/wuhan/npc/baobiao");
        guard->move(where);
      }
      gu = new("/d/wuhan/npc/guqian");
      gu->move(where);
      lei = new("/d/wuhan/npc/leiting");
      lei->move(where);
      guard->kill_ob(gu);
      guard->kill_ob(lei);
      king->kill_ob(gu);
      king->kill_ob(lei);
      gu->kill_ob(king);
      gu->kill_ob(guard);
      lei->kill_ob(king);
      lei->kill_ob(guard);
      destruct(this_object());
    }
  }
  return;
}
