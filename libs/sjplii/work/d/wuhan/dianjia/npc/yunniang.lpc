// fenggu.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("点芸娘", ({ "dian yunniang","dian", "yunniang"}));
	set("gender", "女性" );
	set("title", "点家庄");
	set("long", "一位很秀气的小姑娘, 她是点凤姑的女儿\n");
        set("age", 10);
        set("str", 25);
        set("cor", 30);
        set("cps", 27);
	set("per", 26);
        set("int", 25);
	set("attitude", "friendly");

	set("chat_chance", 5);
	set("chat_msg", ({"点芸娘咽咽唾沫道: 娘做的鱼汤真好吃\n"}));
	set("max_force", 300);
        set("force", 300);
        set("force_factor", 2);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 7000);
	
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
        set_skill("parry", 20);
	set_skill("sword", 100);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 10);

	setup();
}
