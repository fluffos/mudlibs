// woodcutter.c

inherit NPC;
string wenlu();
void movemove();
void create()
{
	set_name("樵夫", ({ "woodcutter" }) );
	set("gender", "男性" );
	set("age", 47);
	set("int", 26);
	set("long",
		"一个乐垫垫的樵夫, 正唱着山歌\n");
	set("inquiry", ([
	    "点家庄" : (:wenlu:),
	]) );
	set("chat_chance", 10);
        set("chat_msg", ({
	    (: movemove :),
	    "樵夫快乐的唱着山歌\n",
	    "樵夫自言自语道：这一庄人个个手上都有两下子，真是了不起！\n",
		}) );
	set("attitude", "peaceful");
	set_skill("literate", 11);
	setup();
	carry_object(__DIR__"obj/axe")->wield();
}

string wenlu()
{
    if(environment()->query("short") != "山林"
       || !living(this_object()))return "只在此山中云深不知处\n"; 
    call_out("qudianjia", 1, this_player());
    return "你问我算是问对人了\n";
}

void qudianjia(object ob)
{
    remove_call_out("qudianjia");
    if(!ob || ob->is_fighting() 
       || environment(ob) != environment() )return;
    tell_object(ob, 
		"樵夫带着你在林子里七转八绕, 通过一个山谷后, 你眼前突然一亮\n");
    ob->move("/d/wuhan/dianjia/daotian");
}

void movemove()
{
    if(!living(this_object()))return;
    if(environment()->query("short") == "山林")command("go north");
    else if(environment()->query("short") == "山路")command("go south");
    else command("say 我竟然迷路了!");
    return;
}
