// longfan.c

inherit NPC;
void create() {
  set_name("点龙帆", ({ "dian" }));
  set("gender", "男性");
  set("title", "点家庄");
  set("long", "他一脸长髯。正在椅子上养神。\n");
  set("age", 50);
  set("str", 35);
  set("cor", 30);
  set("cps", 27);
  set("per", 30);
  set("int", 10);
  set("attitude", "peaceful");

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);

  set("combat_exp", 200000);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 80);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);

  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  carry_object("/obj/cloth")->wear();
}
