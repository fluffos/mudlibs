// linggu.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("点灵姑", ({ "dian lingu","dian", "lingu"}));
	set("gender", "女性" );
	set("title", "点家庄");
	set("long", "她一副小鸟依人的样子\n");
        set("age", 45);
        set("str", 25);
        set("cor", 30);
        set("cps", 27);
	set("per", 24);
        set("int", 25);
	set("attitude", "friendly");

	set("max_force", 4000);
        set("force", 4000);
        set("force_factor", 2);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 500000);
	
	set("chat_chance", 5);
	set("chat_msg", ({
	    "点灵姑娇嘀嘀地说：你也是带过兵的, 怎么对我却这么听话？\n"
		"于天尺傻呵呵地笑\n", })
);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
        set_skill("parry", 100);
	set_skill("sword", 100);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);

	setup();
}
