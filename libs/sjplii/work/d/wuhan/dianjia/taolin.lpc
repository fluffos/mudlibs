// Room: /u/wuhan/dianjia/taolin.c

inherit ROOM;

void create()
{
	set("short", "桃林");
	set("long", @LONG
万树桃花开得正艳，微风拂来，落英缤纷，地上芳草如茵，花瓣
粉艳如歌。好一处人间仙境。
    西边隐约可见一处祠堂。
LONG
	);
        set("item_desc", ([
	"桃花" : "多美的桃花啊！令人不觉想摘几朵带在身上。\n"
]) );
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"street5",
  "east" : __DIR__"street4",
]));
	setup();
}

void init()
{
        add_action("do_pick", "pick");
}

int do_pick(string arg)
{
    if(arg != "桃花")return notify_fail("你要摘什么？\n");
    if(query("noflower"))return notify_fail("不要把好花都摘完了吧！\n");
    __DIR__"obj/taohua"->move(this_player());
    message_vision("$N轻手轻脚地从树上折下一枝桃花\n", this_player());
    delete("noflower");
    return 1;
}
