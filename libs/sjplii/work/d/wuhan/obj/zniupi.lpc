// zniupi.c

inherit ITEM;

void create()
{
	set_name("破牛皮", ({ "niupi" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long",
		"这是一张古旧的牛皮, 上面杂乱地写着些文字, 却看不大清楚\n"
		"眉批上倒有些是辩得出的, 看得出的是\n"
		" ...此情甚...红颜...幸甚...\n");
		set("material", "paper");
		set("skill", ([
			"name": 		"unarmed",
			"exp_required":	100,
			"sen_cost":		35,		
			"difficulty":	35,			
			"max_skill":	21,		
	        ]) );
	}
}


