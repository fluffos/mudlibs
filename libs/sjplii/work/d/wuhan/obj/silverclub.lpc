// silverclub.c

inherit ITEM;

void create()
{
	set_name("银棍", ({ "silver club","club" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根两尺长的银质短棍，上面有一圈圈的纹路.\n");
                set("value", 100);
        }
        setup();
}
