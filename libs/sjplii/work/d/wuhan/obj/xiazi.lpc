inherit ITEM;

void create() {
  object ob;
  set_name("小匣子", ({ "xiazi" }));
  set("long", "匣子虽小却放了一百两金子\n");
  set_max_encumbrance(10000);
  set("no_get", 1);
  setup();
  /*	ob = new("/obj/money/gold");
        ob->set_amount(100);
        ob->move(this_object());*/
}

int is_container() { return 1; }
void init() {
  object ob;
  ob = new("/obj/money/gold");
  ob->set_amount(100);
  ob->move(this_object());
}
