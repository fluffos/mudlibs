// sanzi_b.c

inherit ITEM;

void create()
{
	set_name("无名纸卷", ({ "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
		"一本无名纸卷, 上面写着些小字, 画了些小人, 因为浸在水中时间太长\n"
		"已经有些模糊.\n");
		set("material", "paper");
		set("skill", ([
			"name": 		"unarmed",
			"exp_required":	100,
			"sen_cost":		30,		
			"difficulty":	30,			
			"max_skill":	41,		
	        ]) );
	}
}


