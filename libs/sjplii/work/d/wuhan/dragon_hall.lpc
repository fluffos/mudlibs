// dragon_hall.c
inherit ROOM;
//#include "/d/wuhan/npc/quest.h"
//void doquest(object me);

void create()
{
	set("short", "海鲸帮大厅");
	set("long", @LONG
这是海鲸帮会客的大堂. 地上铺着整整齐齐的青砖, 中间又铺了一层
红地毯, 两旁各放了一排红木长背靠椅. 四根两人合抱的盘龙柱撑住四角
, 头顶数丈处大梁被雕成飞龙, 据说点睛则舞. 正北面一张蟒皮大椅面北
朝南坐的正是长江两岸第一条好汉--余志枭。
LONG );
	set("exits", ([
		"west"	: __DIR__"dragon_neitang",
	        "east"  : __DIR__"dragon_xingtang",
	      	"south" : __DIR__"dragon_yard",
]) );
	set("objects" , ([
		__DIR__"npc/master"	: 1,
]) );
	setup();
	replace_program(ROOM);
}
