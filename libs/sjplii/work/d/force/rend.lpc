// rend.c  by baiwt@sjpl 1999,5,28
#include <ansi.h>

inherit SSERVER;

int exert(object me, object ob) {
  object *inv;
  int i;
  string arg;
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够！\n");
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("armor_type") == "cloth") {
      if (inv[i]->query("equipped"))
        ob = inv[i];
    }
    continue;
  }
  if (!ob || !ob->query("equipped")) return notify_fail("你暗地里运了一下内力。\n");
  if (userp(ob))
    return notify_fail("你运起内力，全身骨骼“咯咯”一阵爆响。\n");
  if (me->query("id") != ob->query("owner")) {
    message_vision(HIW "\n$N运起内力，只听见一阵裂帛之声，$N身上的$n片片碎裂，眨眼间变成了飞灰！\n\n" NOR, me, ob);
    destruct(ob);
    me->add("force", -50);
    me->start_busy(1);
    return 1;
  }
  seteuid(ROOT_UID);
  rm(base_name(ob) + ".lpc");
  ob->move(environment(me));
  me->add("created_item", -1);
  seteuid(getuid());
  message_vision(HIW "\n$N运起内力，只听见一阵裂帛之声，$N身上的$n片片碎裂，眨眼间变成了飞灰！\n\n" NOR, me, ob);
  destruct(ob);
  me->add("force", -50);
  me->start_busy(1);
  return 1;
}
