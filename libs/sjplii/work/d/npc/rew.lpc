#include <ansi.h>

inherit NPC;

void create() {
  set_name("藏马", ({ "rew" }));
  set("nickname", HIR "中原一点红" NOR);
  set("gender", "男性");
  set("age", 20);
  set("long",
    "他就是大侠藏马。\n");

  setup();

  {
    object carried_ob = carry_object("/d/city2/obj/jinduan");
    if (carried_ob) carried_ob->wear();
  }
}
