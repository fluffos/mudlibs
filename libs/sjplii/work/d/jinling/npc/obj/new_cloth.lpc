// cloth.c

#include <armor.h>

inherit CLOTH;
inherit F_AUTOLOAD;

string query_autoload() 
{
	return query("name") + " " + query("long"); 
}
void autoload(string arg)
{
	string name,long;
    sscanf(arg, "%s %s", name, long);
    set("name",name);
    set("long",long);
}

void create()
{
	set_name("布衣", ({ "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long","一件精心缝制的布衣。\n");
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
