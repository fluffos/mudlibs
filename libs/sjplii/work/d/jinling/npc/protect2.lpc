#include <ansi.h>

inherit NPC;
int about_he();
string summon_more(object me);

void create()
{
	set_name("裘逸", ({ "qiu yi","qiu" }));
	set("long",
	    "这是一个四十五六岁的中年人, 浓眉大眼,\n"+
	    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n"+
	    "他神色凛然.\n");
	set("title", HIR"南北双鹰"NOR);
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIC "飞鹰" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 60);
        set("int", 30);
        set("cor", 50);
        set("cps", 30);
        set("spi", 30);
	set("kee", 5000);
	set("max_kee", 5000);
	set("sen", 5000);
	set("max_sen", 5000);

        set("force", 5000);
        set("max_force", 5000);
        set("force_factor", 50);

        set("atman", 2000);
        set("max_atman", 2000);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 50);

        set("inquiry", ([
                "悔过" : (: about_he :),
        ]));

        set("combat_exp", 3000000);
        set("score", 20000);

        set_skill("literate", 200);
        set_skill("force", 200);
        set_skill("unarmed", 200);
        set_skill("dagger", 200);
        set_skill("parry", 200);
        set_skill("dodge", 300);
        set_skill("move", 300);
        set_skill("xuanyinforce", 200);
	set_skill("zhichi-dagger",200);
        set_skill("xuanyinforce", 200);
        set_skill("fengxue-steps", 200);

        map_skill("force", "xuanyinforce");
        map_skill("parry", "zhichi-dagger");
        map_skill("dagger", "zhichi-dagger");
        map_skill("unarmed", "piaoxue-strike");
        map_skill("dodge", "fengxue-steps");
        set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :),
        }) );
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
	}) );

	setup();
        carry_object("/obj/cloth")->wear();
	carry_object("/obj/weapon/m_weapon/dagger")->wield();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 0, ob);
        }
}
void greeting(object ob)
{
	object me = this_object();
	if( me->query("vendetta_mark") )
       me->delete("vendetta_mark");
       me->set("vendetta/authority", 0);
	if ( ob->query("try_kill_newbie") > 10 )
	{
	if ( ob->query("try_kill_newbie") <= ob->query("auto_old_pks") )  return;
         command("say 你在江湖上作恶多端，为天下人所不容。拿命来吧！\n");
	if ( ob->query("combat_exp") > me->query("combat_exp") )
	me->set("combat_exp", ob->query("combat_exp") *3/2 );
	me->set_leader(ob);
	me->kill_ob(ob);
	}
	return;        
}
string summon_more(object me)
{
	string msg;
	if ( me->query("kee") != me->query("max_kee") )
	{
	msg = HIW"\n$N运起九死还生功，内劲鼓动之下，刹那间所有伤痛都恢复了！\n\n" NOR;
	message_vision(msg, me);
	me->set("max_kee", (int)me->query("max_kee"));
	me->set("eff_kee", (int)me->query("max_kee"));
	me->set("kee", (int)me->query("max_kee"));
	me->set("bellicosity", 0);
	}
	return "1";
}

int about_he()
{
	object me = this_player();
	if( me->query("deposit") > 5000000 )
	{
      command("say 念你有悔过之心，暂且饶你一命。没收你的所有财产，今后好自为之！\n");
	me->set("deposit", 0 );
	me->set("auto_old_pks", (int)me->query("try_kill_newbie") );
	me->remove_all_killer();
	return 1;
	}
	else
      command("say 你丝毫没有诚心悔过之意，哪能饶你！\n");
	return 1;
}
