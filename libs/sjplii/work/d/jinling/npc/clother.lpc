// golder.c

inherit NEW_VENDOR;
int do_make(string arg);

void create()
{
	set_name("孙大娘", ({"clother","sen"}));
	set("title","裁缝店老板娘");
	set_skill("unarmed", 10);
	set_skill("parry", 10);
	set_skill("dodge", 10);
	set("gender","女性");

	set("force",100);
	set("max_force",100);
	set("str",70);
	set("food",200);
	set("water",200);
	set("combat_exp",1000);

	set("age", 37);
	set("long", @LONG
孙大娘是最近才来到金陵的，她看起来四十岁左右，身材已
经不是很好，但是丰韵由存，她年轻是时候一定是个美人。
LONG
);

	set("merchandise", ([
		__DIR__"obj/color_cloth"	: 20,
//                __DIR__"obj/color_pants"        : 20,
//                 __DIR__"obj/silk_bra"   : 20,
		__DIR__"obj/silk-cloth"	: 20,
		__DIR__"obj/pink_cloth"	: 20,
		__DIR__"obj/linen"		: 20,
		__DIR__"obj/flower-shoes"	: 20,
		__DIR__"obj/shoes"		: 20,
		__DIR__"obj/color_head"	: 20,
		__DIR__"obj/headband" 	: 20,

	]));

	setup();

	carry_object(__DIR__"obj/color_cloth")->wear();
	carry_object(__DIR__"obj/jiandao")->wield();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
	add_action("do_buy", "buy");
	add_action("do_make", "make");
}

int do_make(string arg)
{
	 string type,name,long;
	 object obj;
	 if(!arg || sscanf(arg, "%s %s %s", type, name, long)!=3) {
		printf("你要做什么衣服？\n");
		return 1;
	 }
     if(type=="cloth") {
	    obj=new(__DIR__"obj/new_cloth");
		if(objectp(obj)) {
	    obj->set_name(name, ({ "cloth" }) );
		obj->set("long",long+"\n");
		obj->move(this_player());
		printf("你向孙大娘订做了一件%s。\n",name);
		}
	 }
     else if(type=="shoes") {
	    obj=new(__DIR__"obj/new_shoes"); 
		if(objectp(obj)) {
	    obj->set_name(name, ({ "shoes" }) );
		obj->set("long",long+"\n");
		obj->move(this_player());
		printf("你向孙大娘订做了一双%s。\n",name);
		}
	 }
	 else {
	    printf("衣服类型是: cloth, shoes \n");
	 }
     return 1;

}
