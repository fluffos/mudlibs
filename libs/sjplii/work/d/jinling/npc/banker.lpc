// banker.c

#include <ansi.h>

inherit NPC;
inherit F_BANKOWNER;

string ask_me(object who);

void create() {
  set_name("穆守财", ({ "banker" }));
  set("title", "钱庄老板");
  set("gender", "男性");
  set("age", 41);

  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 26);
  set("per", 23);
  set("con", 24);
  set("spi", 30);
  set("kar", 25);

  set("long",

    "李守财是这里的老板，由于他经营钱庄有道，所以这里的生意一天比\n"
    "一天好。听说他还会一点武功。\n");

  set("combat_exp", 30000);
  set("attitude", "friendly");
  //        set("pursuer", 1);
  set("env/wimpy", 30);

  set("max_atman", 2000); set("atman", 2000);
  set("atman_factor", 30);
  set("max_force", 2000); set("force", 2000);
  set("force_factor", 30);
  set("max_mana", 2000); set("mana", 2000);
  set("mana_factor", 30);

  set("chat_chance", 8);
  //        set("chat_msg", ({
  //                (: random_move :),
  //                (: exert_function, "powerfade" :),
  //        }) );

  set("chat_chance_combat", 4);
  set("chat_msg_combat", ({
    CYN
    "李守财笑呵呵的对你说：您到小店是取钱，还是存钱？\n" NOR,
  }));

  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);

  setup();

  carry_object(__DIR__ "obj/longsword")->wield();
  carry_object(__DIR__ "obj/silk-cloth")->wear();

  add_money("gold", 15);
}

int accept_fight(object me) {
  command("say 咦... 要打就真打吧，光是较量多没意思？");
  command("grin");
  kill_ob(me);
  return 1;
}
void init() {
  ::init();
  add_action("do_convert", "convert");
  add_action("do_deposit", "deposit");
  add_action("do_balance", "balance");
  add_action("do_withdraw", "withdraw");
}
