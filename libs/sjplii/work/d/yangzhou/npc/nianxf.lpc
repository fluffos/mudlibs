#include <ansi.h>

inherit NPC;

void create()
{
        set_name("年雪丰", ({ "nian xuefeng","nian" }) );
        set("age", 20);
        set("long",
                "大内“神驹四捕”之四\n");

        set("attitude", "heroism");
	set("vendetta_mark", "authority");
        set("pursuer", 1);
	create_family("朝廷",7,"官员");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", random(50)*10000);

        set_skill("blade", 50+random(40));
        set_skill("unarmed", 40+random(40));
	set_skill("xingyi-ken",100);
        set_skill("spring-blade", 100);
        set_skill("parry", 40+random(40));
        set_skill("dodge", 40+random(40));
        set_skill("move", 50+random(40));
	map_skill("blade","spring-blade");
	map_skill("unarmed","xingyi-ken");
	map_skill("parry","spring-blade");

        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/damage", 10+random(20));
        set_temp("apply/armor", 30);
        set_temp("apply/move", 30);
        set("chat_chance", 3);
        set("chat_msg", ({
"年雪丰叹了口气，说道：白大哥不在，我会保护好师父的。\n"
        }) );

        setup();

        carry_object(__DIR__"obj/blade")->wield();
        carry_object(__DIR__"obj/yafu")->wear();
}

