#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("金作马", ({ "jin zuoma","jin" }) );
        set("age", 28);
        set("long",
                "大内“神驹四捕”之二\n");

        set("attitude", "heroism");
	set("student_title","官员");
	create_family("朝廷",7,"官员");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 500000);
        set("score", 200000);

        set_skill("literate", 50);
        set_skill("force", 50+random(70));
	set_skill("bixueforce",100);
	map_skill("force","bixueforce");

      set_skill("unarmed", 50+random(70));
	set_skill("xingyi-ken",100);
        set_skill("parry", 70+random(100));
        set_skill("blade", 70+random(100));
        set_skill("duanmen_blade", 80);
	set_skill("chaos-steps",100);
        set_skill("dodge", 70+random(100));
        set_skill("move", 100+random(100));
	map_skill("unarmed","xingyi-ken");
	map_skill("blade","duanmen_blade");
	map_skill("dodge","chaos-steps");
	map_skill("parry","duanmen_blade");

        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/damage", 10+random(20));
        set_temp("apply/armor", 30);
        set_temp("apply/move", 30);
        set("chat_chance", 5);
        set("chat_msg", ({
//                (: random_move :),
"金作马若有所思地说道：白大哥走了，这里的案子怎么办？\n"
       }) );

        setup();

        carry_object("/obj/blade")->wield();
        carry_object(__DIR__"obj/yafu")->wear();
}
