#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("衙门差服", ({ "chai cloth","cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "这是长安衙门的当差衣服。\n");
		set("value", 1000);
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
