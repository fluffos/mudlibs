inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("扬州豆腐", ({ "doufu" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碟香喷喷的扬州豆腐，很有名的啊！\n");
		set("unit", "碟");
		set("value", 100);
		set("food_remaining", 4);
		set("food_supply", 40);
	}
	setup();
}

