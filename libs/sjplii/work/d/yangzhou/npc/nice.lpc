
inherit NPC;

void create()
{
	set_name("美", ({ "nice" }) );
	set("gender", "女性" );
	set("title","村姑");
	set("age", 18);
	set("str", 16);
	set("per", 30);
	set("long", @LONG
美是附近村庄的村姑，稍有几分姿色，身材虽然不算很好，但也十分丰满。
LONG
);
	set("combat_exp", 10000);
	set("attitude", "friendly");
	set_skill("literate", 100);
	set_skill("unarmed", 50);
	set("food",400);
	set("water",400);

	setup();
	
	carry_object("/obj/cloth/silk_bra")->wear();
	carry_object("/obj/cloth/pink_cloth")->wear();
	carry_object("/obj/cloth/color_pants")->wear();
}

