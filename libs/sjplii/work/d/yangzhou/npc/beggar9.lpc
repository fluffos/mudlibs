// beggar.c

inherit NPC;

void create()
{
        set_name("老乞丐", ({ "beggar" }) );
        set("gender", "男性" );
        set("age", 68);
        set("long", "一个满脸泥污的老乞丐，身上背着九个布袋。\n");
        set("combat_exp", 800000);
        set("str", 27);
        set("force", 3100);
        set("max_force", 3100);
        set("force_factor", 80);
	    set_skill("dodge",450);
	    set_skill("force",450);
	    set_skill("unarmed",220);
	    set_skill("hl18-strike",120);
        map_skill("unarmed", "hl18-strike");
        setup();
        carry_object("/obj/beg_cloth")->wear();
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
        carry_object("/obj/bag");
}

int accept_fight(object me)
{
        command("say " + RANK_D->query_respect(me) + 
"想玩两手？老头子我奉陪就是。\n");
        set("force_factor", 10);
        return 1;
}
 
