#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name("小倩", ({ "qian","boss" }) );
	set("gender", "女性" );
	set("age", 25);
	set("nickname",MAG  "江南一支花" NOR);
	set("long",
		"这位女老板织布的手艺号称天下无双。\n");
	set("combat_exp", 90000);
	set("attitude", "friendly");
	set("per",30);
	set_skill("unarmed",250);
	set("force",10000);
	set("max_force",10000);
	set("force_factor",50);
	set_skill("dodge",50);
        set("vendor_goods", ([
               "/d/city/obj/cloth/huazheboots":20,
		  "/d/city/obj/cloth/wulingjin":20,
               "/d/city/obj/cloth/bullboots":20, 
               "/d/city/obj/cloth/choupao":20, 
        ]) );

	setup();
	carry_object("/obj/cloth/clothw")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
        add_action("do_vendor_list", "list");

}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
message_vision("$N向$n说道：来挑一匹布吧。\n",this_object(),ob);
			break;
		case 1:
message_vision("$N对$n轻笑一声：是为你心上人买布的吧？\n",this_object(),ob);
			break;
		case 2:
message_vision("$N望了$n一眼，说道：你身上的衣服太糟糕了，做新的吧。\n",this_object(),ob);
			break;
	}
}
