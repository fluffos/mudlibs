#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("于永利", ({ "yu yongli", "yu", "tiejiang"}) );
        set("gender", "男性" );
	set("nickname",HIB"气吞山河"NOR);
        set("age", 42);
        set("long",
                "于永利四十多岁，长得虎背熊腰。。\n");
        set("combat_exp", 600000);
        set("attitude", "peaceful");
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 50);
        set("score", 90000);

	set_skill("hammer",300);
	set_skill("pyrobat-steps",150);
	set_skill("dodge",150);
	set_skill("parry",150);
	set_skill("unarmed",150);
	set_skill("force",150);
	set_skill("lotusforce",150);
	set_skill("wuxing-quan",150);
	map_skill("dodge","pyrobat-steps");
	map_skill("unarmed","wuxing-quan");
	map_skill("force", "lotusforce");

        set("vendor_goods", ([
                "/d/city/obj/weapon/dagger/dagger.lpc":20,
                "/d/city/obj/weapon/axe/tiefu.lpc":20,
                "/d/city/obj/weapon/hammer/hammer":20,
		  "/d/city/obj/weapon/fork/fork":20,
	         "/d/city/obj/weapon/stick/bintiegun":20,
		  "/d/city/obj/weapon/whip/tielian":20,
        ]) );
        setup();

        carry_object("/d/city/obj/cloth/linen")->wear();
        carry_object("/d/city/obj/weapon/hammer/hammer")->wield();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( name()+"说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来随便看看吧。\n");
                        break;
                case 1:
                        say(name()+ "用脖子上的毛巾抹了抹手，说道：这位" +
RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say(name()+ "说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来挑一件称手的兵器吧。\n");
                        break;
        }
}

