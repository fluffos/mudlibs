// file.c

void cat(string file)
{
	write(read_file(file));
}

// forward declaration -- this driver doesn't resolve forward references
// within a file without one (log_file() below calls it before its own
// definition later in this file).
void assure_file(string file);

void log_file(string file, string text)
{
	// AGENTS.md §7.11: this archive never shipped most of /log/'s
	// subdirectories (static/, nosave/, cmwhod/, ...); guard every
	// log_file() call site here once rather than at each caller.
	assure_file(LOG_DIR + file);
	write_file(LOG_DIR + file, text);
}

void assure_file(string file)
{
	string path, *dir;
	int i;

	if( file_size(file)!=-1 ) return;

	seteuid(ROOT_UID);
	dir = explode(file, "/");
	dir = dir[0..sizeof(dir)-2];
	path = "/";
	for(i=0; i<sizeof(dir); i++) {
		path += dir[i];
		mkdir(path);
		path += "/";
	}
}

string base_name(object ob)
{
	string file;

	if( sscanf(file_name(ob), "%s#%*d", file)==2 )
		return file;
	else
		return file_name(ob);
}
