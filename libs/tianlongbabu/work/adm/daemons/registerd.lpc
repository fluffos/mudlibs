// registed.c
//
// 05-10-97 by Windf

#define REGISTER DATA_DIR + "site/register"

inherit F_SAVE;

mapping reg = ([]);

void add_register(string key, string chinz);
void remove_register(string key);
string check_valid_email(string email);
string check_valid_input(string input);

void create()
{
	seteuid(getuid());
	restore();
}

void remove() { save(); }

string query_save_file() { return REGISTER; }

void remove_register(string who)
{
	map_delete(reg, who);
	save();
}

void add_register(string who, string email)
{
	reg[who] = email;
	save();
}

string check_valid_email(string email)
{
	int i;
	string *who;

	who = keys(reg);
	for(i=0;i<sizeof(who);i++)
		if(reg[who[i]] == email)
			return "InUse";

	return "SUCC";
}

string check_valid_input(string input)
{
	int i;
	string tmp1, tmp2;
	string *no_login;

	if(!input) return "MissingAddr";

	if(sscanf(input , "%s@%s", tmp1, tmp2) != 2)
		return "InvalidAddr";

	if(tmp1 == "" || tmp2 == "")
		return "InvalidAddr";

	no_login = ({"hotmail.com", "usa.net"});
	for(i=0;i<sizeof(no_login);i++)
		if(no_login[i] == tmp2)
			return "NotAllow";

	return "SUCC";
}
