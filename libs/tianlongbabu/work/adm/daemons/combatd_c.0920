void create()
{
        seteuid(getuid());
        set("name", "战斗精灵");
        set("id", "combatd");
}

string damage_msg(int damage, string type)
{
        string str;

//      return "造成 " + damage + " 点" + type + "。\n";
        if(damage == 0) return "结果没有造成任何伤害。\n";

        switch(type) { 
        case "割伤":
                if(damage < 10) 
			return "结果只是轻轻地划破$p的皮肉。\n";
                else if(damage < 20) 
			return  "结果在$p$l划出一道细长的血痕。\n";
                else if(damage < 40) 
			return  "结果「嗤」地一声划出一道伤口！\n";
                else if(damage < 80) 
			return "结果「嗤」地一声划出一道血淋淋的伤口！\n";
                else if(damage < 160) 
			return "结果「嗤」地一声划出一道深长的伤口，溅得$N"
				+ "满脸鲜血！\n";
                else 
			return "结果只听见$n一声惨嚎，$w已在$p$l"
				+ "划出一道深及见骨的可怕伤口！\n";
                break;

        case "刺伤":
                if(damage < 10) 
			return "结果只是轻轻地刺破$p的皮肉。\n";
                else if(damage < 20) 
			return "结果在$p$l刺出一个创口。\n";
                else if(damage < 40) 
			return "结果「噗」地一声刺入了$n的$l寸许！\n"; 
                else if(damage < 80) 
			return "结果「噗」地一声刺进$n的$l，使$p"
				+"不由自主地退了几步！\n";
                else if(damage < 160) 
			return  "结果「噗嗤」地一声，$w已在$p$l"
				+ "刺出一个血肉模糊的血窟窿！\n";
                else 
			return  "结果只听见$n一声惨嚎，$w已在$p的$l"
				+ "对穿而出，鲜血溅得满地！\n";
                break;

        case "剪伤":
                if(damage < 10)
                        return "结果只是轻轻地划破$n的皮肉。\n";
                else if(damage < 30)
                        return "结果在$n$l剪出一个创口。\n";
                else if(damage < 60)
                        return "结果「噗」地一声在$n的$l剪下一小块肉来！\n";
                else if(damage < 120)
                        return "结果「噗」地一声在$n的$l剪下一大块肉来！\n";
                else if(damage < 240)
                        return  "结果「噗嗤」地一声，$w已将$n$l"
                                + "剪得稀烂！\n";
                else
                        return  "结果只听见$n一声惨嚎，$w已将$n的$l"
                                + "剪为二截，鲜血溅得满地！\n";
                break;

	case "点穴":
		if( damage < 10 )
			return "结果$n只觉得$l上有一点酸痛。\n";
		else if(damage < 30)
			return "结果$n只觉得$l上一阵发麻．．．\n";
		else if(damage < 70)
			return "结果$n只觉得全身发麻，疼酸难当．．．\n";
		else if(damage < 150)
			return "结果$n只觉得$l上剧痛入骨．．．\n";
		else if(damage < 240 )
			return "结果$n只觉得$l上宛如万针攒刺一般．．．\n";
		else 
			return "结果$n全身一阵抽搐，如入万劫不复的地狱．．．\n";
		break;

        case "瘀伤":
                if(damage < 10) 
			return  "结果只是轻轻地碰到，比拍苍蝇稍微重了点。\n";
                else if(damage < 20) 
			return "结果在$p的$l造成一处瘀青。\n";
                else if(damage < 40) 
			return  "结果一击命中，$n的$l登时肿了一块老高！\n";
                else if(damage < 80) 
			return  "结果一击命中，$n闷哼了一声显然吃了不小的亏！\n";
                else if(damage < 120) 
			return  "结果「砰」地一声，$n退了两步！\n";
                else if(damage < 160) 
			return  "结果这一下「砰」地一声打得$n"
				+ "连退了好几步，差一点摔倒！\n";
                else if(damage < 240) 
			return "结果重重地击中，$n「哇」地一声吐出一口鲜血！\n";
                else 
			return "结果只听见「砰」地一声巨响，$n"
				+ "像一捆稻草般飞了出去！\n"; 
                break;

        case "抓伤":
                if(damage < 10) 
			return "结果只是轻轻地抓到，比抓痒稍微重了点。\n";
                else if(damage < 20) 
			return  "结果在$p的$l抓出几条血痕。\n";
                else if(damage < 40) 
			return "结果一抓命中，$n的$l被抓得鲜血飞溅！\n";
                else if(damage < 80) 
			return "结果「嗤」地一声，$l被抓得深可见骨！\n";
                else if(damage < 120) 
			return "结果一抓命中，$n的$l被抓得血肉横飞！\n";
                else if(damage < 160) 
			return "结果这一下「嗤」地一声抓得$n"
				+ "连晃好几下，差一点摔倒！\n";
                else if(damage < 240) 
			return "结果$n哀号一声，$l被抓得筋断骨折！\n";
                else 
			return "结果只听见$n一声惨嚎，$l"
				+ "被抓出五个血窟窿！鲜血溅得满地！\n";
                break;

        default:
                if(!type) type = "伤害";
                if(damage < 10) str =  "结果只是勉强造成一处轻微";
                else if(damage < 20) str = "结果造成轻微的";
                else if(damage < 30) str = "结果造成一处";
                else if(damage < 50) str = "结果造成一处严重";
                else if(damage < 80) str = "结果造成颇为严重的";
                else if(damage < 120) str = "结果造成相当严重的";
                else if(damage < 170) str = "结果造成十分严重的";
                else if(damage < 230) str = "结果造成极其严重的";
                else str =  "结果造成非常可怕的严重";
                return str + type + "！\n";
        }
}

string eff_status_msg(int ratio)
{
        if(ratio >= 100) 
		return HIG "看起来气血充盈，并没有受伤。" NOR;
        if(ratio > 95) 
		return HIG "似乎受了点轻伤，不过光从外表看不大出来。" NOR; 
        if(ratio > 90) 
		return HIY "看起来可能受了点轻伤。" NOR;
        if(ratio > 80) 
		return HIY "受了几处伤，不过似乎并不碍事。" NOR;
        if(ratio > 60) 
		return HIY "受伤不轻，看起来状况并不太好。" NOR;
        if(ratio > 40) 
		return HIR "气息粗重，动作开始散乱，看来所受的伤著实不轻。" NOR;
        if(ratio > 30) 
		return HIR "已经伤痕累累，正在勉力支撑著不倒下去。" NOR; 
        if(ratio > 20) 
		return HIR "受了相当重的伤，只怕会有生命危险。" NOR;
        if(ratio > 10) 
		return RED  "伤重之下已经难以支撑，眼看就要倒在地上。" NOR;
        if(ratio > 5) 
		return RED "受伤过重，已经奄奄一息，命在旦夕了。" NOR; 

        return RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR;
}

string status_msg(int ratio)
{
        if(ratio >= 100) 
		return HIG "看起来充满活力，一点也不累。" NOR;
        if(ratio > 95) 
		return HIG "似乎有些疲惫，但是仍然十分有活力。" NOR;
        if(ratio > 90) 
		return HIY "看起来可能有些累了。" NOR;
        if(ratio > 80) 
		return HIY "动作似乎开始有点不太灵光，但是仍然有条不紊。" NOR; 
        if(ratio > 60) 
		return HIY "气喘嘘嘘，看起来状况并不太好。" NOR;
        if(ratio > 40) 
		return HIR "似乎十分疲惫，看来需要好好休息了。" NOR;
        if(ratio > 30) 
		return HIR "已经一副头重脚轻的模样，正在勉力支撑著不倒下去。" NOR;
        if(ratio > 20) 
		return HIR "看起来已经力不从心了。" NOR;
        if(ratio > 10) 
		return RED "摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。" NOR; 
        return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR;
}

varargs void report_status(object ob, int effective)
{
        if(effective) 
                message_vision("( $N" + eff_status_msg(
                        (int)ob->query("eff_kee") * 100 / 
			(int)ob->query("max_kee") ) 
                        + " )\n", ob);
        else
                message_vision("( $N" + status_msg(
                        (int)ob->query("kee") * 100 / 
			(int)ob->query("max_kee") ) 
                        + " )\n", ob);
}

// This function gives player the exp depend on the 
// exp level of that player.
varargs int give_exp(int my_exp, int your_exp)
{
    int exp, level;

	if (!your_exp || (your_exp <=0)) your_exp=0;

	if ( my_exp < 1 )	my_exp = 1;

/*  I think high hand should get exp much harder, cbra */
/*  low hand give them a easy life  */

	if ( my_exp <= 100000 ) exp = 20;
	else if ( my_exp <= 500000 ) exp = 19;
	else if ( my_exp <= 1000000 ) exp = 18;
	else if ( my_exp <= 5000000 ) exp = 17;
	else if ( my_exp <= 10000000 ) exp = 16;
	else exp = 15;

	// give some extra exp to players
	//exp = 25;
	exp = exp + 5;

        // Adjust these parameters can adjust the speed of geting exp
        level = (int)(5 * your_exp / (1+my_exp));
        // the original value of 10 is 14 when no bonus below.
        if(level > 10 ) level = 10;
        else if(level < 1) return 0;
        // add 2 bonus to speep up the exp now :)
        return (int)((exp*(1+level))/7);
/*
        // Adjust these parameters can adjust the speed of geting exp
        level = (int)(4 * your_exp / (1+my_exp));
        // the original value of 10 is 14 when no bonus below.
        if(level > 8 ) level = 8;
        else if(level < 2) return 0;
        // add 2 bonus to speep up the exp now :)
	return (int) ( 5 * (level-1) );
        //return (int)((exp * level))/4);
*/
	//level = (int)(5 * your_exp / (1+my_exp));
	//if(level > 12 ) level = 12;
	//if(level > 14 ) level = 14;
	// the following number "7" can be changed to adjust the 
	// speed of geting exp
	//return (int)((exp*level)/6);
	//return (int)((exp*level)/7);
}

// This function calculates the combined skill/combat_exp power of a certain
// skill. This value is used for A/(A+B) probability use.
varargs int skill_power(object ob, string skill, int usage)
{
        int status, level, power, maxenc, enc, kee_fact, gin_fact;

	maxenc = (int)ob->query_max_encumbrance();
	enc = (maxenc - (int)ob->query_encumbrance()) * 10 / maxenc;

	// changed by May, players can carry 10% free weight.
	enc = enc + 1;
	if( enc > 10 )
		enc = 10;
	// end of May.
        if(!living(ob)) return 0;

        level = ob->query_skill(skill);

        switch(usage) 
	{
                case SKILL_USAGE_ATTACK:
                        level += ob->query_temp("apply/attack");
                        break;
                case SKILL_USAGE_DEFENSE:
                        level += ob->query_temp("apply/defense");
                        break;
                case SKILL_USAGE_FLEE:
                        break;
		case SKILL_USAGE_ABSORB:
			level += ob->query_temp("apply/iron-cloth");
			if(!level)
				return 0;
			else
				return level;
			break;
        }
	if((status = ob->query("max_kee")) > 0)
		kee_fact = (int)(20 * ob->query("kee") / status );
	if( kee_fact < 1 ) kee_fact = 1;
	else if( kee_fact > 20 ) kee_fact = 20;

	if(!level)
		return (int)ob->query("combat_exp") * kee_fact/ 1200 * enc / 10;

	// windf changed here
        power = level + (level * level * level )/ 20;

	if((status = ob->query("max_gin")) > 0){
		// Jane find a bug here! It makes power < 0 if level > 500, 
		// Now the level can be above 1000, but still have problem 
		// when level > 1250. 97/10/30
                // power = power * (int)ob->query("gin") / status;
		gin_fact = (int)(20 * ob->query("gin") / status );
		if( gin_fact < 1 ) gin_fact = 1;
		else if( gin_fact > 20 ) gin_fact = 20;
		power = power * gin_fact / 20;
	}
	else return 0; // if max_gin =< 0. then return 0 // by cbra May-14-1998
	
	return (power + kee_fact * ob->query("combat_exp") / 40) / 15 * enc / 10;
	//return (power + kee_fact * ob->query("combat_exp") / 40) / 150 * enc ; // lost some accurate to get speed and max number.
}

// do_attack()
//
// Perform an attack action. This function is called by fight() or as an
// interface for some special utilize in quests.
//
varargs int do_attack(object me, object victim, object weapon, int attack_type)
{
	int ap, dp, pp, absp, org_dp, org_pp;
	int def_count, int_bonus;
	int damage, damage_bonus;
	int exp = 0;
	int exp_gain, wounded = 0;
	int percept, star_move, dam, dam_bonus;  // Used by Jane.
        mapping my, your, action;
	mixed foo;
	object def_weapon, throw_ob;  // weapon used by victim.
        string *limbs, limb, result, res, str;
        string attack_skill, defense_skill, force_skill, martial_skill;
	string skill_type, enable_skill; //Used by Jane

        my = me->query_entire_dbase();
        your = victim->query_entire_dbase();
	
	// count the number of people attacted him in each heart beat round
	// -- by May, 03/03/2000. --
	me->set("defense_count",0);
	if ( victim->query("defense_count") < 19 )
		victim->add("defense_count", 1);
	def_count = victim->query("defense_count");

        //
        // (1) Find out what action the offenser will take.
        //
        action = me->query("actions");
        if(!mapp(action)) 
	{
                me->reset_action();
                action = me->query("actions");
                if(!mapp(action)) 
		{
                        CHANNEL_D->do_channel( this_object(), "sys",
	                                sprintf("%s(%s): bad action = %O",
                                        me->name(1), me->query("id"), 
					me->query("actions", 1)));
                        return 0;
                }
        }
        result = "\n" + action["action"] + "！\n";

        //
        // (2) Prepare AP, DP, PP, ABSP for checking if hit.
        //
        if(objectp(weapon))   
		attack_skill = weapon->query("skill_type");
        else {                                
		attack_skill = "unarmed";
		enable_skill = me->query_skill_mapped("unarmed");
	}

	// This check is added by Jane 97/11/13.
	if(def_weapon = victim->query_temp("weapon")) 
		skill_type = def_weapon->query("skill_type");
	else skill_type = "unarmed";
	victim->check_valid_parry_skill(skill_type);
        ap = skill_power(me, attack_skill, SKILL_USAGE_ATTACK);
        dp = skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
	pp = skill_power(victim, "parry", SKILL_USAGE_DEFENSE);

	if(attack_skill == "throwing"){
		percept = 3 + victim->query_skill("perception",1)/10;
		if(percept > 13 ) percept = 13;
	
		dp = dp * percept / 13;
		pp = pp * percept / 13;
	}

        if(ap < 1) ap = 1;

        if(victim->is_busy()) {
		dp /= 3;
		pp /= 3;
	}

	org_dp = dp;
	org_pp = pp;
	// 调正防卫力量，如果有多人同时进攻一个人时，降低防卫的
	// 成功率．具体系数为 9/(8+N).
	dp = dp * 9 / ( 8 + def_count );
	pp = dp * 9 / ( 8 + def_count );

	if(dp < 1) dp = 1;
	if (pp < 1) pp = 1;

	// Change here to make limbs more reasonable -Jane 97.10.20

	if ( (!limbs = action["limbs"]) || victim->query("race") == "野兽")
		limbs = victim->query("limbs");

	limb = limbs[random(sizeof(limbs))];

	//
        // (3) Fight!
        //     Give us a chance of AP/(AP+DP) to "hit" our opponent. 
	//     Since both AP and DP are greater than zero, so we 
        //     always have chance to hit or be hit.
	//

	// (3.1) If player is enforced, decrease the force factor 
	//       during the fight.
	if(userp(me))
	{
		if(my["force_factor"] && (my["force"] > my["force_factor"]))
			my["force"] -= my["force_factor"];
		else
			my["force_factor"] = 0;
	}

	// Can the victim dodge this hit?
        if(random(ap + dp) < dp) 
		res = "dodged";
	// Can the victim parry this hit?
	else if(random(ap + pp) < pp)
		res = "parryd";
	else
		res = "attackd";

	// If victim is unconcious, always attackd. -Jane
	if(!living(victim)) res = "attackd";

	switch(res)
	{
	case "dodged":
		int_bonus = your["int"];
		if (int_bonus > 40) int_bonus = 40;

		defense_skill = victim->query_skill_mapped("dodge");
                if(!defense_skill) defense_skill = "dodge";
                result += SKILL_D(defense_skill)->query_dodge_msg();

		/*
		if(dp - dp*your["int"]/50 < ap && (!userp(victim) || !userp(me)) )
		   && (your["combat_exp"] - your["combat_exp"]*your["int"]/50 <my["combat_exp"]))
		*/
		//if(!userp(victim) || !userp(me))
		if( (def_count < 5) && (dp - dp * int_bonus/50 < ap) && ( (!userp(victim)) || (!userp(me)) ) )
		{
			exp_gain = random(1+give_exp(your["combat_exp"],my["combat_exp"])/4);
			your["combat_exp"] += exp_gain;
			if(exp_gain < 12) {
			    if(random(12) < exp_gain )
				your["potential"] += 1;
			} else {
                        	your["potential"] += 1 + random(exp_gain)/12;
                        	victim->improve_skill("dodge", 1);
			}
                }

		// This is for NPC only. NPC have chance to 
		// get exp when fail to hit.
		if((ap < dp) && !userp(me)) 
		{
                        //if(random(my["int"]) > 15) 
			my["combat_exp"] += 1;
                        me->improve_skill(attack_skill, random(my["int"]));
                }
                damage = RESULT_DODGE;
		break;

        case "parryd":
		defense_skill = victim->query_skill_mapped("parry");
		if(!defense_skill) 
			defense_skill = "parry";

		// If victim use "star-move", he can reflect the the action 
		// to me. By Jane 97/11/12.

		if(attack_skill == "throwing"&&your["race"]=="人类" ) {
		    if(def_weapon )
			result += weapon_parry_throwing[random(sizeof(weapon_parry_throwing))];
		    else {
			result += unarm_parry_throwing[random(sizeof(unarm_parry_throwing))];
			throw_ob = new(base_name(weapon));
			throw_ob->set_amount(1);
			throw_ob->move(victim);
		    }
		} else if( enable_skill == "sixmai-sword") {
		    if(me->query_skill("sixmai-sword",1) < 50 )
			result += SKILL_D(defense_skill)->query_parry_msg(victim, weapon, action);
		    else { 
		    	if(def_weapon) {
			    result += weapon_parry_sixmai[random(sizeof(weapon_parry_sixmai))];
			    if( random( me->query_skill("sixmai-sword",1) * my["force_factor"] 
				+ (int)def_weapon->weight() ) > (int)def_weapon->weight() ) {
        			if(victim->query_temp("weapon"))
                		    result = replace_string(result, "$v", (victim->query_temp("weapon"))->name());
				result += HIW "只听见「啪」地一声，$n手中的" + def_weapon->name()
				    + "已被$N的无形剑气震为数截！\n" NOR;
				def_weapon->unequip();
				def_weapon->move(environment(victim));
				def_weapon->set("name", "断掉的" + def_weapon->query("name"));
				def_weapon->set("value", (int)def_weapon->query("value") / 10);
				def_weapon->set("weapon_prop", 0);
				victim->reset_action();
			    }
		    	} else
			    result += unarm_parry_sixmai[random(sizeof(unarm_parry_sixmai))];
		    }

		} else if (defense_skill == "star-move") {
		    star_move = victim->query_skill("star-move",1);
		    if( star_move < 30 || ( random(pp+ap) < ap ) )
			if(weapon)
			    result += star_move_weapon_1[random(sizeof(star_move_weapon_1))];
			else
			    result += star_move_unarm_1[random(sizeof(star_move_unarm_1))];
		    else {
			if(weapon)
			    result += star_move_weapon_2[random(sizeof(star_move_weapon_2))];
			else
			    result += star_move_unarm_2[random(sizeof(star_move_unarm_2))];
			dam = me->query_temp("apply/damage");
		 	if(action["damage"])
                            dam += action["damage"] * dam / 1000;
	                dam_bonus = me->query_str();
			if(my["force_factor"] && (my["force"] > my["force_factor"]))
			    dam_bonus += my["force_factor"];
			if(action["force"])
			    dam_bonus += action["force"] * dam_bonus / 1000;
			if(dam_bonus > 0)
			    dam += random(dam_bonus);
			if(star_move < 100 )
			    dam = dam * star_move / 100;

			me->receive_damage("kee", dam );
			if(dam > (int)me->query_temp("apply/armor") + 2 ) {
				me->receive_wound("kee", (dam -
					(int)me->query_temp("apply/armor"))/2, victim);
				wounded = 2;
			}
			str = damage_msg(dam, action["damage_type"]);
			str = replace_string(str,"n","N");
			str = replace_string(str,"p","P");
			result += str;
		    }
		} else {
		 
		// change to SKILL_D(defense_skill) after added 
		// parry msg to those martial arts that can parry.
		    result += SKILL_D(defense_skill)->query_parry_msg(victim, weapon, action);
		}

		int_bonus = your["int"];
		if(int_bonus > 40) int_bonus = 40;
		if( (def_count < 5) && (pp - pp * int_bonus / 50 < ap) && ( (!userp(victim)) || (!userp(me)) ) )
		{
			exp_gain = random(1+give_exp(your["combat_exp"],my["combat_exp"]));
                        your["combat_exp"] += exp_gain;
			if(exp_gain < 7) {
			    if(random(7) < exp_gain )
				your["potential"] += 1;
			} else {
				your["potential"] += 1 + random(exp_gain)/6;
				victim->improve_skill("parry", 1);
			}
		}
		damage = RESULT_PARRY;
		break;

	case "attackd":

		//
		// (4) We hit the victim and the victim failed 
		//     to defense
		//
		damage = me->query_temp("apply/damage");
		//damage = (damage + random(damage)) / 2;
		if(action["damage"])
			damage += action["damage"] * damage / 1000;
		damage_bonus = me->query_str();

		// Let force skill take effect.
		if(my["force_factor"] && (my["force"] > my["force_factor"])) 
		{
			if(force_skill = me->query_skill_mapped("force"))
			{
				foo = SKILL_D(force_skill)->hit_ob 
						(me, victim, damage_bonus, 
						my["force_factor"]);
				if(stringp(foo)) result += foo;
				else if(intp(foo)) 
					damage_bonus += foo; 
			}
		}

		if(action["force"])
			damage_bonus += action["force"] * damage_bonus / 1000;

		if(martial_skill = me->query_skill_mapped(attack_skill)) 
		{
			foo = SKILL_D(martial_skill)->hit_ob(me, 
							victim, damage_bonus);
			if(stringp(foo)) result += foo;
			else if(intp(foo)) damage_bonus += foo;
		}

		// Let weapon or monster have their special damage.
		if(weapon) 
		{
			foo = weapon->hit_ob(me, victim, damage_bonus);
			if(intp(foo)) damage_bonus += foo;
			else if(stringp(foo)) result += foo;
		} else {
			foo = me->hit_ob(me, victim, damage_bonus);
			if(intp(foo)) damage_bonus += foo;
			else if(stringp(foo)) result += foo;
		}

		if(damage_bonus > 0)
			//damage += (damage_bonus + random(damage_bonus))/2;
			damage += random(damage_bonus);
		if(damage < 0) damage = 0;

		// Let combat exp take effect
		exp = your["combat_exp"];
		// Only alived victim's exp take effect. -Jane
		if(living(victim))
		while(random(exp) > my["combat_exp"]) 
		{
			damage -= damage / 4;
			exp /= 2;
		}

		// (4.1) Check if victim can absorb the damage
		absp = skill_power(victim, "iron-cloth", SKILL_USAGE_ABSORB);
		// Only alived victim can absorb the damage -Jane
		if(living(victim))
		if(absp)
		{
			defense_skill = victim->query_skill_mapped("iron-cloth");
			if(!defense_skill) defense_skill = "iron-cloth";

			result += SKILL_D(defense_skill)->query_absorb_msg();
			foo = SKILL_D(defense_skill)->absorb_ob(victim, me, damage, absp);
			if(stringp(foo)) result += foo;
			else if(intp(foo)) damage += foo;
		}
			
		//
		// (5) Inflict the damage.
		//
		damage = victim->receive_damage("kee", damage, me );

		if((me->is_killing(victim) || weapon)
		&& random(damage) > (int)victim->query_temp("apply/armor"))
		{
			// We are sure that damage is greater 
			// than victim's armor here.
			victim->receive_wound("kee", (damage -
				(int)victim->query_temp("apply/armor")) / 2, me);
			wounded = 1;
		}
		// Jane changed here.
		if ( (victim->query("race") == "野兽") 
			&& (action["damage_type"]=="点穴")) 
		    result += damage_msg(damage, "戳伤");
		else 
		    result += damage_msg(damage, action["damage_type"]);

		//
		// (6) Give experience
		//
		int_bonus = my["int"];
		if(int_bonus > 30) int_bonus = 30;

		if( (def_count < 5) && !userp(victim) && !wizardp(victim) ) 
		{
			if(((ap - dp*int_bonus/100 < dp)
				|| (ap - pp*int_bonus/100 < pp)))
			{
				exp_gain = random(1+give_exp(my["combat_exp"],your["combat_exp"]));
				my["combat_exp"] += exp_gain;
                       		if(exp_gain < 6) {
					if(random(6) < exp_gain)
                              		your["potential"] += 1;
                        	} else {
					my["potential"] += 1 + random(exp_gain)/4;
					me->improve_skill(attack_skill, 1);
				}
			}
		}
               
		break;
        } 

        result = replace_string(result, "$l", limb);
	if(victim->query_temp("weapon"))
                result = replace_string(result, "$v", (victim->query_temp("weapon"))->name());

	if(victim->query_skill_mapped("iron-cloth"))
		result = replace_string(result, "$z", to_chinese(victim->query_skill_mapped("iron-cloth")));
	else
		result = replace_string(result, "$z", to_chinese("iron-cloth"));

        if(objectp(weapon))
                result = replace_string(result, "$w", weapon->name());
        else if(stringp(action["weapon"]))
                result = replace_string(result, "$w", action["weapon"]);

//	message_vision(result,me,victim);

	// Jane changed here! 97/10/
	if( ( userp(me) && userp(victim)) ||
	    ( !me->query_temp("mute") && !victim->query_temp("mute") ) )
            message_vision(result, me, victim);

        if(wizardp(me) && (string)me->query("env/combat")=="verbose") 
	{
                if( damage > 0 )
                        tell_object(me, sprintf(GRN 
				"AP：%d，DP：%d，PP：%d，伤害力：%d\n" NOR,
                                ap/100, dp/100, pp/100, damage));
                else
                        tell_object(me, sprintf(GRN 
				"AP：%d，DP：%d，PP：%d\n" NOR,
                                ap/100, dp/100, pp/100));
        }

        if(damage > 0 || dam > 0) 
	{
		if ( damage > 0 ) {
			if(stringp(foo) && absp) report_status(me, 0);
                	else report_status(victim, wounded);
		} else if( dam > 0 )
			report_status(me,wounded);

                if(victim->is_busy()) victim->interrupt_me(me);
                if((!me->is_killing(your["id"]))
		&& (!victim->is_killing(my["id"])) 
		&& ((victim->query("kee")*2 <= victim->query("max_kee"))
		|| (me->query("kee")*2 <= me->query("max_kee")))) 
		{
                        me->remove_enemy(victim);
                        victim->remove_enemy(me);
			if(stringp(foo))
			{
			    if(me->query("race") == "野兽") 
				message_vision(CYN"$N输了这一招，垂头丧气，躲在了一旁。\n"NOR,me);
			    else if(victim->query("race") == "野兽")
				message_vision(CYN"$N赢了这一招，神气活现，简直不可一世。\n"NOR,victim);
			    else
				message_vision(winner_msg[random(sizeof(winner_msg))], victim, me);
				winner_announce(victim, me);
			} else {
                            if(victim->query("race") == "野兽") 
                                message_vision(CYN"$N输了这一招，垂头丧气，躲在了一旁。\n"NOR,victim);
                            else if(me->query("race") == "野兽")
                                message_vision(CYN"$N赢了这一招，神气活现，简直不可一世。\n"NOR,me);
                            else
                        	message_vision(winner_msg[random(sizeof(winner_msg))], me, victim);
				winner_announce(me, victim);
			}
                }
        }

        if(functionp(action["post_action"]))
                evaluate( action["post_action"], me, victim, weapon, damage);

        // See if the victim can make a riposte. Only for alived victim -Jane
        if(attack_type==TYPE_REGULAR && damage < 1
        && victim->query_temp("guarding") && living(victim)) 
	{
                victim->set_temp("guarding", 0);
		// Jane changed the following "cor" to "int",
                if(random(my["int"]) < 5) 
		{
        		if( ( userp(me) && userp(victim)) ||
            		    ( !me->query_temp("mute") && !victim->query_temp("mute") ) )
                        message_vision("$N一击不中，露出了破绽！\n", me);
                        do_attack(victim, me, victim->query_temp("weapon"), 
								TYPE_QUICK);
                } else {
                        if( ( userp(me) && userp(victim)) ||
                            ( !me->query_temp("mute") && !victim->query_temp("mute") ) )
                        message_vision("$N见$n攻击失误，趁机发动攻击！\n", 
								victim, me);
                        do_attack(victim, me, victim->query_temp("weapon"), 
								TYPE_RIPOSTE);
                }
        }
}

// winner_announce(object ob1, object ob2)
void winner_announce(object ob1, object ob2)
{
	int month;
	object bbs, env;
	mapping note;
	mixed *local;
	string text;

	env = environment(ob1);
	if(!env->query("rec_fight_res")) return;

	bbs = present("board", env);
	if(!bbs) return;

  	message("channel:chat", YEL+"【" + env->query("short") + "】：" + ob1->name() +
		"在比武中战胜" + ob2->name() + "。\n" + NOR, users());
	local = localtime(time());
	month = local[4] + 1;
	note = allocate_mapping(4);
	note["title"] = ob1->name() + " 战胜 " + ob2->name();
//	note["title"] =  local[5] + "年" + month + "月" + local[3]
//			+ "日" + local[2] + "时" + local[1] + "分";
	note["author"] = env->query("short");
	note["time"] = time();
	text = local[5] + "年" + month + "月" + local[3] + "日" 
		+ local[2] + "时" + local[1] + "分：\n" + ob1->short() 
		+ "\n\t战胜\n" + ob2->short();
	bbs->done_post(ob1, note, text);
}

//      fight()
//
// This is called in the attack() defined in F_ATTACK, which handles fighting
// in the heart_beat() of all livings. Be sure to optimize it carefully.
//
void fight(object me, object victim)
{
 //       object ob;

        if(!living(me)) return;

        if(!me->visible(victim)
        && (random(100 + (int)me->query_skill("perception")) < 100))
                return;

	// If victim is busy or unconcious, always take the 
	// chance to make an attack.
        if( victim->is_busy() || !living(victim) ) {
                me->set_temp("guarding", 0);
                if( !victim->is_fighting(me) ) victim->fight_ob(me);
                do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);

        // Else, see if we are brave enough to make an aggressive action.
        } else if(random((int)victim->query("cor") * 2) < ((int)me->query("cor")
		+ (int)me->query("bellicosity") / 50)) 
	{
                me->set_temp("guarding", 0);
                if( !victim->is_fighting(me) ) victim->fight_ob(me);
                do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);

        // Else, we just start guarding.
        } else if( !me->query_temp("guarding") ) {
                me->set_temp("guarding", 1);
        	if( ( userp(me) && userp(victim)) ||
            	    ( !me->query_temp("mute") && !victim->query_temp("mute") ) )
                message_vision( guard_msg[random(sizeof(guard_msg))], me, victim);
                return;
        } else return;
}

// auto_fight()
//
// This function is to start an automatically fight. Currently this is
// used in "aggressive", "vendetta", "hatred", "berserk" fight.
//
void auto_fight(object me, object obj, string type)
{
        // Don't let NPC autofight NPC.
        if(!userp(me) && !userp(obj)) return;
	if (userp(me) && userp(obj) && environment(me)->query("no_user"))
		return;
	if (userp(me) && userp(obj) && environment(me)->query("no_dead"))
		return;

	// Because most of the cases that we cannot start a fight 
	// cannot be checked before we really call the kill_ob(), 
	// so we just make sure we have no 

        // aggressive callout wating here.
        if(me->query_temp("looking_for_trouble")) return;

        me->set_temp("looking_for_trouble", 1);

        // This call_out gives victim a chance to slip trough the fierce guys.
        call_out( "start_" + type, 0, me, obj);
}

void start_berserk(object me, object obj)
{
        int bellicosity;

        if(!me || !obj) return;                               
	// Are we still exist( not becoming a corpse )?

        me->set_temp("looking_for_trouble", 0);

        if( me->is_fighting(obj)                            
	// Are we busy fighting?
        || !living(me)      
	// Are we capable for a fight?
        || environment(me)!=environment(obj)       
	// Are we still in the same room?
        || environment(me)->query("no_fight")      
	// Are we in a peace room?
        )       return;

        bellicosity = (int)me->query("bellicosity");
        message_vision("$N用一种异样的眼神扫视著在场的每一个人。\n", me);

        if((int)me->query("force") > (random(bellicosity) + bellicosity) / 2) 
		return;

	if(userp(me) && userp(obj) && (me->query("age") <= 16 || obj->query("age") <= 16))
		return;

        if(bellicosity > ((int)obj->query("per") * 20) && !wizardp(obj))
        {
	    if( me->query("kill_msg"))
		message_vision(me->query("kill_msg"),me, obj);
	    else
                message_vision("$N对著$n喝道：" + RANK_D->query_self_rude(me)
                        + "看你实在很不顺眼，去死吧。\n", me, obj);
                me->kill_ob(obj);
		obj->fight_ob(me);
        } else {
	    if( me->query("fight_msg"))
                message_vision(me->query("fight_msg"),me, obj);
            else
                message_vision("$N对著$n喝道：喂！" + RANK_D->query_rude(obj)
                        + "，" + RANK_D->query_self_rude(me)
			+ "正想找人打架，陪我玩两手吧！\n",
                        me, obj);
                me->fight_ob(obj);
		obj->fight_ob(me);
        }
}

void start_hatred(object me, object obj)
{
        if(!me || !obj) return;                               
	// Are we still exist( not becoming a corpse )?

        me->set_temp("looking_for_trouble", 0);

        if(me->is_fighting(obj)                            
	// Are we busy fighting?         
        || !living(me)      
	// Are we capable for a fight?
        ||      environment(me)!=environment(obj)       
	// Are we still in the same room?
        ||      environment(me)->query("no_fight")      
	// Are we in a peace room?
        )       return;

        // We found our hatred! Charge!
        message_vision( catch_hunt_msg[random(sizeof(catch_hunt_msg))], me, 
obj);
        me->kill_ob(obj);
	obj->fight_ob(me);
}

void start_catch(object me, object obj)
{
	if(!me || !obj) return;

	me->set_temp("looking_for_trouble", 0);

	if(me->is_fighting(obj)
	|| !living(me)
	|| environment(me) != environment(obj))
		return;

	message_vision("$N对$n看了一眼，忽然大声喝道：此人便是要犯" 
		+ obj->name(1) + "，看你今天还往哪儿逃！\n", me, obj);
	me->set_leader(obj);
	me->kill_ob(obj);
	obj->fight_ob(me);
}
	
void start_vendetta(object me, object obj)
{
        if(!me || !obj) return;                               
	// Are we still exist( not becoming a corpse )?

        me->set_temp("looking_for_trouble", 0);

        if(me->is_fighting(obj)                            
	// Are we busy fighting?
        || !living(me)      
	// Are we capable for a fight?
        || environment(me)!=environment(obj)       
	// Are we still in the same room?
        || environment(me)->query("no_fight")      
	// Are we in a peace room?
        )       return;

        // We found our vendetta opponent! Charge!
        me->kill_ob(obj);
	obj->fight_ob(me);
}

void start_aggressive(object me, object obj)
{
        if( !me || !obj ) return;                               
	// Are we still exist( not becoming a corpse )?

        me->set_temp("looking_for_trouble", 0);

        if(me->is_fighting(obj)                            
	// Are we busy fighting?
        || !living(me)     
	// Are we capable for a fight?
        || environment(me) != environment(obj)       
	// Are we still in the same room?
        || environment(me)->query("no_fight")      
	// Are we in a peace room?
        )       return;

        // We got a nice victim! Kill him/her/it!!!
        me->kill_ob(obj);
	obj->fight_ob(me);
}

// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.
void announce(object ob, string event)
{
        switch(event) {
                case "dead":
                        message_vision("\n$N死了。\n\n", ob);
			if (userp(ob)) ob->add("DIED",1);
                        break;
                case "unconcious":
			message_vision("\n$N两眼发黑，脑袋嗡的一下，跌在地上一动也不动了。\n\n", ob);
                        break;
                case "revive":
                        message_vision("\n$N慢慢睁开眼睛，清醒了过来。\n\n", 
ob);
                        break;
        }
}

void winner_reward(object killer, object victim)
{
        killer->defeated_enemy(victim);
}

int IsPKMurder(object killer, object victim)
{
	mapping pk_list;
	int i, count, curtime, deleted;
	int one_year_count;
	string *times;
	int *val;

	// 如果是对方先挑起战火：
	if(victim->query_temp("intruding/" + killer->query("id")) || killer->query_temp("intruded/" + victim->query("id")))
		return 0;
	
	// 我们将限制一个玩家在一岁内能PK的人数
	if(!wizardp(victim) && (victim->query("combat_exp") < killer->query("combat_exp")) )
		killer->set("pktime/" + killer->query("mud_age"), killer->query("mud_age"));

	if(!mapp(pk_list = killer->query("pktime")))
		return 1;
	times = keys(pk_list);
	count = sizeof(times);
	if (count <= 10)
		return 1;

	curtime = killer->query("mud_age");
	deleted = 0;
	val = values(pk_list);
	one_year_count = 86400;
	for(i = 0; i<count; i++) {
	    if(val[i] < curtime - one_year_count) {
		killer->delete("pktime/" + times[i]);
		deleted++;
	    } else
		break;
	}

	if(count - deleted <= 10)
		return 1;

	killer->add("PK_punish",1);

	return 1;
}
void killer_reward(object killer, object victim)
{
        int bls;
        string vmark;
        mapping quest;
        int i,msize,exp, pot, score ;
        object *mem;

     // Call the mudlib killer apply.
	if (userp(killer) && killer->query_temp("want_out_apprentice")
			&& killer->is_apprentice_of(victim)) {
		killer->delete_temp("want_out_apprentice");
		victim->delete_temp("want_out_apprentice");
		killer->delete("family");
	}
        killer->killed_enemy(victim);

	if(!userp(victim)) 
	{
		killer->add("MKS", 1);
		bls = 1;
	} else if(environment(killer)->query("no_dead") && userp(killer)) {
                killer->add("PKS", 1);
                // victim->clear_condition();
		// Give the death penalty to the dying user.
                victim->delete("vendetta");
                bls = 10;
                CHANNEL_D->do_channel(this_object(), "rumor",
			sprintf("%s在比武中被%s杀死了。", victim->name(), 
			killer->name()));
	} else {
                killer->add("PKS", 1);
		// 如果是对方先挑起的战火，不应该算作是PK.
		if(IsPKMurder(killer, victim)) {
			killer->add("REAL_PK",1);  //add by jane,used in 无量山和玉壁宫
			killer->add("PK_MURDER", 1);
		}
		if(!victim->query_temp("real_PK_murder"))
			killer->set_temp_pk_flag();
                victim->clear_condition();
		victim->set("bellicosity", 0);
		if(userp(killer)) {
			victim->add("PKED",1);
			log_file("static/realpk.log",sprintf( "%s(%s) (exp=%d) (age=%d) from %s killed\n%s(%s) (exp=%d) (age=%d) from %s at %s.\n" ,
			killer->name(), killer->query("id"), killer->query("combat_exp"),killer->query("age"),query_ip_name(killer),
			victim->name(), victim->query("id"), victim->query("combat_exp"),victim->query("age"),query_ip_name(victim),
			ctime(time()) ) );
		}

		// Give the death penat)victim->query("combat_exp") / 20);
		// add by cbra for protection. May-16-1998
		victim->add("combat_exp", - victim->query("combat_exp") / 20);
		if ( ((int)victim->query("combat_exp")) < 0 ) victim->set("combat_exp",0);
		//and killer(user) will get the half of the lost exp
		// Changed by Jane here  97/11/09
		/* changed by windf here 11/06/99
		if(userp(victim) && userp(killer)) {
			killer->add("combat_exp",-(int)victim->query("combat_exp")/100);
			if ( killer->query("combat_exp") < 0 )
				killer->set("combat_exp",0);
		}
		*/
				
                victim->delete("vendetta");
                if((int)victim->query("potential") > (int)victim->query("learned_points"))
                        victim->add("potential", ((int)victim->query("learned_points") - (int)victim->query("potential"))/2 );
		if (!userp(killer))
                	victim->skill_death_penalty();

                bls = 10;
                CHANNEL_D->do_channel(this_object(), "rumor",
                        sprintf("%s被%s杀死了。", victim->name(), 
				killer->name()));
		killer->set("refuse_money", 1);
		//killer->set("banknum", killer->query("banknum") / 2);
	}

        // NPC got 10 times of bellicosity than user.
	//        killer->add("bellicosity", bls * (userp(killer)? 1: 10));
	killer->add("bellicosity", bls * (userp(killer) ? 
			1 : (!killer->is_master())*10));

	if(killer->query("GARRISON") && victim->query("PK_MURDER"))
		victim->delete("PK_MURDER");
	if(killer->query("disapear") && !userp(killer)) 
	{
		if(killer->query("disapear_msg"))
			message_vision(killer->query("disapear_msg"), killer);
		destruct(killer);
		return;
	}

        if(stringp(vmark = victim->query("vendetta_mark")))
                killer->add("vendetta/" + vmark, 1);

	// Now let's add the quest reward here
        if(interactive(killer) && (quest = killer->query("quest"))
	&& (victim->name() == quest["quest"])
	&& !userp(victim)) {
	    if ((int)killer->query("task_time") >= time())
            {
        	exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);

		// put a limit on max exp we can get from a quest
        	if(exp > 100) exp = 100;
        	exp = exp * (int) killer->query_temp("quest_number");
        	pot = exp / 10 + 1;

		// for weekly race, each quest worth same, 20
        	score = quest["score"]/2 + random(quest["score"]/2);
		if(score < 2) score = 2;
        	mem = killer->query_team();
        	msize = sizeof(mem);    
        	if(msize < 1) msize =1;
        	if(msize <= 1) 
		{       
        		tell_object(killer,"恭喜你！你又完成了一项任务！\n");
        		killer->add("combat_exp", exp);
        		killer->add("potential", pot);
        		killer->add("score", score);
        		tell_object(killer,HIY"你被奖励了：\n" +
        		chinese_number(exp) + "点实战经验\n"+
        		chinese_number(pot) + "点潜能\n"+ 
        		chinese_number(score)+"点功劳\n"NOR);
        	} else {
        		exp = exp / msize;
        		pot = pot / msize;
        		score = score /msize;
        		for(i=0;i<sizeof(mem);i++)
        		{
                		if((mem[i]->query_temp("ttarget") == victim->query("id")) || mem[i] == killer)
                		if(environment(killer) == environment(mem[i]))
				{
        				tell_object(mem[i],"恭喜你！你又完成了一项任务！\n");
        				mem[i]->add("combat_exp", exp);
        				mem[i]->add("potential", pot);
        				mem[i]->add("score", score);
        				tell_object(mem[i],HIY"你被奖励了：\n" +
        				chinese_number(exp) + "点实战经验\n"+
        				chinese_number(pot) + "点潜能\n"+
        				chinese_number(score)+"点功劳\n"NOR);
                          	}     
        		}       
        	}
                // by cbra May-14-1998 killer->set("quest", 0);
                killer->delete("quest");
            } else {
                // by cbra May-14-1998 killer->set("quest", 0);
                killer->delete("quest");
		// by cbra May-14-1998 killer->set_temp("quest_number",0);		
		killer->delete_temp("quest_number");		
	    }
	}
}
