// Ported to ES2 mudlib by Annihilator@ES2.

#include <command.h>
#include <net/dns.h>
#include <net/macros.h>
#include <net/daemons.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

#include <net/intermud.h> // add by cbra for debug and mudlist restriction 1998-01-03

/*
* Someone has asked us for a remote who...
* Lets oblige them.
*/
void incoming_request(mapping info)
{
	object ob;
	string str, sex;
//	int i;

	if(!ACCESS_CHECK(previous_object())) return;

	if (stringp(info["NAME"]) && stringp(info["PORTUDP"])) {
//		if (info["NAME"] == Mud_name())	return ;
		if (!DNS_MASTER->dns_mudp(info["NAME"])) {
			PING_Q->send_ping_q(info["HOSTADDRESS"], info["PORTUDP"]);
			CHANNEL_D->do_channel( this_object(), "sys",
				sprintf("rwho request from %s rejected, ping_q sent.", info["NAME"] ) );
		}
// add by cbra for host check, valid_hosts define in /include/net/intermud.h 1998-01-03
#ifdef CBRA
        set("channel_id", "网路频道精灵");
        CHANNEL_D->do_channel(this_object(),"debug",sprintf("address:%s:%s. function: %s",
        info["HOSTADDRESS"], info["PORTUDP"],DNS_TLEMOTE_Q  ));
#endif
                if ( member_array(info["HOSTADDRESS"],valid_hosts)== -1) {
			return ;
                }
// end
                ob=find_player(info["REMOTE_ID"]);
                if((!objectp(ob))||(!userp(ob)) || (ob->query("env/invisibility"))) return;

		sex = ob->query("gender");
		str = sprintf("mud=%s id=%s name=%s gender_s=%s gender_p=%s\n",
		Mud_name(),ob->query("id"),ob->query("name"),gender_self(sex),gender_pronoun(sex));

		DNS_MASTER->send_udp(info["HOSTADDRESS"], info["PORTUDP"],
			"@@@"+DNS_TLEMOTE_A+
			"||NAME:"+ Mud_name() +
			"||PORTUDP:"+ udp_port() +
			"||ASKWIZ:"+ info["ASKWIZ"] +
			"||CHANNEL:"+ info["CHANNEL"] +
			"||REMOTE_ID:"+ info["REMOTE_ID"] +
			"||EMOTE_VB:"+ info["EMOTE_VB"] +
			"||PARTY:"+ info["PARTY"] +
			"||REMOTE_INFO:"+ str +
			"||@@@\n");

    } 
}

void send_tlemote_q(string mud, string channel, string id, string remote_id, string emote_vb, string party)
{
	mapping info;

	if(!ACCESS_CHECK(previous_object())
	&&	base_name(previous_object()) != CHANNEL_D) return;

	info = DNS_MASTER->query_mud_info(mud);
	if (!info) return ;

	DNS_MASTER->send_udp(info["HOSTADDRESS"], info["PORTUDP"],
		"@@@"+DNS_TLEMOTE_Q+
		"||NAME:"+ Mud_name() +
		"||PORTUDP:"+ udp_port() +
		"||ASKWIZ:"+ id +
		"||CHANNEL:"+ channel +
		"||REMOTE_ID:"+ remote_id +
		"||EMOTE_VB:"+ emote_vb +
		"||PARTY:"+ party +
		"||@@@\n");
}

void create() { seteuid(ROOT_UID); }
