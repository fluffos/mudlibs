// An HTTP (World Wide Web) server written in LPC for the Interstice mudlib
// and MudOS v21 driver (using socket efuns).
// Windf@TLBB ported for TLBB and add Basic Authentication, 1997

// Change no_one to your name to get debug information to your
// character.
#define DEBUGGER "no-one-no"
#ifdef ANONYMOUS_FTP
#undef ANONYMOUS_FTP
#endif

#include <mudlib.h>
#include <localtime.h>
#include <net/config.h>
#include <net/daemons.h>
#include <net/ftpdconf.h> // still use some functions from FTP
#include <net/ftpdsupp.h> // to check password
#include <net/httpd.h>
