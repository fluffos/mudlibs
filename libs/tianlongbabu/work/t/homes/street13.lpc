// Room: /t/homes/street13.c

inherit ROOM;

void create()
{
	set("short", "花径");
	set("long", @LONG
这是鸳鸯村里的一条小路，路边种满了各种鲜花，有大理名品
茶花，也有从各地移植来的上等花卉如玫瑰，兰花等。再加上这里
四季如春，花香不绝，住在这里真让人觉得心旷神怡。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"bridge2",
  "north" : __DIR__"bridge1",
  "west" : __DIR__"street14",
  "east" : __DIR__"street12",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
