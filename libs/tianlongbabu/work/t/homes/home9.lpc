// Room: /t/homes/dos_deluo.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", HIM"温馨之家"NOR);
	set("long",
	"  "+GRN"※※※"NOR+"    "+BLU"□□□□□□□□□□□□□"NOR+"    "+GRN"※※※\n"NOR +
  "      "+GRN"※"NOR+"九"+GRN"※"NOR+"    "+BLU"□"NOR+"::         "+HIY"**"NOR+"         "+BLU"□"NOR+"    "+GRN"※"NOR+"青"+GRN"※\n"NOR+
  "      "+GRN"※"NOR+"月"+GRN"※"NOR+"    "+BLU"□"NOR+"::         "+HIY"*"NOR+"｜"+HIY"* *"NOR+"     "+BLU"□"NOR+"    "+GRN"※"NOR+"裙"+GRN"※\n"NOR+
  "      "+GRN"※"NOR+"茶"+GRN"※"NOR+"    "+BLU"□"NOR+":  "+HIY"*  * *"NOR+"   ｜/"+HIY"* *"NOR+"    "+BLU"□"NOR+"    "+GRN"※"NOR+"玉"+GRN"※"NOR+"\n"+
  "      "+GRN"※"NOR+"花"+GRN"※"NOR+"    "+BLU"□"NOR+"    "+HIY"**"NOR+"＼"+HIY"'**"NOR+" ｜        "+BLU"□"NOR+"    "+GRN"※"NOR+"面"+GRN"※"NOR+"\n"+
  "      "+GRN"※"NOR+"满"+GRN"※"NOR+"    "+BLU"□"NOR+RED"#"NOR+"    "+HIY"* *"NOR+"＼"+HIY" *"NOR+"┃  "+HIY"***"NOR+"   "+BLU"□"NOR+"    "+GRN"※"NOR+"如"+GRN"※"NOR+"\n"+
  "      "+GRN"※"NOR+"路"+GRN"※"NOR+"    "+BLU"□"NOR+":         ＼┃ "+HIY"*,* *"NOR+"  "+BLU"□"NOR+"    "+GRN"※"NOR+"相"+GRN"※"NOR+"\n"+
  "      "+GRN"※"NOR+"开"+GRN"※"NOR+"    "+BLU"□"NOR+":           ┃／      "+BLU"□"NOR+"    "+GRN"※"NOR+"识"+GRN"※"NOR+"\n"+
  "      "+GRN"※※※"NOR+"    "+BLU"□□□□□□□□□□□□□"NOR+"    "+GRN"※※※"NOR+"\n"
	);
	set("no_fight", "1");

	set("exits", ([ /* sizeof() == 1 */
	"east" : "/t/dali/cross.lpc",
]));

	set("no_clean_up", 0);

	setup();
}

void init()
{      
	object* oblist;
	object ob, env;
	
	env = this_object();
	oblist = all_inventory(env);

        if( interactive( ob = this_player())) {
	    if ( wizardp(ob) )  return;
	    if ( sizeof(oblist) <= 1 ) return;
	    if( sizeof(oblist) > 2 ) ob->move("/t/dali/hotel");
	    if( sizeof(oblist) == 2 ) {
		if( oblist[0]->query("gender") == oblist[1]->query("gender") )
                ob->move("/t/dali/hotel");
	    }
        }
}

