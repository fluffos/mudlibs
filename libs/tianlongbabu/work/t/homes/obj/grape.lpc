// grape.c

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("大葡萄", ({ "grape" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一串红得发紫的大葡萄。\n");
                set("unit", "串");
                set("value", 0);
                set("food_remaining", 2);
                set("food_supply", 50);
        }
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object me = this_player();
	int shiwu;

        if( !arg ) return notify_fail("你要吃什麽？\n");
        if ( !(arg == "grape") ) return notify_fail("你要吃什麽？\n");
	if( me->query("food") >= me->max_food_capacity() )
		return notify_fail("你吃得太饱了，想撑死自己啊！\n");

	shiwu = me->max_food_capacity();
        me->set("food", shiwu);
	switch ( random(2) ) {
	case 0:
            message_vision("$N拿起一串大葡萄拼命地吃呀吃，觉得从来没吃过这么好的东西。\n", me);
		break;
	case 1:
	    message_vision("$N拿起一串大葡萄吃了一个，啊呀！牙都酸掉了！！\n",me);
		break;
	}
        destruct(this_object());
        return 1;
}

