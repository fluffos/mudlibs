inherit ROOM;

void create()
{
	set("short", "南坪晚钟");
	set("long", @LONG
一大片向阳的草坪，朵朵野花点缀着密密的青草地。远处小山
坡上传来一阵阵钟声，好象是要告诉人们珍惜现在吧！时间不会再
回来。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"road2",
  "west" : __DIR__"street31",
]));
	set("objects", ([
	__DIR__"npc/girl" : 1,
	]));

	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
