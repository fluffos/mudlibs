void init()
{      	
	add_action("do_invite","invite");
	add_action("do_leave","leave");

}

int do_leave(string arg)
{
	if(this_player()->query("id") != query("owner"))
		return notify_fail("你不是这里的主人，没有这个权利。\n");

	if(!arg) return notify_fail("你不让谁进来？\n");
	if(!this_object()->query("guest/" + arg))
		return notify_fail("这个人不在你的名单上。\n");
	this_object()->delete("guest/" + arg);
		return notify_fail("OK.\n");
}

int do_invite(string arg)
{
	object me = this_player();
	object who,room;

        if(me->query("id") != query("owner"))
                return notify_fail("你不是这里的主人，没有这个权利。\n");


	if(!arg) return notify_fail("你要请谁？\n");
	room = this_object();
	if(who=present(arg,room)) {
	    if(who->is_character())
		return notify_fail("他已经在这里了。\n");
	    else
		return notify_fail("你要请谁？\n");
	}
	if(who = find_player(arg)) {
		message_vision(MAG"$N请$n到$P家里作客。\n"NOR, me, who);
		room->set("guest/" + arg, 1);
	}else {
		return notify_fail("有这个人吗？\n");
	}
	
	return 1;
}

int prevent_enter(string arg)
{
	if(arg == query("owner")) return 0;
	if(this_object()->query("guest/" + arg))
		return 0;
	else
		return 1;
}

