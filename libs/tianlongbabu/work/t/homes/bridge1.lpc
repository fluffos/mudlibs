inherit ROOM;

void create()
{
	set("short", "小桥流水");
	set("long", @LONG
一座小桥横跨个一条小溪，将南北两村连在一起。小桥是用白
石造的，桥的两边各有一排石栏杆。桥上行人的脚步声与桥下小溪
的流水声交织在一起。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"street13",
  "north" : __DIR__"street03",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
