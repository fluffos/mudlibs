void create()
{
	set("short", "夕阳晚照");
	set("long", @LONG
一个小山坡上长着一颗大树，在夕阳余辉中拖着一条长长的影
子。火红的太阳映红了半边天空，远远望去，千里平原，长河落日
，给人留下无穷无尽的回忆。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "southwest" : __DIR__"street70",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"obj/apple" : 1,
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
