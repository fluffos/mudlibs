// Room: /t/homes/road1.c

inherit ROOM;

void create()
{
	set("short", "桃花林");
	set("long", @LONG
这里长满了桃树，每年春季，桃花漫山遍野竞相开放，极为壮
观。桃花林中隐隐约约可见到几间小平房，好丛中有不少蜜蜂飞来
飞去，它们在辛勤地采蜜。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"entrance",
  "west" : __DIR__"street11",
  "south" : __DIR__"road2",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
