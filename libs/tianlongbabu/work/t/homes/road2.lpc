// Room: /t/homes/road2.c

inherit ROOM;

void create()
{
	set("short", "碧水潭");
	set("long", @LONG
一汪清澈见底的湖水，在微风中荡漾涟漪。沿岸一排杨柳随风
轻摆，婀娜多姿。湖中各色小鱼正戏水玩耍，自由自在。天上一行
大雁向南飞去，留下悠悠的鸣声。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"road1",
  "west" : __DIR__"street21",
  "south" : __DIR__"road3",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("do_fillwater", "fillwater");
        add_action("do_fillwater", "fill");
}

int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
//        string dir;

        if( !arg || arg=="" ) return 0;

        if( arg=="skin" || arg=="wineskin" ) {
                list = all_inventory(this_player());
                i = sizeof(list);
                can_fillwater = 0;
                while (i--) {
                  if (((string)list[i]->query("liquid/type") == "alcohol")
 || ((string)list[i]->query("liquid/type") == "water")         ) {
                        ob = list[i];
                        can_fillwater = 1;
                        ob->set("liquid", ([
                                "type": "water",
                                "name": "清水",
                                "remaining": 15,
                                "drunk_apply": 6,
                        ]) );
                        write("你从水池里装满了清水! \n");
                        return 1;
                   }
                }
                if (can_fillwater ==0) {
                        write("你没有装水的东西啊啊....\n");
                        return 1;
                }
        }
        else {
                write("你要往什么东西里灌水？");
        }
        return 1;
}

