// Room: /t/homes/street36.c

inherit ROOM;

void create()
{
	set("short", "警世石");
	set("long", @LONG
鸳鸯村里放了一块大石头，上面刻着古往今来的警世名言，告
戒人们该当如何生活。村里夫妻如有吵架之事，常常来这里省脑。
矛盾多半便能得到解决。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"home4",
  "south" : __DIR__"street50",
  "east" : __DIR__"street35",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
