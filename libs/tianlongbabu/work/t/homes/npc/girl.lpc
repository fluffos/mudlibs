// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("程灵素", ({ "chls" }) );
	set("gender", "女性" );
	set("age", 20);
	set("long",
		"程灵素长着一双明澈乌黑的大眼睛，俏丽的面容上总是挂着微笑。\n");
	set("combat_exp", 500);
	set("attitude", "friendly");
	set("per",28);
	set("force", 100);
	set("max_force",100);

	set_skill("dodge",20);
	set_skill("parry",20);
	set_skill("unarmed",20);
	set("force_factor",5);
	
	set("vendor_goods", ([
		"香烟": __DIR__"obj/yan",
		"喜糖": __DIR__"obj/sugar",
		"女儿红": __DIR__"obj/nuerhong",
		"状元红": __DIR__"obj/zhuang",
		"红粉佳人": __DIR__"obj/wine",
	]) );

	setup();

	carry_object("/t/dali/npc/cloth/color-dress")->wear();
	carry_object("/t/dali/npc/cloth/boots")->wear();
	carry_object(__DIR__"obj/qixin")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
//		remove_call_out("greeting");
//		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
	add_action("do_kill","kill");
}

int do_kill(string arg) 
{
	if(!arg) return 0;
	if(arg=="chls") return 1;
	return 0;
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(8) ) {
		case 0:
		message_vision("$N说道：“这位"+RANK_D->query_respect(ob)+
				"，想吃些什么酒菜？\n",ob);
			break;
		case 1:
		message_vision("$N走过来，亲热地拉着$N的手。\n",ob);
			break;
	}
}
