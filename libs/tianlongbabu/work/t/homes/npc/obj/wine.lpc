// wine.c

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name(MAG"红粉佳人"NOR, ({ "wine" }) );
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long", "一瓶红粉佳人。\n");
		set("unit", "瓶");
		set("value", 100000);
		set("max_liquid", 20);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
        	"name": "红粉佳人",
		"remaining": 20,
		"drunk_apply": 10,
	]) );
}

