// yan.c  by Jane  4.12.1997
#include <ansi.h>
inherit ITEM;

void create()
{
        string *order = ({"大中华","大前门", "都宝", "红塔山", "万宝路", "希尔登", "云烟"});
        set_name( (RED""+order[random(7)])+""NOR, ({ "yan" }) );
        set_weight(80);
	set("new",1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盒香烟，可以(smoke)。\n");
                set("unit", "盒");
		set("count",6);
                set("value", 500);
        }
}

void init()
{
        add_action("do_smoke", "smoke");
}

int do_smoke()
{
        object me = this_player();
        object obj = this_object();

	if(!obj->query("new")) return 1;

        if(environment(me)->query("no_smoke"))
                return notify_fail("这里不准抽烟！\n");

        if( me->is_busy() )
                return notify_fail("你正忙着呢，没空抽烟！。\n");

       	message_vision(YEL"$N抽出一支$n"+YEL"，点着了火，美滋滋地吸了起来。\n"NOR, me, this_object());
	obj->set("no_drop",1);
	obj->set("new",0);
	call_out("smoking",20,me,obj);
	return 1;
}

int smoking(object me, object obj)
{
	if (obj->query("count") == 1 ) {
		message_vision(RED"$N猛吸了一口剩下的烟屁股，两个手不由自主地又去模口袋。\n"NOR, me);
		destruct(this_object());
		return 1;
	} else 
	switch(random(4)) {
		
                case 0: message_vision(YEL"$N吐出一串烟圈，看着它悠闲的散开。\n"NOR, me);
                        break;
                case 1: message_vision(YEL"$N狠狠的吸了一口$n"+YEL"，大概是吸得太猛了，一张脸涨的通红。\n"NOR, me, obj);
                        break;
                case 2: message_vision(YEL"$N吸了一口$n"+YEL"，摇头晃脑地说道：“饭后一支烟，赛过活神仙。”\n"NOR, me, obj );
                        break;
                case 3: message_vision(YEL"$N翘起二郎腿，眯上眼睛，猛吸了一口$n"+YEL"，自言自语道：“这东西害人又害己，为啥我还那么喜欢？”\n"NOR, me, obj);
                        break;
                default:
                        break;
        }
	obj->add("count",-1);
	call_out("smoking",20,me,obj);
	return 1;
}

