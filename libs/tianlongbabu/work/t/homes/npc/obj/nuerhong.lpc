// nuerhong.c

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name("女儿红", ({ "nuer" }) );
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long", "一杯女儿红。\n");
		set("unit", "杯");
		set("value", 2000);
		set("max_liquid", 20);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
        "name": "女儿红",
		"remaining": 20,
		"drunk_apply": 5,
	]) );
}

