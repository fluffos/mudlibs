// sugar.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("喜糖", ({ "sugar" }) );
	set_weight(80);
	set("value", 2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一粒高级喜糖。\n");
                set("unit", "粒");
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{

        if( !arg ) return notify_fail("你要吃什麽？\n");
	if ( !(arg == "sugar") ) return notify_fail("你要吃什麽？\n");
        message_vision("$N拿起一粒高级喜糖吃呀吃，真是好吃极了。\n", this_player());
	destruct(this_object());
	return 1;
}
