// Room: /t/homes/street60.c

inherit ROOM;

void create()
{
	set("short", "花径");
	set("long", @LONG
这是鸳鸯村里的一条小路，路边种满了各种鲜花，有大理名品
茶花，也有从各地移植来的上等花卉如玫瑰，兰花等。再加上这里
四季如春，花香不绝，住在这里真让人觉得心旷神怡。
LONG
	);
	set("exits", ([ /* sizeof() == 5 */
  "southeast" : __DIR__"street70",
  "north" : __DIR__"street50",
  "west" : __DIR__"lanxin",
]));
	set("no_clean_up", 0);

	setup();
}

int valid_leave(object me, string dir) 
{
        object room;
	string dest;

	if(wizardp(me)) return 1;

        if (dir == "west") {
		dest = query("exits/west");
		if(objectp(room = find_object(dest)))
		    if( !room->prevent_enter(me->query("id"))) 
			return 1;

		return notify_fail("你不可以进去。\n");
	}
	return 1;
}

