#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int open;
	object ob;

	if( !arg ) 
		return notify_fail("你要将谁的嘴巴封住？\n");

	if( sscanf(arg, "-o %s", arg) ) 
		open = 1;
	else 
		open = 0;

	if (! wizardp(me))
		return notify_fail("只有天龙使者才能使用这条指令。\n");

        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("咦... 有这个人吗?\n");

	if (!userp(ob) || wizardp(ob))
		return notify_fail("你找的对象是玩家吗？\n");

	if(open) {
		ob->delete("wiz_blk_chat");
		message_vision(YEL"$N走过来将贴在$n嘴巴上的狗皮膏药揭去。" NOR + "\n",me,ob);
		tell_object(ob,"你立即感觉到一顾清新的空气。。。\n");
		log_file("SHUTUP",
		sprintf("%s(%s) OPEN %s chat channel with ip: %s.\n", me->name(),
			me->query("id"), ob->short(1), query_ip_name(me) ) );

	} else {
		ob->set("wiz_blk_chat",1);
		message_vision(YEL"$N冲到$n的面前，大喊一声：“闭嘴”，\n" 
			+ "$N拿出一块狗皮膏药贴在$n嘴上。"NOR+ "\n",me,ob);
		tell_object(ob,"你立即觉得说不出话来。\n");
		log_file("SHUTUP",
		sprintf("%s(%s) CLOSE %s chat channel with ip: %s.\n", me->name(),
			me->query("id"), ob->short(1), query_ip_name(me) ) );

	}
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : shutup <某人>
	封住某人的聊天频道，以及 TELL, whisper, 
	只能对某些说下流话的玩家使用。

	shutup -o <某人>
	解除上述封锁。

HELP
    );
    return 1;
}

		