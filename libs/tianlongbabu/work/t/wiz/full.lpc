// full.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
        int jin, qi, zhili, neili, shiwu, yinshui;

	ob = this_player();

        jin = me->query("max_gin");
        qi =me->query("max_kee");
        zhili = me->query("max_atman");
        neili = me->query("max_force");
        shiwu = me->max_food_capacity();
        yinshui = me->max_water_capacity();
        me->set("eff_gin", jin);
        me->set("eff_kee", qi);
        me->set("gin", jin);
        me->set("kee", qi);
        me->set("atman", zhili);
        me->set("force", neili);
	me->set("bellicosity",0);
	if( !arg ) {
        	me->set("food", shiwu);
        	me->set("water", yinshui);
	} else {
		me->set("food",0);
		me->set("water",0);
	}
	write("ＯＫ！\n");

        return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : full,  此指令可让你恢复所有的精气，相当于 eat dan．
指令格式 : full 0,  此指令可让你恢复所有的精气，但水和食物＝０．:)..

HELP
    );
    return 1;
}

