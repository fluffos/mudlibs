// written by maoyu

int sort_num(object ob1, object ob2)
{
	int inv1, inv2;
	if(environment(ob1))
		inv1 = sizeof(all_inventory(environment(ob1)));
	else
		inv1 = 1;
	if(environment(ob2))
		inv2 = sizeof(all_inventory(environment(ob2)));
	else
		inv2 = 1;

	if(inv1 > inv2)
		return -1;
	else if(inv1 < inv2)
		return 1;
	else
		return 0;
}

int main(object me, string str)
{
        object ob, where, *ob_list, *inv;
        int i, k, f;
	ob_list = sort_array(users(), "sort_num", this_object());
	if(!str)
		f = sizeof(ob_list);
	else if(atoi(str) > sizeof(ob_list))
		f = sizeof(ob_list);
	else
		f = atoi(str);
	for (i=0;i< f;i++) {
		ob=ob_list[i];
		if (!environment(ob)) continue;
		inv = all_inventory(environment(ob));
		if( !sizeof(inv) ) k = 0; else k = sizeof(inv);
		where = environment(ob);
		printf("%-15s%-15s 房间物件数: %d\n",
		(string)ob->name(),
		(string)ob->query("id"),
		k);
	}
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : objtop <数字>

这个指令可以列出所有在线玩家所在房间的物件数量。

HELP
    );
    return 1;
}

