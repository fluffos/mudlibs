// backup.c
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	string src, dst, *dirs, mytime,htime;
	mixed *file;
 
	seteuid(geteuid(me));
	if (!arg || sscanf(arg, "%s", src)!=1 ) return
		notify_fail("指令格式: backup <原档名>\n");

	src = resolve_path(me->query("cwd"), src);
	mytime = replace_string(ctime(time())," ","-");
	htime = replace_string(mytime,"--","-");
	mytime = htime[3..(strlen(htime)-1)];
	dst = src + mytime+".bak";

// Maoyu added here
        file = get_dir(src, -1);
        if( !sizeof(file) ) {
                write("文件不存在。\n");
                return 1;
        }
// end here

	if( file_size(dst)==-2 ) {
		dirs = explode(src, "/");
		dst += "/" + dirs[sizeof(dirs)-1];
	}

	if( cp(src, dst) )
		write("Ok.\n");
	else
		write("你没有足够的读写权利。\n");
	return 1;
}
 
int help(object me)
{
  write(@HELP
指令格式 : backup <原档名>
 
此指令可让你(□)拷贝档案。
HELP
    );
    return 1;
}
 
