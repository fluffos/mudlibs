inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if(!arg)
		return notify_fail("指令格式：unchinese <英文>\n");

	CHINESE_D->remove_translate(arg);
	write("Ok.\n");
	return 1;
}

int help()
{
	write ( @HELP
指令格式：unchinese <英文>
HELP
	);
	return 1 ;
}
