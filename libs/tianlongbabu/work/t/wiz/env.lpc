// last updated by cbra Jun-14-1998 for *.c file

#include <room.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int look_room(object me, object env);

void create() { seteuid(getuid()); }

int main(object me,string arg)
{
	object obj;
	int result;

	if(!arg) 
		result = look_room(me, environment(me));
	 else {
		obj = find_player(arg);
		if(!obj) obj = find_living(arg);
		if(!obj || !me->visible(obj)) 
		{
			arg = resolve_path(me->query("cwd"), arg);
			if(!sscanf(arg, "%*s.lpc")) arg += ".lpc";
			if(obj = find_object(arg))
				return look_room(me, obj);
			else
				return notify_fail("没有这个玩家、生物、或地方。\n");
		}
		if( objectp(obj))
			result = look_room(me, environment(obj));
		else
			return notify_fail("找不到这个人．．．\n");
	}
	return result;
}

int look_room(object me, object env)
{
	int i;
	object *inv;
	mapping exits;
	string str, *dirs;

	if(!env) 
	{
		write("你的四周灰蒙蒙地一片，什麽也没有。\n");
		return 1;
	}
	if (env->is_room()) {

	str = sprintf( "%s - %s\n    %s%s",
		env->query_short(),
		wizardp(me)? file_name(env): "",
		env->query_long(),
		env->query_climate()
			? NATURE_D->outdoor_room_description() : "" );

	if(arrayp(dirs = env->query_exits_names())) 
	{
		if(sizeof(dirs)==0)
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD 
				+ dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s"
				+ NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), 
				dirs[sizeof(dirs)-1]);
	}

	} else {

	str = sprintf( "%s - %s\n    %s%s",
		env->query("short"),
		wizardp(me)? file_name(env): "",
		env->query("long"),
		env->query("outdoors")
			? NATURE_D->outdoor_room_description() : "" );

	if(mapp(exits = env->query("exits"))) 
	{
		dirs = keys(exits);
		for(i=0; i<sizeof(dirs); i++)
			if( (int)env->query_door(dirs[i], "status") 
			& DOOR_CLOSED )
				dirs[i] = 0;
		dirs -= ({ 0 });
		if(sizeof(dirs)==0)
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD 
				+ dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s"
				+ NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), 
				dirs[sizeof(dirs)-1]);
	}

	}
	// str += env->door_description();

	inv = all_inventory(env);
	for(i=0; i<sizeof(inv); i++) 
	{
		if( inv[i]==me ) continue;
		// make item invisible, windf
		if( inv[i]->query("no_show") ) continue;
		if( !me->visible(inv[i]) ) continue;
		str += "  " + inv[i]->short() + "\n";
	}

	this_user()->start_write(str);
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: lookenv <物品>
 
这个指令让你查看你<物品>所在的环境。
 
HELP
);
	return 1;
}
