void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj;
	int result;
	string str;

	// Jane change this to make room or person unvisiable for a while

	if(stringp(str = environment(me)->query("no_look_msg")) )
		return notify_fail(str);

	if(!arg)
		result = look_room(me, environment(me));
	else 
		if((obj = present(arg, me)) 
		|| (obj = present(arg, environment(me))) )
		{
			if(obj->is_character()) 
				result = look_living(me, obj);
			else 
				result = look_item(me, obj);
		} else if(wizardp(me)&& (obj = find_player(arg)) ) 
			result = look_living(me, obj);
		else
			result = look_room_item(me, arg);
	return result;
}

mixed look_room(object me, object env)
{
	int i;
	mapping exits,inv;
	string str, *dirs;

	if(!env) 
	{
		write("你的四周灰蒙蒙地一片，什麽也没有。\n");
		me->move(VOID_OB);
		return 1;
	}
	if (env->is_room()) {

	str = sprintf( "%s - %s\n    %s%s",
		env->query_short(),
		wizardp(me)? file_name(env): "",
		env->query_long(),
		env->query_climate()
			? NATURE_D->outdoor_room_description() : "" );

	if(arrayp(dirs = env->query_exits_names())) 
	{
		if(sizeof(dirs)==0)
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD 
				+ dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s"
				+ NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), 
				dirs[sizeof(dirs)-1]);
	}

	} else {

	str = sprintf( "%s - %s\n    %s%s",
		env->query("short"),
		wizardp(me)? file_name(env): "",
		env->query("long"),
		env->query("outdoors")
			? NATURE_D->outdoor_room_description() : "" );


	str = sprintf( "%s - %s\n    %s%s",
		env->query("short"),
		wizardp(me)? file_name(env): "",
		env->query("long"),
		env->query("outdoors")
			? NATURE_D->outdoor_room_description() : "" );

	if(mapp(exits = env->query("exits"))) 
	{
		dirs = keys(exits);
		for(i=0; i<sizeof(dirs); i++)
			if( (int)env->query_door(dirs[i], "status") 
			& DOOR_CLOSED )
				dirs[i] = 0;
		dirs -= ({ 0 });
		if(sizeof(dirs)==0)
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD 
				+ dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s"
				+ NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), 
				dirs[sizeof(dirs)-1]);
	}
	// str += env->door_description();

	}


//add by spiceboy@Tlbb

 inv = allocate_mapping(sizeof(all_inventory(env)));
    foreach ( object ob in all_inventory(env) )
    {
        if (( ob == me ) || ( !me->visible(ob) ) || ob->query("no_show") )
            continue;
        if ( (living(ob) || interactive(ob) || !ob->query("unit") 
            || ob->is_character()) && ob->query("unit")!="些")
           { 
            str += "    " + ob->short() + "\n";
            continue;
        } 
        if ( ob->query("base_unit") )
           { 
            str += "    " + ob->short() + "\n";
            continue;
            } 
        if ( inv[base_name(ob)] )
        {
            inv[base_name(ob)] += ({ ob });
            if( ob->query("id") != inv[base_name(ob)][0]->query("id")
                || ob->query("name") != inv[base_name(ob)][0]->query("name") )
            {  
             
                inv[base_name(ob)] -= ({ ob });
                str += sprintf("    %s\n",
                ob->short() );
              }
           }   
           else
            inv[base_name(ob)] = ({ ob });
       
    }
    foreach ( string ob in keys(inv) )
     if (! inv[ob][0]->query("base_unit")) 
     if( sizeof(inv[ob])!=1)
        str += sprintf("    %s%s%s\n",
                chinese_number(sizeof(inv[ob])),
                inv[ob][0]->query("unit")?inv[ob][0]->query("unit"):"个",
                inv[ob][0]->short() );
                
   else str += sprintf("    %s\n",inv[ob][0]->short() );         
		            
    write(str);
    return str;

//	me->start_write(str);
//	return 1;
}

