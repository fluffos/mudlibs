int look_item(object me, object obj)
{
	mixed *inv;
	string position;

	write(obj->long());
	inv = all_inventory(obj);
	if( !obj->is_closed() && sizeof(inv)) {
		switch( (string)obj->query("position") ) {
			case "on":
				position = "上";
				break;
			case "under":
				position = "下";
				break;
			case "behind":
				position = "后";
				break;
			case "inside":
				position = "里";
				break;
			default:
				position = "里";
				break;
                        }
		inv = map_array(inv, "inventory_look", this_object() );
		message("vision", sprintf("%s面有：\n  %s\n", position,
			implode(inv, "\n  ") ), me);
	}
	return 1;
}
// change by snow
string getper(object me, object obj)
{
	int per;
	int inte;
	string whom;
	int weight;
	string str;

	per = obj->query_per();
	inte = me->query_int();

	// 灵性差的人看的不准
	if (inte > 35) weight = 0;
	else weight = (int)(35 - inte)/4 ;


	if (random(10)>6) per = per - weight;
	else per = per + weight ;

	
	if ((string) obj->query("gender") == "男性") 
	{
	    if( obj != me ) 
		whom = "他";
	    else
		whom = "你";

		if (per > 30) str = whom + "英俊潇洒，貌似潘安。\n";
		if ((per >= 25) && (per <=30)) 
			str = whom + "相貌出众，百里挑一。\n";
		if ((per >= 19) && (per < 25)) 
			str = whom + "五官端正。\n";
		if (per < 19) 
			str = whom + "相貌平平。\n";
	}
	else {
	    if ( obj != me ) 
		whom = "她";
	    else
		whom = "你";

		if (per > 30)
			str = whom + "美奂绝伦，堪称人间仙子！！！\n";
		if ((per >= 25) && (per <= 30)) 
			str = whom + "有沉鱼落雁之容，避月羞花之貌！！\n";
		if ((per >= 20) && (per < 25)) 
			str = whom + "风情万种，楚楚动人！\n"; 
		if ((per >= 15) && (per < 20))
			str = whom + "相貌平平，还看得过去。\n";
		if (per < 15) 
			str = whom + "的相貌嘛……不看也罢。\n";
	}

	return str;
}

string getpow(object me, object ob)
{
        object weapon;
        string skill_type,parry_type;
        int attack_points;
        if( objectp(weapon = ob->query_temp("weapon")) )
        {
                skill_type = weapon->query("skill_type");
                parry_type = "parry";
        }
        else
        {
                skill_type = "unarmed";
                parry_type = "unarmed";
        }

        attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
//	attack_points = ob->query_skill(skill_type);
        return  power_level(attack_points);
}

int look_living(object me, object obj)
{
	string look_msg, str, pro; //limb_status,
	mixed *inv;
	mapping my_fam, fam;

	if((me != obj) && (!wizardp(me)))
		message("vision", me->name() 
			+ "正盯著你看，不知道打些什麽主意。\n", obj);
	if(wizardp(me)) {
		str = CYN"◇"NOR+ ( environment(obj)->is_room() ?
			environment(obj)->query_short() :
			environment(obj)->query("short") )
			+" -("+file_name(environment(obj))+")\n";
		str += obj->long();
	} else
		str = obj->long();
	str +=  ( (!obj->query("me_long")) ? "" : obj->query("me_long") ) ;
	pro = (obj==me) ? gender_self(obj->query("gender")) : gender_pronoun(obj->query("gender"));

	if((string)obj->query("race") == "人类" && intp(obj->query("age"))) 
	{
		if(obj->query_skill("makeup",1) >=80 ) {
		    if(obj->query("gender") == "女性")
//			str += sprintf("%s长发如云，肌肤胜雪，目如秋水，俏脸生春，妙目含情，看不出有多大年纪。\n",pro);
			str += sprintf("%s长发如云，肌肤胜雪，看不出有多大年纪。\n",pro);
		    else 
//			str += sprintf("%s朱冠玉面，丰姿英伟，气宇轩昂，伟岸英挺，目光炯炯有神，星眉朗目，看不出有多大年纪。\n",pro);
			str += sprintf("%s朱冠玉面，气宇轩昂，看不出有多大年纪。\n",pro);
		} else {
		str += sprintf("%s看起来约%s多岁。\n", pro, 
			chinese_number(obj->query("age") / 10 * 10));
		}
		str += getper(me,obj);
	}

	// change by windf to show power level
	if(wizardp(me) || (!userp(obj))|| me == obj) {
		str += sprintf("武功看上去");
		str += getpow(me,obj);
		str += sprintf("。\n");
	}
	
	// If we both has family, check if we have any relations.
	if( obj!=me
	&&	mapp(fam = obj->query("family"))
	&&	mapp(my_fam = me->query("family")) 
	&&	fam["family_name"] == my_fam["family_name"] ) {
	
		if( fam["generation"]==my_fam["generation"] ) {
			if( (string)obj->query("gender") == "男性" )
				str += sprintf( pro + "是你的%s%s。\n",
					my_fam["master_id"] == fam["master_id"] ? "": "同门",
					my_fam["enter_time"] > fam["enter_time"] ? "师兄": "师弟");
			else
				str += sprintf( pro + "是你的%s%s。\n",
					my_fam["master_id"] == fam["master_id"] ? "": "同门",
					my_fam["enter_time"] > fam["enter_time"] ? "师姐": "师妹");
		} else if( fam["generation"] < my_fam["generation"] ) {
			if( my_fam["master_id"] == obj->query("id") )
				str += pro + "是你的师父。\n";
			else if( my_fam["generation"] - fam["generation"] > 1 )
				str += pro + "是你的同门长辈。\n";
			else if( fam["enter_time"] < my_fam["enter_time"] )
				str += pro + "是你的师伯。\n";
			else
				str += pro + "是你的师叔。\n";
		} else {
			if( fam["generation"] - my_fam["generation"] > 1 )
				str += pro + "是你的同门晚辈。\n";
			else if( fam["master_id"] == me->query("id") )
				str += pro + "是你的弟子。\n";
			else
				str += pro + "是你的师侄。\n";
		}
	}
	if(look_msg = obj->query("look_msg") )
	str += look_msg;

	if( obj->query("max_kee") )
		str += pro + COMBAT_D->eff_status_msg((int)obj->query("eff_kee") * 100 / (int)obj->query("max_kee")) + "\n";

	inv = all_inventory(obj);
	if( sizeof(inv) ) {
		inv = map_array(inv, "inventory_look", this_object(), obj->is_corpse()? 0 : 1 );
		inv -= ({ 0 });
		if( sizeof(inv) )
		    if (obj->is_corpse()) 
			str += sprintf("%s的遗物有：\n%s\n",  pro, implode(inv,"\n") );
		    else 
			 str += sprintf( "%s%s\n", pro, implode(inv, "\n") );
		else
		   if ( !obj->is_corpse() && !wizardp(obj))
			if( obj->query("gender") == "男性" )
			     str += sprintf("%s穿着一条三角裤。\n",pro);
			else if (obj->query("gender") == "女性" )
			     str += sprintf("%s穿着一个红肚兜。\n",pro);
		//	str += sprintf( obj->is_corpse() ? "%s的遗物有：\n%s\n" : "%s身上带著：\n%s\n",
		//		pro, implode(inv, "\n") );
	}else if ( !obj->is_corpse() && !wizardp(obj) && userp(obj)) {
		if( obj->query("gender") == "男性" )
		     str += sprintf("%s穿着一条三角裤。\n",pro);
		else if (obj->query("gender") == "女性" )
		     str += sprintf("%s穿着一个红肚兜。\n",pro);
	}

	message("vision", str, me);

	if( obj!=me 
	&&	living(obj)
	&&	random((int)obj->query("bellicosity")/10) > (int)me->query("per") ) {
		write( obj->name() + "突然转过头来瞪你一眼。\n");
		COMBAT_D->auto_fight(obj, me, "berserk");
	}

	return 1;
}

string inventory_look(object obj, int flag)
{  
   string str=obj->short();
   
  if( obj->query("equipped") ) str = query_equip(obj);
  else if( !flag ) str = "  " + str;
  else return 0;
  return str;
}
string query_equip(object obj)
{
        string str,units;

        units =obj->query("unit");
        str = obj->name();
        if (obj->query("armor_type"))
        switch( obj->query("armor_type") ) {
                case "cloth":
                case "armor":
                        str = "身穿一"+ units + str;
                        break;
                case "boots":
                case "shoes":
                        str = "脚踏一" + units + str;
                        break;
                case "head":
                         str ="头戴着一"+ units + str;
                        break;
                case "neck":
                         str ="颈上有一"+ units + str;
                         break;
                case "wrists":
                         str ="腕子上戴着一"+ units + str;
                        break;
                case "finger":
                         str ="手指上戴着"+ units + str;
                         break;
                case "hands":
                        str ="手上戴着"+ units + str;
                        break;
                case "waist":
                        str = "腰间系着一"+units+str;
                        break;
                default:
                        str = "装备着"+str; 
                        }
        else
        if( obj->wield() )
                if (obj->query("skill_type")=="throwing")
                str ="身上带着"+str;
    else if(obj->query("skill_type")=="sword" || obj->query("skill_type")=="blade")
                str ="手持一" + units + str;
                
    else        str ="双手紧握着一"+ units+str;
        return str;     
}

int look_room_item(object me, string arg)
{
	object env;
	mapping item, exits;
	mixed itt;

	if( !objectp(env = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，什麽也没有。\n");

	if (env->is_room()) {

	if(itt = env->query_item(arg)) {
		if( stringp(itt) )
			write(itt);
		else if( functionp(itt) )
			write((string)(*itt)(me));
			
		return 1;
	}

	if( mapp(exits = env->query_exits()) && !undefinedp(exits[arg]) ) {
		if( objectp(env = find_object(exits[arg])) )
			look_room(me, env);
		else {
			call_other(exits[arg], "???");
			look_room(me, find_object(exits[arg]));
		}
		return 1;
	}

	} else {

	if( mapp(item = env->query("item_desc")) && !undefinedp(item[arg]) ) {
		if( stringp(item[arg]) )
			write(item[arg]);
		else if( functionp(item[arg]) )
			write((string)(*item[arg])(me));
			
		return 1;
	}
	if( mapp(exits = env->query("exits")) && !undefinedp(exits[arg]) ) {
		if( objectp(env = find_object(exits[arg])) )
			look_room(me, env);
		else {
			call_other(exits[arg], "???");
			look_room(me, find_object(exits[arg]));
		}
		return 1;
	}

	}

	return notify_fail("你要看什麽？\n");
}

string power_level(int power)
{

        int lvl = 0, scale = 10;
	float factor = 2.0;
//        int rawlvl;
//        int grade = 1;
        if(power<0) power=0;
/*
        //rawlvl = (int) pow( (float) 1.0 * power, 0.3);
        //lvl = to_int(rawlvl/grade);
	// Old formular used in ES2.
	lvl = power/10;
	if( lvl >= sizeof(power_level_desc) )
		lvl = sizeof(power_level_desc)-1;
*/
	// Jane changed here :D
	while( power /scale > 1 ) {
		lvl++;
		scale = (int)(scale * factor);
		factor = factor - 0.035;
		if (factor < 1.055 )
			factor = 1.055;
	}
	if( lvl >= sizeof(power_level_desc) )
		lvl = sizeof(power_level_desc)-1;
	return power_level_desc[((int)lvl)];
}

int help (object me)
{
	write(@HELP
指令格式: look [<物品>|<生物>|<方向>]
 
这个指令让你查看你所在的环境、某件物品、生物、或是方向。
 
HELP
);
	return 1;
}
