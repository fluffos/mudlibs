inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("玄难", ({ "xuannan" }) );

//	set("nickname", "");
	set("gender", "男性");
	set("age", 60 );
	set("long", "玄难是少林达摩院首坐，只见他满脸皱纹，双目神光湛然，当真神功了得。 \n");
	set("attitude", "peaceful");
	set("str", 26);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);
	set("apprentice_availavble", 3);
	set("force", 70000);
	set("max_force", 40000);
	set("force_factor", 300);

	set("combat_exp", 5000000);
	set("score", 2000000);

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: fight :),
		(: exert_function, "banup" :),
		(: exert_function, "recover" :)
	}) );

	set_skill("force", 290);
	set_skill("unarmed", 150);
	set_skill("blade", 170);
	set_skill("banruo_force", 250);
	map_skill("force", "banruo_force");

	create_family("少林达摩院", 21, "首座");

	setup();

//	carry_object("obj/jie-blade");
//	carry_object("obj/sengyi")->wear();
//	carry_object("obj/sengxie")->wear();
}

void init()
{
	add_action("do_answer", "answer");
}

void attempt_apprentice(object me)
{
	if( me->query_temp("pending/xuannan_answer") ) {
		command("shake");
		return;
	} else {
		command("say 施主如果真愿抛弃红尘，请回答老纳一个问题(answer)。\n");
		command("say 请问施主：“什么是佛？“\n");

		me->set_temp("pending/xuannan_answer", 1);
	}
}

int do_answer(string arg)
{
	if( !this_player()->query_temp("pending/xuannan_answer") )
		return 0;
	if( !arg ) return notify_fail("你要回答什么？\n");
	this_player()->set_temp("pending/xuannan_answer", 0);
	message_vision("$N回答道：" + arg + "\n", this_player());
	if( strsrch(arg, "阿弥陀佛") >=0 ) {
		command("smile");
		command("say 阿弥陀佛，善哉，善哉。\n");
		command("recruit " + this_player()->query("id"));
		

	} else {
		command("shake");
		command("say 看来施主并非真心向往佛法。\n");
	}
	return 1;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		add("apprentice_availavble", -1);
}


int accept_fight(object me)
{
	command("say 出家人练武是为了健身强体，严禁惩强恶斗。阿弥陀佛！\n");
	return 0;
}
