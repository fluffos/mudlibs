// Room: /t/maoyu/beilang.c

inherit ROOM;

void create()
{
	set("short", "白衣殿");
	set("long", @LONG
一进殿门你就被这里凹凸不平的地面所吸引。这里是少林
僧众习演拳法的场所，而殿中砖地的累累凹痕显然是演练拳法
留下的痕迹。只从这地上的凹印，就不难想象少林拳的威力与
神妙。而墙上所绘十三和尚救唐王的壁画，更向世人说明说明
少林寺的渊远的历史，而对少林武术的博大精深禁不住神往。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"gceast",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
