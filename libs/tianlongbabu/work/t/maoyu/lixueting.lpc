// Room: /t/maoyu/beilang.c

inherit ROOM;

void create()
{
	set("short", "立雪亭");
	set("long", @LONG
相传禅宗二祖慧可为向始祖达摩学佛，立于门外苦候，时值天
降大学，纷扬的飞雪直没其膝，慧可依然凝立雪中，岿然不动，不
仅如此为明其志，还自断左臂以示决心。达摩感其诚心，遂将衣钵
授予慧可。后少林僧众建次亭以纪念二祖和这段动人的故事。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"gceast",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
