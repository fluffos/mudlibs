void create()
{
	set("short", "花丛中");
	set("long", @LONG
你信步观赏，只见花林中除山茶花外更无别样花卉，连最常见
的牵牛花，月月红，蔷薇之类也是一朵都无。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"flower4",
  "west" : __DIR__"flower1",
