// Room: /t/murong/road5.c

inherit ROOM;

void create()
{
	set("short", "后院");
	set("long", @LONG
穿过一个半月形的拱门，你来到一座小楼之前。小楼檐下一块匾额，
写着『云锦楼』三个墨绿毫字，楼下前后左右种的都是茶花。但这些茶
花都不过是三四流货色，和这精致的楼阁亭榭相比，未免不衬。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"westroom",
  "south" : __DIR__"road4",
  "north" : __DIR__"yunjing",
  "east" : __DIR__"eastroom",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
