// girl.c

inherit NPC;

void create()
{
        set_name("幽草", ({ "girl" }) );
	set("gender", "女性" );
	set("age", 18);
	set("long",
		"这是一个青衣小鬓，手里拿着一把花儿，看来正在采花儿呢 ....\n");
	set("attitude", "friendly");
	set("rank_info/respect", "幽草姊姊");
	setup();

	carry_object(__DIR__"obj/sha-dress")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() )
 {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}


void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	
	if (ob->query("gender") == "男性" || 
		(string)ob->query("family/family_name") == "大理段氏") {
	      message_vision("幽草神色慌张地对$N说道：这位" + RANK_D->query_respect(ob)
		+ "，你快点走吧，不然被夫人见到了，性命难保。\n",ob);
	} else 
	      say("幽草迎上前来说道：“耐个" + RANK_D->query_respect(ob)
		+ "，过来坐一歇吃杯茶， 阿好？”\n");
}

