#include <ansi.h>

inherit NPC;


void create()
{
	set_name("老妇", ({ "oldwoman" }) );
	set("title", "门房");
	set("gender", "女性" );
	set("age", 60);
	set("str", 29);
	set("cor", 30);
	set("cps", 30);
        set("int", 11);
	set("long",
		"这老妇是曼陀罗山庄的门房，武功高强。\n");
	set("combat_exp", 25000);
	set("attitude", "heroism");

	set("force", 200);
	set("max_force", 200);
	set("force_factor", 15);
	
	set_skill("unarmed", 50);
	set_skill("spicyclaw", 40);
	set_skill("dragon-steps", 40);
	set_skill("dodge", 50);
	set_skill("parry", 90);
	map_skill("unarmed", "spicyclaw");
	map_skill("dodge", "dragon-steps");

	setup();
}

void init()
{
        object ob;

        ::init();
	if( interactive(ob = this_player())) {
		remove_call_out("killing");
		call_out("killing", 1, ob);
        }
}

void killing(object ob)
{

	if( !ob || environment(ob) != environment() )
                return;
	{
                if (ob->query("gender") == "男性" || (string)ob
->query("family/family_name") == "大理段氏") {
			kill_ob(ob);
			ob->kill_ob(this_object());
			say ("老妇嘿嘿说道：你敢私自上岛，违被夫人的手喻，纳命来！n");
	}
}
}
	
