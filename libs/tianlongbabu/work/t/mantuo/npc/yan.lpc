#include <ansi.h>

inherit NPC;


void create()
{
        set_name("严婆婆", ({ "yan" }) );
	set("title", "花肥房总管");
	set("gender", "女性" );
        set("age", 60);
        set("str", 29);
        set("cor", 30);
        set("cps", 30);
        set("int", 11);
        set("long",
		"严婆婆是花肥房总管，专管杀人做肥。\n");
	set("combat_exp", 50000);
	set("attitude", "aggressive");
	
	set("force", 400);
	set("max_force", 400);
	set("force_factor", 25);

	set_skill("blade", 70);
	set_skill("dodge", 80);
	set_skill("parry", 90);
	set_skill("spring-blade", 80);
	set_skill("pyrobat-steps", 60);
	map_skill("blade", "spring-blade");
	map_skill("dodge", "pyrobat-steps");
	map_skill("parry", "spring-blade");

	setup();
	
	carry_object(__DIR__"obj/blade")->wield();
}

