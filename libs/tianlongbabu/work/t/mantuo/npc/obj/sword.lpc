//sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("古松剑", ({ "old-sowrd", "sword" }) );
	set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 2000);
	        set("material", "steel");
		set("long", "这是一把古色斑镧的长剑。\n");
		set("wield_msg", "$N抽出一把古色斑镧的长剑，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
		
	}
        init_sword(24);
        setup();
}

		
