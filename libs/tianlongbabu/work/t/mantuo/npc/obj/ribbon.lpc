// sha-dress.c example cloth

#include <ansi.h>

inherit EQUIP;

void create()
{
        set_name( WHT "银丝带" NOR, ({ "ribbon" }) );
        set_weight(700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("value", 2000);
                set("material", "cloth");
                set("armor_type", "head");
		set("armor_prop/personality", 2);
                set("armor_prop/armor", 3);
		set("female_only", 1);
                set("wear_msg","$N戴上一条$n。\n");
                set("remove_msg","$将$n解了下来。\n");
        }
}

