// yuyan.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("王语嫣", ({ "wang yuyan","wang","yuyan" }) );
	set("title",YEL"人间仙子"NOR);
	set("gender", "女性" );
	set("age", 18);
	set("long",
		"王语嫣是曼陀山庄王夫人的独生女儿，不仅长得\n"+
		"惊世绝艳，而且于各家武学无所不知，武林中人\n"+
		"若能得她指点（ｚｈｉｄｉａｎ）一二，定当终\n"+
		"身受用。\n");
	set("combat_exp", 500);
	set("attitude", "friendly");
	set("per",40);
	set("force", 100);
	set("max_force",100);
	set("force_factor",5);

	set_skill("dodge",20);
	set_skill("literate",100);
	set_skill("parry",20);
	set_skill("unarmed",20);
	
	setup();

	carry_object(__DIR__"obj/color-cloth")->wear();
	carry_object(__DIR__"obj/ribbon")->wear();
}

void init()
{	
	add_action("do_zhidian","zhidian");
}

int accept_object(object who, object ob) 
{
        if (ob->name() == BLU"碧玉发簪"NOR) {
           call_out("do_give", 1, who );
           return 1;
        }
        return 0;
}

void do_give(object me)
{
	command("smile");
	say("王语嫣说道：谢谢这位"+RANK_D->query_respect(me)+"帮我找到了"+BLU"碧玉发簪"NOR+"。\n");
	if(!me->query_temp("王语嫣") ) {
		me->set_temp("王语嫣",1);
		say("王语嫣笑了笑说道：要是你不觉得我这个丫头大言不惭，我可以指点你一二招功夫。\n");
	} else me->add_temp("王语嫣",1);
	return;
}

