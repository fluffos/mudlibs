int do_zhidian(string skill)
{
	object ob = this_object();
	object me = this_player();
	int gin_cost, my_skill;

	if(!me->query_temp("王语嫣"))
		return notify_fail("王语嫣说道：您太客气了，这怎麽敢当？\n");

	if(skill == "yijin-jing")
		return notify_fail("王语嫣叹了气，对你说道：我可不懂易筋经啊！\n");

	if(!SKILL_D(skill)->valid_learn(me)) 
		return notify_fail("王语嫣对你叹了气，说道：你现在还不能学这项技术。\n");

	gin_cost = 150 / (int)ob->query("int") + 150 / (int)me->query("int");

	my_skill = me->query_eff_skill_level(skill, 1);
	if(!my_skill) 
        {
                gin_cost *= 2;
                me->set_skill(skill, 0);
        }
	if((int)me->query("learned_points")  >= (int)me->query("potential"))
                return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");

	printf("你请教%s有关「%s」中的疑问。\n", ob->name(), to_chinese(skill));

	if((int)ob->query("gin") > gin_cost/5 + 1) 
        {
                if(userp(ob)) 
                        ob->receive_damage("gin", gin_cost/5 + 1);
        } else {
                write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
                tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
                return 1;
        }

        if((int)me->query("gin") > gin_cost) 
        {
                if((string)SKILL_D(skill)->type() == "martial"
                && my_skill * my_skill * my_skill / 10  > (int)me->query("combat_exp")) 
                {
                        printf("也许是缺乏实战经验，你对%s的回答总是无法领会。\n", ob->name() );
                } else {
                        printf("你听了%s的指点，似乎有些心得。\n", ob->name());
                                me->add("learned_points", 1);
                                if(me->improve_skill(skill, random(me->query("int")))) {
					if(me->query_temp("王语嫣")>1)
						me->add_temp("王语嫣",-1);
					else { 
						me->delete_temp("王语嫣");
						tell_object(me,"王语嫣说道：总算你的技术有所长进，我也报答了你的辛劳。\n");
					}
				}
                }
        } else {
                gin_cost = me->query("gin");
                write("你今天太累了，结果什麽也没有学到。\n");
        }
        me->receive_damage("gin", gin_cost );

        return 1;
}

void die()
{
        //int i;
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
            killer->set("marks/murder_murong_yuyan", 1);
        message_vision("$N用一种痛苦和失望的眼神看了一眼$n，就闭上了眼睛。",this_object(), killer);

        ::die();
}

