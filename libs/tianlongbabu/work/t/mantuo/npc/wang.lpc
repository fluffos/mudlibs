#include <ansi.h>

inherit NPC;


void create()
{
	set_name("王夫人", ({ "wang" }) );
	set("title", "曼陀罗山庄庄主");
	set("gender", "女性" );
	set("age", 45);
	set("per", 28);
	set("str", 25);
	set("int", 25);
	set("long",
"王夫人是曼陀山庄庄主，年轻时曾经与段正淳有过一段恋情，后来
二人因闹矛盾而分手，王夫人不思己过，一味怨恨段正淳无情，因
此而迁怒于所有的大理人氏，凡是姓段的，或是大理来的，甚至只
要是男人来到曼陀山庄，都会被严惩，甚至做了花肥。没有人知道
王夫人的真正来历，而她家为什么有如此多的武功密籍，简直是一
个解不开的迷。\n");
	
	set("combat_exp", 250000);
	set("attitude", "heroism");
	
	set("force", 2000);
	set("max_force", 2000);
	set("force_factor", 100);
	
	set_skill("sword", 100);
	set_skill("duan-sword", 80);
	set_skill("dodge", 80);
	set_skill("parry", 90);
	set_skill("duan-steps", 60);
	
	map_skill("parry", "duan-sword");
	map_skill("dodge", "duan-steps");
	map_skill("sword", "duan-sword");


	setup();
	carry_object(__DIR__"obj/sword")->wield();

}

