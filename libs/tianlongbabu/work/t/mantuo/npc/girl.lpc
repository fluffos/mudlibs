// girl.c

inherit NPC;

void create()
{
	string *order=({"小兰","小诗","小茗","小翠","小叶","小芳"});
        set_name(order[random(sizeof(order))], ({ "girl" }) );
	set("title","曼陀山庄丫寰");
	set("gender", "女性" );
	set("age", 18);
	set("long",
		"这是一个曼陀山庄的丫寰，手里拿着一把花儿，看来正在采花儿呢 ....\n");
	set("attitude", "friendly");

	set_skill("unarmed",30);
	set_skill("dodge",30);
	set_skill("force",30);

	set("max_force",200);
	set("force",200);

	set("combat_exp",1000+random(10)*1000);

	setup();
	carry_object(__DIR__"obj/sha-dress")->wear();
}
