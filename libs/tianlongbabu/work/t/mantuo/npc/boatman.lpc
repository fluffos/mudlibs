//fishman.c

inherit NPC;



void create()
{
        set_name("船夫", ({ "man" }) );
	set("gender", "男性" );
        set("age", 65);
	set("per",18);
        set("str", 20);
        set("int", 22);
        set("long",
		"一个老船夫，靠给人摆渡为生。十文钱一渡。\n" );
	set("combat_exp", 50000);
        set("attitude", "friendly");
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",40);
	set("unarmed",50);
	set_skill("dodge", 40);
	set_skill("parry", 40);


	setup();

	carry_object("/obj/cloth")->wear();
}

