//zhang.c

inherit NPC;



void create()
{
        set_name("张连雄", ({ "zhang" }) );
	set("gender", "男性" );
        set("age", 35);
        set("str", 25);
        set("int", 22);

	set("combat_exp", 50000);
        set("attitude", "friendly");
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",40);
	set("unarmed",50);
	set_skill("dodge", 40);
	set_skill("parry", 40);


	setup();

	carry_object("/obj/cloth")->wear();
}

