// Room: /t/murong/flower4.c

inherit ROOM;

void create()
{
	set("short", "花丛中");
	set("long", @LONG
你信步观赏，只见花林中除山茶花外更无别样花卉，连最常见
的牵牛花，月月红，蔷薇之类也是一朵都无。走出数十丈后，只见
山茶品种渐多，偶而也有一两本还算不错，却也栽种不得其法。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "northeast" : __DIR__"gate",
  "south" : __DIR__"flower2",
  "west" : __DIR__"flower6",
  "east" : __DIR__"flower5",
]));
	set("objects", ([
	__DIR__"npc/girl" : 2,
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
