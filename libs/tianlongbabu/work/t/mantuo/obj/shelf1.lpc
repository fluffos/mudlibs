//shelf1.c

inherit ITEM;

void create()
{
        set_name("书架", ({ "_bookshelf_", "bookshelf", "书架" }));
        set_weight(100);
	set_max_encumbrance(8000);
	set("no_show", 1);
	set("no_get", 1);

        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("prep", "on");
		set("unit", "个");
                set("long",
			"这似乎是一个巨大的书架，上面放着各种武功秘籍\n");
                set("value", 260);
	 }

}

int is_container() { return 1; }

