// force_book.c

inherit ITEM;

void create()
{
        set_name("旧书", ({ "book" }));
	set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", 
			"这是一本旧书，上面写着一些修练内功的口诀。\n");
		set("skill", ([
                "name":         "force", 
		"exp_required": 0,                
                "sen_cost":     20,     
                "difficulty":   20,            
                "max_skill":    10           
        ]) );
	}
}


