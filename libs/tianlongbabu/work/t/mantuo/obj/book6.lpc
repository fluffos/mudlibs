inherit ITEM;

void create()
{
        set_name("『招架之术』", ({ "book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这是一本修练基本招架的书籍。\n");
                set("skill", ([
                	"name":         "parry",
                	"exp_required": 30000,
                	"sen_cost":     25,
                	"difficulty":   25,
                	"max_skill":    30
        	]) );
        }
}

