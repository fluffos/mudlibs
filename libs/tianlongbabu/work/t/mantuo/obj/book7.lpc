// force_book.c

inherit ITEM;

void create()
{
        set_name("『内功心法』", ({ "book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这是一本修练基本内功的书籍。\n");
                set("skill", ([
                	"name":        "force",
                	"exp_required": 30000,
                	"sen_cost":     25,
                	"difficulty":   25,
                	"max_skill":    30
        	]) );
        }
}

