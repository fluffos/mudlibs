// Room: /t/murong/garden.c

inherit ROOM;

void create()
{
	set("short", "后花园");
	set("long", @LONG
后花园和庄中其它地方一样种满了山茶花，参杂在假山巨石，绿
竹小溪中，此所谓：『千呼万唤始出来，犹报琵琶半遮面』，更增姿
媚。抬头望去，只见藏书阁的窗户半开着，一根古藤蜒伸在墙上。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  	"south" : __DIR__"yunjing",
]) );
	set("objects",([
  	__DIR__"npc/girl" : 2,
]));

	set("item_desc", ([
		"wall": "一堵光墙，一根古藤(teng)蜒伸在墙上。\n",
        	"墙": "一堵光墙，一根古藤(teng)蜒伸在墙上。  \n",
	]) );
	setup();
}


void init()
{
	add_action("climbing", "climb");
}

int climbing(string arg)
{

//object obj;
        object ob;
        object me;
        ob = this_player();
        if(!arg || arg=="")
        {
		write("你要爬什么？\n");
                return 1;
        }
	if( arg == "teng" || arg == "古藤" )
	{
        me = this_player();
		message_vision("$N四肢并用, 顺藤爬了上去..！\n", me);
		if(me->query_skill("dodge") > 60) {
			me->move(__DIR__"bookhouse");
			message_vision("$N“吱啦”一声，从窗户中翻了进去！\n", me);
			 return 1;
		 }
		message_vision("$N“轰隆”一声掉了下去！\n", me);
			return 1;
	}

	else
		{
			write("你不可以爬"+arg+"\n");

                return 1;

        }
}


