// Room: /t/murong/road4.c

inherit ROOM;

void create()
{
	set("short", "小径");
	set("long", @LONG
一条曲曲折折用鹅卵石铺成的小径，路两旁绿柳成阴，
一处处山石花木点缀在其中。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"road5",
  "south" : __DIR__"front",
  "eastup" : __DIR__"bridge2",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
