// Room: /t/murong/house3.c

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "庄门");
	set("long", @LONG
你转过一丛茂密的花丛，猛然间，只见一座红檐绿瓦，小巧玲珑
的庄院矗利在灿澜的花丛中。庄门大匾上赫然写着『曼陀罗山庄』五
个金光闪闪的大字。 一边的花丛中竖着一块牌子(sign)　
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"front",
  "southwest" : __DIR__"flower4",
]));
	set("item_desc", ([
		"sign": (: look_sign :),
	]) );
	set("objects", ([
		__DIR__"npc/guard" : 1,
	]) );
	setup();
}


string look_sign(object me)
{
	return "模牌上写著：大理段氏, 男子, 杀无赦!。\n";
}

