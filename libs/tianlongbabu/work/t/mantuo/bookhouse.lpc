// Room: /t/murong/bookhouse.c

inherit ROOM;

void create()
{
	set("short", "琅寰福地");
	set("long", @LONG
这里是曼陀罗山庄的藏书阁，天下武功皆荟粹与此，包罗万象，
可与『燕子坞』的藏书相辟敌。 屋子四周全是一排排高大的书架。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "down" : __DIR__"yunjing",
]));
	set("objects", ([
	__DIR__"npc/yuyan" : 1,
        __DIR__"obj/shelf1" : 1,
]) );


	setup();
}

void reset()
{
        object con, item;
	object *inv;
	int i;

        ::reset();
        con = present("_bookshelf_", this_object());
	inv = all_inventory(con);
	for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
	i = random(5)+6;
	item = new(__DIR__"obj/book"+i);
	item->move(con);
}
