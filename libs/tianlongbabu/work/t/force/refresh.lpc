// refresh.c

inherit SSERVER;

int exert(object me, object target, int cost)
{
	int imp;

	if(target != me) return notify_fail(auto_code(this_user(), "你只能用内功收敛自己的心神。\n"));

	//if(cost == -1) cost = 20;
	if(!cost) return notify_fail(auto_code(this_user(), "指令格式：exert refresh <内力>\n"));
	else if(cost < 20)
		return notify_fail(auto_code(this_user(), "最少用二十点内力。\n"));

	if((int)me->query("force") < cost)
		return notify_fail(auto_code(this_user(), "你的内力不够。\n"));

	imp = cost / 20 * (10 + (int)me->query_skill("force")/10);
	me->receive_heal("gin", imp);
	me->add("force", -cost);

	me->improve_skill("force", random(cost/200), 1);

	if(!me->query("env/no_msg"))
		message_vision("$N略一凝神，吸了口气，精神看起来清醒多了。\n", me);

	if(me->is_fighting()) me->start_busy(1);

	return 1;
}
