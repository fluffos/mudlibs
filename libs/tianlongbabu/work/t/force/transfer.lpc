// transfer.c

#include <ansi.h>

inherit SSERVER;

int exert(object me, object target)
{
        int force;//, trans;

        if( !target || target==me || !living(target) )
                return notify_fail(auto_code(this_user(), "你要将真气传给谁？\n"));

        if( (string)me->query_skill_mapped("force") != 
target->query_skill_mapped("force") )
                return notify_fail(auto_code(this_user(), target->name() + 
"所使用的内功和你不同。\n"));

        if( (int)me->query("force") <= (int)me->query("max_force") )
                return notify_fail(auto_code(this_user(), "你的真气不足。\n"));

        force = me->query("force") - me->query("max_force");

        if( force/2 < 1 ) return notify_fail(auto_code(this_user(), "你的真气不足。\n"));
        me->add("force", - force / 2 );
        message_vision("$N将手掌贴在$n背心，运气将体内真气传送过去。\n", me, 
target);
        if( random(force/3) > (int)me->query_skill("force") )
                return notify_fail(auto_code(this_user(), "你失败了。\n"));
	if( target->query("force") + force/3 > target->query("max_force") * 2 ){
		tell_object(target, HIY "你觉得一股热气从" + me->name() +
			"的手掌传了过来。\n" NOR);
		tell_object(target, "你的内息遍布了全身经脉，却没有功力提升"
			"的迹象，似乎内力修为已经遇到了瓶薄n");
		target->set("force",target->query("max_force"));
		return 1;
	} else {
        	target->add("force", force/3);
        	write("Ok.\n");
        	tell_object(target, HIY "你觉得一股热气从" + me->name() + 
			"的手掌传了过来。\n" NOR);
        	return 1;
	}
}
 
