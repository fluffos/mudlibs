// honey.c
// last update by cbra Setp-14-1998 for max 1500 check

inherit ITEM;

void create()
{
	set_name("蜂王浆",({"honey"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	    set("long",
		"一滴蜂王浆。\n");
	    set("unit","滴");
	    set("value", 10000);
	}
}

void init()
{
	add_action("do_eat","eat");
}

int do_eat(string arg)
{
	object me;

	if (!arg || arg!="honey") return 0;

	me=this_player();
	if( !me->query_skill("force")||
	    (!stringp(me->query_skill_mapped("force")) ) ) {
		message_vision("$N吃下一滴甜甜的蜂王浆，啊！好吃极了！\n",me);
		destruct(this_object());
		return 1;
	}
		
	if(me->is_fighting())
	    return notify_fail("战斗中不能吃这东西!\n");
	if (!(me->query("max_force"))) {
	    me->set("max_force",1);
	} 
	//else if (me->query("max_force")>1500) { change by cbra Dec 07,1998
	else if (me->query("max_force")>100) {
		message_vision("$N吃下一滴蜂王浆，只觉得丹田热烘烘的！\n",me);
	}
	else {
//	    me->add("max_force",1);
		message_vision("$N吃下一滴蜂王浆，只觉得丹田热烘烘的！\n",me);
//		message_vision("$N的内力增加了。\n",me);
	}

	destruct(this_object());
	return 1;
}
