// table.c

inherit ITEM;

void create()
{
        set_name("书桌", ({ "_table_", "table", "书桌" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("no_show",1);
                set("no_get",1);
		set("position","on");
                set("long", "一张红木大书桌。\n");
                set("value", 1);
        }
}


