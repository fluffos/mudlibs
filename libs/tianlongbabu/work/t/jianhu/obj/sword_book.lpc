// wuliang sowrd book

inherit ITEM;

void create()
{
        set_name("「无量剑法入门」", ({ "swordbook" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这是一本介绍无量剑剑法的入门书籍。\n");
                set("skill", ([
                	"name":         "wuliang-sword",
                	"exp_required": 1000,
                	"sen_cost":     20,
                	"difficulty":   20,
			"exp_factor":	3,
                	"max_skill":    30
        		]) );
        }
}

