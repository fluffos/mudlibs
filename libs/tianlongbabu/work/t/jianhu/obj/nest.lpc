// nest.c

inherit ITEM;

void create()
{
        set_name("蜂巢", ({ "_nest_", "nest", "蜂巢" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("no_show",1);
                set("no_get",1);
		set("look_msg","在蜂巢的里面有：");
		set("get_msg","$N趁蜂王不注意，偷偷地从大蜂巢上采下一滴$n。\n");
		set("no_put","蜂巢上爬满了蜜蜂，你想自找麻烦么？\n");
                set("long", "一个大蜂巢，上面爬满了蜜蜂。\n");
                set("value", 1);
        }
}


