// rou.c
// last_update 4.2.1997 jane

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name( "龙肉", ({ "rou", "龙肉"}) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "天上龙肉\n");
                set("unit", "块");
		set("value", 50000);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();

        if( !arg ) return 0;
	if ( !(arg == "rou") ) return 0;
	me->set("food", 1000);
	me->set("water", 1000);
        message_vision("$N拿起龙肉吃了下去，顿时觉得肚子里胀得难受。\n", this_player());

	destruct(this_object());
	return 1;
}
