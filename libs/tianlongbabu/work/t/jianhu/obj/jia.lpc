// jia.c

inherit ITEM;

void create()
{
        set_name("穿山甲", ({ "jia" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一条穿山甲。\n");
                set("unit", "条");
                set("value", 0);
        }
}

