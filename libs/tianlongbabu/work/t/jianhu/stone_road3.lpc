// Room: /open/jane/sword_lake/stone_road1.c

inherit ROOM;

void create()
{
	set("short", "青石小路");
	set("long", @LONG
这是由青石铺成的小路，路面上夹杂着一些泥沙，小路两边
长着一些野草，开出来的野花飘着阵阵花香。
LONG
	);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
