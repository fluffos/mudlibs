// Room: /t/jianhu/road2.c

inherit ROOM;

void create()
{
	set("short", "泥土路");
	set("long", @LONG
这是一条山坡下的小路，路边长着一些野草。几朵小小的野花
飘着陈陈芳香。时儿能见到几株小树丛。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "southeast" : __DIR__"road1",
  "southup" : __DIR__"road",
  "northup" : __DIR__"road3",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/fly" : 2,
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
