// Room: /t/jianhu/rock4.c

inherit ROOM;

void create()
{
	set("short", "岩边");
	set("long", @LONG
这里是渊涯绝壁，山谷深不见底，只见云雾缭绕，飘浮于半
山腰。周围是光秃秃的岩石，几根杂草生在岩缝之中。
LONG
	);

        set("exits", ([ /* sizeof() == 1 */
        "east" : __DIR__"forest3",
]));
	set("maze",1);
	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("do_jump", "jump");
        add_action("do_jump", "跳");

}


int do_jump(string arg)
{
        //object obj;
        object me;

        me = this_player();
	if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不能移动。\n");
        if(!arg || arg=="")
        {
                write("你跳什么？\n");
                return 1;
        }
        if( arg == "down" || arg == "下" || arg == "下去")
        {
        tell_object(me,"你一纵身，跳下渊涯。\n");
        tell_object(me,"只听得耳边风声响，你如断线的风筝往下掉！！\n");
	me->start_busy(3);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
        else
        {
                write("你不可以往"+arg+"跳\n");
                return 1;
        }
}

int fliping(object me)
{
	me->move("/t/yubigong/valley.lpc");
           me->set_temp("no_death",1);
		me->set_temp("last_damage_from",0);
        me->die();
        return 1;
}

