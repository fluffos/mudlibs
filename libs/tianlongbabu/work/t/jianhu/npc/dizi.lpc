// gong.c

inherit NPC;

void create()
{
        set_name("无量剑第子", ({ "dizi" }) );
        set("gender", "男性" );
        set("age", 19 + random(20) );
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
	create_family("无量剑", 92, "第子");

        set("max_force", 500);
        set("force", 500);
        set("force_factor", 30);

        set("combat_exp", 50000 + random(20) * 10000);

        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("move", 100);
        set_skill("force", 100);
	set_skill("sword", 60);
	set_skill("wuliang-sword",40);
	set_skill("wuliang-steps",50);

        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");
	map_skill("dodge", "wuliang-steps");
	map_skill("move", "wuliang-steps");

        setup();

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();
}

