#include <ansi.h>
inherit NPC;

void create()
{
        set_name("小蚊子", ({ "wenzi" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只尖嘴细腿的小蚊子\n");

	set("combat_exp",5000);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("leave_msg","飞走了");
        set("arrive_msg","带着“嗡嗡”的声音飞了过来");
        set("kill_msg",RED"$N在$n的头上飞来飞去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N在$n的身边飞来飞去，看来是想咬$n。\n"NOR);

        set("attitude", "killer");
        set("bellicosity", 1000 );

        set_skill("dodge", 100);

        setup();
}

