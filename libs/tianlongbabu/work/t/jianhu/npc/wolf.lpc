// mind_beast.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("巨狼", ({ "wolf" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 3);
	set("long", "这是一只凶猛无比，半人多高的巨狼\n");
	
	set("str", 48);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 900);
	set("attitude", "killer");
	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

        set("kill_msg",RED"$N恶狠狠地围着$n转来转去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N不怀好意地在$n的身边转来转去，看来是想咬$n。\n"NOR);

	set("combat_exp", 40000);
	set("bellicosity", 3000 );
	
	set_temp("apply/attack", 60);
	set_temp("apply/armor", 40);

	setup();
}

void unconcious()
{
        this_object()->die();
}

