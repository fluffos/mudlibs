inherit NPC;

void create()
{
        set_name("巨赤龙", ({ "dragon" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一条张牙舞爪的巨赤龙\n");

        set("str", 80);
        set("cor", 82);
        set("cps", 62);
	set("int", 50);

        set("max_kee",4000);
        set("eff_kee",4000);
	set("kee",4000);
	set("max_gin",2000);
	set("gin",2000);
        set("max_force",4000);
        set("eff_force",4000);
	set("force",4000);
        set("force_factor",100);


        set_skill("dodge", 1000);
        set_skill("move", 500);
        set_skill("unarmed",160);
        set_skill("dragon_bite",160);
        set_skill("force",100);
        set_skill("parry",100);

        map_skill("unarmed","dragon_bite");
        map_skill("parry","dragon_bite");

        set_temp("apply/armor", 100);

	set("combat_exp",7000000);

        set("limbs", ({ "头部", "身体","龙爪", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 20000 );

        setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

void die()
{
        object bonus;

	bonus = new("/t/jianhu/obj/rou");
	bonus->move(this_object());

        ::die();
}

void unconcious()
{
        this_object()->die();
}

