// gong.c

inherit NPC;

void create()
{
        set_name("吴光胜", ({ "wu" }) );
        set("gender", "男性" );
        set("age", 39);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
	create_family("无量剑", 92, "第子");

        set("max_force", 200);
        set("force", 200);
        set("force_factor", 10);

        set("combat_exp", 80000);

        set_skill("unarmed", 40);
        set_skill("parry", 50);
        set_skill("dodge", 50);
        set_skill("move", 50);
        set_skill("force", 50);
	set_skill("sword", 50);
	set_skill("wuliang-sword",40);
	set_skill("wuliang-steps",40);

        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");
        map_skill("dodge", "wuliang-steps");
        map_skill("move", "wuliang-steps");

        setup();

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();

}

