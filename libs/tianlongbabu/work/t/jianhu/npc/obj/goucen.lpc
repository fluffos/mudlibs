// goucen.c 

inherit ITEM;

void create()
{
        set_name("狗参", ({ "goucen" }) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "一条狗参。\n");
                set("value", 0);
                set("material", "meat");
        }
        setup();
}

