// hubian.c 

inherit ITEM;

void create()
{
        set_name("虎鞭", ({ "hubian" }) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "一条虎鞭。\n");
                set("value", 0);
                set("material", "meat");
        }
        setup();
}

