#include <ansi.h>

inherit NPC;

void create()
{
        set_name("小花猫", ({ "cat" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只活泼可爱的小花猫\n");

	set("combat_exp",2000);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("arrive_msg","“喵～ 喵～”地叫着跑了过来");
        set("leave_msg","“喵～ 喵～”地叫着跑开了");
        set("kill_msg",RED"$N恶狠狠地围着$n转来转去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N不怀好意地在$n的身边转来转去，看来是想咬$n。\n"NOR);

        set("attitude", "friendly");
        set("bellicosity", 100 );

        set_skill("dodge", 100);
        set_skill("move", 100);

        setup();
}

void init()
{
	object ob;

        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 2, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;

	if( userp(ob) )
	    message_vision("小花猫看见$N走过来，叫了声：喵～～\n",ob);
	return;
}

int accept_object(object who, object ob) {
        int i = 20, diff_kee;

        if (ob->query("food_remaining") && ob->query("value")) {
                message_vision("$N拿出" + ob->short() + "给$n。\n", who, this_object());
                command("smile " + who->query("id"));
                message_vision("小花猫将"+ob->name()+"吃得干干尽尽！\n", who);
                message_vision("小花猫幸福地躺在$N怀里，叫了声：喵～～\n", who);
                if((diff_kee = who->query("max_kee")-who->query("eff_kee"))<0){
                    if( diff_kee < i )  i = diff_kee;
                    who->add("eff_kee",i);
                }
                if ( environment()->query("short") == "小湖边" ) 
                        set_leader(who);
                return 1;
        }
	return 0;
}

