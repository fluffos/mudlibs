#include <ansi.h>
inherit NPC;

void create()
{
        set_name("蝴蝶", ({ "butterfly" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只美丽的小蝴蝶\n");

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

	set("combat_exp",2000);
        set_skill("dodge", 250);

        set("kill_msg",RED"$N在$n的头上飞来飞去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N在$n的身边飞来飞去，看来是想咬$n。\n"NOR);

        setup();
}
