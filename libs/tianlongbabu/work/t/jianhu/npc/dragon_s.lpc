inherit NPC;

void create()
{
        set_name("小青龙", ({ "dragon" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一条张牙舞爪的小青龙\n");

        set("str", 60);
        set("cor", 62);
        set("cps", 42);
	set("int", 40);

	set("max_kee",2000);
	set("eff_kee",2000);
	set("kee",2000);
	set("max_gin",1000);
	set("gin",1000);
	set("max_force",2000);
	set("eff_force",2000);
	set("force",2000);
	set("force_factor",50);

        set_skill("dodge", 600);
        set_skill("move", 300);
        set_skill("unarmed",100);
        set_skill("dragon_bite",100);
        set_skill("force",100);
        set_skill("parry",100);

        map_skill("unarmed","dragon_bite");
        map_skill("parry","dragon_bite");

//        set_temp("apply/attack", 8000);
        set_temp("apply/armor", 100);
//	set_temp("apply/damage",20);

	set("combat_exp",2000000);

        set("limbs", ({ "头部", "身体","龙爪", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 10000 );


        setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

void die()
{
        object bonus;

	bonus = new("/t/jianhu/obj/rou");
	bonus->move(this_object());

        ::die();
}

void unconcious()
{
        this_object()->die();
}

