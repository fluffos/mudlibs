// gong.c

inherit NPC;

void create()
{
        set_name("褚叶明", ({ "zhu" }) );
        set("gender", "男性" );
        set("age", 29);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
        set("long","褚叶明是无量剑西宗的好手，在附近颇有点名气。\n");
	create_family("无量剑", 92, "第子");

        set("max_force", 2000);
        set("force", 2000);
        set("force_factor", 100);

        set("combat_exp", 1000000);

        set_skill("unarmed", 200);
        set_skill("parry", 100);
        set_skill("dodge", 200);
        set_skill("move", 100);
        set_skill("force", 200);
	set_skill("sword", 100);
	set_skill("wuliang-sword",70);
	set_skill("wuliang-steps",90);
        set_skill("literate", 70);

        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");
	map_skill("dodge", "wuliang-steps");
	map_skill("move", "wuliang-steps");

        setup();

        add_money("gold",1);

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();

}

