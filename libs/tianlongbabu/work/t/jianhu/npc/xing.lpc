// gong.c

inherit NPC;

void create()
{
        set_name("辛双清", ({ "xing" }) );
        set("gender", "女性" );
        set("age", 34);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
        set("long","辛双清是无量剑的西宗掌门人，无量剑使得出神入化。\n");
	create_family("无量剑", 91, "西宗掌门");
	set("rank_info/respect", "辛道长");

        set("max_force", 3000);
        set("force", 3000);
        set("force_factor", 80);

        set("combat_exp", 1500000);

        set_skill("unarmed", 150);
        set_skill("parry", 100);
        set_skill("dodge", 200);
        set_skill("move", 200);
        set_skill("force", 200);
	set_skill("sword", 130);
	set_skill("wuliang-sword",120);
	set_skill("wuliang-steps",120);
        set_skill("literate", 70);

        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");
        map_skill("dodge", "wuliang-steps");
        map_skill("move", "wuliang-steps");

        setup();

        add_money("gold",1);

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();

}

