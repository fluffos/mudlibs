#include <ansi.h>
inherit NPC;

void create()
{
        set_name("小花狗", ({ "dog" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一只讨人喜欢的小花狗\n");

	set("combat_exp",5000);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

	set("arrive_msg","蹦蹦跳跳地跑了过来");
	set("leave_msg","蹦蹦跳跳地跑着离开了");
        set("kill_msg",RED"$N恶狠狠地围着$n转来转去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N不怀好意地在$n的身边转来转去，看来是想咬$n。\n"NOR);

        set("attitude", "friendly");
        set("bellicosity", 100 );

        set_skill("dodge", 400);
        set_skill("move", 200);

        setup();
}

void init()
{
        object ob;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 2, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) 
	     return;

	if( userp(ob) )
	     message_vision("小花狗摇着尾巴，过来舔了舔$N的脚背。\n",ob);
}

int accept_object(object who, object ob) {
	int i = 20, diff_kee;
	object obj;

	if (ob->query("food_remaining") && ob->query("value")) {
		message_vision("$N拿出" + ob->short() + "给$n。\n", who, this_object());
                command("smile " + who->query("id"));
		message_vision("小花狗将"+ob->name()+"吃得干干尽尽！\n", ob);
                message_vision("小花狗摇了摇尾巴，用舌头舔了舔$N的脚。\n", who);
		if((diff_kee = who->query("max_kee") - who->query("eff_kee"))<0){
		    if( diff_kee < i )  i = diff_kee;
		    who->add("eff_kee",i);
		    message_vision("$N感觉舒服极了。\n", who); 
		}
        	if ( environment()->query("short") == "小湖边" ) 
             		set_leader(who);
		if(!present("goucen") ) {
			obj = new(__DIR__"obj/goucen");
			obj->move(this_object());
		}
                return 1;
        }
	return 0;
}

