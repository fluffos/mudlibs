inherit NPC;

void create()
{
        set_name("龙王", ({ "dragon" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一条张牙舞爪的龙王\n");

        set("str", 100);
        set("cor", 80);
        set("cps", 70);
	set("int",50);

        set("max_kee",5000);
        set("eff_kee",5000);
	set("kee",5000);
	set("max_gin",2500);
	set("gin",2500);
        set("max_force",5000);
        set("eff_force",5000);
	set("force",5000);
        set("force_factor",130);


        set_skill("dodge", 1300);
        set_skill("move", 600);
        set_skill("unarmed",190);
        set_skill("dragon_bite",190);
        set_skill("force",100);
        set_skill("parry",100);

        map_skill("unarmed","dragon_bite");
        map_skill("parry","dragon_bite");

//      set_temp("apply/attack", 5000);
        set_temp("apply/armor", 100);

	set("combat_exp",10000000);

        set("limbs", ({ "头部", "身体","龙爪", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 25000 );

        setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

void die()
{
        object bonus;

	bonus = new("/t/jianhu/obj/rou");
	bonus->move(this_object());

        ::die();
}

void unconcious()
{
        this_object()->die();
}

