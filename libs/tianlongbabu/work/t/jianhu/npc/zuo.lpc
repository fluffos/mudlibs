// gong.c
inherit NPC;

string kill_passenger(object who);

void create()
{
        set_name("左子穆", ({ "zuo" }) );
        set("gender", "男性" );
        set("age", 44);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
        set("long","左子穆是无量剑的东宗掌门人，无量剑使得出神入化。\n");
	create_family("无量剑", 91, "东宗掌门");
	set("rank_info/respect", "左掌门");
	set("marks/左子穆", 1);

        set("max_force", 3000);
        set("force", 3000);
        set("force_factor", 80);
        set("max_atman", 2000);
        set("atman", 2000);

        set("combat_exp", 2000000);

        set_skill("unarmed", 150);
        set_skill("parry", 100);
        set_skill("dodge", 200);
        set_skill("move", 200);
        set_skill("force", 200);
	set_skill("sword", 140);
	set_skill("wuliang-sword",130);
	set_skill("wuliang-steps",130);
        set_skill("literate", 70);

        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");
	map_skill("dodge", "wuliang-steps");
	map_skill("move", "wuliang-steps");

        setup();

        add_money("gold",1);

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() && userp(ob)) {
//                remove_call_out("greeting");
                call_out("greeting",1 , ob);
        }
}

void greeting(object ob)
{
        object book, kid, sword;

        if((int) ob->query("marks/murder_zuo") == 0)
        {
            if( (int) ob->query("marks/左山山") == 0 )
                say( "左子穆说道：“这位"+ RANK_D->query_respect(ob)
		    +"，快去帮我把山山救回来，我重重有谢！” \n");
            else if( objectp( kid = present("shanshan",environment(this_object())) ) ) {
/*
		if( !userp(kid) && kid->query_leader()==ob ) {
*/
		if( !userp(kid) ) {
            	    say( "左子穆说道：“这位"+ RANK_D->query_respect(ob)
			+"，多谢你答救小儿山山。” \n");
		    if(ob->query("quest/quest")=="左山山"&&
			// ob->query("task_time") <  time() &&  // How to get time()??
			ob->query("quest/quest_type")=="救"){
			say("左子穆说道：“请代我向尊师"+ob->query("family/master_name")+"道谢！”\n");
			ob->add("score",10+random(10));
			ob->set("quest",0);
		    }  
            	    say( "左子穆说道：“这口剑，这本密笈赠于"+ RANK_D->query_respect(ob)
			+"。” \n");
            	    say( "左子穆抱着山山回家休息去了。” \n");
	
            	    ob->set("marks/左山山", 0);
            	    sword = new(__DIR__"obj/biyu");
            	    book = new(__DIR__"obj/sword_book2");
            	    sword->move(ob);
            	    book->move(ob);
            	    // Changed by jane
            	    ob->add("combat_exp", random(100) + 10 );
            	    ob->add("potential",random(100) + 10 );
	    	    destruct( kid );
               }
            } else 
		 say( "左子穆说道：“这位"+ RANK_D->query_respect(ob)
			+"，你把小儿山山带到什么地方去了？快把他带来！”\n");
     	}
     	else
        	call_out("killhim",1,ob);
}

void killhim(object ob)
{
        ob->set("marks/murder_zuo", 0);
        ob->set("marks/左山山", 0);

	message_vision("左子穆指着$N骂道：你竟敢杀我儿子，纳命来吧！\n", ob);

	set_temp("apple/bellicosity",5000);
        set_temp("apply/force",8000);
        set_temp("apply/force_factor", 150);
        set_temp("apply/damage", 350);
        kill_ob(ob);
        ob->kill_ob(this_object());
}

