// gong.c

inherit NPC;

void create()
{
        set_name("容子矩", ({ "rong" }) );
        set("gender", "男性" );
        set("age", 44);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "friendly");
        set("long","容子矩是无量剑高手，无量剑使得出神入化。\n");
	create_family("无量剑", 91, "第子");

        set("max_force", 3000);
        set("force", 3000);
        set("force_factor", 40);

        set("combat_exp", 1800000);

        set_skill("unarmed", 150);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("move", 100);
        set_skill("force", 200);
	set_skill("sword", 100);
	set_skill("wuliang-sword",100);
	set_skill("wuliang-steps",110);
        set_skill("literate", 70);

	map_skill("dodge", "wuliang-steps");
	map_skill("move", "wuliang-steps");
        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");

        setup();

        add_money("gold",1);

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();

}

