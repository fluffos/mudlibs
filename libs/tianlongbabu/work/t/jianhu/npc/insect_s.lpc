#include <ansi.h>
inherit NPC;

void create()
{
        set_name("小甲虫", ({ "insect" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只方头方脑的小甲虫\n");

	set("combat_exp",5000);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 2000 );

        set("kill_msg",RED"$N恶狠狠地围着$n转来转去，看来是想咬死$n。\n"NOR);
        set("fight_msg",YEL"$N不怀好意地在$n的身边转来转去，看来是想咬$n。\n"NOR);

        set_skill("dodge", 100);

        setup();
}

