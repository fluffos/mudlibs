inherit NPC;

void create()
{
        set_name("大灰龙", ({ "dragon" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一条张牙舞爪的大灰龙\n");

        set("str", 60);
        set("cor", 72);
        set("cps", 52);
	set("int", 50);

        set("max_kee",3000);
        set("eff_kee",3000);
	set("kee",3000);
	set("max_gin",1500);
	set("gin",1500);
        set("max_force",3000);
        set("eff_force",3000);
	set("force",3000);
        set("force_factor",70);

	set_skill("unarmed",130);
	set_skill("dragon_bite",130);
	set_skill("force",100);
	set_skill("parry",100);
        set_skill("dodge", 800);
        set_skill("move", 400);

	map_skill("unarmed","dragon_bite");
	map_skill("parry","dragon_bite");

//        set_temp("apply/attack", 3000);
        set_temp("apply/armor", 100);
//	set_temp("apply/damage",20);

	set("combat_exp",4000000);

        set("limbs", ({ "头部", "身体","龙爪", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 15000 );


        setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

void die()
{
        object bonus;

	bonus = new("/t/jianhu/obj/rou");
	bonus->move(this_object());

        ::die();
}

void unconcious()
{
        this_object()->die();
}

