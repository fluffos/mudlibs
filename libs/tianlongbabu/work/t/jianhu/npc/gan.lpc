// gong.c

inherit NPC;

void create()
{
        set_name("干光豪", ({ "gan" }) );
        set("gender", "男性" );
        set("age", 39);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 22);
        set("int", 27);
        set("attitude", "killer");
	set("bellicosity", 3000 );
        set("long","干光豪是无量剑东宗好手，在附近颇有点名气。\n");
	create_family("无量剑", 92, "第子");

        set("max_force", 2000);
        set("force", 2000);
        set("force_factor", 70);

        set("combat_exp", 800000);

        set_skill("unarmed", 200);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("move", 100);
        set_skill("force", 130);
	set_skill("sword", 90);
	set_skill("wuliang-sword",80);
	set_skill("wuliang-steps",80);
        set_skill("literate", 70);

	map_skill("dodge", "wuliang-steps");
	map_skill("move", "wuliang-steps");
        map_skill("parry", "wuliang-sword");
	map_skill("sword", "wuliang-sword");

        setup();

        add_money("gold",1);

        carry_object(__DIR__"obj/longsword")->wield();
        carry_object(__DIR__"obj/jian_cloth")->wear();

}

void init()
{
        object ob;
        ::init();
	if(environment(this_object())->query("short") == "山顶")
        if( interactive(ob = this_player()) ) {
        message_vision("干光豪喝道：你竟敢到无量剑的禁地来，不是自己找死吗！\n",ob);
                kill_ob(ob);
        }
}

