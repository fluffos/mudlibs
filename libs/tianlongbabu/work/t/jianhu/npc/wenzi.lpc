#include <ansi.h>
inherit NPC;

void create()
{
        set_name("花斑蚊", ({ "wenzi" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只长嘴细腿的花斑蚊\n");

	set("combat_exp",1000);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("attitude", "killer");
        set("bellicosity", 10000 );

	set("leave_msg","飞走了");
	set("arrive_msg","带着“嗡嗡”的声音飞了过来");
	set("kill_msg",RED"$N在$n的头上飞来飞去，看来是想叮死$n。\n"NOR);
	set("fight_msg",YEL"$N在$n的身边飞来飞去，看来是想叮$n。\n"NOR);

	set("chat_chance", 80);
	set("chat_msg", ({
		(:random_move :)
	}) );

        set_skill("dodge", 1000);

        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        victim->apply_condition("wenzi_poison", 10);
        return HIM+"$n的$l上留下了$N的毒质！！\n"+NOR;
}

