// Room: /t/jianhu/hill.c

inherit ROOM;

void create()
{
	set("short", "小山坡");
	set("long", @LONG
这里是一个小山坡，山坡上种满了各种茶花，轻风吹过，飘来
阵阵花香。花丛中隐约可见一个大蜂巢，几只蜜蜂到处乱飞。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "southdown" : __DIR__"road6",
  "northdown" : __DIR__"road7",
]));
	set("objects", ([ /* sizeof() == 1 */
	__DIR__"npc/bee_s" : 2,
	__DIR__"obj/nest" : 1,
	]));

	set("no_clean_up", 0);

	setup();
}

void reset()
{
        object          *inv;
        object          container, ob;
        int             i, time;

        ::reset();
        container = present("_nest_", this_object());
        inv = all_inventory(container);
        if( sizeof(inv) != 1) 
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
       // if( random(2) == 1 ) {
                ob = new(__DIR__"obj/honey");
		// random time of 3 minutes, only for 
		// hot spot (大家都枪的东西，如雪莲，荷叶仙露
		time = random(180);
		call_out("complete_move", time, ob, container);
	//}
}

int complete_move(object ob, object bag)
{
	if(objectp(ob) && objectp(bag))
		ob->move(bag);
	return 1;
}

