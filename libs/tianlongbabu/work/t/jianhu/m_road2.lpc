// Room: /t/jianhu/m_road2.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
这里是无量山，山道崎岖，湾湾曲曲，山上乱石成堆，杂草丛
生，举步坚难。更有毒蛇猛兽时常出没于此，若非身怀绝技，不敢
上此山来。不远处可以听得见沙沙的声音，想是什么东西在草丛中
爬行。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "westup" : __DIR__"m_road3",
  "southdown" : __DIR__"m_road1",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/insect_b" : 2,
]));
	set("item_desc", ([
	"stone" : "在乱石堆后面，可以看见一条尾巴，但其身子被石头挡住了，看不清楚。\n",
	"石" : "在乱石堆后面，可以看见一条尾巴，但其身子被石头挡住了，看不清楚。\n",
	"乱石" : "在乱石堆后面，可以看见一条尾巴，但其身子被石头挡住了，看不清楚。\n",
	"乱石堆" : "在乱石堆后面，可以看见一条尾巴，但其身子被石头挡住了，看不清楚。\n",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_move","move");
}

int do_move(string arg)
{
	object ob, me = this_player();

	if(!arg) return 0;
	if(arg == "stone"||arg=="石"||arg=="乱石"||arg=="乱石堆") {
	    if( !query("jia")) {
		message_vision(CYN"$N搬动几块乱石头，露出一条穿山甲来。\n"NOR,me);
		ob = new(__DIR__"obj/jia");
		ob->move(this_object());
		this_object()->set("jia",1);
		return 1;
	    } else {
		tell_object(me,"你搬动几块乱石头，发现那原来是一个影子。\n");
		return 1;
	    }
	} else return 0;
}
