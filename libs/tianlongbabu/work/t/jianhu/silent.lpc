// Room: /open/jane/sword_lake/silent.c

inherit ROOM;

void create()
{
	set("short", "雅室");
	set("long", @LONG
这是一间不大的房间，红木书桌上放着几本左子穆爱看的书，
墙上挂着一把宝剑，深红色的外表显得年代久远，窗口放着一盆
五针松，从窗子向外看是一个小花园。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"sleep",
  "west" : __DIR__"back",
  "east" : __DIR__"zuo",
]));

        set("objects", ([
        __DIR__"npc/insect_s" : 2,
	__DIR__"obj/table" : 1,
 ]) );

	set("no_clean_up", 0);

	setup();
}

void reset()
{
        object          *inv;
        object          container, item;
        int             i;

        ::reset();
        container = present("_table_", this_object());
        inv = all_inventory(container);
        if( sizeof(inv) != 1) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/sword_book");
                if(random(2)==1 )
                    item->move(container);
        }
}

