// Room: /t/jianhu/m_road5.c

inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
这里是无量山，山道崎岖，湾湾曲曲，山上杂草丛生，举步坚
难。更有毒蛇猛兽时常出没于此，若非身怀绝技，不敢上此山来。
据说若在密林中迷了路，便有天大的本事也无济于事，最终尸骨无
存。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "southdown" : __DIR__"m_road6",
  "northup" : __DIR__"m_road7",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("climbing", "climb");
}

int climbing(string arg)
{
        //object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "down" )
        {
        me = this_player();
        message_vision("$N沿着山坡，慢慢爬落。\n", me);
        me->start_busy(3);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
        else
        {
                write("你不可以爬 "+arg+"\n");
                return 1;
        }
}
int fliping(object me)
{
        me->move(__DIR__"m_road3.lpc");
        return 1;
}

