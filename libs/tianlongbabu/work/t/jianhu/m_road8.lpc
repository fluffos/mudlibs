// Room: /t/jianhu/m_road8.c

inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
这里是无量山，山道崎岖，湾湾曲曲，山上杂草丛生，举步坚
难。更有毒蛇猛兽时常出没于此，若非身怀绝技，不敢上此山来。
草丛边有一洞穴，四周寸草不生。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "southdown" : __DIR__"m_road7",
]));
	set("no_clean_up", 0);

        set("item_desc", ([ /* sizeof() == 1 */
        "洞穴" : "
一个黑呼呼的山洞，里面什么也看不见。\n",
]) );
        set("objects", ([
        __DIR__"npc/wolf" : 2 ]) );

	setup();
}

void init()
{
        add_action("do_enter", "enter");
}

int do_enter(string arg)
{
        //object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要往哪里钻？\n");
                return 1;
        }
        if( arg == "hole" || arg == "洞穴")
        {
        me = this_player();
        message_vision("$N钻进山洞，突然脚下一滑，滚了下去。\n", me);
        me->start_busy(3);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
        else
        {
                write("你不可以钻 "+arg+"\n");
                return 1;
        }
}
int fliping(object me)
{
        me->move(__DIR__"dragon1.lpc");
        return 1;
}

