// Room: /open/jane/sword_lake/hall.c

inherit ROOM;

void create()
{
	set("short", "无量剑大厅");
	set("long", @LONG
“无量剑”于五代后唐年间在南诏无量山创派，掌门人居住
无量山剑湖宫。自大宋仁过年间分为东、北、西三宗，每隔五年，
三宗门下弟子便在剑湖宫中比武斗剑，获胜者入住剑湖宫。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"stone_step1",
  "west" : __DIR__"hall_right",
  "north" : __DIR__"garden",
  "east" : __DIR__"hall_left",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
