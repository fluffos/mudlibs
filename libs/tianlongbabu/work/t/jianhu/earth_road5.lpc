// Room: /t/jianhu/earth_road5.c

inherit ROOM;

void create()
{
	set("short", "泥土路");
	set("long", @LONG
这是一条小路，路边长着一些野草。几朵小小的野花飘着阵阵
芳香。时儿能见到几株小树长在路边，因为极少有人在此走路，路
面上都长了许多草。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : "/t/erengu/m_road1",
  "north" : __DIR__"earth_road3",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
