// Room: /t/erengu/small_lake.c

inherit ROOM;

void create()
{
	set("short", "小湖边");
	set("long", @LONG
这是剑湖宫旁边的一个小湖，湖面不大，湖边长着一排柳树，
在风中不停的摇摆。湖水清澈异常，将无量山的倒影映在水中。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "northeast" : __DIR__"road",
  "southup" : __DIR__"earth_road4",
]));

        set("objects", ([
        __DIR__"npc/cat" : 1,
        __DIR__"npc/dog" : 1,
        ]) );

        set("resource", ([
                "water" : 1,
]));

	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
