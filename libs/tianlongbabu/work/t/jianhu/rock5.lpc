// Room: /t/jianhu/rock5.c

inherit ROOM;

void create()
{
	set("short", "渊涯");
	set("long", @LONG
这里是渊涯绝壁，山谷深不见底，只见云雾缭绕，飘浮于半
山腰。周围是光秃秃的岩石，几根杂草生在岩缝之中。
LONG
	);

	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("climbing", "climb");
        add_action("climbing", "爬");

}

int climbing(string arg)
{
        //object obj;
        object me;

        me = this_player();
	if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不能移动。\n");
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "down" )
        {
        message_vision("$N沿着崖逢，慢慢往下爬。\n", me);
        me->start_busy(3);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
	else if ( arg == "up" || arg == "mountain" || arg == "rock" || arg == "岩石" )
	{
	me = this_player();
	message_vision("$N用尽所身力气往上爬，不小心一失手掉下渊涯。\n",me);
	me->set_temp("last_damage_from",0);
	me->die();
	return 1;
	}
        else
        {
                write("你不可以爬 "+arg+"\n");
                return 1;
        }
}
int fliping(object me)
{
        me->move(__DIR__"rock6.lpc");
	if( me->query_temp("yubi") == 1 )  me->set_temp("yubi",2);
        return 1;
}


