// Room: /t/jianhu/top3.c

inherit ROOM;

void create()
{
	set("short", "山顶");
	set("long", @LONG
这里已是无量山的山顶上，从几株参天大树之间透过一些阳光。
远处传来隆隆的轰鸣声，但不知是丛何方传来。旁边有木牌(sign)
一块。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"top4",
  "west" : __DIR__"top2",
]));
	set("no_clean_up", 0);

        set("item_desc", ([ /* sizeof() == 1 */
        "sign" : "
	无量山禁地，入内者杀。
",
]));


	setup();
}

void init()
{
        add_action("climbing", "climb");
}

int climbing(string arg)
{
//        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "down" )
        {
        me = this_player();
        message_vision("$N沿着崖逢，慢慢爬落。\n", me);
        me->start_busy(3);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
        else
        {
                write("你不可以爬"+arg+"\n");
                return 1;
        }
}
int fliping(object me)
{
        me->move(__DIR__"m_road8.lpc");
        return 1;
}

