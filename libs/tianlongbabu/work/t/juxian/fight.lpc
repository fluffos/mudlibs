// fight.c

inherit ROOM;

void create()
{
	set("short", "比武场");
	set("long", @LONG
这是一个比武场，可容纳下许多人。场中央放这一个大擂台，如果
愿意的话，每个人都可以上去切磋两手，当然武林中比武讲究点到为止，
只是如果大意失手，也不能牵怪他人。
LONG
	);

	set("exits", ([
		"north" : __DIR__"endroom2",
	]) );

	set("no_dead", 1);
	set("rec_fight_res", 1);

	setup();
	call_other( "/obj/board/hero_b", "???" );
}
