// This is a room made by roommaker.
#include <ansi.h> 
inherit ROOM;

void create()
{
        set("short", "庙顶");
        set("long", "这里是悯忠寺的庙顶，庙顶上破了个小洞，能看到底下的情形。\n");
        set("outdoors",1);
        setup();
}
void init()
{
        add_action("do_look", "look");
	add_action("do_jump", "jump");
}

int do_look(string arg)
{		
         if( arg == "小洞")
{	object me;
	me = this_player();
	message_vision(HIY"庙中钟磬木鱼及诵经之声此起，彼伏群僧正做功课。\n"NOR,this_player());
	call_out("do_look1", 5, me );
	return 1;
}}

int do_jump(string arg)
{	
        if(!arg || arg=="")
        {
                write("你要跳到哪里？\n");
                return 1;
        }
 else       	
         if( arg == "down") 
{
	if(this_player()->query_temp("ice-worm-ok")==1)
{
	message_vision(HIY"$N一提真气，便跳了下去！\n"NOR,this_player());
	this_player()->move(__DIR__"temple2");
	return 1;
}
else 
{
	message_vision(HIY"$N一提真气，便跳了下去！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-9");
	return 1;
}}}

void do_look1(object me)
{
	message_vision(HIY"忽然听到园中有人在大声叱骂。\n"NOR,this_player());
	call_out("do_look2", 2, me );
	return;
}
void do_look2(object me)
{
	message_vision(HIY"只听那人骂道：“你怎地如此不守规矩，一个人偷偷出去玩耍？\n"
			+"害得老子担心了半天，生怕你从此不回来了。。\n"NOR,this_player());
	call_out("do_look3", 2, me );
	return;
}
void do_look3(object me)
{
	message_vision(HIY"老子从昆仑山巅万里迢迢的将你带来，你太也不知好歹，不懂老子对待你一片苦心。\n"NOR,this_player());
	message_vision(HIY"那人语音中虽甚恼怒，却颇有期望怜惜之意，似是父兄教诲顽劣的子弟。\n"NOR,this_player());
	call_out("do_look4", 2, me );
	return;
}
void do_look4(object me)
{
	message_vision(HIY"这样下去，你还有什么出息，将来自毁前途，谁也不会来可怜你。”\n"NOR,this_player());
	call_out("do_look5", 5, me );
	return;
}
void do_look5(object me)
{
	message_vision(HIY"$N一看，只见说话的人却是个和尚。身材又矮又胖，宛然是个大肉球，手指地下，兀自申斥不休。\n"NOR,this_player());
	call_out("do_look6", 5, me );
	return;
}
void do_look6(object me)
{
	message_vision(HIY"那矮胖和尚所申斥的，竟是一条透明的大蚕。\n"NOR,this_player());
	call_out("do_look7", 10, me );
	return;
}
void do_look7(object me)
{
	message_vision(HIY"忽听得菜园彼端有人叫道：“慧净，慧净！”那矮胖和尚一听，便跑了出去跟一位中年和尚说话。\n"NOR,this_player());
	this_player()->set_temp("ice-worm-ok",1);
	return;
}

