inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨
垂柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("outdoors", 1);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "southeast" : "/t/dengfeng/en-road2.lpc",
  "north" : __DIR__"nwroad2.lpc",
]));

	setup();
	replace_program(ROOM);
}
