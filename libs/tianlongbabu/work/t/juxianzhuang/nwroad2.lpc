inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨
垂柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"nwroad3.lpc",
  "south" : __DIR__"nwroad1.lpc",
]));
	set("no_clean_up", 0);
	set("outdoors", 1);

	setup();
	replace_program(ROOM);
}
