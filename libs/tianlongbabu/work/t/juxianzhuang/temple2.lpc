// Room: /u/patrick/juxianzhuang/temple2.c
#include <ansi.h> 
inherit ROOM;

void create()
{
	set("short", "悯忠寺");
	set("long", @LONG
这里是庙中的一处，由此能听到庙中钟磬木鱼及诵经之声此起，
你发现地上有只透明的大蚕。旁边有个酒葫芦。那蚕儿在地下急速游
动，似要逃走一般。只是一碰到一道无形的墙壁，便即转头。你凝神
看去，见地下画著黄色圆圈，那蚕儿左冲右突，始终无法越出圈子，
当即省悟：“圆圈是用药物画的，这药物是那蚕儿煞星。
LONG
	);
set("item_desc", ([
                "蚕": @TEXT

这蚕虫纯白如玉，微带青色，比寻常蚕儿大了
一倍有余，便似一条蚯蚓，身子透明直如水晶   
。
 
TEXT
        ]) );
set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"mountain.lpc",
]));
	set("no_clean_up", 0);
	set("indoors", 1);

	setup();
}
void init()
{
	add_action("do_get","get");
}
int do_get(string arg)
{	object obj;
        if(!arg || arg=="")
        {
                write("你要拿什麽？\n");
                return 1;
        }
 else       	
         if( arg == "蚕") 
{
	if(this_player()->query_temp("got-worm")==0)
{
	message_vision(HIY"$N拿起酒葫芦，将葫芦口慢慢移向黄线绘成的圆圈。\n"NOR,this_player());
	message_vision(HIY"葫芦口一伸入圈内，那蚕儿嗤的一声，便钻入葫芦。$N大喜，忙将木塞子塞住葫芦口！\n"NOR,this_player());
	obj = new (__DIR__"npc/obj/hulu");
       	obj->move(this_player());       
	this_player()->set_temp("got-worm",1);
	return 1;
}
else 
{
	message_vision(HIY"$N已经不能拿蚕了！\n"NOR,this_player());
	return 1;
}}}


