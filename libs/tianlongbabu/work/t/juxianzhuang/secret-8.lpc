// Room: /u/patrick/juxianzhuang/secret-8.c

inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", @LONG
一条穿越结满冰的树丛中的小路。你仔细一看，路中央居然有只
大灰熊！大灰熊已完全地挡住了你的去路！看来不杀死它你是无法再
前进的！
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", 1);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"secret-7.lpc",
 "north" : __DIR__"secret-9.lpc",
]));
set("objects", ([
		__DIR__"npc/bear": 1,
]));

	setup();
}
int valid_leave(object me, string dir)
{
        object ob;

        if(dir == "north" && ob = present("bear", this_object()))
        {
                message_vision("$N挡住了$n的去路。\n", ob, me);
                return notify_fail("");
        }
        return 1;
}

