// Room: /u/patrick/juxianzhuang/secret-5.c
#include <ansi.h> 
inherit ROOM;

void create()
{
	set("short", "密林");
	set("long", @LONG
走到这里，四周越来越冷，前面的树丛长在道路的两旁，道路显
得非常地狭窄。你不禁想打退堂鼓！寻原路走回去(BACK)。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "back" : __DIR__"secret-1.lpc",
]));
set("item_desc", ([
                "树丛": @TEXT

一堆树丛，长在道路的两旁，想过去就非得要穿过(walkthrough)树丛了！
    
TEXT
        ]) );

	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_walkthrough", "walkthrough");
}

int do_walkthrough(string arg)
{	
        if(!arg || arg=="")
        {
                write("你要穿过什麽？\n");
                return 1;
        }
 else       	
         if( arg == "树丛") 
{
	if(this_player()->query_skill("dodge")<=240)
{
	message_vision(HIY"$N穿过树丛，$N忽然大叫了一声！\n"NOR,this_player());
	message_vision(HIY"$N一脚踩空，便滚下了山坡！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-6");
	return 1;
}
else 
{
	message_vision(HIY"$N穿过树丛，似乎踩到了块不稳的地！\n"NOR,this_player());
	message_vision(HIY"$N见情形不对，便以极强的轻功，腾空而起，飞出了密林！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-1");
	return 1;
}}}