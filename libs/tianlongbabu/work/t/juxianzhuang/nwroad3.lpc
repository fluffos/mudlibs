// Room: /u/patrick/juxianzhuang/nwroad3.c

inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨
垂柳。大道上车轮滚滚，人来人往，络绎不绝。再往东北走就会离开
宋朝境内。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"nwroad2.lpc",
  "northeast" : __DIR__"nwroad5.lpc",
]));
	set("no_clean_up", 0);
	set("outdoors", 1);

	setup();
	replace_program(ROOM);
}
