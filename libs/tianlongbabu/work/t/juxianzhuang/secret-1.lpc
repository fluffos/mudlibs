// Room: /u/patrick/juxianzhuang/secret-1.c
#include <ansi.h> 
inherit ROOM;

void create()
{
	set("short", "密林");
	set("long", @LONG
这座密林是在大辽境内，虽然大辽境内比宋朝境内要冷些，但是
这理却是出奇地冷！有一个火堆挡住去路，大概是冬天烤火用的！
LONG
	);
set("item_desc", ([
                "火堆": @TEXT

除非你能把它扑灭(extinguish),否则你是无法再往前走的！
    
TEXT
        ]) );
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"nwroad5.lpc",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_extinguish", "extinguish");
}

int do_extinguish(string arg)
{	
        if(!arg || arg=="")
        {
                write("你要扑灭什麽？\n");
                return 1;
        }
 else       	
         if( arg == "火堆") 
{
	if(this_player()->query("max_force") < 1400)
{
	message_vision(HIY"$N一拳向火堆打去！\n"NOR,this_player());
	message_vision(HIY"结果火堆没事，$N的拳头倒是烧伤了！\n"NOR,this_player());
	this_player()->receive_wound("kee", random(20));
	this_player()->receive_damage("kee", random(40));
	return 1;
}
else if(this_player()->query("force") < 100)
{
	message_vision(HIY"$N运起双掌，推出一股微风！\n"NOR,this_player());
	message_vision(HIY"火焰只是晃了一下而已，看来是内力不足！\n"NOR,this_player());
	this_player()->receive_damage("kee", random(50));
	return 1;
}
else if(this_player()->query("force_factor") < 100)
{
	message_vision(HIY"$N运起双掌，推出一股微风！\n"NOR,this_player());
	message_vision(HIY"火焰只是晃了一下而已，看来是需要用更多的内力！\n"NOR,this_player());
	this_player()->receive_damage("kee", random(50));
	return 1;
}
else if((int)this_player()->query_skill("icepoison",1) > 149 && (string)this_player()->query_skill_mapped("unarmed") == "icepoison-strike"
	&& (int)this_player()->query_temp("weapon")==0 )
{
message_vision(HIY"$N一提真气，运起双掌，一股寒风立即向火苗扑去，火苗登时小了许多！\n"NOR,this_player());
message_vision(HIY"$N趁机纵身一跃，跳了过去！\n"NOR,this_player());
message_vision(HIY"火堆被野风一吹又烧了起来。\n"NOR,this_player());
this_player()->set_temp("ice-enter1",random(7));
this_player()->set_temp("ice-enter2",random(7));
this_player()->set_temp("ice-enter3",random(7));
this_player()->move(__DIR__"secret-2");
this_player()->add("force",-100);
return 1;
}
else
message_vision(HIY"$N一提真气，运起双掌，推出一股劲风！\n"NOR, this_player());
message_vision(HIY"结果火借风威，差点烧着了$N的衣服！\n"NOR, this_player());
this_player()->add("force",-100);
return 1;
}
}
