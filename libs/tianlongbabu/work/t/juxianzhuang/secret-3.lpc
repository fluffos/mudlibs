// Room: /u/patrick/juxianzhuang/secret-3.c
#include <ansi.h> 
inherit ROOM;

void create()
{
	set("short", "密林");
	set("long", @LONG
走到这里，四周越来越冷，北面的路都以结了一层薄薄地霜！你
不禁想打退堂鼓！寻原路走回去(BACK)。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  	"back" : __DIR__"secret-1.lpc",
	"north" : __DIR__"secret-4.lpc",
]));

	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}

int valid_leave(object me, string dir) {

        if (dir == "north") {

            if (me->query("int")> 23) {
                message_vision(CYN "$N重重地拍了一下脑袋，似乎想到了什麽主意。\n" NOR,me);
                tell_object(me,"看起来那边太危险了，还是不要去了吧！\n");
                return notify_fail("");
            }
        }
        return 1;
}