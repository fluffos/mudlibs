// Room: /u/patrick/juxianzhuang/secret-2.c
#include <ansi.h> 
inherit ROOM;

void create()
{
	set("short", "密林");
	set("long", @LONG
走到这里，四周越来越冷，前面的树丛已完全地挡住了你的去路
！你不禁想打退堂鼓！寻原路走回去(BACK)。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "back" : __DIR__"secret-1.lpc",
]));
set("item_desc", ([
                "树丛": @TEXT

一堆树丛，挡住了你的去路！
    
TEXT
        ]) );

	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_smash", "smash");
	add_action("do_pushaside", "pushaside");
	add_action("do_touch", "touch");
	add_action("do_move", "move");
	add_action("do_break", "break");
	add_action("do_pull", "pull");
	add_action("do_push", "push");
}

int do_smash(string arg)
{	
        if(!arg || arg=="")
        {
                write("你要砸坏什麽？\n");
                return 1;
        }
 else       	
         if( arg == "树丛") 
{
	if(this_player()->query_temp("ice-enter1")==0)
{
	message_vision(HIY"$N一掌砸向树丛，树丛被$N的掌风砸成粉碎！\n"NOR,this_player());
	message_vision(HIY"$N由碎掉的地方跳了进去！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-3");
	return 1;
}
else 
{
	message_vision(HIY"$N一掌砸向树丛，树丛竟断成数截，压向$N！\n"NOR,this_player());
	message_vision(HIY"$N见情形不对，便急忙的从原路跑了出去！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-1");
	return 1;
}}}

int do_pushaside(string arg)
{	
        if(!arg || arg=="")
        {
                write("你要推开什麽？\n");
                return 1;
        }
 else       	
         if( arg == "树丛") 
{
	if(this_player()->query_temp("ice-enter1")==1)
{
	message_vision(HIY"$N使劲地推开树丛，树丛被$N推开了！\n"NOR,this_player());
	message_vision(HIY"$N由推开的地方跳了进去！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-3");
	return 1;
}
else 
{
	message_vision(HIY"$N使劲地推开树丛，树丛竟倒向$N！\n"NOR,this_player());
	message_vision(HIY"$N见情形不对，便急忙的从原路跑了出去！\n"NOR,this_player());
	this_player()->move(__DIR__"secret-1");
	return 1;
}}}

