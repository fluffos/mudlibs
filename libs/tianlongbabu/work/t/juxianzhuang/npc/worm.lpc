//worm
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void use_poison();
void create()
{
        set_name("冰蚕", ({ "worm" }) );
        set("race", "野兽");
	set("str",100);
	set("con",80);
	set("cor",100);
	set("max_kee",10000);


        set("age", 12);
        set("long", "这蚕虫纯白如玉，微带青色，比寻常蚕儿大了\n"
		"一倍有余，便似一条蚯蚓，身子透明直如水晶\n"
		"。\n");
        set("limbs", ({ "头部", "胸部", "腹部" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("unarmed", 500);
	set_skill("parry", 500);
	set_skill("dodge", 500);
        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                (: use_poison :),
        }) );
        set("combat_exp", 10000000);
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}
void use_poison()
{
        object *enemy, ob;

        enemy = query_enemy();
        if( sizeof(enemy) ) ob = enemy[random(sizeof(enemy))];

        tell_object(ob, HIR+"\n\n"+
name()+"冲向你，用力的往你身上咬．．．\n\n" + NOR);
                ob->apply_condition("ice_poison2",random(200));
}
void die()
{
        object ob;
        message_vision("$N啪的一声断成两截！$N死了。\n", this_object());
        ob = new(__DIR__"obj/worm-corpse");
        ob->move(environment(this_object()));
        destruct(this_object());
}
