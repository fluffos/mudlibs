inherit ITEM;
#include <ansi.h> 
void create()
{
        set_name("葫芦", ({ "ice hulu","hulu"}) );
        set_weight(10);
         
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一个装有冰蚕的葫芦。\n");
                set("value", 0);
        }
}
