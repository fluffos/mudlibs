inherit ITEM;
#include <ansi.h> 
void create()
{
        set_name("冰蚕的尸体", ({ "worm-corpse"}) );
        set_weight(10);
         
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "这是一只冰蚕的尸体\n");
                set("value", 0);
        }
}
