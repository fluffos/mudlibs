// cloth.c 1999 Patrick Ho@TLBB

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("灰布僧衣", ({ "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("male_only", 1);
	}
	setup();
}
