// monk_shoes.c 1999 Patrick Ho@TLBB

#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create()
{
	set_name("灰布僧鞋", ({ "shoes" }) );
	set_weight(0);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一双十分朴素的灰布僧鞋。  \n");
		set("material", "cloth");
		set("unit", "双");
		set("armor_prop/armor", 1 );
		set("male_only", 1);
	}
	setup();
}

