// monk1.c 1999 Patrick Ho@TLBB
#include <ansi.h>
inherit NPC;

void create()
{   
        set_name("慧净", ({ "monk" }) );
        	set("gender", "男性" );
	set("age", 30);
	set("str", 50);
	set("cor", 100);
	set("long",
                "一位矮胖和尚。\n" );
	set("combat_exp", 2000000);
	set("attitude", "aggressive");
	set("class", "bonze");

	set("force", 3500);
	set("atman", 2000);
	set("max_force", 1750);
	set("max_atman", 1000);
	set("force_factor", 150);
	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
                	(: perform_action, "unarmed.strike" :)
              }) );

	set_skill("force", 150);
	set_skill("literate", 150);
	set_skill("bore-jing", 120);
	set_skill("shaolin-force", 150);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 130);
	set_skill("bore-palm", 110);
	set_skill("shaolin-steps", 180);

	map_skill("literate", "bore-jing");
	map_skill("unarmed", "bore-palm");
	map_skill("parry", "bore-palm");
	map_skill("dodge", "shaolin-steps");
	map_skill("force", "shaolin-force");

	setup();

	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/shoes")->wear();

}

