inherit NPC;

void create()
{
	set_name("大灰熊", ({ "bear" }) );
	set("race", "野兽");
	set("age", 7);
	set("long", "一只高你两倍的大灰熊。\n");
	set("attitude", "heroism");
	
	set("str", 50);
	set("cor", 50);
	set("max_kee", 5000);

	set("limbs", ({ "头部", "身体", "前脚", "後脚"}) );
	set("verbs", ({ "bite", "claw" }) );

	set("combat_exp", 1000000);

         set_skill("parry", 400);
        set_skill("unarmed", 500);
	set_skill("dodge", 400);	
	set_temp("apply/attack", 5);
	set_temp("apply/damage", 5);
	set_temp("apply/armor", 50);

	setup();
}

 