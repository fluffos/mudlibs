// Room: /ly/temple_back.c
#include <ansi.h>
#include <room.h>

inherit ROOM;
void create()
{
        set("short", YEL"大智分舵"NOR);
        set("long", @LONG
洛神庙的后殿因长年无人打扫，破败不堪。满地落叶杂草，
墙角立着几个破瓦罐。有几名乞丐正在这里睡觉，一名老丐正盘
膝而坐，身后别了一只布袋。
LONG
        );
        
        set("exits", ([ /* sizeof() == 2 */
          "south" : __DIR__"temple",
]));
        set("objects", ([
              __DIR__"npc/beggar7" : 1,
              __DIR__"npc/beggar5" : 1,
              __DIR__"npc/master_chen" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        setup();
        
}

