// Room: /ly/woodenroom.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
        set("short", "小木屋");
	set("long", @LONG
小木屋内摆设非常朴素，靠墙木桌上摆着个香炉，散发着缕
缕幽香，屋角一盆白色的牡丹花含苞欲放，一位白衣女子背对着
你，坐在一把木椅上。一盏小烛摇摇欲灭，如同人心中的希望。
LONG
	);
	
        set("objects", ([ 
                      __DIR__"npc/whitegirl":1, 
                      ]) );
        set("no_clean_up", 0);
        set("indoors", 1);

	setup();
	
}
void init()
{
        add_action("do_pull", "pull");
}
int do_pull(string arg)
{        
	object obj, me; //, thisroom;
            if( arg=="door" || arg == "屋门") {
		me = this_player();
		if(query("exits/west")) {
			message_vision(YEL "门恰好开着，拉什么？\n" NOR, me);
			return 1;
		}
		message_vision(YEL "$N走到门前，轻轻将门拉开。\n" NOR, me);

		set("exits/west", __DIR__"bro_road2");
            if( obj = find_object(__DIR__"bro_road2") ) {
			message("vision", YEL "你看到有人从里将门打开。\n" NOR, obj);
			obj->set("exits/east", __DIR__"woodenroom");
			obj->set("item_desc", ([
                		"door": "小木屋的门是开着的。\n",
                		"屋门": "小木屋的门是开着的。\n",
        		]) );
		}
		me->start_busy(2);
		call_out("close_door", 10, me);
		
        }
	else {
		write("你要拉什么？\n");
	}
                return 1;
}        
void close_door()
{
	object obj;
        message("vision", "丫鬟走过来，轻轻掩上门，转身离去。\n", this_object() );
        if( obj = find_object(__DIR__"bro_road2") ) 
                {
                obj->delete("exits/east");
                message("vision", "有人从里面将门轻轻关上了。\n", obj );
                }
        delete("exits/west");
}
