// playerroom.c
inherit __DIR__"room0";
void create()
{
        set("short", "玩家乐园");
        set("long",
"这里是天龙玩家的乐园，暂时处于测试阶段。现开设玩家留\n"
"言板和聊天室。西面是玩家聊天室。请大家随时报告出现的问题\n"
"并留下你们的建议，以便巫师为大家更好的服务。我和大家一样，\n"
"坚信天龙是最好的MUD！\n");
        set("exits", ([
                "down": "/t/ly/square",
                "west": "/u/buyi/ly/phome/chatroom",
                ]) );
        set("no_fight", 1);
        set("no_magic", 1);
        setup();
        call_other( "/obj/board/player_b", "???" );
}
void init()
{
        int a;
        object* inv;
        inv = filter(all_inventory(),
                (: (!userp($1)) && ($1->is_character()) :) );
        a = sizeof(inv);
        while (a--) {
                if (!sizeof(filter(deep_inventory(inv[a]), (: userp($1) :) )))
                        inv[a]->move("/t/ly/square");
        }
        add_action("invalid_command","",1);
}

