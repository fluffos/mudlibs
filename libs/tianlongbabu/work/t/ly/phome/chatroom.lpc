//chatroom.c
#include <ansi.h>
inherit __DIR__"room0";
void create()
{
        set("short", "玩家聊天室");
        set("long",
"这里是天龙玩家的聊天室，你可以查看聊天室列表(List)，或\n"
"者加入某个聊天室(Join)，如果有人想应征聊天室版主或开设新的\n"
"聊天室，请写在外面的留言板上。聊天室的主人要注意细心维护，\n"
"玩家如对某个版主不满，也可以在留言板投诉。\n");
        set("exits", ([
                "east": "/t/ly/phome/playerroom",
                ]) );
        set("no_fight", 1);
        set("no_magic", 1);
        setup();
}
void init()
{
        int a;
        object* inv;
        inv = filter(all_inventory(),
                (: (!userp($1)) && ($1->is_character()) :) );
        a = sizeof(inv);
        while (a--) {
                if (!sizeof(filter(deep_inventory(inv[a]), (: userp($1) :) )))
                        inv[a]->move("/t/ly/square");
        }
        add_action("do_list","list");
        add_action("do_join","join");
        add_action("invalid_command","",1);
}
int do_list()
{
        int list1,list2,list3;
        object room1,room2,room3;
        string short1,short2,short3,owner1,owner2,owner3;
        call_other(__DIR__"chatroom1", "???");
        call_other(__DIR__"chatroom2", "???");
        call_other(__DIR__"chatroom3", "???");
        room1 = find_object(__DIR__"chatroom1");
        room2 = find_object(__DIR__"chatroom2");
        room3 = find_object(__DIR__"chatroom3");
        if(room1) owner1 = room1->query("owner");
        if(room2) owner2 = room2->query("owner");
        if(room3) owner3 = room3->query("owner");
        if(room1) short1 = room1->query("short");
        if(room2) short2 = room2->query("short");
        if(room3) short3 = room3->query("short");
        if(room1) list1 = sizeof(filter(all_inventory(room1),(: (userp($1)) :) ));
        if(room2) list2 = sizeof(filter(all_inventory(room2),(: (userp($1)) :) ));
        if(room3) list3 = sizeof(filter(all_inventory(room3),(: (userp($1)) :) ));
        write("玩家乐园现共有 "+HIR"03"NOR+" 个聊天室。\n");
        write("『编号』     『聊天室名称』           『版主』     『现有人数』\n---------------------------------------------------------------\n");
        write("   01\t\t"+short1+"\t\t"+HIG+owner1+NOR+"\t\t"+HIR+list1+NOR+"\n");
        write("   02\t\t"+short2+"\t\t"+HIG+owner2+NOR+"\t\t"+HIR+list2+NOR+"\n");
        write("   03\t\t"+short3+"\t\t"+HIG+owner3+NOR+"\t\t"+HIR+list3+NOR+"\n");
        return 1;
}
int do_join(string arg)
{
        object me,room1,room2,room3;
        me = this_player();
        room1 = find_object(__DIR__"chatroom1");
        room2 = find_object(__DIR__"chatroom2");
        room3 = find_object(__DIR__"chatroom3");
        if(!arg) return notify_fail("请输入你要进入的聊天室编号，例如：join 01 \n");
        switch( arg ) {
                case "01":
                        message_vision(HIG"$N加入了『网络情缘』聊天室！\n"NOR,me);
                        if(room1) message("vision", YEL+me->query("name")+"走了进来。\n"NOR, room1);
                        me->move(__DIR__"chatroom1");
                        break;
                case "02":
                        message_vision(HIG"$N加入了『游戏天地』聊天室！\n"NOR,me);
                        if(room2) message("vision", YEL+me->query("name")+"走了进来。\n"NOR, room2);
                        me->move(__DIR__"chatroom2");
                        break;
                case "03":
                        message_vision(HIG"$N加入了『新手学堂』聊天室！\n"NOR,me);
                        if(room3) message("vision", YEL+me->query("name")+"走了进来。\n"NOR, room3);
                        me->move(__DIR__"chatroom3");
                        break;
                default:
                        return notify_fail("请输入你要进入的聊天室编号，例如：join 01 \n");
        }
        return 1;
}

