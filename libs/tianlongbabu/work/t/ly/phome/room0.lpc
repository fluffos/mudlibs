// room0.c 这是辅助性地图房间的规范，不允许玩家执行任何与练功相关的指令。
#include <room.h>
inherit ROOM;
int invalid_command(string str)
{
        string cmd;
        int i;
        string *invalid_cmds;
        cmd = query_verb();
        invalid_cmds = ({"enforce", "meditate", "practice", "study", 
                         "exercise", "learn", "steal", "chui", "shoot",
                         "exert", "kill", "steal", "fight", "perform"
                       });
        i = member_array(cmd, invalid_cmds);
        if (i == -1) return 0;
        write("别人都回过头来看着你，你怪不好意思的。\n"); 
        return 1;
}

