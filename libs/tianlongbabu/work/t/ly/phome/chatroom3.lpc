//chatroom3.c 新手学堂
#include <ansi.h>
inherit __DIR__"room0";
string look_title();
string look_board();
int save_title(string yn, string file, string str);
int save_board(string yn, string file, string str);
void create()
{
	string file;
        set("short",HIG"新手"NOR+HIW"学堂"NOR);
        set("long",
        "你是第一次玩泥巴吗？或者是第一次到天龙？也许你还对这里\n"
        "不熟悉，但这里将是你的家。有什么不明白的尽管开口问，有什么\n"
        "不顺心的尽管大声说，听听老玩家的经验之谈，学学高手们的不传\n"
        "之秘，祝你快快长大，早日成家！  :P\n"
        "本期话题(Title)      经验之谈(Board)      本室主人：agri\n");
        set("exits", ([
                "out": __DIR__"chatroom",
                ]) );
        set("item_desc",([
            "title" : (: look_title :),
            "board" : (: look_board :),
]));
        set("owner","agri");
        set("no_fight", 1);
        set("no_magic", 1);
        setup();

        file=MAPDATA"title3.log";
        if (file_size(file)<1) write_file(file, "经验之谈\n");
        file=MAPDATA"board3.log";
        if (file_size(file)<1) write_file(file, "经验之谈\n");
}
void init()
{
        int a;
        object* inv;
        inv = filter(all_inventory(),
                (: (!userp($1)) && ($1->is_character()) :) );
        a = sizeof(inv);
        while (a--) {
                if (!sizeof(filter(deep_inventory(inv[a]), (: userp($1) :) )))
                        inv[a]->move("/t/ly/square");
        }
        if(this_object()->query("owner") == this_player()->query("id"))
        {
                add_action("do_kickout","kickout");
                add_action("do_settitle","settitle");
                add_action("do_setboard","setboard");
        }
        add_action("invalid_command","",1);
}
int do_kickout(string arg)
{
        object me,ob;
        me = this_player();
        if(!arg || !objectp(ob = present(arg, environment(me))))
                return notify_fail("你要把谁踢出房间？\n");
        if(ob == me) return notify_fail("你要把自己踢出房间？\n");
        message_vision(HIW"$N一脚把$n踢了出去！\n"NOR,me,ob);
        ob->move("/t/dali/dance_rm");
        return 1;
}
string look_title()
{
        string title;
        title = read_file(MAPDATA"title3.log");
        return "本期话题："+YEL+title+NOR+"\n";
}
string look_board()
{
        string board;
        board = read_file(MAPDATA"board3.log");
        return "经验之谈：\n"+YEL+board+NOR+"\n";
}
int do_settitle(string arg)
{
        string file,str;
        if(!arg) return notify_fail("指令格式：settitle <标题>\n");
        if( (strlen(arg) < 2) || (strlen(arg) > 40 ) )
        return notify_fail("话题请限制在一至二十个字之间。\n");
        file = MAPDATA"title3.log";
        str = arg;
        if( file_size(file)!=-1 ) {
                write("确实要更新本期话题吗？[y/n]");
                input_to("save_title", file, str);
                return 1;
        }
        return save_title("y", file, str);
}
int do_setboard(string arg)
{
        string file,str;
        if(!arg) return notify_fail("指令格式：setboard <内容>\n");
        if( (strlen(arg) < 2) || (strlen(arg) > 80 ) )
        return notify_fail("内容请限制在一至四十个字之间。\n");
        file = MAPDATA"board3.log";
        str = arg+" \n";
        if( file_size(file)!=-1 ) {
                write("确实要加入这条内容吗？[y/n]");
                input_to("save_board", file, str);
                return 1;
        }
        return save_board("y", file, str);
}
int save_title(string yn, string file, string str)
{
        if( strlen(yn)<1 || yn[0]!='y' ) return 1;

        rm(file);
        write("话题更新 " + "....");
        if( write_file(file, str) ) {
                write("Ok.\n");
                return 1;
        } else
                return notify_fail("你没有写入这个档案(" + file + ")的权利。\n");
}
int save_board(string yn, string file, string str)
{
        if( strlen(yn)<1 || yn[0]!='y' ) return 1;

        write("加入内容 " + "....");
        if( write_file(file, str,0) ) {
                write("Ok.\n");
                return 1;
        } else
                return notify_fail("你没有写入这个档案(" + file + ")的权利。\n");
}
