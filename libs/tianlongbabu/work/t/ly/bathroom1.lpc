// Room: ly/bathroom1.c
#include <ansi.h>;
inherit OBJ_ROOM;

void create()
{
	set_short( CYN"华清池"NOR);
	set_long( @LONG
走进华清池，一副清新典雅的气韵顿时将你吸引。墙上挂着
一幅名画，稍有些发黄。两旁摆着几把镂花木椅和茶几，几上的
牡丹花开的正旺，香气四溢。
LONG
	);
	set_exits( ([ /* sizeof() == 2 */
  "west" : __DIR__"south3",
  "east" : __DIR__"bathroom2",
]));
        set_objects( ([
              __DIR__"npc/shuier" : 1,
        ]));

	setup();
}
int invalid_leave(object me, string dir)
{
        object ob;

        if(dir == "east")
        {
                ob = present("shuier", this_object());
                
                if(!ob)
                {
                        message_vision("水儿不在，华清池暂时停业。\n", me);
                        return 1;
                }
                if(!me->query_temp("bath"))
                {
                        message_vision("水儿小声对$N说：您还没交钱呢。\n", me);
                        return 1;
                }
        }
        return 0;
}