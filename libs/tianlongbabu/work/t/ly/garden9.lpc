// Room: /u/z/zili/ly/garden9.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
RED"    寻芳不觉醉流霞，倚树沉眠深夜后。
        客散酒醒日已斜，更持红烛赏残花。\n"NOR,
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"garden10",
  "north" : __DIR__"garden8",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
