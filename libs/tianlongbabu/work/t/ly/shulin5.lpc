#include <room.h>

inherit ROOM;

void create()
{
        set("short", "树林");
	set("long", @LONG
你在树林中穿行，枝叶交错很难辨认路径。前面是一片杏子
林。一阵风吹来，树叶哗啦哗啦的响。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "northeast" : __DIR__"shulin8",
          "northwest" : __DIR__"shulin9",
          "southwest" : __DIR__"shulin3",
          "southeast" : __DIR__"shulin2",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
