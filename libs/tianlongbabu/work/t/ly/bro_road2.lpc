// Room: /ly/bro_road2.c
//zili 1999.5

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
        set("short", "碎石小径");
        set("long", @LONG
顺着碎石小径行到后院，路在一座小木屋前截止了。小木屋
造得甚是精致，屋门虚掩。屋前种着一排白色的牡丹。屋后一片
郁郁葱葱的竹林，随风“沙沙”的响。
LONG
        );
        
        set("exits", ([ /* sizeof() == 2 */
          "west" : __DIR__"bro_road1",
]));
        set("item_desc", ([
                "door": "屋门虚掩，你不敢造次冒入，还是敲敲门吧(knock)。\n",
                "屋门": "屋门虚掩，你不敢造次冒入，还是敲敲门吧(knock)。\n",
        ]) );

        set("no_clean_up", 0);
        set("outdoors", 1);

        setup();
        
}
void init()
{
        add_action("do_knock", "knock");
}

int do_knock(string arg)
{
        int i;
        object obj, me; //, thisroom;
        i = random(10);

        if( arg=="door" || arg == "屋门") {
                me = this_player();
                if(query("exits/east")) {
                        message_vision(YEL "门恰好开着，敲什么？\n" NOR, me);
                        return 1;
                }
                message_vision(YEL "$N走到门前，轻轻地敲了两下，又向后退开两步。\n" NOR, me);
                if (me->query("gender") == "女性")
                    return notify_fail("丫鬟把门打开看了你一眼，又把门关上了。\n");
                if ((int)me->query("age") > 30)
                    return notify_fail("丫鬟把门打开看了你一眼。\n丫鬟叹了口气，摇摇头，又把门关上了。\n");
                if (!me->query("peepma")){
                        if(i > 5) return notify_fail("丫鬟把门打开瞪了你一眼，说道：又是个好色之徒，哼！\n说完，转身进屋关上了门。\n");
                        if(i < 5) return notify_fail("丫鬟把门打开看了你一眼，低声道：小姐今日不见客。\n说完，转身进屋关上了门。\n");
                        if(i = 5) return notify_fail("丫鬟把门打开，凝视着你。\n丫鬟在你耳边轻声说道：小姐去洗澡了。\n说完朝你一笑，转身进屋。\n");
                }
                if (me->query("whitegirl/wait"))
                    return notify_fail("丫鬟把门打开看见是你，说道：公子爷，你还在这里磨蹭什么？还不快去！\n说完，转身进屋关上了门。\n");
                if (me->query("whitegirl"))
                    return notify_fail("屋中无声无息，看来已经人去屋空了。\n");
                if (me->query("gender") == "男性") {
                        set("exits/east", __DIR__"woodenroom");
                        if( obj = find_object(__DIR__"woodenroom") ) {
                            message("vision", YEL "你听到当当两声，有人在门外敲门。\n" NOR, obj);
                            obj->set("exits/west", __DIR__"bro_road2");
                            obj->set("item_desc", ([
                                "door": "小木屋的门是开着的。\n",
                                "屋门": "小木屋的门是开着的。\n",
                        ]) );
                        }
                me->start_busy(2);
                call_out("knock_door", 2, me);
                }
                
        }
        else {
                write("你要敲什么？\n");
        }
                return 1;
}

void knock_door(object me)
{
        object  girl;
        object  obj;

        seteuid(geteuid());
        obj = find_object(__DIR__"woodenroom");
        girl = new(__DIR__"obj/girl");
        message("vision", "\n屋门缓缓向里打开了。\n", this_object());
        message("vision", girl->name()+ "走了出来。\n", this_object());
        if( obj )  message("vision", girl->name() + "缓缓把门打开，走了出去。\n", obj);
        girl->move(this_object());
        message("vision", "丫鬟说道：这位"+ RANK_D->query_respect(me) + 
                "，小姐等您多时了，快请进吧。\n", this_object());
        call_out("close_door", 10, me);
}

void close_door()
{
        object obj,girl;
        message("vision", "丫鬟走进小木屋，回身关上了门。\n", this_object() );
        if( obj = find_object(__DIR__"woodenroom") ) {
                obj->delete("exits/west");
                message("vision", "丫鬟走进来，轻轻掩上门，离去了。\n", obj );
        }
        delete("exits/east");
        girl = present("girl", this_object());// destroy girl
        destruct(girl);
        obj->set("item_desc", ([
                "door": "屋门虚掩，你可以拉开(pull)。\n",
                "屋门": "屋门虚掩，你可以拉开(pull)。\n",
                 ]) );
}

