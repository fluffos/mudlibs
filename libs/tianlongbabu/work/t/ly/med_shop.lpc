// Room: /ly/med_shop.c

inherit ROOM;

void create()
{
	set("short", "鹤年堂");
	set("long", @LONG
走进鹤年堂药店，一股浓重的中药味扑面而来。店内窗明几
净，异常清洁。柜台后有一面抽屉墙，数百个小抽屉，上面都标
着药名。掌柜的正站在台前招待客人。
LONG
	);
	set("exits", ([
		"east" : __DIR__"south1",
	]));

	set("objects", ([ /* sizeof() == 2 */
		__DIR__"npc/liu" : 1,
	]));
	set("no_clean_up", 0);

	setup();
}
