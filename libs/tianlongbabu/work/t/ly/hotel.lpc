// Room: /ly/hotel.c

#include <ansi.h>

inherit OBJ_ROOM;

void create()
{
        set_short( "古城客栈");
        set_long( 
"古铜色的横匾上写着四个遒劲大字“"+YEL"古城客栈"NOR+"”，店内人头
攒动，热闹喧沸。屋中有七、八张桌子，四周摆满了各色牡丹，
争奇斗艳。
"
        );
        set_exits( ([ /* sizeof() == 1 */
            "south" : __DIR__"east1",
            "up" : __DIR__"floor_2_1",
]));
        set_objects( ([
              __DIR__"npc/keeper" : 1,
        ]));

        setup();
}

int invalid_leave(object me, string dir)
{
        object ob;

        if(dir == "up")
        {
                ob = present("keeper", this_object());
                
                if(!ob)
                {
                        message_vision("掌柜的不在，客栈暂时关闭。\n", me);
                        return 1;
                }
                if(!me->query_temp("sleep"))
                {
                        message_vision("掌柜的在$N后面咳嗽了一下：“先交一两银子！”。\n", me);
                        return 1;
                }
        }
        return 0;
}
void init()
{
        add_action("invalid_command","",1);
}

int invalid_command(string str)
{
        string cmd;
        int i;
        string *invalid_cmds;
        cmd = query_verb();
        invalid_cmds = ({"steal", "chui", "kill","fight", });
        i = member_array(cmd, invalid_cmds);
        if (i == -1) return 0;
        write("客栈里不能做这些事。\n"); 
        return 1;
}

