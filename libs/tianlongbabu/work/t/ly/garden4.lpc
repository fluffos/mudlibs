inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", @LONG
到第二年春，牡丹反而开的更盛。靖康年间，金军攻破北宋
京城，洛阳也毁于兵火，牡丹从此衰落。但自从洛阳牡丹享誉之
后，各地慕名者纷纷前来求购......         
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"garden5",
  "south" : __DIR__"garden3",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
