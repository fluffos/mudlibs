// Room: /ly/sleep_1234.c

inherit STD_SLEEP_ROOM;

void create()
{
        set_short("客房");
        set_long( @LONG
这是一间很大的客房，靠墙摆着一盆露珠粉，中间放着一张
红木桌子。桌上茶器齐全，桌椅擦得很干净。不少客人正和衣而
卧，屋中鼾声如雷。一股倦意袭来，你打了个哈欠，也想睡了。
LONG
        );

        set_exits( ([
                "down" : __DIR__"hotel",
        ]));

        set_in_room(__DIR__"hotel");
        set_out_room(__DIR__"hotel");
        setup();
        replace_program(STD_SLEEP_ROOM);
}
