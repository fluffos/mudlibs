// Room: /ly/eastgate.c

inherit ROOM;

void create()
{
	set("short", "洛阳东门");
	set("long", @LONG
洛阳位于河南省西部，古称豫州，因地处洛河之阳而得名， 
自都古以来，这里墨客骚人云集，因有“诗都”之称，牡丹香
气四溢，又有“花都”的美誉。这里是洛阳城东门。
LONG
	);
	set("exits", ([ 
  		"west" : __DIR__"east4",
  		"east" : __DIR__"eroad",
	]));
        set("objects", ([
              __DIR__"npc/garrison4" : 2,
        ]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
