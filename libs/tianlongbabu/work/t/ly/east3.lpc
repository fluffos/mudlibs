inherit ROOM;

void create()
{
	set("short", "洛阳东街3");
	set("long", @LONG
这里是洛阳城的东大街。路旁挑着菜担的小贩一边擦汗一边
大声吆喝着。路北是一家酒肆，门脸不大但酒香四溢，满街皆闻。
路南是一家气派的字画店，据说此店已有百年历史了。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"east2",
  "east" : __DIR__"east4",
  "north" : __DIR__"wine_shop",
  "south" : __DIR__"pic_shop",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
