// Room: /ly/shulin8.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "杏子林");
	set("long", @LONG
这是一片杏子林，枝叶交错，你难以辨清方向。树下落叶堆
积，踩上去很舒服。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "northeast" : __DIR__"shulin12",
          "northwest" : __DIR__"shulin13",
          "southwest" : __DIR__"shulin5",
          "southeast" : __DIR__"shulin4",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
