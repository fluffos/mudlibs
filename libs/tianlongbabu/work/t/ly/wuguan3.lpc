//Room:  wuguan3.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short","刀光映日");
        set("long",
"单刀功夫分“天地君亲师”五位：刀背为天，刀口为地，柄
中为君，护手为亲，柄后为师。五位之中，以天地两位为主，君
亲师三位为辅，亦可攻敌防身。另有“展、抹、钩、剁、砍、劈”
六字诀，实是变幻莫测。\n"
);
        set("exits",([
                   "east" : __DIR__"wuguan2",
]));
        set("objects", ([
              __DIR__"npc/yuanhao" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        setup();

}

void init()
{

        object ob;
        if( interactive(ob = this_player())) {
                if (!wizardp(ob)) {
                        if (sizeof( filter(all_inventory(),
                                (: (userp($1)) && (!wizardp($1)) && 
                                ($1 != this_user()) :) )) >= 2 ) {
                                tell_object(ob,"练功室里面已经人满了，你只好退了出去。\n");
                                ob->move(__DIR__"wuguan2");
                                return;
                        }
                }
        }
        return;
}

void reset()
{
        object          *inv;
        int             i;

        inv = all_inventory(this_object());
        if( sizeof(inv) != 1) {
            for(i=sizeof(inv)-1; i>=0; i--)
                if(!wizardp(inv[i])) {
                    if(userp(inv[i]))
                        inv[i]->move(__DIR__"wuguan2");
                    else destruct(inv[i]);                    	
                }
        }
        ::reset();
}
