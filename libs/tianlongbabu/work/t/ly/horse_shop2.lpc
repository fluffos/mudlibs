// alleyroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "马厩");
	set("long", @LONG
绕过马市后面有一排马厩，许多等待出售的马和尚未驯服
的烈马都先养在这里。马槽之中满盛草料，低头吃草的马儿都
抬起头来看着你。
LONG
	);
	set("exits", ([
		"southwest": __DIR__"horse_shop",
	]) );
	set("outdoors", 1);
	set("objects", ([
            __DIR__"npc/horse2" : 3,
]));
        set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

