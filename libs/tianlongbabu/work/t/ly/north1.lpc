// Room: /u/z/zili/ly/north1.c

inherit ROOM;

void create()
{
        set("short", "洛阳北街1");
        set("long", @LONG
洛阳牡丹雍容华贵，被称为“花中之王”。洛阳城中家家户
户都种着牡丹。这里是洛阳北大街，路东有一家花店，门口路旁
摆着数十盆牡丹，许多游人在此止步观看。路西是家酒楼。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"restaurant",
  "east" : __DIR__"flower_shop",        
  "north" : __DIR__"north2",
  "south" : __DIR__"square",
]));
        set("outdoors", 1);
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

