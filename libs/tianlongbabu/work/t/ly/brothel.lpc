// eastroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "玉春楼");
	set("long", @LONG
玉春楼内彩灯高挂，鲜花铺地，一阵醉香从楼上飘来。几个
身着艳装的青楼女子站在楼梯旁朝你吃吃的笑。鸨母摇着丝绢帕
子向你走来。楼梯旁的小门侧，摆放着几盆盛开的牡丹。
LONG
	);

	set("exits", ([
		"west" : __DIR__"south1",
		"southeast" : __DIR__"bro_road1",
	]));

        /*set("hide_exits", ([
		"up" : __DIR__"brothel2",
        ]));*/

	set("item_desc", ([
           "小门":"在楼梯旁有个红木小门，很不起眼。\n",
           "door":"在楼梯旁有个红木小门，很不起眼。\n",
	]) );

	setup();
}

void init()
{
        add_action("do_unlock", "unlock");
}

int do_unlock(string arg)
{
	int i;
	object *inv, me;

	if(!arg || arg != "小锁") return 0;

	me = this_player();
	inv = all_inventory(me);
	for(i=0;i<sizeof(inv);i++)
	{
		if(inv[i]->name() == "黄铜钥匙")
		{
			if(!(me-> query_temp("unlocked"))) {
				message_vision("$N将黄铜钥匙插入锁中一转，小锁"
						+ "应声而开！\n", me);
				me->set_temp("unlocked", 1);
			}
			else 
				return notify_fail("小门的锁已经开了。\n");	
			return 1;
		}
		write ("你没有钥匙怎么开门呢？\n");
		return 1;
	}
	return 1;
}

int valid_leave(object me, string dir) {
	if (!(me->query_temp("unlocked")) && dir=="southeast")
	return notify_fail("你一推门才发现扶手位置有个黄铜小锁。\n");
	me->set_temp("unlocked", 0);
	return 1;	
}
