// Room: /ly/restaurant_2.c

#include <ansi.h>

inherit OBJ_ROOM;

void create()
{
	set_short("松鹤楼二楼");
	set_long(
"这里是松鹤楼二楼，跑堂的正忙着给客人端酒送饭。靠窗有
几张桌子，可以看见下面街市的过往行人和远处景致。西首座上
有一位大汉正在吃肉喝酒，甚是豪迈。\n"
	);
	set_exits( ([ /* sizeof() == 1 */
            "down" : __DIR__"restaurant",
]));

	setup();
}


