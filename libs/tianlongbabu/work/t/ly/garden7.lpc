#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
BLU"    名花倾城两相欢，长得君王带笑看。
        解释春风无限恨，沉香亮北倚阑干。\n"NOR,
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"garden8",
  "east" : __DIR__"garden6",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
