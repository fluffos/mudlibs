// Room: /u/z/zili/ly/north2.c

inherit ROOM;

void create()
{
	set("short", "洛阳北街2");
	set("long", @LONG
你走在洛阳城宽阔平整的大街上，正值牡丹盛开的季节。街
两旁到处摆放着牡丹花。正所谓“洛阳地脉花最宜，牡丹尤为天
下奇”。街东西两侧是天下闻名的洛阳牡丹园。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"north3",
  "south" : __DIR__"north1",
  "east" : __DIR__"garden1",
  "west" : __DIR__"garden6",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
