// Room: /d/ly/east1.c 
 
inherit ROOM; 
 
void create() 
{ 
	set("short", "洛阳东街1");
	set("long", @LONG
洛阳城的大街宽阔平整，行人络绎不绝。做买卖的来来往往。 
北面有一家客栈，门口拴着几匹马。南边则是洛阳城最大的钱庄， 
不断有人进进出出。 
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", 1);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"hotel",
  "south" : __DIR__"bank",
  "east" : __DIR__"east2",
  "west" : __DIR__"square",
]));

	setup();
	replace_program(ROOM);
}
