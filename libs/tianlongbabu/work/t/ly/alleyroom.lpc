// alleyroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "小巷尽头");
	set("long", @LONG
走到小巷尽头出现一个红木门，门板紧闭，不知道里面有何
所在。门板上有两个生锈的门环，落满灰尘。墙头杂草丛生，随
风而舞。
LONG
	);
	set("exits", ([
		"south": __DIR__"alleyway3",
		"north": __DIR__"alleyroom2",
	]) );

	create_door("north", "大门", "south", DOOR_CLOSED);

	setup();
}

