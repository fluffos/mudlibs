// Room: /u/z/zili/ly/garden10.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
"秋千\n"
	);
	set("exits", 
([ /* sizeof() == 2 */
            "south" : __DIR__"garden1",
            "north" : __DIR__"garden9",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_sit", "sit");
	add_action("do_stand", "stand");
	add_action("do_push","push");
}
int do_sit(string arg)
{
	if(!arg || arg != "秋千" || arg != "swing") return 0;
	if(this_object()->query_temp("sitted"))  
	return notify_fail("秋千上面已经有人啦。\n");
	else {
		message_vision("$N坐上秋千，等人推一把呢。\n", this_player());
		this_object()->set_temp("sitted", 1);
	}
	return 1;
}
int do_stand()
{
	message_vision("$N下了秋千。\n", this_player());
	this_object()->set_temp("sitted", 0);
	return 1;
}
int do_push(string arg)
{
	object *list;
        object me;
//	int flag=0;
	me=this_player();
	if(!arg || arg != "秋千" || arg != "swing") return 0;
        if(!this_object()->query_temp("sitted")) 
        {message_vision("你轻轻推了一下秋千，只觉索然无味。\n",this_player());}
        list =all_inventory(environment(me));
        if(sizeof(list)==2)
 	if(userp(list[0])&&userp(list[1]))
        if(list[0]->query("gender")!=list[1]->query("gender"))
	{
		message_vision("$N轻轻一推，秋千荡了起来。\n", me);
	}
	message_vision("你不喜欢跟一个同性玩荡秋千。\n",this_player());
	return 1;
}	
