// Room: /ly/book_shop.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "伊川书院");
	set("long", 
"自古洛阳出才子，伊川书院历史悠久，程灏程颐曾执教于此
并教出了许多才华横溢的学生。书院之中兼卖各种文学书籍，有
个年轻人蹲在墙角，捧着本书如痴如醉的读着。\n"
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"east2",
]));
        set("objects", ([
              __DIR__"npc/student" : 1,
        ]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
