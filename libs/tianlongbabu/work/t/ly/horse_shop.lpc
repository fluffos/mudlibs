// alleyroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "贩马集市");
	set("long", @LONG
马市就坐落在洛阳城中的一个广场里，这里聚集了来自天
下的各种好马健驹，有上百人在集市中买卖。只见尘土飞扬，
吆喝声和马的嘶鸣声响成一片。
LONG
	);
	set("exits", ([
		"south": __DIR__"west2",
		"northeast": __DIR__"horse_shop2",
	]) );
	set("outdoors", 1);
	set("objects", ([
            __DIR__"npc/horse1" : 1,
            __DIR__"npc/seller" : 1,
]));
        set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

