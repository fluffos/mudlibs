// Room: /ly/tea_shop.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "花都茶馆");
	set("long", 
"花都茶馆是洛阳城中历史最悠久的茶馆之一，每年牡丹花会，
这里都云集四海文人，赏花品茶作诗已成为洛阳学子的趣向。只
见素雅的厅堂布置，伴以数十盆名贵牡丹，照壁上题着一句诗："+RED"

           名园花市灯如昼，玉宇天街夜不阑\n"NOR
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"east2",
]));
        set("objects", ([
              __DIR__"npc/ming" : 1,
        ]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
