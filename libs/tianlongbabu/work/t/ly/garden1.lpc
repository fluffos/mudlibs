// Room: /u/z/zili/ly/garden1.c

inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", @LONG
洛阳牡丹园天下闻名，这里种植着数百种形态各异的牡丹花。
有的茂密如簇，有的孤傲不群，有的掩映在湖边石后，有的盛开
在阶前路边。花旁还插着块小木牌，上面记载着一些牡丹的传说
故事。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"garden2",
  "west" : __DIR__"north2",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
