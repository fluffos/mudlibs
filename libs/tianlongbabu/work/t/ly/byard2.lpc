// Room: /t/ly/byard2.c

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "二层外院");
        set("long", @LONG
这里是丐帮总舵的二层外院，数名乞丐正在院中巡视。一条
甬道通向南边的一个小门。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"byard1",
  "south" : __DIR__"byard3",
]));
        set("objects", ([
              __DIR__"npc/beggarguard3" : 2,
        ]));
        set("outdoors", 1);
        set("no_clean_up", 0);

        setup();
        
}

void init()
{
        int guan;
        object me,ob;
        me = this_player();
        ob = present("beggar", environment(me));
        guan = me->query_temp("gaibang/guan");
        if(objectp(ob) && living(ob)) {
                if((me->query("family/family_name") != "丐帮") && (guan < 2)) {
                message("channel:chat", YEL+"【丐帮】：" + "有人闯入丐帮总舵二层外院！\n" + NOR, users());
                me->set_temp("gaibang/guan",2);
                }
        }
}

int valid_leave(object me, string dir)
{
        object ob;
        ob = present("beggar", environment(me));
        if (dir == "south") {
        if (objectp(ob) && living(ob)) {
                if(me->query("family/family_name") != "丐帮")
                return notify_fail(ob->query("name")+"挡在你面前：想进去，先杀了我！\n");
                }
        return ::valid_leave(me, dir);
        }
        return 1;
}


