// bank.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","洛阳钱庄");
        set("long", 
"这里是洛阳城最大的钱庄，财力雄厚，发行的银票全国通兑，\n"
"往来富商都在这里转兑钱票，高高的柜台后站着一个白胖子，满\n"
"脸笑容。墙上贴着一张" + YEL"告示(sign)"NOR + "。\n"
        );
        set("exits", ([ /* sizeof() == 1 */
                "north" : __DIR__"east1",
        ]));
        set("item_desc", ([
                "sign": @TEXT
                
『洛阳钱庄』目前提供的服务有：
=======================================================
◎ check                存款查询。
◎ convert              兑换钱币。
◎ deposit              存款。
◎ load                 取款。

TEXT
        ]));
        set("objects",([__DIR__"npc/jin":1]));
        setup();
}

