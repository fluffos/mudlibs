inherit ROOM;

void create()
{
        set("short", "杏花丛");
	set("long", @LONG
绕过树林，眼前一片杏花丛。郁郁葱葱，蜂飞蝶舞。北面是
一条小河挡住去路。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
          "southwest" : __DIR__"shulin7",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
