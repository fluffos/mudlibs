// Room: /ly/dak.c 驿站，可以顾马车直通大理
#include <ansi.h>;
inherit ROOM;
int  do_enter(object me);
string *target_place = ({
	"【洛阳】 -- 【大理】\n",
	"【洛阳】 -- 【开封】\n",
	"【洛阳】 -- 【云州】\n",
	"【洛阳】 -- 【登封】\n",
	"【洛阳】 -- 【雪山】\n"
});

void create ()
{
        set ("short", "驿站");
        set ("long", @LONG
这里是洛阳驿站，有直通其它大城的马车(carriage)。几匹
好马正在后院摇头晃脑的吃草料。有许多过路客商在看马，还有
人在焦急的等待下一趟马车出发。
LONG);

        set("item_desc", ([ /* sizeof() == 1 */
            "carriage" : 
"这是一辆乌篷马车，能乘坐四至八人。车夫的位置上斜立着
个牌子(sign)。车夫懒洋洋靠在车辕旁，你若想坐车需要先
付他五两银子。\n",
            "sign" : YEL+target_place[random( sizeof( target_place ))]+NOR,
]));
        set("exits", ([ /* sizeof() == 1 */
            "east" : __DIR__"south2",
]));
        set("objects", ([ /* sizeof() == 2 */
                __DIR__"npc/driver" : 1,
        ]));
        set("indoors", 1);

        setup();
}
void init()
{
        add_action("do_enter", "enter");
}
int do_enter(object me)
{
//	object chefu;
	if(!me->query_temp("drive")) {
		message_vision("车夫伸手一拦，你还没交钱呢。\n", me);
		return notify_fail("");
	}
	message_vision("$N一掀车帘，坐进了马车里。\n", me);
	me->move(__DIR__"carriage");
	remove_call_out("carriage_leave");
	call_out("carriage_leave" , 3);
}
void carriage_leave()
{
	object room;
	message_vision("车夫一扬鞭“驾——”，马车缓缓向大道上驶去。\n", 
	this_player());
//	destruct(driver);
	if( room = find_object(__DIR__"carriage") ) {
			message("vision", "马车轻轻一晃，缓缓行驶起来。\n", room );
		}
	remove_call_out("middle");
        call_out("middle", 5);
}
void middle()
{
	object room1, room2;
	room1 = find_object("/t/kaifeng/center");
	room2 = find_object(__DIR__"carriage");
	message("vision", "一辆马车从路边“隆隆”驶过，卷起一阵尘土。\n", room1);
	message("vision", "路面颇为颠簸，车外人声渐少，已驶出城了。\n", room2);
	remove_call_out("arrive");
	call_out("arrive", 5);
}
void arrive()
{
	object *inv, room3, room4;
	int i;
	room3 = find_object("/t/dali/post_office");
	room4 = find_object(__DIR__"carriage");
	message("vision", "一辆马车从远处驶来，车夫“吁——”的一声，停在了驿站门前。\n", room3);
	message("vision", "只听车夫“吁——”的一声，马车缓缓停了下来，看来到站了。\n", room4);
	inv = all_inventory(__DIR__"carriage");
        if( sizeof(inv) != 1) {
            for(i=sizeof(inv)-1; i>=0; i--)
                if(!wizardp(inv[i])) {
                    if(userp(inv[i]))
                        inv[i]->move("/t/dali/post_office");
                    else destruct(inv[i]);
                }
        }
}
