// rainbow-sword.c

#include <ansi.h>

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name( HIG "蛟云飞虹" NOR, ({ "rainbow sword","sword" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",HIG"蛟云飞虹"NOR"和"HIG"蛟云飞龙"NOR"是传说中的一对宝剑，剑鞘为上好红木雕\n"
                        "成，鞘身上嵌七星宝石。剑出有白色光芒环绕，其利可削金断铁。\n");
                set("value", 10000);
                set("material", "blacksteel");
                set("wield_msg", "$N「唰」地一声抽出一把"HIG"蛟云飞虹"NOR"。其声清脆如龙吟，白色剑气透出了剑身。\n");
                set("unequip_msg", "$N将手中的"HIG"蛟云飞虹"NOR"插入背后的剑鞘，只见白色的剑气随之敛入剑鞘。\n");
        }

        init_sword(80);
        setup();
}

