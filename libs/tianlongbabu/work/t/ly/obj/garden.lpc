// garden.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("花圃", ({ "garden", "花圃" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("no_show",1);
                set("no_get",1);
                set("look_msg","你看到有一朵小花很特别：\n");
                set("position","under");
                set("long", "花圃中生长着一些不知名的花草。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }

