// sandbag.c
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("沙袋", ({ "sandbag" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
//                set("no_show",1);
                set("no_get",1);
//                set("look_msg","里面放着：");
                set("position","on");
                set("long", "一个专门用来练拳的沙袋，你可以试试击(hit)它几掌。\n");
                set("value", 1);
        }
}

void init()
{
        add_action("do_hit", "hit");
}

int do_hit(string arg)
{
     object me;
     int cost,imp;

     me=this_player();
     cost = 50  - ((int)me->query("int") - 15) - me->query_skill("unarmed") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("unarmed") / 10;
     if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练拳必须空手。\n");
     if((arg == "sandbag") || (arg == "沙袋"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习拳法！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法操练拳法。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_eff_skill_level("unarmed", 1) >= 300) 
		{
			write("你发觉已经无法通过打击沙袋提高拳法了。\n");
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N挥拳向沙袋一阵乱捶，累的手都酸了。\n",me);
                       me->receive_damage("kee",cost);
                       break;
              case 2:
                       message_vision("$N凝神吸气，一拳击中沙袋，沙袋轻轻晃了晃。\n",me);
                       me->receive_damage("kee",cost - 5);
                       break;
              case 0:
                       message_vision(YEL"$N力贯右臂，拳头结结实实的击在沙袋上。$N对基本拳法有了更深的领悟。\n"NOR,me);
                       if( !me->query_skill("unarmed", 1) )
			    me->set_skill("unarmed", 0);
		       me->improve_skill("unarmed", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要击打什么？\n");}
      return 1;
}

            
