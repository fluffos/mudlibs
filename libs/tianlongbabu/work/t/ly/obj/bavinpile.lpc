// bavinpile.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("柴堆", ({ "bavin pile", "bavin", "pile", "柴堆" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("no_show",1);
                set("no_get",1);
                set("look_msg","你忽然发现里面有个东西在闪光：\n");
                set("position","under");
                set("long", "一堆木柴散乱的堆放着。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }
