// muren_sword.c
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("木人", ({ "muren" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
//                set("no_show",1);
                set("no_get",1);
//                set("look_msg","里面放着：");
                set("position","on");
                set("long", "一个专门用来练剑的木人，你可以试试刺(stab)它几剑。\n");
                set("value", 1);
        }
}

void init()
{
        add_action("do_stab", "stab");
}

int do_stab(string arg)
{
     object ob,me;
     int cost,imp;

     me=this_player();
     cost = 50  - ((int)me->query("int") - 15) - me->query_skill("sword") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("sword") / 10;
     if( !(ob = me->query_temp("weapon"))
		|| (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能操练剑法。\n");
     if((arg == "muren") || (arg == "木人"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习剑法！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法操练剑法。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_eff_skill_level("sword", 1) >= 300) 
		{
			write("你发觉已经无法通过刺戳木人提高剑法了。\n");
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N挥剑向木人一阵乱刺，却一招也没刺中。\n",me);
                       me->receive_damage("kee",cost);
                       break;
              case 2:
                       message_vision("$N剑走轻灵，向木人斜刺过去，结果还是落空了。\n",me);
                       me->receive_damage("kee",cost - 5);
                       break;
              case 0:
                       message_vision(YEL"$N的剑迅如蛟龙，一击命中！$N对基本剑法有了更深的领悟。\n"NOR,me);
                       if( !me->query_skill("sword", 1) )
			    me->set_skill("sword", 0);
		       me->improve_skill("sword", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要刺什么？\n");}
      return 1;
}

            
