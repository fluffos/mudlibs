inherit ITEM;

void create()
{
        set_name("无名花", ({"flower"}));
        set("unit", "朵");
        set("long", "一朵清婉秀丽的无名小花，花瓣呈淡蓝色。\n");
        setup();
}
void init()
{
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
        if (!id(arg))  return notify_fail("你要吃什么？\n");
        if(arg=="flower") {
                message_vision("$N将无名花放入口中咀嚼。",this_player());
                this_player()->unconcious();
                this_player()->add("potential",50);
                destruct(this_object());
        }
        return 1;
}

        

