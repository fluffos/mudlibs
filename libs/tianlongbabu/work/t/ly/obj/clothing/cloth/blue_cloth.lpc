// cloth1.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(CYN"淡兰罗衫"NOR, ({ "cloth"}) );
        set_weight(500);
        set("value",500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 5);
        set("long", "这是一件淡兰罗衫。\n");

        }
        setup();
}

