// auteur.c
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("浪子傲", ({ "auteur" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "位");
                set("position","on");
                set("long", 
"一位风度翩翩的帅哥，江湖人称“万人迷”，
他面目清秀，风流倜傥，活力四射。
他正用多情的双眸凝视着你，仿佛
要对你说：Oh，My Baby！\n");
                set("value", 1);
        }
}
void init()
{
        add_action("do_order","order");
}
int do_order(string arg)
{
        object me = this_player();
        me->add("gin",-5);
        if(random(100) < 80 )
        message_vision(this_object()->name()+arg+"。\n",this_object());
        else
        message_vision("$N打了个哈欠，有点犯困了。\n",this_object());
        return 1;
}
