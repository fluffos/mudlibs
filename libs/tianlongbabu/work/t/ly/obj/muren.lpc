// muren.c
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("木人", ({ "muren" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
//                set("no_show",1);
                set("no_get",1);
//                set("look_msg","里面放着：");
                set("position","on");
                set("long", "一个专门用来练剑的木人，你可以试试劈(hack)它几刀。\n");
                set("value", 1);
        }
}

void init()
{
        add_action("do_hack", "hack");
}

int do_hack(string arg)
{
     object ob,me;
     int cost,imp;

     me=this_player();
     cost = 50  - ((int)me->query("int") - 15) - me->query_skill("blade") / 10;
     imp = random(5) + ((int)me->query("int") - 15);
     if( !(ob = me->query_temp("weapon"))
		|| (string)ob->query("skill_type") != "blade" )
		return notify_fail("你必须先找一把刀才能操练刀法。\n");
     if((arg == "muren") || (arg == "木人"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习刀法！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法操练刀法。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_eff_skill_level("blade", 1) >= 100) 
		{
			write("你发觉已经无法通过劈砍木人提高刀法了。\n");
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N挥刀向木人一阵乱砍，却一招也没砍中。\n",me);
                       me->receive_damage("kee",cost);
                       break;
              case 2:
                       message_vision("$N凝神吸气，一刀向木人侧面劈出，结果还是落空了。\n",me);
                       me->receive_damage("kee",cost);
                       break;
              case 0:
                       message_vision(YEL"$N的刀快如闪电，直劈向木人，一招命中！\n"NOR,me);
                       if( !me->query_skill("blade", 1) )
			    me->set_skill("blade", 0);
		       me->improve_skill("blade", imp);
		       me->receive_damage("kee",cost);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要劈什么？\n");}
      return 1;
}

            
