// cake.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(HIC"蛋糕"NOR, ({ "cake" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一块香喷喷的奶油蛋糕\n");
                set("unit", "块");
                set("value", 50000);
        }
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object me = this_player();

        if( !arg ) return notify_fail("你要吃什麽？\n");
        if ( !(arg == "cake") ) return notify_fail("你要吃什麽？\n");
        me->set("food", random(500)+500);
        me->set("water", random(500)+500);
        message_vision(YEL"$N拿起一块大奶油蛋糕吃了下去，吃的满脸都是奶油，真好吃！:P。\n"NOR, this_player());

        destruct(this_object());
        return 1;
}

