// girl.c
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("丫鬟", ({ "girl" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "位");
                set("no_get",1);
                set("position","on");
                set("long", 
"    一个小丫鬟，梳着两条可爱的辫子。她面目
清秀，娇小可人，稚气未脱。但从她两泓秋水般
的双眼中，似乎看到有几分忧郁之情。\n");
                set("value", 1);
        }
}



            
