// hairpin.c

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name(YEL"金簪"NOR, ({ "golden hairpin","hairpin" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一根金簪，因年代久远而光彩暗淡。\n" );
		set("unit", "根");
		set("material", "gold");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 5);
	}
	setup();
}

