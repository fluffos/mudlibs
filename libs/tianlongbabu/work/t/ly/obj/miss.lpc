// miss.c
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("白衣女子", ({ "girl" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "位");
                set("no_get",1);
                set("position","on");
                set("long", 
"一位穿着白纱的女子，从后面看身材窈窕，看不到相貌。\n");
                set("value", 1);
        }
}



            
