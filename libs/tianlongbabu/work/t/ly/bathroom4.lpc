//bathroom4.c

#include <ansi.h>
inherit ROOM;

void create() 
{ 
	set("short", "女浴室");
	set("long", @LONG
浴室中热气腾腾，水雾弥漫，几名女子正坐在池边撩着水洗
澡，还嘻嘻哈哈的笑着，几个老婆婆一言不发的闷坐在浴室的一
角，拿块湿毛巾盖着头。一些孩子又惊又喜的互相看着，时不时
的去捅别人的胳肢窝儿。
LONG
	);
	set("no_clean_up", 0);
	set("indoors", 1);
	set("exits", ([ /* sizeof() == 3 */
  "northdown" : __DIR__"bathroom2",
]));

	setup();
}
void init()
{      
        object* oblist;
        object ob, env;
        
        add_action("do_bath","bath");
        env = this_object();
        oblist = all_inventory(env);

        if( interactive( ob = this_player())) {
            if ( wizardp(ob) )  return;
            if ( sizeof(oblist) < 5 ) {
            	if( ob->query("gender") == "男性" ){
            		message_vision(RED"女孩们一见$N进来，大声尖叫着，快出去！\n"NOR, ob);
            		ob->move(__DIR__"bathroom2");
            	}
            	return;
        }
        if( sizeof(oblist) > 5 ) {
            	message_vision(YEL"$N看到浴室里面已经人满了，只好在外面等会儿。\n"NOR, ob);
            	ob->move(__DIR__"bathroom2");
        }
        if( sizeof(oblist) == 5 ) {
        	if( ob->query("gender") == "男性" )
                	message_vision("$N一看没人注意，偷偷溜了进来。\n", ob);
                }
        }
}

int do_bath()
{
        object *inv; 
        int i;

        if(this_user()->is_busy()) return notify_fail("你还没洗完呢！\n");

        if(this_user()->query_temp("bath") < 1) 
        {
                tell_object(this_user(), "请先到前厅付钱再来洗吧！\n");
                return 1;
        }
        // remove all staff before sleepping :P
        inv = all_inventory(this_user());
        for (i=0; i < sizeof(inv); i++ ) {
            if( inv[i]->query("equipped") == "worn" ||
                inv[i]->query("equipped") == "wielded" )
                return notify_fail("总不能穿着衣服带着装备洗澡吧？\n");
        }

        this_user()->start_busy(8);
        if(!random(30)) {
                message_vision(CYN"$N缓缓躺进浴池，浸在温水之中，迷迷糊糊"
                        + "…………\n"NOR,this_user());
                call_out("no_bath",8,this_user());
        } else {
                message_vision(CYN"$N轻轻撩起池中温水，擦洗着洁白的肌肤，"
                        + "水珠闪烁着晶莹的光芒。\n"NOR, this_user());
                call_out("complete_bath",8, this_user());
        }
        return 1;
}

int no_bath(object me)
{
        if (objectp(me))
                message_vision(WHT"$N只觉浑身舒泰，脑中一片空白，"
                +"不知不觉睡着了。\n"NOR,me);
        me->stop_busy();
        return 1;
}

int complete_bath(object me) 
{
        int eff_kee, eff_gin;
//        string outroom;

        if (!objectp(me))       return 1;

        eff_kee = me->query("eff_kee");
        eff_gin = me->query("eff_gin");
        me->set("gin",eff_gin);
        me->set("kee",eff_kee);

        tell_object(me, HIG "你走出浴池擦干身子，只觉浑身清爽自如，还散发着淡淡清香！\n" NOR);
        me->add_temp("bath", - 1 );
        me->start_busy(8);
        me->move(__DIR__"bathroom2");
        return 1;
}
