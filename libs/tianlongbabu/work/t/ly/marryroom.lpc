// Room: ly/marryroom.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", YEL"月老祠"NOR);
        set("long", @LONG
这里是一间祠堂，供桌上摆着干鲜果品，香炉上轻烟缭绕，
四周一片寂静，似乎连时间都在这里停顿。有个小姑娘住在这
里，她躲在门后露出头，笑嬉嬉的看着你。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"south3",
]));
        set("objects", ([
              __DIR__"npc/yuaner" : 1,
        ]));
        set("indoors", 1);
        set("no_clean_up", 0);

        setup();
        call_other("/obj/board/marry_b", "???");
}

void init()
{
        add_action("do_post", "post");
}

int do_post(string arg)
{
        write ("你不能在姻缘薄上留言！\n");
        return 1;
}

