// Room: /ly/dak.c 驿站，可以顾马车直通大理
#include <ansi.h>;
inherit ROOM;

string *target_place = ({
	"【洛阳】 -- 【大理】\n",
	"【洛阳】 -- 【开封】\n",
	"【洛阳】 -- 【云州】\n",
	"【洛阳】 -- 【登封】\n",
	"【洛阳】 -- 【雪山】\n"
});

void create ()
{
        set ("short", "驿站");
        set ("long", @LONG
这里是洛阳驿站，有直通其它大城的马车(carriage)。几匹
好马正在后院摇头晃脑的吃草料。有许多过路客商在看马，还有
人在焦急的等待下一趟马车出发。
LONG);

        set("item_desc", ([ /* sizeof() == 1 */
            "carriage" : 
"这是一辆乌篷马车，能乘坐四至八人。车夫的位置上斜立着
个牌子(sign)。车夫懒洋洋靠在车辕旁，你若想坐车需要先
付他五两银子。\n",
            "sign" : YEL+target_place[random( sizeof( target_place ))]+NOR,
]));
        set("exits", ([ /* sizeof() == 1 */
            "east" : __DIR__"south2",
]));
        set("objects", ([ /* sizeof() == 2 */
                __DIR__"npc/driver" : 1,
        ]));
        set("indoors", 1);
	set("valid_startroom", 1);
        setup();
        call_other("/obj/board/ly_b", "???");
}
