// Room: /ly/road3.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "黄土小径");
	set("long", @LONG
一条黄土小径，延伸到一片树林前。林中隐约有人走动，仔
细听又悄无声息。一阵风吹来，树叶哗啦哗啦的响。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "northeast" : __DIR__"shulin2",
          "northwest" : __DIR__"shulin3",
          "south" : __DIR__"road2",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
