// glim_shop.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "花灯店");
        set("long", @LONG
洛阳花灯是天下一景，每到花灯节前后，家家户户都挂起
各式各样的彩灯，五颜六色，把黑夜辉映得如白天一般。这里
是一家有名的花灯店。
LONG
        );
        set("exits", ([
                "west": __DIR__"north3",
        ]) );
        set("indoors", 1);
/*      set("objects", ([
            __DIR__"npc/glimer" : 1,
]));*/
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}


