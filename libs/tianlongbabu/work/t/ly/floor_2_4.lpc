// Room: /ly/floor_2_4.c

inherit STD_ROOM;

void create()
{
        set_short("客栈二楼");
        set_long( @LONG
你正走在古城客栈二楼的走廊上，来往客人都在房中安歇。
楼下客人饮酒行令之声隐隐传来，此外四处一片安静。廊角一盆
黄金轮迎着日头开放，闪闪升辉。
LONG
        );
        set_exits( ([ /* sizeof() == 4 */
                "north" : __DIR__"floor_2_1",
                "west" : __DIR__"floor_2_3",
                "south" : __DIR__"sleep_4",
        ]));

        setup();
        replace_program(STD_ROOM);
}
