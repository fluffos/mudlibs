// Room: /ly/alleyway1.c

inherit ROOM;

void create()
{
	set("short", "幽深小巷");
	set("long", @LONG
这里是一条幽深小巷，宛转通向前方，两旁高墙并肩而立，
只余一人通行。地面碎石铺就，坑洼不平。偶尔有一两名乞丐
低头走过，再无人迹。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"alleyway2",
  "east" : __DIR__"south4",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
