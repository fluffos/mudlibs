// Room: /ly/road1.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "黄土小径");
	set("long", @LONG
出得洛阳城来，一条蜿蜒小径，通向一片树林。这里人迹渐
少，有些冷清。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "south" : __DIR__"northgate",
          "northwest" : __DIR__"road2",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
