// Room: /ly/wuguan1.c

inherit ROOM;
string look_sign();
void create()
{
	set("short", "武馆大院");
	set("long", @LONG
这里是洛阳武馆的大院，院子中散放着一些石槌木桩，几个
小伙子在一角练拳，拳势打得虎虎生风。迎面墙上贴着张告示，
几个人在围着看。
LONG
	);
        set("item_desc",([
            "sign" : (: look_sign :),
            "告示" : (: look_sign :),
]));

	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"wuguan3",
  "east" : __DIR__"wuguan4",
  "south" : __DIR__"wuguan6",
  "north" : __DIR__"wuguan5",
  "southwest" : __DIR__"wuguan1",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}

string look_sign()
{
	return
	"\n"
	"————————————————\n"
        "|           洛阳武馆           |\n"
        "|                              |\n"
        "|     西练刀法    东练剑术     |\n"
        "|     北练拳脚    南练轻功     |\n"
        "|                              |\n"
        "|学武以强身健体为主，切勿纵行！|\n"
        "|                              |\n"
        "————————————————\n";
}
