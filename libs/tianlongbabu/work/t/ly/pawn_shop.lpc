// pawn_shop.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","洛阳当铺");
        set("long", 
"洛阳城内的一家老字号当铺，资财雄厚，信誉可靠。听说当\n"
"铺老板当年曾是武林中人，后隐居于此，不问江湖中事。徐老板\n"
"年近七十，为人正直，做买卖也兢兢业业。墙上有块"+YEL"木牌(sign)"NOR+"。\n");
        set("item_desc", ([
                "sign": @TEXT

『洛阳当铺』提供以下服务：
====================================================
◎ list          :   查看存货
◎ value  <物品> :   估价
◎ sell   <物品> :   卖断货物
◎ pawn          :   查看典当货物
◎ pawn   <物品> :   典当货物
◎ redeem <物品> :   赎回货物
    
TEXT
        ]) );
        set("exits", ([ /* sizeof() == 1 */
                "south":__DIR__"west4",
        ]));
        set("objects", ([ /* sizeof() == 1 */
                __DIR__"npc/xu" : 1,
        ]));
        setup();
}

