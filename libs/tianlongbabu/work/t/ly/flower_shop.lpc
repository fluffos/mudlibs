// flower_shop.c
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short","仙国花店");
        set("long", @LONG
一家雅致的花店，走进来扑面异香。店中团花锦簇，姹紫嫣
红，让人看花了眼。东面墙上挂着一副对联。一位身着白衫的小
姑娘俏立花丛之中。
LONG
        );
        set("exits", ([
                "west" : "/t/ly/north1",
        ]));

        set("objects", ([
                "/t/ly/npc/dou" : 1,
        ]));
        set("item_desc",([
           "对联" : "只见东墙上挂着一副对联，上书："+WHT"\n
                      国色初酣卯酒来，仙衣不用剪刀裁\n"NOR,
           "couplet" : "只见东墙上挂着一副对联，上书："+WHT"\n
                      国色初酣卯酒来，仙衣不用剪刀裁\n"NOR,
                      ]));
        set("indoors", 1);
        set("no_clean_up", 0);
        setup();

}

