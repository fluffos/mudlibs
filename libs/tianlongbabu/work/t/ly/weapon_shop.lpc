// weapon_shop.c

inherit OBJ_ROOM;

void create()
{
        set_short("兵器铺");
        set_long( @LONG
一间不大的兵器铺，四壁挂满了各式各样的兵器。一位老匠
师带着学徒正站在火炉边敲敲打打，火星四溅。洛阳的习武之人
都来这里挑件顺手的兵刃。
LONG
        );
        set_exits( ([ /* sizeof() == 1 */
                "south" : __DIR__"west1",
        ]));

        set_objects( ([ /* sizeof() == 2 */
                __DIR__"npc/oldman" : 1,
                __DIR__"npc/trainee" :2,
        ]));

        setup();
        replace_program(OBJ_ROOM);
}
