// Room: /ly/temple_road.c

inherit ROOM;

void create()
{
	set("short", "碎石小径");
	set("long", @LONG
一条碎石小径辗转向前，路旁长满野草，路的尽头是一棵大
杨树，树后露出高檐一角。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "northeast" : __DIR__"temple",
  "south" : __DIR__"east4",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
