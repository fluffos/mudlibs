// Room: /u/z/zili/ly/garden6.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", @LONG 
历代文人墨客为洛阳牡丹做诗撰文，留下了大批传世佳作。
司马光曾赞叹洛阳牡丹“洛阳春日最繁华，红绿从中十万家。”
洛阳百姓也独爱此花，每至仲春，“花开花洛二十日，满城之人
皆若狂。”
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"garden7",
  "east" : __DIR__"north2",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
