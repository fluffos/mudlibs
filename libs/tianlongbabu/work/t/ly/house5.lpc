// Room: /ly/house5.c

inherit ROOM;

void create()
{
	set("short", "民宅南房");
	set("long", @LONG
南房原是客厅，宽大的厅场中竖着几跟大顶梁柱。如今已结
满蛛网，老鼠在房梁间跑来跑去。厅左立着个破书架，想必以前
珍藏经典，而今也是空空如也。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"yard",
]));
	set("indoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
