// Room: /u/z/zili/ly/garden10.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
YEL"    宫云朵朵映朝霞，白宝栏前斗丽花。
        卯酒未削红玉面，薄施檀粉伴梅花。
        洛阳女儿红颜饶，白色罗裙宝抹腰。
        借的霓裳半庭月，居然管领百花朝。\n"NOR,
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"garden10",
  "southwest" : __DIR__"gardenbed1",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
