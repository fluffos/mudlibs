// wroad.c

inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨垂
柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("exits", ([
		"east" : __DIR__"westgate",
		"west" : __DIR__"wroad2",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
