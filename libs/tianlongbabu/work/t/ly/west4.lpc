inherit ROOM;

void create()
{
	set("short", "洛阳西街4");
	set("long", @LONG
你走在洛阳城宽阔平整的大街上，路旁行人来来往往。北面
有一家当铺，信誉很好因而生意兴隆。南面是一家服装店，兼做
护具，不断有人进进出出。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"west3",
  "west" : __DIR__"westgate",
  "north" : __DIR__"pawn_shop",
  "south" : __DIR__"armor_shop",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
