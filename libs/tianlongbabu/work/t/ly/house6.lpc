// Room: /ly/house6.c

inherit OBJ_ROOM;

void create()
{
	set_short("民宅内室");
	set_long(@LONG
屋内光线黯淡，依稀可见左窗下是个土炕，右侧是个柴堆。
中间摆着一张木桌，几把快要散架的椅子。桌上有个缺嘴的茶壶
和落满灰尘的杯子。点着一盏油灯，火光如豆。
LONG
	);
	set_exits( ([ /* sizeof() == 1 */
  "out" : __DIR__"house3",
]));
        set_objects(([ /* sizeof() ==1 */
                __DIR__"obj/bavinpile" : 1,
        ]));

	setup();
}
void reset()
{
        object          *inv;
        object          container, item;
        int             i;

        ::reset();
        container = present("bavin pile", this_object());
        inv = all_inventory(container);

        if( sizeof(inv) != 1) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/hairpin");
                item->move(container);
         }
}
