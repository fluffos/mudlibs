// Room: testroom.c

inherit ROOM;
int do_greeting();
void create()
{
	set("short", "测试房间");
	set("long", @LONG
计算该房间内玩家(player)数量。
LONG
	);
	set("no_clean_up", 0);

	setup();
}
void init()
{
	do_greeting();
}
int do_greeting()
{
	int a;
	a = sizeof(all_inventory(environment(this_player())));
	message("vision","测试房间内现有玩家" + a +"名。\n",this_player());
}