// armor_shop.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","裁缝铺");
        set("long", 
"一家很老的裁缝铺，门面久未装修，已有些破损颓败。店内\n"
"摆设简单，只一桌一椅，店主年迈，已老眼昏花，但手艺高超，\n"
"洛阳闻名。\n");

        set("exits", ([ /* sizeof() == 1 */
                "north":__DIR__"west4",
        ]));
        set("objects", ([ /* sizeof() == 1 */
                __DIR__"npc/zhao" : 1,
        ]));
        setup();
}

