// ming.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("香茗", ({ "xiang ming","ming","xiang" }) );
        set("gender", "女性" );
        set("age", 25);
        set("per", 22);
        set("long",
                "一位清丽绝俗的女孩儿嘴角含笑，低着头不敢看你。\n");
        set("combat_exp", 200);
        set("attitude", "friendly");
        set("rank_info/respect", "女招待");
        set("vendor_goods", ([
                "碧镙春茶": __DIR__"obj/cup1",
                "龙井茶": __DIR__"obj/cup2",
                "洛阳花茶": __DIR__"obj/cup3",
                "铁观音茶": __DIR__"obj/cup4",
]));
        setup();
        carry_object(__DIR__"obj/mingcloth")->wear();
        carry_object(__DIR__"obj/yelaixiangshoes")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "香茗微笑地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝杯茶，歇歇腿吧。\n");
                        break;
                case 1:
                        say( "香茗微笑着迎上来，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( "香茗说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝几杯小店的养心茶吧，这是花都茶馆的特产哟。\n");
                        break;
                case 3:
                        say( "香茗正忙着收拾桌子，没注意有人进来。\n");
                        break;
        }
        return;
}
