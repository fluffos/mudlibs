// rulan.c

inherit NPC;

void create()
{
        set_name("如兰", ({ "ru lan","ru","lan" }) );
        set("gender", "女性" );
        set("age", 19);
        set("per", 30);
        set("long",
                "一位身着青衫的小女孩站在花丛之中。\n"
                "只见她肌肤胜雪，瞳如点漆，笑生双靥。\n");
        set("combat_exp", 5000);
        set("attitude", "friendly");

        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        carry_object(__DIR__"obj/shoes1")->wear();
}

