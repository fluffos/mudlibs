// trainee.c
inherit NPC;

void create()
{
        set_name("学徒", ({ "trainee" }) );
        set("gender", "男性" );
        set("age", 18);
        set("long", "铁匠铺的学徒工，年纪不大满脸黝黑。\n");
        set("combat_exp", 20000);
        set("str", 30);
        set("force", 400);
        set("max_force", 400);
        set("force_factor", 10);
        set_skill("unarmed", 40);
        set_skill("dodge", 40);
        set_skill("parry", 40);
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
        carry_object(__DIR__"obj/hammer")->wield();
        set("inquiry", ([
                    "玄铁石" : "我只听师傅说起过，但没见过。",
        ]) );
}

