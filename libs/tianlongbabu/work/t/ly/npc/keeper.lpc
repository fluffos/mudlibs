// keeper.c

inherit NPC;
inherit F_VENDOR;

void create()
{
       set_name("掌柜的", ({ "keeper", "zhanggui", "zhang", "gui" }) );
       set("gender", "男性" );
       set("age", 45);
       set("long",
              "一个老眼昏花的掌柜的，平时也不说话，
有时抬眼看人时带着股邪气。\n");
       set("combat_exp", 500);
       set("attitude", "friendly");
       set("rank_info/respect", "掌柜的");
       set("force", 150);
       set("max_force", 150);
       set("force_factor", 10);
       set("vendor_goods", ([
               "包子": "/obj/example/dumpling",
               "鸡腿": "/obj/example/chicken_leg",
               "酒袋": "obj/example/wineskin",
               "天龙八部排行榜": "/obj/ntopten"
       ]));
       setup();
       carry_object(__DIR__"obj/cloth3")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        message_vision( "掌柜的抬头看了看$N，说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝杯茶，歇歇腿吧。\n",this_player());
                        break;
                case 1:
                        message_vision( "掌柜的一言不发，瞥了$N一眼，又低下头去算他的帐。\n",this_player());
                        break;
                case 2:
                        message_vision( "掌柜的望着窗角出神，没注意$N走了进来。\n",this_player());
                        break;
                case 3:
                        message_vision( "掌柜的看$N走了进来，说道：这位" + RANK_D->query_respect(ob)
                                + "，住店吗？一两银子住一晚上。\n",this_player());
                        break;
        }
        return;
}

int accept_object(object who, object ob)
{
        int val;
        val = ob->value();
        if( (!val) || (!ob->query("money_id")) ) 
        return notify_fail(""); 

        if( val >= 100 ) 
        {
                who->add_temp("sleep", val/100);
                say("掌柜的点了点头，把钱收起来了。\n");
        }
        return 1;
}
