// driver.c 车夫

inherit NPC;
void create()
{
	set_name("车夫", ({ "driver" }) );
	set("gender", "男性" );
	set("age", 35);
	set("long", 
	"车夫满脸晒得黝黑，头顶戴着个破草帽，眯着一双\n"
	"眼睛看着你。你要想乘马车，先要付他五两银子。\n" );
	set("combat_exp", 200);
	set("score",50);
	set("per", 15);
	set("str", 30);
	set("force", 300);
	set("max_force", 300);
	set("inquiry", ([
	    "坐车": "先付五两银子，然后上车等着吧。\n",
            "马车": "没见过马车啊？问什么问？",
            "车费": "五两，少一文都不成。",
]) );
	set("chat_chance", 2);
	set("chat_msg", ({
		"车夫拿起手巾擦了擦汗道：今天可真够热的。\n",
		"车夫左顾右盼，可今天就是没生意。\n",
		"车夫抠了抠脚指头缝，又去抠鼻孔。\n",
		"车夫斜倚在车辕旁，迷迷糊糊睡着了。\n",
	}) );
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
}

int accept_object(object me,object ob)
{
	say("车夫苦着脸道：对不起，最近马车坏了，等修好了您再来吧。\n");
	return 0;
/*	int val;
        val = ob->value();
        if( (!val) || (!ob->query("money_id")) )
        return notify_fail("");
        if( val >= 1000 ) 
        {
                me->set_temp("drive", val/1000);
                say("车夫点了点头，把钱收了起来。“上车吧！(enter)”\n");
        }
        return 1; */
}
