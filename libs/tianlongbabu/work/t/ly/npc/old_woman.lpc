// old_woman.c

inherit NPC;
string ask_hairpin(object me);
void create()
{
	set_name("老妇人", ({ "old woman","woman" }) );
	set("gender", "女性" );
	set("age", 60);
	set("long", "一位老妇人正在左顾右盼，看起来正在寻找什么。\n");
	set("combat_exp", 6000);
	set("score",500);
	set("per", 15);
	set("force", 300);
	set("max_force", 300);
	set("inquiry", ([
	    "找什么": "咳！这事怎么说呢？\n",
	    "丢了什么": "唉！到哪里去找啊...？\n",
            "金簪": (: ask_hairpin :),
]) );
	set("chat_chance", 2);
	set("chat_msg", ({
		"老妇人说道：咳，我怎么给丢了呢！\n",
		"老妇人说道：真急死人了！\n",
		"老妇人左顾右盼，似乎在找东西。\n",
		"老妇人两眼发直，似乎在回忆什么事情。 \n",
		"老妇人喃喃自语：怎么今天一早起来，金簪就没了...\n",
		"老妇人喃喃自语：老头子还等着我回去呢，这可怎么交代啊...\n",
		(: random_move :)
	}) );
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
}
string ask_hairpin(object me)
{
	if(!this_player()->query_temp("hairpin")) {
		command("sigh");
                this_player()->set_temp("hairpin", 1);
                return "我的金簪丢了...." + RANK_D->query_respect(this_player()) + "帮我找找吧！\n";
        }
        return "是啊，我也正在找呢！\n";
}
int accept_fight(object me)
{
	command("say " + RANK_D->query_respect(this_player()) + "可怜可怜我这把老骨头吧！\n");
	return 0;
}
int accept_object(object me,object ob)
{
        object obj1, obj2;//, obj3;
        me = this_player();
        if (ob->query("id")!="golden hairpin") return 0;
        if (!me->query_temp("hairpin")) {
        	message_vision("老妇人满脸感激的道：你怎么知道我正找这个呢？！太谢谢你了！\n",me);
        	message_vision("说完，老妇人高高兴兴的回家了。\n",me);
        	call_out("destroy", 1, this_object());
        	return 1;
        	}
        if (ob->query("id")=="golden hairpin") {
        	me->delete_temp("hairpin");
        	message_vision("老妇人上下仔细打量了$N几眼。\n", me);
                command("hehe " + me->query("id") );
                if ((int)me->query("per") > 24) {
                	obj1=new(__DIR__"obj/key1");
                	obj1->move(me);
                	command("whisper " + me->query("id") + " 这把钥匙你拿好了，以后也许会用上。\n");
                	me->set_temp("key1", 1);
                	message_vision("说完，老妇人转身离开了。\n", me);
                	call_out("destroy", 1, this_object());
//                	this_object()->move(__DIR__"resetroom");
                return 1;
                }
                obj2=new(__DIR__"obj/book2");
                obj2->move(me);
                me->delete_temp("hairpin");
                command("tell " + me->query("id") + " 太感谢你了，我也没什么好东西，这本书就送给你吧。");
                message_vision("老妇人偷偷塞给$N一本书。\n", me);
                message_vision("说完，老妇人转身消失在人群之中。\n", me);
                call_out("destroy", 1, this_object());
//                this_object()->move(__DIR__"resetroom");
        return 1;
        }
        else return 0;
}
int destroy(object ob)
{
        destruct(ob);
        return 1;
}
