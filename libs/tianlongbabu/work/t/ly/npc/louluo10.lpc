//louluo10.c
#include <ansi.h>
inherit NPC;

int pai_found = 0;

void create()
{
        set_name("总寨参事", ({ "canshi"}) );
        set("gender", "男性" );
        set("age", 20+random(15));
        set("max_gin", 1000);
        set("max_kee", 1000);
        set("gin", 1000);
        set("kee", 1000);
        set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);
        set_skill("blade", 100);
        set_skill("wuhu-blade", 60);
        map_skill("blade","wuhu-blade");
        set_skill("jifeng-steps", 80);
        map_skill("dodge","jifeng-steps");

        set("long",
"这是一名装塑整齐，神态威武的总寨参事。腰中挂着一口单刀。\n");
        set("combat_exp", 800000+random(200000));
        set_skill("unarmed", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);

        set("chat_chance", 25);
        set("chat_msg", ({
"参事说到：要能向秦老寨主习得五虎断门刀法的最后五招，\n"
"那就能平扫江湖了。\n"NOR,
(: random_move :)
}));             
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        carry_object(__DIR__"obj/blade")->wield();         
        add_money("silver", random(60));
        
}

