// bai2.c

#include <dbase.h>
#include <login.h>
int get_values(object);

string value_string(int value)
{
        if(value < 1) 
                value = 1;
        else if(value < 100)
                return chinese_number(value) + "文钱";
        else
                return chinese_number(value/100) + "两"
                        + (value%100? "又" + chinese_number(value%100) 
                        + "文钱": "");
}

int get_values(object ob)
{
        if( ob->query("value") )
            return ob->query("value");
        else if ( ob->query("base_value") )
            return ob->query("base_value") * ob->query_amount();
        else
            return 0;
}

void pay_player(object who, int amount)
{
        object ob;

        if(amount < 1) amount = 1;
        if(amount / 1000000)
        {
                ob = new(TENCASH_OB);
                ob->set_amount(amount / 1000000);
                ob->move(who);
                amount %= 1000000;
        }
        if(amount / 100000)
        {
                ob = new(CASH_OB);
                ob->set_amount(amount / 100000);
                ob->move(who);
                amount %= 100000;
        }
        if(amount / 10000)
        {
                ob = new(GOLD_OB);
                ob->set_amount(amount / 10000);
                ob->move(who);
                amount %= 10000;
        }
        if(amount / 100) 
        {
                ob = new(SILVER_OB);
                ob->set_amount(amount / 100);
                ob->move(who);
                amount %= 100;
        }
        if(amount) 
        {
                ob = new(COIN_OB);
                ob->set_amount(amount);
                ob->move(who);
        }
}

int do_value(string arg)
{
        object ob;
        int value;

        if(!arg || !(ob = present(arg, this_player())))
                return notify_fail("白老板莫名其妙的看着你：你到底要给什么物品估价？\n");
        if((string)ob->query("skill_type") != "sword")
                return notify_fail("白老板一付懒的理你的样子：哼！我只给宝剑估价。\n");
        if(ob->query("money_id"))
                return notify_fail("这是" + ob->name() + "，你没见过吗？\n");

        value = get_values(ob);
        if(!value) 
                printf("%s一文不值。\n", ob->query("name"));
        else if( value < 5000 )
                return notify_fail("白老板轻蔑一瞥：这种破铜烂铁就不必找我看了。\n");
        else
                printf("白老板拿起%s仔细打量：果然是把好剑！价值应在%s左右吧。\n"
                        + "你愿意卖(sell)给我吗？我可以给你%s。\n",
                        ob->query("name"), value_string(value*2/3),
                        value_string(value));
        return 1;
}

int do_sell(string arg)
{
        int value,piece;
        object ob;
//        mapping vlist;

        if(!arg || !(ob = present(arg, this_player())))
                return notify_fail("白老板莫名其妙的看着你：你到底要卖什么？\n");

        if(ob->query("money_id")) 
                return notify_fail("你要卖" + ob->name() + "？\n");

        value = get_values(ob);
        if(!value) return notify_fail(ob->name() + "这东西不值钱。\n");
        if((string)ob->query("skill_type") != "sword")
                return notify_fail("白老板一付懒的理你的样子：哼！我只买宝剑。\n");
        if( value < 5000 )
                return notify_fail("白老板轻蔑哼了一声：谁买这破玩意儿？！\n");
        message_vision("$N把身上的" + ob->query("name") + "卖掉。\n",
                        this_player());

        pay_player(this_player(), value);

        if (value > 50) {  // by cbra main for not allow 1 coin book sell
                set("vendor_goods/" + ob->name(), base_name(ob));
                if(piece=query(ob->name())) {
                        if (piece < 20) {  // max 20 piece
                                add(ob->name(), 1);
                        }
                }
                else
                        set(ob->name(), 1);
        }

        destruct(ob);

        return 1;
}

