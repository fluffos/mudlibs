//npc: supervisor
inherit NPC;

void create()
{
       set_name("监工", ({"supervisor"}));
       set("long", "监工背着手溜达，一付神气活现的样子。\n");
       set("gender", "男性");
       set("combat_exp", 30000+random(60000));
       set("str", 30);
       set("age", 35);
       set("attitude", "peaceful");
       set_skill("unarmed", 65);
       set_skill("parry", 65);
       setup();
       add_money("silver", 20+random(50));
       carry_object(__DIR__"obj/cloth2")->wear();
}

