//horse.c
#include <ansi.h>  
inherit NPC;

void create()
{
        set_name("种马", ({ "horse" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一匹膘肥体壮摇头晃脑的种马。\n");
        
        set("str", 26);
        set("cor", 30);
        set_temp("owner","buyi");

        set("limbs", ({ "头部", "身体", "前腿", "後腿", "尾巴" }) );
        set("verbs", ({ "bite", "kick" }) );

        set("combat_exp", 500000);
        set_skill("move", 500);
        set_temp("apply/attack", 10);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 20);

        setup();
}
void die()
{
        message_vision("$N凄惨的嘶鸣一声，倒在了地上。\n", this_object());
        ::die();
}

