//npc: fellow
inherit NPC;

void create()
{
       set_name("伙计", ({"fellow"}));
       set("long", "一个年轻伙计正忙着扛米袋，顾不上跟你说话。\n");
       set("gender", "男性");
       set("combat_exp", 3000+random(6000));
       set("str", 30);
       set("age", 18+random(10));
       set("attitude", "peaceful");
       set_skill("unarmed", 15);
       set_skill("parry", 15);
       setup();
       add_money("coin", 20+random(50));
       carry_object(__DIR__"obj/cloth2")->wear();
}

