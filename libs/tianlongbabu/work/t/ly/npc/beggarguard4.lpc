// beggarguard4.c

#include <ansi.h>
inherit NPC;
void do_protect();
void do_recover();
string *firstname=({"赵","钱","孙","李","周","吴","郑",
                    "王","林","乔","张","洪","宋","黄",
                    "段","黎","莫","钟","谭","单","唐",
                    "萧",
                    "司徒","司马","欧阳"});
string *firstid=({"zhao","qian","sun","li","zhou","wu","zheng",
                  "wang","lin","qiao","zhang","hong","song","huang",
                  "duan","li","mo","zhong","tan","shan","tang",
                  "xiao",
                  "situ","sima","oyang"});
string *lastname=({"青","樊","山","狂","志","远","渺",
                   "恨","强","力","酒","杀","正","痴",
                   "名","利","穷","废","梦","诗","书",
                   "画","乐","吏","然","鹏","顺","德",
                   "飞","起","灭","绝","角","一","二",
                   "三","四","五","六","七","八","九",
                   "天","地","海","陵","雄","英","豪",
                   "杰","剑","刀","枪","弓","勾","元",
                   "无名","致远","清扬","无恨","不悔","望川",});
string *lastid=({"qing","fan","shan","kuang","zhi","yuan","miao",
                 "hen","qiang","li","jiu","sha","zheng","chi",
                 "ming","li","qiong","fei","meng","shi","shu",
                 "hua","yue","li","ran","peng","shun","de",
                 "fei","qi","mie","jue","jiao","yi","er",
                 "san","si","wu","liu","qi","ba","jiu",
                 "tian","di","hai","ling","xiong","ying","hao",
                 "jie","jian","dao","qiang","gong","gou","yuan",
                 "wuming","zhiyuan","qingyang","wuhen","buhui","wangchuan",
                });
                
void create()
{
        string name, id;
        int rnd;
        
        rnd = random(sizeof(firstname));
        name = firstname[rnd];
        id = firstid[rnd];
        rnd = random(sizeof(lastname));
        name += lastname[rnd];
        id += lastid[rnd];
        rnd = random(50);
        
        set_name(name, ({ id,"beggar" }) );
        set("gender", "男性" );
        set("age", 10+rnd);
        set("long", "一个破衣烂衫的乞丐。\n");
        set("combat_exp", 5000000);
        set("gaibang/class", 8);
        set("title", "丐帮八袋弟子");
        create_family("丐帮", 15, "弟子");
        set("force", 2500);
        set("max_force", 2500);
        set("force_factor", 140);
        
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("force", 250);
        set_skill("blade", 150);
        set_skill("beggar-force", 180);
        set_skill("beggar-strike", 180);
        set_skill("beggar-steps", 180);
        set_skill("spring-blade", 120);
        
        map_skill("force","beggar-force");
        map_skill("dodge","beggar-steps");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","spring-blade");
        map_skill("blade","spring-blade");
        
        set("chat_chance", 50);
        set("chat_msg",
        ({
                (: do_protect :),
        }) );
/*      set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "staff.fumo" :)
        }) );
*/      
        setup();
        carry_object(__DIR__"obj/blade")->wield();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() && living(this_object())) {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
}

void meeting(object ob)
{
        if( !ob || environment(ob) != environment()) return;
        if( ((string)ob->query("family/family_name") == "丐帮")
                &&(query("gaibang/class") < ob->query("gaibang/class") )
                &&(ob->query("gaibang/class") > 8 ) )
                {
                        message_vision(query("name")+"向$N抱拳躬身道：弟子参见长老！\n", ob);
                }
        if( (string)ob->query("family/family_name") != "丐帮") 
                {
                        switch( random(4) )
                        {
                                case 0:
                                message_vision(query("name")+"静静的站在院子当中，一言不发。\n",ob);
                                break;
                                case 1:
                                message_vision(query("name")+"向$N抱拳道：此乃丐帮总舵，请速退出！\n", ob);
                                break;
                                case 2:
                                message_vision(query("name")+"哼了一声，道：好厉害！让我试试你的身手！\n", ob);
                                kill_ob( ob );
                                break;
                                case 3:
                                message_vision(query("name")+"看了$N一眼，说道：这位" + RANK_D->query_respect(ob)
                                + "，请回吧，这里不是你来的地方。\n",ob);
                                break;
                        }
                }
                

}

int accept_fight(object me)
{
        command("say " + "在下不敢有负守门之职，这位" +
        RANK_D->query_respect(me) + "见谅！\n");
        return 0;
}

void attempt_apprentice(object ob)
{
        message_vision("$N忙躬身道：在下不敢当，你还是去找九袋长老吧。\n",this_object());
        return;
}

void do_recover()
{
        int full_kee = query("max_kee");

        if( is_busy() )
                return;
        if( (!is_fighting()) && (query("eff_kee") < full_kee)
                && (query("eff_kee") > (full_kee/2)) )
        {
                if( query("force") >= (query("max_force")+50) )
                {
                        command("exert heal 50");
                        return;
                }
                if( query("kee") > 100 )
                        command("exercise 100");
                return;
        }
        if( query("kee") < (query("eff_kee")) )
        {
                if( query("force") > 100 )
                        command("exert recover 100");
                else
                        if( query("force") > 20 )
                                command("exert recover 20");
                return;
        }
        if( query("gin") < (query("eff_gin")) )
                if( query("force") > 100 )
                        command("exert refresh 100");
                else
                        if( query("force") > 20 )
                                command("exert refresh 20");
        return;
}

void do_protect()
{
        string *killer;
        object *pupil = all_inventory( environment() ), enemy;
        int i;

        if( (query("kee") < query("max_kee")) || (query("gin") < query("max_gin")) )
        {
                do_recover();
                return;
        }
        if( is_fighting() )
                return;
        for( i=0; i<sizeof(pupil); i++ )
        {
                if( living(pupil[i]) && pupil[i]->is_fighting() 
                        && (pupil[i]->query("family/family_name")=="丐帮") )
                        {
                        killer = pupil[i]->query_killer();
			if (sizeof(killer)<1) return;
                        if( !(enemy=present(killer[0])) ) return;
                        command( "heng"+getuid(enemy) );
                        message_vision( YEL""+query("name")+"冲"+enemy->query("name")
                                +"叫道：叫化子难道就好欺负吗？！\n"NOR, enemy );
                        kill_ob( enemy );
                        return;
                }
        }
}
