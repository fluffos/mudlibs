// yuanhao.c

#include <ansi.h>;
inherit NPC;
int do_recover();

void create()
{
	set_name("元豪", ({ "yuan hao", "yuan", "hao" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long", 
	"一个中年男子，腰挎钢刀，就只见他满腮虬须，根根\n"
	"如铁，一头浓发也不结髻，横生倒竖般有如乱草。\n");
	set("title", "神州刀客");
	
	set("combat_exp", 4000000);
	set("score",1000);
	set("str", 30);
	set("force", 5000);
	set("max_force", 3000);
	set("force_factor", 100);
	set("atman",1000);
        set("max_atman",1000);
	
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("blade", 200);
	set_skill("parry", 150);
	set_skill("move", 120);
	set_skill("force", 150);
	set_skill("beggar-steps",120);
        set_skill("beggar-force",120);
        set_skill("beggar-strike",120);
        
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_recover :)
        }));
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
	carry_object(__DIR__"obj/blade1")->wield();
	
}

int accept_fight(object me)
{
	if(environment(this_object())->query("short") != "刀光映日")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆刀室来找我吧。\n");
	command("say " + RANK_D->query_respect(me) + "不必较量了，你只管向俺砍(hack)上几刀吧。\n");
	return 0;
}

void attempt_apprentice(object ob)
{
		message_vision("元豪对$N摇了摇头道：俺不收徒，你别指望了。\n",this_player());
		return;
}
void init()
{
        add_action("do_hack", "hack");
}

int do_hack(string arg)
{
     object ob,me;
     int cost,imp;
     if(environment(this_object())->query("short") != "刀光映日")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆刀室来找我吧。\n");
     me=this_player();
     cost = random(5) + ((int)me->query("int") - 15) + me->query_skill("blade") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("blade") / 10;
     if( !(ob = me->query_temp("weapon"))
		|| (string)ob->query("skill_type") != "blade" )
		return notify_fail("你必须先找一把刀才能操练刀法。\n");
     if((arg == "yuan hao") || (arg == "yuan") || (arg == "hao"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习刀法！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法操练刀法。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_skill("blade", 1) >= 200) 
		{
			message_vision("元豪对$N一抱拳道：原来你这么厉害，俺打不过你。\n", me);
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N挥刀向元豪一阵乱砍，却一招也没砍中。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 2:
                       message_vision("$N凝神吸气，一刀向元豪的左臂劈出。\n",me);
                       message_vision("元豪急忙向右一闪，刀锋紧擦着他肩膀削过。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 0:
                       message_vision(YEL"$N一刀斜剁，快如闪电，直逼元豪前胸！。\n"NOR,me);
                       message_vision("元豪大吃一惊，只好提刀格挡。$N对基本刀法有了更深的领悟。\n",me);
                       if( !me->query_skill("blade", 1) )
			    me->set_skill("blade", 0);
		       me->improve_skill("blade", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要砍谁？\n");}
      return 1;
}
int do_recover()
{
        object me = this_object();

        if ( me->is_fight() ) return 1;
        if ( me->query("eff_kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("healing",3);
            return 1;
        } else if ( me->query("kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("exert_recover",3);
            return 1;
        }
        return 1;
}

int healing()
{ 
        object me = this_object();
        if ( ( me->query("force") - me->query("max_force") < 51 ) 
            || ( (int)me->query("eff_kee") < (int)me->query("max_kee") / 2 ) )
                return 1;
        else
                command("exert heal");
        return 1;
}

int exert_recover()
{ 
        command("exert recover 60");
        return 1;
}
