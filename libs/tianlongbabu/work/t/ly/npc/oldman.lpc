// oldman.c

inherit NPC;

void create()
{
	set_name("老匠师", ({ "oldman" }) );
	set("gender", "男性" );
	set("age", 69);
	set("long", "老铁匠正站在火星四溅的铁炉旁打一口刀。\n");
	set("combat_exp", 40000);
	set("str", 30);
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_skill("parry", 50);
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
        carry_object(__DIR__"obj/hammer")->wield();
	set("chat_chance", 1);
	set("chat_msg", ({
		"老匠师低声对学徒说到：如果能找来一块玄铁石，我就可以......\n",
	}) );
	set("inquiry", ([
	            "玄铁石" : "那是一种很难得的石头，熔炼之后可以打造出天下最锋利的兵器。",
	]) );
}

int accept_object(object me, object obj)
{
	command("smile");
	command("say 多谢这位" + RANK_D->query_respect(me) + "！");
	return 1;
}


