// pawn_shop xu.c

inherit NPC;
inherit F_VENDOR;
inherit HOCKOWNER;

void create()
{
        set_name("徐老板", ({ "xu" }) );
        set("gender", "男性" );
        set("age", 69);
        set("long",
                "一位白须老者用慈祥的目光看着你。\n");
        set("vendor_goods", ([
                "长剑": "/obj/example/sword",
        ]));
        set("combat_exp", 5000000);
        set_skill("unarmed", 100);
        set_skill("parry",100);
        set_skill("dodge",100);
        set_skill("force",100);
        set_skill("beggar-force",100);
        set_skill("beggar-steps",100);
        set_skill("beggar-strike",100);
        map_skill("dodge","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 80);
        set("atman",800);
        set("max_atman",800);        
        setup();

        carry_object(__DIR__"obj/xucloth")->wear();
        add_money("gold", 2);
}

void init()
{       
        object ob;

        ::init();
        if(environment(this_object())->query("short") == "洛阳当铺") {
                if( interactive(ob = this_player()) && !is_fighting() ) {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
                add_action("do_vendor_list", "list");
                add_action("do_value", "value");
                add_action("do_sell", "sell");
                add_action("do_pawn","pawn"); 
                add_action("do_redeem","redeem");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(5) )
          {
                case 0:
                        message_vision( "徐老板笑着迎接$N，说道：这位" + RANK_D->query_respect(ob)
                                + "，是要典当东西吗？(pawn)\n",this_player());
                        break;
                case 1:
                        message_vision( "徐老板自言自语道：存货还有不少，可惜卖不出去啊......(list)\n",this_player());
                        break;
                case 2:
                        message_vision( "徐老板见$N走了进来，说道：有什么物品需要我来估价的吗？(value)\n",this_player());
                        break;
                case 3:
                        message_vision( "徐老板慢条斯理的对$N说道：你若在本店典当东西，随时可以赎走。(redeem)\n",this_player());
                        break;
                case 4:
                        message_vision( "徐老板疑惑的看着$N道：这位" + RANK_D->query_respect(ob)
                        + "，有什么要卖的东西吗？(sell)\n",this_player());
                        break;
        }
        return;
}
