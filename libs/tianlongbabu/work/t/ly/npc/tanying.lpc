// tanying.c

#include <ansi.h>;
inherit NPC;
int do_recover();

void create()
{
	set_name("谭英", ({ "tan ying", "tan", "ying" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long", 
	"一个中年男子，着短打黑衣，面色苍白。\n"
	"他身材消瘦，似乎身有疾病。\n");
	set("title", "八步赶蟾");
	
	set("combat_exp", 4000000);
	set("score",1000);
	set("str", 30);
	set("force", 5000);
	set("max_force", 3000);
	set("force_factor", 100);
	set("atman",1000);
        set("max_atman",1000);
	
	set_skill("unarmed", 100);
	set_skill("dodge", 150);
	set_skill("parry", 120);
	set_skill("move", 150);
	set_skill("force", 150);
	set_skill("beggar-steps",150);
        set_skill("beggar-force",120);
        set_skill("beggar-strike",100);
        
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_recover :)
        }));
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
	
}

int accept_fight(object me)
{
	if(environment(this_object())->query("short") != "身轻如燕")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆轻功室来找我吧。\n");
	command("say " + RANK_D->query_respect(me) + "不必较量了，你能抓住(catch)我衣角就行！\n");
	return 0;
}

void attempt_apprentice(object ob)
{
		message_vision("谭英对$N摇了摇头道：我向来不收徒弟，还望见谅。\n",this_player());
		return;
}
void init()
{
        add_action("do_catch", "catch");
}

int do_catch(string arg)
{
     object /*ob,*/me;
     int cost,imp;
     if(environment(this_object())->query("short") != "身轻如燕")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆轻功室来找我吧。\n");
     me=this_player();
     cost = random(5) + ((int)me->query("int") - 15) + me->query_skill("dodge") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("dodge") / 10;
     if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练轻功必须空手。\n");
     if((arg == "tan ying") || (arg == "tan") || (arg == "ying"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习轻功！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法练习轻功。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_skill("dodge", 1) >= 200) 
		{
			message_vision("谭英对$N抱拳一躬道：阁下的轻功已然深不可测，实在佩服！\n", me);
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N像个赖蛤蟆一样朝谭英一扑，谭英身形一晃就躲开了。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 2:
                       message_vision("$N悄无声息的靠近谭英，猛的一扑。\n",me);
                       message_vision("谭英急忙提气跃起，堪堪避过$N的扑击。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 0:
                       message_vision(YEL"$N身行左晃，一瞬间又闪到右边。\n"NOR,me);
                       message_vision("谭英躲闪不及，只得向后退开。$N对轻功提纵术有了更深的领悟。\n",me);
                       if( !me->query_skill("dodge", 1) )
			    me->set_skill("dodge", 0);
		       me->improve_skill("dodge", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要抓住谁？\n");}
      return 1;
}
int do_recover()
{
        object me = this_object();

        if ( me->is_fight() ) return 1;
        if ( me->query("eff_kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("healing",3);
            return 1;
        } else if ( me->query("kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("exert_recover",3);
            return 1;
        }
        return 1;
}

int healing()
{ 
        object me = this_object();
        if ( ( me->query("force") - me->query("max_force") < 51 ) 
            || ( (int)me->query("eff_kee") < (int)me->query("max_kee") / 2 ) )
                return 1;
        else
                command("exert heal");
        return 1;
}

int exert_recover()
{ 
        command("exert recover 60");
        return 1;
}
