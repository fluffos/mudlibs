//npc: sparrow.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("小麻雀", ({ "sparrow" }) );
        set("race", "野兽");
        set("age", 1);
        set("gender", "雌性");
        set("long", "一只可爱的小麻雀，唧唧喳喳叫个不停! \n你可以试着抓住(catch)它。\n");
        set("combat_exp", 1);
        set("attitude","peaceful");
        set("limbs", ({ "头部", "身体","翅膀" }) );
        set("verbs", ({ "bite","claw" }) );
        set_temp("apply/dodge", 150);
        set("chat_chance", 3);
        set("chat_msg", ({
        "小麻雀歪过脑袋好奇的看着你。 \n"
        }) );

        setup();
}
 void init()
{
        if( this_player()->query("gender") =="女性" ) {
                message_vision("小麻雀见$N走了过来，高兴的飞到$N的肩膀上。\n", this_player());
        }       
        else {
                message_vision("小麻雀看$N走了过来，赶忙扑腾着翅膀飞开了。\n", this_player()); 
        }
        add_action("do_catch", "catch");
        add_action("do_kill", "kill");
        add_action("do_fight", "fight");
}

int do_catch(string arg)
{
     object me;
     int cost,imp;

     me=this_player();
     cost = 50  - ((int)me->query("int") - 15) - me->query_skill("dodge") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("dodge") / 10;
     if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练轻功必须空手。\n");
     if((arg == "sparrow") || (arg == "小麻雀"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习轻功！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法练习轻功。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_eff_skill_level("dodge", 1) >= 300) 
		{
			write("你发觉已经无法通过打击沙袋提高拳法了。\n");
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N像个赖蛤蟆一样朝小麻雀一扑，小麻雀轻轻一跳躲开了。\n",me);
                       me->receive_damage("kee",cost);
                       break;
              case 2:
                       message_vision("$N悄无声息的靠近小麻雀，猛的一扑，结果小麻雀从手指缝间逃掉了。\n",me);
                       me->receive_damage("kee",cost - 5);
                       break;
              case 0:
                       message_vision(YEL"$N身行左晃，一瞬间又闪到右边，小麻雀惊慌得无处可逃。\n"NOR,me);
                       if( !me->query_skill("dodge", 1) )
			    me->set_skill("dodge", 0);
		       me->improve_skill("dodge", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要抓什么？\n");}
      return 1;
}
int do_kill(string arg)
{
     if((arg == "sparrow") || (arg == "小麻雀"))
        return notify_fail("这么可爱的小麻雀你也舍得杀？！\n");
        return 1;
}
int do_fight(string arg)
{
     if((arg == "sparrow") || (arg == "小麻雀"))
        return notify_fail("何必跟小麻雀一般见识？！\n");
        return 1;
}
