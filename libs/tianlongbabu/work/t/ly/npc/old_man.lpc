// old_man.c

inherit NPC;

void create()
{
	set_name("老汉", ({ "old man" }) );
	set("gender", "男性" );
	set("age", 70);
	set("long", "一个正在抽旱烟的老汉，满脸褶子，一付饱经风霜的样子。\n");
	set("combat_exp", 7000);
	set("score",1000);
	set("str", 27);
	set("force", 300);
	set("max_force", 300);
	set("force_factor", 5);
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
	set("chat_chance", 5);
	set("chat_msg", ({
		"老汉“吧嗒 吧嗒”抽着旱烟。\n",
		"老汉把旱烟锅子在鞋底敲了敲，揣入怀中。\n",
		"老汉换上新烟叶，又抽了起来。\n",
	}) );
}
