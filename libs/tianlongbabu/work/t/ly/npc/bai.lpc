// bai.c

inherit NPC;
inherit F_VENDOR;
inherit __DIR__"bai2";
void create()
{
        set_name("白老板", ({ "bai" }) );
        set("gender", "男性" );
        set("age", 40);
        set("long",
                "白老板生性好收藏名剑，也是剑术大行家。\n");
        set("combat_exp", 3000000);
        set("force", 1800);
        set("max_force", 1600);
        set("force_factor", 80);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("sword", 150);
        set_skill("wind-sword", 100);
        map_skill("sword", "wind-sword");
        map_skill("parry", "wind-sword");
        set("attitude", "peaceful");
        set("vendor_goods", ([
                "长剑": "/obj/longsword",
        ]));
        setup();
        carry_object("/t/ly/obj/clothing/cloth/green_cloth")->wear();
        carry_object("/t/ly/obj/weapon/sword/rainbow_sword")->wield();
}

void init()
{       
        object ob;

        ::init();
        if(environment(this_object())->query("short") == "名器鉴定店") {
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        add_action("do_value", "value");
        add_action("do_sell", "sell");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(5) )
        {
                case 0:
                        message_vision( "白老板客气的迎接$N，“贵客前来，有失远迎......”\n",this_player());
                        break;
                case 1:
                        message_vision( "白老板细心的擦拭着一把宝剑，满脸得意的样子。\n",this_player());
                        break;
                case 2:
                        message_vision( "白老板问$N道：有没有好剑让我来品评品评？(value)\n",this_player());
                        break;
                case 3:
                        message_vision( "白老板对$N说道：鄙人专收集名剑，若寻到好剑定要卖我。(sell)\n",this_player());
                        break;
                case 4:
                        message_vision( "白老板一见$N进来，道：这位" + RANK_D->query_respect(ob)
                                + "，快来看看本店的宝剑。(list)\n",this_player());
                        break;
        }
        return;
}
