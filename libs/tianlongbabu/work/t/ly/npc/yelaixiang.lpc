// yelaixiang.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("夜来香", ({ "ye laixiang","ye","laixiang" }) );
        set("gender", "女性" );
        set("age", 29);
        set("long",
                "夜来香用一双水汪汪的大眼睛凝视着你。\n");
        set("combat_exp", 4000);
        set("attitude", "friendly");
        set("rank_info/respect", "女老板");
        set("vendor_goods", ([
                "黄酒": __DIR__"obj/wine1",
                "清酒": __DIR__"obj/wine2",
                "红酒": __DIR__"obj/wine3",
                "竹叶青": __DIR__"obj/wine4",
]));
        setup();
        carry_object(__DIR__"obj/cloth4")->wear();
        carry_object(__DIR__"obj/shoes1")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "夜来香笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝杯酒，歇歇腿吧。\n");
                        break;
                case 1:
                        say( "夜来香微笑着迎上来，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( "夜来香说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝几杯小店的竹叶青吧，这是诗都酒馆的特产哟。\n");
                        break;
                case 3:
                        say( "夜来香从怀中掏出小镜子，对镜理了理云鬓。\n");
                        break;
        }
        return;
}
