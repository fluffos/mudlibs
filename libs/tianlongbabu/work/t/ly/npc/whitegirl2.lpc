// whitegirl2.c

#include <ansi.h>
#include <command.h>

inherit NPC;

void create()
{
        set_name("白衣女子", ({ "girl" }) );
        set("long",
                "一位身着白衣的妙龄女子。\n");
        set("attitude", "peaceful");
        set("gender", "女性" );
        set("age", 17);
        set("per", 30);
        set("combat_exp", 1);
        set("kee",1);
        setup();
        carry_object( __DIR__"obj/cloth5" )->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        add_action ("do_get","get");
}
void meeting(object ob)
{
        object jade,killer;
        if( !ob || environment(ob) != environment() )
                return;
        if( ob->query("whitegirl/wait")) {
                message_vision("白衣女子见到$N来了，高兴的扑到$N怀里。\n",ob);
                jade = new(__DIR__"obj/jade");
                jade->move(ob);
                ob->delete("whitegirl/wait");
                ob->set("whitegirl",1);
                killer = new(__DIR__"figure");
                killer->move(environment(ob));
                message_vision("黑衣人走了过来。\n",ob);
                message_vision(CYN"黑衣人阴笑道：想跑吗？去死吧！\n"NOR,ob);
                killer->kill_ob( this_object() );
                kill_ob( killer );
                return;
        }
}
int do_get(string arg)
{
        if(!arg) return notify_fail("你要捡起什麽东西？\n");
        if(arg == "girl") {
                write("你赶忙冲上去抢救，可已经来不及了。\n");
                return 1;
        }
        return 0;
}
void die()
{
        object ob;
        ob = present("figure", environment(this_object()));
        destruct(ob);
        message_vision("白衣女子口吐鲜血，倒在你怀里。\n", this_object());
        message_vision(YEL"白衣女子在你耳边说道：我..我只得到了..一分钟的自由....\n"NOR,this_object());
        message_vision(YEL"白衣女子在你耳边说道：还没来及告诉你...我的名字....\n"NOR,this_object());
        message_vision("白衣女子在你怀中揣了一样东西。\n",this_object());
        message_vision("白衣女子慢慢的合上了美丽的眼睛。\n",this_object());
        ::die();
}

