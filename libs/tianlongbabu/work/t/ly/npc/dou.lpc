// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("豆绿", ({ "dou lu","dou","lu" }) );
        set("gender", "女性" );
        set("age", 18);
        set("long",
                "豆绿见你在看她，羞怯得抬不起头来。\n");
        set("combat_exp", 2000);
        set("per", 30);
        set("attitude", "friendly");
        set("rank_info/respect", "女招待");
        set("vendor_goods", ([
                "牡丹花": __DIR__"obj/flower_mudan",
                "花锄": __DIR__"obj/flower_hoe",
]));
        setup();
        carry_object(__DIR__"obj/doucloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "豆绿笑着迎上来，说道：这位" + RANK_D->query_respect(ob)
                                + "，要买花吗？\n");
                        break;
                case 1:
                        say( "豆绿微笑着迎上来，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( "豆绿正忙着收拾花，没注意有人进来。\n");
                        break;
                case 3:
                        say( "豆绿把花摆放好，站起身来，轻轻擦了擦额头的汗珠。\n");
                        break;
        }
        return;
}
