// master_yi.c
#include <ansi.h>
inherit __DIR__"beggar0";
inherit F_MASTER;

void create()
{
        set_name("易大彪", ({ "yi dabiao", "yi","dabiao", "master" }) );

        set("gender", "男性");
        set("age", 40);
        set("long",
        "易大彪是丐帮五袋弟子中的佼佼者，曾率领丐帮弟子\n"
        "做过不少惊天动地的大事。他为人侠义，但行踪不定\n"
        "漂泊四方。从他满脸的皱纹可见饱经沧桑。\n" );

        set("attitude", "peaceful");
        create_family("丐帮", 15, "弟子");
        set("gaibang/class", 5);
        set("title","丐帮五袋弟子");
/*
        set("inquiry", ([
                "quest": (: give_quest :),
                "任务": (: give_quest :),
        ]) );
*/
        set("chat_chance", 10);
        set("chat_msg", ({
                (: do_protect :),
        }));

        set("str", 30);
        set("cor", 23);
        set("int", 30);
        set("cps", 20);
        set("per", 15);
        set("con", 25);
        set("spi", 26);

        set("force", 3000);
        set("max_force", 2000);
        set("force_factor", 80);
        set("atman",800);
        set("max_atman",800);
        
        set("combat_exp", 2000000);
        
        set_skill("unarmed", 60);
        set_skill("force", 160);
        set_skill("dodge", 60);
        set_skill("parry", 60);
        set_skill("move", 60);
        set_skill("literate", 80);
        set_skill("morality", 60);
        set_skill("beggar-steps",100);
        set_skill("beggar-force",120);
        set_skill("beggar-strike",100);

        map_skill("unarmed","dragon18-strike1");
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("parry","dragon18-strike1");


        set("inquiry", ([
		"quest": (: give_quest :),
		"任务": (: give_quest :),

                "yi dabiao" : "在下就是，您有何事？",
                "易大彪" : "在下就是，您有何事？",
                "段誉" : "段公子吗？年前我曾见过他一次，现下不知何处去了。",
                "here" : "这里是洛阳，是我们丐帮的总舵所在。",
                "name" : "我叫易大彪，小兄弟贵姓？",
                "乔峰" : "鄙帮乔帮主名讳，在下不敢直呼。",
                "丐帮" : "我们要饭的受人欺、被狗咬，不结成一伙，还有活命的份儿吗？",
                "奚长老" : "奚长老可能在大仁分舵处理帮务吧。",
                "陈长老" : "陈长老可能在大智分舵处理帮务吧。",
                "吴长老" : "吴长老可能在大礼分舵处理帮务吧。",
                "宋长老" : "宋长老可能在大信分舵处理帮务吧。",
                "传功长老" : "他可能在大义分舵处理帮务吧。",
                "执法长老" : "白长老可能在大勇分舵处理帮务吧。",

        ]) );

        setup();

        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        if(ob->query("family/family_name") != "丐帮") ob->set("gaibang/class",0);
        if( !query_heart_beat(this_object()) ) set_heart_beat(1);
}
void attempt_apprentice(object ob)
{        
        command("think");
        command("say 好吧，既然这位" + RANK_D->query_respect(ob) + 
"有此诚意，我便收你为弟子。\n");
        command("recruit " + ob->query("id") );
}


int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("title","丐帮一袋弟子");
                ob->set("gaibang/class", 1);
}

void give_rank(object ob)
{
//        int exp;
 //       string title;

        if(ob->query_skill("beggar-strike",1) >= 100 
                  && ob->query("combat_exp") > 2000000 ) {
                if(ob->query("title") == "丐帮五袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮五袋弟子。\n");
                ob->set("title", "丐帮五袋弟子");
                ob->set("gaibang/class", 5);
        } else if(ob->query_skill("beggar-strike",1) >= 80 
                  && ob->query("combat_exp") > 1000000 ) {
                if(ob->query("title") == "丐帮四袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮四袋弟子。\n");
                ob->set("title", "丐帮四袋弟子");
                ob->set("gaibang/class", 4);
        } else if(ob->query_skill("beggar-strike",1) >= 60 
                  && ob->query("combat_exp") > 500000 ) {
                if(ob->query("title") == "丐帮三袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮三袋弟子。\n");
                ob->set("title", "丐帮三袋弟子");
                ob->set("gaibang/class", 3);
        } else if(ob->query_skill("beggar-strike",1) >= 40 
                  && ob->query("combat_exp") > 100000 ) {
                if(ob->query("title") == "丐帮二袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮二袋弟子。\n");
                ob->set("title", "丐帮二袋弟子");
                ob->set("gaibang/class", 2);
        } else return;
}


