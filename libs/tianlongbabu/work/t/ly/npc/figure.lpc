// figure.c

#include <ansi.h>;
inherit NPC;

void create()
{
        set_name("黑衣人", ({ "figure" }) );
        set("gender", "男性" );
        set("age", 40);
        set("long", 
        "一个身穿黑衣的人。\n");
        
        set("combat_exp", 5000000);
        set("str", 50);
        set("force", 50000);
        set("max_force", 10000);
        set("force_factor", 300);
        set("atman",1000);
        set("max_atman",1000);
        
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
        set_skill("sword", 200);
        set_skill("parry", 200);
        set_skill("move", 200);
        set_skill("force", 200);
        set_skill("noname-sword",200);
        set_skill("beggar-force",200);
        set_skill("tianying-steps",200);
        
        map_skill("force","beggar-force");
        map_skill("sword","noname-sword");
        map_skill("parry","noname-sword");
        map_skill("dodge", "tianying-steps");
        
        set("chat_chance_combat", 99);
        set("chat_msg_combat", ({
                (: perform_action, "sword.3sword" :)
        }) );
        setup();
        carry_object("/t/yipin/npc/obj/kcloth")->wear();
        carry_object("/t/yipin/npc/obj/thinsword")->wield();
        
}

