// beggar5.c

inherit __DIR__"beggar0";

void create()
{
        set_name("乞丐", ({ "beggar" }) );
        set("gender", "男性" );
        set("age", 25);
        set("attitude", "peaceful");
        set("long", "一个破衣烂衫的乞丐。\n");
        set("combat_exp", 200000);
        set("score",40000);
        set("gaibang/class", 5);
        set("title", "丐帮五袋弟子");
        create_family("丐帮", 15, "弟子");
        set("str", 30);
        set("per", 15);
        set("force", 1400);
        set("max_force", 1200);
        set("force_factor", 80);
        
        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("parry", 90);
        set_skill("force", 90);
        set_skill("beggar-force", 90);
        set_skill("beggar-strike", 90);
        set_skill("beggar-steps", 90);
        
        map_skill("force","beggar-force");
        map_skill("dodge","beggar-steps");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 50);
        set("chat_msg",
        ({
                (: do_protect :),
        }) );
        
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
}

void attempt_apprentice(object ob)
{
        message_vision("乞丐忙起身道：在下不敢当，你还是去找九袋长老吧。\n",this_object());
        return;
}

