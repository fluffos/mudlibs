// beggar0.c -- all beggar inherit this file.

#include <ansi.h>

inherit NPC;

void meeting(object ob)
{
	if( !ob || environment(ob) != environment() )
		return;
	if ( ((string)ob->query("family/family_name") == "丐帮")
	        &&(query("gaibang/class") < ob->query("gaibang/class") )
	        &&(ob->query("gaibang/class") < 9) )
	        {
	        	if (ob->query("gender") == "男性")
	        	message_vision(query("name")+"向$N抱拳躬身道：这位师兄请了！\n", ob);
	        	else message_vision(query("name")+"向$N抱拳躬身道：这位师姐请了！\n", ob);
	        }
	if ( ((string)ob->query("family/family_name") == "丐帮")
	        &&(query("gaibang/class") < ob->query("gaibang/class") )
	        &&(ob->query("gaibang/class") > 8 ) )
       	        {
	        	message_vision(query("name")+"向$N抱拳躬身道：弟子参见长老！\n", ob);
	        }

}
void do_recover()
{
	int full_kee = query("max_kee");

	if( is_busy() )
		return;
	if( (!is_fighting()) && (query("eff_kee") < full_kee)
		&& (query("eff_kee") > (full_kee/2)) )
	{
		if( query("force") >= (query("max_force")+50) )
		{
			command("exert heal 50");
			return;
		}
		if( query("kee") > 100 )
			command("exercise 100");
		return;
	}
	if( query("kee") < (query("eff_kee")) )
	{
		if( query("force") > 100 )
			command("exert recover 100");
		else
			if( query("force") > 20 )
				command("exert recover 20");
		return;
	}
	if( query("gin") < (query("eff_gin")) )
		if( query("force") > 100 )
			command("exert refresh 100");
		else
			if( query("force") > 20 )
				command("exert refresh 20");
	return;
}

void do_protect()
{
	string *killer;
	object *pupil = all_inventory( environment() ), enemy;
	int i;

	if( (query("kee") < query("max_kee")) || (query("gin") < query("max_gin")) )
	{
		do_recover();
		return;
	}
	if( is_fighting() )
		return;
	for( i=0; i<sizeof(pupil); i++ )
	{
		if( living(pupil[i]) && pupil[i]->is_fighting() 
			&& (pupil[i]->query("family/family_name")=="丐帮") )
			{
			// by cobra
			if (!arrayp(pupil[i]->query_killer())) return;
			if (!sizeof(pupil[i]->query_killer())) return;
			killer=allocate(sizeof(pupil[i]->query_killer()));
			killer = pupil[i]->query_killer();
			// end cobra
			if( !(enemy=present(killer[0])) ) return;
			command( "heng"+getuid(enemy) );
			message_vision( YEL""+query("name")+"冲"+enemy->query("name")
				+"叫道：叫化子难道就好欺负吗？！\n"NOR, enemy );
			kill_ob( enemy );
			return;
		}
	}
}

