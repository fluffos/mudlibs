// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("杨时", ({ "yang shi","yang","shi","student" }) );
        set("gender", "男性" );
        set("age", 25);
        set("long",
                "一个年轻人正在聚精会神的读书。\n");
        set("combat_exp", 8000);
        set("title","伊川学子");
        set("attitude", "friendly");
        set("rank_info/respect", "书生");
        set("vendor_goods", ([
                "道德经": __DIR__"obj/book1",
                
]));
        setup();
        carry_object(__DIR__"obj/studentcloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "杨时低头看书，没注意有人进来。\n");
                        break;
                case 1:
                        say( "杨时微笑着迎上来，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( "杨时说道：这位" + RANK_D->query_respect(ob)
                                + "，您想选本什么书呢？\n");
                        break;
                case 3:
                        say( "杨时若有所思，嘴里低声嘟囔着。\n");
                        break;
        }
        return;
}
