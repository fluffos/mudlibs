// harlot.c

inherit NPC;

void create()
{
       set_name("青楼女子", ({ "harlot", "girl" }) );
       set("gender", "女性" );
       set("age", 19);
       set("long",
              "一个浓妆艳抹的青楼女子。\n");
       set("combat_exp", 300);
       set("attitude", "friendly");
       set("force", 150);
       set("max_force", 150);
       setup();
       carry_object(__DIR__"obj/harlotcloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if( this_player()->query("gender") =="女性" ) 
          {
        	message_vision("青楼女子带着嫉妒的眼光凝视着$N。\n", this_player());
        	return;
          }
              	switch( random(4) )
          {
                case 0:
                        message_vision( "青楼女子看见$N走了过来，忙说道：呦，这位" + RANK_D->query_respect(ob)
                                + "，还不快来我这里玩玩。\n",this_player());
                        break;
                case 1:
                        message_vision( "青楼女子向$N温柔一笑，抛了个媚眼儿...$N不禁脸红了。\n",this_player());
                        break;
                case 2:
                        message_vision( "青楼女子一手扶腰，一手理了理云鬓。\n",this_player());
                        break;
                case 3:
                        message_vision( "青楼女子一见$N，说道：这位" + RANK_D->query_respect(ob)
                                + "，一个人不寂寞吗？进来坐坐吧。\n",this_player());
                        break;
        }
        return;
}