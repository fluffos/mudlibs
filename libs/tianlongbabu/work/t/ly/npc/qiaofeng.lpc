// qiaofeng.c  乔峰--丐帮帮主

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void do_protect();
void do_recover();
void create()
{
        set_name("乔峰", ({ "qiao feng", "master" }) );

        set("gender", "男性");
        set("age", 39);
        set("long",
        "乔峰长着一张四方的国字脸，颇有风霜之色，高鼻阔\n"
        "口，浓眉大眼，顾盼之际，极有威势。他身材魁梧，\n"
        "着灰色旧布袍，已微有破烂，但英气勃发，豪气逼人，\n"
        "令人忍不住从心底赞叹：好一条大汉！\n" );

        set("attitude", "peaceful");
        create_family("丐帮", 14, "帮主");
        set("gaibang/class", 10);
        set("title",WHT"丐帮帮主"NOR);
/*
        set("inquiry", ([
                "quest": (: give_quest :),
                "任务": (: give_quest :),
        ]) );
*/
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_protect :),
        }));

        set("str", 50);
        set("per", 20);

        set("force", 4500);
        set("max_force", 8000);
        set("force_factor", 250);
        set("atman",1000);
        set("max_atman",1000);

        set("combat_exp", 15000000);
        set("score", 150000);

        set_skill("unarmed", 200);
        set_skill("force", 300);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("move", 200);
        set_skill("literate", 150);
        set_skill("morality", 100);
        set_skill("beggar-steps",200);
        set_skill("beggar-force",300);
        set_skill("beggar-strike",200);
        set_skill("dragon18-strike",180);

        map_skill("unarmed","dragon18-strike");
        map_skill("literate","morality");
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("parry","dragon18-strike");


        set("inquiry", ([
		"quest": (: give_quest :),
		"任务": (: give_quest :),

                "传功长老" : "无名长老可能在大义分舵处理帮务吧。",
                "段誉" : "很久没见到三弟了，我也很想他。",
                "here" : "这里是洛阳，是我们丐帮的总舵所在。",
                "name" : "我叫乔峰，小兄弟贵姓？",
                "乔峰" : "鄙人就是乔峰，找我有何事？",
                "丐帮" : "我们要饭的受人欺、被狗咬，不结成一伙，还有活命的份儿吗？",
                "易大彪" : "他四处漂泊，居无定所。",
                "奚长老" : "奚长老可能在大仁分舵处理帮务吧。",
                "陈长老" : "陈长老可能在大智分舵处理帮务吧。",
                "吴长老" : "吴长老可能在大礼分舵处理帮务吧。",
                "宋长老" : "宋长老可能在大信分舵处理帮务吧。",
                "执法长老" : "白长老可能在大勇分舵处理帮务吧。",
        ]) );

        setup();

        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{       
        object ob;
        ::init();
        if( interactive(ob = this_player()) 
        && !is_fighting() 
        && living(this_object())) {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        if(ob->query("family/family_name") != "丐帮") ob->set("gaibang/class",0);
        if( !query_heart_beat(this_object()) ) set_heart_beat(1);
}

void meeting(object ob)
{
        if( !ob || environment(ob) != environment()) return;
        if( (string)ob->query("family/family_name") != "丐帮") 
                {
                        switch( random(4) )
                        {
                                case 0:
                                message_vision(query("name")
                                +"冷冷的瞅了$N一眼，道：阁下并非本帮弟子，为何闯入总舵？\n",ob);
                                break;
                                case 1:
                                message_vision(query("name")
                                +"点了点头道：阁下武功令人佩服，来到此处所为何事？\n", ob);
                                break;
                                case 2:
                                message_vision(query("name")
                                +"哼了一声，道：阁下还是赶快出去吧！\n", ob);
                                break;
                                case 3:
                                message_vision(query("name")
                                +"看了$N一眼，说道：这位" + RANK_D->query_respect(ob)
                                + "，请回吧，这里不是你来的地方。\n",ob);
                                break;
                        }
                }
}

void attempt_apprentice(object ob)
{
        string name;
        name = ob->query("family/family_name");
        command("look " + ob->query("id") );
        if(!name) {
                command("say 这位"+RANK_D->query_respect(ob)+"还是先跟易大彪学些入门功夫吧。\n");
                return;
        }
        if( name != "丐帮" ) {
                command("say 阁下并非我丐帮弟子，还是先跟易大彪学些入门功夫吧。\n");
                return;
        }
        if( ob->query("gaibang/class") < 8) {
                command("say 等你升为八袋弟子，我便传你武功。加油吧！\n");
                return;
        }
        command("say 好吧，既然这位" + RANK_D->query_respect(ob) + 
"有此诚意，我便收你为弟子。\n");
        command("recruit " + ob->query("id") );

}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("title","丐帮八袋弟子");
                ob->set("gaibang/class", 8);
}

void give_rank(object ob)
{
        if(ob->query_skill("beggar-strike",1) >= 180 
                && ob->query("combat_exp") > 9000000 ) {
                if(ob->query("title") == "丐帮九袋长老") return;
                command("say 很好！从今天起，我升你为丐帮九袋长老。\n");
                ob->set("title", WHT"丐帮九袋长老"NOR);
                ob->set("gaibang/class", 9);
        } else return;
}

void do_recover()
{
        int full_kee = query("max_kee");

        if( is_busy() )
                return;
        if( (!is_fighting()) && (query("eff_kee") < full_kee)
                && (query("eff_kee") > (full_kee/2)) )
        {
                if( query("force") >= (query("max_force")+50) )
                {
                        command("exert heal 50");
                        return;
                }
                if( query("kee") > 100 )
                        command("exercise 100");
                return;
        }
        if( query("kee") < (query("eff_kee")) )
        {
                if( query("force") > 100 )
                        command("exert recover 100");
                else
                        if( query("force") > 20 )
                                command("exert recover 20");
                return;
        }
        if( query("gin") < (query("eff_gin")) )
                if( query("force") > 100 )
                        command("exert refresh 100");
                else
                        if( query("force") > 20 )
                                command("exert refresh 20");
        return;
}

void do_protect()
{
        string *killer;
        object ob,room,*pupil = all_inventory( environment() ), enemy;
        int i;
        ob = this_object();
        if(environment(ob)->query("short") != CYN"『"NOR+RED"忠义堂"NOR+CYN"』"NOR)
        {
                room = find_object("/t/ly/zytang");
                message_vision("你只觉眼前人影一闪，$N已不知去向。\n",ob);
                if(present("qiao feng", room)) {
                        call_out("destroy", 1, this_object());
                        return;
                }
                if(room) message("vision", "乔峰走了过来。\n", room);
                ob->move("/t/ly/zytang");
        }

        if( (query("kee") < query("max_kee")) || (query("gin") < query("max_gin")) )
        {
                do_recover();
                return;
        }
        if( is_fighting() )
                return;
        for( i=0; i<sizeof(pupil); i++ )
        {
                if( living(pupil[i]) && pupil[i]->is_fighting() 
                        && (pupil[i]->query("family/family_name")=="丐帮") )
                        {
                        killer = pupil[i]->query_killer();
                        // by cobra
                        if (!arrayp(pupil[i]->query_killer())) return;
                        if (!sizeof(pupil[i]->query_killer())) return;
                        killer=allocate(sizeof(pupil[i]->query_killer()));
                        killer = pupil[i]->query_killer();
                        // end cobra
                        if( !(enemy=present(killer[0])) ) return;
                        command( "heng"+getuid(enemy) );
                        message_vision( YEL""+query("name")+"冲"+enemy->query("name")
                                +"叫道：叫化子难道就好欺负吗？！\n"NOR, enemy );
                        kill_ob( enemy );
                        return;
                }
        }
}
int destroy(object ob)
{
        destruct(ob);
        return 1;
}


