// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("跑堂的", ({ "waiter","paotang" }) );
        set("gender", "男性" );
        set("age", 25);
        set("long",
                "跑堂的满脸是汗，正忙得不可开交。\n");
        set("combat_exp", 100);
        set("attitude", "friendly");
        set("rank_info/respect", "女老板");
        set("vendor_goods", ([
                "包子": "/obj/example/dumpling",
                "鸡腿": "/obj/example/chicken_leg",
                "红酒": "obj/example/wineskin",
                "碧镙春茶": __DIR__"obj/cup1",
        ]));
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "跑堂的笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝杯茶，歇歇腿吧。\n");
                        break;
                case 1:
                        say( "跑堂的用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
                                + "，里面请。\n");
                        break;
                case 2:
                        say( "跑堂的说道：这位" + RANK_D->query_respect(ob)
                                + "，您要是办酒席请上二楼。\n");
                        break;
                case 3:
                        say( "跑堂的点头哈腰的忙着招呼客人。\n");
                        break;
        }
        return;
}
