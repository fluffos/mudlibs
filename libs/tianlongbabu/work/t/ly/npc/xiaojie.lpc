// xiaojie.c

#include <ansi.h>;
inherit NPC;
int do_recover();

void create()
{
	set_name("肖杰", ({ "xiao jie", "xiao", "jie" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long", 
	"一个中年男子，腰悬长剑，他脸色阴沉，不怒自\n"
	"威。他生性高傲，看你的眼神中稍带一些不屑。\n");
	set("title", "神州剑客");
	
	set("combat_exp", 4000000);
	set("score",1000);
	set("str", 30);
	set("force", 5000);
	set("max_force", 3000);
	set("force_factor", 100);
	set("atman",1000);
        set("max_atman",1000);
	
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("sword", 200);
	set_skill("parry", 150);
	set_skill("move", 120);
	set_skill("force", 150);
	set_skill("beggar-steps",120);
        set_skill("beggar-force",120);
        set_skill("beggar-strike",120);
        
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_recover :)
        }));
	setup();
	carry_object(__DIR__"obj/cloth2")->wear();
	carry_object(__DIR__"obj/sword1")->wield();
	
}

int accept_fight(object me)
{
	if(environment(this_object())->query("short") != "剑气冲天")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆剑室来找我吧。\n");
	command("say 不必较量了，你能刺(stab)中我一剑就很了不起了。\n");
	return 0;
}

void attempt_apprentice(object ob)
{
		message_vision("肖杰对$N轻蔑一笑道：我不收徒，陪你玩玩还行。\n",this_player());
		return;
}
void init()
{
        add_action("do_stab", "stab");
}

int do_stab(string arg)
{
     object ob,me;
     int cost,imp;
     if(environment(this_object())->query("short") != "剑气冲天")
	return notify_fail("肖杰说道：这是哪儿啊？请您等一下到武馆剑室来找我吧。\n");
     me=this_player();
     cost = random(5) + ((int)me->query("int") - 15) + me->query_skill("sword") / 10;
     if(cost < 10) cost = 10;
     imp = random(5) + ((int)me->query("int") - 15) + me->query_skill("sword") / 10;
     if( !(ob = me->query_temp("weapon"))
		|| (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能操练剑法。\n");
     if((arg == "xiao jie") || (arg == "xiao") || (arg == "jie"))
         {
              if(me->is_fighting())
              return notify_fail("你无法在战斗的同时练习剑法！\n");
              if(me->is_busy())
              return notify_fail("你正忙着，无法操练剑法。\n");
              if((int)me->query("kee") < cost)
		{
			write("你累得汗流浃背，该歇会儿了。\n");
			return 1;
		}
	      if((int)me->query("gin") < 100) 
		{
			write("你的精神状态不好，无法专心练功。\n");
			return 1;
		}	
	      if(me->query_skill("sword", 1) >= 200) 
		{
			message_vision("肖杰对$N抱拳一躬道：阁下剑法已胜过我了，佩服！\n", me);
			return 1;
		}
              switch(random(3))
              {
              case 1:
                       message_vision("$N挺剑向肖杰一阵乱刺，却一招也没刺中。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 2:
                       message_vision("$N剑走轻灵，向肖杰右臂斜刺过去。\n",me);
                       message_vision("肖杰急忙向左一闪，剑尖贴身而过。\n",me);
                       me->receive_damage("kee",cost);
                       me->start_busy(1);
                       break;
              case 0:
                       message_vision(YEL"$N一剑直入中宫，迅如蛟龙！\n"NOR,me);
                       message_vision("肖杰躲闪不及，只好横剑挡出。$N对基本剑法有了更深的领悟。\n",me);
                       if( !me->query_skill("sword", 1) )
			    me->set_skill("sword", 0);
		       me->improve_skill("sword", imp);
		       me->receive_damage("kee",cost - 5);
		       me->start_busy(1);
                       break;
              }
      }
      else {write("你要刺谁？\n");}
      return 1;
}
int do_recover()
{
        object me = this_object();

        if ( me->is_fight() ) return 1;
        if ( me->query("eff_kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("healing",3);
            return 1;
        } else if ( me->query("kee") < me->query("max_kee") ) {
            command("exercise 100");
            call_out("exert_recover",3);
            return 1;
        }
        return 1;
}

int healing()
{ 
        object me = this_object();
        if ( ( me->query("force") - me->query("max_force") < 51 ) 
            || ( (int)me->query("eff_kee") < (int)me->query("max_kee") / 2 ) )
                return 1;
        else
                command("exert heal");
        return 1;
}

int exert_recover()
{ 
        command("exert recover 60");
        return 1;
}
