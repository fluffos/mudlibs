// seller.c

inherit NPC;

void create()
{
        set_name("马贩", ({ "seller" }) );
        set("gender", "男性" );
        set("age", 35);
        set("title","买的没有卖的精");
        set("per", 15);
        set("str", 35);
        set("long",
                "一位从蒙古地区过来经商的马贩，\n"
                "年龄不大却已满脸皱纹。\n");
        set("combat_exp", 25000);
        set("attitude", "friendly");
        
        set_skill("unarmed",50);
        set_skill("dodge",50);
        set_skill("parry",50);
        set("max_force",300);
        set("force",300);
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_select", "select");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "马贩说道：这位" + RANK_D->query_respect(ob)
                                + "，买马吗？一两黄金一匹。\n");
                        break;
                case 1:
                        message_vision("马贩点头哈腰的向$N致敬。\n",this_player());
                        break;
                case 2:
                        say( "马贩说道：这位" + RANK_D->query_respect(ob)
                                + "，买一匹马吧？我这里都是日行千里的良驹啊！(select)\n");
                        break;
                case 3:
                        message_vision("马贩正精心的给马刷毛，没注意$N走了过来。\n",this_player());
                        break;
        }
        return;
}
int accept_object(object me, object ob)
{
        int val;
        object horse;
        val = ob->value();
        if( (!val) || (!ob->query("money_id")) ) 
        return notify_fail(""); 
        
        if (!me->query_temp("marks/selected")) {
                if (me->query_temp("marks/will_select")) {
                        message_vision("马贩一脸疑惑的看着$N道：您还没选马就要给钱吗？\n", me);
                        message_vision("马贩厚着脸皮把钱揣了起来，还自言自语道：那我就收着吧。\n", me);
                        return 1;
                }
                if (val < 10000) {
                        message_vision("马贩一脸不屑的样子对$N道：就这点钱您还想买马啊？\n", me);
                        return 0;
                }
                if (val >= 10000) {
                        message_vision("马贩朝$N笑得满脸开花，“恕小的有眼不识财神爷，哪敢先要您钱啊”。\n", me);
                        message_vision("马贩笑呵呵问$N道：我这里有以下几种马，你想选择哪匹呢？(select 马名)\n\n", me);
                        write("『蓝蓝的天上白云飘』马市报价单\n");
                        write("========================================================\n");
                        write("◎ 青骢马       仅售 一两黄金\n");
                        write("◎ 黄骠马       仅售 一两黄金\n");
                        write("◎ 枣红马       仅售 一两黄金\n");
                        write("◎ 白龙马       仅售 一两黄金\n");
                        write("◎ 黑龙马       仅售 一两黄金\n");
                        write("◎ 赤兔马       仅售 一两黄金\n");
                        write("========================================================\n\n");
                        me->set_temp("marks/will_select", 1);
                }
                return 0;
        }
        if (me->query_temp("marks/selected")) {
                if (val >= 10000) {
                        message_vision("马贩高兴的收下$N的钱，兴奋得还想跟$N拥抱一下。\n", me);
                        message_vision("马贩从后院马厩中牵出一匹" + me->query_temp("marks/selected")
                        + "，把缰绳递给$N。\n", me);
                }
                if (val < 10000) {
                        message_vision("马贩一脸不屑的样子对$N道：就这点钱您还想买马啊？\n", me);
                        return 0;
                }
                horse = new("/t/ly/npc/horse");
                horse->move("/t/ly/horse_shop");
                horse->set("name", me->query_temp("marks/selected"));
                horse->set_temp("owner",me->query("id"));
                horse->set_leader(me);
                me->delete_temp("marks/selected");
        }      
        return 1;
}

int do_select(string arg)
{
        object me;
        me = this_player();
        message_vision("马贩突然想起昨晚不易大人跟他说过什么，朝你摇了摇头。\n", me);
        message_vision("马贩说道：对不起，最近马儿都在准备GRE考试，先不卖了。\n(编瞎话都不会，pig seller)\n", me);
        return 1;
        if (!me->query_temp("marks/selected")) {
                if (me->query_temp("marks/will_select")) {
                        if (!arg) return notify_fail("马贩疑惑的看着你，“您到底要哪匹马啊？”(select 马名)\n");
                        if (arg == "青骢马") {
                                message_vision("$N指了指那匹高头长腿的青骢马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "青骢马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        if (arg == "黄骠马") {
                                message_vision("$N指了指那匹膘肥体壮的黄骠马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "黄骠马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        if (arg == "枣红马") {
                                message_vision("$N指了指那匹神骏矫健的枣红马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "枣红马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        if (arg == "白龙马") {
                                message_vision("$N指了指那匹温顺老实的白龙马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "白龙马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        if (arg == "黑龙马") {
                                message_vision("$N指了指那匹暴躁不羁的黑龙马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "黑龙马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        if (arg == "赤兔马") {
                                message_vision("$N指了指那匹聪明伶俐的赤兔马。\n", me);
                                me->delete_temp("marks/will_select");
                                me->set_temp("marks/selected", "赤兔马");
                                message_vision("马贩朝$N点了点头道：好眼力！请付钱吧。\n", me);
                                return 1;
                        }
                        message_vision("$N看看这匹也好，看看那匹也觉得不错，一时决定不下来。\n", me);
                        message_vision("马贩对$N笑道：您要是选好了，就叫我吧。(select 马名)\n", me);
                        return 1;
                }
                message_vision("$N指着一匹马说，我要买这匹！\n", me);
                message_vision("马贩斜眼瞅了瞅$N道：有钱吗你？一匹马可要一两黄金呢。\n", me);
                return 1;
        }
        message_vision("$N指着一匹马说，我要买这匹！\n", me);
        message_vision("马贩笑着对$N道：您既然已经选了就别换了，要不我们这生意怎么做啊。\n", me);
        return 1;
}


