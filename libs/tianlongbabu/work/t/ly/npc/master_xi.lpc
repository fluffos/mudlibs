// master_xi.c
#include <ansi.h>
inherit __DIR__"beggar0";
inherit F_MASTER;

void create()
{
        set_name("奚长老", ({ "master xi", "master", "xi" }) );

        set("gender", "男性");
        set("age", 50);
        set("long",
        "奚长老是江湖闻名的丐帮“六老”之一，为人最讲义\n"
        "气。他身材矮胖，貌不惊人，但武功着实了得。当年\n"
        "曾代汪帮主受死，以救其脱险，功不可没。\n" );

        set("attitude", "peaceful");
        create_family("丐帮", 15, "长老");
        set("gaibang/class", 9);
        set("title",WHT"丐帮九袋长老"NOR);
/*
        set("inquiry", ([
                "quest": (: give_quest :),
                "任务": (: give_quest :),
        ]) );
*/
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_protect :)
        }));

        set("str", 30);
        set("cor", 23);
        set("int", 30);
        set("cps", 20);
        set("per", 20);
        set("con", 25);
        set("spi", 26);

        set("force", 4000);
        set("max_force", 3000);
        set("force_factor", 150);
        set("atman",1000);
        set("max_atman",1000);

        set("combat_exp", 5000000);

        set_skill("unarmed", 160);
        set_skill("staff", 150);
        set_skill("force", 200);
        set_skill("dodge", 140);
        set_skill("parry", 120);
        set_skill("move", 150);
        set_skill("morality", 80);
        set_skill("literate", 150);
        set_skill("beggar-steps",150);
        set_skill("beggar-force",150);
        set_skill("beggar-strike",150);
        set_skill("fumo-staff",150);

        map_skill("unarmed","beggar-strike");
        map_skill("staff","fumo-staff");
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
        map_skill("parry","fumo-staff");
        map_skill("literate","morality");


        set("inquiry", ([
		"quest": (: give_quest :),
		"任务": (: give_quest :),

                "master xi" : "我就是啊，有事吗？",
                "奚长老" : "我就是啊，有事吗？",
                "段誉" : "段公子可能去找钟灵姑娘了吧，谁知道呢？",
                "here" : "这里是洛阳，是我们丐帮的总舵所在。",
                "name" : "我姓奚，小兄弟贵姓？",
                "乔峰" : "鄙帮乔帮主名讳，在下不敢直呼。",
                "丐帮" : "我们要饭的受人欺、被狗咬，不结成一伙，还有活命的份儿吗？",
                "易大彪" : "他四处漂泊，居无定所。",
                "陈长老" : "陈长老可能在大智分舵处理帮务吧。",
                "吴长老" : "吴长老可能在大礼分舵处理帮务吧。",
                "宋长老" : "宋长老可能在大信分舵处理帮务吧。",
                "传功长老" : "他可能在大义分舵处理帮务吧。",
                "执法长老" : "白长老可能在大勇分舵处理帮务吧。",
        ]) );

        setup();

        carry_object(__DIR__"obj/cloth2")->wear();
        carry_object(__DIR__"obj/fumostaff")->wield();
}

void init()
{
        object ob,obj;
        obj=this_object();
        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        if(ob->query("family/family_name") != "丐帮") ob->set("gaibang/class",0);
        if( !query_heart_beat(this_object()) ) set_heart_beat(1);
/*      if(environment(obj)->query("short") != YEL"大仁分舵"NOR && living(this_object()))
        {
                if(random(20) > 2) return;
                room = find_object("/t/ly/alleyroom2");
                message_vision("两名丐帮弟子匆匆忙忙跑了过来。\n",obj);
                message_vision("丐帮弟子说道：参见长老！有人闯入大仁分舵。\n",obj);
                message_vision("奚长老说道：什么？快去！快去！\n",obj);
                message_vision("奚长老转身离开了。\n",obj);
                if(present("master xi", room)) {
                        call_out("destroy", 1, this_object());
                        return;
                }
                if(room) message("vision", "奚长老走了过来。\n", room);
                obj->move("/t/ly/alleyroom2");
        }*/
}
void attempt_apprentice(object ob)
{
        command("look " + ob->query("id") );
        if( ob->query("gaibang/class") < 5 ) {
                command("say 等你升为五袋弟子，我就收你为徒，加油吧！\n");
                return;
        }
        
        command("say 好吧，既然这位" + RANK_D->query_respect(ob) + 
"有此诚意，我便收你为弟子。\n");
        command("recruit " + ob->query("id") );

}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("title","丐帮五袋弟子");
                ob->set("gaibang/class", 5);
}
void give_rank(object ob)
{
//        int exp;
 //       string title;

        if(ob->query_skill("beggar-strike",1) >= 150 
                && ob->query("combat_exp") > 5000000 ) {
                if(ob->query("title") == "丐帮八袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮八袋弟子。\n");
                ob->set("title", "丐帮八袋弟子");
                ob->set("gaibang/class", 8);
        } else if(ob->query_skill("beggar-strike",1) >= 140 
                  && ob->query("combat_exp") > 4000000 ) {
                if(ob->query("title") == "丐帮七袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮七袋弟子。\n");
                ob->set("title", "丐帮七袋弟子");
                ob->set("gaibang/class", 7);
        } else if(ob->query_skill("beggar-strike",1) >= 130 
                  && ob->query("combat_exp") > 3000000 ) {
                if(ob->query("title") == "丐帮六袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮六袋弟子。\n");
                ob->set("title", "丐帮六袋弟子");
                ob->set("gaibang/class", 6);
        } else return;
}

int destroy(object ob)
{
        destruct(ob);
        return 1;
}

