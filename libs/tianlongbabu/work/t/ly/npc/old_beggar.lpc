// old_beggar.c

inherit __DIR__"beggar0";

void create()
{
	set_name("老乞丐", ({ "old beggar","beggar","old" }) );
	set("gender", "男性" );
	set("age", 59);
	set("long", "一个满脸风霜之色的老乞丐。\n");
	set("combat_exp", 500000);
	set("score",1000);
	set("title","丐帮二袋弟子");
	set("gaibang/class", 2);
	create_family("丐帮", 15, "弟子");
	set("str", 27);
	set("force", 500);
	set("max_force", 500);
	set("force_factor", 10);
	setup();
	carry_object("/obj/cloth")->wear();
	set("chat_chance", 15);
	set("chat_msg", ({
		"老乞丐说道：好心的大爷哪～ 赏我要饭的几文钱吧～\n",
		"老乞丐懒洋洋地打了个哈欠。\n",
		"老乞丐笑眯眯的看着你。 \n",
		"老乞丐笑道：走投无路之时来找我吧...... \n",
		(: random_move :)
	}) );
}
void init()
{
	object ob;

	::init();
	if( interactive(ob = this_player()))
	{
		remove_call_out("meeting");
		call_out("meeting", 1, ob);
	}
}


int accept_object(object me, object obj)
{
	command("smile");
	command("say 多谢这位" + RANK_D->query_respect(me) + "，您好心一定会有好报的！");
	return 1;
}

void attempt_apprentice(object me)
{
        command("look " + me->query("id"));
        if( me->can_afford(100) ) {
                command("say 我们丐帮只收化子，" + RANK_D->query_respect(me)
                        + "您还是回去享福吧。\n");
                return;
        } else {
                command("nod");
                message_vision("老乞丐笑咪咪说道：你去找易大彪吧。我是不收徒喽。\n",this_object());
        }
}
