//horse2.c
#include <ansi.h>  
inherit NPC;

void create()
{
        set_name("小马驹", ({ "horse" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一匹可爱的小马驹。\n");
        
        set("str", 20);
        set("cor", 30);

        set("limbs", ({ "头部", "身体", "前腿", "後腿", "尾巴" }) );
        set("verbs", ({ "bite", "kick" }) );

        set("combat_exp", 200000);

        set_skill("parry", 30);
        set_skill("unarmed", 30);
        set_skill("dodge", 20);        
        set_temp("apply/attack", 20);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 5);
        set("force", 400);
        set("max_force", 400);
        set("force_factor", 10);

        setup();
}
void die()
{
        message_vision("小马驹倒在地上，满眼带泪，悲鸣一声死去了。\n", this_object());
        ::die();
}