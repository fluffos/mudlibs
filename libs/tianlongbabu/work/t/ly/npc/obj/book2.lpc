// book2.c

inherit ITEM;

void create()
{
        set_name("残旧拳谱", ({ "book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这是一本练习拳法的入门书。\n");
                set("skill", ([
                        "name":         "unarmed",
                        "exp_required": 0,
                        "sen_cost":     20,
                        "difficulty":   20,
                        "max_skill":    80
                        ]) );
        }
}
