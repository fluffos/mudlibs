// obj: cup5.c
inherit ITEM;

void create()
{
        set_name("养心茶", ({ "yangxin" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long", "一只茶杯，里面是独特的养心茶水！\n");
        set("unit", "个");
        set("value", 200);
        }
}
void init()
{
	add_action("do_drink", "drink");
}

int do_drink( string arg )
{
	object me;
	int diff,app_water, app_status,status;

	me = this_player();
    	if( me->is_fighting() || me->is_busy() )
		return notify_fail("你正忙着呢，不能喝东西！\n");
	else
	{
		app_water = 200;
		diff = me->max_water_capacity() - me->query("water");
		if( diff < app_water ) app_water = diff;
		if( diff <= 0 ) app_water = 0;
		if( arg == "yangxin")
		{
			if( diff <= 0 )
			return notify_fail("你已经喝得太饱了！\n");
			me->add("water",app_water);
			message_vision("$N咕咚咕咚喝下一杯养心茶，只觉得顿时神清气爽。\n",me);
			app_status = 100;
			status = me->query("max_gin") - me->query("gin");
			if ( app_status > status ) app_status = status;
			me->add("gin",app_status);
			destruct(this_object());
			return 1;
		}
	}
}