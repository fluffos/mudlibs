// med1.c

inherit ITEM;

void create()
{
	set_name("云南白药",({"baiyao"}));
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
		"这是一包精制云南白药，专治跌打损伤，请内服(apply)。\n");
	    set("unit","包");
	    set("value", 1000);
	}
}

void init()
{
	add_action("apply_medicine","apply");
}

int apply_medicine(string arg)
{
	int value = 20;
	int diff;
	if(!arg || arg != "baiyao")
                return notify_fail("你要服用哪种药？\n");
	if(this_player()->is_fighting())
		return notify_fail("战斗中不能用药治伤！\n");

	diff = this_player()->query("max_kee")-this_player()->query("eff_kee");
	if(!(diff)) return notify_fail("你没有受伤啊？\n");

	if(value > diff) value = diff;
	    
	message_vision("$N敷上一包$n。\n", this_player(), this_object());
	this_player()->add("eff_kee",value);
	destruct(this_object());

	return 1;
}
