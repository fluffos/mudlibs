// armor.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("铁甲", ({"armor" }));
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 15);
	}
	setup();
}
