// shoes4.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("六合靴", ({ "six shoes","shoes" }) );
        set_weight(1000);
        if(clonep())
                set_default_object(__FILE__);
        else {
                set("long", "用普通的皮革做的，但由於形式别出心裁，\n风格与众不同，所以博得六合之美称。\n");
                set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 3);
                set("value", 500);
        }
        setup();
}

