//horsecard  这个物件是看不见的，只有骑在马上时才会有。
#include <ansi.h>
inherit ITEM;
int create()
{
	set_name("马证", ({ "horsecard" }) );
	set_weight(0);
	set("no_show",1);
	if( clonep() )
		set_default_object(__FILE__);
	set("unit", "本");
	set_temp("hname","白龙马");
	set("value", 0);
	setup();
}
void init()
{
	if(this_player()->query_temp("onhorse")) {
		add_action("do_unride","unride");
		add_action("do_quit","quit");
		add_action("do_sleep","shui");
		add_action("do_sleep","sleep");
		add_action("do_exercise","exercise");
		add_action("do_exercise","dazuo");
		add_action("do_meditate","meditate");
		add_action("do_meditate","tuna");
		add_action("do_exert","exert");
		add_action("do_get","get");
	}
}

void do_unride()
{
	object ob,me;
	string hname;
	me = this_player();
	hname = this_object()->query_temp("hname");
	ob = new("/t/ly/npc/horse1");
	ob->move(environment(me));
	ob->set("name",hname);
	ob->set_temp("rider",me->query("id"));
        ob->set_leader(me);
        ob->set_skill("move",500);
        me->delete_temp("onhorse");
        me->delete("arrive_msg");
        me->delete("leave_msg");
        me->delete("long");
        switch (random(3)) {
			case 0:
			message_vision(YEL"众人只觉眼前一花，$N已轻飘飘跃下马背。\n"NOR, me);
			break;
			case 1:
			message_vision("$N缓缓踢蹬翻身下马，身行凝重，脚步稳当。\n", me);
			break;
			case 2:
			message_vision("$N从马屁股上出溜下来，差点被马蹄踢掉下巴。  :(\n", me);
			break;
		}
		return 0;
}
void do_quit()
{
	object me,ob;
	string hname;
	me = this_player();
	hname = query_temp("hname");
	if(me->query_temp("onhorse")) {
	me = this_player();
	ob = new("/t/ly/npc/horse1");
	ob->move(environment(me));
	ob->set("name",hname);
	ob->set_temp("rider",me->query("id"));
        me->delete_temp("onhorse");
        me->delete("arrive_msg");
        me->delete("leave_msg");
        me->delete("long");
        }
}
