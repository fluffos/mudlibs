// flower.c

#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create()
{
        //int i, count;
        string *order=
({
        RED"丹炉焰"NOR,
        MAG"露珠粉"NOR,
        WHT"针页牡丹"NOR,
        YEL"八艳状"NOR,
        WHT"玉板白"NOR,
        WHT"丛中笑"NOR,
        YEL"黄金轮"NOR,
        CYN"天女散花"NOR,
        BLU"茄兰豆纱"NOR,
        YEL"黄花奎"NOR,
        CYN"掌花案"NOR,
        GRN"豆绿"NOR,
        YEL"银粉金鳞"NOR,
        CYN"罗春池"NOR,
        RED"园林好"NOR,
        WHT"中秋月光"NOR,
});
        set_name( order[random(16)], ({ "flower" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一朵含苞欲放的牡丹花。\n");
                set("unit", "朵");
                set("value", 6);
                set("material", "plant");
                set("armor_prop/armor", 0);
                set("armor_prop/personality", 5);
                set("wear_msg", "$N轻轻地把一朵$n插在发髻上。\n");
                set("unwield_msg", "$N轻轻地把$n从发髻上摘了下来。\n");
                set("female_only", 1);

        }
        setup();
}
