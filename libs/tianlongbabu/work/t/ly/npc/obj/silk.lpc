//silk.c
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name( "丝巾", ({ "silk" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long","这是一条白色的丝巾，摸起来柔滑舒适，可以用来擦汗(sweat)。\n");
                set("value", 500);
                set("material", "silk");
              }
}
void init()
{
        add_action("do_sweat", "sweat");
}
int do_sweat(string arg)
{
        object me, ob;
        me = this_player();
        if(!arg || arg == "")
        {
                if( me->query("gender") == "女性" )
                message_vision("$N低着头把丝巾在手指上缠来缠去，心里似乎有什么话想说又说不出口。\n"NOR,me);
                else
                message_vision("$N拿起丝巾在鼻前闻了闻，哇～好香啊！\n",me);
                return 1;
        }
        ob = present(arg, environment(me));
        if(!ob) return notify_fail("这里没这人！\n");
        if(!ob->is_character() || ob->is_corpse())
        return notify_fail("看清楚一点，那并不是活物。\n");
        if(ob == me)
        {
                if( me->query("gender") == "女性" )
                message_vision(YEL"$N翘着兰花指拈起丝巾，轻轻擦了擦鬓角腮边的汗水。\n"NOR,me);
                else
                message_vision("$N用丝巾轻轻擦了擦鼻翼的汗水，一付扭扭捏捏的女人样子！\n",me);
                return 1;
        }
        if(ob->query("gender") == me->query("gender"))
        return notify_fail("对方会觉得很别扭的，还是算了吧。\n");
        if(me->query("gender") == "女性")
        message_vision("$N从袖中抽出丝巾，为$n轻轻擦去额头的汗水，眼中一片仰慕之意。\n", me, ob);
        else
        message_vision("$N用丝巾轻轻擦去$n腮边的泪珠，叹口气道：你知道我的心... \n", me, ob);
        return 1;
        
}
