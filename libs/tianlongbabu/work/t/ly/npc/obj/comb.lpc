// hairpin.c

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name(YEL"木梳"NOR, ({ "comb" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一把褐色的木梳，质朴无华。\n" );
		set("unit", "把");
		set("material", "wood");
		set("value", 500);
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 2);
	}
	setup();
}

void init()
{
        add_action("do_comb", "comb");
}

int do_comb(string arg)
{
	object me, ob;
	me = this_player();
	if(!arg || arg == "")
        {
                write("你要梳理什么？\n");
                return 1;
        }
	if((arg == "头发") || (arg == "hair")) {
		if( me->query("gender") == "女性" )
		message_vision("$N将一头乌黑的长发披散下来，用木梳轻轻梳理。\n", me);
		else
		message_vision("$N拿起木梳，在自己的短发上拢了拢。\n", me);
		return 1;
	} else {
                ob = present(arg, environment(me));
                if(!ob) return notify_fail("这里没这人！\n");
                if(!ob->is_character() || ob->is_corpse())
                        return notify_fail("看清楚一点，那并不是活物。\n");
                if(ob->query("gender") == me->query("gender"))
                        return notify_fail("对方会觉得很别扭的，还是算了吧。\n");
                if(me->query("gender") == "女性")
                message_vision("$N用木梳轻轻梳理着$n的黑发，眼中一片柔情。\n", me, ob);
                else
                message_vision("$N走到$n身后，将$n的长发散开，轻轻梳理... \n", me, ob);
                return 1;
        }
        
}