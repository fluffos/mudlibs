// feather.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(WHT"羽绒服"NOR, ({ "cloth" }) );
        set_weight(0);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","这是一件特别暖和的羽绒服，穿起来很舒服。\n");
                set("unit", "件");
        set("value", 10000);
        set("material", "feature");
        set("armor_prop/personality", 10);
        set("armor_prop/armor", 10);
        }
        setup();
}

void init()
{
        add_action("do_wear","wear");
}

int do_wear( string arg)
{
        object ob, me = this_player();

        if((ob = present(arg)) == this_object() )
            if ( me->query("age") < 22 ) {
                message_vision(HIY"$N太瘦了，如何穿得了这件衣服！\n"NOR,me);
                return 1;
            } else {
                ob->wear();
                message_vision("$N穿上一件"+ob->name()+"。\n",me);
                return 1;
            }
        else return 0;
}
        
int query_autoload() { return 1; }

