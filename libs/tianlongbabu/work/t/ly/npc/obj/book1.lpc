// book1.c

inherit ITEM;

void create()
{
        set_name("「道德经」", ({ "book" }));
        set_weight(400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("value", 500);
                set("long",
                        "这是一卷道德经。\n");
                set("skill", ([
                        "name":         "literate",
                        "exp_required": 0,
                        "sen_cost":     20,
                        "difficulty":   20,
                        "max_skill":    50
                        ]) );
        }
}
