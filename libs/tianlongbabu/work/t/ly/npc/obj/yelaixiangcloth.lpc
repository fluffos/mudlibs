// yelaixiangcloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(MAG"绫罗绛纱"NOR, ({ "cloth"}) );
        set_weight(1000);
        set("value",500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 15);
        set("long", "这是一件绫罗绛纱。\n");

        }
        setup();
}
