// obj: cup4.c
inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name("茶杯", ({ "cup" }) );
    set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long", "一只茶杯，里面是香浓的铁观音茶水！\n");
                set("unit", "个");
        set("value", 20);
        set("max_liquid", 100);
        }

        // The liquid contained in the container is independent, we set a copy
        // in each cloned copy.
        set("liquid", ([
                "type": "water",
        "name": "铁观音茶",
        "remaining": 20,
        "drunk_apply": 50,
        ]) );
}
