// yelaixiangcloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(WHT"白纱"NOR, ({ "cloth"}) );
        set_weight(1000);
        set("value",800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "条");
        set("material", "cloth");
        set("armor_prop/armor", 5);
        set("long", "这是一条白纱，可以围在身上。\n");

        }
        setup();
}
