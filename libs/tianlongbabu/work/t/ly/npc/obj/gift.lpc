//gift.c 礼物模板，名字和描述都由赠者设定
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name( "小礼物", ({ "gift" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long","这是一个小礼物。\n");
              }
}
        
