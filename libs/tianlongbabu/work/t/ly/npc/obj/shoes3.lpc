// shoes3.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("牛皮长靴", ({ "boots" }) );
        set_weight(1000);
        if(clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一双用水牛皮磨制而成的长靴，坚硬无比。\n");
                set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 10);
                set("value", 1000);
        }
        setup();
}

