//letter.c 老爹的遗书
inherit ITEM;
void create()
{
        set_name( "遗书", ({ "letter" }));
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("long",".\n");
                set("value", 0);
              }
}

