// wine2.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("酒壶", ({ "wine" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个制做精细的酒壶。\n");
		set("unit", "个");
		set("value", 100);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "清酒",
		"remaining": 5,
		"drunk_apply": 5,
	]) );
}
