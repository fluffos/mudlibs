// shoes2.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name(CYN"踏云靴"NOR, ({ "cloudy shoes","shoes" }) );
        set_weight(1000);
        if(clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一双用普通布做的靴子，靴梆两侧绣着云彩图案。\n");
                set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 5);
                set("value", 500);
        }
        setup();
}

