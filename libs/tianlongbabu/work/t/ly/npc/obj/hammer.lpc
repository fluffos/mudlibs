// hammer.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("铁锤", ({ "hammer" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "柄");
		set("long", "一柄入手沉重的铁锤。\n");
                set("value", 400);
                set("material", "iron");
		set("wield_msg", "$N拿出一只铁锤握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(15);
        setup();
}
