// cloth5.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(WHT"白纱"NOR, ({ "cloth"}) );
        set_weight(100);
        set("value",500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 1);
        set("long", "这是一件白纱。\n");

        }
        setup();
}

