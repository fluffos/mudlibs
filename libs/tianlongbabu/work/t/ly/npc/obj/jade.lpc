//jade.c 温玉
#include <armor.h>
#include <ansi.h>
inherit FINGER;
void create()
{
        set_name( "温玉", ({ "jade" }));
        set_weight(0);
        set("no_get", 1);
        set("no_drop", 1);
        set("no_give", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long","这是一块碧绿晶莹的温玉，散发出润泽的光芒。\n你可以借助温玉神奇的魔力给你的朋友送礼物(present)。\n");
                set("material", "stone");
                set("armor_prop/armor", 0);
                set("armor_prop/personality", 3);
                set("wear_msg", "$N戴上一块碧绿晶莹的$n。\n");
                set("remove_msg", "$N将$n取了下来。\n");


              }
}
int query_autoload()
{
        return 1;
}
void init()
{
        add_action("do_present","present");
}
int do_present(string arg)
{
        int times;
        string msg,target;
        object me,obj,gift;
        me = this_player();
        times = me->query("jade/presents");
        if(!arg || sscanf(arg, "%s to %s",msg,target)!=2)
        return notify_fail("指令格式: present <礼物中文名称> to <玩家ID>\n\n");
        if(times > 50) return notify_fail("温玉一点反应也没有。\n");
        obj = find_player(target);
        if(!obj || !me->visible(obj)) return notify_fail("温玉闪了一下，好象没有找到你的朋友....。\n");
        if((string)obj->query("gender") == (string)me->query("gender"))
                return notify_fail("温玉一点反应也没有。\n");
        write(RED"温玉散发出柔和的光芒，将你的礼物『"+msg+"』给"+obj->query("name")+"("+target+")送去。\n"NOR);
        tell_object(obj, RED "一个柔和的声音在你耳边响起：有人送你礼物。\n" NOR);
        gift = new(__DIR__"gift");
        gift->set("name",msg);
        gift->set("long",me->query("name")+"("+me->query("id")+")送你的礼物 ---- "+msg+" ，喜欢吗？\n祝你快乐！ :P\n\n");
        gift->move(obj);
        times = times + 1;
        me->set("jade/presents",times);
        return 1;
}

        
