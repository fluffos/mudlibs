//staff.c
 
#include <weapon.h>

inherit STAFF;

void create()
{
        set_name("钢杖", ({ "staff" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根黑黝黝的钢杖，有鹅蛋粗细，入手沉甸甸的。\n");
                set("value", 1000);
                set("wield_msg", "不知何时$N手中已握了一根$n。\n");
                set("unwield_msg", "$N将手中的$n插入腰间。\n");
        }
        init_staff(30);
        setup();
}

