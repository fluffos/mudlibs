// sword.c

#include <weapon.h>
inherit SWORD;

void create()
{
       set_name("苍蝇拍" ,({ "pai" }) );
       set_weight(2000);
       if( clonep() )
              set_default_object(__FILE__);
       else {
              set("unit", "把");
              set("value", 800);
              set("material", "iron");
              set("long", "这是一把苍蝇拍。\n");
              set("wield_msg", "$N嗖的抽出一把$n。\n");
              set("unequip_msg", "$N把手中的$n插回腰间。\n");
       }
       init_sword(20);
       setup();
}
