{
  string str;
  int iswiz=0;
  
  if (wizardp(this_user())) iswiz=1;
  str="你翻开《天龙八部排行榜》，只见上面写着：\n"+
        "------------------------------------------------------------\n"+
        "上卷: 百名高手排行榜\n";
  write(str);
  str=HIB"第一章    十大高手排行榜  ------------------------  r1"NOR
+"\n"+HIB"第二章至第十章  十一至一百名 -----------------  r2-r10"NOR
+"\n"+HIB"第十一章  少侠 ----------------------------------- r11"NOR
+"\n"+HIB"第十二章  十大年青高手  -------------------------- r12"NOR          
+"\n";
  write(str);
  write("下卷: 特殊技能排行榜\n");
str= HIB"第一章    十大高手排行榜  ------------------------  p1"NOR
+"\n"+HIB"第二章    十大富翁排行榜  ------------------------  p2"NOR
+"\n"+HIB"第三章    十大内功高手  --------------------------  p3"NOR+"\n";
write(str);
str=  HIB"第四章    十大寿星排行榜  ------------------------  p4"NOR
+"\n"+HIB"第五章    踏雪无痕  ------------------------------  p5"NOR
+"\n"+HIB"第六章    神拳无敌  ------------------------------  p6"NOR
+"\n"+HIB"第七章    十大剑客  ------------------------------  p7"NOR
+"\n"+HIB"第八章    神州刀客  ------------------------------  p8"NOR+"\n";
write(str);
str=  HIB"第九章    文化名人  ------------------------------  p9"NOR
+"\n"+HIB"第十章    天下神偷  ------------------------------  p10"NOR
+"\n"+HIB"第十一章  暗器名家  ------------------------------  p11"NOR
+"\n"+HIB"第十二章  杖客  ----------------------------------  p12"NOR+"\n";
write(str);
str=  HIB"第十三章  三板斧  --------------------------------  p13"NOR
+"\n"+HIB"第十四章  神鞭  ----------------------------------  p14"NOR
+"\n"+HIB"第十五章  八大锤  --------------------------------  p15"NOR;
if (iswiz) {
  str+="\n"+HIB"第十六章  十大要犯 -------------------------------  p16"NOR;
  str+="\n"+HIB"第十七章  进步最快高手 ---------------------------  p17"NOR;
  str+="\n"+HIB"第十八章  最近进步最快高手 -----------------------  p18"NOR;
  }
str+="\n"+   "=======================================================\n";
write(str);
str=     "                  ----"+printdate+"出版\n"+
         "你要阅读哪一章?\n";
write(str);
}

void print_topten(int item)
{
  string str;
  int i,*pf;
  mapping *tl;
  mixed toplist;
  int iswiz=0;

  if ( wizardp(this_user())) iswiz=1;
  toplist=TOPD->query_topten();
  pf=print_fields[item];
  tl=toplist[pf[0]];
  str="你翻到";
  str+=(item<12)?"上":"下";
  str+="卷第";
  str+=(item<12)?chinese_number(item+1):chinese_number(item-10);
  str+="章\n『"+
        title[item]+"』,只见上面写着: \n\n";
  write(str);
  write("当今江湖排名如下: \n");
  write("----------------------------------------------\n");
  for (i=pf[1];i<pf[2]+pf[1];i++)
    {
      if (iswiz) 
         str="";
      else
         str="    ";
      str+=HIY"第"+chinese_number(i+1)+"名 "NOR;
      if (!((i+1) % 10)&&(i>20)) str+="  ";
      str+=tl[i]["name"]+NOR;
      str+=(iswiz)?(" ["+tl[i]["key"]+"]\n"):"\n";
      write(str);
    };
  write("===============================================\n");
}

