//new topten, created by mirr, June 1998
#include <ansi.h>
#define TOPD "/adm/daemons/toptend"

inherit ITEM;

// Used to control the output of the topten.
// field 0: the table to query, field 1: start position,
// field 2: the list number.
mixed print_fields=({ ({0,0,10}), ({0,10,10}), ({0,20,10}),
                      ({0,30,10}), ({0,40,10}), ({0,50,10}),
                         ({0,60,10}),({0,70,10}),({0,80,10}),
                        ({0,90,10}),
                      ({15,0,10}), ({16,0,10}),
                      ({1,0,10}), ({2,0,10}),({3,0,10}), ({4,0,10}),
                      ({5,0,10}), ({6,0,10}),({7,0,10}), ({8,0,10}),
                      ({9,0,10}), ({10,0,5}),({11,0,5}), ({12,0,3}),
                      ({13,0,5}), ({14,0,8}), 
                      ({17,0,10}),({18,0,10}), ({19,0,10}) });

mixed title=({"十大高手排行榜","十一至二十名高手排行榜",
                "二十一至三十名高手排行榜",
                "三十一至四十名高手排行榜","四十一至五十名高手排行榜",
               "五十一至六十名排行榜","六十一至七十名排行榜",
                "七十一至八十名排行榜","八十一至九十名排行榜",
                "九十一至一百名排行榜",
                "少侠","年青高手",
                "大富翁","内功高手","老寿星","踏雪无痕",
                "神拳无敌","十大剑客","神州刀客","文化名人",
                "十大神偷","暗器名家","杖客","三板斧",
                "神鞭","八大锤",
                "十大要犯","成长最快","突飞猛进"
 });

string printdate= NATURE_D->game_time();

void create();
void init();
int do_read(string arg);
void print_topten_help();
void print_topten(int item);

void create()
{
  set_name("新天龙八部排行榜",({ "ntopten" }));
  set_weight(800);
  set("unit","本");
  set("long","这是记载天龙八部江湖排行的书, 你可以用(read)来查阅.\n");
  set("value",10000);
  set("material","paper");
}

void init()
{
  if (wizardp(this_user()))
     add_action("remove_user","remove_user");
  add_action("do_read","read");
}

int remove_user(string arg)
{
  string user_id;
  int item; //,updated;

  if (sscanf(arg,"%s r%d",user_id,item)==2)
    item=((item<=12)&&(item>=1))?item-1:-2;
  else if (sscanf(arg,"%s p%d",user_id,item)==2)
    {
       if (item==1) item=0;
       else if 
         ((item>18)||(item<1)) item=-2;
       else
         item+=10;
     }
   else if (arg)
     item=-1;
   else item=-2;
   if (item==-1) {
      if (TOPD->remove_user(arg))
        printf("OK, user '%s' is removed!\n",arg);
      else
        printf("User '%s' is not in topten list!\n",arg);
    } else if (item>=0) {
      if (TOPD->remove_user_item(user_id,print_fields[item][0]))
        printf("OK, user '%s' is moved from list!\n",user_id);
      else
        printf("User '%s' is not in list!\n",user_id);
    } else
      printf("Usage: remove_user <user_id> [<item>]\n");
  return 1;
}

int do_read(string arg)
{
  int i;
  int item=-1;
//  string str;
  int iswiz=0;

  if ( wizardp(this_user())) iswiz=1;
  if (!arg) {return 0;};
  if ((arg=="topten")||(arg=="新天龙八部排行榜")||(arg=="ntopten"))
    {
      print_topten_help();
      return 1;
    };
  if (arg[0]=='r')
    {
      sscanf(arg,"r%d",i);
      if ((i<=0)||(i>12))
        item=-1;
      else
        item=i-1;
    }
  else if (arg[0]=='p')
    {
      sscanf(arg,"p%d",i);
      if ((i<=0)||(i>18))
        item=-1;
      else if (i==1)
        item=0;
      else if ((i<16)||iswiz)
        item=i+10;
    };
  if (item==-1)
    return 0;
  else
    print_topten(item);
  return 1;
}

