// mingcloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(CYN"淡青衫子"NOR, ({ "cloth"}) );
        set_weight(1000);
        set("value",500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 1);
        set("long", "这是一件淡青衫子。\n");

        }
        setup();
}
