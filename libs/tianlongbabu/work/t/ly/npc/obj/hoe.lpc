// blade.c

#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("花锄", ({ "hoe" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 500);
		set("material", "iron");
		set("long", "这是一把专用于种花的锄头。\n");
		set("wield_msg", "$N将一把$n扛在肩头。\n");
		set("unequip_msg", "$N将肩头上的$n放了下来。\n");
	}
	init_staff(10);
	setup();
}
