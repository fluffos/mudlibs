// shoes5.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("灰布僧鞋", ({ "shoes" }) );
        set_weight(500);
        if(clonep())
                set_default_object(__FILE__);
        else {
                set("long", "专为出家人准备的灰布僧鞋，平凡质朴。\n");
                set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 1);
                set("value", 300);
        }
        setup();
}

