// med2.c

inherit ITEM;

void create()
{
	set_name("提神草药",({"caoyao"}));
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
		"一包提神草药，内服(apply)后可以起到提神醒脑的疗效。\n");
	    set("unit","包");
	    set("value", 1000);
	}
}

void init()
{
	add_action("apply_medicine","apply");
}

int apply_medicine(string arg)
{
	int value = 20;
	int diff;
        if(!arg || arg != "caoyao")
                return notify_fail("你要服用哪种药？\n");
	if(this_player()->is_fighting())
		return notify_fail("战斗中不能用药！\n");

	diff = this_player()->query("max_gin")-this_player()->query("eff_gin");
	if(!(diff)) return notify_fail("没病不要乱吃药！\n");

	if(value > diff) value = diff;
	    
	message_vision("$N服下一包$n。\n", this_player(), this_object());

	this_player()->add("eff_gin", value);

	destruct(this_object());
	return 1;
}
