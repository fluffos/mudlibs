// xucloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(YEL"浅黄马褂"NOR, ({ "cloth"}) );
        set_weight(2000);
        set("value",800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 20);
        set("long", "这是一件浅黄色的马褂。\n");

        }
        setup();
}
