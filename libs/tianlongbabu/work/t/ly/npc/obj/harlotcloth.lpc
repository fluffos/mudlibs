// harlotcloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(HIG"翠绿小袄"NOR, ({ "cloth"}) );
        set_weight(1000);
        set("value",1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "条");
        set("material", "cloth");
        set("armor_prop/armor", 5);
        set("long", "这是一件翠绿小袄，颜色浓艳庸俗的很。\n");

        }
        setup();
}
