//horsewhip
#include <ansi.h>
#include <weapon.h>
inherit WHIP;
void create()
{
        set_name( "马鞭", ({ "whip" }) );
        set_weight(500);
        set_temp("hname","白龙马");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("value", 500);
                set("no_drop",1);
                set("no_give",1);
                set("material", "skin");
                set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n束在腰间。\n");
        }
        init_whip(5);

        setup();
}

void init()
{
		add_action("do_ride", "ride");
		add_action("do_unride","unride");
		add_action("do_quit","quit");
/*		add_action("do_sleep","shui");
		add_action("do_sleep","sleep");
		add_action("do_exercise","exercise");
		add_action("do_exercise","dazuo");
		add_action("do_meditate","meditate");
		add_action("do_meditate","tuna");
		add_action("do_exert","exert");
		add_action("do_get","get");*/
}
int do_ride(string arg)
{
	object me, ob, horse;
	me = this_player();
	ob = this_object();
	if(!arg || arg != "horse") return notify_fail("你要骑什么？\n");
	if(me->query_temp("onhorse"))
	return notify_fail("你已经骑在马上了。\n");
	if(me->is_busy()) return notify_fail("你正忙着呢，做不了任何事！\n");
	horse = present(arg,environment(me));
	if(!horse) return notify_fail("你的马不在身边啊！\n");
	if(ob->query_temp("rider") != me->query("id") ) {
		message_vision("$N想去偷马,结果被$n一蹶子踹在小肚子上...\n",me,horse);
		me->add("kee",-10);
		return 1;
	}
	else
	{
		me->set_temp("onhorse",1);
		me->set("arrive_msg","骑着马走了过来");
		me->set("leave_msg","骑着马离开了");
		me->set("long",me->query("name")+"正神气活现的骑在一匹"+horse->query("name")+"上。\n");
		call_out("destroy", 1, horse);
		switch (random(3)) {
			case 0:
			message_vision(YEL"$N身形一晃，轻飘飘跃上马背。\n"NOR, me);
			message_vision("$N前踢抬起，昂首嘶鸣，鬃毛随风而舞。\n", horse);
			break;
			case 1:
			message_vision("$N左足踏稳马镫，一翻身已稳稳坐在马背之上。\n", me);
			message_vision("$N摇头晃脑，打着响鼻，一边用前蹄在地上刨个不停。\n", horse);
			break;
			case 2:
			message_vision("$N笨手笨脚的往马背上爬去，摇摇晃晃仿佛随时会摔下来。\n", me);
			message_vision("$N一动不动低着头吃草，只有尾巴摇来摇去。\n", horse);
			break;
		}
		write("下马请用(unride)指令。\n");
		return 1; 
	}
	
}

int do_unride(string arg)
{
	object ob,me;
	string hname;
	me = this_player();
	hname = this_object()->query_temp("hname");
	if(!arg || arg != "horse") return notify_fail("你要从什么上下来？\n");
	if(!me->query_temp("onhorse"))
	return notify_fail("你本来就在马下。\n");
	if(me->is_busy()) return notify_fail("你正忙着呢，做不了任何事！\n");
	ob = new("/t/ly/npc/horse1");
	ob->move(environment(me));
	ob->set("name",hname);
	ob->set_temp("rider",me->query("id"));
        ob->set_leader(me);
        ob->set_skill("move",500);
        me->delete_temp("onhorse");
        me->delete("arrive_msg");
        me->delete("leave_msg");
        me->delete("long");
        me->start_busy(1);
        switch (random(3)) {
			case 0:
			message_vision(YEL"众人只觉眼前一花，$N已轻飘飘跃下马背。\n"NOR, me);
			break;
			case 1:
			message_vision("$N缓缓踢蹬翻身下马，身行凝重，脚步稳当。\n", me);
			break;
			case 2:
			message_vision("$N从马屁股上出溜下来，差点被马蹄踢掉下巴。  :(\n", me);
			break;
		}
		return 1;
}
int do_quit()
{
	object me,ob;
	string hname;
	me = this_player();
	hname = query_temp("hname");
	if(me->query_temp("onhorse")) {
	me = this_player();
	ob = new("/t/ly/npc/horse1");
	ob->move(environment(me));
	ob->set("name",hname);
	ob->set_temp("rider",me->query("id"));
        me->delete_temp("onhorse");
        me->delete("arrive_msg");
        me->delete("leave_msg");
        me->delete("long");
        }
        return 0;
}

int destroy(object ob)
{
        destruct(ob);
        return 1;
}
