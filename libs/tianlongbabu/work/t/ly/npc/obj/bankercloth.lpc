// bankercloth.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create ()
{
        set_name(HIY"金钱锦袍"NOR, ({ "cloth"}) );
        set_weight(3000);
        set("value",500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "件");
        set("material", "cloth");
        set("armor_prop/armor", 15);
        set("long", "这是一件华丽锦袍，上面绣着金黄色的大铜钱。\n");

        }
        setup();
}
