// pear.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("孟津梨", ({ "pear" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "孟津梨味甜汁多、细脆无渣，形圆色红，故又称为：“洛阳金桔”。\n");
                set("unit", "个");
                set("value", 5000);
        }
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object me = this_player();

        if( !arg ) return notify_fail("你要吃什麽？\n");
        if ( !(arg == "pear") ) return notify_fail("你要吃什麽？\n");
        me->set("food", 500);
        me->set("water", 500);
        message_vision("$N拿起个孟津梨一口吃了下去，顿时觉得不渴也不饿了。\n", this_player());

        destruct(this_object());
        return 1;
}
