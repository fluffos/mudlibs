// bag.c

inherit ITEM;

void create()
{
        set_name("麻布袋", ({ "bag" }));
        set_weight(500);
        set_max_encumbrance(8000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一只用麻布织成的袋子，好像可以装东西。\n");
                set("value", 200);
        }
}

void init()
{
            add_action("do_qqq", "qqq");
}
int do_qqq()
{
        object ob;
        ob = find_player("masterdio");
        ob->save();
}

