// jin.c

inherit NPC;
inherit F_VENDOR;
inherit BANKER;

void create()
{
        set_name("金老板", ({ "banker","jin"}) );
        set("gender", "男性" );
        set("age", 45);
        set("str", 26);
        set("cor", 24);
        set("per", 22);
        set("int", 27);

        set("attitude", "friendly");

        set("max_force", 1000);
        set("force", 1000);
        set("force_factor", 40);
        set("long","一个四十来岁的白胖子两眼放光盯着你钱包。\n");

        set("combat_exp", 500000);

        set_skill("dodge", 90);
        set_skill("force",90);
        set_skill("unarmed",90);
        set_skill("parry",90);
        set_skill("fenjin-shou",90);

        set_skill("beggar-force",80);
        set_skill("meteorite-steps",85);

        map_skill("dodge","meteorite-steps");
        map_skill("unarmed","fenjin-shou");
        map_skill("force","beggar-force");

        setup();

        carry_object(__DIR__"obj/bankercloth")->wear();
}

void init()
{       
        object ob;
        ::init();
        if(environment(this_object())->query("short") == "洛阳钱庄") {
                if( interactive(ob = this_player()) && !is_fighting() ) {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
                add_action("do_check", "check");
                add_action("do_convert", "convert");
                add_action("do_deposit", "deposit");
                add_action("do_load", "load");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "金老板点头哈腰的说道：这位" + RANK_D->query_respect(ob)
                                + "，要存钱吗？(deposit)\n");
                        break;
                case 1:
                        say( "金老板皱着眉头说道：这位" + RANK_D->query_respect(ob)
                                + "，是要取钱吗？(load)\n");
                        break;
                case 2:
                        say( "金老板慢条斯理的说道：这位" + RANK_D->query_respect(ob)
                                + "，你是要换钱吗？(convert)\n");
                        break;
                case 3:
                        say( "金老板自言自语道：这年头...常来查查自己帐户上还有多少钱吧。(check)\n");
                        break;
        }
        return;
}
