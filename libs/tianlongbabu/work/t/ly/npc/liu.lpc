// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("刘鹤真", ({ "liu hezhen", "liu", "hezhen" }) );
        set("gender", "男性" );
        set("age", 52);
        set("long",
                "刘老板长着一丛山羊胡子，浑身瘦得皮包骨。\n");
        set("combat_exp", 5000);
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_skill("parry", 20);
        set("attitude", "friendly");
        set("rank_info/respect", "裁缝");
        set("vendor_goods", ([
                "云南白药": __DIR__"obj/med1",
                "提神草药": __DIR__"obj/med2",
        ]));
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        add_money("silver", 10);
}

void init()
{       
        add_action("do_vendor_list", "list");
}

