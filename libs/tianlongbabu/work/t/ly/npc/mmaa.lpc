// mmaa.c
#include <ansi.h>

inherit NPC;

string marry();
string unmarry();

void create()
{
	set_name("小玉米", ({ "mmaa" }) );
	set("title", YEL"月老祠"+RED"红娘"NOR);
        set("gender", "女性" );
        set("age", 18);
        set("per", 30);
        set("long",
		"小玉米正笑吟吟的看着你。\n");
        set("combat_exp", 100);
        set("attitude", "friendly");
        set("inquiry", ([
                "婚约" : "是啊... 这里就可以缔结和解除婚约",
        ]) );

        set_skill("dodge", 50);
        set_skill("unarmed", 50);

        setup();
}

void init()
{
        //object ob;

        ::init();
//        if(interactive(ob = this_player()) && !is_fighting()) 
//	{
//                remove_call_out("greeting");
//                call_out("greeting", 1, ob);
//        }
        add_action("do_marry", "marry");
        add_action("do_unmarry", "unmarry");
}

int do_marry(string arg) 
{
        object /*marry_card1, marry_card2,*/ ob, me;

	if(environment(this_object())->query("short") != "月老祠")
		return notify_fail("真是抱歉，请您等一下到月老祠来找我吧。\n");

	me = this_player();
	if(!arg || !objectp(ob = present(arg, environment(me))))
		return notify_fail("你想和谁缔结良缘？\n");

	if(!userp(ob) && ob->name(1) == "小玉米")
	{
		message_vision("小玉米羞得脸若红霞，低声说道：讨厌啦...别拿我开玩笑！\n", me);
		return 1;
	}

        if(me->query("marks/married"))
                return notify_fail("你与" + me->query("married")
			+ "已有婚约，还是先离了婚再说吧。\n");
        
	if(ob->query("marks/married"))
		return notify_fail(ob->name(1) + "与" + ob->query("married")
			+ "有婚约在先，还是等离了婚再说吧。\n");

        if(!living(ob))
		return notify_fail(ob->name() + "目前无法和你缔结良缘。\n");

	if(ob == me) return notify_fail("你想同你自己缔结婚约？\n");

        if((string)ob->query("gender") == (string)me->query("gender"))
                return notify_fail("你不怕" + RED"AIDS"NOR + "吗？\n");

	if(me->query("class") == "bonze"
	|| me->query("class") == "taoist"
	|| me->query("class") == "lama")
		return notify_fail("出家人也想结婚？ 还是先还俗再说吧。\n");

        if((((int)me->query("age") < 17)
	&&((string)me->query("gender") == "男性"))
	||(((int)me->query("age") < 15)
	&&((string)me->query("gender") == "女性")))
		return notify_fail("你年岁还太小，等长大了再说吧。\n");

	if((((int)ob->query("age") < 17)
        &&((string)ob->query("gender") == "男性"))
        ||(((int)ob->query("age") < 15)
        &&((string)ob->query("gender") == "女性")))
		return notify_fail(ob->name(1) 
				+ "年岁还太小，等长大了再说吧。\n");

        if(!ob->query_temp("ask_marry"))
	{
                message_vision(MAG "\n$N对著$n说道：" 
			+ RANK_D->query_self(me) 
			+ me->name() + "，愿意和"
			+ RANK_D->query_respect(ob) 
			+ "结为夫妇\n\n"NOR, me, ob); 

		me->set_temp("ask_marry", 1);
		tell_object(ob, MAG "如果你愿意和对方结为夫妇，请你也对" 
                        + me->name() + "("+(string)me->query("id")+
                        ")"+ "下一次（ｍａｒｒｙ）指令。\n" NOR);
                write(MAG "现在你急切盼望着你的心上人说同意...\n" NOR); 
                return 1;
        }
        
        //marry_card1 = new(__DIR__"obj/marry_card");
        //marry_card1->set("name","你和" + ob->name(1) + "的婚约");
        //marry_card1->move(me);
        //marry_card2 = new(__DIR__"obj/marry_card");
        //marry_card2->set("name","你和" + me->name(1) + "的婚约");
        //marry_card2->move(ob);
	me->set("marks/married", ob->name(1));
	ob->set("marks/married", me->name(1));
	ob->delete_temp("ask_marry");
        
        message_vision(MAG "恭喜$N和$n，一对璧人喜结良缘。\n" NOR, ob, me);

        CHANNEL_D->do_channel(this_object(), "chat",
		sprintf("%s和%s现在开始是夫妇啦! \n", 
		me->name(1), ob->name(1)));

        return 1;
}

int do_unmarry(string arg)
{
        object /*marry_card1,marry_card2,*/ me, ob;
             
	if(environment(this_object())->query("short") != "月老祠")
		return notify_fail("真是抱歉，请您等一下到月老祠来找我吧。\n");

        me = this_player();       
	if(!arg || !objectp(ob = present(arg, environment(me))))
		return notify_fail("你想与谁解除婚约？\n");

	if(!me->query("marks/married"))
		return notify_fail("你与" + ob->name(1) + "未有婚约啊。\n");
        
        if(!ob->query_temp("ask_unmarry"))
	{
                message_vision(MAG "\n$N对著$n说道：咱们解除" 
			+ "婚约吧！好吗？\n\n" NOR, me, ob);
		tell_object(ob, MAG "如果你愿意解除婚约，请你也"
                	+ "下一次（ｕｎｍａｒｒｙ）指令。\n" NOR);
                write(MAG "现在你只有等着" + ob->name(1) + "同意啦...\n" NOR);  
		me->set_temp("ask_unmarry", 1);
                return 1;
        }

	//if(marry_card1 = present("marrycard", me))
        //	destruct(marry_card1);
	//if(marry_card2 = present("marrycard", ob))
        //	destruct(marry_card2);
	me->delete("marks/married");
	ob->delete("marks/married");
	ob->delete_temp("ask_unmarry");
        
	message_vision(MAG "$N和$n从现在开始解除婚约，从此互不相干！\n" NOR, 
			ob, me);
        CHANNEL_D->do_channel(this_object(), "chat",
		sprintf( "%s和%s从现在开始解除婚约，从此互不相干！\n",
        	me->name(1), ob->name(1)));

        return 1;
}
