// wu.c
#include <ansi.h>
inherit __DIR__"beggar0";
inherit F_MASTER;

void create()
{
        set_name("吴长老", ({ "master wu", "master", "wu" }) );

        set("gender", "男性");
        set("age", 58);
        set("long",
        "吴长老是江湖闻名的丐帮“六老”之一，他脸色发红，\n"
        "生性豪爽，天下广交朋友。他善使一柄鬼头刀，刀法\n"
        "凌厉，内力浑厚。\n" );

        set("attitude", "peaceful");
        create_family("丐帮", 15, "长老");
        set("gaibang/class", 9);
        set("title",WHT"丐帮九袋长老"NOR);
/*
        set("inquiry", ([
                "quest": (: give_quest :),
                "任务": (: give_quest :),
        ]) );
*/
        set("chat_chance", 90);
        set("chat_msg", ({
                (: do_protect :)
        }));

        set("str", 30);
        set("cor", 23);
        set("int", 30);
        set("cps", 20);
        set("per", 20);
        set("con", 25);
        set("spi", 26);

        set("force", 7000);
        set("max_force", 5000);
        set("force_factor", 140);
        set("atman",1000);
        set("max_atman",1000);

        set("combat_exp", 13000000);
        set("score", 5000000);

        set_skill("unarmed", 200);
        set_skill("blade", 250);
        set_skill("force", 240);
        set_skill("dodge", 120);
        set_skill("parry", 140);
        set_skill("move", 80);
        set_skill("literate", 100);
        set_skill("beggar-steps",150);
        set_skill("beggar-force",200);
        set_skill("beggar-strike",200);
//        set_skill("pili-blade",200);

        map_skill("unarmed","beggar-strike");
//        map_skill("staff","pili-blade");
        map_skill("dodge","beggar-steps");
        map_skill("move","beggar-steps");
        map_skill("force","beggar-force");
//        map_skill("parry","pili-blade");


        set("inquiry", ([
		"quest": (: give_quest :),
		"任务": (: give_quest :),

                "master wu" : "我就是啊，有事吗？",
                "吴长老" : "我就是啊，有事吗？",
                "段誉" : "段公子数月前曾来过洛阳，之后又不知去哪里了。",
                "here" : "这里是洛阳，是我们丐帮的总舵所在。",
                "name" : "我姓吴，小兄弟贵姓？",
                "乔峰" : "鄙帮乔帮主名讳，在下不敢直呼。",
                "丐帮" : "我们要饭的受人欺、被狗咬，不结成一伙，还有活命的份儿吗？",
                "易大彪" : "他四处漂泊，居无定所。",
                "奚长老" : "奚长老可能在大仁分舵处理帮务吧。",
                "陈长老" : "陈长老可能在大智分舵处理帮务吧。",
                "宋长老" : "宋长老可能在大信分舵处理帮务吧。",
                "传功长老" : "他可能在大义分舵处理帮务吧。",
                "执法长老" : "白长老可能在大勇分舵处理帮务吧。",

        ]) );

        setup();

        carry_object(__DIR__"obj/cloth2")->wear();
}
void init()
{
	object ob;

	::init();
	if( interactive(ob = this_player()))
	{
		remove_call_out("meeting");
		call_out("meeting", 1, ob);
	}
}

void attempt_apprentice(object ob)
{
	string name;
	name = ob->query("family/master_name");
	if(( name != "易大彪" ) 
	&& ( ob->query("gaibang/class") >= 5 )) {
		command("shake " + getuid(ob));
		command("say 原来是" + name + "的高徒，这我可不敢收啊。");
		return;
	}
	command("look " + getuid(ob) );
	if( ob->query("gaibang/class") < 5) {
		command("say 等你升到五袋，我就收你做弟子。加油吧！\n");
		return;
	}
        command("say 好吧，既然这位" + RANK_D->query_respect(ob) + 
"有此诚意，我便收你为弟子。\n");
        command("recruit " + ob->query("id") );

}

void give_rank(object ob)
{
        //int exp;
//        string title;

        if(ob->query_skill("beggar-strike",1) >= 180 
                  && ob->query("combat_exp") > 9000000 ) {
                if(ob->query("title") == WHT"丐帮九袋长老"NOR) return;
                command("say 很好！从今天起，我升你为丐帮九袋长老。\n");
                ob->set("title", WHT"丐帮九袋长老"NOR);
                ob->set("gaibang/class", 9);
        } else if(ob->query_skill("beggar-strike",1) >= 160 
                  && ob->query("combat_exp") > 7000000 ) {
                if(ob->query("title") == "丐帮八袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮八袋弟子。\n");
                ob->set("title", "丐帮八袋弟子");
                ob->set("gaibang/class", 8);
        } else if(ob->query_skill("beggar-strike",1) >= 140 
                  && ob->query("combat_exp") > 5000000 ) {
                if(ob->query("title") == "丐帮七袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮七袋弟子。\n");
                ob->set("title", "丐帮七袋弟子");
                ob->set("gaibang/class", 7);
        } else if(ob->query_skill("beggar",1) >= 120 
                  && ob->query("combat_exp") > 3000000 ) {
                if(ob->query("title") == "丐帮六袋弟子") return;
                command("say 很好！从今天起，我升你为丐帮六袋弟子。\n");
                ob->set("title", "丐帮六袋弟子");
                ob->set("gaibang/class", 6);
        } else return;
}



