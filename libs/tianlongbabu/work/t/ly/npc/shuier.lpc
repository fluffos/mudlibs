// shuier.c
#include <ansi.h>;
inherit NPC;
inherit F_VENDOR;

void create()
{
       set_name("水儿", ({ "shuier" }) );
       set("gender", "女性" );
       set("age", 18);
       set("per", 30);
       set("long",
              "一位清秀绝俗的少女娇羞的望着你。\n");
       set("combat_exp", 9000);
       set("attitude", "friendly");
       set("rank_info/respect", "侍女");
       set("title", CYN"华清池"NOR + RED"侍女"NOR );
       set("force", 300);
       set("max_force", 300);
       set("force_factor", 20);
       set("vendor_goods", ([
               "丝巾": __DIR__"obj/silk",
               "木梳": __DIR__"obj/comb",
       ]));
       setup();
       carry_object(__DIR__"obj/cloth1")->wear();
       carry_object(__DIR__"obj/shoes1")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        message_vision( "水儿微笑的迎上来道：这位" + RANK_D->query_respect(ob)
                                + "，快请进，欢迎光临。\n",this_player());
                        break;
                case 1:
                        message_vision( "水儿正忙着洗毛巾，没注意$N走了进来。\n",this_player());
                        break;
                case 2:
                        message_vision( "水儿擦了擦额头的汗水，对着$N甜甜一笑。\n",this_player());
                        break;
                case 3:
                        message_vision( "水儿看$N走了进来，说道：这位" + RANK_D->query_respect(ob)
                                + "，洗澡吗？十两银子洗一次。\n",this_player());
                        break;
        }
        return;
}

int accept_object(object who, object ob)
{
        int val;
        val = ob->value();
        if( (!val) || (!ob->query("money_id")) ) 
        return notify_fail(""); 

        if( val >= 1000 ) 
        {
                who->set_temp("bath", val/1000);
                say("水儿微笑点头，把钱收起来了。\n");
        }
        return 1;
}