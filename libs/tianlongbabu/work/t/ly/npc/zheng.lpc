// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("郑先生", ({ "zheng" }) );
        set("gender", "男性" );
        set("age", 35);
        set("long",
                "郑先生背着手正在欣赏一副作品。\n");
        set("combat_exp", 8000);
        set("attitude", "friendly");
        set("rank_info/respect", "掌柜的");
/*        set("vendor_goods", ([
                "国画": "/obj/pic1",
        ]));*/
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
//        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        say( "郑先生回头笑道：这位" + RANK_D->query_respect(ob)
                                + "，进来看看吧。\n");
                        break;
                case 1:
                        say( "郑先生上下打量你几眼，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( "郑先生说道：这位" + RANK_D->query_respect(ob)
                                + "，我这里新到了几副名画，可想看看？\n");
                        break;
                case 3:
                        say( "郑先生小心翼翼的把一副画卷好。\n");
                        break;
        }
        return;
}

