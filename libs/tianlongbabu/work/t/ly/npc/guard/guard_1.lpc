// guard_1.c

inherit NPC;
#include <ansi.h>

void create()
{
        set_name("李正", ({ "li zheng","li","zheng","guard" }) );
        set("title", YEL"带刀护卫"NOR );
        set("gender", "男性" );
        set("long",
                "一位挎着腰刀的官兵正在四处巡视，维护治安。\n" );
        set("str", 40 );
        set("combat_exp", 1000000);
        set("force", 1500);
        set("max_force", 1000);
        set("atam", 800);
        set("max_atam", 800);
        set("force_factor", 80);

        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("blade", 100);
        set_skill("unarmed", 100);
        set_skill("move", 100);
        set_skill("fast-blade", 100);
        set_skill("star-steps", 100);
        set_skill("tiger-claw", 100);
        
        map_skill("blade","fast-blade");
        map_skill("unarmed","tiger-claw");
        map_skill("parry","fast-blade");
        map_skill("dodge","star-steps");
        map_skill("move","star-steps");

        setup();
        carry_object("/t/ly/obj/weapon/blade/iron_blade.lpc")->wield();
        carry_object("/t/ly/obj/clothing/armor/armor.lpc")->wear();
}

