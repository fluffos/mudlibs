void create()
{
        mapping dizi1;
        string name, id;
        int rnd;
        
        rnd = random(sizeof(firstname));
        name = firstname[rnd];
        id = firstid[rnd];
        rnd = random(sizeof(lastname));
        name += lastname[rnd];
        id += lastid[rnd];
        rnd = random(50);
        dizi1=dizi[random(sizeof(dizi))];
        
        set_name(name, ({ id,"beggar" }) );
        set("gender", "男性" );
        set("age", 10+rnd);
        set("long", "一个破衣烂衫的乞丐。\n");
        set("combat_exp", (int)dizi1["exp"]);
        set("score",10000);
        set("gaibang/class", (int)dizi1["class"]);
        set("title", (string)dizi1["title"]);
        create_family("丐帮", 15, "弟子");
        set("force", (int)dizi1["force"]);
        set("max_force", (int)dizi1["force"]);
        set("force_factor", (int)dizi1["enforce"]);
        
        set_skill("unarmed", (int)dizi1["skill"]);
        set_skill("dodge", (int)dizi1["skill"]);
        set_skill("parry", (int)dizi1["skill"]);
        set_skill("force", (int)dizi1["skill"]);
        set_skill("beggar-force", (int)dizi1["skill"]);
        set_skill("beggar-strike", (int)dizi1["skill"]);
        set_skill("beggar-steps", (int)dizi1["skill"]);
        
        map_skill("force","beggar-force");
        map_skill("dodge","beggar-steps");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 50);
        set("chat_msg",
        ({
                (: do_protect :),
        }) );
        
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
}

void meeting(object ob)
{
        if( !ob || environment(ob) != environment() || !living(ob)) return;
        if( ((string)ob->query("family/family_name") == "丐帮")
                &&(query("gaibang/class") < ob->query("gaibang/class") )
                &&(ob->query("gaibang/class") < 9) )
                {
                        if (ob->query("gender") == "男性")
                        message_vision(query("name")+"向$N抱拳躬身道：这位师兄，里面请吧！\n", ob);
                        else message_vision(query("name")+"向$N抱拳躬身道：师姐回来啦，快请进吧！\n", ob);
                }
        if( ((string)ob->query("family/family_name") == "丐帮")
                &&(query("gaibang/class") < ob->query("gaibang/class") )
                &&(ob->query("gaibang/class") > 8 ) )
                {
                        message_vision(query("name")+"向$N抱拳躬身道：弟子参见长老！\n", ob);
                }
        if( (string)ob->query("family/family_name") != "丐帮") 
                {
                        switch( random(4) )
                        {
                                case 0:
                                message_vision(query("name")+"疑惑的看着$N。\n",ob);
                                break;
                                case 1:
                                message_vision(query("name")+"向$N抱拳道：此乃丐帮总舵，外帮弟子不得入内！\n", ob);
                                break;
                                case 2:
                                message_vision(query("name")+"打量了$N一眼，道：哪来的小子，敢来这里撒野？！\n", ob);
                                break;
                                case 3:
                                message_vision(query("name")+"看了$N一眼，说道：这位" + RANK_D->query_respect(ob)
                                + "，请回吧，这里不是你来的地方。\n",ob);
                                break;
                        }
                }
                

}

int accept_fight(object me)
{
        command("say " + "在下不敢有负守门之职，这位" +
        RANK_D->query_respect(me) + "见谅！\n");
        return 0;
}

void attempt_apprentice(object ob)
{
        message_vision("$N忙躬身道：在下不敢当，你还是去找九袋长老吧。\n",this_object());
        return;
}

void do_recover()
{
        int full_kee = query("max_kee");

        if( is_busy() )
                return;
        if( (!is_fighting()) && (query("eff_kee") < full_kee)
                && (query("eff_kee") > (full_kee/2)) )
        {
                if( query("force") >= (query("max_force")+50) )
                {
                        command("exert heal 50");
                        return;
                }
                if( query("kee") > 100 )
                        command("exercise 100");
                return;
        }
        if( query("kee") < (query("eff_kee")) )
        {
                if( query("force") > 100 )
                        command("exert recover 100");
                else
                        if( query("force") > 20 )
                                command("exert recover 20");
                return;
        }
        if( query("gin") < (query("eff_gin")) )
                if( query("force") > 100 )
                        command("exert refresh 100");
                else
                        if( query("force") > 20 )
                                command("exert refresh 20");
        return;
}

void do_protect()
{
        string *killer;
        object *pupil = all_inventory( environment() ), enemy;
        int i;

        if( (query("kee") < query("max_kee")) || (query("gin") < query("max_gin")) )
        {
                do_recover();
                return;
        }
        if( is_fighting() )
                return;
        for( i=0; i<sizeof(pupil); i++ )
        {
                if( living(pupil[i]) && pupil[i]->is_fighting() 
                        && (pupil[i]->query("family/family_name")=="丐帮") )
                        {
                        killer = pupil[i]->query_killer();
			// by cbra
			if((!arrayp(killer)) || (!sizeof(killer)) ) return;
                        if( !(enemy=present(killer[0])) ) return;
                        command( "heng"+getuid(enemy) );
                        message_vision( YEL""+query("name")+"冲"+enemy->query("name")
                                +"叫道：叫化子难道就好欺负吗？！\n"NOR, enemy );
                        kill_ob( enemy );
                        return;
                }
        }
}
