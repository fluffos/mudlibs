// garrison.c

inherit NPC;

void create()
{
	set_name("官兵", ({ "garrison" }) );
	set("gender", "男性" );
	set("long",
		"一位挎着腰刀的官兵趾高气扬的看着你。\n" );
	set("combat_exp", 60000);
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);

	set_skill("dodge", 40);
	set_skill("parry", 40);
	set_skill("blade", 40);

	setup();
        carry_object(__DIR__"obj/garrisoncloth")->wear();
	carry_object(__DIR__"obj/blade")->wield();
}
