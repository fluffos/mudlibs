//horse1.c
#include <ansi.h>  
inherit NPC;

void create()
{
        string *order=
({
        CYN"青骢马"NOR,
        YEL"黄骠马"NOR,
        RED"枣红马"NOR,
        WHT"白龙马"NOR,
        WHT"黑龙马"NOR,
        RED"赤兔马"NOR,
});
        string cname = order[random(6)];
        set_name(cname, ({ "horse" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一匹膘肥体壮摇头晃脑的" + cname + "。\n");
        
        set("str", 26);
        set("cor", 30);
        set_temp("rider","buyi");

        set("limbs", ({ "头部", "身体", "前腿", "後腿", "尾巴" }) );
        set("verbs", ({ "bite", "kick" }) );

        set("combat_exp", 500000);
        set_temp("apply/attack", 10);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 20);

        setup();
}
void die()
{
        message_vision("$N凄惨的嘶鸣一声，倒在了地上。\n", this_object());
        ::die();
}
