// beggar1.c

inherit __DIR__"beggar0";

void create()
{
        set_name("乞丐", ({ "beggar" }) );
        set("gender", "男性" );
        set("age", 25);
        set("attitude", "peaceful");
        set("long", "一个破衣烂衫的乞丐。\n");
        set("combat_exp", 80000);
        set("score",8000);
        set("gaibang/class", 1);
        set("title", "丐帮一袋弟子");
        create_family("丐帮", 15, "弟子");
        set("str", 10);
        set("per", 15);
        set("force", 400);
        set("max_force", 400);
//      set("force_factor", 20);
        
//      set_skill("unarmed", 50);
//      set_skill("dodge", 50);
//      set_skill("parry", 50);
//      set_skill("force", 50);
//      set_skill("beggar-force", 50);
        
//      map_skill("force","beggar-force");
        
        set("chat_chance", 50);
        set("chat_msg",
        ({
                (: do_protect :),
        }) );
        
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
}

void attempt_apprentice(object ob)
{
        message_vision("乞丐忙起身道：在下不敢当，你还是去找九袋长老吧。\n",this_object());
        return;
}

