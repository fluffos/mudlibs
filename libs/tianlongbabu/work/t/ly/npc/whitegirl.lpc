//// whitegirl.c

#include <ansi.h>
#include <command.h>

inherit NPC;
int accept_object(object me, object ob);
string *obj_cname = ({
        "「凌波微步」",
        "孔雀翎",
        "七宝指环"
});
string *girl_msg = ({
            "白衣女子沉默了一会儿，幽幽的叹了口气。\n" NOR,
            "白衣女子低头沉思。\n" NOR,
            "白衣女子终于抬起头，似乎鼓起了勇气。\n" NOR,
        YEL "白衣女子轻声说道：那日...在华清池...公子看、看到了我......\n" NOR,
            "白衣女子低下头，羞得说不出话来。\n" NOR,
            "沉默了一会儿，白衣女子又抬起头来。\n",
        YEL "白衣女子低声说道：请公子先听我讲述一下的我的身世吧。\n" NOR,
            "说着，白衣女子站了起来，缓缓在室中走动，但仍背对着你。\n",
        YEL "白衣女子说道：小女子家境贫寒，因欠了地主家债，自幼被卖到青楼为奴。\n" NOR,
        YEL "白衣女子说道：老爹为赎我出去，数年来四处乞讨，风餐露宿。\n" NOR,
        YEL "白衣女子说道：堪堪凑足了五百两纹银，眼看我就能重见光明。\n" NOR,
        YEL "白衣女子说道：可不知从何地来了个富商，相中了我，欲娶我做妾。\n" NOR,
        YEL "白衣女子说道：因我年龄尚小，故将养在此，待岁足出嫁。\n" NOR,
        YEL "白衣女子说道：老爹闻听此事，忙带着银两跑到那富商府上跪求。\n" NOR,
        YEL "白衣女子说道：可怜他跪了两天一夜无人理会，只得将手头银两打点了门房家丁。\n" NOR,
        YEL "白衣女子说道：老爹见到那富商，将这几年来为赎我出窑的经历哭诉一番。\n" NOR,
        YEL "白衣女子说道：那富商只说若能为他寻到一件物事，便放我回家。\n" NOR,
            "你说道：是什么物事？\n",
        YEL "白衣女子叹了口气道：那富商大概是武林中人，这物事闻所未闻，老爹听得目瞪口呆。\n" NOR,
        YEL "白衣女子说道：老爹心知无能办到，苦苦哀求。\n" NOR,
        YEL "白衣女子说道：那富商一怒之下，将他打折了腿，扔在街上。\n" NOR,
        YEL "白衣女子说道：老爹身无分文，举目无亲，只得伏卧街边，见人便问可曾听过那物事。\n" NOR,
        YEL "白衣女子说道：苦撑了数日，遗书一封，含恨而终。\n" NOR,
            "白衣女子说着，缓缓转过身来。\n你只觉眼前一亮，身前女子美得如仙子一般，散发出夺目光彩。\n",
});
string *girl_msg2 = ({
        YEL "白衣女子说道：这是老爹留下的遗书，公子...公子若能...我...\n" NOR,
            "白衣女子幽幽叹了口气，潸然落泪。\n" ,
        YEL "白衣女子说道：谁让我这么命苦呢，如到了日子，我就死在这里吧。\n" NOR,
            "白衣女子低下头，黯然神伤。\n",
            "隔了许久，白衣女子缓缓抬起头来。\n",
        YEL "白衣女子说道：若公子能寻到那件物事，我愿...如公子不嫌的话...\n" NOR,
            "白衣女子说话声音越来越低，后面的话你几乎听不到了。\n",
        YEL "白衣女子说道：小女子这里先谢过公子了。\n" NOR,
            "说着，白衣女子盈盈下拜。\n" NOR,
});

void create()
{
        set_name("白衣女子", ({ "girl" }) );
        set("long",
                "一位身着白衣的妙龄女子。\n");
        set("attitude", "peaceful");
        set("gender", "女性" );
        set("chat_chance", 10);
        set("chat_msg", ({
                "白衣女子低头沉思，不知该说什么好。\n",
                "白衣女子云鬓微颤，显是心中激荡。\n"
        }) );
        set("age", 17);
        set("per", 30);
        set("combat_exp", 100);
        set_skill("dodge", 40);
        set_skill("unarmed", 40);
        setup();
        carry_object( __DIR__"obj/cloth5" )->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        add_action ("do_look","look");
}
void meeting(object ob)
{
//        string cname;
        if( !ob || environment(ob) != environment() )
                return;
        if( ob->query("gender") == "女性")
        return notify_fail("白衣女子轻声说道：这位" 
        + RANK_D->query_respect(ob)
        + "，你到这里来有何事吗？\n");
        if( ob->query("whitegirl/quest")) {
                command("whisper " + ob->query("id")
                + " 找到"+ob->query("whitegirl/quest")
                + "了吗？我的时间不多了...\n");
                return;
        }
        if( !ob->query("whitegirl/quest")) {
                call_out( "girl_stage", 5, ob, 0 );
                return;
        }
}

void girl_stage(object ob, int stage)
{
        if( !ob || !present(ob) ) return;
        tell_object(ob, girl_msg[stage]);
        if( ++stage < sizeof(girl_msg) ) {
                call_out( "girl_stage", 5, ob, stage );
                return;
        } 
        else this_object()->set_temp("whitegirl/finish",1);
}
void girl_stage2(object ob, int stage)
{
        if( !ob || !present(ob) ) return;
        tell_object(ob, girl_msg2[stage]);
        if( ++stage < sizeof(girl_msg2) ) {
                call_out( "girl_stage2", 5, ob, stage );
                return;
        } 
}

int do_look (string arg)
{
        object me = this_object();
        object who = this_player();
//        object where = environment(me);
        object letter;
        string cname;

        if (arg && (me == present(arg,environment(me)))) {
                if (me->query_temp("whitegirl/finish")) {
                        if (who->query_temp("whitegirl/lookone")) {
                                message_vision("白衣女子给$N一封信。\n",who);
                                message_vision("白衣女子见$N直呆呆的望着她，脸上一红，有些不好意思。\n",who);
                                message_vision("白衣女子害羞的转过身，仍背对着$N。\n",who);
                                me->delete_temp("whitegirl/finish");
                                who->delete_temp("whitegirl/lookone");
                                cname = obj_cname[random( sizeof( obj_cname ))];
                                who->set("whitegirl/quest",cname);
                                letter = new(__DIR__"obj/letter");
                                letter->set("long","一张皱皱巴巴的黄纸，字是用手指蘸着血写的：\n\n\t"
                                + RED + cname + NOR + "\n\n");
                                letter->move(who);
                                call_out( "girl_stage2", 5, who, 0 );
                                return 1;
                        }
                        who->set_temp("whitegirl/lookone",1);
                        return 0;
                }
                write ("一位穿着白纱的女子，从后面看身材窈窕，看不到相貌。\n");
                return 1;
        }
        return 0; // to invoke normal look
}
int accept_object(object me, object ob)
{
        string quest;
        object obj;
        if( !(quest =  me->query("whitegirl/quest")) )
                return 0;
        if( ob->query("name") != quest )
        {
                command("? " + me->query("id"));
                command("say 给我这个做什么啊？\n");
                return 0;
        }
        if(ob->query("id") == "cloth")
        {
                command("? " + me->query("id"));
                command("say 怎么看着不像真的啊？\n");
                return 1;
        }
        message_vision("白衣女子「啊」的惊呼了一声。\n", me);
        message_vision(YEL"白衣女子说道：公子你竟然...竟然找到了！\n"NOR, me);
        message_vision("白衣女子激动得说不出话来，眼泪夺框而出，顺着脸颊流到带笑的腮边。\n", me);
        message_vision(YEL"白衣女子自言自语道：爹，我终于自由了...只可怜您老人家...\n"NOR, me);
        message_vision("白衣女子擦擦眼泪，对你一笑，灿烂生辉。\n", me);
        message_vision(YEL"白衣女子说道：我这就去把东西给那富商，然后我们就一起离开这里。\n"NOR, me);
        message_vision(YEL"白衣女子说道：公子请到洛阳西门等我，我很快就来。\n"NOR,me);
        message_vision("说着，白衣女子像一阵风样跑了出去。\n"NOR,me);
        me->delete("whitegirl/quest");
        me->set("whitegirl/wait",1);
        obj = new(__DIR__"whitegirl2");
        obj->move("/t/ly/westgate");
        call_out("destroy", 1, this_object());
        return 1;
}

int destroy(object ob)
{
        destruct(ob);
        return 1;
}

