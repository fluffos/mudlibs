//horse2.c
#include <ansi.h>  
inherit NPC;

void create()
{
        set_name("小花猫", ({ "cat" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只可爱的小花猫正好奇的盯着你。\n");
        
        set("str", 20);
        set("cor", 30);

        set("limbs", ({ "头部", "身体", "前腿", "後腿", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("combat_exp", 1000);

        set_skill("parry", 50);
        set_skill("unarmed", 30);
        set_skill("dodge", 100);        
        set_temp("apply/attack", 10);
        set_temp("apply/damage", 10);
        set_temp("apply/armor", 5);
     set("chat_chance",30);
	set("chat_msg", ({
		"小花猫东瞧瞧...西看看...\n",
		"小花猫打了个哈欠，懒懒的趴着。\n",
		"小花猫“喵——”的叫了一声。\n",
		"小花猫舔了舔爪子，又用爪子擦了擦脸。\n",
		"小花猫伸爪子去捅路边的纸团。\n",
		"小花猫歪着脑袋看着你，莫名其妙。\n",
		"小花猫低着脑袋犯困，仿佛在低头沉思。\n",
		"小花猫看见一只蝴蝶飞过，急忙追过去扑打。\n",
		"小花猫把脑袋贴在地上匍匐爬行，好象发现了目标。\n",
		"小花猫扭扭捏捏的在你小腿旁蹭来蹭去。\n",
		"小花猫绕着你乱转，看来是饿了。\n",
		"小花猫带着企求的目光望着你，没准儿是想吃鱼了。\n",
		"小花猫弓起身子伸了个懒腰，吧嗒吧嗒嘴。\n",
		"小花猫小心翼翼的闻了闻你的鞋尖儿。\n",
		(: random_move :)
	}) );
        setup();
}
void die()
{
        message_vision("小花猫倒在地上，浑身抽搐，一会儿不动了。\n", this_object());
        ::die();
}
