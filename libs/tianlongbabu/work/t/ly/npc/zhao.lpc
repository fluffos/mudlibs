// zhao.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("赵裁缝", ({ "zhao" }) );
        set("gender", "男性" );
        set("age", 75);
        set("long",
                "一个须发皆白的老者正在缝衣服。\n");
        set("combat_exp", 70000);
        set("attitude", "friendly");
        set("rank_info/respect", "裁缝");
        set("vendor_goods", ([
                "绣花鞋": __DIR__"obj/shoes1",
                "踏云靴": __DIR__"obj/shoes2",
                "水牛皮靴": __DIR__"obj/shoes3",
                "六合靴": __DIR__"obj/shoes4",
                "灰布僧鞋": __DIR__"obj/shoes5",
        ]));
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{       
        object ob;

        ::init();
        if(environment(this_object())->query("short") == "裁缝铺") {
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) )
        {
                case 0:
                        message_vision( "赵裁缝自言自语道：缝鞋就像练武一样，手要稳，心要细......\n",this_player());
                        break;
                case 1:
                        message_vision( "赵裁缝抬头看见$N走了进来，忙起身招呼。\n",this_player());
                        break;
                case 2:
                        message_vision( "赵裁缝掸了掸衣上的灰尘，叹了口气。\n",this_player());
                        break;
                case 3:
                        message_vision( "赵裁缝一见$N进来，说道：这位" + RANK_D->query_respect(ob)
                                + "，想买双鞋吗？(list)\n",this_player());
                        break;
        }
        return;
}
