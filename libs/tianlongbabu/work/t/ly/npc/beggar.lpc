// beggar.c
// last update by cbra to put name in local save memory

inherit __DIR__"beggar0";

void create()
{

string *firstname=({"赵","钱","孙","李","周","吴","郑",
                    "王","林","乔","张","洪","宋","黄",
                    "段","黎","莫","钟","谭","单","唐",
                    "萧",
                    "司徒","司马","欧阳"});
string *firstid=({"zhao","qian","sun","li","zhou","wu","zheng",
                  "wang","lin","qiao","zhang","hong","song","huang",
                  "duan","li","mo","zhong","tan","shan","tang",
                  "xiao",
                  "situ","sima","oyang"});
string *lastname=({"青","樊","山","狂","志","远","渺",
                   "恨","强","力","酒","杀","正","痴",
                   "名","利","穷","废","梦","诗","书",
                   "画","乐","吏","然","鹏","顺","德",
                   "飞","起","灭","绝","角","一","二",
                   "三","四","五","六","七","八","九",
                   "天","地","海","陵","雄","英","豪",
                   "杰","剑","刀","枪","弓","勾","元",
                   "无名","致远","清扬","无恨","不悔","望川",});
string *lastid=({"qing","fan","shan","kuang","zhi","yuan","miao",
                 "hen","qiang","li","jiu","sha","zheng","chi",
                 "ming","li","qiong","fei","meng","shi","shu",
                 "hua","yue","li","ran","peng","shun","de",
                 "fei","qi","mie","jue","jiao","yi","er",
                 "san","si","wu","liu","qi","ba","jiu",
                 "tian","di","hai","ling","xiong","ying","hao",
                 "jie","jian","dao","qiang","gong","gou","yuan",
                 "wuming","zhiyuan","qingyang","wuhen","buhui","wangchuan",});

mapping *dizi = ({
([      "title": "丐帮一袋弟子",
        "exp": 50000,
        "class": 1,
        "force": 400,
        "enforce": 20,
        "skill": 20
]),
([      "title": "丐帮二袋弟子",
        "exp": 100000,
        "class": 2,
        "force": 800,
        "enforce": 40,
        "skill": 40
]),
([      "title": "丐帮三袋弟子",
        "exp": 500000,
        "class": 3,
        "force": 1000,
        "enforce": 60,
        "skill": 60
]),
([      "title": "丐帮四袋弟子",
        "exp": 1000000,
        "class": 4,
        "force": 1400,
        "enforce": 70,
        "skill": 80
]),
([      "title": "丐帮五袋弟子",
        "exp": 200000,
        "class": 5,
        "force": 1600,
        "enforce": 80,
        "skill": 100
]),
([      "title": "丐帮六袋弟子",
        "exp": 3000000,
        "class": 6,
        "force": 2000,
        "enforce": 90,
        "skill": 120
]),
([      "title": "丐帮七袋弟子",
        "exp": 4000000,
        "class": 7,
        "force": 2500,
        "enforce": 100,
        "skill": 130
]),
([      "title": "丐帮八袋弟子",
        "exp": 5000000,
        "class": 8,
        "force": 2800,
        "enforce": 120,
        "skill": 150
]),

});


        mapping dizi1;
        string name, id;
        int rnd;
        
        rnd = random(sizeof(firstname));
        name = firstname[rnd];
        id = firstid[rnd];
        rnd = random(sizeof(lastname));
        name += lastname[rnd];
        id += lastid[rnd];
        rnd = random(50);
        dizi1=dizi[random(sizeof(dizi))];
        
        set_name(name, ({ id,"beggar" }) );
        set("gender", "男性" );
        set("age", 10+rnd);
        set("attitude", "peaceful");
        set("long", "一个破衣烂衫的乞丐。\n");
        set("combat_exp", (int)dizi1["exp"]);
        set("score",10000);
        set("gaibang/class", (int)dizi1["class"]);
        set("title", (string)dizi1["title"]);
        create_family("丐帮", 15, "弟子");
        set("force", (int)dizi1["force"]);
        set("max_force", (int)dizi1["force"]);
        set("force_factor", (int)dizi1["enforce"]);
        
        set_skill("unarmed", (int)dizi1["skill"]);
        set_skill("dodge", (int)dizi1["skill"]);
        set_skill("parry", (int)dizi1["skill"]);
        set_skill("force", (int)dizi1["skill"]);
        set_skill("beggar-force", (int)dizi1["skill"]);
        set_skill("beggar-strike", (int)dizi1["skill"]);
        set_skill("beggar-steps", (int)dizi1["skill"]);
        
        map_skill("force","beggar-force");
        map_skill("dodge","beggar-steps");
        map_skill("unarmed","beggar-strike");
        map_skill("parry","beggar-strike");
        
        set("chat_chance", 50);
        set("chat_msg",
        ({
                (: do_protect :),
                (: random_move :),
        }) );
        
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()))
        {
                remove_call_out("meeting");
                call_out("meeting", 1, ob);
        }
        if( !query_heart_beat(this_object()) ) set_heart_beat(1);

}

void attempt_apprentice(object ob)
{
        message_vision("$N忙躬身道：在下不敢当，你还是去找九袋长老吧。\n",this_object());
        return;
}
