//pet.c 宠物

#include <ansi.h>
#include <combat.h>
inherit NPC;
int check_legal_name(string arg);
void create()
{
	set_name("小花猫", ({ "cat" }) );
	set("race", "野兽");
	set("age", 3);
	set("str",5);
	set("int",5);
	set("per",5);
	set("con",5);
	set("long", "一只刚出生不久的可爱的小花猫。\n");
	set_temp("owner","buyi");
        set("limbs", ({ "头部", "身体", "前腿", "後腿", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );
        set_temp("shuncong",2);
	set("combat_exp",100);
        setup();
}
void die()
{
	object ob;
	ob = find_player(this_object()->query_temp("owner"));
	message_vision("$N抬起头来看了你最后一眼，痛苦的哼了一声。\n",this_object());	
	message_vision("$N慢慢低下头，缓缓合上了眼睛。\n",this_object());
	if(ob)
	tell_object(ob,	"你突然感到心头一跳，似乎有什么不幸的事情发生了。\n");
	::die();
}

void init()
{
	if(this_object()->query_temp("owner") == this_player()->query("id") )
	{
	add_action("do_order","order");
	add_action("do_modify","modify");
	add_action("do_catch","catch");
	add_action("do_letgo","letgo");
	add_action("do_hp","hp");
	}

}
int do_catch(string arg)
{
	object me,ob;
	if(!arg || arg != "cat") return notify_fail("你要抓住什么？\n");
	me = this_player();
	ob = this_object();
	ob->set_leader(me);
	ob->set_skill("move",500);
	ob->set("chat_chance", 0);
	message_vision("$N向$n招了招手，叫道：来！到这来！\n",me,ob);
	message_vision("$N乖乖的走到$n的脚边坐了下来。\n",ob,me);
	return 1;
	
}
int do_letgo(string arg)
{
	object me,ob;
	if(!arg || arg != "cat") return notify_fail("你的宠物不在身边啊？\n");
	me = this_player();
	ob = this_object();
	ob->set_leader(0);
	ob->set_skill("move",1);
	ob->set("chat_chance", 50);
	ob->set("chat_msg", ({
		name()+"东瞧瞧...西看看...\n",
		name()+"打了个哈欠，懒懒的趴着。\n",
		name()+"“喵——”的叫了一声。\n",
		name()+"舔了舔爪子，又用爪子擦了擦脸。\n",
		name()+"伸爪子去捅路边的纸团。\n",
		name()+"歪着脑袋看着你，莫名其妙。\n",
		name()+"低着脑袋犯困，仿佛在低头沉思。\n",
		name()+"看见一只蝴蝶飞过，急忙追过去扑打。\n",
		name()+"把脑袋贴在地上匍匐爬行，好象发现了目标。\n",
		name()+"扭扭捏捏的在你小腿旁蹭来蹭去。\n",
		name()+"绕着你乱转，看来是饿了。\n",
		name()+"带着企求的目光望着你，没准儿是想吃鱼了。\n",
		name()+"弓起身子伸了个懒腰，吧嗒吧嗒嘴。\n",
		name()+"小心翼翼的闻了闻你的鞋尖儿。\n",
		(: random_move :),
		(: random_move :),
		(: random_move :),
		(: random_move :),
		(: random_move :),
	}) );
	message_vision("$N向$n挥了挥手，叫道：去！玩去吧！\n",me,ob);
	message_vision("$N走开几步，还回头望望$n，一付恋恋不舍的样子。\n",ob,me);
	return 1;
	
}
int do_order(string arg)
{
	object me = this_player();
	me->add("gin",-5);
	if(random(100) < 80 )
	message_vision(this_object()->name()+arg+"\n",this_object());
	else
	message_vision("$N打了个哈欠，有点犯困了。\n",this_object());
	return 1;
}

int do_modify(string arg)
{
	string item, msg;
        object me,ob;
        me = this_player();
        ob = this_object();
        if(!ob->query_leader()) return notify_fail("你先得把它抓(catch)过来。\n");
	if(!arg || sscanf(arg,"%s %s",item,msg) != 2)
	return notify_fail("指令格式: modify 类别 内容\n"
	                    +"现可设定name,long,title,arrive_msg,leave_msg五个类别。\n"
	                    +"举例1：modify name 小星星\n"
	                    +"举例2：modify arrive_msg 懒洋洋的走了过来\n\n");
	if(item == "flee")
	{
		set("env/wimpy", atoi(msg));
                write("ＯＫ\n");
		return 1;
	}
	me->add("gin",-10);
	
	msg = replace_string(msg, "$BLK$", BLK);
	msg = replace_string(msg, "$RED$", RED);
	msg = replace_string(msg, "$GRN$", GRN);
	msg = replace_string(msg, "$YEL$", YEL);
	msg = replace_string(msg, "$BLU$", BLU);
	msg = replace_string(msg, "$MAG$", MAG);
	msg = replace_string(msg, "$CYN$", CYN);
	msg = replace_string(msg, "$WHT$", WHT);
	msg = replace_string(msg, "$HIR$", HIR);
	msg = replace_string(msg, "$HIG$", HIG);
	msg = replace_string(msg, "$HIY$", HIY);
	msg = replace_string(msg, "$HIB$", HIB);
	msg = replace_string(msg, "$HIM$", HIM);
	msg = replace_string(msg, "$HIC$", HIC);
	msg = replace_string(msg, "$HIW$", HIW);
	msg = replace_string(msg, "$NOR$", NOR);	
	switch(item)
	{
	case "long":
	        if( (strlen(msg) < 2) || (strlen(msg) > 100 ) )
		return notify_fail("对不起，描述必须是一到五十个中文字。\n");
		if( !check_legal_name(msg))
	        return notify_fail("");
		set("long",msg+"\n");
		message_vision("$N仰头望着$n，搞不懂$n在做什么。\n",ob,me);
		return 1;
	case "name" :
	        if( (strlen(msg) < 2) || (strlen(msg) > 30 ) )
		return notify_fail("对不起，名字必须是一到十个中文字。\n");
		set("name", msg + NOR);
		message_vision("$N喵的叫了一声，似乎很喜欢$n给它起的名字。\n",ob,me);
                return 1;
	case "title" :
	        if( (strlen(msg) < 2) || (strlen(msg) > 30 ) )
		return notify_fail("对不起，TITLE必须是一到十个中文字。\n");
                set("title", msg + NOR);
                message_vision("$N温顺的趴在$n的脚边。\n",ob,me);
                return 1;
	case "arrive_msg" :
	        if( (strlen(msg) < 2) || (strlen(msg) > 30 ) )
		return notify_fail("对不起，ARRIVE_MSG必须是一到十五个中文字。\n");
		if( !check_legal_name(msg))
	        return notify_fail("");
                set("arrive_msg",msg);
                write("ＯＫ\n");
                return 1;
        case "leave_msg" :
                if( (strlen(msg) < 2) || (strlen(msg) > 30 ) )
		return notify_fail("对不起，LEAVE_MSG必须是一到十五个中文字。\n");
		if( !check_legal_name(msg))
	        return notify_fail("");
                set("leave_msg",msg);
                write("ＯＫ\n");
                return 1;

	}
	return notify_fail("你要修改什么？\n");

}
int check_legal_name(string name)
{
        int i;
        i = strlen(name);
        while(i--) {
                if( name[i]<=' ' ) {
                        write("对不起，宠物描述不能用控制字元。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，宠物描述必需是中文。\n");
                        return 0;
                }
        }
        return 1;
}
string status_color(int current, int max)
{
        int percent;

        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}
int do_hp(string arg)
{
	mapping my;
//	string hp;
	int at_pt,pa_pt,do_pt;
	my = query_entire_dbase();

	if(!arg) return 0;
	if(arg != "cat") return notify_fail("你只能查看自己或宠物的属性。\n");
	printf(" 精神：%s%3d / %3d %s(%3d%%)\n"NOR" 气血：%s%3d / %3d %s(%3d%%)\n"+NOR,
                status_color(my["gin"], my["eff_gin"]), my["gin"],my["eff_gin"],
                status_color(my["eff_gin"], my["max_gin"]),     my["eff_gin"] * 100 / my["max_gin"],
                status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
                status_color(my["eff_kee"], my["max_kee"]),     my["eff_kee"] * 100 / my["max_kee"],
	);		
	printf(" 主人： %s\t经验： %d\t杀气： %d\n",
	query_temp("owner"), my["combat_exp"],my["bellicosity"]
	);
        printf(" 悟性： %d\t根骨： %d\t容貌： %d\n",
        query_int(), query_con(),query_per()
        );
        printf(" 膂力： %d\n",
        query_str()
        );
        at_pt= COMBAT_D->skill_power(this_object(), "unarmed", SKILL_USAGE_ATTACK);
        pa_pt= COMBAT_D->skill_power(this_object(), "unarmed", SKILL_USAGE_DEFENSE);
        do_pt= COMBAT_D->skill_power(this_object(), "dodge", SKILL_USAGE_DEFENSE);
        printf(" 攻击力： %d\t\t防御力： %d\n\n",
        at_pt+1, pa_pt/2+do_pt/2+1
        );
	return 1;
}
void unconcious()
{
die();
}

