// Room: /ly/pic_shop.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "倾城画店");
	set("long", 
"一间精致的画室，厅堂高挂一副匾额，上书“"+CYN"国色天香"NOR+"”。
四周到处挂着名家字画，主要画的是牡丹，姹紫嫣红，风格各异。
书法作品也大都是咏赞牡丹的。\n"
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"east3",
]));
        set("objects", ([
              __DIR__"npc/zheng" : 1,
        ]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
