//Room:  wuguan5.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short","神拳无敌");
        set("long",
"拳脚功夫是天下任何一种武功的基础，讲究稳扎稳打。只有
打好扎实基础，在防身对敌应战之时才会显示出深厚功底。练拳
要求精神集中，方能至“形神合一”的境界。\n"
);
        set("exits",([
                   "south" : __DIR__"wuguan2",
]));
        set("objects", ([
              __DIR__"npc/mengxiong" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        setup();

}

void init()
{

        object ob;
        if( interactive(ob = this_player())) {
                if (!wizardp(ob)) {
                        if (sizeof( filter(all_inventory(),
                                (: (userp($1)) && (!wizardp($1)) && 
                                ($1 != this_user()) :) )) >= 2 ) {
                                tell_object(ob,"练功室里面已经人满了，你只好退了出去。\n");
                                ob->move(__DIR__"wuguan2");
                                return;
                        }
                }
        }
        return;
}
void reset()
{
        object          *inv;
        int             i;

        inv = all_inventory(this_object());
        if( sizeof(inv) != 1) {
            for(i=sizeof(inv)-1; i>=0; i--)
                if(!wizardp(inv[i])) {
                    if(userp(inv[i]))
                        inv[i]->move(__DIR__"wuguan2");
                    else destruct(inv[i]);                    	
                }
        }
        ::reset();
}
