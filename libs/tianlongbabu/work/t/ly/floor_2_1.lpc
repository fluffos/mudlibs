// Room: /ly/floor_2_1.c

inherit STD_ROOM;

void create()
{
        set_short("客栈二楼");
        set_long( @LONG
你正走在古城客栈二楼的走廊上，来往客人都在房中安歇。
楼下客人饮酒行令之声隐隐传来，此外四处一片安静。后院有几
匹马在低头吃草料，偶尔抬头看看你。
LONG
        );
        set_exits( ([ /* sizeof() == 4 */
                "south" : __DIR__"floor_2_3",
                "west" : __DIR__"floor_2_2",
                "east" : __DIR__"sleep_1",
                "down" : __DIR__"hotel",
        ]));

        setup();
        replace_program(STD_ROOM);
}
