// bag.c

inherit ITEM;
string time_period(int);
void create()
{
        set_name("麻布袋", ({ "bag" }));
        set_weight(500);
        set_max_encumbrance(8000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一只用麻布织成的袋子，好像可以装东西。\n");
                set("value", 200);
        }
}

void init()
{
            add_action("do_qqq", "qqq");
}
int do_qqq()
{
        int timep;
        string timenow;
        timep = 100;
        timenow = time_period(timep);
        
        write(timenow);
        return 1;
}
string time_period(int timep)
{
        int t, d, h, m, s;
        string time;

        t = timep;
        s = t % 60;
        t /= 60;
        m = t % 60;
        t /= 60;
        h = t % 24;
        t /= 24;
        d = t;

        time = d ? chinese_number(d) + "天" : "";
        time += h ? chinese_number(h) + "小时" : "";
        time += m ? chinese_number(m) + "分" : "";
        time += s ? chinese_number(s) + "秒" : "";

        return time;
}
