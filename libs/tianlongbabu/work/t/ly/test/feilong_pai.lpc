// feilong pai.c 飞龙腰牌

#include <ansi.h>

inherit EQUIP;

void create()
{
        set_name( HIY"飞龙腰牌"NOR, ({ "feilong pai", "pai" }) );
        set_weight(500);
        set("no_drop", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "一块金黄色的腰牌，上面刻着一条腾空而起、栩栩如生的飞龙。\n这是【万仙寨】的重要信物。\n");
                set("value", 10000);
                set("material", "cloth");
                set("armor_type", "waist");
                set("armor_prop/personality", 2);
                set("armor_prop/armor", 4);
                set("armor_prop/dodge", -1);
                set("wear_msg", "$N将$n拿出系在腰上。\n");
        }
}
int query_autoload()
{
        return 1;
}
