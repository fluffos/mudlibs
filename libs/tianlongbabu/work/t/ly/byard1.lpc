// Room: /t/ly/byard1.c

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "一层大院");
        set("long", @LONG
这里是丐帮总舵的一层大院，数名乞丐正在院中巡视。一条
甬道通向南边的一个小门。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"bgate",
  "south" : __DIR__"byard2",
]));
        set("objects", ([
              __DIR__"npc/beggarguard2" : 2,
        ]));
        set("outdoors", 1);
        set("no_clean_up", 0);

        setup();
        
}

void init()
{
        int guan;
        object me,ob;
        me = this_player();
        ob = present("beggar", environment(me));
        guan = me->query_temp("gaibang/guan");
        if(objectp(ob) && living(ob)) {
                if((me->query("family/family_name") != "丐帮") && (guan < 1)) {
                message("channel:chat", YEL+"【丐帮】：" + "有人闯入丐帮总舵！\n" + NOR, users());
                me->set_temp("gaibang/guan",1);
                }
        }
}

int valid_leave(object me, string dir)
{
        object ob;
        ob = present("beggar", environment(me));
        if (dir == "south") {
        if (objectp(ob) && living(ob)) {
                if(me->query("family/family_name") != "丐帮")
                return notify_fail(ob->query("name")+"伸手一拦，道：丐帮重地，外帮弟子不得入内！\n");
                }
        return ::valid_leave(me, dir);
        }
        return 1;
}


