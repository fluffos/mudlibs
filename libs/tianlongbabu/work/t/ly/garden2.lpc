// Room: /u/z/zili/ly/garden2.c

inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", @LONG
传说唐后武则天在一个隆冬大雪纷飞的日子饮作诗。她乘酒
兴醉笔写下诏书“明朝游上苑，火速报春知，花须连夜发，莫待
晓风吹”。百花慑于此命，一夜之间绽开齐放，惟有牡丹抗旨不
开。武则天勃然大怒......
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"garden3",
  "west" : __DIR__"garden1",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
