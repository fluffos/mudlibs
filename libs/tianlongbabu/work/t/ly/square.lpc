// Room: /u/z/zili/ly/square.c

inherit ROOM;
mapping *total_exits = ({
        (["exit": "/t/taiyue/tiankuang",]),
        (["exit": "/t/kaifeng/center",]),
        (["exit": "/t/penglai/hotel",]),
        (["exit": "/t/dali/cross",]),
        (["exit": "/t/ly/eastgate",]),
        (["exit": "/t/tianshan/hall",]),
        (["exit": "/t/xueshan/dadian",]),
        (["exit": "/t/xingxiu/hole",]),
        (["exit": "/t/yunzhou/dajie4",]),
        (["exit": "/t/dengfeng/city-center",]),
        (["exit": "/t/qinzhai/kongdi",]),
        (["exit": "/t/yipin/yipin",]),
});
void create()
{
        set("short", "洛阳中心");
        set("long", @LONG
这里是洛阳城的中心，四通八达，人来人往甚是热闹。向东
可通往汴梁城，向西是通向西夏的大道。古代曾有九朝皇帝定都
于洛阳，古都的文化色彩浓厚，就连市井行人也都彬彬有礼。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
            "west" : __DIR__"west1",
            "north" : __DIR__"north1",
            "east" : __DIR__"east1",
            "south" : __DIR__"south1",
]));
        set("objects", ([
              __DIR__"npc/master/master_yi" : 1,
        ]));
        set("outdoors", 1);
        set("no_clean_up", 0);

        setup();
}
void init()
{
        int beggar_amount,ran;
        mapping ran_exits;
        object ob,*beggar;
        string dest;
        beggar = children("/t/ly/npc/beggar.lpc");
        beggar_amount = sizeof(beggar);
        ran = random(beggar_amount);
        if( (beggar_amount-20) >= 0 ) {
                if(ran > 16) {
                        destruct(beggar[random(beggar_amount-ran)]);
                        return;
                }
        }
        if(ran < 4) {
        ran_exits = total_exits[random(sizeof(total_exits))];
        dest = (string)ran_exits["exit"];
        /* Overlay is incomplete: most wander targets were never shipped. */
        if (file_size(dest + ".lpc") < 0 && file_size(dest + ".c") < 0)
                return;
        ob = new("/t/ly/npc/beggar.lpc");
        if (objectp(ob) && catch(ob->move(dest)))
                destruct(ob);
        }
}

