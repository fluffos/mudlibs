// Room: /ly/road2.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "黄土小径");
	set("long", @LONG
一条黄土小径，曲曲折折通向远方，路两旁杂草丛生。这里
人迹渐少，只有些过路的行商。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "north" : __DIR__"road3",
          "southeast" : __DIR__"road1",
]));

        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
