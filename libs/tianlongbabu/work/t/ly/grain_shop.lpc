// Room: /ly/grain_shop.c
inherit ROOM;

void create ()
{
        
        set("short", "粮店");
        set("long", @LONG
这里是洛阳一家大富豪开的粮店，平日生意兴隆。每日里不
断有大车运来成包的面粉白米，伙计进进出出，忙着扛运，连头
上都沾了一层白粉。这里正在招人打工，你要是缺钱可以去卖卖
力气，挣几两银子(work)。
LONG);
        set("objects", ([ /* sizeof() == 1 */
                    __DIR__"npc/supervisor" : 1,
                    __DIR__"npc/fellow" : 1,
]));

        set("exits", ([ /* sizeof() == 1 */
                  "west" : __DIR__"south2",
]));

        setup();
}
void init()
{
        add_action("do_work", "work");
}

int do_work(string arg)
{
        object ob;
        object me;

        me = this_player();

   if (! me->query_temp("working_in_liangdian")) {
message_vision("$N从大车上卸下一袋袋面粉，扛进粮仓，累的腰酸腿疼！\n",me);
        me->add("kee",-20);
        ob = new("/obj/money/silver");
        ob->move(me);
        message_vision("监工拍拍$N的肩膀说：辛苦啦，这是你的工钱。\n",me);
        me->set_temp("working_in_liangdian",1);
        remove_call_out ("reset_work");
        call_out ("reset_work",4,me);
    } else
    {
        message_vision("监工对$N叫道：慢慢干，别着急！\n",me);
    }
        return 1;
}
void reset_work (object me)
{
        me->set_temp("working_in_liangdian",0);
}


