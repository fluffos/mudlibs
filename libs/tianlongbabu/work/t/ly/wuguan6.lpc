//Room:  wuguan6.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short","身轻如燕");
        set("long",
"轻功不仅要求天生异禀，后天的苦练也缺少不了。在战斗中
拳脚兵器固然重要，腾挪躲闪的作用也非同小可。轻功除了普通
的蹿腾跳跃之外，还融入了很多动物鸟兽的姿态。\n"
);
        set("exits",([
                   "north" : __DIR__"wuguan2",
]));
        set("objects", ([
              __DIR__"npc/tanying" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        setup();

}

void init()
{

        object ob;
        if( interactive(ob = this_player())) {
                if (!wizardp(ob)) {
                        if (sizeof( filter(all_inventory(),
                                (: (userp($1)) && (!wizardp($1)) && 
                                ($1 != this_user()) :) )) >= 2 ) {
                                tell_object(ob,"练功室里面已经人满了，你只好退了出去。\n");
                                ob->move(__DIR__"wuguan2");
                                return;
                        }
                }
        }
        return;
}
void reset()
{
        object          *inv;
        int             i;

        inv = all_inventory(this_object());
        if( sizeof(inv) != 1) {
            for(i=sizeof(inv)-1; i>=0; i--)
                if(!wizardp(inv[i])) {
                    if(userp(inv[i]))
                        inv[i]->move(__DIR__"wuguan2");
                    else destruct(inv[i]);                    	
                }
        }
        ::reset();
}
