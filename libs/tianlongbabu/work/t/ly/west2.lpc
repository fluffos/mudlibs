// Room: /ly/west2.c

inherit ROOM;

void create()
{
	set("short", "洛阳西街2");
	set("long", @LONG
这里是洛阳城西大街。北面是个贩马的集市，赶路之人常在
这里换匹好马。南面是处民居，从院子里升起炊烟袅袅。一个老
乞丐站在对面街边看着你。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"west3",
  "east" : __DIR__"west1",
  "north" : __DIR__"horse_shop",
]));
        
	set("outdoors", 1);
	set("objects", ([
            __DIR__"npc/old_beggar" : 1,
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
