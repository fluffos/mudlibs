// Room: /ly/wine_shop.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
string look_wall(object me);
void create()
{
	set("short","诗都酒馆");
	set("long",
"这是一间铺面不大的小酒肆，一进来就闻到扑鼻酒香，中人
欲醉。酒肆老板是个中年女子，打扮的甚是妖娆。四周墙壁上题
满了诗文，你若有兴趣也来读读啊。\n"
	);
	set("exits", ([ /* sizeof() == 1 */
            "south" : __DIR__"east3",
]));
        set("objects", ([
              __DIR__"npc/yelaixiang" : 1,
        ]));
        set("item_desc", ([
		"墙壁": (: look_wall :),
		"wall": (: look_wall :),
	]) );
        set("no_clean_up", 0);
        set("indoors", 1);

	setup();
}
string look_wall(object me)
{
	return "你可以读读(read)墙壁上的诗句。\n";
}
void init()
{
        add_action("do_read", "read");
}
int do_read(string arg)
{
        if( !arg || arg!="wall" ) return 0;
        write("你看到墙壁上题着这样一句诗：\n");
        switch (random(23)) {
        case 0:
          write("云想衣裳花想容，春风拂槛露华浓。\n");
          break;
        case 1:
          write("解释春风无限恨，沉香亮北倚阑干。\n");
          break;
        case 2:
          write("何人不爱牡丹花，占断城中好物华。\n");
          break;
        case 3:
          write(this_player()->name()+"到此一游，佩服！佩服！\n
          咦？怎么会有同名的？\n");
          break;
        case 4:
          write("疑是落川神女作，千娇万太破朝霞。\n");
          break;
        case 5:
          write("寻芳不觉醉流霞，倚树沉眠深夜后。\n");
          break;
        case 6:
          write("客散酒醒日已斜，更持红烛赏残花。\n");
          break;
        case 7:
          write("名花倾城两相欢，长得君王带笑看。\n");
          break;
        case 8:
          write("若非群玉山头见，会问瑶台月下逢。\n");
          break;
        case 9:
          write("碧蕊青霞压众芳，檀心诸朵韫真香。\n");
          break;
        case 10:
          write("花残又是一年事，莫谴春光放日长。\n");
          break;
        case 11:
          write(this_player()->name()+"看花花不语，我的心中下小雨。\n
          谁拿我的名字开玩笑？气愤！\n");
          break;
        case 12:
          write("沉沉色与露滴，泥泥香随日烘。\n");
          break;
        case 13:
          write("满眼艳妆红袖，紫绡终是仙风。\n");
          break;
        case 14:
          write("宫云朵朵映朝霞，白宝栏前斗丽花。\n");
          break;
        case 15:
          write("卯酒未削红玉面，薄施檀粉伴梅花。\n");
          break;
        case 16:
          write("洛阳女儿红颜饶，白色罗裙宝抹腰。\n");
          break;
        case 17:
          write("借的霓裳半庭月，居然管领百花朝。\n");
          break;
        case 18:
          write("邀勒春风不早开，众芳飘后上楼台。\n");
          break;
        case 19:
          write("数苞仙艳火中出，一片异香天上来。\n");
          break;
        case 20:
          write("粉香云暖露花新，晓日浓熏富贵春。\n");
          break;
        case 21:
          write("好似沉香亭上看，东风依约可怜人。\n");
          break;
        case 22:
          write(this_player()->query("id")+" is a pig!\n
          faint...\n");
          break;
        }
        return 1;
}