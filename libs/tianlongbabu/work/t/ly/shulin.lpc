// Room: /ly/shulin.c
#include <ansi.h>
#include <room.h>

inherit ROOM;
void create()
{
        set("short", YEL"大义分舵"NOR);
        set("long", @LONG
绕过几颗杏树后，林中有一块空地。几个乞丐盘膝坐在地上，
一位老丐背着手站在树下。
LONG
        );
        
        set("exits", ([ /* sizeof() == 2 */
          "north" : __DIR__"shulin13",
]));
        set("objects", ([
              __DIR__"npc/beggar1" : 1,
              __DIR__"npc/beggar6" : 1,
              __DIR__"npc/master_wuming" : 1,
        ]));
        set("no_clean_up", 0);
        set("outdoors", 1);
        setup();
        
}

