// Room: /ly/yard.c

inherit ROOM;

void create()
{
	set("short", "民宅内院");
	set("long", @LONG
走进内院之中，只觉一片萧瑟。院中一棵大树，满地落叶堆
积，四周杂草丛生。一位老汉坐在北面的正房前抽旱烟，别处毫
无人迹。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"house3",
  "south" : __DIR__"house5",
  "east" : __DIR__"house4",
  "west" : __DIR__"house1",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
