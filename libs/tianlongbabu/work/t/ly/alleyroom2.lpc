// Room: /ly/shulin.c
#include <ansi.h>
#include <room.h>

inherit ROOM;
void create()
{
        set("short", YEL"大仁分舵"NOR);
        set("long", @LONG
穿过窄小的院子，你走进一间破败不堪的陋室。房顶破了两
个窟窿，墙上粉泥斑驳，还有一道道漏雨留下的水印。几名乞丐
盘膝坐在地上，不知在谈论什么事情。
LONG
        );
        
        set("exits", ([ /* sizeof() == 2 */
          "south" : __DIR__"alleyroom",
]));
        set("objects", ([
              __DIR__"npc/beggar3" : 1,
              __DIR__"npc/beggar4" : 1,
              __DIR__"npc/master_xi" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        create_door("south", "大门", "north", DOOR_CLOSED);
        setup();
        
}

