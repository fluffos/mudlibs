inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", @LONG
武则天勃然大怒，遂将牡丹贬至洛阳。刚强不屈的牡丹一到
洛阳就昂首怒放，这更激怒了武后，便又下令烧死牡丹。枝干虽
被烧焦，但到第二年春，牡丹反而开的更盛......
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"garden4",
  "west" : __DIR__"garden2",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
