// Room: /ly/house3.c

inherit ROOM;

void create()
{
	set("short", "民宅北房");
	set("long", @LONG
高屋建瓴的北房可以看出昔日的光辉，而今已破败不堪。四
处蛛网结张，灰尘厚积。一位老汉蹲在门前的台阶上抽旱烟，只
听得风声在檐角吹过，还有老汉“吧嗒吧嗒”的抽烟声。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "enter" : __DIR__"house6",
  "south" : __DIR__"yard",
]));
        set("objects", ([
              __DIR__"npc/old_man" : 1,
        ]));

	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
int valid_leave(object me, string dir)
{
	if ((dir == "enter") 
	&& (!me->query_temp("hairpin"))
	&& objectp(present("old man", environment(me))) )
	return notify_fail("老汉一言不发，站起身来挡在门前。\n");
	return ::valid_leave(me, dir);
}