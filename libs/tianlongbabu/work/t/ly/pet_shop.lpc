// pet_shop.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
string look_sign();
void create()
{
        set("short", "宠物店");
        set("long", @LONG
这里是一家宠物店，专卖一些可爱的小动物，给客人自己
带回家喂养。只见围栏里有许多小猫小狗跳来跳去，折腾个不
停。一位小姑娘正忙着给它们喂食。墙上挂着个小牌子(sign)。
LONG
        );
        set("exits", ([
                "east": __DIR__"north3",
        ]) );
        set("item_desc",([
            "sign" : (: look_sign :),
            "牌子" : (: look_sign :),
]));
        set("indoors", 1);
        set("objects", ([
            __DIR__"npc/ali" : 1,
]));
        set("no_clean_up", 0);
        setup();
//      replace_program(ROOM);
}
string look_sign()
{
        return
        "\n"
    "    ※※※※※※※※※※※※※※※※※※※※※※※\n"
    "    ※　　　        《购买宠物须知》    　　　  ※\n"
    "    ※　　　                            　　　  ※\n"
    "    ※　　  购买宠物请用(select)指令，现在本店  ※\n"
    "    ※  只卖小猫(cat)，以后会给大家提供更多的品 ※\n"
    "    ※  种。每只小猫价值十两黄金。请您带足钱。  ※\n"
    "    ※      如果您已经买了一只宠物，请用modify  ※\n"
    "    ※  指令来给它起名字。您可以设定宠物的名字、※\n"
    "    ※  描述、Title、行走信息等多项属性。具体使 ※\n"
    "    ※  方法请在买完宠物后打(modify)来查阅。    ※\n"
    "    ※      当您的宠物四处乱跑不听话时，您可以  ※\n"
    "    ※  用(catch)指令把他叫到身边。如果您想放它 ※\n"
    "    ※  出去散散步，请用(letgo)指令。           ※\n"
    "    ※      如果您要离开时，可以把您的宠物寄养  ※\n"
    "    ※  (feed)在我这里，要取走时请用(redeem)指  ※\n"
    "    ※  令。对了，寄养要花一两黄金。            ※\n"
    "    ※      您还可以用(hp cat)指令来查看您的宠  ※\n"
    "    ※  物的身体状况。千万要小心爱护啊！        ※\n"
    "    ※                                          ※\n"
    "    ※                                 阿黎     ※\n"
    "    ※※※※※※※※※※※※※※※※※※※※※※※\n\n";
}
void init()
{
        object me;
        string petname;
        me = this_player();
        if(me->query("petname")) {
                petname = me->query("petname");
                message_vision(RED + petname + "从围栏中探出头来，向$N喵喵直叫。\n"
                + NOR,me);
        }
}

        
