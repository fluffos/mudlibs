// Room: /t/ly/zytang.c

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", CYN"『"NOR+RED"忠义堂"NOR+CYN"』"NOR);
        set("long", @LONG
这里是丐帮总舵『忠义堂』。当中立着关公的泥像，手挽长
髯，威风凛凛。四周墙壁到处题满了世间流传的忠义之事，刘关
张三人结义之典更是此中盛举。丐帮弟子以忠义为先，愿为朋友
抛头颅、洒热血，虽身贱为丐，但以国家兴亡为己任，虽一生穷
困漂泊，但意气风发不失男儿之志。
LONG
        );
        set("exits", ([
  "north" : __DIR__"byard3",
//  "south" : __DIR__"bzytang",
]));
        set("objects", ([
              __DIR__"npc/qiaofeng" : 1,
              __DIR__"npc/beggar8" : 2,
        ]));
        set("indoors", 1);
        set("no_clean_up", 0);

        setup();
        
}

void init()
{
        int guan;
        object me,ob;
        me = this_player();
        ob = present("beggar", environment(me));
        guan = me->query_temp("gaibang/guan");
        if(objectp(ob) && living(ob)) {
                if((me->query("family/family_name") != "丐帮") && (guan < 4)) {
                message("channel:chat", YEL+"【丐帮】：" + "有人闯入丐帮总舵『忠义堂』！\n" + NOR, users());
                me->set_temp("gaibang/guan",4);
                }
        }
}

int valid_leave(object me, string dir)
{
        object ob;
        ob = present("beggar", environment(me));
        if (dir == "south") {
        if (objectp(ob) && living(ob)) {
                if(me->query("family/family_name") != "丐帮")
                return notify_fail(ob->query("name")+"伸手一拦：里面是丐帮重地，无帮主之命任何人不得入内！\n");
                }
        return ::valid_leave(me, dir);
        }
        return 1;
}


