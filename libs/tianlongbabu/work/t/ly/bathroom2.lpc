// Room: /d/ly/bathroom2.c 

#include <ansi.h>
inherit ROOM; 
string look_slot(object me);

void create() 
{ 
	set("short", "过道");
	set("long", @LONG
这里是门厅后的一条过道，通向浴室。偶尔有人擦肩而过，
带着一缕芳香。走到此处，路已截止，南、北各有一间浴室，
东边也有个小门，不时从门缝中飘出水气。
LONG
	);
	set("no_clean_up", 0);
	set("indoors", 1);
	set("exits", ([ /* sizeof() == 3 */
  "northup" : __DIR__"bathroom3",
  "southup" : __DIR__"bathroom4",
  "west" : __DIR__"bathroom1",
]));
        set("item_desc", ([
		"门缝": (: look_slot :),
		"slot": (: look_slot :),
	]) );

	setup();
}

string look_slot(object me)
{
	if (random(10)>2) return "屋中水汽弥漫，好象有人在洗澡，但什么也看不清。\n";
	return "屋中一片水汽，有个女子在洗澡，你想从门缝偷窥(Peep slot)吗？\n";
}

void init()
{
        add_action("do_peep", "peep");
}

int do_peep(string arg)
{
	object me;
	me = this_player();
        if( !arg || arg!="slot" ) return 0;
        write("你把眼睛凑到门缝边，朦胧中看到......\n");
        if( !me->query("peepma")) {
        	if( !me->query_temp("peep")) {
        		switch (random(6)) {
        			case 0:
                                write("一个白衣女子轻轻解下罗衫，放在门边的小桌上。\n");
                                me->set_temp("peep", 1);
                                break;
                                case 1:
                                write("一只纤纤小手在光滑的小腿上轻轻抚摩。\n");
                                me->set_temp("peep", 1);
                                break;
                                case 2:
                                write("一个年轻女子将身上衣服脱尽，踏进一个冒着热气的浴桶之中。\n");
                                me->set_temp("peep", 1);
                                break;
                                case 3:
                                write("纤细的腰肢缓缓扭动，如同伴乐而舞。\n");
                                me->set_temp("peep", 1);
                                break;
                                case 4:
                                write("一个女子坐在浴桶中洗澡，云鬓上插着的一只珠花在微微颤抖。\n");
                                me->set("peepma", 1);
                                break;
                                case 5:
                                write("那女子将玉腿舒展，水珠顺着白皙的皮肤滑落。\n");
                                me->set_temp("peep", 1);
                                break;
                        }
                } else write("一片水雾飘过，你什么也看不到了。\n");
        } else write("一个胖老太婆在洗脚，发觉门缝外有人偷窥，大叫：来人哪！有色狼！\n");
        return 1;
}