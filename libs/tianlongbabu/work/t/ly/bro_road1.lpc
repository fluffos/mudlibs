// Room: /ly/bro_road1.c 
 
#include <door_room.h>
inherit OBJ_ROOM;
inherit DOOR_ROOM;

void create() 
{ 
        set_short("碎石小径");
        set_long(@LONG
这里是玉春楼后院，稀稀疏疏种着几株玉兰。西北角有个小门
通往前庭。两侧回廊静悄悄了无声息。一条碎石小径曲折通幽。
LONG
        );
        set_exits( ([ /* sizeof() == 3 */
  "east" : __DIR__"bro_road2",
]));
        create_door("northwest",__DIR__"brothel","红木小门","southeast",STATUS_CLOSE); 
        setup();
}

