// weapon_store.c

inherit ROOM;

void create()
{
        set("short","名器鉴定店");
        set("long",@LONG
天下好武之人都爱宝刀利剑，偶尔寻到一件名器，也需找个
名家鉴定一下。这里的白老板是位使剑的行家，他也收集了不少
好剑。一走进这间屋，便感到寒气逼人。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
                "north" : __DIR__"west1",
        ]));

        set("objects", ([ /* sizeof() == 2 */
                __DIR__"npc/bai" : 1,
        ]));
        set("no_clean_up", 0);
        set("indoors", 1);
        setup();
        replace_program(ROOM);
}
