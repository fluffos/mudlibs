// Room: /u/z/zili/ly/garden10.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
CYN"    云想衣裳花想容，春风拂槛露华浓。
        若非群玉山头见，会问瑶台月下逢。\n"NOR,
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"garden9",
  "west" : __DIR__"garden11",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
