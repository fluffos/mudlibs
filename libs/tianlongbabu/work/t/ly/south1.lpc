// Room: /u/z/zili/ly/brothel.c

inherit ROOM;

void create()
{
	set("short", "洛阳南街1");
	set("long", @LONG
洛阳大街宽阔平整，这里正是繁华地区，街两旁店铺林立。
路西是家药店。路东有家妓院，是洛阳城一大景观。但是嘛....
还是不要去的为好:P
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"square",
  "south" : __DIR__"south2",
  "west" : __DIR__"med_shop",
  "east" : __DIR__"brothel",
]));
        set("objects", ([
              __DIR__"npc/harlot" : 1,
        ]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
}
int valid_leave(object me, string dir)
{
	if ((dir == "east") && (this_player()->query("gender") == "女性"))
	   return notify_fail("那是爷们儿去的地方，你去干嘛？\n");
	if ((dir == "east") && ((int)me->query("age") < 18))
	   	  return notify_fail("等你长大了再来吧！\n");
	return ::valid_leave(me, dir);
}