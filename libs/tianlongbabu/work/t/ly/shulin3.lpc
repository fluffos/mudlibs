// Room: /ly/shulin3.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "树林");
	set("long", @LONG
你在树林中穿行，枝叶交错很难辨认路径。脚下铺着厚厚一
层落叶，踩上去很舒服。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
	  "northeast" : __DIR__"shulin5",
          "northwest" : __DIR__"shulin6",
          "southeast" : __DIR__"road3",
]));
        set("no_clean_up", 0);
        set("outdoors", 1);
	setup();
	replace_program(ROOM);
	
}

        
