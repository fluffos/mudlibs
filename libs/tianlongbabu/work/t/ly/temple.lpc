// Room: /ly/temple.c

inherit OBJ_ROOM;

void create()
{
        set_short("洛神庙");
	set_long( @LONG
传说伏羲氏之女宓妃降临人间，河伯为其美色所迷，将宓妃
押入水府。后翌闻听此事，赶来打败河伯救出宓妃，两人产生感
情，便定居洛阳。天帝封宓妃为洛神。后人就建了这座庙宇，洛
神的故事也代代相传至今。堂正中供着一尊雕像。
LONG
	);
	set_exits( ([ /* sizeof() == 1 */
  "southwest" : __DIR__"temple_road",
  "north" : __DIR__"temple_back",
]));
        set_items( ([ /* sizeof() == 2 */
           "雕像" : "一尊洛神宓妃的雕像。\n",
           "statue" : "一尊洛神宓妃的雕像。\n",
]));

	setup();
	replace_program(OBJ_ROOM);
}
