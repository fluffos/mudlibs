// Room: /ly/house4.c

inherit ROOM;

void create()
{
	set("short", "民宅东房");
	set("long", @LONG
东房更是破败不堪，几乎倒塌。房顶破个老大窟窿，一束阳
光射进来，无数飞尘在飘舞。地上倒放着几个破陶罐，石板缝间
长出了几株小草。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"yard",
]));
	set("indoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
