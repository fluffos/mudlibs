// Room: /t/ly/qishi1.c
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "幽静小院");
        set("long", @LONG
小院中种满了竹子，一有风吹来就沙沙做响。院外闹市的喧
扰之声似乎被远隔在外，唯有一片幽静闲适。东侧有个小屋，屋
门禁闭，似乎主人不想被打扰。
LONG
        );
        set("exits", ([
  "west" : __DIR__"south4",
  "east" : __DIR__"qishi2",
]));
        set("objects", ([
              __DIR__"npc/rulan" : 1,
        ]));
        create_door("east", "大门", "west", DOOR_CLOSED);
        setup();
}
