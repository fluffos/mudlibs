// Room: /ly/westgate.c

inherit ROOM;
string look_shibei();
void create()
{
	set("short", "洛阳西门");
	set("long", @LONG
这里是洛阳城西门。有两名官兵把守，盔甲鲜明，横挎腰刀。
西面出城渐近荒外，再向西行是通往一品堂的大道。城门边立着
一块小石碑，上面依稀刻着些文字。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  		"west" : __DIR__"wroad",
  		"east" : __DIR__"west4",
	]));
        set("item_desc",([
            	"shibei" : (: look_shibei :),
            	"石碑" : (: look_shibei :),
	]));
        set("objects", ([
              __DIR__"npc/garrison" : 2,
        ]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
//	replace_program(ROOM);
}
