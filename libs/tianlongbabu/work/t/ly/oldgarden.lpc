// Room: /t/ly/oldgarden.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "废园");
        set("long", 
        "这是一个废弃的花园，往日这里曾是富豪显贵的游乐之处，\n"
        "而今已是荒草遍地，一付衰败凄凉景象。园中有一片牡丹花圃，\n"
        "以前都长满了名贵品种，现在只有几朵不知名的小花竞相开放。\n"
        );
        set("exits", ([ /* sizeof() == 2 */
        "east" : __DIR__"north4",
        "west" : __DIR__"swing",
]));
        set("objects", ([
              __DIR__"obj/garden" : 1,
        ]));
        set("outdoors", 1);
        set("no_clean_up", 0);

        setup();
}
void reset()
{
        object          *inv;
        object          container, item;
        int             i;

        ::reset();
        container = present("garden", this_object());
        inv = all_inventory(container);

        if( sizeof(inv) != 1) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/flower_noname");
                item->move(container);
         }
}
