// Room: /u/z/zili/ly/garden8.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "牡丹园");
	set("long", 
MAG"    何人不爱牡丹花，占断城中好物华。
        疑是落川神女作，千娇万太破朝霞。\n"NOR,
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"garden9",
  "east" : __DIR__"garden7",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
