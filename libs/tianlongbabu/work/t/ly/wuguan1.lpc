LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"west3",
  "northeast" : __DIR__"wuguan2",
]));
	set("outdoors", 1);
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
