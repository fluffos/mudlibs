// lianroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "香莲居");
        set("long", @LONG
香莲居与走廊对面的银瓶斋迥然不同，屋中最名显的摆设是靠窗的
一张红木描金床，床上粉帘低挂，影约可以看见里面锦被团簇，一股粉
香扑鼻。
LONG
        );
        set("exits", ([
                "east": __DIR__"jiyuan3", 
        ]) );

        set("objects", ([
                __DIR__"npc/lian" : 1,
        ]) );

        setup();
}
