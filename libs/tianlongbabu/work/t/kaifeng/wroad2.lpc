// wroad2.c

inherit ROOM;

void create()
{
	set("short", "汴梁西大街");
	set("long", @LONG
汴梁西大街多为达官贵人所居之处，因此没有太多得喧嚣吵闹之声。
大街南面是大宋国的国都宾馆，专为接待邻国使臣而设。
LONG
	);
	set("exits", ([
		"west": __DIR__"wroad3",
		"east": __DIR__"wroad",
		"south": __DIR__"hotel",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
