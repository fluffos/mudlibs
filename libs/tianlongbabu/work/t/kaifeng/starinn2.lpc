// starinn.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "魁星阁二楼");
	set("long", @LONG
魁星阁是卞梁城有名的雅居，无论是当朝的大员或是著名的雅士都
喜欢到此处来一聚。是个谈天说地，吟诗作画的好去处。北面一块雪白
的粉墙是专为当今名士风老大所留，只是风老大还没想好该在这题些什
么好。
LONG
	);

	set("exits", ([
		"down"	: __DIR__"starinn" ]) );

	//set("objects", ([
	//	__DIR__"npc/star-waiter" : 1 ]) );

	setup();
}
