// bank.c

inherit ROOM;

void create()
{
	set("short", "富贵钱庄");
	set("long", @LONG
富贵钱庄服务周到，信誉着著，在汴梁城里数头块牌子。钱庄里里
外外都打扫得乾乾净净，一个胖胖的中年人坐在柜台後面，柜台上放著
一块牌子（ｓｉｇｎ）。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"east": __DIR__"sroad",
	]));

	set("item_desc", ([
		"sign": @TEXT
富贵钱庄目前提供的服务有：

ｃｈｅｃｋ		存款查询。
ｃｏｎｖｅｒｔ		兑换钱币。
ｄｅｐｏｓｉｔ		存款。
ｌｏａｄ		取款。

TEXT
	]));
	set("objects", ([
		__DIR__"npc/banker": 1
	]));

	setup();
}
