inherit ROOM;
void create()
{
	set("short", "天丰赌坊");
        set("long", @LONG
赌坊里挤满各种各样的赌客，有的面色铁青，一言不发，有的红光
焕发，高声喧哗。厅中摆满各式赌台，中央摆着一张大台子，周围围满
了人，都目不转睛地注视着台上大碗中的骰子，台边的银杠上堆满了银
子，边上还放着一块牌子（ｓｉｇｎ）。
LONG
        );
        set("exits", ([
		"north": __DIR__"yroad",
	]));
        set("item_desc", ([
                "sign": @TEXT

骰子的赌法：

ｂｅｔ 银量 ｏｎ 大|小
ｓａ 骰子

TEXT
        ]) );

        set("objects", ([
        	__DIR__"npc/betman" : 1,
        ]) );
	set("no_fight", 1);
        setup();
}

void init()
{
	object me = this_player();

	if(me->query("gamble_amount")) 
		me->delete("gamble_amount");
}

int valid_leave(object me, string dir)
{
        if( dir == "north")
        {
		if(me->query("gamble_type") || me->query("gamble_amount"))
                	return notify_fail("你下了注，还没撒骰子呢！\n");
        }
        return 1;
}
