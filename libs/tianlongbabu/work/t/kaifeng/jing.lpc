// jing.c

inherit ROOM;

void create()
{
	set("short", "井底");
	set("long", @LONG
井底下一片黑暗，什么也看不清楚，幸好井水不深，只能淹末到膝
盖。奇怪的是这漆黑井底居然要比井口大的多，西边好象有一条隧道，
黑洞洞的，不知通向何处。
LONG
	);
	set("hide_exits", ([
		"west" : __DIR__"jing2",
	]));

	setup();
}

void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	object me;

	if(!arg || arg != "up") return 0;

	me = this_player();
	message_vision("$N顺着滑不溜手的井壁缓缓向井口爬去．．．\n\n", me);
	call_out("move_this", 3, me);
	return 1;
}

void move_this(object ob)
{
	if(random(10) < 2)
	{
		message_vision("$N忽然失手，从井壁上摔了下来！\n", ob);
		ob->unconcious();
		return;
	}
	//tell_object(ob, "过了片刻，你终于爬到了井口！\n\n", ob);
	tell_object(ob, "过了片刻，你终于爬到了井口！\n\n");
	ob->move("/t/kaifeng/biaoju4");
	message("vision", ob->name() + "湿淋淋地从井爬了上来。\n", 
		environment(ob), ob);
}

