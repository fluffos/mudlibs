// nroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁北大街");
	set("long", @LONG
这里是汴梁的北大街。北大街不长，比其它几条大街要短得多，居
住在这条街上多为生意或手意人。再往北走便是汴梁城的北门了，街西
面是白马驿站。
LONG
	);
	set("exits", ([
		"south": __DIR__"nroad",
		"north": __DIR__"ngate",
		"west" : __DIR__"post",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
