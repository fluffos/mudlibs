// stoneroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "墓地");
	set("long", @LONG
墓
地
LONG
	);
	set("exits", ([
		"west": "/t/kaifeng/ngate",
	]) );
	set("item_desc", ([
		"字画" : @TEXT

这是一副狂草，很难辨认写的是些什么，挂幅边上有根小绳，好象
可拽（ｐｕｓｈ）一下。

TEXT
        ]) );
	set("objects", ([
                __DIR__"obj/box" : 1,
	]));

	setup();
}

void init()
{
	add_action("do_push", "push");
}

int do_push(string arg)
{
	object me = this_player();

	if(arg == "小绳" || arg == "rope")
	{
		message_vision("$N拎起字画旁的小绳拽了一下。\n"
			+ "整个墙壁忽然转开，$N也随之转了出去。\n", me);
		me->move(__DIR__"shixiang2");
		message("vision", "青石墙忽然裂开条缝，从里面滑出个人来，"
			+ "青石墙又迅速合拢。\n", environment(me), me);
		return 1;
	}
}

		
void reset()
{
	object box, *inv, ob1, ob2, *child;
	int i;

	::reset();

	child = children(__DIR__"obj/needle");
	if(sizeof(child) < 2)
	{
		box = present("_box_", this_object());
		inv = all_inventory(box);
		if(sizeof(inv) != 1) 
       		{
               		for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
               		ob1 = new(__DIR__"obj/ling");
               		ob2 = new(__DIR__"obj/needle");
			ob2->set_amount(5);
               		ob1->move(box);
               		ob2->move(box);
       		}
	}
}
