// /post.c

inherit ROOM;

void create()
{
	set("short", "白马驿");
	set("long", @LONG
这里是负责百姓收发信件的白马驿站，驿站门口上悬著一块木牌，
上书「白马驿」三字，门口还悬著一块木牌（ｓｉｇｎ）。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "sign" : "牌子上写道：

	指令格式：ａｓｋ　ｏｆｆｉｃｅｒ　ａｂｏｕｔ　＜寄信｜收信＞

",
]));
	set("exits", ([ /* sizeof() == 1 */
		"east" : __DIR__"nroad2",
	]));
	set("objects", ([
		__DIR__"npc/post_officer": 1
	]) );

	setup();
}

int valid_leave(object me, string dir)
{
	object mbox;

	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你将信箱交回了驿站。\n");
		destruct(mbox);
	}
	return 1;
}
