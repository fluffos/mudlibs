// jiyuan2.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "香君楼二楼走廊");
	set("long", @LONG
香君楼二楼是姑娘们陪客人们饮酒品茗，吟诗作赋的地方，甚是幽
雅。走廊的左边是「藏娇屋」，右边是「如玉阁」。
LONG
        );
        set("exits", ([
                "down" : __DIR__"jiyuan",
		"south": __DIR__"jiyuan3",
		"west" : __DIR__"jiaoroom",
		"east" : __DIR__"yuroom",
	]) );

	set("objects", ([
                __DIR__"npc/jiadin" : 2,
        ]) );
        setup();
}

int valid_leave(object me, string dir)
{
        object ob;

        if(dir == "east" && ob = present("jiadin", this_object()))
        {
		message_vision("$N拿着腔对$n道：咱家衙内将如玉阁包下了，"
				+ "闲杂人等一概回避。\n", ob, me);
                return notify_fail("");
        }
        return 1;
}
