// stoneroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "青石大门");
	set("long", @LONG
这是一栋居大的由青石建成的宅子，宅子好象已经许久都没有人住
过了，房檐屋角都长满了野草。这里是整栋宅子的大门，大门由整木做
成，上面有铜制的门环。
LONG
	);
	set("unlocked", 0);
	set("exits", ([
		"west": __DIR__"seroad2",
		"east": __DIR__"stoneroom2",
	]) );

	set("item_desc", ([
		"门环" : @TEXT
门环由黄铜制成，供人敲门（ｋｎｏｃｋ）用的。

TEXT
	]) );

	create_door("east", "大门", "west", DOOR_CLOSED);

	setup();
}

void init()
{
        add_action("do_knock", "knock");
}

int do_knock(string arg)
{
	int i, yorn;
	object *inv, me, ob, sroom;
	string msg, msg2;

	if(!arg || arg != "门环") return 0;

	msg = "$N拿起门环敲了一下。\n";
	me = this_player();
	message_vision(msg, me);
	sroom = load_object(__DIR__"stoneroom2");

	yorn = 0;
	if(sroom)
	{
		inv = all_inventory(sroom);
		for(i=0;i<sizeof(inv);i++)
		{
			if(userp(inv[i]) && living(inv[i]))
			{
				message_vision("大门里面好象有人在说话\n", me);
				tell_room(sroom, "有人在门外敲门！\n");
				yorn = 1;
				return 1;
			} else if(!userp(inv[i]) 
			&& inv[i]->name(1) == "老苍头") {
				ob = inv[i];
				yorn = 2;
			}
		}
	}

	if(yorn == 2) 
	{
		msg2 = "大门「吱呀」一声打开了，探出个老苍头来，上下打量了$N一眼！\n";
		if(me->query("family/family_name") == "腾龙武馆")
		{
			message_vision(msg2, me);
			//open_door("east", "west");
			ob->do_command("open door");
			return 1;
		}
		if(!me->query_temp("knock")) 
		{
			message_vision(msg2, me);
			message_vision("随后又将门给关上了！\n", me);
			me->set_temp("knock", 1);
			return 1;
		}
		if(me->query_temp("knock") < 6)
		{
			message_vision("大门里面无声无息，什么动境也没有！\n", me);
			me->add_temp("knock", 1);
			return 1;
		}
		//open_door("east", "west");
		ob->do_command("open door");
		return 1;
	}
	message_vision("大门里面一点声息也没有，好象根本没有人住在里面！\n", me);
	return 1;
}

int open_door(string dir, int from_other_side)
{
	object me = this_player();

        if(!me->query("knock") && userp(me))
		return notify_fail("大门紧闭，无法打开。\n");
        ::open_door(dir, from_other_side);
	return 1;
}

int valid_leave(object me, string dir) 
{
	if(::valid_leave(me, dir))
	{
		if(dir == "east")
			me->set("knock", 1);
		return 1;
	}
}
