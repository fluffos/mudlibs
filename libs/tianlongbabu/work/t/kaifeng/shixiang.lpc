// shixiang.c

inherit ROOM;

void create()
{
	set("short", "青石巷");
	set("long", @LONG
青石巷又小又窄，却打扫的干干净净。巷口有一个小面摊，附近的
穷苦手艺人都赞小面摊上何老头的面做的好，没事也爱来这坐坐。
LONG
	);
	set("exits", ([
		"west": __DIR__"secenter",
		"east": __DIR__"shixiang2",
	]));
	set("no_clean_up", 0);
	set("objects", ([
                __DIR__"npc/he" : 1,
        ]) );

	setup();
}
