// nwroad.c

inherit ROOM;

void create()
{
	set("short", "壮元巷");
	set("long", @LONG
壮元巷曾经住过一个穷秀才，毕生苦读，后来在五十岁哪年居然中
了壮元，此巷便因此而得名。巷子西面有一家私塾。
LONG
	);
	set("exits", ([
		"north": __DIR__"nwcenter",
		"south": __DIR__"nwroad",
		"west" : __DIR__"school",
		"east" : __DIR__"bookstore",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
