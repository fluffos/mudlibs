 */
 
// huoji.c
inherit NPC;
inherit F_VENDOR;
string heal_me(object me);
void create()
{
	set_name("平一指", ({ "herbalist" }) );
	set("title", "益民堂老板");
	set("nickname", "再世华陀");
	set("gender", "男性");
	set("age", 55);
	set("long",
"益民堂老板平一指是这有名的大善人，常常施舍草药给付不起\n"
"药钱的穷人。此外他的医术精湛，因而得号「再世华陀」。\n" );
	set("combat_exp", 30000);
	set("attitude", "friendly");
	set("inquiry", ([
		"治伤": (: heal_me :),
		"疗伤": (: heal_me :),
		"开药": (: heal_me :),
		"天山雪莲": "天山雪莲长在天山深处，能去百毒，名贵无比！\n",
	]) );

        set("vendor_goods", ([
		"金疮药": __DIR__"obj/medicine1",
		"增神丸": __DIR__"obj/medicine2",
        ]) );

	set_skill("parry", 60);
	set_skill("unarmed", 60);

	setup();

	add_money("silver", 10);
}

string heal_me(object ob)
{
	int ratio;
	object me;

	me = this_player();
	ratio = (int)me->query("eff_kee") * 100 / (int)me->query("max_kee");
	if(ratio >= 100)
		return "这位" + RANK_D->query_respect(me) 
			+ "，您看起来气色很好啊，不像有受伤的样子。";
	if(ratio >= 95)
		return "哦....我看看....只是些皮肉小伤，您买包金创药回去敷敷就没事了。";
	
}

void init()
{
        object ob;

        ::init();
	if(interactive(ob = this_player()) && !is_fighting())
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if(!ob || environment(ob) != environment()) return;
        if(ob->query_condition("corpse_poison"))
        {
		message_vision("$N忽然脸色大变对$n道："
				+ RANK_D->query_respect(ob)
				+ "是中了腐尸毒了，若无天山雪莲"
				+ "做药引，\n"
				+ "此毒无法可解！\n", this_object(), ob);
        }
}

int accept_object(object who, object ob)
{
        object luyu;

	if(ob->name() != "天山雪莲") return 0;

        luyu = new(__DIR__"obj/yulu");
	command("say 对，就是这东西。");
	message_vision("$N从袖掏出一粒九转玉露丸递给$n。\n", this_object(), who);
        luyu->move(who);
        return 1;
}
