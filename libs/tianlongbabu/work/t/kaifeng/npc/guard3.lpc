// guard.c

inherit NPC;

void create()
{
	set_name("趟子手", ({ "guard" }));
	set("gender", "男性");
	set("age", 35);
	set("long", "一名神情彪悍的趟子手。\n");
	set("combat_exp", 5000);
	set("chat_chance", 5);
        set("chat_msg", ({
		"趟子手道：胡师爷的小库房里不知放了些什么玩意。\n",
		"趟子手道：听说好象是些什么贵重药材．．．\n",
        }) );

	set_skill("blade", 40);
	set_skill("parry", 40);
	
	setup();
	carry_object(__DIR__"obj/blade")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 5);
}
