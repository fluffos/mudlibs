// waiter.c

inherit NPC;

void create()
{
	set_name("堂官", ({ "waiter" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"这位堂官正笑咪咪地忙著接待着客人。\n");
	set("combat_exp", 5);
	set("attitude", "friendly");
	set("combat_exp", 200);

	set_skill("unarmed", 20);
	
	setup();
}

void init()
{	
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting()) 
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	switch(random(3)) 
	{
	case 0:
		say("堂官笑咪咪地说道：这位" + RANK_D->query_respect(ob)
			+ "找对门了，那快活林的菜可是没法入口。\n");
		break;
	case 1:
		say("堂官神秘地说道：那快活林可是家黑店，" 
			+ RANK_D->query_respect(ob)
			+ "可千万甭去。\n");
		break;
	case 2:
		say("堂官说道：" + RANK_D->query_respect(ob)
			+ "来尝尝本店的宴席吧，那快活林做不出"
			+ "这样地道的菜来。\n");
		break;
	}
}
