// renmo.c

inherit NPC;

void create()
{
	set_name("千面人魔", ({ "renmo" }) );
	set("gender", "男性" );
	set("long",
		"一张狰狞可怖的面孔。\n");
	set("combat_exp", 100000);
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);
	set("chat_chance", 30);
	set("chat_msg", ({
		(: random_move :)
	}) );

	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("unarmed", 100);

	setup();
	carry_object(__DIR__"obj/mask")->wear();
	carry_object(__DIR__"obj/skin");
	add_money("gold", 5);
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object mask;

	//if(wizardp(ob)) return;

	if((!ob) || (!userp(ob))) return;

	if(ob->query("per") > 20 && random(10) < 5)
	{
		command("grin");
		command("say 要这么个好容貌有什么用？不如让我给你毁了吧！\n");
		kill_ob(ob);
		return;
	} else if(random(10) < 3) {
		kill_ob(ob);
		return;
	}

	if(!(mask = present("mask", this_object())))
		return;

	if(mask->query("equipped"))
		mask->unequip();
	command("mirror " + ob->query("id"));
	mask->wear();
}
