// zheng.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("老郑", ({ "zheng" }));
	set("title", "铁匠");
	set("gender", "男性" );
	set("age", 62);
	set("str", 35);
	set("long",
		"老郑虽然已六十开外，身板却还依然硬朗。\n");
	set("combat_exp", 5);
	set("attitude", "friendly");
	set("vendor_goods", ([
		"折铁刀": __DIR__"obj/blade",
		"青钢剑": __DIR__"obj/sword",
	]) );
	set("combat_exp", 2000);
	set_skill("hammer", 20);
	
	setup();

        carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/ironhammer")->wield();
        add_money("silver", 2);
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	switch(random(3)) 
	{
	case 0:
		say("老郑客气地说道：这位" + RANK_D->query_respect(ob)
			+ "，要挑件称手的兵刃吗？\n");
		break;
	case 1:
		say("老郑笑盈盈地说道：这位" + RANK_D->query_respect(ob)
			+ "咱这刀枪剑戟样样俱全，挑件合适的吧。\n");
		break;
	case 2:
		say("老郑不无自豪地道：咱新进打了把青钢剑，那可是吹毫"
			+ "的利刃啊，" + RANK_D->query_respect(ob)
			+ "要不要试试？\n");
		break;
	}
}
