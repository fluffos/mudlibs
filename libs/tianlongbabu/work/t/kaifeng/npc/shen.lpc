// shen.c 

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("沈长发", ({ "shen" }));
	set("title", "杂货铺老板");
	set("age", 45);
	set("long",
		"沈长发在开封城土生土长，做了几十年的小生意。\n");
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_temp("apply/damage", 15);
	set("combat_exp", 40000);
	set("attitude", "friendly");
	set("vendor_goods", ([
		"麻绳": __DIR__"obj/rope",
		"布袋": "/obj/example/bag",
	]));
	
	setup();
}
void init()
{
	::init();
        add_action("do_vendor_list", "list");
}
