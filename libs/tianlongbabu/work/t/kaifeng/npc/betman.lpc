#include <ansi.h>

inherit NPC;

string addoil(object ob);
void final();
void pay_him(object who, int amount);

void create()
{
	set_name("包之尊", ({ "bao" }));
	set("long", "包之尊天丰赌坊的挡手，一对骰子使得神出鬼莫。\n");
        set("attitude", "friendly");
	set("nickname", HIW "至尊宝" NOR);
        set("max_force", 800);
        set("force", 800);
	set("force_factor", 50);
        set("age", 33);
        set("gender", "男性" );
        set("str", 35);
        set("cor", 30);

        set("too_late", 0);
	set("werfen", 0);
	set("combat_exp", 10000000);

	set_temp("apply/damage", 600);

        set_skill("unarmed", 200);
        set_skill("dodge", 200);

        setup();

        carry_object("/obj/cloth")->wear();
	add_money("gold", 2);
}

void init()
{
        object ob;

        ::init();
        if(interactive(ob = this_player()) && !is_fighting())  
	{
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        //add_action("do_bet", "bet");
	//add_action("do_sa", "sa");
}

void greeting(object ob)
{
        if(!ob || environment(ob) != environment()) return;
        switch(random(3)) 
	{
	case 0:
		say("包之尊笑咪咪地道：这位" + RANK_D->query_respect(ob)
				+ "，来玩两手，开开心吧。\n");
		break;
	case 1:
		say("包之尊晃动着手中的骰子，叫道：这位"
			+ RANK_D->query_respect(ob)
			+ "，小赌怡兴，大赌过瘾，来玩两手吧！\n");
		break;
	case 2:
		say("包之尊微笑道：这位" + RANK_D->query_respect(ob)
				+ "，看了这半天，下场来玩玩吧。\n");
		break;
        }

        return;
}
 
