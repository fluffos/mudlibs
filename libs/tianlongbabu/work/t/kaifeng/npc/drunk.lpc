inherit NPC;
 
void do_drink();
 
void create()
{
        seteuid(getuid());
        set_name("醉汉", ({"drunk", "man", "drunk man"}));
        set("long", @TEXT
 
TEXT
        );
        set("gender","男性");
        set("age",37);
        set("con",30);
        set("str",30);
        set("combat_exp",100);
        set("attitude","heroism");
        set("chat_chance",10);
/*
        set("chat_msg", ({
        (: do_drink :), }) );
*/
        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/example/wineskin");
}
 
void do_drink()
{
	object *list;

	if ((int)this_object()->query("water") >= 380) return;

	list = filter( all_inventory(this_object()), 
		(: ($1->query("liquid/type") == "alcohol") :) );
	if (sizeof(list)) {
        	this_object()->do_command("drink "+(string)list[0]->query("id"));
		if ((int)list[0]->query("liquid/remaining") == 0)
		this_object()->do_command("drop wineskin");
	}
	else {
		this_object()->do_command("sigh");
		this_object()->do_command("say 酒..... 给我酒....");
	}
	return;
}
 
int accept_object(object who, object ob)
{
    if ((string)ob->query("liquid/type")=="alcohol") {
        if ((int)ob->query("liquid/remaining") == 0) {
            this_object()->do_command("shake");
            this_object()->do_command("say 空的我不要...");
            return 0;
        }
        else {
            this_object()->do_command("smile");
            this_object()->do_command("say 多谢!");
            return 1;
        }
    }
    else return 0;
}
 
