// yu.c

inherit NPC;

void create()
{
	set_name("温玉儿", ({ "yu" }) );
	set("title", "名妓");
	set("gender", "女性" );
	set("age", 16);
	set("per", 30);
	set("long", @LONG
温玉儿虽刚年方二八，却已出落的冰雪聪明，招得四方游蜂浪
拥而至，大有取代李瓶儿在香君楼的地位。可温玉儿情有独中，
已与一位相好的公子私订终身，置鸨母的恐吓和客人的金钱于
不顾，苦守心上人前来相会赎身。
LONG
);
	set("attitude", "friendly");

        set("chat_chance_combat", 25);
        set("chat_msg_combat", ({
		"温玉儿秀眉微蹙道：喂！我哪里得罪您了？干嘛这样跟我拼死拼活？\n",
	}) );

	setup();
	
	carry_object(__DIR__"obj/green-cloth")->wear();
	carry_object(__DIR__"obj/green-wrist")->wear();
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting()) 
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object letter;

        if(!ob || environment(ob) != environment()) return;
	if(present("gao", environment(this_object()))) return;
	if(ob->query_temp("marks/高衙内"))
	{
		command("say 对不起" + RANK_D->query_respect(ob)
			+ "，我刚被吓晕了，忘了谢" + RANK_D->query_respect(ob)
			+ "替我摆脱那恶\n贼的纠缠。我这里也无以为谢，"
			+ "请" + RANK_D->query_respect(ob)
			+ "将这封信亲手交给金刀镖局的王二\n公子，"
			+ "他一定会重谢" + RANK_D->query_respect(ob)
			+ "的。\n");
		message_vision("说完$N从袖中拿出一封信交在$n手中。\n", this_object(), ob);
		letter = new(__DIR__"obj/letter");
		letter->set("long", "兴蒙" +  RANK_D->query_respect(ob)
			+ ob->name(1) + "援手，摆脱恶贼高衙内纠缠，"
			+ "望公子能代妹答谢\n并见信后速来与妹相会！\n\n"
			+ "	                     玉儿亲笔\n");
		letter->move(ob);
		ob->delete_temp("marks/高衙内");
		ob->set_temp("marks/温玉儿", 1);
	}
}
int accept_fight(object me)
{
	command("say 小女子哪里是您的对手？");
	return 0;
}

