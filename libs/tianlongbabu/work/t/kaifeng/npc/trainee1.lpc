// trainee.c

inherit NPC;

void create()
{
	set_name("武馆弟子", ({ "trainee" }) );
	set("gender", "男性" );
	set("age", 19);
	set("long", "一位身材高大的汉子，正在辛苦地操练著。\n");
	set("combat_exp", 100);
	set_skill("unarmed", 10);
	setup();
	carry_object("/obj/cloth")->wear();
}
