// popi.c

inherit NPC;

string *name = ({
	"张三",
	"李四",
	"王二麻子",
});

void create()
{
	set_name(name[random(sizeof(name))], ({ "popi" }) );
	set("title", "泼皮");
	set("gender", "男性" );
	set("age", 30);
	set("str", 30);
	set("long",
		"这是个本地有名的泼皮，最好不要惹他。\n" );
	set("combat_exp", 8000);

	set_skill("parry", 60);
	set_skill("unarmed", 60);

	setup();
        carry_object(__DIR__"obj/han-cloth")->wear();
}

int accept_fight(object me)
{
	command("say 嘿！还真有不怕死的．．．\n");
	kill_ob(me);
	return 1;
}
