// wang.c

inherit NPC;
inherit F_MASTER;

void create()
{
          seteuid(getuid());
	set_name("王虚空", ({ "wang" }));
	set("nickname", "一刀在手，人鬼不留");
	set("gender", "男性");
	set("age", 55);
	set("long", 
"王虚空是王元霸的兄弟，但同王元霸的性格完全不同。只见他\n"
"又矮又胖，敞开着衣襟，腰畔挂了口葫芦，背了把沉甸甸的大\n"
"刀，蓬发垢脸，看上去非道非俗。\n"
	);
	set("max_force", 2500);
	set("force", 2500);
	set("force_factor", 20);
	set("combat_exp", 1000000);

	set_skill("literate", 40);
	set_skill("dodge", 80);
	set_skill("unarmed", 100);
	set_skill("blade", 200);
	set_skill("parry", 100);
	set_skill("force", 100);

	set_skill("liuhe-steps", 80);
	set_skill("changquan", 100);
	set_skill("liuhe-blade", 120);
	set_skill("liuhe-force", 100);

	map_skill("dodge", "liuhe-steps");
	map_skill("unarmed", "changquan");	
	map_skill("blade", "liuhe-blade");
	map_skill("parry", "liuhe-blade");
	map_skill("force", "liuhe-force");
	
	setup();
	carry_object(__DIR__"obj/shan-blade")->wield();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/cao-shoes")->wear();
	carry_object(__DIR__"obj/hulu");
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;

	command("hehe");
	message_vision("$N漫声长吟道：一身转战三千里，一剑曾当百万师！\n", this_object());
}

