// he.c

inherit NPC;
inherit F_VENDOR;

void consider();

void create()
{
	set_name("何老头", ({ "he" }));
	set("gender", "男性" );
	set("age", 55);
	set("str", 25);
	set("long",
"没有人知道何老头的来历，只知道他大约一年前来到这儿，开\n"
"了这小面摊。听他的口音好象是南方人。\n");
	set("attitude", "friendly");
	set("consider", 0);
	set("vendor_goods", ([
		"炸酱面": __DIR__"obj/noodle1",
		"打卤面": __DIR__"obj/noodle2",
	]) );
	set("max_force", 1000);
	set("force", 1000);
	set("combat_exp", 1500000);
	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
                (: consider :)
        }) );

	set_skill("sword", 120);
	set_skill("parry", 120);
	set_skill("iron-cloth", 100);
	set_skill("yan-sword", 100);
	set_skill("taibao-gong", 100);
	
	setup();

        carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/chopstick")->wield();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	if(ob->query_temp("marks/何老头") == 2)
	{
		command("whisper " + ob->query("id") + " 谢"
			+ RANK_D->query_respect(ob) 
			+ "帮了我个打忙，不瞒" + RANK_D->query_respect(ob)
			+ "，老头儿我\n乃雁荡派的长老，只因本门掌门招"
			+ "仇家暗害围攻至死，现仇家以灭，但\n本门掌门"
			+ "信物却因此丢失，老头儿到此查探已久，"
			+ "不得消息，不想今儿\n遇见天邪双煞这两魔头，"
			+ "若不是" + RANK_D->query_respect(ob)
			+ "老头儿这下非得露了身份不可，\n" 
			+ RANK_D->query_respect(ob)
			+ "如能帮老头儿找回本门掌门信物，老头儿情愿将"
			+ "这七七四十九手\n回风柳叶剑和这十三太保功传与"
			+ RANK_D->query_respect(ob) + "。\n");
		ob->delete_temp("marks/何老头");
		ob->set("marks/信物", 1);
		return;
	}
	
	if(ob->query("marks/信物"))
	{
		command("whisper " + ob->query("id") + " "
			+ RANK_D->query_respect(ob)
			+ "有了本门掌门信物的消息吗？\n");
		return;
	}

	switch(random(2)) 
	{
	case 0:
		say("何老头客气地说道：这位" + RANK_D->query_respect(ob)
			+ "坐下歇歇，吃碗面吧。\n");
		break;
	case 1:
		say("何老头说道：这位" + RANK_D->query_respect(ob)
			+ "，要碗炸酱面还是打卤面？。\n");
		break;
	}
}

int accept_object(object who, object ob)
{
	if(ob->name() == "雁形信物")
	{
		if(!who->query("marks/信物"))
		{
			command("say 这是什么东西，老头儿不认识，还是"
				+ RANK_D->query_respect(ob)
				+ "留着自己用吧。\n");
			return 0;
		}
		message_vision("$N拿出" + ob->short() + "给$n。\n", who, this_object());
		command(":D");
		command("say 对，就是这玩意。\n");
		command("say 对，就是这玩意。从今天起，老头儿便把这本门密"
			+ "传的功夫传给" + RANK_D->query_respect(ob) + "。\n");
		who->delete("marks/信物");
		who->set("marks/何老头", 1);
		
		return 1;
	}
}

int recognize_apprentice(object ob)
{
	if(ob->query("marks/何老头"))
		return 1;
}

void consider()
{
	if((query("kee") * 100 / query("max_kee")) < 75)
	{
		if(!query("consider"))
		{
			command("say 怎么，要跟老头儿动真的了！\n");
			message_vision("说完，$N身法大变，与适才判若两人。\n", this_object()); 
			//set("force_factor", 100);
			map_skill("sword", "yan-sword");
			map_skill("parry", "yan-sword");
			map_skill("iron-cloth", "taibao-gong");
			reset_action();
			set("consider", 1);
		}
	}
}

