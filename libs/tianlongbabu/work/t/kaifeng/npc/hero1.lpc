// guard.c

inherit NPC;

void create()
{
	set_name("董元超", ({ "yuanchao" }));
	set("title", "桐柏双雄");
	set("nickname", "无坚不摧");
	set("gender", "男性");
	set("age", 35);
	set("str", 30);
	set("long", 
"桐柏双雄是江湖白道上响铛铛的人物，董元超为其老大，使一奇\n"
"门兵器，名唤破甲锥，专破金刚不坏体，铁布衫等外门硬功。\n");
	set("max_force", 800);
	set("force", 800);
	set("force_factor", 40);
	set("combat_exp", 350000);

	set_skill("sword", 60);
	set_skill("parry", 60);
	set_skill("snowshade-sword", 60);

	map_skill("sword", "snowshade-sword");
	map_skill("parry", "snowshade-sword");
        
	setup();
	carry_object(__DIR__"obj/zhui")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 50);
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 20, ob);
        }
}

void greeting(object ob)
{
	object brother;
        if(!ob || environment(ob) != environment()) return;

	if(brother = present("wuba", environment(this_object())))
		message_vision("$N对$n低声道：听说有孔雀山庄的后人在此城"
			+ "中，想那孔雀翎．．．\n", this_object(), brother);
}
