// shen.c 

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("黄之轩", ({ "huang" }));
	set("title", "壮元书局老板");
	set("age", 55);
	set("long",
		"黄之轩年轻时中过秀才，后弃书从商，开了这家书局。\n");
	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set("combat_exp", 4000);
	set("attitude", "friendly");
	set("vendor_goods", ([
		"四书五经": __DIR__"obj/book",
	]));
	
	setup();
	carry_object(__DIR__"obj/white-cloth")->wear();
}
void init()
{
	::init();
        add_action("do_vendor_list", "list");
}
