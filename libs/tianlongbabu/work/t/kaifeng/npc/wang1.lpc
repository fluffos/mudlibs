// guard.c

inherit NPC;

void create()
{
	set_name("王修文", ({ "xiuwen" }));
	set("title", "王大公子");
	set("gender", "男性");
	set("age", 35);
	set("long", 
"王修文是金刀王元霸的长子，虽名修文，却从小于其父练武，\n"
"尽得其父真传，只是功力上还欠些火候。\n");
	set("combat_exp", 50000);
	set("max_force", 500);
	set("force", 500);
	set("force_factor", 30);

	set_skill("blade", 120);
	set_skill("parry", 60);
	set("inquiry", ([
		"王二公子" : "老二不争气，在外面包姑娘，现叫爹给锁起来了！",
	]));
	
	setup();
	carry_object(__DIR__"obj/blade")->wield();
	carry_object("/obj/cloth")->wear();
}
