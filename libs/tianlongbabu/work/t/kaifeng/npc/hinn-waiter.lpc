// waiter.c

inherit NPC;

object create_food(string nmstr, string* idlist);

void create()
{
	set_name("堂官", ({ "waiter" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"这位堂官正笑咪咪地忙著接待着客人。\n");
	set("combat_exp", 5);
	set("attitude", "friendly");
	set("combat_exp", 200);

	set_skill("unarmed", 20);
	
	setup();
}

void init()
{	
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting()) 
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_order", "order");
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	switch(random(3)) 
	{
	case 0:
		say("堂官笑咪咪地说道：这位" + RANK_D->query_respect(ob)
			+ "找对门了，本店厨子曾是御厨，不向狮子楼"
			+ "那些乡下野厨子。\n");
		break;
	case 1:
		say("堂官神秘地说道：那狮子楼可是家黑店，"
			+ RANK_D->query_respect(ob)
			+ "可千万甭去。\n");
		break;
	case 2:
		say("堂官说道：" + RANK_D->query_respect(ob)
			+ "来尝尝本店的菜吧，那狮子楼做不出"
			+ "这样地道的菜来。\n");
		break;
	}
}

int do_order(string arg)
{
	object me;
        if(!arg) return notify_fail("你要点什么菜？\n");

	me = this_player();
	if(arg != "白玉硫璃丸子" && arg != "雪中送炭"
	&& arg != "水晶虾仁" && arg != "东坡肉"
	&& arg != "炝虎尾" && arg != "烩驼峰"
	&& arg != "鱼翅羹" && arg != "燕窝汤")
	{
		command("say 对不起，" + RANK_D->query_respect(me)
			+ "，本店没这菜！\n");
		return 1;
	}

	message_vision("$N边向厨房走边喊道：客人点一份"
			+ arg + "！\n", this_object());
	remove_call_out("coming");
	call_out("coming", 3, arg, me);
	write("OK.\n");

        return 1;
}

void coming(string arg, object ob)
{
	object food;

	if(!ob || environment(ob) != environment()) return;

	food = create_food(arg, ({ "food" }) );
	message_vision("片刻，$N从厨房中出来对$n吆喝道：一份" + arg
			+ "来咯！\n", this_object(), ob);
	ob->add_temp("hinn", 1000);
	food->move(ob);
}

object create_food(string nmstr, string* idlist)
{
        object obj;

        obj = new("/t/kaifeng/obj/food");
        obj->set_name(nmstr, idlist);

        obj->set("long", "一盘热气腾腾, 香气扑鼻的" + nmstr + "\n");
        return obj;
}

int accept_object(object who, object ob)
{
	int price, diff, val, vall;

	price = who->query_temp("hinn");
	if(!price)
	{
		if(ob->value())
		{
			command("smile " + who->query("id"));
			command("say 谢您给小人的赏钱！\n");
			return 1;
		}
	}
	
	if(!(val = ob->value())) return 0;
	diff = price - val;

	if(diff > 0)
	{
		command("shake " + who->query("id"));
		if(diff / 100)
		{
			if(vall = diff % 100)
			{
				command("say 这钱不够！还差" 
					+ chinese_number(diff / 100)
					+ "银子零" + chinese_number(vall) 
					+ "文钱！\n");
			} else 
				command("say 这钱不够！还差" 
					+ chinese_number(diff / 100) 
					+ "银子！\n");
		} else if(vall = diff % 100)
			command("say 这钱不够！还差"
				+ chinese_number(vall) + "文钱！\n");
		who->add_temp("hinn", -val);
		return 1;
	} else if(diff == 0) {
		command("nod");
		command("say 这钱正好，谢谢您光临！\n");
		who->delete_temp("hinn");
		return 1;
	} else if(diff < 0) {
		command(":D");
		command("say 谢您赏小人这么多钱！\n");
		who->delete_temp("hinn");
		return 1;
	}
}
