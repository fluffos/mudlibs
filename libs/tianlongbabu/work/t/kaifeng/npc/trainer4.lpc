// trainer.c

inherit NPC;

void consider();

void create()
{
	set_name("查西城", ({ "trainer" }) );
	set("title", "腾龙武馆杖法教练");
	set("gender", "男性" );
	set("age", 28);
	set("str", 26);
	set("long",
		"查西城长相一般，全无特征，他正在训练他的弟子们习练\n"
		"基本杖法（ｓｔａｆｆ）。\n" );
	set("combat_exp", 3000);
	set("attitude", "heroism");

	set("force", 150);
	set("max_force", 150);
	set("force_factor", 10);
	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
                (: consider :)
        }) );

	set_skill("staff", 30);

	setup();
	carry_object(__DIR__"obj/stock")->wield();
}

int recognize_apprentice(object ob)
{
	if((string)ob->query("family/family_name") == "腾龙武馆") return 1;
	if(ob->query_temp("marks/腾龙武馆")) return 1;
	command("say 对不起，这位" + RANK_D->query_respect(ob)
		+ "，你得先交五两银子。");
	return notify_fail("");
}

int accept_fight(object me)
{
	if((string)me->query("family/family_name") == "腾龙武馆")
	{
		command("nod");
		command("say 进招吧。");
		return 1;
	}
	command("say 馆主吩咐过，不许和来这里的客人过招。");
	return 0;
}

int accept_object(object who, object ob)
{
	if(ob->value() < 500)
	{
		command("shake " + who->query("id"));
		command("say 这些钱不够，一定要五两银子。\n");
		return 0;
	}

	command("nod" + who->query("id"));
	command("say 好！现在就开练吧！\n");
	who->set_temp("marks/腾龙武馆", 1);
	return 1;
}

void consider()
{
	object letter, ob;

	if((query("kee") * 100 / query("max_kee")) < 75)
        {
		if(!query("consider"))
		{
			message_vision("\n$N突然身法大变，与刚才判若两人！\n", this_object());
			set("disapear", 1);
			set("disapear_msg", "$N身行顿起，几个起落便消失了！\n");
			set("consider", 1);
			set("combat_exp", 40000);
			set_skill("dodge", 50);
			set_skill("dragon-steps", 50);
			set_skill("staff", 50);
			set_skill("dragon-staff", 50);
			set_skill("iron-cloth", 50);
			set_skill("jingang", 20);
			map_skill("staff", "dragon-staff");
			map_skill("dodge", "dragon-steps");
			map_skill("iron-cloth", "jingang");
			letter = new(__DIR__"obj/letter2");
			letter->move(this_object());
			reset_action();
			ob = select_opponent();
			kill_ob(ob);
		}
	}
}
