// guard.c

inherit NPC;

void create()
{
	set_name("张乘风", ({ "chengfeng" }));
	set("title", "天邪双煞");
	set("nickname", "追魂夺命");
	set("gender", "男性");
	set("age", 35);
	set("str", 30);
	set("long", 
"江湖上的人对天邪双煞是谈虎色变，当年天邪门横行江湖，杀人\n"
"无数，引得武林各派群起而攻之，水烟阁一战，天邪门被灭，天\n"
"邪双煞当时有事在外，因而幸免。天邪双煞立誓报仇，一有机会\n"
"便痛下杀手，武林中人曾多次围攻，终因双煞事先得报而功败垂\n"
"成。张乘风便是双煞中的老大。\n");
	set("max_force", 800);
	set("force", 800);
	set("force_factor", 40);
	set("combat_exp", 150000);

	set_skill("blade", 60);
	set_skill("parry", 60);
	set_skill("spring-blade", 40);

	map_skill("blade", "spring-blade");
	map_skill("parry", "spring-blade");
        
	setup();
	carry_object(__DIR__"obj/sha-blade")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 50);
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 20, ob);
        }
}

void greeting(object ob)
{
	object brother;
        if(!ob || environment(ob) != environment()) return;

	if(brother = present("chengyun", environment(this_object())))
		message_vision("$N对$n低声道：这老儿有些怪门道，我刚才拿"
			+ "捏着他的腰间，如捏铁石．．．\n", this_object(), brother);
}

int accept_fight(object me)
{
	object brother;

	command("say 哼！要打就真打吧，老子正愁手痒呢！\n");
	kill_ob(me);
	if(brother = present("chengyun", environment(this_object())))
	{
        	command("grin chengyun");
        	brother->kill_ob(me);
	}
        return 1;
}

void die() 
{
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
		killer->add_temp("marks/何老头", 1);

        ::die();
}
