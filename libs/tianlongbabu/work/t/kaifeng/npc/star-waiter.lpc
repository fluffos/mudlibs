// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("伙计", ({ "waiter" }));
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"这位伙计正笑咪咪地忙着接待客人。\n");
	set("combat_exp", 5);
	set("attitude", "friendly");
	set("rank_info/respect", "小二哥");
	set("vendor_goods", ([
		"竹叶青": __DIR__"obj/wineskin",
		"云雾茶": __DIR__"obj/tee",
	]) );
	set("combat_exp", 200);
	set_skill("unarmed", 20);
	
	setup();

        carry_object("/obj/cloth")->wear();
        add_money("silver", 2);
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "伙计客气地说道：这位" + RANK_D->query_respect(ob)
				+ "，今儿是喝茶还是品酒。\n");
			break;
		case 1:
			say( "伙计笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
		case 2:
			say( "伙计说道：这位" + RANK_D->query_respect(ob)
				+ "，本店新进的竹叶青，要不要尝尝。\n");
			break;
	}
}
