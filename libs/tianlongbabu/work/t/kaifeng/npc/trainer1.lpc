// trainer.c

inherit NPC;

void create()
{
	set_name("赵齐贤", ({ "trainer" }) );
	set("title", "腾龙武馆拳法教练");
	set("gender", "男性" );
	set("age", 28);
	set("str", 26);
	set("long",
		"赵齐贤身材不高，却非常结实，他正在训练他的弟子们习练\n"
		"搏击格斗术（ｕｎａｒｍｅｄ）。\n" );
	set("combat_exp", 3000);
	set("attitude", "heroism");

	set("force", 150);
	set("max_force", 150);
	set("force_factor", 10);

	set_skill("unarmed", 30);

	setup();
}

int recognize_apprentice(object ob)
{
	if((string)ob->query("family/family_name") == "腾龙武馆") return 1;
	if(ob->query_temp("marks/腾龙武馆")) return 1;
	command("say 对不起，这位" + RANK_D->query_respect(ob)
		+ "，你得先交五两银子。");
	return notify_fail("");
}

int accept_fight(object me)
{
	if((string)me->query("family/family_name") == "腾龙武馆")
	{
		command("nod");
		command("say 进招吧。");
		return 1;
	}
	command("say 馆主吩咐过，不许和来这里的客人过招。");
	return 0;
}

int accept_object(object who, object ob)
{
	if(ob->value() < 500)
	{
		command("shake " + who->query("id"));
		command("say 这些钱不够，一定要五两银子。\n");
		return 0;
	}

	command("nod" + who->query("id"));
	command("say 好！现在就开练吧！\n");
	who->set_temp("marks/腾龙武馆", 1);
	return 1;
}
