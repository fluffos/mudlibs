// guard.c

inherit NPC;

void create()
{
	set_name("薛毋霸", ({ "wuba" }));
	set("title", "桐柏双雄");
	set("nickname", "显道巨灵");
	set("gender", "男性");
	set("age", 30);
	set("str", 30);
	set("long", 
"桐柏双雄是江湖白道上响铛铛的人物，薛毋霸为其老二，使一奇\n"
"门兵器，名唤雷震镗，专破金刚不坏体，铁布衫等外门硬功。\n");
	set("max_force", 800);
	set("force", 800);
	set("force_factor", 40);
	set("combat_exp", 250000);

	set_skill("staff", 60);
	set_skill("parry", 60);
	set_skill("cloudstaff", 60);

	map_skill("staff", "cloudstaff");
	map_skill("parry", "cloudstaff");
        
	setup();
	carry_object(__DIR__"obj/tang")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 50);
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 24, ob);
        }
}

void greeting(object ob)
{
	object brother;
        if(!ob || environment(ob) != environment()) return;

	if(brother = present("yuanchao", environment(this_object())))
		message_vision("$N对$n低声答道：哦！我倒是得传闻说雁荡派"
			+ "大举出山前来此地，不知何故？\n", this_object(), brother);
}
