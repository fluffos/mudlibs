// garrison.c

inherit NPC;

void create()
{
	set_name("巡捕", ({ "xunbu" }) );
	set("gender", "男性" );
	set("long",
		"开封府的巡捕。\n" );
	set("combat_exp", 60000);
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);
	set("GARRISON", 1);
	set("chat_chance", 15);
	set("chat_msg", ({
		(: random_move :)
	}) );

	set_skill("dodge", 40);
	set_skill("parry", 40);
	set_skill("whip", 80);

	setup();
	carry_object(__DIR__"obj/q-cloth")->wear();
	carry_object(__DIR__"obj/lian")->wield();
}
