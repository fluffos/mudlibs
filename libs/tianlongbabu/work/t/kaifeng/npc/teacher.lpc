// teacher.c

inherit NPC;

void create()
{
	set_name("徐老先生", ({ "teacher" }) );
	set("title", "私塾教习");
	set("gender", "男性" );
	set("age", 65);
	set("int", 26);
	set("long",
		"徐老先生一生苦读，结果也没能考出个名堂来，只落得靠教习些\n"
		"蒙童来混口饭吃，如果你付他一点学费，就可以成为他的弟子学\n"
		"习读书识字。\n");
	set("inquiry", ([
		"学费": "嗯．．．如果你有心的话，给十两银子吧。\n",
	]) );
	set("attitude", "peaceful");
	set_skill("literate", 40);
	setup();
}

int recognize_apprentice(object ob)
{
	if(!ob->query("marks/徐老先生"))
	{
		command("say 咦？我不记得收过你这个学生啊....\n");
		return 0;
	}

	return 1;
}

int accept_object(object who, object ob)
{
	if ( userp(ob) || ob->is_character() ) {
		command("say 你的诚意不够。\n");
		return 0;
	}

	if(!who->query("marks/徐老先生"))
	{
		if(ob->value() >= 500) 
		{
			command("nod " + who->query("id"));
			command("say 好，从今天起你随时可以来问我有关"
				+ "读书识字（ｌｉｔｅｒａｔｅ）"
				+ "的任何问题。\n");
			who->set("marks/徐老先生", 1);
			return 1;
		} else {
			command("say 你的诚意不够，这钱还是拿回去吧。\n");
			return 0;
		}
	} else {
		command("smile");
		command("say 哦，象你这麽有心的学生还真是不多见，好好努力"
			+ "将来必定前途无量。\n");
		return 1;
	}
}
