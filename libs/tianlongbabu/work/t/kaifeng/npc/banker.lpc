// banker.c

inherit NPC;
inherit F_VENDOR;
inherit BANKER;

void create()
{
	set_name("钱老本", ({ "banker" }) );
	set("gender", "男性" );
	set("age", 55);
	set("long",
		"一个五十来岁的朝奉，脸上透着职业的狡猾和精明。\n");
	set("combat_exp", 5);
	set("rank_info/respect", "大掌柜的");

	set("combat_exp", 40000);
	set_skill("unarmed", 80);
	
	setup();

        carry_object("/obj/cloth")->wear();
        add_money("silver", 50);
}

void init()
{	
	if(environment(this_object())->query("short") == "富贵钱庄")
	{
		add_action("do_check", "check");
		add_action("do_convert", "convert");
        	add_action("do_deposit", "deposit");
		add_action("do_load", "load");
	}
}
