// thief.c

inherit NPC;
 
void create()
{
	set_name("燕子李", ({ "thief" }) );
	set("title", "神偷");
        set("gender", "男性" );
        set("age", 35);
        set("str", 28);
        set("long", @LONG
燕子李是江湖上有名的飞贼，经常出没于大户人家，有时甚至
闯如皇宫内院，因为他轻功高强，官府几次捉拿都被他逃脱。
LONG
);
        set("combat_exp", 30000);
        set("attitude", "heroism");
        set("env/wimpy", 80);
 
        set("chat_chance", 60);
        set("chat_msg", ({
		"燕子李说道: 小心我把你变成穷光蛋！\n",
                (: random_move :)
        }) );  

        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
		"燕子李恶狠狠的说道: 快滚！这没你的事！",
		"燕子李喝道: 你要是敢惹我，咱们以后可没完！",
        }) );
 
        set_skill("dodge", 150);
        set_skill("unarmed", 50);
        set_skill("stealing", 150);

        setup();
 
        add_money("gold", 5);
        carry_object(__DIR__"obj/yanzhi")->wear();
}
 
void init()
{
        object ob;

        ::init();
        if(interactive(ob = this_player()) && !is_fighting()) 
	{
		remove_call_out("steal_it");
                call_out("steal_it", 1, ob);
        }
}

void steal_it(object ob)
{
        if(!ob || environment(ob) != environment()) return;
 
	//if(random(10) < 6)
	//{
        	command("heihei");
        	command("steal silver from " + ob->query("id"));
	//}
}

int accept_fight(object me)
{
        command("say 好小子, 居然管起大爷的事来, 看招!");
        command("grin");
        kill_ob(me);
        return 1;
}

