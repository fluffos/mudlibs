// ping.c

inherit NPC;

void create()
{
	set_name("李瓶儿", ({ "ping" }) );
	set("title", "名妓");
	set("gender", "女性" );
	set("age", 18);
	set("per", 30);
	set("long", @LONG
李瓶儿是香君楼的才女，琴棋书画，样样俱全，最投汴梁城中
风流才子之所好。可俗话说的好：鸨儿爱钞，姐儿爱俏。这李
瓶儿便是这么个脾气，最喜欢年轻的俏公子哥们，那怕分文皆
无，也不碍事，而那些年老或丑陋的客人，即使给再多银子，
也一概不接。鸨儿对李瓶儿最是头痛，却也没有法子。
LONG
);
	set("attitude", "friendly");
        set("chat_chance_combat", 25);
        set("chat_msg_combat", ({
		"李瓶儿秀眉微蹙道：我哪里得罪您了？干嘛这样跟我拼死拼活？\n",
	}) );

	setup();
	
	carry_object(__DIR__"obj/white-cloth")->wear();
}

int accept_object(object who, object ob)
{
	object dagger;

	if(who->query("per") < 20)
	{
		command("say 你这样的人，送我再贵重的东西，我也不要！\n");
		return 0;
	}

	if(who->query("gender") == "女性")
	{
		command("sigh " + who->query("id"));
		command("say 你还是留着自己用吧！\n");
		return 0;
	}

	if(ob->name(1) == "胭脂")
	{
		command("say 这种庸脂俗粉我可不会用！\n");
		return 0;
	}

	if(ob->name(1) == "御制胭脂")
	{
		command("smile");
		command("say 宝剑赠壮士，红粉送佳人。即然" 
			+ RANK_D->query_respect(ob)
			+ "送小女子这么贵重\n的胭脂，小女子因回赠"
			+ RANK_D->query_respect(ob)
			+ "一柄宝剑才是！\n");
		dagger = new(__DIR__"obj/dagger");
		dagger->move(who);
		message_vision("说完从怀里掏出把$N交给$n。\n", dagger, who);
        	return 1;
	}
}

int accept_fight(object me)
{
	command("say 小女子哪里是你的对手？");
	return 0;
}
