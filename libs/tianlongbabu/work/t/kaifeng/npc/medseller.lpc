// medseller.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("江湖郎中", ({ "medcine seller", "seller" }) );
	set("age", 42);
	set("long", @LONG
一个走街串巷的江湖郎中。
LONG
);
	set("combat_exp", 1000);
	set("chat_chance", 15);
	set("chat_msg", ({
		"江湖郎中吆喝道：祖传密方大力丸，吃下去强身健体，百病不侵...\n",
		(: random_move :)
	}) );

	set("vendor_goods", ([
		"大力丸": __DIR__"obj/dali-wan",
	]) );

	set("inquiry", ([
		"祖传密方": "咱这祖传密方专治花柳，一两金子一包！",
	]));

	set_skill("hammer", 50);

	setup();
	
	carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/hucheng")->wield();
	add_money("silver", 10);
}

void init()
{       
        object ob;

        ::init();
        if(interactive(ob = this_player()) && !is_fighting()) 
	{
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if(!ob || environment(ob) != environment()) return;
	if(ob->query_condition("flower_poison"))
	{
		message_vision("江湖郎中看了看四下，悄声对$N道：我瞧"
				+ RANK_D->query_respect(ob)
				+ "是得了花柳病了...\n", ob);
		message_vision("江湖郎中续而又$N道：咱这有祖传密方专治花柳，"
				+ "一两金子一包，包你药到病除！\n", ob);
	}
}

int accept_object(object who, object ob)
{
	object mifang;

	if(ob->value() < 10000)
	{
		command("say 这点儿钱还不够我配方用呢！");
		return 0;
	}
	
	mifang = new(__DIR__"obj/mifang");
	command("nod " + who->query("id"));
	command("say 算你有运气，找对了人了！");
	message_vision("说完从怀中掏出包药塞在$N手中。\n", who);
	mifang->move(who);
	return 1;
}
