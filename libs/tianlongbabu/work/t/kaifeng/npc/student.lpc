// student.c

inherit NPC;

void create()
{
	set_name("举子", ({ "student" }) );
	set("gender", "男性" );
	set("age", 25);
	set("long",
		"这是个来京城赶考的举子。\n" );
	set("combat_exp", 800);

	setup();
        carry_object(__DIR__"obj/han-cloth")->wear();
}
