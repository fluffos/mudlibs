// garrison.c

inherit NPC;

void create()
{
	set_name("禁军", ({ "garrison" }) );
	set("gender", "男性" );
	set("long",
		"一名护卫京城的禁军军卒。\n" );
	set("combat_exp", 40000);
	set("force", 400);
	set("max_force", 400);
	set("force_factor", 20);

	set_skill("dodge", 40);
	set_skill("parry", 40);
	set_skill("hammer", 40);

	setup();
        carry_object(__DIR__"obj/jia")->wear();
	carry_object(__DIR__"obj/hammer")->wield();
}
