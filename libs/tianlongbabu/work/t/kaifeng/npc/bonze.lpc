// bonze.c

inherit NPC;

void create()
{
	set_name("知客僧", ({ "bonze" }) );
	set("gender", "男性" );
	set("age", 35);
	set("str", 26);
	set("long",
		"这是一个大相国寺的知客僧人。\n" );
	set("combat_exp", 20000);

	set("force", 400);
	set("max_force", 400);
	set("force_factor", 20);

	set_skill("unarmed", 50);
	set_skill("dodge", 20);

	setup();
        carry_object(__DIR__"obj/sen-cloth")->wear();
	carry_object(__DIR__"obj/sen-shoes")->wear();
}
