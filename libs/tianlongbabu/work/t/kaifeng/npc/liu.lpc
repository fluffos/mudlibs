// seller.c

inherit NPC;
inherit F_VENDOR;
inherit HOCKOWNER;

void create()
{
	set_name("刘进财", ({ "liu" }) );
	set("title", "朝奉");
	set("gender", "男性" );
	set("age", 50);
	set("long",
		"一个五十来岁的朝奉，脸上透着职业的狡猾和精明。\n");
	set("combat_exp", 5);
	set("rank_info/respect", "大朝奉");
	set("vendor_goods", ([
		//"布衣": "/obj/cloth",
	]));
	set("combat_exp", 10000);
	set_skill("unarmed", 60);
	
	setup();

        carry_object("/obj/cloth")->wear();
        add_money("silver", 30);
}

void init()
{
        add_action("do_vendor_list", "list");
        add_action("do_pawn", "pawn");
        add_action("do_redeem","redeem");
        add_action("do_value", "value");
        add_action("do_sell", "sell");
	add_action("do_shu","shu");
}

