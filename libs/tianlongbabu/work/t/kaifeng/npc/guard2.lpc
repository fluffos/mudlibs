// guard.c

inherit NPC;

string open_door();

void create()
{
	set_name("镖师", ({ "guard" }));
	set("gender", "男性");
	set("age", 35);
	set("long", "一名身材魁武的镖师。\n");
	set("combat_exp", 1000);
	set("inquiry", ([
		"开门": (: open_door :),
        ]) );

	set_skill("sword", 60);
	set_skill("parry", 50);
	
	setup();
	carry_object(__DIR__"obj/sword")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 10);
}

void init()
{       
        object ob;

        ::init();
        if(interactive(ob = this_player()) && !is_fighting()) 
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object here, env;

	here = environment();
        if(!ob || environment(ob) != here) return;
	if(here->query("short") != "小库房") return;

	command("say 要开门的话，跟我打个招呼！\n");
	env = ob->query_temp("zhangfang");
	ob->delete_temp("zhangfang");

	if(here->query("exits/east"))
		here->delete("exits/east");
	if(env && env->query("exits/west"))
	{
		message_vision("说完，$N将门随手关上！\n", this_object());
		tell_room(env, "小门被「吱呀」一声关上了！\n");
		env->delete("exits/west");
	}
}

string open_door()
{
	object env;

	env = environment();
	if(env->query("short") != "小库房")
		return "咦！这是啥地方？\n";

	if(env->query("exits/east"))
		return "小门不是开着的吗！\n";

	command("nod " + this_player()->query("id"));
	message_vision("$N伸手将小门打开！\n", this_object());
	env = environment();
	env->set("exits/east", "/t/kaifeng/zhangfang");
	return "你一出去我就把小门给关上！\n";
}
