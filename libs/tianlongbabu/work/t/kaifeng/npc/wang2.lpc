// guard.c

inherit NPC;

void create()
{
	set_name("王修武", ({ "xiuwu" }));
	set("title", "王二公子");
	set("gender", "男性");
	set("age", 25);
	set("long", 
"金刀王元霸从小就宝贝这小儿子修武，可这王二公子虽名修武，\n"
"却一点儿也不想练武，只爱在花柳巷中闲逛，前些时候看上了\n"
"香君楼的温玉儿，情投意合，一心想将温玉儿娶回家来，王元\n"
"霸知道后震怒无比，一气之下，将王修武锁入这密室。\n");
	set("combat_exp", 5000);
	set("given", 0);

	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set("inquiry", ([
		"温玉儿" : "玉儿，玉儿在哪？！\n",
	]));
	
	setup();
	carry_object("/obj/cloth")->wear();
}

int accept_object(object who, object ob)
{
	int amount;
	object money;

	if(ob->name() == "温玉儿的手书")
	{
		if(!who->query_temp("marks/温玉儿"))
		{
			command("angry " + who->query("id"));
			command("say 这不是玉儿的手书，定是爹派你来骗我的！\n");
			return 0;
		}
		command("smile " + who->query("id"));
		if(query("given"))
		{
			command("say 我在这种状况下，也没什么特别的可"
				+ "以谢" + RANK_D->query_respect(ob)
				+ "，幸而身\n边还有些金子，望"
				+ RANK_D->query_respect(ob) + "笑纳！\n");
			amount = random(6);
			if(amount < 1) amount = 1;
			money = new("/obj/money/gold");
			money->set_amount(amount);
			message_vision("说完，$N从袖中掏出" 
					+ chinese_number(amount)
					+ "两金子交给$n。\n", this_object(), who);
			money->move(who);
		} else {
			command("say 我在这种状况下，也没什么特别的可"
				+ "以谢" + RANK_D->query_respect(ob)
				+ "，这有一\n物件，是无意间一位武林前辈"
				+ "临终时留下，这前辈说这东西会对我的"
				+ "在\n武林中有很大帮助，可我并不想在江"
				+ "湖上有什么发展，不如送与"
				+ RANK_D->query_respect(ob) + "！\n");
			money = new(__DIR__"obj/seal");
			message_vision("说完，$N从袖中掏出一样东西交给$n。\n", this_object(), who);
			money->move(who);
			set("given", 1);
		}
		who->delete_temp("marks/温玉儿");
		environment(this_object())->set("no_clean_up", 1);
		remove_call_out("dest_me");
                call_out("dest_me", 2);
		return 1;
	}
}

int dest_me()
{
	message_vision("$N起身匆忙离去．．．．\n", this_object());
	destruct(this_object());
	return 1;
}
