// hu.c

inherit NPC;

void consider();
string open_door();

void create()
{
	set_name("胡师爷", ({ "hu" }));
	set("title", "帐房先生");
	set("gender", "男性");
	set("age", 55);
	set("long", 
"金刀镖局里除了金刀王元霸无人知道胡师爷的底细，而王元霸\n"
"是信任无疑，镖局中的大小事都交与胡师爷经手。这胡师爷生\n"
"得瘦小猥缩，獐头鼠脑，成天价手里提着个算盘，腰里挂着串\n"
"钥匙幽灵般地在镖局里转来转去。\n");
	set("attitude", "friendly");
	set("consider", 0);
	set("force", 800);
        set("max_force", 800);
	set("combat_exp", 500000);
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: consider :)
        }) );
	set("inquiry", ([
                "开门": (: open_door :),
        ]) );

	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_skill("throwing", 120);
	set_skill("tianying-steps", 60);

	map_skill("dodge", "tianying-steps");
	
	setup();

	carry_object(__DIR__"obj/rechner")->wield();
	carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/key");

	add_money("silver", 50);
}

string open_door()
{
	int exp;
	object here, me = this_player();
	
	if(me->query("class") != "guard")
		return "一边去，这里没什么好玩的！\n";

	exp = me->query("combat_exp");
	if(exp < 100000)
		return "只有大镖头以上的人才能进小库房！\n";

	here = environment();
	if(here->query("short") != "帐房")
		return "咦！这是啥地方？\n";
	if(here->query("exits/west"))
		return "小门不是开着的吗！\n";

	message_vision("$N在小门上敲了几下，小门「吱呀」一声开了！\n", this_object());
	me->set_temp("zhangfang", here);
	here->set("exits/west", "/t/kaifeng/zhangfang2");
	
	return "要进就快点进去吧！\n";
}

void consider()
{
	object weapon, zhu;

	if((query("kee") * 100 / query("max_kee")) < 75)
	{
		if(!query("consider"))
		{
			message_vision("$N的脸上忽然闪过一道青气。\n", this_object());
			set("force_factor", 50);
			set("consider", 1);
		}

		//if(weapon = query_temp("weapon") && weapon->name() == "算盘")
		if(weapon = query_temp("weapon"))
		{
			if(weapon->name() == "算盘")
			{
				message_vision("\n$N一掌击碎了手中的算盘，一扬大袖，"
					+ "将飞散的算盘珠尽收掌内。\n", this_object());
				destruct(weapon);
				zhu = new(__DIR__"obj/zhu");
				zhu->set_amount(100);
				zhu->move(this_object());
				zhu->wield();
			}
		}
		command("exert recover 40");
	}
	return;
}

