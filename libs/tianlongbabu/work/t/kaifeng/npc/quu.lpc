// wang.c

inherit NPC;

void create()
{
	set_name("屈成招", ({ "qu" }));
	set("title", "开封知府");
	set("gender", "男性");
	set("age", 45);
	set("long", 
"屈成招三十岁时中的进士，此后一直外放在外，直到前年才被\n"
"调任开封知府。屈成招为官还算清廉，但俗话说：三年清知府，\n"
"十万雪花银，所以屈成招也不会例外。\n"
	);
	set("max_force", 1000);
	set("force", 1000);
	set("force_factor", 50);
	set("combat_exp", 500000);

	set_skill("blade", 250);
	set_skill("parry", 50);
	
	setup();
	carry_object(__DIR__"obj/hero-cloth")->wear();
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_accuse", "accuse");
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	if(ob->query("PK_MURDER"))
	{
		message_vision("$N对$n怒目喝道：大胆" + ob->name(1)
			+ "，竟敢在光天化日之下杀人越货，\n难道不怕"
			+ "大宋的王法吗！\n", this_object(), ob);
		command("tell " + ob->query("id") + " 不过吗，"
			+ "本府最近手头有点儿紧．．．\n");
		return;
	}
	message_vision("$N对$n和言乐色地道：" + RANK_D->query_respect(ob)
			+ "有苦有冤尽管往外掏，本府为民做主！\n", 
			this_object(), ob);
}

int do_accuse(string arg)
{
	object ob, *guard, guard1, guard2, guard3, me;
	int i;
//	string name;

	if(!arg) return 0;

	me = this_player();
	message_vision("$N向$n状告有人杀人越货！\n", me, this_object());

	if(!(guard1 = present("sima", environment())))
	{
		command("shake " + me->query("id"));
		command("say 司马都头暂时不在，等他回来再说吧。\n");
		return 1;
	}

	if(!ob= find_player(arg))
	{
		command("sigh " + me->query("id"));
		command("say 此人暂时不在，无以对证，等他来了再说吧。\n");
		return 1;
	}

	if(!ob->query("PK_MURDER") && !me->query("marks/屈成招"))
	{
		command("say 大胆！竟敢诬陷好人，不过吗，本府最近手头"
			+ "有点儿紧．．．\n");
		command("grin " + me->query("id"));
		return 1;
	}

	me->delete("marks/屈成招");
	command("say 来人啦！限期捉拿要犯" + ob->name() + "，格杀务论！\n");
	if(ob->query("combat_exp") > 100000)
		guard1->set("combat_exp", ob->query("combat_exp"));
	guard2 = new(__DIR__"xunbu");
	guard3 = new(__DIR__"xunbu");
	message_vision("司马长风领着几个捕快如狼似虎般的冲了出去\n", 
			this_object());	

	tell_room(environment(ob), "司马长风领着几个捕快突然出显，"
		+ "喝道：捉拿要犯" + ob->name()
		+ "，闲杂人等一概回避！\n");
	guard = ({guard1, guard2, guard3});
	for(i=0;i<3;i++)
	{
		guard[i]->move(environment(ob));
		guard[i]->set_leader(ob);
		guard[i]->kill_ob(ob);
	}
	
	return 1;
}
		
int accept_object(object who, object ob)
{
	string msg;

	msg = "$N脸色一变，喝道：大胆" + who->name(1) + "，敢是想"
		+ "戏弄本府不成？\n";

        if(who->query("PK_MURDER"))
	{
		if(ob->value() < 1000000)
		{
			message_vision(msg, this_object());
			return 0;
		}
		command(":D");
		command("say 好！这没你什么事了，你可以去了！\n");
		who->delete("PK_MURDER");
		if(who->is_fighting()) 
			who->remove_all_killer();
		return 1;
	}

	if(ob->value() < 500000)
	{
		message_vision(msg, this_object());
		return 0;
	}

	command("nod " + who->query("id"));
	command("say 好！你要状告什么人？本府定为你坐主！\n");
	who->set("marks/屈成招", 1);
	return 1;
}
