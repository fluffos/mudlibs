// niu.c

inherit NPC;

void create()
{
	set_name("牛二", ({ "niu er", "niu" }) );
	set("title", "闲汉");
	set("gender", "男性" );
	set("age", 35);
	set("str", 30);
	set("long",
		"牛二是这一带有名的泼皮闲汉，仗有把牛劲，到处若事生非。\n" );
	set("combat_exp", 8000);

	set_skill("dodge", 20);
	set_skill("parry", 60);
	set_skill("unarmed", 60);

	setup();
        carry_object(__DIR__"obj/han-cloth")->wear();
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object weapon;

	if(!ob || environment(ob) != environment()) return;

	command("look " + ob->query("id"));
	if(weapon = ob->query_temp("weapon"))
	{
		message_vision("牛二斜眼对$N喝道：呔，看你手里拿着个"
			+ weapon->name() + "想来也会两下花拳\n"
			+ "秀腿，敢来跟大爷比化比化吗？\n", ob);
		ob->set_temp("marks/牛二", 1);
		this_object()->set_temp("wp", weapon->name());
	}
}

int accept_object(object who, object ob)
{
	if(ob->name() == (string)this_object()->query_temp("wp"))
	{
		command("nod " + who->query("id"));
		command("say 看你也还识相，大爷今天饶你一次！\n");
		who->delete_temp("marks/牛二");
		return 1;
	}
	message_vision("牛二翻眼对$N道：呔，这是什么鸟东西，敢来糊弄大爷！\n", who);
	return 0;
}

