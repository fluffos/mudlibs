// lian.c
// last update by cbra Jun-01-1998 for some fix

inherit NPC;

void create()
{
	set_name("金莲儿", ({ "lian" }) );
	set("title", "名妓");
	set("gender", "女性" );
	set("age", 22);
	set("per", 30);
	set("long", @LONG
金莲儿是香君楼里最红的姑娘，到了香君楼没逛「香莲居」等
于白来，香君楼的客人中不分老少俊丑，不知多少都拜倒在金
莲儿的石榴裙下，此时金莲儿整媚眼如丝地坐在床边邀你过来
同她（ｅｎｊｏｙ）呢！
LONG
);
	set("attitude", "friendly");

        set("chat_chance_combat", 25);
        set("chat_msg_combat", ({
		"金莲儿秀眉微蹙道：喂！我哪里得罪您了？干嘛这样跟我拼死拼活？\n",
	}) );

	setup();
	
	carry_object(__DIR__"obj/red-cloth")->wear();
	carry_object(__DIR__"obj/red-shoes")->wear();
}

void init()
{       
        object ob;

        ::init();
        if(interactive(ob = this_player()) && !is_fighting()) 
	{
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
	add_action("do_enjoy", "enjoy");
}

void greeting(object ob)
{
        if(!ob || environment(ob) != environment()) return;
        switch( random(3) ) 
	{
	case 0:
		say("金莲儿假装生气道：死人，这么长时间也不来看我，"
			+ "想必又是泡上别的姑娘了！\n");
		break;
	case 1:
		message_vision("金莲儿娇声对$N"
			+ "道：你这冤家，可想杀奴家了！\n", ob);
		break;
	case 2:
		message_vision("金莲儿娇声对$N"
			+ "道：这位" + RANK_D->query_respect(ob)
			+ "即然来了，就不要害羞吗！\n", ob);
		break;
	}
}

int accept_fight(object me)
{
	command("say 小女子哪里是您的对手？");
	return 0;
}

int do_enjoy(string arg)
{
	object me;
	
	if(!arg && arg != "金莲儿" && arg != "lian")
		return notify_fail("你要同谁（ｅｎｊｏｙ）？\n");
	
	me = this_player();

        if (me->query("gender") != "男性" )        
                return notify_fail("看清楚些，她可是你的同性耶！\n");
        
	if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

	me->start_busy(6);
	message_vision("$N只觉得血脉愤涨，便不顾一切地于金莲儿胡天海地"
			+ "起来！\n", me);
	remove_call_out("coming");
	call_out("finish_enjoy", 5, me);
	return 1;
}

void finish_enjoy(object ob)
{
	object hebao;

	if(present(ob, environment()))
	{
		tell_object(ob, "终于一切都又恢复了平静...\n");
		hebao = new(__DIR__"obj/hebao");
		if ( (!present("hebao",ob)) && (!present("hebao",environment())) ) {
			message_vision("金莲儿从腰间解下一个鸳鸯荷包，娇喘道："
				+ "这个送给你，下次可别忘了奴家哦！\n", ob);
			hebao->move(ob);
		}
		if(random(10) < 6)
			ob->apply_condition("flower_poison", 10);
	}
}

void die()
{
	object hebao;
	hebao = new(__DIR__"obj/hebao");
	hebao->move(this_object());
	::die();
}
