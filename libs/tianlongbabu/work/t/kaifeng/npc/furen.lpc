// furen.c

inherit NPC;

void create()
{
	set_name("王夫人", ({ "wang furen", "wang" }));
	set("gender", "女性");
	set("age", 55);
	set("long", 
"王夫人比王元霸小整整十岁，是个看上去很富泰的女人。\n"
	);
	set("inquiry", ([
		"修武" : "修武叫那老畜生关到...关到...唉！",
	]));

	
	setup();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 5);
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	command("cry");
	message_vision("$N自言自语道：这老不死的怎么这么忍心！将修武这孩子"
			+ "．．．！\n", this_object());
}
