// jiading.c

inherit NPC;

void create()
{
	set_name("高衙内", ({ "gao" }) );
	set("gender", "男性" );
	set("age", 20);
	set("long",
		"高衙内在汴梁城势力熏天，一惯欺良霸善，可没人敢言。\n" );
	set("combat_exp", 1000);

	set_skill("dodge", 40);
	set_skill("unarmed", 50);

	setup();
        carry_object(__DIR__"obj/hua-cloth")->wear();
}

void init()
{
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	if(environment()->query("short") != "如玉阁") return;

	command("look " + ob->query("id"));
	message_vision("高衙内对着$N怪眼一翻道：你是什么东西，"
			+ "敢来打绕本衙内的雅\n兴，不知本衙内的名头吗！"
			+ "识相得话给我快滚，不然，哼哼．．．\n", ob);
	if(ob->query_cor() < 25)
	{
		tell_object(ob, "你障着高衙内名头，想想还是甭争这口气算了，"
			+ "便低头向门外走去。\n\n");
		message("vision", "只见" + ob->name() + "灰头土面地"
			+ "往外走去。\n", environment(ob), ob);
		ob->move("/t/kaifeng/jiyuan2");
		message("vision", "只见" + ob->name() + "灰溜溜地"
			+ "从「如玉阁」走了出来。\n", environment(ob), ob);
	} else
		message_vision("$N对$n冷笑道：你算哪门的衙内，咱怕你个球！\n", ob, this_object());
}

void die() {
        object killer;

        if(objectp(killer = query_temp("last_damage_from")))
                killer->set_temp("marks/高衙内", 1);

        ::die();
}
