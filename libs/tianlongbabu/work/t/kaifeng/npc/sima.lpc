// sima.c

inherit NPC;

void create()
{
	set_name("司马长风", ({ "sima" }) );
	set("gender", "男性" );
	set("age", 30);
	set("title", "开封府巡捕都头");
	set("long",
"司马长风是屈成招外放时寻得的壮士，一直忠心追随屈成招。\n"
"屈成招也对他特别器重，来开封后便封司马长风为开封城的\n"
"巡捕都头。\n" );
	set("combat_exp", 100000);
	set("force", 800);
	set("max_force", 800);
	set("force_factor", 40);
	set("GARRISON", 1);

	set_skill("blade", 80);
	set_skill("dodge", 40);
	set_skill("parry", 40);

	set_skill("tianying-steps", 20);
	set_skill("wind-blade", 60);

	map_skill("dodge", "tianying-steps");
	map_skill("parry", "wind-blade");
	map_skill("blade", "wind-blade");

	setup();
        carry_object(__DIR__"obj/q-cloth")->wear();
	carry_object(__DIR__"obj/blade")->wield();
}
