// hucheng.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("虎撑", ({ "hucheng" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "只");
		set("long", "一只江湖郎中随身携带的虎撑。\n");
                set("value", 200);
                set("material", "iron");
		set("wield_msg", "$N拿出一只$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(15);
        setup();
}
