// tiejia.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("铁枷", ({ "tiejia" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "具");
		set("long", "一具沉重的铁枷。\n");
                set("value", 400);
                set("material", "iron");
		set("wield_msg", "$N拿出一具铁枷握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(20);
        setup();
}
