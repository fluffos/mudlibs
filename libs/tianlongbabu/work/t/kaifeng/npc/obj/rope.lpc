// letter.c
inherit ITEM;

void create()
{
	set_name("麻绳", ({ "rope"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "根");
		set("long", "一根麻绳。\n");
                set("value", 80);
		set("climbable", 1);
        }
}
