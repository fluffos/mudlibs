// mifang.c
// last_update 4.2.1997 windf

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name( "江湖郎中的密方", ({ "mifang", "江湖郎中的密方"}) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "包");
		set("value", 0);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();

        if(!arg || arg != "mifang") return notify_fail("你要吃什麽？\n");

	message_vision("$N瞧瞧四下无人注意，拿起江湖郎中的密方一气吃了下去。\n",			me);
	if(me->query_condition("flower_poison"))
	{
		tell_object(me, "你的花柳病被治好了！！！\n");
		me->clear_condition("flower_poison");
	}
	destruct(this_object());
	return 1;
}
