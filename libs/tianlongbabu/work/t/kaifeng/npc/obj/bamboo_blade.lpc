// bamboo_blade.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("竹刀", ({ "bamboo blade", "blade" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 100);
		set("material", "bamboo");
		set("long", "这是一把练习刀法用的竹刀。\n");
		set("wield_msg", "$N拿出一把练刀用的$n，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
	}
	init_sword(10);
	setup();
}
