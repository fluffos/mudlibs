#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("雷震镗" , ({ "tang" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("anti_absorb", 1);
		set("unit", "只");
		set("long", "这是一只奇门兵器，名唤雷震镗。\n");
                set("value", 5000);
                set("material", "iron");
		set("wield_msg", "$N拿出一只$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_staff(15);
        setup();
}
