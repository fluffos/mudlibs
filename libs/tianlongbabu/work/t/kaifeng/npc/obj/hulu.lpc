// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("葫芦", ({ "hulu" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个酒葫芦。\n");
		set("unit", "个");
		set("value", 100);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "烈酒",
		"remaining": 5,
		"drunk_apply": 5,
	]) );
}
