// book.c

inherit ITEM;

string *name = ({
	"诗经",
	"易经",
	"孟子",
	"论语",
	"大学",
	"中庸",
	"尚书",
	"礼记",
	"春秋",
});

void create()
{
	set_name(name[random(sizeof(name))], ({ "book" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "本");
                set("value", 200);
                set("skill", ([
                        "name": "literate",    
                        "exp_required": 0,              
                        "gin_cost": 20,     
                        "difficulty": 20,     
                        "max_skill": 30 
                ]) );
        }
}
