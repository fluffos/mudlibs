// token.c
inherit ITEM;

void create()
{
	set_name("青龙令", ({ "token"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "只");
		set("long", 
"一只西夏一品堂的青龙令，由一品堂的大将军郝连铁树亲自签"
"发，持此令者可在一品堂通行无阻。\n");
                set("value", 0);
        }
}
