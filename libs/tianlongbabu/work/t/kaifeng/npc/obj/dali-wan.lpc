// dali-wan.c
// last_update 4.2.1997 windf

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("大力丸", ({ "dali-wan" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("value", 200);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();

        if(!arg || arg != "dali-wan") return notify_fail("你要吃什麽？\n");

	message_vision("$N拿起一颗大力丸狼吞虎咽地吞了下去。\n", me);
	tell_object(me, "但是并有感觉到江湖郎中所说的效用，看来你上当"
			+ "买了假药了！\n");
	destruct(this_object());
	return 1;
}
