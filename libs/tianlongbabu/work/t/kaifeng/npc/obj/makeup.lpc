// letter.c
inherit ITEM;

void create()
{
	set_name("胭脂", ({ "makeup"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "盒");
		set("long", "一盒胭脂。\n");
                set("value", 1000);
        }
}
