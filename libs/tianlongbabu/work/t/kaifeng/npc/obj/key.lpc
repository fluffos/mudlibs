// seal.c
// last_update 4.2.1997 windf

inherit ITEM;

void create()
{
	set_name("铜钥匙", ({ "key" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("value", 0);
	}
}

