// marry_card.c
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("婚约", ({"marrycard"}) );
        set_weight(10);
        set("no_get", 1);
	set("no_drop","你的婚约不能随便丢弃，除非去红娘庄解除婚约。\n");
        if(clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "张");
                set("material", "paper");
                set("nodrop",1);
        }
}

void init()
{
        add_action("do_coupletalk", "ct");
        add_action("do_cemote", "ce" );
}

int do_cemote(string arg)
{
        object me, ob;
        string target, tmpstr1, tmpstr2,str1,str2;
        //int i;

        me = this_player();

	if(!me->query("marks/married"))
		return notify_fail("你目前并没有伴侣。\n");

        ob = find_player(target);
        if(!ob)
                return notify_fail("你的伴侣现在无法听见你，"
				+ "或者已经离开游戏了。\n");
        if((string)ob->query("gender") != "女性") 
	{
                tmpstr1 = "老婆"; tmpstr2 = "老公";
                str1 = "她"; str2 = "他";
        } else {
                tmpstr1 = "老公"; tmpstr2 = "老婆";
                str1 = "他"; str2 = "她";
        }

        if(!arg) 
	{
                write(MAG "你又深情的想念你的爱侣了。\n" NOR);
                tell_room(environment(me), CYN+(string)me->name()
                	+ "又深情的想念"+str1+"的爱侣"+ (string)ob->name()
                	+ "了。\n" +NOR, ({me, ob}));
                tell_object(ob, sprintf(MAG "%s %s 
                又在深情的想你了\n"NOR, tmpstr1, me->name(1) )); 

                return 1;
        }
        if(environment(me) == environment(ob )) 
	{       
		if(arg == "kiss") 
		{
			write( MAG "你拥住你的爱侣，深深的一吻，许久...许久...\n" NOR);
			tell_room(environment(me), CYN+(string)me->name()
				+ "拥住"+(string)ob->name()
				+"，深深的一吻。\n" 
                		+NOR, ({me, ob}));
                	tell_object(ob, sprintf(MAG "%s %s
				拥住你，深深的一吻，许久...许久...\n"
				NOR,tmpstr1,me->name(1)));
		}         
        }                 

        return 1;
}


int do_coupletalk(string arg)
{
        object me, ob;
        string target, tmpstr1, tmpstr2;

        me = this_player();

	if(!me->query("marks/married"))
                return notify_fail("你没有伴侣.\n");

        ob = find_player(target);
        if(!ob)
                return notify_fail("你的伴侣现在无法听见你，"
				+ "或者已经离开游戏了。\n"); 

        if((string)ob->query("gender") != "女性") 
	{
                tmpstr1 = "老婆";
                tmpstr2 = "老公";
        } else {
                tmpstr1 = "老公";
                tmpstr2 = "老婆";
        }

        write(sprintf(MAG"你对%s %s 说：%s\n"NOR,
                tmpstr2, ob->name(1), arg ));
        tell_object(ob, sprintf(MAG "%s %s 对你说：%s\n"NOR, 
               tmpstr1,me->name(1), arg ));

        return 1;
}

string query_autoload()
{
        object me;
//        object couple_ob;
        string target,cardname;
        //int i;

        me = this_player();
        cardname = present("marrycard")->query("name");

        sscanf(cardname,"你和%s的婚约", target);
      
        return target;
}

void autoload(string arg)
{
        object ob; //, me;
        string tmpstr, tmpstr1;

//        me = this_player();
        ob = find_player(arg);
        if(ob)
	{
                if((string)ob->query("gender") != "女性")
		{
                        tmpstr1 = "老公"; 
                        tmpstr = "老婆";
                } else {
                        tmpstr1 = "老婆";
                        tmpstr = "老公";
                }
                
		write(sprintf( MAG "你的%s也在这里，快去找啦...\n"NOR,tmpstr1));
                tell_object(ob ,
                	sprintf( MAG "你的%s来啦,快去接...\n" NOR, tmpstr));

//me->name(1)+"("+me->query("id")+")",environment(me))->query("name") ); 
                
                
        }
        set("name","你和"+arg+"的婚约");
}
