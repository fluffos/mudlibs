// letter.c
inherit ITEM;

void create()
{
	set_name("温玉儿的手书", ({ "letter"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "封");
		set("long", "温玉儿的手书。\n");
                set("value", 0);
        }
}
