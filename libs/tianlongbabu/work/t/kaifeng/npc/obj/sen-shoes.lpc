// han-cloth.c
//

#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("灰布僧鞋", ({ "shoes" }) );
        set_weight(3000);
        if(clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 1);
		set("value", 80);
        }
        setup();
}
