// hebao.c

inherit ITEM;

void create()
{
	set_name("鸳鸯荷包", ({ "hebao" }) );
        set_weight(3000);
        if(clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "只");
                set("material", "cloth");
		set("value", 80);
        }
        setup();
}
