// medicine.c

inherit ITEM;

void create()
{
	set_name("增神丸",({"zengshen-wuan"}));
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
		"一颗增神丸，可以吃下（ｅａｔ）来增神。\n");
	    set("unit","颗");
	    set("value", 1000);
	}
}

void init()
{
	add_action("apply_medicine","eat");
}

int apply_medicine()
{
	int value = 20;
	int diff;

	if(this_player()->is_fighting())
		return notify_fail("战斗中不能用药！\n");

	diff = this_player()->query("max_gin")-this_player()->query("eff_gin");
	if(!(diff)) return notify_fail("你暂时不用增神！\n");

	if(value > diff) value = diff;
	    
	message_vision("$N吃下一颗$n。\n", this_player(), this_object());

	this_player()->add("eff_gin", value);

	destruct(this_object());
	return 1;
}
