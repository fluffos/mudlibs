// skin.c
inherit ITEM;

void create()
{
	set_name("人皮", ({ "skin"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "封");
		set("unit", "一张人皮，可以用来做（ｍａｋｅ）面具。\n");
                set("value", 0);
        }
}

void init()
{
	add_action("do_make", "make");
}

int do_make(string arg)
{
	int i;
	object *inv, mask, me;

	if(!arg && arg != "mask" && arg != "面具")
		return notify_fail("你要用人皮做什么？\n");

	me = this_player();
	inv = all_inventory(me);
	for(i=0;i<sizeof(inv);i++)
	{
		if((!userp(inv[i])) && (inv[i]->name() == "御制胭脂"))
		{
			message_vision("$N将$n与御制胭脂一阵搓合，"
				+ "做出一张面具来！\n", me, this_object());
			mask = new(__DIR__"mask");
			mask->move(me);
			destruct(inv[i]);
			destruct(this_object());
			return 1;
		}
	}

	return notify_fail("你还却少另一样原料。\n");
}
