// rechner.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("算盘珠", ({ "zhu" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "把");
		set("base_unit", "粒");
                set("value", 0);
                set("material", "wood");
		set("wield_msg", "$N拿出一把$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
	set_amount(1);

        init_throwing(5);
        setup();
}
