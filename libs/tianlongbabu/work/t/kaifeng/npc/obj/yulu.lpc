// mifang.c
// last_update 4.2.1997 windf

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name( "九转玉露丸", ({ "yulu", "九转玉露丸"}) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "粒");
		set("value", 0);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();

        if(!arg || arg != "yulu") return notify_fail("你要吃什麽？\n");

	message_vision("$N飞快地将一粒$n吞入肚里。\n", me, this_object());
	if(me->query_condition("corpse_poison"))
	{
		tell_object(me, "你觉得一条冰线直入丹田，浑身骨结一松，"
			+ "你中的腐尸毒被解了！！！\n");
		me->clear_condition("corpse_poison");
	}
	destruct(this_object());
	return 1;
}
