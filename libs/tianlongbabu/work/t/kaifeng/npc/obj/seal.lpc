// seal.c
// last_update 4.2.1997 windf

inherit ITEM;

void create()
{
	set_name("雁形信物", ({ "seal" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只雕琢精细的飞雁。\n");
		set("unit", "只");
		set("value", 0);
	}
}

