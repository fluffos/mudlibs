// noodle.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("炸酱面", ({ "noodle" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碗香喷喷、热腾腾的炸酱面。\n");
		set("unit", "碗");
		set("value", 20);
		set("food_remaining", 3);
		set("food_supply", 40);
	}
}
