// rechner.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("算盘", ({ "suanpan" }));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "只");
		set("long", "一只帐房先生用的算盘。\n");
                set("value", 200);
                set("material", "iron");
		set("wield_msg", "$N拿出一只$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(5);
        setup();
}
