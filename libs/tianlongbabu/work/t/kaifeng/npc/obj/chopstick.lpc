// sword.c : 

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("长筷子", ({ "chopstick" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("long", "这是一双挑面用的长筷子。\n");
		set("value", 100);
		set("material", "wood");
		set("wield_msg", "$N拿出一双$n夹在手中。\n");
		set("unwield_msg", "$N放下了手中的$n。\n");
	}
	init_sword(15);
	setup();
}
