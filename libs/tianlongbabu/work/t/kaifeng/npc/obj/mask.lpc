// mask.c

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("面具", ({ "mask" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一张面具，可以用来（ｍｉｒｒｏｒ）别人的面孔。\n");
		set("unit", "只");
                set("value", 0);
                set("material", "leather");
                set("armor_prop/armor", 5);
		set("armor_prop/id", ({"nobody"}) );
		set("armor_prop/name", ({"千面人"}) );
		set("armor_prop/short", ({"千面人(nobody)"}) );
                set("armor_prop/long", ({
			"一张毫无表情的面孔。\n"
                }) );
        }
        setup();
}

void init()
{
	add_action("do_mirror","mirror");
}

int do_mirror(string arg)
{
	string id, name, long, short;
	object ob, me;

	if(this_object()->query("equipped"))
		return notify_fail("你必须先把面具卸下来。\n");

	me = this_player();
	//if(query("used") && !wizardp(me))
	if(query("used") && userp(me))
		if(!wizardp(me))
		return notify_fail("这面具已经印有别人的面孔，无法再用了。\n");

	if(!arg || !objectp(ob= present(arg, environment(me))))
		return 0; 

	if(!living(ob) || !userp(ob))
		return notify_fail("你不能印" + ob->name() + "面孔！\n");

	if(wizardp(ob))
		return notify_fail("你不能印巫师的面孔！\n");

	id = ob->query("id");
	name = ob->name();
	short = ob->short();
	long = ob->long();
	set("armor_prop/id", ({id}) );
	set("armor_prop/name", ({name}) );
	set("armor_prop/short", ({short}) );
	set("armor_prop/long", ({long}) );
	set("used", 1);
	tell_object(me, "你悄悄地将" + name + "面孔印在面具上。\n");
	set("long", "一张面具，上面赫然印着" + name + "的面孔。\n");
	return 1;
}
