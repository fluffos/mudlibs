// rope.c

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
	set_name( "铁链", ({ "lian" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "根");
                set("value", 500);
                set("material", "iron");
		set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n束在腰间。\n");
        }
        init_whip(5);

        setup();
}

