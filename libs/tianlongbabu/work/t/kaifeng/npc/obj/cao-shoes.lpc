// lian-cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("烂草鞋", ({ "shoes" }) );
        set_weight(3000);
        if(clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "双");
                set("material", "cloth");
                set("armor_prop/armor", 1);
		set("value", 0);
        }
        setup();
}
