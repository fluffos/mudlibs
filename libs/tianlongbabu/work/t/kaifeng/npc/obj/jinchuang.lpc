// jinchuang.c 金创药
inherit ITEM;
void setup()
{}
void init()
{
	add_action("do_eat", "eat");
}
void create()
{
	set_name("金创药", ({"jinchuang yao", "jin", "jinchuang"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "包");
		set("long", "这是一包武林人士必备的金创药。\n");
		set("value", 2000);
	}
	setup();
}

int do_eat(string arg)
{
	int value = 20;
        int diff;

        if(this_player()->is_fighting())
            return notify_fail("战斗中不能用药治伤!\n");
        diff = this_player()->query("max_kee")-this_player()->query("eff_kee");
        if(!(diff))    return notify_fail("你没有受伤啊?\n");
        if(value > diff) value = diff;
            
        message_vision("$N敷上金创药 .\n",this_player());
        this_player()->add("eff_kee",value);
        destruct(this_object());
        return 1;	
}
