// letter.c
inherit ITEM;

void create()
{
	set_name("密函", ({ "letter"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "封");
		set("long",
"明王明鉴：\n"
"    明王差属下的事已有眉目，萧确为孔雀山庄之后，只是\n"
"孔雀翎的下落尚未名了，属下定当探明！\n"
"			西城顿首。\n");
                set("value", 0);
        }
}
