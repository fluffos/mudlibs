// bi.c : an example weapon

#include <weapon.h>

inherit BI;

void create()
{
	set_name("铁笔", ({ "bi" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("long", "这是一把精钢打造的铁笔。\n");
		set("value", 400);
		set("material", "steel");
		set("wield_msg", "$N「唰」地一声抽出一只$n握在手中。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
	}
	init_bi(25);
	setup();
}
