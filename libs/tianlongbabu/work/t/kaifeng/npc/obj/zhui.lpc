// zhui.c : 

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("破甲锥", ({ "zhui" }) );
	set_weight(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("anti_absorb", 1);
		set("unit", "只");
		set("long", "这是一只奇门兵器，名唤破甲锥。\n");
		set("value", 5000);
		set("material", "steel");
		set("wield_msg", "$N拿出一只$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n藏入袖中。\n");
	}
	init_sword(15);
	setup();
}
