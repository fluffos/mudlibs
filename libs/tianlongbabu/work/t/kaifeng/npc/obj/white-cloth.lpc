// lian-cloth.c
//

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("雪白绸衫", ({ "cloth" }) );
        set_weight(3000);
        if(clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 1);
		set("value", 250);
        }
        setup();
}
