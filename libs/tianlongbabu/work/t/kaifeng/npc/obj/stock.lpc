#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("木杖" , ({ "stock" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
		set("long", "一根练杖法时用的木杖。\n");
                set("value", 300);
                set("material", "wood");
		set("wield_msg", "$N拿出一根$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_staff(5);
        setup();
}
