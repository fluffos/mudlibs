// lian-cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit WRISTS;

void create()
{
	set_name("青纱", ({ "wrists" }) );
        set_weight(3000);
        if(clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "条");
                set("material", "cloth");
                set("armor_prop/armor", 1);
		set("value", 250);
        }
        setup();
}
