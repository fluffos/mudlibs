// garrison.c

inherit NPC;

void create()
{
	set_name("容敌亲", ({ "rong" }) );
	set("gender", "男性" );
	set("title", "开封名捕");
	set("long",
		"容敌亲不论长相如何，但态度上都很温和、礼貌、客气，看上去很\n"
		"讲道理的样子。\n" );
	set("combat_exp", 500000);
	set("force", 600);
	set("max_force", 600);
	set("force_factor", 20);
	set("GARRISON", 1);
	set("chat_chance", 15);
	set("chat_msg", ({
		(: random_move :)
	}) );

	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_skill("whip", 120);

	setup();
	carry_object(__DIR__"obj/q-cloth")->wear();
	carry_object(__DIR__"obj/lian")->wield();
}
