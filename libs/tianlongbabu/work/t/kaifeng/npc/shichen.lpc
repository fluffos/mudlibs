// shichen.c

inherit NPC;

void create()
{
	set_name("西夏使臣", ({ "shichen" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long",
		"这是一位西夏国派来大宋朝的使臣。\n" );
	set("combat_exp", 160000);
	set("attitude", "friendly");

	set("force", 1600);
	set("max_force", 1600);
	set("force_factor", 60);

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_skill("force", 60);

	set_skill("fenjin-shou", 60);
	set_skill("tianying-steps", 60);
	set_skill("wind-force", 60);

	map_skill("unarmed", "fenjin-shou");
	map_skill("dodge", "tianying-steps");
	map_skill("force", "wind-force");

	setup();
        carry_object(__DIR__"obj/shichen-cloth")->wear();
	carry_object(__DIR__"obj/token");
	add_money("silver", 50);
}
