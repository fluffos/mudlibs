// jiao.c

inherit NPC;

void create()
{
	set_name("孙姣儿", ({ "jiao" }) );
	set("title", "名妓");
	set("gender", "女性" );
	set("age", 22);
	set("per", 30);
	set("long", @LONG
虽然孙姣儿来香君楼的时间还不长，但以成了香君楼的宠儿，
加上孙姣儿人长的甜，嘴也甜，从不得罪客人，所以赢得香君
楼上上下下地宠爱。
LONG
);
	set("combat_exp", 10);
	set("attitude", "friendly");

        set("chat_chance_combat", 25);
        set("chat_msg_combat", ({
		"孙姣儿秀眉微蹙道：我哪里得罪您了？干嘛这样跟我拼死拼活？\n",
	}) );

	set_skill("literate", 100);

	set("inquiry", ([
		"过夜": "官人可要洁身自好啊！",
	]) );

	setup();
	
	carry_object(__DIR__"obj/yellow-cloth")->wear();
}

int accept_object(object who, object ob)
{
        return 0;
}

int accept_fight(object me)
{
	command("say 小女子哪里是您的对手？");
	return 0;
}

