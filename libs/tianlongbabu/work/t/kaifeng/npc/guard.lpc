// guard.c

inherit NPC;

void create()
{
	set_name("镖师", ({ "guard" }));
	set("gender", "男性");
	set("age", 35);
	set("long", "一名身材魁武的镖师。\n");
	set("combat_exp", 1000);

	set_skill("sword", 60);
	set_skill("parry", 50);
	
	setup();
	carry_object(__DIR__"obj/sword")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 10);
}
