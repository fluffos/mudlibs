// oldman.c by windf 26.05.87

inherit NPC;

string show_way();

void create()
{
	set_name("老苍头", ({ "oldman" }));
	set("gender", "男性" );
	set("age", 72);
	set("str", 35);
	set("long",
		"老苍头看上去七十开外，一头白发，老态隆中。\n");
	set("combat_exp", 5);
	set("combat_exp", 20000);
	set("inquiry", ([
		"带路": (: show_way :),
        ]) );
	set_skill("unarmed", 20);
	
	setup();

        carry_object("/obj/cloth")->wear();
        add_money("silver", 2);
}

void init()
{	
	object ob;

	::init();
	if(interactive(ob = this_player()) && !is_fighting()) 
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	if(environment()->query("begin"))
		command("close door");
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	if(ob->query_temp("knock"))
	{
		command("angry " + ob->query("id"));
		ob->delete_temp("knock");
	}
	if(ob->query_temp("marks/老苍头") && !environment()->query("begin"))
	{
		command("nod");
		remove_call_out("lead_way");
		call_out("lead_way", 1, ob);
	}
}

string show_way()
{
	object me = this_player();

	if(!me->query("marks/萧秋雨"))
	{
		message_vision("$N指了指自己的耳朵，又指了指嘴，好象是说"
			+ "自己又聋又哑，不懂$n说什么！\n", this_object(), me);
		return "呀．．．啊．．．\n";
	}
	//me->set_leader(this_object());
	me->set_temp("marks/老苍头", 1);
	set_temp("way", 0);
	command("sigh " + me->query("id"));
	remove_call_out("lead_way");
	call_out("lead_way", 2, me);
	return "即然是秋雨让你来的，那就跟我来吧！\n";
}

void lead_way(object me)
{
	string *dir;
	object env;

	env = environment();
	if(!me || environment(me) != env) return;
	if(env->query("begin"))
		dir = ({"east", "north", "south"});
	else dir = ({"east", "north", "south", "west"});;

	if(query_temp("way") < 5)
	{
		command("go " + dir[random(sizeof(dir))]);
		add_temp("way", 1);
		return;
	}
	if(query_temp("way") == 5)
	{
		env->set("exits/north", "/t/kaifeng/stoneroom5");
		set_temp("last_env", env);
		add_temp("way", 1);
		command("go north");
		return;
	}

	env = query_temp("last_env");
	if(env->query("stone3"))
		env->set("exits/north", "/t/kaifeng/stoneroom4");
	else if(env->query("stone4"))
		env->set("exits/north", "/t/kaifeng/stoneroom3");
		
	delete_temp("way");
	delete_temp("last_env");
	me->delete_temp("marks/老苍头");
	command("say 到了！剩下的你自己去看吧！\n");
	message_vision("说完，$N又顺着原路走了回去。\n", this_object());
	this_object()->move("/t/kaifeng/stoneroom2");
	message_vision("$N不知从什么地方走了过来。\n", this_object());
}
