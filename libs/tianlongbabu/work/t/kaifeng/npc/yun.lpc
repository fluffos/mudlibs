// yun.c 

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("云素素", ({ "yun" }));
	set("title", "胭脂店老板娘");
	set("gender", "女性");
	set("age", 28);
	set("per", 30);
	set("long",
		"云素素在开封城以美貌著称，到这来的男人多半是冲着她来的。\n");
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_temp("apply/damage", 15);
	set("combat_exp", 40000);
	set("attitude", "friendly");
	set("vendor_goods", ([
		"胭脂": __DIR__"obj/makeup",
		"香粉": __DIR__"obj/perfume",
	]));
	
	setup();
}
void init()
{
	::init();
        add_action("do_vendor_list", "list");
}
