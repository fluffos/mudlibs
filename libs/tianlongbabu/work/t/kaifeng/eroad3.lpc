// eroad3.c

inherit ROOM;

void create()
{
	set("short", "汴梁东大街");
	set("long", @LONG
汴梁东大街为官府衙门的所在，各府各卿，方面大员都在这里进出。
从这往北是户部街，往南是乌衣巷。
LONG
	);
	set("exits", ([
		"north": __DIR__"neroad",
		"south": __DIR__"seroad",
		"west": __DIR__"eroad2",
		"east": __DIR__"eroad4",
	]));
	set("objects", ([
		__DIR__"npc/xunbu" : 1,
		__DIR__"npc/he" : 1,
	]) );

	set("no_clean_up", 0);

	setup();
}
