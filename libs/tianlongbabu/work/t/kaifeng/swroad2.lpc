// swroad.c

inherit ROOM;

void create()
{
	set("short", "同庆街");
	set("long", @LONG
同庆街是当今天子五十大寿时所赐的名，取普天同庆之意。街的西
面有家胭脂店。
LONG
	);
	set("exits", ([
		"north": __DIR__"swroad",
		"south": __DIR__"swcenter",
		"west" : __DIR__"makeup_store",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
