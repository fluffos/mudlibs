// yroad.c

inherit ROOM;

void create()
{
	set("short", "杨花巷");
	set("long", @LONG
杨花巷是汴梁城中有名的去处，吃喝玩乐样样俱备，所以有钱的没
钱的都喜欢到这里来凑热闹，巷子南面是一家赌坊，里面不时向外传出
欢呼吆喝声。
LONG
	);
	set("exits", ([
		"west": __DIR__"yroad2",
		"east": __DIR__"sroad3",
		"south": __DIR__"betroom",
	]));
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/beggar": 1
	]));

	setup();
}
