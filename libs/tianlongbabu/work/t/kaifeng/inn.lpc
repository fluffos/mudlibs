// starinn.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "龙门客栈");
	set("long", @LONG
龙门客栈是卞梁南城的一个大客栈，由于卞梁城游客商旅皆多，尤
其都在南城，所以龙门客栈的生意也非常兴隆。
LONG
	);

	set("valid_startroom", 1);
