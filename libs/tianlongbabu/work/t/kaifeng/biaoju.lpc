// biaoju.c

inherit ROOM;

void create()
{
	set("short", "金刀镖局");
	set("long", @LONG
金刀镖局威镇两河，北五省数头号牌子。镖局门边左右各有一个张
牙舞爪的石狮，傍插两丈多高的旗杆一根，杆上锦旗飘扬，上书「金刀
镖局」四字，铁划银钩，刚劲非凡。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"proad",
		"north" : __DIR__"biaoju2",
	]));
	set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/guard3" : 2,
	]));

	setup();
}
