// stoneroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "青石大屋");
	set("long", @LONG
这是一间居大的屋子，四周墙壁都是由大块的青石砌成。地上铺着
方形的黑白砖块，非常整齐。屋子里面空空荡荡，什么也没有。
LONG
	);
	set("stone4", 1);
	set("exits", ([
		"west": __DIR__"stoneroom3",
		"east": __DIR__"stoneroom3",
		"north":  __DIR__"stoneroom3",
		"south":  __DIR__"stoneroom3",
	]) );

	setup();
}

int valid_leave(object me, string dir) 
{
	int i;
	object *inv;
	string msg, msg2;

	if(!userp(me) && me->query_temp("way")) return 1;

	if(random(10) < 4 && !me->query_temp("marks/老苍头"))
	{
		inv = all_inventory(me);
		message_vision("\n$N脚下的石砖突然裂开，$N不由自主地"
			+ "往下坠去！！\n", me);
		for(i=0;i<sizeof(inv);i++)
			if(userp(inv[i])) inv[i]->move(this_object());
			else destruct(inv[i]);
		me->unconcious();
		me->move(__DIR__"shixiang2");
		message("vision", "青石墙忽然裂开条缝，从里面滑出个人来，"
                        + "青石墙又迅速合拢。\n", environment(me));
		return notify_fail("");
	}

	msg = "$N小心翼翼地将脚向";
	msg2 = "面的一块石砖踏去．．．\n";
	if(dir == "east")
		message_vision(msg + "东" + msg2, me);
	else if(dir == "south")
		message_vision(msg + "南" + msg2, me);
	else if(dir == "west")
		message_vision(msg + "西" + msg2, me);
	else if(dir == "north")
		message_vision(msg + "北" + msg2, me);

        return 1;
}
