// sinn.c

#include <ansi.h>

inherit ROOM;

varargs static void create_food(string nmstr, string* idlist, string longstr)
{
	object obj;

	obj = new(__DIR__"obj/food");
	obj->set_name(nmstr, idlist);
	if (longstr)
		obj->set("long", longstr);
	else
		obj->set("long", "一盘热气腾腾, 香气扑鼻的" + nmstr + "\n");
	obj->move(this_object());
}

varargs static void create_wine(string nmstr, string* idlist, string longstr)
{
	object obj;

	obj = new(__DIR__"obj/wine");
	obj->set_name(nmstr, idlist);
	if (longstr)
		obj->set("long", longstr);
	else
		obj->set("long", "一杯酒香醇正的" + nmstr + "\n");
	obj->set("liquid/name", nmstr);
	obj->move(this_object());
}

void create()
{
	set("short", "狮子楼");
	set("long", @LONG
狮子楼在卞梁与街对面的快活林齐名，但两家饭庄在生意上是死对
头，总希望能压倒对方，尽管如此，由于卞梁城过往人密，两家饭庄的
生意都非常红火，整天里豪客如云，吆三喝四之声不绝于耳。北面粉墙
上龙飞凤舞地题着大宴的菜牌（ｓｉｇｎ）。
LONG
        );
	set("exits", ([
		"west": __DIR__"sroad2" ]) );
	set("item_desc", ([
		"sign": @TEXT
狮子楼目前提供（ｏｒｄｅｒ）的宴席有：

对饮小酌        （白银五十两）
满师宴          （白银一百两）
长寿宴          （白银二百两）
群雄大宴        （白银五百两）

TEXT
        ]) );
	set("objects", ([
                __DIR__"npc/sinn-waiter" : 1,
	]));

	setup();
}

void init()
{
	object me;

	add_action("do_order", "order");
	if(query("order_owner")) 
	{
		me = this_player();
		me->set("food", me->query("food") / 2);
		me->set("water", me->query("water") / 2);
	}
}

int do_order(string arg)
{
	object me, env;
	object* oblist;
	string mesg;
	int idx;

	me = this_player();
	env = this_object();
	mesg = query("order_owner");
	if (mesg && (arg == "end") && (mesg == me->query("id"))) {
		mesg = "狮子楼的宴会终于结束了!\n";
		message("channel:chat", RED+"【狮子楼】" + mesg + NOR, users());
		delete("order_owner");
		delete("order_type");
		oblist = all_inventory(env);
		for(idx=0; idx<sizeof(oblist); idx++) {
			if (!objectp(oblist[idx]))
				continue;
			if (userp(oblist[idx]))
				continue;
			destruct(oblist[idx]);
		}
		return 1;
	}
	if (mesg)
		return notify_fail("这里已经被人包租了.\n");
	if (arg == "对饮小酌") {
		mesg = "某人正在狮子楼与人对饮小酌!\n";
		if (me->can_afford(5000) != 1)
			return notify_fail("你的钱不够。\n");
		me->pay_money(5000);
		create_food("鱼香肉丝", ({ "yxrs" }));
		create_food("芫爆二条", ({ "ybet" }));
		create_food("炒什菜", ({ "csc" }));
		create_wine("二锅头", ({ "wine" }));
	} else if (arg == "满师宴") {
		mesg = me->name() + "要在狮子楼开满师宴!\n";
		if (me->can_afford(10000) != 1)
			return notify_fail("你的钱不够。\n");
		me->pay_money(10000);
		create_food("汤包", ({ "tb" }) );
		create_food("宫保虾", ({ "gbx" }) );
		create_food("樟茶鸭", ({ "zcj" }) );
		create_food("清炒虾仁", ({ "qcxr" }) );
		create_food("荷叶粉蒸肉", ({ "fzr" }) );
		create_wine("二锅头", ({ "wine" }));
		create_wine("二锅头", ({ "wine" }));
	} else if (arg == "长寿宴") {
		mesg = me->name() + "要在狮子楼开长寿宴了!\n";
		if (me->can_afford(20000) != 1)
			return notify_fail("你的钱不够。\n");
		me->pay_money(20000);
		create_food("烤鸭", ({ "ky" }) );
		create_food("烧鸡", ({ "sj" }) );
		create_food("长寿面", ({ "csm" }) );
		create_food("叉烧面", ({ "csm2" }) );
		create_food("罗汉上素", ({ "lhss" }) );
		create_food("春雷惊龙", ({ "cljl" }) );
		create_food("清蒸甲鱼", ({ "qzjy" }) );
		create_wine("二锅头", ({ "wine" }));
		create_wine("二锅头", ({ "wine" }));
		create_wine("二锅头", ({ "wine" }));
	} else if (arg == "群雄大宴") {
		mesg = me->name() + "要在狮子楼宴请众位豪杰侠女!\n";
		if (me->can_afford(50000) != 1)
			return notify_fail("你的钱不够。\n");
		me->pay_money(50000);
		create_food("爆肚", ({ "bd" }) );
		create_food("烧鹅", ({ "se" }) );
		create_food("酱牛肉", ({ "jnr" }) );
		create_food("酱肘子", ({ "jzz" }) );
		create_food("溜黄菜", ({ "lhc" }) );
		create_food("糟溜鱼", ({ "zly" }) );
		create_food("烤乳猪", ({ "krz" }) );
		create_food("凤尾虾", ({ "fwx" }) );
		create_food("羊肉西葫芦饺子", ({ "dumplings" }) );
		create_wine("二锅头", ({ "wine" }));
		create_wine("二锅头", ({ "wine" }));
		create_wine("极品二锅头", ({ "wine" }));
		create_wine("极品二锅头", ({ "wine" }));
	} else {
		return notify_fail("你要定什么宴席？\n");
	}
	message("channel:chat", RED+"【狮子楼】" + mesg + NOR, users());
	set("order_owner", me->query("id"));
	set("order_type", arg);
	return 1;
}

int valid_leave(object me, string dir)
{
	if (me->query("id") != query("order_owner"))
		return 1;
	return notify_fail(RED + "先用（ｏｒｄｅｒ　ｅｎｄ）后再走。\n" + NOR);
}
