// wroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁西大街");
	set("long", @LONG
汴梁西大街多为达官贵人所居之处，因此没有太多得喧嚣吵闹之声。
从这往北是壮元巷，往南是同庆街。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"north": __DIR__"nwroad",
		"south": __DIR__"swroad",
		"west": __DIR__"wroad4",
		"east": __DIR__"wroad2",
	]));
	set("objects", ([
                __DIR__"npc/xunbu" : 1,
		__DIR__"npc/yi" : 1,
        ]) );
	set("no_clean_up", 0);

	setup();
}
