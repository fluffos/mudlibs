// Room: zahuopu.c
inherit ROOM;
void create()
{
	set("short", "沈记杂货铺");
	set("long", @LONG
这是一家小杂货铺，都卖些日常杂货，铺门上挂着面布旗，上面写
着个「沈」字。杂货铺老板沈长正热情地招呼着过往的行人。
LONG
	);
	set("exits", ([
		"south" : __DIR__"troad2",
	]));
	set("objects", ([
		__DIR__"npc/shen": 1,
	]));
	setup();
}
