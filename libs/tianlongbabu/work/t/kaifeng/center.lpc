// center.c

inherit ROOM;

void create()
{
	set("short", "汴梁城中心");
	set("long", @LONG
河南开封府乃当今大宋国的国都，又名汴梁。天子角下自然是歌舞
升平，繁华无比，这里是汴梁城中心，四通八达，更是热闹非凡，诺大
的广场上挤满了熙熙攘攘的人群。从广场往北便是大宋皇帝的禁城。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
		"south": __DIR__"sroad",
		"north": __DIR__"city",
		"west": __DIR__"wroad",
		"east": __DIR__"eroad",
	]));
	set("objects", ([
                __DIR__"npc/renmo": 1,
        ]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
