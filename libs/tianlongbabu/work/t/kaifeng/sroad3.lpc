// sroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁南大街");
	set("long", @LONG
与东大街和西大街相比，汴梁的南大街则是平民百姓所居之所，游
客商旅也比目皆是，所以车水马龙，热闹无比。从这往西是杨花巷，往
东是铁匠营。
LONG
	);
	set("exits", ([
		"east": __DIR__"troad",
		"west": __DIR__"yroad",
		"north": __DIR__"sroad2",
		"south": __DIR__"sroad4",
	]));
	set("objects", ([
                __DIR__"npc/xunbu" : 1,
		__DIR__"npc/tan" : 1,
        ]) );
	set("no_clean_up", 0);

	setup();
}
