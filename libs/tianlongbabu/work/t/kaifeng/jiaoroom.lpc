// jiaoroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "藏娇屋");
        set("long", @LONG
藏娇屋是孙姣儿的居处，孙姣儿来到香君楼后，便将藏娇屋从新做
了一番部置，整个屋子成淡黄色，墙角还放着几株绿竹，使藏娇屋更添
几分芳彩。
LONG
        );
        set("exits", ([
                "east": __DIR__"jiyuan2", 
        ]) );

        set("objects", ([
                __DIR__"npc/jiao" : 1,
        ]) );

        setup();

}
