// starinn.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "魁星阁");
	set("long", @LONG
魁星阁是卞梁城有名的雅居，无论是当朝的大员或是著名的雅士都
喜欢到此处来一聚。是个谈天说地，吟诗作画的好去处。
LONG
	);

	set("exits", ([
		"south"	: __DIR__"wroad",
		"up" : __DIR__"starinn2",
	 ]) );

	set("objects", ([
		__DIR__"npc/star-waiter" : 1 ]) );

	setup();
}
