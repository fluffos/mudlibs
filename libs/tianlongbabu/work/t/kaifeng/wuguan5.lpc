#include <room.h>

inherit ROOM;

void create()
{
	set("short", "走道");
	set("long", @LONG
这里是腾龙武馆的走道，左右两边都是练武场，吆喝与刀剑碰撞的
声音便是从那里传来的。往东则是武馆师父们休息的大厅。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
		"north": __DIR__"wuguan6",
		"south" : __DIR__"wuguan7",
		"east" : __DIR__"wuguanhall",
		"west" : __DIR__"wuguan2",
	]));

	setup();
	replace_program(ROOM);
