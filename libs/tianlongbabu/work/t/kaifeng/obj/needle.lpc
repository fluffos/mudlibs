// needle.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("金针", ({ "needle" }));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("anti_absorb", 1);
		set("unit", "蓬");
		set("base_unit", "枚");
                set("value", 0);
                set("material", "steel");
		set("needle", 1);
		set("wield_msg", "$N拿出一蓬$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
	set_amount(1);

        init_throwing(30);
        setup();
}
