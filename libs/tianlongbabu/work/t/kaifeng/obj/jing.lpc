// tong.c

inherit ITEM;

void create()
{
	set_name("井台", ({ "井台", "jing" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("no_show",1);
                set("no_get",1);
		set("position", "on");
		set("long", "青石做的井台，可上面却没有井绳。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
