// dumpling.c

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("食品", ({ "food" }));
	set_weight(100);
	if(clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一盘食品。\n");
		set("unit", "盘");
		set("value", 0);
		set("food_remaining", 10);
		set("food_supply", 5);
	}
}

int valid_get(object me)
{
	tell_object(me, "这里不兴打包带走!\n");
	return 0;
}
