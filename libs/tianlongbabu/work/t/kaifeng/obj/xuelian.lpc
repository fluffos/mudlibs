// xuelian.c
inherit ITEM;

void create()
{
	set_name("天山雪莲", ({ "xuelian"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "朵");
                set("value", 10000);
        }
}
