// wine.c

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("酒", ({ "wine" }));
	set_weight(800);
	if(clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一杯酒。\n");
		set("unit", "杯");
		set("value", 20);
		set("max_liquid", 15);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "酒",
		"remaining": 15,
		"drunk_apply": 6,
	]) );
}

int valid_get(object me)
{
	tell_object(me, "大伙都想喝，干吗要独吞呢!\n");
	return 0;
}
