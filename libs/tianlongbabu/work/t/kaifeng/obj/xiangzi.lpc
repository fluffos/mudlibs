// xiangzi.c

inherit ITEM;

void create()
{
	set_name("箱子", ({ "箱子", "xiangzi" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("no_show",1);
                set("no_get",1);
		set("long", "这是一只箱子。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
