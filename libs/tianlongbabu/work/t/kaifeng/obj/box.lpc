// box.c

inherit ITEM;

void create()
{
	set_name("红木匣子", ({ "红木匣子", "box", "_box_" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("no_show",1);
		set("no_show_cont",1);
                set("no_get",1);
		set("open", 0);
		set("long", "一口制做精细的红木匣子，匣盖紧紧关着。\n");
		set("value", 1);
	}
}

void init()
{
        add_action("do_open", "open");
        add_action("do_close", "close");
}

int do_open(string arg)
{
//	object needle; //, ling;

        if(!arg && arg != "box" && arg != "红木匣子")
                return 0;

        if(query("open"))
        {
                write("红木匣子的匣盖是打开的！！\n");
                return 1;
        }
	set("no_show_cont", 0);
        set("open", 1);
        set("long", "一口制做精细的红木匣子，匣盖是打开的。\n");
        message_vision("$N小心地将红木匣子的匣盖打开。\n", this_player());
	return 1;
}

int do_close(string arg)
{
        if(!arg && arg != "box" && arg != "红木匣子") return 0;

        if(!query("open"))
        {
                write("红木匣子的匣盖是关着的！！\n");
                return 1;
        }
	set("no_show_cont", 1);
        set("open", 0);
        set("long", "一口制做精细的红木匣子，匣盖紧紧关着。\n");
        message_vision("$N小心地将红木匣子的匣盖关上。\n", this_player());
        return 1;
}

int is_container() { return 1; }

int valid_put_in(object ob)
{
	if(!query("open"))
	{
		write("红木匣子的盖子是关着的！！\n");
		return 0;
	}
	if(ob->name() != "孔雀翎" && !ob->query("needle"))
		return 0;
	return 1;
}
	
int valid_get_from(object ob)
{
	if(!query("open"))
        {
		write("红木匣子的盖子是关着的！！\n");
                return 0;
        }
	return 1;
}
