// nroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁北大街");
	set("long", @LONG
这里是汴梁的北大街。北大街不长，比其它几条大街要短得多，居
住在这条街上多为生意或手意人。
LONG
	);
	set("exits", ([
		"south": __DIR__"proad3",
		"north": __DIR__"nroad2",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
