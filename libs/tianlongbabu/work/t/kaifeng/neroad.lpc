// neroad.c

inherit ROOM;

void create()
{
	set("short", "户部街");
	set("long", @LONG
户部是朝廷中最大的部，里面又分属许多小部，所管辖的范围极广，
所以占居了这里整条街，故名-户部街。
LONG
	);
	set("exits", ([
		"south": __DIR__"eroad3",
		"north": __DIR__"neroad2",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
