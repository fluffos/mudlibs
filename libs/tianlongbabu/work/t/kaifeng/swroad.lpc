// swroad.c

inherit ROOM;

void create()
{
	set("short", "同庆街");
	set("long", @LONG
同庆街是当今天子五十大寿时所赐的名，取普天同庆之意。街的西
面有家药铺。
LONG
	);
	set("exits", ([
		"west" : __DIR__"drugstore",
		"north": __DIR__"wroad3",
		"south": __DIR__"swroad2",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
