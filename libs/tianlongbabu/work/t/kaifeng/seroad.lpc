// seroad.c

inherit ROOM;

void create()
{
	set("short", "乌衣巷");
	set("long", @LONG
乌衣巷曾为显贵所居之处，后多搬迁往汴梁西大街，乌衣巷便由此
而末落，但从巷旁依存的青石大屋，依然可以看出往日的辉煌。
LONG
	);
	set("exits", ([
		"north": __DIR__"eroad3",
		"south": __DIR__"seroad2",
	]));
	set("no_clean_up", 0);
	set("objects", ([
                __DIR__"npc/scavenger" : 1,
        ]) );

	setup();
}
