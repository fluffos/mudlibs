// yuroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "如玉阁");
        set("long", @LONG
一进如玉阁便能闻到一种淡淡的香气，加上阁中四处青绿之色，让人在
这灯红酒绿的香君楼不觉耳目一新。西面墙上挂着一副仕女图，画中人物的
面目依希便是这阁中主人－温玉儿。
LONG
        );
        set("exits", ([
                "west": __DIR__"jiyuan2", 
        ]) );

        set("objects", ([
                __DIR__"npc/yu" : 1,
		__DIR__"npc/gao" : 1,
        ]) );

        setup();

}

