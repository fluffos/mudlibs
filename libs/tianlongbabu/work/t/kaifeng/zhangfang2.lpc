// zhangfang2.c
#include <obj.h>

inherit ROOM;

void create()
{
	set("short", "小库房");
        set("long", @LONG
小库房里面不大，堆满了许多箱子包裹之类的东西。平常人等不许进入
这个库房，就是镖局里的人，除了大镖师以上的人物也无法入内。
LONG
        );
        set("objects", ([
		__DIR__"obj/xiangzi": 1,
		__DIR__"npc/guard2" : 1,
        ]));
        setup();
}

void reset()
{
        object *inv;
        object xiang, item; //, item2;
        int i;

        ::reset();
        xiang = present("xiangzi", this_object());
        inv = all_inventory(xiang);
        if(sizeof(inv) != 1) 
	{
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/xuelian");
                item->move(xiang);
        }
}

