// lake.c

inherit ROOM;

void create()
{
	set("short", "瘦西湖");
        set("long", @LONG
瘦西湖汴梁城的一景，虽比不上杭州的西湖，但一草一木，一水一石，都
带这杭州西湖的韵味，许多游人玩渴了，便直接在湖中取水（ｆｉｌｌｗａｔｅｒ）。
LONG
        );
        set("exits", ([
		"north": __DIR__"proad3",
	]));
	set("objects", ([
		__DIR__"npc/thief": 1
	]) );

	set("resource/water", 1);

        setup();
}

void init()
{
        add_action("do_fillwater", "fillwater");
}

int do_fillwater(string arg)
{
	int i;
        object *inv, ob, me;
        //string dir;

	me = this_player();
	inv = all_inventory(me);
	i = sizeof(inv);
	while(i--) 
	{
               	if(((string)inv[i]->query("liquid/type") == "alcohol")
		||((string)inv[i]->query("liquid/type") == "water"))
	        {
                       	ob = inv[i];                         
                        ob->set("liquid", ([
                               	"type": "water",
                               	"name": "清水",
                               	"remaining": 15,
                               	"drunk_apply": 6,
                        	]) );
			message_vision("$N将$n装满了清水。\n", me, ob);
			return 1;
		}
	}

	return notify_fail("你没有装水的东西啊！\n");
}
