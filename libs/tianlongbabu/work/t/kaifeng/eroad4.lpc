// eroad4.c

inherit ROOM;

void create()
{
	set("short", "汴梁东大街");
	set("long", @LONG
汴梁东大街为官府衙门的所在，各府各卿，方面大员都在这里进出。
LONG
	);
	set("exits", ([
		"west": __DIR__"eroad3",
		"east": __DIR__"eroad5",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
