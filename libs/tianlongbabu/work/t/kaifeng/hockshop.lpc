// hockshop.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "聚宝当铺");
	set("long", @LONG
聚宝当铺财力雄厚，规模也相当大，当铺的门檐上挂着一面布旗，蓝底
白字，上书斗大的「当」字，铺中一尘不染的柜台上放著一张木牌（ｓｉｇｎ）。
LONG
	);
	set("item_desc", ([
		"sign": @TEXT
本当铺财力雄厚，童叟无欺，欢迎惠顾，绝对保密。客倌可以在这里

注：有颜色的物品要用英文名称。
ｌｉｓｔ                        查看本铺的存货。
ｓｅｌｌ        <物名>          卖断货物。
ｖａｌｕｅ      <物名>          估价货物。
ｐａｗｎ        <物名| >        典当货物。
ｒｅｄｅｅｍ    <物名>          赎回货物。
ｓｈｕ          <第几号物品>    赎回第几号物品。

TEXT
	]) );
	set("exits", ([
		"west" : __DIR__"sroad4",
	]));
	set("objects", ([
                __DIR__"npc/liu": 1]));

	setup();

}
