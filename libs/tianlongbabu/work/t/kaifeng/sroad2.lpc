// sroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁南大街");
	set("long", @LONG
与东大街和西大街相比，汴梁的南大街则是平民百姓所居之所，游
客商旅也比目皆是，所以车水马龙，热闹无比。大街东西两面俱是饭庄，
东有狮子楼，西有快活林。
LONG
	);
	set("exits", ([
		"north": __DIR__"sroad",
		"south": __DIR__"sroad3",
		"west": __DIR__"hinn",
		"east": __DIR__"sinn",
	]));
	set("objects", ([
		__DIR__"npc/drunk": 1
	]));
	set("no_clean_up", 0);

	setup();
}
