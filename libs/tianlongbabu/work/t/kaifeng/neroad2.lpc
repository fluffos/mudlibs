// neroad.c

inherit ROOM;

void create()
{
	set("short", "户部街");
	set("long", @LONG
户部是朝廷中最大的部，里面又分属许多小部，所管辖的范围极广，
所以占居了这里整条街，故名-户部街。街东面有一家武馆。
LONG
	);
	set("exits", ([
		"north": __DIR__"necenter",
		"south": __DIR__"neroad",
		"east" : __DIR__"wuguan",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
