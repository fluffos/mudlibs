// jiyuan.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "香君楼");
        set("long", @LONG
香君楼里红灯高挂，帐帘低垂，丝竹管弦声中加杂着莺声燕语，声
声入耳，不得不令人心神荡漾。
LONG
        );
        set("exits", ([
                "north": __DIR__"yroad2", 
                "up": __DIR__"jiyuan2",
        ]) );

        set("objects", ([
                __DIR__"npc/mother" : 1,
        ]) );

        setup();
}
