// gov.c

inherit ROOM;

void create()
{
	set("short", "开封府大堂");
	set("long", @LONG
开封府衙威名显赫，堂上威严肃静，大梁上一块大匾，黑底白字，
上书「明镜高悬」。许多有冤情的人都来这里状告（ａｃｃｕｓｅ）。
LONG
	);
	set("exits", ([
		"south": __DIR__"gov",
	]));
	set("objects", ([
                __DIR__"npc/qu": 1,
		__DIR__"npc/sima" :1]));
	set("no_clean_up", 0);

	setup();
}
