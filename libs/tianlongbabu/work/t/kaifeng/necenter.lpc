// necenter.c

inherit ROOM;

void create()
{
	set("short", "进香河");
	set("long", @LONG
进香河是户部街与平安大街两条街的交接之处，位于汴梁城的东北
面。北面是大相国寺的菜园子。
LONG
	);
	set("exits", ([
		"south": __DIR__"neroad2",
		"west": __DIR__"proad5",
		"north": __DIR__"garden",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
