inherit ROOM;
void create()
{
	set("short", "壮元书局");
	set("long", @LONG
壮元书局是开封城里最大的书局，生意很好。读书人都想借壮元巷
的名头，掏个吉利，所以到这来买书的人落绎不绝。
LONG
	);
	set("exits", ([
		"west" : __DIR__"nwroad2",
	]));
	set("objects", ([
		__DIR__"npc/huang" : 1,
	]));
	setup();
}
