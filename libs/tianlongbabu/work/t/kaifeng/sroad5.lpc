// sroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁南大街");
	set("long", @LONG
与东大街和西大街相比，汴梁的南大街则是平民百姓所居之所，游
客商旅也比目皆是，所以车水马龙，热闹无比。再往南走便是汴梁城的
南门了。
LONG
	);
	set("exits", ([
		"north" : __DIR__"sroad4",
		"south" : __DIR__"sgate",
		"east" : __DIR__"inn",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
