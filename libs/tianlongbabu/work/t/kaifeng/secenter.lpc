// swroad.c

inherit ROOM;

void create()
{
	set("short", "提篮桥");
	set("long", @LONG
提篮桥是铁匠营与乌衣巷两条街的交接之处，位于汴梁城的东南面。
东面有一条青石巷。
LONG
	);
	set("exits", ([
		"north": __DIR__"seroad2",
		"west": __DIR__"troad2",
		"east": __DIR__"shixiang",
	]));
	set("objects", ([
                __DIR__"npc/zhang1" : 1,
		__DIR__"npc/zhang2" : 1,
        ]) );

	set("no_clean_up", 0);

	setup();
}
