// stoneroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "青石大屋");
	set("long", @LONG
这是一间居大的屋子，四周墙壁都是由大块的青石砌成。地上铺着
方形的黑白砖块，非常整齐。屋子里面空空荡荡，什么也没有。
LONG
	);
	set("begin", 1);
	set("exits", ([
		"west": __DIR__"stoneroom",
		"east": __DIR__"stoneroom3",
		"north": __DIR__"stoneroom3",
		"south": __DIR__"stoneroom3",
	]) );
	set("objects", ([
                __DIR__"npc/oldman" : 1,
        ]) );

	create_door("west", "大门", "east", DOOR_CLOSED);

	setup();
}

int valid_leave(object me, string dir) 
{
	object ob;

	if(::valid_leave(me, dir))
	{
        	if(dir == "west")
		{
                	me->delete("knock", 1);
			if(ob = present("oldman", environment(me)))
				ob->do_command("close door");
		}
		return 1;
	}
}
