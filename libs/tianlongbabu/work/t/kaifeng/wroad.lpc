// wroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁西大街");
	set("long", @LONG
汴梁西大街多为达官贵人所居之处，因此没有太多得喧嚣吵闹之声。
大街北面的「魁星阁」是专供文人墨客们喝茶品酒的去处。
LONG
	);
	set("exits", ([
		"north": __DIR__"starinn",
		"west": __DIR__"wroad2",
		"east": __DIR__"center",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
