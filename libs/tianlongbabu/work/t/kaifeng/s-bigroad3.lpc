// Room: /t/kaifeng/s-bigroad3.c

inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨垂
柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"s-bigroad2",
  "southwest" : "/t/dali/road4",
  "west" : "/t/dengfeng/e-road4",
]));

	setup();
	replace_program(ROOM);
}
