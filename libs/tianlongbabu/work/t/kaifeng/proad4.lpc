// proad.c

inherit ROOM;

void create()
{
	set("short", "平安大街");
	set("long", @LONG
平安大街位于汴梁城北，整条大街横贯开封北城。大街两旁绿树
垂阴，环境十分安宁。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"west" : __DIR__"proad3",
		"east" : __DIR__"proad5",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
