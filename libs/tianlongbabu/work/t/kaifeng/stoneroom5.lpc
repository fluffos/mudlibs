// stoneroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "书房门口");
	set("long", @LONG
这是一间书房的门口，从大屋子的另一段无法看到这里，若非有老
苍头带道，估计平常人根本无法到达这里。
LONG
	);
	set("knock", 1);
	set("exits", ([
		"east": __DIR__"stoneroom6",
		"south":  __DIR__"stoneroom4",
	]) );

	setup();
}
