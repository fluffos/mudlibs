// inn_2f.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "快活林");
	set("long", @LONG
快活林在卞梁与街对面的狮子楼齐名，但两家饭庄在生意上是死对
头，总希望能压倒对方，尽管如此，由于卞梁城过往人密，两家饭庄的
生意都非常红火，整天里豪客如云，吆三喝四之声不绝于耳。西面墙上
挂着宴席的菜单（ｓｉｇｎ）。
LONG
        );
	set("exits", ([
		"east": __DIR__"sroad2" ]) );
	set("item_desc", ([
		"sign": @TEXT
快活林目前提供（ｏｒｄｅｒ）的菜单有：

白玉硫璃丸子    （白银十两）
雪中送炭	（白银十两）
水晶虾仁	（白银十两）
东坡肉		（白银十两）
炝虎尾		（白银十两）
烩驼峰		（白银十两）
鱼翅羹		（白银十两）
燕窝汤		（白银十两）

TEXT
        ]) );
	set("objects", ([
                __DIR__"npc/hinn-waiter" : 1 ]));
	set("no_fight", 1);
	setup();
}

int valid_leave(object me, string dir)
{
	object ob;
	int price, val, vall;
	string msg;

	if((price = me->query_temp("hinn")) 
	&& (ob = present("waiter", this_object())))
	{
		msg = "$N笑咪咪地说道：这位" + RANK_D->query_respect(me)
			+ "，您点了菜，还没付帐呢！一共";
		if(val = price / 100)
		{
			if(vall = price % 100)
				message_vision(msg + chinese_number(val) 
						+ "两银子零"
						+ chinese_number(vall) 
						+ "文钱！\n", ob);
			else
				message_vision(msg + chinese_number(val)
						+ "两银子！\n", ob);
		} else if(vall = price % 100)
			message_vision(msg + chinese_number(vall)
					+ "文钱！\n", ob);
		return notify_fail("");
	}
	return 1;
}
