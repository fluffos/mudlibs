// pingroom.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "银瓶斋");
        set("long", @LONG
银瓶斋是香君楼才女李瓶儿所居之处，四壁挂着名人书画墨迹，皆
为汴梁城中风流才子所送。屋中央置矮几一张，几上摆着一盘未完的残
局，棋盘边上一只铜角香炉，里面几只熏香缭绕，使得整个屋子平曾几
分雅意。
LONG
        );
        set("exits", ([
                "west": __DIR__"jiyuan3", 
        ]) );

        set("objects", ([
                __DIR__"npc/ping" : 1,
        ]) );

        setup();
}
