// swroad.c

inherit ROOM;

void create()
{
	set("short", "五龙场");
	set("long", @LONG
五龙场是壮元巷与平安大街两条街的交接之处，位于汴梁城的西北
面。
LONG
	);
	set("exits", ([
		"south": __DIR__"nwroad2",
		"east": __DIR__"proad",
	]));
	set("objects", ([
                __DIR__"npc/hero1" : 1,
                __DIR__"npc/hero2" : 1,
        ]));

	setup();
}
