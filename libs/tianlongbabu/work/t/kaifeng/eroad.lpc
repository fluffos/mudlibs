// eroad.c

inherit ROOM;

void create()
{
	set("short", "汴梁东大街");
	set("long", @LONG
汴梁东大街为官府衙门的所在，各府各卿，方面大员都在这里进出。
大街南面是朝廷贡院，各路赶考的举子都汇聚于此。
LONG
	);
	set("exits", ([
		"west" : __DIR__"center",
		"east" : __DIR__"eroad2",
		"south": __DIR__"gongyuan",
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
