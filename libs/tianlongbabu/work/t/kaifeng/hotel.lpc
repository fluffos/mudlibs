// hotel.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "天朝宾馆");
	set("long", @LONG
大宋朝疆土广大，邻国北有金国，大辽，西有西夏，土藩，南有大
理，安南。除南边的几个邻国外，其它的国家对大宋朝的花花世界早已
虎视眈眈，不时派潜使臣前往卞梁打探消息，这天朝宾馆便是供这些使
臣下塌的场所。
LONG
	);

	set("exits", ([
		"north"	: __DIR__"wroad2" ]) );

	set("objects", ([
		__DIR__"npc/shichen" : 1 ]) );

	setup();
}
