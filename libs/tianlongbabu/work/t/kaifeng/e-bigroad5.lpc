// e-bigroad3.c

inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨垂
柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("exits", ([
		"west": __DIR__"e-bigroad4",
		"north": "/t/taiyue/ta-road2",
		"northeast": __DIR__"e-bigroad6",
	]));
	set("no_clean_up", 0);

	setup();
}
