// e-bigroad2.c

inherit ROOM;

void create()
{
	set("short", "黄土大道");
	set("long", @LONG
黄土大道是大宋朝的主要干道，路面居由黄土铺成，路两边绿杨垂
柳。大道上车轮滚滚，人来人往，络绎不绝。
LONG
	);
	set("exits", ([
		"north": __DIR__"s-bigroad",
		"south": __DIR__"s-bigroad3",
	]));
	set("no_clean_up", 0);

	setup();
}

int valid_leave(object me, string dir) 
{
	//int i;

	if(dir == "south")
	{
//		if(random(10) < 2)
		{
			set("exits/south", __DIR__"s-bigroad3");
			return 1;
		}
		set("exits/south", __DIR__"s-bigroad2");
		return 1;
	}
	if(dir == "north")
        {
//                if(random(10) < 2)
                {
                        set("exits/north", __DIR__"s-bigroad");
                        return 1;
                }
                set("exits/north", __DIR__"s-bigroad2");
                return 1;
        }
}

