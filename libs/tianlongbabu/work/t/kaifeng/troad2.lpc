// troad.c

inherit ROOM;

void create()
{
	set("short", "铁匠营");
	set("long", @LONG
仁宗年间，北方大辽国来犯，仁宗皇帝下旨尽招河南道的铁匠于此
结营，日夜打造武器兵刃。大辽退后，铁匠们又尽散回原籍，然而铁匠
营的名字却就此留了下来。
LONG
	);
	set("exits", ([
		"west": __DIR__"troad",
		"east": __DIR__"secenter",
		"south": __DIR__"ironshop",
		"north": __DIR__"store",
	]));
	set("objects", ([
                __DIR__"npc/niu" : 1,
        ]) );
	setup();
}

int valid_leave(object me, string dir)
{
	object ob;
	if(me->query_temp("marks/牛二"))
	{
		if(ob = present("niu", this_object()))
		{
			message_vision("$N对$n叫道：有种的跟大爷比化比化，"
				+ "不然得把你的兵刃留下！\n", ob, me);
			return notify_fail("");
		}
		me->delete_temp("marks/牛二");
		return 1;
	}
	return 1;
}
