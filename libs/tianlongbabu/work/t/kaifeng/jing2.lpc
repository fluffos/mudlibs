// jing.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "井底隧道");
	set("long", @LONG
井底隧道里居然有了一丝亮光，看东西比在井底要清楚一些。北边
好象有道门，亮光便是由门缝里传来。那道门入手冰冷，竟然生铁打造，
门上有一只大铁锁。
LONG
	);
	set("unlocked", 0);
	set("exits", ([
		"north": __DIR__"jing3",
	]) );

	set("hide_exits", ([
		"east" : __DIR__"jing",
	]));

	set("item_desc", ([
		"铁锁" : @TEXT
铁锁由整块生铁铸成，没有钥匙甭想将它打开（ｕｎｌｏｃｋ）。

TEXT
	]) );

	create_door("north", "铁门", "south", DOOR_CLOSED);

	setup();
}

void init()
{
        add_action("do_unlock", "unlock");
}

int do_unlock(string arg)
{
	int i;
	object *inv, me;

	if(!arg || arg != "铁锁") return 0;

	me = this_player();
	inv = all_inventory(me);
	for(i=0;i<sizeof(inv);i++)
	{
		if(inv[i]->name() == "铜钥匙" && inv[i]->query("id")=="key")
		{
			message_vision("$N将铜钥匙插入铁锁中一转，铁锁"
					+ "被打开了！\n", me);
			set("unlocked", 1);
			return 1;
		}
	}
	return 0;
}

int open_door(string dir, int from_other_side)
{
        if(!query("unlocked"))
                return notify_fail("铁门是锁住的，无法打开。\n");
        ::open_door(dir, from_other_side);
	return 1;
}
