// jing.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "密室");
	set("long", @LONG
这密室是金刀镖局平时收藏红货重镖的地方，只有镖局里的几个重
要人物知道这里。密室的墙上点着盏小油灯，借着灯光可以看出，这井
底的密室非但不是想象中潮湿，相反却很干燥，而且布置非常舒适，只
是暂时没有什么红货存在这儿。
LONG
	);
	set("unlocked", 0);
	set("no_fight", 1);
	set("exits", ([
		"south": __DIR__"jing2",
	]) );
	set("objects", ([
		__DIR__"npc/wang2" : 1,
	]));

	create_door("south", "铁门", "north", DOOR_CLOSED);

	setup();
}
