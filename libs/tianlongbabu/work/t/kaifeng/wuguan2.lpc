// wuguan2.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "走道");
	set("long", @LONG
这里是腾龙武馆的走道，左右两边都是练武场，吆喝与刀剑碰撞的
声音便是从那里传来的。
LONG
	);
	set("exits", ([
		"north": __DIR__"wuguan3",
		"south" : __DIR__"wuguan4",
		"east" : __DIR__"wuguan5",
		"west" : __DIR__"wuguan",
	]));

	setup();
	replace_program(ROOM);
}
