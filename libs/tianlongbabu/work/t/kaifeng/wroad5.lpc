// wroad5.c

inherit ROOM;

void create()
{
	set("short", "汴梁西大街");
	set("long", @LONG
汴梁西大街多为达官贵人所居之处，因此没有太多得喧嚣吵闹之声。
再往西走便是汴梁城的西门了。
LONG
	);
	set("exits", ([ 
		"west": __DIR__"wgate",
		"east": __DIR__"wroad4",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
