// school.c

inherit ROOM;

void create()
{
	set("short", "私塾");
	set("long", @LONG
这家私塾并没能因为壮元巷的名头而发达，只有一个昏老的先生带
着几个蒙童在这混日子。
LONG
	);
	set("exits", ([
		"east": __DIR__"nwroad2",
	]));
	set("objects", ([
                __DIR__"npc/teacher" : 1,
        ]) );
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
