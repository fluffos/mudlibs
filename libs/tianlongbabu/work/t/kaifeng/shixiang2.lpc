// shixiang.c

inherit ROOM;

void create()
{
	set("short", "青石巷尾");
	set("long", @LONG
这青石巷是个死胡同，这里就是巷尾了。巷尾两侧是高大的青石墙，
好象是大户人家的房子，只是墙头上长满了野草，随风摇动。
LONG
	);
	set("exits", ([
		"west": __DIR__"shixiang",
	]));
	set("no_clean_up", 0);

	setup();
}
