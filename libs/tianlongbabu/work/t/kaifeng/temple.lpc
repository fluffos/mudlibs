#include <obj.h>

inherit ROOM;

void create()
{
	set("short", "城隍庙");
	set("long", @LONG
这是一间十分老旧的土地庙，城隍的神像已经斑驳不勘，只是那被香
火薰成乌黑颜色的神案还能让人想起它当年的辉煌。
LONG
	);
	set("exits", ([
		"north": __DIR__"eroad5",
	]));
	set("no_fight", "1");
	set("objects", ([
		__DIR__"npc/keeper" : 1,
	]));

	setup();
}
