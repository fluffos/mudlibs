// biaoju.c

inherit ROOM;

void create()
{
	set("short", "镖局内院");
	set("long", @LONG
这里是金刀镖局的内院，院中此时静悄悄的，与外面镖局大院相比，
安静的有点儿出奇。院里种着颗大槐树，树下有一口水井，青石做的井
台上长着许多青苔，好象很少有人用。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"south": __DIR__"biaoju3",
		"west" : __DIR__"biaoju5",
		"east" : __DIR__"biaoju6",
	]));
	set("objects", ([ /* sizeof() == 1 */
                __DIR__"obj/jing" : 1,
		__DIR__"npc/wang" : 1,
        ]));

	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	int i;
	object me, *inv, jing;

	if(!arg || arg != "down") return 0;

	jing = present("jing", this_object());
	if(jing)
	{
		inv = all_inventory(jing);
		for(i=0;i<sizeof(inv);i++)
		{
			if(inv[i]->query("climbable"))
			{
				me = this_player();
				message_vision("$N顺着" + inv[i]->name(1)
					+ "慢慢往井下爬去。\n\n",me);
				call_out("move_him", 2, me);
				return 1;
			}
			if(!userp(inv[i])) destruct(inv[i]);
		}
	}
	return 1;
}

void move_him(object ob)
{
	tell_object(ob, "井下一片黑暗，你只能摸索着前进．．．\n\n", ob);
	call_out("arrive", 2, ob);
}

void arrive(object ob)
{
	tell_object(ob, "过了片刻，你终于爬到了井底。\n\n", ob);
	ob->move("/t/kaifeng/jing");
	message("vision", "有人从井上爬了下来。\n", environment(ob), ob);
}
	
