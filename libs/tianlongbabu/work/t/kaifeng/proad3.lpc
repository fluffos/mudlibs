// proad.c

inherit ROOM;

void create()
{
	set("short", "平安大街");
	set("long", @LONG
平安大街位于汴梁城北，整条大街横贯开封北城。大街两旁绿树
垂阴，环境十分安宁。大街南面是瘦西湖，往北便是汴梁城的北大街
了。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"west" : __DIR__"proad2",
		"east" : __DIR__"proad4",
		"north": __DIR__"nroad",
		"south": __DIR__"lake",
	]));
	set("objects", ([
                __DIR__"npc/xunbu" : 1,
		__DIR__"npc/rong" : 1,
        ]) );
	set("no_clean_up", 0);

	setup();
}
