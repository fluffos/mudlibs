// yroad.c

inherit ROOM;

void create()
{
	set("short", "杨花巷");
	set("long", @LONG
杨花巷是汴梁城中有名的去处，吃喝玩乐样样俱备，所以有钱的没
钱的都喜欢到这里来凑热闹，巷子北面是红娘庄，南面是汴梁城中鼎鼎
有名的香君楼，从那里不时可以听到丝竹管弦之声。
LONG
	);
	set("exits", ([
		"north": __DIR__"marry_room",
		"south": __DIR__"jiyuan",
		"west": __DIR__"swcenter",
		"east": __DIR__"yroad",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
