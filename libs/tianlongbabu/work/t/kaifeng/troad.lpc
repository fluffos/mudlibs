// troad.c

inherit ROOM;

void create()
{
	set("short", "铁匠营");
	set("long", @LONG
仁宗年间，北方大辽国来犯，仁宗皇帝下旨尽招河南道的铁匠于此
结营，日夜打造武器兵刃。大辽退后，铁匠们又尽散回原籍，然而铁匠
营的名字却就此留了下来。
LONG
	);
	set("exits", ([
		"west": __DIR__"sroad3",
		"east": __DIR__"troad2",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
