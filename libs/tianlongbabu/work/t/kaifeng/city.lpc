// city.c

inherit ROOM;

void create()
{
	set("short", "禁城");
	set("long", @LONG
禁城金瓦红墙，规模宏大。周围一圈高大的城墙将禁城与外界隔开，
这里由卞梁禁军把守，戒备森严，寻常百姓不得在此逗留，只有朝中百
官不时从这进进出出。
LONG
	);
	set("exits", ([
		"south": __DIR__"center",
	]));
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/garrison": 2]));

	setup();
}
