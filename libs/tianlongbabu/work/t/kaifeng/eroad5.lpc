// wroad5.c

inherit ROOM;

void create()
{
	set("short", "汴梁东大街");
	set("long", @LONG
汴梁东大街为官府衙门的所在，各府各卿，方面大员都在这里进出。
再往东走便是汴梁城的东门了。南面是一个城隍庙。
LONG
	);
	set("exits", ([
		"west": __DIR__"eroad4",
		"east": __DIR__"egate",
//                 "south" :__DIR__"temple",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
