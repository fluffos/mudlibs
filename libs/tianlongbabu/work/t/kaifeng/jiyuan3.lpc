// jiyuan2.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "香君楼二楼走廊");
	set("long", @LONG
香君楼二楼是姑娘们陪客人们饮酒品茗，吟诗作赋的地方，甚是幽
雅。走廊的左边是「香莲居」，右边是「银瓶斋」。
LONG
        );
        set("exits", ([
                "down" : __DIR__"jiyuan",
		"north": __DIR__"jiyuan2",
		"west" : __DIR__"lianroom",
		"east" : __DIR__"pingroom",
	]) );

        setup();
}
