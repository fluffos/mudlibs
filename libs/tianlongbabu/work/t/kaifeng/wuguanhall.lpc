// schoolhall.c

inherit ROOM;

void create()
{
	set("short", "武馆大厅");
	set("long", @LONG
这里是腾龙武馆的正厅，五张太师椅一字排开面对著门口，这是武
馆中四位大师傅与馆主萧秋雨的座位，和一般武馆不同的是，墙上竟然
挂著几幅风骨颇为不俗的书画，显示这里的主人并非大字不识的粗汉，
而是文武双全的高人。
LONG
	);
	set("exits", ([
		"west" : __DIR__"wuguan5",
	]));
	set("objects", ([
		CLASS_D("trainer") + "/master":1 ]) );

	set("valid_startroom", 1);
	setup();
}
