// Room: /t/kaifeng/sgate.c

inherit ROOM;

void create()
{
	set("short", "聚宝门");
	set("long", @LONG
这是汴梁城的南门，传说南门外的护城河里曾经出过妖怪，闹得人
心惶惶，正好有一游方道士路过于此，说此妖须得用大财福方能镇住，
于是汴梁城中的富人们纷纷将家里的金银珠宝聚集于此，妖怪不知有无
镇住，但此门却因此而得名－聚宝门。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  		"south" : __DIR__"s-bigroad",
  		"north" : __DIR__"sroad5",
]));
	set("objects", ([ /* sizeof() == 1 */
  		__DIR__"npc/garrison" : 2,
]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
