// last update by cbra Jun-18-1998 for acopy

#include <ansi.h>
inherit ITEM;

// the order of the following to string* is very important. please change both if you need.
string*    load_db=( {  
                        "/t/kaifeng/inn",
                        "/t/dali/tea",
                        "/t/dali/fight",
                        "/t/juxian/fight",
                        "/t/tianshan/hall",
                        "/t/yipin/caoting",
                        "/t/xueshan/dadian",
                        "/t/penglai/hotel",
                        "/t/dengfeng/hotel",
			"/t/ly/dak",
			"/t/ly/phome/playerroom",
			"/t/ly/marryroom",
                        "/t/wizroom",
			"/t/wiz/entrance",
                        "/t/wiz/jobroom",
                   } );

string*    board_db=( { 
                        "/obj/board/common_b.c",
                        "/obj/board/dali_b.c",
                        "/obj/board/fight_b.c",
                        "/obj/board/hero_b.c",
                        "/obj/board/ljg_b.c",
                        "/obj/board/killer_b.c",
                        "/obj/board/lama_b.c",
                        "/obj/board/penglai_b.c",
                        "/obj/board/shaolin_b.c",
			"/obj/board/ly_b.c",
			"/obj/board/player_b.c",
			"/obj/board/marry_b.c",
                        "/obj/board/wiz_b.c",
			"/obj/board/query_b.c",
                        "/obj/board/wizard_j.c",
                    }  );

void load_board(int arg);
int valid_board();

void create()
{
        set_name(BLU"留言板集"NOR, ({ "allboard","a" }) );     
        set("no_get", 1);
//        set("no_drop",1);
        set("unit","个");
        set("base_unit","个");
}

void init()
{
	if( wizardp(this_player()) ) {
		add_action("do_post", "apost");
		add_action("do_read", "aread");
		add_action("do_discard", "adiscard");
		add_action("do_list", "alist");
		add_action("do_reverse_list", "rlist");
		add_action("do_select", "chose");
		add_action("do_acopy", "acopy");
//		add_action("do_atrans", "atrans");
	}
}

string long()
{	
	int i,j;
	string msg;
	int boardname;
	boardname=valid_board();
	msg=CYN"──────────────────────\n"
	    RED"指令："NOR+"chose,alist,rlist,aread,adiscard,apost,acopy.\n"+
	    BLU"请先选择你要读的留言板。\n"NOR;
	for(i=0; i<sizeof(board_db); i++) {
		j=i+1;
		load_board(j);
		msg += sprintf(" %s %-2d.  %s\n", (boardname==j) ? "*":" ",
		j,board_db[i]->short());		
	}
	return msg;	
}

int do_select(string arg)
{
        string msg;
        int boardname;
          if (!arg) boardname=valid_board();
	else {
		boardname=atoi(arg);
		if ((boardname <= 0) || (boardname>sizeof(board_db)) )
			boardname = 0;
        }
	if (!boardname) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
        this_user()->set_temp("allboard", boardname);
        load_board(boardname);
        msg = board_db[boardname-1]->short();
	write(BLU"你选择留言板： "NOR+msg+"\n");
        return 1;
}

int do_list()
{
	string msg;
	int boardname;
	if (! (boardname=valid_board()) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
	load_board(boardname);
	msg = board_db[boardname-1]->long(11);
	this_user()->start_more(msg);
	return 1;
}

int do_reverse_list()
{
	string msg;
	int boardname;
	if (! (boardname=valid_board()) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
	load_board(boardname);
	msg = board_db[boardname-1]->long(0);
	this_user()->start_more(msg);
	return 1;
}

int do_post(string arg)
{
	int boardname;
	if (! (boardname=valid_board()) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
	load_board(boardname);
	return board_db[boardname-1]->do_post(arg);
}

int do_read(string arg)
{
	int boardname;
	if (! (boardname=valid_board()) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
	load_board(boardname);
	return board_db[boardname-1]->do_read(arg);
}

int do_discard(string arg)
{
	int boardname;
	if (! (boardname=valid_board()) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}
	load_board(boardname);
	return board_db[boardname-1]->do_discard(arg);
}

void load_board(int arg)
{
	int err;
	seteuid(getuid(this_user()));
        if( !find_object(load_db[arg-1]) ) {
        //        write("loading...");
                err = catch(call_other(load_db[arg-1], "??"));
                if (err) write(sprintf("%s error.\n",arg));
	}
}

int query_autoload() {
        return 1;
}

int valid_board()
{
	int boardname;
	//boardname=atoi(this_user()->query_temp("allboard"));
	boardname=this_user()->query_temp("allboard");
	if ((boardname <= 0) || (boardname > sizeof(board_db))) return 0;
	return boardname;
}

int do_acopy(string arg)
{
	int num, boardname, newboard;
	mapping note;

	if ((!arg) || (sscanf(arg, "%d %d", num, newboard) != 2 )) {
		write(RED"acopy board-notenumber new-boardnumber.\n"NOR);
		return 2;
	}

	if ( (!(boardname=valid_board())) || (newboard <= 0) || 
	     (newboard > sizeof(board_db)) || (boardname == newboard) ) {
		write (BLU"请选择正确的留言板。\n"NOR);
		return 2;
	}

	load_board(boardname);
	load_board(newboard);

	note = board_db[boardname-1]->query_note(num);
	if (!mapp(note)) {
		write("没有这张留言。\n");
		return 2;
	}

	board_db[newboard-1]->add_note(note);
	write(board_db[boardname-1]->name()+" message "+
		num + " copy to " + board_db[newboard-1]->name()+".\n" );
	return 1;
}

