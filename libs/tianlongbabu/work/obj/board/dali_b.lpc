// dali_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("相思石", ({ "stone" }) );
        set("location", "/t/dali/tea");
        set("board_id", "dali_stone");
        set("long",     "这是一个供大理区域留言记事的留言板。\n" );
        setup();
	set("capacity", 1000);
        replace_program(BULLETIN_BOARD);
}

