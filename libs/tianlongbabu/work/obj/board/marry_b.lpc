// marry_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name(MAG"姻缘薄"NOR, ({ "board" }) );
        set("location", "/t/ly/marryroom");
        set("board_id", "marry_b");
        set("long",     "前世姻缘，后世良缘。\n祝有情人终成眷属！\n" );
	set("allowed_post", 1);
        setup();
        set("capacity", 500);

        replace_program(BULLETIN_BOARD);
}

