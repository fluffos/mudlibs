// wiz_b.c

//inherit BULLETIN_BOARD;
inherit "/std/bboard";

void create()
{
	set_name("巫师留言板", ({ "board" }) );
	set("location", "/t/wizroom");
	set("board_id", "wiz_b");
	set("long",
