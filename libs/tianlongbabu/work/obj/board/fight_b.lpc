// fight_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("英雄榜", ({ "board" }) );
        set("location", "/t/dali/fight");
        set("board_id", "dali_fight_board");
        set("long",     "这是一块记录武林盛事的英雄榜。\n" );
	set("allowed_post", 1);
        setup();
        set("capacity", 200);

        replace_program(BULLETIN_BOARD);
}
