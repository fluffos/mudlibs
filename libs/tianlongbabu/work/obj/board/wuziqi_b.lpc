// obj/wuziqi_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("白玉碑", ({ "bei","board" }) );
	set("location", "/t/dali/qishi");
	set("board_id", "wuziqi_b");
	set("long",     "这是一块用汉白玉做的石碑，上面刻着当年天龙的五子棋高手们的胜败记录。\n" );
	setup();
	set("capacity", 500);
	replace_program(BULLETIN_BOARD);
}
