// player_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name("『泥潭情深』留言板", ({ "mud board","board" }) );
        set("location", "/t/wiz/playerroom");
        set("board_id", "player_b");
        set("long",     
        "这是一个专供玩家抒发感情的留言板。你想写什么都可以，但不要\n"
        "涉及政治、色情内容，也不要转载一些篇幅过长的文章。\n"
        "相关指令：\n"
        "post <标题>    开始留言，你必须指定标题。\n"
        ".              留言结束。(英文标点“.”)\n"
        "read <编号>    阅读指定编号的留言。\n"
        "read new       阅读你未读过的留言。\n"
        "discard <编号> 删除指定编号的留言，你只能删除自己写的留言。\n" );
        setup();
        set("capacity", 1000);
        replace_program(BULLETIN_BOARD);
}

