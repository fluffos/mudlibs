// ljg_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("见闻录", ({ "board" }) );
        set("location", "/t/xiaoyao/chaguan");
        set("board_id", "jianwenlu");
        set("long",     "这是一有些残旧的见闻录。\n" );
        setup();
        set("capacity", 500);
        replace_program(BULLETIN_BOARD);
}


