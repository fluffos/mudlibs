// board.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("不醉无归小客栈题词板", ({ "board" }) );
          set("location", "/t/penglai/hotel");
        set("board_id", "penglai_board");
        set("long",     "各位过客醉留墨宝于蓬莱岛。\n" );
        setup();
        set("capacity", 500);
        replace_program(BULLETIN_BOARD);
}

