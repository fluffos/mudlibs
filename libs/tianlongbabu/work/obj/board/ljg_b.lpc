// ljg_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("仙客来", ({ "board" }) );
        set("location", "/t/tianshan/hall");
        set("board_id", "lingjiugong_stone");
        set("long",     "这是一个供灵鹫宫来访客人记事的留言板。\n" );
        setup();
        set("capacity", 500);
        replace_program(BULLETIN_BOARD);
}


