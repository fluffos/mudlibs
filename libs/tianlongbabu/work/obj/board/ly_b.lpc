// ly_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name("古城风云", ({ "board" }) );
        set("location", "/t/ly/dak");
        set("board_id", "ly_b");
        set("long",     "这是一个留言板。有关留言指令请阅读help board。\n" );
        setup();
        set("capacity", 500);
        replace_program(BULLETIN_BOARD);
}
