// common_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("聚贤庄英雄榜", ({ "board" }) );
	set("location", "/t/juxian/fight");
	set("board_id", "hero_b");
	set("long",     "这是聚贤庄比武场记录胜败的英雄榜。\n" );
	setup();
	set("capacity", 500);
	replace_program(BULLETIN_BOARD);
}
