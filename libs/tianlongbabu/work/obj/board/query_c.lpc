// query_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("意见反应留言板.请不要在这里写与主题无关的留言！", ({ "board" }) );
	set("location", "/t/wiz/entrance");
	set("board_id", "query_b");
	set("long",	"这是一个供人留言记事的留言板。请不要在这里写与主题无关的留言！\n" );
	setup();
        set("capacity", 1000);
	replace_program(BULLETIN_BOARD);
}
