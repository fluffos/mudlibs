// fighter_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("杀手留言牌", ({ "board" }) );
	set("location", "/t/yipin/caoting");
	set("board_id", "killer_b");
	set("long", "这是杀手们留言记事的留言牌。\n" );
	setup();
	set("capacity", 500);
	replace_program(BULLETIN_BOARD);
}
