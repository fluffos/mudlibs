// shaolin_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("旅途见闻录", ({ "board" }) );
	set("location", "/t/dengfeng/hotel");
	set("board_id", "shaolin_b");
	set("long",
		"这是一个供人留言记事的留言板。\n" );
	setup();
	set("capacity", 500);
	replace_program(BULLETIN_BOARD);
}
