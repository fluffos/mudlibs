// ghost_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;
void create()
{
        set_name(HIW"『生死薄』"NOR, ({ "ghost board","board" }) );
        set("location", "/t/death/inn1");
        set("board_id", "ghost_b");
        set("long",     
        WHT"生不带来，死不带去\n"
        "一生牵挂，两世轮回\n"NOR
        "相关指令：\n"
        "post <标题>    开始留言，你必须指定标题。\n"
        ".              留言结束。(英文标点“.”)\n"
        "read <编号>    阅读指定编号的留言。\n"
        "read new       阅读你未读过的留言。\n"
        "discard <编号> 删除指定编号的留言，你只能删除自己写的留言。\n" );
        setup();
        set("capacity", 400);
        replace_program(BULLETIN_BOARD);
}

