// web_login.c
// create by windf Sep-14-1998

#include <login.h>
#include <user.h>
#include <dbase.h>

inherit F_DBASE;
inherit F_SAVE;

// This is used by F_SAVE to determinethe file name to save our data.
string query_save_file()
{
	string id;

	id = query("id", 1);
	if( !stringp(id) ) return 0;
	return sprintf(DATA_DIR "player/login/%c/%s", id[0], id);
}
