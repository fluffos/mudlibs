// niangao.c
// last_update 4.2.1997 jane

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("年糕", ({ "niangao" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "大年糕\n");
                set("unit", "块");
		set("value", 50000);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();

        if( !arg ) return notify_fail("你要吃什麽？\n");
	if ( !(arg == "niangao") ) return notify_fail("你要吃什麽？\n");
	me->set("food", random(500)+500);
	me->set("water", random(500)+500);
        message_vision("$N拿起年糕吃了下去，顿时觉得肚子里胀得难受。\n", this_player());

	destruct(this_object());
	return 1;
}
