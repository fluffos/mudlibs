// mooncake.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	string* mooncake = 	({ "五仁月饼", "椰蓉月饼", "金腿月饼", "莲蓉月饼",
				"双黄月饼", "豆沙月饼","枣泥月饼",
				});

	set_name( mooncake[random(sizeof(mooncake))], ({ "mooncake","moon cake" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块香喷喷的月饼。\n");
		set("unit", "块");
		set("value", 100);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
