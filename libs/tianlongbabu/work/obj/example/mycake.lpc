// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("生日蛋糕", ({ "cake" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块生日蛋糕。\n");
		set("unit", "块");
		set("value", 15);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
