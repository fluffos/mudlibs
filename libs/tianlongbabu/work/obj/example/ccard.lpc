// dan.c
// last_update 4.2.1997 windf

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("圣诞卡",({ "card" }) );
	set_weight(30);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "圣诞卡");
                set("unit", "张");
		set("value", 10000+random(500));
	}
}

void init()
{
	add_action("do_look", "look");
}

int do_look(string arg)
{
	object me = this_player();

        if( !arg ) return 0;
	if ( !(arg == "card") ) return 0;
	printf( @LONG
                 ...   *    *     祝%s圣诞节快乐    *    *   ...
                   ...              .........      *
                     ..                 ......       *
             ☆       ..       ☆                   *
                    __##____             *            |    ★
           *    *  /  ##  ****              ★       -*-
                  /        ****                    *  X   *
         ★      /        ******     *               XXX      *
                /___________*****       ☆          XXXXX
                 |            ***          *       XXXXXXX   X
           *     | ■■  ___  | *      *         XXXXXXXXXXXXXXX
                 | ■■  | |  ****          *         X   XXXXXXX
             *********** | | *******      *           X      X
LONG , me->name()
);
	return 1;
}
