// dan.c
// last_update 4.2.1997 windf

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("小还丹", ({ "dan" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一粒俱有神效的小还丹。\n");
                set("unit", "粒");
		set("value", 0);
//		set("food_remaining", 3);
//		set("food_supply", 60);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();
	int jin, qi, shen, linli, neili, fali, shiwu, yinshui;

        if( !arg ) return notify_fail("你要吃什麽？\n");
	if ( !(arg == "dan") ) return notify_fail("你要吃什麽？\n");
	jin = me->query("max_gin");
	qi =me->query("max_kee");
	linli = me->query("max_atman");
	neili = me->query("max_force");
	shiwu = me->max_food_capacity();
	yinshui = me->max_water_capacity();
        me->set("eff_gin", jin);
        me->set("eff_kee", qi);
	me->set("gin", jin);
	me->set("kee", qi);
	me->set("atman", linli);
	me->set("force", neili);
	me->set("food", shiwu);
	me->set("water", yinshui);
        message_vision("$N拿起一粒小还丹迫不急待地吞了下去，顿时觉得精力充沛。\n", this_player());

//	write ( (string)shen + (string)qi + (string)jin + "\n");
	destruct(this_object());
	return 1;
}
