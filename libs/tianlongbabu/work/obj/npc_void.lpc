// Room: /obj/void.c
// last update by cbra Jun-13-1998 for leave_command
// DO NOT ALLOW ANY PLAYER DO ANY COMMAND HERE !!!!!!!!! CBRA
// which causes a lot of system holes. so do not remove leave_command

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", YEL"最後乐园"NOR);
	set("long", 
/*
BLU"这里就是传说中的ＶＯＩＤ－－大神和巫师的最後乐园。你看到四周一\n"+
"片白茫茫的，不一会从虚无中冒出一只企鹅，递给你一罐「可口可乐」，然\n"+
"後站在一旁很邪恶地笑著。又过了一会，一只北极熊走了过来，一掌拍扁了\n"+
"那只企鹅并从你手上抢走那瓶可乐，大笑三声後就从你眼前消失了。你摇摇\n"+
"头，这种地方还是不要待太久的好。\n"NOR
*/
BLU"这里就是传说中的ＶＯＩＤ－－大神和巫师的最後乐园。你看到有人正\n"+
"在伏案工作，两只手不停地敲击着键盘，耳朵里各塞了一个棉花球，以免外\n"+
"面的牢骚干扰了他正常的工作。背后一大箱方便面，小媒炉上正冒着水汽。\n"NOR
	);
	set("exits", ([ /* sizeof() == 1 */
  "up" : "/t/dali/cross",
]));

	set("no_clean_up", 0);

	setup();
}

void init()
{
        add_action("leave_command","",1);
	call_out("myclean",3);
}

int myclean()
{
	object a;
        object* inv;

        inv = filter(all_inventory(),
                (: (!userp($1)) && ($1->is_character()) :) );

        foreach(a in inv)
                if (!sizeof(filter(deep_inventory(a), (: userp($1) :) )))
                        destruct(a);
	return 1;
}

int leave_command(string start)
{
	object me;

	start=query_verb();
	if ( (start=="look") || (start=="look_brief") ) return 0;
	if ( (start=="quit") || (start=="dumpquit") ) return 0;
	me=this_user();
	// user move out, npc can do nothing
	if ( userp(me) && interactive(me) ) { // double check to make sure
		if (wizardp(me))	return 0; //wizard still can test in here
		if(me->is_ghost())
			me->reincarnate();
		start = me->query("startroom");
		if (stringp(start))
			me->move(start);
		else
			me->move("/t/dali/cross");
	}
	return 1;
}
