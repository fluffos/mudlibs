//new topten, created by mirr, June 1998
#include <ansi.h>

inherit ITEM;

// Used to control the output of the topten.
// field 0: the table to query, field 1: start position,
// field 2: the list number.
mixed print_fields=({ ({0,0,10}), ({0,10,10}), ({0,20,10}),
                      ({0,30,10}), ({0,40,10}), ({0,50,10}),
			 ({0,60,10}),({0,70,10}),({0,80,10}),
			({0,90,10}),
                      ({15,0,10}), ({16,0,10}),
                      ({1,0,10}), ({2,0,10}),({3,0,10}), ({4,0,10}),
                      ({5,0,10}), ({6,0,10}),({7,0,10}), ({8,0,10}),
                      ({9,0,10}), ({10,0,5}),({11,0,5}), ({12,0,3}),
                      ({13,0,5}), ({14,0,8}), ({17,0,10}) });

mixed title=({"十大高手排行榜","十一至二十名高手排行榜",
                "二十一至三十名高手排行榜",
                "三十一至四十名高手排行榜","四十一至五十名高手排行榜",
               "五十一至六十名排行榜","六十一至七十名排行榜",
		"七十一至八十名排行榜","八十一至九十名排行榜",
		"九十一至一百名排行榜",
                "少侠","年青高手",
                "大富翁","内功高手","老寿星","踏雪无痕",
                "神拳无敌","十大剑客","神州刀客","文化名人",
                "十大神偷","暗器名家","杖客","三板斧",
                "神鞭","八大锤","十大要犯"
 });

string printdate= NATURE_D->game_time();

void create();
void init();
int do_read(string arg);
void print_topten_help();
void print_topten(int item);

void create()
{
  set_name("新天龙八部排行榜",({ "ntopten" }));
  set_weight(800);
  set("unit","本");
  set("long","这是记载天龙八部江湖排行的书, 你可以用(read)来查阅.\n");
  set("value",10000);
  set("material","paper");
}

void init()
{
  add_action("do_read","read");
}

int do_read(string arg)
{
  int i,iswiz=0;
  int item=-1;

  if ( wizardp(this_player())) iswiz=1;
  if (!arg) {return 0;};
  if ((arg=="topten")||(arg=="新天龙八部排行榜")||(arg=="ntopten"))
    {
      print_topten_help();
      return 1;
    };
  if (arg[0]=='r')
    {
      sscanf(arg,"r%d",i);
      if ((i<=0)||(i>12))
	item=-1;
      else
	item=i-1;
    }
  else if (arg[0]=='p')
    {
      sscanf(arg,"p%d",i);
      if ((i<=0)||(i>16))
	item=-1;
      else if (i==1)
	item=0;
      else if ((i<16)||iswiz)
	item=i+10;
    };
  if (item==-1)
    return 0;
  else
    print_topten(item);
  return 1;
}

void print_topten_help()
{
  string str;
  int iswiz=0;
  
  if (wizardp(this_player())) iswiz=1;
  str="你翻开《天龙八部排行榜》，只见上面写着：\n"+
	"------------------------------------------------------------\n"+
	"上卷: 百名高手排行榜\n";
  write(str);
  str=HIB"第一章    十大高手排行榜  ------------------------  r1"NOR
+"\n"+HIB"第二章至第十章  十一至一百名 -----------------  r2-r10"NOR
+"\n"+HIB"第十一章  少侠 ----------------------------------- r11"NOR
+"\n"+HIB"第十二章  十大年青高手  -------------------------- r12"NOR          
+"\n";
  write(str);
  write("下卷: 特殊技能排行榜\n");
str= HIB"第一章    十大高手排行榜  ------------------------  p1"NOR
+"\n"+HIB"第二章    十大富翁排行榜  ------------------------  p2"NOR
+"\n"+HIB"第三章    十大内功高手  --------------------------  p3"NOR+"\n";
write(str);
str=  HIB"第四章    十大寿星排行榜  ------------------------  p4"NOR
+"\n"+HIB"第五章    踏雪无痕  ------------------------------  p5"NOR
+"\n"+HIB"第六章    神拳无敌  ------------------------------  p6"NOR
+"\n"+HIB"第七章    十大剑客  ------------------------------  p7"NOR
+"\n"+HIB"第八章    神州刀客  ------------------------------  p8"NOR+"\n";
write(str);
str=  HIB"第九章    文化名人  ------------------------------  p9"NOR
+"\n"+HIB"第十章    天下神偷  ------------------------------  p10"NOR
+"\n"+HIB"第十一章  暗器名家  ------------------------------  p11"NOR
+"\n"+HIB"第十二章  杖客  ----------------------------------  p12"NOR+"\n";
write(str);
str=  HIB"第十三章  三板斧  --------------------------------  p13"NOR
+"\n"+HIB"第十四章  神鞭  ----------------------------------  p14"NOR
+"\n"+HIB"第十五章  八大锤  --------------------------------  p15"NOR;
if (iswiz)
str+="\n"+HIB"第十六章  十大要犯 -------------------------------  p16"NOR;
str+="\n"+   "=======================================================\n";
write(str);
str=     "                  ----"+printdate+"出版\n"+
         "你要阅读哪一章?\n";
write(str);
}

void print_topten(int item)
{
  string str;
  int i,*pf;
  mapping *tl;
  mixed toplist;


  toplist=TOPTEN_D->query_topten();
  pf=print_fields[item];
  tl=toplist[pf[0]];
  str="你翻到";
  str+=(item<12)?"上":"下";
  str+="卷第";
  str+=(item<12)?chinese_number(item+1):chinese_number(item-10);
  str+="章\n『"+
	title[item]+"』,只见上面写着: \n\n";
  write(str);
  write("当今江湖排名如下: \n");
  write("----------------------------------------------\n");
  for (i=pf[1];i<pf[2]+pf[1];i++)
    {
      str="    "+HIY"第"+chinese_number(i+1)+"名 "NOR;
      if (!((i+1) % 10)&&(i>20)) str+="  ";
      str+=tl[i]["name"]+NOR"\n";
      write(str);
    };
  write("===============================================\n");
}
