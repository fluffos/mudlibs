int do_rset(string arg)
{
	string prop, str;
	mixed data;

	if( !arg || sscanf(arg, "%s %s", prop, str)!=2 )
		return notify_fail("指令格式：rset <房间属性> <属性内容>\n");

	if( sscanf(str, "%d", data)!=1 ) 
		data = filter_color(str);
	
	environment(this_player())->set(prop, data);
	write("Ok.\n");
	return 1;
}

int do_connect(string arg)
{
	mapping exits;
	string dir, file;

	if( !arg || sscanf(arg, "%s %s", dir, file)!=2 )
		return notify_fail("指令格式：connect <方向> <房间档名>\n");
	file = resolve_path(this_player()->query("cwd"), file);
	if(file_size(file + ".lpc") == -1)
		return notify_fail("找不到这个文件：( "+file + ".lpc" + " )！\n");
	exits = environment(this_player())->query("exits");
	if( mapp(exits) )
		exits[dir] = file;
	else
		environment(this_player())->set("exits", ([ dir: file ]) );
	write("连接成功。\n");
	return 1;
}

int do_decon(string dir)
{
	if( !dir)
		return notify_fail("指令格式：decon <方向>\n");
	if ((environment(this_player())->query("exits/" + dir))) {
		environment(this_player())->delete("exits/" + dir );
		write("清除出口：" + dir + ", OK.\n");
		return 1;
	    }
	write("没有" + dir + "这个出口啊。\n");
	return 1;
}

int do_setobj(string arg)
{
        mapping objs;
        string obj;
	int num;

        if( !arg || sscanf(arg, "%s %d", obj, num)!=2 )
                return notify_fail("指令格式：obj <NPC或OBJ> <数量>\n");

        obj = resolve_path(this_player()->query("cwd"), obj);
	if(!objectp(load_object(obj))) {
		write("找不到这样东西！\n");
		return 1;
	}

  	objs = environment(this_player())->query("objects");
	if (num > 0) {
        	if( mapp(objs) )
	                objs[obj] = num;
	        else
        		environment(this_player())->set("objects", ([ obj: num ]) );
	        write("这里放" + num + "个 " + obj + ",...Ok.\n");
	        return 1;
	}
	else {
		obj=replace_string(obj,"__DIR__",this_player()->query("cwd"));
        	if( mapp(objs) ) {
	                map_delete(objs,obj);
                	write("清除物件：" + obj + ", OK.\n");
		}
		return 1;
	}
}

int do_desc(string arg)
{
        mapping items;
        string item, describe;
	string *names;

        if( !arg )
                return notify_fail("指令格式：desc <名称> <描述>\n如<描述>空缺，则为清除该名称。\n");

	items = environment(this_player())->query("item_desc");
	if ( sscanf(arg, "%s %s", item, describe)!=2 ) {
	    if( mapp(items)) {
	    	names = keys(items);
		if(member_array(arg, names) == -1) 
		    return notify_fail("没有这个名称啊：" + arg + "\n");
		environment(this_player())->delete("item_desc/" + arg );
		return 1;
	    }
	    return notify_fail("没有这个名称啊：" + arg + "\n");
	}
	describe = filter_color(describe);
	describe = describe + "\n";
        if( mapp(items) )
                items[item] = describe;
        else
                environment(this_player())->set("item_desc", ([ item: describe ]) );
        write("当人们 look " + item + " 时会看到：\n" + describe + "\n");
        return 1;
}

int do_saveroom(string arg)
{
	object env;
	string str, *name, file;
	mapping prop;
	int i;

	env = environment(this_player());
	file = file_name(env) + ".lpc";
	str = "// Room: " + file + @ROOM_CODE


inherit ROOM;

void create()
{
ROOM_CODE
	;
	str += sprintf("\tset(\"short\", %O);\n", env->query("short") );
	str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long") );
	prop = env->query_entire_dbase();
	name = keys(prop);
	for(i=0; i<sizeof(name); i++) {
	    	if( member_array(name[i], special_props)!=-1 ) continue;
		str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]] );
	}
	str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

	// Replace current directory with __DIR__ macro to make relocatable code.
	i = strlen(file)-1;
	while( (i > 0) && (file[i]!='/')) i--;
	if( i>0 ) {
		write("目前目录：" + file[0..i] + " 以 __DIR__ 取代。\n");
		str = replace_string(str, "\"" + file[0..i], "__DIR__\"");
	}

	if( file_size(file)!=-1 ) {
		write("档案 " + file + " 已存在，"+RED"所有秘密都将消失！"NOR+"要删除旧档吗？[y/n]");
		input_to("save_room_file", file, str);
		return 1;
	}

	return save_room_file("y", file, str);
}

int save_room_file(string yn, string file, string str)
{
	if( strlen(yn)<1 || yn[0]!='y' ) return 1;

	rm(file);
	write("存档 " + file + "....");
	if( write_file(file, str) ) {
		write("Ok.\n");
		return 1;
	} else
		return notify_fail("你没有写入这个档案(" + file + ")的权利。\n");
}

string filter_color(string arg)
{
	arg = replace_string(arg, "\\n", "\n");
	arg = replace_string(arg, "\\t", "\t");
        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
        arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
	return arg;
}

void owner_is_killed() { destruct(this_object()); }
