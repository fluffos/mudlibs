#define RMK_VERSION "(v1.2)"
#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;
string filter_color(string);
string *special_props = ({
	"short", "long" });

int save_room_file(string yn, string file, string str);

void create()
{
	set_name("房间编辑器" + RMK_VERSION, ({ "roommaker", "maker" }) );
	set_weight(100);
	set("unit", "个" );
	set("long", @LONG
这是一个用来「快速」制造基本房间结构的工具，帮助时间不多或有严重 lag
的巫师利用线上输入制造简单的房间，不过如果你想提高自己区域房间的品质
，最好不要太依赖这个东西，你可以使用以下几个指令：

mkroom <房间档名> <in 或 out>
    in 表示 indoors(室内), out 表示 outdoors(室外), 或不写则表示其它.
    如漏写，将来可以用：rset indoors 1 来补上。造出一个「空」房间之後，
    你可以 goto 到这个房间用 rset 设定房间的叙述，变量与连接。

rset <房间属性> <属性内容>
    设定你目前所在房间的属性，如 rset short，rset long 等。
    用 to rset long 比较好(可以输入多行的long).
    颜色与 nick 一样，但不会自动加 $NOR$.
    如：rset resource/water 1, 设定为可灌水之处。

connect <方向> <房间档名>
    将你目前所在的房间连接一个出口到另一个房间。

decon <方向>
    清除你目前所在房间的某个出口。

setobj <NPC或OBJ> <数量>
    在你目前所在的房间加某个NPC或物件。(你应该 cd 在房间所在的子目录内！)
	如：setobj npc/waiter 1 
    <数量> 为零时清除这个物件。

desc <名称> <描述>
    在你目前所在的房间加某个词的说明。
	如：desc 大门 大门上写着：\n\t\t外人严禁入内。\n
    如<描述>空缺，则为清除该名称。

saveroom
    将你目前所在的房间存档。
LONG
	);
}

int query_autoload() { return 1; }

void init()
{
	if( wizardp(environment()) ) {
		seteuid(getuid(environment()));
		add_action("do_mkroom", "mkroom");
		add_action("do_rset", "rset");
		add_action("do_connect", "connect");
		add_action("do_decon", "decon");
		add_action("do_setobj", "setobj");
		add_action("do_desc", "desc");
		add_action("do_saveroom", "saveroom");
	}
}

