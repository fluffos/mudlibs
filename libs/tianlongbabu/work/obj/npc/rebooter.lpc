// demongorgon.c
// last updage by cbra May-10-1998 add autosave before reboot

#include <ansi.h>

inherit NPC;

void create()
{
	set_name( HIW "天龙判官" NOR, ({ "rebooter" }) );
	set("long",
		"专管系统启动的天龙判官，是天龙众叛官之一。\n");

	set("age", 65);
//	set("pursuer", 1);

	set("max_gin", 50000);
	set("max_kee", 50000);

	set("max_atman", 99999);
	set("atman", 99999);
	set("max_force", 50000);
	set("force", 50000);

	set("str", 100);
	set("cor", 100);
	set("int", 100);
	set("con", 100);
	set("per", 0);

	set("combat_exp", 5000000);

	set_skill("staff", 100);
	set_skill("unarmed", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);

	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/armor", 100);
	set_temp("apply/damage", 100);

	setup();

//	carry_object(__DIR__"obj/demon_staff")->wield();
}

void start_shutdown()
{
	if( geteuid(previous_object()) != ROOT_UID ) return;

	message("system",
		HIR "\n\t\t系统将于3分钟内重新启动，请注意！！\n\n" NOR,
		users() );
	call_out("countdown", 60, 3);
}

private void countdown(int min)
{
	min--;
	if( min ) {
		message("system",
			HIR "\n还有" + chinese_number(min) + "分钟的时间系统就要重新启动！！\n\n"
				"\t\t请尽快将自己的物品和钱财做妥善处理。\n\n" NOR,
			users() );
		call_out("countdown", 60, min);
	} else {
		call_out("do_shutdown", 3);
	}
}

private void do_shutdown()
{
	int i;
	object *user,link_ob;

	user = users();
	for(i=0; i<sizeof(user); i++) {
		if( !environment(user[i]) ) continue;
		user[i]->save();
		link_ob = user[i]->query_temp("link_ob");
		if( objectp(link_ob) ) link_ob->save();
	}

//	if( find_object(DNS_MASTER) ) DNS_MASTER->send_shutdown();

	message("system",
		HIR "\n\n系统重新启动！！\n\n" NOR,
		users() );
	shutdown(0);
}

void die()
{
	object ob;

	if( !ob = query_temp("last_damage_from") )
		ob = this_player(1);

	if( !ob ) return;

	message("system",
		HIR "\n\n系统启动中止。\n\n" NOR,
		users() );

	destruct(this_object());
}
