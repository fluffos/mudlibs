// interactive_obj.c
// Created by cbra Sep-14-1998

#include <ansi.h>
#include <dbase.h>
#include <login.h>

#define MAX_MSG_BUFFER 500

#define MAX_REPEAT 50   // by cbra from 100 to 50
#define MAX_ALIASES 20
#define HISTORY_BUFFER_SIZE 10

mapping alias;
nosave string *history;
nosave int last_cmd, repeat_cnt = 0, robot_check = uptime();

nosave int code = 0;  // 0 for gb, other for big5
nosave int snoop_code = 0;

string	prompt_string;
string* channel_name;
mapping channel_color;

nosave string *msg_buffer = ({});

int query_code()
{
	return  code;
}

void set_code(int mycode)
{
	code = mycode;
}

string query_prompt_string()
{
	return	prompt_string;
}

void set_prompt_string(string prom)
{
	prompt_string = prom;
}

string* query_channels()
{
	return channel_name;
}

void set_channels(string* channels)
{
	channel_name = channels;
}

/*
void init_channels()
{
	channel_name = CHANNEL_D->init_channel_name( this_object() );
}
*/

int is_on_channel(string chan)
{
	if (!pointerp(channel_name))	return 0;
	return (member_array(chan, channel_name) != -1);
}

mapping query_channel_color()
{
	return channel_color;
}

void set_channel_color( mapping color)
{
	channel_color = color;
}

/*
void init_channel_color()
{
	channel_color = CHANNEL_D->init_channel_color( this_object() );
}
*/

void receive_message(string msgclass, string msg)
{
	string subclass;

/*
	if( !interactive(this_object()) ) {
		this_object()->relay_message(msgclass, msg);
		return;
	}
*/

	if( sscanf(msgclass, "%s:%s", subclass, msgclass)==2 ) {
		switch(subclass) {
			case "channel":
				if(  (!pointerp(channel_name))
				|| (member_array(msgclass, channel_name)==-1 ))
					return;
				msg = channel_color[msgclass]+msg;
				break;
			case "outdoor":
				if( !environment() || !( 
					(environment()->query("outdoors")) || 
					(environment()->query_climate()) ) )
					return;
				break;
// comment out by hdk on 1998-01-03 //  default:
//                                error("Message: Invalid Subclass " + subclass + ".\n");
		}
	}

	if( query_temp("block_msg/all") || query_temp("block_msg/" + msgclass) )
		return;

	if (code) msg = LANGUAGE_D->toBig5(msg);
	if( in_input(this_object()) || in_edit(this_object()) ) {
		if( sizeof(msg_buffer) < MAX_MSG_BUFFER )
			msg_buffer += ({ msg });
	} else
		receive( msg );
}

void write_prompt()
{
	if( sizeof(msg_buffer) ) {
		if (code) receive(LANGUAGE_D->toBig5(BOLD "[输入时暂存讯息]\n" NOR));
		else receive(BOLD "[输入时暂存讯息]\n" NOR);
		for(int i=0; i<sizeof(msg_buffer); i++)
			receive(msg_buffer[i]);
		msg_buffer = ({});
	}
	write("> ");
}

void set_snoop_code(int i)
{
	snoop_code = i;
} 

void receive_snoop(string msg)
{
	if (!wizardp(this_object())) return;
	if (!snoop_code) receive(RED "●" NOR + msg);	
	else if (snoop_code == 1) receive(RED "●" NOR + LANGUAGE_D->toGB(msg));
	else if (snoop_code == 2) receive(RED "●" NOR + LANGUAGE_D->toBig5(msg));
	else receive("%" + msg);
}

void catch_tell( string msg )
{
	if (code) receive(LANGUAGE_D->toBig5(msg));
	else receive(msg);
}

mixed process_input(string str)
{
	string *args, cmd, argstr;
	int i, j;
	object me=this_object();

	if( uptime() < (robot_check + 11)) // by cbra from 10 to 11
	{
		repeat_cnt++;
		if(repeat_cnt > MAX_REPEAT) 
		{
//**********
			tell_object(me,"请不要一次输入太多的指令。\n");
			//message_vision("请不要一次输入太多的指令。\n", me);
			return 1;
/*
			repeat_cnt = 0;
			robot_check = uptime();
			if( (me->query("startroom")) != ROBOT_CHECK ) {
				me->set("judge/old_startroom", me->query("startroom"));
				if (me->is_ghost()) 
					me->set("judge/last_location", DEATH_ROOM);
				else
					me->set("judge/last_location", base_name(environment(me)));
				me->set("startroom", ROBOT_CHECK );
				message_vision("忽然一阵闪光罩住了$N。\n", me);
				me->move(ROBOT_CHECK);
			}
			else {
				me->move(ROBOT_CHECK);
				message_vision("大胆，在法院做机器人，去死吧。\n", me);
				me->do_command("quit");
			}
			return 1;
*/
//**********
		}
	} else {
		repeat_cnt = 0;
		robot_check = uptime();
	}
// by cbra Mar-07-1998	
	if ( (!living(me)) && (!wizardp(me)) ) {
		return 1;
	}
// end
		
	if(str[0] == '!') 
	{
		if(pointerp(history) && sizeof(history)) 
		{
			if( sscanf(str, "!%d", i) )
				str = (string)history[(HISTORY_BUFFER_SIZE + last_cmd - i) % HISTORY_BUFFER_SIZE];
			else
				str = history[last_cmd];
		} else
			return "";
	} else {
		if(!pointerp(history)) history = allocate(HISTORY_BUFFER_SIZE);
		last_cmd = (last_cmd + 1) % HISTORY_BUFFER_SIZE;
		// by cbra
		if (code) str = LANGUAGE_D->toGB(str);
		// end 
		history[last_cmd] = str;
	}

	if(mapp(alias)) 
	{

		if(!undefinedp(alias[str]))
			return replace_string( alias[str], "$*", "" );

		if(sscanf(str, "%s %s", cmd, argstr) == 2 
		&& !undefinedp(alias[cmd])) 
		{
			cmd = replace_string( alias[cmd], "$*", argstr );
			args = explode(argstr, " ");
			if((j = sizeof(args)))
				for(i=0; i<j; i++)
					cmd = replace_string(cmd, "$" 
						+ (i+1), args[i]);
			return cmd;
		}
	}

	return (string)ALIAS_D->process_global_alias(str);
}

int set_alias(string verb, string replace)
{
	if(!replace) 
	{
		if(mapp(alias)) map_delete(alias, verb);
		return 1;
	} else {
		if(!mapp(alias)) alias = ([ verb:replace ]);
		else if(sizeof(alias) > MAX_ALIASES) 
			return notify_fail("您设定的 alias 太多了，请先删掉一些不常用的。\n");
		else alias[verb] = replace;
		return 1;
	}
}

mapping query_all_alias()
{
	return alias;
}

