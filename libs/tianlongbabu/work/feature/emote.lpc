// emote.c
// Created by cbra Aug-28-1998

mapping my_emote; 

int set_my_emote(string verb, mapping emote)
{
	if (!mapp(my_emote))	my_emote = ([]);
	my_emote[verb]=emote;
}

void delete_my_emote(string verb)
{
	if (mapp(my_emote))
		map_delete(my_emote,verb);
}

mapping query_my_emote(string verb)
{
	if (!mapp(my_emote))	return 0;
	return my_emote[verb];
}

mapping query_all_my_emote()
{
	if (!mapp(my_emote))	return 0;
	return my_emote;
}
