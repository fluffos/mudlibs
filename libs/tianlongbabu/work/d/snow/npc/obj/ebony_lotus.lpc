// ebony_lotus.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("乌雪莲", ({ "ebony lotus", "lotus" }) );
	set_weight(90);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是一种生长在高山冰雪之中的珍贵药材，据说对修炼内功\的\n"
			"武林人士颇有帮助。\n");
		set("unit", "块");
		set("value", 30000);
		set("food_remaining", 1);
		// AGENTS.md-shape fix: eat_tonic() is referenced nowhere in this
		// archive (a hard compile error for an undefined function
		// pointer) and F_FOOD (feature/food.lpc) never actually reads
		// "eat_func" -- dead/inert data even when it did compile.
		// Dropped rather than fabricating tonic-eating logic.
		set("tonic", ([ "force": 60, "max_force": 2000 ]) );
		set("food_supply", 100);
	}
}
