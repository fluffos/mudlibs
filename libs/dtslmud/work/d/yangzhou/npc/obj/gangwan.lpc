#include <armor.h>
#include <ansi.h>
inherit FINGER;

void create() {
  set_name(BLU "钢腕" NOR, ({ "gang wan", "wan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "生钢");
    set("unit", "副");
    set("value", 1500);
    set("armor_prop/armor", 12);
    set("armor_prop/dodge", 1);
  }
  setup();
}
