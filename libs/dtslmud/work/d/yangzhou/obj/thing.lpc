
#include <ansi.h> 
inherit ITEM;
mapping name=([
"烂草帽":"caomao","破草鞋":"caoxie","烂陶罐":"taoguan","废铁":"feitie","断刀":"duandao",
"骷髅":"kulou",	HIG"长生诀"NOR:"changshengjue",HIB"不死印"NOR:"busiyin",HIW"慈航剑典"NOR:"jiandian",
HIC"和氏璧"NOR:"heshibi",YEL"铁钥匙"NOR:"yaoshi","棺材扳":"guancaiban","烂碑":"lanbei","桌子腿":"tui",
"烂渔网":"yuwang",HIM"绣花鞋"NOR:"xie",
]);
void create_name()
{
  int i;
  string *id;
  id=keys(name);
  i=random(sizeof(id));
  set_name(id[i],({name[id[i]]}));
  return;
}
	

void create()
{
   set_name("物品", ({"rice"}));
        set_weight(100000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
               
        }
}

