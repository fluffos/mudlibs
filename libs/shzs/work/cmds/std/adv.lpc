// advance.c
// approach the target.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);

int main(object me, string arg) {
  string target;
  object target_ob;
  int steps;

  if (me->query("position") == "rest")
    return notify_fail("你得先站起身子才行。\n");

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");


  if (!arg && !me->is_fighting()) return notify_fail("你想更接近谁？\n");

  if (!arg && me->is_fighting()) {
    target_ob = me->query_temp("last_opponent");
    if (!target_ob) return notify_fail("没有目标可以接近。\n");
  }

  else if (me->is_fighting() && sscanf(arg, "%d", steps) == 1)
    target_ob = me->query_temp("last_opponent");

  else if (sscanf(arg, "%d %s", steps, target) == 2) {
    target_ob = present(target, environment(me));

    if (!target_ob) return notify_fail("这里没有你欲接近的目标。\n");
    if (objectp(target_ob) && !me->visible(target_ob)) {
      if (target_ob->is_character())
        return notify_fail("你看不见这个人。\n");
      if (target_ob->is_vehicle())
        return notify_fail("你看不见这个载具。\n");
      if (target_ob->is_space_ship() || target_ob->is_shuttle())
        return notify_fail("你看不见这艘船舰。\n");
    }
  }

  else if (sscanf(arg, "%s", target) == 1) {
    target_ob = present(target, environment(me));
    steps = me->query("dex");

    if (!target_ob) return notify_fail("这里没有你欲接近的目标。\n");
    if (objectp(target_ob) && !me->visible(target_ob)) {
      if (target_ob->is_character())
        return notify_fail("你看不见这个人。\n");
      if (target_ob->is_vehicle())
        return notify_fail("你看不见这个载具。\n");
      if (target_ob->is_space_ship() || target_ob->is_shuttle())
        return notify_fail("你看不见这艘船舰。\n");
    }
  }


  if (target_ob->is_character() || target_ob->is_vehicle() ||
    target_ob->is_space_ship() || target_ob->is_shuttle())
    COMBAT_D->advance(me, target_ob, steps);
  else return notify_fail("这里没有这个人、载具或般船舰。\n");
  return 1;

}

int help(object me) {
  write(@HELP
指令格式： advance [公尺] <人物、载具或舰舰>
	  advance [公尺]			( 战斗中)


这个指令可以让您接近与一个目标人物或者是载具、船舰的距离。 
战斗中如果不加上目标名称，则自动接近与敌人的距离。

一次接近的公尺数最高不能大於您的敏捷属性值。
如果不加上公尺数，则以敏捷属性值做为接近的距离。
参考：back
HELP
  );
  return 1;
}
