// fill.c
// Fill some liquid from water resource.
// Modified from ES 2 /feature/liquid.c
// Last modified by Spock @ FF	97.Sep.7.

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);

int main(object me, string arg) {
  object obj;

  if (me->query("position") == "rest")
    return notify_fail("你得先站起身子才行。\n");

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");

  if (!environment(me)->query("resource/water"))
    return notify_fail("这里没有地方可以装水。\n");

  if (!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这样容器。\n");

  if (!obj->is_water_container())
    return notify_fail("这不是一个液体容器。\n");

  if (obj->query("liquid/remaining") && (obj->query("liquid/type") != "water"))
    message_vision("$N 将" + obj->name() + " 里剩下的 " + obj->query("liquid/name") + "倒掉。\n", me);

  message_vision("$N将" + obj->name() + "装满清水。\n", me);

  if (me->is_fighting())
    me->time_unit_loss(50);
  else
    me->time_unit_loss(5);

  obj->set("liquid/type", "water");
  obj->set("liquid/name", "清水");
  obj->set("liquid/remaining", obj->query("max_liquid"));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : fill <物品名称>
 
让您从洁净的水源装水到容器中。


参考： drink, eat
HELP
  );
  return 1;
}
