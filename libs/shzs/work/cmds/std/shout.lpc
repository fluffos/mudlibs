// shout.c
// Shout a message to all players.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");

  //	if( !wizardp(me) )
  //		return notify_fail("ヘ玡既ぃ秨產 shout\n");

  if (!arg) return notify_fail("你想要大叫什么?\n");
  shout(me->name() + "向全mud宣布: " + arg + "\n");
  write("你向全mud宣布: " + arg + "\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去，所有在游戏中的人都
会听见你的话

 
参考 : tune, channels
HELP
  );
  return 1;
}
