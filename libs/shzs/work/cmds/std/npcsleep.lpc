// sleep.c

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me) {
  if (me->is_busy())
    return notify_fail("你的上一个动作还没有完成。\n");

  if (me->is_fighting())
    return notify_fail("你正在战斗中。\n");


  if (me->query("position") == "sleep") {
    return notify_fail("你已经睡着了。\n");
  } else {
    message_vision("$N 躺了下来安静的入睡了。\n", me);
    me->set("position", "sleep");
  }
  return 1;
}
