// rest.c
// Take a rest.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me) {
  if (me->is_busy())
    return notify_fail("你的上一个动作还没有完成。\n");

  if (me->is_fighting())
    return notify_fail("你正在战斗中。\n");



  if (me->query("position") == "sleep") {
    me->set("position", "rest");
    message_vision("$N 从睡梦中醒来，坐在地上休息。\n", me);
  } else if (me->query("position") == "rest") {
    return notify_fail("你已经在休息了。.\n");
  } else {
    me->set("position", "rest");
    message_vision("$N 找了个地方坐下来休息.\n", me);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： rest

让你坐下来休息。


相关指令: sleep, stand
HELP
  );
  return 1;
}
