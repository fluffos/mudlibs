// drop.c
// Drop something.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_drop(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object obj, *inv, obj2;
  int i, amount;
  string item;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (!arg) return notify_fail("你要丢弃什么东西。\n");

  if (sscanf(arg, "%d %s", amount, item) == 2) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西。\n");
    if (stringp(obj->query("no_drop")))
      return notify_fail((string)obj->query("no_drop"));
    if (!obj->query_amount())
      return notify_fail(obj->name() + "不能被分开丢弃。\n");
    if (amount < 1)
      return notify_fail("东西的数量至少是一个。\n");
    if (amount > obj->query_amount())
      return notify_fail("你没有那么多的" + obj->name() + "。\n");
    else if (amount == (int)obj->query_amount())
      return do_drop(me, obj);
    else {
      obj->set_amount((int)obj->query_amount() - amount);
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      return do_drop(me, obj2);
    }
  }

  if (arg == "all") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      do_drop(me, inv[i]);
      me->time_unit_loss(1);
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  return do_drop(me, obj);
}

int do_drop(object me, object obj) {
  mixed no_drop;

  if (no_drop = obj->query("no_drop")) {
    tell_object(me, stringp(no_drop) ? no_drop : obj->query("name") + "这样东西不能随意丢弃。\n");
    return 0;
  }

  if (obj->query("equipped")) {
    tell_object(me, obj->query("name") + "这样东西正在使用。\n");
    return 0;
  }

  if (obj->move(environment(me))) {
    if (obj->is_character())
      message_vision("$N 将 $n 从背上扔下来，丢在地上，顺便再踩上一脚。\n", me, obj);
    else {
      message_vision(sprintf("$N 丢下一%s%s.\n", obj->query("unit"),
        obj->identify(me, obj) ?
        obj->name() : "不知名的物品"), me);
      if (wizardp(me)) {
        obj->set("wizard/drop", getuid(me));
        log_file("INV",
          sprintf("%s(%s) 扔掉 %s.(%s) %s %s\n",
            me->name(), capitalize(geteuid(me)),
            obj->name(), base_name(obj), base_name(environment(me)),
            ctime(time())));
      }
    }
    me->time_unit_loss(2);
    return 1;
  }
  return 0;
}

int help(object me) {
  write(@HELP
指令格式： drop <物品名称>
	  drop all

这个指令可以让你丢下你所携带的物品。 

 
HELP
  );
  return 1;
}
