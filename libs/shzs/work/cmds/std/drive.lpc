// drive.c
// drive a vehicle.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help();

int main(object me) {
  object *inside;
  int i;


  if (me != this_player(1)) return 0;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (!environment(me)->is_vehicle())
    return notify_fail("你不在任何载具中。\n");
  if (!wizardp(me)) {
    for (i = 0; i < sizeof(inside = all_inventory(environment(me))); i++) {
      if (inside[i] == me) continue;
      if (inside[i]->query_temp("command"))
        return notify_fail(sprintf("%s(%s)正在驾驶这%s%s.\n",
          inside[i]->query("name"), capitalize(geteuid(inside[i])),
          environment(me)->query("unit"),
          environment(me)->query("name")));
    }
  }
  if (me->query_temp("command") == 1) {
    return notify_fail(sprintf("您已经在驾驶这%s%s" NOR ".\n",
      environment(me)->query("unit"),
      environment(me)->query("name")));
  }
  me->set_temp("command", 1);
  message_vision(sprintf(CYN " %s" CYN "开始驾驶这%s%s" CYN "\n" NOR,
    me->query("name"), environment(me)->query("unit"),
    environment(me)->query("name")), me);
  me->time_unit_loss(3);
  return 1;
}

int help() {
  write(@HELP
指令格式： drive

这个指令可以让你开始驾驶载具。 
 

参考： leave, pilot, getout, getin. 
HELP
  );
  return 1;
}
