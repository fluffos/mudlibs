// say.c
// Say some words.
// Original ES II commands.
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (me->query("water") <= 0)
    return notify_fail("你口渴得说不出话来。\n");

  if (!arg) {
    message_vision("$N 自言自语不知在说些什么。\n", me);
    return 1;
  }

  if ((int)me->query("hit") < (int)me->query("max_hit") / 10) {
    arg = replace_string(arg, " ", " ... ") + " ...";
  }

  message_vision(CYN + "$N " + CYN + "说道: " + arg + "\n" NOR, me);

  // The mudlib interface of say
  all_inventory(environment(me))->relay_say(me, arg);
  me->time_unit_loss(1);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式： say <讯息>

说话，所有跟你在同一个房间的人都会听到你说的话。

 

 
参考: ask, emote, reply, tell
HELP
  );
  return 1;
}
