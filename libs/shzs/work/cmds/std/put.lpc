// put.c
// Put something in a container.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_put(object me, object obj, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string target, item;
  object obj, dest, *inv, obj2;
  int i, amount;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");


  if (!arg) return notify_fail("你要将什么东西放进那里 ?\n");

  if (sscanf(arg, "%s in %s", item, target) != 2)
    return notify_fail("你要放入什么东西 ?\n");

  dest = present(target, me);
  if (!dest || living(dest)) dest = present(target, environment(me));
  if (!dest || living(dest))
    return notify_fail("这里没有这样东西。\n");

  if (sscanf(item, "%d %s", amount, item) == 2) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西.\n");
    //		if( obj->is_corpse())
    //			return notify_fail("ぃр砰甧竟い.\n");
    if (obj->is_vehicle())
      return notify_fail("你不可以将载具放入容器中.\n");
    //		if( obj->is_container())
    //			return notify_fail("ぃр甧竟甧竟い.\n");
    if (!obj->query_amount())
      return notify_fail(obj->name() + "不能被分开.\n");
    if (amount < 1)
      return notify_fail("东西的数量至少是一个.\n");
    if (amount > obj->query_amount())
      return notify_fail("你没有那么多数量的" + obj->name() + ".\n");
    else if (amount == (int)obj->query_amount())
      return do_put(me, obj, dest);
    else {
      obj->set_amount((int)obj->query_amount() - amount);
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      return do_put(me, obj2, dest);
    }
  }

  if (item == "all") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (inv[i] != dest) do_put(me, inv[i], dest);
    write("Ok.\n");
    return 1;
  }

  if (!objectp(obj = present(item, me)))
    return notify_fail("你身上没有这样东西.\n");
  //	if( obj->is_corpse())
  //		return notify_fail("ぃр砰甧竟い.\n");
  if (obj->is_vehicle())
    return notify_fail("你不可以将载具放入容器中.\n");
  //	if( obj->is_container())
  //		return notify_fail("ぃр甧竟甧竟い.\n");
  return do_put(me, obj, dest);
}

int do_put(object me, object obj, object dest) {
  if (obj == dest)
    return notify_fail("把容器放进容器自己里面 ??\n");
  if (obj->move(dest)) {
    message_vision(sprintf("$N将一%s%s放进%s.\n",
      obj->query("unit"), obj->identify(me, obj) ?
      obj->name() : "不知名的物体", dest->name()),
      me);
    me->time_unit_loss(2);
    return 1;
  } else return 0;
}

int help(object me) {
  write(@HELP
指令格式： put [<数量>] <物品名称> in <容器名称>

这个指令可以让你将某样物品放进一个容器，当然，道德你要拥有这样物品。 

 
HELP
  );
  return 1;
}
