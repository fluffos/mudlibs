// unload.c
// Unload ammunition from a advanced weapon.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_unload(object me, object weapon);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object weapon;

  if (me->query("position") == "sleep")
    return notify_fail("ご何冠い.\n");

  if (me->query_time_unit() <= 0)
    return notify_fail("笆ぃ镑е !\n");

  if (!arg && me->is_fighting()) {
    if ((weapon = me->query_temp("weapon")) && weapon->is_loadable()) {
      do_unload(me, me->query_temp("weapon"));
      write("Ok.\n");
    } else return notify_fail("硂贺猌竟礚猭紆┪紆媚.\n");
  }

  // Check if a weapon is specified.
  if (arg) {
    weapon = present(arg, me);
    if (!weapon) weapon = present(arg, environment(me));
    if (!weapon) return notify_fail("тぃ " + arg + " 硂妓猌竟.\n");
  } else return notify_fail("璶眖ぐ或猌竟柑紆┪紆媚 ?\n");

  if (!weapon->is_loadable())
    return notify_fail("硂贺猌竟礚猭紆┪紆媚.\n");

  if (weapon->query("loaded"))
    return do_unload(me, weapon);
  else return notify_fail("猌竟柑⊿Τ紆┪紆媚.\n");
}

int do_unload(object me, object weapon) {
  string clip_name, ammo_name, message;
  object clip, ammo;
  int i;

  clip_name = weapon->query("clip");
  clip = new(clip_name);
  clip->move(me);
  ammo_name = clip->query("ammo");

  ammo = new(ammo_name);
  ammo->set_amount((int)weapon->query("ammo"));
  ammo->move(clip);

  weapon->delete("loaded");
  weapon->delete("ammo");

  message = "$N 眖 " + weapon->name() + " い" + clip->query("unit") + clip->name() + ".\n";
  message_vision(message, me);
  me->time_unit_loss(6);
  return 1;
}

int help(object me) {
  write(@HELP
Α: unload [<猌竟嘿>]
丁: 6 虫︗.
 
硂琵眤猌竟柑紆┪紆媚 () , 狦眤タ
驹矮い, 钡ゴ unload タㄏノぇ猌竟紆┪紆媚
.
把σ: load.
HELP
  );
  return 1;
}
