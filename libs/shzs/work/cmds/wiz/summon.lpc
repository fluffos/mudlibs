// summon command..

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string str) {
  object ob;
  int i;
  if (!str) return notify_fail("<Syntax>: Summon <player id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");
  // moving
  tell_room(environment(ob), "地面突然出现一张大嘴把" +
    (string)ob->query("name") + "吞了进去。\n", ob);
  tell_object(ob, "一张大嘴把你吞了进去。\n");
  ob->move(environment(me));
  tell_object(me, "你把" + (string)ob->query("name") + "召唤到你的面前。\n");
  tell_object(ob, "大嘴把你吐了出来，你发现正站在" + (string)me->query("name") +
    "的面前。\n");
  tell_room(environment(ob), (string)ob->query("name") + "突然出现" +
    "在你眼前。\n", ({ me, ob }));
  // ok ..
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : summon <某人>

此指令可让你(你)将某人抓到你面前。
HELP
  );
  return 1;
}
