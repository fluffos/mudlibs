#include "/doc/help.h"
#define COMP    "inherit "
#define LOGO_DIR        "/obj_sample/"
inherit F_CLEAN_UP;

mapping define_obj = ([
  "HEAD": "head",
  "NECK": "neck",
  "CLOTH": "cloth",
  "ARMOR": "armor",
  "SURCOAT": "surcoat",
  "WAIST": "waist",
  "WRISTS": "wrists",
  "SHIELD": "shield",
  "FINGER": "finger",
  "HANDS": "hands",
  "BOOTS": "boots",
  "ACUPUNCTURE": "acupuncture",
  "AXE": "axe",
  "BLADE": "blade",
  "DAGGER": "dagger",
  "FORK": "fork",
  "HAMMER": "hammer",
  "LING": "ling",
  "SWORD": "sword",
  "STAFF": "staff",
  "STICK": "stick",
  "THROWING": "throwing",
  "WHIP": "whip",
  "MULTI": "multi",
  "OBJ_PAPER_SEAL": "paper_seal",
  "OBJ_MAGIC_SEAL": "magic_seal",
  "OBJ_CINNABAR_BRUSH": "cinnabar_brush",
  "NPC_DEMOGORGON": "demogorgon",
  "NPC_GARRISON": "garrison",
  "NPC_HEAVEN_SOLDIER": "heaven_soldier",
  "NPC_ZOMBIE": "zombie",
  "NPC_MIND_BUG": "mind_bug",
  "NPC_MIND_BEAST": "mind_beast",
  "COMBINED_ITEM": "combined",
  "BOOK": "book",
  "ITEM": "item",
  "LIQUID": "liquid",
  "MONEY": "money",
  "PILL": "pill",
  "HERB": "herb",
  "JULEP": "julep",
  "POWDER": "powder",
]);
int updatefile(object me, string file);
int main(object me, string arg) {

  int i, j;
  string dir;
  mixed *file;

  seteuid(geteuid(me));

  if (file_size(LOGO_DIR) == -2);
  else {
    if (mkdir(LOGO_DIR)) write("子目录" + LOGO_DIR + "创建成功。\n");
    else write("你没有创建子目录" + LOGO_DIR + "的权利。\n");
  }
  dir = resolve_path(me->query("cwd"), arg);
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  file = get_dir(dir, -1);
  if (!sizeof(file)) {
    if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
    else
      return notify_fail("没有这个目录。\n");
  }

  i = sizeof(file);

  while (i--) {
    if (file[i][1] == -2) file[i][0] += "/";

  }
  write("目录：" + dir + "\n");

  if (sizeof(file))
    for (i = 0, j = sizeof(file); i < j; i++) {
      if (file[i][1] != -2 && sscanf(file[i][0], "%*s.lpc")
        && file[i][0][strlen(file[i][0]) - 1] == "c"[0]
        && file[i][0][strlen(file[i][0]) - 2] == "."[0])
        updatefile(me, dir + file[i][0]);
      else if (file[i][1] == -2) call_other(__FILE__, "main", me, dir + file[i][0]);
    } else write("    没有任何档案。\n");
  write("\n");

  return 1;
}

int updatefile(object me, string file) {
  object obj;
  string str, f_str;
  reset_eval_cost();
  me->set("cwf", file);
  seteuid(getuid());

  f_str = read_file(file);
  if (f_str && (sscanf(f_str, "%*sinherit %s;%*s", str) == 3)) {
    string temp_str, logo_file, logo_str, err, build_dir, *build_file, filename;
    if (undefinedp(define_obj[str])) return 1;
    logo_file = define_obj[str] + ".sample";
    build_dir = define_obj[str];
    build_file = explode(file, "/");
    filename = LOGO_DIR + build_dir + "/" + build_file[sizeof(build_file) - 1];
    if (sscanf(filename, "%s.lpc", filename) != 1) return 1;
    if (!obj = find_object(file)) catch(obj = new(file));
    if (!obj) return 1;
    if (temp_str = obj->query("name")) str = "!@#$\n" + temp_str + "\n";
    if (temp_str = obj->query("long")) str += "$#@!\n" + temp_str + "\n";
    destruct(obj);
    if (file_size(LOGO_DIR + logo_file) == -1) logo_str = "\n";
    else logo_str = read_file(LOGO_DIR + logo_file);
    if (strsrch(logo_str, str) == -1) {
      string f_name;
      int i, j;
      logo_str += str;
      f_name = LOGO_DIR + logo_file;
      if (file_size(f_name) != -1) rm(f_name);
      write_file(f_name, logo_str);
      f_name = LOGO_DIR + build_dir;
      if (file_size(f_name) == -2);
      else {
        if (mkdir(f_name)) write("子目录" + f_name + "创建成功。\n");
        else write("你没有创建子目录" + f_name + "的权利。\n");
      }
      i = 1;
      while (i) {
        if (!j) f_name = filename + ".lpc";
        else f_name = filename + (string)j + ".lpc";
        f_name = resolve_path(me->query("cwd"), f_name);
        if (file_size(f_name) < 0) i = 0;
        j++;
      }
      write_file(f_name, f_str);
    }
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: sample [<路径名>]
    这个指令用来整理MUDLIB中指定路径下所有物品，进行分类
并且归纳到指定的目录下面，主要是帮助新MUD建设者了解前人
的工作并提供参考。
     有任何好的建议请写信给stzen@netease.com

HELP
  );
  return 1;
}
