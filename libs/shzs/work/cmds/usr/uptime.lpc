// uptime.c
// Display how much time mudlib runs from last reboot.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5. 

inherit F_CLEAN_UP;
inherit F_CMD;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main() {
  int t, d, h, m, s;
  string time;

  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  write(" 山海战神之简单武力 已经执行了" + time + "\n");
  printf("[ 现在时间 ] " + CHINESE_D->chinese_date(time(), 1) + "\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： uptime
 
这个指令告诉您山海战神泥巴游戏已经连续执行了多久。
以及现在的时间[中原标准时间，即格林威治时间].

参考: time
HELP
  );
  return 1;
}
