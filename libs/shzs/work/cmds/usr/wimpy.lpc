// wimpy.c
// Set what condition character should automatic flee from combat.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

inherit F_CLEAN_UP;
inherit F_CMD;

int display_wimpy(object me);
int help(object me);

int main(object me, string arg) {
  string wmp;
  int percent;

  if (!arg) {
    display_wimpy(me);
    return 1;
  }

  if (sscanf(arg, "%d", percent) == 1 && percent >= 0 && percent <= 100) {
    me->set("wmp_spi", percent);
    me->set("wmp_hit", percent);
    me->set("wmp_mov", percent);
    me->set("wmp_vital", percent);

    display_wimpy(me);
    return 1;
  }

  if (sscanf(arg, "%s %d", wmp, percent) == 2 && percent >= 0 && percent <= 100) {
    if (wmp == "spi" || wmp == "hit" ||
      wmp == "mov" || wmp == "vital")
      me->set("wmp_" + wmp, percent);
    display_wimpy(me);
    return 1;
  }

  return help(me);
}

int display_wimpy(object me) {
  string message;

  message = "战斗当中自动开溜的状态设定 :\n";
  message += sprintf("[精神] %3d %%    [体能] %3d %%",
    me->query("wmp_spi"), me->query("wmp_hit"));
  message += sprintf("    [移动] %3d %%    [重要部位] %3d %%\n",
    me->query("wmp_mov"), me->query("wmp_vital"));
  write(message);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式：  wimpy [<设定种类>] [<自动逃跑时的状况百分比>]
	    wimpy [<所有状况通用的百分比>]

这个指令让你设定当体能、精神或移动点数剩下百分之多少时，就会
自动开始逃跑。百分比的范围是 0 ~ 100.
可以设定的种类： spi (精神), hit (体能), mov (移动), 
		vital (重要部位，身体或头部)

参考: body, hp, score
HELP
  );
  return 1;
}
