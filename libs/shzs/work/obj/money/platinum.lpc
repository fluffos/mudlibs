// platinum.c

inherit MONEY;

void create() {
  set_name("铂币", ({ "platinum", "platinum_coin", "platinum_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "platinum");
    set("long", "极为罕见的山海战神铸造的铂币，十分珍贵。\n");
    set("unit", "些");
    set("base_value", 1000000);
    set("base_unit", "枚");
    set("base_weight", 5);
  }
  set_amount(1);
}
