// qian.c
// originally coded by xiang
inherit NPC;
inherit F_BANKER;

void create() {
  set_name("桃源狼", ({ "Simple's lost", "Simple lost" }));
  set("title", "山海战神世界钱行老板");
  set("long", "桃源狼唇边噙着一朵笑靥，手腕上一串米大的紫玉镯和清淡幽渺的体香，\n将她与生俱来、巧夺天工的美貌陪衬得更加特殊，任何人只要见过她一面，无不留下深刻的印象。\n");
  set("gender", "女性");
  set("age", 24);
  set("str", 5 + random(5) + random(5));  //力量 (str):	5 ~ 15
  set("dex", 6 + random(5) + random(8));  //敏捷 (dex):	6 ~ 19
  set("int", 5 + random(5) + random(5) + random(5) + random(3));  //智力 (int):	5 ~ 23
  set("not", 4 + random(5) + random(4) + 2 + random(3));  //注意 (not):	4 ~ 18
  set("con", 7 + random(5) + random(5));  //体质 (con):	7 ~ 17
  set("tec", 2 + random(5) + 6 + random(5) + 4);  //技术 (tec):	2 ~ 22

  set("combat_exp", 50000);

  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 8);
  set("chat_msg", ({
    "本钱庄提供以下服务：
      存钱        deposit或者cun
      取钱        withdraw或者qu
      钱币兑换    convert或者duihuan
      查帐        check或者chazhang\n\n"
    "桃源狼笑着说道：在本店存钱无利息，取钱收十分之一手续费，客官您看着办吧。\n"
  }));

  setup(); carry_object(__DIR__ "obj/doom_staff")->wield();
  carry_object(__DIR__ "obj/black_robe")->wear();
  add_money("gold", 5);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_check", "check");
  add_action("do_check", "chazhang");
  add_action("do_convert", "convert");
  add_action("do_convert", "duihuan");
  add_action("do_deposit", "deposit");
  add_action("do_deposit", "cun");
  add_action("do_withdraw", "withdraw");
  add_action("do_withdraw", "qu");
  delete_temp("busy");
}
void greeting(object ob) {
  string time, respect;
  if (!ob || environment(ob) != environment()) return;
  time = NATURE_D->room_event_fun();        // 这里调用了他
  respect = RANK_D->query_respect(ob);
  switch (time) {                          //根据时间的不同说不同的话
    case "event_dawn":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",天快亮了，您是存钱还是要取钱啊？\n", this_object(), ob);
      break;
    case "event_sunrise":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",今儿可真早啊，小店全天候营业,欢迎光临。\n", this_object(), ob);
      break;
    case "event_morning":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",今早精神好啊，欢迎光临。\n", this_object(), ob);
      break;
    case "event_noon":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",用过午饭了吗?快请坐。\n", this_object(), ob);
      break;
    case "event_afternoon":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",快请坐,您是存钱还是要取钱啊。\n", this_object(), ob);
      break;
    case "event_evening":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",天黑了,您是存钱还是要取钱啊。\n", this_object(), ob);

      break;
    case "event_night":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",您是存钱还是要取钱啊。\n", this_object(), ob);
      break;
    case "event_midnight":
      message_vision("$N笑着对$n说道:这位" + respect
        + ",里面请，您是存钱还是要取钱啊。\n", this_object(), ob);
      break;
  }
}

void kill_ob(object ob) {
  ob->remove_killer(this_object());
  remove_killer(ob);
  message_vision("桃源狼突然大呵一声“魔神召来，元神合体”。                  
             ''`''.
         .-./ _=_ \.-.
        {  (,(oYo),) }}
        {{ +   `   +} }
        { { \\(---)/  }}
        {{  }'-=-'{ } }
        { { }._1_.{  }}
        {{  } -1- { } }
        {_{ }`===`{  _}
       ((((\)     (/))))

\n", ob);
  message_vision("桃源狼召唤出一只巨兽！！！！\n
	巨兽一记重拳向你打来，“轰”。\n", ob);
}
