// coat.c
//
// This is the basic equip for players.

#include <armor.h>

inherit COAT;

void create() {
  set_name("上衣", ({ "coat" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long",
      "一件普通的麻布上衣。\n");
    set("material", "麻布");
    set("value", 30);
    set("armor_prop/traditional_armor", 1);
  }
  setup();
}
