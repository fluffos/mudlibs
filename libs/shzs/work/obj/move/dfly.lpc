// dragonfly.c
// by kittt

#include <armor.h>
#include <ansi.h>

inherit COAT;

void create() {
  set_name(GRN "上衣" NOR, ({ "coat", "fly" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "
          ,~'~'~._
　　　 (((\\~ _~'~.
　　 　 )a　, ~ _~,,,~'~
　　　　\_　 /,-~,,~''
　　　　　\　)--.　
　　　　 　\/　　'
　　　　　　)&,　 ._ ',
　　　　　　\_\_　( '. \
'.___'.　美丽属于移动娃娃!
\n");
    set("unit", "件");
    set("no_get", 1);
    set("no_drop", 1);
    set("no_give", 1);
    set("value", 0);
  }

  setup();

}

void init() {
  add_action("do_fly", "flyto");
}


int do_fly(string arg) {

  object obj, me = this_player();

  if (!arg) return notify_fail("你要去哪里？\n");


  obj = find_player(arg);
  if (!obj) obj = find_living(arg);
  if (!obj) obj = LOGIN_D->find_body(arg);
  if (!obj || !me->visible(obj)) {
    arg = resolve_path(me->query("cwd"), arg);
    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg))) {
      if (file_size(arg) >= 0)
        obj = load_object(arg);
      else
        return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }
  if (environment(obj))
    obj = environment(obj);

  message_vision(GRN "$N离开了。\n" NOR, me);

  me->move(obj);
  message_vision(GRN "$N走了过来。\n" NOR, me);

  return 1;
}
