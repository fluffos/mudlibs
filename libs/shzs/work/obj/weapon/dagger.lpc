// dagger.c

#include <weapon.h>

inherit DAGGER;

void create() {
  set_name("匕首", ({ "dagger" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把钢制的匕首。\n");
    set("value", 600);
    set("material", "钢");
    set("wield_msg", "$N 唰地一声抽出一把 $n 握在手中。\n");
    set("unwield_msg", "$N 将手中的 $n 插入腰间的刀鞘。\n");
  }
  init_dagger(1, 6, 3, 1, 1);
  setup();
}
