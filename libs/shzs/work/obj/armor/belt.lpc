// shield.c

#include <armor.h>

inherit BELT;

void create() {
  set_name("腰带", ({ "belt" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条普通的腰带。");
    set("unit", "条");
    set("value", 20000);

    set("armor_prop/defense", 10);
    set("armor_prop/dp", 100);
  }
  setup();
}
