// sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("糃", ({ "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "р");
    set("long", "硂琌р⊿Τヴ︙癘腹糃.\n");
    set("value", 1000);
    set("material", "葵");
    set("wield_msg", "$N詜羘┾р $n 搐もい.\n");
    set("unwield_msg", "$N 盢もい $n 础竬丁糃繲.\n");
  }
  init_sword(1, 5, 0, 1, 1);
  setup();
}
