// skill.c

#include <ansi.h>
#include <dbase.h>

mapping skills;
mapping learned;

mapping query_learned();
mapping query_skills();
int set_skill(string skill, int val);
int delete_skill(string skill);
varargs int query_skill(string skill, int raw);
varargs void improve_skill(string skill, int amount, int weak_mode);
int skill_death_penalty();

mapping query_learned() { return learned; }

mapping query_skills() {
  int i;
  string *skill_name;

  if (!mapp(skills))
    return skills;
  skill_name = keys(skills);
  i = sizeof(skills) - 1;
  while (i >= 0) {
    if (!find_object(SKILL_D(skill_name[i]))
      && file_size(SKILL_D(skill_name[i]) + ".lpc") < 0) {
      log_file("SKILL",
        sprintf("%s not exits, delete it. (%s) %d/%d\n",
          skill_name[i], geteuid(this_object()),
          skills[skill_name[i]], learned[skill_name[i]]));
      delete_skill(skill_name[i]);
    }
    i--;
  }
  return skills;
}

int set_skill(string skill, int val) {
  int original_val;

  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    return notify_fail("F_SKILL: No such skill (" + skill + ")\n");

  if (!mapp(skills)) skills = ([ skill: val ]);
  else {
    original_val = skills[skill];
    skills[skill] = val;
  }

  if (userp(this_object()))
    this_object()->add("knowledge", (val * (val + 1) * (2 * val + 1) / 6)
      -(original_val * (original_val + 1) * (2 * original_val + 1) / 6));

  return val;
}

int delete_skill(string skill) {
  if (mapp(skills)) {
    if (userp(this_object()))
      this_object()->add("knowledge", -skills[skill] * (1 + skills[skill]) / 2);
    map_delete(skills, skill);

    if (mapp(learned)) {
      if (userp(this_object()))
        this_object()->add("knowledge", -learned[skill]);
      map_delete(learned, skill);
      return undefinedp(learned[skill]);
    }
    return undefinedp(skills[skill]);
  }
  return 0;
}

varargs int query_skill(string skill, int raw) {
  if (!raw) {
    int s;

    s = query_temp("apply/" + skill);
    if (mapp(skills))
      s += skills[skill];
    return s;
  }
  if (mapp(skills) && !undefinedp(skills[skill])) return skills[skill];
  return 0;
}

varargs void improve_skill(string skill, int amount, int weak_mode) {
  string *type;
  int i;

  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    error("F_SKILL: No such skill (" + skill + ")\n");

  if (userp(this_object())) {
    if (!mapp(skills)) skills = ([]);
    if (undefinedp(skills[skill])) skills[skill] = 0;

    // The limit of skill level is 80 + Notation.

    if (skills[skill] >= (80 + (int)this_object()->query("not")))
      return;
  }

  if (!amount) amount = 1;

  type = SKILL_D(skill)->type();

  for (i = 0; i < sizeof(type); i++) {
    amount += this_object()->query(type[i]);
  }
  amount += this_object()->query("int");

  if (!mapp(learned)) {
    learned = ([ skill: amount ]);
    this_object()->add("knowledge", amount);
  } else {
    (int)learned[skill] += amount;
    this_object()->add("knowledge", amount);
  }
  if (userp(this_object())
    && learned[skill] > (skills[skill] + 1) * (skills[skill] + 1)) {
    skills[skill]++;
    learned[skill] = 0;
    tell_object(this_object(), HIC "恭喜，你的" + to_chinese(skill) + "有长进了 ！\n" NOR);
    SKILL_D(skill)->skill_improved(this_object());
  }
}

int skill_death_penalty() {
  string *sk;
  int i;

  if (wizardp(this_object()) || !mapp(skills)) return 0;

  sk = keys(skills);

  for (i = 0; i < sizeof(sk); i++) {
    skills[sk[i]] = skills[sk[i]] * 9 / 10;
    if (skills[sk[i]] < 0) map_delete(skills, sk[i]);
  }
  return 1;
}
