// s_clean_up.c
// modified from clean_up.c

int clean_up() {
  object _inv, *inv;
  object _room, *room;

  if (!clonep() && this_object()->query("no_clean_up")) return 1;

  if (this_object()->is_space_ship_room())
    if (environment())
      return 1;

  if (this_object()->is_space_ship() || this_object()->is_shuttle()) {
    room = all_inventory();
    foreach (_room in room) {
      inv = all_inventory();
      foreach (_inv in inv) {
        if (interactive(_inv))
          return 1;
      }
    }
  }

  if (this_object()->is_space())
    if (first_inventory(this_object()))
      return 1;

  destruct(this_object());
  return 0;
}
