// autoload.c
// Original ES2 autoload feature.
// Last modified by Spock @ FF	97.Nov.26. 

mapping autoload = ([]);
string *file = ({});

void clean_up_autoload() { autoload = 0; }
void clean_up_file() { file = 0; }

void save_autoload() {
  object *inv;

  // integer counters...:P

  int i;
  string name;

  inv = deep_inventory(this_object());
  file = allocate(sizeof(inv));
  autoload = allocate_mapping(sizeof(inv) * 10);

  // save all inventory.

  for (i = 0; i < sizeof(inv); i++) {

    if (!inv[i]->query_autoload()) continue;
    name = file_name(inv[i]);
    file[i] = name;

    if (inv[i]->is_water_container()) {
      autoload[name + "@water_remain"] = inv[i]->query("liquid/remaining");
      autoload[name + "@water_name"] = inv[i]->query("liquid/name");
      autoload[name + "@water_type"] = inv[i]->query("liquid/type");
    }
    if (inv[i]->is_food())
      autoload[name + "@food"] = inv[i]->query("food/remaining");
    if (inv[i]->query_amount())
      autoload[name + "@amount"] = inv[i]->query_amount();
    if (inv[i]->query("equipped")) {
      autoload[name + "@eq"] = 1;
    }
    if (inv[i]->is_loadable()) {
      if (!inv[i]->query("loaded"))
        autoload[name + "@load"] = -1;
      else
        autoload[name + "@load"] = inv[i]->query("ammo");
    }
    if (inv[i]->query("durability"))
      autoload[name + "@durability"] = inv[i]->query("durability");
    if (inv[i]->is_electronics()) {
      autoload[name + "@energy"] = inv[i]->query("energy");
      if (inv[i]->is_active())
        autoload[name + "@active"] = 1;
    }
  }

  file = file[0..i - 1];
}

void restore_autoload() {
  int i;
  object ob;
  string err;
  string real_name;

  if (!pointerp(file)) return;

  for (i = 0; i < sizeof(file); i++) {
    if (sscanf(file[i], "%s#%*d", real_name) != 2)
      // For backward compatibility, erase this ASAP.
      real_name = file[i];
    err = catch(ob = new(real_name));
    if (err || !ob) {
      write("你觉得似乎失落了什么重要的东西，最好通知一下巫师。\n");
      log_file("AUTOLOAD", sprintf("Fail to autoload %s of %s, error %s\n",
        real_name, this_object()->query("name"), err));
      continue;
    }
    export_uid(ob);
    ob->move(this_object());

    if (ob->is_water_container()) {
      ob->set("liquid/remaining", autoload[file[i] + "@water_remain"]);
      ob->set("liquid/type", autoload[file[i] + "@water_type"]);
      ob->set("liquid/name", autoload[file[i] + "@water_name"]);
    }
    if (ob->is_food()) {
      ob->set("food/remaining", autoload[file[i] + "@food"]);
    }
    if (ob->query_amount()) {
      ob->set_amount(autoload[file[i] + "@amount"]);
    }
    // Check items whether or not equipped.
    if (autoload[file[i] + "@eq"]) {
      ob->wield();
      ob->wear();
    }
    if (ob->is_loadable()) {
      if (autoload[file[i] + "@load"] != -1) {
        ob->set("ammo", autoload[file[i] + "@load"]);
        ob->set("loaded", 1);
      }
    }
    if (ob->is_electronics()) {
      ob->set("energy", autoload[file[i] + "@energy"]);
      if (autoload[file[i] + "@active"])
        ob->activate();
    }
    if (ob->query("durability")) {
      ob->set("durability", autoload[file[i] + "@durability"]);
    }
  }

  // To save memory.
  clean_up_autoload();
  clean_up_file();
}
