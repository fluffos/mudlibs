// dagger.c

#include <weapon.h>
#include <dbase.h>

inherit WEAPON;

varargs void init_dagger(int dice_number, int dice_roll, int damage_bonus,
  int round, int range, int flag) {
  if (clonep(this_object())) return;

  set("weapon_prop/dice_number", dice_number);
  set("weapon_prop/dice_roll", dice_roll);
  set("weapon_prop/damage_bonus", damage_bonus);
  set("weapon_prop/round", round);
  set("weapon_prop/range", range);
  set("flag", (int)flag | EDGED);
  set("damage_type", "traditional");
  set("skill_type", "short_weapon");
  set("unknown_type", "短兵刃");
  if (!query("max_durability"))
    set("max_durability", 300);
  if (!query("durability"))
    set("durability", 300);
  if (!query("attack"))
    set("attack", 85);
  if (!query("defence"))
    set("defense", 20);
  if (!query("armor_piercing"))
    set("armor_piercing", 20);

  set("verbs", ({ "slice", "pierce", "thrust" }));
}
