// shuttle_bay.c
// Standard space station boarding tube object.
// Author: Spock @ FF	98.Aug.25.
// Last modified by Spock @ FF	98.Aug.27.

inherit ROOM;

void init() {
  seteuid(getuid());
  setup();
}

void setup() {
  string space_file, station_file;
  object station;

  ::setup();
  if (stringp(station_file = query("space_station"))) {

    space_file = query("space_station_location");
    call_other(space_file, "???");

    station = find_object(station_file);
  }
  return;
}
