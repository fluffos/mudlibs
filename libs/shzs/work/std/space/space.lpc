// space.c
// Standard space object
// Author: Spock @ FF
// Last modified by Spock @ FF	98.Aug.27.

#pragma save_binary

#include <dbase.h>

inherit F_DBASE;
inherit F_S_CLEAN_UP;
inherit F_S_MOVE;

int is_space() { return 1; }

void init() {
  seteuid(getuid());
}

object make_inventory(string file) {
  object ob;

  seteuid(getuid(this_object()));
  ob = new(file);
  export_uid(ob);
  ob->move(this_object());
  return ob;
}

object make_env() {
  object ob;
  string space;

  if (stringp(space = query("env_space"))) {
    call_other(space, "???");
    ob = find_object(space);
  }
  move(ob);
  return ob;
}

void reset() {
  mapping ob_list, ob;
  string *list;
  int i, j;
  mixed local;

  //
  // Check loaded objects to match the objects specified in "objects"
  // while query("objects") is 
  // ([ <object filename>: <amount>, ..... ])
  // and query_temp("objects") is
  // ([ <object filename>: ({ob1, ob2, ...}), .... ])
  //
  ob_list = query("objects");

  if (!mapp(ob_list)) {
    // after all need to reset, we find we didnt do any reset
    // so we put the reset time forward a long time :)
    // to avoid reset lag, Idea by Jesse@Doom 1998/3/21
    if (function_exists("reset", this_object()) == "/std/space") {
      set_reset(this_object(), 86400);
    }
    // Code above is written by Jesse @ Doom, posted on Taiwan BBS InstallMUD board.
    return;
  }

  if (!mapp(ob = query_temp("objects")))
    ob = allocate_mapping(sizeof(ob_list));

  list = keys(ob_list);
  i = sizeof(list);
  while (i--) {
    // Allocate an array if we have multiple same object specified.
    if (undefinedp(ob[list[i]])
      && intp(ob_list[list[i]])
      && ob_list[list[i]] > 1)
      ob[list[i]] = allocate(ob_list[list[i]]);

    switch (ob_list[list[i]]) {
      case 1:
        if (!ob[list[i]]) ob[list[i]] = make_inventory(list[i]);
        break;
      default:
        j = ob_list[list[i]];
        while (j--) {
          // If the object is gone, make another one.
          if (!objectp(ob[list[i]][j])) {
            ob[list[i]][j] = make_inventory(list[i]);
            continue;
          }
        }
    }
  }
  set_temp("objects", ob);
}

void setup() {
  int temp;

  seteuid(getuid());
  this_object()->reset();
  if ((int)query("special_space"))
    this_object()->make_env();
  set("terrain", "space");
  set("mov_cost", 1000000000);
}
