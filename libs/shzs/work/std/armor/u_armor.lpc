// u_armor.c

#include <armor.h>

inherit ARMOR;

void setup() {
  if (clonep(this_object())) return;

  set("armor_type", TYPE_U_ARMOR);
  if (!query("armor_apply/dodge")
    && weight() > 1000)
    set("armor_prop/dodge", -weight() / 1000);

  set("unknown_type", "上部盔甲");
  set("protect_limb", ({ 1, 2, 3 }));
  if (!query("durability"))
    set("durability", 400);
  if (!query("max_durability"))
    set("max_durability", 400);
  if (!query("armor_prop/traditional_armor"))
    set("armor_prop/traditional_armor", 1);
  if (!query("armor_prop/traditional_resist"))
    set("armor_prop/traditional_resist", 20);
}
