// small_cargo_ship.c

#include <space_ship.h>
#include <dbase.h>

inherit SPACE_SHIP;

void setup() {
  ::setup();

  if (clonep(this_object())) return;

  set("space_ship_type", SMALL_CARGO_SHIP);
  set("armors", ({ "磨", "磨Ю", "察", "オ察", "磨郴", "磨浮", }));
  set("space", 1);
  set("armors_hit", ({ 30000, 25000, 10000, 10000, 5000, 5000, }));
  set("armors_max_hit", ({ 30000, 25000, 10000, 10000, 5000, 5000, }));
  set("fuel", 1000000);
}
