inherit NPC;
void prepare_kill();
void create() {
  set_name("桑雅", ({ "sang ya" }));
  set("title", "红龙");
  set("gender", "男性");
  set("age", 25 + random(5) + 10 + random(5));

  set("long", @LONG
桑雅正倨傲的看着你，那似笑非笑的双眼如蜜糖般，几乎可以感觉到吸引人的甜味。    
LONG
  );
  set("str", 5 + random(5) + random(5));  //力量 (str):	5 ~ 15
  set("dex", 6 + random(5) + random(8));  //敏捷 (dex):	6 ~ 19
  set("int", 5 + random(5) + random(5) + random(5) + random(3));  //智力 (int):	5 ~ 23
  set("not", 4 + random(5) + random(4) + 2 + random(3));  //注意 (not):	4 ~ 18
  set("con", 7 + random(5) + random(5));  //体质 (con):	7 ~ 17
  set("tec", 2 + random(5) + 6 + random(5) + 4);  //技术 (tec):	2 ~ 22
  set("level", 20 + random(10) + random(10));
  set("combat_exp", 60000 + random(50000) + 30000 + random(100000));
  set("attitude", "friendly");

  set("score", 20 + random(7) + 3 + random(10));





  set("home_time", ([
    "8-21": "/d/lwe/shop2.lpc",
  ]));
  set("mob_program", ([
    "0": ({ "npcsleep",
      "npcsleep",
    }),
    "1": ({ "say 1",
      "say 1",
    }),
    "2": ({ "",
      "say 2",
    }),
    "3": ({ "say 3"
    }),
    "4": ({ "say 4",
      "",
    }),
    "5": ({ "",
      "",
    }),
    "6": ({ "",
      "",
    }),
    "7": ({ "wake",
      "wake",
    }),
    "8": ({ "flyto d/mohao/shiye",
      "say 呵，哟，嗯！！！！",
    }),
    "9": ({ "say 水蓝，你来打扫书房啦！！！",
      "flyto d/mohao/taiyefu",
    }),
    "10": ({ "say ha ha ",
      "say 得出去走走。",
    }),
    "11": ({ "flyto /d/mohao/wendingbei3
",
      "south",
    }),
    "12": ({ "south",
      "",
    }),
    "13": ({ "flyto /d/mohao/shizhongxin
",
      "puke",
    }),
    "14": ({ "say 天气好热啊。",
      "emote 把衣服脱少了一件。",
    }),
    "15": ({ "west",
      "west",
    }),
    "16": ({ "say 16",
      "",
    }),
    "17": ({ "east",
      "east",
    }),
    "18": ({ "east",
      "",
    }),
    "19": ({ "say 19",
      "",
    }),
    "20": ({ "flyto flyto d/mohao/taiyefu",
      "",
    }),
    "21": ({ "say 还是家里好。\n",
      "xixi",
    }),
    "22": ({ "npcsleep",
      "npcsleep",
    }),
    "23": ({ "",
      "",
    }),
  ]));
  set("mob_program_delay", ([
    "1": ({ 5, 2,
    }),
    "2": ({ 5, 2,
    }),
    "3": ({ 5, 2,
    }),
    "4": ({ 5, 2,
    }),
    "5": ({ 5, 2,
    }),
    "6": ({ 5, 2,
    }),
    "7": ({ 5, 2,
