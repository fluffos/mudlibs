// Room: /d/mohao/chenglou.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "西城楼");
  set("long", @LONG
不觉你已到了星龙城的西城门。高高的城楼看上去坚不可摧。西面有
一楼梯可以上城楼的外墙。据说这里守城的将军武功不俗，而却很好
比武。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "xijiao",
    "east": __DIR__ "yanling2",
    "up": __DIR__ "chenglouup",
  ]));
  set("outdoors", "/d/mohao");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。不觉你已到了星龙城的
西城门。高高的城楼看上去坚不可摧。西面有一楼梯可以上城楼
的外墙。据说这里守城的将军武功不俗，而却很好比武。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。不觉
你已到了星龙城的西城门。高高的城楼看上去坚不可摧。西面有
一楼梯可以上城楼的外墙。据说这里守城的将军武功不俗，而却
很好比武。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。不觉你已到了星
龙城的西城门。高高的城楼看上去坚不可摧。西面有一楼梯可以
上城楼的外墙。据说这里守城的将军武功不俗，而却很好比武。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。不觉你已到了
星龙城的西城门。高高的城楼看上去坚不可摧。西面有一楼梯可
以上城楼的外墙。据说这里守城的将军武功不俗，而却很好比武。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。不觉你已到了星龙城的西城门
高高的城楼看上去坚不可摧。西面有一楼梯可以上城楼的外墙。
据说这里守城的将军武功不俗，而却很好比武。
LONG
        );
    }
    return 0;
  }
}
