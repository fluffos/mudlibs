// Room: /d/zhongzhou/yaopu.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "药铺");
  set("long", @LONG
这是星龙城最大的药铺。从一般的药材到名贵的中草药一应俱全。
浓浓的药味让你有点透不过气来。店里人来人往的，看的出此处
生意不错。你如需要药的话可以向药童买一点。
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/jipin": 1,
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "yaopuboss",
    "west": __DIR__ "wendingbei2",

  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城最大的药铺。
从一般的药材到名贵的中草药一应俱全。浓浓的药味让你有点透
不过气来。店里人来人往的，看的出此处生意不错。你如需要药
的话可以向药童买一点。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城最大的药铺。从一般的药材到名贵的中草药一应俱全。浓
浓的药味让你有点透不过气来。店里人来人往的，看的出此处生
意不错。你如需要药的话可以向药童买一点。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城最大
的药铺。从一般的药材到名贵的中草药一应俱全。浓浓的药味让
你有点透不过气来。店里人来人往的，看的出此处生意不错。你
如需要药的话可以向药童买一点。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城最
大的药铺。从一般的药材到名贵的中草药一应俱全。浓浓的药味
让你有点透不过气来。店里人来人往的，看的出此处生意不错。
你如需要药的话可以向药童买一点。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城最大的药铺。从一
般的药材到名贵的中草药一应俱全。浓浓的药味让你有点透不过
气来。店里人来人往的，看的出此处生意不错。你如需要药的话
可以向药童买一点。
LONG
        );
    }
    return 0;
  }
}
