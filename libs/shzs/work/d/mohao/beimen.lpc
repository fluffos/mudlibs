// Room: /d/mohao/beimen.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "星龙城北门");
  set("long", @LONG
这里已经到了星龙城的北门了，高高的城墙的砖缝里长满了草。
走过城门，就是城外了。
LONG
  );

  set("outdoors", "/d/mohao");
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "to_zhongzhou3",
    "south": __DIR__ "wendingbei4",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里已经到了星龙城的
北门了，高高的城墙的砖缝里长满了草。走过城门，就是城外了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
已经到了星龙城的北门了，高高的城墙的砖缝里长满了草。走过
城门，就是城外了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里已经到了星
龙城的北门了，高高的城墙的砖缝里长满了草。走过城门，就是
城外了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里已经到了
星龙城的北门了，高高的城墙的砖缝里长满了草。走过城门，就
是城外了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这里已经到了星龙城的北门了，
高高的城墙的砖缝里长满了草。走过城门，就是城外了。
LONG
        );
    }
    return 0;
  }
}
