//yinghao

#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "龙鳞酒楼");
  set("long", @LONG
这是星龙城最大的酒楼，南来北往的过客都要在此歇歇脚，喝壶
好酒。说不准还会交到一两个朋友。你要是要和朋友小聚，楼上
还有雅座。据说楼上还有休息室，专门为了那些有点贪杯的人准
备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
  );

  set("objects", ([
    __DIR__ "npc/liuman": 1,
    __DIR__ "npc/lanbi": 1,
  ]));

  set("exits", ([
    "west": __DIR__ "wendingbei1",

    "up": __DIR__ "yinghaoup",
  ]));

  set("no_fight", 1);

  set("doors", ([
    "west": ([
      "data": "门",
      "other_side_dir": "east",
      //	"status"	:	DOOR_LOCKED,
      "key_id": "mohao/jiulou_key",
    ]), ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城最大的酒楼，
南来北往的过客都要在此歇歇脚，喝壶好酒。说不准还会交到一
两个朋友。你要是要和朋友小聚，楼上还有雅座。据说楼上还有
休息室，专门为了那些有点贪杯的人准备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城最大的酒楼，南来北往的过客都要在此歇歇脚，喝壶好酒
说不准还会交到一两个朋友。你要是要和朋友小聚，楼上还有雅
座。据说楼上还有休息室，专门为了那些有点贪杯的人准备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城最大
的酒楼，南来北往的过客都要在此歇歇脚，喝壶好酒。说不准还
会交到一两个朋友。你要是要和朋友小聚，楼上还有雅座。据说
楼上还有休息室，专门为了那些有点贪杯的人准备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城最
大的酒楼，南来北往的过客都要在此歇歇脚，喝壶好酒。说不准
还会交到一两个朋友。你要是要和朋友小聚，楼上还有雅座。据
说楼上还有休息室，专门为了那些有点贪杯的人准备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城最大的酒楼，南来
北往的过客都要在此歇歇脚，喝壶好酒。说不准还会交到一两个
朋友。你要是要和朋友小聚，楼上还有雅座。据说楼上还有休息
室，专门为了那些有点贪杯的人准备的。
         _.._..,_,_
        (          )
         ]~,"-.-~~[
       .=])' (;  ([
       | ]:: '    [
       '=]): .)  ([
         |:: '    |
          ~~----~~
LONG
        );
    }
    return 0;
  }
}
