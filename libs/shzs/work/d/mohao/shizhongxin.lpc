// Room: /d/mohao/shizhongxin.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "城中心");
  set("long", @LONG
这是星龙城的中心，两条街道在这里划个大十字。整个星龙城就
数着两条街道最热闹了。南北一条宽敞的街道，一看就是刚刚修
建好不久，街道的石板是由山上采来的碧石铺成。东西那条街道
要陈旧一点，碧石的颜色已经有些暗淡了。
LONG
  );
  set("outdoors", "/d/mohao");
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "yanlingdong",
    "south": __DIR__ "wendingnan1",
    "west": __DIR__ "yanling",
    "north": __DIR__ "wendingbei1",
  ]));
  set("no_sleep_room", 1);


  set("no_clean_up", 0);


}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城的中心，两
条街道在这里划个大十字。整个星龙城就数着两条街道最热闹。
南北一条宽敞的街道，一看就是刚刚修建好不久，街道的石板是
由山上采来的碧石铺成。东西那条街道要陈旧一点，碧石的颜色
已经有些暗淡了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城的中心，两条街道在这里划个大十字。整个星龙城就数着
两条街道最热闹了。南北一条宽敞的街道，一看就是刚刚修建好
不久，街道的石板是由山上采来的碧石铺成。东西那条街道要陈
旧一点，碧石的颜色已经有些暗淡了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城的中
心，两条街道在这里划个大十字。整个星龙城就数着两条街道最
热闹了。南北一条宽敞的街道，一看就是刚刚修建好不久，街道
的石板是由山上采来的碧石铺成。东西那条街道要陈旧一点，碧
石的颜色已经有些暗淡了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城的
中心，两条街道在这里划个大十字。整个星龙城就数着两条街道
最热闹了。南北一条宽敞的街道，一看就是刚刚修建好不久，街
道的石板是由山上采来的碧石铺成。东西那条街道要陈旧一点，
碧石的颜色已经有些暗淡了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城的中心，两条街道
在这里划个大十字。整个星龙城就数着两条街道最热闹了。南北
一条宽敞的街道，一看就是刚刚修建好不久，街道的石板是由山
上采来的碧石铺成。东西那条街道要陈旧一点，碧石的颜色已经
有些暗淡了。
LONG
        );
    }
    return 0;
  }
}
