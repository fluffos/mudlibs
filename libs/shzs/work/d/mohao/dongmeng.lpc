// Room: /d/mohao/dongmeng.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "东城门");
  set("long", @LONG
这里是星龙城的东城门。出城是一条大道，好多外地到星龙城的
人都从这里进城，星龙将在这里设关卡查问过往行人。一到局势
不稳的时候这里就特别的紧张。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "east": "/d/sandboy/to_zhongzhou",
    "west": __DIR__ "yanlingdong2",
  ]));
  set("outdoors", "/d/mohao");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里是星龙城的东城门。
出城是一条大道，好多外地到星龙城的人都从这里进城，星龙将
在这里设关卡查问过往行人。一到局势不稳的时候这里就特别的
紧张。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
是星龙城的东城门。出城是一条大道，好多外地到星龙城的人都
从这里进城，星龙将在这里设关卡查问过往行人。一到局势不稳
的时候这里就特别的紧张。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里是星龙城的
东城门。出城是一条大道，好多外地到星龙城的人都从这里进城，
星龙将在这里设关卡查问过往行人。一到局势不稳的时候这里就
特别的紧张。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里是星龙城
的东城门。出城是一条大道，好多外地到星龙城的人都从这里进
城，星龙将在这里设关卡查问过往行人。一到局势不稳的时候这
里就特别的紧张。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这里是星龙城的东城门。出城
是一条大道，好多外地到星龙城的人都从这里进城，星龙将在这
里设关卡查问过往行人。一到局势不稳的时候这里就特别的紧张。
LONG
        );
    }
    return 0;
  }
}
