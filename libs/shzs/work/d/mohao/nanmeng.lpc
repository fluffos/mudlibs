// Room: /d/zhongzhou/nanmeng.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "南城门");
  set("long", @LONG
到了星龙城的南城门了。出了城不远就是一大片的树林。听说南
城门外一带经常有妖兽出没。可在这里把守的战将比较多，所以
城里倒也太平无事。
LONG
  );

  set("outdoors", "/d/mohao");
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "wendingnan4",
    "south": __DIR__ "nroad",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。到了星龙城的南城门了。
出了城不远就是一大片的树林。听说南城门外一带经常有妖兽出没。
可在这里把守的战将比较多，所以城里倒也太平无事。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。到了
星龙城的南城门了。出了城不远就是一大片的树林。听说南城门
外一带经常有妖兽出没。可在这里把守的战将比较多，所以城里
倒也太平无事。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。到了星龙城的南
城门了。出了城不远就是一大片的树林。听说南城门外一带经常
有妖兽出没。可在这里把守的战将比较多，所以城里倒也太平无事。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。到了星龙城的
南城门了。出了城不远就是一大片的树林。听说南城门外一带经
常有妖兽出没。可在这里把守的战将比较多，所以城里倒也太平
无事。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。到了星龙城的南城门了。出了
城不远就是一大片的树林。听说南城门外一带经常有妖兽出没。
可在这里把守的战将比较多，所以城里倒也太平无事。
LONG
        );
    }
    return 0;
  }
}
