//bye enter

#include <room.h>
#include <ansi.h>

inherit ROOM;
int do_look(string arg);
int do_jump(string arg);

void create() {
  set("short", "小亭");
  set("long", @LONG
你正站在湖边的一个小亭里，通过一条蜿蜒的走廊可以回到大厅。
小亭修筑地相当雅致，在这里可以欣赏池塘中的荷花和金鱼，亭
子北面湖中竖着几根木桩，远处的湖中有个小岛，朦胧间看得却
是不太真切。
LONG
  );

  set("exits", ([
    "south": __DIR__ "zoulang4",
  ]));

  set("item_desc", ([
    "木桩": "这是几根分布得怪里怪气的木桩，看上去不是很结实。"
  ]));
  setup();
}

void init() {
  object book, me;
  me = this_player();
  add_action("do_jump", "jump");
  add_action("do_look", "look");
}



int do_jump(string arg) {
  int n;
  n = this_player()->query_skill("dodge");
  if (!arg || arg != "木桩") {
    write("不要乱跳，现在是冬天，可不是能游泳的季节哦！\n");
    return 1;
  }


  message_vision(
    "$N深深地吸了口气，猛地跃了起来。\n", this_player());

  if (n >= 100) {
    message_vision(
      "只见$N轻轻一跃，稳稳地站在湖中的木桩上，几下起落，已经到达了湖中小岛。\n", this_player());
    this_player()->move(__DIR__ "xiaodao");
  } else {
    message_vision(
      "$N高高跃起,重重地落在木桩上，结果把木桩踩断了！“扑通”一声掉进水中。\n", this_player());
    this_player()->move(__DIR__ "huli");
  }
  return 1;
}



//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你正站在
湖边的一个小亭里，通过一条蜿蜒的走廊可以回到大厅。小亭修
筑地相当雅致，在这里可以欣赏池塘中的荷花和金鱼，亭子北面
湖中竖着几根木桩，远处的湖中有个小岛，朦胧间看得却是不太
真切。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你正站在湖
边的一个小亭里，通过一条蜿蜒的走廊可以回到大厅。小亭修筑
地相当雅致，在这里可以欣赏池塘中的荷花和金鱼，亭子北面湖
中竖着几根木桩，远处的湖中有个小岛，朦胧间看得却是不太真
切。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你正站在湖边
的一个小亭里，通过一条蜿蜒的走廊可以回到大厅。小亭修筑地
相当雅致，在这里可以欣赏池塘中的荷花和金鱼，亭子北面湖中
竖着几根木桩，远处的湖中有个小岛，朦胧间看得却是不太真切。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你正站在湖边的一个小
亭里，通过一条蜿蜒的走廊可以回到大厅。小亭修筑地相当雅致，
在这里可以欣赏池塘中的荷花和金鱼，亭子北面湖中竖着几根木
桩，远处的湖中有个小岛，朦胧间看得却是不太真切。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。你正站在湖边的一个小亭里，通过
一条蜿蜒的走廊可以回到大厅。小亭修筑地相当雅致，在这里可
以欣赏池塘中的荷花和金鱼，亭子北面湖中竖着几根木桩，远处
的湖中有个小岛，朦胧间看得却是不太真切。
LONG
        );
    }
    return 0;
  }
}
