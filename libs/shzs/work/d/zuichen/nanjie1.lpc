inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "南大街");
  set("long", @LONG
这里污水横流而过，臭气熏天，只是时而有几只饥饿的巨鼠窜出
来找东西吃，两边的房屋歪歪斜斜的树立着，这些都是历次地震
的产物，再加上周围的空气中弥漫着一种紫色的怪雾......人们
一般不会到这种地方来的。你没事最好不要在这里溜达，因为这
里是极乐城的大街，说不定有谁看你不顺眼一个不小心就把你送
去轮回。

         __            _,-"~^"-.
       _// )      ,-"~`         `.
     ." ( /`"-,-"`                ;
    / 6                            ;
   /           ,            ,-"     ;
  (,__.--.      \          /        ;
   //'   /`-.\   |         |        `.__
     _.-'_/`  )  )-...,,,___\     \----,)
   ((("~` _.-'.-'          __`-.   )  (/______
        ((("`            (((---~"`     ""~

LONG
  );
  set("outdoors", "zuicheng");

  set("exits", ([
    "south": __DIR__ "nanjie2",
    "north": __DIR__ "guangchang",
    "east": __DIR__ "chunxilu3",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
