inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "春熙路口");
  set("long", @LONG
这里是极乐城最繁华的地带——春熙路，并不宽的街道两旁，店
铺林立汉白玉砌的路面几乎能照出人影。路上的行人摩肩接踵，
都在为各自的生计奔波着。一派繁荣，富庶的景象。不远处的公
告栏(sign)站着两名衣甲鲜明的卫兵。不时警惕的看着你。
LONG);

  set("outdoors", "/d/zuicheng");


  set("exits", ([
    "west": __DIR__ "nanjie1",
    "north": __DIR__ "chunxilu2",
  ]));
  set("item_desc", ([
    "sign": "罪之城，欢迎乱来，否则弄凶！\n",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是极
乐城最繁华的地带——春熙路，并不宽的街道两旁，店铺林立汉
白玉砌的路面几乎能照出人影。路上的行人摩肩接踵，都在为各
自的生计奔波着。一派繁荣，富庶的景象。不远处的公告栏(sign)
站着两名衣甲鲜明的卫兵。不时警惕的看着你。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是极乐
城最繁华的地带——春熙路，并不宽的街道两旁，店铺林立汉白
玉砌的路面几乎能照出人影。路上的行人摩肩接踵，都在为各自
的生计奔波着。一派繁荣，富庶的景象。不远处的公告栏(sign)
站着两名衣甲鲜明的卫兵。不时警惕的看着你。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是极乐城
最繁华的地带——春熙路，并不宽的街道两旁，店铺林立汉白玉
砌的路面几乎能照出人影。路上的行人摩肩接踵，都在为各自的
生计奔波着。一派繁荣，富庶的景象。不远处的公告栏(sign)站
着两名衣甲鲜明的卫兵。不时警惕的看着你。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是极乐城最繁华的
地带——春熙路，并不宽的街道两旁，店铺林立汉白玉砌的路面
几乎能照出人影。路上的行人摩肩接踵，都在为各自的生计奔波
着。一派繁荣，富庶的景象。不远处的公告栏(sign)站着两名衣
甲鲜明的卫兵。不时警惕的看着你。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这里是极乐城最繁华的地带——春
熙路，并不宽的街道两旁，店铺林立汉白玉砌的路面几乎能照出
人影。路上的行人摩肩接踵，都在为各自的生计奔波着。一派繁
荣，富庶的景象。不远处的公告栏(sign)站着两名衣甲鲜明的卫
兵。不时警惕的看着你。
LONG
        );
    }
    return 0;
  }
}
