//bye enter

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "占卜铺子");
  set("long", @LONG
门口挂着一块招牌(sign),里面显得有些空空荡荡的,瞎眼先生坐
在一张黑漆的方桌后,桌上铺者一张白布,上面摆着一筒算命用的
竹签和几枚铜钱。方桌前有一张供客人坐的凳子。
LONG
  );

  set("exits", ([
    "south": __DIR__ "xijie1",
  ]));

  set("item_desc", ([
    "sign": "人算不如天算，天算不如我算。\n",
  ]));


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。门口挂着
一块招牌(sign),里面显得有些空空荡荡的,瞎眼先生坐在一张黑
漆的方桌后,桌上铺者一张白布,上面摆着一筒算命用的竹签和几
枚铜钱。方桌前有一张供客人坐的凳子。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。门口挂着一
块招牌(sign),里面显得有些空空荡荡的,瞎眼先生坐在一张黑漆
的方桌后,桌上铺者一张白布,上面摆着一筒算命用的竹签和几枚
铜钱。方桌前有一张供客人坐的凳子。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。门口挂着一块
招牌(sign),里面显得有些空空荡荡的,瞎眼先生坐在一张黑漆的
方桌后,桌上铺者一张白布,上面摆着一筒算命用的竹签和几枚铜
钱。方桌前有一张供客人坐的凳子。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。门口挂着一块招牌(sign),
里面显得有些空空荡荡的,瞎眼先生坐在一张黑漆的方桌后,桌上
铺者一张白布,上面摆着一筒算命用的竹签和几枚铜钱。方桌前有
一张供客人坐的凳子。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。门口挂着一块招牌(sign),里面显得
有些空空荡荡的,瞎眼先生坐在一张黑漆的方桌后，桌上铺者一张
白布,上面摆着一筒算命用的竹签和几枚铜钱。方桌前有一张供客
人坐的凳子。
LONG
        );
    }
    return 0;
  }
}
