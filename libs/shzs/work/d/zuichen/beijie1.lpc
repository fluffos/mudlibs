// Room: beijie1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "北大街");
  set("long", @LONG
这里污水横流而过，臭气熏天，周围的空气中弥漫着一种紫色的
怪雾。东边是一座两层的楼阁，挂着“麻婆腐肉”的招帘，门额
上悬挂一方横匾“麻倒为止”四字擦得闪闪发亮，乃是极乐城主
--极乐女皇的手笔。阵阵腐肉香味扑鼻而来,让你垂涎欲滴。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "zuicheng");
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "chenmapo",
    "south": __DIR__ "beijie2",
    "north": __DIR__ "northchengmen",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里污水
横流而过，臭气熏天，周围的空气中弥漫着一种紫色的怪雾。东
边是一座两层的楼阁，挂着“麻婆腐肉”的招帘，门额上悬挂一
方横匾“麻倒为止”四字擦得闪闪发亮，乃是极乐城主--极乐女
皇的手笔。阵阵腐肉香味扑鼻而来,让你垂涎欲滴。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里污水横
流而过，臭气熏天，周围的空气中弥漫着一种紫色的怪雾。东边
是一座两层的楼阁，挂着“麻婆腐肉”的招帘，门额上悬挂一方
横匾“麻倒为止”四字擦得闪闪发亮，乃是极乐城主--极乐女皇
的手笔。阵阵腐肉香味扑鼻而来,让你垂涎欲滴。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里污水横流
而过，臭气熏天，周围的空气中弥漫着一种紫色的怪雾。东边是
一座两层的楼阁，挂着“麻婆腐肉”的招帘，门额上悬挂一方横
匾“麻倒为止”四字擦得闪闪发亮，乃是极乐城主--极乐女皇的
手笔。阵阵腐肉香味扑鼻而来,让你垂涎欲滴。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里污水横流而过，臭
气熏天，周围的空气中弥漫着一种紫色的怪雾。东边是一座两层
的楼阁，挂着“麻婆腐肉”的招帘，门额上悬挂一方横匾“麻倒
为止”四字擦得闪闪发亮，乃是极乐城主--极乐女皇的手笔。阵
阵腐肉香味扑鼻而来,让你垂涎欲滴。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这里污水横流而过，臭气熏天，周
围的空气中弥漫着一种紫色的怪雾。东边是一座两层的楼阁，挂
着“麻婆腐肉”的招帘，门额上悬挂一方横匾“麻倒为止”四字
擦得闪闪发亮，乃是极乐城主--极乐女皇的手笔。阵阵腐肉香味
扑鼻而来,让你垂涎欲滴。
LONG
        );
    }
    return 0;
  }
}
