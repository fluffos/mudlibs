//bye enter

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小院子");
  set("long", @LONG
这里是个小院子，打扫得甚为整洁，旁边有棵大树，院子内放了
一些扫把等杂物。往北是个不大的客厅。
LONG
  );

  set("outdoors", "zuichen");
  set("exits", ([
    "southwest": __DIR__ "xiaodao1",
    "north": __DIR__ "xiaoting",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是个
小院子，打扫得甚为整洁，旁边有棵大树，院子内放了一些扫把
等杂物。往北是个不大的客厅。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是个小
院子，打扫得甚为整洁，旁边有棵大树，院子内放了一些扫把等
杂物。往北是个不大的客厅。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是个小院
子，打扫得甚为整洁，旁边有棵大树，院子内放了一些扫把等杂
物。往北是个不大的客厅。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是个小院子，打扫
得甚为整洁，旁边有棵大树，院子内放了一些扫把等杂物。往北
是个不大的客厅。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这里是个小院子，打扫得甚为整洁，
旁边有棵大树，院子内放了一些扫把等杂物。往北是个不大的客厅。
LONG
        );
    }
    return 0;
  }
}
