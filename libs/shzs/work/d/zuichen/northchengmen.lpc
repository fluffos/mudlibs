#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "北城门");
  set("long",
    "这是北城门，因为是" HIM "极乐城" NOR "的门面之一，因此修建的特别\n"
    "雄伟,而且极乐城是一个自由之都,进城之前最好看看白纸黑字的\n" "" HIW "告示" NOR "(gaoshi)。" HIW "                                                                                            
                     s________________s         
                    /LLLLLLLLLLLLLLLLLL\      
                   ^^||======||======||^^
                     ||      ||      ||
                     ||      ||      ||                
