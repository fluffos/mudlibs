    |__|__|__|__|__|__|_┏━━━┓_|__|__|__|__|__|__    
   ___|__|__|__|__|__|_ ┃极乐城┃__|__|__|__|__|__|_ 
    |__|__|__|__|__|__| ┗━━━┛_|__|__|__|__|__|__
  _ __|__|__|__|__|__|__/      \|__|__|__|__|__|__|_
    |__|__|__|__|__|__||        |_|_____|__|__|__|__
    __|__|__|__|__|__|_|        |__┌┐┌┐_|___|__|_
    _|__|__|__|__|__|__|        |_|└┘└┘|__|__|__
    __|__|__|__|__|__|_|        |__|__|__|__|__|__|_
    _|__|__|__|__|__|__|        |_|__|__|__|__|__|__
" NOR "\n"


  );

  set("exits", ([
    "north": __DIR__ "dadao5",
    "south": __DIR__ "beijie1",
  ]));
  set("item_desc", ([
    "gaoshi": "如果你不遵纪守法,那么你在极乐城将过的很愉快,\n
否则你将受到严厉的处罚----连吃七百顿麻辣腐肉! \n
极乐城安抚使--麻婆。\n)",
  ]));



  set("outdoors", "zuicheng");
  setup();

}


void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
