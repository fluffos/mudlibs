// houhuayuan.c 后花园
// By Lgg,1998.10

inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
这里是一个小花园，杂乱地种着各种花草，看来无人打理，杂草
已经长得很高了。有一些红的，白的鲜花夹杂在草丛中，阵阵花
香不断地飘过。东面有一道小门，南面是一座两层小楼。
LONG
  );
  set("outdoors", "out");
  set("exits", ([
    "northwest": __DIR__ "fu-houyuan",
    "south": __DIR__ "guanjinglou",
    "east": __DIR__ "houhuayuan1",
  ]));
  set("no_clean_up", 0);
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，夜色如水，这里是一个小花园，杂乱地种着
各种花草，看来无人打理，杂草已经长得很高了。有一些红的，
白的鲜花夹杂在草丛中，阵阵花香不断地飘过。东面有一道小门，
南面是一座两层小楼。

LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。这里是一个小花园，
杂乱地种着各种花草，看来无人打理，杂草已经长得很高了。有
一些红的，白的鲜花夹杂在草丛中，阵阵花香不断地飘过。东面
有一道小门，南面是一座两层小楼。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，阳光普照，这里是一个小花园，杂乱地种着各种花草，
看来无人打理，杂草已经长得很高了。有一些红的，白的鲜花夹
杂在草丛中，阵阵花香不断地飘过。东面有一道小门，南面是一
座两层小楼。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这里是一个小花园，杂乱地
种着各种花草，看来无人打理，杂草已经长得很高了。有一些红
的，白的鲜花夹杂在草丛中，阵阵花香不断地飘过。东面有一道
小门，南面是一座两层小楼。
LONG
        );
      else  //入夜
        set("long", @LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这里
是一个小花园，杂乱地种着各种花草，看来无人打理，杂草已经
长得很高了。有一些红的，白的鲜花夹杂在草丛中，阵阵花香不
断地飘过。东面有一道小门，南面是一座两层小楼。
LONG
        );
    }
    return 0;
  }
}
