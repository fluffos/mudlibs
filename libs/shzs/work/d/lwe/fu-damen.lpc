// fu-damen 富家大门
// By Lgg,1998.10
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "大门");
  set("long", @LONG
这里是旅馆老板家的大门，门内立着一面朱红的影壁，高大而宏
伟。两棵双人合抱的巨树整齐的排在两边。只听到树上的小鸟时
而不时的啾鸣几声，这里到处都散发着安祥宁静的气氛。
LONG
  );
  set("exits", ([
    "north": __DIR__ "jie1",
    "south": __DIR__ "fu-xiaoyuan",
  ]));
  set("doors", ([
    "north": ([
      "data": "门",
      "other_side_dir": "south",

      "key_id": "lwe/kedian_key",
    ]),
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，夜色如水，这里是旅馆老板家的大门，门内
立着一面朱红的影壁，高大而宏伟。两棵双人合抱的巨树整齐的
排在两边。只听到树上的小鸟时而不时的啾鸣几声，这里到处都
散发着安祥宁静的气氛。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。这里是旅馆老板家
的大门，门内立着一面朱红的影壁，高大而宏伟。两棵双人合抱
的巨树整齐的排在两边。只听到树上的小鸟时而不时的啾鸣几声，
这里到处都散发着安祥宁静的气氛。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，阳光普照，这里是旅馆老板家的大门，门内立着一面
朱红的影壁，高大而宏伟。两棵双人合抱的巨树整齐的排在两边。
只听到树上的小鸟时而不时的啾鸣几声，这里到处都散发着安祥
宁静的气氛。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这里是旅馆老板家的大门，
门内立着一面朱红的影壁，高大而宏伟。两棵双人合抱的巨树整
齐的排在两边。只听到树上的小鸟时而不时的啾鸣几声，这里到
处都散发着安祥宁静的气氛。
LONG
        );
      else  //入夜
        set("long", @LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这里
是旅馆老板家的大门，门内立着一面朱红的影壁，高大而宏伟。
两棵双人合抱的巨树整齐的排在两边。只听到树上的小鸟时而不
时的啾鸣几声，这里到处都散发着安祥宁静的气氛。
LONG
        );
    }
    return 0;
  }
}
