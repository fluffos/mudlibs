// Room: /d/village/shop.c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "防具店");
  set("long", @LONG
这是一间小小的防具店，靠墙整齐地放着一个个大柜子，不少柜
子门敞开着，露出里面的各种防具，品种之多，是你生平仅见。
LONG
  );
  set("exits", ([
    "west": __DIR__ "jie11",
  ]));
  set("no_clean_up", 0);

  set("objects", ([
    __DIR__ "npc/faju": 1
  ]));
  set("doors", ([
    "west": ([
      "data": "门",
      "other_side_dir": "east",
      //		"status"	:	DOOR_LOCKED,
      "key_id": "lwe/shop2_key",
    ]), ]));


  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，这是一间小小的防具店，靠墙整齐地放着一
个个大柜子，不少柜子门敞开着，露出里面的各种防具，品种之
多，是你生平仅见。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天边已现出乳白色，已经是清晨了。这是一间小小的防具店，靠
墙整齐地放着一个个大柜子，不少柜子门敞开着，露出里面的各
种防具，品种之多，是你生平仅见。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，阳光照在这是一间小小的防具店，靠墙整齐地放着一
个个大柜子，不少柜子门敞开着，露出里面的各种防具，品种之多，
是你生平仅见。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进防具店，靠墙整齐地放着一个个大柜子，不少柜
子门敞开着，露出里面的各种防具，品种之多，是你生平仅见。
LONG
        );
      else  //入夜
        set("long", @LONG
城中的炊烟正在袅袅升起，是晚餐时分了。晚上出门为了安全还
是买套防具再上路吧。这是一间小小的防具店，靠墙整齐地放着
一个个大柜子，不少柜子门敞开着，露出里面的各种防具，品种
之多，是你生平仅见。
LONG
        );
    }
    return 0;
  }
}
