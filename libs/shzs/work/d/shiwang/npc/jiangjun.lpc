void init() {
  ::init();
  add_action("do_vendor_list", "list");
}


mixed affirm_merchandise(object customer, string item_name) {
  if (on_service)
    return notify_fail("老板正忙着招呼其他客人，您请等一会儿。\n");
  return ::affirm_merchandise(customer, item_name);
}

private void handover(object customer, mixed item) {
  on_service = 0;
  if (!customer || environment(customer) != environment()) {
    command("say 刚刚那位客人呢 ? 怎么付了钱人却不见了 ? ....");
    message_vision("$N 把端出来的" + item->name() + "放回身后。\n", this_object());
    return;
  }
  command("say 您的" + item->name() + "送来了。");
  message_vision("$N 把热气腾腾的" + item->name()
    + "送到 $n 面前。 \n", this_object(), customer);
  ::deliver_merchandise(customer, item);
}

void deliver_merchandise(object customer, mixed item) {
  command("say " + item->name() + "? 请您稍等一下。");
  message_vision("$N 向后面的厨房叫道 " + item->name() + "一份。\n", this_object());
  on_service = 1;
  do_chat((: handover, customer, item :));
}

void prepare_kill() {
  if (query_temp("pending/prepare_kill")) return;

  command("wield dagger");
  command("say 哼 ! 你这个杀人的凶手 !!");
  set_temp("pending/prepare_kill", 1);
}
void kill_ob(object ob) {
  ob->remove_killer(this_object());
  remove_killer(ob);
  message_vision("旅馆老板突然大呵一声“魔神召来，元神合体”。                  
             ''`''.
         .-./ _=_ \.-.
        {  (,(oYo),) }}
        {{ +   `   +} }
        { { \\(---)/  }}
        {{  }'-=-'{ } }
        { { }._1_.{  }}
        {{  } -1- { } }
        {_{ }`===`{  _}
       ((((\)     (/))))

\n", ob);
  message_vision("旅馆老板在你眼前化身为一只巨兽！！！！\n
	巨兽一记重拳向你打来，“轰”。\n", ob);
}
