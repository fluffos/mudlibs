#include <ansi.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "狮王宫");
  set("long", @LONG
狮王宫分前后两部分，前殿是狮王日场处理政务之所。三级御阶
之上是狮王的座椅，台阶之间高脚琉璃灯大放光明。

