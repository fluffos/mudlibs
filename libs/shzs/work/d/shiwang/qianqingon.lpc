                        ，%%/\%%%%/\%，
                       ，%%%\c "" J/%%，
  %。                   %%%%/ d  b \%%%
  `%%。         __      %%%%    _  |%%%
   `%%      。-'  `"~--"`%%%%(=_Y_=)%%'
    //    。'     `。     `%%%%`\7/%%%'____
   ((    /         ;      `%%%%%%%'____)))
   `。`--'         ，'   _，`-。_____`-，   
     `"""`。_____  `--，`          `
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "shangshufang",
    "south": __DIR__ "qianqinmen",
  ]));
  set("no_clean_up", 1);
  set("no_steal", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
