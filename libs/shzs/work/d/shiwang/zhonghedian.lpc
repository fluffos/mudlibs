// Room: shiwang/zhonghedian
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "狮王中殿");
  set("long", @LONG
狮王中殿是一较小的方殿，狮王早朝，先在此接受执事官员的朝
拜，也是狮王出席重大典礼休息的地方。
LONG);

  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "taiyiyuan",
    "south": __DIR__ "taihedian",

  ])); set("objects", ([
    __DIR__ "npc/king": 1,

  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
狮王中殿是一较小的方殿，狮王早朝，先在此接受执事官员的朝
拜，也是狮王出席重大典礼休息的地方。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。狮王中殿是一较小的方殿，
狮王早朝，先在此接受执事官员的朝拜，也是狮王出席重大典礼
休息的地方。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。狮王中殿是一
较小的方殿，狮王早朝，先在此接受执事官员的朝拜，也是狮王
出席重大典礼休息的地方。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。狮王中殿是一较小的方
殿，狮王早朝，先在此接受执事官员的朝拜，也是狮王出席重大
典礼休息的地方。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。狮王
中殿是一较小的方殿，狮王早朝，先在此接受执事官员的朝拜，
也是狮王出席重大典礼休息的地方。
LONG
        );
    }
    return 0;
  }
}
