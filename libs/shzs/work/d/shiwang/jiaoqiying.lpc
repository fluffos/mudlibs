// Room: /d/huanggon/jiaoqiying.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "骁骑营");
  set("long", @LONG
骁骑营是狮王帝国内三军之一，辅助狮王狂狮治理帝国附近的区
域。营内老大一个马厩，养了几百匹良马，骁骑营的统领青毛狮
是狂狮的弟弟，极得狂狮信赖。北面是人来人往的东大街。
                      
    ("`-''-/").___..--''"`-._
     `6_ 6  )   `-.  (     ).`-.__.`)
     (_Y_.)'  ._   )  `._ `. ``-..-'
   _..`--'_..-_/  /--'_.' ,'
  (il),-''  (li),'  ((!.-'    
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/king2": 1,
    __DIR__ "npc/jq2": 1,
    __DIR__ "npc/jq1": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "edajie",
  ]));
  set("outdoors", "shiwang");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
