// Room: shiwang/miaofa.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "妙法莲花寺");
  set("long", @LONG
妙法莲花寺在南大街的西侧，寺中长老当年也是狂狮的手下；后
厌倦了战斗的生活就在此寺修行。你如果要学读书识字的话，可
以向寺中长老请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/nokill": 1,


  ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "sdajie",
  ]));

  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
妙法莲花寺在南大街的西侧，寺中长老当年也是狂狮的手下；后
厌倦了战斗的生活就在此寺修行。你如果要学读书识字的话，可
以向寺中长老请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。妙法莲花寺在南大街的西
侧，寺中长老当年也是狂狮的手下；后厌倦了战斗的生活就在此
寺修行。你如果要学读书识字的话，可以向寺中长老请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。妙法莲花寺在
南大街的西侧，寺中长老当年也是狂狮的手下；后厌倦了战斗的
生活就在此寺修行。你如果要学读书识字的话，可以向寺中长老
请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。妙法莲花寺在南大街的
西侧，寺中长老当年也是狂狮的手下；后厌倦了战斗的生活就在
此寺修行。你如果要学读书识字的话，可以向寺中长老请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。妙法
莲花寺在南大街的西侧，寺中长老当年也是狂狮的手下；后厌倦
了战斗的生活就在此寺修行。你如果要学读书识字的话，可以向
寺中长老请教。

         
                      ______ ______
                    _/      Y      \_
                   //  读   |   识  \\
                  //  书    |    字  \\  
                 //________.|.________\\ 
                `----------`-'----------'
LONG
        );
    }
    return 0;
  }
}
