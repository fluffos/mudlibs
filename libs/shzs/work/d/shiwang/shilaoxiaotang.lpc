// Room: /d/huanggon/shilaoxiaotang
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "石牢小堂");
  set("long", @LONG
石牢内的一座小堂，四面的石壁极为厚实，北面墙壁上开了个铁
窗。里面传来铁链叮当声，有人在里面大声咆哮。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "shilaozoulang",
  ]));

  setup();
}
void init() {
  add_action("do_kan", "kan");
  add_action("do_look", "look");
}
int do_kan(string arg) {
  object ob;
  if (!arg || arg != "铁条") return notify_fail("你要砍什么?\n");
  ob = this_player();
  if (!present("yitian jian", ob) && !present("tulong dao", ob))
    return notify_fail("你砍了一阵窗上的铁条，看来没什么起色。\n");
  if (present("yitian jian", ob)) {
    message_vision("$N取出依天剑，将铁窗上的铁条一一削落，墙上
 开了个大口子，看来能进去了。\n", ob);
    set("exits/down", __DIR__ "shilaonei");
    ob->set_temp("aobai", 1);
    return 1;
  }
  if (present("tulong dao", ob)) {
    message_vision("$N取出屠龙刀，对窗户上的铁条一阵乱削，
 窗户马上开了个大口子，看来能进了。\n", ob);
    set("exits/down", __DIR__ "shilaonei");
    ob->set_temp("aobai", 1);
    return 1;
  }
  return 1;
}



//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
石牢内的一座小堂，四面的石壁极为厚实，北面墙壁上开了个铁
窗。里面传来铁链叮当声，有人在里面大声咆哮。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。石牢内的一座小堂，四面
的石壁极为厚实，北面墙壁上开了个铁窗。里面传来铁链叮当声，
有人在里面大声咆哮。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。石牢内的一座
小堂，四面的石壁极为厚实，北面墙壁上开了个铁窗。里面传来
铁链叮当声，有人在里面大声咆哮。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。石牢内的一座小堂，四
面的石壁极为厚实，北面墙壁上开了个铁窗。里面传来铁链叮当
声，有人在里面大声咆哮。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。石牢
内的一座小堂，四面的石壁极为厚实，北面墙壁上开了个铁窗。
里面传来铁链叮当声，有人在里面大声咆哮。
LONG
        );
    }
    return 0;
  }
}
