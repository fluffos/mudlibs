// Room: /d/huanggon/echangan1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "东城街");
  set("long", @LONG
东城街东西走向，是帝国繁华之地，道上行人，商贩，游客，艺
人来往不绝，街道的南边是家钱庄，里边传出一阵劈里啪啦打算
盘的声音。东面是朝阳门。
LONG
  );
  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "chaoyangmen",
    "west": __DIR__ "echangan",
    "south": __DIR__ "qianzhua",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
东城街东西走向，是帝国繁华之地，道上行人，商贩，游客，艺
人来往不绝，街道的南边是家钱庄，里边传出一阵劈里啪啦打算
盘的声音。东面是朝阳门。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。东城街东西走向，是帝国
繁华之地，道上行人，商贩，游客，艺人来往不绝，街道的南边
是家钱庄，里边传出一阵劈里啪啦打算盘的声音。东面是朝阳门。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。东城街东西走
向，是帝国繁华之地，道上行人，商贩，游客，艺人来往不绝，
街道的南边是家钱庄，里边传出一阵劈里啪啦打算盘的声音。东
面是朝阳门。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。东城街东西走向，是帝
国繁华之地，道上行人，商贩，游客，艺人来往不绝，街道的南
边是家钱庄，里边传出一阵劈里啪啦打算盘的声音。东面是朝阳
门。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。东城
街东西走向，是帝国繁华之地，道上行人，商贩，游客，艺人来
往不绝，街道的南边是家钱庄，里边传出一阵劈里啪啦打算盘的
声音。东面是朝阳门。
LONG
        );
    }
    return 0;
  }
}
