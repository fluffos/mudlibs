// Room: shiwang/xiaogardon1
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小花园");
  set("long", @LONG
王府中的小花园，园中建了副秋千，是平时家中女眷流连的处所。
四边无非是些花木，西面是后花园，南边穿过月洞门可以去王府
天井。北边不远是所精致的小屋。
LONG);

  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "kangxiaowu",
    "west": __DIR__ "hougardon",
    "south": __DIR__ "xiaogardon",
  ]));
  set("outdoors", "shiwang");
  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
王府中的小花园，园中建了副秋千，是平时家中女眷流连的处所
四边无非是些花木，西面是后花园，南边穿过月洞门可以去王府
天井。北边不远是所精致的小屋。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。王府中的小花园，园中建
了副秋千，是平时家中女眷流连的处所。四边无非是些花木，西
面是后花园，南边穿过月洞门可以去王府天井。北边不远是所精
致的小屋。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。王府中的小花
园，园中建了副秋千，是平时家中女眷流连的处所。四边无非是
些花木，西面是后花园，南边穿过月洞门可以去王府天井。北边
不远是所精致的小屋。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。王府中的小花园，园中
建了副秋千，是平时家中女眷流连的处所。四边无非是些花木，
西面是后花园，南边穿过月洞门可以去王府天井。北边不远是所
精致的小屋。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。王府
中的小花园，园中建了副秋千，是平时家中女眷流连的处所。四
边无非是些花木，西面是后花园，南边穿过月洞门可以去王府天
井。北边不远是所精致的小屋。
LONG
        );
    }
    return 0;
  }
}
