LONG);

  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "wchangan",
    "north": __DIR__ "xidan",
    "south": __DIR__ "xidan1",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
