// Room: shiwang/majiu.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "马厩");
  set("long", @LONG
马厩分成内外两部分，外面是片空场，以便遛马梳理，里面两排
水槽边拴了十多匹马，马厩角落中堆放着些青草，一边的几个铁
皮桶里泡的是大豆，墙上挂着几副鞍佩和马鞭。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "tingyuan",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
马厩分成内外两部分，外面是片空场，以便遛马梳理，里面两排
水槽边拴了十多匹马，马厩角落中堆放着些青草，一边的几个铁
皮桶里泡的是大豆，墙上挂着几副鞍佩和马鞭。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。马厩分成内外两部分，外
面是片空场，以便遛马梳理，里面两排水槽边拴了十多匹马，马
厩角落中堆放着些青草，一边的几个铁皮桶里泡的是大豆，墙上
挂着几副鞍佩和马鞭。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。马厩分成内外
两部分，外面是片空场，以便遛马梳理，里面两排水槽边拴了十
多匹马，马厩角落中堆放着些青草，一边的几个铁皮桶里泡的是
大豆，墙上挂着几副鞍佩和马鞭。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。马厩分成内外两部分，
外面是片空场，以便遛马梳理，里面两排水槽边拴了十多匹马，
马厩角落中堆放着些青草，一边的几个铁皮桶里泡的是大豆，墙
上挂着几副鞍佩和马鞭。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。马厩
分成内外两部分，外面是片空场，以便遛马梳理，里面两排水槽
边拴了十多匹马，马厩角落中堆放着些青草，一边的几个铁皮桶
里泡的是大豆，墙上挂着几副鞍佩和马鞭。
LONG
        );
    }
    return 0;
  }
}
