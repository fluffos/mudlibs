// Room: /d/huanggon/tongyaopu。c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "药铺");
	set("long", @LONG
这家药铺在帝国很有名气，听说此地的药材还御供。你一进来就
闻到一股浓浓的药味，那是从药柜上的几百个小抽屉里散发出来
的，西面是间内室，用布帘遮挡着。
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"neishi1",
  "east" : __DIR__"xidan",
]));
	set("no_clean_up", 0);
        set("objects", ([
		__DIR__"npc/yaoshi" : 1,	            
                
	]));
	set("doors", ([
		"north"	:	([
				"data"		:	"门",
				"other_side_dir":	"south",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"shiwang/calou_key",
				]),]) );
	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这家药铺在帝国很有名气，听说此地的药材还御供。你一进来就
闻到一股浓浓的药味，那是从药柜上的几百个小抽屉里散发出来
的，西面是间内室，用布帘遮挡着。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这家药铺在帝国很有名气，
听说此地的药材还御供。你一进来就闻到一股浓浓的药味，那是
从药柜上的几百个小抽屉里散发出来的，西面是间内室，用布帘
遮挡着。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这家药铺在帝
国很有名气，听说此地的药材还御供。你一进来就闻到一股浓浓
的药味，那是从药柜上的几百个小抽屉里散发出来的，西面是间
内室，用布帘遮挡着。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这家药铺在帝国很有名
气，听说此地的药材还御供。你一进来就闻到一股浓浓的药味，
那是从药柜上的几百个小抽屉里散发出来的，西面是间内室，用
布帘遮挡着。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这家
药铺在帝国很有名气，听说此地的药材还御供。你一进来就闻到
一股浓浓的药味，那是从药柜上的几百个小抽屉里散发出来的，
西面是间内室，用布帘遮挡着。
LONG
);
		}
		return 0;
	}
}


