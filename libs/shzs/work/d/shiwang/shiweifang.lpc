// Room: /d/huanggon/shiweifang。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "侍卫房");
  set("long", @LONG
侍卫房是御前侍卫的总部，也是他们交接班的地方，现任的总管
是紫狮，据说武功十分高明。里面靠墙摆了十多张椅子，角落中
放了些刀剑。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "baohedian",
    "east": __DIR__ "shiweifang1",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
侍卫房是御前侍卫的总部，也是他们交接班的地方，现任的总管
是紫狮，据说武功十分高明。里面靠墙摆了十多张椅子，角落中
放了些刀剑。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。侍卫房是御前侍卫的总部，
也是他们交接班的地方，现任的总管是紫狮，据说武功十分高明。
里面靠墙摆了十多张椅子，角落中放了些刀剑。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。侍卫房是御前
侍卫的总部，也是他们交接班的地方，现任的总管是紫狮，据说
武功十分高明。里面靠墙摆了十多张椅子，角落中放了些刀剑。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。侍卫房是御前侍卫的总
部，也是他们交接班的地方，现任的总管是紫狮，据说武功十分
高明。里面靠墙摆了十多张椅子，角落中放了些刀剑。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。侍卫
房是御前侍卫的总部，也是他们交接班的地方，现任的总管是紫
狮，据说武功十分高明。里面靠墙摆了十多张椅子，角落中放了
些刀剑。
LONG
        );
    }
    return 0;
  }
}
