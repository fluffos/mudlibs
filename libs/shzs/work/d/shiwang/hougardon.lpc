// Room: /d/huanggon/hougardon.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "后花园");
  set("long", @LONG
后花园显然的比较宽敞，小桥流水，假山竹林，花木深处还有石
桌椅，小巧处别见雅致，两只黄鹂鸟在枝头一唱一和，池塘中鸳
鸯对对，水中红鲤鱼划出一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
  );
  set("outdoors", "shiwang");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 3 */
    "east": __DIR__ "xiaogardon1",
    "south": __DIR__ "kangneiting",
    "west": __DIR__ "shiwu",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
后花园显然的比较宽敞，小桥流水，假山竹林，花木深处还有石
桌椅，小巧处别见雅致，两只黄鹂鸟在枝头一唱一和，池塘中鸳
鸯对对，水中红鲤鱼划出一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。后花园显然的比较宽敞，
小桥流水，假山竹林，花木深处还有石桌椅，小巧处别见雅致，
两只黄鹂鸟在枝头一唱一和，池塘中鸳鸯对对，水中红鲤鱼划出
一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。后花园显然的
比较宽敞，小桥流水，假山竹林，花木深处还有石桌椅，小巧处
别见雅致，两只黄鹂鸟在枝头一唱一和，池塘中鸳鸯对对，水中
红鲤鱼划出一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。后花园显然的比较宽敞，
小桥流水，假山竹林，花木深处还有石桌椅，小巧处别见雅致，
两只黄鹂鸟在枝头一唱一和，池塘中鸳鸯对对，水中红鲤鱼划出
一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。后花
园显然的比较宽敞，小桥流水，假山竹林，花木深处还有石桌椅，
小巧处别见雅致，两只黄鹂鸟在枝头一唱一和，池塘中鸳鸯对对，
水中红鲤鱼划出一道道虹影。西面是座石屋。

   ___       ___       ___       ___
  ('v')     ('v')     ('v')     ('v')
 ((   ))   ((   ))   ((   ))   ((   ))
-/-"---"---/-"---"---/-"---"---/-"---"--
LONG
        );
    }
    return 0;
