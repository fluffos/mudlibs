// Room: yaofang1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "药房");
  set("long", @LONG
一进到这里就有一股呛人的药味扑鼻而来，高高低低的橱柜里放
满了不知名的药品，正在那里配药的中年药师起身对你作了个揖，
冲着你诡异地笑了笑，好象有什么秘密不告诉你。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "zoulang1",
    "east": __DIR__ "danfang",
  ])); set("objects", ([
    __DIR__ "npc/guangmu": 1,

  ]));

  set("no_clean_up", 0);


  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。一进到这里就有一股呛人的药味扑
鼻而来，高高低低的橱柜里放满了不知名的药品，正在那里配药
的中年药师起身对你作了个揖，冲着你诡异地笑了笑，好象有什
么秘密不告诉你。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。一进到这里就有一股呛人的
药味扑鼻而来，高高低低的橱柜里放满了不知名的药品，正在那
里配药的中年药师起身对你作了个揖，冲着你诡异地笑了笑，好
象有什么秘密不告诉你。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。一进到这里就有一股呛
人的药味扑鼻而来，高高低低的橱柜里放满了不知名的药品，正
在那里配药的中年药师起身对你作了个揖，冲着你诡异地笑了笑，
好象有什么秘密不告诉你。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。一进到这里就有一股
呛人的药味扑鼻而来，高高低低的橱柜里放满了不知名的药品，
正在那里配药的中年药师起身对你作了个揖，冲着你诡异地笑了
笑，好象有什么秘密不告诉你。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。一进到这里就有一股呛人的药味
扑鼻而来，高高低低的橱柜里放满了不知名的药品，正在那里配
药的中年药师起身对你作了个揖，冲着你诡异地笑了笑，好象有
什么秘密不告诉你。
LONG
        );
    }
    return 0;
  }
}
