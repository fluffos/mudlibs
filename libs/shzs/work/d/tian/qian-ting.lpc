// Room: qian-ting.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "大广场");
  set("long", @LONG
上得山来，一座的雄伟的建筑豁然矗立在你的眼前，碧绿色的琉
璃瓦和金黄色的廊柱相互辉映，在阳光下熠熠发光，常令来着者
惊叹不已，你不禁急切起来，想早些一睹星凝圣城的风采。下意
识地加快了脚步。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northeast": __DIR__ "guangming-ding",
    "southwest": __DIR__ "banshanyao1",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "tian");
  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。上得山来，一座的雄伟的建筑豁然
矗立在你的眼前，碧绿色的琉璃瓦和金黄色的廊柱相互辉映，常
令来着者惊叹不已，你不禁急切起来，想早些一睹星凝圣城的风
采。下意识地加快了脚步。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。上得山来，一座的雄伟的建
筑豁然矗立在你的眼前，碧绿色的琉璃瓦和金黄色的廊柱相互辉
映，在阳光下熠熠发光，常令来着者惊叹不已，你不禁急切起来，
想早些一睹星凝圣城的风采。下意识地加快了脚步。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。上得山来，一座的雄伟
的建筑豁然矗立在你的眼前，碧绿色的琉璃瓦和金黄色的廊柱相
互辉映，在阳光下熠熠发光，常令来着者惊叹不已，你不禁急切
起来，想早些一睹星凝圣城的风采。下意识地加快了脚步。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。上得山来，一座的雄
伟的建筑豁然矗立在你的眼前，碧绿色的琉璃瓦和金黄色的廊柱
相互辉映，在阳光下熠熠发光，常令来着者惊叹不已，你不禁急
切起来，想早些一睹星凝圣城的风采。下意识地加快了脚步。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。上得山来，一座的雄伟的建筑豁
然矗立在你的眼前，碧绿色的琉璃瓦和金黄色的廊柱相互辉映，
常令来着者惊叹不已，你不禁急切起来，想早些一睹星凝圣城的
风采。下意识地加快了脚步。
LONG
        );
    }
    return 0;
  }
}
