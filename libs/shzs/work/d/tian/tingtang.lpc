// Room: tingtang.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "厅堂");
  set("long", @LONG
这里是星凝城中接待一般来访客人的地方，几张红木椅和小几分
列南北两边，西边有几个小童垂手而立，不时过来端茶添水。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */

    "east": __DIR__ "houtuqi",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。这里是星凝城中接待一般来访客人
的地方，几张红木椅和小几分列南北两边，西边有几个小童垂手
而立，不时过来端茶添水。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。这里是星凝城中接待一般来
访客人的地方，几张红木椅和小几分列南北两边，西边有几个小
童垂手而立，不时过来端茶添水。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。这里是星凝城中接待一
般来访客人的地方，几张红木椅和小几分列南北两边，西边有几
个小童垂手而立，不时过来端茶添水。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。这里是星凝城中接待
一般来访客人的地方，几张红木椅和小几分列南北两边，西边有
几个小童垂手而立，不时过来端茶添水。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。这里是星凝城中接待一般来访客
人的地方，几张红木椅和小几分列南北两边，西边有几个小童垂
手而立，不时过来端茶添水。
LONG
        );
    }
    return 0;
  }
}
