// Room: /d/shenmin/road4.c

inherit ROOM;
int do_look(string arg);

void create() {
  set("short", "龙桥");
  set("long", @LONG
这座高高的桥如同彩虹初降人间，三十六道石阶直通桥面，桥下
就是水流奔涌的大运河。桥上人来如梭，河中巨舟横过。在桥下
看去，人行于高波之上，令人心颤不已。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "southdown": __DIR__ "road3",
    "northdown": __DIR__ "road5",
  ]));
  set("outdoors", "/d/shenmin");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //上半夜
        set("long", @LONG
现在是上半夜了，周围静悄悄的，大家都沉浸在梦乡之中。这座
高高的桥如同彩虹初降人间，三十六道石阶直通桥面，桥下就是
水流奔涌的大运河。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在运河的水波，
这座高高的桥如同彩虹初降人间，三十六道石阶直通桥面，桥下
就是水流奔涌的大运河。桥上人来如梭，河中巨舟横过。在桥下
看去，人行于高波之上，令人心颤不已。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在水波上，翻腾的水气在阳光下形成一条美丽的彩
虹。桥上人来如梭，河中巨舟横过。在桥下看去，人行于高波之
上，令人心颤不已。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒在桥上，可以看到城里的人开始回家了，桥两边房
屋的影子逐渐拉长，日渐西山了。这座高高的桥如同彩虹初降人
间，三十六道石阶直通桥面，桥下就是水流奔涌的大运河。桥上
人来如梭，河中巨舟横过。在桥下看去，人行于高波之上，令人
心颤不已。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚了，最后一抹阳光在地平线上消失，这座高高的桥如同彩虹
初降人间，三十六道石阶直通桥面，桥下就是水流奔涌的大运河。
LONG
        );
    }
    return 0;
  }
}
