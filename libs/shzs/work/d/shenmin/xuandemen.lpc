// Room: /d/shenmin/xuandemen.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "宣德门");
  set("long", @LONG
宣德门是龙牙的北城门，由于这里历来是皇城所在。城墙建筑得
格外牢固。两边的藏兵主洞可容千人，其作用是当敌人攻破城门
之时，由伏兵杀出，截杀敌人。
                    ^
          .&______~*@*~______&.           
        "w/%%%%%%%%%%%%%%%%%%%\w"        
          `Y""Y""Y"""""Y""Y""Y'         
       p-p_|__|__|_____|__|__|_q-q   
...__-[EEEEM==M==MM===MM==M==MEEEE]-__...

LONG
  );

  set("no_clean_up", 0);
  set("outdoors", "/d/kaifeng");
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "road6",
    "north": __DIR__ "jiaowai",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜色如水，月正中天，宣德门在夜幕下显得格外阴森。宣德门是
龙牙的北城门，由于这里历来是皇城所在。城墙建筑得格外牢固。
两边的藏兵主洞可容千人，其作用是当敌人攻破城门之时，由伏
兵杀出，截杀敌人。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股泥土的清香，阳光浅浅地透过来，四周一片
灰蒙蒙的。宣德门是龙牙的北城门，由于这里历来是皇城所在。
城墙建筑得格外牢固。两边的藏兵主洞可容千人，其作用是当敌
人攻破城门之时，由伏兵杀出，截杀敌人。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光透过树叶的缝隙在城门上留下了班驳的树影。宣德门
是龙牙的北城门，由于这里历来是皇城所在。城墙建筑得格外牢
固。两边的藏兵主洞可容千人，其作用是当敌人攻破城门之时，
由伏兵杀出，截杀敌人。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒了进来，可以看到好些行人在走来走去，城门上的
树影逐渐拉长，日渐西山了。宣德门是龙牙的北城门，由于这里
历来是皇城所在。城墙建筑得格外牢固。两边的藏兵主洞可容千
人，其作用是当敌人攻破城门之时，由伏兵杀出，截杀敌人。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚的阳光慢慢的消失在地平线上。远处不知谁家的炊烟正在袅
袅升起，是晚餐时分了。宣德门是龙牙的北城门，由于这里历来
是皇城所在。城墙建筑得格外牢固。两边的藏兵主洞可容千人，
其作用是当敌人攻破城门之时，由伏兵杀出，截杀敌人。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
        );
    }
    return 0;
  }
}
