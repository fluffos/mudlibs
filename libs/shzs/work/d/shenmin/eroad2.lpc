// Room: /d/shenmin/eroad2.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "东大街");
  set("long", @LONG
东大街是龙牙城内东街区的主要通道。道路两端店铺府第不断。
行人如缕，观光的，作生意的，攀交情的，走亲访友的，喧闹无
比。西面有梯道可上角楼。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "eroad1",
    "north": __DIR__ "eroad3",

    "westup": __DIR__ "jiaolou2",
  ]));
  set("outdoors", "/d/shenmin");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
现在是半夜了，周围静悄悄的，大家都沉浸在梦乡之中。东大街
是龙牙城内东街区的主要通道。西面有梯道可上角楼。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在街道，东大街
是龙牙城内东街区的主要通道。道路两端店铺府第不断。行人如
缕，观光的，作生意的，攀交情的，走亲访友的，喧闹无比。西
面有梯道可上角楼。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在街道上，东大街是龙牙城内东街区的主要通道。
道路两端店铺府第不断。行人如缕，观光的，作生意的，攀交情
的，走亲访友的，喧闹无比。西面有梯道可上角楼。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进了龙牙街，可以看到街里的人开始回家了，街道
两边房屋的影子逐渐拉长，日渐西山了。东大街是龙牙城内东街
区的主要通道。道路两端店铺府第不断。行人如缕，观光的，作
生意的，攀交情的，走亲访友的，喧闹无比。西面有梯道可上角楼。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚了，最后一抹阳光在地平线上消失，街道两边的店铺开始把
灯点亮。东大街是龙牙城内东街区的主要通道。道路两端店铺府
第不断。行人如缕，观光的，作生意的，攀交情的，走亲访友的，
喧闹无比。西面有梯道可上角楼。
LONG
        );
    }
    return 0;
  }
}
