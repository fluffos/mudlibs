// Room: /d/shenmin/tianwang.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "天王殿");
  set("long", @LONG
这里是天王殿，殿上立着龙牙城的开国天王的石像，石像高据于
法坛之上，绿色的眼睛瞪着下面的你。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "qianyuan",
    "north": __DIR__ "zhongyuan",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
半夜了，天王殿周围静悄悄的。殿上立着龙牙城的开国天王的石
像，石像高据于法坛之上，绿色的眼睛瞪着下面的你。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
曙色隐现，天边已现出乳白色，这里是天王殿，殿上立着龙牙城
的开国天王的石像，石像高据于法坛之上，绿色的眼睛瞪着下面
的你。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在殿前，热气从前院不断的涌进来。这里是天王殿，
殿上立着龙牙城的开国天王的石像，石像高据于法坛之上，绿色
的眼睛瞪着下面的你。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光柔和了不少，似乎不那么热了。这里是天王殿，殿上
立着龙牙城的开国天王的石像，石像高据于法坛之上，绿色的眼
睛瞪着下面的你。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
夕阳西下，天边抹上了一笔瑰丽的晚霞。这里是天王殿，殿上立
着龙牙城的开国天王的石像，石像高据于法坛之上，绿色的眼睛
瞪着下面的你。
LONG
        );
    }
    return 0;
  }
}
