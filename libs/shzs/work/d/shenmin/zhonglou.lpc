// Room: /d/shenmin/zhonglou.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "钟楼");
  set("long", @LONG
一座小巧而高耸的阁楼，用上好的桧木所建，有股淡淡的清香。
楼上的铁钟净重一万八千斤，是当年龙皇寺高僧用无上神力打造
而成。
LONG
  );
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/zong": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "qianyuan",
  ]));
  set("outdoors", "/d/shenmin");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
半夜了，周围静悄悄的，大家都沉浸在梦乡之中。这是一座小巧
而高耸的阁楼，用上好的桧木所建，有股淡淡的清香。楼上的铁
钟净重一万八千斤，是当年龙皇寺高僧用无上神力打造而成。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气传来花香的味道，阳光浅浅地洒进阁楼，这是一座小
巧而高耸的阁楼，用上好的桧木所建，有股淡淡的清香。楼上的
铁钟净重一万八千斤，是当年龙皇寺高僧用无上神力打造而成。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光从窗外照了进来。这是一座小巧而高耸的阁楼，用上
好的桧木所建，有股淡淡的清香。楼上的铁钟净重一万八千斤，
是当年龙皇寺高僧用无上神力打造而成。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒在铁钟上，这是一座小巧而高耸的阁楼，用上好的
桧木所建，有股淡淡的清香。楼上的铁钟净重一万八千斤，是当
年龙皇寺高僧用无上神力打造而成。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
最后一抹阳光从铁钟上消失，这是一座小巧而高耸的阁楼，用上
好的桧木所建，有股淡淡的清香。楼上的铁钟净重一万八千斤，
是当年龙皇寺高僧用无上神力打造而成。
LONG
        );
    }
    return 0;
  }
}
