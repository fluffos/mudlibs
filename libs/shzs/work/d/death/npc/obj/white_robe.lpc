// white_cloth.c
//
// This is the white cloth for Spock's shadow.

#include <armor.h>

inherit CLOAK;

void create() {
  set_name("[1;37m白色长袍[0;37;40m", ({ "white robe", "white", "robe" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件丝织的白色袍子，摸起来柔软光滑，舒服极了。\n");
    set("value", 100000);
    set("armor_prop/dp", 70);
    set("armor_prop/traditional_armor", 100);
    set("armor_prop/projectile_armor", 100);
    set("armor_prop/high_energy_armor", 100);
    set("armor_prop/optical_armor", 100);
    set("armor_prop/explosive_armor", 100);
    set("armor_prop/defense", 20);
  }
  setup();
}
