// gate.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "地狱" NOR);
  set("long", @LONG 
你身处一座非常巨大的垃圾山之上，奇怪的是你闻不到任何的味
道。你轻轻地站起身子，把身上的一些垃圾残片拨掉。往四周一
望只发现一望无际的垃圾堆，无穷无尽的垃圾铺满了所有你目力
可及的范围。抬头环视天空，你只看到迷迷蒙蒙的一片。你完全
不知道这里到底是什么地方。
LONG
  );
  set("exits", ([
    "hole": "/d/death/hall",
  ]));
  set("no_fight", 1);

  setup();
}
