inherit ROOM;

void init();
int do_zhao(string);
int do_push(string arg);
int do_look(string arg);
void delete_served(object);

void create() {
  set("short", "荒地");
  set("long", @LONG
这里是一片荒地，看来已经很旧无人使用了，野草长了一地越看
越觉得这里荒凉。突然你发现来时的路找不到了！
LONG);
  set("area", "兽之城");
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_zhao", "zhao");
  add_action("do_push", "push");
  add_action("do_look", "look");
}

int do_zhao(string arg) {

  object me;

  me = this_player();

  if (!arg || arg != "路") {
    return notify_fail("你要找什么？\n");
  }

  message_vision("$N到处乱找，竟然找到向东一条小路。\n", me);
  if (!query("exits/east")) {
    set("exits/east", __DIR__ "jzroad3");
    call_out("close_path", 3);
  }
  return 1;

}

int do_push(string arg) {
  object me;
  if (!arg || arg == "") {
    write("什么？\n");
    return 1;
  }
  if (arg == "zacao" || arg == "杂草" || arg == "cao") {
    me = this_player();
    message_vision("$N静下心来屏息细看，发现了一边的杂草有被动过的痕迹。\n于是，$N推开那堆杂草，一条土路现于眼前\n", me);
    if (!query("exits/southdown")) {
      set("exits/southdown", __DIR__ "tulu");
      call_out("close_path", 3);
    }
    return 1;
  }

}
void close_path() {
  if (!query("exits/east")) return;
  message("vision",
    "一阵风吹过，杂草中的路又不见了。\n",
    this_object());
  delete("exits/east");
  if (!query("exits/southdown")) return;
  message("vision",
    "一阵风吹过，杂草中的路又不见了。\n",
    this_object());
  delete("exits/southdown");
}




//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是一片荒地，
看来已经很旧无人使用了，野草长了一地越看越觉得这里荒凉。
突然你发现来时的路找不到了！
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里是一片荒地，看来已
经很旧无人使用了，野草长了一地越看越觉得这里荒凉。突然你
发现来时的路找不到了！
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里是一片荒地，看来已经很旧无
人使用了，野草长了一地越看越觉得这里荒凉。突然你发现来时
的路找不到了！
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里是一片荒地，看来已
经很旧无人使用了，野草长了一地越看越觉得这里荒凉。突然你
发现来时的路找不到了！
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里是一片荒地，看来
已经很旧无人使用了，野草长了一地越看越觉得这里荒凉。突然
你发现来时的路找不到了！
LONG
        );
    }
    return 0;
  }
}
