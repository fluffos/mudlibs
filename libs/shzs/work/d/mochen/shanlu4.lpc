inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山路");
  set("long", @LONG
脚下是一条小土路，盘旋上山，向北上一段路就是落神岭了，没
有过落神岭之前你看不到岭那边的任何东西。兽之城据说就在岭
的那边。
LONG);

  set("outdoors", "mochen");
  set("no_clean_up", 0);

  set("exits", ([
    "northup": __DIR__ "luoshenling",
    "eastdown": __DIR__ "shanlu5",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。脚下是一条小土
路，盘旋上山，向北上一段路就是落神岭了，没有过落神岭之前
你看不到岭那边的任何东西。兽之城据说就在岭的那边。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。脚下是一条小土路，盘旋
上山，向北上一段路就是落神岭了，没有过落神岭之前你看不到
岭那边的任何东西。兽之城据说就在岭的那边。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。脚下是一条小土路，盘旋上山，向
北上一段路就是落神岭了，没有过落神岭之前你看不到岭那边的
任何东西。兽之城据说就在岭的那边。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。脚下是一条小土路，盘旋
上山，向北上一段路就是落神岭了，没有过落神岭之前你看不到
岭那边的任何东西。兽之城据说就在岭的那边。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。脚下是一条小土路，盘
旋上山，向北上一段路就是落神岭了，没有过落神岭之前你看不
到岭那边的任何东西。兽之城据说就在岭的那边。
LONG
        );
    }
    return 0;
  }
}
