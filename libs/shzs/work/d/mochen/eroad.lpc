#include <ansi.h>
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小路");
  set("long", @LONG
这是一条青石铺成的小路，两旁还种着一大片不知名的花草。从
这里再向东走就到兽之城的东院了。向西一看，是一块大空地，
好象有些人影在晃动，那里就是东练武场了，你发现附近的人仿
佛也都活跃起来。
LONG);
  set("no_clean_up", 0);

  set("exits",
    ([
      "west": __DIR__ "dongwuchang",
      "east": __DIR__ "dongyuan",
    ]));

  set("outdoors", "mochen");
  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一条青石铺
成的小路，两旁还种着一大片不知名的花草。从这里再向东走就
到兽之城的东院了。向西一看，是一块大空地，好象有些人影在
晃动，那里就是东练武场了，你发现附近的人仿佛也都活跃起来。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这是一条青石铺成的小路，
两旁还种着一大片不知名的花草。从这里再向东走就到兽之城的
东院了。向西一看，是一块大空地，好象有些人影在晃动，那里
就是东练武场了，你发现附近的人仿佛也都活跃起来。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这是一条青石铺成的小路，两旁还
种着一大片不知名的花草。从这里再向东走就到兽之城的东院了。
向西一看，是一块大空地，好象有些人影在晃动，那里就是东练
武场了，你发现附近的人仿佛也都活跃起来。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这是一条青石铺成的小路，
两旁还种着一大片不知名的花草。从这里再向东走就到兽之城的
东院了。向西一看，是一块大空地，好象有些人影在晃动，那里
就是东练武场了，你发现附近的人仿佛也都活跃起来。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这是一条青石铺成的小
路，两旁还种着一大片不知名的花草。从这里再向东走就到兽之
城的东院了。向西一看，是一块大空地，好象有些人影在晃动，
那里就是东练武场了，你发现附近的人仿佛也都活跃起来。
LONG
        );
    }
    return 0;
  }
}
