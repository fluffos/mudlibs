// Room: jzroad1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "松树林");
  set("long", @LONG
这是一片松树林。中间一条小路，两边都是黑森森的几丈高的松
树。树上结着不少松果，间或有野兔游悠游而过。再向南就是西
武场。
LONG);
  set("exits", ([
    "south": __DIR__ "wroad",
    "north": __DIR__ "jzroad2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "feiyu");

  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一片松树林。
中间一条小路，两边都是黑森森的几丈高的松树。树上结着不少
松果，间或有野兔游悠游而过。再向南就是西武场。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这是一片松树林。中间一
条小路，两边都是黑森森的几丈高的松树。树上结着不少松果，
间或有野兔游悠游而过。再向南就是西武场。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这是一片松树林。中间一条小路，
两边都是黑森森的几丈高的松树。树上结着不少松果，间或有野
兔游悠游而过。再向南就是西武场。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这是一片松树林。中间一
条小路，两边都是黑森森的几丈高的松树。树上结着不少松果，
间或有野兔游悠游而过。再向南就是西武场。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这是一片松树林。中间
一条小路，两边都是黑森森的几丈高的松树。树上结着不少松果，
间或有野兔游悠游而过。再向南就是西武场。
LONG
        );
    }
    return 0;
  }
}
