// Modified by Atlus 1999.7.21

inherit ROOM;

void init();
int do_look(string arg);
void create() {
  set("short", "钓鱼台");
  set("long", @LONG
走过树林，你的眼前豁然开朗起来，这里被叫作钓鱼台，大概就
是因为这里有一条小溪，溪里游着一些不多见的鱼吧，台上已经
有几个人在垂钓了。有兴趣的话你也可以试试。远远望出去，隐
隐看见雾中的山峰，使人感到心旷神怡。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([
    "north": __DIR__ "shulin",
  ]));

  setup();
}


void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。走过树林，你的
眼前豁然开朗起来，这里被叫作钓鱼台，大概就是因为这里有一
条小溪，溪里游着一些不多见的鱼吧，台上已经有几个人在垂钓
了。有兴趣的话你也可以试试。远远望出去，隐隐看见雾中的山
峰，使人感到心旷神怡。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。走过树林，你的眼前豁然
开朗起来，这里被叫作钓鱼台，大概就是因为这里有一条小溪，
溪里游着一些不多见的鱼吧，台上已经有几个人在垂钓了。有兴
趣的话你也可以试试。远远望出去，隐隐看见雾中的山峰，使人
感到心旷神怡。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。走过树林，你的眼前豁然开朗起来，
这里被叫作钓鱼台，大概就是因为这里有一条小溪，溪里游着一
些不多见的鱼吧，台上已经有几个人在垂钓了。有兴趣的话你也
可以试试。远远望出去，隐隐看见雾中的山峰，使人感到心旷神怡。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。走过树林，你的眼前豁然
开朗起来，这里被叫作钓鱼台，大概就是因为这里有一条小溪，
溪里游着一些不多见的鱼吧，台上已经有几个人在垂钓了。有兴
趣的话你也可以试试。远远望出去，隐隐看见雾中的山峰，使人
感到心旷神怡。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。走过树林，你的眼前豁
然开朗起来，这里被叫作钓鱼台，大概就是因为这里有一条小溪，
溪里游着一些不多见的鱼吧，台上已经有几个人在垂钓了。有兴
趣的话你也可以试试。远远望出去，隐隐看见雾中的山峰，使人
感到心旷神怡。
LONG
        );
    }
    return 0;
  }
}
