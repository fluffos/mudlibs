inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "树林边");
  set("long", @LONG
在两旁的树林里，茂密的树叶遮挡了阳光，这使你那里的环境显
得有点阴森。一阵风吹过，周围的树叶“沙沙”的作响。使你不
禁加快了脚步。再向南，便是钓鱼台了。
LONG);


  set("outdoors", "mochen");

  set("exits", ([
    "south": __DIR__ "diaoyutai",
    "north": __DIR__ "xiaojing1",

  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。在两旁的树林里，
茂密的树叶遮挡了阳光，这使你那里的环境显得有点阴森。一阵
风吹过，周围的树叶“沙沙”的作响。使你不禁加快了脚步。再
向南，便是钓鱼台了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。在两旁的树林里，茂密的
树叶遮挡了阳光，这使你那里的环境显得有点阴森。一阵风吹过，
周围的树叶“沙沙”的作响。使你不禁加快了脚步。再向南，便
是钓鱼台了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。在两旁的树林里，茂密的树叶遮挡
了阳光，这使你那里的环境显得有点阴森。一阵风吹过，周围的
树叶“沙沙”的作响。使你不禁加快了脚步。再向南，便是钓鱼
台了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。在两旁的树林里，茂密的
树叶遮挡了阳光，这使你那里的环境显得有点阴森。一阵风吹过，
周围的树叶“沙沙”的作响。使你不禁加快了脚步。再向南，便
是钓鱼台了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。在两旁的树林里，茂密
的树叶遮挡了阳光，这使你那里的环境显得有点阴森。一阵风吹
过，周围的树叶“沙沙”的作响。使你不禁加快了脚步。再向南，
便是钓鱼台了。
LONG
        );
    }
    return 0;
  }
}
