// Room: jzroad4.c


inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "峭壁");
  set("long", @LONG
你走在峭壁边的小路上。一侧是密密的丛林，外侧却是极深的陡
壁。山风凛冽，几乎要把你刮落崖去。
LONG);
  set("exits", ([
    "westdown": __DIR__ "jzroad3",
    "northup": __DIR__ "houshan",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "mochen");

  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。你走在峭壁边的
小路上。一侧是密密的丛林，外侧却是极深的陡壁。山风凛冽，
几乎要把你刮落崖去。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。你走在峭壁边的小路上。
一侧是密密的丛林，外侧却是极深的陡壁。山风凛冽，几乎要把
你刮落崖去。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。你走在峭壁边的小路上。一侧是密
密的丛林，外侧却是极深的陡壁。山风凛冽，几乎要把你刮落崖去。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。你走在峭壁边的小路上。
一侧是密密的丛林，外侧却是极深的陡壁。山风凛冽，几乎要把
你刮落崖去。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。你走在峭壁边的小路上。
一侧是密密的丛林，外侧却是极深的陡壁。山风凛冽，几乎要把
你刮落崖去。
LONG
        );
    }
    return 0;
  }
}
