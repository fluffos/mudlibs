// ROOM xiaohu.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小湖");
  set("long", @LONG
这是竟是一个碧绿的小湖，下雨时雨水落入湖中，清脆的水珠声
有如玉珠落盘般悦耳。水气朦胧中抬头西望，只见远处苍山如黛，
若隐若现，雨景妙趣无穷。
LONG);
  set("no_clean_up", 0);

  set("exits", ([
    "southeast": __DIR__ "houshan",
  ]));
  set("outdoors", "mochen");


  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是竟是一个碧
绿的小湖，下雨时雨水落入湖中，清脆的水珠声有如玉珠落盘般
悦耳。水气朦胧中抬头西望，只见远处苍山如黛，若隐若现，雨
景妙趣无穷。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这是竟是一个碧绿的小湖，
下雨时雨水落入湖中，清脆的水珠声有如玉珠落盘般悦耳。水气
朦胧中抬头西望，只见远处苍山如黛，若隐若现，雨景妙趣无穷。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这是竟是一个碧绿的小湖，下雨时
雨水落入湖中，清脆的水珠声有如玉珠落盘般悦耳。水气朦胧中
抬头西望，只见远处苍山如黛，若隐若现，雨景妙趣无穷。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这是竟是一个碧绿的小湖，
下雨时雨水落入湖中，清脆的水珠声有如玉珠落盘般悦耳。水气
朦胧中抬头西望，只见远处苍山如黛，若隐若现，雨景妙趣无穷。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这是竟是一个碧绿的小
湖，下雨时雨水落入湖中，清脆的水珠声有如玉珠落盘般悦耳。
水气朦胧中抬头西望，只见远处苍山如黛，若隐若现，雨景妙趣
无穷。
LONG
        );
    }
    return 0;
  }
}
