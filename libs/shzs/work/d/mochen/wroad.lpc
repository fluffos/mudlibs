inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小路");
  set("long", @LONG
这是一条青石铺成的小路，两旁还种着一大片不知名的花草。布
置和东边的小路是一模一样的从这里向西走就到兽之城的东院了。
东边也是一大块空地，那里就是西练武场了。
LONG);
  set("no_clean_up", 0);

  set("exits",
    ([
      "west": __DIR__ "xiyuan",
      "east": __DIR__ "xiwuchang",
      "north": __DIR__ "jzroad1",
    ]));

  set("outdoors", "mochen");
  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一条青石铺
成的小路，两旁还种着一大片不知名的花草。布置和东边的小路
是一模一样的从这里向西走就到兽之城的东院了。东边也是一大
块空地，那里就是西练武场了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这是一条青石铺成的小路，
两旁还种着一大片不知名的花草。布置和东边的小路是一模一样
的从这里向西走就到兽之城的东院了。东边也是一大块空地，那
里就是西练武场了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这是一条青石铺成的小路，两旁还
种着一大片不知名的花草。布置和东边的小路是一模一样的从这
里向西走就到兽之城的东院了。东边也是一大块空地，那里就是
西练武场了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这是一条青石铺成的小路，
两旁还种着一大片不知名的花草。布置和东边的小路是一模一样
的从这里向西走就到兽之城的东院了。东边也是一大块空地，那
里就是西练武场了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这是一条青石铺成的小
路，两旁还种着一大片不知名的花草。布置和东边的小路是一模
一样的从这里向西走就到兽之城的东院了。东边也是一大块空地，
那里就是西练武场了。
LONG
        );
    }
    return 0;
  }
}
