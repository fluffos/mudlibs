inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山谷");
  set("long", @LONG
这里的地势比较平坦，你觉得似乎步子快多了，向东望去，只见
一座高耸入云的山峰挡住了你的视线，在山谷里还有不少的小动
物四处奔走。山谷向北延伸着，东南方却可看见山间的一些小屋。
LONG);

  set("outdoors", "mochen");



  set("exits", ([
    "northup": __DIR__ "shangu1",
    "southeast": __DIR__ "shanjianxiaowu",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里的地势比较
平坦，你觉得似乎步子快多了，向东望去，只见一座高耸入云的
山峰挡住了你的视线，在山谷里还有不少的小动物四处奔走。山
谷向北延伸着，东南方却可看见山间的一些小屋。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里的地势比较平坦，你
觉得似乎步子快多了，向东望去，只见一座高耸入云的山峰挡住
了你的视线，在山谷里还有不少的小动物四处奔走。山谷向北延
伸着，东南方却可看见山间的一些小屋。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里的地势比较平坦，你觉得似乎
步子快多了，向东望去，只见一座高耸入云的山峰挡住了你的视
线，在山谷里还有不少的小动物四处奔走。山谷向北延伸着，东
南方却可看见山间的一些小屋。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里的地势比较平坦，你
觉得似乎步子快多了，向东望去，只见一座高耸入云的山峰挡住
了你的视线，在山谷里还有不少的小动物四处奔走。山谷向北延
伸着，东南方却可看见山间的一些小屋。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里的地势比较平坦，
你觉得似乎步子快多了，向东望去，只见一座高耸入云的山峰挡
住了你的视线，在山谷里还有不少的小动物四处奔走。山谷向北
延伸着，东南方却可看见山间的一些小屋。
LONG
        );
    }
    return 0;
  }
}
