inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山谷");
  set("long", @LONG
这里的地势忽然变低了，你觉得似乎暖和了一点，向两旁望去，
只见山边上有些植物，有的还着开花。山谷一直向南延伸过去，
回头望去，北边的山峰上围绕着一些薄雾，有些虚无缥缈的感觉。
LONG);

  set("outdoors", "mochen");



  set("exits", ([
    "northup": __DIR__ "shaozhan",
    "southdown": __DIR__ "shangu2",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里的地势忽然
变低了，你觉得似乎暖和了一点，向两旁望去，只见山边上有些
植物，有的还着开花。山谷一直向南延伸过去，回头望去，北边
的山峰上围绕着一些薄雾，有些虚无缥缈的感觉。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里的地势忽然变低了，
你觉得似乎暖和了一点，向两旁望去，只见山边上有些植物，有
的还着开花。山谷一直向南延伸过去，回头望去，北边的山峰上
围绕着一些薄雾，有些虚无缥缈的感觉。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里的地势忽然变低了，你觉得似
乎暖和了一点，向两旁望去，只见山边上有些植物，有的还着开
花。山谷一直向南延伸过去，回头望去，北边的山峰上围绕着一
些薄雾，有些虚无缥缈的感觉。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里的地势忽然变低了，
你觉得似乎暖和了一点，向两旁望去，只见山边上有些植物，有
的还着开花。山谷一直向南延伸过去，回头望去，北边的山峰上
围绕着一些薄雾，有些虚无缥缈的感觉。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里的地势忽然变低了，
你觉得似乎暖和了一点，向两旁望去，只见山边上有些植物，有
的还着开花。山谷一直向南延伸过去，回头望去，北边的山峰上
围绕着一些薄雾，有些虚无缥缈的感觉。
LONG
        );
    }
    return 0;
  }
}
