// updated.c

void create() { seteuid(getuid()); }

void check_user(object ob) {
  mapping my;

  my = ob->query_entire_dbase();
  if (undefinedp(my["eff_spi"])) my["eff_spi"] = my["max_spi"];
  //	if( undefinedp(my["eff_hit"]) ) my["eff_hit"] = my["max_hit"];
  //	if( undefinedp(my["eff_mov"]) ) my["eff_mov"] = my["max_mov"];
  if (my["eff_spi"] > my["max_spi"]) my["eff_spi"] = my["max_spi"];
  //	if( my["eff_hit"] > my["max_hit"] ) my["eff_hit"] = my["max_hit"];
  //	if( my["eff_mov"] > my["max_mov"] ) my["eff_mov"] = my["max_mov"];
  if (my["spi"] > my["eff_spi"]) my["spi"] = my["eff_spi"];
  //	if( my["hit"] > my["eff_hit"] ) my["hit"] = my["eff_hit"];
  //	if( my["mov"] > my["eff_mov"] ) my["mov"] = my["eff_mov"];
}
