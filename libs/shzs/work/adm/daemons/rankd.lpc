// rankd.c

#include <ansi.h>

string query_rank(object ob) {
  switch (ob->query("gender")) {
    case "女性":
      switch (wizhood(ob)) {
        case "(admin)": return HIW "[山海战神]" NOR;
        case "(arch)": return HIY "[烈炎元帅]" NOR;
        case "(wizard)": return HIG "[飓风前将]" NOR;
        case "(apprentice)": return HIC "[紫玉副将]" NOR;
        case "(immortal)": return HIM "[铁石士兵]" NOR;
        default:
          switch (ob->query("class")) {
            case "soldier": return "[ 军 人 ]";
            case "police": return "[ 猎 人 ]";
            case "doctor": return "[ 医 师 ]";
            case "scholar": return "[ 导 师 ]";
            case "technician": return "[ 技 师 ]";
            default: return "[ 平 民 ]";
          }
      }
    default:
      switch (wizhood(ob)) {
        case "(admin)": return HIW "[山海战神]" NOR;
        case "(arch)": return HIY "[烈炎元帅]" NOR;
        case "(wizard)": return HIG "[飓风前将]" NOR;
        case "(apprentice)": return HIC "[紫玉副将]" NOR;
        case "(immortal)": return HIM "[铁石士兵]" NOR;
        default:
          switch (ob->query("class")) {
            case "soldier": return "[ 军 人 ]";
            case "police": return "[ 猎 人 ]";
            case "doctor": return "[ 医 师 ]";
            case "scholar": return "[ 导 师 ]";
            case "technician": return "[ 技 师 ]";
            default: return "[ 平 民 ]";
          }
      }
  }
}

string query_respect(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/respect")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      if (age < 18) return "小姑娘";
      else if (age < 50) return "女士";
      else return "婆婆";
      break;
    case "男性":
    default:
      if (age < 20) return "小兄弟";
      else if (age < 50) return "先生";
      else return "老爷";
      break;
  }
}

string query_rude(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/rude")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      if (age < 30) return "小贱人";
      else return "死老太婆";
      break;
    default:
      if (age < 20) return "小王八蛋";
      if (age < 50) return "混帐";
      else return "老王八";
      break;
  }
}

string query_self(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/self")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      if (age < 30) return "小女子";
      else return "吾身";
      break;
    default:
      if (age < 50) return "在下";
      else return "老头子";
      break;
  }
}

string query_self_rude(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/self_rude")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      if (age < 30) return "本姑娘";
      else return "老娘";
      break;
    default:
      if (age < 50) return "本大爷";
      else return "老子";
      break;
  }
}
