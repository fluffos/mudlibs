// gender.c

string gender_self(mixed subject) {
  switch (objectp(subject) ? subject->query("gender") : subject) {
    case "┦": return "﹑"; break;
    default: return "";
  }
}

string gender_pronoun(string subject) {
  switch (objectp(subject) ? subject->query("gender") : subject) {
    case "deity": return "廷"; break;
    case "╧┦": return ""; break;
    case "┦": return ""; break;
    case "动┦":
    case "慧┦": return "╡"; break;
    default: return "ウ";
  }
}
