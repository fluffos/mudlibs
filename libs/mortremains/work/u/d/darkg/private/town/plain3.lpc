#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM ;

void create() {
        	::create();
	seteuid(getuid()) ;
     set ("light", 1) ;
    set("long", @ENDTEXT
ENDTEXT);
set ("short","Grassy plains");
     set ("exits", ([
   "east" : AROOM+"plain4.lpc",
   "south" : AROOM+"plain8.lpc",
   "west" : AROOM+"plain2.lpc",
   "northeast" : AROOM+"dirt1.lpc",
]));
reset();
	}
