#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM ;

void create() {
        	::create();
	seteuid(getuid()) ;
     set ("light", 1) ;
    set("long", @ENDTEXT
ENDTEXT);
set ("short","Rolling hills");
     set ("exits", ([
   "west" : AROOM+"plain17.lpc",
   "north" : AROOM+"plain10.lpc",
   "south" : AROOM+"plain24.lpc",
   "east" : AROOM+"plain19.lpc",
]));
reset();
	}
