#include <config.h>
#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM;

void create()
{
  ::create();
  seteuid(getuid());
  set( "light", 1 );
   set("short", "Main Street");
  set( "exits", ([
         "south" : AROOM+"street30.lpc",
         "west" : AROOM+"street4.lpc",
         "east" : AROOM+"street6.lpc",
  ]) );
}
