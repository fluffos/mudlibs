#include <config.h>
#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM;

void create()
{
  ::create();
  seteuid(getuid());
  set( "light", 1 );
   set("short", "Main Street");
  set( "exits", ([
         "west" : AROOM+"street3.lpc",
         "north" : AROOM+"street11.lpc",
         "east" : AROOM+"street5.lpc",
  ]) );
}
