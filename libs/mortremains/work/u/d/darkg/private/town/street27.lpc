#include <config.h>
#include <mudlib.h>
#include "fuckstick.h"


inherit ROOM;

void create()
{
  ::create();
  seteuid(getuid());
  set( "light", 1 );
    set("short", "Valor");
  set( "exits", ([
       "north" : AROOM+"street25.lpc",
       "west" : AROOM+"street26.lpc",
       "east" : AROOM+"street28.lpc",
       "south" : AROOM+"street31.lpc",
  ]) );
}
