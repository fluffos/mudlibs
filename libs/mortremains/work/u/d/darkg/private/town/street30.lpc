#include <config.h>
#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM;

void create()
{
  ::create();
  seteuid(getuid());
  set( "light", 1 );
    set("short", "Wade");
  set("exits", ([
       "north" : AROOM+"street5.lpc",
       "south" : AROOM+"street36.lpc",
       "west" : AROOM+"street29.lpc",
  ]) );
}
