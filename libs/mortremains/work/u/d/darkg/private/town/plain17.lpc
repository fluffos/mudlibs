#include <mudlib.h>
#include "fuckstick.h"

inherit ROOM ;

void create() {
        	::create();
	seteuid(getuid()) ;
     set ("light", 1) ;
    set("long", @ENDTEXT
ENDTEXT);
set ("short","Rolling hills");
     set ("exits", ([
   "east" : AROOM+"plain18.lpc",
   "south" : AROOM+"plain23.lpc",
   "north" : AROOM+"plain9.lpc",
   "west" : AROOM+"plain16.lpc",
]));
reset();
	}
