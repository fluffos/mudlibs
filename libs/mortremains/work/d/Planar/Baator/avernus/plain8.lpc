#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/plainstd.lpc" ;

void create() {
    ::create();
    set ("light", 1) ;
    set ("exits", ([
      "west" : BAATOR+"avernus/plain7.lpc",
      "east" : BAATOR+"avernus/ave2.lpc",
      "south" : BAATOR+"avernus/plain12.lpc",
      "north" : BAATOR+"avernus/plain4.lpc"]));
}
