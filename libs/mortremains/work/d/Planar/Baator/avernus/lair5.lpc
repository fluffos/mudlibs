#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/lairstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([
      "north" : BAATOR+"avernus/lair2.lpc",
      "south" : BAATOR+"avernus/lair8.lpc",
      "east" : BAATOR+"avernus/lair6.lpc",
      "west" : BAATOR+"avernus/lair4.lpc"
    ]));
    set("objects", ([
      "tiamat" : BAATOR+"monsters/tiamat",
    ]) );
    reset();
}
