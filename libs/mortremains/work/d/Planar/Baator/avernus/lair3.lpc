#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/lairstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([
        "south" : BAATOR+"avernus/lair6.lpc"
    ]) );
    set ("objects" , ([ 
      "paragonblue" : BAATOR+"monsters/paragonblue",
      "paragonwhite" : BAATOR+"monsters/paragonwhite"
    ]));
    reset();
}
