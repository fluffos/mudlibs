#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/lairstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([
        "north" : BAATOR+"avernus/lair6.lpc"
    ]));
    set("objects", ([
      "paragongreen" : BAATOR+"monsters/paragongreen",
      "paragonblack" : BAATOR+"monsters/paragonblack"
    ]) );
    reset();
}
