#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/plainstd.lpc" ;

void create() {
    ::create();
    seteuid(getuid()) ;
    set ("exits", ([
      "east" : BAATOR+"avernus/plain18.lpc",
      "north" : BAATOR+"avernus/plain13.lpc"
    ]));
    set("objects" , ([ 
      "barbazu" : BAATOR+"monsters/barbazu",
      "barbazu2" : BAATOR+"monsters/barbazu",
      "barbazu3" : BAATOR+"monsters/barbazu",
      "osyluth" : BAATOR+"monsters/osyluth"
    ]));
    reset();
}
