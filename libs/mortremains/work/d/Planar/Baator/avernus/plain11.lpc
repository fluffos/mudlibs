#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"avernus/plainstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([
      "west" : BAATOR+"avernus/plain10.lpc",
      "east" : BAATOR+"avernus/plain12.lpc",
      "south" : BAATOR+"avernus/plain15.lpc",
      "north" : BAATOR+"avernus/plain7.lpc"
    ]));
    set("objects" , ([ 
      "black1" : BAATOR+"monsters/black_abishai",
      "black2" : BAATOR+"monsters/black_abishai",
      "black3" : BAATOR+"monsters/black_abishai",
      "green1" : BAATOR+"monsters/green_abishai",
      "green2" : BAATOR+"monsters/green_abishai",
      "red" : BAATOR+"monsters/red_abishai"
    ]));
    reset();
}
