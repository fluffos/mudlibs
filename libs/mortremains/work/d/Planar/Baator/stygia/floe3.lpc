#include <mudlib.h>
#include "baator.h"

inherit ROOM ;

void create() {
        	::create();
	seteuid(getuid()) ;
     set ("light", 1) ;
     set ("long",
"This is the fifth layer of Baator.\n"+
"You wander within an icy labryinth.\n"+
"Shadowy forms seem to mock your vision.\n");
set ("short","Ice Floe, Stygia");
     set ("exits", ([
      "west" : BAATOR+"stygia/floe2.lpc",
      "south" : BAATOR+"stygia/floe4.lpc"]));
reset();
//put 2 geulugons here.
	}
