#include <mudlib.h>
#include "baator.h"

inherit BAATOR+"dis/dplainstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([
      "north" : BAATOR+"dis/dplain11.lpc",
      "east" : BAATOR+"dis/dplain13.lpc"
    ]));
    set("objects" , ([ 
        "barbazu" : BAATOR+"monsters/barbazu",
        "osyluth" : BAATOR+"monsters/osyluth"
    ]));
    reset();
}
