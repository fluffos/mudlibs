#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"bogstd.lpc" ;

void create() {    
    ::create();
    set ("long", @EndText
Suddenly, seemingly out of nowhere the path abruptly ends, interrupted by
a sheer ridge of razor-sharp obsidian. It seems that the path turns
sharply north to compensate.
EndText
    );
    set ("exits", ([     
    "west" : BAATOR+"minauros/bog7.lpc",
    "north" : BAATOR+"minauros/bog3.lpc",
    ]));
    reset();
}
