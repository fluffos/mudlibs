#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"bogstd.lpc" ;

void create() {    
    ::create();
    seteuid(getuid()) ;
    set ("long", @EndText
Suddenly, seemingly out of nowhere the path abruptly ends, interrupted by
a sheer ridge of razor-sharp obsidian. It seems that the path winds east 
and south to compensate.
EndText
    );
    set ("exits", ([   
    "east" : BAATOR+"minauros/bog10.lpc",  
    "south" : BAATOR+"minauros/bog16.lpc"
    ]));
    reset();
}
