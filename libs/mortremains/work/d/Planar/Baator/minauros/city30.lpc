#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"citystd.lpc" ;

void create() {    
    ::create();
    add("long", "A couple hamatula are gambling here.\n");
    set ("exits", ([   
    "east" : BAATOR+"minauros/city31.lpc"]));
}

void reset(){    
    object ob;

    ::reset();
    seteuid(getuid()) ; 

    if (present("hamatula", this_object())  ) return;

    ob = clone_object(BAATOR+"monsters/hamatula");
    ob->move(this_object());
    ob = clone_object(BAATOR+"monsters/hamatula");
    ob->move(this_object());

    return;
}