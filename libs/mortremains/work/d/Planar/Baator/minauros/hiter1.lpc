#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"hiterstd.lpc" ;

void create() {
    ::create();
    set ("exits", ([   
      "east" : BAATOR+"minauros/hiter2.lpc",  
      "south" : BAATOR+"minauros/hiter6.lpc"
    ]));
    reset();
}

int reset(){
    object ob1, ob2, ob3;
    ::reset();

    seteuid(getuid()) ;  
    if (present("kyton", this_object())) return 1;

    ob1 = clone_object(BAATOR+"monsters/kyton");
    ob1->move(this_object());
    ob2 = clone_object(BAATOR+"monsters/kyton");
    ob2->move(this_object());
    ob3 = clone_object(BAATOR+"monsters/kyton");
    ob3->move(this_object());

    return 1;
}

