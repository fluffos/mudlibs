#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"hiterstd.lpc" ;

void create() {    
    ::create();
    add ("long", @EndText
To the east is a wide opening in the chains that make up the city walls,
through which a deep bog is visible.
EndText
    );
    set ("exits", ([   
    "east" : BAATOR+"minauros/bog11.lpc",
    "north" : BAATOR+"minauros/hiter10.lpc",
    "south" : BAATOR+"minauros/hiter20.lpc"
    ]));
}