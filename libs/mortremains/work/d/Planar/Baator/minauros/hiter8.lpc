#include <mudlib.h>
#include "baator.h"

inherit MINAUROS+"hiterstd.lpc" ;

void create() {    
    ::create();
    set ("exits", ([   
      "east" : BAATOR+"minauros/hiter9.lpc"
    ]));
    reset();
}

void reset(){    
    object ob;

    ::reset();
    seteuid(getuid()) ;  

    if (present("kyton", this_object()) ) return;

    ob = clone_object(BAATOR+"monsters/kyton");
    ob->move(this_object());

    ob = clone_object(BAATOR+"monsters/kyton");
    ob->move(this_object());

    ob = clone_object(BAATOR+"monsters/kyton");
    ob->move(this_object());

    return;
}

