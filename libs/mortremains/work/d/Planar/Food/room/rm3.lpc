#include <config.h>
#include <mudlib.h>

inherit ROOM;

#include "../food.h"

void create()
{
    ::create();
    seteuid( getuid() );
    set( "light", 1 );
   set("short", "The Village of Foodsburg");
    set( "long", @EndText
EndText
    );
    set( "exits", ([
   "north" : RM+"rm6.lpc",
   "south" : RM+"rm2.lpc",
   "west" : RM+"rm15.lpc",
   "east" : RM+"rm16.lpc",
    ]) );
    set("item_desc", ([
   "village" : "A village of food, how odd.\n",
   "floor" : "Right there under you feet, what did you expect?\n",
    ]) );
}
