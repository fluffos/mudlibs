#include "macrosoft.h"

inherit MS_ELEV;

object mitch;

void create() {
    ::create();
    set("exits", ([ 
      "north" : FLOOR_3("hall2.lpc"),
      "south" : FLOOR_3("hall6.lpc"),
    ]) );
    set("floor", 3);

    if (!mitch) {
	mitch = clone_object( MS_MON("mitch.lpc") );
	mitch->move(TO);
    }
}

