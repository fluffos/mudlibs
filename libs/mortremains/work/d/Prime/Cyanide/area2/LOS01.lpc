#include <mudlib.h>
#include "main.h"

inherit MAIN+"/LOSmain.lpc";

void create()
{
    ::create();
    set ("short", "Land of Shadow");
    set( "long", @EndText
You are at the eastern end of a dark, featureless landscape of shallow
hills. Paths to the east and southeast re-enter the rock.
EndText
    );
    set( "exits", ([
      "east" : MAIN+"/creepy.lpc",
      "southeast" : MAIN+"/foggy.lpc",
      "south" : MAIN+"/LOS05.lpc",
      "southwest" : MAIN+"/LOS04.lpc",
      "west" : MAIN+"/LOS03.lpc",
      "northwest" : MAIN+"/LOS02.lpc",
    ]) );
    set ("exit_suppress", ([
    ]) );

    set ("item_desc", ([
    ]) );
}
