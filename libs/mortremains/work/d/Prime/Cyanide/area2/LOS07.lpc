#include <mudlib.h>
#include "main.h"

inherit MAIN+"/LOSmain.lpc";

void create()
{
    ::create();
    set ("short", "Land of Shadow");
    set( "long", @EndText
You are in a land of dark shadows and shallow hills, which stretch out in
all directions. To the west, the land dips sharply.
EndText
    );
    set( "exits", ([
      "northeast" : MAIN+"/LOS02.lpc",
      "southeast" : MAIN+"/LOS04.lpc",
      "west" : MAIN+"/ocean.lpc",
    ]) );
    set ("exit_suppress", ([
    ]) );

    set ("item_desc", ([
    ]) );
}
