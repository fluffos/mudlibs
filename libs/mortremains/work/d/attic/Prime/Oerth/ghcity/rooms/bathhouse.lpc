#include <mudlib.h>
#include "oerth.h"

inherit ROOM;
void create() {
     ::create();
          set ("light", 1) ;
seteuid(getuid());
set("objects", ([
"bather1" : "/d/Prime/Oerth/ghcity/monster/bather.lpc",
"bather2" : "/d/Prime/Oerth/ghcity/monster/bather2.lpc",
"bather3" : "/d/Prime/Oerth/ghcity/monster/bather3.lpc",
"bather4" : "/d/Prime/Oerth/ghcity/monster/bather4.lpc",
      ]) );
reset();
     set ("long",
"This is the cities public bath house. People\n"+
"from this quarter come here to clean themsleves.\n");
set("short", "Public Bath House.");
     set ("exits", ([
"west" : Oerth+"/rooms/proc6",
     ]) );
}
