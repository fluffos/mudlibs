#include <mudlib.h>
#include "oerth.h"

inherit ROOM;
void create() {
     ::create();
          set ("light", 1) ;
seteuid(getuid());
set("objects", ([ 
"brewer" : "/d/Prime/Oerth/ghcity/monster/brewer.lpc",
"helper" : "/d/Prime/Oerth/ghcity/monster/helper1.lpc",
"helper2" : "/d/Prime/Oerth/ghcity/monster/helper2.lpc",
"helper3" : "/d/Prime/Oerth/ghcity/monster/helper3.lpc",
   ]) );
reset();
     set ("long",
"This is the cities brewery. It is in this building\n"+
"that brews, and ages all the fine beers and wines\n"+
"that supply the cities pubs, inns, and restaurants.\n");
set("short", "The City Brewery.");
     set ("exits", ([
"southwest" : Oerth+"/rooms/proc8",
     ]) );
}
