#include <mudlib.h>
#include "sigil.h"

inherit ROOM ;

void create() {
     ::create();
     set ("light", 1) ;
  set("long", @ENDLONG
You are in the guildhall district of Sigil, on Main street.
The Embalming Shop is to the north.
ENDLONG
  );
  set("short", "Main Street, Guildhall Ward.") ;
     set ("exits", ([
	"north" : SIGIL+"embalmers.lpc",
"south" : SIGIL+"clericguild.lpc",
	"east" : SIGIL+"mainst7.lpc",
	"west" : SIGIL+"mainst5.lpc" ]));
}
