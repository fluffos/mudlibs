#include <mudlib.h>
#include "sigil.h"
inherit ROOM ;

void create() {
     ::create();
          set ("light", 1) ;
     set ("long",
"A hallway to the private rooms of The Inn.\n"+
"Stairs lead down to the north.\n"+
	"The hallway continues to the south.\n") ;
  set("short", "World Serpent Inn.") ;
     set ("exits", ([
     "east" : SIGIL+"serpentinn3.lpc",
     "west" : SIGIL+"serpentinn1.lpc",
		 "south" : SIGIL+"serpentinn4.lpc",
     "down" : SIGIL+"serpentinn.lpc" ]) ) ;
}
