#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    seteuid( getuid() );
    set("author" , "herself");
    set("underwater" , 1);
    set( "exits", ([
      "east" : DEEP+"deep16.lpc",
      "south" : DEEP+"deep18.lpc",
    ]) );
    set("objects" , ([
      "whale" : O_MON+"whale.lpc",
      "eel" : O_MON+"eel.lpc",
    ]) );
    reset();
}
