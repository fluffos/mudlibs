#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "east" : DEEP+"deep9.lpc",
      "west" : DEEP+"deep11.lpc",
    ]) );
    set("objects" , ([
      "whale" : O_MON+"whale.lpc",
    ]) );
    reset();
}
