#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "north" : DEEP+"deep19.lpc",
      "south" : DEEP+"deep21.lpc",
    ]) );
    set("objects" , ([
      "eel" : O_MON+"eleceel.lpc",
      "stingray" : O_MON+"stingray.lpc",
    ]) );
    reset();
}
