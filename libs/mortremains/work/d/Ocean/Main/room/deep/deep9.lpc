#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "south" : DEEP+"deep8.lpc",
      "west" : DEEP+"deep10.lpc",
    ]) );
    set("objects" , ([
      "stingray" : O_MON+"stingray.lpc",
      "catfish" : O_MON+"cat.lpc",
    ]));
    reset();
}
