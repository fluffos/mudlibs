#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "east" : DEEP+"deep13.lpc",
      "west" : DEEP+"deep15.lpc",
    ]) );
    set("objects" , ([
      "jellyfish" : O_MON+"jfish.lpc",
      "eel" : O_MON+"eel.lpc",
      "anemone" : O_MON+"anemone.lpc",
    ]) );
    reset();

}
