#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "north" : DEEP+"deep5.lpc",
      "west" : DEEP+"deep3.lpc",
    ]) );
    set("objects" , ([
      "anemone" : O_MON+"anemone.lpc",
      "eel" : O_MON+"eleceel.lpc",
    ]) );
    reset();
}
