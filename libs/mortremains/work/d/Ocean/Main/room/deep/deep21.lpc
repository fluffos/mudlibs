#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "north" : DEEP+"deep20.lpc",
      "south" : DEEP+"deep22.lpc",
    ]) );
    set("objects" , ([
      "whale" : O_MON+"whale.lpc",
      "anemone" : O_MON+"anemone.lpc",
      "jellyfish" : O_MON+"jfish.lpc",
      "eel" : O_MON+"eel.lpc",
    ]) );
    reset();
}
