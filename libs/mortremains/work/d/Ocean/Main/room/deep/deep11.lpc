#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "east" : DEEP+"deep10.lpc",
      "west" : DEEP+"deep12.lpc",
    ]) );
    set("objects" , ([
      "ganderewa" : O_MON+"ganderewa.lpc",
      "leaper" : O_MON+"leaper.lpc",
    ]) );
    reset();
}
