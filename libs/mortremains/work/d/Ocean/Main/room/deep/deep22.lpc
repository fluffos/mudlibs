#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "north" : DEEP+"deep21.lpc",
      "east" : DEEP+"deep23.lpc",
    ]) );
    set("objects" , ([
      "shark" : O_MON+"shark.lpc",
      "fish" : O_MON+"fish.lpc",
    ]) );
    reset();
}
