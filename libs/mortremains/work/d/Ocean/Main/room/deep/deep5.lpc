#include <mudlib.h>
#include "ocean.h"

inherit DEEP+"deepstd.lpc";

#define NAME    (string)this_player()->query("name")

void create()
{
    ::create();
    set( "exits", ([
      "south" : DEEP+"deep4.lpc",
      "north" : DEEP+"deep6.lpc",
    ]) );
    set("objects" , ([
      "octopus" : O_MON+"octopus.lpc",
    ]) );
    reset();
}
