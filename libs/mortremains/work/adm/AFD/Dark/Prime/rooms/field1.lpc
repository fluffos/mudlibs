#include <config.h>
#include <mudlib.h>
#include "field.lpc"
#include "../defs.h"
inherit ROOM;
object rat1;
int poked, num, rnum;

void create(){
  stuff();
  ::create();
    seteuid(getuid());
	set("exits",([
	"south":"field7.lpc",
	"west":"field2.lpc",
  	]) );
	rnum=2;
::reset();
}
int reset(){
poked=0;
if(!present(rat1)){
rat1=clone_object(MON(rat.c));
rat1->move(TO);
}
}

