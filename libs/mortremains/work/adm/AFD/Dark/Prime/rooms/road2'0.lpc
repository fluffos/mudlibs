#include <config.h>
#include <mudlib.h>
#include "../Prime.h"
#include "DESC.lpc"

inherit ROOM;

void create()
{
  seteuid(getuid());  // need this line if your gonna clone anything.
  set( "light", 1 );
  describe();
  set ("author", "cyanide");
  set( "exits", ([
    "north" : D_PRIMER+"/weaponers.lpc",
    "west" : D_PRIMER+"/road1'0.lpc",
    "south" : D_PRIMER+"/magicshop.lpc",
  ]) );
  ::create(); // this also resets the room! :)
  set ("item_desc", ([
   ]) );
}

