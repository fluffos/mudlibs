#include <config.h>
#include <mudlib.h>
#include "../Prime.h"
#include "DESC.lpc",

inherit ROOM;

void create()
{
  seteuid(getuid());  // need this line if your gonna clone anything.
  set( "light", 1 );
  describe();
  set ("author", "cyanide");
  set( "exits", ([
    "west" : D_PRIMER+"/necro_room.lpc",
    "east" : D_PRIMEW+"/boardroom.lpc",
    "south" : D_PRIMER+"/towncenter.lpc",
  ]) );
  ::create(); // this also resets the room! :)
  set ("item_desc", ([
   ]) );
}

