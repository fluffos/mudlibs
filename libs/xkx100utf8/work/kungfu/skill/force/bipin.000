#include <ansi.h>;
#include <combat.h>;
inherit F_SSERVER;
int start_bipin(object me);

int exert(object me, string arg)
{
	object target;
	int myneili,taneili,mystr,tastr,mydex,tadex,mydodge,tadodge;
	int myexp,taexp;
	string force,force1; 
	seteuid(getuid());
	if(!arg) return notify_fail("˭ƴ\n");

	if(!objectp(target = present(arg, environment(me))))
		return notify_fail("ûˡ\n"); 

	if( !target->is_fighting() ||
		!target->is_character() ||
		!me->is_fighting() )
		return notify_fail("ƴֻսʹá\n");

	if(!living(target))
		return notify_fail("ƺٺ"+target->name()+"ƴ\n"); 
	if(target==me) return notify_fail("Լƴ\n"); 
	if(!me->is_fighting(target))
		return notify_fail(""+target->name()+"սʱ򣬲ʹƴ\n");		
	// Ƿж˫ûbusy?
	if(me->query_temp("weapon") || target->query_temp("weapon"))
		return notify_fail("˫սʱʹƴ\n");
	myneili = me->query("neili");
	taneili = target->query("neili");
	if(me->query_skill("force", 1) < 50 )
		return notify_fail("ڹΪ㣬޷Ͷֽ\n");
	if(myneili < 500 )
		return notify_fail("̫޷Ͷֽ\n");
	if(me->query_skill("force")*2/3 >= target->query_skill("force"))
		return notify_fail("ֵڹΪԶ㣬ñƴʲôأ\n");
	if((int)me->query("max_neili") < 500 )
		return notify_fail("Ϊ̫޷Ͷֽ\n");
	if(me->query_temp("neili/bipin")) 
		return notify_fail("ں˱ƴ\n");
	if(target->query_temp("neili/bipin")) 
		return notify_fail(target->name()+"ں˱ƴ\n");  
//	if (me->query("jiali") <100)
//		return notify_fail(target->name()+"ں˱ƴ\n"); 
	mystr = me->query_str();
	tastr = target->query_str();
	mydex = me->query_dex();
	tadex = target->query_dex();
	mydodge = me->query("dodge");
	tadodge = target->query("dodge");
	myexp = me->query("combat_exp",1);
	taexp = target->query("combat_exp",1);
	me->set_temp("bipin/target", target->query("id"));
	target->set_temp("bipin/target", me->query("id"));
	force = me->query_skill_mapped("force");  
	force1 = target->query_skill_mapped("force");  

	write(HIY"۱ƳһƣһɾȻѹ" + target->name() + "ѹ˹ȥ\n"NOR);

	tell_room( environment(me), HIY+me->name()+"ƳһƣһɾȻ" + target->name() + "ѹȥ\n"NOR, ({ me })); 
/*
	message_combatd(HIY"$N۱ƳһƣһɾȻѹ$nѹ˹ȥ\n""NOR, me, target);
*/
	if (random(mydex*mydodge*myexp) < tadex*tadodge*taexp*2/3)
	{
		message_combatd(HIW"$nȻæ˫ȵԾɣǿ㿪$Nһ\n"NOR, me, target);
		me->add("neili", -300);
		me->start_busy(3);
		target->start_busy(2);
	} 
	message_combatd(HIY"$nۿ޷æӲ$N˫ơ\n"NOR, me, target);

	me->add("neili",-200);
	target->add("neili",-200);
	me->set_temp("neili/bipin",1);
	target->set_temp("neili/bipin",1);
//	me->set_temp("bipin_lost", (int)me->query("neili"));
//	target->set_temp("bipin_lost",(int)target->query("neili"));
	me->set_temp("bipin/target", target->query("id"));
	target->set_temp("bipin/target", me->query("id"));
	target->start_busy((: start_bipin :));
	me->start_busy((: start_bipin :));
	me->set_temp("bipin/period", 1);
//	target->set_temp("bipin/period", 1);
//	check_pfm(me, tar, ob);
	return 1;
}
int start_bipin(object me)
{
	string tar;
	object target, *all;
	int myneili_lost, obneili_lost, period, neili, neili2, count, ok=1;

	if(!me) return 0;
	all = all_inventory(environment(me));
	for (count=0; count<sizeof(all); count++)
		if( all[count]->query("id") == me->query_temp("bipin/target"))
		{
			ok = 0;
			target = all[count];
		}
	if (ok == 1) return 0;
/*
	tar = me->query_temp("bipin/target");
	target = present(tar, environment(me));
*/
	myneili_lost = target->query_skill("force")/20 + me->query("jiali") + target->query("jiali");
	obneili_lost = me->query_skill("force")/20 + me->query("jiali")/2 + target->query("jiali");
	period = (int)me->query_temp("bipin/period"); 
	neili = me->query("neili");
	neili2 = target->query("neili");

	me->add("neili", -myneili_lost);
	me->receive_damage("jing", 3+random(5));	
	me->receive_damage("qi", target->query("jiali")/10);
	me->improve_skill("force", random(2));
	target->add("neili", -obneili_lost);
	target->receive_damage("jing", 3+random(5));	
	target->receive_damage("qi", me->query("jiali")/10);
	target->improve_skill("force", random(2));
	if(me->is_ghost()) return 0;
//	message_combatd(HIW"$N$nƽڼȫעıƴھ\n"NOR,me, target);
	if(!target || target->is_ghost() ||
		environment(me)!=environment(target))
	{
		message_combatd(CYN"$Nھһգһ˫㼴£ҡҡϻϵվ\n"NOR, me);
		return 0;
	}
/*
	if((neili + neili2) >=4000)
	{
		message_combatd(HIW"$N$nƽڼȫעıƴھ\n"NOR, me, target);
		return 1;
	} 
	if( (neili + neili2) > 3000)
	{
		message_combatd(HIR"$N߶ھͷԽԽŨ˫ƻ$nȥ\n"NOR, me, target);
	}
	else
	{
		message_combatd(HIR"$N߶ھͷԽԽŨ˫ƻ$nȥ\n"NOR, target, me);
		return 0; 
	}
	if(neili >neili2)
	{
		message_combatd(HIR"$Nͷ۲ɢɫԽԽϾϹĶھ$nȥ\n"NOR, me, target);
		message_combatd(HIR"$NֻһԷӿæӾ\n"NOR, target);
		return 0; 
	}
*/ 
	if(neili < myneili_lost)
	{
		message_combatd(RED"$NֻѹԽԽأؿڷ񣬽ÿһмѣͻȻһҡΣεһԡ\n"NOR, me);
		me->unconcious();
		me->add("max_neili",-5); 
		me->set_delete("bipin/target",);
		target->set_delete("bipin/target",);
		me->delete_temp("neili/bipin");
		target->delete_temp("neili/bipin");
		message_combatd(HIW"$Nֻ˥˿�����ɫҰֽ\n"NOR,target);
		return 0;
	} 
	if(!living(target) && living(me))
	{
		message_combatd(RED"$NֻѹԽԽأؿڷ񣬽ÿһмѣͻȻһҡΣεһԡ\n"NOR, target);
		target->unconcious();
		target->add("max_neili",-5);
		target->unconcious();
		message_combatd(HIW"$N˿ѹסɢҵɫҰֽ\n"NOR,me);
		me->delete_temp("bipin/target",);
		target->delete_temp("bipin/target",);  
		me->delete_temp("neili/bipin");
		target->delete_temp("neili/bipin");  
		return 0;
	}
	if(!living(me) && !living(target))
	{
		me->set_delete("bipin/target");
		target->set_delete("bipin/target");
		me->delete_temp("neili/bipin");
		target->delete_temp("neili/bipin");
		message_combatd(HIW"ʱ$N϶ްѪɫѾ;ƿ֮ʱ\n"NOR, me);
		me->set_temp("last_damage_from",""+target->name()+"ͬھ");
		me->die();
		return 0;
	}

	switch(period)
	{
		case 3: 
		case 9:
		case 15:
		case 21: 
		case 27:
		case 33:
		case 39:
		case 45:
		case 51:
		case 57:
			if((neili+neili2) >=1500)
			{
				message_combatd(HIW"һᣬ$N$nͷ͸һƵİ�����ԽԽŨһ㡣\n"NOR, me, target);
			}
			break;
		case 63:
		case 69:
		case 75:
		case 81:
		case 87:
		case 93:
		case 99:
		case 115:
		case 145:
		case 175:
		case 205:  
			if(neili > neili2)
			{
				message_combatd(HIR"$N߶ھͷԽԽŨ˫ƻ$nȥ\n"NOR,me, target);
			}
			else
			{
				message_combatd(HIR"$N߶ھͷԽԽŨ˫ƻ$nȥ\n"NOR,target,me);
			}
			break;
		case 12:
		case 24:
		case 42:
		case 60:
		case 78:  
		case 96: 
		case 125:
		case 155:
		case 185:
			if(neili > neili2)
			{
				message_combatd(HIR"$Nͷ۲ɢɫԽԽϾϹĶھ$nȥ\n"NOR, me, target);
			}
			else
			{
				message_combatd(HIR"$Nͷ۲ɢɫԽԽϾϹĶھ$nȥ\n"NOR, target, me);
			}
			break; 
		case 36:
		case 54:
		case 72:
		case 90:
		case 105:
		case 135:
		case 165:
		case 195:
			if(me->query("jiali") < target->query("jiali"))
			{
				message_combatd(HIR"$NֻһԷӿæӾ\n"NOR,me);
			}
			else
			{
				message_combatd(HIR"$NֻһԷӿæӾ\n"NOR,target);
			}
			break;
	} 

	period++;
	me->set_temp("bipin/period", period);
//	target->set_temp("bipin/period", period);
//	me->delete_temp("neili/bipin");
//	target->delete_temp("neili/bipin");
	return 1;	
}

int help(object me)
{
	write(WHT"\nڹ֮ƴ"NOR"\n");
	write(@HELP

	ʹùЧ
		ֱݣֻܾ

	Ҫ
		ڹ50
		Ϊ500
		500
HELP
	);
	return 1;
}

