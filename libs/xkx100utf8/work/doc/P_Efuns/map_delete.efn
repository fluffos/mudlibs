		޴ֵ map_delete( ӳ m,  element );
	÷:
		map_delete ɾӳйؼַ element  
		(ؼ, ֵ) .

		:

		mapping names;

		names = ([]);
		names["truilkan"] = "john";
		names["wayfarer"] = "erik";
		names["jacques"] = "dwayne";

