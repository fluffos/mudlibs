init()
	{
	add_action("do_take","take");
	add_action("do_take","pick");
	add_action("do_zuan","zuan");
	add_action("do_zuan","enter");
	add_action("do_study","study");
	add_action("do_study","du");
	}
int do_take(string arg)
{
	object me=this_player();
	object ob;
	if (!arg || arg!="zhongjian")
		return notify_fail("Ҫȡʲô?\n");
	if (ob=find_object(XUANTIE))
		return notify_fail("ȥȡŷֻʣˣͱȡ...\n");
	if (query("count")<1 )
		return notify_fail("ȥȡŷֻʣˣͱȡ...\n");
	if (me->query_str()<30)
		return notify_fail("̫أ˰쾢ò\n");
	add("count",-1);
	tell_object(me,"Ĵʯϼһڽ\n");
 	message("channel:rumor", MAG"ҥԡĳˣ"+this_player()->query("name")+"һ\n"NOR, users());
	ob=new(XUANTIE);
	if (!ob=find_object(XUANTIE));
	ob=new(XUANTIE);
	if (!ob->move(me)) {ob->move(environment(me));}
	return 1;
}
int do_zuan(string arg)
{
	object me=this_player();
	
	if (!arg || arg!="table")
		return notify_fail("Ҫ굽ȥ?\n");
	if (me->query_str()>30)
		return notify_fail("̫겻ӵ¡\n");
	message_vision("$Nһ굽ȥ\n",me);
	me->move("d/gaochang/mishi3");
	message("vision",me->query("name")+"˽\n",environment(me),({me}));
	return 1;
}
int do_study(string arg)
{
	object me = this_player();
	int cost;
	if ( !arg || ( arg != "table" ) )
		return notify_fail("ʲô\n");

	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("ǸäѧĻ(literate)ɡ\n");

	cost=50-me->query("int");
	if (me->query("jing")<cost)
		return notify_fail("ڹƣ룬޷רж֪");
	
	message_vision("$NרжʯϵĹŹͼΡ\n", me);

		if ( (int)me->query_skill("literate", 1) < 150)
		{
			me->improve_skill("literate", me->query_int());
			write("ʯĥһضƺԶдеĵá\n");
			me->add("jing", -cost);
		}
		else
		write("ʯĥһض�����˵̫ǳԣ˵Ѻˡ\n");

	return 1;
}

