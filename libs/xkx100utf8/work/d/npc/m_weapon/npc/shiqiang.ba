void init()
{
	::init();
	add_action("do_zhu","zhu");
}

int accept_object(object who, object ob)
{	
	if(!(who->query_temp("spear") ) )
	{
		message_vision(HIC"ʦûͬΪǹذɣ\n"NOR, who);
		return 1;
	}
	who->delete_temp("spear");
	who->set_temp("m_spear",1);
	switch ((string)ob->query("id") ) 
	{
		case "shen mu": 
			who->add_temp("shenmu",1);
			break;
		case "jin mu":
			who->add_temp("jinmu",1);
			break;
		case "han zhu": 
			who->add_temp("hanzhu",1);
			break;
		case "iron stone": 
			who->add_temp("ironstone",1);
			break;
		default :
			message("vision","ʲôʦ˵ⲻ",who);
			return 0;
	}
	message("vision", "ǹͷһе"+(string)ob->query("name")+"˵ͷ˵\n", who);
	message("vision", "ھͿʼǹ\n", who);
	write("λ"+RANK_D->query_respect(who)+"ǹְɣ(zhu ǹ ӢĴ)\n");
	return 1;
}

int do_zhu(string arg)
{
	string o_name,id,w_name;
	object spear,make_time;   //ɵ
	object me;
	me = this_player();
	if(!(me->query_temp("m_spear")) ) 
		return notify_fail("ʲô\n");
	me->delete_temp("m_spear");
	me->delete_temp("get_orc");
	me->delete_temp("or");

	if((me->query("weapon/make")) )
	{
		say("ǹһãȻѾһˣʲôѵô\n");
		return 2;
	}
	if( !arg )
		return notify_fail("ǹ˵ǹƼźڶ˵\n");

	sscanf(arg ,"%s %s" ,w_name ,id);
	if(!w_name||!id)
		return notify_fail("ʲô(ʹzhu ǹ ӢĴ)\n");
	if(id == "corpse" || w_name == "corpse")
		return notify_fail("ǷǹּӢĴš\n");
	if(me->query_temp("shenmu") ) o_name="ǧľ";
	if(me->query_temp("jinmu") )  o_name="׽ĸ";
	if(me->query_temp("hanzhu") ) o_name="˿";
	if(me->query_temp("ironstone") ) o_name="ʯ";
	make_time=NATURE_D->game_time();
	message_vision(me->name()+"һᣬǹ˵˼仰ǹ˵ͷ˵ðɣ\n",me );
	message_vision("\nǹعתһ޴Ļ¯ĶȼܵĴ˵ʼ\n",me );
	message_vision(BLU "$N˫סһ޴�����͵¯н"+o_name+"ȥ\n" NOR,me);
	message_vision(RED "ֻһ죬ͷ"+o_name+"ճһ\n" NOR,me );
	message_vision(YEL "$NֻһȣѪҺƺ����\n" NOR,me);
	message_vision(HIM "һѪԴԴϵ¯е"+o_name+"ӿȥ\n" NOR,me );
	if( (me->query("qi"))<(me->query("max_qi")) || (me->query("jing"))<(me->query("max_jing")) || (me->query("neili"))<(me->query("max_neili")) )
	{
		message_vision(HIR "ͻȻ$NѪһӿһӲ \n" NOR, me);
		me->set("neili",0);
		me->unconcious();
		return 1;
	}
	message_vision(HIR "ֻһ죬һǹ¯ٿȻԾ𡣻һ͵$Nǰش\n" NOR,me );
	say("ǹ״УǹɣѪԼ\n");
	message_vision("$NֻǰһһӰѸޱȵĵ$Nǰ\n",me);
	message_vision("ǹ͸شǹҺһѪǣ\n",me );
	message_vision(RED "ǹһȣ˵ϡǹѾһϢˡ\n" NOR,me);
	this_object()->set("max_qi",10);
	message_vision("ǹַɵգһصϡ\n¯еĻˡһҵľΣһֹڳš\n",me );

	me->set("qi",10);
	me->set("jing",10);
	me->set("neili",0);

	w_name = replace_string(w_name, "$BLK$", BLK);
	w_name = replace_string(w_name, "$RED$", RED);
	w_name = replace_string(w_name, "$GRN$", GRN);
	w_name = replace_string(w_name, "$YEL$", YEL);
	w_name = replace_string(w_name, "$BLU$", BLU);
	w_name = replace_string(w_name, "$MAG$", MAG);
	w_name = replace_string(w_name, "$CYN$", CYN);
	w_name = replace_string(w_name, "$WHT$", WHT);
	w_name = replace_string(w_name, "$HIR$", HIR);
	w_name = replace_string(w_name, "$HIG$", HIG);
	w_name = replace_string(w_name, "$HIY$", HIY);
	w_name = replace_string(w_name, "$HIB$", HIB);
	w_name = replace_string(w_name, "$HIM$", HIM);
	w_name = replace_string(w_name, "$HIC$", HIC);
	w_name = replace_string(w_name, "$HIW$", HIW);
	w_name = replace_string(w_name, "$NOR$", NOR);

	me->set("weapon/make",1);		//ֹı־
	me->set("weapon/name",w_name +NOR);	//
	me->set("weapon/id",id);		//Ĵ
	me->set("weapon/lv",1);			//ȼ
	me->set("weapon/or",o_name);		//¼ԭ
	me->set("weapon/value",0);		//¼еĵ
	me->set("weapon/type","ǹ");
	me->set("weapon/time",make_time);

	spear=new("/d/npc/m_weapon/weapon/m_spear",1);	//ǹ
	spear->move(this_player());
	message_vision("ǹϣŰ߰ѪЩֵľǹ˵\nǹѡɡǹ񡣡Ҳˡ\n",me );
	say("ǹѵ˵ǹ�����պãҸˡ\n");
	message_vision("ǹ˵ꡣٿı㲻ˡ\n",me);
	this_object()->die();
	return 1;
}

