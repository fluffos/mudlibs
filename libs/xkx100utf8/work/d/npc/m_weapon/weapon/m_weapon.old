void init()
{
	add_action("do_duanlian","duanlian");
	add_action("do_hui","hui");
	add_action("do_setwmsg","setwmsg");
}

void create()
{	
	object me;
	string w_name,w_id,w_or;
	int w_lv;
	me = this_player();
	if (me->query("weapon/make"))
  {
//
	w_name=me->query("weapon/name");
	w_id = me->query("weapon/id");
	w_or = me->query("weapon/or");
	w_lv = me->query("weapon/lv");
	switch (me->query("weapon/type"))
	{
		case "":
			set("unit","");
			set("wield_msg", "$Nһһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"һ𣬱ںˡ\n");			
			init_axe(w_lv * 10);
			QI="";
			JI="ָ";
			upmsg=CYN"һһ$N"+w_name+CYN"Уˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһͳһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"һӣգۼȻӰ١\n");			
			init_staff(w_lv * 10);
			QI="";
			JI="ȶ";
			upmsg=HIY"һһ$N"+w_name+HIY"壬ˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһ飬γһ"+w_name+"С\n");
			set("unwield_msg", me->query("weapon/unwield_msg")+"\n");
			init_blade(w_lv * 10);
			QI="";
			JI="ָ";
			upmsg=CYN"һһ$N"+w_name+CYN"Уˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһóһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"һ����գۼȻӰ١\n");
			init_club(w_lv * 10);
			QI="";
			JI="ָ";
			upmsg=HIY"һƺһ"+w_name+HIY"ӿ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһȡһ"+w_name+"С\n");
			set("unwield_msg","$N"+w_name+"һգۼȻӰ١\n");
			init_hammer(w_lv * 10);
			QI="";
			JI="ָ";
			upmsg=HIY"һһ$N"+w_name+HIY"壬ˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nৡһһ"+w_name+"С\n");
			set("unwield_msg", "$Nе"+w_name+"һ׹һתۼ"+w_name+"ȻӰ\n");
			init_hook(w_lv * 10 + 2);
			QI="";
			JI="󹳼";
			upmsg=HIY"һһ$N"+w_name+HIY"ˣ\n"NOR;
			break;

		case "ǹ":
			set("unit","");
			set("wield_msg", "$Nһͳһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"һӣգۼȻӰ١\n");
			init_spear(w_lv * 10);
			QI="ǹ";
			JI="ǹͷ";
			upmsg=HIY"ǹһһ$N+"+w_name+HIY"壬ˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһͳһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"һӣգۼȻӰ١\n");
			init_stick(w_lv * 10);
			QI="";
			JI="հ";
			upmsg=HIY"һһ$N"+w_name+HIY"壬ˣ\n"NOR;
			break;

		case "":
			set("unit","");
			set("wield_msg", "$Nһһ"+w_name+"С\n");
			set("unwield_msg", "$N"+w_name+"ӭһգۼȻӰ١\n");
			init_sword(w_lv * 10);
			QI="";
			JI="ָ";
			upmsg=HIY"һһ$N"+w_name+HIY"壬ˣ\n"NOR;
			break;

		case "":
			set("unit","");
				set("wield_msg", "$NһˢĶһ"+w_name+"\n");
				set("unwield_msg","$N"+w_name+"һգۼ䲻Ӱ١\n");
			init_whip(w_lv * 10);
			QI="";
			JI="";
			upmsg=HIY"һһ$N"+w_name+HIY"ˣ\n"NOR;
