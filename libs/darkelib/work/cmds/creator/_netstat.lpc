//	/bin/dev/_netstat.c

//	Command for checking network sockets

//	coded by Descartes of Borg 23 Nov 1992



#include <std.h>

inherit DAEMON;



int cmd_netstat() {
#ifdef __PACKAGE_SOCKETS__
  /* dump_socket_status() is gone from the driver: socket_status() returns one array per socket */
  write(sprintf(
    "%-4s %-12s %-12s %-24s %-24s %s\n",
    "Fd",
    "State",
    "Mode",
    "Local address",
    "Remote address",
    "Owner"
  ));
  foreach (mixed *sock in socket_status()) {
    if (sock[1] != "CLOSED")
      write(sprintf("%-4d %-12s %-12s %-24s %-24s %s\n", sock[0], sock[1], sock[2], sock[3], sock[4],
        objectp(sock[5]) ? file_name(sock[5]) : "-"));
  }
#else
  write("This driver was built without the sockets package: there are no sockets to list.\n");
#endif
  return 1;
}



int help()

{

  write(@EndText

Syntax: netstat

Effect: Lists the status of the mud's internet sockets.

See man: dump_socket_status

See also: mstatus, cache, callouts, dumpallobj, opcprof, fdinfo

EndText

  );

  return 1;

}
