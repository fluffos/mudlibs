//      /adm/simul_efun/tail.c
//      prints the last 1024 bytes of a file to the current user, from the start of a line
//      (MudOS had tail() as an efun; FluffOS does not).  Returns 0 when the file cannot be read.

#include <config.h>

int tail(string file) {
  string str;
  int diff;

  seteuid(geteuid(previous_object()));
  diff = file_size(file);
  if (diff < 0) return 0;
  diff -= 1024;
  if (diff < 0) diff = 0;
  str = read_bytes(file, diff, 1024);
  if (!str) return 0;
  if (diff) str = str[strsrch(str, "\n") + 1..];
  write(str);
  return 1;
}
