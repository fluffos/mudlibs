// offspring.c — RTF wrapper stripped (KB 04 6.25 Also, 2026-10-27)

inherit PMODULES + "m_charnpc";
inherit M_GETTABLE;

protected string master;
protected int is_busy;

void setup(string m_id, string u_id)
{
	object o_h;
	mixed c;

	o_h = SGHOME(m_id);
	c = o_h->get_npc(u_id);
	master = m_id;

	set_gettable(1);
	set_name(c["id"], c["name"]);
	set_gender(c["gender"]);
	set_age(c["age"]);
	set_sg_rongmao(c["rongmao"]);
	set_in_room_desc(c["pre_name"] + "(" + c["id"] + ")");
	// Dress line in the RTF copy named undefined NAME/typ; free.lpc ships no dress here.

	add_question("age", "age");
	add_ask_str("age", "$N问$T：你多大了？\n");
}

void special_answer(object who, string matt)
{
	string p_id;

	p_id = who->query_primary_id();
	switch (matt) {
	case "age":
		if (p_id == master) {
			this_object()->targetted_action(
			  "$N忙上前鞠躬道：$R有何吩咐？\n", who);
			is_busy = 1;
			new(__DIR__ "free_menu")->start_menu(who, this_object());
			return;
		}
		this_object()->targetted_action("$N瞪了$T一眼。\n", who);
		return;
	}
}
