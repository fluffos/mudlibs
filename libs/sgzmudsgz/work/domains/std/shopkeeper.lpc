inherit LIVING;
inherit M_VENDOR;

/* Two inherits define direct_ask_liv_about_wrd(); the later one was already in effect: name it. */
mixed direct_ask_liv_about_wrd(object liv, string item) { return m_vendor::direct_ask_liv_about_wrd(liv, item); }

void setup() {
    set_name("Biff", "比佛");
    add_id("shopkeeper");
    set_gender(1);
    set_proper_name("售货员比佛");
    set_in_room_desc("售货员比佛");
    set_long("比佛看上去象是杀价高手。\n");
    set_for_sale(1);
    set_will_buy(1);
    set_currency_type("gold");
}
