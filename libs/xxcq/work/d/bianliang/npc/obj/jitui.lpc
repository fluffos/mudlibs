// jitui.c 鸡腿

#include <weapon.h>
#include <ansi.h>
inherit F_FOOD;
inherit ITEM;

void create() {
  set_name(HIY "烤鸡腿" NOR, ({ "jitui", "tui", "ji" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一枝烤得香喷喷的鸡腿。\n");
    set("unit", "根");
    set("value", 80);
    set("food_remaining", 4);
    set("food_supply", 15);
  }
  setup();
}
