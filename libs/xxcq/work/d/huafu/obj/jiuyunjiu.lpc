// jiuyunjiu.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("酒坛", ({ "jiuyunjiu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一坛上好的九酝酒。\n");
    set("unit", "坛");
    set("value", 100);
    set("max_liquid", 5);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "九酝酒",
    "remaining": 5,
    "supply": 15,
    "drunk_apply": 3,
  ]));
}
