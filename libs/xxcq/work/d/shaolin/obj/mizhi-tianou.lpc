// bocai-fentiao.c 蜜汁甜藕

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name(WHT"密汁甜藕"NOR, ({"mizhi tianou", "tianou"}));
	set_weight(500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一盆香甜软糯，色泽粉红的蜜汁甜藕。\n");
		set("unit", "盘");
		set("value", 1);
		set("food_remaining", 4);
		set("food_supply", 40);
	}
}
