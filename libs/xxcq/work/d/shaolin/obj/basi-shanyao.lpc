// basi-shanyao.c 拔丝山药
// by Load

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(HIM "拔丝山药" NOR, ({ "basi shanyao", "shanyao", "basi" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盆色若玫瑰，甜嫩香嫩的拔丝山药。\n");
    set("unit", "盘");
    set("value", 1);
    set("food_remaining", 4);
    set("food_supply", 40);
  }
}
