dbase (["dex":18,"combat_exp":12500,"kaifa":40,"kar":13,"title":"钱庄老板","eff_qi":233,"max_jing":200,"attitude":"friendly","str":100,"actions":,"per":29,"eff_jing":200,"chat_chance":2,"startroom":"/d/city/qianzhuang","name":"钱眼开","pighead":0,"area_file":"/d/city/npc/qian.c","int":24,"gender":"男性","chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"default_actions":,"env":(["wimpy":50,]),"shen_type":1,"max_neili":100,"race":"人类","jizhi":55,"area_id":"yzqianzhuang","nickname":"铁公鸡","age":34,"jiali":10,"food":27,"id":"qian yankai","last_save":1222784934,"water":27,"area_name":"扬州钱庄","qi":233,"max_qi":233,"shen":0,"no_put":1,"neili":200,"jing":200,"con":18,"ziyuan":"黄金",])
