// story:mirror 通天宝镜

#include <ansi.h>
inherit F_CLEAN_UP;
#define MIRROR "/clone/tongtian"

nosave string char_id;
nosave string char_name;

int give_gift();
object select_character();

nosave mixed *story = ({
        "湖边，七仙女正在梳妆...",
        "七仙女：啦啦啦——",
        "只听一声响：喀嚓！",
        "“谁？！”",
        "......",
        "“一定又是天蓬，哼！我这就去面见玉帝，一定要将他降下凡间，做个比猪还难看的！”",
        "$N口吐白沫，昏了过去。（臭婆娘，算你狠....）",
        "$N赶忙走了出来，喊道：“仙女且慢！”",
        "七仙女停住身子：“你是何人，胆敢来此禁地！”",
        "$N：%#@%&#@!",
        "$N：在下久仰仙女美名，今日特来赠一礼物，还望仙女笑纳！",
        "$N拿出一物件，递给七仙女。",
        "“这是——”",
        "“这是我家祖传之物，听说是从仙界流传下来的，只是在下不会使用，今赠于仙女。”",
        "......",
        "“这是我前些日子来凡间的时候不小心遗落的，看你有心，这面镜子就赠于你吧！”",
        (: give_gift :),
});

void create()
{
        seteuid(getuid());

        if (! objectp(select_character()))
        {
                destruct(this_object());
                return;
        }
}

string prompt() { return HIY "【江湖传说】" NOR; }

object select_character()
{
        object *obs;
        object ob;

        obs = filter_array(all_interactive(),
                           (: living($1) &&
                              ! $1->query_temp("story/mirror") &&
                              environment($1)->query("outdoors") &&
                              (! wizardp($1)) &&
                              (! $1->query("doing")) &&
                              $1->query("gender")=="男性" :));
        if (! sizeof(obs))
                return 0;

        ob = obs[random(sizeof(obs))];
        char_id = ob->query("id");
        char_name = ob->name(1);
        return ob;
}

mixed query_story_message(int step)
{
        mixed msg;

        if (step >= sizeof(story))
                return 0;

        msg = story[step];
        if (stringp(msg))
        {
                msg = replace_string(msg, "$N", char_name);
                msg = replace_string(msg, "$ID", char_id);
        }
        return msg;
}

int give_gift()
{
        object me, ob;

        me = find_player(char_id);
        if (! me) return 1;

        me -> set_temp("story/mirror", 1);
        ob = new(MIRROR);
        ob -> move(me);
        tell_object(me, HIC "你从七仙女那里得到了一面" MAG "通天宝镜" HIC "。\n" NOR);
        CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) +
                              "从七仙女那里得到了一面通天宝镜。");
        log_file("nosave/story", sprintf("%s %s(%s)得到一面通天宝镜。\n",
                ctime_format(time()), me->name(), me->query("id")));
        STORY_D->remove_story("mirror");
        return 1;
}

