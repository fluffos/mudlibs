// npcd.c

#pragma optimize
#pragma save_binary

#include <command.h>
#include <npc/name.h>
#include <npc/chinese.lpc>
#include <npc/japanese.lpc>
#include <npc/european.lpc>
#include <npc/masia.lpc>



mapping place = ([
        "扬州城"   : ({ "/d/city/beimen", "/d/city/nanmen",
                        "/d/city/ximen", "/d/city/dongmen", }),
        "北京"   : ({ "/d/city2/tian_anm", "/d/city2/xichang2",
                        "/d/city2/dongmen", "/d/city2/yongding", }),
        "襄阳"   : ({ "/d/xiangyang/walle1", "/d/xiangyang/eastjie3",
                        "/d/xiangyang/westjie1", "/d/xiangyang/southjie3", }),
        "长安"   : ({ "/d/changan/dongmen", "/d/changan/ca18",
                        "/d/ygbz/qiao", "d/changan/yuefang", }),
        "武当"   : ({ "/d/wudang/wdroad8", "/d/wudang/yuzheng",
                        "/d/wudang/bolin", "/d/wudang/nanyan", }),
        "五毒教"   : ({ "/d/wudujiao/xiaodian", "/d/wudujiao/road1",
                        "/d/wudujiao/milin2", "/d/wudujiao/neijin", }),
        "成都"   : ({ "/d/city3/dongjie3", "/d/city3/wanliqiao",
                        "/d/city3/funanhe1", "/d/city3/shuijing", }),
        "大理"   : ({ "/d/dali/shuyuan2", "/d/dali/huadian",
                        "/d/tianlongsi/dadao4", "/d/dali/huanggong3", }),
        "丐帮"   : ({ "/d/gaibang/underhs", "/d/gaibang/chuchang",
                        "/d/gaibang/xsandao2", "/d/gaibang/inhole", }),
]);




string random_place(string *not_place)
{
        string *kp;

        kp = keys(place);

        // exclude some place
        if (arrayp(not_place))
                kp -= not_place;

        // select a random place
        return kp[random(sizeof(kp))];
}

// place npc
void place_npc(object ob, string *not_place, string *in_place)
{
        string *kp;
        string p;
        string startroom;
        object pos;

        // select the place
        if (! arrayp(in_place))
                kp = keys(place);
        else
                kp = in_place;

        // exclude some place
        if (arrayp(not_place))
                kp -= not_place;

        // select the exact position
/*
        for (;;)
        {
                p = kp[random(sizeof(kp))];
                startroom = place[p][random(sizeof(place[p]))];
                pos = get_object(startroom);


                if (! objectp(pos = get_object(startroom)))
                {
                        log_file("log", sprintf("error to place npc to %s:%s\n",
                                                p, startroom));
                        continue;
                }
                break;

        }
*/

        p = kp[random(sizeof(kp))];
        startroom = place[p][random(sizeof(place[p]))];

        // move to the position
        //ob->move(pos);

        ob->move(startroom);
        ob->set("place", p);
        ob->set("startroom", startroom);
        ob->set_temp("moved", ({ }));
        message_vision("$N走了过来。\n", ob);

        return;
}

int random_move()
{
        mapping exits;
        string *dirs;

        if( !environment()||!living(this_object()) ) return 0; 
        if( !mapp(exits = environment()->query("exits")) ) return 0;

        dirs = keys(exits);
   if (!sizeof(dirs)) return 0;
        command("go " + dirs[random(sizeof(dirs))]);
   return 1;
}


