inherit ITEM;
void create() {
  set_name(HIW "钻石" NOR, ({ "diamond", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "一颗亮晶晶的钻石，据说运气好能提炼(tilian)出118星空币！\n");
    set("unit", "颗");
    set("value", 0);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "tilian");
}
int do_tilian(string arg) {
  object me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  if (random(10) > 2) {
    me->add("zjb_money", 28);
    message_vision(CYN "$N的钻石真的提炼出28星空币。\n" NOR, me);
    me->start_busy(3);
  } else {
    message_vision(CYN "$N提炼钻石失败。\n" NOR, me);
  }
  destruct(this_object());
  return 1;
}
