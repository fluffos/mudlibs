inherit ROOM;
//int get_object(object ob);
void create() {
  set("short", "客天下");
  set("long", @LONG
  绕过小湖，当你迎头眺望前方的时候，在你头顶上隐约显现出几个强劲有力的大字
                           〖客天下〗
走到这里，气氛好像凝固起来，周围散发出一阵阵杀气，让人胆战心惊。
千年古树两旁耸立着庄严的黄金狮子象，不经意打了冷战。
隐隐还能听到女子的欢歌声和男子的厮打声，还是不要久留此地,赶快离开这里吧。

LONG
  );
  set("exits", ([
    "south": "/p/residence/guanyu1216569091",
    "0": "/u/zjb/room/yingxiong1.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "$HIW$〖客天下〗");
  setup();
}
