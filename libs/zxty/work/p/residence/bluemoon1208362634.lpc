inherit ROOM;
//int get_object(object ob);
void create() {
  set("short", "烟波瀛洲阁大门");
  set("long", @LONG
煙波瀛洲閣據說是天涯最神秘的一個組織，轉過街頭，一扇大門突顯
出來。街道的喧囂一下子就遠去了，這裡的氣氛凝重，讓人無法呼吸。
大門及其莊嚴大氣，大門由玄鐵製成，黑漆漆的,充滿了歷史的滄桑感。
再抬頭一望：中間的金漆匾額上龍飛鳳舞寫著幾個大字：
               閣    洲    瀛    波    煙              
題敬刀小 
字寫得雖然很差，但是看起來還是比較端正的樣子。門口兩個巨大的石
獅子，威武端莊。這裡的一切不禁讓人遐想連篇，到底這個神秘的幫會
會有多少笑傲江湖的英雄兒女啊！？

LONG
  );
  set("exits", ([
    "north": "/p/residence/bluemoon1208363019",
    "south": "/u/zjb/room/yingxiong1.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "$HIC$烟$HIW$波$HIB$瀛洲$HIR$阁");
  setup();
}
