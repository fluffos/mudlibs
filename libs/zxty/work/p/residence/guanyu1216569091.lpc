inherit ROOM;
void create() {
  set("short", "新客路");
  set("long", @LONG
路旁东西有两根楹住，挂着一幅对联，但是你无心细看。
正墙上悬挂一个横匾，上书“奥运圣火源源不熄”八个金光闪闪的大字。
在两旁，站着数百个美女，看上去，美若天仙，宛如玉雕冰塑，似梦似幻，让你有一丝丝歹意。

LONG
  );
  set("exits", ([
    "south": "/p/residence/guanyu1216570726",
    "east": "/p/residence/guanyu1216569700",
    "west": "/p/residence/guanyu1216569366",
    "north": "/p/residence/guanyu1216568340.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "$HIW$〖客天下〗");
  set("banghui", "$HIW$〖客天下〗");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "yaoqing2");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}
