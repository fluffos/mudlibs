inherit F_CLEAN_UP;
int main(object me, string arg)
{
        string spells, spl, trg;
        object target;
        
        seteuid(getuid());
        if( me->is_busy() )
                return notify_fail("( 你上一个动作还没有完成，不能施展奇功。)\n");

    if( !arg ) return notify_fail("指令格式：qigong <招式名称>\n");
        if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
                target = present(trg, environment(me));
                if( !target ) target = present(trg, me);
                if( !target ) return notify_fail("这里没有 " + trg + "。\n");
        } else {
                spl = arg;
                target = 0;
        }
        spl = replace_string( spl, " ", "_");
        if( stringp(spells = me->query_skill_mapped("taoism")) )
     return (int)SKILL_D(spells)->qigong_zjb(me, spl, target);
                
        return notify_fail("你请先用 enable 指令选择你要使用的奇功。\n");
}
int help (object me)
{
        write(@HELP
指令格式：qigong <招式名称> [对象]
 
施法，你必需要指定<招式名称>，<对象>则可有可无。
在你使用某一个奇功之前，你必须先用 enable 指令来指定你要使用的法术系。
 
HELP
        );
        return 1;
}

