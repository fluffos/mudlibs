#include <ansi.h>

inherit F_CLEAN_UP;
int time_period(int timep, object me);
int main(object me, string arg) {
  int nowtime;
  if (!me->query_temp("wujiwan_time")) {
    write(CYN "你没有吃过无极丸！\n" NOR);
    return 1;
  }


  nowtime = (int)me->query_temp("wujiwan_time") - time();
  if (nowtime > 10)
    time_period(nowtime, me);
  else
    write(CYN "无极丸的效果马上就要消失了！\n" NOR);
  return 1;
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, CYN "你的无极丸效果还剩下 " + time + " 的时间。\n" NOR);
  return 1;
}
