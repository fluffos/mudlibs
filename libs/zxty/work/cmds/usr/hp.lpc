// Updated by Zjb@TY
#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  object ob;
  mapping my;

  string sp;
  int craze;
  int pro, dj = me->query("zjb_dj/dj");

  seteuid(getuid(me));
  if (arg == "-s") {
    sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIY "【 种 类 】" HIC " 『初始』 『先天』 『后天』 『转换』 『可转』\n");
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIW "【 臂 力 】" NOR WHT "  [%4d]   [" HIG "%4d" NOR WHT "]   [" HIW "%4d" NOR WHT "]   [" HIR "%4d" NOR WHT "]   [" HIB "%4d" NOR WHT "]\n" NOR "",
      me->query("str") - me->query("zjb_dj/str"), me->query("str"), me->query_str(), me->query("zjb_dj/str"), ((dj - 1) * 10) - me->query("zjb_dj/str"));

    sp += sprintf(HIW "【 悟 性 】" NOR WHT "  [%4d]   [" HIG "%4d" NOR WHT "]   [" HIW "%4d" NOR WHT "]   [" HIR "%4d" NOR WHT "]   [" HIB "%4d" NOR WHT "]\n" NOR "",
      me->query("int") - me->query("zjb_dj/int"), me->query("int"), me->query_int(), me->query("zjb_dj/int"), ((dj - 1) * 10) - me->query("zjb_dj/int"));

    sp += sprintf(HIW "【 根 骨 】" NOR WHT "  [%4d]   [" HIG "%4d" NOR WHT "]   [" HIW "%4d" NOR WHT "]   [" HIR "%4d" NOR WHT "]   [" HIB "%4d" NOR WHT "]\n" NOR "",
      me->query("con") - me->query("zjb_dj/con"), me->query("con"), me->query_con(), me->query("zjb_dj/con"), ((dj - 1) * 10) - me->query("zjb_dj/con"));

    sp += sprintf(HIW "【 身 法 】" NOR WHT "  [%4d]   [" HIG "%4d" NOR WHT "]   [" HIW "%4d" NOR WHT "]   [" HIR "%4d" NOR WHT "]   [" HIB "%4d" NOR WHT "]\n" NOR "",
      me->query("dex") - me->query("zjb_dj/dex"), me->query("dex"), me->query_dex(), me->query("zjb_dj/dex"), ((dj - 1) * 10) - me->query("zjb_dj/dex"));

    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    tell_object(me, sp);
    return 1;
  }

  if (arg == "-b") {
    sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(
      HIC "『 姓  名 』%-15s『相关程序』%-25s\n" NOR,
      me->name() + "(" + me->query("id") + ")",
      HIR "闭关系统" HIC "(help biguan)" NOR
    );
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIW "【精力上限】" HIM "%-15s" HIW "【可加精力】" HIM "%-25s" NOR "\n",
      chinese_number(me->query("zjb_dj/dj") * 250000),
      chinese_number(me->query("zjb_dj/dj") * 250000 - me->query("max_jingli") > 0 ?
        me->query("zjb_dj/dj") * 250000 - me->query("max_jingli") : 0));
    sp += sprintf(HIW "【内力上限】" HIG "%-15s" HIW "【可加内力】" HIG "%-25s" NOR "\n",
      chinese_number(me->query("zjb_dj/dj") * 250000),
      chinese_number(me->query("zjb_dj/dj") * 250000 - me->query("max_neili") > 0 ?
        me->query("zjb_dj/dj") * 250000 - me->query("max_neili") : 0));
    sp += sprintf(HIW "【武功上限】" HIB "%-15s" HIW "【内功上限】" HIB "%-25s" NOR "\n", chinese_number(me->query("zjb_dj/dj") * 200),
      chinese_number(me->query("zjb_dj/dj") * 200));
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    tell_object(me, sp);
    return 1;
  }

  if (arg == "-hc") {
    sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(
      HIC "『兵器主人』%-20s『 兵  器 』%-20s\n",
      me->name() + "(" + me->query("id") + ")",
      me->query("hecheng") ? me->query("hecheng/name") + HIC "(" + me->query("hecheng/lb") + ")" NOR : HIR "无" NOR
    );
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIW "【攻击力】" HIM "%-22s" HIW "【镶  锲】" HIM "%-22s" NOR "\n",
      chinese_number(me->query("hecheng/damage")), chinese_number(me->query("hecheng/qie")));
    sp += sprintf(HIW "【悟  性】" HIG "%-22s" HIW "【臂  力】" HIG "%-22s" NOR "\n",
      chinese_number(me->query("hecheng/int")), chinese_number(me->query("hecheng/str")));
    sp += sprintf(HIW "【身  法】" HIB "%-22s" HIW "【根  骨】" HIB "%-22s" NOR "\n",
      chinese_number(me->query("hecheng/dex")),
      chinese_number(me->query("hecheng/con")));
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    tell_object(me, sp);
    return 1;
  }
  if (arg == "-zz") {
    sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(
      HIC "『兵器主人』%-20s『 兵  器 』%-20s\n",
      me->name() + "(" + me->query("id") + ")",
      me->query("weapon") ? me->query("weapon/name") + HIC "(" + me->query("weapon/type") + ")" NOR : HIR "无" NOR
    );
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIW "【攻击力】" HIM "%-22s" HIW "【镶  锲】" HIM "%-22s" NOR "\n",
      chinese_number(me->query("weapon/lv") * 10 + me->query("weapon/damage")), chinese_number(me->query("weapon/qie")));
    sp += sprintf(HIW "【悟  性】" HIG "%-22s" HIW "【臂  力】" HIG "%-22s" NOR "\n",
      chinese_number(me->query("weapon/int")), chinese_number(me->query("weapon/str")));
    sp += sprintf(HIW "【身  法】" HIB "%-22s" HIW "【根  骨】" HIB "%-22s" NOR "\n",
      chinese_number(me->query("weapon/dex")),
      chinese_number(me->query("weapon/con")));
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    tell_object(me, sp);
    return 1;
  }
  if (arg == "-jia") {
    sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(
      HIC "『防具主人』%-20s『 防  具 』%-20s\n",
      me->name() + "(" + me->query("id") + ")",
      me->query("jia") ? me->query("jia/name") + HIC "(" + me->query("jia/type") + ")" NOR : HIR "无" NOR
    );
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    sp += sprintf(HIW "【防御力】" HIM "%-22s" HIW "【镶  锲】" HIM "%-22s" NOR "\n",
      chinese_number(me->query("jia/lv") * 10), chinese_number(me->query("jia/qie")));
    sp += sprintf(HIW "【悟  性】" HIG "%-22s" HIW "【臂  力】" HIG "%-22s" NOR "\n",
      chinese_number(me->query("jia/int")), chinese_number(me->query("jia/str")));
    sp += sprintf(HIW "【身  法】" HIB "%-22s" HIW "【根  骨】" HIB "%-22s" NOR "\n",
      chinese_number(me->query("jia/dex")),
      chinese_number(me->query("jia/con")));
    sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
    tell_object(me, sp);
    return 1;
  }

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob || !ob->is_character()) ob = find_player(arg);
    if (!ob || !ob->is_character()) ob = find_living(arg);
    if (!ob || !ob->is_character())
      return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();


  if (my["max_jing"] < 1 || my["max_qi"] < 1)
    return notify_fail("无法察看" + ob->name(1) + "的状态。\n");

  sp = sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n");
  sp += sprintf(HIC "【 精 气 】 %s%5d/ %5d %s(%3d%%)" HIC "    【 精 力 】 %s%5d / %5d (+%d)\n",
    status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
    status_color(my["eff_jing"], my["max_jing"]), my["eff_jing"] * 100 / my["max_jing"],
    status_color(my["jingli"], my["max_jingli"]), my["jingli"], my["max_jingli"],
    my["jiajing"]);
  sp += sprintf(HIC "【 气 血 】 %s%5d/ %5d %s(%3d%%)" HIC "    【 内 力 】 %s%5d / %5d (+%d)\n",
    status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
    status_color(
      my["eff_qi"],
      my["max_qi"]
    ), my["max_qi"] > 1000000 ? my["eff_qi"] / (my["max_qi"] / 100) : my["eff_qi"] * 100 / my["max_qi"],
    status_color(my["neili"], my["max_neili"]), my["neili"], my["max_neili"],
    my["jiali"]);
  sp += sprintf(HIW "【 食 物 】 %s%5d/ %5d      " HIW "     【 潜 能 】  %s%d\n",
    status_color(my["food"], ob->max_food_capacity()),
    my["food"], ob->max_food_capacity(),
    (int)ob->query("potential") >= (int)ob->query_potential_limit() ? HIM : HIY,
    (int)ob->query("potential") - (int)ob->query("learned_points"));
  sp += sprintf(HIW "【 饮 水 】 %s%5d/ %5d      " HIW "     【 经 验 】  %s%d\n",
    status_color(my["water"], ob->max_water_capacity()),
    my["water"], ob->max_water_capacity(),
    HIM,
    my["combat_exp"]);

  sp += sprintf(HIR "【 级 数 】  %d                    " HIY " 【实际经验】 %d" + 0 + "" + 0 + "\n",
    ob->query("zjb_dj/dj"), ob->query_exp());
  sp += sprintf(HIW "【 双倍奖励次数】  %d\n",
    ob->query("双倍奖励"));
  /*
        if (craze = ob->query_craze())
        {
                if (ob->is_most_craze())
                        sp += HIR "【 愤 " BLINK "怒" NOR HIR " 】  " +
                              sprintf("%-22s", ob->query("character") == "光明磊落" ? "竖发冲冠"
                                                                                    : "怒火中烧");
                else
                        sp += sprintf(HIR "【 愤 怒 】 %5d/ %5d (+%-3d)    ",
                                      craze, ob->query_max_craze(),
                                      ob->query("jianu"));
        } else
        {
                sp += HIC "【 平 和 】  ─────────    ";
        }

        sp += sprintf(HIM "【 灵 慧 】  " HIY "%d\n", my["magic_points"] - my["magic_learned"]);

*/
  sp += sprintf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n" NOR);
  tell_object(me, sp);
  return 1;
}

string status_color(int current, int max) {
  int percent;

  if (max > 0 && max < 10000000) percent = current * 100 / max;
  else if (max > 10000000) percent = current / (max / 100);
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int help(object me) {
  write(@HELP
指令格式 : hp
           hp -hc  这个指令可以查看相关合成兵器的一些数值
           hp -zz  这个指令可以查看相关自铸兵器的一些数值
           hp -b   这个指令可以查看相关闭关上限的数值
           hp -s   这个指令可以查看属性的数值
                   这里的转换就是去属性转换室转换的属性点数
                   而可转就是现在的等级支持还可以转换的属性点数
           hp <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP);
  return 1;
}
