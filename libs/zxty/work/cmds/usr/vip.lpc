#include "/doc/help.h"
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        string msg;


        if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不能移动。\n");
        if (me->is_fighting()) return 0;
        if (me->is_ghost()) return 0;

        if( !me->query("vip") )
                return notify_fail("你不是VIP。\n");
    if( me->query("doing") ) 
                return notify_fail("你在闭关呢。\n");
        if( stringp(msg = me->query("env/msg_home")) )
                message_vision(msg + "\n", me);
         me->move("/d/vip/" + geteuid(me) + "/room.lpc");
        return 1;
}
int help(object me)
{
  write(@HELP
──────────────────────────────
                  【VIP会员待遇介绍】                           
──────────────────────────────

任何玩家每次只需缴纳一百元人民币即可在一年内成为本泥潭的会员
成为会员后将享有以下待遇。

    ①   每天额外的400次双倍任务奖励（yb/4in1）

    ②   成为本泥潭会员可获得一专属房间，房间内设置木人可
         供练功，并有一专用的盟主像 (help xiang)，该像基
         本与泰上上的各个像作用相同，可用于兼容内功、清除
         判师记录时使用，唯一差别在于只在清除判师记录时可
         恢复经验值。玩家不管在哪个城市，都可使用[vip]指
         令回到自己的专属房间。
 
    ③   每月可领取一块终极矿石（任选）。(help hecheng)  
    
    ④   闭关速度X2

    ⑤   获得一万星空币
       
           

──────────────────────────────
                     【加入会员】                            
──────────────────────────────

加入会员或对会员进行续费，可通过以下途径：

    直接加QQ：229602 注明：会员交易     
附：购买多个VIP可获得优惠，同时购买两个VIP可优惠50元，购
    买三个可优惠100元。
    仅限同一玩家同时购买优惠。

──────────────────────────────
                   【会员指令】                              
──────────────────────────────

1、[vip]:返回会员专属房间的指令。

2、[tyvip]:查询相关会员权限的指令。

HELP
    );
    return 1;
}

