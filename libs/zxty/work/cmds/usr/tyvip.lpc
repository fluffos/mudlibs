#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string str;
        string week, month, day, time, year;
        string item,from,check;

     sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
    if(day=="")
     sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);

        if(!me->query("vip"))
        return notify_fail(
               HIW"你目前不是VIP，想试一下吗？请查看以下网址:\nhttp://www.jhfymud.cn/redirect.php?tid=470&goto=lastpost#lastpost\n"NOR);
        str = HIY"◇"HIW"以下为你的VIP信息：\n"NOR;
        str += sprintf(HIC"≡"HIY"======================================================="HIC"≡\n");
//        str +=sprintf(HIC"你的VIP权限由"HIM"%s"HIC"开始，为期一年"NOR"\n",me->query("vip/time"));
        str +=sprintf(HIC"你目前拥有天涯币(TYB)"HIM"%d"HIC"枚，请妥善保管"NOR"\n",me->query("moneyvip"));
        str +=sprintf(HIC"你总共消费天涯币(TYB)"HIM"%d"HIC"枚"NOR"\n",me->query("vip/buy"));
        check=year+month;            
        if(me->query("vip_gift")==check){
        str +=sprintf(HIC"你本月已经领取过终极矿石\n");}else{
        str +=sprintf(HIC"你本月还未领取终极矿石，请尽快领取，过月不补\n");}
        if(!me->query("vipmoney")){
        str +=sprintf(HIC"你还未领取VIP赠送的10W星空币奖励，请尽快到gc,climb up,s领取\n");}
        str += sprintf(HIC"≡"HIY"======================================================="HIC"≡\n");
        str += HIY"◇"HIW"\n以下为你的VIP物品信息：\n"NOR;
        str += sprintf(HIC"≡"HIY"======================================================="HIC"≡\n");
        str +=sprintf(WHT"装备开光记录，未开光的装备请尽快开光：\n");
        if (me->query("vipshop/jiasha")){
        str +=sprintf(WHT"圣僧袈裟(Jia sha)\n");}
        if (me->query("vipshop/yuyi")){
        str +=sprintf(WHT"风彩羽衣(Fengcai cloth)\n");}
        if (me->query("vipshop/ring")){
        str +=sprintf(WHT"逍遥指(Xiaoyao ring)\n");}
        if (me->query("vipshop/shoe")){
        str +=sprintf(WHT"千里靴(Qianli shoes)\n");}
        if (me->query("vipshop/yaodai")){
        str +=sprintf(WHT"黄金腰带(Huangjin yaodai)\n");}
        if (me->query("vipshop/toukui")){
        str +=sprintf(WHT"狮王头盔(Shiwang toukui)\n");}
        if (me->query("vipshop/xianglian")){
        str +=sprintf(WHT"法藤项圈(Fateng necklace)\n");}
        if (me->query("vipshop/huwan")){
        str +=sprintf(WHT"真龙护腕(Wrists)\n");}
        if (me->query("vipshop/shi")){
        str +=sprintf(HIW"魔石(MO shi)\n");}
        str += sprintf(HIC"≡"HIY"======================================================="HIC"≡\n"NOR);
        str += HIY"◇"HIM"\nVIP优惠信息，请查看：\nhttp://www.jhfymud.cn/forum-78-1.html\n"NOR;
        str += HIY"◇"HIG"\nVIP充值TYB最高优惠：充500TYB只需要200圆RMB"NOR;
        write(str+"\n\n");
        return 1;
}

int help(object me)
{
        write(@HELP

指令格式：tyvip

查询VIP各种信息。


HELP
        );
        return 1;
}


