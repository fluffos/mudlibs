// reboot.c
inherit F_CLEAN_UP;
int main(object me, string arg) {
  string wiz_status;
  object npc;
  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (me->query("id") != "zmud")
    return notify_fail("只有星空或者仔仔和风间苍月才有权利启动" + MUD_NAME + "\n");
  seteuid(getuid());
  npc = new("/clone/npc/demogorgon");
  npc->move("/d/wizard/wizard_room");
  npc->start_shutdown();
  write_file("/log/nosave/LASTCRASH", geteuid(me) + " reboot江湖风云于 " + ctime(time()) + "\n");
  write("Ok。\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: reboot
 
延时十五分钟重新起动游戏。
 
HELP
  );
  return 1;
}
