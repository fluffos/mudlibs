inherit F_CLEAN_UP;

int main()
{
object lp;
string bh;
        int i;
        object me = this_player();
        
        bh="天涯第一城";
        lp = new("/clone/misc/lingpai");     
        lp->create("天涯第一城");
        
 if(lp->query("no_use")) {
         destruct(lp);
         return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
      } 


        lp->set("tybanghui",me->query("banghui"));
        lp->save();
        destruct(lp);
        return 1;
}
