int main(object me, string arg)
{
        object user, where;
        string msg;
        if (!arg) return 0;
      if (wiz_level(me) < wiz_level(arg)&&me->query("id")!="daniel")
                return notify_fail("你不能装载巫师级别比你高的玩家。\n");

        where = environment(me);

        seteuid(arg);
        user = new(USER_OB);
        export_uid(user);
        user->set_name("", ({ arg }));
        if (!user->restore())
        { destruct(user); return notify_fail("没有这个玩家。\n");}
        user->setup();
        if( !stringp(msg = me->query("env/msg_clone")) )
                if ( where->query("outdoors") )
                        msg = "$n突然出现在$N面前。\n";
                else
                        msg = "$n突然出现在$N面前。\n";

        message_vision(msg + "\n", me, user);
        user->move(where);
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 bian player`s id
变出某个玩家。
HELP
        );
        return 1;
}

