// dealer.c 商人     write by Fan 12/01/1998
// This is a inheritable object.
// Each dealer should support buy, sell, list, value
// pawn,redeem,check 7 commands

#pragma save_binary
#include <dbase.h>
#include <ansi.h>
string value_string(int value) {
  if (value < 1) value = 1;
  else if (value < 100)
    return chinese_number(value) + "文钱";
  else if (value < 10000)
    return chinese_number(value / 100) + "两白银"
      +(value % 100 ? "又" + chinese_number(value % 100) + "文钱" : "");
  else
    return chinese_number(value / 10000) + "两黄金"
      +((value % 10000) / 100 ? chinese_number((value % 10000) / 100) + "两白银" : "") + ((value % 10000) % 100 ? "又" + chinese_number((value % 10000) % 100) + "文钱" : "");
}
string is_vendor_good(string arg, int once) {
  string *goods, *all_id;
  int i, j;
  if (goods = query("vendor_goods"))
    for (i = 0; i < sizeof(goods); i++) {
      if (!all_id = goods[i]->parse_command_id_list())
        return "";
      if (goods[i]->query("name") == arg)
        return goods[i];
      for (j = 0; j < sizeof(all_id); j++)
        if (all_id[j] == arg)
          if (goods[i]->id(arg) && once == 1)
            return goods[i];
          else once--;
    }
  return "";
}
int pay_player(object who, int amount) {
  object ob;
  int total;
  if (amount < 1) amount = 1;
  if (amount / 10000) {
    if (!ob = present("gold_money", who)) {
      ob = new(GOLD_OB);
      if (!ob->move(who)) ob->move(environment(who));
    } else total = ob->query_amount();
    ob->set_amount(amount / 10000 + total);
    amount %= 10000;
  }
  if (amount / 100) {
    if (!ob = present("silver_money", who)) {
      ob = new(SILVER_OB);
      if (!ob->move(who)) ob->move(environment(who));
    } else total = ob->query_amount();
    ob->set_amount(amount / 100 + total);
    amount %= 100;
  }
  if (amount) {
    if (!ob = present("coin_money", who)) {
      ob = new(COIN_OB);
      if (!ob->move(who)) ob->move(environment(who));
    } else total = ob->query_amount();
    ob->set_amount(amount + total);
  }
  return 1;
}
int vall(object me, string arg) {
  object ob;
  ob = present(arg, me);
  if (!ob) ob = present(arg, environment(me));
  if (!ob) ob = find_object(resolve_path(me->query("cwd"), arg));
  if (!ob) return notify_fail("没有这样物件或这样物件没有被载入。\n");
  return 1;

}
int do_value(string arg) {
  object ob;
  int value;
  int amount;
  if (!living(this_object())) return 0;
  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要拿什麽物品给当铺估价？\n");
  if (ob->query("money_id"))
    return notify_fail("这是「钱」，你没见过吗？\n");
  if (ob->query("shaolin") || ob->query("no_sell") || ob->query("no_drop")) return notify_fail("这东西是无价之宝！\n");
  value = ob->query("value");
  if (!value) {
    printf("%s一文不值。\n", ob->query("name"));
    return 1;
  } else if (!amount = ob->query_amount()) amount = 1;
  value *= amount;
  if (value < 100)
    printf("\n %s%s%s价值%s。\n如果你要典当(pawn)，可以拿到%s。\n如果卖断(sell)，可以拿到%s。\n",
      chinese_number(amount), (ob->query("base_unit") ? ob->query("base_unit") : ob->query("unit")), ob->query("name"), value_string(value),
      value_string(value * 60 / 100), value_string(value * 80 / 100));
  else
    printf("\n %s%s%s价值%s。\n如果你要典当(pawn)，可以拿到%s。\n如果卖断(sell)，可以拿到%s。\n",
      chinese_number(amount), (ob->query("base_unit") ? ob->query("base_unit") : ob->query("unit")), ob->query("name"), value_string(value),
      value_string(value / 100 * 60), value_string(value / 100 * 80));
  return 1;
}
int do_pawn(string arg) {
  object ob;
  string *pawns;
  string week, month, day, time, year;
  string check;
  int value;
  int amount;
  sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
  if (day == "")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);
  check = year + month;

  if (!living(this_object())) return 0;
  if (!this_player()->query("vipcun/can"))
    return notify_fail("你好象还没有使用储存柜的权限吧?\n");
  if (this_player()->query("vipcun/can") != check)
    return notify_fail("你还没有使用储存柜的权限吧！\n");

  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要存放什麽物品？\n");
  if (ob->query("money_id")) return notify_fail("你要存放「钱」？你脑瓜有毛病？\n");
  if (ob->query("age")) return notify_fail("你要存放「人」？你脑瓜有毛病？\n");
  if (ob->query("no_vipcun")) return notify_fail("装备不能存到这里，你想用BUG复制啊？\n");
  if (ob->query("zhuren")) return notify_fail("你脑瓜有毛病？\n");

  value = ob->query("value");

  pawns = this_player()->query("vipxiang");
  if (sizeof(pawns) > 80)
    return notify_fail(this_object()->query("name") + "说道：客官在本店存放的物品太多了，小店怕日后担当不起。\n");
  if (!amount = ob->query_amount()) amount = 1;
  value *= amount;
  if (value < 100)
    value = value * 60 / 100;
  else
    value = value / 100 * 60;
  //    pay_player(this_player(), value);
  message_vision("$N把身上的" + ob->query("name") + "拿出来存放在储存柜中。\n", this_player());
  if (!pawns)
    this_player()->set("vipxiang", ({ base_name(ob) }));
  else {
    pawns += ({ base_name(ob) });
    this_player()->set("vipxiang", pawns);
  }
  log_file("login/vip2", sprintf("%s存了个%s,(%s)\n", this_player()->query("id"), base_name(ob),
    "/cmds/usr/rtime.lpc"->chinese_time(5, ctime(time()))));

  destruct(ob);
  return 1;
}
int do_check(string arg) {
  string str, *ob;
  object me, obj;
  int i;
  if (!living(this_object())) return 0;
  me = this_player();
  if (arg) {
    if (wizardp(me)) {
      obj = find_player(arg);
      if (!obj) obj = find_living(arg);
      if (!obj) obj = present(arg, environment(me));
    } else return 0;
  }
  if (!objectp(obj)) obj = me;
  if (!(ob = obj->query("vipxiang")))
    return notify_fail(this_object()->query("name") + sprintf(
      "说道：%s你的储存柜中没有任何物品。\n",
      obj == me ? "你" : obj->short(1)
    ));
  str = "\n" + ((obj == me) ? "你" : obj->query("name")) + "的储存柜中存放的物品如下:\n\n";
  for (i = 0; i < sizeof(ob); i++) {
    str += sprintf("%-40s  \n",
      ob[i]->short(),
    );
  }
  write(str);
  return 1;
}
int do_redeem(string arg) {
  string *pawns, *new_pawns, ob;
  string week, month, day, time, year;
  string check;
  object obj;
  mapping all_id;
  int i, j;

  sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
  if (day == "")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);
  check = year + month;

  if (!living(this_object())) return 0;
  if (!(pawns = this_player()->query("vipxiang")))
    return notify_fail(this_object()->query("name") + "说道：客官您的储存柜中没有存放过任何物品。\n");
  if (!this_player()->query("vipcun/can"))
    return notify_fail("你好象还没有使用储存柜的权限吧?\n");
  if (this_player()->query("vipcun/can") != check)
    return notify_fail("你还没有使用储存柜的权限吧！\n");

  for (i = 0; i < sizeof(pawns); i++) {
    ob = pawns[i];
    all_id = ob->parse_command_id_list();
    for (j = 0; j < sizeof(all_id); j++) {
      if (all_id[j] == arg)
        break;
    }
    if (j != sizeof(all_id))
      break;
  }
  if (j == sizeof(all_id))
    return notify_fail(this_object()->query("name") + "急了：你...你的储存柜中何时有过这东西？\n");

  new_pawns = ({});
  j = 1;
  for (i = 0; i < sizeof(pawns); i++) {
    if (j == 1 && ob == pawns[i]) {
      j--;
      continue;
    } else new_pawns += ({ pawns[i] });
  }
  if (sizeof(new_pawns))
    this_player()->set("vipxiang", new_pawns);
  else
    this_player()->delete("vipxiang");
  message_vision("$N从储存柜中拿回一" + ob->query("unit")
    +ob->query("name") + "。\n",
    this_player());
  obj = new(ob);
  if (!obj->move(this_player())) obj->move(environment(this_player()));
  return 1;
}
string inventory_desc(object ob) {
  if (ob->query("equipped")) return "";
  else return sprintf("  (一%s)%-25s:  %s",
    ob->query("unit"), ob->short(),
    value_string(ob->query("value")));
}
