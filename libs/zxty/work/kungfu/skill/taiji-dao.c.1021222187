int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int practice_skill(object me)
{
    return notify_fail("太级刀法只能通过「"+HIC+"玄字决"+NOR+"」来演练。\n");
}
mapping query_action(object me, object weapon)
{
        int i, level;
          mapping a_action;
        level   = (int) me->query_skill("xxx-sword",1);
          me = this_player();
        if (me->query_skill("xxx-sword",1)<401)  
    return action[random(sizeof(action))];
   
        if (me->query_skill("xxx-sword",1)>400
        && me->query_skill("xxx-sword",1)<1001)
    return action2[random(sizeof(action2))];
 
        if (me->query_skill("xxx-sword",1)>1000
        && me->query("zjb_dj/dj")>=5)
  return action3[random(sizeof(action3))];

    if (me->query_skill("xxx-sword",1)>1000
        && me->query("zjb_dj/dj")<5)
 return action2[random(sizeof(action2))];
}

int valid_learn(object me)
{ 
 if ( (string)me->query("family/family_name") != "武当派") 
return notify_fail("不是武当弟子也想学这个？\n");
    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("blade", 1) <=me->query_skill("xxx-sword", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if ((int)me->query_skill("xxx-sword",1) > 150)
        return notify_fail("这套刀法只可以学到150级，以后要靠使用玄字决来提高了。\n"); 
     if ((int)me->query_skill("taiji-shengong", 1) < 50)
        return notify_fail("你的太级神功火候不够，无法学太级刀法。\n");
    return 1;
} 
mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;

 // 第二等级的伤气
        if ( me->query_skill("xxx-sword",1)>400
         && me->query_skill("xxx-sword",1)<1001
&& (me->query("neili")*3) > victim->query("max_neili") ) {
             victim->receive_wound("qi", (damage_bonus - 100) / 8 , me);
return HIW "$N的"HIG"太极刀法"HIW"已初有小成,带出一小阵"HIG"柔劲"HIW"扑向$n！！\n" NOR;
}

 //  第三等级的伤气
        if( me->query_skill("xxx-sword",1)>1000
       && me->query("zjb_dj/dj")>=5
&& (me->query("neili")*3) > victim->query("max_neili") ) {
                victim->receive_wound("qi", (damage_bonus - 100) / 3 , me);
return HIW "$N的"BLINK HIG"太极刀法"NOR HIW"已入返璞归真境界，随意一刀带动数个"BLINK HIG"太极圆意"NOR HIW"震毁$n的真元！！！\n" NOR;
  }      
}

string perform_action_file(string action)
{
   return __DIR__"taiji-dao/" + action;
}


