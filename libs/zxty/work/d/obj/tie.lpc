inherit ITEM; 
void create()
{
         set_name("紫铁", ({ "zi tie" }) ); 

    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_put",1);
                set("value",10000000);

   set("str",5);

   set("con",5);

   set("dex",5);

   set("int",5);

   set("long", "这是一个铁级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }

