inherit ITEM;
void create() {
  set_name(HIC "地界牌" NOR, ({ "dijie pai", "pai" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这里往西走是沙漠,往西南走是雪山,往东边走是扬州方向,往西北方向是天山!!\n");
    set("unit", "个");
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("value", 10000000);
  }
  setup();
}
