inherit ITEM; 

void create()
{
  int kuangshuxing=34;
     set_name(WHT"太级钢"NOR, ({ "taiji gang" }) );
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("value",2000000);
   set("no_put",1);
   set("no_give",1);
   set("zhongji_hc",1);
   set("bh",3);
   set("dex",kuangshuxing);
   set("damage",50);
   set("long", "这是一个高级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }
