inherit ITEM; 

void create()
{
     set_name(HIW"点钢"NOR, ({ "dian gang" }) );
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_drop",1);             
   set("no_put",1);
   set("no_give",1);
   set("bh","2");
   set("str",8+random(9));
   set("long", "这是一个钢级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }
