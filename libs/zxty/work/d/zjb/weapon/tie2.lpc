inherit ITEM; 

void create()
{
  int kuangshuxing=5+random(6);
     set_name(HIR"红铁"NOR, ({ "hong tie" }) );
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_put",1);
   set("value",1500000);
   set("str",kuangshuxing);
   set("long", "这是一个铁级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }
