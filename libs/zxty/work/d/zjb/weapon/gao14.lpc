inherit ITEM;

void create() {
  int kuangshuxing = 15 + 3;
  set_name(HIM "玄武铁" NOR, ({ "xuanwu tie" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("value", 2000000);
  set("no_put", 1);
  set("no_give", 1);
  set("zhongji_hc", 1);
  set("bh", 4);
  set("con", kuangshuxing);
  set("damage", 100);
  set("long", "这是一个高级的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
