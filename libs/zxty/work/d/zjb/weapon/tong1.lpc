inherit ITEM;

void create() {
  int kuangshuxing = 2 + random(4);
  set_name(HIC "青铜" NOR, ({ "qing tong" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("no_put", 1);
  set("value", 1000000);
  set("int", kuangshuxing);
  set("long", "这是一个铜级的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
