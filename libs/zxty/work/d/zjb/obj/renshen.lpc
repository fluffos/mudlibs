inherit ITEM;
void create()
{
        set_name(HIY"人参"NOR, ({ "ren shen","shen"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗稀有人参!听说是从大雪山挖来的!\n");
                set("unit", "颗");
                  set("value",100000);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
  int maxneili,neili;
    neili = me->query("neili");
    maxneili = me->query("max_neili");
    
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

   if(neili >= maxneili*2)  
  return notify_fail("你的内力太高了,吃不了了。\n");
    
    me->add("neili",maxneili/5);  
    
  message_vision(HIY"$N拿起人参吃了下去,感觉内力有所增加。\n"NOR,me);
       destruct(this_object());
       return 1;
}

