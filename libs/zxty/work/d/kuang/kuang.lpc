inherit ROOM;
inherit F_SAVE;
int do_drop(object me, object obj);
string money_str(int count);
int cot;
void kicking(object ob);
void create()
{
        set("short", "矿石区");
        set("long", @LONG
这是长安城郊外的一个矿石区，听说在这里可以挖到金属，如果有一定
挖矿经验的人还能挖到高级金属!你也可以来挖挖(wakuang)看。
LONG
        );
        set("no_sleep_room",1);
       set("no_fight",1);
        set("exits", ([ /* sizeof() == 1 */
   "north" : "/d/changan/ca13",
]));

    set("no_magic", 1);
        setup();
}
void init()
{
object ob=this_player();

        add_action("do_wakuang", "wakuang");
        add_action("do_drop2", "drop");
        if (!wizardp(this_user()))
        add_action("discmds",({"duanlian","ansuan","touxi","persuade","teach","exert","exercise","study","learn","sleep","kill","steal","cast","conjure","expell","fight","hit","perform","prcatice","scribe","surrender"}));
        if (userp(ob))
        {
          kicking(ob);
        }
}
void kicking(object ob)
{
object *usr; 
    int i;
    string str;
    str=query_ip_number(ob); 
    usr=all_inventory(); 
     for(i=0; i<sizeof(usr); i++) { 
         if (! usr[i]->query("mud_age"))  continue; 
         if (usr[i]->query("name")==ob->query("name"))  continue; 

                if (str==query_ip_number(usr[i]))
         ob->move("/d/wizard/fightroom3"); 
    tell_object(ob,"每IP只允许两人挖矿！\n");

   }
}
 int discmds()
{
    tell_object(this_player(),"还是老老实实挖矿吧？！\n");
    return 1;
}
int do_wakuang(string arg)
{
        int time;
        object me;
        me = this_player();
        time = 300/(int)me->query("str");
        if (time <10) time = 10;

       if ((int)me->query("jing")<30 || (int)me->query("qi")<30) return notify_fail("你快累死了，要矿不要命了吗？\n");
       if (me->query_temp("wakuang")&&me->query_temp("wa_zjb")>time()) return notify_fail(HIG"加油呀！努力挖好矿！\n"NOR);

        write(HIY"你拿起铁锤狠狠的砸着石头，希望挖出一个好矿出来......\n"NOR);
        me->set_temp("wakuang",1);
        me->set_temp("wa_zjb",time()+10);
        call_out("working",8+random(time),me);
        return 1;
}
int working(object me)
{
        string id,file,filename,timestamp,temp;
    	string arg;
		object obj;
        string ob;
	    int i,j,x,y,z,u; 

     

        if (!me)        return 1;
        
        me->add("jing",-30);
        me->add("qi",-30);
        if((string)environment(me)->query("short")!="矿石区")
        {
        write("你挖矿的时候开小差，结果什么也没挖到!\n");
        me->delete_temp("wakuang");
        return 1;
        }
      if ( (me->query_skill("wakuang-shu",1) > 500&& random(1000)>998)
        || (me->query_skill("wakuang-shu",1) > 1000 && random(300)>298)
         || (me->query_skill("wakuang-shu",1) > 700 &&random(500)>498)) {
        if (random(100)>95)
        switch (random(4)) {
                case 0: ob = "/clone/baoshi/gao11.o"; break;
                case 1: ob = "/clone/baoshi/gao12.o"; break;
                case 2: ob = "/clone/baoshi/gao13.o"; break;
                case 3: ob = "/clone/baoshi/gao14.o"; break;
        }
            
        else 
        switch (random(4)) {
                case 0: ob = "/clone/baoshi/gao21.o"; break;
                case 1: ob = "/clone/baoshi/gao22.o"; break;
                case 2: ob = "/clone/baoshi/gao23.o"; break;
                case 3: ob = "/clone/baoshi/gao24.o"; break;
        }
        }else
     if ( (me->query_skill("wakuang-shu",1) > 150&& random(100)>98)
       || (me->query_skill("wakuang-shu",1) > 400 && random(100)>96) ){
        switch (random(5)) {
                case 0: ob = "/clone/baoshi/gang1.o"; break;
                case 1: ob = "/clone/baoshi/gang2.o"; break;
                case 2: ob = "/clone/baoshi/gang3.o"; break;
                case 3: ob = "/clone/baoshi/gang4.o"; break;
                case 4: ob = "/clone/baoshi/gang5.o"; break;
        }
        } else

     if ( (me->query_skill("wakuang-shu",1) > 550&& random(100)>98 && me->query("canwazhongji"))
       || (me->query_skill("wakuang-shu",1) > 400 && random(100)>98) && me->query("canwazhongji")){
        ob = "/clone/baoshi/jue";
        me->delete("canwazhongji");
        } else

        if ( random(me->query_skill("wakuang-shu",1))
             < me->query_skill("wakuang-shu",1)/2) {
        if ( random(100)>98 )
        switch (random(5)) {
                case 0: ob = "/clone/baoshi/tie1.o"; break;
                case 1: ob = "/clone/baoshi/tie2.o"; break;
                case 2: ob = "/clone/baoshi/tie3.o"; break;
                case 3: ob = "/clone/baoshi/tie4.o"; break;
                case 4: ob = "/clone/baoshi/tie5.o"; break;
        }
        else 
        switch (random(5)) {
                case 0: ob = "/clone/baoshi/tong1.o"; break;
                case 1: ob = "/clone/baoshi/tong2.o"; break;
                case 2: ob = "/clone/baoshi/tong3.o"; break;
                case 3: ob = "/clone/baoshi/tong4.o"; break;
                case 4: ob = "/clone/baoshi/tong5.o"; break;
        }
        }
        else
        write(HIC"你挖了好久，但是什么也没挖到。\n"NOR);
        
        if ( ob )
        {
           temp=read_file(ob,1,1);
	      	 i=random(atoi(temp))+random(atoi(temp))+2; 
		        if(random(10000)>9996)	i *=3;
	                j=random(atoi(temp))+random(atoi(temp))+5;
	                x=random(atoi(temp))+random(atoi(temp))+8;
                    y=random(atoi(temp))+random(atoi(temp))+10;
                    z=random(atoi(temp))*10+20;
					u=random(512)+1;
    	 if(random(10000)>9996)	z *=2;
		id = me->query("id");
        file=read_file(ob);
		file=replace_string(file,temp,"");
		file=replace_string(file,"ximenint", sprintf("%d", i));
		file=replace_string(file,"ximendex", sprintf("%d", j));
		file=replace_string(file,"ximenstr", sprintf("%d", x));
    	file=replace_string(file,"ximencon", sprintf("%d", y));
		file=replace_string(file,"ximendam", sprintf("%d", z));
//		file=replace_string(file,"可以用来合成兵器!(help hecheng)", "可以用来镶嵌兵器!(xiangqian xxx)");
       if ( random(10)>8 )
        switch (random(4)) {
                case 0: file=replace_string(file,"dj","int"); break;
                case 1: file=replace_string(file,"dj","con"); break;
                case 2: file=replace_string(file,"dj","dex"); break;
                case 3: file=replace_string(file,"dj","str"); break;
            }
		timestamp = sprintf("%c%c%c%c%c%c%c",'a'+random(20),'a'+random(20),'a'+random(20),
        'a'+random(20),'a'+random(20),'a'+random(20),'a'+random(20));
		filename = "/p/baoshi/"+ u +"/"+ id +timestamp+".lpc";
        write_file(filename,file,1);
		ob=filename;
        obj = new(ob);
		write(HIM"恭喜你，你挖到了一个"+ob->name()+"。\n"NOR);
        if ( !obj->move(me) ) destruct(obj);                
        }
        me->add("combat_exp",1000+random(100));
        me->add("potential",1000+random(1350));
        me->delete_temp("wakuang");
        if ( me->query_skill("wakuang-shu",1) <100 )
        me->improve_skill("wakuang-shu", me->query_int()*300+random(100));
        else if ( me->query_skill("wakuang-shu",1) < 200 )
        me->improve_skill("wakuang-shu", me->query_int()*60+random(100));
        else
        if ( me->query_skill("wakuang-shu",1) >= 200 )
        me->improve_skill("wakuang-shu", me->query_int()*20+random(100));
        write(HIY"经过此次挖矿，你对挖矿的技术似乎更有点心得了。\n"NOR);

        return 1;
}

int do_drop(object me, object obj)
{
   int count;
   string file;
   if(me->is_busy())
      return notify_fail("你正忙着呢．．．\n");
      
   if (obj->move(environment(me))) 
   {
    
       if( obj->is_character() )
            message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
       else if (obj->query("money_id"))
           message_vision( sprintf("$N丢下一%s$n。\n",obj->query("unit")),me, obj );
       else 
            { 
message_vision( sprintf("$N将一%s$n扔进矿区垃圾堆。\n",obj->query("unit")),me,obj);
                 destruct(obj);
             }
       return 1;
    }
    return 0;
}

int do_drop2(string arg)
{
   object me = this_player();
   object obj, *inv, obj2;
   int i, amount;
   string item;

        if(me->is_busy())
           return notify_fail("你正忙着呢．．．\n");
 
   if(!arg) return notify_fail("你要丢弃什么东西？\n");

   if(sscanf(arg, "%d %s", amount, item)==2) {
     if( !objectp(obj = present(item, me)) )
        return notify_fail("你身上没有这样东西。\n");
     if( !obj->query_amount() )
        return notify_fail( obj->name() + "不能被分开丢弃。\n");
     if( amount < 1 )
        return notify_fail("东西的数量至少是一个。\n");
     if( amount > obj->query_amount() )
        return notify_fail("你没有那么多的" + obj->name() + "。\n");
     else if( amount == (int)obj->query_amount() || !amount )
        return do_drop(me, obj);
     else {
        obj2 = new(base_name(obj));
        obj2->set_amount(amount);
        if(do_drop(me, obj2)) { // succeed to drop
            obj->set_amount( (int)obj->query_amount()-amount );
            return 1;
        }
        else obj2->move(me);
        return 0;
     }
   }

   if(arg=="all") {
     inv = all_inventory(me);
     for(i=0; i<sizeof(inv); i++) {
        do_drop(me, inv[i]);
     }
     write("Ok.\n");
     return 1;
   }

   if(!objectp(obj = present(arg, me)))
     return notify_fail("你身上没有这样东西。\n");
   return do_drop(me, obj);
}

