// m_jia.c

#include <ansi.h>

#include <armor.h>
inherit F_AUTOLOAD;
inherit CLOTH;

int do_hui(object weapon);
int do_rename(string arg);
int do_qie(string arg);
int do_clean(string arg);
int do_xiang(object me,object obj);


void init()
{
        add_action("do_duanlian","lianjia");
    add_action("do_hui","cuihui");
    add_action("do_rename","gaiming");
     add_action("do_qie","xiang");
    add_action("do_clean","genghuan");
}


void create()
{	
	object me;
	string w_name,w_id,w_or;
	int w_lv,w_lv2;
	me = this_player();
//读入数据
        w_name=me->query("jia/name");
    w_id = me->query("jia/id"); 
        w_lv2 = me->query("jia/damage"); 
	w_id = "my "+me->query("jia/id");
	w_or = me->query("jia/or");
	w_lv = me->query("jia/lv");
        if (!me->query("jia/name"))
        {
	w_name="自制的甲衣";
        }	
        if (!me->query("jia/id"))
        {
	w_id="jia";
        }	
        if (!me->query("jia/or"))
        {
	w_or="千年神木";
        }	
        if (!me->query("jia/lv"))
        {
	w_lv=1;
        }	
        if (me->query("jia/lv",1) > 200)
        {
	w_lv=200;
        }	
        if (me->query("jia/material2")) //是否有特殊材料
        {
        	set("material2", me->query("jia/material2"));
        }
        if (me->query("jia/long")) //是否有特殊材料
        {
        	set("material2", me->query("jia/long"));
        }   
        
    if ( me->query("jia/int") ) 
    set("armor_prop/intelligence",me->query("jia/int"));
    if ( me->query("jia/dex") ) 
    set("armor_prop/dexerity",me->query("jia/dex"));
    if ( me->query("jia/con") ) 
    set("armor_prop/constitution",me->query("jia/con"));
    if ( me->query("jia/str") ) 
    set("armor_prop/strength",me->query("jia/str"));
        
        set("material", "fur");
	set_name(w_name, ({w_id}));
	set("unit", "件");   
	set("value",0);
	set("no_get",1);
	set("no_drop",1);
	set("no_put",1);
	set("no_beg",1);
	set("no_steal",1);
	    set("nopaimai",1);
	set("ownmake",1);
set("material", "fur");
    set("zhuren", me->query("id"));
	switch(w_or)
		{
		case "千年神木" :
			set_weight(500);
set("material", "fur");
			break;
		case "海底金母" :
			set_weight(1000);
set("material", "fur");
			break;
		case "寒丝羽竹" :
			set_weight(30);
set("material", "fur");
			break;
		default :
		} 
	set("unit", "件");   
	if( me->query("jia/wear_msg"))
		set("wear_msg", me->query("jia/wear_msg")+"\n");
	else
		set("wear_msg", "$N穿上"+w_name+"在身上。\n");
	if( me->query("jia/unequip_msg"))
		set("unequip_msg", me->query("jia/unequip_msg")+"\n");
	else
		set("unequip_msg", "$N身上的"+w_name+"脱了下来，眨眼间已然不见影踪。\n");
                set("armor_prop/armor", w_lv * 10 + w_lv2 );
set("armor_type","cloth");
set("material", "fur");
	setup();
}	



int do_duanlian(object weapon)
{
	object me;
	int w_zhi, w_level;
	string w_or;

	me=this_player();
	weapon=this_object();

	if( !weapon )
		return notify_fail("你要锻炼什么?\n");

	if(weapon->query("equipped") ) 
	return notify_fail("甲你正穿着呢!\n");

	if( (int)me->query("jingli") < 10 )
		return notify_fail("你的内力不够，无法锻炼甲气！\n");

	if( (int)me->query("max_jingli") < 500 )
		return notify_fail("你的内力不够，无法锻炼甲气！\n");

if (userp(me) && !me->query_skill_mapped("force"))
return notify_fail("你没有内功，在使用中啊!\n");

		
	if( (int)me->query("qi") < 150 )
		return notify_fail("你的气不够，无法锻炼甲气！\n");

	if( (int)me->query("eff_qi") < 30 )
		return notify_fail("你现在的体力太弱，无法锻炼甲气！\n");

	if( (int)me->query("eff_jing") < 10 )
		return notify_fail("你现在的精力无法集中，不能锻炼甲气！\n");

	if( ((int)me->query("potential") - (int)me->query("learned_points"))< 2 )
		return notify_fail("你的潜能不够，无法锻炼甲气！\n");

	message_vision(HIR "$N手指甲脊，一股内力丝丝的传了进去。\n" NOR, me);

	me->add("max_jingli",-10);
	me->set("jingli", (int)me->query("max_neili"));
	me->add("qi",-150);
	me->add("eff_qi",-30);
	me->add("jing",-30);
	me->add("eff_jing",-30);
	me->add("learned_points", 2);

	w_zhi = (int)me->query("jia/value");
	w_zhi++;
	me->set("jia/value", w_zhi);
	w_or = (string)me->query("jia/or");
	w_level = (int)me->query("jia/lv");
	if( w_zhi >= ((w_level + 2) * (w_level + 2)))
	{
		w_level++;
		me->set("jia/lv", w_level);
		message_vision(CYN "甲身忽的一闪，一道银光隐入$N的甲中，不见了！\n" NOR,me);
		message_vision(HIG "$N的甲的等级提高了！\n" NOR, me);
		weapon=this_object();
		if(weapon->query("equipped") ) 
			weapon->unequip();
		reload_object( weapon );
		me->set("jia/value",0);
		return 1;
	}
	message_vision(RED "$N的甲气提升了!\n" NOR, me);
	return 1;
}


int do_hui(object armor)
{	
	string w_name;
	object me,ob;
	me=this_player();
	w_name=me->query("jia/name");
    if( !armor)
		return notify_fail("你要摧毁什么?\n");
	message_vision(HIR "$N大喝一声，一掌擎甲，一掌猛力击下。结果轰隆一声巨响"
			+w_name+HIR"断为两截!\n" NOR,me);
	me->delete("jia");
	me->save();
destruct( this_object() );

	return 1;
}

int do_clean(string arg)
{   
    object me;
    me=this_player();
     if( !arg || arg!="kuangshi")
      return notify_fail("请输入genghuan kuangshi清除?\n");
    message_vision(HIR "$N大喝一声，一掌擎剑，一掌猛力击下。只见"
            +this_object()->name()+HIR+"所镶嵌的金属随着一声巨响哐啷掉在地上!\n" NOR,me);

    me->delete("jia/qie");
    me->delete("jia/damage");
    me->delete("jia/con");
    me->delete("jia/dex");
    me->delete("jia/int");
    me->delete("jia/str");
    me->delete("jia/long");


    
    me->save();
    destruct( this_object() );
    return 1;
}
int do_qie(string arg)
{
    object obj;
    object ob;
    object me;
    me=this_player();

    if(!arg) return notify_fail("你要镶锲什么终极金属进去？\n");

if ( me->query("jia/qie") && me->query("jia/qie")==me->query("jiaqie")+1 ) 
  return notify_fail("这件定做已经镶锲了终极金属了，需要重新镶嵌请先去除原金属(genghuan kuangshi)!\n");

    if( !objectp(obj = present(arg, me)) )
    return notify_fail("你身上并没有这样东西!\n");

    return do_xiang(me, obj);
}

int do_xiang(object me,object obj)
{
    object ob;
    string arg=obj->short(1);
   
    foreach ( ob in all_inventory(me)){
    if (ob->short(1)!=arg) continue;
    if (!ob->query("zhongji_hc")) {
    write("这样东西并不能拿来镶锲!\n");
    return 1;
    }
  
    if ( ob->query("int") )
    me->add("jia/int",ob->query("int"));
  
    if ( ob->query("str") )  
    me->add("jia/str",ob->query("str"));    

    if ( ob->query("dex") ) 
    me->add("jia/dex",ob->query("dex"));
  
    if ( ob->query("con") )
    me->add("jia/con",ob->query("con"));

    if ( ob->query("damage") )
    me->add("jia/damage",ob->query("damage"));
    me->add("jia/qie",1);
    write(HIM"你把"+ob->name()+HIM"这样金属镶锲到自铸防具中!\n"NOR);
    destruct(ob);
     destruct(obj);
    return 1;
    }
}


int do_rename(string arg)
{
    object me;
    me=this_player();
    if( !arg )
        return notify_fail("你改什么的名字?\n");

// 修改抛攻击的Bug  by zmud@TY 
    if( me->query("id") != query("zhuren") )
        return notify_fail("你不是这把自制武器的主人，不能使用该指令!!\n");

    arg = replace_string(arg, "$BLK$", BLK);
    arg = replace_string(arg, "$RED$", RED);
    arg = replace_string(arg, "$GRN$", GRN);
    arg = replace_string(arg, "$YEL$", YEL);
    arg = replace_string(arg, "$BLU$", BLU);
    arg = replace_string(arg, "$MAG$", MAG);
    arg = replace_string(arg, "$CYN$", CYN);
    arg = replace_string(arg, "$WHT$", WHT);
    arg = replace_string(arg, "$HIR$", HIR);
    arg = replace_string(arg, "$HIG$", HIG);
    arg = replace_string(arg, "$HIY$", HIY);
    arg = replace_string(arg, "$HIB$", HIB);
    arg = replace_string(arg, "$HIM$", HIM);
    arg = replace_string(arg, "$HIC$", HIC);
    arg = replace_string(arg, "$HIW$", HIW);
    arg = replace_string(arg, "$NOR$", NOR);
    me->set("jia/name",arg+NOR);
    set("name",arg+NOR);
    write("ok!\n");
    this_object()->create();
    return 1;
}

mixed ob_hit(object me, object victim, int damage)
{
       object weapon,temp;
       int w_lv,w_val,dam;
       int lvl,level,busytime,amount;       
       
       level=victim->query("jia/rate"); //防具材料的等级
       lvl = victim->query("jia/lv");; //盔甲的等级
   

       if( query("equipped") && level)
       {        
        if( level==5 && random(4)>2 && lvl > 150) { 					
        	//减少自身busy 降低多少取决于当时被BUSY的情况 盔甲等级不应小于50
        	if (victim->is_busy()){
			message_vision(HIW"只见$N身上的" + query("name") + HIW"表面晶彩流动，毫光四射！\n"NOR, victim);
        		busytime = victim->query_busy();
        		if (busytime > 5 ) victim->start_busy(busytime-5);
        		else victim->clear_busy(); //直接解除BUSY状态
        		message_vision(HIM"\n$n只觉一股劲力引导着内气游走全身，被阻塞的穴道在它的冲击下已一贯而通！\n"NOR,me, victim);
        	}else{
			message_vision(WHT"$n忽然感到一股奇异的力量围绕着$P，隐隐之间只觉得充斥着莫明的魔力！\n"NOR, me);
        	}        	
         	        
        }
        if( level>3 && random(3)==1 && lvl > 100) {
        	//反弹伤害 要求盔甲等级不能少于100
						message_vision(HIY"\n"+victim->query("name")+"的身体仿佛浮现了一层难以突破的强力护罩，生生将"+me->query("name")+"的攻击震了回去！\n"NOR,me, victim);
            tell_object(me, HIR"\n你发现自己的力道竟然反冲了一些回来！\n"NOR);
            me->receive_wound("qi", (damage - 100)*2 ,me, victim);
            return 1;
        }
        if( level>2) {//降低伤害 盔甲等级不应小于50
        		if( victim->query("neili") * 2 <  me->query("neili") && lvl > 50 ) 
        		{
                message_vision(HIG"\n"+victim->query("name")+"的身体仿佛浮现了一层薄薄的护罩，将"+me->query("name")+"的攻击消除了一些！\n"NOR,me, victim);
	
	              //减少的值为攻击伤害乘以防具等级除以最高的200级，即防具等级与最高等级之比
								damage = (int)(damage * lvl / 200);
								damage =  -damage;
								return damage;
        		}
        		//内力为对方的一半到相等之间，随机出现零伤害
    				if( victim->query("neili") * 2 >  me->query("neili") &&
    					  victim->query("neili") < me->query("neili") && random(3)==1 ) 
        		{
                message_vision(HIM"\n"+victim->query("name")+"的身体仿佛浮现了一层犹若实质的护罩，完全无惧"+me->query("name")+"的伤害！\n"NOR,me, victim);
                return -10000;                
        		} 
        }
      }
       return 1; 
}

//int query_amount() { return amount; }
string query_autoload() { return ""; }
