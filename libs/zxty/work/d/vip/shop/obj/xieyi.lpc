// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "储存柜使用协议" NOR, ({ "xieyi", "he tong", "tong" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一张储存柜使用协议，使用之后可让你拥有储存柜一个月。{use xieyi}\n");
    set("no_put", 1);
    set("no_sell", 1);
    set("ty_gift", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("zjb_money", 500);
    set("unit", "张");
  }
}

void init() {
  add_action("do_eat", "use");
}

int do_eat(string arg) {
  object me;
  string week, month, day, time, year;
  string check;

  if (!id(arg))
    return notify_fail("你要使用什么？\n");

  me = this_player();
  sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
  if (day == "")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);
  check = year + month;
  if (me->query("vipcun/can") == check)
    return notify_fail("你已经拥有储存柜了，不需要再签协议！\n");

  message_vision("$N拿起笔，在" + this_object()->name() +
    "上签下了自己的名字。\n", me);


  tell_object(me, HIG "恭喜你！你获得储存柜当月的使用权限，以本月开始至本月结束。\n");
  me->set("vipcun/can", check);

  destruct(this_object());
  return 1;
}
int query_autoload() {
  return 1;
}
