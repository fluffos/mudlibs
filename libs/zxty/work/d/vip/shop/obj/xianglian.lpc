#include <ansi.h>

#include <armor.h>
#include <mudlib.h>
inherit NECK;

void create()
{
        set_name(HIM "法藤项圈" NOR, ({ "fateng necklace", "necklace" }));
        set("weight", 400);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是传说中的法藤项圈,可增加防御力600,悟性15,下线不掉{kaiguang necklace}。\n");
                set("unit", "串");
              set("zjb_money",300);
		set("no_put",1);
              set("no_sell",1);
              set("ty_gift", 1);
              set("no_get", 1);
              set("no_give", 1);
            set("no_vipcun",1);

              set("no_drop",1); 
                set("material", "gold");
                set("armor_prop/armor", 600);
        set("armor_prop/intelligence", 15);

        }
        setup();
}   
void init()
{
        add_action("do_kai", "kaiguang");
}

int do_kai(string arg)
{
        object me;

        if (! id(arg))
                return notify_fail("你要开光什么？\n");

        me = this_player();
         
        if (me->query("vipshop/xianglian")>1)
                return notify_fail("这件装备你开光过了！\n");

                tell_object(me, HIG "恭喜你！你为你的装备开光好了，现在除了死亡，你的装备下线将不掉落。\n");
                me->set("vipshop/xianglian", 2);

        return 1;
}
int query_autoload() 
 {
         return 1; 
 } 