// tulong-dao.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create() {

  set_name(HIW HIY "屠龙刀" NOR, ({ "tulong dao", "tulong", "dao", "blade" }));
  set_weight(35000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("rigidity", 9);
    set("sharpness", 9);
    set("long", "这是一把浑身发黑的屠龙刀，刀刃间隐隐有血光流动，锋利无匹，
当年江湖中人为此刀，拼得你死我活，是刀中之宝。\n");
    set("zjb_money", 200);
    set("no_drop", "这样东西不能离开你。\n");
    set("no_put", 1);
    set("no_sell", 1);
    set("ty_gift", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("unique", 1);
    set("weapon_prop/dodge", -10);
    set("weapon_prop/parry", 5);
    set("material", "steel");
    set("wield_neili", 500);
    set("wield_maxneili", 1000); ;
    set("wield_str", 25); ;
    set("wield_msg", HIM "只见黑光一闪，$N手中已提着一把黑沉沉的大刀，正是号称“武林至尊”的宝刀屠龙！\n" NOR);
    set("unwield_msg", HIM "黑光忽灭，$n跃入$N怀中。\n" NOR);
    set("treasure", 1);
  }
  init_blade(500);
  setup();
}

int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  message("channel:rumor", HIB "【神兵利器】" + "某人：屠龙刀被" +
    dest->query("name") + "抢到手了！\n" NOR, users());
  return 1;
}
int query_autoload() {
  return 1;
}
