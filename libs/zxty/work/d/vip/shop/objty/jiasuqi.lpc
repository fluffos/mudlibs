#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "闭关加速器" NOR, ({ "jiasu qi", "jiasu", "qi" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("long", "闭关加速器I号，携带在身上，可以加快你闭关的速度，为正常速度的8倍!下线，当机不掉。闭关中halt或者闭关结束消失！\n");
              set("no_put",1);
              set("no_sell",1);
              set("ty_gift", 1);
              set("no_get", 1);
              set("no_give", 1);
            set("tianya_money",40);
             set("unit", "个");      }
}

int query_autoload()
{
        return 1;
}





