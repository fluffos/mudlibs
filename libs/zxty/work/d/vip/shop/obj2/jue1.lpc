inherit ITEM;

void create() {
  set_name(HIB "星空流星石" NOR, ({ "zjb shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("zjb_money", 200);
  set("no_get", 1);
  set("value", 200000);
  set("no_put", 1);
  set("no_give", 1);
  set("zhongji_hc", 1);
  set("int", 35);
  set("str", 25);
  set("dex", 30);
  set("con", 20);
  set("bh", 1);
  set("damage", 250);
  set("long", "这是一个差不多绝种的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
int query_autoload() {
  return 1;
}
