// edit by daniel@jhfy.nh 2002
inherit ROOM;
void create() {
  set("short", "梅林");
  set("long", @LONG
一望无际的梅树,老干横斜,枝叶茂密,想象初春梅花盛开
之日,香雪如梅,定然观赏不尽.但这无边的梅林,到处隐藏着杀
机.一抬头,只见树干上居然吊着干枯的尸体,模样好可怕.还是
早点离开的好.
LONG
  );
  set("exits", ([
    "north": __DIR__ "meilin2",
    "south": __DIR__ "meilin3",
    "east": __DIR__ "meilin3",
    "west": __DIR__ "damen",
  ]));
  setup();
}
void init() {
  if (userp(this_player()))
    call_out("kill_user", 1, this_player());
}
int kill_user(object me) {
  object ob;
  if (!me || environment(me) != this_object()) return 1;
  if (!present("killer", this_object())) {
    ob = new(__DIR__ "npc/killer");
    ob->move(this_object(), 3);
    message("vision", "几个黑影突然向你扑来。\n", this_object());
  }
}
int valid_leave(object me, string dir) {
  object ob;
  ob = present("killer", environment(me));
  if (ob && living(ob))
    return notify_fail("杀手挡住了你的去路。\n");
  else
    return 1;
}
