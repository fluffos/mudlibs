inherit ITEM;
void create()
{
        set_name(HIW"转站礼物"NOR, ({ "zhuanzhan liwu",}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", HIW"小刀发的礼物，你可以eat liwu！\n");
                set("unit", "颗");
                 set("value",0);
                 set("give",1);        
                 set("drop",1);
                 set("ty_gift",1);  
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_tilian", "eat");
}
int do_tilian(string arg)
{
  object me = this_player(); 
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");
         if (me->query("tygift/zz"))
                tell_object(me, "摇那么多次干嘛?。\n");
               else
        {
        message_vision("$N一口吃掉" + this_object()->name() +
                       ",爽!\n", me);

                tell_object(me, HIY "你觉得似乎自己经验增加了1y。\n" NOR);
 tell_object(me, HIM "你觉得似乎自己潜能增加了1000w。\n" NOR);

                  me->add("tygift/zz", 1); 
                me->add("combat_exp", 100000000);
                me->add("potential", 10000000);

                   me->set("tygift/2009", 1);

        destruct(this_object());
        return 1;
}
 }
