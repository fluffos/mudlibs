inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", BYEL + HIW "扬州城总商会" NOR);
  set("long",
    "踏入总商会，你竟被眼前景象吓住，商会装饰虽不及皇
宫的豪华，但也几近奢侈，让你不得不惊叹，扬州果然是商
业旺城。

   [1;33m旅店灯笼，招往来之过客；铺面招牌，揽经商之市贾[2;37;0m


");
  set("no_fight", 1);
  set("exits", ([
    "down": "/d/wizard/fightroom5",
    "up": __DIR__ "shanghui2",

  ]));
  set("objects", ([
    "/d/shop/npc/huangzhen": 1,
  ]));
  setup();
  replace_program(ROOM);
}

void init() {
  object me = this_player();
  tell_object(me, WHT "\n欢迎光临扬州商业街，想知道如何操作"
    "请(" HIC "help trade & help cmdtrade" NOR + WHT ")，祝你"
    "购物愉快。\n\n" NOR);

}
