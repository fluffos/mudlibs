//chutou.c

inherit ITEM;

void create() {
  set_name("铁铲", ({ "tie chan", "chan" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把普通的铁铲，似乎可以用来挖(digging)东西。\n");
    set("value", 100000);
    set("material", "steel");
  }
  setup();
}
