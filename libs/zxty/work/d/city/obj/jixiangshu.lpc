#include <ansi.h>

inherit ITEM;


void create() {
  set_name(HIY "双倍奖励树" NOR, ({ "shu" }));
  set_weight(3000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一棵小树，你可以通过参拜（canbai shu）来获得双倍的任务奖励，每天只有一次噢！\n");
    set("value", 1000);
    set("material", "wood");
    set("no_get", 1);
    //        set("no_drop",1);
    set("amount", 30);
  }
  setup();

}


void init() {
  add_action("do_qu", "canbai");
}


int do_qu(string arg) {
  object me, ob;
  mapping skl;
  string *sname;
  int i, how = 0;
  string week, month, day, time, year;
  string item, from, checkexp;
  me = this_player();
  if (!arg)
    return notify_fail("命令格式： canbai shu\n");

  if (arg != "shu")
    return notify_fail("命令格式： canbai shu\n");

  sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
  if (day == "")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);

  checkexp = year + month + day + "dd";
  if (me->query("weekend_gift") == checkexp)
    return notify_fail("你今天好象已经参拜了耶！\n");
  if (me->query("双倍奖励") > 2000)
    return notify_fail("你还有2000多次双倍奖励没用呢!还是先用了再说吧\n");
  me->set("weekend_gift", checkexp);
  me->add("双倍奖励", 100);
  if (me->query("vip") == 8888)
    me->add("双倍奖励", 400);
  return notify_fail("从现在开始，你的运镖任务奖励翻番，持续100回合！\n");
}
