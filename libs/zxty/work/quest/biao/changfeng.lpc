inherit NPC; 
#include <ansi.h>  
#include "biao.h"

string ask_fangqi();
int ask_yunbiao();
void create()
{
        set_name("长清风", ({ "chang qingfeng", "chang"}));
        set("gender", "男性");
        set("age", 35);
        set("title", HIB"长风镖局总镖头"NOR);
        set("long", "他就是长风镖局总镖头－－长清风。\n");
        set("combat_exp", 30000);
        set("shen_type", 1);
        set("max_neili", 500);
      set("no_get", 100);
        set("neili", 500);
        set("jiali", 10);
        set_skill("force", 40);
        set("per",19);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set("inquiry", ([     
                "运镖" : (: ask_yunbiao :),
            "放弃" : (: ask_fangqi :),
            "fangqi" : (: ask_fangqi :),
                "镖" : (: ask_yunbiao :),
                       ]) );
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage", 15);
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}

string chinese_time(int t)
{
        int d, h, m, s;
        string time;
        s = t % 60;     t /= 60;
        m = t % 60;     t /= 60;
        h = t % 24;     t /= 24;
        d = t;
        if(d) time = chinese_number(d) + "天";
        else time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";    
        time += chinese_number(s) + "秒";
        return time;
}

int ask_yunbiao()
{
    int time;
      int dj,my_combat_exp;
    object me,biaoche;
    mapping biao;

    me=this_player();

dj = me->query("zjb_dj/dj");

    if ( me->query_temp("quest_yunbiao/have_task"))
{
 write(HIW"你上次的镖还没送到呢，怎么又来了？\n"NOR);
return 1;
}

if( dj > 1)
{
if ( dj == 2 ) my_combat_exp=(int)me->query("combat_exp")+10000000; 
if ( dj == 3 ) my_combat_exp=(int)me->query("combat_exp")+30000000; 
if ( dj == 4 ) my_combat_exp=(int)me->query("combat_exp")+60000000; 
if ( dj == 5 ) my_combat_exp=(int)me->query("combat_exp")+100000000;
if ( dj == 6 ) my_combat_exp=(int)me->query("combat_exp")+150000000; 
if ( dj == 7 ) my_combat_exp=(int)me->query("combat_exp")+210000000; 
if ( dj == 8 ) my_combat_exp=(int)me->query("combat_exp")+280000000;
if ( dj == 9 ) my_combat_exp=(int)me->query("combat_exp")+360000000;
if ( dj ==10 ) my_combat_exp=(int)me->query("combat_exp")+450000000;
if ( dj > 10 ) 
my_combat_exp=(int)me->query("combat_exp")+(450000000+((dj-10)*100000000));
}
else {
my_combat_exp = (int)me->query("combat_exp");
}


//    if( me->query("zjb_dj/dj")<4)
   if( 1>2)
{
 write(HIW"运镖可是件危险的差使，还是练好了功夫再来吧！\n"NOR);
return 1;
}
    if( me->query("combat_exp")>500000000 || my_combat_exp<0)
{
 write(HIW"这位老大已经这么厉害了,我这里小小镖局恐怕留不住您！\n"NOR);
return 1;
}
    if( me->query("zjb_dj/dj")>20 || my_combat_exp<0)
{
 write(HIW"这位老大已经这么厉害了,我这里小小镖局恐怕留不住您！\n"NOR);
return 1;
}

    if ( !me->query("env/no_msg") )
    me->set("env/no_msg",1);

    biao=yun_biao[random(sizeof(yun_biao))];
    time=biao["time"];
    me->set("quest_yunbiao/name",biao["name"]); 
    me->set("quest_yunbiao/file",biao["file"]); 
    me->set("quest_yunbiao/bonus",biao["bonus"]);  
    me->set("quest_yunbiao/time",biao["time"]); 
    me->set("quest_yunbiao/start_time",time());
    me->set_temp("quest_yunbiao/have_task",1);

    biaoche=new(__DIR__"biaoche");
    biaoche->set("time",time);
    biaoche->set("file",biao["file"]);      
    biaoche->start_escape_me();
    biaoche->set("owner",me->query("id"));
    biaoche->set("owner_name",me->query("name"));   
    biaoche->move(environment(me));


    me->delete_temp("apply/short");
    me->set_temp("apply/short", 
       ({HIB"长风镖局镖头"NOR+me->name()+"("+me->query("id")+")"})); 

    write(HIW"请在"+chinese_time(time)+"内，将镖车运送到"+biao["name"]+"。\n"NOR);
return 1;
}


string ask_fangqi( )
{       object me;
        int i;
        me = this_player();
        i = me->query("potential");

//          if(me->query_temp("biaobusy")+40 > time())
//         return "你距离上一次放弃不足40秒,请稍后再试?\n";

          if(!me->query_temp("quest_yunbiao/have_task"))
         return "你没有领任务,跑这里瞎嚷嚷什麽?\n";

 if (((int)me->query("potential") - (int)me->query("learned_points"))<500)
      return "你身上的pot不够取消任务了，放弃需要扣除500pot!\n";
        
                if ( i>500){
                command("say 我看错你了，我只能找别人了,扣你500点POT.");
                me->add("potential",-500);
                }
             if (i<=500){command("say 扣掉你所有的qn");
                me->set("potential",0);} 
me->set_temp("quest_yunbiao/have_task",0);
              me->set_temp("biaobusy",time());
                return "没关系,下次继续努力 。";
             
}

void unconcious()
{
        reincarnate();
        set("eff_qi", query("max_qi"));
        set("qi", query("max_qi"));
        set("eff_jing", query("max_jing"));
        set("jing", query("max_jing"));
        set("jingli", query("eff_jingli"));
        say( "星空突然出现在你的面前，说道你怎么可以杀死我的手下呢 ？！\n");
      }

void die()
{
        unconcious();
}

