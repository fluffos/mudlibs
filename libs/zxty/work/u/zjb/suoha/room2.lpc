inherit "/u/zjb/suoha/suoha";

void create() {
  set("short", "梭哈南室");
  set("long", @LONG
这里布置得十分豪华气派，当中一张宽大的玉琢方桌，放着一
副崭新的纸牌。两边是宽大的裘皮木椅。一个精干的伙计站在桌旁
负责发牌。墙上挂着简单的规则(ruler)。
LONG
  );
  set("no_learn", 1);
  set("no_fight", 1);
  set("exits", ([
    "north": "/u/zjb/suoha/room",
  ]));
  set("item_desc", ([
    "pai": (: look_pai :),
    "ruler": "\n　　坐下(sit)开始,不想打了就离开(leave)\n"
    "　　说话方押(ya)，跟话方跟(gen)，不押(buya)就是认输\n"
    "　　最后一牌可以全梭(showhand)，具体请help suoha\n\n",
  ]));

  setup();
}

void init() {
  object me = this_player();
  add_action("buyma", "buyma");
  add_action("do_yazhu", "ya");
  add_action("do_gen", "gen");
  add_action("do_buya", "buya");
  add_action("do_sit", "sit");
  add_action("do_da", "da");
  add_action("do_leave", "leave");
  add_action("do_quansuo", "showhand");
  add_action("check_chouma", "chakan");
  add_action("duihuan", "duihuan");
}

int buyma(string arg) {
  int money;
  object me = this_player();

  if (!arg) return notify_fail("你要拿星空币买多少个筹码!\n");
  else if (!sscanf(arg, "%d", money))
    return notify_fail("buyma <数量>!\n");
  if (money < 1) return notify_fail("至少要买一个筹码!\n");
  if (money > 500) return notify_fail("一次最多只能买500个筹码\n");
  if (me->query("zjb_money", 1) < 1) return notify_fail("你没有这么多星空币来买!\n");
  if (money > me->query("zjb_money", 1)) return notify_fail("你没有这么多星空币来买筹码!\n");

  me->add("zjb_money", -money);
  me->add_temp("duchang_chouma", money);
  return notify_fail(HIB "你取出" + money + "枚星空币，换了筹码，准备" HIR "梭哈" HIB "!\n");
}
int duihuan(string arg) {
  int money;
  object me = this_player();

  if (!arg) return notify_fail("你要拿多少个筹码换成星空币!\n");
  else if (!sscanf(arg, "%d", money))
    return notify_fail("duihuan <数量>!\n");
  if (money < 1) return notify_fail("至少要兑换一个筹码!\n");
  if (me->query_temp("duchang_chouma", 1) < 1)
    return notify_fail("你没有这么多筹码来换\n");
  if (money > me->query_temp("duchang_chouma", 1))
    return notify_fail("你没有这么多筹码来换!\n");
  if (me->query_temp("suoha"))
    return notify_fail("你正在梭哈，换不了钱!\n");


  me->add("zjb_money", money);
  me->add_temp("duchang_chouma", -money);
  return notify_fail(HIG "你取出" + money + "个" HIW "筹码" HIG "，换成了" HIB "星空币" HIG "!\n");
}
