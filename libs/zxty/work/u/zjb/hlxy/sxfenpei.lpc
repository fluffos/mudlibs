// edit by Zjb@HLXY /2003/08/06/

#include <ansi.h>

int help(object me);

int main(object me, string arg) {
  int sx, sx2;
  string str;
  if (!arg) return help(me);
  if (!sscanf(arg, "%s %d", str, sx)) return help(me);

  sx2 = me->query("shuxing");

  if (sx > sx2 || sx < 0)
    return notify_fail("你目前没有那么多的属性分配额!\n");

  if (str == "int" || str == "cps" || str == "str" ||
    str == "con" || str == "spi") {
    me->add("shuxing", -sx);
    me->add("" + str + "", sx);
    write("你把" + sx + "点属性分配点分配到" + str + "上去了!\n");
  } else
    return notify_fail("没有这种属性值!\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :sxfenpei <属性名> <分配点数>

把属性分配点分配到特定的属性上，增加特定的属性值!
目前可分配的<属性名>有 定力<cps> 悟性<int> 体格<str>
                       根骨<con> 灵性<spi>                      
比如我如果要分配给定义5点分配点数那么就使用
sxfenpei cps 5 这个指令来执行!

相关帮助文件：help zhuanshi

                                                       edit by Zjb@HLXY 
                                                           2003--08--06
HELP
  );
  return 1;
}
