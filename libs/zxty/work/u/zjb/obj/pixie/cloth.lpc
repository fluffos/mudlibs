#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create() {
  set_name(HIG "七" HIR "凤" HIW "彩" HIY "衣" NOR, ({ "qifeng caiyi", "caiyi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIG "这就是传说中最能发挥公公们威力的" HIG "七" HIR "凤" HIW "彩" HIY "衣。\n" NOR);
    set("unit", "件");
    set("value", 600);
    set("material", "cloth");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("ty_paimai", 1);
    set("skill/pixie-jian", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/intelligence", 60);
    set("female_only", 1);
  }
  setup();
}
