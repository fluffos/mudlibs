#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"国庆仙女"NOR, ({ "guoqing xiannv", "xiannv" }) );
         set("nickname", HIY"天涯欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是十一礼物使者，向他打听“礼物”，来获得十一奖励。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);
        set("no_suck",1);

        set("inquiry", ([
                         "礼物" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖天涯〗"+HIR+"(ask xiannv about 礼物)\n"+NOR+HIW+"，．"NOR);
                       call_out("greeting", 2);

}

string ask_me()
 {
        object shiyigift;
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("shiyigift"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                if (me->query("zjb_dj/dj")>7)
                {
              shiyigift=new("/u/bzhou/gift/jue4");
                shiyigift->move(this_player()); 
                me->set("shiyigift", 1);
                }
                else 
                 {
                 return "呵呵～礼物是终极矿，你还是过了8级以后再说吧！";
                 }
                return "欢迎光临"NOR+HIR"〖天涯〗"NOR"，巫师组表示非常抱歉。小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！\n"+HIR+"你得到了一块魔睛烛舞铁！！！！！"NOR;
        }
}


