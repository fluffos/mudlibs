#include <mudlib.h>
#include <ansi.h>
inherit ROOM;

void create()
{
        ::create();
      set_short( "凌风的玩具屋" );
        set_long(
             "你所看到的屋子是凌风的玩具屋，这里看起来似乎很乱，大概是\n"
             ""+HIW"波士和创世者"+NOR"经常来捣乱，所以才会...................\n"
             "由于凌风经常不在家，所以这里只有让捣蛋鬼们乱搞了。\n"NOR,
        );
        set( "light",1 );
        set( "exits", ([
    "west" : "u/b/boss/workroom.lpc",
    "north" : "/d/mage/tower/time.lpc",
    "healer" : "/d/healer/building/healer_guild.lpc",
    "knight" : "/d/knight/fortress/knight_guild.lpc",
    "thief" : "/d/thief/hall/thief_guild.lpc",
    "mage" : "/d/mage/tower/mage_guild.lpc",
    "monk" : "/d/monk/guild/monk_guild.lpc",    
    "scholar" : "/d/scholar/scholar/scholar_guild.lpc",

        ]) );
}
