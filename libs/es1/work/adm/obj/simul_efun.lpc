#include "/adm/simul_efun/copy.lpc"
#include "/adm/simul_efun/creator_file.lpc"
#include "/adm/simul_efun/domain_master.lpc"
#include "/adm/simul_efun/dump_variable.lpc"
#include "/adm/simul_efun/emote.lpc"
#include "/adm/simul_efun/exclude_array.lpc"
#include "/adm/simul_efun/existence.lpc"
#include "/adm/simul_efun/extract.lpc"
#include "/adm/simul_efun/find_object_or_load.lpc"
#include "/adm/simul_efun/format_string.lpc"
#include "/adm/simul_efun/format_time.lpc"
#include "/adm/simul_efun/gettype.lpc"
#include "/adm/simul_efun/get_char.lpc"
#include "/adm/simul_efun/identify.lpc"
#include "/adm/simul_efun/idle.lpc"
#include "/adm/simul_efun/index.lpc"
#include "/adm/simul_efun/int_string.lpc"
#include "/adm/simul_efun/log_file.lpc"
#include "/adm/simul_efun/match_string.lpc"
#include "/adm/simul_efun/merge.lpc"
#include "/adm/simul_efun/mkdirs.lpc"
#include "/adm/simul_efun/path_file.lpc"
#include "/adm/simul_efun/pluralize.lpc"
#include "/adm/simul_efun/pronouns.lpc"
#include "/adm/simul_efun/say.lpc"
#include "/adm/simul_efun/shout.lpc"
#include "/adm/simul_efun/slice_array.lpc"
#include "/adm/simul_efun/substr.lpc"
#include "/adm/simul_efun/system.lpc"
#include "/adm/simul_efun/tell_room.lpc"
#include "/adm/simul_efun/tilde_path.lpc"
#include "/adm/simul_efun/uniq_array.lpc"
#include "/adm/simul_efun/unique_mapping.lpc"
#include "/adm/simul_efun/update_file.lpc"
#include "/adm/simul_efun/vt100.lpc"
#include "/adm/simul_efun/wrap.lpc"
#include "/adm/simul_efun/iwrap.lpc"
#include "/adm/simul_efun/getopt.lpc"

// this uses strsrch() which may or may not be a simul_efun, see above.

// Simul_efuns that are called by other simul_efuns.
#include "/adm/simul_efun/base_name.lpc"
// Called by: data get_object overrides
#include "/adm/simul_efun/getoid.lpc"
// Called by: temp_file
#include "/adm/simul_efun/hiddenp.lpc"
// Called by: visible
#include "/adm/simul_efun/member_group.lpc"
// Called by: overrides visible
#include "/adm/simul_efun/tell_object.lpc"
// Called by: overrides tell_group
#include "/adm/simul_efun/user_path.lpc"
// Called by: resolv_path
#include "/adm/simul_efun/write.lpc"
// Called by: data overrides resolv_path tell_group writef

// Simul_efuns that are called by and call other simul_efuns.
#include "/adm/simul_efun/resolv_path.lpc"
// Calls: write user_path Called by: get_object

// Simul_efuns that call other simul_efuns.
#include "/adm/simul_efun/data.lpc"
// Calls: write base_name 
#include "/adm/simul_efun/get_object.lpc"
// Calls: resolv_path base_name
#include "/adm/simul_efun/overrides.lpc"
// Calls: write tell_object member_group base_name
#include "/adm/simul_efun/tell_group.lpc"
// Calls: write tell_object 
#include "/adm/simul_efun/temp_file.lpc"
// Calls: getoid 
#include "/adm/simul_efun/visible.lpc"
// Calls: member_group hiddenp 
#include "/adm/simul_efun/writef.lpc"
// Calls: write 
