varargs void tell_room(mixed room, mixed msg, mixed exclude)
{
	if( stringp(msg) ) {
        if( !room || !objectp(room) ) return;
		// Fix: this driver's message() efun declares its 4th (exclude)
		// argument as "void | object | object *" -- it does not accept
		// a literal int, but an omitted varargs parameter defaults to
		// int 0, not void. Passing that default through unconditionally
		// crashed EVERY 2-argument tell_room() call (dozens of sites
		// across the codebase, including the core death sequence in
		// std/body.lpc's create_ghost()) with "*Bad argument 4 to EFUN
		// message() Expected: object, array, Got: int(0)". Only pass
		// the 4th argument when a real exclude value was given.
		if( exclude )
			message( "tell_room", msg, room, exclude );
		else
			message( "tell_room", msg, room );
		return;
	}
    error("Tell_room: Message must be a string.\n");
}
