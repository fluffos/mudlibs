//#pragma save_binary

/*
// autoload.c: adapted from 2.4.5 code by Truilkan@TMI
// inherited by /std/user.c
//
// This version stores the filenames to be autoloaded in an array
// named auto_load.
// (2-10-92) A potential problem caused by objects using the old
// style query_auto_load() { return 1; } fixed by Buddha
*/
 
#include <uid.h>

 mixed *auto_load;

/*
// load_autoload_obj: clones each object in the auto_load array into
// the player's inventory at login time.  Sends any stored data to
// the init_arg method
*/

void load_autoload_obj()
{
	string file;
	mixed item, argument;
	object ob, *inv;
	int j, k, limit, already;

	// AGENTS.md 7.122 fix: save_data() (std/user/save.lpc) calls
	// compute_autoload_array() -- which bakes each carried autoload
	// item's path into `auto_load` -- immediately before
	// save_object(), so the item is *also* captured as ordinary
	// inventory data by that same save. On the quit path
	// (std/user.lpc's remove()) destroy_autoload_obj() only runs
	// AFTER save_me(), and net_dead() never calls it at all, so a
	// restore can bring the item back twice: once from plain
	// inventory restore, once from this function unconditionally
	// cloning every auto_load entry below. Guard against that by
	// skipping any entry whose base_name already matches something
	// already carried, making this idempotent regardless of how the
	// save file got into a redundant state.
	inv = all_inventory(this_object());

	limit = (auto_load) ? sizeof(auto_load) : 0;
	for( j=0; j<limit; j++ ) {
		item = auto_load[j];
		argument = 0;
		if (stringp(item))
			sscanf(item, "%s:%s", file, argument);
		else if (pointerp(item) && (sizeof(item) == 2)) {
			file = (string)item[0];
			argument = (mixed *)item[1];
		}
		else
			continue;
		if (file) {
			already = 0;
			for( k=0; k<sizeof(inv); k++ ) {
				if (base_name(inv[k]) == base_name(file)) {
					already = 1;
					break;
				}
			}
			if (already) continue;
			if (catch(call_other(file,"?")) || catch(ob=clone_object(file))) {
				ob = 0;
				write("Unable to autoload: " + file + "\n");
			}
			if (ob) {
				if (argument)
					call_other(ob, "init_arg", argument);
				ob->move(this_object());
				inv += ({ ob });
			}
		}
	}
}

/*
   compute_autoload_array: this method is called by ./save.c prior to each
   time the player is saved.
*/

void compute_autoload_array()
{
	object *inv, ob;
	mixed item;
	int j, ok, limit;
   
	auto_load = ({});
	inv = all_inventory(this_object());
	limit = sizeof(inv);
	for( j=0; j<limit; j++ ) {
		ob = inv[j];
		item = (mixed)call_other(ob, "query_auto_load");
		ok = 0;
		if (pointerp(item)) {
			if ((sizeof(item) == 2) && stringp(item[0]))
				ok = 1;
		}
		else if (stringp(item))
			ok = 1;
		if (!ok && item) {
			sscanf(file_name(ob), "%s#%*d", item);
			item += ":";
		}
		if (item)
			auto_load += ({ item });
   }
}

/* destroy_autoload_obj: this is called at logout time */

void destroy_autoload_obj()
{
	object *inv;
	int j, limit;

	inv = all_inventory(this_object());
	limit = sizeof(inv);
	for( j=0; j<limit; j++ )
		if (inv[j]->query_auto_load())
			inv[j]->remove();
}
 
mixed *query_autoload_array()
{
	if(!member_group(geteuid(previous_object()), "admin") &&
		geteuid(previous_object()) != ROOT_UID)  return 0;

	return auto_load;
}
 
