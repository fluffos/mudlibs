// hammer.c

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("子母双环", ({ "ring" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", "这是一副子母双环。\n");
    set("value", 1000);
    set("material", "iron");
    set("wield_msg", "$N两手一分，拿出一副$n，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(15, TWO_HANDED);
  setup();
}
