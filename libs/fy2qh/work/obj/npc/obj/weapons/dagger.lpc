// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit DAGGER;

void create() {
  set_name("订做的", ({ "order" }));
  set_weight(1000);
  set("no_get", 1);
  set("no_drop", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "steel");
    set("owner", "qiqi");
    set("ji_gold", 1);
    set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n藏入怀中。\n");
    init_dagger(30);
    set("long", @LONG
这是一把短小的匕首，看上去不是很锋利。
LONG);
  }
  setup();
}
