inherit NPC;
#include <command.h>
#include <ansi.h>
void create() {
  string *names = ({
    "周抚民", "张安平", "赵国安", "李国泰", "王兴邦",
    "钱定国", "孙爱民", "吴怀远", "郑抚远", "苗平安" });
  set_name(names[random(sizeof(names))], ({ "shou" }));
  set("title", "收藏家");
  set("gender", "男性");
  set("vendetta_mark", "authority");
  set("age", 20 + random(40));
  set("attitude", "peaceful");
  set("long",
    "他以清理风云的垃圾为生．\n
朝廷官派，你最好不要招惹他．\n\n" +
    HIR "杀了他会导致所有官兵的追杀．\n\n" NOR
  );
  set("chat_chance", 90);
  set("chat_msg", ({
    (: random_move :),
    (: call_other, __FILE__, "des_all", this_object() :),
    (: call_other, __FILE__, "follow_user", this_object() :)
  }));
  setup();
  carry_object("/obj/cloth")->wear();

}

int des_all(object ob) {
  object *inv;
  int i;
  inv = all_inventory(environment(ob));
  if (sizeof(inv) <= 0) return 0;
  else
    for (i = 0; i < sizeof(inv); i++)
      if (GET_CMD->do_get(ob, inv[i])) destruct(inv[i]);
  return 1;
}

int follow_user(object ob) {
  object *inv;
  int i;
  inv = all_inventory(environment(ob));
  if (sizeof(inv) <= 0) return 0;
  else
    for (i = 0; i < sizeof(inv); i++)
      if (userp(inv[i])) ob->set_leader(inv[i]);
  return 1;
}
