// heaven_soldier.c

#include <ansi.h>

inherit NPC;

void create() {

  set_name("大内高手", ({ "guard" }));
  set("long", "这是一位大内高手，专门担任保护之责。\n");
  set("attitude", "friendly");

  set("str", 40);
  set("cor", 30);
  set("cps", 25);

  set("chat_chance", 15);
  set("chat_msg_combat", ({
    name() + "喝道：大胆刁民，竟敢和官府作对？\n"
  }));

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object possessed_killer;
  message("vision",
    HIY + name() + "说道：下次报警，哨声为号！\n\n"
    +name() + "嗖的一声就不见了。\n" NOR, environment(),
    this_object());
  possessed_killer = this_object()->query("possessed");
  possessed_killer->add_temp("max_guard", -1);
  destruct(this_object());
}

void invocation(object who, int exp) {
  int i;
  object *enemy;

  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      //			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
      //			else enemy[i]->kill_ob(this_object());
      enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("combat_exp", exp * 2000);
  set_skill("sword", exp / 2);
  set_skill("unarmed", exp / 2);
  set_skill("dodge", exp / 2);
  set_skill("move", exp / 2);
}

void die() {
  object possessed_killer;
  possessed_killer = this_object()->query("possessed");
  possessed_killer->add_temp("max_guard", -1);
  ::die();
}
