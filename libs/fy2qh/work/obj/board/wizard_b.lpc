// wizard_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name("巫师留言板", ({ "board" }));
  // BUG FIX (deep functional test, AGENTS.md §7.18): stale "/d/wiz/"
  // path -- this zone was renamed to "/d/waterfog/" (see
  // d/waterfog/hall1.lpc), and the old path made this board's own
  // setup()/move() throw "call_other() couldn't find object" on load.
  // Ported directly from confirmed sibling fy2 (byte-identical lineage).
  set("location", "/d/waterfog/hall1");
  set("board_id", "wizard_b");
  set("long",
    "这是一个供人留言记事的留言板。\n");
  setup();
  set("capacity", 50);
  replace_program(BULLETIN_BOARD);
}
