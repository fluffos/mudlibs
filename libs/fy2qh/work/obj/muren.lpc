#include <ansi.h>

inherit NPC;

void create() {
  set_name("木人", ({ "muren" }));
  set("long", "这是一个雕刻精细的木人。\n");
  set("max_gin", 400);
  set("max_kee", 500);
  set("max_sen", 400);

  set("str", 10);
  set("cor", 80);
  set("con", 30);

  set_skill("unarmed", 1);
  set_skill("dodge", 1);

  set_temp("apply/attack", 120);
  set_temp("apply/defense", 45);

  setup();
}
