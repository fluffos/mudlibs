// master.c
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("老猫", ({ "master sb", "sb", "master" }));
  set("nickname", "老猫");
  set("gender", "男性");
  set("age", 21);
  set("str", 1000);
  set("cor", 300);
  set("cps", 200);
  set("int", 300);
  set("per", 300);
  set("con", 300);
  set("kar", 300);
  set("max_force", 12000);
  set("force", 12000);
  set("force_factor", 12000);
  set("rank_info/respect", "老猫");
  set("long",
    "老猫是个容貌俊美，风流倜傥的青年人，只看外表，你怎么\n"
    "也猜不到他已是武林至尊了，只见他面如冠玉，一袭青衫更显得潇\n"
    "洒无比，一双似笑非笑的眼睛，突然向你看了一眼，你不禁心\n"
    "中一动。\n");
  create_family("河海剑派", 4, "掌门人");
  set("combat_exp", 2000000);
  set("score", 300000);
  set("chat_chance", 5);
  set("chat_msg", ({
    //	(: exert_function, "recover" :),
    "老猫说道：奔腾一把剑，倚剑笑河海！\n",
    "老猫说道：要什么问我买吧！\n",
    "老猫说道：我最体贴新人了！\n", }));
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("sword", 40);
  set_skill("force", 40);
  //   set_skill("mysterrier",120);
  //  set_skill("hhu-sword", 100);
  //set_skill("literate", 500);
  //	set_skill("wu-shun", 60);
  //set_skill("linbo-steps", 100);
  //map_skill("sword", "hhu-sword");
  //map_skill("force", "wu-shun");
  // map_skill("dodge", "linbo-steps");
  // map_skill("parry","hhu-sword");
  set("inquiry", ([
    "河海": "河海泥巴由我执掌，你有何指教？",
    "拜师": "入我派者，需人品文采，无一不是上上之选。",
    "name": "我便是老猫，快乐逍遥，人生几何。",
    "here": "这里便是河海大学。", ]));
  set("vendor_goods", ([
    //   "/obj/sbaa/mianju",
    //  "冷血剑": "/obj/sbaa/sbsword",
    "/obj/sbaa/buqidan": 200,
    "/obj/sbaa/bujindan": 200,
    "/obj/sbaa/busendan": 200,
    "/obj/sbaa/dahuan": 200,
    // "夺命袍":"/obj/sbaa/sbcloth",   
    // "探测器":"/obj/glass",  
    //  "天魔丹":"/obj/sbaa/tiandan", 
    // "小楼一夜听春雨":"/obj/sbaa/sbblade",   
    "/obj/sbaa/txiang": 50, ]));

  setup();
  carry_object(__DIR__ "sbsword")->wield();
  carry_object(__DIR__ "sbcloth")->wear();


}
void init() {
  ::init();

  add_action("do_vendor_list", "list");
}
