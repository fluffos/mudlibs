// iceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  object *inv;
  int i;
  me->receive_damage("gin", 39);
  me->receive_damage("kee", 39);
  me->receive_damage("sen", 39);
  me->receive_wound("gin", 39);
  me->receive_wound("kee", 39);
  me->receive_wound("sen", 39);

  me->apply_condition("chixue_poison", duration - 1);

  tell_object(me, "你中的" + HIR "赤血蛊" NOR + "发作了。\n" NOR);

  if (duration < 1) return 0;

  return CND_CONTINUE;
}
