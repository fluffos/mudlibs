// hunranyijian.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("浑然一剑只能对战斗中的对手使用。\n");

  if (me->query_skill("sword") < 100) {
    return notify_fail("你剑法等级不够\n");
  }

  msg = HIR "$N眉梢低垂，萧索的望着自己的剑，仿佛天地间再没有他物一般！" NOR;
  me->add_temp("apply/damage", 100);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/damage", -100);
  me->start_busy(2);
  return 1;
}
