// mind_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target) {
  if ((int)me->query("atman") < 50) return notify_fail("你的灵力不够！\n");
  me->add("atman", -50);
  message_vision(HIY "$N使出［神识］，浑身隐隐泛出金光，\n" NOR, me);
  if (random(me->query_skill("essencemagic", 1) / 100)) {
    me->set("eff_sen", me->query("max_sen"));
    me->set("sen", me->query("max_sen"));
  }
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}
