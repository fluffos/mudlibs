// speedup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me) return notify_fail("你只能用浩叹功提升自己的速度。\n");

  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("agiup")) return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");

  me->add("force", -100);
  me->receive_damage("kee", 0);

  message_vision(
    HIR
    "$N的精神越来越集中，整个人的速度开始加快。。。\n" NOR, me);

  me->add_temp("apply/agility", skill / 50);
  me->set_temp("agiup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 50 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/agility", -amount);
  me->delete_temp("agiup");
  tell_object(me, "你的浩叹功运行完毕，将内力收回丹田。\n");
}
