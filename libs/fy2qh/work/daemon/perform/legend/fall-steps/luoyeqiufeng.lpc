// fefawubian.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("落叶秋风只能对战斗中的对手使用。\n");

  if (me->query_skill("fall-steps", 1) < 100) {
    return notify_fail("你秋风步法等级不够\n");
  }

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

  msg = CYN "$N如黄沙枯叶盘旋于秋风之中，步法奇幻，使得$n眼花缭乱，目不暇接，";

  me->start_busy(1);
  if (random(100) > (int)target->query("combat_exp") * 50 / me->query("combat_exp")) {
    msg += "结果$p被$P攻了个措手不及！\n" NOR;
    target->start_busy(3);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
