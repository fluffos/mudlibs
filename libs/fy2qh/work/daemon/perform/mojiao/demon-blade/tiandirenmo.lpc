// tiandirenmo.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("天地人魔连环八式只能对战斗中的对手使用。\n");

  if (me->query_skill("demon-blade", 1) < 100) {
    return notify_fail("你刀法等级不够\n");
  }

  message_vision(HIG "$N神气贯通，将天地人魔连环八式一气呵成！\n" NOR, me);
  me->add_temp("apply/damage", 50);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "万魔初醒！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "魔焰万丈！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "魔光乍现！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "天魔独尊！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "万刃天魔！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "天魔回天！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "天魔七现！" NOR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, RED "万魔归宗！" NOR);
  me->add_temp("apply/damage", -50);
  me->start_busy(5);
  return 1;
}
