string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // UTF8 FIX: str[i] on this driver returns the character's Unicode
  // codepoint (e.g. 0x4e2d for the character meaning "middle"), not a raw GBK byte -- this used
  // to check GBK lead/trail-byte ranges (0xa1-0xfe etc), which silently
  // never matches real Chinese text once strings are UTF-8. Checks the
  // CJK Unified Ideographs block (U+4E00-U+9FFF) instead.
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
