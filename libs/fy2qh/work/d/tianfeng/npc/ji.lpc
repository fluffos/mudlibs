// waiter.c

inherit NPC;
void create() {
  set_name("姬冰雁", ({ "bingyan" }));
  set("gender", "女性");
  set("age", 23);
  set("long",
    "楚留香的死党，很有风度的姬冰雁\n");
  set("combat_exp", 4000000);
  set_skill("celestrike", 100);
  set_skill("dodge", 100);
  set_skill("pyrobat-steps", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  map_skill("dodge", "pyrobat-steps");
  map_skill("unarmed", "celestrike");
  set("max_force", 4000);
  set("force", 4000);
  set("force_factor", 50);

  set("attitude", "heroism");
  set("per", 30);
  setup();
  carry_object(__DIR__ "obj/heicloth2")->wear();
}
