#include <room.h>
inherit ROOM;
void create() {
  set("short", "走廊");
  set("long", @LONG
每隔五步，左右各一门。门上似有记号，门后似有人声。每隔十
步，烛灯一盏，忽明忽暗。凝神细听，又似乎每户空空。走廊弯弯曲
曲，向前伸展，一眼望不到尽头。每当船身随波摇摆，给人旋晕的感
觉。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "zoulang2",
    "west": __DIR__ "zoulang4",
    "south": __DIR__ "chick1",
  ]));
  create_door("south", "紫檀木门", "north", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
