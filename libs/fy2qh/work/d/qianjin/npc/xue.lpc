// teacher.c

inherit NPC;

void create() {
  set_name("湖上雪", ({ "xue" }));
  set("gender", "女性");
  set("age", 18);
  set("per", 30);
  set("title", "湖上八娇");
  set("long",
    "这是千金楼湖上八娇之一．
湖上雪，风急堕还多。
轻片有时敲竹户，素华无韵入澄波，望外玉相磨。
湖水远，天地色相和。
仰面莫思梁苑赋，朝来且听玉人歌，不醉拟如何？
\n");
  set("attitude", "friendly");
  set("combat_exp", 50000);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/xueyu", 1);
  setup();
  carry_object(__DIR__ "obj/xuecloth")->wear();
  add_money("gold", 5);
}

int accept_object(object who, object ob) {
  object obj;
  string name;
  string *apply;
  apply = who->query_temp("apply/name");
  if (sizeof(apply) < 1) return 0;
  name = apply[0];
  if (name != "花满城")
    return 0;
  command("smile");
  command("say 哥哥，我终于见着你了！");
  if (query_temp("apply/xueyu")) {
    obj = new(__DIR__ "obj/xueyu");
    obj->move(who);
    delete_temp("apply/xueyu");
  }
  return 1;
}
