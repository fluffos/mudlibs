// color_cloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("蝉翼纱衣", ({ "shayi", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件薄的近乎透明的纱衣。\n");
    set("unit", "件");
    set("value", 800);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 2);
    set("female_only", 1);
  }
  setup();
}
