// color_cloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("银红散花裙", ({ "silver skirt", "skirt" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这件衣服由于穿在武林第一美人身上而变的珍贵无比。\n");
    set("unit", "件");
    set("value", 8000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 6);
    set("female_only", 1);
  }
  setup();
}
