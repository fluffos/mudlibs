// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("高丽雪蕉", ({ "glxj" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香喷喷的高丽雪蕉。\n");
    set("unit", "盘");
    set("value", 200000);
    set("food_remaining", 1);
    set("food_supply", 30);
  }
}
