// teacher.c
#include <localtime.h>
inherit NPC;

void create() {
  set_name("湖上女", ({ "nu" }));
  set("gender", "女性");
  set("age", 18);
  set("per", 30);
  set("title", "湖上八娇");
  set("long",
    "这是千金楼湖上八娇之一．
湖上女，精选正轻盈。
犹恨乍离金殿侣，相将尽是采莲人，清唱谩频频。
轩内好，嬉戏下龙津。
玉管朱弦闻尽夜，踏青斗草争青春，玉辇从群真。
\n");
  set("attitude", "friendly");
  set("combat_exp", 50000);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/nuyu", 1);
  setup();
  carry_object(__DIR__ "obj/nucloth")->wear();
  add_money("gold", 5);
}

int accept_object(object who, object ob) {
  object obj;
  mixed *local;
  local = localtime(time() * 60 - 890000000);
  command("smile");
  command("say 多谢!");
  if (query_temp("apply/nuyu") && ((local[LT_HOUR] + 1) % 24) / 2 == 0) {
    obj = new(__DIR__ "obj/nuyu");
    obj->move(who);
    delete_temp("apply/nuyu");
  }
  return 1;
}
