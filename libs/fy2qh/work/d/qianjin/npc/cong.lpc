// crazy_dog.c

inherit NPC;

void create() {
  set_name("萤火虫", ({ "cong" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "一只亮晶晶的萤火虫\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 0);

  setup();
}
