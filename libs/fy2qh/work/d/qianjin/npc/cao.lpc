// teacher.c

inherit NPC;

void create() {
  set_name("湖上草", ({ "cao" }));
  set("gender", "女性");
  set("age", 18);
  set("per", 30);
  set("title", "湖上八娇");
  set("long",
    "这是千金楼湖上八娇之一．
湖上草，碧翠浪通津。
修带不为歌舞缓，浓铺堪作醉人茵，无意衬香衾。
晴霁后，颜色一般新。
游子不归生满地，佳人远意正青春，留咏卒难伸。
\n");
  set("attitude", "friendly");
  set("combat_exp", 50000);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/caoyu", 1);
  setup();
  carry_object(__DIR__ "obj/caocloth")->wear();
  add_money("gold", 5);
}

int accept_object(object who, object ob) {
  object obj;
  if ((string)ob->query("name") != "嫩藕") return 0;
  command("smile");
  command("say 多谢!");
  if (query_temp("apply/caoyu")) {
    obj = new(__DIR__ "obj/caoyu");
    obj->move(who);
    delete_temp("apply/caoyu");
  }
  return 1;
}
