// teacher.c

inherit NPC;

void create() {
  set_name("雅公子", ({ "gongzi" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "一个手摇摺扇，自命风流的家伙\n");
  set("attitude", "friendly");
  set("combat_exp", 10000);
  set_skill("dagger", 40);
  set_skill("dodge", 40);
  setup();
  carry_object("/d/fy/npc/obj/fycloth")->wear();
  carry_object(__DIR__ "obj/zheshan")->wield();
}
