// teacher.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("阿飞", ({ "afei" }));
  set("gender", "男性");
  set("age", 25);
  set("per", 30);
  set("str", 30);
  set("title", HIG "情为何物" NOR);
  set("long", "天下无敌－－－阿飞\n");
  set("attitude", "heroism");
  set("combat_exp", 6000000);
  set_skill("sword", 300);
  set_skill("dodge", 300);
  set_skill("move", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sharen-sword", 40);
  map_skill("sword", "sharen-sword");
  map_skill("parry", "sharen-sword");
  set("max_force", 10000);
  set("force", 10000);
  set("force_factor", 50);
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/tiepian")->wield();
}
