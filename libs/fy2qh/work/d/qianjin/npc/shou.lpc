// teacher.c

inherit NPC;

void create() {
  set_name("瘦嫖客", ({ "piaoke" }));
  set("gender", "男性");
  set("age", 34);
  set("long", "这是一位干瘦的大嫖客\n");
  set("attitude", "friendly");
  set("combat_exp", 60000);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("move", 80);
  setup();
  carry_object("/obj/cloth")->wear();
}
