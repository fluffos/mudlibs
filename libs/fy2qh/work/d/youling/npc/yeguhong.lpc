// teacher.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("叶孤鸿", ({ "ye gu hong", "ye" }));
  set("gender", "男性");
  set("age", 22);
  set("title", "武当弟子");
  set("nickname", "小白龙");
  set("long", "苍白的脸，苍白的手，苍白的剑，一身白衣如雪。\n");
  set("attitude", "heroism");
  set("combat_exp", 180000);
  set_skill("sword", 50);
  set_skill("three-sword", 50);
  set_skill("dodge", 50);
  set_skill("move", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("taiji", 50);
  map_skill("sword", "three-sword");
  map_skill("parry", "three-sword");
  map_skill("unarmed", "taiji");
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 10);
  set("fen_number", 1);
  setup();
  carry_object(__DIR__ "obj/baisword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_leave", "leave");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision(HIY "叶孤鸿冷冷的盯着$N道：请这位朋友把孤独美留下。(leave)\n" NOR, ob);
  call_out("do_fenyanzi", 15, ob);
}

void do_fenyanzi(object ob) {
  object fen;
  if (is_fighting()) return;
  if (!query("fen_number")) return;
  message_vision(HIG "茂密的叶间，＂哗啦啦＂一声响，一个人燕子般飞下来\n\n" NOR, ob);
  fen = new(__DIR__ "fenyanzi");
  fen->move(environment(this_object()));
  message_vision(HIG "粉燕子上上下下打量着$N对叶孤鸿说道：这个人是我的，我不许你碰他。
叶孤鸿脸上露出种想呕吐的表情说道：男人女人你都要？
粉燕子笑了笑道：有时候我连你都想要。\n" NOR, ob);
  add("fen_number", -1);
}

int do_leave(string arg) {
  object me, ob, fen;
  if (arg != "gu du mei") return notify_fail("你要留下谁？\n");
  if (!(ob = present("gu du mei", environment(this_object()))))
    return notify_fail("这里没有这个人。\n");
  me = this_player();
  if (!fen = present("fen yan zi", environment(this_object()))) {
    message_vision(HIY "叶孤鸿冷冷的脸上露出一丝笑容道：多谢这位朋友。\n" NOR, me);
    message_vision(HIR "叶孤鸿大声叫道，还我爱妻的命来。\n" NOR, me);
    message_vision(HIY "孤独美惊慌地喊道：你答应帮我的！没我你走不出这片森林！\n" NOR, me);
    this_object()->kill_ob(ob);
    me->set_temp("yeguhong", 1);
  } else {
    message_vision(HIR "粉燕子对叶孤鸿道:叶大少爷，你可已出手了！
叶孤鸿道:好！
叶孤鸿一剑刺入了粉燕子的胸膛！\n" NOR, me);
    fen->die();
    message_vision(HIY "叶孤鸿对$N说道:你们可以走了！\n" NOR, me);
    me->set_temp("yeguhong", 1);
  }
  return 1;
}
