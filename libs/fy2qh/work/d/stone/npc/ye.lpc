// ye.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("叶孤城", ({ "master ye", "master", "ye" }));
  set("nickname", "白云城主");
  set("gender", "男性");
  set("age", 32);
  set("long",
    "白云城主以前充满了尊荣和光采．而现在．．．
他知道那被唐门暗器所伤的伤口已完全溃烂．．．\n");
  set("combat_exp", 10000000);
  set("score", 1000000);

  set("class", "swordsman");

  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 100);

  set("max_kee", 99999999);
  set("eff_kee", 999999);
  set("kee", 999999);

  set("inquiry", ([
    "七彩丝缎带":
    "月圆之夜，紫禁之巅，没有七彩丝缎带的人是进不了紫禁城的。\n",
    "西门吹雪":
    "当今高手，也只有西门吹雪堪称我的对手。\n"
  ]));

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.tianwaifeixian" :),
    (: perform_action, "sword.tianwaifeixian" :),
    (: exert_function, "speedup" :),
  }));

  create_family("白云城", 2, "城主");

  set_skill("dodge", 80);
  set_skill("force", 40);
  set_skill("sword", 100);
  set_skill("literate", 60);
  set_skill("feixian-steps", 100);
  set_skill("feixian-sword", 150);
  set_skill("parry", 120);
  set_skill("changquan", 100);
  set_skill("jingyiforce", 60);
  set_skill("unarmed", 40);
  set_skill("move", 100);

  map_skill("parry", "feixian-sword");
  map_skill("sword", "feixian-sword");
  map_skill("force", "jingyiforce");
  map_skill("unarmed", "changquan");
  map_skill("dodge", "feixian-steps");
  map_skill("move", "feixian-steps");

  setup();

  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/bandage")->wear();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 2, ob);
}

void do_recruit(object ob) {
  command("smile");
  command("say " + ob->query("name") + "在白云城好好学武，将来必将名扬天下。");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "swordsman");
}

void init() {
  add_action("give_quest", "quest");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "白云小剑客");
    return;
  } else if (exp <= 64000) {
    student->set("title", "白云剑客");
    return;
  } else if (exp <= 128000) {
    student->set("title", "白云大剑客");
    return;
  } else if (exp <= 256000) {
    student->set("title", "白云小剑侠");
    return;
  } else if (exp <= 512000) {
    student->set("title", "白云剑侠");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "白云大剑侠");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "白云小剑师");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "白云剑师");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "白云大剑师");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "白云小剑仙");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "白云剑仙");
    return;
  } else
    student->set("title", "白云第一剑");
  return;
}

int accept_object(object who, object ob) {
  object obj;
  if ((string)ob->query("name") != MAG "七彩丝缎带" NOR) return 0;
  command("smile");
  command("say 我有一个老友在兴国寺当方丈，你可以去找他学点防身功夫!");
  who->set_temp("bonze/pig", 1);
  return 1;
}
