inherit ROOM;
void create() {
  set("short", "左偏院");
  set("long", @LONG
院中种满了梅树幼苗。每棵都在茁壮成长，显然有人精心照顾。
梅苗之间还有人工开垦的小河沟，半尺深的渠水绕树而淌，灌溉着每
一棵幼苗。土壤黑而酥松，显然是饱含营养的肥土。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "road7",
  ]));
  set("outdoors", "wanmei");
  setup();
}

void init() {
  add_action("do_chop", "chop");
}

int do_chop(string arg) {
  object ob;
  if (arg != "梅树幼苗") return 0;
  write("你拿起一把柴刀，砍下一株梅树幼苗来。\n");
  ob = new(__DIR__ "obj/youmiao");
  ob->move(this_player());
  return 1;
}
