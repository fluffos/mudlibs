// crazy_dog.c

inherit NPC;

void create() {
  set_name("小猫咪", ({ "catty" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "一只小小的，猫头猫脑的小花猫\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("combat_exp", 500);

  setup();
}
