inherit ROOM;
void create() {
  set("short", "小河流");
  set("long", @LONG
这里是小河流的中央，河流虽浅但水流湍急。水面波涛起伏与日
光辉映，发出鱼鳞般的光芒。几条小鱼偶尔跃出又复落水中，圈圈水
波打破了宁静和谐的溪面。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "road10",
  ]));
  set("objects", ([
    __DIR__ "npc/eyu": 2,
  ]));
  setup();
}

void init() {
  object me;
  if (userp(me = this_player())) {
    remove_call_out("do_swim");
    call_out("do_swim", 5 + random(5));
  }
}

int do_swim() {
  object *inv;
  int i;
  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      inv[i]->move("/d/qianjin/qianjin6");
  }
  return 1;
}
