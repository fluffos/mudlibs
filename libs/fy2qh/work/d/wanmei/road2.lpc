inherit ROOM;
void create() {
  set("short", "梅林之中");
  set("long", @LONG
脚下枯枝断碎，发出吱吱声。枯叶随风飘舞，盘旋落下。偶尔一
两声茑叫，划破宁静。密林深处，似有重重人影晃动。远方一幡白旗
随风翻飞摆动。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "road3",
    "west": __DIR__ "road1",
  ]));
  set("outdoors", "wanmei");
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    remove_call_out("do_fire");
  call_out("do_fire", random(20), ob);
}

int do_fire(object ob) {
  object leaf;
  if (environment(ob) == this_object()) {
    message_vision("一片枯黄的树叶缓缓落下。\n", ob);
    leaf = new(__DIR__ "obj/leaf");
    leaf->move(environment(ob));
  }
  return 1;
}
