inherit ROOM;
void create() {
  set("short", "小木屋");
  set("long", @LONG
木屋只有半边顶，一棵老梅树盖住了那半边。墙上挂着几条浴巾
，阳光透过树枝照在浴巾上。一条竹管从房顶垂下，竹管的尽头塞着
一个木塞子，偶尔还有水珠滴下。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "road5",
  ]));
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg != "up") return notify_fail("你要爬什么？\n");
  else {
    message_vision("$N＂嗖＂的一声，顺着老梅树窜上屋顶。\n", this_player());
    this_player()->move(__DIR__ "muwu");
  }
}
