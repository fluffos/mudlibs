// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("白玉小马桶", ({ "matong" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个白玉小马桶，一看就是上流人用的东西．．\n");
    set("unit", "个");
    set("value", 20);
    set("max_liquid", 15);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "漂着一些东西的水",
    "remaining": 15,
    "drunk_apply": 6,
  ]));
}
