// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("玩具贩子", ({ "wanfan" }));
  set("gender", "男性");
  set("age", 65);
  set("long",
    "一个让孩子们一见就觉得可亲的老翁．\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("rank_info/respect", "老人家");

  set("vendor_goods", ([
    __DIR__ "obj/swindche": 11,
    __DIR__ "obj/bwindche": 22,
    __DIR__ "obj/niren": 22,

  ]));
  setup();
}

void init() {
  add_action("do_vendor_list", "list");
}
