// tufei1.c

inherit NPC;

void create() {
  set_name("单身趟子手", ({ "tang" }));
  set("gender", "男性");
  set("age", 30);
  set("long",
    "这是一位金狮镖局的趟子手。\n");
  set("combat_exp", 50000);

  set("attitude", "peaceful");

  set_skill("unarmed", 90);
  set_skill("dodge", 100);

  set("chat_chance", 5);
  set("chat_msg", ({
    "趟子手低声嘀咕道：那么多镖银只有一个人看守，太不保险了．．\n",
  }));

  setup();
  if (random(5)) carry_object(__DIR__ "obj/huopiao");
  carry_object(__DIR__ "obj/jinzhuang")->wear();

  add_money("silver", 1);
}
