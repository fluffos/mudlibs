// tufei1.c

inherit NPC;

void create() {
  set_name("郭嵩阳", ({ "guo songyang" }));
  set("gender", "男性");
  set("age", 42);
  set("long",
    "郭嵩阳是天下排名第四的高手，但是在水牢里泡的久了，已经失去了战力。\n");
  set("combat_exp", 200000);

  set("attitude", "heroism");

  set("max_force", 3000);
  set("force", 3000);

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/heicloth")->wear();

}
