// waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("薛驼子", ({ "xue" }));
  set("gender", "男性");
  set("title", "薛记包子铺老板");
  set("age", 55);
  set("long",
    "这位陀子正用白多黑少的双眼盯着你\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 30);
  set("vendor_goods", ([
    __DIR__ "obj/caibao": 10,
    __DIR__ "obj/yabao": 10,
    __DIR__ "obj/tangbao": 10,
  ]));
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set("max_force", 500);
  set("force", 500);
  setup();
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      message_vision("$N看了$n一眼道：要买什么包子尽管开口。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N向$n说道：我着可不光卖包子哟！\n", this_object(), ob);
      break;
  }
}

int accept_object(object who, object ob) {
  object obj;
  if (ob->name(1) == "黄金") {
    if (ob->value() >= 10000) {
      command("heihei");
      tell_object(who, "薛驼子递给你一张油油的纸。\n");
      obj = new(__DIR__ "obj/youzhi");
      obj->set("targetprice", ob->value());
      obj->move(who);
      return 1;
    } else {
      command("smile");
      command("say 多谢!");
      return 1;
    }
  } else return 0;
}
