#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("上官金虹", ({ "master shangguan", "master", "shangguan" }));
  set("long",
    "一个人正站在桌子前翻阅着，不时用朱笔在卷宗上勾划，批改，嘴里
偶而会露出一丝得意的笑容。他是站着的。他认为一个人只要坐下来
，就会令自己的精神松弛，一个人的精神若松弛，就容易造成错误。\n");
  set("nickname", BLU "龙凤双环" NOR);
  set("attitude", "heroism");
  create_family("金钱帮", 1, "帮主");
  set("title", "金钱帮帮主");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("agi", 25);
  set("int", 30);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.canglongyixian" :),
  }));
  set("combat_exp", 1000000);
  set("force_factor", 80);
  set_skill("force", 80);
  set_skill("hammer", 150);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("longfenghuan", 150);
  set_skill("jinhong-steps", 120);
  set_skill("jingxing", 120);
  set_skill("move", 70);
  set_skill("literate", 60);

  map_skill("parry", "longfenghuan");
  map_skill("dodge", "jinhong-steps");
  map_skill("move", "jinhong-steps");
  map_skill("force", "jingxing");
  map_skill("hammer", "longfenghuan");
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 30);
  setup();
  carry_object(__DIR__ "obj/xuecloth")->wear();
  carry_object(__DIR__ "obj/longfenghuan")->wield();
}

void attempt_apprentice(object me) {
  if ((me->query("str") * 10 + me->query("max_force")) < 500) {
    command("sigh");
    command("say 看来你还得多加强力量的练习，还是和荆无命多学几年吧。");
  } else {
    command("smile");
    command("say 你的力量已经足够了，我就收你为徒吧。");
    command("recruit " + me->query("id"));
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "fighter");
}

void init() {
  add_action("give_quest", "quest");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");

  if (exp <= 32000) {
    student->set("title", "金钱帮帮众");
    return;
  } else if (exp <= 64000) {
    student->set("title", "金钱帮副堂主");
    return;
  } else if (exp <= 128000) {
    student->set("title", "金钱帮堂主");
    return;
  } else if (exp <= 256000) {
    student->set("title", "金钱帮副坛主");
    return;
  } else if (exp <= 512000) {
    student->set("title", "金钱帮坛主");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "金钱帮副舵主");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "金钱帮舵主");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "金钱帮护法");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "金钱帮大护法");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "金钱帮长老");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "金钱帮大长老");
    return;
  } else
    student->set("title", "金钱帮副帮主");
  return;

}
