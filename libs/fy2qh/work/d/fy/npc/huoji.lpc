// tufei1.c

inherit NPC;

void create() {
  set_name("伙计", ({ "huo ji" }));
  set("gender", "男性");
  set("age", 30);
  set("long",
    "这个伙计正在手忙脚乱的往镖车上装载货物\n");
  set("combat_exp", 1000);

  set("attitude", "peaceful");

  set("chat_chance", 5);
  set("chat_msg", ({
    "伙计窃窃私语：“最近蟑螂越来越多了。”\n",
    "伙计说道：“好几个月没睡好觉了。”\n",
  }));

  set_skill("unarmed", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 3);
  setup();

  carry_object(__DIR__ "obj/jinzhuang")->wear();

  add_money("silver", 1);
}
