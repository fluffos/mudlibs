// teacher.c

inherit NPC;

void create() {
  set_name("考生", ({ "student" }));
  set("gender", "男性");
  set("age", 27);
  set("int", 26);

  set("long",
    "这是一位正在考试的考生。\n");
  set("attitude", "peaceful");

  set("combat_exp", 20000 + random(100) * 500);
  set_skill("unarmed", 20 + random(20));
  set_skill("dodge", 20 + random(20));
  set_skill("move", 20 + random(20));
  set_skill("literate", 50);
  set("max_force", 400);
  set("force", 400);
  set("force_factor", 10);
  setup();
  set("score", 15);
  carry_object(__DIR__ "obj/fycloth")->wear();
}
