// tufei1.c

inherit NPC;
int give_poem();

void create() {
  set_name("风云诗人", ({ "shiren" }));
  set("gender", "男性");
  set("age", 35);
  set("long",
    "一位吟诗作对的风云诗人，正在小山坡上登高远眺，看来必有佳作出笼。\n");
  set("combat_exp", 200000 + random(100) * 4000);

  set("attitude", "friendly");

  set("apply/attack", 20 + random(40));
  set("apply/defense", 20 + random(40));

  set_skill("unarmed", 40);
  set_skill("sword", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("move", 40);

  set("max_force", 1000);
  set("force", 1000);

  set("force_factor", 3);
  set("inquiry", ([
    "诗歌": (: give_poem :),
    "poem": (: give_poem :),
  ]));

  setup();

  carry_object(__DIR__ "obj/fycloth")->wear();
  add_money("silver", 5);

}

int give_poem() {
  object ob;
  command("say 看来你对诗歌颇有兴趣啊，我们可以共同探讨！！ \n");
  write("风云诗人给你一本《风云赞歌》。\n");
  ob = new(__DIR__ "obj/poem");
  ob->move(this_player());
  return 1;
}
