// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create() {
  set_name(HIR "红缨长枪" NOR, ({ "red knife", "knife" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是官府中人专用的武器--红缨长枪。\n");
    set("value", 5000);
    set("material", "steel");
  }
  init_dagger(35);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  // The setup() is required.

  setup();
}
