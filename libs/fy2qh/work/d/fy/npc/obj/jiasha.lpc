// jiasha.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("白领袈裟", ({ "white cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这件白领袈裟洗得很是干净。\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("male_only", 1);
  }
  setup();
}
