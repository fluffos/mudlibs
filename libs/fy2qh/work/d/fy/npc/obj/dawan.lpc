// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("青瓷大碗", ({ "dawan" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大碗饭。\n");
    set("unit", "盘");
    set("value", 2000);
    set("food_remaining", 3);
    set("food_supply", 40);
  }
}
