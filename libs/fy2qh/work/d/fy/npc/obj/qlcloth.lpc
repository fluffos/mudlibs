// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(GRN "浅绿小褂" NOR, ({ "green xiaogua", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 7000);
    set("long", "这是浸龙厅小丫鬟穿的衣服，看上去十分可爱。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
