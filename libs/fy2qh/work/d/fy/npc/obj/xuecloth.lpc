// cloth.c
//
// This is the basic equip for players just login.
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIW "雪白绸衫" NOR, ({ "white silk cloth", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1000);
    set("long", "这是一件雪白的绸衫。\n");
    set("material", "cloth");
    set("armor_prop/armor", 20);
  }
  setup();
}
