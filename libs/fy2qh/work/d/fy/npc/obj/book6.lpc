// book.c

inherit ITEM;

void create() {
  int i;

  string *names = ({
    "轻功入门", "拳法入门", "剑术简介",
    "拆招秘决", "闪躲之术"
  });

  string *skills = ({
    "move", "unarmed", "sword", "parry", "dodge"
  });

  i = random(5);
  set_name(names[i], ({ skills[i] + "book" }));
  set_weight(100);
  set("unit", "本");
  set("value", 70);
  set("long", "这是一本修练基本武功的书籍。\n");
  set("skill", ([
    "name": skills[i],
    "exp_required": 0,
    "sen_cost": 20,
    "difficulty": 20,
    "max_skill": 10
  ]));
}
