// medicine.c

inherit ITEM;

void create() {
  set_name("大风丸", ({ "dafeng wan", "wan" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一颗绿色的丹药，你可以用来(use)治伤 。\n");
    set("unit", "颗");
    set("value", 2000);
  }
}

void init() {
  add_action("apply_medicine", "use");
}

int apply_medicine() {
  int value = 20;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能用药治伤!\n");
  diff = this_player()->query("max_gin") - this_player()->query("eff_gin");
  if (!(diff)) return notify_fail("你没有受伤啊?\n");
  if (value > diff) value = diff;

  message_vision("$N吃下一颗大风丸，精神顿时好多了 .\n", this_player());
  this_player()->add("eff_gin", value);
  destruct(this_object());
  return 1;
}
