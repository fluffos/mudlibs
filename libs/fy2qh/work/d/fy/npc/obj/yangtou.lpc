// dog_m.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("羊头", ({ "yangtou" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "哇! 好香的羊头! 不吃还等什么?\n");
    set("unit", "个");
    set("value", 1000);
    set("food_remaining", 4);
    set("food_supply", 160);
    set("material", "rib");
  }

  setup();
}

int finish_eat() {
  set_name("羊头骨", ({ "yangtou" }));
  set_weight(1000);
  set("long", "啃得精光的羊头骨。\n");
  return 1;
}
