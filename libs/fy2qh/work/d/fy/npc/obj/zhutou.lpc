// dog_m.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("猪头", ({ "zhutou" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "哇! 好香的猪头! 不吃还等什么?\n");
    set("unit", "个");
    set("value", 1000);
    set("food_remaining", 4);
    set("food_supply", 120);
    set("material", "rib");
  }

  setup();
}

int finish_eat() {
  object ob;
  set_name("猪头骨", ({ "zhutou" }));
  set_weight(1000);
  set("long", "啃得精光的猪头骨。\n");
  ob = new("/d/fy/npc/obj/shouqu");
  ob->move(this_player());
  return 1;
}
