// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("风云差服", ({ "chaifu", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是官府专用的服装，你可不要穿着到处招摇。\n");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
