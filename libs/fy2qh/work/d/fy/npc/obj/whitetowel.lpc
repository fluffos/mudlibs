// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("白毛巾", ({ "white towel" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("value", 5000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
