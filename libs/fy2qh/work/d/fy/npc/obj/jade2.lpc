#include <armor.h>

inherit HEAD;

void create() {
  set_name("玉花", ({ "jade" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个翠绿欲滴的玉花\n");
    set("unit", "个");
    set("value", 30000);
    set("armor_prop/armor", 0);
    set("armor_prop/personality", 1);
    set("wear_msg", "$N轻轻地把一朵$n戴在头上。\n");
    set("unwield_msg", "$N轻轻地把$n从头上除了下来。\n");

    set("female_only", 1);

  }
  setup();
}
