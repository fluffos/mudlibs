inherit ROOM;
#include <room.h>
void create() {
  set("short", "走廊");
  set("long", @LONG
一人多高，只容两人并行的檀香木走廊，廊中的两侧陈列着一些
奇花异草。滚滚热气从走廊的一头冒出，将檀木地板打得又湿又滑，
你几乎要扶着栏杆才不会滑倒。
LONG
  );
  set("exits", ([
    "east": __DIR__ "jlong",
    "west": __DIR__ "jlonglang2",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (!random(5)) {
    message_vision("$N不小心滑了一跤, 四脚朝天地摔在地上起不来。\n", me);
    me->unconcious();
  }
  return 1;
}
