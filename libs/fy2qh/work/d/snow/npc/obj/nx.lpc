// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("奶昔", ({ "nx", "naixi" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一杯奶昔。\n");
    set("unit", "个");
    set("value", 20);
    set("max_liquid", 15);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "奶昔",
    "remaining": 15,
    "drunk_apply": 6,
  ]));
}
