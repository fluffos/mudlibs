inherit ROOM;

void create() {
  object con, item;
  set("short", "七彩长廊");
  set("long", @LONG
你的眼前突然一亮，前面出现了一条七彩长廊，两边站着一些美
丽的宫女，神情肃穆的站在那里，四下里鸦雀无声，只有微微的风声
吹过，让你简直想不到这里是水底。
LONG
  );
  set("exits", ([
    "south": __DIR__ "shuimu2",
    "north": __DIR__ "shuimu4",
    "west": __DIR__ "qin",
    "east": __DIR__ "qi",
  ]));
  set("objects", ([
    __DIR__ "npc/gongnu2": 2,
  ]));
  setup();
  replace_program(ROOM);
}
