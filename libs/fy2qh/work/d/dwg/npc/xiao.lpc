// taolord.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("箫王孙", ({ "master xiao", "master", "xiao" }));
  set("title", HIY "黄衣客" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "箫王孙的来历没有任何人知道．．．\n");
  set("combat_exp", 5000000);
  set("score", 200000);

  set("class", "yinshi");

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 30);

  set("inquiry", ([
    "冰心诀":
    "冰心诀乃本谷之独门心法，具有解毒之奇效，千万不可外传。\n",
    "帝王谷":
    "想入我帝王谷？我要试试你的诚意。\n"
  ]));

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "whip.tianleiyiji" :),
    (: perform_action, "dodge.baxianzuijiu" :),
  }));

  create_family("帝王谷", 1, "谷主");

  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("whip", 150);
  set_skill("literate", 100);
  set_skill("zuixian-steps", 100);
  set_skill("thunderwhip", 130);
  set_skill("parry", 100);
  set_skill("flying-dragon", 100);
  set_skill("iceheart", 50);
  set_skill("unarmed", 100);
  set_skill("move", 100);

  map_skill("parry", "thunderwhip");
  map_skill("whip", "thunderwhip");
  map_skill("force", "iceheart");
  map_skill("unarmed", "flying-dragon");
  map_skill("dodge", "zuixian-steps");
  map_skill("move", "zuixian-steps");

  setup();

  carry_object(__DIR__ "obj/silk")->wield();
  carry_object(__DIR__ "obj/robe")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/shoe")->wear();
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 2, ob);
}

void do_recruit(object ob) {
  if (ob->query_temp("marks/xiaowangsun")) {
    command("smile");
    command("say " + ob->query("name") + "在帝王谷好好学武，将来必将名扬天下。");
    command("recruit " + ob->query("id"));
    ob->delete_temp("marks/xiaowangsun");
  } else
    command("say 你心不诚。。。");
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "yinshi");
}

void init() {
  add_action("give_quest", "quest");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "帝王谷家丁");
    return;
  } else if (exp <= 128000) {
    student->set("title", "帝王谷小管家");
    return;
  } else if (exp <= 512000) {
    student->set("title", "帝王谷管家");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "帝王谷大管家");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "帝王谷小总管");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "帝王谷总管");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "帝王谷大总管");
    return;
  } else
    student->set("title", "帝王谷副谷主");
  return;
}
