// mother.c
inherit NPC;

void create() {
  set_name("花大姑", ({ "dagu" }));
  set("gender", "女性");
  set("age", 33);
  set("str", 35);
  set("long", @LONG
她是一个身材高大，修眉目环，宛如巨灵神一般的女子。
LONG
  );
  set("class", "yinshi");
  set("combat_exp", 80000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("move", 40);
  set("attitude", "aggressive");

  setup();

  carry_object("/obj/cloth")->wear();
}
