// mother.c
inherit NPC;

void create() {
  set_name("黄衣人", ({ "yellowman" }));
  set("gender", "男性");
  set("age", 39);
  set("long", @LONG
这是一位身披黄衣的蒙面人
LONG
  );
  set("class", "yinshi");
  set("combat_exp", 100000 + random(100) * 100);
  set_skill("unarmed", 30 + random(30));
  set_skill("dodge", 30 + random(30));
  set_skill("move", 30 + random(30));
  set_skill("flying-dragon", 30 + random(30));
  set_skill("zuixian-steps", 30 + random(30));
  map_skill("dodge", "zuixian-steps");
  map_skill("move", "zuixian-steps");
  map_skill("unarmed", "flying-dragon");
  set("bellicosity", 2000);
  set("attitude", "aggressive");

  setup();

  carry_object("/obj/cloth")->wear();
}
