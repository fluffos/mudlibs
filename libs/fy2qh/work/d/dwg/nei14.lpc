inherit ROOM;

void create() {
  object con, item;
  set("short", "轩堂");
  set("long", @LONG
轩堂中一尘不染，窗明几净，四壁堆满了书架，屋角一张琴几，
琴旁一方棋枰。还有几张未完成的画，散乱地堆在另一角的画桌上。
门上挂著湘妃帘，偷过竹帘，可以看见那一洼盛开的菊花。
LONG
  );
  set("exits", ([
    "north": __DIR__ "nei13",
  ]));
  set("objects", ([
    __DIR__ "obj/desk2": 1,
    __DIR__ "obj/book2": 1,
    __DIR__ "npc/woman": 1,
  ]));
  set("outdoors", "dwg");
  setup();
  con = present("desk", this_object());
  item = present("picture", this_object());
  item->move(con);
}
