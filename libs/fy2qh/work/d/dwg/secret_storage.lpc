inherit ROOM;

void create() {
  object con, item;
  set("short", "黑暗通道");
  set("long", @LONG
这里非常的黑，你什么都看不清楚，偶尔有些风声从你的身边掠
过，让你觉得非常的害怕，突然你看到前面好象有条人影，但是一转
眼间，这条人影就消失了，让你以为是自己的幻觉而已。
LONG
  );
  set("exits", ([
    "north": __DIR__ "shuimu1",
    "leave": __DIR__ "hudi5"
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  if (who->query("id") == "hufa" && dir != "north") return notify_fail("你不能离开这里");
  else return 1;
}
