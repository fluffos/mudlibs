#include <command.h>
inherit ROOM;

void create() {
  set("short", "小湖");
  set("long", @LONG
溪水到这里会成了一个小小的湖泊。四周群山环绕，湖边树木成
阴。小鸟的叽喳声从林间传出。微风吹过，清凉宜人。湖水呈深蓝色
，湖面虽不大，可湖水却深不可测。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dwg9",
  ]));
  set("outdoors", "dwg");

  setup();
}

void init() {
  add_action("do_dive", "dive");
}

int do_dive(string arg) {
  object *inv, me;
  int i, sign = 0;
  me = this_player();
  inv = all_inventory(me);
  if (sizeof(inv) == 0) return 0;
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->query("id") == "luwei") sign = 1;
  if (sign == 0) return 0;
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->query("id") != "luwei")
      DROP_CMD->do_drop(me, inv[i]);
  message_vision("$N脱光了所有衣服，一个猛子扎入湖水中．\n", me);
  me->move(__DIR__ "hudi");
  return 1;
}
