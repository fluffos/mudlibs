// token.c


inherit ITEM;

void create() {
  set_name("雪蛤蟆", ({ "snowfrog" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个能解百毒的雪蛤蟆。\n");
    set("material", "wood");
    set("value", 0);
  }
  setup();
}

void init() {
  add_action("do_use", "cure");
}

int do_use(string arg) {
  object me;
  me = this_player();
  message_vision("$N服下雪蛤蟆，顿时感觉好多了。\n", me);
  me->clear_condition();
  destruct(this_object());
  return 1;
}
