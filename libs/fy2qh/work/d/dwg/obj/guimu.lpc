// token.c


inherit ITEM;

void create() {
  set_name("九子鬼母像", ({ "ghostmother" }));
  set("no_get", 1);
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", @LONG
仔细观察石像，你发现一个伏在九子鬼母背上的婴儿手中，拿著一柄
长约七寸的短剑，剑头指向东面的山窟。
LONG);
    set("material", "wood");
    set("value", 0);
  }
  setup();
}
