// token.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("天香续命露", ({ "potion" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "滴");
    set("long",
      HIW "这是一滴有神奇功效的露水．
可以用来提高身体的极限！\n");
    set("material", "paper");
    set("value", 1000);
  }
  setup();
}

void init() {
  add_action("do_drink", "drink");
}

int do_drink(string arg) {
  object me;
  int ekee, kee;
  if (arg != "potion") return 0;
  me = this_player();
  ekee = me->query("eff_kee");
  kee = me->query("kee");
  ekee += ekee / 10;
  kee += kee / 10;
  me->set("eff_kee", ekee);
  me->set("kee", kee);
  message_vision("$N饮下一滴天香续命露，顿时浑身精力弥漫，看来有所作为。\n", me);
  destruct(this_object());
  return 1;
}
