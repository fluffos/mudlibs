// token.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "忘魂果" NOR, ({ "wangguo" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "这是一颗人们在求生无望，为了减轻死前的痛苦
用来解脱（ｄｉｅ）的毒果．如果你中了剧毒，这果子刚好．\n");
    set("material", "wood");
    set("value", 100);
  }
  setup();
}

void init() {
  add_action("do_die", "die");
}

int do_die() {
  object me;
  me = this_player();
  message_vision("$N吃下一颗忘魂果。\n", me);
  me->unconcious();
  me->clear_condition();
  destruct(this_object());
}
