inherit ROOM;

void create() {
  object con, item;
  set("short", "湖底");
  set("long", @LONG
这里实在很美，很静。泉水清澈冰凉，各式各样的鱼虾在你的面
前悠闲的游来游去，看著水草在砂石间娥娜起舞，这种感觉不是未曾
经历此境的人所能领略得到的。突然，你的眼前出现了一块前所未见
的硕大水晶。
LONG
  );
  set("exits", ([
    "west": __DIR__ "hudi3",
  ]));
  set("item_desc", ([
    "水晶": "一块透明的大水晶，似乎可以转动。\n"
  ]));
  set("outdoors", "dwg");
  setup();
}


void init() {
  add_action("do_move", "rotate");
}

void check_trigger(object me) {
  object room;
  object ob;
  int i;
  if ((int)query("left_trigger") == 2
    && (int)query("right_trigger") == 4
    && !query("exits/down")) {
    message("vision",
      "湖底忽然发出轧轧的声音，水晶缓缓移开，露出一个向下的阶梯。\n",
      this_object());
    if (me->query("gender") == "男性") {
      for (i = 0; i < 3; i++) {
        ob = new(__DIR__ "npc/gongnu");
        ob->move(this_object());
        ob->kill_ob(me);
      }
      me->start(2);
    }
    set("exits/down", __DIR__ "secret_storage");
    if (room = find_object(__DIR__ "secret_storage")) {
      room->set("exits/up", __FILE__);
      message("vision",
        "水晶忽然发出轧轧的声音，露出一个向上的阶梯。\n",
        room);
    }
    delete("left_trigger");
    delete("right_trigger");
    call_out("close_passage", 10);
  }
}

void close_passage() {
  object room;
  object ob;
  while (ob = present("girl", this_object())) {
    write("宫女急急忙忙地离开了。\n");
    destruct(ob);
  }
  if (!query("exits/down")) return;
  message("vision",
    "湖底忽然发出轧轧的声音，水晶缓缓合拢，将向下的通道盖住了。\n",
    this_object());
  if (room = find_object(__DIR__ "secret_storage")) {
    room->delete("exits/up");
    message("vision",
      "水晶忽然发出轧轧的声音，向上的阶梯又缓缓地收了回去。\n",
      room);
  }
  delete("exits/down");
}


int do_move(string arg) {
  string dir;

  if (!arg || arg == "") return 0;

  if (arg == "水晶") {
    write("你试著移动这块水晶，似乎可以转动...\n");
    return 1;
  }
  if (sscanf(arg, "水晶 %s", dir) == 1) {
    if (dir == "right") {

      message_vision("$N将水晶往右转...，忽然「喀」一声水晶又移回原位。\n",
        this_player());
      add("right_trigger", 1);
      check_trigger(this_player());
      return 1;
    } else if (dir == "left") {

      message_vision("$N将水晶往左转...，忽然「喀」一声水晶又移回原位。\n",
        this_player());
      add("left_trigger", 1);
      check_trigger(this_player());
      return 1;
    } else {
      write("你要将水晶转向那个方向？\n");
      return 1;
    }
  }
}


void reset() {
  ::reset();
  delete("left_trigger");
  delete("right_trigger");
}
