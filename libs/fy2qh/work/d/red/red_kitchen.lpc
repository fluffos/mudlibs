// inn.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "飘香厨房");
  set("long", @LONG
这是舵主的用膳房。整个房间飘荡着上等羊肉和橘子的香味.你似乎
听到你的肚子在“咕咕咕”的叫了起来。
LONG
  );

  set("exits", ([
    "north": "/d/red/red_hall",
  ]));

  set("objects", ([
    "/d/red/obj/orange": 2,
    "/d/red/obj/sheep_meet": 1,
  ]));

  setup();

}
