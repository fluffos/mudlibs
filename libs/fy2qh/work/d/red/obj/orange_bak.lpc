// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("橘子", ({ "orange" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一粒又小又酸的橘子。\n");
    set("unit", "粒");
    set("value", 15);
    set("food_remaining", 6);
    set("food_supply", 30);
  }
}
