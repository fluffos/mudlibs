#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "大雄宝殿");
  set("long", @LONG
此殿为正殿，四周偃牙高啄，六龙翔舞，中尊为释迦，端座在长
方形须弥座上。左右有迦叶，阿难两尊者和两菩萨伺立。迦叶居左，
擎拳含笑，阿难居右，合掌而立。两极端前角，各有甲胄护法天王，
两像遥立对峙，各持长剑，嗔目怒视。
LONG
  );
  set("exits", ([
    "south": __DIR__ "xg6",
  ]));
  set("item_desc", ([
    "mark": "这是一个掌印，你可以ｔｏｕｃｈ它。\n"
  ]));
  set("objects", ([
    __DIR__ "obj/tongren": 1,
    __DIR__ "obj/heart": 1,
    __DIR__ "obj/liver": 1,
    __DIR__ "obj/stomach": 1,
    __DIR__ "obj/lung": 1,
    __DIR__ "obj/kidney": 1,
  ]));
  setup();
}

void init() {
  add_action("do_touch", "touch");
}

void close_path() {
  if (!query("exits/north")) return;
  message("vision", "铜人嘎．．嘎．．嘎．．地又移回原位，向北的路口消失了。\n", this_object());
  delete("exits/north");
}

int do_touch(string arg) {
  object me, ob, *inv, copperroom;
  int sign = 0;
  if (!arg || arg == "") return 0;
  if (arg == "mark") {
    me = this_player();
    copperroom = this_object();
    if (me->query("max_force") < 50) sign = 1;
    ob = present("heart", copperroom);
    inv = all_inventory(ob);
    if (sizeof(inv) < 1) sign = 1;
    else if (inv[0]->query("name") != "红色细针") sign = 1;
    ob = present("liver", copperroom);
    inv = all_inventory(ob);
    if (sizeof(inv) < 1) sign = 1;
    else if (inv[0]->query("name") != "绿色细针") sign = 1;
    ob = present("stomach", copperroom);
    inv = all_inventory(ob);
    if (sizeof(inv) < 1) sign = 1;
    else if (inv[0]->query("name") != "黄色细针") sign = 1;
    ob = present("lung", copperroom);
    inv = all_inventory(ob);
    if (sizeof(inv) < 1) sign = 1;
    else if (inv[0]->query("name") != "白色细针") sign = 1;
    ob = present("kidney", copperroom);
    inv = all_inventory(ob);
    if (sizeof(inv) < 1) sign = 1;
    else if (inv[0]->query("name") != "黑色细针") sign = 1;
    if (sign == 0) {
      write(CYN "你气运周天，向铜人的丹田处用力压了下去。\n" NOR);
      if (!query("exits/north")) {
        set("exits/north", "/d/qianfe/cj1");
        call_out("close_path", 2);
        write(HIR "铜人嘎．．嘎．．嘎地移开了。\n" NOR);
      }
      return 1;
    } else {
      write("你试着在铜人的丹田处印了一掌，但是什么都没有发生。\n");
      return 1;
    }
  } else return 0;
}
