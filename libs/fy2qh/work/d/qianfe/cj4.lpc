#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "弥勒殿");
  set("long", @LONG
弥勒佛为五代僧，名契此，体躯肥满，言语无恒，以杖负布袋立
于莲花座上，面现喜悦之相。无著，天亲二菩萨随伺左右。
LONG
  );
  set("exits", ([
    "west": __DIR__ "cj5",
    "east": __DIR__ "cj6",
    "south": __DIR__ "cj1"
  ]));
  setup();
}

void init() {
  add_action("do_smile", "smile");
}

void close_path() {
  if (!query("exits/north")) return;
  tell_room(this_object(), BLU "弥勒佛嘎．．嘎．．嘎．．地又移回原位，向北的路口消失了。\n" NOR);
  delete("exits/north");
}

int do_smile() {
  if (random(this_player()->query_temp("marks/smile")) > 5) {
    write(HIR "弥勒佛嘎．．嘎．．嘎地移开了。\n" NOR);
    if (!query("exits/north")) {
      set("exits/north", __DIR__ "cj7");
      call_out("close_path", 3);
    }
    this_player()->delete_temp("marks/smile");
  } else this_player()->add_temp("marks/smile", 1);
  return 0;
}
