// token.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("浑身布满经络图的铜人", ({ "copperman" }));
  set("no_get", 1);
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", @LONG
这是一个浑身布满经络图的铜人，在铜人的心（ｈｅａｒｔ），肝
（ｌｉｖｅｒ），胃（ｓｔｏｍａｃｈ），肺（ｌｕｎｇ），肾
（ｋｉｄｎｅｙ）的部位各有一小孔，在铜人的丹田之处还有个很深
的掌印（ｍａｒｋ）．
LONG);
    set("material", "copper");
    set("value", 0);
  }
  setup();
}
