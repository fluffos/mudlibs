// spy.c

inherit NPC;

void create() {
  object ob;

  set_name("黑衣人", ({ "figure" }));
  set("gender", "男性");
  set("age", 24);
  set("long",
    "这个男人看起来鬼鬼祟祟的，想必不是什麽好东西。\n");
  set("title", "蒙面客");
  set("combat_exp", 5000);
  set("bellicosity", 2000);
  set_skill("throwing", 80);
  set_skill("unarmed", 20);
  set_skill("sword", 20);
  set_skill("parry", 20);
  set_skill("dodge", 80);
  setup();
  ob = carry_object(__DIR__ "obj/throwing_knife");
  ob->set_amount(30);
  ob->wield();
  carry_object("/obj/dust")->set_amount(30);
  carry_object(__DIR__ "obj/black_suit")->wear();
}


void killed_enemy(object who) {
  command("say 哈哈哈哈哈哈。");
  call_out("dissolve", 1);
}

void dissolve() {
  command("dissolve corpse");
}
