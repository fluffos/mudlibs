// crazy_dog.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIR "雪蹄胭脂马" NOR, ({ "red horse", "horse" }));
  set("race", "野兽");
  set("age", 5);
  set("long", "这是一只蹄宽腿壮，一人多高的千里马\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "hoof" }));

  set("combat_exp", 60000);

  setup();
  carry_object(__DIR__ "obj/maan")->wear();
}
