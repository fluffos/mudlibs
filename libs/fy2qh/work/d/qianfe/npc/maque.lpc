// crazy_dog.c

inherit NPC;

void create() {
  set_name("红嘴小麻雀", ({ "maque" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "这是一只红嘴小麻雀\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "尾巴" }));
  set("verbs", ({ "bite", "claw", "poke" }));

  set("combat_exp", 30000);

  setup();
}
