// jiasha.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("牛皮马鞍", ({ "maan" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块牛皮做的马鞍。\n");
    set("unit", "件");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 30);
  }
  setup();
}
