// hat.c

inherit EQUIP;

void create() {
  set_name("宝冠", ({ "hat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("long",
      "一顶金光闪闪的宝冠。\n");
    set("material", "steel");
    set("armor_type", "head");
    set("armor_prop/armor", 5);
  }
}
