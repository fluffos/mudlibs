// fezhong.c


inherit ITEM;

void create() {
  set_name("铜佛钟", ({ "fezhong" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个绿斑斑的铜佛钟\n");
    set("material", "wood");
    set("value", 1000);
  }
  setup();
}

void init() {
  add_action("do_hit", "hit");
}

int do_hit() {
  message_vision("$N当当当的敲了几下铜佛钟。\n", this_player());
  return 1;
}
