// monk.c

inherit NPC;

void create() {
  set_name("登山者", ({ "climber" }));
  set("gender", "男性");
  set("age", 20 + random(40));
  set("long", @LONG
一个累得不行了的登山者，正在歇脚．
LONG
  );
  set("attitude", "friendly");

  set("combat_exp", 2000);

  set_skill("unarmed", 20);
  set_skill("force", 20);
  set_skill("dodge", 20);
  set_skill("literate", 20);
  set_skill("parry", 20);

  setup();

  carry_object("/obj/cloth")->wear();
}
