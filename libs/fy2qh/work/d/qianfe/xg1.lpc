inherit ROOM;
void create() {
  set("short", "金刚殿");
  set("long", @LONG
两尊力士执金刚杵分立左右。都是面貌雄伟，作忿怒相，头戴宝
冠，上半身赤裸，两脚张开，呈紧张状，左像怒颜张口，以杵作打物
之势，右像忿颜闭口，平托金刚杵，怒目睁视。
LONG
  );
  set("exits", ([
    "south": __DIR__ "road6",
    "north": __DIR__ "xg6",
    "west": __DIR__ "xg3",
    "east": __DIR__ "xg4"
  ]));
  set("objects", ([
    __DIR__ "npc/lishi": 2
  ]));
  setup();
}

void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  if (arg != "lishi") return 0;
  else {
    write("面貌雄伟，作忿怒相，上半身赤裸，两脚张开，呈紧张状．\n");
    return 1;
  }
}
