inherit ROOM;
void create() {
  set("short", "长廊");
  set("long", @LONG
松木的廊栏已被香客和游人摸的发亮，廊脊上塑有九鲤化龙，双
凤朝牡丹的图像，颇据闽南建筑艺术风格。令人怀疑此寺与佛教南宗
一脉相承。
LONG
  );
  set("exits", ([
    "east": __DIR__ "xing2",
    "north": __DIR__ "xing6"
  ]));
  set("objects", ([
    __DIR__ "npc/dashi": 1
  ]));
  setup();
}

void init() {
  add_action("do_push", "push");
}

void close_path() {
  if (!query("exits/south")) return;
  tell_room(this_object(), "长廊前方的暗门又无声无息地合上了。\n");
  delete("exits/south");
}

int do_push(string arg) {
  if (arg != "button") return 0;
  message_vision("$N按了下木键，长廊前方的暗门无声无息地滑开了。\n", this_player());
  if (!query("exits/south")) {
    set("exits/south", __DIR__ "cj11");
    call_out("close_path", 2);
  }
  return 1;
}
