inherit ROOM;
void create() {
  set("short", "唐槐亭");
  set("long", @LONG
山行从此向东开始陡峭，一座凉亭前有一棵大槐树，据称唐将秦
琼曾在此栓马，此树得风气之先长的郁郁葱葱，遮天蔽日。许多登山
者都在此歇脚。
LONG
  );
  set("exits", ([
    "west": __DIR__ "road2",
    "eastup": __DIR__ "road4",
  ]));
  set("objects", ([
    __DIR__ "npc/horse": 1,
    __DIR__ "npc/climber": 2
  ]));
  set("outdoors", "qianfe");
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg != "tree") return notify_fail("你要爬什么？\n");
  else {
    message_vision("$N手脚并用，敏捷地爬上了凉亭前的大槐树。\n", this_player());
    this_player()->move(__DIR__ "huaishu");
  }
}
