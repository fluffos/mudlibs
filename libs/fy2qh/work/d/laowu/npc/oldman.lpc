// mother.c
inherit NPC;

void create() {
  set_name("老山羊", ({ "oldman" }));
  set("gender", "男性");
  set("age", 55);
  set("long", @LONG
一个很老的老屋人
LONG);
  set("combat_exp", 250000);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("move", 80);

  set("attitude", "heroism");

  setup();

  carry_object(__DIR__ "obj/ao")->wear();
  add_money("gold", 1);
}
