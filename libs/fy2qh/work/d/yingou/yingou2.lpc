inherit ROOM;

string look_sign(object);

void create() {
  set("short", "银钩赌坊偏厅");
  set("long", @LONG
四面的墙壁粉刷的象雪洞一样，上面挂满了古今名家的字画。最
大的幅山水，排在正中，却是个无名小卒画的，把云雾凄迷的远山，
画得就象打翻了墨水缸一样。和那些名家的杰作一比，实在是不堪入
目，令人不敢领教。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "yingou1",
  ]));
  set("item_desc", ([
    "picture": "这幅字画似乎可以掀开(open)。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/yufei": 1,
    __DIR__ "npc/ruoshuang": 1,
  ]));
  setup();
}

void init() {
  add_action("do_open", "open");
}

void close_path() {
  if (!query("exits/west")) return;
  message("vision",
    "山水画荡了回来，又遮住了暗门。\n",
    this_object());
  delete("exits/west");
}


int do_open(string arg) {
  object me;
  if (!arg || arg == "") return 0;

  if (arg == "picture" || arg == "字画") {
    write("你拉起墙上的字画，发现了一个暗门。\n");
    if (!query("exits/west")) {
      set("exits/west", __DIR__ "yingou3");
      call_out("close_path", 2);
      return 1;
    }
  } else return notify_fail("你要掀开什么？\n");
}
