// tao_2.c

inherit NPC;

void create() {
  set_name("冷若霜", ({ "leng" }));
  set("gender", "女性");
  set("title", "冰山");
  set("age", 18);
  set("long",
    "这位美人人如其名，给人一种高不可攀，冷若冰霜的感觉．
但她是太有媚力，太令人着迷，你真想和她认识认识（ｋｎｏｗ）\n"
  );
  set("combat_exp", 250000);
  set("score", 20);

  set("int", 30);
  set("str", 30);
  set("per", 30);

  set_skill("unarmed", 50);
  set_skill("dodge", 40);
  set_skill("move", 60);

  set_temp("apply/damage", 30);

  setup();

  carry_object(__DIR__ "obj/jincloth")->wear();
}

void init() {
  add_action("do_know", "know");
}

int do_know(string arg) {
  object ob;
  ob = this_player();
  if (ob->query("gender") != "男性")
    return notify_fail("\n冷若霜向你挤出一丝勉强的笑容，道：
＂好妹妹！你帮不到我．＂\n");
  else {
    if (ob->query("combat_exp") < 100000)
      return notify_fail("冷若霜反反正正打了你几记大耳光，斥骂道：
＂滚开！你这种臭男人我见得多了！看见你都感到恶心！滚！＂\n");
    command("say 方玉飞，你看这个人怎么样。");
    command("say 好兄弟，是你自己送上门来，可不能怪我。\n");
    ob->set("fang/luochapai", 1);
    return 1;
  }
}
