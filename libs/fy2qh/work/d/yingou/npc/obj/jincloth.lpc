// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("金花黄底飞凰袍", ({ "jincloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 40000);
    set("material", "cloth");
    set("armor_prop/armor", 5);
  }
  setup();
}
