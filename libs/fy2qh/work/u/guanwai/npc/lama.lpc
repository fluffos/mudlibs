inherit NPC;

void create() {
  set_name("护寺喇嘛", ({ "lama" }));
  set("gender", "男性");
  set("age", 35);
  set("str", 20);
  set("long", @LONG
一个大招寺的藏僧。
LONG
  );
  set("attitude", "heroism");
  set("score", -20);
  set("combat_exp", 600);
  create_family("大招寺", 24, "弟子");
  set_skill("unarmed", 100);
  set_skill("bloodystrike", random(20) + 50);
  set_skill("force", 40);
  set_skill("staff", 100);
  set_skill("parry", 100);
  set_skill("cloudstaff", random(10) + 30);
  map_skill("unarmed", "bloodystrike");
  set_skill("iron-cloth", 20);
  map_skill("staff", "cloudstaff");
  map_skill("parry", "cloudstaff");
  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :),
  }));

  setup();

  carry_object(__DIR__ "obj/redcloth")->wear();
  if (random(2)) carry_object(__DIR__ "obj/1staff")->wield();
  if (!random(5)) carry_object(__DIR__ "obj/yangbook");
}
