// waterskin.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("异果", ({ "yeeguo" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个芳香扑鼻的异果。\n");
    set("unit", "个");
    set("value", 0);
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (!arg) return 0;
  if (arg != "yeeguo") return 0;
  this_player()->set("eff_gin", this_player()->query("max_gin"));
  this_player()->set("eff_kee", this_player()->query("max_kee"));
  this_player()->set("eff_sen", this_player()->query("max_sen"));
  this_player()->set("gin", this_player()->query("eff_gin"));
  this_player()->set("kee", this_player()->query("eff_kee"));
  this_player()->set("sen", this_player()->query("eff_sen"));
  /*    this_player()->set("str",40);
    this_player()->set("cor",40);
    this_player()->set("int",40);
    this_player()->set("spi",40);
    this_player()->set("cps",40);
    this_player()->set("per",40);
    this_player()->set("con",40);
    this_player()->set("kar",40);
    this_player()->set("agi",40);
    this_player()->set("dur",40);
    this_player()->set("fle",40);
    this_player()->set("tol",40);*/
  return 1;
}
