// bank.c

inherit ROOM;

void init() {
  add_action("do_convert", "convert");
  add_action("do_deposit", "deposit");
  add_action("do_save", "savemoney");
  add_action("do_seek", "seekmoney");
  add_action("do_get", "getmoney");
}

int do_seek() {
  int amount, i, j;
  object me;
  string msg;

  me = this_player();

  if (!(amount = me->query("save_in_bank"))) {
    write("你没有存钱\n");
    return 1;
  }
  i = amount / 100;
  j = amount % 100;

  msg = "你存有";

  if (i > 0) {
    msg = msg + i + "两银子";
  }
  if (j > 0) {
    msg = msg + j + "文钱";
  }
  msg = msg + "\n";
  write(msg);
  return 1;
}

int do_save(string arg) {
  string from;
  int amount, num, base;
  object money;

  if (!arg || sscanf(arg, "%d %s", amount, from) != 2)
    return notify_fail("指令格式：savemoney <数量> <货币种类> \n");

  money = present(from + "_money", this_player());

  if (!money)
    return notify_fail("你身上没有这种货币。\n");

  if ((int)money->query_amount() < amount)
    return notify_fail("你身上没有那麽多" + money->query("name") + "。\n");

  if (amount < 1) {
    return notify_fail("数量大于1\n");
  }
  num = money->query("base_value");
  if (!num)
    return notify_fail("这种东西不值钱。\n");

  base = this_player()->query("save_in_bank");
  if ((num >= 100000) || (base + num * amount > 50000)) {
    return notify_fail("存不了那么多钱\n");
  }
  if (base == 0) {
    this_player()->set("save_in_bank", num * amount);
  } else {
    this_player()->add("save_in_bank", num * amount);
  }
  money->add_amount(-1 * amount);
  return 1;
}

int do_get(string arg) {
  string from;
  int amount, num, base;
  object money;

  if (!arg || sscanf(arg, "%d %s", amount, from) != 2)
    return notify_fail("指令格式：getmoney <数量> <货币种类> \n");

  if (amount < 1) {
    return notify_fail("数量大于1\n");
  }
  money = present(from + "_money", this_player());

  if (money) {
    num = money->query("base_value");
  } else {
    num = call_other("/obj/money/" + from, "query", "base_value");
  }
  base = this_player()->query("save_in_bank");
  if (num * amount > base) {
    return notify_fail("没有存那么多钱\n");
  }
  if (!money) {
    money = new("/obj/money/" + from);
    money->move(this_player());
    money->set_amount(amount);
  } else {
    money->add_amount(amount);
  }
  this_player()->set("save_in_bank", base - num * amount);
  return 1;
}


int do_convert(string arg) {
  string from, to;
  int amount, bv1, bv2;
  object from_ob, to_ob;

  if (!arg || sscanf(arg, "%d %s to %s", amount, from, to) != 3)
    return notify_fail("指令格式：convert <数量> <货币种类> to <货币种类>\n");

  from_ob = present(from + "_money", this_player());
  to_ob = present(to + "_money", this_player());
  if (!to_ob && file_size("/obj/money/" + to + ".lpc") < 0)
    return notify_fail("你想兑换哪一种钱？\n");

  if (!from_ob) return notify_fail("你身上没有这种货币。\n");
  if (amount < 1) return notify_fail("兑换货币一次至少要兑换一个。\n");

  if ((int)from_ob->query_amount() < amount)
    return notify_fail("你身上没有那麽多" + from_ob->query("name") + "。\n");

  bv1 = from_ob->query("base_value");
  if (!bv1) return notify_fail("这种东西不值钱。\n");

  bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to, "query", "base_value");

  if (bv1 < bv2) amount -= amount % (bv2 / bv1);
  if (amount == 0) return notify_fail("这些" + from_ob->query("name") + "的价值太低了，换不起。\n");

  if (!to_ob) {
    to_ob = new("/obj/money/" + to);
    to_ob->move(this_player());
    to_ob->set_amount(amount * bv1 / bv2);
  } else
    to_ob->add_amount(amount * bv1 / bv2);

  message_vision(sprintf("$N从身上取出%s%s%s，换成%s%s%s。\n",
    chinese_number(amount), from_ob->query("base_unit"), from_ob->query("name"),
    chinese_number(amount * bv1 / bv2), to_ob->query("base_unit"), to_ob->query("name")),
    this_player());

  from_ob->add_amount(-amount);

  return 1;
}


int do_deposit(string arg) {}
