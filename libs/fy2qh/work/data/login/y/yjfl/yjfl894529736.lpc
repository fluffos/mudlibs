// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit STAFF;

void create() {
  set_name("[30m天魔杖[2;37;0m", ({ "tianstaff" }));
  set_weight(10000);
  set("no_get", 1);
  set("no_drop", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("material", "steel");
    set("owner", "yjfl");
    set("ji_gold", 1024);
    set("wield_msg", "$N把$n紧紧地握在手中。\n");
    set("unwield_msg", "$N松开了手中的$n。\n");
    init_staff(165);
    set("long", @LONG
这是一根相当普通的禅杖，看起来十分沉重。
LONG);
  }
  setup();
}
