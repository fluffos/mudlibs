// song.c

#include <ansi.h>

inherit F_CLEAN_UP;

void done_song(object me, object ob, string arg2, string arg3, string text) {
  ob->add_song(arg2, me, arg3, text);
  tell_object(me, "题歌完毕。\n");
  return;
}

int main(object me, string arg) {
  object sing;
  int i;
  string *song;
  string arg1, arg2, arg3, arg4;
  if (!(sing = present("sing menu", me))) return notify_fail("你没有点唱金榜，不能点歌。\n");
  if (!arg) return notify_fail("你要用点唱金榜做什么。\n");
  if (arg == "list") {
    song = sing->query_top();
    for (i = 0; i < sizeof(song); i++) {
      write(song[i]);
      write("\n");
    }
    return 1;
  }
  if (sscanf(arg, "%s %s", arg1, arg2) == 2) {
    if (arg1 == "delete") {
      sing->delete_song(arg2, me);
      return 1;
    }
  }
  if (sscanf(arg, "%s %s %s", arg1, arg2, arg3) == 3) {
    if (arg1 == "add") {
      me->edit((: done_song, me, sing, arg2, arg3 :));
      return 1;
    }
  }
  sing->play(arg, me);
  return 1;
}

int help(object me) {
  write(@HELP
提供功能：
song list           列出现有的歌
song 歌名           点唱该歌曲    
song delete 歌名    删除自己写的歌
song add 歌名 原唱  增加新歌
HELP);
  return 1;
}
