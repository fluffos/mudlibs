#include <inetd.h>
#include <daemons.h>

void udp_locate(mapping data) {
  mapping ret;
  object ob;
  
  ret = ([
	  I2H_REQUEST: I2R_REPLY,
	  I2H_RECIPIENT: data[I2H_SENDER],
	  I2H_ID: data[I2H_ID],
	  I2H_USER: data[I2H_USER],
	  I2H_VERBOSE: data[I2H_VERBOSE],
	  ]);
  
  if ( data[I2H_DATA] && 
       (ob = find_player(data[I2H_DATA])) &&
       interactive(ob) && 
       !ob->QueryInvis() ) {
    ret[I2H_FOUND] = 1;
    ret[I2H_DATA] = "locate@" + LOCAL_NAME + ": " + ob->Short() + "\n";
  }
  else
    ret[I2H_DATA] = 
      "locate@" + LOCAL_NAME + ": No such player: " + data[I2H_DATA] + "\n";
  INET_D->send_udp(data[I2H_NAME], ret);
}

create() {
  seteuid(getuid());
}
