#include <properties.h>
#include <msgclass.h>

void send_to_user(string type, string mudname, string username,
		  mixed * message);
void return_error(string mudname, string username,
		  string errcode, string errmsg);
string canon_mudname(string mudname);

nomask void do_emoteto(string mudname, string username, string message) {
  if( strstr(message, "$N") == -1)
    message = "$N " + message;
    
  if(message[<1] == '\n')
    message = message[0..<2];
  
  send_to_user("emoteto", canon_mudname(mudname), lower_case(username),
	       ({ capitalize(this_player()->Query( P_REALNAME ) ), message }));
}

nosave nomask void rcv_emoteto(string orig_mud, string orig_user,
			    string targ_user, mixed * message) {
  object p;

  p = find_player(targ_user);
  if ( !p ) {
    return_error(orig_mud, orig_user, "unk-user",
		 sprintf("'%s' is unknown", targ_user));
  }
  else {
    string user;

    user = sprintf("%s@%s", message[0], orig_mud);
    msg_object(p, CMSG_GENERIC,
	       sprintf("*%s\n",
		       implode( explode( message[1], "$N" ), user ) ) );
  
    /* TODO: good idea, stores last intermud sender in player object, do that
       p->set_reply(message[0] + "@" + orig_mud);
    */
  }
}
