/* TODO: Locate needs to handle editing, time handling of reply is bad */

#include <properties.h>
#include <inet3.h>
#include <msgclass.h>

void send_to_all(string type, mixed * message);
void send_to_user(string type, string mudname, string username,
		  mixed * message);
void return_error(string mudname, string username,
		  string errcode, string errmsg);

nomask void do_locate(string username) {
  send_to_all("locate-req", ({ lower_case(username) }));
}

nosave nomask void rcv_locate_req(string orig_mud, string orig_user,
				  string targ_user, mixed * message) {
  object p;

  p = find_player(message[0]);
  if ( p ) {
    int idle;
    
    idle = query_idle( p );

    send_to_user("locate-reply", orig_mud, orig_user,
		     ({ LOCAL_NAME, capitalize(p->Query(P_REALNAME)), idle, 0 }));
  }
}

nosave nomask void rcv_locate_reply(string orig_mud, string orig_user,
				    string targ_user, mixed * message) {
  object p;

  p = find_player(targ_user);
  if ( !p ) {
    return_error(orig_mud, orig_user, "unk-user",
		 sprintf("Returned locate-reply to unknown user '%s'",
			 targ_user));
  }
  else {
    string msg;

    msg = sprintf("[locate] %s has been found on %s",
		  message[1], message[0]);
    if ( message[3] )
      msg += sprintf(" (idle: %d secs, status is: %s)",
		     message[2], message[3]);
    else
      msg += sprintf(" (idle: %d secs)", message[2] );
    
    msg_object( p, CMSG_GENERIC, msg + ".\n" );
  }
}
