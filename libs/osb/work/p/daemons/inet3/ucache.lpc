#include <properties.h>
#include <msgclass.h>

/*
** The (remote) user cache.  It maps mudnames to mappings of usernames to
** user information.
*/

nosave private mapping ucache = ([ ]);

nosave nomask void add_cache_entry(string mudname, string username,
				   string visname, int gender) {
  mixed * user;

  if ( !ucache[mudname] )
    ucache[mudname] = ([ ]);

  user = ({ visname, gender });

  ucache[mudname][username] = user;
}

nosave nomask void rcv_ucache_update(string orig_mud, string orig_user,
				     string target_user, mixed * message) {
    int gender;

    gender = (message[2] + 2) % 3;	/* I3 -> OSB */

    add_cache_entry(orig_mud, message[0], message[1], gender);
}

nomask string get_visname(string mudname, string username) {
  mixed * user;

  if ( !ucache[mudname] )
    return 0;

  user = ucache[mudname][username];
  if ( !user )
    return 0;

  return user[0];
}

nomask int get_gender(string mudname, string username) {
  mixed * user;

  if ( !ucache[mudname] )
    return -1;

  user = ucache[mudname][username];
  if ( !user )
    return -1;

  return user[1];
}
