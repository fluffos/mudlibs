/* Contains the selling functions */

init()
{
  string uid;

  if((uid = getuid(this_player())) == QueryOwner() ||
     "/secure/master"->valid_write(object_name(),uid,"sell",this_player()))
    add_action("sell","sell");
}

sell(string str)
{
  if(!str) {
    notify_fail("What do you want to sell?\n");
    return 0;
  }
  if(str != "house" && str != "here") {
    notify_fail("Go to the next shop to sell that there.\n");
    return 0;
  }
  write("Are you sure you want to sell your house? (y/n) ");
  input_to("sell2");
  return 1;
}

nosave sell2(string str)
{
  object seller;

  if(str != "y" && str != "yes") {
    write("You didn't sell your home.\n");
    return;
  }
  seller = load_object("/p/houses/common/room/seller");
  export_uid(seller);
  if(!seller->sell())
    write("Something strange happended. You couldn't sell your house.\n\
Ask Sique to help you!\n");
  return;
}

QueryOwner() { return; }
