/* an object to banish playernames, to avoid conflicts with monsters */
/* we need this separate object to avoid problems with uids */

#include <secure/wizlevels.h>
#include <secure/config.h>

#define ME this_object()
#define PL this_player()
#define TI this_interactive()

/* Variables of the secure save file */
string name;
string password;
int level;
string *domains;
string shell;
string banished_by;
string reason;
int promotion_age;

banish(who,why,really) {
  if (!IS_WIZARD(TI)) return 0;
  if (!who) { write("Who ?\n");	return 1; }
  if (!"/secure/login"->valid_name(who)) return 1;
  seteuid(getuid(ME));
  if (restore_object("secure/save/"+who[0..0]+"/" + who)) {
    if (!IS_WIZARD(TI) || !really) {
      write("That name is already used.\n");
      return 1;
    }
    write("WARNING: That name is already in use by a player!\n");
  }
  if (restore_object("secure/banish/" + who)) {
    write("That name is already banished.\n");
    return 1;
  }
  log_file("BANISH", who+" by "+TI->QueryRealName()+" because "+why+"\n");
  banished_by = TI->QueryRealName();
  reason = why;
  save_object("secure/banish/" + who);
  write("OK.\n");
  return 1;
}

conserve(who,why) {
  if (!IS_WIZARD(TI)) return 0;
  if (!who) { write("Who ?\n");	return 1; }
  if (!"/secure/login"->valid_name(who)) return 1;
  seteuid(getuid(ME));
  if (!restore_object("save/"+who[0..0]+"/" + who)) {
    write("That name is not used.\n");
    return 1;
  }
  if (file_size("secure/mummy/" + who) != -1
      || file_size("secure/mummy/"+who+".o") != -1
     ) {
    write("That name is already conserved.\n");
    return 1;
  }
  log_file("MUMMY", who+" by "+TI->QueryRealName()+" because "+why+"\n");
  banished_by = TI->QueryRealName();
  reason = why;
  save_object("secure/mummy/" + who);
  write("OK.\n");
  return 1;
}

