inherit "std/room";
#include <rooms.h>;
#include <properties.h>;
#include <moving.h>;
int i;
object who,roo;

create(arg) {
 ::create(arg);
 SetIntShort("In a gloomy cave");
 SetIntLong(
 "This is a gloomy cave, where the cave-sprite lives.\n");
 SetIndoors(1);
 SetIntLight(0);
}

init() {
  ::init();
  call_out("dead",5);
}

dead() {
  int died;
  write(
"You are in the gloomy cave of the cave-sprite. The cave-sprite stares at U.\n");
  died = this_player()->QueryAttribute("died");
  switch (died) {
     case 0: write(
"The cave-sprite says: 'Oh dear, you seem to have gotten yourself killed.\n"
"I might be able to help you out, but I've never really done this before.\n"
"Do you want to try to reincarnate you? All right! But don't blame me if\n"
"something goes wr...'\n"
"  --- poof!! ---\n"
"You are engulfed in a cloud of orange smoke. Coughing and gasping, you \n"
"emerge from the smoke and find ...\n"); break;
     case 1: write(
"The cave-sprite says: 'Tsk,tsk - you did it agian! Remember - you're only\n"+
this_player()->QueryRace()+" and you don't have as many lives as a cat (at least, I don't\n"
"think so ...)! That's twice you've ended up dead - want to try for three?\n"
"As you whish! Hang on for just a second while I fire up my thurible...'\n"
" --- foof! ---\n"
"An immense cloud of orange smoke fills the air. As it clears, you find that\n"
"once again you ...\n"); break;
     case 2: write(
"The cave-sprite says: 'You clumsy oaf, you've done it again! I don't know\n"
"how long I can keep this up. Do you want me to try reincarnating you again?\n"
"Okay, where did I put my orange smoke? ...'\n"
"  > poof! < \n"
"Everything disappears in a dense cloud of orange smoke ...\n"); break;
    default: write(
"The cave-sprite says: 'Now you've rally done it! I'm out of orange smoke!\n"
"You don't expect me to do a decent reincarnation without any orange smoke,\n"
"do you? Yes ... well, that's the kind of blinkered, Philistine pig-ignorance\n"
"that I've come to expect from you mortals. You sit there on your loathsome,\n"
"spotty behind, squeezing blackheads and not careing a thinker's damn about\n"
"the struugling cave-sprite, you simpering, whining, moudly-faced heap of\n"
"parrot droppings! If you're so smart, then you can reincarnate yourself, \n"
"because quite frankly I'm as mad as hell and I'm not going to take this\n"
"anymore - I'm leaving!!!!'\n"
"The enraged cave-sprite drops a thurible and disappears. For a moment you\n"
"don't know what to do. Then you take the thurible and fire it by yourself.\n"
"There is no >poof!< or >foof!< and no cloud of orange smoke, as you appear\n"
"at a place that seems familiar to you ...\n");
   }
   this_player()->SetAttribute("died", died+1);
   this_player()->Set(P_HP,5);
   call_out("back",5);
   return 1;
}

back() {
  who->move(roo, M_GO);
}

died(pl) {
  tell_object(pl,"You die!\n");
  roo=environment(pl);
  who=pl;
  pl->reduce_hit_point(200,0);
  pl->move(this_object(), M_TELEPORT);
}
