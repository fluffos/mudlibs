/*
 * Fallback void room for OSB Strategy A (LDMud -> FluffOS).
 */

string query_short() { return "The Void"; }

string query_long() { return "You float in a featureless void.\n"; }

string query_exit(string dir) {
  if (dir == "out" || dir == "east" || dir == "e")
    return "/d/silvere/rooms/harbour/quay1_2";
  return 0;
}

string query_exit_string() { return "The only obvious exit is out.\n"; }
