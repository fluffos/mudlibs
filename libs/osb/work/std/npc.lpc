/*
 * commands are inherited!! 
 */

inherit "std/room/items";
inherit "std/living/chat";
inherit "std/living/description";
inherit "std/living/heart";
inherit "std/living/attributes";
inherit "std/living/moving";
inherit "std/living/restrictions";
inherit "std/living/combat";
inherit "std/living/commands";
inherit "std/npc/body";
inherit "std/npc/cmds";
inherit "std/npc/putget";
//inherit "std/npc/skills"; // Softbye 19nov97
inherit "/std/living/stats"; // Softbye 19nov97

inherit "std/npc/view";
inherit "std/base";

#include <config.h>
#include <properties.h>
#include <ansi.h>
#include <secure/wizlevels.h>
#include <combat.h>
#include <classes.h>
#include <living.h>

#define ME this_object()

public varargs int SetStandard(mixed level, string race, string name)
{
  int base_xp, i;
  mixed *hands;
  
  if (pointerp(level))
    return apply(#'SetStandard,level);
  SetName(name||QueryName()||"Nobody");
  if (!QueryLong() || !QueryRace())
    RACEMASTER->InitRace(ME,race||QueryRace()||"human");
  SetRace(race||QueryRace()||"human"); 
  // SetRace is done in InitRace, too but not for non-player-races so
  // it needs to be called once again to ensure that the race
  // got set.
  base_xp = RACEMASTER->XPfromLevel(level);
  SetXP(base_xp + random(RACEMASTER->XPfromLevel(level+1)-base_xp));
  SetStr(2*level);
  SetDex(2*level);
  SetInt(2*level);
  SetCon(2*level);
  SetCha(2*level);
  SetWis(2*level);
  SetAgi(2*level);
  SetQui(2*level);
  ::SetLevel(level);
  CalculateSemiStats(0);
  SetHP(QueryMaxHP());
  SetSP(QueryMaxSP());
  SetPEP(QueryMaxPEP());
  SetMEP(QueryMaxMEP());
  SetDrink(QueryMaxDrink());
  SetFood(QueryMaxFood());
  SetAlcohol(0);

#if 0
  hands = QueryHands();
  SetHands(0);
  for (i=sizeof(hands)+1; --i; )
    AddHand(hands[<i][HAND_SHORT], hands[<i][HAND_WEAPON],
            (level>20)?20+(level-20)/2:level);
#endif

  return QueryLevel();
}

#if 0 /* Gone gone gone */
/* the plushy frontend - set all Stats and things according to level l */
SetLevel(l) {
  int base_xp, xp;
  base_xp = RACEMASTER->XPfromLevel(l);
  xp = SetXP(base_xp + random(RACEMASTER->XPfromLevel(l+1)-base_xp));
  if (xp < 70) SetXP(70); // Die() divides by 2*35
  SetStr(l);
  SetDex(l);
  SetInt(l);
  SetCon(l);
  // New stats by softbyte 19nov97
  SetCha(l);
  SetWis(l);
  SetAgi(l);
  SetQui(l);
  ::SetLevel(l);
  CalculateSemiStats(0);
  SetHP(QueryMaxHP());
  SetSP(QueryMaxSP());
  SetPEP(QueryMaxPEP());
  SetMEP(QueryMaxMEP());

  SetAC(l/4); /* compat to 2.4.5. lib - Pepel */
}
#endif

create() {
  base::create();
  heart::create();
  SetIds(({}));
  
  /* dont mess with the blueprint too much */
  if (sizeof(explode(object_name(ME), "#")) != 2) return 1;

  body::create();
  combat::create();
  restrictions::create();

  AddClassId(C_LIVING);

  Set(P_HELP_MSG, "");
    
#if 0
  SetName("Nobody");
  SetRace("human");
  SetLong(0);
  /* Neuter, will be illegal as player gender */
  SetGender(0);
  SetLState(LSTATE_NORMAL);
  SetWeight(75000);
  SetMaxWeight(50000);
  SetMaxHP(100);
  SetMaxSP(100);
  SetMaxPEP(100);
  SetMaxMEP(100);
  SetHP(50);
  SetSP(50);
  SetPEP(50);
  SetMEP(50);
  SetMaxFood(100);
  SetMaxDrink(100);
  SetMaxAlcohol(100);
  SetDrink(QueryMaxDrink());
  SetFood(QueryMaxFood());
  SetAlcohol(0);
#endif

  Set(P_NOGET, 1);
  SetHands(({
    ({"right hand",0,WEAPON_CLASS_OF_HANDS}),
    ({"left hand",0,WEAPON_CLASS_OF_HANDS}) }) );
  SetAC(1);	/* set the intrinsic armour class, removes all else defences */
  
  SetStandard(1,"human","Nobody");
  SetLong(0);
  SetGender(0);
  enable_commands();
  add_putget_cmds();
  add_view_cmds();
  add_npc_cmds();

  /* For statistics */
  // catch("/obj/npcstat"->Add(this_object()));
}

reset() {
  items::reset();
//  skills::reset();
}

init() {
  combat::init();
  chat::init();
}
