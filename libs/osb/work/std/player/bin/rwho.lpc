#include <inetd.h>
#include <daemons.h>
#include <properties.h>
#include <msgclass.h>
#include <features.h>

int main(string str) {
  string msg, tmp;
  
  if (!str || str == "" || str == "?") {
    notify_fail("Usage: rwho <mudname>\n");
    return 0;
  }
  
#ifdef FEATURES_INTERMUD3
  if ( tmp = INET3_D->mud_find( str ) ) {
    INET3_D->do_who( tmp );
  }
  else 
#endif
       if (msg = INET_D->send_udp(str,
                                  ([ 
                                    I2H_REQUEST: "who", 
                                    I2H_SENDER: this_player()->Query(P_REALNAME) 
                                   ]), 1)) {
    msg_write( CMSG_GENERIC, msg );
    return 1;
  }

  msg_write( CMSG_GENERIC, "Request sent.\n");

  return 1;
}

