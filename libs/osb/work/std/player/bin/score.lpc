#include <properties.h>
#include <daemons.h>
#include <msgclass.h>
#include <money.h>

#define TP this_player()
#define CAP(x)  capitalize( (x)||"" )
#define SLIB "/lib/string"
inherit MONEY_LIB;

string GetColour(int amount,int max)
{
int percent;
  if (amount<0 || max<1) return "";

  percent=100*amount/max;

  if (percent>90) return "%^BOLD%^%^GREEN%^";
  else if (percent>66) return "%^GREEN%^";
  else if (percent>33) return "%^BOLD%^%^ORANGE%^";
  else return "%^BOLD%^%^RED%^";
}

public main( arg )
{
  string msg;
  string short,expl,tmp;
  string hpcol,spcol,mepcol,pepcol,rescol;
  int j, k, l, m, reminvis;
  
  j = EXPLOREMASTER->CountBits(TP->QueryExplored());
  k = (j*100)/EXPLOREMASTER->TotalEP();

  l = BANK_D->QueryAccount(getuid(TP));
  if (l<0){ l=0; } /* Just so the account doesn't show '-1' in bank */
  
  m = QuerySomeonesValue(TP);  


  if (this_player()->QueryGhost())
  {
    msg_write(CMSG_GENERIC,
	  "You can't use the command score right now.  Perhaps you're\n"+
      "dead or something.  Please try again later.  Thank you.\n");
    return 1;
  }

  hpcol=GetColour(TP->QueryHP(),TP->QueryMaxHP());  
  spcol=GetColour(TP->QuerySP(),TP->QueryMaxSP());  
  pepcol=GetColour(TP->QueryPEP(),TP->QueryMaxPEP());  
  mepcol=GetColour(TP->QueryMEP(),TP->QueryMaxMEP());  
  rescol="%^RESET%^";

  if ( query_verb() == "sc" )
  {
    msg=
	  sprintf(
	    "You have %s%d/%d%s HP %s%d/%d%s SP"
	    " %s%d/%d%s PEP %s%d/%d%s MEP and %d"
	    " XP as well as %d coins.\n",
	    hpcol,TP->QueryHP(),TP->QueryMaxHP(),rescol,
	    spcol,TP->QuerySP(),TP->QueryMaxSP(),rescol,
	    pepcol,TP->QueryPEP(),TP->QueryMaxPEP(),rescol,
	    mepcol,TP->QueryMEP(),TP->QueryMaxMEP(),rescol,
		TP->QueryXP(),m);
	msg_write(CMSG_GENERIC,msg);
	return  1;
  }

  if((this_player()->QueryGuild()) == 0) {this_player()->SetGuild("None");}

  reminvis = TP->QueryInvis(); TP->SetInvis(0);
  
  short = TP->Short();
  TP->SetInvis(reminvis);
  if (reminvis) short = (short || "")+" (invisible)";
/* nice confusing invis sequence eh? */

  msg="";  
  msg+=SLIB->cadjust(" "+TP->QueryShort()+"'s score ",75,"-=")+"\n";  
  msg += sprintf(
  "Title: %s %s\n"
  "Level: %d\n\n"
  "Str:  %3.3d      Money: %-10.10d  Race:   %-15.15s \n"
  "Con:  %3.3d      Bank:  %-10.10d  Guild:  %-15.15s \n"
  "Int:  %3.3d      Known: %-3.3d%%        Gender: %-4.6s\n"
  "Wis:  %3.3d      XP:    %-10.10d  \n"
  "Agi:  %3.3d                       \n"  
  "Qui:  %3.3d      Wimpy: %-3.3d         Load:   %-1.8d stones \n" 
  "Cha:  %3.3d      Mails: %-3.3d         Age:    %-20.20s\n"
  "\n"                
  "HP:  %s%-3.3d/%3.3d%s   Spec:              Food:    %-16.16s\n"
  "SP:  %s%-3.3d/%3.3d%s   Aim:               Water:   %-16.16s\n"
  "PEP: %s%-3.3d/%3.3d%s                      Alcohol: %-16.16s\n"
  "MEP: %s%-3.3d/%3.3d%s                      \n"
  ,

  TP->QueryShort(), TP->QueryTitle(), 
  TP->QueryLevel(),
  TP->QueryStr(), m, CAP(TP->QueryRace()), 
  TP->QueryCon(), l, TP->QueryGuild(), 
  TP->QueryInt(), k, CAP(TP->QueryGenderString()), 
  TP->QueryWis(), TP->QueryXP(),    
  TP->QueryAgi(),    
  TP->QueryQui(), TP->QueryWimpy(),   TP->QueryWeightContent()/10,
  TP->QueryCha(), MAILDEMON->FingerMail(getuid(TP)),TP->AgeString(), 
  hpcol,TP->QueryHP(), TP->QueryMaxHP(),rescol, TP->QueryFoodMsg(),
  spcol,TP->QuerySP(), TP->QueryMaxSP(),rescol, TP->QueryDrinkMsg(),
  pepcol,TP->QueryPEP(),TP->QueryMaxPEP(),rescol,TP->QueryAlcoholMsg(),
  mepcol,TP->QueryMEP(),TP->QueryMaxMEP(),rescol
  );

  msg+=SLIB->mkstr(75,"-=")+"\n";  
  msg_write( CMSG_GENERIC,msg);  
  seteuid(0);  
  return 1;
}
