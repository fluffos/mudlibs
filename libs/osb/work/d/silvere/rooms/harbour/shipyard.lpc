/*
 * The shipyard of Silvere — north of quay1_1.
 *
 * Strategy A FluffOS room. Original LDMud room is shipyard_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/harbour/quay1_1",
    "s": "/d/silvere/rooms/harbour/quay1_1",
  ]);
  extras = ([
    "frames":
    "Once these ships are finished and launched into the sea, they will "
    "roam the oceans and bring many brave adventurers to new, unknown "
    "coasts. These mere skeletons of ships already radiate a certain "
    "elegance and pride.\n",
    "ships":
    "Once these ships are finished and launched into the sea, they will "
    "roam the oceans and bring many brave adventurers to new, unknown "
    "coasts.\n",
    "pile":
    "Planks, ropes, canvas, nails everywhere.\n",
    "tar":
    "This hot, steaming tar is used to close the gaps between the planks "
    "of the ships. Its smell is intense, and you don't feel like to take "
    "a hot bath in these cauldrons yet ;)\n",
    "cauldrons":
    "This hot, steaming tar is used to close the gaps between the planks "
    "of the ships.\n",
    "nails":
    "These are really big, bad, awesome nails.\n",
    "planks":
    "Long planks, used for the ships construction. You wonder how many "
    "trees had to die for that.\n",
    "ropes":
    "Huge coils of rope are piled here.\n",
    "workers":
    "They are all tall, powerful men, working hard to complete the ships. "
    "Some of them curse you savagely because you prevent them from "
    "working by just standing around and doing nothing.\n",
    "lu'meyn":
    "You stop one of the workers and ask him about the Lu'meyn. The man "
    "turns at you: 'Well, the Lu'meyn is our ruler. He is in the palace "
    "in the center of Silvere. That's all I can tell you.'\n",
  ]);
}

string query_short() { return "The shipyard of Silvere"; }

string query_long() {
  return "You are in the shipyard of Silvere. Big piles of planks, ropes, "
    "canvas and nails are lying around everywhere. Cauldrons full of "
    "hot tar spread a strong smell. There are several frames of yet "
    "unfinished ships to see and lots of workers buzz around hectically "
    "to fulfill what the Lu'meyn instructed them to do.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_noway() {
  return "You run silly around and cause some chaos, as you come into the path "
    "of some of the workers.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_smell(string item) {
  if (item && lower_case(item) == "tar")
    return "Bah! This smells really ugly!\n";
  return "You smell a mixture of odors coming from wood, tar and the sweat of "
    "hard working men.\n";
}

string query_noise(string item) {
  return "You hear a big noise coming from knocking hammers, saws, loudly "
    "shouting men and mistakenly dropped planks all around you.\n";
}
