/*
 * The Office of the Harbourmaster — north of City Gate.
 *
 * Strategy A FluffOS room. Original LDMud room is harbourmaster_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/harbour/entrance",
    "s": "/d/silvere/rooms/harbour/entrance",
    "out": "/d/silvere/rooms/harbour/entrance",
  ]);
  extras = ([
    "desk":
    "The desk is large and solid looking. Its mahogany is well polished "
    "and shines with a warm red glow. A few papers lie on it in neat "
    "piles. An inobtrusive desk calendar sits off to one side.\n",
    "chair":
    "This wooden chair is simple in design, but looks comfortable and "
    "well-used.\n",
    "bell":
    "The brass bell shines with a polished gleam. A rope hangs from the "
    "clapper. This bell is to alert the harbourmaster that he has "
    "visitors, if he is busy elsewhere.\n",
    "map":
    "This is a large and detailed map of the harbour and its surrounding "
    "area. Written across the top in the elegant, oldhand style is: "
    "'Executed and Charted on the Royal Order of her most Excellence, "
    "the Lu'meyna of Silvere'.\n",
    "figurehead":
    "This is a figurehead carved in the shape of the goddess Xalandre. "
    "Legend has it that it adorned the prow of the last vessel the "
    "harbourmaster commanded.\n",
    "barometer":
    "A shiny wooden plaque. Affixed vertically to the plaque is a long "
    "glass tube, filled with some silvery liquid. Numbers line the sides "
    "of the tube.\n",
    "plaque":
    "A very faint engraving can be detected under the protective coating "
    "of wax: ~ Captain of the Balclutha, Royal Trading Vessel ~\n",
    "cubbyholes":
    "These are small compartments which hold various maps and charts of "
    "oceans, the stars, as well as pictures of ships.\n",
  ]);
}

string query_short() { return "The Office of the Harbourmaster"; }

string query_long() {
  return "The office of the harbourmaster gives you the impression of everything "
    "being in place. A large desk dominates the room, and a wooden chair "
    "rests behind it. On the wall behind the desk is a huge parchment map. "
    "Smaller maps are tucked into cubbyholes beneath it. A shiny brass "
    "bell hangs near the door, and a barometer is on the wall next to it. "
    "A figurehead is mounted above the door and smiles benignly on all in "
    "the room. Two windows as well as the open door give the harbourmaster "
    "a view of what is going on around him.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_noway() {
  return "You run into a wall.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "map")
    return "Written across the top in the elegant, oldhand style is: 'Executed "
      "and Charted on the Royal Order of her most Excellence, the Lu'meyna "
      "of Silvere'.\n";
  if (lower_case(item) == "plaque")
    return "A very faint engraving can be detected under the protective coating "
      "of wax:\n"
      "       ~ Captain of the Balclutha, Royal Trading Vessel ~\n";
  return 0;
}

string query_smell(string item) {
  return "You smell the fresh scent of the sea mixed with warm tar and dead "
    "fish.\n";
}

string query_noise(string item) {
  return "You hear the splashing of waves and the cawing of seagulls.\n";
}
