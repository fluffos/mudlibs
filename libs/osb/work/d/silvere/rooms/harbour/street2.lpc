/*
 * Paved road descending to the harbour of Silvere.
 *
 * Strategy A FluffOS room. Original LDMud room is street2_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/street1",
    "e": "/d/silvere/rooms/harbour/street1",
    "west": "/d/silvere/rooms/harbour/street3",
    "w": "/d/silvere/rooms/harbour/street3",
  ]);
  extras = ([
    "road":
    "A small paved street, covered with sand from the surrounding dunes.\n",
    "gates":
    "Up the hill to the east stand the city gates of Silvere.\n",
    "ocean":
    "The Ocean of Shamyra opens to the west beyond the harbour bay.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return "This is a small paved road that meanders gently down to the harbour of "
    "Silvere. Up the hill to the east are the city gates, the shining "
    "armour of the patrolling guards up there glitters brightly. The ocean "
    "of Shamyra opens to the west and you've got a great view upon the "
    "little bay down there. Busy shipping is going on all over the "
    "harbour basin.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are two obvious exits: east and west.\n";
}

string query_noway() {
  return "You run in a wall.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
