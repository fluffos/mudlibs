/*
 * Harbour street — west of the Silvere city gate.
 *
 * Strategy A FluffOS room. Original LDMud room is street1_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/entrance",
    "e": "/d/silvere/rooms/harbour/entrance",
    "west": "/d/silvere/rooms/harbour/street2",
    "w": "/d/silvere/rooms/harbour/street2",
  ]);
  extras = ([
    "window":
    "This is a large window in the house of the harbourmaster. It has a "
    "wooden frame and high glass panels.\n",
    "sun clock":
    "A large stone sun clock set upon a pedestal in the parting of the "
    "road.\n",
    "pedestal":
    "A carved stone pedestal supporting the harbour sun clock.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return "The road parts here around a large stone sun clock set upon a "
    "pedestal. The light spring breeze blowing up from the harbour basin "
    "tosses your hair about. Directly to the east are the city gates of "
    "Silvere. To the northeast is the house of the harbourmaster, where "
    "you can see a window.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are two obvious exits: east and west.\n";
}

string query_noway() {
  return "You run in a wall.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
