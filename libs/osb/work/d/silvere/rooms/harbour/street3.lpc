/*
 * A small crossing — roads lead from here to the ports.
 *
 * Strategy A FluffOS room. Original LDMud room is street3_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/street2",
    "e": "/d/silvere/rooms/harbour/street2",
    "northwest": "/d/silvere/rooms/harbour/quay1_1",
    "nw": "/d/silvere/rooms/harbour/quay1_1",
  ]);
  extras = ([
    "road":
    "A small paved street, covered with sand from the surrounding dunes.\n",
    "street":
    "A small paved street, covered with sand from the surrounding dunes.\n",
    "spots":
    "These little white spots are the sails of ships out there in the "
    "ocean.\n",
    "ships":
    "White sails dwindle slowly away toward the horizon of the Sea of "
    "Shamyra.\n",
    "towers":
    "Two strong towers guard the entrance to the harbour.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return "You are at the shore of a small bay west of Silvere. It protects the "
    "city's harbour from storm and rough tides. The small sandy road that "
    "meanders down from the city splits here. The view over the bay is "
    "fantastic. Ships come and go, entering the harbour or sailing away "
    "into the blue infinity of the ocean. You catch your breath at the "
    "sight of their white sails slowly dwindling away until they are "
    "nothing more than small spots on the horizon. Two strong towers guard "
    "the entrance to the harbour.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are two obvious exits: east and northwest.\n";
}

string query_noway() {
  return "You run silly around and nearly fall in the water.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
