/*
 * The docks — northern docking area of Silvere harbour.
 *
 * Strategy A FluffOS room. Original LDMud room is quay1_2_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/quay1_3",
    "w": "/d/silvere/rooms/harbour/quay1_3",
    "east": "/d/silvere/rooms/harbour/quay1_1",
    "e": "/d/silvere/rooms/harbour/quay1_1",
  ]);
  extras = ([
    "seagulls":
    "These scavenging white birds can be seen all around the harbour "
    "during the day.\n",
    "gulls":
    "These scavenging white birds can be seen all around the harbour "
    "during the day.\n",
    "nets":
    "Tattered and torn, it is evident that these nets have been discarded.\n",
    "fish nets":
    "Tattered and torn, it is evident that these nets have been discarded.\n",
    "pails":
    "Rusty tin pails line the land side of the quay.\n",
    "rusty tin pails":
    "Rusty tin pails line the land side of the quay.\n",
  ]);
}

string query_short() { return "The docks"; }

string query_long() {
  return "Fish nets are piled up alongside pails of old fish. Gulls caw and "
    "call to each other as they wheel through the sky, looking for handouts "
    "or easy prey. This is the northern docking area of the harbour. A "
    "timetable stands here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are two obvious exits: west and east.\n";
}

string query_noway() {
  return "You'll fall in the water if you don't watch where you're going.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_smell(string item) {
  return "The disgusting offal of the last haul spreads its stench everywhere.\n";
}
