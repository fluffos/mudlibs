/*
 * The Seaman's Rest — harbour inn (south of City Gate).
 *
 * Strategy A FluffOS room. Original LDMud room is harbour_inn_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/harbour/entrance",
    "n": "/d/silvere/rooms/harbour/entrance",
    "out": "/d/silvere/rooms/harbour/entrance",
  ]);
  extras = ([
    "sailors":
    "The sailors seem to be deep in their cups already, and are singing "
    "with much drunken gusto, if not much talent.\n",
    "sailor":
    "The sailors seem to be deep in their cups already, and are singing "
    "with much drunken gusto, if not much talent.\n",
    "landlord":
    "The landlord is a retired sailor himself, and looks like he knows "
    "how to handle this rowdy bunch. His arms bulge with muscles, his "
    "skin looks as tough as leather, and his sharp eyes seem to miss "
    "nothing.\n",
    "barrels":
    "The barrels are made of worn wood, and have a spigot for easy "
    "pouring. There are enough of them that the landlord need not fear "
    "running out any time soon.\n",
    "barrel":
    "The barrels are made of worn wood, and have a spigot for easy "
    "pouring.\n",
    "menu":
    "+----------------- The Seaman's Rest --------------------+\n"
    "  a pint of amber ale\n"
    "  a glass of red wine\n"
    "  shot of imported rum\n"
    "  Mica Dark\n"
    "  Tune's Tequila Sunrise\n"
    "  Superj's Stout\n"
    "  Elfgarian Shandy\n"
    "  Sykoran cider\n"
    "  a plate of lamb stew\n"
    "  a plate of cheese and bread\n"
    "  buxtehuden rudel pickles\n"
    "+--------------------------------------------------------+\n",
    "sign":
    "+----------------- The Seaman's Rest --------------------+\n"
    "  a pint of amber ale\n"
    "  a glass of red wine\n"
    "  shot of imported rum\n"
    "  Mica Dark\n"
    "  Tune's Tequila Sunrise\n"
    "  Superj's Stout\n"
    "  Elfgarian Shandy\n"
    "  Sykoran cider\n"
    "  a plate of lamb stew\n"
    "  a plate of cheese and bread\n"
    "  buxtehuden rudel pickles\n"
    "+--------------------------------------------------------+\n",
    "sawdust":
    "They should think about changing it soon; no telling how many "
    "sailors and shipmen have trodden on it.\n",
    "floor":
    "Stained yellow pine planks covered with a scattering of soiled "
    "sawdust.\n",
    "plank":
    "Some of the planks seem to be from the wreckage of a ship. There "
    "seems to be a 'B', a 't', and a 'y' still visible.\n",
    "windows":
    "These windows could use some cleaning. However, you can still make "
    "out the harbour through the spiderwebs and smears of dirt.\n",
    "counter":
    "A battered wooden counter with a few taps for barrels of beer.\n",
  ]);
}

string query_short() { return "The Seaman's Rest"; }

string query_long() {
  return "Rough trestle tables stand scattered about the snug common room of "
    "the Seaman's Rest, stained and scratched from long years of use. "
    "Sawdust covers the pine plank floor, and small dirty windows look "
    "out on the harbour of Silvere. The landlord serves from behind a "
    "battered counter, and a number of sailors are sitting at the tables, "
    "loudly singing a sea shanty. Barrels of wine and ale are stacked "
    "along the walls. A warped, hand-painted sign hangs on one wall; "
    "presumably, this is the menu.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_noway() {
  return "You run into a wall.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "menu" || lower_case(item) == "sign")
    return extras["menu"];
  if (lower_case(item) == "barrel" || lower_case(item) == "barrels")
    return "A few barrels have branded on them 'Vinted exclusively in Silvere' "
      "and 'Distilled under royal license of the Lu'meyna of Silvere'.\n";
  return 0;
}

string query_noise(string item) {
  if (item && (lower_case(item) == "song" || lower_case(item) == "shanty"))
    return "The sailors drunkenly belt out...\n\n"
      "  I am a brisk and sprightly lad\n"
      "  But just come home from sea, sir.\n"
      "  Of all the lives I've ever led\n"
      "  A sailor's life for me, sir.\n\n"
      "  Yeo, Yeo, Yeo,\n"
      "  Whilst the boatswain pipes all hands\n"
      "  With a yeo, yeo, yeo!\n";
  return "The sailors' singing drowns out most other noise. Perhaps if you "
    "'listen song', you'll hear the words to the shanty.\n";
}
