/*
 * Entrance to the northern defense tower of Silvere harbour.
 *
 * Strategy A FluffOS room. Original LDMud room is ntower_enter_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay1_3",
    "e": "/d/silvere/rooms/harbour/quay1_3",
  ]);
  extras = ([
    "chain":
    "A large and heavy chain hangs down from the northern tower and "
    "vanishes into the water nearly at the wall of that building.\n",
    "chains":
    "A large and heavy chain hangs down from the northern tower and "
    "vanishes into the water nearly at the wall of that building.\n",
    "tower":
    "Which tower do you mean? Directly before you stands the northern "
    "tower. The southern tower stands on the far end of the southern "
    "quay.\n",
    "north tower":
    "The tower walls rise, sleek and stony, straight into the sky. On "
    "the southern wall is an opening in the tower wall, framed in timber, "
    "through which the harbour chain can be reeled in for protection or "
    "dropped to let ships pass into the bay.\n",
    "south tower":
    "The southern tower can be found on the far end of the quay on the "
    "southern side of the harbour.\n",
    "wall":
    "The wall of the tower rises high into the sky before your eyes. On "
    "top of it you can faintly make out battlements.\n",
    "walls":
    "The wall of the tower rises high into the sky before your eyes. On "
    "top of it you can faintly make out battlements.\n",
    "stone":
    "The stones of the tower walls are simple and grey, revealing nothing "
    "unusual even under close scrutiny.\n",
    "stones":
    "The stones of the tower walls are simple and grey, revealing nothing "
    "unusual even under close scrutiny.\n",
    "opening":
    "A square opening in the southern side of the guard tower is just "
    "visible from the quay. A heavy chain passes through the opening and "
    "disappears beneath the surface of the water.\n",
  ]);
}

string query_short() { return "Before a high tower"; }

string query_long() {
  return "The easterly side of the quay ends abruptly before a square, stone "
    "tower, crowned with battlements high above. Set into the thick "
    "eastern wall of the tower is an entrance leading into a gloomy "
    "interior. A second tower on the southern quay mirrors this one.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_noway() {
  return "As you try to go there you nearly slip from the quay into the murky "
    "water of the harbour. Now, that's not the best thing you could do...\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
