/*
 * City Gate — entrance between the harbour and Silvere.
 *
 * Strategy A FluffOS room. Original LDMud room is entrance_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/harbour/harbourmaster",
    "n": "/d/silvere/rooms/harbour/harbourmaster",
    "south": "/d/silvere/rooms/harbour/harbour_inn",
    "s": "/d/silvere/rooms/harbour/harbour_inn",
    "west": "/d/silvere/rooms/harbour/street1",
    "w": "/d/silvere/rooms/harbour/street1",
  ]);
  extras = ([
    "ivy":
    "The ivy is hanging down from the citywall of Silvere. A few green "
    "leaves are showing up, and it looks strong enough to catch the sea "
    "breeze.\n",
    "office":
    "The office of the harbourmaster stands on the north side of the road.\n",
    "inn":
    "The Seaman's Rest tavern stands on the south side of the road.\n",
  ]);
}

string query_short() { return "City Gate"; }

string query_long() {
  return "A fresh breeze brings the smell of a new year and lots of cold air "
    "from the ocean. The road leads from the harbour into the city of "
    "Silvere. At the walls of the city are two buildings. The building to "
    "the north is the office of the harbourmaster and to the south is "
    "the Seaman's Rest. The gates of the city stand closed beyond the road.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are three obvious exits: north, south, and west.\n";
}

string query_noway() {
  return "You run in a wall.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
