/*
 * The quay at Silvere — west of the docks toward the northern tower.
 *
 * Strategy A FluffOS room. Original LDMud room is quay1_3_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/ntower_enter",
    "w": "/d/silvere/rooms/harbour/ntower_enter",
    "east": "/d/silvere/rooms/harbour/quay1_2",
    "e": "/d/silvere/rooms/harbour/quay1_2",
  ]);
  extras = ([
    "sails":
    "Torn and thrown away remains of sails. Nobody cares for all that "
    "rubbish here.\n",
    "sail":
    "Torn and thrown away remains of sails. Nobody cares for all that "
    "rubbish here.\n",
    "rubbish":
    "Torn and thrown away remains of sails. Nobody cares for all that "
    "rubbish here.\n",
    "fishing line":
    "Useless fishing lines are littered everywhere. Take care you don't "
    "get caught on one of the nasty hooks.\n",
    "line":
    "Useless fishing lines are littered everywhere. Take care you don't "
    "get caught on one of the nasty hooks.\n",
    "lines":
    "Useless fishing lines are littered everywhere. Take care you don't "
    "get caught on one of the nasty hooks.\n",
    "hooks":
    "Thay look really nasty. Take care you don't get caught on one of "
    "them.\n",
    "oar":
    "Hmm... these oars are nothing more than firewood now.\n",
    "oars":
    "Hmm... these oars are nothing more than firewood now.\n",
    "tower":
    "The towers can be found at the end of each quay. They are high and "
    "it seems that they watch over the harbour of Silvere. They look "
    "quite interesting though.\n",
    "towers":
    "The towers can be found at the end of each quay. They are high and "
    "it seems that they watch over the harbour of Silvere. They look "
    "quite interesting though.\n",
  ]);
}

string query_short() { return "The quay at Silvere"; }

string query_long() {
  return "The quay runs along the murky water out to one of the towers "
    "guarding the entrance to the bay. Torn sails, fishing line and "
    "discarded oars litter the sides of the quay. The sunlight plays off "
    "the water, casting strange shadows on the tower walls.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are two obvious exits: west and east.\n";
}

string query_noway() {
  return "As you try to go there you nearly slip from the quay into the murky "
    "water of the harbour. Now, that's not the best thing you could do...\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
