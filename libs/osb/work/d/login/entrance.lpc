/*
 * Entering One Step Beyond — startup room in OSB.
 *
 * Strategy A FluffOS room. Original LDMud room is entrance_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "normal": "/d/silvere/rooms/harbour/quay1_2",
    "newbie": "/d/silvere/rooms/harbour/quay1_2",
    "instant": "/d/silvere/rooms/harbour/quay1_2",
    "out": "/d/silvere/rooms/harbour/quay1_2",
  ]);
  extras = ([
    "wall":
    "At first glance the walls appear to be that of a hot dog, yet "
    "something tells you they are more like a dark wood.\n",
    "walls":
    "At first glance the walls appear to be that of a hot dog, yet "
    "something tells you they are more like a dark wood.\n",
    "brown wall":
    "At first glance the walls appear to be that of a hot dog, yet "
    "something tells you they are more like a dark wood.\n",
    "brown walls":
    "At first glance the walls appear to be that of a hot dog, yet "
    "something tells you they are more like a dark wood.\n",
  ]);
}

string query_short() { return "Entering One Step Beyond"; }

string query_long() {
  return "                      Welcome to OSB\n\n"
    "As your sight comes back into focus, you notice you aren't where you "
    "were a moment ago. You see brown walls surrounding you, slightly "
    "spherical towards the top and bottom. You begin to wonder if you are "
    "trapped in a hot dog. Knowing this can't be the answer, you decide to "
    "explore and see where it takes you.\n\n"
    "To enter OSB, please select one of the following ways to step ashore:\n"
    "  normal   Begin your character directly in Silvere harbour.\n"
    "  newbie   Step onto the docks with a guided start.\n"
    "  instant  Jump right into Silvere harbour.\n\n"
    "Please type 'normal', 'newbie' or 'instant' to proceed.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "There are three obvious exits: normal, newbie, and instant.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_smell(string item) {
  return "You smell something that seems to be .... sea water.\n";
}
