mapping *quest = ({
     ([      "quest":                "蛇胆膏",
        "diff":                 2,
        ]),
     ([      "quest":                "面具",
        "diff":                 2,
        ]),
     ([      "quest":                "玉萧",
        "diff":                 8,
        ]),
     ([      "quest":                "紫金锤",
        "diff":                 2,
        ]),
     ([      "quest":                "风雷堂令牌",
        "diff":                 4,
        ]),
     ([      "quest":                "白虎堂令牌",
        "diff":                 4,
        ]),
     ([      "quest":                "青龙堂令牌",
        "diff":                 3,
        ]),
     ([      "quest":                "天香堂令牌",
        "diff":                 3,
        ]),
     ([      "quest":                "葵花针",
        "diff":                 10,
        ]),
     ([      "quest":                "拂尘",
        "diff":                 3,
        ]),
     ([      "quest":                "黑龙鞭",
        "diff":                 2,
        ]),
     ([      "quest":                "『星宿毒经〖上册〗』",
        "diff":                 2,
        ]),
});
mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
