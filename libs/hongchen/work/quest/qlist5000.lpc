mapping *quest = ({
     ([      "quest":                "腐烂的尸体",
                "diff":                 3,
        ]),
     ([      "quest":                "沙虫壳",
                "diff":                 3,
        ]),
        ([      "quest":                "铜鼓",
                "diff":                 2,
        ]),
        ([      "quest":                "羊鞭",
                "diff":                 1,
        ]),
     ([      "quest":                "维吾尔族长袍",
                "diff":                 2,
        ]),
     ([      "quest":                "牛皮袋",
        "diff":                 2,
        ]),
     ([      "quest":                "青稞面",
        "diff":                 2,
        ]),
});
mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
