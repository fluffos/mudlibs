// ROOM yunmenggu.c
inherit ROOM;

void create()
{
set("short", HIM"栖霞园"NOR);
        set("long", @LONG
走进这里，你仿佛到了一个花的海洋，蝶的世界。溪流潺潺，
河畔边遍地不知名的兰花迎风怒放，姹紫嫣红，争奇斗妍。在花
丛之间，无数的凤蝶正翩翩起舞，上下纷飞。兰花和凤蝶环绕着
一座白玉雕塑，塑的是一位窈窕飘逸的妙龄少女，只见她凤髻宫
状，柳腰轻折，一手持剑，剑尖遥指正前；一手指捏剑诀，掌心
朝天。你正目眩神迷之时，那少女仿佛活过来一般朝你微微一笑
，白玉般的脸颊隐隐绽出一丝笑意，你心口“砰”的一跳，刹那
间，满园的凤蝶化为个个大字，在你面前组合成一篇文章(jieshao)
。你不由的晃了晃头，难道这是在梦境？
LONG
        ); 
        set("exits",  ([
"out" : "/d/player/mingren/mingren2",
]));        set("no_clean_up", 0);
set("no_fight", 1);
set("no_magic", 1);
set("no_steal", 1);
set("no_beg", 1);
set("no_sleep_room", 1);
set("item_desc", ([
"jieshao" : "......\n"
]));
set("objects", ([
"/d/player/mingren/npc/xiaodie" : 1,
]));
        setup();
}  
void init()
{
message_vision(HIG"一股渺渺柔柔的云雾舒展开来，迎面而来的那种清新湿润的感觉，让$N精神一震，

不觉心旷神怡，飘飘欲仙。满园春色早已关不住了，遍地鸟语花香，蝶飞蜂舞。

几只顽皮可爱的小猫正在兰花丛中嬉闹，偶尔抬起前肢懒懒的朝你打个招呼。\n"NOR,

        this_player());
}

