//ROOM anakrm.c
inherit ROOM;

void create()
{
set("short", HIY"幻舞峰"NOR);
        set("long", @LONG
风云际遇之下，结识了武林高手之一--赤鳳，他(jieshao)在师傅
一手培育下，所谓名师出高徒，现在阿穆，在武林中跟着师傅齐名了。
虽然在武功上比不上师傅，但他的独门暗器，却是天下第一。无人能及。
甚至已经在他的师傅之上。现在的他，在幻舞峰上，继续他的修行。
LONG
        ); 
        set("exits",  ([
"out" : "/d/player/mingren/mingren3",
]));        set("no_clean_up", 0);
       set("item_desc", ([
"jieshao" : "    不知道從哪裏冒出來的小子，一夜之間，成名了。竟然可以列入\n"
"十大高手的排名，真令人莫名奇妙。但他卻不喜歡殺人。不過也沒有怎麽\n"
"幫過人。孤獨地過著余生。\n"
]));
set("no_fight", 1);
set("no_magic", 1);
set("no_steal", 1);
set("no_beg", 1);
set("no_sleep_room", 1);
set("objects", ([
"/d/player/mingren/npc/yuky" : 1,
]));
        setup();
}  

