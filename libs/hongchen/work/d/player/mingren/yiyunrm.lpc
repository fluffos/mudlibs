#include <room.h>

inherit ROOM;
string look_shu();

void create()
{
        set("short", "飞仙居");
        set("long", @LONG
这是武林高手逸云隐居的溶洞，洞口写着“飞仙”两个龙飞凤舞
的草书大字。环目四顾，石钟乳林立，汩汩流下的石乳在洞的西侧聚
集成一个小浅塘，塘中有一棵环身围绕着红光的千年灵芝，隐隐清香
若有若无。东侧堆放着一些山精黄石和洗漱之物，正中间是一天然石
台，孤零零的放着一个古久的小蒲团。四周石壁上布满了千姿百态的
小人和一篇密密麻麻的文字（jieshao），竟是用手指一笔一划刻出来
的，深入山壁足足有半指之多，可见此处主人一身的武艺已到炉火纯
清的境界了。
LONG );

        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        set("no_sleep_room", "1");
        set("no_clean_up", 0);
           set ("no_magic", 1);

        set("exits", ([
                "out" : __DIR__"mingren2",
        ]));
       set("item_desc", ([
                   "jieshao" :  "    此人算红尘第一代玩家, 曾经拜师逍遥, 少林, 星宿, 武当, 明教, 白驮, \n"
"梅庄, 丐帮, 慕容山庄. 学的东西是乱七八糟的, 偏偏此人生性如此, 无可奈何\n"
"啦. 自铸武器是棍,也是目前唯一使用棍法的家伙,也许再也没有这么傻的人了.\n"
"哈哈! \n"
"    天生注定此人福缘泽厚, 俗话叫傻人有傻福, 在红尘里晃悠半生, 无依无靠\n"
"稀里糊涂的度过了大半生, 最后在他拜师达摩, 就要决定在少林寺里终老的时候,\n"
"一个偶然的机遇, 他在古稀之年碰到了一位精灵顽皮人见人爱的侠女, 于是焕发\n"
"了第二春, 判出少林, 还俗回乡与那位侠女结为秦晋之好, 共同创造了爱的小屋\n"
"--云梦轩与云梦谷. 从此吟诗画眉, 不亦悦呼! 唯一遗憾的是无弄獐之喜, 无奈\n"
"巫师不肯帮忙,此乃美中不足,sigh \n"
"    本想从此携妻平平静静安安稳稳的渡过一生, 但是静极思动, 于是在酒酣耳\n"
"热之际, 重出江湖, 与几位好友共同创立了凌霄山庄这一玩家帮会. 立志要在红\n"
"尘之中干一番事业, 闯出名声. 在几位朋友的谦让之下, 免为其难的坐上了凌霄\n"
"山庄第一任庄主宝座. 可惜此人实在不会管事, 处理事务优柔寡断, 只有办砸的,\n"
"没有办好的, 呜呼哀哉! 有负山庄成员之期望, 好在众人心中明白此人实已尽力,\n"
"所以仍然信任支持他,实在不胜惶恐,不胜惶恐!\n"
"    此人生性不好杀戮,亦不好聊天,平时不常讲话, 但较为热心, 好帮忙新人, \n"
"可惜帮忙的也不是那么经常, 而且常常因为自己的粗陋寡闻而误导他人, 好在新\n"
"人不计较, 着实汗颜!\n"
"    这次听说红尘要创立名人堂, 心中揣摩大约应该能符合进名人堂之要求, 于\n"
"是乎抢先申请了,不好意思啦大家,呵呵!\n"

]));
        set("objects", ([
                __DIR__"npc/yiyun": 1,
        ])); 
        setup();
        replace_program(ROOM); 
}
