// gczh_sword.c
// lwt 2000/10/16
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIR"火"HIY"龙"HIB"鞭"NOR, ({ "gczh_sword",}));
        set_weight(6000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                        set("long", "    这是一柄用寒丝羽竹打造而成的火龙鞭。
看起来晶莹碧绿，透着丝丝的寒意。一种庄严，温和，凛然而不可侵犯
的气息让人不敢有一丝亵渎之意, 它已经返朴归真，成为真正的上古神
兵。上面用小篆刻着一行小字：小山造于乙卯年一月二十六日辰时四。\n");
                         set("value", 187);
set("material", "steel");
 set("wield_msg", "$N暗运内力，只见一道白芒闪过，$N手中已无声无息地多了一把"HIR"火"HIY"龙"HIB"鞭"NOR"。\n" NOR);
 set("unwield_msg", ""HIR"火"HIY"龙"HIB"鞭"NOR"自$N掌中飞起，在半空中一转，「唰」地跃入剑鞘。\n" NOR);
                     }
        init_sword(240);
        setup();
}

