inherit ITEM;

void create()
{
    set_name( "云雾英雄令", ({"yunwu ling"}) );
    set_weight(100);
    if( clonep())
        set_default_object(__FILE__);
    else
    {
        set("unit", "块");
        set("long", "这是一块用于通行雾中楼的银铸令牌，由楼主签发。\n");
        set("yunwu",1);
        set("no_drop","这东西不能随便丢弃！");
        set("no_get",1);
        set("no_give",1);
        set("no_put",1);
        set("material", "iron");
    }
    setup();
    call_out("dest", 60);
}

void dest()
{
    object ob=environment(this_object());
    if (ob)
    {
    	tell_object(ob, HIY "几个雾中楼弟子对你说：时辰已过，我们现在送您回扬州中央广场去。\n"NOR);
        ob->move("/d/city/guangchang");
        message("vision",
                HIW "你的眼前突然出现一阵浓雾，朦胧中你眼前现出了一个人。\n"
                NOR, environment(ob), ob);
    }
    destruct(this_object());
}
