
inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "雾中楼大门");
	set("long", "
    你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高的旗杆，
杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮子，狮子上头有一只
蝙蝠飞翔。左首旗子上写着"BLINK HIW"雾中楼"NOR"三个烫金大字，银钩铁划，刚劲非凡。\n");

	set("exits", ([
		"south" : __DIR__"road1",
                "north" : "/d/city3/guandao2",
	]));
	set("no_clean_up", 0);
        set("objects",([
                __DIR__"npc/menwei" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
    if (dir=="south")
    {
    	if (me->query("wzl")==1)
    	{
    	    if( (int)me->query_condition("killer") )
    	    	return notify_fail("门卫把手一拦：本帮决不包庇官府通缉犯!\n");
    	    else
    	        return 1;
    	}
	else
	    return notify_fail("门卫把手一拦：恕本帮不接待外客，还是先找楼主加入我们派再进去吧!\n");
    }
    else
        return 1;
}
