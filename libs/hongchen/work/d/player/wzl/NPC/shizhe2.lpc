inherit NPC;
string ask_xiang();
object ob = this_object();

void create()
{
        set_name("侍香使者",({"shizhe"}));
        set("title",HIW"〖雾中楼〗"NOR);
        set("long",
              "他就是雾中楼的侍香使者\n"
              "他脸上带着和蔼的笑容。\n");
        set("age", 60);
        set("attitude", "peaceful");
        set("shen_type", 0);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per", 30);

        set("max_qi", 500000);
        set("max_jing", 500000);
        set("neili", 50000);
        set("max_neili", 500000);
        set("jiali", 500);
        set("combat_exp", 200000000);
        set("score", 500000);

        set_skill("dodge",2002);
        set_skill("unarmed",800);
        set_skill("force", 2222);
        set_skill("parry", 800);
        set_skill("sword", 800);
        set_skill("literate", 2002);

        set("inquiry",
                ([
                        "name" : "我就是雾中楼的楼主手下的侍香使者。\n",
                        "here" : "这里是大名鼎鼎的雾中楼，难道你没有听说过？\n",
                        "入会" : (: ask_xiang :),
                        "香"   : (: ask_xiang :),
                ]));
        setup();
}

string ask_xiang()
{
        object ob;

        if( present("xiang", this_player()) )
        	return RANK_D->query_respect(this_player()) +
                "你现在身上不是有了香吗，怎么又来要了？\n";

        ob = new("/d/player/wzl/obj/xiang");
        ob->move(this_player());
        return "你把这柱香点了，插进香炉拜了把子，便正式成为我们的好兄弟。";
}
