inherit NPC;
string ask_help();
string ask_guide();
object ob = this_object();

void create()
{
        set_name("冰河",({"river hc"}));
        set("title",HIW"〖雾中楼〗"HIY"门生"NOR);
        set("long",
              "他就是雾中楼的楼主的门生之一，\n"
              "他很感激他的师傅也就是楼主，\n"
              "因为他学到了很多东西，于是\n"
              "他决定把他所学到的都与同楼兄弟分享。\n"
              "他脸上带着执着而又淡淡的笑容。\n");
        set("age", 25);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per", 25);

        set("max_qi", 50000);
        set("max_jing", 50000);
        set("neili", 50000);
        set("max_neili", 250000);
        set("jiali", 500);
        set("combat_exp", 12500000);
        set("score", 5000);

        set_skill("dodge",1314);
        set_skill("unarmed",500);
        set_skill("force", 1234);
        set_skill("parry", 500);
        set_skill("sword", 500);
        set_skill("literate", 1080);

        set("inquiry",
                ([
                        "name" : "我就是楼主的门生。你叫什么名啊？\n",
                        "here" : "这里是偶的小屋，怠慢了贵客，不好意思。\n",
                        "雾中楼" : (: ask_guide :),
                        "帮规" : (: ask_guide :),
                        "帮助" : (: ask_help :),
                        "help" : (: ask_help :),
                ]));
        setup();
}

string ask_guide()
{
        object ob;
	if( present("guide", this_player()) )
        	return RANK_D->query_respect(this_player()) +
                "你现在身上不是有了吗，怎么又来要了？\n";
        ob = new("/d/player/wzl/obj/guide");
        ob->move(this_player());
        return "我一时不知道怎么说，你自己看看这指南吧。";
}

string ask_help()
{
	return "我不知道应该怎么说，你自己先看看这个help gl1-5";
}
