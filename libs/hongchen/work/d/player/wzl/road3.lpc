inherit ROOM;
void create()
{
	set("short", "忠诚路");
	set("long",
"这是雾中楼的忠诚路，地面铺着红色地毯。南面通往总坛。\n"
"西方通往『雷神堂』东方通往『电神堂』。\n");
	set("exits", ([
                "east" : __DIR__"dsmen",
                "west" : __DIR__"lsmen",
		"south" : __DIR__"guangchang",
                "north" : __DIR__"road2",

	]));
	set("outdoors", "road3");
	setup();
	replace_program(ROOM);
}

