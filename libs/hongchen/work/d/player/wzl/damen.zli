
inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "雾中楼大门");
	set("long", "
    你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高的旗杆，
杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮子，狮子上头有一只
蝙蝠飞翔。左首旗子上写着"BLINK HIW"雾中楼"NOR"三个烫金大字，银钩铁划，刚劲非凡。\n");

	set("exits", ([
		"south" : __DIR__"road1",
                "north" : "/d/city3/guandao2",
	]));
	set("no_clean_up", 0);
        set("objects",([
                __DIR__"npc/menwei" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
    object ob;
    if (dir != "south")
        return ::valid_leave(me, dir);
    ob=present("men wei", environment(me));
        if (dir == "south" && objectp(ob) && living(ob))

    {
        if ((me->query("party/party_name") == "雾中楼"))
            {
            if ((me->query("gender") == "男性"))
                write("门卫说道：帅哥～请进。\n");
            else if ((me->query("gender") == "女性"))
                write("门卫嘻嘻笑道：靓女～请进，请进。\n");
            return 1;
            }
        if( present("wz ling", me) && ((int)me->query("shen") > -50000000))
        {
            write("门卫躬身说道：恩，你拿的确实是本帮令牌，请进请进！\n");
            return 1;
        }
                else 
            return notify_fail("门卫喝道：你不是本帮弟兄，先去找楼主加入我帮吧，这位" + 
   RANK_D->query_respect(me) + "请止步。\n");
    }
    return ::valid_leave(me, dir);
}
