
inherit ROOM;

void create()
{
	set("short", "后山腰");
	set("long",
"虎啸狼嚎，声声入耳，你还是快点离开为好。\n");
	set("exits", ([
		"eastup" : __DIR__"room1",
		"westup" : __DIR__"room2",
		"northdown" : __DIR__"ground2",
	]));
	set("outdoors","houshan");
	setup();
	replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
    if ( dir != "eastup" || dir != "westup" )
    	return ::valid_leave(me, dir);
    if (!::valid_leave(me, dir))
    	return 0;
    if( present("yunwu ling", me) )
        return 1;
    else
	return notify_fail("对不起，请留步, 那里不能进的。\n");
}


