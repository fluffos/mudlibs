#include <ansi.h>;
inherit NPC;
void create()
{
        set_name("浪翻云", ({"lang fanyun", "lang"}));
        set("gender", "男性");
        set("title", HIC"覆雨剑"NOR);
        set("age", 30);
        set("long",
            "浪翻云  身材高大，面貌粗犷。皮肤粗黑\n"
            "双眼细长而常常带上一种病态的黄色，使人不欲久看。\n"
            "这外貌吓人的豪汉，绝不如表象的钢铁模样，而是一个温柔多情的细心男子。\n");
          set("attitude", "peacefully");
        set("shen_type",1);
        set("str", 28);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
              set("per", 25);

        set("chat_chance_combat", 160);
        set("chat_msg_combat", ({
    (: perform_action, "sword.qixing" :),
    (: perform_action, "sword.qixing" :),
    (: perform_action, "sword.qixing" :),
    (: perform_action, "sword.qixing" :),
    (: perform_action, "sword.qixing" :),
                (: exert_function, "heal" :),
                (: exert_function, "heal" :),
                (: perform_action, "unarmed.nujiao" :),
                (: perform_action, "unarmed.nujiao" :),
         (: perform_action, "sword.qixing" :),
        }));

       set("qi", 50000);
    set("max_qi", 50000);
     set("jing",10000);
        set("jingli",40000);
       set("max_jing", 180000);
    set("neili", 105000);
      set("max_neili", 30000);
      set("jiali", 500);

      set("combat_exp", 50880000);
        set("score", 100000);

     set_skill("force", 1050);
        set_skill("polang-shengong", 1050); 
      set_skill("sword", 1050);
      set_skill("fuyu-sword",1050); 
        set_skill("dodge", 1000);
        set_skill("dengping-fushui", 1050);  
      set_skill("parry", 1080);
     set_skill("unarmed",1080);
     set_skill("nujiao-quan", 1020);    
     set_skill("literate",1660);

        map_skill("force", "polang-shengong");
        map_skill("sword", "fuyu-sword");
        map_skill("dodge", "dengping-fushui");
        map_skill("parry", "dengping-fushui");
        map_skill("unarmed", "nujiao-quan");
        prepare_skill("unarmed", "nujiao-quan");

        create_family("怒蛟帮", 3, "弟子");

        set("inquiry", ([
                "惜惜" :  "你为什么要离我而去。\n",
        ]) );
        set("chat_msg", ({
              "浪翻云仰头灌了一口酒，叹道：“惜惜！你怎么会就离我而去呢？\n",
        }));
        setup();

      carry_object(__DIR__"obj/cloth")->wear();
          carry_object(__DIR__"obj/fuyujian")->wield();

}

void attempt_apprentice(object ob)
{
                if ((int)ob->query_skill("sword", 1) < 350) {
                command("say 你基本功太差了，学不会我的功夫。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把基本功练好了在来找我！");
                return;
        }
        if ((int)ob->query_skill("polang-shengong", 1) < 350) {
                command("say 你的内功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把内功先提高了在来吧？");
                return;
        }
        if ((int)ob->query("shen") < 200000) {
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否还做得不够？");
                return;
        }
    if ((int)ob->query("int") < 28) {
                command("say 你的悟性太差学不来我的功夫。");
                command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
                return;
        }
       command("chat " + RANK_D->query_respect(ob) + "怒蛟帮以后就要靠你们了。");
        command("recruit " + ob->query("id"));
        ob->set("title",HIC"覆雨剑亲传"NOR);
       ob->set("class", "yujianliu");
}


