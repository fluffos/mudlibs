#include <weapon.h>

inherit BLADE;

void create()
{
      set_name(HBRED HIR"天兵宝刀"NOR, ({ "tianbing blade", "blade","baodao" }) );
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "iron");
        set("value", 1000000);
         set("weapon_prop/strength", 150);
                set("long", "这是一把伴随戚长征成名江湖的宝刃。\n" );
                 set("wield_msg",HIR"一道红光，$n已在$N手中，只觉红光四射，不禁机伶伶的打个冷战。\n"NOR);
                set("unwield_msg", "$N将$n插回腰间，红光顿敛.n");
        }
        init_blade(400);
        setup();
}

