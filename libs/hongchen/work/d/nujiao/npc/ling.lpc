#include <ansi.h>;
inherit NPC;
void create()
{
        set_name("凌战天", ({"ling zhantian", "ling"}));
        set("gender", "男性");
        set("title", HIB"鬼索"NOR);
        set("age", 30);
        set("long",
            "他看起来容貌瘦削英俊，两眼精明，虎背熊腰，非常威武。\n"
            "正是与浪翻云齐名的右先锋“鬼索”凌战天。\n");
        set("attitude", "friendly");
        set("shen_type",1);
        set("str", 28);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
              set("per", 25);

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "heal" :),
                (: exert_function, "heal" :),
                (: perform_action, "unarmed.nujiao" :),
                (: perform_action, "unarmed.nujiao" :),
                (: perform_action, "unarmed.nujiao" :),
             (: perform_action, "sword.qixing" :),
        }));

    set("qi", 35000);
         set("max_qi", 35000);
        set("jing", 18000000);
        set("jingli", 18000000);
       set("max_jing", 180000);
        set("jingli", 18000000);
        set("neili", 20000);
  set("max_neili", 20000);
     set("jiali", 600);

      set("combat_exp", 20880000);
        set("score", 100000);

        set_skill("force", 780);
        set_skill("polang-shengong", 780); 
        set_skill("sword", 780);
        set_skill("fuyu-sword",750); 
        set_skill("dodge", 700);
        set_skill("dengping-fushui", 750);  
        set_skill("parry", 780);
        set_skill("unarmed",780);
        set_skill("nujiao-quan", 720);    
 set_skill("literate",1460);

        map_skill("force", "polang-shengong");
        map_skill("sword", "fuyu-sword");
        map_skill("dodge", "dengping-fushui");
        map_skill("parry", "dengping-fushui");
        map_skill("unarmed", "nujiao-quan");
        prepare_skill("unarmed", "nujiao-quan");

        create_family("怒蛟帮", 4, "弟子");

        set("chat_msg", ({
              "凌战天冷冷的看了你一眼。\n",
        }));
     setup();

      carry_object(__DIR__"obj/cloth")->wear();
          carry_object(__DIR__"obj/changjian")->wield();

}

void attempt_apprentice(object ob)
{
      if ((int)ob->query_int() < 28) {
             command("say 你的悟性太差学不来我的功夫。");
         command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
        return;
 }
                if ((int)ob->query_skill("sword", 1) < 200) {
                command("say 你基本功太差了，学不会我的功夫。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把基本功练好了在来找我！");
                return;
        }
        if ((int)ob->query_skill("polang-shengong", 1) < 250) {
                command("say 你的内功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把内功先提高了在来吧？");
                return;
        }
       command("chat " + RANK_D->query_respect(ob) + "好好干，怒蛟帮不会亏待你们的。");
        command("recruit " + ob->query("id"));
        ob->set("title",HIB"鬼索亲传"NOR);
}

