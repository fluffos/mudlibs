inherit ROOM;

void create()
{
  set ("short", "小山谷");
  set ("long", @LONG
怒蛟岛南边一个小山谷，这是岛上最僻静的地方，一里内再无其他人家。
还有一间石屋藏在山谷的尽头，屋前小桥流水，非常幽雅。万里入无径，千
峰掩一篱。屋前的小窗，因为山势颇高，恰好还能看到一小截洞庭湖的湖水。
洞庭湖潮水涨退的声音，隐隐可闻。
LONG);

  set("outdoors", "/d/nujiao");
  set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"xiaolu",
  "south" : __DIR__"xiaowu",
]));
  setup();
  replace_program(ROOM);
}

