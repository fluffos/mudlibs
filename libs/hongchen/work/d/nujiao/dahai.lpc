inherit ROOM;
 
void create()
{
        set("short", "湖中");
        set("long",@LONG
你正处在洞庭湖中。你极目远望，不由被洞庭湖的美景所吸引。
LONG);   
        setup();
}
int do_check()
{
        object *obj;
        int     i;
        obj=all_inventory(this_object());
        if (!sizeof(obj))       return 1;
        for (i=0;i<sizeof(obj);i++)
                if (userp(obj[i]))      return 0;
        return 1;
}

