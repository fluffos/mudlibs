#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR"红冠鹦鹉"NOR, ({ "hongguan yingwu","yingwu" }) );
        set("race","野兽");
        set("gender","雄性");
        set("age",2);
        set("long","这是五姑非常宠爱的小鹦鹉。不知道为什么跑到了这里来。\n");
        set("attitude","friendly");
        set("max_kee",200);

        set("chat_chance", 8);
        set("chat_msg",({
                "红冠鹦鹉扑哧扑哧地伸展了下小翅膀。\n",
                "红冠鹦鹉突然叫道：五姑！快来，咱们来个花间一壶酒。\n",
                "红冠鹦鹉突然叫道：御剑乘风去！\n",
                "红冠鹦鹉突然叫道：化作尘与灰！\n",
        }));
        
        set("limbs",({"头部","身体","尾巴"}) );
        set("verbs","bite");
        
        setup();
}

