#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

#define DEFAULT_DAMAGE 1500

void create()
{
        set_name(HIY"轩辕剑"NOR, ({"xuanyuan jian","jian","sword"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 10);
                set("material", "icon");
                set("no_drop",1);
                set("no_get",1);
                set("wield_msg", "寒光一闪，$N抽出一把$n横在手中。\n");
        }
        init_sword(DEFAULT_DAMAGE);
        setup();
}

void change_damage()
{
        int damage;
        object owner;
        
        remove_call_out("change_damage");

        if ( !(owner = environment()) )
                return;
        
        if ( query("equipped") ){
                damage = query("weapon_prop/damage");
                
                if ( !damage )
                        damage = DEFAULT_DAMAGE;

                damage += 10;
                
                if ( damage > DEFAULT_DAMAGE + DEFAULT_DAMAGE / 2 ){
                        message_vision(HIB"渐渐地，"HIY"轩辕剑"HIB"周身的剑气消散地无影无踪。\n"NOR,owner);
                        damage = DEFAULT_DAMAGE;
                }else{
                        if ( random(30) == 0 ){
                                message_vision( HIR"你一阵寒意，只见$N手中的"HIY"轩辕剑"HIR"身涌现一阵血光,弥散到四处，顿时，剑气纵横！\n"NOR,owner);
                                damage = DEFAULT_DAMAGE + random(DEFAULT_DAMAGE/3);
                        }else{
                                if ( random(80) == 0 ){
                                message_vision( HIY"轩辕剑"HIW"幻点作一条亢龙，蜿蜒缠绕在$N的臂上，顷刻间，$N周身笼罩在一团红色的淡雾中，若隐若现！\n"NOR,owner);
                                damage = DEFAULT_DAMAGE + random(DEFAULT_DAMAGE*2);
                                }else{
                                        if ( random(5000) == 0 ){
                                                message_vision( HIC"\t“御剑乘风去，化作尘与灰”\n\t\t————轩辕剑仙警梦中人\n"NOR,owner);
                                                destruct(this_object());
                                        }
                                }
                        }
                }
        }
        
        set("weapon_prop/damage", damage);
        if ( owner->is_character() )
                owner->set_temp("apply/damage",damage);

        call_out("change_damage",20);   
}

void init()
{
        ::init();
        
        call_out("change_damage",20);
}

        
