
inherit ROOM;

void create()
{
        set("short", "红尘大酒店");
        set("long", @LONG
这里就是江湖世界最豪华的红尘大酒店，凭拿手的川菜闻名江湖，以
麻辣为主，因为看到大家练功好辛苦，多吃点辣椒既开胃健脾，又有
利于降火顺气，也不知道是什么逻辑，哎。宽敞明亮而又富丽堂皇的
大厅高朋满座，大家的奴隶---风少满头大汗的招呼着所有嘉宾.不时
 传来阵阵欢歌笑语:哇哈哈，开呀...买定离手....大..呀!
LONG);

         set("no_fight", 1);
         set("no_magic", 1);
        set("objects", ([
                __DIR__"npc/xiaoer2" : 1,
            ]));

        set("exits", ([               
                "west"   : __DIR__"chatroom",
                "up"   : __DIR__"jiulou2",
            ]));
        setup();
}

