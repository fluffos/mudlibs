 // gem man

#include <ansi.h>

inherit NPC;

//可叹，lpc居然没有指针，不知道是我没有发现还是...

int query_gem();

void create()
{
        set_name("宝石商人",({"gem man","man"}));
        set("gender","男性");
        set("age",32);
        set("combat_exp",0);
        set("attitude","friendly");
        set("per",30);
        set("inquiry",([
                "宝石" : (: query_gem :),
                "gem" : (: query_gem :),
        ]));
        
        setup();
}
/*
void swap_map(mapping &temp1,mapping &temp2)
{
        mapping temp3;
        
        temp3 = temp2;
        temp2 = temp1;
        temp1 = temp3;
}
*/

//比较排行榜
int compare_map(mapping temp1,mapping temp2)
{
        return ( temp1["number"] - temp2["number"] );
}

//如果是同一个id
int same_id(mapping temp1,mapping temp2)
{
        return ( temp1["id"] == temp2["id"] );
}

int query_gem()
{
        object me;
        int gem_num;
        mapping max1,max2,max3,max4,temp;
        string str = "";
        int compare_number = 3 ;
        
        me = this_player();
        
        gem_num = me->query("gem");
        
        if ( gem_num <= 0 ){
                message_vision("$N笑呵呵地对$n说道：虽说你一个都没有，但是我还是会告诉你。你的宝石数为0个。\n",this_object(),me);
                me->delete("gem");
                return 1;
        }
        
        message_vision(sprintf("$N笑呵呵地对$n说道：你的宝石数为%d个。\n",gem_num),this_object(),me);
        
        max1 = ENV_D->query("gem_no1");
        max2 = ENV_D->query("gem_no2");
        max3 = ENV_D->query("gem_no3");
        max4 = ([
                "number" : gem_num ,
                "title"  : me->short(),
                "id"     : me->query("id"),
        ]);
        
        //初始化参数
        if ( !max1 )
                max1 = ([
                        "number" : 0 ,
                        "title"  : "无名氏",
                        "id"     : 0 ,
                ]);

        if ( !max2 )
                max2 = ([
                        "number" : 0 ,
                        "title"  : "无名氏",
                        "id"     : 0 ,
                ]);

        if ( !max3 )
                max3 = ([
                        "number" : 0 ,
                        "title"  : "无名氏",
                        "id"     : 0 ,
                ]);

        if ( same_id(max1,max4) ) // 如果待选者与榜上某人相同，则交换待选者与榜上者数据
                { temp=max1;max1=max4;max4=temp;str += "$N从袖中取出一卷丝帛，瞧了瞧，双手一拱，笑道：恭喜恭喜，$n榜上有名。\n\n";}
        else if ( same_id(max2,max4) )
                { temp=max2;max2=max4;max4=temp;str += "$N从袖中取出一卷丝帛，瞧了瞧，双手一拱，笑道：恭喜恭喜，$n榜上有名。\n\n";}
        else if ( same_id(max3,max4) )
                { temp=max3;max3=max4;max4=temp;str += "$N从袖中取出一卷丝帛，瞧了瞧，双手一拱，笑道：恭喜恭喜，$n榜上有名。\n\n";}
        else if ( compare_map(max4,max3) > 0 )
                { temp=max3;max3=max4;max4=temp;str += "$N从袖中取出一卷丝帛，瞧了瞧，双手一拱，笑道：恭喜恭喜，$n榜上有名。\n\n";}
        else
                str += "$N从袖中取出一卷丝帛，瞧了瞧，说道：\n\n";
        
        message_vision(str,this_object(),me);
        
        // 对max1,max2,max3进行排序
        if ( compare_map(max3,max2) > 0 )
                { temp=max3;max3=max2;max2=temp;}
        if ( compare_map(max2,max1) > 0 )
                { temp=max1;max1=max2;max2=temp;}
        if ( compare_map(max3,max2) > 0 )
                { temp=max3;max3=max2;max2=temp;}
        
        ENV_D->set("gem_no1",max1);
        ENV_D->set("gem_no2",max2);
        ENV_D->set("gem_no3",max3);
        
        str = HIR"红尘"HIY"宝石排行榜：\n"NOR;
        str += HIY"------------------------------------------------------\n"NOR;
        str += "第一名：  " + max1["title"] + "\n";
        str += "第二名：  " + max2["title"] + "\n";
        str += "第三名：  " + max3["title"] + "\n";
        str += HIY"------------------------------------------------------\n"NOR;

        tell_object(me,str);
        
        return 1;
}
