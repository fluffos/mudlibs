#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"魔法师"NOR, ({ "mofa shizhe", "mofa" }) );
          set("nickname", HIY"清神"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是红尘的清神魔法师，你可以ask mofa about 清神。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "清神" : (: ask_me :)
        ]));
        setup();
}

void die()
{
        message_vision("抱歉，我是不会死的。\n",this_object());
          return ;
}


string ask_me()
 {
        object me = this_player();

               if ((int) me->query("money")< 1000000)
                  return "你的钱庄存款不够！";
               else
        {
               me->set("shen", 0);
                      me->add("money",- 1000000);
   me->start_busy(3);
        tell_object(this_player(),HIW "已经从你的银行帐户扣除100gold！\n"NOR);
                return "天神啊！让这个心灵受伤害的人重生吧！\n"
HIW"突然天空中一道"HIY"金光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}

