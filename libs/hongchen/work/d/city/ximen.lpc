// Room: /city/ximen.c
// YZC 1995/12/04 
inherit ROOM;
string look_gaoshi();
void create()
{
    set("short", "西门");
    set("long", @LONG
	这是西城门，几年前曾经遭到土匪的攻打，因此显得有些破败。城门正上
方勉勉强强可以认出“西门”两个大字，城墙上贴着几张通缉告示(gaoshi)。
这里是罪犯逃往西域的必经之地，官兵们戒备森严，动不动就截住行人盘问。一条
笔直的青石板大道向东西两边延伸。西边是郊外，骑马的、座轿的、走路的，行人
匆匆。东边是城里。
LONG
    );
    set("outdoors", "city");
    set("item_desc", ([
	"gaoshi" : (: look_gaoshi :),
      ]));
    set("exits", ([
	"east" : __DIR__"xidajie2",
	"west"  : __DIR__"ximenroad",
	"south" : "/d/city/diaoyuchi2",
	"north" : "/d/taohuacun/taohua1",
      ]));
    set("objects", ([
	__DIR__"npc/wujiang" : 1,
	__DIR__"npc/bing" : 2,
	"/d/mingjiao/npc/fenggongying" : 1,
      ]));
    setup();
}

void init()
{
    add_action("do_ansuan","ansuan");
}

int do_ansuan(string arg)
{
    string para_ob, para_dir;
    object me = this_player();

    if(!arg || sscanf(arg,"%s at %s",para_ob, para_dir) != 2) 
	return 0;
    if(para_dir != "south") return 0;

    //对暗算钓鱼的要处理
    tell_room(environment(me),HIY+me->name()+"忽起歹意，想下手暗算他人，却被一道金光霹中！",({me}));
    write("你因为害人，就要倒霉了！\n");
    me->die();

    return 1;
}

string look_gaoshi()
{
    return FINGER_D->get_killer() + "\n扬州知府\n程药发\n";
}
//  #include "/d/city/include/east.h"
int valid_leave(object me, string dir)
{
    if (!userp(me))         return ::valid_leave(me, dir);
    if( me->query_condition("killer") && dir == "south" )
            return notify_fail("你被通缉耶！进去的话会引起"+HIR"恐慌"NOR+"的，还是算了吧！:)\n");
    return 1;
}
