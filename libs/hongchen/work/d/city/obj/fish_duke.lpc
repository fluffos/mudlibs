//fish_duke.c

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("红鳟鱼", ({"hongzun","fish"}));
    set_weight(200);
    if (clonep())
	set_default_object(__FILE__);
    else {
	set("long", "漂漂亮亮的一条红鳟鱼，味道鲜美。\n");
	set("unit", "条");
	set("value", 100);
	set("food_remaining", 5);
	set("food_supply", 25);
    }
}

