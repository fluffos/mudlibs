inherit ROOM;
void create()
{
    set("short","空屋子");
    set("long","\n");
    set("valid_startroom",1);
    set("no_sleep",1);
    set("exits", ([
	"south": "/u/ahxia/workroom",
      ]) );
    setup();
}

void init()
{
    object me = this_player();
    me->save();
    tell_object(me,"既然已经来了，就不要走哦。（自动保存，下次还在这里出来... snicker）\n");
    add_action("do_banned_cmds",({"conjure","exercise","yun","exert","dazuo","lian",}) );
    add_action("do_banned_cmds",({"sleep","eat","drink","chat","new","es","rumor",}) );
    add_action("do_banned_cmds",({"use", "home", }) );
}

int do_banned_cmds(object me,string arg)
{
    write("笨哦，不许做！\n");
    return 1;
}

int valid_leave(object me, string dir)
{
    if (!wizardp(me)
    )
	return notify_fail("笨哦，不许做！\n");
    return ::valid_leave(me, dir);
}
