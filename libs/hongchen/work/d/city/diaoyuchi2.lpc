inherit ROOM;
#include "/d/city/diaoyuchi.h"

void create()
{
    set("short", "钓鱼池");
    set("long", @LONG
这里是一个水池，旁边有不少的人正在垂钓，哇！你身边的老哥
居然钓上来一条二十斤重的大鲤鱼啊。还发什么呆啊，你旁边还放着
几根钓鱼杆，快点钓(fish)吧。钓得好有奖励的哦。
LONG
    );
    set("drop_dest",1);
    set("exits", ([
	"north" : "/d/city/ximen.lpc",
      ]));
    setup();
}
