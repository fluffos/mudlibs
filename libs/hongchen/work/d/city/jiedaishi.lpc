inherit ROOM;

void create()
{
    set("short",HIR"武林大会接待室");
    set("long",
     ""HIY"这里是金碧辉煌的武林接待室,听说这里的使者只会在每月的十
五月元之夜才会出现,所以有很多武林人事纷纷拥挤在这里，等待使
者引路到武林广场里面。但见这里挂着历代武林至尊的画像。
                
                   步          扬

                   踏          名

                   武          立

                   林          万"NOR"\n");
               
        set("no_fight", "1");
        set("exits",([ /* sizeof() == 1 */
"down":"/d/city/guangchang",]));
 set("objects", ([
         "d/city/npc/biwu": 1,
]));
set("no_clean_up", 1);
 set("outdoors", "city");
 setup();
}
  void init()
{
 if (!wizardp(this_user()));add_action("discmds",({"give","get"}));
}
int discmds()
{
   tell_object(this_player(),"武林圣地,禁止私下交易\n");
return 1;}
