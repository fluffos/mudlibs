#include <ansi.h>
#include <armor.h>
inherit BOOTS;
//inherit EQUIP;
void create()
{
        set_name(HIG"腾云靴"NOR, ({ "xue", "ty", "ty xue"}) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","这是一双做工精美的靴子。\n");
                set("unit", "双");
                set("value", 0);
                set("no_transfer",1);
                set("material", "cloth");
                set("armor_type", "feet");
                set("armor_prop/armor",10);
                set("armor_prop/dodge", 10);

        }
}
