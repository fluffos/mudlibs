// /d/newbie/zlang1.c 走廊一
// by swordman 2001/3/26

inherit ROOM;

void create()
{
set("short",HIW"校场走廊一");
        set("long",
"这是新手校场的走廊，地上铺着朴素的青面砖，
新人们在这里来往穿梭。往南是"HIW"白驼山派"NOR"的接引室，
而北面则是"HIC"峨嵋派"NOR"的接引室,接着望西过去的话，是
校场走廊二，可以去别的门派的接引室。"NOR"\n"
);
        set("exits",([ 
                "west":__DIR__"zlang2",
                "east":__DIR__"gate",
                "north":__DIR__"emroom",
                "south":__DIR__"btroom" ]));
        set("no_clean_up", 0);
    set("outdoors","newbie");
    setup();
}
