#include <ansi.h>
inherit NPC;
void create()
{
        set_name("新手卫士" , ({ "guard" }) );
         set("gender","男性");
        set("age",30);
        set("max_jingli", 100000);
        set("max_neili", 100000);
        set("max_jing", 100000);
        set("jing", 100000);
        set("qi", 500000);
        set("max_qi", 500000);
        set("neili",10000000);
         set("jiali",1000);
        set("str", 530);
        set("con", 30);
        set("int", 30);
        set("kar", 30);
        set("per", 28);
        set("dex", 530);

        set("combat_exp", 300000000);

        set_skill("sword", 5550);
        set_skill("parry", 5550);
        set_skill("taiji-jian", 5550);
        set_skill("taiji-shengong", 5550);
        set_skill("dodge", 5550);
        set_skill("tiyunzong", 5550);
        set_skill("taoism", 1550);
        set_skill("force", 1550);
        map_skill("sword","taiji-jian");
        map_skill("dodge","tiyunzong");
        map_skill("force","huagong-dafa");
        set("long","他是守护新手校场的护卫，脸色凝重，似乎内功修为已有不小成就,
他身着轻装，轻功修为想必也已到平步青云之境。\n"
           );
        set("chat_chance", 200);
        set("chat_msg_combat",({
            "新手卫士喝道：大伙上啊!不要让这恶贼跑了!\n", 
        }) );
        setup();
        carry_object(__DIR__"obj/bsword.lpc")->wield();
        carry_object(__DIR__"obj/cloth.lpc")->wear();
        carry_object(__DIR__"obj/boots.lpc")->wear();
}
