// bsword.c 碧灵剑
// by Swordman 2000/1/17/
// /u/swordman/bird/npc/obj/bsword.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        set_name( HIC "碧灵剑"NOR,({ "bl jian", "bl", "sword", "jian" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 100000);
                set("treasure",1);
                set("material", "steel");
                set("long", "这是把轻巧的宝剑，剑身上隐隐的透出碧玉之光，当真锋利无比。\n");
                set("wield_msg", HIC "只听见「嗡」地一声，$N腰间下的$n飞出剑鞘，落入$N手中。\n" NOR);
                set("unwield_msg", HIC "碧灵剑幻作一道清光，「唰」地飞入剑鞘。\n" NOR);
                set("unequip_msg", HIC "碧灵剑幻作一道清光，「唰」地飞入剑鞘。\n" NOR);
        }
init_sword(300);
        setup();
}
