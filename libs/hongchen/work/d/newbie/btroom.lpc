inherit ROOM;

void create()
{
set("short",HIG"白驼接引室");
        set("long",
"这是新手校场的白驼接引室,白驼派的接引使者专
门在这里接待打算进入白驼的新人们。同时传授他们一些
入门的功夫，让他们可以尽快的溶入门派之中。所以
在这里，您可以放心的学习一些基础武功。\n"
);
        set("exits",([ 
                "north":__DIR__"zlang1",
                "west":__DIR__"hsroom" ]));
        set("no_clean_up", 0);
    set("objects", ([
                __DIR__"npc/btsz" : 1,
    ]));
    set("outdoors","newbie");
    setup();
    setup();
}
