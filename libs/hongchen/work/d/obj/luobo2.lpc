// ----/d/obj/xiandou.c ---- 改编　/d/obj/luobo.c
// swordman@HC/2002.8.6

inherit ITEM;
void create()
{
        set_name(HIR"花心大萝卜"NOR, ({ "luo bo" , "bo" , "luo", }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一根"+HIY+"又粗"+NOR+"，"+HIR+"又大"+NOR+"的"+HIW+"萝卜"+NOR+"。是风少的独门栽培法种出来的，吃一根，可以撑死你。\n");
                set("unit", "根");
                set("value",0);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
  int food,water;
    food = me->query("food");
    water = me->query("water");
    
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

   if(water < (int)me->max_water_capacity() * 5 && water < 5000) me->add("water", 100200);
    else me->add("water",(int)me->max_water_capacity() / 1000);
     
     if(food < (int)me->max_food_capacity() * 5 && food < 5000) me->add("food", 100200);
    else me->add("food",(int)me->max_food_capacity() / 1000);

    if(me->is_fighting()) me->start_busy(2);
       message_vision(HIM"$N拿起一根大萝卜，噶蹦，噶蹦的嚼了嚼，吞了下去。\n"NOR,me);
       destruct(this_object());
       return 1;
 }

