
inherit ITEM;
void create()
{
    set_name(HIG "辟水灵珠" NOR, ({"pishui zhu", "zhu"}));
    set("unit", "颗");
     set("no_give", "1");
     set("no_drop", "别乱丢呀。");
     set("no_sell", "1");
     set("no_steal", "1");
 set("value",10000);
    set("long", "一颗通体晶莹的宝珠。\n");
    set_weight(100);
}

void owner_is_killed() { destruct(this_object()); }
