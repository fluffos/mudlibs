// bishui-zhu.c

#include <ansi.h>

inherit MONEY;

void create()
{
        set_name(HIG "辟水灵珠" NOR, ({"pishui zhu", "zhu"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("no_sell",1);
                set("no_drop",1);
                set("no_steal",1);
                set("long", "一颗通体晶莹的宝珠。\n");
                set("unit", "颗");
                set("value", 50000);
                set("base_unit", "颗");
		set("base_weight", 6);
                set("no_give",1);
	}
	set_amount(1);
}

void owner_is_killed() { destruct(this_object()); }

