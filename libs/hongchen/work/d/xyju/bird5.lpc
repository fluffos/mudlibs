#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIR"绝世峭壁"NOR);

 set("long",@LONG
你又往上爬了不少了距离, 你看了看四周, 你发现
你已经在云层之上了, 温暖的阳光, 往你身上直扑过来,
清新的空气, 让你所有的压力获得释放, 你不禁羡慕起
住在这峭壁上的人。

LONG
    );
 
 set("exits",(["up":__DIR__"bird6",
               "down":__DIR__"bird4",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 setup();
 replace_program(ROOM);
}           
