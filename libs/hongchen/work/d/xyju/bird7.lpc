#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIR"绝世峭壁"NOR);

 set("long",@LONG
你终于到达峭壁之上了, 你看了看四周, 并不是你
想像中的那样草木茂盛, 反而有点荒凉, 就在你失望之
际, 你听到在东边有人练武的声音, 你思考到底会是谁
呢?  

LONG
    );
 
 set("exits",(["east":__DIR__"bird8",
               "down":__DIR__"bird6",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 setup();
 replace_program(ROOM);
}           
