#include <ansi.h>
inherit NPC;
void create()
{
       set_name("食骨巨虫",({"eat bone bug","bug"}));
        set("level",12);
        set("race", "野兽");
        set("age", 300);
        set("long", "这是非常大的虫，它最喜欢吃骨头。\n");
        set("limbs", ({ "头部", "身体", "尾部"}) );
        set("verbs", ({ "bite"}) );
        setup();
}
