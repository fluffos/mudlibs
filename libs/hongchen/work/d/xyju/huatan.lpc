// /d/xyju/huatan.c
#include <ansi.h>
inherit ITEM;
int do_zhai();
void init()
{
        add_action("do_zhai","zhai");
}
void create()
{
 set("short",HIG"花坛"NOR);
 set_name(HIG"花坛", ({ "hua tan", "tan"}));
 set("unit", "块");
 set("long",""HIG"好大的一座花坛，"HIY"五"HIM"彩"HIW"缤"HIR"纷"NOR""HIG"的花朵在你眼前争香抖艳，你不禁想"HIC"摘(zhai)"NOR""HIG"一朵来看看。"NOR" \n"
);
 set("value", 34530);
 set("no_get","这个是供人观赏的，你能搬的走么？");
}

int do_zhai()
{
    object me,tan,new_ob;
    me=this_player();
    tan=this_object();
    if( (int)me->query("per") < 20 )
        return notify_fail("花丛里的蜜蜂过多，使得你无法下手。\n");
    message_vision(HIC "$N看中了其中一朵伸手摘去。\n" NOR, me);
    me->add("qi",-1);
    switch(random(5) ) {
        case 0:
            new_ob=new("/d/xyju/obj/chahua",1);
            new_ob->move(me);           
            message_vision(HIC "你从中摘了一朵"NOR+HIR"“抓破美人脸”。\n" NOR, me );
            destruct(tan);
            break;
        case 1:
            new_ob=new("/d/xyju/obj/chahua1",1);
            new_ob->move(me);           
            message_vision(HIC "你从中摘下了一朵"NOR+HIY"“十八学士”。\n" NOR, me );
            destruct(tan);
            break;
        case 2:
            new_ob=new("/d/xyju/obj/chahua2",1);
            new_ob->move(me);           
            message_vision(HIC "你从花丛里摘了朵"NOR+HIM"“八仙过海”。\n" NOR, me );
            destruct(tan);    
            break;
        case 3:
            new_ob=new("/d/xyju/obj/chahua3",1);
            new_ob->move(me);           
            message_vision(HIC "你从花丛里摘了朵"NOR+HIW"“落第秀才”。\n" NOR, me );
            destruct(tan);    
            break;
        case 4:
            new_ob=new("/d/xyju/obj/chahua4",1);
            new_ob->move(me);           
            message_vision(HIC "你从花丛摘下了朵"NOR+HIR"“红装素裹”。\n" NOR, me );
            destruct(tan);    
            break;
        default:
            message_vision(HIM "你被花上的刺扎了一下，疼痛使你收回了手。\n" NOR, me );
            destruct(tan);    
    }
    return 1;
}

