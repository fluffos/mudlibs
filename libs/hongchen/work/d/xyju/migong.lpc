// Room: /d/shaolin/zhulin.c

//inherit VRM_SERVER;
inherit "/adm/daemons/vrm_server";

void create()
{
	set_inherit_room( ROOM );

	set_maze_npcs(__DIR__"npc/bug");

	set_maze_long(20);

	set_entry_dir("east");

	set_link_entry_dir("east");

	set_link_entry_room(__DIR__"bird0");

	set_link_exit_dir("west");

	set_link_exit_room(__DIR__"en8");

	set_entry_short("山脚小路");

	set_entry_desc(@LONG
你来到一处高山之下，千心万苦终于走出了东北泽
林,暗自庆幸的同时，前面不远的山脚引起了你的注
意，你不禁想过去仔细看看。
LONG
);

	set_exit_short("泽林小径");

	set_exit_desc(@LONG
你现在来到东北泽林的深处, 这附近没有什么东西, 
只有两旁的树丛, 和路上的几根小草, 前方看起来沼气
很重, 可能快到沼泽地带了, 这条路一直往东方延伸下
去。
LONG
);

	set_maze_room_short("泽林深处");

	set_maze_room_desc(@LONG
你现在来到泽林深处的沼泽部份, 这里的沼气臭气冲
天, 令人难以忍受, 你觉得你头昏眼花, 方向感全失, 在
这泥泞这沼泽里, 你只能凭直觉走出了。
LONG
);

	set_outdoors(1);
}
