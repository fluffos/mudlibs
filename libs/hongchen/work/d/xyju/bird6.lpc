#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIR"绝世峭壁"NOR);

 set("long",@LONG
你又爬了好一段时间, 你头上的汗水已经如下雨般
的流下, 你抬起头来往上望了望, 终于看到顶了!!
你心中不由的高兴万分, 因为你的努力终于有了代
价, 于是你加快脚步, 往上爬去。

LONG
    );
 
 set("exits",(["up":__DIR__"bird7",
               "down":__DIR__"bird5",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 setup();
 replace_program(ROOM);
}           
