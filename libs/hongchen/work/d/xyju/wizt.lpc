// /d/xyju/wizt.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIC"闲逸居"HIY"wiz殿堂"NOR);

 set("long",@LONG
这里是“红尘”wiz们的专署殿堂，他们创造了这
个世界，一直默默无闻，也许他们也有过错的地方，
但，老话不是说“人非圣贤，孰能无过”嘛，这里
陈列着的，都是他们的雕象，用来让人们参观的，
四周都是漂亮的印花壁纸，顶上一个大的琉璃灯，
使得整间屋子如白昼一般。

LONG
    );
 
    set("objects", ([
        "/d/xyju/npc/poi" : 1,
        "/d/xyju/npc/lwt" : 1,
      ]));
 set("exits",(["north":__DIR__"wizt1",
        "east":__DIR__"wizjl",
            ]));
 set("outdoors","xyju");
        set("no_fight", "1");
 set("no_clean_up", 0);
 set("light",1);
 setup();
 replace_program(ROOM);
}           
