#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short","石头路");

 set("long",@LONG
这是一条用上好花岗岩铺筑的路, 非常塌实稳固,使
人不禁要惊叹，如何才能将这如此沉重的岩石搬上山来。
你收敛了一下心神，抬头向前方望去，已经可以隐约看
到了【闲逸居】的正门了, 原来刚听到在讨论的声音是
从这里传出来的。

LONG
    );
 
 set("exits",(["east":__DIR__"bird13",
               "west":__DIR__"bird11",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 setup();
 replace_program(ROOM);
}           
