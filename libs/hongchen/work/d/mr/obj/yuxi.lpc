 // yuxi.c 玉玺

#include <armor.h>
#include <ansi.h>

inherit NECK;

void create()
{
        set_name(HIC "玉玺" NOR, ({ "yu xi", "yu" }));
        set("long", "\n这是一块玉玺，莹滑温润，光洁无瑕，真是稀世罕有。\n"+
         "上面刻着:大燕。\n");
	set("weight", 300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("value", 50000);
		set("material", "玉");
		set("armor_prop/armor", 2);
		set("female_only", 1);
	}
	setup();
}	
