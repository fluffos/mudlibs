// jujing-dan.c 聚精丹
#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("聚精丹", ({"jujing dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", ""RED"这是一颗火红色的聚精丹，相传聚集了铁掌帮数代帮主的精力而炼制出来的。"NOR"\n");
                set("value", 500000);
        }
  setup();
}

int do_eat(string arg)
{
        int taoism_limit, jingli_limit, taoism_skill, add_skill, improve;

        object me = this_player();

        taoism_limit = me->query_skill("taoism")*10;
        jingli_limit = me->query("max_jingli");
        taoism_skill = me->query_skill("taoism", 1);
        
        if (!id(arg))
        return notify_fail("你要吃什么？\n");


        if ( (int)me->query_condition("jujingdan_drug" ) > 0 )
        {
                me->add("max_jingli", -10);
                message_vision( ""HIR"$N又吃下一颗聚精丹，只觉全身的精力源源不断的向外泄露，原来是服食太急太多，药效适得其反！"NOR"\n" , me); 
        }
        else if ( jingli_limit <= taoism_limit  )
   {
/*              improve = taoism_limit - jingli_limit;

                if ( improve < 100 ) { 
                        add_skill = taoism_skill + (100 - improve)/5 + 1;
                        me->set_skill("taoism", add_skill );
                }
*/      
                me->add("max_jingli", 5);
                me->add("jingli", 15);

                message_vision( ""HIY"$N吃下一颗聚精丹，顿时只觉得浑身产生了无限的力量，似乎身体也快承受不了..."NOR"\n" , this_player());
                me->apply_condition("jujingdan-drug", 1000);
        }
        me->start_busy(3);
        me->unconcious();
        destruct(this_object());
        return 1;
}
