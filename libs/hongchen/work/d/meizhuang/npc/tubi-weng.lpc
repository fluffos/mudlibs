// tubi-weng.c
inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
        set_name("秃笔翁", ({ "tubi weng", "weng" }));
        set("title",RED "梅庄三庄主" NOR);
        set("long",
                "他就是梅庄四位庄主排行第三的秃笔翁。\n"
                "身穿一件干干净净的白色长袍。\n"
                "他已年愈五旬，身材矮小，顶上光光, 一看就知道是个极易动怒的人。\n");
        set("gender", "男性");
        set("age", 56);
        set("class", "scholar");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 4000);
        set("jiali", 50);
        set("combat_exp", 18000000);
        set("shen", 15000);
        set("score", 60000);

        map_skill("parry", "shigu-bifa");
        map_skill("dagger", "shigu-bifa");
        map_skill("dodge", "piaoyibu");
        map_skill("force", "wuzheng-xinfa");

        create_family("梅庄", 1, "庄主");

        set("inquiry", ([
                "书法" : (: ask_me :),
        ]));
    set("bi_count", 1);
        set_skill("force", 600);
        set_skill("wuzheng-xinfa", 520);
        set_skill("dodge", 600);
        set_skill("piaoyibu", 510);
        set_skill("parry", 620);
        set_skill("dagger", 620);
        set_skill("shigu-bifa", 600);
        set_skill("literate", 230);

        setup();
        carry_object("/d/meizhuang/npc/obj/panguan-bi")->wield();

}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("shen") < 1000) {
                command("say 我梅庄虽然不是什么名门正派, 但择徒也极为严格。");
                command("say 在品行方面，" + RANK_D->query_respect(ob) +
                        "是否还做得不够？");
                return;
        }
        command("say 好吧，在下就收下你了。");
        command("recruit " + ob->query("id"));
}

string ask_me()
{
        mapping fam;
        object ob;

        if (!(fam = this_player()->query("family")) || fam["family_name"] != "梅庄")
                return RANK_D->query_respect(this_player()) +
                "与本派素无来往，不知此话从何谈起？";
        if (query("bi_count") < 1)
                return "你来晚了，铁笔不在此处。";
        add("bi_count", -1);
           ob= new("/d/meizhuang/npc/obj/panguan-bi");
        ob->move(this_player());
        return "好吧，这把铁笔就交给你保管了。";
}

