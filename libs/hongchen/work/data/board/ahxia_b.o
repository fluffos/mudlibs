   \"last_exec\": int last_exec,       \"next_exec\": int next_exec,       \"start_time\":int start_time,       \"start_date\":int start_date,       \"start_day\": int start_day,    ]),    ... ])  ÔÚ ./cron/ ·ÅĞèÒª×Ô¶¯¼ÓÔØµÄÎÄ¼ş. Ã¿¸öÎÄ¼şº¬²¿·ÖÈçÏÂÌØ¶¨º¯Êı: int query_cron_interval() ·µ»Øºô½Ğ¼ä¸ô string query_cron_desc() ÃèÊö int *query_cron_start_day() ĞÇÆÚ¼¸¿ªÊ¼ ¸ñÊ½ 0..7 (0 = 7 = ĞÇÆÚÈÕ) int *query_cron_start_time() Ò»ÌìÖĞµÄ¿ªÊ¼Ê±¼ä ¸ñÊ½Îª 0..23+0..59 int *query_cron_start_date() ¿ªÊ¼ÈÕÆÚ ¸ñÊ½Îª 0..31 //monthÇé¿ö²»¿¼ÂÇ  string query_cron_status() ÊÇ·ñ½øĞĞcronµ÷ÓÃ enabled, executing, sleep, frozen int cron_main() Ö÷º¯Êı, ÆäËûºÍÆÕÍ¨ÃüÁîÒ»Ñù. int ºÄ·Ñ»úÊ±µÄ³ÌĞò... -> make list, deal 20 items per callout// wingsËµ£º    ÎÒ´ó¸ÅµØ¿´ÁËÒ»ÏÂÄãĞ´µÄcrond.cºÍcrond2.c£¬·¢ÏÖÓĞÒ»Ğ©ÎÊÌâ£º    µÚÒ»£¬Äã²ÉÓÃµÄÊÇÃ¿Ò»¸öÈÎÎñ¶¼µ÷ÓÃÒ»¸öcall_out£¬ÕâÑùµÄ×ö·¨²»ºÃ£¬  ¼ÙÈôÎÒÏëÒ»¸ötask²»ÊÇ°´ÕÕÊ±¼ä¼ä¸ôÀ´Ö´ĞĞ¾ÍÃ»ÓĞ°ì·¨ÁË£¬ÀıÈç±¸·İÈÎÎñ  ÒªÇóÔÚÃ¿Ò»ÌìµÄ2£º00½øĞĞ£¬È»¶øÈç¹ûÓÃintervalÃ÷ÏÔ¾Í·Ç³£²»ºÏÀí¡£ÎÒ  ÈÏÎªÊÊÒËµÄ×ö·¨ÊÇ°´ÕÕlinuxÉÏµÄcronµÄ·½Ê½£¬Èç¹ûÃ»ÓĞlinuxÓÃNTÏÂ  µÄatµÄ×ö·¨Ò²²»´í¡£´ó¸ÅµÄË¼Â·ÊÇcrond.cÃ¿Ãëµ÷ÓÃÒ»ÏÂÖ÷´¦Àíº¯Êı£¬À´  ÅĞ¶ÏÔÚÁĞ±íÖĞµÄÈÎÎñÊÇ·ñµ½´ïÁËÖ´ĞĞÊ±¼ä£¬Èç¹ûÃ»µ½´ï£¬¼ÌĞøË¯Ãß£¬µ½´ï  ÁËÔò¿ªÊ¼Ö´ĞĞ¡£ÓÃcall_out»òÕßheart_beatËæÄãµÄ±ã£¬¿¼ÂÇµ½call_out  ÓĞÒ»¶¨µÄÎó²î£¬½¨Òé²ÉÓÃheart_beat,²»¹ıÒ²Ã»¶à´óµÄÎó²î¿© :))     µÚ¶ş£¬ÔÚÄãµÄÈÎÎñÁĞ±íÀïÃæµÄĞÅÏ¢Ò²Ì«¼òµ¥ÁË°É¡£ÎÒÈÏÎªÀïÃæµÄĞÅÏ¢Ó¦  ¸Ã°üÀ¨£ºÉÏ´ÎÖ´ĞĞÊ±¼ä(last_exec),ÏÂ´ÎÖ´ĞĞÊ±¼ä(next_exec)£¬ÈÎÎñĞÅ  Ï¢(describe),µ±Ç°×´Ì¬(state£¬°üÀ¨excute,sleep,freeze),Èç¹ûÄã¾õ  µØ»¹ĞèÒªÊ²Ã´ĞÅÏ¢£¬¾¡¹Ü¼ÓÉÏÈ¥¡£ÖÁÓÚcronÄ¿Â¼µ×ÏÂµÄÈÎÎñ×°ÔØµ½listÖĞ  µÄÊ±¼ä£¬ÎÒÈÏÎªÔÚcreateµÄÊ±ºò±È½ÏºÃ¡£Äã¿ÉÒÔ¶¨Ò»¸öload_taskº¯ÊıÍâ  ¼ÓÉÏreload_taskµÈµÈ£¬Èç¹ûÒª¹¦ÄÜÈ«£¬µ±È»»¹°üÀ¨add_task,remove_task,  refresh_task,query_taskµÈµÈ¿©¡£      µÚÈı£¬×îºÃÄÜÓĞÒ»¸ölogÎÄ¼ş¡£¡£¡£*/#include <ansi.h>inherit F_DBASE;#define _DEBUG#ifdef _DEBUG#define DEBUG(X) CHANNEL_D->do_channel(this_object(), \"debug\", X );#else#define DEBUG(X)#endif#define CRON_PATH \"/u/ahxia/daemons/cron/\"#define SYS(X) CHANNEL_D->do_channel(this_object(), \"sys\", X );#define SYSMSG(X) message(\"system\", X, users());private static mapping cron_tab;mixed query_cron_files();private int init_cron_tab();private void _main_cron_loop();private int _evoke_cron_main(string fname);int set_interval(string f, int intv);int set_enabled(string f, int ena);void create(){    seteuid( ROOT_UID );    set(\"channel_id\", \"×Ô¶¯µ÷ÓÃ(Crond)\");    init_cron_tab();    callout(\"_main_cron_loop\",1);    SYS(\"crond created ...\");    return;}private int init_cron_tab(){    int i, intv, *start_day, *strat_time, *start_date;    string desc, status;    string *tmp_files = get_dir(CRON_PATH+\"*.c\");    object ob;    cron_tab = ([]);    for ( i = 0; i < sizeof(tmp_files) ; i++ ) {        tmp_files[i] = CRON_PATH+tmp_files[i];        //ÇåÀíÒÑ¾­´æÔÚµÄÎÄ¼şobject        if(ob = find_object(tmp_files[i]))            destruct(ob);        if (file_size(tmp_files[i]) > 0) {            intv = tmp_files[i]->query_cron_interval();            status = tmp_files[i]->query_cron_status();            start_time = tmp_files[i]->query_cron_start_time();            start_date = tmp_files[i]->query_cron_start_date();            start_day = tmp_files[i]->query_cron_start_day();            cron_tab += ([ tmp_files[i]:                ([                \"interval\": intv,                \"status\": status£¬     // enabled, executing, sleep, frozen                \"last_exec\": last_exec,                \"next_exec\": next_exec,                \"start_time\":start_time,                \"start_date\": start_date,                \"start_day\": start_day,                ]),            ]);        }else            DEBUG(\"init_cron_tab(), file [\" + tmp_files[i] + \"] does not exists!\");    } //end for    return i;}mixed query_cron_files(){    return keys(cron_tab);}private void _main_cron_loop(){    int i, intv, *start_day, *start_time, *start_date;    string status;    string *key = keys(cron_tab);    remove_callout(\"_main_cron_loop\");    for ( i = 0; i < sizeof(key); i++ ) {        interval = cron_tab[key[i]];        ena = cron_tab[key[i]][1];        if (ena) {            call_out(\"_evoke_cron_main\", 1, key[i]);        }     } //end for    call_out(\"_main_cron_loop\", 1);    return;}private int _evoke_cron_main(string fname){    DEBUG(\"_evoke_cron_main(), calling \"+fname+\".cron_main().\");    call_other(fname, \"cron_main\");}int set_interval(string f, int intv){    if (intp(intv) && stringp(f)) {        return cron_tab[f][0] = intv;    }else        return 0;}// ÓĞÓÃÂğ£¿²»Çå³ş :(int set_enabled(string f, int ena){    if (intp(ena) && stringp(f)) {        return cron_tab[f][1] = ena;    }else        return 0;}","title":"2nd crond, unfinished","ip":"218.62.70.253:5555",]),(["author":"Ahxia(ahxia)","time":1036729324,"msg":"Äã¸Ä wizard_room ÁËÂğ? ÔõÃ´Àï±ßµÄ board Ã»ÓĞÁËÄØ?","title":"to jingx","ip":"61.139.165.70:5555",]),(["author":"°®·³(ivan)","time":1036760673,"msg":"ÔõÃ´¹ıÈ¥ÄÇÀïÃ»ÓĞBOARDÁË¡£","title":"...","ip":"211.151.89.16:5555",]),(["author":"Ahxia(ahxia)","time":1036808222,"msg":"i just wanna buy a web cam.","title":"hoho... go shopping","ip":"218.62.70.253:5555",]),(["author":"Çç·ç(swordman)","time":1036941397,"msg":"¸üĞÂÊ±¼äËÆºõÓĞÎÊÌâ°¡µ±Ç°Ê±¼ä£ºSun Nov 10 23:14:23 2002£¬¹²ÓĞÍæ¼Ò 96 ¸ö×ÜÊÇÍÆ³ÙÁËÒ»µã¡£ÎÒÏÖÔÚÕâÀïµÄÊ±¼äÊÇ23:42[2;37;0m","title":"to ahxia","ip":"61.183.180.134:5555",]),(["author":"Ahxia(ahxia)","time":1036967689,"msg":"// html.c - builds a /users.html file to show online users info.inherit F_CLEAN_UP;#include <ansi.h>int help(object me);void create(){  seteuid(getuid());}int build_html();string ansi2html(string arg);int main(object me,string arg){    string status;    status = wizhood(me);    if( me!=this_player(1) ||wiz_level(me) <wiz_level(status) )	return notify_fail(\"ÄãÃ»ÓĞÈ¨Á¦Ê¹ÓÃÕâ¸öÖ¸Áî¡£\\n\");    if(arg)	return help(me);    return build_html();}//modified version of short(), ported from /feature/name.cstring short_without_id(object me){    mapping party;    string nick, title, party_title, str, degree;//    str = sprintf(\"%s(%s)\", me->query(\"name\"), capitalize(me->query(\"id\")));////    if( stringp(nick = me->query(\"nickname\")) )//	str = sprintf(\"¡¸%s¡¹%s\", nick, str );    if ( stringp(nick = me->query(\"nickname\")) ) {	str = sprintf(\"¡¸%s¡¹\", nick);    }    if( stringp(title = me->query(\"title\")) )	str = sprintf(\"%s%s%s\", title,(nick?\"\":\" \"), str);    if ( mapp(party = me->query(\"party\")) ){	party_title = nullp(party[\"party_name\"]) ? \"\": party[\"party_name\"];	party_title += nullp(party[\"rank\"]) ? \"\" : party[\"rank\"];	str=sprintf(\"%s %s\", party_title, str);    }    if ( stringp(degree = me->query(\"degree\")) ) 	str = sprintf(\"%s%s%s%s%s\",degree,(party_title?\"\":\"\"),(title?\"\":\"\"),(nick?\"\":\" \"), str);    if( me->is_ghost() ) str = HIB \"(ÓÄ»ê) \" NOR + str;    if( me->query_temp(\"netdead\") ) str += HIG \" <¶ÏÏßÖĞ>\" NOR;    if( query_idle( me ) > 120 ) {	str += HIM+\" <·¢´ô\"+query_idle(me)/60+\"·ÖÖÓ>\"+NOR;    }    if( !living(me) ) str += HIR + me->query(\"disable_type\") + NOR;    return str;}string finger_info(object me){	string gender, perstr, agestr, email, selfdesc, signature, profile;	// TODO: return finger info.}int build_html(){    object *obs, *ppls;    string html, uinfo;    ppls = users();    obs = filter_array( ppls, (: environment($1) && !(wizardp($1) && $1->query(\"env/invisibility\")) :));    //obs = sort_array(obs->name(), 1);    uinfo = \"\";    foreach(object pl in obs){	uinfo += sprintf(\"<br>%s\"NOR\"%s<\\n\",RANK_D->query_rank(pl), short_without_id(pl), finger_info(pl));    }    html = @HTML<html><head><meta http-equiv=\"Content-Language\" content=\"zh-cn\"><meta http-equiv=\"Content-Type\" content=\"text/html; charset=gb2312\"><title>ºì³¾(mud.hk.hi.cn:5555)ÔÚÏßÍæ¼ÒÁĞ±í</title><!-- show detail script --><script language=\"VBScript\">function sh(id)<!--   if (id.style.display=\"none\") then   id.style.display=\"\"   else   id.style.display=\"none\"   end ifend function//--></script></head><body bgcolor=BLACK text=GREEN><p align=\"center\"><font color=\"red\"><a href=\"http://mud.hk.hi.cn\">¡îºì ³¾¡î</a> (<a href=\"telnet:mud.hk.hi.cn:5555\">mud.hk.hi.cn:5555</a>) ¡î</font></p><center><hr width=85%></center>HTML;    html += sprintf (\"<center>µ±Ç°Ê±¼ä£º%s£¬¹²ÓĞÍæ¼Ò %d ¸ö¡£</center><p>\\n\", ctime(time()), sizeof(obs));    html += ansi2html(uinfo);    html += \"\\n<center><hr width=85%></center></body></html>\";    return write_file(\"/users.html\", html, 1);}string ansi2html(string arg){    arg = replace_string(arg, \" \", \"&nbsp;\");    arg = replace_string(arg, \"<\", \"&lt;\");    arg = replace_string(arg, \">\", \"&gt;\");    arg = replace_string(arg, \"&lt;br&gt;\", \"<br>\");    arg = replace_string(arg, BOLD, \"\");    arg = replace_string(arg, BLINK, \"\");    arg = replace_string(arg, U, \"\");    arg = replace_string(arg, REV, \"\");    arg = replace_string(arg, HIREV, \"\");    arg = replace_string(arg, ESC+\"[0m\", NOR);    arg = replace_string(arg, ESC+\"[0;1;37m\", \"\");    arg = replace_string(arg, RED, \"</font><font color=\\\"#800000\\\">\");    arg = replace_string(arg, HIR, \"</font><font color=\\\"#FF0000\\\">\");    arg = replace_string(arg, GRN, \"</font><font color=\\\"#008000\\\">\");    arg = replace_string(arg, HIG, \"</font><font color=\\\"#00FF00\\\">\");    arg = replace_string(arg, YEL, \"</font><font color=\\\"#808000\\\">\");    arg = replace_string(arg, HIY, \"</font><font color=\\\"#FFFF00\\\">\");    arg = replace_string(arg, BLU, \"</font><font color=\\\"#000080\\\">\");    arg = replace_string(arg, HIB, \"</font><font color=\\\"#0000FF\\\">\");    arg = replace_string(arg, MAG, \"</font><font color=\\\"#800080\\\">\");    arg = replace_string(arg, HIM, \"</font><font color=\\\"#FF00FF\\\">\");    arg = replace_string(arg, CYN, \"</font><font color=\\\"#008080\\\">\");    arg = replace_string(arg, HIC, \"</font><font color=\\\"#00FFFF\\\">\");    arg = replace_string(arg, HIW, \"</font><font color=\\\"#FFFFFF\\\">\");    arg = replace_string(arg, WHT, \"</font><font color=\\\"#C0C0C0\\\">\");    arg = replace_string(arg, BLK, \"\");    arg = replace_string(arg, NOR, \"</font><font>\");    arg = replace_string(arg, ESC+\"[\", \"^[\");    arg = \"<font>\" + arg + \"</font>\";    return arg;}int help(object me){    write(@TEXTÉú³ÉÒ»¸öhtmlÎÄ±¾TEXT);    return 1;}","title":"html.c to be con't","ip":"218.62.70.253:5555",]),(["author":"Ahxia(ahxia)","time":1037053315,"msg":"<u onclick=sh(meihua)>ÎÄ»¨(Meihua)</u><font id=meihua style='display:none'><br>meihua....skdfa;lksdjf;asjdfaskjdf<br></font>","title":"ho.","ip":"218.62.70.253:5555",]),(["author":"Ë®µã¶ù(ahxia)","time":1037808066,"msg":"void InsertSort(SeqList R) // SeqList is a Sequence List, e.g. an array{int i,j;for( i = 2; i <= n; i++) if(R[i].key<R[i-1].key){  R[0]=R[i];  j = i - 1;  do{   R[j+1] = R[j];   j--;  }while(R[0].key < R[j].key); } // end if} // end func////////////////////////////void qsort(SeqList r, int low, int high){  int pivotpos;  if(low < high){    pivotpos = partition(r, low, high);    qsort(r, low, pivotpos -1);    qsort(r, pivotpos + 1, high);  }}int partition(SeqList r, int i, int j){  RecordType pivot = r[i];  while(i < j){    while(i<j && r[j]>= pivot.key)      j--;    if(i < j)      r[i++]=r[j];    while(i<j && r[i].key <= pivot.key)      i++;    if(i < j)      r[j--] = r[i];  } //end while  r[i] = pivot;  return i;}qsortµÄÊ±¼ä¸´ÔÓ¶ÈÔÚ O(n^2) ºÍ O(n*lg(n)) Ö®¼ä,µ«ÊÇÍ¨³£Ğ§¹ûºÜºÃ;insertsortÊ±¼ä¸´ÔÓ¶ÈÔÚO(n) ºÍ O(n^2) Ö®¼ä, Æ½¾ù¸´ÔÓ¶ÈÒ²ÔÚ O(n^2),µ«ÊÇÊ±¼äÉÏ·Ç³£ÎÈ¶¨","title":"sort?","ip":"218.62.70.253:5555",]),(["aut