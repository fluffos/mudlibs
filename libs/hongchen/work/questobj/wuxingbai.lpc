#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(BLK"五行图"NOR, ({ "wuxingtu" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "张");
            set("material", "stone");
            set("long", "一张普通的五形八卦图。\n");
            set("no_give", 0);
            set("no_put", "省省吧，这个东西可放不进去！\n");

          }

    setup();
}

