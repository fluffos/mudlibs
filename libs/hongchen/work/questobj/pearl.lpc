#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIW"夜明珠"NOR, ({ "lighting-pearl"}) );
        set_weight(3);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一个在黑夜闪闪发光的夜明珠。\n");
                set("value", 10000);
            set("no_give", 1);
            set("no_put", "省省吧，这个东西可放不进去！\n");
        }
}

