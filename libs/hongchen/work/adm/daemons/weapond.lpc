// weapond.c
#include <ansi.h>
#include <combat.h>
void bash_weapon2(object me, object victim, object weapon, object ob);
mapping weapon_actions = ([
    "slash": ([
        "damage_type":  "割伤",
        "action":       "$N挥动$w，斩向$n的$l",
        "parry":        20,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "slice": ([
        "damage_type":  "劈伤",
        "action":       "$N用$w往$n的$l砍去",
        "dodge":        20,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "chop": ([
        "damage_type":  "劈伤",
        "action":       "$N的$w朝著$n的$l劈将过去",
        "parry":        -20,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "hack": ([
        "action":       "$N挥舞$w，对准$n的$l一阵乱砍",
        "damage_type":  "劈伤",
        "damage":       30,
        "dodge":        30,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "thrust": ([
        "damage_type":  "刺伤",
        "action":       "$N用$w往$n的$l刺去",
        "dodge":        15,
        "parry":        -15,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "pierce": ([
        "action":       "$N的$w往$n的$l狠狠地一捅",
        "damage_type":  "刺伤",
        "dodge":        -30,
        "parry":        -30,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "whip": ([
        "action":       "$N将$w一扬，往$n的$l抽去",
        "damage_type":  "鞭伤",
        "dodge":        -20,
        "parry":        30,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "impale": ([
        "action":       "$N用$w往$n的$l直戳过去",
        "damage_type":  "刺伤",
        "dodge":        -10,
        "parry":        -10,
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "bash": ([
        "action":       "$N挥舞$w，往$n的$l用力一砸",
        "damage_type":  "挫伤",
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "crush": ([
        "action":       "$N高高举起$w，往$n的$l当头砸下",
        "damage_type":  "挫伤",
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "slam": ([
        "action":       "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去",
        "damage_type":  "挫伤",
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
    "throw": ([
        "action":       "$N将$w对准$n的$l射了过去",
        "damage_type":  "刺伤",
        "post_action":  (: call_other, __FILE__, "throw_weapon" :),
        ]),
    "shock": ([                                                         //震动
        "action":       "$N对准$n弹起$w",
        "damage_type":  "震伤",
        "post_action":  (: call_other, __FILE__, "bash_weapon" :),
        ]),
]);
varargs mapping query_action()
{
    string verb, *verbs;
    verbs = previous_object()->query("verbs");
    if( !pointerp(verbs) ) return weapon_actions["hit"];
    else {
        verb = verbs[random(sizeof(verbs))];
        if( !undefinedp(weapon_actions[verb]) ) return weapon_actions[verb];
        else return weapon_actions["hit"];
    }   
}
void throw_weapon(object me, object victim, object weapon, int damage)
{
    object ob;
    if( objectp(weapon) ) {
        if( (int)weapon->query_amount()==1 ) {
            weapon->unequip();
            tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
        }
/*
        if( (int)weapon->query("迷药药力",1)>=10) {
                        victim->apply_condition("迷药",victim->query_condition("迷药")+weapon->query("迷药药力"));
                        message_vision(HIR"$n只觉得伤口上一麻，大叫一声：“不好！”看来是中了兵器上的迷药。\n"NOR,me,victim);
                        weapon->add("迷药药力", -(weapon->query("迷药药力")/2));
        }
        if( (int)weapon->query("毒药药力",1)>=10) {
                        victim->apply_condition("毒药",victim->query_condition("毒药")+weapon->query("毒药药力"));
                        message_vision(HIR"$n只觉得伤口上一麻，大叫一声：“不好！”看来是中了兵器上的毒药。\n"NOR,me,victim);
                        weapon->add("毒药药力", -(weapon->query("毒药药力")/2));
        }
*/
        weapon->add_amount(-1);
    }
}
void bash_weapon(object me, object victim, object weapon, int damage)
{
    object ob;
    int wap, wdp;
        string str;
    if( objectp(weapon)
    &&  damage==RESULT_PARRY
    &&  ob = victim->query_temp("weapon") ) {
        if (ob->query("skill_type")=="throwing") return;
        wap = (int)weapon->weight() / 100
            + (int)weapon->query("weapon_prop/rigidity")
            + (int)weapon->query("weapon_prop/damage")
            + (int)me->query_str();
        wdp = (int)ob->weight() / 100
            + (int)ob->query("weapon_prop/rigidity")
            + (int)ob->query("weapon_prop/damage")
            + (int)victim->query_str();
        wap = random(wap);
        wdp = random(wdp);
//     str = sprintf(HIW"\nwap：%d　wdp：%d\n"NOR,wap,wdp);
//      write(str);
        if( wap > 3 * wdp ) {
            if (ob->query("weapon_prop/rigidity") < weapon->query("weapon_prop/damage")){
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "已经断为两截！\n" NOR, victim );
            ob->unequip();
            ob->set("name", "断掉的" + ob->query("name"));
            ob->set("no_get", 1);
            ob->set("value", 0);
            ob->set("weapon_prop", 0);
            ob->move(environment(victim));
            }else{
                message_vision(HIW "$N只觉得手中" + ob->name() + HIW + "把持不定，脱手飞出！\n" NOR,victim);
                ob->unequip();
            }
            if (!ob->query("no_get") && !ob->query("no_drop")) ob->move(environment(victim));
            victim->reset_action();
            
        }else if( wap > 2 * wdp ) {
            message_vision(HIW "$N只觉得手中" + ob->name() + HIW + "把持不定，脱手飞出！\n" NOR,
                victim);
            ob->unequip();
            if (!ob->query("no_get") && !ob->query("no_drop")) ob->move(environment(victim));
            victim->reset_action();
        } else if( wap > wdp ) {
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "被打崩了一个缺口！\n" NOR, victim );
            ob->add("weapon_prop/rigidity", -(weapon->query("weapon_prop/damage"))/10);
            if (ob->query("rigidity") < 0){
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "已经断为两截！\n" NOR, victim );
            ob->unequip();
            ob->set("name", "断掉的" + ob->query("name"));
            ob->set("no_get", 1);
            ob->set("value", 0);
            ob->set("weapon_prop", 0);
            ob->move(environment(victim));
                        }
        } else {
             bash_weapon2(victim,me,ob,weapon);
        }
    }
}
void bash_weapon2(object me, object victim, object weapon, object ob)
{
    int wap, wdp;
        if (ob->query("skill_type")=="throwing") return;
        wap = (int)weapon->weight() / 100
            + (int)weapon->query("weapon_prop/rigidity")
            + (int)me->query_str();
        wdp = (int)ob->weight() / 100
            + (int)ob->query("weapon_prop/rigidity")
            + (int)victim->query_str();
        wap = random(wap);
        if( wap > 3 * wdp ) {
            if (ob->query("weapon_prop/rigidity") < weapon->query("weapon_prop/damage")){
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "已经断为两截！\n" NOR, victim );
            ob->unequip();
            ob->set("name", "断掉的" + ob->query("name"));
            ob->set("no_get", 1);
            ob->set("value", 0);
            ob->set("weapon_prop", 0);
            ob->move(environment(victim));
            }else{
                message_vision(HIW "$N只觉得手中" + ob->name() + HIW + "把持不定，脱手飞出！\n" NOR,victim);
                ob->unequip();
            }
            if (!ob->query("no_get") && !ob->query("no_drop")) ob->move(environment(victim));
            victim->reset_action();
            
        }else if( wap > 2 * wdp ) {
            message_vision(HIW "$N只觉得手中" + ob->name() + HIW + "把持不定，脱手飞出！\n" NOR,
                victim);
            ob->unequip();
            if (!ob->query("no_get") && !ob->query("no_drop")) ob->move(environment(victim));
            victim->reset_action();
        } else if( wap > wdp ) {
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "被打崩了一个缺口！\n" NOR, victim );
            ob->add("weapon_prop/rigidity", -(weapon->query("weapon_prop/damage"))/10);
            if (ob->query("rigidity") < 0){
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name() + HIW
                + "已经断为两截！\n" NOR, victim );
            ob->unequip();
            ob->set("name", "断掉的" + ob->query("name"));
            ob->set("no_get", 1);
            ob->set("value", 0);
            ob->set("weapon_prop", 0);
            ob->move(environment(victim));
                        }
        } else {
            if (wap>100)
            message_vision(HIY+"$N的" + weapon->name() + HIY+"和$n的" + ob->name()
                + HIY+"相击，冒出点点的火星。\n" + NOR, me, victim);
        }
}
void slash_weapon(object me, object victim, object weapon, int damage)
{
        if (me->query("skill_type")=="throwing") return;
    if( objectp(weapon) ) {
        if( (int)weapon->query("迷药药力",1)>=10) {
                        victim->apply_condition("迷药",victim->query_condition("迷药")+weapon->query("迷药药力"));
                        message_vision(HIR"$n只觉得伤口上一麻，大叫一声：“不好！”看来是中了兵器上的迷药。\n"NOR,me,victim);
                        weapon->add("迷药药力", -(weapon->query("迷药药力")/2));
        }
        if( (int)weapon->query("毒药药力",1)>=10) {
                        victim->apply_condition("毒药",victim->query_condition("毒药")+weapon->query("毒药药力"));
                        message_vision(HIR"$n只觉得伤口上一麻，大叫一声：“不好！”看来是中了兵器上的毒药。\n"NOR,me,victim);
                        weapon->add("毒药药力", -(weapon->query("毒药药力")/2));
        }
    }
}

