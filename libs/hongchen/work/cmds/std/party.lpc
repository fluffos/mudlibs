#include <command.h>
inherit F_DBASE;
inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
    set("channeld_id", "帮派");
}

int main(object me, string arg)
{
    string pty = me->query("party/party_name");
    string msg;

    msg = ansi2str(pty);
    if( !pty || pty == "" || msg[0..1] == "第")
	return notify_fail("你还是先加入一个帮派吧。\n");

    if( !arg ) arg = "...";
    msg = sprintf(NOR+HIC+"『%s"+NOR+HIC+"』"+NOR+"%s(%s)：%s\n", pty, me->name(1), me->query("id"), arg);
    //if( !me->query("channels/new") ) me->set("
    message("channel:new", msg, users());

    return 1;
}
