#include <skill.h>
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }
int main(object me, string arg)
{
        object ob;
        string *skname;
        mapping skills;
        int i;

        if( !arg || !objectp(ob = present(arg, environment(me))))
                return notify_fail("你要开除谁？\n");

        if(!me->query("zjbbang"))
                return notify_fail("你不是帮主。\n");

        if(ob==me)
                return notify_fail("开除自己？你不想要帮派了吗?\n");

        if((string)me->query("banghui") != (string)ob->query("banghui"))
                return notify_fail(ob->name()+"并不是你帮会里的人。\n");

        CHANNEL_D->do_channel(find_object(MASTER_OB),"rumor",sprintf("%s由于办事不力，有损%s在江湖中的威望，被开除出%s！！！",
                ob->name(1),ob->query("banghui"),ob->query("banghui")));
        tell_object(ob,"\n你被开除出" + ob->query("banghui") +NOR+MAG "了！\n\n");
        ob->delete("banghui");
         ob->delete("party");
        ob->delete("zjbbang");
        return 1;
}


