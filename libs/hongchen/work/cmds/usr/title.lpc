// title.c (Mon  09-04-95)
// 2k2.3.1, Add wizard hood function, ahxia@hc

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str)
{
    object ob;
    if( str && wizardp(me) ){
	ob = find_player(str);
	if( !ob )
	    return notify_fail("["+str+"]好像不存在...\n");
	printf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short());
    }
    else
	printf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(me), me->short(1));
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式: title
 
显示你目前的阶级和头衔。
 
HELP
    );
}

