//ls.c leeyao强化确认版本

#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        int i, w, col,k;
        string dir, listing;
        mixed *file, *dirent;
        object ob;
        seteuid(geteuid(this_player(1)));
        dir = resolve_path(me->query("cwd"), arg);

        if( file_size(dir)==-2 && dir[<1] != '/' ) dir += "/";

        file = get_dir(dir, -1);
        if( !sizeof(file) ) {
        if (file_size(dir) == -2) 
                write("目录是空的。\n");
                else write("没有这个目录。\n");
                return 1;
                }
        if (! (int)SECURITY_D->valid_read(dir,me) ){
                //记录查看的文件/log/cmds/ls
                log_file("cmds/ls/"+geteuid(me),
                sprintf("%s(%s) ls %s on %s越权\n",
                me->name(1), //记录使用命令的人名
                geteuid(me), //记录使用命令的ID
                dir,        //记录读取文件的路径
                ctime(time()) ) ); //记录使用命令的时间
                write(HIR"你没有足够的阅读权限。\n"NOR);
                return 1;
                }

    i = sizeof(file);
    w = 0;
    while(i--) {

        /* 如果列出的是目录，加上一个 '/' */
        if( file[i][1]==-2 ) file[i][0] += "/";
        /* 找出最长的档名长度 */
        if( strlen(file[i][0]) > w ) w = strlen(file[i][0]) + 1;
    }

    listing = sprintf("目录：%s\n", dir );
    col = 70 / (w+6);
    i = 0;
k=0;
k++;
    foreach( dirent in file ) {
        ob = find_object( dir + dirent[0] );
        if (! (int)SECURITY_D->valid_read(dir + dirent[0],me) ) { k--;continue; }
        listing += sprintf("%4d ", 1 + dirent[1]/1024);
        if( ob ) listing += GRN;
        else if( dirent[1]==-2 ) listing += YEL;
        listing += sprintf("%-*s" NOR, 1+w, dirent[0]);
        listing += (++i%col) ? "  " : "\n";
    }

    if( listing[<1] != '\n' ) listing += "\n";
    me->start_more( listing );

    return 1;    
}

int help(object me)
{
    write(@HELP
指令格式: ls [<路径名>]
 
列出目录下所有的子目录及档案, 如果没有指定目录, 则列出所在目录
的内容，所列出的档案中亮绿色的是已经载入的物件。
金黄色的是目录。
 
范例:
'ls /' 会列出所有位于根目录下的档案及子目录.
 
HELP
    );
    return 1;
}

