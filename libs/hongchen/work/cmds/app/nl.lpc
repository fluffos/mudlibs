//nl.c
//show file with line number.
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me,string arg)
{
    int i=0,begin=1,end=1,flen;
    string file,str,msg;
    object ob;

    seteuid(geteuid(me));

    if(!arg) 
	return notify_fail("Syntax: nl <file> [begin] [end]\n");
    i=sscanf(arg,"%s %d %d",str,begin,end);
    //dunno why i=0 when only 1 parameter.
    if(i==0) {str = arg; i=1;}
    file = resolve_path(me->query("cwd"), str);
    if( file_size(file) < 0){
	ob = present(str, me);
	if( !ob ) ob = present(str, environment(me));
	if (file=="here") ob=environment(me);
	if( !ob ) return notify_fail("没有这个档案。\n");
	file = base_name(ob) + ".lpc";
    }
    flen=file_length(file);
    msg = sprintf(HIC "file = %s, %d lines\n"NOR,file,flen);
    if(i == 1){ begin = 1; end=flen; }
    if(i == 2){
	end = begin + 10;
	begin -= 10;
	end = (end>flen)? flen: end;
	begin = (begin <1)? 1: begin;
    }
    if(i == 3){ end = (end>flen)? flen: end; }

    for(;begin <= end;begin++){
	msg += sprintf("%7d: %s",begin,read_file(file,begin,1));
    }
    me->start_more(msg);
    return 1;
}

int help(object me)
{
    write(@HELP
Syntax: nl <file> [begin] [end]

if 'begin' not specified, this command will show the entire file;
if 'end' not specified, show lines between [begin-10..begin+10];

HELP
    );
    return 1;
}

