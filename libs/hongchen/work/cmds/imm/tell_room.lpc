// status.c
inherit F_CLEAN_UP;
int main(object me,string arg)
{
    object ob;

    if ( !(ob = environment(me)) )
        return notify_fail("你这是在哪儿呀？\n");

    if ( !arg )
        return notify_fail("你想向这个房间传达什么？\n");

    tell_room(ob,arg+"\n");

    return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : status [detail]
 
这个指令可以显示出目前游戏的一些相关资料及状况.
 
HELP
    );
    return 1;
}
 
