inherit F_CLEAN_UP;
int main(object me, string arg)
{
    mapping *action = ({
      ([      "action" : "$N手中$w斜指，一招「停车问路」，反身一顿，一刀向$n的$l撩去",
	"force" : 120,
	"dodge" : -10,
	"lvl" : 0,
	"skill_name" : "停车问路",
	"damage_type" : "割伤"
      ]),
      ([      "action" : "$N一招「童子挂画」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
	"force" : 130,
	"dodge" : -10,
	"damage" : 5,
	"lvl" : 8,
	"skill_name" : "童子挂画",
	"damage_type" : "割伤"
      ]),
    });
    me->set("self_skill/action",action);
    me->set("self_skill/skill_type",arg);

    return 1;
}
