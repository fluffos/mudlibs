inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string id, cmd;
    object ob;

    if( sscanf(arg,"%s %s", cmd, id) != 2 )
	return notify_fail("pp <r|q> <id>\n");
    if( !present(ob = find_player(id), environment(me)) )
	return notify_fail("player does not exist.\n");
    switch(cmd){
    case "r": 
	ob->delete("betrayer");
	write("ok.\n");
	break;
    case "q":
	write(id+" betrayer time = "+ob->query("betrayer")+"\n");
	break;
    }
    return 1;
}
