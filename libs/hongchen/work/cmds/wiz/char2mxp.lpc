// mxp parser daemon
// wings@HC

#define MXP_BEG 		'\x03'
#define MXP_END 		'\x04'
#define MXP_AMP		'\x05'

string char2mxp(int mxp,string str)
{
	int bInTag = 0;
	int bInEntity = 0;
	int i = 0;
	int begin,end;
	string new_string = "";
	
	begin = 0;
	end = -1;

	for ( i = 0 ; i < strlen(str) ; i++ )
	{
		if ( bInTag )
		{
			if ( str[i] == MXP_END )
			{
				bInTag = 0;
				end = i - 1;
				if ( mxp )
				{
					if ( end >= begin )
						new_string += str[begin..end] + ">";
					else
						new_string += ">";
				}
				begin = i + 1;
			}
		}
		else if ( bInEntity )
		{
			if ( str[i] == ';' )
			{
				bInEntity = 0;
				end = i;
				if ( mxp )
					new_string += str[begin..end];
				begin = i + 1;
			}
		}
		else
		{
			switch(str[i])
			{
			case MXP_BEG:
				bInTag = 1;
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				if ( mxp )
					new_string += "<";
				begin = i + 1;
				break;
			case MXP_END:
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				begin = i + 1;
				end = -1;
				break;
			case MXP_AMP:
				bInEntity = 1;
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				if ( mxp )
					new_string += "&";
				begin = i + 1;
				break;
			case '<':
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				if ( mxp )
					new_string += "&lt;";
				else
					new_string += "<";
				begin = i + 1;
				break;
			case '>':
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				if ( mxp )
					new_string += "&gt;";
				else
					new_string += ">";
				begin = i + 1;
				break;
			case '&':
				end = i - 1;
				if ( end >= begin )
					new_string += str[begin..end];
				if ( mxp )
					new_string += "&amp;";
				else
					new_string += "&";
				begin = i + 1;
				break;
			}
		}
	}
	
	if ( bInTag )
	{
		end = i - 1;
		if ( end >= begin )
			new_string += str[begin..end];
		if ( mxp )
			new_string += ">";
	}
	else if ( bInEntity )
	{
		end = i - 1;
		if ( end >= begin )
			new_string += str[begin..end];
		if ( mxp )
			new_string += ";";
	}
	else
	{
		end = i - 1;
		if ( end >= begin )
			new_string += str[begin..end];
	}
	
	return new_string;
}
	
int main(object me,string arg)
{
	string str;
        string teststr = "\x003""alskdj>MN<&tle;\x004""asva&s>\"\x005""alv;bat\x005""att";
	
	if ( !arg )
		return notify_fail("Usage: char2mxp <string>.\n");
	
	write(char2mxp(1,arg)+"\n");
        write(char2mxp(0,teststr)+"\n");
	
	return 1;
}
