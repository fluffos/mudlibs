inherit F_CLEAN_UP;

//验证时间格式是否正确
int confirm(string time_format)
{
        int hour,minute;
        
        if ( !time_format )
                return 0;
        
        if ( sscanf(time_format,"%d:%d",hour,minute) != 2 )
                return 0;
        
        if ( (hour > 24) || (hour < 0) )
                return 0;
        
        if ( (minute > 60) || (minute < 0) )
                return 0;
        
        return 1;
}
        

int main(object me, string arg)
{

        int segment = 1;
        
        string announce;
        int segments;
        string start_time,end_time;
        
        if ( arg == "list"){
                announce = "每天的戒严时间期间为：\n";
                segments = ENV_D->query("jieyan/segments");
                
                if ( segments < 1 ){
                        write("非法戒严时间，请重新设定戒严期间！\n");
                        return 1;
                }
                
                for ( int i = 1 ; i <= segments ; i++ ){
                        start_time = sprintf("jieyan/segment_%d/start_time",i);
                        end_time = sprintf("jieyan/segment_%d/end_time",i);
                        announce += " {" + ENV_D->query(start_time) + "---";
                        announce += ENV_D->query(end_time) + "}\n";
                }
        
                announce += "\n";
        
                write(announce);
                
                return 1;
        }
        
        if ( arg == "test" ){
                if ( JIEYAN_D->is_jieyan() ){
                        write("现在是戒严期间。\n");
                        return 1;
                }
                else{
                        write("现在不是戒严期间。\n");
                        return 1;
                }
        }
        
        if ( arg && arg != "set" ){
                write("非法参数，详细参数请help jieyan。\n\n");
                return 1;
        }
        
        write(@TEXT
此命令是用来设置戒严时期的，用来防止玩家之间相互恶性PK。
周期是现实生活中的一天。
日期的格式是： HH:MM

TEXT
        );
        
        write(sprintf("请输入戒严起始时间（%d）：",segment));
        input_to("set_start_time",0,me,segment);
        
        return 1;
}

void set_start_time(string start_time,object me,int segment)
{
        string argu;
        
        if ( !confirm(start_time) ){
                write("输入的时间格式不正确，请重新输入。\n");
                write(sprintf("请输入戒严起始时间（%d）：",segment));
                input_to("set_start_time",0,me,segment);
                return;
        }
                
        argu = sprintf("jieyan/segment_%d/start_time",segment);
        
        if ( segment == 1 )
                ENV_D->delete("jieyan");
        
        ENV_D->set(argu,start_time);
        
        write(sprintf("请输入戒严结束时间（%d）：",segment));
        input_to("set_end_time",0,me,segment);
        
        return;
}

void set_end_time(string end_time,object me,int segment)
{
        string argu;
        
        if ( !confirm(end_time) ){
                write("输入的时间格式不正确，请重新输入。\n");
                write(sprintf("请输入戒严起始时间（%d）：",segment));
                input_to("set_end_time",0,me,segment);
                return;
        }

        argu = sprintf("jieyan/segment_%d/end_time",segment);
        
        ENV_D->set(argu,end_time);
        
        write("你是否要设置下一段戒严时间（yes/no）[no]？");
        input_to("is_again",0,me,segment);
        
        return;
}

void is_again(string again,object me,int segment)
{
        string announce;
        string start_time,end_time;
        
        if ( again == "yes" ){
                segment++;
                write(sprintf("请输入戒严起始时间（%d）：",segment));
                input_to("set_start_time",0,me,segment);
                return;
        }
        
        ENV_D->set("jieyan/segments",segment);
        ENV_D->save();
        
        announce = "从今天开始，每天的戒严时间期间为：";
        
        for ( int i = 1 ; i <= segment ; i++ ){
                start_time = sprintf("jieyan/segment_%d/start_time",i);
                end_time = sprintf("jieyan/segment_%d/end_time",i);
                announce += " {" + ENV_D->query(start_time) + "---";
                announce += ENV_D->query(end_time) + "} ";
        }
        
        announce += "\n";
        
        write(announce);
}
        
int help (object me)
{
    write(@HELP
指令格式: jieyan [list] [set]
    list  列出当前的戒严时间
    set   设置戒严期间
 
设置戒严时期，在这段时期内禁止玩家之间相互PK。
 
HELP
    );
    return 1;
}


