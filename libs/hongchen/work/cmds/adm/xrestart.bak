// xrestart.c
// work with /adm/daemons/restartd.c to make system auto restart
// 2k2.9.17, ahxia
#include <restart.h>

inherit F_CLEAN_UP;

int help(object me)
{
    write(@HELP
自动重启动命令。可以通过时间设置决定何时自动重新启动系统。

Syntax: xrestart <[add...|set] [[+]|[-]秒数]> | <[halt]|[start]>

参数：
    add      加减启动时间。 e.g. xrestart add -600 为减少 10 分钟。
    addhour  以小时为单位加减再启动时间。
    addday   以天为单位加减再启动时间。
    set      设置启动时间。 e.g. xrestart set 90 为1分30秒后重新启动。
    halt     停止倒计时，与 start 命令对应。
    start    开始倒计时，与 halt 命令对应。

See Also: 
    uptime, who

Ref:
    /include/restart.h, /adm/daemons/restartd.c, /cmds/adm/xrestart.c

HELP );
    return 1;
}
int main(object me, string arg)
{
    int t;
    string s1,s2;

    t = RESTART_D->GetRemainTime();

    if( !arg ){
	write(sprintf("离系统重新启动还有%d秒（%s）。\n",
	    t, CHINESE_D->chinese_period(t,1)));
	return 1;
    }
    if( sscanf(arg,"%s %s", s1, s2) == 2 ){
	if( s1 == "add" ){
	    t = to_int( s2 );
	    RESTART_D->AddSecond(t);
	    write(sprintf("离系统重新启动还有%d秒。\n", RESTART_D->GetRemainTime()));
	    return 1;
	}else if( s1 == "set" ){
	    t = to_int( s2 );
	    RESTART_D->SetRemainTime(t);
	    write(sprintf("离系统重新启动还有%d秒。\n", RESTART_D->GetRemainTime()));
	    return 1;
	}else if( s1 == "addhour" ){
	    t = to_int( s2 );
	    RESTART_D->AddHour(t);
	    write(sprintf("离系统重新启动还有%d秒。\n", RESTART_D->GetRemainTime()));
	    return 1;
	}else if( s1 == "addday" ){
	    t = to_int( s2 );
	    RESTART_D->AddDay(t);
	    write(sprintf("离系统重新启动还有%d秒。\n", RESTART_D->GetRemainTime()));
	    return 1;
	}
    }else if( sscanf(arg, "%s", s1) == 1){
	if( s1 == "halt" ){
	    RESTART_D->SetRSFlag(HALT);
	    write("Ok!\n");
	    return 1;
	}else if( s1 == "start" ){
	    RESTART_D->SetRSFlag(SHUTDOWN);
	    write(sprintf("离系统重新启动还有%d秒。\n", RESTART_D->GetRemainTime()));
	    return 1;
	}
    }
    help(this_player());
    return 1;
}

