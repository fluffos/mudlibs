    "force" : 600,
    "parry" : 15,
    "dodge" : 35,
    "damage_type" : "劈伤",
    "lvl" : 100,
    "skill_name" : "断山劈石"
]),
([      "action" : "$N矮下身来，左手变掌为指，施展出「"+HIC+"戏点乾坤"+NOR+"」，翻手向上，照$n的$1点去",
    "force" : 600,
    "parry" : 5,
    "dodge" : 30,
    "damage_type" : "刺伤",
    "lvl" : 100,
    "skill_name" : "戏点乾坤"
]),
([      "action" : "$N猛然间变掌为抓，一式「"+HIR+"深水擒蛟"+NOR+"」，向$n的$1抓去，抓风扑面而来，直让$n呼不出气来",
    "force" : 600,
    "parry" : -20,
    "dodge" : -15,
    "damage_type" : "内伤",
    "lvl" : 100,
    "skill_name" : "深水擒蛟"
  ]),
([      "action" : "$N绕到$n身后，使一式「"+WHT+"老者拍门"+NOR+"」，向$n的背心拍去，双掌顿时化做一片掌影，
如一阵轻烟，将$n细细密密地笼罩于内",
    "force" : 600,
    "parry" : -20,
    "dodge" : -15,
    "damage_type" : "内伤",
    "lvl" : 100,
    "skill_name" : "老者拍门"
  ]),
([      "action" : "$N半蹲身子，使出一式「"+HIC+"气推云海"+NOR+"」，双掌急向$n的小腹的胸口推去，$n顿时觉得胸中一股气息,
压的自己喘不过气来",
    "force" : 600,
    "parry" : -20,
    "dodge" : -15,
    "damage_type" : "内伤",
    "lvl" : 100,
    "skill_name" : "气推云海"
]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry" || usage=="strike"; }  

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail("练落铁砂神掌必须空手。\n");
    if ((int)me->query_skill("tiezhang-shengong", 1) < 80)
   return notify_fail("你的铁掌神功火候不够，无法学铁沙神掌。\n");
    if ((int)me->query("max_neili") < 1200)
   return notify_fail("你的内力太弱，无法练铁砂神掌。\n");
    return 1;
}


string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
   if(level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    mapping a_action;
    level   = (int) me->query_skill("tiesha-shenzhang",1);
    for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action=action[NewRandom(i, 20, level/5)];
                       break;
                 }
    a_action["dodge"]  = 0-level;
    a_action["attack"]  = level;
    a_action["damage"] = level*2;
    return a_action;
}
