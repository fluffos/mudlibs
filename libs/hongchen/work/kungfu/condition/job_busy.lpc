//job_busy.c
//for use together with xx_task, xx_task2,.

int update_condition(object me, int duration)
{
    if(wizardp(me)) write("job_busy condition: "+duration+"\n");
    //if (duration <= 1) return 0;
    if (duration < 1) return 0;

    me->apply_condition("job_busy", duration - 1);
    return 1;
}
