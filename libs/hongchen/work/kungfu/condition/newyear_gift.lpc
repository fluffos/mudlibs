//新年礼物之毒，哈哈。
//临时加int dex and str 三样属性。
//swordman@hc 2001.12.31
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   if( duration < 1 ) return 0;
   if( !living(me) ) {
      message("vision", me->name() + "感觉似乎身体有了些许变化..\n", environment(me), me);
   }
   else {
      tell_object(me, HIY "风少偷偷摸摸的从你身上拿走了些东西，这家伙干什么呢～！？\n" NOR );
      message("vision", me->name() + HIM"被风少偷偷摸摸的从身上拿走了点东西，气的暴跳如雷。\n",
            environment(me), me);
   }
      me->apply_condition("newyear_gift", duration - 1);
      me->add("dex", -100 );
      me->add("str", -100 );
      me->add("con", -100 );

   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}
