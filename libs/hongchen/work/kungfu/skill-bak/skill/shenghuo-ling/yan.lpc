//yan.c 
// Modified by Egria May.2000
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;
    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「焚心烈焰」只能对战斗中的对手使用。\n");
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
        
    if( (int)me->query_skill("shenghuo-ling", 1) < 150 )
        return notify_fail("你的圣火令法不够娴熟，不会使用。\n");
    if (!me->visible(target))    return notify_fail("你看不到"+target->name()+"。\n");
 if( (string)me->query_skill_mapped("force")!="jiuyang-shengong" || (int)me->query_skill("jiuyang-shengong", 1) < 500 )
//  (int)me->query_skill("jiuyang-shengong", 1) < 50 )
        return notify_fail("你的九阳神功还不够火喉，这样使用容易走火入魔。\n");
    if( (int)me->query("neili", 1) < 300 )
        return notify_fail("你现在内力太弱，不能使用「焚心烈焰」。\n");
            
msg = HIG"〖焚心烈焰〗"HIM"----$N如山岳般立于$n三丈外，手中剑似一团
\n火焰，此时空气如有形之质，在内力的激荡下，"HIR"宛如地狱烈火熊熊燃烧,
\n$N如同烈烟中腾升的巨人，只见仿佛千万到火焰笼罩着$n,使$n透不过气来\n"NOR;
  if( !target->is_killing(me) ) target->kill_ob(me);
    if (random(me->query_skill("force")) > target->query_skill("force")/2 )
    {
        target->start_busy(3);
        
        damage = (int)me->query_skill("shenhuo-ling", 1);
        damage = damage +  (int)me->query_skill("sword", 1);
target->receive_wound("qi", damage/2,me);
target->receive_damage("qi", damage,me);
        me->add("neili", -damage/2);
        msg += HIR"$n只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出！\n"NOR;
        me->start_busy(3);
    } else 
    {
        msg += CYN"可是$p猛地向后一跃,跳出了$P的攻击范围。\n"NOR;
        me->add("neili", -300);
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    return 1;
}


