// 10gold.c

#include <ansi.h>

inherit MONEY;

void create()
{
        set_name(HIY "十两金票" NOR, ({"tengold","tengold_money"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "tengold");
                set("long", "面值十两金子的金票。\n");
                set("unit", "叠");
                set("base_value", 100000);
                set("base_unit", "张");
                set("base_weight", 16);
        }
        set_amount(1);
}


