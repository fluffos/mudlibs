// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;


void create()
{
	set_name(HIG"宝物"NOR, ({"bao wu"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "你挖出来的宝物，不知道有什么作用。\n");
		set("unit", "个");
                set("no_sell", 1);
		set("value", 50);
		 set("mingjiao", 1);
	}
}
int init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object me = this_player();
        int i;
        
	if(arg=="bao wu")
	{
                if ( this_object()->query("owner") != me->query("id") )
                        return notify_fail("这个宝物不是你挖的。\n");
		message_vision(HIW"$N小心翼翼的将宝物打开。\n"NOR, me);
		tell_object(me,HIW"很可惜，这个宝物因为埋藏时间太长，失效了。\n"NOR);
		
		if ( me->query("combat_exp") > 1000)
		{
		
		me->add("combat_exp", -1000);
		tell_object(me,HIW"因为你使用了伪劣产品，你的经验降低了！！\n"NOR);
		}
		destruct(this_object());
	}
	return 1;
}
