// longsword.c 长剑
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name(HIR"圣火令"NOR, ({"shenghuo ling","ling" }))
;
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
                set("long", "波斯明教总坛的宝物。\n")
;
		set("material", "steel");
                set("wield_msg", "$N又身后飞出$n握在手中。\n")
;
                set("unwield_msg", "$n顺着$N的内力，藏于身后。\n")
;
	}
        init_sword(500,2);
	setup();
}
