#include <ansi.h>
#include <command.h>
#include <mudlib.h>
inherit NPC;

void create()
{
        set_name("庙祝", ({ "man" }));
        set("shen_type", 1);
        set("gender", "男性" );
        set("age", 60);
        set("per", 20);
        set("long", "他是看守武庙的一个老头。\n");

        set("combat_exp", 400);
        set("attitude", "friendly");
        seteuid(getuid());
        set("channel_id","");
        setup();

        carry_object("/clone/misc/cloth")->wear();
}

void init(object ob)
{
        ob = this_object();
        remove_call_out("clone_kou");
call_out("clone_kou", 200+random(20));
}

void clone_kou(object me)
{
        object ob;
         switch(random(8)) {
                case 0:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到扬州烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/city/guangchang");
                break;
                case 1:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到苏州烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/suzhou/canlangting");
                break;
                case 2:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到武功镇烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/city/guangchang");
                break;
                case 3:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到泉州烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/quanzhou/zhongxin");
                break;
                case 4:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到佛山烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/foshan/street3");
                break;
                case 5:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到北京烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/city2/tian_anm");
                break;
                case 6:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到福州烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/fuzhou/dongjiekou");
                break;
                case 7:
        CHANNEL_D->do_channel(this_object(),"rumor",
                sprintf("听说日本倭寇流窜到杭州烧杀抢掠！"));
        ob=new("/d/city/npc/robber1.lpc");
        ob->move("/d/hangzhou/road13");
                break;
                }
                
}


