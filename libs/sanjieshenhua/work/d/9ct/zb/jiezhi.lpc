// 阴阳戒指 by Calvin

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name(HIG"阴阳戒指"NOR, ({ "yinyang jiezhi", "jiezhi", "ring" }));
        set("weight", 400);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
             set("value", 4000);
                set("material", "gold");
                set("armor_prop/armor", 50);
                set("armor_prop/spells", 40);
        }
        setup();
}       
