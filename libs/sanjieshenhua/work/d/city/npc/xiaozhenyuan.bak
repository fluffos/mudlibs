//【运镖任务】萧振远(Xiao zhenyuan)
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int potential_lv(int exp);
string do_quest();
string* dart_area=({"/d/moon/nroom","/d/jjf/qingya","/d/kaifeng/dangpu","/d/lingtai/room",
                    "/d/jz/in"});
string* dart_short=({"月宫","将军府","开封","灵台","江州"});
string* dart_id=({"magu","qin mu","xu laoban","master puti","yin wenjiao"});
string* dart_name=({"麻姑","秦母","徐老板","菩提祖师","殷温娇"}); 
string do_job();
string do_give();
string daoxing(int dx)
{
        
        int day,hour;
        day = (dx) / 4;
        hour = (dx  - day * 4) * 3; 
        return day?(chinese_number(day)+"天"):""+hour?(chinese_number(hour)+"时辰"):"";
}
void create()
{
  set_name("萧振远", ({"xiao zhenyuan", "xiao", "zhenyuan"}));
  set ("long", @LONG
这英雄生得面如傳粉，兩道黃眉，身長九尺，腰大十圍。
善使兩根囚龍棒，每根重一百五十斤，有萬夫不當之勇。
LONG);
  set("title","「"HIR"盖世豪杰"NOR"」");
  set("gender", "男性");
  set("age", 36);
  set("str", 50);
  set("per", 20);
  set("int", 20);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 5000000);
  set_skill("spear", 200);
  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("mace", 200);
  set_skill("jinglei-mace", 200);
  set_skill("yanxing-steps", 200);
  set_skill("bawang-qiang", 200);
  set_skill("lengquan-force", 200);
  set_skill("unarmed", 200);
  set_skill("changquan", 200);

  map_skill("mace", "jinglei-mace");
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "jinglei-mace");
  map_skill("dodge", "yanxing-steps");
  set("max_sen", 5000);
  set("max_kee", 100);

  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 100);
        set("inquiry", ([
                "运镖" : (: do_job :),
                "镖"   : (: do_job :),
                "工作" : (: do_job :),
                "job"  : (: do_job :),
                "领赏" : (: do_give :),
                "over" : (: do_give :),
        ]) );
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage", 15);
  setup();
 
  carry_object("/d/jjf/npc/obj/qiulong")->wield();
carry_object("/d/jjf/npc/obj/qiul")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}
string chinese_time(int t)
{
        int d, h, m, s;
        string time;
        s = t % 60;     t /= 60;
        m = t % 60;     t /= 60;
        h = t % 24;     t /= 24;
        d = t;
        if(d) time = chinese_number(d) + "天";
        else time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        return time;
}

string do_job()
{   int n;
    object ob,cart;
    ob=this_player(); 
    n=random(sizeof(dart_area));   
    
    if ( ob->query_temp("in_dart"))
       return "阁下刚刚不是已经从老夫这里领取过任务吗？\n";

    if ( (int)ob->query_condition("dart_limit" ) > 0 )
       return "你还没完成任务。\n";

    if ( ob->is_busy() || ob->query_temp("pending/exercising"))
                return "你现在正忙着呢。\n";

    if ( (int)ob->query("combat_exp") < 20000 )
       return "押送镖货是件危险的任务，我看"+RANK_D->query_respect(ob)+"似乎没有这能力！\n";

    if( (int)ob->query("daoxing")+(int)ob->query("combat_exp") >= 2500000 )
       return "这种小事情哪能麻烦"+RANK_D->query_respect(ob)+"！\n";

    if ( (int)ob->query_skill("force") < 20 )
       return "押送镖货是件危险的任务，我看"+RANK_D->query_respect(ob)+"还是回去打打内功底子在来吧！\n";

    if ( (int)ob->query("dart/number") > 20 && (int)ob->query("age") < 18)   
       return "这位"+RANK_D->query_respect(ob)+"果然是位人才，不过小兄弟年龄尚小，已经多次完成任务了，等你长大点再来吧！\n";
    
    if(!ob->query("dart/number")) ob->set("dart/number",1);
    else ob->add("dart/number",1);
    ob->set_temp("in_dart",1);
    ob->set_temp("dart_area",dart_area[n]);
    ob->set_temp("dart_id",dart_id[n]);
    ob->set_temp("dart_name",dart_name[n]);
    ob->set_temp("dart_area_name",dart_short[n]);
    ob->apply_condition("dart_limit", 3600);
    ob->set_temp("robber_rec",1);

    cart=new("/d/city/quest/biao/cart");
    cart->set("master",ob->query("name"));
    cart->set("masterid",ob->query("id"));
    cart->move("/d/city/biaoju-e");
    cart->set_leader(ob);
    command("nod");
    message_vision(CYN "几个镖师将镖货推了出来。\n" NOR,ob); 
    return "你把这批货物送到"+dart_short[n]+"的"+dart_name[n]+"手中。\n";
    
}

string do_give()
{
  object ob;
  int dh,pot,wx,money;

  ob=this_player();

  if ( !ob->query_temp("in_dart"))
    return "我没让你走镖啊？\n";

  if ( !ob->query_temp("over_dart") )
    return "镖车没有送到地头，莫非是你吞了！？\n";

    wx = random(1000)+1000;
    dh = random(1000)+5000;
    pot = random(1000)+2000;                    
    money = random(400000)+100000;
    
    ob->add("combat_exp",wx);
    ob->add("daoxing",dh);  
    ob->add("balance",money);
  
  message("system",HIC"『振远镖局』萧振远(Xiao zhenyuan)："+ob->name()+"将镖车安全运到"+ob->query_temp("dart_area_name")+"，获得镖费"+chinese_number(money/10000)+"两金子！\n"NOR,users());
  message("system",HIC"『振远镖局』萧振远(Xiao zhenyuan)："+ob->name()+"得到了"+daoxing(dh)+"道行、"+chinese_number(wx)+"点武学经验的奖励！\n"NOR,users());
  ob->delete_temp("in_dart");
  ob->delete_temp("over_dart");
  ob->delete_temp("dart_name");
  ob->delete_temp("dart_id");
  ob->delete_temp("dart_area");
  ob->delete_temp("robber_rec");

  command("pat "+ob->query("id"));
  return RANK_D->query_respect(ob)+"果然是栋梁之才！\n";
}

int potential_lv(int exp)
{
        int grade;
        grade = 100 + exp /500;
        return grade;
}

int accept_object(object who, object ob)
{
    int value;

        if (ob->query("money_id") && (value=ob->value()) >= 500000) 
        {
                command("angry");
                tell_object(who, name()+
                        "说道：废物！你把镖货弄丢了，如何有脸回来，如不拿钱赔来，老夫与你拼了。\n");
                who->delete_temp("in_dart");
                who->apply_condition("dart_limit", 0);
                return 1;
        }
        return 0;
} 
int accept_fight(object me)
{
  command("say 老夫不想跟人打架！\n");
  return 0;
}
