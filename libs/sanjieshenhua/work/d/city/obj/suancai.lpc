inherit ITEM;
inherit F_FOOD;

void create()
{
  set_name("酸菜", ({"suan cai", "cai", "suancai"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘酸菜。\n");
    set("unit", "碗");
    set("value", 500);
    set("food_remaining", 5);
    set("food_supply", 35);
  }
}
