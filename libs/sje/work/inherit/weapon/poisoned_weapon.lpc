// let weapon has poison,
// if u want to make it, 
// just add set("poisoned", "poison-name");
// 1998-02-12 @jyqxz

#include <ansi.h>

int hit_ob(object me, object victim, int damage) {
  object weapon, weapon1;
  string poison;
  int poison1, wp, wp1, wp2;
  weapon = this_object();
  weapon1 = victim->query_temp("weapon");

  if (objectp(weapon) && objectp(weapon1) && (
    weapon->query("skill_type") == "blade" ||
    weapon->query("skill_type") == "sword" ||
    weapon->query("skill_type") == "axe")) {
    wp = weapon->query("sharpness");
    wp1 = weapon1->query("sharpness");
    wp2 = weapon1->query("rigidity");
    if (wp > 10) wp = 10;
    if (wp1 > 10) wp1 = 10;
    if (wp2 > 10) wp2 = 10;
    if (wp > 0 && wp > wp1 && wp > wp2 &&
      random(me->query("str")) > victim->query("str") / 2) {
      message_vision(
        WHT "只听见「哐」地一声轻响，$N手中的" + weapon1->name() + WHT "已经被" + weapon->name() + WHT "削为两截！\n" NOR,
        victim
      );
      weapon1->unequip();
      weapon1->move(environment(victim));
      weapon1->set("name", "断掉的" + weapon1->query("name"));
      weapon1->set("value", 49);
      weapon1->set("weapon_prop", 0);
      victim->reset_action();
    }
  }

  if (stringp(poison = weapon->query("poisoned")) &&
    ((int)victim->query("eff_qi") < (int)victim->query("max_qi")))
    if (intp(poison1 = weapon->query("poison_number")) && random(10) > 5
      && poison1 > 1 && victim->query_condition(poison) < 50) {
      if (poison1 == 2)
        weapon->set_temp("apply/long", ({ weapon->query("long") + "好象是被喂过剧毒，不过效果已经不明显了。\n" }));
      weapon->add("poison_number", -1);
      victim->apply_condition(poison,
        victim->query_condition(poison) + random(10));

      message_vision(HIR "$n只觉得伤口上一麻，大叫一声：不好！\n" NOR,
        me, victim);
      if (!victim->is_killing(me->query("id"))) victim->kill_ob(me);
    }
  return 0;
}
