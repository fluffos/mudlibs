#include <ansi.h>
inherit ROOM;
string look_hua();
string look_duilian();
string clear_title(string arg);
void add_title(object me,string arg);
void create()
{
        set("short", WHT"午夜学校"NOR);
	set("long", @LONG
这里就是「日本」中传说的午夜学校，是午夜隐居的地方，恐怖的书架上放满
了各种各样的恐怖书，墙上挂着一副恐怖画(hua)，左右是一副恶心的对联(duilian)，
屋子的正中央放着一张血红的石桌。          
LONG );

	set("item_desc", ([ 
	"hua" : (: look_hua :),
        "duilian" : (: look_duilian :),
	]));
	set("exits", ([ 
                "gc": "/d/city/guangchang"
	]));

        set("objects", ([
        "/u/wuye/npc/guaiwu" : 1 ]) );

        set("no_fight", "1");
	set("no_clean_up", 0);
	setup();
}
