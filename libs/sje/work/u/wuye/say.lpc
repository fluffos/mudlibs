#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (userp(me) || wiz_level(me) || wizardp(me))
    message("wizard", CYN + "(" + capitalize(me->query("id")) + ")" NOR, environment(me), me);
  if (!arg) {
    write("你自言自语不知道在说些什么。\n");
    if ((int)me->query("qi") < (int)me->query("max_qi") / 4) {
      arg = replace_string(arg, " ", " ... ") + " ...";
      write(CYN "你有气无力地说道：" + arg + "\n" NOR);
      message("sound", CYN + me->name() + "有气无力地说道：" + arg + "\n" NOR,
      } else {
        write(CYN "你说道：" + arg + "\n" NOR);
        message("sound", CYN + me->name() + "说道：" + arg + "\n" NOR,
        }  // The mudlib interface of say
        all_inventory(environment(me))->relay_say(me, arg);

        return 1;
      }

      int help(object me) {
        write(@HELP
指令格式: say <讯息>
 
说话，所有跟你在同一个房间的人都会听到你说的话。
 
注: 本指令可用 ' 取代.
 
HELP
        );
        return 1;
      }
