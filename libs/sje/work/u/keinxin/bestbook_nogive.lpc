//for sj2

#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIR "无字神书" NOR, ({ "shenshu" }));
  set("no_put", 1);
  set("shenshu", 1);
  set("value", 0);
  set("no_drop", 1);
  set("no_bug", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("no_get", 1);
  set("value", 0);
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_give", "每个人只有一个，你都这么大方！\n");
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 0);
    set("unit", "本");
    set("material", "paper");
    set("long", "神书中的神书，你可以用(chayue)来查阅它。这是新手特别版，不能给人。\n");
  }

  setup();
}
void init() {
  add_action("do_cha", "chayue");
}
int do_cha(string arg) {
  object me, ob;
  int exp, pot, score, i, time;
  me = this_player();
  if (!id(arg))
    return notify_fail("你要查什么？\n");
  if (me->query("shenshu/bestbookopened") > 2)
    return notify_fail("你这一生中已经打开了三次无字神书了，还是把机会留给其他人吧！\n");

  me->add("shenshu/bestbookopened", 1);
  time = me->query("shenshu/bestbookopened");
  tell_object(me, HIM "这是你第" + chinese_number(time) + "打开无字神书，每个人一共有三次机会，好好把握。\n");
  ob = new("quest/shenshu/sdan");
  ob->move(me);
  ob = new("quest/shenshu/sdan");
  ob->move(me);
  ob = new("quest/shenshu/sdan");
  ob->move(me);
  i = random(6);

  tell_object(me, HIB "你打开了无字神书，书中突然焕发出十道耀眼的" HIY "金光 \n" NOR);
  tell_object(me, HIG "那十道" HIY "金光" HIG "缓缓将你托起，你心中充满了自豪和幸福。\n" NOR);
  tell_object(me, MAG "过了片刻" HIY "金光" MAG "将你轻轻放下，变成一些金丹落在你掌中。\n" NOR);
  tell_object(me, HIR "天边出现霞光万道，祥云一片，此乃祥和之兆。\n" NOR);

  message(
    "channel:chat",
    HIR "【传闻】" HIG + me->query("name") + "打开了无字神书，得到三颗" + HIY "" + ob->query("name") + HIG "啦！\n" NOR,
    users()
  );
  if (i > 4) {
    if (me->query("int") < 41) {
      me->add("int", 1); tell_object(me, HIR "你觉得自己突然茅塞顿开。悟性更进了一层。\n" NOR);
    }
  } else if (i > 3) {
    if (me->query("dex") < 41) {
      me->add("dex", 1); tell_object(me, HIM "你觉得自己突然身轻如燕。原来身法增加了。\n" NOR);
    }
  } else if (i > 2) {
    if (me->query("str") < 41) {
      me->add("str", 1); tell_object(me, HIC "你觉得自己突然强壮了很多。原来臂力增加了。\n" NOR);
    }
  } else if (i > 1) {
    if (me->query("int") < 41) {
      me->add("int", 1); tell_object(me, HIR "你觉得自己突然茅塞顿开。悟性更进了一层。\n" NOR);
    }
  } else if (i > 0) {
    if (me->query("con") < 41) {
      me->add("con", 1); tell_object(me, HIB "你觉得自己突然浑身气血畅通。根骨比原来更加强劲。\n" NOR);
    }
  } else {
    if (me->query("con") < 41) {
      me->add("con", 1); tell_object(me, HIR "你觉得自己突然浑身气血畅通。根骨比原来更加强劲。\n" NOR);
    }
  }

  //        武功秘籍去掉	
  //        ob=new("/clone/box/book/book"+(random(12)+1));
  //        ob->move(me);
  //message("channel:chat", HIC"【江湖传闻】"GRN + me->query("name")+"得到"+HIR"失落的武林密籍:" + ob->query("name")+HIG"啦！\n"NOR,users() );
  destruct(this_object());
  return 1;
}
