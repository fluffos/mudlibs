// 免死金牌 
// BY KEINXIN @sj2 2003.3

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "免死金牌" NOR, ({ "miansi jinpai", "pai", "jinpai" }));
  set_weight(10);
  set("value", 100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 100000);
    set("long", "一块纯金的" + HIY "免死金牌" NOR + "，是一个武林的秘密组织的信物
使用" HIY "(miansi)" NOR "之后会有神秘组织的使者来确认，便可以在危难时刻化险为夷。\n");
    set("unit", "个");
  }
}
void init() {
  add_action("do_miansi", "miansi");
}
int do_miansi() {
  object me = this_player();
  if (me->query("免死金牌") > 0)
    return notify_fail("你已经被神秘组织认可过了！！\n");

  this_player()->add("免死金牌", 1);
  this_player()->start_busy(1);
  message_vision(HIY "$N拿出了免死金牌，立即出现一个蒙面人 ! " NOR "\n", this_player());
  tell_object(me, HIY "蒙面人点了点头，说道：我知道了，在你下次危难的时候我会来救你。说完，蒙面人收下了你的金牌，几个起落就不见了。\n" NOR);
  destruct(this_object());
  return 1;
}
void owner_is_killed() {
  destruct(this_object());
}
