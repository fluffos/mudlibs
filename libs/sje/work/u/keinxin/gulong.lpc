#include <ansi.h>

inherit NPC;

string ask_kar()
{
	object me = this_player();
    object *ob = filter_array(objects(), (: userp($1) && !wiz_level($1) :));
	int no;

	ob = filter_array(ob,
		(: $2->query("kar")	< $1->query("kar") :), me);
	no = sizeof(ob) + 1;
	return me->name()+RANK_D->query_respect(me)+"的福缘在目前江湖人士中排名第"
		+chinese_number(no)+"。";
}

int ask_score()
{
	object me = this_player();
    object *ob = filter_array(objects(), (: userp($1) && !wiz_level($1) :));
	int no;

	ob = filter_array(ob,
		(: $2->query("score")	< $1->query("score") :), me);
	no = sizeof(ob) + 1;

	command("say "+me->name()+RANK_D->query_respect(me)+"的江湖阅历在目前江湖人士中排名第"
		+chinese_number(no)+"。");
	message_vision(CYN "$N指着$n赞叹道：“"+me->name()+"是武林第"
		+chinese_number(no)+"名人！”\n" NOR, this_object(), me);
	return 1;
}

void create()
{
	set_name("古龙",({"gu long","gu"}));
	set("gender","男性");
	set("age",30);
        set("per", 28);
        set("dex", 30);
	set("long", @LONG
他就是一代武学宗师，功夫深不可测，不过已经退出江湖了。
但是如果你要打听一些江湖上的事情，他会很热心地告诉你。
LONG);
	set("combat_exp", 10000000);
	set("attitude", "friendly");
	set("inquiry",([
		"江湖阅历": (: ask_score :),
		"福缘": (: ask_kar :),
                "神书": "书剑贰中神书共有四十二本，你可以用help tasks获得有关方面知识！",
                "向导石": "只有靠"HIR"七"+HIC+"彩"+HIY+"向"+HIM+"导"+HIG+"石"NOR+CYN"才能找到神书，一两黄金一块！",			
	]) );
	set_skill("dodge",350);
	set_skill("parry",350);
	set_skill("unarmed",350);
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	
}


int accept_object(object me, object ob)
{
object shi; 
if( ob->query("money_id") && ob->value() >= 10000)
{	
	 if (!present("xdshi", me))
	{
	shi = new("/quest/shenshu/findbook");
	command("say 好吧,"+me->query("name")+"既然给了钱，我就给你一块！\n");
	shi->move(me);
	message_vision("$N将一块"HIR"七"+HIC+"彩"+HIY+"向"+HIM+"导"+HIG+"石"NOR"交给了$n。\n" , this_object(), me );
	} else 
	command("say 你不是有了一块嘛，还想要？钱我没收！\n");
return 1;
}

command("say 谢谢，但我不要这东西！");
return 0;
}

