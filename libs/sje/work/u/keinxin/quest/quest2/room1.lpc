

inherit ROOM;

void create()
{
	set("short", "房间b");
	
	set("exits", ([
		"east" : __DIR__"room2",
		"west" : __DIR__"room0",
		
	]));
	set("objects",([
			__DIR__"dog":1,
	]));
	setup();
}

void init()
{
        add_action("do_kick", "kick");
 }

int do_kick(string arg)
{
	object ob=present("dog", environment(this_player()));

	if(!arg||arg!="dog"||!objectp(ob)) return notify_fail("你要踢谁？\n");

	if(this_player()->is_busy()) return notify_fail("你正忙着呢。\n");
	this_player()->start_busy(1);
	if( !this_player()->query_temp("kick_dog")) this_player()->set_temp("kick_dog",0);
	this_player()->add_temp("kick_dog",1);
	message_vision("$N使出面目全非脚，向着$n踢去。\n",this_player(), ob);  
	

	switch (this_player()->query_temp("kick_dog")){
          case 1: 
		
		ob->kill_ob(this_player());
		message_vision("$N冲着$n就咬。\n",ob,this_player());  
		
		break;             
          case 2: 
		ob->remove_all_enemy();

		break;   
          case 3: 
		this_player()->delete_temp("kick_dog",1);
		
		message_vision("$N夹着尾巴溜走了。\n",ob);  
		ob->dest();
		break;         
         
          default :
                 this_player()->set_temp("kick_dog",0);

          }
return 1;
	
}


int valid_leave(object me, string dir)
{
      
       if((dir == "east" )&&
          objectp(present("dog", environment(me))))

          return notify_fail("你现在不能通过。\n");

       return ::valid_leave(me, dir);
}

