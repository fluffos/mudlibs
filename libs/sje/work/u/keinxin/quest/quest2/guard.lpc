inherit NPC;
//string ask_me();

void create() {
  set_name("门房", ({ "guard" }));


  setup();

}
void kill_ob(object me) {
  object ob;
  command("say 杀人拉，救命拉！");
  message_vision("$N急忙躲到门里面，把门“碰”一声关上了！\n", ob);
  if (!(ob = find_object(__DIR__ "room2")))
    ob = load_object(__DIR__ "room2");


  environment(this_object())->delete("exits/east");

  ::kill_ob(me);
}
void unconcious() {
  object ob;
  command("say 杀人拉，救命拉！");
  message_vision("$N急忙躲到门里面，把门“碰”一声关上了！\n", this_object());
  if (!(ob = find_object(__DIR__ "room2")))
    ob = load_object(__DIR__ "room2");

  ob->delete("exits/east");

  this_object()->dest();
}
int accept_object(object who, object ob) {

  if (ob->query("money_id") && ob->value() >= 30000) {
    tell_object(who, "门房一哈腰，说道：多谢了，您里面请。\n");
    who->set_temp("pass_ok", 1);
    return 1;
  }
  if (ob->query("short") == "NPC") {
    message_vision("$N大喊：杀人拉！门都忘了关就没影了。\n", this_object());
    this_object()->dest();
  }

  return 0;
}
