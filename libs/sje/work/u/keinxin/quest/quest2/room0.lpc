

inherit ROOM;

void create()
{
	set("short", "房间a");
	
	set("exits", ([
		"east" : __DIR__"room1",
		
	]));
	set("objects",([
			__DIR__"npc":1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
      
       if(dir == "east" && objectp(present("npc", environment(me))))

       return notify_fail("你现在不能通过。\n");          
       return::valid_leave(me, dir);
}
