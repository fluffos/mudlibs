inherit ROOM;

void create() {
  set("short", "房间c");
  set("long", @LONG
东面是一道门(door)。
LONG
  );


  set("exits", ([
    //"east" : "room3",
    "west": __DIR__ "room1",

  ]));
  set("item_desc", ([
    "door": "一道门。\n",
  ]));

  setup();
}
void init() {
  add_action("do_open", "open");
  add_action("do_knock", "knock");

}

int do_open(string arg) {
  if (!arg || (arg != "door"))
    return notify_fail("你要打开什么？\n");

  if (query("exits/east"))
    return notify_fail("门已经是开着的了。\n");


  return notify_fail("门打不开,敲敲(knock)看吧。\n");

}

int do_knock(string arg) {
  object ob;
  if (!arg || (arg != "door"))
    return notify_fail("你乱敲什么？\n");
  if (query("exits/east"))
    return notify_fail("门已经是开着的了。\n");

  if (!objectp(present("guard", environment(this_player())))) {
    message_vision("$N小心翼翼地在门上敲了几下。\n", this_player());
    message_vision("门吱呀一声开了，从里面走出一位门房。\n", this_player());
    ob = new(__DIR__ "guard");
    ob->move(this_object());
    set("exits/east", __DIR__ "room3");
  } else return notify_fail("你敲了半天，没有回应。\n");
  return 1;

}


int valid_leave(object me, string dir) {
  object ob = present("guard", environment(me));
  if (me->query_temp("pass_ok")) {
    me->delete_temp("pass_ok");
    return 1;
  }
  if (objectp(ob) && (dir == "east")) return notify_fail("门房一把把你拉住。\n");

  return ::valid_leave(me, dir);
}
