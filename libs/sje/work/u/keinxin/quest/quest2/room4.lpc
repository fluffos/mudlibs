inherit ROOM;

void create() {
  set("short", "房间e");

  set("exits", ([
    "west": __DIR__ "room3",

  ]));
  setup();
}

void init() {
  int i;
  object fighter;
  object ob = this_player();


  if (ob->query_temp("kill_npc"))
    for (i = 0; i < 5; i++) {
      write("一条黑影冲了上来。\n");
      fighter = new(__DIR__ "fighter");
      fighter->move(this_object());
      fighter->kill_ob(this_player());
    }
  return;
}
