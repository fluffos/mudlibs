// hongma.c 枣红马

#include <command.h>
#include <dbase.h>
#include <origin.h>
#include <ansi.h>

inherit NPC;

void create() {
  set_name("狗", ({ "dog" }));
  set("long", "一只狗。\n");
  set("race", "野兽");
  set("age", 5);
  set("int", 30);
  set("qi", 300);
  set("max_qi", 300);
  set("jing", 100);
  set("max_jing", 100);
  set("shen_type", 0);
  set("combat_exp", 50000);
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "腹部", "尾巴", "后腿", "前腿" }));
  set("verbs", ({ "bite", "hoof" }));


  setup();
}

void unconcious() {
  this_player()->delete_temp("kick_dog", 1);
  ::unconcious();

}
