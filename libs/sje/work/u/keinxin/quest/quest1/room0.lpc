inherit ROOM;

void create() {
  set("short", "房间a");

  set("exits", ([
    "east": __DIR__ "room" + random(4),
    "west": __DIR__ "room" + random(4),
    "south": __DIR__ "room" + random(4),
    "north": __DIR__ "room" + random(4),
  ]));
  setup();
}

void init() {
  object ob = this_player();
  int step, temp, count;

  if (!ob->query_temp("room0")) {

    ob->set_temp("room0", 1);

  }
  ob->delete_temp("room1", 1);
  ob->delete_temp("room2", 1);
  ob->delete_temp("room3", 1);


  return;
}
