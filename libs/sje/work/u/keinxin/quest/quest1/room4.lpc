

inherit ROOM;

void create()
{
	set("short", "房间e");
	
	set("exits", ([
		"east" : __DIR__"room"+random(4),
		"west" : __DIR__"room"+random(4),
		"south": __DIR__"room"+random(4),
		"north": __DIR__"room"+random(4),
	]));
	setup();
}

void init()
{
	object ob = this_player();
	object gift;
	
	if (ob->query_temp("room3")) {
		//ob->delete_temp("room3");
		gift=new("/clone/money/gold");
		gift->set_amount(10);
		gift->move(ob);
		tell_object(ob,"你得到了10两黄金的奖励。/n");
		
		
		
	}	
	return;
}
