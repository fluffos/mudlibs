

inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_open", "open");
}

void create()
{
	set_name("箱子", ({ "box"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		
		set("value",0);
	}
	setup();
}

int do_open(string arg)
{
	object book;
	if (!id(arg))
	return notify_fail("你要开什么？\n");
	if(!this_player()->query_temp("button_room"))
		return notify_fail("你未经许可，不得偷窥里面的秘密。\n");
	this_player()->delete_temp("button_room");
	if(query("button1")) 	delete("button1");
	if(query("button2")) 	delete("button2");

	book = new(__DIR__"book");
	book->set("name",this_player()->query("button_room")+"指南");
	book->move(this_player());

	message_vision("$N打开箱子，得到了一本"+book->query("name")+"!\n", this_player());
	destruct(this_object());
	return 1;
}


