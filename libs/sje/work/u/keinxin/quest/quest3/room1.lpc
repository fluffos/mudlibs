inherit ROOM;

void create() {
  set("short", "房间b");
  set("long", "房间中有一个按扭(button)。\n");

  set("exits", ([
    "west": __DIR__ "room2",

  ]));

  setup();
}

void init() {

  add_action("du_push", "push");
}

int do_push(string arg) {
  object ob;
  object room;
  if (!arg || arg != "button") return notify_fail("你要按什么？\n");
  if (this_player()->query_temp("button_room"))
    return notify_fail("这个任务必须由2个人完成。\n");
  message_vision("$N犹豫了一下，按了一下按扭，传来轧轧的声音。\n", this_player());
  if (!(room = find_object(__DIR__ "room2")))
    room = load_object(__DIR__ "room2");
  if (room = find_object(__DIR__ "room2")) {
    if (room->query("button1")) {
      ob = new(__DIR__ "box");
      ob->move(room);
      room->delete("button1");
    } else room->set("button2", 1);
    this_player()->set_temp("button_room", this_object()->query("short"));
    remove_call_out("button_recover");
    call_out("button_recover", 2);

  }

  return 1;


}

void button_recover() {
  object room;
  if (!(room = find_object(__DIR__ "room2")))
    room = load_object(__DIR__ "room2");
  if (room = find_object(__DIR__ "room2") && room->query("button2")) {
    room->delete("button2");
    message_vision("远处传来一阵响声。\n", this_player());
  }

}
