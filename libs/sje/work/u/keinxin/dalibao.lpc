// 超级大礼包 节日抽奖用
// BY KEINXIN

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "超级大礼包" NOR, ({ "dalibao", "bao", "libao" }));
  set_weight(10);
  set("no_drop", 1);
  set("no_put", 1);
  set("no_bug", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("no_get", 1);
  set("value", 0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_give", "每个人只有一个，你都这么大方！\n");
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 0);
    set("long", "一个用纯金制作成的" + HIY "超级大礼包，" NOR + "里面有很多东西，打开(opengift)看看。\n");
    set("unit", "个");
  }
}
void init() {
  add_action("do_open", "opengift");
}
int do_open() {
  int i, exp, pot;
  object me = this_player();
  object ob;
  exp = 1000 + random(2000);
  pot = exp / 3;
  this_player()->add("combat_exp", exp);
  this_player()->add("potential", pot);
  ob = new("/clone/money/gold");
  ob->set_amount(20);
  ob->move(this_player());
  this_player()->start_busy(1);
  message_vision("$N打开了超级大礼包，只觉得自己又变利害了一些，礼包里还有很多黄金 !\n", this_player());
  tell_object(me, HIY "你被奖励了：             \n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" NOR);

  i = random(5);


  if (i == 4) {

    ob = new("clone/armor/jixiang/huxin");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  } else if (i == 3) {

    ob = new("clone/armor/jixiang/huyao");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  } else if (i == 2) {

    ob = new("clone/armor/jixiang/huwan");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  } else if (i == 1) {

    ob = new("clone/armor/jixiang/armor");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  } else if (i == 0) {

    ob = new("clone/armor/jixiang/pifeng");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  } else {

    ob = new("clone/food/jiudai");
    ob->move(me);


    tell_object(me, HIR "你得到了" + ob->query("name") + "\n" NOR);

  }

  destruct(this_object());
  return 1;
}
void owner_is_killed() {
  destruct(this_object());
}
