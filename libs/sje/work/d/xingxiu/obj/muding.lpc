inherit ITEM;

void create() {
  set_name("小木鼎", ({ "mu ding", "ding" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只雕琢而成的暗黄色小木鼎, 木理之间隐隐泛出红丝。\n" +
      "鼎侧有五个铜钱大的圆孔，木鼎齐颈出有一道细缝，似乎上下分为两截。\n");
    set("value", 500);
    set("unique", 3);
  }
}

void init() {
  if (this_player() == environment())
    add_action("do_suck", "suck");
}

int do_suck(string arg) {
  object me = this_player();
  int i = (int)me->query_skill("poison", 1);
  int t = 1, j;
  if (arg != "blood" || !living(this_player()))
    return notify_fail("你要吸什么？\n");
  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成, 不能运功练毒。\n");
  if (me->is_fighting())
    return notify_fail("你在战斗中不能运功练毒。\n");
  //      if( !query("muding/remaining"))
  //                return notify_fail("你已经把木鼎中的血水吸光了。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里你静不下心来运功练毒。\n");
  for (j = 1; j < i / 10; j++) t *= 2;
  if (me->query("neili") < 10)
    return notify_fail("你的内力不够，不能运功练毒。\n");
  if ((int)me->query("shen") > 0)
    return notify_fail("你是侠义正士, 怎么能修炼如此阴狠的毒技? \n");
  if (i > 10 && (int)me->query("shen") > -t * 100)
    return notify_fail("只有大奸大恶之人才能继续修练毒技！\n");
  if ((int)me->query_skill("poison", 1) <= 101 && (int)me->query_skill("poison", 1) > 30) {
    me->receive_damage("jing", 10);
    me->receive_damage("jingli", 10);
    me->receive_damage("qi", 15);
    me->add("neili", -3);
    //            add("muding/remaining", -1);
    message_vision("$N伸掌将血液接住，盘膝运功，将血液吸入掌内。\n", me);
    switch (random(2)) {
      case 0:
        me->improve_skill("poison", (int)(me->query_int()));
        write("你只觉掌中微微一凉，一股阴气顺着脉络, 侵入脑髓。\n" "你对基本毒技的领会又加深了一些! \n");
        break;
      case 1:
        me->improve_skill("poison", (int)(me->query_int()));
        write("你只觉掌中微微一痒，一股毒气自掌沿手臂上升。\n" "你对基本毒技的领会又加深了一些! \n");
        break;
    }
    return 1;
  }
  return notify_fail("你不能从中运功练毒了。\n");
}
