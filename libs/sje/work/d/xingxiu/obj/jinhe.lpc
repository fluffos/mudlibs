#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIY"金盒"NOR, ({ "jin he", "box", "jinhe" }));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long",
                        "这是一个黄金雕成的盒子，小巧玲珑\n"
                        "此物是用来修练邪功千蛛万毒手之用\n"
                        "需先到苗疆产地将蜘蛛抓进盒子里(zhua zhizhu)\n"
                        "然后修炼毒功(xiulian)\n" );
                set("value", 0);
                set("material", "gold");
                set("no_drop",1);
                set("no_get",1);
                set("no_give",1);
        }
}

void init()
{
        if( this_player() == environment() )
        add_action("do_zhua", "zhua");
        add_action("do_xiulian","xiulian");
}

int do_zhua(string arg)
{
        object ob,me = this_player();
        if ( arg != "zhizhu" )
          return notify_fail("你要抓什么？\n");
        if(!me->query_temp("marks/万毒手"))
          return 0;
        if(!(ob=present("zhizhu",environment(me))))
          return notify_fail("这里没有毒蜘蛛。\n");
        if ( me->is_fighting()) 
          return notify_fail("你正在打架，打完架再抓吧。\n");
        if(this_object()->query("have_zhu",1)>=1)
          return notify_fail("盒子里已经有一只毒蜘蛛了。\n");
        if (me->is_busy())
          return notify_fail("你正忙着呢。\n");
        message_vision(HIY"$N把金盒一翻扣住毒蜘蛛，然后轻轻巧巧合上了盒子。\n"NOR,me);
        ob=present("zhizhu",environment(me));
        destruct(ob);
        this_object()->set("have_zhu",1);
        return 1;   
}

int do_xiulian()
{    
     object me=this_player();
     int improve,xl_times;
     xl_times=(100+random(50));
     
     if (!(this_object()->query("have_zhu")))
          return notify_fail("金盒是空的，无法修炼。\n");
     if (me->query("max_neili",1)<1000)
          return notify_fail("你内力尚浅，毒气攻心可不是玩的。\n");
     if (environment(me)->query("no_fight"))
          return notify_fail("这里不能修炼！\n");
     if (me->is_busy())
          return notify_fail("你正忙着呢。\n");
     if (me->is_fighting())
          return notify_fail("你正在打架，静下来再修炼吧。\n");
     if (me->query("neili",1)<50 )
          return notify_fail("你的状态太差，无法修炼武功。\n");
     if (me->query("gender") == "男性")
          return notify_fail("你一个大老爷子也去练这么阴毒的武功？\n");
        if (me->query_skill("poison", 1)<=me->query_skill("qianzhu-wandushou",1))
          return notify_fail("你的基本毒技不够，恐怕要反受其害。\n"); 
     improve=random(me->query_skill("poison",1))+me->query_int(); 
     message_vision(GRN"$N盘膝坐下行功，轻轻打开黄金小盒，将手指伸了进去。\n"
                       "毒蜘蛛慢慢移近，咬住$N的手指吸血。\n"NOR,me);
     me->disable_player("<修炼中>");
     me->start_busy(5+random(15));
     message_vision(HIB"\n$N深深吸一口气，双臂轻微颤抖，潜运内功和蛛毒相抗。\n"
                       "蜘蛛吸取手指上的血液为食，但$N手指上血脉运转，\n"
                       "也带了蜘蛛体内毒液，回入自己血中。\n"NOR,me);
     me->improve_skill("qianzhu-wandushou",improve);
     me->add("neili",-(30+random(improve)));
     me->add("jingli",-(30+random(improve)));
     if (me->query("jingli") <= 0 || me->query("neili") <=0)
     me->unconcious();
     message_vision(BLU"\n$N满脸庄严肃穆之容，同时眉心和两旁太阳穴上淡淡的罩上了一层黑气,\n"
                       "咬紧牙关，竭力忍受痛楚。再过一会，又见$N鼻尖上渗出细细的一粒粒汗珠。\n"
                       "蜘蛛直到吸饱了血，肚子胀得和圆球相似，这才跌在盒中，沉沉睡去。\n"NOR,me);
     this_object()->add("have_zhu",1);
     if (this_object()->query("have_zhu")>xl_times){
       write(GRN"毒蛛的身子从花转黑，再从黑转白，去净毒性而死，蜘蛛体中的毒液都到了你的手指中。\n"NOR);
       this_object()->delete("have_zhu");
       }
   return 1;
} 
