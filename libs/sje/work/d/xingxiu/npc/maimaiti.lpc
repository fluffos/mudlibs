// npc: /d/xingxiu/npc/maimaiti.c
// Jay 3/17/96
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("买卖提", ({ "maimaiti", "seller" }));
  set("title", "商铺老板");
  set("gender", "男性");
  set("unique", 1);
  set("age", 43);
  set("long",
    "买卖提是个中年维吾尔族商人，去过几次中原，能讲一点儿汉话。\n");
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("rank_info/respect", "大叔");

  set("vendor_goods", ([
    "/d/xingxiu/obj/hulu": 5,
    "/d/xingxiu/obj/fire": 5,
    "/d/xingxiu/obj/dongbula": 5,
    "/d/xingxiu/obj/hamigua": 5,
    "/d/xingxiu/obj/yangpi": 5,
    "/d/hj/obj/jiunang": 5,
    "/d/hj/obj/shuinang": 5,
    "/d/hj/obj/cheese": 5,
    "/clone/weapon/madao": 5,
    "/clone/weapon/mabian": 5,
    "/d/hj/obj/maotan": 5,
    "/clone/medicine/m-book2": 3,
    "/clone/weapon/wandao": 5,
    "/clone/armor/qun": 5,
    "/clone/armor/yangao": 5,
  ]));

  set("chat_chance", 3);
  set("chat_msg", ({
    "买卖提笑嘻嘻地说道：色兰姆阿里空。\n",
    "买卖提右手放在胸前，浅鞠一躬说道：阿里空色兰姆。\n",
  }));


  setup();
  carry_object(ARMOR_D("wcloth"))->wear();
  add_money("coin", 100);
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
