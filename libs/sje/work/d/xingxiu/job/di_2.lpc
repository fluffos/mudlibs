// for exp 250k-500k

#include <ansi.h>
inherit ITEM;
#include "target.h";
#include "stuffs.h";
mapping astuffs;
string target;

void create() {
  set_name(YEL "黄玉短笛" NOR, ({ "duandi", "di", }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", YEL "这玉笛短得出奇，只不来七寸来长、通体金黄，晶莹可爱。\n" NOR);
    set("value", 50000);
    set("no_get", 1);
    set("di_number", 1);
    set("no_drop", 1);
  }
  setup();
}
#include "di.h";
