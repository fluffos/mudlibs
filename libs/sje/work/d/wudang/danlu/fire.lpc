// fire.h
#include <ansi.h>
int do_fire(string arg)
{
	object obj;
	object me = this_object();
	object ob = this_player();
	object *inv;
	inv = deep_inventory(me);

	if( ob->is_busy() ) 
		return notify_fail("你正忙着呢。\n");

	if( ob->is_fighting() )
		return notify_fail("你正在战斗中！\n");

	if( me->query("marks/open", 1) )
		return notify_fail("丹炉的盖子"HIW"(lit)"NOR"没有盖上，你需要先盖上"HIY"(close)"NOR"它。\n");
	
      if( !objectp( obj = present("fire", ob)))   // 判断玩家身上是否有火折。
		return notify_fail("你需要一个"HIR"火折(fire)"NOR"来生起丹炉中的火。\n");
		
	if( (int)ob->query("neili", 1)  <= 1000 )
		return notify_fail("你的内力不够，点着了火也拉不动风箱。\n");		
		
	if( (int)ob->query("max_neili", 1)  <= 1500 )
		return notify_fail("你的内力不够，点着了火也拉不动风箱。\n");				

	if( ob->query_temp("fired"))
		return notify_fail("你已经把柴火点起来了。\n");   
		
	if( !sizeof(inv)) 
		return notify_fail("丹炉里面什么都没有，瞎点什么火？\n");
	message_vision(HIR"一堆柴火被$N点燃，火苗渐渐地大了起来。\n"NOR, ob);
	destruct(obj);
	ob->set_temp("fired", 1);
	me->set("marks/doing", 1);        
	remove_call_out("do_check");
	call_out("do_check", 70, me);
	return 1;
}
                                    
void do_check()
{
	object ob = this_player();
	object me = this_object();
	object *obj;
	int i;

	obj = deep_inventory(me);

	if ( (int)me->query("marks/doing", 1) > 0) 
	{
	write("火苗渐渐地熄灭了，丹炉里面一片焦黑，你什么丹药也没练出来。\n", ob);	
	for(i=0; i<sizeof(obj); i++) {
	destruct(obj[i]);
	}
	if( userp(ob) ) log_file("nosave/LIAN_DAN",
	sprintf("%s %s(%s) 因为煎糊丹炉炼丹失败 on %s。\n", ob->query("title"), ob->name(1), geteuid(ob), ctime(time()) ) );	
		me->delete("marks/doing");
		me->delete("liquid/remaining");
		me->delete("liquid/name");
		ob->delete_temp("fired");
	}
	return;
}
