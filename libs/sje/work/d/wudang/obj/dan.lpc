// dan.c
#include <ansi.h>
inherit ITEM;
void init() {
  add_action("do_eat", "eat");
  //        add_action("do_eat1", "fu");
}
void create() {
  set_name(HIY "精锐养气丹" NOR, ({ "xian dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一颗黑不溜秋的丹丸好像可以吃下(eat)。\n");
    set("value", 0);
    set("unit", "颗");
    set("no_get", 1);
    set("no_drop", 1);
    set("no_give", 1);
    set("user", "douzige");
  }
}

int do_eat(string arg) {
  object me, obj;
  int exp;
  int pot;
  obj = this_object();
  me = this_player();
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  if (obj->query("user") != me->query("id")) {
    message_vision(HIR "你吃一下颗精锐养气丹，感觉……\n" NOR, me);
    destruct(obj);
    me->unconcious();
    return 1;
  }
  exp = 40 + random(me->query_int() * 4);
  pot = exp / 3;

  if (((int)me->query("potential", 1) + pot) > (int)me->query("max_pot", 1)) {
    me->set("potential", (int)me->query("max_pot", 1));
  }
  if (((int)me->query("potential", 1) + pot) <= (int)me->query("max_pot", 1)) {
    me->add("potential", pot);
  }

  if (exp > 120) exp = 100 + random(21);
  me->add("combat_exp", exp);
  message_vision(HIG "$N吃下一颗精锐养气丹，顿时好象一股暖流传遍了奇经八脉！\n" NOR, me);
  tell_object(me, HIW "你增加了" + chinese_number(exp) + "点经验！\n" NOR);
  tell_object(me, HIW "你增加了" + chinese_number(pot) + "点潜能！\n" NOR);
  destruct(obj);
  return 1;
}
