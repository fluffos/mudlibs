#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit NPC;

string ask_gift(); 
string ask_chuangong();
 


void create()
{
        int age = 20 + random(20);
        set_name("武馆门卫", ({ "men wei", "menwei", "wei" }));
        set("gender", "男性");
        set("age", age);
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set("apply/attack", 30);
        set("apply/defense", 30);
        set("apply/damage", 35);
        set("combat_exp", 150+age*10);
        set("shen_type", 1);

        set("inquiry", ([
                "礼物"          : (: ask_gift :),      
                "传功"          : (: ask_chuangong :),     
        ]));
        
        set("gong_count", 100);
        setup();
        add_money("silver", 3+age/10);
        carry_object(ARMOR_D("cloth"))->wear();
}

string ask_gift()    
{
        object ob;
        if ( (int)this_player()->query("newbieliwu" ) > 0)
                return RANK_D->query_respect(this_player()) + 
                "你已经拿过了";
        ob = new("/u/keinxin/libao");
        ob->move(this_player());

        this_player()->set("newbieliwu",1);

        message_vision("$N获得一个礼包。\n",this_player());
        return "好吧，未来武林路途艰险，这个礼包就当作是你闯荡江湖的开始。";

}

string ask_chuangong()    
{
        if (query("gong_count") < 1) return "对不起，我今天太累了，让我休息一下。";

        if ( (int)this_player()->query("门卫传功" ) > 2)
                return RANK_D->query_respect(this_player()) + 
                "我已经帮你传了三次了，还闲不够？？";
        
        if ( (int)this_player()->query("max_neili" ) > 600)
                return RANK_D->query_respect(this_player()) + 
                "你的内力已经比我深厚了，传功给我吧！";
        
        
        this_player()->add("门卫传功",1);
        this_player()->add("max_neili",100);
        add("gong_count", -1);
        this_player()->start_busy(5);

        message_vision(HIY"门卫将手贴在$N的后心，运起内功。$N只觉得浑身奇经八脉无比舒畅，内力大增。\n",this_player());
        return "我的功力已经传给你了。";

}


