// NPC: /d/huashan/npc/eyu.c
// Date: Look 99/03/25

inherit NPC;

void create()
{
        set_name("鳄鱼", ({ "eyu" }));
        set("race", "野兽");
        set("age", 10);
        set("long", "一条庞大无比的大鳄鱼，张开大嘴象你游来。\n");
        set("attitude", "aggressive");
        set("str", 30);
        set("con", 50);
        set("max_qi", 800);
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set("combat_exp", 500000);
        set_temp("apply/attack", 200);
        set_temp("apply/armor", 200);
        setup();
}

void die()
{
        object ob, sword;
        sword = unew("/clone/weapon/bishui-jian");
        if( !clonep(sword) ) {
        message_vision("$N抽搐了几下，身体缩在一起，死了。\n", this_object());
        }
        else {
        sword->move(environment(this_object()));
        message_vision("$N抽搐了几下，身体缩在一起，死了。\n", this_object());
        }
        destruct(this_object());
}
