inherit NPC;

void create() {
  set_name("仆人", ({ "pu ren", "puren", }));
  set("long", "一个烧饭扫地的仆人\n");
  set("gender", "男性");
  set("age", 26);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 23);
  set("int", 23);
  set("con", 24);
  set("dex", 28);

  set("max_qi", 300);
  set("max_jing", 180);
  set("neili", 300);
  set("max_neili", 300);
  set("eff_jingli", 180);

  set("jiali", 5);
  set("combat_exp", 5000);
  set("score", 50);

  set_skill("unarmed", 20);

  setup();
  carry_object(ARMOR_D("armor/cloth"))->wear();
}
