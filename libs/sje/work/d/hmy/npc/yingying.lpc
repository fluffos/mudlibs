#include <ansi.h>
#include "hmy_def.lpc"
inherit NPC;
#include "job_npc.h"
#include "job_1.h"

int ask_renzhi();
int do_check_two();
int go_where();
int do_ok();
int do_letout();

void create()

{
        
        set_name("任盈盈", ({ "ren yingying","ren" }));
        set("long", "她长得极美，尤其是那对眼睛，媚得直可以勾人魂魄。\n");
        set("nickname", HIR"小魔女"NOR);
        set("title", HIY"日月神教  圣姑"NOR);
        set("gender", "女性");
        set("attitude", "peaceful");
        set("age", 20);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per", 30);
        set("unique", 1);
        set("location", 1);
        set_temp("no_return", 1);
        set("startroom",__HMY__"pingding/kedian");

        set("max_qi", 1500);
        set("qi", 1500);
        set("jing", 1300);
        set("max_jing", 1300);
        set("neili", 2400);
        set("max_neili", 2400);
        set("eff_jingli", 1700);
        set("jingli", 1700);
        set("jiali", 50);
        set("combat_exp", 180000);
        set("shen", -1200);

        set_temp("apply/attack", 40);
        set_temp("apply/strength", 40);
        set_temp("apply/defence", 40);
        set_temp("apply/dexerity", 40);

        set_skill("tianmo-zhang",100);
        set_skill("strike", 100);
        set_skill("parry", 100);
        set_skill("dodge",100);
        set_skill("ding-dodge", 100);
        set_skill("force", 100);
        set_skill("tianmogong", 100);

        map_skill("strike", "tianmo-zhang");
        map_skill("dodge", "ding-dodge");
        map_skill("force", "tianmogong");
        map_skill("parry", "tianmo-zhang");
        prepare_skill("strike", "tianmo-zhang");
        set("inquiry", ([
                "人质" : (: ask_renzhi :),
                "黑木崖" : (: go_where :),
                "完成": (: do_ok :),
                "letout": (: do_letout :),
        ]));

        set_temp("hostage/gived",0);

        set("chat_chance", 20);
        set("chat_msg", ({
           (: random_move :),           
        }));
        
        setup();

        carry_object("/clone/misc/cloth")->wear();        
}

void init()
{       
        object ob;

        ::init();

//        if (base_name(environment(me)) != query("startroom")) return;
        if( interactive(ob = this_player())
        &&  userp(ob)
        &&  visible(ob))
        {
            if (ob->query_temp("hostage/doone"))
                {
                        remove_call_out("greeting_1");
                        call_out("greeting_1", 1, ob);
                        return;
                }
            if (ob->query_temp("hostage/dotwo"))
                {
                        remove_call_out("greeting_2");
                        call_out("greeting_2", 1, ob);
                        return;
                }
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void do_back()
{
        message_vision("$N看也不看你一眼，一转身不见了。\n", this_object());
        this_object()->set("chat_chance", 20);
        switch(random(11))
        {
                case 0: this_object()->move("/d/xiangyang/cross2"); break;
                case 1: this_object()->move("/d/city/xidajie3"); break;
                case 2: this_object()->move("/d/huashan/yunu"); break;
                case 3: this_object()->move("/d/city/guangchangbei"); break;
                case 4: this_object()->move("/d/suzhou/canglangting"); break;
                case 5: this_object()->move("/d/fuzhou/zhongxin"); break;
                case 6: this_object()->move("/d/hz/tianxianglou"); break;
                case 7: this_object()->move("/d/dali/dalics"); break;
                case 8: this_object()->move("/d/village/squarepishou"); break;
                case 9: this_object()->move("/d/huanghe/yongdeng"); break;
                case 10: this_object()->move("/d/hmy/pingding/kefang"); break;
        }
        this_object()->set("qi",this_object()->query("max_qi"));
        this_object()->set("eff_qi",this_object()->query("max_qi"));
        this_object()->set("max_neili",this_object()->query("max_neili"));
        this_object()->set("neili",this_object()->query("max_neili"));
        this_object()->set("max_jing",this_object()->query("max_jing"));
        this_object()->set("jing",this_object()->query("jing"));
        this_object()->set("jingli",this_object()->query("eff_jingli"));
        this_object()->clear_condition();
        if (!this_object()->query_temp("hostage/ready"))
        {
                call_out("do_ready",1);
        }
        message_vision("$N匆匆忙忙地走了过来。\n"NOR, this_object());
}

void kill_ob(object me)
{
        object ob = this_player();
        
        command("fear" + ob->query("id"));
        remove_call_out("do_flee");
        call_out("do_flee", 1);

        ::kill_ob(me);
}

int do_hit(string arg)
{
        object me,ob;
        me=this_player();
        ob=this_object();
        
        if((arg==("ren"))||(arg==("ren yingying")))
        {       
                command("peace " + me->query("id"));
                remove_call_out("do_flee");
                call_out("do_flee", 1);

                COMBAT_D->do_attack(me, ob, me->query_temp("weapon") );
                COMBAT_D->do_attack(ob, me, ob->query_temp("weapon") );
                me->fight_ob(ob);
                ob->fight_ob(me);
                return 1;
        }
        return 0;        
}

int do_flee()
{
        object ob = this_object();
        
        if(ob->query("qi")<(ob->query("max_qi")/2))
        {
                ob->remove_all_killer();                
                remove_call_out("do_back");
                call_out("do_back",1);
                return 1;
        }
        if(ob->is_fighting())
        {
                remove_call_out("do_flee");
                call_out("do_flee", 1);
        }
        return 1;
}


void unconcious()
{    
      command("faint");        
      call_out("do_back", 0);       
}

void die()
{
      call_out("do_back", 0);           
}

void greeting(object ob)
{
        object me = this_object();
        
        if (!ob
        ||  !present(ob, environment(me)))
                return;
        if (userp(ob))
        {
                switch( random(2) )
                {
                        case 0:
                                command("hi " + ob->query("id"));
                                break;
                        case 1:
                                command("wanfu " + ob->query("id"));
                                break;
                }
        }
}

int greeting_1(object ob)
{
        object me = this_object();
        object obj, another;
        object *team;
        int i;
        
        team = ob->query_team();
        if (!team)
        {
                command("say 你的队伍呢？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if (sizeof(team)<2 )
        {
                command("say 咦？你的队伍怎么少人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if(sizeof(team)>2)
        {
                command("say 咦？你的队伍怎么突然多人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);                
                return 1;
        }
        for (i=0;i<sizeof(team);i++)
        {
                if (!team[i])
                {
                        command("say 你的队伍出现了问题，请解散并重新组建。");
                        ob->delete_temp("hostage");
                        ob->clear_condition("hostage_1");
                        ob->apply_condition("hostage_busy",20 + random(10));
                        me->set_temp("hostage/gived",0);                        
                        return 1;
                }
        }
        if (ob==team[0])
                another = team[1];
        else
        {
                another = team[0];
                ob = team[1];
        }
        
/*
        if (ob->query("id") != me->query_temp("hostage/player1") )
        {
                command("say 注意，异常错误！" + ob->query("id") + "不是" + me->query_temp("hostage/play2") + "。");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);                
                return 1;
        }
*/

        if (another->query("id") != ob->query_temp("hostage/partner"))
        {
                command("sigh");
                command("say 既然你的队友已经退出了，那。。。。就算了吧！");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->delete_temp("hostage");
                me->set_temp("hostage/gived",0);
                return 1;
        }

        if (!(obj=present("tong baixiong",environment(me))))
        {
                command("say 你找的童百雄，他人呢？");
                return 1;
        }
        if (!ob->query_temp("hostage/passed_x"))
        {
                command("say 你究竟有没有向他询问有关东方不败的事情呀！");
                return 1;
        }
        command("touch tong baixiong");
        tell_room(environment(me),"童百雄在任盈盈耳边小声地说了些话。\n");
        tell_room(environment(me),CYN"任盈盈对着童百雄关心的说道：你一路上辛苦了，先去休息吧。\n"NOR);
        destruct(obj);
        if (!present(another->query("id"),environment(me)))
        {
                command("say 看来你的队友" + another->name() + "还没回来，我们在这里等等他吧。");
                return 1;
        }
        command("thumb " + ob->query("id"));
        if (!another->query_temp("hostage/passed_l"))
        {
                command("hmm " + another->query("id"));
                command("say " + RANK_D->query_respect(another) + "，你好象还没去找令狐冲吧？");
                return 1;
        }
        command("thumb " + another->query("id"));
        ob->delete_temp("hostage/doone");
        ob->delete_temp("hostage/passed_l");
        another->delete_temp("hostage/dotwo");
        remove_call_out("do_fail");
        call_out("do_next",1,ob,another);
        return 1;
}

int greeting_2(object ob)
{
        object obj, another;
        object me = this_object();
        object *team;
        int i;
        
        team = ob->query_team();
        if (!team)
        {
                command("say 你的队伍呢？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if (sizeof(team)<2 )
        {
                command("say 咦？你的队伍怎么少人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if(sizeof(team)>2)
        {
                command("say 咦？你的队伍怎么突然多人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);                
                return 1;
        }
        for (i=0;i<sizeof(team);i++)
        {
                if (!team[i])
                {
                        command("say 你的队伍出现了问题，请解散并重新组建。");
                        ob->delete_temp("hostage");
                        ob->clear_condition("hostage_1");
                        ob->apply_condition("hostage_busy",20 + random(10));
                        me->set_temp("hostage/gived",0);                        
                        return 1;
                }
        }
        if (ob==team[0])
                another = team[1];
        else
        {
                another = team[0];
                ob = team[1];
        }
        if (another->query("id") != ob->query_temp("hostage/partner"))
        {
                command("sigh");
                command("say 既然你的队友已经退出了，那。。。。就算了吧！");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }

        if (!(obj=present("ling huchong",environment(me))))
        {
                command("say 你找的令狐冲，他人呢？");
                return 1;
        }
        if (!ob->query_temp("hostage/passed_l"))
        {
                command("say 你究竟有没有问他要黑木令呀！");
                return 1;
        }
        command("touch ling huchong");
        tell_room(environment(me),"令狐冲在任盈盈耳边小声地说了些话。\n");
        tell_room(environment(me),"令狐冲给任盈盈一块黑木令。\n");
        tell_room(environment(me),CYN"任盈盈对着令狐冲关心的说道：你一路上辛苦了，先去休息吧。\n"NOR);
        destruct(obj);
        if (!present(another->query("id"),environment(me)))
        {
                command("say 看来你的队友" + another->name() + "还没回来，我们在这里等等他吧。");
                return 1;
        }
        command("thumb " + ob->query("id"));
        if (!another->query_temp("hostage/passed_l"))
        {
                command("hmm " + another->query("id"));
                command("say " + RANK_D->query_respect(another) + "，你好象还没去找童百雄吧？");
                return 1;
        }
        command("thumb " + another->query("id"));
        ob->delete_temp("hostage/doone");
        ob->delete_temp("hostage/passed_l");
        another->delete_temp("hostage/dotwo");
        remove_call_out("do_fail");
        call_out("do_next",1,ob,another);
        return 1;
}

int do_ok()
{
        object ob = this_player();
        object me = this_object();
        object *team, another;
        int i, give=1;;
        
        team = ob->query_team();
        if (!team)
        {
                command("say 你的队伍呢？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if (sizeof(team)<2 )
        {
                command("say 咦？你的队伍怎么少人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }
        if(sizeof(team)>2)
        {
                command("say 咦？你的队伍怎么突然多人了？");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);                
                return 1;
        }
        for (i=0;i<sizeof(team);i++)
        {
                if (!team[i])
                {
                        command("say 你的队伍出现了问题，请解散并重新组建。");
                        ob->delete_temp("hostage");
                        ob->clear_condition("hostage_1");
                        ob->apply_condition("hostage_busy",20 + random(10));
                        me->set_temp("hostage/gived",0);                        
                        return 1;
                }
        }
        if (sizeof(team) != 0 && (team[0]!=ob)) 
        {
                command("say 只有队伍首领才能提出完成任务。");
                return 1;
        }
        another = team[1];
        
        if (another->query("id") != ob->query_temp("hostage/partner"))
        {
                command("sigh");
                command("say 既然你的队友已经退出了，那。。。。就算了吧！");
                ob->delete_temp("hostage");
                ob->clear_condition("hostage_1");
                ob->apply_condition("hostage_busy",20 + random(10));
                me->set_temp("hostage/gived",0);
                return 1;
        }

        if (!userp(another = present(ob->query_temp("hostage/partner",environment(ob)))))
        {
                command("hmm");
                command("say 你的同伴还没来吧？");
                return 1;
        }
        if (ob->query_temp("hostage/toone"))
        {
                give += ob->query_temp("hostage/killed");
                command("say "+ give + "是奖励。");
// 奖励：待定
        }
        else if (ob->query_temp("hostage/totwo"))
        {
                give += ob->query_temp("hostage/killed");
                command("say "+ give + "是奖励。");
// 奖励：待定
        }
        else return 0;
        
        ob->delete_temp("hostage");
        another->delete_temp("hostage");
        ob->apply_condition("hostage_busy",10 + random(10));
        another->apply_condition("hostage_busy",10 + random(10));
        
        me->delete_temp("hostage");
        me->set_temp("hostage/gived",0);
        return 1;
}
