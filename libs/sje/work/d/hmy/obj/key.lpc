// key.c 监狱钥匙
// Created by Numa 19991023

#include <ansi.h>
inherit ITEM;
#include "hmy_def.lpc"
#define JAIL_GATE "/d/hmy/jail_gate"

void create()
{
	set_name("钥匙",({"yao shi","key"}));
	set_weight(500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long","这是一把青铜钥匙。\n");
		set("material", "steel");
		set("unit", "把");
		set("value", 0);
		set("no_drop",1);
		set("no_give",1);
		set("no_get",1);
	}
	
	setup();
}

void init()
{
	object ob = this_player();
	object me = this_object();
	
	if (present("yao shi",ob))
//	&&  me->query_temp("owner") == ob->query("id"))
	{
		add_action("do_unlock","unlock");
	}
}

int do_unlock(string arg)
{
	object ob = this_player();
	object me = this_object();
	object room,here,obj,another,npc1,npc2,npc3,npc4;

	if (!arg)
		return notify_fail("你要打开什么？\n");
	if (arg != "lock" && arg != "锁")
		return notify_fail("你要打开什么？\n");

	here = environment(ob);
	room = load_object(__HMY__"jail");
	if (base_name(here) != JAIL_GATE)
		return notify_fail("这里好象没有锁呀？\n");
	another = present(ob->query("hostage/partner"),here);
	if (!another)
		return notify_fail("你的同伴还没有来，等一下他吧。\n");
	tell_object(ob,"你从容的拿出钥匙，只听「啪」的一声，门锁打开了。\n");
	
	obj = present(ob->query("hostage/hostage_i"),room);
	if (!obj)	return notify_fail("咦？人质呢？\n")
	if (userp(obj))
	{
		tell_object(obj,"你正在纳闷如何出去时，大门「哐铛」一声打开了。\n");
		obj->move(here);
		tell_room(here,obj->name() + "从"HIB"监狱"NOR"里走了出来。\n",({obj}));
		tell_object(obj,"你急忙走了出去，你发现原来是"+ ob->name() +"和"+ another->name() +"一起救你出来的。\n");
		tell_object(obj,"你感动之余，决定跟随"+ another->name() +"一起脱离这里。\n");
		obj->set_leader(another);
		message_vision("$n决定跟随$N一起行动。",obj,another);
	}
	else
	{
		obj->move(here);
		tell_room(here,obj->name() + "从"HIB"监狱"NOR"里走了出来。\n",({obj}));
		obj->set_leader(another);
		message_vision("$n决定跟随$N一起行动。",obj,another);
	}
	tell_room(here,"就在这时，日月神教总管杨莲亭冲了过来，看见了你们之后，扭头就跑！\n");
	message_vision("$N回头说道：“我去追他，咱们客栈回合。”说完就匆匆忙忙的去追赶逃跑的杨莲亭。\n",ob);
	npc1 = new(__HMY__"npc/yang");
	npc1->set_temp("target2",ob->query("id"));
	npc1->move(__HMY__"xiaohuayuan");
	ob->move(__HMY__"xiaohuayuan");
	message_vision("$N对着$n大叫道：“"+ RANK_D->query_rude(npc1) +"，哪里跑，站住！”\n",ob,npc1);
	message_vision("$n急忙收步，对着$N狞笑道：“既然你不肯放过我，也休怪我无情！”\n",ob,npc1);
	message_vision("$N立刻准备动身带着$n离开这里。\n",another);
	message_vision("就在这时，魔教三长老也问讯赶到。");
	npc1 = new(__HMY__"npc/qu");
	npc1->set_temp("target",another->query("id"));
	npc1->move(here);
//	npc2 = new();
//	npc3 = new();
	return 1;
}