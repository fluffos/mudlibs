// /d/shaolin/xct.c
// keinxin @sj2 2003.3
inherit ROOM;

#include <ansi.h>


void create()
{
	set("short", HIG"玉壁"NOR);
	set("long", @LONG
一块洁白无暇的玉壁，足有二人那么高，大半部隐在花树丛中，东南西
北尽是悬崖峭壁，只有刚爬下来的山坡比较最斜，其他各处决计无法攀上，
旁边生长着一丛丛的茶花，摇夷生姿。
LONG
        );
        set("outdoors", "大理");
        set("exits", ([
                "east" : __DIR__"xihubian",
        ]));

        setup();

}

void init()
{
       object me = this_player();
      
       me->set_temp("wait", 1);
       call_out("do_wait", 20 + random(10), me);
       add_action("do_jump", "jump");
       add_action("do_lingwu", "lingwu");
       add_action("do_look", "look");

}

void do_wait(object me)
{
        
        if(environment(me) && me->query_temp("wait") ) 
          {
           write(HIY"\n你悄立湖边，思涌如潮，心中思绪万千。突然觉得眼前的玉壁上似乎有些古怪。\n"NOR);
           me->del_temp("wait");
		   me->set_temp("yubi",1);
           }
}

int do_look(string arg)
{
	object me = this_player();

	if (!me->query_temp("yubi")) {
		set("long", @LONG
一块洁白无暇的玉壁，足有二人那么高，大半部隐在花树丛中，东南西
北尽是悬崖峭壁，只有刚爬下来的山坡比较最斜，其他各处决计无法攀上，
旁边生长着一丛丛的茶花，摇夷生姿。
LONG
);
		me->look(arg);
	}
	else {
		if (!arg) {
			set("long", @LONG
一块洁白无暇的玉壁，足有二人那么高，大半部隐在花树丛中，东南西
北尽是悬崖峭壁，只有刚爬下来的山坡比较最斜，其他各处决计无法攀上，
旁边生长着一丛丛的茶花，摇夷生姿。
你悄立湖边，思涌如潮，心中思绪万千。突然觉得眼前的玉壁(yubi)上似
乎有些古怪。
LONG
);
			me->look(arg);
		}
		else if (arg == "yubi" || arg == "bi" || arg == "yu bi") {
			write("一块通体晶莹的玉壁，里面好像有两个人影正在舞剑。\n");
			me->set_temp("yubi2", 1);
			return 1;
		}
       }		
}

int do_lingwu(string arg)
{
               object me;
               me = this_player();
               if (arg !="yubi"|| !me->query_temp("yubi2")) 
                   return notify_fail("你要看什么？\n");
               if (me->query("jing")<100) 
                   return notify_fail("你先休息一下吧！\n");                   
                if (me->query_skill("beiming-shengong",1)<140) 
                    return notify_fail("你看了看，但是由于内功太浅，什么也没看懂。\n");
                else {
                
                me->receive_damage("jing", random(me->query_skill("force",1))/2+10);
        message_vision("$N正在出神的望着那块玉壁。\n", me);
 
        write(HIG"你出神的看着那块玉壁中的人影，隐隐约约，好像看到一套精妙的剑法。\n");
        me->improve_skill("yubi-jianfa", me->query_skill("beiming-shengong")/5);       
         return 1;
                
        
           }
}

int valid_leave(object me,string dir)
{
        if (me->query_temp("wait"))
                me->delete_temp("wait");
				me->delete_temp("yubi");
				me->delete_temp("yubi2");     
        return ::valid_leave(me,dir);
}
