// duan_yu.c 段誉

inherit NPC;
#include <ansi.h>
string ask_me();

void create() {
  object ob;
  set_name("段誉", ({ "duan yu", "duan", "yu" }));
  set("title", HIW "镇南王府世子" NOR);
  set("long", "一个二十多岁模样的年轻男子，神情怔怔的不知道在想什么事。\n");
  set("gender", "男性");
  set("age", 23);
  set("attitude", "friendly");
  set("unique", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 28);

  set("max_qi", 5000);
  set("max_jing", 3000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("eff_jingli", 3000);
  set("jiali", 100);
  set("combat_exp", 2000000);
  set("shen", 25000);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "finger.ciqu" :)
  }));

  set_skill("force", 200);
  set_skill("beiming-shengong", 200);
  set_skill("dodge", 200);
  set_skill("lingbo-weibu", 200);
  set_skill("finger", 200);
  set_skill("liumai-shenjian", 201);
  set_skill("parry", 200);
  set_skill("literate", 200);
  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingbo-weibu");
  map_skill("finger", "liumai-shenjian");
  map_skill("parry", "lingbo-weibu");
  prepare_skill("finger", "liumai-shenjian");
  set("inquiry", ([
    "六脉神剑": (: ask_me :),
  ]));

  setup();
  carry_object("/clone/misc/jinduan")->wear();
}

string ask_me() {
  mapping fam;
  string msg;
  object me = this_player();
  fam = me->query("family");
  if (!fam || fam["family_name"] != "天龙寺")
    return RANK_D->query_respect(me) + "与本派素无来往，不知此话从何谈起？";
  if ((!me->query_temp("meet_mu2") || !me->query("dali/meet_dy1"))
    && !me->query("dali/meet_dy2")) {
    command("? " + me->query("id"));
    return "六脉神剑可是大理绝学，你我素无往来，不知此话从何谈起？";
  }
  if (me->query("liumai_quest")) {
    if (me->query("liumai_quest") <= me->query("liumai_duan"))
      return "我不是已经教了你这一路指法，你还是快点去练习吧。";
    if (me->query("liumai_quest") == 1) msg = " 真气自丹田而至肩臂诸穴，同清冷渊而到肘弯的天井，凝聚真气，通至无名指的关冲穴。";
    if (me->query("liumai_quest") == 2) msg = " 真气更下而至四渎、三阳络、会宗、外关、阳池、中渚、注液门，通至食指的商阳穴。";
    if (me->query("liumai_quest") == 3) msg = " 真气自腋下的极泉穴，青灵穴，经灵道、通里、神门、少府诸穴，通至右手小指的少冲穴。";
    if (me->query("liumai_quest") == 4) msg = " 真气循肘上三寸至青灵穴，至肘内陷后的少海穴，经灵道诸穴，通至左手小指的少泽穴。";
    if (me->query("liumai_quest") == 5) msg = " 真气自大渊，回到尺泽，向下而至鱼际，曲折沿臂而上，升至肘弯，通至拇指的少商穴。";
    command("bow " + me->query("id"));
    command("whisper " + me->query("id") + msg);
    tell_object(me, "你听了段誉的讲解，对六脉神剑领悟了不少。\n");
    me->add("liumai_duan", 1);
    return "这一路指法，你可要认真记住。";
  }
  if (me->query_skill("liumai-shenjian", 1))
    return "这位" + RANK_D->query_respect(me) + "不是已经学会中冲剑了吗？好好练习吧。";
  command("bow " + me->query("id"));
  command("whisper " + me->query("id") + " 所谓六脉，即手之六脉太阴肺经、厥阴心包经、少阴心经、太阳小\n" +
    "肠经、阳明胃经、少阳三焦经。");
  me->set_skill("liumai-shenjian", 1);
  me->set("dali/meet_dy2", 1);
  tell_object(me, HIC "你的「六脉神剑」进步了！\n" NOR);
  return "这六脉神剑乃我大理之宝，我先教你一路中冲剑，还望这位" + RANK_D->query_respect(me) + "将其发扬广大。";
}
