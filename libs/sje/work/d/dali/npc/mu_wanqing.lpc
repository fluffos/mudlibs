// NPC :mu_wanqing 木婉清
// By River 98/12
inherit NPC;
string ask_duan();
void create() {
  set_name("木婉清", ({ "mu wanqing", "mu", "wanqing" }));
  set("gender", "女性");
  set("age", 19);
  set("str", 17);
  set("con", 23);
  set("dex", 26);
  set("int", 25);
  set("per", 30);
  set("attitude", "friendly");

  set("max_qi", 1000);
  set("max_jing", 800);
  set("eff_jingli", 800);
  set("neili", 1000);
  set("qi", 1000);
  set("max_neili", 1000);
  set("unique", 1);

  set("long", "一个黑衣女子，瞧不清面貌，背影苗条，一丛乌油油的黑发作闺女装束。\n");
  set("combat_exp", 200000);
  set("shen", 800);

  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("strike", 80);
  set_skill("blade", 80);
  set_skill("xiuluo-dao", 80);
  set_skill("qiantian-yiyang", 80);
  set_skill("tianlong-xiang", 80);
  set_skill("qingyan-zhang", 90);
  map_skill("dodge", "tianlong-xiang");
  map_skill("parry", "xiuluo-dao");
  map_skill("strike", "qingyan-zhang");
  map_skill("force", "qiantian-yiyang");
  map_skill("blade", "xiuluo-dao");
  prepare_skill("strike", "qingyan-zhang");

  set("inquiry", ([
    "段誉": (: ask_duan :),
  ]));

  setup();
  carry_object("/clone/weapon/blade")->wield();
  carry_object("/d/dali/npc/obj/heipao")->wear();
}

string ask_duan() {
  object ob = this_player();
  object me = this_object();
  if (ob->query_temp("meet_mu2"))
    return "我不是已经告诉你段郎在哪里了么！";
  if (ob->query_temp("duanyu/find2")) {
    ob->set_temp("meet_mu", 1);
    ob->delete_temp("duanyu/find2");
    command("sigh");
    return "这位" + RANK_D->query_respect(ob) + "，别提这件事了。";
  }
  command("sigh");
  return "我现在什么都不知道。";
}

int accept_object(object me, object ob) {
  if (ob->query("id") == "yu zhuozi"
    && ob->query_temp("give_player") == me->query("id")
    && me->query_temp("meet_mu")) {
    command("nod" + me->query("id"));
    command("say 想不到这位" + RANK_D->query_respect(me) + "还能找到这个玉镯子。");
    command("say 段郎好象和他伯父段皇爷一起去了天龙寺。");
    command("deadlove");
    me->set_temp("meet_mu2", 1);
    me->delete_temp("meet_mu");
    call_out("destroying", 1, ob);
    return 1;
  }
  return 0;
}

void destroying(object ob) {
  if (!ob) return;
  if (userp(ob)) command("drop " + ob->parse_command_id_list()[0]);
  else destruct(ob);
}
