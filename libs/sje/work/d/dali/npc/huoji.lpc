// huoji. 药铺伙计

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是药铺老板从大理乡下招来帮忙的。\n");
  set("combat_exp", 2500);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "/clone/medicine/jinchuang": 5,
    "/clone/medicine/hua": 7,
    "/clone/medicine/huangqi": 6,
    "/clone/medicine/huoxiang": 8,
    "/clone/medicine/hugu": 12,
    "/clone/medicine/jia": 12,
    "/clone/medicine/lurong": 5,

  ]));
  setup();
  carry_object("/clone/armor/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
