#include <ansi.h>
inherit NPC;
string ask_job();
string ask_jobtime();
void create()
{
        set_name("褚万里", ({ "zhu wanli","zhu","wanli" }));
        set("title", "大理国镇南王府家将");
        set("gender", "男性");
        set("age", 33);
        set("str", 27);
        set("dex", 26);
        set("long", "这人身穿军服，腰上插着一根软索，英气逼人。\n");
        set("combat_exp", 400000);
        set("shen_type", 1);
        set("attitude", "peaceful");
        set("unique", 1);
        set_skill("unarmed", 100);
        set_skill("force", 100);
        set_skill("whip", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/armor", 70);
        set_temp("apply/damage", 20);

        set("max_qi", 900);
        set("neili", 900); 
        set("max_neili", 900);
        set("jiali", 20);
        set("inquiry", 
                ([
                              "送信" : (: ask_job :),
                              "功劳" : (: ask_jobtime :),
                ]));

        setup();

        carry_object(__DIR__"obj/ruansuo")->wield();
        carry_object(__DIR__"obj/zipao")->wear();

}

string ask_jobtime()
{      
        
        if ( this_player()->query("combat_exp" ) < 100000)
           return RANK_D->query_respect(this_player())+"你是不是应该再闯荡一段时间积累点经验？";
         
        if ( this_player()->query("dali_zhu_add" ) > 0)
           return RANK_D->query_respect(this_player())+"，你为大理王府总共做了:"+chinese_number(this_player()->query("dali_job" ))+"次工作。"; 

        this_player()->add("dali_job",800);
        this_player()->add("dali_zhu_add",1);

        message_vision("褚万里拿出一本本子记了$N点什么。\n",this_player());
        
        return RANK_D->query_respect(this_player())+"我帮你加了八百次功劳。";
}

string ask_job()
{
       object me, ob;
       mapping quest;
       string msg;
       
       ob=this_player();
       me=this_object();
       if (!ob->query_temp("dali_join"))
           return RANK_D->query_respect(ob) + "，你不是本王府随从，此话从何说起？";
       if( ob->query_condition("gb_mission")
        || ob->query_condition("xx_task")
        || ob->query_condition("mr_job"))
           return "你这个"+ RANK_D->query_rude(ob) +"，你现在正有任务呢！";

       if( ob->query_condition("dali_busy")){
           command ("nip " + ob->query("id"));  
           if(random(10)>5){
           command ("step " + ob->query("id"));
           command ("say " +ob->query("name")+"你个"+ RANK_D->query_rude(ob) +"当我是npc，不会踩人？");
           }           
           return "你这个"+ RANK_D->query_rude(ob) +"，消遣我来着？叫你等会儿就是等会儿。";
           }
           
       if ((int)ob->query_condition("dali_songxin")){
                if( ob->query_temp("quest/id") && ob->query_temp("quest/family") == "大理")
                        return "不是让你送信给"+ob->query_temp("quest/name")+"了吗，怎么还在这里？";
                else    return "我现在没空呢，你等会儿再来吧。";
                }

       if ( ob->query("combat_exp") >= 10000000)
           return "这个"+ RANK_D->query_rude(ob) +"，我看你的武功已有相当的功底了，消遣我来着？";
       if ( ob->query("combat_exp") < 50000)
           return "这个"+ RANK_D->query_rude(ob) +"，你的功夫还不够啊，送信可是很危险的事，被人砍了怎么办？";

       if(!mapp(quest= TASK_D->get_quest(ob, 1, "送", "大理"))) 
            return "这个"+ RANK_D->query_rude(ob) +"，现在没有信要送，一边凉快去。\n"; 
            
       ob->set_temp("quest", quest);
       ob->set_temp("dali_songxin",1);
       ob->apply_condition("job_busy", 10+random(20));
       ob->apply_condition("dali_songxin", 100);
       
       message_vision("$N交给$n一封密函。\n",me,ob);
       
       me = new("/d/dali/job/dali_letter");
       me->set("owner", ob);
       me->set_temp("apply/long", ({me->query("long")+"封面上写着「"+quest["name"]+"」亲启。\n"}));
       switch(random(3)) {
            case 0: msg = "你把这封密函火速送到"+quest["place"]+CYN"的「"+quest["name"]+CYN"」手上。"; break;
            case 1: msg = "我这里正好有封信，你去把它送到"+quest["place"]+CYN"的「"+quest["name"]+CYN"」手上。"; break;
            case 2: msg = "这封信极为重要，你赶紧把它送到"+quest["place"]+CYN"的「"+quest["name"]+CYN"」手上。"; break;
        }  
        me->move(this_player());
        return msg+"\n            必须在"+TASK_D->get_time(quest["time"])+"之前送到！";
}

