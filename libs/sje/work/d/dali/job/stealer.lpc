#include <ansi.h>
inherit NPC;

string *first_name = ({ "赵","钱","孙","李","周","吴","郑","王","张","陈","柳","风","刘","林", }); 
string *name_words = ({ "一","二","三","四","五","六","七","八","九","十", });
string *color_title = ({"天杀门鬼手","地煞门妙手",});
string *sword_skill = ({ 
"taiji-jian","damo-jian","fumo-jian","tiangang-jian","yunu-jianfa","yuxiao-jian",
"liehuo-jian","jinshe-jianfa","murong-jianfa","huashan-jianfa", "duanjia-jianfa",
"huifeng-jian","quanzhen-jianfa" }); 

string *blade_skill = ({ 
"xuanxu-daofa","wenjia-daofa","lieyan-dao","xiuluo-dao","liuhe-daofa",
"ranmu-daofa","cibei-dao","fanliangyi-dao", "ruyi-dao", "shandian-daofa"});

string *staff_skill = ({ "wuchang-zhang","fengmo-zhang","baituo-shezhang","pudu-zhang", "tianshan-zhang" }); 

string *club_skill = ({ "zui-gun","weituo-gun" }); 

string *whip_skill = ({ "yuxu-bian","qingxu-bian", "huifeng-bian" });  

string *weapon_list = ({ "sword","blade","whip","gun","sword","gangzhang","blade" });

void create()
{
        string s_sword,s_blade,s_club,s_whip,
               s_staff, weapon, name;
        
        name = first_name[random(sizeof(first_name))];
        s_sword = sword_skill[random(sizeof(sword_skill))];
        s_blade = blade_skill[random(sizeof(blade_skill))];
        s_club  = club_skill[random(sizeof(club_skill))];
        s_whip  = whip_skill[random(sizeof(whip_skill))];
        s_staff = staff_skill[random(sizeof(staff_skill))];
        weapon = weapon_list[random(sizeof(weapon_list))];
        name = first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))]; 
        
        set_name(name, ({ "stealer", "xiaotou"}));
        set("title", color_title[random(sizeof(color_title))]);
        set("gender", "男性");
        set("long", "这人身穿黑色紧装，面上蒙着一块黑布，只露出一双眼睛，精光四射。\n");
        set("no_quest", 1);  // not for taskd.c
        set("env/wimpy", 60);
        set("age", random(20)+25);      
        set("str", 20+random(5));
        set("int",28+random(5));  
        set("con",25+random(5));     
        set("dex",29+random(5));
        set("combat_exp", 100000);
        set("shen_type", -1);
        set("attitude", "friendly");
        set("max_qi",1200);
        set("max_jing",1200);
        set("neili",1000);
        set("max_neili",1000);
        set("score", 10000);
        set_skill("suohou-shou", 60);
        set_skill("hand", 60);
        set_skill("force", 60);
        set_skill("taiji-shengong", 60);
        set_skill("sword", 60);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("blade", 60);
        set_skill("club", 60);
        set_skill("staff", 60);
        set_skill("whip", 60);
        set_skill(s_sword, 60);
        set_skill(s_blade, 60);
        set_skill(s_club, 60);
        set_skill(s_whip, 60);
        set_skill(s_staff, 60);
        set_skill("xiaoyaoyou", 60);
        map_skill("force", "taiji-shengong");
        map_skill("sword", s_sword);
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "suohou-shou");
        map_skill("blade", s_blade);
        map_skill("club", s_club);
        map_skill("whip", s_whip);
        map_skill("staff", s_staff);
        map_skill("hand", "suohou-shou");
        prepare_skill("hand", "suohou-shou"); 
        
        // hehe, stealer runs...
        set("chat_chance", 35);
        set("chat_msg", ({
                (: random_move :)
        }) );
                
        setup();
        carry_object(BINGQI_D(weapon))->wield();
        carry_object(ARMOR_D("yexing-yi"))->wear();
        add_money("silver", 50);
}

int do_copy(object me)
{
        object ob, weapon;
        string my_id, type, type1;
        int i;
        ob = this_object();

        if(!me) ob->unconcious();
        my_id = me->query("id");
          
        i = me->query("max_pot") - ( 100 + random(15));
        if(i < 60) i = 60;
        
        ob->set("combat_exp", me->query("combat_exp")/5*4);

        if(objectp(weapon = ob->query_temp("weapon"))) {
              type = weapon->query("skill_type");
              type1 = ob->query_skill_mapped(type);
              ob->set_skill(type, i);
              ob->set_skill(type1, i);
              }
        ob->set_skill("force", i);
        ob->set_skill("cuff", i);
        ob->set_skill("dodge", i);
        ob->set_skill("parry", i);
        ob->set_skill(ob->query_skill_mapped("dodge"), i);
        ob->set_skill("yingzhua-gong", i);  
        ob->set_skill("taiji-shengong", i);     
        ob->set_skill("xiaoyaoyou", i); 
        ob->set("max_qi", me->query("max_qi")/3*2); 
        ob->set("max_jing", me->query("max_jing")/3*2); 
        ob->set("max_neili", me->query("max_neili")/3*2);
        ob->set("jiali", ob->query_skill("force")/3);
        ob->reincarnate(); 
        ob->set("eff_jing", me->query("eff_jing"));
        command("grin " + me->query("id"));

        me->add_temp("songxin_zuji", 1);
        command("follow "+me->query("id"));
        ob->set_leader(me);
        ob->set("victim", me->query("id"));
        ob->kill_ob(me);
        call_out("leave", 450);
        return 1;
}

void leave()
{    
  if(this_object()){
      tell_room(environment(this_object()), this_object()->query("name")+"嘿嘿笑了几声，转身几个起落就不见了。\n", ({this_object()}));      
      destruct(this_object());
      }        
}

int accept_fight(object victim)
{
        command("say 你这是找死！");
        kill_ob(victim);
        return 1;
}
