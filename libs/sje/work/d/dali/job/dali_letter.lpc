// dali_letter.c 信件
// Modify By River 98/12
// Modify by snowman@SJ 16/05/99

#include <ansi.h>
inherit ITEM;

#define TIME_TICK (time()*60)
void create() {
  set_name(RED "信件" NOR, ({ "xin jian", "letter", "xin", "secret letter" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long", "这是一封信件，镇南王亲笔手谕，信封的很严实，封口盖着红漆印戳。\n");
    set("value", 0);
    set("material", "paper");
    set("no_drop", 1);
    set("no_give", 1);
  }
}

void init() {
  call_out("dest", random(100) + 900);
  add_action("do_send", "songxin");
  add_action("do_look", "kan");
  add_action("do_look", "chakan");
}

int do_look(string arg) {
  object me = this_player();

  if (!arg) return 0;
  if ((arg == "letter" || arg == "xin" || arg == "xin jian")
    && query("owner") == me
    && me->query_temp("quest/time")
    && me->query_temp("quest/id")) {
    tell_object(
      me,
      "你必须在" + TASK_D->get_time(me->query_temp("quest/time")) + "之前送到" + me->query_temp("quest/name") + "处！\n"
    );
    return 1;
  } else return 0;
}

int do_send(string arg) {
  object me, target;
  mapping quest;
  me = this_player();

  if (!arg) return notify_fail("你要送给谁？\n");
  if (!objectp(target = present(arg, environment(me))))
    return notify_fail("看清楚点，你要送信的人不在这里！\n");

  if (userp(target))
    return notify_fail("嘿嘿，想作弊？那可要等没巫师的时候。。。\n");

  if (!living(target))
    return notify_fail("看清楚点，那人可以说话吗？\n");

  if (!living(target))
    return notify_fail("看清楚点，那人可以说话吗？\n");

  message_vision("$N从怀中掏出一封信。\n", me);
  message_vision(
    HIY "$N擦了一把额头的汗，将信呈在$n面前说道，这是段王爷让" + RANK_D->query_self(me) + "送给您的信，请您收好。\n" NOR,
    me,
    target
  );

  if (!me->query_temp("dali_join")) {
    message_vision(CYN "$N道：你不是大理国的随从，怎么会送镇南王手谕的信给我？\n" NOR, target);
    return notify_fail("对方不接受这封信。");
  }
  if (!mapp(quest = me->query_temp("quest")) || quest["type"] != "送") {
    message_vision(CYN "$N道：这。。。你拿封信给我干什么？走开走开！\n" NOR, target);
    return notify_fail("对方不接受这封信。");
  }
  if (target->query("id") != quest["id"]) {
    message_vision(CYN "$N道：这封信不是给我的，你是不是送错了？\n" NOR, target);
    return notify_fail("对方不接受这封信。");
  }
  if (query("owner") != me) {
    message_vision(CYN "$N道：这是大理国镇南王府亲自交给你,要你送的？你是不是从别人那里抢来的？\n" NOR, target);
    this_object()->move(target);
    message_vision("$N将信没收了。\n", target);
    return 1;
  }
  if (me->query_temp("stealernotmet")) {
    message_vision(HIY "$N接过信看了看，点点头说道：这位" + RANK_D->query_respect(me) + "辛苦你了。\n" NOR, target, me);

    TASK_D->give_reward(me, quest, 1, me->query("dali_job") / 20 + random(150));
    me->delete_temp("songxin_zuji");
    me->delete_temp("dali_songxin");
    me->clear_condition("dali_songxin");
    me->start_busy(3);
    me->apply_condition("job_busy", 100 + random(50));
    me->add("dali_job", 1);
    tell_object(me, HIW "你为镇南王府做了" + chinese_number(me->query("dali_job")) + "次工作。\n" NOR);
    destruct(this_object());
    return 1;

  }
  if (quest["time"] < TIME_TICK) {
    message_vision(CYN "$N惊道：啊！这么重要的信，你怎么现在才送来？拿来拿来！\n" NOR, target);
    destruct(this_object());
    tell_object(me, "糟了，你来晚了！\n");
    return 1;
  }
  message_vision(HIY "$N接过信看了看，点了点头说道：这位" + RANK_D->query_respect(me) + "辛苦你了。\n" NOR, target, me);

  TASK_D->give_reward(me, quest, 1, ABS(me->query("dali_job") / 50) + random(150));
  me->delete_temp("songxin_zuji");
  me->delete_temp("dali_songxin");
  me->clear_condition("dali_songxin");
  me->start_busy(3);
  me->apply_condition("dali_busy", 10 + random(25));
  me->add("dali_job", 1);
  tell_object(me, HIW "你为镇南王府做了" + chinese_number(me->query("dali_job")) + "次工作。\n" NOR);
  destruct(this_object());
  return 1;
}

void dest() {
  message_vision("$N忽然掉落在路上不见了。\n", this_object());
  destruct(this_object());
}
