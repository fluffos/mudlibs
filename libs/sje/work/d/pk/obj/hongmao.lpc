// hongmao.c

inherit NPC;

void create()
{
	set_name("红毛鬼", ({ "hongmao gui", "gui"}));
	set("gender", "男性");
	set("age", random(10) + 30);
	set("str", 25);
	set("dex", 16);
	set("long", "入侵我天朝的荷兰红毛鬼。他手上端着一支火枪，枪口还冒着青烟。\n");
	set("combat_exp", 25000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/armor", 30);
	set_temp("apply/damage", 30);
     set ("chat_chance",90);
     set ("chat_msg", ({
                      (: random_move :)
                      }) );

	setup();
	carry_object(__DIR__"huoqiang")->wield();
}

