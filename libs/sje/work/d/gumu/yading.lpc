// yading.c

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "崖顶");
  set("long", @LONG
这是一个宁静的小村子，稀稀落落的分布着几十间土坯泥房，看来村
中人家不多，而且大都生活很艰辛。这是一条东西向的碎石路，北面是间
结实的民宅。
LONG
  );
  set("exits", ([
  ]));
  set("outdoors", "华山村");

  setup();
}
void init() {
  object me = this_player();
  mapping fam = me->query("family");
  if (fam && fam["family_name"] == "古墓派" && fam["generation"] == 4)
    me->set("title", HIW "古墓派神雕侠侣传人" NOR);
}
