// shulin.c 

inherit ROOM;
void create()
{
	set("short", "树林");
	set("long",@long
这里是华山村里的一片杨树林，如果你没有好身手，可千万不要在此
久留，据说这里强盗出没，抢劫、杀人的事情经常发生。
long);
	set("exits",([
	"north" : __DIR__"eroad1",
	"east" : __DIR__"shulin3",
    ]));
    setup();
}
void init()
{
	object ob, me, name1, ling;
	me = this_player();
	name1 = me->query("id");
	ling = present("ling pai", me);
	if( ! (present("mengmian ren", environment(me)) ) 
	&& (int)me->query_temp("hs/jobji", 1)==1 
	&& (int)me->query_temp("hs/have", 1)==0 
	&& ling
	&& !(ling->query_temp("hsjob") != name1 )
	&&  random(10) > 1 )
	{
	ob=new(__DIR__"npc/mmr1");
	ob->move(environment(me));	
	me->set_temp("hs/have", 1);
	ling->set_temp("mmr", name1);
	ob->set_temp("mmr", name1);
	}
}

