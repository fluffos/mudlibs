// shulin.c 

inherit ROOM;
void create() {
  set("short", "树林");
  set("long", @long
树林里生着北方常见的榆树和杨树，树木高大，遮掩得天色都黯淡了
下来。无数枝叶在风中摇摆，发出奇异的响声。落叶踩下后又慢慢恢复原
状，竟不留任何足迹。
long);
  set("exits", ([
    "northeast": __DIR__ "shulin13",
    "north": __DIR__ "shulin12",
    "south": __DIR__ "shulin10",


  ]));
  setup();
}
void init() {
  object ob = this_object();
  object me = this_player();
  if ((int)me->query_temp("hs/jobji", 1) == 1
    && random(10) > 1) {
    call_out("do_clone_mmr", 0, me);
  }
}
void do_clone_mmr() {
  object me = this_player();
  object ob = this_object();
  string name;
  name = me->query("id");
  if ((int)me->query_temp("hs/have", 1) == 0) {
    ob = new(__DIR__ "npc/mmr")->move(this_object());
    me->set_temp("hs/have", 1);
    ob->set("mmr", name);
  }
}
