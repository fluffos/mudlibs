inherit ROOM;
void create()
{
	set("short", "树林");
	set("long",@long
xx
long);
	set("exits",([
     "north" : __DIR__"hsroad3",
    ]));
    setup();
}
void init()
{
	object ob = this_object();
	object me = this_player();
	if( (int)me->query_temp("hs/jobji", 1)==1
	&&  random(10)>1)
	{
	call_out("do_clone_mmr", 0 ,me);
	}
}
void do_clone_mmr()
{
	object me = this_player();
	object ob = this_object();
	string name;
	name = me->query("id");
	if( (int)me->query_temp("hs/have", 1)==0 ) {
	ob=new(__DIR__"npc/mmr")->move(this_object());	
	me->set_temp("hs/have", 1);
	ob->set("mmr", name);
	}
}