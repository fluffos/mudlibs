// shi.c 施琅

inherit NPC;

void create()
{
       set_name("施琅", ({ "shi lang", "shi" }));
       set("title", "靖海侯");
       set("gender", "男性");
       set("age", 43);
       set("str", 25);
       set("dex", 16);
       set("long", "施琅是一员能征惯战的水将，刚刚平定台湾，御赐靖海侯。\n");
       set("combat_exp", 200000);
       set("shen_type", 1);
       set("attitude", "heroism");

       set_skill("unarmed", 100);
       set_skill("force", 100);
       set_skill("sword", 100);
       set_skill("dodge", 100);
       set_skill("parry", 100);
       set_skill("songshan-jian", 100);
       map_skill("parry", "songshan-jian");
       map_skill("sword", "songshan-jian");
       set_temp("apply/attack", 70);
       set_temp("apply/defense", 70);
       set_temp("apply/armor", 70);
       set_temp("apply/damage", 70);

       set("max_qi", 1700);
       set("qi", 1700);
       set("neili", 2000); 
       set("max_neili", 2000);
       set("jiali", 10);

       setup();
       carry_object("/clone/weapon/gangjian")->wield();
       carry_object("/clone/armor/armor")->wear();
}

int accept_fight(object me)
{
       command("say 老夫久未和江湖人动手过招了，今日也不想破例。");
       return 0;
}

void init()
{
       object ob;
       ::init();
       if (interactive(ob = this_player()) && living(this_object()) &&
               (int)ob->query_condition("killer")) {
               remove_call_out("kill_ob");
               call_out("kill_ob", 0, ob);
       }
}


