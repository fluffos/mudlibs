// room: well1.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "井底");
        set("long", @LONG
这里已是枯井的底部了。四周伸手不见五指，脚底软软得似乎有什么东西
想把你拉下去，阵阵恶臭从四面八方钻进你的鼻子。除此之外，便只剩下自己
粗重的喘息和一片“卜卜”的心跳声。
LONG
        );

        set("exits", ([
                "up" : __DIR__"well",
        ]));
        setup();
}

void init()
{
        add_action("do_use", "use");
}

int do_use(string arg)
{
        object me;
        me = this_player();
        if( !arg || arg=="" ) return 0;
        if (!present("fire", me))  return 0;
        if( arg=="fire" ) {
             write(
             "你试图点燃火折，但微弱的火光迅即被一股莫名的冷风吹灭了。\n"
             );
             return 1;
       }
}