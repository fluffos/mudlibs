// Room: /d/fuzhou/beimen.c

inherit ROOM;

void create() {
  set("short", "福州北门");
  set("long", @LONG
这里是福州的北门。出此门向北可抵江浙一带。
LONG
  );

  set("exits", ([
    "north": __DIR__ "road5",
    "south": __DIR__ "zhongxin",
  ]));

  set("objects", ([
    __DIR__ "npc/shi": 1,
    __DIR__ "npc/bing": 2,
  ]));
  set("outdoors", "福州");
  setup();
  replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  if (dir == "south")
    if (present("guan bing", (environment(me)))
      && me->query_condition("killer") > 0)
      return notify_fail("官兵手中的刀挡住了你的去路。\n");
  return ::valid_leave(me, dir);
}
