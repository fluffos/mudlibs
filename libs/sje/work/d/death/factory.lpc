#include <login.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "机器人天堂");
  set("long", @LONG
这里存放着不同时代的机器人，由于他们没用人类特有的智商，
唯一在这里所能做的只有发呆，发呆，再发呆。。。。。。
LONG);
  set("valid_startroom", 1);
  set("no_sleep_room", 1);
  set("no_fight", 1);
  setup();
  "/clone/board/robot_b"->foo();
}

void init() {
  object me = this_player();
  if (!wizardp(me) && !wiz_level(me)) {
    if (!me->query_condition("robot") && !me->query("robot/done"))
      me->apply_condition("robot", 1500);

    add_action("action", ({
      "exercise",
      "exert",
      "practice",
      "respirate",
      "study",
      "rumor",
      "beg",
      "steal",
    }));
  } else {
    add_action("action", "summon");
    add_action("do_free", "free");
  }
}

int action() {
  write("目前你是机器人，不能与人类享受同等待遇，写检讨吧！\n");
  return 1;
}

int do_free(string arg) {
  object ob, me;
  string str;

  me = this_player();

  if (!wizardp(me)) return 0;

  if (!arg || !objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有这个机器人。\n");

  if (!userp(ob))
    return notify_fail("看清楚一点，那是玩家机器人吗？\n");

  if (ob == me || wizardp(ob) || SECURITY_D->get_status(ob) == "(immortal)")
    return notify_fail("你最好拍拍自己的脑袋，然后对自己说三声：“我在发梦！我在发梦！”\n");

  str = ob->query("robot/catch");

  if (stringp(str) && str != me->query("id"))
    if (ob->query_condition("robot") || !ob->query("robot/done"))
      return notify_fail("这机器人还没修理够呢。\n");

  message_vision(HIM "\n$N拍拍手，招来一位绝色美女，将$n扶起离开了。\n\n" NOR, me, ob);
  log_file(
    "ROBOT",
    geteuid(me) + " FREE " + ob->name() + "(" + ob->query("id") + ") on " + ctime(time()) + "\n"
  );
  ob->delete("robot");
  ob->clear_condition("robot");
  ob->move(REVIVE_ROOM);
  ob->save();

  write("好了，你将他释放了。\n");
  return 1;
}
