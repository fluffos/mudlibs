inherit ROOM;

void create()
{
	set("short", "极乐世界");
	set("long", @LONG
人们来到这里，只觉得无比欢畅，什么事情也不想做了。
LONG
	);

	setup();
}

void init()
{
	if (!wiz_level(this_player())) {
                write("你太辛苦了，连佛祖都感动了，好好休息一下吧。\n");
		add_action("action", "");
		call_out("back", 600, this_player());
	}
}

int action(string arg)
{
	return 1;
}

void back(object me)
{
	if (me && present(me, this_object())) 
         me->move("/d/death/gateway");
}
