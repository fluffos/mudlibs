// tiebagua.c 铁八卦

inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIG"铁八卦"NOR, ({ "tie bagua","bagua"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long","这是一枚桃花岛弟子用的铁八卦。\n");
                set("value", 7000);
                set("unique", 4);
                set("material", "iron");
         }
        setup();
}
