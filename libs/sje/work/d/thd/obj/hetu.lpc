#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "河图" NOR, ({ "he tu", "shu", "tu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", HIW "
五行相生：金生水，水生木，木生火，火生土，土生金。
五行相克：金克木，木克土，土克水，水克火，火克金。
" NOR);
    set("value", 5000);
    set("treasure", 1);
    set("unique", 1);
    set("material", "paper");
    set("skill", ([
      "name": "qimen-bagua",
      "jing_cost": 40,
      "difficulty": 20,
      "max_skill": 150,
      "min_skill": 80,
    ]));
  }
}
