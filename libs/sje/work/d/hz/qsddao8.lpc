// /u/beyond/hz/qsddao3.c 青石大道
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", GRN "青石大道" NOR);
  set("long", @LONG
你走在一条林荫大道上，两边鸟语花香，游客们往来穿梭，熙熙攘攘好
不热闹。东南方是一条土路。
LONG
  );
  set("objects", ([
    __DIR__ "npc/you": 2,
  ]));
  set("exits", ([
    "southeast": "/d/thd/niujia/road",
    //"west" : __DIR__"lingyinsi",
    "west": __DIR__ "qsddao2",
  ]));
  setup();
}
