// /u/beyond/hz/longjing.c 龙井
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", GRN "龙井" NOR);
  set("long", @LONG
过了西湖西南凤篁岭，你就来到了龙井。只见四周，林木茂密，怪石嵯
峨，风景优美。龙井为杭州名泉之一，泉水清凉干冽，大旱不枯。
LONG
  );
  set("exits", ([
    "east": __DIR__ "hupao",
    "northwest": __DIR__ "yxsdong2",

  ]));
  setup();
}
