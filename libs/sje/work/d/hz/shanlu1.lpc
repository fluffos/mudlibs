// /u/beyond/hz/shanlu1.c 山路
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", GRN "山路" NOR);
  set("long", @LONG
你走在山路上，山路两旁树木葱绿，鸟语话香，山路两旁是一大片郁郁
葱葱的柳林。
LONG
  );
  set("outdoors", "hz");
  set("exits", ([
    "east": __DIR__ "liulin",
    "west": __DIR__ "liulin",
    "northeast": __DIR__ "liulin",
    "south": __DIR__ "shanlu",
  ]));
  setup();
}
