#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", GRN "长廊" NOR);
  set("long", @LONG
你走进长廊，看到长廊上面全是一幅幅工笔彩画，当真是妙不可言。每
一幅都栩栩如生，看的你都入迷了，连原来的路都找不到了。
LONG
  );
  set("exits", ([
    "east": __FILE__,
    "west": __FILE__,
    "south": __FILE__,
    "north": __DIR__ "changlang2",

  ]));
  setup();
}
