inherit  NPC;

void  create()
{
                set_name("帮众",  ({  "bang zhong",  "bang",  "zhong"  })  );
                set("gender",  "男性");
                set("age",  31);
                set("long","长乐帮帮众，负责帮中内外安全。\n");
                set("combat_exp",  350000);
	        set("title",  "长乐帮");
                set("attitude",  "friendly");
	        set("per",  25);
                set("str",  35);
                set("max_qi", 1000);
                set("jing", 540);
                set("max_jing", 540);
                set("neili", 1500);
                set("max_neili", 1500);
                set("jiali", 100);
                setup();

//                carry_object("/d/obj/weapon/spear/tiespear")->wield();
//                carry_object("/d/obj/armor/tongjia")->wear();
}

int  accept_fight(object  me)
{
                command("say  长乐帮乃天下第一大帮，由不得你在此撒野！");
                return  0;
}


