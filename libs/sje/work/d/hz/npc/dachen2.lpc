inherit  NPC;

#include "reporting.h"

void  create()
{
    set_name("展飞",  ({  "zhan fei",  "zhan",  "fei" ,"xiang zhu" }));
    set("title",  "长乐帮豹捷堂香主");
    set("gender",  "男性");
    set("age",  30);
    set("per",  30);
    set("combat_exp",  400000);
    set_skill("force",  80);
    set_skill("unarmed",  80);
    set_skill("dodge",  80);
    set_skill("parry",  80);
    set("jin",  800);
    set("max_jin",  800);
    set("qi",  1000);
    set("max_qi",  1000);
    set("jingli",  700);
    set("max_jingli",  700);
    set("neili",  1800);
    set("max_neili",  1800);
    setup();
//    carry_object("/d/obj/cloth/jinpao")->wear();
}

void  reward  (object  who)
{
    object  me  =  this_object  ();
    int  points  =  who->query("quest/reward");
    string  channel  =  "sldh";
    string  *channels  =  who->query("channels");

    if  (  !pointerp(channels)  ||  !sizeof(channels)  )
        channels  =  ({  channel  });
    else  if  (member_array(channel,  channels)  ==  -1)
        channels  +=  ({  channel  });

    who->set("channels",channels);

    //    points  *=  2;
    if(points<50)
        points  *=  5;
    else  
        points  *=  4;
    //  mon  3/30/98  increase  the  dx  reward.

    if(  points  >  800){
        points  =  750+random(50);
    }

    message_vision  ("$N对$n一拱手说道：帮主有令，赏"+RANK_D->query_respect(who)+
                                    COMBAT_D->chinese_combat_exp(points)+"经验！\n",me,who);
                                 
    who->add("quest/combat_exp",points);
    reporting  (who,  who->query("quest/reason"),  points,  "点经验");
    who->add("combat_exp",points);
}

