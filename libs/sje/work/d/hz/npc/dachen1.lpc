// qiu 邱山风
//xiaoyao 98/9/4

inherit NPC;

#include "reporting.h"

void create() {
  set_name("邱山风", ({ "qiu  shanfen", "qiu", "shanfen", "xiang zhu" }));
  set("title", "长乐帮虎猛堂香主");
  set("gender", "男性");
  set("age", 28);
  set("per", 30);
  set("combat_exp", 400000);
  set_skill("force", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("jin", 800);
  set("max_jin", 800);
  set("qi", 1000);
  set("max_qi", 1000);
  set("jingli", 700);
  set("max_jingli", 700);
  set("neili", 1800);
  set("max_neili", 1800);

  setup();
  carry_object("/clone/armor/cloth")->wear();
}

void reward(object who) {
  object me = this_object();
  int points = who->query("quest/reward");
  string channel = "sldh";
  string *channels = who->query("channels");

  if (!pointerp(channels) || !sizeof(channels))
    channels = ({ channel });
  else if (member_array(channel, channels) == -1)
    channels += ({ channel });

  who->set("channels", channels);

  if (points > 150) {
    points = 140 + random(10);
  }

  message_vision("$N对$n一拱手说道：帮主有令，奖励" + RANK_D->query_respect(who) +
    chinese_number(points) + "点潜能！\n", me, who);

  who->add("quest/potential", points);
  reporting(who, who->query("quest/reason"), points, "点潜能");
  who->add("potential", points);
}
