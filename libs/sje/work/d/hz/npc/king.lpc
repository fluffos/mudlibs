/*  <SecCrypt CPL V3R05>  */
 
inherit  NPC;

void  create()
{
    set_name("石破天",  ({ "shi potian",  "shi" ,"bangzhu" }));
    set("long",  "平易近人又颇有风度的他，两片铁门似的嘴，常关的密不透风。\n");
    set("title",  "长乐帮帮主");
    set("gender",  "男性");
    set("rank_info/respect",  "帮主");
    set("age",  22);
    set("attitude",  "peaceful");
    set("shen_type",  1);
    set("per",  30);
    set("int",  30);
    set("combat_exp",  1000000);
    set_skill("force",  80);
    set_skill("unarmed",  80);
    set_skill("dodge",  80);
    set_skill("parry",  80);
    set("jin",  800);
    set("max_jin",  800);
    set("qi",  1000);
    set("max_qi",  1000);
    set("jingli",  700);
    set("max_jingli",  700);
    set("neili",  1800);
    set("max_neili",  1800);
    setup();
//    carry_object("/d/obj/cloth/mangpao")->wear();
    
}

void  init  ()
{
    call_out  ("test_player",1,this_player());
}

string  *strs  =  ({
    "$N对$n惊叹道：",
    "$N对$n赞赏道：",
    "$N微笑着对$n说道：",
    "$N赞许地对$n说道：",
});

void  test_player  (object  who)
{
    object  me  =  this_object();
    object  where  =  environment  (me);
    object  xiangzhu;
    int  i  =  10;

    if  (who->query("quest/reward")  <  1)
        return;

    message_vision  ("\n$N必恭必敬的走进了长乐帮的总堂。\n",who);
    while  (i--)
    {
        string  str  =  "xiang zhu  1";

        //  str[strlen(str)-1]  =  '1'+random(5);
        switch  (random(32))
        //  mon  4/5/98  changed  range  to  32  from  16
        {
            case  0:  case  1:  case  2:  case  3:  case  4:  case  5:  case  6:
            case  16:  case  17:  case  18:  case  19:  case  20:  case  21:  case  22:  
            {
                str  =  "qiu  shanfen";
                break;
            }
            case  7:  case  8:
            {
                str  =  "zhan fei";              
                break;
            }
            case  9:
            {
                str  =  "mi hengye";    
                break;
            }
            case  10:  case  11:
            {
                str  =  "shi jian";
                break;
            }
            default:
            {
                str  =  "zheng chongzhi";          
                break;
            }
        }
        xiangzhu  =  present  (str,  where);

        if  (!  interactive  (xiangzhu))
            break;
    }

    if  (!  xiangzhu)
        xiangzhu  =  present  ("xiang zhu",  where);

    if  (!  xiangzhu  ||
            interactive  (xiangzhu))
    {
        message_vision  ("$N对$n说道：各堂香主不在，"+RANK_D->query_respect(who)+
                                        "请稍等片刻。\n",me,who);
        return;
    }
    message_vision  (strs[random(sizeof(strs))]+RANK_D->query_respect(who)+
                                    "为长乐帮效命，本帮主必好好奖赏你。\n",me,who);
    message_vision  ("\n$N走上前单膝跪地，高声说道：为长乐帮效命“万死不辞”\n",who,me);
    who->start_busy  (3,3);
    call_out  ("reward_player",2,me,who,xiangzhu);
}

void  reward_player  (object  me,  object  who,  object  xiangzhu)
{
    message_vision  ("\n旁边走近$N低声向$n说了几句，$n点了点头。\n",xiangzhu,me);
    xiangzhu->reward(who);
    message_vision  ("\n$N连忙俯身一拜，小心翼翼地站起来。\n",who,me);
    who->delete("quest/reward");
    who->interrupt_me();
}

