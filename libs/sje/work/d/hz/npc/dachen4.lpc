inherit NPC;

#include "reporting.h"

void create() {
  set_name("陈冲之", ({ "zheng chongzhi", "zheng", "chongzhi", "xiang  zhu" }));
  set("title", "长乐帮狮威堂香主");
  set("gender", "男性");
  set("age", 30);
  set("per", 30);
  set("combat_exp", 400000);
  set_skill("force", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("jin", 800);
  set("max_jin", 800);
  set("qi", 1000);
  set("max_qi", 1000);
  set("jingli", 700);
  set("max_jingli", 700);
  set("neili", 1800);
  set("max_neili", 1800);
  setup();
  //    carry_object("/d/obj/cloth/jinpao")->wear();
}

void reward(object who) {
  object me = this_object();
  int points = who->query("quest/reward");
  int limit = 40;
  int i = 10;
  string str;
  string name;
  string channel = "sldh";
  string *channels = who->query("channels");

  if (!pointerp(channels) || !sizeof(channels))
    channels = ({ channel });
  else if (member_array(channel, channels) == -1)
    channels += ({ channel });

  who->set("channels", channels);

  while (i--) {
    switch (random(7)) {
      case 0:
        {
          if (who->query_str() < limit) {
            str = "apply/strength";
            name = "膂力";
            break;
          }
        }
      case 1:
        {
          if (who->query_dex() < limit) {
            str = "apply/dex";
            name = "身法";
            break;
          }
        }
      case 2:
        {
          if (who->query_int() < limit) {
            str = "apply/intelligence";
            name = "悟性";
            break;
          }
        }
      case 3:
        {
          if (who->query_pur() < limit) {
            str = "apply/pur";
            name = "纯朴";
            break;
          }
        }
      case 4:
        {
          if (who->query_per() < limit) {
            str = "apply/personality";
            name = "容貌";
            break;
          }
        }
      case 5:
        {
          if (who->query_con() < limit) {
            str = "apply/constitution";
            name = "根骨";
            break;
          }
        }
      case 6:
        {
          if (who->query_kar() < limit) {
            str = "apply/karma";
            name = "福缘";
            break;
          }
        }
    }
  }
  if (!str) {
    str = "apply/personality";
    name = "容貌";
  }

  points = 2;
  message_vision("$N对$n一拱手说道：帮主有令，赏" + RANK_D->query_respect(who) +
    chinese_number(points) + "点" + name + "！\n", me, who);
  /*    
    command  (channel+"  "+who->query("name")+who->query("quest/reason")+"陛下有旨，赐"+
                      chinese_number(points)+"点"+name+"！");
*/
  who->add("quest/gain/" + str, points);
  reporting(who, who->query("quest/reason"), points, "点" + name);

  who->add_temp(str, points);
}
