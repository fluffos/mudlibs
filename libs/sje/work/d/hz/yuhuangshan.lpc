// /u/beyond/hz/yuhuangshan.c 玉皇山
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIY "玉皇山" NOR);
  set("long", @LONG
玉皇山林木葱绿，翠竹挺拔，亭阁众多，云雾缭绕，可以纵览西湖和西
湖周围的全部景色。北面是净慈寺，西北面就到了虎跑。往南走是紫来洞。
LONG
  );
  set("exits", ([
    "northdown": __DIR__ "jingcisi",
    "northwest": __DIR__ "hupao",
    "south": __DIR__ "zilaidong",

  ]));
  setup();
}
