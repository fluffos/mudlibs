// /u/beyond/hangzhou/yingboqiao.c 映波桥
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short",GRN"映波桥"NOR);
        set("long", @LONG
映波桥在西湖的西侧，可观赏花港山庄倒映的楼台亭阁，千倾一碧的三
潭映月，望南面可观南屏、西山葱郁叠翠。 
LONG
        );
        set("exits", ([
        "east" : __DIR__"sudi",
        "west" : __DIR__"kuahongqiao",
]));
        setup();
}
