#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short",RED"大雄宝殿"NOR);
        set("long", @LONG
大雄宝殿正中是释迦牟尼说法坐像，妙像庄严，金碧辉煌。靠两厢殿壁
排列着二十诸天，后面趺坐着十二圆觉。释枷牟尼佛的背后是金壁辉煌的“
五十三参”彩塑。
LONG
        );
        set("exits", ([
            "south" : __DIR__"tianwangdian",
                        
]));
        setup();
}
