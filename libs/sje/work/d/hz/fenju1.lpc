// Room: /d/fuzhou/biaoju.c

inherit ROOM;

void create() {
  set("short", "镖局");
  set("long", @LONG
你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高的旗杆，
杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮子，狮子上头有一只蝙
蝠飞翔。左首旗子上写着“福威分局”四个黑字，银钩铁划，刚劲非凡。入口
处排着两条长凳，几名镖头坐着把守。少镖头正跟他们说笑。
LONG
  );

  set("exits", ([
    "southease": __DIR__ "/d/hz/qsddao6",
  ]));

  set("objects", ([
    __DIR__ "npc/biaotou": 2,
  ]));

  setup();
}
