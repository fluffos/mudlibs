//xiaoyao 98/9/9

inherit  ROOM;

void  create  ()
{
    set  ("short",  "聚议堂");
    set  ("long",  @LONG
这里是长乐帮中议事之处，两排紫色的镂空檀香靠背椅沿着
屋子四周围成了一圈，只见一年轻少年端坐正中，四周皆是各堂
口的香主，在屋子的上方高挂这一个匾上写“长乐帮”三个大字。
LONG);

    set("exits",  ([
                "east"      :  __DIR__"dongtang",
                "west"      :  __DIR__"xitang",
                "south"     :  __DIR__"dating",
            ]));
    set("objects",  ([
                __DIR__"npc/dachen1"  :  1,
                __DIR__"npc/dachen2"  :  1,
                __DIR__"npc/dachen3"  :  1,
                __DIR__"npc/dachen4"  :  1,
                __DIR__"npc/dachen5"  :  1,
                __DIR__"npc/king"  :  1,
              ]));

    set("no_fight",1);
    setup();
}

int  valid_leave  (object  who,  string  dir)
{
    if  (dir  ==  "east"  ||  
            dir  ==  "west")
    {
        message_vision  ("$N将头往内堂一张望，里面传出了一声大喊：大胆！\n",who);
        return  notify_fail("");
    }
    return  1;
}

