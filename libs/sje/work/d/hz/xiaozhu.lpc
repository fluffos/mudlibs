// /u/beyond/hz/xiaozhu.c 小筑
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short",GRN"小筑"NOR);
        set("long", @LONG
这里有各式各样的园林小筑，各种建筑随着地势低高而错落有制。东边
以三折曲廊联接主庭院。傍山依水的翠云亭和香雪亭错落有制，亭内有男女
乐宫弹奏着悠扬动听的古乐曲，为你品茗、观景助兴。
LONG
        );
        set("exits", ([
            "southwest" : __DIR__"changlang1",
            "east" : __DIR__"shuichi",
]));
        setup();
}
