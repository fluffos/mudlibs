//xiaoyao 98/9/9
inherit  ROOM;

void  create  ()
{
    set  ("short",  "大门");
    set  ("long",  @LONG
这里便是威镇江南的长乐帮总舵所在。那长乐帮在江湖上声势非同小      
可，近年来更是日渐兴旺。两扇红漆大门上钉着狰狞的虎头，几个满脸横    
肉的帮众站在两侧。
LONG);

    set("objects",  ([  /*  sizeof()  ==  2  */
    __DIR__"npc/bangzhong"  :  2,
    ]));

    set("outdoors",  1);

    set("exits",  ([  /*  sizeof()  ==  4  */
        "enter"  :  __DIR__"dating",
    
]));

    setup();
}

int  valid_leave(object  me,  string  dir)
{
                if  (me->query("quest/reward"))
	return  ::valid_leave(me,  dir);
	if  (dir  ==  "enter"  )  {
                if  (objectp(present("bang zhong",  environment(me))))
	return  notify_fail("帮众高声说道：没有帮主的命令，谁敢擅闯长乐帮！\n");
                if  (objectp(present("wei  shi",  environment(me))))
                return  notify_fail("帮众喊道：帮主近日，不见客。\n");
                }      
                return  ::valid_leave(me,  dir);
}

  

