// men-feng.c 风字门
// Modify By River@SJ 99.06
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{ 
       set("short",HIW"风字门"NOR);
       set("long", @LONG
这是紫杉林外的风字门，插在正中央巨大的土坪上的是一面“风”字大旗。
几十名风字门释道家出家人正在埋头苦干，四周堆满了各式法器装备，风字门
门主正在一旁指导着他们。
LONG);    
        set("exits", ([
                "northwest" : __DIR__"senlin-"+(1+random(8)),   
                "southwest" : __DIR__"senlin-"+(1+random(8)),
                "southeast" : __DIR__"senlin-"+(1+random(8)),
                "northeast" : __DIR__"senlin-"+(1+random(8)),
        ]));           
        set("objects",([
                "/d/mingjiao/npc/dizi10" : 1,
                "/d/mingjiao/npc/dizi8" : 2,
        ]));    
        set("outdoors", "明教光明顶");
        set("mj_xl", "tang");
        set("mj_xl2",5);
        setup();
}

void init()
{
        object me = this_player();
        string arg = this_object()->query("mj_xl");
        int i = this_object()->query("mj_xl2");

        if(me->query_temp("mj/xunluo")
         && !me->query_temp(arg)
         && me->query_temp("mj/xunluo") == (i-1))
          me->add_temp(arg,1);

       if( NATURE_D->query_daytime() == "event_dawn"
        || NATURE_D->query_daytime() == "event_sunrise"){
           set("exits/west",__DIR__"senlin-"+(1+random(8)));
           if("exits/north") delete("exits/north");
           if("exits/east") delete("exits/east");
           if("exits/south") delete("exits/south");
        }
        if(NATURE_D->query_daytime() == "event_morning"
        || NATURE_D->query_daytime() == "event_noon"){
           set("exits/north",__DIR__"senlin-"+(1+random(8)));
           if("exits/south") delete("exits/south");
           if("exits/east") delete("exits/east");
           if("exits/west") delete("exits/west");
        }
        if(NATURE_D->query_daytime() == "event_afternoon"
        || NATURE_D->query_daytime() == "event_evening"){
           set("exits/east",__DIR__"senlin-"+(1+random(8)));
           if("exits/north") delete("exits/north");
           if("exits/south") delete("exits/south");
           if("exits/west") delete("exits/west");
        }
        if( NATURE_D->query_daytime() == "event_night"
         ||NATURE_D->query_daytime() == "event_midnight"){
           set("exits/south",__DIR__"senlin-"+(1+random(8))); 
           if("exits/north") delete("exits/north");
           if("exits/east") delete("exits/east");
           if("exits/west") delete("exits/west");
        }
}
