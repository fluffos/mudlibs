// bencao
inherit ITEM;
void create()
{
        set_name("本草纲目", ({ "bencao gangmu", "gangmu", "shu"}));
        set_weight(300);
        if( clonep() )
            set_default_object(__FILE__);
        else {
            set("unit", "本");
            set("long","这是一本明代李时珍所著的有关本草术理的书。集天下药理之大成。\n");
            set("value", 400);
            set("material", "paper");
            set("skill", ([
            "name": "medicine",    // name of the skill
            "exp_required": 10, // minimum combat experience required
            "jing_cost":    15,// jing cost every time study this
            "difficulty":  20,// the base int to learn this skill
            "max_skill":  87,// the maximum level you can learn to
            "min_skill":  82,// minimun level required
            ]) );
        }
}
