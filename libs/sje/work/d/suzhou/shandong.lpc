inherit ROOM;

int do_study();
int do_break();
void create() {
  set("short", "小山洞");
  set("long", @long
这里是假山里的地下密室。密室虽小，却也五脏俱全，石桌石椅，石几
石床，连室内放的几件器皿，也都是石制的。看来似乎很久以前有人在这里
住过。墙壁(wall)上好象刻着些什么。
long);


  set("item_desc", ([

    "wall": "这是一整块墙面，上面刻了些奇怪的图形。\n",
  ]));

  setup();
}

void init() {
  add_action("do_break", "break");
  add_action("do_study", "study");
}


int do_study(string arg) {
  object me;

  me = this_player();

  if (!living(this_player()) || arg != "wall")
    return 0;

  if ((int)me->query_skill("literate", 1) < 1)
    return notify_fail("你是个文盲，先学点文化(literate)吧。\n");

  me->receive_damage("jing", random(40));

  message_vision("$N专心研读墙面上的古怪图形。\n", me);

  me->delete_temp("stone_learned");
  switch (random(5)) {
    case 0:
      if ((int)me->query_skill("finger", 1) < 100) {
        write("你对着墙面琢磨了一回儿，似乎对指法有点心得。\n");
        me->improve_skill("finger", me->query("int"));
        me->set_temp("stone_learned", 1);
      }
    case 1:
      if ((int)me->query_skill("claw", 1) < 100) {
        write("你对着墙面琢磨了一回儿，似乎对爪法有点心得。\n");
        me->improve_skill("claw", me->query("int"));
        me->set_temp("stone_learned", 1);
      }
    case 2:

      if ((int)me->query_skill("strike", 1) < 100) {
        write("你对着墙面琢磨了一回儿，似乎对掌法有点心得。\n");
        me->improve_skill("strike", me->query("int"));
        me->set_temp("stone_learned", 1);
      }
    case 3:
      if ((int)me->query_skill("cuff", 1) < 100) {
        write("你对着墙面琢磨了一回儿，似乎对拳法有点心得。\n");
        me->improve_skill("cuff", me->query("int"));
        me->set_temp("stone_learned", 1);
      }
    case 4:
      if ((int)me->query_skill("hand", 1) < 100) {
        write("你对着墙面琢磨了一回儿，似乎对手法有点心得。\n");
        me->improve_skill("hand", me->query("int"));
        me->set_temp("stone_learned", 1);
      }
  }

  if (!me->query_temp("stone_learned"))

  {
    write("你对着墙面琢磨了一回儿，发现上面所说的太过浅显，对你来说已毫无意义了。\n");
  }
  return 1;
}
int do_break(string arg) {
  int n;
  n = this_player()->query("neili");
  if (!arg || arg != "wall") {
    write("你要打碎什么的东西！\n");
    return 1;
  }

  message_vision(
    "$N深吸一口气，双掌同时拍出。\n", this_player());

  if (n >= 200) {
    message_vision(
      "$N只听一声“轰”的一声，$N把岩石震开了！一个向上的洞口出现在你面前。\n", this_player());
    set("exits/up", __DIR__ "jiashan");
    this_player()->set("neili", n - 200);
    remove_call_out("close");
    call_out("close", 5, this_object());
  } else {
    message_vision(
      "$N大吼一声“开！”，结果什么也没发生。看来$N的内力不够强。\n", this_player());
    this_player()->set("neili", 0);
  }

  return 1;
}

void close(object room) {
  message("vision", "岩石滚回了原位，又挡住了洞口。\n", room);
  room->delete("exits/up");
}
