// huoji. 药铺伙计

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 18);
	set("long", "他是一位从乡下来帮忙的伙计。\n");
	set("combat_exp", 250);
	set("attitude", "friendly");
	set("vendor_goods", ([
              "/clone/medicine/dengxincao" :12,
              "/clone/medicine/fangfeng" :6,
              "/clone/medicine/fuling" :13,
              "/clone/medicine/gouji" :18,
              "/clone/medicine/guizhi" :14,


          ]));

	setup();
        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
