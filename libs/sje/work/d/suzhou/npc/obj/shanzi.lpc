#include  <weapon.h>

inherit  SWORD;

void  create()
{
                set_name("扇子",  ({ "shanzi" }) );
                set_weight(700);
                if(  clonep() )
                                set_default_object(__FILE__);
                else  {
                                set("unit", "把");
                                set("long", "一把很精制的扇子，上面刺绣着一朵花．\n");
                                set("value", 80);
                                set("material", "wood");
                                set("wield_msg", "$N「哗」地一声抽出一把$n握在手中。\n");
                                set("unwield_msg", "$N将手中的$n插入腰间。\n");
                }
                init_sword(20);
                setup();
}

