// yaolibook.c
// keinxin 2003.3
inherit ITEM;
#include <ansi.h>;
void create() {
  set_name(YEL "神龙药理" NOR, ({ "shenlong yaoli", "shu", "yaoli" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本" YEL "神龙药理" NOR "。
功能：" HIC "神龙药理(1--150)" NOR "\n");
    set("value", 400);
    set("treasure", 1);
    set("unique", 1);
    set("material", "paper");
    set("skill", ([
      "name": "shenlong-yaoli",    // name of the skill
      "exp_required": 1000,  // minimum combat experience required
      "jing_cost": 15,  // jing cost every time study this
      "difficulty": 30,  // the base int to learn this skill
      "max_skill": 150,  // the maximum level you can learn to
    ]));
  }
}
