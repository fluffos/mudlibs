inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
这是泰山边上的一条小路，弯弯曲曲的沿向东方的海滨。路边
长着些花草，几只蝴蝶在花丛中飞来飞去。一阵海风吹来，使你精
神更加爽朗。
LONG
        );

        set("exits", ([
        "west" : "/d/taishan/daizong",
		"northeast" : __DIR__"haitan",
                
        ]));


        set("outdoors", "taishan");
        setup();
        replace_program(ROOM);
}

