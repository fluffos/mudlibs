// shankou.c

inherit ROOM;

void create() {
  set("short", "山口");
  set("long", @LONG
你走到这里，眼前豁然开朗，迎面东边就是宽阔的海岸，阵阵海浪排击着岸
边的岩石，传来不断的涛声。一股股略带咸喂的海风迎面吹来，岸边小路正对着
有一道天然形成的堤岸，一直延伸的海的中间，着实是一个钓鱼的好地方。
LONG
  );
  set("exits", ([
    "west": __DIR__ "haitan",
    "east": __DIR__ "dian",
  ]));

  set("outdoors", "taishan");
  setup();
}
