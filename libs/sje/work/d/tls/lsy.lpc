#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIW "龙树院" NOR);
  set("long", @LONG
你进入了一间小松木屋，木屋门上挂了一个牌匾，上边写着“龙树院”，
你吃了一惊，想不到大名鼎鼎的天龙寺龙树院竟然就是这间小屋。四周的窗户
都打开着，从窗外透射进一丝阳光将木屋内照亮。
LONG);

  set("outdoors", "天龙寺");
  set("exits", ([
    "out": __DIR__ "songlin-1",
  ]));
  set("objects", ([
    __DIR__ "npc/kurong": 1,
  ]));

  setup();
}

void init() {
  add_action("do_jump", ({ "jump", "tiao" }));
}

int do_jump(string arg) {
  object me;
  me = this_player();
  if (arg != "chuang") return 0;
  if (!arg) return 0;
  if (!me->query_temp("meet_mu2"))
    return notify_fail("你要做什麽？\n");
  if ((int)me->query_skill("lingbo-weibu", 1) < 120) {
    message_vision(HIR "$N推开窗户，纵身跃起直奔窗外，无奈轻功不够，摔了下来！\n" NOR, me);
    me->unconcious();
    return 1;
  }
  if (((int)me->query_encumbrance() * 100 / (int)me->query_max_encumbrance() >= 30)) {
    write(HIR "你负重太多，双脚在窗台上一拌，摔倒在地。\n" NOR);
    me->unconcious();
    me->move(__DIR__ "lsy");
    return 1;
  }
  message_vision("$N推开窗户,纵身跃出窗户，一眨眼就不见了 。\n", me);
  me->move(__DIR__ "xiaojin1");
  tell_room(environment(me), me->name() + "从龙树院飞身跃了过来。\n", ({ me }));
  return 1;
}
