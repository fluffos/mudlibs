inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("野猪肉", ({ "yezhu rou", "rou", "meat" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块鲜血淋漓的猪肉。\n");
    set("unit", "块");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 50);
  }
}
