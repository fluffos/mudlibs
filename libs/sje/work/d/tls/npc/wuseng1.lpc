// Modify By River 99/04/05
inherit NPC;
void create() {
  set_name("武僧", ({ "wu seng", "seng", }));
  set("long", "他是一位身材高大的青年僧人，膀阔腰圆,十分威猛。\n"
    "身穿一袭青色布衣，似乎有一身武艺。\n");
  set("title", "天龙寺巡寺僧");
  set("gender", "男性");
  set("class", "bonze");

  set("age", 20);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 500);
  set("max_jing", 300);
  set("neili", 500);
  set("max_neili", 500);
  set("eff_jingli", 400);
  set("pursuer", 1);
  set("combat_exp", 40000);
  set("score", 1);

  set_skill("force", 60);
  set_skill("qiantian-yiyang", 60);
  set_skill("dodge", 60);
  set_skill("tianlong-xiang", 60);
  set_skill("duanjia-quan", 60);
  set_skill("parry", 60);
  set_skill("cuff", 60);

  map_skill("force", "qiantian-yiyang");
  map_skill("dodge", "tianlong-xiang");
  map_skill("parry", "duanjia-quan");
  map_skill("cuff", "duanjia-quan");
  prepare_skill("cuff", "duanjia-quan");

  setup();
  carry_object(__DIR__ "obj/cloth")->wield();
}
