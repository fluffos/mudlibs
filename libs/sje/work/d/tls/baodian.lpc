#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "大雄宝殿" NOR);
  set("long", @LONG
这是一座宽广的大殿，正中是三丈来高的南无如来释迦牟尼佛、
南无金刚不坏佛、南无宝光佛三尊宝像，通体镀金，光芒四射。宝座
下香炉中香烟缭绕，点的是那天竺檀香。蒲团前有一无量功德宝盒。
西过去通往地藏殿，东边是药师殿。
LONG);
  set("exits", ([
    "southdown": __DIR__ "road1",
    "north": __DIR__ "gfd",
    "west": __DIR__ "dizangdian",
    "east": __DIR__ "yaoshidian",
  ]));
  setup();
}

void init() {
  add_action("do_ketou", "ketou");
}

int do_ketou() {
  object me, ob;
  int i = me->query_skill("buddhism", 1);
  if (i < 20) i = 0;
  me = this_player();
  message_vision("$N虔诚地跪下来，在如来佛祖面前磕头。\n", me);

  if (me->query("shen") > 10)
    me->add("shen", -i / 20);
  if (me->query("shen") < -10)
    me->add("shen", i / 20);
  me->add("neili", -50);
  me->add("qi", random(20));
  me->start_busy(1);
  return 1;
}
