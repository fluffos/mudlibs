// /u/cool/tls/wanfodong2.c
// cool 1998.2.13
#include <room.h>
inherit ROOM;

void create() {
  set("short", "万佛洞");
  set("long", @LONG
阳光被外面的树林遮住，这洞内显得较昏暗，洞内满是精美的佛
像，墙上绘着佛祖的一生事迹的故事。走在洞里，你看着墙上的壁画，
感悟颇深。这里没有什么明显的出口。
LONG);
  set("exits", ([
    "out": __DIR__ "wfd",
    "north": __DIR__ "wfd3",

  ]));
  set("no_fight", 1);
  create_door("north", "石门", "south", DOOR_CLOSED);

  setup();
}

void init() {
  add_action("do_linghui", "领会");
  add_action("do_linghui", "linghui");
}

int do_linghui() {
  object me = this_player();
  int i = me->query_skill("buddhism", 1);
  if ((me->query("jing", 1) < i)
    || (me->query("jingli", 1) < i)
    || (me->query("neili", 1) < i)) {
    message_vision("$N十分疲倦，坐了许久，并没有什么收获。\n", me);
    return 0;
  }
  if ((int)me->query("shen") < i * 100 && (int)me->query("shen") + i * 100 > 0)
    me->set("shen", 0);
  message_vision("$N盘腿静坐了下来，看着眼前的壁画，良久，似有所悟。\n", me);
  me->start_busy(i / 10);
  if ((int)me->query("shen") > i * 100 && (int)me->query("shen") > 0)
    me->add("shen", -i * 10);
  if ((int)me->query("shen") + i * 100 < 0 && (int)me->query("shen") < 0)
    me->add("shen", i * 10);
  me->add("neili", -i);
  me->add("jingli", -i);
  me->add("jing", -i);
  return 1;
}
