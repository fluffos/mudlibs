#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "普渡寺" NOR);
  set("long", @LONG
庙宇十分颓败，一间正殿，两上耳房，正殿无门，只有黑呼呼一个门
洞，十足一只蹲踞的怪兽，抬腿进了正殿，但见泥塑(神像)还在，油漆早
已驳落成枯灰之色，是一尊张牙舞爪、巨睛狮鼻的金刚，还缺着一条腿，
香案没有，庙内积尘盈足，踩上去“扑扑”作响，灰烟扑面。
LONG
  );

  set("exits", ([
    "north": __DIR__ "dongjie2",
  ]));

  setup();
}
