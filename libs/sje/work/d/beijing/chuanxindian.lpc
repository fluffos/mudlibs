#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "传心殿" NOR);
  set("long", @LONG
过了前院，穿过一带月季花藤密密编起的花廊，里边豁然一座殿舍，
踏着又松软又舒服的青草地，来到殿前，但见檐下饲着只鹦鹉在叽叽学舌
，入得殿内，只见东暖阁炕边一个景泰蓝制大熏笼生着熊熊炭火，一边放
着张很大的竹制藤椅，窗边一案台上的铜鼎里焚着百合香。
LONG
  );

  set("exits", ([
    "west": __DIR__ "wenhuadian",
  ]));

  setup();
  replace_program(ROOM);
