#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"浮碧亭"NOR);
        set("long", @LONG
亭子盖在御花园角的一个湖边，湖水清澈见底，往湖上望去，只见鱼儿
在水面上吐着气泡，露出黑灰的背脊，还不时跃出水面，“啪”的一声，然后
又调皮地落到水里，白亮的肚皮一闪，便悠哉悠哉的游到水底下了。
LONG
        );
        set("outdoors", "京城");

        set("exits", ([
                 "southwest" :__DIR__"yuhuayuan",
        ]));
        
        setup();
        replace_program(ROOM);
}

