#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "咸安门" NOR);
  set("long", @LONG
面前一道弧形高墙，只见大门紧闭，门上剥落的漆块处呈灰白的死鱼
眼色，旁边仪门处开了个四尺宽的小门，由栅栏护着，一到夜晚，栅栏门
一关，再由内务府、宗仁府派人守卫，严实得铁桶般，插翅的飞鸟也难以
自由出入。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "north": __DIR__ "baoyunlou",
    "west": __DIR__ "xihuamen",
    "east": __DIR__ "wuyindian",
  ]));

  setup();
  replace_program(ROOM);
}
