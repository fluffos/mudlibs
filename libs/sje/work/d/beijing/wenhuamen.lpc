#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "文华门" NOR);
  set("long", @LONG
这院墙都足有七八丈高，院门是镶着铁皮，包着铜钉的大木门，跨过
院门，穿过短短的一条通道，里面是一个小院，种有花草树木，树木之中
掩映着间建筑结构十分精巧的宫殿。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "north": __DIR__ "wenhuadian",
    "south": __DIR__ "xuetang",
  ]));

  setup();
}
