// Room: /d/beijing/tiantan.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"天坛入口"NOR);
        set("long", @LONG
迎面是一座巨大的汉白玉牌楼，整个牌楼雕刻着许多的鸟兽鱼虫，手工
极之精细，上面题着“天坛”二字，笔走龙蛇，气势不凡，站立其下，不由
然有一种神圣庄严的感觉。
LONG
        );
        set("outdoors", "京城");

        set("exits", ([
                "east" : __DIR__"tiantan2",
                "west" : __DIR__"picai",
        ]));
        
        set("objects", ([
         __DIR__"npc/jinyiwei" : 4,
        ]));
        setup();
}

int valid_leave(object me, string dir)
{
    int i;
    object *inv;
        if(dir=="east") {
        if (me->query_temp("guanfu"))
       {
        message_vision(HIY"锦衣卫恭恭敬敬地对你说道：“大人请慢走。”\n"NOR, me); 
        return ::valid_leave(me, dir);
       }        
        if (me->query("gender") == "女性") {
        if(objectp(present("jin yiwei", environment(me))))
            return notify_fail("锦衣卫上前挡住你说道：拦住你说道：里面没什么好看的，马上离开这里....！\n");
        }

     if (me->query("gender") == "男性") {
        if(objectp(present("jin yiwei", environment(me))))
            return notify_fail("锦衣卫伸手拦住你朗声说道：拦住你说道：里面没什么好看的，马上离开这里....！\n");
        }
      
 }      
      return ::valid_leave(me, dir);
}
