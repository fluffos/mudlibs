#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"御花园"NOR);
        set("long", @LONG
这儿的花却是开得那么艳，香喷喷的花香如一阵风，迎面扑进鼻中，
各种的花争奇斗艳，品种繁多，真不愧为天子中御花园，园内林木依然
葱绿，古色古香的各种亭台楼阁掩映其间，外边是碧水环绕，还有叫不
出名字的小鸟跳跃其中，啾叫有声俨然是北国的江南。
LONG
        );

        set("outdoors", "京城");

        set("exits", ([
                 "north" :__DIR__"shenwumen",
                 "south" :__DIR__"kunningmen",
             "southeast" :__DIR__"wanchunting",
             "southwest" :__DIR__"qianqiuting",
             "northeast" :__DIR__"fubiting",
             "northwest" :__DIR__"chenruiting",
        ]));
        
        setup();
        replace_program(ROOM);
}

