inherit ROOM;

void create()
{
        set("short", HIC"延禧宫"NOR);
        set("long", @LONG
这间宫房不但宽阔而且设置巧夺天工，两间房行宫有门殿三间，整个
宫殿坐北朝南，进入门内，则横排着三座规制相同的门照子，是分进入库
房、御书房等处的大门。
LONG
        );

        set("exits", ([
                 "west" :__DIR__"rijingmen,
                 "east" :__DIR__"shuku",
                 "north":__DIR__"yonghegong",
             "northeast":__DIR__"chaku",
        ]));
        
        setup();
}

