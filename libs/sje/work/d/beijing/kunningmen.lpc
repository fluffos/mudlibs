#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"坤宁门"NOR);
        set("long", @LONG
此门往南不远处就是一群雕龙画柱的建筑，正是坤宁宫的所在，出了门
往北方树木青翠，林木成荫，层次叠翠分明，树上许多的鸟儿唧唧呱呱的叫
的正欢，那就是皇宫的御花园了。
LONG
        );

        set("outdoors", "京城");

        set("exits", ([
                 "north" :__DIR__"yuhuayuan",
                 "south" :__DIR__"qianqinggong",
        ]));
        
        setup();
        replace_program(ROOM);
}

