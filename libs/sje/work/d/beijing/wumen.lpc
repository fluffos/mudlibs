#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"午门"NOR);
        set("long", @LONG
此城门是通往内宫的主要通道，是朝中大臣进殿商议国事的必经之路
，所以守卫极之严密。除此之外，凡是被皇帝赐死杀头的王公大臣，都是
在这里处决的，门外的那座断头台上的铡刀透着寒光，时刻警惕经过的大
臣们。
LONG
        );
        set("outdoors", "京城");

        set("exits", ([
                 "south":__DIR__"guangchang",
                 "north":__DIR__"taihemen",            
        ]));
        
        setup();
        replace_program(ROOM);
}


