#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "太和殿" NOR);
  set("long", @LONG
整个大殿雕梁画柱，金碧辉煌，十分的华丽，地上铺的是水磨青砖，
高悬着的宫灯里的烛泪一滴滴落在砖上，一边的鎏金珐琅里散发出浓浓的
百合香气味，一堆堆的奏章和牒报在龙案上叠得老高。
LONG
  );

  set("exits", ([
    "east": __DIR__ "yongxiang2",
    "west": __DIR__ "yongxiang",
    "north": __DIR__ "zhonghedian",
    "south": __DIR__ "taihemen",
  ]));

  setup();
  replace_program(ROOM);
}
