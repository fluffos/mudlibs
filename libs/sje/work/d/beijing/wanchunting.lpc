#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "万春亭" NOR);
  set("long", @LONG
亭子被几株老干虬结的苍松翠柏包围着，夏天之际十分的阴凉清爽，
亭中摆设着石凳石桌，在这歇息乘凉，呼吸这里清新的空气，真的是说不
出的舒心舍意。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "northwest": __DIR__ "yuhuayuan",
  ]));

  setup();
}
