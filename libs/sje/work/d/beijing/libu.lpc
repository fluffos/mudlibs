// Room: /d/beijing/libu.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "礼部府衙大门" NOR);
  set("long", @LONG
礼部衙门这几天里，白天车水马龙，夜里灯烛辉煌，满汉尚书、侍郎
、各司主事忙得团团转，据说皇上要出巡，所以这帮大小官员一个个累得
力尽神疲，衙门前就见这班官员不停的进进出出，热闹极了。
LONG
  );

  set("exits", ([
    "north": __DIR__ "dongjie",
    "south": __DIR__ "libu2",
  ]));

  setup();
  replace_program(ROOM);
}
