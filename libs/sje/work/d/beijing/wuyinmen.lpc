#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"武英门"NOR);
        set("long", @LONG
眼前院墙足有丈五高，接层的痕迹极明显，墙后是一座巍峨挺立的大
殿，门是五楹倒厦门，门口有两只大青石狮子，有岗哨日夜巡逻，眼下门
口冷冷清清没有闲杂人。
LONG
        );
        set("outdoors", "京城");

        set("exits", ([
                 "north" :__DIR__"wuyindian",
                 "east" :__DIR__"youyimen",
                      ]));
        
        setup();
        replace_program(ROOM);
}


