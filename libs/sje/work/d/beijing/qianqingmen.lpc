// Room: /d/beijing/qianjingmen.c

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"乾清门"NOR);
        set("long", @LONG
宫里走廊殿角挂着的玻璃宫灯在风中摇晃，地上铺的都是青砖，穿过
乾清门，便去到乾清宫所在，四周大内侍卫一个个挺胸凹肚腰悬佩刀，钉
子似地站着，一阵风吹动着通道上的浮土，微微带些寒意扑面而来。
LONG
        );

        set("outdoors", "京城");
        set("exits", ([
                 "north" :__DIR__"qianqinggong",
                 "south" :__DIR__"baohedian",                                
        ]));
        
        setup();
        replace_program(ROOM);
}


