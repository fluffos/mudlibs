inherit ROOM;

void create() {
  set("short", HIC "兵部府衙大门" NOR);
  set("long", @LONG
面前一座雄伟的府院，大门上挂有“兵部府衙”四个大字的匾牌，往
门内望去，只见几十名兵丁墨线般排成两行，一动不动地站在那里，门边
停放的一顶六乘绿呢大轿格外显眼，几个轿夫站在旁边聊着天。
LONG
  );

  set("exits", ([
    "north": __DIR__ "xijie",
    "south": __DIR__ "bingbu2",

  ]));

  setup();
