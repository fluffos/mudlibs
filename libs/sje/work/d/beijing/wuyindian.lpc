#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "武英殿" NOR);
  set("long", @LONG
门内鹅卵石通道直通大厅，大厅面阔五间，绿琉璃剪边歇山顶，脊镶吻
兽，十分壮观，大厅内四个硕大的鎏金火盆兽炭熊熊，使得殿内十分的温暖
舒适，殿中还摆放着刀枪剑戟，十八般武器，和些木桩，石锁等，供皇上练
武之用。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "south": __DIR__ "wuyinmen",
    "west": __DIR__ "xiananmen",
  ]));

  setup();
  replace_program(ROOM);
}
