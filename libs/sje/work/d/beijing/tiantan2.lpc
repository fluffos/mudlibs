#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "天坛" NOR);
  set("long", @LONG
置身之处是一座高台，至顶足有三层楼高，四周围着一色汉白玉石栏杆，
当中立着由大理石铺设的祭坛，旁边竖立着一整块天然的白玉石，石面被磨
得光润如镜，上刻“天坛”二字。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "west": __DIR__ "tiantan",
  ]));

  setup();
}
