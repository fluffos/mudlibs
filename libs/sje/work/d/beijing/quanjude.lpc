#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "全聚德烤鸭店" NOR);
  set("long", @LONG
刚进门，就见一排金黄色的烤鸭挂在那儿，一阵阵烤鸭的香味不断地
往你鼻孔里钻，引得你的口水淌满了一地，恨不得一口就把全部烤鸭吞进
肚子里面。
LONG
  );

  set("exits", ([
    "east": __DIR__ "fenshen",
  ]));

  set("objects", ([
    __DIR__ "npc/cai": 1,
  ]));

  setup();
  replace_program(ROOM);
}
