// /d/beijing/yongdingmen.c

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"永定门"NOR);
        set("long", @LONG
这里是京城的第一道门户，城墙高耸，全部以大块灰石堆砌。城墙厚约
五尺，居高临下，易守难攻。高耸的城墙上站满了兵士，可见京城守卫极之
森严，出了此处城门往南就是通往中原的驿道，往来之人不少都是衣着光鲜
，一付商人模样，不时还有坐着八人大轿，一大帮兵丁拥着的大官进出。一
张发黄的告示(gaoshi)贴在墙上，许多官兵立在两旁。     
LONG
        );
        set("outdoors", "京城");
        set("item_desc", ([
                "gaoshi" : 
HIY"                
    ※※※※※※※※※※※※※※※※※※※※※※
    ※※※※　　　　　　　　　　　      ※※※※
    ※※※※    缉拿天地会一众反贼!     ※※※※
    ※※※※    举报一人，赏金十两,     ※※※※
    ※※※※　  捉拿一人，赏金百两。    ※※※※
    ※※※※　　知情不报者，立斩!　　　 ※※※※
    ※※※※　                          ※※※※
    ※※※※　　　　　       --鳌拜发 　※※※※
    ※※※※※※※※※※※※※※※※※※※※※※\n"NOR ,
        ]));


        set("exits", ([
                 "south" : __DIR__"guandao1",
                 "north" : __DIR__"qianmen1",
        ]));

        set("objects", ([
         __DIR__"npc/wujiang" : 1,
         __DIR__"npc/bing" :2,
        ]));
        setup();
}

int valid_leave(object me, string dir)
{
        if (dir =="north" )
        if(present("guan bing", (environment(me)))
        && me->query_condition("killer") > 0)
                return notify_fail("官兵大声喝道：“大胆刁民，竟敢杀人放火，还不束手就擒。”\n");
         
        return ::valid_leave(me, dir);
}

