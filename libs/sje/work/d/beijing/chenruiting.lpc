// Room: /d/beijing/chenruiting.c

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"澄瑞亭"NOR);
        set("long", @LONG
这亭子坐落在湖心中，一道回廊桥曲曲折折地架在湖中，直通对岸，
微风一起，水面上涟漪荡漾，波光粼粼，清人眼目，站在亭中观看红荷碧
叶，岸边柳枝低垂，说不出的清静轩朗。
LONG
        );

        set("outdoors", "京城");

        set("exits", ([
                 "southeast" :__DIR__"yuhuayuan",
        ]));
        
        setup();
        replace_program(ROOM);
}

