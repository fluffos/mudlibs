// bing.c 官兵

inherit NPC;

void create() {
  set_name("值勤官兵", ({ "guan bing", "bing", "solider" }));
  set("age", 22 + random(30));
  set("gender", "男性");
  set("long", "虽然官兵的武艺不能和武林人士相比，可是他们讲究的是人多力量大。\n");
  set("attitude", "peaceful");

  set("str", 20 + random(10));
  set("dex", 20 + random(10));
  set("combat_exp", 10000 + random(100000));
  set("shen_type", 1);

  set_skill("unarmed", 40 + random(100));
  set_skill("dodge", 40 + random(100));
  set_skill("parry", 40 + random(100));
  set_skill("blade", 40 + random(100));
  set_skill("force", 40 + random(100));
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 40 + random(100));
  set_temp("apply/armor", 40);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "值勤官兵喝道：大胆刁民，竟敢造反不成？\n",
    "值勤官兵喝道：跑得了和尚跑不了庙，你还是快快束手就擒！\n",
    "值勤官兵喝道：喝道：大胆刁民竟敢拒捕？反了！反了！\n",
  }));
  setup();
  carry_object(BINGQI_D("blade/blade"))->wield();
  carry_object(ARMOR_D("armor/junfu"))->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && living(this_object()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 0, ob);
  }
}

int accept_kill(object me) {
  command("say 大爷我正想找人杀呐，今天算你倒霉。\n");
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}

int accept_fight(object me) {
  command("say 大爷我正想找人杀呐，今天算你倒霉。\n");
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
