// cai.c 蔡老板

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("蔡老板", ({ "cai laoban", "laoban" }));
  set("gender", "男性");
  set("age", 42);
  set("combat_exp", 1300);
  set("attitude", "friendly");
  set("no_get", 1);
  set("vendor_goods", ([
    "/d/city/obj/jiudai": 20,
    __DIR__ "obj/kaoya": 20,
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();

}
void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment() || is_fighting(ob)) return;
  switch (random(2)) {
    case 0:
      say("蔡老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝杯茶，歇歇腿吧。\n");
      break;
    case 1:
      say("蔡老板用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
  }
}
