#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "东华门" NOR);
  set("long", @LONG
大门紧紧地闭着，两边各悬挂着一盏斗大的竹篾灯，映照得壁前一片通
红，沿街立着几十个御林禁军木桩似的钉在地上一动不动的，没有发出一丝
的声响，不仔细看，真会以为这些都是泥塑的雕像。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "west": __DIR__ "yushanchufang",
    "east": __DIR__ "dongmendajie",
  ]));

  setup();
  replace_program(ROOM);
}
