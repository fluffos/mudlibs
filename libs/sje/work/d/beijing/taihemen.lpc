#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "太和门" NOR);
  set("long", @LONG
从午门入到大内，但见两行亲兵，钉子一样排立着，佩在腰间的宽边
大刀拖着长长的流苏，满宫里抚廊殿角悬挂着一盏盏玻璃宫灯，一地里临
清砖路都镀着淡淡的银灰色，走过金水桥，登太和门而入，便见远处巍峨
的三大殿高耸，面前的就是太和殿的所在。
LONG
  );
  set("outdoors", "京城");

  set("exits", ([
    "south": __DIR__ "wumen",
    "west": __DIR__ "youyimen",
    "north": __DIR__ "taihedian",
    "east": __DIR__ "zuoyimen",
  ]));

  setup();
}
