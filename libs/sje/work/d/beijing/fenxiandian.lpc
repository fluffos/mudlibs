#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "奉先殿" NOR);
  set("long", @LONG
弯着腰往前走，过了朱漆剥落的二门，院子里更难走，像一步踏进了
幽冥地府，满院子都是青蔷，野草棵子，长得有半人高，入得殿内，只见
到处破落不堪，殿中摆着几张长木凳，其中有些还是缺条腿的，还有几张
木床，床上铺的是稻草，几个佝偻着腰的老太监坐在床边，不时一声声的
咳着。
LONG
  );

  set("exits", ([
    "south": __DIR__ "fenxianmen",
  ]));

  setup();
}
