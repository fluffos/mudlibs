#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "文华殿" NOR);
  set("long", @LONG
殿内打扫得一尘不染，中间一张御桌，一张逍遥椅，靠墙角放着一架
书，着上放着笔墨纸砚并一套茶具，几锭微墨齐整理在卷案上，墙上挂着
几幅古雅的字画，都是出至古代名家之手，幅幅都珍贵无比，价值连城。
LONG
  );

  set("exits", ([
    "south": __DIR__ "wenhuamen",
    "east": __DIR__ "chuanxindian",
  ]));

  setup();
  replace_program(ROOM);
}
