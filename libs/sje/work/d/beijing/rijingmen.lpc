#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"日精门"NOR);
        set("long", @LONG
前头一座宫殿，绿琉璃筒瓦重檐四角攒尖顶，上檐重昂五踩斗拱，下檐
为单翘单昂五踩镏金斗拱，雕甍插天飞檐突兀煞是壮观，泥金黑匾上端正写
着“延禧宫”三个大字。
LONG
        );
        set("outdoors", "京城");

        set("exits", ([
                 "west" :__DIR__"qianqinggong",
                 "east" :__DIR__"yanxigong",
        ]));
        
        setup();
        replace_program(ROOM);
}

