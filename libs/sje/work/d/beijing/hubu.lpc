#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"户部府衙大门"NOR);
        set("long", @LONG
这户部衙门掌管的是朝廷钱粮赋税收入，所以朝廷派有重兵看守，三
步一岗五部一哨，进出的人都要盘查搜身，防卫极之严密，门口挨挨压压
排了一长溜儿官轿，俱都是各省藩司衙门来京回事的、提取库银的。
LONG
        );

        set("exits", ([
                "north" : __DIR__"xijie2",             
                "south"  : __DIR__"hubu2"
                
        ]));
        
        setup();
        replace_program(ROOM);
}


