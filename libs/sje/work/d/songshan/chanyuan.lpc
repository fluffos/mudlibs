// Room: /d/songshan/chanyuan.c
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "峻极禅院");
	set("long", @LONG
这里是嵩山峻极宫之峻极禅院，也是是嵩山派的据点。以前曾是寺院，
现在院子却是中古柏森森，殿上并无佛像，大殿虽也极大，可比之少林寺
的大雄宝殿却还有不如，可以容纳近千人。几名嵩山派弟子正提剑巡逻。
LONG);
	set("exits", ([ 
            "west" : __DIR__"zmwshi",
            "north" : __DIR__"shidao1",
            "south" : __DIR__"dmeng",
            "east" : __DIR__"csshi",
        ]));
        set("objects", ([ 
            __DIR__"npc/ding" : 1,
            __DIR__"npc/fei" : 1,
            __DIR__"npc/ssdizi" : 2,
        ]));
	setup();
}

