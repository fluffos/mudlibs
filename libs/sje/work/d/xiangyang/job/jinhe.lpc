#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(YEL"檀木锦盒"NOR, ({"tanmu jinhe", "jinhe", "he"}));
	set_weight(10);


    set("value", 0);
	if (clonep())
		set_default_object(__FILE__);
	else {

    set("value", 0);
		set("long", "一个制作精美的"+YEL"檀木锦盒"NOR+"，打开(open)看看。\n");
		set("unit", "个");
	}
}
  void init()
{
  add_action("do_open","open");
}
int do_open()
{
	int i,exp,pot;
	object me = this_player();
        object ob;
	this_player()->start_busy(1);
	message_vision("$N打开了"+YEL"檀木锦盒"NOR+"。\n", this_player());

             
        i=random(23);

        if (i==19) {
       
        ob=new("clone/food/jiudai");
        ob->move(me);	
	
	tell_object(me,HIR"原来里面竟然是一个"+ob->query("name")+""HIR"，你气得昏了过去！\n"NOR);
        me->unconcious();
	}

        else if (i==22) {
       
        ob=new("clone/armor/phoenix/pifeng");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一件"+ob->query("name")+"\n"NOR);
	}
	
        else if (i==21) {
       
        ob=new("clone/armor/phoenix/hufu");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一块"+ob->query("name")+"\n"NOR);
	}	

        else if (i==20) {
       
        ob=new("clone/armor/phoenix/head");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一个"+ob->query("name")+"\n"NOR);
	}

        else if (i==18) {
       
        ob=new("/clone/money/gold");
        ob->set_amount(20);   
        ob->move(me);	
	
	tell_object(me,HIY"原来里面是二十两黄金，你满足的点了点头。\n"NOR);
        
	}

        else if (i==17) {
       
        ob=new("clone/medicine/puti-zi");
        ob->move(me);
	
	
	tell_object(me,HIY"原来里面有一个"+ob->query("name")+"\n"NOR);
        
	}

        else if (i==16) {
       
        ob=new("u/keinxin/jinpai");
        ob->move(me);
	
	
	tell_object(me,HIY"原来里面有一块"+ob->query("name")+"\n"NOR);
        
	}       

        else if (i==15) {
       
        ob=new("/d/xiangyang/job/jinhe");
        ob->move(me);	
	
	tell_object(me,"原来里面竟然又是一个"+ob->query("name")+"，你感到好生奇怪。\n"NOR);
        
	}              

        else if (i==14) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIR"不好，里面居然是一条毒蛇，你被咬了一口。\n"NOR);
	me->apply_condition("snake_poison",1+random(2));
        
	}       
 
        else if (i==13) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIY"底层居然是两颗九转金丹。\n"NOR);
        ob=new("/quest/shenshu/sdan");
        ob->move(me);	
        ob=new("/quest/shenshu/sdan");
        ob->move(me);	   
        
	}       
	
        else if (i==12) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIR"不好，里面居然射出了一支毒剑，你被射中了。\n"NOR);
	me->unconcious();	
        
	}      	
	
	else if (i==11) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIY"底层居然是一颗九转金丹。\n"NOR);
        ob=new("/quest/shenshu/sdan");
        ob->move(me);	       
        
	}      	

	else if (i==10) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIR"的确是空的，你无奈地耸了耸肩。\n"NOR);
        
	}      	
	
       
        else if (i==9) {
       
        ob=new("clone/armor/phoenix/shoe");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一双"+ob->query("name")+"\n"NOR);
	}
       
        else if (i==8) {
       
        ob=new("clone/armor/phoenix/armor");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一件"+ob->query("name")+"\n"NOR);
        
	}
       
        else if (i==7) {
       
        ob=new("/clone/money/gold");
        ob->set_amount(20);   
        ob->move(me);	
	
	tell_object(me,HIY"原来里面是二十两黄金，你满足的点了点头。\n"NOR);
        
	}       
       
        else if (i==6) {
       
        ob=new("/d/xiangyang/job/jinhe");
        ob->move(me);	
	
	tell_object(me,"原来里面竟然又是一个"+ob->query("name")+"，你感到好生奇怪。\n"NOR);
        
	}              
       
        else if (i==5) {
       	
	tell_object(me,HIB"里面竟然什么也没有，你又翻了翻。\n"NOR);
	tell_object(me,HIR"的确是空的，你无奈地耸了耸肩。\n"NOR);
        
	}       
       
        else if (i==4) {
       
        ob=new("clone/armor/jixiang/huxin");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一块"+ob->query("name")+"\n"NOR);
        
	}
	else if (i==3) {
       
        ob=new("clone/armor/jixiang/huyao");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一个"+ob->query("name")+"\n"NOR);
        
	}
	else if(i==2)	{
       
        ob=new("clone/armor/jixiang/huwan");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一个"+ob->query("name")+"\n"NOR);
        
	}
	else if(i==1)	{
       
        ob=new("clone/armor/jixiang/armor");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一件"+ob->query("name")+"\n"NOR);
        
	}
	else if(i==0)	{
       
        ob=new("clone/armor/jixiang/pifeng");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一件"+ob->query("name")+"\n"NOR);
        
	}
	else {
       
        ob=new("clone/food/jiudai");
        ob->move(me);
	
	
	tell_object(me,HIR"原来里面有一个"+ob->query("name")+"\n"NOR);
        
	} 
             
	destruct(this_object());
	return 1;
}
void owner_is_killed()
{
	destruct(this_object());
}