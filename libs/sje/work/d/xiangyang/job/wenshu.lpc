// wehshu.c 文书
// Created by keinxin@sj2 2003.3


#include <ansi.h>
inherit ITEM;

#define TIME_TICK (time()*60)
void create() {
  set_name(MAG "劝降文书" NOR, ({ "quanxiang wenshu", "letter", "wenshu" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long", "这是一封元朝的劝降文书，招揽天下英雄和武林豪杰。\n");
    set("value", 0);
    set("material", "paper");
    set("no_drop", 1);
  }
}

void init() {
  call_out("dest", random(100) + 600);
  add_action("do_sign", "sign");
  add_action("do_look", "kan");
}

int do_look(string arg) {
  object me = this_player();
  object ob = this_object();

  if (!arg) return 0;
  if ((arg == "quanxiang wenshu" || arg == "wenshu" || arg == "letter")
    && query("owner") == me
    && me->query_temp("renwu/time")
    && me->query_temp("renwu/id")) {
    tell_object(me, "让" + me->query_temp("renwu/name") + "在劝降书上签字！\n");
    return 1;
  }
  if ((arg == "quanxiang wenshu" || arg == "wenshu" || arg == "letter")
    && me->query("id") == ob->query("renwu/id")) {
    tell_object(me, "如果你同意投降元朝，请在文书上签字(sign)！\n");
    return 1;
  } else return 0;
}

int do_sign(string arg) {
  object me, ob;
  mapping renwu;
  me = this_player();
  ob = this_object();



  if (!mapp(renwu = ob->query("renwu")) || renwu["id"] != me->query("id")) {
    return notify_fail("看清楚！！这不是给你的劝降书。\n");
  }

  if (ob->query("succeed_id") == me->query("id")) {
    return notify_fail("看清楚！！你已经签了字了。\n");
  }
  message_vision(CYN "$N说道：既然是郡主的一番美意，那么我就恭敬不如从命了！\n" NOR, me);
  ob->set("succeed_id", me->query("id"));
  return 1;

}

void dest() {
  message_vision("$N忽然掉落在路上不见了。\n", this_object());
  destruct(this_object());
}
