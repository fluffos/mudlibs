//2003.6


#include <ansi.h>

inherit ITEM;


void create() {
  set("unit", "封");
  set("material", "paper");
  set("npc", 5);
  set_weight(1);
  setup();
}

void init() {
  object me = this_player();

  set_name(WHT "告急文书" NOR, ({ "wenshu" }));

  set("long", "这是一封郭靖发出的襄阳告急文书(gaoji XXX)。\n");

  if (me && present(this_object(), me)) {
    call_out("dest", random(100) + 600);
    add_action("do_gaoji", "gaoji");
  }
}

int do_gaoji(string str) {
  object me = this_player(), ob = this_object();
  object ob1;
  int exp, pot, shen;

  if (!str || str == "")
    return notify_fail("你要向谁告急？\n");

  if (!objectp(ob1 = present(str, environment(me))))
    return notify_fail("这里没 " + str + " 这个人。\n");

  if (!living(ob1))
    return notify_fail("你等" + ob1->name() + "醒来再说吧。\n");

  if (ob1->query("id") != "yue buqun"
    && ob1->query("id") != "xuanci dashi"
    && ob1->query("id") != "huang yaoshi"
    && ob1->query("id") != "zhang sanfeng"
    && ob1->query("id") != "duan zhengchun"
  )
    return notify_fail("军情可不能随便对什么人都乱说。\n");

  if (file_name(environment(this_player())) != "/d/huashan/zhengqi"
    && file_name(environment(this_player())) != "/d/thd/jicui"
    && file_name(environment(this_player())) != "/d/shaolin/fzjs2"
    && file_name(environment(this_player())) != "/d/wudang/houyuan"
    && file_name(environment(this_player())) != "/d/dali/wangfu/nuange"
  )
    return notify_fail("这里不方便透露军情。\n");

  if (ob1->query("id") == ob->query_temp("guo_job_gaoji_1")
    || ob1->query("id") == ob->query_temp("guo_job_gaoji_2")
    || ob1->query("id") == ob->query_temp("guo_job_gaoji_3")
    || ob1->query("id") == ob->query_temp("guo_job_gaoji_4")
  )
    return notify_fail("没有必要说两遍。\n");

  if (me->query_temp("guo_job1") < 1) {
    message_vision("$N交给$n一张告急文书。\n\n $n大叫一声：“不好！！你怎么这么晚才送来这封文书？蒙古大军已经开始攻打襄阳了！\n\n", me, ob1);
    message(
      "channel:chat",
      HIR "【保卫襄阳】" HIC + ob1->query("name") + "(" + ob1->query("id") + ")：" + ob1->query("family/family_name") + "弟子听令，" + me->query("name") + "(" + me->query("id") + ")贻误军机，人人得而诛之！！\n" NOR,
      users()
    );
    destruct(this_object());
    return 1;
  }

  message_vision("$N交给$n一张告急文书。\n\n", me, ob1);
  message_vision("$n对$N说道：请告诉郭大侠放心"
    +RANK_D->query_respect(ob1)
    + "立刻起身赶赴襄阳助阵。\n\n", me, ob1);

  message(
    "channel:chat",
    HIR "【保卫襄阳】" HIC + ob1->query("name") + "(" + ob1->query("id") + ")：" + ob1->query("family/family_name") + "弟子听令，如今蒙古大军兵临襄阳，你们火速前往襄阳协助郭大侠和" + me->query("name") + "(" + me->query("id") + ")抗击敌军！！\n" NOR,
    users()
  );

  ob->add("npc", -1);
  me->add_temp("guo_job1npc", 1);
  switch (ob->query("npc")) {
    case 4:
      ob->set_temp("guo_job_gaoji_4", ob1->query("id"));
      break;
    case 3:
      ob->set_temp("guo_job_gaoji_3", ob1->query("id"));
      break;
    case 2:
      ob->set_temp("guo_job_gaoji_2", ob1->query("id"));
      break;
    case 1:
      ob->set_temp("guo_job_gaoji_1", ob1->query("id"));
      break;
  }
  if (ob->query("npc") < 1) {

    exp = 1000 + random(500);
    pot = exp / 5 + random(exp / 5);
    shen = exp / 2 + pot / 2;
    write(sprintf(HIW "好，各路高手已经都要起身去襄阳助阵，你的任务完成了。\n你得到了\n"
      +CHINESE_D->chinese_number(exp)
      + "点实战经验\n"
      +CHINESE_D->chinese_number(pot)
      + "点潜能\n"
      +CHINESE_D->chinese_number(shen)
      + "点正神。\n\n" BLINK + HIR "现在你可以去襄阳找郭靖同各路高手一起抗击蒙古大军了。\n\n" NOR));

    log_file("job/guojob1", sprintf("%s %s(%s) 做郭靖“邀请武林前辈”任务，得到%d点经验。\n",
      ctime(time())[4..19], me->query("name"), me->query("id"), exp));
    me->delete_temp("guo_job1");
    me->delete_temp("guo_job1npc");
    me->delete_temp("guo_zuji");
    me->clear_condition("guojob_1");
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("shen", shen);
    me->add("guo_job", 1);
    me->set_temp("guo_job_2_can_ask", 1);
    destruct(this_object());
  }

  return 1;
}

void dest() {
  message_vision("$N忽然掉落在路上不见了。\n", this_object());
  destruct(this_object());
}
