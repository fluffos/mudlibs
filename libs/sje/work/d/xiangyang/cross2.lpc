               "west" : __DIR__"xiaoxiang1",
	]));
             set("objects",([
                "/d/xiangyang/npc/zhaomin" : 1,
                "/d/xiangyang/npc/jianxi" : 1, 
                "/d/xiangyang/npc/guo" : 1, 
