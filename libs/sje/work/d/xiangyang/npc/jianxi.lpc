#include <ansi.h>
inherit NPC;

void create() {


  set_name("赤哈尔", ({ "chi haer", "chi", "haer" }));

  set("title", YEL "蒙古奸细" NOR);

  set("age", 20 + random(30));
  set("attitude", "peaceful");
  set("shen", -80000);
  set("str", 20 + random(10));
  set("int", 20 + random(10));
  set("con", 20 + random(10));
  set("dex", 20 + random(10));
  set("unique", 1);

  set("max_qi", 500 + random(3000));
  set("max_jing", 500 + random(3000));
  set("eff_jingli", 500 + random(3000));
  set("jiali", 10 + random(10));
  set("combat_exp", 20000 + random(10000));
  set("tasknpc", 1);
  set("no_get", 1);
  set_skill("medicine", 220);
  set_skill("force", 60 + random(100));
  set_skill("dodge", 100 + random(100));
  set_skill("lingbo-weibu", 60 + random(100));
  set_skill("strike", 80 + random(100));
  set_skill("tiezhang-zhangfa", 80 + random(100));
  set_skill("guiyuan-tunafa", 80 + random(100));
  set_skill("parry", 80 + random(100));
  set_skill("literate", 80);
  map_skill("force", "guiyuan-tunafa");
  map_skill("dodge", "lingbo-weibu");
  map_skill("strike", "tiezhang-zhangfa");
  map_skill("parry", "qiankun-danuoyi");
  prepare_skill("strike", "tiezhang-zhangfa");

  set("chat_chance", 20);
  set("chat_msg", ({
    (: perform_action, "strike.zhangdao" :),
  }));


  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 20);
  set_temp("apply/damage", 20 + random(8));

  setup();
  set("check_time", time());
  set("wuyazi_bmfind", 1);
  set("fenwo", 300);
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/xiangyang/job/mihan");
  add_money("gold", 3 + random(3));
}
