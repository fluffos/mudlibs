#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

string ask_job(string arg);
string ask_offer();
string ask_times();

void create() {
  set_name("赵敏", ({ "zhao min", "min", "zhao" }));
  set("title", HIY "大元绍敏郡主" NOR);
  set("long",
    "她脸泛红霞，容色丽都。十分美丽之中，更带着三分英气，三分豪态，同
时雍容华贵，自有一副端严之致，令人肃然起敬，不敢逼视。\n");
  set("gender", "女性");
  set("age", 15);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 30);
  set("str", 15);
  set("int", 25);
  set("con", 25);
  set("dex", 30);
  set("unique", 1);
  set("no_get", 1);

  set("max_qi", 500);
  set("max_jing", 200);
  set("max_neili", 500);
  set("neili", 500);
  set("jiali", 50);
  set("combat_exp", 50000 + random(10000));
  set("score", 20000);


  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("sword", 80);
  set_skill("taiji-shengong", 90);
  set("chat_chance", 5);
  set("inquiry", ([
    "张无忌": "张公子远在昆仑，不知他近来可好？秋冷春寒，可有寒衣？\n",
    "招揽天下英雄": (: ask_job :),
    "奖赏": (: ask_offer :),
    "功劳": (: ask_times :),
  ]));

  setup();
  carry_object("/d/city/obj/pink_cloth")->wear();
  add_money("gold", 20);
}


string ask_offer() {
  object ob;
  if (this_player()->query("zm_job") < 12)
    return RANK_D->query_rude(this_player()) + "你给我做了几次任务，就想来要奖赏？";

  if (this_player()->query("zm_offer") + 8 >= this_player()->query("zm_job"))
    return RANK_D->query_rude(this_player()) + "你还是先做点任务再来我这里领赏吧。";

  this_player()->set("zm_offer", this_player()->query("zm_job"));

  message_vision("赵敏给了$N一个" YEL "檀木锦盒。" NOR "\n", this_player());

  ob = new("/d/xiangyang/job/jinhe");
  ob->move(this_player());
  return RANK_D->query_respect(this_player()) + "这是你的奖励。";
}


string ask_times() {
  object ob;
  if (this_player()->query("zm_job") < 1)
    return RANK_D->query_rude(this_player()) + "你给我做了几次任务？";

  return RANK_D->query_respect(this_player()) + "你帮我做了" + chinese_number(this_player()->query("zm_job")) + "次工作。";
}


string ask_job(string arg) {
  object player, target, me, ob;
  mapping renwu;

  player = this_player();
  me = this_object();

  if ((int)player->query_condition("zm_job") > 2)
    return "你等等来吧！\n";
  if (player->query("combat_exp") < 120000)
    return "就以你的武功还想帮我招揽天下英雄？\n";

  // now all jobs use this condition.
  if ((int)player->query_condition("zm_busy")) {
    if (player->query_temp("renwu/id") && player->query_temp("renwu/type") == "劝降")
      return "不是让你去劝降" + player->query_temp("renwu/name") + "了吗，怎么还在这里？\n";
    if (player->query_temp("renwu/type") == "劝降")
      return "教给你的任务你还没完成怎么又跑回来了！\n";
    else return "你刚刚做完任务，先休息一下，等等来吧！\n";
  }


  if (!mapp(renwu = RENWU_D->get_renwu(target)))
    return "现在我还没有想到要邀请哪位英雄，你等会再来吧。\n";

  player->set_temp("renwu", renwu);
  player->apply_condition("zm_busy", 30 + random(30));
  player->set_temp("zm_job", 1);
  ob = new("/d/xiangyang/job/wenshu");
  ob->set("renwu", renwu);
  ob->set("owner", player->query("id"));
  ob->move(player);
  message_vision(HIW "赵敏给了$N一封" MAG "劝降文书\n" NOR, player);
  return "好吧，最近「" + renwu["name"] + CYN "」一直活跃于中原武林，你前去设法将此人劝降！
          此人现在在" + renwu["place"] + CYN "一带，你带着这份文书去，务必在" + TASK_D->get_time(renwu["time"]) + "之前赶回来。\n";
}

int accept_object(object who, object ob, object me) {
  int exp, pot;
  me = this_object();

  if (ob->query("id") != "quanxiang wenshu") return 0;

  if (!who->query_temp("zm_job")) {
    command("say 我好象没有给过你任务啊？");
    return 0;
  }

  if (who->query_temp("renwu/type") != "劝降") {
    command("say 你做的不是我的任务吧！。\n");
    return 0;
  }


  if (ob->query("owner") != who->query("id")) {
    command("say 这好像不是我给你的劝降书吧！\n");
    return 0;
  }

  if (who->query_temp("renwu/id") != ob->query("succeed_id")) {
    command("say 这好像不是我要劝降的那个人吧！\n");
    return 0;
  }
  command("say 好办的不错，我元朝又多了一份力量！\n");
  tell_object(who, HIY "赵敏伏身在你耳边悄声指点了你一些武功要领...\n");
  exp = who->query_temp("renwu/exp_reward");
  pot = who->query_temp("renwu/pot_reward");
  pot += who->query("zm_job");
  who->add("zm_job", 1);
  who->add("combat_exp", exp);
  who->add("potential", pot);
  who->clear_condition("zm_busy");
  who->apply_condition("zm_job", 5 + random(5));
  who->delete_temp("renwu");
  who->delete_temp("zm_job");
  MONEY_D->pay_player(this_player(), random(5) * 10000);
  tell_object(who, HIW "你觉得脑中豁然开朗，增加了：             \n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" NOR);

  //用于记录和测试job的完成情况
  write_file("/log/zmjobs", sprintf("%s %s(%s)%d次任务奖励经验%d，潜能%d。\n",
    ctime(time())[4..19], who->name(1), who->query("id"), (int)who->query("zm_job"), exp, pot));

  call_out("destroy", 1, ob);
  return 1;
}

void destroy(object obj) {
  destruct(obj);
  return;
}
