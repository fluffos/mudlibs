#include <ansi.h>
inherit NPC;
string ask_job(string arg);
string ask_job2(string arg);
string ask_job3(string arg);
string ask_gonglao(string arg);
string ask_fangqi();
void create()
{
	set_name("温青青", ({ "wen qingqing", "wen", "qingqing" }));
	set("long", @LONG
　　她就是温仪与金蛇郎君夏雪宜之女，华山派弟子袁承志之妻。
为人爱使性子，成天对袁承志身边的女人疑神疑鬼。
LONG);
	set("gender", "女性");
	set("age", 18);
	set("attitude", "friendly");
	set("shen", -1000);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("per", 26);
	set("max_qi", 15000);
	set("max_jing", 1200);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 100);
	set("combat_exp", 900000);

	set_skill("force", 150);
	set_skill("yijin-jing", 150);
	set_skill("dodge", 150);
	set_skill("shaolin-shenfa", 150);
	set_skill("cuff", 150);
	set_skill("wenjia-daofa", 160);
	set_skill("parry", 150);
	set_skill("blade", 150);
	set_skill("wenjia-quan", 150);
	set_skill("literate", 110);
	map_skill("force", "yijin-jing");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "wenjia-quan");
	map_skill("parry", "wenjia-daofa");
	map_skill("blade", "wenjia-daofa");
	prepare_skill("cuff", "wenjia-quan");

	set("inquiry", ([
		"十三陵": (: ask_job :),
		"西陵": (: ask_job2 :),
		"东陵": (: ask_job3 :),
		"次数"  : (: ask_gonglao :),
		"fangqi": (: ask_fangqi :),
		"放弃"  : (: ask_fangqi :),
		"袁承志": "承志哥哥是我的夫君，不要打他的注意。",
		"何铁手": "嘻嘻，堂堂教主居然看不出我是个女儿身。",
	]));
	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/blade1")->wield();
	carry_object("/clone/misc/qunzi")->wear();
}

string ask_gonglao(object who)
{
	object me;
	int i;

	me = this_player();
	i = (int)me->query("daomu_job"); 

	if ( !me->query("daomu_job") ) return "你偷过东西吗？"; 

	command ("massage " + me->query("id"));
	return "「你应该帮助我盗了" + chinese_number(i) + "座坟墓了。」";
}

int filldata(object obj1)
{
	if(wiz_level(obj1)) return 0;
	if(!environment(obj1)) return 0;
	else return 1;
}

string ask_job(string arg)
{
	int i;
	object me, ob, obj;
        object obj1, *ob_list;

	me = this_player();
	ob = this_object();
	ob_list = users();
	ob_list = filter_array(ob_list, (: filldata :));

	if ( (int)me->query("combat_exp") < 1000000 )
		return "「你的能力太低了。出去弄不好偷不着，倒把自己弄丢了。」";

	if ( me->query_condition("killer") ) {
		command ( "fule " + me->query("id") );
		return "「先管好自己吧，如果大内捕快来了，要不要承志哥哥帮助呀？」";
	}
	if ( me->query("job_done") == "daomu_job" ) return "「你不是刚刚帮我偷过一次吗？」";

	if ( me->query_condition("job_busy" ) ) return "「哇，你比我还忙着，先做完你自己的任务吧。」";

	if ( me->query_condition("gb_busy" ) ) return "「你不是在帮丐帮做任务吗？」";

	if ( me->query_condition("xx_task" ) ) return "「你不是在帮星宿丁老贼做任务吗？」";

	if ( me->query_condition("guanfu_task" ) ) return "「你已经投靠官府这棵大树，还来我在帮助我偷官府的东西？」";

        if ( me->query_temp("daomu/job") ) {
		command ( "knock " + me->query("id") );
		return "「不叫你去做了吗？怎么还在这里？泡美媚也没有女这样的。」";
	}
        for (i=0; i < sizeof(ob_list); i++) {
                obj1 = ob_list[i];
                if ( obj1->query_temp("daomu/job") && obj1->query_temp("daomu/target") == "十三陵" )
		return "「对不住了，" + obj1->query("name") + "正在帮我呢。」";
        }
	command ( "wink " + me->query("id") );
	me->set_temp ("daomu/job", 1);
	me->set_temp ("daomu/target", "十三陵");
	ob->set_temp ("job_give", me->query("name"));
	return "「我正好想去十三陵采购一番，有" + RANK_D->query_respect(me) + me->query("name") + 
		"帮忙，一定能马到成功。」";
}

