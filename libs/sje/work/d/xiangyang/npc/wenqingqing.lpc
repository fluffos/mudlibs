string ask_fangqi()
{
	object me;
	int exp;

	me = this_player();
	exp = (int)me->query("daomu_job");
	exp = exp / 2 + random ( exp / 2 );

	if( ! me->query_temp("daomu") ) return "「你要干什么？闲着无聊吗？」";
        me->apply_condition("job_busy", 5);
        me->delete_temp("daomu");
        me->set("job_done", "daomu_job");
	me->add("daomu_job", -1);
	me->add("combat_exp", - exp);
	return "「既然你干不了也没关系，再去刻苦练功吧！」";
}

int accept_object(object me, object ob)
{
	int exp, pot, lvl;
	string msg;

	if ( ! me->query_temp("daomu/did_get") || ! me->query_temp("daomu/job") ) {
		command ("liumang " + me->query("id"));
		command ("say 这是什么东东？");
                return 0; 
        }
	if( ob->query("id") != "bao fu" ) {
		command ("liumang " + me->query("id"));
		command ("say 这是什么东东？");
                return 0;
        }
	lvl = (int)me->query_temp("daomu/hardness");
        exp = 200 * lvl + random(400);
	exp = exp * 2 / 3 + random (exp / 2);
	exp = exp + (int)me->query("daomu_job") / 10;
	pot = exp / 4 + random(exp/12);
        me->set("job_done", "daomu_job");
	me->add("combat_exp", exp);
	me->add("potential", pot);
	me->add("shen", -exp * 8);
	this_object()->add_money("gold", pot / 5);
	command("give " + me->query("id") + " " + pot / 5 + " gold");
	if( me->query("potential") > me->query("max_pot") * 3 ) me->set("potential", me->query("max_pot") * 3);

	tell_object(me, HIC"好！任务完成，你被奖励了：\n" + chinese_number(exp) + "点实战经验\n" +
		chinese_number(pot) + "点潜能\n"NOR);

	me->add("daomu_job", 1);
	write_file( "/log/job/daomu_job", sprintf("%s %s(%s)第%d次任务，经验：%d，潜能：%d；地点：%s；奖励等级：%d\n",
                ctime(time())[4..19], me->name(), me->query("id"), me->query("daomu_job"), exp, pot,
		me->query_temp("daomu/target"), me->query_temp("daomu/hardness") ));
        this_object()->delete_temp("job_give");
	CHANNEL_D->do_channel( this_object(), "rumor",
		sprintf(HIW"%s"HIM"成功地从"HIY"%s"HIM"盗得无数财宝。", me->name(),
		(string)me->query_temp("daomu/target") ));
        me->delete_temp("daomu");
        return 1;
}
