inherit ROOM;

void create() {
  set("short", "山间小路");
  set("long", @LONG
你进入了一片小森林，走在林间小路上，密密麻麻的树林挡住了阳光，
这里显得十分阴暗，树木交错纵横。
LONG
  );
  set("outdoors", "襄阳");

  set("exits", ([
    "northeast": __DIR__ "shanlu2",
    "south": __DIR__ "shanlu4",
  ]));
  set("objects", ([
    __DIR__ "npc/dingpopo": 1,
    __DIR__ "npc/pingpopo": 1,
    __DIR__ "npc/ruipopo": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "south"
    && (present("ping popo", environment(me))))
    return notify_fail("平婆婆上前拦住你的去路：想救那个小贱人，先过我这一关吧。\n");
  if (dir == "south"
    && (present("ding popo", environment(me))))
    return notify_fail("丁婆婆上前拦住你的去路：想救那个小贱人，先过我这一关吧。\n");
  if (dir == "south"
    && (present("rui popo", environment(me))))
    return notify_fail("瑞婆婆上前拦住你的去路：想救那个小贱人，先过我这一关吧。\n");
  return ::valid_leave(me, dir);
}
