// Room: /xiangyang/yaopu.c
// keinxin 2003.2
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "药铺");
  set("long", @LONG
这是一家药铺，一股浓浓的药味让你几欲窒息，那是从药柜上的几百个小
抽屉里散发出来的。神医平一指坐在茶几旁，独自喝着茶，看也不看你一眼。
一名小伙计站在柜台后招呼着顾客。
LONG);
  set("item_desc", ([
    "guanggao": "本店出售以下药品：
金创药：\t五十两白银
无常丹由桃花岛黄药师所配，生死肉骨．
朱睛冰蟾救治百毒，无效包换．
其他神药与老板面议。\n",
  ]));

  set("objects", ([
    __DIR__ "npc/ping": 1,
  ]));
  set("exits", ([
    "west": __DIR__ "cross1",

  ]));
  set("no_fight", "1");
  set("no_sleep", 1);
  set("no_steal", "1");

  setup();
  //	replace_program(ROOM);
}
void init() {
  add_action("do_moyao", "moyao");
  add_action("do_sleep", "sleep");
}
int do_moyao(string arg) {
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你正忙着磨药啊！\n");
  if (me->query("job_moyaoasked") < 1)
    return notify_fail("你没有领任务，磨什么药？\n");
  if (me->query("job_moyao") < 1)
    return notify_fail("你可以完成任务(task ok)了！\n");
  message_vision(HIY
    "$N擦了擦脸上的汗水，蹲在一边拿着药锤开始磨药了！！\n" NOR, me);
  me->add("jing", -20);
  me->add("job_moyao", -1);
  me->add("shen", 30);
  me->start_busy(3);
  return 1;
}

int do_sleep() {
  write("你不能睡在这里！\n");
  return 1;
}
