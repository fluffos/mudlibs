#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "汉水南岸");
  set("long", @LONG
你走进这里，哇，有好多的人在这里钓鱼呀！不时的传来兴
奋的喊叫声，这肯定又是有谁钓到了大鱼，看到他们忙忙碌碌、
兴奋的样子，你还有什么值得犹豫的，赶快拿好你的鱼杠开始
钓鱼(diao)吧？
LONG);
  set("exits", ([
    "north": "/d/xiangyang/hanshui1",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_clean_up", 0);
  //      set("coor/x",0);
  //	set("coor/y",0);
  //	set("coor/z",10);
  setup();
}
void init() {
  add_action("do_fish", "fish");
  add_action("do_fish", "diao");
}

int do_fish(string arg) {

  object me, ob;
  int kar;
  me = this_player();
  kar = (int)me->query("kar", 1);
  //         ob=new("/clone/money/gold");
  // 换成用MONEY_D->pay_player()函数来给玩家钱

  if (me->query("combat_exp") > 500000)
    return notify_fail("这里庙小容不下您这位大神！您还是到别的地方混饭吃吧！\n");
  else if (me->query("qi") < 20)
    return notify_fail("你快支持不住了，先歇会儿吧！\n");
  else if (me->is_busy())
    return notify_fail("你还是等这次钓完再说吧！\n");
  else if (me->query_temp("diaoyu/now"))
    return notify_fail("慢慢来，不要着急。\n");
  else

    message_vision("$N拿着一把钓鱼杆坐在大石头上钓起鱼来……。\n", me);
  me->set_temp("diaoyu/now", 1);
  call_out("remove_effect", (10 - random(kar) / 5), me);

  switch (random(10)) {
    case 0:
      tell_object(me, "你一提杆，钓到了一条" + HIR "大鲤鱼" NOR + "，恭喜，恭喜。 \n\n");
      me->add("potential", 60 + random(20));
      me->add("combat_exp", 100 + random(20));
      me->add("qi", -30);
      break;
    case 1:
      tell_object(me, "你猛一提杆，钓到了" + CYN "一个破草帽" NOR + "，晦气，晦气。  \n");
      tell_object(me, HIW "你看着破草帽不由的发呆了。  \n\n" NOR);
      me->add("qi", -10);

      break;
    case 2:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你的鱼漂晃动，你心里一急，猛的一提杆，钓到了一件" + RED "红色的肚兜。 \n" NOR, me);
      tell_object(me, HIB "你连声叫到：晦气，晦气。 \n\n" NOR);
      me->add("qi", -14);

      break;
    case 3:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你一提杆，钓到了一条" + HIC "鲶鱼" NOR + "，恭喜，恭喜。 \n\n");
      me->add("potential", 40 + random(20));
      me->add("combat_exp", 80 + random(20));
      me->add("qi", -12);
      break;
    case 4:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你一提杆，钓到了一条" + HIG "鲑鱼" NOR + "，恭喜，恭喜。 \n\n");
      me->add("potential", 30 + random(40));
      me->add("combat_exp", 50 + random(50));
      me->add("qi", -24);
      break;
    case 5:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你一提杆，钓到了一条草鱼，恭喜，恭喜。 \n\n");
      me->add("potential", 50 + random(50));
      me->add("combat_exp", 30 + random(50));
      me->add("qi", -20);

      break;
    case 6:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你一提杆，钓到了一条" + HIB "鲟鱼" NOR + "，恭喜，恭喜。 \n\n");
      me->add("potential", 70 + random(10));
      me->add("combat_exp", 120 + random(30));
      me->add("qi", -30);

      break;
    case 7:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你猛一提杆，钓到了" + WHT "一个废旧的睡袋" NOR + "，晦气，晦气。 \n");
      tell_object(me, HIY "你看着废旧的睡袋，眼睛立刻红了。 \n\n" NOR);
      me->add("qi", -30);

      break;
    case 8:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      message_vision("$N鱼漂晃动，$N心里一急，猛的一提杆，$N钓到了" + HIM "一个钱包! \n" NOR, me);
      message_vision(HIW "$N见四周没人注意，鬼鬼祟祟的打开钱包，取出里面的钱。然后使劲的把钱包扔进河里！ \n\n" NOR, me);
      me->add("qi", -20);
      MONEY_D->pay_player(me, random(2000) + random(100) + 100);

      break;
    case 9:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你猛的一提杆，扯的太急了，线断了，鱼跑了，可惜，可惜。 \n");
      tell_object(me, HIC "你不由的在心里大骂:ダドパ。 \n\n" NOR);
      me->add("qi", -30);

      break;
    default:
      //                   me->set_temp("diaoyu/now", 1);
      //                   call_out("remove_effect", (10-random(kar)/5), me);
      tell_object(me, "你一提杆，钓到了一条" + HIM "娃娃鱼" NOR + "，恭喜，恭喜。 \n\n");
      me->add("potential", 100 + random(50));
      me->add("combat_exp", 50 + random(30));
      me->add("qi", -16);

      break;
  }

  if (me->query("potential") > me->query("max_pot") * 5)
    me->set("potential", me->query("max_pot") * 5);
  me->start_busy(random(2));
  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  tell_object(me, "你将鱼饵挂在钩上，准备继续钓鱼……\n");
  me->delete_temp("diaoyu/now");

}
