// /d/mr/didao4.c
// by akuma 3:56 PM 3/14/2002

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIR "密室" NOR);
  set("long", @LONG
这里是慕容氏慕容博的墓底。没想到这里别有洞天。看来慕容博并不像
传文中所说的病逝了。
LONG);
  set("indoors", "慕容");
  set("exits", ([
    "south": __DIR__ "didao3",
  ]));
  setup();
}

void init() {
  add_action("do_get", "qu");
}

int do_get(string arg) {
  object me, ob;
  mapping fam;
  me = this_player();
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "姑苏慕容")
    return notify_fail("你要干什吗？\n");

  if ((arg != "飞玉冠") && (arg != "guan")) return notify_fail("你要取什么？\n");

  ob = unew(ARMOR_D("helmet/feiyu-guan"));
  if (!clonep(ob)) {
    message("vision", "这里没有这样东西。\n", me);
    return 1;
  }
  if (clonep(ob) && ob->violate_unique()) {
    destruct(ob);
    message("vision", "这里没有这样东西。\n", me);
    return 1;
  }
  write("你取下大燕国历代皇帝所戴的飞玉冠。\n");
  message("vision", me->name() + "取下大燕国历代皇帝所戴的飞玉冠。\n", environment(me), ({ me }));
  ob->move(this_player());
  return 1;
}
