#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小径");
	set("long", @LONG
一条曲曲折折用鹅卵石铺成的小径, 路两旁绿柳成阴, 一处处山石花木点
缀在其中。你走在石地上，啪嗒啪嗒的发出清脆的响声。
LONG);
	set("outdoors", "mr");
	set("exits", ([
		"southwest":__DIR__"9qianyuan",
		"west":__DIR__"9houting",
	]));
	setup();
	replace_program(ROOM);
}