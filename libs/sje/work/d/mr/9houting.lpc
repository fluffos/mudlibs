#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "后堂");
  set("long", @LONG
这里是久秀山庄的后堂。与前面想比，这里安静了许多；只有清清的风声
与你为伴。空空的大堂上一名身穿夜行衣的神秘人物，不知是何许人也。
LONG);
  set("exits", ([
    "east": __DIR__ "9xiaojing",
  ]));
  set("objects", ([
    CLASS_D("murong/heizhizhu"): 1,
  ]));
  setup();
}
