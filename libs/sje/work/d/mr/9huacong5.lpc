#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "花丛");
	set("long", @LONG
这里是花的天堂，一望无际的鲜花飘出阵阵香气让你留连忘返。
LONG);
	set("outdoors", "mr");
	set("exits", ([
		"north":__FILE__,
		"east" :__FILE__,
		"south":__FILE__,
		"west" :__FILE__,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	int enter_steps = random(9)+3;
	int out_steps = random(9)+3;
	if ( dir == "north" || dir == "west" )
		me->add_temp("mr/enter_steps", 1);
	if ( dir == "south" || dir == "east" )
		me->add_temp("mr/out_steps", 1);
	if (me->query_temp("mr/enter_steps") > enter_steps) {
		me->move(__DIR__"9huacong3");
		me->delete_temp("mr/enter_steps");
		return notify_fail(GRN"\n走了半天，终于走到了尽头。\n"NOR);
	}
	if (me->query_temp("mr/out_steps") > out_steps) {
		me->move(__DIR__"9hubian");
		me->delete_temp("mr/out_steps");
		return notify_fail(GRN"\n走了半天，终于走到了尽头。\n"NOR);
	}
	return ::valid_leave(me,dir);
}
