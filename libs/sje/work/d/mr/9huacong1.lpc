#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "花丛");
  set("long", @LONG
一条曲曲折折用鹅卵石铺成的小径, 路两旁鲜花成群, 不时有蝴蝶在眼
前飞舞。你走在石地上，啪嗒啪嗒的发出清脆的响声，往北面看去是便是九
秀山庄，南面则是一望无际的花的天堂。
LONG);
  set("outdoors", "mr");
  set("exits", ([
    "north": __DIR__ "9gate",
    "south": __DIR__ "9huacong2",
  ]));
  setup();
}
