#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "花丛");
  set("long", @LONG
这里是花的天堂，一望无际的鲜花飘出阵阵香气让你留连忘返。
LONG);
  set("outdoors", "mr");
  set("exits", ([
    "north": __FILE__,
    "east": __FILE__,
    "south": __FILE__,
    "west": __FILE__,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  int total_steps = random(9) + 3;
  if (dir == "north" || dir == "south" || dir == "east" || dir == "west")
    me->add_temp("mr/steps", 1);
  if (me->query_temp("mr/steps") > total_steps) {
    me->move(__DIR__ "9huacong2");
    me->delete_temp("mr/steps");
    return notify_fail(GRN "\n走了半天，发现自己又回到了原处。\n" NOR);
  }
  return ::valid_leave(me, dir);
}
