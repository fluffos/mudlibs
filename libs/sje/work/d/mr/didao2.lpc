#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", BLU "地道" NOR);
  set("long", @long
这里是慕容世家的地下通道，仔细看还能发现墙上有一道暗门(door)。
long);
  set("exits", ([
    "south": __DIR__ "didao",
    "west": __DIR__ "chufang2",
    "east": __DIR__ "xiuxishi",
  ]));
  set("item_desc", ([
    "door": "这是一扇非常厚的铁门，门上有个钥匙孔。\n",
  ]));
  setup();
}

void init() {
  object me = this_player();

  if (me->query("family/family_name") != "姑苏慕容") {
    me->set_temp("last_damage_from", "私闯慕容密道，误中机关");
    me->die();
  }
  add_action("do_open", "open");
}

void close_gate() {
  object room;

  if (!(room = find_object(__DIR__ "didao3")))
    room = load_object(__DIR__ "didao3");
  if (objectp(room)) {
    delete("exits/enter");
    message("vision", "过了一会，地道的暗门自己关上了。\n", this_object());
  }
}

int do_open(string arg) {
  object obj, room;

  if (query("exits/enter"))
    return notify_fail("地道的暗门已经是开着了。\n");

  if (!arg || (arg != "door"))
    return notify_fail("你要开什么？\n");

  if (!obj = present("jin yaoshi", this_player()))
    return notify_fail("想用手指头开门？恐怕练「九阴白骨爪」的人都没这个能耐。\n");

  if (!(room = find_object(__DIR__ "didao3")))
    room = load_object(__DIR__ "didao3");
  if (objectp(room)) {
    set("exits/enter", __DIR__ "didao3");
    message_vision("地道里的暗门被$N打开了，露出一间秘室\n", this_player());
    remove_call_out("close_gate");
    call_out("close_gate", 5);
  }
  destruct(obj);
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir == "enter" && !me->query_temp("armor_quest/yaoshi"))
    return notify_fail("你不知道里面是什么地方，一时不敢进去。\n");
  return ::valid_leave(me, dir);
}
