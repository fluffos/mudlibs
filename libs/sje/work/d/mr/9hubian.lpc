// by akuma 12:00 AM 12/15/2001

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "太湖畔");
  set("long", @LONG
太湖之畔，听说在往前走便能到达九秀山庄。远处是无边的鲜花地望不
到尽头。
LONG);
  set("outdoors", "mr");
  set("exits", ([
    "north": __DIR__ "9huacong5",
  ]));
  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "yue");
}

int do_jump(string arg) {
  object me = this_player();
  int j = me->query("max_jingli", 1);

  if (me->query("jingli") < j / 2) return notify_fail("你的精力不够，会掉进水里的。\n");
  if (me->is_busy()) return notify_fail("(你上一个动作还没有完成，不能施用内功。)\n");

  if (arg == "humian" || arg == "湖面") {
    if (me->query_skill("dodge", 1) >= 60) {
      message("vision", me->name() + "吸了口气，纵身向对面跃去。\n", environment(me), ({ me }));
      write("你吸了口气，纵身向对面跃去。\n");
      me->add("jingli", -j / 2);
      me->start_busy(2);
      me->move(__DIR__ "hubian2");
      message("vision", "只见人影一闪，" + me->name() + "纵身跃了过来。\n", environment(me), ({ me }));
      return 1;
    } else {
      message(
        "vision",
        me->name() + "纵身向对面跃去，只听“扑通”一声，" + me->name() + "摔入湖中，狼狈的爬了回来。\n",
        environment(me),
        ({ me })
      );
      write("你纵身向对面跃去，只听“扑通”一声，你摔入湖中，狼狈的爬了回来。\n");
      me->receive_damage("qi", 30);
      return 1;
    }
  }
  return 0;
}
