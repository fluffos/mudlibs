#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "秘室");
	set("long", @LONG
这里是慕容世家的密室，只见漆黑一团不知道有些什么。
LONG);
	set("indoors", "幕容");
	set("exits", ([
		"north":__FILE__,
		"south":__FILE__,
		"east" :__FILE__,
		"west" :__FILE__,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	int total_steps = random(9)+3;
	if ( dir == "north" )
		me->add_temp("steps/north", 1);
	if ( dir == "south" )
		me->add_temp("steps/south", 1);

	if (me->query_temp("steps/north") > total_steps) {
		me->move(__DIR__"didao4");
		me->delete_temp("steps/north");
		return notify_fail(YEL"\n走了半天，终于看到了一丝光亮。\n"NOR);
	}
	if (me->query_temp("steps/south") > total_steps) {
		if ( me->query("family/family_name") == "姑苏慕容" ) {
			me->move(__DIR__"didao2");
			me->delete_temp("steps/south");
			return notify_fail(YEL"\n走了半天，终于从秘室中走了出来。\n"NOR);
		}
		else {
			me->move(__FILE__);
			me->delete_temp("steps/south");
			return notify_fail(YEL"\n走了半天，发现自己被困在了里面。\n"NOR);
		}
	}
	me->add("jingli", -30);
	return ::valid_leave(me,dir);
}
