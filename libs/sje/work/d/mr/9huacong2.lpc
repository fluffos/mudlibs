#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "花丛");
	set("long", @LONG
这里是花的天堂，一望无际的鲜花飘出阵阵香气让你留连忘返。
LONG);
	set("outdoors", "mr");
	set("exits", ([
		"north":__DIR__"9huacong1",
		"east" :__DIR__"9huacong3",
		"south":__DIR__"9huacong4",
		"west" :__FILE__,
	]));
	setup();
	replace_program(ROOM);
}