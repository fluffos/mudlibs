#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", BLU "地道" NOR);
  set("long", @long
这里是慕容世家的秘密通道，里面机关密布，异常潮湿阴暗。
long);
  set("exits", ([
    "yanziwu": __DIR__ "shuixie",
    "north": __DIR__ "didao2",
    "shanzhuang": __DIR__ "shiqiao1",
    "xiaodao": __DIR__ "houtang",
    "out": __DIR__ "shiqiao",
  ]));
  setup();
}

void init() {
  object me = this_player();

  if (me->query("family/family_name") != "姑苏慕容") {
    me->set_temp("last_damage_from", "私闯慕容密道，误中机关");
    me->die();
  }
}
