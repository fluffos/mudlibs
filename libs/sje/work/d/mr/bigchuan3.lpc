#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
         set("short",HIC"水上大厅"NOR);
         set ("long",@long
大厅虽然设在船上, 但是宽敞和富丽堂皇丝毫让人察觉不出是水上所在，
墙上挂着许多人物字画, 都是历代珍贵字画。
long);
         set("exits",([
             "north" : __DIR__"bigchuan1",
             "west" : __DIR__"bigchuan2",
             "east" : __DIR__"bigchuan4",
             "out" : __DIR__"bigchuan",
]));
         set("objects",([
__DIR__"obj/xiangcha" : 2,
]));
         setup();
         replace_program(ROOM);
}
