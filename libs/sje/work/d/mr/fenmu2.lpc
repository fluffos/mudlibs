// by akuma 11:42 PM 8/28/2001

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short",HIB"坟场"NOR);
        set("long", @LONG
这里是慕容氏慕容博的墓底。没想到这里别有洞天。看来慕容博并不像
传文中所说的病逝了。
LONG);
	set("exits", ([
		"up":__DIR__"fenmu",
	]));
        setup();
}

void init()
{
        add_action("do_get", "qu");
}

int do_get(string arg)
{
	object me, ob;
	mapping fam;
	me = this_player();
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "姑苏慕容")
		return notify_fail ("你要干什吗？\n");

	if( (arg !="玉玺") && (arg!="yuxi") )	return notify_fail("你要干什么？\n");

	ob = unew(__DIR__"obj/yuxi");
	if(!clonep(ob)) {
		message("vision","这里没有这样东西。\n", me);
		return 1;
	}
	if (clonep(ob) && ob->violate_unique()){ 
		destruct(ob);   
		message("vision","这里没有这样东西。\n", me);
		return 1;
	}
	write("你从墓壁的缝隙中取出大燕国玉玺。\n");
	message("vision", me->name() + "从墓壁的缝隙中取出大燕国玉玺。\n", environment(me), ({me}) );
	ob->move(this_player());
	return 1;
}
