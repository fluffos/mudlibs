#include <ansi.h>
inherit ROOM;
void create()
{
         set("short",YEL"大船甲板"NOR);
         set ("long",@long
这是停泊在太湖上的一艘大船，是姑苏慕容来往江南的中转。船体硕大
无比，可以容纳百人，船楼上吃喝住宿一应俱全。甲板上波澜不惊，如履平
地，向湖面(humian)望去，太湖山水美景尽收眼底。
long);

         set("item_desc", ([ 
	"humian" : HIC"你举目望去，湖面上波光粼粼，微风循循，几只沙鸥在浪尖嬉戏。\n"
                   HIC"远处水天一色，万顷烟波浩淼。\n"
                   HIC"可谓入足人间仙境，忘却世间多烦悠。\n"
	]));
         set("exits",([
             "enter" : __DIR__"bigchuan3",
]));
         set("objects",([
         __DIR__"npc/laozhe2" : 1,
]));
         set("no_fight", "1");
         setup();
         replace_program(ROOM);
}