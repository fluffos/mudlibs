mapping fam;
if (!(fam = this_player()->query("family")) || fam["family_name"] != "姑苏慕容")
        return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？"; 
return "还施水阁是我慕容收藏天下秘籍之所在，在我的书.....\n";
