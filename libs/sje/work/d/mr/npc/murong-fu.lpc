string ask_fangqi()
{
        mapping fam; 
        object obj, ob, me;
        ob = this_object();  
        me = this_player();

        if (!(fam = this_player()->query("family")) || fam["family_name"] != "姑苏慕容")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";


      if ( this_player()->query_condition("mr_job") < 1)
                return RANK_D->query_respect(this_player()) + 
                "你没有领任务，寻什么开心？";
      
             if( objectp( obj = present("dizi", environment(ob))))
       {                                                 
               message_vision(CYN"\n慕容复对着$N的弟子说道：你也不用去了，下去休息吧。\n\n"NOR, me);
               destruct(obj);
       }
      
      this_player()->clear_condition("mr_job");
      
      this_player()->apply_condition("job_busy",8);

      return "好吧，你干不了我就去找别人吧。";

}

