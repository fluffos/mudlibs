#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
string *first_name = ({ "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", "慕容", });
string *name_words = ({ "华", "惊天", "雪", "星魂", "云", "羽", "剑", "虎", "瑜", "超", "鼎", });
string *color_title = ({ "[" HIR "慕容叛徒" NOR "]", "[" HIW "慕容叛徒" NOR "]", "[" HIG "慕容叛徒" NOR "]", });

void create() {
  string name, weapon;

  name = first_name[random(sizeof(first_name))];
  name += name_words[random(sizeof(name_words))];
  set_name(name, ({ "pan tu", "pantu" }));
  set("title", color_title[random(sizeof(color_title))]);
  set("class", "murong");
  set("gender", "男性");
  set("long", "这是一位慕容的叛徒！\n");
  set("age", random(50) + 50);
  set("per", 25);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.daoying" :),
    (: perform_action, "sword.lianhuan" :),
    (: perform_action, "strike.riyue" :),
  }));

  create_family("姑苏慕容", 3, "弟子");

  setup();

  weapon = random(2) ? "/clone/weapon/gangjian" : "/clone/weapon/blade";
  carry_object(weapon)->wield();
  if (weapon = "/clone/weapon/changjian")
    carry_object(BINGQI_D("blade"));
  else carry_object(BINGQI_D("gangjian"));
  carry_object("/clone/armor/mr_cloth2")->wear();
  add_money("gold", 1 + random(4));
}
void init() {
  object me, ob;
  string t_name;
  mapping fam;

  ::init();

  me = this_object();

  if (interactive(ob = this_player())
    && me->query("player_id") == ob->query("id")) {
    message_vision(HIR "$N对$n说道：" + RANK_D->query_rude(me) +
      "，竟然被你找到了，大爷我和你拼了！\n" NOR, me, ob);
    ob->set_temp("kill_right", 1);
    me->kill_ob(ob);
    ob->fight_ob(me);
    ob->start_busy(1);
  }
}
int do_clone(object me) {
  object ob = this_object();
  int number, k_qi, k_neili, k_jing, k_jiali, k_exp;

  number = (int)me->query("max_pot");
  number -= 100;
  k_qi = (int)me->query("max_qi");
  k_jing = (int)me->query("max_jing");
  k_neili = (int)me->query("max_neili");
  k_exp = (int)me->query("combat_exp");

  if (me->query("combat_exp") > 800000)  //>800k 
    number = (int)(number * (7 + random(3)) / 10);
  if (me->query("combat_exp") < 800000 && me->query("combat_exp") > 600000)  //600k-800k
    number = (int)(number * (6 + random(3)) / 10);
  if (me->query("combat_exp") < 600000 && me->query("combat_exp") > 400000)  //400k-600k
    number = (int)(number * (5 + random(3)) / 10);
  if (me->query("combat_exp") < 400000 && me->query("combat_exp") > 200000)  //200k-400k
    number = (int)(number * (5 + random(3)) / 10);
  if (me->query("combat_exp") < 200000)     //<200k
    number = (int)(number * (5 + random(4)) / 10);

  if (number > 200) number = 200;

  ob->set_skill("canhe-zhi", number);
  ob->set_skill("murong-daofa", number);
  ob->set_skill("blade", number);
  ob->set_skill("finger", number);
  ob->set_skill("dodge", number);
  ob->set_skill("force", number);
  ob->set_skill("xingyi-zhang", number);
  ob->set_skill("parry", number);
  ob->set_skill("sword", number);
  ob->set_skill("murong-jianfa", number);
  ob->set_skill("shenyuan-gong", number);
  ob->set_skill("yanling-shenfa", number);
  ob->set_skill("strike", number);

  ob->map_skill("blade", "murong-daofa");
  ob->map_skill("finger", "canhe-zhi");
  ob->map_skill("strike", "xingyi-zhang");
  ob->map_skill("dodge", "yanling-shenfa");
  ob->map_skill("parry", "murong-jianfa");
  ob->map_skill("force", "shenyuan-gong");
  ob->map_skill("sword", "murong-jianfa");
  ob->prepare_skill("strike", "xingyi-zhang");
  ob->prepare_skill("finger", "canhe-zhi");

  ob->set("max_qi", k_qi * 4 / 5);
  ob->set("eff_qi", k_qi * 4 / 5);
  ob->set("qi", k_qi * 4 / 5);
  ob->set("max_jing", k_jing * 4 / 5);
  ob->set("eff_jing", k_jing * 4 / 5);
  ob->set("jing", k_jing * 4 / 5);
  ob->set("max_neili", k_neili * 3 / 5);
  ob->set("neili", k_neili * 3 / 5);
  ob->set("combat_exp", k_exp * 5 / 4);

  k_jiali = (int)me->query_skill("force") / 2;
  k_jiali -= random(40);
  if (k_jiali < 50) k_jiali = 50;
  ob->set("jiali", k_jiali);
  return 1;
}
