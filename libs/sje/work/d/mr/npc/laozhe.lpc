// d/mr/npc/laozhe.c 老者
// by keinxin
// update 2003.2
inherit NPC;
#include <ansi.h> 
#include <combat.h>
string ask_chuan();
void create()
{
        set_name("老者", ({ "lao zhe", "zhe" }));
        set("long", 
              "他是姑苏慕容的老家丁，专门负责慕容世家来往于太湖之上。\n");
        set("gender", "男性");
        set("age", 60);       
	set("str", 17);
        set("int", 20);
        set("con", 20);
        set("dex", 20);
        set("combat_exp", 22000);
        set("shen_type", 0);
        set("attitude", "peaceful");
	set("max_qi",800);
        set("max_jing",800);
        set("neili",600);
        set("max_neili",600);
	set("jiali",0);
	set("score", 7000);

        set_skill("cuff", 60);
	set_skill("parry",60);
	set_skill("yanling-shenfa",60);
        set_skill("dodge", 60);
	set_skill("force",60);
	set_skill("shenyuan-gong",60);

	map_skill("force","shenyuan-gong");
	map_skill("dodge","yanling-shenfa");

        set_temp("apply/attack", 20);
        set_temp("apply/defense", 20);
        
        set("inquiry", 
                ([
                        
                        "太湖渡船" : (: ask_chuan :),
                        
                ]));

        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

string ask_chuan()
{
object me = this_player();
mapping fam = me->query("family");     
        if ( !fam || fam["family_name"] != "姑苏慕容")
        return RANK_D->query_respect(this_player()) + "与本派素无来往，怎能上我姑苏慕容渡船？";
command ("hoho " + me->query("id")); 
message_vision(YEL "老者将$N领上了一艘小艇，吩咐了一声：坐稳了。说着小艇向太湖远处驶去。不一会儿就靠上了一艘大船。\n"NOR, me);
me->move("/d/mr/bigchuan");
return "到了";
}


