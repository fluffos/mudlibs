// wuya.c 无崖子
// keinxin 2003.3
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
#include <combat.h>
#include "skill.h"
string ask_zhidao();
string ask_beiming();
string ask_chuangong();

void create() {
  set_name("无崖子", ({ "wuya zi", "wuya", "zi" }));
  set("title", "逍遥派祖师");
  set("long",
    "他就是逍遥派的祖师。\n"
    "他长须三尺，没一根斑白，脸如冠玉，更无半丝皱纹，年纪显然\n"
    "已经不小，却仍神采飞扬，风度闲雅。\n");
  set("gender", "男性");
  set("age", 75);
  set("class", "scholar");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);
  set("per", 40);

  set("inquiry", ([
    "苏星河": "他是我的大弟子，只是痴迷于琴棋书画，以致玩物丧志。\n",
    "秦语风": "她是我最爱的小师妹。\n",
    "丁春秋": "他是我那个不肖的徒弟，功于心计，为人阴险。\n",
    "凌波微步": (: ask_zhidao :),
    "传功": (: ask_chuangong :),
    "北冥神功": (: ask_beiming :),
  ]));

  set("max_qi", 5500);
  set("max_jing", 3000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jingli", 2000);
  set("eff_jingli", 2000);
  set("jiali", 100);
  set("combat_exp", 2000000);
  set("score", 200000);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "hand.tanmei" :),
    (: perform_action, "hand.zhemei" :),
    (: perform_action, "strike.zhong" :),
  }));

  set_skill("force", 200);
  set_skill("art", 200);
  set_skill("sword", 200);
  set_skill("strike", 200);
  set_skill("beiming-shengong", 300);
  set_skill("dodge", 200);
  set_skill("lingbo-weibu", 300);
  set_skill("xiaoyaoyou", 300);
  set_skill("liuyang-zhang", 300);
  set_skill("parry", 200);
  set_skill("zhemei-shou", 300);
  set_skill("hand", 200);
  set_skill("literate", 200);


  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingbo-weibu");
  map_skill("hand", "zhemei-shou");
  map_skill("strike", "liuyang-zhang");
  map_skill("parry", "liuyang-zhang");

  prepare_skill("hand", "zhemei-shou");
  prepare_skill("strike", "liuyang-zhang");

  create_family("逍遥派", 1, "祖师");
  set("class", "taoist");

  setup();
  carry_object("clone/food/jiudai");
  carry_object("d/xiaoyao/npc/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("beiming-shengong", 1) < 130) {
    command("say 我逍遥派内功的源泉来自于北冥神功的心法。");
    command("say " + RANK_D->query_respect(ob) +
      "的北冥神功是否还应该有所提高啊？");
    return;
  }

  if (ob->query("珍珑棋局") < 1) {
    command("say 嗯。这位" + RANK_D->query_respect(ob) + "还没有解开珍珑棋局啊。");
    return;
  }

  command("smile");
  command("chat 想不到在这世上竟然还有人可以继承我的衣钵！");
  command("recruit " + ob->query("id"));
  ob->set("title", "无崖子亲传弟子");
}

string ask_beiming() {
  object me, ob;
  mapping fam;
  ob = this_player();
  if (!(fam = ob->query("family"))
    || fam["family_name"] != "逍遥派") {
    return "你非我逍遥派的传人，怎么能传你我逍遥派的至上武学？";
  }

  if (ob->query("珍珑棋局") < 1) {
    return "你还没有解开珍珑棋局啊。";
  }

  if (ob->query("wuyazi_bmfind") > 0) {
    return "你不是已经都领会了吗？消遣我吗？";
  }

  if (ob->query("wuyazi_bmask") > 0) {
    return "不是让你上无量山了吗？";
  }

  command("nod");
  command("say 本派绝学北冥神功放在大理无量山附近的琅缳玉洞中，你去找寻一下。");
  ob->set("wuyazi_bmask", 1);
  return "如果有缘找到了密籍，那便是你的造化。";
}


string ask_zhidao() {
  object me, ob;
  mapping fam;
  ob = this_player();
  if (!(fam = ob->query("family"))
    || fam["family_name"] != "逍遥派") {
    return "你非我逍遥派的传人，怎么能传你我逍遥派的至上武学？";
  }

  if (ob->query("珍珑棋局") < 1) {
    return "你还没有解开珍珑棋局啊。";
  }

  if (ob->query("jing") < 200) {
    return "你的精不够领悟！";
  }

  if (ob->query_int() < 55) {
    return "你的悟性不够啊！";
  }

  if (ob->query("potential") < 2) {
    return "你的潜能不够。";
  }
  message_vision(HIW
    "无崖子向$N指点了步法的奥妙，$N按照步法，一步步走下来，
只觉的心情舒畅，不知不觉步法轻盈，内功也有所积累。
\n" NOR, ob);
  if (ob->query_skill("lingbo-weibu", 1) == 0) ob->set_skill("lingbo-weibu", 1);
  ob->add("jing", -random(100));
  ob->add("potential", -2);
  ob->improve_skill("force", random((int)ob->query("int") / 2));
  ob->improve_skill("lingbo-weibu", ob->query_int());
  ob->improve_skill("beiming-shengong", random((int)ob->query("int") / 2));
  return "好。好。";
}


string ask_chuangong() {
  object me, ob;
  mapping fam;
  me = this_player();
  if (!(fam = me->query("family"))
    || fam["family_name"] != "逍遥派") {
    return "你非我逍遥派的传人，怎么能传你我逍遥派的至上内功？";
  }

  if (me->query("珍珑棋局") < 1) {
    return "你还没有解开珍珑棋局啊。";
  }

  if (me->query("wuyazi_chuangong") > 0) {
    return "我七十年的功力已经尽数传给你了。";
  }

  command("nod");
  command("say 你抬起头来，让我看一下你的样貌。");
  me->start_busy(30);
  call_out("run", 3, me);
  return "嗯…………";
}

void run(object me) {
  message_vision(MAG
    "无崖子向$N端相半晌，叹了口气，道：“你能解破我的棋局，聪明才智，自
是非同小但相貌如此，却终究不行，唉，难得很。我瞧终究是白费心思，反而
枉送了你的性命。我送一份礼物给你，你便去罢！” 
      

\n" NOR, me);
  call_out("run1", 3, me);
}

void run1(object me) {
  message_vision(HIG
    "$N当即说道：“晚辈于棋艺一道，实在浅薄得紧，老前辈这个棋局，虽然是晚
辈拆解的。但若老前辈有什么难事要办，晚辈虽然本领低微，却也愿勉力而为，至
于礼物，可不敢受赐。”无崖子道：“你有这番侠义心肠，倒是不错。你棋艺不高，
武功浅薄，都不相干，你既能来到这里，那便是有缘。只不过……只不过……你相
貌太也难看。”说着不住摇头。$N微微一笑，说道：“相貌美丑，乃无始以来业报
所聚，不但自己做不得主，连父母也做不得主。晚辈貌丑，令前辈不快，这就告辞
了。”说着退了两步。 


\n" NOR, me);
  call_out("run2", 3, me);
}

void run2(object me) {
  message_vision(YEL
    "$N正待转身，无崖子道：“且慢！”衣袖扬起，搭在$N右肩之上。$N身子略略向
下一沉，只觉这衣袖有如手臂，挽住了身子。无崖子笑道：“年轻人有这等傲气，
那也很好。”$N道：“晚辈不敢狂妄骄傲，只是怕让老前辈生气，还是及早告退
的好。”无崖子点了点头。

" HIC "无崖子叹道：“天意如此，天意如此！”突然间愁眉开展，笑道：“既是天意如
此，你闭了眼睛，竟误打误撞的将我这棋局解开，足见福缘深厚，或能办我大事，
亦未可知。好，好，乖孩子，你跪下磕头罢！” 



\n" NOR, me);
  call_out("run3", 3, me);
}

void run3(object me) {
  message_vision(YEL
    "$N当下恭恭敬敬的跪了下来，咚咚咚咚的磕了四个头，待要站起，无崖子笑道：
“再磕五个，这是本门规矩。”$N应道：“是！”又磕了五个头。无崖子道：“好
孩子，好孩子！你过来！”$N站起身，走到他的身前。 
　　
" HIB "无崖子抓住$N手腕，向$N上上下下的细细打量。突然$N只觉脉门上一热，一股内力
自手臂上升，迅速无比的冲向心口，不由自主的便以自身心法相抗。无崖子的内力
一触即退，登时安然无事。



\n" NOR, me);
  call_out("run5", 3, me);
}

void run5(object me) {
  message_vision(HIY
    "无崖子双手一挥，两袖飞出，搭上虚竹肩头。$N只觉肩上沉重无比，再也无法站直
，双膝一软，便即坐倒。

无崖子哈哈一笑，突然身形拔起，在半空中一个筋斗，头上所戴方巾飞入屋角，左足在
屋梁上一撑，头下脚上的倒落下来，脑袋顶在$N的头顶，两人天灵盖和天灵盖相接。

" HIW "$N惊怖失措，纵声大呼，突觉顶门上“百会穴”中有细细一缕热气冲入脑来，嘴里再也
叫不出声，心道：“不好，我命休矣！”只觉脑海中愈来愈热，霎时间头昏脑胀，脑壳
如要炸将开来一般，这热气一路向下流去，过不片时，再也忍耐不住，昏晕了过去。 


\n" NOR, me);
  call_out("run6", 3, me);
}

void run6(object me) {
  int exp, neili, pot;

  message_vision(HIM
    "无崖子眯着双眼，有气没力的一笑，说道：“大功告成了！乖孩儿，你福泽深厚，远
过我的期望。我七十年的功力已经都传给你了。
      
无崖子说道：还有记得潜能要去存掉。Byebye。
\n" NOR, me);
  exp = random(4000) + 4000;
  pot = exp;
  neili = exp / 20;
  me->set("wuyazi_chuangong", 1);
  me->add("combat_exp", exp);
  me->add("potential", pot);
  me->add("max_neili", neili);
  tell_object(me, HIY "你被奖励了：             \n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(neili) + "点最大内力\n" +
    chinese_number(pot) + "点潜能\n" NOR);

}
