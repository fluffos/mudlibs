// zhihuan.c 七宝指环
// by keinxin@sj2 2003.3
#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
	set_name( HIG"七宝指环"NOR, ({ "qibao zhihuan", "zhihuan" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("treasure",1);
		set("unique",1);
                set("long", HIG"这是一枚玉质的指环，晶莹剔透，闪闪发光。
"HIC"这是逍遥派掌门的信物。见环如见人。
"HIW"特殊效果："HIY"天灵"NOR"(极品思维) "HIM"紫电"NOR"(提高命中)"NOR"     \n");
		set("value", 6000);
		set("material", "wrists");
		set("wear_msg", RED"$N拿出一枚"HIG"七宝指环"RED"戴在手上。\n" NOR);
		set("armor_prop/intelligence", 5+random(3));
		set("armor_prop/attack", 40+random(30));
		set("armor_prop/armor", 25);
	}
	setup();
}
