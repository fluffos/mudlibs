// suxingh.c
// keinxin@sj2 updated 2003.5
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
#include <combat.h>
#include "skill.h"


string ask_qi();
string ask_book();
string fenglu();
string ask_me();
int aa;
void create() {
  set_name("苏星河", ({ "su xinghe", "su" }));
  set("gender", "男性");
  set("nickname", "聪辩先生");
  set("shen_type", 0);
  set("class", "scholar");
  set("age", 60);
  set("str", 35);
  set("con", 30);
  set("int", 45);
  set("dex", 35);
  set("per", 30);
  set("unique", 1);

  set("no_clean_up", 1);

  set("long",
    "此人就是号称聪辩先生的苏星河，据说他能言善辩， \n"
    "是一个武林中的智者，而他的武功也是无人能知。\n");

  set("combat_exp", 1500000);
  set("attitude", "peaceful");
  set("book_count", 1);
  set("chat_chance", 1);

  set("inquiry", ([
    "棋谱": "说到棋谱，可算是呕血谱和烂柯谱最有名。能看上一看一定棋艺大进。\n",
    "珍珑棋局": (: ask_qi :),
    "秘籍": (: ask_book :),
    "俸禄": (: fenglu :),
    "练习": (: ask_me :),
  ]));

  set("max_qi", 5400);
  set("max_jing", 1400);
  set("neili", 9500);
  set("max_neili", 9500);
  set("eff_jingli", 9500);
  set("jiali", 60);
  set("env/wimpy", 10);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "hand.tanmei" :),
    (: perform_action, "hand.zhemei" :),
  }));

  set_skill("hand", 150);
  set_skill("force", 150);
  set_skill("dodge", 150);
  set_skill("strike", 150);
  set_skill("art", 150);
  set_skill("parry", 150);
  set_skill("xiaoyaoyou", 150);
  set_skill("beiming-shengong", 150);
  set_skill("liuyang-zhang", 150);
  set_skill("zhemei-shou", 150);
  set_skill("literate", 100);

  map_skill("parry", "liuyang-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("force", "beiming-shengong");
  map_skill("hand", "zhemei-shou");
  map_skill("strike", "liuyang-zhang");

  prepare_skill("hand", "zhemei-shou");
  prepare_skill("strike", "liuyang-zhang");



  create_family("逍遥派", 2, "弟子");
  set("title", "逍遥派第二代大弟子");
  setup();
  carry_object("d/xiaoyao/npc/obj/cloth")->wear();
}


void attempt_apprentice(object ob) {

  if (ob->query_int() < 30) {
    command("shake" + ob->query("id"));
    command("say " + RANK_D->query_respect(ob) +
      "逍遥派历来要求弟子天资甚高，你如此愚笨，恐怕不适合做逍遥派的弟子？");
    return;

  }

  command("say 好吧，我就收下你了，今后要多加努力，替你师公报仇！");
  command("chat* 朗声说道：想不到能收到这一千年良才，我苏星河终于可以破除誓言啦！");
  command("recruit " + ob->query("id"));
  ob->set("title", "逍遥派第三代弟子");
}

string fenglu() {
  object ob = this_player();
  mapping fam = ob->query("family");
  int gold;
  if (!fam || fam["family_name"] != "逍遥派")
    return "这位" + RANK_D->query_respect(ob) + "不是我逍遥派的人，怎么能拿俸禄？";
  if (ob->query("combat_exp") < 300000)
    return "这位" + RANK_D->query_respect(ob) + "在逍遥派时间还太短，等过段时间才来拿吧。";
  if (ob->query("fenglu") && ob->query("fenglu") >= ob->query("age"))
    return "这位" + RANK_D->query_respect(ob) + "今年不是已经拿过俸禄了，怎么还想来拿？";
  ob->set("fenglu", ob->query("age"));
  command("pat " + ob->query("id"));
  gold = (int)(ob->query_skill("art", 1) * 20000);
  ob->add("balance", gold);
  return "这是你一年的俸禄，已经委托薛慕华存到你的钱庄账户了，这位" + RANK_D->query_respect(ob) + "好好干啊！";
}

string ask_book() {
  object me, ob;
  mapping fam;
  ob = this_player();
  if (!(fam = ob->query("family"))
    || fam["family_name"] != "逍遥派") {
    return "想要秘籍就得加入逍遥派。";
  }
  command("sigh");
  return "本派的武功秘籍藏在一个很秘密的地方，好像叫[琅缳玉洞]，我也没去过。";
}



string ask_qi() {
  object me, ob;
  mapping fam;
  ob = this_player();
  if (!(fam = ob->query("family"))
    || fam["family_name"] != "逍遥派") {
    return "你并非我逍遥派的人，怎么放心让你解开秘密？";
  }
  if (ob->query_skill("art", 1) < 101) {
    return "你连棋都不会下，还想破解珍珑棋局？";
  }
  if (ob->query("珍珑棋局") > 0) {
    return "你已经解开了，不要来开玩笑了吧！";
  }
  command("nod");
  ob->start_busy(34);
  call_out("run", 2, ob);
  return "这个珍珑棋局，乃先师所制。先师当年穷三年心血，这才布成，
深盼当世棋道中的知心之士，予以破解。在下三十年来苦加钻研，未能参解得透。
这个‘珍珑’，牵涉异常重大，你过来好好的瞧上一瞧，若能破解得开，那是一
件大大的妙事。";
}


void init() {

  add_action("do_task", "task");
}


string ask_me() {
  object ob;
  ob = this_player();
  if (ob->query_skill("art", 1) < 10)
    return "你一个粗人，还是先跟我学点琴棋书画吧。";
  if (ob->query("combat_exp") < 2000)
    return "你先练好武功吧！";
  if (ob->query("combat_exp") > 120000)
    return "你已经不用练习了，出去闯荡江湖吧！";
  if (ob->query("job_lianasked") > 0)
    return "不是让你去练了吗？还不去？";
  if (ob->query("job_lian") > 0)
    return "我交给你的事情你还没做呢！";
  ob->set("job_lianasked", 1);
  ob->set("job_lian", 8);
  return "好吧，你就去练习琴和棋吧！";
}

int do_task(string arg) {
  object ob, me;
  int exp, pot, money;
  ob = this_player();
  me = this_object();
  if (!(arg || arg == "ok")) return 0;
  if (!ob->query("job_lianasked")) {
    command("say 没有让你练习，你怎么跑来覆命了？");
    return 1;
  }

  if (ob->query("job_lian") > 1) {
    command("say 你还没练好啊！");
    return 1;
  }
  if (arg == "ok") {
    command("smile " + ob->query("id"));
    command("say 好，" + RANK_D->query_respect(ob) + "，做得好，这是给你的奖赏！");
    MONEY_D->pay_player(this_player(), (ob->query_skill("literate", 1) * 30) + 300);
    pot = (int)(ob->query_skill("literate", 1) / 5) + 20 + random(30);
    exp = (int)(ob->query_skill("literate", 1) / 5) + 20 + random(50);
    ob->add("potential", pot);
    if (ob->query("potential") > ob->query("max_pot"))
      ob->set("potential", ob->query("max_pot"));
    ob->add("combat_exp", exp);
    ob->delete("job_lianasked");
    ob->delete("job_lian");
    tell_object(
      ob,
      HIW "你被奖励了：" + chinese_number(exp) + "点经验和" + chinese_number(pot) + "点潜能。\n" NOR
    );
    return 1;
  }
  return 1;
}

void run(object ob) {
  message_vision(HIC
    "$N细观棋路，：“‘珍珑’即是围棋的难题。那是一个人故意摆出来难人的，
并不是两人对弈出来的阵势，因此或生、或劫，往往极难推算。”寻常“珍珑”
少则十余子，多者也不过四五十子，但这一个却有二百余子，一盘棋已下得接
近完局。

\n" NOR, ob);
  call_out("run1", 3, ob);
}

void run1(object ob) {

  message_vision(HIW
    "但见那棋盘雕在一块大青石上，黑子、白子全是晶莹发光，双方各已下了百余子。
      
      \n" NOR, ob);
  call_out("run2", 3, ob);
}

void run2(object ob) {
  message_vision(RED
    "$N见这一局棋劫中有劫，既有共活，又有长生，或反扑，或收气，花五聚六，
复杂无比。$N登时精神一振，再看片时，忽觉头晕脑胀，只计算了右下角一块小
小白棋的死活，已觉胸口气血翻涌。$N定了定神，第二次再算，发觉原先以为这
块白棋是死的，其实却有可活之道，但要杀却旁边一块黑棋，牵涉却又极多，再
算得几下，突然间眼前一团漆黑，喉头一甜，喷出一大口鲜血。

\n" NOR, ob);

  aa = random(100);
  if (ob->query("kar") < aa) {
    command("shake");
    command("say 你这一次是破不了啦，下次再来吧！");
    ob->receive_damage("qi", 300);
    ob->unconcious();
  }

  if (ob->query("kar") >= aa) {
    call_out("run3", 3, ob);
  }
}

void run3(object ob) {

  message_vision(YEL
    "$N定了定神左手拈一子，正好落在“去”位的七九路上，那是破解这“珍珑”
的关键所在。

苏星河笑了笑：" HIR "“你连我在边角上的纠缠也摆脱不了，还想逐鹿中原么？”

\n" NOR, ob);
  call_out("run4", 3, ob);
}

void run4(object ob) {

  message_vision(HIC
    "$N心头一震，一时之间百感交集，反来覆去只是想着他那两句话：“你连我在
边角上的纠缠也摆脱不了，还想逐鹿中原么？”眼前渐渐模糊，棋局上的白子黑
子似乎都化作了将官士卒，东一团人马，西一块阵营，你围住我，我围住你，互
相纠缠不清的厮杀。$N眼睁睁见到，己方白旗白甲的兵马被黑旗黑甲的敌人围住
了，左冲右突，始终杀不出重围。

" HIR "心中越来越是焦急：“我天命已尽，一切枉费
心机。我一生尽心竭力，终究化作一场春梦！时也命也，夫复何言？”

\n" NOR, ob);
  aa = random(120);
  if (ob->query("int") < aa) {
    command("shake");
    command("say 你这一次是破不了啦，下次再来吧！");
    ob->receive_damage("qi", 300);
    ob->unconcious();
  }
  if (ob->query("pur") >= aa) {
    call_out("run5", 3, ob);
  }
}

void run5(object ob) {

  message_vision(WHT
    "$N左手停在半空，微微发颤，始终点不下去，过了良久，说道：“前无去路，后
有追兵，正也不是，邪也不是，那可难也！”这个珍珑变幻百端，因人而施，爱
财者因贪失误，易怒者由愤坏事。段誉之败，在于爱心太重，不肯弃子；慕容复
之失，由于执着权势，勇于弃子，却说什么也不肯失势。

" HIR "$N竟尔心神荡漾，难以
自制。$N暗想：“注定是毁了，毁了，毁了！唉，可惜，一失足成千古恨，再想
回首，那也是不能了！”想到这里口中鲜血狂喷而出。

\n" NOR, ob);
  aa = random(30);
  if (ob->query("pur") < aa) {
    command("shake");
    command("say 你这一次是破不了啦，下次再来吧！");
    ob->receive_damage("qi", 300);
    ob->unconcious();
  }
  if (ob->query("kar") >= aa) {
    call_out("run6", 3, ob);
  }
}

void run6(object ob) {

  message_vision(MAG
    "$N感到取胜无望，闭着眼睛随便走了一手。
      
$N双眼还没睁开，只听得苏星河怒声斥道：“胡闹，胡闹，你自填一气，自己杀死
一块白棋，哪有这等下棋的法子？”
" HIB "
$N睁眼一看，不禁满脸通红。 原来自己闭着眼睛瞎放一子，竟放在一块已被黑棋围
得密不通风的白棋之中。这大块白棋本来尚有一气，虽然黑棋随时可将之吃净，但
只要对方一时无暇去吃，总还有一线生机，苦苦挣扎，全凭于此。现下他自己将自己
的白棋吃了，棋道之中，从无这等自杀的行径。这白棋一死，白方眼看是全军覆没了。 

\n" NOR, ob);
  ob->receive_damage("qi", 200);
  call_out("run7", 3, ob);
}

void run7(object ob) {

  message_vision(RED
    "$N苏星河向$N道：“你杀了自己一块棋子，黑棋再逼紧一步，你如何应法？” 

" CYN "$N赔笑道：“鄙人棋艺低劣，胡乱下子。这盘棋是不会下的，请老前辈原谅。” 

" NOR "苏星河脸色一沉，厉声道：“先师布下此局，恭请天下高手破解。倘若破解不得，
那是无妨，若有后殃，也是咎由自取。但如有人前来捣乱棋局，渎亵了先师毕生
的心血，纵然人多势众，" HIG "嘿嘿，老夫虽然又聋又哑，却也要誓死周旋到底。”


\n" NOR, ob);
  call_out("run8", 3, ob);
}

void run8(object ob) {

  message_vision(HIM
    "$N眼见黑棋不论如何应法，都要被白棋吃去一块，但如黑棋放开一条生路，那么白
棋就此冲出重围，那时别有天地，再也奈何它不得了。苏星河凝思半晌，笑吟吟
的应了一着黑棋。$N知此着一下，便解破了这个珍珑棋局，拍手笑道：“好像是
成了罢？”

\n" NOR, ob);
  call_out("run9", 5, ob);
}

void run9(object ob) {

  message_vision(HIW
    "苏星河满脸笑容，拱手道：“天赋英才，可喜可贺。”\n" NOR, ob);
  ob->set("珍珑棋局", 1);
  command("chat 终于有人破解了珍珑棋局，逍遥派的衣钵终于能得传啦！");
}
