// wuji1.c

inherit ITEM;

void create()
{
        set_name("羊皮", ({ "yang pi", "pi" }));
        set_weight(200);
set("unit", "张");
        set("long", "这是张羊皮，上面写满了密密麻麻的文字。\n");
        set("value", 500);
        set("material", "paper");
        set("skill", ([
                        "name": "claw", // name of the skill
                        "exp_required": 1000,   // minimum combat experience required
                        "jing_cost": 15+random(15),// jing cost every time study this
                        "difficulty":   25,     // the base int to learn this skill
                        "max_skill":    41      // the maximum level you can learn
                      ]) );
}

