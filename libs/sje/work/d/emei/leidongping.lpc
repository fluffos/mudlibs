// Room: /d/emei/leidongping.c 峨嵋派 雷洞坪
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIR "雷洞坪" NOR);
  set("long", @LONG
雷洞坪一带，道路艰险骇人，路左是蔽日遮天的冷杉林，路右是深不见底
的绝壁峡谷。这里长年云遮雾罩，空蒙黑暗。岩上建有雷神殿，旁边竖一铁碑。
由此往上是「八十四盘」至接引殿，北下到洗象池。
LONG
  );
  set("outdoors", "峨嵋山");
  set("exits", ([
    "northdown": __DIR__ "lingyunti",
    "southup": __DIR__ "basipan1",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "southup" && (int)me->query_skill("dodge", 1) < 101) {
    me->improve_skill("dodge", (int)me->query("dex"));
    me->receive_damage("jingli", (int)me->query("dex"));
    return 1;
  }
  return ::valid_leave(me, dir);

}

void init() {
  add_action("do_say", "say");
}

int do_say(string arg) {
  object me;
  me = this_player();
  if (!living(me)) return 0;

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着哪！\n");

  if ((int)me->query_skill("force", 1) < 101
    && me->query_skill("force", 1) > 60) {
    if (random(500) > 25 && (int)me->query("jingli", 1) >= 40) {
      if (!arg) {
        me->improve_skill("force", (int)me->query("con"));
        me->receive_damage("jing", 20 + random(15));
        return 0;
      }
      if ((int)me->query("qi") < (int)me->query("max_qi") / 4) {
        me->improve_skill("force", (int)me->query("con"));
        me->receive_damage("jing", 20 + random(20));
        return 0;
      } else {
        me->receive_damage("jing", 20 + random(15));
        me->improve_skill("force", (int)me->query("con"));
        return 0;
      }
    } else {
      write(HIR "你刚说出一个字，刹那间惊雷迅电，霹雳而作，风雨暴来。\n" NOR, me);
      message_vision(HIR "只见天空中一道闪电利剑般地象$N劈来，$N一个躲闪不及........\n" NOR, me);
      me->unconcious();
      return 1;
    }
  }
}
