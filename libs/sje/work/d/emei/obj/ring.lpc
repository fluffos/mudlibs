// zhihuan.c
// 指环
#include <ansi.h>
#include <armor.h>
inherit FINGER;
inherit F_UNIQUE;
void create()
{
       set_name(HIW"铁指环"NOR, ({ "zhi huan" }) );
       set_weight(100);
       if( clonep() )
               set_default_object(__FILE__);
      else {
               set("unit", "支");
               set("long", "这是一支铁指环，是峨嵋派掌门的信物。\n");
               set("value", 100000);
               set("unique", 1);
               set("treasure",1);
               set("material", "steel");
               set("armor_prop/armor", 5);
}
       setup();
}


                

