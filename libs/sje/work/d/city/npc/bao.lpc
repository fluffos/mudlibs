#include <ansi.h>
#include <net/dns.h>
#include <combat.h>

inherit NPC;
/*int ask_str();
int ask_int();
int ask_con();
int ask_dex();
int ask_kar();
int ask_per();
int ask_exp();
int ask_pur();*/
object ask_com(int);
int get_addr1(object, int);

void create() {
  set_name("包打听", ({ "bao dating", "bao" }));
  set("long",
    "这是一个专门打探江湖中各种消息的人。他知道现在江湖中臂力、
 悟性、根骨、身法、经验、攻击力、杀伤力、防御力、防护力、躲闪
 力、杀人、PK、死亡、有效死亡、正气、戾气、名气、年龄最高、最
 多、最响的依次是谁，你可以用(max xxx)向他打听。你也可以用(pm 
 xxx)向他打听你当前的排名。(xxx是你要打听的属性名，如悟性、根
 骨等等)\n");
  set("gender", "男性");
  set("age", 55);

  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set_temp("apply/damage", 5);

  set("combat_exp", 500);
  set("shen_type", 1);
  setup();

  /*set("inquiry", ([
		"臂力" : (: ask_str :),
		"悟性" : (: ask_int :),
		"根骨" : (: ask_con :),
		"身法" : (: ask_dex :),
		"容貌" : (: ask_per :),
		"福缘" : (: ask_kar :),
		"经验" : (: ask_exp :),
		"纯朴" : (: ask_pur :),
		"攻击力" : (: ask
	]) );*/

  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  //add_action("do_yes","yes");
  //add_action("do_no","no");
  add_action("do_paiming", "pm");
  add_action("do_max", "max");
}

int do_paiming(string arg) {
  object my, new1;
  object *userlist;
  int i, newattr, j, k;
  string *attrname, attr1;
  int *mc;
  string MC, str;
  int *attr;

  //if(!arg)
  if (!arg) {
    my = this_player();
    attr1 = "";
  } else if (wizardp(this_player())) {
    my = find_player(arg);
    if (!my) return notify_fail("你要察看谁的排名？\n");
    attr1 = "";
  } else {
    //return notify_fail("只有巫师能察看别人的排名。\n");
    my = this_player();
    attr1 = arg;
  }
  if (wizardp(my))
    return notify_fail("巫师不参与排名。\n");
  else {
    attrname = (string *)allocate(21);
    mc = (int *)allocate(21);
    attr = (int *)allocate(21);
    for (k = 0; k < 21; k++) {
      attr[k] = get_addr1(my, k + 1);
      mc[k] = 1;
    }
    attrname[0] = "臂力";
    attrname[1] = "悟性";
    attrname[2] = "根骨";
    attrname[3] = "身法";
    attrname[4] = "容貌";
    attrname[5] = "福缘";
    attrname[6] = "经验";
    attrname[7] = "纯朴";
    attrname[8] = "攻击力";
    attrname[9] = "杀伤力";
    attrname[10] = "防御力";
    attrname[11] = "防护力";
    attrname[12] = "躲闪力";
    attrname[13] = "杀人";
    attrname[14] = "PK";
    attrname[15] = "死亡次数";
    attrname[16] = "有效死亡次数";
    attrname[17] = "正气";
    attrname[18] = "戾气";
    attrname[19] = "名气";
    attrname[20] = "年龄";
    userlist = users();
    i = sizeof(userlist);
    for (j = 0; j < i; j++) {
      new1 = userlist[j];
      if (wizardp(new1) || (my == new1))
        continue;
      for (k = 0; k < 21; k++) {
        newattr = get_addr1(new1, k + 1);
        if (newattr > attr[k]) {
          mc[k]++;
        } else if ((newattr == attr[k]) && (k != 6)) {
          if (attr[6] < get_addr1(new1, 7)) {
            mc[k]++;
          }
        }
      }
    }
    if (my != this_player())
      str = "包打听说道，" + my->name(1) + "现在的排名是：";
    else
      str = "包打听说道，你现在的排名是：";
    //tell_object(this_player(),"包打听说道，你现在的排名是：");
    j = 0;
    for (k = 0; k < 17; k++) {
      if (!wizardp(this_player()) && (k == 4 || k == 5 || k == 7))
        continue;
      if (attr1 == "" || attr1 == attrname[k]) {
        MC = sprintf("%d,", mc[k]);
        str = str + attrname[k] + "第" + MC;
        if (j == 4) {
          str = str + "\n";
          tell_object(this_player(), str);
          str = "";
          j = 0;
        } else
          j++;
        if (attr1 != "") {
          attr1 = "OK";
          break;
        }
      }
      //tell_object(this_player(),attrname[k]+"第"+MC);
    }
    if (attr1 == "" || attr1 == attrname[17] || attr1 == attrname[18]) {
      if (attr[17] >= 0) {
        MC = sprintf("%d,", mc[17]);
        str = str + attrname[17] + "第" + MC;
      } else {
        MC = sprintf("%d,", mc[18]);
        str = str + attrname[18] + "第" + MC;
      }
      if (attr1 != "")
        attr1 = "OK";
    }
    if (attr1 != "OK") {
      for (k = 19; k < 21; k++) {
        if (attr1 == "" || attr1 == attrname[k]) {
          MC = sprintf("%d,", mc[k]);
          str = str + attrname[k] + "第" + MC;
          if (attr1 != "") {
            attr1 = "OK";
            break;
          }
        }
      }
    }
    str = str + "\n";
    tell_object(this_player(), str);
    return 1;
  }
  return 0;
}

int do_max(string arg) {
  object my;

  if (arg) {
    switch (arg) {
      case "臂力":
        my = ask_com(1);
        tell_object(this_player(), "包打听说道：现在臂力最大的是" + my->short(1) + "\n");
        break;
      case "悟性":
        my = ask_com(2);
        tell_object(this_player(), "包打听说道：现在最聪明的是" + my->short(1) + "\n");
        break;
      case "根骨":
        my = ask_com(3);
        tell_object(this_player(), "包打听说道：现在根骨最佳的是" + my->short(1) + "\n");
        break;
      case "身法":
        my = ask_com(4);
        tell_object(this_player(), "包打听说道：现在身法最快的是" + my->short(1) + "\n");
        break;
      case "福缘":
        if (wizardp(this_player())) {
          my = ask_com(5);
          tell_object(this_player(), "现在福缘最好的是" + my->short(1) + "\n");
        } else
          tell_object(this_player(), "包打听苦思良久，说道：不知道。\n");
        break;
      case "容貌":
        if (wizardp(this_player())) {
          my = ask_com(6);
          tell_object(this_player(), "包打听说道：现在最漂亮的是" + my->short(1) + "\n");
        } else
          tell_object(this_player(), "包打听苦思良久，说道：不知道。\n");
        break;
      case "经验":
        my = ask_com(7);
        tell_object(this_player(), "包打听说道：现在经验最高的是" + my->short(1) + "\n");
        break;
      case "纯朴":
        if (wizardp(this_player())) {
          my = ask_com(8);
          tell_object(this_player(), "包打听说道：现在最老实的是" + my->short(1) + "\n");
        } else
          tell_object(this_player(), "包打听苦思良久，说道：不知道。\n");
        break;
      case "攻击力":
        my = ask_com(9);
        tell_object(this_player(), "包打听说道：现在攻击力最高的是" + my->short(1) + "\n");
        break;
      case "杀伤力":
        my = ask_com(10);
        tell_object(this_player(), "包打听说道：现在杀伤力最高的是" + my->short(1) + "\n");
        break;
      case "防御力":
        my = ask_com(11);
        tell_object(this_player(), "包打听说道：现在防御力最强的是" + my->short(1) + "\n");
        break;
      case "防护力":
        my = ask_com(12);
        tell_object(this_player(), "包打听说道：现在防护力最强的是" + my->short(1) + "\n");
        break;
      case "躲闪力":
        my = ask_com(13);
        tell_object(this_player(), "包打听说道：现在躲闪力最高的是" + my->short(1) + "\n");
        break;
      case "杀人":
        my = ask_com(14);
        tell_object(this_player(), "包打听说道：现在杀人最多的是" + my->short(1) + "\n");
        break;
      case "PK":
        my = ask_com(15);
        tell_object(this_player(), "包打听说道：现在PK最多的是" + my->short(1) + "\n");
        break;
      case "死亡":
        my = ask_com(16);
        tell_object(this_player(), "包打听说道：现在死亡次数最多的是" + my->short(1) + "\n");
        break;
      case "有效死亡":
        my = ask_com(17);
        tell_object(this_player(), "包打听说道：现在有效死亡次数最多的是" + my->short(1) + "\n");
        break;
      case "正气":
        my = ask_com(18);
        tell_object(this_player(), "包打听说道：现在最正气凛然的是" + my->short(1) + "\n");
        break;
      case "戾气":
        my = ask_com(19);
        tell_object(this_player(), "包打听说道：现在最阴险毒辣的是" + my->short(1) + "\n");
        break;
      case "名气":
        my = ask_com(20);
        tell_object(this_player(), "包打听说道：现在最有名的是" + my->short(1) + "\n");
        break;
      case "年龄":
        my = ask_com(21);
        tell_object(this_player(), "包打听说道：现在年龄最大的是" + my->short(1) + "\n");
        break;
      default:
        tell_object(this_player(), "包打听苦思良久，说道：不知道。\n");
    }
  } else
    tell_object(this_player(), "包打听说道：你想打听什么?\n");
  return 1;
}

object ask_com(int type) {
  object my, new1;
  object *userlist;
  int i, attr, newattr, j, t1, t2;
  object ob;

  userlist = users();
  i = sizeof(userlist);
  my = userlist[0];
  attr = get_addr1(my, type);
  if (wizardp(my))
    attr = -1;
  for (j = 1; j < i; j++) {
    new1 = userlist[j];
    if (wizardp(new1))
      continue;
    newattr = get_addr1(new1, type);
    if (newattr > attr) {
      attr = newattr;
      my = new1;
    } else if ((newattr == attr) && (type != 7)) {
      t1 = get_addr1(my, 7);
      t2 = get_addr1(new1, 7);
      //printf("%d %d",t1,t2);
      if (t1 < t2) {
        //attr=newattr;
        my = new1;
      }
    }
  }
  return my;
}

int get_addr1(object my, int type) {
  mapping me;
  string skill_type;
  object weapon;
  int attack_points, dodge_points, parry_points;

  switch (type) {
    case 1: return my->query_str();
    case 2: return my->query_int();
    case 3: return my->query_con();
    case 4: return my->query_dex();
    case 5: return my->query_kar();
    case 6: return my->query_per();
    case 7: return my->query("combat_exp");
    case 8: return my->query_pur();
    case 9: /* 攻击力 */
      if (objectp(weapon = my->query_temp("weapon")))
        skill_type = weapon->query("skill_type");
      else
        skill_type = "unarmed";

      attack_points = COMBAT_D->skill_power(my, skill_type, SKILL_USAGE_ATTACK) / 100;
      return attack_points;
    case 10: /* 杀伤力 */
      return my->query_temp("apply/damage");
    case 11: /* 防御力 */
      parry_points = COMBAT_D->skill_power(my, "parry", SKILL_USAGE_DEFENSE) / 100;
      return parry_points;
    case 12: /* 防护力 */
      return my->query_temp("apply/armor");
    case 13: /* 躲闪力 */
      dodge_points = COMBAT_D->skill_power(my, "dodge", SKILL_USAGE_DEFENSE) / 100;
      return dodge_points;
    case 14: /* 杀人 */
      //me=(["MKS": 0,"PKS": 0]);
      me = my->query_entire_dbase();
      if (!catch(me["MKS"]))
        return 0;
      if (!catch(me["PKS"]))
        return me["MKS"];
      //if(me["MKS"] + me["PKS"])
      return (me["MKS"] + me["PKS"]);
      //else
      //return 0;
    case 15: /* pk */
      //me=(["PKS": 0]);
      me = my->query_entire_dbase();
      if (!catch(me["PKS"]))
        return 0;
      //if(me["PKS"])
      return me["PKS"];
      //else
      //return 0;
    case 16: /* 死亡 */
      //me=(["death_count": 0]);
      me = my->query_entire_dbase();
      if (!catch(me["death_count"]))
        return 0;
      //if(me["death_count"])
      return me["death_count"];
      //else
      //return 0;
    case 17: /* 有效死亡 */
      //me=(["death_times": 0]);
      me = my->query_entire_dbase();
      if (!catch(me["death_times"]))
        return 0;
      //if(me["death_times"])
      return me["death_times"];
      //else
      //return 0;
    case 18: /*正神 */
      return my->query("shen");
    case 19: /*负神 */
      return (-1 * my->query("shen"));
    case 20: /*名气 */
      return my->query("reputation");
    case 21: /*年龄*/
      my->update_age();
      return (my->query("age") * 20 + my->query("month"));
    default: return -1;
  }
  return -1;
}
