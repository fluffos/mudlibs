      break;
      case 1: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 2: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 3: material = "stone";
      materialc = HIW "大理石" NOR;
      break;
      default: material = "steel";
      materialc = HIW "大理石" NOR;
    }
