    damage = random(80) + 140;
    weight = random(4500) + 4000;
    rigidity = random(5) + 4;
    switch (random(11)) {
      case 0: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 1: material = "steel";
      materialc = HIB "寒铁" NOR;
      sharpness = sharpness + 2;
      break;
      case 2: material = "stone";
      materialc = HIW "大理石" NOR;
      break;
      case 3: material = "stone";
      materialc = MAG "花岗岩" NOR;
      sharpness = sharpness + 1;
      break;
      case 4: material = "stone";
      materialc = HIC "玄武岩" NOR;
      rigidity = rigidity + 1;
      break;
      case 5: material = "steel";
      materialc = BLU "万年玄铁" NOR;
      rigidity = rigidity + 4;
      break;
      case 6: material = "steel";
      materialc = HIB "海底寒铁" NOR;
      sharpness = sharpness + 4;
      break;
      case 7: material = "steel";
      materialc = BLU "玄铁" NOR;
      rigidity = rigidity + 2;
      break;
      case 8: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 9: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 10: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      default: material = "steel";
      materialc = CYN "精钢" NOR;
    }
    bili = 34;
    max_neili = random(2000) + 3600;
    min_neili = random(200) + 360;
  } else if (cast_type == "great6") {
    cast_name = great6[random(sizeof(great6))];
    switch (cast_name) {
      case "帝王": cast_id = "diwang"; break;
      case "神王": cast_id = "shenwang"; break;
      case "王者": cast_id = "wangzhe"; break;
      case "霸王": cast_id = "bawang"; break;
      case "妖后": cast_id = "yaohou"; break;
      case "天后": cast_id = "tianhou"; break;
      case "天圣": cast_id = "tiansheng"; break;
    }
    sharpness = random(5) + 5;
    damage = random(100) + 160;
    weight = random(4500) + 4000;
    rigidity = random(5) + 5;
    switch (random(11)) {
      case 0: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 1: material = "steel";
      materialc = HIB "寒铁" NOR;
      sharpness = sharpness + 2;
      break;
      case 2: material = "stone";
      materialc = HIW "大理石" NOR;
      break;
      case 3: material = "stone";
      materialc = MAG "花岗岩" NOR;
      sharpness = sharpness + 1;
      break;
      case 4: material = "stone";
      materialc = HIC "玄武岩" NOR;
      rigidity = rigidity + 1;
      break;
      case 5: material = "steel";
      materialc = BLU "万年玄铁" NOR;
      rigidity = rigidity + 4;
      break;
      case 6: material = "steel";
      materialc = HIB "海底寒铁" NOR;
      sharpness = sharpness + 4;
      break;
      case 7: material = "steel";
      materialc = BLU "玄铁" NOR;
      rigidity = rigidity + 2;
      break;
      case 8: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 9: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 10: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      default: material = "steel";
      materialc = CYN "精钢" NOR;
    }
    bili = 36;
    max_neili = random(2400) + 4000;
    min_neili = random(240) + 400;
  } else if (cast_type == "super") {
    cast_name = super[random(sizeof(super))];
    switch (cast_name) {
      case "三清": cast_id = "sanqing"; break;
      case "轩辕": cast_id = "xuanyuan"; break;
      case "昆仑": cast_id = "kunlun"; break;
      case "乾坤": cast_id = "qiankun"; break;
      case "太极": cast_id = "taiji"; break;
      case "神通": cast_id = "shentong"; break;
      case "浩气": cast_id = "haoqi"; break;
      case "风云": cast_id = "fengyun"; break;
      case "天地": cast_id = "tiandi"; break;
      case "乔依乌斯": cast_id = "qiaoyiwusi"; break;
      case "炼狱": cast_id = "lianyu"; break;
      case "太白": cast_id = "taibai"; break;
      case "无机": cast_id = "wuji"; break;
      case "八卦": cast_id = "bagua"; break;
    }
    sharpness = random(7) + 9;
    damage = random(150) + 200;
    weight = random(3500) + 3500;
    rigidity = random(7) + 9;
    switch (random(10)) {
      case 0: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 1: material = "steel";
      materialc = HIB "寒铁" NOR;
      sharpness = sharpness + 2;
      break;
      case 2: material = "stone";
      materialc = HIW "大理石" NOR;
      break;
      case 3: material = "stone";
      materialc = MAG "花岗岩" NOR;
      sharpness = sharpness + 1;
      break;
      case 4: material = "stone";
      materialc = HIC "玄武岩" NOR;
      rigidity = rigidity + 1;
      break;
      case 5: material = "steel";
      materialc = BLU "万年玄铁" NOR;
      rigidity = rigidity + 4;
      break;
      case 6: material = "steel";
      materialc = HIB "海底寒铁" NOR;
      sharpness = sharpness + 4;
      break;
      case 7: material = "steel";
      materialc = BLU "玄铁" NOR;
      rigidity = rigidity + 2;
      break;
      case 8: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 9: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      default: material = "steel";
      materialc = CYN "精钢" NOR;
    }
    bili = 40;
    max_neili = random(2800) + 4400;
    min_neili = random(280) + 440;
  } else if (cast_type == "special") {
    cast_name = special[random(sizeof(special))];
    switch (cast_name) {
      case "干将": cast_id = "ganjiang"; break;
      case "莫邪": cast_id = "moye"; break;
      case "鱼肠": cast_id = "yuchang"; break;
      case "巨阙": cast_id = "juque"; break;
      case "太阿": cast_id = "taie"; break;
      case "纯钩": cast_id = "chungou"; break;
      case "湛卢": cast_id = "zhanlu"; break;
      case "工布": cast_id = "gongbu"; break;
      case "胜邪": cast_id = "shengye"; break;
      case "龙泉": cast_id = "longquan"; break;
    }
    sharpness = random(5) + 11;
    damage = random(250) + 350;
    weight = random(2500) + 2500;
    rigidity = random(5) + 11;
    switch (random(10)) {
      case 0: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 1: material = "steel";
      materialc = HIB "寒铁" NOR;
      sharpness = sharpness + 2;
      break;
      case 2: material = "stone";
      materialc = HIW "大理石" NOR;
      break;
      case 3: material = "stone";
      materialc = MAG "花岗岩" NOR;
      sharpness = sharpness + 1;
      break;
      case 4: material = "stone";
      materialc = HIC "玄武岩" NOR;
      rigidity = rigidity + 1;
      break;
      case 5: material = "steel";
      materialc = BLU "万年玄铁" NOR;
      rigidity = rigidity + 4;
      break;
      case 6: material = "steel";
      materialc = HIB "海底寒铁" NOR;
      sharpness = sharpness + 4;
      break;
      case 7: material = "steel";
      materialc = BLU "玄铁" NOR;
      rigidity = rigidity + 2;
      break;
      case 8: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      case 9: material = "steel";
      materialc = CYN "精钢" NOR;
      break;
      default: material = "steel";
      materialc = CYN "精钢" NOR;
    }
    bili = 45;
    max_neili = random(3200) + 4800;
    min_neili = random(320) + 480;
  }
  if (material == 0) {
    material = "steel";
    materialc = "精钢";
  }
  if (materialc == 0) {
    material = "steel";
    materialc = "精钢";
  }
  if (random((int)me->query("kar", 1)) > 20 && cast_type != "special") {
    switch (random(30)) {
      case 0: shuxing = CYN "优良";
      sx_show = "加强威力";
      damage = damage + 20;
      break;
      case 1: shuxing = CYN "上品";
      sx_show = "提高威力";
      damage = damage + 40;
      break;
      case 2: shuxing = WHT "极品";
      sx_show = "增加威力";
      damage = damage + 60;
      break;
      case 3: shuxing = MAG "旷世";
      sx_show = "双倍威力";
      damage = damage * 2;
      break;
      case 4: shuxing = MAG "绝世";
      sx_show = "三倍威力";
      damage = damage * 3;
      break;
      case 5: shuxing = HIW "灭世";
      sx_show = "四倍威力";
      damage = damage * 4;
      break;
      case 6: shuxing = HIR "巧制";
      sx_show = "加强硬度";
      rigidity = rigidity + 2;
      break;
      case 7: shuxing = HIR "精制";
      sx_show = "增加硬度";
      rigidity = rigidity + 4;
      break;
      case 8: shuxing = HIR "御制";
      sx_show = "加半硬度";
      rigidity = rigidity + rigidity / 2;
      break;
      case 9: shuxing = HIR "天兵";
      sx_show = "双倍硬度";
      rigidity = rigidity * 2;
      break;
      case 10: shuxing = WHT "淬制";
      sx_show = "加强锋利";
      sharpness = sharpness + 2;
      break;
      case 11: shuxing = WHT "锻制";
      sx_show = "增加锋利";
      sharpness = sharpness + 4;
      break;
      case 12: shuxing = WHT "炼制";
      sx_show = "加半锋利";
      sharpness = sharpness / 2 * 3;
      break;
      case 13: shuxing = WHT "神兵";
      sx_show = "双倍锋利";
      sharpness = sharpness * 2;
      break;
      case 14: shuxing = WHT "凝水";
      sx_show = "内力要求减小半";
      min_neili = min_neili / 4 * 3;
      break;
      case 15: shuxing = WHT "凝晶";
      sx_show = "内力要求减半";
      min_neili = min_neili / 2;
      break;
      case 16: shuxing = WHT "玉水";
      sx_show = "内力要求减大半";
      min_neili = min_neili / 4;
      break;
      case 17: shuxing = WHT "玉晶";
      sx_show = "无内力要求";
      min_neili = 0;
      break;
      case 18: shuxing = WHT "飞絮";
      sx_show = "重量减半";
      weight = weight / 2;
      break;
      case 19: shuxing = MAG "柳絮";
      sx_show = "柔性质材";
      material = "softsteel";
      materialc = MAG "柔铁" NOR;
      weight = weight / 2;
      rigidity = 4 + random(2);
      break;
      case 20: shuxing = YEL "檀木";
      sx_show = "木性，膂力要求减大半";
      rigidity = 0;
      sharpness = 0;
      weight = 1000;
      material = "wood";
      materialc = YEL "檀木" NOR;
      bili = bili / 3;
      break;
      case 21: shuxing = GRN "斑竹";
      sx_show = "竹性，无膂力要求";
      rigidity = 0;
      sharpness = 0;
      weight = 1000;
      material = "wood";
      materialc = GRN "斑竹" NOR;
      bili = 0;
      break;
      case 22: shuxing = GRN "华彩";
      sx_show = "膂力要求减小半";
      bili = bili / 4 * 3;
      break;
      case 23: shuxing = GRN "光彩";
      sx_show = "膂力要求减半";
      bili = bili / 2;
      break;
      case 24: shuxing = GRN "彩华";
      sx_show = "膂力要求减大半";
      bili = bili / 3;
      break;
      case 25: shuxing = GRN "光华";
      sx_show = "最低膂力要求";
      bili = bili / 5;
      break;
      case 26: shuxing = WHT "柔水";
      sx_show = "最大内力要求减小半";
      max_neili = max_neili / 4 * 3;
      break;
      case 27: shuxing = WHT "柔晶";
      sx_show = "最大内力要求减半";
      max_neili = max_neili / 2;
      break;
      case 28: shuxing = WHT "丽水";
      sx_show = "最大内力要求减大半";
      max_neili = max_neili / 4;
      break;
      case 29: shuxing = WHT "丽晶";
      sx_show = "无最大内力要求";
      max_neili = 0;
      break;
      default: shuxing = "无";
      sx_show = "无";
    }
  }
  if (shuxing == 0) {
    shuxing = "无";
    sx_show = "无";
  }
  if (sx_show == 0) {
    shuxing = "无";
    sx_show = "无";
  }
  me->delete("cast_name");
  me->delete("cast_id");
  me->delete("cast_sharpness");
  me->delete("cast_damage");
  me->delete("cast_weight");
  me->delete("cast_material");
  me->delete("cast_materialc");
  me->delete("cast_bili");
  me->delete("cast_max_neili");
  me->delete("cast_min_neili");
  me->delete("cast_shuxing");
  me->delete("cast_rigidity");
  me->delete("cast_shuxing_show");
  if (sharpness > 15) {
    sharpness = 15;
  }
  if (rigidity > 15) {
    rigidity = 15;
  }
  if (damage > 500) {
    damage = 500;
  }
  me->set("cast_name", cast_name);
  me->set("cast_id", cast_id);
  me->set("cast_rigidity", rigidity);
  me->set("cast_damage", damage);
  me->set("cast_weight", weight);
  me->set("cast_material", material);
  me->set("cast_materialc", materialc);
  me->set("cast_shuxing", shuxing);
  me->set("cast_sharpness", sharpness);
  me->set("cast_min_neili", min_neili);
  me->set("cast_max_neili", max_neili);
  me->set("cast_bili", bili);
  me->set("cast_shuxing_show", sx_show);

  if (!wizardp(me)) {
    me->add("cast_cishu", 1);
  }
  if (weapon_type == "blade") {
    me->set("cast_type", "blade");
    weapon = new("data/uweapon/blade");
  }
  if (weapon_type == "sword") {
    me->set("cast_type", "sword");
    weapon = new("data/uweapon/sword");
  }
  if (weapon_type == "dagger") {
    me->set("cast_type", "dagger");
    weapon = new("data/uweapon/dagger");
  }
  weapon->do_copy(me);
  message_vision(CYN "韦兰铁匠拿出刚出炉的" + weapon->name() + CYN "交给$N。\n", me);
  weapon->move(me);
}
