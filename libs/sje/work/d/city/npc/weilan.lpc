void create() {
  set_name("韦兰铁匠", ({ "weilan tiejiang", "weilan" }));
  set("shen_type", 1);
  set("nickname", HIY "巧夺天工" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "这名铁匠便是为查理大帝打造那把传奇式的剑“乔依乌斯”的半人半神！
你可以向他打听他的事迹(name)。\n");
  set("str", 40);
  set("int", 30);
  set("con", 25);
  set("dex", 27);
  set_skill("unarmed", 600);
  set_skill("dodge", 600);
  set_skill("force", 600);
  set_skill("parry", 600);
  set("max_qi", 40000);
  set("max_jing", 8000);
  set("neili", 250000);
  set("max_neili", 250000);
  set("jiali", 250);
  set("score", 100000);

  set_temp("apply/damage", 45);
  set("inquiry", ([
    "name": (: ask_name :),
    //                  "dazao"  : (: ask_dazao :),
  ]));

  set("combat_exp", 14000000);
  set("attitude", "friendly");
  setup();
  carry_object("clone/misc/cloth")->wear();
}

void init() {
  object ob;

  add_action("do_dazao", "dazao");
  ::init();
}
string ask_name() {
  return "我现在负责帮助玩家打造(dazao)武器，能打出最好的来！机率 \n"
    "吗.....嘿嘿。\n"
    "要求： 一把" HIC "随意" CYN "的武器(令和暗器不行)。\n"
    "理论上最高威力可以达到倚天剑屠龙刀的两倍，还有很多附加属性。\n"
    " \n"
    "限制：  每人经验五十万经验时可以打造，以后每一百万经验增加一次打造机会，好好\n"
    "把握哦！\n";
}
int do_dazao(string str) {
  int i;
  object me = this_object();
  object customer = this_player();
  object obj;

  i = (int)customer->query("combat_exp", 1);
  i = i / 500000;
  i = (int)i - (int)customer->query("cast_cishu", 1);
  if (!wizardp(customer) && i < 1)
    return notify_fail("依您目前的水平，我看是用不了什么好武器的，你以后再来吧。

!\n");

  if (!(str))
    return notify_fail("你要打造什么?\n");
  if (!objectp(obj = present(str, customer)))
    return notify_fail("你身上没有这东西！\n");
  obj = present(str, customer);
  if (!wizardp(customer) && obj->query("cast_weapon") == 1)
    return notify_fail("别来捣乱好不好，这东西不是打造过了吗！\n");
  weapon_type = obj->query("skill_type");
  if (weapon_type != "blade" && weapon_type != "sword" && weapon_type != "dagger")
    return notify_fail("对不起呀,客官,你要的兵器我们没有.\n");
  destruct(obj);

  create_weapon(customer);
  return 1;
}
void create_weapon(object me) {
  object ob = this_object();
  object weapon;
  int exp;
  int damage, rigidity, sharpness, weight, bili, max_neili, min_neili, cast_r;
  string cast_type, cast_id, cast_name, material, materialc, shuxing, sx_show;
  exp = (int)me->query("combat_exp", 1);
  cast_r = random((int)me->query("kar", 1) + exp / 200000);
  if (exp > 3000000) {
    if (cast_r > 35) {
      if (weapon_type == "sword") {
        cast_type = "special";
      } else {
        cast_type = "super";
      }
    } else if (cast_r > 25) {
      cast_type = "super";
    } else if (cast_r > 18) {
      cast_type = "great6";
    } else if (cast_r < 19) {
      switch (random(7)) {
        case 0: cast_type = "great6"; break;
        case 1: cast_type = "great5"; break;
        case 2: cast_type = "great4"; break;
        case 3: cast_type = "great3"; break;
        case 4: cast_type = "great2"; break;
        case 5: cast_type = "great1"; break;
        case 6: cast_type = "good"; break;
        default: cast_type = "good";
      }
    }
  } else if (exp > 2000000) {
    if (cast_r > 25) {
      cast_type = "great6";
    } else if (cast_r > 18) {
      cast_type = "great5";
    } else {
      switch (random(6)) {
        case 0: cast_type = "great5"; break;
        case 1: cast_type = "great4"; break;
        case 2: cast_type = "great3"; break;
        case 3: cast_type = "great2"; break;
        case 4: cast_type = "great1"; break;
        case 5: cast_type = "good"; break;
        default: cast_type = "good";
      }
    }
  } else if (exp > 1000000) {
    if (cast_r > 35) {
      cast_type = "great6";
    } else if (cast_r > 28) {
      cast_type = "great5";
    } else {
      switch (random(6)) {
        case 0: cast_type = "great1"; break;
        case 1: cast_type = "great2"; break;
        case 2: cast_type = "great3"; break;
        case 3: cast_type = "great4"; break;
        case 4: cast_type = "good"; break;
        case 5: cast_type = "normal"; break;
        default: cast_type = "good";
      }
    }
  } else {
    switch (random(2)) {
      case 0: cast_type = "good"; break;
      case 1: cast_type = "normal"; break;
      default: cast_type = "normal";
    }
  }
  if (cast_type == "normal") {
    cast_name = "单";
    cast_id = "normal";
    sharpness = random(1) + 2;
    damage = random(20) + 50;
    weight = random(2000) + 2000;
    rigidity = random(2) + 2;
    switch (random(4)) {
      case 0: material = "steel";
