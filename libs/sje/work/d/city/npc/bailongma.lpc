//horse
//wzfeng

inherit NPC;

void create() {
  set_name("白龙马", ({ "bailong ma" }));
  set("long",
    "这是一匹白龙马。\n"
  );
  set_weight(50000);
  set("race", "野兽");
  set("age", 5);
  set("max_jing", 1000);
  set("max_qi", 2000);
  set("max_jingli", 3000);
  set("eff_jingli", 3000);
  set("str", 50);
  set("limbs", ({ "头部", "身体", "前蹄 ", "後蹄" }));
  set("verbs", ({ "kick", "hoof" }));
  set("value", 10000);
  set("can_ride", 1);
  set_temp("no_return", 1);
  set_temp("apply/attack", 100);
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 60);
  set("combat_exp", 100000);
  set_temp("master", "ma fu");
  setup();
}

void init() {}
