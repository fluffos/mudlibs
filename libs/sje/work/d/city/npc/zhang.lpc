// zhang.c 张天师

#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit NPC;

int ask_me();
int ask_pot();
int ask_take();
int ask_check();
int ask_shenshu();
string ask_zhuanyun();

void create()
{
	set_name("张天师", ({ "zhang tianshi", "zhang" }));
	set("age", 80);
	set("gender", "男性");
	set("long", "这是一位仙风神骨的法师。\n");
	set("attitude", "peaceful");

	set("str", 38);
        set("int", 35);
        set("con", 38);
	set("dex", 39);

        set("max_qi", 8000);
        set("max_jing", 8000);
        set("max_neili", 8000);

        set_skill("taoism", 350);

        set("chat_chance_combat", 3);
	set("chat_msg_combat", ({
                "张天师摇摇铃铛，道：天灵灵，地零零，太上老君还不显灵？\n",
                "张天师说：我这里可以存潜能，取潜能，方便玩家啊！\n",
	}));

        set("inquiry", ([
                "开光" : (: ask_me :),
                "存潜能" : (: ask_pot :),
                "取潜能" : (: ask_take :),
                "查潜能" : (: ask_check :),
                "转运" : (: ask_zhuanyun :),
                "神书" : (: ask_shenshu :),
                "法术" : "法术还分很多种呢，道术、妖术、仙术不一而足。",
                "道术" : "道术？这可是本源正宗！",
                "妖术" : "妖术啊，趋于下乘，不足为提。",
                "仙术" : "仙术只好算是中乘，还是不能和道术相比。",
        ]));

	setup();
	carry_object("/u/keinxin/dao-cloth")->wear();
}

void init()
{
        add_action("do_show", "show");
}


string ask_zhuanyun()
{      
        
        if ( this_player()->query("combat_exp" ) < 100000)
           return RANK_D->query_respect(this_player())+"你是不是应该再闯荡一段时间积累点经验？";
         
        if ( this_player()->query("zhuanyun_age" ) >= this_player()->query("age" ))
           return RANK_D->query_respect(this_player())+"你今年已经转过运了。"; 

        this_player()->set("zhuanyun_age",this_player()->query("age" ));

        message_vision("张天师把手按在$N的头顶，一道金光射入$N的体内。\n",this_player());
        
        this_player()->set("kar",10+random(21));
        return RANK_D->query_respect(this_player())+"你今年的运势已经转变了。";
}




int ask_shenshu()
{      
        object ob;
        if ( (int)this_player()->query("combat_exp" ) < 100000){
             command("say 你是不是应该再闯荡一段时间积累点经验？" );
             return 1;
        }  
        if ( (int)this_player()->query("zhang_shenshu" ) > 0){
             command("say 你已经拿过了。" );
             return 1;
        }     
        ob = new("/u/keinxin/bestbook_nogive");
        ob->move(this_player());

        this_player()->set("zhang_shenshu",1);

        message_vision("$N获得一本无字神书。\n",this_player());
        
        command("say 好吧，既然你已经在江湖上闯荡了一段时间，这本书就给你吧。" );
        return 1;
}

int ask_pot()
{      
        this_player()->start_busy(2);
        if ( this_player()->query("potential" ) < 101){
        command("say 你只有这么点潜能，存什么存？？" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) > 80){
             command("say 你存了太多的潜能了，用掉点吧。" );
             return 1;
        }     

        this_player()->add("potential",-100);
        this_player()->add("zhang_potential",1);

        
        command("say 好吧，你在我这里存放了"+chinese_number(this_player()->query("zhang_potential")*100)+"点潜能。" );
        return 1;
}

int ask_me()
{
        command("heihei");
        command("say 我只给你打造的神兵利器开光，寻常刀剑莫提！"
                "要属于你本人或者别人送给你拥有的，不然没有效果可不要找我！");
        tell_object(this_player(), GRN "张天师在你耳边悄悄说："
                    "你把要开光的拿出来给我看看(show)！\n" NOR);
        return 1;
}

int ask_take()
{      
        object me;
        me = this_player();
        this_player()->start_busy(2);
        if ( this_player()->query("potential" ) > 600){
        command("say 你身上潜能太多了，先去用掉点吧" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) < 1){
             command("chat 剑心快来啊，"+me->query("name")+"要骗潜能。剑心不在，老道先给你点教训。" );
             me->unconcious();
             return 1;
        }     

        this_player()->add("potential",100);
        this_player()->add("zhang_potential",-1);

        command("say 好吧，这一百点潜能先给你。" );
        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*100)+"点潜能。" );
        return 1;
}

int ask_check()
{      
        this_player()->start_busy(2);
   

        if ( this_player()->query("zhang_potential" ) < 1){
             command("say 你在我这里没有存潜能。" );
             return 1;
        }     

        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*100)+"点潜能。" );
        return 1;
}

int do_show(string arg)
{
        object money;
        object ob;
        object me;
	string type;

        if (! arg)
                return notify_fail("你要亮出什么东西？\n");

        me = this_player();
        if (! objectp(ob = present(arg, me)))
                return notify_fail("你身上没有这种东西。\n");

        if (ob->query("equipped"))
                return notify_fail("你先解除" + ob->name() + "的装备再说！\n");

        message_vision("$n拿出一" + ob->query("unit") + ob->name() +
                       "对$N说：“拜托拜托...”\n",
                       this_object(), me);

        if (ob->query("money_id"))
        {
                command("say 你亮出钱干什么？想献给观里？那就给我好了。");
                return 1;
        }
        

        if( ob->is_corpse() ){ 
		me->start_busy(5);
		message_vision("$N说道，我把你变成这样东西吧！说着用手对你一指\n", this_object());
		me->unconcious();
		return 1;
	}

        if ( me->query("user_weapon/weapon_prop/damage")<40) {
                command("consider");
                command("say 这...你这个武器那么差，怎么开光？");
                return 1;
        }
        
        if ( ob->query("weapon_prop/damage")<40) {
                command("consider");
                command("say 这...你这个武器那么差，怎么开光？");
                return 1;
        }
        
        if ( me->query("user_weapon/weapon_prop/damage")>350) {
                command("consider");
                command("say 这...这是旷古神兵，用不着开光了！");
                return 1;
        }
        
        if ( ob->query("weapon_prop/damage")>350) {
                command("consider");
                command("say 这...这是旷古神兵，用不着开光了！");
                return 1;
        }
        
        if ( me->query("shenshu/bestbookopened")<3) {
                command("consider");
                command("say 这...你连无字神书都没有参透，怎么放心给你的武器开光？"
                        "先去找[三]本无字神书来读一读吧");
                return 1;
        }


        if (me->query("zhang_kaiguang")>2) {
                command("consider");
                command("say 我只能给你开光三次");
                return 1;
        }


         message("vision", HIM + name() + "从口袋中摸出一张黄色"
                                "的符纸，抽出背后的桃木剑，"
                                "将那符纸点燃了，扫过" + ob->name() + HIM "，然"
                                "后用桃木剑穿了，口中念念有词："
                                "说罢一抖掌中剑，"
                                "喝道：“疾”！\n" NOR, environment());
        message_vision("焰光划出一道光华，$N发了发呆，也不知道算是怎么回事。\n",
                       me);
        command("say 行了，行了！你可以走了。退出之后就能看到威力的改变了。");
        me->delete_temp("paid/张天师");
        //add to both features
        me->add("user_weapon/weapon_prop/damage",20);
        ob->add("weapon_prop/damage",20);
        me->add("zhang_kaiguang",1);	       
        return 1;
}

