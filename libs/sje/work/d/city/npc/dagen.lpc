#include <ansi.h>
inherit NPC;
void create() {
  set_name("打更人", ({ "dageng", "dageng ren" }));
  set("long",
    "一个每晚为百姓报时间的老人。\n");
  // set("attitude", "aggressive");
  // set("vendetta/authority",1);
  set("per", 1);
  set("age", 50);
  set("intellgent", 1);
  set("unique", 1);
  set("pursuer", 1);
  set("combat_exp", 10000 + random(40000));
  set("bellicosity", 10000);
  set("chat_chance_combat", 3);
  set("chat_msg_combat", ({
    "打更人叹了口气说道：但愿今晚没人被打劫。\n",
    (: random_move :),
  }));
  set("chat_chance", 3);
  set("chat_msg", ({
    (: random_move :),
  }));

  set_skill("unarmed", 70 + random(50));
  set_skill("blade", 70 + random(50));
  set_skill("parry", 70 + random(50));
  set_skill("dodge", 70 + random(50));

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/armor", 70);
  set_temp("apply/damage", 30 + random(100));
  set_temp("apply/move", 100);

  setup();

  //        carry_object("/obj/cloth")->wear();
  //        carry_object(__DIR__"obj/guiblade")->wield();
}
