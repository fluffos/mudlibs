// by Xiaoyao

inherit NPC;

void destroying(object, object);

void create() {
  set_name("丁典", ({ "ding dian", "ding" }));
  set("long",
    "这人满脸虬髯，头发长长的直垂至颈，衣衫破烂不堪，简直如同荒山中的野人。\n");
  set("gender", "男性");
  set("age", 35);

  set_skill("cuff", 120);
  set_skill("dodge", 120);
  set_skill("parry", 130);
  set_skill("qingmang-jian", 120);
  set_skill("taizu-quan", 150);
  set_skill("shenzhao-jing", 120);
  map_skill("dodge", "qingmang-jian");
  map_skill("force", "shenzhao-jing");
  map_skill("parry", "qingmang-jian");
  map_skill("cuff", "taizu-quan");
  prepare_skill("cuff", "taizu-quan");
  set("max_neili", 3000);
  set("neili", 3000);
  set("max_qi", 1680);
  set("qi", 1680);
  set("eff_jingli", 1800);
  set("jingli", 1800);
  set("jiali", 100);

  set("combat_exp", 600000);
  set("shen_type", 1);
  setup();
  carry_object("/d/city/obj/cloth")->wear();

}

int accept_object(object me, object obj) {
  object key;
  if ((string)obj->query("id") == "lu juhua") {
    message("vision", me->name() + "给丁典一盆绿菊花。\n", environment(me),
      ({ me }));
    key = new(__DIR__ "/clone/armor/wuchanyi");
    if (!key) {
      command("say 我已经托人给霜华捎话了，不劳您大驾了。");
      return 0;
    }

    command("touch " + me->query("id"));
    command("say 这位" + RANK_D->query_respect(me) + "是霜华派你来捎话的吧,嗨！我们可是苦命的鸳鸯。");
    key->move(me);
    add("book_count", -1);
    message_vision("$n递给$N一件乌蚕衣。\n", me, this_object());
    command("say 这位" + RANK_D->query_respect(me) + "真是太感谢你了,这件宝衣你拿去用把。");
    remove_call_out("destroying");
    call_out("destroying", 1, this_object(), obj);
    return 1;
  }
  return 0;
}

void destroying(object me, object obj) {
  destruct(obj);
  return;
}
