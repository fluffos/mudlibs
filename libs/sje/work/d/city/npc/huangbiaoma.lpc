//horse
//wzf 11 14
inherit NPC;

void create() {
  set_name("黄膘马", ({ "huangbiao ma", "ma" }));
  set("long",
    "这是一匹黄膘马。\n"
  );
  set_weight(50000);
  //only test , can consider change it later.
  set_max_encumbrance(50000);
  set("race", "野兽");
  set("age", 5);
  set("max_jing", 200);
  set("max_qi", 200);
  set("max_jingli", 500);
  set("eff_jingli", 500);
  set("str", 30);
  set("limbs", ({ "头部", "身体", "前蹄 ", "後蹄" }));
  set("verbs", ({ "hoof", "kick" }));
  set("unique", 5);
  set("value", 1000);
  set("can_ride", 1);
  set_temp("no_return", 1);
  set("no_get", 1);
  set_temp("apply/attack", 50);
  set_temp("apply/dodge", 50);
  set_temp("apply/armor", 30);
  set("combat_exp", 50000);
  set_temp("master", "ma fu");
  setup();
}
void init() {}
