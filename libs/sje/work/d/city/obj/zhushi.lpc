#include <ansi.h>

inherit ITEM;

void init()
{
       add_action("do_eat", "eat");
}


void create()
{
	set_name(YEL "猪食" NOR, ({"zhushi"}));
	set_weight(9999999);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一锅深受拱猪帮喜爱的猪食。\n");
		set("unit", "锅");
		set("value", 1);
                set("remaining", 100);
                set("no_get", HIB"你发现似乎有人窥视你，只好乖乖的放下了一锅猪食。\n"NOR);
                set("food_supply", 100);
                set("water_supply", 100);
             }
}

int do_eat(string arg)
{
	
    if( !this_object()->id(arg) ) return 0;
    if( this_player()->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");
    if(   (int)this_player()->query("food")
       >= (int)this_player()->max_food_capacity() )
     return notify_fail("你已经吃太多了，再也吃不下一口猪食了。\n");

    this_player()->add("food", (int)query("food_supply"));
    this_player()->add("water", (int)query("water_supply"));     

    if( this_player()->is_fighting() ) this_player()->start_busy(2);
    
    add("remaining", -1);
	if ( query("remaining") )
	{
   		 message_vision("$N拿起勺子，有滋有味地吃了一口猪食。\n"+
      		"$N把舌头伸到嘴边舔了舔，大声赞道：“味道好极了！”\n", this_player());
	} else 
	{ 
   		 message_vision("$N拿起勺子，精精有味地将剩下的猪食吃的干干净净。\n"+
      		"$N大声说道：天下此食最为鲜之。\n", this_player());
		
		destruct(this_object());
	}

	return 1;
}