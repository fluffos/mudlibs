// hsnr.c 红烧牛肉

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("蚝油牛肉", ({"haoyou niurou", "niurou"}));
    set_weight(300);
	if (clonep())
		set_default_object(__FILE__);
	else {
        set("long", "一盘炖得很烂很香的牛肉，看得你直流口水。\n");
        set("unit", "盘");
        set("value", 1000);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
