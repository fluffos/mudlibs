// Room: /d/wizard/zoulang.c

inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
这里是通向各巫师工作室的走廊，墙上挂着许多世界名画，格调高雅。
LONG);
  set("exits", ([
    "down": __DIR__ "wizard_room"
  ]));

  setup();
}

void run(object ob) {
  if (environment(ob) == this_object())
    ob->move("/u/" + ob->query("id") + "/workroom");
}

void init() {
  object ob = this_player();

  call_out("run", 5, ob);
}
