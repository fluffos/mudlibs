#include <ansi.h>

inherit ROOM;
string look_leitai();
void create() {
  set("short", "天地门看台");
  set("long", "这里是" + MUD_NAME + "里的天地门比武擂台(leitai)的看台，台下挤满了来自
各门各派的观众。上面据说曾经有很多对武林人士在那里比试武艺。这里人声
鼎沸，热闹无比。\n");
  set("no_death", 1);
  set("no_get_from", 1);
  set("no_fight", "1");
  set("no_sleep_room", 1);
  set("exits", ([
    "out": __DIR__ "lt",
    "east": __DIR__ "lt1a",
    "west": __DIR__ "lt2a",
  ]));
  set("item_desc", ([
    "leitai": (: look_leitai :),
  ]));
  setup();
}

string look_leitai() {
  object me, room;
  me = this_player();

  if (me->is_busy())
    return "你正忙着呢。\n";
  me->start_busy(2);
  if (!(room = find_object("/cmds/leitai/leitai")))
    room = load_object("/cmds/leitai/leitai");

  message_vision("$N挤到擂台边，伸长了脖子向上望去。\n", me);
  "/cmds/std/look.lpc"->look_room(this_player(), room);
  return "";
}
#include "lt.h"
