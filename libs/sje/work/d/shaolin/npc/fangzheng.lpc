#include "ansi.h"

inherit NPC;
inherit F_MASTER;
string ask_me();
string ask_mudao();
int do_nod(string);
void create() {
  object ob;
  set_name("方证大师", ({ "fangzheng dashi", "dashi" }));
  set("title", "少林方丈");
  set("gender", "男性");
  set("class", "bonze");
  set("age", 70);
  set("long", "他是少林的神僧，少林百年以来只有他的易筋经达到了化解的地步。       
他须发全白，双目如电。\n");
  set("attitude", "peaceful");
  set("combat_exp", 1200000);
  set("shen", 14500);
  set("str", 30);
  set("int", 25);
  set("dex", 28);
  set("con", 28);
  set("qi", 3500);
  set("max_qi", 3500);
  set("max_jing", 3000);
  set("eff_jingli", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  create_family("少林派", 35, "弟子");
  assign_apprentice("弟子", 0);
  set_skill("force", 180);
  set_skill("parry", 180);
  set_skill("dodge", 180);
  set_skill("banruo-zhang", 180);
  set_skill("yijin-jing", 180);
  set_skill("finger", 180);
  set_skill("strike", 180);
  set_skill("shaolin-shenfa", 180);
  set_skill("buddhism", 180);
  set_skill("literate", 150);
  map_skill("strike", "banruo-zhang");
  map_skill("force", "yijin-jing");
  map_skill("parry", "banruo-zhang");
  map_skill("dodge", "shaolin-shenfa");
  prepare_skill("strike", "banruo-zhang");
  set("inquiry", ([
    "菩提子": (: ask_me :),
    "木刀": (: ask_mudao :),
  ]));
  set("count", random(10) - 8);
  setup();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}


void init() {
  object me, ob;
  mapping fam;
  me = this_player();
  ob = this_object();
  ::init();




  return;
}

string ask_mudao() {
  object me, ob;
  me = this_player();
  if (me->query("family/master_name") != "方证大师")
    return RANK_D->query_respect(me) + "不是我的弟子，在这瞎打听什么！\n";

  if (me->query("combat_exp") < 250000)
    return "你的经验上浅，怎么放心交给你保管？\n";
  ob = unew("d/shaolin/npc/obj/zcmudao");
  if (!clonep(ob))
    return "你来晚了，本派的" YEL "「真禅木刀」" CYN "不在此处。";
  if (clonep(ob) && ob->violate_unique()) {
    destruct(ob);
    return "你来晚了，本派的" YEL "「真禅木刀」" CYN "不在此处。";
  }

  ob->move(me);
  return RANK_D->query_respect(this_player()) + "这把" YEL "「真禅木刀」" CYN "就交给你保管了。";
}

string ask_me() {
  object ob;

  if (present("puti zi", this_player()))
    return RANK_D->query_respect(this_player()) + "菩提子只有一颗，而且就在你身上，真是贪得无餍！";
  if (present("puti zi", environment()))
    return RANK_D->query_respect(this_player()) + "菩提子只有一颗，而且就在这里任你取走，真是贪得无餍！";
  if (query("count") < 1)
    return "菩提子乃天地之灵物，采集艰难无比，我这里现在可没有。";
  ob = unew(MEDICINE_D("puti-zi"));
  if (!clonep(ob)) return "菩提子乃天地之灵物，采集艰难无比，我这里现在可没有。";
  if (clonep(ob) && ob->violate_unique()) {
    destruct(ob);
    return "菩提子乃天地之灵物，采集艰难无比，我这里现在可没有。";
  }
  ob->move(this_player());
  add("count", -1);
  message_vision("\n渡难微微一笑，从怀里里取出个白玉磁瓶，倒出菩提子递给$N。\n\n", this_player());
  return "老僧昔年于佛祖座前发下宏愿，每十年遍访名山大川，历尽艰险，\n" +
    "方采得数颗菩提子，君乃有缘人，能得此造化奇物，望好自为之！";
}

void attempt_apprentice(object ob) {
  if (ob->query_temp("baitieok") < 1) {
    command("say 老僧现在不收任何弟子。");
    return;
  }

  if ((int)ob->query_skill("yijin-jing", 1) < 120) {
    command("say 我少林十分重视内功心法修为。");
    command("say " + RANK_D->query_respect(ob) +
      "的内功修为是否还应该有所提高啊？");
    return;
  }

  ob->delete_temp("baitieok");
  command("say 依照少林寺历代规矩，" + RANK_D->query_respect(ob) + "你必须接下我三招，我才能收你为徒。");
  call_out("test", 1, ob);
}


void test(object ob) {
  object me = this_object();

  COMBAT_D->do_attack(me, ob, query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, query_temp("weapon"), 0);
  call_out("check", 1, ob);
}

void check(object ob) {
  string new_name;

  if (!living(ob) || environment(ob) != environment()) {
    command("sigh");
    return;
  }
  command("buddhi dashi");
  command("recruit " + ob->query("id"));
  new_name = ob->query("name");
  new_name[0..1] = "玄";
  ob->set("name", new_name);
  ob->set("方证pass", 1);
  command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派玄字辈圣僧之一！\n");
  command("chat* 哈哈大笑道：“老衲垂死之年，又收一可塑之才，真是可喜可贺！”");
  command("say 大师一番勤学苦练，终有今日，且让老衲给你两颗菩提子,以增强功力。");
  ob->add("combat_exp", 15000);
  ob->add("potential", 8000);
  ob->add("str", 1);
  new("/clone/medicine/puti-zi")->move(ob);
  new("/clone/medicine/puti-zi")->move(ob);

}
