// mudao.c

#include <weapon.h>

inherit BLADE;

void create() {
  set_name(YEL "真禅木刀" NOR, ({ "zhenchan mudao", "dao", "mudao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 500);
    set("treasure", 1);
    set("unique", 1);
    set("material", "wood");
    set("long", "这是一柄木刀，由少林方丈代代相传，交给武艺和禅学出众的高僧修习燃木刀法。
刀身上刻着一行篆文：" HIR "[焚我] [焚心] [焚天]" NOR "\n");
    set("wield_msg", "$N抽出一把$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插回腰间。\n");
    set("shaolin", 1);
  }
  init_blade(25);
  setup();
}
