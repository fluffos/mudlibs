inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", @LONG
你走在一条碎石铺成的小路上，两侧青草茵茵，山花烂漫。空气中夹带
着泥土的芳香，扑面而来。南面有一片很大的菜园子。
LONG
	);
        set("outdoors", "shaolin");

	set("exits", ([
		"south" : __DIR__"cyzi-1",
		"north" : __DIR__"xiaolu-2",
	]));
	setup();
	replace_program(ROOM);
}

