#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "般若堂" NOR);
  set("long", @LONG
你面前是一座很大的院落，周围用高墙围住，院门匾额上写着『般若堂
』三个大字。这里是少林弟子精研天下各家各派武功的所在。有很多年轻的
僧人进进出出，院内传来阵阵呼喝练功的声音。
LONG
  );

  set("exits", ([
    "west": __DIR__ "stoneroad3",
    "east": __DIR__ "lwc16",
  ]));

  set("outdoors", "shaolin");
  set("objects", ([
    CLASS_D("shaolin") + "/xuan-nan": 1,
    __DIR__ "npc/xiao-ku": 1
  ]));
  setup();
  replace_program(ROOM);
}
