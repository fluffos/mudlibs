// /d/shaolin/xct.c
// keinxin @sj2 2003.3
inherit ROOM;

#include <ansi.h>


void create() {
  set("short", HIG "后院" NOR);
  set("long", @LONG
这是一片开阔的院子。视野极其开阔，可以望到远处的群山。
这里别无他物。只种了一颗百年菩提树。
这颗菩提树，一半已经枯死，另一半确是生机盎然。
看来这里是个得道高僧领悟(lingwu)的好地方。
LONG
  );

  set("exits", ([
    "south": __DIR__ "xct",
  ]));

  set("objects", ([

  ]));
  setup();

}

int init() {

  add_action("do_kan", "lingwu");

}

int do_kan(string arg) {
  object me, mudao;
  me = this_player();
  if (!living(this_player()) || arg != "putishu")
    return 0;
  if (me->query("family/master_name") != "方证大师")
    return notify_fail("你没有得到方证大师的指点，什么也领悟不到。\n");

  if (!mudao = present("zhenchan mudao", me))
    return notify_fail("你没有带" YEL "真禅木刀" NOR "\n");

  if ((int)me->query_skill("literate", 1) < 1)
    return notify_fail("你是个文盲，先学点文化吧。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 120)
    return notify_fail("凭你现在的内功修为，无法领悟这么高深的武功。\n");
  if ((int)me->query_skill("xiuluo-dao", 1) < 120)
    return notify_fail("凭你现在的刀法修为，无法领悟这么高深的武功。\n");

  if ((int)me->query("jing") < 100) {
    write("你太累了，已经没有精神来领悟了！\n");
    return 1;
  }

  if ((int)me->query("potential", 1) < 1) {
    write("你已经没有潜能来领悟了。\n");
    return 1;
  }

  me->receive_damage("jing", random(me->query_skill("force", 1)) / 2 + 10);
  message_vision("$N正在出神的望着那颗菩提树。\n", me);

  write("你出神的看着那颗菩提树，突然之间，木刀上好像映出了一个在火焰中舞刀的人影，举刀砍向那棵树。\n");
  me->improve_skill("ranmu-daofa", me->query_skill("blade") / 5);
  me->add("potential", -1);
  return 1;
}
