#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "拱门");
  set("long", @LONG
这里是一个天然形成的拱月形的石门，完全是鬼斧神工所为。
你不禁想到，这里以前还会有人来过么?
LONG NOR);
  set("exits", ([

    "out": __DIR__ "dong41",

  ]));
  set("objects", ([

  ]));
  set("no_clean_up", 0);
  setup();

}

void init() {
  object room;
  object me = this_player();
  if (!me->query_temp("zuan_shifeng", 1) && !wizardp(me)) {
    message_vision("$N脚下踩到一处机关，大叫一声，掉落下去。\n", me);
    me->unconcious();
    if (room = load_object(__DIR__ "dongkou"))

      me->move(room);

  }

}
