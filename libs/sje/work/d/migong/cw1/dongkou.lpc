
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
object room;
	set("short", WHT"洞口"NOR);
	set("long",  @LONG
这里是一处山洞的洞口，里面不时传来阵阵寒风。
令人浑身不由得起了一层疙瘩。
LONG NOR);
	set("exits", ([
		
                "enter" : __DIR__"shandong",
		

	]));
 set("objects", ([
              
         ]));

if (room = load_object(__DIR__"dong"+(55+random(2))))
room->set("exits/enter",__DIR__"dong57");
if (room = load_object(__DIR__"dong"+(71+random(2))))
room->set("exits/enter",__DIR__"dong73");
if (room = load_object(__DIR__"dong"+(87+random(2))))
room->set("exits/enter",__DIR__"dong89");
if (room = load_object(__DIR__"dong"+(103+random(2))))
room->set("exits/enter",__DIR__"gongmen");


	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}
