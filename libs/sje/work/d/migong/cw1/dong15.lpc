#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", YEL "长廊" NOR);
  set("long", @LONG
这里是一条幽暗的地下长廊，不知道通往什么地方。
两边的长明灯散发着幽暗的光。
LONG NOR);
  set("exits", ([

    "north": __DIR__ "dong" + (random(15) + 5),
    "south": __DIR__ "dong" + (random(15) + 5),


  ]));
  set("objects", ([

  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
