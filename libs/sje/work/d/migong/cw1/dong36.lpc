
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", CYN"山洞"NOR);
	set("long",  @LONG
这里是一个阴风阵阵的洞穴，石壁是灰质的，看起来很是坚硬，
不易遭到破坏，在一个不起眼的角落里，你找到了一个石缝(shifeng)。
LONG NOR);

	set("exits", ([		
                "south" : __DIR__"dong"+random(21),
		  
 		   "north" : __DIR__"dong"+random(21),

		

	]));

 set("objects", ([
              
         ]));
	set("no_clean_up", 0);
	setup();
	
}
void init()
{
	add_action("do_zuan","zuan");
}

int do_zuan(string arg)
{
	 object me;
        me = this_player();

        if (!arg||arg !="shifeng") 
        return notify_fail("你往哪里钻啊？\n");
        
	write("你用力地往石缝里钻，还好空隙刚好能钻过去。\n");
	me->move(__DIR__"dong37");
	me->start_busy(2);
	me->set_temp("zuan_shifeng",1);
        
        return 1;

}