inherit ROOM;

void create()
{
        set("short", "佛山祖庙");
        set("long",
"这里是佛山著名的名胜古迹之一佛山祖庙，这里看起来很热闹，听
说这里的佛很灵验，很多外地人都闻名至此，到处都青烟缭绕，香火很
旺盛。\n"
        );
        set("exits", ([
            "southeast" : __DIR__"xiaolu1",
        ]));
        set("objects",([
            __DIR__"npc/man" : 1,
        ]));

        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

