inherit ITEM;
void create() {
  set_name("五毒秘传", ({ "wudu mizhuan", "book", "mizhuan" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", " 一本记载诸般毒药和解药的抄本。\n");
    set("value", 100);

    set("material", "paper");
  }
}
