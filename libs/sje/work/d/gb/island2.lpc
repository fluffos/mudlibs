// island2.c 
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "巨岩");
  set("long", @LONG
一块光秃秃的大岩石，四周长满了青苔。只有正中处凹了下去，似乎给什
么敲过。你走过去仔细一看，好象里面印着不少棒印似的。站在岩石上，极目
四望，远处点点灯火，好一个渔港夜灯。
LONG
  );
  set("outdoors", "泉州");
  set("exits", ([
    "south": __DIR__ "island1",
  ]));
  setup();
}

void init() {
  add_action("do_za", "za");
  add_action("do_ji", "strike");
}

int do_za(string arg) {
  object me = this_player();

  if (!(arg) || ((arg != "rock") && (arg != "yan")))
    return 0;
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！");
  if (me->query("max_neili") <= 300) {
    message_vision("$N往岩石上一拍，谁知内力不够，闷哼了一声，反而受了内伤。\n", me);
    me->receive_wound("qi", 10);
    return 1;
  }
  if (me->query("jing") < 40)
    return notify_fail("你太累了。\n");
  if (me->query_skill("stick", 1) < 30)
    return notify_fail("你用力砸岩石，但感觉力不从心。\n");
  if (me->query_skill("stick", 1) > 120)
    return notify_fail("你用力一下，把岩石砸的四处飞扬。\n");
  message_vision("$N大喝一声，往岩上一砸，只听见嗡...，岩石摇了几下。\n", me);
  me->improve_skill("stick", me->query_int());
  me->receive_damage("jing", 20 + random(15));
  return 1;
}

int do_ji(string arg) {
  object me = this_player();

  if (!(arg) || ((arg != "rock") && (arg != "yan")))
    return 0;
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！");
  if (me->query("max_neili") <= 300) {
    message_vision("$N往岩石上一拍，谁知内力不够，闷哼了一声，反而受了内伤。\n", me);
    me->receive_wound("qi", 10);
    return 1;
  }
  if (me->query("jing") < 40)
    return notify_fail("你太累了。\n");
  if (me->query_skill("strike", 1) < 30)
    return notify_fail("你用力砸岩石，但感觉力不从心。\n");
  if (me->query_skill("strike", 1) > 120)
    return notify_fail("你用力一下，把岩石砸的四处飞扬。\n");
  message_vision("$N大喝一声，往岩上一砸，只听见嗡...，岩石摇了几下。\n", me);
  me->improve_skill("strike", me->query_int());
  me->receive_damage("jing", 20 + random(15));
  return 1;
}
