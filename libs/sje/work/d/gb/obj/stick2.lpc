// stick2.c
inherit ITEM;
void create()
{
        set_name("棒法图解下册", ({ "stick book", "book" }));
        set_weight(200);
        set("unit", "册");
        set("long", "这是一册棒法图解上面画着一个大汉挥舞竹棒与众人厮杀的情景。\n");
        set("treasure",1);
        set("value", 500);
        set("material", "paper");
        set("skill", ([
         "name": "stick",        // name of the skill
         "exp_required": 50000,   // minimum combat experience required
         "jing_cost": 20+random(15),// jing cost every time study this
         "difficulty":   25,     // the base int to learn this skill
         "max_skill":    51      // the maximum level you can learn
       ]));
}
