inherit NPC;
inherit F_MASTER;
inherit __DIR__ "gb_sd.lpc";

void create() {
  object weapon;
  set_name("陈长老", ({ "chen zhanglao", "chen", "zhanglao" }));
  set("title", "丐帮九袋长老");
  set("nickname", "长臂叟");
  set("gender", "男性");
  set("unique", 1);
  set("age", 56);
  set("long", "他乃丐帮六大长老之一，使的是一只麻包袋，甚是怪异。\n");
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 23);
  set("con", 25);
  set("dex", 23);

  set("qi", 1100);
  set("max_qi", 1100);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 50);

  set("combat_exp", 450000);
  set("score", 20000);
  set("apprentice", 1);

  set_skill("force", 120);  // 基本内功
  set_skill("huntian-qigong", 120);  // 混天气功
  set_skill("unarmed", 100);  // 基本拳脚
  set_skill("dodge", 120);  // 基本躲闪
  set_skill("xiaoyaoyou", 120);  // 千里行乞 
  set_skill("parry", 120);  // 基本招架
  set_skill("whip", 120);
  set_skill("begging", 110);
  set_skill("huifeng-bian", 120);
  set_skill("suohou-shou", 120);
  set_skill("hand", 120);
  map_skill("hand", "suohou-shou");
  map_skill("whip", "huifeng-bian");
  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "huifeng-bian");
  prepare_skill("hand", "suohou-shou");

  create_family("丐帮", 18, "九袋长老");

  set("inquiry", ([
    "丐帮": "我们丐帮是天下第一大帮！\n",
    "升袋": "找你的舵主去。\n",
    "萧峰": "哎，可惜可惜，乔帮主何等英雄，可惜是契丹种。\n",
    "乔帮主": "啊？你是我们帮。。。乔大爷的朋友？\n"
    "他是我们丐帮的前任帮主，一双降龙掌使得出神入化。\n"
    "听说他以前每天都要喝十来二十斤酒下肚，\n"
    "然后才去练掌，当真了不起！\n",
    "练掌": "哦。。。这个我也不太清楚，他那时好象是跟奚长老学的。\n",
    "洪七公": "呵呵，我也不太清楚他跑去哪偷吃了。\n",
  ]));

  setup();
  carry_object(__DIR__ "obj/bainayi")->wear();
  carry_object(__DIR__ "obj/gb_budai9")->wear();
  if (clonep()) {
    weapon = unew(BINGQI_D("pobudai"));
    if (!weapon) weapon = new("/d/shaolin/obj/changbian");
    weapon->move(this_object());
    weapon->wield();
  }
  set("chat_msg_combat", ({
    (: perform_action, "whip.huixuan" :)
  }));
  set("chat_chance", 10);
}

void attempt_apprentice(object ob) {
  if (ob->query_int() < 25) {
    command(":)");
    command("say " + RANK_D->query_respect(ob) +
      "天资有限，跟我是学不好的。\n");
    return;
  }
  gb_apprentice(ob);
  //      ob->set("class", "beggar");
}
