#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
inherit __DIR__ "gaibang_npc.lpc";

mapping *quest = ({
  ([ "name": "qianrenshi",
    "start": "/u/beyond/suzhou/qianrenshi",
    "place": "千人石", ]),
  ([ "name": "caixiangjing",
    "start": "/u/beyond/suzhou/caixiangjing",
    "place": "采香径", ]),
  ([ "name": "chitang",
    "start": "/u/beyond/suzhou/chitang",
    "place": "池塘", ]),
  ([ "name": "baodaiqiao",
    "start": "/u/beyond/suzhou/baodaiqiao",
    "place": "宝带桥",
  ]),
});
string ask_job2();

void create() {
  set_name("陈长老", ({ "chen zhanglao", "chen", "zhanglao" }));
  set("title", "丐帮九袋长老");
  set("nickname", "长臂叟");
  set("gender", "男性");
  set("age", 56);
  set("long",
    "他乃丐帮六大长老之一，使的是一只麻包袋，甚是怪异。\n");
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 28);
  set("con", 25);
  set("dex", 25);

  set("qi", 1100);
  set("max_qi", 1100);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 100);

  set("combat_exp", 550000);
  set("score", 20000);
  set("apprentice", 1);

  set_skill("force", 120);  // 基本内功
  set_skill("huntian-qigong", 120);  // 混天气功
  set_skill("strike", 100);  // 基本拳脚
  set_skill("cuff", 150);
  set_skill("dodge", 120);  // 基本躲闪
  set_skill("xiaoyaoyou", 120);  // 千里行乞 
  set_skill("parry", 120);  // 基本招架
  set_skill("whip", 140);
  set_skill("begging", 110);
  set_skill("huifeng-bian", 150);
  map_skill("whip", "huifeng-bian");
  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "huifeng-bian");

  create_family("丐帮", 18, "九袋长老");

  set("inquiry", ([
    "丐帮": "我们丐帮是天下第一大帮！\n",
    "升袋": "找你的舵主去。\n",
    "萧峰": "哎，可惜可惜，乔帮主何等英雄，可惜是契丹种。\n",
    "乔帮主": "啊？你是我们帮。。。乔大爷的朋友？\n"
    "他是我们丐帮的前任帮主，一双降龙掌使得出神入化。\n"
    "听说他以前每天都要喝十来二十斤酒下肚，\n"
    "然后才去练掌，当真了不起！\n",
    "练掌": "哦。。。这个我也不太清楚，他那时好象是跟奚长老学的。\n",
    "洪七公": "呵呵，我也不太清楚他跑去哪偷吃了。\n",
    "正义": (: ask_job2 :),
    "行侠仗义": (: ask_job2 :),

  ]));
  setup();
  carry_object(__DIR__ "obj/gb_budai9")->wear();
  carry_object(__DIR__ "obj/changbian")->wield();
}

int accept_object(object me, object obj) {
  object ob = this_object();
  if (!me || environment(me) != environment()) return 0;
  if (!objectp(obj)) return 0;
  if (!present(obj, me)) return notify_fail("你没有这件东西。");
  if (userp(obj)) {
    command("consider " + (string)me->query("id"));
    command("say 你拿个快死的人来骗我？");
    return 0;
  }
  if (!me->query_condition("gb_task")) {
    command("shake " + (string)me->query("id"));
    command("say 这么久才回来，我本来还有重要大事要交给你！");
    return 0;
  }
  if (obj->query("id") == "xinwu" && obj->query("owner") == me->query("id")) {
    command("applaud " + (string)me->query("id"));
    command("say 好样的！行侠仗义才是我辈本色！\n");
    remove_call_out("destroying");
    call_out("destroying", 5, obj, ob, me);
    return 1;
  }
  if (obj->query("money_id")) {
    command("slap " + me->query("id"));
    command("say 混蛋想收买我？！\n");
    return 0;
  }
  if (obj->query("owner") != me->query("id")) {
    command("sneer " + (string)me->query("id"));
    command("say 把别人的功劳据为己有，你就不脸红?!\n");
    return 1;
  } else return 0;
}
void destroying(object obj, object ob, object me) {
  object n_money;
  int exp, pot;
  destruct(obj);
  if (!me || environment(me) != environment()) {
    command("say 咦，人呢？");
    return;
  }
  command("pat " + me->query("id"));
  message_vision(HIY "$N对$n说道：做的好，这里是老叫化的一点私房钱，拿去和弟兄们喝两盅吧！\n" NOR, ob, me);
  n_money = new("/clone/money/gold");
  n_money->move(me);
  n_money->add_amount(2);
  me->set_temp("job2_exp", 150 + (me->query_temp("bangtu") * (random(60) + 70)));
  exp = (int)me->query_temp("job2_exp");
  pot = (int)me->query_temp("bangtu") * 20;
  me->add("combat_exp", exp);
  me->add("potential", pot);
  //   me->add("shen", exp*2);
  me->add("gb_job", 5);
  tell_room(environment(me), me->name() + "接过钱，想着酒肉的香气，不禁流下了口水。\n" NOR, ({ me }));
  log_file("gb_job2", sprintf("
%s(%s)做丐帮任务2，杀了%i个敌人，得到：%i点EXP。\n",
    me->name(1), getuid(me), me->query_temp("xietu"), me->query_temp("job2_exp")));

  tell_object(me, "可有钱喝酒了！\n");
  tell_object(me, HIY "你做丐帮任务得到了\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n"
    NOR);
  me->delete_temp("job2_exp");
  me->delete_temp("bangtu");
  return;
}
string ask_job2() {
  object me, ob;
  mapping fam, aquest;
  int shen, exp, j;
  aquest = quest[random(sizeof(quest))];
  me = this_player();
  ob = this_object();
  fam = (mapping)me->query("family");
  shen = me->query("shen");
  exp = me->query("combat_exp", 1);

  //if (!fam) return "看得出你对老仙态度恭敬，何不加入我星宿派呢？";
  if (fam["family_name"] == "星宿派")
    return "你这恶贼，来找死么?!\n";
  if (interactive(me) &&
    (int)me->query_condition("xx_task") || (int)me->query_condition("xx_task2")) {
    me->delete("gb_pass");
    me->delete("gb_job");
    tell_object(me, HIW "你从此不再是丐帮帮众了。\n" NOR);
    return "混蛋，竟敢偷偷为丁老怪效力，滚！！！\n";
  }

  if (me->query_condition("gb_mission"))
    return "吴长老那的任务你还没做好吧?!\n";
  if (me->query_condition("gb_busy"))
    return "我现在可没有任务给你。";
  if ((int)me->query("gb_job", 1) < 100)
    return "你在丐帮日子太浅，交给你我可不放心。\n";
  if (ob->query_temp("job_asked") == me->query("id")) return "不是叫你先去那里接应我吗？怎么还赖在这里？";
  if (ob->query_temp("job_asked")) return "嘿嘿，你来晚了，等下一次吧。";
  if (exp < 200000) return "哈哈哈，你再加把力练功吧。";
  if (exp >= 800000) return "你的功力如此之高，这点事那敢劳烦您呢？";
  //    if(shen > -10000) return "哼！看来你的心肠还不够黑啊，这种事你不问也罢。";
  if (exp >= 600000) j = 6;
  else if (exp >= 500000) j = 5;
  else if (exp >= 400000) j = 5;
  else if (exp >= 300000) j = 4;
  else j = 3;

  me->set_temp("gb_job2", 1);
  message_vision(CYN "\n$N一声长啸，说道：这两天江南一些邪帮歪教残害正人，须得去救，我们一同前往吧。\n" NOR, ob, me);
  ob->set_temp("job_asked", me->query("id"));
  ob->set_temp("dest", aquest["name"]);
  ob->set_temp("start_place", aquest["start"]);
  ob->set_temp("place", aquest["place"]);
  me->set_temp("j", j);
  me->apply_condition("gb_task", 50);
  me->set_temp("apply/short", "丐帮义士");
  call_out("going", 70, ob);
  return "我闯去敌人总堂救人，你先去" + ob->query_temp("place") + "那里接应我。\n";
}
void going(object me) {
  message_vision("$N急急忙忙地走了出去。\n", me);
  me->move(me->query_temp("start_place"));
  message_vision("$N急急忙忙地走了过来，身法有些狼狈。\n", me);
}
void init() {
  object ob, where, me;
  ::init();
  ob = this_object();
  where = environment(ob);
  if (ob->query_temp("dest")) {
    if (interactive(me = this_player()) && me->query_temp("gb_job2")
      && ob->query_temp("job_asked") == me->query("id")
      && file_name(where) == ob->query_temp("start_place")) {
      remove_call_out("waiting");
      call_out("waiting", 1, ob, me);
    } else {
      remove_call_out("do_back");
      call_out("do_back", 90, ob);
    }
  }
}
void waiting(object ob, object me) {
  if (!living(me)) return;
  command("nod " + me->query("id"));
  command("say 好，我连毙了七名邪徒，落难之人向这里逃来了，我们一起等他吧。");
  ob->set_temp("wait_target", 1);
  me->set_temp("wait_target", 1);
  remove_call_out("wait_target");
  call_out("wait_target", 30, ob, me);
  return;
}
void do_back(object me) {
  me->delete_temp("wait_target");
  me->delete_temp("start_place");
  me->delete_temp("place");
  me->delete_temp("dest");
  me->delete_temp("job_asked");
  message_vision("$N转过两条路，几个起落就不见了。\n", me);
  me->move("/u/explorer/gb/xinglin9");
  message_vision("$N急急忙忙地走了过来。\n", me);
}
int wait_target(object ob, object me) {
  object obj;
  if (!objectp(present(me, environment(ob)))) {
    message_vision("$N说道：耶？那小子怎么没来？\n", ob);
    remove_call_out("do_back");
    call_out("do_back", 1, ob);
    return 1;
  }
  if (!objectp(ob = present("chen zhanglao", environment(me)))) {
    tell_object(me, "你发现陈长老不见了，只好灰溜溜地转身离开。\n");
    tell_room(environment(me), me->name() + "突然一脸茫然的表情，看来是想要离开了。\n", ({ me }));
    me->delete_temp("gb_job2");
    me->clear_condition("gb_task");
    me->delete_temp("wait_target");
    return 1;
  }

  obj = new("/u/explorer/gb/npc/nanmin");
  obj->move(environment(me));
  obj->set("arg", ob->query_temp("dest"));
  message_vision(HIY "只听一阵喊杀声传来，一群狼狈不堪的难民逃了过来！\n" NOR, ob);
  tell_object(me, "小心，邪帮教徒追杀而来了！\n");
  message_vision(HIY "$N对着$n大声命令道：你快去保护(protect)难民逃走，我来抵抗追兵！\n" NOR, ob, me);
  message_vision("说完$N就冲上前去，和几个面目狰狞的汉子杀在一处，消失在一片血泊中。\n", ob);
  remove_call_out("do_back");
  call_out("do_back", 3, ob);
  me->delete_temp("wait_target");
  me->set_temp("rob_start", 1);
}
