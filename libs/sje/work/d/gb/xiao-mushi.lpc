// /d/gb/xiao-mushi.c 小墓室
// by Looklove y2k 5/10
inherit ROOM;

void create() {
  set("short", "小墓室");
  set("long", @LONG
这是一个小墓室，墙上挂满了火炬，照得光亮亮的。墙边有一口不太深的
井，隐约可以看见井里面清澈的泉水。角落里有一个摊开的布口袋，上面放着
两个从附近百姓家讨来的剩馒头。化子们坐在角落里打着瞌睡。
LONG);
  set("resource/water", 1);
  set("sleep_room", 1);
  set("no_fight", 1);
  set("exits", ([
    "east": __DIR__ "mushizl",
  ]));
  set("objects", ([
  ]));
  setup();
}

void init() {
  add_action("do_drink", "drink");
  add_action("do_get", "get");
}

int do_drink(string arg) {
  int current_water;
  int max_water;
  object me;
  me = this_player();
  current_water = me->query("water");
  max_water = me->query("str") * 10 + 100;
  if (current_water < max_water) {
    me->set("water", current_water + 30);
    message("vision", me->name() + "趴在井台边上喝了一口水。\n"
      , environment(me), ({ me }));
    write("你喝了一口井中水，感觉舒服多了。\n");
  } else write("你已经喝了一肚子水了，再也喝不下了。\n");
  return 1;
}
int do_get(string arg) {
  object me = this_player();
  if (arg == "all") {
    tell_object(me, "急什么，一个一个捡！\n");
    return 1;
  }
  if (arg == "mantou" && me->query("family/family_name") != "丐帮") {
    tell_object(me, "还是给丐帮的兄弟留着吧。\n");
    return 1;
  }
  return 0;
}
