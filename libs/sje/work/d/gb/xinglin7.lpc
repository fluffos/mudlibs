inherit ROOM;

void create() {
  set("short", "杏子林");
  set("long", @LONG
这是一片杏子林，一走进来，你仿佛迷失了方向。你在杏花丛乱闯, 试图
发现出路。
LONG
  );

  set("outdoors", "苏州");
  set("exits", ([
    "east": __FILE__,
    "west": __FILE__,
    "south": __DIR__ "xinglin" + (1 + random(6)),
    "north": __DIR__ "xinglin8",
  ]));
  setup();
}
