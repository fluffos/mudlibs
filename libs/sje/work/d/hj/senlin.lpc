// senlin.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "针叶林");
  set("long", @LONG
这是极西天山脚下的一片针叶林，林中鸟兽成群，满地铺盖着厚厚一层松
针。西北方的一座高耸的山脉便是天山了，山上终年积雪，山下却是绿树成荫。
往东南走便是大草原，有辛勤的哈萨克族人在那里放牧。旁边有一个树丛(shucong)
好像与众不同。
LONG
  );
  set("item_desc", ([
    "shucong": "这片树丛好象有点与众不同，拨(bo shucong)开看看。\n"
  ]));
  set("exits", ([
    "west": "/d/xiaoyao/shulin3",
    "northeast": "/d/xingxiu/shanjiao",
    "southeast": __DIR__ "shanqiu",
  ]));

  set("objects", ([
    __DIR__ "npc/bird": 1,
  ]));

  set("outdoors", "天山");

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_push", "bo");
  add_action("do_zuan", ({ "zuan", "enter" }));
}

int do_push(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "shucong") return 0;
  write("你试着拨开树丛。\n");
  if (random((int)me->query("kar")) < 10) {
    write("你拨了半天没有拨开。\n");
    return 1;
  };
  write("树丛中露出一个的洞穴(hole)。\n");
  me->set_temp("marks/push", 1);
  return 1;
}

int do_zuan(string arg) {
  object me;
  me = this_player();
  if (!me->query_temp("marks/push")) return 0;
  if (arg != "hole") return 0;
  message_vision("$N大喜之下，一闪身钻进了洞里。\n", me);
  me->move("d/xingxiu/midao1");
  return 1;
}

int valid_leave(object me, string dir) {
  if (me->query_temp("marks/push")) me->delete_temp("marks/push");
  return ::valid_leave();
}
