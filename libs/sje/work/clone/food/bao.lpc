#include <ansi.h>

inherit ITEM;

nosave int full_times=0;
nosave int clearf=0;

void create()
{
	set_name("包子"NOR, ({ "baozi","bao" }) );
	set("long",HIY"\n"NOR);
	set("unit", "只");
	set("weight", 50);
	set("no_sell",1);
	set("no_get",1);
	set("no_steal",1);
	set("no_drop",1);
        set("value", 1000000);
}

void init()
{
        add_action("do_ATM","ATM");
	add_action("do_full","full");
}


int do_ATM(string arg)
{
	object me,ob;
        int i;         

        if( !arg || !sscanf(arg, "%d", i))
		return notify_fail("你要取多少两金子？\n");

	me=this_player();

	seteuid(getuid());


	if(i<1) i=1;

	if(i>10000000)
		return notify_fail("你是不是太贪心了？\n");

	ob=new("/clone/money/gold");
	ob->set_amount(i);
	ob->move(me);

	return 1;
}


int do_full(string arg)
{
	object me;
      
      me=this_player();

	if( !objectp(me = present(arg, environment(this_player())) ))
		me=this_player();

	me->set("eff_qi",me->query("max_qi"));
	me->set("qi",me->query("max_qi"));
	me->set("eff_jing",me->query("max_jing"));
	me->set("jing",me->query("max_jing"));

	me->set("neili",me->query("max_neili"));
	//me->set("eff_jingli",me->query("max_jingli"));
	me->set("jingli",me->query("eff_jingli"));
     
	me->set("food",300);
	me->set("water",300);

      tell_object(me,this_player()->name(1)+"伸指一点，你马上恢复了元气，又神采飞扬起来！\n");
      if(clearf==0)
      {
          clearf=1;
          remove_call_out("clearfull");	
	    call_out("clearfull",100);
      }	

	return 1;
}
