// yarou.c 鸭肉

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("鸭肉", ({ "ya rou", "yarou", "rou" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块鲜血淋漓的鸭肉，连着厚厚的脂肪。\n");
    set("unit", "块");
    set("value", 200);
    set("food_remaining", 1);
    set("food_supply", 60);
  }
}
