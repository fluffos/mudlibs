#include <weapon.h>
#include <ansi.h>

inherit DAGGER;
inherit F_UNIQUE;
void create()
{
        set_name(WHT"罚恶令"NOR,({ "fae ling", "ling", "dagger" }) );
        set_weight(15000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", WHT"这是一块闪闪发光的白铜牌子，牌上刻的却是一张狰狞的煞神凶脸，显得十分诡异。\n"NOR);
                set("treasure", 1);
                set("unit", "块");
                set("value", 1000);
                set("unique", 1);
                set("rigidity", 2);
                set("sharpness", 2);
                set("weapon_prop/parry", 2);        
                set("material", "bronze");
                set("wield_neili", 500);
                set("wield_maxneili", 900);
                set("wield_str", 24);
                set("wield_msg", "$N从口袋中取出一块$n，握在手中。\n"NOR);
                set("unwield_msg", "$N将$n收回到口袋里。\n");               
                set("amount", 1);
        }
        init_dagger(60);
        setup();
}
