#include <weapon.h>
#include <ansi.h>

inherit DAGGER;
inherit F_UNIQUE;
void create()
{
        set_name(WHT"赏善令"NOR,({ "shangshan ling", "ling", "dagger" }) );
        set_weight(15000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", WHT"这是一块闪闪发光的白铜牌子，牌上刻有一张笑脸，和蔼慈祥。\n"NOR);
                set("treasure", 1);
                set("unit", "块");
                set("value", 1000);
                set("unique", 1);
                set("rigidity", 2);
                set("sharpness", 2);
                set("weapon_prop/parry", 2);        
                set("material", "bronze");
                set("wield_neili", 500);
                set("wield_maxneili", 900);
                set("wield_str", 24);
                set("wield_msg", "$N从口袋中取出一块$n，握在手中。\n"NOR);
                set("unwield_msg", "$N将$n收回到口袋里。\n");               
                set("amount", 1);
        }
        init_dagger(60);
        setup();
}

void init()
{
        add_action("do_add",({ "he", "合" }));
}

int do_add()
{
        object me, ob, obj, dagger;
        me = this_player();
        ob = this_object();
        obj = present("fae ling", me);

        if( !objectp(obj) )
                return notify_fail("你手中只有一块赏善令，先找到另一块再说吧。\n");
        message_vision("$N将赏善令和罚恶令合并在一起使用。\n", me);
        destruct(obj);
        dagger = new(BINGQI_D("dagger/shangshanfae-ling"))->move(me, 1);
        destruct(ob);
        return 1;
}
