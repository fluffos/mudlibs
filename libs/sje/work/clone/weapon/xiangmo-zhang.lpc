#include <ansi.h>
#include <weapon.h>
inherit STAFF;
inherit F_UNIQUE;

void create()
{
        set_name(YEL "降魔杖" NOR, ({ "xiangmo zhang", "xiangmo", "zhang" }));
        set_weight(4000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", GRN "\n这是一根黄金打造的杖，据说能降魔除妖。\n"NOR);
                set("value", 1);
                set("treasure",1);
                set("unique", 1);
                set("material", "bamboo");
                set("weapon_prop/parry", 2);
                set("weapon_prop/dodge", 5);
                set("wield_msg", YEL"$N双手一晃，将$n抽出四周光芒四射。\n"NOR);
                set("unwield_msg", YEL"$N右手一抚，将$n插回背后。\n"NOR);
        }
        init_staff(90);
        setup();
}
