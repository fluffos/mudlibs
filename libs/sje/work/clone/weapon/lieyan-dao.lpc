// lieyan-dao 烈焰刀

#include <weapon.h>
#include <ansi.h>

inherit BLADE;
inherit F_UNIQUE;

void create()
{
        set_name( RED"烈焰刀"NOR,({ "lieyan dao", "lieyan","dao","blade" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 50);
                set("rigidity", 4);
                set("sharpness", 4);
                set("unique", 1);
                set("material", "steel");
                set("treasure",1);
                set("long", RED"此刀刀面如有火光流动，刀鞘上镶著“烈焰”两个古篆，乃是明教的镇教宝物，平时都供奉在光明宝塔之内。\n"NOR);
            }
        init_blade(80);
        setup();
}

