// shunu jian
// Modify By River
#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;
void create() {
  set_name(HIM "淑女剑" NOR, ({ "shunu jian", "shunu", "jian", "sword" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 50);
    set("rigidity", 2);
    set("sharpness", 5);
    set("treasure", 1);
    set("unique", 1);
    set("material", "steel");
    set("weapon_prop/dodge", 3);
    set("wield_maxneili", 1500);
    set("wield_str", 25);
    set("long", "此剑乌黑的剑身，没半点光泽，就似一段黑木。刻着淑女二字。与君子剑一般长短，全无二致。\n");
    set("wield_msg", HIM "$N缓缓抽出淑女剑，只觉轻飘飘无甚份量，到是一阵凉意凛然逼人，令人莫可忽视。\n" NOR);
    set("unwield_msg", HIM "$N画个剑势，将淑女剑缓缓插回剑鞘，当真风姿嫣然。\n" NOR);
  }
  init_sword(80);
  setup();
}

int wield() {
  object ob = environment();
  int ret;
  if (living(ob) && ob->query("gender") != "女性") {
    message_vision("$N拿出" + name() + "看了看，觉得还是女子更适合此剑。\n", ob);
    return 0;
  }
  if (living(ob) && ob->query("class") == "bonze") {
    message_vision("$N拿出" + name() + "看了看，觉得此剑怎么也不适合自己。\n", ob);
    return 0;
  }
  if (!query("weapon_prop/damage")) return 0;
  else if (ret = ::wield())
    return ret;
}
