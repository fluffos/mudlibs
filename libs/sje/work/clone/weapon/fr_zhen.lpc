#include <ansi.h>
#include <weapon.h>
inherit COMBINED_ITEM;
inherit THROWING;

void create()
{
        set_name(HIY"芙蓉金针"NOR, ({ "furong jinzhen","furong","jinzhen", "zhen" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("long", "这是一根细如头发的金针，出自武当派。\n");
               set("unit", "些");
               set("base_value", 2000);
               set("base_unit", "枚");
               set("base_weight", 10);
               set("material", "gold");
        }
        set_amount(31);
        init_throwing(40);

}

