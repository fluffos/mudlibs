// bow.c


#include <weapon.h>

inherit BOW;

void create() {
  seteuid(getuid());
  set_name("长弓", ({ "bow" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 500);
    set("material", "iron");

  }
  init_bow(50);
  setup();
}
