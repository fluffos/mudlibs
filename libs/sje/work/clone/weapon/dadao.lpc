// dadao.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
       set_name(HIW"大环刀"NOR, ({ "dadao","blade" }));
       set_weight(11000);
       if (clonep())
               set_default_object(__FILE__);
       else {
               set("unit", "柄");
               set("long", "这是一柄亮晃晃的大环刀。\n");
               set("value", 3000);
                set("rigidity", 1);
                set("sharpness", 1);
               set("material", "steel");
               set("wield_msg", "$N「唰」的一声从背后拨出一柄$n。\n");
               set("unwield_msg", "$N将手中的$n插回背后。\n");
       }
       init_blade(35);
       setup();
}

