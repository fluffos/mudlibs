// junzi jian 君子剑
// Modify By River
#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(HIW "君子剑" NOR, ({ "junzi jian", "junzi", "jian", "sword" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 50);
    set("rigidity", 2);
    set("sharpness", 5);
    set("unique", 1);
    set("treasure", 1);
    set("material", "steel");
    set("weapon_prop/dodge", 3);
    set("wield_maxneili", 1500);
    set("wield_str", 25);
    set("long", "此剑乌黑的剑身，没半点光泽，就似一段黑木。刻着君子二字。与淑女剑一般长短，全无二致。\n");
    set("wield_msg", HIW "$N缓缓抽出君子剑，只觉轻飘飘无甚份量，到是一阵凉意凛然逼人，令人莫可忽视。\n" NOR);
    set("unwield_msg", HIW "$N作个剑势，将君子剑缓缓插回剑鞘，当真气度非凡。\n" NOR);
  }
  init_sword(80);
  setup();
}

int wield() {
  object ob = environment();
  int ret;
  if (living(ob) && ob->query("gender") != "男性") {
    message_vision("$N拿出" + name() + "看了看，觉得还是男子更适合此剑。\n", ob);
    return 0;
  }
  if (living(ob) && ob->query("class") == "bonze") {
    message_vision("$N拿出" + name() + "看了看，觉得此剑怎么也不适合自己。\n", ob);
    return 0;
  }
  if (!query("weapon_prop/damage")) return 0;
  else if (ret = ::wield())
    return ret;
}
