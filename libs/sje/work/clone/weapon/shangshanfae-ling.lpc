#include <weapon.h>
#include <ansi.h>

inherit DAGGER;
inherit F_UNIQUE;
void create() {
  set_name(WHT "赏善罚恶令" NOR, ({ "shangshanfae ling", "ling", "dagger" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", WHT "这是两块闪闪发光的白铜牌子，一块牌上刻有一张笑脸，和蔼慈祥。\n" +
      "另一牌上刻的却是一张狰狞的煞神凶脸，显得十分诡异。\n" NOR);
    set("treasure", 1);
    set("unit", "对");
    set("value", 1000);
    set("unique", 1);
    set("rigidity", 4);
    set("sharpness", 4);
    set("weapon_prop/parry", 4);
    set("material", "bronze");
    set("wield_neili", 900);
    set("wield_maxneili", 1400);
    set("wield_str", 26);
    set("wield_msg", "$N从口袋中取出一对$n，握在手中。\n" NOR);
    set("unwield_msg", "$N将$n收回到口袋里。\n");
    set("amount", 2);
  }
  init_dagger(120);
  setup();
}

void init() {
  add_action("do_sub", ({ "fen", "分" }));
}

int do_sub() {
  object me, obj;
  me = this_player();
  obj = this_object();

  message_vision("$N将一对赏善罚恶令分为一块赏善令和一块罚恶令。\n", me);
  new(BINGQI_D("dagger/fae-ling"))->move(me, 1);
  new(BINGQI_D("dagger/shangshan-ling"))->move(me, 1);
  destruct(obj);
  return 1;
}
