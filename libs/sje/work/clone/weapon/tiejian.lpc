#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(CYN "铁剑" NOR, ({ "tie jian", "jian", "sword" }));
  set_weight(7500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄黑黝黝的铁铸短剑，剑身上刻着一行篆文【见此铁剑，如见东灵】。\n");
    set("value", 1500);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(45);
  setup();
}
