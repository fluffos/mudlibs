#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;
void create() {
  set_name(HIY "乾坤一气袋" NOR, ({ "yiqi dai", "dai" }));
  set_weight(1000);
  set_max_encumbrance(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("unique", 1);
    set("long", "这是一个布袋样的袋子。非绸非革，坚韧异常，摸上去\n"
      "布纹宛然，显是粗布所制，但撕上去却坚韧无比。\n");
    set("value", 10000);
    set("material", "silk");
    set("treasure", 1);
  }
  setup();
}
void init() {
  add_action("do_untie", "untie");
  add_action("do_free", "free");
  add_action("do_quit", "quit");
  //      add_action("do_put","put");
  add_action("do_catch", "catch");
}

int do_untie(string arg) {
  object me, obj;
  me = this_player();
  if (!arg)
    return notify_fail("你要解开什么？\n");
  if (!id(arg))
    return notify_fail("你要解开什么？\n");
  me->set_temp("marks/解1", 1);
  message_vision("$N十分熟练地解开了乾坤一气袋的死结。\n", me);
  return 1;
}
int do_free(string arg) {
  object me, obj;
  int i;
  me = this_player();

  if (me->query_temp("marks/解1")) {
    if (!arg) return notify_fail("你要放谁出来？\n");

    obj = present(arg, this_object());
    if (!obj) return notify_fail("袋子里面没有这样东西。\n");

    message_vision("$N的把$n从乾坤一气袋中放了出来。\n", me, obj);
    obj->move(environment(me));
    me->delete_temp("marks/解1");
  } else write("袋子还没有解开，人怎么能放出来？\n");
  return 1;
}

int do_quit() {
  object ob = this_player();

  if (present(ob, this_object())) {
    write("现在不能退出游戏。\n");
    return 1;
  }
  return 0;
}

int do_catch(string arg) {
  object me, obj, dest;
  string item, target;
  me = this_player();
  if (!arg)
    return notify_fail("你要把谁装进乾一气袋里？\n");
  if (sscanf(arg, "%s to %s", item, target) != 2) return 0;
  if (target != "yiqi dai" && target != "dai")
    return 0;
  dest = present(target, me);
  obj = present(item, me);
  if (!obj)
    return notify_fail("你要将什么东西丢到装进袋里？\n");
  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是生物。\n");
  if (userp(obj))
    return notify_fail("你不能把玩家关在袋子里面！！\n");
  if (obj->query("unique"))
    return notify_fail("你不能把这样东西放在袋子里面！！\n");
  if (present(obj, dest))
    return notify_fail("袋子里面已经有这样东西了！\n");
  if (!living(obj)) {
    obj->set_temp("marks/装1", 1);
    message_vision("$N手足麻利的把$n装进乾坤一气袋中。\n", me, obj);
    obj->remove_call_out("revive");
    obj->revive();
    obj->reincarnate();
    obj->move(dest);
  }
  return 1;
}
