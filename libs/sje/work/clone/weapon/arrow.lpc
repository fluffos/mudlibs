// arrow.c

#include <weapon.h>

inherit ARROW;

void create() {
  seteuid(getuid());
  set_name("雕翎箭", ({ "arrow" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "雕翎箭是一种十分常见的远攻兵器。\n");
    set("unit", "些");
    set("base_unit", "枝");
    set("value", 5);
    set("base_weight", 40);
    set("base_value", 5);
  }
  set_amount(1);
  init_arrow(20);
  setup();
}
