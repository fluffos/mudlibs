// /clone/board/movedata_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name("新玩家move data的留言板", ({ "board" }));
  set("location", "/u/river/room/muwu");
  set("board_id", "movedata_b");
  set("long", "这是一块供北京玩家想move data所使用的留言板。\n");
  setup();
  set("capacity", 200);
}

int do_read(string arg) {
  if (!wizardp(this_player()))
    return notify_fail("只有巫师才可以在这里看留言。\n");

  return ::do_read(arg);
}

int do_list(string arg) {
  if (!wizardp(this_player()))
    return notify_fail("只有巫师才可以在这里看留言。\n");

  return ::do_list(arg);
}
