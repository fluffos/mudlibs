#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIC "东方青云留言板" NOR, ({ "board" }));
  set("location", "/u/qingyun/workroom");
  set("board_id", "qingyun_b");
  set("long", "这是一个东方青云专门使用使用的留言板。\n");
  setup();
  set("capacity", 200);
  replace_program(BULLETIN_BOARD);
}
