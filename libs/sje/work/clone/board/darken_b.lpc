#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name(HIY"柳随风的留言板"NOR, ({ "board" }) );
        set("location", "/u/darken/workroom");
        set("board_id", "darken_b");
        set("long", "这是一个柳随风用的留言板。\n" );
        setup();
        set("capacity", 100);
}

int do_read(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能偷看巫师的留言。\n"NOR);

        return ::do_read(arg);
}

int do_list(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能偷看巫师的留言。\n"NOR);

        return ::do_list(arg);
}

int do_post(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能在巫师的留言板上乱写。\n"NOR);

        return ::do_post(arg);
}

int do_discard(string arg)
{
        if (this_player()->query("id")!="darken")
                return notify_fail(HIR"想删柳随风的留言？\n"NOR);

        return ::do_discard(arg);
}
