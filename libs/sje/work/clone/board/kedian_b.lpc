// /clone/board/kedian_b.c

#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIR "千禧年" HIY "·" HIM "春节快乐" HIY "·" HIC "留言板" NOR, ({ "board" }));
  set("location", "/d/city/kedian");
  set("board_id", "kedian_b");
  set("long", "有有用的话就往这里说，乱灌水杀无赦。\n");
  setup();
  set("capacity", 400);
}
