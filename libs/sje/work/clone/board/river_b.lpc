// /clone/board/wiz_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name(HIY"墨云子的留言板"NOR, ({ "board" }) );
        set("location", "/u/river/workroom");
        set("board_id", "river_b");
        set("long", "这是一个墨云子专门使用的留言板。\n" );
        setup();
        set("capacity", 200);
}

int do_read(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能偷看巫师的留言，嘿嘿。\n"NOR);

        return ::do_read(arg);
}

int do_list(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能偷看巫师的留言，嘿嘿。\n"NOR);

        return ::do_list(arg);
}

int do_post(string arg)
{
        if (!wizardp(this_player()))
                return notify_fail(HIR"你不能在巫师的留言板上乱写，嘿嘿。\n"NOR);

        return ::do_post(arg);
}

int do_discard(string arg)
{
        if (this_player()->query("id")!="river")
                return notify_fail(HIR"你不能乱删墨云子家的留言，嘿嘿。\n"NOR);

        return ::do_discard(arg);
}