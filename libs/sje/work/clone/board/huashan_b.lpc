// /clone/board/hs_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("华山弟子留言簿", ({ "board" }) );
        set("location", "/d/huashan/qianting.lpc");
        set("board_id", "hs_b");
        set("long", "这是一个供华山弟子交流的留言板。\n" );
        setup();
        set("capacity", 60);
        replace_program(BULLETIN_BOARD);
}

