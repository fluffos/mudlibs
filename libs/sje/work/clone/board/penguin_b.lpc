// 乐随风音乐室留言版

inherit BULLETIN_BOARD;
#include <ansi.h>

void create()
{
        set_name(HIR "乐随风音乐留言版" NOR, ({ "board" }) );
        set("location", "/u/penguin/workroom");
        set("board_id", "penguin_b");
        set("long", "这是乐随风的音乐留言版。上面除了记录有乐随风对桃花岛的计划及展望等空谈文章外，\n"
"更不时有乐随风精心挑选的歌词、音乐推介等！\n" );
        setup();
        set("capacity", 400);
        replace_program(BULLETIN_BOARD);
}

