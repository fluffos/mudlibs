// /clone/drug/shedan.c

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("蛇胆", ({"mangshe dan"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("value", 1500);
		set("make/drug", 1);
        }
	setup();
}
