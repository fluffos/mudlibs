// /clone/drug/badou.c

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "巴豆" NOR, ({ "ba dou" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("value", 1000);
    set("medicine", "drug");
    set("make/drug", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  return notify_fail("你不怕吃了拉肚子？\n");
}
