// yulong.c 回阳玉龙膏

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("回阳玉龙膏", ({ "yulong san", "san", "yulong" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "这是一包治伤灵药。是崆峒派赠于明教的。\n");
    set("value", 5000);
    set("medicine", "drug");
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你没有受任何的内外伤，不需要用药。\n");
  else {
    this_player()->receive_curing("qi", 50);
    message_vision("$N吃下一包回阳玉龙膏，气色看起来好多了。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
