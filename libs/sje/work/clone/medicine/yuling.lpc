// yuling.c 玉灵散

inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name("玉灵散", ({"yuling san", "san", "yuling"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "包");
		set("long", "这是一包伤科圣药。\n");
		set("value", 10000);
               set("medicine", "drug");
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
		return notify_fail("你要吃什么药？\n");
	if ((int)this_player()->query("eff_qi") == 
	    (int)this_player()->query("max_qi"))
		return notify_fail("你没有受任何的内外伤，不需要用药。\n");
	else {
		this_player()->receive_curing("qi", 150);
		message_vision("$N吃下一包玉灵散，气色看起来好多了。\n", this_player());
		destruct(this_object());
		return 1;
	}
}

