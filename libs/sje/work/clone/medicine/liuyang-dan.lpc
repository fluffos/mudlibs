//wuchangdan.c
#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIR "六阳正气丹" NOR, ({ "zhengqi dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIR "这是一颗殷红如血的六阳正气丹，经药王院高僧精心练制，
        解寒毒，疗绝症有起死回生之功。\n" NOR);
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  int fw, cn;
  int force_limit, neili_limit, force_skill, add_skill, improve;

  object me = this_player();

  force_limit = me->query_skill("force") * 10;
  neili_limit = me->query("max_neili");
  force_skill = me->query_skill("force", 1);

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)me->query_condition("medicine") > 0) {
    message_vision(HIR "$N吃下一颗六阳正气丹，只觉得热气直冲头顶，原来与你以前所服丹药药性相左！\n" NOR, me);
    me->set("jing", me->query("max_jing") / 10);
    me->set("eff_jing", me->query("max_jing") / 10);
    me->set("qi", me->query("max_qi") / 10);
    me->set("eff_qi", me->query("max_qi") / 10);
    me->apply_condition("medicine", 60);
    destruct(this_object());
  } else {
    me->set("jing", me->query("max_jing"));
    me->set("eff_jing", me->query("max_jing"));
    me->set("qi", me->query("max_qi"));
    me->set("eff_qi", me->query("max_qi"));
    me->set("neili", me->query("max_neili"));
    message_vision(HIR "$N吃下一颗六阳正气丹，顿时一股热气直透心底！\n" NOR, me);
    me->apply_condition("medicine", 60);
    cn = (int)me->query_condition("medicine");
    tell_object(me, "你的服药限制是" + cn + "\n");
    if ((int)me->query_condition("sl_poison") > 0 || (int)me->query_condition("man_poison") > 0) {
      me->apply_condition("man_poison", 0);
      me->apply_condition("sl_poison", 0);
    }
    destruct(this_object());

  }
  return 1;
}
