// /clone/drug/jia.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(YEL "穿山甲" NOR, ({ "chuanshan jia" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 10000);
    set("medicine", "drug");
    set("make/drug", 1);
  }
  setup();
}
