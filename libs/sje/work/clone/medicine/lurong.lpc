// /clone/drug/lurong.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "鹿茸" NOR, ({ "lu rong" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("value", 5500);
    set("medicine", "drug");
    set("make/drug", 1);
  }
  setup();
}
