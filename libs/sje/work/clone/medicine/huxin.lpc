// huxin.c 天王护心丹

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("天王护心丹", ({ "huxin dan", "dan", "huxin" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗治伤灵药。是武当派赠于明教的。\n");
    set("value", 5000);
    set("medicine", "drug");
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你没有受任何的内外伤，不需要用药。\n");
  else {
    this_player()->receive_curing("qi", 60);
    message_vision("$N吃下一颗天王护心丹，气色看起来好多了。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
