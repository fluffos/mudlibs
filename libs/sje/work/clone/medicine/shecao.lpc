// /clone/drug/shecao.c

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIW"白花蛇舌草"NOR, ({"baihua sheshecao"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "株");
                set("value", 1500);
                set("medicine", "drug");
		set("make/drug", 1);
        }
	setup();
}
