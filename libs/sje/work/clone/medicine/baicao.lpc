// /clone/drug/baicao.c

#include <ansi.h>
inherit ITEM;

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"百草丹"NOR, ({"baicao dan", "dan"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("heal_up", 1);
                set("value", 1500);
                set("medicine", "drug");
		set("make/drug", 1);
        }
	        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        if ((int)this_player()->query("eff_qi") == 
            (int)this_player()->query("max_qi"))
                return notify_fail("身体好好的没事吃什么药？\n");
        else {
                this_player()->receive_curing("qi", 90);
                message_vision("$N吃下一颗百草丹，伤口的鲜血逐渐被止住了。\n", this_player());
                return 1;
        }
}
