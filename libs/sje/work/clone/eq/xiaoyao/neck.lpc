 // eq lv 35
// lv35 eq  

#include <ansi.h>
#include <armor.h>

inherit NECK;

void create()
{
        set_name( HIY"逍遥"HIG"·"HIC"之坠"NOR, ({ "xiaoyao zhizhui", "zhizhui", "neck", "xiaoyao" }) );
        set("long",
"你看到的这套装备泛出淡淡的黄光，所用的质料则是由光明右使从西域带回\n"+
"丝的来的天蚕丝所织成的，摸起来相当的柔软重量也相当的轻，也由于是蚕\n"+
"度，质料所以看起来就不怎么厚，穿起后冬暖夏凉，甚至可减低体力消耗程\n"+
"而光明左右二使，两人在为明教出征时都是穿这套装备而战的。\n");
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("material", "jade");
                set("value", 850);
                set("wear_maxneili", 3500);
                set("unique", 3);
                set("wear_str", 28);
        }
        setup();
}


