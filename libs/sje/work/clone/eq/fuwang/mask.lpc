 // eq lv 35

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name( HIG"蝠王"HIR"·"HIC"面罩"NOR, ({ "fuwang mianzhao", "mask" ,"mianzhao", "fuwang" }) );
        set("long", 
"这套装备是起源于明教六大法王之一的青翼蝠王身上，从头到脚一应俱全，\n"+
"穿上这套装备顿时身轻如燕，方可飞檐走壁，做草上飞水上飘之事，当年韦\n"+
"一笑得以博得『青翼蝠王』之美名，有一半功劳得靠这副行头。你看到的这\n"+
"部份是保护面门的套头护罩。\n");
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "付");
                set("material", "cloth");
                set("value", 800);
                set("armor_prop/armor", 3);
                set("unique", 3);
                set("wear_maxneili", 3000);
                set("wear_str", 24);
        }
        setup();
}
