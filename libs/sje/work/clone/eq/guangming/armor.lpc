#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( HIC"大云光明护甲"NOR, ({ "guangming hujia", "armor" ,"hujia" }) );
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 1330);
                set("armor_prop/armor", 40);
                set("armor_prop/dodge", -5);
                set("wear_maxneili", 700);
                set("wear_str", 20);
        }
        setup();
}

