#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create() {
  set_name(HIC "大云光明护盾" NOR, ({ "guangming hudun", "shield", "hudun" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("material", "steel");
    set("value", 1270);
    set("armor_prop/armor", 3);
    set("armor_prop/dodge", -2);
    set("wear_maxneili", 700);
    set("wear_str", 20);
  }
  setup();
}
