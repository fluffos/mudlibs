#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(HIC "大云光明护袍" NOR, ({ "guangming hupao", "cloak", "hupao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 1360);
    set("armor_prop/armor", 3);
    set("armor_prop/dodge", 2);
    set("wear_maxneili", 700);
    set("wear_str", 20);
  }
  setup();
}
