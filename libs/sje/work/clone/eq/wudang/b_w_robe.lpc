// OBJ : /d/wudang/obj/b_w_robe.c 双色道袍
// By lius 99/8

#include <ansi.h> 
#include <armor.h> 
 
inherit CLOTH;
inherit F_UNIQUE; 
 
void create() 
{ 
        set_name( WHT"双色"HIC"道袍"NOR, ({ "shuangse daopao", "daopao", "pao" }) ); 
        set_weight(4000); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "件"); 
                set("long", "一件黑白相间的道袍，做工巧妙得体，显见制作者独具匠心，似乎颇有深意。\n"
                            "只是。。。。嘿嘿好象已许久没有清水关顾，甚是邋遢龌蹰。\n"); 
                set("value", 1000000); 
                set("material", "cloth");
                set("unique", 1); 
                set("armor_prop/armor", 100);
                set("wear_msg", WHT "只听“呼”的一声，$N已展开一件黑白相间的道袍，披在身上。\n" NOR);
                set("remove_msg", WHT "$N一转身，抓住袍领微微一抖，已将一件双色道袍轻轻放在了左手臂弯。\n" NOR);
        } 
        setup(); 
} 

int wear()
{
        object ob = environment();
        int wr;

        if (living(ob) && ob->query("family/family_name") != "武当派" ){
        message_vision("$N将道袍披在身上，顿觉浑身不自在，赶忙脱了下来。\n", ob);
                return 0;
                }   
        if (living(ob) && ob->query_int() < 32){
        message_vision("$N愣愣地看着这件双色道袍，唯觉其甚为奇异，却始终不明白他的妙用所在。\n", ob);
                return 0;
                }
        else if (wr=::wear())
        return wr;
}

