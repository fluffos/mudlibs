// OBJ : /d/wudang/obj/zizhuguan.c 紫竹道冠
// By lius 99/8

#include <ansi.h> 
#include <armor.h> 
 
inherit HEAD;
inherit F_UNIQUE; 
 
void create() 
{ 
        set_name( MAG "紫竹道冠" NOR, ({ "zizhu daoguan", "daoguan", "guan" }) ); 
        set_weight(1000); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "顶"); 
                set("long", "一顶不知用何种竹物做成的道冠，质地古朴如玉。\n"); 
                set("value", 100); 
                set("material", "bamboo");
                set("unique", 1); 
                set("armor_prop/armor", 50);
                set("wear_msg", MAG "$N认认真真的将紫竹道冠扎在头上，端的是气度非凡！\n" NOR);
                set("remove_msg", MAG "$N小心翼翼的解开系冠索，将紫竹道冠捧在手上。\n" NOR);
        } 
        setup(); 
} 
int wear()
{
        object ob = environment();
        int wr;

        if (living(ob) && ob->query("family/family_name") != "武当派" ){
        message_vision("$N把头上的紫竹道冠推了推，终于发现无论自己怎么打
扮也不象个道者，只好无奈的取了下来。\n", ob);
                return 0;
                }        
        else if (wr=::wear())
        return wr;
}
