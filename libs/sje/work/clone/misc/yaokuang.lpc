// yaoguang.c 药筐

inherit ITEM;

void create() {
  set_name("药筐", ({ "yao kuang", "kuang", "yaokuang" }));
  set_weight(500);
  set_max_encumbrance(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只用来采药的药筐，。\n");
    set("value", 0);
  }
}

int is_container() {
  return 1;
}
