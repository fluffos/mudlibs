#include <ansi.h> 
#include <armor.h> 
 
inherit HEAD; 
 
void create() 
{ 
        set_name( YEL"朱雀之眼"NOR , ({ "phoenix eye","eye" }) ); 
        set_weight(800); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "具"); 
                set("long", YEL"这是一具形状怪异的头盔。"NOR"
防御指数：一十
成套装备："HIR"[朱雀之舞]"NOR" "RED"朱雀之羽"NOR" "YEL"朱雀之眼"NOR" "GRN"朱雀之爪"NOR" "HIC"朱雀之翼"NOR"
特殊效果："HIG"极品思维(int)"NOR"\n");
                set("value", 150000); 
                set("material", "head"); 
                set("armor_prop/intelligence",2);
		  set("armor_prop/armor", 10);
               
        } 
        setup(); 
} 
