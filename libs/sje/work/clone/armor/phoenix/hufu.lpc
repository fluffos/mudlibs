// head.c
// 朱雀之舞 [灵异]
// 成套装备
// by sunyf@sj2
#include <ansi.h>



inherit ITEM;
//int do_jixiang();


void create() {
  set_name(HIC "[朱雀之符]" NOR, ({ "hufu" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set(
      "long",
      HIC "这是一块朱雀之符，虽然本身没什么用，但是能唤醒朱雀之舞的潜能。" NOR "
成套装备指令：" HIG "huanxing" NOR "
成套装备：" HIR "[朱雀之舞]" NOR " " RED "朱雀之羽" NOR " " YEL "朱雀之眼" NOR " " GRN "朱雀之爪" NOR " " HIC "朱雀之翼" NOR "
成套效果：" HIG "唤醒体内潜在的力量" NOR "\n"
    );
    set("value", 100000);
    set("no_steal", 1);
    set("no_beg", 1);
    set("no_get", 1);
    set("no_give", 1);


    set("material", "crystal");
    set("power", 305);
  }
  setup();
}

void init() {
  add_action("do_jx", "huanxing");
}
int do_jx() {
  object jia, head, shoe, pifeng;

  object me = this_player();
  object ob = this_object();

  if (ob->query("power") < 1)
    return notify_fail("这张符已经没有能量了！\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢!\n");
  if (!jia = present("phoenix armor", me))
    return notify_fail("你还缺少" RED "朱雀之羽" NOR "\n");
  if (!head = present("phoenix eye", me))
    return notify_fail("你还缺少" YEL "朱雀之眼" NOR "\n");
  if (!shoe = present("phoenix shoes", me))
    return notify_fail("你还缺少" GRN "朱雀之爪" NOR "\n");
  if (!pifeng = present("phoenix wing", me))
    return notify_fail("你还缺少" HIC "朱雀之翼" NOR "\n");
  if (environment(this_object()) != me)
    return notify_fail("护符现在不能发挥作用。\n");



  if ((jia->query("equipped") != "worn") || (head->query("equipped") != "worn") || (pifeng->query("equipped") != "worn") || (shoe->query("equipped") != "worn"))
    return notify_fail("你必须要穿上一整套" HIR "[朱雀之舞]\n" NOR);
  if (me->query_temp("lingyieff"))
    return notify_fail("你已经开始呼应[朱雀之舞]了！\n");


  message_vision("$N将" HIC "[朱雀之符]" NOR "贴在" HIR "[朱雀之舞]" NOR "上，
顿时感到身体轻盈起来，背后隐隐出现了一只展翅高飞的凤凰！！\n" NOR, me);
  me->add_temp("apply/dexerity", 10);
  me->set_temp("lingyieff", 1);


  ob->set("no_drop", 1);
  ob->add("power", -1);
  call_out("lingyieff", 3, me);
  return 1;
}


void lingyieff(object me) {
  object jia, head, shoe, pifeng;
  object ob = this_object();
  if (!me || !me->is_character()) return;

  if (!me->query_temp("lingyieff")) return;
  if (
    (ob->query("power") < 1)
    || (!jia = present("phoenix armor", me))
    || (!head = present("phoenix eye", me))
    || (!shoe = present("phoenix shoes", me))
    || (!pifeng = present("phoenix wing", me))
    || (environment(this_object()) != me)
    || (!this_object())
    || (!objectp(this_object()))

    || (pifeng->query("equipped") != "worn")

    || (jia->query("equipped") != "worn")
    || (head->query("equipped") != "worn")
    || (shoe->query("equipped") != "worn")
  ) {
    if (living(me))
      message_vision(HIG "突然$N身上放出光芒，$N感到好象力量在渐渐失去。\n" NOR, me);
    me->add_temp("apply/dexerity", -10);

    me->delete_temp("lingyieff");
    ob->delete("no_drop");
  } else {

    ob->add("power", -1);
    me->add_temp("lingyieff", 1);
    call_out("lingyieff", 3, me);

  }

}
