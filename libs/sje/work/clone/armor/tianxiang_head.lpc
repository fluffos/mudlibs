// by keinxin@sj2

#include <armor.h>
#include <ansi.h>

inherit HEAD;
#include "chk_owner.lpc"

void create()
{
   set_name(HIG"天翔头盔"NOR, ({ "tianxiang toukui", "toukui" }) );
   set_weight(300);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
set("long", HIG"这是一件由上等翠玉制成的头盔。"NOR"
防御指数：一千
成套装备：由 "HIC"[天祥防具]"NOR" 合成
要求：转生(1转)以上
特殊效果："HIG"天灵(int)"NOR"\n");     
     set("no_sell",1);
     set("value",100000);
     set("material", "crystal");
     set("wear_msg", BBLU+HIG "$N戴上一块翠玉制成的头盔。
瞬时间日月为之失色，瑞气千条，祥云朵朵，一派庄严气象。\n" NOR);
     set("remove_msg", HIG "$N将翠玉制成的头盔从头上除了下来。\n" NOR);     
     set("armor_prop/armor",1000);
     set("armor_prop/intelligence",10);
  }
   setup();
}
int query_autoload() { return 1; }
