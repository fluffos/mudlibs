// shishugang.c史叔刚

inherit NPC;

void create() {
  set_name("史叔刚", ({ "shi shugang", "shi", "shugang" }));
  set("nickname", "金甲狮王");
  set("long",
    "他就万兽山庄五兄弟的老三，脸色略微发黄，似是久病初愈的样子。\n"
    "据说曾得异人传授一身精湛的功夫。\n");
  set("gender", "男性");
  set("age", 29);
  set("attitude", "friendly");
  set("shen", 6500);
  set("str", 22);
  set("int", 20);
  set("con", 23);
  set("dex", 23);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1300);
  set("max_neili", 1300);
  set("jiali", 80);
  set("combat_exp", 650000);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "strike.diezhang" :)
  }));


  set_skill("force", 100);
  set_skill("xuantian-wuji", 110);
  set_skill("dodge", 100);
  set_skill("kunlun-shenfa", 110);
  set_skill("strike", 100);
  set_skill("kunlun-zhang", 110);
  set_skill("parry", 100);
  set_skill("literate", 50);

  map_skill("force", "xuantian-wuji");
  map_skill("dodge", "kunlun-shenfa");
  map_skill("strike", "kunlun-zhang");
  map_skill("parry", "kunlun-zhang");
  prepare_skill("strike", "kunlun-zhang");

  set("inquiry", ([
    "神雕侠": "全仗他老人家我的内伤才得以康复。",
    "霍都": "再要见到那个狗贼，一定要杀了他。",
    "御兽": "此技为我们兄弟祖传之术，武功若无小成，学习甚是危险。",

  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
  //        add_money("gold", 10);
}
