inherit NPC;

string *names = ({
       "居民",
       "老百姓",
       "农妇",
       "路人",
       "农夫", 
       "游客",
       "和尚",
       "道士",
});

string *ids = ({
       "ju min",
       "lao baixing",
       "nong fu",
       "lu ren",
       "nong fu",
       "you ke",
       "he shang",
       "dao shi",
});

string *genders = ({
       "男性",
       "男性",
       "女性",
       "男性",
       "男性",
       "男性",
       "男性",
       "男性",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set("gender", genders[i]);
  set("combat_exp", 1000+random(1000));
  set("age", 20+random(20));
  set("per", 14+random(20));
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("force_factor",2);
  set("max_qi",200+random(200));
  set("max_jing",200+random(200));
  set("eff_jingli",200+random(200));
  set("jingli",300+random(200));
  set("max_neili",300+random(200));
  set("neili",300+random(200));
  set_skill("unarmed", 10+random(90));
  set_skill("dodge", 10+random(90));
  set_skill("parry", 10+random(90));
  set("chat_chance", 3);
  set("chat_msg", ({ (: random_move :) }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 1+random(4));

}


