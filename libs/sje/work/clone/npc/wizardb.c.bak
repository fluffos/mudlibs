// wizardb.c


inherit NPC;

#include <ansi.h> 
string ask_gogogo();
string ask_sign();
string fenglu();

string gift_apply()
{
object me = this_player();
object ob = this_object();
 
        if (me->query("礼物申请")>0)
        return RANK_D->query_respect(this_player()) + "你已经申请过了。";
        if (me->query("combat_exp")<40000)
        return RANK_D->query_respect(this_player()) + "你的江湖经验太少，不能给你礼物。";        
        if (!query("apply"))
        return RANK_D->query_rude(this_player()) + "现在不准申请礼物！";          
command ("hoho " + me->query("id")); 
message_vision(HIY "巫师念起咒语，一团金光包围了$N，不知道会发生什么事情。\n"NOR, me);
me->set("礼物申请",1);
command ("chat "+me->query("name")+"的礼物申请完成，等等可以领取礼物。 ");  
return "申请好了";
}

string gift_send()
{
int exp,pot;
object me = this_player();
object ob = this_object();
object gift;
        exp = 3000+random(3000); 
	      pot = exp/3; 
        if (me->query("礼物申请")<1)
        return RANK_D->query_respect(this_player()) + "你好像没有申请过礼物。";
        if (!query("send"))
        return RANK_D->query_rude(this_player()) + "现在不是发放礼物时间。";          
command ("hoho " + me->query("id")); 
message_vision(HIY "巫师念起咒语，一团金光包围了$N，不知道会发生什么事情。\n"NOR, me);
me->delete("礼物申请");
        gift = new("/quest/shenshu/sdan");
        gift->move(me);
        gift = new("/quest/shenshu/sdan");
        gift->move(me);   
        gift = new("/d/xiangyang/job/jinhe");
        gift->move(me);       
	this_player()->add("combat_exp",exp);
	this_player()->add("potential",pot);        
	tell_object(me,HIY"你被奖励了：             \n" +
	     "两颗九转金丹，一个檀木锦盒\n"+
             chinese_number(exp) + "点实战经验\n"+
             chinese_number(pot) + "点潜能\n"NOR);      
command ("chat "+me->query("name")+"的礼物已经由本人领取。 ");                           
return "节日快乐！";
}

int ask_name();
int ask_guild();
void create()
{
        set_name("巫师",({ "wizard", "wizard", "wushi", "wushi" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "这是一个成天无所事事的巫师。\n");

        set("str", 17);
        set("dex", 16);
        set("con", 15);
        set("int", 17);
        set("shen_type", 1);
        set_temp("apply/defense", 10);
        set("combat_exp", 100);
        set("attitude", "peaceful");

        setup();

        set("inquiry", ([
                "name": (: ask_name :),
                "参加屠人pk大赛" : (: ask_gogogo :),
                "屠人pk大赛报名" : (: ask_sign :),
                "keinxin": "见到帮主我，难道没有任何表示吗？",
                "基金" :  (: fenglu :),
//              "建帮": (:ask_guild :),
                "剑心": "帮主，难道没有任何表示吗？",
                "节日礼物申请" :  (: gift_apply :),
                "领取节日礼物" :  (: gift_send :),
        ]) );

        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	add_action("do_turen","turen");
        add_action("do_gift","gift");	
	::init();
}

string fenglu()
{
        object ob=this_player();
        mapping fam = ob->query("family");
        int gold;       
        if (ob->query("combat_exp")<160000)
           return "这位"+ RANK_D->query_respect(ob) +"你经验不足，等过段时间来拿吧。";
        if (ob->query("fenglu") && ob->query("fenglu") >= ob->query("age"))
           return "你这个"+RANK_D->query_rude(ob) +"今年不是已经拿过基金了，怎么还想来拿？";        
         ob->set("fenglu",ob->query("age"));         
         command ("step " + ob->query("id"));  
         command ("knock " + ob->query("id"));       
         gold=(int)(ob->query_skill("force",1)*20000);
         ob->add("balance",gold);
         return "这是你一年的基金，已经存到你的钱庄账户了，这位"+ RANK_D->query_rude(ob) +"今年不要让我再看到你！";         
} 


string ask_gogogo()
{
object me = this_player();
object ob = this_object();
 
        if (me->query("pk大赛报名")<1)
        return RANK_D->query_respect(this_player()) + "你好像没有报名吧？";
        if (!query("bisai"))
        return RANK_D->query_rude(this_player()) + "急什么？还没有开始入场呢！";          
command ("hoho " + me->query("id")); 
message_vision(HIY "巫师念起咒语，一团金光包围了$N，不知道会发生什么事情。\n"NOR, me);
me->delete("pk大赛报名");
me->move("/d/pk/zongtai");
return "到了";
}

string ask_sign()
{
object me = this_player();
object ob = this_object();

        if (me->query("combat_exp")<100000)
        return RANK_D->query_respect(this_player()) + "你好像还不够资格。";
   
        if (me->query("pk大赛报名")>0)
        return RANK_D->query_respect(this_player()) + "你好像已经报过名了吧。";
        if (!query("baoming"))
        return RANK_D->query_rude(this_player()) + "对不起，报名已经结束了！";                  
command ("hoho " + me->query("id")); 
message_vision(HIY "巫师念起咒语，一团金光包围了$N，不知道会发生什么事情。\n"NOR, me);
me->add("pk大赛报名",1);
return "报名完成";
}


int ask_name()
{
        object ob = this_player();

        command("smash " + ob->query("id"));
        say("没搞错吧？一声不吭就smash别人？准是午夜。\n");
        return 1;
}

int ask_guild()
{
        object ob = this_player();
        int exp = ob->query("combat_exp");
        if ( exp > 2000000 && ( !present("lingpai",ob))  )
        {
//          new("/data/group/obj/ling")->move(ob);  令牌没有,idle
                say("巫师说道：把令牌拿去吧。\n");
        }
//      if ( exp < 2000000 )
//              say("巫师说道：你的经验不够，暂时不能创建帮派。\n");
//      if ( present("lingpai",ob))
//              say("巫师说道：你已经有令牌了。\n");
        else    say("巫师说道：条件不符合，不能创建帮派。\n");
        return 1;
}

int do_turen()
{
	object me = this_player();
        object ob = this_object();
	if (ob->query("baoming")) return 0;
	if (ob->query("bisai")) return 0;        
	if (me->query("id")!="keinxin") return 0;
	message_vision(HIW"巫师说道：验证身份……keinxin……确认，嘀……。\n"NOR, me);	
	command ("chat 接到keinxin通知，现在进行屠人pk大赛报名。详细看help turen。 ");  
	command ("chat 大赛中的死亡不会有惩罚。 ");  
	command ("chat 4号看台将做实况转播 ");  
	call_out("count_bm", 60, 5);
	ob->set("baoming",1);
	ob->delete("bisai");
	return 1;
}

int do_gift()
{
	object me = this_player();
        object ob = this_object();
	if (ob->query("apply")) return 0;
	if (ob->query("send")) return 0;        
	if (me->query("id")!="keinxin") return 0;
	message_vision(HIW"巫师说道：验证身份……keinxin……确认，嘀……。\n"NOR, me);	
	command ("chat 接到keinxin通知，现在开始节日礼物申请工作。 ");  
	command ("chat 所有player请到我这里ask wizard about 节日礼物申请 来申请，等等可以领取礼物。");  
	command ("chat 不申请的不能领取礼物。 ");  
	call_out("count_apply", 60, 15);
	ob->set("apply",1);
	return 1;
}

void count_bs(int min2)
{
	object me = this_player();
        object ob = this_object();
        ob->set("bisai",1);
        min2--;
        if( min2 ){
                call_out("count_bs", 60, min2);
        command ("chat 接到keinxin通知，屠人pk大赛马上就要开始。详细看help turen。 ");  
	command ("chat 请报过名的选手到我这里传送到比赛地点。ask wushi about 参加屠人pk大赛。 ");  
	command ("chat 4号看台将做实况转播 ");  
	command ("chat 现在离入场结束还有" + chinese_number(min2) + "分钟 ");  
          } else {
                  message("system", HIW  "\n【比赛】巫师：pk大赛入场传送结束，比赛正式开始！\n"NOR, users() );   
	          ob->delete("baoming"); 
	          ob->delete("bisai");           
               }
}

void count_send(int min4)
{
	object me = this_player();
        object ob = this_object();
        ob->set("send",1);
        min4--;
        if( min4 ){
                call_out("count_send", 60, min4);
	command ("chat 请刚才申请过礼物的player来巫师会客室领取礼物。ask wizard about 领取节日礼物 ");  
	command ("chat 现在离礼物发放结束还有" + chinese_number(min4) + "分钟 ");  
          } else {
                  message("system", HIW  "\n【通告】巫师：节日礼物发放完毕，[书剑贰巫师]组祝大家节日快乐！\n"NOR, users() );   
	          ob->delete("apply"); 
	          ob->delete("send");           
               }
}

void count_bm(int min)
{
        object ob = this_object();
        min--;
        if( min ){
                message("system", HIG "\n【比赛】巫师：" + chinese_number(min) + "分钟后屠人pk大赛报名结束！开始入场传送。\n"NOR, users() );  
                call_out("count_bm", 60, min);
          } else {
               call_out("count_bs", 1, 5);
               ob->delete("baoming");      
               }
}             

void count_apply(int min3)
{
        object ob = this_object();
        min3--;
        if( min3 ){
                message("system", HIG "\n【通告】巫师：" + chinese_number(min3) + "分钟后礼物申请结束！开始发送礼物。请快来巫师会客室申请！！\n"NOR, users() );  
                call_out("count_apply", 60, min3);
          } else {
               call_out("count_send", 60, 2);
               ob->delete("apply");      
               }
}            