// zu qianqiu 祖千秋

#include <ansi.h>;
inherit NPC;
inherit F_VENDOR;
string ask_book();
void destroy(object ob);
void create()
{
        set_name("祖千秋", ({ "zu qianqiu", "zu", "qianqiu" }));
        set("long", "一个衣衫褴偻的落魄书生。焦黄脸皮，一个酒糟鼻，疏疏落落的几根胡子，\n"+
                    "两眼无神。衣衫上一片油光，右手拿了一把破折扇。\n");
        set("title",HIW"黄河老祖"NOR);
        set("str", 40);
        set("con", 30);
        set("int", 28);
        set("dex", 33);
        set("per",  3);
        set("gender", "男性");
        set("unique", 1);
        set("age", 51);
        set("jing", 800);
        set("max_jing", 800);
        set("neili", 2100);
        set("max_neili", 2100);
        set("eff_jingli", 1050);
        set("jingli", 1050);
        set_skill("unarmed", 180);
        set_skill("dodge", 180);
        set_temp("apply/attack", 55);
        set_temp("apply/attack", 43);
        set_temp("apply/damage", 32);

        set("combat_exp", 350000);
        set("attitude", "friendly");
        set("vendor_goods", ([
              "/clone/medicine/mahuang" :8,
              "/clone/medicine/niuhuang" :7,
              "/clone/medicine/shecao" :7,
              "/clone/medicine/shadan" :6,
              "/clone/medicine/sangye" :11,

        ]));
        
        set("inquiry", ([
                "归元丹" : "祖千秋叹了口气：这玩意儿我吃了太多。。。嗳！没想到。。。\n",
                "养心丸" : "祖千秋叹了口气：这玩意儿我吃了太多。。。嗳！没想到。。。\n",
                "治病" : (: ask_book :),
        ]));

        set("chat_chance", 3);
        set("chat_msg", ({
        "祖千秋对你说道：我老哥子摊上个女儿病的快不行了，整天尽喂她些归元丹、养心丸什麽的，可一点儿用也没有。\n",
        "祖千秋嘟哝道：最近手头紧，打酒的钱都没有。我老哥子阔，可一点儿也不接济我,我可得巴结他一下。\n",
        (: command("sigh") :),
         })); 
        setup();
        carry_object("/clone/misc/cloth")->wear();

}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

string ask_book()
{
        object who = this_player();
        who->add_temp("zu/save", 1);
         return RANK_D->query_respect(who) + "是否知道如何治我那侄女的病？";
}

int accept_object(object who,object ob)
{
         object book8;
         who=this_player();
         if(!who->query_temp("zu/save")){
           command ("? "+ who->query("id"));
           command ("say 这位"+RANK_D->query_respect(who) +"莫名其妙地给我东西干吗？");
           return 0;
         }
         if(ob->query("id") != "xuming badan" && ob->query("name") != HIR"续命八丹"NOR){
           command ("say 我要这"+ob->query("name")+CYN"没用啊，"+RANK_D->query_respect(who) +"还是请回吧。");
           return 0;
         }
         book8 = unew("/clone/medicine/m-book8");
         if(!clonep(book8))
           return notify_fail (CYN"祖千秋说道：已经有人在帮我那侄女治病了，你就呆一边凉快去吧。\n"NOR);
         if(clonep(book8) && book8->violate_unique()){
           destruct(book8);
             return notify_fail (CYN"祖千秋说道：已经有人在帮我那侄女治病了，你就呆一边凉快去吧。\n"NOR);
         }
         command("joythank "+(string)who->query("id"));
         command("say 如果" + RANK_D->query_respect(who) + "能帮我治我那侄女的病，我必将感激不尽，这里有一本本草经集注，\n"+
                 "也算是一本医书宝典，可惜我没这个缘分读，请" + RANK_D->query_respect(who) + "收下，略表我的心意。");
         message_vision("祖千秋交给$N一本"HIC"本草经集注"NOR"。\n",who);
         who->delete_temp("zu");
         book8->move(who);
         call_out("destroy", 1, ob);    
         return 1;
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
