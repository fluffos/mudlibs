//lao touzi.c

#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
inherit F_UNIQUE;
int inquiry_badan();
int inquiry_tianqi();
int inquiry_jinchuangyao();
int inquiry_bcd();
int inquiry_bhdmd();
int inquiry_9hw();
int inquiry_9zjqw();
int inquiry_ylqxs();
int inquiry_gyd();
int inquiry_dhd();
int inquiry_xhd();
int inquiry_ynyjd();




void create()
{
	set_name("老头子", ({ "lao touzi","lao"}));
	set("long",		
		"他是一个五十来岁的老头子,一张充满沧桑的脸上满是泥土。\n"
		"他背上背着一个破旧的药筐，腰间挂满各种挖药的工具。看来是靠卖药为生。\n"
		"一双精明的眼睛正盯着你看。不知道在打什么主意！\n"		
	);
        set("gender", "男性");
        set("attitude", "friendly");

        set("no_get_from", 1);

        set("unique", 1);
        set("age", 55);
        set("per",15);
        set("shen", 0);
        set("str", 30);
        set("int", 25);
        set("con", 27);
        set("dex", 29);
        set("unique", 1);
        set_temp("no_return",1);
        set("max_qi", 1000);
        set("max_jing", 1000);
        set("neili", 1200);
        set("max_neili", 1200);
        set("jiali", 60);
	set_skill("unarmed", 180);
	set_skill("dodge", 180);
	set_temp("apply/attack", 40);
	set_temp("apply/attack", 40);
	set_temp("apply/damage", 25);
	set("vendor_goods", ([
	      "/clone/medicine/renshen" :8,
	      "/clone/medicine/xuelianzi" :9,
	      "/clone/medicine/xionghuang" :12,
	      "/clone/medicine/tianqi" :9,
	      "/clone/medicine/tianhua" :16,
	      "/clone/medicine/zhuye" :8,      
      			]));

	
           set("combat_exp", 450000);
		set("inquiry", ([
//           "buy" : (: ask_buy :),
//           "买药" : (: ask_buy :),
           "挖药" : "这种活你可干不了哦。",
            "药方" : "你想配制什么药啊。" ,
	   "续命八丹" : (: inquiry_badan :),
	   "田七鲨胆散" : (: inquiry_tianqi :),
	   "金创药" : (: inquiry_jinchuangyao :),
	   "白草丹" : (: inquiry_bcd :),
	   "白虎夺命丹" : (: inquiry_bhdmd :),
	   "九花玉露丸" : (: inquiry_9hw :),
   	   "玉露清新散" : (: inquiry_ylqxs :),
   	   "归元丹" : (: inquiry_gyd :),
   	   "大还丹" : (: inquiry_dhd :),
   	   "小还丹" : (: inquiry_xhd :),
   	   "九转节气丸" : (: inquiry_9zjqw :),
	   "延年易精丹" : (: inquiry_9zjqw :),
	]));

	set("chat_chance", 5);
	set("chat_msg", ({															  
			(: random_move :),
			(: random_move :),
			(: random_move :),
			(: random_move :),
			}));
        carry_object("/clone/misc/yaokuang")->wear();
        carry_object("/clone/misc/cloth")->wear();

	setup();

}

void init()
{
	object ob;
	
	::init();
	if (interactive(ob = this_player()) && !is_fighting()) {
		remove_call_out("greeting");
		call_out("greeting",2, ob);
	}
        add_action("do_buy", "buy");
        add_action("do_list", "list");    
	remove_call_out("do_back");
        call_out("do_back", 200,ob);
         
	
}
int inquiry_ynyjd()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“延年易精丹？嗯！你可用嫩竹叶,柴胡,木瓜和黄芪配制而成。”\n" );
	return 1;
}
int inquiry_xhd()
{
	tell_object(this_player(),"
  老头子悄悄对你说道：“小还丹？那是少林寺灵药！你可用桑叶,当归,天花粉和藿香配制而成。”\n" );
	return 1;
}


int inquiry_dhd()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“大还丹？那是少林寺灵药！你可用荷叶,当归,天花粉和藿香配制而成。”\n" );
	return 1;
}

int inquiry_gyd()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“归元丹？嗯！你可用荷叶,当归,白薇和金银花配制而成。”\n" );
	return 1;
}


int inquiry_ylqxs()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“玉露清新散？嗯！你可用荷叶,川贝,雪莲子和茯苓配制而成。”\n" );
	return 1;
}


int inquiry_9zjqw()

{
	tell_object(this_player(),"
老头子悄悄对你说道：“九转节气丸？嗯！你可用荷叶,蝉蜕,牛黄和枸杞配制而成。”\n" );
	return 1;
}


int inquiry_9hw()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“九花玉露丸？那可是桃花岛的神奇药物！你可用\n"
"藏红花,荷叶,和雪莲子配制而成。”\n" );
	return 1;
}

int inquiry_bhdmd()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“白虎夺命丹？嗯！你可用虎骨,雪莲子,茯苓,白芷\n"
"和人参配制而成。”\n" );
	return 1;
}

int inquiry_bcd()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“白草丹？那是丐帮的灵药！你可用藏红花和防风配制而成。”\n" );
	return 1;
}

int inquiry_jinchuangyao()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“金创药？这个容易！你可用川贝和生地配制而成。”\n" );
	return 1;
}

int inquiry_tianqi()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“田七鲨胆散？那可是桃花岛的独门解毒灵药呀！\n"
"你可用藏红花,鲨胆,田七配制而成。”\n" );
	return 1;
}


int inquiry_badan()
{
	tell_object(this_player(),"
老头子悄悄对你说道：“ 续命八丹？那可是救命的灵药呀！你可用何首\n"
"乌,菊梗,田七,雄黄配制而成。”\n" );
	return 1;
}


void greeting(object ob)
{
	if (!ob || environment(ob) != environment())
		return;
	switch(random(3)) {
	case 0 :
		message_vision("老头子拍了拍背后的药筐，又傻忽忽的盯着$N看，不知道在打什么主意。\n", ob);
		break;
	case 1 :
		message_vision("老头子从背后的药筐里拿出一把药锄，四周仔细看了看，不知道在搞什么鬼。\n",ob);
		break;

        case 2 :
		message_vision("老头子小声的在你耳边说道：“想买药呀？嘿嘿！你可算是找对人了！\n",ob);
		break;
	}
}


void do_back(object me)
{
		message_vision("$N说道：“又要去挖药了下次再见。”\n", this_object());       
       message_vision("$N急急忙忙地走了出去。\n",this_object() );       
		 switch( random(20) ) 
	 {

        case 0: this_object()->move("/d/shaolin/pingtai"); break;
        case 1: this_object()->move("/d/xiangyang/cross2"); break;
        case 2: this_object()->move("/d/city/xidajie3"); break;
          case 3: this_object()->move("/d/huashan/yunu"); break;
        case 4: this_object()->move("/d/city/guangchangbei"); break;
        case 5: this_object()->move("/d/mingjiao/guangc"); break;
        case 6: this_object()->move("/d/wudang/sanqingdian"); break;
        case 7: this_object()->move("/d/mr/yanziwu"); break;
        case 8: this_object()->move("/d/mr/cl3"); break;
        case 9: this_object()->move("/d/suzhou/canglangting"); break;
        case 10: this_object()->move("/d/fuzhou/zhongxin"); break;
        case 11: this_object()->move("/d/hz/tianxianglou"); break;
        case 12: this_object()->move("/d/xingxiu/ryd1"); break;
        case 13: this_object()->move("/d/mingjiao/shanjiao"); break;
        case 14: this_object()->move("/d/xingxiu/jyg"); break;
        case 15: this_object()->move("/d/emei/huazangangc"); break;
        case 16: this_object()->move("/d/emei/qingyinge"); break;
        case 17: this_object()->move("/d/dali/dalics"); break;
        case 18: this_object()->move("/d/tls/gfd"); break;
        case 19: this_object()->move("/d/village/squarepishou"); break;
        case 20: this_object()->move("/d/thd/hall"); break;
	  
	}

message_vision("$N走了过来。\n", this_object());       
command("say 嘿嘿！今天有挖到许多上好的药材");



}
