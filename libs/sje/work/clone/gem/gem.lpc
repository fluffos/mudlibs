int do_zhuru(string arg) {
  int index;
  string gem, item_name;
  object ob, me = this_player();

  if (!arg || arg == "")
    return notify_fail("指令格式：zhuru 宝石 into 物品 \n");
  if (sscanf(arg, "%s into %s", gem, item_name) != 2)
    return notify_fail("指令格式：zhuru 宝石 into 物品 \n");
  if (gem != query("id"))
    return notify_fail("没有这个宝石，或者不能注入！\n");
  if (!objectp(ob = present(item_name, me)))
    return notify_fail("你想把它镶嵌在什么东西上？\n");


  if (ob->query("ke_w/special_ke") < 1)
    return notify_fail("开什么玩笑，不能注入能量！\n");


  if (ob->query("equipped"))
    return notify_fail(ob->name() + "正装备着呢！\n");
  if (me->query("max_neili") < 1000 || me->query("neili") < 1500)
    return notify_fail("以你现在的内力修为，还无法运功注入能量！\n");



  switch (query("material")) {
    case "ruby":

      if (ob->query("ke_w/max_f_damage")) {

        if (ob->query("ke_w/huoyun") >= ob->query("ke_w/max_f_damage")) {
          tell_object(me, "" + ob->query("name") + "的火云能量已经充满了！\n" NOR);
          return 1;
        }
        ob->add("ke_w/huoyun", query("level"));
        if (ob->query("ke_w/huoyun") > ob->query("ke_w/max_f_damage")) ob->set(
          "ke_w/huoyun",
          ob->query("ke_w/max_f_damage")
        );
        message_vision(
          HIR "$N暗运内力，" + name() + HIR "化作红光，射入了" + ob->name() + HIR "中，
刹那间，只觉" + ob->name() + HIR "上泛出一道奇异的光芒，火云的能量已经充入！\n\n现在" + ob->name() + HIR "火云能量已经达到" + chinese_number(ob->query("ke_w/huoyun")) + "\n",
          me
        );
        me->add("neili", -1000);
        me->start_busy(2);
        destruct(this_object());
        return 1;
      }

      break;

    case "topaz":

      if (ob->query("ke_w/max_l_damage")) {

        if (ob->query("ke_w/jinglei") >= ob->query("ke_w/max_l_damage")) {
          tell_object(me, "" + ob->query("name") + "的惊雷能量已经充满了！\n" NOR);
          return 1;
        }

        ob->add("ke_w/jinglei", query("level"));
        if (ob->query("ke_w/jinglei") > ob->query("ke_w/max_l_damage")) ob->set(
          "ke_w/jinglei",
          ob->query("ke_w/max_l_damage")
        );
        message_vision(
          HIY "$N暗运内力，" + name() + HIY "化作金光，射入了" + ob->name() + HIY "中，
刹那间，只觉" + ob->name() + HIY "上泛出一道奇异的光芒，惊雷的能量已经充入！\n\n现在" + ob->name() + HIY "惊雷能量已经达到" + chinese_number(ob->query("ke_w/jinglei")) + "\n",
          me
        );
        me->add("neili", -1000);
        me->start_busy(2);
        destruct(this_object());
        return 1;
      }

      break;

    case "sapphire":

      if (ob->query("ke_w/max_c_damage")) {

        if (ob->query("ke_w/bingshuang") >= ob->query("ke_w/max_c_damage")) {
          tell_object(me, "" + ob->query("name") + "的冰霜能量已经充满了！\n" NOR);
          return 1;
        }

        ob->add("ke_w/bingshuang", query("level"));
        if (ob->query("ke_w/bingshuang") > ob->query("ke_w/max_c_damage")) ob->set(
          "ke_w/bingshuang",
          ob->query("ke_w/max_c_damage")
        );
        message_vision(
          HIC "$N暗运内力，" + name() + HIC "化作冰光，射入了" + ob->name() + HIC "中，
刹那间，只觉" + ob->name() + HIC "上泛出一道奇异的光芒，冰霜的能量已经充入！\n\n现在" + ob->name() + HIC "冰霜能量已经达到" + chinese_number(ob->query("ke_w/bingshuang")) + "\n",
          me
        );
        me->add("neili", -1000);
        me->start_busy(2);
        destruct(this_object());
        return 1;
      }

      break;

    case "emerald":

      if (ob->query("ke_w/max_p_damage")) {

        if (ob->query("ke_w/yinglv") >= ob->query("ke_w/max_p_damage")) {
          tell_object(me, "" + ob->query("name") + "的莹绿能量已经充满了！\n" NOR);
          return 1;
        }

        ob->add("ke_w/yinglv", query("level"));
        if (ob->query("ke_w/yinglv") > ob->query("ke_w/max_p_damage")) ob->set(
          "ke_w/yinglv",
          ob->query("ke_w/max_p_damage")
        );
        message_vision(
          HIG "$N暗运内力，" + name() + HIG "化作绿光，射入了" + ob->name() + HIG "中，
刹那间，只觉" + ob->name() + HIG "上泛出一道奇异的光芒，莹绿的能量已经充入！\n\n现在" + ob->name() + HIG "莹绿能量已经达到" + chinese_number(ob->query("ke_w/yinglv")) + "\n",
          me
        );
        me->add("neili", -1000);
        me->start_busy(2);
        destruct(this_object());
        return 1;
      }

      break;

    case "amethyst":

      if (ob->query("ke_w/max_z_damage")) {

        if (ob->query("ke_w/zidian") >= ob->query("ke_w/max_z_damage")) {
          tell_object(me, "" + ob->query("name") + "的紫电能量已经充满了！\n" NOR);
          return 1;
        }

        ob->add("ke_w/zidian", query("level"));
        if (ob->query("ke_w/zidian") > ob->query("ke_w/max_z_damage")) ob->set(
          "ke_w/zidian",
          ob->query("ke_w/max_z_damage")
        );
        message_vision(
          HIM "$N暗运内力，" + name() + HIM "化作紫光，射入了" + ob->name() + HIM "中，
刹那间，只觉" + ob->name() + HIM "上泛出一道奇异的光芒，紫电的能量已经充入！\n\n现在" + ob->name() + HIM "紫电能量已经达到" + chinese_number(ob->query("ke_w/zidian")) + "\n",
          me
        );
        me->add("neili", -1000);
        me->start_busy(2);
        destruct(this_object());
        return 1;
      }

      break;
  }
  return notify_fail("武器上并没有相关的属性！\n");

}



int do_combine(string arg) {
  int i;
  object *inv, gem, me = this_player();

  if (!arg || arg == "")
    return notify_fail("你想合并什么宝石？\n");
  if (arg != query("id")) return 0;
  if (query("level") == 8)
    return notify_fail("这个宝石已经是最高等级了！\n");
  if (me->query("max_neili") < 500 || me->query("neili") < 800)
    return notify_fail("以你现在的内力修为，还无法运功合并宝石！\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i] != this_object() && inv[i]->query("id") == query("id")) {
      if (!objectp(gem))
        gem = inv[i];
      else {
        message_vision(HIG "$N暗运内力劲透宝石，但见" + name() + HIG "表面异彩流动，
渐渐的$N收回了内力，只觉" + name() + HIG "似乎变得更加完美了！\n", me);
        me->add("max_neili", -10);
        me->add("neili", -500);
        me->start_busy(1);
        new_gem(query("material"), query("level") + 1)->move(me);
        destruct(gem);
        destruct(inv[i]);
        destruct(this_object());
        return 1;
      }
    }
  return notify_fail("你必须有三块同样的宝石才能进行合并！\n");
}
