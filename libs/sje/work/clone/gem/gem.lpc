#include <ansi.h>

inherit ITEM;
inherit F_GEMS;

void create() {
  int lev, i;
  string gem, s;
  object me = this_player();

  i = random(17);
  if (i < 3) gem = "ruby";
  else if (i < 6) gem = "topaz";
  else if (i < 9) gem = "sapphire";
  else if (i < 12) gem = "emerald";
  else if (i < 15) gem = "amethyst";
  else if (i < 16) gem = "diamond";
  else gem = "skull";

  i = random(1000);
  if (i < 600) lev = 1;
  else if (i < 850) lev = 2;
  else if (i < 950) lev = 3;
  else if (i < 980) lev = 4;
  else if (i < 990) lev = 5;
  else if (i < 996) lev = 6;
  else if (i < 998) lev = 7;
  else lev = 8;

  set_name(query_gem_name(gem, lev), ({ query_gem_id(gem, lev) }));
  set_weight(100);
  set("long", query_all_effect(gem));
  set("unit", "颗");
  set("no_put", 1);
  set("treasure", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("no_clone", 1);
  set("no_pawn", 1);
  set("value", 10000 * lev * lev * lev);
  set("material", gem);
  set("level", lev);
  setup();
}

void init() {
  add_action("do_insert", "insert");
  add_action("do_combine", "combine");
  add_action("do_zhuru", "zhuru");
}

int do_insert(string arg) {
  int index;
  string gem, item_name;
  object ob, me = this_player();

  if (!arg || arg == "")
    return notify_fail("指令格式：insert 宝石 into 物品 \n");
  if (sscanf(arg, "%s into %s", gem, item_name) != 2)
    return notify_fail("指令格式：insert 宝石 into 物品 \n");
  if (gem != query("id"))
    return notify_fail("没有这个宝石，或者不能镶嵌！\n");
  if (!objectp(ob = present(item_name, me)))
    return notify_fail("你想把它镶嵌在什么东西上？\n");

  //  "ke_w/special_ke is weapon	"ke_w/special_ke2" is armor	

  if (ob->query("ke_w/special_ke") < 1 && ob->query("ke_w/special_ke2") < 1)
    return notify_fail("开什么玩笑，这个能用宝石？\n");

  if (ob->query("ke_w/filled") >= ob->query("ke_w/socket"))
    return notify_fail("宝石已经镶满了，必须开更多的凹槽！\n");

  if (ob->query("equipped"))
    return notify_fail(ob->name() + "正装备着呢！\n");
  if (me->query("max_neili") < 1000 || me->query("neili") < 1500)
    return notify_fail("以你现在的内力修为，还无法运功镶嵌宝石！\n");

  // if item is weapon		

  if (ob->query("ke_w/special_ke") > 0) {

    switch (query("material")) {
      case "ruby":

        if (ob->query("ke_w/max_f_damage")) {

          if (ob->query("ke_w/huoyun") >= ob->query("ke_w/max_f_damage")) {
            tell_object(me, "" + ob->query("name") + "的火云能量已经充满了！\n" NOR);
            return 1;
          }

          ob->add("ke_w/huoyun", query("level"));
          if (ob->query("ke_w/huoyun") > ob->query("ke_w/max_f_damage")) ob->set(
            "ke_w/huoyun",
            ob->query("ke_w/max_f_damage")
          );
          message_vision(
            HIR "$N暗运内力，" + name() + HIR "化作红光，射入了" + ob->name() + HIR "中，
刹那间，只觉" + ob->name() + HIR "上泛出一道奇异的光芒，火云的能量已经充入！\n\n现在" + ob->name() + HIR "火云能量已经达到" + chinese_number(ob->query("ke_w/huoyun")) + "\n",
            me
          );
          me->add("neili", -1000);
          me->start_busy(2);
          destruct(this_object());
          return 1;
        }
        message_vision(HIR "$N暗运内力，一使劲把" + name() + HIR "镶入了" + ob->name() + HIR "中，
刹那间，只觉" + ob->name() + HIR "上泛出一道奇异的光芒，似乎有一股神奇的力量附在其中！\n", me);

        me->add("neili", -1000);
        me->start_busy(2);
        ob->add("level", query("level"));
        ob->add("ke_w/filled", 1);

        ob->set("ke_w/max_f_damage", query("level"));
        ob->set("ke_w/huoyun", query("level"));
        ob->add("value", query("value"));

        ob->set(
          "wield_msg",
          BBLU + HIR "\n$N将手在风中一挥，无数的火星从四方飞来，渐渐聚在一起～～～$n" BBLU + HIR "已经出现在$P手中！\n" NOR
        );
        ob->set(
          "unwield_msg",
          BBLU + HIR "\n$N将$n" BBLU + HIR "随手一扔，只见$n" BBLU + HIR "突然变得火红，化做无数的火星四散飘走了！\n" NOR
        );

        switch (query("level")) {

          case 8:
            ob->set("id", "zhenhuo " + ob->query("id"));
            ob->set("name", HIR "混元真火" + ob->query("name") + NOR);
            ob->set("long", ob->query("long") + "\n" HIR "镶嵌天圣的火云石\n特殊攻击：fang huoyun\n" NOR);
            break;

          case 7:
            ob->set("id", "zhenhuo " + ob->query("id"));
            ob->set("name", HIR "炼狱真火" + ob->query("name") + NOR);
            ob->set("long", ob->query("long") + "\n" HIR "镶嵌魔王的火云石\n特殊攻击：fang huoyun\n" NOR);
            break;

          case 6:
