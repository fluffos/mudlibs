#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIC "萧秋水传奇" NOR, ({ "xiaoqiushui book" }));
  set("no_put", 1);
  set("value", 0);
  set("shenshu", 1);
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "本");
    set("treasure", 1);
    set("material", "paper");
    set("long", "一本由神书合并成的卷册，你可以用(chayue)来查阅它。\n");
  }

  setup();
}
void init() {
  add_action("do_cha", "chayue");
}
int do_cha() {
  object me, ob;
  int exp, pot, score, i;
  me = this_player();
  exp = 8000 + random(8000);
  pot = exp / 4;
  score = random(300) + 100;
  me->add("combat_exp", exp);
  me->add("potential", pot);
  me->add("score", score);
  i = random(6);
  message_vision("$N仔细地查阅了一遍" + this_object()->query("name") + "。\n" NOR, me);
  tell_object(me, HIW "你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" +
    chinese_number(score) + "点江湖阅历\n" NOR);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "sdan1");
  ob->move(me);
  ob = new(__DIR__ "giftdan");
  ob->move(me);
  ob = new(__DIR__ "perdan");
  ob->move(me);
  destruct(this_object());
  return 1;
}
