//混元丹：书剑中的密宝，可以调整属性，一次可以调整一点。
//keinxin@sj2 2003.4

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_fu", "fu");
}

void create() {
  set_name(HIC "混元丹" NOR, ({ "hunyuan dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("treasure", 1);
    set("long", "" HIC "这是一颗混元丹，通体晶莹，是上古流传下来的宝物
作用：调整先天属性。
指令：fu xx 例如：fu 臂力
悟性,臂力,身法,根骨
" HIR "服用完毕后可以找金庸增加属性。" NOR "\n");
    set("value", 50000);
    set("no_pawn", 1);
  }
  setup();
}

int do_fu(string arg) {
  int exp, pot, score;
  object me = this_player();
  if (!arg)
    return notify_fail("你要减少什么属性？（悟性,臂力,身法,根骨）\n");

  if (arg == "悟性") {
    me->add("int", -1);
    message_vision(HIR "$N吃下一颗混元丹，只觉得头重脚轻，摇摇欲倒！\n" NOR, me);
    me->unconcious();
    me->add("属性奖励", 1);
    destruct(this_object());
    return 1;
  }
  if (arg == "臂力") {
    me->add("str", -1);
    message_vision(HIR "$N吃下一颗混元丹，只觉得头重脚轻，摇摇欲倒！\n" NOR, me);
    me->unconcious();
    me->add("属性奖励", 1);
    destruct(this_object());
    return 1;
  }
  if (arg == "身法") {
    me->add("dex", -1);
    message_vision(HIR "$N吃下一颗混元丹，只觉得头重脚轻，摇摇欲倒！\n" NOR, me);
    me->unconcious();
    me->add("属性奖励", 1);
    destruct(this_object());
    return 1;
  }
  if (arg == "根骨") {
    me->add("con", -1);
    message_vision(HIR "$N吃下一颗混元丹，只觉得头重脚轻，摇摇欲倒！\n" NOR, me);
    me->unconcious();
    me->add("属性奖励", 1);
    destruct(this_object());
    return 1;
  } else {

    tell_object(me, HIY " 你要fu 什么？（悟性,臂力,身法,根骨）\n" NOR);
    return 1;

  }

}
