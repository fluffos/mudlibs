#include <ansi.h>

#include "/quest/shenshu/npc/name.lpc"

void create() {
  mapping npc;
  string weapon;
  npc = data[random(sizeof(data))];
  weapon = npc["weapon"];

  set_name(npc["name"], ({ npc["id"] }));

  set("title", HIW "桃花岛隐圣 奇门五转 飞影 " HIR "强" NOR);

  set("age", 20 + random(30));
  set("attitude", "peaceful");
  set("shen", -80000);
  set("str", 20 + random(10));
  set("int", 20 + random(10));
  set("con", 25 + random(10));
  set("dex", 20 + random(10));

  set("max_qi", 6500 + random(3000));
  set("max_jing", 6500 + random(3000));
  set("eff_jingli", 2500 + random(3000));
  set("jiali", 100 + random(100));
  set("combat_exp", 1200000 + random(1000000));
  set("tasknpc", 1);
  set("no_get", 1);
  set_skill("force", 260 + random(100));
  set_skill("dodge", 200 + random(100));
  set_skill("suibo-zhuliu", 260 + random(100));
  set_skill("finger", 180 + random(100));
  set_skill("luoying-zhang", 180 + random(100));
  set_skill("bihai-chaosheng", 280 + random(100));
  set_skill("yuxiao-jian", 300 + random(40));
  set_skill("parry", 280 + random(100));
  set_skill("leg", 220 + random(100));
  set_skill("strike", 180 + random(100));
  set_skill("sword", 180 + random(100));
  set_skill("xuanfeng-tui", 120 + random(100));
  set_skill("literate", 180);
  set_skill("qimen-bagua", 220 + random(100));
  set_skill("tanzhi-shentong", 220 + random(100));
  set_skill("lanhua-shou", 220 + random(100));
  map_skill("force", "bihai-chaosheng");
  map_skill("dodge", "suibo-zhuliu");
  map_skill("strike", "luoying-zhang");
  map_skill("hand", "lanhua-shou");
  map_skill("finger", "tanzhi-shentong");
  map_skill("leg", "xuanfeng-tui");
  map_skill("parry", "luoying-zhang");
  map_skill("sword", "yuxiao-jian");
  prepare_skill("strike", "luoying-zhang");
  prepare_skill("leg", "xuanfeng-tui");
  prepare_skill("sword", "yuxiao-jian");

  set("shen_type", npc["mw"]);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: do_walk :),
    (: random_move :),
  }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.wuzhuan" :),
    (: perform_action, "sword.feiying" :),
    (: random_move :),
  }));

  set_temp("apply/attack", 120);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 20);
  set_temp("apply/damage", 20 + random(80));

  setup();
  set("check_time", time());
  set("wuyazi_bmfind", 1);
  set("qixingquest", 1);
  set("thd/perform", 4);
  set("pass_guo", 1);
  set("fenwo", 300);
  carry_object("/clone/cloth/cloth")->wear();
  carry_object(BINGQI_D("xiao"))->wield();
  add_money("gold", 3 + random(3));
}


#include "/quest/shenshu/npc/man.h"
