#include <ansi.h>

#include "/quest/shenshu/npc/name.lpc"

void create()
{
	mapping npc;
	string weapon;
	npc=data[random(sizeof(data))];
	weapon=npc["weapon"];

	set_name(npc["name"],({ npc["id"] }));
	
	set("title", HIC"华山剑宗 夺命连环 "HIR"强"NOR);
	
	set("age",20+random(30));
        set("attitude", "peaceful");
        set("shen", -80000);
        set("str", 20+random(10));
        set("int", 20+random(10));
        set("con", 25+random(10));
        set("dex", 20+random(10));
        
        set("max_qi", 6500+random(3000));
        set("max_jing", 6500+random(3000));
        set("eff_jingli", 2500+random(3000));
        set("jiali", 100+random(100));
        set("combat_exp", 1200000+random(1000000)); 
        set("tasknpc",1);
        set("no_get",1);
        set_skill("force", 260+random(100));
        set_skill("dodge", 200+random(100));
        set_skill("huashan-shenfa", 260+random(100));
        set_skill("finger", 180+random(100));
        set_skill("hunyuan-zhang", 180+random(100));   
        set_skill("zixia-gong", 280+random(100)); 
        set_skill("dugu-jiujian", 240+random(100));                
        set_skill("parry", 280+random(100));
        set_skill("cuff", 220+random(100));
        set_skill("strike", 180+random(100));
        set_skill("sword", 180+random(100));
        set_skill("huashan-jianfa", 220+random(100));
        set_skill("poyu-quan", 120+random(100));
        set_skill("literate", 180);
        map_skill("force", "zixia-gong");
        map_skill("dodge", "huashan-shenfa");
        map_skill("strike", "hunyuan-zhang");
        map_skill("cuff", "poyu-quan");
        map_skill("parry", "huashan-jianfa");   
        map_skill("sword", "huashan-jianfa");      
        prepare_skill("strike", "hunyuan-zhang"); 
        prepare_skill("cuff", "poyu-quan"); 
        prepare_skill("sword", "huashan-jianfa");          
        
	set("shen_type",npc["mw"]);
        set("chat_chance", 20);
        set("chat_msg", ({
                (: do_walk :),
                (: random_move :),          
        }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
           (: perform_action, "sword.jianmang" :),
           (: perform_action, "sword.lianhuan" :),
           (: random_move :),
        }) );

        set_temp("apply/attack", 120);
        set_temp("apply/defense", 20);
        set_temp("apply/armor", 20);
        set_temp("apply/damage", 20+random(80));

        setup();
        set("check_time", time());
        set("wuyazi_bmfind", 1);
        set("qixingquest",1);
        set("pass_guo",1);
        set("fenwo",300);
	carry_object("/clone/cloth/cloth")->wear();
	carry_object(BINGQI_D("sword"))->wield();
	add_money("gold",3+random(3));
}


#include "/quest/shenshu/npc/man.h"