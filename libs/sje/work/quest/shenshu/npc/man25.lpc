#include <ansi.h>

#include "/quest/shenshu/npc/name.lpc"

void create()
{
	mapping npc;
	string weapon;
	npc=data[random(sizeof(data))];
	weapon=npc["weapon"];

	set_name(npc["name"],({ npc["id"] }));
	
	set("title", HIW"武当真人 太极 "HIR"超强"NOR);
	
	set("age",20+random(30));
        set("attitude", "peaceful");
        set("shen", -80000);
        set("str", 20+random(10));
        set("int", 20+random(10));
        set("con", 25+random(10));
        set("dex", 20+random(10));
        
        set("max_qi", 6500+random(3000));
        set("max_jing", 6500+random(3000));
        set("eff_jingli", 2500+random(3000));
        set("jiali", 100+random(100));
        set("combat_exp", 1200000+random(1000000)); 
        set("tasknpc",1);
        set("no_get",1);
        set_skill("force", 260+random(100));
        set_skill("yinyun-ziqi", 260+random(100));
        set_skill("dodge", 260+random(100));
        set_skill("strike", 260+random(100));
        set_skill("zhenshan-mianzhang", 260+random(100));
        set_skill("tiyunzong", 260+random(100));
        set_skill("cuff", 260+random(100));
        set_skill("taiji-quan", 260+random(100));
        set_skill("parry", 260+random(100));
        set_skill("sword", 260+random(100));
        set_skill("taiji-jian", 260+random(100));
        set_skill("taoism", 260+random(100));
        set_skill("blade", 260+random(100));
        set_skill("literate", 260+random(100));
        set_skill("wudang-quan", 260+random(100));
        set_skill("xuanxu-daofa", 260+random(100));
        map_skill("force", "yinyun-ziqi");
        map_skill("dodge", "tiyunzong");
        map_skill("cuff", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "xuanxu-daofa");
        prepare_skill("cuff", "taiji-quan");
        
	set("shen_type",npc["mw"]);
        set("chat_chance", 20);
        set("chat_msg", ({
                (: do_walk :),
                (: random_move :),          
        }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "yinyun" :),
                (: perform_action, "sword.chan" :),
                (: perform_action, "sword.sanhuan" :),
                (: perform_action, "sword.lian" :),
                (: perform_action, "cuff.zhen" :),
                (: perform_action, "cuff.zhan" :),
                (: perform_action, "cuff.luanhuan" :),
                (: perform_action, "cuff.ji" :),
                (: random_move :),
        }) );

        set_temp("apply/attack", 120);
        set_temp("apply/defense", 20);
        set_temp("apply/armor", 20);
        set_temp("apply/damage", 20+random(80));

        setup();
        set("check_time", time());
        set("wuyazi_bmfind", 1);
        set("qixingquest",1);
        set("thd/perform",4);
        set("pass_guo",1);
        set("fenwo",300);
	carry_object("/clone/cloth/cloth")->wear();
 	carry_object(BINGQI_D("sword"))->wield();
	add_money("gold",3+random(3));
}


#include "/quest/shenshu/npc/man.h"