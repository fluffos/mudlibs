//quest/shenshu/npc/man14.c
//丐帮，威力:1
//kungfu:xianglong-zhang , kanglongwuhui,xiao
//威力等级划分：1-4
//by keinxin@sj2 2003.5
#include <ansi.h>

#include "/quest/shenshu/npc/name.lpc"

void create() {
  mapping npc;
  string weapon;
  npc = data[random(sizeof(data))];
  weapon = npc["weapon"];

  set_name(npc["name"], ({ npc["id"] }));

  set("title", YEL "丐帮传人 降龙掌 " HIR "生死一搏 生死自负" NOR);

  set("age", 20 + random(30));
  set("attitude", "peaceful");
  set("shen", -80000);
  set("str", 20 + random(10));
  set("int", 20 + random(10));
  set("con", 20 + random(10));
  set("dex", 20 + random(10));

  set("max_qi", 6500 + random(3000));
  set("max_jing", 6500 + random(3000));
  set("eff_jingli", 2500 + random(3000));
  set("jiali", 100 + random(100));
  set("combat_exp", 1200000 + random(1000000));
  set("tasknpc", 1);
  set("no_get", 1);
  set_skill("force", 260 + random(100));
  set_skill("dodge", 200 + random(100));
  set_skill("xiaoyaoyou", 160 + random(100));
  set_skill("strike", 180 + random(100));
  set_skill("xianglong-zhang", 180 + random(100));
  set_skill("huntian-qigong", 280 + random(100));
  set_skill("parry", 280 + random(100));
  set_skill("literate", 180);
  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("strike", "xianglong-zhang");
  map_skill("parry", "xianglong-zhang");
  prepare_skill("strike", "xianglong-zhang");

  set("shen_type", npc["mw"]);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: do_walk :),
    (: random_move :),
    (: exert_function, "tiangang" :),
  }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "strike.kanglongwuhui" :),
    (: perform_action, "strike.xiao" :),
    (: random_move :),
  }));

  set_temp("apply/attack", 120);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 20);
  set_temp("apply/damage", 20 + random(80));

  setup();
  set("check_time", time());
  set("wuyazi_bmfind", 1);
  set("xlz/wuhui", 1);
  set("xlz/hang", 1);
  set("pass_guo", 1);
  set("fenwo", 300);
  carry_object("/clone/cloth/cloth")->wear();
  add_money("gold", 3 + random(3));
}


#include "/quest/shenshu/npc/man.h"
