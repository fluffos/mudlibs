void create() {
  mapping npc;
  string weapon;
  npc = data[random(sizeof(data))];
  weapon = npc["weapon"];

  set_name(npc["name"], ({ npc["id"] }));
  set("age", 20 + random(30));
  set("title", HIM "少林散花掌传人 强" NOR);
  set("attitude", "peaceful");
  set("shen", -8000);
  set("str", 28);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 6500 + random(3000));
  set("max_jing", 6500 + random(3000));
  set("jiali", 100 + random(100));
  set("combat_exp", 1200000);
  set("tasknpc", 1);
  set("no_get", 1);
  set_skill("force", 200 + random(100));
  set_skill("yijin-jing", 200 + random(100));
  set_skill("dodge", 200 + random(100));
  set_skill("kunlun-shenfa", 200 + random(100));
  set_skill("strike", 180 + random(100));
  set_skill("sanhua-zhang", 180 + random(140));
  set_skill("parry", 220 + random(200));
  set_skill("literate", 80);
  map_skill("force", "yijin-jing");
  map_skill("dodge", "kunlun-shenfa");
  map_skill("strike", "sanhua-zhang");
  map_skill("parry", "sanhua-zhang");
  prepare_skill("strike", "sanhua-zhang");

  set("shen_type", npc["mw"]);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: do_walk :),
    (: random_move :),
  }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "strike.sanhua" :),
    (: random_move :),
  }));

  set_temp("apply/attack", 120);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 120);
  set_temp("apply/damage", 20 + random(180));

  setup();
  set("check_time", time());
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 50 + random(50));
}


