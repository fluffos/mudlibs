void create()
{
	mapping npc;
	string weapon;
	npc=data[random(sizeof(data))];
	weapon=npc["weapon"];

	set_name(npc["name"],({ npc["id"] }));
	set("age",20+random(30));
        set("attitude", "peaceful");
        set("shen", -8000);
        set("str", 28);
        set("int", 20);
        set("con", 25);
        set("dex", 27);
        
        set("max_qi", 6500+random(3000));
        set("max_jing", 6500+random(3000));
        set("jiali", 100+random(100));
        set("combat_exp", 1200000); 
        set("tasknpc",1);
        set("no_get",1);
        set_skill("force", 200+random(100));
        set_skill("yijin-jing", 200+random(100));
        set_skill("dodge", 200+random(100));
        set_skill("kunlun-shenfa", 200+random(100));
        set_skill("strike", 180+random(100));
        set_skill("sanhua-zhang", 180+random(140));
        set_skill("parry", 220+random(200));
        set_skill("literate", 80);
        map_skill("force", "yijin-jing");
        map_skill("dodge", "kunlun-shenfa");
        map_skill("strike", "sanhua-zhang");
        map_skill("parry", "sanhua-zhang");
        prepare_skill("strike", "sanhua-zhang");
        
	set("shen_type",npc["mw"]);
        set("chat_chance", 20);
        set("chat_msg", ({
                (: do_walk :),
                (: random_move :),
        }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
           (: perform_action, "strike.sanhua" :),
           (: random_move :),
        }) );

        set_temp("apply/attack", 120);
        set_temp("apply/defense", 20);
        set_temp("apply/armor", 120);
        set_temp("apply/damage", 20+random(180));

        setup();
        set("check_time", time());
	carry_object("/clone/cloth/cloth")->wear();
	add_money("silver",50+random(50));
}
       
int do_walk()
{
        string start_room;
 string name,weapon;
        object room;
        object ob;
        mapping obmap;
        int n;
        int i;
	object *inv;
        if (! environment())
                return 0;
        name = color_title[random(sizeof(color_title))]+first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))]; 

      if (time() - query("check_time") > 24000 && random(100)>90 || !query_heart_beat(this_object()))
        {
       set_name((order[random(13)])+name, ({ "killer", "shashou", "sha shou" }));
       set("gender", "男性");
       set("title", color_title[random(sizeof(color_title))]);
        n = 0;
	inv = all_inventory(this_object());

	for (i = 0; i < sizeof(inv); i++)
        {
                if (inv[i]->query("dynamic_quest"))
command("chat "+inv[i]->query("name")+(order[random(13)])+"我已经拿到手了。。。撤!!  \n"NOR);
        }

                        message_vision("$N笑了笑说：东西已经到手，任务完成，撤了！\n"NOR, this_object());
                        destruct(this_object());
                        return 0;
        }

        n = 0;
        foreach (ob in all_inventory(environment()))
        {
                if (!ob)  continue;
                if (!ob->query("dynamic_quest"))
                        continue;
        command ("get all");
                n++;
        }

                        
        random_move();
        return 1;
}

int accept_fight(object ob)
{
				command("say " + RANK_D->query_self(this_object())
					+ "怎么可能是" + RANK_D->query_respect(ob)
					+ "的对手？\n");
		  return 0;
}

int kill_ob(object ob)
{
		  command("fear");
		  command("say 不好，我被识破了!!");
		    
if (random(3)==1)
{
command("say 逃啊!!");
if (random(2)==1)
{
command("go south");
command("go west");
}

else
{
command("go north");
command("go east");
}
}
if (ob->query("combat_exp") > 3000000)
{
set("qi",20000);
set("jing",10000);
set("eff_qi",20000);
set("eff_jing",10000);
set("max_qi",20000);
set("max_jing",10000);
        ::kill_ob(ob);
        message_vision(HIR"$N摇了摇头，道：“我和你拼了！！”\n说完双眼直视$n，运起神功，$n觉得有点害怕了。\n"NOR,
                       this_object(), ob);
}
//		  return 1;
}


