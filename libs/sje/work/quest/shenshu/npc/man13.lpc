//quest/shenshu/npc/man13.c
//铁掌，威力:1
//kungfu:tiezhang-zhangfa , tiezhangxianglong
//威力等级划分：1-4
//by keinxin@sj2 2003.5
#include <ansi.h>

#include "/quest/shenshu/npc/name.lpc"

void create() {
  mapping npc;
  string weapon;
  npc = data[random(sizeof(data))];
  weapon = npc["weapon"];

  set_name(npc["name"], ({ npc["id"] }));

  set("title", YEL "铁掌传人 铁掌降龙 " HIR "超强 生死自负" NOR);

  set("age", 20 + random(30));
  set("attitude", "peaceful");
  set("shen", -80000);
  set("str", 20 + random(10));
  set("int", 20 + random(10));
  set("con", 20 + random(10));
  set("dex", 20 + random(10));

  set("max_qi", 6500 + random(3000));
  set("max_jing", 6500 + random(3000));
  set("eff_jingli", 2500 + random(3000));
  set("jiali", 100 + random(100));
  set("combat_exp", 1200000 + random(1000000));
  set("tasknpc", 1);
  set("no_get", 1);
  set_skill("medicine", 220);
  set_skill("force", 260 + random(100));
  set_skill("dodge", 200 + random(100));
  set_skill("lingbo-weibu", 160 + random(100));
  set_skill("strike", 180 + random(100));
  set_skill("tiezhang-zhangfa", 180 + random(100));
  set_skill("guiyuan-tunafa", 280 + random(100));
  set_skill("parry", 280 + random(100));
  set_skill("literate", 180);
  map_skill("force", "guiyuan-tunafa");
  map_skill("dodge", "lingbo-weibu");
  map_skill("strike", "tiezhang-zhangfa");
  map_skill("parry", "qiankun-danuoyi");
  prepare_skill("strike", "tiezhang-zhangfa");

  set("shen_type", npc["mw"]);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: do_walk :),
    (: random_move :),
    (: perform_action, "dodge.luoshen" :),
    (: perform_action, "strike.zhangdao" :),
  }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "strike.tiezhangxianglong" :),
    (: random_move :),
  }));

  set_temp("apply/attack", 120);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 20);
  set_temp("apply/damage", 20 + random(80));

  setup();
  set("check_time", time());
  set("wuyazi_bmfind", 1);
  set("fenwo", 300);
  carry_object("/clone/cloth/cloth")->wear();
  add_money("gold", 3 + random(3));
}


#include "/quest/shenshu/npc/man.h"
