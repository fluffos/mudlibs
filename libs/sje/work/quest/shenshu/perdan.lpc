//天仙养颜丹
//keinxin@sj2 2003.4

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_fu", "eat");
}

void create()
{
	set_name(HIM"天仙养颜丹"NOR, ({"yangyan dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("treasure",1);
		set("long", ""HIM"这是一颗天仙养颜丹，通体瑰红，是上古流传下来的宝物"NOR"\n");
		set("value", 50000);
	}
	setup();
}

int do_fu(string arg)
{
        object me = this_player();
 	if (!id(arg))
	return notify_fail("你要吃什么？\n");

        if (me->query("per")>30 )
	{
		me->add("per", -20);
	        message_vision(RED "$N吃下一颗天仙养颜丹，结果却因为本身容貌限制，脸肿得和猪头一样！\n" NOR, me);
	        me->unconcious();
	        destruct(this_object());
	        return 1;
	}

        me->add("per",1);
        message_vision(HIW "$N吃下一颗天仙养颜丹，瞬间容光焕发，光彩照人！\n" NOR, me);       
        destruct(this_object());
	return 1;
}