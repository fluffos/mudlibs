//天仙养颜丹
//keinxin@sj2 2003.4

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_fu", "tie");
}

void create()
{
	set_name(HIW"天灵圣佑符"NOR, ({"tianling shengyoufu", "shengyoufu", "fu" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("treasure",1);
		set("long", ""HIW"这是一张天灵圣佑符，是太上老君的符咒。
使用方法："HIY"tie fu"NOR"\n");
		set("value", 50000);
	}
	setup();
}

int do_fu(string arg)
{
        object me = this_player();
 	if (!id(arg))
	return notify_fail("你要贴什么？\n");

        if (me->query("kar")>40 )
	{
		me->add("kar", -20);
	        message_vision(HIY "$N贴上一张天灵圣佑符，念叨“太上老君，急急如勒令……”\n天上传来一个声音，$N搞什么鬼？！\n天上降下一道闪电将$N劈中！\n" NOR, me);
	        me->unconcious();
	        destruct(this_object());
	        return 1;
	}

        me->add("kar",1);
        message_vision(HIY "$N贴上一张天灵圣佑符，念叨“太上老君，急急如勒令……”\n天上射来一道金光，注入了$N体内！\n" NOR, me);
        destruct(this_object());
	return 1;
}