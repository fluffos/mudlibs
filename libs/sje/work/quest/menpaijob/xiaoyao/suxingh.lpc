// suxingh.c
// shilling 97.2
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
#include <ansi.h> 
#include <combat.h>
#include "skill.h"


string ask_qi();
string ask_book();
void create()
{
	set_name("苏星河",({"su xinghe","su"}));
	set("gender", "男性" );
	set("nickname", "聪辩先生");
	set("shen_type", 0);
	set("class", "scholar");
	set("age",60);
	set("str", 35);
	set("con", 30);
	set("int", 45);
	set("dex", 35);
	set("per", 30);

	set("no_clean_up",1);

	set("long",
"此人就是号称聪辩先生的苏星河，据说他能言善辩， \n"
"是一个武林中的智者，而他的武功也是无人能知。\n");

	set("combat_exp", 1500000);
	set("attitude", "peaceful");
	set("book_count", 1);
	set("chat_chance", 1);

	set("inquiry", ([
		"珍珑棋局" :(:ask_qi:),
		"秘籍"     :(:ask_book:),
	]) );

	set("max_qi", 5400);
	set("max_jing", 1400);
	set("neili", 9500);
	set("max_neili",9500);
	set("eff_jingli",9500);
	set("jiali", 60);
	set("env/wimpy", 10);

        set_skill("hand", 150);
	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("strike", 150);
	set_skill("parry", 150);
	set_skill("xiaoyaoyou", 150);
	set_skill("beiming-shengong", 150);
	set_skill("liuyang-zhang", 150);
	set_skill("zhemei-shou", 150);
	set_skill("literate", 100);

	map_skill("parry", "liuyang-zhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("force", "beiming-shengong");
	map_skill("hand", "zhemei-shou");
	prepare_skill("hand","zhemei-shou");
	prepare_skill("strike","liuyang-zhang");	
 
	

	create_family("逍遥派", 2, "弟子");
	set("title","逍遥派第二代大弟子");
	setup();
	carry_object("d/xiaoyao/npc/obj/cloth")->wear();
}


void attempt_apprentice(object ob)
{

	if (ob->query_int() < 28) {
		command("shake"+ ob->query("id")); 
		command("say " + RANK_D->query_respect(ob) + 
			"逍遥派历来要求弟子天资甚高，你如此愚笨，恐怕不适合做逍遥派的弟子？");
 return;
 
 	}

	command("say 好吧，我就收下你了，今后要多加努力，替你师公报仇！");
	command("chat* 朗声说道：想不到能收到这一千年良才，我苏星河终于可以破除誓言啦！");
	command("recruit " + ob->query("id"));
	ob->set("title","逍遥派第三代弟子");
 }

string ask_book()
{
	object me,ob;
	mapping fam; 
	ob=this_player();
	if (!(fam = ob->query("family")) 
		|| fam["family_name"] != "逍遥派")
	{
		return"想要秘籍就得加入逍遥派。";
	}
	command("sigh");
	return"本派的武功秘籍藏在一个很秘密的地方，我也没去过。";
}



string ask_qi()
{
	object me,ob;
	mapping fam; 
	ob=this_player();
	if (!(fam = ob->query("family")) 
		|| fam["family_name"] != "逍遥派")
	{
		return"你并非我逍遥派的人，怎么放心让你解开秘密？";
	}
	command("sigh");
	return"剑心还没有做好这个秘密，没办法。";
}


