#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("无名老僧", ({ "wuming laoseng", "wuming", "laoseng" }));
	set("nickname", "扫地僧");
	set("long", 
		"他就是隐迹藏经阁的少林无名老僧。\n"
		"身穿一件破烂袈挲，手执扫把。\n"
		"他须发全白，双目有神。\n");
	set("gender", "男性");
	set("age", 100);
	set("attitude", "friendly");
	set("shen_type", 1000000);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("per", 30);
	
	set("max_qi", 50000);
	set("max_jing", 50000);
	set("neili", 50000);
	set("max_neili", 50000);
        set("eff_jingli",50000);
	set("jiali", 200);
	set("combat_exp", 20000000);
	set("score", 1000000);

	set_skill("force", 500);
	set_skill("yijin-jing", 500);
	set_skill("dodge", 500);
	set_skill("shaolin-shenfa", 500);
	set_skill("cuff", 500);
	set_skill("sword", 500);
	set_skill("parry", 500);
	set_skill("finger", 500);
	set_skill("ranmu-daofa", 500);
	set_skill("hand", 500);
	set_skill("strike", 500);
	set_skill("claw", 500);
	set_skill("staff", 500);
	set_skill("club", 500);
	set_skill("blade", 500);
	set_skill("whip", 500);
	set_skill("damo-jian", 500);
	set_skill("jingang-quan", 500);
	set_skill("buddhism", 500);
	set_skill("literate", 500);
        set_skill("nianhua-zhi",500);
        set_skill("yizhi-chan",500);
        set_skill("wuchang-zhang",500);
        set_skill("weituo-chu",500);
        set_skill("zui-gun",500);
        set_skill("longzhua-gong",500);
        set_skill("qianye-shou",500);
        set_skill("leg",500);
        set_skill("ruying-suixingtui",500);
        set_skill("banruo-zhang",500);
        set_skill("xiuluo-dao",500);
        set_skill("riyue-bian",500);
        set_skill("club",500);
        
	map_skill("force", "yijin-jing");
	map_skill("strike", "banruo-zhang");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "jingang-quan");
	map_skill("parry", "banruo-zhang");
	map_skill("club", "zui-gun");
	prepare_skill("strike", "banruo-zhang");
	create_family("少林派",34, "宗师");
	set("class", "bonze");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "club.zuida" :),
		(: perform_action, "cuff.jingang" :),
		(: perform_action, "strike.yipai" :),
	       	(: exert_function, "recover" :),
	}) );

	setup();
//	carry_object("/d/shaolin/obj/saoba")->wield();
}




void attempt_apprentice(object ob)
{
 string name,new_name;
 if(ob->query_temp("bai_wuming"))
{
         	command("chat" +ob->query("name")+"今日被老和尚收为小弟子，可喜可贺。\n");
                name = ob->query("name");
		new_name = "渡" + name[2..3];
		ob->set("name", new_name);
		ob->set("family/generation", 35);
		command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派渡字辈长老之一 !");
		command("recruit " + ob->query("id"));
	
		
	}
	return;

}

void fight_ob(object ob)
{
        ::fight_ob(ob);
        message_vision(HIR"$N摇了摇头，道：“佛法在于渡世，武功在于杀人。苦海无边，回头是岸。”\n这位施主精于武学，但确是唳气缠身，心入魔道，长久下去必然走火入魔。待老纳医治你吧。\n说完双眼直视$n，运起神功，$n只觉得丹田有如刀绞，痛入骨髓。\n"NOR,
                       this_object(), ob);
//        ob->unconcious();
}