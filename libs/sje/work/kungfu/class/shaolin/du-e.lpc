#include <ansi.h>
inherit F_MASTER;
inherit NPC;

string ask_me();
string ask_master();
void kill_ob();
void create()
{
        object ob;
        string wep;
        set_name("渡厄", ({ "du e", "e" }) );
        set("title", "少林长老");
        set("gender", "男性");
        set("class", "bonze");
        set("age", 90);
        set("no_get","这样东西对你来说太重了。\n");
        set("long", "这是一个面颊深陷，瘦骨零丁的老僧，他脸色枯黄，如同一段枯木。\n");
        set("attitude", "peaceful");
        set("combat_exp", 1500000);
        set("shen", 15000);
        set("str", 30);
        set("int", 25);
        set("dex", 28);
        set("con", 28);
        set("qi", 3500);
        set("max_qi", 3500);
        set("max_jing", 3000);
        set("eff_jingli", 2500);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        create_family("少林派", 35, "弟子");
        assign_apprentice("弟子", 0);
        set_skill("force", 180);
        set_skill("whip", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("buddhism", 180);
        set_skill("literate", 150);
        set_skill("yijin-jing", 180);
        set_skill("riyue-bian", 180);
        set_skill("shaolin-shenfa", 180);
        set_skill("finger", 180);
        set_skill("blade", 180);
        set_skill("xiuluo-dao", 180);
        set_skill("yizhi-chan", 180);
        map_skill("force", "yijin-jing");
        map_skill("blade", "xiuluo-dao");
        map_skill("whip",  "riyue-bian");
        map_skill("parry", "xiuluo-dao");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "yizhi-chan");
        prepare_skill("finger", "yizhi-chan");
        set("inquiry", ([
                "伏魔金铙"     : (: ask_me :),
                "无名神僧"   : (: ask_master:),
        ]));
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
         (: perform_action, "whip.chanrao" :),
         (: perform_action, "whip.fumoquan" :),
		(: exert_function, "recover" :),
	}) );

        setup();
        if (clonep()) {
                ob = unew(BINGQI_D("jinnao"));
                if (ob) {
                        destruct(ob);
                        ob = unew(BINGQI_D("jinnao1"));
                }
                if(!ob) ob = unew(BINGQI_D("heisuo"));               
                if (!ob) ob = unew(BINGQI_D("changbian"));
                ob->move(this_object());
                ob->wield();
                carry_object("/d/shaolin/obj/xuan-cloth")->wear();
        }       
}

void kill_ob(object me)
{     
 object ob;
if(!this_object()->is_killing(me->query("id"))){ 
    if(objectp(ob = present("du nan", environment(this_object())))
  && !ob->is_killing(me->query("id"))){
if (ob==this_object()) return;
 message_vision(HIY"长笑声中$n高宣佛号，神功劲力全力攻出，将$N困在中间！\n", me, ob);
         ob->kill_ob(me); 
         }
if(objectp(ob = present("du jie", environment(this_object())))
       && !ob->is_killing(me->query("id"))){
if (ob==this_object()) return;
         message_vision(HIY"长笑声中$n高宣佛号，神功劲力全力攻出，将$N困在中间！\n", me, ob);
         if(!ob->is_killing(me->query("id"))) ob->kill_ob(me);  
         }
}
  ::kill_ob(me); 
}
void init()
{
        object me, ob;
        mapping fam;
        me = this_player();
        ob = this_object();
        ::init();
        if(interactive(me)){
                if (mapp(fam = me->query("family")) && fam["family_name"] == "少林派" 
                && fam["generation"] <= 36 ) {
                        me->set_temp("fighter", 1);
                        return;
                        }
                if (mapp(fam = me->query("family")) && fam["family_name"] == "少林派" 
                && fam["generation"] > 36               
                && me->query("qi") < 50 ) {
                        me->move("/d/shaolin/qyping");
                        me->unconcious();
                        return;
                        }
//                COMBAT_D->do_attack(ob, me, query_temp("weapon") );
                COMBAT_D->do_attack(ob, me, query_temp("weapon") );
                me->set_temp("fighter", 1);
                remove_call_out("halt");
                call_out("halt", 0, me);
                return;
        }
        return;
}

void halt(object me)
{
     if(me->is_ghost()) return;
     if(!living(me) && environment(me) == environment()){
        message_vision("$N被渡厄用长鞭一卷，扔出了金刚伏魔圈！\n", me);
        me->move("/d/shaolin/qyping");  
        message_vision("$N被人丛金刚伏魔圈给扔了出来！\n", me);
        }
     else command("say 好吧，大家住手！ 看这家伙有什么话要说！");
}
void attempt_apprentice(object ob)
{
        if (ob->query("passdu")) {
                command("recruit " + ob->query("id"));
                return;
        }
        if (base_name(environment()) != "/d/shaolin/dmyuan" || !ob->query_temp("pending/waitdu")){
                command("say 对不起，老衲现在不收徒。");
                return;
        }
        ob->delete_temp("pending/waitdu");
        ob->set_temp("wait_nod", 1);
        command("say 依照少林寺历代规矩，" + RANK_D->query_respect(ob) + "你必须接下我三招，我才能收你为徒。");
}

string ask_me()
{
        mapping fam; 
        object ob, ob1, whip;
        
        if ( !this_player()->query_temp("fighter") 
        ||    this_player()->query("combat_exp") < 5000 ){
                command("say 大胆鼠辈，乳臭未干，竟敢偷入金刚伏魔圈，且让老衲来超度与你！");
                this_object()->kill_ob(this_player());
                this_player()->kill_ob(this_object());
                }
        if ( present("huangjin nao", this_player()) || present("fumo nao", this_player()))
                return RANK_D->query_respect(this_player()) + 
                "金铙只有一对，而且就在你身上，真是贪得无餍！";
        if ( present("huangjin nao", environment()) || present("fumo nao", environment()))
                return RANK_D->query_respect(this_player()) + 
                "金铙只有一对，而且就在这里任你取走，真是贪得无餍！";
        if(present("zhanyao nao", environment()) || present("zhanyao nao",this_player()))
                return RANK_D->query_respect(this_player()) + 
                "你有了斩妖金铙，就不能再拿伏魔金铙，莫要贪得无餍！";
        if ( present("jingang zhao", this_player()) || present("jingang zhao", environment()) )
                return RANK_D->query_respect(this_player()) + 
                "取了金刚罩，就不能再拿黄金铙，莫要贪得无餍！";
        if(!this_player()->query("family") || this_player()->query("family/family_name")!="少林派")      
                return RANK_D->query_respect(this_player()) + 
                "，金铙乃本寺达摩祖师传下之宝物，老衲可不敢拿来随意送人。";
        if ( present("fumo nao", this_object())){
                     message_vision("\n渡厄长笑一声，点点头，将手中的伏魔金铙用布包好。\n\n", this_player());
             command("give fumo nao to "+this_player()->query("id")); 
             whip = unew(BINGQI_D("heisuo")); 
             if(clonep(whip)){
                 whip->move(this_object());
                 command("wield bian"); 
                 }    
             else {
                whip = unew(BINGQI_D("changbian")); 
                whip->move(this_object());
                command("wield bian"); 
                }
             return "你既然能闯进金刚伏魔圈来，必然是当今武林中的非凡人物，这只铙是适逢其主了！";
             }

        ob = unew(BINGQI_D("jinnao"));
        if(!clonep(ob)) return "抱歉，你来晚了，黄金双铙已经给人拿走了。";   
        if(clonep(ob) && ob->violate_unique()){
           destruct(ob);
           return "抱歉，你来晚了，黄金双铙已经给人取走了。";
           }  
        ob1 = unew(BINGQI_D("jinnao1"));
        if(!clonep(ob1)) return "抱歉，你来晚了，伏魔金铙已经给人拿走了。";   
        if(clonep(ob1) && ob1->violate_unique()){
           destruct(ob1);
           return "抱歉，你来晚了，伏魔金铙已经给人取走了。";
           } 
        ob1->move(this_player());           
        message_vision("\n渡厄长笑一声，点点头，从身后的树洞里取出伏魔金铙交给$N。\n\n", this_player());
        return "你既然能闯进金刚伏魔圈来，必然是当今武林中的非凡人物，这只铙是适逢其主了！";
}
int accept_fight(object ob)
{
	object me  = this_object();
	object weapon;
        if ( !ob->query_temp("prepare_fight") ) return 0;
        if (ob->query_temp("win_du_e")) return notify_fail("你不是已经胜过老衲了吗，不要拿老衲开玩笑。\n"); 
        if (!weapon=present("hei suo",me)) 
        return notify_fail("渡厄说道：老衲遗失了护法圣物黑索，无法测试你的武功。\n"); 
if (me->is_fighting())
return notify_fail("倚多为胜，算什么英雄好汉?\n");
        message_vision("\n 渡厄点点头，说道：老衲使用的是日月鞭法，你要小心了。\n",this_player());
        me->reincarnate();
        me->set("neili",me->query("max_neili"));
       	me->set("chat_chance_combat", 60);
	me->set("chat_msg_combat", ({
		(: perform_action, "whip.chan" :),
	       	(: exert_function, "recover" :),
	}) );
	remove_call_out("checking");
	call_out("checking", 1, me, ob);
	ob->delete_temp("prepare_fight");
	return 1;
}

int checking(object me, object ob)
{

	object obj;
	int my_max_qi, his_max_qi;

	my_max_qi  = me->query("max_qi");
	his_max_qi = ob->query("max_qi");


	if (me->is_fighting()) 
	{
		call_out("checking",2, me, ob);
                return 1;
	}

	if ( !present(ob, environment()) ) return 1; 

	if (( (int)me->query("qi")*100 / my_max_qi) <= 50 ) 
	{
          	ob->set_temp("win_du_e",1);
             if (ob->query_temp("win_du_e")&&ob->query_temp("win_du_nan")&&ob->query_temp("win_du_jie")){
                command ("say 好，你已胜过老衲等三人，可自往藏经阁一代找寻恩师踪迹。\n");
                ob->delete_temp("win_du_e");
                ob->delete_temp("win_du_nan");
                ob->delete_temp("win_du_jie");
                ob->set_temp("bai_wuming",1);
                return 1;
               }
                ob->set_temp("win_du_e",1); 
		command("say 好功夫，老衲甘拜下风 !\n");
		return 1;
	}

	if (( (int)ob->query("qi")*100 / his_max_qi) < 50 ) 
	{
		command("say 看来" + RANK_D->query_respect(ob) + 
			"功力未纯，老衲实难让你再进一步 !\n");
		return 1;
	}

	return 1;  
}

#include "/kungfu/class/shaolin/du.h"
