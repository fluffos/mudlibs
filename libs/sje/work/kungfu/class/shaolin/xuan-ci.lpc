inherit NPC;
inherit F_MASTER;


void create()
{
        set_name("玄慈大师", ({
                "xuanci dashi",
                "xuanci",
                "dashi",
        }));
        set("long",
                "他是一位白须白眉的老僧，身穿一袭金丝绣红袈裟。\n"
                "他身材略显佝偻，但却满面红光，目蕴慈笑，显得神完气足。\n"
        );


        set("nickname", "少林寺方丈");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");
        set("unique", 1);
        set("no_get", 1);
        set("age", 70);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 2000);
        set("max_jing", 1000);
        set("neili", 2500);
        set("max_neili", 2500);
        set("jiali", 180);
        set("combat_exp", 1200000);
        set("score", 0);

        set_skill("force", 160);
        set_skill("yijin-jing",160);
        set_skill("dodge", 160);
        set_skill("shaolin-shenfa", 160);
        set_skill("finger", 160);
        set_skill("strike", 160);
        set_skill("hand", 160);
        set_skill("claw", 160);
        set_skill("parry", 160);
        set_skill("nianhua-zhi", 160);
        set_skill("sanhua-zhang", 160);
        set_skill("fengyun-shou", 160);
        set_skill("longzhua-gong", 160);
        set_skill("buddhism", 160);
        set_skill("literate", 160);

          map_skill("force", "yijin-jing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "nianhua-zhi");
        map_skill("strike", "sanhua-zhang");
        map_skill("hand", "fengyun-shou");
        map_skill("claw", "longzhua-gong");
        map_skill("parry", "nianhua-zhi");

        prepare_skill("finger", "nianhua-zhi");
        prepare_skill("strike", "sanhua-zhang");

        create_family("少林派", 36, "弟子");

        setup();

        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob)
{
        object me; 
        mapping ob_fam, my_fam;
     string name;

        me = this_object();
        my_fam  = me->query("family");

        name = ob->query("name");

        if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派")
        {
                command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
                return;
        }

        if ( (string)ob->query("class")!="bonze" && ob_fam["family_name"] == "少林派") 
        {
                command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺内学艺。");
                return;
        }

        if ( ob_fam["generation"] <= my_fam["generation"] )
        {
                command("say " + RANK_D->query_respect(ob) + "，贫僧哪里敢当 !");
                return;
        }

        if ( ob_fam["generation"] == (my_fam["generation"] + 1) && name[0..1] == "澄")
        {
                command("say " + ob_fam["master_name"] + "的徒弟怎麽跑到我这儿来了，哈哈哈 !");
                command("recruit " + ob->query("id"));
        }
        else
        {
                command("say " + RANK_D->query_respect(ob) + "，你辈份不合，不能越级拜师。");
                return;
        }

        return;
}
int accept_object(object apper, object ob)
{  
       int lvl;     

       if( ob->query("id") != "muou"){
          command("say 这东西我要来没用。");
          return 0;
       }
       if (!apper->query_temp("lh_teacher")||!apper->query_condition("lh_job")){
          message_vision("玄慈方丈一把夺过木偶，怒道：你从哪里偷来的?\n",apper);
          destruct(ob);   
          return 0;   
       }
       command("touch"+apper->query("id"));
       message_vision("玄慈感动的热泪盈眶，说道：我终于可以再重见我少林重宝了！\n",apper);
       command("thank"+apper->query("id"));
       lvl = apper->query_skill("yijin-jing",1); 
       lvl = random(lvl/2) + 10;
       apper->add("combat_exp",lvl);
       if (apper->query("potential") >=(apper->query("max_pot")-lvl/4))
       apper->set("potential", apper->query("max_pot"));   
       else 
       apper->add("potential", lvl/4);
       if ((int)apper->query_skill("yijin-jing",1)>=200){
          message_vision("玄慈说道：“我看大师对我易筋经神功已是非同小可，不如老衲把这木偶上的[降龙伏虎功]传授给你吧。\n",apper);
          tell_object(apper,"你听了方丈的讲解对少林另一路玄功有了一定认识，同时增进了你的易筋经修为。\n");   
          //lvl++;
          apper->improve_skill("yijin-jing",random((int)apper->query("int"))* 2);
       }
       destruct(ob);
       return 1;
}

void greeting(object ob)
{
       if( !ob || environment(ob) != environment() ) return;
         
       if(ob->query_temp("job_name")!="服侍玄慈方丈") return; 
       if(!(ob->query_temp("job_name")!="服侍玄慈方丈")){
         command("pat "+ob->query("id"));
         command("say " + RANK_D->query_respect(ob)+ "你就给我按摩一下吧(massage 方丈)呵呵呵。\n");
       }
}
