void create() {
  set_name("邪道魔头", ({ "motou", "mo" }));
  set("gender", "男性");
  set("long",
    "这家伙满脸横肉一付凶神恶煞的模样，令人望而生畏。\n");
  set("shen", -15000);
  set("attitude", "aggressive");
  set("age", random(20) + 25);
  set("str", 30 + random(5));
  set("int", 30 + random(5));
  set("con", 30 + random(5));
  set("dex", 30 + random(5));
  set("combat_exp", 99999);
  set("shen_type", -1);
  set("attitude", "peaceful");
  set("max_qi", 1999);
  set("eff_qi", 1999);
  set("qi", 1999);
  set("max_jing", 999);
  set("eff_jing", 999);
  set("jing", 999);
  set("max_jingli", 999);
  set("eff_jingli", 999);
  set("neili", 999);
  set("max_neili", 999);
  set("score", 10000);

  set("chat_chance", 20);
  //      set("chat_msg", ({                                                                                                                      
  //           (: random_move :),           
  //      }));
  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);

  setup();
  carry_object(ARMOR_D("armor/cloth"))->wear();
  if (clonep(this_object())) {
    switch (random(5)) {
      case 0:
        carry_object("/clone/medicine/liuyang-dan");
        break;
      case 1:
        carry_object("/clone/medicine/liuyang-dan");
        break;
      case 2:
        carry_object("/quest/shenshu/sdan");
        break;
      case 3:
        add_money("gold", 5 + random(5));
        break;
      case 4:
        carry_object("/clone/medicine/liuyang-dan");
        break;
    }
  }
}

void init() {
  object name1;
  object ob = this_player();
  object me = this_object();
  ::init();
  name1 = ob->query("id");
  if (interactive(ob)
    && !environment(ob)->query("no_fight")
    && (me->query_temp("killer") == name1)
  ) {
    me->set_temp("apply/attack", random(30));
    me->set_temp("apply/dodge", random(50));
    if (!me->query_temp("skillset")) {
      command("say " + "死秃驴哪里跑，今天非烧了少林寺不可！！！\n");
      remove_call_out("dest");
      call_out("dest", 200);
      me->set_leader(ob);
      remove_call_out("do_clone");
      call_out("do_clone", 0, me, ob);
      command("slogan" + ob->query("id"));
    } else {
      command("say 死秃驴哪里跑，今天非烧了少林寺不可！\n");
      me->set_leader(ob);
      remove_call_out("dest");
      call_out("dest", 200);
      remove_call_out("kill_ob");
    }
  }
}

int do_clone(object me, object ob) {
  mapping killerskill1;
  int number, k_qi, k_neili, k_jing, j, k;
  string t_force, t_dodge;
  number = (int)ob->query("max_pot");
  number = number - 100;
  k_qi = (int)ob->query("max_qi");
  k_jing = (int)ob->query("max_jing");
  k_neili = (int)ob->query("max_neili");
  j = (int)ob->query("dex");
  k = (int)ob->query("str");

  killerskill1 = skill2[random(sizeof(skill2))];
  number = (int)(number - (random(25) ? 1 : -1) * random(number / 10));
  me->set("dex", j * 6 / 5);
  me->set("str", k * 6 / 5);
  if (number > 100) number = 100;

  t_force = k_force[random(sizeof(k_force))];
  t_dodge = k_dodge[random(sizeof(k_dodge))];

  me->set_skill("force", number);
  me->set_skill("dodge", number);
  me->set_skill("parry", number);
  me->set_skill(t_force, number);
  me->set_skill(t_dodge, number);
  me->set_skill(killerskill1["t_skill"], number + random(5));
  me->set_skill(killerskill1["b_skill"], number + random(10));


  /* set killer's  skill maps */

  me->map_skill("force", t_force);
  me->map_skill("dodge", t_dodge);
  me->map_skill("parry", killerskill1["t_skill"]);
  me->map_skill(killerskill1["b_skill"], killerskill1["t_skill"]);

  /* set killer's skill prepares */

  me->prepare_skill(killerskill1["b_skill"], killerskill1["t_skill"]);

  /* copy entire dbase values */

  me->set("max_qi", k_qi);
  me->set("eff_qi", k_qi);
  me->set("qi", k_qi);
  me->set("max_jing", k_jing);
  me->set("eff_jing", k_jing);
  me->set("jing", k_jing);
  me->set("max_neili", k_neili);
  me->set("neili", k_neili);
  me->set("combat_exp", ob->query("combat_exp"));

  me->set_temp("skillset", 1);
  me->set_leader(ob);
  remove_call_out("kill_ob");
  //        call_out("kill_ob", 0, ob); 
  return 1;
}

void dest() {
  object me, ob;
  ob = this_player();
  me = this_object();
  write(me->query("name") + "道：他奶奶的，这次算你死秃驴跑的快，下回老子再来烧寺！\n", me);
  write(me->query("name") + "匆匆离开。\n", me);
  destruct(this_object());
}
