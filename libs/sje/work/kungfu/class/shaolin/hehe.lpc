#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name(GRN "无名神僧" NOR, ({ "wuming shenseng", "wuming" }));
  set("nickname", "扫地僧");
  set("long",
    "他就是隐迹藏经阁的少林派高僧无名神僧。\n"
    "身穿一件破烂袈挲，手执扫把。\n"
    "身材矮小，满面皱纹，看不出年纪大小。\n");
  set("gender", "男性");
  set("age", 200);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);

  set("max_qi", 5000);
  set("max_jing", 5000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("eff_jingli", 5000);
  set("jiali", 200);
  set("combat_exp", 3000000);
  set("score", 1000000);

  set_skill("force", 200);
  set_skill("yijin-jing", 200);
  set_skill("dodge", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("cuff", 200);
  set_skill("sword", 200);
  set_skill("parry", 200);
  set_skill("finger", 200);
  set_skill("shaolin-shenfa", 200);
  set_skill("hand", 200);
  set_skill("strike", 200);
  set_skill("claw", 200);
  set_skill("staff", 200);
  set_skill("club", 200);
  set_skill("blade", 200);
  set_skill("whip", 200);
  set_skill("damo-jian", 200);
  set_skill("jingang-quan", 200);
  set_skill("buddhism", 200);
  set_skill("literate", 100);
  set_skill("nianhua-zhi", 200);
  set_skill("yizhi-chan", 200);
  set_skill("wuchang-zhang", 200);
  set_skill("zui-gun", 200);
  set_skill("longzhua-gong", 200);
  set_skill("qianye-shou", 200);
  set_skill("banruo-zhang", 200);
  set_skill("xiuluo-dao", 200);
  set_skill("club", 200);

  map_skill("force", "yijin-jing");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("cuff", "jingang-quan");
  map_skill("parry", "jingang-quan");
  map_skill("club", "zui-gun");
  prepare_skill("cuff", "jingang-quan");
  create_family("少林派", 34, "宗师");
  set("class", "bonze");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "club.zuida" :),
    (: perform_action, "cuff.jingang" :),
    (: exert_function, "recover" :),
  }));

  setup();
  //	carry_object("/d/shaolin/obj/saoba")->wield();
}




void attempt_apprentice(object ob) {
  string name, new_name;
  if (ob->query_temp("bai_wuming")) {
    command("chat" + ob->query("name") + "今日被老和尚收为小弟子，可喜可贺。\n");
    name = ob->query("name");
    new_name = "渡" + name[2..3];
    ob->set("name", new_name);
    ob->set("family/generation", 35);
    command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派渡字辈长老之一 !");
    command("recruit " + ob->query("id"));


  }
  return;

}
