#include <ansi.h>
// dujie.c

inherit NPC;
inherit F_MASTER;
string ask_master();
string ask_me();
//  void kill_ob();

void create()
{
        object ob;
        set_name("渡劫", ({ "du jie", "jie" }) );
        set("title", "少林长老");
        set("gender", "男性");
        set("age", 90);
        set("no_get","这样东西对你来说太重了。\n");
        set("class", "bonze");
        set("long","这是一个面颊深陷，瘦骨零丁的老僧，他脸色惨白，象一张纸一样。\n");
        set("attitude", "peaceful");
        set("combat_exp", 1500000);
        set("score", 15000);
        set("str", 30);
        set("int", 25);
        set("dex", 28);
        set("con", 28);
     set("qi", 3500);
        set("max_qi", 3500);
        set("max_jing", 3000);
        set("eff_jingli", 2500);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);        
        create_family("少林派", 35, "弟子");
        assign_apprentice("弟子", 0);
        set_skill("force", 180);
        set_skill("whip", 180);
        set_skill("parry", 180);
        set_skill("claw", 180);
        set_skill("dodge", 180);
        set_skill("leg", 180);
        set_skill("finger", 180);
        set_skill("yijin-jing", 180);
        set_skill("riyue-bian", 180);
        set_skill("shaolin-shenfa", 180);
        set_skill("ruying-suixingtui", 180); 
        set_skill("longzhua-gong", 180);    
        set_skill("mohe-zhi", 180);
        set_skill("buddhism", 180);
        set_skill("literate", 150);
        map_skill("force", "yijin-jing");
        map_skill("claw", "longzhua-gong");
        map_skill("whip",  "riyue-bian");
        map_skill("parry", "riyue-bian");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "mohe-zhi");
        map_skill("leg", "ruying-suixingtui");
        prepare_skill("finger", "mohe-zhi");
        prepare_skill("leg", "ruying-suixingtui");
set("chat_chance_combat", 60);
 set("chat_msg_combat", ({
         (: perform_action, "whip.fumoquan" :),
              (: perform_action, "whip chanrao" :),
}));
        set("inquiry", ([
                "金刚罩"     : (: ask_me :),
                "无名神僧"   : (: ask_master:),
        ]));
        setup();
        if (clonep()) {                
                ob = unew(BINGQI_D("heisuo"));               
                if (!ob) ob = unew(BINGQI_D("changbian"));
                ob->move(this_object());
                ob->wield();
                carry_object("/d/shaolin/obj/xuan-cloth")->wear();
        }  
}

