void init()
{
        object me, ob;
        mapping fam;
        me = this_player();
        ob = this_object();
        ::init();
        if( interactive(me) ) 
        {
                if ( mapp(fam = me->query("family")) && fam["family_name"] == "少林派" 
                && fam["generation"] <= 36 ) {
                        me->set_temp("fighter", 1);
                        return;
                        }
                if ( mapp(fam = me->query("family")) && fam["family_name"] == "少林派" 
                && fam["generation"] > 36               
                && me->query("qi") < 50 ) {
                        me->move("/d/shaolin/qyping");
                        me->unconcious();
                        return;
                        }
//                COMBAT_D->do_attack(ob, me, query_temp("weapon") );
                COMBAT_D->do_attack(ob, me, query_temp("weapon") );
                me->set_temp("fighter", 1);
                return;
        }
        return;
}
void attempt_apprentice(object ob)
{
        if (ob->query("passdu")) {
                command("recruit " + ob->query("id"));
                return;
        }
        if (base_name(environment()) != "/d/shaolin/dmyuan" || !ob->query_temp("pending/waitdu")){
                command("say 对不起，老衲现在不收徒。");
                return;
        }
        ob->delete_temp("pending/waitdu");
        ob->set_temp("wait_nod", 1);
        command("say 依照少林寺历代规矩，" + RANK_D->query_respect(ob) + "你必须接下我三招，我才能收你为徒。");
}

string ask_me()
{
        mapping fam; 
        object ob;        
        if ( !this_player()->query_temp("fighter") 
        ||    this_player()->query("combat_exp") < 5000 ){
                command("say 大胆鼠辈，乳臭未干，竟敢偷入金刚伏魔圈，且让老衲来超度与你！");
                this_object()->kill_ob(this_player());
                this_player()->kill_ob(this_object());
                }
        if ( present("jingang zhao", this_player()) )
                return RANK_D->query_respect(this_player()) + 
                "宝罩只有一件，而且就在你身上，真是贪得无餍！";
        if ( present("jingang zhao", environment()) )
                return RANK_D->query_respect(this_player()) + 
                "宝罩只有一件，而且就在这里任你取走，真是贪得无餍！";
        if ( present("huangjin nao", this_player()) || present("huangjin nao", environment()) )
                return RANK_D->query_respect(this_player()) + 
                "取了黄金铙，就不能再拿金刚罩，莫要贪得无餍！";
        ob = unew(ARMOR_D("jingang-zhao"));
        if(!clonep(ob)) return "抱歉，你来晚了，金刚罩已经给人取走了。";
        if(clonep(ob) && ob->violate_unique()){
           destruct(ob);
           return "抱歉，你来晚了，金刚罩已经给人取走了。";
           }            
        ob->move(this_player());
        message_vision("\n渡劫一声不吭地瞧了$N半饷，扭过身，从树洞里取出金刚罩递给$N。\n\n", this_player());
        return "你能挨我们三个老不死的三招日月神鞭不死，确实是命大，这件金刚罩就是你的了！";
}
int accept_fight(object ob)
{
	object me  = this_object();
	object weapon;
        if ( !ob->query_temp("prepare_fight") ) return 0;
        if (ob->query_temp("win_du_jie")) return notify_fail("你不是已经胜过老衲了吗，不要拿老衲开玩笑。\n"); 
         if (!weapon=present("hei suo",me)) 
        return notify_fail("渡劫说道：老衲遗失了护法圣物黑索，无法测试你的武功。\n"); 
if (me->is_fighting())
return notify_fail("倚多为胜算什么英雄好汉?\n");
        message_vision("\n 渡劫点点头，说道：老衲使用的是如影随形腿，你要小心了。\n",this_player());
        me->reincarnate();
        me->set("neili",me->query("max_neili"));
       	me->set("chat_chance_combat", 60);
	me->set("chat_msg_combat", ({
		(: perform_action, "leg.ruying" :),
	       	(: exert_function, "recover" :),
	}) );
        command("unwield hei suo");
       remove_call_out("checking");
	call_out("checking", 1, me, ob);
	ob->delete_temp("prepare_fight");
	return 1;
}

int checking(object me, object ob)
{

	object obj;
	int my_max_qi, his_max_qi;

	my_max_qi  = me->query("max_qi");
	his_max_qi = ob->query("max_qi");


	if (me->is_fighting()) 
	{
		call_out("checking",2, me, ob);
                return 1;
	}

	if ( !present(ob, environment()) ) return 1; 

	if (( (int)me->query("qi")*100 / my_max_qi) <= 50 ) 
	{
	    ob->set_temp("win_du_jie",1);
            if (ob->query_temp("win_du_e")&&ob->query_temp("win_du_nan")&&ob->query_temp("win_du_jie")){
                command ("say 好，你已胜过老衲等三人，可自往藏经阁一代找寻恩师踪迹。\n");
                ob->delete_temp("win_du_e");
                ob->delete_temp("win_du_nan");
                ob->delete_temp("win_du_jie");
                ob->set_temp("bai_wuming",1);
               command("wield hei suo");
                return 1;
               }
                ob->set_temp("win_du_jie",1);
		command("say 好功夫，老衲甘拜下风 !\n");
                command("wield hei suo");
		return 1;
	}

	if (( (int)ob->query("qi")*100 / his_max_qi) < 50 ) 
	{
		command("say 看来" + RANK_D->query_respect(ob) + 
			"功力未纯，老衲实难让你再进一步 !\n");
                command("wield hei suo");
                ob->delete_temp("win_du_e");
                ob->delete_temp("win_du_nan");
                ob->delete_temp("win_du_jie");
         	return 1;
	}

	return 1;  
}
#include "/kungfu/class/shaolin/du.h"

