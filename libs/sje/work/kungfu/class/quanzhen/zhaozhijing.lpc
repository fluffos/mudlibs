inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("赵志敬", ({ "master zhao", "zhao zhijing", "zhao", "zhijing" }));
  set("master", "王处一");
  set("gender", "男性");
  set("age", 30);
  set("long",
    "他容貌不算俊，但却十分英挺，高高的个子，体格很健壮。\n"
    "他是王处一最得意的第子，也是全真教第三代中较出色的一个。\n");
  set("attitude", "peaceful");
  set("class", "taoist");

  set("str", 21);
  set("int", 19);
  set("con", 21);
  set("dex", 19);

  set("chat_chance", 1);
  set("chat_msg", ({
    "赵志敬说道：“杨过这小王八蛋差点害死我，活死人墓的玉蜂真厉害。”\n",
    "赵志敬喃喃道：“我一定要成为全真教掌教”。\n",
    //		(: random_move :),
  }));

  set("qi", 850);
  set("max_qi", 850);
  set("jing", 850);
  set("max_jing", 850);
  set("neili", 800);
  set("max_neili", 800);
  set("jiali", 50);

  set("combat_exp", 800000);
  set("score", 80000);

  set_skill("force", 120);             // 基本内功
  set_skill("tiangang-zhengqi", 120);    //天罡正气
  set_skill("unarmed", 120);           // 基本拳脚
  set_skill("kongmingquan", 120);     //空明拳 
  set_skill("dodge", 130);            // 基本躲闪
  set_skill("qixing-huanwei", 130);        //七星换位
  set_skill("parry", 120);             // 基本招架
  set_skill("sword", 120);             // 基本剑法
  set_skill("tiangang-jian", 120);        //天罡剑法 
  set_skill("taoism", 120);           //道学心法  
  set_skill("literate", 120);           //读书写字  


  map_skill("force", "tiangang-zhengqi");
  map_skill("unarmed", "tiangang-beidou");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "tiangang-jian");
  map_skill("sword", "tiangang-jian");

  create_family("全真教", 3, "第子");
  setup();

  carry_object("/d/quanzhen/npc/obj/changjian")->wield();
  carry_object("/d/quanzhen/npc/obj/greenrobe")->wear();

}

void attempt_apprentice(object ob) {

  command("smile");
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");

}
