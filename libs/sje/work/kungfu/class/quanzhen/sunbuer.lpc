//sunbuer.c 孙不二

inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("孙不二", ({ "sun buer", "sun", "buer" }));
  set("nickname", "清静散人");
  set("gender", "女性");
  set("age", 39);
  set("long",
    "她明目皓齿，肤色白腻，虽穿一身灰色道袍，也掩盖不了她的姿色。\n"
    "她就是全真七子中唯一的女性“清静散人”孙不二。\n");
  set("attitude", "peaceful");
  set("class", "taoist");

  set("str", 29);
  set("int", 32);
  set("con", 30);
  set("dex", 32);

  set("chat_chance", 1);
  set("chat_msg", ({
    "孙不二说道：“非本教第子不要乱走。”\n",
    (: random_move :),
  }));

  set("qi", 1200);
  set("max_qi", 1200);
  set("jing", 1250);
  set("max_jing", 1250);
  set("neili", 1200);
  set("max_neili", 12000);
  set("jiali", 100);

  set("combat_exp", 1800000);
  set("score", 50000);

  set_skill("force", 180);             // 基本内功
  set_skill("tiangang-zhengqi", 180);    //天罡正气
  set_skill("unarmed", 180);           // 基本拳脚
  set_skill("kongmingquan", 140);    //空明拳 
  set_skill("dodge", 180);            // 基本躲闪
  set_skill("qixing-huanwei", 180);        //七星换位
  set_skill("parry", 180);             // 基本招架
  set_skill("sword", 180);             // 基本剑法
  set_skill("tiangang-jian", 180);        //天罡剑法 
  set_skill("taoism", 180);            //道学心法  
  set_skill("literate", 180);           //读书写字  

  map_skill("force", "tiangang-zhengqi");
  map_skill("unarmed", "kongmingquan");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "tiangang-jian");
  map_skill("sword", "tiangang-jian");

  create_family("全真教", 2, "长老");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "sword.qixinggongyue" :),
    (: exert_function, "recover" :),
  }));



  setup();

  carry_object("/d/quanzhen/obj/changjian")->wield();
  carry_object("/d/quanzhen/obj/greyrobe")->wear();

}
