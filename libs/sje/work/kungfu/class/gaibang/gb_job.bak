#include <ansi.h>

string gb_job1()
{
        object me = this_player();
        
        if(me->query_temp("gb_job1"))
                return "你上次的任务还没有完成，我怎么放心再让你办事。\n";
        command("say 刚才我接到本帮弟子易大彪飞鸽传书，西夏国主起\n"
                +"大军十万，欲侵我大宋，前锋已出河套。\n" );
        new(__DIR__"obj/gaoji-wenshu")->move(me); 
        message_vision("$N给$n一张告急文书。\n", this_object(), me);
        me->set_temp("gb_job1",1);
        return "你速将这份告急文书交给边关守将侯君集，请他早做防备。\n" ;
}

int filldata(object obj1)
{
        if(wiz_level(obj1)) return 0;
        if(!environment(obj1)) return 0;
        else return 1;
}


string gb_job2()
{
        object me = this_player(), ob = this_object(), room;
        mixed *ob_list;
        int max,i;
        object obj1;
        
        if( me->query_temp("gb_job2") )
                return "你不是已经接过任务了吗？\n";
                
        ob_list = users();
        ob_list = filter_array(ob_list, (: filldata :));
        max=sizeof(ob_list);
        for (i=0;i<max;i++)
        {
                obj1 = ob_list[i];
                if (obj1->query_temp("gb_job2") )
                        return "这个任务我已经交给" + obj1->query("name") +"去做了。\n" ;
        } 

        if( me->query_condition("job_busy")
            || me->query_condition("gb_busy") 
            || ob->query_temp("gb_job2"))
                return "我这里现在没有什么任务可以给你。\n";
        ob->set_temp("gb_job2",1);                
        me->set_temp("gb_job2",1);
        me->apply_condition("gb_job2", 40);
        me->apply_condition("job_busy", 40);
        call_out("reset_room", 5);
        
        command("say 蒙古大军侵我大宋襄阳城，每次都以南阳为囤粮之所，\n"
                +   "郭靖郭大侠多次派人偷袭，均因守将防守严密而失败。\n" );
        return  "前几天本帮弟子打探到南阳城北有一处断崖，地势险峻，\n"
                +   "蒙古兵防守空虚。你从该处爬上去，伺机烧掉蒙古粮仓，\n"
                +   "以解我襄阳之围。\n";
}
void reset_room()
{
        object room;
        int i;
        for(i=1;i<=5;i++) {
                if(!room = find_object("/d/gb/liangcang" + i))
                        room = load_object("/d/gb/liangcang" + i);
                if(sizeof(all_inventory(room)) < 1)
                        room->reset();
        }
}
void reset_room2()
{
        object room;
        int i;
        for(i=1;i<=5;i++) {
                if(!room = find_object("/d/gb/zhongjun" + i))
                        room = load_object("/d/gb/zhongjun" + i);
                if(sizeof(all_inventory(room)) < 1)
                        room->reset();
        }
}
string gb_job3()
{
        object me = this_player(), ob = this_object();
        mixed *ob_list;
        int max,i;
        object obj1;
        
        if( me->query_temp("gb_job3") )
                return "你不是已经接过任务了吗？\n";
                
        ob_list = users();
        ob_list = filter_array(ob_list, (: filldata :));
        max=sizeof(ob_list);
        for (i=0;i<max;i++)
        {
                obj1 = ob_list[i];
                if (obj1->query_temp("gb_job3") )
                        return "这个任务我已经交给" + obj1->query("name") +"去做了。\n" ;
        }

        if( ob->query_temp("gb_job3") )
                return "我这里现在没有什么任务可以给你。\n";
                        
        command("say 蒙古大汉蒙哥令大将粘而帖率精兵数十万，兵分两路，企图\n"
                +   "犯我襄阳，襄阳百姓一夕数惊。为今之计，只有寻机刺杀\n"
		+   "蒙古大将，才能迫使蒙古大军撤围襄阳。\n" );
        
        ob->set_temp("gb_job3",1);
        me->set_temp("gb_job3",1);
        me->apply_condition("gb_job3",50);
        call_out("reset_room2", 5);                
        return  "我丐帮弟子易大彪已经潜入蒙古军中，你可去襄阳北门等他，\n"
                +   "由他带你混进蒙古大营，伺机刺杀蒙古大汉。\n" ;
}

string gb_job4()
{
    object me = this_player(), ob = this_object();
    int max,i;
    object obj1;
    object *ob_list;
    object ob2;
        
    if( me->query_temp("gb_job4") )
         return "你不是已经接过任务了吗？\n";
                
    ob_list = users();
    ob_list = filter_array(ob_list, (: filldata :));
    max=sizeof(ob_list);
    for (i=0;i<max;i++)
    {
        obj1 = ob_list[i];
        if (obj1->query_temp("gb_job4") )
            return "这个任务我已经交给" + obj1->query("name") +"去做了。\n" ;
    }

 if( ob->query_temp("gb_job4") )
        return "我这里现在没有什么任务可以给你。\n";
                        
    ob2 = new("/clone/npc/zhong-shentong");
    if( ob2 )
    {
        destruct(ob2);
    }
    
	command("say 我刚才接到本帮弟子易大彪飞鸽传书，西夏一品堂\n"
        +   "派遣大批高手东来，企图暗杀宋军主帅杨令公。\n" );
        
    ob->set_temp("gb_job4",1);
me->set_temp("gb_job4/asked",1);
    me->apply_condition("gb_job4",26);
            
    return  "颂摩崖是西夏武士东来的必经之地，你速带几名弟子埋\n"
        +   "伏在那里截杀。这批武士中不乏高手，你多带弟子，布\n" 
 		+   "下阵法，以策万全，切记切记。";
}
