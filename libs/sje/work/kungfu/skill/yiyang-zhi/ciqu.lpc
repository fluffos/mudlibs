#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h"
#include "/kungfu/skill/yiyang-zhi/liumai_msg.h"

int perform(object me, object target) {
  string msg, *limbs, limb, dodge_skill;
  int a, b, p, v, d, count, damage;

  int arg = (int)(me->query_skill("liumai-shenjian", 1) / 30);
  int level = (int)me->query_skill("liumai-shenjian", 1);

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("「此去彼来」只能在战斗中对对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「此去彼来」！\n");

  if ((int)me->query_skill("liumai-shenjian", 1) < 90)
    return notify_fail("你的六脉神剑不够娴熟，不会使用「此去彼来」。\n");

  if ((int)me->query_skill("force") < 300)
    return notify_fail("你的内功等级不够，不能使用「此去彼来」。\n");

  if ((int)me->query_str() < 35)
    return notify_fail("你的膂力不够强，不能使用「此去彼来」。\n");

  if (me->query_skill_prepared("finger") != "yiyang-zhi"
    || me->query_skill_mapped("finger") != "yiyang-zhi")
    return notify_fail("你现在无法使用「此去彼来」进行攻击。\n");

  if ((int)me->query("neili", 1) < 150 * arg)
    return notify_fail("你现在的内力不够使用「此去彼来」进行攻击。\n");

  if (!me->query_temp("start_6mai"))
    return notify_fail("你没有运用六脉神剑，怎可使出「此去彼来」绝招！\n");

  a = me->query("max_neili", 1);
  b = target->query("max_neili", 1);
  d = 1;
  if (arg > 6) arg = 6;
  v = me->query_skill("finger", 1);

  message_vision(
    MAG "$N" + chinese_number(arg) + "指连发，忽伸忽缩，或点或按，空中气流激荡，剑气自$N指中汹涌而出，此去彼来，连绵无尽。\n" NOR,
    me,
    target
  );

  limbs = target->query("limbs");

  for (count = 0; count < arg; count++) {
    if (objectp(target)
      && environment(me) == environment(target)
      && !target->is_ghost() && living(target)) {
      me->start_busy(1);
      target->start_busy(1);
      msg = liumai_msg[count * 5 + random(5)];
      limb = limbs[random(sizeof(limbs))];
      msg = replace_string(msg, "$l", limb);
      msg = replace_string(msg, "$w", "无形剑气");
      message_vision(msg, me, target);
      v += level + random(me->query_skill("force", 1));
      if (random(me->query("combat_exp")) > target->query("combat_exp") / (count + 1)) {
        d++;
        damage = v / 2 * a / b * count / d;
        if (damage > 1500) damage = 1500;
        target->receive_damage("qi", damage);
        target->receive_wound("qi", damage / 4);
        p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
        msg = damage_msg(damage, "刺伤");
        msg += "( $n" + eff_status_msg(p) + " )\n";
        msg = replace_string(msg, "$l", limb);
        msg = replace_string(msg, "$w", "无形剑气");
        me->add("neili", -50 * arg);
        if (wizardp(me)) tell_object(me, "ciqu_damage: " + damage + " \n");
        message_vision(msg, me, target);
      } else {
        me->add("neili", -100);
        dodge_skill = target->query_skill_mapped("dodge");
        if (!dodge_skill) dodge_skill = "dodge";
        message_vision(SKILL_D(dodge_skill)->query_dodge_msg(target, 1), me, target);
      }
    } else {
      continue;
    }
  }
  if (d > 1)
    tell_object(
      me,
      RED "\n“波、波、波、波。。”几声，对方被你" + chinese_number(d - 1) + "道无形剑气击中，滴滴鲜血飞溅到了你的额头上,慢。。慢。。的流了下来！\n" NOR
    );
  me->start_busy((d) / 2 + 1);
  me->start_perform(5, "「此去彼来」");
  return 1;
}
