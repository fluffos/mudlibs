// /kungfu/skill/liuyang-zhang/jie.c 解生死符
// By Edit Winter 2003.4
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int me_bmsg;
  int tar_bmsg;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character())
    return notify_fail("你要给谁解生死符。\n");
  if (target == me)
    return notify_fail("你无法给自己解生死符！\n");
  me_bmsg = (int)me->query_skill("beiming-shengong", 1);
  if (me_bmsg < 140)
    return notify_fail("你的北溟神功不够娴熟，不能解生死符。\n");
  if ((int)me->query_skill("liuyang-zhang", 1) < 140)
    return notify_fail("你的天山六阳掌不够娴熟，不能解生死符。\n");
  if ((int)me->query("neili", 1) < 500)
    return notify_fail("你现在内力太弱，不能解生死符。\n");
  tar_bmsg = target->query("ss_poison/bmsg");
  if (me_bmsg < tar_bmsg)
    return notify_fail("你擅自解你师兄下的生死符，就不怕他怪罪吗?\n");
  me->add("neili", -200);
  target->clear_condition("ss_poison");
  target->set("ss_poison/count", 0);
  msg = HIM "$N使出天山六阳掌，按解生死符的手法，快速的拍向$n的周身大穴。\n"
    + "" HIW "拔除了种在$n身上的生死符。 \n" NOR;
  target->delete("ss_poison");
  target->set("ss_poison/id", me->query("id"));
  message_vision(msg, me, target);
  return 1;
}
