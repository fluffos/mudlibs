int valid_enable(string usage) { return (usage == "strike") || (usage == "parry"); }
int valid_combine(string combo) { return combo=="zhemei-shou"; }
int valid_learn(object me)
{
      mapping fam  = me->query("family");
      if (fam["family_name"] != "逍遥派" )
           return notify_fail("你不是逍遥派弟子还想偷学六阳掌?!\n");
      if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练天山六阳掌必须空手。\n");
      if ((int)me->query("max_neili") < 500)
        return notify_fail("你的内力不够。\n");
      return 1;
}
string query_skill_name(int level)
{
          int i;
          for(i = sizeof(action)-1; i >= 0; i--)
                     if(level >= action[i]["lvl"])
                                return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    int i, j, level, busy_time,assi_int;
    object target = offensive_target(me);
    object victim;
    string *limbs, limb, msg;
       assi_int= random(me->query_int()-target->query_int());
    level = (int)me->query_skill("liuyang-zhang", 1);
    victim = me->select_opponent();
      
       if (victim && me)
       {
           if (victim)
           {
               if (victim->query("limbs"))
               {
                 limbs = victim->query("limbs");
                 limb = limbs[random(sizeof(limbs))];
               }
            busy_time = level/40;
           }
        if( ( random(level) > 100 && (random(10)>5 ) || assi_int>2) )
        {
        switch( random(5) )
        {
            case 1: msg = HIG"不料$N左掌一带，掌力绕过$N的身子，直拍向$p$l"NOR;
                break;
            case 2: msg = YEL"谁知$N一掌未竭第二掌又至，连催两重劲，掌力便如长蛇之游，奇诡不可设想"NOR;
                break;
            case 3: msg = HIW"$N凝聚真力，掌中化气为水，化水为冰"NOR;
                break;
            case 4: msg = YEL"$N一掌未竭第二掌又至，天山六阳的武功发挥自如"NOR;
                break;                  
            default: msg = WHT"突然间$N掌力破空，拍向$n"+limb+"，劲风扑面，锋利如刀，转而斜砍$p$l"NOR;
                break;
        }
        return ([
            "action": msg,
            "force" : level*2+random(620),
            "dodge" : 100,
            "damage": level*2+random(600),
            "damage_type":"内伤",
            ]);
       }
     }
    for( i = sizeof(action); i > 0; i-- )
      {
        if( level > action[i-1]["lvl"] )
            return action[NewRandom(i, 20, level/5)];
       }
}
int practice_skill(object me)
{
    int lvl = me->query_skill("liuyang-zhang", 1);
    int i = sizeof(action);
    while (i--) if (lvl == action[i]["lvl"]) return 0;
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练天山六阳掌。\n");
    if ((int)me->query("jingli") < 50)
        return notify_fail("你的体力不够练天山六阳掌。\n");
    me->receive_damage("jingli", 40);
    me->add("neili", -15);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"liuyang-zhang/" + action;
}
