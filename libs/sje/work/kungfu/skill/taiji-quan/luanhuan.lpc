// luanhuan.c 太极拳「乱环诀」字诀
// by snowman@SJ 26/11/1999

#include <ansi.h>

inherit F_SSERVER;

int is_pfm() { return 1; }

#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target) {
  int damage = 1;
  string msg, force, str;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target) || !living(target))
    return 0;

  if (!me->query_temp("taiji"))
    return notify_fail("太极拳讲究劲断意不断，你没有运用「太极」，又如何能使用「震」字诀？\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在真气不够，强迫使用「乱环诀」只会伤到你自己！\n");
  if (me->query_temp("weapon"))
    return notify_fail("你先放下手中的武器再说吧？！\n");

  str = (string)me->query("env/六合劲");
  if (str != "钻翻" && str != "螺旋" && str != "软手" && str != "开合" && str != "静恒" && str != "虚灵")
    str = "无";

  msg = CYN "\n$N使出太极拳中" RED "「乱环诀」" CYN "的功夫，";

  if (me->query_skill_mapped("force") != "yinyun-ziqi"
    || me->query_skill("yinyun-ziqi", 1) < 100) {
    msg += "连划了几个圈子，罩住了$n！\n" NOR;
    str = "无";
  }

  else msg += "运起氤氲紫气，右肩斜闪，左手凭空划了几个圈子，套住$n，欲其左则左，欲其右则右，然后以四两微力，拨动$p千斤巨力将一个个太极圆圈发出！\n" NOR;

  if (!stringp(force = target->query_skill_mapped("force")))
    force = "none";

  switch (force) {
    case "yinyun-ziqi": break;
    case "huntian-qigong":
    case "hamagong":
    case "longxiang-boruo": if (str == "钻翻") damage++; break;
    case "huagong-dafa":
    case "guiyuan-tunafa":
    case "dulong-dafa": if (str == "螺旋") damage++; break;
    case "yijin-jing":
    case "bihai-chaoshen":
    case "qiantian-yiyang":
    case "kurong-changong": if (str == "软手") damage++; break;
    case "shenyuan-gong":
    case "zixia-gong":
    case "shenghuo-shengong": if (str == "开合") damage++; break;
    case "lingji-zhuang":
    case "yunu-xinjing":
    case "shenzhao-jing": if (str == "静恒") damage++; break;
    default: if (str == "虚灵") damage++; break;
  }

  // msg += "Str = "+str+"，Force = "+force+"，Damage = "+damage+"\n";
  if (random(me->query("combat_exp") * me->query_int() / 100)
    > (int)target->query("combat_exp") * target->query_int() / 200) {
    msg += HIY "结果$n身不由己，被推进了$P的无形圈内！\n" NOR;
    me->start_busy(3);
    if (!target->is_busy()) target->start_busy(3);
    me->start_call_out((: call_other, this_object(), "hurt", me, target, damage, str :), 2);
  }

  else {
    msg += HIY "可是$p急中生智奋力一挣，竟然脱出了「乱环诀」！\n" NOR;
    me->start_busy(1 + random(2));
  }

  message_vision(msg, me, target);
  return 1;
}

int hurt(object me, object target, int damage, string str) {
  int p, j;
  float at;
  string msg;

  if (!target || !target->is_character() || !me->is_fighting(target) || damage < 1)
    return 0;

  switch (str) {
    case "钻翻": msg = CYN "\n$N双手左右连划，一个个圆圈层层叠叠已将$n套住，太极拳的" HIW "「" + str + "劲」" CYN "随即使出！\n" NOR; break;
    case "螺旋": msg = CYN "\n但见$N双臂一圈一转，使出「六合劲」中的" HIW "「" + str + "劲」" CYN "，已将$n层层圈住！\n" NOR; break;
    case "软手": msg = CYN "\n$N双手轻灵似羽，在$n身前右捺左收，" HIW "「" + str + "劲」" CYN "使得犹如行云流水，潇洒无比！\n" NOR; break;
    case "开合": msg = CYN "\n只见$N左掌阳、右掌阴，目光凝视左手手臂，双掌慢慢拉开，再又合拢，是凝重如山的" HIW "「" + str + "劲」" CYN "！\n" NOR; break;
    case "静恒": msg = CYN "\n$N右上左下双手半弧而住，$n只觉上盘各路已全处在$P双掌的" HIW "「" + str + "劲」" CYN "笼罩之下，无可闪避，无可抵御！\n" NOR; break;
    case "虚灵": msg = CYN "\n$N双手连划圆圈，虚灵顶劲，气沉丹田。不偏不倚，忽隐忽现，" HIW "「" + str + "劲」" CYN "无极而生！\n" NOR; break;
    default: msg = CYN "\n$N左圈右圈，一个圆圈跟着一个太极圆圈发出，登时便套住$n！\n" NOR; break;
  }


  if (target->query("neili") <= 0) {
    tell_object(target, "你猛然发觉自己真气已然枯竭耗尽，无法运劲相抗了！\n");
    msg += RED "只听一声巨响，$n口中鲜血狂喷，全身骨骼碎裂，眼见是活不成了！！\n" NOR;
    target->receive_damage("qi", (int)target->query("qi") + 1, me);
    j = (int)target->query("qi") * 100 / (int)target->query("max_qi");
    msg += damage_msg(p, "内伤") + "( $n" + eff_status_msg(j) + " )\n";
    message_vision(msg, me, target);
    return 1;
  }


  else if (me->query("neili") * 3 < target->query("neili")) {
    me->start_busy(2);
    target->start_busy(1 + random(2));

    damage = (int)target->query_skill("force") / 2;
    damage = damage / 2 + random(damage);

    me->receive_damage("qi", damage, me);
    me->receive_wound("qi", damage / 3, me);
    target->add("neili", -damage / 10);

    if (damage < 40) msg += HIY "不料$P受到$p的内力反震，闷哼一声。\n" NOR;
    else if (damage < 80) msg += HIY "不料$P被$p以内力反震，「嘿」地一声退了两步。\n" NOR;
    else if (damage < 160) msg += RED "不料$P被$p以内力反震，胸口有如受到一记重锤，连退了五六步！\n" NOR;
    else msg += HIR "不料$P被$p的内力反震，眼前一黑，身子向后飞出丈许！！\n" NOR;
    message_vision(msg, me, target);
    p = (int)me->query("qi") * 100 / (int)me->query("max_qi");
    msg += damage_msg(damage, "内伤") + "( $N" + eff_status_msg(p) + " )\n";
    message_vision(msg, me, target);
    return 1;
  }


  p = (int)me->query_skill("force") * 2;
  at = me->query("neili") / (target->query("neili") + 1);
  if (at < 1) {
    if (at < 0.5) p /= 2;
    p /= 2;
  } else p *= at;
  if (p > 3500) p = 3500;
  p *= damage;
  target->receive_damage("qi", p, me);
  target->receive_wound("qi", p / 4, me);
  if (target->query("neili") >= p / 4) target->add("neili", -(damage / 4));
  else target->set("neili", 0);

  me->add("neili", -(p / 4));
  me->add("jingli", -50);
  if (p > 1000)
    msg += "太极之意连绵不断，有如自去行空，一个圆圈未完，第二个圆圈已生，喀喇一响，$p一处骨头被绞断！\n";
  if (p > 2000)
    msg += "$N恨他歹毒，「震」字诀使出时连绵不断，跟着喀喀喀几声，$p全身各处骨头也被一一绞断！\n";
  j = (int)target->query("qi") * 100 / (int)target->query("max_qi");
  msg += damage_msg(p, "内伤") + "( $n" + eff_status_msg(j) + " )\n";
  message_vision(msg, me, target);
  return 1;
}
