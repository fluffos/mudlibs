// fei.c 清虚龙凤鞭
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("牵制攻击只能对战斗中的对手使用。\n");

  if (!me->query_skill("kurong-changong", 1) && (int)me->query_skill("qiantian-yiyang", 1) < 100)
    return notify_fail("你的乾天一阳功内功等级不够，不能使用「龙凤双飞」。\n");

  if ((int)me->query_skill("qingxu-bian", 1) < 100)
    return notify_fail("你的清虚龙凤鞭不够娴熟，不会使用「龙凤双飞」。\n");

  if (!weapon || weapon->query("skill_type") != "whip"
    || me->query_skill_mapped("whip") != "qingxu-bian"
    || me->query_skill_mapped("parry") != "qingxu-bian")
    return notify_fail("你现在无法使用「龙凤双飞」攻击。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你现在内力太弱，不能使用「龙凤双飞」。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

  msg = HIB "$N使出「龙凤双飞」，一条黑龙腾空而升，彩凤紧跟其后，企图把$n的周身缠绕起来。\n";

  me->add("neili", -100);
  me->add("jingli", -20);
  me->start_busy(random(1));
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2) {
    msg += "结果$p被$P攻了个措手不及ⅵ\n" NOR;
    target->start_busy((int)me->query_skill("qingxu-bian") / 20 + 1);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
    me->start_busy(5);
  }
  message_vision(msg, me, target);
  return 1;
}
