// roar.c 佛门狮子吼

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  object *ob;
  int i, skill, damage;

  if ((int)me->query("neili") < 600)
    return notify_fail("你的内力不够。\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");

  if ((int)me->query("PKS") > 50)
    return notify_fail("你杀人无算，如何能再用这慈悲为怀的佛门神功。\n");
  skill = me->query_skill("force");

  me->add("neili", -150);
  me->receive_damage("qi", 10);
  me->start_busy(5);
  message_vision(
    HIY "$N深深地吸一口气，真力迸发，发出一声惊天动地的巨吼。\n" NOR, me);

  ob = all_inventory(environment(me));

  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("con") * 2) continue;
    skill *= 2;
    if (wizardp(me))
      tell_object(me, "skill=" + chinese_number(skill) + "\n");
    damage = skill - ((int)ob[i]->query("max_neili") / 10);
    if (wizardp(me))
      tell_object(me, "damage1=" + chinese_number(damage) + "\n");
    if (skill < (int)ob[i]->query("neili") / 5)
      damage /= 4;
    if (wizardp(me))
      tell_object(me, "damage=" + chinese_number(damage) + "\n");
    if (damage > 0) {
      ob[i]->receive_damage("jing", damage * 2, me);
      if (damage >= (int)ob[i]->query("max_jing"))
        ob[i]->receive_wound("jing", ob[i]->query("max_jing") - 10);
      else ob[i]->receive_wound("jing", damage);
      tell_object(ob[i], "你觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样。\n");
    }
    skill = me->query_skill("force");
    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me)) ob[i]->kill_ob(me);
  }
  return 1;
}
