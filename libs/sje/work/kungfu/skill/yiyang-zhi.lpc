  ]),
  ([
    "action": "$N平推一剑，手中的$w看似渐渐沉重，使动时略比先前滞涩，但实是举轻若重，威猛之极",
    "damage_type": "刺伤",
  ]),
});

int valid_enable(string usage) {
  return usage == "finger" || usage == "parry" || usage == "sword";
}

int valid_combine(string combo) {
  object me = this_player();
  mapping myfam = (mapping)me->query("family");
  if (myfam["master_name"] == "枯荣长老"
    && (int)me->query_int() >= 42)
    return combo == "kurong-changong";
}

int valid_learn(object me) {
  if ((string)me->query("gender") != "男性")
    return notify_fail("一阳指乃是纯阳玄功，你如何可以修习？\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练一阳指必须空手。\n");
  if ((int)me->query_skill("qingyan-zhang", 1) < 70)
    return notify_fail("你的其它武功火候不够，无法学一阳指。\n");
  if (!me->query_skill("kurong-changong", 1))
    if ((int)me->query_skill("qiantian-yiyang", 1) < 100)
      return notify_fail("你的内功火候不够，无法学一阳指。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练一阳指。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action_finger) - 1; i >= 0; i--)
    return action_finger[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, j, level, a, b, c, d, e, f, lv, n;
  string msg;
  level = (int)me->query_skill("yiyang-zhi", 1);
  lv = (int)me->query_skill("liumai-shenjian", 1);
  a = me->query("neili");
  b = me->query_str();
  c = me->query_dex();
  d = me->query_con();
  e = me->query_skill("force", 1);
  f = me->query_skill("kurong-changong", 1);
  if (lv > 150) j = 5;
  else if (lv > 120) j = 4;
  else if (lv > 90) j = 3;
  else if (lv > 60) j = 2;
  else if (lv > 30) j = 1;
  else j = 0;
  j = j + 1;

  if (intp(n = me->query_temp("yyz/yz3m")) && n > 0) {
    switch (n) {
      case 3: msg = HIR "$N右手食指微曲，突然点出，使的竟然便是＂一阳指＂。但见$N食指幌动，来势虽缓，$n上半身正面大穴\n" +
        "却已全在$N一指笼罩之下，竟不知要点的是那一处穴道，九处大穴皆大指之虞" NOR; break;
      case 2: msg = HIY "$N招数未完，抢上数步，又是一指点出，这次却是指向$n小腹，这一指所盖罩的要穴更广，肚腹间冲脉十二大穴，自幽门、\n" +
        "通谷，下至中注、四满，直抵横骨、会阴，尽处于这一指威力之下" NOR; break;
      case 1: msg = HIW "跟着第三指又出，这一指迅如闪电，直指$n眉心，指尖闪动，似乎头部太阳，人中，百会．．等各大要穴尽在这一指笼罩" NOR; break;
      default: msg = HIR "$N忽地跃起，左掌抚胸，右手食指点出，招式未老，立即缩回，快似闪电，但着指之处，竟无分毫偏差，连点向\n" +
        "$n的强间、脑户、风府、大椎、陶道、身柱、神道、灵台．．等督脉三十大穴" NOR; break;
    }
    me->add_temp("yyz/yz3m", -1);
    return ([
      "action": msg,
      "damage": me->query_str() * 8 + random(200),
      "damage_type": "内伤",
      "dodge": random(3),
      "force": level * 2 + me->query("jiali") * 2,
      "skill_name": "一指点三脉",
      "weapon": "一阳指力",
    ]);
  }

  if (me->query("neili") > me->query("max_neili"))
    a = me->query("max_neili") + (me->query("neili") - me->query("max_neili")) / 10;
  if (a < 800) a = 800;
  if (a > 3000) a = 3000;
  if (me->query_temp("start_6mai")) {
    for (i = sizeof(action_finger); i > 0; i--)
      return ([
        "action": liumai_msg[random(j) * 5 + 1 + random(4)],
        "damage": random(2) ? (random(level / 2) + random(b) + lv) : lv,
        "damage_type": action_finger[NewRandom(i, 20, level / 5)]["damage_type"],
        "dodge": c / 2 + random(me->query_skill("dodge", 1) / 5) - random(40),
        "force": a / 10 + random(lv) / 2 + e,
        "parry": d / 2 - random(40) + random(me->query_skill("parry", 1) / 6),
        "weapon": "剑气",
      ]);
  }
  if (!weapon) {
    for (i = sizeof(action_finger); i > 0; i--)
      return ([
        "action": action_finger[NewRandom(i, 20, level / 5)]["action"],
        "damage_type": action_finger[NewRandom(i, 20, level / 5)]["damage_type"],
        "dodge": c / 2 + random(me->query_skill("dodge", 1) / 6) - random(40),
        "force": a / 15 + random(f) / 3 + 150,
        "parry": d / 2 - random(40) + random(me->query_skill("parry", 1) / 6),
        "skill_name": action_finger[NewRandom(i, 20, level / 5)]["skill_name"],
        "weapon": action_finger[NewRandom(i, 20, level / 5)]["weapon"],
      ]);
  } else {
    for (i = sizeof(action_sword); i > 0; i--)
      return ([
        "action": action_sword[NewRandom(i, 20, level / 5)]["action"],
        "damage": random(b / 10) * f / 3 + 50,
        "damage_type": action_sword[NewRandom(i, 20, level / 5)]["damage_type"],
        "dodge": c + random(me->query_skill("dodge", 1) / 5) - random(50),
        "force": a / 15 + random(level + f) / 2,
        "parry": d - random(40) + random(me->query_skill("parry", 1) / 5),
      ]);
  }
}

int practice_skill(object me) {
  if (!me->query_skill("kurong-changong", 1))
    if ((int)me->query_skill("qiantian-yiyang", 1) < 100)
      return notify_fail("你的乾天一阳功火候不够，无法练一阳指。\n");
  if ((int)me->query("jingli") < 70)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练一阳指。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -25);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yiyang-zhi/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string name, weapon;
  int j = 0;
  name = xue_name[random(sizeof(xue_name))];
  if ((int)me->query_skill("kurong-changong", 1) > 150) j = 3;

  if (victim->is_busy()) return 0;

  if (!objectp(weapon = me->query_temp("weapon"))) {
    if (me->query_skill_prepared("strike") == "kurong-changong"
      && me->query_skill_mapped("strike") == "kurong-changong") {
      if (!random(4)
        && me->query("neili") > 200
        && me->query_skill("kurong-changong", 1) > 120) {
        me->add("neili", -50);
        victim->start_busy(2);
        return CYN "$N一指点出,却中途化指为掌回抹,紧接着左掌右推,一股强劲无比的旋转气流将$n带得左右摇晃.\n" NOR;
      }
    } else if (!random(5)
      && me->query("neili") > 200
      && me->query_skill("yiyang-zhi", 1) > 120) {
      victim->start_busy(2 + random(j));
      me->add("neili", -50);
      if (victim->query("neili") <= (damage_bonus / 2))
        victim->set("neili", 0);
      else
        victim->add("neili", -(damage_bonus / 2));
      return CYN "紧接着$N食指一曲一弹,一道指力破空而出,正点中$n的" RED + name + CYN "，真气立时涣散！\n" NOR;
    }
  } else if (!random(5)
    && me->query("neili") > 200
    && me->query_skill("yiyang-zhi", 1) > 100) {
    victim->start_busy(2 + random(j));
    me->add("neili", -30);
    victim->receive_damage("qi", me->query_skill("yiyang-zhi", 1) / 3 + damage_bonus / 2);
    victim->receive_wound("qi", me->query_skill("yiyang-zhi", 1) / 2 + damage_bonus / 4);
    return CYN "只见$N手中长剑突然发出一股耀眼的光芒,$n被剑气刺中" RED + name + CYN "，真气不由得一滞！\n" NOR;
  }
}
