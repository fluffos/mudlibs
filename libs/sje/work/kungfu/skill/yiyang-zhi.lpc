mapping *action_sword = ({
  ([
    "action": "$N嘴角轻笑，提$w平胸，看准时机一剑刺出，激起呼呼风声，迅猛无比地直插$n$l",
    "damage_type": "刺伤",
  ]),
  ([
    "action": "$N左手捏个剑诀，右腕传动，将一阳指神功化于$w之上，出剑凝重，平平正正地刺向$n",
