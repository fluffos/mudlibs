// powerup.c 九阳神功加力

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill, i;
  if (target && target != me)
    return notify_fail("你只能用九阳神功来提升自己的战斗力。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_temp("jiuyang/powerup"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");
  i = skill / 6 + random(skill / 10);
  me->add("neili", -100);

  message_vision(HIR "$N微一凝神，运起九阳神功，只见$N的脸色变得红润多了。\n" NOR, me);

  me->add_temp("apply/attack", i * 2);
  me->add_temp("apply/strength", i / 2);
  me->add_temp("apply/damage", i * 2);

  me->add_temp("apply/armor", i * 5);
  me->add_temp("apply/parry", i * 2);
  me->set_temp("jiuyang/powerup", 1);

  me->start_call_out((: call_other, this_object(), "remove_effect", me, i :), skill);

  if (me->is_fighting()) me->start_busy(3);
  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/attack", -amount * 2);
  me->add_temp("apply/strength", -amount / 2);
  me->add_temp("apply/damage", -amount * 2);

  me->add_temp("apply/armor", -amount * 5);
  me->add_temp("apply/parry", -amount * 2);
  me->delete_temp("jiuyang/powerup");
  tell_object(me, "\n你的九阳神功运行完毕，将内力收回丹田。\n");
}
