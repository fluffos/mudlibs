// tisha.c 踢沙 
#include <ansi.h>
inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";
int remove_effect(object me, int f, int j);

int perform(object me, object target) {
  object weapon;
  int damage, p;
  string msg, dodge_skill;
  int f = me->query_skill("shenghuo-lingfa", 1) / 3;
  int j = me->query("jiali") / 3 + 20;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(WHT "「圣火绝学」只能对战斗中的对手使用。\n" NOR);

  if ((int)me->query_skill("shenghuo-lingfa", 1) < 180)
    return notify_fail(WHT "你的圣火令法功力太浅，不能使用。\n" NOR);

  if ((int)me->query_skill("jiuyang-shengong", 1) < 120)
    return notify_fail(WHT "你的九阳神功功力太浅，不能使用。\n" NOR);

  if ((int)me->query_skill("blade", 1) < 180)
    return notify_fail(WHT "你的基本刀法功力太浅，不能使用。\n" NOR);

  if ((int)me->query_skill("qiankun-danuoyi", 1) < 180)
    return notify_fail(WHT "你的乾坤大挪移功力太浅，不能使用。\n" NOR);

  if ((int)me->query("max_neili") < 2500)
    return notify_fail(WHT "你的内力太浅，不能使用。\n" NOR);

  if ((int)me->query("neili") < 500)
    return notify_fail(WHT "你的真气不够，不能使用。\n" NOR);

  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "blade"
    || me->query_skill_mapped("blade") != "shenghuo-lingfa"
    || me->query_skill_mapped("force") != "jiuyang-shengong"
    || me->query_skill_mapped("parry") != "qiankun-danuoyi"
    || me->query_skill_mapped("cuff") != "shenghuo-lingfa")
    return notify_fail(WHT "你不能使用这个绝招！\n" NOR);

  if ((int)me->query_temp("shlf/on_sh"))
    return notify_fail(WHT "你刚使完「踢沙」，真气无法畅通。\n" NOR);

  me->add("neili", -400);
  me->add("jingli", -50);
  me->set_temp("shlf/sh", 2);
  me->add_temp("apply/attack", f);
  me->add_temp("apply/damage", j);

  message_vision(HIM "\n$N突然横腿疾扫，卷起地下大片沙石，身子一分为二，前后夹击、连攻四招！\n" NOR, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  if (present(target, environment(me)) && me->is_fighting(target))
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

  if (target->query_skill("beiming-shengong", 1) > 300
    || target->query_skill("yijin-jing", 1) > 300
    || target->query_skill("jiuyin-zhengong", 1) > 100
  ) {
    msg = HIR "\n$N生平没有遇到如此强劲的对手，突然想到九阳神功的一句口诀：\n\n[他强归他强，明月照大江！他狠归他狠，轻风拂山岗！]\n\n猛然间领悟到了这句口诀的意思，于是猛然运足一口九阳真气向着$n顶去。\n\n$n眼前猛的一黑。" NOR;
    message_vision(msg, me, target);
    target->receive_damage("qi", target->query("max_qi") / 2);
    target->receive_wound("qi", target->query("max_qi") / 4);
  }

  if (present(target, environment(me)) && me->is_fighting(target)) {
    msg = HIC "\n$n在霎时之间，但觉飞雪扑面，双眼不能见物，茫然不知所措，$N趁势用" YEL "肩部" HIC "从背后向$n撞去！\n" NOR;
    if (me->query_skill("force") > target->query_skill("force") / 2 || !living(target)) {
      damage = (int)me->query_skill("force") * 2;  //以基本内功和九阳神功的高低，取决杀伤力的大小！
      damage = damage + random(damage);
      target->receive_damage("qi", damage);
      target->receive_wound("qi", damage / 2);
      msg += HIR "结果$n被$N的" YEL "肩部" HIR "一撞，后心有如受到一记重锤，向前急冲了五六步！\n" NOR;
      p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
      msg += "( $n" + eff_status_msg(p) + " )\n";
    } else {
      dodge_skill = target->query_skill_mapped("dodge");
      if (!dodge_skill) dodge_skill = "dodge";
      msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    }
    message_vision(msg, me, target);
  } else {
    me->delete_temp("shlf/sh");
    me->set_temp("shlf/on_sh", 1);
    me->start_busy(1);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, f, j :), 15);
    return 1;
  }
  if (present(target, environment(me)) && me->is_fighting(target)) {
    msg = CYN "\n$N随着$n的去式，巧运" HIR "乾坤大挪移神功" CYN "，钻到$n的身前，将手中令牌向$n的腹部插去！\n" NOR;
    if (random(me->query_skill("force")) > target->query_skill("force") / 2 || !living(target)) {
      target->start_busy(random(3));
      damage = (int)me->query_skill("force");  //以基本内功和九阳神功的高低，取决杀伤力的大小！
      damage += (int)me->query_skill("shenghuo-lingfa", 1);
      damage += (int)me->query_skill("qiankun-danuoyi", 1);
      damage = damage + random(damage);
      target->receive_damage("qi", damage);
      target->receive_wound("qi", damage / 2);
      msg += HIR "结果$n一声惨嚎，$N已将$n的" HIY "护体真气" HIR "打碎，令牌插入$n的" HIY "小腹" HIR "，将$n的肋骨根根绞断！\n" NOR;
      p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
      msg += "( $n" + eff_status_msg(p) + " )\n";
    } else {
      me->start_busy(1);
      dodge_skill = target->query_skill_mapped("dodge");
      if (!dodge_skill) dodge_skill = "dodge";
      msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    }
    message_vision(msg, me, target);
  } else {
    me->delete_temp("shlf/sh");
    me->set_temp("shlf/on_sh", 1);
    me->start_busy(1);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, f, j :), 15);
    return 1;
  }
  me->delete_temp("shlf/sh");
  me->set_temp("shlf/on_sh", 1);
  me->start_busy(1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, f, j :), 15);
  return 1;
}

int remove_effect(object me, int f, int j) {
  me->add_temp("apply/attack", -f);
  me->add_temp("apply/damage", -j);
  me->delete_temp("shlf/on_sh");
  message_vision(HIW "\n$N长出一口气，将紊乱的内力一丝丝的归入丹田！\n\n" NOR, me);
  return 0;
}
