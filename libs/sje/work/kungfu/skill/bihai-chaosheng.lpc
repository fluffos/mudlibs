
// bihai-chaosheng.c

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

#include <ansi.h>
#include "force.h"

int valid_learn(object me)
{
        int lvl = (int)me->query_skill("bihai-chaosheng", 1);
        if ( me->query("gender") == "无性" && lvl > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的碧海潮生神功。\n");
        return valid_public(me);
}

int practice_skill(object me)
{
        return notify_fail("碧海潮生功只能用学(learn)方法的来增加熟练度。\n");
}

string exert_function_file(string func)
{
        return SKILL_D("bihai-chaosheng/") + func;
}

mapping exercise_msg(object me)
{
  return ([
      "status_msg" : HIG + me->name()+"神情闲逸，恍若已入无人之境" NOR,
      "start_my_msg" : "你盘腿而坐，心中默念要诀，思绪仿佛翱翔于碧海蓝天之上，不由的内息涌动，浑身畅快无比。\n",
      "start_other_msg" : HIG + me->name()+"盘腿而坐，心中默念要诀，思绪仿佛翱翔于碧海蓝天之上，不由的内息涌动，浑身畅快无比。\n"NOR,
//    "halt_msg" : "$N周身微微颤动，长出口气，站了起来。\n",
      "end_my_msg" : "你思绪渐静，不知不觉中真气已调理完毕，于是长长呼出一口气，缓缓站起。\n",
      "end_other_msg" : HIG + me->name()+"思绪渐静，长长呼出了一口气，缓缓站起身来。\n"NOR
        ]);
}

