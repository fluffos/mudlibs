//by snowman@SJ 03/06/99

#include <ansi.h>
int exert(object me) {
  int skill;

  if (!me->is_fighting())
    return notify_fail("你必须在战斗中才能运用氤氲紫气。\n");
  if (me->query_temp("yinyun"))
    return notify_fail("你已在运用氤氲紫气了。\n");

  if (me->query_skill("yinyun-ziqi", 1) < 180
    || me->query_skill("force", 1) < 180
    || me->query_skill("taoism", 1) < 180)
    return notify_fail("以你目前的修为来看，还不足以运用氤氲紫气！\n");

  if (userp(me) && me->query_skill_mapped("force") != "yinyun-ziqi")
    return notify_fail("你的内功不对，根本不能使出「氤氲紫气」。\n");
  if (userp(me) && me->query_skill_mapped("cuff") != "taiji-quan")
    return notify_fail("太极之「氤氲紫气」诀窍必须在激发太极拳的情况下才能使用。\n");

  if (me->query("max_neili") < 2500)
    return notify_fail("你的内力修为不够运用氤氲紫气所需！\n");

  if (me->query("neili") < 500)
    return notify_fail("你的内力不够运用氤氲紫气所需！\n");

  skill = me->query_skill("yinyun-ziqi", 1) + me->query_skill("taoism", 1);

  tell_object(me, HIW "\n你默运内功，将「氤氲紫气」的极限发挥出来，运转于雄口大穴之上，确保心脉不死！\n" NOR);
  message_vision(MAG "\n$N提一口「氤氲紫气」，将气息运转于全身经脉之中，脸上渐渐显出紫色的流光！\n\n" NOR, me);

  me->set_temp("yinyun", skill);

  remove_call_out("checking");
  call_out("checking", 1, me);
  me->add("neili", -300);
  return 1;
}

void checking(object me) {
  int amount = me->query_skill("medicine", 1);

  if (!me || !me->query_temp("yinyun")) return;

  if (me->is_ghost() || !living(me)) {
    me->delete_temp("yinyun");
    return;
  }

  if (!me->is_fighting() || me->query("neili") < 500) {
    message_vision("\n$N吐出一口淤气，脸上的紫色的流光也渐渐消失了。\n\n", me);
    me->delete_temp("yinyun");
    return;
  }

  if ((me->query("eff_qi") < me->query("max_qi") / 4 * 3) && me->query_temp("yinyun") && amount > 0) {
    if (userp(me))
      me->add("neili", -50);
    else me->add("neili", -25);
    me->receive_curing("qi", amount);
    me->add_temp("yinyun", -1);
    message_vision("$N全身紫光流动，将伤口处的流血自动止住了！\n", me);
    call_out("checking", 3, me);
    return;
  }

  call_out("checking", 1, me);
}
