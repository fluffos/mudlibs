// posan.c 魂飞破散
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;

		damage = (int)me->query_skill("qishang-quan", 1);

                damage = random(damage)*10;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「魂飞破散」只能对战斗中的对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用「魂飞破散」！\n");              

        if( (int)me->query_skill("qishang-quan", 1) < 150 )
                return notify_fail("你的七伤拳不够娴熟，不会使用「魂飞破散」!\n");

        if( (int)me->query("neili", 1) < 300 )
                return notify_fail("你现在内力太弱，不能使用「魂飞破散」!\n");

        msg = HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "魂飞破散" HIY "」，双拳势如雷霆，向$n击去。\n"NOR;

        if (random(me->query_skill("qishang-quan")) > target->query_skill("force")/3 )
        {
		me->start_busy(random(2));
                target->start_busy(random(3));

                target->receive_damage("qi", damage);
		target->receive_wound("qi", damage/2);
                me->add("neili", -damage/3);

                if( damage < 40 )
                        msg += HIY"结果$n被$N双拳打在胸口，闷哼一声。\n"NOR;
                else if( damage < 80 )
                        msg += HIY"结果$n被$N以双拳打在胸口，「嘿」地一声退了两步。\n"NOR;
                else if( damage < 160 )
                        msg += RED"结果$n被$N以双拳打在胸口，有如受到一记重锤，连退了五六步！\n"NOR;
                else
                        msg += HIR"结果$n被$N的双拳打在胸口，眼前一黑，象一捆稻草一样飞出去好几丈远！\n"NOR;
                
        }
        else 
        {
		me->start_busy(random(4));
                msg += CYN"可是$p看破了$P的企图，身形一转，反身回击。\n"NOR;
        }
        message_vision(msg, me, target);

        return 1;
}
