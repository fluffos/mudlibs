// kuangfeng-daofa.c 狂风刀法

#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N端坐不动，一招「秋风拂叶」，手中$w带着一股劲风，击向$n的脸颊",
    "dodge": -10,
    "damage": 120,
    "lvl": 20,
    "skill_name": "秋风拂叶",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N单臂一挥，一招「天地交轰」，手中$w由上直下直取$n的身后",
    "dodge": -10,
    "damage": 130,
    "lvl": 20,
    "skill_name": "玉带围腰",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一转，一招「流云断川」，手中$w如矫龙般腾空一卷，猛地向$n劈头打下",
    "dodge": -20,
    "damage": 135,
    "lvl": 40,
    "skill_name": "流云断川",
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N力贯刀背，一招「春风化雨」，手中$w舞出满天幻影，排山倒海般剁向$n全身",
    "dodge": -40,
    "damage": 150,
    "lvl": 50,
    "skill_name": "春风化雨",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽的向前一跃，一招「野马分鬃」，手中$w若一分为二，连环分击$n左右",
    "dodge": -50,
    "damage": 160,
    "lvl": 60,
    "skill_name": "野马分鬃",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N快步上前，一招「竹影扫阶」，手中$w化为万千光芒罩向$n前胸",
    "dodge": -60,
    "damage": 170,
    "lvl": 70,
    "skill_name": "竹影扫阶",
    "damage_type": "内伤"
  ])
});

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int valid_learn(object me) {
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("qiufeng-chenfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  return 1;
}

string perform_action_file(string action) {
  if (this_player()->query_skill("kuangfeng-daofa", 1) >= 100)
    return __DIR__ "kuangfeng-daofa/" + action;
}
