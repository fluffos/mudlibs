#include <ansi.h>
inherit SKILL;

#include "/kungfu/skill/eff_msg.h";


string *xue_name1 = ({
  "大锥穴",
  "百会穴",
  "志室穴",
  "肩井穴",
  "劳宫穴",
  "内关穴",
  "外关穴",
  "会宗穴",
});

