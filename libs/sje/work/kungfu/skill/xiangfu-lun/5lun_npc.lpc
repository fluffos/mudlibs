// changed by emnil	2/6/2000

#include <ansi.h>
inherit NPC;

int check_fight(object me, object ob);
int att(object me, object ob, object target);
int remove_effect2(object ob, object weapon);
int remove_effect(object me, object ob, object weapon);
int check_target(object me, object target);

void create() {
  set_name("五轮大转之Perform NPC", ({ "wulun npc", "npc" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 25);
  set("env/invisibility", 1);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("max_jingli", 2000);
  set("neili", 500);
  set("max_neili", 500);
  set("jiali", 20);
  set("combat_exp", 1000);
  set_skill("force", 50);
  set_skill("longxiang-boruo", 50);
  set_skill("xiangfu-lun", 200);
  set_skill("strike", 50);
  set_skill("dodge", 50);
  set_skill("hammer", 50);
  map_skill("force", "longxiang-boruo");
  map_skill("hammer", "xiangfu-lun");
  setup();
}

void do_setup(object me) {
  set("name", me->name());

  set_skill("longxiang-boruo", me->query_skill("longxiang-boruo", 1));
  set_skill("force", me->query_skill("force", 1));
  set_skill("xiangfu-lun", me->query_skill("xiangfu-lun", 1));
  set_skill("hammer", me->query_skill("hammer", 1));
  set_skill("strike", me->query_skill("hammer", 1));
  set_skill("dodge", me->query_skill("dodge", 1));
  set("combat_exp", me->query("combat_exp"));
  add_temp("apply/hammer", me->query_skill("xiangfu-lun", 1) * 2 / 5);
  set("have_master", me);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "hammer.wushuai" :)
  }));

  if (me->query_temp("xs/longxiang")) {
    set_temp("xs/longxiang", 1);
    add_temp("apply/hammer", me->query_skill("force") / 6);
  } else
    set_temp("xs/longxiang", 0);

  set("time", time());
  set("last", me->query_skill("hammer") / 5);
  me->start_perform(6, "五轮大转");

  remove_call_out("check_fight");
  call_out("check_fight", 2, me, this_object());
}

int check_fight(object me, object ob) {
  object weapon, target, *enemy, where;
  int sz;

  if (!this_object()) return 0;
  if (!ob) return 0;

  where = environment(this_object());
  weapon = ob->query_temp("weapon");

  if (!me) {
    remove_effect2(ob, weapon);
    return 0;
  }
  if (!(enemy = me->query_enemy()) || !arrayp(enemy)) remove_effect(me, ob, weapon);
  if ((time() - query("time")) > query("last")) remove_effect(me, ob, weapon);

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;
  if (sz > 0) target = enemy[random(sz)];
  else remove_effect(me, ob, weapon);

  set("neili", me->query("neili"));
  set("max_neili", me->query("max_neili"));
  set("jiali", me->query("jiali"));
  if (query("jiali") < 30) set("jiali", 30);

  if (!living(me)) {
    me->delete_temp("xfl_5lun");
    remove_effect2(me, weapon);
  } else if (!me->is_fighting()) {
    if (!ob->query_temp("stopped")) {
      ob->set_temp("stopped", 1);
      call_out("check_fight", 2, me, ob);
    } else remove_effect(me, ob, weapon);
  } else if (me->query_temp("weapon")) {
    message_vision(HIY "$N手中多了兵刃，飞行中的$n" HIY "顿时无法控制了！\n" NOR, me, weapon);
    me->delete_temp("xfl_5lun");
    remove_effect2(me, weapon);
  } else if (me->query_skill_mapped("hammer") != "xiangfu-lun") {
    message_vision(HIY "$N变换了轮法招数，飞行中的$n" HIY "顿时无法控制了！\n" NOR, me, weapon);
    me->delete_temp("xfl_5lun");
    remove_effect2(me, weapon);
  } else if (me->query_skill_mapped("force") != "longxiang-boruo") {
    message_vision(HIY "$N变换了内功招数，飞行中的$n" HIY "顿时无法控制了！\n" NOR, me, weapon);
    me->delete_temp("xfl_5lun");
    remove_effect2(me, weapon);
  } else if (me->query("neili") < 300) {
    message_vision(HIY "$N内力消耗甚巨，再也控制不了飞行中的$n" HIY "了！\n" NOR, me, weapon);
    me->delete_temp("xfl_5lun");
    remove_effect2(me, weapon);
  } else if (target->query("qi") * 3 <= target->query("max_qi") && !me->is_killing(target->query("id")))
    call_out("check_fight", 1, me, ob);
  else if (!(random(3) == 1))
    att(me, ob, target);
  else call_out("check_fight", 1, me, ob);

  return 1;
}

int check_target(object me, object target) {
  if (target->query("qi") * 3 <= target->query("max_qi")
    && !target->is_killing(me->query("id"))
    && !me->is_killing(target->query("id"))) {
    me->remove_enemy(target);
    target->remove_enemy(me);
  }

  return 1;
}
int att(object me, object ob, object target) {
  COMBAT_D->do_attack(ob, target, ob->query_temp("weapon"), 1);
  me->add("neili", -(50 + random(100)));

  check_target(me, target);

  remove_call_out("check_fight");
  call_out("check_fight", 1 + random(2), me, ob);

  return 1;
}


int remove_effect2(object ob, object weapon) {
  message_vision(HIW "\n$n" HIW "在空中旋转飞行之势已弱，当当当几声，都落到了地上。\n" NOR, ob, weapon);
  weapon->move(environment(ob));
  remove_call_out("check_fight");
  destruct(this_object());
  return 0;
}

int remove_effect(object me, object ob, object weapon) {
  object wep;
  wep = me->query_temp("weapon");

  message_vision(HIY "\n$n" HIY "在$N身旁绕了个圈子，$P伸手一招，那飞行中的$n" HIY "便重行飞回$P的手中！\n\n" NOR, me, weapon);
  weapon->move(me);
  if (!wep) weapon->wield();
  me->delete_temp("xfl_5lun");
  me->reset_action();
  remove_call_out("check_fight");
  destruct(this_object());

  return 0;
}
