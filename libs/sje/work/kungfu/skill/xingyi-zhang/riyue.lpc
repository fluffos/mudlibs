// riyue

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;

int i; 
i = 0;       
        if( !target ) target = offensive_target(me);

        if( !target || !me->is_fighting(target) )
                return notify_fail("「日月同辉」只能在战斗中对对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("使用「日月同辉」时双手必须空着！\n");

        if( (int)me->query_skill("xingyi-zhang", 1) < 101 )
                return notify_fail("你的星移掌不够娴熟，不会使用「日月同辉」。\n");

        if( (int)me->query_skill("shenyuan-gong", 1) < 101 )
                return notify_fail("你的神元功等级不够，不能使用「日月同辉」。\n");

        if( (int)me->query_con() < 24 )
                return notify_fail("你的体质不够强，强行使用「日月同辉」会经脉尽断\n");

        if (me->query_skill_prepared("strike") != "xingyi-zhang"
        || me->query_skill_mapped("strike") != "xingyi-zhang")
                return notify_fail("你现在无法使用「日月同辉」进行攻击。\n");                                                                                
      

        if( (int)me->query("neili") < 800 )
                return notify_fail("你现在内力太弱，不能使用「日月同辉」。\n"); me->add("neili", -100);
        me->add("jing", -40);
        message_vision(HIG "\n$N气运丹田双掌一拍，仰天长啸「"HIR"日月同辉"HIG"」！\n" NOR,me, target);

        me->add_temp("apply/strength", i);
        me->add_temp("apply/dexerity", i);
        me->add_temp("apply/attack", i);
        me->add_temp("apply/damage", i);
if ( (int)me->query("combat_exp")/2 < (int)target->query("combat_exp") &&
         random(10)>2)
{

if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      
message_vision(HIG"紧接着$N抽出左掌，身形一矮，由下而上猛袭向$n的小腹！\n" NOR,me, target);
message_vision("结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n" NOR,me, target);

if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);


message_vision(HIR"只见$N右掌随后而至，凌空一跃，犹如晴空霹雳拍向$n的头部！\n" NOR,me, target);
message_vision("结果「轰」地一声，$n朝后猛地倒退几步，口中鲜血狂喷而出！\n" NOR,me, target); 
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

message_vision(HIY"$N在空中一个回转，携「"HIR"日月之光"HIY"」, 双掌按向$n的丹田！\n" NOR,me, target); 
message_vision("结果「轰」地一声，$n像一捆稻草一样飞了出去！\n" NOR,me, target);
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        me->add_temp("apply/dexerity", -i);
        me->add_temp("apply/damage", -i); 
        me->add_temp("apply/strength", -i);
        me->add_temp("apply/attack", -i);   
 me->start_busy(2+random(2));
}
else 
{
message_vision(HIR"$N双掌收在胸前，移形换步闪电般将掌风形成的「"HIW"气旋"HIR"」击向$n的檀中穴！\n" NOR,me, target);
message_vision("结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n" NOR,me, target);	
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);        
 
message_vision(HIR"只见$N右掌随后而至，凌空一跃，犹如晴空霹雳拍向$n的头部！\n" NOR,me, target); 
message_vision("结果「轰」地一声，$n像一捆稻草一样飞了出去！\n" NOR,me, target);
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        me->add_temp("apply/dexerity", -i);
        me->add_temp("apply/damage", -i); 
        me->add_temp("apply/strength", -i);
        me->add_temp("apply/attack", -i);   

call_out("perform2", 3, me, target);  
} 
message_vision(YEL "\n$N一式「日月同辉」发挥的淋漓尽致，双掌一分，气定神闲，信心倍增。
\n" NOR,me, target);     
       me->add("neili", -400);
        me->start_busy(3+random(3));

        return 1;
}
int perform2(object me, object target)
{ 
   string msg;
   int i; 
 i = me->query_skill("xingyi-zhang", 1)/10; 
if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  

        if( (int)me->query("neili", 1) < 300 )
               return notify_fail("你待要再出第二招，却发现自己的内力不够了！\n");
        me->add_temp("apply/strength", i);
        me->add_temp("apply/dexerity", i);
        me->add_temp("apply/attack", i);
        me->add_temp("apply/damage", i);
message_vision(HIY"$N在空中一个回转，携「"HIR"日月之光"HIY"」, 双掌按向$n的丹田！" NOR,me, target);
message_vision("结果「轰」地一声，$n像一捆稻草一样飞了出去！\n" NOR,me, target);         
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
 
message_vision(HIC"只见$N斜身半转，陡地拍出两掌，蓄势凌厉，直指$n左胁！\n" NOR,me, target);
message_vision("结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n" NOR,me, target);
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  

message_vision(HIW"$N将神元神功发挥到极限，幻化出漫天掌影，向$n全身笼罩过去！\n" NOR,me, target);
message_vision(HIW"$n被掌风笼罩，顿时手忙脚乱。！" NOR,me, target);
if( target->query("qi") > 100 ) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 


 me->add("neili", -300);
        me->add_temp("apply/dexerity", -i);
        me->add_temp("apply/damage", -i); 
        me->add_temp("apply/strength", -i);
        me->add_temp("apply/attack", -i);  
        me->start_busy(3+random(3));

        return 1;
}


