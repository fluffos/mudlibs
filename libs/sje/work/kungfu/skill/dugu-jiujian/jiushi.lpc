// jiushi.c 九式合一

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int damage, zhao;
  string msg;
  object weapon;

  string *pfattack_msg = ({
    HIG "「倒剑式」$N突然将所有剑式倒转为施。\n\n" RED "但见$n顿时被逼得手忙脚乱，自己向$N的长剑" RED "撞将上来。\n\n" NOR,
    HIR "「逆剑式」$N将长剑" HIR "交到左手，剑招变的左右颠倒。\n\n" RED "$n一时没有弄懂被刺个正着。\n\n" NOR,
    HIC "「落剑式」$N腾身而起，成头下脚上势，从空中攻向$n。\n\n" RED "$n防备不及结果被$N的刺中。\n\n" NOR,
    HIY "「摇剑式」只见$N的长剑" HIY "有如灵蛇一般左右迂回着。\n\n" RED "$n不知剑要攻向自己的什么位置，站在原地发呆，结果被刺中。\n\n" NOR,
    HIW "「荡剑式」$N的剑招突然变得犹如风中柳絮，飘忽不定。\n\n" RED "$n只觉眼前一花，胸口已被刺中。\n\n" NOR,
    HIB "「浪剑式」犹如大海狂涛，又四面向$n压去。\n\n" RED "$n只觉置身于$N的剑招的狂风暴雨之中，不知不觉已经被刺中。\n\n" NOR,
    YEL "「挫剑式」$n与$N互相一搓身，只见$N将长剑" YEL "轻轻一带。\n\n" RED "$n的小腹已中了$N的一剑。\n\n" NOR,
    HIG "「离剑式」只见$N将手中长剑" HIG "随手抛向空中，长剑" HIG "剑光暴长，急若流星飞向$n。\n\n" RED "$n躲避不及被长剑刺中。\n\n" NOR,
    HIW "$N手中长剑" HIW "虚空一点，" + HIR "「剑气式」" + HIW "应手而出，三丈之内剑气纵横连绵不绝袭向$n。\n\n" RED "$n急忙腾空而起但已经太晚，剑气已经贯胸而过。\n\n" NOR
  });

  string *pfparry_msg = ({
    HIG "$p看破了$P的企图，挺剑而上，一圈一点破解了$P的这招。\n\n" NOR,
    HIB "$p腾身而起，$P的剑招险险从脚下擦过。\n\n" NOR,
    HIY "$P突然从左方攻去一剑，早以被$p料到，身体轻轻向右飘出丈余，化解了这招。\n\n" NOR,
  });

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「九式合一」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "开什么玩笑，没装备剑就想使「九式合一」？\n\n" NOR);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「九式和一」只能对战斗中的对手使用。\n\n");

  if ((int)me->query_skill("dugu-jiujian", 1) < 300)
    return notify_fail(WHT "你独孤九剑不够娴熟，使不出「九式合一」。\n\n" NOR);

  if ((int)me->query("max_neili") < 4000)
    return notify_fail(RED "你内力修为不足，无法运足内力。\n\n" NOR);

  if ((int)me->query_skill("zixia-gong", 1) < 200)
    return notify_fail("独孤九剑必须配合紫霞神功等级。\n\n");

  if ((int)me->query("neili") < 1800) {
    return notify_fail(HIC "你现在内力不够，没能将「九式合一」使完！\n\n" NOR);
  }

  me->start_perform(10, "九式合一");
  msg = HIW "$N手中长剑" HIW "剑芒跃动，剑光暴长，剑尖颤动使出独孤九剑的，独门绝技\n\n" NOR;
  msg += HIR "「九式合一」" + HIW + "剑光左右飘忽，上下不定，直向$n卷去！\n\n\n\n" NOR;

  for (zhao = 0; zhao < 9; zhao++) {

    if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3)

    {
      me->start_busy(3);
      if (!target->is_busy()) {
        target->start_busy(random(2));
      }
      damage = (int)me->query_skill("dugu-jiujian", 1) + (int)me->query_skill("sword", 1);
      damage = 100 + damage + random(damage) + me->query("jiali");
      damage = damage + random(damage);
      damage = damage / 2;



      if (!target || environment(target) != environment(me)) {
        tell_object(me, "太可惜了，你下手的目标已经走了。\n");
        return 1;
      }


      target->receive_damage("qi", damage / 2);
      target->receive_wound("qi", damage / 4);

      msg += pfattack_msg[random(sizeof(pfattack_msg))];
      me->add("neili", -damage / 5);
    } else {
      me->start_busy(3);

      msg += pfparry_msg[random(sizeof(pfparry_msg))];
    }
  }

  message_vision(msg, me, target);

  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
