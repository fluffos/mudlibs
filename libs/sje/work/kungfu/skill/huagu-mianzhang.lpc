// huagu-mianzhang.c 化骨绵掌

inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手在胸前划了几个圆圈，乘$n不备，一式「猛虎下山」，双掌猛地一起击出",
    "force": 200,
    "dodge": 20,
    "parry": 20,
    "damage_type": "瘀伤",
    "lvl": 0,
    "skill_name": "猛虎下山"
  ]),
  ([ "action": "$N双掌一立，一式「排山倒海」，挟着呼呼的掌风，向$n的腹部猛击而去",
    "force": 230,
    "dodge": 10,
    "parry": 30,
    "damage_type": "瘀伤",
    "lvl": 15,
    "skill_name": "排山倒海"
  ]),
  ([ "action": "$N两掌上举，左立右躺，一式「关门上锁」，带着一股劲风，向$n的前胸拍去",
    "force": 260,
    "dodge": 10,
    "parry": 35,
    "damage_type": "瘀伤",
    "lvl": 30,
    "skill_name": "关门上锁"
  ]),
  ([ "action": "$N忽然倒地一滚，一式「斩草除根」，双掌一前一后，直奔$n的双腿而去",
    "force": 290,
    "dodge": 5,
    "parry": 20,
    "damage_type": "瘀伤",
    "lvl": 45,
    "skill_name": "斩草除根"
  ]),
  ([ "action": "$N身形一晃，转到了$n身后，反手使出一式「回头是岸」，双掌呼呼作响，直奔$n的后心而去",
    "force": 310,
    "dodge": 20,
    "parry": 30,
    "damage_type": "瘀伤",
    "lvl": 60,
    "skill_name": "回头是岸"
  ]),
  ([ "action": "$N身形猛地向上跃起，一式「电闪雷鸣」，聚全身之力于双掌之上，以迅雷不及掩耳之势向$n击去",
    "force": 330,
    "dodge": 20,
    "parry": 20,
    "damage_type": "瘀伤",
    "lvl": 80,
    "skill_name": "电闪雷鸣"
  ]),
  ([ "action": "$N缓缓地举起双掌，一式「轻风细雨」，不带一点掌力地轻轻地拍向$n的前胸",
    "force": 335,
    "dodge": 10,
    "parry": 20,
    "damage_type": "内伤",
    "lvl": 100,
    "skill_name": "轻风细雨"
  ]),
  ([ "action": "$N双掌置于胸前，凝立不动，待$n攻来时，身形忽地一矮，一式「守株待兔」，双掌轻飘飘地击向$n的腹部",
    "force": 350,
    "dodge": 10,
    "parry": 20,
    "damage_type": "内伤",
    "lvl": 120,
    "skill_name": "守株待兔"
  ]),
});

int valid_enable(string usage) {
  return usage == "strike" || usage == "parry" || usage == "unarmed";
}


int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练化骨绵掌必须空手。\n");
  if ((int)me->query_skill("dulong-dafa", 1) < 30)
    return notify_fail("你的毒龙大法火候不够，无法学化骨绵掌。\n");
  /*if ((int)me->query_int() > 42)
        {
        return 1;
        }
        else
        {
        if ((int)me->query_skill("jingang-quan") &&
                                ("yizhi-chan")   &&
                                ("longzhua-gong") &&
                                ("qianye-shou") &&
                                ("ruying-suixingtui"))
                return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
        }*/
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练化骨绵掌。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("huagu-mianzhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练化骨绵掌。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  string *cs;
  object me = this_player();
  int csnum = 0, hg;

  hg = strsrch(action, "huagu");
  cs = explode(action, "huagu");
  if (hg != -1 && sizeof(cs) > 0)
    sscanf(cs[0], "%d", csnum);
  me->set_temp("huagucs", csnum);
  if (hg != -1)
    return __DIR__ "huagu-mianzhang/huagu";
  else
    return __DIR__ "huagu-mianzhang/" + action;
}
