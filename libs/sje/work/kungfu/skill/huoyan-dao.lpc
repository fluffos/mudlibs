// huoyan-dao.c 火焰刀
// by iceland

inherit SKILL;

mapping *action = ({
  ([ "action": "$N凝眉立目，全身骨节一阵暴响，一招「无坚不摧」，缓缓向$n劈出一掌，掌力笼罩了$n的全身。",
    "skill_name": "无坚不摧",
    "force": 300,
    "lvl": 0,
    "dodge": 5,
    "parry": 0,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
  ([ "action": "$N跃在空中，凌空下击，使出一招「五神俱灭」，双掌此起彼伏，一道道无形刀气袭向$n全身各处。",
    "skill_name": "五神俱灭",
    "force": 350,
    "lvl": 20,
    "dodge": 7,
    "parry": 0,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
  ([ "action": "$N左臂一圈，将$n双手挂压出去，右掌顺势使出一招「魂飞魄散」，重重拍向$n的面门。",
    "skill_name": "魂飞魄散",
    "force": 400,
    "lvl": 50,
    "dodge": 15,
    "parry": -5,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
  ([ "action": "$N跨前一大步，借腰胯之力，一招「披肝沥胆」，双掌一前一后劈向$n的$l，掌风凌厉之极。",
    "skill_name": "披肝沥胆",
    "force": 440,
    "lvl": 70,
    "dodge": 10,
    "parry": 3,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
  ([ "action": "$N双掌挥动之际竟带起一股热浪，一招「流金铄石」，凌空劈出，炽热的刀气击向$n的$l。",
    "skill_name": "流金铄石",
    "force": 480,
    "lvl": 100,
    "dodge": 10,
    "parry": 0,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
  ([ "action": "$N脸露狞笑，全身劲力凝于双掌，一招「火虐风饕」，刀气汹涌而出，$n被逼得一阵气窒。",
    "skill_name": "火虐风饕",
    "force": 500,
    "lvl": 120,
    "dodge": 20,
    "parry": 5,
    "weapon": random(2) ? "无形刀气" : "火焰刀风",
    "damage_type": "割伤",
  ]),
});


int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }


int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练火焰刀必须空手。\n");
  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_str() < 30)
    return notify_fail("你的膂力太低，不能驾御火焰刀。\n");
  if ((int)me->query_skill("longxiang-boruo", 1) < 100)
    return notify_fail("你的龙象般若功火候太浅，不能学火焰刀。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候太浅，不能学火焰刀。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("huoyan-dao", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练火焰刀必须空手。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力不够，练不了火焰刀。\n");
  me->receive_damage("jingli", 35);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huoyan-dao/" + action;
}
