// pifeng.c 乱披风
 
#include <ansi.h>
inherit F_SSERVER;
int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, ap, dp, neili_wound, qi_wound;
        me->clean_up_enemy();
        weapon = me->query_temp("weapon");
        target = me->select_opponent();
        skill = me->query_skill("pangen-cuojie",1);
        if( !(me->is_fighting() ))
            return notify_fail("你只能对战斗中的对手使用「乱披风」斧法。\n");
        if ( !weapon || weapon->query("skill_type") != "axe") 
            return notify_fail("你手中没斧怎么使用「乱披风」斧法？\n");
        if ( me->query("neili") < 500 || me->query("max_neili") < 800 )
            return notify_fail("你的内力不够深厚，使不出「乱披风」斧法。\n");
        if( skill < 101 )
            return notify_fail("你的「盘根错节斧」等级不够, 不能使用「乱披风」斧法！\n");
        if( me->query_str() < 32 )
            return notify_fail("你的膂力不够，无法使用「乱披风」斧法！\n");
        if ( me->query_skill_mapped("axe") != "pangen-cuojie"
          || me->query_skill_mapped("parry") != "pangen-cuojie")
               return notify_fail("你现在无法使用「乱披风」斧法！\n");
        msg = HIY"\n$N突然形同发疯，手举双斧欺近$n的身前，使出三十六路「乱披风」斧法。\n"NOR;
        message_vision(msg, me, target);
        ap = me->query("combat_exp") + skill * 400;
        dp = target->query("combat_exp") / 2;
        if( dp < 1 )
                dp = 1;
        if( random(ap) > dp ){
           if(userp(me))
             me->add("neili",-300);
             msg = HIR "$n只觉得眼前都是斧影，来不及躲避，大惊失色，身中数斧。\n"NOR;
             neili_wound = 400 + random(skill);
             if(neili_wound > target->query("neili"))
               neili_wound = target->query("neili");
               qi_wound = neili_wound / 5;
             if( qi_wound > target->query("qi") && target->query("qi") > 0 )
               qi_wound = target->query("qi");
             target->receive_damage("qi", qi_wound*(2+random(3)));
             target->receive_wound("qi", qi_wound*(random(2)+1));
             target->receive_damage("neili", neili_wound);
             target->start_busy(2);
             me->start_busy(random(2));
             }
        else{
             msg = HIG "只见$n身形一闪，左右晃动，勉强躲过了$N的「乱披风」斧法！\n"NOR;
             if(userp(me))
             me->add("neili",-100);
             me->start_busy(3);
        }
        message_vision(msg, me, target);
        return 1;
}

