// dian.c 银索金铃--点字诀

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon = me->query_temp("weapon");
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("点字诀只能对战斗中的对手使用。\n");
  if (me->query_skill("yunu-xinjing", 1) < 140)
    return notify_fail("你的玉女心经等级还不够，使不出点字诀。\n");
  if (me->query_skill("yinsuo-jinling", 1) < 120)
    return notify_fail("你的银索金铃还不够娴熟，不会使用点字诀。\n");
  if (!weapon
    //         || !( me->query_temp("weapon")->id("yin suo"))
    || me->query_skill_mapped("whip") != "yinsuo-jinling"
    || me->query_skill_mapped("parry") != "yinsuo-jinling")
    return notify_fail("你现在无法使用点字诀。\n");
  if (me->query("neili") < 500)
    return notify_fail("你的内力不够使用点字诀。\n");
  if (me->query("jingli") < 400)
    return notify_fail("你的精力不够使用点字诀。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");
  msg = HIM "\n$N这绸带兵刃竟能在空中转弯，只听得玎玎玎三声连响，金球疾颤三下，\n" +
    "分点$n脸上「迎香」、「承泣」、「人中」三个穴道。\n\n";
  me->start_busy(random(1));
  if ((random(me->query("combat_exp")) > target->query("combat_exp") / 3)
    && ((random(me->query_per()) >= target->query_per() / 3)
      || (random(me->query_dex()) >= target->query_dex() / 3))) {
    msg += HIY "结果$p被$P攻了个措手不及！\n" NOR;
    target->start_busy((int)me->query_skill("yinsuo-jinling") / 40 + 5);
  } else {
    msg += HIW "可是$p看破了$P的企图，并没有上当。\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  me->add("jingli", -250);
  me->add("neili", -300);
  return 1;
}
