// 2000.1.19  by emnil

#include <ansi.h>

inherit F_SSERVER;

void canfight(object me);

int perform(object me, object target) {
  object weapon;
  int busy = 0;
  int f, nl;
  string msg;

  if (!target) target = offensive_target(me);


  weapon = me->query_temp("weapon");

  if (weapon)
    return notify_fail("只有空手才能使用「飞蛾扑火」！\n");
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「飞蛾扑火」只能对战斗中的对手使用。\n");
  if (me->query_temp("sxbb2", 1) || me->query_temp("sxbb1", 1))
    return notify_fail("「飞蛾扑火」不能和「神行百变」合用。\n");
  if (target->is_busy())
    busy = 1;
  if ((int)me->query_skill("huagu-mianzhang", 1) < 10)
    return notify_fail("你的化骨绵掌不够娴熟，不会使用「飞蛾扑火」。\n");
  if (me->query_skill_mapped("strike") != "huagu-mianzhang")
    return notify_fail("你现在使用的掌法不是化骨绵掌，不能使用「飞蛾扑火」。\n");
  f = random(me->query("combat_exp")) * 100 / random(target->query("combat_exp"));
  f = f + random(me->query_skill("dodge")) * 100 / random(target->query_skill("dodge"));
  f = f + random(me->query_dex()) * 100 / random(target->query_dex());
  f = f + random(me->query_kar()) * 100 / random(target->query_kar());
  f = f + random(me->query_skill("strike")) * 100 / random(target->query_skill("parry"));

  msg = RED + "\n$N突然双目赤红，两臂张开，不顾死活地向$n扑去！\n" NOR;

  if (f * (busy + 1) > 250) {
    msg += RED + "$n一个没留神，被$N抱得结结实实，动弹不得！\n" NOR;
    if (target->is_busy())
      target->start_busy(60 + target->query_busy());
    else
      target->start_busy(60);
    if (f * (busy + 1) < 500) {
      msg += RED + "$n心中一急，向$N后心重重地猛击而下，打得$N脏腑移位，七窍流血！\n" NOR;
      message_vision(msg, me, target);
      nl = f * (busy + 1) * 10;
      if (target->query("neili") <= nl)
        target->set("neili", 0);
      else
        target->add("neili", -nl);
      me->die();
    } else if (f * (busy + 1) < 800) {
      msg += RED + "$n心中一急，向$N后心重重地猛击而下，打得$N鲜血狂喷！\n" NOR;
      message_vision(msg, me, target);
      me->receive_damage("qi", (800 - f * (busy + 1)) * 20, target);
      me->receive_wound("qi", (800 - f * (busy + 1)) * 10, target);
      nl = f * (busy + 1) * 5;
      if (target->query("neili") <= nl)
        target->set("neili", 0);
      else
        target->add("neili", -nl);
    }
    if (!me->is_ghost()) {
      message_vision(msg, me, target);
      me->start_busy(120);
      me->set_temp("no_fight", 1);
      call_out("canfight", 120, me);
    }
  } else {
    msg += CYN + "可是$n" + CYN + "看破了$N" + CYN + "的企图，逃了过去。\n" NOR;
    me->start_busy(2);
    message_vision(msg, me, target);
  }
  return 1;
}

void canfight(object me) {
  if (me)
    me->delete_temp("no_fight");
}
