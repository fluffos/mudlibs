// huagu.c 化骨

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	//int damage;
        string msg;
        //object weapon;
        int cs,poisonlev,fzcs,dif,i,tneili,exp,mneili,user;
	object room;

        fzcs=(int)me->query_temp("huagucs",1);
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character())
		return notify_fail("你想化谁的骨？\n");
	if(objectp(room=environment(me)))
	{
      if(room->query("no_fight"))
			return notify_fail("你不能在这里化骨。\n");
	}
	if(userp(target))
		user=1;
	else
		user=0;
        if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能化骨！\n");

        if( (int)me->query_skill("huagu-mianzhang", 1) < 120 )
		return notify_fail("你的化骨绵掌还不够熟练，不能使用！\n");

        if( (int)me->query("neili", 1) < 500 )
		return notify_fail("你现在内力不足，不能化骨！\n");	

	if( (int)me->query_skill("dulong-dafa", 1) < 120 )
		return notify_fail("你的毒龙大法功力不足，不能化骨。\n");

	 if (me->query_skill_mapped("force") != "dulong-dafa")
           return notify_fail("没有毒龙大法作为根基，是无法使出「化骨」绝技的！\n"); 
    msg = HIY "\n$N忽然脸带诡笑，双掌不带一点劲气地向$p轻轻地拍了一掌！\n"NOR;
    
        //me->start_busy(random(2));
	if(user==0)
		exp=me->query("combat_exp");
	else
		exp=target->query("combat_exp");
        if(exp> random((int)target->query("combat_exp"))) 
	{
	if(user==1)
	{
        	tneili=target->query("neili");
		mneili=me->query("neili");
	}
	else
	{
		tneili=target->query_skill("force", 1);
		mneili=me->query_skill("force", 1);
	}
	if(tneili<=0)
		tneili=1;
	if(user==1) 
		tneili=mneili+random(mneili)-tneili;
	else
		tneili=2*mneili-tneili;   
	cs=me->query_skill("huagu-mianzhang", 1)*tneili/mneili;
              if((poisonlev=(int)me->query_skill("poison", 1))<20)
                  poisonlev=20;
              cs=cs*poisonlev/1000;
              dif=0;
	      me->add("neili", -400);
              me->add("jingli", -100);
              if(cs>0)
              {
                  cs--;
		  if(user==1)
			cs=cs+cs/2;
                  if(fzcs!=0 && cs>fzcs)
                  {
                      dif=(cs-fzcs)/2;
                      cs=fzcs;
                  }
                  msg += "结果$p躲闪不及，身中剧毒\n"NOR;
                  if(target->query("huagu")>=400)
                               {
                                    target->apply_condition("huagu_poison",target->query_condition("huagu_poison")+cs);
                               }
                               else
                               {
                      target->set("huagu",400);
                      target->apply_condition("huagu_poison",cs);
                  }
                  for(i=dif;i>0;i--)
                  {
                      if(target->query("neili")<600)
                          break;
                      target->add("neili",-600);
		      if(user==1)
		          target->add("huagu",-200);
                  }
                  target->add("huagu",200*i);
              }
              else if(cs<0)
              {
                      cs++;
                      if(fzcs!=0 && cs<-fzcs)
                      {
                          dif=(-fzcs-cs)/2;
                          cs=-fzcs;
                      }
                      msg += "结果被$p反震回来，$N反而身中剧毒\n"NOR;
                      if(me->query("huagu")>=200)
                                      {
                                          me->apply_condition("huagu_poison",me->query_condition("huagu_poison")-cs/2);
                                      }
                                      else
                                      {
                        me->set("huagu",200);
                        me->apply_condition("huagu_poison",-cs/2);
                     }
                     for(i=dif;i>0;i--)
                     {
                          if(me->query("neili")<300)
                             break;
                          me->add("neili",-300);
			  me->add("huagu",-200);
                     }
                     me->add("huagu",100*i);
              }
        } 
        else {
                msg += "$p往旁边一闪身，躲过了这招。\n"NOR;
                me->start_busy(3);
        }
        message_vision(msg, me, target);
        me->start_busy((int)me->query_skill("huagu-mianzhang", 1)/50);
        me->kill_ob(target);
        target->kill_ob(me);
        return 1;	
}
