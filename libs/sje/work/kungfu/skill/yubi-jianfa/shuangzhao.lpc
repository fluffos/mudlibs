//Edit by keinxin @sj2 2003.3
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        extra = me->query_skill("yubi-jianfa",1);
        if ( extra < 150) return notify_fail("你的玉璧剑法还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［璧影双照］只能对战斗中的对手使用。\n");
        if ((int)me->query("neili")<450)
                return notify_fail("你的内力不够。\n"); 
	if(((int)me->query_skill("bahuang-gong", 1) < 150 ) &&
	   ((int)me->query_skill("beiming-shengong", 1) < 150 ))
		return notify_fail("你的本门内功不够娴熟。\n");

        me->add("neili",-250);
        weapon = me->query_temp("weapon");
        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

if (!me) return 0;
if (!target) return 0;
        message_vision(MAG"$N使出玉璧剑法中的绝招"HIG"［璧影双照］"MAG"，一招连环三剑，手中的"+weapon->name()+"闪电般向$n攻出！\n\n" NOR,me,target);        
	extra = me->query_skill("yubi-jianfa",1) / 4;
	extra += me->query_skill("beiming-shengong",1) / 3;
        if (random(me->query_skill("yubi-jianfa", 1))> target->query_skill("force", 1)/10 )
        {
        me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
        COMBAT_D->do_attack(me,target, weapon); 
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(HIR"$N剑交左手，不可思议地右手探出点向$n！\n" NOR,me,target);   
        COMBAT_D->do_attack(me,target, weapon);
        me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
        if (me->query_skill("liuyang-zhang", 1)> target->query_skill("force", 1) )
        {                
        msg = HIM "一道"HIC"生死符"+HIM+"打中$n的身上,$n只觉得伤口一冷！\n"NOR;   
                message_vision(msg, me, target);
		target->apply_condition("ss_poison", 2+random(5));
                if (!target->is_busy())
                target->start_busy(2);
        }
       
if ((int)me->query_skill("beiming-shengong",1) <140)
        me->start_busy(2);
else    me->start_busy(1);

        } else { 
                message_vision(HIC"可是$n看破了$N的招式,趁机发动进攻！\n" NOR,me,target);
                me->start_busy(2);
        }        
        return 1;
}

