// chan.c 太极剑法「缠」字诀

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("牵制攻击只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("yinyun-ziqi", 1) < 100 )
                return notify_fail("你的内功等级不够，不能使用「缠」字诀。\n");

        if( (int)me->query_skill("taiji-jian", 1) < 150 )
                return notify_fail("你的太剑法极不够娴熟，不会使用「缠」字诀。\n");

        if (!weapon || weapon->query("skill_type") != "sword"
        || me->query_skill_mapped("sword") != "taiji-jian")
                return notify_fail("你现在无法使用牵制攻击。\n");

        if( (int)me->query("neili") < 500 )
                return notify_fail("你现在内力太弱，不能使用「缠」字诀。\n");

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
                
        msg = CYN "$N使出太极剑法「缠」字诀，连递数个虚招企图扰乱$n的攻势。\n";

        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/2 ) {
                msg += "结果$p被$P攻了个措手不及。\n" NOR;
                target->start_busy( (int)me->query_skill("taiji-jian") / 20 );
        } else {
                me->start_busy(2);
                msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
        }
        message_vision(msg, me, target);
        me->add("neili", -200);
        return 1;
}
