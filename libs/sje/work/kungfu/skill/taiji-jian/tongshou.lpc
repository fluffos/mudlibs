//  tianditongshou 天地同寿

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        int damage;
        object weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("你只能在战斗中使用『天地同寿』。\n");

        if( (int)me->query_skill("taiji-jian", 1) < 150 )
                return notify_fail("你的太极剑法不够娴熟，不会使用天地同寿。\n");
        if( (int)me->query_skill("yinyun-ziqi", 1) < 150 )
                return notify_fail("你的氤氲紫气的基础不够，不能使用天地同寿。\n");
        if( (int)me->query_dex() < 26 )
                return notify_fail("你的身法太低，不能使用天地同寿。\n");
 
        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你现在内力不足！\n");     
      
        if( (int)me->query("eff_qi") > (int)me->query("max_qi") / 2 )
                return notify_fail("天地同寿是拼命的招数，怎可以随便使用？！\n");    

        if (!weapon || (weapon->query("skill_type") != "sword")
        || me->query_skill_mapped("sword") != "taiji-jian"
        || me->query_skill_mapped("parry") != "taiji-jian")
                return notify_fail("你现在无法使天地同寿。\n");

  message_vision(RED"\n$N猛然不顾一切进身到$n面前，突然反转身行，借势将手中的利剑向自己的小腹刺去，"
"意图和$n拼个玉石俱焚。\n\n"NOR, me, target);
  
if((me->query("combat_exp")) > (int)target->query("combat_exp")/2 &&
     random(me->query_str()) > (int)target->query_str()/4) {
        message_vision(HIR"\n$n被如此凶悍的招数，吓的全身冰凉，呆立不动，但见$N手中的利剑从自己的小腹刺入"
"后，直接洞穿了$n的身体！\n"NOR, me, target);
        tell_object(target, HIR "你感觉一柄利剑从自己身体穿过，骇怖到了极点！\n" NOR);
                me->start_busy(2);
                target->start_busy(2);
                me->add("neili", -300);
                damage = (int)target->query("max_qi");
                damage = damage/10;
                damage = damage*9;
                 
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage);
                me->query_temp("weapon")->move(target);
                target->kill_ob(me);
                me->set_temp("last_damage_from", "使用天地同寿和"+target->name()+"同归于尽");
                target->set_temp("last_damage_from", "被"+me->name()+"使用天地同寿杀");
                me->add("max_neili",-150);
                me->die();
              target->die();
                }
         else 
              {
                target->start_busy(5);
                message_vision(HIY"\n$n在千钧一发之际，急忙推开$N，向上飞起，勉强避开这招，但已被吓的目瞪口呆。\n"NOR, me, target);
                me->add("max_neili",-50);
                me->set_temp("last_damage_from", "使用天地同寿自杀");
                me->die();
              }

        return 1;
}
