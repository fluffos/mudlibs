// beiming.c yun beiming 可以增加相当的防御和攻击，以及内功
// keinxin @sj2 
// 2003.3

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int skill);

int exert(object me, object target) {
  int skill;

  skill = me->query_skill("beiming-shengong");

  if (me->query("wuyazi_bmfind") < 1)
    return notify_fail("你还没有理解北冥的上乘内功奥决。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 130)
    return notify_fail("你目前尚不能使用北冥。\n");
  if ((int)me->query("neili") < skill)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("beiming"))
    return notify_fail("你已经在运用北冥了。\n");

  me->add("neili", -1 * skill);
  //        me->add_temp("apply/parry",skill/3);
  me->add_temp("apply/force", skill / 5);
  //        me->add_temp("apply/attack",skill/5);
  //      本来没有luoshen，所以这样设计，现在有了luoshen，这个再加上就太强了。
  message_vision(HIB "$N运起北冥神功口中默念：" HIG "乘天地之正，御六气之辩，以游于无穷，是为逍遥。\n" NOR, me);
  message_vision(HIW "$N的真气经由灵台，尺泽，曲池，灵海，天宗汇入气海" HIC "[北冥]" HIW "，形成一股浩荡之气。\n" NOR, me);
  me->set_temp("beiming", 1);
  call_out("remove_effect", skill, me, skill);
  if (me->query("neili") < (2 * me->query("max_neili")))
    me->add("neili", 500);

  me->start_exert(1, "北冥");

  if (me->is_fighting()) me->start_busy(random(2));

  return 1;
}

void remove_effect(object me, int skill) {
  if (objectp(me)) {
    if (me->is_fighting()) {
      call_out("remove_effect", 1, me, skill);
      me->start_exert(1, "北冥");
      return;
    }
    me->delete_temp("beiming");
    //                me->add_temp("apply/parry",-skill/3);
    me->add_temp("apply/force", -skill / 5);
    //                me->add_temp("apply/attack",-skill/5);
    tell_object(me, HIC "你散去了聚于气海[北冥]的真气。" NOR "\n");
  }
  return;
}
