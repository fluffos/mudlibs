//shigu.c 石鼓文
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

void remove_effect(object me, object target, int improve);
void remove_effect1(object me, object target, int improve);
int perform(object me, object target) {
  string msg;
  int i, damage;
  object weapon = me->query_temp("weapon");

  if (!weapon || weapon->query("skill_type") != "brush")
    return notify_fail("你手里没有笔，无法写出石鼓文！\n");

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("石鼓文只能在战斗中对对手使用。\n");

  if ((int)me->query_skill("yingou-bifa", 1) < 150)
    return notify_fail("你的银钩笔法还不够娴熟，不会写石鼓文！\n");

  if ((int)me->query_skill("literate", 1) < 140)
    return notify_fail("你的读书写字等级不够，不能写出石鼓文！\n");

  if ((int)me->query_skill("guiyuan-tunafa", 1) < 160)
    return notify_fail("你的归元吐纳法等级不够，不能写出石鼓文！\n");

  if ((int)me->query("max_neili") < 2000)
    return notify_fail("你的内力太弱，无法写出强劲有力的石鼓文! \n");

  if ((int)me->query("neili") < 800)
    return notify_fail("你的内力太少了，写出的石鼓文无刚阳之气！\n");
  if (me->query_skill_mapped("brush") != "yingou-bifa"
    || me->query_skill_mapped("parry") != "yingou-bifa")
    return notify_fail("你现在无法写出「石鼓文」！\n");

  i = random((int)(me->query_skill("yingou-bifa", 1) / 15));
  if (i < 1) i = 1;
  if (i > 10) i = 15;
  msg = HIY "$N忽然间笔法又变，运笔不似写字，却如拿了斧头在石头上凿打一般。这一路笔法是石鼓文，
那是春秋之际用斧凿刻在石鼓上的文字，此乃最古的大篆字。$n对这一路古篆果然只识得一
两个字，既不知对方书写何字，自然猜不到书法间架和笔画走势，登时难以招架。\n" NOR;
  me->add("neili", -350);
  if ((random(me->query_skill("literate")) > target->query_skill("literate") / 6)
    && (random(me->query_skill("force")) > target->query_skill("force") / 10)) {
    me->start_busy(2);
    target->start_busy(3);

    damage = (int)me->query_skill("yingou-bifa", 1);

    damage = damage / 2 + random(damage);

    target->receive_damage("qi", (int)((i * (2 * damage)) / 3));
    target->receive_wound("qi", (int)((i * damage) / 3));

    msg += MAG "$N一个字一个字篆将出来，文字固然古奥，而作为书法之基的银钩笔法也相应加强劲力。
$N振笔挥舞，在空中连书三个古字，$n还想得到去认甚麽字，膝上穴道一麻，强吸一口气
向膝间穴道冲去，$N笔来如电，跟著又是一点连环进招，$n不由自主地瘫倒在地上。n" NOR;

  } else {
    me->start_busy(1);
    msg += CYN "$P一字快过一字，笔锋掠过$p的身边，只觉得冷飕飕的，$p已无力去认$P所
写何字，只得护住面门和身上各大要穴，突然臂上一麻，强吸一口气去冲穴道，
总算勉力冲穴成功，但是手臂已酸麻无力，勉强能招架。\n" NOR;
    target->start_busy(10);
    if (!(target->query("neili") < 0)) target->add("neili", -300);
  }
  message_vision(msg, me, target);
  return 1;
}
