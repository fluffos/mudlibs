// xu.c 乾坤大挪移「蓄」字诀

#include <ansi.h>
inherit F_SSERVER;
int check_fight(object me);

int perform(object me, string arg)
{
        object ob;
        int i, jiali;
        
        jiali = me->query("jiali");
        
        if(!me->is_fighting())
                return notify_fail("你没在战斗中呢！\n");

        if(me->query_temp("weapon"))
                return notify_fail("「蓄」字诀乃空手绝技，你手握武器如何使得出？\n");
                
        if(me->query_temp("qkdny/xu1") > 0)
        {
                if(arg && !objectp(ob = present(arg, environment(me))))
                        return notify_fail("你没在战斗中呢！\n");
                        
                        
                else    ob = offensive_target(me);

                if(!ob 
                || !ob->is_character() 
                || !me->is_fighting(ob) 
                || environment(ob) != environment(me) 
                || !living(ob))
                        return notify_fail("「蓄」字诀所积蓄的力量只能对战斗中对手使用。\n");
                
                
                if(me->query_temp("qkdny/xu2")>0)
                        return notify_fail("你已经进入蓄力的关键时刻，需要专心蓄力！\n");
                
                me->add_temp("qkdny/xu", jiali);
                me->add_temp("qkdny/xu1", 1);
                me->add("neili", -200);
                
                message_vision(HIB"\n$N暗暗运起乾坤大挪移心法中第七层功夫，施展「蓄」字诀，将内力渐渐积蓄起来！\n"NOR, me);  
                message_vision(HIB"\n$N已经积蓄了"+chinese_number(me->query_temp("qkdny/xu1"))+"次内力，$N「蓄」字诀所积蓄的力量已经达到了"+chinese_number(me->query_temp("qkdny/xu"))+"！\n"NOR, me);  
                
                call_out("check_xu", 3, me); 
                
                if(me->add_temp("qkdny/xu1") > 5) 
                        me->set_temp("qkdny/xu2",1);
                        
                if(me->add_temp("qkdny/xu1") > 8) 
                        me->delete_temp("qkdny/xu2");        
                        
                if(me->add_temp("qkdny/xu1") < 10)
                        return notify_fail("\n");
                
//                if(wizardp(me))

                me->set("jiali", me->query("jiali")+me->query_temp("qkdny/xu"));
                me->add_temp("apply/attack", jiali*3);
                me->add_temp("apply/dexerity", jiali);
                message_vision(HIY"\n$N突然间大喝一声，将所积蓄的十余次的力道归并成为一掌拍出，便如一座\n"+
                                  "大湖在山洪爆发时储满了洪水，猛地里湖堤崩决，洪水急冲而出！世上原无如\n"+
                                  "此大力。$n倘若受实了，势须立时腕骨、臂骨、肩骨、肋骨一齐折断，连\n"+
                                  "血也喷不出来，当场成为一团血肉模糊，死得惨不可言！\n"NOR, me, ob);
                tell_object(me, "你「蓄」字诀所积蓄的力量已经达到了"+chinese_number(me->query_temp("qkdny/xu"))+"\n"); 
                ob->start_busy(4);              
                COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 2);
                me->add_temp("apply/attack", -jiali*3);
                me->add_temp("apply/dexerity", -jiali);
                me->set("jiali", jiali);
                me->delete_temp("qkdny/xu1");
                me->delete_temp("qkdny/xu");
                me->reset_action();
                ob->set("eff_qi",ob->query("qi"));
                return 1;
        }
       
        if(me->query_skill("qiankun-danuoyi", 1) < 200 )
                return notify_fail("你的乾坤大挪移还未练到第七层，不会使用「蓄」字诀。\n");
        if(me->query_skill_mapped("parry") != "qiankun-danuoyi")
                return notify_fail("你没有使用乾坤大挪移作为招降，无法使用「蓄」字诀！\n");
                 
        if((int)me->query("neili") < 300 )
                return notify_fail("你目前的内力不够！\n");
        if((int)me->query_skill("force", 1) < 200 )
                return notify_fail("「蓄」字诀需要深厚的内功基础，你的条件好象还不够。\n");
        
        if((int)me->query_temp("qkdny/yi") )
                return notify_fail("你正在施展「移」字诀呢！\n");
                
        me->add("neili", -200);
        tell_object(me, HIB"\n你暗暗运起乾坤大挪移心法中第七层功夫，施展「蓄」字诀，将内力渐渐积蓄起来！\n\n"NOR); 
        me->add_temp("qkdny/xu", jiali);
        me->add_temp("qkdny/xu1", 1);   
        call_out("check_fight", 1, me);
        return 1;
}

int check_fight(object me)
{    

        if (!me || !me->query_temp("qkdny/xu1")) return 0;

        else if(me->is_ghost() || !living(me)){
                me->delete_temp("qkdny/xu1"); 
                me->delete_temp("qkdny/xu");
                me->delete_temp("qkdny/xu2");  
                }            
        else if(!me->is_fighting()){
                tell_object(me, BLU"\n你退出了战斗，便将积蓄的力量慢慢散了出去。\n"NOR);
                me->delete_temp("qkdny/xu1");
                me->delete_temp("qkdny/xu"); 
                me->delete_temp("qkdny/xu2");          
                }        
        else if(me->query("neili") <= 100){
                tell_object(me, BLU"\n你突然发现本身的内力已经要枯竭了连忙把积蓄的力量散了出去！\n"NOR);
                me->delete_temp("qkdny/xu1");
                me->delete_temp("qkdny/xu");   
                me->delete_temp("qkdny/xu2");        
                }                 
        else if (me->query_skill_mapped("parry") != "qiankun-danuoyi"
                || me->query_temp("weapon")){
                tell_object(me, BLU"\n你心念一转，改变了战术，把积蓄的力量散了出去！\n"NOR);
                me->delete_temp("qkdny/xu1");
                me->delete_temp("qkdny/xu");   
                me->delete_temp("qkdny/xu2");        
                }
        else if (me->query_skill_mapped("cuff") != "qishang-quan"
                || me->query_temp("weapon")){
                tell_object(me, BLU"\n你没有使用七伤拳，结果积蓄的力量散了出去！\n"NOR);
                me->delete_temp("qkdny/xu1");
                me->delete_temp("qkdny/xu");   
                me->delete_temp("qkdny/xu2");        
                }         
       else call_out("check_fight", 1, me);
       return 1;
}       

int check_xu(object me)
{    
       me->delete_temp("qkdny/xu2");     //判断蓄力动作
}       