// zuida.c 少林醉棍 //by hunthu
#include <ansi.h>
inherit F_SSERVER;
void remove_effect(object me, int amount, int amount1);
int perform(object me, object target)
{
object weapon;	
	string msg;
int count, count1, cnt, skill,limit,aa;
if( !me->is_fighting())
 return notify_fail("「八仙醉打」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "club")
return notify_fail("你使用的武器不对。\n");
if( (int)me->query_temp("zuida") ) 
	return notify_fail("你已经在运功中了。\n");
if( (int)me->query_str() < 35 )
	return notify_fail("你的臂力不够，目前不能使用此绝技! \n");
if((int)me->query_skill("yijin-jing",1)<80)
return notify_fail("你的易筋经的功力不够，不能使用此项绝技！\n");
if( (int)me->query_skill("club") < 90)
return notify_fail("你的棍法修为不够，不能使用此项绝技! \n");
if(me->query_skill("zui-gun",1)<90)
   return notify_fail("你的醉棍武学修为不够，不能使用此项绝技。\n");
if ((int)me->query("max_neili")<1000)
      return notify_fail("你的内力修为不够，不能使用八仙醉打。\n");
if( (int)me->query("neili") < 650 )
return notify_fail("你的真气不足！\n");
if ((int)me->query_condition("drunk")==0)
   return notify_fail("你全无醉意无法使出八仙醉打。\n");
  msg = HIY "$N如同醉汉一般，脚步踉跄，全然不合章法。但臂力陡然增加,\n
身法陡然加快！正是少林醉棍的绝技「八仙醉打」，\n" NOR;
 limit = (me->query("con") + (int)me->query("max_neili") / 50) * 2;
  cnt =(int)( (int)me->query_condition("drunk"));
if (cnt>limit/2)   
 aa=3;
   if (cnt>limit/4) aa=2;
 	message_vision(msg, me, target);
skill = me->query_skill("zui-gun",1);
count=me->query("str")*(aa-1);
 count1 = me->query("dex") * (aa-1);
me->add_temp("str", count);
me->add_temp("dex", count1);
me->set_temp("zuida", 1);
me->start_call_out( (: call_other, __FILE__, "remove_effect", me, count, count1 :), skill /3 );
me->add("neili", -550);
me->add("jingli",-200);
return 1;
}
void remove_effect(object me, int amount, int amount1)
{
if ( (int)me->query_temp("zuida") ) 
{
message_vision(HIY"$N的身法渐渐变慢，臂力也恢复正常。\n"NOR,me);
me->add_temp("str", -amount);
me->add_temp("dex", -amount1);
me->delete_temp("zuida");
  tell_object(me, HIY "你的八仙醉打运功完毕，将内力收回丹田。\n" NOR);
me->start_busy(4);
}
}
