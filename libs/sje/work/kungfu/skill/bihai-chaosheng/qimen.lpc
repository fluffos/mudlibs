// qimen.c 奇门

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me);

int exert(object me, object target) {
  int i, l, skill;
  i = me->query_skill("bihai-chaosheng", 1);
  l = me->query_skill("qimen-bagua", 1);
  skill = (i + l);

  if (!target) target = me;

  if (me->is_fighting())
    return notify_fail("你正在战斗中，找死啊？\n");
  if ((int)me->query_skill("bihai-chaosheng", 1) < 60)
    return notify_fail("你的碧海潮生功不够娴熟，！\n");
  if ((int)me->query_skill("qimen-bagua", 1) < 60)
    return notify_fail("你的奇门八卦不够娴熟，！\n");
  if ((int)me->query("neili") < 550)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("qimenbg"))
    return notify_fail("你正在运用奇门八卦。\n");

  me->add("neili", -150);

  message_vision(
    GRN "\n$N指手一算，只觉心中豁然开朗。\n" NOR, me);

  me->start_busy(2);
  me->add_temp("apply/intelligence", (int)me->query("int"));
  me->set_temp("qimenbg", 1);

  me->start_call_out((: call_other, this_object(), "remove_effect", me :), skill);
  return 1;
}

void remove_effect(object me) {
  me->add_temp("apply/intelligence", -(int)me->query("int"));
  me->delete_temp("qimenbg");
  tell_object(me, HIY "你觉得累了，脑筋也不好使了。\n" NOR);
}
