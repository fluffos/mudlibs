// play.c 奏“碧海潮生”曲
// modified by darken@SJ

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
        object *ob;
        object weapon;
        int i, skill, damage;

        if (me->query_skill("bihai-chaosheng", 1) < 100)
                return notify_fail("你的碧海潮生功还没到家。\n");

        if( environment(me)->query("no_fight") )
                return notify_fail("在这里不能攻击他人。\n");

        if (!weapon = me->query_temp("weapon"))
                return notify_fail("你要用什么来吹奏？\n");

       if (!weapon->id("xiao"))
                return notify_fail("你手里的兵器不是箫！\n");

        if( (int)me->query("neili") < 500 )
                return notify_fail("你的内力不够。\n");

        skill = me->query_skill("bihai-chaosheng",1);

        me->add("neili", -300);
        damage = skill;
        me->start_busy(2);
        message_vision(HIY"$N将箫凑到嘴边，开始幽幽咽咽地吹奏起“碧海潮生曲”来，曲调如泣如述，柔糜万端。\n"NOR, me);
        ob = all_inventory(environment(me));
        for (i = 0; i < sizeof(ob); i++) {
                if (!living(ob[i]) || ob[i] == me) continue;

                if (ob[i]->query("age") >= 16) {
                if (ob[i]->query_skill("bihai-chaosheng",1)>30)
                        message_vision(HIW"$N对碧海潮生曲习以为常，没什么反应。\n"NOR, ob[i]);
                else if (ob[i]->query("class") == "bonze" )
                {
                        if (random(10)>6)
                        message_vision(HIY"$N平时清心寡欲，箫声没有多大效果。\n"NOR, ob[i]);
                        else
                        {
                                message_vision(HIY"$N被箫声扰的心烦意乱，失去了克制力。\n"NOR, ob[i]);
                        if ((skill*20) > ((int)ob[i]->query("neili")/2))
                                {
                                       if( damage > 0 ) {
                                             ob[i]->receive_damage("jing", damage * 2+random(damage)*2, me);
                                       if( (int)ob[i]->query("neili") > (int)me->query("neili"))
                                             ob[i]->receive_wound("jing", damage * 2, me);
              message_vision(HIM"$N觉得面红耳赤，百脉贲张，心旌摇动，呼吸急促。\n"NOR, ob[i]);
                        }
                        }
                     }
                 }                         
                else if ((skill*20) < ((int)ob[i]->query("neili")/2))
                {
                        message_vision(HIR"$N运起内力抵抗箫声，没什么反应。\n"NOR, ob[i]);
                        ob[i]->add("neili",-skill*3);
                }
                else
                {
                        if( damage > 0 ) {
                                ob[i]->receive_damage("jing", damage * 2+random(damage)*2, me);
                        if( (int)ob[i]->query("neili") > (int)me->query("neili"))
                                ob[i]->receive_wound("jing", damage * 2, me);
          message_vision(HIM"$N觉得面红耳赤，百脉贲张，心旌摇动，呼吸急促。\n"NOR, ob[i]);
                        }

                        if (userp(ob[i])) ob[i]->fight_ob(me);
                        else if (!ob[i]->is_killing(me)) ob[i]->kill_ob(me); }
                }
                else
                        tell_object(ob[i], "你的年纪尚小，听了一阵，没有什么特别的感受。\n");
        }

        return 1;
}

