        if ((int)me->query("combat_exp") >= 200000 && (int)me->query("max_neili") >= 2000 && (int)me->query_skill("dagou-bang", 1) >= 120) {
                  me->receive_damage("jingli", 60);
                  me->add("neili", -20);
                  return 1;}

        if ((int)me->query("combat_exp") >= 100000 && (int)me->query("max_neili") >= 1200 && (int)me->query_skill("dagou-bang", 1) >= 100 && (int)me->query_skill("dagou-bang", 1) < 180) {
                  me->receive_damage("jingli", 50);
                  me->add("neili", -15);             
                  return 1;}

        if ((int)me->query("combat_exp") >= 50000 && (int)me->query("max_neili") >= 600 && (int)me->query_skill("dagou-bang", 1) >= 60 && (int)me->query_skill("dagou-bang", 1) < 150) {
                  me->receive_damage("jingli", 40);
                  me->add("neili", -10);
                  return 1;}

        if ((int)me->query("combat_exp") >= 10000 && (int)me->query("max_neili") >= 300 && (int)me->query_skill("dagou-bang", 1) >= 30 && (int)me->query_skill("dagou-bang", 1) < 100) {
                  me->receive_damage("jingli", 40);
          me->add("neili", -15);
                  return 1;}

        if ((int)me->query("combat_exp") >= 3000 && (int)me->query("max_neili") >= 100 && (int)me->query_skill("dagou-bang", 1) >= 1 && (int)me->query_skill("dagou-bang", 1) < 50) {
                  me->receive_damage("jingli", 30);
                  me->add("neili", -5);
                  return 1;}

        say("你试着练习打狗棒法，但是并没有任何进步。\n");
*/

  me->receive_damage("jingli", 40);
  me->add("neili", -5);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "dagou-bang/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  string msg, name;
  int i, j, damage;
  object weapon, weapon1;
  name = xue_name[random(sizeof(xue_name))];
  weapon = me->query_temp("weapon");
  weapon1 = victim->query_temp("weapon");
  i = me->query_skill("bangjue", 1);
  j = me->query_skill("dagou-bang", 1);

  if (damage_bonus < 100) return 0;


  if (!victim->is_busy() && i > 100 &&
    victim->query("neili") && j > 100 &&
    me->query_skill_mapped("parry") == "dagou-bang" &&
    me->query("neili") > 400 && me->query("max_neili") > 1200
  ) {
    if (random(20) > 13) {
      switch (random(4)) {
        case 0:
          message_vision(
            GRN "$N" + weapon->name() + "挥出，以“绊”字诀着地扫去，一绊不中，二绊续至，连环钩盘，绵绵而不绝。\n" NOR,
            me,
            victim
          );
          victim->start_busy(3);
          if (!random(2)) {
            message_vision(
              HIR "$n纵身稍慢，被" + weapon->name() + "在左胫上一拨，右踝上一钩，扑地倒了。\n" NOR,
              me,
              victim
            );
            victim->recieve_wound("qi", damage_bonus * j / 10);
          } else
            break;
        case 1:
          message_vision(GRN "$N使出“劈”字诀，挥舞起手中" + weapon->name() + "如狂风暴雨般的打去！\n" NOR, me, victim);
          damage = damage_bonus / 10 + random(damage_bonus) / 5 * j / 20;
          victim->receive_danage("qi", damage / 5);
          victim->receive_wound("qi", damage / 5);
          me->add("neili", -50);
          break;
        case 2:
          message_vision(
            GRN "$N使出“戳”字诀，手中" + weapon->name() + "直上直下，点东打西，招招向$n的要害戳去！\n" NOR,
            me,
            victim
          );
          damage = damage_bonus / 5 * j / 20 + random(damage_bonus) / 10;
          victim->receive_wound("qi", damage / 2);
          me->add("neili", -damage / 5);
          break;
        case 3:
          message_vision(
            GRN "$N棒法再变，使出了“转”字诀。但见" + weapon->name() + "化成了一团碧影，猛点$n后心各大要穴。\n" NOR,
            me,
            victim
          );
          if ((!random(2))) {
            victim->start_busy(5);
            me->add("neili", -40);
            victim->receive_damage(
              "jingli",
              me->query_skill("dagou-bang", 1) / 5 + damage_bonus / 5 * j / 20
            );
            victim->receive_wound(
              "qi",
              me->query_skill("dagou-bang", 1) / 10 + damage_bonus / 5 * j / 20
            );
            message_vision(
              HIR "$n被" + weapon->name() + "点中" RED + name + HIR "，受了点伤！\n" NOR,
              me,
              victim
            );
            message_vision(
              HIR "$n尚未落地，被" + weapon->name() + "又是一挑一打，$n立足不住，仰天一交摔倒。\n" NOR,
              me,
              victim
            );
          }
          break;
      }
    } else if (weapon1 && random(15) < 7) {
      switch (random(2)) {
        case 0:
          if (random(2) != 1) {
            message_vision(
              GRN "$N" + weapon->name() + "疾翻，搭在" + weapon1->name() + "尺许之处，运起“引”字诀，顺势向外牵引! \n" NOR,
              me,
              victim
            );
          } else {
            message_vision(
              GRN "$N" + weapon->name() + "缩回，使起“挑”字诀，搭住" + weapon1->name() + "向上甩出，将$n疾奔的力道传到" + weapon1->name() + "上! \n" NOR,
              me,
              victim
            );
          }
          victim->start_busy(j / 20);
          if (!random(3)) {
            message_vision(
              HIR "$n只感" + weapon1->name() + "似欲脱手飞出，一个把握不住，手中兵器被对方夺了过去。\n" NOR,
              me,
              victim
            );
            weapon1->unequip();
            weapon1->move(environment(victim));
          } else
            victim->start_busy(3);
          break;
        case 1:
          message_vision(
            GRN "$N使个“缠”字诀," + weapon1->name() + "挥到东，" + weapon->name() + "跟向东，" + weapon1->name() + "打到西，" + weapon->name() + "随到西，如影随形，借力制敌。\n" NOR,
            me,
            victim
          );
          damage = damage_bonus / 10 + random(damage_bonus) / 5 * j / 20;
          if ((int)victim->query("jingli") <= damage) {
            victim->set("jingli", 0);
          } else {
            victim->receive_damage("jingli", damage);
          }
          victim->start_busy(3);
          me->add("neili", -damage / 3);
          break;
      }
    }
  }
}
