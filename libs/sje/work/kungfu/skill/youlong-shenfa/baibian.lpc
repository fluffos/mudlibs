// baibian.c 神行百变
// 19990815001

#include <ansi.h>

inherit F_SSERVER;

void remove(object me, object target, int cs);

int perform(object me, object target) {
  //      int sf;
  string msg;
  int skill;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「神行百变」只能在战斗时使用！\n");
  if ((skill = (int)me->query_skill("dodge")) < 200)
    return notify_fail("你的游龙身法还不够熟练，不能使用「神行百变」！\n");
  if (me->query_skill_mapped("dodge") != "youlong-shenfa")
    return notify_fail("只有施展游龙身法时才能使用「神行百变」！\n");
  if ((int)me->query_skill("dulong-dafa", 1) < 120)
    return notify_fail("你的毒龙大法功力不足，不能用「神行百变」。\n");
  if ((int)me->query("jingli", 1) < 150)
    return notify_fail("你现在精力不足，不能使用「神行百变」！\n");
  if (((int)me->query("neili", 1) < 500) && (me->query_temp("sxbb1", 1)))
    return notify_fail("你现在内力不足，不能再次使用「神行百变」！\n");
  if (me->query_temp("sxbb2", 1))
    return notify_fail("你正在使用「神行百变」呢！\n");
  if (me->query_temp("sxbb1", 1)) {
    msg = YEL "\n$N身形往上一提，身法立刻又迅捷了数倍！\n" NOR;
  } else
    msg = HIY "\n$N忽然猛一提气，身法立刻迅捷了数倍！\n" NOR;
  message_vision(msg, me);
  me->add("jingli", -100);
  if (me->query_temp("sxbb1", 1)) {
    me->add("neili", -400);
    me->delete_temp("sxbb1");
    me->set_temp("sxbb2", 1);
    me->apply_condition("no_perform", 2);
    /*me->set_temp("defadd",me->query_skill("parry",1));
		me->add_temp("apply/defense",me->query_temp("defadd",1)/4);
		me->add_temp("apply/dexerity",me->query_temp("defadd",1)/10);*/
  } else {
    me->set_temp("sxbb1", 1);
  }
  if (me->query_temp("sxbb2", 1)) {
    remove_call_out("remove");
    call_out("remove", 1, me, target, me->query("neili") / 200 + 2);
  } else
    call_out("remove", 1, me, target, me->query_skill("force") / 10);
  return 1;
}

void remove(object me, object target, int cs) {
  int sf, tsf, exp, texp, xx, skill, f = 1;

  if (objectp(target) && !userp(target) && target->query("cmc")) {
    target->set("chat_chance_combat", target->query("cmc"));
    target->delete("cmc");
  }
  if (objectp(me)) {
    if (me->query_temp("oqi", 1)) {
      me->add("max_qi", -me->query_temp("oqi", 1));
      if (me->query("eff_qi") > me->query("max_qi"))
        me->set("eff_qi", me->query("max_qi"));
      me->set("qi", me->query("eff_qi"));
      me->delete_temp("oqi");
    }
    if (!objectp(target) || target->is_ghost() || me->is_ghost() || !me->is_fighting())
      cs = 0;
    else if (!living(me))
      cs = 0;
    if (cs <= 0) {
      if (objectp(target) && target->query_temp("adddef", 1)) {
        target->add_temp("apply/defense", -target->query_temp("defbu", 1));
        target->delete_temp("adddef");
      }
      /*if( me->query_temp("sxbb2",1))
			{
				me->add_temp("apply/defense",-me->query_temp("defadd",1)/4);
				me->add_temp("apply/dexerity",-me->query_temp("defadd",1)/10);
			}*/
      me->delete_temp("sxbb1");
      me->delete_temp("sxbb2");
      if (me->query_condition("no_perform", 1))
        me->apply_condition("no_perform", 0);
      if (living(me) && !me->is_ghost()) {
        message_vision(HIW "\n$N身形一顿，身法慢慢地缓慢了下来。\n" NOR, me);
      }
    } else {
      if (me->query_busy() > 1)
        me->start_busy(1);
      if (me->query_temp("sxbb2", 1)) {
        me->apply_condition("no_perform", 4);
        f = 5;
      }
      sf = me->query_dex() + me->query_skill("dodge");
      tsf = target->query_dex() + target->query_skill("dodge");
      exp = me->query("combat_exp");
      texp = target->query("combat_exp");
      xx = 100;
      if (me->query("max_qi") / 10 > xx)
        xx = me->query("max_qi") / 10;
      if (me->query("max_jing") / 10 > xx)
        xx = me->query("max_jing") / 10;
      if (me->query("qi") <= xx || me->query("jing") <= xx ||
        me->query("eff_qi") <= xx || me->query("eff_jing") <= xx) {
        f = 2 * f;
      }
      if ((random(texp) * 100 / (random(exp) * f + 1) + random(tsf) * 100 / (random(sf) * f + 1)) < 200) {
        if (userp(target)) {
          target->apply_condition("no_perform", 3);
          if (!target->query_temp("adddef", 1)) {
            target->set_temp("defbu", target->query_skill("parry", 1) / 4);
            target->add_temp("apply/defense", target->query_temp("defbu", 1));
            target->set_temp("adddef", 1);
          }
        } else if (target->query("chat_chance_combat") != 0) {
          target->set("cmc", target->query("chat_chance_combat"));
          target->delete("chat_chance_combat");
        }
        if (target->query_temp("fanzhen", 1)) {
          skill = (int)me->query_skill("dodge");
          me->set_temp("oqi", skill * 5);
          me->add("max_qi", me->query_temp("oqi", 1));
          me->add("eff_qi", me->query_temp("oqi", 1));
          me->add("qi", me->query_temp("oqi", 1));
        }
        call_out("remove", 2 + random(2), me, target, cs - 1);
      } else {
        if (userp(target)) {
          target->apply_condition("no_perform", 0);
          if (target->query_temp("adddef", 1)) {
            target->add_temp("apply/defense", -target->query_temp("defbu", 1));
            target->delete_temp("adddef");
          }
        }
        call_out("remove", 2, me, target, cs - 1);
      }
    }
  }
  if (objectp(target) && userp(target)) {
    target->apply_condition("no_perform", 0);
    if (target->query_temp("adddef", 1)) {
      target->add_temp("apply/defense", -target->query_temp("defbu", 1));
      target->delete_temp("adddef");
    }
  }
}
