// lieyan-dao 圣火决
// by keinxin@SJ2  2003.3

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int i = me->query_skill("lieyan-dao", 1);
  int d = me->query_skill("shenghuo-shengong", 1);

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target) || !living(target)
    || environment(target) != environment(me))
    return notify_fail("圣火决只能对战斗中的对手使用。\n");

  if (me->query_skill_mapped("force") != "shenghuo-shengong")
    return notify_fail("你的内功不是圣火神功，无法使用圣火决！\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的圣火神功火候不到，不能使用圣火决！\n");
  if ((int)me->query_skill("lieyan-dao", 1) < 100)
    return notify_fail("你的烈焰刀还没有精进，不能使用圣火决！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "blade"
    || me->query_skill_mapped("blade") != "lieyan-dao")
    return notify_fail("你现在无法使用圣火决！\n");


  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够，不能使用圣火决！\n");
  if ((int)me->query("neili") < 300)
    return notify_fail("你现在真气不足，不能使用圣火决！\n");
  if ((int)me->query("jingli") < 200)
    return notify_fail("你现在精力不足，不能使用圣火决！\n");
  if ((int)me->query_temp("shenghuo"))
    return notify_fail("你正在使用圣火决！\n");
  if ((int)me->query_skill("blade", 1) < 80)
    return notify_fail("你的基本刀法不够娴熟，不能使用圣火决。\n");

  message_vision(HIR "\n$N使出烈焰刀之精髓「圣火决」，但见$N双手持" + weapon->name() + "" HIR "，默默呤道：
焚我残躯，熊熊圣火，生亦何欢，死亦何苦？为善除恶，惟光明故！！\n" NOR, me, target);
  me->set_temp("shenghuo", 1 + i / 30);
  me->receive_damage("neili", 150);
  me->receive_damage("jingli", 150);
  me->add_temp("apply/attack", i / 3);
  me->add_temp("apply/damage", d / 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add_temp("apply/attack", -i / 3);
  me->add_temp("apply/damage", -d / 2);
  call_out("check_fight", 1 + random(3), me, 1 + i / 30);
  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("shenghuo");
  if (!living(me)) return;
  message_vision(HIR "\n$N" HIR "的「圣火决」呤颂完毕，气回丹田，缓缓收功。\n" NOR, me);
  if (!me->is_busy()) me->start_busy(1 + random(2));
}

void check_fight(object me, int i) {
  object weapon, target;

  if (!me) return;

  target = offensive_target(me);

  if (!living(me)
    || !target
    || !me->is_fighting(target)
    || !living(target)
    || environment(target) != environment(me)
    || !me->query_temp("shenghuo"))
    return remove_effect(me);

  else if (me->query_skill_mapped("blade") != "lieyan-dao") {
    tell_object(me, HIR "你临时改换刀法，决定不再使用「圣火决」绝技。\n");
    remove_effect(me);
  } else if (me->query_skill_mapped("force") != "shenghuo-shengong") {
    tell_object(me, HIR "你临时改换内功，决定不再使用「圣火决」绝技。\n");
    remove_effect(me);
  } else if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "blade") {
    tell_object(me, HIR "你临时改换武器，决定不再使用「圣火决」绝技。\n");
    remove_effect(me);
  }

  else if (me->is_busy())
    call_out("check_fight", 1 + random(3), me, i);

  else {
    me->receive_damage("neili", 30);
    me->receive_damage("jingli", 10);
    me->add_temp("apply/attack", me->query_skill("lieyan-dao", 1) / 3);
    me->add_temp("apply/damage", me->query_skill("shenghuo-shengong", 1) / 2);
    message_vision(HIR "\n但见$N双手持" + weapon->name() + "" HIR "，默默呤道：
喜乐悲愁，皆归尘土。怜我世人，忧患实多！怜我世人，忧患实多！！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add_temp("apply/attack", -me->query_skill("lieyan-dao", 1) / 3);
    me->add_temp("apply/damage", -me->query_skill("shenghuo-shengong", 1) / 2);
    i--;
    call_out("check_fight", 1 + random(3), me, i);
  }
}
