#include <ansi.h>

inherit F_SSERVER;
void attack_1();
void attack_2();
void attack_3();
void finish();
int perform(object me, object target) {
  object weapon;
  int i = me->query_skill("huashan-jianfa", 1);
  int d = me->query_skill("force", 1);

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target) || !living(target)
    || environment(target) != environment(me))
    return notify_fail(MAG "夺命连环三仙剑" NOR "只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("huashan-jianfa", 1) < 100)
    return notify_fail("你的剑法还未练成，不能使用" HIG "夺命连环三仙剑" NOR "！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huashan-jianfa")
    return notify_fail("你手里没有剑，无法使用" MAG "夺命连环三仙剑" NOR "！\n");

  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query("neili") < 600)
    return notify_fail("你现在真气不足，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query("jingli") < 500)
    return notify_fail("你现在精力不足，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本剑法不够娴熟，不能在剑招中使用" HIG "夺命连环三仙剑" NOR "。\n");

  message_vision(MAG "\n$N长啸一声，使出平生绝技，连环三击，正是华山剑宗绝学“夺命连环三仙剑”！\n" NOR, me, target);

  target->add_temp("apply/parry", -i);
  target->add_temp("apply/dodge", -i * 2);

  me->add("neili", -300);
  me->add("jingli", -100);
  me->add_temp("apply/attack", i / 2);
  me->add_temp("apply/damage", d / 4);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add_temp("apply/attack", -i / 2);
  me->add_temp("apply/damage", -d / 4);
  if (living(target)) {
    target->add_temp("apply/parry", i);
    target->add_temp("apply/dodge", i * 2);
  }
  me->start_perform(3, "「" MAG "夺命连环三仙剑" NOR "」");
  return 1;
}
