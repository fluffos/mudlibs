// jianzhang.c 剑掌五连环

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
      int lvl;
      object weapon;
      weapon = me->query_temp("weapon");
      lvl = ( (int)me->query_skill("huashan-jianfa", 1) + (int)me->query_skill("hunyuan-zhang", 1) ) /6;
      if( !target ) target = offensive_target(me);
     
      if( !target || !me->is_fighting(target) )
      return notify_fail("剑掌五连环只能在战斗中对对手使用。\n");

      if( (string)me->query("gender") != "男性" )
      return notify_fail("只有男弟子才能用出剑掌五连环。\n");   

      if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "huashan-jianfa")
      return notify_fail("你手里没有剑，无法使用剑掌五连环！\n");             

      if( (int)me->query_skill("huashan-jianfa",1) < 120 )
      return notify_fail("你的华山剑法不够娴熟，不能使用剑掌五连环！\n");
      
      if( (int)me->query_skill("sword",1) < 120 )
      return notify_fail("你的基本剑法等级不够，不能使用剑掌五连环！\n");  

      if( (int)me->query_skill("hunyuan-zhang", 1) < 120 )
      return notify_fail("你的混元掌法等级不够，不能使用剑掌五连环！\n");
      
      if( (int)me->query_skill("zixia-gong", 1) < 100 )
      return notify_fail("你的紫霞神功等级不够，不能使用剑掌五连环！\n");
      if (me->query_skill_mapped("force") != "zixia-gong")
                return notify_fail("你所使用的内功不对。\n");
      if( (int)me->query("max_neili") < 2000 )
      return notify_fail("你的内力太弱，不能使用剑掌五连环！\n");
      
      if( (int)me->query("neili") < 1800 )
      return notify_fail("你的内力太少了，无法使用出剑掌五连环！\n");   
       if((int)me->query("jingli")<1000)
      return notify_fail("你的精力太低了，无法使用剑掌五连环！\n");                                                                          
      if (me->query_skill_prepared("strike") != "hunyuan-zhang"
          || me->query_skill_mapped("strike") != "hunyuan-zhang")
      return notify_fail("你没有备混元掌，现在无法使用剑掌五连环进行攻击。\n");

      if (me->query_skill_prepared("cuff") == "poyu-quan")
      return notify_fail("你不能备破玉拳。\n");

      message_vision(HIR"\n突然天空中一道惊雷，$N使出全身力量，象$n奋力击出三剑两掌。\n"NOR, me,target);
      me->add("neili", -550); 
      me->add("jingli", -350);      
      me->add_temp("apply/strength", lvl/10);
      me->add_temp("apply/attack", lvl/10);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
      me->start_busy(2);
      target->start_busy(2);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
      me->start_busy(2);
      target->start_busy(2);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
      me->start_busy(2);
      target->start_busy(2);
      weapon->unequip(); 
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
      me->start_busy(2);
      target->start_busy(2);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);  
      me->add_temp("apply/strength", -lvl/10);
      me->add_temp("apply/attack", -lvl/10);
      weapon->wield();
      me->start_busy(random(2)+1);
      me->start_perform(3,"剑掌五连环");
      return 1;
}
