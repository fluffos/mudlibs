// juehu-shou.c -虎爪绝户手

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一式「老牛拉车」，以掌化爪，五指如钩，两眼瞪得通红，直逼$n的裆部",
    "force": 180,
    "dodge": 10,
    "parry": 20,
    "lvl": 0,
    "skill_name": "老牛拉车",
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N四肢贴地，头部底垂，看似已无力进攻，突然四肢用力一扒已窜到$n跨下，\n" +
    "两手猛的上戳，好一式「精疲力尽」",
    "force": 220,
    "dodge": 10,
    "parry": -20,
    "lvl": 24,
    "skill_name": "精疲力尽",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两手高高举起，运掌如风，一式「壮士断腕」，闭眼就朝$n的下体砍去",
    "force": 270,
    "dodge": -5,
    "parry": 10,
    "lvl": 48,
    "skill_name": "壮士断腕",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一跃而起，直往$n的双肩落下，双腿盘住$n的颈部，一扭腰，双手成关门之势，\n" +
    "往$n的裆部狠狠拍去，正是一式「落叶归根」",
    "force": 340,
    "dodge": 15,
    "parry": 20,
    "lvl": 72,
    "skill_name": "落叶归根",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「空前绝后」，身形一分为二，四只手掌有如熊掌般朝$n的后腰和裆部拍去",
    "force": 420,
    "dodge": -10,
    "parry": -25,
    "lvl": 96,
    "skill_name": "空前绝后",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N全身关节啪啪作响，面如白纸，一式「断子绝孙」，无数鹰爪抓向$n全身要害，\n" +
    "瞬间无数鹰爪又合为一爪直往$n的裆部抓落",
    "force": 480,
    "dodge": -15,
    "parry": -30,
    "lvl": 120,
    "skill_name": "断子绝孙",
    "damage_type": "抓伤"
  ])
});

int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }
int valid_combine(string combo) { return combo == "wudang-quan"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练虎爪绝户手必须空手。\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 100)
    return notify_fail("你的氤氲紫气火候不够，无法学虎爪绝户手。\n");
  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力太弱，无法练虎爪绝户手。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("juehu-shou", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  int lvl = me->query_skill("juehu-shou", 1);
  int i = sizeof(action);
  while (i--) if (lvl == action[i]["lvl"]) return 0;

  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练虎爪绝户手。\n");
  me->receive_damage("jingli", 35);
  me->add("neili", -10);
  me->add("shen", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "juehu-shou/" + action;
}
