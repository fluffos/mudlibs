// cibei.c 慈悲

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int check_fight(object me, int amount, object weapon);

int perform(object me, object target) {
  object weapon = me->query_temp("weapon");
  string msg;
  int ap, dp, damage, i, improve, jl;
  if (!target) target = offensive_target(me);

  if (!weapon || weapon->query("skill_type") != "whip")
    return notify_fail("你手里无鞭，无法使用「慈悲绝技」！\n");
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("[慈悲绝技]只能在战斗中使用。\n");
  if ((int)me->query_temp("chb_cb"))
    return notify_fail("你正在使用「慈悲绝技」绝技。\n");


  if ((int)me->query_skill("kurong-changong", 1) < 160)
    return notify_fail("你的内功修为不够，使不出「慈悲绝技」绝技。\n");
  if (me->query_skill_mapped("force") != "kurong-changong")
    return notify_fail("没有枯容禅功作为根基，是无法使出「慈悲绝技」绝技的！\n");
  if ((int)me->query_skill("cihang-bian", 1) < 160)
    return notify_fail("你的慈航鞭法修为不够,目前还不能使用「慈悲绝技」！\n");
  if ((int)me->query_skill("buddhism", 1) < 180)
    return notify_fail("佛门神功，慈悲为怀，你佛法修为甚浅，如何使用这门神功？\n");
  if ((int)me->query("max_neili") < 2500)
    return notify_fail("你内力修为现在不够, 不能用「慈悲绝技」！\n");
  if ((int)me->query("neili") < 800)
    return notify_fail("你内力用尽, 不能用「慈悲绝技」！\n");
  me->set_temp("chb_cb", 1);
  me->add("neili", -500);
  improve = (int)me->query_skill("buddhism", 1) / 3;
  improve += me->query_str();
  check_fight(me, improve, weapon);
  me->start_perform(1, "慈悲绝技");
  if (random((int)me->query_skill(
    "cihang-bian",
    1
  ) + (int)me->query_skill("buddhism", 1) + (int)me->query_skill("whip", 1)) > 600)
    i = 0;
  else if (random((int)me->query_skill(
    "cihang-bian",
    1
  ) + (int)me->query_skill("buddhism", 1) + (int)me->query_skill("whip", 1)) > 400)
    i = 1;
  else
    i = 2;

  //tell_object(me,"i=%d",i);
  switch (i) {
    case 0:
      msg = HIC "$N口中高宣佛号，使出慈航鞭中「慈悲」绝技，手中长索滚动飞舞，\n";
      msg += "宛若念珠乱颤，自上而下劈向$n,接着$N手腕一抖，便如如来降魔\n";
      msg += "似，急升而上，又往$n扑到。\n" NOR;
      message_vision(msg, me, target);
      ap = random(me->query("combat_exp") + me->query_skill(
        "buddhism",
        1
      )) * (1 + random(me->query("int") / 4));
      dp = (int)target->query("combat_exp") / 3;

      if (ap > dp) {
        damage = me->query_skill(
          "cihang-bian",
          1
        ) + me->query_skill("whip", 1) + me->query_skill("buddhism", 1);
        damage = damage * (1 + random(2));
        if (damage > 2000)
          damage = 2000;
        msg = RED "$n大惊失色，躲闪不及，被淹没在漫天鞭影当中。\n" NOR;
        target->receive_damage("qi", damage / 3);
        target->receive_wound("qi", damage / 5);
        target->stary_busy(2 + random(2));
        message_vision(msg, me, target);

      } else {
        msg = "$n早知厉害,一见鞭出早以跳出圈外。\n";
        me->start_busy(random(3));
        message_vision(msg, me, target);
      }
      break;
    case 1:
      msg = HIY "$N高宣“阿弥陀佛！”，使出「慈悲」字诀，手中长索一扬，向$n的咽喉点去，\n";
      msg += "索头未到，索上所挟劲风犹如红日当空，令对方一阵气窒，只听见「啪啪」几声巨响，\n";
      msg += "索头昂起，便如一条假死的毒蛇忽地反噬挥动，带动无数风沙，呼啸而出。\n" NOR;
      message_vision(msg, me, target);
      //         for (jl=0;jl<2;jl++)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
      me->start_busy(2);
      break;
    case 2:
      msg = HIW "$N又宣“我佛慈悲！”，又使出「慈悲」字诀，内力返照空明，功力精纯，不露棱角，\n";
      msg += "手中长索舞动时瞧不见半点影子无声无息，似缓实急，却又大开大阔，如天神，\n";
      msg += "说不尽的莫测高深。\n" NOR;
      message_vision(msg, me, target);

      break;

  }
}
int check_fight(object me, int amount, object weapon) {
  object wep, target;
  target = offensive_target(me);

  if (!me) return 0;

  if (!me->is_fighting() || !living(me) || me->is_ghost()
    || !objectp(wep = me->query_temp("weapon")) || weapon != wep) {
    me->delete_temp("chb_cb");
    message_vision(HIC "\n只听见$N一声轻叹，长鞭渐渐缓慢下来。\n" NOR, me);
  }

  else if (me->is_busy())
    call_out("check_fight", 2 + random(3), me, amount, weapon);


  else {
    me->add_temp("apply/damage", amount);
    me->add_temp("apply/attack", amount);
    message_vision(HIW "$N高宣“我佛慈悲！渡世渡人！”，使出「慈悲」诀，内力返照空明，功力精纯。手中长索一扬，带动无数风沙，呼啸而出。\n" NOR, me);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add_temp("apply/damage", -amount);
    me->add_temp("apply/attack", -amount);
    call_out("check_fight", 2 + random(5), me, amount, weapon);
  }

}
