// tiandi.c

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");

  if (me->is_busy())
    return notify_fail("你正忙着哪！\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 30)
    return notify_fail("你的临济十二庄修为还不够。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的真气不够。\n");
  if ((int)me->query("eff_qi") >= (int)me->query("max_qi"))
    return notify_fail("你没有受伤。\n");
  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 3)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
  write(HIY "你习地而做，默念临济十二庄「天地」诀，运起临济十二庄功开始疗伤。\n" NOR);
  message_vision(HIW "只见$N吐出一口瘀血，脸色看起来好多了。\n" NOR, me);

  me->receive_curing("qi", 100 + (int)me->query_skill("force") / 3);
  me->add("neili", -50);
  me->set("jiali", 0);
  me->start_busy(2);
  return 1;
}
