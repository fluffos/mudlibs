// zm_busy.c

#include <ansi.h>

int update_condition(object me, int duration)
{
        if (duration <= 1){
        	me->delete_temp("renwu");
        	tell_object(me, HIY "远处传来三声响箭，你的任务失败了！\n" NOR);
        	return 0;
                }
        me->apply_condition("zm_busy", duration - 1);
        return 1;
}
