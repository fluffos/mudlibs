#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   
      tell_object(me, HIB "突然你感觉眼前一黑，一股热气在心头盘旋不去！\n" NOR );
      tell_room(environment(me), HIB + me->name()+"突然全身一颤，头脸涨的通红，张口欲呕，却又呕不出什么！\n" NOR,
                ({ me }));     
  
      me->receive_damage("qi", 25);
      me->receive_wound("jing", 20);
      me->set_temp("last_damage_from", "中蟾蜍毒粉剧毒");
      me->apply_condition("chanchu_poison", duration - 1);
   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}
