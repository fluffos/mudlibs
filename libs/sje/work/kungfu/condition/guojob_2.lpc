// xx_task.c

#include <ansi.h>

int update_condition(object me, int duration)
{
        if (duration <= 1){
            if(me->query_temp("guo_job2/finish") >= 3 ){
            tell_object(me,HIY "蒙古人停止了进攻襄阳！\n" NOR);
            me->delete_temp("guo_job2");
            me->set_temp("guo_kill",1);
            }
            if(me->query_temp("guo_job2/finish") < 3 ){
            me->delete_temp("guo_job2");
            me->set_temp("guo_kill",1);
            }
        	return 0;
                }
        if( file_name(environment(me)) == "/d/xiangyang/xuanwumen" )
            tell_object(me,HIY "远处喊杀声震天，蒙古大军已经逼近襄阳！\n" NOR);
    
        if( file_name(environment(me)) == "/d/xiangyang/xuanwumen" 
         && ( duration == 3 
           || duration == 9
           || duration == 15
           || duration == 21 )){
           me->add_temp("guo_job2/finish",1);
           new("/d/xiangyang/job/menggu-bing")->move(environment(me));
           new("/d/xiangyang/job/menggu-bing")->move(environment(me));
        }
                
        me->apply_condition("guojob_2", duration - 1);
        return 1;
}
