int update_condition(object me, int duration)
{
	if (duration < 1) {
		tell_object(me, "官府不再通缉你了！\n");
		return 0;
	}
	
/*
//      only for restruct pk
	 if( duration % 10 == 0 
           || duration == 179
           || duration == 15
           || duration == 21 ){
           new("/d/city/npc/xunbu2")->move(environment(me));
        }
*/	
	me->apply_condition("killer", duration - 1);
	return 1;
}
