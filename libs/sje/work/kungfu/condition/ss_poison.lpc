//    生死符
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
      int ss_count;
      int ss_level;
      ss_count=0;
      if( !living(me) ) return CND_CONTINUE;
      me->set_temp("last_damage_from", "体内生死符发作");
      ss_count=me->query("ss_poison/count");
      ss_level=me->query("ss_poison/level");
      tell_object(me, HIB "霎时之间，你觉得缺盆、天枢、天兔、天泉、天柱、神道、志室七处穴道中同时麻痒难当，直如千千万万只蚂蚁同时在咬啮一般。\n" NOR );
      if( ss_level>1 && ss_count>5)
      {
          tell_room(environment(me), HIB + me->name()+"终於支持不住,用力撕抓自己的身体，不住口的号叫：“痒死我了！痒死了！”\n" NOR,
                   ({ me }));
          me->receive_wound("qi", 20);
          me->receive_wound("jing", 10);
      }else
      {
          tell_room(environment(me), HIB + me->name()+"有如喝醉了酒一般，脸上一阵红，一阵白，双手乱舞，情状可怖已极。\n" NOR,
          ({ me }));
      }
      if( (int)me->query_skill("poison",1) >150 )
      {
           me->receive_wound("qi", 10);
           me->receive_wound("jing", 5);
      }else{
           me->receive_wound("qi", 15);
           me->receive_wound("jing", 10);
      }
      if(!me->is_fighting()) me->start_busy(10);
      if(!me->is_busy()) me->start_busy(5);
      if( duration < 1 )
      {
          // is not user
          if(!userp(me)) 
          {
            me->clear_condition("ss_poison");
            return 0;
          }
          if( ss_count <1 )
          {
              me->set("ss_poison/count",0);
              me->set("ss_poison/level",0);
              me->set("ss_poison/bmsg",0);
              me->clear_condition("ss_poison");
              if( random(me->query("kar"))> 1 ){
                   tell_object(me, HIY "你总算福大命大，逃过此劫。\n" NOR );
              }else{
                   tell_object(me, HIY "你开始后悔当初跟逍遥派作对，但为时已晚。\n" NOR );
                   me->die();
              }
              return 0;
          }else
          {
               ss_count--;
               tell_object(me, HIR "你觉得全身穴道有如针刺一样疼痛，大叫一声，昏厥过去。\n" NOR );
//               me->apply_condition("ss_poison", ss_count);
               me->set("ss_poison/count",0);
               me->unconcious();
               return CND_CONTINUE;
          }
      }
      me->apply_condition("ss_poison", duration - 1);
      ss_count++;
      me->set("ss_poison/count",ss_count);
      return CND_CONTINUE;
}
string query_type(object me)
{
    return "poison";
}
