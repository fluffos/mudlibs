#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  tell_object(me, HIR "你觉得无数小球儿在眼前飞舞，红的、紫的、青的、绿的、黄的、白的、蓝的……鲜艳之极。！\n" NOR);
  tell_room(environment(me), HIR + me->name() + "面孔扭曲，弯下腰不住低哼，浑身不停的颤抖！\n" NOR, ({ me }));
  me->receive_wound("qi", random(200) * (1 + random(3)));
  me->receive_wound("jing", random(150) * (1 + random(3)));
  me->set_temp("last_damage_from", "中七虫七花之毒");
  me->apply_condition("qichong_poison", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}


string query_type(object me) {
  return "poison";
}
