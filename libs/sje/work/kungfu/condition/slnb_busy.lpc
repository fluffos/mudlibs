// slnb_busy.c

#include <login.h>
#include <ansi.h>
int update_condition(object me, int duration)
{
        if (duration < 1) {               
              me->clear_condition("slnb_busy");
                }
        if (!duration) return 0;
        me->apply_condition("slnb_busy", duration - 1);
        return 1;
}

