#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration)
{

        if (duration < 1 ){
                      me->delete_temp("guo_zuji");
                      me->delete_temp("guo_job1");
                      me->delete_temp("guo_job1npc");
               if((int)me->query_temp("quest/time") >0 &&
                   me->query_temp("quest/time") < time()) {
                           tell_object(me, HIY "蒙古大军已经开始攻打襄阳，你的任务失效！\n" NOR);
                           if( me->query("guo_job") > 0) 
                                  me->add("guo_job", -1);
                           }
               return 0;
               }
        if( me->query_temp("guo_zuji")< me->query_temp("guo_job1npc")
          && random(me->query_kar()) < 25
          && (interactive(me))
          && !environment(me)->query("no_fight")
          && me->query_temp("guo_job1")){
               tell_object(me, HIY "你觉的有些不妙，似乎被人跟踪上了！\n" NOR);
               if(!me->is_busy())
                     me->start_busy(2+random(3));
               me->add_temp("guo_zuji",1);      
               call_out("zuji", 1, me);    
        }
        me->apply_condition("guojob_1", duration - 1);
        return CND_CONTINUE;
}

void zuji(object me)
{
        object obj, npc; 
       
        tell_object(me, RED "糟糕！有人要抢告急文书！\n" NOR);

           if (me->query("combat_exp") > 500000 ){
                tell_object(me,"糟糕，又冲上来了个人。。!!! \n");
                npc = new("/d/dali/job/killer");
                npc->move(environment(me));
                npc->do_copy(me);
                }

                npc = new("/d/dali/job/stealer");
                npc->move(environment(me)); 
                npc->do_copy(me); 
          if(objectp(obj = present("wenshu", me))){   
                          tell_object(me,"你隐约感觉到有人围了过来。。!!! \n"RED "你紧张起来，不由一摸衣袋，不好！文书被偷了!\n" NOR);   
                obj->move(npc);
               }
        else tell_room(environment(me), HIR"杀手惊道：“这人身上怎么没有文书？！管他的，先做掉这人再说！”\n"NOR);
        return;
}

