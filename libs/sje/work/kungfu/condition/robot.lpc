#include <ansi.h>
#include <login.h>
#include <condition.h>

int update_condition(object me, int duration)
{
      object where;
	if (duration < 1) {
		me->set("robot/done", 1);
		return 0;
	}
	if (!duration) return 0;
        where = environment(me);
        if (duration >= 1 
        && base_name(where) != ROBOT_HOUSE) {		
message_vision(
"\n突然冲出来一个收废铁的，对着$N大叫道：'看你这机器人还能逃到哪儿去！'
接着便是锤棒刀剑齐下，顿时将$N拆成了零件......\n" NOR, me);
                me->unconcious();
           message_vision("收废铁的扛起$N的零件，摇摇摆摆走出去了。\n", me);
                me->move(ROBOT_HOUSE);
message_vision(
"只听乒地一声，一个收废铁的走进来，拿出零件拼装出一个$N来！\n" NOR, me);
	}
	me->apply_condition("robot", duration - 1);
	return CND_CONTINUE;
}

string query_type(object me)
{
	return "robot";
}
