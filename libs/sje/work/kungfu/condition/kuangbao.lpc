#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {

  string msg;

  me->receive_wound("qi", random(300));
  me->receive_wound("jing", random(200));
  me->set_temp("last_damage_from", "真气逆行走火入魔");

  if (me->query("jing") * 100 / me->query("max_jing") > 80)
    msg = RED "$N突然只膝弯曲，身子慢慢垂下，口中发出似人似兽的荷荷之声。\n" NOR;
  else if (me->query("jing") * 100 / me->query("max_jing") < 80 && me->query("jing") * 100 / me->query("max_jing") > 60)
    msg = RED "$N忽然满面堆欢裂嘴嘻笑，更显得诡异无伦。\n" NOR;
  else if (me->query("jing") * 100 / me->query("max_jing") < 60 && me->query("jing") * 100 / me->query("max_jing") > 40)
    msg = RED "$N神智更加胡涂，指东打西，乱□乱咬。\n" NOR;
  else msg = RED "$N突然筋肉爆起，不停地发颤，眼神甚是恐怖。\n" NOR;

  message_vision(msg, me);

  if (duration < 1) {
    me->set_temp("apply/dexerity", 0);
    me->set_temp("apply/strength", 0);
    me->set_temp("last_damage_from", "真气逆行走火入魔");
    msg = RED "$N再也控制不住自己的真气，大叫一声，全身流血不止。\n" NOR;
    me->set_temp("apply/short", ({ me->name() + "(" + me->query("id") + ")" NOR }));
    message_vision(msg, me);
    me->unconcious();
    me->die();
    return 0;
  }
  me->apply_condition("kuangbao", duration - 1);
  return CND_CONTINUE;
}

string query_type(object me) {
  return "poison";
}
