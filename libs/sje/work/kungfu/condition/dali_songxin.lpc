#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration) {

  if (duration < 1) {
    me->delete_temp("songxin_zuji");
    if ((int)me->query_temp("quest/time") > 0 &&
      me->query_temp("quest/time") < time()) {
      tell_object(me, HIY "你时间已过，任务失效！\n" NOR);
      me->apply_condition("job_busy", 25 + random(5));
      if (me->query("dali_job") > 0)
        me->add("dali_job", -1);
    }
    return 0;
  }
  if (!me->query_temp("songxin_zuji")
    && random(me->query_kar()) < 15
    && (interactive(me))
    && !environment(me)->query("no_fight")
    && me->query_temp("dali_songxin")) {
    tell_object(me, HIY "你觉的有些不妙，似乎被人跟踪上了！\n" NOR);
    if (!me->is_busy())
      me->start_busy(1 + random(2));
    call_out("zuji", 0, me);
  } else if (!me->query_temp("songxin_zuji")
    && !me->is_fight()
    && me->query_temp("dali_songxin"))
    me->start_busy(3);
  me->apply_condition("dali_songxin", duration - 1);
  return CND_CONTINUE;
}

void zuji(object me) {
  object obj, npc;

  tell_object(me, RED "糟糕！有人要抢信!\n" NOR);




  /*        npc = new("/d/dali/job/killer");
        npc->move(environment(me));
        npc->do_copy(me);
*/
  if (me->query("combat_exp") > 500000) {
    tell_object(me, "糟糕，又冲上来了个人。。!!! \n");
    npc = new("/d/dali/job/killer");
    npc->move(environment(me));
    npc->set("skill_down", 10);
    npc->do_copy(me);
  }

  //        if(objectp(obj = present("secret letter", me))){

  npc = new("/d/dali/job/stealer");
  npc->move(environment(me));
  npc->do_copy(me);
  if (objectp(obj = present("secret letter", me))) {
    tell_object(me, "你隐约感觉到有人围了过来。。!!! \n" RED "你紧张起来，不由一摸衣袋，不好！信被偷了!\n" NOR);
    obj->move(npc);
    me->delete_temp("stealernotmet", 1);
  } else tell_room(environment(me), CYN "杀手惊道：“这人身上怎么没有信？！管他的，先做掉这人再说！”\n" NOR);
  return;
}
