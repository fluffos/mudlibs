// mj_tasting.c

#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration) {
  if (duration < 1) {
    tell_object(me, HIY "你的时间已过，任务失败。\n" NOR);
    me->delete_temp("assigned_by");
    me->delete_temp("promotion_target");
    me->add("gb_job", -1);
    return 0;
  }
  if (!duration) return 0;
  me->apply_condition("gb_mission", duration - 1);
  return 1;
}
