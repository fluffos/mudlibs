void skill_adjust(object ob)
{
        mapping skl;
        string *sname;
        int i=3, lmt;

        lmt = (int)ob->query("combat_exp");
        if (lmt < 0) lmt = 0;
    if (ob->query("shen") > lmt) ob->set("shen", lmt);
    if (ob->query("shen") < -lmt) ob->set("shen", -lmt);
    if (ob->query("reputation") > lmt) ob->set("reputation", lmt);
        for (;i*i*i/10<=lmt;i++);
        lmt = i;
        ob->set("max_pot", 100 + lmt);
        if (ob->query("potential") > ob->query("max_pot"))
                ob->set("potential", ob->query("max_pot"));
        skl = ob->query_skills();
        if (!sizeof(skl))
                return;
        sname = keys(skl);
        for (i = 0; i < sizeof(skl); i++) {
                if (!intp(skl[sname[i]])) skl[sname[i]] = 0;
                if (SKILL_D(sname[i])->type() == "martial" && skl[sname[i]] > lmt)
                        skl[sname[i]] = lmt;
        }
        switch (ob->query("family/family_name")) {
/*        case "昆仑派":
        if (skl["art"] > 101) {
        ob->add("max_jing", (skl["art"]/2-50)*(skl["xuantian-wuji"]/20));
        ob->add("max_qi", (skl["art"]/2-50)*(skl["xuantian-wuji"]/20));
        }
        break; */
        case "少林派":
        if (skl["buddhism"] > 81)
        ob->add("max_jing", (skl["buddhism"]/2-40)*(skl["yijin-jing"]/10));
        break;
        case "峨嵋派":
        if (skl["dacheng-fofa"] > 81)
        ob->add("max_jing", (skl["dacheng-fofa"]/2-40)*(skl["linji-zhuang"]/10));
        break;
   case "桃花岛":   
        if (skl["qimen-bagua"] > 101)
        ob->add("max_qi", (skl["qimen-bagua"]/2-50)*(skl["bihai-chaosheng"]/10));
  break;
        case "武当派":
        if (skl["taoism"] > 81)
        ob->add("max_qi",(skl["taoism"]/2-40)*(skl["yinyun-ziqi"]/10));
        break;
        case "天龙寺":
        if (skl["buddhism"] > 81)
        ob->add("max_jing", (skl["buddhism"]/2-40)*(skl["kurong-changong"]/10));
        break;
   case "大轮寺":
        if (skl["huanxi-chan"] > 81)
          ob->add("max_jing", (skl["huanxi-chan"]/2-40)*(skl["longxiang-boruo"]/10));
        break;     
   case "星宿派":
        if (skl["poison"] > 101)
        ob->add("max_qi", (skl["poison"]/2-50)*(skl["huagong-dafa"]/10));
        break;
        case "丐帮":
        if (skl["bangjue"] > 101)
        ob->add("max_jing",(skl["bangjue"]/2-50)*(skl["huntian-qigong"]/10));
        break;
        case "神龙教":
        if (skl["shenlong-yaoli"] > 101)
        ob->add("max_jing", (skl["shenlong-yaoli"]/2-50)*(skl["dulong-dafa"]/10));
        break;
        case "华山派":
        if (skl["zhengqi-jue"] > 101 ) {
        ob->add("max_qi", (skl["zhengqi-jue"]/2-50)*(skl["zixia-gong"]/20));
        }
        if (skl["ziyin-yin"] > 101 ) {
        ob->add("max_jing", (skl["ziyin-yin"]/2-50)*(skl["zixia-gong"]/20));
        }                       
  break;
     } 
}
