#include <ansi.h>
string query(string name) {
  if (name == "channel_id") return "调整精灵";
  return 0;
}

void skill_adjust(object ob) {
  mapping skl;
  string *sname;
  int i = 3, lmt;
  int zs_attack, zs_damage, zs_armor;
  int b_attack, b_damage, b_armor;
  int st = ob->query("str"), intt = ob->query("int"), co = ob->query("con"), de = ob->query("dex");
  int ka = ob->query("kar"), pe = ob->query("per"), pu = ob->query("pur");
  int death = ob->query("death_times");
  int age = ob->query("age");

  if (death > 50) death = 50;

  "/cmds/usr/top"->add_rank(ob);
  lmt = st + intt + co + de;
  if (!wiz_level(ob) && (lmt > 80 || st > 30 || intt > 30 || co > 30 || de > 30 || ka > 30 || pe > 30 || pu > 30))
    CHANNEL_D->do_channel(this_object(), "sys",
      sprintf("%s(%s)天赋异禀：膂=%d 悟=%d 根=%d 身=%d 福=%d 容=%d 纯=%d 头四项和=%d",
        ob->name(1), capitalize(ob->query("id")), st, intt, co, de, ka, pe, pu, lmt));
  lmt = (int)ob->query("combat_exp");
  if (lmt < 0) lmt = 0;
  if (ob->query("shen") > lmt) ob->set("shen", lmt);
  if (ob->query("shen") < -lmt) ob->set("shen", -lmt);
  if (ob->query("reputation") > lmt) ob->set("reputation", lmt);
  for (; i * i * i / 10 <= lmt; i++);
  lmt = i;
  ob->set("max_pot", 100 + lmt);
  //        if (ob->query("potential") > ob->query("max_pot"))
  //                ob->set("potential", ob->query("max_pot"));

  //      调整年龄增大的精和气的减少  adm/ademons/race/human.c那个写的太乱了，懒得改，这里加一个方便。keinxin
  //      调整是根据年龄累计的。
  if (age > 40) {
    ob->add("max_qi", -(age - 40) * 100);
    ob->add("max_jing", -(age - 40) * 50);
  }

  if (age > 45) {
    ob->add("max_qi", -(age - 45) * 80);
    ob->add("max_jing", -(age - 45) * 50);
  }

  if (age > 50) {
    ob->add("max_qi", -(age - 45) * 80);
    ob->add("max_jing", -(age - 45) * 50);
  }

  if (age > 55) {
    ob->add("max_qi", -(age - 55) * 80);
    ob->add("max_jing", -(age - 55) * 50);
  }

  if (age > 60) {
    ob->add("max_qi", -(age - 55) * 80);
    ob->add("max_jing", -(age - 55) * 50);
  }

  if (age > 65) {
    ob->add("max_qi", -(age - 65) * 80);
    ob->add("max_jing", -(age - 65) * 50);
  }

  if (age > 70) {
    ob->add("max_qi", -(age - 65) * 80);
    ob->add("max_jing", -(age - 65) * 50);
  }

  if (age > 75) {
    ob->add("max_qi", -(age - 75) * 80);
    ob->add("max_jing", -(age - 75) * 50);
  }


  b_attack = random(20);
  b_damage = random(20);
  b_armor = random(20);

  ob->add_temp("apply/attack", b_attack);
  ob->add_temp("apply/damage", b_damage);
  ob->add_temp("apply/armor", b_armor);

  tell_object(ob, sprintf(BLINK + HIR "在本次登录，你额外获得了「%s」点命中率，「%s」点攻击力，「%s」点防御力。仅在本次登录有效，不可累计！" NOR "\n",
    chinese_number(b_attack), chinese_number(b_damage), chinese_number(b_armor)));


  if (ob->query("zhuansheng") > 0) {
    zs_attack = 100;
    zs_damage = 100;
    zs_armor = 100;

    ob->add_temp("apply/attack", zs_attack);
    ob->add_temp("apply/damage", zs_damage);
    ob->add_temp("apply/armor", zs_armor);

    tell_object(ob, sprintf(BLINK + HIG "由于转生，在本次登录，你额外获得了「%s」点命中率，「%s」点攻击力，「%s」点防御力。仅在本次登录有效，不可累计！" NOR "\n",
      chinese_number(zs_attack), chinese_number(zs_damage), chinese_number(zs_armor)));

  }


  skl = ob->query_skills();
  if (!sizeof(skl))
    return;
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (!intp(skl[sname[i]])) skl[sname[i]] = 0;
    if (SKILL_D(sname[i])->type() == "martial" && skl[sname[i]] > lmt) {
      tell_object(ob, sprintf("由于经验限制，你的「%s」从%s级降到了%s级。\n",
        to_chinese(sname[i]), chinese_number(skl[sname[i]]), chinese_number(lmt)));
      skl[sname[i]] = lmt;
    }
  }
  switch (ob->query("family/family_name")) {

    case "少林派":
      if (skl["buddhism"] > 81)
        ob->add("max_qi", (skl["buddhism"] / 3) * (skl["yijin-jing"] / 10));
      ob->add("max_jing", (skl["buddhism"] / 3) * (skl["yijin-jing"] / 15));
      break;
    case "峨嵋派":
      if (skl["dacheng-fofa"] > 81)
        ob->add("max_qi", (skl["dacheng-fofa"] / 3) * (skl["linji-zhuang"] / 10));
      ob->add("max_jing", (skl["dacheng-fofa"] / 3) * (skl["linji-zhuang"] / 10));
      break;
    case "昆仑派":
      if (skl["force"] > 81)
        ob->add("max_qi", (skl["force"] / 3) * (skl["xuantian-wuji"] / 10));
      ob->add("max_jing", (skl["force"] / 3) * (skl["xuantian-wuji"] / 10));
      break;
    case "桃花岛":
      if (skl["force"] > 101)
        ob->add("max_jing", (skl["force"] / 3) * (skl["bihai-chaosheng"] / 10));
      ob->add("max_qi", (skl["force"] / 3) * (skl["bihai-chaosheng"] / 10));
      break;
    case "武当派":
      if (skl["taoism"] > 81)
        ob->add("max_qi", (skl["taoism"] / 3) * (skl["yinyun-ziqi"] / 8));
      ob->add("max_jing", (skl["taoism"] / 3) * (skl["yinyun-ziqi"] / 8));
      break;
    case "天龙寺":
      if (skl["buddhism"] > 81)
        ob->add("max_jing", (skl["buddhism"] / 3) * (skl["force"] / 10));
      ob->add("max_qi", (skl["buddhism"] / 3) * (skl["force"] / 15));
      break;
    case "大轮寺":
      if (skl["huanxi-chan"] > 81)
        ob->add("max_jing", (skl["huanxi-chan"] / 3) * (skl["longxiang-boruo"] / 10));
      ob->add("max_qi", (skl["huanxi-chan"] / 3) * (skl["longxiang-boruo"] / 15));
      break;
    case "古墓派":
      if (skl["force"] > 21)
        ob->add("max_jing", (skl["force"] / 3) * (skl["yunu-xinjing"] / 10));
      ob->add("max_qi", (skl["force"] / 3) * (skl["yunu-xinjing"] / 15));
      break;
    case "星宿派":
      if (skl["poison"] > 81)
        ob->add("max_qi", (skl["poison"] / 3) * (skl["huagong-dafa"] / 10));
      ob->add("max_jing", (skl["poison"] / 3) * (skl["huagong-dafa"] / 15));
      break;
    case "铁掌帮":
      if (skl["tiezhang-xinfa"] > 81) {
        ob->add("max_qi", (skl["tiezhang-xinfa"] / 3) * (skl["guiyuan-tunafa"] / 10));
        ob->add("max_jing", (skl["tiezhang-xinfa"] / 3) * (skl["guiyuan-tunafa"] / 15));
      }
      break;
    case "逍遥派":
      if (skl["art"] > 81) {
        ob->add("max_qi", (skl["art"] / 3) * (skl["beiming-shengong"] / 10));
        ob->add("max_jing", (skl["art"] / 3) * (skl["beiming-shengong"] / 15));
      }
      break;
    case "丐帮":
      if (skl["force"] > 81) {
        ob->add("max_qi", (skl["force"] / 3) * (skl["huntian-qigong"] / 10) + death * 50);
        ob->add("max_jing", (skl["force"] / 3) * (skl["huntian-qigong"] / 15));
      }
    case "明教":
      if (skl["force"] > 81) {
        ob->add("max_qi", (skl["force"] / 3) * (skl["shenghuo-shengong"] / 10));
        ob->add("max_jing", (skl["force"] / 3) * (skl["shenghuo-shengong"] / 15));
      }
    case "神龙教":
      if (skl["force"] > 101)
        ob->add("max_jing", (skl["force"] / 3) * (skl["dulong-dafa"] / 10));
      ob->add("max_qi", (skl["force"] / 3) * (skl["dulong-dafa"] / 15));
      break;
    case "姑苏慕容":
      if (skl["force"] > 101)
        ob->add("max_jing", (skl["force"] / 3) * (skl["shenyuan-gong"] / 10));
      ob->add("max_qi", (skl["force"] / 3) * (skl["shenyuan-gong"] / 15));
      break;
    case "华山派":
      if (skl["zhengqi-jue"] > 101) {
        ob->add("max_qi", (skl["zhengqi-jue"] / 3) * (skl["zixia-gong"] / 15));
        ob->add("max_jing", (skl["zhengqi-jue"] / 3) * (skl["zixia-gong"] / 15));
      }
      if (skl["ziyin-yin"] > 101) {
        ob->add("max_jing", (skl["ziyin-yin"] / 3) * (skl["zixia-gong"] / 15));
        ob->add("max_qi", (skl["ziyin-yin"] / 3) * (skl["zixia-gong"] / 15));
      }
      break;
  }
}
