// vendor.c

#include <dbase.h>

int do_buy(string what)
{
	string ob_file;
	object ob, me = this_player();
	mapping goods;
	string *name, last = "";
	int i;

	if( !mapp(goods = query("vendor_goods")) ) return notify_fail("这儿的东西全卖光了。\n");
	name = keys(goods);
	for(i=0; i<sizeof(name); i++) {
		if(what ==  name[i]->name() || name[i]->id(what)) {
			if( stringp(ob_file = name[i]) ) {
                ob = new(ob_file);
                switch (MONEY_D->player_pay(me, ob->query("value"))) {
                    case 0: destruct(ob); return notify_fail("穷光蛋，一边呆着去！\n");
                    case 2: destruct(ob); return notify_fail("您的零钱不够了，银票又没人找得开。\n");
                }
                if (ob->move(me)) {
					goods[name[i]]--;
					if(goods[name[i]] <= 0) {
						map_delete(goods,name[i]);
						last = "最后";
					}
					message_vision(sprintf("$N向$n买下%s一%s%s。\n", last, ob->query("unit"), ob->name()),
						me, this_object());
				} else destruct(ob);
				return 1;
			}
		}
	}
	return notify_fail("您想买什么？\n");
}

int do_list(string arg)
{
	mapping goods;
	string list, *name;
	int i;

	if( arg && !this_object()->id(arg) ) return 0;
	notify_fail("这儿的东西全卖光了。\n");
	if( !mapp(goods = query("vendor_goods")) ) return 0;
	name = keys(goods);
	if(!sizeof(name)) return 0;
	list = "你可以购买下列这些东西：\n";
	for(i=0; i<sizeof(name); i++)
		list += sprintf("%-20s：%s\n",
			name[i]->short(),
			MONEY_D->price_str(name[i]->query("value")) );
	write(list);
	return 1;	
}
