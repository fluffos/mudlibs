// /feature/prick.c
#include <ansi.h>       
#include <dbase.h>
#include <weapon.h>
#include <combined.h>
#include <move.h>

//inherit COMBINED_ITEM;
int get_weight();
int get_damage();

int prick(object who)
{
  int damage,total,i;
  mapping weapon_prop;
  object ob=this_object();
  string file=base_name(ob);
  object *inv;

  if(!who->is_character())
        return 0;
  if(!weapon_prop=query("weapon_prop"))
        return notify_fail("只能用兵器刺入敌人体内!\n");
  if(query_temp("prick"))
        return notify_fail("此"+query("name")+"还在"+query_temp("pricked")+"体内!\n");
  set_temp("prick",who);
  who->set_temp("prick",(string)ob->query("name"));

  damage=get_damage();
  who->receive_damage("qi",damage);
  who->receive_wound("qi",damage);
  who->apply_condition("throw_poison", 8);

  if( environment() ) environment()->add_encumbrance( - get_weight());
  move_object(who);
  ob->set("prick",who);
  ob->set("name","插在身上的"+(string) ob->query("name"));
  ob->add_encumbrance(get_weight());

  if(ob->query("base_weight"))
        {
        total=ob->query_amount();
        inv=all_inventory(environment(ob));
        for(i=0;i<sizeof(inv);i++)
                {
                if(inv[i]==ob)
                        continue;
                if(base_name(inv[i])==file && inv[i]->query_temp("prick")==ob->query_temp("prick"))   
                        {
                        total+=inv[i]->query_amount();
                        destruct(inv[i]);
                        }
                }
        ob->set_amount(total);
        }
//write("prick_damage"+(string)damage+"\n");
  return damage;
}


int unprick(object who)
{
int damage,total,i;
object ob=this_object();
string file;
object *inv;

if(environment()!=who)
        return notify_fail(query("name")+"并不在"+who->query("name")+"的体内!\n");
if(!query_temp("pricked"))
        return notify_fail(query("name")+"并不在"+who->query("name")+"的体内!\n");
file=base_name(ob);
delete_temp("prick");
if(ob->query("base_weight"))
        {
        inv=all_inventory(environment(ob));
        total=ob->query_amount();
        for(i=0;i<sizeof(inv);i++)
                {
                if(inv[i]==ob)
                        continue;
                if(base_name(inv[i])==file && inv[i]->query_temp("prick")==ob->query_temp("prick"))   
                        {
                        total+=inv[i]->query_amount();
                        destruct(inv[i]);
                        }
                }
        ob->set_amount(total);
        }

damage=get_damage();

who->receive_damage("qi",damage);
who->receive_wound("qi",damage);
//write("unprick_damage "+(string)damage+"\n");
return damage;

}

int get_weight()
{
int amount,base;
if(query("base_weight"))
        {
        amount=query_amount();
        base=query("base_weight");
        return base*amount;
        }
return query("weight");
}

int get_damage()
{
int base,amount,damage;
if(query("base_weight"))
        {
        base=query("weapon_prop/damage");
        amount=query_amount();
//      write(base+"\n"+amount+"\n");
        damage=amount*base;
        return base*amount;
        }
return  query("weapon_prop/damage");
}
