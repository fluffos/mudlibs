// file.c

void cat(string file) {
  write(read_file(file));
}

void assure_file(string file);

nosave int in_log_file;

void log_file(string file, string text) {
  // FIX (AGENTS.md s7.11): LOG_DIR subdirs (nosave/) are gitignored and
  // missing on a fresh tree. clone/promotion/update audit paths throw
  // "Wrong permissions ... No such file or directory".
  // Reentrancy: securityd valid_write denial also calls log_file("FILES"),
  // so nested log_file() skips assure_file() (see fqyy2 2026-09-03).
  if (in_log_file) {
    write_file(LOG_DIR + file, text);
    return;
  }
  in_log_file = 1;
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
  in_log_file = 0;
}

void assure_file(string file) {
  string path = "", *dir;
  int i, j;

  if (file_size(file) != -1) return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  j = sizeof(dir) - 1;
  for (i = 0; i < j; i++) {
    path += "/" + dir[i];
    mkdir(path);
  }
}

string base_name(object ob) {
  string file, tmp = file_name(ob);

  if (sscanf(tmp, "%s#%*d", file) == 2) return file;
  else return tmp;
}
