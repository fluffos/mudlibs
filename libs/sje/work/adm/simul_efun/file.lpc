// file.c

void cat(string file)
{
	write(read_file(file));
}

void log_file(string file, string text)
{
	write_file(LOG_DIR + file, text);
}

void assure_file(string file)
{
	string path = "", *dir;
	int i, j;

	if( file_size(file)!=-1 ) return;

	seteuid(ROOT_UID);
	dir = explode(file, "/");
	j = sizeof(dir) - 1;
	for(i=0; i<j; i++) {
		path += "/" + dir[i];
		mkdir(path);
	}
}

string base_name(object ob)
{
	string file, tmp = file_name(ob);

	if( sscanf(tmp, "%s#%*d", file)==2 ) return file;
	else return tmp;
}
