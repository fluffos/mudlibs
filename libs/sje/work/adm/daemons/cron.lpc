void check_dns() {
  mapping mud_list;
  mixed *muds;
  object dns;

  if (!dns = find_object(DNS_MASTER))
    // dns not started, not our problem
    return;
  mud_list = (mapping)DNS_MASTER->query_muds();
  muds = keys(mud_list);
  if (sizeof(muds) < 1) {
    destruct(dns);
    call_other(DNS_MASTER, "???");
  }
  return;
}
