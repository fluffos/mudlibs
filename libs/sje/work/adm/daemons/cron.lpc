// TIEYU@FY3
// This is a daemon that calls itself every minte. it checks
// all major daemons to make sure that they are up and running.
// Optimized by Keinxin@sj2 2003.4
#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>


int respd = 1;
int LAST_HARD_DIS = 0;
void init_cron();
void create() {
  seteuid(ROOT_UID);
  init_cron();
}
int query_last_hard_dis() {
  return LAST_HARD_DIS;
}
int set_last_hard_dis() {
  LAST_HARD_DIS = time();
  return time();
}
void init_cron() {
  mixed *local;


  local = localtime(time());

  //调整了算法，respd值控制分布时间，每一个respd值为1分钟。现在设定为600，即10小时

  if (respd > 600) {
    respd = 0;
    message("system",
      HIY "\t\t【书剑贰】将在五分钟后重新分布神书任务！\n\n" NOR,
      users());
    call_out("countdown", 60, 5);
  }

  //Modified by Keinxin

  respd += 1;
  call_out("init_cron", 60);
}

private void countdown(int min) {
