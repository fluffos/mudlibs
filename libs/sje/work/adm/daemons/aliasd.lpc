// aliasd.c

mapping global_alias = ([
        "l":     "look",
        "i":     "inventory",
        "tt":    "team talk",
        "bai":   "apprentice",
        "bei":   "prepare",
        "dazuo":  "exercise",
        "du":    "study",
        "dating":"check",
        "fangqi":"abandon",
        "jiali": "enforce",
        "jifa":  "enable",
        "kaichu":"expell",
        "lian":  "practice",
        "quan":  "persuade",
        "shou":  "recruit",
        "tuna":  "respirate",
        "xue":   "learn",
        "yun":   "exert",
        "zisha": "suicide",
        "tk":    "teamkill",
        "n":     "go north",
        "e":     "go east",
        "w":     "go west",
        "s":     "go south",
        "nu":    "go northup",
        "eu":    "go eastup",
        "wu":    "go westup",
        "su":    "go southup",
        "nd":    "go northdown",
        "ed":    "go eastdown",
        "wd":    "go westdown",
        "sd":    "go southdown",
        "ne":    "go northeast",
        "se":    "go southeast",
        "nw":    "go northwest",
        "sw":    "go southwest",
        "u":     "go up",
        "d":     "go down"
]);

string process_global_alias(string arg)
{
        string *word;
        int i;

        if (arg[0]=='\'') arg = "say " + arg[1..strlen(arg)-1];

        word = explode(arg, " ");
        if( sizeof(word) && !undefinedp(global_alias[word[0]]) ) {
                word[0] = global_alias[word[0]];
                arg = implode(word, " ");
        }
        i = strlen(arg);
        while (i--) if (arg[i] < ' ' && arg[i] != 27 && arg[i] != 10) arg[i] = ' ';

        return arg;
}
