// rankd.c
// optimize by Yu Jue 98.2.27
// Last modified by god for wiz rank
#include <ansi.h>

string query_rank(object ob)
{
        int shen = ob->query("shen");
        int budd;
        int age = ob->query("age");
        int divorce = ob->query("divorce");

        if( ob->is_ghost() )
                return HIB "【孤魂野鬼】" NOR;
                // 巫师可以设定自己的Rank
                if( wizardp(ob) && ob->query("env/rankd") )
                        return ob->query("env/rankd");
                        
        switch (ob->query("family/family_name")) {
                case "逍遥派" : budd = ob->query_skill("beiming-shengong", 1); break;
                case "姑苏慕容" : budd = ob->query_skill("shenyuan-gong",1);break;
                case "华山派" : budd = ob->query_skill("zhengqi-jue",1);break;
                case "嵩山派" :
                case "泰山派" :
                case "昆仑派" :
                case "古墓派" : budd = ob->query_skill("sword",1);break;
                case "峨嵋派": budd = ob->query_skill("dacheng-fofa", 1); break;
                case "少林派":
                case "天龙寺": budd = ob->query_skill("buddhism", 1); break;
                case "武当派": budd = ob->query_skill("taoism", 1); break;
                case "大轮寺": budd = ob->query_skill("huanxi-chan", 1); break;
                case "明教" : budd = ob->query_skill("shenghuo-shengong", 1); break;
                case "丐帮" : budd = ob->query_skill("begging", 1); break;
                case "桃花岛" : budd = ob->query_skill("bihai-chaosheng", 1); break;
                case "铁掌帮" : budd = ob->query_skill("guiyuan-tunafa", 1); break;
                case "神龙教" : 
                case "星宿派" : budd = ob->query_skill("poison", 1); break;
                case "厨师"   : budd = ob->query_skill("cooking", 1); break;
                case "医生"   : budd = ob->query_skill("medicine", 1); break;
                case "裁缝"   : budd = ob->query_skill("sewing", 1); break;
        }       
        if (ob->query("gender") == "无性") {
                budd = ob->query_skill("pixie-jian",1);
                if (budd > 200) return HIR "【 九千岁 】" NOR;
                if (budd > 150) return HIR "【 厂  公 】" NOR;
                if (budd > 100) return HIR "【东厂千户】" NOR;
                if (budd > 50) return HIR "【东厂公公】" NOR;
                return HIR "【 太  监 】" NOR;
        }

        switch(ob->query("gender")) {
                case "女性":
                case "雌性":
                        switch(wizhood(ob)) {
                                case "(admin)": return HIW "【 天  仙 】" NOR;
                                case "(assist)": return HIR "【 女神官 】" NOR;
                                case "(arch)": return HIY "【 龙  女 】" NOR;
                                case "(wizard)": return HIG "【 仙  子 】" NOR;
                                case "(apprentice)": return HIC "【 飞  天 】" NOR;
                                case "(immortal)": return CYN "【 女门客 】" NOR;
                                default:
                                        if( ob->query("PKS") > 20 && ob->query("PKS") > ob->query("MKS") / 4 )
                                                return HIR "【杀人女魔】" NOR;
                                        if( (int)ob->query("thief") > 10 ) 
                                                return "【 女惯窃 】";
                                      if (!ob->query("family/family_name")) {
                                                if (shen >= 1500000) return HIC "【巾帼神女】" NOR;
                                                if (shen >= 1000000) return HIC "【绝世天娇】" NOR;
                                                if (shen >= 500000) return HIC "【旷世女侠】" NOR;
                                                if (shen >= 50000) return HIC "【 女飞侠 】" NOR;
                                                if (shen >= 5000) return HIC "【 女  侠 】" NOR;
                                                if (shen >= 500) return HIC "【 小侠女 】" NOR;
                                                if (shen <= -1500000) return HIB "【 妖  姬 】" NOR;
                                                if (shen <= -1000000) return HIB "【灭世罗刹】" NOR;
                                                if (shen <= -500000) return HIB "【旷世女魔】" NOR;
                                                if (shen <= -50000) return HIB "【 女魔王 】" NOR;
                                                if (shen <= -5000) return HIB "【 女魔头 】" NOR;
                                                if (shen <= -500) return HIB "【 小魔女 】" NOR;
                                        }
                                        switch(ob->query("family/family_name")) {
                                                case "神龙教" :
                                                case "逍遥派" :
                                                        if (budd >= 200) return HIW"【人间仙女】"NOR;
                                                        if (budd >= 160) return HIC"【绝世美女】"NOR;
                                                        if (budd >= 120) return CYN"【 美  人 】"NOR;
                                                        if (budd >= 80)  return CYN"【 女隐圣 】"NOR;
                                                        if (budd >= 50)  return HIM"【 女隐士 】"NOR;
                                                        return "【 少  女 】";
                                                case "星宿派" :
                                                        if (budd >= 200) return HIB"【 妖  姬 】"NOR;
                                                        if (budd >= 160) return HIB"【灭世罗刹】"NOR;
                                                        if (budd >= 120) return CYN"【旷世女魔】"NOR;
                                                        if (budd >= 80) return CYN"【 女魔王 】"NOR;
                                                        if (budd >= 50) return WHT"【 女魔头 】"NOR;
                                                        if (shen <= -500) return WHT"【 小魔女 】"NOR;
                                                        return "【 少  女 】";
                                                case "峨嵋派" :
                                                        if (budd >= 200) return HIW"【 狂  尼 】"NOR;
                                                        if (budd >= 150) return HIW"【 圣  尼 】"NOR;
                                                        if (budd >= 100) return HIW"【 长  老 】"NOR;
                                                        if (budd >= 50) return HIW"【 师  太 】"NOR;
                                                        return "【 比丘尼 】";
                                                case "大轮寺" :
                                                        if (budd >=  200) return HIG"【 欢喜佛 】"NOR;
                                                        if (budd >= 160) return HIG"【 圣  女 】"NOR;
                                                        if (budd >= 120) return HIG"【 飞  天 】"NOR;
                                                        if (budd >= 80) return HIG"【 乾达婆 】"NOR;
                                                        if (budd >= 50) return HIG"【 神妙女 】"NOR;
                                                        return HIC"【 授  事 】"NOR;
                                                case "姑苏慕容" :
                                                        if (budd >=  250) return HIC"【 小  姐 】"NOR;
                                                        if (budd >= 180) return HIC"【 大侍书 】"NOR;
                                                        if (budd >= 120) return HIC"【 侍  书 】"NOR;
                                                        if (budd >= 70) return HIC"【 大丫鬟 】"NOR;
                                                        return HIC"【 丫  鬟 】"NOR;

                                                case "武当派":          
                                                        if (budd >= 200) return HIY "【 玄  女 】" NOR;
                                                        if (budd >= 160) return HIY "【 仙  姑 】" NOR;
                                                        if (budd >= 120) return HIY "【 玄  女 】" NOR;
                                                        if (budd >= 80) return HIY "【 散  人 】" NOR;
                                                        if (budd >= 50 || age >= 20) return HIY "【 道  姑 】" NOR;
                                                        return "【 女道童 】";
                                                case "华山派" :
                                                        if (ob->query("family/master_name") == "风清扬") {
                                                                if (ob->query_skill("sword",1) >= 300)
                                                                        return HIW "【一代剑圣】" NOR;
                                                                if (ob->query_skill("sword",1) >= 250)
                                                                        return HIY "【一代剑神】" NOR;
                                                                return HIW "【 剑  宗 】" NOR;
                                                        }
//                                                        if (shen <0) return CYN "【 伪君子 】" NOR;
                                                        if (budd >= 200) return HIM "【巾帼神女】" NOR;
                                                        if (budd >= 160) return HIM "【绝世天娇】" NOR;
                                                        if (budd >= 120) return HIC "【旷世女侠】" NOR;
                                                        if (budd >= 80) return HIC "【 女飞侠 】" NOR;
                                                        if (budd >= 50 || age >=20) return HIC "【 女  侠 】" NOR;
                                                        return HIC "【 小侠女 】" NOR;
                                                 case "古墓派" :
                                                case "嵩山派" :
                                                case "昆仑派" :
                                                case "泰山派" :
                                                        if (budd >= 250) return HIY "【 剑  圣 】" NOR;
                                                        if (budd >= 200) return HIW "【 剑  宗 】" NOR;
                                                        if (budd >= 150) return HIY "【 剑  仙 】" NOR;
                                                        if (budd >= 100) return HIC "【 女剑侠 】" NOR;
                                                        if (budd >= 50) return HIC "【 女剑客 】" NOR;
                                                        return "【 女剑手 】";
                                                case "明教" :
                                                        if (budd >= 250) return HIR "【 副教主 】" NOR;
                                                        if (budd >= 200) return WHT "【宝树神姬】" NOR;
                                                        if (budd >= 150) return HIB "【护教女使】" NOR;
                                                        if (budd >= 100) return HIC "【 女香主 】" NOR;
                                                        if (budd >= 50) return CYN "【 女教众 】" NOR;
                                                        return CYN"【 侍  女 】"NOR;
                                                case "丐帮" :
                                                        if (budd >= 200) return HIM"【 副帮主 】"NOR;
                                                        if (budd >= 180) return HIM"【总舵龙头】"NOR;
                                                        if (budd >= 120) return HIM"【分舵龙头】"NOR;
                                                        if (budd >= 70) return HIM"【分舵香主】"NOR;
                                                        return HIM"【 叫花婆 】"NOR;
                                                case "桃花岛" :
                                                        if (budd >= 250) return HIW"【 隐  圣 】"NOR;
                                                        if (budd >= 180) return HIM"【 逸  仙 】"NOR;
                                                        if (budd >= 120) return HIM"【 逸  贤 】"NOR;
                                                        if (budd >= 70) return CYN"【 青  衣 】"NOR;
                                                 case "铁掌帮" :
                                                        if (budd >= 250) return WHT"【 山大王 】"NOR;
                                                        if (budd >= 180) return CYN"【 女寨主 】"NOR;
                                                        if (budd >= 120) return CYN"【 女当家 】"NOR;
                                                        if (budd >= 70) return CYN"【 女头目 】"NOR;
                                                        return "【 女喽罗 】";
                                                case "厨师" :
                                                        if (budd >= 200) return HIW"【 食  姬 】"NOR;
                                                        if (budd >= 160) return HIR"【特级厨师】"NOR;
                                                        if (budd >= 120) return HIC"【 女厨师 】"NOR;
                                                        if (budd >=  80) return HIC"【 女帮厨 】"NOR;
                                                        if (budd >=  50) return CYN"【 女学徒 】"NOR;
                                                        return CYN"【 打工妹 】"NOR;
                                                default:
                                                        if (ob->query("marry")) {
                                                        if (age < 30) return "【 少  妇 】";
                                                        if (age < 50) return "【中年妇人】";
                                                        return "【 老妇人 】";
                                        }
                                        if (divorce > 2) {
                                        if (age < 50) return "【 荡  妇 】";
                                        return "【 老荡妇 】";
                                }
                                if (divorce) {
                                        if (age < 50) return "【 寡  妇 】";
                                        return "【 老寡妇 】";
                                }
                                if (age < 18) return "【 少  女 】";
                                if (age < 30) return "【青年女子】";
                                if (age < 50) return "【中年女子】";
                                return "【 老处女 】";
                        }
                }
                default:
                        switch(wizhood(ob)) {
                                case "(admin)": return HIW "【 天  神 】" NOR;
                                case "(assist)": return HIR "【 神  官 】" NOR;
                                case "(arch)": return HIY "【 龙  神 】" NOR;
                                case "(wizard)": return HIG "【 仙  人 】" NOR;
                                case "(apprentice)": return HIC "【 巫  师 】" NOR;
                                case "(immortal)": return CYN "【 门  客 】" NOR;
                                default:
                                        if( ((int)ob->query("PKS") > 20) && ((int)ob->query("PKS") > (int)ob->query("MKS")) / 4 )
                                                return HIR "【杀人魔王】" NOR;
                                        if( (int)ob->query("thief") > 10 ) 
                                                return "【 惯  窃 】";
                                        if (!ob->query("family/family_name")) {
                                                if (shen >= 1500000) return HIC "【武林神话】" NOR;
                                                if (shen >= 1000000) return HIC "【绝世神侠】" NOR;
                                                if (shen >= 500000) return HIC "【旷世大侠】" NOR;
                                                if (shen >= 50000) return HIC "【 大  侠 】" NOR;
                                                if (shen >= 5000) return HIC "【 侠  客 】" NOR;
                                                if (shen >= 500) return HIC "【 少  侠 】" NOR;
                                                if (shen <= -1500000) return HIB "【灭世魔尊】" NOR;
                                                if (shen <= -1000000) return HIB "【盖世狂魔】" NOR;
                                                if (shen <= -500000) return HIB "【 魔  尊 】" NOR;
                                                if (shen <= -50000) return HIB "【 魔  王 】" NOR;
                                                if (shen <= -5000) return HIB "【 魔  头 】" NOR;
                                                if (shen <= -500) return HIB "【 少  魔 】" NOR;
                                        }
                                        switch(ob->query("family/family_name")) {
                                                case "星宿派" :
                                                case "神龙教" :
                                                        if (budd >= 200) return HIB"【灭世魔尊】"NOR;
                                                        if (budd >= 160) return HIB"【盖世狂魔】"NOR;
                                                        if (budd >= 120) return CYN"【 魔  尊 】"NOR;
                                                        if (budd >= 80) return CYN"【 魔  王 】"NOR;
                                                        if (budd >= 50) return WHT"【 魔  头 】"NOR;
                                                        if (shen <= -500) return WHT"【 少  魔 】"NOR;
                                                        return "【 少  年 】";
                                                case "少林派" :
                                                case "天龙寺" :
                                                        if (ob->query("luohan_winner")) {
                                                                if (ob->query("shen") > 0) {
                                                                        if (budd >= 180) return HIY "【 神  僧 】" NOR;
                                                                        if (budd >= 150) return HIY "【 长  老 】" NOR;
                                                                        if (budd >= 120) return HIY "【 圣  僧 】" NOR;
                                                                        if (budd >= 80) return HIY "【 罗  汉 】" NOR;
                                                                }
                                                                else {
                                                                        if (budd >= 180) return HIR "【 魔  僧 】" NOR;
                                                                        if (budd >= 150) return HIR "【 妖  僧 】" NOR;
                                                                        if (budd >= 120) return HIR "【 淫  僧 】" NOR;
                                                                        if (budd >= 80) return HIR "【 罗  汉 】" NOR;
                                                                }
                                                        }
                                                        if (budd >= 60) return HIY "【 尊  者 】" NOR;
                                                        if (budd >= 40) return HIY "【 僧  侣 】" NOR;
                                                        if (budd >= 30) return HIY "【 比  丘 】" NOR;
                                                        return "【 行  者 】";
                                                case "逍遥派" :
                                                        if (budd >= 200) return HIW"【超凡圣人】"NOR;
                                                        if (budd >= 160) return HIC"【绝世隐圣】"NOR;
                                                        if (budd >= 120) return HIG"【 圣  人 】"NOR;
                                                        if (budd >= 80)  return HIG"【 隐  圣 】"NOR;
                                                        if (budd >= 50)  return CYN"【 隐  士 】"NOR;
                                                        return "【 少  年 】";
                                                
                                                case "武当派":          
                                                        if (budd >= 200) return HIW "【 天  尊 】" NOR;
                                                        if (budd >= 160) return HIW "【 天  师 】" NOR;
                                                        if (budd >= 120) return HIW "【 真  人 】" NOR;
                                                        if (budd >= 80) return HIW "【 道  长 】" NOR;
                                                        if (budd >= 50 || age >= 20) return HIW "【 道  士 】" NOR;
                                                        return "【 道  童 】";
                                                case "姑苏慕容" :
                                                        if ( budd >= 250 ) {
                                                                if ( age >= 60 ) return HIC "【 老  爷 】" NOR;
                                                                return HIC "【 少  爷 】" NOR;
                                                        }
                                                        if (budd >= 180) return HIC"【 庄  主 】"NOR;
                                                        if (budd >= 120) return HIC"【 管  家 】"NOR;
                                                        if (budd >= 70) return HIC"【 护  院 】"NOR;
                                                        return HIC"【 庄  丁 】"NOR;
                                                case "华山派" :

                                                        if (ob->query("family/master_name") == "风清扬") {
                                                                if (ob->query_skill("sword",1) >= 300)
                                                                        return HIW "【一代剑圣】" NOR;
                                                                if (ob->query_skill("sword",1) >= 250)
                                                                        return HIY "【一代剑神】" NOR;
                                                                return HIW "【 剑  宗 】" NOR;
                                                        }
                                                        if (shen <0) return WHT "【 伪君子 】" NOR;
                                                        if (budd >= 200) return CYN "【武林神话】" NOR;
                                                        if (budd >= 160) return CYN "【绝世神侠】" NOR;
                                                        if (budd >= 120) return CYN "【旷世大侠】" NOR;
                                                        if (budd >= 80) return CYN "【 大  侠 】" NOR;
                                                        if (budd >= 50 || age >=20) return CYN "【 侠  客 】" NOR;
                                                        return "【 少  侠 】";
                                                case "古墓派" :
                                                case "嵩山派" :
                                                case "昆仑派" :
                                                case "泰山派" :
                                                        if (budd >= 200) return HIW "【 剑  宗 】" NOR;
                                                        if (budd >= 150) return HIY "【 剑  狂 】" NOR;
                                                        if (budd >= 100) return HIC "【 剑  侠 】" NOR;
                                                        if (budd >= 50) return HIC "【 剑  客 】" NOR;
                                                        return "【 剑  手 】";
                                                case "明教" :
                                                        if (budd >= 250) return HIR "【 副教主 】" NOR;
                                                        if (budd >= 200) return WHT "【光明使者】" NOR;
                                                        if (budd >= 150) return HIB "【五旗护法】" NOR;
                                                        if (budd >= 100) return HIC "【 香  主 】" NOR;
                                                        if (budd >= 50) return CYN "【 教  众 】" NOR;
                                                        return CYN"【 杂  役 】"NOR;
                                                case "丐帮" :
                                                        if (budd >= 200) return HIM"【 副帮主 】"NOR;
                                                        if (budd >= 180) return HIM"【总舵龙头】"NOR;
                                                        if (budd >= 120) return HIM"【分舵龙头】"NOR;
                                                        if (budd >= 70) return HIM"【分舵香主】"NOR;
                                                        return HIM"【 叫花子 】"NOR;
                                                case "桃花岛" :
                                                        if (budd >= 250) return HIW"【 隐  圣 】"NOR;
                                                        if (budd >= 180) return HIM"【 隐  士 】"NOR;
                                                        if (budd >= 120) return HIM"【 逸  士 】"NOR;
                                                        if (budd >= 70) return HIM"【 门  生 】"NOR;
//                                                      return "【 平 民 】";
                                                case "铁掌帮" :
                                                        if (budd >= 250) return WHT"【 山大王 】"NOR;
                                                        if (budd >= 180) return CYN"【 寨  主 】"NOR;
                                                        if (budd >= 120) return CYN"【 当  家 】"NOR;
                                                        if (budd >= 70) return CYN"【 头  目 】"NOR;
                                                        return "【 小喽罗 】";
                                                case "大轮寺" :
                                                        if (budd >=  200) return HIG"【欢喜魔王】"NOR;
                                                        if (budd >= 160) return HIG"【 大护法 】"NOR;
                                                        if (budd >= 120) return HIG"【 天  王 】"NOR;
                                                        if (budd >= 80) return HIG"【 金  刚 】"NOR;
                                                        if (budd >= 50) return HIG"【 力  士 】"NOR;
                                                        return HIC"【 杂  役 】"NOR;
                                                case "厨师" :
                                                        if (budd >= 200) return HIW"【 食  神 】"NOR;
                                                        if (budd >= 160) return HIR"【特级厨师】"NOR;
                                                        if (budd >= 120) return HIC"【 厨  师 】"NOR;
                                                        if (budd >=  80) return HIC"【 帮  厨 】"NOR;
                                                        if (budd >=  50) return CYN"【 学  徒 】"NOR;
                                                        return CYN"【 打  杂 】"NOR;
                                                default:
                                                        if (ob->query("marry")) {
                                                                if (age < 30) return "【青年男子】";
                                                                if (age < 50) return "【中年男子】";
                                                                return "【 老头儿 】";
                                                        }
                                                        if (divorce > 2) {
                                                                if (age < 50) return "【花花公子】";
                                                                return "【 老色鬼 】";
                                                        }
                                                        if (divorce) {
                                                                if (age < 50) return "【 鳏  夫 】";
                                                                return "【 老鳏夫 】";
                                                        }
                                                        if (age < 18) return "【 少  年 】";
                                                        if (age < 30) return "【青年男子】";
                                                        if (age < 50) return "【中年男子】";
                                                        return "【 老处男 】";
                                        }
                        }
        }
}
string query_respect(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/respect")) )
                return str;
        if(ob->query("race") != "人类") return ob->name();

        age = ob->query("age");
        if (ob->query_skill("beauty") > 30) age -= (ob->query_skill("beauty")-30)/5;
        switch(ob->query("gender")) {
        case "女性":
        case "雌性":
                switch(ob->query("class")) {
                case "bonze": 
                        if( age < 20 ) return "小师太";
                        return "师太";
                case "taoist":
                        if( age < 20 ) return "小仙姑";
                        return "仙姑";
                default:
                        if( age < 20 ) return "小姑娘";
                        if( age < 50 ) return "姑娘";
                        return "婆婆";
                        }
        default:
                switch(ob->query("class")) {
                case "bonze":
                        if( age < 20 ) return "小师父";
                        return "大师";
                case "lama":
                        if( age < 50 ) return "大师父";
                        return "上人";
                case "taoist":
                        if( age < 20 ) return "道兄";
                        return "道长";
                case "fighter":
                case "swordsman":
                        if( age < 20 ) return "小老弟";
                        if( age < 50 ) return "壮士";
                        return "老前辈";
                case "eunuch": return "公公";
                default:
                        if( age < 20 ) return "小兄弟";
                        if( age < 50 ) return "壮士";
                        return "老爷子";
                }
        }
}
string query_rude(object ob)
{
        int age;
