        if( stringp(str = ob->query("rank_info/rude")) ) return str;
        if(ob->query("race") != "人类") return "禽兽";

        age = ob->query("age");
        if (ob->query_skill("beauty") > 30) age -= (ob->query_skill("beauty")-30)/5;
