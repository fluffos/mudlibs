// taskd.C for tasks.
// 15.03.99 by snowman@SJ

/*
用法: get_quest(this_player(), shen type(int), job type(string), family name(string))
shen type is either 1 for +shen npcs or -1 for -shen npcs,
传回是 mapping：
        ["id"] = target 的 ID, 
        ["name"] = taget 的名字, 
        ["last_id"] = 上个target的id，以免重复,
        ["time"] = 最后时间限制,
        ["exp_reward"] = EXP 奖励,
        ["pot_reward"] = POT 奖励,
        ["type"] = 种类，比如 "杀", "请", "找"...,
        ["family"] = 门派名，如果不给family，将等于player自己的门派名,
        ["place"] = 地点，target目前的所在地.

 PS: get_time(quest["time"]) 将传回中文的时间限制.
*/

#include <ansi.h>

#define STUFFS          "/adm/etc/task_stuffs"
#define BACKUP_STUFFS          "/adm/etc/task_stuff"
#define TIME_TICK (time()*60)

int check(object ob, int myexp, string id, int shen, string fam, string place);
int quest_reward(int exp, int texp);
string get_place(string str);

mapping *stuffs;
mapping *read_table(string file);

void create() {
  if (file_size(STUFFS) > 0)
    stuffs = NATURE_D->read_table(STUFFS);
  else stuffs = NATURE_D->read_table(BACKUP_STUFFS);
}

mapping *quest_stuffs() {
  return stuffs;
}

int set_status(int arg, object ob) {
  string str;
  int i, j;

  if (geteuid(previous_object()) != ROOT_UID) return 0;

  j = sizeof(stuffs);

  for (i = 0; i < j; i++) {
    if (stuffs[i]["id"] == ob->query("id") && stuffs[i]["name"] == ob->name()) {
      // Delete this object from list.
      if (arg <= 0) {
        // write("id = "+stuffs[i]["id"]+", name = "+stuffs[i]["name"]+", i = "+i+"\n");
        stuffs[i] = 0;
        break;
      }
      // same obj.
      else return 0;
    }
  }

  str = "name:id:reward\n%s:%s:%d\n\n";
  // Add this object to list.
  str += ob->name() + "\n" + ob->query("id") + "\n" + arg + "\n";

  // Prepare the list to write.
  for (i = 0; i < j; i++) {
    if (stuffs[i] == 0) continue;
    str += stuffs[i]["name"] + "\n" + stuffs[i]["id"] + "\n" + stuffs[i]["reward"] + "\n";
  }

  // Write the new list.
  rm(STUFFS);
  write_file(STUFFS, str);
  create();
  return 1;
}


mapping get_quest(object me, int shen, string type, string family, string gender) {
  object target, *living;
  string gen, place;
  int i, j, exp;

  living = livings();
  exp = (int)me->query("combat_exp");

  if (!family || !stringp(family))
    family = me->query("family/family_name");

  if (!shen || !intp(shen))
    shen = 0;

  shen = SGN(shen);

  if (!type || !stringp(type))
    type = "杀";

  if (type == "找") {
    i = random(sizeof(stuffs));
    j = stuffs[i]["reward"];
    return ([
      "id": stuffs[i]["id"],
      "name": stuffs[i]["name"],
      "time": TIME_TICK + (j * 50 * 60),
      "exp_reward": j,
      "pot_reward": j / 4 + random(j / 4),
      "type": type,
      "family": family,
    ]);
  }

  if (type == "送") {
    exp = 0;
    place = explode(file_name(environment(living[j])), "/")[1];
  }

  if (gender && (gender == "女" || gender == "男" || gender == "无性"))
    gen = gender;

  for (i = 0; i < sizeof(living); i++) {       // check for the 1st time, random.
    j = random(sizeof(living));
    if (j <= 1 || j == sizeof(living) - 1) continue;
    if (type == "请" && living[j]->query("attitude") == "aggressive") continue;
    if (gen && living[j]->query("gender") != gen) continue;      // get gender
    if (check(living[j], exp, me->query_temp("quest/last_id"), shen, family, place)) {
      target = living[j];
      break;
    }
  }

  if (!objectp(target) || !stringp(target->query("id")))   // random failed, get target by orders.
    for (i = 0; i < sizeof(living); i++) {
      if (type == "请" && living[j]->query("attitude") == "aggressive") continue;
      if (gen && living[j]->query("gender") != gen) continue;
      if (check(living[j], exp, me->query_temp("quest/last_id"), shen, family, place)) {
        target = living[j];
        break;
      }
    }

  if (!objectp(target) || !stringp(target->query("id")))
    return 0;       // no target at all or cant get target's id.

    if (exp > 0)
      i = quest_reward(exp, target->query("combat_exp"));     // get the rewards.
      else i = 10 * (1 + random(30));

  if (type == "请") i += i / 2;

  return ([
    "id": (string)target->query("id"),
    "name": (string)target->name(1),
    "time": TIME_TICK + (i * 30 * 60),
    "exp_reward": i,
    "pot_reward": i / 4 + random(i / 4),
    "type": type,
    "family": family,
    "place": get_place(base_name(environment(target))) + environment(target)->query("short"),
  ]);
}

int check(object ob, int myexp, string id, int shen, string fam, string place) {
  object room;

  reset_eval_cost();              // add by Yuj@SJ 19990727
  if (!objectp(ob)
    || userp(ob)
    || !ob->query("startroom")      // add by Yuj@SJ to void job NPC
    || ob->query("env/invisibility")
    || ob->query("no_quest")        // special npcs, like zhong shentong, attacker, biaoshi etc.
    || ob->query("id") == id
    || ob->query("race") != "人类"
    || ob->query("family/family_name") == fam
    || ob->query("have_master")
    || !objectp(room = environment(ob))
    || room->query("no_fight"))
    return 0;

  if (intp(myexp) && myexp != 0 && (ob->query("combat_exp") > myexp * 2
    || ob->query("combat_exp") <= myexp))
    return 0;

  if (intp(shen) && ((ob->query("shen") > 0 && shen > 0)
    || (ob->query("shen") < 0 && shen < 0)))
    return 0;

  if (strsrch(file_name(room), "/d/") < 0)
    return 0;

  switch (explode(file_name(room), "/")[1]) {
    case "wuguan":
    case "death":
    case "wizard":
    case "tiezhang":
    case "kunlun":
      return 0;
    case "dali": if ((string)place) return 0;
  }

  if (ob->query("id") == "mu ren" || ob->query("id") == "yin ren"
    || ob->query("id") == "jin ren")
    return 0;
  else return 1;
}

int quest_reward(int exp, int texp)     // need a better form here.
{
  int i = 5;

  if (exp >= texp) return 0;      // my exp > target's

  i *= 105 - (exp * 100 / texp);

  return i;
}

int is_target(object corpse, object me) {
  mapping quest;

  if (!mapp(quest = me->query_temp("quest"))) return 0;  // didnt get the job

  if (quest["time"] < TIME_TICK) return -3;  // time up.

  if (quest["type"] != "杀") return -4;  // job type is not killing

  if (corpse->query("id") != "corpse") return 0;  // it's not a corpse.

  if (corpse->query("victim_id") != quest["id"]
    || corpse->query("victim_name") != quest["name"]
    || corpse->query("kill_by") != me)
    return -2;      // killed wrong person.

    if (corpse->query("victim_user")) return -4;   // killed a player.
    else return 1;
}

string get_time(int i) {
  return CHINESE_D->chinese_date(i);
}

string get_place(string str) {

  string *place = explode(str, "/");

  str = " ";
  if (place[0] == "d")
    switch (place[1]) {
      case "baituo": str = "西域白陀山"; break;
      case "hj": str = "西域回疆"; break;
      case "mingjiao": str = "西域明教"; break;
      case "shaolin": str = "河南嵩山少林"; break;
      case "songshan": str = "河南嵩山"; break;
      case "wudang": str = "湖北武当山"; break;
      case "xingxiu": str = "西域星宿海"; break;
      case "city": str = "江南扬州城"; break;
      case "emei": str = "四川峨嵋山"; break;
      case "fuzhou": str = "南疆福州"; break;
      case "jiaxing": str = "江南嘉兴"; break;
      case "taishan": str = "山东泰山"; break;
      case "dali": str = "西南大理国"; break;
      case "tls": str = "大理天龙寺"; break;
      case "tiezhang": str = "湖南铁掌山"; break;
      case "kunlun": str = "昆仑山脉"; break;
      case "fairyland": str = "昆仑山脉"; break;
      case "xiaoyao": str = "逍遥派"; break;
      case "gumu": str = "终南山古墓"; break;
      case "chengdu": str = "四川成都"; break;
      case "huashan": str = "陕西华山"; break;
      case "xiangyang": str = "湖北襄阳"; break;
      case "xueshan": str = "西番大雪山"; break;
      case "wizard": str = "极乐世界"; break;
      case "death": str = "第十八层地狱"; break;
      case "gaibang": str = "丐帮分舵"; break;
      case "hz": str = "江南杭州"; break;
      case "village": str = "陕西小村"; break;
      case "wuguang": str = "襄阳武馆"; break;
      case "thd": str = "东海桃花岛"; break;
      case "gaibang": str = "丐帮分舵"; break;
    }
  return str;
}

void give_reward(object me, mapping quest, int shen, int extra) {
  int exp, pot;
  if (!me || !mapp(quest)) return;

  exp = quest["exp_reward"];
  pot = quest["pot_reward"];

  if (extra) {
    exp += extra;
    pot += extra;
  }

  me->add("combat_exp", exp);
  me->add("potential", pot);

  if (me->query("potential") > me->query("max_pot"))
    me->set("potential", me->query("max_pot"));
  tell_object(
    me,
    HIY "你觉得脑中豁然开朗，增加了" + chinese_number(pot) + "点潜能和" + chinese_number(exp) + "点经验！\n" NOR
  );

  if (shen)
    me->add("shen", shen * quest["exp_reward"] * 10);
  me->delete_temp("quest");
  me->clear_condition("job_busy");
  me->set_temp("quest/last_id", quest["id"]);

}
