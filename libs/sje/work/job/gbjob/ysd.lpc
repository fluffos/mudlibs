#include <ansi.h>
inherit NPC;
#include "/job/gbjob/zzzjob.lpc";
#include "/job/gbjob/teamjob.lpc";
string ask_newjob();
string ask_newover();
int job_over(string arg);
void create()
{
	set_name("肥狼", ({"fei lang", "fei", "lang"}));
        set("title", HIM"『丐帮』"HIR"副帮主"NOR);
	set("gender", "男性");
	set("age", 38);
	set("long", @LONG
　　一个中古的战神，凶猛的不只有他的肌肉，还有他时刻不离手的棒子，好
象传奇中的达拉斯牛神一样勇猛不可抵挡。亘古的丐帮给予了他旺盛的战斗力，
LONG);
	set("attitude", "peaceful");
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("inquiry", ([
                "job"   : (: ask_job :),
                "功劳"  : (: ask_gonglao :),
                "fangqi": (: ask_fangqi :),
                "放弃"  : (: ask_fangqi :),
                "奸细"  : (: ask_jianxi :),
	]));
	set("qi", 4500);
	set("max_qi", 4500);
	set("jing", 2000);
	set("max_jing", 2000);
	set("eff_jingli", 3500);
	set("jingli", 3500);
	set("jiali", 100);
	set("combat_exp", 3000000);
	set("no_quest_npc", 1);
	set("score", 200000);
	create_family("丐帮", 16, "副帮主");
         
	set_skill("force", 300);
	set_skill("huntian-qigong", 300);
	set_skill("strike", 300);
	set_skill("xianglong-zhang", 300);
	set_skill("dodge", 300);
	set_skill("xiaoyaoyou", 300);
	set_skill("parry", 300);
	set_skill("stick", 300);
	set_skill("dagou-bang", 300);
	set_skill("begging", 300);
	set_skill("checking", 300);
	set_skill("bangjue", 300);
	map_skill("force", "huntian-qigong");
	map_skill("strike", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("parry", "dagou-bang");
	map_skill("stick", "dagou-bang");
	prepare_skill("strike", "xianglong-zhang");
        
	set("chat_chance_combat", 20);
	set("chat_msg_combat", ({
		(: perform_action, "strike.xianglong" :),
		(: perform_action, "stick.chan" :)
	}));
        setup();
	carry_object(BINGQI_D("zhubang"))->wield();
}

void unconcious()
{
        command("chat* 对着"+this_player()->query("name")+"冷笑了一声：杀我？也不打听打听大爷我的字号！"NOR);
        say( "肥狼打开木头给他的贴身紧囊，取出一丸药服下去。\n");
        say( "片刻之间，肥狼就恢复了精神，“嘿嘿嘿”冷笑了几声。\n");
        reincarnate();
        set("eff_qi", query("max_qi"));
        set("qi", query("max_qi"));
        set("eff_jing", query("max_jing"));
        set("jingli", query("eff_jingli"));
}

void die()
{
        unconcious();
}
