//高级黑衣人
//by jammy for baohu job 5.18/2002
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("黑衣人", ({ "heiyi ren","ren"}));
        set("gender", "男性");
        set("age", random(20) + 25);
        set("str", 23);
        set("con", 26);
        set("int", 20);
        set("dex", 23);
        set("long", "一个穿着黑色夜行衣的人。\n");
        set("no_quest", 1);

        set("str", 23+random(10));
        set("con", 20+random(10));
        set("int", 20+random(10));
        set("dex", 23+random(10));

        set("combat_exp", 80000 + random(40000));
        set("attitude", "friendly");

        set_skill("force", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);

        set("max_qi", 450);
        set("eff_jingli", 400);
        set("neili", 700);
        set("max_neili", 700);
        set("jiali", 30);

        setup();
        add_money("gold", random(2));
}

void init()
{

        ::init();
        call_out("dest", 400);
}

void die()
{
        object corpse;
        mixed killer;
        if( !living(this_object()) ) revive(1);
        else delete_temp("faint_by");
        COMBAT_D->announce(this_object(), "dead");
        if( !(killer = query_temp("last_damage_from")) )
        killer = "莫名其妙地";
        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
        corpse->move(environment());
        set_temp("last_damage_from", "莫名其妙地");
        corpse->set_temp("must_killby",this_object()->query_temp("must_killby"));
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        destruct(this_object());
}


void dest()
{
       object ob;
       ob = this_object();
       tell_room(environment(ob),ob->name()+"急匆匆的离开了。\n");
       destruct(ob);
}
#include "make.h"
