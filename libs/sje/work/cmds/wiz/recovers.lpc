// Modified by Numa 19990926
// Modified by Numa 19991120 修复了玩家如果在线时恢复不成功的bug

#include <ansi.h>

inherit F_CLEAN_UP;

int update_player(object me, string arg);

int main(object me, string arg) {
  object ob;
  string nod;
  int *file_info;

  if (!arg)
    return notify_fail("指令格式: recovers (玩家ID) [-f]。\n");
  if (sscanf(arg, "%s %s", arg, nod) != 2) {
    if (file_size("/data/login/" + arg[0..0] + "/" + arg + ".o") < 0) {
      if (file_size("/data/login/" + arg[0..0] + "/" + arg + ".ooo") < 0)
        return notify_fail(HIR "【警告】 此玩家登陆备份档案已删除，无法恢复。\n" NOR);
      else cp(
        "/data/login/" + arg[0..0] + "/" + arg + ".ooo",
        "/data/login/" + arg[0..0] + "/" + arg + ".o"
      );
    }

    if (file_size("/data/user/" + arg[0..0] + "/" + arg + ".ooo") < 0)
      return notify_fail("他的档案好象没有备份呦！\n");

    if (file_size("/data/user/" + arg[0..0] + "/" + arg + ".o") < 0) {
      file_info = stat("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
      cp(
        "/data/user/" + arg[0..0] + "/" + arg + ".ooo",
        "/data/user/" + arg[0..0] + "/" + arg + ".o"
      );
      rm("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
      tell_object(this_player(), "数据已经恢复完毕，现在" HIW "记录" NOR "进程！\n");
      //log to recover_suicide
      write_file(
        "/log/recover_suicide",
        sprintf("%s %s恢复(%s)[自杀于%s]。\n", ctime(time()), me->name(1), arg, ctime(file_info[1]))
      );
      tell_object(this_player(), "(" + arg + ")的恢复进程完毕！\n");
      return 1;
    } else {
      message_vision(
        HIR "【警告】 " BLINK "请确认此玩家与所欲恢复的ID是否是同一个人！！" NOR HIY "\n如果是，请在命令行的最后加上参数-f。\n" HIC "如果不是，请拒绝恢复。\n" NOR,
        me
      );
      return 1;
    }
  } else {
    if (nod != "-f")
      return notify_fail("您的参数好象加错了，应该是-f。\n");
    else {
      if (file_size("/data/login/" + arg[0..0] + "/" + arg + ".o") < 0) {
        if (file_size("/data/login/" + arg[0..0] + "/" + arg + ".ooo") < 0)
          return notify_fail(HIR "【警告】 此玩家登陆备份档案已删除，无法恢复。\n" NOR);
        else cp(
          "/data/login/" + arg[0..0] + "/" + arg + ".ooo",
          "/data/login/" + arg[0..0] + "/" + arg + ".o"
        );
      }

      if (file_size("/data/user/" + arg[0..0] + "/" + arg + ".ooo") < 0)
        return notify_fail("他的档案好象没有备份呦！\n");

      // update player        
      if (ob = find_player(arg))
        return update_player(ob, arg);

      file_info = stat("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
      rm("/data/user/" + arg[0..0] + "/" + arg + ".o");
      cp(
        "/data/user/" + arg[0..0] + "/" + arg + ".ooo",
        "/data/user/" + arg[0..0] + "/" + arg + ".o"
      );
      rm("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
      tell_object(this_player(), "数据已经恢复完毕，现在" HIW "记录" NOR "进程！\n");
      //log to recover_suicide
      write_file(
        "/log/recover_suicide",
        sprintf("%s %s恢复(%s)[自杀于%s]。\n", ctime(time()), me->name(1), arg, ctime(file_info[1]))
      );
      tell_object(this_player(), "(" + arg + ")的恢复进程完毕！\n");
      return 1;
    }
  }
}

int update_player(object me, string arg) {
  object env, link_ob, obj;
  int *file_info;

  env = environment(me);

  // First, create the new body.
  link_ob = me->query_temp("link_ob");
  obj = LOGIN_D->make_body(link_ob);
  if (!obj) return 0;

  // Exec the player to his/her link object.
  exec(link_ob, me);
  destruct(me);
  // Recover Data

  file_info = stat("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
  rm("/data/user/" + arg[0..0] + "/" + arg + ".o");
  cp("/data/user/" + arg[0..0] + "/" + arg + ".ooo", "/data/user/" + arg[0..0] + "/" + arg + ".o");
  rm("/data/user/" + arg[0..0] + "/" + arg + ".ooo");
  tell_object(this_player(), "数据已经恢复完毕，现在" HIW "记录" NOR "进程！\n");
  //log to recover_suicide
  write_file(
    "/log/recover_suicide",
    sprintf(
      "%s %s恢复(%s)[自杀于%s]。\n",
      ctime(time()),
      this_player()->name(1),
      arg,
      ctime(file_info[1])
    )
  );
  tell_object(this_player(), "(" + arg + ")的恢复进程完毕！\n");

  // Restore new body and exec to it via enter_world in LOGIN_D
  obj->restore();
  LOGIN_D->enter_world(link_ob, obj, 1);

  write("你的数据恢复完毕。\n\n");
  obj->move(env);
  obj->write_prompt();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : recovers <目标ID> [-f]

这个指令可以自动恢复自杀的玩家。如果玩家原始记录存在，
而你要恢复的话，必须确认该玩家是否为欲恢复玩家，确认
后，再加上-f参数进行数据恢复。

HELP
  );
  return 1;
}
