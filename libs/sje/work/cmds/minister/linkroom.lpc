// by XiaoYao

#include <ansi.h>
#include <room.h>
inherit F_CLEAN_UP;

string *special_props = ({
  "short", "long" });

int save_room(string file);
int see_link(object env);
int del_link(object env, string arg);
int cancel_link(object me);
int connect_link();

int main(object me, string arg) {
  int result;
  string arg_new;
  object env;

  seteuid(getuid(me));
  env = environment(me);

  if (me->is_busy())
    return notify_fail("你的动作还没有完成。\n");

  if (!arg) {
    result = see_link(env);
    return result;
  }

  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我派的领地了。\n");

  if (arg == "cancel") {
    if (!me->query_temp("link_direct_old"))
      return notify_fail("你目前没有计划连接房间。\n");
    result = cancel_link(me);
    return result;
  }

  if (arg != "north" && arg != "south" && arg != "east" && arg != "west" && arg != "down" && arg != "up")
    return notify_fail("没有这个方向。\n");

  if (env->query("exits/" + arg)) {
    result = del_link(env, arg);
    return result;
  }

  if (me->query_temp("link_direct_old")) {
    switch (me->query_temp("link_direct_old")) {
      case "north":
        arg_new = "south";
        break;
      case "south":
        arg_new = "north";
        break;
      case "east":
        arg_new = "west";
        break;
      case "west":
        arg_new = "east";
        break;
      case "up":
        arg_new = "down";
        break;
      case "down":
        arg_new = "up";
        break;
    }
    if (arg != arg_new)
      return notify_fail("房间的方向错了。\n");
    me->set_temp("link_direct", arg);
    me->set_temp("link_room", file_name(env));
    result = connect_link();
    return result;
  }

  me->set_temp("link_direct_old", arg);
  me->set_temp("link_room_old", file_name(env));
  write("你把这里当做连接的第一间房间。\n");
  return 1;
}

int del_link(object env, string arg) {
  env->delete("exits/" + arg);
  save_room(file_name(env));
  write("你已经把 " + arg + " 方向给删除了。\n");
  return 1;
}

int cancel_link(object me) {
  me->delete_temp("link_direct_old");
  me->delete_temp("link_room_old");
  write("你取消未完成的连接动作。\n");
  return 1;
}

int connect_link() {
  object me;
  string arg, arg_old, env, env_old;
  me = this_player();

  arg = me->query_temp("link_direct");
  arg_old = me->query_temp("link_direct_old");
  env = me->query_temp("link_room");
  env_old = me->query_temp("link_room_old");
  new(env);
  new(env_old);

  find_object(env)->set("exits/" + arg, env_old);
  find_object(env_old)->set("exits/" + arg_old, env);

  me->delete_temp("link_direct");
  me->delete_temp("link_room");
  me->delete_temp("link_direct");
  me->delete_temp("link_room");

  save_room(env_old);
  save_room(env);

  write("你已经成功的连接了这两间房间\n");
  return 1;
}

int see_link(object env) {
  int i;
  object me;
  mapping exits;
  string str, *dirs;
  me = this_player();

  str = sprintf(" 这里的出口如下\n");

  if (mapp(exits = env->query("exits"))) {
    dirs = keys(exits);

    for (i = 0; i < sizeof(dirs); i++)
      if ((int)env->query_door(dirs[i], "status") & DOOR_CLOSED)
        dirs[i] = 0;
    dirs -= ({ 0 });
    if (sizeof(dirs) == 0)
      str += "    无。\n";

    for (i = 0; i < sizeof(dirs); i++) {
      new(env->query("exits/" + dirs[i]));
      str += sprintf("%6s" + NOR + " -- " + BOLD + "%s" + NOR + "。\n",
        dirs[i], find_object(env->query("exits/" + dirs[i]))->query("short"));
    }
  }
  write(str);
  return 1;
}

int save_room(string file) {
  object env, me;
  string str, *name;
  mapping prop;
  int i;

  me = this_player();
  env = find_object(file);

  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

  rm(file + ".lpc");
  write_file(file + ".lpc", str);
  return 1;
  return 0;

}

int help(object me) {
  write(@HELP

指令格式 : linkroom <方向>              往某方向连接出口
					如果该方向有连接则会删除该连接
           linkroom <cancel>            取消未完成的连接动作
           linkroom                     看看目前现有的连接出口

这是帮主与长老用来开路的指令，可以用来连结两间已存在的房间。当你用
makeroom 把房间做好了，而想把一串房间的头尾连接起来的时候，你就会用
到这个指令。

这个指令的用法是 : 你先选好要连接的两个房间，先在其中的一间下
linkroom <方向> 以定出连接的方向，然后在到另一间下 linkroom <反方向>
若这两个方向可以连接，那路就会开出来了。你可以用 link cancel 取消第
一个连接指令。

HELP
  );
  return 1;
}
