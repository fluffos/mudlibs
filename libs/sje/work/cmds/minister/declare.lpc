//ally.c
//declare.c

#include <ansi.h>

inherit F_CLEAN_UP;

int save_kingdom(object me, object env);

string *special_props = ({
  "short", "long" });

int main(object me, string arg) {
  string kingdom_file, kingdom_file2, *bedeclare, *ally, *declare;
  string newdeclare = "", cname = "", item;
  object ob, *list;
  int i, point;

  seteuid(getuid(me));

  if (me->is_busy())
    return notify_fail("你的动作还没有完成\n");

  if (me->is_fight())
    return notify_fail("你现在在战斗中\n");

  if (!arg) {
    kingdom_file = "/open/" + me->query("kingdom") + "/kingdom.lpc";
    new(kingdom_file);
    declare = find_object(kingdom_file)->query("declare");
    bedeclare = find_object(kingdom_file)->query("bedeclare");
    write(me->query("title") + "目前的敌对帮派如下：\n");
    if (sizeof(declare)) {
      for (i = 0; i < sizeof(declare); i++)
        write("      " + to_chinese(declare[i]) + "(" + declare[i] + ")\n");
    }
    write("\n目前敌视" + me->query("kingdom") + "的帮派如下：\n");
    if (sizeof(bedeclare)) {
      for (i = 0; i < sizeof(bedeclare); i++)
        write("      " + to_chinese(bedeclare[i]) + "(" + bedeclare[i] + ")\n");
    }
    return 1;
  } else if (file_size("/open/" + arg) == -2) {
    kingdom_file = "/open/" + arg + "/kingdom.lpc";
    new(kingdom_file);
    declare = find_object(kingdom_file)->query("declare");
    bedeclare = find_object(kingdom_file)->query("bedeclare");
    write(to_chinese(arg) + "目前的敌对帮派如下：\n");
    if (sizeof(declare)) {
      for (i = 0; i < sizeof(declare); i++)
        write("      " + to_chinese(declare[i]) + "(" + declare[i] + ")\n");
    }
    write("\n目前敌视" + to_chinese(arg) + "的帮派如下：\n");
    if (sizeof(bedeclare)) {
      for (i = 0; i < sizeof(bedeclare); i++)
        write("      " + to_chinese(bedeclare[i]) + "(" + bedeclare[i] + ")\n");
    }
    return 1;
  }

  if (sscanf(arg, "%s with %s", item, newdeclare) != 2)
    return notify_fail("指令格式：declare <forgive|hate> with <帮派>\n");

  if (file_size("/open/" + newdeclare + "/") != -2)
    return notify_fail("没有这个帮派。\n");

  if (newdeclare == me->query("kingdom"))
    return notify_fail("敌视自己的帮派？请天神帮你灭帮还比较快。\n");

  if (item == "hate")
    point = 1;
  else if (item == "forgive")
    point = 0;
  else
    return notify_fail("指令格式：declare <forgive|hate> with <帮派>\n");

  kingdom_file = me->query("cwd") + "kingdom.lpc";
  new(kingdom_file);
  declare = find_object(kingdom_file)->query("declare");
  bedeclare = find_object(kingdom_file)->query("bedeclare");
  ally = find_object(kingdom_file)->query("ally");
  if (sizeof(ally)) {
    if (member_array(newdeclare, ally) != -1 && point == 1)
      return notify_fail("贵帮目前和" + to_chinese(newdeclare) + "互为同盟帮派。\n" +
        "请先解除盟约再行敌视。\n");
    if (member_array(newdeclare, ally) != -1 && point == 0)
      return notify_fail("贵帮目前和" + to_chinese(newdeclare) + "互为同盟帮派。\n" +
        "不需解除敌视。\n");
  }

  if (sizeof(declare)) {
    if (member_array(newdeclare, declare) != -1 && point == 1)
      return notify_fail("贵帮已经和" + to_chinese(newdeclare) + "处于敌对状态了。\n");
    if (member_array(newdeclare, declare) == -1 && point == 0)
      return notify_fail("贵帮并没有和" + to_chinese(newdeclare) + "处于敌对状态。\n");
  } else {
    if (point == 0)
      return notify_fail("贵帮并没有和" + to_chinese(newdeclare) + "处于敌对状态。\n");
  }


  if (me->query("nickname")) cname = "「" + me->query("nickname") + "」";
  cname = cname + me->query("name") + "(" + capitalize(me->query("id")) + ")";

  if (point) {
    list = users();
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("kingdom") == newdeclare && (list[i]->query("cwd"))) {
        ob = list[i];
        break;
      }
    }
    if (!ob)
      return notify_fail(to_chinese(newdeclare) + "目前并没有帮主和长老在线。\n");

    if (!pointerp(declare))
      find_object(kingdom_file)->set("declare", ({ newdeclare }));
    else if (member_array(newdeclare, declare) == -1)
      find_object(kingdom_file)->set("declare", declare + ({ newdeclare }));
    save_kingdom(me, find_object(kingdom_file));

    kingdom_file2 = ob->query("cwd") + "kingdom";
    bedeclare = find_object(kingdom_file2)->query("bedeclare");
    if (!pointerp(bedeclare))
      find_object(kingdom_file2)->set("bedeclare", ({ me->query("kingdom") }));
    else if (member_array(me->query("kingdom"), bedeclare) == -1)
      find_object(kingdom_file2)->set("bedeclare", bedeclare + ({ me->query("kingdom") }));
    save_kingdom(ob, find_object(kingdom_file2));

    write(HIY + "\n【江湖传闻】我 - " + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")的" + cname + "宣布与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")处于敌对状态。\n\n" NOR);
    shout(HIY + "\n【江湖传闻】我 - " + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")的" + cname + "宣布与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")处于敌对状态。\n\n" NOR);
  } else if (!point) {
    list = users();
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("kingdom") == newdeclare && (list[i]->query("cwd"))) {
        ob = list[i];
        break;
      }
    }
    if (!ob)
      return notify_fail(to_chinese(newdeclare) + "目前并没有帮主和长老在线。\n");

    find_object(kingdom_file)->set("declare", declare - ({ newdeclare }));
    if (!pointerp(declare))
      find_object(kingdom_file)->delete("declare");
    save_kingdom(me, find_object(kingdom_file));

    kingdom_file2 = ob->query("cwd") + "kingdom";
    bedeclare = find_object(kingdom_file2)->query("bedeclare");
    find_object(kingdom_file2)->set("bedeclare", bedeclare - ({ me->query("kingdom") }));
    if (!pointerp(bedeclare))
      find_object(kingdom_file2)->delete("bedeclare");
    save_kingdom(ob, find_object(kingdom_file2));
    write(HIY + "\n【江湖传闻】我 - " + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")的" + cname + "宣布停止敌对" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")。\n\n" NOR);
    shout(HIY + "\n【江湖传闻】我 - " + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")的" + cname + "宣布停止敌对" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")。\n\n" NOR);
  }
  return 1;
}

int save_kingdom(object me, object env) {
  string str, *name, file;
  mapping prop;
  int i;

  file = me->query("cwd") + "kingdom.lpc";

  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;
}

int help(object me) {
  write(@HELP
指令格式 : declare hate with <帮派>     :  开始敌对某帮
           declare forgive with <帮派>  :  停止敌对
           declare <帮派>               :  察看某帮之敌对帮
           declare                      :  察看目前敌对帮

HELP
  );
}
