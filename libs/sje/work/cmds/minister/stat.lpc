#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me) {
  object kingdom, ob_king, ob_minister;
  string str;

  seteuid(getuid());

  //new(me->query("cwd")+"kingdom");
  kingdom = find_object(me->query("cwd") + "kingdom");

  str = sprintf("" HIR "帮派名称\t" + me->query("title") + "(" + me->query("kingdom") + ")\n");

  str += sprintf("" HIY "目前人口\t" + kingdom->query("people") + " 人\n");

  str += sprintf("" HIW "帮派资金\t" + kingdom->query("gold") + " 两黄金\n");

  ob_king = new(LOGIN_OB);
  ob_king->set("id", kingdom->query("king"));
  ob_king->restore();

  str += sprintf("" HIY "现任帮主\t" + ob_king->query("name") + "(" + ob_king->query("id") + ")\n");
  str += sprintf("" HIC "现任长老\n" NOR "");

  ob_minister = new(LOGIN_OB);

  for (int i = 1; i < 6; i++) {
    ob_minister->set("id", kingdom->query("minister" + (string)i));

    if (ob_minister->restore())
      str += sprintf(ob_minister->query("name") + "(" + ob_minister->query("id") + ")\n");
  }

  str += sprintf("共 " + kingdom->query("room") + " 间房间\t");
  str += sprintf("房间编号\t" + kingdom->query("room_num") + "\t");
  str += sprintf("可建额度 " + kingdom->query("room_max") + " 间\n");

  str += sprintf("共 " + kingdom->query("mob") + " 个NPC\t");
  str += sprintf("NPC编号 \t" + kingdom->query("mob_num") + "\t");
  str += sprintf("可建额度 " + kingdom->query("mob_max") + " 个\n");

  str += sprintf("共 " + kingdom->query("item") + " 个物品\t");
  str += sprintf("物品编号\t" + kingdom->query("item_num") + "\t");
  str += sprintf("可建额度 " + kingdom->query("room_max") + " 个\n\n");

  str += sprintf("" HIY "帮派库存金矿量  " + kingdom->query("golds") + " 块\t" NOR "");
  str += sprintf("" HIM "帮派库存木材量\t" + kingdom->query("wares") + " 根\n" NOR "");

  str += sprintf("" HIM "帮派库存银矿量  " + kingdom->query("sells") + " 块\t" NOR "");
  str += sprintf("" HIB "帮派库存砖瓦量\t" + kingdom->query("poers") + " 块\n" NOR "");

  str += sprintf("" MAG "帮派库存铜矿量  " + kingdom->query("coins") + " 块\t" NOR "");
  str += sprintf("" YEL "帮派库存石头量\t" + kingdom->query("fires") + " 块\n" NOR "");
  str += sprintf("" WHT "帮派库存铁矿量  " + kingdom->query("irons") + " 块\t" NOR "");
  str += sprintf("" RED "帮派特产品总量\t" + kingdom->query("abcds") + " 箱\n" NOR "");
  write(str);
  return 1;
}
