// by XiaoYao

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string msg;
  object env;

  env = environment(me);

  if (arg == "here") {
    if (env->query("kingdom_id") != me->query("kingdom"))
      return notify_fail("这里不是你的帮派。\n");

    me->set("home", file_name(env));
    write("你把这里设成自己的帮派的返回点。\n");
    return 1;
  }
  if (stringp(msg = "$N急急忙忙地回到了自己帮派。"))
    message_vision(msg + "\n", me);
  me->move(me->query("home"));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : home (here)

利用此一指令可直接回到自己国家的帮派总舵。
HELP
  );
  return 1;
}
