//edit by xiaoyao

inherit F_CLEAN_UP;

string *special_props = ({
  "eq", "limbs", "verbs", "race", "attitude", "unit", "level", "nickname", "age", "gender", "level" });

int save_mob(object mob);
void show_mob(object mob);
int check_legal_name(string name);
int check_legal_id(string id);

int main(object me, string arg) {
  object env, ob;
  string mob_file, arg1, arg2, type, flag;
  string temp1, temp2, *env_mob_file;
  string id1, id2, id3, id4;
  mapping env_mob;
  int level, old_lv, money, flag2, i;

  env = environment(me);

  seteuid(getuid(me));

  if (me->is_busy())
    return notify_fail("你的动作还没有完成。\n");

  if (me->is_fight())
    return notify_fail("你现在在战斗中。\n");

  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我帮派的领地了。\n");

  if (!arg)
    return notify_fail("指令格式：help setnpc\n");

  if (ob = present(arg, env)) {

    if (!ob || !env->query("objects") || userp(ob))
      return notify_fail("这个地方并没有这个NPC。\n");

    env_mob = env->query("objects");
    env_mob_file = keys(env_mob);

    for (i = 0; i < sizeof(env_mob_file); i++) {
      if (env_mob_file[i] == base_name(ob))
        show_mob(ob);
    }

    return 1;
  }

  if (sscanf(arg, "%s to %s", arg1, arg2) != 2)
    return notify_fail("指令格式：help setnpc\n");

  if (arg1 == "corpse")
    return notify_fail("使用这个名字好象不太好吧。\n");

  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我帮派的领地了。\n");

  ob = present(arg1, env);

  if (!ob || !env->query("objects") || userp(ob))
    return notify_fail("这个地方并没有这个NPC。\n");

  env_mob = env->query("objects");
  env_mob_file = keys(env_mob);
  for (i = 0; i < sizeof(env_mob_file); i++) {
    if (env_mob_file[i] == base_name(ob))
      flag2 += 1;
  }

  if (!flag2)
    return notify_fail("这mob并不是本地的mob\n");

  if (sscanf(arg2, "%s %s", type, flag) != 2)
    return notify_fail("please help set_mob\n");

  switch (type) {
    case "name":
      if (!check_legal_name(flag)) {
        return notify_fail("中文取字错误\n");
      }
      ob->set("name", flag);
      break;

    case "id":
      if (sscanf(flag, "%s %s", id1, id2) == 2)
        if (sscanf(id2, "%s %s", id2, id3) == 2)
          if (sscanf(id3, "%s %s", id3, id4) == 2)
            return notify_fail("这个NPC的ID太多了。\n");

      if (id3)
        if (!check_legal_id(id3)) {
          return notify_fail("第 3 英文取字错误。\n");
        }
      if (id2)
        if (!check_legal_id(id2)) {
          return notify_fail("第 2 英文取字错误。\n");
        }
      if (id1)
        if (!check_legal_id(id1)) {
          return notify_fail("第 1 英文取字错误。\n");
        }
      if (!id1)
        if (!check_legal_id(flag)) {
          return notify_fail("英文取字错误。\n");
        }
      ob->set("id", flag);
      break;
    case "nickname":
      "cmds/usr/nick"->main(ob, flag);

      break;
    case "age":
      if (!sscanf(flag, "%d", level))
        return notify_fail("格式错误\n");
      ob->set("age", level);
      break;
    case "long":
      if (!sscanf(flag, "%d", level))
        return notify_fail("格式错误\n");

      if (level != 1)
        return notify_fail("请设 1\n");
      me->edit((: call_other, __FILE__, "do_change", ob :));
      return 1;
      break;
    case "race":
      if (flag == "野兽") {
        ob->set("race", flag);
        ob->set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
        ob->set("verbs", ({ "bite", "claw" }));
        break;

      }

      if (flag == "人类") {
        ob->set("race", flag);
        ob->set("limbs", ({
          "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
          "右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿",
          "左脚", "右脚"
        }));
        ob->delete("verbs");
        break;
      }
      return notify_fail("只有 野兽 和 人类\n");

      break;
    case "unit":
      if (sscanf(flag, "%s %s", temp1, temp2) == 2)
        return notify_fail("格式错误\n");
      ob->set("unit", flag);
      break;
    case "gender":
      if (sscanf(flag, "%s %s", temp1, temp2) == 2)
        return notify_fail("格式错误\n");
      ob->set("gender", flag);

      break;
    case "aggressive":
      if (!sscanf(flag, "%d", level))
        return notify_fail("格式错误\n");

      if (level == 1) {
        ob->set("attitude", "aggressive");
        break;
      }
      if (level == 0) {
        ob->delete("attitude");
        break;
      }

      return notify_fail("请设 1 or 0\n");

      break;
    case "level":
      if (!sscanf(flag, "%d", level))
        return notify_fail("格式错误\n");

      if (level < 1 || level > 35)
        return notify_fail("格式错误\n");

      old_lv = ob->query("level");
      if (level > old_lv)
        money = 500 * (level - old_lv);


      ob->set("level", level);
      break;

    default: return notify_fail("没有这种参数类型\n");
  }

  mob_file = base_name(ob);

  if (!save_mob(ob))
    return notify_fail("储存NPC资料失败\n");

  return 1;
}

void do_change(object mob, string str) {

  mob->set("long", str);

  save_mob(mob);
  return;
}

int check_legal_name(string name) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 2) || (strlen(name) > 12)) {
    write("对不起，NPC的中文名字必须是 1 到 6 个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，NPC的中文名字不能用控制字元。\n");
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  return 1;
}
int check_legal_id(string id) {
  int i;

  i = strlen(id);

  if ((strlen(id) < 2) || (strlen(id) > 12)) {
    write("对不起，NPC的英文名字必须是 2 到 12 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，NPC的英文名字只能用英文字母。\n");
      return 0;
    }

  return 1;
}

void show_mob(object mob) {
  string str;

  str = sprintf("NPC设定\n");

  str += sprintf("名称: %s(%s)\n", mob->query("name"), mob->query("id"));
  str += sprintf("等级: %d\n", mob->query("level"));
  str += sprintf("种族: %s\n", mob->query("race"));
  str += sprintf("帮派: %s\n", mob->query("stay_kingdom"));
  str += sprintf("制造者: %s\n", mob->query("owner"));
  str += sprintf("单位: %s\n", mob->query("unit"));
  str += sprintf("叙述: \n%s\n", mob->query("long"));
  str += sprintf("匿称: %s\n", mob->query("nickname"));
  str += sprintf("年龄: %d\n", mob->query("age"));
  str += sprintf("性别: %s\n", mob->query("gender"));

  if (mob->query("attitude") == "aggressive")
    str += sprintf("态度: 自动杀人。\n");

  write(str);
  return;
}

int save_mob(object mob) {
  object me;
  string str, *name, file, id, xx, *eq, eq_str, *wp, wp_str, item_str, item;
  mapping prop, eq_prop, wp_prop;
  int i;

  me = this_player();
  file = base_name(mob);

  if (!mob) return notify_fail("修改失败喔。\n");

  id = mob->query("id");

  if (mob->query("eq")) {
    eq_prop = mob->query("eq");
    eq = keys(eq_prop);

    eq_str = "";
    for (i = 0; i < sizeof(eq); i++) {
      if (new(eq_prop[eq[i]]))
        eq_str += sprintf("\n\tcarry_object(%O)->wear();\n", eq_prop[eq[i]]);
    }
  }

  if (mob->query("item")) {
    item = mob->query("item");

    item_str = "";

    if (new(item))
      item_str += sprintf("\n\tcarry_object(%O);\n", item);
  }

  if (mob->query("weapon")) {
    wp_prop = mob->query("weapon");
    wp = keys(wp_prop);

    wp_str = "";
    for (i = 0; i < sizeof(wp); i++) {
      if (new(wp_prop[wp[i]]))
        wp_str += sprintf("\n\tcarry_object(%O)->wield();\n", wp_prop[wp[i]]);
    }
  }

  if (sscanf(id, "%s %s", xx, id) == 2)
    if (sscanf(id, "%s %s", xx, id) == 2)
      if (sscanf(id, "%s %s", xx, id) == 2)
        return notify_fail("这NPC的ID太多了吧\n");

  str = "// Mob: " + me->query("title") + @ROOM_CODE

inherit NPC;

void create()
{
ROOM_CODE;
  str += sprintf("\tset_name( %O, ({ %O,%O }));\n", mob->query("name"), mob->query("id"), id);
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", mob->query("long"));
  prop = mob->query_entire_dbase();
  name = keys(prop);

  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1)
      str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }

  str += "\n\tsetup();\n\n";

  if (eq_str)
    str += "\n" + eq_str + "\n";

  if (wp_str)
    str += "\n" + wp_str + "\n";

  if (item_str)
    str += "\n" + item_str + "\n";

  str += "\n}\n";

  rm(file + ".lpc");
  if (write_file(file + ".lpc", str))
    write("ok!\n");

  "/cmds/app/update"->main(me, file);
  "/cmds/app/update"->main(me, base_name(environment(me)));
  destruct(mob);



  destruct(find_object(file));
  new(file)->move(environment(me));

  return 1;
  return 0;

}



int help(object me) {
  write(@HELP
指令格式 : 指令格式 : set_mob <生物名称> to <参数类型> <设定值>

这是国王大臣们用来修改MOB的指令, 适当的修改MOB的参数, 可以使
效果更好。

目前可以运用的参数类型有

name            没有限制,最好不要乱设
id              look mob时只能打全名,这是缺点
gender          男性,女性,中性
nickname        用法请help nickname
                set_mob xxx to nickname -d      清除nickname
level           等级(1~35)      等级提高一级5000元(非国库)
unit            单位(只,位,个)
aggressive      设1为AUTO K,设0为取消
race            有 野兽 与 人类 两种族
long            set_mob <id> to long 1
age             年龄

HELP
  );
  return 1;
}
