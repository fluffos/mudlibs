//setroom.c
//by xiaoyao

inherit F_CLEAN_UP;
#include <save.h>
int main(object me, string arg) {
  string file, room_me, str = "", ob1, ob2, outdoors, no_back,
    no_fight, no_recall;
  object env, room;

  seteuid(getuid(me));

  env = environment(me);
  room_me = base_name(env);

  if (me->is_busy())
    return notify_fail("你的动作还没有完成。\n");
  if (me->is_fighting())
    return notify_fail("你还在战斗中。\n");
  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这不是我帮派的领地了\n");
  room = find_object(room_me + ".lpc");
  if (!arg) { /* 察看房间状况 */
    outdoors = (room->query("outdoors") ? "开" : "关");
    no_back = (room->query("no_back") ? "开" : "关");
    no_fight = (room->query("no_fight") ? "开" : "关");
    no_recall = (room->query("no_recall") ? "开" : "关");
    //              no_quit = (room->query("no_quit") ? "开":"关");
    printf("这个房间的环境变数资料：\n" + room_me + ".c\n"
      "──────────────────\n");
    str += sprintf("室外气候(Outdoors)：\t\t" + outdoors +
      "\n──────────────────\n");
    str += sprintf("禁止召唤(No_back)：\t\t" + no_back +
      "\n──────────────────\n");
    str += sprintf("禁止战斗(No_fight)：\t\t" + no_fight +
      "\n──────────────────\n");
    str += sprintf("禁止返回起点(No_recall)：\t" + no_recall +
      "\n──────────────────\n");
    write(str);
    return 1;
  }
  if (sscanf(arg, "%s %s", ob1, ob2) == 2) {
    if (ob1 == "outdoors" || ob1 == "no_back" || ob1 == "no_fight" || ob1 == "no_recall") {
      if (ob2 == "off") {
        if (!room->query(ob1))
          return notify_fail("这里没有设定 " + capitalize(ob1) + " 。\n");
        room->delete(ob1);
        save_room(file = file_name(room));
        write("关闭 " + capitalize(ob1) + " 完成。\n");
        return 1;
      }
      if (ob2 == "on") {
        room->set(ob1, ob2);
        save_room(file = file_name(room));
        write("开启 " + capitalize(ob1) + " 完成。\n");
        return 1;
      }
    }
  }
  return notify_fail("指令格式：setroom <参数名称> <参数>\n");
}
int help(object me) {
  write(@HELP
----------------------------------------
指令格式：setroom <参数> [on|off]
----------------------------------------
说明：
  on：启动
 off：关闭
----------------------------------------
HELP
  );
  return 1;
}
