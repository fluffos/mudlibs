//ally.c by xiaoyao

#include <ansi.h>

inherit F_CLEAN_UP;

int save_kingdom(object me, object env);

int do_wait(object me);

string *special_props = ({
  "short", "long" });

int main(object me, string arg) {
  string kingdom_file, kingdom_file2, *ally, *ally2, *declare, *bedeclare;
  string newally = "", delally = "", cname = "";
  object ob, *list;
  int i, point;

  seteuid(getuid(me));

  if (me->is_busy())
    return notify_fail("你的动作还没有完成\n");

  if (me->is_fight())
    return notify_fail("你现在在战斗中\n");

  kingdom_file = me->query("cwd") + "kingdom.lpc";
  ally = find_object(kingdom_file)->query("ally");
  if (!arg) {
    if (sizeof(ally)) {
      write("贵帮目前的同盟帮派如下：\n");
      for (i = 0; i < sizeof(ally); i++)
        write("     " + to_chinese(ally[i]) + "(" + ally[i] + ")\n");
    } else
      write("贵帮目前没有任何同盟帮派。\n");
    return 1;
  }

  if (sscanf(arg, "cancel with %s", delally) == 1);
  else if (sscanf(arg, "with %s", newally) == 1);
  else return notify_fail("指令格式：ally <cancel> with <帮派>\n");

  point = 0;
  if (sizeof(newally))
    point = 1;

  if (file_size("/open/" + newally + "/") != -2 && point == 1)
    return notify_fail("没有这个帮派。\n");
  if (file_size("/open/" + delally + "/") != -2 && point == 0)
    return notify_fail("没有这个帮派。\n");

  if (newally == me->query("kingdom") && point == 1)
    return notify_fail("自己和自己同盟？别傻了。\n");
  if (delally == me->query("kingdom") && point == 0)
    return notify_fail("自己和自己解除同盟？别傻了。\n");

  if (sizeof(ally)) {
    if (member_array(newally, ally) != -1 && point == 1)
      return notify_fail("贵帮已经和" + to_chinese(newally) + "结盟了。\n");
    if (member_array(delally, ally) == -1 && point == 0)
      return notify_fail("贵帮并没有和" + to_chinese(delally) + "同盟。\n");
  }

  declare = find_object(kingdom_file)->query("declare");
  if (sizeof(declare)) {
    if (member_array(newally, declare) != -1 && point == 1)
      return notify_fail("贵帮目前和" + to_chinese(newally) + "处于敌视状态。\n" +
        "请先解除敌视再行同盟。\n");
    if (member_array(delally, declare) != -1 && point == 0)
      return notify_fail("贵帮目前和" + to_chinese(delally) + "处于敌视状态。\n" +
        "不需解除盟约。\n");
  }

  bedeclare = find_object(kingdom_file)->query("bedeclare");
  if (sizeof(bedeclare)) {
    if (member_array(newally, bedeclare) != -1 && point == 1)
      return notify_fail("贵帮目前和" + to_chinese(newally) + "处于敌视状态。\n" +
        "请先解除敌视再行同盟。\n");
    if (member_array(delally, bedeclare) != -1 && point == 0)
      return notify_fail("贵帮目前和" + to_chinese(delally) + "处于敌视状态。\n" +
        "不需解除盟约。\n");
  }

  if (!me->query_temp("ally") && point == 1) {
    list = users();
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("kingdom") == newally && (list[i]->query("cwd"))) {
        ob = list[i];
        break;
      }
    }
    if (!ob)
      return notify_fail(to_chinese(newally) + "目前并没有帮主和长老在线。\n");
    if (me->query("nickname")) cname = "「" + me->query("nickname") + "」";
    cname = cname + me->query("name") + "(" + capitalize(me->query("id")) + ")";
    ob->set_temp("ally", me);
    tell_object(ob, HIC + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) +
      ")" + "的" + cname + "送出与贵帮的同盟协议。\n" NOR);
    write(HIC "你送出与" + to_chinese(newally) + "的同盟协议。\n" NOR);
    call_out("do_wait", 30, ob);
    return 1;
  } else if (point == 1) {
    ob = (object)me->query_temp("ally");
    kingdom_file = me->query("cwd") + "kingdom";
    ally = find_object(kingdom_file)->query("ally");
    if (!pointerp(ally))
      find_object(kingdom_file)->set("ally", ({ newally }));
    else if (member_array(newally, ally) == -1)
      find_object(kingdom_file)->set("ally", ally + ({ newally }));
    save_kingdom(me, find_object(kingdom_file));

    kingdom_file2 = ob->query("cwd") + "kingdom";
    ally2 = find_object(kingdom_file2)->query("ally");
    if (!pointerp(ally2))
      find_object(kingdom_file2)->set("ally", ({ me->query("kingdom") }));
    else if (member_array(me->query("kingdom"), ally2) == -1)
      find_object(kingdom_file2)->set("ally", ally2 + ({ me->query("kingdom") }));
    save_kingdom(ob, find_object(kingdom_file2));

    me->delete_temp("ally");

    //    write(HIY+to_chinese(me->query("kingdom"))+"与"+to_chinese(ob->query("kingdom"))+"正式建立同盟关系。\n"NOR);
    write(HIY + "\n【江湖传闻】" + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")正式建立同盟关系。\n\n" NOR);
    shout(HIY + "\n【江湖传闻】" + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")正式建立同盟关系。\n\n" NOR);
  } else if (point == 0) {
    list = users();
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("kingdom") == delally && (list[i]->query("cwd"))) {
        ob = list[i];
        break;
      }
    }
    if (!ob)
      return notify_fail(to_chinese(delally) + "目前并没有帮主和长老在线。\n");
    kingdom_file = me->query("cwd") + "kingdom";
    ally = find_object(kingdom_file)->query("ally");
    find_object(kingdom_file)->set("ally", ally - ({ delally }));
    if (!pointerp(ally))
      find_object(kingdom_file)->delete("ally");
    save_kingdom(me, find_object(kingdom_file));

    kingdom_file2 = ob->query("cwd") + "kingdom";
    ally2 = find_object(kingdom_file2)->query("ally");
    find_object(kingdom_file2)->set("ally", ally2 - ({ me->query("kingdom") }));
    if (!pointerp(ally2))
      find_object(kingdom_file2)->delete("ally");
    save_kingdom(ob, find_object(kingdom_file2));

    write(HIY + "\n【江湖传闻】" + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")从今日起与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")解除同盟。\n\n" NOR);
    shout(HIY + "\n【江湖传闻】" + to_chinese(me->query("kingdom")) + "(" + capitalize(me->query("kingdom")) + ")从今日起与" + to_chinese(ob->query("kingdom")) + "(" + capitalize(ob->query("kingdom")) + ")解除同盟。\n\n" NOR);
  }
  return 1;
}

int save_kingdom(object me, object env) {
  string str, *name, file;
  mapping prop;
  int i;

  file = me->query("cwd") + "kingdom.lpc";

  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;
}

int do_wait(object ob) {
  object me;
  if (!ob)
    return 1;
  me = (object)ob->query_temp("ally");
  if (ob->query_temp("ally")) {
    ob->delete_temp("ally");
    write("对方并不理会你的同盟协议。\n");
    tell_object(ob, "你拒决" + to_chinese(me->query("kingdom")) + "的同盟协议。\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : ally with <帮派>             :  送出结盟协议
           ally cancel with <帮派>      :  终止结盟关系
           ally                         :  察看目前同盟的帮派。

这个指令可以和其他帮派结盟。结盟通常是表示互相友好之意, 也同时定下
了互不侵犯的协定, 所以在对同盟帮派宣战之前, 一定要先解除同盟关系。两
帮结盟了以后, 双方的帮众就可以互相通过关卡而互访, 除此之外, 并没有
其他权力义务关系。

结盟时, 需要两国长老的同意, 而终止结盟时只要片面宣布就算生效了。
HELP
  );
}
