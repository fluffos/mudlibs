// addnpc.c
//edit by xiaoyao

inherit F_CLEAN_UP;
#define UPDATE     "/cmds/app/update"

string *special_props = ({
  "short", "long" });

int save_kingdom();
int save_room(string file);

int main(object me, string arg) {
  int num;
  string file, file1, mobu;
  string na, en;
  object env_me;
  seteuid(getuid(me));
  env_me = environment(this_player());

  if (!arg || !sscanf(arg, "%s %s", na, en))
    return notify_fail("指令格式：addnpc <中文名> <英文名>\n");

  if (!na || !en)
    return notify_fail("请指定非玩家角色的中英文名．\n");

  if (env_me->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我帮派的领地了\n");

  if (find_object(me->query("cwd") + "kingdom")->query("golds") < 10)
    return notify_fail("帮派中没有足够的金矿．\n");
  if (find_object(me->query("cwd") + "kingdom")->query("irons") < 10)
    return notify_fail("帮派中没有足够的铁矿．\n");
  file1 = me->query("cwd") + "kingdom.lpc";

  num = find_object(me->query("cwd") + "kingdom")->query("mob_num");
  num += 1;
  find_object(me->query("cwd") + "kingdom")->add("golds", -10);
  find_object(me->query("cwd") + "kingdom")->add("irons", -10);
  file = me->query("cwd") + "npc/" + (string)num + ".lpc";

  mobu = "// Npc: " + me->query("title") + @MOB_CODE

#include <ansi.h>
inherit NPC;

void create()
{
MOB_CODE;
  mobu += sprintf("\tset_name(\"%s\", ({ \"%s\"}) );\n", na, en);

  mobu += "\tset(\"race\",\"人类\");\n";
  mobu += sprintf("\tset(\"long\", @LONG
        
LONG
);\n");
  mobu += sprintf("\tset(\"qi\",%d);\n", 500);
  mobu += sprintf("\tset(\"jing\",%d);\n", 500);
  mobu += sprintf("\tset(\"jingli\",%d);\n", 500);
  mobu += sprintf("\tset(\"neili\",%d);\n", 500);
  mobu += sprintf("\tset(\"max_qi\",%d);\n", 500);
  mobu += sprintf("\tset(\"max_jing\",%d);\n", 500);
  mobu += sprintf("\tset(\"max_neili\",%d);\n", 500);
  mobu += sprintf("\tset(\"combat_exp\",%d);\n", 50000);

  mobu += "\tsetup();\n}\n";

  if (!write_file(file, mobu))
    return notify_fail("你没有制造非玩家角色的权利，请通知逍遥。\n");

  tell_room(environment(me), me->name() +
    "你眼前一亮，突然间一位" + (me->query("cwd") + "npc/" + num) + "的走了过来。\n", ({ me }));

  tell_object(me,
    "你眼前一亮，突然间一位" + (me->query("cwd") + "npc/" + num) + "的走了过来。\n");

  this_player()->set("key", 1);
  UPDATE->main(me, file);
  this_player()->delete("key");
  find_object(me->query("cwd") + "npc/" + num)->move(env_me);
  find_object(me->query("cwd") + "kingdom")->add("mob_num", 1);
  find_object(me->query("cwd") + "kingdom")->add("mob", 1);
  env_me->add("objects/", ([ me->query("cwd") + "npc/" + num: 1 ]));
  save_kingdom();
  save_room(file_name(env_me));
  return 1;
}

int save_room(string file) {
  object env, me;
  string str, *name;
  mapping prop;
  int i;
  me = this_player();


  env = find_object(file);
  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  rm(file + ".lpc");
  write_file(file + ".lpc", str);
  return 1;
  return 0;


}

int save_kingdom() {
  object env, me;
  string str, *name, file;
  mapping prop;
  int i;
  me = this_player();
  file = me->query("cwd") + "kingdom.lpc";
  env = find_object(me->query("cwd") + "kingdom");
  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;

}
int help(object me) {
  write(@HELP

指令格式 : add_mob <中文名> <英文名>

帮主或长老利用此指令可创造NPC。
HELP
  );
  return 1;
}
