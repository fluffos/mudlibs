//edit by xiaoyao

inherit F_CLEAN_UP;

string *special_props = ({
  "short", "long" });

int save_kingdom();

int main(object me, string arg) {
  object ob;
  string kingdom_file, str;

  seteuid(getuid(me));

  if (me->is_busy())
    return notify_fail("你的动作还没有完成\n");

  if (!(ob = present(arg, environment(me))))
    return notify_fail("你想收谁作帮众？\n");

  if (!arg) return notify_fail("指令格式：accept <对象>\n");



  if (ob == me) return notify_fail("收自己当帮众？好主意....不过没有用。\n");

  if (!userp(ob)) return notify_fail(ob->name() + "他不是玩家。\n");

  if ((object)ob->query_temp("join") == me) {

    if (!living(ob)) {
      message_vision(
        "$N决定收$n为帮众。\n"
        "不过看样子$n显然在发呆。\n\n",
        me, ob);
      return 1;
    }

    message_vision(
      "$N决定收$n当帮众。\n\n",
      me, ob);

    ob->delete_temp("join");

    write("恭喜你新收了一位帮众！\n");
    tell_object(ob, sprintf("恭喜您成为%s的帮众。\n", me->query("title")));
    ob->set("title", me->query("title"));
    ob->set("kingdom", me->query("kingdom"));
    ob->save();

    kingdom_file = me->query("cwd") + "kingdom";
    find_object(kingdom_file)->add("people", 1);
    str = "我" + ob->query("name") + "(" + ob->query("id") + ")即日起决定效忠于" + ob->query("title");
    CHANNEL_D->do_channel(ob, "chat", sprintf("%s", str));

    save_kingdom();
    return 1;


  } else {

    return notify_fail("他没有向你申请入帮。\n");
  }
}

int save_kingdom() {
  object env, me;
  string str, *name, file;
  mapping prop;
  int i;

  me = this_player();
  file = me->query("cwd") + "kingdom.lpc";
  env = find_object(me->query("cwd") + "kingdom");

  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;

}

int help(object me) {
  write(@HELP
指令格式 : accept <对象>
 
这个指令能让你收某人入帮
 
HELP
  );
  return 1;
}
