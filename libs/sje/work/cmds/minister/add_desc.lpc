//add_desc.c
//by xiaoyao

#include <ansi.h>

inherit F_CLEAN_UP;

string *special_props = ({
  "short", "long" });

int saveroom(string file);

int main(object me, string arg) {

  string del, desc, line, *desc1;
  object env;
  mapping desc_all;

  seteuid(getuid(me));

  env = environment(me);

  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我帮的领地了\n");

  if (!arg) {
    if (env->query("item_desc")) {
      desc_all = env->query("item_desc");
      desc1 = keys(desc_all);

      if (!sizeof(desc1))
        return notify_fail("这里没有设描述。\n");

      line = "这里的描述有\n\n";

      for (int i = 0; i < sizeof(desc1); i++) {
        line += sprintf(
          HIR " 描述句" NOR " %s " HIR "\n 描述内容" NOR "\n %s \n" NOR
          "----------------------------------------\n",
          desc1[i],
          env->query("item_desc/" + desc1[i])
        );
      }

      write(line);
      return 1;
    }
    write("这里没有设描述\n");
    return 1;
  }

  if (sscanf(arg, "%s %s", del, desc) == 2) {

    if (del == "-d") {
      if (!env->query("item_desc/" + desc))
        return notify_fail("这里没有这个描述。\n");

      env->delete("item_desc/" + desc);
      saveroom(file_name(env));
      write("取消描述设定完成。\n");
      return 1;
    }
    return notify_fail("请查看help add_desc。\n");
  }

  me->edit((: call_other, __FILE__, "do_change", me, arg :));
  write("设定描述完成。\n");
  return 1;
}

void do_change(object me, string arg, string str) {
  str = replace_string(str, "$BLK$", BLK);
  str = replace_string(str, "$RED$", RED);
  str = replace_string(str, "$GRN$", GRN);
  str = replace_string(str, "$YEL$", YEL);
  str = replace_string(str, "$BLU$", BLU);
  str = replace_string(str, "$MAG$", MAG);
  str = replace_string(str, "$CYN$", CYN);
  str = replace_string(str, "$WHT$", WHT);
  str = replace_string(str, "$HIR$", HIR);
  str = replace_string(str, "$HIG$", HIG);
  str = replace_string(str, "$HIY$", HIY);
  str = replace_string(str, "$HIB$", HIB);
  str = replace_string(str, "$HIM$", HIM);
  str = replace_string(str, "$HIC$", HIC);
  str = replace_string(str, "$HIW$", HIW);
  str = replace_string(str, "$NOR$", NOR);
  environment(me)->add("item_desc/" + arg, str);

  saveroom(file_name(environment(me)));
  return;
}

int saveroom(string file) {
  object env, me;
  string str, *name;
  mapping prop;
  int i;
  me = this_player();


  env = find_object(file);
  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n}\n";

  // Replace current directory with __DIR__ macro to make relocatable code.

  rm(file + ".lpc");
  write_file(file + ".lpc", str);
  return 1;
  return 0;

}

int help(object me) {
  write(@HELP

指令格式 : add_desc <特定词>            : 增加一个描述
           add_desc -d <特定词>         : 去除一个描述
           add_desc                     : 可看到所有的desc

HELP
  );
  return 1;
}
