//edit by xiaoyao

inherit F_CLEAN_UP;

string *special_props = ({
  "short", "long" });

int save_kingdom();

int main(object me, string arg) {
  string new_status, kingdom_file, str;
  new_status = "(player)";

  seteuid(getuid());

  if (me != this_player(1)) return 0;

  if (me->is_busy())
    return notify_fail("你的动作还没有完成\n");

  if (me->is_fight())
    return notify_fail("你现在在战斗中\n");

  kingdom_file = me->query("cwd") + "kingdom";
  if (me->query("id") == find_object(kingdom_file)->query("king"))
    return notify_fail("帮主请先用让位指令后再辞职。\n");

  if (!(SECURITY_D->set_status(me, new_status)))
    return notify_fail("修改失败。\n");

  for (int i = 1; i < 6; i++) {
    if (find_object(kingdom_file)->query("minister" + (string)i) == me->query("id")) {
      find_object(kingdom_file)->delete("minister" + (string)i);
      str = "我宣布即日起辞去长老的职务 !";
      CHANNEL_D->do_channel(me, "chat", sprintf("%s", str));
    }
  }
  me->set("power", "无");
  save_kingdom();
  me->delete("cwd");
  me->save();
  me->setup();

  return 1;
}
int save_kingdom() {
  object env, me;
  string str, *name, file;
  mapping prop;
  int i;

  me = this_player();
  file = me->query("cwd") + "kingdom.lpc";
  env = find_object(me->query("cwd") + "kingdom");

  str = "// Room: " + me->query("title") + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;
}

int help(object me) {
  write(@HELP
指令格式 : resign
   
辞职。
HELP
  );
  return 1;
}
