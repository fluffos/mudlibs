//edit by xiaoyao

inherit F_CLEAN_UP;
#include <save.h>
int main(object me,string arg)
{
        object env;
        string link_file, kingdom_file,arg1;

        env = environment(me);

        seteuid(getuid(me));

        if( me->is_busy() )
                return notify_fail("你的动作还没有完成。\n");
        if( me->is_fighting() )
                return notify_fail("你还在战斗中。\n");
        if( !arg )
                return notify_fail("指令格式：rmroom <方向>\n");
        if( arg!="north" && arg!="south" && arg!="east" && arg!="west" && arg!="down" && arg!="up" )
                return notify_fail("没有这个方向。\n");
        if( env->query("kingdom_id")!=me->query("kingdom") ) 
                return notify_fail("这里不是我帮派的领地了\n");
        if(!env->query("exits/"+arg))
                return notify_fail("这个方向并没有连接。\n");
        switch (arg){
          case "east": arg1 ="东面"; break;             
          case "south": arg1="南面"; break;   
          case "west": arg1="西面"; break;         
          case "north": arg1="北面"; break;
          case "down": arg1="下面"; break;
          case "up": arg1="上面"; break;  
          default : break;
        }
        link_file = env->query("exits/"+arg);

//      new(link_file);
        if(find_object(link_file)->query("no_delete") )
                return notify_fail("此房间不能被清除。\n");
        rm(link_file+".lpc");
        env->delete("exits/"+arg);
        kingdom_file = me->query("cwd")+"kingdom";
//      new(kingdom_file);
        find_object(kingdom_file)->add("room",-1);
        save_kingdom();
        save_room(file_name(env));
        message_vision("只听见轰的一声！$N找了几个帮众将"+ arg1 +"的房间拆了。\n", me);
        return 1;
}

int help(object me)
{
write(@HELP
----------------------------------------
指令格式：rmroom <方向>
----------------------------------------
说明：
　　这个指令能让你删除某个房间。
----------------------------------------
HELP
        );
        return 1;
}

