//saveroom.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string flag) {
  int i, k, long, j;
  string *special_props = ({ "objects" });
  string str, *name, a, pp, this_file, file, check, *nn;
  object env;
  mapping prop;
  env = environment(me);
  file = file_name(env);
  if (!(file[i] == 'c' && file[i - 1] == '.')) file = file + ".lpc";
  long = sizeof(this_player()->query("kingdom/id")) - 1;
  check = file[6..6 + long];
  if (check != this_player()->query("kingdom/id")) return notify_fail("这里不是你的帮派的领地。\n");

  this_file = file_name(environment(me));
  k = sizeof(this_file) - 1;
  if (!(this_file[k] == 'c' && this_file[k - 1] == '.')) this_file = this_file + ".lpc";
  if (!flag) env = environment(this_player());
  else env = find_object(flag);
  nn = explode(read_file(this_file), "\n");
  str = "";

  for (j = 0; j < sizeof(nn); j++)
    if (strsrch(nn[j], "void create") != 0) str += nn[j] + "\n";
  else break;

  str += "" + @ROOM_CODE
void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf(
    "\tset(\"long\", @LONG\n%sLONG\n\t);\n",
    env->query("long")
  ); str += sprintf("\tset(\"type\", %O);\n", env->query("type"));
  if (env->query("type") == "board") str += sprintf("\tset(\"board\", %O);\n", env->query("board"));
  str += sprintf("\tset(\"kingdom_id\", %O);\n", env->query("kingdom_id"));
  str += sprintf("\tset(\"no_back\", %O);\n", env->query("no_back"));
  str += sprintf("\tset(\"no_teleport\", %O);\n", env->query("no_teleport"));
  str += sprintf("\tset(\"dark\", %O);\n", env->query("dark"));
  str += sprintf("\tset(\"no_fight\", %O);\n", env->query("no_fight"));
  str += sprintf("\tset(\"no_recall\", %O);\n", env->query("no_recall"));
  // str += sprintf("\tset(\"no_quit\", %O);\n", env->query("no_quit"));
  str += sprintf("\tset(\"gate\",%O);\n", env->query("gate"));
  str += sprintf("\tset(\"outdoors\", %O);\n", env->query("outdoors"));
  pp = env->query("exits");
  if (sizeof(pp) >= 1) str += sprintf("\tset(\"exits\",%O);\n", pp);
  if (sizeof(env->query("link")) >= 1) str += sprintf("\tset(\"link\",%O);\n", env->query("link"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) == -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
    a = sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }

  prop = env->query("item_desc");

  if (sizeof(prop) != 0) {
    str += sprintf("\tset(\"item_desc\", ([%s", "/* sizeof() == " + sizeof(prop) + " */\n");
    for (i = 0; i < sizeof(prop); i++) {
      str += sprintf(
        "%s",
        "  \"" + (string)keys(prop)[i] + "\" : @DESC\n" + (string)values(prop)[i] + "\nDESC,\n"
      );
    }
    str += "]));\n";
  }
  str += "\n\tsetup();\n";
  if (env->query("type") == "board") {
    str += sprintf(
      "\tcall_other(\"/open/%s/%s_b2.c\", \"???\");\n",
      me->query("kingdom"),
      me->query("kingdom")
    );
  }

  str += "}\n";
  // Replace current directory with __DIR__ macro to make relocatable code.
  i = strlen(file_name(env)) - 1;

  while ((i > 0) && (file_name(env)[i] != '/')) i--;
  if (i > 0) {
    str = replace_string(str, "\"" + file_name(env)[0..i], "__DIR__\"");
  }
  seteuid(getuid());
  if (!flag) rm(this_file);
  else rm(flag);
  if (!flag) {
    if (write_file(this_file, str)) {
      tell_object(me, HIY "房间储存完毕。\n" NOR);
      "/cmds/app/update"->main(me, base_name(environment(me)));

      return 1;
    }
    return notify_fail("你没有写入这个档案的权利。\n");
  } else {
    if (write_file(flag, str)) {
      return 1;
    }
  }
  return notify_fail("你没有写入这个档案的权利。");
}

int help(object me) {
  write(@HELP
指令格式 : saveroom

这是帮主与长老用来开发领土的指令。这个指令可以储存目前房间的一切设
定, 当你把房间设好后请务必记得 saveroom。如果你想把不需要的房间删除，
可以用 delete_room 指令。

HELP);
  return 1;
}
