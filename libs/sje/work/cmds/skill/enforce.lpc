// enforce.c 
// by windson Aug 2001

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts;

  if (!arg || (arg != "none" && arg != "max" && arg != "MAX" && !sscanf(arg, "%d", pts)))
    return notify_fail("指令格式：enforce|jiali <使出几点内力伤敌>|none|max\n");

  if (!me->query_skill_mapped("force"))
    return notify_fail("你必须先 enable 一种内功。\n");

  if (arg == "none")
    me->delete("jiali");
  else if (arg == "max" || arg == "MAX") {
    pts = (int)me->query_skill("force") / 2;
    if (pts > 200) pts = 200;
  } else {
    if (pts < 0 || pts > (int)me->query_skill("force") / 2)
      return notify_fail("你只能用 none 表示不运内力，或数字表示每一击用几点内力。\n");
    if (pts > 200)
      return notify_fail("你最大只能使用200点内力攻敌。\n");

  }

  me->set("jiali", pts);
  if (pts)
    write("你决定用" + chinese_number(pts) + "点的内力伤敌。\n");
  else
    write("你决定不使用内力伤敌。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: enforce|jiali <使出几点内力伤敌>|none
 
这个指令让你指定每次击中敌人时，要发出几点内力伤敌。

enforce max  则表示你使用最大内力。
enforce none 则表示你不使用内力。 

See Also: enable
HELP
  );
  return 1;
}
