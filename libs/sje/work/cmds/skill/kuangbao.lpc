#include <ansi.h>
#include <skill.h>
inherit F_CLEAN_UP;

int main() {
  object me = this_player();
  string msg;
  int dex, str, force;

  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");

  //        if( !me->is_fighting() )
  //                return notify_fail("「狂暴」只能在战斗中使用。\n");

  if ((int)me->query_skill("force", 1) < 250)
    return notify_fail("你的内功的修为不够, 不能使用「狂暴」 !\n");

  if ((int)me->query("neili") < 4000)
    return notify_fail("你的真气不够！\n");

  if (me->query_condition("kuangbao"))
    return notify_fail("你正在使用「狂暴」。\n");

  str = me->query("str") * 5;

  if (str > 100) str = 100;


  dex = me->query("dex") * 4;

  if (dex > 100) dex = 100;

  msg = RED "$N聚气丹田，忽然逆运内功，将真气游走全身，顿时走火入魔！\n\n" NOR;

  me->set("qi", me->query("max_qi") * 2);

  me->add("max_neili", -10);

  me->add_temp("apply/strength", str);

  me->add_temp("apply/dexerity", dex);

  me->add_temp("apply/armor", 1000 + random(1000));

  me->apply_condition("kuangbao", me->query_skill("force", 1) / 10);

  call_out("remove_effect_kb", me->query_skill("force", 1) / 100, me);

  message_vision(msg, me);

  me->start_busy(random(2));

  me->add_temp("apply/per", -10);

  return 1;
}

int remove_effect_kb(object me) {
  string msg;

  if (!me) {
    return 1;
  }

  me->set_temp("last_damage_from", "真气逆行走火入魔");
  msg = RED "$N全身布满鲜血，筋肉爆出，样貌及其恐怖，但是力量和身法确是增长了好几倍！\n\n" NOR;
  me->set_temp("apply/short", ({ me->name() + "(" + me->query("id") + ")" RED " <真气逆行 狂暴> " NOR }));
  message_vision(msg, me);


  call_out("remove_effect_kb1", me->query_skill("force", 1), me);
  return 1;
}

int remove_effect_kb1(object me) {
  string msg;

  if (!me) {
    return 1;
  }
  me->set_temp("apply/short", ({ me->name() + "(" + me->query("id") + ")" NOR }));
  me->set_temp("apply/dexerity", 0);
  me->set_temp("apply/strength", 0);

  return 1;
}

int help(object me) {
  write(@HELP
狂暴        
这个指令让你逆行真气，攻击力大大增强，但是持续时间中会减少
精和气，过了作用时间就会死。同时减少少量最大内力，是拼命的招数。
 
HELP
  );
  return 1;
}
