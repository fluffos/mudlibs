// chongxue.c 冲穴
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me)
{
        if (me->query_skill("bihai-chaosheng",1)<180)
                return notify_fail("你的碧海潮生功等级不够。\n");
        if (me->query_skill("tanzhi-shentong",1)<200)
                return notify_fail("你的弹指神通不够熟练，对穴道认知不够。\n");
        if (!me->is_busy())
                return notify_fail("你现在又不忙。\n");
        if (me->query_temp("chongxue"))
                return notify_fail("你刚刚用过冲穴，小心走火入魔。\n");

        message_vision(HIB"$N运起碧海潮生功，将内息硬是在身上奇经八脉快速运转！\n",me);
        message_vision(HIB"$N提气使出弹指神通，伸出左手食指向内息受阻处一戳！\n",me);
        if (random(me->query_skill("bihai-chaosheng",1))<50)
        {
                message_vision(HIR"结果$N真气走岔，满脸通红，似乎受了内伤。\n"NOR,me);
                me->add("neili",-random(200));
                me->receive_wound("qi",random(100));
                me->set_temp("chongxue",1);
                call_out("remove_effect",random(20)+15, me);
        } else {
        message_vision(HIW"$N神定气闲，不再手忙脚乱，内息也恢复正常。\n"NOR,me);
        me->interrupt_me();
        me->start_busy(1,2);
        me->interrupt_me();
        me->set_temp("chongxue",1);
        call_out("remove_effect",random(10)+10, me);
        }
        return 1;
}
void remove_effect(object me)
{
        me->delete_temp("chongxue");
        message_vision(HIY"$N长长地舒了一口气。\n"NOR,me);
}
