// Created by Keinxin@Sj2
// New Core For Gem System
// May.28,2003 

#include <ansi.h>
#include <skill.h>
inherit F_CLEAN_UP;

int main(object target,string effect)
{
        object me = this_player();
        object weapon;
        string msg,tar;
        int dex, str, fme, ftar, j;
        int f_damage,l_damage,c_damage,p_damage,z_damage;

        if(!effect)
                return notify_fail("你要做什么特殊攻击？\n");

        if(me->is_busy())
                return notify_fail("你现在正忙着呢！\n");
                
        if( sscanf(effect,"%s %s",tar,effect)!=2 )
                return notify_fail("指令格式: fang <目标> <特殊攻击>\n");                

        if (!objectp(weapon = me->query_temp("weapon"))
        || weapon->query("ke_w/special_ke") < 1)
                return notify_fail("开什么玩笑，没有特殊武器能激发特殊攻击？\n");

        target = present(tar,environment(me));
        if (!target
        ||  environment(target)!=environment(me))
                return notify_fail("对谁放特殊攻击？\n");    
    
        if( !me->is_fighting() )
                return notify_fail("只能在战斗中使用。\n");  
    
        if( (int)me->query("neili") < 500 )
                return notify_fail("你的真气不够！\n");

        if (me->query_temp("fang"))
                return notify_fail("你刚点使用了特殊攻击，先休息一下吧。\n");
        
        dex = target->query_dex();
        str = target->query_str();
        fme = me->query_skill("force");
        ftar = target->query_skill("force");
        
        
//Define Damage Type and Amount

       f_damage = weapon->query("ke_w/max_f_damage")*fme+random(1000);
       l_damage = weapon->query("ke_w/max_l_damage")*fme+random(1000);
       c_damage = weapon->query("ke_w/max_c_damage")*fme+random(1000);
       p_damage = weapon->query("ke_w/max_p_damage")*fme+random(1000);
       z_damage = weapon->query("ke_w/max_z_damage")*fme+random(1000);
       



        if (effect == "huoyun")
        {
                if (weapon->query("ke_w/huoyun")<1)
                        return notify_fail("你的"+weapon->query("name")+"没有火云能量。\n");
                msg = HIR "$N降手中"+weapon->query("name")+""HIR"一抖，"+weapon->query("name")+""HIR"吐出一团烈焰，火光顿时将$n包围！\n" NOR;
                
                if (weapon->query("ke_w/max_f_damage")>4)
                msg += HIR "\n\n天空中突然出现一个巨大的火神祝融的幻象！\n\n" NOR;
                
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，才跳出了火焰的包围。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，全身已经被火焰灼伤。\n" NOR;
                        target->receive_damage("qi",f_damage);
          	        target->receive_wound("qi",f_damage);
          	        target->start_busy(2);
          	        target->apply_condition("hyd_condition", f_damage/100 + 1 +
			target->query_condition("hyd_condition"));
			weapon->add("ke_w/huoyun",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_f_damage")*2 , me);
        }

        if (effect == "jinglei")
        {
                if (weapon->query("ke_w/jinglei")<1)
                        return notify_fail("你的"+weapon->query("name")+"没有惊雷能量。\n");
                msg = HIY "$N降手中"+weapon->query("name")+""HIY"一抖，"+weapon->query("name")+""HIY"换化做一道雷电射向$n！\n" NOR;
                
                if (weapon->query("ke_w/max_l_damage")>4)
                msg += HIY "\n\n天空中突然出现一个巨大的雷公的幻象！\n\n" NOR;  
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了闪电。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被雷电击中。\n" NOR;
                        target->receive_damage("qi",l_damage);
          	        target->receive_wound("qi",l_damage);
          	        target->start_busy(weapon->query("ke_w/max_l_damage")+3);
			weapon->add("ke_w/jinglei",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_l_damage")*2 , me);
        }        
        
        if (effect == "bingshuang")
        {
                if (weapon->query("ke_w/bingshuang")<1)
                        return notify_fail("你的"+weapon->query("name")+"没有冰霜能量。\n");
                msg = HIC "$N降手中"+weapon->query("name")+""HIC"一抖，"+weapon->query("name")+""HIC"换化做一阵暴风雪袭向$n！\n" NOR;
                
                if (weapon->query("ke_w/max_l_damage")>4)
                msg += HIC "\n\n突然间天地好像冰封了一般！！\n\n" NOR;                  
                
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了冰雪的袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下淹没在冰雪中。\n" NOR;
                        target->receive_damage("qi",c_damage);
          	        target->receive_wound("qi",c_damage);
          	        target->start_busy(weapon->query("ke_w/max_c_damage")+1);
          	        target->apply_condition("cold_poison", c_damage/100 + 1 +
			target->query_condition("cold_poison"));          	        
			weapon->add("ke_w/bingshuang",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_c_damage")*2 , me);
        }                
        
        if (effect == "yinglv")
        {
                if (weapon->query("ke_w/yinglv")<1)
                        return notify_fail("你的"+weapon->query("name")+"没有莹绿能量。\n");
                        
                switch (weapon->query("ke_w/max_p_damage")){        
                
                case 8:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做一具腐尸袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了腐尸毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("fs_poison", p_damage/100 + 1 +
			target->query_condition("fs_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;
               
                case 7:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做一条怪蛇袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了怪蛇毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("bt_poison", p_damage/100 + 1 +
			target->query_condition("bt_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;               
                
                case 6:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做七虫七花袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了七虫七花毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("qichong_poison", p_damage/100 + 1 +
			target->query_condition("qichong_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;                 
                
                case 5:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做蔓陀萝袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/4)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了蔓陀萝毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("man_poison", p_damage/100 + 1 +
			target->query_condition("man_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;                
                
                case 4:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做神龙袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/4)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了神龙毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("sl_poison", p_damage/100 + 1 +
			target->query_condition("sl_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;      
                
                case 3:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做蟾蜍袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/4)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了蟾蜍毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("chanchu_poison", p_damage/100 + 1 +
			target->query_condition("chanchu_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;              
                
                case 2:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做一阵冰气袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/4)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了寒毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("hb_poison", p_damage/100 + 1 +
			target->query_condition("hb_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;                   
                
                case 1:        
                msg = HIG "$N降手中"+weapon->query("name")+""HIG"一抖，"+weapon->query("name")+""HIG"换化做一条毒蛇袭向$n！\n" NOR;                                 
                if (random(fme)<ftar/4)
                        msg += HIW "$n赶紧纵身一越，多过了袭击。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被击中，中了蛇毒。\n" NOR;
                        target->receive_damage("qi",p_damage);
          	        target->receive_wound("qi",p_damage);
          	        target->start_busy(1);
          	        target->apply_condition("snake_poison", p_damage/100 + 1 +
			target->query_condition("snake_poison"));          	        
			weapon->add("ke_w/yinglv",-1);
                }
                message_vision(msg, me, target);
                call_out("remove_effect_all",weapon->query("max_p_damage")*2 , me);
                break;                                                                                 
                
               } 
               }
               
        if (effect == "zidian")
        {
                if (weapon->query("ke_w/zidian")<1)
                        return notify_fail("你的"+weapon->query("name")+"没有紫电能量。\n");
                msg = HIM "$N降手中"+weapon->query("name")+""HIM"一抖，"+weapon->query("name")+""HIM"换化做一道紫电射向$n！\n" NOR;
                
                if (weapon->query("ke_w/max_z_damage")>4)
                msg += HIM "\n\n天空中突然出现一个巨大的雷公的幻象！\n\n" NOR;  
                
                if (random(fme)<ftar/6)
                        msg += HIW "$n赶紧纵身一越，多过了紫电。\n" NOR;
                else
                {
                        msg += RED "$n躲闪不及，一下被紫电击中。\n" NOR;
                        target->receive_damage("qi",z_damage);
          	        target->receive_wound("qi",z_damage);
          	        target->start_busy(weapon->query("ke_w/max_z_damage")+3);
			weapon->add("ke_w/zidian",-1);
                }                

                message_vision(msg, me, target);

 
                                
                call_out("remove_effect_all",weapon->query("max_z_damage")*2 , me);
        }                
               
                               


        else return notify_fail("没有这种攻击！\n");

        me->start_busy(1);

        return 1;
}


void remove_effect_all(object me)
{
        if (!me) return;
        me->delete_temp("fang");
        tell_object(me, HIG"\n你经过一段时间修心养性，又可以再使用特殊攻击了。\n"NOR);
}

int help (object me)
{
        write(@HELP
指令格式: fang <目标> <特殊攻击>
 
这个指令让你向目标发动特殊攻击。

HELP
        );
        return 1;
}