// quanjia.c

#include <ansi.h>
private int remove_eff(object me, object victim);
int main(object me, string arg)
{
        string who;
        object victim;
        int sp, dp;
        object where = environment(me);
        if ( me->query("family/family_name") != "峨嵋派" )
                return notify_fail("只有峨嵋派才能用渡世济人！\n");
                
        if( me->query_temp("quanjia") > uptime() ) 
                return notify_fail("你刚刚劝完人家，佛性需要一段时间才能恢复。\n");
//        if( me->query_temp("quanjia") )
//                return notify_fail("你已经在劝人家罢斗了！\n");
        
        if( me->is_busy())
               return notify_fail("你正忙着呢！\n");
               
        if( !arg || sscanf(arg, "%s", who)!=1 )
                return notify_fail("指令格式：quan <人物ID>\n");
        
        if( (int)me->query_skill("dacheng-fofa", 1) < 30 )
               return notify_fail("你对大乘佛法渡世济人的精髓领悟不够，无法劝架。\n");
                
        victim = present(who, where);
        if( !victim || victim == me) return notify_fail("你想找的对象不在这里。\n");
        if( !living(victim) || !victim->query("can_speak"))
                return notify_fail("你要劝谁罢斗？\n");
/*                
        if ( victim->query("family/family_name") == "峨嵋派" )
                return notify_fail("你不能向本派的使用渡世济人！\n");
*/                
        if( !wizardp(me) && wizardp(victim) )
                return notify_fail("玩家不能劝巫师罢斗。\n");
                
        if (!victim->is_fighting())
                return notify_fail(victim->name()+"并没有和人争斗。\n");
                
       if( victim->query_temp("get_quan"))
               return notify_fail("人家刚听完你劝，你想再劝估计人家不会听你的了。\n");

  if(victim->query_temp("combat_yield"))
return notify_fail(victim->name()+"打不还手，你还劝什么劲呀?\n");
        if( me->is_fighting() )
                return notify_fail("一边打架一边劝别人罢斗？你真是虚伪到家了！\n");
                
               
        sp = (int)me->query("combat_exp",1);
        if( sp < 1 ) sp = 1;
        dp = (int)victim->query("combat_exp",1);                                    
        if( dp < 1 ) dp = 1;
        
        tell_object(me, HIY"你摇摇了头，向" + victim->name() + "走过去，双手合十，说道：两位休得伤了和气，不要再斗下去了吧！\n\n"NOR);
        tell_object(victim, HIY+me->name() + "向你慢慢走过来，双手合十，说道：我佛慈悲普度渡众生, 还请"
                + RANK_D->query_respect(victim) + "罢斗, 免增罪孽吧 ！\n\n"NOR);

        tell_room(where, HIY"只见" + me->name() + "慢慢地向" 
                + victim->name() + "走过去，\n双手合十，说道: 请"
                + "两位休得伤了和气，不要再斗下去了吧！\n\n"NOR, ({ me, victim }) );

        me->set_temp("quanjia", uptime()+200);
        me->start_busy(3);
        call_out( "compelete_quanjia", 3, me, victim, where, sp, dp);
        return 1;
}

private void compelete_quanjia(object me, object victim, object where, int sp, int dp)
{
        int my_exp,ob_exp,get_exp;
        my_exp=(int)me->query("combat_exp",1);
        ob_exp=(int)victim->query("combat_exp",1);
        get_exp=(ob_exp-my_exp)/5000;
        
//        me->delete_temp("quanjia");
        
        if( !victim || environment(victim) != where ) 
        {
                tell_object(me, "太可惜了，你要劝的人已经走了。\n");
                return;
        }

        if (!victim->is_fighting()) 
        {
                tell_object(me, victim->name()+"已经停手了！");
                return;
        }
                                 
        if (!living(victim))
        {
               tell_object(me,victim->name()+"已经死了，不能劝了！\n");
               return;
        }

       if( sp > dp )
       {
               if( random((int)me->query("per")) >= 10 )
               {
                       victim->remove_all_killer();
                       message_vision("$n受到$N的佛法感招，决定罢手不斗。\n", me, victim);
                       message_vision(HIY"只见$n往后一纵，说道：好！$N良言相劝，暂且罢手。\n"NOR, me, victim);
                       victim->set_temp("get_quan", 1);        
                       call_out("remove_eff", 15+random(5), me, victim);
                       if (sp < (dp+50000) )                                       
                       {
                               me->improve_skill("dacheng-fofa", random(me->query("int"))+random(me->query("per")));                    
                               me->add("combat_exp", random((int)me->query_per())+(int)me->query_skill("dacheng-fofa", 1)/15);               
                               me->start_busy(1);
                       }            
                       else if (sp < (dp+100000) )    
                       {
                               me->start_busy(1);
                               me->add("combat_exp",random((int)me->query("per")));
                       }                          
                       else    me->start_busy(1);
                       return;
               }               
                else
                {
                       if( victim->query("shen") > 0 )
                       {
                               switch(random(3)) 
                               {
                                       case 0:
                                               message_vision(HIY"只见$n对着$N不屑地撇撇嘴：哪凉快哪待着去，少管闲事！\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               break;
                                       case 1:
                                               message_vision(CYN"$n对$N理都不理！\n"NOR, me, victim);                                
                                               me->start_busy(2);
                                               break;
                                       case 2:
                                               message_vision(HIY"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->kill_ob(me);                            
                                               break; 
                               }
                       }
                       else 
                       {
                               switch(random(4))
                               {
                                       case 0:
                                               message_vision(HIY"只见$n对着$N不屑地撇撇嘴：哪凉快哪待着去，少管闲事！\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               break;
                                       case 1:
                                               message_vision(CYN"$n对$N理都不理！\n"NOR, me, victim);                                
                                               me->start_busy(2);
                                               break;
                                       case 2:
                                               message_vision(HIY"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->kill_ob(me);                            
                                               break; 
                                       case 3:
                                               message_vision(HIR"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->fight_ob(me);
                                               break;            
                               }
                       }
                       return;
               }
        }      
       if( sp < dp )
       {
               if( random( (int)me->query_per() ) >= 23 )               
               {
                       victim->remove_all_killer();
                       tell_object(me, victim->name()+"受到你的佛法感招，决定罢手不斗。\n");
                       message_vision(HIY"只见$n往后一纵，说道：好！$N良言相劝，暂且罢手。\n"NOR, me, victim);

                       call_out("remove_eff", 15+random(5), me, victim);                       
                       victim->set_temp("get_quan", 1);                        
                       me->start_busy(2);                      
                       if (get_exp>0) 
                       {
                               if (get_exp<1) 
                                    get_exp=1; 
                               if (( sp+100000) > dp )
                               {
                                       me->add("combat_exp",get_exp);
                                       me->improve_skill("dacheng-fofa", me->query("per"));                                     
                               }
                               else
                               {
                                       me->add("combat_exp", random((int)me->query_per())+(int)me->query_skill("dacheng-fofa", 1)/15);               
                                       me->improve_skill("dacheng-fofa", random(me->query("per")));                                         
                               }
                       }
                       return;
               }
                else
                {
                       if( victim->query("shen") > 0 )
                       {
                               switch(random(3)) 
                               {
                                       case 0:
                                               message_vision(HIY"只见$n对着$N不屑地撇撇嘴：哪凉快哪待着去，少管闲事！\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               break;
                                       case 1:
                                               message_vision(CYN"$n对$N理都不理！\n"NOR, me, victim);                                
                                               me->start_busy(2);
                                               break;
                                       case 2:
                                               message_vision(HIR"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->fight_ob(me);
                                               break; 
                               }
                       }
                       else 
                       {
                               switch(random(4))
                               {
                                       case 0:
                                               message_vision(HIY"只见$n对着$N不屑地撇撇嘴：哪凉快哪待着去，少管闲事！\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               break;
                                       case 1:
                                               message_vision(CYN"$n对$N理都不理！\n"NOR, me, victim);                                
                                               me->start_busy(2);
                                               break;
                                       case 2:
                                               message_vision(HIY"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->kill_ob(me);                            
                                               break; 
                                       case 3:
                                               message_vision(HIR"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
                                               me->start_busy(2);                              
                                               victim->fight_ob(me);
                                               break;            
                               }
                       }
                       return;
               }
               
        }        

}                                                                        

private int remove_eff(object me, object victim)
{
       if(interactive(victim))
       victim->delete_temp("get_quan");
       return 1;
}

int help(object me)
{
write(@HELP
指令格式 : quan <某人> 

HELP
        );
        return 1;
}
