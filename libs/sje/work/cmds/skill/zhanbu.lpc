// zhanbu.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str)
{
        object ob, where;
        mapping fam;
        string env;

        if (!str) return notify_fail("指令格式：zhanbu <人物>\n"); 
        if( me->is_busy()) return notify_fail("你正忙着呢。\n");
        if( me->query("id") == str )
           return notify_fail("你自己好端端的，还是发烧了？\n");
        fam = me->query("family");
        if( ! fam || fam["family_name"] != "桃花岛" )
           return notify_fail("你不是桃花岛弟子，未得黄药师真传，如何能够占卜？\n");
        message_vision(HIG"$N捏着手指，按照子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥的方位，仔细的掐算着。。。\n"NOR, me);
        me->start_busy(10);
        ob = find_player(str);
        if( !ob ) ob = find_living(str);
        if( !ob || !me->visible(ob)) return notify_fail("现在没这个人。\n");
        if ( userp(ob) && wiz_level(ob))
             return notify_fail("你没有办法知道巫师的位置。\n");
        where = environment(ob);
        if (!where) return notify_fail(HIW"这个人不知道在那里耶...\n"NOR);
        if( present("tie bagua", me) && (int)me->query_skill("qimen-bagua", 1) > 100 ) {
                if((int)me->query_skill("qimen-bagua",1) - (int)ob->query_skill("qimen-bagua",1) < 60)
                        tell_object(ob, HIY"冥冥中你觉得好象有人正在窥探你所在的方位。\n"NOR);
                env = where->query("indoors");
                if (!env) env = where->query("outdoors");
                if (!is_chinese(env)) env = "";
                env += where->query("short");
                write(sprintf(HIW"你掐指算出%s(%s)现在好象在%s"HIW"一带活动。\n"NOR,
                        (string)ob->name(1),
                        capitalize((string)ob->query("id")),
                        env));
                me->add("jingli", -100 + random(100));
                return 1;
        }
        else { 
                write(HIY"你费了半天的力气，就是占卜不出"+ob->name(1)+"的位置。\n"NOR);
                me->add("jingli", - 50);
                return 1;
        }
}

