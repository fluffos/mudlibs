#include <ansi.h>
#include <skill.h>
inherit F_CLEAN_UP;

int main()
{
        object me = this_player();
        string msg;
        
        if( !me->is_fighting() )
                return notify_fail("没有人打你，跑什么啊？\n");
                
        if( me->query("zhuansheng")<1 )
                return notify_fail("你没有学会神行千里！\n");        

        if((int)me->query("combat_exp") > 3000000)
                return notify_fail("你已经用不着神行千里了！\n");

        message_vision(HIY "$N施展神行千里，脚下生风，突然跑的无影无踪了。\n"NOR, me);
        me->move("/d/wizard/guest_room");


        return 1;
}


int help(object me)
{
        write(@HELP
神行千里        
转生ID专用，可以迅速离开战场。
这个指令在exp>3m以后无效。
 
HELP
        );
        return 1;
}

