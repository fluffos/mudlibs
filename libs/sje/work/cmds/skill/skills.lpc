string *knowledge_level_desc = ({
  BLU "新学乍用" NOR,
  HIB "初窥门径" NOR,
  MAG "略知一二" NOR,
  HIM "半生不熟" NOR,
  CYN "马马虎虎" NOR,
  YEL "已有小成" NOR,
  YEL "融会贯通" NOR,
  HIY "心领神会" NOR,
  HIY "了然於胸" NOR,
  HIG "已有大成" NOR,
  HIG "非同凡响" NOR,
  HIC "举世无双" NOR,
  HIC "震古铄今" NOR,
  HIW "无与伦比" NOR,
  HIW "超凡入圣" NOR,
  HIR "空前绝后" NOR
});

string skill_level(string, int);

int main(object me, string arg) {
  object ob, *list, couple_ob, jiebai_ob;
  mapping skl, lrn, map;
  string *sname, *mapped, target, cardname, *k_skill, str;
  int i, j, m, marry_flag, sk_lvl, sk_lrn;

  seteuid(getuid());

  if (arg == "?") {
    write("知识的描述由低到高依次为：\n\n");
    for (j = 0; j < sizeof(knowledge_level_desc); j++) {
      if (j > 0 && j - (j / 4) * 4 == 0)
        write("\n");
      write("\t" + knowledge_level_desc[j]);
    }
    write("\n\n");
    write("技能的描述由低到高依次为：\n\n");
    for (j = 0; j < sizeof(skill_level_desc); j++) {
      if (j > 0 && j - (j / 5) * 5 == 0)
        write("\n");
      write("\t" + skill_level_desc[j]);
    }
    write("\n");
    return 1;
  }
  if (!arg)
    ob = me;

  else {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = LOGIN_D->find_body(arg);
    if (!ob || !me->visible(ob))
      return notify_fail("你要察看谁的技能？\n");
  }
  if (stringp(me->query("jiebai"))
    && strsrch(me->query("jiebai"), arg + ">") >= 0) {
    if (!wizardp(me) && me->query("cha_jiebai")
      && time() - me->query("cha_jiebai") < 600)
      return notify_fail("你刚查完你的结义金兰的技能，过一会儿再查吧。\n");
    jiebai_ob = find_player(arg);
    me->set("cha_jiebai", time());
  }
  target = (string)me->query("marry/id");
  if (stringp(target)) couple_ob = find_player(target);
  if (ob != me && !wizardp(me) && !ob->is_apprentice_of(me)
    && !me->is_apprentice_of(ob) && ob != couple_ob
    && !ob->query("skill_public") && ob != jiebai_ob)
    return notify_fail("只有管理或有师徒关系的人能察看他人的技能。\n");

  skl = ob->query_skills();

  if (ob == me) str = "你";
  else if (ob == couple_ob) str = "你的爱人" + ob->name();
  else if (ob == jiebai_ob) str = "你的结义金兰" + ob->name();
  else str = ob->name();

  if (!sizeof(skl)) {
    write((ob == me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
    return 1;
  }

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  write(HIW "【" + str + "的技能表】" NOR);
  write("总共" + chinese_number(sizeof(skl)) + "项技能\n");
  write("┌────────────────────────────────────────────┐\n");

  sname = sort_array(keys(skl), (: strcmp :));

  k_skill = filter_array(sname, "is_knowledge");

  if (sizeof(k_skill) > 0) {
    printf("│%-40s%-61s│\n", HIY "『知识 "
      +chinese_number(sizeof(k_skill)) + " 种』：" NOR, " ");
    write("│");

    for (i = 0; i < sizeof(k_skill); i++) {
      if (i > 0 && i - (i / 2) * 2 == 0)
        printf("│\n│");
      if (!wizardp(me) && ob == jiebai_ob) {
        sk_lvl = skl[k_skill[i]] / 2 + random(skl[k_skill[i]] / 2);
        sk_lrn = lrn[k_skill[i]] / 2 + random(lrn[k_skill[i]] / 2);
      } else {
        sk_lvl = skl[k_skill[i]];
        sk_lrn = lrn[k_skill[i]];
      }
      printf("%-20s" NOR " →%-10s %3d/%6d ",
        to_chinese(k_skill[i]) + " (" + k_skill[i] + ")",
        skill_level("knowledge", sk_lvl),
        //                              skl[k_skill[i]], (int)lrn[k_skill[i]]
        sk_lvl, (int)sk_lrn,
      );
      if (i == 0 || i - (i / 2) * 2 == 0)
        printf("  ");
    }
    if (i - (i / 2) * 2 != 0)
      printf("%-43s│\n", " ");
    else printf("│\n");
    printf("├────────────────────────────────────────────┤\n");
  }
  k_skill = filter_array(sname, "is_other");
  if (sizeof(k_skill) > 0) {
    printf("│%-40s%-61s│\n", HIY "『杂项 "
      +chinese_number(sizeof(k_skill)) + " 种』：" NOR, " ");
    write("│");

    for (i = 0; i < sizeof(k_skill); i++) {
      if (i > 0 && i - (i / 2) * 2 == 0)
        printf("│\n│");
      if (!wizardp(me) && ob == jiebai_ob) {
        sk_lvl = skl[k_skill[i]] / 2 + random(skl[k_skill[i]] / 2);
        sk_lrn = lrn[k_skill[i]] / 2 + random(lrn[k_skill[i]] / 2);
      } else {
        sk_lvl = skl[k_skill[i]];
        sk_lrn = lrn[k_skill[i]];
      }
      printf("%-20s" NOR " →%-10s %3d/%6d ",
        to_chinese(k_skill[i]) + " (" + k_skill[i] + ")",
        skill_level("knowledge", sk_lvl),
        sk_lvl, (int)sk_lrn,
      );
      if (i == 0 || i - (i / 2) * 2 == 0)
        printf("  ");
    }
    if (i - (i / 2) * 2 != 0)
      printf("%-43s│\n", " ");
    else printf("│\n");
    printf("├────────────────────────────────────────────┤\n");
  }
  k_skill = filter_array(sname, "is_normalskill");
  if (sizeof(k_skill) > 0) {
    printf("│%-40s%-61s│\n", HIY "『基本 "
      +chinese_number(sizeof(k_skill)) + " 种』：" NOR, " ");
    write("│");

    for (i = 0; i < sizeof(k_skill); i++) {
      if (i > 0 && i - (i / 2) * 2 == 0)
        printf("│\n│");
      if (!wizardp(me) && ob == jiebai_ob) {
        sk_lvl = skl[k_skill[i]] / 2 + random(skl[k_skill[i]] / 2);
        sk_lrn = lrn[k_skill[i]] / 2 + random(lrn[k_skill[i]] / 2);
      } else {
        sk_lvl = skl[k_skill[i]];
        sk_lrn = lrn[k_skill[i]];
      }
      printf("%-20s" NOR " →%-10s %3d/%6d ",
        to_chinese(k_skill[i]) + " (" + k_skill[i] + ")",
        skill_level("", sk_lvl),
        sk_lvl, (int)sk_lrn,
      );
      if (i == 0 || i - (i / 2) * 2 == 0)
        printf("  ");
    }
    if (i - (i / 2) * 2 != 0)
      printf("%-43s│\n", " ");
    else printf("│\n");
    printf("├────────────────────────────────────────────┤\n");
  }

  k_skill = filter_array(sname, "is_specialskill");
  if (sizeof(k_skill) > 0) {
    printf("│%-40s%-61s│\n", HIY "『武功 "
      +chinese_number(sizeof(k_skill)) + " 种』：" NOR, " ");
    //                write("│");

    for (i = 0; i < sizeof(k_skill); i++) {
      printf("│");
      if (!wizardp(me) && ob == jiebai_ob) {
        sk_lvl = skl[k_skill[i]] / 2 + random(skl[k_skill[i]] / 2);
        sk_lrn = lrn[k_skill[i]] / 2 + random(lrn[k_skill[i]] / 2);
      } else {
        sk_lvl = skl[k_skill[i]];
        sk_lrn = lrn[k_skill[i]];
      }
      printf("%s%s%-40s" NOR " - %-10s %3d/%6d",
        (lrn[k_skill[i]] >= (skl[k_skill[i]] + 1) * (skl[k_skill[i]] + 1)) ? HIM : "",
        (member_array(k_skill[i], mapped) == -1 ? "  " : "□"),
        to_chinese(k_skill[i]) + " (" + k_skill[i] + ")",
        skill_level("", sk_lvl),
        sk_lvl, (int)sk_lrn,
      );
      printf("%-24s│\n", " ");
    }

    printf("└────────────────────────────────────────────┘\n");
  }
  return 1;
}

string skill_level(string type, int level) {
  int grade;

  switch (type) {
    case "knowledge":
      grade = level / 20;
      if (grade >= sizeof(knowledge_level_desc))
        grade = sizeof(knowledge_level_desc) - 1;
      return knowledge_level_desc[grade];
    default:
      grade = level / 8;
      if (grade >= sizeof(skill_level_desc))
        grade = sizeof(skill_level_desc) - 1;
      return skill_level_desc[grade];
  }
}
int help(object me) {
  write(@HELP
指令格式 : skills [<某人>] skills ?

这个指令可以让你查询所学过的技能。

你可以指定一个和你有师徒关系或者婚姻关系的对象，用 skills 可以查知对方的技能状况。

你也可以指定一个和你有结拜关系的对象，但这时所反应的技能等级只是一个参考，并不是
对方真正的水平。并且，每隔十分钟你才能使用一次。

skills ? 可以让你查知【烟台站】的所有武功及知识的描述。

HELP
  );
  return 1;
}
