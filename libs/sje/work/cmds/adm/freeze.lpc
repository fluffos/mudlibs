// Freeze.C
// Create By Yixian
// 冻结帐号用

#include <ansi.h>
#define FREEZE_DIR      "/open/freeze_list"

int help(object ob);
int main(object ob, string arg) {
  string *freeze, id;
  object player;
  int t, i;
  t = file_size(FREEZE_DIR);
  if (t >= 1) freeze = filter_array(explode(read_file(FREEZE_DIR), "\n"), (: $1 != "\n" :));

  if (!arg) {
    write("现在已经冻结的帐号有：\n");
    i = sizeof(freeze);
    while (i--) {
      printf("帐号：「%10s」\n", capitalize(freeze[i]));
    }
    return 1;
  }
  if (sscanf(arg, "-a %s", id) == 1) {
    if (file_size("/data/user/" + id[0..0] + "/" + id + ".o") < 1)
      return notify_fail("系统中没有这个玩家的档案。\n");
    write_file(FREEZE_DIR, id + "\n");
    write("成功的将「" + capitalize(id) + "」加入到Freeze 列表中。\n");
    assure_file("/log/user/freeze_list");
    CHANNEL_D->do_channel(this_player(), "sys", sprintf(NOR "巫师%20s冻结「%s」于%s。\n",
      ob->query("name") + "(" + ob->query("id") + ")",
      id,
      ctime(time())
    ));
    log_file("user/freeze_list",
      sprintf("巫师%20s冻结「%s」于%s。\n",
        ob->query("name") + "(" + ob->query("id") + ")",
        id,
        ctime(time())
      ));
    return 1;
  }
  if (sscanf(arg, "-d %s", id) == 1) {
    if (!arrayp(freeze) || sizeof(freeze) < 1)
      return notify_fail("系统还没有设置需要冻结的帐号列表。\n");
    if (member_array(id, freeze) == -1)
      return notify_fail("系统的冻结帐号列表中没有这个玩家。\n");
    freeze -= ({ id });
    write("成功的将「" + capitalize(id) + "」从冻结列表中去除。\n");
    if (rm(FREEZE_DIR) != 1) error("Freeze 在rm freeze_list时出法，原因：无法 rm 文件。");
    if (sizeof(freeze) > 0) {
      for (i = 0; i < sizeof(freeze); i++) {
        write_file(FREEZE_DIR, freeze[i] + "\n");
      }
    }
    CHANNEL_D->do_channel(this_player(), "sys", sprintf(NOR "巫师%20s解除「%s」的冻结于%s。\n",
      ob->query("name") + "(" + ob->query("id") + ")",
      id,
      ctime(time())
    ));
    log_file("user/freeze_list",
      sprintf("巫师%20s解除「%s」的冻结于%s。\n",
        ob->query("name") + "(" + ob->query("id") + ")",
        id,
        ctime(time())
      ));
    return 1;
  }
  return help(ob);
}
int help(object ob) {
  write(@HELP
指　　令：      freeze          列出冻结列表
                freeze -a <id>  把某用户添加到冻结列表
                freeze -d <id>  把某用户从冻结列表中去除

注      ：      些命令同样能冻结巫师ID。(包括Admin)
HELP);
  return 1;
}
