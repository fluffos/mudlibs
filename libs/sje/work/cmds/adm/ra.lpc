//ra.c
// edit by xiaoyao

#include <ansi.h>

inherit F_CLEAN_UP;

int save_kingdom(object env);
string to_chinese(string);

string *special_props = ({
  "short", "long" });

int main(object me, string arg) {
  string kingdom_file, *ra, *bera;
  string newra = "", delra = "", listra = "";
  int i, point;

  seteuid(getuid(me));

  if (me->is_busy())
    return notify_fail("你的动作还没有完成\n");

  if (me->is_fight())
    return notify_fail("你现在在战斗中\n");

  ra = me->query("ra");
  if (!arg) {
    if (sizeof(ra)) {
      write("你发布了以下帮派灭帮的消息：\n");
      for (i = 0; i < sizeof(ra); i++)
        write("      " + to_chinese(ra[i]) + "(" + ra[i] + ")\n");
    } else
      write("你目前并没有发布任何帮派的灭帮。\n");
    return 1;
  }

  if (sscanf(arg, "cancel with %s", delra) == 1);
  else if (sscanf(arg, "with %s", newra) == 1);
  else if (sscanf(arg, "list %s", listra) == 1);
  else return notify_fail("指令格式：help ra \n");

  point = 0;
  if (sizeof(newra))
    point = 1;
  if (sizeof(listra))
    point = 2;

  if (file_size("/open/" + listra + "/") != -2 && point == 2)
    return notify_fail("没有这个帮派。\n");
  if (file_size("/open/" + newra + "/") != -2 && point == 1)
    return notify_fail("没有这个帮派。\n");
  if (file_size("/open/" + delra + "/") != -2 && point == 0)
    return notify_fail("没有这个帮派。\n");

  if (sizeof(ra)) {
    if (member_array(newra, ra) != -1 && point == 1)
      return notify_fail("你已经发布了" + to_chinese(newra) + "的进入灭帮的状态。\n");
    if (member_array(delra, ra) == -1 && point == 0)
      return notify_fail("你并没有发布" + to_chinese(delra) + "的进入灭帮的状态。\n");
  }

  if (point == 1) {
    kingdom_file = "/open/" + newra + "/kingdom";
    //    new(kingdom_file);
    bera = find_object(kingdom_file)->query("ra");

    if (!pointerp(bera))
      find_object(kingdom_file)->set("ra", ({ me->query("id") }));
    else if (member_array(me->query("id"), bera) == -1)
      find_object(kingdom_file)->set("ra", bera + ({ me->query("id") }));
    save_kingdom(find_object(kingdom_file));

    if (!pointerp(ra))
      me->set("ra", ({ newra }));
    else if (member_array(newra, ra) == -1)
      me->set("ra", ra + ({ newra }));
    me->save();
    me->setup();

    write("\n" + me->query("name") + HIW "宣布：正式启动" + to_chinese(newra) +
      "(" + newra + ")" + HIR "灭帮" HIW "状态。\n\n" NOR);
    shout("\n" + me->query("name") + HIW "宣布：正式启动" + to_chinese(newra) +
      "(" + newra + ")" + HIR "灭帮" HIW "状态。\n\n" NOR);
  } else if (point == 0) {
    kingdom_file = "/open/" + delra + "/kingdom";
    //    new(kingdom_file);
    bera = find_object(kingdom_file)->query("ra");

    find_object(kingdom_file)->set("ra", bera - ({ me->query("id") }));
    save_kingdom(find_object(kingdom_file));

    me->set("ra", ra - ({ delra }));
    me->save();
    me->setup();

    write("\n" + me->query("name") + HIW "宣布：正式解除" + to_chinese(delra) +
      "(" + delra + ")" + HIR "灭帮" HIW "状态。\n\n" NOR);
    shout("\n" + me->query("name") + HIW "宣布：正式解除" + to_chinese(delra) +
      "(" + delra + ")" + HIR "灭帮" HIW "状态。\n\n" NOR);
  } else if (point == 2) {
    kingdom_file = "/open/" + listra + "/kingdom";
    //    new(kingdom_file);
    ra = kingdom_file->query("ra");
    write(HIW + "\n" + to_chinese(listra) + "\n\n" NOR);
    if (sizeof(ra) > 0) {
      for (int k = 0; k < sizeof(ra); k++)
        write(HIR "\t灭帮发布人：\t" + HIY "(" + ra[k] + ")\n" NOR);
    } else write(HIW "\t这个帮派并没有被消灭。\n" NOR);

  }
  return 1;
}

int save_kingdom(object env) {
  string str, *name, file;
  mapping prop;
  int i;

  file = "/open/" + env->query("kingdom_id") + "/kingdom.lpc";
  //      new(file);

  str = "// Room: " + to_chinese(env->query("kingdom_id")) + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE;
  str += sprintf("\tset(\"short\", %O);\n", env->query("short"));
  str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long"));
  prop = env->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

  rm(file);
  write_file(file, str);
  return 1;
  return 0;
}

//Add By Look
string to_chinese(string str) {
  string kingdom_file;
  kingdom_file = "/open/" + str + "/kingdom";
  //    new(kingdom_file);
  return find_object(kingdom_file)->query("kingdom_name");
}
//The End

int help(object me) {
  write(@HELP
指令格式 : ra with <帮派>             :  发布灭帮
           ra cancel with <帮派>      :  解除灭帮
           ra list <帮派>             :  察看某帮派的灭帮状态发布人
           ra                         :  察看自己所发布的灭帮之帮派
           

这个指令能让发布某帮派的警戒状况
 
ps: 只有发布的人才有解除的权力！

HELP
  );
  return 1;
}
