//join.c 
// edit by xiaoyao

#include <ansi.h>

inherit F_CLEAN_UP;

int do_time(object me);

int main(object me, string arg)
{
        object ob, old_app;
        seteuid(getuid(me));
        if( !arg ) return notify_fail("指令格式：join [cancel]|<对象>\n");
        if( me->query("title")) return notify_fail("你已经有帮派了。\n");


        if( arg=="cancel" ) {
                old_app = me->query_temp("join");
                if( !objectp(old_app) )
                        return notify_fail("你现在并没有向任何人申请加入帮派。\n");
                write("你改变主意不想向" + old_app->name() + "申请加入帮派了。\n");
                tell_object(old_app, me->name() + "改变主意不想向你申请加入帮派了。\n");
                me->delete_temp("join");
                return 1;
        }

        if( !(ob = present(arg, environment(me)))
        ||      !userp(ob) )
                return notify_fail("你想向谁申请加入帮派？\n");

        if( !living(ob) ) return notify_fail("你必须先把" + ob->name() + "弄醒。\n");

        if( ob==me ) return notify_fail("向自己申请加入帮派做什么。\n");

        if( !( ob->query("cwd") ) )
                return notify_fail(ob->name() + "他不是帮主或长老。\n");

        // If the target is willing to recruit us already, we do it.

                old_app = me->query_temp("join");
                if( ob==old_app )
                        return notify_fail("你向" + ob->name() + "申请加入帮派，但是对方还没有答应。\n");
                else if( objectp(old_app) ) {
                        write("你改变主意不想向" + old_app->name() + "申请加入帮派了。\n");
                        tell_object(old_app, me->name() + "改变主意不想向你申请加入帮派了。\n");
                }

                message_vision("$N向$n申请加入帮派。\n", me, ob);
                me->set_temp("join", ob );
                tell_object(ob, YEL "如果你愿意收" + me->name() + "入帮，用 accept 指令。\n" NOR);
                call_out("do_time",20,me);

                return 1;
}

int do_time(object me)
{
        if(me->query_temp("join"))
        {
                me->delete_temp("join");
                write("看样子对方好像不想理你\n");
        }
        return 1;
}
