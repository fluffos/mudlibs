// beep.c
// 仿sj 
#include <ansi.h>
#define yixian_tttttt ""
int help(object me);
int main(object ob,string arg)
{
	string *friend_name,*ob_friend;
	object obj;	
	
	if(ob->query("jing") < 300) return notify_fail("你的精不够了。\n");
	if(ob->is_busy() || ob->is_fighting()) return notify_fail("你正在忙着呢。\n");
	if(!arg) return notify_fail("你要呼叫谁？\n");
	ob_friend = ob->query("friend_user");
	if( sizeof(ob_friend) < 1 || 
	member_array(arg,ob_friend) == -1 
	) return notify_fail("你的好友里有这个人嘛？\n");
	obj = find_player(arg);
	if( !obj || !userp(obj) ) return 0;
	ob_friend = obj->query("friend_user");
	if( sizeof(ob_friend) < 1 || 
	member_array(ob->query("id"),ob_friend) == -1 
	) return notify_fail("他的好友里有你嘛？\n");
		
	tell_object(obj,HIG + yixian_tttttt + "【呼叫】……您的朋友" + ob->name(1) + "(" + capitalize(ob->query("id")) + ")" +"正在呼叫您。\n"NOR);
	write(HIG"您正在呼叫" + obj->name(1) + "……\n"NOR);
	ob->start_busy(3);
	ob->add("jing",-300);
	return 1;
}
int help(object me)
{
	write(@HELP
指令：beep <ID>

功能：呼叫你的在线好友．
HELP
);
return 1;
}
