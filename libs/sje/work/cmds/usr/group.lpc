// Modified BY Xiaoyao
#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object kingdom, ob_king;
  string kingdom_file, *str, king, *ra, msg;
  int i;
  seteuid(getuid());
  str = get_dir("/open/");
  msg = HIY "Ψ" HIW + CHINESE_MUD_NAME + HIY "Ψ" NOR "目前的帮派有：\n\n" NOR;
  msg += "帮派名称\t\t\t现任帮主\t人口\t是否开放 \n";
  msg += "─────────────────────────────────────\n" NOR;
  for (i = 0; i < sizeof(str); i++) {
    kingdom_file = "/open/" + str[i] + "/kingdom";
    //                new(kingdom_file);
    kingdom = load_object(kingdom_file);
    ob_king = new(LOGIN_OB);
    king = load_object(kingdom_file)->query("king");
    ra = load_object(kingdom_file)->query("ra");
    if (sizeof(ra) > 0) {
      ob_king->set("id", king);
      ob_king->restore();
      msg += sprintf(HIR "%-32s%-16s%-8d%s\n" NOR,
        kingdom->query("kingdom_name") + "(" + capitalize(str[i]) + ")",
        capitalize(ob_king->query("id")),
        kingdom->query("people"),
        (kingdom->query("open") ? HIW "开　放" NOR : "")
      );
    } else {
      ob_king->set("id", king);
      ob_king->restore();
      msg += sprintf("%-32s%-16s%-8d%s\n",
        kingdom->query("kingdom_name") + "(" + capitalize(str[i]) + ")",
        capitalize(ob_king->query("id")),
        kingdom->query("people"),
        (kingdom->query("open") ? HIW "开　放" NOR : "")
      );
    }
  }
  msg += "─────────────────────────────────────\n" NOR;
  msg += "目前总共有 " + sizeof(str) + " 个帮派在这个江湖中。\n";
  me->start_more(msg);
  return 1;
}
