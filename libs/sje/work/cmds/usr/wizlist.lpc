#include <ansi.h>
int main(object me, string str) {
  string output;
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");
  if (me->query("jing") < 100)
    return notify_fail("你的精不够，不能查询巫师信息。\n");
  me->add("jing", -50);
  me->start_busy(2);

  output = "" HIR "  " + HIY + "" + MUD_NAME + "" HIR "  " HIG "巫师列表：\n" NOR "";
  output += "" HIR "  " HIG "≡" HIB "──────────────────────────────" HIG "≡" HIR "  \n" NOR "";
  output += "" HIB "    【" HIG "巫师等级" HIB "】    【" HIG "巫师ID" HIB "】    【" HIG "权限" HIB "】   【" HIG "负责区域" HIB "】\n" NOR "";


  output += "" HIR "  " HIG "≡" HIB "──────────────────────────────" HIG "≡" HIR "  \n" NOR "";
  output += "" HIW "    【创世者】       " HIC "Keinxin       " HIW "Admin      " HIY " 总体设计            \n" NOR "";
  output += "" HIM "    【执法官】       " HIC "Wuye          " HIW "Admin      " HIY " wiz纪律监督            \n" NOR "";
  output += "" HIY "    【天  神】       " HIC "Hxsd          " HIW "Assist     " HIY " 设计监督            \n" NOR "";
  output += "" HIG "    【大  神】       " HIC "Chk           " HIW "Admin      " HIY " 维护管理            \n" NOR "";
  output += "" HIC "    【巫  师】       " HIC "Robber        " HIW "Arch       " HIY " 程序开发            \n" NOR "";
  output += "" HIC "    【巫  师】       " HIC "Haoren        " HIW "Arch       " HIY " 程序开发            \n" NOR "";
  output += "" HIC "    【巫  师】       " HIC "Winter        " HIW "Admin      " HIY " 程序开发            \n" NOR "";
  output += "" HIC "    【仙  人】       " HIC "Sunyf         " HIW "Wizard     " HIY " 程序开发            \n" NOR "";
  output += "" HIR "  " HIG "≡" HIB "──────────────────────────────" HIG "≡" HIR "  \n" NOR "";

  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：wizlist
指令说明：
           本指令用来查看目前总共有多少个巫师。
HELP
  );
  return 1;
}
