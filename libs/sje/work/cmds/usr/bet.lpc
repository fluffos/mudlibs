//Write by BBB 1999/10/15
//暂时没有加赌博 exp neili 等，而且 gold 限制最高为 200 
//此程序改一改，可以作为 MUD 在线调查。
//过几天再加上统计功能，分别列表下注人、输赢、总额等 (已经加了)
//还可以加入一个任务，输的太多了，就潜逃，玩家追杀,破产等等
//也可以考虑让玩家坐庄。

#define bet_DIR       "/log/bet/"
#define bet_FILENAME  "bet"

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_SAVE;

mapping *notes;

string query_save_file() {
  return bet_DIR + bet_FILENAME;
}

void list_dubo(object me) {
  int i;
  string s;

  if (sizeof(notes) < 1) {
    write(HIW "赌场现在没开门，没什么可以赌的。\n" NOR);
    return;
  }
  printf(HIY "                      书剑赌场现有以下的赌博信息:\n" NOR
    "-------------------------------------------------------------------------------\n");
  for (i = 0; i < sizeof(notes); i++) {
    s = HIG + (string)(i + 1) + ") " + HIW + notes[i]["describ"] + " " + HIY + "( " + notes[i]["ob1"] + HIR " VS " HIY + notes[i]["ob2"] + " ) " + HIW "赔率为" + (string)notes[i]["p1"] + ":" + (string)notes[i]["p2"];
    switch (notes[i]["status"]) {
      case "0":
        s = s + " " + HIG + "  现在可以下注";
        break;
      case "1":
        s = s + " " + HIG + "  已经停止下注";
        break;
      case "-1":
        s = s + " " + HIG + "  正做开局准备";
        break;
      default:
        s = s + " " + "结果是:" + HIG + notes[i]["status"] + "胜 ";
        break;
    }
    if (wiz_level(me) > 0)
      s = s + HIY + "  标识为：" + notes[i]["UID"] + "\n";
    else
      s = s + "\n";
    printf(s);
  }
}

int search_UID(string UID) {
  int i;
  if (!(i = sizeof(notes))) return 0;
  for (; i > 0; i--)
    if (notes[i - 1]["UID"] == UID) break;
  return i;
}

//开奖了!!!!
void result_dubo(object me) {
  int i = 0, p1, p2;
  int amount, num, amountwin;
  string UID;

  //这里是遗留问题
  if (me->query("aleardy/ya") == 1) {
    write("那赌局已取消了，下次再加入吧！你的本金已自动返还到银行存款中。\n");
    amount = me->query("amount");
    me->add("balance", amount * 10000);
    me->delete("UID");
    me->delete("amount");
    me->delete("aleardy");
    me->delete("who");
    me->delete("kind");
    return;
  }


  if (me->query("bet/aleardy/ya") != 1) {
    write("你现在没有参予赌博！\n");
    return;
  }

  UID = me->query("bet/UID");

  if (!search_UID(UID)) {
    write("那赌局已取消了，下次再加入吧！你的本金已自动返还到银行存款中。\n");
    amount = me->query("bet/amount");
    me->add("balance", amount * 10000);
    me->delete("bet");
    return;
  }
  while (UID != notes[i]["UID"])
    i++;
  p1 = notes[i]["p1"];
  p2 = notes[i]["p2"];

  if (notes[i]["status"] == "-1") {
    write("这赌局被设置成了准备阶段，请等待!\n");
    return;
  }

  if (notes[i]["status"] == "0") {
    write("结果还没出来，再耐心等等吧!\n");
    return;
  }
  if (notes[i]["status"] == "1") {
    write("结果还没出来，再耐心等等吧!\n");
    return;
  }

  amount = me->query("bet/amount");
  if ((me->query("bet/who") != notes[i]["status"]) && (me->query("bet/kind") == "gold")) {
    notes[num]["total"] = notes[num]["total"] + amount;
    save();
    tell_object(me, HIM "你输了，你押的" + (string)(amount) + "两黄金拿不回来了。\n" NOR);
    write_file("/log/bet/betlog", sprintf("%s %s ( %s ) 下注 %d Gold，Lost %d Gold。\n", ctime(time())[4..19],
      me->query("name"), me->query("id"), amount, amount));
  }
  if ((me->query("bet/who") == notes[i]["status"]) && (me->query("bet/kind") == "gold") && (me->query("bet/who") == notes[i]["ob1"])) {
    amountwin = amount * p1 * 10000;
    me->add("balance", amountwin + amount * 10000);
    notes[num]["total"] = notes[num]["total"] - amountwin / 10000;
    save();
    tell_object(
      me,
      HIM "你拿回赌本" + (string)(amount) + "两黄金，又赢了" + (string)(amountwin / 10000) + "两黄金。\n" NOR
    );
    write_file("/log/bet/betlog", sprintf("%s %s ( %s ) 下注 %d Gold，win %d Gold。\n", ctime(time())[4..19],
      me->query("name"), me->query("id"), me->query("bet/amount"), amountwin / 10000));
  }
  if ((me->query("bet/who") == notes[i]["status"]) && (me->query("bet/kind") == "gold") && (me->query("bet/who") == notes[i]["ob2"])) {
    amountwin = amount * p2 * 10000;
    me->add("balance", amountwin + amount * 10000);
    notes[num]["total"] = notes[num]["total"] - amountwin / 10000;
    save();
    tell_object(
      me,
      HIM "你拿回赌本" + (string)(amount) + "两黄金，又赢了" + (string)(amountwin / 10000) + "两黄金。\n" NOR
    );
    write_file("/log/bet/betlog", sprintf("%s %s ( %s ) 下注 %d Gold，win %d Gold。\n", ctime(time())[4..19],
      me->query("name"), me->query("id"), me->query("bet/amount"), amountwin / 10000));

  }
  me->delete("bet");
  return;
}


int main(object me, string arg) {
  mapping note;
  string s, st, temp, who, type;
  string describ, ob1, ob2, status, UID, dir;
  int p1, p2, i, num, amount;

  restore();

  if (!arg)
    return notify_fail("请用 help bet 来看使用方法。\n");

  if (sscanf(arg, "view %s", st) == 1) {
    if (st == "bet.o" || st == "betlog") { return notify_fail("没有此赌局的统计信息。\n"); }
    dir = "/log/bet/" + st;
    if (file_size(dir) < 0) { return notify_fail("没有此赌局的统计信息。\n"); } else
      printf(HIY "%s (%s VS %s) 赔率 %d:%d 总计下注人数：%d 人  总计金额：%d 两\n"
        "其中押 %s 的 %d 人 合计 %d 两，押 %s 的 %d 人 合计 %d 两\n"
        "赌场目前利润为：%d 两黄金，详细列表如下：\n" HIG
        "-------------------------------------------------------------------------------\n" NOR,
        notes[num]["describ"], notes[num]["ob1"], notes[num]["ob2"], notes[num]["p1"], notes[num]["p2"],
        notes[num]["ob1_nu"] + notes[num]["ob2_nu"], notes[num]["ob1_total"] + notes[num]["ob2_total"],
        notes[num]["ob1"], notes[num]["ob1_nu"], notes[num]["ob1_total"],
        notes[num]["ob2"], notes[num]["ob2_nu"], notes[num]["ob2_total"], notes[num]["total"]);
    me->start_more(read_file(dir));
    return 1;
  }

  if (sscanf(arg, "%s", s) == 1) {
    if (s == "new" && wiz_level(me) < 3)
      return notify_fail("只有巫师才能设置赌博信息。\n");
    if (s == "new" && wiz_level(me) >= 3)
      return notify_fail("使用方法：bet new <唯一标识> <描述> <对象一> <对象二> <赔率> \n");
    if (s == "set" && wiz_level(me) < 3)
      return notify_fail("只有巫师能设置状态。\n");
    if (s == "set" && wiz_level(me) >= 3)
      return notify_fail("使用方法：bet set <编号> <状态/结果> \n");
    if (s == "delete" && wiz_level(me) < 3)
      return notify_fail("只有巫师才可以删除赌博信息。 \n");
    if (s == "delete" && wiz_level(me) >= 3)
      return notify_fail("使用方法：bet delete <编号> \n");

    if (s == "list") {
      list_dubo(me);
      return 1;
    }
    if (s == "result") {
      result_dubo(me);
      return 1;
    }


  }

  // 设置新的赌博内容
  if (sscanf(arg, "new %s %s %s %s %d:%d", UID, describ, ob1, ob2, p1, p2, status) == 6) {
    if (strlen(UID) > 8)
      return notify_fail("唯一标识请尽量简短。\n");
    if (search_UID(UID))
      return notify_fail("重复的标识符，换一个。\n");
    note = allocate_mapping(7);
    note["describ"] = describ;
    note["ob1"] = ob1;
    note["ob2"] = ob2;
    note["p1"] = p1;
    note["p2"] = p2;
    note["status"] = "-1";
    note["UID"] = UID;
    note["ob1_nu"] = 0;
    note["ob2_nu"] = 0;
    note["ob1_total"] = 0;
    note["ob2_total"] = 0;
    note["total"] = 0;

    i = sizeof(notes);
    if (!pointerp(notes) || !sizeof(notes))
      notes = ({ note });
    else notes += ({ note });
    tell_object(me, HIM "已做完开局准备，再检查一次赔率后 bet set <编号> 0 可以开始下注。\n" NOR);
    save();
    message("channel:chat", HIC "\n【赌场通告】：本场正在开设新赌局，稍后可以下注。\n" NOR, users());
    return 1;
  }


  //设置当前赌博状态：0 or 1 or 结果 
  if (sscanf(arg, "set %d %s", num, status) == 2) {
    if (!pointerp(notes) || !sizeof(notes))
      return notify_fail("现在没有任何赌博。\n");
    if (num < 1 || num > sizeof(notes))
      return notify_fail("没有这个编号的赌局。\n");
    num--;
    if (status == "0")
      temp = HIC "本场赌局：" + notes[num]["describ"] + " ( " + notes[num]["ob1"] + " VS " + notes[num]["ob2"] + " ) 现在开始接受下注，赔率为 " + notes[num]["p1"] + ":" + notes[num]["p2"] + "\n" + NOR;

    else if (status == "1")
      temp = HIC "本场赌局：" + notes[num]["describ"] + " ( " + notes[num]["ob1"] + " VS " + notes[num]["ob2"] + " ) 现在停止下注。\n" + NOR;

    else if (status == "-1")
      temp = HIC "本场赌局：" + notes[num]["describ"] + " ( " + notes[num]["ob1"] + " VS " + notes[num]["ob2"] + " ) 正在做开局准备。\n" + NOR;

    else if (status != notes[num]["ob1"] && status != notes[num]["ob2"]) {
      temp = "没有这一方啊？检查一下，重来！\n";
      return notify_fail(temp);
    } else {
      temp = HIC "本场赌局：" + notes[num]["describ"] + " ( " + notes[num]["ob1"] + " VS " + notes[num]["ob2"] + " ) ，赔率为 " + notes[num]["p1"] + ":" + notes[num]["p2"] + "，结果为：" + status + "胜。\n" + NOR;
    }
    message("channel:chat", HIC "\n【赌场通告】：" + temp + "\n" NOR, users());
    notes[num]["status"] = status;
    save();
    return 1;
  }

  //删除赌博信息 
  if (sscanf(arg, "delete %d", num) == 1) {
    if (wiz_level(me) < 3) return notify_fail("只有巫师才可以删除。 \n");
    if (!arrayp(notes) || num < 1 || num > sizeof(notes))
      return notify_fail("没有这个编号的赌博信息。\n");
    else
      num--;
    dir = notes[num]["UID"];
    dir = "/log/bet/" + dir;
    notes = notes[0..num - 1] + notes[num + 1..<1];
    save();
    if (rm(dir) && sizeof(dir) > 1)
      write("删除第 " + (num + 1) + " 号赌博信息及统计信息....Ok。\n");
    else
      write("删除第 " + (num + 1) + " 号赌博信息...Ok。\n" + dir + " 统计文件不存在，无须删除。\n");
    return 1;
  }

  //下注了!!!
  if (sscanf(arg, "%d %s %d %s", num, who, amount, type) == 4) {
    if (me->query("bet/aleardy/ya") == 1)
      return notify_fail("你已经在赌了，每次只能赌一样！\n");
    if (!arrayp(notes) || num < 1 || num > sizeof(notes))
      return notify_fail("没有这个编号的赌博信息。\n");
    num--;
    if (notes[num]["status"] == "-1")
      return notify_fail("赌场正在做准备工作，请稍候！\n");
    if (notes[num]["status"] == "1")
      return notify_fail("可惜呀，现在已经停止下注了，下次请早吧！\n");
    if (notes[num]["status"] != "0")
      return notify_fail(HIR "结果已经出来了，还下注？!\n" NOR);
    if (type != "gold")
      return notify_fail("你只能用银行存款来赌。\n");
    if ((type = "gold") && (me->query("balance") < amount * 10000))
      return notify_fail("你没有这么多的银行存款来赌。\n");
    if (amount > 200)
      return notify_fail("对不起，赌场本小，怕赔不起，不能接受那么高的的赌注。\n");
    if (who != notes[num]["ob1"] && who != notes[num]["ob2"])
      return notify_fail("你要对哪方下注呀？\n");
    tell_object(
      me,
      HIM "第 " + (string)(num + 1) + " 赌局：" + notes[num]["describ"] + " 你押了 " + (string)amount + " " + type + " 赌 " + who + " 胜。\n" NOR
    );
    tell_object(me, HIM "你下注的 " + amount + " 两黄金已从银行存款中自动扣除。\n" NOR);
    me->set("bet/UID", notes[num]["UID"]);
    me->set("bet/amount", amount);
    me->set("bet/kind", type);
    me->set("bet/who", who);
    me->set("bet/aleardy/ya", 1);
    me->add("balance", -amount * 10000);

    if (who == notes[num]["ob1"]) {
      notes[num]["ob1_nu"] = notes[num]["ob1_nu"] + 1;
      notes[num]["ob1_total"] = notes[num]["ob1_total"] + amount;
    }

    else {
      notes[num]["ob2_nu"] = notes[num]["ob2_nu"] + 1;
      notes[num]["ob2_total"] = notes[num]["ob2_total"] + amount;
    }

    save();
    dir = "/log/bet/" + me->query("bet/UID");
    write_file(dir, sprintf("%s %-8s %8s       押 %8s 胜，下注 %3d 两\n", ctime(time())[4..19],
      me->query("name"), me->query("id"), me->query("bet/who"), me->query("bet/amount")));
    return 1;
  }

  return notify_fail(HIW "参数输入错误，请看" + HIR + " help bet" + HIW " 然后重新输入!\n" NOR);
}

int help(object me) {
  write(@HELP
指令格式 : 
bet list						查看现在有什么赌博信息。
bet result						查看你下注的结果和领取奖励。
bet <编号> <哪方> <数量> <赌什么>			下注。暂时只能赌黄金（银行存款）
bet view <标识>						查看赌局的详细统计资料
bet new <唯一标识> <描述> <甲方> <乙方> <赔率>		wizard 级别以上巫师用，设置新赌局
bet delete <编号>					删除赌博信息，wizard 级别以上巫师专用
bet set <编号> <-1/0/1/结果>				设置赌博状态,wizard 级别以上巫师专用

注意：	1、赌博状态：-1 初始状态 0 可以下注 1 停止下注 其他应为结果
	2、目前只可以赌 gold。 关闭 exp、neili 
	3、如果比赛打平或因故取消，或赌场取消赌局，下注人可以拿回本钱。
HELP
  );
  return 1;
}
