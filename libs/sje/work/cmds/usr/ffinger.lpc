// finger.c
// by xiaoyao@Sj
// 加入好友名单
// Modify by snowman@SJ 09/01/2000

#include <ansi.h>
inherit F_CLEAN_UP;

void create()
{
        seteuid(getuid());
}

int main(object me, string arg)
{
        int i;
        object obj;
        string *friend_user, list;
        
        if( (int)me->query("jing") < 50 )
		return notify_fail("你的精神无法集中。\n");
	if( !wizardp(me) )
		me->receive_damage("jing", 50);
		
	friend_user = me->query("friend_user");
	
        if( !stringp(arg)) {
                if( !friend_user || !sizeof(friend_user))
                	return notify_fail("你目前没有设定好友。\n");
                	
                list = "\n你目前的好友名单如下：\n";         
                for( i = 0 ; i < sizeof(friend_user); i++) {
                 	if( (obj = find_player(friend_user[i]) )){
                 		if( obj->query("env/invisibility") < 1 || wizardp(me))  
                 			list += sprintf("  [%d] %-30s\n", (i+1), obj->short(1));
                 		else 	list += sprintf("  [%d] %-30s\n", (i+1), capitalize(friend_user[i])+" 目前不在线上。");
                 	}
                 	
                 	else if( file_size(DATA_DIR+"login/"+ friend_user[i][0..0] +"/"+ friend_user[i] +__SAVE_EXTENSION__) > 0 )
                        	list += sprintf("  [%d] %-30s\n", (i+1), capitalize(friend_user[i])+" 目前不在线上。");
                        else list += sprintf("  [%d] %-30s\n", (i+1), capitalize(friend_user[i])+" 的档案已经不存在，可能自杀或被清档了。");
                } 
                tell_object(me, list);
                return 1;       
        }
        
      	else {
                if( sscanf(arg,"-d %s", arg) ) {
                	if( friend_user -= ({ arg }) )
                		if( me->set("friend_user", friend_user) )
                			return notify_fail("你将 "+capitalize(arg)+" 从好友名单移除了。\n");
                	else return notify_fail("你的好友名单中并没有 "+capitalize(arg)+" 这个人。\n");
                }
                
       		else if( sscanf(arg, "-a %s", arg) ) {
                	if( arg==me->query("id") )
                        	return notify_fail("你脑袋有问题吗？xixi\n");
                        	
                        if( !friend_user || sizeof(friend_user) < 1 ){
                        	if(me->set("friend_user", ({arg})))
                			return notify_fail("你成功的将 "+capitalize(arg)+" 加入好友名单里面。\n");
                	}
                	
                        
                        if( sizeof(friend_user) >= 10 )
                        	return notify_fail("好友名单最多为十位，请先确定人数。\n");
                        	
                        if( member_array(arg, friend_user) != -1)
                        	return notify_fail("好友名单中已经有此人了。\n");
                        	
                	if( file_size(DATA_DIR+"login/"+arg[0..0]+"/"+ arg +__SAVE_EXTENSION__) < 0 )
                        	return notify_fail("没有这位使用者。\n");
                        	
                        friend_user += ({ arg });
                        
                	if( me->set("friend_user", friend_user) )
                		return notify_fail("你成功的将 "+capitalize(arg)+" 加入好友名单里面。\n");
                		
                	else return notify_fail("将 "+capitalize(arg)+" 加入好友名单失败！请通知巫师。\n");
        	}
        	
		else write( FINGER_D->finger_user(arg) );
	}
	
        return 1;
}

int help(object me)
{
  write(@HELP
----------------------------------------
指令格式：finger [-a|-d] 
          finger <id>
----------------------------------------
 finger [使用者姓名]
 finger -a [加入好友]
 finger -d [移除好友]
----------------------------------------

HELP
    );
    return 1;
}
