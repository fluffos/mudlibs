// top.c
// create by yixian
// 仿sj

#pragma save_binary

#define TOPTEN_DIR      "/open/topten"
#include <ansi.h>
int help(object ob);
int main(object ob,string arg)
{
        int i,T,tt,list_num,dd,*all_int;
        string aa,bb,cc,msg,*file_msg,*wizlist,temp;
        mapping top_list,wiz_mapp;
        if(ob->is_busy() || ob->is_fighting()) return notify_fail("你正忙着呢.\n");
        if( file_size(TOPTEN_DIR) < 1 ) {
                "/adm/daemons/toptend"->rewrite_top();
                return 1;
        }
        if( ob->query("combat_exp") > 10000 || ob->query("env/guiyin")) 
                "/adm/daemons/toptend"->compare_top(ob);
        if(!arg) list_num = 10;
        
        if(stringp(arg) && sscanf(arg,"%d",list_num) != 1) return 0;
        if(list_num>100) list_num = 100;
        // 读文件
        file_msg = explode(read_file(TOPTEN_DIR) , "\n");
        T = sizeof(file_msg);
        top_list = allocate_mapping( T + 1 );
        // add by yixian for block wiz
        wizlist = explode(read_file("/adm/etc/wizlist"),"\n");
        for( i = 0 ; i < sizeof(wizlist) ; i++) {
                sscanf(wizlist[i],"%s (%s)",wizlist[i],temp);
        }
                
        for( i = 0 ; i < T ; i++ ) {
                if(sscanf(file_msg[i] , "%s:%s:%s:%d",aa,bb,cc,dd) != 4 ) 
                error("Top : can't sscanf dst top list.\n");
                // add by yixian for block wiz
                // 2002-03-16 02:33下午
                if( member_array(aa,wizlist) != -1 ) continue;
                top_list[dd] = ({ aa,bb,cc });
        }
        reset_eval_cost();
        all_int = sort_array( keys(top_list) , (: (int)$2 - (int)$1 :));
        
        T = sizeof(all_int);
        msg  = "\n                 "+BCYN HIW+MUD_NAME+"高手排行榜"NOR" \n";
        msg += "┏━━━━┯━━━━━━━━━━┯━━━━┯━━━━┓\n";
        msg += "┃  名 次 │     高      手     │ 门  派 │ 评  价 ┃\n";
        msg += "┠────┴──────────┴────┴────┨\n";
        for( i = 0 ; i < T && i < list_num ; i++ ) {
                tt = all_int[i];
                if( top_list[tt][0] == ob->query("id") ) msg += BBLU;
                msg += sprintf("┃  %-7s %11s%-11s%-10s %5d  ┃\n"NOR,
                chinese_number(i+1),
                top_list[tt][1],
                "("+top_list[tt][0]+")",
                top_list[tt][2],
                all_int[i]
                );
        }
        msg += "┗━━━━━━━━━━━━━━━━━━━━━━━━━┛\n";
        msg += "  " + NATURE_D->game_time() + "记。\n";
        ob->start_more(msg);
        ob->start_busy(3);
        
        return 1;
}
int help(object ob)
{
        write(@HELP
指令格式 : top 
 
这个指令可以让你知道高手是哪些，别去惹他们。 
 
HELP
    );
    return 1;
}
