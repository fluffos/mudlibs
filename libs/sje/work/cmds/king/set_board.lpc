//edit by xiaoyao

#include <ansi.h>
inherit F_CLEAN_UP;
#include <save.h>
int save_board(object me, int flag);
void do_change(object me, string str);
int main(object me, string arg) {
  object env, room, board;
  string kingdom_file, room_me, new_file, str;
  seteuid(getuid(me));
  env = environment(me);

  if (me->is_busy())
    return notify_fail("你的动作还没有完成。\n");
  if (me->is_fight())
    return notify_fail("你现在在战斗中。\n");
  if (!arg) return notify_fail("指令格式：set_board [here|cancel|long|name]\n");

  if (env->query("kingdom_id") != me->query("kingdom"))
    return notify_fail("这已经不是我帮派的领地了。\n");
  if (env->query("no_change"))
    return notify_fail("这里不能做这动作。\n");
  if (env->query("inherit"))
    return notify_fail("特殊房间中不能设置留言版。\n");

  kingdom_file = me->query("cwd") + "kingdom";
  room_me = base_name(env);
  room = find_object(room_me + ".lpc");
  new_file = me->query("cwd") + me->query("kingdom") + "_b2.lpc";

  if (arg == "here") {
    if (kingdom_file->query("board_site"))
      return notify_fail("贵帮派已有留言板了。\n");
    if (room->query("board"))
      return notify_fail("此处已有留言板了。\n");
    if (find_object(kingdom_file)->query("gold") < 1000)
      return notify_fail("贵帮库存没有足够的资金建造留言板。\n");
    save_board(me, 1);
    message_vision("$N叫了几个帮众在这个地方在建立留言版供大家留言使用。\n", me);
    room->set("board", new_file);
    room->set("type", "board");
    find_object(kingdom_file)->set("board_site", file_name(room));
    find_object(kingdom_file)->add("gold", -1000);
    save_kingdom();
  } else if (arg == "long") {
    if (!kingdom_file->query("board_site"))
      return notify_fail("贵帮派并没有设置留言板。\n");
    if (!room->query("board"))
      return notify_fail("此处并没有设置留言板。\n");
    me->edit((: call_other, __FILE__, "do_change", me :));
    write("留言版属性修改成功。\n");
  } else if (sscanf(arg, "name %s", str) == 1) {
    if (!kingdom_file->query("board_site"))
      return notify_fail("贵帮派并没有设置留言板。\n");
    if (!room->query("board"))
      return notify_fail("此处并没有设置留言板。\n");
    if (strlen(str) > 50)
      return notify_fail("留名版的名字太长了。\n");
    board = present("board", environment(me));
    str = CHINESE_D->ansi_color(str);
    board->set("name", str + NOR);
    save_board(me, 0);
    write("留言版属性修改成功。\n");
  } else if (arg == "cancel") {
    if (!kingdom_file->query("board_site"))
      return notify_fail("贵帮派并没有设置留言板。\n");
    if (!room->query("board"))
      return notify_fail("此处并没有设置留言板。\n");
    room->delete("board");
    find_object(kingdom_file)->delete("board_site");
    save_kingdom();
    rm(new_file);
    write("你解除了布告栏的设置，请记得一定要用 saveroom 存档!\n");
  } else return notify_fail("请 help set_board 。\n");
  "/cmds/minister/saveroom.lpc"->main(me);

  return 1;
}
void do_change(object me, string str) {
  object board;
  board = present("board", environment(me));
  board->set("long", str);
  save_board(me, 0);
  return;
}
int save_board(object me, int flag) {
  string str;
  object board;
  if (!flag) board = present("board", environment(me));
  str = "#include <ansi.h>\n inherit BULLETIN_BOARD;\n\nvoid create()\n {\n";
  str += sprintf("\tset(\"location\", \"%s\");\n", file_name(environment(me)));
  str += sprintf("\tset(\"board_id\", \"%s\");\n", me->query("kingdom"));
  if (flag) {
    str += sprintf("\tset_name(\"%s\", ({\"board\"}));\n ", "留言版");
    str += sprintf("\tset(\"long\", \"这是一个普通的留言版。\\n\");\n");
  } else {
    str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", board->query("long"));
    str += sprintf("\tset_name(\"%s\", ({\"board\"}));\n ", board->query("name"));
  }
  str += sprintf("\tsetup();\n");
  str += sprintf("\tset(\"capacity\", 30);\n");
  // AGENTS.md §7.86: this template already `inherit BULLETIN_BOARD;`
  // above -- appending a redundant self-replace_program() call here
  // permanently breaks every kingdom-built board's `post` command
  // (the exact bug already found and fixed in every static board file
  // in this lib).
  str += sprintf("\n}");
  if (!flag) rm(file_name(board) + ".lpc");
  write_file(me->query("cwd") + me->query("kingdom") + "_b2.lpc", str);
  write("设置完成。\n");
  return 1;
  return 0;
}
int help(object me) {
  write(@HELP
----------------------------------------
指令格式：set_board [here|cancel|long|name]
----------------------------------------
说明：
set_board
here        ：设置 board
cancel      ：取消 board
long        ：设定 board 长叙述
name <名称> ：设定 board 短叙述

帮派建造留言板，需耗费一千两黄金。
----------------------------------------
HELP
  );
  return 1;
}
