#include <ansi.h>
inherit NPC;

void create()
{
        set_name("擂台直播员", ({ "leitai npc" }) );
        set("gender", "男性" );
        set("age", 20);       
        set("str", 30);
        set("dex", 25);
        set("con", 25);
        set("int", 30);  
        set_temp("leitai", 1);           
        set("attitude", "friendly");
        set_temp("apply/id", ({ "" }));
        set_temp("apply/short", ({"比武擂台教头"}));
        setup();
}
void relay_message(string msgclass, string msg)
{
        object room, room2;
        string *ary;
        int i;

        msg = "1\n" + msg;
        ary = explode(msg, "\n");
        room = load_object(environment(this_object())->query("dest_room"));
        room2 = load_object(environment(this_object())->query("dest_room2"));
        for (i=1;i<sizeof(ary);i++){
            if (room) message("vision", HIY"【擂台】"NOR+ary[i]+NOR+"\n", room);
            if (room2) message("vision", HIY"【擂台】"NOR+ary[i]+NOR+"\n", room2);
            }
}
