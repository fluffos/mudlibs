// alarm.c creat by Look@SJ 19990909

#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string target, msg;
  object obj;
  if (!arg || sscanf(arg, "%s %s", target, msg) != 2) return help(me);
  if (strlen(msg) > 20) return notify_fail("没必要搞这么长吧？\n");
  obj = find_player(target);
  if (!obj) return notify_fail("你要警告谁啊？好象没(" + target + ")这个人啊。\n");
  if (wiz_level(me) < wiz_level(obj)) return notify_fail("你敢警告上级？不想混了吧？\n");
  write(HIR "\n 你警告" + obj->name(1) + "：\n \n" + "      由于你的【" + msg + "】行为违反了游戏规则，造成了不良影响，\n" + "      如果再犯，将被移送到桃花源！\n \n" NOR);
  tell_object(
    obj,
    sprintf(
      HIR "\n 巫师警告你：\n \n" + "      由于你的【%s】行为违反了游戏规则，造成了不良影响，\n" + "      如果再犯，将被移送到桃花源！\n \n" NOR,
      msg
    )
  );
  return 1;

}
int help(object me) {
  write(@HELP
指令格式：alarm <某人> <讯息>
你可以用这个指令警告一些违反游戏规则的玩家。
HELP
  );
  return 1;
}
