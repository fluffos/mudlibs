// jiancha.c by Darken (modified from zhua.c by Numa)
// darken ,这个程序有可能被用来走出迷宫 hehe
// 以后得在迷宫房间加个属性才方便
// 这个程序也能用来骗钱。hehe keinxin

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object obj,obj2,where; 
	string str;
	
	if (!arg || sscanf(arg, "%s", str) != 1)
		return notify_fail("指令格式： jiancha <某人>。\n");
	
	obj = LOGIN_D->find_body(str);
	
       if (!obj || !me->visible(obj)) return notify_fail("你要检查的目标目前不在游戏中！\n");
	if (!living(obj) ) return notify_fail("你要检查的目标昏迷不醒，等醒来再说吧。\n");
      if (obj == me ) return notify_fail("检查自己？？？\n");
	if (wiz_level(obj))return notify_fail("你无权去检查巫师。\n");
	if (obj->is_ghost())return notify_fail("你要检查的目标现在还在阴间呢。\n");
	if (!interactive(obj))return notify_fail("你要检查的目标断线了。\n");
        if (query_idle(obj) > 120) return notify_fail("你要检查的目标正在发呆。\n");
        if (!environment(obj)) return notify_fail("无法检查。\n");
        if(strsrch(file_name(environment(obj)),"/d/wizard/robot_court") >=0 )
        	 return notify_fail("你的检查目标正在机器人法官那里接受审判呢。\n");
        if(strsrch(file_name(environment(obj)),"/d/wizard/relax") >=0 )
        	 return notify_fail("你的检查目标正在桃花源里休息呢，别打扰了。\n");

//darken 把这里检查一下各个监狱的确切地点     -bbb
        if(strsrch(file_name(environment(obj)),"/d/wizard/wizard_jail") >=0 ||
          strsrch(file_name(environment(obj)),"/d/mingjiao/jianyu") >=0 ||
          strsrch(file_name(environment(obj)),"/d/shaolin/jianyu") >=0 ||
          strsrch(file_name(environment(obj)),"/d/shaolin/jianyu1") >=0 ||
           strsrch(file_name(environment(obj)),"/d/shenlong/jail") >=0 )
        	 return notify_fail("你在坐牢呢，别打扰了。\n");
	if(objectp(obj = present("runner", environment(obj))))
                return notify_fail("有个银翼杀手正在那里检查。\n");
        if(me->query("balance")<3000000)
                return notify_fail("你没有足够的押金。\n");
	obj = LOGIN_D->find_body(str);
        if(obj->query("combat_exp")<30000)
                return notify_fail("对新手好点嘛。\n");

        obj2 = new("/clone/npc/antirobot3");
        message("channel:rumor",HIM"【谣言】某人："+obj->name(1)+HIM"("+capitalize(obj->query("id"))+")正在接受" + me->name(1)+HIM"申请的机器人抽查。\n"NOR,users());
        obj2->test_robot(obj);
        tell_object(me,HIY + obj->name(1)+HIY"("+capitalize(obj->query("id"))+")已经照您的吩咐送去审查了，请稍候。\n");
        me->add("balance",-3000000);
        call_out("testing", 200, me, obj);
        return 1;
}


int testing(object me, object obj)
{
        object where;
        where = environment(obj);
        if(file_name(where)=="/d/wizard/robot_court")
        {
                message_vision(HIY"机器人法官对$N说道：“多谢报告，这儿是你的押金。”\n"NOR, me);
                message_vision(HIY"机器人法官又偷偷放了十两金子在$N钱庄户头中。\n"NOR, me);
                me->add("balance",3100000);
        } else {
                message_vision(HIR"机器人法官对$N说道：“胡乱报告什么！他不是机器人！”\n"NOR, me);
        message_vision(HIR"机器人法官把$N的押金放进自己口袋，走掉了。\n"NOR, me);
       }
       return 1;
}

int help(object me)
{
write(@HELP
指令格式 : jiancha <某人>

此指令可让你让某个玩家接受机器人抽查，但是需要 300 两黄金的押金。
如果目标证实为机器人，机器人法官会将钱还你，并加上一点小费。
检查约要 2 分钟时间。押金会直接从钱庄扣，方便玩家。
HELP
    );
    return 1;
}

