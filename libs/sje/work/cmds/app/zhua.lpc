// Created by Numa 1999-12-10

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob, obj;
        
        if (!arg)
                return notify_fail("指令格式： zhua <某人>。\n");
        obj = present(arg, environment(me));
        if(!obj)
                obj = present(arg, me);
        if(!obj)
                obj = find_player(arg);
        if(!obj || !me->visible(obj))
                obj = find_object(resolve_path(me->query("cwd"), arg));
        if("me" == arg)
                obj = me;
        if(!obj)
                return notify_fail("找不到指定的物件。\n");

        ob = new("/clone/npc/antirobot3");
        message("channel:rumor",HIM"【谣言】某人："+obj->name(1)+HIM"("+capitalize(obj->query("id"))+")正在接受机器人抽查。\n"NOR,users());
        ob->test_robot(obj);
        tell_object(me,HIY + obj->name(1)+HIY"("+capitalize(obj->query("id"))+")已经照您的吩咐送去审查了。\n");
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : zhua <某人>

此指令可让你让某个玩家接受机器人抽查。
HELP
    );
    return 1;
}

