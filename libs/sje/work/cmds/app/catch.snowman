// catch.c
// by snowman@SJ 19/05/99

#include <ansi.h>
#include <login.h>

int main(object me, string str)
{
	object ob, where;

	if (!str)
		return notify_fail("指令格式：catch <ID>\n"); 
		
        if (!objectp(ob = LOGIN_D->find_body(str))) 
                return notify_fail("没有这个人耶。。。\n");
                
        if (wizardp(ob) || SECURITY_D->get_status(ob) == "(immortal)") 
                return notify_fail("对方是共同奋斗的战友噢，你这样做不太好吧？\n");

	
	where = environment(ob);
	if (file_name(where) == ROBOT_HOUSE) 
	        return notify_fail("这人已经加入机器人协会了。\n");
	
	message_vision(MAG"\n$N手指一伸，变出两位美貌仙女，扶起$n腾空而去了。\n\n"NOR, me, ob);
	ob->apply_condition("robot", 1500);  
	ob->set("robot/catch", me->query("id"));
	ob->move(ROBOT_HOUSE);
	ob->save();
	
	tell_room(environment(ob), MAG"两为仙女扶着"+ob->name()+MAG"飘来，将"+ob->name()+MAG"轻轻放在这里。\n"NOR, ({ ob }));
	log_file("ROBOT", geteuid(me) + " catch "+ob->name()+"("+ob->query("id")+") on "+ ctime(time()) + "\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式: catch <玩家的 ID>

这个指令是用来将违规的玩家送往机器人房间。

HELP
	);
	return 1;
}

