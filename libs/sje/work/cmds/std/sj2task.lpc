#include <ansi.h>
int main(object me, string str)
{
	string output;
        if(me->is_busy())
        return notify_fail("你现在正忙。\n");
        if(me->query("jing")<200)
        return notify_fail("你的精不够，不能查询神书信息。\n");
        me->add("jing",-100);
        me->start_busy(2);

    output = HIR"★ "HIW"书剑贰"HIR" ★"HIG" 神书榜\n" NOR; 
    output += ""HIW"─────────────────────────────────────\n"NOR"";   
    output += QUEST_D->dyn_quest_list();  
    output += ""HIW"────────────────────────────"HIG" 书剑贰"HIW" ────\n\n"NOR""; 

	me->start_more(output);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式: hytask
相关文件: help tasks

这个指令是用来得知目前的所有神书.

HELP
	);
	return 1;
}
