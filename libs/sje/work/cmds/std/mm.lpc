// MarryMessage.c Look@SJ 19990916

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;
int help(object me);
void create() {seteuid(getuid());}
int main(object me, string arg)
{
        object obj;
        if(!me->query("marry")) return help(me);
        obj = find_player(me->query("marry/id"));
        if(!obj || (!wizardp(me) && !me->visible(obj)))
                return notify_fail("你的伴侣现在不在....\n");
        if( !arg )
        {
                tell_object(me,sprintf(HIM"你总得说点什么吧？\n" NOR));
        }
        else
        {
                write(HIM "你悄悄告诉你的" + me->query("marry/name") + "：" + arg + "\n" NOR);
                tell_object(obj, sprintf( HIM "你的%s悄悄告诉你：%s\n" NOR,obj->query("marry/name"), arg));
        }
        return 1;
}

int help(object me)
{
write(@HELP
指令格式：mm [<讯息>]
你可以用这个指令对你的伴侣说悄悄话。如果没有，呵呵。。。

HELP);
return 1;
}

