// Tbh 2002.4.10 (tbhcn@citiz.net)
// lineupkill.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  string callname;
  object *t;
  int i;

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");

  if (!arg)
    return notify_fail("你想杀谁？\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail("用 suicide 指令会比较快：P。\n");

  if (userp(me) && userp(obj) && obj->query("age") < 15)
    return notify_fail("你的心肠太黑了, 对手无缚鸡之力的玩家也下得了手。\n");

  if (userp(me) && userp(obj) && obj->query("combat_exp") < 5000)
    return notify_fail("你的心肠太黑了, 对手无缚鸡之力的玩家也下得了手。\n");

  if (strsrch(file_name(environment(me)), "/d/wuguan/") >= 0)
    return notify_fail("武馆内禁止杀人。\n");

  callname = RANK_D->query_rude(obj);
  t = all_inventory(environment(me));


  if (!me->query_temp("lineup"))
    return notify_fail("你现在并没有加入任何阵法。(use kill)\n");

  if (me->query_temp("lineup") != me->query("id") || me->query_temp("lineup_limit") < 2)
    return notify_fail("只有阵法的主持者才能命令大家。\n");

  /*
	if( userp(obj) )
		return notify_fail("唉！你可不可以改掉以众欺寡的恶习？\n");
*/

  message_vision("\n$N对著$n喝道：「" + callname + "！今日不是你死就是我们亡！」\n\n", me, obj);

  for (i = 0; i < sizeof(t); i++) {
    if (!living(t[i]))
      continue;
    if (!t[i] || !t[i]->is_character())
      continue;
    if (t[i]->query_temp("lineup") == me->query_temp("lineup")) {
      if (!t[i]->is_busy() && userp(obj)) t[i]->start_busy(2 + random(1));
      t[i]->kill_ob(obj);
      if (!obj->query_temp("kill_other/" + t[i]->query("id")) && !obj->query_condition("killer")) t[i]->set_temp(
        "kill_other/" + obj->query("id"),
        1
      );
      obj->kill_ob(t[i]);
      if (!t[i]->query_temp("kill_other/" + obj->query("id")) && !t[i]->query_condition("killer")) obj->set_temp(
        "kill_other/" + t[i]->query("id"),
        1
      );
    }
  }

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : lineupkill <人物>
 
这个指令让你的阵法主动攻击一个人物。
HELP
  );
  return 1;
}
