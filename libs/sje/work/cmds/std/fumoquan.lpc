// by hunthu

#include <ansi.h>
inherit F_SSERVER;

int main(object me, string arg) {
  object target;
  object *t, *member;
  int i, j, exp, skill;

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  t = me->query_team();
  if (sizeof(t) != 3)
    return notify_fail("你现在并没有组成队伍或者队伍成员不是三个人。\n");
  if (!me->is_team_leader())
    return notify_fail("只有队伍领袖才可以发动“金刚伏魔圈”！\n");
  if (me->query("max_neili", 1) < 4000 || me->query("neili") < 1000)
    return notify_fail("你没有足够的内力。\n");
  exp = 0;
  skill = 0;
  for (i = 0; i < 3; i++) {
    if (t[i])
      if (environment(me) != environment(t[i]))
        return notify_fail("队员不在现场。\n");
    if (!t[i]->query_temp("ryb_fumo"))
      return notify_fail("有的成员没有使用伏魔圈绝技。\n");
    exp += (int)t[i]->query("combat_exp", 1);
    skill += ((int)t[i]->query_skill("riyue-bian", 1) + (int)t[i]->query_skill("buddhism", 1));
  }
  target = offensive_target(me);
  if (me->is_killing(target))
    return notify_fail("这里没有你要攻击的目标！\n");
  message_vision("\n$N朗声吟道“我佛慈悲，普渡众生”，刹那间漫天鞭影，正是少林不传之秘金刚伏魔圈！\n\n", me);
  if (random(exp) > (int)target->query("combat_exp", 1) * 2 / 3) {
    message_vision(HIR "\n劲风声中，三条长索如鬼似魅，品字形交叉而上，将$N紧紧缠在当中。\n
                               紧接着三索齐下，只打得$N四肢齐折，不成人形。\n" NOR, target);
    target->start_busy(10);
    target->receive_damage("qi", skill * 3);
    target->receive_wound("qi", skill * 2);
  } else if (random(exp) > (int)target->query("combat_exp") / 2) {
    message_vision(HIR "\n 突然间一条长索向$N胸口点到，那长索化成一条笔直的兵刃，如长矛，如杆棒，\n
                                 疾刺而至，同时另外两条长索也从身后缠来，$N躲闪不及被重重打了一下。\n" NOR, target);
    target->receive_damage("qi", skill * 2);
    target->receive_wound("qi", skill * 2);
  } else {
    message_vision(HIR "\n $N 眼见三根长索便将卷上身来，左拨右带，一卷一缠，借着三人的劲力，已将三根长\n
                           索卷在一起，紧接着$N在半空中翻了个筋斗，已将来攻的三招九式化为无形。\n" NOR, target);
  }
  me->add("neili", -300);
  me->start_busy(random(5) + 5);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : fumoquan
 
这个指令是让少林弟子使用金刚伏魔圈用的，要求队伍中要有三
个同时使用伏魔圈特殊攻击的成员。

HELP
  );
  return 1;
}
