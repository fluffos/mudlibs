// kantou.c

#include <ansi.h>
inherit F_CLEAN_UP;

int do_kan(object me, object ob, object weapon);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object obj, *inv, weapon;

  if (!arg) return notify_fail("你要斩什么？\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("找不到这个东西。\n");

  if (obj->query("shouji") > 0)
    return notify_fail("那已经被切过了。\n");

  if (obj == me)
    return notify_fail("不会吧，你想切自己的脑袋？\n");

  if (userp(obj) || living(obj))
    return notify_fail("看清楚点，那不是尸体。\n");

  if (obj->query("name") == "腐烂的男尸" && obj->query("id") == "nan shi")
    return notify_fail("那具尸体已经腐烂了。\n");

  if (obj->query("name") == "腐烂的女尸" && obj->query("id") == "lv shi")
    return notify_fail("那具尸体已经腐烂了。\n");

  if (obj->query("name") == "腐烂的尸体" && obj->query("id") == "shi ti")
    return notify_fail("那具尸体已经腐烂了。\n");

  if (obj->query("id") != "corpse")
    return notify_fail("看清楚点，那不是尸体。\n");

  if (obj->query("race") != "人类")
    return notify_fail("不会吧，你对动物的尸体也感兴趣？\n");

  if (obj->query("kill_by") != me)
    return notify_fail("乱切别人杀的人干嘛啊？\n");

  if (!objectp(weapon = me->query_temp("weapon")) || (
    (string)weapon->query("skill_type") != "sword" &&
    (string)weapon->query("skill_type") != "axe" &&
    (string)weapon->query("skill_type") != "hook" &&
    (string)weapon->query("skill_type") != "dagger" &&
    (string)weapon->query("skill_type") != "blade"))
    return notify_fail("你得用件锋利的器具才能切下这尸体的头来。\n");

  return do_kan(me, obj, weapon);
}

int do_kan(object me, object obj, object weapon) {
  object newob;
  string newname;

  if (!obj) return 0;
  if (obj->query("kantou") == 1) {
    message_vision("那具尸体已经没有首级了。\n", obj);
    return 1;
  }
  newname = obj->query("name");
  if (strsrch(newname, "腐烂的尸体") >= 0) {
    message_vision("那具尸体已经腐烂了。\n", obj);
    return 1;
  }
  if (strsrch(newname, "尸体") >= 0)
    newname = replace_string(newname, "尸体", "首级");
  else {
    message_vision(obj->query("name") + "有什么头可砍的。\n", obj);
    return 1;
  }
  newob = new("/clone/misc/head");
  newob->set("name", NOR + newname + NOR);
  newob->set("long", "这是一颗" + newname + "。\n");
  newob->set("age", obj->query("age"));
  newob->set("gender", obj->query("gender"));
  newob->set("kill_by", obj->query("kill_by"));
  newob->set("old_race", obj->query("old_race"));
  newob->set("victim_id", obj->query("victim_id"));
  newob->set("shouji", 1);
  newob->set("victim_exp", obj->query("victim_exp"));
  newob->set("victim_name", obj->query("victim_name"));
  newob->set("victim_user", obj->query("victim_user"));
  newob->set("victim_shen", obj->query("victim_shen"));
  newob->move(me);
  me->start_busy(1);
  message_vision("$N扬起" + weapon->query("name") + "，对准$n的脖子处猛地斩了下去！
只听“咔”的一声，$N将$n的首级斩了下来，提在手中。\n", me, obj);
  obj->set("kantou", 1);
  newname = obj->query("name");
  if (strsrch(newname, "尸体") >= 0)
    newname = replace_string(newname, "尸体", "无头尸体");
  obj->set("name", "无头尸体");
  obj->set("long", "这是一具无头尸体，静静地躺在这里，伤口平滑，是被快刃所切，看起来情状可怖。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : qie <尸体>
 
这个指令可以让你把尸体的头部切下来。

HELP
  );
  return 1;
}
