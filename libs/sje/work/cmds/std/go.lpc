// Modify by XiaoYao  2/15/99

inherit F_CLEAN_UP;

mapping default_dirs = ([
  "north": "北面",
  "south": "南面",
  "east": "东面",
  "west": "西面",
  "northup": "北边",
  "southup": "南边",
  "eastup": "东边",
  "westup": "西边",
  "northdown": "北边",
  "southdown": "南边",
  "eastdown": "东边",
  "westdown": "西边",
  "northeast": "东北",
  "northwest": "西北",
  "southeast": "东南",
  "southwest": "西南",
  "up": "上面",
  "down": "下面",
  "enter": "里面",
  "out": "外面"
]);

mapping object_dirs = ([
  "south": "北面",
  "north": "南面",
  "west": "东面",
  "east": "西面",
  "southup": "北边",
  "northup": "南边",
  "westup": "东边",
  "eastup": "西边",
  "southdown": "北边",
  "northdown": "南边",
  "westdown": "东边",
  "eastdown": "西边",
  "southwest": "东北",
  "southeast": "西北",
  "northeast": "东南",
  "northwest": "西南",
  "down": "上面",
  "up": "下面",
  "out": "里面",
  "enter": "外面"
]);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string dest, mout, min, dir, dir1;
  object env, obj, follow;
  //        mapping exit;
  object *f_obs, *gd, *guards;
  int current_jingli, cost;
  int jl_cost, jlcost_cnt;

  if (!arg) return notify_fail("你要往哪个方向走？\n");

  if (me->over_encumbranced())
    return notify_fail("你的负荷过重，动弹不得。\n");

  if (me->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");
  if (me->is_fighting()) {
    f_obs = me->query_enemy();
    if (objectp(f_obs[0]))
      if (2 + random((int)me->query_dex()) <=
        random((int)f_obs[0]->query_dex())) {
        me->start_busy(1);
        message_vision("$N转身想跑，被$n一把拦住：想溜？没门儿！\n", me, f_obs[0]);
        return notify_fail("你逃跑失败。\n");
      }
  }

  env = environment(me);
  if (!env) return notify_fail("你哪里也去不了。\n");

  if (!env->query("exits/" + arg)) {
    if (query_verb() == "go")
      return notify_fail("这个方向没有出路。\n");
    else
      return 0;
  }

  dest = env->query("exits/" + arg);

  if (!(obj = find_object(dest))) {
    call_other(dest, "???");
    if (!(obj = find_object(dest)))
      return notify_fail("无法移动。\n");
  }

  if (!env->valid_leave(me, arg)) {
    if (this_player() == me)
      write(query_notify_fail());
    return 1;
  }

  if (env->query("outdoors")) cost = 3;
  if (env->query("jingli_cost/" + arg) > 0) cost = env->query("jingli_cost/" + arg);
  if (userp(me) && !wizardp(me) && me->query("jingli") < cost)
    return notify_fail("你太累了，休息一下再走吧。\n");

  //////////////////////////////////////////////////////////////////////////////
  //add it and horse messgae,by wzfeng 98-10-17 
  //没有设置outdoors的room是室内,坐骑是不能进去的.
  //add horse can't move code by@wzfeng
  //////////////////////////////////////////////////////////////////////////////
  if (!obj->query("outdoors")) {
    if (me->query_temp("ride_horse")) {
      write("你不能骑着" + me->query_temp("ride_horse")->query("name") + "到那里去。\n");
      return 1;
    }
    if (me->query("can_ride"))
      return 0;

  }
  dir = obj->query("short");
  if (!undefinedp(default_dirs[arg]))
    dir = default_dirs[arg] + "的" + dir;

  dir1 = env->query("short");
  if (!undefinedp(object_dirs[arg]))
    dir1 = object_dirs[arg] + "的" + dir1;

  follow = me->query_temp("follow");
  mout = "";
  min = "";
  if (follow) {
    mout = "紧跟着$n";
    min = "紧跟着$n";
  }
  if (me->is_fighting()) {
    mout += "往" + dir + "落荒而逃了。\n";
    min += "从" + dir1 + "跌跌撞撞地跑了过来，模样有些狼狈。\n";
  } else {

    if (me->query_temp("ride_horse")) {
      mout += "骑着" + me->query_temp("ride_horse")->query("name") + "向" + dir;
      mout += "飞奔而去。\n";
      min += "骑着" + me->query_temp("ride_horse")->query("name") + "从" + dir1;
      min += "飞奔而来。\n";
    } else {
      mout += me->query_condition("killer") ? "神色慌张地" : "";
      mout += "往" + dir;
      mout += env->query("outdoors") ? "快步" : "";
      mout += "离开。\n";
      switch (me->query("race")) {
        case "人类":
          min += me->query_condition("killer") ? "神色慌张地" : "";
          min += "从" + dir1;
          min += env->query("outdoors") ? "快步" : "";
          min += "走了过来。\n";
          break;
        default:
          min += "从" + dir1 + "蹿了过来。\n";
      }
    }

  }
  //////////////////////////////////////////////////////////////////////////////
  //add it and horse messgae,by wzfeng 98-10-17 
  //当你骑在马上时是看不到马的信息的
  //////////////////////////////////////////////////////////////////////////////

  if (!wizardp(me) || !me->query("env/invisibility"))
    if (!me->query_temp("rider"))  //horse code by wzfeng
      tell_room(
        env,
        me->name() + replace_string(mout, "$n", follow ? follow->name() : ""),
        ({ me })
      );

  if (env->query("outdoors") && userp(me) && !wizardp(me))
    //如果骑在坐骑上是不减jingli的  
    if (!me->query_temp("ride_horse"))  //horse code by wzfeng
      me->receive_damage("jingli", 3);
  //马被骑时应该减jingli
  if (me->query_temp("rider"))
    me->receive_damage("jingli", 1);

  if (me->move(obj)) {
    reset_eval_cost();
    me->remove_all_enemy();
    if (!wizardp(me) || !me->query("env/invisibility")) {
      if (follow) {
        if (!me->query_temp("rider"))  //horse code by wzfeng
          tell_room(obj, me->name() + replace_string(min, "$n", follow->name()), ({ me, follow }));
        if (environment(follow) == obj)
          if (!me->query_temp("rider"))  //horse code by wzfeng
            tell_object(follow, me->name() + replace_string(min, "$n", "你"));
      } else if (!me->query_temp("rider"))  //horse code by wzfeng
        tell_room(obj, me->name() + min, ({ me }));
    }
    me->delete_temp("pending");
    all_inventory(env)->follow_me(me, arg);
    dest = me->query("startroom");
    if (!userp(me) && stringp(dest)) {
      min = implode(explode(dest, "/")[0..<2], "/");
      if (strsrch(base_name(environment(me)), min) != 1)
        me->return_home(dest);
    }
    return 1;
  }
  return 0;
}

void do_flee(object me) {
  mapping exits;
  string *directions;

  if (!environment(me) || !living(me)) return;
  exits = environment(me)->query("exits");
  if (!mapp(exits) || !sizeof(exits)) return;
  directions = keys(exits);
  tell_object(me, "看来该找机会逃跑了...\n");
  main(me, directions[random(sizeof(directions))]);
}

int help(object me) {
  write(@HELP
指令格式 : go <方向>
 
让你往指定的方向移动。
 
HELP
  );
  return 1;
}
