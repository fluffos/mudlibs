// shout.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {

  if (me->query("max_neili") < 4000)
    return notify_fail("以你目前的内力状况，无法使用千里传音。\n");
  if (me->query("neili") < 4000)
    return notify_fail("以你目前的内力状况，无法使用千里传音。\n");
  if (me->query_condition("shout_condition"))
    return notify_fail("你刚刚纵声长啸过，先休息一会再说吧。\n");
  /*        if( !wizardp(me) )
                return notify_fail("目前暂不开放玩家 shout。\n"); */
  if (!arg) return notify_fail("你想要大叫什么？\n");
  if (!wizardp(me)) {
    me->add("neili", -2500);
    me->apply_condition("shout_condition", 30);
  }
  efun::shout("\n" + HIW + me->name() + "纵声长啸：" + arg + NOR + "\n");
  write(HIW + "你纵声长啸：" + arg + NOR + "\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
  );
  return 1;
}
