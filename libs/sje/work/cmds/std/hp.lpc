// hp cmds (Tbh  02-09-22)

#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  string aaa, exp, bbb, shen, ccc, food, ddd, water, eee, expadd;
  object ob;
  int lmt, i = 0, j, k, l, m, n, o, p;
  mapping my;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));
  if (wizardp(me)) {
    if (!ob) ob = LOGIN_D->find_body(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");

    if (wiz_level(me) < wiz_level(ob))
      return notify_fail("他就在你身边，不用查了。\n");
  } else if (ob != me)
    return notify_fail("只有巫师能察看别人的状态。\n");

  if (ob->is_corpse() || !ob->is_character())
    return notify_fail("那不是活物耶！\n");

  my = ob->query_entire_dbase();

  if (userp(ob)) {
    lmt = my["combat_exp"];
    for (; i * i * i / 10 <= lmt; i++);
    my["max_pot"] = i + 100;
  }

  write(sprintf("\n ·精血· %s%4d/ %4d %s(%3d%%)" NOR "    ·精力· %s%4d / %4d %s(%3d%%)\n" NOR,
    status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
    status_color(my["eff_jing"], my["max_jing"]), my["eff_jing"] * 100 / my["max_jing"],
    status_color(my["jingli"], my["eff_jingli"]), my["jingli"], my["eff_jingli"],
    status_color(my["jingli"], my["eff_jingli"]), my["jingli"] * 100 / my["eff_jingli"]));
  write(sprintf(" ·气血· %s%4d/ %4d %s(%3d%%)" NOR "    ·内力· %s%4d / %4d (+%d)\n" NOR,
    status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
    status_color(my["eff_qi"], my["max_qi"]), my["eff_qi"] * 100 / my["max_qi"],
    status_color(my["neili"], my["max_neili"]), my["neili"], my["max_neili"], my["jiali"]));

  if (ob->query("shen") >= 0) shen = "" + ob->query("shen");
  else shen = "" + ob->query("shen") * -1;

  bbb = shen;
  if (strlen(shen) == 1) bbb = shen[0..0] + "          ";
  if (strlen(shen) == 2) bbb = shen[0..1] + "         ";
  if (strlen(shen) == 3) bbb = shen[0..2] + "        ";
  if (strlen(shen) == 4) bbb = shen[0..0] + "," + shen[1..3] + "      ";
  if (strlen(shen) == 5) bbb = shen[0..1] + "," + shen[2..4] + "     ";
  if (strlen(shen) == 6) bbb = shen[0..2] + "," + shen[3..5] + "    ";
  if (strlen(shen) == 7) bbb = shen[0..0] + "," + shen[1..3] + "," + shen[4..6] + "  ";
  if (strlen(shen) == 8) bbb = shen[0..1] + "," + shen[2..4] + "," + shen[5..7] + " ";
  if (strlen(shen) == 9) bbb = shen[0..2] + "," + shen[3..5] + "," + shen[6..8];

  write(sprintf(" %s%s " + bbb + "     " NOR,
    my["shen"] < 0 ? "·戾气·" HIR "" : "·正气·" HIC "", BOLD,));

  write(sprintf(" ·内力上限· %s%d / %d\n" NOR, HIC,
    ob->query_skill("force") * 8 + my["combat_exp"] / 1000,
    ob->query_skill("force") * 10 + my["con"] * my["age"] + my["combat_exp"] / 1000));

  food = "" + my["food"] * 10000 / ob->max_food_capacity();
  ccc = food;

  if (strlen(food) == 1) ccc = "  0.0" + food[0..0];
  if (strlen(food) == 2) ccc = "  0." + food[0..1];
  if (strlen(food) == 3) ccc = "  " + food[0..0] + "." + food[1..2];
  if (strlen(food) == 4) ccc = " " + food[0..1] + "." + food[2..3];
  if (strlen(food) == 5) ccc = food[0..2] + "." + food[3..4];
  if (strlen(food) == 6) ccc = food[0..3] + "." + food[4..5];
  if (strlen(food) == 7) ccc = food[0..4] + "." + food[5..6];
  if (strlen(food) == 8) ccc = food[0..5] + "." + food[6..7];
  if (strlen(food) == 9) ccc = food[0..6] + "." + food[7..8];

  write(sprintf(" ·食物· %s" + ccc + "%%     " NOR "         ·潜能· %s%d / %d\n" NOR,
    status_color(my["food"], ob->max_food_capacity()),
    HIY, (int)ob->query("potential"), (int)ob->query("max_pot")));

  water = "" + my["water"] * 10000 / ob->max_water_capacity();
  ddd = water;

  if (strlen(water) == 1) ddd = "  0.0" + water[0..0];
  if (strlen(water) == 2) ddd = "  0." + water[0..1];
  if (strlen(water) == 3) ddd = "  " + water[0..0] + "." + water[1..2];
  if (strlen(water) == 4) ddd = " " + water[0..1] + "." + water[2..3];
  if (strlen(water) == 5) ddd = water[0..2] + "." + water[3..4];
  if (strlen(water) == 6) ddd = water[0..3] + "." + water[4..5];
  if (strlen(water) == 7) ddd = water[0..4] + "." + water[5..6];
  if (strlen(water) == 8) ddd = water[0..5] + "." + water[6..7];
  if (strlen(water) == 9) ddd = water[0..6] + "." + water[7..8];

  write(sprintf(" ·饮水· %s" + ddd + "%%      " NOR "        " NOR,
    status_color(my["water"], ob->max_water_capacity()),));

  exp = "" + ob->query("combat_exp");
  aaa = exp;

  if (strlen(exp) == 4) aaa = exp[0..0] + "," + exp[1..3];
  if (strlen(exp) == 5) aaa = exp[0..1] + "," + exp[2..4];
  if (strlen(exp) == 6) aaa = exp[0..2] + "," + exp[3..5];
  if (strlen(exp) == 7) aaa = exp[0..0] + "," + exp[1..3] + "," + exp[4..6];
  if (strlen(exp) == 8) aaa = exp[0..1] + "," + exp[2..4] + "," + exp[5..7];
  if (strlen(exp) == 9) aaa = exp[0..2] + "," + exp[3..5] + "," + exp[6..8];


  j = ob->query("max_pot") - 100; k = ob->query("max_pot") - 101;
  l = j * j * j / 10; m = k * k * k / 10;
  n = l - m;  //升级所要的经验
  o = ob->query("combat_exp") - m;
  p = o * 10000 / n;

  expadd = "" + p;
  eee = expadd;

  if (strlen(expadd) == 1) eee = "0.0" + expadd[0..0];
  if (strlen(expadd) == 2) eee = "0." + expadd[0..1];
  if (strlen(expadd) == 3) eee = expadd[0..0] + "." + expadd[1..2];
  if (strlen(expadd) == 4) eee = expadd[0..1] + "." + expadd[2..3];
  if (strlen(expadd) == 5) eee = expadd[0..2] + "." + expadd[3..4];
  if (strlen(expadd) == 6) eee = expadd[0..3] + "." + expadd[4..5];
  if (strlen(expadd) == 7) eee = expadd[0..4] + "." + expadd[5..6];
  if (strlen(expadd) == 8) eee = expadd[0..5] + "." + expadd[6..7];
  if (strlen(expadd) == 9) eee = expadd[0..6] + "." + expadd[7..8];
  if (ob->query("max_pot") == 0) eee = "0.00";

  write("·经验· " HIM + aaa + " (" + eee + "%)\n" NOR);

  return 1;
}

string status_color(int current, int max) {
  int percent;

  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int help(object me) {
  write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)

这个指令可以显示你(你)或指定对象(不含怪物)的精, 气, 神数值。
 
see also : score
HELP
  );
  return 1;
}
