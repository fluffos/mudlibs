// Tbh 2002.4.10 (tbhcn@citiz.net)
// lineup.c

#include <ansi.h>

inherit F_CLEAN_UP;

inherit F_SSERVER;

int check_fight(object me);
int check_fight2(object me);

int main(object me, string arg)
{
	object where, host, *t;
	int i;
	where = environment(me);
	t = all_inventory(environment(me)); 

//     return notify_fail("Lineup 暂时关闭。\n");

	if( !arg ) {
		if( !me->query_temp("lineup") )
			return notify_fail("你现在并没有加入任何阵法。\n");
		if( me->query_temp("lineup") == me->query("id") && me->query_temp("lineup_limit") < 2 )
			return notify_fail("你现在并没有加入任何阵法。\n");
		write("你现在阵法中的成员有：\n  " +  me->name() );

		for(i=0; i<sizeof(t); i++)
		{ 
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue; 
		if( t[i]->query_temp("lineup") == me->query_temp("lineup") )
			write("\n  " + t[i]->name() );
		}
		write("。\n");
		return 1;
	}

	if( arg=="dismiss" ) {
		if( !me->query_temp("lineup") )
			return notify_fail("你现在并没有加入任何阵法。\n");
		if( me->query_temp("lineup") == me->query("id") ) {
			message_vision("$N将阵法解散了。\n", me);

		for(i=0; i<sizeof(t); i++)
		{ 
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue; 
		if( t[i]->query_temp("lineup") == me->query_temp("lineup") ) {
		t[i]->delete_temp("lineup_room");
		t[i]->delete_temp("lineup_name");
		t[i]->delete_temp("lineup_limit");
		t[i]->delete_temp("lineup");
		}}

		} else {
			message_vision("$N决定脱离阵法。\n", me);
			host = present(me->query_temp("lineup"), environment(me));
			host->add_temp("lineup_limit", -1); 
		}
		me->delete_temp("lineup_room");
		me->delete_temp("lineup_name");
		me->delete_temp("lineup_limit");
		me->delete_temp("lineup");
		return 1;
	}

	if( arg=="refuse" ) {
		if( !me->query_temp("lineup_with") )
			return notify_fail("现在并没有人邀请你加入阵法。\n");
		message_vision("$N拒绝了对方加入阵法的邀请。\n", me);
		me->delete_temp("lineup_with");
		return 1;
	}

	if( sscanf(arg, "with %s", arg)==1 ) {
		object ob;

		if( !(ob = present(arg, environment(me)))
		||	!living(ob)
		||	!ob->is_character()
		||	ob==me )
			return notify_fail("你想和谁一起布阵？\n");

		if( me->query_temp("lineup_with") == ob->query("id") ) {

			if( ob->query_temp("lineup") != ob->query("id") )
				return notify_fail("只有阵法的主持者可以邀请别人加入。\n");

			if( me->query_temp("lineup") == me->query("id") )
				return notify_fail("你目前也在布阵，无法接受" + ob->query("name") + "的邀请。\n");

			if( me->query_temp("lineup") == ob->query_temp("lineup") )
				return notify_fail("你目前已经加入了" + ob->query("name") + "的阵法。\n");

			if( me->query_skill(ob->query_temp("lineup_name"), 1) < 1 )
				return notify_fail("你不懂这种阵法，无法加入。\n");

			if( ob->query_temp("lineup_limit") >= SKILL_D(ob->query_temp("lineup_name"))->query_limit() )
				return notify_fail(to_chinese(ob->query_temp("lineup_name")) + "的人数已满，你无法加入。\n");

			message_vision("$N决定加入$n的阵法。\n", me, ob);
			ob->add_temp("lineup_limit", 1);
			me->delete_temp("lineup_with");
			me->set_temp("lineup",  ob->query("id") );
			me->set_temp("lineup_room",  ob->query_temp("lineup_room") );
			me->set_temp("lineup_name",  ob->query_temp("lineup_name") );
			call_out("check_fight2", 1, me);
			return 1;

		} else if( me->query_temp("lineup") || me->query_temp("lineup_name") ) {

			if( me->query_temp("lineup") != me->query("id") )
				return notify_fail("只有主持阵法者才可以邀请别人加入。\n");

			if( ob->query_temp("lineup_with") == me->query("id") )
				return notify_fail("你已经邀请过对方了。\n");

			if( ob->query_temp("lineup") == ob->query("id") )
				return notify_fail("对方目前也在布阵，无法接受你的邀请。\n");

			if( ob->query_skill(me->query_temp("lineup_name"), 1) < 1 )
				return notify_fail("对方不懂这种阵法，无法加入。\n");

			if( ob->query_temp("lineup") == me->query_temp("lineup") )
				return notify_fail(ob->query("name") + "目前已经加入了你的阵法。\n");

			if( me->query_temp("lineup_limit") >= SKILL_D(me->query_temp("lineup_name"))->query_limit() )
				return notify_fail(to_chinese(me->query_temp("lineup_name")) + "的人数已满，你无法邀请" + ob->query("name") + "加入。\n");

			message_vision("$N邀请$n加入$P的" + to_chinese(me->query_temp("lineup_name")) + "。\n", me, ob);
			tell_object(ob, YEL "如果你愿意加入，请用 lineup with " + me->query("id") + "。\n" NOR);
			ob->set_temp("lineup_with", me->query("id") );
			return 1;
		}
		else return notify_fail("你没有选择要主持哪种阵法。\n");
	}

	if( sscanf(arg, "form %s", arg)==1 ) {
		if( !me->query_skill(arg, 1) )
			return notify_fail("这种阵形你没有学过。\n");
		if( SKILL_D(arg)->type() != "array" )
			return notify_fail("这种武功不是阵法。\n");
		if( me->query_temp("lineup") )
			return notify_fail("你必须首先退出当前的阵法才能组织新的阵法。\n");
		if( me->query_temp("lineup_with") )
			return notify_fail("现在正有人邀请你加入，你必须首先拒绝对方才能组织新的阵法。\n");

		message_vision(HIY"$N鼓足真气，纵声长啸：“布" + to_chinese(arg) + "”，声音滚滚地传了出去。\n"NOR, me);
		me->set_temp("lineup_room", environment(me));
		me->set_temp("lineup_name", arg);
		me->set_temp("lineup_limit", 1);
		me->set_temp("lineup", me->query("id"));
		call_out("check_fight", 1, me);
		return 1;

	}
}

int check_fight(object me)
{
	object target, *t;
	int i, level, limit;
	target = offensive_target(me);
	t = all_inventory(environment(me));
	level = me->query_skill(me->query_temp("lineup_name"), 1);
	if (me->query_temp("lineup_name") == "wuxing-zhen") level = level/2;

	if( me->query_temp("lineup_room") != environment(me)) {
		if( me->query_temp("lineup_level") ) me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
		me->delete_temp("lineup_level");
		message_vision(HIY"阵主已经不在主持阵法的位置上，阵法解散。\n"NOR, me);
		me->delete_temp("lineup_room");
		me->delete_temp("lineup_name");
		me->delete_temp("lineup_limit");
		me->delete_temp("lineup");
		return 1;
	}

	if( me->query_temp("lineup_level") &&  !me->is_fighting() ) {
		me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
		me->delete_temp("lineup_level");
	}

	for(i=0; i<sizeof(t); i++)
	{ 
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue;
		if( t[i]->query_temp("lineup") != me->query_temp("lineup") || t[i]->is_fighting(me) )
			continue;
		if( t[i]->is_fighting(target) && me->is_fighting(target) ) {
			if( !me->query_temp("lineup_level") ) {
				me->add_temp("apply/dodge", level/2);
				me->set_temp("lineup_level", level/2);
			}
			message_vision(SKILL_D(me->query_temp("lineup_name"))->query_action(me), me, target);
			if( random(2) && !target->is_busy() ) target->start_busy(1);
		} else if( me->query_temp("lineup_level") ) {
			me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
			me->delete_temp("lineup_level");
		}
	}

		limit = 1;
	for(i=0; i<sizeof(t); i++)
		{
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue; 
		if( t[i]->query_temp("lineup") == me->query_temp("lineup") )
		limit = limit + 1;
		}

	if( me->query_temp("lineup_limit") > limit ) {
		message_vision(HIY"因为有人脱离阵法，阵法的威力受到影响。\n"NOR, me);
		me->set_temp("lineup_limit", limit);
	}

	call_out("check_fight", 1, me);
	return 1;
}       

int check_fight2(object me)
{
	object target, *t;
	int i, level, limit;
	target = offensive_target(me);
	t = all_inventory(environment(me));
	level = me->query_skill(me->query_temp("lineup_name"), 1);
	if (me->query_temp("lineup_name") == "wuxing-zhen") level = level/2;

	if( me->query_temp("lineup_room") != environment(me)) {
		if( me->query_temp("lineup_level") ) me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
		me->delete_temp("lineup_level");
		me->delete_temp("lineup_room");
		me->delete_temp("lineup_name");
		me->delete_temp("lineup_limit");
		me->delete_temp("lineup");
		return 1;
	}

	if( me->query_temp("lineup_level") &&  !me->is_fighting() ) {
		me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
		me->delete_temp("lineup_level");
	}

	for(i=0; i<sizeof(t); i++)
	{ 
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue;
		if( t[i]->query_temp("lineup") != t[i]->query("id") || t[i]->is_fighting(me) )
			continue;
		if( t[i]->is_fighting(target) && me->is_fighting(target) ) {
			if( !me->query_temp("lineup_level") ) {
				me->add_temp("apply/dodge", level/2);
				me->set_temp("lineup_level", level/2);
			}
		if( !random(3) ) message_vision(SKILL_D(me->query_temp("lineup_name"))->query_action(me), me, target);
		} else if( me->query_temp("lineup_level") ) {
			me->add_temp("apply/dodge", -me->query_temp("lineup_level") );
			me->delete_temp("lineup_level");
		}
	}

	for(i=0; i<sizeof(t); i++)
		{
		if( !living(t[i]) || t[i]==me ) 
			continue;
		if( !t[i] || !t[i]->is_character())
			continue; 
		if( t[i]->query_temp("lineup") == t[i]->query("id") )
		limit = 1;
		}

	if( !limit || limit < 1 ) {
		me->delete_temp("lineup_level");
		me->delete_temp("lineup_room");
		me->delete_temp("lineup_name");
		me->delete_temp("lineup_limit");
		me->delete_temp("lineup");
	}

	call_out("check_fight2", 1, me);
	return 1;
}       

int help(object me)
{
	write(@HELP
阵法指令使用方法:

lineup form <阵法> - 组织某种阵法，组成阵法的状态只要一移动就会解除。
lineup with <某人> - 跟某人组成阵法，自己或对方必须是某个阵法的主持者。
lineup dismiss     - 离开阵法。若下此指令的是阵法的主持者, 则整个阵法会解散。
lineup refuse      - 拒绝加入阵法的邀请。

直接下 lineup 指令时则会显示你目前是否加入阵法及阵法成员名单。
HELP
	);
	return 1;
}
