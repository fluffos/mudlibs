 -----------------------------------------
 * File   : _object_action_mod.c
 * Author : Clode@RevivalWorld
 * Note   : object action module -- missing from this archive entirely
 *          (no file, no OBJECT_ACTION_MOD macro anywhere), unlike its two
 *          siblings PRODUCT_ACTION_MOD/ROOM_ACTION_MOD which both DO ship
 *          with the archive. Reconstructed here using the exact same
 *          template both siblings already use verbatim (only the
 *          query_*_info() accessor name differs, matching the "object"
 *          shape used by furniture/tools/vehicle items in std/module/
 *          object/*), since 6 real content files (chest/stool/chair/car/
 *          rod/ring) inherit OBJECT_ACTION_MOD and fail to compile
 *          without it -- not fabricated new game content, just
 *          restoring an evidently-omitted piece of shared boilerplate
 *          infrastructure that already exists twice elsewhere in the
 *          same codebase with this exact shape.
 -----------------------------------------
 */

void create() {
  string this_basename = base_name(this_object()) + ".lpc";

  // 暴力更新所有使用此模組之物件 action...
  objects((: $1->query_module_file() == $(this_basename) :))->enable_action();
}

mapping query_object_info() {
  return fetch_variable("object_info");
}
