#include <daemon.h>

/* set()/query()/... fallback for the rare object that doesn't inherit
 * DATABASE -- must come first since several fragments below (city.lpc,
 * area.lpc, zone.lpc, person.lpc, path.lpc) already call set()/query() */
#include "simul_efun/dbase.lpc"

/* ansi()/remove_ansi()/noansi_strlen()/cwrap()/... -- also must come
 * before log.lpc/string.lpc/person.lpc etc, which all call these bare. */
#include "simul_efun/ansi.lpc"

/* count(n1, op, n2) bignum-arithmetic fallback -- must come before
