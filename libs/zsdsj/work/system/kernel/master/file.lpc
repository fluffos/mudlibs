/* 判斷一個指定物件所屬的區域 */  //不知道能做啥 by Clode
/* 驅動的 mudlib_stats 在載入主控時問一次 domain_file("/") 和 author_file(主控檔),
 * 拿不到字串就每次開機都印一行警告。回傳 get_bb_uid()/get_root_uid() 正是驅動
 * 缺省時用的值; 域等於 backbone 域時, 物件沿用創造者的域, 與空函式回傳 0 時
 * 相同 (KB 06 §7.222)。兩者定義在 master.lpc 裡本檔被 #include 之後。 */
string get_root_uid();
string get_bb_uid();

string domain_file(string str) {
  return get_bb_uid();
}

/* 判斷一個指定物件的作者為誰 */
/* 需定義 PACKAGE_MUDLIB_STATS  */
string author_file(string str) {  //也是不知道能做啥..難道用來弄chown? :p by Clode
  return get_root_uid();
}

/* 為新創造的物件指定一個隱私字串 */
/* 需定義 PRIVS */
string privs_file(string filename) {
  return filename;
}

/* 這個驅動程式開啟 AUTO_SETEUID/PACKAGE_UIDS, 每次新建物件都會呼叫
 * master::creator_file() 決定 uid (原本這個 lib 完全沒實作這個 apply,
 * 導致每一次 new() 都直接 error, 從第一個 new(LOGIN_OB) 就開始爆炸)。
 * 見 AGENTS.md §7 (get_root_uid/get_bb_uid 同一類缺口)。*/
string creator_file(string filename) {
  return "ROOT";
}
