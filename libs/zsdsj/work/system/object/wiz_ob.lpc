#include <daemon.h>
#include <inherit.h>

inherit INTERACTIVE_WIZ;

int is_user_ob() {
  return 1;
}

private nomask void dest() {
  LOGOUT_D->quit(this_object());
}

private nomask void net_dead() {
  set_temp("net_dead", call_out((: dest :), 300));
  set_temp("net_dead_time", time());
  LOGOUT_D->net_dead(this_object());
}

nomask void reconnect() {
  if (query_temp("net_dead")) {
    remove_call_out(query_temp("net_dead"));
    delete_temp("net_dead");
    // Net dead time delete at login_d.c
  }
}

// See ppl_ob.lpc's identical function for the full explanation:
// set_living_name()/enable_commands() always operate on this_object(),
// so this has to be a real function defined on the wizard body itself
// and invoked via `->`. Both are required for find_player() to work at
// all on this driver (FluffOS's find_living_object() requires the
// O_ENABLE_COMMANDS flag regardless of living name).
nomask void register_living_name() {
  string id = this_object()->query_id(1);

  if (stringp(id))
    set_living_name(id);

  enable_commands();
}

nomask string query_save_file() {
  if (this_object()->is_living())
    return file_name(this_object()) + "/data.o";

  return 0;
}

private void write_prompt() {
  // 不加這個會造成 prompt 顯示問題
}

private void create() {}
