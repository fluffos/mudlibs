#include <ansi.h>
#include <inherit.h>
#include <feature.h>
#include <equipment.h>
#include <buff.h>

inherit STANDARD_OBJECT;
inherit EQUIPMENT;

void create() {
  set_idname(HIB "night " NOR BLU "lotus" NOR, HIB "夜舒" NOR BLU "荷" NOR);
  set_temp("status", HIC "稀" NOR CYN "有");

  if (this_object()->set_shadow_ob()) return;

  set("long", "晉人王嘉「拾遺記」云：「漢靈帝西園渠中植蓮，大如蓋，\n長一丈，其葉夜舒書卷，名曰夜舒荷。」\n");
  set("unit", "株");
  set("mass", 0);
  set("value", 6000000);
  set("flag/no_amount", 1);
  set(BUFF_CHA, 30);
  set(BUFF_SOCIAL_EXP_BONUS, 5);
  set("buff/status", HIB "夜舒" NOR BLU "荷" NOR);

  ::setup_equipment(EQ_BROOCH, HIG "胸" NOR GRN "針" NOR);
}
