#include <ansi.h>
#include <inherit.h>

inherit STANDARD_OBJECT;

void create() {
  set_idname("sailfish", HIW "旗魚" NOR);

  if (this_object()->set_shadow_ob()) return;

  set("unit", "條");
  set("value", 900);
  set("mass", 70);
}
