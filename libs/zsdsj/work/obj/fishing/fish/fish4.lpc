#include <ansi.h>
#include <inherit.h>

inherit STANDARD_OBJECT;

void create() {
  set_idname("fish", HIC "鮭魚" NOR);

  if (this_object()->set_shadow_ob()) return;

  set("unit", "條");
  set("value", 320);
  set("mass", 30);
}
