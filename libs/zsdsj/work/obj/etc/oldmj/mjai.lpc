#include <ansi.h>
#include <inherit.h>

#define NAMES	({ \
"鹿小滑 Deer-1",\
"藤原文太 AE-86",\
"藤原拓海 AE-86",\
"立花佑一 FD-3S",\
"武內樹 AE-85",\
"池谷浩一郎 S-13",\
"健二 180SX",\
"高橋涼介 FC-3S",\
"高橋啟介 FD-3S",\
"中村賢太 S-14",\
"中里毅 R32-GTR",\
"庄治慎吾 EG6",\
"沙雪 180SX",\
"岩城清次 LAN EVO Ⅳ",\
"須藤京一 LAN EVO Ⅲ",\
"秋山涉 AE-86",\
"小柏魁 SW20",\
"小柏健 SW20", })

inherit STANDARD_NPC;

varargs void create(int i) {
  int j, flag;
  object child;
  string name;

  while (name = NAMES[random(sizeof(NAMES))]) {
    flag = 0;
    foreach (child in children(base_name(this_object())))
      if (query("name", child) == name) {
        flag = 1;
        break;
      }
    if (flag == 0) break;
    if (j++ > 20) break;
  }

  set_idname("AI-" + i, HIW + name + NOR);
  set("name", name);
  set("unit", "位");
  startup_living();
}
