#include <feature.h>
#include <ansi.h>
#include <daemon.h>

inherit COMMAND;

string help = @HELP
        這個指令可查詢目前 mud 中有使用 SCHEDULE_D 函數延持呼叫的項目。
HELP;

private void command(object me, string arg) {
  mapping info;
  string msg;

  msg = sprintf("%6s %-20s %-25s %-40s\n", "延遲", "呼叫函數", "物件", "參數");
  msg += "──────────────────────────────────────────\n";

  info = SCHEDULE_D->query_events();

  foreach (int key in keys(info)) {
    msg += sprintf("%6d %-20s %-25O %-40s\n",
      info[key][2] - info[key][1],
      info[key][4],
      info[key][3],
      (sizeof(info[key]) > 5 ? info[key][5] : "無")
    );
  }

  if (!sizeof(info))
    msg += "目前沒有程序呼叫中。\n";

  msg += "──────────────────────────────────────────\n";
  msg += NOR WHT " 函式呼叫─ " NOR "目前有 " + sizeof(info) + " 個程序延遲呼叫中。\n";

  me->more(msg);
}
