// Created by Lonely
// #pragma optimize all

#include <ansi.h>
#include <localtime.h>
inherit F_DBASE;

void init_smtp();
void shaneling();
void search();

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "侠客令精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "侠客岛令已经启动。");
  // init_smtp();
  remove_call_out("shaneling");
  call_out("shaneling", 1);
}

void shaneling() {
  mixed lt;

  seteuid(ROOT_UID);
  lt = localtime(time());

  /*
        string week;
        int hour, min, sec;
        // ctime (time()) = "Tue Aug 13 05:44:05 2002"
        sscnaf (ctime(time()), "%s %*s %*d %d:%d:%d %*s", week, hour, min, sec = 4);
        */
  // 每个星期六的晚上２１点２１分２１秒侠客岛腊八粥大会举行
  // if (lt[6] == 6 && lt[LT_HOUR] == 21 && lt[LT_MIN] == 21 && lt[LT_SEC] == 21)
  if (lt[LT_HOUR] == 21 && lt[LT_MIN] == 21 && (lt[LT_SEC] == 20 || lt[LT_SEC] == 21))
    search();
  // remove_call_out("shaneling");
  call_out("shaneling", 1);
}

void search() {
  int i;
  object *obs, ob, obj;

  CHANNEL_D->do_channel(this_object(), "rumor",
    "侠客岛十年一次的腊八粥大会即将开始。");
  CHANNEL_D->do_channel(this_object(), "rumor",
    "侠客岛使者张三和李四受侠客岛龙岛主和木岛主之命开始发放赏善罚恶令。\n");
  message("channel:rumor",
    HIC "【泥潭典故】南贤：听说侠客岛的腊八粥大会只邀请那些在江湖中赫赫有名的侠客参加，焉知福兮祸兮。\n\n" NOR,
    users());

  obs = filter_array(users(),
    (: $1->query("combat_exp") >= 1000000 &&
    $1->query("weiwang") >= 1000 &&
    !$1->is_in_prison() &&
    !$1->is_ghost() &&
    !wizardp($1) &&
    environment($1) :));
  if (!sizeof(obs))
    return;

  foreach (ob in obs) {
    if (objectp(obj = present("shan pai", ob)) && objectp(obj = present("e pai", ob)))
      continue;

    message_vision("侠客岛使者张三和李四突然出现在$N面前，冷冷的盯着$N一会说道：我们受岛主之命赠送$N赏善罚恶令。\n", ob);
    obj = new("/d/xiakedao/obj/tongpai1");
    obj->set_temp("own", ob->query("id"));
    obj->move(ob);
    obj = new("/d/xiakedao/obj/tongpai2");
    obj->set_temp("own", ob->query("id"));
    obj->move(ob);
    message_vision("侠客岛使者张三和李四给了$N一对赏善罚恶令。\n", ob);
    tell_object(ob, "侠客岛使者张三和李四对你说到，请务必去侠客岛参加十年一次的腊八粥大会。\n");
    message_vision("$N还没有反映过来，只见侠客岛使者张三和李四已施展太玄功，腾空飞去。\n", ob);
  }
}

