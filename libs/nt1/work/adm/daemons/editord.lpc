#define NT_ARCHIVE "/data/archive/"
#define NT_EDITOR  "/data/wenxuan/"

string *Articles;

void create()
{
	seteuid(getuid());
}

int add(int arc, string article, string fname)
{
	string filename;

	if (arc)
	{
		if (fname)
		        filename = NT_ARCHIVE + fname;
	        else
		        filename = NT_ARCHIVE + "Unknown";
	}
	else
	{
	        if (fname)
		        filename = NT_EDITOR + fname;
	        else
		        filename = NT_EDITOR + "Unknown";
	}


	Articles = ({article});

	if (file_size(filename) <= 0)
		return (write_file(filename, Articles[sizeof(Articles)-1] + "\n", 1));

	return (write_file(filename, Articles[sizeof(Articles)-1] + "\n", 0));
}

int get_file_num(int arc, string year, string month)
{
	string filename;
	string text;
	int i, numb, size;
	string base;
	numb = 0;

	if (month)
	{
		if (arc)
                        filename = NT_ARCHIVE + "/" + year + "/Wenxuan." + month;
		else
                        filename = NT_EDITOR + "/" + year + "/Wenxuan." + month;
	}
	else
		return (-1);
	
        base = NT_EDITOR + "/" + year + "/";
        if (file_size(base) != -2) 
                mkdir(base);

	base = NT_EDITOR + "/" + year + "/" + month + "/";
        if (file_size(base) != -2)
	        mkdir(base);
	
	base = NT_ARCHIVE + "/" + year + "/";
	if (file_size(base) != -2) 
                mkdir(base);
        
        base = NT_ARCHIVE + "/" + year + "/" + month + "/";
        if (file_size(base) != -2)
	        mkdir(base);
	
	if (file_size(filename) < 0)
		return (numb);

	/* read in the whole file */
	text = read_file(filename);

	size = sizeof(text);
	
	for (i = size ; i > 0; i--)
	{
		if ( text[i] == '\n' && text[i+1..i+2] == "№")
		{
			numb = atoi(text[i+3..i+5]);
			break;
		}
	}

	if ( numb < 2 && text[0..1] == "№" )
		numb = 1;

	return (numb);
}
