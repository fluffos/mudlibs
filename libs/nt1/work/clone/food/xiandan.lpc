// xiandan.c

#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIR "蟠桃" NOR, ({ "pan tao", "pan", "tao", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗充满神秘诱惑的蟠桃，是黑客从天庭蟠桃园偷来得！\n");
    set("value", 1000);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  int fw;

  me->set("food", 8 * me->max_food_capacity());
  me->set("water", 8 * me->max_water_capacity());
  message_vision(HIR "$N吃下一颗蟠桃，顿时全身充满力量！\n" NOR, me);
  destruct(this_object());
  return 1;
}
