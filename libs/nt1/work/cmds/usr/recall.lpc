// recall.c
// created by ken@nitan

#include <ansi.h>
inherit F_CLEAN_UP;

#define HOME_PLACE "/d/city/chatroom.lpc"

int help(object me);

int main(object me, string arg) {
  object ob;

  if (!environment(me)) return 0;

  if (playerp(me) && (!stringp(me->query("born")) || !me->query("born")))
    return notify_fail("等你出生了再说吧。\n");

  if (me->is_fighting())
    return notify_fail("战斗中又怎能诚心祈求？。\n");

  if (me->is_busy())
    return notify_fail("你正忙著呢。\n");

  if (me->is_ghost())
    return notify_fail("等你还了阳再说吧。\n");

  if (me->is_in_prison())
    return notify_fail("你正在做牢呢，天神不会帮你的！\n");

  if (me->query("doing"))
    return notify_fail("你还想干什么？！\n");

  if (me->query("age") > 16)
    return notify_fail("天神对你说道：今后的路要靠你自己走了，相信你自己！\n");

  if (me->query_temp("jun_quest/party"))
    return notify_fail("你还想在战争中使用？！\n");

  if (present("biao huo", me))
    return notify_fail("你身上带著镖银！\n");

  if (present("letter", me) || present("receipt", me))
    return notify_fail("你身上带著密函\n");

  if (environment(me)->query("no_magic") || environment(me)->query("no_fly"))
    return notify_fail("你发现这里有点古怪，天神似乎感应不到你的求救！\n");


  ob = first_inventory(me);
  while (ob) {
    if (ob->is_character() && !ob->is_corpse())
      return notify_fail(ob->name() + "还在你身上呢！\n");
    ob = next_inventory(ob);
  }

  if (!get_object(HOME_PLACE))
    return notify_fail("你感觉到似乎有什么不对劲！\n");

  if (environment(me)->query("short") == load_object(HOME_PLACE)->query("short"))
    return notify_fail("你现在已经在大榕树上了。\n");

  // message("vision", me->name() + "“扑通”一声跪了下来，满脸虔诚地祈求天神把他带回「" + HOME_PLACE->query("short") + NOR "」上。\n",
  message("vision", me->name() + "举起右手在面前极速画了一个圆，竟划破了面前的空间，只见圆内的空间真空将" + me->name() + "给吸了进去。\n",
    environment(me), ({ me }));

  tell_object(me, "你从" + HOME_PLACE->query("short") + "的角落空间裂缝中钻出。\n");

  me->move(HOME_PLACE);
  message("vision", me->name() + "从大榕树的角落空间裂缝中钻出。\n",
    environment(me), ({ me }));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : recall
当你迷路时, 你可以使用这个指令把你带回大榕树上。这个指令只
在非战斗状态才有效。
HELP
  );
  return 1;
}
