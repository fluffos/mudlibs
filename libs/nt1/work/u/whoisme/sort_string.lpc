52 string sort_string(string input, int width, int prefix) 53 {
  54 # ifdef DOING_IMPROVED 55 return efun::sort_string(input, width, prefix);
  56 # else
    57 int i;
  58 int sl;
  59 int len;
  60 int esc;
  61 string result;
  62 63 result = "";
  64 65 len = prefix;
  66 esc = 0;
  67 sl = strlen(input);
  68 for (i = 0; i < sl; i++)
    69 {
      70 if (len >= width && input[i] != '\n')
        71 {
          72 int k;
          73 k = i;
          74 if (input[i] == 27)
            75 while (k < sl && input[k++] != 'm');
          76 77 switch ((k < sl - 1) ? input[k..k + 1] : 0) 78 {
            79 case "：": 80 case "”": 81 case "。": 82 case "，": 83 case "；": 84 case "）": 85 case " )": 86 case "！": 87 case "？": 88 case "、": 89 if (k != i)
              90 {
                91 result += input[i..k + 1];
                92 i = k + 1;
                93 continue;
                94
              }
            95 break;
            96 default: 97 len = 0;
            98 result += "\n";
            99 break;
            100
          }
          101
        }
      102 103 if (input[i] == 27)
        104 esc = 1;
      105 106 if (!esc)
        107 {
          108 if (input[i] > 160)
            109 {
              110 result += input[i..i + 1];
              111 i++;
              112 len += 2;
              113 continue;
              114
            }
          115 if (input[i] == '\n')
            116 {
              117 result += "\n";
              118 len = 0;
              119 continue;
              120
            }
          121
        }
      122 123 result += input[i..i];
      124 if (!esc) len++;
      125 126 if (esc && input[i] == 'm')
        127 esc = 0;
      128
    }
  129 130 if (i < sl)
    131 result += input[i..sl - 1];
  132 133 if (len) result += "\n";
  134 135 return result;
  136 # endif 137
}
