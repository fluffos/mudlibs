// pijiu.c  啤酒 

#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(HIG "黑客牌啤酒" NOR, ({ "pi jiu", "jiu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个用来装高级花雕酒的大酒袋。\n");
    set("unit", "瓶");
    set("value", 120);
    set("max_liquid", 20);
  }
  set("liquid", ([
    "type": "alcohol",
    "name": "啤酒",
    "remaining": 20,
    "drunk_apply": 6,
  ]));
}
