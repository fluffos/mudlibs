inherit ROOM;

void create()
{
        set("short", "海边小屋");
        set("long", @LONG
这是一间坐落在一个风光秀丽海岛上的木房子,外面阳光明媚,碧波荡漾。
一阵阵海风带起微咸的气味直扑脸面,这里就是天神随意和他夫人乌丫的
隐居之地
LONG );
        set("sleep_room", 1);
        set("no_fight", 1);
        set("hotel",1);
        set("no_clean_up", 0);
        set("exits", ([
                "out" : "/u/dream/workroom",
        ]));
        setup();
}

int valid_leave(object me, string dir)
{
        if ( dir == "out" ) me->delete_temp("rent_paid");

        return ::valid_leave(me, dir);
}

