// tao.c   银索金铃“套”字诀  by sinb
#include <ansi.h>
#include <skill.h>
#include <weapon.h>

inherit F_SSERVER;

int perform(object me, object target)
{
    object weapon;
    weapon=me->query_temp("weapon");
    if (base_name(weapon)!="/clone/unique/yinsuo")
        return notify_fail("你手中没有宝物，无法施展绝技。\n");
    if (me->is_fighting())
         return notify_fail("你正在跟人搏斗，没法分心！\n");
    if( (int)me->query_skill("yinsuo-jinling", 1) < 120 )
         return notify_fail("你的银索金铃不够娴熟，不会使用「套」字诀。\n");
    if( me->query("neili") < 300)
        return notify_fail("「套」字诀需要非常深厚的内力才能施展！\n");
    write("你要把谁套到你的身边？\n");
    input_to( (: call_other, __FILE__, "select_target", me :));
    return 1;
}

void select_target(object me, string name)
{
    object ob;
    object weapon;
    weapon=me->query_temp("weapon");

    if( !name || name=="" ) 
    {
        write("你突然改变主意，不想拉人过来了。\n");
        return;
    }
    ob = find_player(name);

    if( !ob || !me->visible(ob) || wizardp(ob) )
        ob = find_living(name);

    if( !ob || !me->visible(ob) || !living(ob) || wizardp(ob) ) 
    {
        write("你的银索在空中划了一道弧线，又回到你的手中。\n");
        return;
    }

    me->add("neili", -150);
    me->receive_damage("qi", 100);

    message_vision( HIW "$N把手中的"+ weapon->query("name") +HIW"挥向遥远的虚空....\n" NOR, me);

    if( random(ob->query("combat_exp")) > (int)me->query("combat_exp") / 2 ) 
   {
        message_vision( BLU "$N收回"+ weapon->query("name")+BLU"的时候，发现手上的阻力异常巨大，
$N手上加力，只听「啪」的一声，"+ weapon->query("name")+BLU"断成两截！\n" NOR, me);
        destruct(weapon);
        return;
    }

    if( random(ob->query("neili")) > (int)me->query("neili") / 2 ) 
    {
        message_vision( BLU "$N收回"+ weapon->query("name")+BLU"的时候，发现"+ weapon->query("name")+BLU "的末端挂着几根树枝。\n" NOR, me);
        return;
    }

    if( !environment(ob) ||  environment(ob)->query("no_fight") || random(me->query_skill("yinsuo-jinling",1)) < 100 ) 
    {
        message_vision( BLU "$N收回"+ weapon->query("name")+BLU"的时候，发现"+ weapon->query("name")+BLU "的末端空空如也。\n" NOR, me);
        return;
    }

    if ( domain_file(base_name(environment(ob)))=="death" )
   {
        message_vision( BLU "只听" HIW "白无常" BLU "嘿嘿一笑：你既然想把"+ weapon->query("name")+BLU"送给我，那我就笑纳啦！\n" NOR, me);
        destruct(weapon);
        return;
    }

    if ( playerp(ob) || wizardp(ob))
   {
        message_vision( BLU "冥冥之中传来一个声音：$N，你以为你是谁啊？可以钩人生魂？\n" NOR, me);
        return;
    }

       else 
    {
        message_vision( BLU "$N飞快地收回"+ weapon->query("name")+BLU "，你眼前一花，发现附近好像多了一个人。\n" NOR, me);
        tell_room(environment(ob), BLU+"虚空之中忽然伸出一根绳索，把"+
         (string)ob->query("name")+"的脖子死死套住，\n
        你眼前一花，"+(string)ob->query("name")+"已经被绳索套走了！\n", ob);
        ob->move(environment(me));
    }


}


