// sinb's workroom
// by sinb&mhyj

#include <ansi.h>
#include <room.h>
inherit CREATE_CHAT_ROOM;

int is_chat_room() { return 1; }

void create() {
  set("short", "安全中心的工作室");
  set("long", @LONG
这里是安全中心的工作室。蓝色的大沙发，坐上去又软又舒服。古朴
的壁炉，燃烧着跳动的火焰。大厅的右侧，有一扇玻璃门，通过那扇门可
以进入安全中心和梦幻妖精的二人世界。白天光线从室外照射进来，然后
浸射到大厅的每个角落，大厅内闪烁着一道道明亮的斑纹，上方雕花镶板
反射的光线犹如在水下一样摇曳不定，给大厅染上了一层雾一般的淡蓝色。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "north": "/d/wizard/wizard_room",
    "south": "/d/city/chatroom2",
    "east": "/u/sinb/sleeproom",
    "west": "/u/sinb/shaizifang",
  ]));
  set("objects", ([
    "/u/sinb/sofa": 3,
  ]));

  set("valid_startroom", 1);
  set("no_fight", "1");
  set("sleep_room", 1);
  set("no_clean_up", 0);
  setup();
  "/clone/board/sinb_b"->foo();
}

int valid_leave(object me, string dir) {
  if (dir == "north" && !wizardp(me))
    return notify_fail("那里只有巫师才能进去。\n");
  if (dir == "east") {
    if (wizardp(me) || me->query("id") == "mhyj") return 1;
    else return notify_fail("这是安全中心和梦幻妖精的二人世界，你还是别进去添乱了。\n");
  }
  return ::valid_leave(me, dir);
}

void init() {
  add_all_action();
}
