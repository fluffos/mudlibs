// shaizifang.c  骰子房  by sinb
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "骰子房");
  set("long", @LONG
赌桌前面围着黑压压的赌徒，吆喝声、惊叹声、欢呼声、咒骂声、哄
笑声和噼哩啪啦的声响使你的耳朵几乎无法忍受，赌桌旁的墙上贴有一张
纸(paper)。
LONG
  );
  set("exits",
    ([
      "south": "/d/city/duchang",
    ]));
  set("item_desc",
    ([
      "paper": @TEXT
        骰子的赌法：
        zz：    坐庄，必须先交5两黄金作为押金
        rz：    不想坐庄了可以让庄
        bet：   闲家下注，以黄金为单位
        cancel: 取消下注
        start： 庄家开始赌局，必须指定本局赌注总额的上限
        kai：   庄家命令，结束下注，开始掷骰子
        规则：  两粒骰子，有对则对子大，无对比点数。九点
                最大，别十最小，超过十点的按零头计算
        注意：  如果赌局开始后中途离开，所有损失自负
TEXT
    ]));
  set("no_clean_up", 0);
  set("no_fight", 1);
  set("objects",
    ([
    ]));
  setup();
}

void init() {
  add_action("do_bet", "bet");
  add_action("do_start", "start");
  add_action("do_zz", "zz");
  add_action("do_rz", "rz");
  add_action("do_kai", "kai");
  add_action("do_cancel", "cancel");

  add_action("discmds", ({ "quit", "exert", "home", "goto", "flyto", "recall" }));

}
int discmds() {
  tell_object(this_player(), "赌局还没结束，你想溜到哪儿去？\n");
  return 1;
}
string *dice = ({
  HIW "
         ┏━━━┓
         ┃      ┃
         ┃  " + HIR + "⊙" + HIW + "  ┃
         ┃      ┃
         ┗━━━┛
" NOR,
  HIW "
         ┏━━━┓
         ┃" + HIY + "⊙" + HIW + "    ┃
         ┃      ┃
         ┃    " + HIY + "⊙" + HIW + "┃
         ┗━━━┛
" NOR,
  HIW "
         ┏━━━┓
         ┃" + HIY + "⊙" + HIW + "    ┃
         ┃  " + HIY + "⊙" + HIW + "  ┃
         ┃    " + HIY + "⊙" + HIW + "┃
         ┗━━━┛
" NOR,
  HIW "
         ┏━━━┓
         ┃" + HIR + "⊙" + HIW + "  " + HIR + "⊙" + HIW + "┃
         ┃      ┃
         ┃" + HIR + "⊙" + HIW + "  " + HIR + "⊙" + HIW + "┃
         ┗━━━┛
" NOR,
  HIW "
         ┏━━━┓
         ┃" + HIY + "⊙" + HIW + "  " + HIY + "⊙" + HIW + "┃
         ┃  " + HIY + "⊙" + HIW + "  ┃
         ┃" + HIY + "⊙" + HIW + "  " + HIY + "⊙" + HIW + "┃
         ┗━━━┛
" NOR,
  HIW "
         ┏━━━┓
         ┃" + HIY + "⊙" + HIW + "  " + HIY + "⊙" + HIW + "┃
         ┃" + HIY + "⊙" + HIW + "  " + HIY + "⊙" + HIW + "┃
         ┃" + HIY + "⊙" + HIW + "  " + HIY + "⊙" + HIW + "┃
         ┗━━━┛
" NOR });

int do_zz() {
  object me, obj, money_ob, zhuangjia;

  obj = this_object();
  me = this_player();
  money_ob = present("gold", me);

  if (me->query_temp("zuozhuang"))
    return notify_fail("你已经是这里的庄家了。\n");
  if (obj->query("zhuangjia"))
    return notify_fail("已经有人坐庄了，你跟着下注就行了。\n");
  if (me->is_busy())
    return notify_fail("你上个动作还没完成。\n");
  if (!money_ob || (int)money_ob->query_amount() < 5)
    return notify_fail("你站起来想坐庄，但是发现身上金子不够，脸一红又坐了下来。\n");
  if (money_ob->query_amount() == 5)
    destruct(money_ob);
  else
    money_ob->set_amount((int)money_ob->query_amount() - 5);
  obj->set("zhuangjia", me->query("id"));
  zhuangjia = me;
  me->set_temp("zuozhuang", 1);
  message_vision(RED "$N从身上拿出五两" YEL "黄金" RED "，轻飘飘地往桌上一扔，便在庄家的位置坐了下来。" NOR " \n", me);
  return 1;
}

int do_rz() {
  object me, obj, money_ob;

  obj = this_object();
  me = this_player();
  money_ob = new("/clone/money/gold");

  if (!me->query_temp("zuozhuang"))
    return notify_fail("你又不是庄家，让什么让。\n");
  if (obj->query("total_amount") < me->query_temp("total_bet"))
    return notify_fail("已经有人下注了，你必须跟他赌完这一局。\n");

  money_ob->set_amount(5);
  money_ob->move(me, 1);
  me->delete_temp("zuozhuang");
  obj->delete("zhuangjia");
  obj->delete("can_bet");

  message_vision(RED "$N站起身来，叫道：今天手气不大好，这个庄我是不做了，你们谁愿意坐谁来坐吧。
顺手把桌上的押金揣进怀里。" NOR "\n", me);
  return 1;
}

int valid_leave(object me, string dir) {

  if (me->query_temp("zuozhuang"))
    return notify_fail("大家正赌的起劲，庄家怎么能随便离开呢？\n");

  else return 1;
}


int do_start(string arg) {
  int amount;
  object me, obj, money_ob;

  obj = this_object();
  me = this_player();
  money_ob = present("gold", me);

  if (!arg || !sscanf(arg, "%d", amount))
    return notify_fail("start <金子数>\n");

  if (!me->query_temp("zuozhuang"))
    return notify_fail("你不是这里的庄家，无权开始赌局！\n");
  if (obj->query("can_bet") || obj->query("kaishi"))
    return notify_fail("赌局已经开始了！\n");
  if (amount < 5)
    return notify_fail("才赌这么一点钱？太少了吧！\n");
  if (amount > 1000000)
    return notify_fail("赌注上限不能超过一千两黄金。\n");
  if ((int)money_ob->query_amount() < amount)
    return notify_fail("你身上没有那么多的黄金。\n");
  me->set_temp("total_bet", amount);
  obj->set("can_bet", 1);
  obj->set("total_amount", amount);
  me->start_busy(5);
  message_vision(RED "$N大模大样地说道：好，现在开始下注。
$N咳嗽一声，又道：这一局的赌注，不要超过" + MAG + chinese_number(amount) + RED + "两" YEL "黄金" RED "。" NOR " \n", me);

  return 1;

}


int do_bet(string arg) {
  int amount;
  object me, obj, money_ob;

  obj = this_object();
  me = this_player();
  money_ob = present("gold", me);

  if (!arg || !sscanf(arg, "%d", amount))
    return notify_fail("bet <金子数>\n");

  if (me->query_temp("zuozhuang"))
    return notify_fail("你已经是庄家了，不能再下注了。\n");
  if (!obj->query("zhuangjia"))
    return notify_fail("还没人坐庄呢，你往哪里下注呀？\n");
  if (!obj->query("can_bet"))
    return notify_fail("庄家还没发话，你着什么急下注？\n");

  if (!money_ob)
    return notify_fail("你想下注，但是发现自己身无分文。\n");
  if (amount < 1)
    return notify_fail("去去去，想到这里来骗钱？\n");
  if ((int)money_ob->query_amount() < amount)
    return notify_fail("你身上没有那么多的黄金。\n");
  if ((int)obj->query("total_amount") < amount)
    return notify_fail("你把黄金往前一推，庄家说道：这一局的赌注已经够了，请您等下一局吧。\n");

  if (money_ob->query_amount() == amount)
    destruct(money_ob);
  else
    money_ob->set_amount((int)money_ob->query_amount() - amount);
  me->add_temp("bet", amount);
  me->start_busy(3);
  obj->add("total_amount", -amount);
  message_vision(
    RED "$N从身上拿出" + MAG + chinese_number(amount) + RED + "两" YEL "黄金" RED "，一咬牙，全部拍在了桌上。" NOR " \n",
    me
  );
  return 1;
}


int do_cancel() {
  int amount;
  object me, obj, money_ob;

  obj = this_object();
  me = this_player();
  money_ob = new("/clone/money/gold");

  if (me->query_temp("zuozhuang"))
    return notify_fail("庄家只能让庄，不能取消下注。\n");
  if (!me->query_temp("bet"))
    return notify_fail("你还没有下注，你要取消什么？\n");
  if (!obj->query("can_bet"))
    return notify_fail("现在已经过了取消的时间，老老实实赌完这局吧。\n");
  amount = me->query_temp("bet");
  obj->add("total_amount", amount);
  money_ob->set_amount(amount);
  money_ob->move(me, 1);
  me->delete_temp("bet");
  message_vision(
    RED "$N把自己刚才押的" + MAG + chinese_number(amount) + RED + "两" YEL "黄金" RED "全部拿回口袋。" NOR " \n",
    me
  );
  return 1;
}

int do_kai() {
  int amount;
  object me, obj, money_ob;

  obj = this_object();
  me = this_player();
  money_ob = present("gold", me);

  if (!me->query_temp("zuozhuang"))
    return notify_fail("你不是这里的庄家，无权开始赌局！\n");
  if (obj->query("total_amount") == me->query_temp("total_bet"))
    return notify_fail("现在还没人下注呢，再等一会吧。\n");
  if (obj->query("kaishi") || !obj->query("can_bet"))
    return notify_fail("赌局已经开始了。\n");

  amount = (int)me->query_temp("total_bet") - (int)obj->query("total_amount");
  if (money_ob->query_amount() == amount)
    destruct(money_ob);
  else
    money_ob->set_amount((int)money_ob->query_amount() - amount);
  obj->set("total_bet", 2 * amount);
  obj->set("kaishi", 1);
  obj->delete("can_bet");
  message_vision(RED "$N喊道：好，下注到此为止，现在正式开始！
$N数出" + MAG + chinese_number(amount) + RED + "两" YEL "黄金" RED "，向前一推。" NOR " \n", me);

  call_out("f_dice", 2);
  return 1;

}

void f_dice(object me) {
  int i, j, k, point;
  object *ob, obj, zhuangjia;
  me = this_player();
  obj = this_object();
  message_vision(HIG "赌局开始了！" NOR " \n", me);

  ob = all_inventory(obj);

  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]))
      continue;
    if (!ob[i]->query_temp("zuozhuang") && !ob[i]->query_temp("bet"))
      continue;
    if (ob[i]->query_temp("zuozhuang"))
      zhuangjia = ob[i];
    j = random(6) + 1;
    k = random(6) + 1;
    point = j + k;
    if (j == k)
      point *= 100;
    else if (point > 10)
      point -= 10;
    ob[i]->set_temp("point", point);

    message_vision(RED "$N闭上眼睛咬紧牙关，把两粒骰子用力往桌上一扔！" NOR " \n", ob[i]);

    message_vision(dice[j - 1], ob[i]);
    message_vision(dice[k - 1], ob[i]);
    if (j == k) {
      message_vision(RED "众人大声叫道：" + HIG + chinese_number(j) + RED + "对！" NOR " \n", ob[i]);
    } else if (point == 10) {
      message_vision(RED "众人大声叫道：" + HIG + "别十" RED "！" NOR " \n", ob[i]);
    } else
      message_vision(RED "众人大声叫道：" + HIG + chinese_number(point) + RED + "点！" NOR " \n", ob[i]);
  }
  call_out("compte", 2, zhuangjia);
  return;
}

void compte(object zhuangjia) {
  int i, j, z_point, x_point, amount, rest;
  object *ob, money_ob, obj;

  obj = this_object();
  ob = all_inventory(obj);

  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i]->query_temp("zuozhuang") || !ob[i]->query_temp("point") || !ob[i]->query_temp("bet"))
      continue;
    z_point = zhuangjia->query_temp("point");
    x_point = ob[i]->query_temp("point");

    if (x_point == z_point) {
      amount = ob[i]->query_temp("bet");
      money_ob = new("/clone/money/gold");
      money_ob->set_amount(amount);
      money_ob->move(ob[i], 1);
      message_vision(
        RED "$N跟庄家打了个平手，把自己的" + HIG + chinese_number(amount) + RED + "两" YEL "黄金" RED "拿了回来。" NOR " \n",
        ob[i]
      );

    } else if (z_point == 10 || (x_point > z_point && x_point != 10)) {
      amount = 2 * ob[i]->query_temp("bet");
      money_ob = new("/clone/money/gold");
      money_ob->set_amount(amount);
      money_ob->move(ob[i], 1);
      message_vision(
        RED "$N赢了" + HIG + chinese_number(amount) + RED + "两" YEL "黄金" RED "！" NOR " \n",
        ob[i]
      );
    } else amount = 0;
    obj->add("total_bet", -amount);
    rest = obj->query("total_bet");

    ob[i]->delete_temp("bet");
    ob[i]->delete_temp("point");
  }
  if (rest > 0) {
    money_ob = new("/clone/money/gold");
    money_ob->set_amount(rest);
    money_ob->move(zhuangjia, 1);
  }
  zhuangjia->delete_temp("total_bet");
  zhuangjia->delete_temp("bet");
  zhuangjia->delete_temp("point");

  obj->delete("kaishi");
  obj->delete("total_bet");

  message_vision(
    RED "最后剩下的" + HIG + chinese_number(rest) + RED + "两" YEL "黄金" RED "，都是庄家$N的了。" NOR " \n",
    zhuangjia
  );

  return;
}
