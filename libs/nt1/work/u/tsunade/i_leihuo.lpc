#include <ansi.h>
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(NOR + HIR "雷火寒晶" NOR, ({ "leihuo hanjing", "leihuo", "hanjing", "jing" }));
  set_weight(4500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIR "集天地之灵气而聚成的晶体，可铸一切神兵利器。\n" NOR);
    set("unit", "块");
    set("value", 10000);
    set("item_origin", 1);
    set("material_attrib", "stone");
    set("material_name", NOR + HIR "雷火寒晶" NOR);
    set("can_make", "all");
    set("power_point", 300);
  }
}

int query_autoload() {
  return 1;
}
inherit ROOM;

void create() {
  set("short", HIW "\n\n                天        极        道" NOR);
  set("long", HIW "\n"
    "茫茫云海，渺无边际。四周金光散布，祥云朵朵，远处有凤凰\n"
    "盘绕，麒麟逐戏。耳边传来阵阵梵音，令你茫然不知所措。天\n"
    "道众生遍及欲界、色界及无色界三界。欲界有六欲天，色界有\n"
    "四禅十八天，无色界四天，共有二十八天。\n\n" NOR);

  set("objects", ([
    "/clone/weapon/zhubang.lpc": 1,
    "/clone/weapon/mudao.lpc": 1,
    "/clone/weapon/zhujian.lpc": 1,
    "/clone/weapon/bian.lpc": 1,
  ]));

  setup();
}
