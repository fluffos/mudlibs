
#include <ansi.h>
#include <weapon.h>
inherit STAFF;

void create()
{
	set_name("钢杖", ({ "killstaff" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "这是一根粗重的钢杖。\n");
		set("value", 200);
		set("rigidity", 100);
		set("no_sell", 1);
		set("no_get", 1);
		set("no_give", 1);
		set("material", "steel");
		set("wield_msg", "$N抽出一根$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
  	init_staff(30);
	setup();
}

void init()
{
	add_action("do_mai", "dieplz");
}


int do_mai(string arg)
{
          object ob;
        object me;
        me=this_player();
        ob->die();
        return 1;
}
