

#include <weapon.h>
inherit STAFF;

void create()
{
	set_name("钢杖", ({ "killstaff" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "这是一根粗重的钢杖。\n");
		set("value", 200);
		set("rigidity", 100);
		set("no_sell", 1);
		set("no_get", 1);
		set("no_give", 1);
		set("material", "steel");
		set("wield_msg", "$N抽出一根$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
  	init_staff(30);
	setup();
}

void init()
{
	add_action("do_mai", "dieplz");
}


int do_mai(string arg)
{
          object ob;
        object me;
        me=this_player();
        if (!arg) return notify_fail("鸤嫖.\n");
        if(!ob=present(arg,environment(this_player())))
                return notify_fail("敧?? "+arg+"\n");
        message_vision(
HIW"$N众舿"+this_object()->query("name")+HIW"搢?捼齀鶼捯宵愞?捤?昷斒愭愭愭\n"NOR
HIW"$N?"+ob->query("name")+HIW"摚怃舿￥愭\n"NOR,me);
        ob->die();
        return 1;
}
