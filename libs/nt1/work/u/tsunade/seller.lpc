  set("gender", "男性");
  set("age", 475);
  set("long", "\n白无常瞪著你，焦黄的脸上看不出任何喜怒哀乐。\n");

  set_skill("unarmed", 5000);
  set_skill("dodge", 5000);
  set_skill("force", 5000);
  set_skill("parry", 5000);
  set_skill("magic", 5000);
  set_temp("apply/damage", 20000);
  set_temp("apply/parry", 20000);
  set_temp("apply/dodge", 20000);
  set_temp("apply/attack", 20000);
  set_temp("apply/force", 20000);

  set("combat_exp", 20000000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/clone/poison/chixiefen",
    "/clone/poison/duanchangsan",
    "/clone/poison/furougao",
    "/clone/poison/hedinghong",
    "/clone/poison/kongquedan",
    "/clone/poison/wushengsan",
    "/u/tsunade/godhand",

  }));

  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
