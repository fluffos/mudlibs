// tofu.c 豆腐

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("大班冰皮月饼", ({ "yuebing", "bing" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块香脆可口的大大班冰皮月饼，嫩的令人不禁想到嫦娥的脸蛋儿。\n");
    set("unit", "块");
    set("value", 40);
    set("food_remaining", 1);
    set("food_supply", 50);
  }
}
