// jinx mingyu-gong pfm mingyubafang

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

#define HUN "「" HIW "明玉八方" NOR "」"

string final(object me, object target, int damage);

int perform(object me, object target) {
  string msg;
  int ap, dp;
  int damage;

  if (userp(me) && !me->query("can_perform/mingyu-gong/bafang"))
    return notify_fail("你所使用的外功中没有这种功能。\n");

  if (!target) target = me->select_opponent();

  if (!target || !me->is_fighting(target))
    return notify_fail(HUN "只能对战斗中的对手使用。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(HUN "只能空手施展。\n");

  if (me->query_skill("mingyu-gong", 1) < 120)
    return notify_fail("你的明玉功还不够娴熟，难以施展" HUN "。\n");

  if (me->query_skill_mapped("unarmed") != "mingyu-gong")
    return notify_fail("你现在没有激发明玉功为拳脚，难以施展" HUN "。\n");

  if (me->query_skill_mapped("force") != "mingyu-gong")
    return notify_fail("你现在没有激发明玉功为内功，难以施展" HUN "。\n");

  if (me->query_skill_prepared("unarmed") != "mingyu-gong")
    return notify_fail("你现在没有准备使用明玉功，难以施展" HUN "。\n");

  if (me->query("neili") < 600)
    return notify_fail("你的内力不够，难以施展" HUN "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  msg = HIY "\n$N手中的气化成银白芒点，流星追月般画过虚空,循一道包涵了天地至理的弧线往$n攻去\n" NOR;

  if (random(me->query("dex")) > (int)target->query("dex") * 1 / 2) {
    msg += HIR "\n$p只觉得全身受到内力震荡，钻心般巨痛，一口鲜血喷出，身上多\n" +
      "出几个血肉模糊的血窟窿。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }

  else {
    msg += HIG "\n$p情急之中双脚拔地而起，空中身行一闪，狼狈地躲过这一照，脸色变的苍白。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(2);
  }
  if (random(me->query_skill("parry")) > target->query_skill("parry") / 2) {
    me->start_busy(2);

    damage = (int)me->query_skill("mingyu-gong", 1);

    damage = damage * 5 / 2 + random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage);
    target->add("neili", -random(damage));
    me->add("neili", -100);
    if (damage < 300) msg += HIC "\n结果$n脸色变得惨白，踉踉跄跄退了好几步！\n" NOR;
    else if (damage < 400) msg += HIM "\n结果重重地击中，$n「哇」地一声吐出一口鲜血！\n" NOR;
    else if (damage < 500) msg += RED "\n结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n" NOR;
    else msg += HIR "\n结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！！\n" NOR;

  } else {
    me->start_busy(2);
    msg += HIG "\n$p情急之中双脚拔地而起，空中身行一闪，狼狈地躲过这一照，脸色变的苍白。\n" NOR;
  }
  if ((int)me->query_skill("mingyu-gong", 1) > 299) {
    message_vision(HIG "\n$N忽然气劲再转，光球爆炸开来，七式合一变成潮水般的明玉分光劲，一浪接一浪往$n冲击狂涌！\n" NOR, me, target);
    msg = HIW "东方：" WHT "〖" HIY "天香鸣玉" WHT "〗\n\n" HIG "只见$N手中之明玉分光劲一抖，笔直脱手夹带风声袭向$n，$n只觉身上凛冽，随即" HIC "『耳朵』" HIG "传来无法形容的剧烈鸣玉之音!\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 10 + random(5), msg);
    msg = HIW "东南方：" WHT "〖" HIY "分光烛影" WHT "〗\n\n" HIG "只见$N的手以看不见的高速连抖几下，分光劲的影子斜攻向$n的身体，$n只觉身上 一痛，已被无比的劲气震得上下抖动，感觉浑身欲裂!\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 20 + random(5), msg);
    msg = HIM "南方：" WHT "〖" HIY "琼楼玉雨" WHT "〗\n\n" HIG "只见$N分光劲势再抖，像蛟龙出海，大鹏展翅，先是一团光芒，光芒蓦然爆开，化作 一片光雨，漫天遍地向$n刺来！\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 30 + random(5), msg);
    msg = MAG "西南方：" WHT "〖" HIY "白虹贯玉" WHT "〗\n\n" HIG "只见$N全身急剧摇摆，分光劲气化作一道长虹，先冲而起，忽然速度激增，有若 脱弦之箭，游龙破浪般几下起伏急窜，向$n电射而来！\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40 + random(5), msg);
    msg = YEL "西方：" WHT "〖" HIY "琅环玉洞" WHT "〗\n\n" HIG "只见$N分光劲寒芒一闪魔术变幻般化作漫天光雨，没有人可以形容那使人目眩神迷 的美景，眼前的空间忽然间填满了动人心魄的光雨！\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 50 + random(5), msg);
    msg = HIB "西北方：" WHT "〖" HIY "玉宇还休" WHT "〗\n\n" HIG "只见$N手中的气劲凝成刀势剑势难分先后地或点或劈，或刺或扫，以不可能的角度 地击在$n的下一招来路上，使$n的招式无法施展开来！\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60 + random(5), msg);
    msg = RED "北方：" WHT "〖" HIY "明玉高悬" WHT "〗\n\n" HIG "只见$N转回头来，静若止水地看着手中的光芒，再轻叹一声，徐徐把手中光芒连续七 团向$n倾泻出去！" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 70 + random(5), msg);
    msg = HIR "东北方：" WHT "〖" HIY "风月大陆" WHT "〗\n\n" HIG "$N突然全身衣衫暴涨好几倍，蓄劲良久，一声巨响，分光劲爆手印而出， 直射上空，化作一团反映着天上电光的银白芒点，流星追月般画过虚空，往$n身后整片大陆投来！\n" NOR;
    COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 80 + random(5), msg);
    message_vision(WHT "\n$N手中光劲八方明玉，照耀大地，随即形成一个个光旋，气劲吸纳周围能量迅速内敛，黯然消去。\n" NOR, me, target);
    me->add("neili", -300);
    me->start_busy(1 + random(2));
    return 1;
  }
  message_vision(msg, me, target);

  return 1;
}
