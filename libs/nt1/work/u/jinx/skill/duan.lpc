#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
inherit F_MASTER;
#define H_O_M "/u/" + M_M + "/workroom"      //Home_Of_Me
#define M_N "杨恭如"                           //My Name
#define M_M "jinx"                           // My Master

object find_id(string arg) {
  //  foreach (object ob in children(USER_OB) ){
  foreach (object ob in users()) {
    if (!ob || !environment(ob)) continue;
    if (ob->query("id") == arg || ob->query("name") == arg || geteuid(ob) == arg) return ob;
  }
  return 0;
}
void create() {
  set_name(M_N, ({ "gong ru", "ru" }));
  set("long", HIC
    "她一生爱穿白衣，当真如风拂玉树，雪裹琼苞，兼之生性清冷，\n"
    "实当得起“冷浸溶溶月”的形容。\n" NOR);
  set("title", "「" + HIW + "倾国倾城，天生丽质，香闺深处" + NOR + "」");
  set("gender", "女性");
  set("cwd", "/u/jingx");
  set("channels", ({ "wiz", "adm", "chat", "rumor", "sys", "jh", "new", }));
  set_alias("uh", "update here");
  set_alias("ls", "ls -sF $*");

  set("age", 18);
  set("attitude", "friendly");
  set("int", 1000);
  set("dex", 3000);
  set("per", 30);
  set("kar", 30);
  set("str", 300);
  set("con", 3200);
  set("no_die", 1);
  set("demogorgon", 1);
  set("no_get", 1);
  set("no_suck", 1);
  set("max_jingli", 1000000);
  set("jingli", 2000000);
  set("max_neili", 8000000);
  set("neili", 8000000);
  set("jiali", 320000);
  set("combat_exp", 200000000);
  set_skill("dodge", 1000);
  set_skill("unarmed", 1000);
  set_skill("zuoyou-hubo", 1000);
  set_skill("parry", 1000);
  set_skill("sword", 1000);
  set_skill("qimen-wuxing", 1000);
  set_skill("meinv-quan", 1000);
  set_skill("yunv-shenfa", 1000);
  set_skill("yunv-jian", 1000);
  set_skill("yunv-xinjing", 1000);
  map_skill("force", "yunv-xinjing");
  map_skill("unarmed", "meinv-quan");
  map_skill("sword", "yunv-jian");
  map_skill("dodge", "yunv-shenfa");
  prepare_skill("unarmed", "meinv-quan");
  setup();
  carry_object("/clone/cloth/baipao")->wear();
  carry_object("/d/huashan/npc/obj/green_water_sword")->wield();
  remove_call_out("follow_master");
  call_out("follow_master", 2);
}

void init() {
  object master;
  ::init();
  master = this_player();
  if (geteuid(master) == M_M) {
    add_action("do_sha", "sha");
    add_action("do_dasao", "dasao");
    add_action("do_gift", "gift");
    add_action("do_find", "find");
    add_action("do_jina", "jina");
  } else add_action("do_bancmds", ({ "sleep", "follow" }));
  add_action("do_bancmds", ({ "sleep", "follow" }));
  add_action("do_kill", ({ "kill", "hit", "touxi", "array", "kickout" }));
  add_action("do_dest", "dest");
}
void sha_ob(object ob) {
  object me = this_object();
  ob->delete_query("env/immortal");
  me->kill_ob(ob);
  ob->kill_ob(me);
  if (me->is_busy()) me->start_busy(0);
  ob->start_busy(300);
  ob->set("jing", 0);
  ob->set("qi", 0);
  ob->delete("env/invisible");
  command("hubo");
  return;
}
int go_ob(object ob) {
  object me = this_object();
  message_vision(CYN "你只觉眼前一花，$N不见了。\n" NOR, me);
  if (!environment(ob)) me->move(ob);
  else me->move(environment(ob));
  message_vision(CYN "你只觉眼前一亮，$N出现在你面前。\n" NOR, me);
  return 1;
}
int follow_master() {
  object me = this_object();
  object master = query_leader();
  object home;
  if (!environment()) return 1;
  if (me->query("shen") != 0) me->set("shen", 0);
  if (!objectp(master) || !environment(master)) master = find_id(M_M);
  if (master && master->query("env/invisibility") < 1) {
    set_leader(master);
    if (environment(master) != environment(me) && !me->is_fighting()) {
      go_ob(master);
    }
  } else {
    home = find_object(H_O_M);
    if (!objectp(home)) home = load_object(H_O_M);
    if (home != environment()) go_ob(home);
    me->set_leader();
  }
  remove_call_out("follow_master");
  call_out("follow_master", 2);
  return 1;
}
int do_dasao(string arg) {
  object ob, me, master;
  me = this_object();
  master = this_player();
  if (!environment()) return 1;
  message_vision(CYN "$N对$n点了下头：打扫一下这里么？No problem.\n" NOR, me, master);
  foreach (ob in all_inventory(environment())) {
    if ((userp(ob) && !ob->id(arg)) || ob->query("no_get")) continue;
    if (arg != "all" && inherits(NPC, ob) && !ob->id(arg)) continue;
    else if (inherits(NPC, ob) && (id(ob->query("id")))) continue;
    message_vision("$N挥起扫把，把$n扫进垃圾箱去了。\n", me, ob);
    destruct(ob);
  }
  message_vision(CYN "$N把扫把一扔，搽了搽额头的汗：扫完啦。\n" NOR, me);
  return 1;
}
int do_kill(string arg) {
  object usr, ob, me;
  usr = this_player();
  me = this_object();
  if (!arg || !objectp(ob = present(arg, environment()))) return 0;
  if (id(arg)) {
    if (geteuid(usr) == M_M) {
      command("kissbye " + usr->query("id"));
      destruct(me);
      return 1;
    } else {
      command("say 这位" + RANK_D->query_respect(usr) + "胆识过人，真是令人佩服；好，我这就成全你。\n");
      sha_ob(usr);
      return 1;
    }
  }
  if (geteuid(usr) != M_M && geteuid(ob) == M_M) {
    command("say 大胆" + RANK_D->query_rude(usr) + "！你竟敢谋害" + ob->query("name") + "？\n");
    sha_ob(usr);
    return 1;
  }
  return 0;
}
int do_sha(string arg) {
  object me, ob, master;
  me = this_object();
  master = this_player();
  if (geteuid(master) != M_M) return 0;
  if (!arg) return notify_fail("你想杀谁？\n");
  if (arg == M_M) return notify_fail(CYN + M_N + "说道：我怎敢杀您呢？\n" NOR);
  if (id(arg)) return notify_fail(CYN + M_N + "奇怪地看着你，好象在说：" + master->query("name") + "的脑袋一定让飞机膀子刮了。\n" NOR);
  if (!ob) ob = present(arg, environment());
  if (!ob) ob = find_id(arg);
  if (!ob) ob = find_living(arg);
  if (!ob || !environment(ob) || ob->is_corpse() || !ob->is_character()) return notify_fail(CYN + M_N + "抿嘴一笑：现在没有" + arg + "这个人。\n\n" NOR);
  tell_object(
    master,
    CYN + M_N + "点点头，说道: “杀" + ob->query("name") + "(" + ob->query("id") + ")是吗？我这就去！”\n\n" NOR
  );
  if (environment(ob) != environment(me)) go_ob(ob);
  command("look " + ob->query("id"));
  message_vision(
    CYN + M_N + "说道：" + master->query("name") + "要我杀了" + ob->query("name") + "这个" + RANK_D->query_rude(ob) + "，没事的人快快离开！\n\n" + NOR,
    me
  );
  sha_ob(ob);
  return 1;
}
void unconcious() {}
void die() {}
int do_gift(string arg) {
  int count;
  object me, ob, player;
  string target;
  me = this_player();
  if (!arg) return notify_fail("gift 派礼物给在线玩家，命令格式： gift </路径/../目标文件名> <数量>\n\n");
  if (sscanf(arg, "%s %d", target, count) != 2) target = arg;
  if (sscanf(target, "%*s.lpc") != 1) target += ".lpc";
  if (file_size(target) < 0) target = resolve_path((string)me->query("cwd"), target);
  if (file_size(target) < 0) return notify_fail("找不到文件" + target + "。\n");
  foreach (player in children(USER_OB)) {
    if (!environment(player) || base_name(environment(player)) == "/d/jianyu") continue;
    if (player->query_temp("netdead")) continue;
    if (query_idle(player) > 600) continue;
    ob = new(target);
    if (count > 1 && ob->query("base_unit")) ob->set_amount(count);
    ob->move(player);
    tell_object(
      player,
      HIY + M_N + "宣布：派礼物啦！\n" + NOR + "你觉得身上好象多了点什么东西。仔细一看：原来是" + ob->name() + NOR + "！\n"
    );
  }
  return 1;
}
int do_find(string arg) {
  object ob, me, *obs = ({});
  string msg, ip_num, *ids, *names;
  me = this_player();
  if (!arg) return notify_fail("find 查找玩家，命令格式find <-p> <target>\nfind -p target 查找所有假扮target的玩家，find target     查找target同IP的所有人\n\n");
  msg = "";
  if (sscanf(arg, "-p %s", arg) == 1) {
    foreach (ob in children(USER_OB))
      if (environment(ob)) {
        names = ob->query_temp("apply/name");
        if (ids = ob->query_temp("apply/id"))
          if (names[sizeof(names) - 1] == arg ||
            arg == ids[0])
            msg += sprintf(HIW + "%s(%s)" + NOR + " 假扮 " + HIW + "%s(%s)。\n",
              ob->query("name"), ob->query("id"),
              names[sizeof(names) - 1], ids[0]);
      }
    if (sizeof(msg)) tell_object(me, M_N + "告诉你：\n" + msg);
    else tell_object(me, M_N + "告诉你：没发现假扮" + arg + "的玩家。\n");
  } else if (arg != "-p" && arg != "-P") {
    ob = find_id(arg);
    if (!ob) tell_object(me, "没找到 " + HIW + arg + NOR " 这个人。\n");
    else {
      ip_num = query_ip_number(ob);
      msg = arg + "的";
      if (ob->query("id") == arg) msg = msg + "名字是" + ob->query("name");
      if (ob->query("name") == arg) msg = msg + "ID是 " + ob->query("id");
      msg = msg + "，现在" + environment(ob)->query("short") + "(" + base_name(environment(ob)) + ")\n";
      msg = msg + arg + "的连线IP：" + ip_num + "\n";
      foreach (object obj in users()) {
        if (query_ip_number(obj) == ip_num) {
          obs += ({ obj });
        }
      }
      obs -= ({ ob });
      if (sizeof(obs)) {
        msg = msg + "这个IP上的玩家还有： ";
        foreach (object obj in obs)
          if (obj->query("id")) msg = msg + obj->query("name") + "(" + obj->query("id") + ") ";
        else msg = msg + "断线ID ";
        msg = msg + "\n\n" + NOR;
      }
      tell_object(me, msg);
    }
  } else {
    foreach (ob in users())
      if (environment(ob) && ids = ob->query_temp("apply/id")) {
        names = ob->query_temp("apply/name");
        msg += sprintf(HIW + "%s(%s)" + NOR + " 假扮 " + HIW + "%s(%s)。\n",
          ob->query("name"), ob->query("id"),
          names[sizeof(names) - 1], ids[0]);
      }
    if (sizeof(msg)) tell_object(me, msg);
    else tell_object(me, "没发现带面具假扮别人的玩家。\n");
  }
  return 1;
}
int do_bancmds(string arg) {
  if (id(arg) && geteuid(this_player()) != M_M) {
    tell_object(this_player(), M_N + "是蕴龙心境最心爱的人，你不怕" + HIR + "杀档" + NOR + "么？\n\n");
    return 1;
  }
  return 0;
}
int return_home(object home) {
  object master = query_leader();
  if (objectp(master)) return 1;
  return ::return_home(home);
}
int do_jina(string arg) {
  object room, me, ob, master;
  string ip_num, msg, target, opt;
  msg = "";
  master = this_player();
  if (!arg) return notify_fail("jina 缉拿违规玩家到监狱，指令 jina <-a> <target>\njina -a target 缉拿玩家以及同IP的所有id到监狱，jina         target 缉拿target到监狱\n\n");
  if (sscanf(arg, "-a %s", arg) == 1) {
    ob = find_id(arg);
    if (!ob) return notify_fail(CYN + M_N + "抿嘴一笑：您想缉拿谁？\n" + NOR);
    me = this_object();
    room = find_object("/d/register/prison");
    if (!room) room = load_object("/d/register/prison");
    ip_num = query_ip_number(ob);
    tell_object(
      master,
      CYN + M_N + "点点头,说道: 缉拿" + ob->query("name") + "(" + ob->query("id") + ")和与之同IP的人是吗？我这就去！\n" NOR
    );
    foreach (ob in children(USER_OB)) {
      if (query_ip_number(ob) == ip_num) {
        if (environment(ob) != environment(me)) go_ob(ob);
        message_vision(CYN + M_N + "说道：奉" + master->query("name") + "之命缉拿" + ob->query("name") + "这个" + RANK_D->query_rude(ob) + "，其他人快快离开！\n" NOR);
        message_vision(HIR + "$N飞起一脚，$n惨嚎一声，凌空向监狱方向飞去！\n" + NOR, me, ob);
        tell_room(room, CYN + "突然砰的一声巨响，" + ob->query("name") + "尖叫着从天上掉了下来。\n" NOR);
        ob->move(ob->query("room"));
        msg = msg + ob->query("name") + "(" + ob->query("id") + ") ";
      }
    }
    if (sscanf(
      msg,
      ")"
    ) > 1) tell_object(master, CYN + M_N + "告诉你：按同IP原则缉拿" + msg + "\n，一个也没走掉。\n" + NOR);
    else tell_object(master, CYN + M_N + "告诉你：按同IP原则缉拿了" + msg + "。\n" + NOR);
  } else {
    ob = find_id(arg);
    if (!ob) return notify_fail(CYN + M_N + "抿嘴一笑：您想缉拿谁？\n" + NOR);
    me = this_object();
    master = this_player();
    room = find_object("/d/register/prison");
    if (!room) room = load_object("/d/register/prison");
    tell_object(
      master,
      CYN + M_N + "点点头,说道: 缉拿" + ob->query("name") + "(" + ob->query("id") + ")是吗？我这就去！\n" NOR
    );
    if (environment(ob) != environment(me)) go_ob(ob);
    message_vision(CYN + M_N + "说道：奉" + master->query("name") + "之命缉拿" + ob->query("name") + "这个" + RANK_D->query_rude(ob) + "，其他人快快离开！\n" NOR);
    message_vision(HIR + "$N飞起一脚，$n惨嚎一声，凌空向监狱方向飞去！\n" + NOR, me, ob);
    tell_room(room, CYN + ob->query("name") + "尖叫着从天上掉了下来。\n" NOR);
    ob->move(ob->query("room"));
    tell_object(
      master,
      CYN + M_N + "告诉你：" + ob->query("name") + "(" + ob->query("id") + ")已经抓到监狱去了。\n" + NOR
    );
  }
  return 1;
}
int do_dest(string arg) {
  object master = query_leader();
  object me = this_player();
  object ob = this_object();
  if (id(arg) || (sscanf(arg, "-r %s", arg) == 1 && id(arg))) {
    message_vision(CYN + "$N一下子跳了开去，委屈地嚷道：我又没犯什么错，不要杀我啊，不要杀我啊！\n", ob);
    return 1;
  }
  if (arg == M_M || (sscanf(arg, "-r %s", arg) == 1 && arg == M_M)) {
    if (me == master) {
      tell_object(
        this_player(),
        CYN + M_N + "奇怪地看着你，好象在说：" + this_player()->query("name") + "的脑袋一定让飞机膀子刮了。\n\n" NOR
      );
      return 1;
    } else {
      message_vision(CYN + "$N恶狠狠的说道：谁要踢" + master->query("name") + "出去？我跟他没完！\n\n", this_object());
      sha_ob(this_player());
      return 1;
    }
  }
  return 0;
}
