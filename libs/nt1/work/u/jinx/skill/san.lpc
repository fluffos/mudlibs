
// Write by jinx

#include <ansi.h>

inherit F_SSERVER;


int perform(object me, object target)
{
        object weapon, ob;
        string msg;
        int myexp,yourexp,lvl;    
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展“ 三分明玉 ”?\n");
         
        if( !me->is_fighting() )
            return notify_fail("“ 三分明玉 ”只能在战斗中使用。\n");


        if( (int)me->query_skill("xiaofeng-sword", 1) < 100)
                return notify_fail("你的晓风残月剑等级不够，你怎么能使出“ 晓风三月 ”。\n");

    if( (int)me->query("combat_exp",1) < 100000 )
             return notify_fail("你的经验不足，不能使出“ 三分明玉 ”。\n");

         if (me->query("max_neili") < 10000)
                return notify_fail("你内力不继，难以使出“ 三分明玉 ”。\n");

        me->clean_up_enemy();
        ob = me->select_opponent();
        myexp = (int) me->query("combat_exp");
        yourexp = (int) target->query("combat_exp");
         lvl = (int)me->query_skill("xiaofeng-sword",1);
        
           msg = HIC
"\n$N脸色忽转肃穆,手中气劲幻出五彩光芒，你将光劲以大风车的手法向$n极速圈去。\n" NOR;
       if(random(myexp)>yourexp/10)
        {
                message_vision(msg + "\n", me, target);
        msg = HIM "$n只觉三股五彩劲气圈住自己,登时全身一麻,动弹不得!!\n" NOR;
                
                message_vision(msg, me, target);
target->start_busy(2+random(lvl));
        message_vision(HIM" 突然一股五彩劲气封住$n。"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        message_vision(HIW"突然第二股五彩劲气封住$n。"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        message_vision(HIC"突然第三股五彩劲气封住$n"NOR, me, ob);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

          message_vision(HIM" 接着一股五彩劲气从$n体内透出。"NOR, me, ob);
          COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  
          message_vision(HIW"接着第二股五彩劲气从$n体内透出。"NOR, me, ob);
          COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
 
          message_vision(HIC"突然第三股五彩劲气从$n体内透出。"NOR, me, ob);
          COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        }
    else {
            message_vision(msg +"\n", me, target);
           msg = HIY "可是$n似乎看破了$N的企图,化去了五彩劲气于无形。\n" NOR;
message_vision(msg, me, target);
            me->start_busy(2); }        
        me->add("force", -150);
        me->start_busy(1);
        return 1;  

}


