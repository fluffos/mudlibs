#include <ansi.h>
#include <weapon.h>
inherit HAMMER;

void create() {
  set_name(HIR "风火轮" NOR, ({ "fenghuo lun", "lun" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", HIR "
太乙真人法宝，送与其徒弟哪吒下山辅佐武王伐纣，哪吒肉身成圣之
后，有巧手之人便仿造了一对，无论从材质、重量上都真假难分。
\n" NOR);
    set("value", 50000);
    set("material", "gold");
    set("wield_msg", "$N从身后撤出一对风火轮，握在手中。\n");
    set("unwield_msg", "$N将风火轮插回身后。\n");
  }
  init_hammer(150);
  setup();
}
