#include <ansi.h>

inherit NPC;
void create()
{ 
   set_name("小凤", ({"lovet wife","xiao feng"}));
   set("title", "管家婆"); 
   set("long",
   "他是执着的娇娇妻，天真活泼的脸上挂着孩儿般的微笑。\n" 
   );

   set("gender", "女性");
   set("attitude", "heroism"); 

   set("age", 18);
   set("shen_type", 1); 
   set("str", 38);
   set("int", 38);
   set("con", 38);
   set("dex", 38);
   set("max_qi", 300000);
   set("max_jing", 300000);
   set("neili", 300000);
   set("max_neili", 300000);
   set("jiali", 300);
   set("combat_exp", 300000000);
   set("inquiry", ([
            "执着" : "我家的执着很棒的，很会顾家",
   ]));

   set_skill("force",1000);
   set_skill("yunv-xinfa",1000);
   set_skill("dodge",1000);
   set_skill("yunv-shenfa",1000);
   set_skill("parry",1000);
   set_skill("sword",1000);
   set_skill("yunv-jian",1000);
   set_skill("literate",1000);
   set_skill("martial-cognize",1000);
   set_skill("zuoyou-hubo",1000);
   map_skill("force", "yunv-xinfa"); 
   map_skill("dodge", "yunv-shenfa");
   map_skill("sword", "yunv-jian");
   map_skill("parry", "yunv-jian");

   carry_object("/d/city/npc/cloth/red-dress.lpc")->wear(); 
   carry_object("/d/city/npc/cloth/boots.lpc")->wear(); 

   setup();

}
