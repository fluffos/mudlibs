inherit NPC
#include <ansi.h>
#include <combat.h>
#include "ghost.h"

void create() {
  string name;
  name = first_name[random(sizeof(first_name))];
  name += name_words[random(sizeof(name_words))];
  name += last_words[random(sizeof(last_words))];
  set_name(name, ({ "ghost" }));
  set("gender", "男性");
  set("age", 40);
  set("str", 40);
  set("int", 20);
  set("per", 15);
  set("attitude", "killer");
  set("combat_exp", 640000000 + random(600000000));
  set("level", 99);
  set("max_qi", 10000000);
  set("max_jing", 1000000);
  set("neili", 8000000);
  set("max_neili", 8000000);
  set("jingli", 8000000);
  set("max_jingli", 8000000);

  set_skill("force", 1000);
  set_skill("huntian-qigong", 1000);
  set_skill("unarmed", 1000);
  set_skill("changquan", 1000);
  set_skill("dodge", 1000);
  set_skill("xiaoyaoyou", 1000);
  set_skill("strike", 1000);
  set_skill("dragon-strike", 1000);
  set_skill("staff", 1000);
  set_skill("dagou-bang", 1000);
  set_skill("blade", 1000);
  set_skill("liuhe-dao", 1000);
  set_skill("throwing", 1000);
  set_skill("mantianhuayu", 1000);
  set_skill("hand", 1000);
  set_skill("shexing-diaoshou", 1000);
  set_skill("checking", 1000);
  set_skill("begging", 1000);
  set_skill("parry", 1000);
  set_skill("training", 1000);
  set_skill("literate", 1000);
  set_skill("martial-cognize", 1000);

  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "dragon-strike");
  map_skill("unarmed", "changquan");
  map_skill("hand", "shexing-diaoshou");
  map_skill("staff", "dagou-bang");
  map_skill("blade", "liuhe-dao");
  map_skill("throwing", "mantianhuayu");

  prepare_skill("strike", "dragon-strike");
