#include <ansi.h>

inherit NPC;
void create() {
  set_name("小凤", ({ "lovet wife", "xiao feng" }));
  set("long",
    "她是执着的娇娇妻，看起来有十多岁。\n"
    "她有倾国倾城之貌，容色丽郁，娇艳绝伦，堪称人间仙子！\n"
    "长发如云，肌肤胜雪，风华绝代，不知倾倒了多少英雄豪杰。\n"
  );

  set("gender", "女性");
  set("attitude", "heroism");

  set("age", 18);
  set("shen_type", 1);
  set("str", 38);
  set("int", 38);
  set("con", 38);
  set("dex", 38);
  set("max_qi", 1000);
  set("max_jing", 300000);
  set("neili", 300000);
  set("max_neili", 300000);
  set("jiali", 300);
  set("combat_exp", 300000000);
  set("inquiry", ([
    "执着": "“我家的执着很棒的，很会顾家”\n",
    "zhuyun": "“他人很好，也好色，象一只小色猪。”\n",
    "猪猪": "“猪？我们家执着特别喜欢吃的动物。”\n",
    "可爱的猪猪": "“说到可爱，他的确可爱。玉树临风，潇洒倜傥，还有广阔的胸襟和强壮的臂弯，可就是笨一点。”\n",
  ]));

  set_skill("force", 3000);
  set_skill("yunv-xinfa", 3000);
  set_skill("dodge", 3000);
  set_skill("yunv-shenfa", 3000);
  set_skill("sword", 3000);
  set_skill("yunv-jian", 3000);
  set_skill("literate", 1000);
  set_skill("martial-cognize", 1000);
  set_skill("zuoyou-hubo", 1000);
  map_skill("force", "yunv-xinfa");
  map_skill("dodge", "yunv-shenfa");
  map_skill("sword", "yunv-jian");
  map_skill("parry", "yunv-jian");

  carry_object("/d/city/npc/cloth/red-dress.lpc")->wear();
  carry_object("/d/city/npc/cloth/boots.lpc")->wear();

  setup();

}
