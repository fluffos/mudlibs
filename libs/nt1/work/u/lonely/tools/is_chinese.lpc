int is_chinese(string str) {
  int i;
  int m;

  i = 0;
  m = strlen(str);

  while (i < m) {
    // 如果是 1 字节编码
    if (str[i] >= 0 && str[i] < 0x7F) {
      i++;
      continue;
    }

    if (i + 1 >= m) return 0;

    // 如果是 2 字节编码
    if (str[i] > 0x80 && str[i] < 0xFF &&
      str[i + 1] > 0x3F && str[i + 1] < 0xFF) {
      i += 2;
      continue;
    }

    if (i + 4 >= m) return 0;

    // 如果是 4 字节编码
    if (str[i] > 0x80 && str[i] < 0xFF &&
      str[i + 1] > 0x2F && str[i + 1] < 0x3A &&
      str[i + 2] > 0x80 && str[i + 2] < 0xFF &&
      str[i + 3] > 0x2F && str[i + 3] < 0x3A) {
      i += 4;
      continue;
    }

    // 其他的都不符合
    else return 0;
  }

  return 1;
}
