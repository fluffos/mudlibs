// use virtual object

object query_virtual_object(string arg)
{
        object ob;
        if (!arg) return 0;
        
        ob = new(ITEM);
        ob->set_name("炉子", ({"furnace", "lu zi", "lu"}));
        ob->set("long", "这是" + arg + "用来冶炼的炉子。\n");
        ob->set_weight(500000);
        ob->set("furnace_id", arg);
        ob->set_max_encumbrance(1000000);
        ob->set("location", 1);
        ob->setup();
        return ob;
}

//test1
int main(object me, string arg)
{
        object f;
        f = get_object("/clone/tool/furnace/gongzi");
        f->move(environment(me));
        return 1;
}

