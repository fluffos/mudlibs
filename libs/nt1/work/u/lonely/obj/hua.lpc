// tanghua.c
#include <ansi.h>
 
#include <weapon.h>
 
inherit THROWING;
 
void create()
{
        set_name(HIG "唐花" NOR, ({ "tang hua" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", HIR"这是一朵铁花，但美若昙花，精致玲珑，让人一看之下，就动人心魄。\n"NOR);
                set("unit", "枚");
                set("value", 0);
                set("base_unit", "枚");
                set("base_weight", 1);
                set("base_value", 210000);
                set("damage", 21);     
        }
        // set_amount(1);
        init_throwing(21);
        setup();
}

