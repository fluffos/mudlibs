#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m苍冥[2;37;0m", ({ "flyer" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set(
    "long",
    "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[2;37;0m[35m苍冥[2;37;0m[1;37m剑身散发出的凛冽剑气使人产生一种奇异的感觉，在月光的照射下，[1;37m淡紫色的[2;37;0m[35m苍冥[2;37;0m[1;37m散发出淡淡的[35m光芒，[1;37m就像液态的水晶一样。[2;37;0m
剑柄上刻着一行小字：大侠(flyernet)
"
  );
  set("value", 2100000);
  set("point", 212);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;33m剑若龙吟，$n[1;32m自行跃入$N手中，[35m紫色暗淡的$n[1;36m突然发出流动的光华，随着真气激发$n[1;36m流动着耀眼剑芒[2;37;0m\n"
  );
  set("unwield_msg", "[31m一团雷电光球出现在$N掌心，[1;33m当光芒散去后………$n仿若[1;31m流星般衣衫即逝[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
