#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m菊一文字则宗[2;37;0m", ({ "juyi" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
菊一文字则宗，太刀，刃长七十八点四八厘米。后鸟羽院时期备前国刀工则宗所作，一文字派的代表作品。传说后来为新撰组剑士冲田总司所有。现为一贺明野所有。[2;37;0m
剑柄上刻着一行小字：一贺明野(fengmo)
");
  set("value", 2100000);
  set("point", 159);
  set("material", "magic stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
