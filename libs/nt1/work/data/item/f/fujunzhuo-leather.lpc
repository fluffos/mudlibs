#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m天羽丝带[2;37;0m", ({ "leather" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;35m一根五彩斑斓的丝带，来自观音大士坐下的凤凰羽毛所做，无风自舞，飘飘扬扬。[2;37;0m
腰带缘上刻着一行小字：傅君婥(fujunzhuo)
");
  set("value", 2100000);
  set("point", 92);
  set("material", "silk");
  set("wear_msg", "[1;35m只听见一阵清亮的凤唳，霞光闪映，一件丝带在$N腰间回旋飞舞。[2;37;0m\n");
  set("remove_msg", "[1;35m一阵突如其来的清风过后，$N周围飞舞着的丝带已经没了踪影。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
