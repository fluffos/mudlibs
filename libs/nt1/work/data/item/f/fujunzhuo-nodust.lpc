#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m绝尘靴[2;37;0m", ({ "nodust" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
[37m一双普普通通的靴子，除了十分漂亮以外，好像看不出有什么不同。[2;37;0m
靴子缘上刻着一行小字：傅君婥(fujunzhuo)
");
  set("value", 2100000);
  set("point", 92);
  set("material", "silk");
  set("wear_msg", "[37m$N浅浅一笑，穿上了一双十分漂亮的靴子，体态更加轻盈，舞步也越发婀娜多姿。[2;37;0m\n");
  set("remove_msg", "[37m$N微微一笑，脱下了脚下的靴子，双脚也踩回了实地，气息凝重了几分。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
