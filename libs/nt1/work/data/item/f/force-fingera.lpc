#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m内功的大拇指[2;37;0m", ({ "fingera" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
[1;34m内功的大拇指指套[2;37;0m
指套缘上刻着一行小字：内功(force)
");
  set("value", 2100000);
  set("point", 247);
  set("material", "magic stone");
  set("wear_msg", "[1;31m$N[1;35m带上了$N的大拇指指套[2;37;0m\n");
  set("remove_msg", "[1;31m$N[1;35m取下了$N的大拇指指套[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/finger", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
