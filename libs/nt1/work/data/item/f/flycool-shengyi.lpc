#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m山羊座黄金圣衣[2;37;0m", ({ "shengyi" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一张护甲。
[1;31m这是守护雅典娜女神的十二宫中山羊星座的护甲。[2;37;0m
护甲缘上刻着一行小字：风月儿(flycool)
");
  set("value", 2100000);
  set("point", 112);
  set("material", "silk");
  set("wear_msg", "[1;33m圣衣见主人有难，自行分解并依附到主人身上，发出亮眼的金光。[2;37;0m\n");
  set("remove_msg", "[1;33m金光一闪，身上的黄金圣衣自行脱去并组合成山羊座。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
