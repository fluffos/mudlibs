#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[30m诅咒之铠[2;37;0m", ({ "damn" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
[30m恶魔赐予其信徒的超级宝物
[2;37;0m
护甲缘上刻着一行小字：麻仓叶(fire)
");
  set("value", 2100000);
  set("point", 947);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备[2;37;0m[30m诅咒之铠[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[2;37;0m[30m诅咒之铠[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
