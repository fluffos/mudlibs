#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m天蓝战衣[2;37;0m", ({ "yishang" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;36m一件天蓝色的战衣，正是雨后的天空那样的湛蓝，随风吹起，像天空在飞，好奇怪的衣裳。[2;37;0m
战衣缘上刻着一行小字：傅君婥(fujunzhuo)
");
  set("value", 2100000);
  set("point", 230);
  set("material", "silk");
  set("wear_msg", "[1;36m$N穿上了一件天蓝色的衣裳，仿佛整个娇躯都被天空所掩盖，根本没有半分漏洞。[2;37;0m\n");
  set("remove_msg", "[1;36m$N卸下了外面的衣裳，整个娇躯自那片蓝色的天空下显现出来，你不觉得呆住了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
