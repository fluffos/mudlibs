#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m冰魄寒光剑[2;37;0m", ({ "ice" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m一柄在晶莹剔透的[1;37m冰剑[1;32m，由天山下万古玄冰炼制而成，剑未出鞘，你已然隐隐感到阵阵寒意。[2;37;0m
剑柄上刻着一行小字：傅君婥(fujunzhuo)
");
  set("value", 2100000);
  set("point", 230);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;32m$N双手不知如何动作，一道寒光冲天而起，一柄寒光闪闪的[1;37m冰剑[1;32m已经在$N手上凛冽，周围空气仿佛被冷气所凝结。[2;37;0m\n"
  );
  set("unwield_msg", "[1;32m$N随手一抹，四周的空气仿佛这时才渐渐解冻，而$N纤手上所执的[1;37m冰剑[1;32m刹那间不见了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
