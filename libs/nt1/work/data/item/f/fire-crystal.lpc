#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m紫水晶[2;37;0m", ({ "crystal" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
[1;35m这是一颗变幻的紫水晶，代表着永结同心，吉祥如意，圣洁虔诚。[2;37;0m
靴子缘上刻着一行小字：麻仓叶(fire)
");
  set("value", 2100000);
  set("point", 276);
  set("material", "silk");
  set("wear_msg", "[1;35m这是一颗变幻的紫水晶，代表着永结同心，吉祥如意，圣洁虔诚。[2;37;0m\n");
  set("remove_msg", "[1;35m这是一颗变幻的紫水晶，代表着永结同心，吉祥如意，圣洁虔诚。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
