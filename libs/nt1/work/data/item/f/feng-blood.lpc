#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m修罗[1;34m之[1;33m刃[2;37;0m", ({ "blood" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。

[1;33m天下英雄出我辈，
一入江湖岁月催。
皇图霸业谈笑间，
不胜人生一场醉！
[1;34m此乃上古修罗所用之剑，至今传入青衣修罗手中，此剑体泛紫光，寒气逼人，绝代名剑：[1;33m修罗[1;34m之[1;33m刃[2;37;0m
剑柄上刻着一行小字：青衣修罗(feng)
");
  set("value", 2100000);
  set("point", 222);
  set("material", "magic stone");
  set(
    "wield_msg",
    "\n[1;33m天下英雄出我辈，\n一入江湖岁月催。\n皇图霸业谈笑间，\n不胜人生一场醉！\n[1;34m一声龙吟，上古[1;33m修罗[1;34m之[1;33m刃[1;34m傲然出鞘，紫光大盛，寒气逼人，你弹剑低吟：[1;31m此剑出，情意断，快恩仇！！！[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "\n[1;33m天下英雄出我辈，\n一入江湖岁月催。\n皇图霸业谈笑间，\n不胜人生一场醉！\n[1;34m上古[1;33m修罗[1;34m之[1;33m刃[1;34m黯然入鞘，紫光顿失。你抚剑叹曰：[1;31m恩仇已了，爱恨全消！[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
