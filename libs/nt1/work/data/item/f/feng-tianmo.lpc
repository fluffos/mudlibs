#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m修罗[1;34m天魔[1;33m甲[2;37;0m", ({ "tianmo" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
[1;34m上古修罗王传世宝甲，紫气环绕，魔性昂然，乃魔界之宝，传至[1;33m青衣修罗[1;34m手中[2;37;0m
护甲缘上刻着一行小字：青衣修罗(feng)
");
  set("value", 2100000);
  set("point", 80);
  set("material", "magic stone");
  set(
    "wear_msg",
    "[1;34m魔气突现，天地黯然，[1;33m修罗[1;34m天魔[1;33m甲[1;34m已然装在[1;33m$N[1;34m身上。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;34m魔气顿失，[1;33m修罗[1;34m天魔[1;33m甲[1;34m悄然从[1;33m$N[1;34m身上离去。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
