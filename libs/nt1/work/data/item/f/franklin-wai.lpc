#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m老外[1;37m用的[1;31m剑[2;37;0m", ({ "wai" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
它是一剑吗，据说是老外用的，不同凡响，快快看看。[2;37;0m
剑柄上刻着一行小字：弗兰克林(franklin)
");
  set("value", 2100000);
  set("point", 220);
  set("material", "magic stone");
  set("wield_msg", "老外大喝一声，它用的剑如光一样飞到了他的手上。[2;37;0m\n");
  set("unwield_msg", "老外苦思一下，他手上的剑已经无影无踪了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
