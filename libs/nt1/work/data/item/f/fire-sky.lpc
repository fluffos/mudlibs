#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m星河天野剑[2;37;0m", ({ "sky" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：麻仓叶(fire)
");
  set("value", 4100000);
  set("point", 2628);
  set("material", "tian jing");
  set(
    "wield_msg",
    "[30m漆黑的夜空，[37m舫穗★[35m紫微★[1;34m天机★[1;37m魉魅★[31m蛊冥★[1;33m鹫翎★[1;31m破军★[1;36m古梦★[1;35m馥思★[1;37m——[1;32m九颗鲲仑夜空的主星\n[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;37m蓦地大亮，[1;34m九道星光急射而下[1;33m——[1;31m九[1;37m☆[1;36m极[1;37m☆[1;35m星[1;37m☆[1;32m神[1;37m☆[1;33m变\n[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
