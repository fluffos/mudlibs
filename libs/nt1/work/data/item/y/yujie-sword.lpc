#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m无[36m名[1;32m剑[2;37;0m", ({ "sword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
一把锋利的无名剑它在阳光下闪闪发光[2;37;0m
剑柄上刻着一行小字：一地鸡毛(yujie)
");
  set("value", 2100000);
  set("point", 142);
  set("material", "magic stone");
  set("wield_msg", "无名剑伸手一抖，抽出一把锋利长剑。[2;37;0m\n");
  set("unwield_msg", "无名剑随手一挥，无名剑已入鞘内。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
