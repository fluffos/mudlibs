#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m狂风快剑[2;37;0m", ({ "kfkj" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
靴子缘上刻着一行小字：狐战四野(ydzzjz)
");
  set("value", 2100000);
  set("point", 58);
  set("material", "silk");
  set("wear_msg", "[1;31m$N眼中精光闪过，冷冷的扫过四周，一股寒意凛然而起。\n[2;37;0m\n");
  set("remove_msg", "[1;36m$N脚尖一点，踢起一些尘土，整个人顿时如同纸鹞一般飘飘忽忽。\n[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
