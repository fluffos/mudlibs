#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m除魔剑[2;37;0m", ({ "magic" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
这是云鹤山庄副庄主浦饭幽助的配剑。
它看起来平平无奇，大概是幽助太穷了，买不起宝剑。[2;37;0m
剑柄上刻着一行小字：浦饭幽助(youzhu)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;37m只见$N一扬手，[1;36m除魔剑[1;37m就出现在手中。\n周围腾然升起一股杀气，让人如坠冰窖。[2;37;0m\n");
  set("unwield_msg", "[1;37m$N将[1;36m除魔剑[1;37m收入鞘中。\n空气中的杀气渐渐散去，周围的人都松了一口气。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
