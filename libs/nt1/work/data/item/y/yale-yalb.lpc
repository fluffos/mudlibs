#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m数据线[2;37;0m", ({ "yalb" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;36m腰[1;31m带[2;37;0m
腰带缘上刻着一行小字：寒易(yale)
");
  set("value", 2100000);
  set("point", 91);
  set("material", "silk");
  set("wear_msg", "[1;36m不就腰带嘛！[1;37m神气什么！！[2;37;0m\n");
  set("remove_msg", "[1;37m不舒服，[1;36m要更衣啦！[1;37m快解开！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
