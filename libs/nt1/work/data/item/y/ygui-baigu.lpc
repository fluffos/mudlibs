#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m白骨剑[2;37;0m", ({ "baigu" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[37m著名的魔剑。精铁加特殊材料虾制而成，剑身有无数极细小的孔眼，毒药便渗入在其中。[2;37;0m
剑柄上刻着一行小字：夜鬼(ygui)
");
  set("value", 2100000);
  set("point", 315);
  set("material", "magic stone");
  set("wield_msg", "[1;37m只听见「飕」地一声，$N的手中已经多了一把精铁加特殊材料虾制而成的宝剑——$n。[2;37;0m\n");
  set("unwield_msg", "[1;31m刹那间只见$N全身顿时浮现出一层刚猛的劲气，将你全全笼罩。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
