#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("仁者之剑[2;37;0m", ({ "lucky" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：渡会(yourdead)
");
  set("value", 2100000);
  set("point", 175);
  set("material", "magic stone");
  set("wield_msg", "仁者之剑一声长鸣，自动飞入手中\n正义之气由然而生[2;37;0m\n");
  set("unwield_msg", "仁者之剑一声长鸣，自动飞回鞘中\n天暗了下来[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
