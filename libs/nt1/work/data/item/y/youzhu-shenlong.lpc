#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m神龙宝衣[2;37;0m", ({ "shenlong" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
这是云鹤山庄副庄主浦饭幽助的护甲。
它是以传说中龙皮制作而成，上面隐隐有红光流动。[2;37;0m
护甲缘上刻着一行小字：浦饭幽助(youzhu)
");
  set("value", 2100000);
  set("point", 80);
  set("material", "magic stone");
  set("wear_msg", "[1;37m$N穿上一件火红的[1;31m神龙宝衣[1;37m。\n他的护甲上隐隐有几道红光流动。[2;37;0m\n");
  set("remove_msg", "[1;37m$N小心翼翼地将[1;31m神龙宝衣[1;37m收入怀中。\n围绕在他身边的红光顿时消失地无影无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
