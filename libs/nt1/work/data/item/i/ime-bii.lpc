#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("鞭子[2;37;0m", ({ "bii" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一根鞭。
鞭柄上刻着一行小字：闯越(ime)
");
  set("value", 700000);
  set("point", 86);
  set("material", "iron");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
