#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m白莲旗[2;37;0m", ({ "blq" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
白莲教的旗帜。[2;37;0m
剑柄上刻着一行小字：虚白(baibingwei)
");
  set("value", 2100000);
  set("point", 460);
  set("material", "magic stone");
  set("wield_msg", "$N举手一挥，一杆图标模样的小旗帜握在手中。[2;37;0m\n");
  set("unwield_msg", "$N将小旗帜小心翼翼地卷起来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
