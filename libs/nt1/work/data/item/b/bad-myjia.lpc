#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m战神披风[2;37;0m", ({ "myjia" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一张护甲。
护甲缘上刻着一行小字：坏男孩(bad)
");
  set("value", 1);
  set("point", 1280);
  set("material", "tian jing");
  set("wear_msg", "[33m$N[33m装备[1;37m战神披风[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;37m战神披风[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
