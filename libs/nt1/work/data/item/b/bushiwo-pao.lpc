#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m蓑衣[2;37;0m", ({ "pao" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
这件蓑衣看上去虽然陈旧，但还可以为它的主人遮挡风雨。[2;37;0m
战衣缘上刻着一行小字：慕容恪(bushiwo)
");
  set("value", 2100000);
  set("point", 250);
  set("material", "silk");
  set("wear_msg", "[1;35m$N将$n[1;35m披在身上。[2;37;0m\n");
  set("remove_msg", "[1;35m$N将$n[1;35m脱了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
