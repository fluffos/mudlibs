#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("飘风[2;37;0m", ({ "piaofeng" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
宝贝快跑[2;37;0m
指套缘上刻着一行小字：段心(bug)
");
  set("value", 2100000);
  set("point", 362);
  set("material", "magic stone");
  set("wear_msg", "宝贝快跑[2;37;0m\n");
  set("remove_msg", "宝贝睡觉了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/finger", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
