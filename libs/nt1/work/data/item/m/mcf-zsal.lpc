#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m雪域苍狼追杀令[2;37;0m", ({ "zsal" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
头盔缘上刻着一行小字：梅超风(mcf)
");
  set("value", 2100000);
  set("point", 50);
  set("material", "magic stone");
  set("wear_msg", "杀，杀，杀！[2;37;0m\n");
  set("remove_msg", "雪域苍狼千秋万代，一统江湖！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
