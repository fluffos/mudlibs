#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m飞翔之翼[2;37;0m", ({ "sword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m飞翔中的天翼。。翱翔于天际。。。[2;37;0m
剑柄上刻着一行小字：天涯狂歌(mingyue)
");
  set("value", 2100000);
  set("point", 302);
  set("material", "magic stone");
  set("wield_msg", "[1;37m晴空中飞翔于天地之间。。。[2;37;0m\n");
  set("unwield_msg", "[1;37m轻舞于天上人间[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
