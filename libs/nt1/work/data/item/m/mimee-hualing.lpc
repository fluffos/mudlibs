#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m三眼花翎[2;37;0m", ({ "hualing" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
这就是代表官员最高荣耀的三眼花翎。[2;37;0m
腰带缘上刻着一行小字：小达子(mimee)
");
  set("value", 2100000);
  set("point", 62);
  set("material", "silk");
  set("wear_msg", "[1;34m$N将花翎别在官帽上，心里美滋滋的。[2;37;0m\n");
  set("remove_msg", "[1;34m$N将花翎轻轻的从官帽上取了下来，小心的收了起来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
