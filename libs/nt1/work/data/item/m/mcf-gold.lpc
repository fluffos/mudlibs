#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("一千两[33m黄金[2;37;0m", ({ "gold" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
黄澄澄的金子，人见人爱的金子，啊～～金子！[2;37;0m
剑柄上刻着一行小字：梅超风(mcf)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "$N拿出一千两[33m黄金[2;37;0m，握在手中。[2;37;0m\n");
  set("unwield_msg", "$N丢下一些[33m黄金[2;37;0m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
