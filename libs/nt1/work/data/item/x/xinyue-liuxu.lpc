#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m柳絮池塘淡淡风[2;37;0m", ({ "liuxu" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m这是一柄深绿色的剑，剑刃上回旋着绵绵不尽的温柔之意，仿佛微风吹皱湖面一般，不激烈但却无所不在。[2;37;0m
剑柄上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 483);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;32m$N抽出一柄$n，[1;32m天空中不知从哪个无间的尽头飘来一阵阵[1;32m柳絮[1;37m，[1;37m柳絮[1;32m随风起舞就像是漫天的[1;37m雪花[1;32m。\n在这片无穷尽的雪花中，$N衣袂随风猎猎而动，裙带飘飘，恍若凌波仙子下得凡尘。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;32m又是一阵不知名的微风拂过众人的脸颊，天空中漫天飞舞着如雪花般的[1;37m柳絮[1;32m，便似雪花遇到阳光一般，霎时间了无影踪。\n而$N手中的那把墨绿色的$n[1;32m剑刃上却多了一点点斑斑的[1;37m白[1;32m。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
