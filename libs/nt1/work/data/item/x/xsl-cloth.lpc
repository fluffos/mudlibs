#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m淡烟秀才装[2;37;0m", ({ "cloth" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
一件秀才们常穿的衣服。[2;37;0m
战衣缘上刻着一行小字：陈小生(xsl)
");
  set("value", 2100000);
  set("point", 313);
  set("material", "silk");
  set("wear_msg", "[1;37m$N穿上淡烟秀才装，看上去温文尔雅了许多。[2;37;0m\n");
  set("remove_msg", "[1;37m$N换下淡烟秀才装，恢复了武林人士的打扮。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
