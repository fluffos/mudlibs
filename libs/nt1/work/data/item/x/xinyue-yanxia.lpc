#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m烟霞流尽[1;37m霜华好[2;37;0m", ({ "yanxia" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m传说中洛神凝万古寒水所冰封的剑，剑刃上[1;35m烟霞[1;32m流动，锋口处[1;37m冰霜[1;32m不化如钻石般的白。[2;37;0m
剑柄上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 512);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;32m$N心思转动，只见$N娇躯周围笼起一片蔼蔼烟霞，五光十色，仿佛雨后的彩虹下到凡间。\n在这瞬间，一把七色短剑凝聚在$N的手上，剑锋处森冷的白光闪耀，寒气逼人。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;32m$N心神再次凝动，眉头微蹙，于是隐隐飘散在$N周围的烟霞便缓缓散去。\n而她手上的那柄光怪陆离的短剑也逐渐由实化虚，如晨雾消散在阳光下，不知何所来不知何所终。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
