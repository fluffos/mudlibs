#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m雪域苍狼令牌[2;37;0m", ({ "jmcf" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：小撒(xiaosa)
");
  set("value", 2100000);
  set("point", 406);
  set("material", "magic stone");
  set("wield_msg", "杀人偿命！[2;37;0m\n");
  set("unwield_msg", "得罪雪域苍狼还想活！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
