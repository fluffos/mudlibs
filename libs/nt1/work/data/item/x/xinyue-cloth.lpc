#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m庄生晓梦迷蝴蝶[2;37;0m", ({ "cloth" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;34m一袭淡蓝色长裙，上身绣了蝴蝶的模样，裙摆处点缀着七彩的斑痕，随风舞动，翩翩欲飞。[2;37;0m
战衣缘上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 786);
  set("material", "silk");
  set(
    "wear_msg",
    "[1;34m$N穿上一袭淡蓝色长裙，身法顿时轻盈了许多，仿佛罗袜不生尘，足尖不点地似的。\n待到$N舞动时，长裙飞扬，恰似一只穿花的蝴蝶，四处游动，你竟把握不住她的方向，恍惚间不知她是蝴蝶，抑或蝴蝶是她。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;34m$N一边舞着，一边轻巧地卸下身上的那袭长裙，说不出的优雅与好看。\n待卸下之后，$N的身形不再那么飘忽不定，你恍然发现刚才美丽的蝴蝶也飞不见了。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
