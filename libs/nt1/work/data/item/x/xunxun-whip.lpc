#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m沧浪滔天[2;37;0m", ({ "whip" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一根鞭。
[1;35m这是一条紫色的苍龙，江上沧浪，无尽风波[2;37;0m
鞭柄上刻着一行小字：枪下蛋(xunxun)
");
  set("value", 2100000);
  set("point", 269);
  set("material", "silk");
  set("wield_msg", "[1;35m$N轻轻地掏出了沧浪鞭，一时间闪电凛冽，风雨无尽，天下一片寂寥[2;37;0m\n");
  set("unwield_msg", "[1;35m$N慢慢地招回了狂暴的苍龙，飞驰电掣，流光四射[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
