#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m十年心事十年灯[2;37;0m", ({ "waist" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;34m一根青白色的腰带，其上打了无数个不知名的死结，打结的手法各不相同，真不知天下谁人会解？[2;37;0m
腰带缘上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 314);
  set("material", "silk");
  set(
    "wear_msg",
    "[1;34m$N随随便便的系上一根丝带在小蛮腰上，双眉渐渐蹙了起来，显然是想起了愿回首的往事，泫然欲泣。\n丝带上的各个不同的结也散发出千种带着嘲讽意味的灯光，仿佛讥笑世人被命运所捉弄，而其中尤以$N为甚。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;34m$N扯下了腰间的那条亮着冷讽灯光的丝带，眉宇间的忧愁慢慢化去，神色变得安然恬淡。\n$N心道：“虽然这般死结我解不开，可是我却能够不让你惊扰我的心海，不再让它再方寸间澎湃。”[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
