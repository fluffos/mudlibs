#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m月光如水水如天[2;37;0m", ({ "sword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;34m一柄如水一般流动着的青色长剑，剑刃上总有水光在荡漾，微风吹过，波纹一圈一圈的散开。[2;37;0m
剑柄上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 786);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;34m$N随手一抖，抽出一柄$n[1;34m，剑身晃动不已，就像一汪清水在身边流淌。\n$n[1;34m与$N身上的那枚月白色的钮扣交相辉映，只见月光清凉如水，水色柔蓝似天，而$N则在水中央婷婷的倚着。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;34m$N把手中的$n[1;34m越舞越快，绕身四周荡漾起一片水光，而她的身形也渐渐隐没在那一片水光之中。\n被这迷离的舞步所诱惑，你正在如痴如醉中，突然闻得一声娇叱，周围月色水光皆不见，只有$N悄生生的立在眼前。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
