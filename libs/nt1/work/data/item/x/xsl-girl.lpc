#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m美人扇[2;37;0m", ({ "girl" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
一把玉制的折扇，上面画有百余位当世有名的绝世美女。[2;37;0m
铁掌缘上刻着一行小字：陈小生(xsl)
");
  set("value", 2100000);
  set("point", 313);
  set("material", "magic stone");
  set(
    "wear_msg",
    "[1;33m$N[1;35m潇洒地将[1;37m美人扇[1;35m展开，顿时你眼前出现百余名形态婀娜体态妙曼的美人儿翩翩起舞，你不由地看呆了，浑然忘了自己当前的处境。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;37m只见白光一闪，[1;35m美人起舞的情景[1;37m居然凭空消失了，你收敛心神，突然发现[1;33m$N[1;37m一指向你的檀中死穴疾速点了过来，你本能地向后闪去，可惜已经迟了。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
