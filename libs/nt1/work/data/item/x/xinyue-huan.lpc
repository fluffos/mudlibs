#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m月牙环[2;37;0m", ({ "huan" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m这是一块环形的寒玉，来自九天上的[1;36m广寒宫[1;37m，玉面上隐隐的有一股酸楚环绕其间。
再仔细看时发现环两端对称的有一对绿色的[1;32m荧光[1;37m在流转，像极了月宫仙子的[35m泪珠[1;37m。[2;37;0m
剑柄上刻着一行小字：慕容新月(xinyue)
");
  set("value", 2100000);
  set("point", 199);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;35m$N戴上[1;37m月牙环[1;35m轻轻地扫了在场的众人一眼，只见眼光如水，明眸善睐，只是充满一种浩浩无垠的愁思！[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;35m$N取下了手中的[1;37m月牙环[1;35m，对在场的众人浅浅地一笑，但见眼波流转处，风情无限，周围的人不禁看呆了，浑然忘了身处何方。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
