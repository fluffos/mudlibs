#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m教主[1;31m之剑[2;37;0m", ({ "smzzj" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;34m一把嗜血成性的长剑，只有当世明教教主才能驾御他的魔性。[2;37;0m
剑柄上刻着一行小字：张无忌(smzz)
");
  set("value", 2100000);
  set("point", 400);
  set("material", "magic stone");
  set("wield_msg", "[1;34m教主[1;31m之剑[1;37m“嗖”的弹到$N的手中。[2;37;0m\n");
  set("unwield_msg", "[1;34m教主[1;31m之剑[1;37m“嗖”的脱离了$N的手中。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
