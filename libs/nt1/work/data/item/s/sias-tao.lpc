#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m安全套[2;37;0m", ({ "tao" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;31m干的时候戴的[2;37;0m
战衣缘上刻着一行小字：段克邪(sias)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "silk");
  set("wear_msg", "[1;31m要干了，戴上一个安全套[2;37;0m\n");
  set("remove_msg", "[1;31m不干了，脱上一个安全套[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
