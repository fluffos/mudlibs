#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m圣火袍[2;37;0m", ({ "shenghuo" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;35m这就是当年明教教主阳顶天留下的[1;31m圣火袍。[1;35m它的胸前用九百九十九条金丝锈着一团火红的火焰。[2;37;0m
战衣缘上刻着一行小字：张无忌(smzz)
");
  set("value", 2100000);
  set("point", 187);
  set("material", "silk");
  set("wear_msg", "[1;35m穿上当年明教教主阳顶天留下的[1;31m圣火袍。[1;35m只见一团火红的火焰照的你睁不开眼[2;37;0m\n");
  set("remove_msg", "[1;35m收起当年明教教主阳顶天留下的[1;31m圣火袍。[1;35m一团火红的火焰在你眼前转瞬即失。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
