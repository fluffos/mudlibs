#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m鄂鱼[1;33m皮带[2;37;0m", ({ "eypd" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set(
    "long",
    "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
只看见[1;36m段剑[2;37;0m腰上系了一条[1;36m高档[1;33m皮带[2;37;0m，[1;33m皮带[2;37;0m上隐隐有一条[1;31m鄂鱼[2;37;0m在缠绕着。[2;37;0m
腰带缘上刻着一行小字：段剑(swordmo)
"
  );
  set("value", 2100000);
  set("point", 76);
  set("material", "silk");
  set(
    "wear_msg",
    "突然，[1;36m$N[2;37;0m抓起一条[1;31m鄂鱼[2;37;0m就系在了腰上，仔细一看原来是一条[1;36m高档[1;33m皮带[2;37;0m。[2;37;0m\n"
  );
  set("remove_msg", "刹那间[1;36m$N[2;37;0m抓起一条[1;31m鄂鱼[2;37;0m就收了起来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
