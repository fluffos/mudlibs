#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("清羽[2;37;0m", ({ "slsword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m传说中古代部族道领颛顼所用的宝剑上书：瑞顼高阳氏有画影剑、腾空剑[2;37;0m
剑柄上刻着一行小字：紫萱(sleepbeer)
");
  set("value", 2100000);
  set("point", 227);
  set("material", "magic stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
