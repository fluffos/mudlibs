#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m方婉婷的尸体[2;37;0m", ({ "corpse" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
[1;31m方婉婷的尸体，只见双眼突出，七孔流血，样貌恐怖异常。[2;37;0m
指套缘上刻着一行小字：独孤傲(shadowkwan)
");
  set("value", 2100000);
  set("point", 790);
  set("material", "magic stone");
  set("wear_msg", "[1;32m$N把$n[1;33m的尸体拿出来，准备用来练[1;37m九淫白骨爪。[2;37;0m\n");
  set(
    "remove_msg",
    "[1;32m$N见[1;37m九淫白骨爪[1;33m练得相当纯熟，便取出一把化尸粉将$n[1;33m化掉，免得污染环境，有损市容。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/finger", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/claw", 10);

  setup();
}

string long() { return query("long") + item_long(); }
