#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m长袍[2;37;0m", ({ "pao" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
战衣缘上刻着一行小字：白云(sau)
");
  set("value", 2100000);
  set("point", 346);
  set("material", "silk");
  set("wear_msg", "[1;35m$N穿上一件$n[1;35m。[2;37;0m\n");
  set("remove_msg", "[1;35m$N将$n[1;35m脱下。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
