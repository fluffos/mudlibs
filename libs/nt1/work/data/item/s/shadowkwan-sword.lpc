#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m天傲[2;37;0m", ({ "sword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[37m上古神兵，自铸成以来只有三人能运用它，现为独孤傲所拥有[2;37;0m
剑柄上刻着一行小字：独孤傲(shadowkwan)
");
  set("value", 2100000);
  set("point", 400);
  set("material", "magic stone");
  set("wield_msg", "[1;32m$N[1;37m缓缓的将[37m$n[1;37m拔出剑鞘，剑上的[1;36m灵气[1;37m顿时冲塞着四周。[2;37;0m\n");
  set(
    "unwield_msg",
    "[1;32m$N[1;37m将$n[1;37m插入剑鞘，$n[1;37m仿佛[1;31m心有不甘[1;37m发出共鸣。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
