#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m止水[2;37;0m", ({ "katana" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;36m素子形影不离的武器，是她所景仰的姊姊送给她的爱刀—止水。[2;37;0m
剑柄上刻着一行小字：风魔(skydevil)
");
  set("value", 2100000);
  set("point", 201);
  set("material", "magic stone");
  set("wield_msg", "[1;36m天魔把止水从刀鞘中取出，只见刀锋显现出微柔的银光，散放在自然空气中。[2;37;0m\n");
  set("unwield_msg", "[1;36m一瞬间，天魔已经把止水收入刀鞘，把刀锋的光芒吸入体内。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
