#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m爱情[1;32m字典[2;37;0m", ({ "someone" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m这是[1;36m一本[1;37m关于[1;31m爱情[1;33m的[1;32m字典，[1;35m是由[1;33m孙燕姿[1;36m代言的。[2;37;0m
剑柄上刻着一行小字：夜听雨(stefyanzi)
");
  set("value", 2100000);
  set("point", 166);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;35m在[1;31m爱情[1;32m字典[1;33m里[1;36m找不到[1;37m永远，[1;36m我们[1;32m越走[1;33m越远[1;37m两个[1;32m世界[1;31m……[1;32m”\n[1;36m众人[1;33m耳边[1;37m传来[1;35m一段优美的[1;32m歌声……[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;35m在[1;31m爱情[1;32m字典[1;33m里[1;36m找不到[1;37m永远，[1;36m等到[1;32m我们[1;31m哭红[1;37m双眼[1;32m我才[1;31m发现……[1;32m”\n[1;36m众人[1;33m还在[1;37m回味刚才[1;35m那段优美的[1;32m歌声……[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
