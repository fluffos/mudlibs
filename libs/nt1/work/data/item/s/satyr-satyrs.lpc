#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m蚂蚁[1;31m神[1;33m剑[2;37;0m", ({ "satyrs" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;35m看什么看[1;31m再看砍死你[2;37;0m
剑柄上刻着一行小字：蚂蚁(satyr)
");
  set("value", 2100000);
  set("point", 226);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;37m偷偷拿出一把[1;32m$N[1;31m神[1;33m剑[1;37m，靠，做贼啊[1;31m你一剑在手，顿时胆色大增[2;37;0m\n"
  );
  set("unwield_msg", "[1;37m偷偷把[1;32m$N[1;31m神[1;33m剑[1;37m藏起来，哎，没救了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
