#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m短[1;31m袖[2;37;0m", ({ "sbfa" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;36m很合身，[1;33m做得不错[2;37;0m
战衣缘上刻着一行小字：龙八(sbf)
");
  set("value", 2100000);
  set("point", 220);
  set("material", "silk");
  set("wear_msg", "[1;37m天气冷啦！[1;36m要多穿[1;33m衣服[2;37;0m\n");
  set("remove_msg", "[1;37m天气热啦！[1;36m我脱！[1;33m我还脱！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
