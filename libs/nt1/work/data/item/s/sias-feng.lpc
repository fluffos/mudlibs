#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m风灵靴[2;37;0m", ({ "feng" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
风之灵附于其上[2;37;0m
靴子缘上刻着一行小字：段克邪(sias)
");
  set("value", 2100000);
  set("point", 74);
  set("material", "silk");
  set("wear_msg", "[1;32m天灵灵[2;37;0m\n");
  set("remove_msg", "[1;31m地灵灵[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
