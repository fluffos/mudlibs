#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("碎心的箫[2;37;0m", ({ "xiao" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[37m上古寒铁[2;37;0m炼制而成的一支箫。
平凡的物件必有不平凡之处[2;37;0m
箫柄上刻着一行小字：杨云(soulking)
");
  set("value", 1500000);
  set("point", 97);
  set("material", "steel");
  set("wield_msg", "暗淡的悠光闪过你以装备完成[2;37;0m\n");
  set("unwield_msg", "火焰般的白光闪过你以取下装备[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
