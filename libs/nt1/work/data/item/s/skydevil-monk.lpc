#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m酒肉和尚金禅衣[2;37;0m", ({ "monk" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
[1;33m酒肉和尚的金禅衣。[2;37;0m
护甲缘上刻着一行小字：风魔(skydevil)
");
  set("value", 2100000);
  set("point", 266);
  set("material", "magic stone");
  set("wear_msg", "[1;33m$N穿上了金禅衣装，迷到不少万千少女。[2;37;0m\n");
  set("remove_msg", "[1;33m$N身上突然暗然失色，原来$N潇洒地将金禅衣脱下。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
