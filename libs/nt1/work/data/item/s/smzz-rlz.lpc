#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m如来[1;34m神掌[2;37;0m", ({ "rlz" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;35m当年[1;37m如来佛祖[1;35m为了惩戒孙悟空的过错，将自己的手掌翻压在五行山上。
[1;37m因缘际会现在又落在了张无忌的手中。
[1;31m它看起来就是一只大手掌没又什么区别，只是五指之间有一股唳气散发出道道白光。[2;37;0m
铁掌缘上刻着一行小字：张无忌(smzz)
");
  set("value", 2100000);
  set("point", 800);
  set("material", "magic stone");
  set(
    "wear_msg",
    "[33m南无阿弥陀佛……[1;33m南无阿弥陀佛……\n[1;31m一阵阵佛语引来阵阵红光，转瞬之间在你的面前燃起一团[1;34m蓝色火焰。[1;37m难道是明教教主到了？[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;35m南无阿弥陀佛……\n[1;37m南无阿弥陀佛……[1;31m一阵阵佛语引来阵阵红光，转瞬之间在你的面前燃起一团[1;34m蓝色火焰。\n[1;37m在场之人开始感觉道头脑发涨，随着火焰渐渐的熄灭…你才深深的吸了口气。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);

  setup();
}

string long() { return query("long") + item_long(); }
