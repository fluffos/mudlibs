#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m鬼血[1;37m神刀[2;37;0m", ({ "zzzb" }));
  set_weight(3600);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双靴子。
靴子缘上刻着一行小字：慕容星(shet)
");
  set("value", 2100000);
  set("point", 147);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备[2;37;0m[31m鬼血[1;37m神刀[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[2;37;0m[31m鬼血[1;37m神刀[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
