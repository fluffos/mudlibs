#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m天籁[2;37;0m", ({ "heaven" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支箫。
[1;37m天籁[2;37;0m，[1;33m上古神器，蕴涵了[1;37m创世诸神[1;33m的力量，可以封印一切[1;31m邪恶[1;33m。[2;37;0m
箫柄上刻着一行小字：独孤傲(shadowkwan)
");
  set("value", 2100000);
  set("point", 791);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;32m$N[1;33m在地上画出了一个[1;34m魔法圈，[1;33m凝重的念到：“[1;37m创世的诸神[1;33m，以吾，[1;32m$N[1;33m的名义，祈求您们暂且放下尊贵的身份，赐我可以封印一切[1;31m邪恶的力量，[1;33m吹奏那[1;37m神萧－$n[2;37;0m\n"
