#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("手掌[2;37;0m", ({ "strike" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
不用看啊，是手掌！[2;37;0m
铁掌缘上刻着一行小字：空导(daoyan)
");
  set("value", 2100000);
  set("point", 273);
  set("material", "magic stone");
  set("wear_msg", "[1;37m烦！不写了[2;37;0m\n");
  set("remove_msg", "[1;37m走人！下机！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
