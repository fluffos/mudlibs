#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m无妄剑翼[2;37;0m", ({ "envyarm" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[35m万剑翼翅再生，浓烈魔气紫雾随剑锋冒出涌喷，围绕在[2;37;0m[31m无妄剑翼[2;37;0m[35m周围。[2;37;0m
战衣缘上刻着一行小字：堕落天使(depravity)
");
  set("value", 2100000);
  set("point", 263);
  set("material", "silk");
  set("wear_msg", "[1;34m剑气暴发，$N打出与无妄、铁甲同生的魔甲剑翅，\n纵横交错、扑天盖地般的袭向众人。[2;37;0m\n");
  set("remove_msg", "[1;34m刹那之间，$n[1;34m已从$N身上消失的无影无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
