#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m欣月[2;37;0m", ({ "fmoon" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一张护甲。
永远的好朋友[2;37;0m
护甲缘上刻着一行小字：唐狐(dylydzz)
");
  set("value", 2100000);
  set("point", 107);
  set("material", "silk");
  set("wear_msg", "[1;35m$N默运圣火心法，脸色先由黄翻紫，紧接着由紫翻蓝，再由蓝翻红，最后又恢复为黄色，甚为诡异。\n[2;37;0m\n");
  set("remove_msg", "[1;36m$N长吸一口气，运起云龙神功已将全身潜力尽数提起！\n[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
