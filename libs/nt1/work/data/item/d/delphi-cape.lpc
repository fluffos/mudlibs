#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m金毛狮王[2;37;0m", ({ "cape" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
[1;33m这是明教传说中的神盔，是四大护法中金毛狮王的化身！[2;37;0m
头盔缘上刻着一行小字：圣火令(delphi)
");
  set("value", 2100000);
  set("point", 87);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备[1;33m金毛狮王[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;33m金毛狮王[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
