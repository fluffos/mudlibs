#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m无妄[2;37;0m", ({ "envy" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[37m此剑是十大魔兵之一，乃剑皇的配剑。
剑名[2;37;0m[35m无妄[2;37;0m[37m，代表此剑将为天下带来难以
预计、无法阻止的恐怖灾劫！[2;37;0m
剑柄上刻着一行小字：堕落天使(depravity)
");
  set("value", 2100000);
  set("point", 272);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;34m$N[1;34m舍弃作为人的一切，在[35m魔兵[1;34m的引导下与万剑合一，转生成魔！\n[1;34m”[1;31m除剑以外，别无所有！[1;34m”[2;37;0m\n"
  );
  set("unwield_msg", "[1;34m$N把$n[1;34m收入怀中，散去魔气，一切又回归宁静。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
