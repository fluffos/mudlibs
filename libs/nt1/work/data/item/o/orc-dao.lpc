#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m七绝练魂刀[2;37;0m", ({ "dao" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
[1;31m这就是传说中可以斩断五行与阴阳的魔刀。[2;37;0m
刀柄上刻着一行小字：战歌(orc)
");
  set("value", 2100000);
  set("point", 230);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;31m$N[1;36m向虚空伸手一抓，一道晴空霹雳出现在[1;31m$N[1;36m的手上，一把刀身刻着七种上古魔兽王的魔刀出现在[1;31m$N[1;36m的手上。[2;37;0m\n"
  );
  set("unwield_msg", "[1;31m$N[1;36m随手一挥，[37m$n[1;36m消失不见。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
