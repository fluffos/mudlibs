#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m紫霞[1;37m绝杀令[2;37;0m", ({ "juesha" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;31m紫霞宫发出的绝杀令，所到之处杀！杀！杀！！[2;37;0m
剑柄上刻着一行小字：慕容闻琳(venice)
");
  set("value", 2100000);
  set("point", 1036);
  set("material", "magic stone");
  set("wield_msg", "[1;31m$N冷哼一声，抽出[1;35m紫霞[1;37m绝杀令[1;31m，刹时一股煞气弥漫四周！[2;37;0m\n");
  set("unwield_msg", "[1;32m$N一挥手，收回令牌。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
