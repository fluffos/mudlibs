#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m双子座黄金圣衣[2;37;0m", ({ "shengyi" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一张护甲。
[1;33m这是守护女神雅典娜的十二宫圣斗士中双子星座的黄金圣衣。[2;37;0m
护甲缘上刻着一行小字：道魔(kevin)
");
  set("value", 2100000);
  set("point", 95);
  set("material", "silk");
  set("wear_msg", "[1;33m一声长鸣，圣衣自动从包裹里解体保护在你的身体上。[2;37;0m\n");
  set("remove_msg", "[35m战斗结束，圣衣自动从你身上脱下并重新合成双子星座。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
