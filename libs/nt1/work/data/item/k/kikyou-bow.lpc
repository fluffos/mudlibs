#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m破魔弓[2;37;0m", ({ "bow" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支箫。
箫柄上刻着一行小字：桔梗(kikyou)
");
  set("value", 2100000);
  set("point", 650);
  set("material", "magic stone");
  set("wield_msg", "[1;31mしそゑちそせぅにひねさぃ——破魔\n[2;37;0m\n");
  set("unwield_msg", "[1;31mしそゑちそせぅにひねさぃ——退魔\n[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
