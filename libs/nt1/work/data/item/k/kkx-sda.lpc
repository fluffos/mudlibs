#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m邪剑[2;37;0m", ({ "sda" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：卡卡西(kkx)
");
  set("value", 2100000);
  set("point", 372);
  set("material", "magic stone");
  set("wield_msg", "[1;31m嘿嘿嘿嘿，你们死定了[2;37;0m\n");
  set("unwield_msg", "[1;31m嘿嘿嘿嘿，你们死定了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
