#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m白龙之筋[2;37;0m", ({ "whips" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一根鞭。
鞭柄上刻着一行小字：净叶(kobebb)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
