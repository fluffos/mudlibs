#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[34m鬼护手[2;37;0m", ({ "shou" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
全色特装[2;37;0m
铁掌缘上刻着一行小字：快意江湖(kyjh)
");
  set("value", 2100000);
  set("point", 195);
  set("material", "magic stone");
  set("wear_msg", "小心中毒哦[2;37;0m\n");
  set("remove_msg", "嘿嘿[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
