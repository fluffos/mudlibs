#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m乾坤铁掌[2;37;0m", ({ "hand" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;31m一个看起来普普通通的铁手掌，幽幽的泛着红光。[2;37;0m
铁掌缘上刻着一行小字：乾坤(qiankun)
");
  set("value", 2100000);
  set("point", 206);
  set("material", "magic stone");
  set("wear_msg", "[1;31m只见一道红光闪过，$N铁掌飞到你手中，你整个手开始发红光了。[2;37;0m\n");
  set("remove_msg", "[1;31m清除了一下$N铁掌上的血迹，然后将他放入怀中，[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/hand", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
