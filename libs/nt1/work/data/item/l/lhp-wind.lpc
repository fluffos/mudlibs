#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m冷月清风[2;37;0m", ({ "wind" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
这是件用天蚕丝制成的披风，其做工之精细，想必是经过无数道工序精心编织而成，不知道是哪位心灵手巧的女孩编织给心上人的礼物。[2;37;0m
战衣缘上刻着一行小字：少龙(lhp)
");
  set("value", 2100000);
  set("point", 678);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;36m冷月清风[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;36m冷月清风[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
