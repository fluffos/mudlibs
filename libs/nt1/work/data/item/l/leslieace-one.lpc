#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m没有你的没一天[2;37;0m", ({ "one" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[36m徐婕儿唱的歌[2;37;0m
铁掌缘上刻着一行小字：南宫图(leslieace)
");
  set("value", 2100000);
  set("point", 280);
  set("material", "magic stone");
  set("wear_msg", "[36m没有你的每一天，快乐离我好遥远。心已随你走了，还能用什么感觉。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[2;37;0m[36m没有你的没一天[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/hand", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);

  setup();
}

string long() { return query("long") + item_long(); }
