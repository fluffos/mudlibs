#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m龙[1;33m之[1;31m角[2;37;0m", ({ "laa" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
头盔缘上刻着一行小字：南宫图(leslieace)
");
  set("value", 2100000);
  set("point", 147);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备[1;31m龙[1;33m之[1;31m角[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m龙[1;33m之[1;31m角[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
