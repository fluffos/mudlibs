#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m封灵剑[2;37;0m", ({ "skc" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[2;37;0m[37m封灵剑[2;37;0m[37m，就是一把由天神铸链的兵器。[2;37;0m
剑柄上刻着一行小字：雷斯魔(lsm)
");
  set("value", 2100000);
  set("point", 364);
  set("material", "magic stone");
  set("wield_msg", "[1;31m$N心中的正气突然上升，有一种$N从来未感觉过的热力，$N发觉$n[1;31m就在$N手里。[2;37;0m\n");
  set("unwield_msg", "[37m$N突然大叫，手中的$n[37m就消失了，旁人对$N也摸不住头脑。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
