#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m登[1;35m登[36m剑[2;37;0m", ({ "ddj" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：本拉灯(ladeng)
");
  set("value", 2100000);
  set("point", 145);
  set("material", "magic stone");
  set("wield_msg", "这就是横扫扬州小孩的[1;34m登[1;35m登[36m剑[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
