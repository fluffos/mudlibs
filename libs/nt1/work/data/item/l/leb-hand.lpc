#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m擒[1;37m龙[1;36m手[2;37;0m", ({ "hand" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
铁掌缘上刻着一行小字：孤影(leb)
");
  set("value", 2100000);
  set("point", 185);
  set("material", "magic stone");
  set("wear_msg", "$N大声一喝守护者何在，霎时天昏地暗，雷声隆隆，只见天上的五爪金龙应了一声在，化为一道金光钻入$N手里。[2;37;0m\n");
  set("remove_msg", "$N道你们去吧五爪金龙应了一声，斩龙手消失了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);

  setup();
}

string long() { return query("long") + item_long(); }
