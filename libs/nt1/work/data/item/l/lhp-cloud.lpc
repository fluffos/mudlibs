#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m似水流云[2;37;0m", ({ "cloud" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;34m云飘过天空，不会留下一丝痕迹。云飘入心中，却会留下永恒的记忆。流云似水，似水流云。[2;37;0m
腰带缘上刻着一行小字：少龙(lhp)
");
  set("value", 2100000);
  set("point", 271);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;34m似水流云[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;34m似水流云[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
