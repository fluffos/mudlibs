#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m苏芳鼻毛刺[2;37;0m", ({ "jianc" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
各位观众，小心[2;37;0m[33m苏芳鼻毛刺[2;37;0m，上面附有剧毒。[2;37;0m
剑柄上刻着一行小字：洛神(lshen)
");
  set("value", 2100000);
  set("point", 1307);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[36m$N说道：这位婆婆可否借法宝一用？\n苏芳对着$N点了点头说道：现今我的武器已和我人剑合一，且看\n[1;37m苏芳突然大喝一声，伸出手往鼻孔里一抓，忽然乌云密布雷声隐隐。\n[2;37;0m苏芳递给$N一根丈二长的鼻毛软剑。[2;37;0m\n"
  );
  set("unwield_msg", "[2;37;0m$N将一根脏兮兮的软剑一点点地塞回苏芳的朝天鼻孔里。\n[36m$N对苏芳表示衷心的感谢。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
