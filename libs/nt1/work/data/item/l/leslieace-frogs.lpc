#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m青蛙宝甲[2;37;0m", ({ "frogs" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
护甲缘上刻着一行小字：南宫图(leslieace)
");
  set("value", 2100000);
  set("point", 224);
  set("material", "magic stone");
  set("wear_msg", "[1;36m难道这就是传说中的[1;35m☆[1;32m青蛙宝甲[1;35m☆[1;36m！？[2;37;0m\n");
  set("remove_msg", "[1;36m难道这就是传说中的[1;35m☆[1;32m青蛙宝甲[1;35m☆[1;36m！？[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
