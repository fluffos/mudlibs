#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m唯我独尊[2;37;0m", ({ "wwdzi" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：流风(liufeng)
");
  set("value", 700000);
  set("point", 30);
  set("material", "iron");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
