#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m霜之剑[2;37;0m", ({ "mysword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：李太白(libai)
");
  set("value", 2100000);
  set("point", 365);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;36m$N一伸手抓住剑柄，“锵”一声长剑出鞘。$N将$n[1;36m直直地举起。\n$n[1;36m甫一出鞘，剑身突然寒光大盛，刃口有异光流动，剑光竟象化成了有形有质。\n一瞬间，如入严冬，寒气刺骨。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[33m$N一反手将长剑入鞘。“锵”然余音如一根长线袅袅不绝，\n漫天雷声翻涌却掩不住$n[33m的入鞘之声，\n边上的人不约而同地听着那一线余音越散越远。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
