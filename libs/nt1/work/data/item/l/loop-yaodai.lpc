#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m月影宝带[2;37;0m", ({ "yaodai" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
是为胡小僧度身定做，样式朴实无华，在月光下有月影隐现其上。[2;37;0m
腰带缘上刻着一行小字：胡小僧(loop)
");
  set("value", 2100000);
  set("point", 70);
  set("material", "silk");
  set("wear_msg", "$N将$n系在腰上，四处顾盼一番，显得得意非凡。[2;37;0m\n");
  set("remove_msg", "$N将$n解开除下，淡然一笑。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
