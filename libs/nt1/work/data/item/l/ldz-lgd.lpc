#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m老钢刀[2;37;0m", ({ "lgd" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：浪荡子(ldz)
");
  set("value", 2100000);
  set("point", 643);
  set("material", "magic stone");
  set("wield_msg", "[1;37m钢刀虽然老了，但还是可以用。[2;37;0m\n");
  set("unwield_msg", "[1;37m老钢刀嘶哑着叫了一声，两腿一蹬，碎作了[1;35m千百琉璃。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
