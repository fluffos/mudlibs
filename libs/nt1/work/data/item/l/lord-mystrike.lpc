#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m虎符[2;37;0m", ({ "mystrike" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set(
    "long",
    "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;31m它是古代帝王授予臣属兵权和调拨军队用的信物。用铜铸成虎形，背上铸有铭文，分为左右两半，左半发给地方官吏或统兵的将帅，右半留存在中央。调拨军队时，须由使臣持符验合，方能生效。[2;37;0m
铁掌缘上刻着一行小字：赢政(lord)
"
  );
  set("value", 2100000);
  set("point", 297);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备[1;31m虎符[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m虎符[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);

  setup();
}

string long() { return query("long") + item_long(); }
