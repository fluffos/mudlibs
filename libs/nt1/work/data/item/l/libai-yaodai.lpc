#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m绿丝绦[2;37;0m", ({ "yaodai" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
腰带缘上刻着一行小字：李太白(libai)
");
  set("value", 2100000);
  set("point", 95);
  set("material", "silk");
  set("wear_msg", "[1;35m$N仔细将$n[1;35m系在腰间，满意地一笑。[2;37;0m\n");
  set("remove_msg", "[33m$N将$n[33m解了下来，收入怀里。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
