#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m沧海月明[2;37;0m", ({ "moon" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
[1;33m沧海月明珠有泪[2;37;0m
头盔缘上刻着一行小字：少龙(lhp)
");
  set("value", 2100000);
  set("point", 341);
  set("material", "magic stone");
  set("wear_msg", "[1;32m锦瑟无端五十弦，一弦一柱思华年。[2;37;0m\n");
  set("remove_msg", "[1;35m庄生晓梦迷蝴蝶，望帝春心托杜鹃。　[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
