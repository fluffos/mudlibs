#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m夏日香气[2;37;0m", ({ "summer" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;32m夏日午后，下雨的黄昏，散发自灵魂深处的香气。[2;37;0m
战衣缘上刻着一行小字：少龙(lhp)
");
  set("value", 2100000);
  set("point", 682);
  set("material", "silk");
  set("wear_msg", "[1;32m夏天的海边，吹来熙熙凉风。让人精神爽快，咸咸的味道，夏天的香气！[2;37;0m\n");
  set("remove_msg", "[1;32m香气久久不散，飘荡在空气中，让人回味无穷！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
