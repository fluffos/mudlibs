#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("贱中贱[2;37;0m", ({ "sword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
人贱人爱的贱中贱[2;37;0m[2;37;0m
剑柄上刻着一行小字：性格兄(ngsia)
");
  set("value", 2100000);
  set("point", 174);
  set("material", "magic stone");
  set("wield_msg", "$N唰的一声，从屁股后面抽出一把$n，真不知道这么大的一把剑是怎么藏在屁股后面的？[2;37;0m\n");
  set("unwield_msg", "$N又是唰的一声，把$n往屁股后面插了进去，差点吓倒了旁边的路人甲。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
