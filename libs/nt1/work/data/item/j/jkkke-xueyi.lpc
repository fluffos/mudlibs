#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("血衣[2;37;0m", ({ "xueyi" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一张护甲。
只见你飞了起来[2;37;0m
护甲缘上刻着一行小字：血魔狂龙(jkkke)
");
  set("value", 700000);
  set("point", 24);
  set("material", "iron");
  set("wear_msg", "只见你死了[2;37;0m\n");
  set("remove_msg", "只见你死了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
