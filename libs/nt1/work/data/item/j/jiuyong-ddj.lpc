#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[34m登[35m登[33m剑[2;37;0m", ({ "ddj" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：慕容复燕(jiuyong)
");
  set("value", 2100000);
  set("point", 479);
  set("material", "magic stone");
  set("wield_msg", "这就是横扫扬州小孩的[34m登[35m登[33m剑[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
