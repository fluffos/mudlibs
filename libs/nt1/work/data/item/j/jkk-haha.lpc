#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("折杀[2;37;0m", ({ "haha" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
杀人者[2;37;0m
铁掌缘上刻着一行小字：斩刀客(jkk)
");
  set("value", 2100000);
  set("point", 155);
  set("material", "magic stone");
  set("wear_msg", "[33m$N[33m装备折杀[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了折杀[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
