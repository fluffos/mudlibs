#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m风林火山[2;37;0m", ({ "huoshan" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;31m风吹树林火烧山[2;37;0m
剑柄上刻着一行小字：蓝魔之泪(riyuex)
");
  set("value", 2100000);
  set("point", 236);
  set("material", "magic stone");
  set("wield_msg", "[1;31m大风起兮云飞扬[2;37;0m\n");
  set("unwield_msg", "[1;31m大火去兮骨肉残[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
