#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("令牌[2;37;0m", ({ "ling" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;31m天下通吃令[2;37;0m
剑柄上刻着一行小字：日月侠(riyuex)
");
  set("value", 2100000);
  set("point", 221);
  set("material", "magic stone");
  set("wield_msg", "[1;37m$N一仰脖，吞下了一颗[1;35m玄黄紫清丹[1;37m，只见$N浑身一颤，七窍都冒出白烟来。[2;37;0m\n");
  set("unwield_msg", "[1;31m刹那间只见$N全身顿时浮现出一层刚猛的劲气，将你全全笼罩。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
