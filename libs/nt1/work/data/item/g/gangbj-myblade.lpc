#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m开天斧[2;37;0m", ({ "myblade" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：唐三藏(gangbj)
");
  set("value", 2100000);
  set("point", 820);
  set("material", "magic stone");
  set("wield_msg", "[1;37m$N哼了一声，取下一柄$n[1;37m。[2;37;0m\n");
  set("unwield_msg", "$n[1;36m化作一道红光，消失无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
