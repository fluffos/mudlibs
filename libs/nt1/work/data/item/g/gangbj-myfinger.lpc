#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m日[1;37m月[1;36m无光[2;37;0m", ({ "myfinger" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
指套缘上刻着一行小字：唐三藏(gangbj)
");
  set("value", 2100000);
  set("point", 820);
  set("material", "magic stone");
  set("wear_msg", "[1;37m$N眉头一皱，恍若秋风肃瑟。[2;37;0m\n");
  set("remove_msg", "[1;32m$N轻轻一笑，好像春天都来了啊！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/finger", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
