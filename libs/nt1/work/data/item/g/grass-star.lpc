#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m星辰之门[2;37;0m", ({ "star" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
护甲缘上刻着一行小字：小草(grass)
");
  set("value", 2100000);
  set("point", 452);
  set("material", "magic stone");
  set("wear_msg", "[37m比虚无更为缥缈的所在，[33m比幽冥更为深沉的归宿，[1;35m幽游于一切存有的伟大旅者，[1;36m请驻足垂怜～[2;37;0m\n");
  set(
    "remove_msg",
    "[1;33m吾将以未来无限可能为礼，[1;37m求前进现世世界渺茫之路[1;34m……[1;32m将惶惶于您前的迷途羔羊，[1;31m牵引至永无终点的无尽旅途[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
