#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m莲华[2;37;0m", ({ "flower" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：小草(grass)
");
  set("value", 2100000);
  set("point", 270);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[37m八门遁甲[33m——[36m☆开[35m★休[34m☆生[31m★伤[1;35m☆杜[1;32m★景[1;37m☆惊[1;31m★死[1;33m，[1;36m八门全开[1;34m，[1;33m超必杀技[1;32m◆[1;35m究极奥义[1;31m——[1;37m里[1;35m●[1;32m莲华[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[33m木叶[35m的[1;32m莲华[37m将[34m会[1;33m为[1;35m心爱[1;37m的[1;36m你[1;34m再次[1;31m绽放[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
