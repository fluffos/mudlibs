#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[30m末日[1;37m天启[2;37;0m", ({ "end" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
一把可以呼唤终末之日的魔剑，传说为云飘之翼在谜样的第五次元里而获得。[2;37;0m
剑柄上刻着一行小字：云飘之翼(godkenny)
");
  set("value", 2100000);
  set("point", 260);
  set("material", "magic stone");
  set("wield_msg", "$N心神念动，$n穿越时光与空间的限制，伴随著末日之时而来。[2;37;0m\n");
  set("unwield_msg", "终末的日子又再一次的随著$n的消失而延后了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
