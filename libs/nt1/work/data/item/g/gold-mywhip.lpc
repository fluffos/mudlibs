#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m打神鞭[2;37;0m", ({ "mywhip" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一根鞭。
[1;35m一只能打死神的鞭子！[2;37;0m
鞭柄上刻着一行小字：蓝魔(gold)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;35m打神鞭出，谁与争风！[2;37;0m\n");
  set("unwield_msg", "[1;35m打神鞭去，大家放屁！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
