#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m玉萧剑[2;37;0m", ({ "xiao" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m一把既是萧又是剑的玉萧剑！！！！[2;37;0m
剑柄上刻着一行小字：黄金(gold)
");
  set("value", 2100000);
  set("point", 175);
  set("material", "magic stone");
  set("wield_msg", "[1;31m$N临空一指，变出一把玉萧剑握在手里！！！[2;37;0m\n");
  set("unwield_msg", "[1;33m$N随手将玉萧剑往地上一扔，奇怪马上就不见了！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
