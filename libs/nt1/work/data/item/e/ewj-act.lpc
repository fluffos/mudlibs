#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m演员的修养[2;37;0m", ({ "act" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;36m其实我是个演员[2;37;0m
剑柄上刻着一行小字：尹天仇(ewj)
");
  set("value", 2100000);
  set("point", 221);
  set("material", "magic stone");
  set("wield_msg", "[1;37m惊天地！！泣鬼神！！！[2;37;0m\n");
  set("unwield_msg", "[1;36m哦，拍电影！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
