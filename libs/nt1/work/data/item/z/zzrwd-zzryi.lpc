#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m保暧内衣[2;37;0m", ({ "zzryi" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一张护甲。
[1;35m这是一件名人保暧内衣[2;37;0m
护甲缘上刻着一行小字：渡空(zzrwd)
");
  set("value", 2100000);
  set("point", 201);
  set("material", "silk");
  set("wear_msg", "[1;35m穿上了刚从商店买来的名人保暧内衣[1;31m穿上它真的爽就一个字[34m让自己变帅了不多[2;37;0m\n");
  set("remove_msg", "[37m看看保暧内衣有点脏了[1;37m还是拿到干洗店洗洗吧[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
