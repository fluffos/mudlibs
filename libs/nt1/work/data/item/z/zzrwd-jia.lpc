#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m伏魔袈裟[2;37;0m", ({ "jia" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[35m由[1;33m如来佛祖[1;37m用[1;35m众多仙家[1;31m仙血染成[2;37;0m
战衣缘上刻着一行小字：渡空(zzrwd)
");
  set("value", 2100000);
  set("point", 221);
  set("material", "silk");
  set("wear_msg", "[35m从天而降一件袈裟披在你身上[2;37;0m\n");
  set("remove_msg", "[33m脱上伏魔袈裟把它叠好了放在皮包里[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
