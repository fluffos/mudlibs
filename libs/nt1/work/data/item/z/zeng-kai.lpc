#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m火麒麟之铠[2;37;0m", ({ "kai" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;31m强大的魔导师水水所穿的套装之一[2;37;0m
战衣缘上刻着一行小字：水水(zeng)
");
  set("value", 2100000);
  set("point", 226);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;31m火麒麟之铠[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m火麒麟之铠[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
