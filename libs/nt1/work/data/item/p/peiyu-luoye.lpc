#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m落叶他乡树[2;37;0m", ({ "luoye" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;32m一个很好看的腰带，上面绣满了落叶，腰带中间的环扣作枯树状！[2;37;0m
腰带缘上刻着一行小字：俞佩玉(peiyu)
");
  set("value", 2100000);
  set("point", 116);
  set("material", "silk");
  set("wear_msg", "[1;32m$N围上了一个漂亮的腰带，但是为什么他的神色却少了刚才的那份飞扬呢？他想起了什么？[2;37;0m\n");
  set("remove_msg", "[1;32m$N解下了身上的腰带，叹道：“落叶虽然凄美，奈何是他乡的树，什么时候能再看到家门前的老树呢？”[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
