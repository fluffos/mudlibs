#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m江海寄余生[2;37;0m", ({ "jianghai" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
[1;32m一件飘飘荡荡着的衣服，无风也自舞，摆脚处如同波浪一样时而细腻平静、时而粗旷激荡。[2;37;0m
战衣缘上刻着一行小字：俞佩玉(peiyu)
");
  set("value", 2100000);
  set("point", 306);
  set("material", "silk");
  set(
    "wear_msg",
    "[1;32m不知不觉间，一阵如同海水似的茫茫无垠的风涌了过来，只见$N穿上了一件$n[1;32m。\n穿上衣服之后$N身形竟似是虚幻的，飘飘摇摇，随着衣服的摆动而荡漾，飘忽出一种大海的心跳。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;32m$N脱下了身上的$n[1;32m，身子凝重如山，不再飘忽不定了。\n而刚才那件衣服也像海水退潮一般，茫茫然不知哪里去了，偏偏又存乎于天地间。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
