#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m郎骑竹马来[2;37;0m", ({ "zhuma" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
[1;32m一双由翠绿的竹子编成的鞋子，做工十分粗糙，但是并没有什么磨损，显见得主人十分爱惜。[2;37;0m
靴子缘上刻着一行小字：俞佩玉(peiyu)
");
  set("value", 2100000);
  set("point", 122);
  set("material", "silk");
  set(
    "wear_msg",
    "[1;32m$N穿起一双由翠绿的竹子制成的鞋子，虽然已经不怎么合脚了，但是$N却全不在意。\n穿上之后，$N的眼神变得十分温柔清新，腼腆之色溢于脸上，分明是想起了遥远的伊人。[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[1;32m$N脱下了那双竹子编织成的鞋子，眼里神色复归淡然，仿佛一切记忆不曾有过似的。\n可是心底里却在低声的吟诵着：“郎骑竹马来，绕床弄青梅。你去了哪里呢？”[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
