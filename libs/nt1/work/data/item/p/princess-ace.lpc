#include <ansi.h>
#include <weapon.h>

inherit DAGGER;
inherit F_ITEMMAKE;

void create() {
  set_name("千王之王[2;37;0m", ({ "ace" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支短兵。
短兵柄上刻着一行小字：新月(princess)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;36m【论道江湖】千王之王挺了挺胸，神气地对梦魇说：那当然啦。[2;37;0m\n");
  set("unwield_msg", "[1;36m【论道江湖】千王之王说到：哦，原来是这样的啊。我知道了啦。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_dagger(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
