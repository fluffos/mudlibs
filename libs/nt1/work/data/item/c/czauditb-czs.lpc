#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m茅台[2;37;0m", ({ "czs" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;33m性之所然[2;37;0m
剑柄上刻着一行小字：渡性(czauditb)
");
  set("value", 2100000);
  set("point", 193);
  set("material", "magic stone");
  set("wield_msg", "[1;33m酒肉穿肠过[1;34m美女心中留[2;37;0m\n");
  set("unwield_msg", "[1;35m天子呼来不上船[1;36m自称臣是酒中仙[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
