#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[30m无影刀[2;37;0m", ({ "gold" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
[1;33m看不到刀哦[2;37;0m
刀柄上刻着一行小字：布衣(cloth)
");
  set("value", 2100000);
  set("point", 220);
  set("material", "magic stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "[1;33m去无踪哦[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
