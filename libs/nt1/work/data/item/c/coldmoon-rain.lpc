#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m雨[1;32m丝[1;35m情愁[2;37;0m", ({ "rain" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m这是一代女侠[1;35m寒月[1;37m的佩剑，剑身细长轻薄若丝，剑柄上镶嵌有
宝石，紫檀木镶金剑鞘上刻有－－[1;31m雨丝[2;37;0m
剑柄上刻着一行小字：寒月(coldmoon)
");
  set("value", 2100000);
  set("point", 748);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[1;34m“锵！”\n细长锐利的宝剑已从紫檀镶金剑鞘中夺鞘而出，在$N的手中\n幻化出万道寒光，如江南的细雨，缠绵不绝，轻轻柔柔却蕴含\n着无穷的能量。[2;37;0m\n"
  );
  set("unwield_msg", "[1;34m$N左手手指剑诀，轻轻抚过剑身，宝剑的光芒渐渐隐入剑鞘\n之中[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
