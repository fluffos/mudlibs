#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("阿比特[2;37;0m", ({ "dancea" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
腰带缘上刻着一行小字：不如跳舞(windance)
");
  set("value", 2100000);
  set("point", 83);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备阿比特[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了阿比特[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
