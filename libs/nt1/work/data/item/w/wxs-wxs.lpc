#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m伤心小剑[2;37;0m", ({ "wxs" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑身很短，剑柄很长，看上去黝黑不显眼[2;37;0m
剑柄上刻着一行小字：王小石(wxs)
");
  set("value", 2100000);
  set("point", 133);
  set("material", "magic stone");
  set("wield_msg", "亮起一把黝黑的小剑[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
