#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("清风[2;37;0m", ({ "ljwpz" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
一把锋利的剑[2;37;0m
剑柄上刻着一行小字：月光光(wpzlj)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;36m一阵狂风过后[2;37;0m\n");
  set("unwield_msg", "[1;36m收[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
