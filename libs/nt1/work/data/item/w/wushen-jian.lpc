#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m心剑[2;37;0m", ({ "jian" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：虚武(wushen)
");
  set("value", 2100000);
  set("point", 221);
  set("material", "magic stone");
  set("wield_msg", "天空一阵暗色，从中劈开一道闪电，一把剑徐徐落下。[2;37;0m\n");
  set("unwield_msg", "杀气突地一收，武神手上的剑已了无踪迹。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
