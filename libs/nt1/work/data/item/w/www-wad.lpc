#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m绛朱[1;31m混天绫[2;37;0m", ({ "wad" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
哪吒的独门兵器，拥有伏魔捆仙的无上神力。[2;37;0m
腰带缘上刻着一行小字：悟空(www)
");
  set("value", 2100000);
  set("point", 154);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;37m绛朱[1;31m混天绫[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;37m绛朱[1;31m混天绫[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
