#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m武林终结版[2;37;0m", ({ "wllzend" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双铁掌。
[1;32m这是一把武林列传的武器之武林终结版[2;37;0m
铁掌缘上刻着一行小字：武林列传(wllz)
");
  set("value", 4100000);
  set("point", 879);
  set("material", "tian jing");
  set("wear_msg", "[1;37m$N[1;35m高兴一笑，哈哈。。。$n[1;32m终于出版了[2;37;0m\n");
  set("remove_msg", "$n[1;36m已经买完了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/strike", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/hand", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
