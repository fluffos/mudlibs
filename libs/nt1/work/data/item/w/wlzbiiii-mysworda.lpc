#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m龙纹剑[2;37;0m", ({ "mysworda" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m传说中的[1;33m龙纹剑[2;37;0m
剑柄上刻着一行小字：武林争帝(wlzbiiii)
");
  set("value", 2100000);
  set("point", 318);
  set("material", "magic stone");
  set("wield_msg", "[1;32m$N[1;35m拔出一把[1;33m龙纹剑[1;31m天地为之变色[2;37;0m\n");
  set("unwield_msg", "[1;32m$N[1;35m把[1;33m龙纹剑[1;31m收起来[1;34m天地恢复了颜色[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
