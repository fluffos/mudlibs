#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m小袅袅[2;37;0m", ({ "sbird" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：武林列传(wllz)
");
  set("value", 2100000);
  set("point", 800);
  set("material", "magic stone");
  set("wield_msg", "$n[1;32m突然出现在[1;35m$N[1;32m面前笑眯眯地问：[1;35m$N[1;32m，有没有想我啊？[2;37;0m\n");
  set(
    "unwield_msg",
    "[1;35m$N[1;37m赶忙答到：是啊，是啊，$n[1;37m，我想你。却听山谷中传来阵阵回声：想你～～～想你～～你～～～[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
