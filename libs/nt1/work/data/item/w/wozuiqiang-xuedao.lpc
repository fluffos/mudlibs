#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m血刀[2;37;0m", ({ "xuedao" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
[1;31m寒气鄙人[2;37;0m
刀柄上刻着一行小字：血影(wozuiqiang)
");
  set("value", 2100000);
  set("point", 100);
  set("material", "magic stone");
  set("wield_msg", "[1;31m从身后拔出一个什么东西大叫到拿命来[2;37;0m\n");
  set("unwield_msg", "[1;31m这次我就饶了你快走把说着摸摸你的头轻声说要乖哦[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
