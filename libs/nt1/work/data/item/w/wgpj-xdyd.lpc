#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m血刀腰带[2;37;0m", ({ "xdyd" }));
  set_weight(1440);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[33m乌金丝[2;37;0m炼制而成的一条腰带。
腰带缘上刻着一行小字：刚子(wgpj)
");
  set("value", 1500000);
  set("point", 28);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;31m血刀腰带[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m血刀腰带[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
