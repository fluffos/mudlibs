#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("面筛子[2;37;0m", ({ "shou" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;31m我靠。面筛子没见过啊？[2;37;0m
铁掌缘上刻着一行小字：刚子(wgpj)
");
  set("value", 2100000);
  set("point", 220);
  set("material", "magic stone");
  set("wear_msg", "[1;31m平地响起一声雷。我他妈的不怕谁[2;37;0m\n");
  set("remove_msg", "[1;32m光脚不怕穿鞋的。下次走着瞧[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);

  setup();
}

string long() { return query("long") + item_long(); }
