#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m皂罗袍[2;37;0m", ({ "pao" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
看上去有些陈旧，但穿上一定很舒服。[2;37;0m
战衣缘上刻着一行小字：曰曰(toyota)
");
  set("value", 2100000);
  set("point", 246);
  set("material", "silk");
  set("wear_msg", "[1;33m$N轻轻将$n[1;33m披在身上。[2;37;0m\n");
  set("remove_msg", "[1;33m$N将$n[1;33m解下，收入包袱中。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
