#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m九幽爪[2;37;0m", ({ "myclaw" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
爪上隐隐发出阵阵魔气，仿佛有生命的魔物一般。[2;37;0m
指套缘上刻着一行小字：曰曰(toyota)
");
  set("value", 2100000);
  set("point", 246);
  set("material", "magic stone");
  set("wear_msg", "[1;34m一道黑气自虚无中生出，盘在$N腕上，空气中顿时充斥了些许杀意。[2;37;0m\n");
  set("remove_msg", "[1;37m$N微一扬手，腕上黑气悄然散去。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/finger", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
