#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m幽冥战靴[2;37;0m", ({ "xue" }));
  set_weight(3600);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双靴子。
乃精工打造的战靴。[2;37;0m
靴子缘上刻着一行小字：曰曰(toyota)
");
  set("value", 2100000);
  set("point", 98);
  set("material", "magic stone");
  set("wear_msg", "$N穿上了$n。[2;37;0m\n");
  set("remove_msg", "$N脱下了$n。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
