#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m小帽[2;37;0m", ({ "kui" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
头盔缘上刻着一行小字：唐四藏(tang)
");
  set("value", 2100000);
  set("point", 128);
  set("material", "magic stone");
  set("wear_msg", "[1;35m$N取出一顶$n[1;35m戴在头上。[2;37;0m\n");
  set("remove_msg", "[1;37m$N将$n[1;37m从头上摘了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
