#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m绝世好剑[2;37;0m", ({ "djy" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m以三毒之血[1;31m（嗔）[1;32m（痴）[1;35m（贪）[1;37m炼制的宝剑[2;37;0m
剑柄上刻着一行小字：猎人(hunterx)
");
  set("value", 2100000);
  set("point", 668);
  set("material", "magic stone");
  set("wield_msg", "[1;37m我是天下第一[2;37;0m\n");
  set("unwield_msg", "[1;37m我是天下第一[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
