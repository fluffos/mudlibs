#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m屠龙[2;37;0m", ({ "hanhan" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;31m战士顶级武器[2;37;0m
铁掌缘上刻着一行小字：勇哥(hanweiyong)
");
  set("value", 2100000);
  set("point", 800);
  set("material", "magic stone");
  set("wear_msg", "[1;37m好重的屠龙[2;37;0m\n");
  set("remove_msg", "[1;32m放下武器[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);

  setup();
}

string long() { return query("long") + item_long(); }
