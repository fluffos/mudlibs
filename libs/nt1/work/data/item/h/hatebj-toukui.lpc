#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m面具[2;37;0m", ({ "toukui" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一顶头盔。
头盔缘上刻着一行小字：王从阳(hatebj)
");
  set("value", 2100000);
  set("point", 128);
  set("material", "magic stone");
  set("wear_msg", "[1;33m$N戴上一副$n[33m，开始化装成[1;36m高处不胜寒[33m。[2;37;0m\n");
  set("remove_msg", "[1;36m$N从脸上把$n[1;36m取了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
