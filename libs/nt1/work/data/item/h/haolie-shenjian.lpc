#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m辉日[1;32m之剑[2;37;0m", ({ "shenjian" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;34m暗淡无光，平凡中透着神奇[2;37;0m
剑柄上刻着一行小字：段星(haolie)
");
  set("value", 2100000);
  set("point", 174);
  set("material", "magic stone");
  set("wield_msg", "[1;34m只见$N双手一指，[1;31m辉日[1;32m之剑[1;34m冲天而起，旋转几圈后落在手中[2;37;0m\n");
  set("unwield_msg", "[1;34m$N默念咒语，[1;31m辉日[1;32m之剑[1;34m又回到鞘中[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
