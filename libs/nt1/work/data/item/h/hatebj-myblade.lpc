#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m烈阳刀[2;37;0m", ({ "myblade" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：王从阳(hatebj)
");
  set("value", 2100000);
  set("point", 841);
  set("material", "magic stone");
  set("wield_msg", "[1;31m空气突然变得炎热无比，一团红光从$N[1;31m手中发出，热度只烈竟然盖过了炎夏毒日。[2;37;0m\n");
  set("unwield_msg", "[1;32m红光一敛，空气回转清凉。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
