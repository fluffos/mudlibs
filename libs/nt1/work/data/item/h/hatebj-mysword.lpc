#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m绿影[2;37;0m", ({ "mysword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：王从阳(hatebj)
");
  set("value", 2100000);
  set("point", 257);
  set("material", "magic stone");
  set("wield_msg", "[1;32m$N将$n[1;32m自鞘中拔出，但见漫天青影，一时春意无限。[2;37;0m\n");
  set("unwield_msg", "[1;35m绿意一敛，$N悄然$n[1;35m收回鞘内。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
