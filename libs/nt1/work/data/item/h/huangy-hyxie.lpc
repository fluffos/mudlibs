#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m烂鞋[2;37;0m", ({ "hyxie" }));
  set_weight(1080);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[33m乌金丝[2;37;0m炼制而成的一双靴子。
靴子缘上刻着一行小字：大少(huangy)
");
  set("value", 1500000);
  set("point", 62);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;36m烂鞋[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;36m烂鞋[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
