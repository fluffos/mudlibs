#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m寿鞋[2;37;0m", ({ "xie" }));
  set_weight(300);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[37m缠魂丝[2;37;0m炼制而成的一双靴子。
[1;31m破破烂烂的一双鞋，上面有许多小洞。[2;37;0m
靴子缘上刻着一行小字：无头女尸(amay)
");
  set("value", 800000);
  set("point", 28);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备[1;31m寿鞋[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m寿鞋[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
