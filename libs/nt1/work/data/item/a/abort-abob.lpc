#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("草绳[2;37;0m", ({ "abob" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
腰带缘上刻着一行小字：制片(abort)
");
  set("value", 2100000);
  set("point", 121);
  set("material", "silk");
  set("wear_msg", "[33m$N[33m装备草绳[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了草绳[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
