#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m天蝉衣[2;37;0m", ({ "zhanyi" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
这是江湖中人称：超级杀手[1;37m傲剑长空，[1;31m的战衣。[2;37;0m
战衣缘上刻着一行小字：傲剑长空(ajxck)
");
  set("value", 2100000);
  set("point", 184);
  set("material", "silk");
  set("wear_msg", "[1;36m雪花飘起，狂风吹过，风云为之变色，天地黯然失色。[2;37;0m\n");
  set("remove_msg", "[1;35m天地渐渐宁静下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
