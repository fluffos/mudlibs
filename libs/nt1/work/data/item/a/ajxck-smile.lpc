#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m火神剑[2;37;0m", ({ "smile" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;31m这就是传说中的火焰剑之火神降临。[2;37;0m
剑柄上刻着一行小字：傲剑啸长空(ajxck)
");
  set("value", 2100000);
  set("point", 340);
  set("material", "magic stone");
  set("wield_msg", "[1;35m当一颗鲜红跳动的[1;31m龙心[1;35m嵌入火焰剑时传说中的[1;31m火神剑[1;35m终于出现了。[2;37;0m\n");
  set(
    "unwield_msg",
    "[1;33m突然间[1;31m火神剑[1;33m消失了，似乎世界清凉了许多，不再有炙热的[1;31m火焰[1;33m了。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
