#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m九曦混阳[2;37;0m", ({ "quan" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;31m长啸一声，双手搭上炉边，刹那间，炉火沸腾，一道白光，直冲霄汉。[2;37;0m
铁掌缘上刻着一行小字：无成无物(andi)
");
  set("value", 2100000);
  set("point", 219);
  set("material", "magic stone");
  set("wear_msg", "[1;31m一声长啸，灵台清明，凝神归元，使出太极剑中的「连字诀」。[2;37;0m\n");
  set("remove_msg", "[1;31m一声长啸，灵台清明，凝神归元，使出太极剑中的「连字诀」。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);

  setup();
}

string long() { return query("long") + item_long(); }
