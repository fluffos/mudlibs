#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m傲剑[2;37;0m", ({ "aojian" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;36m泥潭第一神兵。[1;36m是由[1;37m剑冢义族[1;36m浴血打拼而出的。[2;37;0m
剑柄上刻着一行小字：傲剑长空(ajxck)
");
  set("value", 2100000);
  set("point", 166);
  set("material", "magic stone");
  set("wield_msg", "[1;31m$N[1;36m抽出一把神兵，天地顿时黯然失色。[2;37;0m\n");
  set("unwield_msg", "[1;31m$N[1;36m收起神兵。天地顿时恢复宁静。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
