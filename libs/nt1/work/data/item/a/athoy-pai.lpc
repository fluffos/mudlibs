#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m风雨同舟长老令[2;37;0m", ({ "pai" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一双铁掌。
[1;35m风雨同舟的长老拿的令牌[2;37;0m
铁掌缘上刻着一行小字：神游(athoy)
");
  set("value", 2100000);
  set("point", 225);
  set("material", "magic stone");
  set("wear_msg", "[1;35m装备风雨同舟长老令[2;37;0m\n");
  set("remove_msg", "[1;35m脱下了风雨同舟长老令[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
