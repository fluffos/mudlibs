#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m菩提指[2;37;0m", ({ "finger" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
指环上斑斑血痕尤在，看来沾染了不少恶人的鲜血。[2;37;0m
指套缘上刻着一行小字：渡甫(acer)
");
  set("value", 2100000);
  set("point", 257);
  set("material", "magic stone");
  set("wear_msg", "[1;33m突然佛光大闪，$N双掌合十，指上赫然已经戴上$n[1;33m。[2;37;0m\n");
  set("remove_msg", "[1;33m佛光一敛，$N双掌一收，$n[1;33m悄然消逝无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/claw", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/finger", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
