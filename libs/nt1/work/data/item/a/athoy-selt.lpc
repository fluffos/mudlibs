#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m牵云带[2;37;0m", ({ "selt" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
[1;37m一根腰带[2;37;0m
腰带缘上刻着一行小字：神游(athoy)
");
  set("value", 2100000);
  set("point", 88);
  set("material", "silk");
  set("wear_msg", "[1;37m拴上牵云带[2;37;0m\n");
  set("remove_msg", "[1;37m天玄解下牵云带[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
