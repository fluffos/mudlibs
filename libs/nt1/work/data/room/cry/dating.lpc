#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "天龙门大厅");
  set("long", @LONG
这就是天龙门主人韩明远迎送客人的地方。正中有些桌椅，侧面
是两扇屏风。东首是主人韩明远的房间，有一扇木门虚掩着。南边是
大门，出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "韩明远");
  set("room_name", "天龙门");
  set("room_id", "tocry");
  set("room_owner_id", "cry");
  set("room_position", "三岔口");
}
