#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "左厢房");
  set("long", @LONG
这是天堂乌鸦的家的左厢房，是客人居住的地方。虽然不算奢华，
却也布置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大
结实，使屋内光线恰到好处。 
LONG);

  set("exits", ([
    "west": __DIR__ "zhongting",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);
  set("outdoors", "hangzhou");

  create_door("west", "木门", "east", DOOR_CLOSED);

  set("room_owner", "天堂乌鸦");
  set("room_name", "天堂乌鸦的家");
  set("room_id", "terras");
  set("room_owner_id", "terra");
  set("room_position", "山路");
}
