#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "左厢房");
  set("long", @LONG
这是风中的雪花的左厢房，是客人居住的地方。虽然不算奢华，
却也布置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大
结实，使屋内光线恰到好处。 
LONG);

  set("exits", ([
    "west": __DIR__ "zhongting",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);
  set("outdoors", "playertown");

  create_door("west", "木门", "east", DOOR_CLOSED);

  set("room_owner", "慕容伤");
  set("room_name", "风中的雪花");
  set("room_id", "piaodd");
  set("room_owner_id", "levatin");
  set("room_position", "碎石小道");
}
