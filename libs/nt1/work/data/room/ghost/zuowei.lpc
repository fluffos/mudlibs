inherit PRIVATE_ROOM;

void create() {
  object ob;

  set("short", "天空之城左卫舍");
  set("long", @LONG
这里是左卫舍，是看护天空之城大门的家丁放哨的地方。 
LONG);

  set("exits", ([
    "west": __DIR__ "qianting",
  ]));

  set("objects", ([
    "/d/room/roomnpc/shouwei": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  ob = present("shou wei", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  ob = present("shou wei 2", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  set("room_owner", "静香");
  set("room_name", "天空之城");
  set("room_id", "sky");
  set("room_owner_id", "ghost");
  set("room_position", "碎石小道");
}
