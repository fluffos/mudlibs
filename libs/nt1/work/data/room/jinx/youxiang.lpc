#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "右厢房");
  set("long", @LONG
这是金鳞阁的右厢房，是客人居住的地方。虽然不算奢华，却也
布置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大结实，
使屋内光线恰到好处。 
LONG);

  set("exits", ([
    "east": __DIR__ "zhongting",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);

  create_door("east", "木门", "west", DOOR_CLOSED);

  setup();

  set("room_owner", "蕴龙心境");
  set("room_name", "金鳞阁");
  set("room_id", "jinlin");
  set("room_owner_id", "jinx");
  set("room_position", "碎石小道");
}
