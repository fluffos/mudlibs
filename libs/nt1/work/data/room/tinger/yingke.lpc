#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "黎苑小筑迎客厅");
  set("long", @LONG
这里是黎苑小筑的主人婷儿迎接八方来客的地方。大凡客人来拜
见婷儿，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "婷儿");
  set("room_name", "黎苑小筑");
  set("room_id", "liyuan");
  set("room_owner_id", "tinger");
  set("room_position", "碎石小道");
}
