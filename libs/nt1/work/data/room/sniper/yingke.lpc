#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "大本营迎客厅");
  set("long", @LONG
这里是大本营的主人狙击手迎接八方来客的地方。大凡客人来拜
见狙击手，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶
室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "狙击手");
  set("room_name", "大本营");
  set("room_id", "sniper");
  set("room_owner_id", "sniper");
  set("room_position", "三岔口");
}
