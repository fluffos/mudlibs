  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "渡血");
  set("room_name", "血压计");
  set("room_id", "zhu");
  set("room_owner_id", "duxue");
  set("room_position", "碎石小道");
}
