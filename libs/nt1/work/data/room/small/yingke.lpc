#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "孤独迎客厅");
  set("long", @LONG
这里是孤独的主人小双迎接八方来客的地方。大凡客人来拜见小
双，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是
主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "小双");
  set("room_name", "孤独");
  set("room_id", "small");
  set("room_owner_id", "small");
  set("room_position", "青砖路");
}
