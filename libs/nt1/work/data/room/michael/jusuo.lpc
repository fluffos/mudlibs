#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是武陵春主人行香子休息、读书的地方。楼上就是主人的卧
室，西面则是书房。 
LONG);

  set("exits", ([
