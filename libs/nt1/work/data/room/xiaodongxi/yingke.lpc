#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "爱的小屋迎客厅");
  set("long", @LONG
这里是爱的小屋的主人小太保接待知己死党的场所。大凡好朋友
来约见，少不得在这里寒暄叙话，了尽相思之情。东面是一个茶室—
—〈茗香〉，是女主人眉眉陪同客人品尝天下名茶之处。[2;37;0m
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "眉眉");
  set("room_name", "爱的小屋");
  set("room_id", "loveer");
  set("room_owner_id", "xiaodongxi");
  set("room_position", "碎石小道");
}
