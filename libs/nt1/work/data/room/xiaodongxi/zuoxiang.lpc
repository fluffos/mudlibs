#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "左厢房");
	set ("long", @LONG
爱的小屋的客房。窗下,放置着古朴的龙凤紫檀木雕床,平铺着一
袭银色绣猫的雪被,没有一丝褶皱。旁边有一个精致的梳妆台,一面铜
镜正映着眉目清秀的你.....[2;37;0m
LONG );

	set("exits", ([
                "west" : __DIR__"zhongting",
	]));

        set("sleep_room", 1);
        set("no_fight", 1);
        set("outdoors", "playertown");

        create_door("west", "木门", "east", DOOR_CLOSED);

        set("room_owner", "眉眉");
        set("room_name", "爱的小屋");
        set("room_id", "loveer");
        set("room_owner_id", "xiaodongxi");
        set("room_position", "碎石小道");
}
