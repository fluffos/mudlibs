#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "左厢房");
	set ("long", @LONG
阴暗、令人压抑的一间洗手间。一排破烂的石制水槽躺在一张破
而脏的大镜子下。潮湿的地板映着微弱的烛光；小洗漱间的木质门已
经被刮花。一个普通的水槽，而在铜水龙头的一侧刻有一条极小的蛇。
咒语过后，顷刻间，水龙头便罩在一片灿烂的白光中，并开始旋转，
紧接着，水槽也开始移动了。事实上，水槽下沉，露出一条的管道，
宽得足够让一人滑入。[2;37;0m
LONG );

	set("exits", ([
                "west" : __DIR__"zhongting",
	]));

        set("sleep_room", 1);
        set("no_fight", 1);
        set("outdoors", "playertown");

        create_door("west", "木门", "east", DOOR_CLOSED);

        set("room_owner", "绛珠草");
        set("room_name", "霍格沃茨");
        set("room_id", "hgwc");
        set("room_owner_id", "xnx");
        set("room_position", "碎石小道");
}
