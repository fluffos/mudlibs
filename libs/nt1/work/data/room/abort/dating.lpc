inherit PRIVATE_ROOM;

void create() {
  set("short", "电影公司大厅");
  set("long", @LONG
这就是电影公司主人制片迎送客人的地方。正中有些桌椅，侧面
是两扇屏风。东首是主人制片的房间，有一扇木门虚掩着。南边是大
门，出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "制片");
  set("room_name", "电影公司");
  set("room_id", "abort");
  set("room_owner_id", "abort");
  set("room_position", "碎石小道");
