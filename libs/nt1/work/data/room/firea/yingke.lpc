#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "断肠崖迎客厅");
  set("long", @LONG
这里是断肠崖的主人段肠草迎接八方来客的地方。大凡客人来拜
见段肠草，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶
室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "段肠草");
  set("room_name", "断肠崖");
  set("room_id", "duanchang");
  set("room_owner_id", "firea");
  set("room_position", "三岔口");
}
