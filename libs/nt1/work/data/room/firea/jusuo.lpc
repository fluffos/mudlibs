  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "段肠草");
  set("room_name", "断肠崖");
  set("room_id", "duanchang");
  set("room_owner_id", "firea");
  set("room_position", "三岔口");
}
