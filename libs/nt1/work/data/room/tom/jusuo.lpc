#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是怪兽之家主人怪兽蜻蜓休息、读书的地方。楼上就是主人
的卧室，西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "怪兽蜻蜓");
  set("room_name", "怪兽之家");
  set("room_id", "tom");
  set("room_owner_id", "tom");
  set("room_position", "碎石小道");
}
