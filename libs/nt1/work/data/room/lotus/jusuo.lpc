#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是莲花主人青莲剑歌休息、读书的地方。楼上就是主人的卧
室，西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "青莲剑歌");
  set("room_name", "莲花");
  set("room_id", "lotus");
  set("room_owner_id", "lotus");
  set("room_position", "碎石小道");
}
