#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "垃圾转运站大厅");
	set ("long", @LONG
这就是垃圾转运站主人石破烂迎送客人的地方。正中有些桌椅，
侧面是两扇屏风。东首是主人石破烂的房间，有一扇木门虚掩着。南
边是大门，出去就是院子。 
LONG );

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "石破烂");
        set("room_name", "垃圾转运站");
        set("room_id", "spl");
        set("room_owner_id", "shi");
        set("room_position", "名人堂");
}
