inherit PRIVATE_ROOM;

void create() {
  object ob;

  set("short", "一间房子左卫舍");
  set("long", @LONG
这里是左卫舍，是看护一间房子大门的家丁放哨的地方。 
LONG);

  set("exits", ([
    "west": __DIR__ "qianting",
  ]));

  set("objects", ([
    "/d/room/roomnpc/shouwei": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  ob = present("shou wei", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  ob = present("shou wei 2", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  set("room_owner", "渡邪");
  set("room_name", "一间房子");
  set("room_id", "home");
  set("room_owner_id", "xuan");
  set("room_position", "名人堂");
}
