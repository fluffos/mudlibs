#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "一间房子迎客厅");
  set("long", @LONG
这里是一间房子的主人渡邪迎接八方来客的地方。大凡客人来拜
见渡邪，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "渡邪");
  set("room_name", "一间房子");
  set("room_id", "home");
  set("room_owner_id", "xuan");
  set("room_position", "名人堂");
}
