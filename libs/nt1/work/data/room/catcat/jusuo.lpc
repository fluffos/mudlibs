#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是小段的家主人段吟雪休息、读书的地方。楼上就是主人的
卧室，西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "段吟雪");
  set("room_name", "小段的家");
  set("room_id", "catcathome");
  set("room_owner_id", "catcat");
  set("room_position", "碎石小道");
}
