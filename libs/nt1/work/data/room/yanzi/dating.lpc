#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "姿迷部落大厅");
  set("long", @LONG
这就是姿迷部落主人孙燕姿迎送客人的地方。正中有些桌椅，侧
面是两扇屏风。东首是主人孙燕姿的房间，有一扇木门虚掩着。南边
是大门，出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "孙燕姿");
  set("room_name", "姿迷部落");
  set("room_id", "Yanzi");
  set("room_owner_id", "yanzi");
  set("room_position", "碎石小道");
}
