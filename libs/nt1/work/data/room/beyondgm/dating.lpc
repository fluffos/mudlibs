#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "星耀大厅");
	set ("long", @LONG
这就是星耀主人惊鸿一瞥迎送客人的地方。正中有些桌椅，侧面
是两扇屏风。东首是主人惊鸿一瞥的房间，有一扇木门虚掩着。南边
是大门，出去就是院子。 
LONG );

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "惊鸿一瞥");
        set("room_name", "星耀");
        set("room_id", "star");
        set("room_owner_id", "beyondgm");
        set("room_position", "名人堂");
}
