inherit PRIVATE_ROOM;

void create() {
  object ob;

  set("short", "一号房右卫舍");
  set("long", @LONG
这里是右卫舍，是看护一号房大门的家丁放哨的地方。 
LONG);

  set("exits", ([
    "east": __DIR__ "qianting",
  ]));

  set("objects", ([
    "/d/room/roomnpc/shouwei": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  ob = present("shou wei", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
  }));

  ob = present("shou wei 2", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
  }));

  set("room_owner", "徐婕儿");
  set("room_name", "一号房");
  set("room_id", "one");
  set("room_owner_id", "jill");
  set("room_position", "青砖路");
}
