#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "药府迎客厅");
  set("long", @LONG
这里是药府的主人药剑迎接八方来客的地方。大凡客人来拜见药
剑，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是
主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "药剑");
  set("room_name", "药府");
  set("room_id", "iaofu");
  set("room_owner_id", "iaojian");
  set("room_position", "碎石小道");
}
