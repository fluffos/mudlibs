#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "天地花园迎客厅");
	set ("long", @LONG
这里是天地花园的主人血影迎接八方来客的地方。大凡客人来拜
见血影，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG );

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "血影");
        set("room_name", "天地花园");
        set("room_id", "wozuiqiang");
        set("room_owner_id", "wozuiqiang");
        set("room_position", "碎石小道");
}
