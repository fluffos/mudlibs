#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "看看之家迎客厅");
  set("long", @LONG
这里是看看之家的主人逍遥一剑迎接八方来客的地方。大凡客人
来拜见逍遥一剑，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "逍遥一剑");
  set("room_name", "看看之家");
  set("room_id", "kkroom");
  set("room_owner_id", "klivers");
  set("room_position", "南大街");
}
