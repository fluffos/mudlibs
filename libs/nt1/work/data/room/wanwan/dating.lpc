#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "阴癸魔宫大厅");
	set ("long", @LONG
这就是阴癸魔宫主人绾绾迎送客人的地方。正中有些桌椅，侧面
是两扇屏风。东首是主人绾绾的房间，有一扇木门虚掩着。南边是大
门，出去就是院子。 
LONG );

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "绾绾");
        set("room_name", "阴癸魔宫");
        set("room_id", "wanwan");
        set("room_owner_id", "wanwan");
        set("room_position", "碎石小道");
}
