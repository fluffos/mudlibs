#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "似水年华迎客厅");
  set("long", @LONG
这里是似水年华的主人明柳迎接八方来客的地方。大凡客人来拜
见明柳，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "明柳");
  set("room_name", "似水年华");
  set("room_id", "times");
  set("room_owner_id", "tan");
  set("room_position", "山洪瀑布");
}
