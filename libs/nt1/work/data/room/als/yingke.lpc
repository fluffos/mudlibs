#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "海德酒店迎客厅");
  set("long", @LONG
这里是海德酒店的主人灌汤包子迎接八方来客的地方。大凡客人
来拜见灌汤包子，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "灌汤包子");
  set("room_name", "海德酒店");
  set("room_id", "hotl");
  set("room_owner_id", "als");
  set("room_position", "名人堂");
}
