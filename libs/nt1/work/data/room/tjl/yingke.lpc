#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "日本桑拿房迎客厅");
  set("long", @LONG
这里是日本桑拿房的主人羽柴秀吉迎接八方来客的地方。大凡客
人来拜见羽柴秀吉，少不得在这里寒暄叙话，了尽仰慕之情。东面通
往一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "羽柴秀吉");
  set("room_name", "日本桑拿房");
  set("room_id", "tjl");
  set("room_owner_id", "tjl");
  set("room_position", "碎石小道");
}
