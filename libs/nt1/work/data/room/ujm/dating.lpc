#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "宋阀大院大厅");
  set("long", @LONG
这就是宋阀大院主人宋玉致迎送客人的地方。正中有些桌椅，侧
面是两扇屏风。东首是主人宋玉致的房间，有一扇木门虚掩着。南边
是大门，出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "宋玉致");
  set("room_name", "宋阀大院");
  set("room_id", "ujm");
  set("room_owner_id", "ujm");
  set("room_position", "碎石小道");
}
