inherit PRIVATE_ROOM;

void create() {
  set("short", "么牢牢工作室迎客厅");
  set("long", @LONG
这里是么牢牢工作室的主人么牢牢迎接八方来客的地方。大凡客
人来拜见么牢牢，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
