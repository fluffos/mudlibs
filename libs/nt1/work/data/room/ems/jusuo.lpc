#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是么牢牢工作室主人么牢牢休息、读书的地方。楼上就是主
人的卧室，西面则是书房。 
LONG);

