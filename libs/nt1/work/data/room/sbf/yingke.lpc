inherit PRIVATE_ROOM;

void create() {
  set("short", "实验室迎客厅");
  set("long", @LONG
这里是实验室的主人龙八迎接八方来客的地方。大凡客人来拜见
龙八，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
