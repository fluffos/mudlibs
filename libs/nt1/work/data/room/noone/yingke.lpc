#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "神话传说迎客厅");
  set("long", @LONG
这里是神话传说的主人决不拜师迎接八方来客的地方。大凡客人
来拜见决不拜师，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "决不拜师");
  set("room_name", "神话传说");
  set("room_id", "legend");
  set("room_owner_id", "noone");
  set("room_position", "山洪瀑布");
}
