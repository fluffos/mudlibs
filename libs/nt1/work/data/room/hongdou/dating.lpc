#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "残爱居大厅");
  set("long", @LONG
大厅迎面有一张檀木八仙桌,两边有次序的摆放着两排龙椅,四壁
悬挂着猫儿亲手绘制的镇兽图。厅堂中挂着两个条幅“曾经沧海难为
水”“除却巫山不是云”。[2;37;0m
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "红豆");
  set("room_name", "残爱居");
  set("room_id", "xiaohan");
  set("room_owner_id", "hongdou");
  set("room_position", "寒水潭");
}
