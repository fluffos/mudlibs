#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "禁入魔界迎客厅");
  set("long", @LONG
这里是禁入魔界的主人堕落天使迎接八方来客的地方。大凡客人
来拜见堕落天使，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "堕落天使");
  set("room_name", "禁入魔界");
  set("room_id", "devil");
  set("room_owner_id", "depravity");
  set("room_position", "树林");
}
