#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是禁入魔界主人堕落天使休息、读书的地方。楼上就是主人
的卧室，西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "堕落天使");
  set("room_name", "禁入魔界");
  set("room_id", "devil");
  set("room_owner_id", "depravity");
  set("room_position", "树林");
}
