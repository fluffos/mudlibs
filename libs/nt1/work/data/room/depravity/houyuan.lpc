     inherit PRIVATE_ROOM;

void create()
{
	set("short", "后院");
	set ("long", @LONG
这是禁入魔界的后院，正中一个假山，傲然而立、非常雄伟。下
有一水池，环山而走，悠然不息。东面乃是练武之处，西面是厨房。
LONG );

	set("exits", ([
                "south" : __DIR__"zhongting",
                "north" : __DIR__"huayuan",
                "east"  : __DIR__"lianwu",
                "west"  : __DIR__"chufang",
	]));

        set("outdoors", "yangzhou");
        set("no_sleep_room", 1);
        setup();

        set("room_owner", "堕落天使");
        set("room_name", "禁入魔界");
        set("room_id", "devil");
        set("room_owner_id", "depravity");
        set("room_position", "树林");
}
