#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "蚂蚁二号迎客厅");
  set("long", @LONG
这里是蚂蚁二号的主人训练专家迎接八方来客的地方。大凡客人
来拜见训练专家，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "训练专家");
  set("room_name", "蚂蚁二号");
  set("room_id", "antstwo");
  set("room_owner_id", "satyrdm");
  set("room_position", "碎石小道");
}
