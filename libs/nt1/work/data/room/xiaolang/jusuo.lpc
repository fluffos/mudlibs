  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "永远寂寞");
  set("room_name", "彩虹居");
  set("room_id", "caihong");
  set("room_owner_id", "xiaolang");
  set("room_position", "碎石小道");
}
