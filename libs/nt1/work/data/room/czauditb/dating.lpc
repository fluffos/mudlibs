#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "少林室大厅");
  set("long", @LONG
这就是少林室主人渡性迎送客人的地方。正中有些桌椅，侧面是
两扇屏风。东首是主人渡性的房间，有一扇木门虚掩着。南边是大门，
出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "渡性");
  set("room_name", "少林室");
  set("room_id", "shaol");
  set("room_owner_id", "czauditb");
  set("room_position", "三岔口");
}
