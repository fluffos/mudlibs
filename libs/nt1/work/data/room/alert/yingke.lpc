#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "猪猪山中别墅迎客厅");
  set("long", @LONG
这里是猪猪山中别墅的主人朱云迎接八方来客的地方。大凡客人
来拜见朱云，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个
茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "朱云");
  set("room_name", "猪猪山中别墅");
  set("room_id", "piggm");
  set("room_owner_id", "alert");
  set("room_position", "山路");
}
