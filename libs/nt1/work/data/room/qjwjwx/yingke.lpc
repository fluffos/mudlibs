inherit PRIVATE_ROOM;

void create() {
  set("short", "不是哈批迎客厅");
  set("long", @LONG
这里是不是哈批的主人流光飞逝迎接八方来客的地方。大凡客人
来拜见流光飞逝，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
