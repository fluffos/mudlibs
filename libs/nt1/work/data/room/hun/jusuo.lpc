#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是鬼岛主人鬼魂休息、读书的地方。楼上就是主人的卧室，
西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "鬼魂");
  set("room_name", "鬼岛");
  set("room_id", "dao");
  set("room_owner_id", "hun");
  set("room_position", "三岔口");
}
