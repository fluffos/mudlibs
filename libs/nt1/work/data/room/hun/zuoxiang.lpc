#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "左厢房");
  set("long", @LONG
这是鬼岛的左厢房，是客人居住的地方。虽然不算奢华，却也布
置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大结实，
使屋内光线恰到好处。 
LONG);

  set("exits", ([
    "west": __DIR__ "zhongting",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);
  set("outdoors", "playertown");

  create_door("west", "木门", "east", DOOR_CLOSED);

  set("room_owner", "鬼魂");
  set("room_name", "鬼岛");
  set("room_id", "dao");
  set("room_owner_id", "hun");
  set("room_position", "三岔口");
}
