  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "骑士");
  set("room_name", "骑士");
  set("room_id", "qishi");
  set("room_owner_id", "qishi");
  set("room_position", "碎石小道");
}
