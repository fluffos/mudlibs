inherit PRIVATE_ROOM;

void create() {
  set("short", "竹林");
  set("long", @LONG
这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时给我新鲜就去听涛阁默听竹浪涛声，参悟武功。 
LONG);

  set("exits", ([
    "west": __DIR__ "huayuan",
    "east": __DIR__ "tingtao",
  ]));

  set("outdoors", "playertown");
  set("sleep_room", 1);
  setup();

  set("room_owner", "给我新鲜");
  set("room_name", "风丹雅阁");
  set("room_id", "ansionyd");
  set("room_owner_id", "whz");
  set("room_position", "碎石小道");
}
