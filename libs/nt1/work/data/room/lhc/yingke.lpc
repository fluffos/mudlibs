inherit PRIVATE_ROOM;

void create() {
  set("short", "大钱库迎客厅");
  set("long", @LONG
这里是大钱库的主人灵狐宠迎接八方来客的地方。大凡客人来拜
见灵狐宠，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶
室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
