#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "翎卿居大厅");
	set ("long", @LONG
[1;36m你走进了一间舒适的木屋，这就是翎卿居主人慕容翎迎送客
    人的地方。仔细的观察屋里的环境，摆设著几张椅子和简单
    的家饰，墙边的火炉里还有木材在燃烧著，让这里的感觉温
    暖不少，透过窗户向屋后望去，可以看到一片种满奇异花朵
    的后院，让人把路上的疲惫忘的一乾二净。[2;37;0m
LONG );

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "慕容翎");
        set("room_name", "翎卿居");
        set("room_id", "ling");
        set("room_owner_id", "lingling");
        set("room_position", "山路");
}
