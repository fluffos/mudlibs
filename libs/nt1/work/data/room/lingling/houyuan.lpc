inherit PRIVATE_ROOM;

void create() {
  set("short", "翎卿居后院");
  set("long", @LONG
[1;36m你走出了木屋来到后院，一阵花香突然扑鼻而来，眼前尽是
    不曾见过的奇花异果，各种颜色都有，五彩缤纷。火红的妖
    蝶在花丛间穿梭，更添了几分美感，这时不禁让人疑惑，这
    片美丽的花园到底是谁栽种的？[2;37;0m
LONG);

  setup();

  set("exits", ([
    "south": __DIR__ "dating",
  ]));

  set("outdoors", "hangzhou");
  set("sleep_room", 1);

  set("room_owner", "慕容翎");
  set("room_name", "翎卿居");
  set("room_id", "ling");
  set("room_owner_id", "lingling");
  set("room_position", "山路");
}

void init() {
  add_action("do_sit", "sit");
  this_player()->delete_temp("has_sit");
}

int do_sit(string arg) {
  object me;

  me = this_player();
  if (me->query_temp("has_sit")) {
    message_vision("$N坐在那里摇啊摇，好不惬意。\n", me);
    return 1;
  }

  message_vision("$N找了的地方作了下来，看上去轻松多了。\n", me);
  me->set_temp("has_sit", 1);
  return 1;
}

int valid_leave(object me, string dir) {
  if (me->query_temp("has_sit")) {
    message_vision("$N掸掸尘土，站了起来。\n", me);
    me->delete_temp("has_sit");
  }

  return ::valid_leave(me, dir);
}
