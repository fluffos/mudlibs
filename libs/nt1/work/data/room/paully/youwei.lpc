inherit PRIVATE_ROOM;

void create() {
  object ob;

  set("short", "双府右卫舍");
  set("long", @LONG
这里是右卫舍，是看护双府大门的家丁放哨的地方。 
LONG);

  set("exits", ([
    "east": __DIR__ "qianting",
  ]));

  set("objects", ([
    "/d/room/roomnpc/shouwei": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  ob = present("shou wei", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
  }));

  ob = present("shou wei 2", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
  }));

  set("room_owner", "双剑");
  set("room_name", "双府");
  set("room_id", "shurangfu");
  set("room_owner_id", "paully");
  set("room_position", "碎石小道");
}
