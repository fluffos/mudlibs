#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", @LONG
这就是神影之穴主人影子无敌休息、读书的地方。楼上就是主人
的卧室，西面则是书房。 
LONG);

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "影子无敌");
  set("room_name", "神影之穴");
  set("room_id", "lightroom");
  set("room_owner_id", "shadow");
  set("room_position", "青砖路");
}
