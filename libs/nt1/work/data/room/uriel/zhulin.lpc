     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set ("long", @LONG
这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时乌里叶就去听涛阁默听竹浪涛声，参悟武功。 
LONG );

	set("exits", ([
