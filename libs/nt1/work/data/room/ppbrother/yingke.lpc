inherit PRIVATE_ROOM;

void create() {
  set("short", "倚王府迎客厅");
  set("long", @LONG
这里是倚王府的主人倚碧鸳迎接八方来客的地方。大凡客人来拜
见倚碧鸳，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶
室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
