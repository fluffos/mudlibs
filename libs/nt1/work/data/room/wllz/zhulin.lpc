inherit PRIVATE_ROOM;

void create() {
  set("short", "竹林");
  set("long", @LONG
这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时武林列传就去听涛阁默听竹浪涛声，参悟武功。 
LONG);

  set("exits", ([
    "west": __DIR__ "huayuan",
    "east": __DIR__ "tingtao",
  ]));

  set("outdoors", "unknow");
  set("sleep_room", 1);
  setup();

  set("room_owner", "武林列传");
  set("room_name", "豪华套房");
  set("room_id", "wllz");
  set("room_owner_id", "wllz");
  set("room_position", "名人堂");
}
