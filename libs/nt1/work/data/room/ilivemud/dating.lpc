#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "醉翁庭大厅");
	set ("long", @LONG
这儿是爱马德和艾马德接待客人的地方，正中摆着檀香木做的桌
椅，侧面是屏风，厅堂中挂着两个条幅。上面写着张飞的题字：“小
憩醉翁欲吟诗，宝剑还鞘侃对联”。东面是主人的卧室。[2;37;0m
LONG );

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "艾马德");
        set("room_name", "醉翁庭");
        set("room_id", "zwt");
        set("room_owner_id", "ilivemud");
        set("room_position", "碎石小道");
}
