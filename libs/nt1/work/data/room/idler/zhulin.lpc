     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set ("long", @LONG
这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时元神出窍就去听涛阁默听竹浪涛声，参悟武功。 
LONG );

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "hangzhou");
        set("sleep_room", 1);
        setup();

        set("room_owner", "元神出窍");
        set("room_name", "太虚居");
        set("room_id", "taixuju");
        set("room_owner_id", "idler");
        set("room_position", "山路");
}
