  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "皇太极");
  set("room_name", "皇龙宫");
  set("room_id", "hlg");
  set("room_owner_id", "htj");
  set("room_position", "碎石小道");
}
