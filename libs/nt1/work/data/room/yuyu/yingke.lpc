#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "辟邪屋迎客厅");
	set ("long", @LONG
这里是辟邪屋的主人郁郁迎接八方来客的地方。大凡客人来拜见
郁郁，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG );

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "郁郁");
        set("room_name", "辟邪屋");
        set("room_id", "yuyu");
        set("room_owner_id", "yuyu");
        set("room_position", "碎石小道");
}
