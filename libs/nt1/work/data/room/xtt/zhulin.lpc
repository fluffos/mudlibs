inherit PRIVATE_ROOM;

void create() {
  set("short", "竹林");
  set("long", @LONG
这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时小谭谭就去听涛阁默听竹浪涛声，参悟武功。 
LONG);

  set("exits", ([
    "west": __DIR__ "huayuan",
    "east": __DIR__ "tingtao",
  ]));

  set("outdoors", "yangzhou");
  set("sleep_room", 1);
  setup();

  set("room_owner", "小谭谭");
  set("room_name", "谭谭居");
  set("room_id", "xtt");
  set("room_owner_id", "xtt");
  set("room_position", "树林");
}
