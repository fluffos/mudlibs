#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "无底洞迎客厅");
  set("long", @LONG
这里是无底洞的主人炎影迎接八方来客的地方。大凡客人来拜见
炎影，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "炎影");
  set("room_name", "无底洞");
  set("room_id", "dong");
  set("room_owner_id", "sinewind");
  set("room_position", "三岔口");
}
