  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "金聊聊");
  set("room_name", "聊聊居");
  set("room_id", "chucknn");
  set("room_owner_id", "chucknn");
  set("room_position", "树林");
}
