#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "傲剑山庄大厅");
  set("long", @LONG
这就是傲剑山庄主人无天傲剑迎送客人的地方。正中有些桌椅，
侧面是两扇屏风。东首是主人无天傲剑的房间，有一扇木门虚掩着。
南边是大门，出去就是院子。 
LONG);

  setup();

  set("exits", ([
    "east": __DIR__ "woshi",
    "north": __DIR__ "houyuan",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("no_sleep_room", 1);

  set("KEY_DOOR", ([
    "exit": "south",
    "room": __DIR__ "xiaoyuan",
  ]));

  set("room_owner", "无天傲剑");
  set("room_name", "傲剑山庄");
  set("room_id", "swordsky");
  set("room_owner_id", "swordsky");
  set("room_position", "青砖路");
}
