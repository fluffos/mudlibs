  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "灵雪");
  set("room_name", "精灵水境");
  set("room_id", "spirit");
  set("room_owner_id", "lingxue");
  set("room_position", "碎石小道");
}
