#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "断情居迎客厅");
  set("long", @LONG
这里是断情居的主人段不了迎接八方来客的地方。大凡客人来拜
见段不了，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶
室，是主人陪同客人品尝天下名茶之处。 
LONG);

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
