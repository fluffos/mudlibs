dbase (["notes":({(["title":"任逍遥","owner":"cmlxy","msg":"海阔凭鱼跃，天高任鸟飞。海大了，什么鱼都有。林子大了什么鸟都有。海也好，鱼也好，鸟也好，林也好。你醉也好，睡也好，方寸之地，尽可逍遥。[1;33m论坛：bbs.lonely.com.cn站点：www.lonely.com.cn[2;37;0m[2;37;0m","author":"李逍遥","time":1095962664,]),}),"board_id":"chatroom_cmlxy","id":"board","name":"李逍遥的留言板","long":"大家都来灌灌水，一起说废话。","banzhu":"cmlxy","no_get":1,"location":0,"capacity":437,])
