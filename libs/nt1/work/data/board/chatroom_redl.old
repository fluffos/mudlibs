<script>
str="<table oncontextmenu='return setEnd(event.srcElement)' "+
"onclick='show(event.srcElement)' "+
"style='width:408;height:400;border:1px solid RED;"+
"border-collapse:collapse' cellpadding=0>"

for(var i=0;i<8;i++)
{
	str+="<tr>"
	for(var j=0;j<8;j++) str+="<td v="+(i*8+j)+">&nbsp;</td>"
	str+="</tr>"
}
str+="</table>"
str="<table style='width:100%;HEIGHT:1'><tr><td HEIGHT=50%>"+
"<TEXTAREA readonly id=t1></TEXTAREA></TD>"+
"<td rowspan=2 STYLE='WIDTH:1;HEIGHT:1'>"+str+"</td></TR>"+
"<TR><TD><TEXTAREA id=t2 readonly></TEXTAREA></TD></TR>"+
"<tr height=1><td colspan=2><nobr>左键点击的第一个格（黑色）"+
"表示起点，在某一格点击右键表示终点（绿色）。</nobr></td></tr></TABLE>"
document.write(str)
var o1,m1,s1=[],oe
var o2=[]
var v={"8":["s","↓",'b'],"-8":["n","↑",'g'],
	"1":["e","→",'e'],"-1":["w","←",'d']
    }

function show(o)
{
	if(event.button!=0||o.tagName!="TD") {return false}
	
	if(o1==null) {
		o1=o
		if(oe==o) oe=null
		o1.className="f4"
		o2=[o]
		m1=o1.v
		return
	}
	if(oe==null) {alert("请先设置终点！");return}
	var f=function(_o,_s) {
		var cn=_o.className
		if(cn!="f4"&&cn!="f5") _o.className=_s
	}
	var x=parseInt(o.v)-parseInt(o1.v)
	if(x==0) {		
		o.innerText=""
		if(s1.length!=0) {			
			s1=s1.slice(0,s1.length-1)
			o2=o2.slice(0,o2.length-1)				
			o1=o2[o2.length-1]
			o1.innerText=""
			f(o1,"f2")
		}	
		else {o1.innerText="";o1=null;m1=null;s1=[];o2=[]}
		if(o.className!="f5") o.className=null
	} else {		
		if(v[x]==null) {
                       alert("您只能走“E”“W”“N”“W”四个方向！");
                       return
                }		
		if(o.className=="f1") {alert("您不能越格取消！");return}
		o1.innerText=v[x][1]
		var cn=o1.className
		f(o1,"f1")
		s1[s1.length]=v[x][0]
		o2[o2.length]=o
		o1=o		
		var cn=o1.className
		f(o1,"f2")
		if(o1==oe) {
			if(s1.length!=63) alert("失败！")
			else alert("恭喜你成功！")
		}
	}
	t1.value=s1.join("")
	t2.value=s1.join(";")
	return false
}
function setEnd(o)
{
	var _s=o.className
	if(o.tagName!="TD"||_s=="f1"||_s=="f4"||_s=="f5"||_s=="f2") 
                return
	if(oe!=null) oe.className=null
	oe=o
	oe.className="f5"
}
function document.oncontextmenu()
{
	if(event.srcElement.tagName=="TD") return false
	if(o1!=null) o1.click()
	return false
}
</script>
