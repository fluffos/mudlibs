LANV_D->clan_prestige();                clan_12hr = time/period;                CHANNEL_D->do_channel( this_object(), \"wiz\", \"\\n优秀帮派程序已经启动。\\n\");        }        call_out( \"clan\", 60 );}[1;33m论坛：bbs.lonely.com.cn站点：www.lonely.com.cn[2;37;0m[2;37;0m","owner":"baqukq","author":"创造晴天","title":"1",]),(["time":1098335095,"msg":"// by msr#include <ansi.h>#include <obj.h>int auto_reboot();int topexp();int topmoney();int bankmoney();int autosav();int auto_html();int top_hun_eat_wait_die();void create(){        int t;        t = 3600 - (time()%3600);        seteuid(getuid());        call_out(\"runtime\",t);        call_out(\"autosav\",900);        call_out(\"auto_reboot\", 900);        call_out(\"auto_html\", 120);}[1;33m论坛：bbs.lonely.com.cn站点：www.lonely.com.cn[2;37;0m[2;37;0m","owner":"msr","author":"苗翠花","title":"hmm",]),(["time":1098337374,"msg":"void clan()     //帮派的时间判断{        int period, time, now = uptime();        period = 1800;        //per 30 min        time = now+period/2;        if(uptime()%period == 0) {                CLANV_D->clan_log();                clan_30min = time/period;                CHANNEL_D->do_channel( this_object(), \"wiz\", \"\\n帮派存款记录程序已经启动。\\n\");        }        period = 3600;        //per 1 hour        time = now+period/2;        if(uptime()%period == 0) {                CLANV_D->clan_tax();                clan_1hr = time/period;                CHANNEL_D->do_channel( this_object(), \"wiz\", \"\\n帮派税收程序已经启动。\\n\");        }        period = 7200;        //per 2 hour        time = now+period/2;        if(uptime()%period == 0) {                CLANV_D->clan_cost();                CLANV_D->clan_develop();                clan_2hr = time/period;                CHANNEL_D->do_channel( this_object(), \"wiz\", \"\\n帮派开销和声望计算程序已经启动。\\n\");        }        period = 43200;        //per 12 hour        time = now+period/2;        if(uptime()%period == 0) {                CLANV