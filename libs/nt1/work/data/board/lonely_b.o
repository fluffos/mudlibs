int ap, dp, cp, fp, ep, pp;        if (! target) target = offensive_target(me);        if (! target || ! me->is_fighting(target))                return notify_fail(SHA \"只能在战斗中对对手使用。\\n\");        if (! objectp(weapon = me->query_temp(\"weapon\")) ||            (string)weapon->query(\"skill_type\") != \"sword\")                return notify_fail(\"你使用的武器不对！\\n\");     　　if ((int)me->query_skill(\"mingyu-gong\", 1) < 300)                return notify_fail(\"你明玉功修为不够，无法施展\" SHA \"。\\n\");        if ((int)me->query_skill(\"sword\", 1) < 300)                return notify_fail(\"你剑法修为不够，无法施展\" SHA \"。\\n\");        if ((int)me->query(\"neili\") < 500)                return notify_fail(\"你现在真气不够，无法施展\" SHA \"！\\n\");        if (me->query_skill_mapped(\"sword\") != \"mingyu-gong\")                return notify_fail(\"你没有将明玉功运用于剑法，无法使用\" SHA \"。\\n\");        if (! living(target))               return notify_fail(\"对方都已经这样了，用不着这么费力吧？\\n\");        me->add(\"neili\", -300);        ap = ap_power(me, \"sword\");        ap = ap_power(me, \"martial-cognize\");        dp = dp_power(target, \"dodge\");        fp = dp_power(target, \"force\");        pp = dp_power(target, \"parry\");        ep = dp_power(target, \" martial-cognize\");         message_sort(HIW \"\\n$N\" HIW \"娇喝一声，手中\" + weapon->name() + HIW \"随即不停舞动，如巨浪般卷\"                        \"出，正是明玉功绝技「\" HIM \"冰河倒挂\" HIW \"」，突然\" + weapon->name() + HIW                         \"幻出的冰河激射出四路袭向$n，势不可挡．\\n\" NOR, me, target);                msg = HIM \"$N\" HIM \"将内力全灌入剑身，呼的一剑，当头直劈。\\n\" NOR;        if (ap / 2 + random(ap) < fp)                msg += CYN \"$n\" CYN \"凭借自身高强的内功，硬是荡开此招。\\n\" NOR;        else        {                damage = da_power(me, \"sword\");                msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60 + random(10),                                           HIR \"$n\" HIR \"不知此招之强，招架之下竟被$N\"                                           HIR \"这一剑震得口吐鲜血，连连倒退。\\n\" NOR);        }        msg += HIM \"\\n$N\" HIM \"圈转\" + weapon->name() + HIM \"，剑势灵动，招招直指要害，剑光如网，铺天盖地。\\n\" NOR;        if (ap / 2 + random(ap) < dp)                msg += CYN \"$n\" CYN \"的身法却比剑势还快，从容的闪过剑招。\\n\" NOR;        else        {                damage = da_power(me, \"sword\");                msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60 + random(10),                                           HIR \"此招来势当真快极，$n\" HIR \"哪里来得及闪\"                                           \"避招架？只见$N\" HIR \"剑光闪过，$n\"                                           HIR \"混身霎时鲜血淋漓！\\n\" NOR);        }        msg += HIM \"\\n$N\" HIM \"反手一剑，疾刺$p\" HIM \"后心，剑法之快，部位之准，令人防不胜防。\\n\" NOR;        if (ap / 2 + random(ap) < pp)                msg += CYN \"$n\" CYN \"身在空中，不及变招，只能挥出一招，正击中$N\"                       CYN \"剑上，略一借力，飘然避去。\\n\" NOR;        else        {                damage = da_power(me, \"sword\");                msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70 + random(20),                                           HIR \"$n\" HIR \"身在空中，哪里来得及变招？只见$N\"                                           HIR \"此剑掠过，$n\" HIR \"大声惨呼，鲜血四下飞溅！\\n\" NOR);        }msg += HIM \"\\n$N\" HIM \"谷催十成功力，分身化影，犹如数个$N一起分袭击$n。\\n\" NOR;        if (cp * 20 / 30 + random(cp) < ep)                msg += CYN \"$n\" CYN \"不愧武学精湛，立分虚实，$N\"                       CYN \"全力攻向$N。\\n\" NOR;        else        {                damage = da_power(me, \"sword\");                msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 80 + random(10),                                           HIR \"$n\" HIR \"慌乱出招，却都只击到残影，\"                                           HIR \"身上也同时多处中招．\\n\" NOR);        }        me->start_busy(2);        message_combatd(msg, me, target);        return 1;}[1;33m论坛：bbs.lonely.com.cn站点：www.lonely.com.cn[2;37;0m[2;37;0m","owner":"gold","author":"摇头丸","re":({(["time":1096763637,"msg":"#define SHA\"「\