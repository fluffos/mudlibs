09                     break; 310      311             case \"technic\": 312                     if (intp(mlvl = skills[\"technic-cognize\"]) && 313                         skill != \"technic-cognize\") 314                             // culture-cognize does extra bonus for culture skills 315                             amount += amount * (mlvl/5) / 100; 316                     break; 317             } 我把原来的 amount += amount * mlvl / 500 改成现在这样了.因为有玩家skills变成负数了. 如果没问题就把 /feature/skills.bak 删了吧.[1;33m论坛：bbs.chinesemud.org站点：www.chinesemud.org[2;37;0m[2;37;0m","title":"to lonely",]),(["time":1080447806,"author":"择明","owner":"ken","msg":"浦饭幽助说道：应该是没问题了[1;33m论坛：bbs.chinesemud.org站点：www.chinesemud.org[2;37;0m[2;37;0m","title":"89",]),(["re":({(["time":1080470507,"author":"蕴龙心境","owner":"jinx","msg":"绝对赞成绝对赞成绝对赞成绝对赞成───────────────[1;33m金鳞[1;36m岂是[1;37m池[2;37;0m[1;31m中物[2;37;0m  [1;34m一遇[1;36m风云[1;37m便化[2;37;0m[1;33m龙[2;37;0m[2;37;0m[2;37;0m","title":"Re: to all",]),(["time":1080481572,"author":"执着","owner":"lovet","msg":"赞成支持支持偶今天也想是这样没想到lonely 比偶早kick[1;33m论坛：bbs.chinesemud.org站点：www.chinesemud.org[2;37;0m[2;37;0m","title":"Re: to all",]),}),"time":1080481630,"author":"高处不胜寒","owner":"lonely","msg":"宗师任务奖励的丹转世的玩家吃没有作用。───────────────[1;36m曾经[1;33m醉酒[1;31m杀[2;37;0m[1;35m名马[2;37;0m  [1;36m惟恐[1;33m多情[1;31m误[2;37;0m[1;35m美人[2;37;0m[2;37;0m[2;37;0m","title":"to all",]),(["re":({(["time":1081130579,"author":"蕴龙心境","owner":"jinx","msg":"发现玩家还是通过断线quit and login希望哪位wiz有时间弄一下bow all───────────────[1;33m金鳞[1;36m岂是[1;37m池[2;37;0m[1;31m中物[2;37;0m  [1;34m一遇[1;36m风云[1;37m便化[2;37;0m[1;33m龙[2;37;0m[2;37;0m[2;37;0m","title":"Re: to all wiz",]),}),"time":1081130607,"author":"蕴龙心境","owner":"jinx","msg":"近来发现有大批量玩家吃散时却通过quit and login解除心跳今天在线的时候MUD几次停顿，差点造成崩溃现暂时修改了logind.c，把系统的登陆退出时间改为2分钟另外希望哪位wiz有时间把san和dan修改成退出也无法解除心跳这样就无后顾之忧了addoil all───────────────[1;33m金鳞[1;36m岂是[1;37m池[2;3