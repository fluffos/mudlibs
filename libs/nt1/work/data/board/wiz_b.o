title":"to jinx",]),(["re":({(["time":1079846638,"author":"择明","owner":"ken","msg":"NPC// $Id: npc_docter.txt,v 1.3 2003/08/19 00:44:42 mra Exp $// Total 1 NPC's in this file// By MivaBe on June 16th 2003//EDITED BY KOOK SWU 09/10/2003// Healer NPC by using the new introduced full_heal; commandprontera.gat,140,196,2  script  GH's Doctor     121,{        mes \"[General Hospital's Doctor]\";        mes \"Hi, my name is Joe\";        mes \"I will be your doctor for today\";        mes \"how you feeling today?\";        mes \"Painful Right??\";        mes \"I will cure you\";        mes \"My doctors fee is 500z\";        next;        menu \"Pay the Doctor\",Case1,\"Leave\",Case2;        Case1:                if(Zeny<500) goto NoZeny;                mes \"[General Hospital's Doctor]\";                mes \"Thats the fee\";                mes \"Now I will fix your wounds\";                mes \"Send this patient to the O.R.\";                next;                set Zeny,Zeny-500;                heal 30000,30000;                mes \"[General Hospital's Doctor]\";                mes \"How you feeling now? you just woke up from the Operation\";                mes \"You may now check out of the Hospital\";                mes \"Thank You and come and visit Me anytime\";                close;        NoZeny:                mes \"[General Hospital's Doctor]\";                mes \"You have no money. The medical Supplies is very expensive you know.\";                mes \"All I need is your 500z fee.\";                mes \"Come back when you have it.\";                close;        Case2:                mes \"[General Hospital's Doctor]\";                mes \"I Hope you be back later\";                close;        close;}[1;33m论坛：bbs.chinesemud.org站点：www.chinesemud.org[2;37;0m[2;37;0m","title":"Re: mud",]),(["time":1079855797,"author":"蕴龙心境","owner":"jinx","msg":"ok我尽快───────────────[1;33m金鳞[1;36m岂是[1;37m池[2;37;0m[1