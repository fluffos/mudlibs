save_dbase (["/data1/room/alert/huayuan":(["room_key":"1 of alert","long":"这是猪猪的窝的后花园，种着一些朱云采自五湖四海、名山大川的奇花异草，美丽非常。朱云有时读书练武疲倦了，就到这里稍作休息，观赏花草以怡情自乐，或许能突发灵感，有所领悟。西面就是通往主人居所的铁门，东面则是一片竹林。 ","autoload":({}),"short":"后花园",]),"/data/item/s/steel-cloth":(["combat":0,"magic":0,"user":"净魔(steel)","stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/room/depravity/zoudao":(["long":"这是连接正厅和大门的一条走道，两旁都是木制墙板，前面就是迎客厅。 ","autoload":({}),"short":"走道",]),"/data/room/kta/houyuan":(["long":"这是无涯孤谷的后院，种着一些花草，大部分是都不知名的野生花草。不过花儿开起来也看上去也非常漂亮。有时独孤灭读书练武疲倦了，就到这里稍作片刻以休息，也有时友人来到这里，大家在这里切磋一下武艺。 ","autoload":({}),"short":"无涯孤谷后院",]),"/data/item/i/ime-bmm":(["combat":0,"magic":0,"stable":45,"consistence":100,"owner":0,"bless":0,]),"/data/room/riversun/yanwu2":(["long":"这是雅阁的演武厅，有时有些江湖朋友来会，想一试身手，就在这里比武较量。 ","autoload":({}),"short":"雅阁演武厅",]),"/data/room/monster/youwei":(["long":"这里是右卫舍，是看护魔物大本营大门的家丁放哨的地方。 ","autoload":({}),"short":"魔物大本营右卫舍",]),"/data1/item/c/coalsamsam-huwan":(["combat":0,"magic":0,"user":0,"stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/room/duxue/yingke":(["long":"这里是血压计的主人渡血迎接八方来客的地方。大凡客人来拜见渡血，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是主人陪同客人品尝天下名茶之处。 ","autoload":({}),"short":"血压计迎客厅",]),"/data/room/flyernet/zhongting":(["long":"这是桃花源之腰：中庭，两旁便是客人居住的厢房，后面通往后花园和主人居所，前面则是议事厅，一直通往大院。 ","autoload":({}),"short":"桃花源中庭",]),"/data/item/p/ppbrother-xajhl":(["combat":0,"magic":0,"user":"倚碧鸳(ppbrother)","stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/item/h/hoho-guan":(["magic":0,"combat":0,"user":"唐弄影(hoho)","stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/room/boyue/tingtao":(["long":"这是竹林一角的听涛阁，在这里风吹竹叶的阵阵涛声听的非常真切，真是让人心旷神怡。实在是一个参悟武功的好去处。 ","autoload":({}),"short":"听涛阁",]),"/data/pet/tangzhan-xueyu":([]),"/data/room/ladeng/lianwu":(["long":"此处便是基地总部的练武场，人在江湖，武功万万不可荒废。 ","autoload":({}),"short":"练武场",]),"/data/room/flyernet/huayuan":(["room_key":"3 of flyernet","long":"这是桃花源的后花园，种着一些大侠采自五湖四海、名山大川的奇花异草，美丽非常。大侠有时读书练武疲倦了，就到这里稍作休息，观赏花草以怡情自乐