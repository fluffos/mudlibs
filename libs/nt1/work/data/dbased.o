lingling/dating":(["long":"[1;36m你走进了一间舒适的木屋，这就是翎卿居主人慕容翎迎送客    人的地方。仔细的观察屋里的环境，摆设著几张椅子和简单    的家饰，墙边的火炉里还有木材在燃烧著，让这里的感觉温    暖不少，透过窗户向屋后望去，可以看到一片种满奇异花朵    的后院，让人把路上的疲惫忘的一乾二净。[2;37;0m","autoload":({}),"short":"翎卿居大厅",]),"/data/room/lan/huayuan":(["room_key":"4 of lan","long":"这是岚之居的后花园，种着一些岚之风情采自五湖四海、名山大川的奇花异草，美丽非常。岚之风情有时读书练武疲倦了，就到这里稍作休息，观赏花草以怡情自乐，或许能突发灵感，有所领悟。西面就是通往主人居所的铁门，东面则是一片竹林。 ","autoload":({}),"short":"后花园",]),"/data/room/god/zhulin":(["long":"这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，有时上帝就去听涛阁默听竹浪涛声，参悟武功。 ","autoload":({}),"short":"竹林",]),"/data/room/satyrdm/chashi":(["long":"是一个玲珑小巧的茶室，很是显得精致。正中有一茶几，两旁立着两个妙龄少女，正在听候主人的吩咐(tea)。 ","autoload":({}),"short":"茶室",]),"/data/item/h/htj-hlc":(["magic":0,"combat":0,"user":"皇太极(htj)","stable":100,"consistence":90,"owner":0,"bless":0,]),"/data/room/dajiana/zoudao":(["autoload":({}),"long":"这是连接正厅和大门的一条走道，两旁都是木制墙板，前面就是迎客厅。 ","short":"走道",]),"/data/room/noone/shufang":(["long":"这里是神话传说的主人决不拜师读书写字的地方，干净明亮。文房四宝整整齐齐的摆在桌子上面。有时决不拜师也在这里签发(sign)一些邀请客人的请柬。 ","autoload":({}),"short":"书房",]),"/data/room/gudaoxifen/zuowei":(["long":"这里是左卫舍，是看护怀旧雅居大门的家丁放哨的地方。 ","autoload":({}),"short":"怀旧雅居左卫舍",]),"/data/room/icegirl/yingke":(["long":"这里是剑冢的主人寒玉儿迎接八方来客的地方。大凡客人来拜见寒玉儿，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是主人陪同客人品尝天下名茶之处。 ","autoload":({}),"short":"剑冢迎客厅",]),"/data/room/htj/zoudao":(["long":"这是连接正厅和大门的一条走道，两旁都是木制墙板，前面就是迎客厅。 ","autoload":({}),"short":"走道",]),"/data/item/l/lshen-lxa":(["combat":0,"magic":0,"stable":100,"consistence":0,"owner":0,"bless":0,]),"/data/item/l/lshen-zqyeo":(["combat":0,"magic":0,"user":"洛神(lshen)","stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/item/q/qdao-zhang":(["magic":(["blood":130,]),"combat":(["WPK_NOTGOOD":1377,"WPK_BAD":8,"WPK_NOTBAD":1369,"MKS":1377,]),"user":"琴岛(qdao)","stable":100,"consistence":93,"owner":(["qdao":1618035,]),"bless":0,]),"/data/item/q/qishi-mysword":(["combat":(["WPK_NOTGOOD":4187,"WPK_BAD":45,"WPK_NOTBAD":4255,"WPK_GOOD":113,"MKS":4300,]),"magic":(["blood":402,]),"stab