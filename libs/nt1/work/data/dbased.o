ble":100,"consistence":99,"owner":(["xtt":205,"guard":1073987,"yys":2564852,"zeze":120,"xsl":70,]),"bless":0,]),"/data1/room/norika/chashi":(["long":"是一个玲珑小巧的茶室，很是显得精致。正中有一茶几，两旁立着两个妙龄少女，正在听候主人的吩咐(tea)。 ","autoload":({}),"short":"茶室",]),"/data/room/newerb/lianwu":(["long":"此处便是名字难取的练武场，人在江湖，武功万万不可荒废。 ","autoload":({}),"short":"练武场",]),"/data/item/r/rtest-bblade":(["magic":0,"combat":0,"user":"胡探索(rtest)","stable":100,"consistence":100,"owner":0,"bless":0,]),"/data/room/god/zuowei":(["autoload":({}),"long":"这里是左卫舍，是看护云海大门的家丁放哨的地方。 ","short":"云海左卫舍",]),"/data/room/catcat/houyuan":(["autoload":({}),"long":"这是小段的家的后院，正中一个假山，傲然而立、非常雄伟。下有一水池，环山而走，悠然不息。东面乃是练武之处，西面是厨房。","short":"后院",]),"/data1/pet/zhangc-zhangclv":(["user":"zhangc",]),"/data/room/heart/yanwu2":(["long":"这是琉璃香榭的演武厅，有时有些江湖朋友来会，想一试身手，就在这里比武较量。 ","autoload":({}),"short":"琉璃香榭演武厅",]),"/data/room/wubing/huayuan":(["room_key":"1 of wubing","long":"这是无病的后花园，种着一些张无病采自五湖四海、名山大川的奇花异草，美丽非常。张无病有时读书练武疲倦了，就到这里稍作休息，观赏花草以怡情自乐，或许能突发灵感，有所领悟。西面就是通往主人居所的铁门，东面则是一片竹林。 ","autoload":({}),"short":"后花园",]),"/data/room/gangbj/yingke":(["long":"这里是三藏的庙的主人唐三藏迎接八方来客的地方。大凡客人来拜见唐三藏，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是主人陪同客人品尝天下名茶之处。 ","autoload":({}),"short":"三藏的庙迎客厅",]),"/data1/room/doing/woshi":(["long":"这是主人的卧室，收拾得井井有条。南窗下是一张大床，床边有一个柜子，还有一个书架，上面放着一些书。整间屋子布置得非常朴素，并不奢华。屋门在西首。 ","autoload":({}),"short":"测试卧室",]),"/data/item/v/vivipig-belt":(["combat":0,"magic":0,"user":"薇猪头(vivipig)","stable":130,"consistence":100,"owner":0,"bless":30,]),"/data/pet/ouyangfeng-ouyang":([]),"/data/item/h/hei-heig":(["combat":(["WPK_NOTGOOD":2,"WPK_NOTBAD":2,"MKS":2,]),"magic":0,"user":"小黑(hei)","stable":100,"consistence":99,"owner":0,"bless":0,]),"/data/room/xiaodongxi/woshi":(["long":"巧雅别致的卧房。一进门就闻到一种悠悠的清香，圆锥型的屋顶尖镶嵌着一颗美丽的夜明珠，壁上挂着一幅工笔仕女图。南窗下摆放着一张心型的寒冰床，隐约中释放着丝丝的寒气。一袭淡紫色的纱帐轻拢着小床，微风轻轻拂过，紫纱也随风飞舞。透过精美的雕花水晶窗依稀可以看到远处的竹林。[2;37;0m","autoload":({}),"short":"卧室",]),"/data/room/remiel/dayuan":(["autoload":({}),"long":"这是一个宽阔的院落，种着各种树木，阳光照下来透过树荫投下层层影子