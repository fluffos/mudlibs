    "黄蓉": "黄师叔么...真不好说啊。",
    "小龙女": "你打听我妻子干什么？",
    "杨康": "算了，不替他也罢。",
    "玉蜂针": "我手头可没有，很久没有用它了。",
    "玄铁剑": (: ask_sword :),
    "玄铁剑法": (: ask_sword :),
    "古墓幽居": (: ask_youju :),
  ]));
  set("guarder", ([
    "refuse_home": "$N对$n冷冷道：滚！",
    "refuse_other": "$N对$n道：后面是古墓弟子练功的地方，你少要打扰！",
