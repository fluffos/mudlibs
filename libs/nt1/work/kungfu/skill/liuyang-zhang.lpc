// liuyang-zhang.c 天山六阳掌

#include <ansi.h>
#include <combat.h>

inherit SKILL;
int baihong(object me, object victim, int damage);

mapping *action_msg = ({
  "$N一招「阳春白雪」，真气吞吐挥洒，於化开$n攻势的同时著著进逼",
  "$N一招「岳阳三醉」，双掌招数妙著纷呈，如同花间蝴蝶，蹁跹不定，招招攻向$n周身要害",
  "$N气随意转，一招「阳关三叠」，劲力纵控得精妙无比，三道刚力齐攻向$n$l",
  "$N天山六阳掌绵绵使出，一招「小阳春」，左掌暗劲汹涌催动，意欲破开$n防守，右掌随之而出",
  "$N掌力平挥，一招「雁过衡阳」，轻灵飘逸，举重若轻地劈向$n$l",
  "$N纵气长啸，一招「阳道旱风」，阳刚之力沛然不止，掌风过处如发裂帛之声，$n立觉气息一窒",
  "$N沉肩斜身，使出一式「阳歌天钧」，右掌疾按向$n背心灵穴，左掌同时挟带浑厚内力拍出",
});

int valid_enable(string usage) { return usage == "parry" || usage == "strike"; }

int valid_combine(string combo) { return combo == "zhemei-shou"; }

int valid_learn(object me) {
  if ((int)me->query("str") < 30)
    return notify_fail("算了吧，你先天臂力不好，别强学了。\n");

  if (me->query_temp("weapon"))
    return notify_fail("练天山六阳掌必须空手。\n");

  if ((int)me->query_skill("xiaowuxiang", 1) < 50
    && (int)me->query_skill("bahuang-gong", 1) < 50
    && (int)me->query_skill("beiming-shengong", 1) < 50)
    return notify_fail("你的逍遥派内功火候不够，无法学习天山六阳掌。\n");

  if ((int)me->query("max_neili") < 500)
    return notify_fail("你的内力太弱，无法学习天山六阳掌。\n");

  if ((int)me->query_skill("strike", 1) < 80)
    return notify_fail("你的基本掌法火候不够，无法学习天山六阳掌。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  string msg;

  if (random(me->query_temp("lingjiu/baihong")) > 50
    || me->query_temp("baihong_attack")) {
    switch (me->query_temp("baihong_attack")) {
      case 1:
        msg = "不料$N左掌一带，掌力绕过$N的身子，直拍向$p$l";
        break;
      case 2:
        msg = WHT "谁知$N一掌未竭第二掌又至，连催两重劲，掌力便如长蛇之游，奇诡不可设想" NOR;
        break;
      default:
        msg = WHT "突然间$N掌力破空，拍向$n，劲风扑面，锋利如刀，转而斜砍$p$l" NOR;
        break;
    }

    me->add_temp("lingjiu/baihong", -1);
    return ([
      "action": msg,
      "force": 460 + random(120),
      "dodge": 100,
      "attack": 100,
      "parry": 100,
      "damage_type": "内伤",
      "post_action": (: baihong :)
    ]);
  }

  return ([
    "action": action_msg[random(sizeof(action_msg))],
    "force": 460 + random(50),
    "attack": 80 + random(10),
    "dodge": 80 + random(10),
    "parry": 80 + random(10),
    "damage_type": random(2) ? "瘀伤" : "内伤",
  ]);
}

int practice_skill(object me) {
  if (me->query_temp("weapon"))
    return notify_fail("练天山六阳掌必须空手。\n");
  if ((int)me->query("qi") < 90)
    return notify_fail("你的体力不够练天山六阳掌。\n");
  if ((int)me->query("neili") < 90)
    return notify_fail("你的内力不够练天山六阳掌。\n");
  me->receive_damage("qi", 80);
  me->add("neili", -80);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "liuyang-zhang/" + action;
}

int baihong(object me, object victim, int damage) {
  int level = (int)me->query_skill("liuyang-zhang", 1) / 2;

  me->add_temp("baihong_attack", 1);

  if (me->query_temp("baihong_attack") < 3) {
    me->add_temp("apply/attack", level);

    if (me->query_temp("baihong_attack") == 1)
      COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
    else me->delete_temp("baihong_attack");

    me->add_temp("apply/attack", -level);
    return 1;
  } else me->delete_temp("baihong_attack");
  return 1;
}

int query_effect_parry(object attacker, object me) {
  int lvl;

  if (me->query_temp("weapon"))
    return 0;

  lvl = me->query_skill("liuyang-zhang", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}
