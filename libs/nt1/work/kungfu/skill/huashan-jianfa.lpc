// huashan-jianfa.c 华山剑法 

inherit SKILL;
#include <ansi.h>

string *action_msg = ({
  "$N一招「白云出岫」，剑势灵动轻盈，手中$w点向$n的$l",
  "$N使出「有凤来仪」，剑势飞舞而出，内藏五个后着，划向$n的$l",
  "$N吐气开声一招「天绅倒悬」，$w自上而下划出一个大弧，向$n劈砍下去",
  "$N向前跨上一步，运足内劲，手中$w使出「白虹贯日」，急劲无踌地直刺$n",
  "$N手中的$w自左而右地一晃，使出「苍松迎客」带着呼呼风声直削$n的$l",
  "$N飞身跃起，一式「金雁横空」，卷起漫天剑影，$w向$n电射而去",
  "$N凝气守中，$w逼出雪亮剑芒，挥出「无边落木」，一剑快似一剑底地攻向$n",
  "$N驱剑中宫直进，剑尖颤动，中途忽然转而向上，「青山隐隐」端的是变幻无方",
  "$N侧身斜刺一剑，一招「古柏森森」卷带着森然剑气，将$n包围紧裹",
  "$N双手握起$w，剑芒暴长，一式「无双无对」，驭剑猛烈绝伦地往$n冲刺",
  "$N手中$w剑光暴长，一招「金玉满堂」往$n$l刺去",
  "$N舞动$w，一招「鸿飞冥冥」挟著无数剑光刺向$n的$l",
  "$N手中$w龙吟一声，祭出「平沙落雁」往$n的$l刺出数剑",
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 25)
    return notify_fail("你的紫霞神功火候太浅。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return ([
    "action": action_msg[random(sizeof(action_msg))],
    "damage": 120 + random(30),
    "attack": 60 + random(10),
    "dodge": 60 + random(10),
    "parry": 60 + random(10),
    "damage_type": random(2) ? "刺伤" : "割伤",
  ]);
}

mixed hit_ob(object me, object victim, int damage) {
  mixed result;

  if (me->query_skill("zixia-shengong", 1) < 100
    || me->query_skill_mapped("force") != "huashan-jianfa"
    || !me->query_temp("powerup")
    || damage < 100) return 0;

  if (random(damage / 2) > 50) {
    result = ([ "damage": damage ]);
    result += ([ "msg": HIR "只见紫光闪过，$n鮮血四濺，被$N" HIR "剑上的紫霞神功所伤！\n" NOR ]);
    return result;
  }
}


int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力不够练华山剑法。\n");
  if ((int)me->query("neili") < 70)
    return notify_fail("你的内力不够练华山剑法。\n");
  me->receive_damage("qi", 60);
  me->add("neili", -60);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huashan-jianfa/" + action;
}
