// shenzhao-jing.c
// by Lonely

inherit FORCE;
#include <ansi.h>
int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) { return 1; }

int query_neili_improve(object me) {
  int lvl;
  lvl = (int)me->query_skill("shenzhao-jing", 1);
  return lvl * lvl * 21 * 15 / 100 / 200;
}

int valid_learn(object me) {
  int lvl = (int)me->query_skill("shenzhao-jing", 1);
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的神照神功。\n");
  return ::valid_learn(me);
}

int practice_skill(object me) {
  return notify_fail("神照经只能通过学习来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "shenzhao-jing/" + func;
}
