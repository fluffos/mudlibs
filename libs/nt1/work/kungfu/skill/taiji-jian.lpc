// taiji-jian.c 太极剑

#include <ansi.h>
#include <combat.h>

inherit SKILL;

int raozhi(object me, object victim, object weapon, int damage);

string *action_msg = ({
  NOR "$N右脚向前一步，左膝提起，$w" NOR "向前上方划出一招「" HIW "宿鸟投林" NOR "」，刺向$n的$l！",
  NOR "只见$N一反身，手中$w" NOR "向前划了一个大弧，使一招「" HIW "流星赶月" NOR "」，回劈$n的$l！",
  NOR "$N一招「" HIW "天马行空" NOR "」，双脚轻点，向前跃落，右手$w" NOR "由上向前劈下，飘逸地点向$n的$l",
  NOR "$N提起左腿，转身垫步，右脚跟进，一招「" HIW "黄峰入洞" NOR "」，$w" NOR "中宫直进，刺向$n的$l",
  NOR "$N一招「" HIW "射雁式" NOR "」，左脚跃步落地，$w" NOR "回抽，不缓不急，反手勾向$n的$l",
  NOR "$N跟进一招「" HIW "燕子抄水" NOR "」，$w" NOR "自上而下划出一个大弧，平平地向$n的$l挥去！",
  NOR "$N摆一个左虚步，手中$w" NOR "顺势划出一个整圆，一式「" HIW "小魁星" NOR "」撩向$n的$l",
  NOR "$N右脚独立，右手$w" NOR "向后撤，再向前平平托起，一招「" HIW "挑帘式" NOR "」刺向$n的$l",
  NOR "$N使一招「" HIW "风扫梅花" NOR "」，身体不停地旋转，右手$w" NOR "随身转动，风雷电掣般向$n的$l扫去",
  NOR "$N左脚前进一步，右手$w" NOR "一招「" HIW "顺水推舟" NOR "」，剑势绵绵，向前刺向$n的$l",
  NOR "$N一个弓步挂劈，再一个虚步抡劈，左右「" HIW "车轮剑" NOR "」，绵绵不绝劈向$n的$l！",
  NOR "$N微一凝神，一招「" HIW "探海式" NOR "」，右脚独立，左膝提起，钢剑向前抡劈$n的$l！",
  NOR "$N右脚后撤一步，一转身，右手$w" NOR "向后反击，一招「" HIW "大鹏展翅" NOR "」，抹向$n的$l",
  NOR "$N双脚并步，身体立起，双手持$w" NOR "，一招「" HIW "白猿献果" NOR "」，向前平平刺出，点向$n的$l",
  NOR "$N向前连跳两步，一招「" HIW "野马跳涧" NOR "」，$w" NOR "向前平刺两剑，点向$n的$l",
  NOR "$N右脚向前垫步，一招「" HIW "海底捞月" NOR "」，$w" NOR "由上向后划一个大弧，向前撩向$n的$l",
  NOR "$N左脚独立，右膝提起，双手捧剑，一招「" HIW "虎抱头" NOR "」，缓缓刺向$n的$l",
  NOR "$N使出「" HIW "三环套月" NOR "」，$w" NOR "划出三个圆圈，剑锋直出，绵绵不断划向$n的$l",
  NOR "$N左脚踏实，右脚虚点，一招「" HIW "仙人指路" NOR "」，右手$w" NOR "带着一团剑花，逼向$n的$l",
  NOR "$N一招「" HIW "右拦扫" NOR "」，一招「" HIW "左拦扫" NOR "」，剑锋平指，一气呵成横扫$n的$l",
  NOR "$N一招「" HIW "乌龙摆尾" NOR "」，右脚变虚步，右手回收，顺势带动$w" NOR "向下截劈$n的$l",
  NOR "$N心神不乱，顺手拔出腰间$w" NOR "，一招太极剑法「" HIW "圆转如意" NOR "」，斜斜划了个圈子，刺向$n的$l",
  NOR "$N左脚向前进一步，$w" NOR "由后划一整圆向前托起，一招「" HIW "迎风掸尘" NOR "」，刺向$n的$l",
  NOR "$N使一招「" HIW "青龙出水" NOR "」，右脚向后回撤，$w" NOR "随身体右后撤，突然向左前方刺向$n的$l",
  NOR "$N虚步提腰，一招「" HIW "蜻蜓点水" NOR "」，手中$w" NOR "轻轻颤动，一剑剑点向$n的全身大穴",
  NOR "$N向前跨上一步，左手剑诀，右手$w" NOR "使出一式「" HIW "指南针" NOR "」，剑尖直刺$n的$l",
  NOR "$N一招「" HIW "燕子掠波" NOR "」，$w" NOR "自上而下划出一个大弧，平平地向$n的$l挥去",
  NOR "$N一招「" HIW "却步抽剑" NOR "」，左脚跃步落地，引$p进前，接着$w" NOR "回抽，反手勾向$n的$l",
  NOR "$N右腿半屈般蹲，一招「" HIW "如封似闭" NOR "」，捏了个剑诀，剑尖虚指，转身撩向$n的$l",
  NOR "$N回身拧腰，右手虚抱，一招「" HIW "拨云瞻日" NOR "」，$w" NOR "中宫直进，中正平和地刺向$n的$l"
});

int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me) {
  if ((int)me->query("int") < 26)
    return notify_fail("你这么笨的人如何能学到太极剑呢？\n");

  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_skill("taiji-shengong", 1) < 100)
    return notify_fail("你的太极神功火候太浅。\n");

  if (me->query_skill("taiji-jian", 1) > me->query_skill("taiji-quan", 1) + 30)
    return notify_fail("你的太极拳火候太浅。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return ([
    "action": action_msg[random(sizeof(action_msg))],
    "damage": 140 + random(50),
    "attack": 80 + random(10),
    "dodge": 80 + random(10),
    "parry": 80 + random(10),
    "damage_type": random(2) ? "刺伤" : "割伤",
  ]);

}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 90)
    return notify_fail("你的体力不够练太极剑法。\n");
  if ((int)me->query("neili") < 90)
    return notify_fail("你的内力不够。\n");
  me->receive_damage("qi", 80);
  me->add("neili", -80);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "taiji-jian/" + action;
}

mixed valid_damage(object ob, object me, int damage, object weapon) {
  mixed result;
  int ap, dp, mp;
  object m_weapon;

  if ((int)me->query_skill("taiji-jian", 1) < 100 ||
    !(m_weapon = me->query_temp("weapon")) ||
    !living(me) || m_weapon->query("skill_type") != "sword")
    return;

  mp = ob->query_skill("count", 1);
  ap = ob->query_skill("force") + mp;
  dp = me->query_skill("parry", 1) / 2 + me->query_skill("taiji-jian", 1);

  if (ap / 2 + random(ap) < dp) {
    result = ([ "damage": -damage ]);

    switch (random(3)) {
      case 0:
        result += ([ "msg": HIC "$n" HIC "一抖手中的" + m_weapon->name() +
          HIC "，划出了一个圆圈，竟然让$N" +
          HIC "的攻击全然落空。\n" NOR ]);
        break;

      case 1:
        result += ([ "msg": HIC "$n" HIC "手中" + m_weapon->name() + HIC
          "轻挑，正指向$N" HIC "攻势中的破绽。\n" NOR ]);
        break;

      default:
        result += ([ "msg": HIC "$n" HIC "晃动手中的" + m_weapon->name() +
          HIC "，不住的变幻剑势，让$N"
          HIC "完全无法捕捉到力道。\n" NOR ]);
        break;
    }
    return result;
  } else if (mp >= 100) {
    switch (random(2)) {
      case 0:
        result = HIY "$n" HIY "一抖手中的" + m_weapon->name() + HIY "，划出了一个圆圈，$N"
          HIY "理也不理，当即挥招直入，进袭$n"
          HIY "！\n" NOR;
        break;

      case 1:
        result = HIY "$n" HIY "手中" + m_weapon->name() + HIY "轻挑，"
          HIY "正指向$N" HIY "攻势中的破绽，可是$N"
          HIY "身形一变，破绽立刻不成为破绽。\n" NOR;
        break;

      default:
        result = HIY "$n" HIY "晃动手中的" + m_weapon->name() + HIY "，不住的变幻剑势，然而$N"
          HIY "算理深厚，精演天数，丝毫不受$n"
          HIY "的迷惑。\n" NOR;
        break;
    }
    COMBAT_D->set_bhinfo(result);
  }
}

int query_effect_parry(object attacker, object me) {
  int lvl;
  if (!objectp(me->query_temp("weapon")))
    return 0;

  lvl = me->query_skill("taiji-jian", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}
