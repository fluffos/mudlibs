// kuangfeng-blade 狂风刀法
// 田伯光的刀法
// Updated by Lonely

#include <ansi.h>
inherit SKILL;

mapping *action_msg = ({
  "$N手中$w轻挥，一招" + HIW "「风平浪静」" NOR + "，看似平缓实则迅速地向$n的$l撩去",
  "$N一招" + HIW "「风起云涌」" NOR + "，右脚一点，$w寒光闪闪，快速涌$n的$l",
  "$N一招" + HIY "「风卷残云」" NOR + "，手臂一抡，刀锋一卷，自上而下斩向$n",
  "$N一招" + HIC "「风流云散」" NOR + "，侧身而退，$w却在胸前划出一道圆弧，横劈$n的$l",
  "$N侧身滑步而上，一招" + HIW "「风声鹤唳」" NOR + "，欺至$n身前，$w猛砍$n的$l",
  "$N快速挥舞$w，使出一招" + RED "「风中残烛」" NOR + "，幻起一片刀花罩向$n的$l",
  "$N一招" + HIC "「风刀霜剑」" NOR + "，只见漫天刀光闪烁，重重刀影向$n的全身涌去",
  "$N使一招" + HIW "「风驰电掣」" NOR + "，$w舞出阵阵光影向$n的$l涌去",
  "$N一招" + HIB "「风雨飘摇」" NOR + "，$w刀光闪烁不定，似幻似真地逼$n的$l",
  "$N挪步小退，一招" + HIC "「风花雪月」" NOR + "，手中$w轻描淡写地挥出一刀，\n随即又“唰唰”连劈出两刀，后发先至，洒向$n的$l",
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 300)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 60)
    return notify_fail("你的内功心法火候太浅。\n");
  if ((int)me->query_skill("dodge", 1) < 60)
    return notify_fail("你的轻功火候太浅。\n");
  if ((int)me->query_dex() < 25)
    return notify_fail("你的身法还不够灵活。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return ([
    "action": action_msg[random(sizeof(action_msg))],
    "damage": 120 + random(20),
    "attack": 60 + random(10),
    "dodge": 60 + random(10),
    "parry": 60 + random(10),
    "damage_type": random(2) ? "砍伤" : "割伤",
  ]);
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力不够练狂风刀法。\n");
  me->receive_damage("qi", 25);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "kuangfeng-blade/" + action;
}

mixed hit_ob(object me, object victim, int damage) {
  if (damage < 100) return 0;

  if (random(damage / 2) > victim->query_str()) {
    victim->receive_wound("qi", (damage - 100) / 2);
    return HIW "你听到「喀嚓」一声轻响，已被$N的刀气剁伤，$n顿时血冒三丈!!!\n" NOR;
  }
}

int query_effect_parry(object attacker, object me) {
  int lvl;
  if (!objectp(me->query_temp("weapon")))
    return 0;

  lvl = me->query_skill("kuangfeng-blade", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}
