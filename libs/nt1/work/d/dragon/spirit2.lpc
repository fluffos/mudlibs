inherit ROOM;  
#include <ansi.h> 
void create() 
{ 
        set("short", "精灵界");
        set("long",
"[1;32m这里紫霓朦胧，瑞气缭绕，虚空中有一幅诗卷：[2;37;0m[\n"
"1;37m第一个封印放树巅，风精灵从此不再飞翔。[2;37;0m[1;37m第二\n"
"个封印落水间，涟漪和浪花便敛起了锋芒。[2;37;0m[1;37m第三个封印\n"
"封锁山岩，大地的歌声转为呜咽。[2;37;0m[1;37m第四个封印驱逐雷电，\n"
"世间只剩下冰冷的火焰。[2;37;0m[1;37m第五个封印啊天空知道，太阳\n"
"的光芒远离了绝顶上神奇的琼草。[2;37;0m[1;37m第六个封印也很清晰，\n"
"月光在墓园里不安地嬉戏。[2;37;0m[1;37m可是第七个封印啊，[2;37;\n"
"0m[1;37m我怎么想也想不起。[2;37;0m[1;37m第七个封印啊我一生的\n"
"灵契，[2;37;0m[1;37m我究竟把它忘在哪里？[2;37;0m[1;32m一个清\n"
"灵美丽的女孩站在诗卷下，仿佛等待着什么。[2;37;0m\n"
);
        set("exits", ([ 
   "south" : __DIR__"spirit1",
 ]));
        set("objects", ([ 
           "/quest/tulong/npc/leader" : 1,
]));
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

