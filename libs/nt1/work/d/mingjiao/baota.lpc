#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "光明宝塔" NOR);
  set("long", @LONG
这里是明教光明顶上的一座宝塔，在正中的扁额上有用楷书写着“光
明宝塔”四字。此塔仿明教在唐朝时皇帝为明教所建的光明寺宝塔而建，
是为纪念当年明教鼎盛时期而建。塔高五层，每层皆由青砖做成，虽然历
时年代久远，但仍然艰固无比。沿塔而上就可以纵观光明顶上的建筑群了。
LONG);
  set("exits", ([
    "southdown": __DIR__ "sht",
    "enter": __DIR__ "baota0",
  ]));
  set("outdoors", "mingjiao");
  set("coor/x", -290);
  set("coor/y", 240);
  set("coor/z", 140);
  setup();
}
