inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，人来人往非常繁忙，不时有人骑着马匆匆而
过。大道往东进入安徽境内。西边通向襄阳城。
LONG);
  set("outdoors", "襄阳");

  set("exits", ([
    "east": __DIR__ "outeroad3",
    "west": __DIR__ "outeroad1",
  ]));

  setup();
  replace_program(ROOM);
}
