// smith.c

inherit SMITH;

void create() {
  set_name("铁匠", ({ "tiejiang", "smith" }));
  set("title", "铁匠铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 33);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");

  set("combat_exp", 800000);
  set("attitude", "friendly");
  set("vendor_goods", ({  //注释了，提高兼容性
  "/clone/weapon/gangdao",
    "/clone/weapon/changjian",
    "/clone/weapon/qimeigun",
    "/clone/weapon/changbian",
    "/clone/weapon/gangzhang",
    "/d/city/npc/obj/tiejia",
    "/quest/zhuzao/weapon/bow/bow1",
    "/quest/zhuzao/weapon/bow/bow2",
    "/quest/zhuzao/weapon/bow/bow3",
    "/quest/zhuzao/weapon/bow/bow4",
    "/quest/zhuzao/weapon/bow/bow5",
    "/quest/zhuzao/weapon/bow/bow6",
    "/quest/zhuzao/weapon/bow/bow7",
    "/quest/zhuzao/weapon/bow/bow8",
  }));

  setup();

  carry_object("/clone/misc/cloth")->wear();
}
