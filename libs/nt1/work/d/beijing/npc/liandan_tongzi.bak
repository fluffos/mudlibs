#include <ansi.h>
inherit NPC;

int ask_me();
int do_caiyao();

void create()
{
        set_name("小童", ({"xiao tong", "xiao", "tong"}));
        set("gender", "男性");
        set("age", 12);
        set("long",
                "这是炼丹房中的掌管药材的童子。他年纪不大，但看起来\n"
                "显得少年老成。\n");
        set("attitude", "friendly");
        set("shen_type",1);
        set("str", 21);
        set("int", 22);
        set("con", 23);
        set("dex", 22);
        set("qi", 600);
        set("max_qi", 600);
        set("jing", 400);
        set("max_jing", 400);
        set("neili", 1200);
        set("max_neili", 1200);;

        set("combat_exp", 300000);
        set("score", 20000);

        set("inquiry", ([
                "药材" : (:do_caiyao:),
                "药" : (:do_caiyao:),
                "采药" : (:do_caiyao:),
                "草药" : (:do_caiyao:),
                "yaocai" : (:do_caiyao:),
        ]) );
        set("caiyao",12);

        setup();
}

void attempt_apprentice(object ob)
{
        command("say 好吧，让我来给你加工。");
        command("say 加工好了，你现在直接去丹房炼丹（liandan）就行了。");
        command("recruit " + ob->query("id"));
 }

int do_caiyao()
{  
        object me = this_player();
    if( me->query_temp("caiyao"))
    {
        if( me->query_temp("caiyao")==1)
          {
                tell_object(me,"叫你去采药，还呆在这干嘛！\n");
                return 1;
          }
        if( me->query_temp("caiyao")==2)
          {
                tell_object(me,"药采来了？还不快给我！\n");
                return 1;
          }
        if( me->query_temp("liandan")<1)
          {
                tell_object(me,"你又不炼药，要药材干什么？\n");
                return 1;
          }
        if( me->query_temp("liandan")==2)
          {
                tell_object(me,"药材已经准备好，可以去了。\n");
                return 1;
          }
        if( me->query_temp("liandan")==3)
          {
                tell_object(me,"你不是在里面炼药吗？怎么出来了。\n");
                return 1;
          }
        if( me->query_temp("liandan")==4)
          {
                tell_object(me,"还是先去复命吧。\n");
                return 1;
        }       
        return 1;
    }
        message_vision(CYN"小童对$N说道：好吧，那你去城西的林子里挖几样新鲜的草药来。\n"NOR, me);
        me->set_temp("caiyao", 1);
        add("caiyao",-1);
        return 1;

}
int accept_object(object me, object ob)
{
        if (me->query_temp("caiyao") < 1)
        {
                command("say 我什么时候叫你拿这个给我的？");
        }
        else if (me->query_temp("caiyao") ==1)
        {
                command("say 是谁帮你找的东西来敷衍我，别以为我小就好骗。");
        } 
        else if (strsrch(ob->query("name"), "不知名草药") < 0) 
        {
                command("say 你欺我小啊？拿这种东西骗我。\n");
        }
        else
        {
        command("say 好吧，让我来给你加工。\n");
        command("say 加工好了，你现在直接去丹房炼丹（liandan）就行了。");
        me->delete_temp("caiyao");
        me->set_temp("liandan", 2);  
        me->add("combat_exp", 2 + random(10));
        me->add("potential", 1 + random(5));

        if (me->query("potential") > me->query_potential_limit()) 
        me->set("potential", me->query_potential_limit()); 

	destruct(ob);
        return 1;
        }
    return 0;
}

