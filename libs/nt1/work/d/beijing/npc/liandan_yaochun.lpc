#include <ansi.h>
inherit NPC;
int do_liandan();
void create() {
  set_name("姚春", ({ "yao chun", "yao", "chun" }));
  set("gender", "男性");
  set("age", 56);
  set("title", HIG "回春堂" NOR);
  set("nickname", HIR "跌打名医" NOR);
  set("long",
    "这便是京城回春堂药铺的跌打名医姚春，身材\n"
    "干瘦，其貌不扬。当年天地会徐天川受了伤，\n"
    "便由他医治，此人既是名医，擒拿短打也是一\n"
    "绝。\n");
  set("attitude", "heroism");
  set("shen_type", 1);
  set("str", 32);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 20000);
  set("max_qi", 20000);
  set("jing", 1600);
  set("max_jing", 1600);
  set("neili", 20000);
  set("max_neili", 20000);

  set("combat_exp", 10000000);
  set("score", 300000);

  set_skill("dodge", 250);

  set("book_count", 1);
  set("inquiry", ([
    "徐天川": "那老猴儿便是我给医治的，怎么你也知道。\n",
    "quest": "在我这里可以帮着我“炼丹”，如果愿意，可以想我询问。\n",
    "job": "在我这里可以帮着我“炼丹”，如果愿意，可以想我询问。\n",
    "炼丹": (: do_liandan :),
    "药材": "去找我的小童，他会帮你处理。\n",
    "原料": "去找我的小童，他会帮你处理。\n",
    "yaocai": "去找我的小童，他会帮你处理。\n",
    "药": "去找我的小童，他会帮你处理。\n",
  ]));

  setup();

}

void init() {
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, this_player());
}


int do_liandan() {
  object me = this_player();
  if (me->query_temp("liandan")) {
    if (me->query_temp("liandan") < 4) {
      command("say 不是要去炼丹吗，怎么还在这呆着？\n");
      return 1;
    }
    message_vision("姚春对$N微笑道：炼丹是个修身养性的过程，你能成功，很不错！\n", me);
    me->add("combat_exp", 1000 + random(50));
    me->add("potential", 800 + random(50));

    if (me->query("potential") > me->query_potential_limit())
      me->set("potential", me->query_potential_limit());
    if (me->can_improve_skill("liandan-shu"))
      me->improve_skill("liandan-shu", 21);

    me->delete_temp("liandan");
    return 1;
  } else {
    message_vision("姚春对$N点了点头，说道：炼丹是考验人的定力修为，心不静则事不成，你要试可以向童子打听“药材”。\n", me);
    me->set_temp("liandan", 1);
    return 1;
  }
}
