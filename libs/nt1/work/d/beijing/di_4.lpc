#include <room.h>
inherit ROOM;

void create() {
  set("short", "地西大街");
  set("long", @LONG
这里是北京城地安门的西街。街道是整整齐齐的杨树林，道上行人络
绎不绝，车两马匹穿插其中。大街上由闲逛的游人，上京赶考的考生，背
负着担子的挑夫以及正在玩耍着的幼童构出了一幅繁忙热闹的盛世景象。
北方是一座富丽堂皇的巨宅，那就是当朝第一大臣，被御封为“满洲第一
勇士”的鳌拜的府邸。向南经过西单北大街可以通往西单。西方接西四北
大街。在路边有个狗洞(dong)，几只懒狗正在那里探头。
LONG);
  set("exits", ([
    "north": __DIR__ "aofu_men",
    "south": __DIR__ "di_3",
    "east": __DIR__ "di_5",
    "west": __DIR__ "shi_3",
  ]));
  set("item_desc", ([
    "dong": "黑呼呼的狗洞，不知道有多深。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/boy2": 1,
  ]));
  set("outdoors", "beijing");
  setup();
}

void init() {
  add_action("do_enter", "enter");
  add_action("do_enter", "zuan");
}

int do_enter(string arg) {
  object me;
  mapping fam;

  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "dong") {
    if ((fam = me->query("family")) && fam["family_name"] == "丐帮") {
      message("vision",
        me->name() + "运起丐帮缩骨功，一弯腰往狗洞里钻了进去。",
        environment(me), ({ me }));
      me->move("/d/gaibang/underbj");
      message("vision",
        me->name() + "从洞里走了进来。\n",
        environment(me), ({ me }));
      return 1;
    } else return notify_fail("这么小的洞，你钻得进去吗？\n");
  }
}
