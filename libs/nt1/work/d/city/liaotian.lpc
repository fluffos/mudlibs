inherit ROOM;

int is_chat_room() { return 1; }

void create()
{
        set("short", "客店茶房");
        set("long", @LONG
这里是扬州客栈的茶楼，许多无所事事的人在这里聊天，店小二穿梭
在客人中间，忙个不停。
LONG );
        set("no_fight", 1);
        set("no_sleep_room",1);
        set("exits", ([
                "north" : __DIR__"kedian",
        ]));
        set("objects", ([
                "/quest/quest3/yelao" : 1,
        ]));

        setup();
}


