inherit ROOM;

void create() {
  set("short", "扶风道");
  set("long", @LONG
扶风道是长安城中心大街，青石板路笔直的伸展出去，一路上行人比
肩，笙歌处处。景物之美，直如神仙境地。西面有一条大路通往长安城的
西城门。
LONG);
  set("exits",
    ([  //sizeof() == 3
    "north": __DIR__ "fufeng2",
      "south": __DIR__ "fufeng4",
      "west": __DIR__ "xian-dadao",
    ]));

  set("outdoors", "changan");
  setup();
}
