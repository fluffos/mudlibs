void create() {
  set("short", "大官道");
  set("long", @LONG
这是一条宽阔笔直的官道，足可容下十马并驰。往东通向函谷关，往
西则直达长安城。
LONG);
  set("exits", ([  /*  sizeof()  ==  2  */
    "west": __DIR__ "road4",
    "east": __DIR__ "zhongnan",
  ]));
  set("outdoors", "changan");
  setup();
}
