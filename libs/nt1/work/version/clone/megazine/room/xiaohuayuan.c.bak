#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIG "小花园" NOR);
	set("long", @LONG
这里〖地狱〗大厦四楼的一个小花园，这里的肥沃土
壤十分适合种花(zhonghua)。
LONG
	);

	set("exits", ([ 
                        "north" : __DIR__"fourroom",
]));
        set("no_fight",1);   
	setup();
}

void init()
{
        add_action("do_jiaoshui", "zhonghua");
}

int do_jiaoshui()
{
        object ob,me;
        me = this_player();

        if (me->query("combat_exp") > 1000000) 
        {
        message_vision(HIR "$N想干这个活，未免太屈就你了吧。\n",me);
        return 1;
        }
        if(me->query("jing") < 50)
        {
                message_vision(HIR "$N一幅气喘吁吁的样子，怎么能种花呢!\n" NOR,me);
                return 1;
        }
        if(me->query_temp("jiaoshui") == 2)
        {
                  if(random(7) == 1)
                {
             if(random(3) == 1)
             {
                        message_vision(HIG "$N再一次给小坑里撒了一些水。突然，一朵美丽的玫瑰从坑里冒了出来。\n",me);
                        message_vision(HIC "$N把玫瑰摘了下来，拿在手里。\n",me);
                        if(random(2) == 1)
                        ob=new("/d/city/obj/rrose");
                        else
                        ob=new("/d/changan/npc/obj/huang-meigui");
                        ob->move(me);
             }
             if(random(3) == 2)
             {
                message_vision(HIG "$N再一次给小坑里撒了一些水。突然，一朵美丽的蓝天鹅从坑里冒了出来。\n",me); 
                message_vision(HIC "$N把蓝天鹅摘了下来，拿在手里。\n" NOR,me); 
                ob=new("/d/changan/npc/obj/lan-tiane"); 
                        ob->move(me);
             }
              else
             {
                message_vision(HIG
                "$N再一次给小坑里撒了一些水。突然，一朵美丽的花儿从坑里冒了出来。\n",me);  
                message_vision(HIC "$N把花儿摘了下来，拿在手里。\n" NOR,me);  
                if(random(2) == 1) 
                ob=new("/d/changan/npc/obj/zi-luolan");  
                else 
                ob=new("/d/changan/npc/obj/bai-chahua");  
                        ob->move(me);
             }
                        me->delete_temp("jiaoshui");
                        return 1;
                }
        message_vision(HIR "$N笨手笨脚的拿起水壶给小坑里撒水，结果水撒的太多把花给毁了。\n",me);
        me->delete_temp("jiaoshui");
        return 1;

        }
        if(me->query_temp("jiaoshui") == 1)
        {
               if(me->is_busy())
                return notify_fail("你正忙着呢，别着急。\n");  
               me->set_temp("jiaoshui",2);
               message_vision(HIG "$N拿起水壶又在小坑上撒了一些水。\n",me);
               me->add("jing",-50);
               me->start_busy(1 + random(2));
                return 1;
              }
        message_vision(
HIG "只见$N用手在地上挖了一个小坑，把一些东西丢到了 
小坑里，又在上面撒了一些水。\n",this_player()); 
             me->set_temp("jiaoshui",1);
                me->start_busy(1 + random(3));
        return 1;
}
