dbase (["notes":({(["time":1055672455,"author":"高处不胜寒-lonely","msg":"神龙教的弟子可以在扬州城找到神龙教左护法「辽东胖尊者」胖头陀向他打听神龙岛，他回指引你一条捷径回到神龙岛。[2;37;0m","title":"神龙教弟子回神龙岛的捷径[2;37;0m",]),(["time":1055742035,"author":"高处不胜寒-lonely","msg":"指令格式 : analecta [ [ 年度 ] <序号> ]                    [ add <留言序号> [ from <留言板> ] ]                    [ del <年度> <序号> ]                    [ new [ 年度 ] ]                    [ convert <目录> ]本指令提供文选的阅读、增加和删除。阅读时，除本年文选不需要指定年度外，其他的都要指定年度。 比如阅读 2000 年第 3 号文选，即输入 analecta 2000 3。 使用 new 参数可以阅读你尚未阅读的新文选。巫师可以使用 new 参数来添加文选，del 参数来删除文选。 删除文选需要指定年度和序号，添加文选则必须指定所在房间的留言板ID，如：    客栈留言板(board) [ 4 张留言 ]使用 analecta add 1 from board，就可以把客栈留言板的第一号留言添加到本年度文选中。[2;37;0m","title":"新加收录玩家文选指令[2;37;0m",]),(["time":1055742819,"author":"高处不胜寒-lonely","msg":"关东大风堂今日在长安东郊开了宠物店，提供各类坐骑的，购买坐骑需要１００两黄金。如果玩家拥有了属于他自己的坐骑，那么除了可以用 [1;31mwhistle[2;37;0m 指令来呼唤宠物外 ，还可以使用 [1;31mrideto[2;37;0m 到达你想到的地方，具体能到那些地方请看 [1;31mhelp rideto[2;37;0m 指令。[2;37;0m","title":"宠物系统开放[2;37;0m",]),(["time":1055742929,"author":"高处不胜寒-lonely","msg":"可以去陈有德，马五德，龙全处购买各种武功三个等级的书籍。[2;37;0m","title":"新增可以购买武功书籍[2;37;0m",]),(["time":1055743181,"author":"高处不胜寒-lonely","msg":"请输入 [1;31mhelp backup[2;37;0m 来了解详细情况。[2;37;0m","title":"[1;31m关于可恢复档案说明[2;37;0m[2;37;0m",]),(["time":1055743365,"author":"高处不胜寒-lonely","msg":"故事中增加先天天赋是没有上限限制的，这个为本泥潭的超级武功要求极高的天赋提供了可能性。[2;37;0m","title":"故事中增加先天天赋的说明[2;37;0m",]),(["time":1055743585,"author":"高处不胜寒-lonely","msg":"这里吃丹包括故事中的丹最低可以增加你的每个先天天赋五点，当然通过吃丹提高先天天赋的上限也是每种属性增加五点。想要再提高先天天赋的话，你就要另想办法了。[2;37;0m","title":"关于这里吃丹增加先天天赋的说明[2;37;0m",]),(["time":1055744143,"author":"高处不胜寒-lonely","msg":"泥潭目前已经初步走上正轨，为了大家公平练功，巫师组决定今后泥潭在任何情况下都不会发放礼物。[2;37;0m","title":"[1;31m关于今后不会发放任何礼物的申明[2;37;0m",]),(["time":1055744525,"author":"高处不胜寒-lonely","msg":"泥潭可以通过研读正气决来提高你的正神，而负神的提高则可以通过学习九阴白骨抓和读天魔决来提高 ，当然通过杀 NPC 来提高正神和负神也一样行的通，泥潭中还有一些自由任务也是加这两方面的。[2;37;0m","title":"正神 & 负神[2;37;0m",]),(["time":1055744919,"author":"高处不胜寒-lonely","msg":"当你在泥潭中发现臭虫(ＢＵＧ)时候，你可以使用 bsos 指令来向巫师求助，同时你也可以到扬州的巫师会客室去 post 详细之情况，[1;31m注意：除此之外的任何途径，巫师都将不于理睬。[2;37;0m","title":"[1;33m如何求助巫师[2;37;0m",]),(["time":1055922356,"author":"高处不胜寒-lonely","msg":"连续完成师门任务１００次，则可随机得到一些物品。连续完成师门任务２００次，可得到的物品为菩提子。连续完成师门任务３００次，可得到的物品为天香玉露。连续完成师门任务４００次，可得到的物品为九转金丹。连续完成师门任务５００次，可得到的物品为玄黄紫清丹。同时师门任务中的门派贡献和实战体会的奖励得到大幅度提高。[2;37;0m","title":"师门任务更新[2;37;0m",]),(["time":1056252528,"author":"高处不胜寒-lonely","msg":"听说戚长发那里新到了一种可以把自己变的糊涂的丹药，这种丹药只能降低你通过吃丹而提高的那部分先天悟性。[2;37;0m","title":"新加糊涂丹可以购买[2;37;0m",]),(["time":1056450777,"author":"高处不胜寒-lonely","msg":"在王朝战争中得到的部分丹除了可以合并成乾坤圣水外，还能提高先天一点的天赋，吃这个丹的时候如果你的先天已经通过吃故事中的丹或者九转金丹提高了五点，那么则可以增加你一点额外的天赋，否则被计入正常的五个丹限制之中，再吃这种丹也不会加你的天赋了。[2;37;0m","title":"可以增加先天天赋的丹[2;37;0m",]),(["time":1056454603,"author":"高处不胜寒-lonely","msg":"少林派新增加九环锡杖、锦襕袈裟和神草结，功用只有用了后方知。[2;37;0m","title":"少林派新加神品若干[2;37;0m",]),(["time":1057127241,"author":"高处不胜寒-lonely","msg":"即日起全国各地银行取钱的时候收取百分之十的手续费，如果该银行归帮派占领，那么手续费记入该帮派收入，该帮派内的玩家取钱免除手续费，同时该业务也无手续费记入帮派收入。即日起各地的当铺、杂货铺等的买卖收入的三分之一记入其所属帮派的收入，该所属帮派玩家的购买物品时候享受三分之一的折扣，同时该业务也无利润记入帮派收入。[2;37;0m","title":"[1;31m有关于帮派涉及的内容更新[2;37;0m",]),(["time":1057170393,"author":"高处不胜寒-lonely","msg":"根据玩家李三(pain)的建议，现将钱庄设置为可以由该钱庄所属的帮派的帮主来设定取款手续费，指令为 tax amount 。如果钱庄没有被帮派设置取款手续费，那么取款手续费默认为百分之十。玩家可以用 check 指令来查询该钱庄的取款手续费。[2;37;0m","title":"关于钱庄取钱的修改[2;37;0m",]),(["time":1060356159,"author":"高处不胜寒-lonely","msg":"平一指那里近日医术大有长进，源自其获得了本草纲目这医学巨作，现平一指为了后继有人，遂将本草纲目一书抄录出售，价格便宜。[1;37m───────────────[2;37;0m[1;36m曾经[1;33m醉酒[1;31m杀[2;37;0m[1;35m名马[2;37;0m  [1;36m唯恐[1;33m多情[1;31m误[2;37;0m[1;35m美人[2;37;0m[2;37;0m[2;37;0m","title":"本草纲目一书[2;37;0m",]),(["time":1060484320,"author":"高处不胜寒-lonely","msg":"玩家如果有疑问，可以先阅读常见问题解答 help faq 来获得一些信息。在提问之前最好先阅读这份文件。───────────────[1;36m曾经[1;33m醉酒[1;31m杀[2;37;0m[1;35m名马[2;37;0m  [1;36m惟恐[1;33m多情[1;31m误[2;37;0m[1;35m美人[2;37;0m[2;37;0m[2;37;0m","title":"[1;31mhelp faq 已经修订完毕[2;37;0m",]),(["time":1060513562,"author":"高处不胜寒-lonely","