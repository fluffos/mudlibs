// 玩家任务守护进程：defend.c

#include <ansi.h>

void startup();

string *familys = ({ "武当派", "少林派", "丐帮", "峨嵋派", 
                     "星宿派", "华山派", "明教", "天龙寺", 
                     "铁掌帮", "密宗", });

// 任务对象创建
void create()
{
        seteuid(getuid());
        if (! clonep() && find_object(QUEST_D)) startup();
}

private void heart_beat()
{
        if (! find_object(QUEST_D))
                return;

        // 如果可以，每次心跳(4分钟)产生一个QUEST
        start_quest();
}


// 任务守护进程唤醒这个进程
void startup()
{
        // 启动
        if (! find_object(QUEST_D))
                return;

        if (! query_heart_beat())
                CHANNEL_D->do_channel(find_object(QUEST_D),
                                      "sys", "进程(DEFEND)启动了。");

        // 平均每四分钟产生一个任务
        set_heart_beat(110 + random(20));
}

// 停止这个任务进程
void stop()
{
        set_heart_beat(0);
}

#define MAX_NUM         15

void start_quest()
{
        int i, num; 
        object *users;          // 目前在做这个任务的玩家
        string *familys;        // 所有的门派列表
        object *obs;            // 目前所有的DEFEND任务
        string family_name;     // 被攻击的门派名称
        object qob;             // 任务对象

        // 生成所有可能被攻打的门派（去掉目前被攻打的）
        obs = children("/clone/quest/defend");
        if (arrayp(obs) && sizeof(obs) > 0)
                familys -= obs->query("quest_family");

        // 选取一个当前准备攻打的门派
        if (sizeof(familys) < 1)
                // 无法找到这样的门派
                return;
        family_name = familys[random(sizeof(familys))];
        
        // 获取攻打的人数（根据当时门派在做此任务人数）
        users = filter_array(users(), (: interactive($1) 
                                         && $1->query_family() == $(family_name) 
                                         && mapp($1->query_temp("swjob"))
                                         && ! $1->query_temp("swjob/finish") :));
        // 数量为做此任务的人数的 1-2 倍
        num = sizeof(users) * (1 + random(2));
        num = num/2 + random(num/2);
        
        // 如果超出了最大敌人数量（防止满山遍野的敌人）
        if (num > MAX_NUM) num = MAX_NUM;
        // 如果一个都找不到
        if (num <= 0) return;
        
        // 初始化任务的一些信息（启动地点）
        qob = new("/clone/quest/defend");
        qob->set("quest_family", family_name);

        CHANNEL_D->do_channel(find_object(QUEST_D),
                              "sys", "进程(DEFEND)在" + family_name +
                              HIR "利用" + num + HIR "个敌人创建了一个任务。");

        // 交由任务自己进行初始化
        qob->init_quest(num, family_name);
}
