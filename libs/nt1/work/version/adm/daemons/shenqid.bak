#include <ansi.h>

inherit F_DBASE;

int random_place(string dirs, object bs);
void choose_shenqi();

string *dirs = ({
        "/d/city",
        "/d/fuzhou",
        "/d/xiangyang",
        "/d/suzhou",
        "/d/hangzhou",
        "/d/quanzhou",
        "/d/lingzhou",
        "/d/city3",
        "/d/foshan",
        "/d/changan",
        "/d/beijing",
        "/d/dali",
});

string *dirname = ({
        "扬州城",
        "福州城",
        "襄阳城",
        "苏州城",
        "杭州城",
        "泉州城",
        "灵州城",
        "成都城",
        "佛山城",
        "长安城",
        "北京城",
        "大理城",
});


void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "内存精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "神器系统已经启动。\n"); 
        set("name", "shenqis");
        remove_call_out("choose_shenqi");
        call_out("choose_shenqi", 10);
}

void choose_shenqi()
{
        int j;
        object newob;
        string str;
        string smp;
        
        j = random(sizeof(dirs));
        
        switch(random(10))
        {
        case 0:        
                smp = "/clone/unique/xuanyuan_sword.c";
                str = "轩辕夏禹";
                break; 
        case 1:
                smp = "/clone/unique/zhanlu_sword.c";
                str = "湛泸";
                break; 
        case 2:
                smp = "/clone/unique/chixiao_sword.c";
                str = "赤霄";   
                break;     
        case 3:
                smp = "/clone/unique/taie_sword.c";
                str = "泰阿";    
                break;    
        case 4:
                smp = "/clone/unique/qixing_sword.c";
                str = "七星龙渊";  
                break;
        case 5:
                smp = "/clone/unique/ganjiang_sword.c";
                str = "干将";  
                break;
        case 6:
                smp = "/clone/unique/moye_sword.c";
                str = "莫邪";
                break;  
        case 7:
                smp = "/clone/unique/yuchang_sword.c";
                str = "鱼肠"; 
                break; 
        case 8:
                smp = "/clone/unique/chunjun_sword.c";
                str = "纯钧";
                break;  
        case 9:
                smp = "/clone/unique/chengying_sword.c";
                str = "承影";  
                break;
        }
        if (find_object(smp)
        &&  sizeof(filter_array(children(smp), (: clonep :))) > 1)
        {    
                remove_call_out("choose_shenqi");
                call_out("choose_shenqi", 1200);
                return;
        }
        
        newob = new(smp);
                                              
        if (random_place(dirs[j], newob)== 1)
        message("channel:chat", HIW "【" HIW "奇珍异宝" HIW "】" HIW "突然空中打了个炸雷，一个火球横空出世，携带着" + 
                                str + "向" + dirname[j] + "的方向落去！\n" NOR, users());
                                
        remove_call_out("choose_shenqi");
        call_out("choose_shenqi", 1200);
        return ;
}

int random_place(string dirs, object bs)
{
        int  j, k;
        object  newob,ob;
        mixed*  file, exit;
        string id_name;
        
        file = get_dir( dirs + "/npc/*.c", -1);
        
        if (! sizeof(file)) return 0;

        for (k = 0; k < 50; k++) { // try 50 times
                j = random(sizeof(file));
                if (file[j][1] > 0) 
                {
                        newob = load_object(dirs + "/npc/" + file[j][0]);
                        if (! newob) continue;
                        id_name = newob->query("id");
                        destruct(newob);
                        if (! id_name) continue;
                        if (! objectp(ob = find_living(id_name))) continue;
                        if (environment(ob)->query("no_fight")) continue;
                        if (bs->move(ob)) 
                        {
                                CHANNEL_D->do_channel(this_object(), "sys", 
                                        "神器落到了" + ob->query("name") + "(" + ob->query("id") + ")的身上。\n"); 
                                return 1;
                        }
                }
        }
        CHANNEL_D->do_channel( this_object(), "sys", "本次神器发布失败\n");        
        return 0;
}


