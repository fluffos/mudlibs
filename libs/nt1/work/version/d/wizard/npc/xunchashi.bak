#include <ansi.h>

inherit NPC;

string *msg_d = ({
        "你妈的", "傻B", "我操", "操你", "和你妈睡", "傻比", "傻逼",
        "fuck", "FUCK", "Fuck", "婊子", "和你妈做爱", "她妈的", "cao",
        "CAO", "Cao", "放你妈的屁", "tmd", "TMD", "tmmd", "TMMD", "操你妈",
        "日死你", "干你娘", "操你姐", "狗屁wiz", "狗wiz", "破wiz", "死wiz",
        "日死你", "Nnd", "干你妈", "干你的", "ｆｕｃｋ", "ＦＵＣＫ", "F u c k",
        "f u c k", "nnd", "NND", "SB", "mlgb", "MLGB", "mcb", "Sb", "sb", "shabi",
        "SHABI", "MCB", "danzi", "蛋子", "你妈", "你爹", "牛比", "放屁", "吃屎",
        "你大爷", "操你妈", "打炮", "6mang", "大便", "小便", "caobi", "手淫", "操",
});

void create()
{
        set_name("巡查使", ({"xuncha shi", "shi", "xuncha"}));
        set("title", HIY"「净化使者」"NOR);
        set("gender", "男性" );
        set("age", 30);
        set("per", 25);
        set("long", HIR "一个神秘的巡查使，你碰上他准是你干了什么坏事。\n" NOR);
        set("combat_exp", 10000000);
        set("attitude", "peaceful");
        set("str", 50);
   
        set_skill("literate", 800);
        set("max_qi", 1000);
        set("max_jing", 1000);
        set("max_neili", 1000);
        
        set("no_clean_up", 1);
        setup();

        if (! clonep()) CHANNEL_D->register_relay_channel("rumor");
        if (! clonep()) CHANNEL_D->register_relay_channel("chat");
        if (! clonep()) CHANNEL_D->register_relay_channel("party");
        if (! clonep()) CHANNEL_D->register_relay_channel("es");
        if (! clonep()) CHANNEL_D->register_relay_channel("sos");
        if (! clonep()) CHANNEL_D->register_relay_channel("nt");
        
}

void relay_channel(object criminal, string channel, string msg)
{

        int i;
        string criname, result;
        int howlong;
        
        if (! userp(criminal)) return;

        for (i = 0; i < sizeof(msg_d); i++)
        {
                if (strsrch(msg, msg_d[i]) >= 0)
                {   
                        criname = criminal->query("name") + "(" + criminal->query("id") + ")";
                        howlong = 20;
                    
                        result = sprintf("%s在%s频道说脏话(%s)被设囚禁 %d 分",
                                         criname, channel, msg, howlong);
                        criminal->get_into_prison(this_object(), 0, howlong);

                        log_file("static/channel",
                                 sprintf("%s %s send into prison because %s.\n",
                                         log_time(), geteuid(criminal), result));
                                                 
                        message("channel:rumor", HIM "【空穴来风】某人：据说 " HIR + criname + HIM " 在公众频道使用粗言烂语，被巡查使抓走了。\n" NOR, users());
                        return;
                }
        }
}


