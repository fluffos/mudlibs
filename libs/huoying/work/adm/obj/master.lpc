// Created by Annihilator (04/16/2000)

#include <http.h>

private void create() {
  write("master: loaded successfully.\n");
}

private object connect(int port) {
  object ob;
  mixed err;

  /* 配置一个新的连线物件用来作为登入程序的使用者物件 */
  switch (port) {
    case MUD_PORT:
      err = catch(ob = new(LOGIN_OB));
      if (err) {
        write("使用者登入程式正在维修中，请稍候再来。\n");
        if (query_ip_number() == "127.0.0.1") write(err);
        return 0;
      }
      return ob;
    case HTTP_PORT:
      err = catch(ob = new(HTTP_OB));
      if (err) {
        write(HTTP_VERSION + " 503 Service Unavailable" CRLF CRLF ":P");
        return 0;
      }
      return ob;
  }
}

private mixed compile_object(string file) {
  object daemon;
  mixed err;

  /* 用安全的方式寻找并呼叫 VIRTUAL_D */
  err = catch(daemon = load_object(VIRTUAL_D));

  if (err || !objectp(daemon)) return 0;
  return daemon->compile_object(file);
}

private void crash(string error, object command_giver, object current_object) {
  efun::shout("系统核心发出一声惨叫：哇 ....\n");
  efun::shout("系统核心告诉你﹕要当机了﹐自己保重吧﹗\n");
  log_file("nosave/CRASHES", sprintf("[%s] %s\n", ctime(time()), error));
  if (command_giver)
    log_file("nosave/CRASHES", sprintf("  this_player: %O\n", command_giver));
  if (current_object)
    log_file("nosave/CRASHES", sprintf("  this_object: %O\n", current_object));
}

nosave string *read_config(string file) {
  string str;

  str = read_file(file);
  if (!str) return ({});

  return filter(explode(str, "\n"), (: strlen($1) && ($1[0] != '#') :));
}

nosave string *epilog(int load_empty) {
  return read_config(CONFIG_DIR + "preload");
}

nosave void preload(string file) {
  string err;

  write("Preloading : " + file);
  err = catch(load_object(file));
  if (err) log_file("preload.log",
    sprintf("[%s] %s: %s", ctime(time()), file, err));
}

private int save_ed_setup(object who, int code) {
  return write_file(user_path(getuid(who)) + ".edrc",
    save_variable(code), 1);
}

private int retrieve_ed_setup(object who) {
  string val;

  val = read_file(user_path(getuid(who)) + ".edrc");
  return stringp(val) ? (int)restore_variable(val) : 0;
}

private void destruct_env_of(object ob) {
  if (!interactive(ob)) return;
  tell_object(ob, "你所存在的空间被毁灭了。\n");
  ob->move(VOID_OB);
}

nosave string make_path_absolute(string file) {
  return resolve_path((string)this_player()->query("cwd"), file);
}

nosave string get_save_file_name(string fname) {
  return fname + "." + time();
}

nosave string get_root_uid() {
  return ROOT_UID;
}

nosave string get_bb_uid() {
  return BACKBONE_UID;
}

nosave string creator_file(string str) {
  object ob;

  catch(ob = load_object(SIMUL_EFUN_OB));
  return ob ? (string)ob->creator_file(str) : "NONAME";
}

string object_name(object ob) {
  if (!objectp(ob)) return 0;
  return getuid(ob);
}

string standard_trace(mapping error) {
  int i, s;
  string res = "";

  /* keep track of number of errors per object...if you're into that */
  res += sprintf("执行时段错误：%s物件：%O:%s\n程式：%s:%i\n",
    error["error"],
    error["object"],
    error["program"],
    error["file"],
    error["line"]);

  res += "函数呼叫回溯:\n";
  foreach (mapping trace in error["trace"]) {
    res += sprintf("%-25O %-20s %s:%i\n",
      trace["object"],
      trace["function"],
      trace["program"] == trace["file"] ? trace["program"]
      : trace["file"] + "(" + trace["program"] + ")",
      trace["line"]);
  }
  res += "\n";

  return res;
}

string error_handler(mapping error, int caught) {
  string report;
  object player;

  if (caught) return 0;

  report = standard_trace(error);

  player = this_player();

  if (objectp(player) && interactive(player)) efun::write(report);

  /* 传回的字串会被纪录在 debug.log */
  return report;
}

nosave void log_error(string file, string message) {
  string name, home;

  if (find_object(SIMUL_EFUN_OB))
    name = file_owner(file);

  if (name) home = user_path(name);
  else home = LOG_DIR;

  // This driver's APPLY_LOG_ERROR fires for every soft compile WARNING
  // (e.g. "Illegal to declare nosave function", "Unused local
  // variable"), not just genuine fatal errors like the original mudlib
  // author assumed -- broadcasting all of them to the triggering player
  // floods ordinary play with alarming-looking "编译时段错误" (compile
  // error) messages for harmless warnings (AGENTS.md #15w). Still log
  // everything to file; only suppress the player-facing broadcast for
  // messages that are just warnings.
  if (this_player(1) && strsrch(message, "warning:") == -1)
    efun::write("编译时段错误﹕" + message);

  efun::write_file(home + "log", sprintf("[%s]%s", ctime(time())[4..18], message));
}

nosave int valid_override(string file, string name) {
  if (file == SIMUL_EFUN_OB || file == MASTER_OB) return 1;

  if (file[0..15] == "/adm/simul_efun/") return 1;

  // Must use the move() defined in F_MOVE.
  if (((name == "move_object") || (name == "destruct")) && (file != F_MOVE)) {
    log_error("override", sprintf("%s attempts to override %s(), denied.\n", file, name));
    return 0;
  }

  //  may also wish to protect shutdown, snoop, and exec.
  return 1;
}

nosave int valid_seteuid(object ob, string str) {
  return (int)SECURITY_D->valid_seteuid(ob, str);
}

nosave int valid_socket(object eff_user, string fun, mixed *info) {
  return 1;
}

nosave int valid_object(object ob) {
  return (!clonep(ob)) || inherits(F_MOVE, ob);
}

// valid_save_binary: controls whether an object can save a binary
//   image of itself to the specified "save binaries directory"
//   (see config file)
nosave int valid_save_binary(string filename) { return 1; }

// valid_write: write privileges; called with the file name, the object
//   initiating the call, and the function by which they called it.
// NOTE: guarded with a re-entrancy flag (AGENTS.md #4) -- this driver
// forbids load_object() while ANY object is mid-compile, and the error
// thrown is reported via this SAME apply (to check write permission for
// the error log), which retries the disallowed load_object() again --
// an unbounded loop that overflows the C++ call stack. The original
// `catch()`-only form here is NOT sufficient: catch() only protects the
// control flow of THIS call, but the recursive re-entry comes from a
// brand-new outer call via the driver's own error-reporting path.
private nosave int loading_security_d;

nosave int valid_write(string file, mixed user, string func) {
  if( user == this_object() )
  	return 1;

  object ob;

  if (!find_object(SECURITY_D)) {
    if (loading_security_d) return 0;
    loading_security_d = 1;
    catch(ob = load_object(SECURITY_D));
    loading_security_d = 0;
  } else {
    ob = find_object(SECURITY_D);
  }

  if (objectp(ob))
    return (int)SECURITY_D->valid_write(file, user, func);

  return 0;
}

// valid_read: read privileges; called exactly the same as valid_write()
nosave int valid_read(string file, mixed user, string func) {
  if( user == this_object() )
  	return 1;

  object ob;

  if (!find_object(SECURITY_D)) {
    if (loading_security_d) return 1;
    loading_security_d = 1;
    catch(ob = load_object(SECURITY_D));
    loading_security_d = 0;
  } else {
    ob = find_object(SECURITY_D);
  }

  if (objectp(ob))
    return (int)SECURITY_D->valid_read(file, user, func);

  return 1;
}

nosave int valid_bind(object binder, object old_owner, object new_owner) {
  // Root can bind anything to anything
  if (geteuid(binder) == ROOT_UID) return 1;

  // Root's function can be bind to anyone (down-grading)
  if (old_owner && geteuid(old_owner) == ROOT_UID) return 1;

  // Any function can be bind to binder itself
  if (binder == new_owner) return 1;

  if (!userp(new_owner) && clonep(new_owner)) return 1;

  log_file("bind", sprintf("%O attempts to bind %O's function to %O\n",
    binder, old_owner, new_owner));
  return 0;
}
