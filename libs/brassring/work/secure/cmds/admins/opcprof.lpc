#include <lib.h>
#include <dirs.h>

inherit LIB_DAEMON;

int cmd(string arg) {
  if (!archp(previous_object())) return 0;
  write("The opcprof efun was removed from the FluffOS driver, so there is no profile to dump.");

  return 1;
}

string GetHelp() {
  return ("Syntax: opcprof\n\n"
    "Reports that there is no operator profile to dump: the opcprof efun was "
    "removed from the FluffOS driver.\n "
    "See man: opcprof\n"
    "See also: fdinfo, netstat, mstatus, cache, callouts, dumpallobj,");
}
