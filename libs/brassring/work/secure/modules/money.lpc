#include <lib.h>
#include <dirs.h>
#include <daemons.h>
#include <modules.h>
#include <commands.h>
#include ROOMS_H


string money_globalstr, money_globalstr2, money_globalstr3, money_globaltmp;
mapping TmpMap = ([]);
mapping LoadMap = ([]);

int eventModCost(object ob, string type, mixed val);

int eventModMoney(object ob, string type, mixed val) {
  string junk1;
  int amount, npc;
  mapping NewMap;

  TmpMap = ([]);
  NewMap = ([]);
  LoadMap = ([]);
  money_globalstr = "";
  money_globalstr2 = "";
  money_globalstr3 = "";


  if (inherits(LIB_NPC, ob)) npc = 1;

  if (!intp(val)) sscanf(val, "%s %d", junk1, amount);
  if (amount) val = amount;
  else val = 0;
  amount = 0;

  money_globalstr3 = base_name(ob) + ".lpc";
  money_globalstr = generate_tmp(ob);
  unguarded((: cp(money_globalstr3, money_globalstr) :));
  if (!check_privs(this_player(), money_globalstr3)) {
    write("You do not appear to have write access to this file. Modification aborted.");
    return 1;
  }
  if (npc) {
    unguarded((: TmpMap = this_object()->eventMappifyLine(money_globalstr, "SetCurrency") :));
    LoadMap = this_object()->eventParsePair(money_globalstr, "AddCurrency", "string", "literal");
    foreach (string foo, mixed bar in LoadMap) if (stringp(bar)) LoadMap[foo] = amount;
    unguarded((: money_globaltmp = remove_matching_line(money_globalstr, "AddCurrency", 1) :));
    unguarded((: money_globaltmp = remove_matching_line(money_globaltmp, "SetCurrency", 1) :));
    money_globalstr2 = "SetCurrency( ";
    NewMap = add_maps(LoadMap, TmpMap);
  }

  else {
    unguarded((: TmpMap = this_object()->eventMappifyLine(money_globalstr, "SetMoney") :));
    LoadMap = this_object()->eventParsePair(money_globalstr, "AddMoney", "string", "literal");
    foreach (string foo, mixed bar in LoadMap) if (stringp(bar)) LoadMap[foo] = amount;
    unguarded((: money_globaltmp = remove_matching_line(money_globalstr, "AddMoney", 1) :));
    unguarded((: money_globaltmp = remove_matching_line(money_globaltmp, "SetMoney", 1) :));
    money_globalstr2 = "SetMoney( ";
    NewMap = add_maps(copy(LoadMap), copy(TmpMap));
  }

  if (stringp(val)) val = amount;
  NewMap[type] = val;
  money_globalstr2 += this_object()->eventStringifyMap(NewMap) + " );";
  money_globaltmp = this_object()->eventAppend(
    read_file(money_globaltmp),
    ({ "SetItems", "SetInventory", "SetLong" }),
    "\n" + money_globalstr2 + "\n"
  );
  unguarded((: write_file(money_globalstr, money_globaltmp, 1) :));
  this_object()->eventGeneralStuff(money_globalstr);
  unguarded((: cp(money_globalstr, money_globalstr3) :));
  unguarded((: rm(money_globalstr) :));
  reload(ob);
  return 1;
}

int eventModCost(object ob, string type, mixed val) {
  string new_line, junk;
  int amount;

  if (stringp(val)) sscanf(val, "%s %d", junk, amount);
  else amount = val;
  money_globalstr = base_name(ob) + ".lpc";
  if (!check_privs(this_player(), money_globalstr)) {
    write("You do not appear to have write access to this file. Modification aborted.");
    return 1;
  }

  unguarded((: money_globalstr2 = read_file(money_globalstr) :));

  money_globalstr2 = remove_matching_line(money_globalstr2, "SetBaseCost", 1);
  money_globalstr2 = remove_matching_line(money_globalstr2, "SetDollarCost", 1);
  money_globalstr2 = remove_matching_line(money_globalstr2, "SetCost", 1);
  money_globalstr2 = remove_matching_line(money_globalstr2, "SetValue", 1);

  if (!type) type = "silver";

  new_line = "SetBaseCost(\"" + type + "\", " + amount + ");";
  money_globalstr2 = this_object()->eventAppend(
    money_globalstr2,
    ({ "SetMass", "SetItems", "SetLong", "SetInventory", "SetVendorType" }),
    "\n" + new_line + "\n"
  );

  unguarded((: write_file(money_globalstr, money_globalstr2, 1) :));

  this_object()->eventGeneralStuff(money_globalstr);
  reload(ob);


  return 1;
}
