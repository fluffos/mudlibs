#include <lib.h>
inherit LIB_SIT;
inherit LIB_SURFACE;

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are what
 * LIB_BASE_DUMMY adds to an item that anything here uses (its knock, scratch and enter verbs only ever
 * refused).  Inheriting it next to the item classes gave the object two copies of everything they share. */
int isDummy() { return 1; }

/* sit and surface both define CanGet(); the driver kept surface's, which ignores the sitters.  Ask sit first,
 * as LIB_CHAIR does. */
int CanGet(object who) {
  if (sit::CanGet(who)) return surface::CanGet(who);
  return 0;
}

protected void create() {
  surface::create();
  SetNoSink(1);
  SetKeyName("stool");
  SetId("stool");
  SetAdjectives("wooden");
  SetShort("a small plain stool");
  SetLong("This is a simple stool that someone may sit upon to play an instrument.");
  SetMaxSitters(1);
  SetInvis(1);
  SetPreventGet("The stool does not budge.");
}

void init() {
  ::init();
}
