#include <lib.h>

inherit LIB_STORAGE;

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are what
 * LIB_BASE_DUMMY adds to an item that anything here uses (its knock, scratch and enter verbs only ever
 * refused).  Inheriting it next to the item classes gave the object two copies of everything they share. */
int isDummy() { return 1; }

void create() {
  storage::create();
  SetNoSink(1);
  SetInvis(1);
  SetKeyName("cabinet");
  SetId(({ "cabinet" }));
  SetShort("cabinet");
  SetLong("Through the glass doors you can see some trinkets sitting on "
    "three wooden shelves. The middle shelf has a small cloth doll sitting "
    "against the back of the cabinet.");
  SetCanClose(1);
  SetClosed(1);
  SetCanLock(1);
  SetLocked(1);
}

mixed CanGet(object ob) { return "The cabinet is very heavy and affixed to the back wall."; }
