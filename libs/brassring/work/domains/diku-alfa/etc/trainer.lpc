#include <lib.h>

/* modified by Lash for inclusion of modified base_trainer.c */
inherit "/domains/diku-alfa/etc/base_trainer.lpc";
/* end mod */
inherit LIB_SENTIENT;

protected void create() {
  base_trainer::create();
  sentient::create();
}

/* base_trainer and sentient both define init(); the driver kept sentient's, so the student record that
 * base_trainer's init() clears when a pupil comes back never was. */
void init() {
  sentient::init();
  base_trainer::init();
}
