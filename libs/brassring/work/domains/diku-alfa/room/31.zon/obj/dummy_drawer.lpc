#include <lib.h>

inherit LIB_STORAGE;

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are what
 * LIB_BASE_DUMMY adds to an item that anything here uses (its knock, scratch and enter verbs only ever
 * refused).  Inheriting it next to the item classes gave the object two copies of everything they share. */
int isDummy() { return 1; }

void create() {
  storage::create();
  SetNoSink(1);
  SetInvis(1);
  SetKeyName("drawer");
  SetId(({ "drawer" }));
  SetShort("drawer");
  SetLong("You notice a keyhole in the drawer.");
  //SetItems( ([
  //    "drawer" : "You notice a keyhole in the drawer.",
  //  ]) ),
  SetMass(1000);
  //SetBaseCost();
  SetMaxCarry(500);
  //SetPreventPut("You cannot put this in there!");
  SetInventory(([
    "/domains/diku-alfa/room/31.zon/obj/key_3123": 1,
  ]));
  SetCanClose(1);
  SetClosed(1);
  SetCanLock(1);
  SetLocked(1);
  SetKey("key_3122");
}
mixed CanGet(object ob) { return "You can't take that"; }
