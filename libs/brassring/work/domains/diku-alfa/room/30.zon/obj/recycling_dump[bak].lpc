#include <lib.h>

inherit LIB_STORAGE;

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are what
 * LIB_BASE_DUMMY adds to an item that anything here uses (its knock, scratch and enter verbs only ever
 * refused).  Inheriting it next to the item classes gave the object two copies of everything they share. */
int isDummy() { return 1; }

protected void create() {
  storage::create();
  SetNoSink(1);
  SetInvis(1);

  SetKeyName("Dump");
  SetId(({ "can", "container" }));
  SetAdjectives("trash");
  SetShort("the recycling dump");
  SetLong("A place to discard your trash.");
  SetMass(1500);
  SetMaxCarry(999999);
  SetPreventGet("You can't take that");
}

int tidy_up() {
  object *inv;
  inv = all_inventory(this_object());
  foreach (object thing in inv) {
    if (thing) thing->eventMove(load_object("/domains/diku-alfa/room/furnace"));
  }
  return 1;
}

int eventReceiveObject(object ob) {
  write("The item vanishes in a puff of smoke.\n");
  call_out((: tidy_up :), 1);
  return 0;
}

//mixed CanGet(object ob) { return "You can't take that";}

void init() {}
