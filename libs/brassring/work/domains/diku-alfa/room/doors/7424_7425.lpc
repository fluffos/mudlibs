#include <lib.h>

inherit LIB_DOOR;

nosave void create() {
  door::create();

  SetSide("east", ([ "id": ({ "green", "head", "dragon", "sculpture", "face" }),
    "short": "a door leading east",
    "long": "This is the west side of a door leading east.",
    "lockable": 0 ]));

  SetSide("west", ([ "id": ({ "door leading east", "door", "west door" }),
    "short": "a  door leading west",
    "long": "This is the east side of a door leading west.",
    "lockable": 0 ]));

  SetClosed(1);
  SetLocked(0);
}

void init() {
  ::init();
}
