#include <lib.h>

inherit LIB_DOOR;

nosave void create() {
  door::create();

  SetSide("south", ([ "id": ({ "door leading south", "door", "south door", "steel" }),
    "short": "a heavy steel door leading south",
    "long": "This is the north side of a heavy steel door leading south.",
    "lockable": 1 ]));

  SetSide("north", ([ "id": ({ "door leading north", "door", "north door" }),
    "short": "a heavy steel door leading north",
    "long": "This is the south side of a heavy steel door leading north.",
    "lockable": 1 ]));

  SetClosed(1);
  SetLocked(1);
  SetKeys("south", ({ "key_3137" }));
  SetKeys("north", ({ "key_3137" }));
}

void init() {
  ::init();
}
