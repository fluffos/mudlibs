#include <lib.h>

inherit LIB_ROOM;

void create() {
  ::create();
  SetProperty("light", -2);
  SetProperty("indoors", 1);
  SetProperty("no teleport", 1);
  SetProperty("no castle", 1);
  SetShort("Deep inside a tunnel underneath the mountains");
  SetLong(
    "The tunnel of goblins comes to an end here, deep inside "
    "the evil Daroq Mountains.");
  SetExits(([ "up": "/domains/Praxis/mountains/tunnel2" ]));
}

string ball();
void reset() {
  ::reset();
  SetSearch("default", (: ball :));
  SetSearch("tunnel", (: ball :));
}

string ball() {
  object ob;

  RemoveSearch("default");
  RemoveSearch("tunnel");
  ob = new("/domains/Praxis/obj/magic/ball");
  if (!ob->eventMove(this_player())) {
    ob->eventMove(this_object());
    return "You find a crystal ball.\nYou drop the crystal ball!";
  }
  return "You find a crystal ball.";
}
