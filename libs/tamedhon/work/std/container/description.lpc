inherit "/std/thing/description";

#pragma strong_types

#define NEED_PROTOTYPES

#include <container.h>
#include <properties.h>
#include <defines.h>
#include <wizlevels.h>
#include <wizard.h>
#include <vt100.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <regexp.h>
#include <player/mslp.h>

void create()
{
  description::create();
  if (!clonep(this_object())) return;
  SetProp(P_TRANSPARENT, 1);
  AddId("Container");
}

varargs string long() {
  string descr, inv_descr;

  descr = process_string(QueryProp(P_LONG));
  if(!QueryProp(P_TRANSPARENT)) return descr;

  inv_descr = make_invlist(PL, all_inventory(ME), 0);
  if ( inv_descr != "" )
    descr += capitalize(QueryPronoun()) + " enthält:\n" + inv_descr;
  return descr;
}

object vwr;

#define FT_NPC  1
#define FT_PLR  2
#define FT_ARM  3
#define FT_WPN  4

string wiz_hdr(mixed obj)
{
  string descr, ter, fnam, nc, sc, tc, cc,
         lvc, mvc, mmvc, hpc, mhpc, spc, mspc, coff, *fn;
  int fs, mlev, ftype;

  if (!vwr && !objectp(vwr))
    return object_name(obj);
  mlev=vwr->QueryProp(P_WANTS_TO_LEARN);
  descr="";
  switch (vwr->QueryProp(P_TTY)) {
    case "vt100":
    case "ansi": coff=VT_TA_AO; hpc=VT_GREEN; sc=VT_TA_B+VT_BLUE;
                 tc=spc=VT_BLUE; mhpc=mspc=mmvc=VT_TA_B+VT_RED; nc=VT_GREEN;
                 cc=mvc=VT_CYAN; lvc=VT_TA_B+VT_GREEN; break;
    default: coff=nc=sc=tc=mvc=mmvc=lvc=spc=mspc=hpc=mhpc=cc="";
  }
  if (obj->id("NPC"))
    ftype=FT_NPC;
  else
    if (obj->id("Spieler"))
      ftype=FT_PLR;
    else
      if (obj->QueryProp(P_WC))
        ftype=FT_WPN;
      else
        if (obj->QueryProp(P_AC))
          ftype=FT_ARM;
  if (mlev&RH_NFNHDR)
    descr+=sprintf("%s%s%s:", tc,
        (ftype==FT_NPC?"NPC":(ftype==FT_PLR?"PLR":
        (ftype==FT_WPN?"Wpn":(ftype==FT_ARM?"Arm":"??")))), coff);
  fnam=object_name(obj);
  fn=explode(fnam, "/");
  descr+=nc;
  if (mlev&RH_NFILENAME && sizeof(fn)) {
    switch (fn[0]) {
      case "players": descr+="~"+fn[1]+"/";
                      if (sizeof(fn)>3)
                        descr+=".../";
                      descr+=fn[<1]; break;
      case "d": descr+="+"+capitalize(fn[1][0..1])+"/"+fn[2]+"/.../"+fn[<1]; break;
      default: descr+="/"+implode(fn, "/");
    }
  }
  else
    descr+=fnam;
  descr+=coff;
  if (mlev&RH_SIZE && ftype!=FT_PLR) {
    fs=file_size(explode(fnam, "#")[0]+".lpc");
    descr+=sprintf("|sz:%s%s%s", sc, (fs<1024?(string)fs:((string)(fs/1024)+"k")), coff);
  }
  switch(ftype) {
    case FT_NPC: if (mlev&RH_NPC_LVL)
                   descr+=sprintf("|lv:%s%d%s", lvc, obj->QueryProp(P_LEVEL), coff);
                 if (mlev&RH_NPC_HP)
                   descr+=sprintf("|hp:%s%d%s(%s%d%s)", hpc, obj->QueryProp(P_HP),
                          coff, mhpc, obj->QueryProp(P_MAX_HP), coff);
                 if (mlev&RH_NPC_SP)
                   descr+=sprintf("|sp:%s%d%s(%s%d%s)", spc, obj->QueryProp(P_SP),
                          coff, mspc, obj->QueryProp(P_MAX_SP), coff);
                 break;
    case FT_PLR: if (mlev&RH_NPC_LVL)
                   descr+=sprintf("|lv:%s%d%s", lvc, obj->QueryProp(P_LEVEL), coff);
                 if (mlev&RH_NPC_HP)
                   descr+=sprintf("|hp:%s%d%s(%s%d%s)", hpc, obj->QueryProp(P_HP),
                          coff, mhpc, obj->QueryProp(P_MAX_HP), coff);
                 if (mlev&RH_NPC_SP)
                   descr+=sprintf("|sp:%s%d%s(%s%d%s)", spc, obj->QueryProp(P_SP),
                          coff, mspc, obj->QueryProp(P_MAX_SP), coff);
                 if (mlev&RH_PLR_MV)
                   descr+=sprintf("|mv:%s%d%s(%s%d%s)", mvc, obj->QueryProp(P_MV),
                          coff, mmvc, obj->QueryProp(P_MAX_MV), coff);
                 break;
  }
/*  if (mlev&RH_CLONER)
    descr+=sprintf("|cl:%s%s%s", cc, obj->QueryProp(P_CLONER), coff); */

  return descr;
}

string getId(object ob)
{
  foreach(string id:ob->QueryProp(P_IDS))
  {
    if(id && id != "" && strstr(id,"\n") == -1)
    {
      if(pointerp(ob->QueryProp(P_NAME)))
      {
        foreach(string pname:ob->QueryProp(P_NAME))
          if(lower_case(explode(pname," ")[sizeof(explode(pname," "))-1]) == id || lower_case(explode(pname," ")[0]) == id)
            return id;
      }
      else if(stringp(ob->QueryProp(P_NAME)))
      {
        if(lower_case(explode(ob->QueryProp(P_NAME)," ")[sizeof(explode(ob->QueryProp(P_NAME)," "))-1]) == id || lower_case(explode(ob->QueryProp(P_NAME)," ")[0]) == id)
          return id;
      }

      if(strstr(lower_case(ob->QueryProp(P_SHORT)),id) != -1)
        return id;
    }
  }

  foreach(string* uids:ob->QueryProp("u_ids"))
  {
    foreach(string uid:uids)
    {
      if(pointerp(ob->QueryProp(P_NAME)))
      {
        foreach(string pname:ob->QueryProp(P_NAME))
          if(lower_case(explode(pname," ")[sizeof(explode(pname," "))-1]) == uid || lower_case(explode(pname," ")[0]) == uid)
            return uid;
      }
      else if(stringp(ob->QueryProp(P_NAME)))
      {
        if(lower_case(explode(ob->QueryProp(P_NAME)," ")[sizeof(explode(ob->QueryProp(P_NAME)," "))-1]) == uid || lower_case(explode(ob->QueryProp(P_NAME)," ")[0]) == uid)
          return uid;
      }

      if(strstr(lower_case(ob->QueryProp(P_SHORT)),uid) != -1)
        return uid;
    }
  }

  return 0;
}

// flags: 1 - wizard, 2 - don't collect equal objects '
private void stringenize(mixed obj, int flags, mixed objs, mixed info)
{
  string id, tmp;
  int idx;
  float weight;
  string weight_unit = "g";
  string mslp_temp;

  if(obj->id("\ncoloritem"))
    tmp = capitalize(obj->Query(P_NAME)[sizeof(obj->Query(P_NAME))-1]||"");
  else
    tmp = capitalize(obj->short()||"");
  if(sizeof(tmp)==0) { return; }
  if(tmp[<1]=='\n')
    tmp=tmp[0..<2]; // Nur '\n' abschneiden, CAP(ANSI-str) verschluckt das

  mslp_temp = tmp;

  if(objectp(this_player()) && previous_object()->id("Raum"))
  {
    if(obj->id("\ncoloritem"))
    {
      string tmp_short = obj->short();
      if(tmp_short[<1]=='\n')
        tmp_short=tmp_short[0..<2];
      tmp = regreplace(tmp,"(\\<"+mslp_temp+"\\>)",(: this_player()->mslp_link(tmp_short,"unt "+lower_case(obj->Query(P_NAME)[sizeof(obj->Query(P_NAME))-1])+" in raum") :),RE_GLOBAL);
    }
    else
      tmp = regreplace(tmp,"(\\<"+mslp_temp+"\\>)",(: this_player()->mslp_link($1,"unt "+getId(obj)+" in raum") :),RE_GLOBAL);
  }
  else
    tmp = sprintf("%-50s",tmp);

  if(previous_object()->id("Raum") && interactive(obj))
    if(obj->is_afk())
      tmp+=ANSI_LYELLOW+" (abwesend)"+ANSI_NORMAL;

  if(obj->QueryProp(P_WEIGHT) && !obj->id("Container"))
    weight = to_float(obj->QueryProp(P_WEIGHT));
  else if(obj->QueryProp(P_TOTAL_WEIGHT))
    weight = to_float(obj->QueryProp(P_TOTAL_WEIGHT));

    if(interactive(this_object()))
    {
      if(member(this_object()->QueryProp(P_ARMOURS),obj) != -1)
        tmp = ANSI_LCYAN + tmp + ANSI_NORMAL;

      if(this_object()->QueryProp(P_WEAPON))
        if(strstr(object_name(this_object()->QueryProp(P_WEAPON)),object_name(obj)) != -1)
          tmp = ANSI_LRED + tmp + ANSI_NORMAL;
    }
    else if(previous_object()->id("NPC"))
    {
      if(member(previous_object()->QueryProp(P_ARMOURS),obj) != -1)
        tmp = ANSI_LCYAN + tmp + ANSI_NORMAL;

      if(previous_object()->QueryProp(P_WEAPON))
        if(strstr(object_name(previous_object()->QueryProp(P_WEAPON)),object_name(obj)) != -1)
          tmp = ANSI_LRED + tmp + ANSI_NORMAL;
    }

  if(weight >=1000)
  {
    weight /= 1000;
    weight_unit = "kg";
  }

  if(!previous_object()->id("Raum") && !previous_object()->id("NPC"))
    weight_unit=="kg"?tmp+=sprintf("%-10s %s",(obj->QueryProp(P_KEEP_ON_SELL) == geteuid(this_object())?"(behalten)":""),implode(explode(sprintf("%s%s",(weight>0?sprintf("(%.1f",weight):""),(weight>0?weight_unit+")":"")),"."),",")):tmp+=sprintf("%-10s %s",(obj->QueryProp(P_KEEP_ON_SELL) == geteuid(this_object())?"(behalten)":""),implode(explode(sprintf("%s%s",(weight>0?sprintf("(%.0f",weight):""),(weight>0?weight_unit+")":"")),"."),","));
  
  if(interactive(this_object()))
  {
    if(obj->QueryProp(P_AC))
      tmp+=sprintf(ANSI_LYELLOW+"\n    RK: %d%s"+ANSI_NORMAL,obj->QueryProp(P_AC),obj->QueryProp(P_DEFEND_FUNC)?"+":"");

    if(obj->QueryProp(P_WC))
      tmp+=sprintf(ANSI_RED+"\n    WK: %d%s"+ANSI_NORMAL,obj->QueryProp(P_WC),obj->QueryProp(P_HIT_FUNC)?"+":"");
  }

  tmp=tmp + (flags & 1 ? "\n["+wiz_hdr(obj)+"]" : "");
  if(flags & 3 || living(obj)) id = object_name(obj);
  else
    id = explode(object_name(obj), "#")[0] + tmp;
  if((idx = member(objs, id)) == -1)
  {
    objs += ({ id });
    info += ({ ({ tmp, 1, obj}) });
  }
  else
    info[idx][1]++;
}

private string collect(mixed obj)
{
  if(!sizeof(obj[0])) return 0;
  return obj[0] + (obj[1] > 1 ? " ("+obj[1]+")" : "");
}

// flags: 1 - return array, 2 - don't collect equal objects '
varargs string make_invlist(object viewer, mixed inv, int flags)
{
  int max, iswiz, col;
  mixed objs, info;
  string descr;

  // !!x, damit iswiz in jedem Fall 0 oder 1 ist und nichts anderes.
  vwr=viewer;
  iswiz = IS_LEARNER( viewer ) && !!viewer->QueryProp(P_WANTS_TO_LEARN);
  descr = ""; objs = ({}); info = ({});
  map(inv, #'stringenize/*'*/, iswiz | (flags & 2), &objs, &info);
  if(flags & 1) return info;
  inv = map(info, #'collect/*'*/) - ({ 0 });
  if(!sizeof(inv)) return "";
#ifdef DEBUG
  if(!viewer)
    if (find_player("woody"))
      tell_object(find_player("woody"), sprintf(
      "*** std/container/description.c::make_invlist() :\n"
      "    no viewer! TP: %O, PO: %O, PO(1): %O\n",
      this_player(), previous_object(), previous_object(1)));
#endif
  if ((col=(viewer?viewer->QueryProp(P_COLUMN_MODE):0)) == 2)
    col = sizeof(inv) > 6;
  if(objectp(this_player()) && this_object()->id("Raum") && this_player()->QueryProp(P_TTY_MTTS_MASK) & MTTS_MSLP)
    return sprintf("%"+(col ? "#" : "=")+"-90s", implode(inv, "\n")) + "\n";
  else
    return sprintf("%"+(col ? "#" : "=")+"-78s", implode(inv, "\n")) + "\n";
}
