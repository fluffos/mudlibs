#include <properties.h>
#include <wizlevels.h>
#include <moving.h>
#include <regexp.h>

#define ME		this_player()

inherit "/std/shells/magier";

/* ------------------------------------------------------------- */
nosave int cmd_go_home() 
{
  if (!QueryProp(P_WANTS_TO_LEARN))
    return 0;
  return move("players/" + getuid() + "/workroom", 
                   M_GO, "nach Hause");
}


nosave int cmd_shut_down_game(string str)
{
  if (!IS_ARCH(ME) || ME!=this_interactive()) { return 0; }
  _notify_fail("Du musst einen Grund dafür angeben.\n");
  if (!str) return 0;
  shutdown(str);
  return 1;
}

nosave int cmd_add_domain_master(string str)
{
  string master, domain;

  if (this_object() != this_interactive() || 
      query_wiz_level(this_interactive())<60)
  {
    write("Das darfst Du nicht !\n");
    return 1;
  }
  _notify_fail("Syntax: addmaster <user> <domain>\n");
  if (!str) return 0;
  if (sscanf(str,"%s %s",master,domain)!=2) return 0;
  if (!master || !domain) return 0;
  if (!"/secure/master"->add_domain_master(master,domain))
    write("Hat nicht funktioniert.\n");
  else 
    write("Ok.\n");
  return 1;
}

nosave int cmd_remove_domain_master(string str)
{
  string master, domain;

  if (this_object() != this_interactive() || 
      query_wiz_level(this_interactive())<60)
  {
    write("Das darfst Du nicht !\n");
    return 1;
  }
  _notify_fail("Syntax: removemaster <user> <domain>\n");
  if (!str) return 0;
  if (sscanf(str,"%s %s",master,domain)!=2) return 0;
  if (!master || !domain) return 0;
  if (!"/secure/master"->remove_domain_master(master,domain))
    write("Hat nicht funktioniert.\n");
  else
    write("Ok.\n");
  return 1;
}

int cmd_mbanish(string str)
{
  string grund, name;

  _notify_fail("Syntax: mbanish <name> [<grund>]\n");

  if (!str || str=="")
    return 0;
  if (sscanf(str,"%s %s",name,grund)!=2) name=str;
  if (!name || name =="")
    return 0;
  "/secure/merlin"->MBanishInsert(lower_case(name), capitalize(grund),
      this_interactive());
  return 1;
}

int cmd_ipban(string str)
{
  string grund, ip;

  if (!str) {
    write("Syntax: ipban <ip> <grund>\n");
    return 1;
  }
  str = this_interactive()->_unparsed_args();

  if (sscanf(str,"%s %s",ip,grund)!=2) ip=str;
  if (!ip || ip =="")
  {
    write("Syntax: ipban <ip> <grund>\n");
    return 1;
  }

  if(!regmatch(ip, "^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$", RE_PCRE) && !regmatch(ip, "^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))$", RE_PCRE))
  {
    write("Keine gültige IP!\n");
    return 1;
  }

  if( !grund )
  {
    write("Du musst einen Grund angeben! Syntax: ipban <ip> <grund>\n\n");
    return 1;
  }
  "/secure/master"->IPBan(ip,capitalize(grund));
  return 1;
}

int cmd_ipunban(string str)
{
  string ip;

  if (!str) {
    write("Syntax: ipunban <ip>\n");
    return 1;
  }
  str = this_interactive()->_unparsed_args();

  if (sscanf(str,"%s",ip) != 1) ip=str;
  if (!ip || ip =="") {
    write("Syntax: ipunban <ip>\n");
    return 1;
  }
  if(!regmatch(ip, "^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$", RE_PCRE) && !regmatch(ip, "^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))$", RE_PCRE))
  {
    write("Keine gültige IP!\n");
    return 1;
  }
  if(!"/secure/master"->QueryIPBan(ip))
  {
    write("IP nicht vorhanden!\n");
    return 1;
  }
  "/secure/master"->IPUnban(ip);
  return 1;
}

// ------------
nosave mixed *_query_localcmds()
{
  return
	magier::_query_localcmds()+
	({
		({"home", "cmd_go_home", 0, WIZARD_LVL }),
		({"shutdown", "cmd_shut_down_game", 0, ARCH_LVL }),
		({"addmaster", "cmd_add_domain_master", 0, ARCH_LVL }),
		({"removemaster", "cmd_remove_domain_master", 0, ARCH_LVL }),
    ({"mbanish", "cmd_mbanish", 0, ARCH_LVL }),
    ({"ipban", "cmd_ipban", 0, ARCH_LVL }),
		({"ipunban", "cmd_ipunban", 0, ARCH_LVL })
	});
}

/* ------------------------------------------------------------- */
void create()
{
  magier::create();
}
