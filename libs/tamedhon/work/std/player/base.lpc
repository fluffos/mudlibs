    write("Du plünderst jetzt keine Leichen mehr aus.\n");
    SetProp(P_LOOTING, 0);
  }
  else
  {
    write("Du plünderst zur Zeit "+( QueryProp(P_LOOTING) ? "alle" : "keine" )+
         " Leichen aus.\n");
    write("Umschalten mit 'plündern <ein|aus>.\n");
  }
  return 1;
}

