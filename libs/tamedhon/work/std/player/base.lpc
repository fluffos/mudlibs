}

private int set_keep_alive(string str) {
  if (str == "ein") {
    telnet_tm_counter = QueryProp(P_TELNET_KEEPALIVE_DELAY) || (240 / __HEART_BEAT_INTERVAL__);
    tell_object(this_object(), break_string( sprintf(
        "An Deinen Client werden jetzt alle %i Sekunden unsichtbare Daten "
        "geschickt, um zu verhindern, dass Deine Verbindung zum "MUDNAME
        " beendet wird.",
        telnet_tm_counter*__HEART_BEAT_INTERVAL__), 78));
    // Bei Magiern ist der HB evtl. ausgeschaltet und muss eingeschaltet
    // werden.
    if (!object_info(this_object(), OC_HEART_BEAT))
      configure_object(this_object(), OC_HEART_BEAT, 1);
  }
  else if (str == "aus") {
    telnet_tm_counter = 0;
    tell_object(this_object(),break_string(
        "Du hast das Senden von unsichtbaren Daten (Keep-Alive-Pakete) an "
        "Deinen Client ausgeschaltet.",78));
  }
  else {
    if (!telnet_tm_counter)
      tell_object(this_object(), break_string(
        "An Deinen Client werden keine Keep-Alive-Pakete geschickt.",78));
    else
    {
      tell_object(this_object(), break_string(
        "An Deinen Client werden alle " 
        + QueryProp(P_TELNET_KEEPALIVE_DELAY) * __HEART_BEAT_INTERVAL__
        + " Sekunden unsichtbare Daten geschickt, damit Deine Verbindung "
        "zum "MUDNAME" nicht beendet wird.",78));
    }
  }
  return 1;
}

private int print_telnet_rttime() {
  int rtt = QueryProp(P_TELNET_RTTIME);
  if (rtt>0)
    tell_object(ME, break_string(
      "Die letzte gemessene 'round-trip' Zeit vom Tamedhon zu Deinem Client "
      "und zurück betrug " + rtt + " us.",78));
  else
    tell_object(ME, break_string(
      "Bislang wurde die 'round-trip' Zeit vom Tamedhon zu Deinem Client "
      "noch nicht gemessen oder Dein Client unterstützt dieses "
      "nicht.",78));
  return 1;
}

int telnet_cmd(string str) {
  if (!str) return 0;
  string *args = explode(str, " ");
  string newargs;
  if (sizeof(args) > 1)
    newargs = implode(args[1..], " ");
  else
    newargs = "";

  switch(args[0])
  {
    case "keepalive":
      return set_keep_alive(newargs);
    case "rttime":
      return print_telnet_rttime();
    case "tls":
#if __EFUN_DEFINED__(tls_query_connection_state)
      if (tls_query_connection_state(ME) > 0)
        tell_object(ME,
            "Deine Verbindung zum "+ MUDNAME +" ist TLS-verschlüsselt.\n");
      else
#endif
        tell_object(ME,
            "Deine Verbindung zum "+ MUDNAME +" ist nicht verschlüsselt.\n");
      return 1;
    case "client-gui":
    case "gui":
      if(newargs == "" && QueryProp(P_TTY_TYPE))
          newargs=QueryProp(P_TTY_TYPE)[0];
      GMCP_offer_clientgui(newargs);
      return 1;
  }
  return 0;
}

string format_bytes(int size) {
    float value = to_float(size);
    string unit = "Bytes";

    if (size >= 1073741824) { // 1 GB
        value = size / 1073741824.0;
        unit = "GB";
    }
    else if (size >= 1048576) { // 1 MB
        value = size / 1048576.0;
        unit = "MB";
    }
    else if (size >= 1024) { // 1 KB
        value = size / 1024.0;
        unit = "KB";
    }

    return sprintf("%.2f %s", value, unit);
}

int show_telnegs(string arg)
{
    string terminfo = "";
    string *mtts = ({});
    string *tty_types;
    int mtts_mask = 0;
    string newenv_string = "";
    mapping newenv = ([]);

    if (!arg)
    {
        write("Du bekommst Änderungen Deiner Fenstergröße "+
              (QueryProp(P_TTY_SHOW)?"":"nicht ")+"angezeigt.\n\n");
#if __EFUN_DEFINED__(tls_query_connection_state)
      if (tls_query_connection_state(ME) > 0)
        write("Deine Verbindung zum "+ MUDNAME +" ist TLS-verschlüsselt.\n\n");
      else
#endif
        write("Deine Verbindung zum "+ MUDNAME +" ist nicht verschlüsselt.\n\n");

#if __MCCP__
      string mccpv;
      int *mccpstats=query_mccp_stats();
      switch(query_mccp(ME))
      {
        case TELOPT_COMPRESS:
        {
          mccpv="MCCP V1";
          break;
        }
        case TELOPT_COMPRESS2:
        {
          mccpv="MCCP V2";
          break;
        }
        default:
        {
          mccpv="nicht MCCP";
          break;
        }
      }
      write("Deine Verbindung zum "+ MUDNAME +" ist " + mccpv + " komprimiert.\n");
      if(mccpstats)
      {
        write("Unkomprimierte Bytes: "+format_bytes(mccpstats[0])+"\n");
        write("Komprimierte Bytes: "+format_bytes(mccpstats[1])+"\n\n");
      }
#endif

        if(ME->GMCP_Status())
          write("GMCP aktiv.\n\n");
        else
          write("GMCP inaktiv.\n\n");


        tty_types = QueryProp(P_TTY_TYPE);

        for(int i=0;i<sizeof(tty_types);i++)
        {
          if(strstr(tty_types[i],"mtts")==-1)
          {
            terminfo+=tty_types[i];
            if(i<sizeof(tty_types)-2 && strstr(tty_types[i],"mtts")==-1)
              terminfo+=", ";
          }
        }

        if(!tty_types || strstr(tty_types[0],"mtts")!=-1)
          terminfo="N/A";
        else
          terminfo=implode(tty_types,", ");

        mtts_mask = QueryProp(P_TTY_MTTS_MASK);

        if(mtts_mask & MTTS_ANSI)
          mtts += ({"ANSI"});

        if(mtts_mask & MTTS_VT100)
          mtts += ({"VT100"});

        if(mtts_mask & MTTS_UTF8)
          mtts += ({"UTF-8"});

        if(mtts_mask & MTTS_256_COLORS)
          mtts += ({"256 COLORS"});

        if(mtts_mask & MTTS_MOUSE_TRACKING)
          mtts += ({"MOUSE TRACKING"});

        if(mtts_mask & MTTS_OSC_COLOR_PALETTE)
          mtts += ({"OSC COLOR PALETTE"});

        if(mtts_mask & MTTS_SCREEN_READER)
          mtts += ({"SCREENREADER"});

        if(mtts_mask & MTTS_PROXY)
          mtts += ({"PROXY"});

        if(mtts_mask & MTTS_TRUECOLOR)
          mtts += ({"TRUECOLOR"});

        if(mtts_mask & MTTS_MNES)
          mtts += ({"MNES"});

        if(mtts_mask & MTTS_MSLP)
          mtts += ({"MSLP"});

        if(mtts_mask & MTTS_SSL)
          mtts += ({"SSL"});

        if(!mtts_mask)
          mtts=({"N/A"});

        newenv = ({mapping})QueryProp(P_TTY_NEWENV);
  
        if(!sizeof(newenv))
          newenv_string="N/A";
        else
        {
          newenv_string=implode(map(m_indices(newenv), (: sprintf("%O:%O", $1, newenv[$1]) :)), ", ");
        }

        write("Terminal TTYPE: "+terminfo+"\n");
        write("Terminal MTTS: "+implode(mtts,", ")+"\n");
        write("Terminal NEW-ENVIRON: "+implode(explode(newenv_string,"\""),"")+"\n");
        write("Terminalspalten: "+QueryProp(P_TTY_COLS)+"\n");
        write("Terminalzeilen: "+QueryProp(P_TTY_ROWS)+"\n\n");

        write("Syntax: telnegs [ein|aus]\n");
        return 1;
    }
    if (member(({"ein","an","aus"}),arg)==-1)
    {
        write("Syntax: telnegs [ein|aus]\n");
        return 1;
    }
    if (arg=="ein" || arg=="an")
    {
        write("Du bekommst "+(QueryProp(P_TTY_SHOW)?"":"nun ")+
              "Änderungen Deiner Fenstergröße angezeigt.\n");
        Set(P_TTY_SHOW,1);
        return 1;
    }
    write("Du bekommst "+(QueryProp(P_TTY_SHOW)?"nun ":"")+
          "Änderungen Deiner Fenstergröße nicht "+
          (QueryProp(P_TTY_SHOW)?"mehr ":"")+"angezeigt.\n");
    Set(P_TTY_SHOW,0);
    return 1;
}

int set_avataruri(string arg) {
  arg = _unparsed_args(0);
  if (!arg || !sizeof(arg)) {
    string uri = QueryProp(P_AVATAR_URI);
    if (stringp(uri))
      tell_object(ME,
          "Aktuelle Avatar-URI: " + uri + "\n");
    else
      tell_object(ME, "Du hast keine Avatar-URI eingestellt.\n");
  }
  else if (arg == "keine") {
      SetProp(P_AVATAR_URI, 0);
      tell_object(ME, "Deine Avatar-URI wurde gelöscht.\n");
      log_file("/avatare", dtime(time())+"::"+query_real_name(ME)+": gelöscht\n");
  }
  else if (sizeof(arg) > 512)
      tell_object(ME, "Deine neue Avatar-URI ist zu lang!\n");
  else {
      SetProp(P_AVATAR_URI, arg);
      tell_object(ME,
          "Aktuelle Avatar-URI: " + arg + "\n");
      log_file("/avatare",  dtime(time())+"::"+query_real_name(ME)+": "+arg+"\n");
  }
  return 1;
}

