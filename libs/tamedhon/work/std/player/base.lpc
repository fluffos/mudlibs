    write("Lob abgebrochen...\n");
    return 1;
  }
 smart_log("LOB",str);
 return 1;
}

/* smart_log()
 * Reportmeldung analysieren,
 * Abfrage, ob Spieler die Meldung senden moechte
 */
nosave void smart_log(string myname, string str)
{
  string obnam, rest, feedback;
  object obj;

  if (sscanf(str,"%s:%s",obnam,rest)==2 &&
      ((obj=present(lower_case(obnam),environment())) ||
       (obj=present(lower_case(obnam))) ) &&
      obj != environment(this_interactive()))
    str = rest;
  else {
    obj = QueryProp(P_REFERENCE_OBJECT);
    if (!obj || !present(obj))
      obj = environment(this_interactive());
  }

  feedback=myname+"\n"+str+"\ngeht an ";
  if (obj->id("Raum"))
    feedback+="den Raum: "+obj->QueryProp(P_INT_SHORT);
  else feedback+=obj->name(WEN,2);
  write(feedback+".\nMöchtest Du das? ("+mslp_link("j")+"/"+mslp_link("n")+")\n");
  input_to("sendbugmsg", 0, myname, obj, str);
}

/* sendbugmsg()
 * Reportmeldung in repfile speichern
 * und Meldung an zustaendigen Magier
 */
nosave void sendbugmsg(string answ, string myname, object obj, string str)
{
  string creat, creat2, date, filext, filext2;
  string *strs;

  if (!answ || (answ != "j" && answ != "ja")) {
    write("Fehlermeldung verworfen.\n");
    return;
  }

  creat = MASTER->creator_file(obj);
  strs= MASTER->full_path_array(object_name(obj),0);
  if( strs[0]=="d" && myname!="EP" )
    creat2 = strs[1]+"/"+creat;
  if (creat == ROOTID)
    creat = "ROOT";
  else if( !creat || creat[0]==' ' )
    creat="STD";

  date = dtime(time())[5..<11];

  if(find_player(lowerstring(creat)))
    tell_object(find_player(lowerstring(creat)),
      "* Neue Meldung in Report-Datei: " + myname + " von "
      +capitalize(getuid(this_interactive())) + ".\n");

  switch(myname)
  {
    case "EP":     filext = ".ep";   break;
    case "DETAIL": filext = ".rep"; filext2 = ".det";  break;
    case "IDEA":   filext = ".rep"; filext2 = ".idea"; break;
    case "BUG":    filext = ".rep"; filext2 = ".bug";  break;
    case "TYPO":   filext = ".rep"; filext2 = ".typo"; break;
    case "LOB":    filext = ".rep"; filext2 = ".lob";  break;
    default:       filext = ".rep";  break;
  }
  creat = "report/" + creat + filext;
  // FP-Vorschlaege NICHT in Objekt-Logfiles
  if ((myname=="EP") || !obj->SmartLog(creat, myname, str, date)) {
    if(sizeof(strs) >= 4 && strs[1]=="seher" && strs[2]=="haeuser")
    {
      log_file( strs[0]+"/"+strs[1]+"/"+strs[2]+"/"+strs[3]+"/log/"+strs[3]+".rep", myname + " von " + capitalize(getuid(this_interactive()))
              + " [" + object_name(obj) + "] (" + date + "):\n" );
      log_file( strs[0]+"/"+strs[1]+"/"+strs[2]+"/"+strs[3]+"/log/"+strs[3]+".rep", str + "\n\n" );
    }
    else
    {
      log_file( creat, myname + " von " + capitalize(getuid(this_interactive()))
              + " [" + object_name(obj) + "] (" + date + "):\n" );
      log_file( creat, str + "\n\n" );
    }
    if(creat2)
    {
      if(sizeof(strs) >= 3 && strs[1]!="seher" && strs[2]!="haeuser")
      {
        creat2="report/"+creat2+filext2;
        log_file( creat2, capitalize(getuid(this_interactive()))
              + " [" + object_name(obj) + "] (" + date + "):\n" );
        log_file( creat2, str + "\n\n" );
      }
    }
  }
  write(myname+" wurde gespeichert.\nVielen Dank für Deine Hilfe!\n");
}

nosave int _quit()
{
  int arg;
  object *obs;

  Set(P_LAST_LOGOUT,time());
  log_file("LEAVE", ME->Name()+" "+dtime(time())+"\n");
  if( sscanf( getuid(), "gast%d", arg) != 1 )
  {
    write("Speichere "+QueryProp(P_NAME)+".\n");
    save_me(0);

    obs=deep_inventory(ME);
    for(int i=sizeof(obs)-1;i>=0;i--)
      obs[i]->remove(1);
  }
  catch(VOICEMASTER->RemoveUser(ME));
  if (environment()) {
    catch(environment()->PlayerQuit(ME));
    catch(map_objects(deep_inventory(ME)+all_inventory(environment()),
                      "PlayerQuit", ME));
  }
  if (catch(remove())) destruct(ME);
  return 1;
}

int quit()
{
  return _quit();
}

nosave int new_quit()
{
  mixed x;
  if (IS_LEARNING(ME)) return quit();
  if (environment() && (x=environment()->QueryProp(P_NOQUIT))) {
    if (stringp(x))
      write(x);
    else
      write("Es ist an diesem Ort nicht möglich, das Spiel zu verlassen.\n");
    return 1;
  }
  if (ME->EnemyPresent())  // && (time()-QueryProp(P_LAST_QUIT)<600))
  {
    write ("Du bereitest Dich"+
        (find_call_out("quit") != -1 ? " erneut" : "")+
        " auf den Ausstieg aus dem Spiel vor.\n");
    remove_call_out("quit");
    call_out("quit", 10);
    return 1;
  }
  if (QueryProp(P_NEXT_SPELL_TIME)+30 > time())
  {
    write ("Du bist noch zu erschöpft von Deinem letzten Zauberspruch.\n");
    return 1;
  }
  return quit();
}

// neues info von den schlachtenwütern angepasst portiert
// ======================================================

#define TITLE1 \
"  ________________________________________________________________________\n"\
" /                                                                      / \\\n"
#define TITLE2 \
" \\______________________________________________________________________\\  |\n"\
"  |                                |                  |                    |\n"

#define LINE1 \
"  +--------------------------------+---------------------------------------+\n"
#define LINE2 \
"  +------------------------------------------------------------------------+\n"
#define FOOTER \
"\\\n"\
"  \\________________________________________________________________________\\/\n"

/*
  Eigenes Schlachtenwueter - Info:
  ________________________________________________________________________
 /                                                                      / \
|    WerBrownie Tamtam  , das Kruemelchen von den ANDEREN.             |   |
 \______________________________________________________________________\  |
  |                                |                  |                    |
  |  SCHLACHTENWUETER              |  Gildenlevel:  2 | Spielerlevel:  21  |
  +--------------------------------+---------------------------------------+
  |  Erfahrungspunkte:    1008591  |  Stufe:          23 [#######...]  24  |
  |  Rasse:                Magier  |  WUT:             0 [..........] 100  |
  |  Abenteuerpunkte:  343 (   0)  |  Konzentration:  82 [##########]  82  |
  |  Attributpunkte:            4  |  Lebenspunkte:  154 [##########] 154  |
  +--------------------------------+---------------------------------------+
  |  Kraft:               15 (+0)  |  Geschicklichkeit:           18 (+0)  |
  |  Ausdauer:            14 (+0)  |  Intelligenz:                 5 (+0)  |
  +--------------------------------+---------------------------------------+
  |  Du schleppst schon sehr viel mit Dir herum.                           |
  |  Vorsicht-Modus:  15                                                   |
  |  Dein Charakter ist gemein.                                            |
  +------------------------------------------------------------------------+
  |  Verglichen mit Deinen Mitspielern, kennst Du Dich auf dieser Welt     |
  |  ziemlich gut aus. Absolut gesehen solltest Du Dich vielleicht noch    |
  |  genauer umsehen.                                                      |\
  \________________________________________________________________________\/
*/

nosave string hp_bar()
{
    string output = "";
    int hp = QueryProp(P_HP);
    int max_hp = QueryProp(P_MAX_HP);
    int wimpy = QueryProp(P_WIMPY);
    int bars = 10; // Anzahl Balken

    for(int i = 1; i <= bars; i++)
    {
        // HP-Grenzwert für diesen Balken
        int bar_min = (i - 1) * max_hp / bars;
        int bar_max = i * max_hp / bars;

        if(hp >= bar_max)
        {
            // Balken komplett gefüllt
            if(bar_min < wimpy)
                output += ANSI_LRED + "▓" + ANSI_NORMAL; // Hellrot für WIMPY-Anteil
            else
                output += ANSI_RED + "▓" + ANSI_NORMAL; // Normal rot
        }
        else if(hp > bar_min)
        {
            // Balken teilweise gefüllt
            if(bar_min < wimpy)
                output += ANSI_LRED + "▓" + ANSI_NORMAL;
            else
                output += ANSI_RED + "▓" + ANSI_NORMAL;
        }
    }

    return output;
}

nosave string check_seher()
{
  string output;
  string *conditions = ({});

  int my, avg;

  my=EPMASTER->QueryExplorationPoints(this_object());
  my *= 100;
  avg = (my+1) / (EPMASTER->QueryAverage()+1);


  output = "Dir fehlt zur Seherwerdung: ";

  conditions += QueryProp(P_LEVEL)<20?({to_string(20-QueryProp(P_LEVEL))+" Stufen"}):({""});
  conditions += QueryProp(P_XP)<1000000?({to_string(1000000-QueryProp(P_XP))+" Erfahrungspunkte"}):({""});
  conditions += QueryProp(P_QP)<QueryProp(P_NEEDED_QP)?({to_string(QueryProp(P_NEEDED_QP)-QueryProp(P_QP))+" Abenteuerpunkte"}):({""});
  conditions += avg<51?({"Du musst noch mehr forschen"}):({""});

  for(int i=0;i<sizeof(conditions);i++)
    if(conditions[i] != "")
    {
      if(i<sizeof(conditions)-1)
        output += conditions[i]+", ";
      else
        output += conditions[i]+".";
    }

  return output;
}

nosave mixed score_new(string arg)
{
  string ret;
  mixed ind;
  int level, n, lp;

  // Stufenanzeige bis 20% des folgenden Levels auf [##########] halten
  lp=QueryProp(P_LP);
  if (((lp/100) == (QueryProp(P_LEVEL)+1)) &&
      (lp%100 < 20))
    level = QueryProp(P_LEVEL);
  else
    level = lp/100;

  ind = QueryProp(P_ATTRIBUTES);
  ret = sprintf(
    LINE1+
    "  |  Erfahrung: %17s  |  Stufe:       %3s [%-'░'*s] %-3d |\n"
    "  |  Abenteuerpunkte: %4d (%4d)  |  Paragon:     %3d                     |\n"
    "  |  Attributpunkte:           %2s  |  "+ANSI_RED+"Lebenspunkte: %3d ["+ANSI_NORMAL+"%-'"+ANSI_RED+"░"+ANSI_NORMAL+"'*s"+ANSI_RED+"] %3-d"+ANSI_NORMAL+"   |\n"
    "  |  Rasse:  %20s  |  "+ANSI_LBLUE+"Magiepunkte:  %3d [%-'░'*s] %3-d"+ANSI_NORMAL+"   |\n"
    LINE1+
    "  |  Kraft:             %-9s  |  Geschicklichkeit:         %-9s  |\n"
    "  |  Ausdauer:          %-9s  |  Intelligenz:              %-9s  |\n"
    LINE1,
    format_thousands(QueryProp(P_XP)),
    level>QueryProp(P_LEVEL)?ANSI_LYELLOW+to_string(level)+ANSI_NORMAL:to_string(level),
    13, sprintf("%'▓'*s", (((lp/100)==(level+1))?13:(lp%100 * 13 / 100)), ""),
    level + 1,
    QueryProp(P_QP), QM->QueryMaxQP(),
    QueryProp(P_PARAGON_LVL),
    QueryProp(P_AP)>0?ANSI_LYELLOW+to_string(QueryProp(P_AP))+ANSI_NORMAL:to_string(QueryProp(P_AP)),
    QueryProp(P_HP),
    10, hp_bar(),
    QueryProp(P_MAX_HP),
    QueryProp(P_RACE),
    QueryProp(P_SP),
    10, (QueryProp(P_FROG)?ANSI_NORMAL+VT_GREEN+"  FROSCH  "+VT_NORMAL+ANSI_BLUE:
         sprintf("%'▓'*s", QueryProp(P_SP) * 10 / QueryProp(P_MAX_SP), "")
        ),
    QueryProp(P_MAX_SP),
    sprintf("%d (%+d)", ind[A_STR], QueryAttributeOffset(A_STR)),
    sprintf("%d (%+d)", ind[A_DEX], QueryAttributeOffset(A_DEX)),
    sprintf("%d (%+d)", ind[A_CON], QueryAttributeOffset(A_CON)),
    sprintf("%d (%+d)", ind[A_INT], QueryAttributeOffset(A_INT))
  );

  // Wenn von info() aufgerufen
  if (arg=="\ninfo")
    return ret;

  More(ret);
  return 1;
}

nosave string ausdauer()
{
    int max = 20;
    int filled = QueryProp(P_MV) * max / QueryProp(P_MAX_MV);

    return sprintf("Ausdauer:  [%'░'-20s] %d",
               sprintf("%'▓'*s", filled, ""),(QueryProp(P_MV)*100)/QueryProp(P_MAX_MV)) + "%%";
}

nosave string saettigung()
{
    int max = 20;
    int filled = QueryProp(P_FOOD) * max / QueryProp(P_MAX_FOOD);

    return sprintf("Sättigung: [%'░'-20s] %d",
               sprintf("%'▓'*s", filled, ""),(QueryProp(P_FOOD)*100)/QueryProp(P_MAX_FOOD)) + "%%";
}

nosave string trinken()
{
    int max = 20;
    int filled = QueryProp(P_DRINK) * max / QueryProp(P_MAX_DRINK);

    return sprintf("Trinken:   [%'░'-20s] %d",
               sprintf("%'▓'*s", filled, ""),(QueryProp(P_DRINK)*100)/QueryProp(P_MAX_DRINK)) + "%%";
}

nosave string alkohol()
{
    int max = 20;
    int filled = QueryProp(P_ALCOHOL) * max / QueryProp(P_MAX_ALCOHOL);

    return sprintf("Alkohol:   [%'░'-20s] %d",
               sprintf("%'▓'*s", filled, ""),(QueryProp(P_ALCOHOL)*100)/QueryProp(P_MAX_ALCOHOL)) + "%%";
}

nosave string gewicht()
{
    int max = 20;
    int total = QueryProp(P_TOTAL_WEIGHT) - QueryProp(P_WEIGHT) + 1;
    int max_weight = QueryProp(P_MAX_WEIGHT);

    int filled = (total/1000) * max / (max_weight/1000);
    int percent = (total/1000) * 100 / (max_weight/1000);

    return sprintf("Traglast:  [%'░'-20s] %d",
        sprintf("%'▓'*s", filled, ""),
        percent)+"%%";
}

nosave string exhausted_text_new()
{
  int p;

  // Anzahl der verbleibenden Moving Points in Prozent:
  p = 100 * QueryProp(P_MV) / QueryProp(P_MAX_MV);

  switch (p)
  {
    case 0..5:   return "Du bist im Moment schwer erschöpft.";
    case 6..15:  return "Du bist ziemlich außer Atem.";
    case 16..30: return "Du bist etwas erschöpft.";
    case 31..50: return "Du spürst erste Anzeichen der Erschöpfung.";
    default:     return "";
  }
}
nosave string weight_values()
{
  return sprintf("Du trägst %dkg von %dkg.",(QueryProp(P_TOTAL_WEIGHT) - QueryProp(P_WEIGHT) + 1)/1000,QueryProp(P_MAX_WEIGHT)/1000);
}
nosave string weight_text_new()
{
  int p;

  // Gewicht in Prozent ausrechnen:
  p = 100 * (QueryProp(P_TOTAL_WEIGHT) - QueryProp(P_WEIGHT) )
          / (QueryProp(P_MAX_WEIGHT)||1);

  // Durch etwaige Antigewichte kann der Wert auch unter 0 sinken:
  if (p < 0) p = 0;

  switch (p)
  {
    case  0..64: return "";
    case 65..70: return "Langsam beginnt Dein Gepäck Dir Mühe zu machen.";
    case 71..80: return "Du schleppst schon sehr viel mit Dir herum.";
    case 81..90: return "Du bist schon schwer beladen.";
    case 91..95: return "Viel wirst Du nicht mehr tragen können.";
    case 96..99: return "Du bist beinahe schon überladen.";
    case 100:    return "Du kannst absolut nichts mehr tragen.";
    default:   return "Du schleppst mehr als Du eigentlich tragen kannst.";
  }
}
nosave string food_text_new()
{
  int g;

  g = 100 * (QueryProp(P_FOOD)) / (QueryProp(P_MAX_FOOD))+1;
  switch (g)
  {
    case  0..70: return "";
    case 71..80: return "Du fühlst Dich satt.";
    case 81..90: return "Hunger hast Du schon lange keinen mehr.";
    case 91..95: return "Dein Bauch bläht sich schon vom vielen essen.";
    case 96..99: return "Dein Magen ist beinahe randvoll.";
default: return "Du bist bis oben hin voll und kannst kaum noch was essen.";
  }
}
nosave string drink_text_new()
{
  int g;

  g = 100 * (QueryProp(P_DRINK)) / (QueryProp(P_MAX_DRINK))+1;
  switch (g)
  {
   case  0..70: return "";
   case 71..80: return "Du hast eigentlich schon jetzt keinen Durst mehr.";
 case 81..90: return "In Deinem Bauch gluckert es schon vom vielen trinken.";
 case 91..95: return "Du bekommst langsam einen Wasserbauch vom vielen trinken.";
 case 96..99: return "Du bekommst bald nichts Flüssiges mehr runter.";
 default:     return "Du bist bis oben hin voll und kannst kaum noch was trinken.";
  }
}
nosave string alc_text_new()
{
  int g;

  g = (100 * (QueryProp(P_ALCOHOL)) / (QueryProp(P_MAX_ALCOHOL)+1));
  switch (g)
  {
    case  0..30: return "";
    case 31..33: return "Du bist bereits leicht angeheitert.";
    case 34..50: return "Du fühlst Dich mutig und stark - und etwas benommen.";
    case 51..75: return "Du hast das Gefühl als dreht sich die Welt um Dich.";
    case 76..90: return "Du lallst schon und hast Dich kaum noch unter Kontrolle.";
    default:     return "Du bist sternhagelvoll. Dein Kopf dröhnt und alles wankt.";
  }
}
nosave string enemy_text_new()
{ // Feinde aufzaehlen
  int i;
  mixed ind;
  string ret;
  mixed enem1, enem2, inv;

  ret="";
  enem1 = (QueryEnemies())[0];
  if (sizeof(enem1))
  {
    enem2 = ({});
    inv = all_inventory(environment(this_player()));

    for (i=0; i < sizeof(enem1); i++)
      if (member(enem1[i], inv) == -1) // Ist unser Feind, aber nicht da.
        enem2 += ({enem1[i]});

    if (sizeof(enem2))
    {
      ind = explode( break_string(
        "Du verfolgst "+CountUp( map_objects( enem2, "name", WEN ) )
        +".", 70), "\n");

      for (i=0; i < sizeof(ind); i++)
        ret += sprintf("  |  %-68s  |\n", to_string(ind[i]));
    }
  }
  return ret;
}
nosave int info_new()
{
  string ret;
  string gift, tmp, enemy;
  string *strings;
  int i,sz,val;
  mixed ind, seer;

  strings=({"","","",""});
  i=0;
  if (val=QueryProp(P_POISON) ) {
    strings[i]=(val<4 ? "leicht vergiftet" : "vergiftet");
    i++;
  }
  if( QueryProp(P_BLIND) ) {
    strings[i]="blind";
    i++;
  }
  if( QueryProp(P_DEAF) ) {
    strings[i]="taub";
    i++;
  }
  if( QueryProp(P_FROG) ) {
    strings[i]="ein Frosch";
    i++;
  }
  gift="";
  if( i )
  {
    for( sz=0;sz<i;sz++)
      gift+=strings[sz]+ (sz==i-1?".":(sz==i-2?" und ":", "));
    gift=sprintf("  |  %-68s  |\n", "Du bist "+gift);
  }
  if ((tmp=ausdauer()) != "")
    gift+=sprintf("  |  %-69s  |\n", tmp);
  if ((tmp=saettigung()) != "")
    gift+=sprintf("  |  %-69s  |\n", tmp);
  if ((tmp=trinken()) != "")
    gift+=sprintf("  |  %-69s  |\n", tmp);
  if ((tmp=alkohol()) != "")
    gift+=sprintf("  |  %-69s  |\n", tmp);
  if ((tmp=exhausted_text_new()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);
  if ((tmp=gewicht()) != "")
    gift+=sprintf("  |  %-68s   |\n", tmp);
  if ((tmp=weight_values()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);
  if ((tmp=weight_text_new()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);
  if ((tmp=food_text_new()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);
  if ((tmp=drink_text_new()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);
  if ((tmp=alc_text_new()) != "")
    gift+=sprintf("  |  %-68s  |\n", tmp);

  //enemy=enemy_text();

  ret = sprintf("\n"+TITLE1+"|    %-65s |   |\n"+TITLE2,
        capitalize(short()[0..<3] || ""));
  ret += sprintf(
    "  |  %15s               | Gildenlevel: %3d | Spielerlevel: %3d  |\n",
    upper_case(QueryProp(P_GUILD)), QueryProp(P_GUILD_LEVEL) ? QueryProp(P_GUILD_LEVEL) : QueryProp(P_LEVEL), QueryProp(P_LEVEL)
    );
  ret += score_new("\ninfo");
  ret += sprintf(
    gift+
    "  |  Vorsicht-Modus: %3d%:-49s  |\n"
    "  |  Dein Charakter ist %-49s  |\n%s%s"
    LINE2,
    QueryProp(P_WIMPY),
    (QueryProp(P_WIMPY_DIRECTION) ?
      ", Fluchtrichtung: "+to_string(QueryProp(P_WIMPY_DIRECTION)) :
      ""),
    al_to_title(QueryProp(P_ALIGN))+".",
    (QueryProp(P_AWAY) ?
      sprintf("  |  Du bist nicht ansprechbar: %:-41s  |\n",
              QueryProp(P_AWAY)) : ""),
     (enemy?enemy:""));
  ret += sprintf("  |  Alter: %:-61s  |\n",get_age());
  ret += sprintf("  |  Heimat: %:-60s  |\n",
              QueryProp(P_LOGON_PLACE)?QueryProp(P_LOGON_PLACE):"Unbekannt"); 

  if(!IS_SEER(this_object()) && getuid()[0..3]!="gast")
  {
    ret += LINE2;
    seer = explode(break_color_string(check_seher(), 68), "\n");
    for (i=0;i<sizeof(seer);i++)
      ret += sprintf("  |  %-68s  |\n", ANSI_LYELLOW+to_string(seer[i])+ANSI_NORMAL);
  }

  ret += LINE2;

  ind = explode(break_string(Forschung(), 68), "\n");
  for (i=0;i<sizeof(ind);i++)
    ret += sprintf("  |  %-68s  |\n", to_string(ind[i]));
  ret = ret[0..<2]+FOOTER;

  // Und jetzt ausgeben
  More(ret);
  return 1;
}

