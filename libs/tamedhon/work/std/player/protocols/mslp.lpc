// Tamedhon Mudlib
// MSLP
//
// Aloy

#pragma strong_types

#include <telnetneg.h>
#include <player/mslp.h>

varargs string mslp_link(string linktext, string sendtext)
{
    if(objectp(this_player()) && this_player()->QueryProp(P_TTY_MTTS_MASK) & MTTS_MSLP)
        return MSLP_BEGIN+MSLP_SEND+(sendtext?sendtext:linktext)+MSLP_MIDDLE+linktext+MSLP_END;
    else
        return linktext;
}

string mslp_menu(string menuname, mapping menuitems)
{
    string *parts = ({});
    string key, val;

    if(objectp(this_player()) && this_player()->QueryProp(P_TTY_MTTS_MASK) & MTTS_MSLP)
    {
        foreach (key, val in menuitems)
            parts += ({ "{" + key + "}{" + val + "}" });

        return MSLP_BEGIN+MSLP_MENU+implode(parts, "")+MSLP_MIDDLE+menuname+MSLP_END;
    }
    else
        return menuname;
}
