#include <udp.h>
#include <config.h>
#include <regexp.h>

#ifdef ZEBEDEE
#include <system.h>
#elif !defined(INETD)
#define INETD	"/secure/inetd"
#endif

/* Mud / Admin email address. */
#define EMAIL	"info@fantasywelt.net"

private string _ip4(string address) {
    string * match = regmatch(address, "([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)$",
            RE_MATCH_SUBS);
    return sizeof(match) > 1 ? match[1] : 0;
}

private varargs mapping _host_fields(mixed * h, string * fields)
{
    fields ||= ({ "name", "ip", "udp_port", "udp_encoding", "mud_port", "commands" });

    mapping res = ([]);
    foreach (string field: fields)
    {
        switch (field)
        {
            case "name":
                res += ([ "name": h[HOST_NAME] ]);
                break;
            case "ip":
                res += ([ "ip": _ip4(h[HOST_IP]) || h[HOST_IP] ]);
                break;
            case "udp_port":
                res += ([ "udp_port": h[HOST_UDP_PORT] ]);
                break;
            case "mud_port":
                res += ([ "mud_port": h[HOST_MUD_PORT] ]);
                break;
            case "commands":
                res += ([ "commands":
                        member(h[HOST_COMMANDS], "*") == -1
                        ? h[HOST_COMMANDS] : 0 ]);
                break;
            case "udp_encoding":
                res += ([ "udp_encoding": h[HOST_ENCODING] ]);
                break;
            default:
                /* nothing */
        }
    }
    return res;
}

void udp_query(mapping data) {
    mapping ret;

    switch(data[DATA]) {
        case "commands":
            ret = INETD->query("hosts");
            if (ret[lower_case(data[NAME])])
                ret = ([
                        DATA: implode(ret[lower_case(data[NAME])][LOCAL_COMMANDS], ":")
                ]);
            else
                ret = ([ DATA: implode(INETD->query("commands"), ":") ]);
            break;
        case "email":
            ret = ([ DATA: EMAIL ]);
            break;
        case "encoding":
            ret = ([ DATA: UDP_ENCODING ]);
            break;
        case "hosts":
            {
                mapping hosts;
                string *list;
                string tmp;
                int i;

                tmp = "";
                for(i = sizeof(list = m_indices(hosts = INETD->query("hosts")));
                        i--; ) {
                    tmp +=
                        hosts[list[i]][HOST_NAME] + ":" +
                        (_ip4(hosts[list[i]][HOST_IP]) || hosts[list[i]][HOST_IP]) + ":" +
                        hosts[list[i]][HOST_UDP_PORT] + ":" +
                        implode(hosts[list[i]][LOCAL_COMMANDS], ",") + ":" +
                        implode(hosts[list[i]][HOST_COMMANDS], ",");
                    if (i)
                        tmp += "\n";
                }
                ret = ([ DATA: tmp ]);
                break;
            }

#if __EFUN_DEFINED__(json_serialize)
        case "hosts-json":
            string * fields = data["fields"] ? explode(data["fields"], ",") : 0;
            ret = ([ DATA: json_serialize(
                        map(m_values(INETD->query("hosts") || ([])),
                            CLSR(_host_fields), fields)) ]);
            break;
        case "mssp-json":
            object mssp = load_object("/secure/misc/mssp");
            if (!mssp) return;

            string * fields = data["fields"] ? explode(data["fields"], ",") : 0;
            mapping infos = fields ?
                mssp->get_current_data() & fields :
                mssp->get_current_data();

            ret = ([ DATA: json_serialize(infos) ]);
            break;
#endif
#if defined (__TLS__) && defined (TLS_PORT)
        case "mud_port_tls":
            ret = ([ DATA: to_string(TLS_PORT) ]);
            break;
#endif

        case "inetd":
            ret = ([ DATA: INETD_VERSION ]);
            break;
        case "list":
            /* List of thingsthat can be queried. */
            ret = ([ DATA: "commands:email:encoding:hosts:inetd:mud_port:time:version" ]);
#if defined (__TLS__) && defined (TLS_PORT)
            ret[DATA] += ":mud_port_tls";
#endif
#if __EFUN_DEFINED__ (json_serialize)
            ret[DATA] += ":hosts-json:mssp-json";
#endif
            break;
        case "mud_port":
            ret = ([ DATA: query_mud_port() ]);
            break;
        case "time":
            ret = ([ DATA: time() ]);
            break;
        case "version":
            ret = ([ DATA: version() ]);
            break;
        case "uptime":
            ret = ([ DATA: uptime()+"\n" ]);
            break;
        case "exists":
            ret = ([ DATA: exist_days()+" Tagen\n" ]);
            break;
        case "lastreboot":
            ret = ([ DATA: "am "+dtime(last_reboot_time())+"\n" ]);
            break;
        case "users":
            ret = ([ DATA: sizeof(users())+" Anwesende\n" ]);
            break;
        case "questliste":
            ret = ([ DATA: "\n"+find_object("/p/service/querolin/listen/questliste")->liste()+"\n" ]);
            break;

        default:
            /* Just ignore it for the time being. */
            return;
    }
    INETD->send_udp(data[NAME], ret + ([
                REQUEST: REPLY,
                RECIPIENT: data[SENDER],
                ID: data[ID],
                "QUERY": data[DATA]
    ]) );
}
