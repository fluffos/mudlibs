// Erzseher Teleportationsring von Aloy

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <wizlevels.h>

#include "/obj/sehertormaster.h"

inherit "/std/armour";

int teleport;
int tport(string str);

void create()
{
    if(!clonep(this_object())) return;

    ::create();

    teleport = 1;

    SetProp(P_NAME, "Teleportationsring");
	SetProp(P_SHORT, "Ein magischer Teleportationsring");
    SetProp(P_LONG, 
        "Der Teleportationsring ist edel aus Mithril gefertigt. "
        "Er ist die neueste Erfindung der Bewahrer für sehr erfahrene Abenteurer. "
        "Er hat eingravierte magische Symbole und einen drehbaren Teil. "
        "Wenn man ihn auf den Finger steckt und dreht, hat man Zugriff auf das magische Portalnetzwerk.");
    SetProp(P_NAME_ADJ, "magisch");
    AddAdjective(parse_ids("magisch,-e,-er,-en"));
    SetProp(P_ARMOUR_TYPE, AT_RING);
    SetProp(P_AC, 0);
    SetProp(P_MATERIAL, MAT_MITHRIL);
    SetProp(P_GENDER, MALE);
    SetProp(P_NOSELL, 1);
    SetProp(P_NODROP, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_AUTOLOADOBJ, 1);
    SetProp(P_VALUE, 0);
    SetProp(P_WEIGHT, 0);
    AddId(({"ring", "teleportationsring", "teleportring", TPORTRING_ID}));

    AddCmd("drehe","tport");
}

void init()
{
  ::init();
  
  if (!IS_ARCHSEER(this_player()))
  {
     printf("Der Teleportationsring zerstört sich aus unerklärlichen Gründen "
        +"in deiner Hand.\n");
     this_object()->remove();
  }
}

void reset()
{
    ::reset();

    if(!teleport)
    {
        teleport = 1;
        write("Der Teleportationsring ist wieder aufgeladen!\n");
    }
}

int tport(string str)
{
    string s1,s2;
    int tornr=0;

    notify_fail("Möchtest du den Teleportationsring drehen?\n");

    if(str && (strstr(str,"ring")!=-1 || strstr(str,"teleportationsring")!=-1 || strstr(str,"den ring")!=-1 || strstr(str,"den teleportatiosnring")!=-1 || strstr(str,"teleportring")!=-1 || strstr(str,"den teleportring")!=-1))
    {        
        if(QueryProp(P_WORN))
        {
            if(environment(this_player())->QueryProp(P_NO_TPORT) == NO_TPORT_OUT)
            {
                write("Du kannst den Teleportationsring hier nicht benutzen!\n");
                return 1;
            }

            if(this_player()->InFight())
            {
                write("Du kannst den Teleportationsring im Kampf nicht benutzen!\n");
                return 1;
            }

            if (this_player()->QueryProp(P_SP) < TELEPORT_KOSTEN*2)
            {
                write("Du hast nicht genug Magiepunkte dafür.\n");
                return 1;
            }

            if(!teleport)
                write("Der Teleportationsring muss sich erst wieder aufladen!\n");
            else
            {
                if(sscanf(str, "%s %s %d",s1,s2,tornr) == 3 || sscanf(str, "%s %d",s1,tornr) == 2)
                    if(SDMASTER->Teleport(to_string(tornr)))
                    {
                        teleport = 0;
                        this_player()->restore_spell_points(-1*TELEPORT_KOSTEN);
                    }
                else
                {
                    write("Du drehst am Teleportationsring und kannst dich nun im Sehertornetzwerk bewegen.\n");
                    if(SDMASTER->Teleport())
                    {
                        teleport = 0;
                        this_player()->restore_spell_points(-1*TELEPORT_KOSTEN);
                    }
                }
            }
        }
        else
            write("Du musst den Teleportationsring erst anziehen!\n");

        return 1;
    }
    else
        return 0;
}
