/*
 * Debugraum von Tamedhon.
 * Original LDMud room preserved as /room/debug_ldmud.lpc.
 */

mapping exits;
int tm_debug_on;

void create() {
  tm_debug_on = 1;
  exits = ([
    "oben": "/room/jail",
    "up": "/room/jail",
    "u": "/room/jail",
  ]);
}

string query_short() { return "Debugraum von Tamedhon"; }

string query_long() {
  return "Das ist der offizielle Debugraum von Tamedhon, wo alle Debugmeldungen\n"
    "eintreffen. Er ist bis auf einen grossen Hebel leer.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt einen sichtbaren Ausgang: oben.\n";
}

string query_item(string s) {
  if (s == "hebel") {
    return "Mit diesem Hebel kann man die Debugmeldungen ein- und ausschalten.\n"
      "Zur Zeit sind sie " + (tm_debug_on ? "eingeschaltet" : "NICHT eingeschaltet") +
      " ('umlegen').\n";
  }
  return 0;
}

int room_cmd(string verb, string rest) {
  if (verb == "umlegen") {
    tm_debug_on = !tm_debug_on;
    write("Ok, Hebel wurde umgelegt.\n");
    return 1;
  }
  return 0;
}

int id(string str) {
  return str == "debug" || str == "debugraum" || str == "here";
}
