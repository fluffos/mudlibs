/*
 * Die Lehrlingsbude von Tamedhon.
 * Original LDMud room preserved as /room/lehrlingsbude_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "sueden": "/room/kreuzung",
    "sued": "/room/kreuzung",
    "s": "/room/kreuzung",
    "south": "/room/kreuzung",
  ]);
  extras = ([
    "betten": "Viele schlichte Betten fuer muede Lehrlinge.\n",
    "tisch": "Ein robuster Arbeitstisch mit Notizen zur Mudlib.\n",
    "regal": "Vollgestopft mit Dokumentationen ueber Tamedhon.\n",
    "dokumentation": "Anleitungen und Hilfetexte fuer angehende Magier.\n",
  ]);
}

string query_short() { return "Die Lehrlingsbude von Tamedhon"; }

string query_long() {
  return "Das ist die Lehrlingsbude von Tamedhon. Sie wirkt recht spartanisch\n"
    "eingerichtet, erfuellt aber ihren Zweck. Eigentlich ist der Raum mit\n"
    "Betten vollgestopft, wo die Lehrlinge gemuetlich schlafen koennen, und\n"
    "einem Tisch samt einem grossen Regal voller Dokumentation ueber das MUD.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt einen sichtbaren Ausgang: sueden.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "lehrlingsbude" || str == "here";
}
