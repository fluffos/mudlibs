/*
 * Eine Kreuzung im Untergrund von Tamedhon.
 * Original LDMud room preserved as /room/kreuzung_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "norden": "/room/lehrlingsbude",
    "nord": "/room/lehrlingsbude",
    "n": "/room/lehrlingsbude",
    "north": "/room/lehrlingsbude",
    "sueden": "/room/mkz",
    "sued": "/room/mkz",
    "s": "/room/mkz",
    "south": "/room/mkz",
    "unten": "/room/void",
    "hinab": "/room/void",
    "d": "/room/void",
    "down": "/room/void",
    "rechts": "/room/jail",
    "osten": "/room/jail",
    "ost": "/room/jail",
    "o": "/room/jail",
    "east": "/room/jail",
    "e": "/room/jail",
    "hinten": "/gilden/abenteurer",
    "westen": "/gilden/abenteurer",
    "west": "/gilden/abenteurer",
    "w": "/gilden/abenteurer",
  ]);
  extras = ([
    "wegweiser": "Lesen bildet ('lies wegweiser').\n",
    "kreuzung": "Eine ausgelatschte Kreuzung im Untergrund von Tamedhon.\n",
  ]);
}

string query_short() { return "Eine Kreuzung im Untergrund von Tamedhon"; }

string query_long() {
  return "Du befindest Dich irgendwo im Untergrund von Tamedhon auf einer\n"
    "ausgelatschten Kreuzung. Das einzige, was hier wirklich ist, ist ein\n"
    "grosser Wegweiser, der in alle moeglichen Richtungen zeigt.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt folgende sichtbare Ausgaenge: norden, sueden, unten, rechts (osten), hinten (westen).\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

string query_read(string s) {
  if (s == "wegweiser" || s == "tafel") {
    return " <--- LEHRLINGSBUDE (norden) --\n"
      " -- MAGIEKONTROLLZENTRUM (sueden) --->\n"
      " <--- DIE ANDERSWELT (unten) --\n"
      " -- GEFAENGNIS (rechts/osten) --->\n"
      " ABENTEURERGILDE .... hinten/westen\n";
  }
  return 0;
}

int id(string str) {
  return str == "kreuzung" || str == "wegweiser" || str == "here";
}
