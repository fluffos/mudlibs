/*
 * Die Anderswelt (Void).
 * Original LDMud room preserved as /room/void_ldmud.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "oben": "/room/kreuzung",
    "up": "/room/kreuzung",
    "u": "/room/kreuzung",
  ]);
}

string query_short() { return "Die Anderswelt"; }

string query_long() {
  return "Du befindest dich hier in der mittleren Welt der Anderswelt.\n"
    "Es sieht alles wie die echte Welt und auch wieder nicht wie die echte Welt aus.\n"
    "Diverse Geister beobachten dich und du siehst den Weltenbaum.\n"
    "Ein Naturgeist fluestert dir zu, dass du 'welt' sagen sollst, um zur\n"
    "Abenteurergilde zurueckzukehren (oder 'oben' zur Kreuzung).\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt den Ausgang 'oben' (oder 'welt' zurueck zur Gilde).\n";
}

int room_cmd(string verb, string rest) {
  object tp;

  if (verb == "welt") {
    tp = this_player();
    if (!tp)
      return 0;
    write("Der Naturgeist geleitet Dich zurueck in die Welt der Sterblichen.\n");
    return tp->move_room("/gilden/abenteurer");
  }
  return 0;
}

int id(string str) {
  return str == "void" || str == "anderswelt" || str == "here";
}
