/*
 * Mud-Kontrollzentrum (MKZ).
 * Original LDMud room preserved as /room/mkz_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "norden": "/room/kreuzung",
    "nord": "/room/kreuzung",
    "n": "/room/kreuzung",
    "north": "/room/kreuzung",
  ]);
  extras = ([
    "pult":
    "Die Knoepfe sind wie folgt beschriftet:\n"
    "  1. Reparatur (Statuspruefung)\n"
    "  4. Armageddon (nur Erzmagier)\n"
    "  5. Armageddon abbrechen\n"
    "Ausserdem entdeckst Du einen kleinen Monitor neben dem Pult.\n",
    "schaltpult":
    "Die Knoepfe sind wie folgt beschriftet:\n"
    "  1. Reparatur (Statuspruefung)\n"
    "  4. Armageddon\n"
    "  5. Armageddon abbrechen\n",
    "monitor":
    "Es stehen auch Magier-Workrooms offen: tippe 'gott' fuer Gott's Arbeitsraum.\n",
    "tafel":
    "Kontrolltafel von Tamedhon — alle Kerndienste laufen auf FluffOS.\n",
    "kontrolltafel":
    "Kontrolltafel von Tamedhon — alle Kerndienste laufen auf FluffOS.\n",
  ]);
}

string query_short() { return "Mud-Kontrollzentrum"; }

string query_long() {
  return "Du befindest Dich in einem halbfertigen Kontrollraum. Aus riesigen\n"
    "Schaltkaesten und -tafeln schaut ein Gewirr aus bunten Kabeln hervor,\n"
    "in dem alle Faeden zusammenlaufen und von dem aus das MUD gesteuert wird.\n"
    "An einer Wand haengt eine Kontrolltafel, daneben befindet sich ein Pult\n"
    "mit ein paar leuchtenden Schaltern.\n"
    "Tippe 'gott', um den Arbeitsraum von Gott zu besuchen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt einen sichtbaren Ausgang: norden (und 'gott' in seinen Arbeitsraum).\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int room_cmd(string verb, string rest) {
  object tp;

  tp = this_player();
  if (!tp)
    return 0;
  if (verb == "gott") {
    return tp->move_room("/players/gott/workroom");
  }
  if (verb == "druecke" || verb == "drueck" || verb == "push") {
    if (rest == "1") {
      write("Kontrolltafel blinkt gruen: FluffOS-Katalog laeuft stabil.\n");
      return 1;
    }
    write("Nichts passiert (Erzmagier-Privilegien erforderlich).\n");
    return 1;
  }
  return 0;
}

int id(string str) {
  return str == "mkz" || str == "kontrollzentrum" || str == "here";
}
