/*
 * Das Kittchen (Jail).
 * Original LDMud room preserved as /room/jail_ldmud.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "westen": "/room/kreuzung",
    "west": "/room/kreuzung",
    "w": "/room/kreuzung",
    "raus": "/room/kreuzung",
    "unten": "/room/debug",
    "down": "/room/debug",
    "d": "/room/debug",
  ]);
}

string query_short() { return "Das Kittchen"; }

string query_long() {
  return "Das Kittchen, in dem Du stehst.\n"
    "Hier geht normalerweise nur sag, nicke und nein — fuer Gaeste steht\n"
    "der Ausgang nach westen (oder 'raus') und nach unten in den Debugraum offen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt folgende sichtbare Ausgaenge: westen (raus) und unten.\n";
}

int room_cmd(string verb, string rest) {
  if (verb == "sag" || verb == "sage") {
    write("Du sagst: " + (rest || "...") + "\n");
    return 1;
  }
  if (verb == "ja" || verb == "nicke" || verb == "nick") {
    write("Du nickst zustimmend.\n");
    return 1;
  }
  if (verb == "nein" || verb == "schuet") {
    write("Du schuettelst den Kopf.\n");
    return 1;
  }
  return 0;
}

int id(string str) {
  return str == "jail" || str == "kittchen" || str == "here";
}
