/*
 * Der Arbeitsraum von Gott.
 * Original LDMud room preserved as /players/gott/workroom_ldmud.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "raus": "/room/mkz",
    "sueden": "/room/mkz",
    "s": "/room/mkz",
    "south": "/room/mkz",
    "zurueck": "/room/mkz",
  ]);
}

string query_short() { return "Der Arbeitsraum von Gott"; }

string query_long() {
  return "Das ist der Arbeitsraum von Gott. Er ist noch recht kahl und gestaltlos.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt einen sichtbaren Ausgang: sueden (raus).\n";
}

int id(string str) {
  return str == "workroom" || str == "arbeitsraum" || str == "here";
}
