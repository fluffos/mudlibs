mapping exits;

void create() {
  exits = ([
    "gilde": "/gilden/abenteurer",
    "norden": "/gilden/abenteurer",
    "north": "/gilden/abenteurer",
  ]);
}

string query_short() { return "Das Nichts"; }

string query_long() {
  return "Das Nichts — Auffangraum der Tamedhon FluffOS-Katalogumgebung.\n"
    "Nach Norden geht es zur Abenteurergilde.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Ausgaenge: norden.\n";
}

int id(string str) { return str == "void" || str == "here"; }
