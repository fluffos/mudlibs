/* /dev/null
 *
 * Wehe das ding loescht nochmal wer, dann loesch ich den loescher ;)
 *
 * 05/02/2004 Serii
 *
 */

inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <player.h>

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT, "/dev/null");
  SetProp(P_INT_LONG, " --- NIX --- ");
  SetProp(P_INDOORS,0);
}

void ca_d(object tp)
{
  if(tp)
   tp->remove();
  if(tp)destruct(tp);
}

void init()
{
  ::init();

    if(all_inventory())
        foreach(object ob:all_inventory())
            ca_d(ob);
}

void reset()
{
    ::reset();

    if(all_inventory())
        foreach(object ob:all_inventory())
            ca_d(ob);
}
