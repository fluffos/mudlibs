/* ein brecheisen
 * Sep 3, 2004 - Serii@Tamedhon
 */
#include <properties.h>
#include <combat.h>

inherit "std/weapon";

void create()
{
 if(!clonep(this_object())) return 0;
 ::create();
    
AddId(({"kuhfuß","\nbrecheisen","kuhfuss","brecheisen"}));
SetProp(P_GENDER, MALE);
SetProp(P_NAME, "Kuhfuß");
SetProp(P_SHORT, "Ein Kuhfuß");
SetProp(P_LONG,
"Das ist ein Kuhfuß, auch Brecheisen genannt. "
"Ein besonders nützliches Multifunktionsutensil das in keinem "
"Haushalt fehlen sollte.");
    
AddDetail("multifunktionsutensil",
"Man kann es einfach für alles einsetzen - als "
"Haustürschlüssel, Fensteröffner, Vorschlaghammer, Dosenöffner...");
    SetProp(P_VALUE, 300);
    SetProp(P_WEIGHT, 1000);
    SetProp(P_WEAPON_TYPE, WT_CLUB);
    SetProp(P_WC, 40);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_RIP}));
    SetProp(P_MATERIAL, ([MAT_STEEL: 100]));

    AddCmd(({"brich","breche","brech"}),"c_brich");
}

int c_brich(string str)
{
  notify_fail("Was willst Du mit dem Kuhfuß aufbrechen?\n");
  return 0;
}
