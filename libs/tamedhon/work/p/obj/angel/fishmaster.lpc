#pragma strong_types

#include <moving.h>
#include <fishing.h>

#include "/sys/player/base.h"

#define WATERTYPES ({W_BEACH,W_HARBOR,W_OCEAN,W_RIVER,W_POOL,W_LAKE,W_ROCK,W_STREAM,W_DEAD})

#define RANDOM_STUFF ({"/p/armour/schuhe/lederstiefel",\
                       "/p/armour/helme/topfhelm",\
                       "/p/obj/seil",\
                       FISH_DIR"extra/erzifisch"})

nosave mapping AllFish=([]);

void LoadFish()
{
  string *allfish;
  int lv;
  allfish=get_dir(FISH_DIR"*.lpc");
  for(lv=0;lv<sizeof(allfish);lv++)
    AllFish[FISH_DIR+allfish[lv][0..<3]]=call_other(FISH_DIR+allfish[lv][0..<3],"QueryProp",P_WATER);
}

string *GetAllFish(int watertype)
{
  string *wfish;
  string *fish_files;
  int lv;
  wfish=({});
  fish_files=m_indices(AllFish);
  for(lv=0;lv<sizeof(fish_files);lv++)
  {
    if(watertype&AllFish[fish_files[lv]])
      wfish+=({fish_files[lv]});
  }
  return wfish;
}

varargs mixed GetRandomFish(object room, int randomchance)
{
  string *wfish;
  mixed userfish;
  int watertype;

  if(!room)return 0;

  watertype=room->QueryProp(P_WATER);

  if((watertype&W_USER)==W_USER)
  {
    userfish=room->GetCustomFish();
    if(objectp(userfish))
      return userfish;

    if(pointerp(userfish))
      wfish=userfish;
    else
      return 0;
  }
  else if(watertype&W_USER)
  {
    userfish=room->GetCustomFish();
    if(!pointerp(userfish))
      return 0;
    wfish=GetAllFish(watertype)+userfish;
  }
  else
  {
    wfish=GetAllFish(watertype);
  }

  if(!sizeof(wfish)||!pointerp(wfish))return -1;
  if(!random(randomchance))
    return clone_object(RANDOM_STUFF[random(sizeof(RANDOM_STUFF))]);
  return clone_object(wfish[random(sizeof(wfish))]);
}

void create(){
  seteuid(getuid());
  LoadFish();
}
