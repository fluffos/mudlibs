// erzifisch.c - ein erzifisch
// 05/20/2012 by Serii@Tamedhon
//

#include <fishing.h>

inherit FISHING"fish";

#include <properties.h>
#include <language.h>

#include <food.h>

#include <fishing.h>

#define ERZIS ({"Aloy", "Querolin", "Gralkor"})

string erz;

int _query_water()// set this way so we can test blueprint!
{
  return W_ALL;
}

varargs void create()
{
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(66,666);

  erz=ERZIS[random(sizeof(ERZIS))];

  SetProp(P_SHORT,"Ein "+erz+"fisch");
  SetProp(P_LONG,
  "Ein "+erz+"fisch. "
  "Er gehört zu der Gattung der Erzifische, welche es "
  "in so gut wie in allen Gewässern des Tamedhon gibt. "
  "Trotzdem ist dieser Fisch recht selten.");
  SetProp(P_NAME,erz+"fisch");
  SetProp(P_GENDER, MALE);

  AddId(({lower_case(erz)+"fisch"}));

  SetProp(P_FOOD_INFO,([F_HEAL:random(19),
                        F_SOAK:2,
                        F_MSG:"Du vertilgst den "+erz+"fisch.",
                        F_MSG_ROOM:"vertilgt einen "+erz+"fisch."
                        ]));

}
