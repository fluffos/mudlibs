#include <fishing.h>

inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_BEACH;
}

#define FARBEN ({"braun gesprenkelter Dorsch",\
                 "graugrüen gesprenkelter Dorsch",\
                 "bläulich schimmernder Dorsch",\
		 "leicht grün schimmernder Dorsch",\
                 "silbern schimmernder Dorsch",\
                 "gelber Dorsch, überzogen mit grauen Linien"})

varargs void create()
{
 int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(15,200);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Dorsch");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+". Ein recht gut aussehendes Exemplar obendrein."
/*    " Man kann ihn scheinbar roh essen, aber gekocht waer er sicher viel besser!"*/);
  SetProp(P_NAME, "Dorsch");
  SetProp(P_GENDER, MALE);

  AddId(({"dorsch"}));
}
