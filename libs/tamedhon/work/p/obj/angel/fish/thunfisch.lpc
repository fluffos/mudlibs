#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_OCEAN;
}

#define FARBEN ({"silbern","silbergrau"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(100,250);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Thunfisch");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+"er Thunfisch."
/*    " Man kann ihn scheinbar roh essen, aber gekocht waer er sicher viel besser!"*/);
  SetProp(P_NAME, "Thunfisch");
  SetProp(P_GENDER, MALE);

  AddId(({"thunfisch"}));
}
