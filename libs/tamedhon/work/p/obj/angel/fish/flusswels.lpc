#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_RIVER;
}

#define FARBEN ({"grauer","gelber"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(80,280);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT, "Ein "+QueryProp(P_NAME_ADJ)[0]+"er Flusswels");
  SetProp(P_LONG,
    "Ein "+FARBEN[farb]+" Flusswels. Seine Schuppen "+
      "sind ganz grau und seine Augen sind tiefschwarz.");
  AddId(({"flusswels", "wels", "\nwels"}));
  AddDetail(({"schuppe", "schuppen"}),
    "Sie sind grau und glitschig.");
  AddDetail(({"auge", "augen"}),
    "Tiefschwarz blicken sie Dich an. Jetzt bekommst Du glatt Hunger.");
  AddDetail(({"hunger"}),
    "Dann iss diesen Hecht doch einfach auf.");

  SetProp(P_NAME, "Flusswels" );
  SetProp(P_GENDER, MALE);
}
