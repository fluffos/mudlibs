#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>


int _query_water()// set this way so we can test blueprint!
{
  return W_POOL;
}

#define FARBEN ({"silberfarbener Stichling mit schwarzen Streifen",\
                 "grauer Stichling mit schwarzen Streifen"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(3,20);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Stichling");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+". Er ist recht klein und unscheinbar."/*
    " Man kann ihn scheinbar roh essen, aber gekocht waer er sicher viel besser!"*/);
  SetProp(P_NAME, "Stichling");
  SetProp(P_GENDER, MALE);

  AddId(({"stichling"}));
}
