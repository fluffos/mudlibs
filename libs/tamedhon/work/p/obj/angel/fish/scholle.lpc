#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_HARBOR;
}

#define FARBEN ({"grau-braune Scholle mit gelben Punkten",\
                 "braune Scholle mit gelben Punkten",\
                 "grau-braune Scholle mit roten Punkten",\
		 "braune Scholle mit roten Punkten"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(30,70);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Eine "+QueryProp(P_NAME_ADJ)[0]+"e Scholle");
  SetProp(P_LONG,"Eine "+FARBEN[farb]+". "
  "Sicher einer der am merkwürdigsten aussehenden"
  " Fische der Dir je untergekommen ist. Die beiden toten Fischaugen "
  "glotzen dich vorwurfsvoll von der rechten"
  " Fischseite an."/* " Man kann sie scheinbar roh essen, aber gekocht waer sie sicher viel besser!"*/);
  SetProp(P_NAME, "Scholle");
  SetProp(P_GENDER, FEMALE);

  AddId(({"scholle"}));
}
