#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>


int _query_water()// set this way so we can test blueprint!
{
  return W_STREAM;
}

#define FARBEN ({"grüner Hecht, mit gelben Streifen",\
                 "grauer Hecht, gesprenkelt mit weißen Tupfen",\
                 "grüner Hecht, gesprenkelt mit weißen Tupfen"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(20,160);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Hecht");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+". "
  "Ein merkwürdig aussehender Fisch, aber was"
  " weißt Du schon von Fischen."/* " Man kann ihn scheinbar roh essen, aber gekocht waer er"
    " sicher viel besser!" */);
  SetProp(P_NAME, "Hecht");
  SetProp(P_GENDER, MALE);

  AddId(({"hecht"}));
}
