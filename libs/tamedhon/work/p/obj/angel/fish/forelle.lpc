#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_RIVER|W_ROCK;
}

#define FARBEN ({"gelbe Forelle ist mit dunklen Tupfen gesprenkelt",\
                 "graue Forelle ist mit dunklen Tupfen gesprenkelt"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(45,140);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Eine "+QueryProp(P_NAME_ADJ)[0]+"e Forelle");
  SetProp(P_LONG,"Die "+FARBEN[farb]+". "
  "Ein recht gut aussehendes Exemplar obendrein."
/*    " Man kann sie scheinbar roh essen, aber gekocht waer sie sicher viel besser!"*/);
  SetProp(P_NAME, "Forelle");
  SetProp(P_GENDER, FEMALE);

  AddId(({"forelle"}));
}
