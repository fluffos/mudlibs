#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>


int _query_water()// set this way so we can test blueprint!
{
  return W_LAKE;
}

#define FARBEN ({"golden schimmernder Karpfen",\
                 "weiß-grauer Karpfen",\
		 "silber- und schwarzgescheckter Karpfen",\
                 "grün-gelblicher Karpfen",\
		 "rotgepunkteter Karpfen",\
		 "orangefarbener Karpfen",\
		 "weißer Karpfen mit schwarzen Punkten"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(30,160);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Karpfen");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+". "
  "Er sieht ein wenig so aus als hätte er"
   " gerade einen Auffahrunfall gehabt."/* " Man kann ihn scheinbar roh essen, aber gekocht waer er"
    " sicher viel besser!"*/);
  SetProp(P_NAME, "Karpfen");
  SetProp(P_GENDER, MALE);

  AddId(({"karpfen"}));
}
