#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>


int _query_water()// set this way so we can test blueprint!
{
  return W_ROCK;
}

#define FARBEN ({"goldener Lachs der mit roten Puenktchen gesprenkelt ist",\
                 "silberblauer Lachs"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(50,150);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT,"Ein "+QueryProp(P_NAME_ADJ)[0]+"er Lachs");
  SetProp(P_LONG,"Ein "+FARBEN[farb]+". "
  "Er schaut ein wenig traurig drein, aber"
  " das hängt sicher damit zusammen, daß Du ihn geangelt und "
  "erschlagen hast."/*
    " Man kann ihn scheinbar roh essen, aber gekocht waer er sicher viel besser!"*/);
  SetProp(P_NAME, "Lachs");
  SetProp(P_GENDER, MALE);

  AddId(({"lachs"}));
}
