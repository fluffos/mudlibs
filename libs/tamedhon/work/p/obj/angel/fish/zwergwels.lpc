#include <fishing.h>
inherit FISHING"fish";

#include <properties.h>
#include <language.h>
#include <food.h>

int _query_water()// set this way so we can test blueprint!
{
  return W_RIVER|W_LAKE;
}

#define FARBEN ({"bläulich","grünlich"})

varargs void create()
{int farb;
  if (!clonep(this_object())) return;
  ::create();

create_default_fish(30,60);

  farb=random(sizeof(FARBEN));

  SetProp(P_SHORT, "Ein "+QueryProp(P_NAME_ADJ)[0]+"er Zwergwels");

  SetProp(P_LONG,
    "Er schimmert "+FARBEN[farb]+
      " und sieht sehr appetitlich aus. Mit seinen Augen sieht er "+
      "Dich schon ganz erwartungsvoll an. Zu gerne würdest Du ihn "+
      "vertilgen.");
  AddId(({"wels", "zwergwels","\nwels"}));
  AddDetail(({"schimmern", "schimmer"}),
    "Besser "+FARBEN[farb]+" schimmmern als grünlich schimmeln.");
  AddDetail(({"schuppe", "schuppen"}),
    "Die Schuppen vom Fisch schimmern "+FARBEN[farb]+".");
  AddDetail(({"augen", "auge"}),
    "Die "+QueryProp(P_NAME_ADJ)[0]+"en "
    "Augen schauen Dich erwartungsvoll an. Offenbar "+
    "wartet der Zwergwels nur darauf von Dir verspeist zu werden.");
  SetProp(P_NAME, "Zwergwels" );
  SetProp(P_GENDER, MALE);
}
