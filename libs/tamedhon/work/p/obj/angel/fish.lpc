inherit "std/food";

#include <properties.h>
#include <language.h>

#include <food.h>

#include <fishing.h>

int State=1;

int _query_water()// set this way so we can test blueprint!
{
  return W_ALL;
}

varargs void create()
{
  if (!clonep(this_object()))return;
  ::create();

  SetProp(P_SHORT,"Standardfisch");
  SetProp(P_LONG,"Standardfisch, ein Magier war faul!");
}


varargs void create_default_fish(int min_size, int max_size)
{
  int size,avg_size,spercent;
  string adj;
  SetProp(P_SHORT,"Fisch");
  SetProp(P_LONG,
  "Ein unscheinbarer tamedhonischer Fisch ohne besondere Merkmale.");
  SetProp(P_NAME,"Fisch");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE,100);
  SetProp(P_ARTICLE,1);

  SetProp(P_SMELL, "Der Fisch riecht fischig.");

  if(!min_size)min_size=10;
  if(!max_size)max_size=50;

  size=min_size+random(max_size-min_size);
  avg_size=(max_size+min_size)/2;

  SetProp(P_AVERAGE_SIZE,avg_size);
  SetProp(P_AVERAGE_WEIGHT,avg_size*50); //500g / 10cm

  SetProp(P_SIZE,size);
  SetProp(P_WEIGHT,size*50);

  spercent=(size-min_size)*100/(max_size-min_size);
  switch(spercent)
  {
    case 0..9:
      adj="mikroskopisch";
      break;
    case 10..19:
      adj="winzig";
      break;
    case 20..29:
      adj="mickrig";
      break;
    case 30..39:
      adj="klein";
      break;
    case 40..49:
      adj="durchschnittlich";
      break;
    case 50..59:
      adj="üppig";
      break;
    case 60..69:
      adj="groß";
      break;
    case 70..79:
      adj="riesig";
      break;
    case 80..89:
      adj="enorm";
      break;
    case 90..100:
      adj="gewaltig";
      break;
    default:
      adj="merkwürdig";
  }

  SetProp(P_NAME_ADJ,adj);

  AddAdjective(adj,adj+"er",adj+"e");

  AddId(({"fisch",FISCH_ID}));

  SetProp(P_FOOD_INFO,([F_HEAL:0,
                        F_SOAK:2,
                        F_MSG:"Du vertilgst den Fisch.",
                        F_MSG_ROOM:"vertilgt einen Fisch."
                        ]));

  SetProp(P_FOOD_INFO, ([F_HEAL:spercent/20, F_SOAK:2*(spercent/20),
                         F_MSG:"Du isst "+this_object()->name(WEN,1)+".",
                         F_MSG_ROOM:"isst "+this_object()->name(WEN,0)+"."]));

  SetProp(P_MATERIAL,([MAT_BONE:20,MAT_CHITIN:5,MAT_SKIN:5,MAT_FLESH:58,MAT_BLOOD:7,MAT_WATER:5]));
}

void reset()
{
  object env;
  mapping finfo;
  env=environment(this_object());
  if(env&&State)
  {
    if(interactive(env))
    {
      tell_object(env,break_string(Name(WER)+
      " wird faulig und fängt an zu stinken."));
    }
    else
    {
      tell_room(env,break_string(Name(WER)+
      " wird faulig und fängt an zu stinken."));
    }
    State=0;
    SetProp(P_NAME_ADJ,"faulig");
    AddAdjective("faulig","fauliger","faulige");
    finfo=QueryProp(P_FOOD_INFO);
    finfo[F_HEAL]=(-2-random(3));
    SetProp(P_FOOD_INFO,finfo);
  }
  ::reset();
}
