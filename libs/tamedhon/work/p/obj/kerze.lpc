/* Eine normale Kerze
 * Aloy
 */

inherit "/std/lightsource_float";

#include <properties.h>
#include <language.h>

void create() {
  lightsource_float::create();
  AddId("kerze");
  AddId("\nkerze");
  SetProp(P_NAME,"Kerze");
  SetProp(P_VALUE,2);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Kerze");
  SetProp(P_LONG,
  "Eine ganz normale Kerze. "
  "Man kann sie anzünden und wieder löschen.\n");
  SetProp(P_MATERIAL, MAT_WAX );
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,4327);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell leuchtend","frisch angezündet"}));
  lightsource_float::set_lightval(0.5);
}
