#include <properties.h>
#include <combat.h>

inherit "std/weapon";

void create()
{
  if(!clonep(this_object())) return 0;
  ::create();

  AddId(({"\nhammer","hammer"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Hammer");
  SetProp(P_SHORT, "Ein Hammer");
  SetProp(P_LONG, break_string(
    "Das ist ein ganz normaler Hammer mit einem Kopf aus Stahl und einem "+
    "Stiel aus Eschenholz!"));
  SetProp(P_VALUE, 25);
  SetProp(P_WEIGHT, 700+random(51));
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 30);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}));
  SetProp(P_MATERIAL, ([MAT_STEEL:80,MAT_ASH_WOOD:20]) );

  AddDetail(({"hammerkopf","kopf"}),break_string(
    "Der Kopf besteht aus gutem Stahl und besitzt eine Finne und eine "+
    "Bahn."));
  AddDetail(({"stahl"}),break_string(
    "Er ist wirklich sehr hart. Der Kopf geht sicherlich nicht so "+
    "schnell kaputt."));
  AddDetail(({"stiel"}),break_string(
    "Der stiel ist aus festem Eschenholz gemacht."));
  AddDetail(({"holz","eschenholz"}),break_string(
    "Es ist glatt und splittert nicht. Und das ist auch gut so."));
  AddDetail(({"finne"}),break_string(
    "Die Finne ist der schmale Teil am Hammerkopf."));
  AddDetail(({"bahn"}),break_string(
    "Die Bahn ist der Stumpfe Teil am Hammerkopf. Damit schlägt man "+
    "meistens zu."));
  AddDetail(({"teil","teile"}),break_string(
    "Die beiden Teile eines Hammers sind Kopf und Stiel."));
}
