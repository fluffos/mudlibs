//
// eine Standardgeldbörse
//
// adaptiert für das Tamedhon von Aloy
//
// abgeleitete Objekte brauchen string _query_short() 
// und varargs string long() zum korrekten Funktionieren
//
// letzte Änderungen:
// 2024-10-22 Gralkor 	long() angepasst und UTF8
//

inherit "/std/container";

#define GELDBOERSE "\ngeldboerse"

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();
  AddId(({"geldboerse", "boerse","börse","geldbörse"}));
  SetProp(P_NAME, "Geldbörse");
  SetProp(P_SHORT, "Eine Geldbörse");
  SetProp(P_LONG, "Eine schöne, aus edlem Leder gefertigte Geldbörse.\n");
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE,  80);
  SetProp(P_WEIGHT, 300);
  SetProp(P_MAX_WEIGHT, 50000);         // entspricht 200k Muenzen
  SetProp(P_WEIGHT_PERCENT, 50);        // Gewicht halbiert sich
}

nosave string _query_keep_on_sell()
{
  if (sizeof(all_inventory()) && environment() &&
      query_once_interactive(environment()))
     return getuid(environment());
  return Query(P_KEEP_ON_SELL);
}

nosave int _query_amount()
{
  object ob;
  if (ob=present("geld", this_object()))
    return ob->QueryProp(P_AMOUNT);
  
    return 0;
}

void AddAmount(int am)
{
  object ob;
  if (ob=present("geld", this_object())) ob->AddAmount(am);
}

string _query_short()
{
  int i;
  switch (i=QueryProp(P_AMOUNT)) {
    case 0:  return "Eine leere Geldbörse";
    case 1:  return "Eine Geldbörse mit einer Münze";
    default: return "Eine Geldbörse mit "+i+" Münzen";
  }
}

varargs string long()
{
 string descr, inv_descr;
 descr = process_string(QueryProp(P_LONG));
 if(!QueryProp(P_TRANSPARENT)) return descr;
 inv_descr = make_invlist(this_player(), all_inventory(this_object()), 0);
 if ( inv_descr != "" )
 descr += "Sie enthält:\n" + inv_descr;
 return descr;
}


varargs int PreventInsert(object ob)
{
  object ob2;
  if (ob && object_name(ob)[0..10]=="/obj/money#")
    if (!sizeof(all_inventory()) && (ob2=present(GELDBOERSE, environment()))) {
      write("Du kannst immer nur eine Geldbörse gleichzeitig benutzen.\n");
      return 1;
    }
    else return ::PreventInsert(ob);
  else return 1;
}

varargs int id(string str, int lvl)
{
  if (str==GELDBOERSE && sizeof(all_inventory())) return 1;
  return ::id(str, lvl);
}

int IsEqual(object ob)
{
  int amount;
  string s1, s2;
  object ob2;

  if (object_name(ob)[0..10]!="/obj/money#") return 0;
  if (environment(ob)==this_object()) return 0;
  if (!sizeof(all_inventory()) && (ob2=present(GELDBOERSE, environment())))
    return 0;
  if ( 0 > amount=ob->QueryProp(P_REQUESTED_AMOUNT))
  {
    int amount2;
    amount2=QueryProp(P_AMOUNT);
    if (-amount>amount2) {
      ob->AddAmount(amount2);
      AddAmount(-amount2);
    }
    else {
      ob->AddAmount(-amount);
      AddAmount(amount);
    }
    ob2=this_object();
    Set(P_LAST_CONTENT_CHANGE,time());
    while (ob2=environment(ob2))
       ob2->Set(P_LAST_CONTENT_CHANGE,time());
  }

  return 0;
}

varargs int move(mixed dest, int method)
{
  int i;
  object ob;

  if (stringp(dest)) {
    call_other(dest, "???");
    dest=find_object(dest);
  }
  if (objectp(dest)) ob=present(GELDBOERSE, dest);
  i=::move(dest, method);
  if (i!=1) return i;
  if (!environment()) return 1;
  if (objectp(ob)) filter_objects(all_inventory(), "move", ob, M_MOVE_ALL);
  return 1;
}
