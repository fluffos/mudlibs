#include <properties.h>

inherit "std/thing";

void create()
{
  if(!clonep(this_object())) return 0;
  ::create();

  AddId(({"\neimer","eimer"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Eimer");
  SetProp(P_SHORT, "Ein Eimer");
  SetProp(P_LONG, break_string(
    "Das ist ein ganz normaler Eimer mit einem Henkel aus Stahl und Boden "+
    "nebst Wand aus Eschenholz!"));
  SetProp(P_VALUE, 25);
  SetProp(P_WEIGHT, 700+random(51));
  SetProp(P_MATERIAL, ([MAT_STEEL:10,MAT_ASH_WOOD:90]) );

  AddDetail(({"henkel"}),break_string(
    "Der Henkel besteht aus gutem Stahl."));
  AddDetail(({"stahl"}),break_string(
    "Er ist wirklich sehr hart. Der Henkel geht sicherlich nicht so "+
    "schnell kaputt."));
  AddDetail(({"wand","wandung","boden"}),break_string(
    "Die Wandung und der Boden sind aus festem Eschenholz gemacht."));
  AddDetail(({"holz","eschenholz"}),break_string(
    "Es ist glatt und splittert nicht. Und das ist auch gut so."));
}
