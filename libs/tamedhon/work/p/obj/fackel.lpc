/* Eine normale Fackel
 * Ergaenzung um eine eindeutige ID
 * Shannara@Turithil, 10. 7. 1999
 */

inherit "/std/lightsource";

#include <properties.h>
#include <language.h>

void create() {
  lightsource::create();
  AddId("fackel");
  AddId("\nfackel");
  SetProp(P_NAME,"Fackel");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,1000);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Fackel");
  SetProp(P_LONG,
  "Eine ganz normale Fackel. "
  "Man kann sie anzünden und wieder löschen.\n");
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,2000);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell lodernd","frisch angezündet"}));
}
