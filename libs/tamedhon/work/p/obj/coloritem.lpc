 
// coloritem beispiel
// coloritems haben einen farbigen short

#pragma strong_types

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!clonep(this_object()) )  return;

  ::create();

  SetProp(P_SHORT,parse_color_string("Ein ^S^WCo^N^Glor^N^S^Wit^N^Gem^N"));
  SetProp(P_LONG,parse_color_string("Ein Coloritem Testitem"));
  // alle fälle durchdeklinieren und position 5 im array muss der name ohne farbe sein
  // bei units ists singular,plural,ohne_farbe_name
  // zusammengefasst sind 2 dinge wichtig: die id "\ncoloritem" und im P_NAME array muss das letzte feld der name ohne farben sein
  SetProp(P_NAME,({parse_color_string("^S^WCo^N^Glor^N^S^Wit^N^Gem^N"),
                    parse_color_string("^S^WCo^N^Glor^N^S^Wit^N^Gem^N"),
                    parse_color_string("^S^WCo^N^Glor^N^S^Wit^N^Gem^N"),
                    parse_color_string("^S^WCo^N^Glor^N^S^Wit^N^Gem^N"),
                    "Coloritem"}));
  SetProp(P_GENDER, NEUTER);

  AddId(({"\ncoloritem", "coloritem"}));

  SetProp(P_MATERIAL, ([MAT_MISC:100]) );
}
