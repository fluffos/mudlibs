
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <ansi.h>
#include "/secure/questmaster.h"

#define TITLE1 \
"  ________________________________________________________________________\n"\
" /                                                                      / \\\n"
#define TITLE2 \
" \\______________________________________________________________________\\  |\n"\
"  |                                                                        |\n"

#define FOOTER \
"\\\n"\
"  \\________________________________________________________________________\\/\n"

nosave int compare( mixed *i, mixed *j )
{
  if( i[2] == j[2] )
    return i[1] > j[1];
  else
    return i[2] > j[2];
}

varargs string liste()
{
  int qgroups, i, j, n, *dontneed;
  mixed *qlists, *quests;
  string str, bold, normal;

  bold=normal="";

  str = sprintf(TITLE1+"|    %-65s |   |\n"+TITLE2,"Abenteuer im Tamedhon");

  str += sprintf("  |  %-68s  |\n",sprintf("%s%-38s%s Stufe   AP     Region",
      bold,"Abenteuer",normal));
  str += "  +------------------------------------------------------------------------+\n";
  qgroups = sizeof(QGROUPS);
  qlists = allocate( qgroups );
  for( i=qgroups-1; i>=0; i-- )
    qlists[i] = ({});

  quests = QM->QueryQuests();
  for( i=sizeof(quests[0])-1; i>=0; i-- )
    if( quests[1][i][6] )
    {
      for( j=qgroups-1; QGROUPS[j]>quests[1][i][4]; j-- )
        ;
      qlists[j] += ({ ({
        quests[0][i], quests[1][i][0], quests[1][i][4], quests[1][i][7], 
		quests[1][i][5], quests[1][i][2]
      }) });
    }

  for( i=0; i<qgroups; i++ )
  {
    str += sprintf("  | %-68s   |\n",bold+"Levelbereich "+(i<qgroups-1?QGROUPS[i]+"-"+to_string(QGROUPS[i+1]-1):QGROUPS[i]+"+")+":"+normal);
    if (!sizeof(qlists[i]))
      str += sprintf("  |  %-68s  |\n","In diesem Levelbereich gibt es derzeit keine Abenteuer.\n");
    else
    {
      qlists[i] = sort_array( qlists[i], #'compare); // ME );
      for( j=0; j<sizeof(qlists[i]); j++ )
      {
          string region = explode(qlists[i][j][5][0],"/")[1];
          if(strstr(region, "files") != -1)
            region = explode(region,".")[1];
          str +=
            sprintf( "  |  %-38s %3d     %2d     %-14s  |\n",
              qlists[i][j][0], qlists[i][j][2], qlists[i][j][1], capitalize(region)
        );
      }
    }
    str += "  |                                                                        |\n";
  }

   str = str[0..<2]+FOOTER;

   return str;
}

