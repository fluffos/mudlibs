/*
 * Die Gilde der Abenteurer — Hauptstelle der Abenteurergilde (Gidhrog).
 *
 * Strategy A FluffOS room preserving authentic Tamedhon text, details,
 * smells, spells, and exits. Original LDMud guild preserved as
 * /gilden/abenteurer_ldmud.lpc.
 */

mapping exits;
mapping extras;
mapping smells;

void create() {
  exits = ([
    "westen": "/room/kreuzung",
    "west": "/room/kreuzung",
    "w": "/room/kreuzung",
  ]);
  extras = ([
    "raum": "Du stehst mitten drin.\n",
    "rand": "Der Kamin steht am Rand vor einer der Waende.\n",
    "rande": "Der Kamin steht am Rand vor einer der Waende.\n",
    "decke": "Die Decke ist aus groben Eichenbohlen gezimmert.\n",
    "wand":
    "An den Waenden haengen verschiedene Gemaelde, sonst sind "
    "sie bis auf eine Liste am Eingang kahl.\n",
    "waende":
    "An den Waenden haengen verschiedene Gemaelde, sonst sind "
    "sie bis auf eine Liste am Eingang kahl.\n",
    "boden": "Der Boden besteht aus abgetretenen Eichenbohlen.\n",
    "bohlen": "Sie sind recht dunkel angelaufen. Das liegt wohl am Alter.\n",
    "eichenbohlen": "Sie sind recht dunkel angelaufen. Das liegt wohl am Alter.\n",
    "alter": "Jeder wird einmal alt.\n",
    "gemaelde":
    "Sie zeigen einige menschliche Helden. Neben einem Gemaelde "
    "befindet sich - kaum sichtbar - eine Leiter, die nach oben fuehrt.\n",
    "leiter": "Wohin sie fuehren mag?\n",
    "helden":
    "Sind alle mehr oder weniger schneidige Gesellen, die auf irgendeine "
    "Weise den Betrachter schief angrinsen und die Waffe stolz praesentieren.\n",
    "gesellen": "Allesamt jung und mit diversen Narben uebersaet.\n",
    "narbe": "Diese machen die Helden nicht huebscher.\n",
    "narben": "Diese machen die Helden nicht huebscher.\n",
    "waffe": "Verschiedene Schwerter, die blutbefleckt sind.\n",
    "schwerter": "Verschiedene Schwerter, die blutbefleckt sind.\n",
    "schwert": "Verschiedene Schwerter, die blutbefleckt sind.\n",
    "blut": "Rotes Blut!\n",
    "trophaeen":
    "Bei den Trophaeen handelt es sich um mehrere angestaubte Pokale aus "
    "golden glaenzendem Material, um verschiedene ausgestopfte Koepfe von "
    "Monstern und Aehnlichem. Daneben befindet sich eine kleine Vitrine.\n",
    "pokale": "Die Pokale wurden wohl in mehreren Wettbewerben gewonnen.\n",
    "pokal": "Die Pokale wurden wohl in mehreren Wettbewerben gewonnen.\n",
    "plaketten": "Auf jedem Pokal prangt eine Plakette.\n",
    "plakette": "Auf jedem Pokal prangt eine Plakette.\n",
    "wettbewerbe":
    "Den Plaketten nach waren es wohl Wettbewerbe in der Art "
    "'Sauf-die-Gegnergilde-nieder', 'Metzelmaniac', 'Armdruecken' ...\n",
    "koepfe": "Davon sind nur die Koepfe da, welche man einzeln betrachten kann.\n",
    "loewenkopf":
    "Was fuer eine zottelige Maehne der Loewenkopf hat. Irgendwer hat sich "
    "einen Spass gemacht und eine rosa Schleife reingebunden.\n",
    "drachenkopf":
    "'Choppits -- Mythenplueschhaendler erste Qualitaet' steht auf einem "
    "kleinen Schieferplaettchen am Halsansatz.\n",
    "stuehle":
    "Sie bestehen aus solidem Eichenholz und laden ein, es sich darauf "
    "bequem zu machen.\n",
    "stuhl":
    "Sie bestehen aus solidem Eichenholz und laden ein, es sich darauf "
    "bequem zu machen.\n",
    "eingang": "Er fuehrt hinaus auf die Strasse (und nach Westen zur Kreuzung).\n",
    "gidhrog": "Gidhrog ist eine Stadt der Menschen.\n",
    "liste": "Versuch doch die Topliste einmal zu lesen ('lies liste').\n",
    "topliste": "Versuch doch die Topliste einmal zu lesen ('lies topliste').\n",
    "kamin": "Im Kamin knistert ein lustiges Feuer.\n",
    "feuer": "Das Feuer macht es hier schoen warm.\n",
  ]);
  smells = ([
    "default":
    "Es riecht nach Schweiss der anwesenden Personen, harzigem Brennholz "
    "und Gebratenem.\n",
    "holz": "Feines Brennholz aus dem Elfenwald, frisch gefaellt.\n",
    "brennholz": "Feines Brennholz aus dem Elfenwald, frisch gefaellt.\n",
    "schweiss":
    "Es riecht nach Abenteurer, Aufregung und interessanten Geschichten.\n",
    "gebratenes": "Er ruehrt vom Kamin her.\n",
  ]);
}

string query_short() { return "Die Gilde der Abenteurer"; }

string query_long() {
  return "Der Raum rings um Dich ist rustikal mit grob gezimmertem Eichenholz\n"
    "bekleidet, das teilweise von einigen Gemaelden verdeckt wird. Mehrere\n"
    "Trophaeen wurden unauffaellig im Raum verteilt, so dass hier kaum noch\n"
    "Platz fuer weiteres ist, ausser einigen Stuehlen und einem Kamin am\n"
    "Rande. Sonst faellt Dir noch eine Liste auf, die neben dem Eingang\n"
    "haengt.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt einen sichtbaren Ausgang: westen.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

string query_read(string s) {
  if (s == "liste" || s == "topliste") {
    return "Gilde der Abenteurer (Zauber der Gilde): blitz, identifiziere, schaetz,\n"
      "pfeil, feuerball, schnell.\n";
  }
  return 0;
}

string query_smell(string s) {
  if (!smells)
    return 0;
  if (!s || s == "")
    s = "default";
  return smells[s];
}

int id(string str) {
  return str == "gilde" || str == "abenteurergilde" || str == "here";
}
