#include <ansi.h>
inherit NPC;
inherit F_NOCLONE;
inherit F_SAVE;

static string *reborn_skill = ({
        "agile", "ghost", "hatred", "jin", "lucky",
        "mystery", "power", "self", "sheng", "trick", "youth",
});
static string *words = ({
        "班", "若", "菠", "萝", "密", "啊", "吗", "咪", "哄",
        "度", "众", "生", "者", "应", "明", "以", "何", "得",
        "有", "空", "净", "相", "我", "虚", "妄", "情", "少",
        "福", "如", "來", "法", "金", "思", "悟", "灭", "失",
});
// 存盘文档
string query_save_file() {
        return DATA_DIR "npc/buddha";
}

mapping reborn_data = ([]);
int ask_reborn();
void remove() { save(); }

varargs mixed query_reborn_data(string ob) {
        if( !ob ) return reborn_data;
        if( !undefinedp(reborn_data[ob]) )
                return reborn_data[ob];
        return 0;
}

int clear_reborn_data(string ob) {
        if( !undefinedp(reborn_data[ob]) ) {
                map_delete(reborn_data, ob);
                return 1;
        }
        return 0;
}

void create()
{
        seteuid(getuid());
        restore();
        set_name(HIY "释迦牟尼" NOR, ({ "buddha", "fo zu", "fo", "shijia muni" }));
        set("long", @LONG
佛祖庄严宝像，让人不敢正视。
LONG);
        set("nickname", HIW "三界法王" NOR);
        set("title", HIC "佛祖" NOR);
        set("gender", "男性" );
        set("age", 500);
        set("attitude", "friendly");
        set("max_jing", 1000099);
        set("max_qi", 1000099);
        set("max_jingli", 1000099);
        set("jingli", 1000099);
        set("max_neili", 1000099);
        set("neili", 1000099);
        set("jiali", 100009);
        set("str", 99);
        set("int", 99);
        set("con", 99);
        set("dex", 99);
        set("combat_exp", 100001000099);

        set_skill("dodge", 10000);
        set_skill("unarmed", 10000);
        set_skill("force", 10000);
        set_skill("parry", 10000);
        set_skill("sword", 10000);
        set_skill("medical", 10000);
        set_skill("literate", 10000);
        set_skill("lamaism", 10000);
        set_skill("buddhism", 10000);
        set_skill("shaolin-yishu", 10000);
        set_skill("idle-force", 10000);
        set_skill("huntian-baojian", 10000);
        set_skill("lunhui-jian", 10000);

        map_skill("force", "huntian-baojian");
        map_skill("parry", "lunhui-jian");
        map_skill("sword", "lunhui-jian");
        map_skill("medical", "shaolin-yishu");

        set("inquiry", ([
                "转世重生" : (: ask_reborn :),
        ]));

        set("chat_chance_combat", 200);
        set("chat_msg_combat", ({
                (: perform_action, "sword.hui" :),
                (: exert_function, "recover" :),
                (: exert_function, "powerup" :),
                (: exert_function, "shield" :),
                (: exert_function, "heal" :),
                (: exert_function, "dispel" :),
                (: exert_function, "regenerate" :),
        }));

        setup();
        carry_object("/clone/cloth/y-jiasha")->wear();
        carry_object("/clone/weapon/changjian")->wield();
        set("startroom", "/d/reborn/heaven");
        check_clone();
}

void init()
{
        add_action("do_zhuanshide", "zhuanshide");
}

int ask_reborn()
{
	    string msg;
        object me;
        string map_skill;
        me = this_player();
        command("look "+me->query("id"));

/*
        if( me->query("reborn/times")){
                command("say 你的阿赖耶识不是已经打开了吗？");
                return 1;
        }
*/
        if ((int)me->query("combat_exp") < 20000000)
        {
                message_vision("$N对$n一拱手，道：经验不够，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

		//if ((int)me->query("learned_points") > 100000)
       // {
       //         message_vision("$N对$n一拱手，道：潜能太多了用掉最多留下十万。\n", 
       //                        this_object(), me);
       //         return 1;
      //  }
        map_skill = me->query_skill_mapped("force");
        if (me->query_skill("force", 1) < 600 ||
            me->query_skill(map_skill, 1) < 600)
        {
                message_vision("$N对$n一拱手，道：内功不够，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        map_skill = me->query_skill_mapped("dodge");
        if (me->query_skill("dodge", 1) < 600 ||
            me->query_skill(map_skill, 1) < 600)
        {
                message_vision("$N对$n一拱手，道：轻功不够，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        map_skill = me->query_skill_mapped("parry");
        if (me->query_skill("parry", 1) < 600 ||
            me->query_skill(map_skill, 1) < 600)
        {
                message_vision("$N对$n一拱手，道：招架不够，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        if (me->query("age") < 16)
        {
                message_vision("$N对$n一拱手，道：年龄小于16，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }
        if (me->query("int") > 1500)
        {
                message_vision("$N对$n一拱手，道：属性大于1500，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        if (me->query("str") > 1500)
        {
                message_vision("$N对$n一拱手，道：属性大于1500，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        if (me->query("con") > 1500)
        {
                message_vision("$N对$n一拱手，道：属性大于1500，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        if (me->query("dex") > 1500)
        {
                message_vision("$N对$n一拱手，道：属性大于1500，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }


      if (me->query_skill("martial-cognize", 1) < 300)
        {
                message_vision("$N对$n一拱手，道：武学修养不够，强求亦是枉然。\n",
                               this_object(), me);
                return 1;
        }

        if (! me->query("breakup"))
        {
                message_vision("$N对$n一拱手，道：你还没有打通过任督二脉呢。\n",
                               this_object(), me);
                return 1;
        }


        if( !me->query_family() )
        {
                command("say 你无门无派，转世得不偿失！");
                return 1;
        }

        command("say 转世中请稍后");

        //message_vision( HIC"$N" HIC"对$n" HIC"道：若你心意已决就"ZJURL("cmds:zhuanshide")+ZJSIZE(20)+"点我转世"NOR"\n",
           //             this_object(), me) ;
  remove_call_out("reborn_player");
        call_out("reborn_player", 3, me, msg);
        me->set_temp("reborn/ask", 1);
        return 1;
}

int reborn_player(object me, string msg)
{
        mapping all_skills, off_skills;
        mapping my, spc_data, tmp_data, mem_data;
        string *sname, *oname, *files;
        string skill, dst;
        object ob;
        int i, n, vip, skill_lvl;
        int money, endtime, day;

        my = me->query_entire_dbase();
        if( my["gender"] == "无性" ) my["gender"] = "男性";

        //off_skills = my["offer"];
        all_skills = me->query_skills();
        //oname = keys(off_skills);
        //oname -= ({ "neili" });
        sname = keys(all_skills);
        n = sizeof(all_skills);
        for( i = 0; i < n; i++ ) {
                if( SKILL_D(sname[i])->type() != "martial" ) {
                        if( all_skills[sname[i]] > 500 )
                                all_skills[sname[i]] = 500;
                } else {
                        if( sizeof(oname) && member_array(sname[i], oname) != -1 ) {
                                if( (skill_lvl = off_skills[sname[i]] - 3000) > 100 )
                                        all_skills[sname[i]] = skill_lvl;
                                else
                                        all_skills[sname[i]] = 100;
                                oname -= ({ sname[i] });
                        } else {
                                if( all_skills[sname[i]] > 100 )
                                        all_skills[sname[i]] = 100;
                        }
                }
        }

        if( (n = sizeof(oname)) > 0 ) {
                for( i = 0; i < n; i++ ) {
                        if( (skill_lvl = off_skills[oname[i]] - 3000) > 100 )
                                all_skills[oname[i]] = skill_lvl;
                        else
                                all_skills[oname[i]] = 100;
                }
        }
				me->set("family", 0);
				me->delete("title");
				me->delete("class");

				me->set("max_jing", 100);
				me->set("jing", 100);				
				me->set("max_jingli", 100);
				me->set("jingli", 100);				
				me->set("max_qi", 100);
				me->set("qi", 100);				
				me->set("max_neili", 100);
				me->set("neili", 100);
				me->set("learned_points", 0);
				me->set("learned_points", 0);

				me->set("combat_exp", 500000);
                me->set("potential", 0);
				

				me->set("gift/str/succeed", 10);
				me->set("gift/shenliwan", 10);
				me->set("gift/dex/succeed", 10);
				me->set("gift/unknowdan", 10);
				me->set("gift/int/succeed", 10);
				me->set("gift/xiandan", 10);
				me->set("gift/con/succeed", 10);
                        me->set("gift/xisuidan", 10);
				my["character"] = "国士无双";
				me->query("level")< 25 && me->add("level", 1);
				me->add("int", 2);
				me->add("str", 2);
				me->add("con", 2);
				me->add("dex", 2);
	                  me->set("zhuanshi",1);	
				me->add("age", 14);		
                        me->set("mud_age", 11111);
		
				me->set("eff_qi", (int)me->query("max_qi"));
				me->set("eff_jing", (int)me->query("max_jing")); 

tell_object(me, HIY "\n佛祖在你耳边说道，转世后可以重新吃故事丹了\n "ZJURL("cmds:recall backk")+ZJSIZE(20)+"点我进入世家选择地"NOR"\n" NOR);

        message("vision",HBRED"【转世重生】天界："+me->query("name")+"("+me->query("id")+")"
                HBRED "已得佛祖点化转世之道，得到人神魔三界庇佑，元神转世重生天魂额外提升1！\n" NOR, users());

        message_vision("只见$N化作一屡轻烟，渐渐消失了……\n", me);
        //UPDATE_D->remove_user(me->query("id"), 0);
        return 1;
}
