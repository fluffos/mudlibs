#include <room.h>
inherit ROOM;
#define FO  "/adm/npc/buddha"
void create()
{
	set("short", "六和顶塔");
	set("long", @LONG
轮回转世之地。
LONG);
	set("exits", ([
	    "down"  : __DIR__"liuhed",
	]));
	set("objects", ([
		//"quest/shenshu/man":1,
	]));
        set("sleep_room", 1);
        set("no_fight", 1);
        set("no_magic", 1);
        set("no_bid", 1);
        setup();
        load_object(FO)->move(this_object());
}
