void create() {
  seteuid(ROOT_UID);
  set("channel_id", "连线");
  if (intp(WIZ_LOCK_LEVEL))
    wiz_lock_level = WIZ_LOCK_LEVEL;
  else
    wiz_lock_level = 0;
}

void logon(object ob) {
  string str;
  if (BAN_D->is_banned(query_ip_number(ob)) == 1) {
    write(ZJTMPSAY "你的地址在本 MUD 不受欢迎。\n");
    destruct(ob);
    return;
  }
  write("\n");
  str = ZJKEY;
  write("ver1.0," + str + "\n");
  input_to("jiance", ob, str);
}
