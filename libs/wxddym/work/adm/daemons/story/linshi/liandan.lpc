// story:pangtong.c

#include <ansi.h>

static string char_id;
static string char_name;

object select_character();
int give_gift();

static mixed *story = ({
  "三十三重天外紫霄宫中。",
  "“鸿钧老祖盘中当中？”",
  "只见他伸手一招采集先天混沌之气",
  "投入了面前的丹炉中！",
  "两个童子拼命的煽火，只见炼丹炉中的火愈来愈旺",
  "一年过去了...",
  "十年过去了...",
  "一百年过去了...",
  "一千年过去了...",
  "鸿钧老祖口中念念有词：疾！",
  "两个童子连忙开炉，一颗黑黝黝散发着恶臭的仙丹腾空而起。",
  "鸿钧老祖举着仙丹看了半天，叹道：不知道这仙丹能不能发挥作用。",
  "太上老君长叹一声，道：还是丢下去给凡人试试吧。",
  "$N漫步在山间... 咦？这是什么？",
  "地上有一坨黑乎乎的丹药？",
  "$N拿起来看了看，捏了一下。",
  "“咔擦，丹药外壳被捏开了，里面出现一粒金光闪闪的丹药",
  "“嗯？超级先天神丹？”",
  (: give_gift :),
});

void create() {
  seteuid(getuid());
  if (!objectp(select_character())) {
    STORY_D->remove_story("pangtong");
    destruct(this_object());
    return;
  }
}

string prompt() { return HIW "【混沌神丹】" NOR; }

object select_character() {
  object *obs;
  object ob;

  obs = filter_array(all_interactive(), (: !wizardp($1) &&
    living($1) &&
    $1->query_skill("literate", 1) > 50 &&
    !$1->query("doing") :));
  if (!sizeof(obs))
    return 0;

  ob = obs[random(sizeof(obs))];
  char_id = ob->query("id");
  char_name = ob->name(1);
  return ob;
}

mixed query_story_message(int step) {
  mixed msg;

  if (step >= sizeof(story))
    return 0;

  msg = story[step];
  if (stringp(msg)) {
    msg = replace_string(msg, "$N", char_name);
    msg = replace_string(msg, "$ID", char_id);
  }
  return msg;
}

int give_gift() {
  object ob;
  object gob;

  ob = find_player(char_id);
  if (!ob) return 1;

  STORY_D->remove_story("liandan");

  gob = new("clone/vip/2dan/lishen2");
  gob->move(ob, 1);
  CHANNEL_D->do_channel(this_object(), "rumor", "听说" + ob->name(1) +
    "捡到了2级先天神丹，最多能提升先天到+20。");
  return 1;
}
