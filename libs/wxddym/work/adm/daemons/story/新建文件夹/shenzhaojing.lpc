// story:shenzhaojing

#include <ansi.h>

static string char_id;
static string char_name;

int give_gift();
object select_character();

static mixed *story = ({
  "叮呤几下兵器相交之声传了过来。",
  "谢烟客心中一凛，托起石破天，几个起落之后，已经到了一棵大树之后。",
  "两人在树后望去，只见林中有四人相斗，乃是三人夹攻一人。",
  "谢烟客凝神一看，原来被围攻的却是少林无名老僧，另外三人却不认得，只是武功非同泛泛。",
  "无名老僧已然不敌，转身飞快的向后面树林逃去，并留下一本经书。",
  "战斗结束，$N路过看到地上有一本书捡起来一看，原来是武林绝学，《神照经》。",
  (: give_gift :),
});

void create() {
  seteuid(getuid());

  if (!objectp(select_character())) {
    STORY_D->remove_story("shenzhaojing");
    destruct(this_object());
    return;
  }
}

string prompt() { return HIG "【武林奇遇】" NOR; }

object select_character() {
  object *obs;
  object ob;

  obs = filter_array(all_interactive(),
    (: living($1) &&
    $1->query_skill("shenzhaojing", 1) < 1 &&
    $1->query("combat_exp") >= 2000000 &&
    $1->query("combat_exp") < 5000000 &&
    SKILL_D("shenzhaojing")->valid_learn($1) &&
    !wizardp($1) &&
    !$1->query("story/shenzhaojing") :));
  if (!sizeof(obs))
    return 0;

  ob = obs[random(sizeof(obs))];
  char_id = ob->query("id");
  char_name = ob->name(1);
  return ob;
}

mixed query_story_message(int step) {
  mixed msg;

  if (step >= sizeof(story))
    return 0;

  msg = story[step];
  if (stringp(msg)) {
    msg = replace_string(msg, "$N", char_name);
    msg = replace_string(msg, "$ID", char_id);
  }
  return msg;
}

int give_gift() {
  object ob;
  object book;

  ob = find_player(char_id);
  if (!ob) return 1;

  if (ob->query_skill("shenzhaojing", 1) < 50)
    ob->set_skill("shenzhaojing", 50);

  ob->set("story/shenzhaojing", 1);
  tell_object(ob, HIC "你学习到了神照经。" NOR "\n");
  CHANNEL_D->do_channel(this_object(), "rumor", "听说$N习得神照经，准备称霸武林。");
  book = new("/clone/book/shenzhaojing");
  book->move(ob, 1);
  STORY_D->remove_story("shenzhaojing");
  return 1;
}
