// story:caishen 财神

#include <ansi.h>

int give_gift(string money, int amount, string name);

static mixed *story = ({

  HIC "猫仙人今天很高兴",
  HIR "猫仙人所以要炼丹", /*
HIC"猫仙人练制天赋能力丹",
HIR"猫仙人要丢掉仙丹",
HIC"猫仙人今天很高兴",
HIC"三十三重天外紫霄宫中。",
HIG"“猫仙人盘坐当中？”",
HIM"只见他伸手一招低上一堆泥巴",
HIY"投入了面前的丹炉中！",
HIC"两个童子拼命的煽火，只见炼丹炉中的火愈来愈旺",
HIG"一年过去了...",
HIM"十年过去了...",
HIY"一百年过去了...",
HIC"一千年过去了...",
HIG"猫仙人口中念念有词：疾！",*/
  HIM "两个童子连忙开炉，岂料，一不小心，打翻了炼丹炉子。一堆丹药散落人间。",

  HIC "猫仙人长叹一声，道：算了也让凡人尝尝仙丹的滋味。",

  "猫仙人口中念念有词：此乃天赋能力精华！。",
  (: give_gift, "tianfu5", 1, "天赋能力神丹" :),

  "猫仙人口中念念有词：此乃天赋能力精华！。",
  (: give_gift, "tianfu1", 1, "天赋能力神丹" :),

  "猫仙人口中念念有词：此乃天赋能力精华！。",
  (: give_gift, "tianfu2", 1, "天赋能力神丹" :),

  "猫仙人口中念念有词：此乃天赋能力精华！。",
  (: give_gift, "tianfu3", 1, "天赋能力神丹" :),

  "猫仙人口中念念有词：此乃天赋能力精华！。",
  (: give_gift, "tianfu4", 1, "天赋能力神丹" :),
  HIG "一年过去了...",

});

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift(string money, int amount, string name) {
  STORY_D->give_gift("/clone/vip/tianfu/" + money, amount,
    HIM "\n“啪”的一声一些" + name + "掉到你面前。" NOR "\n");
  return 1;
}
