
// tomcat

inherit __DIR__"fei.c";

// here should be this NPC specific skills.

void set_skills()
{
        object me=this_object();
        object weapon;

        int j;
        j= 200+random(150);  	
        create_family("峨嵋派", 3, "弟子"); 
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
          me->set_skill("sword", j+random(15));
          me->set_skill("huifeng-jian", j+random(15));
          me->set_skill("zhutian-bu", j+random(15));
          me->set_skill("tiangang-zhi", j+random(15));
          me->map_skill("force", "linji-zhuang");
          me->map_skill("sword", "huifeng-jian");
          me->map_skill("parry", "huifeng-jian");
          me->map_skill("dodge", "zhutian-bu");
          me->map_skill("unarmed", "tiangang-zhi");
	set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
          (: perform_action,"mie" :),
        }) );

     carry_object("/clone/weapon/changjian")->wield();
}
