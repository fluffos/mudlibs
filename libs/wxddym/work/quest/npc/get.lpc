#include <ansi.h>
inherit NPC;
void create()
{
  object ob;
    set_name("流氓",({"liumang","getter"}) );
  set("long","他长得奸嘴猴腮的，一看就不像是个好人。\n");
  set("race", "人类");
  set("gender","男性");
  set("combat_exp",7000);
  set("age",19);
//  set("帮派","紫薇堂");
  set("str",10000);
  set("per",300);
  add_temp("apply/dodge", 300);
            set("chat_chance", 40);
        set("chat_msg", ({
                (: random_move :),
        }));

setup();
}
void init()
{
    object ob;
  ::init();
  if( interactive(ob = this_player())&& !is_fighting() ) {
    remove_call_out("greeting");
    call_out("greeting",1 , ob);   }
}

void greeting(object ob)
{
            command("wield dao");
        command("get all");
command("kill da mao");
// 大猫很烦的  cii
}

