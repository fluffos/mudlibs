inherit "inherit/char/boss";
#include <ansi.h>
int big_blowing();
void create()
{
set_name(HIR"烈火孽龙"NOR, ({ "fire dragon king", "dragon king", "dragon" }) );
set("race", "野兽");
set("gender", "雄性");
set("age", 200);
set("long",
"这是一条全身赤红，吸天地之间的火气而长大的孽龙！
它全身散发着赤红色的火焰。\n");

set("str", 248);
set("con", 252);
set("dex", 222);

set_skill("dodge", 599);
set_skill("force", 599);
set_skill("unarmed", 599);
set_skill("parry", 599);
set("max_qi", 80000);
set("max_jing", 99999);
set("max_neili", 900010);
set("neili", 900010);
set("jiali", 300);
set("attitude", "aggressive");
set("limbs", ({ "头部", "身体", "尾巴" }) );
set("verbs", ({ "bite", "claw" }) );
set("death_msg", "$N化作一缕清风而去。\n");
set("chat_chance_combat", 120);
set("chat_msg_combat", ({
(: big_blowing :)
}) );

set("combat_exp", 901100000+random(600110000));
set("bellicosity", 30000 );
set("level", 100);

set_temp("apply/attack", 300+random(300));
set_temp("apply/unarmed_damage",300+random(300));
set_temp("apply/armor", 300+random(300));
set_temp("apply/add_weak", 70);
set_temp("apply/reduce_damage", 90);
set_temp("apply/reduce_busy", 20);
set_temp("apply/add_busy", 5);

set("rewards", ([
"exp"   : 40000,
"pot"   : 10000,
"mar"   : 1000,
"score" : 600,
"gold"  : 100,
]));
set("drops", ([
"MO&A3000"       :       3,
"MO&A3001"       :       3,
"MO&A3002"       :       3,
"MO&A3003"       :       3,
"MO&A3004"       :       3,
"FI&/clone/gift/cdiamond"   :   1,
"FI&/clone/gift/crystal"   :   1,
"FI&/clone/gift/cagate"   :   1,
"FI&/clone/gift/ccrystal"   :   1,
"FI&/clone/gift/cjade"   :   1,
]));

setup();
carry_object("/clone/money/gold")->set_amount(200);
}
int big_blowing()
{
message_vision( HIR "\n\n烈火孽龙深深地吸入一口气，全身转为鲜红的火色，整个龙腹胀大了几倍！！\n\n" NOR,
this_object());
call_out("hurting", random(2)+1);


return 1;
}

int hurting()
{
int i;
int dam;
object *inv;
message_vision( HIR "\n\n烈火孽龙吐出一股炽可焚金的火焰．．整个天地似乎都被燃烧着！！！\n\n",this_object());
inv = all_inventory(environment(this_object()));
for(i=sizeof(inv)-1; i>=0; i--)
if( living(inv[i]))
if( inv[i] != this_object())
{
dam = 200+random(200);
inv[i]->receive_wound("qi",dam, this_object());
inv[i]->receive_wound("jing",dam/2, this_object());
inv[i]->affect_by("poison",
  ([ "level" : 850,
     "id":query("id", this_object()),
     "name" : "烈火孽龙的火毒",
     "duration" : 200 ]));
tell_object(inv[i], HIG "你中了烈火孽龙的火毒。\n");
COMBAT_D->report_status(inv[i],1);
}
return 1;
}

void die()
{
object obj, env;
object killer;
object ob, me;
int exp;
int userexp;
int i;
int boss_reward,lvl;

boss_reward = "/adm/daemons/actiond"->query_action("boss_reward");
me = this_object();
lvl = me->query("level");
if (objectp(ob = previous_object(0)) &&
    sscanf(base_name(ob), "/kungfu/skill/%*s"))
{
me->full_self();
add_temp("apply/attack", 300+random(300));
add_temp("apply/unarmed_damage",300+random(300));
add_temp("apply/armor", 300+random(300));
return;
}

if (! query("have_reborn"))
{
set("have_reborn", 1);
me->full_self();
return;
}
env = environment(this_object());
if (objectp(killer=this_object()->query_last_damage_from()))
{
userexp=killer->query("combat_exp");
exp=(((killer->query("literate")*4)+random(10000)+40000+userexp/60000)*boss_reward)+((((killer->query("literate")*4)+random(10000)+40000+userexp/60000)*lvl)/10);

if( !killer->query_temp("m_success/孽龙") )
{
killer->set_temp("m_success/孽龙", 1);
killer->add("combat_exp", exp);
killer->add("potential", 5000);
message("channel:chat",HBMAG"【精灵神界】"+killer->query("name")+"成功地杀死了恶龙，解开了封印!得到无数经验和潜能.\n"NOR,users());

message_vision(MAG "一道红光从天而降，照耀着$N。\n" NOR, killer);
message_vision(HIR "一团火焰猛地升腾，一个声音说道：谢谢你们解开了封印，这些物品就作为谢礼吧！！！\n" NOR, this_object());
obj = new("/clone/fam/pill/linghui3");
obj->set_amount(random(5));
obj->move(environment(this_object()));

obj = new("/clone/money/gold");
obj->set_amount(random(50));
obj->move(environment(this_object()));
}
}
env->set("exits/north", "/d/city/wumiao");

message_vision("$N化作一缕清风而去。\n", this_object());
destruct(this_object());

return ::die();
}

void unconcious()
{
object ob;

if (objectp(ob = previous_object(0)) &&
    sscanf(base_name(ob), "/kungfu/skill/%*s"))
{
this_object()->full_self();
return;
}

die();
}

mixed hit_ob(object me, object ob, int damage_bouns)
{
int damage;

damage = 300 + random(300);
damage-=ob->query_temp("apply/reduce_fire");
if (damage < 0) damage = 0;
ob->receive_damage("qi", damage, me);
ob->receive_wound("qi", damage, me);
me->set("neili",me->query("max_neili"));
return HIR "$N" HIR "“吼”的一声吐出一鼓火焰，登时令$n"
       HIR "感觉犹如整个天地似乎都被燃烧着。\n" NOR;
}