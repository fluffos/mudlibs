inherit NPC;
#include <ansi.h>
int place_room(object me,object ob);
string ask_kill();
void create()
{
        set_name(HIR"单正"NOR, ({ "shan zheng", "shan"}));
        set("gender", "男性");
        set("age", 75);
        set("title", CYN"[铁面判官]"NOR);
        set("long","他就是疾恶如仇，刚正不阿，江湖人称[铁面判官]的单正。\n");      
        set("combat_exp", 30000000);
        set("shen_type", 0);
        set("max_neili", 500000);
        set("neili", 500000);
        set("max_qi",40000);
        set("max_jing",20000);
        set("max_jingli",20000);
        set("jingli",20000);
        set("per",25);
        set("jiali", 400);
        set_skill("force", 500);
        set_skill("unarmed", 500);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("jiuyang-shengong",500);

    set("chat_chance", 5);
    set("chat_msg", ({  
CYN"单正面色一沉，正言道：“大丈夫立世，人品第一，武功的高低倒在其次，
若不能行侠仗义，惩恶扬善，当真苟存于天地间了！”\n"NOR
    }));

        set("inquiry", ([
                "行侠仗义" : (: ask_kill :),
                "惩恶扬善" : (: ask_kill :)
             ]) );    

        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage", 50);
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}

string ask_kill()
{   
    int kill_count,reward;
    object me,killer;
    me=this_player();

 if(me->query("combat_exp")<500000)
     return CYN"你乳臭未刚，怕是不行哟！\n"NOR;

 if(me->query("shan_quest") && me->query_temp("shan_quest/have_task"))
     return 
        CYN"你不是要了个任务吗？不想干就拿些钱出来，我好请别人！\n"NOR;   

 if(!me->query_temp("shan_quest/killed")
      && (time()-me->query("shan_quest/time"))<800)
   return 
    CYN"交给你的任务居然玩忽职守，如果没能力就拿些钱出来，我好请别人去！\n"NOR; 

 if( me->query_temp("shan_quest/count") > 14)
   {
     me->set_temp("shan_quest/count",0);
     me->set_temp("shan_quest/quest_cancel",0);
     if( me->query("PKS") && random(2))
     {
      command("chat* haha "+me->query("id"));
      command("chat 知错能改，善莫大焉！孺子可教也！！");
      tell_object(me,
      HIY"恭喜你！由于你行侠仗义，力赎自身罪愆，江湖中对你已是有口\n"
        +"皆碑，你以往的杀人之过已被大家宽恕了！\n"NOR);
      me->add("PKS",-1);
     }
     me->add("score",100+random(200));
     return
     CYN"你已经累了一天了，老夫吩咐你的任务都完成了，先回去歇息吧。\n"NOR; 
   }  

 if((time()-me->query_temp("shan_quest/wait_start")) < 30)
   return 
      CYN"这么快就完成任务啦？你先去休息一下，过会还有任务呢。\n"NOR; 

   killer=new(__DIR__"quest_killer");
   place_room(me,killer);
   killer->start_escape(killer,me);
   me->set("shan_quest/killed",killer->query("id"));
   me->set("shan_quest/killed_name",killer->query("name"));
   me->set("shan_quest/killed_place_name",killer->query("area"));
   me->set("shan_quest/time",time());
   me->set_temp("shan_quest/have_task",1);
   me->set_temp("shan_quest/being_inquiry",1);  
   return
     HIC"难得"+me->query("name")+"有如此侠义心肠，老夫近日获悉在\n"
       +killer->query("area")+"一带有一名杀人狂魔为患，你就"
       +"先去调查一下情况，\n根据我的资料，这个人的名字好象叫"
       +killer->query("name")+"("+killer->query("id")+")"
       +"，\n把他的门派底细弄清楚后立刻回来报告！\n"NOR;  
}


void init()
{
     object ob;

     ob=this_player();
     if(ob->query_temp("shan_quest/inquiry"))
     {
      message_vision(HIC"单正面露微笑，朝$N点头道：“你回来啦，"
           +"可曾查到什么没有？”\n"NOR
           +CYN"请用 answer <门派> 回答！\n"NOR,ob);
      add_action("do_answer","answer");
     }
}

int do_answer(string arg)
{
     object ob,killer;
     object gold;
     int amount;

     ob=this_player();
     if(!ob->query_temp("shan_quest/inquiry"))
     {
        message_vision(
        HIY"单正怒道：“还不快去，在这里磨蹭什么？\n"NOR,ob); 
        return 1;
     } 

     killer=find_living(ob->query("shan_quest/killed"));
     if(!arg) return notify_fail("请用 answer <门派> 回答！\n");

     if(!objectp(killer))
     {
      message_vision(
          HIW"单正为难地说道：“辛苦你了，可是这人好象失踪了！\n"NOR,ob);
      ob->set_temp("shan/have_task",0);
      ob->delete_temp("shan_quest/inquiry");
      ob->delete_temp("shan_quest/being_inquiry");
      return 1;
     }

     if(arg!=killer->query("family/family_name"))
     {
      message_vision(HIW"单正脸色一沉道：“胡说！哪里是什么"+arg
          +"，你给我再去查查看！”\n"NOR,ob);
      ob->delete_temp("shan_quest/inquiry");
      return 1;
     } else
     {
      message_vision(HIW"单正面露微笑，点头赞许道：“不错，不错，正是"+arg
         +"，和我想的一样！”\n"+"我得到消息说"+killer->query("name")
         +"已逃到了"+killer->query("area")
         +"，正在那里行凶，请你立刻赶去除掉他吧！\n"NOR,ob);

      amount=(1+ob->query_temp("shan_quest/count"))*2;
      gold=new("/clone/money/gold");
      gold->set_amount(amount);
      gold->move(ob);
      message_vision(
        MAG"单正顿了顿，接着道：“对了，你一路辛苦，花费也去了不少吧？\n"
       +"这里有"+sprintf("%d两黄金，就全当给你些酬劳吧，可别嫌少呀！”\n"NOR
       +WHT"单正说完，转身走入书房，拿出一封金锭交给你。\n"NOR,amount), ob); 

      ob->delete_temp("shan_quest/inquiry");
      ob->delete_temp("shan_quest/being_inquiry"); 
      ob->set_temp("shan_quest/being_chased",1); 
      ob->set_temp("shan_quest/bandit",random(2)+2);
      ob->set("shan_quest/killed_place_name",killer->query("area"));
      killer->start_chase(ob);
      killer->start_kill(ob);   
      return 1;
      }
}

int accept_object(object who, object ob)
{
        object killer;
        int money=5*(1+who->query_temp("shan_quest/count"));
        if (ob->query("money_id"))
        {
             if(!who->query_temp("shan_quest/have_task"))
             {
                   message_vision("单正笑道：那我可就不客气了。\n",who);
             }

             if ( ob->value() < 10000*money) 
             {
             message_vision(
                "单正一双尖针般的眼睛直盯着$N：这点钱可不够我们的开销！\n"
                +"最少也要"+sprintf(HIR" %d "NOR+"两"+HIY"黄金"NOR+"啊！\n",
                  money),who);
             } else
             {
             message_vision(
                "单正笑道：那好，咱们买卖不成仁义在。想要好处再找我吧！\n",who);
             call_out("quest_cancel",1,who);
             }

             call_out("destruct_me",2,ob);
             return 1;
        }
     return 0;
}

int destruct_me(object ob)
{
    destruct(ob);
    return 1;
}

int quest_cancel(object who)
{
             object killer;   

             who->set_temp("shan_quest/have_task",0);
             who->add_temp("shan_quest/quest_cancel",1); 
             if(who->query("shan_quest/killed"))
              killer=find_living(who->query("shan_quest/killed"));

             who->set_temp("shan_quest/killed","canceled"); 
             if(killer)
              killer->escape_me(killer,who);   

       return 1;
}

#include "quest_kill.h"  

