int ask_zs3()
{
    int i,temp;
    object obj;
	mapping hp_status, skill_status, map_status, prepare_status;
	mapping my;
	string *sname, *mname, *pname;

	obj=this_player();

    if (obj->is_fighting())
        return notify_fail("你正打的热闹着呢!\n");

     if(obj->is_busy())
        return notify_fail("你现在正忙，没法杀人。\n");

    if ( !userp(obj))
        return notify_fail("这不是玩家啊?\n");

    if ( !obj->query("zhuanshen2"))
	{
		command("say 你没经过三转!");
        return notify_fail("此人没经过三转!\n");
	}

    if ( obj->query("zhuanshen3"))
	{
		command("say 你已经转生过了!");
        return notify_fail("此人已经转生过了!\n");
	}

    if ( (int)obj->query("combat_exp") < 72000000 )
	{
		command("say 你没有资格4转!4转需要7200万经验 ");
        return notify_fail("此人没有资格4转!4转需要7200万经验\n");
	}

    obj->set("eff_qi",obj->query("max_qi"));
    obj->set("qi",obj->query("max_qi"));
    obj->set("eff_jing",obj->query("max_jing"));
    obj->set("jing",obj->query("max_jing"));
    obj->set("jingli",obj->query("max_jingli"));
    obj->set("neili",obj->query("max_neili"));
    obj->set("food",obj->max_food_capacity());
    obj->set("water",obj->max_water_capacity());
    obj->clear_condition();
	if (mapp(skill_status = obj->query_skills()))//判断自己是否有功夫，如有将用这个函数全部删除
	{
		skill_status = obj->query_skills();
		sname = keys(skill_status);//传回所有自己的功夫阵列

		temp = sizeof(skill_status);
		for (i = 0; i < temp; i++)
			obj->delete_skill(sname[i]);
	}
		obj->map_skill("unarmed");
		obj->map_skill("hammer");
		obj->map_skill("blade");

		obj->map_skill("staff");
		obj->map_skill("club");
		obj->map_skill("throwing");
		obj->map_skill("parry");
		obj->map_skill("dodge");


		obj->map_skill("leg");

		obj->map_skill("array");
		obj->map_skill("whip");
		obj->map_skill("finger");
		obj->map_skill("hand");
		obj->map_skill("cuff");
		obj->map_skill("claw");
		obj->map_skill("strike");

		obj->prepare_skill("unarmed");
		obj->prepare_skill("hammer");
		obj->prepare_skill("blade");

		obj->prepare_skill("staff");
		obj->prepare_skill("club");
		obj->prepare_skill("throwing");
		obj->prepare_skill("parry");
		obj->prepare_skill("dodge");


		obj->prepare_skill("leg");

		obj->prepare_skill("array");
		obj->prepare_skill("whip");
		obj->prepare_skill("finger");
		obj->prepare_skill("hand");
		obj->prepare_skill("cuff");
		obj->prepare_skill("claw");
		obj->prepare_skill("strike");
        obj->reset_action();

		obj->add("per",20);
		obj->add("str",20);
		obj->add("dex",20);
		obj->add("int",20);
		obj->add("con",20);
		obj->add("kar",20);

        obj->set("betrayer",0);
        obj->set("title","普通百姓");
        obj->set("class","0");
        obj->set("score",0);
        obj->set("shen",0);
        obj->set("max_neili",100);
        obj->set("max_qi",200);
        obj->set("max_jing",200);
        obj->set("max_jingli",200);
        obj->set("combat_exp",60000);

        obj->set("MKS",0);
        obj->set("shen",1);
        obj->set("meili",0);
        obj->set("normal_die",0);
        obj->set("weiwang",0);
        obj->set("mud_age",0);
		obj->set("age",14);
		obj->set("honors",0);
		obj->set("zhuanshen3",1);
		obj->set("magic_points",0);

        obj->delete("gift");
        obj->delete("detach");
        obj->delete("family");
        obj->delete("bunch");
        obj->delete("party");
		obj->delete("death");
		obj->delete("last_die");
		obj->delete("dietimes");
		obj->delete("opinion");
		obj->delete("work/zhujian");
		obj->delete("work/zhudao");
		obj->delete("work/zhubanzi");
		obj->delete("work/buyu");
		obj->delete("work/dalie");
		obj->delete("work/zhaojiu");
		obj->delete("work/zhujia");
		obj->delete("work");
		obj->delete("breakup");
		obj->delete("animaout");

        obj->save();
		write(HIR"转生成功,请重新登陆!\n"NOR);
		tell_object(obj,HIR"转生成功,请重新登陆!\n"NOR);
		log_file("static/ZS",sprintf("%s 四转，时间: %s\n", geteuid(obj), ctime(time())) );
        CHANNEL_D->do_channel(this_object(), "rumor", "听说" + obj->name(1) + "四转了。");
		"/cmds/usr/quit"->main(obj);

    return 1;

}


