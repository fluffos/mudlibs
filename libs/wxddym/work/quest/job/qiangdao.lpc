// qiangdao.c 强盗
inherit NPC;
#include <ansi.h>
void move();

void create() {
  set_name(HIW "强盗" NOR, ({ "qiang dao", "dao", }));
  set("gender", "男性");
  set("age", 28);
  set("long", "他是一个专靠打劫营生的强盗。\n");

  set("combat_exp", 1000);
  set("attitude", "peaceful");

  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  set("str", 30);
  set("per", 18);
  set("food", 400);
  set("water", 400);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  add_money("silver", 10);
}

void init() {
  remove_call_out("leave");
  call_out("leave", 300);
}

void leave() {
  object ob = this_object();
  if (!ob->is_fighting()) {
    message_vision(HIC "强盗钻进路边的杂草，不见了。\n" NOR, this_object());
  } else call_out("leave", 10);
}

void die() {
  object me = this_object()->query_last_damage_from();
  object corpse, money;
  int jy, qn, n, lvl, ww, ym;
  if (n = ACTION_D->query_action("yamen_reward"))
    ym = me->query("yamen");
  lvl = me->query("level");
  // jy=(400+random(100))*n+(400+random(100))*lvl/10;
  // qn =(400+random(100))*n+(400+random(100))*lvl/10;	
  ww = 50 + random(50);
  // me->add("combat_exp", jy);
  // me->add("potential", qn);
  me->add("weiwang", ww);
  me->add("xy_money", 5);
  me->add("yamen", -1);
  me->delete("kill_qiangdao");
  message_vision(HIR "\n强盗倒在地上，挣扎了几下就死了。\n" NOR, me);
  message_vision(HIW "$N被奖励了：\n"
    +chinese_number(jy) + "点实战经验，\n"
    +chinese_number(qn) + "点潜能，\n"
    +chinese_number(ww) + "点威望。" + chinese_number(5) + "点元宝。\n"
    "还剩" + chinese_number(ym) + "次衙门任务。\n" NOR, me);
  destruct(this_object());

}
