#pragma save_binary
#include <dbase.h>
#include <ansi.h>;

//计算升级需要最大的经验
int level_max_exp(object me)
{
   int max_exp,lvl;
   lvl=(int)me->query("level");
   if(lvl<5)
    max_exp=lvl*10+10000;
   if(lvl<10 && lvl>4)
    max_exp=lvl*15+200000;
   if(lvl<20 && lvl>9)
    max_exp=lvl*20+500000;
   if(lvl<30 && lvl>19)
    max_exp=lvl*30+1000000;
   if(lvl<40 && lvl>29)
    max_exp=lvl*40+2000000;
    if(lvl<50 && lvl>39)
    max_exp=lvl*50+3000000;
     if(lvl<60 && lvl>49)
    max_exp=lvl*100+5000000;
      if(lvl<70 && lvl>59)
    max_exp=lvl*150+8000000;
   if(lvl<80 && lvl>69)
    max_exp=lvl*200+9000000;
   if(lvl<90 && lvl>79)
    max_exp=lvl*300+10000000;
    if(lvl<100 && lvl>89)
    max_exp=lvl*400+15000000;
    if(lvl<200 && lvl>99)
    max_exp=lvl*500000+50000000;
    if(lvl<2000 && lvl>199)
    max_exp=lvl*600000+1000000000;
   return max_exp;
}
//升级判断--升级不会消耗实战经验。
varargs void improve_level(object me)
{
    int exp_num;
    exp_num=me->query("combat_exp");
    if(exp_num >= level_max_exp(me))
    {
       tell_object(me, HIG"只见一阵绚丽的光芒从你身上闪过  \n"+NOR);
       printf(HIC"≡"HIY"────────────────────────────"HIC"≡"NOR"\n");
       tell_object(me, HIR" 恭喜:"+NOR" 你的 "+YEL+"天魂 "HIY" 提升了 ↑"+NOR"！"+HIG"研究效果与消耗加倍 "+NOR+"\n");
     
       if(exp_num>=level_max_exp(me))
       {
           //me->add("level",1);
       //me->add("tianfu_point",1);
         
       }
       else
       {
           // me->set("combat_exp",0);
              //me->add("level",1);
       }
       printf(HIC"≡"HIY"────────────────────────────"HIC"≡"NOR"\n");
     }
     else
     {
          write(HIR"你的实战经验不足以提升等级!"NOR"\n");
     }
}
//提升天赋点数
varargs void up_tianfu(object me)
{
	int i;
	if((int)me->query("tianfu_point"))
	{
		i=random(1000);
		write(HIY"你将一点宝贵的「能力点」灌注进了身体，顿时一片金光闪过。"NOR"\n");
		
		if(i>1 && i<=50)
		{
			me->add("research_times",100) ;
			write(HIR"恭喜：   "HIG"你的「研究次数」增加了!"NOR"\n");
		}
            
		if(i>200 && i<=300)
		{
			me->add("xueliang",50) ;
            me->add("max_qi",50) ;
			write(HIR"恭喜：   "HIG" 你的「气血上限」增加了!"NOR"\n");
		}
		if(i>300 && i<=400)
		{
			me->add("jli",50) ;
            me->add("max_jingli",50) ;
			write(HIR"恭喜：   "HIG"你的「精力上限」增加了!"NOR"\n");
			}
			if(i>400 && i<=450)
		{
			me->add("apply/xuruo_perform",5) ;
			write(HIR"恭喜：   "HIG"你的「削弱对手绝招」增加了!"NOR"\n");

		}
		if(i>450 && i<=500)
		{
			me->add("apply/no_perform",1) ;
			write(HIR"恭喜：   "HIG"你的「封印对手绝招」增加了!"NOR"\n");
		}
        if(i>500 && i<=550)
		{
			me->add("reduce_damage",50) ;
			write(HIR"恭喜：   "HIG"你的「化解伤害」增加了!"NOR"\n");
		}
		 if(i>550 && i<=600)
		{
			me->add("reduce_busy",2) ;
			write(HIR"恭喜：   "HIG"你的「化解忙乱」增加了!"NOR"\n");
		}
       if(i>600 && i<=650)
		{
			me->add("apply/add_damage",50) ;
			write(HIR"恭喜：   "HIG"你的「追加伤害」增加了!"NOR"\n");
		}
		 if(i>650 && i<=700)
		{
			me->add("apply/xuruo_damage",1) ;
			write(HIR"恭喜：   "HIG"你的「虚弱对手伤害」增加了!"NOR"\n");
		}
       if(i>700 && i<=750)
		{
			me->add("apply/xuruo_status",1) ;
			write(HIR"恭喜：   "HIG"你的「对手战力削弱」增加了!"NOR"\n");
		}
		 if(i>750 && i<=800)
		{
			me->add("apply/perform_dp",5) ;
			write(HIR"恭喜：   "HIG"你的「绝招防御」增加了!"NOR"\n");
		}
       if(i>800 && i<=850)
		{
			me->add("apply/add_armor",50) ;
			write(HIR"恭喜：   "HIG"你的「追加防御」增加了!"NOR"\n");
		}
		 if(i>850 && i<=900)
		{
			me->add("apply/no_exert",1) ;
			write(HIR"恭喜：   "HIG"你的「敌人内息絮乱」增加了!"NOR"\n");
		}
       if(i>900 && i<=910)
		{
			me->add("apply/busy_time",1) ;
			write(HIR"恭喜：   "HIG"你的「忙乱敌人」增加了!"NOR"\n");
		}
		     if(i>910 && i<=1000)
		{
			me->add("apply/attack",50) ;
			write(HIR"恭喜：   "HIG"你的「命中加成」增加了!"NOR"\n");
		}

		me->add("tianfu_point",-1);
	}
	else
	{
		write(HIR"你的能力点不足以提升实力! "NOR"\n");
	}
}


 //随机提升装备的特殊技能等级
varargs void up_skills(object me)
{
   int skill_point;
   mixed me_skills;
   mixed sky_skills;
   mapping skills;
   int i;
   int exp,level;
   me_skills=me->query_skill_map();
   if(sizeof(me_skills))
   {
        if((int)me->query("skill_point"))
       {
            i=random(sizeof(me_skills));
            sky_skills=keys(me_skills);
            skills=me->query_skills();
            exp=me->query("combat_exp");
            level=skills[me_skills[sky_skills[i]]];
            if(level*level*level/10 < exp)
            {
                 skills[me_skills[sky_skills[i]]]++;
            tell_object(me, "你消耗了一个技能点，只见一阵"HIM"紫色"NOR"的光芒从你身上闪过！！！  \n"+NOR);
            printf(HIC"≡"HIY"────────────────────────────"HIC"≡"NOR"\n");
            tell_object(me,HIR"  恭喜："NOR" 你的特殊武功"MAG" [ "+to_chinese(me_skills[sky_skills[i]])+" ]"NOR" 提升了 "HIM"↑"NOR" ."NOR"\n");
            printf(HIC"≡"HIY"────────────────────────────"HIC"≡"NOR"\n");
            me->add("skill_point",-1);
            }
            else
            {
              write(HIR"你的经验不足以支持技能的提升!"NOR"\n");
            }

       }
        else
       {
           write(HIR"你的技能点不足!"NOR"\n");
       }
   }
   else
   {
        write(HIR"技能点只能提升装备着的特殊武功!"NOR"\n");
   }

}

