// save.c

void prepare_save() {
  object me = this_object();
  me->save_inventory();  //保存身上道具

}

int save() {
  string file;

  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file + __SAVE_EXTENSION__);
    return save_object(file);
  }

  return 0;
}

int saveone() {
  object me = this_object();
  string file;
  //GM不用存盘
  //if(wizardp(me)) return 1;
  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file);
    prepare_save();  //过一遍装备 整理数组
    return save_object(file);
  }
  return 0;
}

int restore() {
  string file;

  if (stringp(file = this_object()->query_save_file()))
    return restore_object(file);
  return 0;
}
