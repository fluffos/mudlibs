#include <ansi.h>
inherit NPC;
#include "tongren.h"
void create() {
  set_name("吴六破", ({ "wu liupo", "wu", "liupo" }));
  set("long", @LONG
他高瘦笔直、傲然挺立，自有一股书香世家的气质．苍白的脸带着浓烈的
书卷气，看上去很年青，但两鬓偏已斑自，他的儒服两袖高高捋趄，露出雪白
的手臂，手十指尖长，尤胜女孩儿家的手。尤其使人注目的是他耳朵上挟着一
根银光闪闪长若五寸的针。
LONG
  );

  set("title", MAG "神箭八雄" NOR);
  set("nickname", "散毒箭");
  set("max_jing", 122000);
  set("max_qi", 20011);
  set("max_sen", 102200);
  set("max_neili", 502200);
  set("neili", 502200);
  set("jiali", 330);
  set("combat_exp", 150220000);
  set("cor", 100);
  set("age", 65);

  set_skill("force", 250 + random(100));
  set_skill("huagong-dafa", 250 + random(100));
  set_skill("dodge", 250 + random(100));
  set_skill("zhaixinggong", 250 + random(100));
  set_skill("unarmed", 250 + random(100));
  set_skill("chousui-zhang", 250 + random(100));
  set_skill("parry", 250 + random(100));
  set_skill("staff", 250 + random(100));
  set_skill("tianshan-zhang", 250 + random(100));
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixinggong");
  map_skill("unarmed", "chousui-zhang");
  map_skill("parry", "tianshan-zhang");
  map_skill("staff", "tianshan-zhang");
  set_temp("apply/attack", 150);
  setup();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    if (random(15) < 2)
      this_object()->set_leader(ob);
  }
}
void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");

  rand = random(100);
  if (rand >= 20) {
    item = new("/clone/money/silver");
    if (item) {
      item->set_amount(50);
      item->move(environment(ob));
    }
  }

  else if (rand < 20) {
    item = new(GIFT_DIR + GF_LIST[random(sizeof(GF_LIST))]);
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
