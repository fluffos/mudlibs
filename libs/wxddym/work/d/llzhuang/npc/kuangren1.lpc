#include <ansi.h>
inherit NPC;
#include "tongren.h"
#include <random_name.h>
void create()
{
       string name,nickname;
        name = comm_man_name();
        nickname = comm_man_nick();
	set_name(name, ({ "kuang ren"}) );
        set("nickname",nickname);
	set("long",@LONG
他眼神凶狠无比，狠狠瞪视着你。
LONG
	 );
	set("max_jing", 1111000);
	set("max_qi", 20011);
	set("max_sen", 111000);
	set("max_neili",511000);
	set("neili",501100);
	set("jiali",51110);
	set("combat_exp",15100000);
	set("cor",13110);
	set("age",35);
         set_skill("pixie-jian", 250+random(100));
        set_skill("force", 250+random(100));
        set_skill("hamagong", 250+random(100));
        set_skill("dodge", 250+random(100));
        set_skill("unarmed", 250+random(100));
       // set_skill("xingxiu-duzhang", 200);
        set_skill("parry", 250+random(100));
        set_skill("zhaixinggong",250+random(100));
        set_skill("tianshan-zhang", 250+random(100));
        map_skill("sword","pixie-jian");
        map_skill("parry","pixie-jian");
        map_skill("dodge","pixie-jian");
        map_skill("force","pixie-jian");
		set_temp("apply/damage",150);
        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("perform sword.pi") :),
                (: command("perform sword.po") :),
                (: command("perform sword.kuihua") :),
                (: command("exert shield") :),
                (: command("exert powerup") :),
        }) );

	setup();
        carry_object("/clone/weapon/changjian")->wield();
}
void init()
{
        object ob;
        ::init();
        if (interactive(ob = this_player())) {
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob);
        }
}

void die()
{
	object me,ob,jmem,item;
	mapping team;
	int i,size,level,exp,rand,pot;
	string file;

	ob = this_object();
	me = ob->query_temp("last_damage_from");

        rand = random(100);
	if(rand >= 20)
	{
		item = new("/clone/money/silver");
		if(item)
		{
			item->set_amount(50);
			item->move(environment(ob));
		}
	}

        else if(rand < 20)
	{
		item = new(GIFT_DIR + GF_LIST[random(sizeof(GF_LIST))]);
		if(item)
		{
			item->move(environment(ob));
		}
    }

	destruct(ob);
}