    "【购买】": "快捷列表\n"
    ZJOBACTS2 + ZJMENUF(2, 2, 8, 30)
    "欧冶子圣符:huan ouyezi symbol from shen mi"
    ZJSEP "一级力量丹:huan lishen from shen mi"
    ZJSEP "一级身法丹:huan shenshen from shen mi"
    ZJSEP "一级悟性丹:huan zhishen from shen mi"
    ZJSEP "一级根骨丹:huan genshen from shen mi"
    ZJSEP "二级力:huan wan1 from shen mi"
    ZJSEP "二级身:huan wan4 from shen mi"
    ZJSEP "二级悟:huan wan2 from shen mi"
    ZJSEP "二级根:huan wan3 from shen mi" ZJSEP



    ,





    //ZJSEP"寰宇天晶:huan tian jing from shen mi"ZJSEP"天师护身符:huan tianshi charm from shen mi"ZJSEP"欧冶子圣符:huan ouyezi symbol from shen mi\n",
  ]));




  setup();
  replace_program(ROOM);
}
