#include <room.h>

inherit ROOM;

void create()
{
	set("short", "葵花秘境");
	set("long", @LONG
葵花秘境爆灵石。
LONG );

	set("no_fight", 1);
	set("no_steal", 1);
	set("no_beg", 1);
	set("no_sleep_room", 1);
	set("objects", ([
         "/d/maze/khxz/khxz_door" : 1,
	]));

	set("exits", ([
            "south" : __DIR__"wumiao3-1",
            "south" : __DIR__"wumiao3-2",
	]));
	setup();
}
