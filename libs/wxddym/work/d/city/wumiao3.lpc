h#include <room.h>

inherit ROOM;

void create()
{
	set("short", "挑战地图");
	set("long", @LONG
这里是挑战任务地图。
LONG );

	set("no_fight", 1);
	set("no_steal", 1);
	set("no_beg", 1);
	set("no_sleep_room", 1);

	set("exits", ([
		"down" : __DIR__"wumiao2",
            "west" : __DIR__"wumiao3-0",
            "north" : __DIR__"wumiao3-1",
            "north" : __DIR__"wumiao3-2",

	]));
	setup();
}
