#include <room.h>

inherit ROOM;


void create() {
  set("short", "奇异空间");
  set("long", @LONG
你进入了一个奇怪的空间，里面的每一个人都身怀重宝。
LONG);

  set("no_sleep_room", "1");

  set("valid_startroom", "1");
  set("objects", ([
    __DIR__ "npc/zwj": 1,
    __DIR__ "npc/gb": 2,
  ]));

  set("exits", ([
    "up": __DIR__ "wumiao",
  ]));

  setup();
}
