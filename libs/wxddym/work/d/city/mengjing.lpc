inherit ROOM;

void create() {
  set("short", "梦境");
  set("long", @LONG
你进入了梦境，梦见一位看似很慈祥的老人正在教人武术，而你可以从中学习。
LONG);
  set("no_fight", "1");
  set("no_steal", "1");
  set("item_desc", ([
    "laoren": "梦中老者,你可以跟他（study laoren)学习基本拳法，掌法，手法，指法，爪法，拳脚到200级。\n",
  ]));
  setup();
}

void init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me;
  string msg;

  me = this_player();

  if (!arg || (arg != "laoren"))
    return notify_fail("什么？\n");


  me->receive_damage("jing", 10 + random(40));
  if (me->query("jing") < 0) {
    me->unconcious();
    return 1;
  }

  msg = "你正专心跟着老人学习。\n";

  switch (random(6)) {
    case 0:
      if ((int)me->query_skill("finger", 1) < 200) {
        me->improve_skill("finger", 1 + random(me->query("str")));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对指法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
      break;

    case 1:
      if ((int)me->query_skill("claw", 1) < 200) {
        me->improve_skill("claw", 1 + random(me->query("str")));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对爪法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
      break;

    case 2:
      if ((int)me->query_skill("strike", 1) < 200) {
        me->improve_skill("strike", 1 + me->query("str"));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对掌法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
      break;

    case 3:
      if ((int)me->query_skill("cuff", 1) < 200) {
        me->improve_skill("cuff", 1 + random(me->query("str")));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对拳法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
      break;

    case 4:
      if ((int)me->query_skill("unarmed", 1) < 200) {
        me->improve_skill("unarmed", 1 + random(me->query("str")));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对拳法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
      break;

    case 5:
      if ((int)me->query_skill("hand", 1) < 200) {
        me->improve_skill("hand", 1 + random(me->query("int")));
        msg += "你对老人教授的武学琢磨了一回儿，似乎对手法有点心得。\n";
        me->set_temp("stone_learned", 1);
      }
  }

  if (!me->query_temp("stone_learned"))
    msg += "你对老人教授的武学琢磨了一回儿，发现老人所教"
      "的太过浅显，对你来说已毫无意义了。\n";

  write(msg);

  return 1;
}
