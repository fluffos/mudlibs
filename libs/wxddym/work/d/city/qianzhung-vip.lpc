inherit ROOM;

void create() {
  set("short", "VIP客户接待室");
  set("long",
    "这是一家老字号的钱庄，已有几百年的历史，在全国各地都有分店。它发
行的银票信誉非常好，通行全国,这里是它的VIP客户接待室"
    ZJURL("cmds:ask shouyinyuan about 兑换") + ZJSIZE(18) + HIC "兑换" NOR
  );
  set("no_fight", 1);
  set("exits", ([
    "east": __DIR__ "qianzhuang",
  ]));

  set("objects", ([
    __DIR__ "npc/shouyinyuan": 1,
  ]));

  setup();
}
