#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "武学圣地" NOR);
  set("long", HIR "\n\n"
    "天地规则弥漫四周，\n"
    "你在此处感觉到头脑分外清明，\n"
    "参悟武功，十分简单\n\n" NOR
  );
  set("exits", ([
    "east": __DIR__ "wumiao",
  ]));
  setup();
}

void init() {
  object me = this_player();
  me->add("balance", -100000);
  message_vision(HIR "武道规则，天地灵气，汇聚而来！\n" NOR, me);
}
