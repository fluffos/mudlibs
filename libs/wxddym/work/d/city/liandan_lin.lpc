// inherit object: liandan_lin.c

#include <ansi.h> 

inherit ROOM;

int do_cai(string arg);

void init()
{
	add_action("do_cai","cai");
	set("item_desc", ([
		"【小洞】" : "这里有一个小洞，走进一看却又有些不同寻常。\n"
		ZJOBACTS2"查探:cai yao\n",
	]));
}

int do_cai(string arg)
{
	object me = this_player();
	object ob;
	object ob1;


	if (me->is_busy())
		return notify_fail("慢慢找，先别急。\n");
       
	if ((int)me->query("jing") < 40)
		return notify_fail("你太疲倦了，休息一下吧。\n");

	if ((int)me->query("qi") < 40)
		return notify_fail("你太累了，休息一下吧。\n");

	message_vision("$N趴在洞口边，瞪大了眼睛在洞口中找寻"
		       "着什么东西，生怕漏掉了目标。\n", me);
	remove_call_out("cai");
	call_out("cai", 1 + random(8), me);
	me->start_busy(3);
	return 1;
}
 
int cai(object me)
{ 
	object ob;
	object ob1;

	if (! objectp(me) || environment(me) != this_object() ||
	    ! living(me) || me->is_fighting())
		return 0;

	if (random(200) > 80 ||
	    present("du she", this_object()) ||
	    present("du langzhong", this_object()))
	{
		me->receive_damage("jing", 10 + random(20));
		me->receive_damage("qi", 10 + random(20));
		message_vision(CYN "一番摸索后，草丛中似乎没有$N"
			       CYN "要找的东西，$N" CYN
			       "失望的叹了口气。"NOR"\n", me);
		return 1;
	}

	if (random(100) == 100)
	{	 
		tell_room(environment(me), HIR "林子后面突然跳出一个"
			  "凶神恶刹的男子，手提一把短刀向你扑来！"NOR"\n");
		ob = new("/d/beijing/npc/liandan_langzhong");
		ob->move(this_object());
		ob->kill_ob(me);
	} else if (random(100) <= 20)
	{ 
		ob1 = new("/clone/herb/zz4");
		ob1->move(me, 1);
		me->receive_damage("jing", 10 + random(20));
		me->receive_damage("qi", 10 + random(20));
		me->set_temp("caiyao", 2);
		message_sort(HIG "$N" HIG"找了半天，终于发现里面有"
			     "一个瓶子，和其他瓶子有所不同，你小心翼"
			     "翼地将它拿了出来。"NOR"\n", me); 
	}else if (random(100) <= 40)
	{ 
		ob1 = new("/clone/herb/zz3");
		ob1->move(me, 1);
		me->receive_damage("jing", 10 + random(20));
		me->receive_damage("qi", 10 + random(20));
		me->set_temp("caiyao", 2);
		message_sort(HIG "$N" HIG"找了半天，终于发现里面有"
			     "一株千年人参，你小心翼"
			     "翼地将它拿了出来。"NOR"\n", me); 
	}else if (random(100) <= 60)
	{ 
		ob1 = new("/clone/herb/zz2");
		ob1->move(me, 1);
		me->receive_damage("jing", 10 + random(20));
		me->receive_damage("qi", 10 + random(20));
		me->set_temp("caiyao", 2);
		message_sort(HIG "$N" HIG"找了半天，终于发现里面有"
			     "一份类似药粉一样的东西，你小心翼"
			     "翼地将它拿了出来。"NOR"\n", me); 
	}else if (random(100) <= 80)
	{ 
		ob1 = new("/clone/herb/zz1");
		ob1->move(me, 1);
		me->receive_damage("jing", 10 + random(20));
		me->receive_damage("qi", 10 + random(20));
		me->set_temp("caiyao", 2);
		message_sort(HIG "$N" HIG"找了半天，终于发现里面有"
			     "一颗闪闪发亮的珠子，你小心翼"
			     "翼地将它拿了出来。"NOR"\n", me); 
	}
	return 1;

	
}
