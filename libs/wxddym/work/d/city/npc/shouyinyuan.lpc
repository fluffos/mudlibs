// waiter.c

#include <ansi.h>;

inherit NPC;

string ask_duihuan();

void create() {
  set_name("收银员", ({ "shouyinyuan" }));
  set("gender", "女性");
  set("age", 22);
  set("long",
    "这位收银员正笑咪咪地看着你。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("rank_info/respect", "收银员");
  set("inquiry", ([
    "兑换": (: ask_duihuan :),
  ]));

  setup();
}

string ask_duihuan() {
  object me = this_player();
  object obj;
  if (me->query("xy_money") < 10) {
    command("say 你身上元宝不足10。");
    return 0;
  } else {
    me->add("balance", 10000000);
    me->add("xy_money", -10);
    return HIG "兑换成功。" NOR;
  }
}
