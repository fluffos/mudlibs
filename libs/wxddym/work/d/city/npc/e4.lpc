
#include <ansi.h>
#include <command.h>

inherit NPC;
inherit F_DEALER;

void create()
{
	set_name("蜀山剑仙", ({ "shushan jianxian", "jianxian" }));
	set("title", "蜀山仙人");

	set("gender", "男性");
	set("age", 48);
       set("skill_qi", 1);
	   set("max_qi", 20000000);
       set("str", 100);
	set("long",
		"你喜欢玩剑？蜀山的剑一定不差！\n");
	set_skill("unarmed", 2500);
	set_skill("dodge", 2500);
	set_skill("higgling", 2500);

	set_temp("apply/damage", 10000);

	set("combat_exp", 800000);
	set("attitude", "friendly");


	set("vendor_goods", ([
		"/clone/new/e4/e4_arrmor" : 1500000,
		"/clone/new/e4/e4_finger" : 1500000,
		"/clone/new/e4/e4_hands"  : 1500000,
		"/clone/new/e4/e4_head"  : 1500000,
		"/clone/new/e4/e4_pants"  : 1500000,
		"/clone/new/e4/e4_blade"  : 1500000,
		"/clone/new/e4/e4_neck" : 1500000,
	]));

	setup();

}

void init()
{
	add_action("do_buy", "buy");
	add_action("do_list", "list");
	add_action("do_drop", "drop");
}



int do_drop(string arg)
{
	int i;
	object *obs;
	object ob;
	object me;

	if (! arg)
		return 0;

	me = this_player();
	if (objectp(ob = present(arg, me)) &&
	    ob->is_character() && ! playerp(ob))
	{
		me->add_temp("static/drop_npc", 1);
		if (me->query_temp("static/drop_npc") > 1 &&
		    me->query("combat_exp") >= 50000)
		{
			message_vision("$N大怒道：：“好你个" +
				       RANK_D->query_rude(ob) +
				       "，还来添乱！”\n说罢只见$N"
				       "飞起一脚，将$n和" + ob->name() +
				       "一起踢出门外。\n", this_object(), me);
			ob->move("/d/city/beidajie4");
			me->move("/d/city/beidajie4");
			message("vision", "只听叮叮咣光一阵向，" + me->name() +
					  "被人一脚踢了出来。\n",
				environment(me), me);
			me->receive_damage("qi", 1);
			me->die();
			return 1;
		}

		message_vision("$N怒道：“滚开，少给我添乱，影响我的生意。”\n"
			       "说罢只见$N飞起一脚，将$n和" + ob->name() +
			       "一起踢出门外。\n", this_object(), me);
		ob->move("/d/city/beidajie4");
		me->move("/d/city/beidajie4");
		message("vision", "只听叮叮咣光一阵向，" + me->name() +
				  "被人一脚踢了出来。\n",
			environment(me), me);
		me->receive_damage("qi", 1);
		me->unconcious();
		return 1;
	}

	if (! DROP_CMD->main(me, arg))
		return 0;

	if (! command("get " + arg))
		return 1;

	obs = all_inventory(this_object());
	for (i = 0; i < sizeof(obs); i++)
		if (! obs[i]->is_character()) destruct(obs[i]);
	if (! random(5))
	{
		switch (random(4))
		{
		case 0:
			command("say 日积月累，小康之路！");
			break;
		case 1:
			command("kok " + this_player()->query("id"));
			command("say 随地乱扔垃圾，罚款五元！");
			break;
		case 2:
			command("say 败家子，败家子！");
			break;
		default:
			command("heihei");
			break;
		}
	}
	return 1;
}






