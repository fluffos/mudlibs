// huoji. 药铺伙计
inherit NPC;
//inherit F_DEALER;
//inherit F_VENDOR_SALE;
int ask_yaochu();
void create() {
  set_name("旷工", ({ "kuang" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是萧炎招来帮忙的。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("inquiry", ([
    "矿场": (: ask_yaochu :),
  ]));
  setup();
}
int ask_yaochu() {
  object ob;
  ob = this_player();
  message_vision("笑道，给我一百金我就带你去矿场！\n", ob);
  ob->set_temp("矿场", 1);
  return 1;

}

int accept_object(object who, object ob) {
  object obj;
  if (!(int)who->query_temp("矿场")) {
    message_vision("伙计对$N说：给我钱做什么？\n", who);
    return 0;
  }
  if (ob->query("money_id") && ob->value() >= 1000000) {
    obj = this_player();
    obj->move("u/rock/weapon/kuang");

  }
  return 1;
}
