// shiye.c 知府师爷

inherit NPC;

string ask_me();
void create()
{
	set_name("谭友纪", ({ "tan youji", "tan" }));
	set("title", "知府师爷");
	set("gender", "男性");
	set("age", 57);

	set("combat_exp", 30000);
	set_skill("unarmed", 50);
	set_skill("dodge", 60);
	set_temp("apply/attack",  20);
	set_temp("apply/defense", 20);
	set_temp("apply/damage",  20);
	set("shen_type", 0);

	set("inquiry", ([
		"捕快":"只要"ZJURL("cmds:join guanfu ")ZJSIZE(15)HIR"加入"NOR"官府，就可以为朝廷出力。\n",
		"解除限制" : (: ask_me :)
	]) );

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	object ob;
	mapping myfam;
	ob = this_player();
	::init();
	add_action("do_join", "join");
}

int do_join(string arg)
{
	object ob = this_player();
	if(!arg || arg!="guanfu") return notify_fail("谭友纪道：你要加入什么组织？\n");
	if(ob->query("officerlvl") > 0)
	{
		message_vision(HIC"谭友纪说道：你已经是扬州府捕快了。\n"NOR,ob);
		return 1;
	}
	if (ob->query("combat_exp")<20000)
	{
		message_vision(HIC "谭友纪对$N摇头道：你的实战经验太低。\n" NOR,ob);
		return 1;
	}
	if (ob->query("class") != "bonze" &&
		ob->query("class") != "lama" &&
		ob->query("class") != "quanzhen" &&
		ob->query("class") != "eunach")
		ob->set("class","officer");
	ob->set("officerlvl",1);
	message_vision(HIY "谭友纪对$N道：从现在起你就是个实习捕快！\n" NOR,ob);
	ob->add("weiwang",10);
	ob->set("title", HIW"实习捕快"NOR);
	message_vision(HIC "$N的江湖威望提高了！\n" NOR,ob);
	tell_object(ob, "你现在的江湖威望是" + chinese_number((string)(ob->query("weiwang")))+"。\n"NOR);
	return 1;
}

string ask_me()
{
	if (this_player()->query("quest"))
	{
		this_player()->delete("quest");
		say("好啦，已经帮你解除了，走吧！\n");
	}
	else
		return "泥缩丝米偶钉布懂\n";
}
