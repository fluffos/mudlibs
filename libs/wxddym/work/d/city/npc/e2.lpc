#include <ansi.h>
#include <command.h>

inherit NPC;
inherit F_DEALER;

int do_answer();

void create() {
  set_name("泰森", ({ "taisen", "tai" }));
  set("title", "西域来到中原出售装备的商人");

  set("gender", "男性");
  set("age", 48);
  set("skill_qi", 1);
  set("max_qi", 20000000);
  set("str", 100);
  set("long",
    "你喜欢玩空手的，那就来买吧！\n");
  set_skill("unarmed", 2500);
  set_skill("dodge", 2500);
  set_skill("higgling", 2500);

  set_temp("apply/damage", 10000);

  set("combat_exp", 800000);
  set("attitude", "friendly");


  set("vendor_goods", ([
    "/clone/new/e2/e2_arrmor": 1500000,
    "/clone/new/e2/e2_finger": 1500000,
    "/clone/new/e2/e2_hands": 1500000,
    "/clone/new/e2/e2_head": 1500000,
    "/clone/new/e2/e2_pants": 1500000,
    "/clone/new/e2/e2_blade": 1500000,
    "/clone/new/e2/e2_neck": 1500000,
  ]));

  setup();
}
