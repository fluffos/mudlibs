int ask_yaochu() {
  object ob;
  ob = this_player();
  message_vision("伙计笑道，百宝袋也是要钱的呢！给我十金我就卖给你！\n", ob);
  ob->set_temp("百宝袋", 1);
  return 1;

}

int accept_object(object who, object ob) {
  object obj;
  if (!(int)who->query_temp("百宝袋")) {
    message_vision("伙计对$N说：给我钱做什么？\n", who);
    return 0;
  } else if (present("baibao nang", this_player())) {
    message_vision("伙计对$N说：你身上已有百宝袋了，不要这么贪心。\n", who);
    return 0;
  } else if (ob->query("money_id") && ob->value() >= 100000) {
    message_vision("伙计给了$N百宝袋！\n", who);
    this_player()->delete_temp("百宝袋");
    obj = new("clone/misc/baibao.lpc");
    obj->move(this_player());


  }
  return 1;
}
