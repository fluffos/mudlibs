// huoji. 药铺伙计
inherit NPC;
//inherit F_DEALER;
//inherit F_VENDOR_SALE;
int ask_yaochu();
void create() {
  set_name("百宝商", ({ "baibao" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是苍井空招来帮忙的。\n");
  //set("area_name","扬州城药材店");
  set("combat_exp", 250);
  set("attitude", "friendly");
  /*set("vendor_goods", ({
           "/d/city/obj/jinchuang",
           "/d/city/obj/yangjing",
        }));*/
  set("inquiry", ([
    "百宝袋": (: ask_yaochu :),
  ]));
  setup();
  //    carry_object("/d/city/npc/obj/linen")->wear();
}
