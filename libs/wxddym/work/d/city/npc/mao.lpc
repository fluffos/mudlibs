inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("猫仙人", ({ "mao shadow", "shadow" }) );
        set("title", "仙人");
        set("gender", "无性");
        set("age", 30);
        set("long",
                "吾乃喵仙人,有本事你来打我呀。\n");
        set("attitude", "peaceful");
          set("str", 66);
        set("con", 66);
        set("dex", 66);
        set("int", 66);

		set("jiali", 100);  
		set("neili", 30000000);  
        set("qi",300000);
        set("jing",30000);
        set("max_jing",300000);
		set("max_qi",300000);  
		set("max_neili", 300000);
		

        set("combat_exp", 999999999);
        set("shen", 1000);
        set("apprentice_available", 3);

        set("chat_chance_combat", 30);
 
 
        set("inquiry", ([
            "打我": "找死。\n",
			]) );


        set_skill("force", 2000);
        set_skill("parry", 100);
		set_skill("dodge", 100);
		set_skill("bumie-jinshen", 10);
		set_skill("fengshen-bu", 100);

	//prepare_skill("finger", "six-finger");
        map_skill("parry", "bumie-jinshen");
        map_skill("dodge", "fengshen-bu");
        setup();

         
       
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/vip/123/lingbao");
		 // obj = new("/clone/vip/123/hunbao1");
        obj->move(env, 1);
        message_vision("\n$N一晃，又神采奕奕了。\n", this_object());
        ob = new("/d/city/npc/mao");
        ob->move(environment(this_object()));
        destruct(this_object());
} 