// zhu.c 杨贵妃

#include <ansi.h>

inherit NPC;

string ask_buy();
string ask_job();
int  do_copy(string arg);
int do_answer();
int  working(object me);
int  halt_working(object me);

void create()
{
	set_name("西施", ({ "xi1" }));
	set("long", "四大美人之一。\n");
	set("gender", "女性");
	set("age", 18);
	set("no_get", 1);
	set_skill("literate", 500);
	 set("teacher",1);
	set_skill("unarmed", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/damage", 20);

	set("combat_exp", 400000);
	set("shen_type", 1);
	set("inquiry", ([
	   // "搜身" : (: do_answer :),
	    "双修" : (: ask_job :),
	    "介绍" : "小女子经验丰富能指点你！",
	]));
	set("vendor_goods", ({
		"/clone/book/lbook11",
		"/clone/book/lbook12",
		"/clone/book/lbook13"
	}));
	setup();

	set("chat_chance", 1);
	set("chat_msg", ({
		"杨贵妃擅长各类基本武学。\n",
		"西施阅历丰富能指点你经验。\n",
		"昭君身家丰厚，伺候好了可得钱财无数。 \n",
		"貂蝉年轻貌美，能激发你无限潜能。\n",
	}) );
}

void init()
{
	add_action("do_copy", "copy");
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

int do_answer()
{
	write(name() + HIR"在你耳边轻声说道：我这可真是春光无限！"NOR"\n");
	return 1;
}

int recognize_apprentice(object ob)
{
	if (ob->query_temp("mark/朱") < 1)
		return 0;

	ob->add_temp("mark/朱", -1);
	return 1;
}

int accept_object(object who, object ob)
{
	if (! who->query_temp("mark/朱"))
		who->set_temp("mark/朱", 0);

	if (ob->query("money_id") && ob->value() >= 2000)
	{
		message_vision("同意指点$N一些读书写字的问题。\n", who);
		who->add_temp("mark/朱", ob->value() / 50);
		    destruct(ob);
		return 1;
	}

	command("say 看清楚学规，请教学问至少要二十两白银！");
	return 0;
}

void auto_copy(object me)
{
	if(!me->query_temp("pending/auto_copy"))
		return;
	if(me->is_busy())
		call_out("auto_copy",1,me);
	else if( (int)me->query("qi") < 50||(int)me->query("jing") < 50 )
	{
		tell_object(me,"体力不足，休息中。。。\n");
		call_out("auto_copy",10,me);
	}
	else
	{
		tell_object(me,"忘我中，继续。。。。。。\n");
		tell_object(me,ZJFORCECMD("ask "+this_object()->query("id")+" about 双修"));
	}
}

string ask_job()
{
	object me;
	object *obs;

	me = this_player();
	if (me->query_temp("job/copy"))
		return "来呀？";


	if (me->query("qi") < 20)
		return "我看你脸色不行啊，先歇会儿吧，我可不想出人命来。";

	if (me->query("jing") < 10)
		return "我看你精神不行啊？";


	if (! interactive(me))
		return "...";

	obs = filter_array(all_inventory(environment()),
			   (: interactive($1) && $1 != $(me) && $1->query_temp("job/copy") && query_ip_number($1) == query_ip_number($(me)) :));
	if (sizeof(obs) > 0)
		return "我这已经有" + obs[0]->name() + "在干活了，你等等吧。";

	me->set_temp("job/copy", 1);
	tell_object(me,ZJFORCECMD("copy"));
	tell_object(me,ZJEXIT"northwest:"RED"抽出"NOR":halt\n");
	return "好，官人请宽衣"ZJURL("cmds:copy")ZJSIZE(15)"双修"NOR"吧！床在这儿。";
}

int do_copy(string arg)
{
	object me;

	me = this_player();
	if (me->is_busy())
		return notify_fail("你正忙着呢，别着急。\n");

	if (! me->query_temp("job/copy"))
	{
		message_vision("$N脱下衣服，刚想上床，就听见$n大喝道：给我滚。\n",me, this_object());
		return 1;
	}

	me->set_temp("job/step", 1);
	me->set_temp("pending/auto_copy", 1);
	me->start_busy(bind((: call_other, __FILE__, "working" :), me),
		       bind((: call_other, __FILE__, "halt_working" :), me));
	tell_object(me, "你开始工作。\n");
	return 1;
}

int working(object me)
{
	string msg;
	int finish;
	int b;
    int tsrj_reward;
    int lvl;

tsrj_reward = "/adm/daemons/actiond"->query_action("tsrj_reward");
lvl = me->query("level");


	if (! me->query_temp("job/step"))
		me->set_temp("job/step", 1);

	if (! living(me))
	{
		me->delete_temp("job/copy");
		me->delete_temp("job/step");
		return 0;
	}

	finish = 0;
	me->receive_damage("jing", 1);
	me->receive_damage("qi", 2);
	switch (me->query_temp("job/step"))
	{
	case 1:
		msg = "$N啪啪。";
		break;
	case 2:
		msg = "$N啪啪啪。";
		break;
	case 3:
		msg = "$N啪啪啪啪。";
		break;
	case 4:
	case 6:
		msg = "$N啪啪啪啪啪啪。";
		break;
	case 5:
		msg = "$N啪啪啪啪啪啪啪啪啪啪。";
	case 7:
		msg = "$N啪啪。";
		break;
	default:
		msg = "$N脸色潮红看着$n。";
		finish = 1;
		break;
	}
	msg += "\n";

	if (finish)
	{
		object ob;
		msg += "$n看了$N，满意道：还行，功夫不错！"
		       "我就传授你一点功夫吧。\n";
		me->delete_temp("job/copy");
		me->delete_temp("job/step");
        b = ((30 + random(4))*tsrj_reward) +((30 + random(4)*lvl)/10) ;
		me->add_temp("mark/朱", 20);
		me->add("combat_exp", b);
		me->improve_potential(b/2);

	

	}

	msg = replace_string(msg, "$N", "你");
	msg = replace_string(msg, "$n", name());
	tell_object(me, msg);

	if (finish)
	{
		if (b > 0)
		{
			tell_object(me, HIC "\n你获得了" + chinese_number(b) + "经验"+ chinese_number(b/2) + "潜能" NOR"\n");
		}
//		if(me->query("zjvip/level")&&me->query_temp("tuoguan/zhu"))
			call_out("auto_copy",1,me);
		return 0;
	}

	me->add_temp("job/step", 1);
	return 1;
}

int halt_working(object me)
{
	message_vision("$N你从床上下来，牢骚道：什么呀，根本就不是人干的活！\n", me);
	me->delete_temp("job/copy");
	me->delete_temp("pending/auto_copy");
	me->delete_temp("job/step");
	return 1;
}
