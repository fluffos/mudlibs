#include <ansi.h>
inherit NPC;

void create() {
  set_name("魔化待女", ({ "genban", "mohua genban" }));
  set("title", HIY "待女" NOR);
  set("gender", "女性");
  set("age", 26);
  set("long",
    "魔化张无忌的待女。\n");

  set("int", 50);
  set("str", 55);
  set("con", 55);
  set("dex", 55);
  set("attitude", "aggressive");
  set("shen_type", -1);

  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 10000);
  set("max_jing", 8000);
  set("neili", 8000);
  set("max_neili", 10000);
  set("jiali", 20);
  set("combat_exp", 500000);
  set("score", 15000);
  set_temp("apply/attack", 160);
  set_temp("apply/defense", 60);
  set_temp("apply/damage", 40);

  set_skill("force", 160);
  set_skill("unarmed", 150);
  set_skill("dodge", 170);
  set_skill("parry", 170);
  set_skill("cuff", 150);
  set_skill("sword", 180);
  set_skill("blade", 150);
  set_skill("strike", 160);
  set_skill("claw", 170);
  set_skill("throwing", 160);
  set_skill("jiuyang-shengong", 180);
  set_skill("lingxu-bu", 140);
  set_skill("qingfu-shenfa", 190);
  set_skill("qiankun-danuoyi", 160);
  set_skill("qishang-quan", 170);
  set_skill("lieyan-dao", 160);
  set_skill("hanbing-mianzhang", 180);
  set_skill("shenghuo-ling", 180);

  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("unarmed", "jiuyang-shengong");
  map_skill("strike", "guangming-zhang");
  map_skill("cuff", "qishang-quan");
  map_skill("sword", "shenghuo-ling");
  map_skill("parry", "qiankun-danuoyi");
  map_skill("blade", "taiji-dao");
  map_skill("throwing", "duoming-jinhua");
  map_skill("strike", "hanbing-mianzhang");

  prepare_skill("cuff", "qishang-quan");

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("perform sword.canxue") :),
    (: command("perform sword.guanghua") :),
    (: command("perform sword.lianxin") :),
    (: command("perform sword.xiyan") :),
    (: command("perform qimai") :),
    (: command("exert shield") :),
    (: command("exert powerup") :),
  }));

  set("chat_chance", 60);

  setup();
  carry_object("/clone/weapon/gangjian")->wield();
  //     carry_object("/clone/newbox/equip/armor-box")->set_amount(1);
  // add_money("gold",1);

}


void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");

  rand = random(100);
  if (rand >= 25) {
    item = new("/clone/money/silver");
    if (item) {
      item->set_amount(50);
      item->move(environment(ob));
    }
  }

  else if (rand < 25) {
    item = new("/clone/box/y1_box");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
