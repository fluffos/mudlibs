inherit NPC;
#include <ansi.h>
int big_blowing();
int hurting();
void create() {
  seteuid(getuid());
  set_name("魔化张无忌", ({ "zhang wuji", "zhang", "wuji" }));
  set("long", @LONG
明教教主张无忌，统领天下十万教众，豪气干云，叱咤千秋，
「九阳神功」、「乾坤大挪移」独步天下，是江湖中不世出的
少年英雄。
LONG);
  set("title", HIG "明教" HIM " 叛徒" NOR);
  set("gender", "男性");
  set("age", 20);
  set("no_get", 1);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("class", "fighter");

  set("str", 80);
  set("int", 78);
  set("con", 78);
  set("dex", 90);

  set("qi", 30000);
  set("max_qi", 30000);
  set("jing", 27000);
  set("max_jing", 27000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 120);
  set("level", 50);
  set("combat_exp", 29000000);
  set("score", 450);

  set_skill("force", 340);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 300);
  set_skill("cuff", 260);
  set_skill("sword", 260);
  set_skill("blade", 250);
  set_skill("strike", 250);
  set_skill("claw", 250);
  set_skill("throwing", 250);
  // set_skill("duoming-jinhua", 250);
  set_skill("jiuyang-shengong", 250);
  set_skill("shenghuo-shengong", 250);
  set_skill("lingxu-bu", 280);
  set_skill("qingfu-shenfa", 250);
  set_skill("qiankun-danuoyi", 250);
  set_skill("qishang-quan", 250);
  set_skill("taiji-quan", 250);
  set_skill("taiji-jian", 250);
  set_skill("taiji-dao", 250);
  set_skill("lieyan-dao", 250);
  set_skill("liehuo-jian", 250);
  set_skill("yingzhua-shou", 250);
  set_skill("hanbing-mianzhang", 250);
  set_skill("shenghuo-ling", 250);
  set_skill("guangming-zhang", 220);
  set_skill("medical", 250);
  set_skill("literate", 300);
  set_skill("martial-cognize", 280);

  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("unarmed", "jiuyang-shengong");
  map_skill("strike", "guangming-zhang");
  map_skill("cuff", "qishang-quan");
  map_skill("sword", "shenghuo-ling");
  map_skill("parry", "qiankun-danuoyi");
  map_skill("blade", "taiji-dao");
  map_skill("claw", "yingzhua-shou");
  map_skill("throwing", "duoming-jinhua");
  map_skill("strike", "hanbing-mianzhang");

  prepare_skill("cuff", "qishang-quan");

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("perform sword.canxue") :),
    (: command("perform sword.guanghua") :),
    (: command("perform sword.lianxin") :),
    (: command("perform sword.xiyan") :),
    (: command("perform qimai") :),
    (: command("exert shield") :),
    (: command("exert powerup") :),
    (: big_blowing :)
  }));


  set_temp("apply/attack", 180);
  set_temp("apply/damage", 180);
  set_temp("apply/unarmed_damage", 180);
  set_temp("apply/armor", 180);

  set("master_ob", 5);
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/gangjian")->wield();
}
int big_blowing() {
  remove_call_out("hurting");
  message_vision(HIR "\n\n$N" HIR "张无忌大喊一声，乾坤大挪移，身法暴涨几分！！\n\n" NOR,
    this_object());
  hurting();
  start_busy(3 + random(2));
}
int hurting() {
  int i;
  int dam;
  object *inv;
  message_vision(HIR "\n\n张无忌突然身形暴退，拿出绝顶暗器暴雨梨花针，发射出无数毒针向你射来。\n\n", this_object());
  inv = all_inventory(environment(this_object()));
  for (i = sizeof(inv) - 1; i >= 0; i--)
    if (living(inv[i]))
      if (inv[i] != this_object()) {
        dam = 200 + random(100);
        inv[i]->receive_wound("qi", dam, this_object());
        inv[i]->receive_wound("jing", dam / 2, this_object());
        inv[i]->affect_by("poison",
          ([ "level": 150,
            "id": this_object()->query("id"),
            "duration": 200 ]));
        tell_object(inv[i], HIG "你中了张无忌的暗器之毒。\n");
        COMBAT_D->report_status(inv[i], 1);
      }
  return 1;
}

void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");
  //掉宝

  rand = random(100);
  if (rand >= 5) {
    item = new("/clone/money/gold");
    if (item) {
      item->set_amount(2);
      item->move(environment(ob));
    }
  } else if (rand < 5) {
    item = new("/clone/box/y2_box");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
