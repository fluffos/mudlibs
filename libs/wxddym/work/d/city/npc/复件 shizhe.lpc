#include <ansi.h>

inherit NPC;

string ask_lilian();
string ask_jieshu();
string ask_apprentice();
string ask_pay();
string ask_yao();

void create()
{
	set_name(HIW"猫族使者"NOR, ({ "shizhe" }));
	set("nickname", HBCYN"武林使者"NOR);
	set("long", "这是一位猫族派遣的使者，负责处理猫族的事情。\n");
	set("gender", "男性");
	set("age", 30);
	set("per", 24);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("qi",5000);
	set("jingli",6000);
	set("max_qi", 8000);
	set("max_jing", 5000);
	set("eff_jingli", 6000);
	set("jiali", 190);
	set("combat_exp", 9000000);
	set("shen", 25000);

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: exert_function, "taiji" :),
		(: perform_action, "sword.chan" :),
		(: perform_action, "cuff.zhen" :),
		(: perform_action, "cuff.zhan" :),
		(: perform_action, "cuff.ji" :)
	}));

	set("inquiry", ([
		"历练" : (: ask_lilian :),
		"结束" : (: ask_jieshu :),
		"后悔" : (: ask_apprentice :),
		"贡献" : (: ask_pay :),
		"万艾可" : (: ask_yao :),
	]));
	setup();
}



void init()
{
	object ob;
	::init();//继承上一级
	if (interactive(ob = this_player()) && !is_fighting()) {
		remove_call_out("greeting");
		call_out("greeting", 0, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if( ob->query("zjvip/times") > 0 && !ob->query("lilian/start")) {
		command("hi "+ob->query("id"));
		command("whisper "+ob->query("id")+" "HIC"\n这位" + RANK_D->query_respect(ob) +"你是我们猫族的成员，\n"+
			"你还没有在我这里"ZJURL("cmds:ask shizhe about 历练")+ZJSIZE(20)"登记"NOR""HIR"历练"HIC"，\n"+
			"赶紧开始你的"HIR"历练"HIC"，领取丰厚的家族奖励吧！"NOR"");
	}

}


string ask_lilian()
{ 
	object me = this_object();
	object ob = this_player();



        if (ob->query("lilian/start")) return "我已经记录了你的历练信息，放心去吧。\n";

	message_vision(HIG"$N翻开记事簿，对$n点了点头，说道：好吧，我这就为你记上。"NOR"\n",me,ob);

	ob->set("lilian/start",time());
	return "别忘了要在一天内找我结束历练。\n"; 
}

string ask_jieshu()
{
	object me = this_object();
	object ob = this_player();
        int time3;



        if (!ob->query("lilian/start")) return "我这里没有你的历练记录。\n";

        time3=time()-(int)ob->query("lilian/start");
	message_vision(HIY"$N结束了$n的本次历练！"NOR"\n",me,ob);
        ob->add("combat_exp",time3/4);
        ob->add("potential",time3/28);
        ob->delete("lilian/start");
	return "你的经验增加了"+time3/4+"点，潜能增加了"+time3/28+"点。\n";
}

string ask_apprentice()
{
	object me = this_object();
	object ob = this_player();


	if (ob->query("combat_exp", 1)<2000000000000 && !wizardp(ob)) return "你目前的实战经验太低了，等以后再重择门派吧！\n";

	message_vision(RED"$N废去了$n所有的门派特殊内功！"NOR"\n",me,ob);

	ob->set("family",0);
        ob->delete("title");
        ob->delete("class");
//        me->recruit_apprentice(ob);

	ob->delete_skill("bihai-chaosheng");
	ob->delete_skill("dulong-dafa");
	ob->delete_skill("guiyuan-tunafa");
	ob->delete_skill("hanbing-zhenqi");
	ob->delete_skill("huagong-dafa");
	ob->delete_skill("huntian-qigong");
	ob->delete_skill("hunyuan-yiqi");
	ob->delete_skill("jiuyang-shengong");
	ob->delete_skill("linji-zhuang");
	ob->delete_skill("longxiang-boruo");
	ob->delete_skill("kurong-changong");
	ob->delete_skill("qiantian-yiyang");
	ob->delete_skill("shenghuo-shengong");
	ob->delete_skill("shenyuan-gong");
	ob->delete_skill("xuantian-wuji");
	ob->delete_skill("yijin-jing");
	ob->delete_skill("yinyun-ziqi");
	ob->delete_skill("yunu-xinjing");
	ob->delete_skill("zixia-gong");

	ob->delete_skill("chousui-zhang");

	return "好了，这位" + RANK_D->query_respect(ob) +"重新去选择门派吧。\n";
}


string ask_pay()
{
	object me = this_object();
	object ob = this_player();



	return "你当前贡献是"+chinese_number(ob->query("vip/all_pay")+ob->query("zjvip/all_pay"))+"点。\n";
}


string ask_yao()
{
	object me = this_object();
	object ob = this_player();
        object yao;

	

        if (  present("huxin dan", ob) )
                return RANK_D->query_respect(ob) + 
                "你身上不是已经有伟哥了吗，怎么又来要了？ 真是贪得无厌！";

        yao = new("/clone/shizhe/huxindan");
        yao->move(ob);
        message_vision("$N给了$n几颗" + yao->query("name") + "。\n",me ,ob);
	return "这可是好东西，希望对你行走江湖有所帮助。\n";
}
