inherit NPC;
#include <ansi.h>;

void create() {
  set_name("绝望之主", ({ "y44 shadow", "shadow" }));
  set("title", "影子之主");
  set("gender", "男性");
  set("age", 40);
  set("long",
    "这个影子之主似乎让人有些不真实感。\n");
  set("attitude", "peaceful");
  set("str", 70);
  set("con", 70);
  set("dex", 70);
  set("int", 70);

  set("qi", 6300);
  set("max_qi", 6300);
  set("jing", 6300);
  set("max_jing", 6300);
  set("neili", 6300);
  set("max_neili", 6300);
  set("jiali", 150);

  set("combat_exp", 5000000);
  set("score", 30000);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("unarmed", 530);
  set_skill("sword", 530);
  set_skill("blade", 530);
  set_skill("staff", 530);
  set_skill("hammer", 530);
  set_skill("club", 530);
  set_skill("whip", 530);
  set_skill("dagger", 530);
  set_skill("throwing", 530);
  set_skill("parry", 530);
  set_skill("dodge", 530);
  set_skill("force", 530);
  set_skill("yinyang-shiertian", 530);


  map_skill("sword", "yinyang-shiertian");
  map_skill("blade", "yinyang-shiertian");
  map_skill("staff", "yinyang-shiertian");
  map_skill("hammer", "yinyang-shiertian");
  map_skill("club", "yinyang-shiertian");
  map_skill("whip", "yinyang-shiertian");
  map_skill("dagger", "yinyang-shiertian");
  map_skill("parry", "yinyang-shiertian");
  map_skill("dodge", "yinyang-shiertian");
  map_skill("force", "yinyang-shiertian");

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "shield" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/2/wuxiu");
  obj->move(env, 1);
  obj = new("/clone/box/2/w7");
  obj->move(env, 1);
  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  // ob = new("/d/maze/jw1/npc/45");
  // ob->move(environment(this_object()));
  destruct(this_object());
}
