inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("绝望剑神", ({ "y39 shadow", "shadow" }) );
        set("title", "影子剑神");
        set("gender", "男性");
        set("age", 40);
        set("long",
                "这个影子剑神似乎让人有些不真实感。\n");
        set("attitude", "peaceful");
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

	set("qi", 5800);
	set("max_qi", 5800);
	set("jing", 5800);
	set("max_jing", 5800);
	set("neili", 5800);
	set("max_neili", 5800);
	set("jiali", 150);

        set("combat_exp", 4000000);
        set("score", 30000);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

	set_skill("unarmed", 480);
	set_skill("sword", 480);
	set_skill("blade", 480);
	set_skill("staff", 480);
	set_skill("hammer", 480);
	set_skill("club", 480);
	set_skill("whip", 480);
	set_skill("dagger", 480);
	set_skill("throwing", 480);
	set_skill("parry", 480);
	set_skill("dodge", 480);
	set_skill("force", 480);
	set_skill("never-defeated", 480);


	map_skill("sword", "never-defeated");
	map_skill("blade", "never-defeated");
	map_skill("staff", "never-defeated");
	map_skill("hammer", "never-defeated");
	map_skill("club", "never-defeated");
	map_skill("whip", "never-defeated");
	map_skill("dagger", "never-defeated");
	map_skill("parry", "never-defeated");
	map_skill("dodge", "never-defeated");
	map_skill("force", "never-defeated");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: exert_function, "recover" :),
	}));

        setup();

        carry_object("/clone/cloth/cloth")->wear();
	  carry_object("/clone/weapon/changjian")->wield();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/2/wuxiu");
        obj->move(env, 1);
        obj = new("/clone/box/2/w6");
        obj->move(env, 1);
        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/jw1/npc/40");
        ob->move(environment(this_object()));
        destruct(this_object());
} 