inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("绝望宗师", ({ "y35 shadow", "shadow" }) );
        set("title", "影子宗师");
        set("gender", "男性");
        set("age", 40);
        set("long",
                "这个影子宗师似乎让人有些不真实感。\n");
        set("attitude", "peaceful");
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

	set("qi", 5400);
	set("max_qi", 5400);
	set("jing", 5400);
	set("max_jing", 5400);
	set("neili", 5400);
	set("max_neili", 5400);
	set("jiali", 150);

        set("combat_exp", 4000000);
        set("score", 30000);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

	set_skill("force", 440);
	set_skill("jiuyin-shengong", 440);
	set_skill("unarmed", 440);
	set_skill("claw", 440);
	set_skill("cuff", 440);
	set_skill("strike", 440);
	set_skill("finger", 440);
	set_skill("dodge", 440);
	set_skill("parry", 440);


	map_skill("force", "jiuyin-shengong");
	map_skill("dodge", "jiuyin-shengong");
	map_skill("parry", "jiuyin-shengong");
	map_skill("strike", "jiuyin-shengong");
	map_skill("finger", "jiuyin-shengong");
	map_skill("cuff", "jiuyin-shengong");
	map_skill("claw", "jiuyin-shengong");

	prepare_skill("claw", "jiuyin-shengong");
	prepare_skill("cuff", "jiuyin-shengong");
	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: exert_function, "recover" :),
		(: perform_action, "cuff.quan" :),
		(: perform_action, "strike.zhang" :),
		(: perform_action, "claw.zhua" :),
		(: perform_action, "finger.zhi" :),
	}));

        setup();

        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/2/wuxiu");
        obj->move(env, 1);
        obj = new("/clone/box/2/w5");
        obj->move(env, 1);
        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/jw1/npc/36");
        ob->move(environment(this_object()));
        destruct(this_object());
} 