inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("绝望之主-真", ({ "y45 shadow", "shadow" }) );
        set("title", "绝望之主");
        set("gender", "男性");
        set("age", 40);
        set("long",
                "这是绝望之塔的终极boss。\n");
        set("attitude", "peaceful");
        set("str", 100);
        set("con", 100);
        set("dex", 100);
        set("int", 100);

	set("qi", 10000);
	set("max_qi", 10000);
	set("jing", 10000);
	set("max_jing", 10000);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 150);

        set("combat_exp", 6000000);
        set("score", 30000);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

	set_skill("unarmed", 600);
	set_skill("sword", 600);
	set_skill("blade", 600);
	set_skill("staff", 600);
	set_skill("hammer", 600);
	set_skill("club", 600);
	set_skill("whip", 600);
	set_skill("dagger", 600);
	set_skill("throwing", 600);
	set_skill("parry", 600);
	set_skill("dodge", 600);
	set_skill("force", 600);
	set_skill("yinyang-shiertian", 600);


	map_skill("sword", "yinyang-shiertian");
	map_skill("blade", "yinyang-shiertian");
	map_skill("staff", "yinyang-shiertian");
	map_skill("hammer", "yinyang-shiertian");
	map_skill("club", "yinyang-shiertian");
	map_skill("whip", "yinyang-shiertian");
	map_skill("dagger", "yinyang-shiertian");
	map_skill("parry", "yinyang-shiertian");
	map_skill("dodge", "yinyang-shiertian");
	map_skill("force", "yinyang-shiertian");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: exert_function, "recover" :),
	}));

        setup();

        carry_object("/clone/cloth/cloth")->wear();
	  carry_object("/clone/weapon/changjian")->wield();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object obj, env;
        object killer;
        int exp;
        string userexp;
        int i;
        
        if (! query("have_reborn"))
        {
                set("have_reborn", 1);
                return;
        }
                env = environment(this_object());
        if (objectp(killer=this_object()->query_last_damage_from()))
        {
                userexp=killer->query("combat_exp");
                exp=((int)killer->query("literate")*4)+random(1000)+4000+atoi((userexp,6000));

                if (!killer->query_temp("m_success/孽龙"))
                {
                        killer->set_temp("m_success/孽龙",1);
                        killer->add("combat_exp",exp);
                        killer->add("potential",20000);
                        message("channel:say", HBYEL"【绝望之塔】"+killer->query("name")+"成功地过关!得到无数经验和潜能及宝物.\n"NOR,users());
                
                message_vision(MAG "一道金光从天而降，照耀着$N。\n" NOR, killer);
                message_vision(HIR "绝望之主说道：恭喜你们通过绝望之塔，这些宝贝就作为奖励吧！！！\n" NOR, this_object());           
      
        obj = new("/clone/box/1/d6_box");
        obj->move(env, 1);
        obj = new("/clone/box/baox");
        obj->move(env, 1);
        obj = new("/clone/box/2/w7");
        obj->move(env, 1);

                message_vision(HIY "金光退去，你突然发现地上有很多东西在闪闪发光。\n" NOR, this_object());
                }
        }
                env->set("exits/out", "/d/city/guangchang");
        message_vision("$N化作一缕清风而去。\n", this_object());
        destruct(this_object());
} 