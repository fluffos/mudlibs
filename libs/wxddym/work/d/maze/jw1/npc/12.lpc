inherit NPC;
#include <ansi.h>;

void create() {
  set_name("绝望战士", ({ "y12 shadow", "shadow" }));
  set("title", "影战士");
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这个影战士似乎让人有些不真实感。\n");
  set("attitude", "peaceful");
  set("str", 40);
  set("con", 40);
  set("dex", 40);
  set("int", 40);

  set("qi", 3100);
  set("max_qi", 3100);
  set("jing", 3100);
  set("max_jing", 3100);
  set("neili", 3100);
  set("max_neili", 3100);
  set("jiali", 105);

  set("combat_exp", 2000000);
  set("score", 30000);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("force", 210);
  set_skill("bluesea-force", 210);
  set_skill("strike", 210);
  set_skill("finger", 210);
  set_skill("dodge", 210);
  set_skill("parry", 210);


  map_skill("force", "bluesea-force");
  map_skill("dodge", "bluesea-force");
  map_skill("parry", "bluesea-force");
  map_skill("finger", "bluesea-force");
  map_skill("strike", "bluesea-force");

  prepare_skill("finger", "bluesea-force");
  prepare_skill("strike", "bluesea-force");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "shield" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/2/wuxiu");
  obj->move(env, 1);
  obj = new("/clone/box/2/w2");
  obj->move(env, 1);
  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/jw1/npc/13");
  ob->move(environment(this_object()));
  destruct(this_object());
}
