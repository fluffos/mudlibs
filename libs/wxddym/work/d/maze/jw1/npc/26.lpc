inherit NPC;
#include <ansi.h>;

void create() {
  set_name("绝望公公", ({ "y26 shadow", "shadow" }));
  set("title", "影子太监");
  set("gender", "无性");
  set("age", 30);
  set("long",
    "这个影子太监似乎让人有些不真实感。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("con", 50);
  set("dex", 50);
  set("int", 50);

  set("qi", 4500);
  set("max_qi", 4500);
  set("jing", 4500);
  set("max_jing", 4500);
  set("neili", 4500);
  set("max_neili", 4500);
  set("jiali", 150);

  set("combat_exp", 3000000);
  set("score", 30000);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("force", 350);
  set_skill("kuihua-mogong", 350);
  set_skill("unarmed", 350);
  set_skill("finger", 350);
  set_skill("dodge", 350);
  set_skill("parry", 350);


  map_skill("force", "kuihua-mogong");
  map_skill("dodge", "kuihua-mogong");
  map_skill("parry", "kuihua-mogong");
  map_skill("finger", "kuihua-mogong");
  map_skill("strike", "kuihua-mogong");

  prepare_skill("finger", "kuihua-mogong");
  prepare_skill("strike", "kuihua-mogong");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "shield" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/2/wuxiu");
  obj->move(env, 1);
  obj = new("/clone/box/2/w4");
  obj->move(env, 1);
  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/jw1/npc/27");
  ob->move(environment(this_object()));
  destruct(this_object());
}
