inherit NPC;
#include <ansi.h>;

void create() {
  set_name("绝望斗士", ({ "y7 shadow", "shadow" }));
  set("title", "影斗士");
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这个影斗士似乎让人有些不真实感。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("qi", 2600);
  set("max_qi", 2600);
  set("jing", 2600);
  set("max_jing", 2600);
  set("neili", 2600);
  set("max_neili", 2600);
  set("jiali", 75);

  set("combat_exp", 1000000);
  set("score", 30000);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("force", 160);
  set_skill("taixuan-gong", 160);
  set_skill("unarmed", 160);
  set_skill("dodge", 160);
  set_skill("parry", 160);

  map_skill("force", "taixuan-gong");
  map_skill("unarmed", "taixuan-gong");
  map_skill("dodge", "taixuan-gong");
  map_skill("parry", "taixuan-gong");

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/2/wuxiu");
  obj->move(env, 1);
  obj = new("/clone/box/2/w1");
  obj->move(env, 1);
  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/jw1/npc/8");
  ob->move(environment(this_object()));
  destruct(this_object());
}
