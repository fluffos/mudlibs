#include <ansi.h>
inherit ITEM;

void create() {

  set_name(HIC "绝望之塔" NOR, ({ "jw1 door", "door" }));
  set_weight(5);
  set("no_get", 1);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", GRN "从这个入口可以进入绝望之塔。(enter door)\n" NOR);
    set(
      "long",
      "挑战每次需要100点积分100两黄金" ZJURL("cmds:enter door") ZJSIZE(15) "" HIR "进入" NOR "最低进入条件武学修养 > 300级 !\n"
    );
    set("unit", "个");
    set("lore", 1);
  }
  setup();
}
void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  int time;
  object me = this_player();
  if (arg != "door")
    return 0;
  if (me->query_skill("martial-cognize", 1) < 300)
    return notify_fail("武学修养不足300,无法进入。\n");
  if (me->query("combat_exp") < 500000)
    return notify_fail("你的经验不足五十万,别去送死了。\n");
  if (me->query("suit_point") < 100)
    return notify_fail("你的积分不足,无法进入。\n");
  if (me->query("balance") < 1000000)
    return notify_fail("你的银行存款不足百两黄金,无法进入。\n");

  me->add("suit_point", -(100));
  me->add("balance", -(1000000));
  this_player()->delete_temp("maze");
  time = this_player()->query_temp("maze/time") + 180 - time();
  if (time > 0)
    return notify_fail("你还需要等" + CHINESE_D->chinese_period(time) + "才能进入副本。\n");
  MAZE_D->enter_maze(this_player(), "jw1");
  return 1;
}
