#include <ansi.h>
inherit ITEM;

void create()
{
                
        set_name(HIY"蜀山派副本"NOR, ({ "hsp door","door"}) );
        set_weight(99999);
        set("no_sun",1);
set("value", 5000);
set("no_get", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", GRN"从这个入口可以进入蜀山派副本。(enter door)\n"NOR); 
                set("long","挑战需要10元宝50两黄金"ZJURL("cmds:enter door")ZJSIZE(15)""HIR"进入"NOR"建议最低进入条件all sk > 150级!\n");
                set("unit", "个");
                set("lore",1);
        }
        setup();
}
void init()
{
        add_action("do_enter","enter");
}

int do_enter(string arg) 
{
        int time;
        object me = this_player();
        if (arg!="door")
                return 0;
	if (me->query("score")<0) 
             return notify_fail("你的江湖阅历太低,无法进入。\n");
	if (me->query("combat_exp")<0) 
             return notify_fail("你的经验大于两千三百万,进不去啦。\n");
	if (me->query("xy_money")<10) 
             return notify_fail("你的元宝不足10,无法进入。\n");
	if (me->query("balance")<500000) 
             return notify_fail("你的银行存款不足五十两黄金,无法进入。\n");
	if (me->query("weiwang")<0) 
             return notify_fail("你的江湖威望太低,无法进入。\n");
      if(me->query("family/family_name")!="蜀山派")
                return notify_fail("非蜀山派不进入「蜀山派副本」！\n");

	
        me->add("balance", -(500000));
        me->add("xy_money", -(10));
        this_player()->delete_temp("maze");
        time = this_player()->query_temp("maze/time")+180-time();
        if(time>0)
                return notify_fail("你还需要等"+CHINESE_D->chinese_period(time)+"才能进入副本。\n");
        MAZE_D->enter_maze(this_player(), "smfb");
        return 1;
}

