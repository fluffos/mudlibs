inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("内门弟子", ({ "y12 shadow", "shadow" }) );
        set("title", "葵花仙踪");
        set("gender", "无性");
        set("age", 30);
        set("long",
                "葵花仙踪乃隐世门派，拥有灵石矿数座。\n");
        set("attitude", "peaceful");
        set("str", 50);
        set("con", 50);
        set("dex", 50);
        set("int", 50);

	set("qi", 23200); 
	set("max_qi", 23200);
	set("jing", 23200);
	set("max_jing", 23200);    
	set("neili", 23200);
	set("max_neili", 23200);
	set("jiali", 105);			

        set("combat_exp", 30000000);
        set("score", 30000);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

	set_skill("force", 320);		
	set_skill("kuihua-mogong", 320);
	set_skill("unarmed", 320);
	set_skill("finger", 320);
	set_skill("dodge", 320);
	set_skill("parry", 320);


	map_skill("force", "kuihua-mogong");
	map_skill("dodge", "kuihua-mogong");
	map_skill("parry", "kuihua-mogong");
	map_skill("finger", "kuihua-mogong");
	map_skill("strike", "kuihua-mogong");

	prepare_skill("finger", "kuihua-mogong");
	prepare_skill("strike", "kuihua-mogong");
	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: exert_function, "recover" :),
		(: perform_action, "finger.you" :),
		(: perform_action, "finger.wu" :),
		(: perform_action, "finger.gui" :),
	}));

        setup();

        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/kuang/x1");
        obj->move(env, 1);
        obj = new("/clone/kuang/x1");
        obj->move(env, 1);
        obj = new("/clone/kuang/x1");
        obj->move(env, 1);
        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/khxz/npc/13");
        ob->move(environment(this_object()));
        destruct(this_object());
} 