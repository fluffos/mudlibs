#include <ansi.h>
inherit ITEM;

void create()
{
                
        set_name(HIC"烈火孽龙"NOR, ({ "xrfb door","door"}) );
        set_weight(5);
        set("no_get",1);

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", GRN"从这个入口可以进入烈火孽龙。(enter door)\n"NOR); 
                set("long","经验小余2300W,天魂小余15,一小时一次"ZJURL("cmds:enter door")ZJSIZE(15)""HIR"进入"NOR"最低进入条件武学修养 > 300级 !\n");
                set("unit", "个");
                set("lore",1);
        }
        setup();
}
void init()
{
        add_action("do_enter","enter");
}

int do_enter(string arg)
{
        int time;
        object me = this_player();
        if (arg!="door")
                return 0;
		if (me->query("score")<300)
             return notify_fail("你的江湖阅历太低,无法进入。\n");
		if (me->query("combat_exp")>23000000)
             return notify_fail("你的经验大于两千三百万，不要跟小朋友抢龙了。\n");
		if (me->query("level")>15)
             return notify_fail("你都这么强了，还来干嘛，这里没有棒棒糖啦!\n");
		if (me->query("weiwang")<300)
             return notify_fail("你的江湖威望太低,无法进入。\n");

        me->add("score", -(0));
        me->add("weiwang", -(0));
        this_player()->delete_temp("maze");
        time = this_player()->query_temp("maze/time")+180-time();
        if(time>0)
                return notify_fail("你还需要等"+CHINESE_D->chinese_period(time)+"才能进入副本。\n");
        MAZE_D->enter_maze(this_player(), "xrfb");
        return 1;
}

