// dizangwang

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("地藏王", ({ "di zang", }));
	set("long", "他容貌威严，不可一世。哇！他可是掌管人间生死的神仙。\n");
	set("gender", "男性");
	set("age", 99);
	set("attitude", "peaceful");
	set("shen_type", 0);
	set("per", 18);
        set("str", 100);
        set("con", 100);
        set("dex", 100);
        set("int", 100);

        set("neili", 10000);
        set("max_neili", 10000);
        set("jiali", 150);
        set("max_qi",20000);
        set("max_jing",20000);

        set_skill("strike", 600);
        set_skill("sword", 600);
        set_skill("force", 600);
        set_skill("parry", 600);
        set_skill("dodge", 600);
        set_skill("literate", 600);
        set_skill("diyushajie-strike", 600);
        set_skill("yinyang-shiertian", 600);
        set_skill("five-avoid", 600);
        set_skill("diyu-sword",600);

        map_skill("sword", "diyu-sword");
        map_skill("parry", "diyu-sword");
        map_skill("force", "yinyang-shiertian");
        map_skill("strike", "diyushajie-strike");
        map_skill("dodge", "five-avoid");

        set("combat_exp", 20000000);
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.gouhun" :),  
                (: perform_action, "dodge.break" :),         }) );

        set_temp("apply/attack", 100+random(100));
        set_temp("apply/damage",100+random(100));
        set_temp("apply/armor", 2000+random(1000));

      carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/cloth/cloth.lpc")->wear();
	create_family("冥府地藏王殿前", 1, "幽冥之主");
	set("title", HIR "幽冥之主" NOR);

      setup();
}

void init()
{
	object me;

	::init();
	me = this_player();
	if (! objectp(me) || ! userp(me))
		return;

	greeting(me);
}

void die()
{
        object obj, env;
        object killer;
        int exp;
        string userexp;
        int i;
        
        if (! query("have_reborn"))
        {
                set("have_reborn", 1);
                return;
        }
                env = environment(this_object());
        if (objectp(killer=this_object()->query_last_damage_from()))
        {
                userexp=killer->query("combat_exp");
                exp=((int)killer->query("literate")*4)+random(1000)+4000+atoi((userexp,6000));

                if (!killer->query_temp("m_success/孽龙"))
                {
                        killer->set_temp("m_success/孽龙",1);
                        killer->add("combat_exp",exp);
                        killer->add("potential",20000);
                        message("channel:say", HBRED"【阎罗殿】"+killer->query("name")+"成功地闯关成功!得到无数经验和潜能及宝物.\n"NOR,users());
                
                message_vision(MAG "一道彩光从天而降，照耀着$N。\n" NOR, killer);
                message_vision(HIR "一团彩色的火焰猛地升腾，一个声音说道：恭喜你过关，这些宝贝就作为谢礼吧！！！\n" NOR, this_object());           
                
       obj = new("/clone/kuang/yuanshi");
        obj->move(env, 1);
                
                message_vision(HIY "彩光退去，你突然发现地上有很多东西在闪闪发光。\n" NOR, this_object());
                }
        }
                env->set("exits/out", "/d/city/guangchang");
        message_vision("$N化作一缕清风而去。\n", this_object());
        destruct(this_object());
} 