inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("游魂", ({ "3shadow", "shadow" }) );
        set("title", "地府");
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 999);
        set("long",
                "生前是武林高手。\n");
        set("attitude", "peaceful");
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

        set("neili", 50000);
        set("max_neili", 50000);
        set("jiali", 100);
        set("max_qi",60000);
        set("max_jing",60000);

        set("combat_exp", 3000000);
        set("shen", 1000);
        set("apprentice_available", 3);

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.gouhun" :),  
                (: perform_action, "dodge.break" :),         }) );
        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

        set_skill("strike", 350);
        set_skill("sword", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("dodge", 350);
        set_skill("literate", 350);
        set_skill("dragon-strike", 350);
        set_skill("yinyang-shiertian", 350);
        set_skill("five-avoid", 350);
        set_skill("diyu-sword",350);

        map_skill("sword", "diyu-sword");
        map_skill("parry", "diyu-sword");
        map_skill("force", "yinyang-shiertian");
        map_skill("strike", "dragon-strike");
        map_skill("dodge", "five-avoid");

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
       obj = new("/clone/kuang/k1");
        obj->move(env, 1);
        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/yw/npc/4");
        ob->move(environment(this_object()));
        destruct(this_object());
} 
