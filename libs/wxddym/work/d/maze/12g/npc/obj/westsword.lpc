#include <weapon.h>
inherit BLADE;

void create() {
  set_name(HIY "黄金圣剑" NOR, ({ "west blade", "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄长长的精钢剑，剑口锋利。\n");
    set("value", 10000);
    set("material", "gold");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_blade(300);
  setup();

}
