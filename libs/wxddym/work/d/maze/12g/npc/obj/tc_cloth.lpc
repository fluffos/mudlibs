#include <armor.h>

inherit CLOTH;

void create()
{
   set_name(HIY"天秤圣衣"NOR, ({ "tianchen shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "gold");
     set("value",10000);
     set("armor_prop/armor",1000);
   }
   setup();
}
