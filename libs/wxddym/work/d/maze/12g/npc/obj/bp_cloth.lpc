#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIY "水瓶圣衣" NOR, ({ "shuiping shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 10000);
    set("material", "gold");
    set("armor_prop/armor", 1000);
  }
  setup();
}
