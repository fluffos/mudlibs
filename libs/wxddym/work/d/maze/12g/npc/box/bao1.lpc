#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "黄金宝箱" NOR, ({ "bao1" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set(
      "long",
      "这是70%失败的" + this_object()->query("name") + ",\n" ZJURL("cmds:open bao1") ZJSIZE(15) "打开" NOR "看看!\n"
    );
    set("unit", "个");
  }
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {

  object me, ob;
  int exp, qn;
  string sob, msg;
  string *gifts = ({
    "/clone/box/1/d1_box",
    "/clone/box/1/d2_box",
    "/clone/money/gold",
    "/clone/money/cash",
    "/clone/gift/jinkuai",
    "/clone/gift/puti-zi",
    "/clone/gift/fushougao",
    "/clone/gift/puti",
    "/clone/gift/jiuzhuan",
    "/d/maze/12g/npc/obj/bp_cloth",
    "/d/maze/12g/npc/obj/by_cloth",
    "/d/maze/12g/npc/obj/jn_cloth",
    "/d/maze/12g/npc/obj/jx_cloth",
    "/d/maze/12g/npc/obj/mj_cloth",
    "/d/maze/12g/npc/obj/rm_cloth",
    "/d/maze/12g/npc/obj/shz_cloth",
    "/d/maze/12g/npc/obj/su_cloth",
    "/d/maze/12g/npc/obj/sy_cloth",
    "/d/maze/12g/npc/obj/tc_cloth",
    "/d/maze/12g/npc/obj/tx_cloth",

  });

  me = this_player();

  if (environment(this_object()) != me) return 0;

  if (random(10) < 7) {
    write("你打开包裹一看，里面尽是一些不值钱的东西，随手将之仍在一边。\n");
    destruct(this_object());
    return 1;
  }

  // 获取一些奖励
  exp = me->query("combat_exp") / 1000000 + 5 + random(5);
  qn = 5 + random(5);

  sob = gifts[random(sizeof(gifts))];

  ob = new(sob);

  if (objectp(ob)) {
    msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
    msg += HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
    tell_object(me, msg);
    ob->move(me, 1);
    me->add("combat_exp", exp);
    me->add("potential", qn);
  } else {
    write("物件" + sob + " 错误。\n");
  }

  destruct(this_object());
  return 1;
}
