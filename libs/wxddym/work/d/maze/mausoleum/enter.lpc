
#include <command.h>
inherit ROOM;
void create()
{
        set("short", "内宫通道");
        set("long", @LONG
通道两侧，自东向西依次排列着狮、獬、骆驼、象、麒麟和马六
种石雕巨兽，各有两对四座，共十二对二十四座，造型生动，栩栩如
生，使你像来到了传说的仙界。在淡淡的月照下，众石兽或蹲或立，
不畏风霜雨雪。
LONG );

        set("virtual_room", 1);

        set("objects", ([
                "/d/maze/mausoleum/npc/jiangling": 2,
                "/d/maze/mausoleum/npc/qianrenzhang": 3,
                "/d/maze/mausoleum/npc/bairenzhang": 4,
                "/d/maze/mausoleum/npc/bingshi": 5,
         //       "/d/maze/mausoleum/npc/baozi": 3,
                "/d/maze/mausoleum/npc/tiger": 5,
                "/d/maze/mausoleum/npc/lions": 5,
                "/d/maze/mausoleum/npc/ni": 1,
                "/d/maze/mausoleum/npc/mammoth": 1,
				"/d/maze/mausoleum/npc/king": 1,
        ]));
	/*set("exits", ([
		"east"  : __DIR__"eastgate",
		"south" : __DIR__"southgate",
		"west"  : __DIR__"westgate",
		"north" : __DIR__"northgate",
	]));*/
        setup();
        replace_program(ROOM);
}