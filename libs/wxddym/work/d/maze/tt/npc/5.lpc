inherit NPC;
#include <ansi.h>;

void create() {
  set_name("亚伯汗", ({ "5 shadow", "shadow" }));
  set("title", "扭曲天使");
  set("gender", "无性");
  set("class", "swordsman");
  set("age", 999);
  set("long",
    "他用他的力量报复了上帝，在上帝的世界扭曲，由于他和妹妹的力量可以轻松建立一个异世界这个世界和上帝的世界没有不同，这个世界的力量等同或高过于上帝，一旦他在世界中使用扭曲，那么我们人类的灵魂都会死在我们的梦中。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("max_qi", 5000);
  set("max_jing", 5000);

  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("dodge", 190);
  set_skill("force", 190);
  set_skill("parry", 190);
  set_skill("unarmed", 190);
  set_skill("sword", 190);
  set_skill("xiyang-jian", 190);
  set_skill("xiyang-neigong", 190);
  set_skill("xiyang-boji", 190);
  map_skill("sword", "xiyang-jian");
  map_skill("parry", "xiyang-jian");
  map_skill("force", "xiyang-neigong");
  map_skill("dodge", "xiyang-boji");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.ci" :),
    (: perform_action, "sword.lian" :), }));

  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/sssbao");
  obj->move(env, 1);

  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/tt/npc/6");
  ob->move(environment(this_object()));
  destruct(this_object());
}
