inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("库勒", ({ "17 shadow", "shadow" }) );
        set("title", "时间天使");
        set("gender", "无性");
        set("class", "swordsman");
        set("age", 999);
        set("long",
                "库勒有一次非常失败的失误，在古代，他的能力违背了上帝的默许，上帝收回了能力，因为库勒在那时候为了某个人而让时间倒退，甚至停止。这些都非常自私。库勒一直都在上帝身旁，虽然也很想帮帮我们人类，却不能让时间停下来，所以如果你在特别着急的时候发现时间好像在无意间稍微慢了一点的时候，那么别诧异，那就是库勒在不被上帝发现的情况下在帮助你……\n");
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("max_qi",5000);
        set("max_jing",5000);

        set("combat_exp", 1000000);
        set("apprentice_available", 3);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

          set_skill("dodge", 310);
          set_skill("force", 310);
          set_skill("parry", 310);
          set_skill("unarmed", 310);
          set_skill("sword", 310);
          set_skill("xiyang-jian", 310);
          set_skill("xiyang-neigong", 310);
          set_skill("xiyang-boji", 310);
          map_skill("sword","xiyang-jian");
          map_skill("parry","xiyang-jian");
          map_skill("force","xiyang-neigong");
          map_skill("dodge","xiyang-boji");

          set("chat_chance_combat", 30);
          set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.ci" :), 
                (: perform_action, "sword.lian" :),         }) );

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/sssbao");
        obj->move(env, 1);

        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/tt/npc/18");
        ob->move(environment(this_object()));
        destruct(this_object());
} 
