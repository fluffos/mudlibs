inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("瑰洱", ({ "15 shadow", "shadow" }) );
        set("title", "梦天使");
        set("gender", "无性");
        set("class", "swordsman");
        set("age", 999);
        set("long",
                "有着未知的身世，只有上帝明白。上帝对于她的作功非常冷漠，可是，在许多时候上帝对于她的作功又是非常关注。她能力很大。她是堕天使（亚伯汗）的妹妹。她与她哥哥的作用在某中程度上来说甚至可以造出一个等同于上帝世界的另一个世界，名为“异世界”，而他们兄妹在异世界自然就是主宰。只是他们并没有背叛上帝……\n");
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("max_qi",5000);
        set("max_jing",5000);

        set("combat_exp", 1000000);
        set("apprentice_available", 3);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

          set_skill("dodge", 290);
          set_skill("force", 290);
          set_skill("parry", 290);
          set_skill("unarmed", 290);
          set_skill("sword", 290);
          set_skill("xiyang-jian", 290);
          set_skill("xiyang-neigong", 290);
          set_skill("xiyang-boji", 290);
          map_skill("sword","xiyang-jian");
          map_skill("parry","xiyang-jian");
          map_skill("force","xiyang-neigong");
          map_skill("dodge","xiyang-boji");

          set("chat_chance_combat", 30);
          set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.ci" :), 
                (: perform_action, "sword.lian" :),         }) );

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/sssbao");
        obj->move(env, 1);

        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/tt/npc/16");
        ob->move(environment(this_object()));
        destruct(this_object());
} 
