inherit NPC;
#include <ansi.h>;

void create() {
  set_name("诃息", ({ "11 shadow", "shadow" }));
  set("title", "智慧天使");
  set("gender", "无性");
  set("class", "swordsman");
  set("age", 999);
  set("long",
    "上帝赐予他与自己同等的智慧，可以看穿一切的眼神，但却越发显出凄凉。与其他天使相比，诃息的一切都是那么冰冷，似乎越是达到一定智慧的天使越忧郁。还有人说诃息之所以悲凉是因为他看穿了未来，看穿了人类的罪，看穿了未来的末日审判的浩劫……\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("max_qi", 5000);
  set("max_jing", 5000);

  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("sword", 250);
  set_skill("xiyang-jian", 250);
  set_skill("xiyang-neigong", 250);
  set_skill("xiyang-boji", 250);
  map_skill("sword", "xiyang-jian");
  map_skill("parry", "xiyang-jian");
  map_skill("force", "xiyang-neigong");
  map_skill("dodge", "xiyang-boji");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.ci" :),
    (: perform_action, "sword.lian" :), }));

  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/sssbao");
  obj->move(env, 1);

  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/tt/npc/12");
  ob->move(environment(this_object()));
  destruct(this_object());
}
