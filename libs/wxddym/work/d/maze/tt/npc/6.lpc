inherit NPC;
#include <ansi.h>;

void create() {
  set_name("帛曳", ({ "6 shadow", "shadow" }));
  set("title", "光明天使");
  set("gender", "无性");
  set("class", "swordsman");
  set("age", 999);
  set("long",
    "人们之所以喜欢这个天使是因为他的力量可以消除人们的恐惧，让人们充满希望。但是，遗憾的是，他是天使中唯一一个公然背叛上帝的天使，他的身体已经被昔拉撕碎，但上帝见他始终是一个天使，就让他永远活在自己的光明中。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("max_qi", 5000);
  set("max_jing", 5000);

  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("xiyang-jian", 200);
  set_skill("xiyang-neigong", 200);
  set_skill("xiyang-boji", 200);
  map_skill("sword", "xiyang-jian");
  map_skill("parry", "xiyang-jian");
  map_skill("force", "xiyang-neigong");
  map_skill("dodge", "xiyang-boji");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.ci" :),
    (: perform_action, "sword.lian" :), }));

  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/sssbao");
  obj->move(env, 1);

  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/tt/npc/7");
  ob->move(environment(this_object()));
  destruct(this_object());
}
