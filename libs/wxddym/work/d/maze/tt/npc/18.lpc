inherit NPC;
#include <ansi.h>;

void create() {
  set_name("欧亚", ({ "18 shadow", "shadow" }));
  set("title", "力量天使");
  set("gender", "无性");
  set("class", "swordsman");
  set("age", 999);
  set("long",
    "这个天使是所有天使里（不包括堕天使）中力量最大的。所谓力量不是单纯指的肌肉力，而是改变力和各种意识力。末日审判的前3天毁灭人类总数3分之一的天使中就有他。他可是最宽容的一个天使，他可以在毫无保留的情况下给予你力量，不过大部分情况下上帝会把他给人类的力量收回……\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("max_qi", 5000);
  set("max_jing", 5000);

  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("unarmed", 350);
  set_skill("sword", 350);
  set_skill("xiyang-jian", 350);
  set_skill("xiyang-neigong", 350);
  set_skill("xiyang-boji", 350);
  map_skill("sword", "xiyang-jian");
  map_skill("parry", "xiyang-jian");
  map_skill("force", "xiyang-neigong");
  map_skill("dodge", "xiyang-boji");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.ci" :),
    (: perform_action, "sword.lian" :), }));

  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/sssbao");
  obj->move(env, 1);

  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  env->set("exits/out", "/d/city/guangchang");
  message_vision("$N化作一缕清风而去。\n", this_object());
  destruct(this_object());
}
