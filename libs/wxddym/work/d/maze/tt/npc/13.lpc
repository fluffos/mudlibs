inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("莫迪", ({ "13 shadow", "shadow" }) );
        set("title", "情感天使");
        set("gender", "无性");
        set("class", "swordsman");
        set("age", 999);
        set("long",
                "他原本是某国家的王子，为了所爱的人牺牲生命，这也就是第一个拥有爱的人，在他以前人们是没有爱的，终日嫉妒，没有怜悯。他死后，上帝要赐予他力量，他选择赋予爱的能力。可是他始终是一个人类，不能代表主神行事，所以上帝刺瞎他的双眼要他行事，以免为主神所患，所以我们人类都是莫笛在盲的情况下赐予的爱，我们要珍惜，因为也许莫迪只会来临一次……\n");
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("max_qi",5000);
        set("max_jing",5000);

        set("combat_exp", 1000000);
        set("apprentice_available", 3);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

          set_skill("dodge", 270);
          set_skill("force", 270);
          set_skill("parry", 270);
          set_skill("unarmed", 270);
          set_skill("sword", 270);
          set_skill("xiyang-jian", 270);
          set_skill("xiyang-neigong", 270);
          set_skill("xiyang-boji", 270);
          map_skill("sword","xiyang-jian");
          map_skill("parry","xiyang-jian");
          map_skill("force","xiyang-neigong");
          map_skill("dodge","xiyang-boji");

          set("chat_chance_combat", 30);
          set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.ci" :), 
                (: perform_action, "sword.lian" :),         }) );

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/sssbao");
        obj->move(env, 1);

        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/tt/npc/14");
        ob->move(environment(this_object()));
        destruct(this_object());
} 
