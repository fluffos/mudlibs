inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("番尼", ({ "7 shadow", "shadow" }) );
        set("title", "叛逆天使");
        set("gender", "无性");
        set("class", "swordsman");
        set("age", 999);
        set("long",
                "他的名字和力量等同，他有着独特的赐予力，虽然他不能造出世界，不能反抗上帝，但是他能给予人们反抗上帝的力量。这种力量是自我的改变力，不过无论怎么改变，都会被上帝惩罚，因为上帝不允许那种改变力存在。\n");
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("max_qi",5000);
        set("max_jing",5000);

        set("combat_exp", 1000000);
        set("apprentice_available", 3);

        set("inquiry", ([
            "过关": "要想过关，得先打败我。\n",
        ]) );

          set_skill("dodge", 210);
          set_skill("force", 210);
          set_skill("parry", 210);
          set_skill("unarmed", 210);
          set_skill("sword", 210);
          set_skill("xiyang-jian", 210);
          set_skill("xiyang-neigong", 210);
          set_skill("xiyang-boji", 210);
          map_skill("sword","xiyang-jian");
          map_skill("parry","xiyang-jian");
          map_skill("force","xiyang-neigong");
          map_skill("dodge","xiyang-boji");

          set("chat_chance_combat", 30);
          set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.ci" :), 
                (: perform_action, "sword.lian" :),         }) );

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob)
{
        ob=this_player();
        command("say 来得好！我可是不会手下留情的。\n"); 
        ob->set_temp("m_success/幻影",1);  
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
        return 1;
}

void die()
{
        object ob,obj,env;
        env = environment(this_object());
        obj = new("/clone/box/sssbao");
        obj->move(env, 1);

        message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
        ob = new("/d/maze/tt/npc/8");
        ob->move(environment(this_object()));
        destruct(this_object());
} 
