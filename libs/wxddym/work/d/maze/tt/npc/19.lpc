// dizangwang

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("耶和华", ({ "shang di", }));
	set("title", "上帝");
	set("gender", "男性");
	set("age", 999);
	set("attitude", "peaceful");
      set("long","上帝（YHWH）是犹太教、基督教、伊斯兰教创造宇宙的神。被视为宗教信徒至高无上的信仰，在基督教中，上帝是永恒的存在，创造和治理世界。\n");
	set("shen_type", 0);
	set("per", 18);
        set("str", 100);
        set("con", 100);
        set("dex", 100);
        set("int", 100);

        set("neili", 10000);
        set("max_neili", 10000);
        set("jiali", 150);
        set("max_qi",10000);
        set("max_jing",10000);
        set("combat_exp", 10000000);

          set_skill("dodge", 400);
          set_skill("force", 400);
          set_skill("parry", 400);
          set_skill("unarmed", 400);
          set_skill("sword", 400);
          set_skill("xiyang-jian", 400);
          set_skill("xiyang-neigong", 400);
          set_skill("xiyang-boji", 400);
          map_skill("sword","xiyang-jian");
          map_skill("parry","xiyang-jian");
          map_skill("force","xiyang-neigong");
          map_skill("dodge","xiyang-boji");

          set("chat_chance_combat", 30);
          set("chat_msg_combat", ({
                (: exert_function, "powerup" :), 
                (: perform_action, "sword.ci" :), 
                (: perform_action, "sword.lian" :),         }) );

        set_temp("apply/attack", 100+random(100));
        set_temp("apply/damage",100+random(100));
        set_temp("apply/armor", 2000+random(1000));

      carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/cloth/cloth.lpc")->wear();

      setup();
}

void init()
{
	object me;

	::init();
	me = this_player();
	if (! objectp(me) || ! userp(me))
		return;

	greeting(me);
}

void die()
{
        object obj, env;
        object killer;
        int exp;
        string userexp;
        int i;
        
        if (! query("have_reborn"))
        {
                set("have_reborn", 1);
                return;
        }
                env = environment(this_object());
        if (objectp(killer=this_object()->query_last_damage_from()))
        {
                userexp=killer->query("combat_exp");
                exp=((int)killer->query("literate")*4)+random(1000)+4000+atoi((userexp,6000));

                if (!killer->query_temp("m_success/孽龙"))
                {
                        killer->set_temp("m_success/孽龙",1);
                        killer->add("combat_exp",exp);
                        killer->add("potential",20000);
                        message("channel:say", HBCYN"【天堂】"+killer->query("name")+"成功地闯关成功!得到无数经验和潜能及宝物.\n"NOR,users());
                
                message_vision(MAG "一道彩光从天而降，照耀着$N。\n" NOR, killer);
                message_vision(HIR "一团白色的火焰猛地升腾，一个声音说道：恭喜你过关，这些宝贝就作为谢礼吧！！！\n" NOR, this_object());           
                
        obj = new("/clone/box/sssbao");
        obj->move(env, 1);

                message_vision(HIY "彩光退去，你突然发现地上有很多东西在闪闪发光。\n" NOR, this_object());
                }
        }
                env->set("exits/out", "/d/city/guangchang");
        message_vision("$N化作一缕清风而去。\n", this_object());
        destruct(this_object());
} 