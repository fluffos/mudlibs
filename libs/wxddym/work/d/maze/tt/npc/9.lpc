inherit NPC;
#include <ansi.h>;

void create() {
  set_name("贲薨", ({ "9 shadow", "shadow" }));
  set("title", "失去天使");
  set("gender", "无性");
  set("class", "swordsman");
  set("age", 999);
  set("long",
    "他的能力非常不讨人喜欢，他使人失去东西。我们平常丢东西，或者失去亲人，就是他的功劳。但传言，他每拿一件东西的同时都要磨练人类的意志，从而给人类更美好的事物。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 30);

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("max_qi", 5000);
  set("max_jing", 5000);

  set("combat_exp", 1000000);
  set("apprentice_available", 3);

  set("inquiry", ([
    "过关": "要想过关，得先打败我。\n",
  ]));

  set_skill("dodge", 230);
  set_skill("force", 230);
  set_skill("parry", 230);
  set_skill("unarmed", 230);
  set_skill("sword", 230);
  set_skill("xiyang-jian", 230);
  set_skill("xiyang-neigong", 230);
  set_skill("xiyang-boji", 230);
  map_skill("sword", "xiyang-jian");
  map_skill("parry", "xiyang-jian");
  map_skill("force", "xiyang-neigong");
  map_skill("dodge", "xiyang-boji");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.ci" :),
    (: perform_action, "sword.lian" :), }));

  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

int accept_fight(object ob) {
  ob = this_player();
  command("say 来得好！我可是不会手下留情的。\n");
  ob->set_temp("m_success/幻影", 1);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
  return 1;
}

void die() {
  object ob, obj, env;
  env = environment(this_object());
  obj = new("/clone/box/sssbao");
  obj->move(env, 1);

  message_vision("\n$N一晃，变为一缕轻烟消失了。\n", this_object());
  ob = new("/d/maze/tt/npc/10");
  ob->move(environment(this_object()));
  destruct(this_object());
}
