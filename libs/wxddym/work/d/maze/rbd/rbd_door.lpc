#include <ansi.h>
inherit ITEM;

void create() {

  set_name(HIW "新年副本" NOR, ({ "rb door", "door" }));
  set_weight(5);
  set("no_get", 1);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", GRN "从这个入口可以进入日本岛。(enter door)\n" NOR);
    set(
      "long",
      "没有要求" ZJURL("cmds:enter door") ZJSIZE(15) "" HIR "进入" NOR "最低进入条件all sk > 160级 !\n"
    );
    set("unit", "个");
    set("lore", 1);
  }
  setup();
}
void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  int time;
  object me = this_player();
  if (arg != "door")
    return 0;
  if (me->query("score") < 0)
    return notify_fail("你的江湖阅历不够,无法进入。\n");
  if (me->query("combat_exp") < 0)
    return notify_fail("你的经验不足五十万,别去送死了。\n");
  if (me->query("weiwang") < 0)
    return notify_fail("你的江湖威望不足,无法进入。\n");
  if (me->query("balance") < 0)
    return notify_fail("你的银行存款不足十两黄金,无法进入。\n");
  me->add("score", -(0));
  me->add("weiwang", -(0));
  me->add("balance", -(0));
  this_player()->delete_temp("maze");
  time = this_player()->query_temp("maze/time") + 180 - time();
  if (time > 0)
    return notify_fail("你还需要等" + CHINESE_D->chinese_period(time) + "才能进入副本。\n");
  MAZE_D->enter_maze(this_player(), "rbd");
  return 1;
}
