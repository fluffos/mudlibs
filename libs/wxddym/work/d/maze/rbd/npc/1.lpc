#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIW "日本兵" NOR, ({ "bing", "guizi" }));
  set("long", "一个个无耻卑鄙的日本兵.\n");
  set("gender", "男性");
  set("no_get", 1);
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 100);
  set("per", 12);
  set("str", 100);
  set("int", 100);
  set("combat_exp", 5000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "日本兵说道：八哥牙鲁！\n"
  }));
  set("max_neili", 2000);
  set("neili", 2000);
  set("max_jingli", 3000);
  set("jingli", 6000);
  set("jiali", 500);
  set("max_qi", 5000);
  set("max_jing", 5000);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
  set_skill("sword", 100);
  set_skill("daya-jian", 100);
  set_skill("lingbo-weibu", 100);
  set_skill("jiuyang-shengong", 100);
  set_skill("jiuyin-baiguzhao", 100);
  map_skill("force", "jiuyang-shengong");
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("parry", "daya-jian");
  map_skill("sword", "daya-jian");
  create_family("日本国", 3, "杀人狂");
  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "sword.daya" :),
  }));
  setup();
  carry_object(__DIR__ "obj/japan1-cloth")->wear();
  carry_object(__DIR__ "obj/japan-sword")->wield();
}
void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");

  rand = random(100);
  if (rand >= 101) {
    item = new("/clone/money/silver");
    if (item) {
      item->set_amount(50);
      item->move(environment(ob));
    }
  }

  else if (rand < 70) {
    item = new("/clone/xinnian/xinnianbaoxiang");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
