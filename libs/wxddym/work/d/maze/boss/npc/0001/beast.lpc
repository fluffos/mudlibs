// This program is a part of NITAN MudLIB

#include <ansi.h>
inherit NPC;

string *first_name = ({ "水", "海" });
string *first_id = ({ "shui", "hai" });
string *name_words = ({ "巨灵", "怪" });
string *id_words = ({ "juling", "guai" });

void create() {
  string name;
  int i, j;

  i = random(sizeof(first_name));
  name = first_name[i];
  j = random(sizeof(name_words));
  name += name_words[j];

  set_name(name, ({ first_id[i] + " " + id_words[j] }));
  set("long", "深海跑出来的怪物，丹药。\n");
  // random_name_color(this_object());       
  set("age", 20);
  set("vrm_guard", 1);
  set("attitude", "peaceful");

  set("dex", 80);
  set("con", 80);
  set("int", 80);
  set("str", 80);

  set("combat_exp", 100000000);
  set("level", 10);
  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 100000);
  set("max_jing", 100000);
  set("neili", 400000);
  set("max_neili", 400000);
  set("neili", 400000);
  set("jiali", 2000);

  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("force", 150);


  set_temp("apply/attack", 100 + random(100));
  set_temp("apply/unarmed_damage", 100 + random(100));
  set_temp("apply/armor", 200 + random(100));

  setup();
  carry_object("/clone/fam/pill/puti1")->set_amount(2);
  carry_object("/clone/fam/pill/neili1")->set_amount(2);
  carry_object("/clone/money/gold")->set_amount(5);
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}

mixed hit_ob(object me, object ob, int damage_bouns) {
  int damage;

  damage = 100 + random(100);
  damage -= ob->query_temp("apply/reduce_cold");
  if (damage < 0) damage = 0;
  ob->receive_wound("qi", damage, me);
  me->set("neili", me->query("max_neili"));
  return HIC "$N" HIC "“哈”的一声吐出一口寒气，登时令$n"
    HIC "四肢几乎冻僵。\n" NOR;
}

void unconcious() {
  die();
}

void die() {
  ::die();
}
