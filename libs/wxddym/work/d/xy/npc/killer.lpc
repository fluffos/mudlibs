#include <ansi.h>

inherit "inherit/char/boss";
void set_from_me(object me);
void create()
{
	set_name("蒙古士兵", ({ "bingshi"}));
	set("gender", "无性");
	set("age",26);
	set("long", "他是一位蒙古士兵，正在入侵襄阳。\n");

        set("str", 80);
        set("int", 78);
        set("con", 78);
        set("dex", 90);

        set("qi", 30000);
        set("max_qi", 30000);
        set("jing", 27000);
        set("max_jing", 27000);
        set("neili", 8000);
        set("max_neili", 8000);
        set("jiali", 120);
        set("level", 50);
        set("combat_exp", 29000000);
        set("bonus", 200 + random(200));

        set_skill("force", 300 + random(300));
        set_skill("unarmed", 300 + random(300));
        set_skill("dodge", 300 + random(300));
        set_skill("parry", 300 + random(300));
        set_skill("sword", 300 + random(300));
        set_skill("kuihua-mogong", 300 + random(300));
        map_skill("force", "kuihua-mogong");
        map_skill("dodge", "kuihua-mogong");
        map_skill("unarmed", "kuihua-mogong");
        map_skill("sword","kuihua-mogong");
        map_skill("parry","kuihua-mogong");

        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("perform sword.fenshen") :),
                (: command("perform sword.tian") :),
                (: command("perform sword.you") :),
                (: command("perform sword.sheng") :),
                (: command("perform sword.qiong") :),
                (: command("exert shield") :),
                (: command("exert powerup") :),
        }) );


        set_temp("apply/attack", 100);
        set_temp("apply/damage", 180);
        set_temp("apply/unarmed_damage", 180);
        set_temp("apply/armor", 180);

        set("master_ob",5);
		setup();
        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/gangjian")->wield();
}

void init()
{
        object me;

        ::init();
        if (! interactive(me = this_player()) ||
            this_object()->is_fighting())
                return;

        set_from_me(me);
//        remove_call_out("kill_ob");
//        call_out("kill_ob", 0, me);
}

void set_from_me(object me)
{
        mapping my;

        NPC_D->init_npc_skill(this_object(), NPC_D->check_level(me));
        my = query_entire_dbase();
        my["eff_jing"] = my["max_jing"];
        my["jing"] = my["max_jing"];
        my["eff_qi"] = my["max_qi"];
        my["qi"] = my["max_qi"];
        set("jiali", query_skill("force") / 2);
}
//函数：寻敌
void findPlayer()
{
	object map,*players,ob;
	int i,size,rand;

	ob = this_object();
	map = environment(ob);
	players = all_inventory(map);

	size = sizeof(players);
	rand = random(size);
	if(userp(players[rand])) ob->kill_ob(players[rand]);
	call_out("findPlayer",1+random(5));
}