#include <ansi.h>
inherit NPC;

#define MIRROR_SYS "/d/xy/sys/xy_sys"

int ask_job();

void create()
{

        set_name("襄阳将军", ({ "jiangjun", "jiang" }));


        set("gender", "男性");
        set("age", 36);
        set("long","他是一位襄阳的守城将军。\n");

		set("inquiry", ([
        	"挑战镜像" : (: ask_job :),
            ]));

        setup();

}

int ask_job()
{
	object me;
	object *team,memory;

	me = this_player();

	if(!me->is_team_leader())
	{
		tell_object(me,"你不是领队。\n");
		return 1;
	}

	team = me->query_team();
	if(!pointerp(team) || sizeof(team) < 2)
	{
		tell_object(me,"你的人手不够。\n");
		return 1;
	}

		if (me->query("combat_exp")<3000000)
             return notify_fail("你的经验不足三百万,别去送死了。\n");

        if( time()-me->query_temp("xy/maze")<7200 )
             return notify_fail(HIG "襄阳战争要两小时只能进一次。\n" NOR);
		me->set_temp("xy/maze", time());

	if(MIRROR_SYS->query_room_amount() >= 20)
	{
		tell_object(me,"镜像已经开启太多，欢迎下次参与。\n");
		return 1;
	}
	//删除旧的副本
	memory = me->query_temp("xy/xy_memory");
	if(objectp(memory))
	{
		memory->delete("user_id");
	}
	//创建新的副本
	MIRROR_SYS->xy(team,me);
	return 1;
}