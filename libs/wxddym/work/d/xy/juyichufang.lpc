inherit ROOM;

void create()
{
        set("short", "厨房");
        set("long", @LONG
这儿是聚义馆的厨房，一般只有白天有几个烧饭师傅在烧火做饭，
供应（serve）伙食，到了晚上就看你的运气了。
LONG );
        set("exits", ([
                "north" : __DIR__"juyihuayuan",
        ]));
        set("objects", ([
                __DIR__"npc/killer" : random(10),
                __DIR__"npc/mam" : 1,
                __DIR__"npc/jiangling" : 1,
        ]));
        setup();
}

