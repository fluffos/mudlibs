inherit ROOM;
void create() {
  set("short", "城外空地");
  set("long", @LONG
这是城外的空地，一些蒙古兵的奸细和箭手常在这带游弋，以寻
找他们感兴趣的猎物，不时有几枚冷箭从头顶嗖地飞过，令人防不胜
防。
LONG);
  set("outdoors", "xiangyang");
  set("no_clean_up", 0);
  set("step", 2);
  set("no_fly", 1);
  set("exits", ([
    "east": __DIR__ "east_out8",
    "west": __DIR__ "east_out6",
  ]));
  set("objects", ([
    __DIR__ "npc/killer": random(10),
    __DIR__ "npc/mam": 1,
    __DIR__ "npc/jiangling": 1,
  ]));
  setup();
}

