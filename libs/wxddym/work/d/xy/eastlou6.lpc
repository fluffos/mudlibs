inherit ROOM;

void create()
{
        set("short", "城东箭楼");
        set("long", @LONG
这是东城头的箭楼，里面布满了一排的垛口，一排大宋的箭手们
正警惕地监视着城外的一举一动，随时准备给前来偷袭的蒙古兵以迎
头痛击。
LONG );
        set("indoors", "xiangyang");
        set("no_clean_up", 0);
        set("site", "east_out");
        set("no_fly",1);
        set("exits", ([
                "east" : __DIR__"east_out1",
                "up" : __DIR__"eastlou7",
                "down" : __DIR__"eastlou5",
        ]));
        set("objects", ([
                __DIR__"npc/killer" : random(10),
                __DIR__"npc/mam" : 1,
                __DIR__"npc/jiangling" : 1,
        ]));
        setup();
}

