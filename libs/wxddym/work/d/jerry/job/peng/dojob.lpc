#include <ansi.h>
int do_copy(object me, int maxpot);
//string ask_job()
int give_quest()

{
  object me = this_player();
  object ob;
  mapping target, quest;
  mapping skl;
  string place, str;

  quest = (__DIR__ "where")->query_quest();
  skl = me->query_skills();
  if (interactive(me) && (int)me->query("job_target")) {
    write("你现在的任务是去除掉在『"
      +me->query("job_target")
      + "』一带活动的jianxi\n" NOR);
    return 1;
  }
  /*
        if ( !skl||me->query("combat_exp") < 1000000 ) {
                return ( RANK_D->query_respect(me) +"你的功夫太差了,你还是先去学一些本事先吧！");
                
        }
*/
  if (me->query("combat_exp") > 1700000000) {
    write(HIW "这位老大已经这么厉害了,我这里恐怕留不住您！\n" NOR);
    return 1;
  }
  if ((time() - me->query_temp("peng_time")) < 6) {
    write(HIW "您这么快就做完任务了,现在我这里没什么事可让你做,你先歇歇吧！\n" NOR);
    return 1;

  }
  command("nod" + me->query("id"));
  command("say " + RANK_D->query_respect(me) + "保卫国家，正是我等中华儿女份内之事!");

  ob = new(__DIR__ "killer1");

  ob->do_copy(me, 1);
  ob->move(quest["place"]);
  me->set("job_target", quest["short"]);
  me->query_temp("peng_time", time());
  ob->set("jym_level/level", me->query("jym_level/level"));
  ob->set_temp("must_killby", me->query("id"));
  ob->set("quest_npc", 1);
  ob->set("no_dun", 1);

  tell_object(me, HIY "我听说有敌方奸细『" + ob->query("id") + "』\n");
  tell_object(me, HIY "在『" + quest["short"] + "』一带出现\n" NOR);
  return 1;

}
int ask_fail() {
  object me;
  int i;
  me = this_player();
  i = me->query("potential");
  if (!me->query("job_target")) {
    me->start_busy(10);
    tell_object(me, HIW "你没有领任务,跑这里瞎嚷嚷什麽?busy你10秒！\n" NOR);
    return 1;
  }

  if (i > 300) {
    write(HIW "我看错你了，我只能找别人了,扣你300点POT！\n" NOR);
    me->add("potential", -300);
    me->delete_temp("job_given");

  }
  if (i <= 300) {
    command("say 扣掉你所有的qn");
    me->set("potential", 0);
  }
  me->delete("job_target");
  me->delete_temp("job_given");
  return 0;

}

int accept_object(object who, object ob, object me) {
  object *inv;
  int i;
  if (ob->query("id") != who->query("id") + " jianxi corpse") {
    command("say 你给我这个干吗?");
    return 0;
  }
  if (!who->query("job_target")) {
    command("say 好啊！不过你得先申请任务。");
    return 0;
  }
  if (ob->query_temp("must_killby") != who->query("id")
    || who->query_temp("job_given"))  //                       ||ob->query("victim_user")||who->query_temp("job_given") )
  {
    command("shake");
    command("say 你杀错人了。");
    return 0;
  }
  who->set_temp("job_given", 1);
  //                              inv = all_inventory(ob);
  //                              for(i=0; i<sizeof(inv); i++) inv[i]->move(environment(me));
  call_out("destroying", 1, ob);
  call_out("ok", 1, who);
  return 1;
}
void ok(object who) {
  int exp, pot, i, j;
  j = who->query("combat_exp");
  if (!who) return;
  command("pat" + who->query("id"));
  command("say 做的好，加油干!");
  exp = who->query_skill("literate", 1) + random(1000);
  if (exp > 8000) exp = 7805 + random(200);
  exp = exp - random(600);
  exp *= 10;
  pot = exp / 10 + random(100);
  who->add("potential", pot);
  who->add("combat_exp", exp);
  who->delete("job_target");
  who->delete_temp("job_given");
  who->set_temp("peng_time", time() + 20);
  /*
    who->apply_condition("peng_wait",1);
*/
  tell_object(who, HIW "你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" +
    NOR);
  return;
}
void destroying(object obj) {
  destruct(obj);
  return;
}
