// Updated by yuchang
inherit NPC;
#include <ansi.h>
void big_blowing();

void create() {
  set_name(HIR "火麒麟" NOR, ({ "huo qilin", "qilin" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 200);
  set("long",
    "这是一条全身赤红，吸天地之间的火气而长大的火麒麟！
它全身散发着赤红色的火焰。\n");

  set("str", 100);
  set("con", 100);
  set("dex", 100);

  set("dodge", 333);
  set("force", 333);
  set("unarmed", 333);
  set("parry", 333);
  set("max_qi", 10000);
  set("max_jing", 10000);
  set("max_neili", 10000);
  set("attitude", "aggressive");
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({ (: big_blowing :) }));
  set("combat_exp", 51100000);
  set("bellicosity", 30000);

  set_temp("apply/attack", 300 + random(200));
  set_temp("apply/damage", 500 + random(400));
  set_temp("apply/armor", 500 + random(400));

  setup();
}

void big_blowing() {
  int i, dam;
  object *inv, me, ob;

  ob = this_object();
  me = this_player();

  tell_room(environment(ob), HIR "\n\n火麒麟突然吐出一股炽可焚金的火焰，"
    "整个天地似乎都被烧着了！！！\n\n" NOR);


  inv = all_inventory(environment(ob));
  for (i = 0; i < sizeof(inv); i++)
    if (living(inv[i]) && inv[i] != ob) {
      dam = random(300) + 100;
      inv[i]->receive_wound("qi", dam);
      tell_object(inv[i], HBRED "你被火焰烧着，顿觉气血大受损伤！\n\n" NOR);
    }
}



void init() {
  object me, ob;

  ::init();
  if (!interactive(me = this_player()))
    return;

  // 自动攻击玩家
  kill_ob(me);
}
void die() {
  object ob, obj, item;
  object killer;
  int exp, userexp, rand;

  ob = this_object();
  message_vision(HIR "\n$N" HIG "挣扎了几下，发出一声惨叫，便不再动弹了。\n" NOR, ob);

  if (objectp(killer = ob->query_last_damage_from()) &&
    !killer->query("reborn_start/qilindong/qilin")) {
    userexp = killer->query("combat_exp");
    //exp=((int)killer->query("literate")*2)+random(1000)+10000+(userexp);
    obj = new(__DIR__ "obj/jiushi");
    obj->move(killer, 1);

    message_vision(HIC "\n\n一团火焰猛地升腾，一个声音对$N说道："
      "谢谢你杀死火麒麟，你将得到绝世好剑作为奖励！\n\n" NOR, killer);
    message_vision(HIY "只见$N" HIY "慢慢消失，只剩下了一柄宝剑。\n"
      "\n$n随即将宝剑捡了起来。\n\n" NOR, ob, killer);
    killer->set("reborn_start/qilindong/qilin", 1);
    // killer->add("combat_exp",exp);
    killer->add("potential", 2000);
    message("vison", HBMAG "【传闻】：据说" + killer->query("name") +
      "成功地杀死了火麒麟，得到宝物《绝世好剑》!\n" NOR, users());
  }

  rand = random(100);
  if (rand >= 20) {
    item = new("/clone/money/glod");
    if (item) {
      item->set_amount(10);
      item->move(environment(ob));
    }
  }

  else if (rand < 20) {
    item = new("/clone/newbox/wsbox");
    if (item) {
      item->move(environment(ob));
    }
  } else if (rand < 15) {
    item = new("/clone/newbox/wscbox");
    if (item) {
      item->move(environment(ob));
    }
  } else if (rand < 10) {
    item = new("/clone/newbox/wsgbox");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
