

#define SYSTEM_BUY "/d/wizard/include/buy.lpc"
inherit NPC;
inherit F_DEALER;
void create()
{
	set_name("会员商人", ({ "vip shang", "shang"}));

	set("gender", "男生");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"万事如意"NOR);
	set("long","会员商人，请用buy id购买你想要的物品。\n");
	set("no_kill",1);

	set("vendor_goods", ([
                "/clone/newbox/xiang"         : 100,
                "/clone/money/thousand-gold"         : 100,
                "/clone/box/feijian"         : 5,
                "/clone/box/jifen"         : 99,
                "/clone/box/feijian1"         : 50,
                "/clone/box/feijian2"         : 20,
                "/clone/gift/tianfu"         : 10,
                "/clone/gift/liqi"         : 5,
                "/clone/gift/jinpai"         : 20,
                "/clone/gift/xiandan"         : 50,
                "/clone/gift/shenliwan"       : 50,
                "/clone/gift/unknowdan"       : 50,
                "/clone/gift/xisuidan"       : 50,
				"/clone/gift/bianxing"       : 99,
                "/clone/goods/washgift"       : 100,
                "/clone/gift/perwan"          : 10,
				"/d/boss/huan/juyuan"  : 20,
                "/clone/gift/huirongwan"  : 5,
                "/clone/item/tianshi-charm"  : 50,
				"/clone/gift/exppot"   : 30,
				"/clone/gift/tianxiang"   : 20,
				"/clone/gift/fushougao"   : 10,
			//	"/clone/goods/tianjing"   : 799,
				"/clone/goods/ouyezi-charm"   : 1399,
				"/clone/name"   : 100,
	]));

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

int do_list()
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(SYSTEM_BUY->do_list(me,npc)) return 1;
	else
	{
		tell_object(me,"对不起,现在没有东西出售。\n");
		return 1;
	}
}

int do_buy(string arg)
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(!arg)
	{
		tell_object(me,"你想买什么？\n");
		return 1;
	}

	return SYSTEM_BUY->do_buy(me,npc,arg);
}
