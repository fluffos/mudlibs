inherit ROOM;
#include <room.h>
void create()
{
        set("short", HIW"日本-大阪"NOR);
        set("long", @LONG
你走在日本大阪的街道上，感到心情非常的HAPPY。
你心中不由得说:去他妈的日本鬼子,我要杀光你们!

LONG
       );
        set("exits", ([
                "south" :  __DIR__"dadao2",
 //               "north" :  __DIR__"dadao3",
  //              "east":    __DIR__"dao4",
  //              "west"  :  __DIR__"dadao5",
        ]));
        set("objects",([
		             __DIR__"npc/xiaoquan" : 1,
                 __DIR__"npc/bing" : 8,
        ]));
        set("no_fly",1);
        setup();
        replace_program(ROOM);
}

