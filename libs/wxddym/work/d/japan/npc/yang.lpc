//抗日任务 (改编自12gong job)
//@txwx by hhm 06/07/01
inherit NPC;
#include <ansi.h>
string ask_me();
void create()
{
    set_name(HIR"杨靖宇"NOR, ({ "yang jingyu", "yang" }));
    set("long", 
        "他是著名的抗日英雄了，长的威风凛凛。\n");
    set("gender", "男性");
    set("age", 30);
    set("attitude", "friendly");
    set("shen_type", 1);
    set("str", 25);
    set("int", 35);
    set("con", 25);
    set("dex", 25);
    set("inquiry", ([
      "抗日杀敌":(:ask_me:),
    ]) );
    
    set("max_qi", 800);
    set("max_jing", 800);
    set("neili", 800);
    set("max_neili", 800);
    set("jiali", 60);
    set("combat_exp", 150000);
    set("score", 40000);
    set_skill("blade",60);
    set_skill("ruyi-dao",60);
    set_skill("force", 60);
    set_skill("dodge", 60);
    set_skill("unarmed", 60);
    set_skill("parry", 60);
    set_skill("lingboweibu", 60);
    set_skill("beiming-shengong",60);
    set_skill("zhemei-shou", 60);
    map_skill("unarmed", "zhemei-shou");
    map_skill("dodge", "lingboweibu");
    map_skill("force", "beiming-shengong");
    map_skill("blade", "ruyi-dao");
    set("book_count", 1);
    set("title",HIY"【抗日英雄】"NOR);
    setup();
 //   carry_object(__DIR__"obj/cloth")->wear();
//  carry_object(__DIR__"obj/blade")->wield();
}
string ask_me()
{
    object me,ob;
    me=this_player(); 
    if (query("combat_exp") > 5000000)
        return "哈哈,小朋友你的武功还不行啊,回去多练几年再来吧!";          
    command("chat 好样的,抛头颅撒热血,马革裹尸才是我堂堂中华男儿本色!\n");
    me->move("/d/japan/dadao1");
    return "你就放心的走吧!\n";
}
