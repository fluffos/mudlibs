//抗日任务 (改编自12gong job)
//@txwx by hhm 06/07/01
inherit NPC;
#include "star.h"
void create()
{
        set_name(HIW"日本兵"NOR, ({"bing", "guizi"}));
        set("long", "一个个无耻卑鄙的日本兵.\n");
        set("gender","男性");
        set("no_get",1);
        set("age",37);
        set("attitude", "peaceful");
        set("con",100);
        set("per",12);
        set("str",100);
        set("int",100);
        set("combat_exp",5000000);
        set("chat_chance",20);
        set("chat_msg", ({
                "日本兵说道：八哥牙鲁！\n"   
        }));
         set("max_neili", 2000);
         set("neili", 2000);
         set("max_jingli",3000);
         set("jingli",6000);
         set("jiali",500);
         set("max_qi", 5000);
         set("max_jing", 5000);
          set_skill("dodge", 100);
          set_skill("force", 100);
          set_skill("parry", 100);
          set_skill("unarmed", 100);
          set_skill("sword", 100);
         set_skill("daya-jian",100);
          set_skill("lingbo-weibu",100);
         set_skill("jiuyang-shengong", 100);
        set_skill("jiuyin-baiguzhao", 100);
         map_skill("force","jiuyang-shengong");
        map_skill("unarmed","jiuyin-baiguzhao");
        map_skill("parry","daya-jian");
        map_skill("sword","daya-jian");
        create_family("日本国",3,"杀人狂");
        set("chat_chance_combat", 300);
        set("chat_msg_combat", ({
        (: perform_action, "sword.daya" :),
    }) );
        setup();
        carry_object(__DIR__"obj/japan1-cloth")->wear();
        carry_object(__DIR__"obj/japan-sword")->wield();
}
 

void die()
{
       object ob = query_temp("my_killer");
        ob->start_busy(3);
        ob->add("potential",100);
        ob->add("combat_exp", 100);

        tell_object(ob,HIR"你赢得了500经验,500潜能.\n\n"NOR);
        say(HIR"日本兵挣扎着喊道：天皇万岁!!\n"NOR);                 
        message_vision("$N惨嚎一声，死了！\n", this_object());
       ::die();
}
