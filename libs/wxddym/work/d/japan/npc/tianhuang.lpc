//抗日任务 (改编自12gong job)
//@txwx by hhm 06/07/01
inherit NPC;
#include "star.h"
void create() {
  set_name(HIR "天  皇" NOR, ({ "tian huang", "huang", "king" }));
  set("long", "日本人的天皇.\n");
  set("gender", "男性");
  set("title", HIR "【卑鄙无耻】" NOR);
  set("no_get", 1);
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 3000);
  set("per", 12);
  set("str", 2500);
  set("int", 3500);
  set("combat_exp", 50000000);
  set("chat_chance", 20);
  set("inquiry", ([
    "投降": "我向中国人投降了!" ]));
  setup();
  set("max_neili", 22000);
  set("neili", 24000000);
  set("max_jingli", 3000);
  set("jingli", 600000);
  set("jiali", 50000);
  set("max_qi", 500000);
  set("max_jing", 500000);
  set_skill("dodge", 3000);
  set_skill("force", 3000);
  set_skill("parry", 3000);
  set_skill("unarmed", 3000);
  set_skill("sword", 3000);
  set_skill("daya-jian", 2000);
  set_skill("lingbo-weibu", 2000);
  set_skill("jiuyang-shengong", 2000);
  set_skill("jiuyin-baiguzhao", 2000);
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("force", "jiuyang-shengong");
  map_skill("parry", "daya-jian");
  map_skill("sword", "daya-jian");
  map_skill("dodge", "lingbo-weibu");
  create_family("日本国", 1, "天皇");
  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "sword.daya" :),
  }));
  setup();
  carry_object(__DIR__ "obj/japan-cloth")->wear();
  carry_object(__DIR__ "obj/japan-sword")->wield();
}

