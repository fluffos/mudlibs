//抗日任务 (改编自12gong job)
//@txwx by hhm 06/07/01
inherit NPC;
#include "star.h"
void create() {
  set_name(HIW "安倍晋四" NOR, ({ "an bei", "guizi" }));
  set("long", "日本人的首相,一个无耻的坏蛋\n");
  set("gender", "男性");
  set("title", HIR "【卑鄙无耻】" NOR);
  set("no_get", 1);
  set("age", 37);
  set("attitude", "peaceful");
  set("con", 30);
  set("per", 12);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 1000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "安倍晋四说道：八哥牙鲁！\n"
  }));
  set("max_neili", 2400);
  set("neili", 2400);
  set("max_jingli", 3000);
  set("jingli", 6000);
  set("jiali", 50000);
  set("max_qi", 5000);
  set("max_jing", 500000);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 150);
  set_skill("sword", 150);
  set_skill("daya-jian", 150);
  set_skill("lingbo-weibu", 150);
  set_skill("jiuyang-shengong", 150);
  set_skill("jiuyin-baiguzhao", 150);
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("force", "jiuyang-shengong");
  map_skill("parry", "daya-jian");
  map_skill("sword", "daya-jian");
  create_family("日本国", 1, "天皇");
  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "sword.daya" :),
  }));
  setup();
  carry_object(__DIR__ "obj/japan-cloth")->wear();
  carry_object(__DIR__ "obj/japan-sword")->wield();
}

void die() {
  object ob = query_temp("my_killer");
  ob->start_busy(3);
  message("chat", HIY + "【抗日英雄】:" + ob->name() +
    "杀到了" + environment(ob)->query("short") + "\n" NOR, users());
  ob->add("potential", 1000);
  ob->add("combat_exp", 1000);
  tell_object(ob, HIR "你赢得了5000经验,5000潜能.\n\n" NOR);
  say(HIR "安倍挣扎着喊道：天皇万岁!!!\n" NOR);
  ::die();
}
void init() {
  object ob;

  ::init();

  ob = this_player();

  if (interactive(ob) && (!ob->query("age") || ob->query("age") > 13)) {
    command("heihei");
    command("es 大日本帝国万岁!!!\n");
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    command("perform badao");
  }
}
