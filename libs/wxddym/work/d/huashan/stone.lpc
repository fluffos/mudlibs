//Room: stone 领悟玄铁剑法的地方

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "巨石上");
  set(
    "long",
    "这里是华山瀑布下的一块天然巨大石头上，周围尽是湍急的水流，汹涌的高山洪水（hongshui）倾泄而下拍打在你身上。\n" ZJURL("cmds:study table") + ZJSIZE(20) + HIC "参悟武学大道" NOR "\n"
  );
  set("outdoors", "huashan");
  set("can_practice_xiantie-jian", 1);
  set("item_desc", ([
    "【洪水】": "洪水汹涌无比，你只觉随时有可能被洪水冲到水中。\n"
    ZJOBACTS2 + ZJMENUF(3, 3, 8, 30) "跳下去:jump stone\n",
  ]));
  set("no_fight", 1);
  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_study", "study");
}

int do_jump() {
  object me = this_player();

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你忙完了再说吧！\n");

  message_vision(HIG "$N" HIG "纵身跳上瀑布 ……\n", me);

  me->move(__DIR__ "shanhongpb");

  return 1;
}

int do_study(string arg) {
  object me;
  int jing_cost, b;

  me = this_player();

  if (!arg || (arg != "table"))
    return notify_fail("什么？\n");

  if (me->is_busy()) return notify_fail("你正在忙着呢！\n");

  jing_cost = (-1) * random(2);
  if ((int)me->query("jing") < jing_cost)
    return notify_fail("你现在精神无法集中！\n");

  me->add("jing", jing_cost);
  b = me->query("int") * 3 + random(50);
  tell_object(me, "你开始专心研读石桌上的古怪图形。\n");
  if ((int)me->query_skill("martial-cognize", 1) < 500) {
    me->improve_skill("martial-cognize", b);
    tell_object(me, HIC "\n你对着石桌琢磨了一回儿，你的武学修养长进了" + chinese_number(b) + "点。" NOR "\n");
  }
  /*		
if (me->query_condition("db_exp")) {
		me->improve_skill("martial-cognize", b );
		tell_object(me,"在双倍丹的作用下，你的武学修养额外获得了"HIG+chinese_number(b)+NOR"点。\n");
}
if (me->query_condition("db_exp2")) {
		me->improve_skill("martial-cognize", b*2 );
		tell_object(me,"在三倍丹的作用下，你的武学修养额外获得了"HIG+chinese_number(b*2)+NOR"点。\n");
}*/
  me->start_busy(random(3));
  return 1;
}
