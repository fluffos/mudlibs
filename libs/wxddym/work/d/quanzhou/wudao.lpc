// Room: /xiakedao/shidong2.c

inherit ROOM;

#include <ansi.h>

string look_bi();

void create() {
  set("short", "武道之巅");
  set("long", @LONG
四周弥漫着一种不可描述的气息。
LONG);
  set("exits", ([
    "west": __DIR__ "kedian",
  ]));

  set("item_desc", ([
    "【参悟】": "你开始参悟自身武学真谛\n"
    ZJOBACTS2 + ZJMENUF(3, 3, 8, 30) "参悟:think bi\n",

  ]));
  setup();
}

void init() {
  add_action("do_think", "think");
}

int do_think(string arg) {
  object here, me = this_player();
  int add;

  if (!here = find_object(__DIR__ "furong1"))
    here = load_object(__DIR__ "furong1");

  if (me->query("special_skill/clever"))
    add = me->query_int() / 40;
  else
    add = me->query_int() / 100;

  if (!living(me) || arg != "bi")
    return notify_fail("你要参悟什么？\n");

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");


  if ((int)me->query("int") < 150)
    return notify_fail("你若有所悟，然而总是有点不明白。\n");

  if ((int)me->query("dex") < 150)
    return notify_fail("你研究了半天，只觉招式始终无法随意施展。\n");

  if ((int)me->query("con") < 150)
    return notify_fail("你研究了半天，只觉得根骨有些差，招式始终无法随意施展。\n");

  if ((int)me->query("str") < 150)
    return notify_fail("你研究了半天，感觉膂力有些低，始终无法随意施展。\n");

  if ((int)me->query("level") < 18)
    return notify_fail("你研究了半天，感觉自身天魂太低，无法参悟自身武学真谛。\n");

  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候不够，无法参悟自身武学真谛。\n");

  if ((int)me->query_skill("martial-cognize", 1) < 300)
    return notify_fail("你的武学修养不够，无法参悟自身武学真谛。\n");

  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不足，无法参悟自身武学真谛。\n");

  if ((int)me->query_skill("tiandaodao", 1) < 500)
    return notify_fail("你的天道刀修为不够，无法参悟自身武学真谛。\n");

  if ((int)me->query_skill("tiandaojian", 1) < 500)
    return notify_fail("你的天道剑修为不够，无法参悟自身武学真谛。\n");

  if ((int)me->query_skill("tiandaoquan", 1) < 500)
    return notify_fail("你的天道拳修为不够，无法参悟自身武学真谛。\n");


  if ((int)me->query_skill("tiandaozhang", 1) < 500)
    return notify_fail("你的天道掌修为不够，无法参悟自身武学真谛。\n");


  if ((int)me->query_skill("tiandao-shengti", 1) < 500)
    return notify_fail("你的天道圣体修为不够，无法参悟自身武学真谛。\n");


  if ((int)me->query_skill("tiandao-dunyi", 1) < 500)
    return notify_fail("你的天道遁一修为不够，无法参悟自身武学真谛。\n");

  if ((int)me->query("jing") < 85)
    return notify_fail("你现在精神不济，过于疲倦，还是休息"
      "一会吧。\n");

  if ((int)me->query_skill("wudao-shanqian", 1) >= 100)
    return notify_fail("你觉得石壁上记载的武功对你来说太浅了，结果你"
      "什么也没学到。\n");

  me->receive_damage("jing", 75);

  if (me->can_improve_skill("wudao-shanqian"))
    me->delete_skill("tiandaodao");
  me->delete_skill("tiandaojian");
  me->delete_skill("tiandaoquan");
  me->delete_skill("tiandaozhang");
  me->delete_skill("tiandao-shengti");
  me->delete_skill("tiandao-dunyi");
  me->improve_skill("wudao-shanqian", add);

  CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name() + "演练出" HIY "武道三千" HIM "。\n");

  me->start_busy(random(2));
  message_vision(HIY "\n$N" HIY "双目紧闭，思绪渐凝，取天下武功之长，
补武学大道之短，
武学中艰难晦涩之处顿时烟消云散。
良久，你似有所悟，仰天长啸，茅塞顿开。
是谓至理：“天下武功，如出一辙，万变不离其宗。”
至此，你终于领悟了\n" NOR, me);
  write(HIC "「武道三千」\n" NOR);
  return 1;
}
