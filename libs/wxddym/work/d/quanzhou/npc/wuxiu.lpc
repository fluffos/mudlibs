// zhu.c 朱熹

#include <ansi.h>

inherit NPC;
inherit F_DEALER;

string ask_buy();
string ask_job();
string ask_chaoji();
int  do_copy(string arg);
int  do_copy2(string arg);
int do_answer();
int  working(object me);
int  working2(object me);
int  halt_working(object me);
int  halt_working2(object me);

void create()
{
	set_name("礼宾小姐", ({ "wu xiu" }));
	set("long", "优惠大促销了，现在吃喝玩乐、按摩、洗澡、桑拿一条龙服务，一次只要10两白银。\n");
	set("gender", "女性");
	set("age", 18);
	set("no_get", 1);
	set_skill("literate", 5000);
	 set("teacher",1);
	set_skill("unarmed", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/damage", 20);

	set("combat_exp", 400000);
	set("shen_type", 1);
	set("inquiry", ([
	    "大宝剑" : (: ask_job :),
	    "超级大宝剑" : (: ask_chaoji :),

	]));
	setup();

	set("chat_chance", 1);
	set("chat_msg", ({
		"收费员说道：小哥哥，快来玩啊。\n",
		"收费员说道：小姐姐，快来玩啊。\n",
		"收费员说道：小弟弟，快来玩啊。\n",
	}) );
}

void init()
{
	add_action("do_copy", "copy");
	add_action("do_copy2", "copy2");
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

int do_answer()
{
	::do_list();
	write(name() + HIR"在你耳边轻声说道：我这可真是货真价实，童叟无欺啊！"NOR"\n");
	return 1;
}


void auto_copy(object me)
{
	if(!me->query_temp("pending/auto_copy"))
		return;
	if(me->is_busy())
		call_out("auto_copy",1,me);
	else if( (int)me->query("qi") < 50||(int)me->query("jing") < 50 )
	{
		tell_object(me,"体力不足，休息中。。。\n");
		call_out("auto_copy",10,me);
	}
	else
	{
		tell_object(me,"大宝剑，继续。。。。。。\n");
		tell_object(me,ZJFORCECMD("ask "+this_object()->query("id")+" about 大宝剑"));
	}
}

void auto_copy2(object me)
{
	if(!me->query_temp("pending/auto_copy2"))
		return;
	if(me->is_busy())
		call_out("auto_copy2",1,me);
	else if( (int)me->query("qi") < 50||(int)me->query("jing") < 50 )
	{
		tell_object(me,"体力不足，休息中。。。\n");
		call_out("auto_copy2",10,me);
	}
	else
	{
		tell_object(me,"超级大宝剑，继续。。。。。。\n");
		tell_object(me,ZJFORCECMD("ask "+this_object()->query("id")+" about 超级大宝剑"));
	}
}

string ask_job()
{
	object me;
	object *obs;

	me = this_player();
	if (me->query_temp("job/copy"))
		return "欢迎下次光临";

	if (me->query("combat_exp") < 500000)
		return "就这么点经验懂什么叫一条龙吗？";

	if (me->query("qi") < 20)
		return "我看你脸色不行啊，先歇会儿吧，我可不想闹出人命来。";

	if (me->query("balance") < 1000) 
             return "没钱还想大宝剑，吔屎啦你。";

	
	if (! interactive(me))
		return "...";

	obs = filter_array(all_inventory(environment()),
			   (: interactive($1) && $1 != $(me) && $1->query_temp("job/copy") && query_ip_number($1) == query_ip_number($(me)) :));
	if (sizeof(obs) > 0)
		return "我这已经有" + obs[0]->name() + "在享受了，你等等吧。";

	me->set_temp("job/copy", 1);
	tell_object(me,ZJFORCECMD("copy"));
	tell_object(me,ZJEXIT"northwest:"RED"被抓"NOR":halt\n");
	return "吃喝玩乐、按摩、洗澡、桑拿一条龙服务开始了。";

}
string ask_chaoji()
{
	object me;
	object *obs;

	me = this_player();
	if (me->query_temp("job/copy2"))
		return "欢迎下次光临？";

	if (me->query("combat_exp") < 500000)
		return "就这么点经验懂什么叫一条龙吗？";

	if (me->query("qi") < 20)
		return "我看你脸色不行啊，先歇会儿吧，我可不想闹出人命来。";

	if (me->query("xy_money") < 10) 
             return "没钱还想超级大宝剑，吔屎啦你。";

	
	if (! interactive(me))
		return "...";

	obs = filter_array(all_inventory(environment()),
			   (: interactive($1) && $1 != $(me) && $1->query_temp("job/copy") && query_ip_number($1) == query_ip_number($(me)) :));
	if (sizeof(obs) > 0)
		return "我这已经有" + obs[0]->name() + "在享受了，你等等吧。";

	me->set_temp("job/copy2", 1);
	tell_object(me,ZJFORCECMD("copy2"));
	tell_object(me,ZJEXIT"northwest:"RED"被抓"NOR":halt\n");
	return "吃喝玩乐、按摩、洗澡、桑拿一条龙服务开始了。";

}

int do_copy(string arg)
{
	object me;

	me = this_player();
	if (me->is_busy())
		return notify_fail("你正忙着呢，别着急。\n");

	if (! me->query_temp("job/copy"))
	{
			message_vision("$N脱下衣服，刚想洗澡，就听见$n大喝道：给我滚。\n",me, this_object());
		return 1;
	}

	me->set_temp("job/step", 1);
	me->set_temp("pending/auto_copy", 1);
	me->start_busy(bind((: call_other, __FILE__, "working" :), me),
		       bind((: call_other, __FILE__, "halt_working" :), me));
	tell_object(me, "旁边的人开始帮你脱下衣服。\n");
	return 1;
}

int do_copy2(string arg)
{
	object me;

	me = this_player();
	if (me->is_busy())
		return notify_fail("你正忙着呢，别着急。\n");

	if (! me->query_temp("job/copy2"))
	{
			message_vision("$N脱下衣服，刚想洗澡，就听见$n大喝道：给我滚。\n",me, this_object());
		return 1;
	}

	me->set_temp("job/step", 1);
	me->set_temp("pending/auto_copy2", 1);
	me->start_busy(bind((: call_other, __FILE__, "working2" :), me),
		       bind((: call_other, __FILE__, "halt_working2" :), me));
	tell_object(me, "旁边的人开始帮你脱下衣服。\n");
	return 1;
}

int working(object me)
{
	string msg;
	int finish;
	int b;

	if (! me->query_temp("job/step"))
		me->set_temp("job/step", 1);

	if (! living(me))
	{
		me->delete_temp("job/copy");
		me->delete_temp("job/step");
		return 0;
	}

	finish = 0;
	me->receive_damage("jing", 1);
	me->receive_damage("qi", 2);
	switch (me->query_temp("job/step"))
	{
	case 1:
		msg = "旁边的人开始服侍$N洗热澡。";
		break;
	case 2:
		msg = "接着伺候$N蒸桑拿。";
		break;
	case 3:
		msg = "然后$N点了一些特色大宝剑服务。";
		break;
	case 4:
             msg = "伴随着$N的出气声，你的动作越发的激烈起来。";
		break;
	case 6:
	case 5:
	case 7:
	default:
		msg = "紧跟着身体的一阵抽搐，$N的肉体如一摊难泥，大脑进入贤者时间。";
		finish = 1;
		break;
	}
	msg += "\n";

	if (finish)
	{
		object ob;
		msg += "$N看了$n，满意道：还行，服务不错！"
		       "这是给你的小费！\n";
		me->delete_temp("job/copy");
		me->delete_temp("job/step");

		b = 1200 + random(400);
		me->improve_skill("martial-cognize", b);
             me->add("balance", -(1000));
			 

	}

	msg = replace_string(msg, "$N", "你");
	msg = replace_string(msg, "$n", name());
	tell_object(me, msg);

if (finish)
	{

		if (b > 0)
		{
			tell_object(me, HIC "\n你的天上人间壹佰零捌式获得了" + chinese_number(b) + "点经验。"NOR"\n");
		}
//		if(me->query("zjvip/level")&&me->query_temp("tuoguan/zhu"))
			call_out("auto_copy",1,me);
		return 0;
	}

	me->add_temp("job/step", 1);
	return 1;
}

int working2(object me)
{
	string msg;
	int finish;
	int b;

	if (! me->query_temp("job/step"))
		me->set_temp("job/step", 1);

	if (! living(me))
	{
		me->delete_temp("job/copy2");
		me->delete_temp("job/step");
		return 0;
	}

	finish = 0;
	me->receive_damage("jing", 1);
	me->receive_damage("qi", 2);
	switch (me->query_temp("job/step"))
	{
	case 1:
		msg = "旁边的人开始服侍$N洗热澡。";
		break;
	case 2:
		msg = "接着伺候$N蒸桑拿。";
		break;
	case 3:
		msg = "然后$N点了天上人间特殊服务《超级大宝剑》。";
		break;
	case 4:
             msg = "伴随着$N剧烈的出气声，$N的动作越发快速激烈起来。";
		break;
	case 6:
	case 5:
	case 7:
	default:
		msg = "紧跟着身体的一阵抽搐，$N的肉体如一摊难泥，大脑进入贤者时间。";
		finish = 1;
		break;
	}
	msg += "\n";

	if (finish)
	{
		object ob;
		msg += "$N看了$n，满意道：还行，服务不错！"
		       "这是给你的小费！\n";
		me->delete_temp("job/copy2");
		me->delete_temp("job/step");

		b = me->query("int") * 5 + ((me->query("int") * 5) * me->query("level"))/10;
		me->improve_skill("martial-cognize", b);
             me->add("xy_money", -(10));
			 
	}

	msg = replace_string(msg, "$N", "你");
	msg = replace_string(msg, "$n", name());
	tell_object(me, msg);

if (finish)
	{
		if (b > 0)
		{
			tell_object(me, HIC "\n你的天上人间壹佰零捌式获得了" + chinese_number(b) + "点经验。"NOR"\n");
		}
//		if(me->query("zjvip/level")&&me->query_temp("tuoguan/zhu"))
			call_out("auto_copy2",1,me);
		return 0;
	}

	me->add_temp("job/step", 1);
	return 1;
}

int halt_working(object me)
{
	message_vision("我们是FBI联邦屌插局，现在我们严重怀疑$N涉嫌大宝剑服务，请跟我们走一趟，但你有权保持沉默。\n", me);
	me->delete_temp("job/copy");
	me->delete_temp("pending/auto_copy");
	me->delete_temp("job/step");
	return 1;
}

int halt_working2(object me)
{
	message_vision("我们是FBI联邦屌插局，现在我们严重怀疑$N涉嫌天上人间的《超级大宝剑》服务，请跟我们走一趟，但你有权保持沉默。\n", me);
	me->delete_temp("job/copy2");
	me->delete_temp("pending/auto_copy2");
	me->delete_temp("job/step");
	return 1;
}
