#include <ansi.h>


inherit NPC;
inherit F_MASTER;
inherit F_COAGENT;


void create()
{
        object ob;
        set_name("浪人", ({ "langren" }));
        set("long", @LONG
东瀛来中原传授刀法的一名刀客
LONG);
        set("title", "东瀛");
        set("nickname", HIR "刀魔" NOR);
        set("gender", "男性");
        set("age", 42);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 38);
        set("int", 38);
        set("con", 38);
        set("dex", 38);

        set("max_qi", 10000);
        set("max_jing", 5000);
        set("neili", 6000);
        set("max_neili", 6000);
        set("jiali", 200);
        set("combat_exp", 2500000);

        set_skill("dodge", 260);
        set_skill("parry", 260);
        set_skill("blade", 260);
        set_skill("dongyang-dao", 260);

        map_skill("blade", "dongyang-dao");


        set("killer_reward", ([ 
                "RA&RANDOM50"    :       20000,   // 低级普通装备 
                "RA&RANDOM60"    :       300,     // 低级普通装备 
                "FI&/clone/fam/skpaper/blade1"   :   5000,
                "FI&/clone/fam/skpaper/sword1"   :   5000,
                "MO&A0000"       :       300,
                "MO&A0001"       :       300,
                "MO&A0002"       :       300,
                "MO&A0003"       :       300,
                "MO&A0004"       :       300,
                "MO&A0005"       :       300,
                
        ]));
	setup();

}

void attempt_apprentice(object me)
{
        string purename, name, new_name;



        if ((int)me->query("combat_exp") < 200000)
        {
                command("sigh");
                command("say 你的江湖经验太浅，还是先多锻炼锻炼再说吧。");
                return;
        }

        if ((int)me->query_skill("force") < 120)
        {
                command("say 学我东洋刀法，内功非精纯不可，你还是先多练练吧。");
                return;
        }

        if ((int)me->query_skill("blade", 1) < 100)
        {
                command("say 如要学我东洋刀法，你还得在刀法上多下工夫。");
                return;
        }


}