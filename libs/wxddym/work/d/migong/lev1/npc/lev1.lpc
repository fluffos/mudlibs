// migong lev1

#include <ansi.h>

inherit BOSS;


void create()

{
  set_name("狐狸", ({ "fox", "huli" }));

  set("race", "野兽");
  set("long",
    "一只狡猾的狐狸。\n");
  set("max_jing", 500 + random(500));
  set("max_qi", 500 + random(500));
  set("dex", 30);
  set("str", 20);
  set("age", 5);
  set("shen_type", -1);
  set("combat_exp", 300000);
  set_temp("apply/attack", 50);
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 50);
  set_temp("apply/defence", 50);
  set("bonus", 100);
  setup();
}
