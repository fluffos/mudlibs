// migong lev5

#include <ansi.h>

inherit NPC;


void create()

{

  set_name(HIY "毒金雕" NOR, ({ "jin diao", "diao" }));
  set("race", "野兽");
  set("long",
    "一只长着金色羽毛的大雕。
。\n");
  set("attitude", "aggressive");
  set("vendetta/authority", 1);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("max_qi", 39000 + random(2000));
  set("max_jing", 39000 + random(2000));
  set("max_qi", 39000 + random(2000));
  set("max_mana", 39000 + random(2000));

  set("dex", 100);
  set("str", 100);
  set("no_get", 1);
  set("age", 15);

  set("shen_type", -1);

  set("intellgent", 1);

  set("pursuer", 1);

  set("combat_exp", 5000000);

  set_temp("apply/attack", 200);
  set_temp("apply/damage", 500);
  set_temp("apply/armor", 500);
  set_temp("apply/defence", 200);

  setup();


  carry_object("/d/migong/obj/tao");


}


void init() {
  object ob;
  remove_call_out("hunting");
  if (interactive(ob = this_player())) {
    ob->start_busy(3);
    call_out("hunting", 0);
  }
  if (!environment()->query("no_fight"))
    call_out("hunting", 0);
}



void unconcious() {
  die();
}

void die() {
  object ob, me;
  ob = this_object();
  me = this_player();
  if (!me->query("migong/lev5")) {
    me->add("potential", 10000);
    me->add("combat_exp", 10000);
    me->set("migong/lev5", 1);
    message(
      "channel:chat",
      HIM "【江湖谣言】听说" + me->query("name") + "完成了迷宫第五层,并获得了数万经验和潜能!" NOR "\n",
      users()
    );
  }
  destruct(ob);
}


int hit_ob(object me, object ob, int damage) {
  if (ob) {
    ob->apply_condition("wugong_poison", 40);
    ob->apply_condition("chanchu_poison", 40);
    ob->apply_condition("xiezi_poison", 40);
    ob->apply_condition("snake_poison", 40);
    ob->apply_condition("zhizhu_poison", 40);
    tell_object(ob, HIG "你觉得被咬中的地方一阵麻痒！\n" NOR);
  }
}
