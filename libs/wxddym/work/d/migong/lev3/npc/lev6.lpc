// migong lev3

#include <ansi.h>

inherit BOSS;


void create()

{

  set_name("巨猿", ({ "ju yuan", "yuan" }));

  set("race", "野兽");
  set("long",
    "双臂直垂到地，身型巨大的猿猴
。\n");
  set("attitude", "aggressive");
  set("vendetta/authority", 1);

  set("limbs", ({ "头部", "身体", "前抓", "后抓" }));
  set("verbs", ({ "bite", "claw" }));
  set("max_qi", 3500 + random(1000));
  set("max_jing", 3500 + random(1000));
  set("max_qi", 3500 + random(100));
  set("max_mana", 3500 + random(1000));

  set("dex", 50);
  set("str", 40);

  set("age", 5);
  set("bonus", 100 + random(100));
  set("shen_type", -1);

  set("intellgent", 1);

  set("pursuer", 1);

  set("combat_exp", 1200000);

  set_temp("apply/attack", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 100);
  set_temp("apply/defence", 100);

  setup();



}
