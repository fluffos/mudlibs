// migong lev4

#include <ansi.h>

inherit BOSS;


void create()

{

   set_name(MAG"千足蜈蚣"NOR, ({ "wu gong" , "wu" }));

          set("race", "野兽");
       set("long",
"一条长三尺，浑身发紫的大蜈蚣。
。\n");
              set("attitude", "aggressive");
                set("vendetta/authority",1);

set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
	       set("max_qi",3500+random(1000));
  set("max_jing",3500+random(1000));
  set("max_sen",3500+random(1000));
  set("max_mana",3500+random(1000));

      set("dex",50);
     set("str" ,65);

    set("age", 5);
        set("bonus", 100 + random(100));
       set("shen_type", -1);

        set("intellgent",1);

	set("pursuer",1);

        set("combat_exp", 1600000);

        set_temp("apply/attack", 100);
        set_temp("apply/damage", 100);
        set_temp("apply/armor", 100);
        set_temp("apply/defence",100);
     set("chat_chance", 30);
        set("chat_msg", ({
		(: command("get silver") :),
		(: command("get gold") :),
		(: command("get coin") :),
                (: random_move :),
           }) );
   setup();



}
