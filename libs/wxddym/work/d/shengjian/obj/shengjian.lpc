// dadao.c

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("圣剑", ({ "sword","sword" }));
	set_weight(7000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄寒光闪闪的宝剑。\n");
		set("value", 2000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声从背后拨出$n。\n");
		set("unwield_msg", "$N将手中的$n插回背后。\n");
	}
	init_sword(400);
	setup();
}
