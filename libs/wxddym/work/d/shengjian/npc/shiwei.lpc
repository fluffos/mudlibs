#include <ansi.h>
inherit NPC;
int do_look(string var);
void create() {
  set_name(HIW "圣剑魔宫锦衣侍卫" NOR, ({ "shiwei", "shi", "wei" }));
  set("nickname", HIR "铁面无私" NOR);
  set("gender", "男性");
  set("age", 22);
  set("long", "这是个富有正义感的守卫，武功看起来极为可怕。\n");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 2300);
  set("int", 2300);
  set("con", 2200);
  set("dex", 2000);
  set("max_kee", 40000);
  set("max_gin", 30000);
  set("sen", 30000000);
  set("force", 2000000);
  set("max_force", 2000000);
  set("combat_exp", 900000000 + random(1000));
  set_skill("sword", 4000);
  set_skill("force", 4000);
  set_skill("parry", 4000);
  set_skill("literate", 4000);
  set_skill("dodge", 4000);
  set("max_neili", 20000);
  set("neili", 15000000);
  set("max_jingli", 5000000);
  set("max_jingli", 20000);
  set("jingli", 4000000);
  set("max_jing", 5000000);
  set("max_qi", 10000000);
  set("shen", 300000000);
  set("jiali", 5000000);
  set_skill("lonely-sword", 4000);
  set_skill("tianmo-shenfa", 4000);
  set_skill("zhentian-quan", 4000);
  set_skill("unarmed", 4000);
  map_skill("dodge", "tianmo-shenfa");
  map_skill("unarmed", "zhentian-quan");
  map_skill("sword", "lonely-sword");
  map_skill("parry", "lonely-sword");
  setup();
  add_money("silver", 20);
  carry_object("/d/shengjian/obj/shengjian")->wield();
  carry_object("/d/shengjian/obj/moyi")->wear();
}
void init() {
  ::init();
  add_action("do_look", "kill");
  add_action("do_look", "hit");
  add_action("do_look", "fight");
  add_action("do_look", "touxi");
}

int do_look(string target) {
  object me;

  me = this_player();
  if (!living(this_object())) return 0;
  if (target == "shiwei" || target == "shi" || target == "wei")
    if ((string)me->query("shen") < 0) {
      message_vision(HIY "$N大怒，指着$n喝道：圣剑魔宫岂容尔等邪恶之徒撒野！\n" NOR, this_object(), this_player());
      kill_ob(this_player());
    }
  return 0;
}
