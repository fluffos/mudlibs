
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();

int auto_perform();

void create()
{
        set_name("魔长老", ({ "mo zhanglao", "mo","zhanglao" }));
        set("long", 
                "他就是圣剑魔宫的首席魔长老。\n"
                "只见他身穿一件不明材料做成的长袍。看上去已年过五十，鬓边微见花白，\n"
                "但双目不时闪过一丝寒光，让人无法轻视。\n");
                 
        set("gender", "男性");
        set("age", 55);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 2300);
	set("int", 2300);
	set("con", 2200);
	set("dex", 2000);
	set("max_kee", 40000);
	set("max_gin", 30000);
	set("sen", 30000000);
	set("force", 2000000);
	set("max_force", 2000000);
	set("combat_exp", 200000000+random(1000));
	set_skill("sword", 1000);	
	set_skill("force", 1000);	
        set_skill("parry", 1000);	
        set_skill("literate", 1000);	
        set_skill("dodge", 1000);	
        set("max_neili",20000);  	
        set("neili",15000000);  	
        set("max_jingli",5000000);  	
        set("max_jingli",20000);  	
        set("jingli",4000000);  	
        set("max_jing",5000000);  	
        set("max_qi",10000000);  	
        set("shen",300000000);
        set("jiali",5000000);
        set_skill("lonely-sword", 1000);	
        set_skill("shengjian-xinfa", 1000);	
        set_skill("tianmo-shenfa", 1000);        	
        set_skill("zhentian-quan", 1000);            	
        set_skill("unarmed", 1000);            	
        map_skill("dodge", "tianmo-shenfa");     	
        map_skill("unarmed", "zhentian-quan");         	
        map_skill("sword", "lonely-sword");	
        map_skill("parry", "lonely-sword");  	
         map_skill("force", "shengjian-xinfa");  		
	
        create_family("圣剑山庄", 2, "传人");	
        
        set("chat_chance_combat", 300);	
        set("chat_msg_combat", ({
       (: perform_action, "sword.jiushi" :),	
       (: perform_action, "sword.zongjue" :),	
       (: perform_action, "sword.pozhao" :),  	
         (: perform_action, "sword.pojian" :),	
        (: perform_action, "sword.podao" :),	
         (: perform_action, "sword.pobian" :),	
        (: perform_action, "sword.poqi" :),	
        (: perform_action, "sword.pozhang" :),	
        }) );
                 setup();
         add_money("silver",20);
	carry_object("/d/shengjian/obj/shengjian")->wield();
	carry_object("/d/shengjian/obj/moyi")->wear();
       

}
void init()
{
        ::init();
        add_action("do_look","kill");
        add_action("do_look","hit");
        add_action("do_look","fight");
        add_action("do_look","touxi");
}
 
int do_look(string target)
{
        object me;
 
        me = this_player();
       if (!living(this_object())) return 0;
       if (target=="shiwei" || target=="shi" || target=="wei" ) 
           if ((string)me->query("shen") < 0) {
           message_vision( HIY "$N大怒，指着$n喝道：圣剑魔宫岂容尔等邪恶之徒撒野！\n" NOR,this_object(),this_player());
                   kill_ob(this_player());
           }
    return 0;
}

void attempt_apprentice(object ob)	
{
if((int)ob->query("shen",1) < 50000000)               	
{
command("say 我们圣剑山庄的剑法只传侠义人士，你在德行方面还做得不够吧。");	
return 0;	
}
command("say 好吧，我就破例收下你了，以后要多多行侠仗义。");	
command("chat 我们的绝世剑法终有传人了，希望你勤加苦练,早日学得祖师爷阿飞的绝世剑法。哈哈.....\n");	
command("recruit " + ob->query("id"));	
ob->set("title",HIR"圣剑山庄门人"NOR);                  	
}
