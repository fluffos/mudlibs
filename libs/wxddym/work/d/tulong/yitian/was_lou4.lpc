inherit ROOM;
void create()
{
	object item, con;

	set("short", "万安寺四楼大厅");
      set("no_magic", 1);
	set("sword_count", 1);
	set("long","
这里是万安寺四楼的大厅，相当的宽敞。一个明艳少女正座中堂，少女前
方有一块巨大的红木制武器架"ZJURL("cmds:pull sword")+ZJSIZE(18)+HIY"拔剑"NOR"，左右站满了亲兵，排场很是气派。");
	set("exits", ([ 
		"down" : __DIR__"was_lou3",
	]));
	set("objects", ([
		"/d/tulong/yitian/npc/ada" : 1,
		"/d/tulong/yitian/npc/aer" : 1,
		"/d/tulong/yitian/npc/asan" : 1,
		"/d/tulong/yitian/npc/he" : 1,
		"/d/tulong/yitian/npc/zhao" : 1,
	]) );

	setup();
}

void init()
{
	add_action("do_pull", "pull");
}

int do_pull(string arg)
{
	object ob, me= this_player();

	if (arg != "sword")
		return notify_fail("你要拔什么？\n");

	if (query("sword_count") < 1)
		return notify_fail("剑好象已经被人拔走了。\n");

	if (me->query("neili") < 2000 ||
	    me->query_str() < 40)
	{
		message_vision("$N好奇心起，握住剑柄向外一拔，却是纹丝不动。\n", me);
		me->set("neili", 0);
		return 0;
	}

	ob = new("d/tulong/obj/yitianjian");
	ob->move(me);
		message_vision("$N紧紧握住剑柄，潜运内力，嗤"
			       "的一声响，拔了出来，只见剑刃"
			       "寒气逼人，断金如泥，锐不可当。\n", me);
	me->add("neili",-1500);
	add("sword_count", -1);
	return 1;
}
int valid_leave(object me, string dir)
{
if (dir == "down" && objectp(present("he taichong", environment(me))))
	   return notify_fail(CYN "何太冲道：还没比武，你想去哪！"NOR"\n");

if (dir == "down" && objectp(present("a er", environment(me))))
	   return notify_fail(CYN "阿三道：还没比武，你想去哪里！"NOR"\n");

if (dir == "down" && objectp(present("a san", environment(me))))
	   return notify_fail(CYN "阿二道：还没比武，你想去哪里！"NOR"\n");

if (dir == "down" && objectp(present("a da", environment(me))))
	   return notify_fail(CYN "阿大道：还没比武，你想去哪里！"NOR"\n");


if (dir == "down" && objectp(present("he biweng", environment(me))))
	   return notify_fail(CYN "鹤笔翁道：当我们老哥俩不存在！"NOR"\n");


if (dir == "down" && objectp(present("lu zhangke", environment(me))))
	   return notify_fail(CYN "鹿杖客道：当我们老哥俩不存在！"NOR"\n");

	return ::valid_leave(me, dir);
}

