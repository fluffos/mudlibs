#include <ansi.h>
inherit NPC;
void create() {
  set_name("剑僧", ({ "jian seng", "jian", "seng" }));
  set("long", "一个秃顶和尚，裸露着上身，肌肉结实。\n"
    "这便是汝阳王手下的十八金刚之一。\n");
  set("attitude", "heroism");
  set("title", "汝阳王座下十八金刚");
  set("nickname", HIW "五剑金刚" NOR);
  set("age", 30);
  set("shen_type", -1);

  set("str", 100 + random(100));
  set("int", 100 + random(100));
  set("con", 100 + random(100));
  set("dex", 100 + random(100));

  set("max_qi", 20000);
  set("max_jing", 8000);
  set("neili", 20000);
  set("max_neili", 20000);
  set("jiali", 800);

  set("combat_exp", 300000 + random(300000));
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "sword.bei" :),
    (: exert_function, "powerup" :),
  }));


  set_skill("force", 600 + random(200));
  set_skill("longxiang", 600 + random(200));
  set_skill("dodge", 600 + random(200));
  set_skill("shenkong-xing", 600 + random(200));
  set_skill("cuff", 600 + random(200));
  set_skill("yujiamu-quan", 600 + random(200));
  set_skill("sword", 600 + random(200));
  set_skill("mingwang-jian", 600 + random(200));
  set_skill("parry", 600 + random(200));
  set_skill("lamaism", 180);

  map_skill("force", "longxiang");
  map_skill("dodge", "shenkong-xing");
  map_skill("cuff", "yujiamu-quan");
  map_skill("parry", "mingwang-jian");
  map_skill("sword", "mingwang-jian");

  set_temp("apply/attack", 800 + random(500));
  set_temp("apply/defense", 800 + random(500));
  set_temp("apply/armor", 800 + random(500));
  set_temp("apply/damage", 800 + random(500));

  setup();

  carry_object("/d/beijing/npc/obj/jiasha")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

void init() {
  object ob;

  ::init();

  ob = this_player();

  command("yi");
  command("say 是谁那么大胆，居然敢在汝阳王眼皮下撒野！\n");
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, ob);
}
