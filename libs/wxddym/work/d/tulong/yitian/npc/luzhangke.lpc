#include <ansi.h>
inherit NPC;

void create()
{
	set_name("鹿杖客", ({ "lu zhangke", "lu", "zhangke" }));
	set("long", "一个六十多岁的老者，头发花白，满面红光，\n"
		    "身材魁梧高大，这便是汝阳王用重金聘请的\n"
		    "高手，玄冥二老中的鹿杖客，一双玄冥毒掌\n"
		    "使得出神入化，武艺超群，很得汝阳王的赏\n"
		    "识。\n");
	set("title", MAG "玄冥二老" NOR);
	set("gender", "男性");
	set("age", 68);
	set("attitude", "peaceful");
	set("shen_type", -1);

	set("per", 100+random(500));
	set("str", 100+random(500));
	set("int", 100+random(500));
	set("con", 100+random(500));
	set("dex", 100+random(500));
	
	set("max_qi", 400000);
	set("max_jing", 20000);
	set("neili", 480000);
	set("max_neili", 48000);
	set("jiali", 1500);
	set("combat_exp", 1800000);

	set("chat_chance_combat", 100);
	set("chat_msg_combat", ({
		(: perform_action, "strike.wuji" :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}) );

	set_skill("literate", 600+random(600));
	set_skill("force", 600+random(600));
	set_skill("dodge", 600+random(600));
	set_skill("unarmed", 600+random(600));
	set_skill("parry", 600+random(600));
	set_skill("strike", 600+random(600));
	set_skill("lingxu-bu", 600+random(600));
	set_skill("xuanming-zhang", 600+random(600));
	set_skill("xuanming-shengong", 600+random(600));

	map_skill("dodge", "lingxu-bu");
	map_skill("force", "xuanming-shengong");
	map_skill("strike", "xuanming-zhang");
	map_skill("parry", "xuanming-zhang");

	prepare_skill("strike", "xuanming-zhang");

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}
