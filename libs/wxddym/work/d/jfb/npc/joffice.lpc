#include <ansi.h>
inherit NPC;

#define J_SYS "/d/jfb/sys/j_sys"

int ask_job();

void create() {

  set_name(HIW "士兵" NOR, ({ "shi bing", "shi" }));
  set("title", HIW "失魂的" NOR);

  set("gender", "男性");
  set("age", 26);
  set("long", "他是一位年纪很轻的小伙，他是为一从心魔手中逃走的人。\n");

  set("inquiry", ([
    "挑战心魔": (: ask_job :),
  ]));

  setup();
  //carry_object("/clone/misc/changpao")->wear();
}

int ask_job() {
  object me;
  object *team, jmem;
  int i, size;

  me = this_player();
  if (!me->is_team_leader()) {
    tell_object(me, "你不是领队。\n");
    return 1;
  }
  team = me->query_team();
  size = sizeof(team);
  if (!pointerp(team) || size < 2) {
    tell_object(me, "你的人手不够。\n");
    return 1;
  }
  for (i = 0; i < size; i++) {
    if (!team[i]) continue;
    /*if (team[i]->query("jym_level/level") <= 0)
                {
                	tell_object(me, HIG"呵呵～,你们队伍里面还有ID为没到1级，以后再说来吧！"NOR);
                 	return 1;
                }*/
    if (team[i]->query("jym_level/level") >= 60) {
      tell_object(me, HIY "呵呵～,50还来这里做什么!!留给小朋友去玩好了!!!!!!" NOR);
      return 1;
    }
  }
  if (J_SYS->query_room_amount() >= 20) {
    tell_object(me, "镜像已经开启太多，欢迎下次参与。\n");
    return 1;
  }
  //删除旧的副本
  jmem = me->query_temp("room/jfb_jmem");
  if (objectp(jmem)) {
    jmem->delete("user_id");
  }
  //创建新的副本
  J_SYS->jfb(team, me);
  return 1;
}
