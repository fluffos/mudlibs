
inherit NPC;
void create()
{
    set_name("杀手", ({"killer"}));
    set("long",
    "这是杀手，见人就杀，心狠手辣。\n"
    );
    set("gender", "男性");
    set("age", 20+random(30));
    set("qi", 10);
    set("max_qi", 10);
    set("jing", 500);
    set("max_jing", 500);
    set("neili", 500);
    set("max_neili", 500);
    setup();
}

