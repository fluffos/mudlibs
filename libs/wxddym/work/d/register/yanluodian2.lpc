// /d/cxwxm/shandong.c
// marry 99.8
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "奈何桥");
  set("long", @LONG
一直走。
LONG
  );

  set("exits", ([
    "north": __FILE__,
    "south": __FILE__,
  ]));
  setup();
}

void init() {
  object me;
  int jing, jing_cost;

  me = this_player();

  if (jing < jing_cost)
    me->unconcious();
  me->add("jing", -jing_cost);

  if (me->query("zhuanshi") < 0) {

    message_vision(WHT "$N转世了，就不要在点了。\n" NOR, me);
    me->move("/d/city/kedian");
    me->unconcious();
    return;
  }
  if ((me->query("zhuanshi") > 1) || (!me->query_temp("zhuanshi"))) {
    message_vision(WHT "$N你进入了转生殿。\n" NOR, me);
    me->move("/d/register/yanluodian3");
    me->set("zhuanshi", -1);
    me->set("chulu", 0);
    if (userp(me))
      return;
  }
}
