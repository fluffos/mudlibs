#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "月饼" NOR, ({ "yue bing", "bing"}) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "中秋月饼。\n");
                set("value", 10000);
		set("unit", "块");
		set("no_drop",1);
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N一口吞下了" + this_object()->name() +
                       "。\n", me);
                me->add("max_jingli", -1000);
                me->add("xy_yuanbao", 8888);
                 write("\n "+HIR+"恭喜你：吃下中秋月饼，"+NOR+HIG+"感觉有什么增加了！！！ "+NOR);
        destruct(this_object());
	return 1;
}
