#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "唐僧肉" NOR, ({ "tangseng rou", "rou"}) );
	set_weight(200);
      set("suit_point", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "传说中的唐僧肉，看起来很好吃的样子。\n");
                set("value", 10000);
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N张开血盆大口，一口吞下了" + this_object()->name() +
                       "。\n", me);
        if (me->query("combat_exp") < 500)
        {
                message_vision("$N眨眨眼。\n", me);
                tell_object(me, "你觉得这肉没啥味道，还不如花生好吃。\n");
        return 0;
        } 
        if (me->query("combat_exp") > 5000)
        {
                me->add("max_jing", 100);
                me->add("max_neili", 100);
                me->add("food", 1000);
                me->add("water", 1000);





                 write("\n "+HIR+"恭喜你："+NOR+HIG+"实力大增的提升！！！ "+NOR);
        }else
        {
                tell_object(me, "不过你觉得好像没什么作用。\n");
        }
        destruct(this_object());
	return 1;
}
