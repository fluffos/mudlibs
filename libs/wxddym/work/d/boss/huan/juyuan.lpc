#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "回元丹" NOR, ({ "huiyuan"}) );
	set_weight(200);
      set("suit_point", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "看起来很好吃的样子，提高大量内力。\n");
                set("value", 10000);
				set("no_sell","不能卖");
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N张开嘴一口吞下了" + this_object()->name() +
                       "。\n", me);
        if (me->query("combat_exp") > 500000)
        {
            message_vision("$N眨眨眼。\n", me);
			me->start_busy(5);

            tell_object(me, "你实力太高了，自己努力吧。\n");
        return 0;
        }
        if (me->query("neili") < 200)
        {

            me->add("neili", 3000);
            write("\n "+HIR+"内气澎湃！！！ "+NOR);

			me->start_busy(5);

        return 0;

        }else
        {
                tell_object(me, "内气还没消耗完不需要吃这些。\n");
        }
       // destruct(this_object());
	return 1;
}
