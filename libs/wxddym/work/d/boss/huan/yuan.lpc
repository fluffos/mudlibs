#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "元丹" NOR, ({ "yuan"}) );
	set_weight(200);
      set("suit_point", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "看起来很好吃的样子，提高大量内力。\n");
                set("value", 10000);
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N张开血盆大口，一口吞下了" + this_object()->name() +
                       "。\n", me);
        if (me->query("combat_exp") > 500000)
        {
                message_vision("$N眨眨眼。\n", me);


                tell_object(me, "你实力太高了，自己努力吧。\n");
        return 0;
        }

        if (time() - me->query_temp("last_eat/dan(D)") < 30)
        {
                write("吃得这么急，你也不怕咽着，等一会吧。\n");
                return 1;
        }


        if (me->query("neili") < 3000)
        {

            me->add("neili", 3000);
			me->set_temp("last_eat/dan(D)", time());

            write("\n "+HIR+"内气澎湃！！！ "+NOR);

return 0;
        }else
        {
                tell_object(me, "内气充盈不需要吃这些。\n");
        }
        destruct(this_object());
	return 1;
}
