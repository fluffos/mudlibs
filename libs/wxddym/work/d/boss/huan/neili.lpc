#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "龙元仙丹" NOR, ({ "qiqi"}) );
	set_weight(200);
      set("suit_point", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "七七专用\n");
                set("value", 10000);
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
		me=this_player();
        message_vision("$N优雅地吃下了这颗终极回内力的仙丹。\n", me);

        if (me->query("neili") < 5000)
        {

            me->add("neili", 5000);
			
            write("\n "+HIR+"内气澎湃！！！ "+NOR);

        return 0;

        }else
        {
                tell_object(me, "内气充盈不需要吃这些。\n");
        }

	return 1;
}
