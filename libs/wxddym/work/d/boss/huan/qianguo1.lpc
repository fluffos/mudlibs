#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "潜力果实小" NOR, ({ "qianguo1" }));
  set_weight(200);
  set("suit_point", 50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "看起来很好吃的样子。\n");
    set("value", 10000);
    set("no_drop", 1);
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N张开血盆大口，一口吞下了" + this_object()->name() +
    "。\n", me);
  if (me->query("combat_exp") < 500) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "你觉得这肉没啥味道，还不如花生好吃。\n");
    return 0;
  }
  if (me->query("combat_exp") > 500000) {
    me->add("combat_exp", 500);
    me->add("potential", 2000);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "潜能的到提升！！！ " + NOR);
  } else {
    tell_object(me, "不过你觉得好像没什么作用。\n");
  }
  destruct(this_object());
  return 1;
}
