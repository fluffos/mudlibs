#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "梅庄大门");
  set("long", @LONG
走过一大片梅林，走上一条青石板大路，来到一座朱门白墙的大
庄院外，行到近处，见大门外写着『梅庄』两个大字，旁边署着『虞
允文题』四字。那虞允文是南宋破金的大功臣，这几个字儒雅之中透
着勃勃英气。
LONG);
  set("outdoors", "meizhuang");
  set("exits", ([
    "north": __DIR__ "tianjing",
    "south": __DIR__ "xiaolu",
  ]));

  set("no_clean_up", 0);
  setup();
}
