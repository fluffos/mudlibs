#include <ansi.h>
inherit NPC;

void create()
{
        set_name("慕容死神",({ "murong","shishen" }) );
        set("title",HIY"太监一名"NOR);
        set("gender", "无性" );
        set("age", 33);
        set("long",
"杀了他，有几率掉野球拳。\n");

        set("int", 50);
        set("str", 55);
        set("con", 55);
        set("dex", 55);
        set("attitude", "aggressive");
        set("shen_type", -1);

        set("qi", 50000);
        set("max_qi", 50000);
        set("jing", 100000);
        set("max_jing", 80000);
        set("neili", 80000);
        set("max_neili", 10000);
        set("jiali", 20);
        set("combat_exp", 5000000);
        set("score", 15000);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 60);
        set_temp("apply/damage", 40);

        set_skill("unarmed",300 );
        set_skill("force", 300 );
        set_skill("dodge", 300 );
        set_skill("parry", 300 );
        set_skill("sword", 300 );
        set_skill("staff", 300 );
        set_skill("literate", 300 );
        set_skill("pixie-jian", 300 );

        map_skill("force", "pixie-jian");
        map_skill("unarmed", "pixie-jian");
        map_skill("dodge", "pixie-jian");
        map_skill("parry", "pixie-jian");
        map_skill("sword", "pixie-jian");
		set_temp("apply/damage",100);
        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("perform sword.pi") :),
                (: command("perform sword.po") :),
                (: command("perform sword.kuihua") :),
                (: command("exert shield") :),
                (: command("exert powerup") :),
        }) );

        setup();
         carry_object("/clone/weapon/gangjian")->wield();

}


void die()
{
	object me,ob,jmem,item;
	mapping team;
	int i,size,level,exp,rand,pot;
	string file;

	ob = this_object();
	me = ob->query_temp("last_damage_from");

        rand = random(100);
	if(rand >= 10)
	{
		item = new("/clone/money/silver");
		if(item)
		{
			item->set_amount(10);
			item->move(environment(ob));
		}
	}

        else if(rand < 10)
	{
				item = new("/clone/lonely/yeqiuquan");
		if(item)
		{
			item->move(environment(ob));
		}
    }

	destruct(ob);
}

