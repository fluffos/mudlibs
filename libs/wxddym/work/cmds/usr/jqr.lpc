// derive.c

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

varargs int deriving(object me);
int halt_deriving(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string pts;
  if (!arg || (arg != "yjkj" && arg != "eat dan" && !sscanf(arg, "%d", pts)))
    return notify_fail(INPUTTXT(
      "目前仅支持单指令，请输入你想要执行的自动指令",
      "set jiqirenzhiling $txt#"
    ) + "\n" + ZJOBACTS2 + ZJMENUF(
      3,
      3,
      8,
      30
    ) + "华山石桌:set jiqirenzhiling study table\n" /*ZJSEP"吃丹:set jiqirenzhiling eat dan\n"*/);
  tell_object(me, ZJFORCECMD("set jiqirenzhiling " + arg));
  return 1;
}
