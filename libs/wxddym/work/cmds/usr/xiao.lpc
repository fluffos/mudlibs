// derive.c

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

varargs int deriving(object me);
int halt_deriving(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string pts;
  return notify_fail(INPUTTXT(
    ZJBR "你想押注多少钱到小上，" NOR "目前只支持金子下注",
    "gamble small money gold" + " $txt#"
  ) + "\n");
}
