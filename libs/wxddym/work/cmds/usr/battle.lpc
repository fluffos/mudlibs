                      HIC "【内力上限】" HIM " %9d / %-9d\n"
                      HIC "【精力上限】" HIM " %9d / %d\n"
                      HIC "【气血上限】" HIM " %9d / %-9d\n"
                      HIC "【精气上限】" HIM " %9d / %d\n",
                      jingmai_effect(ob, "pot")+ob->query_temp("apply/max_potential"),10000000,
                      jingmai_effect(ob, "mar")+ob->query_temp("apply/max_experience"),10000000,
                      jingmai_effect(ob, "neili")+ob->query_temp("apply/max_neili"),1000000,
                      jingmai_effect(ob, "jingli")+ob->query_temp("apply/max_jingli"),5000000,
                      jingmai_effect(ob, "qi")+ob->query_temp("apply/max_qi"),1000000,
                      jingmai_effect(ob, "jing")+ob->query_temp("apply/max_jing"),500000);

        sp += sprintf(HIC "【研究次数】" HIY " %9d / %-9d\n"
                      HIC "【研究效果】" HIY " %9s / %s\n"
                      HIC "【练习次数】" HIY " %9d / %-9d\n"
                      HIC "【练习效果】" HIY " %9s / %s\n"
