// time.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) {
    write(ZJOBLONG "请选择类型：\n"
      ZJOBACTS2 + ZJMENUF(
        3,
        3,
        8,
        30
      ) + "天魂介绍:help tianhun" ZJSEP "提升天魂:uplv -l" ZJSEP "角色天赋:uplv -t" ZJSEP "放弃经验:abandon exp\n");
  } else if (arg == "-l")
    F_LEVEL->improve_level(me);
  else if (arg == "-t")
    F_LEVEL->up_tianfu(me);
  else if (arg == "-s")
    F_LEVEL->up_skills(me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: uplv [-s]

这个指令让你消耗经验提升等级。

HELP
  );
  return 1;
}
