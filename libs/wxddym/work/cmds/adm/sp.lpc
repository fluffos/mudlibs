// sp.c

#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	mapping site;
	string item, desc;
	string msg;
	write(ZJBTSET"b16:更新"ZJBR"查看:zjmenu ofen"ZJSEP"b17:常用"ZJBR"命令:zjmenu ofen\n");
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: sp <class> <info>

授权给本地站点某些方面的使用权限。info 如果为空或是 clear 则
表示取消这类的使用权限。
HELP );
	return 1;
}
