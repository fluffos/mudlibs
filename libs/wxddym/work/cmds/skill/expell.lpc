/*
技能分类快捷激发显示指令
简单型第一个版本 
笑世作于
2018.7.5
7.7第二次调整：添加等级显示和颜色显示,缩进代码
*/

#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }
string *s1 = ({
	"force",//基本内功
	"dodge",//基本轻功
	"unarmed",//基本拳脚
	"cuff",//基本拳法
	"strike",//基本掌法
	"finger",//基本指法
	"hand",//基本手法
	"claw",//基本爪法
	"sword",//基本剑法
	"blade",//基本刀法
	"staff",//基本丈法
	"hammer",//基本锤法
	"club",//基本棍法
	"whip",//基本鞭法
	"dagger",//基本短兵
	"throwing",//基本暗器
	"parry",//基本招架
	"knowledge",//知识类技能
	"basic",//其他基本武功综合
});
string *s2 = ({
	CYN"基本内功"NOR,//基本内功
CYN	"基本轻功"NOR,//基本轻功
CYN	"基本拳脚"NOR,//基本拳脚
CYN	"基本拳法"NOR,//基本拳法
CYN	"基本掌法"NOR,//基本掌法
CYN	"基本指法"NOR,//基本指法
CYN	"基本手法"NOR,//基本手法
CYN	"基本爪法"NOR,//基本爪法
CYN	"基本剑法"NOR,//基本剑法
CYN	"基本刀法"NOR,//基本刀法
CYN	"基本杖法"NOR,//基本丈法
CYN	"基本锤法"NOR,//基本锤法
CYN	"基本棍法"NOR,//基本棍法
CYN	"基本鞭法"NOR,//基本鞭法
CYN	"基本短兵"NOR,//基本短兵
CYN	"基本暗器"NOR,//基本暗器
CYN	"基本招架"NOR,//基本招架
YEL"知识类技能"NOR,//知识类技能
	"全部类型",//基本武功以及其他
	});
int main(object me,string arg)
{
string sks;
int i,j,is,js;
string *s3,*s4,cs,sa,str;
s4 = ({ });//空数组
s3 = keys(me->query_skills());//传回玩家的全部技能
		str=ZJOBACTS2+ZJMENUF(2,2,10,25);
if (!arg)//当没有参数进入主函数时，调用选择界面
{
for (i=0;i <sizeof(s2);i++)
{
sa =  s2[i];
if (me->query_skill(s1[i],1))
sa +="—>"+me->query_skill(s1[i],1)+"级"+NOR;
str += sa+":expell "+ s1[i]+ZJSEP;//指令主函数参数循环，用来识别和选择技能种类
}	
str =ZJOBLONG+HIC"请你选择基本类型\n"+str;
}
else//参数导入，技能分类开始
{
		for (i = 0; i < sizeof(s2); i++)//选择基本分类
		{
		if (arg==s1[i])
		{
		for (is = 0; is < sizeof(s3); is++)//选择符合这个基本类型的特殊武功
		{
		cs = s3[is];
			sa = to_chinese(s3[is]);
		sa+="—>"+me->query_skill(s3[is],1)+"级"NOR;			
if (SKILL_D(s3[is])->valid_enable(s1[i]))	//识别类型
str += sa+":skills -f "+ cs +ZJSEP; 
else
 if (SKILL_D(s3[is])->type()=="knowledge"&&s1[i]=="knowledge")//知识类技能分开导入
str += sa+":skills -f "+ cs +ZJSEP;		
		}
		break;				//跳出循环
		}		
		}
		str += HIY"返回全部"NOR":expell"ZJSEP+"\n";
	str =ZJOBLONG"请你选择激发类型\n"+str;
		}
	write(str+"\n");
	return 1;
}