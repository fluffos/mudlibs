// pique.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int pts;
    int max;
	pts = 0;
	if( !arg || (arg!="none" && arg!="max" && !sscanf(arg, "%d", pts)) )
		return notify_fail(INPUTTXT("你要用多少点愤怒？","pique $txt#")+"\n"
					ZJOBACTS2+ZJMENUF(3,3,8,30)+"最大:pique max"ZJSEP"取消加力:pique none\n");

	//max = me->query_max_craze() / 100;
	
// 愤怒之心增加加怒上限
if( me->query("special_skill/wrath") )
max = me->query_max_craze() / 70;
else
max = me->query_max_craze() / 100;
	
if( arg=="none" )
	{
		me->delete("jianu");
		write("Ok，你现在取消了附加愤怒伤敌。\n");
	}
	else if( arg=="max" )
	{
		if( (pts=max)<=0 )
			return notify_fail("你没有怒气。\n");
		me->set("jianu", pts);
		write("Ok，你现在使用"+pts+"附加点愤怒伤敌。\n");
	}
	else {
		if( pts < 0 || pts > max )
			return notify_fail("你只能用 none 表示不运愤怒，或数字表示每一击用几点愤怒。\n");
		me->set("jianu", pts);
		write("Ok，你现在使用"+arg+"附加点愤怒伤敌。\n");
	}
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: pique|jianu <使出几点愤怒伤敌>|none
 
这个指令让你指定每次击中敌人时，要发出几点愤怒以伤害对方。如
果使用了愤怒伤敌，则在攻击中还有一定的几率可以使出愤怒必杀技
暴怒招式。

pique none 则表示你不使用愤怒。

HELP );
	return 1;
}
