// exercise.c
#pragma save_binary
#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;
int exercising(object me);
int halt_exercise(object me);

int main(object me, string arg)
{

	int exercise_cost;
	mapping map_temp;
	object where;
	seteuid(getuid());
	where = environment(me);
	map_temp = me->query_skill_map();
	if ((int)me->query_skill("spells",1)<10)
		return notify_fail("你还是先学些修道的技巧！\n");
	if (sizeof(map_temp)!=0)
	{
		if(undefinedp(map_temp["spells"]))
		{
			return notify_fail("你需要先装备(enable)道术心法吧！！！\n");
		}
		else if((int)me->query_skill(map_temp["spells"])<10)
		{
			return notify_fail("你装备的道术心法级别太低了！！！\n");
		}
	}
	else
	{
	     return notify_fail("你需要先装备(enable)道术心法吧！！！\n");
	}
	if (where->query("pigging"))
		return notify_fail("你还是专心拱猪吧！\n");    

	if (me->is_busy() || me->query_temp("pending/exercising"))
		return notify_fail("你现在正忙着呢。\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");

	if( me->is_fighting() )
		return notify_fail("战斗中不能练心法，会走火入魔。\n");

	if( !arg || !sscanf(arg, "%d", exercise_cost))
	{
		me->set_temp("pending/auto_wudao",1);
		exercise_cost = me->query("max_mana")/20;
		if (exercise_cost > me->query("max_neili") / 20) exercise_cost = me->query("max_neili") / 20;
		if (exercise_cost < 20 ) exercise_cost = 20;
	}
	if (exercise_cost < 20)
		return notify_fail("你的心法还没有达到那个境界！\n");
	if( (int)me->query("max_neili") < exercise_cost )
		return notify_fail("你现在的内力太少了，无法产生内息运行全身经脉。\n");
	if( (int)me->query("jing") * 100 / (int)me->query("max_jing") < 60 )
		return notify_fail("你现在精不够，无法控制内息的流动！\n");
	write(HIR"你坐下来开始运行 "+HIY"【"+to_chinese(map_temp["spells"])+"】"+NOR+HIR" 神功！\n"+NOR+"一股"+HIW"内息("+exercise_cost+")"+HIR"开始在体内流动......"+NOR+"\n");
	me->set_temp("pending/exercise", 1);
	me->set_temp("exercise_cost", exercise_cost);
	message("vision",me->name()+"盘膝坐下，开始修炼法力。\n",environment(me),({me}));
	tell_object(me,ZJEXIT"northwest:"RED"站起来"NOR":halt\n");
	me->set_temp("wudao/step", 1);
	me->start_busy(bind((: call_other, __FILE__, "exercising" :), me),
		       bind((: call_other, __FILE__, "halt_exercise" :), me));
	return 1;
}

void auto_wudao(object me, int exercise_cost)
{
	if(!me->query_temp("pending/auto_wudao"))
		return;
	if(me->is_busy())
		call_out("auto_wudao",1,me,exercise_cost);
	else if( (int)me->query("max_neili") < exercise_cost )
	{
		tell_object(me,"内力不足，休息中。。。\n");
		tell_object(me,ZJFORCECMD("exert recover"));
		call_out("auto_wudao",1,me,exercise_cost);
	}
	else
	{
		tell_object(me,"托管中，继续打坐。。。。。。\n");
		tell_object(me,ZJFORCECMD("wudao "+exercise_cost));
	}
}

int exercising(object me)
{
	int finish;
	int neili_temp,skill_temp_point;
	int exercise_cost = (int)me->query_temp("exercise_cost");
	mapping map_temp;
	object where=environment(me);
	map_temp = me->query_skill_map();
      if (!interactive(me)) return 0;
	if (exercise_cost < 1)
		return 0;
	if (! me->query_temp("wudao/step"))
		me->set_temp("wudao/step", 1);

	if (! living(me))
	{
		me->set_temp("pending/exercise", 0);
		me->delete_temp("wudao/step");
		return 0;
	}
	finish = 0;

	switch (me->query_temp("wudao/step"))
      {
      case 1:
		write(YEL"你双手并拢，聚息汇丹田，一手盖天，一手铺地，渐收于丹，气海渐缚，周身通红，双手并合，迅下丹田，内息喷涌，顿封七窍，凝身以淬，丹田运转，源远流长，浩气长舒，呼气双摊真气息，丹田收气顿增生"+NOR"\n");
      	break;
      case 2:
		write(YEL"呼气双摊息真气，丹田平顿气增生"+NOR"\n");
      	break;
 	default:
		finish = 1;
		break;
	}

	if(!finish)
	{
		me->add_temp("wudao/step", 1);
		return 1;
	}
	neili_temp=((int)me->query_skill(map_temp["spells"]))/50+random(9)+exercise_cost;  //道术心法等级/50+随即系数+用内力=实际效果
	skill_temp_point=(random(8)+8)*5;
	if(where->query("xuanbing"))
 		me->add("neili", (int)exercise_cost/30);
	if(where->query("hanyuchuang"))
		me->add("neili", (int)exercise_cost/20);
	me->add("max_neili", -exercise_cost);
	me->set_temp("pending/exercise", 0);
	tell_object(me,HIY"你慢慢睁开眼睛，深深吸了口气，站了起来。\n"
			+HIW"你感觉心法又精进了：\n"
			+HIR"【法力】: "+HIG"+"+neili_temp+NOR+HIR	+"【"+to_chinese(map_temp["spells"])+"】:"+NOR+HIG"exp +"+skill_temp_point+NOR"\n");
	me->improve_skill(map_temp["spells"],skill_temp_point);
	me->add("mana", neili_temp);
	tell_object(me,ZJFORCECMD("exert recover"));
	if(me->query_temp("pending/auto_wudao"))
		call_out("auto_wudao",1,me,exercise_cost);
	if ((int)me->query("mana") < (int)me->query("max_mana") * 20)
		return 0;
	else
	{
		if ((int)me->query("max_mana") >= (int)me->query_current_neili_limit())
		{
			write("你的法力修为似乎已经达到了瓶颈。\n");
			me->set("mana", (int)me->query("max_mana"));
			return 0;
		}
		else
		{
			me->add("max_mana", 1);
			me->set("mana", (int)me->query("max_mana"));
			write(""WHT"﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎﹎"NOR"\n");
			write(HIR"恭喜:"+NOR+"你的"+HIG"【法力上限】"+NOR+"增加了！"NOR"\n");
			write(""WHT"﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊﹊"NOR"\n");
			return 0;
		}
	}
}
int halt_exercise(object me)
{
	if ((int)me->query("mana") > (int)me->query("max_mana") * 20)
		me->set("mana", (int)me->query("max_mana") * 20);
	me->delete_temp("wudao/step");
	me->set_temp("pending/exercise", 0);
	message_vision("$N将内息压回丹田，缓缓睁开了眼睛！\n", me);
	return 1;
}
int help(object me)
{
	write(@HELP
指令格式 : exercise [<耗费「气」的量> 必须多于 10]
运气练功，控制体内的气在各经脉间流动，藉以训练人体肌肉骨骼的耐
力、爆发力，并且用内力的形式将能量储备下来。
HELP
	);
	return 1;
}
