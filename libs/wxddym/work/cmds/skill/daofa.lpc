// exert.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string spells;
  int result;

  seteuid(getuid());

  if (me->is_busy())
    return notify_fail("( 你上一个动作还没有完成，不能施用道法。)\n");

  if (!arg)
    return notify_fail("你要用道法做什么？\n");

  if (stringp(spells = me->query_skill_mapped("spells"))) {
    notify_fail("你无法顺利的运转内息。\n");
    if (SKILL_D(spells)->do_effect(me)) {
      write(query_notify_fail());
      return 1;
    }

    notify_fail("你所学的道法中没有这种功能。\n");
    if (SKILL_D(spells)->daofa_function(me, arg)) {
      if (random(120) < (int)me->query_skill("spells"))
        me->improve_skill(spells, 1, 1);
      return 1;
    } else if (SKILL_D("spells")->daofa_function(me, arg)) {
      if (random(120) < (int)me->query_skill("spells", 1))
        me->improve_skill("spells", 1, 1);
      return 1;
    }
    return 0;
  }

  return notify_fail("你请先用 enable 指令选择你要使用的道法。\n");
}

int help(object me) {
  write(@HELP
指令格式：exert|yun <功能名称> [<施用对象>]

用内力进行一些特异功能，你必需要指定<功能名称>，<施用对象>则可有可无。
在你使用某一种道法的特异功能之前，你必须先用 enable 指令来指定你要使用
的道法。

请参考 help spells 可得知一些大部分道法都有的功能，至于你所用的道法到底
有没有该功能，试一试或参考其他说明便知。

注：如果你改变自己的道法，你原本蓄积的内力并不能直接转换过去，必须
    从０开始。

HELP);
  return 1;
}
