void ZJwrite(object me,string arg)
{
	if( me && userp(me) && living(me) && arg)
	{
		arg = ZJOBLONG+arg;
		arg = replace_string(arg,"\n",ZJBR);
		tell_object(me,arg+"\n");
	}
}

string skill_level(string type, int level)
{
    int grade;
    	string *skill_level_desc = ({
		BLU "初学乍练" NOR,HIB "粗通皮毛" NOR,YEL "初窥门径" NOR,HIY "略知一二" NOR,HIB "渐有所悟" NOR,
		YEL "半生不熟" NOR,YEL "马马虎虎" NOR,HIY "平淡无奇" NOR,HIY "触类旁通" NOR,HIM "已有小成" NOR,
		HIG "心领神会" NOR,HIC "驾轻就熟" NOR,RED "了然於胸" NOR,HIG "挥洒自如" NOR,HIC "出类拔萃" NOR,
		CYN "初入佳境" NOR,MAG "威不可当" NOR,MAG "出神入化" NOR,RED "登峰造极" NOR,HIM "一代宗师" NOR,
		HIM "独步天下" NOR,HIR "旷古绝伦" NOR,HIW "震古铄今" NOR,WHT "超凡入圣" NOR,HIW "深不可测" NOR
		HIW "返璞归真" NOR,
	});

	string *knowledge_level_desc = ({
		BLU "新学乍用" NOR,BLU "不甚了了" NOR,HIB "不知端倪" NOR,HIB "平淡无奇" NOR,YEL "司空见惯" NOR,
		YEL "初窥门径" NOR,HIY "略知一二" NOR,HIY "茅塞顿开" NOR,CYN "略识之无" NOR,CYN "滚瓜烂熟" NOR,
		MAG "马马虎虎" NOR,MAG "轻车熟路" NOR,HIW "运用自如" NOR,HIW "触类旁通" NOR,HIM "深入浅出" NOR,
		HIM "已有小成" NOR,HIM "心领神会" NOR,RED "了然於胸" NOR,RED "见多识广" NOR,HIR "无所不通" NOR,
		HIR "卓尔不群" NOR,HIR "满腹经纶" NOR,WHT "豁然贯通" NOR,WHT "博古通今" NOR,WHT "博大精深" NOR,
		WHT "超群绝伦" NOR,WHT "举世无双" NOR,WHT "独步天下" NOR,HIW "震古铄今" NOR,HIW "超凡入圣" NOR,
		HIW "深不可测" NOR
	});
    	if( level>=100 ) 
    	{
    		if( level<300) 
    			grade=(level-100)/20+10 ;
    		else	return  NOR "返璞归真" NOR;
    	}
    	else    grade = level / 10;
   	switch(type) 
    	{
		case "knowledge":
	    		if( grade >= sizeof(knowledge_level_desc) )
				grade = sizeof(knowledge_level_desc)-1;
	    		return knowledge_level_desc[grade];
	    		break;
		default:
	    		if( grade >= sizeof(skill_level_desc) )
				grade = sizeof(skill_level_desc)-1;
	    		return skill_level_desc[grade];
    	}
}

void skill_statue(object me,string skill)
{
	mapping skills;
	string cmd,str;

	if( !me )
		return;
	if( !skill )
	{
		ZJwrite(me,"你要查询什么？\n");
		return;
	} 	
	if( !mapp(skills=me->query_skills())
	 || sizeof(skills)<1 )
	{
		ZJwrite(me,"你目前并没有学会任何技能。\n");
		return;
	} 
	if( undefinedp(skills[skill]) )
	{
		ZJwrite(me,"你目前并没有学会这项技能。\n");
		return;
	}
	str = ZJOBLONG;
	str+= "【"+to_chinese(skill)+"】";
	str+= "\n";
	str+= ZJOBACTS2+ZJMENUF(1,1,7,35);
	if(member_array(skill,valid_types)==-1)
	{
		str+= "激发"+to_chinese(skill)+":skills "+skill+ZJSEP;
		str+= "准备"+to_chinese(skill)+":prepare "+skill+ZJSEP;
	}	
            
	else	str+= "练习"+to_chinese(skill)+":practice "+skill+ZJSEP;
	
	str+= "查看"+to_chinese(skill)+":checkskill "+skill+ZJSEP;
      str+= "遗忘"+to_chinese(skill)+":abandon "+skill+ZJSEP;
	if( !stringp(cmd=me->query_temp("cmds/last_skills")) 
	 || cmd == "" )
		cmd = "";
	str+= "技能列表:skills "+cmd+ZJSEP;	
	tell_object(me,str+"\n");
}

int filter_for_enable(string skill, string skill1)
{
	return (skill == skill1) || (SKILL_D(skill)->valid_enable(skill1));
}

int filter_for_main(string skill, string skill1)
{
	return (SKILL_D(skill)->main_skill() == skill1);
}

int filter_for_combine(string skill, string skill1)
{
	return (SKILL_D(skill1)->valid_enable(skill)) || (SKILL_D(skill)->valid_combine(skill1));
}

int main(object me, string arg)
{
	object 	ob=0;
	string str,cmd,id,skill_target,tmp,pops,skillname,skcolor,sss;
	string *prep_skills,*skills,*sname,*map_skills,*text,*fen;
	mapping skill,map_skill,prep_skill,learn_skill;
	int i,page,cha_type=0,lvl,j,k,total,all,percent,learn_p,max_page;

	
	if( !environment(me) )
	{
		ZJwrite(me,"有问题，请联系巫师。\n");
		return 1;
	}	
	if( !arg )
		cmd = "";
	else	cmd = arg;
	
	if( !arg || (sscanf(arg,"%d",page)==1) )
	{
		ob = me;
		if( page<1 )
			page = 1;
	}
	else 
	{
		if( sscanf(arg,"-f %s",arg)==1 )
		{
			skill_statue(me,arg);
			return 1;
		}
		else if( sscanf(arg,"for %s",id)==1 )
		{
			if( sscanf(id,"%s to %d",id,page)==2 )
				;
			else	page = 1;
		}
		else if( sscanf(arg,"%s for %s",arg,id)==2 )
		{
			if( sscanf(id,"%s to %d",id,page)==2 )
				;
			else	page = 1;
		}	
		else 
		{
			ob = me;
			if( sscanf(arg,"%s %d",arg,page)==2 )
				;
			else	page = 1;
		}
		//if( wizardp(me) )  tell_object(me,"arg="+arg+" id="+id+"\n");
		if( !ob )
		{
			ob = present(id,environment(me));
			if( !ob || !ob->is_character() ) 
				ob = find_player(id);
			if( !ob || !ob->is_character()) 
				ob = find_living(id);
			if( !ob || !ob->is_character()) 
			{
				ZJwrite(me,"你要察看谁的技能？\n");
				return 1;
			}
		}
	}
	
	if( !mapp(skill = ob->query_skills())
	 || sizeof(skill)<1 )
	{
		ZJwrite(me,(ob==me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
		return 1;
	}
	map_skill = ob->query_skill_map();
	if( mapp(map_skill) && sizeof(map_skill)>0 )
		map_skills = values(map_skill);
	else	map_skills = ({});	
	prep_skill = ob->query_skill_prepare();
	if( mapp(prep_skill) && sizeof(prep_skill)>0 )
		prep_skills = values(prep_skill);
	else	prep_skills = ({});	
	learn_skill = ob->query_learned();
	if( !mapp(learn_skill) || sizeof(learn_skill)<0 )
		learn_skill = ([]);
	skills = keys(skill);
	
	//if( wizardp(me) )  tell_object(me,"cmd="+cmd+"  page="+page+"\n");
	//查询指定技能，不需要换页功能
	if( arg && sscanf(cmd,"for %s",id)!=1 )
	{
		if( ob!=me )
		{
			write(me,"查询他人技能时，无法对指定技能进行操作。 "+ZJURL("cmds:skills "+cmd)+ZJSIZE(25)+HIY"返回上一界面"NOR"\n");
			return 1;
		}
		skill_target = arg;
		if( undefinedp(skill[skill_target]) )
		{
			write(me,"你目前并没有学会「"+to_chinese(skill_target)+"」这个技能。\n");
			return 1;
		}

	
		
		str = ZJOBLONG + "我的技能";
		if( member_array(skill_target, valid_types) != -1)
		{
			sname = filter_array(skills, (: filter_for_enable :), skill_target);
			str += to_chinese(skill_target) + "及相关技能\n";
		}
		else if( SKILL_D(skill_target)->main_skill() && member_array(SKILL_D(skill_target)->main_skill(), skills) == -1)
		{
			tmp = SKILL_D(skill_target)->main_skill();
			sname = filter_array(skills, (: filter_for_main :), tmp);
			str += to_chinese(tmp) + "中的招式\n";
		}
		else
		{
			cha_type = 3;
			sname = filter_array(skills, (: filter_for_combine :), skill_target);
			str += to_chinese(skill_target) + "和可以激发的基础武技与能够组合的技能\n";
		}

		if( !sizeof(sname) )
		{
			ZJwrite(me, "你目前还没有掌握该技能。\n");
			return 1;
		}
		str = replace_string(str,"\n",ZJBR);
		if(str[(strlen(str)-4)..(strlen(str)-1)]=="$br#")
			str = str[0..(strlen(str)-5)];
		str += "\n";
		str += ZJOBACTS2+ZJMENUF(3,3,7,30);
		for(i = 0; i < sizeof(sname); i++)
		{
			if( !objectp(find_object(SKILL_D(sname[i]))) && ! objectp(load_object(SKILL_D(sname[i]))) )
			{
				write(HIR "Error(No such skill):" + sname[i] + NOR"\n");
				continue;
			}
			skillname = to_chinese(sname[i]);
			if( member_array(sname[i], valid_types)!=-1 )
				skcolor = CYN;
			else	skcolor = WHT;
			
			lvl = skill[sname[i]];
			if( undefinedp(learn_skill[sname[i]]) )
				learn_p = 0;
			else 	learn_p	= learn_skill[sname[i]];
			percent = learn_p * 100 / ((lvl + 1) * (lvl + 1) + 1);
			if( percent > 100) percent = 100;
			pops = "";
			if(cha_type==3)
			{
				pops = ZJPOPMENU;
				if( member_array(sname[i], valid_types)==-1 )
				{
					if(!mapp(prep_skill)||member_array(sname[i], prep_skills) == -1)
						pops += "组合"+to_chinese(sname[i])+"|bei "+sname[i]+" "+skill_target;
					else	pops += "撤销组合"+to_chinese(sname[i])+"|bei none";
				}
				else
				{
					if(!mapp(map_skill)||undefinedp(map_skill[sname[i]]))
						pops += "激发为"+to_chinese(sname[i])+"|jifa "+sname[i]+" "+skill_target;
					else	pops += "撤销激发"+to_chinese(sname[i])+"|jifa "+sname[i]+" none";
				}
			}
			str += sprintf("%s%s%s%s"NOR ZJBR WHT"　%d/%d%%"NOR":%s"ZJSEP,
					skcolor,
					(learn_p >= (skill[sname[i]]+1) * (skill[sname[i]]+1)) ? HIM : "",
					(member_array(sname[i], map_skills)==-1? "　": RED"¤"NOR),skillname, lvl ,percent,pops);
		}
		tell_object(me,str+"\n");
		return 1;
	}
	//无指定技能查询，使用分页显示
	if( page<1 ) page = 1;
	fen = ({});
	sname = skills;
	for(i = 0; i < sizeof(sname); i++)
	{
		if( !objectp(find_object(SKILL_D(sname[i]))) && ! objectp(load_object(SKILL_D(sname[i]))) )
		{
			write(HIR "Error(No such skill):" + sname[i] + NOR"\n");
			continue;
		}
		skillname = to_chinese(sname[i]);
		if( member_array(sname[i], valid_types)!=-1 )
			skcolor = CYN;
		else	skcolor = WHT;
		lvl = skill[sname[i]];
		if( undefinedp(learn_skill[sname[i]]) )
			learn_p = 0;
		else 	learn_p	= learn_skill[sname[i]];
		percent = learn_p * 100 / ((lvl + 1) * (lvl + 1) + 1);
		if( percent > 100) percent = 100;
		sss = sprintf("%s%s%s%s"NOR ZJBR WHT"　%d/%d%%"NOR,
			skcolor,(learn_p >= (skill[sname[i]]+1) * (skill[sname[i]]+1)) ? HIM : "",
			(member_array(sname[i], map_skills)==-1? "　": HIC"¤"NOR),skillname, lvl ,percent);	
		if( ob!=me )
			sss+= HIY"  "NOR+":learn "+ob->query("id")+" "+sname[i];
		else	sss+= ":skills -f "+sname[i]; 
		fen += ({ sss });
	}
	if( sizeof(fen)>0 )
		text = sort_array(fen, 1);
	max_page = (int)(sizeof(text)/518>0?(sizeof(text)/518+1):(sizeof(text)/518));
	if( max_page<1 )
		max_page = 1;	
	str = ZJOBLONG + (ob==me ? "你" : ob->name()) +"目前所学到的 "+page+"/"+max_page;
	str = replace_string(str,"\n",ZJBR);
	str+= "\n";
	if( sizeof(fen)>0 )
	{
		str+= ZJOBACTS2+ZJMENUF(3,3,7,30);
		all = sizeof(text)/24;
		if(sizeof(text)%10000) all += 1;
		if(page<1) page = 1;
		if(page>all) page = all;
		j = (page-1)*100;
		i = page*100;
		if( i >= sizeof(text)) i = sizeof(text);
		i--;
		if( ob==me )
			id = me->query("id");
		else	id = ob->query("id");	
		if(all>1)
		{
			if( page>1 )
				str+= "      "HIY"上一页"NOR":skills for "+id+" to "+(page-1)+ZJSEP;
			if( page<all )
				str+= "      "HIY"下一页"NOR":skills for "+id+" to "+(page+1)+ZJSEP;
		}
		str += implode(text[j..i], ZJSEP);
	}
        if( strsrch(cmd,"-f")==-1 )
        	me->set_temp("cmds/last_skills",cmd);
	write(str+"\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : skills|cha [<技能名> of <某人 | me >] | [<某人>]

1. 如果查询一种《基本武功》，将显示所有能够装备的《特殊武功》。

2. 如果查询一种《武技招式》，则显示与之相关的《招式路数》。

3. 如果查询一种《特殊武功》，则显示依赖的《基本武技》与《互备武功》。

	注：显示的所有对象的提示，都是在--已经学会--的基础上
HELP
    );
    return 1;
}