void create()
{
    set("name","寻宝精灵");
    set("id","xbjl");
    seteuid(getuid());
}

int main(object me,string arg)
{
    object env;
    int sec,need,time,timedelay,kar;
    env=environment(me);
    if (!WABAO_D) return notify_fail("挖宝精灵还没载入。\n");
    if (me->is_busy()) return notify_fail("你现在正忙着呢。。。\n");
    if (me->query("combat_exp") < 10000 ) return notify_fail("你经验不足，如何能在江湖上寻宝？\n");
    //if (me->query("mud_age") < 172800 ) return notify_fail("你太年轻了，等过两岁再寻宝吧。\n");
        if ( !present("skybook", me) )
         return notify_fail("你没有"+HIW"十四天书"NOR+"，怎么能寻宝呢？\n");
    if (!arg||arg==""||sscanf(arg,"%d",sec)!=1)
        return notify_fail("xunbao <秒数>\n\n你要花费多少时间来寻找？\n\n");
    time=me->query_temp("xunbao/time");
    need=me->query_temp("xunbao/need");
    if (!need||need==0)
        {
        kar=40-me->query("kar");
        need=kar*3;
        need+=random(kar*2);
        if (need<30) need=30;
        me->set_temp("xunbao/need",need);
        }
    if (file_name(env)+".lpc"==WABAO_D->query("file"))
        {
        if (time<need)
            {
            timedelay=((sec+time>=need)?(need-time):sec);
            me->add_temp("xunbao/time",sec);
            }
        else
            timedelay=1;
        }
    else
        timedelay=sec;
    message_vision(HIC"$N对照着"+HIW"《十四天书》"+HIC"，蹲了下来开始寻宝。\n"NOR,me);
    me->start_busy(timedelay,timedelay);
    call_out("end_finding",timedelay,me,env);
    return 1;
}

void end_finding(object me,object env)
{
        int gain,i;
        object ob,bao;
        me->interrupt_me();
        if (!WABAO_D->query("file")) me->delete_temp("xunbao");
        if (file_name(env)+".lpc"!=WABAO_D->query("file")
                ||me->query_temp("xunbao/time")<me->query_temp("xunbao/need")
				||random(50)<random(50))
        {
        tell_object(me,HIC"良久，你还是一无所获。\n"NOR);
        tell_room(env,HIC+me->query("name")+"捶了捶发酸的腰，失望的站起身来。\n"NOR,me);
        return ;
        }

        me->delete_temp("xunbao");
        WABAO_D->delete("file");
        WABAO_D->delete("desc");
        log_file("wabao",sprintf("[%s]%s wabao from %s\n",
                    ctime(time()),
                    getuid(me),
                    file_name(env)) );
        i=random(sizeof(unit));
        message_vision(HIG"突然，从地上涌起一"+unit[i]+color[random(sizeof(color))]+
                        light[i]+HIG"将$N笼罩起来……\n"NOR,me);
        gain=5000 + 100 * random(50) + random(5000);
        /*me->add("xunbao/get",1);
        if (me->query("xunbao/get")>10)
                {
                tell_object(me,HIM"你已经寻到太多宝物了，是否应该考虑孝敬大家一点？\n"NOR);
                return;
                }*/
        switch(random(7))
        {
        case 0:
                me->add("combat_exp",gain);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了"+chinese_number(gain)+"经验！");
                tell_object(me,sprintf(HIY"你的经验增加了%s点！\n"NOR,
                        chinese_number(gain)));
                break;
        case 1:
                //gain=gain/5*20;
                me->add("potential",gain);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了"+chinese_number(gain)+"潜能！");
                tell_object(me,sprintf(HIY"你的潜能增加了%s点！\n"NOR,
                        chinese_number(gain)));
                break;
        case 2:
                gain=random(50);
                ob=new("/clone/money/gold");
                ob->set_amount(gain);
                ob->move(me);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了"+chinese_number(gain)+"两黄金！");
                tell_object(me,sprintf(HIY"你得到了%s两黄金！\n"NOR,
                        chinese_number(gain)));
                break;
        case 3:
                gain= random(5);
				me->add("yuanbao",gain);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了"+chinese_number(gain)+"元宝！");
                tell_object(me,sprintf(HIY"你得到了%s元宝！\n"NOR,
                        chinese_number(gain)));
                break;
        case 4:
                ob=new(baowu[random(10)]);
				ob->move(me);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了1个宝箱！");
                //tell_object(me,sprintf(HIY"你得到了%s宝箱！\n"NOR,
                //        chinese_number(gain)));
                break;
        case 5:
                ob=new(GF_LIST[random(479)]);
                ob->move(me);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"通过寻宝得到了一个铜人！");
               // tell_object(me,sprintf(HIY"你得到了%s两黄金！\n"NOR,
                //        chinese_number(gain)));
                break;
        default:
                gain=50 + random(100);
                me->add("max_neili",gain);
				CHANNEL_D->do_channel(me, "rumor",  me->query("name")+"寻宝得到了奇遇，内力增加了"+chinese_number(gain)+"点！");
                tell_object(me,sprintf(HIY"你的内力增加了%s点！\n"NOR,
                        chinese_number(gain)));
                break;
        }

    call_out ("night_appearing",1);
        return ;
}
