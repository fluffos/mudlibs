
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(CYN "神器武器箱" NOR, ({ "w9box" }) );
        set_weight(1);
	  set("suit_point",300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是70%失败的"+this_object()->query("name")+",\n"ZJURL("cmds:open w9box")ZJSIZE(15)"打开"NOR"看看!\n");
                set("unit", "个");                
        }
        setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{

        object me, ob;
        int exp, qn;
        string sob, msg;
        string *gifts =({
               "/clone/suit/w/9/blade",
               "/clone/suit/w/9/club",
               "/clone/suit/w/9/dagger",
               "/clone/suit/w/9/hammer",
               "/clone/suit/w/9/staff",
               "/clone/suit/w/9/sword",
               "/clone/suit/w/9/whip",
                                                  
        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        if (random(10) < 7)
        {                
                write("你打开包裹一看，里面尽是一些不值钱的东西，随手将之仍在一边。\n");
                destruct(this_object());
                return 1;
        }

        // 获取一些奖励
        exp = 1;
        qn = 1;

        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
             //   msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
                msg = HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
                tell_object(me, msg);
                ob->move(me, 1);
                me->add("combat_exp", exp);
                me->add("potential", qn);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}
