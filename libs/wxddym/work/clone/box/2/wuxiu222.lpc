// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "SSS灵魂" NOR, ({ "dan", "wan"}) );
        set_weight(200);
	
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗圆圆的神力丸，据说吃了可以提升武学修养。\n");
                set("xy_money", 1);

                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);
if (me->query_skill("martial-cognize", 1) > 300)
	
{
	
	tell_object(me, HIC "\n你获得了" + chinese_number(10000) + "点武学点潜能。"NOR"\n");
me->improve_skill("martial-cognize", 100000000);
     destruct(this_object());
	      return 1;
	 }
             tell_object(me, HIC "\n你 武学修养低于300"NOR"\n");
        destruct(this_object());
        return 1;
}

