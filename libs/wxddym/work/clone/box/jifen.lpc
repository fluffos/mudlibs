
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIC "积分箱子" NOR, ({ "baox" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是能够增加2000积分的箱子,\n"ZJURL("cmds:open baox")ZJSIZE(15)"打开"NOR"看看!\n");
                set("unit", "个");

        }
        setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{

        object me, ob;
        int exp, qn,suit;
        string sob, msg;
        string *gifts =({
               "/clone/money/coin",

        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        // 获取一些奖励
		suit = 2000;
        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
                msg = HIR "\n你获得了 " + chinese_number(suit) + " 点积分。\n" NOR;
                tell_object(me, msg);
				me->add("suit_point", suit);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}

