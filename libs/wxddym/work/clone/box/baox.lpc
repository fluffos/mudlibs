
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIC "经验宝箱" NOR, ({ "baox" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是系统奖励的"+this_object()->query("name")+",\n"ZJURL("cmds:open baox")ZJSIZE(15)"打开"NOR"看看!\n");
                set("unit", "个"); 
             
        }
        setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{

        object me, ob;
        int exp, qn;
        string sob, msg;
        string *gifts =({
               "/clone/money/coin",
                                                  
        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        if (random(10) == 11)
        {                
                write("你打开包裹一看，里面尽是一些不值钱的东西，随手将之仍在一边。\n");
                destruct(this_object());
                return 1;
        }

        // 获取一些奖励
        exp =300 + random(700);
        qn = 300 + random(700);

        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
                msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
                tell_object(me, msg);
                ob->move(me, 1);
                me->add("combat_exp", exp);
                me->add("potential", qn);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}

