// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIM"衣服宝箱"NOR,({"boxno3"}));
	set_weight(5000);
       
	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"这是系统奖励的"+this_object()->query("name")+",\n使用(openbox boxno3)"ZJURL("cmds:openbox boxno3")ZJSIZE(15)"打开"NOR"看看!\n");
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","openbox boxno3",1);
}
//打开宝箱的函数
int do_openbox()
{
   int i;
   int num=1;
   string obj=""; 
   object ob;
 /*
   * 金块,D1套装，打造材料,九转
  */
   string *box=
({
