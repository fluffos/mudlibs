// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIM"三十柄飞剑"NOR,({"fei-jian box"}));
	set_weight(1);

	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"这是一个装有三十柄飞剑的宝箱，飞剑可以助你去到想找的人身边,"ZJURL("cmds:openbox fei-jian box")ZJSIZE(15)"打开"NOR"看看!\n");
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","openbox fei-jian box",1);
}
//打开宝箱的函数
int do_openbox()
{
   int i;
   int num=1;
   string obj="";
   object ob;


	object me = this_player();
	if (me->is_busy())
	      { write("你上一个动作未完成！\n"); return 1;}
	if( me->is_fighting() )
	      { write("先干完这场架再打开。\n"); return 1;}

	message_vision(HIM"$N轻轻打开了["+this_object()->query("name")+"]！"NOR"\n",me);
		ob = new("clone/special/feijian");
		ob->set_amount(30);
		ob->move(me);

		write(HIG"你得到了三十柄飞剑。 "NOR"\n");
    destruct(this_object());
	return 1;
}
int query_autoload()
{
	return 1;
}