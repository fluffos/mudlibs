
#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
        set_name(HIW "智慧之心" NOR, ({ "zhihui" }) );
        set_weight(2000);
        set("long", HIW "秋玲注：天地初开，上古魔尊留下七把绝世奇物，其一把名为：智慧，其状如心，无色，后被九天主得到以九天之力冲击，智慧 终究融化，炼制出了一把惊世神兵其名，智慧之心，神兵成，天地震动，降下世劫，遗失了无数载。\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                //set("no_sell",1);
               // set("no_drop",1);
               // set("no_give",1);
                set("material", "steel");
                set("value", 10000);
                set("armor_prop/armor", 200);
                set("armor_prop/int",50); 

        }
        setup();
}

int query_autoload()
{
        return 1;
}
