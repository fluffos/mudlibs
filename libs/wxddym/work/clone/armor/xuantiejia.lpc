#include <armor.h>
inherit ARMOR;

void create()
{
        set_name("玄铁重甲", ({"xuantie armor","xuantiejia","jia","armor"}));
        set_weight(40000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
        set("long", "一件沉甸甸的铁甲。\n");
				set("no_get", 1);
				set("no_give", 1);
				set("no_drop", 1);
				set("no_sell", 1);
				set("no_steal", 1);
                set("value", 3000);
                set("material", "steel");
                set("armor_prop/armor", 400);
                set("armor_prop/dodge", -100);
        }
        setup();
}