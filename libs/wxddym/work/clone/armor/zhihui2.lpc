
#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
        set_name(HIW "智慧之心-碎片（小）" NOR, ({ "zhihui2" }) );
        set_weight(2000);
        set("long", HIW "被天地世劫劈散的智慧。以及其微小的形状存在。听说佩戴身上会有意想不到的好处.\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                //set("no_sell",1);
               // set("no_drop",1);
               // set("no_give",1);
                set("material", "steel");
                set("value", 10000);
                set("armor_prop/armor", 70);
                set("armor_prop/int",15); 

        }
        setup();
}

int query_autoload()
{
        return 1;
}
