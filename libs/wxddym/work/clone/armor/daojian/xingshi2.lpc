
#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name(HIY "天降·醒世环" NOR, ({ "xingshi huan2" }));
        set_weight(30);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", HIY "传说中狐仙所佩带的指环。\n" NOR);
                set("value", 200000);
                set("material", "gold");
                set("armor_prop/con", 30);
                set("armor_prop/damage", 3000);
                set("armor_prop/unarmed", 100);
                set("material", "brings");

        }
        setup();
}

int query_autoload()
{
        return 1;
}
