
#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
        set_name(HIG "魔灵披风" NOR, ({ "moling pifeng", "moling", "pifeng" }) );
        set_weight(2000);
        set("long", HIG "这是一件某个魔界大能披戴过的披风，隐隐散发出丝丝魔气。\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "steel");
                                set("value", 3000000);
                set("armor_prop/armor", 50);
                                set("armor_prop/con", 1);
                                set("armor_prop/dex", 1);
                                set("armor_prop/dodge", 20);
        }
        setup();
}

int query_autoload()
{
        return 1;
}
