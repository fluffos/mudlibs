
#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
        set_name(HIW "智慧之心-碎片" NOR, ({ "zhihui1" }) );
        set_weight(2000);
        set("long", HIW "神匠干将早年游历的时候收集到一些神物智慧碎渣，由于太少的原因参杂了许多奇物。凝结成拇指大小。后被无名老人花重宝换去。\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                //set("no_sell",1);
                //set("no_drop",1);
               // set("no_give",1);
                set("material", "steel");
                set("value", 1000);
                set("armor_prop/armor", 100);
                set("armor_prop/int",25); 

        }
        setup();
}

int query_autoload()
{
        return 1;
}
