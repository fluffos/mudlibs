#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name(MAG "紫血环" NOR, ({ "zixue huan", "zixue", "huan" }));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", MAG "罕见的紫色血玉锻造而成，入手冰冷刺骨，佩戴后有特殊功效。\n" NOR);
                set("value", 2000);
                set("material", "gold");
                set("armor_prop/damage", 100);
                set("armor_prop/int", 10);
        }
        setup();
}

int query_autoload()
{
        return 1;
}

