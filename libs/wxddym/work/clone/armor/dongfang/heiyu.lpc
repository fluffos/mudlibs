#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name(HIB "黑玉指环" NOR, ({ "heiyu zhihuan", "heiyu", "zhihuan" }));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", HIB "此乃千年黑玉锻造而成的指环，遇寒则热，遇热则寒，佩戴后有特殊功效。\n" NOR);
                set("value", 20000);
                set("material", "gold");
                set("armor_prop/damage", 100);
                set("armor_prop/int", 10);

        }
        setup();
}

int query_autoload()
{
        return 1;
}

