inherit NPC;
inherit F_DEALER;

string ask_tiandaodao();
string ask_tiandaojian();
string ask_tiandaoquan();
string ask_tiandaozhang();
string ask_shengti();
string ask_dunyi();
string ask_wudao();
void create()
{
	set_name("补偿", ({"补偿"}));
	set("gender", "女性");
	set("nickname", HIB"机缘"NOR);
	set("age", 19);
	 set("icon", "01394");
	set("long",
		"错失的机缘\n");
	set("startroom", "/d/city/guangchang");
	set("inquiry", ([
               "「补偿」"         : (: ask_wudao :),
	]) );
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

string ask_wudao()
{
	object me;
	object ob;

	me = this_player();
if ( me->query_skill("wudao-shanqian", 1) < 10 ) return "你还没有演练出武道呢！";

       if(!me->query("wudao-shanqian1"))
       {
      me->add("tianfu_point", 30);
	me->set("wudao-shanqian1",1);
	write(HIY"\补偿对你说：这是你错失的机缘"NOR"\n");
	write(HIY"\n天赋能力点+30"NOR"\n");

       }
      return HIR+"  一路顺风，谢谢支持[武学大道]"+NOR;
}




