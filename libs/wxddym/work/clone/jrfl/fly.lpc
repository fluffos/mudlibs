inherit NPC;
//inherit F_DEALER;
string ask_duanwu();
string ask_dashuju();
void create() {
  set_name("节日福利员", ({ "fl" }));
  set("gender", "女性");
  set("nickname", HIB "节日福利员" NOR);
  set("age", 21);
  set("qi", 10000000);
  set("max_qi", 10000000);
  set("max_neili", 1000000);
  set("neili", 1000000);
  set("combat_exp", 10000000);
  set("int", 3000);
  set("str", 3000);
  set("con", 3000);
  set("dex", 3000);
  set("icon", "01394");
  set("long",
    "可以找她领取节日福利员。\n");

  set_skill("unarmed", 3200);
  set_skill("force", 3200);
  set_skill("finger", 3200);
  set_skill("sword", 3200);
  set_skill("dodge", 3200);
  set_skill("parry", 3200);
  set_skill("six-finger", 3200);
  set_skill("beiming-shengong", 3200);
  set_skill("lingbo-weibu", 3200);
  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingbo-weibu");
  map_skill("finger", "six-finger");
  map_skill("parry", "six-finger");
  set_temp("apply/attack", 6000);
  set_temp("apply/defense", 6000);
  set_temp("apply/armor", 6000);
  set_temp("apply/damage", 6000);

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("exert shield") :),
    (: command("exert powerup") :),
    (: command("perform finger.six") :),
    (: command("perform finger.qi") :),
    (: command("perform finger.zongheng") :),
  }));
  set("startroom", "/d/city/guangchang");
  set("inquiry", ([
    /*	"「端午节」"       : (: ask_duanwu :),*/
    "「大数据」": (: ask_dashuju :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
string ask_dashuju() {
  object me;
  object ob;

  me = this_player();
  if (me->query_skill("martial-cognize", 1) < 150) return "你武学修养小余150！";
  if (!me->query("dashuju1")) {

    me->add("xy_money", 200);
    ob = new("/u/shimen2");
    ob->move(me);
    ob = new("/u/shimen2");
    ob->move(me);
    me->set("dashuju1", 1);
    write(HIY "\n福利员拿出砖头给你加了个BUFF。" NOR "\n");
    write(HIG "\n你得到了福利员的BUFF： 元宝2000，师门双倍丹两个个" NOR "\n");
  }
  return HIR + "  一路顺风，谢谢支持。" + NOR;
}
void die() {
  object me, ob;

  me = this_object();

  set("eff_qi", 10000000);
  set("qi", 10000000);
  set("eff_jing", 10000000);
  set("jing", 10000000);
  set("neili", 90000000);
  set("max_jingli", 1000000);

  say(me->name() + CYN "说道：我是不死的。\n" NOR);
  return;
}
