// zzfen.c

#include "herb.h"

void create()
{
	set_name(MAG "极品珍珠" NOR, ({ "zhenzhu", "herb_zz" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一颗极品的珍珠。\n");
		set("base_unit", "颗");
		set("base_value", 1000);
        	set("base_weight", 30);
	}
	setup();
}
