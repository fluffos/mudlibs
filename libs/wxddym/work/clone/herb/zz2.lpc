// zzfen.c

#include "herb.h"

void create() {
  set_name(MAG "仙灵粉" NOR, ({ "xianling fen", "herb_xlfen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是上等炼药材料。\n");
    set("base_unit", "包");
    set("base_value", 1000);
    set("base_weight", 20);
  }
  setup();
}
