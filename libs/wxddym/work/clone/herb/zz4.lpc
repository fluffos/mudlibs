// zzfen.c

#include "herb.h"

void create() {
  set_name(MAG "玉露琼浆" NOR, ({ "yulu", "herb_yl" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是上等炼药材料。\n");
    set("base_unit", "瓶");
    set("base_value", 1000);
    set("base_weight", 30);
  }
  setup();
}
