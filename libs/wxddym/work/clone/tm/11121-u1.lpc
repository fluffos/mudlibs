// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "大周天经脉通脉丹-足厥阴脉" NOR, ({"u1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通大周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/足厥阴脉/tongren u1",1,me);
me->set("jingmai/足厥阴脉/tongren u2",1,me);
me->set("jingmai/足厥阴脉/tongren u3",1,me);
me->set("jingmai/足厥阴脉/tongren u4",1,me);
me->set("jingmai/足厥阴脉/tongren u5",1,me);
me->set("jingmai/足厥阴脉/tongren u6",1,me);
me->set("jingmai/足厥阴脉/tongren u7",1,me);
me->set("jingmai/足厥阴脉/tongren u8",1,me);
me->set("jingmai/足厥阴脉/tongren u9",1,me);
me->set("jingmai/足厥阴脉/tongren u10",1,me);
me->set("jingmai/足厥阴脉/tongren u11",1,me);
me->set("jingmai/足厥阴脉/tongren u12",1,me);
me->set("jingmai/足厥阴脉/tongren u13",1,me);
me->set("jingmai/足厥阴脉/tongren u14",1,me);
me->set("jingmai/足厥阴脉/chongxue_ok",1,me);               
message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}