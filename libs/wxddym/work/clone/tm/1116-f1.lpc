
// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "小周天经脉通脉丹-冲脉" NOR, ({"f1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通小周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/冲脉/tongren f1",1,me);
me->set("jingmai/冲脉/tongren f2",1,me);
me->set("jingmai/冲脉/tongren f3",1,me);
me->set("jingmai/冲脉/tongren f4",1,me);
me->set("jingmai/冲脉/tongren f5",1,me);
me->set("jingmai/冲脉/tongren f6",1,me);
me->set("jingmai/冲脉/tongren f7",1,me);
me->set("jingmai/冲脉/tongren f8",1,me);
me->set("jingmai/冲脉/tongren f9",1,me);
me->set("jingmai/冲脉/tongren f10",1,me);
me->set("jingmai/冲脉/tongren f11",1,me);
me->set("jingmai/冲脉/tongren f12",1,me);
me->set("jingmai/冲脉/tongren f13",1,me);
me->set("jingmai/冲脉/tongren f14",1,me);
me->set("jingmai/冲脉/tongren f15",1,me);
me->set("jingmai/冲脉/tongren f16",1,me);
me->set("jingmai/冲脉/tongren f17",1,me);
me->set("jingmai/冲脉/tongren f18",1,me);
me->set("jingmai/冲脉/tongren f19",1,me);
me->set("jingmai/冲脉/tongren f20",1,me);
me->set("jingmai/冲脉/tongren f21",1,me);
me->set("jingmai/冲脉/tongren f22",1,me);
me->set("jingmai/冲脉/tongren f23",1,me);
me->set("jingmai/冲脉/tongren f24",1,me);
me->set("jingmai/冲脉/chongxue_ok",1,me);  
message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}