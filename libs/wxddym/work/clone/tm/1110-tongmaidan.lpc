
// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "大小周天经脉通脉丹" NOR, ({"tmd","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通大小周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 10000);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
                  me->set("jingmai/finish",1,me);	
                message_vision(HBYEL+HIR"$N吃下一颗大小周天经脉通脉丹,连忙运用内功控制周身经脉穴道\n", me);
                destruct(this_object());
                return 1;
}