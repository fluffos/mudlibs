// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "小周天经脉通脉丹-督外脉" NOR, ({ "g1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通小周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/督外脉/tongren g1", 1, me);
  me->set("jingmai/督外脉/tongren g2", 1, me);
  me->set("jingmai/督外脉/tongren g3", 1, me);
  me->set("jingmai/督外脉/tongren g4", 1, me);
  me->set("jingmai/督外脉/tongren g5", 1, me);
  me->set("jingmai/督外脉/tongren g6", 1, me);
  me->set("jingmai/督外脉/tongren g7", 1, me);
  me->set("jingmai/督外脉/tongren g8", 1, me);
  me->set("jingmai/督外脉/tongren g9", 1, me);
  me->set("jingmai/督外脉/tongren g10", 1, me);
  me->set("jingmai/督外脉/tongren g11", 1, me);
  me->set("jingmai/督外脉/tongren g12", 1, me);
  me->set("jingmai/督外脉/tongren g13", 1, me);
  me->set("jingmai/督外脉/tongren g14", 1, me);
  me->set("jingmai/督外脉/tongren g15", 1, me);
  me->set("jingmai/督外脉/tongren g16", 1, me);
  me->set("jingmai/督外脉/tongren g17", 1, me);
  me->set("jingmai/督外脉/tongren g18", 1, me);
  me->set("jingmai/督外脉/tongren g19", 1, me);
  me->set("jingmai/督外脉/tongren g20", 1, me);
  me->set("jingmai/督外脉/tongren g21", 1, me);
  me->set("jingmai/督外脉/tongren g22", 1, me);
  me->set("jingmai/督外脉/tongren g23", 1, me);
  me->set("jingmai/督外脉/tongren g24", 1, me);
  me->set("jingmai/督外脉/chongxue_ok", 1, me);
  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
