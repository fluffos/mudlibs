
// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "小周天经脉通脉丹-阳跷脉" NOR, ({"b1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通小周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/阳跷脉/tongren b1",1,me);
me->set("jingmai/阳跷脉/tongren b2",1,me);
me->set("jingmai/阳跷脉/tongren b3",1,me);
me->set("jingmai/阳跷脉/tongren b4",1,me);
me->set("jingmai/阳跷脉/tongren b5",1,me);
me->set("jingmai/阳跷脉/tongren b6",1,me);
me->set("jingmai/阳跷脉/tongren b7",1,me);
me->set("jingmai/阳跷脉/tongren b8",1,me);
me->set("jingmai/阳跷脉/tongren b9",1,me);
me->set("jingmai/阳跷脉/tongren b10",1,me);
me->set("jingmai/阳跷脉/tongren b11",1,me);
me->set("jingmai/阳跷脉/tongren b12",1,me);
me->set("jingmai/阳跷脉/tongren b13",1,me);
me->set("jingmai/阳跷脉/tongren b14",1,me);
me->set("jingmai/阳跷脉/tongren b15",1,me);
me->set("jingmai/阳跷脉/tongren b16",1,me);
me->set("jingmai/阳跷脉/tongren b17",1,me);
me->set("jingmai/阳跷脉/tongren b18",1,me);
me->set("jingmai/阳跷脉/tongren b19",1,me);
me->set("jingmai/阳跷脉/tongren b20",1,me);
me->set("jingmai/阳跷脉/tongren b21",1,me);
me->set("jingmai/阳跷脉/tongren b22",1,me);
me->set("jingmai/阳跷脉/tongren b23",1,me);
me->set("jingmai/阳跷脉/chongxue_ok",1,me);                message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}