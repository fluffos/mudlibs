
// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "小周天经脉通脉丹-带脉" NOR, ({"e1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通小周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/带脉/tongren e1",1,me);
me->set("jingmai/带脉/tongren e2",1,me);
me->set("jingmai/带脉/tongren e3",1,me);
me->set("jingmai/带脉/tongren e4",1,me);
me->set("jingmai/带脉/tongren e5",1,me);
me->set("jingmai/带脉/tongren e6",1,me);
me->set("jingmai/带脉/tongren e7",1,me);
me->set("jingmai/带脉/tongren e8",1,me);
me->set("jingmai/带脉/tongren e9",1,me);
me->set("jingmai/带脉/tongren e10",1,me);
me->set("jingmai/带脉/tongren e11",1,me);
me->set("jingmai/带脉/tongren e12",1,me);
me->set("jingmai/带脉/tongren e13",1,me);
me->set("jingmai/带脉/tongren e14",1,me);
me->set("jingmai/带脉/tongren e15",1,me);
me->set("jingmai/带脉/tongren e16",1,me);
me->set("jingmai/带脉/tongren e17",1,me);
me->set("jingmai/带脉/tongren e18",1,me);
me->set("jingmai/带脉/tongren e19",1,me);
me->set("jingmai/带脉/chongxue_ok",1,me); 
message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}