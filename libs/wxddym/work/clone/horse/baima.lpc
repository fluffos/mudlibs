#include <ansi.h>

inherit NPC;
#define PRODUCT "/clone/shoufei/product"
void create() {
  set_name(HIY "白马" NOR, ({ "huangbiaoma" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2 + random(3));
  set("long", "这是一匹白马，全身白色，没有一丝杂毛。\n");
  set("ridable", 1);
  set("int", 30);
  set("qi", 8000);
  set("max_qi", 8000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("shen_type", 0);
  set("combat_exp", 500000);
  set("attitude", "peaceful");
  set("icon", "05006");
  set("limbs", ({ "头部", "腹部", "尾巴", "后腿", "前腿" }));
  set("verbs", ({ "bite", "hoof" }));
  set_temp("apply/attack", 100);
  set_temp("apply/armor", 150);
  set_temp("apply/damage", 250);

  set("chat_chance", 4);
  set("chat_msg", ({
    HIY "白龙马" NOR "抬头看了看你，继续埋下头吃它的夜草。\n",
  }));


  setup();
}

void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");

  //掉宝
  rand = random(1000);
  //tell_object(find_player("jerry"),sprintf("killer: rand = %d",rand));
  if (rand < 10) file = PRODUCT->get_random_level_product(
    1 + random(15),
    me->query("jym_level/level") - 5,
    me->query("jym_level/level")
  );
  else if (rand < 5) file = PRODUCT->get_random_level_product(
    1 + random(15),
    me->query("jym_level/level"),
    me->query("jym_level/level")
  );

  if (file) {
    item = new(file);
    if (item) {
      ob = this_object();  //NPC
      me = ob->query_temp("last_damage_form");  //玩家
      "/adm/item/equip"->init_equip_prop_1(item);  //变更装备品质
      item->move(environment(ob));
    }
  }
  rand = random(200);
  if (rand > 5) {
    item = new("/clone/money/silver");
    if (item) {
      item->set_amount(10);
      item->move(environment(ob));
    }
  }

  else if (rand < 5) {
    item = new("/clone/book/huanmo");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
