// rendao1.c 人道之心-极

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIM "人道之心-极" NOR, ({ "magic stone", "rendao zhixin", "shi" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "传闻上一次天道破裂化为了九颗人道之心，此乃被发现的第一颗，人道环绕，仙音袅袅200。\n");
    set("unit", "块");
    set("value", 10000);
    set("item_origin", 1);
    set("material_attrib", "magic stone");
    set("material_name", HIM "传说" NOR);
    set("can_make", "all");
    set("not_make", ({ "战衣", "腰带" }));
    set("power_point", 200);
  }
}
