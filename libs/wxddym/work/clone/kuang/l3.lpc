#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIY "高级灵元" NOR, ({ "ling yuan", "yuan"}) );
	set_weight(200);
      set("suit_point", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "吸收灵源，能增加积分。\n");
		set("no_drop", "这样东西不能离开你。\n");
                set("value", 10000);
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N鼻子微张，吸入下了一缕" + this_object()->name() +
                       "。\n", me);
        if (me->query("combat_exp") < 500)
        {
                message_vision("$N眨眨眼。\n", me);
                tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
        return 0;
        } 

        if (me->query("combat_exp") > 500)
        {
                me->add("suit_point", 30);
		

                 write("\n "+HIR+"恭喜你："+NOR+HIG+"实力的提升！！！ "+NOR);
        }else
        {
                tell_object(me, "不过你觉得好像没什么作用。\n");
        }
        destruct(this_object());
	return 1;
}
