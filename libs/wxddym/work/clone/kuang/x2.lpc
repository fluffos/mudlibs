#include <ansi.h>

inherit ITEM;

void create() {
  set_name(CYN "X箱" NOR, ({ "w2box" }));
  set_weight(1);
  set("xian_point", 5000);
  set("suit_point", 5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set(
      "long",
      "这会失败的" + this_object()->query("name") + ",\n" ZJURL("cmds:open w2box") ZJSIZE(15) "打开" NOR "看看里面有Y3!\n"
    );
    set("unit", "个");
  }
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {

  object me, ob;
  int exp, qn;
  string sob, msg;
  string *gifts = ({
    "/clone/box/y3_box",
  });

  me = this_player();

  if (environment(this_object()) != me) return 0;

  if (random(100) < 95) {
    write("你打开包裹一看，里面尽是一些不值钱的东西，随手将之仍在一边。\n");
    destruct(this_object());
    return 1;
  }

  // 获取一些奖励
  exp = 5;
  qn = 5;

  sob = gifts[random(sizeof(gifts))];

  ob = new(sob);

  if (objectp(ob)) {
    //   msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
    msg = HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
    tell_object(me, msg);
    ob->move(me, 1);
    me->add("combat_exp", exp);
    me->add("potential", qn);
  } else {
    write("物件" + sob + " 错误。\n");
  }

  destruct(this_object());
  return 1;
}
