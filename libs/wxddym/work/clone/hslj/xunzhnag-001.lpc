#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIY "论剑第一" NOR, ({ "diyi"}));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIY "带在身上可以提升研究最大次数三百次。\n" NOR);
                set("unit", "块");
                set("no_put", 1);
		    set("no_give", 1);
                set("can_summon", 1);
                set("value", 0);
        }
        setup();
}

int query_autoload()
{
        return 1;
}
