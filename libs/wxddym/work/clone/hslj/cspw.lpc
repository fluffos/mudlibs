#include <weapon.h>
#include <ansi.h>
#include <armor.h> 
inherit HANDS; 

void create()
{
set_name(NOR + HIY "传世"+HIB"破碗" NOR, ({ "chuanshi powan", "powan", "chuanshi", "wan", "传世破碗" }));
set_weight(500);
if (clonep())
set_default_object(__FILE__);
else {
set("unit", "只");
set("long", HIC "此碗乃是三千旁门之中的乞讨之道的入道之宝，可惜先祖不知此宝如何使用，只知珍贵无比，现如今传承到思萍手中。\n" NOR);
set("value", 800000);

set("no_sell", "…嗯…这东西珍是够珍贵，可是年代久远，我难以估价。");
set("material", "ceramics");
set("armor_prop/armor", 30);
set("armor_prop/unarmed_damage", 1000);
set("wear_msg", "$N从怀中摸出一只$n握在手中。\n");
set("remove_msg", "$N将手中的$n塞回怀中。\n");
set("stable", 100);
}
setup();
}
