#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create() {
  set_name(HIG "李老师专属披风" NOR, ({ "llszs" }));
  set_weight(1);
  set("long", HIG "VIP。\n" NOR);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "paper");
    set("value", 3000);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", "这样东西不能卖。\n");
    set("armor_prop/armor", 100);
    set("armor_prop/dex", 20);
    set("armor_prop/int", 20);
    set("armor_prop/str", 20);
    set("armor_prop/damage", 300);
    set("armor_prop/dodge", 100);
    set("wear_msg", HIW "只听“嗖”的一声破空声响，李老师专属披风已被$N披在身后。" NOR "\n");
  }
  setup();
}

int query_autoload() {
  return 1;
}

int move(mixed dest) {

  if (::move(dest) == 0) return 0;
  message(
    "channel:rumor",
    YEL "【上线提示】" HIM "欢迎：受人爱戴与尊敬" + dest->query("name") + "来到啪啪啪服！\n" NOR,
    users()
  );
  return 1;
}
