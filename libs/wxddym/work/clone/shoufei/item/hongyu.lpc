#include <ansi.h>
inherit ITEM;
#define EQUIP_D "/feature/equip"
#define MAKE_INDEX 30    //成功率 百分之
#define ADD_INDEX 10     //合成成功后增加点数
#define MAX_LEVEL 18     //最大占用镶嵌孔数

// 函数：所属类别
int query_xy() { return 1; }

//函数：宝石等级
int baoshi_level() { return 3; }

void create() {
  set_name(HIR "鸿玉" NOR, ({ "hongyu", "yu" }));
  set("long",
    "升级、改良武器装备的必须品，提升装备品质有极高几率成功，\n是比龙珠还要高级的珍贵宝珠。\n可以使用(synthesis <物品ID>)强化装备或武器。\n"
  );
  set("unit", "个");
}

void init() {
  add_action("do_hecheng", "synthesis");
}

int do_hecheng(string arg) {
  object me, item, ob, user_item;
  int damage, rand, mosaic;
  string equip_id;

  me = this_player();
  ob = this_object();

  if (!arg || !stringp(arg)) {
    tell_object(me, "你要强化哪件装备？\n");
    return 1;
  }
  if (!item = present(arg, me)) {
    tell_object(me, "你没有没有这件物品。\n");
    return 1;
  }
  if (!item->query_xy()) {
    tell_object(me, "无法强化它。\n");
    return 1;
  }
  if (item->query("mosaic_index", 1) >= MAX_LEVEL) {
    tell_object(me, sprintf("%s已经无法用%s进行强化了。\n", item->query("name"), ob->query("name")));
    return 1;
  }
  //检查是否穿戴装备
  if (user_item = me->query_temp("armor/cloth")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s脱下，方可对其强化。\n", item->query("name")));
      return 1;
    }
  }
  if (user_item = me->query_temp("weapon")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s放下，方可对其强化。\n", item->query("name")));
      return 1;
    }
  }

  rand = random(100);
  //强化攻击力
  if (damage = item->query("weapon_prop/damage")) {
    if (rand < MAKE_INDEX) {
      mosaic = item->query("mosaic_index", 1);
      item->set("mosaic_index", mosaic + 1);
      damage += ADD_INDEX;
      item->set("weapon_prop/damage", damage);
      item->add("_level", 1);

      if (ob->reset_item(item, me)) {
        tell_object(me, "恭喜你，强化成功。\n");
        destruct(item);
        destruct(ob);
        return 1;
      }
    }
    //强化失败
    else {
      tell_object(me, "对不起，强化失败。\n");
      destruct(ob);
      return 1;
    }
  } else if (damage = item->query("armor_prop/armor")) {
    if (rand < MAKE_INDEX) {
      mosaic = item->query("mosaic_index", 1);
      item->set("mosaic_index", mosaic + 1);
      damage += ADD_INDEX;
      item->set("armor_prop/armor", damage);
      item->add("_level", 1);

      if (ob->reset_item(item, me)) {
        tell_object(me, "恭喜你，强化成功。\n");
        destruct(item);
        destruct(ob);
        return 1;
      }
    }
    //强化失败
    else {
      tell_object(me, "对不起，强化失败。\n");
      destruct(ob);
      return 1;
    }
  }
  return 0;
}

int reset_item(object item, object me) {
  string file, porp, *temp_porp;
  int size;
  object new_item;

  if (!item || !me || !userp(me)) return 0;

  porp = EQUIP_D->query_save_prop_string(item);
  temp_porp = explode(porp, ",");
  size = sizeof(temp_porp);
  if (temp_porp) {
    sscanf(temp_porp[size - 1], "file:%s", file);
    new_item = new(file);
    if (new_item) {
      EQUIP_D->set_prop_baseon_string(new_item, porp);
      new_item->move(me);
    }
  }
  return 1;
}
