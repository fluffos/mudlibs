
inherit COMBINED_ITEM;

void create()
{
        set_name("千里追踪符", ({ "zhuizong fu" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
		set("long", "张天师制作的符箓，可以追踪(trace)某个人在什么地方。\n");
                set("no_sell", "这是什么东西？\n");
		set("base_value", 1);
                set("base_weight", 10);
                set("base_unit", "张");
        }
        set_amount(1);
        setup();
}

void init()
{
	add_action("do_trace", "trace");
}

int do_trace(string arg)
{
        object who;
        object env;

        if (! query_amount())
                return 0;

	if (! arg)
		return notify_fail("你想追踪谁？\n");

        who = find_living(arg);
        if (! objectp(who))
                return notify_fail("没有这个人！\n");

        if (! objectp(env = environment(who)))
                return notify_fail("这个人无法追踪！\n");

        write(sprintf(""HIR"%s"NOR"据说是在" HIY "%s" NOR "...\n", who->name(1), env->short()));
        add_amount(-1);
        return 1;
}


string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}
