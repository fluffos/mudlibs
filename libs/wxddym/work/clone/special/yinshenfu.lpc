// sunfenger.c

inherit COMBINED_ITEM;

void create() {
  set_name("阴神符", ({ "yinshenfu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("long", "这是一张上古阴神符，能召唤阴魂。\n");
    set("no_sell", "这是什么东西？\n");
    set("base_value", 1);
    set("base_weight", 10);
    set("base_unit", "只");
  }
  set_amount(1);
  setup();
}

void init() {
  add_action("do_shao", "shao");
}

int do_shao(string arg) {
  object ob;
  object env;


  ob = new("/d/maze/yw/npc/1");
  ob->move(environment(this_object()));

  write(sprintf("你燃烧了阴神符，远古阴神飞入你的背包，请到合适地方放出"));
  add_amount(-1);
  return 1;
}


string query_autoload() { return query_amount() + ""; }

void autoload(string param) {
  int amt;

  if (sscanf(param, "%d", amt) == 1)
    set_amount(amt);
}
