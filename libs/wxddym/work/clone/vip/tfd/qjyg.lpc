// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "奇筋异骨" NOR, ({ "dan", "wan"}) );
        set_weight(200);
	
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "天赋丹。\n");
                set("xy_money", 1);

                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);
        me->set("special_skill/qijin", 1);
		message_vision("$N获得了" + this_object()->name() +
                       "。\n", me);
        destruct(this_object());
        return 1;
}

