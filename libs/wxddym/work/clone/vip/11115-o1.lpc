// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "大周天经脉通脉丹-手少阳脉" NOR, ({"o1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通大周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/手少阳脉/tongren o1",1,me);
me->set("jingmai/手少阳脉/tongren o2",1,me);
me->set("jingmai/手少阳脉/tongren o3",1,me);
me->set("jingmai/手少阳脉/tongren o4",1,me);
me->set("jingmai/手少阳脉/tongren o5",1,me);
me->set("jingmai/手少阳脉/tongren o6",1,me);
me->set("jingmai/手少阳脉/tongren o7",1,me);
me->set("jingmai/手少阳脉/tongren o8",1,me);
me->set("jingmai/手少阳脉/tongren o9",1,me);
me->set("jingmai/手少阳脉/tongren o10",1,me);
me->set("jingmai/手少阳脉/tongren o11",1,me);
me->set("jingmai/手少阳脉/tongren o12",1,me);
me->set("jingmai/手少阳脉/tongren o13",1,me);
me->set("jingmai/手少阳脉/tongren o14",1,me);
me->set("jingmai/手少阳脉/tongren o15",1,me);
me->set("jingmai/手少阳脉/tongren o16",1,me);
me->set("jingmai/手少阳脉/tongren o17",1,me);
me->set("jingmai/手少阳脉/tongren o18",1,me);
me->set("jingmai/手少阳脉/tongren o19",1,me);
me->set("jingmai/手少阳脉/tongren o20",1,me);
me->set("jingmai/手少阳脉/tongren o21",1,me);
me->set("jingmai/手少阳脉/chongxue_ok",1,me);          
message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}