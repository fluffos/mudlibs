// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "还童丹" NOR, ({  "wan", "tian" }) );
        set_weight(200);
		set("value", 1000000);
		set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗园园的丹\n");
                set("xy_money", 50);
                set("unit", "粒");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
                       "。\n", me);
     me->set("age", 3);
	 
    me->set("mud_age", 11111);
	 
	
        destruct(this_object());
        return 1;
}

