
// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create()
{
        set_name(HIY "小周天经脉通脉丹-阴维脉" NOR, ({"c1 dan","dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是贯通小周天经脉的无上至宝。\n");
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);
                set("xy_money", 2500);
                set("value", 200);
                set("only_do_effect", 1);
        }
        setup();
}

int do_effect(object me)
{        
me->set("jingmai/阴维脉/tongren c1",1,me);
me->set("jingmai/阴维脉/tongren c2",1,me);
me->set("jingmai/阴维脉/tongren c3",1,me);
me->set("jingmai/阴维脉/tongren c4",1,me);
me->set("jingmai/阴维脉/tongren c5",1,me);
me->set("jingmai/阴维脉/tongren c6",1,me);
me->set("jingmai/阴维脉/tongren c7",1,me);
me->set("jingmai/阴维脉/tongren c8",1,me);
me->set("jingmai/阴维脉/tongren c9",1,me);
me->set("jingmai/阴维脉/tongren c10",1,me);
me->set("jingmai/阴维脉/tongren c11",1,me);
me->set("jingmai/阴维脉/tongren c12",1,me);
me->set("jingmai/阴维脉/tongren c13",1,me);
me->set("jingmai/阴维脉/tongren c14",1,me);
me->set("jingmai/阴维脉/tongren c15",1,me);
me->set("jingmai/阴维脉/tongren c16",1,me);
me->set("jingmai/阴维脉/chongxue_ok",1,me);                message_vision(HBYEL+HIR"$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
                destruct(this_object());
                return 1;
}