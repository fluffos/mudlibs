// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "归元丹" NOR, ({ "dan", "wan" }));
  set_weight(200);
  set("no_drop", "这样东西不能离开你。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗圆圆的神力丸，据说吃了可以清除吃蛋纪录转世后禁止使用。食用后全属性回到25请谨慎使用\n");
    set("xy_money", 1);
    set("no_drop", "这样东西不能离开你。\n");
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  if (me->query("level") > 12) {
    tell_object(me, "你z砖石了。\n");
    return 0;
  }



  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);


  me->set("gift/str/succeed", 5);
  me->set("gift/shenliwan", 5);
  me->set("gift/dex/succeed", 5);
  me->set("gift/unknowdan", 5);
  me->set("gift/int/succeed", 5);
  me->set("gift/xiandan", 5);
  me->set("gift/con/succeed", 5);
  me->set("gift/xisuidan", 5);

  me->set("str", 25);
  me->set("dex", 25);
  me->set("int", 25);
  me->set("con", 25);


  destruct(this_object());
  return 1;
}
