#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIY "小元宝" NOR, ({ "yuan bao", "bao"}) );
	set_weight(200);
      set("suit_point", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "吃掉加500元宝。\n");
                set("value", 10000);
		set("unit", "颗");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N嘴巴微张，吃了个" + this_object()->name() +
                       "。\n", me);
        if (me->query("combat_exp") < 1)
        {
                message_vision("$N眨眨眼。\n", me);
                tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
        return 0;
        } 
	
        if (me->query("combat_exp") > 1)
        {
				me->add("xy_money", 25000);
                 write("\n "+HIR+"恭喜你："+NOR+HIG+"获得25000元宝 "+NOR);
        }else
        {
                tell_object(me, "不过你觉得好像没什么作用。\n");
        }
	me->start_busy(random(5) + 5);
        destruct(this_object());
	return 1;
}
