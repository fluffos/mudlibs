// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "小周天经脉通脉丹-任外脉" NOR, ({ "h1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通小周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/任外脉/tongren h1", 1, me);
  me->set("jingmai/任外脉/tongren h2", 1, me);
  me->set("jingmai/任外脉/tongren h3", 1, me);
  me->set("jingmai/任外脉/tongren h4", 1, me);
  me->set("jingmai/任外脉/tongren h5", 1, me);
  me->set("jingmai/任外脉/tongren h6", 1, me);
  me->set("jingmai/任外脉/tongren h7", 1, me);
  me->set("jingmai/任外脉/tongren h8", 1, me);
  me->set("jingmai/任外脉/tongren h9", 1, me);
  me->set("jingmai/任外脉/tongren h10", 1, me);
  me->set("jingmai/任外脉/tongren h11", 1, me);
  me->set("jingmai/任外脉/tongren h12", 1, me);
  me->set("jingmai/任外脉/tongren h13", 1, me);
  me->set("jingmai/任外脉/tongren h14", 1, me);
  me->set("jingmai/任外脉/tongren h15", 1, me);
  me->set("jingmai/任外脉/tongren h16", 1, me);
  me->set("jingmai/任外脉/tongren h17", 1, me);
  me->set("jingmai/任外脉/tongren h18", 1, me);
  me->set("jingmai/任外脉/tongren h19", 1, me);
  me->set("jingmai/任外脉/tongren h20", 1, me);
  me->set("jingmai/任外脉/tongren h21", 1, me);
  me->set("jingmai/任外脉/tongren h22", 1, me);
  me->set("jingmai/任外脉/tongren h23", 1, me);
  me->set("jingmai/任外脉/tongren h24", 1, me);
  me->set("jingmai/任外脉/chongxue_ok", 1, me);
  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
