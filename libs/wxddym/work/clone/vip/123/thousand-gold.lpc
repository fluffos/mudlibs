// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(YEL "五百两金票" NOR, ({ "thousand-gold", "thousand-gold_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-gold");
    set("long", "一张面额值五百两金子的金票。\n");
    set("unit", "叠");
    set("base_value", 5000000);
    set("xy_money", 100);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("base_unit", "张");
    set("base_weight", 1);
  }
  set_amount(1);
}
