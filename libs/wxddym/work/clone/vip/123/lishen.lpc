// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "一级力量" NOR, ({ "shenli wan", "wan"}) );
        set_weight(200);
		set("suit_point", 1000);
		set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗圆圆的神力丸，据说吃了可以提升力量1点最高10点\n");
                set("xy_money", 50);
						set("no_drop", "这样东西不能离开你。\n");
                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);
        if (me->query("gift/shenliwan") >= 10 ||
	    me->query("gift/str/succeed") >= 10)
        {
                message_vision("$N眨眨眼。\n", me);
                tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
        } else
   if (random(100) > 30)
        {
                
                tell_object(me, "你觉得浑身发热，略有提升，不过你觉得好像还重差把劲。\n");
        } else
        {
                tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
                me->add("str", 1);
                me->add("gift/str/succeed", 1);
				   me->add("gift/shenliwan", 1);
        }

        
             
        destruct(this_object());
        return 1;
}

