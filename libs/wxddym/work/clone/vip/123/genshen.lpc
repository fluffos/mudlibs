// xisuidan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(YEL "一级根骨" NOR, ({ "shen dan", "dan", "xisuidan" }));
  set_weight(200);
  set("suit_point", 1000);
  set("no_drop", "这样东西不能离开你。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗黑不溜秋的丹药，提升根骨1点最高10点。\n");
    set("xy_money", 50);
    set("no_drop", "这样东西不能离开你。\n");
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (me->query("gift/xisuidan") >= 10 ||
    me->query("gift/con/succeed") >= 10) {
    message_vision("$N突然放了一个奇臭无比的响屁。\n", me);
    tell_object(me, "你觉得大概是吃坏了肚子。\n");
  } else if (random(100) > 30) {

    tell_object(me, "你觉得浑身发热，根骨略有提升，不过你觉得好像还重差把劲。\n");
  } else {
    message("vision", "你似乎听见" + me->name() + "的骨头哗啦啦的响。\n",
      environment(me), ({ me }));
    tell_object(me, HIY "你浑身的骨骼登时哗啦啦的响个不停，可把你吓坏了，"
      "好在一会儿就停了下来，似乎筋骨更灵活了。\n" NOR);
    me->add("gift/con/succeed", 1);
    me->add("con", 1);
    me->add("gift/xisuidan", 1);
  }



  destruct(this_object());
  return 1;
}
