// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "一级悟性丹" NOR, ({ "xian dan", "dan", "xiandan" }) );
        set_weight(200);
		set("suit_point", 1000);
		set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗园园的仙丹，据说吃了可以提升悟性1点最高10点\n");
                set("xy_money", 50);
						set("no_drop", "这样东西不能离开你。\n");
                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);
        if (me->query("gift/xiandan") >= 10 ||
            me->query("gift/int/succeed") >= 10)
        {
                message_vision("$N忽然“哇哇”，吐了一地。\n", me);
                tell_object(me, "你觉得嘴里非常的苦。\n");
        } else
   if (random(100) > 30)
        {
                
                tell_object(me, "你觉得浑身发热，略有提升，不过你觉得好像还重差把劲。\n");
        } else
        {
                tell_object(me, HIG "一股火热蓦然从脑中升起，"
                            "你头痛欲裂，恰在此时一股清凉之意"
                            "油然而起，顿感舒泰无比。\n");
                me->add("int", 1);
                me->add("gift/int/succeed", 1);
				me->add("gift/xiandan", 1);
        }

       
                
        destruct(this_object());
        return 1;
}

