
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(CYN "先天灵宝" NOR, ({ "w1box" }) );
        set_weight(1);
	  set("xian_point",1000);
	  set("xy_money", 100);
	  set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是10%失败的"+this_object()->query("name")+",\n"ZJURL("cmds:open w1box")ZJSIZE(15)"打开"NOR"看看!\n");
                set("unit", "个");                
        }
        setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{

        object me, ob;
        int exp, qn;
        string sob, msg;
        string *gifts =({
		"/clone/vip/2dan/jiangli2dan/g2",
		"/clone/vip/2dan/jiangli2dan/l2",
		"/clone/vip/2dan/jiangli2dan/s2",
		"/clone/vip/2dan/jiangli2dan/z2",                                            
        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        if (random(100) < 10)
        {                
                write(HIC"你打开包裹一看，得到了潜能 "HIY"一万五。\n");
				
				me->add("potential", 500);
                destruct(this_object());
                return 1;
        }

        // 获取一些奖励
        exp = 1;
        qn = 500;

        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
             //   msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
                msg = HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
                tell_object(me, msg);
                ob->move(me, 1);
                me->add("combat_exp", exp);
                me->add("potential", qn);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}