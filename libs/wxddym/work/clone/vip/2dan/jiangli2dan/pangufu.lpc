// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIR"盘古斧"NOR,({"盘古斧"}));
	set_weight(1);

	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"这是一个装着盘古斧的宝箱，5分之一的几率开出盘古斧"ZJURL("cmds:打开 盘古斧")ZJSIZE(15)"打开"NOR"看看!\n");
	   set("no_give", 1);
	   set("no_drop", 1);
	   set("no_sell", 1);
	   set("no_steal", 1);
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","打开 盘古斧",1);
}
//打开宝箱的函数
int do_openbox()
{
   object me, ob;
        int exp, qn;
        string sob, msg;
        string *gifts =({
		"/adm/etc/magic_item/pangufu",
        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        if (random(5) > 1)
        {                
                write(HIC"你打开包裹一看，得到了潜能 "HIY"一万五。\n");
				
				me->add("potential", 500);
                destruct(this_object());
                return 1;
        }

        // 获取一些奖励
        exp = 1;
        qn = 500;

        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
             //   msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
                msg = HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
                tell_object(me, msg);
                ob->move(me, 1);
                me->add("combat_exp", exp);
                me->add("potential", qn);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}