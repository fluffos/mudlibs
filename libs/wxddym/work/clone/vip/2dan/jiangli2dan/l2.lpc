// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "二级力" NOR, ({ "wan1"}) );
        set_weight(200);
		set("suit_point", 3000);
		set("no_drop", "这样东西不能离开你。\n");
		set("no_give", "这样东西不能离开你。\n");
		set("no_sunwenshitiancai", "趁热吃啦。\n");
		set("no_get", "趁热吃啦。\n");
		set("no_put", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "趁热赶快吃掉"ZJURL("cmds:eat wan1")+ZJSIZE(20)+"飞身抢夺\n");
                set("xy_money", 1);

                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);
        if (me->query("gift/shenliwan") >= 20 ||
	    me->query("gift/str/succeed") >= 20)
        {
                message_vision("$N眨眨眼。\n", me);
                tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
        } else

        {
                tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
                me->add("str", 1);
                me->add("gift/str/succeed", 1);
				   me->add("gift/shenliwan", 1);
        }

        
             
        destruct(this_object());
        return 1;
}

