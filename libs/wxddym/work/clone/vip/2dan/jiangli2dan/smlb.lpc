// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIW "师门礼包" NOR, ({ "smlb" }));
  set_weight(1);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一个装着先天灵宝和天师护身符的礼包，" ZJURL("cmds:打开 smlb") ZJSIZE(15) "打开" NOR "看看!\n");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("unit", "个");
    set("win_box", 1);
  }
}
void init() {
  if (environment() == this_player())
    add_action("do_openbox", "打开 smlb", 1);
}
//打开宝箱的函数
int do_openbox() {
  object ob;

  object me = this_player();
  if (me->is_busy()) {
    write("你上一个动作未完成！\n"); return 1;
  }
  if (me->is_fighting()) {
    write("先干掉敌人再开不迟。\n"); return 1;
  }

  message_vision(HIM "$N轻轻打开了[" + this_object()->query("name") + "]！" NOR "\n", me);

  ob = new("/clone/vip/2dan/jiangli2dan/lingbao");
  ob->move(me);
  ob = new("/clone/vip/2dan/jiangli2dan/tianshi-charm");
  ob->move(me);
  write(HIG "你得到了一盒先天灵宝，一张天师护身符。 " NOR "\n");
  destruct(this_object());
  return 1;
}
int query_autoload() {
  return 1;
}
