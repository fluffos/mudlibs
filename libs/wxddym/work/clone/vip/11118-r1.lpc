// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "大周天经脉通脉丹-手阳明脉" NOR, ({ "r1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通大周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/手阳明脉/tongren r1", 1, me);
  me->set("jingmai/手阳明脉/tongren r2", 1, me);
  me->set("jingmai/手阳明脉/tongren r3", 1, me);
  me->set("jingmai/手阳明脉/tongren r4", 1, me);
  me->set("jingmai/手阳明脉/tongren r5", 1, me);
  me->set("jingmai/手阳明脉/tongren r6", 1, me);
  me->set("jingmai/手阳明脉/tongren r7", 1, me);
  me->set("jingmai/手阳明脉/tongren r8", 1, me);
  me->set("jingmai/手阳明脉/tongren r9", 1, me);
  me->set("jingmai/手阳明脉/tongren r10", 1, me);
  me->set("jingmai/手阳明脉/tongren r11", 1, me);
  me->set("jingmai/手阳明脉/tongren r12", 1, me);
  me->set("jingmai/手阳明脉/tongren r13", 1, me);
  me->set("jingmai/手阳明脉/tongren r14", 1, me);
  me->set("jingmai/手阳明脉/tongren r15", 1, me);
  me->set("jingmai/手阳明脉/tongren r16", 1, me);
  me->set("jingmai/手阳明脉/tongren r17", 1, me);
  me->set("jingmai/手阳明脉/tongren r18", 1, me);
  me->set("jingmai/手阳明脉/tongren r19", 1, me);
  me->set("jingmai/手阳明脉/chongxue_ok", 1, me);
  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
