#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "天道剑丸" NOR, ({ "tj wan", "wan"}) );
	set_weight(200);
      set("suit_point", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一颗据说吃了可以学会天道剑的丹药。\n");
                set("xy_money", 100);
		set("unit", "颗");
				set("no_get", 1);
				set("no_give", 1);
				set("no_drop", 1);
				set("no_sell", 1);
				set("no_steal", 1);
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);

		if ((int)me->query_skill("yuxiao-jian", 1) < 500)
		{	
				 tell_object(me, "玉箫剑法不足500。\n");
                 return 0;
			
		}
		
		if ((int)me->query_skill("lonely-sword", 1) < 500)
		{	
				 tell_object(me, "独孤九剑剑法不足500。\n");
                 return 0;
			
		}		

		if ((int)me->query_skill("wuzhan-mei", 1) < 500)
		{	
				 tell_object(me, "五展梅剑法不足500。\n");
                 return 0;
			
		}			
		
		
		
	me->delete_skill("yuxiao-jian");
	me->delete_skill("lonely-sword");
	me->delete_skill("wuzhan-mei");
	me->improve_skill("tiandaojian", 15000000);
		
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
			me->improve_skill("tiandaojian", 15000000);
		
		
		
		
		
		
		
		
		
		
		

        destruct(this_object());
	return 1;
}
