#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "天道掌丸" NOR, ({ "tj wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗据说吃了可以学会天道掌法丹药。\n");
    set("xy_money", 100);
    set("unit", "颗");
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);

  if ((int)me->query_skill("chousui-zhang", 1) < 500) {
    tell_object(me, "抽髓掌不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("dragon-strike", 1) < 500) {
    tell_object(me, "十八掌不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("tie-zhang", 1) < 500) {
    tell_object(me, "铁掌掌法不足500。\n");
    return 0;

  }



  me->delete_skill("chousui-zhang");
  me->delete_skill("dragon-strike");
  me->delete_skill("tiezhang-zhangfa");
  me->improve_skill("tiandaozhang", 15000000);













  destruct(this_object());
  return 1;
}
