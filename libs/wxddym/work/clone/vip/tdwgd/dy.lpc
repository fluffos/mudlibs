#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "天道遁一" NOR, ({ "tj wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗据说吃了可以学到天道遁一的丹药。\n");
    set("xy_money", 100);
    set("unit", "颗");
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);

  if ((int)me->query_skill("lingbo-weibu", 1) < 500) {
    tell_object(me, "凌波微步不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("chuanyun-bu", 1) < 500) {
    tell_object(me, "穿云步法不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("yixingbu", 1) < 500) {
    tell_object(me, "意形步法不足500。\n");
    return 0;

  }



  me->delete_skill("lingbo-weibu");
  me->delete_skill("chuanyun-bu");
  me->delete_skill("yixingbu");
  me->improve_skill("tiandao-dunyi", 15000000);













  destruct(this_object());
  return 1;
}
