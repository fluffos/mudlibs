#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "天道圣体" NOR, ({ "tj wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗据说吃了可以学到天道圣体的丹药。\n");
    set("xy_money", 100);
    set("unit", "颗");
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);

  if ((int)me->query_skill("jingang-buhuaiti", 1) < 500) {
    tell_object(me, "金刚不坏体神功不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("douzhuan-xingyi", 1) < 500) {
    tell_object(me, "斗转星移不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("xiantian-gong", 1) < 500) {
    tell_object(me, "先天功不足500。\n");
    return 0;

  }



  me->delete_skill("jingang-buhuaiti");
  me->delete_skill("douzhuan-xingyi");
  me->delete_skill("xiantian-gong");
  me->improve_skill("tiandao-shengti", 15000000);













  destruct(this_object());
  return 1;
}
