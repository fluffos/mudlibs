#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "天道刀丸" NOR, ({ "tj wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗据说吃了可以学会天道神刀丹药。\n");
    set("xy_money", 100);
    set("unit", "颗");
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);

  if ((int)me->query_skill("hujia-daofa", 1) < 500) {
    tell_object(me, "胡家刀法不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("xue-dao", 1) < 500) {
    tell_object(me, "血刀刀法不足500。\n");
    return 0;

  }

  if ((int)me->query_skill("mingyue-blade", 1) < 500) {
    tell_object(me, "天涯明月刀不足500。\n");
    return 0;

  }



  me->delete_skill("xue-dao");
  me->delete_skill("hujia-daofa");
  me->delete_skill("mingyue-blade");
  me->improve_skill("tiandaodao", 15000000);













  destruct(this_object());
  return 1;
}
