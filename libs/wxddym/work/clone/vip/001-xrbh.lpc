// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "新人保护丹" NOR, ({ "dan" }));
  set_weight(200);
  set("suit_point", 5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "赶快吃掉\n");
    set("xy_money", 500);
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (time() - me->query_temp("xrbh") < 10800 || me->query("combat_exp") >= 100000000) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "都说了是新人保护丹了，三小时一颗。\n");
  } else

  {
    tell_object(me, HIR "别浪，别作死。\n" NOR);
    me->deleteset("die_protect/duration");
    me->deleteset("die_protect/last_dead");
    me->set("die_protect/duration", 7200);
    me->set("die_protect/last_dead", 1533742368);
    me->set_temp("xrbh", time());
  }



  destruct(this_object());
  return 1;
}
