// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "经脉补偿" NOR, ({ "tmd", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通大小周天经脉的无上至宝。\n");
    set("xy_money", 100);
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);

    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  int effect;
  mapping my;

  log_file("static/using", sprintf("%s(%s) eat 九转金丹 at %s.\n",
    me->name(1), me->query("id"), ctime(time())));

  effect = 0;
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);


  if (!me->query("jingmai/阴跷脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");

  if (!me->query("jingmai/阳跷脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");

  if (!me->query("jingmai/阴维脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/阳维脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/带脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/冲脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/督外脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/任外脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/经外奇脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手太阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手太阳脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足太阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足太阳脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手少阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手少阳脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足少阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足少阳脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手阳明脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足阳明脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/手厥阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  if (!me->query("jingmai/足厥阴脉/chongxue_ok",))
    return notify_fail("你没有打通全身经脉穴道，无法承受大小周天经脉通脉丹的药力!\n");


  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    "恭喜" + me->name() + "打通了" HIR "全身大小周天经脉" HIM ",功力已如神人。。\n"
  );

  if (me->query("gift/xiandan30") < 1) {
    effect++;
    write(HIM "你觉得自己的头脑更清醒了。" NOR "\n");
    me->add("gift/xiandan30", 1);
    me->add("int", 10);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "服用经脉补偿成功，《先天悟性》增加了！！！ " + NOR);
  }

  if (me->query("gift/unknowdan30") < 1) {
    effect++;
    write(HIR "你觉得自己的腿脚更灵活了。" NOR "\n");
    me->add("gift/unknowdan30", 1);
    me->add("dex", 10);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "服用经脉补偿成功，《先天身法》增加了！！！ " + NOR);
  }

  if (me->query("gift/xisuidan30") < 1) {
    effect++;
    write(HIC "你觉得自己的内息更通畅了。" NOR "\n");
    me->add("gift/xisuidan30", 1);
    me->add("con", 10);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "服用经脉补偿成功，《先天体质》增加了！！！ " + NOR);
  }

  if (me->query("gift/shenliwan30") < 1) {
    effect++;
    write(HIG "你觉得自己的膂力更强健了。" NOR "\n");
    me->add("gift/shenliwan30", 1);
    me->add("str", 10);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "服用经脉补偿成功，《先天臂力》增加了！！！ " + NOR);
  }

  destruct(this_object());
  return 1;
}
