// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG " 天魂丹" NOR, ({  "wan", "tian" }) );
        set_weight(200);
		set("value", 1000000);
		set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗园园的丹丸，吃了后永久提升一倍研究效果，上限十倍，"HIY"每次消耗百万潜力。\n");
                set("xy_money", 500);
                set("unit", "粒");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
                       "。\n", me);
        if (me->query("level")>= 11)
        {
                message_vision("$N忽然“哇哇”，吐了一地。\n", me);
                tell_object(me, "你觉得嘴里非常的苦。\n");
				 return 1;
        } else
        {
                tell_object(me, HIG "你开始发觉你的天魂提升了，研究效率提高一倍。\n" NOR);
                me->add("level", 1);
				me->improve_potential(-33333);
        }

        destruct(this_object());
        return 1;
}

