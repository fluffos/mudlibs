// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "小周天经脉通脉丹-阳维脉" NOR, ({ "d1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通小周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/阳维脉/tongren d1", 1, me);
  me->set("jingmai/阳维脉/tongren d2", 1, me);
  me->set("jingmai/阳维脉/tongren d3", 1, me);
  me->set("jingmai/阳维脉/tongren d4", 1, me);
  me->set("jingmai/阳维脉/tongren d5", 1, me);
  me->set("jingmai/阳维脉/tongren d6", 1, me);
  me->set("jingmai/阳维脉/tongren d7", 1, me);
  me->set("jingmai/阳维脉/tongren d8", 1, me);
  me->set("jingmai/阳维脉/tongren d9", 1, me);
  me->set("jingmai/阳维脉/tongren d10", 1, me);
  me->set("jingmai/阳维脉/tongren d11", 1, me);
  me->set("jingmai/阳维脉/tongren d12", 1, me);
  me->set("jingmai/阳维脉/tongren d13", 1, me);
  me->set("jingmai/阳维脉/tongren d14", 1, me);
  me->set("jingmai/阳维脉/tongren d15", 1, me);
  me->set("jingmai/阳维脉/tongren d16", 1, me);
  me->set("jingmai/阳维脉/tongren d17", 1, me);
  me->set("jingmai/阳维脉/tongren d18", 1, me);
  me->set("jingmai/阳维脉/tongren d19", 1, me);
  me->set("jingmai/阳维脉/tongren d20", 1, me);
  me->set("jingmai/阳维脉/tongren d21", 1, me);
  me->set("jingmai/阳维脉/tongren d22", 1, me);
  me->set("jingmai/阳维脉/tongren d23", 1, me);
  me->set("jingmai/阳维脉/tongren d24", 1, me);
  me->set("jingmai/阳维脉/chongxue_ok", 1, me);

  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
