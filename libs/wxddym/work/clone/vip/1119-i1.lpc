// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "小周天经脉通脉丹-经外奇脉" NOR, ({ "i1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通小周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/经外奇脉/tongren i1", 1, me);
  me->set("jingmai/经外奇脉/tongren i2", 1, me);
  me->set("jingmai/经外奇脉/tongren i3", 1, me);
  me->set("jingmai/经外奇脉/tongren i4", 1, me);
  me->set("jingmai/经外奇脉/tongren i5", 1, me);
  me->set("jingmai/经外奇脉/tongren i6", 1, me);
  me->set("jingmai/经外奇脉/tongren i7", 1, me);
  me->set("jingmai/经外奇脉/tongren i8", 1, me);
  me->set("jingmai/经外奇脉/tongren i9", 1, me);
  me->set("jingmai/经外奇脉/tongren i10", 1, me);
  me->set("jingmai/经外奇脉/tongren i11", 1, me);
  me->set("jingmai/经外奇脉/tongren i12", 1, me);
  me->set("jingmai/经外奇脉/tongren i13", 1, me);
  me->set("jingmai/经外奇脉/tongren i14", 1, me);
  me->set("jingmai/经外奇脉/tongren i15", 1, me);
  me->set("jingmai/经外奇脉/tongren i16", 1, me);
  me->set("jingmai/经外奇脉/tongren i17", 1, me);
  me->set("jingmai/经外奇脉/tongren i18", 1, me);
  me->set("jingmai/经外奇脉/tongren i19", 1, me);
  me->set("jingmai/经外奇脉/tongren i20", 1, me);
  me->set("jingmai/经外奇脉/tongren i21", 1, me);
  me->set("jingmai/经外奇脉/tongren i22", 1, me);
  me->set("jingmai/经外奇脉/tongren i23", 1, me);
  me->set("jingmai/经外奇脉/chongxue_ok", 1, me);
  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
