// This program is a part of NITAN MudLIB

#include <ansi.h>
inherit ITEM;


int do_washto(string arg);

void create()
{
        set_name(HIR "更名卡" NOR, ({"new name", "name"}));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", @LONG
这是这是一张可以换名字的卡,少林与峨嵋不能使用，指令为如 newname 西门大官人。
LONG );
				set("no_get", 1);
				set("no_give", 1);
				set("no_drop", 1);
				set("no_sell", 1);
				set("no_steal", 1);
                set("xy_money", 100);
                set("no_sell", 1);
        }
        setup();
}

void init()
{
        object me = this_player();

        if (me == environment())
                add_action("do_washto", "newname");
}


int do_washto(string arg)
{
        string tmp;
		object me = this_player();

		if (me->query("family/family_name") == "少林派")
            return notify_fail("你可是少林弟子，不能随便乱改。\n");

		if (me->query("family/family_name") == "峨嵋派")
			return notify_fail("你可是峨嵋弟子，不能随便乱改。\n");

        if( !arg )
            return notify_fail("你要取什么名字？\n");

        if( strlen(arg)>30)
			return notify_fail("这个名字太长了，想一个短一点的、响亮一点的。\n");

        me->set("name", arg);
        write("更换名字成功。\n");
        destruct(this_object());
        return 1;
}