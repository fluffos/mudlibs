// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "会员" NOR, ({ "dan", "wan"}) );
        set_weight(200);
	
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗圆圆的神力丸，据说吃了可以提升天魂到11。\n");
                set("xy_money", 1);

                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
                       "。\n", me);

					   
				me->set("gift/str/succeed", 11);
				me->set("gift/shenliwan", 11);
				me->set("gift/dex/succeed", 11);
				me->set("gift/unknowdan", 11);
				me->set("gift/int/succeed", 11);
				me->set("gift/xiandan", 11);
				me->set("gift/con/succeed", 11);
                        me->set("gift/xisuidan", 11);
                        me->add("weiwang",200);
		            me->add("score",200);
		            me->add("xy_money",100);
	 
				me->set("str", 31);
				me->set("dex", 31);
				me->set("int", 31);
				me->set("con", 31);
				me->set("level", 11);
	 
	 
             
        destruct(this_object());
        return 1;
}

