// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "终极会员丹" NOR, ({ "dan", "wan" }));
  set_weight(200);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗圆圆的神力丸，据说吃了可以提升天魂到11。\n");
    set("xy_money", 1);

    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);


  me->set("gift/str/succeed", 20);
  me->set("gift/shenliwan", 20);
  me->set("gift/dex/succeed", 20);
  me->set("gift/unknowdan", 20);
  me->set("gift/int/succeed", 20);
  me->set("gift/xiandan", 20);
  me->set("gift/con/succeed", 20);
  me->set("gift/xisuidan", 20);

  me->set("str", 40);
  me->set("dex", 40);
  me->set("int", 40);
  me->set("con", 40);
  me->set("level", 20);



  destruct(this_object());
  return 1;
}
