// jinchuang.c 金创药

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIY "大周天经脉通脉丹-手太阳脉" NOR, ({ "k1 dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是贯通大周天经脉的无上至宝。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("xy_money", 2500);
    set("value", 200);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  me->set("jingmai/手太阳脉/tongren k1", 1, me);
  me->set("jingmai/手太阳脉/tongren k2", 1, me);
  me->set("jingmai/手太阳脉/tongren k3", 1, me);
  me->set("jingmai/手太阳脉/tongren k4", 1, me);
  me->set("jingmai/手太阳脉/tongren k5", 1, me);
  me->set("jingmai/手太阳脉/tongren k6", 1, me);
  me->set("jingmai/手太阳脉/tongren k7", 1, me);
  me->set("jingmai/手太阳脉/tongren k8", 1, me);
  me->set("jingmai/手太阳脉/tongren k9", 1, me);
  me->set("jingmai/手太阳脉/tongren k10", 1, me);
  me->set("jingmai/手太阳脉/tongren k11", 1, me);
  me->set("jingmai/手太阳脉/tongren k12", 1, me);
  me->set("jingmai/手太阳脉/tongren k13", 1, me);
  me->set("jingmai/手太阳脉/tongren k14", 1, me);
  me->set("jingmai/手太阳脉/tongren k15", 1, me);
  me->set("jingmai/手太阳脉/tongren k16", 1, me);
  me->set("jingmai/手太阳脉/tongren k17", 1, me);
  me->set("jingmai/手太阳脉/tongren k18", 1, me);
  me->set("jingmai/手太阳脉/tongren k19", 1, me);
  me->set("jingmai/手太阳脉/tongren k20", 1, me);
  me->set("jingmai/手太阳脉/chongxue_ok", 1, me);
  message_vision(HBYEL + HIR "$N吃下一颗通脉丹,连忙运用内功控制周身穴道\n", me);
  destruct(this_object());
  return 1;
}
