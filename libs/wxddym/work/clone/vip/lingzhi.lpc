//flowray 2005.6.16
// By Spiderii 放宽每周的使用次数限制
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIC "一年灵芝" NOR, ({ "ling zhi" }));
  set(
    "long",
    "这是一株" HIC "千年灵芝" NOR "，" ZJURL("cmds:fu ling zhi") + ZJSIZE(20) + "服下" NOR "它可以增长内力和精力的修为，可以突破上限。\n"
  );

  set("unit", "株");
  set_weight(100);
  set("value", 30000);
  //        set("no_give",1);

  set("degree", 1);
  set("flag", "spec/lingzhi");
  //	set("rest",10);
  set("desc", "增加一百点内力上限和一些精力上限。");
  set("xy_money", 20);
  setup();
}

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg)
    return notify_fail("你要服用什么?\n");

  if (arg != "ling zhi")
    return notify_fail("你要服用什么?\n");
  if (me->query("max_neili") > 3000) {
    message_vision("$N眨眨眼。\n", me);
    me->start_busy(5);

    tell_object(me, "你实力太高了，自己努力吧。\n");
    return 0;
  }

  if (me->query("max_jingli") > 3000) {
    message_vision("$N眨眨眼。\n", me);
    me->start_busy(5);

    tell_object(me, "你实力太高了，自己努力吧。\n");
    return 0;
  }




  if (me->query("max_neili") > (me->query_skill("force") - me->query_temp("apply/force")) * 10 + me->query("combat_exp") / 1000 + me->query_temp("apply/neili") + me->query("age") * 20)
    return notify_fail("你已经不能继续使用" + this_object()->query("name") + "来提高内力修为了。\n");

  me->add("neili", 100);
  me->add("max_neili", 100);
  me->add("max_jingli", 1 + random(50));
  write(HIY "你服下一株" HIC "千年灵芝" HIY "，顿觉内力、精力大增!" NOR "\n");
  destruct(this_object());
  return 1;
}
