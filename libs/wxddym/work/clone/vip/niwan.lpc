#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "泥丸" NOR, ({ "ni wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一颗济公一个月没洗澡后，从身上搓下来的泥丸。\n");
    set("value", 10000);
    set("xy_money", 100);
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  int shen = me->query("shen");
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (me->query("shen") == shen) {
    me->add("shen", -shen);
    tell_object(me, HIC "\n你获得了" + chinese_number(shen) + "魔气，你现在的声望为0" NOR "\n");
  }
  if (me->query("shen") == -shen) {
    me->add("shen", shen);
    tell_object(me, HIC "\n你获得了" + chinese_number(shen) + "正气,你现在的声望为0" NOR "\n");
  }
  destruct(this_object());
  return 1;
}
