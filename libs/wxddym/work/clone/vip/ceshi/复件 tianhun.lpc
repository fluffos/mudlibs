// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG " 魔鬼契约" NOR, ({  "lei", "mogui" }) );
        set_weight(200);
		set("value", 1000000);
		set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "魔鬼契约每次贩卖十万潜力得到金钱。\n");
                set("xy_money", 500);
                set("unit", "粒");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
                       "。\n", me);
        if (me->query("potential")<= 100000)
        {
                message_vision("$N浑身颤抖。\n", me);
                tell_object(me, "你潜力不够了。\n");
				 return 1;
        } else
        {
                tell_object(me, HIG "你把你的部分潜力卖给了 魔鬼。。\n" NOR);
                me->add("balance", 10000);
				me->improve_potential(-3333);
        }

        destruct(this_object());
        return 1;
}

