#include <ansi.h>
inherit ITEM;

void create() {
  set_name(WHT "番茄炒蛋" NOR, ({ "fanqie caodan", "egg" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一盘番茄炒蛋，吃了似乎对身体状态有所补益。\n");
    set("unit", "盘");
    set("value", 1000);
    set("weight", 70);
    set("only_do_effect", 1);
    set("mixture", ([
      "herb": ([ "cailiao-1": 5, ]),
      "neili": 50,
      "jing": 40,
      "time": 5,
      "min_level": 50,
      "cooking": 50,
    ]));
  }
  setup();
}

int do_effect(object me) {

  int lev = me->query_skill("cooking");
  if (me->query_temp("eat_cai")) {
    me->delete_temp("apply/sword", -lev);
    write("你刚已经吃过东西，现在还不能吃。\n");
  }

  message_vision(WHT "$N" WHT "狼吞虎咽的把" + name() + "吃下了肚子。" NOR "\n", me);
  skill = me->query_skill("force");
  me->add_temp("apply/sword", lev);
  me->set_temp("eat_cai", 1);

  destruct(this_object());

  return 1;
}
