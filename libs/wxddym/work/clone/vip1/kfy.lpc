inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIC "太太口服液" NOR, ({ "太太口服液" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("unit", "瓶");
    set("long", "这是一瓶新开发的太太口服液，" ZJURL("cmds:服用 太太口服液") ZJSIZE(20) "服用" NOR "它之后效果未知。\n");
    set("spectxt", "脱氧核糖核酸\n");
  }
}

void init() {
  if (environment() == this_player())
    add_action("do_use", "服用");
}

int do_use(string arg) {
  object me = this_player();
  object ob1;

  if (arg != "太太口服液")
    return notify_fail("你要服用什么?\n");

  if (me->is_fighting())
    return notify_fail("战斗中吃药,你会被噎死的。\n");

  if (me->query("gender") == "无性")
    return notify_fail("你又不是女子，服用太太口服液干嘛，难道你想成为新一代的女装大佬？\n");

  if (me->query("gender") == "男性")
    return notify_fail("你又不是女子，服用太太口服液干嘛，难道你想成为新一代的女装大佬？\n");

  if (me->query("balance") > 10000) {
    me->add("balance", -10000);
    me->set("neili", 100000);
    write(YEL "你服下" HIC "太太口服液" YEL "，太太口服液，让女人更美丽。!" NOR "\n");
    write(YEL "吃完后你觉得自己更美丽漂亮了，随后又花了一金买了一瓶" NOR "\n");

    return 1;
  } else {
    me->set("neili", 100000);
    write(YEL "你服下" HIC "太太口服液" YEL "，顿觉内力激荡!" NOR "\n");
    destruct(this_object());
    return 1;
  }

  if (random(100) > 10) {
    me->unconcious();
    tell_object(me, "你觉得浑身发热，犹如天神内力上限增加100。\n");
  } else {
    tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
    me->add("str", 1);
    me->add("gift/str/succeed", 1);
    me->add("gift/shenliwan", 1);
  }







}
