inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIC "万艾可" NOR, ({ "万艾可" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("unit", "粒");
    set("long", "这是一粒万艾可，" ZJURL("cmds:服下 万艾可") ZJSIZE(20) "服下" NOR "它之后效果未知。\n");
    set("spectxt", "脱氧核糖核酸\n");
  }
}

void init() {
  if (environment() == this_player())
    add_action("do_use", "服下");
}

int do_use(string arg) {
  object me = this_player();
  object ob1;

  if (arg != "万艾可")
    return notify_fail("你要服用什么?\n");

  if (me->is_fighting())
    return notify_fail("战斗中吃药,你会被噎死的。\n");

  if (me->query("gender") == "无性")
    return notify_fail("你有没有一条，吃这个干嘛。\n");

  if (me->query("gender") == "女性")
    return notify_fail("你有没有一条，吃这个干嘛。\n");


  if (me->query("balance") > 10000) {
    me->add("balance", -10000);
    me->set("neili", 100000);
    write(YEL "你服下" HIC "万艾可" YEL "，万艾可助你重现男性雄风。" NOR "\n");
    write(YEL "吃完后你觉得效果不错随手花了一金又买了一粒" NOR "\n");

    return 1;
  } else {
    me->set("neili", 100000);
    write(YEL "你服下" HIC "万艾可" YEL "，顿觉内力激荡!" NOR "\n");
    destruct(this_object());
    return 1;
  }

  if (random(100) > 10) {
    me->unconcious();
    tell_object(me, "你觉得浑身发热，犹如天神内力上限增加100。\n");
  } else {
    tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
    me->add("str", 1);
    me->add("gift/str/succeed", 1);
    me->add("gift/shenliwan", 1);
  }







}
