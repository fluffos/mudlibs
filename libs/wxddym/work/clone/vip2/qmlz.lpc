#include <ansi.h>;
inherit ITEM;

void create() {
  set_name(HIG "「气脉流转」" NOR, ({ "气脉流转" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("gongji", 200);
    set("no_give", 1);
    set("unit", "本");
    set("material", "paper");
    // set("no_sell", 1);
    set(
      "long",
      HIG "\n这是一本用薄纸写成的书，封皮上写有「气脉流转」。你可以试着" ZJURL("cmds:read 气脉流转") ZJSIZE(15) "读读" NOR "看!\n"
    );
  }

}


void init() {
  add_action("do_du", "read");
}

int do_du(string arg) {
  object me = this_player();
  object where = environment(me);
  string msg;

  if (!arg) {
    write("你要读什么？\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (where->query("no_fight")
    && me->query("doing") != "scheme") {
    write("你无法在这里静下心来研读气脉流转。\n");
    return 1;
  }

  if ((int)me->query_skill("qimai-liuzhuan", 1) < 10) {
    write("你的气脉流转火候太浅。\n");
    return 1;
  }

  if (me->query("family/family_name") != "段氏皇族") {
    write("你看不懂段氏皇族祖传秘籍\n");
    return 1;
  }
  if (!id(arg)) {
    write("这里没有这本书。\n");
    return 1;
  }

  if ((int)me->query("jing") < 100
    || (int)me->query("qi") < 100
    || (int)me->query("neili") < 200) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  msg = HIG "$N" HIG "翻看《气脉流转》，仔细研究上面所记载的各种破招之法，霎那间若有所悟……\n" NOR;
  msg += HIG "$N" HIG "忽而眉头金锁，忽而闭目沉思。\n" NOR;
  msg += HIG "$N" HIG "长叹一声，感慨万千，似乎明白了什么 ……\n" NOR;
  message_vision(msg, me);

  if (me->query_skill("qimai-liuzhuan", 1) < 1800000) {
    write(HIW "你对「" HIG "气脉流转" HIW "」有了新的领悟。\n" NOR);

    if (!me->query_skill("qimai-liuzhuan", 1)) {
      me->set_skill("qimai-liuzhuan", 40 + random(21));
      me->save();
    } else
      me->set_skill("qimai-liuzhuan", me->query_skill("qimai-liuzhuan", 1) + 40 + random(21));

    destruct(this_object());
  } else {
    write(HIR "你的气脉流转级别已经无法再通过研读秘籍来提升了。\n" NOR);
    return 1;
  }

  return 1;
}
