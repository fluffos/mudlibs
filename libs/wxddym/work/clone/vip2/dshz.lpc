#include <ansi.h>
#include <armor.h>

inherit FACE;

void create()
{
        set_name( HIW "段氏皇族" NOR, ({ "段氏皇族" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                        set("gongji", 21000);
				set("no_give", 1);
				set("no_sell", 1);
				set("no_steal", 1);
                set("only_do_effect", 1);
                set("unit", "件");
                 set("long", HIW "这是段氏皇族秘制面具，佩戴后武功大增。\n");
                set("armor_prop/int", 200);
                set("armor_prop/str", 200);
                set("armor_prop/con ", 200);
                set("armor_prop/dex", 200);
                set("armor_prop/damage", 1000);
                set("armor_prop/finger", 1000);
                set("armor_prop/six-finger", 1000);
                set("armor_prop/qimai-liuzhuan", 1000);
                set("material", "face");
        }
        setup();
}

int query_autoload()
{
        return 1;
}
