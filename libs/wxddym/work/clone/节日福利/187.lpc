#include <localtime.h>
#include <ansi.h>
inherit NPC;

//函数声明
int ask_shizhe();

//函数：结构函数
void create() {
  set_name(HIR "圣诞使者" NOR, ({ "JYM shizhe", "shizhe" }));
  set("nickname", HIY "圣诞使者双倍领取" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是圣诞使者，向他打听“圣诞使者双倍领取”，来获得圣诞使者双倍奖励。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "双倍领取": (: ask_shizhe :),
  ]));
  setup();
}

int ask_shizhe() {
  object me = this_player();
  object obj1;

  if (present(
    "anyue dao",
    me
  ) || present(
    "anyue",
    me
  ) || present(
    "dao",
    me
  ) || present("cz yu4", me) || present("cz yu9", me) || present("cz yu24", me)) {
    tell_object(me, "你已经有成长之羽了。\n");
    return 1;
  }

  if (obj1 = new("/clone/vip/anyue-dao")) {
    tell_object(me, HIW "恭喜你，你得到《号令天下》1小时成长之羽。\n" NOR);
    obj1->move(me);
  }
  return 1;

}
