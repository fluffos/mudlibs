inherit NPC;
inherit F_DEALER;

#define CONTRACT        "/d/reborn/obj/contract"
#define ULTRA_QUEST_D   "/adm/daemons/ultra_questd/"

string ask_chushi();
void create() {
  set_name("千古奇人", ({ "qgqr" }));
  set("gender", "男性");
  set("nickname", HIB "千古奇人" NOR);
  set("age", 21);
  set("qi", 10000000);
  set("max_qi", 10000000);
  set("max_neili", 1000000);
  set("neili", 1000000);
  set("combat_exp", 10000000);
  set("int", 3000);
  set("str", 3000);
  set("con", 3000);
  set("dex", 3000);
  set("icon", "01394");
  set("long",
    "可以找他询问出师。\n");
  set_skill("unarmed", 3200);
  set_skill("force", 3200);
  set_skill("finger", 3200);
  set_skill("sword", 3200);
  set_skill("dodge", 3200);
  set_skill("parry", 3200);
  set_skill("six-finger", 3200);
  set_skill("beiming-shengong", 3200);
  set_skill("lingbo-weibu", 3200);
  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingbo-weibu");
  map_skill("finger", "six-finger");
  map_skill("parry", "six-finger");
  set_temp("apply/attack", 6000);
  set_temp("apply/defense", 6000);
  set_temp("apply/armor", 6000);
  set_temp("apply/damage", 6000);

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("exert shield") :),
    (: command("exert powerup") :),
    (: command("perform finger.six") :),
    (: command("perform finger.qi") :),
    (: command("perform finger.zongheng") :),
  }));
  set("startroom", "/d/city/guangchang");
  set("inquiry", ([
    "出师": (: ask_chushi :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

mixed ask_chushi() {
  object ob, me, weapon;
  string map_skill, type;

  me = this_player();

  if (me->query("chushi", 1)) {
    message_vision("$N对$n一拱手，道：你已经出过师了\n",
      this_object(), me);
    return 1;
  }
  if (me->query("betrayer")) {
    message_vision("$N对$n怒道：你还是先把与判师门派中的纠葛解决了再来！\n",
      this_object(), me);
    return 1;
  }

  map_skill = me->query_skill_mapped("force");
  if (me->query_skill("force", 1) < 2000 ||
    me->query_skill(map_skill, 1) < 2000) {
    message_vision("$N对$n一拱手，道：你内功修为尚未大成，出去被人打死，丢尽师门颜面。\n",
      this_object(), me);
    return 1;
  }

  map_skill = me->query_skill_mapped("dodge");
  if (me->query_skill("dodge", 1) < 2000 ||
    me->query_skill(map_skill, 1) < 2000) {
    message_vision("$N对$n一拱手，道：你轻功修为尚未大成，出去被人打死，丢尽师门颜面。。\n",
      this_object(), me);
    return 1;
  }

  map_skill = me->query_skill_mapped("parry");
  if (me->query_skill("parry", 1) < 2000 ||
    me->query_skill(map_skill, 1) < 2000) {
    message_vision("$N对$n一拱手，道：你招架修为尚未大成，出去被人打死，丢尽师门颜面。\n",
      this_object(), me);
    return 1;
  }

  weapon = me->query_temp("weapon");
  if (!objectp(weapon)) weapon = me->query_temp("armor/hands");
  if (!objectp(weapon)) weapon = me->query_temp("armor/finger");
  if (!weapon || me->query("id") != weapon->item_owner()) {
    message_vision("$N对$n一拱手，道：你马上就要成为大佬了，还没有自己的武器，出去不丢人吗？。\n",
      this_object(), me);
    return 1;
  }
  type = query("skill_type", weapon);
  if (type) {
    map_skill = me->query_skill_mapped(type);
    if (!map_skill) {
      message_vision("$N对$n一拱手，道：你必须先激发和你装备的兵器对应的兵器技能。\n",
        this_object(), me);
      return 1;
    }
  } else {
    type = "unarmed";
    map_skill = me->query_skill_mapped(type);
    if (!map_skill) { type = "strike"; map_skill = me->query_skill_mapped(type); }
    if (!map_skill) { type = "hand"; map_skill = me->query_skill_mapped(type); }
    if (!map_skill) { type = "cuff"; map_skill = me->query_skill_mapped(type); }
    if (!map_skill) { type = "finger"; map_skill = me->query_skill_mapped(type); }
    if (!map_skill) { type = "claw"; map_skill = me->query_skill_mapped(type); }
    if (!map_skill) {
      message_vision("$N对$n一拱手，道：你必须先激发和你装备的兵器对应的兵器技能。\n",
        this_object(), me);
      return 1;
    }
  }

  if (me->query_skill(type, 1) < 2000 ||
    me->query_skill(map_skill, 1) < 2000) {
    message_vision("$N对$n一拱手，道：" + to_chinese(map_skill) + "修为尚未大成，出去被人打死，丢尽师门颜面。\n",
      this_object(), me);
    return 1;
  }

  if (!me->query("opinion/ultra")) {
    message_vision("你还没有到大宗师的境界，还是好好在师门学习锻炼吧。\n",
      this_object(), me);
    return 1;
  }

  if (!me->query("breakup")) {
    message_vision("$N对$n一拱手，道：任督二脉都没打通，还想出师，莫要让天下人耻笑你。\n",
      this_object(), me);
    return 1;
  }

  if (!me->query("animaout")) {
    message_vision("$N对$n一拱手，道：元婴出世都未修炼成功，还想出师，莫要让天下人耻笑你。\n",
      this_object(), me);
    return 1;
  }
  if (!me->query("death")) {
    message_vision("$N对$n一拱手，道：生死玄关尚未打通，还想出师，莫要让天下人耻笑你。\n",
      this_object(), me);
    return 1;
  }
  message_vision(CYN "$N叹道：「人间本是百桩磨，既然是有心之士相询，老夫也不藏拙，这物事你便收下吧。」\n" NOR,
    this_object(), me);

  ob = new(CONTRACT);
  ob->move(me);
  me->set("bindable");
  me->set("bind_owner", me->query("id"));
  me->set("owner", me->query("id"));
  me->set("no_store");
  me->set("auto_load");
  me->set("set_data");
  me->set("chushi", 1);

  message_vision(HIC "$N拿出一份阎王契(Contract)给$n。\n" NOR
    CYN "$N续道：「欲成千古宗师，需向五岳山君献祭，你这便前往泰山、华山、衡山、恒山与嵩山一行吧。」\n" NOR,
    this_object(), me);

  message("channel:rumor", HBRED "【天下无双】人间：" + me->query("name") + "(" + me->query("id") + ")"
    HBRED "拿到阎王契，开始前往五岳献祭，欲成千古宗师！\n\n" NOR, users());

  me->set("reborn_offer", "start");
  return 1;
}

int accept_object(object who, object ob) {
  int r;

  /*if (r = ULTRA_QUEST_D->accept_object(this_object(), who, ob))*/
  if (r = ULTRA_QUEST_D->accept_object(this_object(), who, ob))
    return r;

  if (base_name(ob) != CONTRACT ||
    ob->query("owner") != who->query("id"))
    return 0;

  if (sizeof(ob->query("offer")) < 5)
    return notify_fail(CYN "南贤摇摇头道：「五岳献祭未成，为时尚早。」\n" NOR);

  ob->delete("bindable");
  ob->delete("bind_owner");
  ob->call_out("to_return", 1, who);
  return 1;
}

int to_return(object who, object ob) {
  if (!ob || !who) return 0;

  message_vision(CYN "$N点了点头道：「果真是有心人，竟能捱过五岳山君那般挑剔折磨，来，在这里盖个血指印。」\n" NOR
    HIC "$n依从$N指示，咬破拇指，在阎王契上盖上血指印。\n" NOR
    HIM "只见阎王契(Contract)突生紫光，血指印旁凭空现出了$n的名字。\n" NOR
    CYN "$N续道：「速去昆仑之巅寻那昆仑镜，将阎王契投入其中，方可获得肉身入地狱面见阎王之资格。路程险恶，务必小心。」\n" NOR,
    this_object(), who);

  ob->set("name", MAG "阎王契" NOR);
  ob->set_name(MAG "阎王契" NOR, ({ "contract" }));
  set("long", MAG "这是一份阎王契，上面血指印旁有" + who->query_idname() + "的名字。\n" NOR);
  ob->move(who, 1);
  ob->set("bindable", 3);
  ob->set("bind_owner", who->query("id"));
  who->set("reborn_offer", "finish");
  tell_object(who, HIC "南贤将泛紫光的阎王契(Contract)还给你。\n" NOR);

  return 1;
}

void die() {
  object me, ob;

  me = this_object();

  set("eff_qi", 10000000);
  set("qi", 10000000);
  set("eff_jing", 10000000);
  set("jing", 10000000);
  set("neili", 90000000);
  set("max_jingli", 1000000);

  say(me->name() + CYN "说道：我是不死的。\n" NOR);
  return;
}
