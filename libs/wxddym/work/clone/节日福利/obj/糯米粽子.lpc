#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIW "糯米粽子" NOR, ({ "糯米粽子" }) );
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIW "" HIY "这是一个糯米做的粽子。\n" NOR);
                set("value", 5000);
                set("unit", "颗");
                set("only_do_effect", 1);
                set("no_put", 1);
		    set("no_get", 1);
		    set("no_give", 1);
		    set("no_drop", 1);
		    set("no_sell", 1);
		    set("no_steal", 1);

        }
}

int do_effect(object me)
{
        string mapsk;
        int effect;
        int neili;

        log_file("static/using", sprintf("%s(%s) eat 粽子 at %s.\n",
                 me->name(1), me->query("id"), ctime(time())));

        effect = 0;

       	message_vision(HIW "$N" HIW "武学修养增加150级，元宝增加5000\n" NOR, me); 
    	
        me->set_skill("martial-cognize", me->query_skill("martial-cognize", 1) + 150);
        me->add("xy_money", 5000);

        destruct(this_object());
        return 1;
}
