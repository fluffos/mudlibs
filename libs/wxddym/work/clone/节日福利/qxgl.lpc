
inherit NPC;
//inherit F_DEALER;
string ask_clear();
string ask_form(string name);
string ask_aishiyidaoguang();
string ask_baoming();
void create()
{
	set_name("战神", ({"zhanshen"}));
	set("gender", "男性");
	set("nickname", HIB"FFF团孤狼"NOR);
	set("age", 21);
	set("qi",10000000);
	set("max_qi",10000000);
	set("max_neili",1000000);
	set("neili",1000000);
        set("combat_exp", 10000000);
        set("int",3000);
        set("str", 3000);
        set("con", 3000);
        set("dex", 3000);
	set("icon", "01394");
	set("long",
		"七夕还想要福利？感受被我支配的恐惧吧。\n");

        set_skill("unarmed", 3200);
        set_skill("force", 3200);
        set_skill("finger", 3200);
        set_skill("sword", 3200);
        set_skill("dodge", 3200);
        set_skill("parry", 3200);
        set_skill("six-finger", 3200);
        set_skill("beiming-shengong", 3200);
        set_skill("lingbo-weibu", 3200);
	map_skill("force","beiming-shengong");
	map_skill("dodge","lingbo-weibu");
	map_skill("finger","six-finger");
	map_skill("parry","six-finger");
        set_temp("apply/attack", 6000);
        set_temp("apply/defense", 6000);
        set_temp("apply/armor", 6000);
        set_temp("apply/damage", 6000);

        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("exert shield") :),
                (: command("exert powerup") :),
                (: command("perform finger.six") :),
                (: command("perform finger.qi") :),
                (: command("perform finger.zongheng") :),
        }) );
/*
    set("chat_chance", 300);
    set("chat_msg", ({
        "新手员说道: 需要充值会员的可以直接在客户端充值，或找管理员，充值后记得先领取福利再消费哦。\n",
        "新手员说道: 扬州西面可以打擂台，想知道自己的实力不妨去挑战一下。\n",
    }) );
*/
	set("startroom", "/d/city/guangchang");
	set("inquiry", ([
		"「FFF团的怒火」"       : (: ask_aishiyidaoguang :),
	]) );

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}
void init()
{
        object ob=this_object();

        if( interactive (ob) )
        {
        remove_call_out("story_check");
        remove_call_out("check_time");
        }

        if( !ob->query_temp("story_start") )
        {
        call_out("story_check",2);
        ob->set_temp("story_start",1);
        }

        if( !ob->query_temp("check_time") )
        {
        call_out("check_time", 1);
        ob->set_temp("check_time",1);
        }
}

string ask_form(string name)
{
	object me;
	object ob;

	me = this_player();
	if( me->query("xy_money") < 100 )
		return "抱歉，要充值够10元才能来领哦。。";

	if( !me->query("xy_vip"))
	{
		me->set("xy_vip",2);
		write(HIY"\n设置成功。"NOR"\n");
	}
		return HIG+"已经帮您设定了会员福利，以后可以免费吃喝了。"+NOR;


}
string ask_aishiyidaoguang()
{
	object me;
	object ob;

	me = this_player();
       if(!me->query("2018qixi"))
       {
	      me->add("str", 2);
          me->add("con", 2);
          me->add("int", 2);
          me->add("kar", 2);
      ob = new("/clone/节日福利/obj/njs");
	ob->move(me);
	  ob = new("/clone/节日福利/obj/njs");
	ob->move(me);
	  ob = new("/clone/节日福利/obj/njs");
	ob->move(me);
	  ob = new("/clone/节日福利/obj/njs");
	ob->move(me);
	  ob = new("/clone/节日福利/obj/njs");
	ob->move(me);
	me->set("2018qixi",1);
	write(HIY"\n战神一挥手一道火光向你袭来。"NOR"\n");
	write(HIG"\n你被FFF团的火把点着了： 烈火焚烧，你似乎变得更强了 "NOR"\n");
       }
      return HIR+"  还想体验一下，FFF团的怒火吗。"+NOR;
}

string ask_clear()
{
	object me = this_player();
    object obj;
    if (!me->query("reborn/times")  || present("cangku", me))
	{
		command("say 你身上已有随身仓库了,或者你还没转世。");
            return 0;
	}
	if(me->query("reborn/times"))
	{
			obj=new("clone/misc/baibao11");
			obj->move(me);
			
			me->add("level", 1);
			//obj=new("clone/vip/zb/shenhun.lpc");
			//obj->move(me);
			return HIG"转生仓库领取成功。"NOR;;
	}
}

string ask_baoming()
{
	object me;
	object ob;

	me = this_player();
       if(!me->query("dy_vip") && me->query("xy_vip"))
       {
			ob = new("/clone/medicine/baoming");
			ob->move(me);
			me->set("dy_vip",1);
			write(HIY"\n得到一颗天王保命丹。"NOR"\n");
       }
      return HIR+"  一路顺风，谢谢支持。"+NOR;
}
int story_check()
{
        string *story_msg=({}),str;
        int story_msg_len;

        story_msg+= ( {"本服务器免费，赞助可以送会员丹。赞助也是为了组服务器\n"});
        story_msg+= ( {"扬州西面可以打擂台，想知道自己的实力不妨去挑战一下。\n"});
        story_msg+= ( {"发现BUG请报告巫师，隐瞒并利用BUG获利的，给予惩罚，甚至杀档处理。\n" });
        story_msg+= ( {"天下风云出我辈， 一入江湖岁月催。\n" });
        story_msg+= ( {"因自己未考虑清楚做出一些不可挽回的事，导致有所损失的，不予回档。\n" });
        story_msg+= ( {"本服巫师QQ号：23840771，如发现问题请与他联系。\n"});
		story_msg+= ( {"本服务器免费，赞助可以送会员丹。赞助也是为了组服务器\n"});
        story_msg+= ( {"冲穴后增加的气血上限及负重或属性需要安全退出游戏后进入生效。\n"});


        story_msg_len=sizeof(story_msg);
        str=story_msg[random(story_msg_len)];

        message("channel:rumor",sprintf(HIY"\n【广播】：%s\n" NOR, str),users());
        remove_call_out("story_check");
        call_out("story_check",150);
}

void die()
{
	object me, ob;

	me = this_object();

	set("eff_qi", 10000000);
	set("qi", 10000000);
	set("eff_jing", 10000000);
	set("jing", 10000000);
	set("neili", 90000000);
	set("max_jingli",1000000);

	say( me->name() + CYN "说道：我是不死的。\n"NOR);
	return;
}