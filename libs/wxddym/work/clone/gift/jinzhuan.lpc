// jinzhuan.c 金砖

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(YEL "金砖" NOR, ({ "jin zhuan", "jin", "zhuan" }));
	set_weight(2000);
	if (clonep())
		set_default_object(__FILE__);
	else {
                set("long", "一锭黄澄澄的金砖。\n");
                set("value", 2000000);
                set("suit_point",50);
		  set("unit", "锭");
	}
}

