// shengsheng.c

#include <ansi.h>
#include "medicine.h"

void create() {
  set_name(HIR "天魔圣血膏" NOR, ({ "tianmo shengxuegao", "tianmo", "gao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一瓶红色的药膏，具有神奇的疗效。\n");
    set("base_unit", "瓶");
    set("base_value", 100000);
    set("no_sell", 1);
    set("base_weight", 80);
    set("only_do_effect", 10);
    set("mixture", ([
      "herb": ([ "shadan": 5,
        "xiongdan": 5,
        "renshen": 5,
        "dangui": 5 ]),
      "neili": 300,
      "jing": 50,
      "time": 1,
      "min_level": 5,
      "mojiao-medical": 200,
    ]));
  }
  setup();
}

int do_effect(object me) {
  mapping my;

  if (time() - me->query_temp("last_tumo/tianmo shengxuegao") < 40) {
    write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
    return 1;
  }

  me->set_temp("last_tumo/tianmo shengxuegao", time());

  message_vision(HIG "$N" HIG "涂抹完一瓶" + name() +
    HIG "，呼吸吐纳，将膏药效力全数吸收。" NOR "\n", me);
  tell_object(me, HIG "不一会儿你只觉得精神饱满，神气完足，内力充沛之极。" NOR "\n");

  log_file("static/using", sprintf("%s(%s) tumo 天魔圣血膏 tumo %s.\n",
    me->name(1), me->query("id"), ctime(time())));

  my = me->query_entire_dbase();
  my["eff_jing"] = my["max_jing"];
  my["jing"] = my["max_jing"];
  my["eff_qi"] = my["max_qi"];
  my["qi"] = my["max_qi"];
  if (my["jingli"] < my["max_jingli"])
    my["jingli"] = my["max_jingli"];
  if (my["neili"] < my["max_neili"])
    my["neili"] = my["max_neili"];

  me->start_busy(3);

  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
