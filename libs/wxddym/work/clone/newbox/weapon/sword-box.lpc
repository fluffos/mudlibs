			       "/clone/shoufei/weapon/sword/hqj",
			       "/clone/shoufei/weapon/sword/jsword",
			       "/clone/shoufei/weapon/sword/ylj",
			       "/clone/shoufei/weapon/sword/yfz",
			       "/clone/shoufei/weapon/sword/jqr",
			       "/clone/shoufei/weapon/sword/myj",
			       "/clone/shoufei/weapon/sword/xmj",
			       "/clone/shoufei/weapon/sword/lcj",
			       "/clone/shoufei/weapon/sword/qhj",
			       "/clone/shoufei/weapon/sword/jj",
			       "/clone/shoufei/weapon/sword/gj",
			       "/clone/shoufei/weapon/sword/bzzr",
			      "/clone/shoufei/weapon/sword/ckhy",
			      "/clone/shoufei/weapon/sword/mgsh",
			      "/clone/shoufei/weapon/sword/sshen",
			       "/clone/shoufei/weapon/sword/cmjan",
			       "/clone/shoufei/weapon/sword/fmj",
			       "/clone/shoufei/weapon/sword/tmj",
			       "/clone/shoufei/weapon/sword/tmjian",
			       "/clone/shoufei/weapon/sword/xhj",
			       "/clone/shoufei/weapon/sword/jqj",
			       "/clone/shoufei/weapon/sword/cyj",
			       "/clone/shoufei/weapon/sword/phj",
			       "/clone/shoufei/weapon/sword/aqj",
			       "/clone/shoufei/weapon/sword/tlj",
			       "/clone/shoufei/weapon/sword/xwj",
			       "/clone/shoufei/weapon/sword/zyj",
			       "/clone/shoufei/weapon/sword/xsword",
			       "/clone/shoufei/weapon/sword/zysword",
			      "/clone/shoufei/weapon/sword/zxian",
			      "/clone/shoufei/weapon/sword/shun",
			      "/clone/shoufei/weapon/sword/lyun",
			       "/clone/shoufei/weapon/sword/smj",
			       "/clone/shoufei/weapon/sword/hmj",
			       "/clone/shoufei/weapon/sword/lmj",
			       "/clone/shoufei/weapon/sword/hmsword",
			       "/clone/shoufei/weapon/sword/mhj",
			       "/clone/shoufei/weapon/sword/ajsword",
			       "/clone/shoufei/weapon/sword/zyangj",
			       "/clone/shoufei/weapon/sword/lyj",
			       "/clone/shoufei/weapon/sword/shsword",
			       "/clone/shoufei/weapon/sword/ayj",
			       "/clone/shoufei/weapon/sword/xhsword",
			       "/clone/shoufei/weapon/sword/wjsword",
			       "/clone/shoufei/weapon/sword/zhj",
			       "/clone/shoufei/weapon/sword/xtj",
			       "/clone/shoufei/weapon/sword/xqj",
			      "/clone/shoufei/weapon/sword/xysword",
			      "/clone/shoufei/weapon/sword/yhsword",
			      "/clone/shoufei/weapon/sword/qtsword",
			       "/clone/shoufei/weapon/sword/ymj",
			       "/clone/shoufei/weapon/sword/ymsword",
			       "/clone/shoufei/weapon/sword/xmsword",
			       "/clone/shoufei/weapon/sword/mmj",
			       "/clone/shoufei/weapon/sword/chj",
			       "/clone/shoufei/weapon/sword/mjsword",
			       "/clone/shoufei/weapon/sword/cdj",
			       "/clone/shoufei/weapon/sword/cysword",
			       "/clone/shoufei/weapon/sword/hqsword",
			       "/clone/shoufei/weapon/sword/wgj",
			       "/clone/shoufei/weapon/sword/yysword",
			       "/clone/shoufei/weapon/sword/yfsword",
			       "/clone/shoufei/weapon/sword/zxsword",
