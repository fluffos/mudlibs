// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIM"剑类宝箱"NOR,({"boxno11"}));
	set_weight(5000);
       
	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"这是系统奖励的"+this_object()->query("name")+",\n使用(openbox boxno11)"ZJURL("cmds:openbox boxno11")ZJSIZE(15)"打开"NOR"看看!\n");
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","openbox boxno11",1);
}
//打开宝箱的函数
int do_openbox()
{
   int i;
   int num=1;
   string obj=""; 
   object ob;

   string *box=
({
			        "/clone/shoufei/weapon/sword/cmj",
			        "/clone/shoufei/weapon/sword/mj",
			       "/clone/shoufei/weapon/sword/zfj",
			       "/clone/shoufei/weapon/sword/cfj",
