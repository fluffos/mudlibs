// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIM"装备宝箱"NOR,({"mpbox"}));
	set_weight(5000);

	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"里面装着各式各样的装备，能开出什么看你的脸咯，"+this_object()->query("name")+",\n使用(openbox mpbox)"ZJURL("cmds:openbox mpbox")ZJSIZE(15)"打开"NOR"看看!\n");
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","openbox mpbox",1);
}
