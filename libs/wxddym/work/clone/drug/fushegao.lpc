// baihuafushegao.c 百花蝮蛇膏
// ywz 08/31/96

#include <ansi.h>

inherit ITEM;


void create() {
  set_name(RED "百花腹蛇膏" NOR, ({ "fushe gao", "gao" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块百花蝮蛇膏，看上去黑乎乎的，还透着红光，用来对付敌人最好了。\n");
    set("value", 10000);
    set("no_sell", 1);
    set("poison", 1);
    set("only_do_effect", 1);
  }

  setup();
}

int do_effect(object me) {
  message_vision("$N一仰脖，吃死你丫的。\n", me);
  me->set_temp("die_reason", "吃了毒药去见黑白无常了");
  me->die();
  destruct(this_object());
  return 1;
}
