// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;


void create()
{
	set_name(HIG"宝物"NOR, ({"bao wu"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "你挖出来的"ZJURL("cmds:use bao wu")ZJSIZE(15)""HIW"宝物"NOR"，不知道有什么作用。\n");
		set("unit", "个");
		set("value", 50);
		 set("mingjiao", 1);
	}
}
int init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object me = this_player();

	if(arg=="bao wu")
	{
		message_vision(HIW"$N小心翼翼的将宝物打开。\n"NOR, me);
		tell_object(me,HIW"哇，你挖到了一个假的宝物。^_^\n"NOR);
		tell_object(me,HIW"这个宝物没有起到任何作用。\n"NOR);
		destruct(this_object());
	}
	return 1;
}