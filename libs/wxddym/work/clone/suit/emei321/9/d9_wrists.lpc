// d9_wrists.c

#include <ansi.h>
#include <armor.h>

inherit WRISTS;

string do_wear();

void create()
{
	set_name(HBCYN "⑨混元大罗金仙护腕" NOR, ({"d9 wrists"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "这是混元大罗金仙级的护腕\n");
		set("material", "wrists");    //类型
		set("armor_prop/armor", random(5000)+9000);  //防御
		set("value", 10000);   //价值
		set("wear_msg", (: do_wear :));  //装备信息
		  set("suit_point",5);
	//---------------------------------------------------------------
	      //套装参数
		 set("suit",HBCYN"混元大罗金仙"NOR);  //套装名称
		set("suit_lvl",9);	     //套装等级
		set("suit_count",12);	   //套装部件数量
	      //套装各部件
		set("suit_mod/arrmor","⑨混元大罗金仙法袍");
		set("suit_mod/finger","⑨混元大罗金仙戒指");
		set("suit_mod/hands","⑨混元大罗金仙手套");
		set("suit_mod/head","⑨混元大罗金仙头冠");
		set("suit_mod/neck","⑨混元大罗金仙护符");
		set("suit_mod/pants","⑨混元大罗金仙裙甲");
		set("suit_mod/boots","⑨混元大罗金仙靴");
		set("suit_mod/cloth","⑨混元大罗金仙衣");
		set("suit_mod/surcoat","⑨混元大罗金仙披风");
		set("suit_mod/shield","⑨混元大罗金仙护盾");
		set("suit_mod/waist","⑨混元大罗金仙腰带");
		set("suit_mod/wrists","⑨混元大罗金仙护腕");
	    //套装全部附加天赋效果  //身法第一，根骨第二，悟性，臂力
		set("suit_eff/constitution",random(25)+45);      //3件
		set("suit_eff/spirituality",random(25)+45);      // 5件 
		set("suit_eff/intelligence",random(25)+45);      //7件  
		set("suit_eff/strength",random(25)+45);      //9件  
	       //套装全部附加技能效果   
		set("suit_eff_skill/dodge",random(40)+60);   //一套
                set("suit_eff_skill/force",random(40)+60);
                set("suit_eff_skill/parry",random(40)+60);
       //---------------------------------------------------------------
	}
	setup();
}

string do_wear()
{
	object me;
	string msg;
	int per;

	me = this_player();
	per = me->query("per");
	if (me->query("gender") == "女性")
	{
		if (per >= 30)
			msg = HIC "$N" HIC "轻轻将一件$n" HIC "绑在腰上，神态曼妙之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上。\n";
	} else
	{
		if (per >= 30)
			msg = HIC "$N" HIC "随手一挥，将$n" HIC "绑在腰上，姿势潇洒之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，扯了扯衣角，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上，甚是猥琐。\n";
	}
	return msg;
}

int query_autoload()
{
	return 1;
}
