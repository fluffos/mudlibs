// d7_finger.c

#include <ansi.h>
#include <armor.h>

inherit FINGER;

string do_wear();

void create() {
  set_name(HIR "⑦金仙戒指" NOR, ({ "d7 finger" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "这是金仙级的戒指\n");
    set("material", "finger");    //类型
    set("armor_prop/armor", random(2000) + 4000);  //防御
    set("armor_prop/unarmed_damage", random(350) + 350);
    set("value", 10000);   //价值
    set("wear_msg", (: do_wear :));  //装备信息
    set("suit_point", 5);
    //---------------------------------------------------------------
    //套装参数
    set("suit", HIR "金仙" NOR);  //套装名称
    set("suit_lvl", 7);      //套装等级
    set("suit_count", 10);    //套装部件数量
    //套装各部件
    set("suit_mod/arrmor", "⑦金仙法袍");
    set("suit_mod/finger", "⑦金仙戒指");
    set("suit_mod/hands", "⑦金仙手套");
    set("suit_mod/head", "⑦金仙头冠");
    set("suit_mod/neck", "⑦金仙护符");
    set("suit_mod/pants", "⑦金仙裙甲");
    set("suit_mod/boots", "⑦金仙靴");
    set("suit_mod/cloth", "⑦金仙衣");
    set("suit_mod/surcoat", "⑦金仙披风");
    set("suit_mod/shield", "⑦金仙护盾");
    set("suit_mod/waist", "⑦金仙腰带");
    set("suit_mod/wrists", "⑦金仙护腕");
    //套装全部附加天赋效果  //身法第一，根骨第二，悟性，臂力
    set("suit_eff/constitution", random(15) + 25);      //3件
    set("suit_eff/spirituality", random(15) + 25);      // 5件 
    set("suit_eff/intelligence", random(15) + 25);      //7件  
    set("suit_eff/strength", random(15) + 25);      //9件  
    //套装全部附加技能效果   
    set("suit_eff_skill/dodge", random(25) + 40);   //一套
    set("suit_eff_skill/force", random(25) + 40);
    set("suit_eff_skill/parry", random(25) + 40);
    //---------------------------------------------------------------
  }
  setup();
}

string do_wear() {
  object me;
  string msg;
  int per;

  me = this_player();
  per = me->query("per");
  if (me->query("gender") == "女性") {
    if (per >= 30)
      msg = HIC "$N" HIC "轻轻将一件$n" HIC "戴在手上，神态曼妙之极。\n";
    else if (per >= 25)
      msg = HIG "$N" HIG "把$n" HIG "展开，戴在手上。\n";
    else if (per >= 20)
      msg = YEL "$N" YEL "把$n" YEL "戴在手上，缩了缩脖子。\n";
    else msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "戴在手上。\n";
  } else {
    if (per >= 30)
      msg = HIC "$N" HIC "随手一挥，将$n" HIC "戴在手上，姿势潇洒之极。\n";
    else if (per >= 25)
      msg = HIG "$N" HIG "把$n" HIG "展开，戴在手上。\n";
    else if (per >= 20)
      msg = YEL "$N" YEL "把$n" YEL "戴在手上，扯了扯衣角，缩了缩脖子。\n";
    else msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "戴在手上，甚是猥琐。\n";
  }
  return msg;
}

int query_autoload() {
  return 1;
}
