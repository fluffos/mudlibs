// d4_pants.c

#include <ansi.h>
#include <armor.h>

inherit PANTS;

string do_wear();

void create()
{
	set_name(HIG "④天仙裙甲" NOR, ({"d4 pants"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是天仙级的护腿\n");
		set("material", "pants");    //类型
		set("armor_prop/armor", random(800)+800);  //防御
		set("value", 10000);   //价值
		set("material", "crimson gold");  //原料
		set("wear_msg", (: do_wear :));  //装备信息
		  set("suit_point",5);
	//---------------------------------------------------------------
	      //套装参数
		 set("suit",HIG"天仙"NOR);  //套装名称
		set("suit_lvl",4);	     //套装等级
		set("suit_count",10);	   //套装部件数量
	      //套装各部件
		set("suit_mod/arrmor","④天仙法袍");
		set("suit_mod/finger","④天仙戒指");
		set("suit_mod/hands","④天仙手套");
		set("suit_mod/head","④天仙头冠");
		set("suit_mod/neck","④天仙护符");
		set("suit_mod/pants","④天仙裙甲");
		set("suit_mod/boots","④天仙靴");
		set("suit_mod/cloth","④天仙衣");
		set("suit_mod/surcoat","④天仙披风");
		set("suit_mod/shield","④天仙护盾");
		set("suit_mod/waist","④天仙腰带");
		set("suit_mod/wrists","④天仙护腕");
	    //套装全部附加天赋效果  //身法第一，根骨第二，悟性，臂力
		set("suit_eff/constitution",random(10)+10);      //3件
		set("suit_eff/spirituality",random(10)+10);      // 5件 
		set("suit_eff/intelligence",random(10)+10);      //7件  
		set("suit_eff/strength",random(10)+10);      //9件  
	       //套装全部附加技能效果   
		set("suit_eff_skill/dodge",random(15)+20);   //一套
                set("suit_eff_skill/force",random(15)+20);
                set("suit_eff_skill/parry",random(15)+20);					      	  			      	   
       //---------------------------------------------------------------
	}
	setup();
}

string do_wear()
{
	object me;
	string msg;
	int per;

	me = this_player();
	per = me->query("per");
	if (me->query("gender") == "女性")
	{
		if (per >= 30)
			msg = HIC "$N" HIC "轻轻将一件$n" HIC "绑在腰上，神态曼妙之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上。\n";
	} else
	{
		if (per >= 30)
			msg = HIC "$N" HIC "随手一挥，将$n" HIC "绑在腰上，姿势潇洒之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，扯了扯衣角，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上，甚是猥琐。\n";
	}
	return msg;
}

int query_autoload()
{
	return 1;
}
