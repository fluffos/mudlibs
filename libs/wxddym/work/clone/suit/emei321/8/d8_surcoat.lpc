// d8_surcoat.c

#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

string do_wear();

void create()
{
	set_name(HBWHT "⑧大罗金仙披风" NOR, ({"d8 face"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "这是大罗金仙级的面具\n");
		set("material", "surcoat");    //类型
		set("armor_prop/armor", random(3000)+6000);  //防御
		set("value", 10000);   //价值
		set("wear_msg", (: do_wear :));  //装备信息
		  set("suit_point",5);
	//---------------------------------------------------------------
	      //套装参数
		 set("suit",HBWHT"大罗金仙"NOR);  //套装名称
		set("suit_lvl",8);	     //套装等级
		set("suit_count",10);	   //套装部件数量
	      //套装各部件
		set("suit_mod/arrmor","⑧大罗金仙法袍");
		set("suit_mod/finger","⑧大罗金仙戒指");
		set("suit_mod/hands","⑧大罗金仙手套");
		set("suit_mod/head","⑧大罗金仙头冠");
		set("suit_mod/neck","⑧大罗金仙护符");
		set("suit_mod/pants","⑧大罗金仙裙甲");
		set("suit_mod/boots","⑧大罗金仙靴");
		set("suit_mod/cloth","⑧大罗金仙衣");
		set("suit_mod/surcoat","⑧大罗金仙披风");
		set("suit_mod/shield","⑧大罗金仙护盾");
		set("suit_mod/waist","⑧大罗金仙腰带");
		set("suit_mod/wrists","⑧大罗金仙护腕");
	    //套装全部附加天赋效果  //身法第一，根骨第二，悟性，臂力
		set("suit_eff/constitution",random(20)+35);      //3件
		set("suit_eff/spirituality",random(20)+35);      // 5件 
		set("suit_eff/intelligence",random(20)+35);      //7件  
		set("suit_eff/strength",random(20)+35);      //9件  
	       //套装全部附加技能效果   
		set("suit_eff_skill/dodge",random(30)+50);   //一套
                set("suit_eff_skill/force",random(30)+50);
                set("suit_eff_skill/parry",random(30)+50);					      	  				      	   
       //---------------------------------------------------------------
	}
	setup();
}

string do_wear()
{
	object me;
	string msg;
	int per;

	me = this_player();
	per = me->query("per");
	if (me->query("gender") == "女性")
	{
		if (per >= 30)
			msg = HIC "$N" HIC "轻轻将一件$n" HIC "绑在腰上，神态曼妙之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上。\n";
	} else
	{
		if (per >= 30)
			msg = HIC "$N" HIC "随手一挥，将$n" HIC "绑在腰上，姿势潇洒之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，扯了扯衣角，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上，甚是猥琐。\n";
	}
	return msg;
}

int query_autoload()
{
	return 1;
}
