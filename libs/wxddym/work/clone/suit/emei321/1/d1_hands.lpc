// d1_hands.c

#include <ansi.h>
#include <armor.h>

inherit HANDS;

string do_wear();

void create() {
  set_name(HIW "①鬼仙手套" NOR, ({ "d1 hands" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是鬼仙级的手套\n");
    set("material", "neck");    //类型
    set("armor_prop/armor", 1);  //防御
    set("armor_prop/unarmed_damage", 1);
    set("value", 1);   //价值
    set("material", "crimson gold");  //原料
    set("wear_msg", (: do_wear :));  //装备信息
    set("suit_point", 5);
    //---------------------------------------------------------------

    //---------------------------------------------------------------
  }
  setup();
}

string do_wear() {
  object me;
  string msg;
  int per;

  me = this_player();
  per = me->query("per");
  if (me->query("gender") == "女性") {
    if (per >= 30)
      msg = HIC "$N" HIC "轻轻将一件$n" HIC "套在手上，神态曼妙之极。\n";
    else if (per >= 25)
      msg = HIG "$N" HIG "把$n" HIG "展开，套在手上。\n";
    else if (per >= 20)
      msg = YEL "$N" YEL "把$n" YEL "套在手上，缩了缩脖子。\n";
    else msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "套在手上。\n";
  } else {
    if (per >= 30)
      msg = HIC "$N" HIC "随手一挥，将$n" HIC "套在手上，姿势潇洒之极。\n";
    else if (per >= 25)
      msg = HIG "$N" HIG "把$n" HIG "展开，套在手上。\n";
    else if (per >= 20)
      msg = YEL "$N" YEL "把$n" YEL "套在手上，扯了扯衣角，缩了缩脖子。\n";
    else msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "套在手上，甚是猥琐。\n";
  }
  return msg;
}

int query_autoload() {
  return 1;
}
