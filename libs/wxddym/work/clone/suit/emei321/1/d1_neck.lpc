// d1_neck.c

#include <ansi.h>
#include <armor.h>

inherit NECK;

string do_wear();

void create()
{
	set_name(HIW "①鬼仙护符" NOR, ({"d1 neck"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "这是鬼仙级的项链\n");
		set("material", "neck");    //类型
		set("armor_prop/armor", 1);  //防御
	       set("value", 1);   //价值
		 set("material", "crimson gold");  //原料
		set("wear_msg", (: do_wear :));  //装备信息
		  set("suit_point",5);
       //---------------------------------------------------------------
					      	  				     	   
       //---------------------------------------------------------------
	}
	setup();
}

string do_wear()
{
	object me;
	string msg;
	int per;

	me = this_player();
	per = me->query("per");
	if (me->query("gender") == "女性")
	{
		if (per >= 30)
			msg = HIC "$N" HIC "轻轻将一件$n" HIC "挂在胸前，神态曼妙之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，挂在胸前。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "挂在胸前，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "挂在胸前。\n";
	} else
	{
		if (per >= 30)
			msg = HIC "$N" HIC "随手一挥，将$n" HIC "挂在胸前，姿势潇洒之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，挂在胸前。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "挂在胸前，扯了扯衣角，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "挂在胸前，甚是猥琐。\n";
	}
	return msg;
}

int query_autoload()
{
	return 1;
}
