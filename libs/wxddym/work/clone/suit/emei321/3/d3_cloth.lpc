// d3_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

string do_wear();

void create()
{
	set_name(HIC "③地仙衣" NOR, ({"d3 cloths"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "这是地仙级的衣服\n");
		set("material", "cloth");    //类型
		set("armor_prop/armor", random(400)+400);  //防御
		set("value", 10000);   //价值
		set("material", "crimson gold");  //原料
		set("wear_msg", (: do_wear :));  //装备信息
		  set("suit_point",5);
	//---------------------------------------------------------------
	      //套装参数
		 set("suit",HIC"地仙"NOR);  //套装名称
		set("suit_lvl",3);	     //套装等级
		set("suit_count",10);	   //套装部件数量
	      //套装各部件
		set("suit_mod/arrmor","③地仙法袍");
		set("suit_mod/finger","③地仙戒指");
		set("suit_mod/hands","③地仙手套");
		set("suit_mod/head","③地仙头冠");
		set("suit_mod/neck","③地仙护符");
		set("suit_mod/pants","③地仙裙甲");
		set("suit_mod/boots","③地仙靴");
		set("suit_mod/cloth","③地仙衣");
		set("suit_mod/surcoat","③地仙披风");
		set("suit_mod/shield","③地仙护盾");
		set("suit_mod/waist","③地仙腰带");
		set("suit_mod/wrists","③地仙护腕");
	    //套装全部附加天赋效果  //身法第一，根骨第二，悟性，臂力
		set("suit_eff/constitution",random(8)+7);      //3件
		set("suit_eff/spirituality",random(8)+7);      // 5件 
		set("suit_eff/intelligence",random(8)+7);      //7件  
		set("suit_eff/strength",random(8)+7);      //9件  
	       //套装全部附加技能效果   
		set("suit_eff_skill/dodge",random(10)+15);   //一套
                set("suit_eff_skill/force",random(10)+15);
                set("suit_eff_skill/parry",random(10)+15);				      	  				      	   
       //---------------------------------------------------------------
	}
	setup();
}

string do_wear()
{
	object me;
	string msg;
	int per;

	me = this_player();
	per = me->query("per");
	if (me->query("gender") == "女性")
	{
		if (per >= 30)
			msg = HIC "$N" HIC "轻轻将一件$n" HIC "绑在腰上，神态曼妙之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上。\n";
	} else
	{
		if (per >= 30)
			msg = HIC "$N" HIC "随手一挥，将$n" HIC "绑在腰上，姿势潇洒之极。\n";
		else if (per >= 25)
			msg = HIG "$N" HIG "把$n" HIG "展开，绑在腰上。\n";
		else if (per >= 20)
			msg = YEL "$N" YEL "把$n" YEL "绑在腰上，扯了扯衣角，缩了缩脖子。\n";
		else    msg = YEL "$N" YEL "毛手毛脚的把$n" YEL "绑在腰上，甚是猥琐。\n";
	}
	return msg;
}

int query_autoload()
{
	return 1;
}
