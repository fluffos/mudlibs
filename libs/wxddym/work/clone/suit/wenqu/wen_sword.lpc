// wen_sowrd.c

#include <weapon.h>
inherit SWORD;

void create() {
  set_name(HIG "①文曲星剑" NOR, ({ "wen sword" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("icon", "05035");
    set("long", "这是一柄精工制成的" + this_object()->query("name") + "，文曲星剑!\n");
    set("no_drop", "这东西离不开你。\n");
    set("no_put", 1);
    set("no_sell", 1);
    set("no_save", 1);
    set("no_give", 1);
    set("value", 10);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
    //---------------------------------------------------------------
    //套装参数
    set("suit", HIG "文曲星套装" NOR);  //套装名称
    set("suit_lvl", 1);      //套装等级
    set("suit_count", 4);    //套装部件数量
    //套装各部件
    set("suit_mod/cloth", "文曲星长衫");
    set("suit_mod/boots", "文曲星快靴");
    set("suit_mod/pants", "文曲星长裤");
    set("suit_mod/sword", "文曲星剑");
    //套装全部附加天赋效果
    set("suit_eff/strength", 1);      //两件
    //set("suit_eff/courage",1);      // 五件
    set("suit_eff/intelligence", 50);      //三件
    set("suit_eff/spirituality", 1);      //    一套
    // set("suit_eff/composure",1);      //两件
    // set("suit_eff/personality",1);      // 五件
    set("suit_eff/constitution", 1);      //三件
    // set("suit_eff/karma",1);      //    一套
    //套装全部附加技能效果
    set("suit_eff_skill/literate", 100);
    set("suit_eff_skill/force", 10);
    //------------------------------------------------------
  }
  init_sword(35);
  setup();
}
int query_autoload() {
  return 1;
}
