#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "软妹币勋章" NOR, ({ "rmbxz" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "带在身上可以提升研究最大次数一千次，提高五倍研究效率。\n" NOR);
    set("unit", "块");
    set("can_summon", 1);
    set("xy_money", 60000);
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
  }
  setup();
}

int query_autoload() {
  return 1;
}
