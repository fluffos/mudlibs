#include <ansi.h>
#include <armor.h>

inherit FACE;

void create() {
  set_name(HIW "血刀门" NOR, ({ "血刀门" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("gongji", 21000);
    set("mibao", HIR "秘宝" NOR);
    set("no_gei", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
    set("unit", "件");
    set("long", HIW "这是血刀门秘制面具，佩戴后武功大增。\n");
    set("armor_prop/int", 200);
    set("armor_prop/str", 200);
    set("armor_prop/con ", 200);
    set("armor_prop/dex", 200);
    set("armor_prop/damage", 1000);
    set("armor_prop/blade", 1000);
    set("armor_prop/xue-dao", 1000);
    set("armor_prop/xuehai-mogong", 1000);
    set("material", "face");
  }
  setup();
}

int query_autoload() {
  return 1;
}
