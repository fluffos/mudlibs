// chuji_box.c
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIW"胡家套装箱"NOR,({"shimen"}));
	set_weight(1);

	if( clonep() )
		set_default_object(__FILE__);
	else
       {
	    set("long",
		"这是一个装着师门套装的箱子，可以开出师门套装，"ZJURL("cmds:openbox zhuguo")ZJSIZE(15)"打开"NOR"看看!\n");
                        set("gongji", 21000);
				set("no_get", 1);
				set("no_gei", 1);
				set("no_drop", 1);
				set("no_sell", 1);
				set("no_steal", 1);
                set("only_do_effect", 1);
	    set("unit","个");
	    set("win_box",1);
	}
}
void init()
{
    if (environment()==this_player())
    add_action("do_openbox","openbox zhuguo",1);
}
//打开宝箱的函数
int do_openbox()
{
   object ob;

	object me = this_player();
	if (me->is_busy())
	      { write("你上一个动作未完成！\n"); return 1;}
	if( me->is_fighting() )
	      { write("先干掉敌人再开不迟。\n"); return 1;}

	message_vision(HIM"$N轻轻打开了["+this_object()->query("name")+"]！"NOR"\n",me);

		ob = new("/clone/new/menpai/hu/hjy1_arrmor");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_boots");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_finger");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_hands");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_head");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_neck");
		ob->move(me);
		ob = new("/clone/new/menpai/hu/hjy1_pants");
		ob->move(me);		
		write(HIG"你得到了师门套装7件。 "NOR"\n");
    destruct(this_object());
	return 1;
}
int query_autoload()
{
	return 1;
}