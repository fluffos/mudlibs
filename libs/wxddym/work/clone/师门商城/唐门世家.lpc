#include <ansi.h>
#include <armor.h>

inherit FACE;

void create() {
  set_name(HIW "唐门世家" NOR, ({ "唐门世家" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("gongji", 21000);
    set("mibao", HIR "秘宝" NOR);
    set("no_gei", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("only_do_effect", 1);
    set("unit", "件");
    set("long", HIW "这是唐门世家秘制面具，佩戴后武功大增。\n");
    set("armor_prop/int", 200);
    set("armor_prop/str", 200);
    set("armor_prop/con ", 200);
    set("armor_prop/dex", 200);
    set("armor_prop/damage", 1000);
    set("armor_prop/基本暗器", 1000);
    set("armor_prop/唐门暗器", 1000);
    set("armor_prop/暗器百解", 1000);
    set("material", "face");
  }
  setup();
}

int query_autoload() {
  return 1;
}
