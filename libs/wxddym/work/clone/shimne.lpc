// city/npc/angelus.c

inherit NPC;
inherit F_DEALER;
string do_level_up();
void create()
{
	set_name("秘宝转功绩", ({ "shen mi"}));
	set("level_up",1);
	set("gender", "男性");
	set("age", 20);
	set("per", 30);
	set("con", 30);
	set("int", 30);
	set("level", 99);
	set("dex", 30);
	set("str", 30);
	set("long","神秘商人，积分出售一秘宝。\n");
	set_skill("unarmed", 600);
	set_temp("apply/damage", 150);
	set("inquiry", ([
		"宝物": "如果你有我感兴趣的东西我可以给你积分，你也能用你的积分来这里换取宝物",
	]) );
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("duihuan",1);
	set("vendor_goods", ({
		"/d/boss/huan/ouyezi-charm",
		"/clone/vip/2dan/jiangli2dan/z2",
		"/clone/vip/2dan/jiangli2dan/s2",
		"/clone/vip/2dan/jiangli2dan/l2",
		"/clone/vip/2dan/jiangli2dan/g2",	
		"/clone/vip/123/zhishen",
		"/clone/vip/123/shenshen",
		"/clone/vip/123/lishen",
		"/clone/vip/123/genshen",
		
		
		
	}));

	setup();
	carry_object(__DIR__"cloth/cloth")->wear();
}

void init()
{
	add_action("do_level_up","level_up");
	add_action("do_up_skills","up_skills");
	add_action("do_up_tianfu","up_tianfu");
	add_action("do_pointlist", "list");
	add_action("do_huan", "huan");
}
int accept_object(object who, object ob)
{
      int gongji=0;
	if(ob->query("mibao"))
	{
	    gongji=(int)ob->query("gongji");
	    if(gongji != 1)
	    {
	       gongji=gongji;
	    }
	    else
	    {
	       gongji=gongji;
	    }
	    who->add("gongji",gongji);
	    message_vision(HIG"神秘商人对你点点头,这件秘宝我收了,< "+HIM+gongji+HIG+" 功绩 > 已经给你了。"NOR"\n", who);
	    destruct(ob);
	    return 1;
	}
	    command("say 这不是灵石,我不回收！");
	    return 0;
}/*
