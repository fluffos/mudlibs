#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "天仙丹" NOR, ({ "tianxian wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "瞄仙人炼制的浩然丹。\n");
    set("value", 10000);
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);

  if (me->query("shen") < 10000000) {
    me->add("shen", 1000000);
    write("\n " + HIR + "恭喜你：" + NOR + HIG + "浩然正气增加！！！ " + NOR);
  }
  destruct(this_object());
  return 1;
}
