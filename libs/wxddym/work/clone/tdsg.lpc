#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIG "武学总纲" NOR, ({ "tj wan", "wan"}) );
	set_weight(200);
      set("suit_point", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", HIB"武学总纲战气：基本轻功，基本招架，基本拳脚，基本拳法，基本掌法，基本指法，基本手法，基本爪法，基本刀法，基本剑法，基本短兵，基本棒法，基本棍法，基本杖法，基本锤法，基本鞭法。\n");
                set("xy_money", 100);
		set("unit", "颗");
				set("no_get", 1);
				set("no_give", 1);
				set("no_drop", 1);
				set("no_sell", 1);
				set("no_steal", 1);
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision(HIC"$N双目紧闭，思绪渐凝，取天下武功之长，补武学大道之短，武学中艰难晦涩之处顿时烟消云散。良久，你似有所悟，仰天长啸，茅塞顿开。是谓至理：“天下武功，如出一辙，万变不离其宗。”至此，你终于领悟了" + this_object()->name() +
                       "。\n", me);

		if ((int)me->query_skill("tiandaodao", 1) < 500)
		{	
				 tell_object(me, "天道刀不足500。\n");
                 return 0;
			
		}
		
		if ((int)me->query_skill("tiandaojian", 1) < 500)
		{	
				 tell_object(me, "天道剑不足500。\n");
                 return 0;
			
		}		

		if ((int)me->query_skill("tiandaoquan", 1) < 500)
		{	
				 tell_object(me, "天道拳不足500。\n");
                 return 0;
			
		}			
		
			if ((int)me->query_skill("tiandaozhang", 1) < 500)
		{	
				 tell_object(me, "天道掌不足500。\n");
                 return 0;
			
		}	
	if ((int)me->query_skill("tiandao-shengti", 1) < 500)
		{	
				 tell_object(me, "天道圣体不足500。\n");
                 return 0;
			
		}	
	if ((int)me->query_skill("tiandao-dunyi", 1) < 500)
		{	
				 tell_object(me, "天道遁一不足500。\n");
                 return 0;
			
		}	
		
	me->improve_skill("tiandao-shengong");
		
		
		
		
		
		
		
		
		
		
		
		

        destruct(this_object());
	return 1;
}
