#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIW "5潜能丹" NOR, ({ "qianneng" }) );
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIW "" HIY "吃一颗潜力无限。\n" NOR);
                set("value", 5000);
                set("unit", "颗");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        string mapsk;
        int effect;
        int neili;

        log_file("static/using", sprintf("%s(%s) eat 潜能丹 at %s.\n",
                 me->name(1), me->query("id"), ctime(time())));

        effect = 0;

       	message_vision(HIW "$N" HIW "潜能增加一万点\n" NOR, me);


       	me->add("potential", 500000000);

        destruct(this_object());
        return 1;
}
