inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIC "无名精华" NOR, ({ "精华" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("unit", "袋");
    set("long", "这是一袋乳白色液体，" ZJURL("cmds:吞下 精华") ZJSIZE(20) "吞下" NOR "它之后效果未知。\n");
    set("spectxt", "脱氧核糖核酸\n");
  }
}

void init() {
  if (environment() == this_player())
    add_action("do_use", "吞下");
}

int do_use(string arg) {
  object me = this_player();
  object ob1;

  if (arg != "精华")
    return notify_fail("你要服用什么?\n");
  if (me->is_fighting())
    return notify_fail("战斗中吃药,你会被噎死的。\n");

  if (me->query("gender") == "男性")
    return notify_fail("此乃是无名的精华，只能给站在中间的人吃\n");

  if (me->query("gender") == "女性")
    return notify_fail("此乃是无名的精华，只能给站在中间的人吃\n");

  if (me->query("balance") > 10000) {
    me->add("balance", -10000);
    me->set("neili", 100000);
    write(YEL "你服下" HIC "乳白色液体" YEL "，顿觉心神一荡，满面桃红!" NOR "\n");
    write(YEL "吃完后你觉得味道好极了随手花了一金又买了一袋" NOR "\n");

    return 1;
  } else {
    me->set("neili", 100000);
    write(YEL "你服下" HIC "乳白色液体" YEL "，顿觉内力激荡!" NOR "\n");
    destruct(this_object());
    return 1;
  }

  if (random(100) > 10) {
    me->unconcious();
    tell_object(me, "你觉得浑身发热，犹如天神内力上限增加100。\n");
  } else {
    tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
    me->add("str", 1);
    me->add("gift/str/succeed", 1);
    me->add("gift/shenliwan", 1);
  }







}
