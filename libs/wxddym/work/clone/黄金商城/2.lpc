#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "转换" NOR, ({ "zhuanhuan wan", "wan" }));
  set_weight(200);
  set("suit_point", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "唐门，痴心妄想门。\n");
    set("value", 100);
    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  int a, b, c, d, e, f, g, h, i;
  a = me->query_skill("唐门暗器", 1);
  b = me->query_skill("暗器百解", 1);
  c = me->query_skill("痴心鞭法", 1);
  d = me->query_skill("痴心妄想拳", 1);
  e = me->query_skill("镜花水月步", 1);
  f = me->query_skill("妄然心法", 1);
  g = me->query_skill("妄想斧法", 1);
  h = me->query_skill("大爷行行好", 1);
  i = me->query_skill("基本暗器", 1);
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (a > 1) {

    me->set_skill("tangmen-throwing", me->query_skill("tangmen-throwing", 1) + a);
    me->delete_skill("唐门暗器");
    tell_object(me, HIC "\n你获得了" + chinese_number(a) + "级唐门暗器" NOR "\n");
  }
  if (b > 1) {

    me->set_skill("aqbj", me->query_skill("aqbj", 1) + b);
    me->delete_skill("暗器百解");
    tell_object(me, HIC "\n你获得了" + chinese_number(b) + "级暗器百解" NOR "\n");
  }
  if (c > 1) {

    me->set_skill("chixin-bianfa", me->query_skill("chixin-bianfa", 1) + c);
    me->delete_skill("痴心鞭法");
    tell_object(me, HIC "\n你获得了" + chinese_number(c) + "级痴心鞭法" NOR "\n");
  }
  if (d > 1) {

    me->set_skill("cxwx-quan", me->query_skill("cxwx-quan", 1) + d);
    me->delete_skill("痴心妄想拳");
    tell_object(me, HIC "\n你获得了" + chinese_number(d) + "级痴心妄想拳" NOR "\n");
  }
  if (e > 1) {

    me->set_skill("shuiyue", me->query_skill("shuiyue", 1) + e);
    me->delete_skill("镜花水月步");
    tell_object(me, HIC "\n你获得了" + chinese_number(e) + "级镜花水月步" NOR "\n");
  }
  if (f > 1) {

    me->set_skill("wangran-xinfa", me->query_skill("wangran-xinfa", 1) + f);
    me->delete_skill("妄然心法");
    tell_object(me, HIC "\n你获得了" + chinese_number(f) + "级妄然心法" NOR "\n");
  }
  if (g > 1) {

    me->set_skill("wangxiang-fufa", me->query_skill("wangxiang-fufa", 1) + g);
    me->delete_skill("妄想斧法");
    tell_object(me, HIC "\n你获得了" + chinese_number(g) + "级妄想斧法" NOR "\n");
  }
  if (h > 1) {

    me->set_skill("dyxxh", me->query_skill("dyxxh", 1) + h);
    me->delete_skill("大爷行行好");
    tell_object(me, HIC "\n你获得了" + chinese_number(h) + "级大爷行行好" NOR "\n");
  }
  if (i > 1) {

    me->set_skill("throwing", me->query_skill("throwing", 1) + i);
    me->delete_skill("基本暗器");
    tell_object(me, HIC "\n你获得了" + chinese_number(i) + "级基本暗器" NOR "\n");
  }
  destruct(this_object());
  return 1;
}
