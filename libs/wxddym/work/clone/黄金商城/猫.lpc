inherit ITEM;
#include <ansi.h>

void create()
{
	set_name(HIC"狸花猫"NOR, ({"猫"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("value", 10000);
		set("unit", "只");
		set("long","这是一只漂亮可爱的狸花猫，"ZJURL("cmds:吸 猫")ZJSIZE(20)"吸"NOR"它之后效果未知。\n");
		set("spectxt", "狸花猫\n");
	}
}

void init()
{
    if (environment()==this_player())
    	add_action("do_use","吸");
}

int do_use(string arg)
{
	object me=this_player();
	object ob1;

	if (arg!="猫")
      		return notify_fail("你要吸什么?\n");  
		
if (me->is_fighting())
		        return notify_fail("战斗中吃药,你会被噎死的。\n");


if (me->query("balance") >10000)
        {
                me->add("balance", -10000);
               me->set("neili",me->query("max_neili"));
	write(YEL"你吸完"HIC"猫"YEL"，顿感身体虚弱!"NOR"\n");
	write(YEL"吸完猫后你心情不错"NOR"\n");
	
	return 1;
        } else
        {            me->set("neili",100000);
	write(YEL"你服下"HIC"乳白色液体"YEL"，顿觉内力激荡!"NOR"\n");
	destruct(this_object());
		return 1;
        }

   if (random(100) > 10)
        {
                me->unconcious();
                tell_object(me, "你觉得浑身发热，犹如天神内力上限增加100。\n");
        } else
        {
                tell_object(me, HIR "你觉得双臂几乎爆裂，充满了力量。\n" NOR);
                me->add("str", 1);
                me->add("gift/str/succeed", 1);
				   me->add("gift/shenliwan", 1);
        }







}

