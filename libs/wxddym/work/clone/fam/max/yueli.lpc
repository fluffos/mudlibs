#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "阅历丸" NOR, ({ "yueli" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "" HIY "使用一个增加10阅历。\n" NOR);
    set("value", 500);
    set("unit", "个");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  string mapsk;
  int effect;
  int neili;

  log_file("static/using", sprintf("%s(%s) eat 阅历点 at %s.\n",
    me->name(1), me->query("id"), ctime(time())));

  effect = 0;

  message_vision(HIW "$N" HIW "阅历增加10点\n" NOR, me);


  me->add("score", 10);

  destruct(this_object());
  return 1;
}
