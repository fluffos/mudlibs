inherit ITEM;
#include <ansi.h>

void create()
{
	set_name(HIY"白金卡"NOR, ({"bai jin"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("value", 1000000000);
		set("unit", "张");
		set("long","这是一张白金卡，"ZJURL("cmds:duihuan bai jin")ZJSIZE(15)"兑换"NOR"之后可以获得十万两黄金.钱庄存钱超过20万金后会爆掉，大额存款请用卡，卡不可存仓库可能出现无法取的情况,直接进行兑换金子。!\n");
//	       set("rest",1);
		set("spectxt", "钱庄存钱超过20万金后会爆掉，大额存款请用卡，卡不可存仓库，直接进行兑换金子。\n");
	}
}

void init()
{
    if (environment()==this_player())
    	add_action("do_use","duihuan");
}

int do_use(string arg)
{
	object me=this_player();
	object ob1;

	if (arg!="bai jin")
      		return notify_fail("你要兑换什么?\n");  

	write(YEL"你获得了十万两黄金！"NOR"\n");
	ob1 = new("/clone/money/gold");
	ob1->set_amount(100000);
	ob1->move(me);
	destruct(this_object());
	return 1;
}

