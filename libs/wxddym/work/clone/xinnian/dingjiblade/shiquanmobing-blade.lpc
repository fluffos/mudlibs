// king-blade.c 闯王宝刀
// Last Modified by winder on Sep. 7 2001

#include <weapon.h>;
inherit BLADE;
inherit F_UNIQUE;

void create() {
  set_name(MAG "十全魔兵" NOR, ({ "shiquanmobing blade", "shiquanmobing" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", sort_msg(HIR "起源：铁心为了和天晶之主南宫问天再续鸳盟，找到一颗魔珠，并将其殖入问天的右臂以抗拒其左臂中的女娲绿珠。"
      "问天被习得魔兵异能的异魔·牛郎剜心杀死后，牛郎利用悲怒权杖的分离异能从问天身上得到了最后一颗魔珠。"
      "在魔帅的帮助下，牛郎吞下魔珠，并利用大屠杀在收集潜伏在人心中的崩溃情绪，但这远远不及魔珠所要。"
      "魔帅为了取得天晶之主的崩溃情绪，在牛郎不知情的情况下利用其广布神州的分身找到了有复活神能的天神兵凤皇精元和九片银甲，利用两个自以为是嫦娥和吴刚的妖物，为问天重制了凤皇之心，使其复活。"
      "又利用燕王和“神”放出被囚禁在树塔中、自以为神的众妖，在问天面前将这些“神”们一举而歼，极大地打击了问天的精神，使其陷入了深深的崩溃之中。"
      "正在此时假嫦娥和假吴刚出现，被玉灵龙用火焰活活烧死，在临死前二假神现出妖形，令问天起疑，破坏了魔帅的“诸神灭亡之计”，使本在成形的十全魔兵停留在不伦不类的晶体状态。"
      "魔帅便用树藤制造假人，用迷惑异能让牛郎相信自己身中剧毒的爱人——北冥雪已经毒发身亡，连尸体都化为毒气四散。"

      "牛郎的心在瞬间粉碎，呼天抢地，崩溃之情喷薄而出，半成品晶刀迅速成形，但就在些关键时刻，寄生在牛郎体内的异魔与魔帅的对话让牛郎知道了真相，也明白即使天魔复出也不会救治北冥雪，于是不甘被人利用的牛郎在仅存的一点点良知的驱使下将即将成形的晶刀击碎。"

      "这使得魔帅千百年的心血瞬间毁于一旦，其强烈的崩溃情感源源不断地流向粉碎的晶体碎片，碎片散而复聚，抽取牛郎身上的血肉异甲，迅速成形，并使其余九柄魔兵自行兵解，释放魔珠，聚于其上，魔兵之冠的十全魔兵诞生！！\n" NOR));

    set("value", 100000);
    set("material", "steel");
    set("no_sell", "我的天…你…你知道这是啥么？这你也敢拿来卖？");
    set("unique", 1);
    set("rigidity", 500);
    set("replica_ob", "/clone/weapon/blade");
    set("no_put", 1);
    set("no_steal", 1);
    set("wield_msg", HIR "$N[噌]的一声抽出一把十全魔兵，漫天魔气四溢，杀气四溅。\n" NOR);
    set("unwield_msg", HIR "$N把手中的十全魔兵入刀鞘，魔气速散，杀气顿无。\n" NOR);
  }
  init_blade(900);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  victim->receive_damage("jing", me->query("str") * 2, me);
  victim->receive_wound("jing", me->query("str") * 2, me);
  return HIM "十全魔兵带着浓郁的魔气，霎时间$n"
    HIM "被魔气迷昏了头脑。\n" NOR;
}
