
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "新年宝箱" NOR, ({ "bao" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是97%失败的"+this_object()->query("name")+",\n"ZJURL("cmds:open bao1")ZJSIZE(15)"打开"NOR"看看!\n");
		set("no_give", 1);
		set("no_drop", 1);
		set("no_sell", 1);
		set("no_steal", 1);
		set("only_do_effect", 1);
                set("xy_money", 1);
                set("unit", "个");                
        }
        setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{

        object me, ob;
        int exp, qn;
        string sob, msg;
        string *gifts =({
               "/clone/xinnian/chujiwugon/baiyunxinfawan",
               "/clone/xinnian/chujiwugon/fushangneigongwan",
               "/clone/xinnian/chujiwugon/huashanneigongwan",
               "/clone/xinnian/chujiwugon/lingjiuxinfawan",
               "/clone/xinnian/chujiwugon/moshenxinfawan",
               "/clone/xinnian/chujiwugon/riyuexinfawan",
               "/clone/xinnian/chujiwugon/shenlongxinfawan",
               "/clone/xinnian/chujiwugon/songshanxinfawan",
               "/clone/xinnian/chujiwugon/xiyangneigongwan",
               "/clone/xinnian/chujiwugon/jingyixinfawan",
               "/clone/xinnian/chujiwugon/wudangxinfawan",
               "/clone/xinnian/dingjiwugong/anranxiaohunwan",
               "/clone/xinnian/dingjiwugong/badaowan",
               "/clone/xinnian/dingjiwugong/cuixinwan",
               "/clone/xinnian/dingjiwugong/damoshengonwan",
               "/clone/xinnian/dingjiwugong/feixianwan",
               "/clone/xinnian/dingjiwugong/fumoquanwan",
               "/clone/xinnian/dingjiwugong/hanbingzhenqiwan",
               "/clone/xinnian/dingjiwugong/huntainbaojianwan",
               "/clone/xinnian/dingjiwugong/kuihuaxinfawan",
               "/clone/xinnian/dingjiwugong/lianhuanwan",
               "/clone/xinnian/dingjiwugong/tiandaodaowan",
               "/clone/xinnian/dingjiwugong/shexinglifanwan",
               "/clone/xinnian/dingjiwugong/tiandaojianwan",
               "/clone/xinnian/dingjiwugong/tiandaoqingwan",
               "/clone/xinnian/dingjiwugong/tiandaoquanwan",
               "/clone/xinnian/dingjiwugong/tiandaotiwan",
               "/clone/xinnian/dingjiwugong/tiandaozhangwan",
               "/clone/xinnian/dingjiwugong/wuyingwan",
               "/clone/xinnian/dingjiwugong/yijinduanguwan",
               "/clone/xinnian/dingjiwugong/yinyangshiertianwan",
               "/clone/xinnian/dingjiwugong/lunhuiswordwan", 
               "/clone/xinnian/chujibing/green_sword",
               "/clone/xinnian/chujibing/green_water_sword",
               "/clone/xinnian/chujibing/shangpin-sword",
               "/clone/xinnian/chujibing/xiapin-sword",
               "/clone/xinnian/chujibing/zhongpin-sword",
               "/clone/xinnian/dingjibing/chengying_sword",
               "/clone/xinnian/dingjibing/chixiao_sword",
               "/clone/xinnian/dingjibing/chunjun_sword",
               "/clone/xinnian/dingjibing/ganjiang_sword",
               "/clone/xinnian/dingjibing/moye_sword",
               "/clone/xinnian/dingjibing/qixing_sword",
               "/clone/xinnian/dingjibing/taie_sword",
               "/clone/xinnian/dingjibing/yuchang_sword",
               "/clone/xinnian/dingjibing/zhanlu_sword",
               "/clone/xinnian/dingjibing/xuanyuan_sword",
               "/clone/xinnian/chujiblade/daohun-blade",
               "/clone/xinnian/chujiblade/xuanyuan_sword",
               "/clone/xinnian/chujiblade/king-blade",
               "/clone/xinnian/chujiblade/shangpin-blade",
               "/clone/xinnian/chujiblade/xiapin-blade",
               "/clone/xinnian/dingjiblade/daxialongque-blade",
               "/clone/xinnian/dingjiblade/gelu-blade",
               "/clone/xinnian/dingjiblade/hupo-blade",
               "/clone/xinnian/dingjiblade/kunwu-blade",
               "/clone/xinnian/dingjiblade/minghong-blade",
               "/clone/xinnian/dingjiblade/paodingjieniu-blade",
               "/clone/xinnian/dingjiblade/shengqi-blade",
               "/clone/xinnian/dingjiblade/shiquanmobing-blade",
               "/clone/xinnian/dingjiblade/xueyinkuang-blade",
               "/clone/xinnian/dingjiblade/zhufu_blade",
               "/clone/xinnian/dingji/shenling-hand",
               "/clone/xinnian/dingji/chanyi",
               "/clone/xinnian/dingji/liuyin-guimai",
               "/clone/xinnian/dingji/shaqi-chongxiao",
               "/clone/xinnian/dingji/shenmo-jinshen",
               "/clone/xinnian/dingji/tianqing-miqi",
               "/clone/xinnian/dingji/wanmo-futi",
               "/clone/xinnian/dingji/y4_arrmor",                                                  
        });

        me = this_player();

        if (environment(this_object()) != me)return 0;

        if (random(100) < 97)
        {                
                write("你打开包裹一看，里面尽是一些不值钱的东西，随手将之仍在一边。\n");
                destruct(this_object());
                return 1;
        }

        // 获取一些奖励
        exp = 1500;
        qn = 1;

        sob = gifts[random(sizeof(gifts))];

        ob = new(sob);

        if (objectp(ob))
        {
                msg = HIR "\n你获得了 " + chinese_number(exp) + " 点实战经验及 " + chinese_number(qn) + " 点潜能。\n" NOR;
                msg += HIY "你从" + this_object()->name() + HIY "搜出" + ob->name() + HIY "。\n\n" NOR;
                tell_object(me, msg);
                ob->move(me, 1);
                me->add("combat_exp", exp);
                me->add("potential", qn);
        }
        else
        {
                write("物件" + sob + " 错误。\n");
        }

        destruct(this_object());
        return 1;
}

