#include <ansi.h>

int update_condition(object me, int duration)
{
	int dam;
	if (me->query("neili") >= 40000) dam = 5000 + random(10000);
	else if (me->query("neili") > 30000) dam = 5000 + random(20000);
	else if (me->query("neili") > 20000) dam = 5000 + random(50000);
	else if (me->query("neili") > 10000) dam = 5000 + random(100000);
	else if (me->query("neili") > 5000) dam = 5000 + random(250000);
	else dam= 5000 + random(5000);

	me->receive_wound("qi", dam * 2);
	me->receive_wound("jing", dam / 20);
	me->apply_condition("duyan", duration - 1);

	if( duration < 1 )
	tell_object(me, HIW "你中的毒盐终于发作光了！"NOR"\n" );

	else
	tell_object(me, HIW "你中的毒盐发作了！"NOR"\n" );
	if( duration < 1 ) 
	return 0;
	return 1;
}

