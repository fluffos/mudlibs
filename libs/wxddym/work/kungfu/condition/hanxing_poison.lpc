//hanxing_posion.c	by John darks
#include <ansi.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (!living(me)) {
    message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
  } else {
    tell_object(me, HIB "忽然一阵刺骨的奇寒袭来，你中的寒星掌毒发作了！\n" NOR);
    message("vision", me->name() + "的身子突然晃了两晃，牙关格格地响了起来。\n", environment(me), me);
  }
  me->receive_wound("sheng", 15 * random(10));
  me->receive_wound("jing", 20 * random(5));
  me->receive_wound("sheng", 15 * random(10));
  me->apply_condition("hanxing_poison", duration - 1);
  me->add_temp("apply/attack", -(int)(me->query_skill("force") / 10));
  me->add_temp("apply/dodge", -(int)(me->query_skill("force") / 10));
  if (duration < 1) return 0;
  return 1;
}
