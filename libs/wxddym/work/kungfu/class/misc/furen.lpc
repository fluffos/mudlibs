// furen.c 老夫人

#include <ansi.h>

inherit "/inherit/char/punisher";

void create()
{
	set_name("老夫人", ({ "lao furen", "furen" }));
	set("long",  "她看上去年纪已经不小了，不过从眉角中依然可看出当年的风姿。\n");
	set("gender", "女性");
	set("age", 69);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 500);
	set("int", 500);
	set("con", 500);
	set("dex", 500);

	set("max_qi", 6000000);
	set("max_jing", 3000000);
	set("neili", 7500000);
	set("max_neili", 7500000);
	set("jiali", 300);
	set("combat_exp", 2500000);
	set("score", 10000000);

	set_skill("force", 5000);
	set_skill("literate", 5000);
	set_skill("unarmed", 5000);
	set_skill("cuff", 5000);
	set_skill("finger", 5000);
	set_skill("strike", 5000);
	set_skill("hand", 5000);
	set_skill("claw", 5000);
	set_skill("club", 5000);
	set_skill("sword", 5000);
	set_skill("blade", 5000);
	set_skill("staff", 5000);
	set_skill("dodge", 5000);
	set_skill("parry", 5000);
	set_skill("tiandaojian", 5000);
	set_skill("zihui-xinfa", 5000);
	set_skill("douzhuan-xingyi", 5000);
	set_skill("beidou-xianzong", 5000);
	set_skill("canhe-zhi", 5000);
	set_skill("qixing-quan",5000);
	set_skill("murong-sword", 5000);
       set_skill("martial-cognize", 5000);

	map_skill("force", "zihui-xinfa");
	map_skill("dodge", "beidou-xianzong");
	map_skill("cuff",  "qixing-quan");
	map_skill("parry", "douzhuan-xingyi");
	map_skill("finger", "canhe-zhi");
	map_skill("sword", "tiandaojian");

	prepare_skill("finger", "canhe-zhi");
	prepare_skill("cuff", "qixing-quan");

	create_family("慕容世家", 0, "族人");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "sword.tianjian" :),
		(: perform_action, "sword.tianyi" :),
		(: perform_action, "sword.weishe" :),
		(: perform_action, "finger.ci" :),
		(: perform_action, "finger.lan" :),
		(: perform_action, "finger.zhi" :),
		(: exert_function, "recover" :),
	}));

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}
