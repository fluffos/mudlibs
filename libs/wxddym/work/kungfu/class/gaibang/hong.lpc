{
	object me;

	me = this_player();
	if (me->query("can_perform/dragon-strike/xiang"))
		return "你好好练习武功，不要丢我的脸！";

	if (me->query("family/family_name") != query("family/family_name"))
		return "你不是我们丐帮的人，打听我的武功想要干什么？";

	if (me->query_skill("dragon-strike", 1) < 150)
		return "就你这点本事？等你把降龙十八掌练过150级再来找我吧！";

	tell_object(me, HIG "你学会了龙翔九天。"NOR"\n");
