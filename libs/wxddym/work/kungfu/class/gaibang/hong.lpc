{
	object me;

	me = this_player();
	if (me->query("can_perform/dragon-strike/pai"))
		return "你好好练习武功，不要丢我的脸！";

	if (me->query("family/family_name") != query("family/family_name"))
		return "你不是我们丐帮的人，打听我的武功想要干什么？";

	if (me->query_skill("dragon-strike", 1) < 120)
		return "就你这点本事？等你把降龙十八掌练过120级再来找我吧！";

	tell_object(me, HIG "你学会了排山倒海。"NOR"\n");
	me->set("can_perform/dragon-strike/pai", 1);
	return 1;
}
