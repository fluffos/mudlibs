#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW "【太虚】" NOR);
        set("long", HIW @LONG

                 太              虚

    这里是三界之外的太虚之中，四周白茫茫的一片，不见任何事物。

LONG NOR );

       /* set("sleep_room", 1);
        set("sky", 1);
        // 在此演练阴阳九转十二重天
        set("yinyang", 1);
                set("valid_startroom", 1);*/

        set("no_magic", 1);
        set("item_desc", ([
              "【太虚】" : "这里是三界之外的太虚之中，四周白茫茫的一片，不见任何事物。\n"
		ZJOBACTS2+ZJMENUF(3,3,8,30)"跳进去:enter taixu\n",
        ]));
        setup();
}

void init()
{
        object me;
        me = this_player();

        add_action("do_move", "enter");
}

int do_move(string arg)
{
        object paper,
        me = this_player();

        if (! arg || arg == "")
                return 0;

        if (arg == "taixu")
        {
                
                message_vision(HIW "\n$N" HIW "你一纵身，跳进了太虚……\n"
                               NOR, me);
                me->move("/d/city/guangchang");
                message_vision(HIW "\n只见$N" HIW "被太虚抛到空"
                                   "中，然后重重的跌落在扬州广场。\n" NOR, me);
                me->set("neili", 0);
                me->set("jingli", 0);
                me->set("qi", 10);
                me->set("eff_qi", 10);
                me->set("jing", 10);
                me->set("eff_jing", 10);
                tell_object(me, HIR "你被跌得头晕目旋，两耳轰鸣，“哇”的喷出"
                                "一大口鲜血。\n" NOR);
                me->set("taixu",-1);
                tell_object(me, HIC "\n你体内的" NOR + RED "太虚之力" NOR +
                                HIC "消耗一空。\n" NOR);
                return 1;
        }
        return 0;
}
