// pi.c 开天辟地

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

string name() { return HIR "人剑合一" NOR; }
string query_name() { return "人剑"ZJBR"合一"; }

int perform(object me, object target)
{
	object weapon, weapon2;
	int damage, i, n;
	string msg, str;
	int ap, dp;	
    int wait_time;

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}
	if (! target || ! me->is_fighting(target))
		return notify_fail("「人剑合一」只能对战斗中的对手使用。\n");
 
	if (! objectp(weapon = me->query_temp("weapon")) ||
	    weapon->query("skill_type") != "sword")
		return notify_fail("运用「人剑合一」手中必须有剑！\n");
		
	if (me->query_skill("taixu-jianyi", 1) < 500)
		return notify_fail("你的太虚剑意不够娴熟，不会使用「人剑合一」。\n");
		
	        if ((int)me->query_skill("sword", 1)+10 < (int)me->query_skill("taixu-jianyi", 1))
		return notify_fail("你的基本剑法小余太虚剑意，无法使用人剑合一。\n");

	if (me->query_skill("taixu-jianyi", 1) < 500)
		return notify_fail("你的太虚剑意不够娴熟，不会使用「人剑合一」。\n");
				
	if (me->query_skill("force") < 250)
		return notify_fail("你的内功修为不够高。\n");
			
	if (me->query("neili") < 800)
		return notify_fail("你现在内力太弱，不能使用「人剑合一」。\n");

	wait_time = 30 - me->query_skill("taixu-jianyi", 1)/100;
    if (wait_time < 2)
    wait_time = 3;
	if( time()-me->query_temp("last_perform_rjhy")<wait_time )
        return notify_fail("你刚施展过" +  name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");
			
	msg = HIC "$N" HIC "一声长笑，紧握" + weapon->name() +
	      HIC "剑柄，顿时化作一道剑光向$n" HIC "斩去！"NOR"\n";


    ap=me->query_skill("sword")+me->query_skill("force")+me->query_skill("sword-cognize",1)+me->query("str");
    dp = target->query_skill("dodge") + target->query_skill("force") + target->query_skill("martial-cognize", 1);
	if (ap * 4 / 5 + random(ap) > dp)
	{
		damage = ap * 4 + random(ap);
		damage += me->query("jiali")+me->query_skill("sword-cognize",1)+me->query("taoism",1);

		me->add("neili", -(damage / 2));

		if (! objectp(weapon2 = target->query_temp("weapon")))
		{       
			msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 80,
						       HIR "只见$n" HIR "一声惨叫，胸口被$N"
						       "战出一个巨大的口子，鲜血汹涌喷出！"NOR"\n");
		} else
		{
			if (weapon2->is_item_make() || weapon2->query("damage") > 180 ||
			    weapon2->query("skill_type") == "sword")
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
							   HIG "$p" HIG "横过" + weapon2->name() + HIG "试图招架，"
							   HIG "怎奈这剑光如此犀利，透过" + weapon2->name() +
							   HIG "直震得$p" HIG "狂吐鲜血，五脏六腑都要翻转过来！"NOR"\n");
			else
			{
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
							   HIR "$n" HIR "见状不妙，连忙举起" + 
							   weapon2->name() + HIR + "抵挡，在$N" HIR
							   "这人剑合一的招数下，" + weapon2->name() +
							   HIR "给震成碎片！"NOR"\n");
				n = 2 + random(3);
				for (i = 0; i < n; i++)
				{
					msg += (random(2) ? HIB : HIC) + "碎片四散飞溅，射入了$n的身体！"NOR"\n";
	
					target->receive_damage("qi", damage / 7, me);
						target->receive_wound("qi",damage / 15 + random(damage / 15), me);
				}
	
				msg += "\n" + HIY + weapon->name() + HIY "余势未尽，又斩入了$n" + HIY + 
					"的胸口，$n遭此重创，鲜血狂喷而出！"NOR"\n";

				weapon2->set_name("碎裂的" + weapon2->query("name"));
				weapon2->move(environment(target));
				weapon2->set("value", 0);
				weapon2->set("weapon_prop", 0);
			}

			target->reset_action();
			target->receive_damage("qi", damage / 2, me);
					       target->receive_wound("qi",
					       damage / 4 + random(damage / 4), me);


		}
        me->set_temp("last_perform_rjhy", time());;
		target->start_busy(1 + random(2));
	} else 
	{
		msg += HIY "$n" HIY "见势不妙，抽身急退，险险避过$N"
		       HIY "的这记人剑合一，尘土飞扬中，地上被剑光斩出了一道巨大的裂痕！"NOR"\n";
		me->add("neili", -100);
		me->start_busy(3);
	}
	
	message_sort(msg, me, target);

	return 1;
}
