#include <ansi.h>
#include <combat.h>

string name() { return HIR "万剑归宗" NOR; }
string query_name() { return "万剑"ZJBR"归宗"; }
inherit F_SSERVER;

int perform(object me, object target)
{
	    object weapon;
        string msg;
        int i, count;		
		int wait_time;

        if (! target) target = offensive_target(me);

        if (! target || ! me->is_fighting(target))
                return notify_fail(name() + "只能对战斗中的对手使用。\n");

        if ((int)me->query_skill("sword-cognize", 1) < 300)
                return notify_fail("你的剑道修养还不到家，难以施展" + name() + "。\n");
			
		if (! objectp(weapon = me->query_temp("weapon")) ||
	    weapon->query("skill_type") != "sword")
		return notify_fail("运用「万剑归宗」手中必须有剑！\n");
		
        if ((int)me->query_skill("sword", 1)+10 < (int)me->query_skill("taixu-jianyi", 1))
		return notify_fail("你的基本剑法小余太虚剑意，无法使用万剑归宗。\n");

        if ((int)me->query_skill("force") < 100)
                return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");

        if( me->query("max_neili")<100 )
                return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

        if( me->query("neili")<100 )
                return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

		wait_time = 30 - me->query_skill("taixu-jianyi", 1)/100;
        if (wait_time < 2)
        wait_time = 2;
		if( time()-me->query_temp("last_perform_wjgz")<wait_time )
        return notify_fail("你刚施展过" +  name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");
	
      if (me->query_skill_mapped("force") != "taixu-jianyi")
                return notify_fail("需要将太虚剑意激发为内功才能施展。\n");
        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

        msg = WHT "$N" WHT "身形一展，施出太虚剑意绝技「" HIR "万剑归宗" NOR +
              WHT "」，只见身后剑气，蜂拥而至，朝$n" WHT "斩去。\n" NOR;

        message_combatd(msg, me, target);
	me->add("neili", -100);

	count = me->query_skill("sword") + me->query_skill("sword-cognize",1);
	me->add_temp("apply/attack", count);

	for (i = 0; i < 9; i++)
	{
		if (! me->is_fighting(target))
			break;
		COMBAT_D->do_attack(me, target, 0, 0);
	}


	me->add_temp("apply/attack", -count);
    me->set_temp("last_perform_wjgz", time());
	return 1;

}
