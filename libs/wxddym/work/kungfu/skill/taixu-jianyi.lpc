int valid_force(string force)
{
        return 1;
}

int double_attack()
{
        return 1;
}

int valid_enable(string usage)
{
        return usage == "sword" || usage == "parry" || usage == "dodge" || usage == "force";
}

string query_parry_msg(string limb)
{
        return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
        int lvl;
        int i;
        lvl = me->query_skill("taixu-jianyi", 1);
		
        // 与武道三千冲突
        if( me->query_skill("wudao-shanqian",1) )
                return notify_fail("你感觉体内的道佛真气跌宕起伏，全身欲裂。\n");
        if( me->query("str")<150 )
                return notify_fail("你先天臂力不足。\n");

        if( me->query("int")<150 )
                return notify_fail("你先天悟性不足。\n");

        if( me->query("dex")<150 )
                return notify_fail("你先天身法不足。\n");
                
        if( me->query("con")<150 )
                return notify_fail("你先天根骨不足。\n");    
			
        if( me->query("gender") == "无性" )
                return notify_fail("你无根无性，纯阳之力不在，学不会太虚剑意。\n");
			
		if( me->query("level") < 25 && lvl>701 )
                return notify_fail("太虚剑意太过深奥，你眼界太低。\n");
			
		if( me->query("class") == "bonze" )
                return notify_fail("太虚剑意讲究阴阳调合，有违佛家六根清净之意，"
                        + RANK_D->query_respect(me) + "欲修此功，已是罪过。\n");	
		
		if (me->query_skill("taoism", 1) < lvl &&
            me->query_skill("taoism", 1) < 1000)
                return notify_fail("太虚剑意乃是道家神功，你不熟读道家典籍，如何领悟天人合一。\n");		                                                   
                                                                
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action) - 1; i >= 0; i--)
                if (level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        return notify_fail("太虚剑意博大精深，无法简单的通过练习进步。\n");
}

int query_effect_parry(object attacker, object me)
{
        int lvl;

        lvl = me->query_skill("taixu-jianyi", 1);
        if (lvl < 200) return 200;
        if (lvl < 250) return 300;
        if (lvl < 350) return 400;
        return 200;
}

int query_effect_dodge(object attacker, object me)
{
        int lvl;

        lvl = me->query_skill("taixu-jianyi", 1);
        if (lvl < 200) return 100;
        if (lvl < 250) return 150;
        if (lvl < 350) return 180;
        return 200;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

        string *desc;
        object weapon;
        
        weapon=me->query_temp("weapon");
        
        if (! objectp(weapon))return damage_bonus;
        
        desc = ({
                HIW "$N轻描淡写间手中" + weapon->name() + HIW "点出七朵剑花，呈现七星之势笼罩向$n。\n" NOR,
                HIW "$N运起二十二道道真气，以气御剑，道道剑光化做天干地支二十二式地将$n" HIW "笼罩。\n" NOR,
                HIW "$N祭起手中" + weapon->name() + HIW "，煞时晴空万里，曜日当空，$n只觉心中有说不出的难受。\n" NOR,
        });
        
        if (me->is_busy() 
           || random(4) >= 1
           || ! living(victim) 
           || damage_bonus < 120 
           || me->query("neili")<500
           || me->query_skill("taixu-jianyi", 1) < 100) 
                return 0; 

        // 追加特效
        victim->receive_wound("qi", damage_bonus * 4, me);		
        me->add("neili", me->query("jiali") / 3);
        
        if (random(3) == 1)victim->start_busy(3 + random(3));
        
        if( random(10) == 1)victim->add("neili", -1*me->query_skill("taixu-jianyi",1)*2);
        
        return desc[random(sizeof(desc))];
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp, cost;

        if ((int)me->query_skill("taixu-jianyi", 1) < 350
           || me->query_skill_mapped("parry") != "taixu-jianyi"
           || me->query("neili")<200
           || ! living(me))
                return;

        
        cost = damage / 2;
        if (cost > 100) cost = 100;

        ap = ob->query_skill("force", 1) * 4 + ob->query_skill("martial-cognize", 1);
        dp = me->query_skill("taixu-jianyi", 1) * 6 + me->query_skill("martial-cognize", 1);

        if( ob->query("reborn/times") < 4 )dp+=1000;
        
        if (dp + random(dp / 2) >= ap)
        {
                me->add("neili", -cost);
                result = ([ "damage": -damage ]);

                switch (random(6))
                {
                case 0:
                        result += (["msg" : HIC "$n毫不理会$N的攻势，剑意无穷，以攻为守。"
                                            "$N攻势被破，大感惊讶，顿时破绽百出。\n"
                                            "$n剑锋一指，剑招源源而出，对着$N反攻数剑！\n" NOR]);
                        break;
                case 1:
                        result += (["msg" : HIC "$n举剑反攻，后发先至地刺向$N，不仅把"
                                            "$N招术封死，更刺向$N的破绽之处！\n" NOR]);
                        break;
                case 2:
                        result += (["msg" : HIC "$n提剑回刺，落点正是$N的破绽，"
                                            "$N不得不撤招严守，身形一晃间已退出丈许！\n" NOR]);
                        break;
                case 3:
                        result += (["msg" : HIC "却见$n箭步向前，剑式直指$P" HIC
                                            "虎口，招式迅捷无比，使得$N" HIC "闪身而退"
                                            "。\n" NOR]);
                        break;
                case 4:
                        result += (["msg" : HIC "$n突然一剑点向$N" HIC "，虽一剑"
                                            "却暗藏无数后着，$N" HIC "顿时手足无措，攻"
                                            "势不由自主停了下来。\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIC "$n眼见避无可避，尽然力求同归于尽，剑气疾刺$N双眼，"
                                            "居然出乎意料地将$N的攻击止住。\n" NOR]);
                        break;
                }
                return result;
        }
}
string perform_action_file(string action)
{
        return __DIR__"taixu-jianyi/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"taixu-jianyi/exert/" + action;
}

int difficult_level()
{
        return 75000;
}