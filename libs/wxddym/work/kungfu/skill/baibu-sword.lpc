// 百步飞剑(baibu-sword.c)

#include <ansi.h>
inherit SKILL;

int is_invent_skill() { return 1; }

mapping *action = ({
  // ZHAOSHI : 0
  ([ "action": "$N一声长叹，回首旧事，心中一阵凄凉，一招「惊天刀煞」使出，$w发出震天般响声，犹如鬼怪般涌向$n,",
    "attack": 260,
    "damage": 260,
    "force": 260,
    "dodge": 260,
    "parry": 260,
    "lvl": 100,
    "damage_type": "刺伤",
    "skill_name": "纵"
  ]),
  // ZHAOSHI : 1
  ([ "action": "$N冷哼一声，使出鬼谷派纵横剑法中横剑术至高的必杀之剑。$w顿时被$N拋剑前冲，犹如长虹贯日并挟风雷之声。$n顿时被飞剑一刃断喉。",
    "attack": 260,
    "damage": 260,
    "force": 260,
    "dodge": 260,
    "parry": 260,
    "lvl": 110,
    "damage_type": "刺伤",
    "skill_name": "横"
  ]),
  // ZHAOSHI : 2
});

int valid_learn(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练" + "百步飞剑" + "。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("baibu-sword", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

mixed *query_actions() { return action; }

int query_effect_parry(object attacker, object me) {
  int lvl;

  if (me->query_temp("weapon"))
    return 0;

  lvl = me->query_skill("baibu-sword", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("qi") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");

  if ((int)me->query("neili") < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");

  me->receive_damage("qi", 25);
  me->add("neili", -3);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ + "baibu-sword" + "/" + action;
}
