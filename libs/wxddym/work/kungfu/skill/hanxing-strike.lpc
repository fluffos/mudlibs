void skill_improved(object me)  
{ 
        int lvl;
        
        lvl = me->query_skill("hanxing-strike", 1); 

        if( lvl >= 200 && 
            !me->query("can_perform/hanxing-strike/wu") )  
        { 
                tell_object(me, HIW"由於你苦练寒星毒掌，你领悟了绝技五毒锁喉(Perfrom Wudusuohou)。\n" NOR);
                me->set("can_perform/hanxing-strike/wu", 1); 
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
        } 
}

string perform_action_file(string action)
{
	return __DIR__"hanxing-strike/" + action;
}

