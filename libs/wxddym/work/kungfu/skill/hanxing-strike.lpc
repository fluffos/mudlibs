#include <ansi.h>
inherit SKILL;

string *parry_msg = ({
        "$n右掌划出，居然一掌将$N的$w击得荡了开去！\n",
        "$n不退反进，左掌泛绿，一掌向$N脑顶击来，大有同归于尽之势，逼得$N不得不疾退。\n",
        "$n向地上凌空一击，整个人象一片枯叶飞扬起来，堪堪避开$N此招。\n",
});

string *strike_parry_msg = ({
        "$n不退反进，左掌泛绿，一掌向$N脑顶击来，大有同归于尽之势，逼得$N不得不疾退。\n",
        "$n向地上凌空一击，整个人象一片枯叶飞扬起来，堪堪避开$N此招。\n",
        "$n阴阴一笑，突然伸出右手，与$N对了一掌。“坪”的一声，两人各退了一步！\n",
});

mapping *action = ({
([      "action": "$N脸上露出诡异的笑容，隐隐泛出绿色的双掌毫无生息的扫向$n的$l",
        "dodge": 130,
        "force": 440,
        "damage_type": "瘀伤"
]),
([      "action": "$N突然身形旋转起来扑向$n，双掌飞舞着拍向$n的全身大穴",
        "dodge": 70,
        "force": 370,
        "damage_type": "瘀伤"
]),
([      "action": "$N阴阴一笑，突然矮身欺近，毒质运至左手，阴毒无比地抓向$n的下裆",
        "dodge": 50,
        "force": 330,
        "damage_type": "瘀伤"
]),
([      "action": "$N侧身一闪，突然抢入中宫，双掌挟着一股腥臭之气拍向$n的$l",
        "dodge": 60,
        "force": 350,
        "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_learn(object me)
{
        object  corpse = present("corpse",environment());
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练寒星毒掌必须空手。\n");
        if (!corpse || corpse->is_character())
                return notify_fail("附近没有尸体不可以练寒星毒掌！\n");
			
	    if ((int)me->query("max_neili") < 100)
		       return notify_fail("你的内力太弱，无法练寒星毒掌");
		   
		if ((int)me->query_skill("strike", 1) < (int)me->query_skill("hanxing-strike", 1))
		        return notify_fail("你的基本掌法水平有限，无法领会更高深的寒星毒掌。\n");
         return 1;
}
mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
