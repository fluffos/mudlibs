#include <ansi.h>
#include <combat.h>

string name() { return HIR "怀中抱妹杀" NOR; }
string query_name() { return "大蟒"ZJBR"缠身"; }
inherit F_SSERVER;

string finala(object me, object target, int damage);
string finalb(object me, object target, int damage);

int perform(object me, object target)
{
        string msg;
        int ap, dp;
        int damage,damage1;
        int wait_time;

        if (! target) target = offensive_target(me);

        if (! target || ! me->is_fighting(target))
                return notify_fail(name() + "只能对战斗中的对手使用。\n");

        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail(name() + "只能空手施展。\n");

        if ((int)me->query_skill("tsgds", 1) < 220)
                return notify_fail("你贴身格斗术火候不够，难以施展" + name() + "。\n");

        if (me->query_skill_mapped("unarmed") != "tsgds")
                return notify_fail("你没有激发贴身格斗术，难以施展" + name() + "。\n");

        if (me->query_skill_prepared("unarmed") != "tsgds")
                return notify_fail("你没有准备贴身格斗术，难以施展" + name() + "。\n");

        if ((int)me->query_skill("force") < 300)
                return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");

        if( me->query("max_neili")<3500 )
                return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

        if( me->query("neili")<500 )
                return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
			
             wait_time = 30 - me->query_skill("tsgds", 1)/50;
         if (wait_time < 2)
            wait_time = 2;
    	//if( time()-me->query_temp("last_perform_hzbms")<wait_time )
        //       return notify_fail("你刚施展过" +  name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");
	
        msg = HIW "$N" HIW "施出贴身格斗术绝技「" HIR "怀中抱妹杀"
              HIW "」，全身充满真气，正面冲向$n"
              HIW "双臂锁住$n身体，用力绞杀$n。\n" NOR;

	ap = me->query_str() + me->query_con();
	dp = target->query_str() + target->query_con();
             
        if (ap > dp)
        {
                damage = 0;
                damage1 = 0;
                if (ap > dp*10)
                {
                        me->set_temp("last_perform_hzbms", time());
                        me->add("neili", -100);
                        msg += HIR "$n" HIR "连忙抵挡，可惜力气太过弱小，抵抗不住你迸发出来的气力，整个人"
	                    "被你绞杀成一堆肉泥！\n" NOR;
                        damage = -1;
                } else
                {
                        me->add("neili", -100);
	                	damage = ap + random(ap);
                        damage+=me->query("jiali")*2;		
                        damage+=me->query("jianu")*(5+random(10));
                        msg += HIR "结果$p" HIR "闪避不及，只能"
                                                   "连忙抵挡，可惜你的力气太过弱小，无法一击必杀，只对$n照成了一点伤害！\n" NOR;
						message_combatd(msg, me, target); 
                }
			
				if (ap*10 < dp)
                {
                        me->add("neili", -100);
	                	damage = ap + random(ap);
                        damage+=me->query("jiali")*4;		
                        damage+=me->query("jianu")*(10+random(20));
                        msg += HIR "$n" HIR "连忙抵挡，可惜$N力气太过弱小，反而被"
	                    "$n绞杀致死\n" NOR;
                        damage1 = -1;
                }
				
        } else
        {
                        me->add("neili", -100);
	                	damage = dp + random(dp);
                        damage+=target->query("jiali")*4;		
                        damage+=target->query("jianu")*(10+random(20));
                        me->receive_wound("qi", damage, target);
                        msg += HIR "$n" HIR "连忙抵挡，可惜$N力气太过弱小，反而被"
	                    "$n伤到\n" NOR;
        }
        message_combatd(msg, me, target);

        if (damage < 0)
                target->die(me);
			
        if (damage1 < 0)
                me->die(target);
		

        return 1;
}