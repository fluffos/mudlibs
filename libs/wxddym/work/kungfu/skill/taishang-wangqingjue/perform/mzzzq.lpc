// This program is a part of NT MudLIB
// qi.c 命之制在气

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

string name() { return HIG "命之制在气" NOR; }
string query_name() { return "命之制"ZJBR"在气"; }
int perform(object me, object target)
{
        string msg;
	    object weapon;
    	mapping prepare;
    	string type;     
		int wait_time;
        int damage;
        int ap, dp;

        if (! target) target = offensive_target(me);

        if (! target || ! me->is_fighting(target))
                return notify_fail(name() + "只能对战斗中的对手使用。\n");

        if ((int)me->query_skill("taishang-wangqingjue", 1) < 800)
                return notify_fail("你的太上忘情决火候不够，难以施展" + name() + "。\n");

        if ((int)me->query_skill("force") < 500)
                return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");
			
	           prepare = me->query_skill_prepare();
	    if (! sizeof(prepare) || ! stringp(type = keys(prepare)[0]))
		        type = "unarmed";

	    if (me->query_skill_mapped(type) != "taishang-wangqingjue")
	        	return notify_fail("你没有将太上忘情决激发到" + to_chinese(type) + "上，无法以此施展太上忘情决！\n");
				   
        if (me->query_skill_mapped("force") != "taishang-wangqingjue")
                return notify_fail("你现在没有太上忘情决为内功，难以施展" + name() + "。\n");
			
        if (me->query_skill_mapped("finger") != "taishang-wangqingjue")
                return notify_fail("你现在没有激发太上忘情决为指法，难以施展" + name() + "。\n");
			
        if (me->query_skill_prepared("finger") != "taishang-wangqingjue")
                return notify_fail("你现在没有准备使用太上忘情决为指法，难以施展" + name() + "。\n");			
			
        if( me->query("max_neili")<10000 )
                return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

        if( me->query("neili")<500 )
                return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
		wait_time = 30 - me->query_skill("taishang-wangqingjue", 1)/100;
        if (wait_time < 2)
        wait_time = 2;
		if( time()-me->query_temp("last_perform_mzzzq")<wait_time )
        return notify_fail("你刚施展过" +  name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");

                msg = HIY"$N使出太上忘情决最强绝技『命之制在气』，真气急运九大周天，内力汹涌滂湃，\n"
              HIR"刹时间数股炽热刚猛的剑气自指中射出！！无数迅雷疾风相互冲撞激之际，\n"
              HIW"竟然汇集成一束凌厉无匹的剑柱，宛如一条白色巨蟒,闪电般疾射向$n！！！\n"NOR,

        ap=me->query_skill("finger")+me->query_skill("force")+me->query_skill("martial-cognize",1)+me->query("str");
        dp = target->query_skill("dodge") + target->query_skill("force") + target->query_skill("martial-cognize", 1);
        weapon=target->query_temp("weapon");
        if (ap * 4 / 5 + random(ap) > dp)
        {
                damage = ap * 5 + random(ap);
                damage+=me->query("jiali")*10;
                damage+=me->query("jianu")*(10+random(20));
                me->add("neili", -400);				
                me->set_temp("last_perform_mzzzq", time());
                if( !objectp(weapon) || weapon->query("skill_type") == "pin" )
                        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 120,
                                                   HIR "$n" HIR "只觉得胸前一阵剧痛，鲜血"
                                                   "自创口激射而出，眼前顿时一黑！\n" NOR);
                else
                if( weapon->is_item_make() || weapon->query("damage")>180 ||
                    weapon->query("skill_type") == "hammer" )
                        msg += COMBAT_D->do_damage(me, target, REMOTE_ATTACK, damage, 100,
                                                   HIR "$n" HIR "横" + weapon->name() + HIR "试图招架，"
                                                   HIR "怎奈这股剑气如此犀利，透过" + weapon->name() +
                                                   HIR "直震得$n" HIR "狂吐鲜血，五脏六腑都要翻转过来！\n" NOR);
                else
                {
                        msg += COMBAT_D->do_damage(me, target, REMOTE_ATTACK, damage, 80,
                                                   HIR "$n" HIR "横转" + weapon->name() + HIR "，挡在胸"
                                                   "前，只听啪啦一声，" + weapon->name() +
                                                   HIR "碎成数截，激飞上天！\n$n" HIR "连退"
                                                   "几步，“哇”的吐了一口鲜血，脸色变的惨白。\n" NOR);
                        weapon->move(environment(me));
                        weapon->set("no_wield", weapon->name()+"已经碎掉了，没法装备了。\n");
                        weapon->set_name("碎掉的" + weapon->name());
                        weapon->set("value", 0);
                }
        } else
        {
                msg += CYN "可是$p" CYN "内功颇为深厚，轻轻将这道剑气化解于无形。\n" NOR;
        }
        message_combatd(msg, me, target);

        return 1;
}
