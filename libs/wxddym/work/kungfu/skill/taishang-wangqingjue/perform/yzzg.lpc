#include <ansi.h>
#include <combat.h>

string name() { return HIG "用之至公 " NOR; }
string query_name() { return "用之 " ZJBR "至公 "; }
inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  mapping prepare;
  string type;
  int i, count;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("taishang-wangqingjue", 1) < 100)
    return notify_fail("你的太上忘情决火候不够，难以施展" + name() + "。\n");

  if ((int)me->query_skill("force") < 500)
    return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");

  prepare = me->query_skill_prepare();
  if (!sizeof(prepare) || !stringp(type = keys(prepare)[0]))
    type = "unarmed";

  if (me->query_skill_mapped(type) != "taishang-wangqingjue")
    return notify_fail("你没有将太上忘情决激发到" + to_chinese(type) + "上，无法以此施展太上忘情决！\n");

  if (me->query_skill_mapped("force") != "taishang-wangqingjue")
    return notify_fail("你现在没有太上忘情决为内功，难以施展" + name() + "。\n");

  if (me->query_skill_mapped("finger") != "taishang-wangqingjue")
    return notify_fail("你现在没有激发太上忘情决为指法，难以施展" + name() + "。\n");

  if (me->query_skill_prepared("finger") != "taishang-wangqingjue")
    return notify_fail("你现在没有准备使用太上忘情决为指法，难以施展" + name() + "。\n");

  if (me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

  if (me->query("neili") < 500)
    return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");


  msg = HIW "只见$N" HIW "一声轻笑，十指纷弹，剑气如奔，连绵无尽的缕缕剑气豁然贯向$n"
    HIW "！" NOR "\n";

  message_combatd(msg, me, target);
  me->add("neili", -100);

  count = me->query_skill("taishang-wangqingjue") * 2;
  me->add_temp("apply/attack", count);

  for (i = 0; i < 9; i++) {
    if (!me->is_fighting(target))
      break;
    COMBAT_D->do_attack(me, target, 0, 0);
  }


  me->add_temp("apply/attack", -count);
  me->start_busy(1 + random(6));
  return 1;

}
