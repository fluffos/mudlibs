#include <ansi.h>
#include <combat.h>

string name() { return HIR "天之至私" NOR; }
string query_name() { return "天之" ZJBR "至私"; }
inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  mapping prepare;
  string type;
  int level, b;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(name() + "只能空手施展。\n");

  if ((level = (int)me->query_skill("taishang-wangqingjue", 1)) < 100)
    return notify_fail("你的太上忘情决火候不够，难以施展" + name() + "。\n");

  if ((int)me->query_skill("force") < 100)
    return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");

  prepare = me->query_skill_prepare();
  if (!sizeof(prepare) || !stringp(type = keys(prepare)[0]))
    type = "unarmed";

  if (me->query_skill_mapped(type) != "taishang-wangqingjue")
    return notify_fail("你没有将太上忘情决激发到" + to_chinese(type) + "上，无法以此施展太上忘情决！\n");

  if (me->query_skill_mapped("force") != "taishang-wangqingjue")
    return notify_fail("你现在没有太上忘情决为内功，难以施展" + name() + "。\n");

  if (me->query_skill_mapped("finger") != "taishang-wangqingjue")
    return notify_fail("你现在没有激发太上忘情决为指法，难以施展" + name() + "。\n");

  if (me->query_skill_prepared("finger") != "taishang-wangqingjue")
    return notify_fail("你现在没有准备使用太上忘情决为指法，难以施展" + name() + "。\n");

  if (me->query("max_neili") < 100)
    return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

  if (me->query("neili") < 100)
    return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  msg = HIR "$N" HIR "凝聚太上忘情决功力，陡然点出一指，变化多端，巧逼$n"
    HIR "诸处大穴。\n" NOR;


  me->add("neili", -100);
  if (level + random(level) > (int)target->query_skill("parry", 1)) {
    msg += HIR "结果$p" HIR "被$P" HIR "逼得招"
      "架不迭，一时无法反击！\n" NOR;
    b = level / 20;
    target->start_busy(b);
    me->start_busy(2);
  } else

  {
    msg += CYN "可是$n" CYN "看破了$N"
      CYN "的企图，镇定解招，一丝不乱。\n" NOR;
    me->start_busy(2);
  }
  message_combatd(msg, me, target);

  return 1;
}
