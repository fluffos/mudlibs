// hup.c 天道归元

#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIR "不死之身" NOR; }
string query_name() { return "不死" ZJBR "之身"; }

int exert(object me, object target) {
  int skill;
  string msg;
  mapping my;
  int rp;
  int neili_cost;


  if ((int)me->query_skill("wudao-shanqian", 1) < 200)
    return notify_fail("你的武道三千不够深厚，无法使用不死之身。\n");

  if ((int)me->query("neili") < 200)
    return notify_fail("你现在的真气不够。\n");

  if (time() - me->query_temp("last_perform_不死之身") < 300)
    return notify_fail("你刚施展过" + name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");

  my = me->query_entire_dbase();
  if ((rp = (my["max_qi"] - my["eff_qi"])) < 1)
    return (SKILL_D("force") + "/recover")->exert(me, target);


  skill = me->query_skill("force");
  msg = HIY "$N" HIY "缓缓吐出一口气，脸色渐渐的变得平和。" NOR "\n";
  message_combatd(msg, me);

  neili_cost = rp / 2;
  if (neili_cost > my["neili"]) {
    neili_cost = my["neili"];
  }
  me->receive_curing("qi", rp);
  me->receive_heal("qi", rp);
  me->add("neili", -neili_cost);
  me->set_temp("last_perform_不死之身", time());

  me->start_busy(3);
  return 1;
}
