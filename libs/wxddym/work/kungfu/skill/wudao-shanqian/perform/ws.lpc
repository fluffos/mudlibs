#include <ansi.h>
#include <combat.h>

string name() { return HIR "威慑" NOR; }
string query_name() { return "威慑"; }
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg;
  int level, b;
  int wait_time;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if ((level = (int)me->query_skill("wudao-shanqian", 1)) < 100)
    return notify_fail("你的武道三千火候不够，难以施展" + name() + "。\n");

  if ((int)me->query_skill("force") < 100)
    return notify_fail("你的内功修为不够，难以施展" + name() + "。\n");

  if (me->query_skill_mapped("force") != "wudao-shanqian")
    return notify_fail("需要将武道三千激发为内功才能施展。\n");

  if (me->query("max_neili") < 100)
    return notify_fail("你的内力修为不够，难以施展" + name() + "。\n");

  if (me->query("neili") < 100)
    return notify_fail("你现在的真气不足，难以施展" + name() + "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  wait_time = 30 - me->query_skill("wudao-shanqian", 1) / 100;
  if (wait_time < 2)
    wait_time = 2;
  if (time() - me->query_temp("last_perform_ws") < wait_time)
    return notify_fail("你刚施展过" + name() + "，体内真气还没有完全顺畅，此时不宜强行运功。\n");

  msg = HIC "$N" HIC "虎躯一震，浑身散发出一股王霸之气。" NOR "\n";


  me->add("neili", -100);
  if (level + random(level) > (int)target->query_skill("parry", 1)) {
    msg += HIR "结果$p" HIR "顿觉神智不定，心燥意乱，"
      "全然不知身在何处，呆立当场！\n" NOR;
    b = level / 20;
    target->start_busy(b);
    me->set_temp("last_perform_ws", time());
  } else

  {
    msg += CYN "可是$n" CYN "看破了$N"
      CYN "的企图，镇定解招，一丝不乱。\n" NOR;
    me->start_busy(2);
  }
  message_combatd(msg, me, target);

  return 1;
}
