// qiankun.c 百步神拳 「无形拳罡」

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

string query_name() { return "无形"ZJBR"拳罡"; }

int perform(object me, object target)
{
	string msg;
	int ap, dp;
	int damage;

	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
		return notify_fail("「无形拳罡」只能在战斗中使用。\n");

	if ((int)me->query_skill("baibu-shenquan", 1) < 200)
		return notify_fail("你的百步神拳修为不够，目前还不能施展百步神拳绝技！\n");

	if ((int)me->query_skill("force") < 160)
		return notify_fail("你内功火候不够，难以施展无形拳罡！\n");

	if ((int)me->query("neili") < 500)
		return notify_fail("你的真气不够，无法施展「无形拳罡」！\n");

	if (me->query_skill_mapped("cuff") != "baibu-shenquan") 
		return notify_fail("你没有激发一阳指法，无法使用「无形拳罡」！\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIY "$N" HIY "使出百步神拳绝技「无形拳罡」，攻向$n"
	      HIY "的后背，招式平淡无奇。\n" HIY;

	ap = me->query_skill("cuff") + me->query_skill("force") + me->query_skill("dodge") ;
	dp = target->query_skill("parry") + target->query_skill("force");
	if (ap / 2 + random(ap) > dp)
	{
		damage = ap / 2 + random(ap / 4);
		msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 66,
					   HIR "结果$p" HIR "没能避开$P"
					   HIR "这一拳，破开真气，直接打中后背，浑身"
					   "气血登时倒流，哇哇连吐几口鲜血！"NOR"\n");
		me->add("neili", -2000);
		me->start_busy(1);
	} else
	{
		msg += CYN "可是$p" CYN "看破了$P"
		       CYN "急忙退闪，连消带打躲开了这一击。"NOR"\n";
		me->start_busy(3);
		me->add("neili", -50);
	}
	message_combatd(msg, me, target);

	return 1;
}

