// xiaoyao-xinfa.c 逍遥心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) {
  return force == "beiming-shengong" || force == "xiaowuxiang";
}

string main_skill() {
  return "tiandao-gong";
}

mapping sub_skills = ([
  "jiuyin-shengong": 250,
]);

int get_ready(object me) {
  return 1;
}

int get_finish(object me) {
  object ob;

  if (me->query("int") < 150) {
    tell_object(me, "你演练完毕，只感思绪紊乱，看来依你的悟性，无"
      "法将其合一。\n");
    return 0;
  }
  if (me->query("con") < 150) {
    tell_object(me, "你演练完毕，只觉全身真气乱窜，眼冒金星，两耳轰鸣，好"
      "不容易才控制下来。\n");
    return 0;
  }
  if (me->query("str") < 150) {
    tell_object(me, "你演练完毕，只觉双臂酸疼，全身发软。\n");
    return 0;
  }
  if (me->query("dex") < 150) {
    tell_object(me, "你演练完毕，发现依你的身法暂时还无法将其融会贯通。\n");
    return 0;
  }

  if ((int)me->query_skill("tiandaodao", 1) < 500)
    return notify_fail("你对天道dao法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaojian", 1) < 500)
    return notify_fail("你对天道jian法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaozhang", 1) < 500)
    return notify_fail("你对天道zhang法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaoquan", 1) < 500)
    return notify_fail("你对天道quan法的理解不够，难以领会天道功。\n");

  if (me->query("age") >= 180) {
    tell_object(me, "你已错过演练的最佳时刻，今生将于此高深武学无缘。\n");
    return 0;
  }

  if (random(30) != 1 && !wizardp(me)) {
    tell_object(me, "你觉得有所感悟，或许再演练一次就能融会贯通，练成天道功。\n");
    return 0;
  }

  tell_object(me, HIW "一阵凡尘往事涌上心头，你几欲放声长叹。霎那间，你放眼回首，竟有一股莫名\n"
    "的悲哀。宗师泰斗那种高出不胜寒、登泰山而小天下之感犹然而生，你只觉得以\n往的"
    "武学现在看来是多么的渺小可笑。\n" NOR);

  CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name() + "演练出" HIY "天道功" HIM "。\n");
  return 1;
}
mapping query_sub_skills() {
  return sub_skills;
}

int query_neili_improve(object me) {
  int lvl;

  lvl = (int)me->query_skill("xiantian-gong", 1);
  return (lvl / 10) * (lvl / 20) * 50 * 50 / 100;
}

int valid_learn(object me) {

  if (me->query("str") < 66)
    return notify_fail("你的天道臂力不足无法学习。\n");
  if (me->query("dex") < 66)
    return notify_fail("你的天道身法不足无法学习。\n");
  if (me->query("int") < 66)
    return notify_fail("你的天道智商不足无法学习。\n");
  if (me->query("con") < 66)
    return notify_fail("你的天道根骨不足无法学习。\n");



  if ((int)me->query_skill("tiandaodao", 1) < 500)
    return notify_fail("你对天道dao法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaojian", 1) < 500)
    return notify_fail("你对天道jian法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaozhang", 1) < 500)
    return notify_fail("你对天道zhang法的理解不够，难以领会天道功。\n");
  if ((int)me->query_skill("tiandaoquan", 1) < 500)
    return notify_fail("你对天道quan法的理解不够，难以领会天道功。\n");

  if ((int)me->query_skill("force", 1) < 150)

    return notify_fail("你的基本内功火候不足，难以领会天道功。\n");



  if ((int)me->query("max_neili", 1) < 20000)
    return notify_fail("你的内力修为不足，难以领会天道功。\n");

  if (me->query_skill("force", 1) < me->query_skill("tiandao-gong", 1))
    return notify_fail("你的基本内功水平不够，难以锻炼更深厚的天道功。\n");
  return ::valid_learn(me);
}

int practice_skill(object me) {
  return notify_fail("逍遥心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "tiandao-gong/" + func;
}



mixed valid_damage(object ob, object me, int damage, object weapon) {
  int ap, dp, cost;
  mapping result;

  if (me->query_skill("tiandao-gong", 1) < 200 ||
    me->query_skill_mapped("force") != "tiandao-gong" ||
    me->query("neili") < 1000 ||
    !living(me))
    return;

  cost = damage / 2;
  if (cost > 100) cost = 100;

  ap = ob->query_skill("force") * 12 + ob->query("max_neili") + ob->query_skill("count", 1);
  dp = me->query_skill("force") * 12 + me->query("neili");

  if (ap / 2 + random(ap) < dp) {
    me->add("neili", -cost);
    result = ([ "damage": -damage ]);

    switch (random(2)) {
      case 0:
        result += ([ "msg": HIR "只见$n" HIR "先天护体神功自然而"
          "然发动，将$N" HIR "的力道尽数反震回"
          "去。\n" NOR ]);
        break;
      case 1:
        result += ([ "msg": HIR "只见$n" HIR "先天护体神功自然而"
          "然发动，将$N" HIR "的攻击化为无形。\n" NOR ]);
        break;
      default:
        result += ([ "msg": HIR "只见$n" HIR "先天护体神功自然而"
          "然发动，抵抗$N" HIR "的攻击。\n" NOR ]);
        break;
    }
    return result;
  }
}
