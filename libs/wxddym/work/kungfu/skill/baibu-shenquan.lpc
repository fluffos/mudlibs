// baibu-shenquan

#include <ansi.h>

inherit SHAOLIN_SKILL;

mapping *action = ({
([      "action": "$N一拳轰出$n，没有什么套路",
	"force" : 200,
	"attack": 150,
	"dodge" : 150,
	"parry" : 150,
	"damage": 150,
	"lvl"   : 100,
	"damage_type" : "内伤"
]),
([      "action": "$N深深吸了一口气，摆好架势，缓缓轰向$n，拳罡有如排山倒海一般",
	"force" : 1000,
	"attack": 400,
	"dodge" : 200,
	"parry" : 300,
	"damage": 300,
	"lvl"   : 350,
	"damage_type" : "内伤"
]),
});

int valid_enable(string usage) { return usage == "cuff"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练百步神拳必须空手。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，不能强行修习百步神拳。\n");

	if ((int)me->query("max_neili") < 2500)
		return notify_fail("你的内力还不够强，无法修习百步神拳。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("baibu-shenquan", 1))
		return notify_fail("你的基本拳法火候水平有限，无法领会更高深的百步神拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i - 1]["lvl"])
			return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("baibu-shenquan", 1);
	if (level < action[1]["lvl"])
		return action[0];

	return action[1];
}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 300)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 300)
		return notify_fail("你的内力不够练百步神拳。\n");

	me->receive_damage("qi", 100);
	me->add("neili", -1000);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if (damage_bonus < 100) return 0;

	if (me->query("jiali") < 150 || me->query("neili") < 600)
		return 0;

	me->start_busy(0);
	victim->receive_damage("qi", damage_bonus, me);
	if (victim->query("neili") < 300)
		victim->set("neili", 0);
	else
		victim->add("neili", -1000);

	return HIR "$n" HIR "接下$N" HIR "这一拳，刹时间觉得浑身乏力，几欲晕厥。"NOR"\n";
}

string perform_action_file(string action)
{
        return __DIR__ + "baibu-shenquan" + "/" + action;
}


