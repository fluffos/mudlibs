// tiandao-shengong.c 

inherit FORCE;
int valid_force(string force) { return 1; } 

    int valid_enable(string usage)
{
        return usage == "force";
} 

int query_neili_improve(object me)  
{
        int lvl;

        lvl = (int)me->query_skill("tiandao-shengong", 1);
        return lvl /10 * lvl /10 * 15 * 70 / 10 / 20;
}

int query_jingli_improve(object me)
{
        int lvl;

        lvl = (int)me->query_skill("tiandao-shengong", 1);

        if (me->query_skill_mapped("force") == "tiandao-shengong")
                return lvl * 14 / 7;

        return 0;
}

int valid_learn(object me)
{    		

        if (me->query("str") < 150)
                return notify_fail("你的先天臂力不足无法学习。\n");
        if (me->query("dex") < 150)
                return notify_fail("你的先天身法不足无法学习。\n");
		if (me->query("int") < 150)
                return notify_fail("你的先天智商不足无法学习。\n");
        if (me->query("con") < 150)
                return notify_fail("你的先天根骨不足无法学习。\n");
    
        if (me->query_skill("force", 1) < 100)
                return notify_fail("你的基本内功太差了。\n");
        if (me->query("gender") == "无性" && me->query_skill("tiandao-shendong", 1) > 49)
                return notify_fail("无根无性之人，无法领会高深的天道神功。\n");
		if (me->query_skill("martial-cognize", 1) < 100)
                return notify_fail("你武学修养不够，无法领会高深的天道神功。\n");
            
           if( me->query_skill("chiyou-kuangzhanjue",1))
                return notify_fail("你所学的蚩尤狂战决不合天道，无法专心研习天道神功。\n");
           if( me->query_skill("poyu-quan",1))
                return notify_fail("你所学的破玉拳不合天道，无法专心研习天道神功。\n");
           if( me->query_skill("badao",1))
                return notify_fail("你所学的霸刀不合天道，无法专心研习天道神功。\n");
        if( me->query_skill("lonely-sword",1))
                return notify_fail("你所学的独孤九剑不合天道，无法专心研习天道神功。\n");
if( me->query_skill("jingang-quan",1))
                return notify_fail("你所学的金刚拳不合天道，无法专心研习天道神功。\n");

        return ::valid_learn(me);
}
 
int practice_skill(object me)
{
        return notify_fail("天道神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"tiandao-shengong/" + func;
}           

