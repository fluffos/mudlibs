#include <ansi.h>
inherit FORCE;

int query_neili_improve(object me) {
  int lvl;

  lvl = (int)me->query_skill("baiyangzuo", 1);
  return (lvl / 10) * (lvl / 20) * 15 * 22 / 100;
}

int valid_force(string force) {
  return 1;
}

mapping *action = ({
  ([ "action": "$N单掌一抖，运聚小宇宙之力，呼啸着向$n的$l处拍去",
    "dodge": 90,
    "force": 430,
    "attack": 170,
    "parry": 80,
    "damage": 80,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N右掌平伸，左掌运起小宇宙的劲力，猛地拍向$n的$l",
    "dodge": 90,
    "force": 440,
    "attack": 150,
    "parry": 80,
    "damage": 80,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一展，右掌护住心脉，左掌中攻直进，贯向$n$l",
