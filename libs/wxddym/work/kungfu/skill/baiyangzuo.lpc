});

int valid_enable(string usage) {
  int lvl;
  lvl = (int)this_player()->query_skill("baiyangzuo", 1);

  if (lvl >= 180)
    return usage == "force" || usage == "unarmed" || usage == "parry";
  else
    return usage == "force";

}

int valid_learn(object me) {
  if (me->query("character") != "光明磊落"
    && me->query("character") != "国士无双")
    return notify_fail("你只觉小宇宙之力正大恢弘，依自己的天性似乎难以领悟。\n");

  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳不调，无法调用体内的阴阳二气生成小宇宙之力。\n");

  if (me->query_skill("xyz", 1) < me->query_skill("baiyangzuo", 1))
    return notify_fail("你的小宇宙水平不够，难以锻炼更深厚的白羊座。\n");

  if (me->query_skill("unarmed", 1) < me->query_skill("baiyangzuo", 1))
    return notify_fail("你的基本拳脚水平不够，难以锻炼更深厚的白羊座。\n");

  if (me->query_skill("parry", 1) < me->query_skill("baiyangzuo", 1))
    return notify_fail("你的基本招架水平不够，难以锻炼更深厚的白羊座。\n");

  if (me->query("int") < 30)
    return notify_fail("你的思维浑浊不清，怎么参悟小宇宙之力。\n");

  if (me->query("dex") < 30)
    return notify_fail("你的身体柔韧性不够，不怕拉伤身体吗？。\n");

  if (me->query("con") < 30)
    return notify_fail("你的身体强度不够，无法积蓄小宇宙之力。\n");

  if (me->query("str") < 30)
    return notify_fail("你的力量不够，出拳踢腿力道不到，无法起到锻炼的效果。\n");
  return ::valid_learn(me);
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int lvl;

  lvl = me->query_skill("baiyangzuo", 1);

  if (damage_bonus < 50
    || lvl < 180)
    return 0;

  if (damage_bonus > victim->query_con()) {
    me->add("neili", -30);
    victim->receive_wound("qi", damage_bonus, me);
    return HIR "随着" "$N" "的攻击,<白羊座>星座之力从你的身体中瞬间爆发了出来，$n"
      HIR "只感五内俱焚，喉咙沙哑无比，不禁咳一口鲜血！\n" NOR;
  }
}

int practice_skill(object me) {
  return notify_fail("白羊座只能用学(learn)来增加熟练度。\n");
}

int difficult_level() {
  return 50000;
}

string perform_action_file(string action) {
  return __DIR__ "baiyangzuo/perform/" + action;
}

string exert_function_file(string action) {
  return __DIR__ "baiyangzuo/exert/" + action;
}

mixed valid_damage(object ob, object me, int damage, object weapon) {
  int ap, dp, cost;
  mapping result;

  if (me->query_skill("baiyangzuo", 1) < 200 ||
    me->query_skill_mapped("force") != "baiyangzuo" ||
    me->query("neili") < 1000 ||
    !living(me))
    return;

  cost = damage / 2;
  if (cost > 100) cost = 100;

  ap = ob->query_skill("force") * 12 + ob->query("max_neili") + ob->query_skill("count", 1);
  dp = me->query_skill("force") * 12 + me->query("neili");

  if (ap / 2 + random(ap) < dp) {
    me->add("neili", -cost);
    result = ([ "damage": -damage ]);

    switch (random(2)) {
      case 0:
        result += ([ "msg": HIR "只见$n" HIR "小宇宙之力自然而"
          "然发动，将$N" HIR "的力道尽数反震回"
          "去。\n" NOR ]);
        break;
      case 1:
        result += ([ "msg": HIR "只见$n" HIR "小宇宙之力自然而"
          "然发动，将$N" HIR "的攻击化为无形。\n" NOR ]);
        break;
      default:
        result += ([ "msg": HIR "只见$n" HIR "小宇宙之力自然而"
          "然发动，抵抗$N" HIR "的攻击。\n" NOR ]);
        break;
    }
    return result;
  }
}
