int valid_enable(string usage) {
  return usage == "blade" || usage == "claw" || usage == "club" || usage == "finger" || usage == "hook" || usage == "leg" || usage == "spear" || usage == "strike" || usage == "sword" || usage == "unarmed";
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 100)
    return notify_fail("你的体力太低了。\n");
  me->receive_damage("jingli", 1);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, j, level;
  level = (int)me->query_skill("wudi", 1);
  for (i = sizeof(action); i > 0; i--) {
    if (level > action[i - 1]["lvl"]) {
      j = NewRandom(i, 20, level / 4);
      if ((int)me->query_skill("wudi", 1) > 1000) {
        return ([
          "action": HIR + replace_string(
            replace_string(action[j]["action"], "$w", "$W"),
            "$W",
            "$w" HIR
          ) + NOR,
          "force": 9999,
          "dodge": 9999,
          "parry": 9999,
          "damage": 9999,
          "damage_type": "内伤",
        ]);
      } else return action[j];
    }
  }
}

string perform_action_file(string action) {
  return __DIR__ "wudi/" + action;
}
