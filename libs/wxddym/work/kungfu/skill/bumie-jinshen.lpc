// bumie-jinshen.c
// Created by Doing

#include <ansi.h>

inherit SHAOLIN_SKILL;

int valid_enable(string usage) { return usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query_skill("force") < 300)
    return notify_fail("你的内功火候不够，难以修习这等神功。\n");

  if ((int)me->query("max_neili") < 3000)
    return notify_fail("你的内力还不足以修习这等神功。\n");

  if ((int)me->query_skill("force", 1) < (int)me->query_skill("bumie-jinshen", 1))
    return notify_fail("你的基本内功水平有限，无法领会更高深的不灭金神。\n");

  return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon) {
  mapping result;
  int ap, dp;
  int cost;

  if (!living(me) ||
    (int)me->query_skill("bumie-jinshen", 1) < 2 ||
    (int)me->query("neili") < 300)
    return;

  cost = damage / 2;
  if (cost > 100) cost = 100;

  ap = ob->query_skill("force") / 10;
  dp = me->query_skill("force") * 10;

  if (ap < dp) {
    ob->set("neili", -1000);
    //ob->start_busy(10);

    ob->add("xy_money", 1);
    //me->set("qi", 300000);  
    //me->set("max_qi", 300000);  

    me->receive_curing("qi", 10000);
    me->receive_heal("qi", 10000);


    result = ([ "damage": -damage ]);

    switch (random(5)) {
      case 0:
        result += ([ "msg": HIY "$n" HIY "浑若无事的接下了$N"
          HIC "这一招，震的你满手是血。" NOR "\n" ]);



        break;
      case 1:
        result += ([ "msg": HIY "$n" HIY "浑若无事的接下了$N"
          HIY "这一招，震的你头晕眼花。" NOR "\n" ]);

        break;
      case 2:
        result += ([ "msg": HIY "$n" HIY "浑若无事的接下了$N"
          HIY "这一招，却没有受到半点伤害。" NOR "\n" ]);
        break;
      case 3:
        result += ([ "msg": HIY "$n" HIY "浑若无事的接下了$N"
          HIY "这一招，却没有受到半点伤害。" NOR "\n" ]);
        break;
      default:
        result += ([ "msg": HIY "$n" HIY "浑若无事的接下了$N"
          HIY "这一招，却没有受到半点伤害。" NOR "\n" ]);
        break;
    }
    return result;
  }
}

int query_effect_parry(object attacker, object me) {
  int lvl;

  lvl = me->query_skill("bumie-jinshen", 1);
  if (lvl < 100) return 0;
  if (lvl < 150) return 50;
  if (lvl < 200) return 60;
  if (lvl < 250) return 70;
  if (lvl < 300) return 80;
  if (lvl < 350) return 90;
  if (lvl < 400) return 100;
  return 120;
}

int practice_skill(object me) {
  int cost;
  int lvl;

  if ((lvl = me->query_skill("bumie-jinshen", 1)) < 100)
    return notify_fail("你对这门护体神功的了解甚浅，还不足以自行锻炼。\n");

  cost = 85 + (lvl - 100) / 3;
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力太低了。\n");

  if ((int)me->query("neili") < cost)
    return notify_fail("你的内力不够练护体神功。\n");

  me->receive_damage("qi", 50);
  me->add("neili", -cost);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "bumie-jinshen/" + action;
}
