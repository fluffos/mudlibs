// 无常掌(wuchang-strike.c)

#include <ansi.h>
inherit SKILL;

int is_invent_skill() { return 1; }

mapping *action = ({
  // ZHAOSHI : 0
  ([ "action": "世事无常:$N手臂一挥，所过之处真空破碎，一式[世事无常],带着恐怖无匹的杀机从$n意想不到的地方袭击而来",
    "attack": 260,
    "damage": 1,
    "force": 1,
    "dodge": 2,
    "parry": 1,
    "lvl": 100,
    "damage_type": "内伤",
    "skill_name": "世事无常"
  ]),
  // ZHAOSHI : 1
  ([ "action": "$N对着$n双手连挥，一式［人生无常］，对着$n连发多道惊人掌罡",
    "attack": 260,
    "damage": 6,
    "force": 6,
    "dodge": 7,
    "parry": 6,
    "lvl": 110,
    "damage_type": "内伤",
    "skill_name": "人生无常"
  ]),
  // ZHAOSHI : 2
  ([ "action": "$N面色一凝，一股天地破败之气扑面而来，汇聚成一只巨大手掌向着$n抓来，这一招正是［天地竟无常］！",
    "attack": 260,
    "damage": 36,
    "force": 36,
    "dodge": 37,
    "parry": 36,
    "lvl": 120,
    "damage_type": "内伤",
    "skill_name": "天地竟无常"
  ]),
  // ZHAOSHI : 3
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练" + "无常掌" + "必须空手。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练" + "无常掌" + "。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "strike" || usage == "parry";
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("wuchang-strike", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

mixed *query_actions() { return action; }

int query_effect_parry(object attacker, object me) {
  int lvl;

  if (me->query_temp("weapon"))
    return 0;

  lvl = me->query_skill("wuchang-strike", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("neili") < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -3);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ + "wuchang-strike" + "/" + action;
}
