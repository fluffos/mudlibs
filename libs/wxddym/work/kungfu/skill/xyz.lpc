// unarmed.c
inherit FORCE;

int valid_enable(string usage)
{
            return usage == "force";
}
int valid_force(string force)
{
        return 1;
}
int valid_learn(object me)
{
            return ::valid_learn(me);
}
int difficult_level()
{
        return 500000;
}

int practice_skill(object me)
{
            return notify_fail("努力锻炼身体，才能更好的提升小宇宙。\n");
}
void skill_improved(object me)
{ 
int lvl;
lvl = me->query_skill("xyz", 1);

if (lvl % 100==0) 
{
tell_object(me, HIW "你刻苦锻炼肉身，小宇宙得到了提升，让你的"+RED"【后天膂力】"+HIW"【后天悟性】"+HIY"【后天根骨】"+HIC"【后天身法】"+NOR+"提高了。"NOR"\n");
}

if( lvl >= 10 && 
            !me->query("can_perform/xyz/d1g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第一感<视觉>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d1g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 100 && 
            !me->query("can_perform/xyz/d2g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第二感<听觉>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d2g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 200 && 
            !me->query("can_perform/xyz/d3g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第三感<味觉>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d3g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 300 && 
            !me->query("can_perform/xyz/d4g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第四感<嗅觉>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d4g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 400 && 
            !me->query("can_perform/xyz/d5g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第五感<触觉>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d5g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 500 && 
            !me->query("can_perform/xyz/d6g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第六感<意识>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d6g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 800 && 
            !me->query("can_perform/xyz/d7g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第七感<未那识>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d7g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 1200 && 
            !me->query("can_perform/xyz/d8g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第八感<阿赖耶识>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d8g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 
if( lvl >= 1500 && 
            !me->query("can_perform/xyz/d9g") )  
        { 
                tell_object(me, HIC "你领悟了小宇宙「" HIR "第九感<阿摩罗识>" HIC "」的奥秘。\n" NOR);     
                me->set("can_perform/xyz/d9g", 1); 
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
                me->improve_skill("xyz", 1500000);   
        } 		
}
