// 大爷行行好.c 大爷行行好

#include <ansi.h>;
inherit SKILL;
string type() { return "martial"; }
string martialtype() { return "skill"; }

string *order = ({""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});
mapping *action = ({
(["action" : "$N双拳平平提到胸前，神色沉重的缓缓施出"+(order[random(13)])+"「大爷行行好」"NOR"推向$n的$l",
  "lvl": 25,
  "skill_name" : "大爷行行好",
]),
(["action" : "$N突然身形飞起，双拳居高临下一招"+(order[random(13)])+"「奉旨行乞」"NOR"拍向$n的$l",
  "lvl": 50,
  "skill_name" : "奉旨行乞",
]),
(["action" : "$N使出"+(order[random(13)])+"「大爷给点钱吧」"NOR"，双拳软绵绵地拍向$n的$l",
  "lvl": 75,
  "skill_name" : "大爷给点钱吧",
]),
(["action" : "$N脚下一转，突然欺到$n身前，一招"+(order[random(13)])+"「赏我口吃的」"NOR"拍向$n的$l",
  "lvl": 100,
  "skill_name" : "赏我口吃的",
]),
(["action" : "$N门户大开，一招"+(order[random(13)])+"「可怜可怜我」"NOR"向$n的$l劈去",
  "lvl": 125,
  "skill_name" : "可怜可怜我",
]),
(["action" : "$N使出"+(order[random(13)])+"「御赐金碗」"NOR"，双拳由下往上击向$n的$l",
  "lvl": 150,
  "skill_name" : "御赐金碗",
]),
(["action" : "$N左拳护胸，右拳使一招"+(order[random(13)])+"「行善积德」"NOR"上下晃动着击向$n的$l",
  "lvl": 175,
  "skill_name" : "行善积德",
]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }

int valid_learn(object me)
{
if( me->query("int")<30 )
return notify_fail("你若有所悟，然而总是有点不明白。\n");

if( me->query("dex")<30 )
return notify_fail("你研究了半天，只觉招式始终无法随意施展。\n");

if( me->query("con")<30 )
return notify_fail("你研究了半天，只觉得根骨有些差，招式始终无法随意施展。\n");

if( me->query("str")<30 )
return notify_fail("你研究了半天，感觉膂力有些低，始终无法随意施展。\n");

if ((int)me->query_skill("unarmed", 1) < 30)
return notify_fail("你的基本拳脚火候不够，无法学习大爷行行好。\n");

if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("dyxxh", 1))
return notify_fail("你的基本拳脚水平有限，无法领会更高深的大爷行行好。\n");

return 1;
}

string query_skill_name(int level)
{
int i;
for(i = sizeof(action); i > 0; i--)
if(level >= action[i-1]["lvl"])
return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
mapping a_action;
int level, tmp;
int d_e1 = -60;
int d_e2 = -40;
int p_e1 = -20;
int p_e2 = 10;
int f_e1 = 520;
int f_e2 = 640;
int i, seq, ttl = sizeof(action);

level = (int)me->query_skill("dyxxh", 1);
if( me->query_temp("xlz/hanglong") )
{
tmp = 4 + random(15);
me->delete_temp("xlz/hanglong");
return ([
"action": HIY "\n$N叫道：「看招！」左腿微屈，右拳划了个圆圈，平推出去，正是大爷行行好中的「给我口吃的」。\n" +
  "初推出去看似轻描淡写，但一遇阻力，刹时之间连加" + chinese_number(tmp) + "道後劲，一道强似一道，\n" +
  "重重叠叠，直至无坚不摧，无强不破！" NOR,
"dodge" : -140,
"parry" : -140,
"attack": 200,
"force" : 500 + 40 * tmp,
"damage": 100 + 20 * tmp,
"damage_type": random(2)?"内伤":"瘀伤"
]);
}

seq = random(ttl);/* 选择出手招数序号 */
return ([
"action"      : action[seq]["action"],
"dodge": d_e1 + (d_e2 - d_e1) * seq / ttl,
"parry": p_e1 + (p_e2 - p_e1) * seq / ttl,
"force": f_e1 + (f_e2 - f_e1) * seq / ttl,
"damage_type" : random(2) ? "内伤" : "瘀伤",
]);
}
int practice_skill(object me)
{
return notify_fail("大爷行行好只能用学(learn)的来增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage)
{
mixed result;
string msg;
int lvl;

lvl = me->query_skill("dyxxh", 1);

if (damage < 50 || lvl < 150) return;

if (random(10) < 2)
{
result = ([ "damage" : damage ]);
result += ([ "msg" : HIY "$N" HIY "一拳既出，身子抢前，又是一招「积善行德」，"
     "後拳推前拳，双拳力道并在一起，排山倒海的压将过来。\n"
     HIR "$n" HIR "那曾见过这样霸道的拳力，顿时身受重创，哇的一声，吐出一口鲜血！\n"
     NOR ]);
}
else
{
victim->receive_wound("qi", damage, me);
msg = random(2) ? HIR "$n" HIR "一声惨叫，胸前「咔嚓咔嚓」几声脆"
  "响，口中鲜血狂喷。\n" NOR :
  HIR "只听$n" HIR "前胸「咔嚓」一声脆响，竟像是"
  "肋骨断折的声音。\n" NOR;
result = ([ "msg" : msg ]);
}

return result;
}

string perform_action_file(string action)
{

return __DIR__"dyxxh/" + action;
}

int query_effect_parry(object attacker, object me)
{
int lvl;
if( objectp(me->query_temp("weapon")) )
return 0;

lvl = me->query_skill("dyxxh", 1);
if (lvl < 80)  return 0;
if (lvl < 200) return 50;
if (lvl < 280) return 80;
if (lvl < 350) return 100;
return 120;
}

int learn_bonus() { return 0; }
int practice_bonus() { return 0; }
int success() { return 5; }
int power_point(object me)
{
if (me->query_skill("huntian-qigong",1) >= 10)return 0.8;
else return 1.0;
}
int help(object me)
{
write(HIC"\n大爷行行好："NOR"\n");
write(@HELP

大爷行行好是思萍从传世破碗中领悟出的惊世绝学

学习要求：
先天臂力30
先天根骨30
先天悟性30
先天身法30
基本拳脚100
基本拳脚不低于大爷行行好
HELP
);
return 1;
}
