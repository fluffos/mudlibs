inherit FORCE;
int valid_force(string force) { return 1; }

int query_neili_improve(object me) {
  int lvl;
  lvl = (int)me->query_skill("luohan-fumogong", 1);
  return lvl * lvl * 22 * 15 / 100 / 200;
}

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  if (me->query("character") == "狡黠多变")
    return notify_fail("罗汉伏魔神功正大恢弘，气度俨然，你怎么也学不得神似。\n");


  if (me->query("character") == "阴险狡诈")
    return notify_fail("罗汉伏魔神功正大恢弘，气度俨然，你怎么也学不得神似。\n");

  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳不调，难以领会高深的九阴神功。\n");

  if (me->query("str") < 45)
    return notify_fail("你先天臂力不足。\n");

  if (me->query("int") < 45)
    return notify_fail("你先天悟性不足。\n");

  if (me->query("dex") < 45)
    return notify_fail("你先天身法不足。\n");

  if (me->query("con") < 45)
    return notify_fail("你先天根骨不足。\n");

  if ((int)me->query_skill("buddhism", 1) < 200)
    return notify_fail("你的禅宗心法修为不足，难以修炼罗汉伏魔神功。\n");

  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的内功火候太浅，难以修炼罗汉伏魔神功。\n");

  if ((int)me->query_skill("force", 1) < (int)me->query_skill("luohan-fumogong", 1))
    return notify_fail("你的基本内功水平有限，无法领会更高深罗汉伏魔神功。\n");


  return ::valid_learn(me);
}

int practice_skill(object me) {
  return notify_fail("罗汉伏魔神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "luohan-fumogong/" + func;
}
