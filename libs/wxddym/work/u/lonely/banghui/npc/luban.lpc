inherit BHNPC;
inherit F_BVENDOR;

string query_save_file() { return DATA_DIR + "npc/鲁板"; }
void create()
{
        set_name("鲁板", ({"lu ban", "lu"}));
        set("long", "温和善良的老人。\n");
        this_object()->init_bhnpc();

        set("area_name","木器铺");
        set("area_file","/d/yangzhou/muqipu.c");
        set("vendor_goods", ([
                     "blade": "/d/yangzhou/npc/obj/mudao",
                "sword": "/d/yangzhou/npc/obj/mujian",
                "staff": "/d/yangzhou/npc/obj/muzhang",
        ]) );
        setup();
carry_object("/obj/armor/guardsuit")->wear();
add_money("silver",30);
}
void init()
{
::init();
  add_action("do_vendor_list","list");
}


