//帮派令牌  
//modified by lonely@yxcs

#include <mudlib.h>
#include <ansi.h>
#include <room.h>
#include <armor.h>
#include <command.h>
#include <net/dns.h>

inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

mapping dir_alias = ([
  "n": "north",
  "e": "east",
  "w": "west",
  "s": "south",
  "nu": "northup",
  "eu": "eastup",
  "wu": "westup",
  "su": "southup",
  "nd": "northdown",
  "ed": "eastdown",
  "wd": "westdown",
  "sd": "southdown",
  "ne": "northeast",
  "se": "southeast",
  "nw": "northwest",
  "sw": "southwest",
  "u": "up",
  "d": "down"
]);

mapping dir_desc = ([
  "north": "北面",
  "south": "南面",
  "east": "东面",
  "west": "西面",
  "northup": "北边",
  "southup": "南边",
  "eastup": "东边",
  "westup": "西边",
  "northdown": "北边",
  "southdown": "南边",
  "eastdown": "东边",
  "westdown": "西边",
  "northeast": "东北",
  "northwest": "西北",
  "southeast": "东南",
  "southwest": "西南",
  "up": "上面",
  "down": "下面",
  "enter": "里面",
  "out": "外面"
]);

int msgon = 1;

int whereis(string arg);
void init() {
  object me = this_player();
  seteuid(geteuid());
  if (me && present(this_object(), me))
    set_name(me->query("bangpai/mingzi") + "信物", ({ "lingpai" }));

  if (me && present(this_object(), me)) {
    add_action("help", "help");
    add_action("remove_wield", "xie");
    add_action("pk_mob", "pk");
    add_action("force_go", ({ "forcego", "fgo" }));
    add_action("do_look", ({ "lookhere", "ll" }));
    add_action("do_tie", "tie");
    add_action("kaichu", "quzhu");
    //              add_action("chuanwei", "chuanwei");                          
  }
}

void create() {
  object me;
  me = this_player();
  seteuid(getuid());
  set("long",
    "\n这是一块" HIC + me->query("banghui") + NOR "的信物。
本派宗旨是：" HIG + me->query("bangpai/cause") + NOR "。
你可以键入<help ling>来获得更多的帮助。\n"
  );

  set("unit", "块");
  set("no_get", 1);
  set("no_drop", 1);

  set("material", "cloth");
  set("armor_prop/armor", 100);
  set_weight(1);
  setup();
}

int help(string str) {

  if (str != "ling" && str != "lingpai") return 0;

  write(@Help

        你可以使用以下的几个命令:
        xie <eqs> from <object>         <让本帮某成员解除装备>
        pk <某人1> with <某人2>          <让本帮某成员与某生物相互战斗>
        forcego <某人> <方向>            <让本帮某成员往某方向去>
        tie <某人> with <某人>           <让本帮某成员跟随某生物>
        quzhu <某人>                     <将某人从本帮派驱逐出去>
   （注：由于驱逐某个成员，说明领导无方，减去300000exp作为惩罚） 
Help
  );
  return 1;
}

int kaichu(string arg) {
  object ob, xin, obj, lp;
  string target, item, banghui;
  object me = this_player();


  if (!arg) return notify_fail("你想驱逐谁？\n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");


  if (me->query("banghui") != ob->query("banghui"))
    notify_fail("你只能驱逐本帮派的成员。\n");

  if (!userp(ob)) return notify_fail("你只能开除玩家扮演的人物。\n");

  if (ob->is_ghost())
    return notify_fail("你只能开除活人！\n");
  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("bangzhu_id") == ob->query("id"))
    return notify_fail("你不能驱逐创始人。\n");
  destruct(lp);
  message_vision("\n$N对着$n长叹了一口气道：走吧，你与本帮的缘分已经到了尽头了。\n", me, ob);
  message_vision("\n$N将$n从本帮开除了出去。\n", me, ob);
  me->add("combat_exp", -300000);
  ob->delete("banghui");
  ob->delete("bh_rank");
  return 1;
}

int query_autoload() {
  return 1;
}
void owner_is_killed() {
  destruct(this_object());
}

int remove_wield(string str) {
  string ob, player;
  string banghui;
  object obj, lp, npc, me = this_player();

  if (!geteuid()) seteuid(getuid());
  if (sscanf(str, "%s from %s", ob, player) != 2) return 0;

  if (!(npc = find_player(player)))
    if (!(npc = find_living(player)))
      if (!(npc = present(player, environment(me))))
        return notify_fail("没有这个人\n");

  obj = present(ob, npc);

  if (me->query("banghui") != npc->query("banghui"))
    notify_fail("你只能让本帮派的成员这么做。\n");
  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("bangzhu_id") == npc->query("id"))
    return notify_fail("你不能命令创始人。\n");
  destruct(lp);

  if (!obj) return notify_fail("那里没有那种东东\n");
  else {
    message_vision("$N让" + npc->name() + "脱下$n。\n", me, obj);
    obj->move(me);
    obj->move(npc);
    return 1;
  }
}

int do_tie(string str) {
  object ob1, ob2, lp, me = this_player();
  string st1, st2;

  string banghui;

  if (!str || str == "") return notify_fail("你想让谁跟随谁啊？\n");
  if (sscanf(str, "%s with %s", st1, st2) != 2)
    return notify_fail("tie <ob1> with <ob2>\n");

  if (!ob1 = find_living(st1)) ob1 = LOGIN_D->find_body(st1);
  if (!ob2 = find_living(st2)) ob2 = LOGIN_D->find_body(st2);
  if (!ob1) return notify_fail("找不到 " + st1 + " 这个生物。\n");
  if (!ob2) return notify_fail("找不到 " + st2 + " 这个生物。\n");
  if (ob1 == ob2) return notify_fail("你没问题吧？\n");

  if (me->query("banghui") != ob1->query("banghui"))
    notify_fail("你只能让本帮派的成员这么做。\n");
  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("bangzhu_id") == ob1->query("id") || lp->query("bangzhu_id") == ob2->query("id"))
    return notify_fail("你不能命令创始人。\n");

  printf("你让" + ob1->name(1) + "和" + ob2->name(1) + "互相跟随。\n");
  ob1->set_leader(ob2);
  ob2->set_leader(ob1);
  return 1;
}

int pk_mob(string str) {
  object ob1, ob2, lp, me = this_player();

  string st1, st2;
  string banghui;

  if (!str || str == "") return notify_fail("你想让谁杀谁啊？\n");
  if (sscanf(str, "%s with %s", st1, st2) != 2)
    return notify_fail("pk <ob1> with <ob2>\n");

  if (!ob1 = present(
    st1,
    environment(me)
  ) || !ob1->is_living()) return notify_fail("找不到 " + st1 + " 这个生物。\n");
  if (!ob2 = present(
    st2,
    environment(me)
  ) || !ob2->is_living()) return notify_fail("找不到 " + st2 + " 这个生物。\n");
  if (ob1 == ob2) return notify_fail("你没问题吧？\n");
  if (st1 == "lonely" || st2 == "lonely") return notify_fail("黑客这个人最遵纪守法，想让他打架，下辈子吧。\n");
  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("bangzhu_id") == ob1->query("id") || lp->query("bangzhu_id") == ob2->query("id"))
    return notify_fail("你不能命令创始人。\n");
  destruct(lp);

  if (me->query("banghui") != ob1->query("banghui"))
    notify_fail("你只能让本帮派的成员这么做。\n");

  if (msgon) {
    message_vision(HIR "$N对$n大喊一声：本派仇敌在此，还不快拿下！\n", me, ob1);
    message_vision(HIR "$N满是杀意地瞪了$n一眼，口中“荷荷”有声地冲了上去。\n" NOR, ob1, ob2);
  } else printf("你让" + ob1->name() + "和" + ob2->name() + "互相PK。\n");
  ob1->kill_ob(ob2);
  return 1;
}

int force_go(string str) {
  object ob, obj, lp, env, me = this_player();
  string st1, st2, dir, dest;
  string banghui;
  mapping exit;

  if (!str || str == "") return notify_fail("你想让谁去哪里啊？\n");
  if (sscanf(str, "%s %s", st1, st2) != 2)
    return notify_fail("fgo <ob> <dir>\n");


  if (!ob = present(st1, environment(me)))
    return notify_fail("找不到 " + st1 + " 这个生物.\n");

  if (me->query("banghui") != st1->query("banghui"))
    notify_fail("你只能让本帮派的成员这么做。\n");
  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("bangzhu_id") == st1->query("id"))
    return notify_fail("你不能命令创始人。\n");
  destruct(lp);

  if (st1 == "lonely") return notify_fail("黑客这个人只喜欢发呆，不喜欢四处乱蹿。\n");

  env = environment(me);
  if (!env) return notify_fail("哪里也去不了。\n");

  if (!undefinedp(dir_alias[st2])) st2 = dir_alias[st2];

  if (!mapp(exit = env->query("exits")) || undefinedp(exit[st2]))
    return notify_fail("那个方向没有出路。\n");

  dest = exit[st2];

  if (!(obj = find_object(dest)))
    call_other(dest, "???");
  if (!(obj = find_object(dest)))
    return notify_fail("无法移动。\n");

  dir = obj->query("short");
  if (!undefinedp(dir_desc[st2]))
    dir = dir_desc[st2] + "的" + dir;

  if (msgon) {
    message_vision(HIR "$N对$n说道：此处好像有点问题，你去探察探察。\n", me, ob);
    message_vision(HIR "$N点了点头，小心翼翼地走了过去。\n" NOR, ob);
  } else printf("你让" + ob->name() + "向" + dir + "走去。\n");
  "/cmds/std/go"->main(ob, st2);
  return 1;
}
