//锦缎
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
string check_ip(object ob, object *user);
void create() {
  set_name("锦缎", ({ "jin duan", "duan" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 6000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
void init() {
  add_action("do_more", "more");

}
int do_more(string arg) {
  string file;
  object ob, me;
  me = this_player();

  seteuid(geteuid(me));
  if (!arg) return notify_fail("指令格式 : more <档名>|<物件名> \n");
  file = resolve_path(me->query("cwd"), arg);
  if (file_size(file) < 0) {
    ob = present(arg, me);
    if (!ob) ob = present(arg, environment(me));
    if (!ob) return notify_fail("没有这个档案。\n");
    file = base_name(ob) + ".lpc";
  }
  me->start_more(read_file(file));
  return 1;
}
