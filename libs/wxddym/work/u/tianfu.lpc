// shenliwan.c 神力丸

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "能力点" NOR, ({ "dfads1545e4t2fgsdww" }));
  set_weight(200);
  set("no_drop", "这样东西不能离开你。\n");
  set("no_give", "这样东西不能离开你。\n");
  set("no_put", "这样东西不能离开你。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗亮晶的水球充斥着无尽的力量。\n");
    set("xy_money", 1);

    set("unit", "颗");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);


  {

    tell_object(me, HIC "\n恭喜你：" + NOR + HIG + "能力点的到提升！！！ " + NOR);
    me->add("tianfu_point", 1);
    destruct(this_object());
    return 1;
  }
  tell_object(me, HIC "\n你 武学修养低于400" NOR "\n");
  destruct(this_object());
  return 1;
}
