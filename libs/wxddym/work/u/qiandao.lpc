//签到打卡功能

#include <ansi.h>
#include <localtime.h>
#define QIANDAO "/data/qiandao.o"

inherit NPC;

int do_daka();
int do_query_time();
string ask_clear();
void create() {
  set_name("签到员", ({ "qiandao npc" }));
  set("gender", "男性");
  set("age", 20);
  set("per", 1000000);
  set("con", 1000000);
  set("int", 1000000);
  set("dex", 1000000);
  set("str", 1000000);
  set("qi", 10000000);
  set("max_qi", 10000000);
  set("jing", 10000000);
  set("neili", 10000000);
  set("jiali", 10000000);
  set("max_neili", 10000000);
  set("max_jingli", 10000000);
  set("max_jing", 10000000);
  set("combat_exp", 10000000);
  set("no_suck", 1);
  set("title", HIG "游戏管理员" NOR);
  set("long", "他是负责地狱玩家的签到记录的工作人员。\n");
  set_skill("unarmed", 100);
  set_skill("force", 600);
  set_skill("finger", 100);
  set_skill("blade", 100);
  set_skill("sword", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("tiandaodao", 800);
  set_skill("tiandao-shengong", 100);
  set_skill("tiandao-dunyi", 100);
  set_skill("tiandao-shengti", 100);
  set_skill("martial-cognize", 5000);
  map_skill("force", "tiandao-shengong");
  map_skill("dodge", "tiandao-dunyi");
  map_skill("blade", "tiandaodao");
  map_skill("parry", "tiandao-shengti");
  set_temp("apply/attack", 1000000000);
  set_temp("apply/defense", 1000000000);
  set_temp("apply/armor", 1000000000);
  set_temp("apply/damage", 1000000000);
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("exert youwowudi") :),
    (: command("exert dispel") :),
    (: command("perform blade.tianyi") :),
    (: command("perform blade.weishe") :),
    (: command("perform blade.modao") :),

  }));

  set("no_kill", 1);
  set("inquiry", ([
    "签到": (: do_daka :),
    "查询签到": (: do_query_time :),
    "购买仓库": (: ask_clear :),
  ]));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}


string ask_clear() {
  object me = this_player();
  object obj;
  if (me->query("xy_money") < 100 || present("cangku", me)) {
    command("say 你身上已有随身仓库了或元宝不足100。");
    return 0;
  } else {
    me->add("xy_money", -100);
    obj = new("clone/vip/xiang.lpc");
    obj->move(me);
    return HIG "购买成功，请查看背包。" NOR; ;
  }
}

int do_daka() {
  object me, ob, env;
  mixed *localtime, *localtime2;
  string writeFile, ip, ip2, *meFilePach, meFile, item_max, id, room, target;
  int i, j, ok, day, month, size, data, a;
  int level;

  ob = this_object();
  me = this_player();

  if (ob->query_temp("qiandao_time") > time()) {
    tell_object(me, CYN "签到员说道：慢慢来，让我喘口气。\n" NOR);
    return 1;
  }

  data = me->query("dacard/time");
  localtime = localtime(data);
  localtime2 = localtime(time());

  if (data && localtime[LT_MDAY] == localtime2[LT_MDAY]) {
    tell_object(me, CYN "签到员说道：你今天已经签过到了，明天再来吧。\n" NOR);
    return 1;
  }

  if (localtime[LT_MON] + 1 != localtime2[LT_MON] + 1)  //月份
  {
    me->delete("dacard");
  }

  ob->set_temp("qiandao_time", time() + 2);  //因该方式采取读写硬盘，故稍做限制
  writeFile = QIANDAO;

  if (writeFile) {
    meFile = read_file(writeFile);
    if (meFile)
      meFilePach = explode(meFile, "\n");

    size = sizeof(meFilePach);
    ip = query_ip_number(me);

    item_max = sprintf(
      "ID:%s$Ip:%s$Day:%d$Month:%d",
      me->query("id"),
      ip,
      localtime2[LT_MON] + 1,
      localtime2[LT_MDAY]
    );

    for (i = 0; i < size; i++) {
      sscanf(meFilePach[i], "ID:%s$Ip:%s$Day:%d$Month:%d", id, ip2, day, month);

      if (ip == ip2 && localtime2[LT_MON] + 1 == day && localtime2[LT_MDAY] == month)  //相同文件内容表示本IP已经有人签到
      {
        ok = 1;
        break;
      } else if (ip == ip2) {  //只是IP相同，并没有签到
        ok = 2;
        meFilePach[i] = "";
        break;
      } else
        ok = 0;
    }
  }

  if (ok == 1) {
    tell_object(me, CYN "签到员：这个IP今天已经有人签过到了。\n" NOR);
    return 1;
  }
  if (ok == 2) {
    write_file(writeFile, "", 1);  //初始化该文件
    //重写文件
    for (i = 0; i < size; i++) {
      if (meFilePach[i] == "") continue;  //去掉IP相同的内容
      write_file(writeFile, sprintf("%s\n", meFilePach[i]));  //重写所有内容
    }
  }
  if (ok != 1) {
    write_file(writeFile, sprintf("%s\n", item_max));  //新记录加入文件
  }
  if (!objectp(env = environment(ob))
    || !stringp(room = env->query("short"))) {
    ::die();
    return 1;
  }

  i = 2000 + random(2000);
  j = 10;
  a = 100;


  me->add("combat_exp", i);
  me->add("potential", i);
  me->set("jiebiao", j);
  me->set("yamen", a);
  ob = new("/clone/ts");
  ob->move(me);
  ob = new("/u/shimen2");
  ob->move(me);
  me->add("dacard/cishu", 1);
  me->set("dacard/time", time());

  tell_object(
    me,
    sprintf(CYN + "你获得了经验值 %d点，潜能 %d点，劫镖 %d次，衙门 %d次,师门双倍丹一颗，天师符一张！\n" NOR, i, i, j, a)
  );
  tell_object(me, sprintf(CYN "今日签到成功,祝你游戏愉快！\n" NOR));

  return 1;
}

int do_query_time() {
  int time;
  mixed *localtime;
  object me = this_player();

  time = me->query("dacard/time");
  localtime = localtime(time);
  tell_object(me, sprintf(CYN "你本月到目前为止总共签到 %d次。\n" NOR, me->query("dacard/cishu")));
  tell_object(me, sprintf(CYN "%s的上次签到时间是：%d年%d月%d日%d时%d分%d秒。\n" NOR,
    me->query("name"), localtime[LT_YEAR], localtime[LT_MON] + 1,
    localtime[LT_MDAY], localtime[LT_HOUR], localtime[LT_MIN], localtime[LT_SEC]));
  return 1;
}

void die() {
  object me, ob;

  me = this_object();

  set("eff_qi", 10000);
  set("qi", 10000);
  set("eff_jing", 10000);
  set("jing", 10000);
  set("neili", 90000);
  set("max_jingli", 10000);

  say(me->name() + CYN "说道：我是不死的，你的行为已经被记录在案。\n" NOR);
  return;

}
