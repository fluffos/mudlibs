inherit NPC;

string ask_tiandaodao();
string ask_tiandaojian();
string ask_tiandaoquan();
string ask_tiandaozhang();
string ask_shengti();
string ask_dunyi();
string ask_wudao();
void create()
{
	set_name("死神", ({"死神兄die"}));
	set("gender", "男性");
	set("nickname", HIB"兄die"NOR);
	set("age", 19);
	set("per", 1000000);
	set("con", 1000000);
	set("int", 1000000);
	set("dex", 1000000);
	set("str", 1000000);
	set("qi", 10000000);
	set("max_qi", 10000000);
	set("jing", 10000000);
	set("neili", 10000000);
      set("jiali", 10000000);
	set("max_neili",10000000);
	set("max_jingli",10000000);
	set("max_jing",10000000);
	set("combat_exp",10000000);
	set("no_suck", 1);
	 set("icon", "01394");
	set("long",
		"战神的好兄die\n");
        set_skill("unarmed", 800);
        set_skill("force", 800);
        set_skill("finger", 800);
        set_skill("blade", 800);
        set_skill("sword", 800);
        set_skill("dodge", 800);
        set_skill("parry", 800);
        set_skill("wudao-shanqian", 800);
        set_skill("martial-cognize", 5000);
	  map_skill("force","wudao-shanqian");
	  map_skill("dodge","wudao-shanqian");
	  map_skill("blade","wudao-shanqian");
	  map_skill("parry","wudao-shanqian");
        set_temp("apply/attack", 1000000000);
        set_temp("apply/defense", 1000000000);
        set_temp("apply/armor", 1000000000);
        set_temp("apply/damage", 1000000000);
        set("chat_chance_combat", 120000);
        set("chat_msg_combat", ({
                (: command("perform blade.modao") :),

        }) );
	set("inquiry", ([
               "「演练天道刀奖励」"       : (: ask_tiandaodao :),
               "「演练天道剑奖励」"       : (: ask_tiandaojian :),
               "「演练天道拳奖励」"       : (: ask_tiandaoquan :),
               "「演练天道掌奖励」"       : (: ask_tiandaozhang :),
               "「演练天道圣体奖励」"     : (: ask_shengti :),
               "「演练天道遁一奖励」"     : (: ask_dunyi :),
               "「演练武道奖励」"         : (: ask_wudao :),
	]) );
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/weapon/anyue-dao")->wield();

}

string ask_tiandaodao()
{
	object me;
	object ob;

	me = this_player();
if ( me->query_skill("tiandaodao", 1) < 10 ) return "你还没有演练出天道刀呢！";

       if(!me->query("tiandaodao"))
       {
      me->add("tianfu_point", 5);
	me->set("tiandaodao",1);
	write(HIY"\n死神对你说：兄die这是你的演练天道刀的奖励"NOR"\n");
	write(HIY"\n天赋能力点+5"NOR"\n");

       }
      return HIR+"  一路顺风，谢谢支持[武学大道]"+NOR;
}

