void die()
{
	object me, ob;

	me = this_object();

	set("eff_qi", 10000);
	set("qi", 10000);
	set("eff_jing", 10000);
	set("jing", 10000);
	set("neili", 90000);
	set("max_jingli",10000);

	say( me->name() + CYN "说道：我是不死的，你的行为已经被记录在案。\n"NOR);
	return;

}



