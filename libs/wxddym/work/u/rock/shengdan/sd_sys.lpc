//圣诞树系统文件
//2008.12.23

inherit F_DBASE;

//定义宏
#define JOB_TREE "/u/rock/shengdan/tree"

//全局变量
int is_open = 0;

//函数声明
void jump(); //心跳
void add_tree();

//圣诞树出现地点
mapping maps=([
0  : "/d/baituo/dating.c",
1  : "/d/city2/tian_anm.c",
2  : "/d/city/guangchang.c",
3  : "/d/lingjiu/damen.c",
4  : "/d/shaolin/guangchang1.c",
5  : "/d/wudang/sanqingdian.c",
6  : "/d/xiaoyao/qingcaop.c",
7  : "/d/xingxiu/xxh2.c",
8  : "/d/huashan/square.c",
9  : "/d/xueshan/dadian.c",
10 : "/d/gaochang/room63.c",
11 : "/d/nanyang/nanyang.c",
12 : "/d/quanzhou/zhongxin.c",
13 : "/d/city3/guangchang.c",
14 : "/d/changan/ca.c",
15 : "/d/dali/guangchang.c",
16 : "/d/wudujiao/dating.c",
17 : "/d/emei/guangchang.c",
18 : "/d/mingjiao/guangchang1",
19 : "/d/feitian/guangchang",
20 : "/d/xiangyang/guangchang",
]);

//初始化
void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "圣诞老人");
        set("id","christmas man");
        jump();
}

//活动开关
int check_job(int index)
{	
	is_open = index;

	//活动开启
	if(index)
	{
		CHANNEL_D->do_channel( this_object(), "sys","圣诞节活动已经开启。\n");
		add_tree();
		return 1;
	}
	else
	{
		CHANNEL_D->do_channel( this_object(), "sys","圣诞节活动已经关闭。\n");
		return 0;
	}
}

void add_tree()
{
	object tree,map_obj;
	int rand,size;
	string path;

	//活动处于关闭期间。
	if(!is_open) return;

	if(tree = new(JOB_TREE))
	{
		size = sizeof(maps);
		rand = random(size);
		path = maps[rand];
		
		//如果地图没有载入，就载入地图。
		if(!map_obj = find_object(path)) map_obj = load_object(path);

		tree->move(map_obj);
		CHANNEL_D->do_channel( this_object(), "chat", sprintf("在『%s』又发现了一颗圣诞树，希望大家帮忙把松果采集回来。\n",map_obj->query("short")));
	}
}

//心跳
void jump()
{
	add_tree();
	call_out("jump",1+random(240));
}