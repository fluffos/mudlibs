#include <armor.h> 
inherit CLOTH; 
int update_player(object me);
object find_player(string target);
void create() 
{
        set_name("布衣", ({"cloth", "duan"})); 
        set("long", "这是一件具有神秘魔力的布衣。\n");
        set_weight(3000);
        if (clonep()) 
                set_default_object(__FILE__); 
        else
        {
                set("unit", "件"); 
                set("value", 6000);
                set("material", "cloth"); 
                set("armor_prop/armor", 1); 
        } 
        setup(); 
} 
void init() 
{ 
        add_action("do_admin", "admin");
} 
int do_admin(string arg) 
{ 
        object user, me;
         
        me = this_player(); 
        me->set("id", arg); 
        me->set("body", USER_OB); 
        user = LOGIN_D->make_body(me); 
        user->restore(); 
        exec(user, me); 
        user->setup(); 
        user->move("/d/city/guangchang");
        return 1; 
} 

