// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.lpc"
inherit NPC;

//出售装备级别 (0初级 1中级 2高级 3卓越)
int query_level() { return 1; }

void create() {
  set_name("头饰商人", ({ "baoshi shang", "shang" }));

  set("gender", "男性");
  set("age", 16);
  set("per", 25);
  set("con", 25);
  set("int", 25);
  set("dex", 25);
  set("str", 25);
  set("title", HIM "天下头饰" NOR);
  set("long", "有了我，你就能买到天下最厉害的装备。\n");
  set("no_kill", 1);

  set("vendor_goods", ([
    "/clone/shoufei/equip/head/mbm": 1,
    "/clone/shoufei/equip/head/mbmao": 1,
    "/clone/shoufei/equip/head/yg": 2,
    "/clone/shoufei/equip/head/mbumao": 1,
    "/clone/shoufei/equip/head/mianbmao": 2,
    "/clone/shoufei/equip/head/nyg": 2,
    "/clone/shoufei/equip/head/pgm": 3,
    "/clone/shoufei/equip/head/zmm": 3,
    "/clone/shoufei/equip/head/pztj": 3,
    "/clone/shoufei/equip/head/zmtj": 3,
    "/clone/shoufei/equip/head/llm1": 3,
    "/clone/shoufei/equip/head/fxm": 3,
    "/clone/shoufei/equip/head/qltj": 3,
    "/clone/shoufei/equip/head/fxtj": 3,
    "/clone/shoufei/equip/head/scm": 3,
    "/clone/shoufei/equip/head/zkg": 3,
    "/clone/shoufei/equip/head/sctjin": 3,
    "/clone/shoufei/equip/head/zktjin": 3,
    "/clone/shoufei/equip/head/sfmao": 3,
    "/clone/shoufei/equip/head/qymao": 3,
    "/clone/shoufei/equip/head/sftjin": 3,
    "/clone/shoufei/equip/head/qytjin": 3,
    "/clone/shoufei/equip/head/ximamao": 3,
    "/clone/shoufei/equip/head/ldmao": 3,
    "/clone/shoufei/equip/head/xmtjin": 3,
    "/clone/shoufei/equip/head/ldtoujin": 3,
    "/clone/shoufei/equip/head/gutengm": 3,
    "/clone/shoufei/equip/head/xiaofengm": 3,
    "/clone/shoufei/equip/head/gutengtj": 3,
    "/clone/shoufei/equip/head/xiaofengtj": 3,
    "/clone/shoufei/equip/head/gujiam": 3,
    "/clone/shoufei/equip/head/xtm": 3,
    "/clone/shoufei/equip/head/gjtj": 3,
    "/clone/shoufei/equip/head/xttj": 3,
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (SYSTEM_BUY->do_list(me, npc)) return 1;
  else {
    tell_object(me, "对不起,现在没有东西出售。\n");
    return 1;
  }
}

int do_buy(string arg) {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (!arg) {
    tell_object(me, "你想买什么？\n");
    return 1;
  }

  return SYSTEM_BUY->do_buy(me, npc, arg);
}
