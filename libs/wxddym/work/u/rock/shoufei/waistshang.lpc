// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.c"
inherit NPC;

//出售装备级别 (0初级 1中级 2高级 3卓越)
int query_level() { return 1; }

void create()
{
	set_name("腰带商人", ({ "baoshi shang", "shang"}));

	set("gender", "男性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"天下腰带"NOR);
	set("long","有了我，你就能买到天下最厉害的装备。\n");
	set("no_kill",1);

	set("vendor_goods", ([
		"/clone/shoufei/equip/waist/byd"         : 1,
		"/clone/shoufei/equip/waist/tyd"         : 1,
		"/clone/shoufei/equip/waist/pgyd"        : 2,
		"/clone/shoufei/equip/waist/zmyd"        : 2,
		"/clone/shoufei/equip/waist/buyd"        : 1,
		"/clone/shoufei/equip/waist/tieyd"       : 1,
		"/clone/shoufei/equip/waist/qinglyd"     : 2,
		"/clone/shoufei/equip/waist/fuxyd"       : 2,
		"/clone/shoufei/equip/waist/buyaod"      : 1,
		"/clone/shoufei/equip/waist/tieyaod"     : 1,
		"/clone/shoufei/equip/waist/shachangyd"  : 2,
		"/clone/shoufei/equip/waist/kongzhanyd"  : 2,
		"/clone/shoufei/equip/waist/buyaodai"    : 1,
		"/clone/shoufei/equip/waist/tieyaodai"   : 1,
		"/clone/shoufei/equip/waist/shuifeng"    : 2,
		"/clone/shoufei/equip/waist/qingyun"     : 2,
		"/clone/shoufei/equip/waist/byaodai"     : 1,
		"/clone/shoufei/equip/waist/tyaodai"     : 1,
		"/clone/shoufei/equip/waist/xmyaodai"    : 2,
		"/clone/shoufei/equip/waist/ldyaodai"    : 2,
		"/clone/shoufei/equip/waist/byaod"       : 1,
		"/clone/shoufei/equip/waist/tyaod"       : 1,
		"/clone/shoufei/equip/waist/gutyaod"     : 2,
		"/clone/shoufei/equip/waist/xiaof"       : 2,
		"/clone/shoufei/equip/waist/tieyd1"      : 1,
		"/clone/shoufei/equip/waist/guj"         : 1,
		"/clone/shoufei/equip/waist/xtie"        : 2,
	]));                                
                                            
	setup();                            
	carry_object("/clone/cloth/cloth")->wear();
}                                           
                                            
void init()                                 
{                                           
        add_action("do_list", "list");      
        add_action("do_buy", "buy");        
}

int do_list()
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(SYSTEM_BUY->do_list(me,npc)) return 1;
	else
	{
		tell_object(me,"对不起,现在没有东西出售。\n");
		return 1;
	}
}

int do_buy(string arg)
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(!arg)
	{
		tell_object(me,"你想买什么？\n");
		return 1;
	}

	return SYSTEM_BUY->do_buy(me,npc,arg);
}