// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.c"
inherit NPC;
inherit F_DEALER;

//出售装备级别 (0初级 1中级 2高级 3卓越)
int query_level() { return 1; }

void create()
{
	set_name("衣服商人", ({ "baoshi shang", "shang"}));

	set("gender", "男性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"天下成衣"NOR);
	set("long","有了我，你就能买到天下最厉害的装备。\n");
	set("no_kill",1);

	set("vendor_goods", ([
		"/clone/shoufei/equip/cloth/macloth"     : 1,
		"/clone/shoufei/equip/cloth/mabcloth"    : 1,
		"/clone/shoufei/equip/cloth/mbcloth"     : 2,
		"/clone/shoufei/equip/cloth/miancloth"   : 2,
		"/clone/shoufei/equip/cloth/ximcloth"    : 2,
		"/clone/shoufei/equip/cloth/xmcloth"     : 2,
		"/clone/shoufei/equip/cloth/piqun"       : 3,
		"/clone/shoufei/equip/cloth/qlqun"       : 3,
		"/clone/shoufei/equip/cloth/picloth"     : 3,
		"/clone/shoufei/equip/cloth/sfy"         : 3,
		"/clone/shoufei/equip/cloth/sfq"         : 3,
		"/clone/shoufei/equip/cloth/xmy"         : 3,
		"/clone/shoufei/equip/cloth/xmq"         : 3,
		"/clone/shoufei/equip/cloth/gjq"         : 3,
		"/clone/shoufei/equip/cloth/zmqun"       : 3,
		"/clone/shoufei/equip/cloth/fxqun"       : 3,
		"/clone/shoufei/equip/cloth/kzqun"       : 3,
		"/clone/shoufei/equip/cloth/qyq"         : 3,
		"/clone/shoufei/equip/cloth/ldq"         : 3,
		"/clone/shoufei/equip/cloth/ldq"         : 3,
		"/clone/shoufei/equip/cloth/xtieq"       : 3,
		"/clone/shoufei/equip/cloth/ziman"       : 3,
		"/clone/shoufei/equip/cloth/fxyi"        : 3,
		"/clone/shoufei/equip/cloth/zkyi"        : 3,
		"/clone/shoufei/equip/cloth/qyy"         : 3,
		"/clone/shoufei/equip/cloth/ldy"         : 3,
		"/clone/shoufei/equip/cloth/xfcy"        : 3,
	]));                                
                                            
	setup();   
	set_max_encumbrance(100000000);
	if (clonep()) keep_heart_beat();                         
	carry_object("/clone/cloth/cloth")->wear();
}                                           
                                            
void init()
{
	add_action("do_buy", "buy");
	add_action("do_list", "list");
	add_action("do_drop", "drop");
}

