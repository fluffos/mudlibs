// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.c"
inherit NPC;

//出售装备级别 (0初级 1中级 2高级 3卓越)
int query_level() { return 1; }

void create()
{
	set_name("铠甲商人", ({ "baoshi shang", "shang"}));

	set("gender", "男性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"天下铠甲"NOR);
	set("long","有了我，你就能买到天下最厉害的装备。\n");
	set("no_kill",1);

	set("vendor_goods", ([
		"/clone/shoufei/equip/armor/gj"   : 1,
		"/clone/shoufei/equip/armor/xtj"   : 1,
		"/clone/shoufei/equip/armor/qlj"   : 1,
		"/clone/shoufei/equip/armor/scj"   : 1,
		"/clone/shoufei/equip/armor/gtj"   : 1,
		"/clone/shoufei/equip/armor/llzpao"   : 1,
		"/clone/shoufei/equip/armor/pyzj"   : 1,
		"/clone/shoufei/equip/armor/bwzpao"   : 1,
		"/clone/shoufei/equip/armor/shzp"   : 1,
	]));                                
                                            
	setup();                            
	carry_object("/clone/cloth/cloth")->wear();
}                                           
                                            
void init()                                 
{                                           
        add_action("do_list", "list");      
        add_action("do_buy", "buy");        
}

int do_list()
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(SYSTEM_BUY->do_list(me,npc)) return 1;
	else
	{
		tell_object(me,"对不起,现在没有东西出售。\n");
		return 1;
	}
}

int do_buy(string arg)
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(!arg)
	{
		tell_object(me,"你想买什么？\n");
		return 1;
	}

	return SYSTEM_BUY->do_buy(me,npc,arg);
}