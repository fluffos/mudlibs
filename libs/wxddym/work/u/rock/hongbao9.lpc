#include <ansi.h>

inherit ITEM;

int do_check();

void create() {
  set_name(HIR "元宵节成长包裹" NOR, ({ "bao" }));
  set_weight(200);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    set("nopaimai", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("unit", "个");
  }
}

void init() {
  object item = this_object();
  object me = this_player();

  if (!item->query("long")) {
    set(
      "long",
      sprintf(HIY "金庸梦恭祝 %s ：" + BLINK + HIR + "\n虎年元宵节快乐！打开它请用(check)指令。\n" NOR, me->name())
    );
  }
  add_action("do_check", "check");
}

int do_check() {
  object me = this_player();
  object item;

  message_vision(sprintf("$N小心翼翼的打开%s。\n", this_object()->name()), me);
  if (item = new("/u/rock/chengzhang")) {
    item->move(me);
    tell_object(me, sprintf(HIG "恭喜你！获得了%s。\n" NOR, item->name()));
  }
  destruct(this_object());

  return 1;
}
