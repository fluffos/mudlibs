// By rock&jym

inherit ITEM;
int rock = random(5);
mapping *weapon = ({
  ([ "name": "青铜",
    "id": "qing tong",
    "yanse": HIC,
    "int": 2,
  ]),
  ([ "name": "黄铜",
    "id": "huang tong",
    "yanse": HIY,
    "str": 2,
  ]),
  ([ "name": "白铜",
    "id": "bai tong",
    "yanse": HIW,
    "dex": 2,
  ]),
  ([ "name": "绿铜",
    "id": "lv tong",
    "yanse": HIG,
    "con": 2,
  ]),
  ([ "name": "紫铜",
    "id": "zi tong",
    "yanse": MAG,
    "damage": 50,
  ]),
});
void create() {
  string name, id;

  name = weapon[rock]["name"];

  set_name(weapon[rock]["yanse"] + name + NOR, ({ weapon[rock]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("no_put", 1);
  set("value", 5);
  if (weapon[rock]["str"])
    set("str", weapon[rock]["str"]);
  if (weapon[rock]["con"])
    set("con", weapon[rock]["con"]);
  if (weapon[rock]["dex"])
    set("dex", weapon[rock]["dex"]);
  if (weapon[rock]["int"])
    set("int", weapon[rock]["int"]);
  if (weapon[rock]["damage"])
    set("damage", weapon[rock]["damage"]);
  set("long", "这是一个铜级的金属，可以用来合成兵器！)\n");

  setup();
}
