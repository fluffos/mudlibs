inherit ITEM;

void create() {
  set_name(HIW "白虎石" NOR, ({ "baihu shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("value", 50);
  set("no_put", 1);
  set("no_give", 1);
  set("zhongji_hc", 1);
  set("bh", 2);
  set("str", 5);
  set("damage", 100);
  set("long", "这是一个高级的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
