// By rock&jym

inherit ITEM;
int rock = random(4);
mapping *weapon = ({
  ([ "name": "日月岩",
    "id": "riyue yan",
    "yanse": HIY,
    "int": 25,
    "damage": 50,
    "lei": 1,
  ]),
  ([ "name": "阴阳石",
    "id": "yinyang shi",
    "yanse": HIW,
    "str": 25,
    "damage": 50,
    "lei": 2,
  ]),
  ([ "name": "太级钢",
    "id": "taiji gang",
    "yanse": WHT,
    "dex": 25,
    "damage": 50,
    "lei": 3,
  ]),
  ([ "name": "赤血铁",
    "id": "chixue tie",
    "yanse": HIR,
    "con": 25,
    "damage": 50,
    "lei": 4,
  ]),
});
int panduan(int arg) { if (arg) rock = arg - 1; }
void create() {
  string name, id;

  name = weapon[rock]["name"];

  set_name(weapon[rock]["yanse"] + name + NOR, ({ weapon[rock]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("no_drop", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("zhongji_hc", 1);
  set("bh", weapon[rock]["lei"]);
  if (weapon[rock]["str"])
    set("str", weapon[rock]["str"]);
  if (weapon[rock]["con"])
    set("con", weapon[rock]["con"]);
  if (weapon[rock]["dex"])
    set("dex", weapon[rock]["dex"]);
  if (weapon[rock]["int"])
    set("int", weapon[rock]["int"]);
  if (weapon[rock]["damage"])
    set("damage", weapon[rock]["damage"]);
  set("long", "这是一个高级的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
