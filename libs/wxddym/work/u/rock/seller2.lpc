inherit "/feature/jh_dealer";
inherit NPC; 

string ask_me();

void create()
{

        set_name("商店伙计", ({ "shop seller", "seller" }));
        set("title", "VIP商店伙计");
        set("kaifa",38);
        set("jizhi",46);
        set("shen_type", 1);
        set("gender", "男性");
        set("age", 45);
        set("long",
                "VIP商店的伙计。\n");
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_temp("apply/damage", 15);
        set("combat_exp", 40000);
        set("attitude", "friendly");
        set("vendor_goods", ({
"/d/vip/shop/obj/zhulou",
"/d/vip/shop/obj/yitian-jian",
"/d/vip/shop/obj/tulong-dao",
"/d/vip/shop/obj/hanzhu",
"/d/vip/shop/obj/karwan",
"/d/vip/shop/obj/perwan",
"/d/vip/shop/obj/shenliwan",
"/d/vip/shop/obj/xiandan",
"/d/vip/shop/obj/xisuidan",
"/d/vip/shop/obj/dexwan",
"/d/vip/shop/obj2/jiasha",
"/d/vip/shop/obj2/yuyi",
"/d/vip/shop/obj2/ring",
"/d/vip/shop/obj2/shoe",
"/d/vip/shop/obj2/yaodai",
"/d/vip/shop/obj2/toukui",
"/d/vip/shop/obj/huwan",
"/d/vip/shop/obj2/xianglian",
"/d/vip/shop/obj/xieyi",
"/d/vip/shop/obj/jue1",
"/d/vip/shop/obj/jue2",
"/d/vip/shop/obj/jue3",
"/d/vip/shop/obj/jue4",
 "/d/vip/shop/obj/xiangqiefu",
"/d/vip/shop/obj/xiangqiezhou",
  "/d/vip/shop/obj/ganjiangling",
    "/d/vip/shop/obj/moxieling",
        }));
                set("inquiry", ([
    "vip":(:ask_me:),
        ]) );
        setup();
        carry_object("/clone/misc/changpao")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
        add_action("do_check", "check");
        add_action("do_zhuan", "zhuantyb");


}
string ask_me()
{
        object ob;
         if (!this_player()->query("vip")) 
return "得了吧,请加入VIP先！";
         if (this_player()->query("vipgetget")>1) 
return "得了吧,拿过了还来！";
      this_player()->add("baivip",40);
     this_player()->set("vipgetget",10);

return "恭喜你获得VIP赠送的40天涯币";
}

int do_check(string arg)
{
        object me;

        me = this_player();

      if (me->query("vip"))
           { command("tell "+me->query("id")+" 你目前拥有天涯币为"+me->query("baivip")+"！\n"); return 1;}
        return 1;
}
int do_zhuan(string arg)
{
        string target, item;
        object obj, who, *inv, obj2;
        int i, amount, str;
          object me = this_player();
if(!arg) return notify_fail("您要转给哪个玩家？请把他也叫过来!\n"); 
        if( !me->query("vip/vip") )
                return notify_fail("暂时非VIP玩家不能转！\n");

if( sscanf(arg, "%d to %s", str, target)==2
 || sscanf(arg, "%s %d", target, str)==2 );
        else return notify_fail("你要转给哪个玩家？\n");

        if(!objectp(who = present(target, environment(me))))
        return notify_fail("这里没有这个人。\n");

        if (who==me) return notify_fail("给自己转帐?\n");

        if( !who->query("vip/vip") )
                return notify_fail("暂时非VIP玩家不能转！\n");

        if (wizardp(me)) return notify_fail("巫师不能转帐!\n");
        if(me->is_busy())
        return notify_fail("还是先将你手上的事情做完了再给吧!\n");
         
          if (me->query("baivip")<str)
   return notify_fail("你钱庄里没这么多天涯币吧\n");

        if( !userp(who) )
        return notify_fail("对不起只能转帐给玩家。\n");

        if (!living(who)) 
    return notify_fail("嗯!很显然,"+who->name()+"现在正躺着,不能马上爬起来接受你的馈赠!\n");
                
        if( str < 1 )        return notify_fail("最少要转1枚。\n"); 

        if( str >= 1 )
log_file("login/baivip",sprintf("%s转了%d枚天涯币给 %s,他的天涯币有%d个,(%s)\n",
me->query("id"), str , who->query("id") , me->query("baivip"),
"/cmds/usr/rtime.c"->chinese_time(5,ctime(time())) ) );
me->add("baivip",-str);
who->add("baivip",str);
me->start_busy(3);
me->save();
who->save();
 message_vision(HIY""+me->name()+"转了"+str+"枚天涯币到"+who->name()+"的户头。\n"NOR,who,me);
 
return 1;
}
