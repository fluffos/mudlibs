//点卡交易系统 NPC
//edit by rock
//2008年10月29日

#include <ansi.h>
inherit NPC;

#define FILE "/data/points.txt"

int do_YbToFz();
int do_FzToYb();
int do_XuLie();

void create() {
  set_name("货币管理员", ({ "huobi yuan", "yuan" }));
  set("title", HIM "元宝兑换员" NOR);
  set("age", 55);
  set("long", "有了我，您可以随意兑换元宝和元宝。\n");

  set("inquiry", ([
    "元宝兑换元宝": (: do_YbToFz :),
    "元宝兑换元宝": (: do_FzToYb :),
    "输入序列号兑换元宝": (: do_XuLie :),
  ]));

  set("no_kill", 1);

  setup();
}

int do_YbToFz() {
  object me;

  me = this_player();

  tell_object(me,
    HIY "兑换元宝使用规则:\n" NOR + WHT
    "您可以用游戏币兑换元宝，其兑换比例为 50万游戏币(元宝) 兑换 1枚元宝。\n"
    "每次只可兑换 50万游戏币(元宝)，如果兑换失败，可能因为您的游戏币(元宝)余\n"
    "额不足。请确认余额后兑换。或向巫师寻求帮助，但巫师不会为您手工兑换。兑换\n"
    "后，不得以任何理由要求退换，或要求以同比例兑换回游戏币(元宝)。兑换时，请\n"
    "您仔细阅读此规则。\n"
    "确认兑换请输入[y]，离开请输入[n]\n"
    "                                                  [金庸梦]&[天涯]巫师组\n" NOR
  );
  input_to("do_YbToFz_2", me);
  return 1;
}

//函数：兑换元宝
void do_YbToFz_2(string arg, object me) {
  int yb_money, money;

  if (!me) return;

  if (arg != "y") {
    tell_object(me, "本次兑换已经取消。\n");
    return;
  }

  yb_money = to_int(me->query("jym_money", 1));
  if (yb_money < 500000) {
    tell_object(me, HIR "兑换失败：您的游戏币余额不足，无法兑换。\n" NOR);
    return;
  }

  me->set("jym_money", yb_money - 500000);
  money = me->query("jym_money", 1);
  me->set("jym_money", money + 1);

  tell_object(me, HIY "兑换完成，请(score)查看余额。\n" NOR);
}


int do_FzToYb() {
  object me;

  me = this_player();

  tell_object(me,
    HIY "兑换元宝使用规则:\n" NOR + WHT
    "您可以用元宝兑换游戏币，其兑换比例为 1枚元宝 兑换 30万游戏币(元宝)。\n"
    "每次只可兑换 1枚元宝，如果兑换失败，可能因为您的元宝余额不足。请确认\n"
    "余额后兑换。或向巫师寻求帮助，但巫师不会为您手工兑换。兑换后，不得以任何\n"
    "理由要求退换，或要求以同比例兑换回元宝。兑换时，请您仔细阅读此规则。\n"
    "确认兑换请输入[y]，离开请输入[n]\n"
    "                                                  [金庸梦]&[天涯]巫师组\n" NOR
  );
  input_to("do_FzToYb_2", me);
  return 1;
}

//函数：兑换元宝
void do_FzToYb_2(string arg, object me) {
  int yb_money, money;

  if (!me) return;

  if (arg != "y") {
    tell_object(me, "本次兑换已经取消。\n");
    return;
  }

  money = to_int(me->query("jym_money", 1));
  if (money < 1) {
    tell_object(me, HIR "兑换失败：您的元宝余额不足，无法兑换。\n" NOR);
    return;
  }

  me->set("jym_money", money - 1);
  yb_money = me->query("jym_money", 1);
  me->set("jym_money", yb_money + 300000);

  tell_object(me, HIY "兑换完成，请(score)查看余额。\n" NOR);
}


int do_XuLie() {
  object me;

  me = this_player();

  tell_object(me,
    HIY "兑换元宝使用规则:\n" NOR + WHT
    "您可以用人民币充值为元宝，一个序列号价值10枚元宝。每次只可充值一个序\n"
    "列号(10枚元宝)，如果兑换失败，可能因为您的序列号正在被使用中。请核对序\n"
    "列号后再次充值。或向巫师寻求帮助，但巫师不会为您手工充值。充值成功后，不\n"
    "得以任何理由要求退换。巫师组所得金额将全部用于服务器托管，网站建设，购置\n"
    "游戏引擎之用。兑换时，请您仔细阅读此规则。\n"
    "确认充值请输入[y]，离开请输入[n]\n"
    "                                                  [金庸梦]&[天涯]巫师组\n" NOR
  );
  input_to("do_XuLie_2", me);
  return 1;
}

//函数：兑换元宝
void do_XuLie_2(string arg, object me) {
  if (!me) return;

  if (arg != "y") {
    tell_object(me, "本次充值已经取消。\n");
    return;
  }

  tell_object(me, HIC "请输入CARD，举例:JYM599062294\n" NOR);
  input_to("do_XuLie_3", me);
}

void do_XuLie_3(string arg, object me) {
  if (!me) return;

  if (arg == " ") {
    tell_object(me, "你输入的CARD不正确，请核对后再输入。\n");
    return;
  }
  tell_object(me, HIC "请输入SN，举例:76 1010 114 16 21 21 656984441\n" NOR);
  input_to("do_XuLie_4", me, arg);
}

void do_XuLie_4(string arg, object me, string send_card) {
  string file, card, sn, *AllCard, temp;
  int i, size, index_card, index = 0, mianzhi;

  if (!me) return;

  if (!send_card || arg == " ") {
    tell_object(me, "你的输入不正确，请核对后再输入。\n");
    return;
  }

  file = read_file(FILE);
  if (!file) {
    tell_object(me, "对不起！充值系统正在维护。请稍候再试。\n");
    return;
  }

  AllCard = explode(file, "\n");

  size = sizeof(AllCard);
  for (i - 0; i < size; i++) {
    if (sscanf(AllCard[i], "CARD:%s  SN:%s", card, sn) != 2) continue;
    //对比CARD
    if (send_card == card) {
      if (sn == arg) {
        sscanf(card, "%s %d", temp, mianzhi);
        tell_object(me, HIY "充值成功，请score察看余额。\n" NOR);
        tell_object(me, sprintf(HIY "你在此ID中充值了 %d 个元宝。\n" NOR, mianzhi));
        me->add("jym_money", mianzhi);  //增加元宝
        AllCard[i] = "";            //删除此序列号
        index++;                   //说明操作成功
        log_file(
          "chongzhi.txt",
          sprintf(
            "%s(%s) 充值成功 CARD:%s  SN:%s\n",
            me->query("name"),
            me->query("id"),
            send_card,
            arg
          )
        );
        break;
      }
    }
  }

  if (index) {
    //初始化文件
    write_file(FILE, "", 1);

    //重写文件
    for (i = 0; i < size; i++) {
      if (AllCard[i] == "") continue;
      write_file(FILE, sprintf("%s\n", AllCard[i]));
    }
  } else {
    tell_object(me, "你输入的CARD或SN不正确，请核对后再次输入。\n");
    log_file(
      "chongzhi_bad.txt",
      sprintf(
        "%s(%s) 试图使用 CARD:%s  SN:%s 进行充值。\n",
        me->query("name"),
        me->query("id"),
        send_card,
        arg
      )
    );
    return;
  }
}
