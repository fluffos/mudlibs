//乾坤锁
//edit by rock
//2009.1.1

inherit ITEM;

#define PET_FILE "/u/rock/pet.lpc"

void create()
{
	set_name("乾坤锁", ({"qiankun suo"}));

	if( clonep() ) 
		set_default_object(__FILE__); 
	else { 
		set("unit", "条"); 
		set("long","一条能锁住活物心智的链子。使用指令：arrest <使用对象ID>\n");
	} 

	setup();
}

void init()
{
	add_action("do_get", "arrest");
}

int do_get(string arg)
{
	object me = this_player(),pet,new_pet;
	int rand = random(100);
	
	if(!arg)
	{
		tell_object(me,"你要捕捉什么？\n");
		return 1;
	}
	if(!pet = present(arg, environment(me)))
	{
		tell_object(me,sprintf("这里没有%s。\n",arg));
		return 1;
	}
	if(me->query_temp("pet"))
	{
		tell_object(me,"你带领了一只宠物，无法捕捉。\n");
		return 1;
	}
	if(rand < 10)
	{
		if(pet->query_max_hp() > me->query_max_hp()
			|| pet->query_max_jing() > me->query_max_jing()
			|| pet->query_max_jingli() > me->query_max_jingli()
			|| pet->query_level() > me->query_level()
			|| pet->query("combat_exp") > me->query("combat_exp")
			|| !pet->is_npc() )
		{
			tell_object(me,"他挣脱了乾坤锁。捕捉失败！\n");
			destruct(this_object());
			return 1;
		}
		
		//设置为宠物
		if(new_pet = new(PET_FILE))
		{
			//设置随机1项宠物技能
			switch(random(10))
			{
				//伤害吸收
				case 0 :
					new_pet->set("xishou",10);   break;
				//恢复
				case 1 :
					new_pet->set("huifu",500);  break;
				//提升攻击
				case 2 :
					new_pet->set("gongji",800); break;
				//提升防御
				case 3 :
					new_pet->set("fangyu",500); break;
				//增加气血
				case 4 :
					new_pet->set("qi",5000); break;
				//增加精力
				case 5 :
					new_pet->set("jing",5000); break;
				//增加精气
				case 6 :
					new_pet->set("jingli",5000); break;
				//增加内力
				case 7 :
					new_pet->set("neili",5000); break;
				//伤害反射
				case 8 :
					new_pet->set("fanshang",10); break;
				//传送门
				case 9 :
					new_pet->set("chuansong",1); break;
			}
			new_pet->set("food",100);
			new_pet->set("water",100);
//			new_pet->set("name",sprintf("宠物%s",pet->query("name")));
//			new_pet->set("id",pet->query("id"));
			new_pet->set_name(sprintf(HIY"宠物"NOR"%s",pet->query("name")), ({ sprintf("pet %s",pet->query("id")) }) );
			new_pet->set("owner_id",me->query("id"));
			new_pet->set("old_owner_id",me->query("id"));
			new_pet->set("owner",me);
			new_pet->set("shouming",200);
			new_pet->save();
			new_pet->move(environment(me));
			new_pet->pet_heart();
			tell_object(me,"恭喜你，捕捉成功！\n");
			me->set_temp("pet",new_pet);
			destruct(this_object());
			return 1;
		}
	}
	else
	{
		tell_object(me,"他挣脱了乾坤锁。捕捉失败！\n");
		destruct(this_object());
		return 1;
	}
}