#include <ansi.h>

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param) {
  int amt;

  if (sscanf(param, "%d", amt) == 1)
    set_amount(amt);
}

void setup() {
  set_amount(1);
  ::setup();
}

void create() {
  set_name(HIC "小双倍丹" NOR, ({ "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("xy_money", 2000);
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("unit", "颗");
    set("base_unit", "颗");
    set("base_weight", 10);
    set("base_value", 10000);
    set("long", "这是一颗双倍丹，可以增加半个小时的双倍时间(对师门任务,劫镖有效)。\n");
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  object ob1;

  me->apply_condition("db_exp", 180 + me->query_condition("db_exp"));

  write(YEL "你服下一颗" HIC "师门双倍丹" YEL "，顿觉神清气爽、思维敏捷!" NOR "\n");
  add_amount(-1);
  return 1;
}
