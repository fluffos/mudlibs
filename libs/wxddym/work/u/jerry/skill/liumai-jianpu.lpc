//add jerry
//2008.12.16

inherit ITEM;
void create() {
  set_name("六脉神剑谱", ({ "picture" }));
  set_weight(50);
  set("no_drop", "这样东西不能离开你。\n");
  set("no_give", "这样东西不能给人。\n");
  set("no_get", "这样东西不能给人。\n");
  set("ty_gift", "这样东西不能给人。\n");

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "\n这是用来学习六脉神剑的图谱。\n");
    set("material", "paper");
    set("skill", ([
      "name": "liumai-shenjian",  // name of the skill
      "exp_required": 0,  // minimum combat experience required
      "jing_cost": 20 + random(20),     // jing cost every time study this
      "difficulty": 40,  // the base int to learn this skill
      "max_skill": 1000,    // the maximum level you can learn
    ]));

  }
}
int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  message("channel:rumor", HIY "【宝典书籍】" + "某人：六脉神剑谱被" +
    dest->query("name") + "抢到手了！\n" NOR, users());
  return 1;
}

void init() {
  if (this_player() == environment()) {
    add_action("do_study", "study");
    add_action("do_study", "du");
  }
}
int do_study(string arg) {

  mapping skl;
  string *sname;
  int i, nf, nh, ts, skl_level;
  int my_combat_exp, dj;
  object me;
  me = this_player();
  dj = me->query("jym_level/level");
  if (dj > 1) {
    if (dj == 2) my_combat_exp = (int)me->query("combat_exp") + 10000000;
    if (dj == 3) my_combat_exp = (int)me->query("combat_exp") + 30000000;
    if (dj == 4) my_combat_exp = (int)me->query("combat_exp") + 60000000;
    if (dj == 5) my_combat_exp = (int)me->query("combat_exp") + 100000000;
    if (dj == 6) my_combat_exp = (int)me->query("combat_exp") + 150000000;
    if (dj == 7) my_combat_exp = (int)me->query("combat_exp") + 210000000;
    if (dj == 8) my_combat_exp = (int)me->query("combat_exp") + 280000000;
    if (dj == 9) my_combat_exp = (int)me->query("combat_exp") + 360000000;
    if (dj == 10) my_combat_exp = (int)me->query("combat_exp") + 450000000;
    if (dj > 10)
      my_combat_exp = (int)me->query("combat_exp") + (450000000 + ((dj - 10) * 100000000));
  } else {
    my_combat_exp = (int)me->query("combat_exp");
  }


  if (!arg || arg != "picture") return notify_fail("你要读什么？\n");
  if (me->is_busy()) {
    tell_object(me, "你现在正忙着呢。\n");
    return 1;
  }
  if ((int)me->query_skill("yiyang-zhi", 1) < 480) {
    tell_object(me, "练习六脉神剑，需要先学习一阳指到480级以上！\n");
    return 1;
  }

  skl_level = me->query_skill("liumai-shenjian", 1);
  /*
        if( my_combat_exp < (int)skl_level*skl_level*skl_level/20 ) {
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
	}   
*/
  nf = (int)me->query_skill("unarmed", 1);
  nh = (int)me->query_skill("liumai-shenjian", 1);
  if (nh > 900) {
    tell_object(me, "你已经无法从六脉神剑谱中领会六脉神剑。\n");
    return 1;
  }

  if (nf <= nh) {
    tell_object(me, "你的基本拳法基础不够，再学下去会走火入魔的。\n");
    return 1;
  }
  skl = me->query_skills();

  if (me->is_fighter()) {
    tell_object(me, "战斗中无法阅读新知！\n");
    return 1;
  }
  if (me->query("jing") > 20) {
    me->receive_damage("jing", 20);
    if (nh / 3 < nf)
      me->improve_skill("liumai-shenjian", (me->query_skill("liumai-shenjian") + me->query_int()));
  }
  tell_object(me, "你正在专心研读六脉神剑。\n");
  return 1;
}
