// By Jerry
//u/jerry/workroom.c

#include <ansi.h> 
inherit ROOM;
void create()
{
      set("short", BLINK+HIY"耗子窝"NOR); 
      set("long", @LONG  
你轻轻地打开铁门，走了进来，一个空旷的大厅映入你的眼帘,
这里想必就是传说中的天尊圣殿了。整个大殿的地板和台阶竟,
全为白金所铸。殿中灯火辉煌，灼热的气息竟使得你透不过气,
来。正对大门的一个三丈来高的高台上刻着「天尊圣殿」四个,
大字，高台上四方天神拥簇着一位二十岁左右的青年高高而立.
贴墙有一个放元宝的箱子(xiangzi);

LONG
        ); 
        set("item_desc", ([               
        "xiangzi" : "箱子里有很多耗子挖来的宝石,你要拿出来吗!(pick xiangzi)\n",      
                          ]));
        set("exits", ([
                      "down" : "/d/city/guangchang", 
                      "east" :"/u/jerry/room/jbsroom", 
               "up" : "/u/jerry/test/room1.c",
                          ]));
        set("no_fight", 1); 
        set("no_magic",1);
        set("freeze",1);
        set("valid_startroom", 1);
        set("sleep_room", 1);
        setup();
 }
void init()
{
  object me = this_player(); 
    add_action("do_pick", "pick"); } 

int do_pick(string arg)
{
        object sword, me=this_player();

        if( !arg || arg=="" ) return 0;

 if(me->query_temp("ygbz_money"))
return notify_fail("你已经拿过钱了,不要意思再拿了!\n");
      if( arg=="xiangzi" )
{  
if(query_temp("nasword")){ 
   message_vision("$N想去拿宝石,发现已经被人拿了\n", this_player());
     return 1;
 }
                                message_vision(
HIY"$N在箱子里拿出宝石!\n"NOR, this_player());
me->add("ygbz_money",1);
set_temp("nasword",100);
me->set_temp("ygbz_money",1);
message("channel:chat", HBRED HIB"【号令天下】"+me->query("name")+"在耗子窝里发现了大量的宝石!\n"NOR,users()); 
return 1;
 }
        return 1;
 }


