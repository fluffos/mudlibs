inherit BULLETIN_BOARD;

void create()
{
        set_name(HIY"小志的留言板"NOR,({"board"}));
        set("location","/u/jerry/workroom");
        set("board_id", "jerry_b");
        set("long", "如果有事找小志，在这里留言吧。\n");
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
