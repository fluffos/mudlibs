inherit ITEM;
void create() {
  set_name(HIB "百事可乐" NOR, ({ "pepsi kele", "kele" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIB "一罐百事可乐，据说最近正在促销，开罐有奖哦！kai kele\n");
    set("unit", "罐");
    set("value", 0);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "kai");
}
int do_tilian(string arg) {
  object me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  if (random(22) > 1) {
    me->add("jym_money", 888);
    message_vision(HIY "$N的可乐开出了888元宝的奖励。\n" NOR, me);
    me->start_busy(3);
  } else {
    message_vision(CYN "$N运气真背，竟然开出了谢谢惠顾。\n" NOR, me);
  }
  destruct(this_object());
  return 1;
}
