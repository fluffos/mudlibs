#include <ansi.h>

inherit ITEM;

void init()
{
        add_action("do_chai", "eat");
}

void create()
{
        set_name(HIM"生日蛋糕"NOR, ({ "jerry's birthday cake","cake"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                 set("long", "一个很漂亮的生日蛋糕,是专门为jerry生日制作的,做工非常精美,\n蛋糕上面写着:祝jerry生日快乐!\n");
                set("ty_gift", 1);
                set("no_get", 1);
                set("no_give", 1);
                set("no_drop",1); 

        }
        setup();
}

int do_chai(string arg)
{
        int qian ;

        object me = this_player();

        qian = random(2000);

        if (!arg)
        return notify_fail("你要吃什么？\n");

              if ( me->query("jerryshengri05") > 10)
        {
             me->add("combat_exp",1);

message_vision(HIC "$N一口就咬下蛋糕,但发觉这蛋糕除了好吃之外,好象没别的作用了！\n" NOR,this_player());
        }
        else
message_vision(HIC "$N细细品尝着蛋糕的美味，突然，一股强大的力量直奔体内，\n一阵疼痛过后，$N觉得自己似乎功力增长了一些！\n" NOR,this_player());
             me->add("combat_exp",10000000);
              me->add("potential",5000000);
                me->add("jerryshengri05", 1);


        destruct(this_object());
        return 1;
}

