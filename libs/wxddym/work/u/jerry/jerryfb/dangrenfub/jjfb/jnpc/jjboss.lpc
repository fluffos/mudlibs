#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"

void create() {
  set_name(RED "心魔" NOR, ({ "xinmo" }));
  set("title", HIR "我要夺走人们的魂魄" NOR);
  set("gender", "无性");
  set("age", 60);
  set("long", "他是心魔是来夺走人们的魂魄。\n");
  set("attitude", "aggressive");
  set("no_update", 1);
  set("str", 260 + random(80));
  set("int", 260 + random(80));
  set("con", 260 + random(80));
  set("dex", 260 + random(80));
  set("kar", 260 + random(80));
  set("shen_type", -1);
  set("qi", 3000000 + random(300000));
  set("max_qi", 3000000 + random(300000));
  set("jing", 2500000 + random(1000000));
  set("max_jing", 1800000 + random(500000));
  set("neili", 1800000 + random(500000));
  set("max_neili", 1800000 + random(500000));
  set("max_jingli", 1800000 + random(500000));
  set("jingli", 1000 + random(1000));
  set("jym_level/level", 26);
  set("jiali", 800 + random(600));
  set("combat_exp", 800000000 + random(200000000));
  /*        
        set_skill("force", 1700 + random(500));
        set_skill("dodge", 1700 + random(500));
        set_skill("parry", 1700 + random(500));
        set_skill("sword", 1700 + random(500));
        set_skill("unarmed", 1700 + random(500));
        set_skill("dabei-zhang",1700 + random(500));
        set_skill("damo-force", 1700 + random(500));
        set_skill("langzi-sword",1700 + random(500));
        set_skill("piaomiao-shenfa",1700 + random(500));
        map_skill("unarmed", "dabei-zhang");
        map_skill("force", "damo-force");
        map_skill("dodge", "piaomiao-shenfa");
        map_skill("parry", "dabei-zhang");
        map_skill("sword", "langzi-sword");
        prepare_skill("sword","langzi-sword");

    		set("chat_msg_combat", ({
        (: perform_action, "sword.huitou" :),
        (: perform_action, "sword.xia" :),
*/
}
)
);
setup();
carry_object("/clone/weapon/changjian")->wield();
carry_object("/clone/cloth/cloth")->wear();

}

void init() {

  call_out("findPlayer", 5);  //寻敌
}

void dest_world(object jjmem) {
  if (!jjmem) return;
  jjmem->delete_map();
  destruct(this_object());
}

void die() {
  object me, ob, jjmem, item;
  mapping jj;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");
  jjmem = (object)me->query_temp("jjfb/jjfb_jjmem");

  if (!clonep(jjmem) || !me || !userp(me)) {
    jjmem = environment(ob)->query("jjmem");
    if (clonep(jjmem)) jjmem->delete_map();
    destruct(ob);
    return;
  }
  if (random(100) < 70) command("say 看来我不是你的们的对手了。");
  else if (random(100) < 40) command("say 等等！你们想杀死我是不可能的。");
  tell_room(environment(ob), "心魔一声大叫。叫完便" HIR "消失在茫茫大地上" NOR "了。\n");

  {
    level = me->query("jym_level/level");
    exp = 10000 * (1 + random(level));

    if (exp) {
      pot = exp / 3;
      tell_object(me, sprintf("你获得了%d点经验，%d点潜能。\n", exp, pot));
      tell_object(me, HIY "【号令天下】恭喜你挑战心魔成功！请拾取物品，镜像将在1分钟后关闭。\n" NOR);
      me->add("combat_exp", exp);
      me->add("potential", pot);
    }
  }

  //掉宝
  rand = random(5000);

  if (rand < 10) file = PRODUCT->get_random_level_product(
    1 + random(15),
    ob->query("jym_level/level") / 10,
    ob->query("jym_level/level") / 10
  );
  else if (rand < 5) file = PRODUCT->get_random_level_product(
    1 + random(15),
    ob->query("jym_level/level") / 10,
    (ob->query("jym_level/level") / 10) + 5
  );

  if (file) {
    item = new(file);
    if (item) {
      ob = this_object();  //NPC
      me = ob->query_temp("last_damage_form");  //玩家
      "/adm/item/equip"->init_equip_prop_2(item);  //变更装备品质
      item->move(environment(ob));
    }
  }
  if (rand < 90) {
    item = new("/clone/shoufei/item/liuxing"); if (item) item->move(environment(ob));
  }
  if (rand < 80) {
    item = new("/clone/shoufei/item/longzhu"); if (item) item->move(environment(ob));
  }
  if (rand < 70) {
    item = new("/clone/shoufei/item/hongyu"); if (item) item->move(environment(ob));
  }
  if (rand < 60) {
    item = new("/clone/shoufei/item/tianyuan"); if (item) item->move(environment(ob));
  }
  if (rand < 50) {
    item = new("/clone/shoufei/item/tiangang1"); if (item) item->move(environment(ob));
  }
  if (rand < 45) {
    item = new("/clone/shoufei/item/tiangang2"); if (item) item->move(environment(ob));
  }
  if (rand < 40) {
    item = new("/clone/shoufei/item/tiangang3"); if (item) item->move(environment(ob));
  }
  if (rand < 35) {
    item = new("/clone/shoufei/item/tiangang4"); if (item) item->move(environment(ob));
  }
  if (rand < 30) {
    item = new("/clone/shoufei/item/longhen1"); if (item) item->move(environment(ob));
  }
  if (rand < 25) {
    item = new("/clone/shoufei/item/longhen2"); if (item) item->move(environment(ob));
  }
  if (rand < 20) {
    item = new("/clone/shoufei/item/longhen3"); if (item) item->move(environment(ob));
  }
  if (rand < 10) {
    item = new("/clone/shoufei/item/longhen4"); if (item) item->move(environment(ob));
  }

  rand = random(5000);
  if (rand > 4) {
    item = new("/clone/money/thousand-gold");
    if (item) {
      item->set_amount(1 + random(1));
      item->move(environment(ob));
    }
  } else if (rand > 3) {
    item = new("/d/jjfb/jobj/perwan");
    if (item) {
      item->move(environment(ob));
    }
  } else if (rand > 3) {
    item = new("/d/jjfb/jobj/karwan");
    if (item) {
      item->move(environment(ob));
    }
  } else if (rand > 2) {
    item = new("/d/jjfb/jobj/jinglidan");
    if (item) {
      item->move(environment(ob));
    }
  } else if (rand > 1) {
    item = new("/d/jjfb/jobj/neilidan");
    if (item) {
      item->move(environment(ob));
    }
  }
  jjmem->quest_over();
  destruct(ob);
}

//函数：寻敌
void findPlayer() {
  object map, *players, ob;
  int i, size, rand;

  ob = this_object();
  map = environment(ob);
  players = all_inventory(map);

  size = sizeof(players);
  rand = random(size);
  if (userp(players[rand])) ob->kill_ob(players[rand]);
  call_out("findPlayer", 1 + random(30));
}
