//add jerry 2008.12.09
//u/jerry/npc1/seller.c

inherit NPC;

void create() {

  set_name("元宝伙计", ({ "jerry seller", "seller" }));
  set("kaifa", 38);
  set("jizhi", 46);
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 45);
  set("long",
    "元宝伙计。\n");
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);
  set("combat_exp", 40000);
  set("attitude", "friendly");

  setup();
  carry_object("/clone/misc/changpao")->wear();
}
void init() {
  add_action("do_zhuan", "zhuanfdb");
}

int do_zhuan(string arg) {
  string target, item;
  object obj, who, *inv, obj2;
  int i, amount, str;

  object me = this_player();

  if (!arg) return notify_fail("您要转给哪个玩家？请把他也叫过来!\n");

  if (sscanf(arg, "%d to %s", str, target) == 2
    || sscanf(arg, "%s %d", target, str) == 2);
  else return notify_fail("你要转给哪个玩家？\n");

  if (!objectp(who = present(target, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (who == me) return notify_fail("给自己转帐?\n");

  if (wizardp(me)) return notify_fail("巫师不能转帐!\n");
  if (me->is_busy())
    return notify_fail("还是先将你手上的事情做完了再给吧!\n");

  if (me->query("jym_money") < str)
    return notify_fail("你钱庄里没这么多元宝!\n");

  if (!userp(who))
    return notify_fail("对不起只能转帐给玩家。\n");

  if (!living(who))
    return notify_fail("嗯!很显然," + who->name() + "现在正躺着,不能马上爬起来接受你的馈赠!\n");

  if (str < 1) return notify_fail("最少要转1枚。\n");

  if (str >= 1)
    log_file("login/points", sprintf("%s转了%d枚元宝给 %s,他的元宝有%d个,(%s)\n",
      me->query("id"), str, who->query("id"), me->query("jym_money"),
      "/cmds/usr/rtime.lpc"->chinese_time(5, ctime(time()))));
  me->add("jym_money", -str);
  who->add("jym_money", str);
  me->start_busy(3);
  me->save();
  who->save();
  message_vision(HIY "" + me->name() + "转了" + str + "枚元宝到" + who->name() + "的户头。\n" NOR, who, me);

  return 1;
}
