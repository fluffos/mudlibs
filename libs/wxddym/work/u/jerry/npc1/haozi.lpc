#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"小耗子"NOR, ({ "xiao haozi", "haozi" }) );
         set("nickname", HIY"《号令天下》欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是〖《号令天下》〗的使者，向他打听“礼物”，以补偿你的损失。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 300);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);
        set("no_suck",1);

        set("inquiry", (
                         "礼物" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖《号令天下》〗"+HIR+"(ask haozi about 礼物)\n"+NOR+HIW+"，．"NOR);
                       call_out("greeting", 2);

}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("jerry20081126"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("jerry20081126", 1);
                me->add("potential", 500000);
                me->add("food", 20000);
                me->add("water", 20000);
                me->add("max_neili", 2000);
                me->add("max_jingli", 2000);
                me->add("combat_exp", 2000000);

                return "欢迎光临"NOR+HIR"〖《号令天下》〗"NOR"，巫师组表示非常抱歉。小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}



