#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "小耗子" NOR, ({ "xiao haozi", "haozi" }));
  set("nickname", HIY "天涯欢迎您的到来" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是小耗子礼物使者，向他打听“礼物”，来获得奖励。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "礼物": (: ask_me :),
  ]));
  setup();
}

string ask_me() {
  object shiyigift;
  object me = this_player();

  //      me->add("max_neili", 50000);
  //      me->add("max_jingli", 100841);
  //      me->add("potential", 100000000);
  me->add("combat_exp", 150000000);
  //       me->set_skill("force",1100);
  //       me->set_skill("literate",3000);
  // me->add("water", 10000);
  //  me->add("food", 10000);


  return "欢迎光临" NOR + HIR "〖耗子〗" NOR "，巫师组表示非常抱歉。小的护架来迟，罪该万死！在下可助您行走江湖！\n"
    HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！\n" + HIR + "你得到了礼物！！！！！" NOR;
}
