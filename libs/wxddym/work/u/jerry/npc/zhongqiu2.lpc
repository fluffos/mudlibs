  "    50点身法,50点根骨!!另外增加经验值5000000,潜能值1000000!\n\n"

  "<2> 豆沙双黄:吃了你将会增加实战经验20000000点,潜能2000000点,福缘,容貌!\n    各增加一点!增加元宝3000!\n\n"

   "<3> 水果口味:吃了各项属性(int,dex,con.str,per,kar)各增加一点!\n    增加实战经验8000000点,潜能500000点!\n\n"

  "以上所有选择只适合年龄高于15或等于15的玩家!!!\n\n"

   "你可以使用choose 1或者choose 2 或者choose 3来决定\n\n"
);
*/
     tell_object( me,
  "\n\n    一年一度的国庆节又到了!《号令天下》为大家准备了礼物,\n"
  "现在请你输入:\n\n"
  "choose <序号>来选择你想要的礼物!!\n\n"

       
  "<1> 吃了你所拥有的合成武器增加500点攻击力,100点悟性,50点臂力,\n"
  "    50点身法,50点根骨!!另外增加经验值3000000,潜能值500000!\n\n"

  "<2> 吃了你将会增加实战经验10000000点,潜能1000000点,福缘,容貌!\n    各增加一点!\n\n"

   "<3> 吃了各项属性(int,dex,con.str,per,kar)各增加一点!\n    增加实战经验3000000点,潜能200000点!\n\n"

  "以上所有选择只适合年龄高于15或等于15的玩家!!!\n\n"

   "你可以使用choose 1或者choose 2 或者choose 3来决定\n\n"
);
      me->set_temp("tygift/20051001start",1);
         return "输入"HIR" choose "NOR + CYN"指令来选择。";       
}
}

int do_toupiao(string arg)
{ 
  
         object me = this_player(); 
         object ob,ob2,ob3;

        if( !arg )
  return notify_fail("您只能按 choose 1或者choose 2 或者choose 3 !\n");

  if( me->query("mud_age") < 86400)
             return notify_fail("对不起，您的年龄未达到!\n");

 if (!me->query_temp("tygift/20051001start"))
  return notify_fail("请您先ask shizhe about 国庆节快乐，来了解 情况!\n");

    if ( me->query("tygift/20051001"))
   return notify_fail("您已经拿过了!\n");

    if( arg == "1")
{         
if (!me->query("hecheng")){
tell_object(me,HIC"你没有合成武器,先去合成把再来要这礼物吧!\n"NOR);
       return 1;   }
else
ob = new (__DIR__"obj/yuebing1");
ob->move(me);
me->set("tygift/20051001",1);


tell_object(me,HIC"您成功的得到了礼物!\n"NOR);
       return 1;    
}  
    if( arg == "2") 
{         
ob = new (__DIR__"obj/yuebing2");
ob->move(me);
me->set("tygift/20051001",1);

tell_object(me,HIC"您成功的得到了礼物!\n"NOR);
       return 1;    
} 

   if( arg == "3") 
{         
ob = new (__DIR__"obj/yuebing3");
ob->move(me);
me->set("tygift/20051001",1);

tell_object(me,HIC"您成功的得到了礼物!\n"NOR);
       return 1;    
}  

}


