inherit NPC;
inherit F_SAVE;
inherit F_MASTER;


#include <ansi.h>

string ask_form();

void create()
{
  seteuid(getuid());

        set_name("《号令天下》节日使者", ({"tianya happy shizhe", "shizhe", "tianya"}));
        set("gender", "女性");
        set("nickname", HIG"国庆节快乐"NOR);
        set("age", 1000);
        set("doing", 1);
        set("long",
                "他是《号令天下》的节日使者\n"
                "他是给大家送礼物来了。\n");

        set("inquiry", ([
                "国庆节快乐"       : (: ask_form :),
        ]) );
        setup();
  
        carry_object("/clone/cloth/cloth")->wear();

}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("ty_zhongqiu");
                        call_out("ty_zhongqiu", 1, ob);
                }
   add_action("do_toupiao","choose");
}

void ty_zhongqiu(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
command("whisper " + ob->query("id") + " "HIW"你可以使用"+HIR+"(ask chang about 国庆节快乐)"HIW"来取得礼物!\n"NOR);
 
}

string ask_form()
{
        object me;
        object ob;

        me = this_player();

           if( !me->query_temp("diaocha"))
{
/*
     tell_object( me,
  "\n\n    一年一度的中秋节又到了!仙女嫦娥奉王母娘娘的法旨,下凡给\n"
  "大家派发月饼,这可不是普通的月饼,它是用仙桃制成,吃了有说不出的\n"
  "妙处,大家可要珍惜!\n\n"
  "月饼种类繁多,嫦娥提供了几种味道供大家选择,现在请你输入:\n\n"
  "choose <序号>来选择你想要的味道!!\n\n"

       
