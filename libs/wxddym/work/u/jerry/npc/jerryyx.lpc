#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"元宵使者"NOR, ({"shizhe" }));
         set("nickname", HIY"《号令天下》欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是〖《号令天下》〗的使者，向他打听“元宵节日快乐”，你会有意想不到的惊喜……。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);

        set("inquiry", ([
                         "元宵节日快乐" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖《号令天下》〗"+HIR+"(ask shizhe about 元宵节日快乐)\n"+NOR+HIW+"，．"NOR);
                       call_out("greeting", 2);

}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
          if ((int) me->query("jymjerry/20090209")|| me->query("age") < 1)  
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
         me->set("jymjerry/1", 1);
                me->add("potential", 5000000);
                me->add("food", 10000);
                me->add("water", 10000);
          me->add("combat_exp",50000000);
         me->add("jym_money",888888);
                me->save();
                tell_object(me, HIR "《号令天下》恭祝：元宵节日快乐！。\n" NOR);
                tell_object(me, HIG "你觉得似乎自己经验增加了50000000。\n" NOR);
                tell_object(me, HIM "你觉得似乎自己潜能增加了5000000。\n" NOR);
                tell_object(me, HIM "你觉得似乎自己元宝增加了8888。\n" NOR);
                tell_object(me, HIW "恭喜你，元宵节日快乐。\n" NOR);


                return "《号令天下》巫师组"NOR+HIR"〖恭祝您〗"NOR":元宵节日快乐！\n"NOR;;
        }
}


