#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"《号令天下》&劳动使者"NOR, ({ "laodong shizhe", "shizhe" }) );
         set("nickname", HIY"《号令天下》欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是〖《号令天下》〗的劳动使者，向他打听“劳动节”，会有以外的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
         set("doing",1);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);
        set("no_suck",1);

        set("inquiry", ([
                         "劳动节" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖《号令天下》〗"+HIR+"(ask shizhe about 劳动节)\n"+NOR+HIW+"，．"NOR);

                       call_out("greeting", 2);

}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ( !me->query("hecheng") && !me->query_temp("hecheng"))
       {
          me->set_temp("hecheng",1);
         return "可以得到合成兵器攻击力的奖励哦，你最好先去合成把兵器，要不然没的奖励哦！\n";
        }
           if ((int) me->query("20030501"))
                return "你啊，明年五一再来吧！";
               else
        {
                me->set("20030501", 1);
                me->add("potential", 100000);
                me->add("food", 10000);
                me->add("water", 10000);
                me->add("max_neili", 5000);
                me->add("max_jingli", 5000);
                me->add("combat_exp",1000000);
              if ( me->query("hecheng") ) {
             me->add("hecheng/damage",500);
write(HIC"你突然感觉你的合成兵器在抖动，你拔出一看，发现合成兵器锋利了不少!\n"NOR);
}


                return "欢迎光临"NOR+HIR"〖《号令天下》〗"NOR"，辛苦了一年，今天终于得到了回报！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}

