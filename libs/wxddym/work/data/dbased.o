save_dbase (["/data/item/c/cangjingkong-disha":(["owner":(["cangjingkong":26425,]),"user":"苗苍井空(cangjingkong)","consistence":90,"magic":0,"combat":(["MKS":211,"WPK_GOOD":27,"WPK_NOTBAD":50,"WPK_BAD":161,"WPK_NOTGOOD":184,]),]),"/data/room/penno2/yingke":(["long":"这里是谷墅的主人慕容谷殇迎接八方来客的地方。大凡客人来拜见慕容谷殇，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，是主人陪同客人品尝天下名茶之处。","short":"谷墅迎客厅","autoload":({"/d/room/roomnpc/yahuan","/d/room/roomnpc/yahuan",}),]),"/data/item/m/m1003356014-sss":(["owner":(["m1003356014":4808,"cxx960726":1,"z1429427265":210,]),"consistence":93,"user":"虚燕(z1429427265)","combat":(["MKS":114,"WPK_GOOD":25,"WPK_NOTBAD":100,"WPK_BAD":14,"WPK_NOTGOOD":88,]),"magic":0,]),"/data/room/qq710171535/dayuan":(["long":"这是一个宽阔的院落，种着各种树木，阳光照下来透过树荫投下层层影子。一条大路通向里面，踩得非常平滑的，看来是经常有人来往。","short":"红尘阁大院","autoload":({}),]),"/data/item/q/qq909655633-dao":(["owner":0,"consistence":100,"user":"罗刹女(qq909655633)","combat":(["MKS":2,"WPK_NOTBAD":2,"WPK_NOTGOOD":2,]),"magic":0,]),"/data/item/l/liuhutao-huan":(["owner":0,"consistence":100,"user":"明花(liujiawei)","combat":0,"magic":0,]),"/data/beast/hjc0579-beast":(["unarmed":0,"mud_age":0,"literate":0,"ridable":0,"age":24,"dodge":0,]),"/data/item/t/tiancc-shezhang":(["owner":(["tiancc":34,]),"consistence":98,"user":"欧阳小川(tiancc)","combat":(["MKS":10,"WPK_GOOD":1,"WPK_NOTBAD":7,"WPK_BAD":3,"WPK_NOTGOOD":9,]),"magic":0,]),"/data/item/e/ebcyf-btj":(["owner":(["ebcyf":78113,]),"consistence":90,"combat":(["WPK_NOTBAD":569,"WPK_NOTGOOD":1077,"PKS":1,"MKS":1175,"WPK_GOOD":100,"WPK_BAD":607,]),"magic":0,]),"/data/beast/id352581297-beast":(["unarmed":0,"mud_age":4773,"literate":0,"ridable":0,"age":0,"dodge":0,]),"/data/item/s/shu8579033-jian":(["owner":0,"consistence":100,"combat":0,"magic":0,]),"/data/room/qq710171535/yishiting":(["long":"这就是红尘阁主人游戏红尘和重要人物商量江湖大事之处，正中有不少桌椅，侧面是屏风，厅堂中挂着两个条幅，两旁通往演武厅。","short":"议事厅","autoload":({}),]),"/data/room/baixs79/youxiang":(["long":"这是听音小筑的右厢房，是客人居住的地方。虽然不算奢华，却也布置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大结实，使屋内光线恰到好处。","short":"右厢房","autoload":({}),]),"/data/item/w/wadl-lcyb":(["owner":0,"consistence":100,"user":0,"combat":0,"magic":0,]),"/data/beast/huanyue-beast":(["unarmed":0,"mud_age":271,"literate":0,"ridable":0,"age":0,"dodge":167772160,]),"/data/room/qazzaq/yanwu1":(["long":"这是苏安河的演武厅，有时有些江湖朋友来会，想一试身手，就在这里比武较量。","short":"苏安河演武厅","autoload":({"/clone/weapon/zhubang","/clone/weapon/zhujian","/clone/weapon/mudao",}),]),"/data/room/obh1234/chashi":(["long":"是一个玲珑小巧的茶室，很是显得精致。正中有一茶几，两旁立着两个妙龄少女，正在听候主人的吩咐(tea)。","short":"茶室","autoload":({"/d/room/roomnpc/teagirl","/d/room/roomnpc/teagirl",}),]),"/data/item/b/buddhism-lenx":(["owner":(["buddhism":14,]),"consistence":98,"user":"慕容冷心(buddhism)","combat":(["MKS":63,"WPK_GOOD":4,"WPK_NOTBAD":63,"WPK_NOTGOOD":59,]),"magic":0,]),"/data/room/jiantion/houyuan":(["long":"穿过大厅，有一处空地，墙角有一块黑色巨石，上面坑坑洼洼的，靠近过去，感到周围温度仿佛都低了许多。[2;37;0m","short":"林间小屋后院","autoload":({}),]),"/data/item/n/ni1125028769-jjj":(["owner":(["weidage":57,"weoge":39,"ni1125028769":6,]),"consistence":95,"user":"魔教(weidage)","combat":(["MKS":105,"WPK_GOOD":15,"WPK_NOTBAD":36,"WPK_BAD":53,"WPK_NOTGOOD":89,]),"magic":0,]),"/data/item/l/lynation095-miet":(["owner":(["lynation095":707082,]),"consistence":83,"combat":(["MKS":3240,"WPK_GOOD":866,"WPK_NOTBAD":1119,"WPK_BAD":2121,"WPK_NOTGOOD":2374,]),"magic":0,]),"/data/item/l/l888gg-gtq":(["owner":(["qq570694773":2,]),"consistence":99,"user":"心(qq570694773)","combat":(["MKS":2,"WPK_BAD":2,"WPK_NOTGOOD":2,]),"magic":0,]),"/data/room/qq710171535/lianwu":(["long":"此处便是红尘阁的练武场，人在江湖，武功万万不可荒废。","short":"练武场","autoload":({"/clone/npc/mu-ren","/clone/npc/mu-ren","/clone/npc/mu-ren","/clone/npc/mu-ren",}),]),"/data/item/c/class-wmj":(["owner":(["tankai":2708997,"class":82404,]),"consistence":94,"user":"段不二(class)","combat":(["MKS":5324,"WPK_NOTBAD":5318,"WPK_BAD":6,"WPK_NOTGOOD":5324,]),"magic":0,]),"/data/item/m/msmj-szs":(["owner":(["a1462581444":1,"mc2104a":2591,]),"consistence":89,"user":"凝冰(mc2104a)","combat":(["WPK_NOTBAD":172,"WPK_NOTGOOD":