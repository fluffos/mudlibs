#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", "这就是池塘主人法师休息、读书的地方。楼上就是主人的卧室，
西面则是书房。
");

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "法师");
  set("room_name", "池塘");
  set("room_id", "lll");
  set("room_owner_id", "fmns");
  set("room_position", "海滩");
}
