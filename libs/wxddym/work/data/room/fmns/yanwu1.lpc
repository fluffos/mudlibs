inherit PRIVATE_ROOM;

void create() {
  set("short", "池塘演武厅");
  set("long", "这是池塘的演武厅，有时有些江湖朋友来会，想一试身手，就在
这里比武较量。
");

  set("exits", ([
    "west": __DIR__ "yishiting",
  ]));

  set("objects", ([
    "/clone/weapon/zhubang": 1,
    "/clone/weapon/zhujian": 1,
    "/clone/weapon/mudao": 1,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "法师");
  set("room_name", "池塘");
  set("room_id", "lll");
  set("room_owner_id", "fmns");
  set("room_position", "海滩");
}
