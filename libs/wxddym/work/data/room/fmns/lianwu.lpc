inherit PRIVATE_ROOM;

void create() {
  set("short", "练武场");
  set("long", "此处便是池塘的练武场，人在江湖，武功万万不可荒废。
");

  set("exits", ([
    "west": __DIR__ "houyuan",
  ]));

  set("objects", ([
    "/clone/npc/mu-ren": 4,
  ]));

  set("outdoors", "taohua");
  set("no_sleep_room", 1);

  setup();

  set("room_owner", "法师");
  set("room_name", "池塘");
  set("room_id", "lll");
  set("room_owner_id", "fmns");
  set("room_position", "海滩");
}
