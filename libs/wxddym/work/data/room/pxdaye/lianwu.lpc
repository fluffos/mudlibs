     inherit PRIVATE_ROOM;

void create()
{
	set("short", "练武场");
	set("long", "此处便是琴韵小筑的练武场，人在江湖，武功万万不可荒废。
");

	set("exits", ([
                "west" : __DIR__"houyuan",
	]));

        set("objects", ([
                "/clone/npc/mu-ren" : 4,
        ]));

        set("outdoors", "nanhai");
        set("no_sleep_room", 1);

        setup();
    
        set("room_owner", "猪猪");
        set("room_name", "琴韵小筑");
        set("room_id", "qinyun");
        set("room_owner_id", "pxdaye");
        set("room_position", "平原小路");
}
