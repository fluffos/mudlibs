#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "居所");
	set("long", "这就是琴韵小筑主人猪猪休息、读书的地方。楼上就是主人的卧
室，西面则是书房。
");

	set("exits", ([
		"up"   : __DIR__"woshi",
                "west" : __DIR__"shufang",
	]));

        set("no_sleep_room", 1);
        setup();

        set("KEY_DOOR", ([
                "exit" : "east",
                "room" : __DIR__"huayuan",
        ]));
    
        set("room_owner", "猪猪");
        set("room_name", "琴韵小筑");
        set("room_id", "qinyun");
        set("room_owner_id", "pxdaye");
        set("room_position", "平原小路");
}
