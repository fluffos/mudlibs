#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", "这就是八景宫主人段歌休息、读书的地方。楼上就是主人的卧室，
西面则是书房。
");

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "段歌");
  set("room_name", "八景宫");
  set("room_id", "bajinggong");
  set("room_owner_id", "yxsyyr1");
  set("room_position", "嘉兴南湖");
}
