     inherit PRIVATE_ROOM;

void create()
{
        set("short", "八景宫大院");
	set("long", "这是一个宽阔的院落，种着各种树木，阳光照下来透过树荫投下
层层影子。一条大路通向里面，踩得非常平滑的，看来是经常有人来
往。
");

	set("exits", ([
		"north"  : __DIR__"qianting",
                "out"    : "/d/quanzhou/nanhu1",
	]));

        set("outdoors", "jiaxing");
        set("no_sleep_room", 1);
        set("valid_startroom", 1);
        setup();

        set("room_owner", "段歌");
        set("room_name", "八景宫");
        set("room_id", "bajinggong");
        set("room_owner_id", "yxsyyr1");
        set("room_position", "嘉兴南湖");
}
