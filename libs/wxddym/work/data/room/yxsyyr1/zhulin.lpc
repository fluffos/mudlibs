     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set("long", "这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时段歌就去听涛阁默听竹浪涛声，参悟武功。
");

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "jiaxing");
        set("sleep_room", 1);
        setup();

        set("room_owner", "段歌");
        set("room_name", "八景宫");
        set("room_id", "bajinggong");
        set("room_owner_id", "yxsyyr1");
        set("room_position", "嘉兴南湖");
}
