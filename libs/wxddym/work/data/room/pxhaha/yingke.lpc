#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "小别墅迎客厅");
	set("long", "这里是小别墅的主人非洲黑鬼迎接八方来客的地方。大凡客人来
拜见非洲黑鬼，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一
个茶室，是主人陪同客人品尝天下名茶之处。
");

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "非洲黑鬼");
        set("room_name", "小别墅");
        set("room_id", "bieshu");
        set("room_owner_id", "pxhaha");
        set("room_position", "平原小路");
}
