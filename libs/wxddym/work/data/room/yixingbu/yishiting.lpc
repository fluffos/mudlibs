#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "议事厅");
  set("long", "这就是水若寒苑主人水若寒和重要人物商量江湖大事之处，正中
有不少桌椅，侧面是屏风，厅堂中挂着两个条幅，两旁通往演武厅。
");

  set("exits", ([
    "east": __DIR__ "yanwu1",
    "west": __DIR__ "yanwu2",
    "north": __DIR__ "zhongting",
    "south": __DIR__ "yingke",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "水若寒");
  set("room_name", "水若寒苑");
  set("room_id", "srhy");
  set("room_owner_id", "yixingbu");
  set("room_position", "平原小路");
}
