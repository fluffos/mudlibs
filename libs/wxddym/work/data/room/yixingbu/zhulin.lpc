     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set("long", "这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时水若寒就去听涛阁默听竹浪涛声，参悟武功。
");

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "nanhai");
        set("sleep_room", 1);
        setup();

        set("room_owner", "水若寒");
        set("room_name", "水若寒苑");
        set("room_id", "srhy");
        set("room_owner_id", "yixingbu");
        set("room_position", "平原小路");
}
