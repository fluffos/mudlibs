#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "水若寒苑迎客厅");
	set("long", "这里是水若寒苑的主人水若寒迎接八方来客的地方。大凡客人来
拜见水若寒，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个
茶室，是主人陪同客人品尝天下名茶之处。
");

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "水若寒");
        set("room_name", "水若寒苑");
        set("room_id", "srhy");
        set("room_owner_id", "yixingbu");
        set("room_position", "平原小路");
}
