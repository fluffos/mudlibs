#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "左厢房");
  set("long", "这是水若寒苑的左厢房，是客人居住的地方。虽然不算奢华，却
也布置得非常舒适。一张床整齐干净，没有多少折纹，而窗帘厚大结
实，使屋内光线恰到好处。
");

  set("exits", ([
    "west": __DIR__ "zhongting",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);

  create_door("west", "木门", "east", DOOR_CLOSED);

  set("room_owner", "水若寒");
  set("room_name", "水若寒苑");
  set("room_id", "srhy");
  set("room_owner_id", "yixingbu");
  set("room_position", "平原小路");
}
