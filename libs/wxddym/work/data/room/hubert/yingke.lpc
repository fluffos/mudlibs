#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "荷花池迎客厅");
  set("long", "这里是荷花池的主人菡萏迎接八方来客的地方。大凡客人来拜见
菡萏，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。
");

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "菡萏");
  set("room_name", "荷花池");
  set("room_id", "lotus");
  set("room_owner_id", "hubert");
  set("room_position", "青石大道");
}
