     inherit PRIVATE_ROOM;

void create()
{
	set("short", "后院");
	set("long", "这是荷花池的后院，正中一个假山，傲然而立、非常雄伟。下有
一水池，环山而走，悠然不息。东面乃是练武之处，西面是厨房。
");

	set("exits", ([
                "south" : __DIR__"zhongting",
                "north" : __DIR__"huayuan",
                "east"  : __DIR__"lianwu",
                "west"  : __DIR__"chufang",
	]));

        set("outdoors", "wudang");
        set("no_sleep_room", 1);
        setup();

        set("room_owner", "菡萏");
        set("room_name", "荷花池");
        set("room_id", "lotus");
        set("room_owner_id", "hubert");
        set("room_position", "青石大道");
}
