     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set("long", "这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时菡萏就去听涛阁默听竹浪涛声，参悟武功。
");

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "wudang");
        set("sleep_room", 1);
        setup();

        set("room_owner", "菡萏");
        set("room_name", "荷花池");
        set("room_id", "lotus");
        set("room_owner_id", "hubert");
        set("room_position", "青石大道");
}
