#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "居所");
	set("long", "这就是护龙山庄主人魔影休息、读书的地方。楼上就是主人的卧
室，西面则是书房。
");

	set("exits", ([
		"up"   : __DIR__"woshi",
                "west" : __DIR__"shufang",
	]));

        set("no_sleep_room", 1);
        setup();

        set("KEY_DOOR", ([
                "exit" : "east",
                "room" : __DIR__"huayuan",
        ]));
    
        set("room_owner", "魔影");
        set("room_name", "护龙山庄");
        set("room_id", "moyin");
        set("room_owner_id", "moyin");
        set("room_position", "草地");
}
