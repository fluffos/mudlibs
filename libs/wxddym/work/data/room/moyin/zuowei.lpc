inherit PRIVATE_ROOM;

void create() {
  object ob;

  set("short", "护龙山庄左卫舍");
  set("long", "这里是左卫舍，是看护护龙山庄大门的家丁放哨的地方。
");

  set("exits", ([
    "west": __DIR__ "qianting",
  ]));

  set("objects", ([
    "/d/room/roomnpc/shouwei": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  ob = present("shou wei", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  ob = present("shou wei 2", this_object());
  ob->set("coagents", ({
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 1" ]),
    ([ "startroom": __DIR__ "zuowei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 2" ]),
    ([ "startroom": __DIR__ "youwei",
      "id": "shou wei 1" ]),
  }));

  set("room_owner", "魔影");
  set("room_name", "护龙山庄");
  set("room_id", "moyin");
  set("room_owner_id", "moyin");
  set("room_position", "草地");
}
