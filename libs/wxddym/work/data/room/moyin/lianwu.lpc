inherit PRIVATE_ROOM;

void create() {
  set("short", "练武场");
  set("long", "此处便是护龙山庄的练武场，人在江湖，武功万万不可荒废。
");

  set("exits", ([
    "west": __DIR__ "houyuan",
  ]));

  set("objects", ([
    "/clone/npc/mu-ren": 4,
  ]));

  set("outdoors", "city");
  set("no_sleep_room", 1);

  setup();

  set("room_owner", "魔影");
  set("room_name", "护龙山庄");
  set("room_id", "moyin");
  set("room_owner_id", "moyin");
  set("room_position", "草地");
}
