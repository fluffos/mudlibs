#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "居所");
	set("long", "这就是神韵天斋主人渡唐休息、读书的地方。楼上就是主人的卧
室，西面则是书房。
");

	set("exits", ([
		"up"   : __DIR__"woshi",
                "west" : __DIR__"shufang",
	]));

        set("no_sleep_room", 1);
        setup();

        set("KEY_DOOR", ([
                "exit" : "east",
                "room" : __DIR__"huayuan",
        ]));
    
        set("room_owner", "渡唐");
        set("room_name", "神韵天斋");
        set("room_id", "sytz");
        set("room_owner_id", "obh1234");
        set("room_position", "海滩");
}
