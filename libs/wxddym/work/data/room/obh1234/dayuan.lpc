     inherit PRIVATE_ROOM;

void create()
{
        set("short", "神韵天斋大院");
	set("long", "这是一个宽阔的院落，种着各种树木，阳光照下来透过树荫投下
层层影子。一条大路通向里面，踩得非常平滑的，看来是经常有人来
往。
");

	set("exits", ([
		"north"  : __DIR__"qianting",
                "out"    : "/d/taohua/haitan",
	]));

        set("outdoors", "taohua");
        set("no_sleep_room", 1);
        set("valid_startroom", 1);
        setup();

        set("room_owner", "渡唐");
        set("room_name", "神韵天斋");
        set("room_id", "sytz");
        set("room_owner_id", "obh1234");
        set("room_position", "海滩");
}
