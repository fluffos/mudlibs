#include <ansi.h>

inherit ITEM;

string query_autoload() { return "1"; }

void create()
{
	set_name(YEL "久睡成瘾家的钥匙" NOR, ({ "key", "1 of obh1234" }));
	set_weight(10);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", @LONG
一把用来开启神韵天斋(sytz)的钥匙。
这是原配钥匙。
LONG );
		set("unit", "把");
		set("no_pawn", 1);
		set("no_sell", 1);
		set("item_make", 1);
		set("value", 1);
	}
}
