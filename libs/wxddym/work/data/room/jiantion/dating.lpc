#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "林间小屋大厅");
	set("long", "小屋看着很小，内部却别有洞天，这里是大厅，两侧分别挂着两
幅对联，其一上联为《[1;31m魔刀出鞘神天斩[2;37;0m》，下联为《[1;35m一刀中分鬼神惊
[2;37;0m》。其二上联为《[1;37m仗剑行天涯[2;37;0m》，下联为《[1;36m茫茫沧海啸[2;37;0m》。横批分别
为“[1;33m纵刀笑天下[2;37;0m”，“无招胜有招”。[2;37;0m
");

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "银");
        set("room_name", "林间小屋");
        set("room_id", "ljxw");
        set("room_owner_id", "jiantion");
        set("room_position", "紫气台");
}
