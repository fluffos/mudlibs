     inherit PRIVATE_ROOM;

void create()
{
	set("short", "练武场");
	set("long", "此处便是紫金阁的练武场，人在江湖，武功万万不可荒废。
");

	set("exits", ([
                "west" : __DIR__"houyuan",
	]));

        set("objects", ([
                "/clone/npc/mu-ren" : 4,
        ]));

        set("outdoors", "wudang");
        set("no_sleep_room", 1);

        setup();
    
        set("room_owner", "慕容玉京");
        set("room_name", "紫金阁");
        set("room_id", "ada");
        set("room_owner_id", "adawong");
        set("room_position", "青石大道");
}
