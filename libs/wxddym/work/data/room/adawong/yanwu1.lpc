inherit PRIVATE_ROOM;

void create() {
  set("short", "紫金阁演武厅");
  set("long", "这是紫金阁的演武厅，有时有些江湖朋友来会，想一试身手，就
在这里比武较量。
");

  set("exits", ([
    "west": __DIR__ "yishiting",
  ]));

  set("objects", ([
    "/clone/weapon/zhubang": 1,
    "/clone/weapon/zhujian": 1,
    "/clone/weapon/mudao": 1,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "慕容玉京");
  set("room_name", "紫金阁");
  set("room_id", "ada");
  set("room_owner_id", "adawong");
  set("room_position", "青石大道");
}
