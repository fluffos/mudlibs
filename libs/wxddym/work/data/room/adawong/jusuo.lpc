#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", "这就是紫金阁主人慕容玉京休息、读书的地方。楼上就是主人的
卧室，西面则是书房。
");

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "慕容玉京");
  set("room_name", "紫金阁");
  set("room_id", "ada");
  set("room_owner_id", "adawong");
  set("room_position", "青石大道");
}
