#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "墨家机关城大厅");
	set("long", "这是墨家机关城大厅，厅中无椅无桌。只有以前留传下来的四机
械兽遗像。[2;37;0m
");

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "萧萧兮");
        set("room_name", "墨家机关城");
        set("room_id", "yuanho");
        set("room_owner_id", "c258");
        set("room_position", "草地");
}
