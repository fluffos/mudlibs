     inherit PRIVATE_ROOM;

void create()
{
        set("short", "墨家机关城小院");
	set("long", "这里是一个四四方方的院子，院墙都是用红砖砌成，不算高，但
是非常清爽利落。院中几棵古木成荫，隐然有一种世外桃源的感觉。
院子外面隐约是草地，院子的北面有一扇木门。
");

        set("room_key", "1 of c258");
	setup();

	set("exits", ([
                "out"    : "/d/city/jiaowai7",
	]));

        set("outdoors", "city");
        set("no_sleep_room", 1);
        set("valid_startroom", 1);

        set("KEY_DOOR", ([
                "exit" : "north",
                "room" : __DIR__"dating",
        ]));
    
        set("room_owner", "萧萧兮");
        set("room_name", "墨家机关城");
        set("room_id", "yuanho");
        set("room_owner_id", "c258");
        set("room_position", "草地");
}
