#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "居所");
	set("long", "这就是夜雨声烦主人王不留行休息、读书的地方。楼上就是主人
的卧室，西面则是书房。
");

	set("exits", ([
		"up"   : __DIR__"woshi",
                "west" : __DIR__"shufang",
	]));

        set("no_sleep_room", 1);
        setup();

        set("KEY_DOOR", ([
                "exit" : "east",
                "room" : __DIR__"huayuan",
        ]));
    
        set("room_owner", "王不留行");
        set("room_name", "夜雨声烦");
        set("room_id", "bili");
        set("room_owner_id", "tyz000");
        set("room_position", "草地");
}
