     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set("long", "这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时王不留行就去听涛阁默听竹浪涛声，参悟武功。
");

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "huanghe");
        set("sleep_room", 1);
        setup();

        set("room_owner", "王不留行");
        set("room_name", "夜雨声烦");
        set("room_id", "bili");
        set("room_owner_id", "tyz000");
        set("room_position", "草地");
}
