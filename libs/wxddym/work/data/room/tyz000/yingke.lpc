#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "夜雨声烦迎客厅");
	set("long", "这里是夜雨声烦的主人王不留行迎接八方来客的地方。大凡客人
来拜见王不留行，少不得在这里寒暄叙话，了尽仰慕之情。东面通往
一个茶室，是主人陪同客人品尝天下名茶之处。
");

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "王不留行");
        set("room_name", "夜雨声烦");
        set("room_id", "bili");
        set("room_owner_id", "tyz000");
        set("room_position", "草地");
}
