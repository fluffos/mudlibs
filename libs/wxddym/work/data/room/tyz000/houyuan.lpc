     inherit PRIVATE_ROOM;

void create()
{
	set("short", "后院");
	set("long", "这是夜雨声烦的后院，正中一个假山，傲然而立、非常雄伟。下
有一水池，环山而走，悠然不息。东面乃是练武之处，西面是厨房。
");

	set("exits", ([
                "south" : __DIR__"zhongting",
                "north" : __DIR__"huayuan",
                "east"  : __DIR__"lianwu",
                "west"  : __DIR__"chufang",
	]));

        set("outdoors", "huanghe");
        set("no_sleep_room", 1);
        setup();

        set("room_owner", "王不留行");
        set("room_name", "夜雨声烦");
        set("room_id", "bili");
        set("room_owner_id", "tyz000");
        set("room_position", "草地");
}
