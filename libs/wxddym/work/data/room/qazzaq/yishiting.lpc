#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "议事厅");
  set("long", "这就是苏安河主人慕容秋枫和重要人物商量江湖大事之处，正中
有不少桌椅，侧面是屏风，厅堂中挂着两个条幅，两旁通往演武厅。
");

  set("exits", ([
    "east": __DIR__ "yanwu1",
    "west": __DIR__ "yanwu2",
    "north": __DIR__ "zhongting",
    "south": __DIR__ "yingke",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "慕容秋枫");
  set("room_name", "苏安河");
  set("room_id", "sah");
  set("room_owner_id", "qazzaq");
  set("room_position", "草地");
}
