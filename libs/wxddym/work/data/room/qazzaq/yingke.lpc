#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "苏安河迎客厅");
	set("long", "这里是苏安河的主人慕容秋枫迎接八方来客的地方。大凡客人来
拜见慕容秋枫，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一
个茶室，是主人陪同客人品尝天下名茶之处。
");

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "慕容秋枫");
        set("room_name", "苏安河");
        set("room_id", "sah");
        set("room_owner_id", "qazzaq");
        set("room_position", "草地");
}
