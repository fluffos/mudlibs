#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
	set("short", "居所");
	set("long", "这就是苏安河主人慕容秋枫休息、读书的地方。楼上就是主人的
卧室，西面则是书房。
");

	set("exits", ([
		"up"   : __DIR__"woshi",
                "west" : __DIR__"shufang",
	]));

        set("no_sleep_room", 1);
        setup();

        set("KEY_DOOR", ([
                "exit" : "east",
                "room" : __DIR__"huayuan",
        ]));
    
        set("room_owner", "慕容秋枫");
        set("room_name", "苏安河");
        set("room_id", "sah");
        set("room_owner_id", "qazzaq");
        set("room_position", "草地");
}
