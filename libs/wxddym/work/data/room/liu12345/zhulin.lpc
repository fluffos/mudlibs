     inherit PRIVATE_ROOM;

void create()
{
	set("short", "竹林");
	set("long", "这里种着好大一片竹林，非常幽静。风一起就听竹叶沙沙的响，
有时东方影就去听涛阁默听竹浪涛声，参悟武功。
");

	set("exits", ([
                "west" : __DIR__"huayuan",
                "east" : __DIR__"tingtao",
	]));

        set("outdoors", "huanghe");
        set("sleep_room", 1);
        setup();

        set("room_owner", "东方影");
        set("room_name", "快雪时晴");
        set("room_id", "kuaixue");
        set("room_owner_id", "liu12345");
        set("room_position", "草地");
}
