#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "居所");
  set("long", "这就是快雪时晴主人东方影休息、读书的地方。楼上就是主人的
卧室，西面则是书房。
");

  set("exits", ([
    "up": __DIR__ "woshi",
    "west": __DIR__ "shufang",
  ]));

  set("no_sleep_room", 1);
  setup();

  set("KEY_DOOR", ([
    "exit": "east",
    "room": __DIR__ "huayuan",
  ]));

  set("room_owner", "东方影");
  set("room_name", "快雪时晴");
  set("room_id", "kuaixue");
  set("room_owner_id", "liu12345");
  set("room_position", "草地");
}
