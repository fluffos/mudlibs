#include <room.h>

inherit PRIVATE_ROOM;

void create() {
  set("short", "快雪时晴迎客厅");
  set("long", "这里是快雪时晴的主人东方影迎接八方来客的地方。大凡客人来
拜见东方影，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个
茶室，是主人陪同客人品尝天下名茶之处。
");

  set("exits", ([
    "north": __DIR__ "yishiting",
    "south": __DIR__ "zoudao",
    "east": __DIR__ "chashi",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);

  set("objects", ([
    "/d/room/roomnpc/yahuan": 2,
  ]));

  set("no_sleep_room", 1);
  setup();

  set("room_owner", "东方影");
  set("room_name", "快雪时晴");
  set("room_id", "kuaixue");
  set("room_owner_id", "liu12345");
  set("room_position", "草地");
}
