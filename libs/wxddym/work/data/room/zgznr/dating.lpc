#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "北玄仙居大厅");
	set("long", "[1;36m这就是北玄仙居的大厅，仙气浓郁。装饰清雅，墙上挂着几幅画，
但都是画的一位九天仙尊的身影，没幅画都不一样，但却都透着无敌
的寂寞。正中放着桌椅，桌上还正煮着一壶仙茶，茶香飘满整个大厅，
混着浓郁的仙气，凡人在此呆上一小会甚至便可成仙。[2;37;0m
");

	setup();

	set("exits", ([
                "east"   : __DIR__"woshi",
		"north"  : __DIR__"houyuan",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("no_sleep_room", 1);

        set("KEY_DOOR", ([
                "exit" : "south",
                "room" : __DIR__"xiaoyuan",
        ]));
    
        set("room_owner", "真角大古");
        set("room_name", "北玄仙居");
        set("room_id", "bxxz");
        set("room_owner_id", "zgznr");
        set("room_position", "紫气台");
}
