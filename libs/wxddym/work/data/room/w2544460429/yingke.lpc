#include <room.h>

     inherit PRIVATE_ROOM;

void create()
{
        set("short", "静默阁迎客厅");
	set("long", "这里是静默阁的主人无语迎接八方来客的地方。大凡客人来拜见
无语，少不得在这里寒暄叙话，了尽仰慕之情。东面通往一个茶室，
是主人陪同客人品尝天下名茶之处。
");

	set("exits", ([
		"north"  : __DIR__"yishiting",
                "south"  : __DIR__"zoudao",
                "east"   : __DIR__"chashi",
	]));

        create_door("east", "木门", "west", DOOR_CLOSED);

        set("objects", ([
                "/d/room/roomnpc/yahuan" : 2,
        ]));

        set("no_sleep_room", 1);
        setup();

        set("room_owner", "无语");
        set("room_name", "静默阁");
        set("room_id", "jmg");
        set("room_owner_id", "w2544460429");
        set("room_position", "紫气台");
}
