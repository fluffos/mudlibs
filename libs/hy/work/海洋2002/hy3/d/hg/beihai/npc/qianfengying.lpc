inherit NPC;
void create()
{
  set_name("前锋营军士",({"junshi"}));
  set("gender","男性");
  set("age",20+random(30));
  set("combat_exp",90000);
  set("force",700);
  set("max_force",700);
  set("force_factor",20);
   set("max_neili",500);
        set_skill("force", 80+random(180));
 
  set_skill("unarmed",40);
  set_skill("dodge",40);
  set_skill("parry",40);
  set_skill("blade",40);
  
  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("d/city/npc/obj/tiejia")->wear();
  carry_object("d/city/npc/obj/toukui")->wear();
  add_money("silver",10);
}
#include "shiwei.h"  