inherit NPC;
void create() {
  set_name("皇宫侍卫", ({ "shi wei" }));
  set("gender", "男性");
  set("age", 20 + random(30));
  set("combat_exp", 200000);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);
  set_skill("blade", 60);

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("d/city/npc/obj/tiejia")->wear();
  carry_object("d/city/npc/obj/toukui")->wear();
  add_money("silver", 40);
}

#include "shiwei.h"
