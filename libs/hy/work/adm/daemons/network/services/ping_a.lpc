#include <net/dns.h>
#include <net/macros.h>
 
inherit F_CLEAN_UP;

void create()
{
	seteuid(ROOT_UID);
}
void incoming_request(mapping info)
{
	if(!ACCESS_CHECK(previous_object()))
	return;
	
	if (info["NAME"] && info["NAME"] != Mud_name())
	{
		DNS_MASTER->set_mud_info( htonn(info["NAME"]), info);
	}
}