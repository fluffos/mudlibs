// killer.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	object ob;
	if (duration < 1) {
		tell_object(me, "官府不再通缉你了！\n");
		return 0;
	}
if (duration == 3) 
		{
		switch(random(3))//随机产生一名巡捕
		{case 0 : ob=new("/d/unpker/npc/xunbu1"); shout(HIW "【官府通告】知府：本府已派出一般巡捕处理这次PK事件。\n" NOR);break;
		 case 1 : ob=new("/d/unpker/npc/xunbu2"); shout(HIW "【官府通告】知府：本府已派出高级巡捕处理这次PK事件。\n" NOR);break;
		 case 2 : ob=new("/d/unpker/npc/xunbu3"); shout(HIW "【官府通告】知府：本府已派出超级巡捕处理这次PK事件。\n" NOR);break;
		}
		ob->move(environment(me)); 
		ob->kill_ob(me);    
	        tell_object(me,HIW "巡捕突然出现在你的身后。\n" NOR);
	}

	me->apply_condition("killer", duration - 1);
	return 1;
}
