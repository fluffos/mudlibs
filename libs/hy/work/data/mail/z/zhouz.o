dbase (["long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。","id":"mailbox","no_beg":1,"owner_id":"zhouz","name":"信箱","no_insert":1,"no_steal":1,"unit":"个","no_put":1,"no_get":1,"no_drop":1,])
