dbase (["long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。","no_insert":1,"no_put":1,"id":"mailbox","no_steal":1,"no_beg":1,"no_drop":1,"name":"醉卧美人膝的信箱","unit":"个","no_get":1,"owner_id":"chao",])
mails ({(["from":"逍遥子(xiaoyao zi)","title":"我自己做的thousand-gold看看能不能放上去","text":"// thousand.cinherit MONEYvoid create(){        set_name(HIY 一千两金票 NOR, ({thousand-gold, thousand-gold_money, gold_money}))        if( clonep() )                set_default_object(__FILE__)        else {                set(money_id, thousand-cash)                set(long, 一张面额值十万两银子的银票。\\n)                set(unit, 叠)                set(base_value, 100000)                set(base_unit, 张)                set(base_weight, 3)                set(no_drop,1)                set(no_give,1)                set(no_get,1)                set(no_put,1)        }        set_amount(1)}","time":967695800,"to":"hxsd",]),(["from":"舒畅(leee)","title":"红包","text":"// huangu-dan.c 炸弹/* written by victor */#include <ansi.h>inherit ITEM;void create(){        set_name(HIR \"红包\" NOR, ({\"hongbao\", \"bao\"}));        set_weight(20);        if (clonep())                set_default_object(__FILE__);        else {                set(\"unit\", \"个\");                set(\"long\", \"一个红色诱惑发的红包（hongbao），你可以打开（open）。\\n\");                set(\"value\", 1000);}        setup();}void init(){ if (!wizardp(this_player())) {        set(\"no_get\",\" 嘿嘿，做梦吧! \\n\");        set(\"no_drop\",\"红包哪能乱扔! \\n\");}        add_action(\"do_open\", \"open\");}int do_open(string arg){        object me = this_player();        if (!id(arg))           return notify_fail(\"你打开什么？\\n\");   me->set(\"qi\",(int)this_player()->query(\"max_qi\"));   me->set(\"jing\",(int)this_player()->query(\"max_jing\"));    me->set(\"food\", 3000);      me->set(\"water\", 3000);message_vision(HIR       \"$N打开了一个红包，心满意足的笑了笑，专心练功去了! \\n\"NOR,me);destruct(this_object());}","time":971850766,"to":"chao",]),(["from":"批(pkerpker)","title":"哈哈","text":"哈哈","time":971859648,"to":"chao",]),(["from":"醉卧美人膝(chao)","title":"你帮帮我看看错在哪里了，我以前是对的，但是我家了35 和 36行","text":"// lingzhi.c 千年灵芝//星星(lywin)2000/4/22inherit ITEMvoid setup(){}void init(){        add_action(do_open, open)}void create(){        set_name(HIR礼+HIC+物+HIY+盒NOR, ({liwuhe, full-liwuhe}))        if (clonep())                set_default_object(__FILE__)        else {                set(unit, 盒)                set(long, RED 这是撒旦+BLU+魔王+RED+特意给人类制作的礼物。\\n)                set(value, 10)        }        setup()}int do_open(string arg){        if (!id(arg))        return notify_fail(你要打开什么？\\n)        this_player()->add(max_neili,700)        this_player()->add(water,300+random(1))        ob1->move(me)        message_vision(HIR $N打开一盒礼物，天空中出现了一个(admin)说到:感谢你们对这里的支持，希望多拉点人来玩 !\\n, this_player())        destruct(this_object())        return 1}","time":972190852,"to":"xianger",]),(["from":"醉卧美人膝(chao)","title":"帮帮查查出错在哪里thank","text":"// lingzhi.c 千年灵芝//星星(lywin)2000/4/22inherit ITEMvoid setup(){}void init(){        add_action(do_open, open)}void create(){        set_name(HIR礼+HIC+物+HIY+盒NOR, ({liwuhe, full-liwuhe}))        if (clonep())                set_default_object(__FILE__)        else {                set(unit, 盒)                set(long, RED 这是撒旦+BLU+魔王+RED+特意给人类制作的礼物。\\n)                set(value, 10)== 未完继续  [01        }        setup()}int do_open(string arg){        if (!id(arg))        return notify_fail(你要打开什么？\\n){        this_player()->add(max_neili,700)        this_player()->add(water,300+random(1))        ob1->move(me)}        message_vision(HIR $N打开一盒礼物，天空中出现了一个(admin)说到:感谢你们对这里的支持，希望多拉点人来玩 !\\n, this_player())        destruct(this_object())        return 1","time":972192239,"to":"to zzz",]),(["from":"醉卧美人膝(chao)","title":"帮我在lsfy call","text":"str 120          max_atman 3000int 120          max_mana   spi 120          age  dur 120          存款能多少就多少＊月影神功 (yueying)        to                 70＊飞刀绝技 (feidao)         to                250＊段氏剑法 (duan-sword)     to                300＊段氏步法 (duan-steps)     to                3