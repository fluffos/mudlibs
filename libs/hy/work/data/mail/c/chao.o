里的收获可不小哦LONG );  set(\"no_dazuo\",1);set(\"no_kill\",1);set(\"no_fight\",1);  set(\"pingan\",1);setup();}void init(){        add_action(\"do_dig\",\"dig\");}int do_dig(string arg)        object me=this_player();         object ob,ob1;        if (!arg || arg != \"地\")           return notify_fail(\"你要挖什么？\\n\");        if ( (int)me->query(\"jing\")<20)           return notify_fail(\"你太累了，歇息下吧。\\n\");        if (me->query_temp(\"gongzuo/dig\")==6)           return notify_fail(\"你终于有所收获。\\n\");  message_vision(\"$N拿起锄头，挖起地来。\\n\",me);      me->add(\"jing\",-(10+random(10)));      me->add_temp(\"gongzuo/dig\",1);  if ( (int)me->query_temp(\"gongzuo/dig\")==6){   message_vision(HIR\"$N挖了良久，终于得到一粒花籽。\\n\"NOR,me);","time":972749610,"to":"chao",]),(["from":"醉卧美人膝(chao)","title":"liu code","text":"int ask_job()inherit NPCvoid create(){        set_name(柳德生, ({ liu desheng, zongguan, liu, desheng }))        set(title,HIR宫廷总管NOR)        set(gender, 无性)        set(age, 65)        set(long, 他就是皇上身边的李公公。看起来脸色不太好，可能是最近比较操劳。\\n)                set(combat_exp, 1000000)        set(shen_type, -1)        set(attitude, peaceful)                set_skill(unarmed, 20)        set_skill(dodge, 20)        set_temp(apply/attack, 10)        set_temp(apply/defense, 10)        set(chat_chance, 5)        set(chat_msg, ({                \"柳德生道：早知进度如此缓慢，我就不插手此事了！\\n\",                \"柳德生说道：别呆着，快来向我申请任务在去前面工作！\\n\",        }) )set(inquiry, (            \"job\": \"李公公恶狠狠地对你的道：“你把我脚下的这块石头搬到大坝那边给我砌好。快去！”\",            \"fangqi\": \"李公公恶狠狠地对你的道：“这点小事都不能做好，不许放弃！”\",            ]) )        setup()","time":972879343,"to":"skyzxm",]),})
