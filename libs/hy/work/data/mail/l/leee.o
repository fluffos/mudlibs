#/clone/misc/mailbox.c
dbase (["long":"这是个人信箱，但信件内容对巫师无法保密，请勿谈及个人隐私：mailto  <某人>            寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read    <信件编号>        阅读某一封信件。discard <信件编号>        丢弃一封信件。","no_drop":1,"name":"舒畅的信箱","unit":"个","id":"mailbox","no_insert":1,"owner_id":"leee","no_get":1,"no_put":1,"no_beg":1,"no_steal":1,])
mails ({(["title":"红包","time":971850766,"text":"// huangu-dan.c 炸弹/* written by victor */#include <ansi.h>inherit ITEM;void create(){        set_name(HIR \"红包\" NOR, ({\"hongbao\", \"bao\"}));        set_weight(20);        if (clonep())                set_default_object(__FILE__);        else {                set(\"unit\", \"个\");                set(\"long\", \"一个红色诱惑发的红包（hongbao），你可以打开（open）。\\n\");                set(\"value\", 1000);}        setup();}void init(){ if (!wizardp(this_player())) {        set(\"no_get\",\" 嘿嘿，做梦吧! \\n\");        set(\"no_drop\",\"红包哪能乱扔! \\n\");}        add_action(\"do_open\", \"open\");}int do_open(string arg){        object me = this_player();        if (!id(arg))           return notify_fail(\"你打开什么？\\n\");   me->set(\"qi\",(int)this_player()->query(\"max_qi\"));   me->set(\"jing\",(int)this_player()->query(\"max_jing\"));    me->set(\"food\", 3000);      me->set(\"water\", 3000);message_vision(HIR       \"$N打开了一个红包，心满意足的笑了笑，专心练功去了! \\n\"NOR,me);destruct(this_object());}","from":"舒畅(leee)","to":"chao",]),(["title":"no","time":973349636,"text":"no","to":"leee","from":"萧天(xiaotian)",]),})
