dbase (["no_get":1,"home_host":({"kenc","snowfly",}),"long":"    这里是不不和雪花飘的家。家里的摆设并不多，但却相当的整洁和温馨。客厅里有一个天蓝色的大沙发，上面放着许多软软的靠垫。雪花飘最喜欢做在这个大沙发里，靠着不不的肩膀看电视，不不每当这个时候，就看着娇羞的小妻子，无限疼爱而小宝宝，却老是喜欢在地上爬来爬去，说着他自己才懂的语言，咿咿呀呀的无限的温馨，无限的幸福。","id":"h_kenc","name":"天鹅湖","file_name":"h_kenc","no_magic":1,"short":"天鹅湖","bed_long":"小猪小猪快起床  小猪很皮不起床小猪小猪快起床  小猪小猪不起床。","no_fight":1,"exits":(["out":"/d/taohuacun/taohua7",]),])
out "/d/taohuacun/taohua7"
