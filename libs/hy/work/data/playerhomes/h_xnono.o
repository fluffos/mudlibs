#/d/taohuacun/obj/home.c
dbase (["no_magic":1,"long":"这里是不不和雪花飘的别墅。天蓝色的丝质窗帘上缀着白色的小花，海蓝色的地毯显得非常的气派墙面上挂着大大小小的照片，都是不不和雪花飘珍藏的生活片段最大的那张，是不不和雪花飘婚礼时的照片雪花飘一身天蓝色的婚纱，手里捧着白色的百合，带着甜甜的微笑，一脸的娇羞不不穿着新郎的礼服显得格外挺拔，他傻傻的笑望他美丽的小妻子，无限的疼爱让人看了都能感受他们的幸福和快乐。","bed_long":"这是一张丹麦式的大床，床上铺着淡天蓝色的床罩和窗帘相得益彰，显得格外的清新和淡雅。床的周围放着许多白色香甜的小花， 那是雪花飘每天亲手更换的，香香甜甜的气味，让人忍不住多吸一口.","id":"h_xnono","exits":(["out":"/d/taohuacun/taohua7",]),"name":"青蛙王子","short":"青蛙王子","home_host":({"xnono","snowfly",}),"no_get":1,"file_name":"h_xnono","no_fight":1,])
out "/d/taohuacun/taohua7"
