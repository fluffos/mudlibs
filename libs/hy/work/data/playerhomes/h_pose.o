dbase (["exits":(["out":"/d/taohuacun/taohua7",]),"no_fight":1,"long":"    这里就是梦秋痕和陈慧琳的温馨爱屋。    一进门就看到墙上梦秋痕和陈慧琳的合影，陈慧琳依偎在梦秋痕的怀里，一副撒娇的模样，好可爱哦！门的左边有一张软床(bed)。床头正对的地方摆着一张梳妆台。桌上摆着一个光亮的铜镜，铜镜旁边的花瓶里，有一束百合花，正在散发出淡淡的幽香。里边放着两张木椅，中间是一茶几，上面摆着一盆漂亮的山茶花。","file_name":"h_pose","name":"觅爱小屋","no_magic":1,"short":"觅爱小屋","no_dazuo":1,"bed_long":"zzz    zzz两人谁的好香哦","id":"h_pose","no_get":1,"home_host":({"pose","kelly",}),])
out "/d/taohuacun/taohua7"
