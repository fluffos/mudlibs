string resolve_path(string Current, string Next){
   string *exp;
   if(!Current) Current="/";
   if(!Next) Next=user_path(this_player()->query_name());
   if(Next[0]=='/'){
      exp=explode(Next,"/");
      if(sizeof(exp)<=1){
          return Next;
      }
      if(exp[<1]==".."){
        Next="/"+implode(exp[0..<3],"/");
        return Next;
      }
      return Next;
  }
  if(Next=="here") return file_name(environment(this_player()));
  if(Next[0]=='~'){
     if(Next[0..1]=="~/") return user_path(this_player()->query_name())+Next[2..]; 
     exp=explode(Next,"/");
     exp[0]=user_path(exp[0][1..])[0..<2];
     Next=implode(exp,"/");
     return Next;
  }
  if(Current[<1]!='/') Current+="/";
  Next=Current+Next;
  exp=explode(Next,"/");
  if(sizeof(exp)<=1){
       return Next;
   }
   if(exp[<1]==".."){
     Next="/"+implode(exp[0..<3],"/");
     return Next;
   }
   return Next;
}
