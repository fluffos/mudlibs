#include <config.h>

string mud_name()
{
     return MUD_NAME;
}

string lib_name()
{
     return LIB_NAME;
}

string lib_version()
{
     return LIB_VERSION;
}

int port()
{
     return __PORT__;
}

string driver_version()
{
     return __VERSION__;
}

string arch() 
{
      return __ARCH__; 
}

string get_base(object ob)
{
     string temp;
     sscanf(file_name(ob), "%s#%*s", temp);
     return temp;
}
     

