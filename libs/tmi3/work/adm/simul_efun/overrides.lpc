int exec( object to, object from )
{

     if(master()->query_member(query_privs(previous_object()), "admin")) return efun::exec(to, from);
     else return 0;
    
}

void destruct(object ob)
{
     ob->remove();
     if(ob) efun::destruct(ob);
}

void shutdown( int how )
{
     object *users = users();
     int i;
     for (i = 0; i < sizeof(users); i ++)
     {
          users[i]->save_user();
     }
     if(file_name(previous_object()) == "/cmds/adm/shutdown") efun::shutdown(how);
}

void set_privs(object ob, string privs)
{
     if(master()->query_member(query_privs(previous_object()), "admin")) efun::set_privs(ob, privs);
}
     