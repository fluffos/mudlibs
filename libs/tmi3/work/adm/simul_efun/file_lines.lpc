// A simul_efun that takes the specified file and checks for
//      the amount of "\n"s in the file, thereby getting the
//      total amount of lines in the file.

int file_lines(string file)
{
  string str;
  string *lines;

  if(file_size(file) < 1)
    return 0;
  
  str = read_file(file);
  lines = explode(str, "\n");
  return sizeof(lines);
}

