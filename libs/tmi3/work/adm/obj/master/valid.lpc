#include <config.h>

#define G_FILE "/adm/etc/groups"
#define A_FILE "/adm/etc/access"

//#define DEBUG /*Will spam the hell out of ya if defined!*/

string *parse(string str);
string *query_group(string group);
int query_member(string user, string group);
int query_access(string directory, string gu, int type);
string *track_member(string gu, string directory);

mapping access;
mapping groups;

void create()
{
     string *arr, directory, gu, permissions, arguments, temp, *arr2, *temp2;
     mapping data;
     int i, n;

     access = ([]);
     groups = ([]);
     data = ([]);
     arr = ({});
     arr2 = ({});
     temp2 = ({});


     //Proccess groups
     arr = parse(read_file(G_FILE));

     for(i = 0; i < sizeof(arr); i++)
     {
          arr2 = ({});
          temp2 = ({});
          
#ifdef DEBUG
          write("\nSecurity Debug: Parsing group data.\n");
#endif

          if(!sscanf(arr[i], "(%s)%s", gu, temp))
          {
               write("Security Alert: Error in parsing group file.\n");
               write("Diagnostic Data: Stage 1, Element " + i + ", String: " + arr[i] + " (Invalid format)\n");
               write("Security Alert: Ignoring group...\n");
               continue;
          }
          
#ifdef DEBUG
          write("Security Debug: Exploding data into array for group " + gu + ".\n");
#endif          
          arr2 = explode(temp, ":");
#ifdef DEBUG

          write("Security Debug: Adding following users to group " + gu + ".\n");
                   
          for(n = 0; n < sizeof(arr2); n++)
          {
               write(arr2[n] + "\n");
          }
#endif
          groups += ([gu : arr2]);
     }

     //Proccess access
     
     arr = parse(read_file(A_FILE));
#ifdef DEBUG
          write("\nSecurity Debug: Parsing access data.\n");
#endif    
     for(i = 0; i < sizeof(arr); i ++)
     {
          arr2 = ({});
          temp2 = allocate(8);
          data = ([]);
          
          if(!stringp(arr[i])) continue;
          
          
          if(!sscanf(arr[i], "(%s)%s", directory, arguments))
          {
               write("Security Alert: Error in parsing access file.\n");
               write("Diagnostic Data: Stage 1, Element " + i + ", String: " + arr[i] + " (Invalid format)\n");
               error("Security Alert: Security compromised (unable to parse permissions).\n");
          }
          
#ifdef DEBUG
               write("Security Debug: Stage 1, Element " + i + ", String: " + arr[i] + "\n");
               write("Security Debug: Now attempting to explode string.\n");
#endif
          
          if(arguments[<1..< 1] == ":")
          {
               write("Security Alert: Error in parsing access file.\n");
               write("Diagnostic Data: Stage 1.5, Element " + i + ", Directory " + directory + ", String " + arr[i] + " (Extra : found at end of line)\n");
               error("Security Alert: Security compromised (unable to parse permissions).\n");
          }
          
          arr2 = explode(arguments, ":");
          
#ifdef DEBUG
               write("Security Debug: Stage 1.5,  Element " + i + ", String: <array>\n");
               write("Security Debug: Now entering loop to parse string exploded to array.\n");
#endif
          
          for(n = 0; n < sizeof(arr2); n ++)
          {
                         temp2 = allocate(8);
#ifdef DEBUG
                    write("Security Debug: Stage 2, Element " + i + " " + n + ", String: " + arr2[n] + "\n");
                    write("Security Debug: Not attempting to extract permission data.\n");
#endif

               if(!sscanf(arr2[n], "%s[%s]", gu, permissions))
               {                        
                         write("Security Alert: Error in parsing access file.\n");
                         write("Diagnostic Data: Stage 2, Element " + i + " " + n + ", Directory " + directory + ", String " + arr2[n] + " (Invalid format)\n");
                         error("Security Alert: Security compromised (unable to parse permissions).\n");
               }
#ifdef DEBUG
                    write("Security Debug: Data extracted...\n");
                    write("  Group/User: " + gu + " Permissions: " + permissions + " Directory: " + directory + "\n");
                    write("Security Debug: Now interpreting and assigning data.\n");
#endif
               //read, write, network, shadow, link, execute, bind, ownership
               if(strsrch(permissions, "r") != -1) temp2[0] = "r";
               if(strsrch(permissions, "w") != -1) temp2[1] = "w";
               if(strsrch(permissions, "n") != -1) temp2[2] = "n";
               if(strsrch(permissions, "s") != -1) temp2[3] = "s";
               if(strsrch(permissions, "l") != -1) temp2[4] = "l";
               if(strsrch(permissions, "e") != -1) temp2[5] = "e";
               if(strsrch(permissions, "b") != -1) temp2[6] = "b";
               if(strsrch(permissions, "o") != -1) temp2[7] = "o";

               data += ([gu : temp2]);
               
          }
          
#ifdef DEBUG
               write("Security Debug: Exiting inner-loop.\n");
               write("Security Debug: Adding directory (" + directory + ") data to permission mapping.\n");
#endif
          
          access += ([directory : data]);
          
     }
}

int valid_shadow(object ob)
{
     string location, name;
     location = get_base(ob);
     name = query_privs(ob);
     if(query_access(location, name, 4)) return 1;     
     return 0;
}

int valid_bind(object obj, object owner, object victim)
{
     string name;
     name = query_privs(previous_object());
     if(query_access(get_base(owner), name, 7) && query_access(get_base(victim), name, 7)) return 1;
     return 0;
}

