//Simple clone command

//Last updated July 1st, 2005 by Tacitus


int main(string file)
{
	object obj;
	if(!file)
	{
		if(!this_player()->query("cwf"))
			return notify_fail("Error [clone]: You must supply an argument. Syntax: clone <file>\n");
		file=this_player()->query("cwf");
		
	}
		obj=clone_object(file);
		//move it to the users environment until invs get done
		obj->move(environment(this_player()));
		write("Successful [clone]: Objectt cloned to environment.\n");
	  return 1;
}
