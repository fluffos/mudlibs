//more.c

//Gwegster @ Tmi-3
//30-JUNE-05
//A simple file pager command

/*
  Changes:

  Jhereg, 06/30/05 - fixed amount of lines shown on subsequent pages
  Gwegster, 06/30/05 - changed various typos, etc.
*/

// define variables
int morelines = 20;
int startline = 1;
int totallines;
int currentline;
string moreversion = "0.1a";
string thefile;

// define functions
void next_line(string str); // parses input
void display_more_line(int filesize, int current_line); // displays a more line and hands user input over to next_line()
void write_read_file(int start_line, int end_line);

int main(string file)
{

  if(!file) // didn't type anything
  {
    write("Usage: more <filename>\n");
    return 1;
  }

  file = resolve_path(this_player()->query("cwd"), file);

  if(!file_exists(file)) // can't find file
  {
    write("Error: couldn't find specified file.\n");
    write("Usage: more <filename>\n");
    return 1;
  }

  // check if current player has any settings; if none, set them automatically
  if(!this_player()->query("morelines") || this_player()->query("morelines") < 1)
  {
    this_player()->set("morelines", morelines);
  }

  morelines = this_player()->query("morelines"); // set the amount of lines to show
  totallines = file_lines(file); // get the total number of lines of the file
  write("More version "+moreversion+" -- File: "+file+" -- Size: "+file_size(file)+"\n\n");
  thefile = file;
  write_read_file(startline, morelines); // display the file
  display_more_line(totallines, (startline + morelines)); // display a more line
  currentline = morelines + startline; // set the current line
  return 1;
}

void next_line(string str) // command parser
{
  // variables
  int i, j, k;
  string str2;
  i = 0;

  if(!str || str == "\r" || str == "") // if they just pressed enter
  {
    write_read_file(currentline, morelines); // read file, fixed..  don't add currentline.
    if( (currentline + morelines) >= totallines ) 
    {
       // write("\n");
        return;
    }
    else
    {
        currentline = currentline + morelines;
        display_more_line(totallines, currentline); // show a more line
    }
  }

  // display help
  else if(str == "h" || str == "help" || str == "Help")
  {
    write("\nMore version "+moreversion+" help file:\n");
    write("  !<command>         - allows a user to perform a command while inside more\n");
    write("  set_lines <number> - changes the amount of lines to show at one time (default " + morelines + ")\n");
    write("  <line number>      - display the specified line number\n");
    write("  <line1> to <line1> - displays from line1 to line2\n"); 
    write("  line               - display current line number\n");
    write("  q, quit            - quits more\n");
    write("  v, version         - displays version info\n");
    write("  h, help            - displays this!\n");
    write("\n");
    display_more_line(totallines, currentline);
  }

  // quit
  else if(str == "q" || str == "quit" || str == "exit")
  {
    write("\n");
    return;
  }

  // version info
  else if(str == "v" || str == "version")
  {
    write("\nMore version: "+moreversion+"\n");
    display_more_line(totallines, currentline);
  }

  // display current line
  else if(str == "line")
  {
    write("Line "+currentline+"\n");
    display_more_line(totallines, currentline);
  }

  //display from line to line
  else if(sscanf(str, "%d to %d", i, j))
  {
    sscanf(str, "%d to %d", i, j);
    startline = i;
    //write("\n");
    write_read_file(startline, j);
    currentline = j+1;
    display_more_line(totallines, currentline);
  }

  // display line
  else if(sscanf(str, "%d", i))
  {
    sscanf(str, "%d", i); //check if they entered only one number
    startline = i; // set startline
    //write("\n"); //
    write_read_file(startline, startline+1);
    currentline = i; // set currentline to startline
    display_more_line(totallines, currentline);
  }

  // set the amount of lines to show
  else if(sscanf(str, "set_lines %d", i))
  {
    sscanf(str, "set_lines %d", i);

    if(i > 0)
    {
      this_player()->set("morelines", i);
      morelines = i;
      write("\nYou set your morelines to "+morelines+".\n");
    }

    else
    {
      write("\nYou cannon set the amount of lines to less than 1.\n");
    }
    
    display_more_line(totallines, currentline);
  }

  else if(sscanf(str, "!%s", str2))
  {
    sscanf(str, "!%s", str2);
    write("\n");
    this_player()->force_me(str2);
    input_to("next_line");
    display_more_line(totallines, currentline);
  }
    
  else
  {
    write("Unknown command. Please type \"help\" for more info.\n");
    display_more_line(totallines, currentline);
  }
}

void display_more_line(int filesize, int current_line)
{
  int f;
  f = (current_line*100)/(filesize); 
  if(f > 100)
  {
    write("\n");
    return;
  }

  write("-=-= More [");
  write(f);
  write(" %] =-=- > ");
  input_to("next_line");
}

void write_read_file(int start_line, int end_line)
{
  string more;
  if(end_line > totallines)
    more = read_file(thefile, start_line, totallines);
  else
    more = read_file(thefile, start_line, end_line);

  if(more == 0)
    return;
  else
  {
    write(more);
  }
}
