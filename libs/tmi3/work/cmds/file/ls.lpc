//File Navigation

//Last edited on July 1st, 2005 by Tacitus

int main(string arg)
{
     string path;
     string *dir;
     int first_period;
     int i;

     if(!arg)
     {
          arg = this_player()->query("cwd");
          if (!arg) arg = "/";
     }
     if (arg[<1..<1] == " ")
     arg = arg[0..<2];
     if (arg == "/.." || arg == ".") {
          write("Error [ls]: no such directory.\n");
          return 1;
     }
     if (arg[<1..< 1] != "/" && file_size(arg + "/") == -2)
     arg = arg + "/";
     path = arg;
     if (arg[<1..<1] == "/") {
          arg =  arg + "*";
     }
     else {
          for (i = strlen(path); path[--i] != '/';);
          first_period = path[i+1] == '.';
          path = path[0..i];
     }
     if(!get_dir(arg))
     {
          write("Error [ls]: Invalid directory. Change directory to a valid directory.\n");
          return 1;
     }
     dir = get_dir(arg);
     if (!sizeof(dir)) {
          write("Error [ls]: no such file or directory.\n");
          return 1;
     }
     printf("Directory: " + arg + "\n");
     for(i = 0; i < sizeof(dir); i++)
     {
          if((i%4)==0) printf("\n");
          if(directory_exists(replace_string(arg, "*", "") + dir[i])|| dir[i] == "..") printf("%-20s", dir[i] + "/");
          else printf("%-20s", dir[i]);
     }
     write("\n");
     return 1;
}
