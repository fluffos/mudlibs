//File system management

//Last edited on July 1st, 2005 by Tacitus

int main(string str)
{	
     if (!str) return notify_fail("Syntax: rm <file name>\n");
     str = resolve_path(this_player()->query("cwd"), str);
     if(directory_exists(str) || !file_exists(str)) return notify_fail("Error [rm]: " + str + " is not a file.\n");
     if(!(int)master()->valid_write(str, this_player(), "rm"))
     {
          write("Error [rm]: Permission denied.\n");
          return 1;
     }
     write(rm(str) ? "Successful [rm]: File removed.\n" : "Error [rm]: Could not remove file.\n");
     return 1;
}