//An extreamly basic file pager by Tacitus @ TestMud
//030705


int main(string str)
{
        if(!str) {
                write("No argument passed.\n");
                return 1;
        }
        str=resolve_path(this_player()->query("cwd"),str);
        if(!file_exists(str))
        {
            write("That file does not exist.\n");
            return 1;
        }
        cat(str);
        return 1;
}
