int main(string arg)
{
     /* clean up first */
     if (file_size("/tmp/tmp_eval_file.lpc") != -1)
     rm ("/tmp/tmp_eval_file.lpc");
     if (find_object("/tmp/tmp_eval_file"))

     destruct(find_object("/tmp/tmp_eval_file"));

     write_file("/tmp/tmp_eval_file.lpc","mixed eval() { "+arg+"; }\n");
     printf("Result = %O\n", "/tmp/tmp_eval_file"->eval());
     return 1;

}
