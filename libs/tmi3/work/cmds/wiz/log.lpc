// a little log viewer command

//Last edited July 1st, 2005 by Tacitus

int main(string logname)
{
  if(!logname)
  {
    if(!tail("/logs/compile"))
    {
      write("Usage: log [logname]\n");
      return 1;
    }
    return tail("/log/compile");
  }
  else
  {
    if(tail("/log/" + logname) < 1)
    {
      write("Error [log]: The specified log file cannot be found.\n");
      return 1;
    }
    return tail("/log/" + logname);
  }
}
