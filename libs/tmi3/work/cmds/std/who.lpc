//Standard Command

//I don't like it, please recode this for me :) [Tacitus]

int main()
{
   string ret;
   object *list;
   int i;
   ret = "";
ret +=
 "\t _____  _      _      _____ \n" +
 "\t/__ __\\/ \\__/|/ \\     \\__  \\\n" +
 "\t  / \\  | |\\/||| |_____  /  |\n" +
 "\t  | |  | |  ||| |\\____\\_\\  |\n" +
 "\t  \\_/  \\_/  \\|\\_/     /____/\n\n";


   ret += sprintf("%-20s   idle\n\n", "Username [* editing, + in input]");
   for (list = users(), i = 0; i < sizeof(list); i ++)
	 {
		     if(!(string)list[i]->query_name()) continue;

                ret += sprintf("\t%-25s %4dm\n", capitalize((string)list[i]->query_name()) +
                (in_edit(list[i]) ? "*" : "") +
                (in_input(list[i]) ? "+" : ""),
                query_idle(list[i]) / 60);
	}
	
	ret +=("\n");
	write(ret);
	return 1;
}
