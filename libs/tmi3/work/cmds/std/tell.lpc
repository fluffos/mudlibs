// a tell command

//Last edited on July 7th, 2005 by Tacitus

int main(string str)
{
  string who, message;
  
  if(!str) return(notify_fail("Error [tell]: You must provide an argument. Syntax: tell <player> <message>\n"));
  
  if(!sscanf(str, "%s %s", who, message)) return(notify_fail("Usage: tell <player> <message>\n"));

  if(!find_player(who))
  {
    write("Error [tell]: User " + who + " is not found.\n");
    return 1;
  }

  if(who == this_player()->query_name())
  {
    tell_room(environment(this_player()), capitalize(this_player()->query_name()) + " starts talking to themselves.\n", this_player());
    write("You tell yourself: " + message + "\n");
    return 1;
  }

  tell_object(find_player(who), capitalize((string)this_player()->query_name()) + " tells you: " + message + "\n");
  write("You tell " + capitalize(who) + ": " + message + "\n");
  return 1;
}
