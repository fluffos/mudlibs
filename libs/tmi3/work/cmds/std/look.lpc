//Standard Command

//Last updated June 29th, 2005 by Tacitus

int main()
{
     mapping exits;
     string ret, *keys;
     object *inv;
     int i;
     
     ret = "";
     
     ret += "\t" + environment(this_player())->query_short() + "\n";
     ret += environment(this_player())->query_long();
     if(ret[<1..<2] != "\n") ret += "\n";
     
     exits = environment(this_player())->query_exits();
     keys = keys(exits);
     ret += "Exits are: ";
     for(i = 0; i < sizeof(keys); i ++)
     {
          ret += keys[i] + "; ";
     }
     
     ret += "\n\n";
     
     for(inv = all_inventory(environment(this_player())), i = 0; i < sizeof(inv); i++)
     {
          if(inv[i] != this_player()) ret += capitalize(inv[i]->query_short()) + "\n";
     }
     

    
    
     
     write(ret + "\n");
     return 1;
}
     
     