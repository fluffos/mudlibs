//emote.c

//Simple emote command

//Tacitus @ Tmi-3
//02-APR-05
//General Command


int main(string arg)
{
     if (!arg) return 1;
     else
     {
          write("You emote: " + capitalize(this_player()->query_name()) + " " + arg + "\n");
          say (capitalize(this_player()->query_name()) + " " + arg + "\n");
          return 1;
     }
}
