//wall.c

//Tacitus @ Tmi-3
//01-JULY-05
//Admin wall cmd

int main(string str)
{
     int i;
     object *users;
     
     if(!str)
     {
          write("Error [wall]: You must supply an argument. Syntax: wall <msg>\n");
          return 1;
     }
     
     users = users();
     
     for(i = 0; i < sizeof(users); i++)
     {
          tell_object(users[i], "**** System Wide Message From: " 
          + capitalize(this_player()->query_name()) + " at " + ctime(time()) 
          + " ****\n\n\t" + str + "\n");
     }
     
     return 1;
}
          
     
     