// a simple (yet effective) character deletion command

//Last edited on July 1st, 2005 by Tacitus

// define variable
string player;

// define functions
void confirm_nuke(string str);

int main(string char)
{
     player = char;
     if(!char)
     {
          write("Usage: nuke <player>\n");
          return 1;
     }

     if(!user_exists(player))
     {
          write("Error [nuke]: There is no such user.\n");
          return 1;
     }

     write("Are you sure you want to delete "+char+"? [y/n] ");
     input_to("confirm_nuke");
     return 1;
}

void confirm_nuke(string str)
{
     if(str == "y" || str == "yes")
     {
          if(find_player(player))
          {
               tell_object(find_player(player), "You watch as your body dematerializes.\n");
               tell_room(environment(find_player(player)), "You watch as " + capitalize(player) + " dematerializes before your eyes.\n", find_player(player));
               find_player(player)->save_user();
               find_player(player)->remove();
          }

          write("Warning [nuke]: Now removing player's data file (pfile).\n");
          if(file_exists("/data/users/" + player[0..0] + "/" + player + ".o"))
          rm("/data/users/" + player[0..0] + "/" + player + ".o");
          else
          {
               write("Error: couldn't locate character file. Aborting.\n");
               return;
          }
          write("Successful [nuke]: " + capitalize(player) + " has been removed.\n");
          return;
     }

     else
     {
          write("Error [nuke]: Aborting nuke.\n");
          return;
     }
}

