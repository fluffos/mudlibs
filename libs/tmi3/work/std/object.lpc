#include <config.h>

inherit OB_E;

private string *ids, name, short, long;

void remove()
{
     object *inv = all_inventory();
     int i;
     load_object(VOID_OB);
     for (i = 0; i < sizeof(inv); i ++)
     {
          if(interactive(inv[i])) inv[i]->move(VOID_OB);
     }
     
efun::destruct(this_object());
}

int move(mixed dest)
{
     if(move_object(dest)) return 1;
     else return 0;
}

void set_ids(string *arg)
{
     ids = arg;
}

int id(string arg)
{
     if (!arg || !ids) {
          return 0;
     }
     return (member_array(arg, ids) != -1);
}

int set_name(string str)
{
     string temp;
     temp = query_privs(previous_object());
     if(temp == "[admin]" || temp == "[master]" || temp == "[daemon]")
     {
          name = str;
          return 1;
     }
     return 0;

}

string query_name()
{
     return name;
}

int set_short(string str)
{
     short = str;
}

string query_short()
{
     if(!short) return name;
     return short;
}

int set_long(string str)
{
     long = str;
}

string query_long()
{
     return long;
}
