//Last updated June 29th, 2005 by Tacitus

#include <config.h>

inherit OBJECT;

mapping exits, items;
int light;

int set_exits(mapping exit);
int remove_exit(string id);
int set_light(int level);
int set_items(mapping item);
int valid_exit(string exit);
int query_light();
string query_short();
string query_long();
string query_item(string id);
string query_exit(string id);
mapping query_exits();

int set_exits(mapping exit)
{
    exits = exit;
    return 1;
}

int set_items(mapping item)
{
    items = item;
    return 1;
}

int remove_exit(string id)
{
    if(!exits[id]) return 0;
    else map_delete(exits, id);
    return 1;
}

int set_light(int level)
{
    light = level;
    return 1;
}

int valid_exit(string exit)
{
    if(exits[exit]) return 1;
    return 0;
}

int query_light()
{
    if(light) return query("light");
    return light;
}

string query_short()
{
    if(::query_short()) return ::query_short();
    else return query("short");
}

string query_long()
{
    if(::query_long()) return ::query_long();
    else return query("long");
}

string query_item(string id)
{
    if(items[id]) return items[id];
}

string query_exit(string id)
{
     if(exits[id]) return exits[id];
}

mapping query_exits()
{
     mapping copy;
     copy = exits;     
     return copy;
}




