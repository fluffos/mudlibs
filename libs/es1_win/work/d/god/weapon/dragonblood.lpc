#include <mudlib.h>

inherit WEAPON;

string C_NAME="[37;1m龙血枪[37;0m";

void create()
{
	seteuid(getuid());
	set_name( "lance of dragonblood", C_NAME );
	add( "id", ({ "lance", "dragonblood" }) );
	set_short( "长枪「银龙之血」" );
	set_long(
		"这就是许多诺顿骑士一生的梦想，完美的长枪「银龙之血」。这把长枪\n"
		"据说是数百年前一条银龙所守护的宝藏，许多人都相信这是工匠之神埃\n"
		"理亚(Ariah)赠送给人间最伟大骑士的礼物 ，这把长枪完美的造型与它\n"
		"无坚不摧的力量能带给使用它的骑士最大的荣耀。\n"
	);
	set( "unit", "把" );
	set( "type", "jousting" );
	set( "weapon_class", 48 );
	set( "min_damage", 25 );
	set( "max_damage", 52 );
	set( "weight", 120 );
	set( "hit_func", "weapon_hit" );
	set( "value", ({ 5600, "silver" }) );
	set( "no_sale", 1 );
}

int weapon_hit(object victim, int damage)
{
	if( (string)victim->query("race")!="dragon" ) return 0;
	victim->receive_special_damage( "magic", damage );

	return damage;
}



