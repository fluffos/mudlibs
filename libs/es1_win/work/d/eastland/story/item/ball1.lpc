#include <mudlib.h>

inherit OBJECT;

void create()
{
        set_name("spirit ball","巽灵珠");
        add( "id" , ({ "ball" }) );
        set_short( "巽灵珠");
        set_long(@C_LONG
一颗墨黑色的圆球，犹如一粒黑珍珠。
C_LONG  );      
        set("unit","颗");
        set("weight",50);
        set("no_sale",1);
        set("spiritball",1);
        set("master","???");
        set("value", ({1, "silver"}) );
}
