#include "takeda.h"
inherit ARMOR;

void create()
{
        set_name("broad_brimmed rain hat", "遮日黑箬笠");
        add( "id", ({ "hat" }) );
        set_short( "broad_brimmed rain hat", "遮日黑箬笠");
        set_long(
                "A broad_brimmed rain hat .\n",
                "一顶遮阳用的大斗笠，可避免阳光直射． \n"
        );
        set("unit","顶");
        set( "type", "head" );
        set( "material", "wood");
        set( "armor_class", 5 );
        set( "defense_bonus", 2 );
        set( "special_defense",
               ([ "energy":6, "fire":6]) );
        set( "weight", 40 );
        set( "value", ({ 56, "gold" }) );
}



