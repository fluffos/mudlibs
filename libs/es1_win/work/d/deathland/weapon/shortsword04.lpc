#include "../echobomber.h"

inherit WEAPON;

void create() {
  set_name("horn shortsword", "号角短剑");
  add("id", ({ "shortsword", "sword" }));
  set_short("号角短剑");
  set_long(
    "一把形状很像号角的短剑\n"
  );

  set("no_sale", 1);
  set("unit", "把");
  set("weapon_class", 30);
  //set("second",1);
  set("type", "shortblade");
  set("min_damage", 22);
  set("max_damage", 32);
  set("weight", 87);
  set("value", ({ 2100, "silver" }));
}
