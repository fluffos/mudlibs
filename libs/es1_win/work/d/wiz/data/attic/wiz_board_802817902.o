#d/wiz/wiz_board.c
ob_data (["long":"@@query_long","short.text":"巫师留言板","short":"@@query_short","name":"board","c_cap_name":"留言板","long.text":"这是一个留言板，专供人留言纪事。详细用法请参看 help board。这个留言板虽然是属於巫师公会的，但任何人都欢迎在这里留言。","c_name":"留言板","id":({"board","bulletin board",}),"silent_look":1,])
messages ({(["locked":"elon","id":55,"title":"会议记录","body":"    五月二十日会议记录    出席人员: Annihilator , Elon , Ruby , Iris , Aquarius ,              Ega , Redheart , Indra    讨论提纲       1 . 更换 driver : 前一次更换driver 後crash 三次, 原因均为                         griffon , 推测是mount.c 有问题, 改写                         mount.c 後更换driver.         2 . 武器等级 : 武器等级原本的建议表似乎并不受重视 . 有提案                      建议改行ES2 的weapon type 方式, 但因物品太多                      故无结果 .        3 . 由於记忆体接近饱和 , 故将来有新区域出现时, 将逐步关闭           部份旧区域 , 并修正 ES 之风格 .       4 . heart_beat() 改写.以减低 cpu load       5 . 对於玩家指令 \"do\" 加以限制, 每个 heart heat 限为五个.           且scan 方式由 explode 改为 sscanf       6 . body 由object 改写後置入 daemon .       7 . 档案流出 : 据信其它MUD 有相当多的file 来自ES , 因为无法防范                      故请欲\"交流\"者先行知会一声, 以免发生误会。并请各                      位在写档案时记得於档头处签上智慧财产权声明.                      如 : // This file contains all gamble funcs                           //   By Indra@Eastern_Story  5.20.95       8 . 鉴於巫师日渐增多, 而产能并未跟著提高 , 故见习巫师升为正式巫师           後一段时间(一至三个月)若无作品, 将酌情予以暂时调降回见习巫师.       9 . 更换driver 後改写lib , 整理 daemons .                                                        记录 Indra.","time":801083538,"poster":"Indra",]),(["locked":"elon","id":85,"body":" 5/27/95 ES 会议记录 (13:00 - 16:10)出席者: (ES) Indra, Iris, Elon, Lica        (插花的) Heal, Chanel特别感谢 Iris 请客..... :)  1. 三个月没上线的玩家档案要砍, 以节省 disk space...    -> Elon 写指令砍档 2. 夫妻 Party 有 bonus, 另一半上线会通知.    -> Indra 3. 种族, 公会属性上限修改    -> Iris 4. Auction 抽成比例    -> Indra 5. 把四个大神的雕像放回去    -> Iris 6. 各种族的魔法防御调为不高於 + - 50%    -> Iris 7. beholder 增加一项可以穿的 : amulet    -> Iris 8. 结婚的条件 (以上线时间或等级来限制)    -> Elon 9. 见习巫师升巫师时需经过 domain arch 及 Elon 面试通过.10. 特攻武器的特色及修改    -> 各 domain arch 负责, 细节请找 Iris, Indra or Elon 问.11. 巫师公会没用的 board 要砍要整理.    -> Elon12. 特攻时的 block command 要改 (eg, Beholder gaze)    -> Indra13. 色狼协会的东东..    -> Elon & Lica14. 开放 Social Guild...  让玩家申请设立.    -> Elon15. Party 分 exp 的公式 (改为 level 平方...)    -> Indra16. 新版 Rule ....    -> Elon (& Tsunami)17. Iris 的暑假作业... 详情请问 Iris 各项标题的细节将由负责人各别提出讨论... -Elon","title":"ES 5/27/95 Meeting","time":801626200,"poster":"Elon",]),(["id":124,"title":"来聊聊天吧!","body":"大家在ES那麽久了 很多巫师都还没见过面 许\多人都要毕业了所以我再招开一次聊天会时间 : 6/3 (周六) 下午 2:00集合地点 : 清大斜对面 屈臣式门口附近(那天angel 带墨镜 如果你看到一个像 席维斯史特龙+阿诺使瓦新格的... that is it! :P)有空就来啦! 喝茶聊天 angel请客端午不回家的6/3 周六下午 2:00 清大对面 的 屈臣式 OH! :P欢迎巫师有空又不回家的来喝茶 谈天!Angel, oldcat innocense, odin tsunamiishage, redheart, ..... 敬邀","time":801947662,"poster":"Angel",]),(["id":125,"body":"            just find two equip have small bug:P            智者护身符 & 幸运护身符 extra_stats 写成 extra_status..            plz fix it..:P","title":"equip wrong..","time":801956203,"poster":"Innocence",]),(["id":126,"title":"Re: 来聊聊天吧!","body":"On Thu Jun  1, Angel wrote:> 大家在ES那麽久了 很多巫师都还没见过面 > 许\多人都要毕业了> 所以我再招开一次聊天会> > 时间 : 6/3 (周六) 下午 2:00> 集合地点 : 清大斜对面 屈臣式门口附近> > (那天angel 带墨镜 如果你看到一个像 席维斯史特龙+阿诺使瓦新格的... that is it! :P)> > 有空就来啦! 喝茶聊天 angel请客> > 端午不回家的> > 6/3 周六下午 2:00 清大对面 的 屈臣式 OH! :P> > 欢迎巫师有空又不回家的来喝茶 谈天!> > Angel, oldcat innocense, odin tsunami> ishage, redheart, ..... 敬邀不能去了... 那天中午在台北有一ㄊㄨㄚ.... 晚一点的话倒有可能...-elon","time":801970457,"poster":"Elon",]),(["id":127,"title":"Re: 来聊聊天吧!","body":"On Thu Jun  1, Angel wrote:> 大家在ES那麽久了 很多巫师都还没见过面 > 许\多人都要毕业了> 所以我再招开一次聊天会> > 时间 : 6/3 (周六) 下午 2:00> 集合地点 : 清大斜对面 屈臣式门口附近> > (那天angel 带墨镜 如果你看到一个像 席维斯史特龙+阿诺使瓦新格的... that is it! :P)> > 有空就来啦! 喝茶聊天 angel请客> > 端午不回家的> > 6/3 周六下午 2:00 清大对面 的 屈臣式 OH! :P> > 欢迎巫师有空又不回家的来喝茶 谈天!> > Angel, oldcat innocense, odin tsunami> ishage, redheart, ..... 敬邀------------------------------------------------  +takeda, yuehIf any wiz will come, plz mail me, i will waiting for u all","time":801977309,"poster":"Angel",]),(["id":128,"body":"现在把/d/doc的状况交代一下,我在这里面加了两个目录, 一个是note, 另一个是domain_master    note中放的是平时post在巫师版上,值得保留以供日後大家参考的东西,    以抓下来的先後顺序排列, 虽然目前只有两个files..    domain_master中放的是mad所制作的各区域负责巫师名单, 其顺序和mad置於    冒险者公会地下室北边的顺序是相同的, 不过有些遗漏的,    由於自己也不清楚, 还没来得及加上去;    另外在/doc/wizhelp中还有两个help档案未中文化, 虽然曾经想补, 但由於我    放不进去, 存档又在前天清理/open时杀掉了,     所以要麻烦後来接手的人有空做一下了, 其他的与原来相同, 我都没有动,    如果还有补充不足的, 我会再来补交代的.                                                 Tsunami","title":"< no title >","time":802012257,"poster":"Tsunami",]),(["id":129,"title":"about invis, hidden, darkness... etc.","body":"我想, 目前在 /cmds/std/_look.c 里面的 can_see() 这个 fuction, 或许\改到body 下面去作比较好, 因为巫师们常常会要用到这个功\能,尤其是在作一些 monster 挡路的情况下尤其需要。_look 里面那个 can_see() 里面似乎有些地方怪怪的,我也说不太上来...--EGA","time":802076910,"poster":"Ega",]),(["id":133,"body":"刚刚放蛇之後很无聊... 想想要写程式算有多少人大概比用手算慢...所以我就算了.... 结果, ES 一共有 3709 个 save 档..应该有 370-400 左右的人口吧...-elon","title":"人数...","time":802242789,"poster":"Elon",]),(["id":134,"body":"新版 player & wiz rules 挂上去了... 有意见的找我... -elon","title":"rules","time":802244914,"poster":"Elon",]),(["id":135,"title":"Re: rules","body":"On Sun Jun  4, Elon wrote:> 新版 player & wiz rules 挂上去了... 有意见的找我... > > -elon嗯  ...找到错字...^_^家间的 pk 是何法的.            ^^            合利用程试里的 bug,      ^^      式","time":802253874,"poster":"Odin",]),(["id":136,"title":"Re: equip wrong..","body":"On Thu Jun  1, Innocence wrote:>             just find two equip have small bug:P>             智者护身符 & 幸运护身符 extra_stats 写成 extra_status..>             plz fix it..:P	 fix lo ..","time":802257531,"poster":"Aquarius",]),(["id":137,"body":"On Sun Jun  4, Odin wrote:> On Sun Jun  4, Elon wrote:> > 新版 player & wiz rules 挂上去了... 有意见的找我... > > > > -elon> 嗯  ...找到错字...^_^> > 家间的 pk 是何法的.>             ^^>             合> 利用程试里的 bug,>       ^^>       式嗯... tsunami 该打 :)-elon","title":"Re: Re: rules","time":802266830,"poster":"Elon",]),(["id":138,"title":"< no title >","body":"最近发现了让怪物使用特殊的指令的方法, 只要将_command.c copy 至/cmds/std/monster 即可使用另外好像怪物可以使用实习巫师的指令, 也可以用command(\"...\")来处理                        Sincerely Your Takeda","time":802275503,"poster":"Takeda",]),(["id":139,"title":"Re: < no title >","body":"On Sun Jun  4, Takeda wrote:> 最近发现了让怪物使用特殊的指令的方法, 只要> 将_command.c copy 至/cmds/std/monster 即可使用> 另外好像怪物可以使用实习巫师的指令, 也可以用command(\"...\")来处理>                         Sincerely Your Takeda    没错, 也可以在 mob 的档案里加上 :	call_other(\"/cmds/std/_look\",\"cmd_look\",\"east\");	this is a example for mob to look east							[C						茹比PS. call_other 的参数请参考 help call_other","time":802276893,"poster":"Ruby",]),(["id":140,"body":"介面没有作多大的改变, 但是速度上应该比以前「快很多」如果发现有 bug 或 reboot 後开不起来的话, 请换回/adm/simul_efun/tell_room.6.5.95--EGA","title":"modify simul_efun: tell_room()","time":802331861,"poster":"Ega",]),(["id":141,"title":"ES2 moved to new site","body":"ES2 最近找到一台 sparc 10 model 51 可以用，为了让 ES 跑得顺一点，已经将 ES2 搬过去了，现在 port 4000 的 ES2 人数上限降为 20，一周就关闭，ES2 mudlib 仍留在这里供有兴趣的人参考( 约 2.4 MB )。鉴於 ES 目前的困境，我仍然会常常来瞧瞧，我也不希望因此而造成「分家」的感觉，我们仍然是同一伙人。PS. ES 的改良仍需继续，否则 ES2 空出来的资源也帮不了什麽。						- Annihilator","time":802337533,"poster":"Annihilator",]),(["id":142,"title":"< no title >","body":"oh.. 忘了一件事，ES2 搬到 140.113.250.1 4000，有空过来聊聊。							- Annihilator","time":802338536,"poster":"Annihilator",]),(["id":143,"body":"Hi ! All ::    Today I find a player named 'Malk' , a monk, press <enter> and seems goto have happy dinner .. By the new rules ..We must make a 警告 on him, but .. he seems not here so can hear what I say .. Hmm... How to make a warning on him neh ...Hmm... so hard ...    So ... I have no choose .. zap him three times and force him to quit ..I think he will get BIG surprise at next login .I will mail and explain this to him ..    about new rules .. who can tell me how we can make a warning on players ??							Ruby","title":"press <enter>","time":802353522,"poster":"Ruby",]),(["id":144,"body":"可不可以将 auction 及 guild message 加上一个检查 block_message Elsa","title":"< no title >","time":802358888,"poster":"Elsa",]),(["id":145,"title":"Re: < no title >","body":"On Mon Jun  5, Elsa wrote:> 可不可以将 auction 及 guild message 加上一个检查 block_message > > Elsa    现在连冥思都不 block message 了，还加 block message 的检查做什麽？						茹比","time":802369661,"poster":"Ruby",]),(["id":146,"body":"怪物现在不会流血, 请检查...                                   Sincerely your Takeda","title":"< no title >","time":802402637,"poster":"Takeda",]),(["id":147,"title":"About Special_Defense","body":"不知为何, 穿上装备後再data看special_defense的效果,竟不会改变?         Sincerely your mad...","time":802408998,"poster":"Mad",]),(["id":148,"body":"On Tue Jun  6, Takeda wrote:> 怪物现在不会流血, 请检查...>                                    Sincerely your Takedafixed....其实以前也会流, 只是改了tell_room,讯息没出来而以                                 Iris","title":"Re: < no title >","time":802411883,"poster":"Iris",]),(["id":149,"title":"Re: Re: < no title >","body":"On Tue Jun  6, Iris wrote:> On Tue Jun  6, Takeda wrote:> > 怪物现在不会流血, 请检查...> >                                    Sincerely your Takeda> fixed....> 其实以前也会流, 只是改了tell_room,> 讯息没出来而以>                                  Iris我想知道以前怪物流血的地方是怎麽写的, 因为我改 tell_room的时候认为效果应该与以前完全一样才对...怎麽会改了新版的 tell_room 讯息就出不来呢?--EGA","time":802434118,"poster":"Ega",]),(["id":150,"title":"Re: Re: Re: < no title >","body":"On Tue Jun  6, Ega wrote:> On Tue Jun  6, Iris wrote:> > On Tue Jun  6, Takeda wrote:> > > 怪物现在不会流血, 请检查...> > >                                    Sincerely your Takeda> > fixed....> > 其实以前也会流, 只是改了tell_room,> > 讯息没出来而以> >                                  Iris> > 我想知道以前怪物流血的地方是怎麽写的, 因为我改 tell_room> 的时候认为效果应该与以前完全一样才对...> 怎麽会改了新版的 tell_room 讯息就出不来呢?> --> EGA在 /std/conditions/bleeding.6.6.95                                     Iris.","time":802442310,"poster":"Iris",]),(["id":151,"title":"< no title >","body":"我以将island不份区域重新开放了!","time":802442457,"poster":"Odin",]),(["id":152,"body":"On Tue Jun  6, Iris wrote:> On Tue Jun  6, Ega wrote:> > On Tue Jun  6, Iris wrote:> > 我想知道以前怪物流血的地方是怎麽写的, 因为我改 tell_room> > 的时候认为效果应该与以前完全一样才对...> > 怎麽会改了新版的 tell_room 讯息就出不来呢?> > --> > EGA> 在 /std/conditions/bleeding.6.6.95>                                      Iris.看到了, 是旧写法的问题, 我以为已经没有地方这样写了。看看是要彻底砍掉以前放中英讯息的程式还是再把 tell_room 改回与旧写法相容。P.S. 要找出所有的旧式写法似乎不是很简单...--EGA","title":"Re: Re: Re: Re: < no title >","time":802455234,"poster":"Ega",]),(["id":153,"title":"tell_room 改回来吧..","body":"  Dear Ega:      I can receive player moveing message even   under hidden on .... seems a little ......                          Indra :P","time":802494151,"poster":"Indra",]),(["id":154,"title":"banishes.o fixed..","body":"   Dear All :       最进都不能create new character ..      刚刚看了... 应该是banishes.o 的格式弄错      改回来了.. 看看还会不会有问题.                             indra.","time":802503961,"poster":"Indra",]),})
