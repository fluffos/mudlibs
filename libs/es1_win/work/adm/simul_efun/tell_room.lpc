varargs void tell_room(mixed room, mixed msg, mixed exclude) {
  if (stringp(msg)) {
    if (!room || !objectp(room)) return;
    // AGENTS.md §7.12: a 2-arg call leaves exclude as int 0, which
    // message() rejects ("Bad argument 4 to message()... Expected:
    // object, array, Got: int(0)") -- fall back to an empty array.
    // Ported from sibling esI's own deep functional test (§10.7):
    // reproduced live there via weather_d.lpc's change_phase(), a
    // self-rescheduling call_out with no enclosing catch() -- the
    // uncaught throw aborts the function before it reschedules its own
    // next call_out, permanently killing the day/night phase daemon
    // for the rest of that boot. Same byte-identical file here, not
    // independently reproduced live on this lib this pass, but the
    // shape and root cause are identical (confirmed via diff).
    message("tell_room", msg, room, exclude || ({}));
    return;
  }
  error("Tell_room: Message must be a string.\n");
}
