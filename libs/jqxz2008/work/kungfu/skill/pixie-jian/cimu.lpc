// cimu.c 辟邪剑法「刺目」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int busytime;
  object weapon;
  string msg;
  busytime = me->query_skill("pixie-jian") / 10;
  if (busytime > 20) busytime = 20;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「刺目」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if ((int)me->query_skill("pixie-jian", 1) < 40)
    return notify_fail("你的辟邪剑法不够娴熟，不会使用「刺目」。\n");
  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够。\n");
  msg = HIG "$N使出辟邪剑法「刺目」，迅捷无伦地刺向$n的眼睛。\n";

  //if( random(me->query("combat_exp")) * 100 > (int)target->query("combat_exp")/10) 
  if (random((int)me->query_skill("pixie-jian", 1)) * 10 > (int)target->query_skill("dodge")) {
    msg += HIR " 结果$p的眼珠子被$P刺得鲜血淋漓，惨不忍睹！\n" NOR;
    target->start_busy(busytime);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
    me->start_busy(1);
  }
  me->add("neili", -80);
  message_vision(msg, me, target);

  return 1;
}
