inherit ITEM;

void init();
int do_eat(string arg);

void create()
{
        set_name( "番木鳖",({ "fanmubie"}));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
                set("long","这是一棵番木鳖。\n");
                set("value", 10000);
                set("material", "");
        }
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object me;
        me=this_player();
        message_vision("$N吃下一棵番木鳖，手脚挣扎了几下，中毒死了。",me);
        me->die();
        destruct(this_object());
        return 1;
}
