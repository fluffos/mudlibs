// niqiu.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("干煸泥鳅", ({"niqiu","food"}));
	set_weight(40);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一盘香喷喷的干煸泥鳅。\n");
		set("unit", "盘");
		set("value", 40);
		set("no_get","1");
		set("food_remaining", 5);
		set("food_supply", 15);
	}
}
