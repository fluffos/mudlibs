// icy_cloth.c

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name( HIR "血斗篷" NOR, ({ "doupong", "pong" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("value", 40000);
		set("material", "cloth");
		set("armor_prop/armor", 10);
		set("armor_prop/dodge", 5);
	}
	setup();
}
