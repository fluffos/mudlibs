// add by atu for LSFY 2000/01/10
#include <ansi.h>
inherit NPC;

int ask_me();

void create() {
  set_name("展昭", ({ "zhan zhao", "zhan" }));
  set("title", "开封府首席捕头");
  set("nickname", HIY "御猫" NOR);
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这是个二十来岁的英俊男子，着一袭青衣，昂然挺立。\n"
  );
  //

  set("attitude", "heroism");
  set("vendetta_mark", "authority");

  set_temp("kf_tufei", 68);
  set("pursuer", 1);
  //
  set("int", 30);
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("agi", 25);


  set_temp("apply/damage", 500);
  set("force", 10000);
  set("max_force", 10000);
  set("combat_exp", 12000000);

  set_skill("force", 190);
  set_skill("jingyiforce", 100);
  set_skill("dodge", 190);
  set_skill("feixian-steps", 120);
  set_skill("unarmed", 180);
  set_skill("feixian-sword", 120);
  set_skill("parry", 190);
  set_skill("sword", 150);
  set_skill("move", 150);
  set_skill("literate", 100);

  map_skill("force", "jingyiforce");
  map_skill("dodge", "feixian-steps");
  map_skill("parry", "feixian-sword");
  map_skill("sword", "feixian-sword");
  map_skill("move", "feixian-steps");



  set("inquiry", ([
    "开封府": "\n任何人只要加入开封府(join kaifengfu)，就可以为朝廷出力。\n",

    "捕快": "\n任何人只要加入开封府(join kaifengfu)，就可以为朝廷出力。\n",
    "work": "\n任何人只要加入开封府(join kaifengfu)，就可以为朝廷出力。\n",
    "任务": "\n任何人只要加入开封府(join kaifengfu)，就可以为朝廷出力。\n",
  ]));
  set("chat_chance", 3);
  //    set("chat_msg", ({
  //            "xxxxxxxxxxxxxxxxx！\n",
  //
  //        }) );
  setup();
  carry_object(__DIR__ "obj/duosword")->wield();
  carry_object("/obj/cloth")->wield();
}
void init() {
  object ob;
  mapping myfam;
  ob = this_player();
  ::init();
  add_action("do_join", "join");
  //
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
  //
}

int do_join(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "kaifengfu")
    return notify_fail("你要加入什么组织？\n");
  if (ob->query("kaifengfu")) {
    message_vision(HIC "展昭说道：你已经是开封府捕快了。\n" NOR, this_player());
    return 1;
  }
  if (ob->query("combat_exp") < 20000) {
    message_vision(HIC "展昭对$N摇头道：你的实战经验太低。\n" NOR, this_player());
    return 1;
  }
  ob->set("kaifengfu", 1);
  ob->add("title", HIY "【开封府实习捕快】" NOR);
  command("tell " + this_player()->query("id") + " 从现在起你就是个实习捕快了.\n");
  ob->add("score", 100);
  message_vision(HIC "$N的评价提高了！\n" NOR, ob);
  tell_object(ob, "你现在的评价是" + chinese_number((string)(ob->query("score"))) + "。\n" NOR);
  return 1;
}
