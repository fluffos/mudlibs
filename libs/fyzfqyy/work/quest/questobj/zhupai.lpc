#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(GRN"竹牌"NOR, ({ "zhupai" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "块");
            set("material", "stone");
            set("long", "西方神教青竹先生的信物\n");
          }

    setup();
}
