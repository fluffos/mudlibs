#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIM"玲珑钗"NOR, ({ "linglongchai" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "支");
            set("material", "cloth");
            set("long", "一支玲珑钗。\n");
          }

    setup();
}
