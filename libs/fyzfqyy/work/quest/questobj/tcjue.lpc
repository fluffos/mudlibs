#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIW"天残诀"NOR, ({ "tcjue" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "本");
            set("material", "paper");
            set("long", "铁少的天残诀\n");
          }

    setup();
}
