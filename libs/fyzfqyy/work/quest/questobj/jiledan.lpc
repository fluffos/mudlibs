// ken 1999.12.7

#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIR"极乐丹"NOR, ({ "jiledan" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "丸");
            set("material", "stone");
            set("long", "一丸极乐丹，可惜药力不足了，若能加强(jia)它一定更有效。\n");
          }

    setup();
}

void init()
{
  if(this_player()==environment())
  add_action("do_jia","jia");
}

int do_jia()
{
object me, *inv;
int i;
object cl,newtask;
me = this_player();
inv = all_inventory(me);
for(i=0; i<sizeof(inv); i++)
{
      if(inv[i]->query("name") == "极乐逍遥散") 
  {     cl = inv[i];
	destruct(cl);
   message_vision("\n$N把极乐丹磨碎，将手里的极乐逍遥散加到粉里调合在一起。\n",this_player());
        newtask = new(__DIR__"obj/jiledan2");
	newtask->move(me);
	destruct(this_object());
        return 1;
  }
}
        return 1;

}
//}

