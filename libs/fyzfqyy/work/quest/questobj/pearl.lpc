inherit ITEM;
#include <ansi.h>
void create() {
  set_name("夜明珠", ({ "lighting-pearl" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只在黑夜里也能闪闪发光的夜明珠，估计如果
能找到一个好一点的盒子，对其稍加装饰(zhuangshi)的话，就能卖个好价钱。\n");
    set("value", 1);
  }
}


void init() {
  if (this_player() == environment())
    add_action("do_zhuangshi", "zhuangshi");
  add_action("do_use", "use");
}

int do_use(string arg) {
  if (arg != "lighting-pearl") return 0;

  tell_object(this_player(), "你掏出一个" + this_object()->name() + "。\n");
  environment(this_player())->light_notify(this_object(), 1);

  return 1;
}



int do_zhuangshi() {
  int i, hezhu = 0, baizhu = 0;
  object jade, me, *inv;
  object zhu1, zhu2;
  me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("name") == "七彩丝缎带") { hezhu = 1; zhu1 = inv[i]; }
    if (inv[i]->query("name") == "[1;37m白玉[2;37;0m珠宝盒") { baizhu = 1; zhu2 = inv[i]; }

  }
  if (hezhu && baizhu) {
    destruct(zhu1);
    destruct(zhu2);
    jade = new("/quest/questobj/obj/he");
    jade->move(me);
    message_vision("$N将白玉珠宝盒打开，小心的把七彩丝缎带铺在里面。将夜明珠
仔细的擦亮放在七彩丝缎带上，最后又满意地将珠宝盒盖儿盖上。\n", this_player());
    destruct(this_object());

  } else
    message_vision("$N手中没有装饰材料，无法对夜明珠进行修饰。\n", this_player());

  return 1;
}
