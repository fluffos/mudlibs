inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
        set_name(HIW "白开心" NOR, ({ "baikaixin" }) );

        set("gender", "男性");
        set("age", 48);
        set("long",
                "这人猥猥琐琐，嘻皮笑脸，正是一副标标准准的地痞无赖相，你无论在任何一个城
的茶楼赌馆花街柳巷里，都可以见到，但无论任何人都不会对这种人多瞧一眼的.\n");
        set("attitude", "aggressive");
        set("skill_public",1);
        set("no_arrest",1);
        set("str", 40);
        set("cor", 30);
        set("int", 24);
        set("cps", 30);
        set("chat_chance", 1);
        set("chat_msg", ({
                "白开心呲着满口的黄牙冲你嘻嘻嘻的直笑.\n",
        }) );
               set("chat_chance_combat", 100);

              set("chat_msg_combat", ({
                (: perform_action, "sword.tianwaifeixian" :),
                (: perform_action, "dodge.tianwaifeixian" :),
        }) );


        set("force", 40000);
        set("max_force", 8000);
        set("force_factor", 100);

        set("combat_exp", 3000000);
        set("score", -20000);
        
        set_skill("iron-cloth", 300);
        set_skill("jin-gang", 300);
               set_skill("sword", 300);
               set_skill("move", 300);
         set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("force", 300);
	set_skill("sword", 300);
	set_skill("unarmed",300);
	set_skill("changquan",300);
	set_skill("feixian-steps",150);
	set_skill("feixian-sword",300);
	set_skill("jingyiforce",100);
        map_skill("dodge", "feixian-steps");
	map_skill("sword", "feixian-sword");
	map_skill("force", "jingyiforce");
	map_skill("parry", "feixian-sword");
	map_skill("unarmed", "changquan");


         map_skill("iron-cloth", "jin-gang");
       
        create_family("eren", 1, "四师傅");
        set("title", HIY "损人不利己" NOR);
        setup();
        carry_object("/quest/tongji/obj/sword1")->wield();

}

