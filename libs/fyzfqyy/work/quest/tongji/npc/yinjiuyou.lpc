inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create() {
  set_name(HIW "阴九幽" NOR, ({ "yinjiuyou" }));
  set("no_arrest", 1);
  set("gender", "男性");
  set("age", 46);
  set("long",
    "    这人虚虚的站在一团雾里,忽隐忽现,也不知是人是鬼。\n");
  set("attitude", "aggressive");
  set("skill_public", 1);
  set("str", 40);
  set("agi", 60);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "飘飘渺渺的传来一阵笑声....嘿....嘿....嘿．．．．\n",
  }));

  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 1500000);
  set("score", -50000);

  set_skill("move", 200);
  set_skill("dodge", 120);
  set_skill("dagger", 200);
  set_skill("force", 130);
  set_skill("iron-cloth", 90);
  set_skill("jin-gang", 130);
  map_skill("iron-cloth", "jin-gang");

  create_family("eren", 1, "十师傅");
  set("title", HIR "半人半鬼" NOR);
  setup();
  carry_object("/quest/tongji/obj/lin")->wield();

}
