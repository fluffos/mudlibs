inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create() {
  set_name(HIG "哈哈儿" NOR, ({ "hahaer" }));

  set("gender", "男性");
  set("no_arrest", 1);
  set("age", 46);
  set("long",
    "    这人矮矮胖胖，笑脸圆圆，象是和气生财的酒店掌柜。\n");
  set("attitude", "aggressive");
  set("skill_public", 1);
  set("str", 40);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "哈哈儿打了个哈哈道:哈哈...这个...天气真好．．．．\n",
  }));
  set("chat_chance_combat", 100);

  set("chat_msg_combat", ({
    (: perform_action, "sword.tianwaifeixian" :),
    (: perform_action, "dodge.tianwaifeixian" :),
  }));



  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 3200000);
  set("score", -50000);

  set_skill("iron-cloth", 300);
  set_skill("jin-gang", 300);
  set_skill("sword", 300);
  set_skill("move", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("unarmed", 300);
  set_skill("changquan", 300);
  set_skill("feixian-steps", 150);
  set_skill("feixian-sword", 300);
  set_skill("jingyiforce", 100);
  map_skill("dodge", "feixian-steps");
  map_skill("sword", "feixian-sword");
  map_skill("force", "jingyiforce");
  map_skill("parry", "feixian-sword");
  map_skill("unarmed", "changquan");
  map_skill("iron-cloth", "jin-gang");



  create_family("eren", 1, "七师傅");
  set("title", HIM "笑里藏刀" NOR);
  setup();
  carry_object("/quest/tongji/obj/sword1")->wield();

}
