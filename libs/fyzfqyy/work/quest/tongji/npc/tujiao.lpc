inherit NPC;
#include <ansi.h>
inherit F_MASTER;
int time_period(int timep, object me);
string sysmsg;
void create() {
  set_name(HIY "屠娇娇" NOR, ({ "tujiaojiao" }));
  set("no_arrest", 1);
  set("gender", "女性");
  set("age", 25);
  set("long",
    "屠娇娇易容数堪称一绝，虽然已经五十多岁了，但看上去好象一个姑娘，只是
看不太清楚容貌如何．．．\n");
  set("attitude", "aggressive");
  set("skill_public", 1);
  set("str", 40);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "屠娇娇娇滴滴地对你说道：你长的．．．．\n",
  }));

  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 1700000);
  set("score", -200000);

  set_skill("move", 220);
  set_skill("dodge", 120);
  set_skill("unarmed", 200);
  set_skill("force", 100);
  set_skill("iron-cloth", 120);
  set_skill("jin-gang", 130);
  set_skill("meihua-shou", 100);
  map_skill("iron-cloth", "jin-gang");
  map_skill("unarmed", "meihua-shou");

  create_family("eren", 1, "五师傅");
  set("title", HIG "不男不女" NOR);
  setup();
  carry_object("/quest/tongji/obj/mianju")->wear();

}
