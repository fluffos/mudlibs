inherit NPC;
#include <ansi.h>
int random_action();
void create()
{
        set_name(HIB "诸葛先生" NOR, ({ "zhu ge" }) );

        set("gender", "男性");
        set("age", 62);
        set("long",
                "    诸葛先生是六扇门里的最高统帅，是传说中罪恶的克星，乃是当今天子
的智囊，武功深不可测。诸葛先生不问世事已久，这次出山是为了......\n");
        set("attitude", "peaceful");
        set("skill_public",1);
        set("str", 26000);
        set("cor", 30);
        set("int", 24);
        set("cps", 30);
        set("per", 50);



        set("chat_chance", 1);
        set("chat_msg", ({
                (: random_action :)
        }) );

        set("force", 400000);
        set("max_force", 800000);
        set("force_factor", 1000);

        set("combat_exp", 200000000);
        set("score", 0);
        set_skill("magic",200);
        set_skill("spells",200);
        set_skill("literate",200);
        set_skill("move",200);
        set_skill("dodge",200);
        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("iron-cloth", 200);
        set_skill("yiqiforce", 100);



        set_skill("dagger",200);
        set_temp("apply/attack",300);
        set_temp("apply/damage",30000);
        map_skill("iron-cloth", "yiqiforce");
        map_skill("force", "yiqiforce");
        map_skill("unarmed", "yiqiforce");

        create_family("六扇门", 1, "统帅");
        set("title", HIR "军师" NOR);
        setup();
        carry_object("/quest/tongji/obj/sword");

}
int accept_fight(object me)
{       object who=this_player();
        command("say 老身久不动手，武艺早已生疏，怎是" + RANK_D->query_respect(who)+ "的对手？");
        return 0;
}


void init()
{
        add_action("give_tongji", "tongji");
}


int accept_object(object who, object ob)
{
       object silk,silk2;
        string sure,weap;
       int  exp, pot, score,c1,val;
        mapping tongji;
       tongji = who->query("tongji");
        val=ob->value();
        weap=HIY"惩恶扬善"NOR;
        if((string)ob->query("id")=="sword" || (string)ob->query("id")=="blade") c1=1;
       if(who->query("m_success/通缉") && c1 && weap == (string)ob->query("name"))
        {command("say 谢谢" + RANK_D->query_respect(who)+ "了!只是那人武功太高,只怕有兵刃亦无济于事,以老朽的功夫,
竟连一招都没能接下,唉....." + RANK_D->query_respect(who)+ "神功盖世,或许可以替老朽雪此一招败于敌手之耻,
也免敌人笑我大国无人.....唉.....那人武功之高,乃老朽平生仅见," + RANK_D->query_respect(who)+ "千万小心了,
那人在老屋以北的我国与罗刹国交界之处,长相丑陋,手拿一铁器,呈直角状," + RANK_D->query_respect(who)+ "
务必小心此物,此物发射之极亮光芒,伤人于无形.....老朽就败于此光之下,唉....吉人自
有天象," + RANK_D->query_respect(who)+ "就此去吧,也许这通古斯之迷就此破解也未可知!!
另外,老朽这身功夫,或者有" + RANK_D->query_respect(who)+ "所需要的,老朽当倾囊相授!\n");
        who->set("m_success/UFO",1);

         return 1;
        }

if (val && val >200000 && val < 300000)
        {
                       who->set("tongji", 0 );
                tell_object(who,"诸
葛先生说道：这也太难为你了，这个通缉任务就算了吧．．\n");
                        who->add("score",-100);
                return 1;
        }


     if(!(tongji =  who->query("tongji")))
        {tell_object(who,"诸葛先生说道：你没有申请通缉十大恶人。\n");


         return 0;
        }
        sure ="m_success/"+tongji["tongji"];
        if(!(ob->query("id") == "tou"))
        {
         tell_object(who,"诸葛先生说道：这不是我想要的。\n");
          return 0;
        }
        if ((string)ob->query("name") != (tongji["tongji"]+"的人头"))
        {
         tell_object(who,"诸葛先生说道：这不是我想要的。\n");
          return 0;
        }

        if (!( who->query("m_success/李大嘴") && who->query("m_success/杜杀") && who->query("m_success/屠娇娇")
                && who->query("m_success/阴九幽") && who->query("m_success/欧阳丁当") && who->query("m_success/萧咪咪") && who->query("m_success/铁战")
&& who->query("m_success/白开心") && who->query("m_success/哈哈儿") && who->query("m_success/轩辕三光")))

        {command("say 这位" + RANK_D->query_respect(who)+ "，你杀了十大恶人之一的"+tongji["tongji"]+"？真是
百姓之福啊！这个勋章颁发给你，继续努力吧！\n");
        silk = new("/quest/tongji/obj/jp");
        silk->move(this_object());
        command("give xzhang to " + who->query("id"));
              exp = 15000+random(3150)+random(215)+random(900)+random(8)+random(7);
              pot = exp / 50 +random(123)-random(53);
              score = pot /5;
               who->add("TTQUEST",1);
         who->set("tongji",0);
         who->set(sure,1);
               who->add("combat_exp",exp);
                who->add("potential",pot);
	    who->add("score",score);
                 tell_object(who,HIW"你被奖励了：\n" +
	    chinese_number(exp) + "点实战经验\n"+
          chinese_number(pot) + "点潜能\n"+
          chinese_number(score) + "点综合评价。\n" NOR);


        return 1;
        }
        else 
        {command("say 这位" + RANK_D->query_respect(who)+ "，你竟然将危害武林的十大恶人全部诛灭？真是英雄
盖世，这番为国为民的胸襟更是令人钦佩！这个勋章颁发给你，另外这个也给你！\n");
        silk = new("/quest/tongji/obj/jp");
        silk->move(this_object());
        silk2 = new("/quest/tongji/obj/jp1");
        silk2->move(this_object());
        command("give jianb to " + who->query("id"));
        who->set("title",HIR"盖"+HIC"世"+HIM"英"+HIW"豪");
        who->set("tongji",0);
        who->set("m_success/通缉",1);
        return 1;
      
        }
}



int give_tongji(string arg)
{
        mapping tongji ;
        object obj0,obj1,obj2;
        string file,location,*roomlines;
        object me;
        int j, combatexp;
        string tag ="1";
        me = this_player();
       


         if((int)me->query("combat_exp") < 2000000)
        {
                command("say " + RANK_D->query_respect(me)+ "武艺虽然不错，但还不足以对付十大恶人，谢谢您的好意！\n");


                return 1;
        }
        if((int) me->is_ghost())
        {
                write("还是先照顾好您自己吧．\n");
                return 1;
        }
        if(me->query("m_success/通缉"))
        {       write("谢谢您的好意！十大恶人已经全部伏法，天下又可以平静一段日子了。\n");
                return 1;

        }
      if((tongji =  me->query("tongji")))
        {
        command("say " + RANK_D->query_respect(me)+ "已经参与了通缉『"+tongji["tongji"]+"』的任务,加油啊!\n");
        return 1;
        }
        
tongji = TONGJI_D(tag)->query_tongji();

        tell_object(me,"好极了,朝廷正在全力围剿『"+tongji["tongji"]+"』你这就去吧,提『"+tongji["tongji"]+"』的头回来,朝廷重重有赏。\n" NOR);
        me->set("tongji", tongji);
                



        file = read_file("/quest/tongji/dynamic_location");
        roomlines = explode(file,"\n"); 
        location = roomlines[random(sizeof(roomlines))];

                switch(tongji["tongji"]){
                        case "李大嘴":
                                obj1=new("/quest/tongji/npc/lidazui");
                                break;
                        case "杜杀":
                                obj1=new("/quest/tongji/npc/dusha");
                                break;
                        case "屠娇娇":
                                obj1=new("/quest/tongji/npc/tujiao");
                                break;
                        case "阴九幽":
                                obj1=new("/quest/tongji/npc/yinjiuyou");
                                break;
                        case "白开心":
                                obj1=new("/quest/tongji/npc/baikaixin");
                                break;
                        case "铁战":
                                obj1=new("/quest/tongji/npc/tiezhan");
                                break;
                        case "萧咪咪":
                                obj1=new("/quest/tongji/npc/xiaomimi");
                                break;
                        case "哈哈儿":
                                obj1=new("/quest/tongji/npc/hahaer");
                                break;
                        case "欧阳丁当":
                                obj1=new("/quest/tongji/npc/ouyangdang");
                                obj2=new("/quest/tongji/npc/ouyangding");
                        case "轩辕三光":
                                obj1=new("/quest/tongji/npc/sanguang");
                                break;
                        }
        obj1->move(location);
        if(obj2) obj2->move(location);
return 1;
}
int random_action(){
switch(random(4)){
        case 0:
          
      command("chat 朝廷缉拿十大恶人,请诸位武林同道加以援手.");
                break;
        case 1:
                command("say 协助朝廷缉拿十大恶人．．．．");
                break;
        case 2:
                command("sigh");
                break;

        case 3:
                command("say 我竟然连一招都．．．．唉．．．．,好厉害的功夫．．．．");
                break;}
     return 1;
}

int recognize_apprentice(object ob)
  {
        if(!(ob->query("m_success/UFO"))){
                say("诸葛先生说道：老朽这点微末之技,又能教你些什么呢?....\n");
                return 0;}
return 1;
}

