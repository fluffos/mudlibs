#include <ansi.h>


inherit ITEM;

void create()
{
        set_name(HIR "嘉奖令" NOR,({"file"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
                "一卷嘉奖令，你很想(open)打开看看。\n");
                set("unit","个");
                set("value", 100);
             }
}

void init()
{
        add_action("open_file","open");
}

int open_file(string arg)
{
        int m_kee;
        int m_sen;
        int m_gin;
        int exp;
        int pot;
        int score,count,i;
        int m_force;
        object silver;
        if ( arg == "file"){
        m_kee = this_player()->query("max_kee");
        m_sen = this_player()->query("max_sen");
        m_gin = this_player()->query("max_gin");
        m_force = this_player()->query("max_force");
        exp = 1000 + random(1000);
        pot = exp / 10 + 20;
        count=random(3)+3;
        score= pot /5 + 10;
  message_vision(HIW"$N抹去头上的汗水，用颤抖的双手展开了$n。\n\n"NOR,this_player(),this_object(),);
        this_player()->set("eff_kee",m_kee);
        this_player()->set("kee",m_kee);
        this_player()->set("eff_gin",m_gin);
        this_player()->set("gin",m_gin);
        this_player()->set("eff_sen",m_sen);
        this_player()->set("sen",m_sen);
        this_player()->set("force",m_force);
        this_player()->add("combat_exp",exp);
        this_player()->add("potential",pot); 
        this_player()->add("score",score);
        this_player()->add("TQUEST",1);
        for(i=0;i<count;i++)
        {silver=new("/obj/money/thousand-cash");
        silver->move(this_player());
        }
        tell_object(this_player(),HIY"你发现上面写着：鉴于你剿匪有功，特此嘉奖你：\n" +
        chinese_number(exp) + "点实战经验。\n"+
      chinese_number(pot) + "点潜能。\n"+
          chinese_number(score) + "点综合评价。\n并奖官银："+
           chinese_number(count) + "千两整！\n"NOR
);
        destruct(this_object());
        return 1;
     }
     return 0; 
}


