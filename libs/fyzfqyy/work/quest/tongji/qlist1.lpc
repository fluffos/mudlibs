#include <ansi.h>
inherit SKILL;
mapping *tongji = ({
        ([      "tongji":                "李大嘴",
                "tongji_n":           	"1",
        ]),
        ([      "tongji":                "屠娇娇",
                "tongji_n":           	"2",
        ]),
        ([      "tongji":                "杜杀",
                "tongji_n":           	"3",
        ]),
        ([      "tongji":                "哈哈儿",
                "tongji_n":           	"4",
        ]),
        ([      "tongji":                "阴九幽",
                "tongji_n":           	"5",
        ]),
        ([      "tongji":                "轩辕三光",
                "tongji_n":           	"6",
        ]),
        ([      "tongji":                "白开心",
                "tongji_n":           	"7",
        ]),
        ([      "tongji":                "萧咪咪",
                "tongji_n":           	"8",
        ]),
        ([      "tongji":                "铁战",
                "tongji_n":           	"9",
        ]),
        ([      "tongji":                "欧阳丁当",
                "tongji_n":           	"10",
        ]),
});
mapping query_tongji()
{
        return tongji[random(sizeof(tongji))];
}

