// save.c

int save()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) ) {
                assure_file(file);
/*
		assure_file(file+ __SAVE_EXTENSION__);
		//此函数定义在simul_efun中的file.c文件中
		//如果参数所指的文件不存在,则为此文件建立起保存的路径
*/
                return save_object(file);
        }
        return 0;
}

int restore()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) )
                return restore_object(file);
        return 0;
}
