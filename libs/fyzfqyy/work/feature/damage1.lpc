#include <ansi.h>
#include <dbase.h>
#include <login.h>	//定义了一些登录时要用到的信息
#include <move.h>	//int move(),query_weight()


varargs int receive_damage(string type, int damage, object who)  //用于减少某一项数值
{
  int val;

  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n请向巫师报告。。\n\n");
  if (objectp(who)) set_temp("last_damage_from", who);
  val = (int)query(type) - damage;
  if (val >= 0) set(type, val);
  else set(type, -1);
  set_heart_beat(1);

  return damage;
}

varargs int receive_wound(string type, int damage, object who)  //受伤
{
  int val;

  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n请向巫师报告。。\n\n");
  if (objectp(who)) set_temp("last_damage_from", who);
  val = (int)query("eff_" + type) - damage;
  if (val >= 0) set("eff_" + type, val);
  else {
    set("eff_" + type, -1);
    val = -1;
  }

  if ((int)query(type) > val) set(type, val);

  set_heart_beat(1);

  return damage;
}

int receive_heal(string type, int heal)  //恢复
{
  int val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n请向巫师报告。。\n\n");
  val = (int)query(type) + heal;
  if (val > (int)query("eff_" + type)) set(type, (int)query("eff_" + type));
  else set(type, val);

  return heal;
}

int receive_curing(string type, int heal)  //治疗
{
  int max, val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n请向巫师报告。。\n\n");
  val = (int)query("eff_" + type);
  max = (int)query("max_" + type);

  if (val + heal > max) {
    set("eff_" + type, max);
    return max - val;
  } else {
    set("eff_" + type, val + heal);
    return heal;
  }
}

void unconcious()  //昏迷
{
  object defeater, ob;
  int time;

  ob = this_object();
  if (!living(ob)) return;
  if (wizardp(ob) && query("env/immortal")) return;  //不昏

  if (objectp(defeater = query_temp("last_damage_from"))) {
    ob->set("faint_by", defeater);
    COMBAT_D->winner_reward(defeater, ob);
  }

  ob->remove_all_enemy();
  //清空对手阵列
  message("system", HIR "\n你的眼前一黑，接著什么也不知道了....\n\n" NOR, ob);
  //message() - 送讯息给活著的 (living) 物件.
  ob->disable_player("<昏迷不醒>");
  set("jing", 0);
  set("qi", 0);
  set_temp("block_msg/all", 1);
  COMBAT_D->announce(ob, "unconcious");

  time = random(100 - query("con")) + 30;
  call_out("revive", time < 10 ? 10 : time);
}

void revive(int quiet)  //苏醒过来
{
  remove_call_out("revive");
  //remove_call_out() - 取消一个延迟中的外部呼叫 (call_out).
  //防止多次苏醒
  while (environment()->is_character())
    this_object()->move(environment(environment()));
  //如在别人的物品栏中?!则把他移动到别人所在的环境
  if (!quiet) {
    COMBAT_D->announce(this_object(), "revive");
    delete_temp("block_msg/all");

    message("system", HIY "\n慢慢地你终于又有了知觉....\n\n" NOR,
      this_object());
  } else
    delete_temp("block_msg/all");
  this_object()->enable_player();
}

void die()  //死亡
{
  object corpse, killer, ob;
  string diemsg;

  ob = this_object();
  if (!living(ob)) revive(1);  //如果没有活着，安静地醒来
  if (wizardp(ob) && query("env/immortal")) return;  //不死

  // Clear all the conditions because death.
  ob->clear_condition();
  COMBAT_D->announce(ob, "dead");

  if (diemsg = (string)ob->query_temp("diemsg"))
    COMBAT_D->killer_reward(diemsg, ob);
  else if (objectp(killer = query_temp("last_damage_from"))) {
    ob->set("kill_by", killer);
    set_temp("my_killer", killer->query("id"));
    COMBAT_D->killer_reward(killer, ob);
  } else {
    diemsg = "莫名其妙的死了";
    COMBAT_D->killer_reward(diemsg, ob);
  }

  //记录死因
  ob->delete_temp("diemsg");
  if (objectp(corpse = CHAR_D->make_corpse(ob, killer)))
    corpse->move(environment());

  ob->remove_all_killer();  //清除死敌阵列，人死万事休
  all_inventory(environment())->remove_killer(ob);

  ob->dismiss_team();
  if (userp(ob)) {
    if (ob->is_busy())
      ob->interrupt_me();
    set("jing", 1); set("eff_jing", 1);
    set("qi", 1); set("eff_qi", 1);
    set("ghost", 1);
    ob->move(DEATH_ROOM);
    DEATH_ROOM->start_death(ob);  //这句似乎没什么用呀！
  } else
    destruct(ob);
}

void reincarnate()  //重生
{
  delete("ghost");
  set("eff_jing", query("max_jing"));
  set("eff_qi", query("max_qi"));
}

int max_food_capacity() { return query_weight() / 200; }

int max_water_capacity() { return query_weight() / 200; }

int heal_up()  //定时更新人物的一些数据
{
  int update_flag;
  mapping my;
  object ob = this_object();

  update_flag = 0;

  my = query_entire_dbase();
  if (userp(ob)) {
    if (my["water"] > 0) {
      my["water"] -= 1;
      if (my["water"] == ob->max_water_capacity() * 0.3)
        tell_object(ob, HIY "\n你舔了舔干裂的嘴唇，看样子是渴了。\n" NOR);
      if (my["water"] == ob->max_water_capacity() * 0.1) {
        tell_object(ob, HIY "\n水，水，你扯着快冒火的嗓子干嚎着。\n" NOR);
        ob->delete_temp("waters");
      }
      update_flag++;
    } else {
      if (!ob->query_temp("waters")) {
        tell_object(ob, HIR "\n水，水，你扯着快冒火的嗓子干嚎着。\n" NOR);
        ob->set_temp("waters", 10);
      }

      if ((int)ob->query_temp("waters") > 1)
        ob->add_temp("waters", -1);
      else {
        tell_object(ob, HIR "\n你渴得快要死了。。。。\n" NOR);
        if (wizardp(ob)) {
          tell_object(ob, HIY "还好你是大唐双龙传的巫师，只见你伸手一挥，变出了一大瓶可口可乐\n" +
            "迫不及待得一仰头连着瓶给整个地吞了下去？！哎，可怜的孩子，看来真得渴坏了！\n" NOR);
          ob->set("water", ob->max_water_capacity());
        } else if (ob->query("nowf", 1) < 5) {
          ob->set_temp("waters", 10);
          ob->add("nowf", 1);
          ob->unconcious();
        } else {
          ob->set_temp("diemsg", "是给活活渴死的");
          ob->set("nowf", 0);
          ob->set("water", ob->max_water_capacity());
          ob->set("food", ob->max_food_capacity());
          ob->die();
        }
      }
      update_flag++;
    }
    if (my["food"] > 0) {
      my["food"] -= 1;
      if (my["food"] == ob->max_food_capacity() * 0.3)
        tell_object(ob, HIY "\n你肚子咕咕直叫，看来得吃点东西了。\n" NOR);
      if (my["food"] == ob->max_food_capacity() * 0.1) {
        tell_object(ob, HIY "\n你饿得直发慌，赶快吃点东西吧。\n" NOR);
        ob->delete_temp("foods");
      }
      update_flag++;
    } else {
      if (!ob->query_temp("foods")) {
        tell_object(ob, HIR "\n你饿得直冒金星，实在是顶不住了。\n" NOR);
        ob->set_temp("foods", 10);
      }

      if ((int)ob->query_temp("foods") > 1)
        ob->add_temp("foods", -1);
      else {
        tell_object(ob, HIR "\n你饿得快要死了。。。。\n" NOR);
        if (wizardp(ob)) {
          tell_object(ob, HIY "还好你是大唐双龙传的巫师，只见你伸手一挥，变出了一大堆好吃的\n" +
            "哇，还有汉堡包耶！，你哗啦两下就吃光了，看来你真是饿坏了！\n" NOR);
          ob->set("food", ob->max_food_capacity());
        } else if (ob->query("nowf", 1) < 5) {
          ob->set_temp("foods", 10);
          ob->add("nowf", 1);
          ob->unconcious();
        } else {
          ob->set_temp("diemsg", "是给活活饿死的");
          ob->set("nowf", 0);
          ob->set("water", ob->max_water_capacity());
          ob->set("food", ob->max_food_capacity());
          ob->die();
        }
      }
      update_flag++;
    }
  }

  if (my["water"] < 1 && userp(this_object()))
    return update_flag;

  my["jing"] += my["con"] / 3 + my["max_jingli"] / 10;
  if (my["jing"] >= my["eff_jing"]) {
    my["jing"] = my["eff_jing"];
    if (my["eff_jing"] < my["max_jing"]) {
      my["eff_jing"]++;
      update_flag++;
    }
  } else
    update_flag++;

  my["qi"] += my["con"] / 3 + my["max_neili"] / 10;
  if (my["qi"] >= my["eff_qi"]) {
    my["qi"] = my["eff_qi"];
    if (my["eff_qi"] < my["max_qi"]) {
      my["eff_qi"]++;
      update_flag++;
    }
  } else
    update_flag++;

  if (my["food"] < 1 && userp(this_object()))
    return update_flag;

  if (my["max_jingli"] && my["jingli"] < my["max_jingli"]) {
    my["jingli"] += my["max_jingli"] / 20;
    if (my["jingli"] > my["max_jingli"])
      my["jingli"] = my["max_jingli"];
    update_flag++;
  }

  if (my["max_neili"] && my["neili"] < my["max_neili"]) {
    my["neili"] += (int)this_object()->query_skill("force", 1) / 2;
    if (my["neili"] > my["max_neili"])
      my["neili"] = my["max_neili"];
    update_flag++;
  }

  return update_flag;
}
