void auto_save(object *user, int size, int i) {
  int j;

  //add by xhm 2000.11.13  判断浩劫系统是否引发
  if (LOGIN_D->get_dienpc() > 3000) call_out("haojie", 0);

  for (j = i; j < i + 5; j++) {
    if (j >= size) return;
    if (!user[j]) continue;
    if (user[j]->save())
      message("vision", RED "【存盘精灵】" NOR + HIY "你的档案自动存储了。\n" NOR, user[j]);
  }
  call_out("auto_save", 1, user, size, i + 5);
}

mapping *query_day_phase() { return day_phase; }

