// Npc: /d/wiz/npc/libiliang.c 李鼻梁
// 处理有关“正负校长”的谜题以及给玩家升级
inherit NPC;
#include <ansi.h>
int ask_js();
int ask_upgrade();
void create() {
  set_name("李鼻梁", ({ "li biliang", "li" }));
  set("gender", "男性");
  set("title", "校长助理");
  set("age", 49);
  set("long",
    "他就是模拟华附的校长助理，小名鼎鼎的李鼻梁了。\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 20);
  set("inquiry", ([
    "奖赏": (: ask_js :),
    "jiangshang": (: ask_js :),
    "奖励": (: ask_js :),
    "jiangli": (: ask_js :),
    "升级": (: ask_upgrade :),
    "levelup": (: ask_upgrade :),
    "upgrade": (: ask_upgrade :),
  ]));
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  setup();
  carry_object("/obj/cloth")->wear();
}

int ask_js() {
  object me = this_player();
  int i = 500 + random(500);
  int n = me->query_skill("literate");
  if (!me->query("marks/正负校长") && me->query_temp("help_headmaster")) {
    message_vision(
      WHT "李鼻梁说道：“$N，你真的把那个杀害我们校长的败类人渣给杀了？\n好，好！老天有眼呀！\n这位" + RANK_D->query_respect(me) + "，干的好！让我给你一些奖赏吧！”\n" NOR,
      me
    );
    me->add("max_force", i);
    me->set_skill("literate", n * 2 + i / 100);
    me->delete_temp("help_headmaster");
    me->set("marks/正负校长", 1);
    tell_object(
      me,
      WHT "你得到了李鼻梁增加" + chinese_number(i) + "点最大实力，增加" + chinese_number(i / 100) + "级读书识字的奖励！\n" NOR
    );
    return 1;
  }
  return 0;
}
int ask_upgrade() {
  object me = this_player();
  if (me->query("level") >= 0) {
    message_vision("李鼻梁对$N说道，嗯，让我看看……\n", me);
    UPGRADE_D->upgrade(me);
    return 1;
  }
  return 0;
}
