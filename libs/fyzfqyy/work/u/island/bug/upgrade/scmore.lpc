// 以下的这些msg，除了kee的是沿用COMBAT_D中的函数之外，其它都是自己写的指针。
string *food_msg = ({  // 食物情况
"饿得只剩最后一口气了。\n",
  "奄奄一息，前心贴后心。\n",
  "肚子不停地“咕咕”叫。\n",
  "腹中空空，该吃饭了。\n",
  "还能撑一段时候。\n",
  "处于饱与饥的临界状态。\n",
  "勉强可以算得上是饱着。\n",
  "腹内存货还有不少呢。\n",
  "酒足饭饱，不缺吃的。\n",
  "现在还饱的很呢。\n",
  "现在是吃饱了撑的。\n",
});

string *water_msg = ({  // 饮水情况
"类似处于脱水状态的木乃伊。\n",
  "喉咙冒烟，眼冒金星。\n",
  "喉咙就快干裂了。\n",
  "渴呀，渴呀，真希望有一缸水。\n",
  "虽然渴，还能撑一段时候。\n",
  "喉咙微干，还算不怎么渴。\n",
  "无聊的上下舔嘴唇。\n",
  "暂时还不需要补充水分。\n",
  "你觉得供水足够，嗓子湿润。\n",
  "走起路来都可以听见肚子里的水晃荡的声音。\n",
  "满肚子尽是水。\n",
});

string *gin_msg = ({  // 精力情况
"接近虚脱，再不休息命不久矣。\n",
  "身体极为疲惫，明显无法做出了睡觉以外的任何事情了。\n",
  "接连不断的打呵欠，已经非常疲惫了。\n",
  "很难支撑得住，真想睡一觉算了。\n",
  "精神略微有些不济，正在勉强支撑。\n",
  "微微觉得有些疲劳。\n",
  "正在强打精神。\n",
  "精力还算旺盛，不需要补充。\n",
  "精力足够，反应及时。\n",
  "精神矍铄，反应灵敏。\n",
  "精力充沛，浑身是劲。\n",
});

string *sen_msg = ({  // 心情情况
"神智不清，不省人事。\n",
  "心情坏到了极点，恐怕不清醒一下就会自寻短见。\n",
  "心情相当差，简直有点糊涂了。\n",
  "心情不好，随便就会发脾气。\n",
  "心情是在不怎么样。\n",
  "聚精会神但仍然觉得心智不济。\n",
  "偶尔会有点跟不上。\n",
  "大脑清晰，思路敏捷。\n",
  "心情不错，大脑清醒。\n",
  "心情很不错。\n",
  "神气完足，心情非常好。\n",
});

// 本来是想实现随降低而颜色改变的，但其实这样显示出来花花绿绿的不太好看，如果你要用，就用下面这个
// status_color()函数吧。
string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
int check_cc(string str);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type, parry_type, *marks, pingjia;
  object weapon;
  int attack_points, dodge_points, parry_points, i, pingjiapt, upexp;
  seteuid(getuid(me));
  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("你只可以察看自己的状态。\n");
  my = ob->query_entire_dbase();
  upexp = exp[my["level"]] - my["combat_exp"];
  printf(CYN "≡" YEL "──模拟华附人物档案表─────────────────────────" CYN "≡\n" NOR);
  line = sprintf(WHT "%s：\n" NOR, "【基本状况】");
  if (!ob->query("title")) {
    line += sprintf("     %s。", ob->query("name"));
  } else line += sprintf("     %s，%s。", ob->query("title"), ob->query("name"));
  line += sprintf("%s，%s岁。\n     于%s出生。\n",
    ob->query("gender"),
    chinese_number(ob->query("age")),
    RTIME_D->chinese_time(2, ctime(ob->query("birthday"))));
  line += sprintf("     目前已经%s级，距下次升级还需要%s点学分值。\n",
    chinese_number(my["level"]),
    chinese_number(upexp));
  line += sprintf("     总共杀过%s个人，其中有%s个玩家，曾经被杀过%s次。\n\n",
    chinese_number(my["MKS"] + my["PKS"]), chinese_number(my["PKS"]), chinese_number(my["KILLED"]));

  line += sprintf(WHT "%s：\n" NOR, "【学习状况】");
  if (mapp(my["family"])) {
    line += sprintf("     到目前为止，总共完成了%s个使命。\n",
      chinese_number(my["TASK"]));
  } else line += sprintf("     到目前为止，总共完成了%s个使命。\n\n",
    chinese_number(my["TASK"]));
  str = "";
  if (mapp(my["marks"])) {
    marks = keys(my["marks"]);
    for (i = 0; i < sizeof(marks); i++) {
      if (str != "") str += "、";
      str += marks[i];
    }
    line += sprintf("     总共破解了%s个谜题，包括：", chinese_number(sizeof(marks)));
    line += sprintf("\n     %s。\n", str);
  }
  if (mapp(my["family"])) {
    if (my["family"]["master_name"])
      line = sprintf("%s     老师是%s的%s。\n\n",
        line, my["family"]["family_name"], my["family"]["master_name"]);
  }
  line += sprintf(WHT "%s：\n" NOR, "【天赋状况】");
  line += sprintf(
    "     才智：%s\t\t体质：%s\n"
    "     灵性：%s\t\t魅力：%s\n"
    "     勇气：%s\t\t力量：%s\n"
    "     耐力：%s\t\t韧性：%s\n"
    "     速度：%s\t\t气量：%s\n"
    "     运气：%s\t\t定力：%s\n\n",
    display_attr(my["int"], ob->query_int()),
    display_attr(my["con"], ob->query_con()),
    display_attr(my["spi"], ob->query_spi()),
    display_attr(my["per"], ob->query_per()),
    display_attr(my["cor"], ob->query_cor()),
    display_attr(my["str"], ob->query_str()),
    display_attr(my["dur"], ob->query_dur()),
    display_attr(my["fle"], ob->query_fle()),
    display_attr(my["agi"], ob->query_agi()),
    display_attr(my["tol"], ob->query_tol()),
    display_attr(my["kar"], ob->query_kar()),
    display_attr(my["cps"], ob->query_cps()));

  line += sprintf(WHT "%s：\n" NOR, "【生活状况】");
  pingjiapt = my["gin"] * 10 / my["max_gin"];
  line += "     精力情况：" + gin_msg[pingjiapt] + "";
  line += "     气血情况：" + COMBAT_D->eff_status_msg(my["kee"] / my["max_kee"] * 100) + "\n";
  line += "     心情情况：" + sen_msg[my["sen"] * 10 / my["max_sen"]] + "";
  line += "     食物情况：" + food_msg[ob->query("food") * 10 / ob->max_food_capacity()] + "";
  line += "     饮水情况：" + water_msg[ob->query("water") * 10 / ob->max_water_capacity()] + "\n\n";
  line += sprintf(WHT "%s：\n" NOR, "【攻防状况】");
  if (objectp(weapon = ob->query_temp("weapon"))) {
    skill_type = weapon->query("skill_type");
    parry_type = "parry";
  } else {
    skill_type = "unarmed";
    parry_type = "unarmed";
  }

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, parry_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  line += sprintf("     攻击力： %-10d防御力： %d\n" NOR,
    attack_points + 1,
    (dodge_points / 2 + (weapon ? parry_points : (parry_points / 2))) + 1);
  line += sprintf("     武器杀伤力： %-6d防具保护力： %d\n" NOR,
    ob->query_temp("apply/damage"), ob->query_temp("apply/armor"));

  line += sprintf("     可分配参数点： %d\n", ob->query("gift_points") -
    ob->query("used_gift_points"));
  write(line);
  printf(CYN "≡" YEL "─────────────────────模拟华附最终测试版─────" CYN "≡\n" NOR);
  return 1;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf(YEL "%3d /%3d" NOR, value, gift);
  else if (value < gift) return sprintf(RED "%3d /%3d" NOR, value, gift);
  else return sprintf("%3d /%3d", value, gift);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return CYN;
  if (percent >= 90) return GRN;
  if (percent >= 60) return YEL;
  if (percent >= 30) return YEL;
  if (percent >= 10) return RED;
  return RED;
}
int check_cc(string str) {
  int i, nn_len;

  for (nn_len = 0, i = 0; i < strlen(str); i++) {
    if (str[i] == 27) {
      for (; str[i] != 109; i++) {
        nn_len++;
      }
      nn_len++;
    }
  }

  return nn_len;
}

int help(object me) {
  write(@HELP
指令格式 : scmore

这个指令可以显示你的更深一层的人物档案，比如说：

≡──模拟华附人物档案表─────────────────────────≡
【基本状况】：
     运动员，阿飞。男性，十六岁。
     于二零零零年七月五日十五点二十三分出生。
     目前已经十六级，距下次升级还需要四百九十九万九千九百六十四点学分值。
     总共杀过一百七十三个人，其中有十五个玩家，曾经被杀过十次。

【学习状况】：
     到目前为止，总共完成了二十四个使命。
     总共破解了二个谜题，包括：
     正负校长、主席台的下面。
     老师是法轮邪教的李洪志。

【天赋状况】：
     才智： 18 / 18             体质： 33 / 33
     灵性： 32 / 32             魅力： 50 / 50
     勇气： 13 /  5             力量： 80 / 30
     耐力： 10 / 10             韧性： 33 / 33
     速度： 10 / 10             气量：  5 /  5
     运气： 50 / 50             定力： 44 / 34

【生活状况】：
     精力情况：精力充沛，浑身是劲。
     气血情况：精神饱满，正处于巅峰状态。
     心情情况：神气完足，心情非常好。
     食物情况：现在还饱的很呢。
     饮水情况：走起路来都可以听见肚子里的水晃荡的声音。

【攻防状况】：
     攻击力： 516468    防御力： 806385
     武器杀伤力： 0     防具保护力： 20
     可分配参数点： 4
≡─────────────────────模拟华附最终测试版─────≡

其中含义不言自明，我就不多说了。
see also : hp,score
HELP
  );
  return 1;
}
