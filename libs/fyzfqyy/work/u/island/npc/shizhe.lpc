inherit NPC;
#include <ansi.h>
int give_newbie();
int answer_me();

void create()
{
         set_name(HIY"风云特使"NOR, ({"fengyun teshi","teshi","fengyun"}));
   set ("long", @LONG
他是在风云再现里面负责给新手发礼物(gift)（newbie）的,如果要成为高手,
大家就赶快向他要（ask）,然后去开始你的风云历程吧 !
LONG);
           set("gender", "男性");
        set("title",HIW"濮阳精灵"NOR);
        set("age", 20);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([
            "newbie"    :(:give_newbie:),
            "gift"    :(:give_newbie:),
            "礼物"    :(:give_newbie:),
            "新手礼物"  :(:give_newbie:),
            "name"      :(:answer_me:),
]));
        setup();
        carry_object("obj/cloth")->wear();
}


int answer_me()
{
        command("say 我是蓝天安排放这儿欢迎大家的, 如果有什么需要帮助的，尽管说吧！\n");
        return 1;
}

int give_newbie()
{
        object who=this_player();
        if (!userp(who)){
                command("heng");
                command("say 你也能要礼物？！");
                command("qi");
                return 1;
        }

         if (who->query("combat_exp") > 40000 ){
                command("hammer "+who->query("id") );
                command("say 这么高了也要礼物呀？");
                return 1;
         }

         if (this_player()->query("island_gift") > 0 ){
         message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                command("say 你不是已经领了礼物了吗 ? ！想作弊? 小心我向蓝天告密！\n");
        return 1;
        }
         
        who->add("combat_exp",100000);

        who->add("potential",10000);

        who->set("island_gift",1);
message_vision("$N轻轻的拍了拍$n的头，$n只感觉前所未有的舒适，顿时浑身充满了能量。\n",this_object(),this_player());
        command("tell "+who->query("id")+" 
        你的潜能增加了一万。\n
        你的武学增加了十万。\n");
        command("chat "HIW"欢迎欢迎，"+who->query("name")+"来到了我们濮阳传奇, 得到了新人礼物, 以后请大家多多照顾！\n");
        return 1;
}

void greeting(object who) {
if( who->query("combat_exp") < 100000)
        tell_object(who,"风云特使悄悄告诉你：可以向我要礼物哦(ask)(l fengyun teshi)。\n");
}
 
