inherit NPC;
#include <ansi.h>
int give_buchang();
int give_skill();
int answer_me();

void create() {
  set_name(HIC "补偿使者  豆豆" NOR, ({ "doudou" }));
  set("nickname", HIG "风云再现欢迎您" NOR);
  set("long", "以此特别纪念退出泥潭好友----豆子,你可以尝试ask doudou about gift and 才子 \n");
  set("gender", "男性");
  set("age", 20);
  set("no_kill", 1);
  set("no_die", 1);
  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set("combat_exp", 750);
  set("attitude", "heroism");
  setup();
  set("inquiry", ([
    "gift": (: give_buchang :),
    "才子": (: give_skill :),
    "才智": (: give_skill :),
    "literate": (: give_skill :),
    "学习": (: give_skill :),
    "buchang": (: give_skill :),
    "补偿": (: give_skill :),
  ]));
  setup();
  carry_object("obj/cloth")->wear();
}


int answer_me() {
  command("say 我是蓝天安排放这儿欢迎大家的, 如果有什么需要帮助的，尽管说吧！\n");
  return 1;
}

int give_buchang() {
  object who = this_player();

  if (this_player()->query("doudou_gift") > 0) {
    message_vision("$N对着$n哼了一声。\n", this_object(), this_player());
    command("say 想作弊? 别以为我豆子是傻瓜！\n");
    return 1;
  }

  who->add("combat_exp", 1000);
  who->add("potential", 1000);
  who->add("max_mana", 50);
  who->add("max_force", 50);
  who->add("max_atman", 50);
  who->add("doudou_gift", 1);
  message_vision("$N轻轻的拍了拍$n的头，$n只感觉前所未有的舒适，顿时浑身充满了能量。\n", this_object(), this_player());
  command("tell " + who->query("id") + " 
        你得到了风云再现巫师组的补偿。\n");
  return 1;
}

int give_skill() {
  object who = this_player();

  if (this_player()->query("doudou_gift1") > 0) {
    message_vision("$N对着$n哼了一声。\n", this_object(), this_player());
    command("say 你也知道呀,蓝天是才子所以你再问也不会给你啦!\n");
    return 1;
  }
  if ((int)who->query_skill("literate") > 76) {
    command("hammer " + who->query("id"));
    command("say 这么聪明了,的确可以做才子了,加油呀!？");
    return 1;
  }

  who->set_skill("literate", 76);
  who->add("int", 2);
  who->add("doudou_gift1", 1);
  message_vision("$N轻轻的拍了拍$n的头，$n既然知道蓝天是才子,就给你点小意思吧!\n", this_object(), this_player());
  command("tell " + who->query("id") + " 
        你得到了风云再现巫师组的奖励。\n");
  return 1;
}
