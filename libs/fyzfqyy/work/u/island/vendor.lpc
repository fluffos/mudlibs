#include <dbase.h>
#include <ansi.h>
int buy_object(object me, string what)
{
        mapping goods;
        string list, *name;
        int i;

        if( !mapp(goods = query("vendor_goods")) ) return 0;
        name = keys(goods);
        for(i=0; i<sizeof(name); i++){
        if(what ==  name[i]->name() || what == (name[i]->query("id")))
                  return    (int)  (name[i]->query("value")) ;
      }
        return 0;

}

void compelete_trade(object me, string what)
{
	string ob_file;
	object ob;
	mapping goods;
	string list, *name, last = "";
	int i;
	if( !mapp(goods = query("vendor_goods")) ) return 0;
	name = keys(goods);
	for(i=0; i<sizeof(name); i++){
	if(what ==  name[i]->name() || what == (name[i]->query("id")))
	{
	        if( stringp(ob_file = name[i]) ) {
                ob = new(ob_file);
// 减去存货数量，当数量到达零时，从list中删除
                goods[name[i]]--;
                if(goods[name[i]] <= 0){
                map_delete(goods,name[i]);
		last = "最后";}
                if(ob->move(me)){
                printf("你向%s买下%s一%s%s。\n",this_object()->query("name"),
				last,
                                ob->query("unit"), ob->name());
		}
		else
			destruct(ob);
		return;
					}

	}
                                      }

}

string price_string(int v)
{
	if( v%10000 == 0 )
		return (v/10000) + "00元";
	if( v%100 == 0 )
		return (v/100) + "元";
	return v + "分";
}

int do_vendor_list(string arg)
{
	mapping goods;
	string list, *name;
	int i;

	if( !mapp(goods = query("vendor_goods")) ) return 0;
	if( arg && !this_object()->id(arg) ) return 0;
	name = keys(goods);
	if(!sizeof(name))
		return notify_fail("这儿的东西全卖光了。\n");
	list = "你可以购买下列这些东西：\n";
		list += sprintf(CYN"≡"YEL"─物品名称─物品ＩＤ───────物品价格────存货数量─────────"CYN"≡\n"NOR);
	for(i=0; i<sizeof(name); i++)
	list += sprintf("  %-12s %-20s ：%-10s  ：%d%s\n",
			name[i]->name(),name[i]->query("id"),
			price_string(name[i]->query("value")),goods[name[i]],name[i]->query("unit"));
		list += sprintf(CYN"≡"YEL"────────────────────────────%-10s─────"CYN"≡\n"NOR,
			environment(this_object())->query("short"));
	write(list);
	return 1;	
}
