//island
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "蓝天无我");
  set("exits", ([ /* sizeof() == 1 */
    "east": "/d/wiz/relax",
    "down": "/d/fy/fysquare",
    "north": "/d/wiz/wizard_room",
    "west": "/u/island/islandroom",
  ]));
  set("no_fight", 1);
  set("sleep_room", 1);
  set("valid_startroom", 1);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/book": 1,
  ]));
  set("no_magic", 1);
  set("item_desc", ([
    "west": "突然一声沉喝：“想偷看蓝天的隐私？”\n"
  ]));

  setup();
}
