#include <ansi.h>
void change_title(object, string);

inherit ROOM;

void create() {
  set("short", "开封府正堂");
  set("long", "
这里是开封府的大堂，堂下衙役分班站立，四周鸦鹊无声。堂口摆放
着皇上御赐的三口铜铡。包大人高坐在堂上，脸色阴沉，微有怒色，看来
正在下令捉拿人犯。大堂正中高悬一匾：\n" HIR + "
               明    镜    高    悬\n\n" NOR
  );
  set("valid_startroom", 1);
  set("no_steal", "1");
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("exits", ([
    "south": "/d/fy/futhur",
    // 23                  "south" : __DIR__"qianyafang",
  ]));
  set("coor/x", 50);
  set("coor/y", 20);
  set("coor/z", 0);

  set("objects", ([
    __DIR__ "npc/bao": 1,
    __DIR__ "npc/yayi": 4,
    //		__DIR__"npc/xunbu": 1,

  ]));
  setup();
  //     replace_program(ROOM);
}
void init() {
  add_action("do_work", "work");
  add_action("do_finish", "finish");
  /*
	if( interactive(ob = this_player())&&ob->query("being_caught"))
	{
		message_vision(HIY "$N一进开封府的正堂，...只听几声大喝，如同炸雷般在大堂里回响。\n"
		"$N不禁浑身发抖，再也站立不住，腿一软，扑通一声跪了下来。\n\n" NOR, ob);
		ob->set("startroom", "/d/kaifengfu/zhengtang");
		remove_call_out("processing");
		call_out("processing", 3, ob);
	}
*/
}
int do_work() {
  object ob;
  int type, kf_npc;
  string name, str, where;
  object me = this_player();

  if ((int)me->query("kf_worked") >= 3200)
    return notify_fail("包大人说道：神捕大人还没进京面圣啊？\n");

  if (!me->query("kaifengfu"))
    return notify_fail("两旁衙役大声喝道：大胆刁民，不得咆哮公堂！\n");
  if (me->query("kf_found"))
    return notify_fail("包大人脸色一沉道：“你已发现疑犯,为何不逮捕他？”\n");
  if (me->query("kf_caught"))
    return notify_fail("包大人道：“速速将疑犯缉拿归案，莫让他逃掉了。”\n");
  if (present("ling pai", me) || me->query("kf_working"))
    return notify_fail("包大人脸色一沉道：本府前日交与你的差事速去办理，不得捻轻怕重！\n");
  kf_npc = 1 + random(164);
  type = 1 + random(6);

  ob = new(__DIR__ "obj/lingpai");
  ob->move(me, 1);
  if (kf_npc < 84) where = "风云城中";
  else if (kf_npc < 107) where = "千金楼附近";
  else if (kf_npc < 125) where = "大昭寺附近";
  else if (kf_npc < 141) where = "岱庙附近";
  else if (kf_npc < 152) where = "帝王谷附近";
  else if (kf_npc < 165) where = "清平山庄附近";
  switch (type) {
    case 1:
      name = "蒙面大盗";
      str = "拦路抢劫,杀人如麻";
      break;
    case 2:
      name = "无影神偷";
      str = "四处盗窃财物";
      break;
    case 3:
      name = "恶人云中鹤";
      str = "经常劫掠民女，无恶不做";
      break;
    case 4:
      name = "西夏细作";
      str = "四处活动";
      break;
    case 5:
      name = "大辽奸细";
      str = "四处造谣破坏";
    case 6:
      name = "神秘人";
      str = "刺杀朝廷命官";
      break;
    default:
      return notify_fail("出错了，快向管理员汇报吧！\n");
  }
  me->set("kf_npc", kf_npc);
  me->set("kf_name", name);
  me->set("kf_where", where);
  me->set("kf_whatnpc", type);
  message_vision("包大人一拍惊堂木怒道：据查今有" + name + "在" + where + str +
    "，$N速去破案，不得有误。\n", me);
  me->set("kf_working", 1);
  return 1;
}
int do_finish() {
  object ob, me;
  int kf_exp, kf_qn;
  string kf_name, kf_where;

  me = this_player();
  if (!me->query("kaifengfu"))
    return notify_fail("两旁衙役大声喝道：大胆刁民，不得咆哮公堂！\n");
  if (!objectp(present("bao daren", environment(me))))
    return notify_fail("衙役笑道：包大人已经退堂了，要想交令明日请早了您。\n");
  if (!me->query("kf_working"))
    return notify_fail("包大人脸色一沉道：本府什么时候派过你差事啊？\n");
  if (!me->query_temp("kf_finish"))
    return notify_fail("包大人脸色一沉道：本府交你的差使至今还未办妥，你还有面目来见我？\n");
  if (!objectp(ob = present("ling pai", me)))
    return notify_fail("包大人脸色一沉道：本府交给你的令牌呢？\n");
  tell_object(me, "你恭恭敬敬的缴上令牌。\n" NOR);
  destruct(ob);
  kf_name = me->query("kf_name");
  kf_where = me->query("kf_where");
  message_vision("包大人微微一笑道：$N在" + kf_where +
    "破获" + kf_name + "一案，劳苦功高，赶快下去休息吧！\n", me);
  CHANNEL_D->do_channel(this_object(), "qst", sprintf("%s(%s)完成了开封府任务（%s）。",
    me->query("name"), me->query("id"), kf_name));
  kf_exp = 1000 + random(1000);
  kf_qn = random(500);
  me->add("combat_exp", kf_exp);
  me->add("potential", kf_qn);
  me->add("kf_worked", 1);
  me->delete_temp("kf_finish");
  me->delete("kf_working");
  me->delete("kf_found");
  me->delete("kf_caught");
  me->delete("kf_name");
  me->delete("kf_whatnpc");
  me->delete("kf_where");

  tell_object(me, "你获得了" + chinese_number(kf_exp) + "点经验。\n" NOR);
  tell_object(me, "你获得了" + chinese_number(kf_qn) + "点潜能。\n" NOR);

  switch ((int)me->query("kf_worked")) {
    case 3200:
      change_title(me, "【神捕】");
      me->add("score", 200);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      message_vision(
        WHT "包大人微笑着说道：" + me->query("name") + "连破大案，天下闻名，本府已经奏明圣上。\n昨日朝旨已下，命你进京面圣。你可立即动身，速去速回" NOR,
        me
      );
      break;
    case 2500:
      change_title(me, "【御前一等侍卫】");
      me->add("score", 150);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 2000:
      change_title(me, "【御前二等侍卫】");
      me->add("score", 100);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 1500:
      change_title(me, "【御前三等侍卫】");
      me->add("score", 80);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 1000:
      change_title(me, "【开封府总捕头】");
      me->add("score", 40);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 500:
      change_title(me, "【开封府副总捕头】");
      me->add("score", 20);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 250:
      change_title(me, "【开封府捕头】");
      me->add("score", 10);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
    case 100:
      change_title(me, "【开封府捕快】");
      me->add("score", 5);
      message_vision(HIC "$N的评价提高了！\n" NOR, me);
      break;
  }
  me->save();
  return 1;
}
int valid_leave(object who, string dir) {
  if (who->query_condition("kf_stop") || who->query("being_caught")) {
    message_vision("$N爬起来就想往外跑。\n", who);
    return notify_fail(WHT "衙役死死把你按在地上喝道：老实点！\n" NOR);
    return 1;
  }
  return ::valid_leave(who, dir);
}
void change_title(object me, string title) {
  string str = me->qurey("title");
  replace_string(str, "【御前一等侍卫】", "");
  replace_string(str, "【御前二等侍卫】", "");
  replace_string(str, "【御前三等侍卫】", "");
  replace_string(str, "【开封府总捕头】", "");
  replace_string(str, "【开封府副总捕头】", "");
  replace_string(str, "【开封府捕头】", "");
  replace_string(str, "【开封府捕快】", "");
  me->set("title", str + HIY + title + NOR);
}

