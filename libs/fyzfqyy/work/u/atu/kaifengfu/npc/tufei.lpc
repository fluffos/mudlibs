// add by atu for SJFY 2000/01/10
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("蒙面大盗", ({ "mengmian dadao","md"}) );
	set("title","杀人如麻");
	set("long","他就是凶狠的蒙面大盗，作案从来不留活口。\n");
	set("gender", "男性" );
	set("age", 34);
	set("attitude", "friendly");
   
	set_skill("unarmed",200);
	set_skill("force",200);

	set_skill("wuzheng-force",200);
	set_skill("bat-blade", 300);
	set_skill("blade", 100);
	set_skill("meng-steps", 200);
	set_skill("dodge", 100);
               
       map_skill("force", "wuzheng-force");
       map_skill("dodge", "meng-steps");
       map_skill("blade", "bat-blade");
       map_skill("parry", "bat-blade");
       set("chat_chance_combat", 10);
       set("chat_msg_combat", ({
                (: perform_action, "blade.shiwanshenmo" :),
                (: perform_action, "dodge.huanyingqianchong" :),
	}) );
	setup();
       carry_object("/obj/weapon/blade")->wield();
}
void init()
{       
	if( !query("destroy") ){
		set("destroy",1);
		remove_call_out ("destroy_npc");
		call_out ("destroy_npc", 600); // 10 min
	}
}
void destroy_npc()
{
        message_vision("$N忽然打了个哆嗦，不由心生惧意，身形一晃，顿时混入莽莽人海之中。\n",this_object());
        destruct(this_object());
}
void die()
{
	object me,who;
	me = this_object();
	message_vision("$N倒在地上，死了！\n",me);
	who = me->query_temp("was_caught_by");
	if ( objectp(who) && me->query_temp("last_damage_from") == who){
		who->set_temp("kf_finish",1);
	}
	destruct(this_object());
}

