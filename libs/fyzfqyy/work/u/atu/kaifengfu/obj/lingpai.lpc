// atu rewritten at (2001/10/10) 
#ifndef NPC_D
#define NPC_D "/adm/daemons/npcd"
#endif
#include <ansi.h>
inherit ITEM;

void create() {
  set_name("令牌", ({ "ling pai", "ling" }));
  set("unit", "块");
  set("long", "这是一块朱红的令牌,精钢打造，用来证明官府人士的身份。\n带着它你就有权搜寻罪犯(guancha)，逮捕嫌疑犯(daibu)。\n");
  set("value", 0);
  set("no_drop", "这样东西不能离开你。\n");
  set("no_burn", 1);
  set("no_get", "这是开封府的东西，平常人拿了会惹麻烦的。\n");
  set_weight(200);
  setup();
}
void init() {
  add_action("do_watch", "guancha");
  add_action("do_watch", "watch");
  add_action("do_catch", "daibu");
  add_action("do_catch", "catch");
}
int do_watch(string arg) {
  object ob, me;
  string targ;

  if (!arg || arg == "")
    return notify_fail("你要观察谁？\n");
  me = this_player();
  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("有这个人吗？\n");
  if (!ob->is_character() || ob->is_corpse())
    return notify_fail("你只能观察一个活的物体。\n");

  if (me->is_busy())
    return notify_fail("你正忙着。\n");
  if (!me->query("kaifengfu"))
    return notify_fail("你并非朝廷官员，何必操这份闲心？\n");
  if (me->query_temp("kf_finish"))
    return notify_fail("包大人等着回话哪，你还在磨蹭什么？\n");
  targ = ob->name();
  tell_object(me, "你用锐利的眼神盯着" + targ + "。\n\n");
  //	me->start_busy(1);
  // 我的运气与对方的定力
  if (random(me->query_kar()) + random(me->query("kar")) < ob->query_cps())
    return notify_fail("对方面无表情，你实在是无法判断。\n");
  if (ob->query_temp("kf_tufei") != me->query("kf_npc")) {
    switch (random(11)) {
      case 1:
        tell_object(me, "只见" + targ + "饿得面黄肌瘦，骨瘦如柴。\n\n");
        break;
      case 2:
        tell_object(me, "只见" + targ + "面颊微红，一脸娇羞的模样。\n\n");
        break;
      case 3:
        tell_object(me, "只见" + targ + "满脸横肉，嘴脸凶顽。\n\n");
        break;
      case 4:
        tell_object(me, "只见" + targ + "悲痛欲绝，哭的象个泪人似的。\n\n");
        break;
      case 5:
        tell_object(me, "只见" + targ + "手足僵硬，浑身散发着金属光泽。\n\n");
        break;
      case 6:
        tell_object(me, "只见" + targ + "面无表情，呆若木鸡。\n\n");
        break;
      case 7:
        tell_object(me, "只见" + targ + "长得尖嘴猴腮，目光狡诈。\n\n");
        break;
      case 8:
        tell_object(me, "只见" + targ + "干笑几声，脸上挤出一丝媚笑。\n\n");
        break;
      case 9:
        tell_object(me, "只见" + targ + "挺胸叠肚，一脸傲慢的神色。\n\n");
        break;
      case 10:
        tell_object(me, "只见" + targ + "长得明眸皓齿，一脸天真的神色。\n\n");
        break;
      default:
        tell_object(me, "只见" + targ + "正挤眉弄眼，色迷迷的东张西望。\n\n");
    }
    return 1;
  }
  switch (random(5)) {
    case 1:
      tell_object(me, WHT "你发现" + targ + "忽然打了个哆嗦，面如土色。\n\n" NOR);
      break;
    case 2:
      tell_object(me, WHT "你发现" + targ + "太阳穴高高坟起，似乎是个练武的人。\n\n" NOR);
      break;
    case 3:
      tell_object(me, WHT "你发现" + targ + "腰间鼓鼓囊囊的，样子象是一件兵刃。\n\n" NOR);
      break;
    case 4:
      tell_object(me, WHT "你发现" + targ + "的眼中精光一闪，马上又变的一脸茫然。\n\n" NOR);
      break;
    default:
      tell_object(me, WHT "你发现" + targ + "忽然把头一低，似乎想避开你的目光。\n\n" NOR);
  }
  me->set("kf_found", 1);
  ob->set_temp("was_found_by", me);
  return 1;
}
int do_catch(string arg) {
  object ob, new_obj;
  object me;

  if (!arg || arg == "")
    return notify_fail("你要逮捕谁？\n");
  me = this_player();
  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("有这个人吗？\n");
  if (!ob->is_character() || ob->is_corpse())
    return notify_fail("你只能逮捕一个活人。\n");
  if (!me->query("kaifengfu"))
    return notify_fail("你并非朝廷官员，何必操这份闲心？\n");
  if (me->query_temp("kf_finish"))
    return notify_fail("包大人等着回话哪，你还在磨蹭什么？\n");
  if (me->query("kf_caught"))
    return notify_fail("你还在磨蹭什么？赶紧杀死(kill)" + me->query("kf_name") + "呀。\n");
  if (ob->query_temp("was_found_by") != me || !me->query("kf_found"))
    return notify_fail("开封府纪律严明，没有证据怎好拿人？\n");
  message_vision("$N对着$n冷笑一声道：阁下的案子发了，老老实实跟本官走一趟。\n\n", me, ob);
  new_obj = new("/d/kaifengfu/npc/tufei" + me->query("kf_whatnpc"));
  if (!objectp(new_obj))
    return notify_fail("出错了，快向巫师汇报吧！\n");
  message_vision(RED "$n大叫一声揭开伪装，露出本来面目。\n" NOR, me, ob);
  me->set("kf_caught", 1);
  me->delete("kf_found");
  NPC_D->make_same(new_obj, me);
  new_obj->move(environment(me), 1);
  message_vision(RED "$n大喝道：老子和你拼了！\n" NOR, me, new_obj);
  new_obj->kill_ob(me);
  me->kill_ob(new_obj);
  new_obj->set_leader(me);
  new_obj->set_temp("was_caught_by", me);
  return 1;
}
