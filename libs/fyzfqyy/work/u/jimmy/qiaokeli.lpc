#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
              set_name(HIM"德福巧克力"NOR, ({"qiaokeli", "li"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                  set("unit", "颗");
                    set("long", "这是一颗改变Title的巧克力。\n");
                set("value", 10000);
        }
        setup();
}

int do_eat(string arg)

{
        if (!id(arg))
        return notify_fail("你要吃什么？\n");

                          this_player()->set("title",HIC"圣 斗 士"NOR);

              message_vision(HIY"$N吃下一颗德福巧克力，顿时笑的象朵花式的 !\n"NOR, 
  this_player());
        destruct(this_object());
        return 1;
}















