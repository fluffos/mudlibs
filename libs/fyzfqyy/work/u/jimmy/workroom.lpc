//workroom.c csy

inherit ROOM;


#include <ansi.h>

void create() {
  set("short", HIR "侠刀的办公室" NOR);
  set("long",
    "" HIW "这是一间简单而舒适的小屋，从南面的花窗望去，可以看见四周围着矮矮的\n"
    "竹篱上爬满了" HIM "蔷薇" NOR "" HIW "。敞开的竹门边站着一只" BLINK HIY "金毛鼠" NOR "" HIW "，侠刀的朋友来时，它会对着\n"
    "客人摇尾巴。你一回头，只见床头挂着一幅美丽的画，画中有一长发女子临风含\n"
    "笑，现出一只浅浅的酒窝。要不是那装束似来自另一世界，你真以为这是一个真人\n"
    "的画像。画两边悬着用瘦金体写的对联(duilian)，" HIW "字里行间似有愁绪萦绕。" NOR "\n"
  );

  set("valid_startroom", 1);
  set("no_steal", "1");
  set("no_fight", 1);
  set("exits", ([
    "east": "/d/city/kedian",
    "down": "/d/wizard/wizard_room",
  ]));

  set("item_desc", ([
    "duilian": "           " HBBLU + HIM "前 世 如 风 不 可 追 今 生 似 梦 持 酒 醉\n" NOR "",
  ]));
  set("objects", ([
    __DIR__ "laoshu": 1,
    __DIR__ "gui": 1,
  ]));

  setup();
}
