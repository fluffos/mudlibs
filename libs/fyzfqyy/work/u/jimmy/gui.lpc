//by csy
#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_kai", "kai");
}

void create() {
  set_name(HIY "大衣柜" NOR, ({ "dayi gui", "gui" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是复活的衣柜,里面有她换洗的衣服。\n");
    set("value", 10000);
  }
  setup();
}

int do_kai(string arg) {
  if (!id(arg))
    return notify_fail("你要开什么？\n");

  this_player()->set("title", HIW "快乐的.." NOR);

  message_vision(HIW "$N打开衣柜,迅速地换了一件新衣服 !\n" NOR, this_player());
  destruct(this_object());
  return 1;
}
