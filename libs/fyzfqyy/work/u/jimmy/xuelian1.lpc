// dumpling.c 包子

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("雪莲", ({"xue lian"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一朵生长在雪山上的雪莲，它洁白的花瓣上附着几颗晶

莹的露珠，正散发着淡淡的幽香\n");
		set("unit", "颗");
                  set("value", 100);
		set("food_remaining", 3);
		set("food_supply", 20);
	}
}
