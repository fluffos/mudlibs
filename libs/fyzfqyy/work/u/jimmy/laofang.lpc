// huiguoroom.c
// 忏悔室

inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "忏悔室");
        set("long", @LONG
这里是意图不轨者的牢房，看来你是出不去了。好好反思下你干的事，
你一定是严重违反了玩家条例多次，没人会帮助你了。国有国法，家有家规，
本MUD也有条例，再读读 help rules 吧，如果WIZS不能原谅你，那你就只好
选择自杀 suicide -f 了。请记住这是玩家们共有的世界。

LONG
);
        set("sleep_room", 1);
        set("no_fight", 1);
        set("no_steal", 1);
        set("no_beg", 1);
    set("apply/char_short", "<悔过中>");
        set("valid_startroom", 1);

        setup();
//        "/clone/board/huiguo_b.lpc"->foo();
}

void init()
{ 
        object me = this_player();
        add_action("do_action", "");                             
        add_action("do_fly", "fly");
}


int do_action(string arg)
{
       string action = query_verb();

       switch (action) {
               case "dazuo":
               case "chat":
               case "chat*":
               case "ldj":
               case "ldj*":
               case "es":
               case "es*":
               case "music":
               case "music*":
               case "rumor":
               case "rumor*":
               case "to":
               case "du":
               case "read":
               case "ask":
               case "tell":
               case "reply":
               case "exercise": 
               case "lian":
               case "tuna":       
               case "quit":
               case "dazuo" : 
               case "practice":
  write(HIW"这里是专为不轨玩家反思之用的悔过室\n"NOR);
  write(HBRED"四周燃起熊熊烈火,这三昧真火已经烧去了你的所有武功和法力! \n"NOR);
  write(HBRED"你在烈火中煎熬，现在你什么都干不了了! \n"NOR);
  write(HBRED"忏悔吧! \n"NOR);
                       return 1;
       }
       return 0;
}
int do_fly(string arg)
{
        object me = this_player();
        if(!living(me) ) return 0;
      if(!arg || arg == "" || arg != "home" ) {
        write("你要去什么地方?\n", me);
      return 1;
}
        if( arg == "home") {
        message_vision(HIW"$N口念真言,转瞬就消失在烈火之中。\n"NOR, me);
        me->move("/u/csy/workroom");
        return 1; }
}


