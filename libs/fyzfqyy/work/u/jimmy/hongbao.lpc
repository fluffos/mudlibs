#include <ansi.h>
inherit ITEM;
void setup() {}
void create() {
  set_name(HIR "红包" NOR, ({ "hongbao" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIR "\n一个小小的红包，上面绣着：恭喜发财！ 复活\n" NOR);
    set("value", 100);
  }
  setup();
}
void init() {
  add_action("do_open", "open");
}
int do_open(string arg) {
  object gold; if (!id(arg))
    return notify_fail("你要打开什么？\n");
  if (query("opened"))
    return notify_fail("你打开小红包，但里面是空的！\n");
  gold = new("/clone/money/gold");
  gold->set_amount(5);
  gold->set("name", HIY "纯金叶子" NOR);
  gold->set("base_unit", "张");
  gold->move(this_player());
  set("opened", 1);
  return notify_fail(HIY "你打开小红包，从里面拿出几张纯金叶子！\n" NOR);
}
