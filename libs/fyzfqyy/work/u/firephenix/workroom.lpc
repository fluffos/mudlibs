inherit ROOM;
void create() {
  set("short", "凤舞九天");
  set("long", @LONG 
这是天神凤舞的居所问世间情是何物直教生死相许天南地北双飞客
看天空一只五彩凤凰正要徐徐落在沉埃天空百鸟聚集祥云缭绕
真乃人间仙境可惜这么好的地方教凤舞占有了
有一副对联赫然如目上联写小李飞刀成绝想
下联配人世不见楚留香
慨叹 世界上最远的距离不是天涯海角
而是你就在我身边却不知道我爱你
LONG
  );
  set("exits", ([
    "north": "/d/fy/fysquare",
    "south": "/u/lost/workroom",
    "west": "/d/death/gate",
    "east": "/u/island/workroom",
  ]));
  set("valid_startroom", 1);
  set("outdoors", "laowu");
  set("coor/x", 10);
  set("coor/y", -420);
  set("coor/z", 10);
  setup();
}
