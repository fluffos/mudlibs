// sku@00-11-28

#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  object ob;
  mapping my;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有管理员能察看别人的状态。\n");

  my = ob->query_entire_dbase();

  printf(
    HIC "≡" HIY "──" CYN "☆" RED "您的状态" CYN "☆" HIY "────── " RED "您的等级:" NOR YEL "〖" BMAG "%2d" NOR YEL "〗" HIY "────────" HIC "≡\n" NOR,
    my["level"]
  );



  printf(
    HIC " 【 姓 名 】" NOR BLINK "%-19s " NOR HIC " 【 性 别 】" NOR WHT "%-10s \n" NOR,
    ob->name(),
    ob->query("gender"),
    "[" + capitalize(ob->query("id")) + "]"
  );


  printf(HIC " 【 精 力 】 %s%4d/ %4d %s(%3d%%)" HIC "   【 灵 力 】 %s%4d/ %4d (+%4d)\n" NOR,
    status_color(my["gin"], my["eff_gin"]), my["gin"], my["eff_gin"],
    status_color(my["eff_gin"], my["max_gin"]), my["eff_gin"] * 100 / my["max_gin"],
    status_color(my["atman"], my["max_atman"]), my["atman"], my["max_atman"],
    my["atman_factor"]
  );
  printf(HIC " 【 气 血 】 %s%4d/ %4d %s(%3d%%)" HIC "   【 内 力 】 %s%4d/ %4d (+%4d)\n" NOR,
    status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
    status_color(my["eff_kee"], my["max_kee"]), my["eff_kee"] * 100 / my["max_kee"],
    status_color(my["force"], my["max_force"]), my["force"], my["max_force"],
    my["force_factor"]
  );
  printf(HIC " 【 心 神 】 %s%4d/ %4d %s(%3d%%)" HIC "   【 法 力 】 %s%4d/ %4d (+%4d)\n" NOR,
    status_color(my["sen"], my["eff_sen"]), my["sen"], my["eff_sen"],
    status_color(my["eff_sen"], my["max_sen"]), my["eff_sen"] * 100 / my["max_sen"],
    status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],
    my["mana_factor"]
  );
  printf(HIC "≡" HIY "──────────────────────────────" HIC "≡\n" NOR);
  printf(HIW " 【 食 物 】 %s%4d/ %4d     " HIG "     【 潜 能 】  %9d\n" NOR,
    status_color(my["food"], ob->max_food_capacity()),
    my["food"], ob->max_food_capacity(),
    (my["potential"] - my["learned_points"])
  );
  printf(HIW " 【 饮 水 】 %s%4d/ %4d     " HIY "     【 评 价 】  %9d\n" NOR,
    status_color(my["water"], ob->max_water_capacity()),
    my["water"], ob->max_water_capacity(), my["score"]
  );
  printf(HIR " 【 杀 气 】   %8d     " MAG "     【 实 战 】  %9d\n" NOR,
    my["bellicosity"], my["combat_exp"]
  );
  printf(
    HIC "≡" HIY "────────────────────" HIC "★" HIW "风云再现" HIC "★" HIY "────" HIC "≡\n" NOR,
    my["level"]
  );
  return 1;
}

string status_color(int current, int max) {
  int percent;

  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int help(object me) {
  write(@HELP
指令格式 : hp
 
这个指令可以显示你(玩家)的一些基本状态：

≡──────────────────────────────≡
 【 精 力 】  300/  300 (100%)   【 灵 力 】   75/   75 (   0)
 【 气 血 】  465/  675 (100%)   【 内 力 】  439/  310 (  20)
 【 心 神 】  320/  320 (100%)   【 法 力 】  120/  120 (   0)
 【 食 物 】  200/  200          【 潜 能 】        299
 【 饮 水 】  200/  200          【 评 价 】       8900
 【 杀 气 】       5000          【 实 战 】        800
≡──────────────────────────────≡

see also : score
HELP
  );
  return 1;
}
// [输入时暂存讯息]
