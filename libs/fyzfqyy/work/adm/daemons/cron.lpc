#pragma optimize
#pragma save_binary

#define REBOOT_TIME 7
#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>

inherit F_DBASE;

nosave int LAST_HARD_DIS;
nosave int flag = 0;
nosave int line = 0;
// nosave int shutdown = 0;

void autosave();
void check_dns();
void check_nature();
void check_callouts();

int set_last_hard_dis();

void create() {
  seteuid(ROOT_UID);
  set("channel_id", HIG "任务精灵");
  write(HIR "\n任务精灵已经启动。\n" NOR);
  set_heart_beat(60);
  set_last_hard_dis();
}
int clean_up() { return 1; }
int query_last_hard_dis() { return LAST_HARD_DIS; }
int set_last_hard_dis() {
  LAST_HARD_DIS = time();
  return flag;
}

private void heart_beat() {
  mixed *local;
  object npc;

  local = localtime(time());

  if (!(local[1] % 7)) {
    autosave();
    check_callouts();
  }
  if (local[1] == 20 || local[1] == 40) {
    message("system", HIR "\n\n重新分布部分使命．．．．", users());
    TASK_D->init_dynamic_quest();
    message("system", HIG " ．．．部分使命分布完毕\n\n" NOR, users());
  }
  if (flag == 1) {
    message("system", HIR "\n\n重新分布所有使命．．．．" NOR, users());
    TASK_D->init_dynamic_quest(1);
    flag = 0;
    set_last_hard_dis();
    message("system", HIG " ．．．使命分布完毕\n\n" NOR, users());
  }
  if (local[1] == 59 || ((int)time() - (int)query_last_hard_dis()) > 3720) {
    flag = 1;
    message_system(HIR "所有使命将在一分钟后重新分布！！！   \n\n" NOR);
    TASK_D->init_y2k_quest();
    if (local[2] == REBOOT_TIME) {
      if (local[6] != 6) {
        TASK_D->init_treasure();
        CHANNEL_D->do_channel(this_object(), "wiz", BBLK + HIR "世纪宝藏" NOR + HIY "从新分布！\n\n");
      } else {
        npc = new("/obj/npc/demogorgon");
        npc->move("/d/fy/church");
        npc->start_shutdown();
        npc->set("cmd_giver", "系统自动");
      }
    }
  }
  if (local[1] == 45 || local[1] == 15) {
    message_system(HIR "十大恶人重现江湖了！\n\n" NOR);
    TASK_D->init_crimer_quest();
  }
}
void autosave() {
  object *users = users();
  message("system", HIR "\n 自动存档．．．", users());
  foreach (object user in users)
    user->save();
  message("system", HIG "．．．存档完毕 \n" NOR, users());
}
void check_dns() {
  mapping mud_list;
  mixed *muds;
  object dns;

  if (!dns = find_object(DNS_MASTER))
    // dns not started, not our problem
    return;
  mud_list = (mapping)DNS_MASTER->query_muds();
  muds = keys(mud_list);
  if (sizeof(muds) <= 1) {
    destruct(dns);
    call_other(DNS_MASTER, "???");
  }
  return;
}
void check_nature() {
  mixed *infos;
  object ob;
  int nature = 0;

  infos = call_out_info();
  foreach (mixed info in infos) {
    if ("/" + sprintf("%O", info[0]) == NATURE_D)
      nature = 1;
  }
  if (!nature) {
    if (ob = find_object(NATURE_D)) destruct(ob);
    call_other(NATURE_D, "???");
  }
  return;
}
void check_callouts() {
  mixed *info;
  int i, f = 0;
  string output;
  object *users, link_ob;

  info = call_out_info();
  for (i = 0; i < sizeof(info); i++) {
    if (info[i][2] < info[f][2]) {
      f = i;
    }
  }
  if (info[f][2] > -100) return;
  users = users();
  if (flag != 2) {
    flag = 2;
    message_system(HIR "\n\n\n\n\n游戏出现故障，系统将在7分钟后重新启动。\n
游戏重启之前，不再另行通知。\n" NOR);
    output = sprintf("%-30O %-20s %d ", info[f][0], info[f][1], info[f][2]);
    log_file("CALLOUTS_ERR", output + ctime(time()) + "\n");
    return;
  }
  message("system", HIY "正在保存玩家数据中．．．  " NOR, users);
  foreach (object user in users) {
    if (!environment(user)) continue;
    user->save();
    link_ob = user->query_temp("link_ob");
    if (objectp(link_ob)) link_ob->save();
  }
  // 保存所有的守护进程的数据
  reset_eval_cost();
  if (find_object(DNS_MASTER)) DNS_MASTER->send_shutdown();
  if (find_object(FAMILY_D)) FAMILY_D->mud_shutdown();
  if (find_object(CLOSE_D)) CLOSE_D->mud_shutdown();
  if (find_object(DBASE_D)) DBASE_D->mud_shutdown();
  log_file("nosave/CRASHES", sprintf("系统因为故障重新启动于%s\n", log_time()));
  message("system", HIY "  ．．．保存完毕\n" HIR "重新启动MudOS，请稍候一分钟再登录。\n\n" NOR, users);
  shutdown(0);
}

