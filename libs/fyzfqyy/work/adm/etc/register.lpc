// regiser.c
//island@fyzx

inherit ROOM;

void create()
{
	set("short", "世外桃源");
	set("long", @LONG
    汝缘溪行，忘路之远近。忽逢桃花林，夹岸数百步，中无杂树，芳草
鲜美，落英缤纷，汝甚异之；复前行，欲穷其林。林尽水源，便得一山，
山有良田美池桑竹之属，阡陌交通，鸡犬相闻。男女衣著，悉如外人；黄
发垂髫，并怡然自乐。
        旁边有一个牌子(paizi)，你也许应该仔细看看。
LONG );
	set("no_fight", 1);
	set("item_desc", ([
		"paizi" : "请务必先注册：register your-email，用(decide)确定后才能进入风云中游戏。\n",
		"out"   : "一个陌生的世界，它也许就是你将来要驰骋一生的地方。\n",

	]));
	set("objects", ([
		"/adm/npc/sister" : 1,
	]));
	set("exits", ([
                "out" : "/d/fy/fysquare",
	]));

	setup();
}

int valid_leave(object me, string dir)
{
        object ob;
        if (! objectp(ob = present("sister wizer", this_object())))
        {
                ob = new("/adm/npc/sister");
                ob->move(this_object());
        }

        if (! me->query("registered"))
        {
                message_vision("神仙姐姐轻声对$N说：您还没有注册呢，请先注册(register)再"
                               "离去好吗？\n", me);
		if (me->query_temp("email"))
			return notify_fail("如果你确认输入的地址，就决定(decide)吧！\n");
                return notify_fail("你还不快注册？\n");
        }

        return 1;
}

