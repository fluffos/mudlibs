// Room: /data/group/groom/xiongjj.c
#include <room.h>
inherit ROOM;

void create() {
  set("short", "[1;31m依月楼[1;32m 总坛[0;37;0m");
  set("long", @LONG
  这里是依月楼的总坛。上面供奉的是前任历代帮主的灵牌，
两位总坛护法伺立在下首。非本帮弟子不能随便进入，否则可能会
惹来杀身之祸。
LONG);

  set("skill_lvl", 410);
  set("combat_exp", 7200000);
  set("objects", ([ /* sizeof() == 2 */
    "/data/group/npc/hufa.lpc": 2,
    "/data/group/obj/ling-pai.lpc": 1,
  ]));
  set("hard", 7200);
  set("g_name", "依月楼");
  set("exits", ([ /* sizeof() == 1 */
    "out": "/data/group/zongtan",
    "bar": "/u/hunthu/bar",
  ]));

  setup();
  replace_program(ROOM);
}
void init() {
  add_action("gobar", "gobar");
}
int do_gobar() {
  object me;
  me = this_player();
  message("vision",
    me->name() +
    "大叫一声，我爱摔胖，天天快乐。\n",
    environment(me), ({ me }));
  me->move("/u/hunthu/bar");
  message("vision",
    me->name() + "象一阵风跑了进来。\n",
    environment(me), ({ me }));
  return 1;
}
