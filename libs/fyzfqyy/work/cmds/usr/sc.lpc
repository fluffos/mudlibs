// score.c
// island for fyzx

#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
	object ob;
	mapping my;
	string line, str, skill_type, parry_type;
	object weapon;
	int attack_points, dodge_points, parry_points;
	seteuid(getuid(me));
	if(!arg)   ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
		return notify_fail("你只可以察看自己的状态。\n");

	my = ob->query_entire_dbase();
        line = sprintf( HIW"\n 【风云再现】"HIC"——"HIY"您的个人资料档案：\n"NOR );
        line += sprintf(HIC"─────────────────────────────────────────────\n"NOR);
        line += sprintf( " %s %s\n", RANK_D->query_rank(ob), ob->short(1) );
	line += sprintf(" 你是一%s%s年出生的%s岁的%s%s%s。",
		ob->query("unit"),
        CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60),
		chinese_number(ob->query("age")), 
    		ob->query("gender"),
		ob->query("national"),
                ob->query("race"));
line += sprintf("    现有参数点：[ %d ]\n" , ob->query("gift_points") - 
						       ob->query("used_gift_points"));
        line += sprintf( " 你的个人属性：\n" );
		line += sprintf(
			"\n 才智：[%s]  体质：[%s]  灵性：[%s]  魅力：[%s]\n"
                          " 勇气：[%s]  力量：[%s]  耐力：[%s]  韧性：[%s]\n"
                          " 速度：[%s]  气量：[%s]  运气：[%s]  定力：[%s]\n\n",
                       
                        display_attr(my["int"], ob->query_int()),
			display_attr(my["con"], ob->query_con()),
			display_attr(my["spi"], ob->query_spi()),
			display_attr(my["per"], ob->query_per()),
			display_attr(my["cor"], ob->query_cor()),
			display_attr(my["str"], ob->query_str()),
			display_attr(my["dur"], ob->query_dur()),
			display_attr(my["fle"], ob->query_fle()),
                        display_attr(my["agi"], ob->query_agi()),
                        display_attr(my["tol"], ob->query_tol()),
                        display_attr(my["kar"], ob->query_kar()),
                        display_attr(my["cps"], ob->query_cps()));
        line += sprintf(" 目前为止你共　杀人：%s，杀害玩家：%s，死亡%s，上次遇害于：%s。\n",
                chinese_number(my["MKS"] + my["PKS"]), chinese_number(my["PKS"]),chinese_number(my["KILLED"]),(my["last_kill_by"]));
	

        line += sprintf(" 清除叛师记录：%s次，",
                chinese_number(my["QINGPAN"]));
        if( mapp(my["family"]) ) {
                if( my["family"]["master_name"] )
                        line = sprintf("%s 师父是%s。\n",
                                line, my["family"]["master_name"] );
        }
        line += sprintf(" 你共有自造物品： " HIR "%d\t\t" NOR, ob->query("created_item") );
        line += sprintf("自造房间： " HIR "%d\n" NOR, ob->query("created_room") );
	if( objectp(weapon = ob->query_temp("weapon")) )
	{
		skill_type = weapon->query("skill_type");
		parry_type = "parry";
	}	
	else
	{
		skill_type = "unarmed";
		parry_type = "unarmed";
	}

attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
parry_points = COMBAT_D->skill_power(ob, parry_type, SKILL_USAGE_DEFENSE);
dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

          line += sprintf(HIR"\n 攻击力： %d" HIG "\t防御力： %d\t" NOR,
                attack_points + 1,(dodge_points/2 + (weapon? parry_points: (parry_points/2))) + 1);
        line +=sprintf(HIR" 杀伤力： %d" HIG "\t保护力： %d\n\n" NOR,
                ob->query_temp("apply/damage"),ob->query_temp("apply/armor"));

        line += sprintf(" 你到在风云再现总共完成了%s个普通使命，",
                chinese_number(my["TASK"]));
        line += sprintf(" %s个特殊使命。\n",
                chinese_number(my["TTASK"]));
        line += sprintf(" 你完成了%s个普通任务,",
                chinese_number(my["QQUEST"]));
        line += sprintf(" %s次种花任务,",
                chinese_number(my["FQUEST"]));
        line += sprintf(" 以及%s次挖药任务,",
                chinese_number(my["YQUEST"])); 
        line += sprintf(" 和%s次送信任务。\n",
                chinese_number(my["LQUEST"]));
        line += sprintf(" 你总共协助朝廷辑拿过%s次恶人，",
                chinese_number(my["TTQUEST"]));
        line += sprintf(" 并受到过%s次朝廷的特令嘉奖。\n",
                chinese_number(my["TQUEST"]));
        line += sprintf(HIC"─────────────────────────────────────────────\n\n"NOR);
	write(line);
	return 1;
}

string display_attr(int gift, int value)
{
	if( value > gift ) return sprintf( HIY "%3d /%3d" NOR, value,gift );
	else if( value < gift ) return sprintf( HIR "%3d /%3d" NOR, value,gift );
	else return sprintf("%3d /%3d", value,gift);
}

string status_color(int current, int max)
{
	int percent;

	if( max ) percent = current * 100 / max;
	else percent = 100;

	if( percent > 100 ) return HIC;
	if( percent >= 90 ) return HIG;
	if( percent >= 60 ) return HIY;
	if( percent >= 30 ) return YEL;
	if( percent >= 10 ) return HIR;
	return RED;
}

int help(object me)
{
	write(@HELP
指令格式 : score
           

这个指令可以显示你的基本资料：

 圆月山庄神刀统领 阿翔(Ken)

 你是一位汉族十四岁的男性人类，癸巳年九月二十八日丑时一刻出生。
 你总共杀了一千三百三十个人，六个玩家，被杀了零次。
 你到目前为止总共完成了一百一十五个普通使命， 十四个特殊使命。
 你曾经完成过三个普通任务, 二百九十八次种花任务,
 以及一百一十二次挖药任务, 还有六十七次送信任务。
 你总共协助朝廷辑拿过七十三次恶人， 并受到过七十次朝廷的特令嘉奖。
 你目前已经清除过一次判师记录。 你现在的师父是丁鹏。

 才智int： 12 / 12              体质con： 10 / 10
 灵性spi： 10 / 10              魅力per： 20 / 20
 勇气cor：  5 /  5              力量str： 10 / 10
 耐力dur： 10 / 10              韧性fle： 10 / 10
 速度agi： 10 / 10              气量tol：  5 /  5
 运气kar： 10 / 10              定力cps： 10 / 10

 自造物品： 1           自造房间： 1

 攻击力： 939174                防御力： 703880
 杀伤力： 70             保护力： 0

 现 有 参 数 点： 5

see also : hp
HELP
    );
    return 1;
}
