// full cmds
// Modified by island@fyzx

#include <ansi.h>

inherit F_CLEAN_UP;

string *gifts = ({ "gin", "kee", "sen" });
string *gifts1 = ({ "atman", "force", "mana" });

int main(object me, string arg) {
  int i;
  object ob;
  mapping my;

  if (!SECURITY_D->valid_grant(me, "(immortal)"))
    return 0;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
  }

  if (!ob) return notify_fail("你要恢复谁的状态？\n");

  if (ob != me) {
    if (wiz_level(me) < wiz_level("(wizard)"))
      return notify_fail("你没有权限恢复" + ob->name() + "。\n");

    if (me && !is_admin(me))
      message_system(sprintf("%s(%s)为%s(%s)恢复了状态。\n",
        me->name(1), me->query("id"),
        ob->name(1), ob->query("id")));
  }

  for (i = 0; i < sizeof(gifts); i++) {
    ob->set(gifts[i], ob->query("max_" + gifts[i]));
    ob->set("eff_" + gifts[i], ob->query("max_" + gifts[i]));
  }
  for (i = 0; i < sizeof(gifts1); i++) {
    ob->set(gifts1[i], ob->query("max_" + gifts1[i]));
  }
  ob->set("food", ob->max_food_capacity());
  ob->set("water", ob->max_water_capacity());
  ob->clear_condition();
  if (me == ob) {
    message_vision(HIY "$N" HIY "口中念念有词，不一会儿就变得"
      "精神焕发，神采奕奕。\n" NOR, me);
    if (me->is_ghost()) me->reincarnate();
    me->clear_condition();
  } else {
    message_vision(HIY "$N" HIY "伸手一指，$n" HIY "立刻精神焕"
      "发，神采奕奕。\n" NOR,
      me, ob);
    if (!living(ob)) ob->revive();
    if (ob->is_ghost()) ob->reincarnate();
    ob->clear_condition();
    log_file("cmds/full", sprintf("%s %s full %s(%s)\n",
      log_time(), log_id(me),
      ob->name(1), ob->query("id")));
  }
  return 1;
}

int help(object ob) {
  write(@HELP
指令格式 : full <对象>

利用此指令可完全恢复生物的状态并清除一切condition。
HELP
  );
  return 1;
}
