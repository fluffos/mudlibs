// 新闻发布程序

#include <ansi.h>;
inherit BULLETIN_BOARD;

void create()
{
        set_name("三界神话蛇口站公告", ({ "board"}) );
        set("location", "/d/wiz/newsroom"); 
        set("board_id", "wiznews_b");      
        setup();
        set("capacity", 500);
}

int check_news(object me)
{
        int num,i,last_time_read;
        mapping *notes, last_read_time;
        string myid,msg="";
        
        notes = query("notes");
        last_read_time = me->query("board_last_read");
        myid = query("board_id");
        //if( !pointerp(notes) || !sizeof(notes) ) return 1;

        if(userp(me))
        {
                if( me->query("LastReadNews") > sizeof(notes) )  me->set("LastReadNews",sizeof(notes));
                i=sizeof(notes)-me->query("LastReadNews");
                
                if(i < 6 && i > 0) // 小于6条新闻才显示标题，不然会FLOOD
                {
                        msg = "\n\n ━━━━━━━━━━━━━━━━ "HIC"最  新  消  息"NOR" ━━━━━━━━━━━━━━━    \n\n";
                        
                        if( !mapp(last_read_time) || undefinedp(last_read_time[myid]) )
                                num = 1;
                                
                        else
                                for(num = 1; num<=sizeof(notes); num++)
                                        if( notes[num-1]["time"] > last_read_time[myid] ) break;
                                        
                        if (mapp(last_read_time)) last_time_read = last_read_time[myid];
                        for(i=sizeof(notes)-1 ; i>num-2 ; i--)
                        {
                                msg += sprintf(" [%3d]"NOR,i+1);
                                msg += sprintf("   %-=26s %18s  [%s]\n",
                                        notes[i]["title"], notes[i]["author"],
                                        CHINESE_D->chinese_time(5, ctime(notes[i]["time"])));
                                        //ctime(notes[num]["time"])[0..4]);
                        }
                        
                        msg += " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━    \n\n";
                        
                        me->start_more(msg);
                }
                
                i=sizeof(notes)-me->query("LastReadNews");
                  
                write("\n从您上次阅读到现在"+((i==0)? "没有任何":"共有"+HIY+chinese_number(i)+NOR"条")+"新闻没看。\n\n");
                //if(i>10) write("你可以 Help news 来查看新闻系统的使用方法。\n"); // 提醒不知道有NEWS系统的玩家使用news
                write("你可以 "+HIC"Help news"NOR+" 来查看新闻系统的使用方法。\n");
        }
}

int main(object me, string arg)
{
        int num,i,last_time_read;
        mapping *notes, last_read_time;
        string myid,msg;

        last_read_time = me->query("board_last_read");
        myid = query("board_id");
        notes = query("notes");
        if( me->query("LastReadNews") > sizeof(notes) )  me->set("LastReadNews",sizeof(notes));
        i=sizeof(notes)-me->query("LastReadNews");
        
        if( !pointerp(notes) || !sizeof(notes) )
                return notify_fail("本站目前没有任何新闻。\n");
                
        if( !arg ) 
        {
                if(i>10) write("你可以 Help news 来查看本站新闻系统的使用方法。\n"); 
                        return notify_fail(
                                "本站目前共有"+HIW+chinese_number(sizeof(notes))+NOR"条新闻"+((i==0)? "。":"，您有"+HIY+chinese_number(i)+NOR"条新闻尚未阅读。")+"\n"); }
                                
                if( arg=="all") // 显示所有新闻
                {
                        msg = "\n\n ━━━━━━━━━━━━━━━━━ "HIW"本站新闻一览"NOR" ━━━━━━━━━━━━━━━━    \n";
                        notes = query("notes");
                        
                        if (mapp(last_read_time)) last_time_read = last_read_time[myid];

                        for(i=sizeof(notes)-1 ; i>-1 ; i--)
                        {
                                msg += sprintf("%s [%3d]" NOR,
                                notes[i]["time"] > last_time_read ? HIY: "", i+1);
                                msg += sprintf("     %-=38s %18s (%s)\n",
                                        notes[i]["title"], notes[i]["author"],
                                        //CHINESE_D->chinese_time(5, ctime(notes[num]["time"])));
                                        ctime(notes[num]["time"])[0..9]);
                        }
                        msg += "\n";
                        me->start_more(msg);
                        return 1;
                        
                }
                else
                if ( arg=="new" )  // 显示最新新闻
                {
                        if( !mapp(last_read_time) || undefinedp(last_read_time[myid]) )
                                num = 1;
                        else
                                for(num = 1; num<=sizeof(notes); num++)
                                        if( notes[num-1]["time"] > last_read_time[myid] ) break;
                } else if( !sscanf(arg, "%d", num) )
                
        return notify_fail("你到底要看第几条新闻呀？\n");
        
        if( num < 1 || num > sizeof(notes) )
        {
                if(arg=="new") return notify_fail("你已经没有最新新闻可看了 ！\n");
                else return notify_fail(HIW"O"+HIY"_"+HIW"O"NOR+" 没有这条新闻呀！\n");
        }
                
        num--;
        me->start_more( sprintf("\n\n%s\n"HIR" 新闻主题："HIY"%s\n"HIW" 发布巫师："NOR"%s\n"HIG" 新闻时间：%s\n"NOR
        "-------------------------------------------------------------------------------\n",
                BBLU HIG"「"HIC"SJSH-SK"HIG"」第"+chinese_number(num + 1)+"条新闻"NOR, 
                notes[num]["title"], notes[num]["author"],
                //CHINESE_D->chinese_date(5,ctime(notes[num]["time"])))
                ctime(notes[num]["time"])[0..9])
                //ctime(notes[num]["time"]))
                + notes[num]["msg"]+
        "-------------------------------------------------------------------------------\n\n", );

        if( !mapp(last_read_time) )
                me->set("board_last_read", ([ myid: notes[num]["time"] ]) );
        else 
                if( undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid] )
                        last_read_time[myid] = notes[num]["time"];

        if(me->query("LastReadNews") < num + 1)
                me->set("LastReadNews",num+1);

        return 1;
}

void init()
{
        object me=this_player();

       if (wizardp(me) &&  wiz_level(me) > wiz_level("(apprentice)") )
        {
                add_action("do_post", "post");
                add_action("do_discard", "discard");
      } 
}
void done_post(object me, mapping note, string text)
{
        mapping *notes;

        note["time"] = time();
        note["msg"] = text;
        notes = query("notes");
        if( !pointerp(notes) || !sizeof(notes) )
                notes = ({ note });
        else
                notes += ({ note });

        if( sizeof(notes) > query("capacity"))
                notes = notes[query("capacity")/2 .. query("capacity")];

        set("notes", notes);
        save();
        restore();
// 使用channel显示提示有了最新新闻
        //CHANNEL_D->do_channel(me, "chat", BLINK HIY" 本站有了最新新闻，请用 news 查看。\n\n" NOR);
        tell_object(me, "新闻发表完毕。\n");
        message("channel:chat",BLINK HIY"本站有了最新新闻，请用 news new 查看。\n\n" NOR,users());
        return;

}

int help(object me)
{
    write(@HELP
    
「三界神话-蛇口站」新闻系统指令 
 指令格式 :
 news                    查看共有的和最新发布的新闻。
 news all                本站新闻一览。 
 news new                阅读最新的新闻。 
 news <新闻编号>         查看此编号新闻的详细内容。 
HELP
    );
    return 1;
}
