// edit.c
// Modified by island@fyzx

#include "/doc/help.h"
inherit F_DBASE;
inherit F_CLEAN_UP;
void create()
{
        seteuid(getuid());
        set("name", "编辑指令");
        set("id", "edit");            
        set("channel_id","在线编辑");
}
int main(object me, string file)
{
	string filename;

	filename=resolve_path(me->query("cwd"), file);

        if (! SECURITY_D->valid_grant(me, "(wizard)"))
                return 0;

	if (! file)
		return notify_fail("指令格式：edit <档名>\n");

	if (in_edit(me))
		return notify_fail("你已经在使用编辑器了。\n");

        if (!(int)SECURITY_D->valid_write(resolve_path(me->query("cwd"), file),me,"write"))
                return notify_fail("你没有足够的读写权利。\n");

	foreach (object user in users())
        if (filename == "/"+in_edit(user) )
        return notify_fail("共享冲突："+user->name(1)+"("+capitalize(user->query("id"))+")"+"正在编辑该文件("+filename+")。\n");

	printf("编辑文件：%s\n",filename);

        CHANNEL_D->do_channel(this_object(),"sys",
	me->query("name")+"("+me->query("id")+")"+"正在在线编写"
	+resolve_path(me->query("cwd"),file)+"。");

        seteuid(geteuid(me));
        ed(resolve_path(me->query("cwd"), file));
	me->set("cwf",filename);
        if(!me->query("env/no_edit_msg"))
                log_file("cmds/edit/"+geteuid(me), 
		sprintf("edit %s %s\n", resolve_path(me->query("cwd"), 
		file), log_time()) );
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令可直接在线上编辑档案。

HELP );
        return 1;
}
