/*    /cmds/creator/netstat.c
 *    from the Dead Souls LPC Library
 *    gives socket status information
 *    created by Descartes of Borg 921123
 */

#include <lib.h>

inherit LIB_DAEMON;

/* FluffOS PORT NOTE: dump_socket_status() (a formatted-string debug
 * efun) doesn't exist on this driver -- only socket_status() (an
 * array of per-socket status mappings/arrays) does. Reimplemented
 * using the modern efun rather than left broken, since this is a
 * simple 1:1 feature substitution, not new functionality.
 */
mixed cmd(string args) {
    mixed *info;
    string *arr;
    int i;

    info = socket_status();
    arr = ({});
    for(i = 0; i < sizeof(info); i++) {
	if( !info[i] || info[i][0] == -1 ) continue;
	arr += ({ sprintf("%O", info[i]) });
    }
    if( !sizeof(arr) ) arr = ({ "No active sockets." });
    this_player()->eventPage(arr, "system");
    return 1;
}

void help() {
    message("help", "Syntax: <netstat>\n\n"
	    "Gives you information about sockets being used by the LPC "
	    "server through the MudOS socket efuns.\n\n"
	    "See also: callouts, dumpallobj, mstatus", this_player());
}
