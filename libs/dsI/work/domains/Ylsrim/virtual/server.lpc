/* FluffOS PORT NOTE: was `#define __DIR__ ...` in the original archive
 * -- __DIR__ is a real predefined/reserved macro on this driver (like
 * __FILE__/__LINE__, expands to the current file's directory), which
 * didn't exist yet on the 1996-era MudOS this archive targeted.
 * Renamed to VIRT_DIR (this file's own local naming collision, not a
 * driver-compat rewrite of the actual constant).
 */
#define VIRT_DIR "/your/dir/here/"

object compile_object(string file) {
    string *path;
    object ob;
    int x, y;
    
    if( previous_object() != master() ) return 0;
    path = explode(file, "/");
    if( sizeof(path) != 5 ) return 0;
    if( file_size(VIRT_DIR + path[3] + ".lpc") < 1 ) return 0;
    if( sscanf(path[4], "%d,%d", x, y) != 2 ) return 0;    
    if( !(ob = new(VIRT_DIR + path[3], x, y)) ) return 0;
    return ob;
}
