#include <lib.h>
/* FluffOS PORT NOTE: original archive had `#include <room.h>` (singular)
 * here, which doesn't exist as a global-include-path header (only
 * /lib/include/room.h, a per-inheritable prototype header this file
 * doesn't need since it calls SetShort()/SetLong()/SetProperties() on
 * itself via `inherit LIB_ROOM`, not on some other typed room object)
 * and, more importantly, doesn't define ROOM_START (used below) at
 * all -- that macro lives in rooms.h (plural). Almost certainly a
 * missing-"s" typo for `#include <rooms.h>`; fixed to what this file
 * actually needs.
 */
#include <rooms.h>

inherit LIB_ROOM;

void create() {
    room::create();
    SetShort( "The cache");
    SetLong( "Things are hidden here.");
    SetProperties( ([ "storage room" : 1, "logout" : ROOM_START ]) );
}
