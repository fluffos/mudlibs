#include <lib.h>

inherit LIB_LOOK_IN;

/* Light of the contents. A container's own glow belongs to LIB_RADIANCE, which classes get
 * through LIB_OBJECT; a class that is both an object and a container (npc, interactive,
 * storage) adds object::GetRadiantLight() to this result. Inheriting LIB_RADIANCE here too
 * would give those classes two copies of it. */
int GetRadiantLight(int ambient) {
    int r = 0;
    int o = GetOpacity();
    
    if( o > 99 ) return 0;
    foreach(object ob in all_inventory()) {
	r += ob->GetRadiantLight(ambient);
    }
    if( ambient > 0 ) {
	int y;
	
	y = (r*10)/ambient;
	if( y > r ) {
	    y = r;
	}
	else {
	    r = y;
	}
    }
    return ( (r*(100-o))/100 );
}

int CanReceive(object ob) {
    return 1;
}

int CanRelease(object ob) {
    return 1;
}

int eventReceiveObject(object ob) {
    return !(!previous_object());
}

int eventReleaseObject(object ob) {
    return !(!previous_object());
}
