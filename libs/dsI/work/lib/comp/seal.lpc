 *    Last modified: 96/12/23
 */

#include <lib.h>

inherit LIB_CLOSE;
inherit LIB_LOCK;

varargs nosave mixed AddSave(mixed args...) {
    return ({});
}

mixed CanLock(object who, string id) {
    mixed tmp = lock::CanLock(who);

    if( tmp != 1 ) {
	return tmp;
    }
    if( !GetClosed() ) {
	return "You cannot lock it while it is open.";
    }
    return 1;
}

mixed CanOpen(object who) {
    if( GetLocked() ) {
	return "It is locked!";
    }
    else return close::CanOpen(who);
}

varargs mixed eventOpen(object who, object tool) {
    if( tool && GetLocked() ) {
	/* FluffOS PORT NOTE: this call skipped eventPick()'s middle
	 * `string id` parameter (see lib/events/lock.lpc:
	 * `varargs mixed eventPick(object who, string id, object
	 * tool)`), passing `tool` positionally into the `id` slot --
	 * a pre-existing archive bug (this driver's strict argument
	 * type-checking catches it as "Bad type for argument 2 of
	 * eventPick", string vs object; an older/looser driver
	 * evidently let it through silently). This is this codebase's
	 * single highest-impact compile blocker: 14 other files inherit
	 * this component (lib/door.lpc, lib/std/{corpse,limb,storage}.
	 * lpc, lib/trap.lpc, several domains/Ylsrim/ objects), so this
	 * one wrong call broke all of their compiles too. Fixed by
	 * passing 0 for `id` (no specific sub-lock identifier), which is
	 * what a 2-arg `eventPick(who, tool)` call clearly intended.
	 */
	mixed tmp =  eventPick(who, 0, tool);

	if( tmp != 1 || GetLocked() ) {
	    return tmp;
	}
    }
    if( GetLocked() ) {
	send_messages(({ "attempt", "find" }), "$agent_name $agent_verb to "
	              "open $target_name, but $agent_nominative $agent_verb "
	              "it locked.", who, this_object(), environment(who));
	return 1;
    }
    return close::eventOpen(who, tool);
}

nosave private void create() {
    AddSave(close::GetSave() + lock::GetSave());
}
