#include "defs.h"

inherit "/players/feldegast/tourney/Packs/pack.lpc";

void reset(int arg) {
  ::reset(arg);
  if(arg) return;
  clone_object(ARMOR+"Tmisc.lpc")->move_object(this_object());
  clone_object(ARMOR+"Tring.lpc")->move_object(this_object());
  clone_object(ARMOR+"Tamulet.lpc")->move_object(this_object());
  clone_object(ARMOR+"Tboots.lpc")->move_object(this_object()); 
  clone_object(ARMOR+"Tarmor.lpc")->move_object(this_object());  
  clone_object(WEAPONS+"Tdagger.lpc")->move_object(this_object());
}