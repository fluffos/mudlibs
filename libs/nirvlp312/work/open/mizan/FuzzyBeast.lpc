inherit "obj/monster";

string short_list;
string long_list;
int long_num;
int short_num;

reset(arg) {
  if(arg) return;
  ::reset(arg);
  if(short_list || long_list) {
  long_num=random(sizeof(long_list)-1);
  short_num=random(sizeof(short_list)-1);
  set_short(short_list[short_num]);
  set_long(long_list[long_num]);
 }
}

