#include "/players/plasma/define.h"

inherit "/obj/treasure.lpc";
reset(int arg) {
   if(arg) return;
   set_id("that");
   set_short("a that");
   set_long("blah\n");
}

init() {
   add_action("new_this","new_this");
}

new_this() {
   destruct(present("this",TP));
   clone_object("/players/plasma/obj/this")->move_object(resolve_ob(TP));
   return 1; }

query_auto_load() { return "/players/plasma/obj/that.c:"; }
drop() { return 1; }
