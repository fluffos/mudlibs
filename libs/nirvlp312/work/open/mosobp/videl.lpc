#include "/sys/lib.h"

#include "ansi.h"

inherit "/obj/monster";

reset(arg)
{
        object gold;
        ::reset(arg);
    if(arg) return ;
        set_name("videl");
        set_short(MAG+"Videl"+NORM);
        set_race("human");
        set_long(
        "Videl is Gohan's girlfriend and future wife. She helps him fight crime\n"+
        "about the city, and he teaches her to fly. Videl's father is Mr. Satan.\n");
        set_level(26);
        set_hp(1100+random(200));
        set_al(1000);
        gold=clone_object("/obj/money");
        gold->set_money(random(3000)+8000);
        gold->move_object(this_object());
        set_wc(44+random(10));
        set_ac(22);
        set_heal(30,5);
        set_multi_cast(3);
        add_spell("powerrush",
  "$HR$#MN  rushes forward UPPERCUTS  your  FACE !!!!$N$\n"+NORM,
          "#MN#"+HIK+" screams as she runs forard with a "+HIR+" POWERRUSH "+HIK+"  !!!\n"+NORM,
          30,70,"other|energy");
        clone_object("/players/mosobp/areas/BATTLE/OBJ/eki.lpc")->move_object(this_object());
        init_command("wear shield");
}
