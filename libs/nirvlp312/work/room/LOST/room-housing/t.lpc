void reset(status arg) {
  int i, count;
  object *obs;

  if (arg) return;
  obs = users();
  count = 0;
  i = sizeof(obs);
  while(i--) if (obs[i]->query_invis()) count++;
  write("First time through: "+count+"\n");
  obs = (object *)users()->query_invis();
  i = sizeof(obs);
  write(obs[i]+"\n");
}
