nosave string ROOTDIR;
nosave string LOGDIR;
nosave string CMDDIR;
nosave string NPCDIR;
nosave string DAEMONS;
nosave string HELPDIR;
nosave string WIZHELP;
nosave string OBJDIR;
nosave string WEPDIR;
nosave string ARMDIR;
nosave string LIBDIR;
nosave string ROOMDIR;
nosave string SPELLS;
nosave string STDDIR;
nosave string PERSONAL_LOGS;
nosave string MAINSAVE;
nosave string BACKUPDIR;
nosave string GUILDNAME;
nosave string *GWIZ;
nosave string OBJPATH;
nosave string MASTER;
nosave string WIZTOOL;

inherit "/obj/clean";

void reset(status x)
{
 if(x) return;
 if(ROOTDIR) return;
 set_no_clean(1);
ROOTDIR = "";
LOGDIR = "";
CMDDIR = "";
NPCDIR = "";
DAEMONS = "";
HELPDIR = "";
WIZHELP = "";
OBJDIR = "";
WEPDIR = "";
ARMDIR = "";
LIBDIR = "";
ROOMDIR = "";
SPELLS = "";
STDDIR = "";
PERSONAL_LOGS = "";
MAINSAVE = "";
BACKUPDIR = "";
GUILDNAME = "";
GWIZ = ({});
OBJPATH = "";
MASTER = "";
WIZTOOL = "";
}
