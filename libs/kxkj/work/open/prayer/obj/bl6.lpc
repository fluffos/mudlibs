#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  string na;
  object me;
  me = this_player();
  na = (me->name(0));

  if (me)
    set_name(na + "的[32m龙骨圣刀[0m", ({ "dragon-bone blade", "blade" }));
  else {
    set_name("[32m龙骨圣刀[0m", ({ "dragon-bone blade", "blade" }));
  }
  seteuid(getuid());
  set_weight(25000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG

	龙骨圣刀, 乃当世十八神兵之一, 刀柄上所镶的三个 
	宝石更是灿烂耀眼, 只见刀上隐隐透出霸王之气, 真
	是另人爱不释手!!拿在手上就如同一代枭雄一般, 威
	风八面!!

LONG);
    set("value", 12000);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_auc", 1);
    set("material", "iron");
    //       set("wield_msg", "$N从刀鞘将$n拔出来之后，火光四溢。\n");
    //      set("unwield_msg", "$N用衣服将$n包了起来，其红色的豪光被布包给遮蔽了。\n");
  }
  init_blade(115);
  setup();
}
int query_autoload() { return 1; }
