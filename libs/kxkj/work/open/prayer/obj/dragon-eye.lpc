//黄甲金龙的眼珠()
#include <command.h>
inherit ITEM;

void create() {
  set_name("[33m黄甲金龙的眼珠[0m", ({ "dragon eye", "eye" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是破邪洞窟中[33m黄甲金龙[0m的眼珠, 传闻[33m黄甲金龙[0m全身上下均具有龙的魔力。\n");
    set("value", 800);
    set("material", "gem");
    set("no_sell", 1);
    set("no_auc", 1);
  }
}
