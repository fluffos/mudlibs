#include <ansi.h>
inherit EQUIP;

void create() {
  set_name("[32m乾坤头带[0m", ({ "boris hat", "hat" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "圣火教教主专用的头部防护用具。\n");
    set("unit", "条");
    set("value", 150000);
    set("material", "fur");
    set("wear_msg", "[36m$N一戴上了$n，[35m乾坤卦象[36m涌现，悟性倏地提高了许\多。[0m\n");
    set("armor_type", "head");
    set("armor_prop/armor", 10);

  }
  setup();
}
