#include "/open/open.h"
#include <ansi.h>

inherit NPC;
void create() {
  set_name("[1;33m骆驼[0m", ({ "desert camel", "desert", "camel" }));
  set("title", "[33m尘沙[0m");
  set("gender", "野兽");
  set("long", "一只单峰骆驼，土黄色的皮肤，呆滞的眼神，乍看之下并不像
什么了不起的珍兽。但仔细一看，眼神中微微透出耀眼光彩，黄沙
缓缓地从正在咀嚼草料的嘴巴中流出。看样子这家伙并不好惹！
");
  set("combat_exp", 1000000);
  set("max_kee", 3000);
  set("max_gin", 1870);
  set("max_sen", 2150);
  set("max_force", 3500);
  set("force", 3500);
  set("force_factor", 60);

  setup();
}

void die() {
  object killer;
  killer = query_temp("last_damage_from");
  killer->set_temp("marks/k_camel", 1);
  message_vision("[1;31m$N打得兴起，尘沙骆忽然口吐鲜血，四脚朝天，死了！[0m\n", killer);
  ::die();
}

void unconcious() {
  object killer;
  killer = query_temp("last_damage_from");
  killer->set_temp("marks/f_camel", 1);
  message_vision("[1;36m$N成功\地驯服了骆驼！[0m\n", killer);
  ::unconcious();
}
