// Room: /u/d/dhk/questsfan/rm12
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "[0;32m云雾松林[2;37;0m");
  set("long", @LONG
松林蔽日、云雾迷蒙、松果满地，这儿最奇怪的是一片大松林
竟没看到半株茎干，格外特别。不时有几只罕见的六尾松鼠狂奔而
过，不然就是昆虫的鸣叫声，特别的是牠们的一起突然的大鸣，然
后再一起的安静，那一起突发的鸣叫声真是相当令人震撼的。

LONG);

  set("exits", ([ /* sizeof() == 4 */
    "westup": __DIR__ "rm13",
    "southdown": __DIR__ "rm18",
    "westdown": __DIR__ "rm19",
    "eastdown": __DIR__ "rm11",
  ]));
  set("outdoors", "/u/d");

  setup();
}
void init() {
  call_out("dhk", 1, this_player());
}
void dhk(object who) {
  if (who->query_temp("run") != 1 && who->query_temp("run") == 8) {
    tell_object(who, "" WHT "这道黑色的人影这次又加快速度朝东边山下奔去，还是追吧。" NOR "\n");
    who->set_temp("run", 1);
    remove_call_out("dhk");
  }
}
