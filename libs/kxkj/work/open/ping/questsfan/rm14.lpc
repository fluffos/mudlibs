// Room: /u/d/dhk/questsfan/rm14
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "[0;32m云雾松林[2;37;0m");
  set("long", @LONG
松林蔽日、云雾迷蒙、松果满地，这儿最奇怪的是一片大松林
竟没看到半株茎干，格外特别。不时有几只罕见的六尾松鼠狂奔而
过，不然就是昆虫的鸣叫声，特别的是牠们的一起突然的大鸣，然
后再一起的安静，那一起突发的鸣叫声真是相当令人震撼的。

LONG);

  set("exits", ([ /* sizeof() == 4 */
    "westdown": __DIR__ "rm15",
    "southdown": __DIR__ "rm20",
    "eastdown": __DIR__ "rm19",
    "eastup": __DIR__ "rm13",
  ]));
  set("outdoors", "/u/d");

  setup();
}
void init() {
  call_out("dhk", 1, this_player());
}
void dhk(object who) {
  if (who->query_temp("run") != 7 && who->query_temp("run") == 6) {
    tell_object(
      who,
      "" WHT "追了这么久终于认出此人身法竟是" HIY "凌波微步" NOR + WHT "，这道黑色的人影这次又朝东边山上奔去，还是追吧。" NOR "\n"
    );
    who->set_temp("run", 7);
    remove_call_out("dhk");
  }
}
