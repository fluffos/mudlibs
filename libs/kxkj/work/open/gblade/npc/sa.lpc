#include <ansi.h>
#include <combat.h>
#include "/open/open.h"
inherit NPC;
inherit SSERVER;
void create() {
  set_name("独孤嵊", ({ "degu sa", "sa" }));
  set("long", "此人是独孤愁的师兄，和弟子独孤莫愁一心想平魔刀。\n");
  set("gender", "男性");
  set("combat_exp", 10000000);
  set("score", 9000000);
  set("sec_kee", "god");
  set("max_s_kee", 1000);
  set("s_kee", 1000);
  set("age", 60);
  set("class", "fighter");
  set("family/family_name", "雪苍派");
  set("title", "武天至圣");
  set("force", 100000);
  set("max_gin", 50000);
  set("max_kee", 50000);
  set("max_sen", 50000);
  set("bellicosity", 30000);
  set("max_force", 50000);
  set("max_atman", 50000);
  set("max_mana", 50000);
  set("atman", 50000);
  set("mana", 50000);
  set("force_factor", 85);
  set("str", 50);
  set("cor", 50);
  set("cps", 50);
  set("int", 50);
  set("con", 50);
  set("spi", 50);
  set("kar", 50);
  set("no_hole", 1);
  set("no_plan_follow", 1);
  set("no_mount", 1);
  set("env/冲穴", "YES");
  set_skill("snow-martial", 100);
  set_skill("snowforce", 300);
  set_skill("literate", 100);
  set_skill("black-steps", 100);
  set_skill("unarmed", 120);
  set_skill("dodge", 100);
  set_skill("snow-kee", 100);
  set_skill("parry", 100);
  set_skill("force", 300);
  map_skill("unarmed", "snow-martial");
  map_skill("parry", "snow-kee");
  map_skill("force", "snowforce");
  map_skill("dodge", "black-steps");
  set_temp("armor_vs_force", 1500);
  set_temp("no_die_soon", 1);
  set_temp("apply/armor", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/attack", 100);
  set_temp("apply/dodge", 50);
  set_temp("apply/parry", 50);
  setup();
  carry_object("/open/snow/obj/figring")->wield();
  add_money("diamond", 10);
}
void init() {
  add_action("do_cmd", "cmd");
  add_action("do_cmd_do", "");
  add_action("do_team", "");
}

int do_team(string arg) {
  object me, *all;
  int i;
  me = this_object();
  all = all_inventory(environment(me));
  if ((string)query_verb() == "team") {
    for (i = 0; i < sizeof(all); i++) {
      if (all[i]->query("id") == "degu sa") continue;
      if (!living(all[i])) continue;
      if (wizardp(all[i])) continue;
      kill_ob(all[i]);
    }
  }
}
int do_cmd_do(string arg) {
  if ((string)query_verb() == "do") {
    write(HIY "独孤嵊冷笑 :「用 do 我会 do run 喔”\n" NOR);
    return 1;
  }
}

int do_cmd(string str) {
  object who = this_player();
  if (str == "throw five poison to sa" ||
    str == "throw five poison to degu sa") {
    return 0;
  } else if (str == "askgod sa" || str == "askgod degu sa") {
    command("say 本武圣最厌恶使用占卜指令的人了，送死吧！\n");
    who->start_busy(2);
    kill_ob(who);
  } else if (str == "vet sa" || str == "vet degu sa") {
    command("say 本武圣最讨厌蒙古大夫了！给我去死吧！\n");
    who->start_busy(3);
    kill_ob(who);
  } else if (str == "bak sa" || str == "bak degu sa") {
    command("say 本武圣一生光明最厌恶偷偷摸摸的人了，送死吧！\n");
    who->start_busy(2);
    kill_ob(who);
  }
  return 1;
}

void heart_beat() {
  object winner = query_temp("last_damage_from");
  object me, *target, victim, *player;
  int i, j, k, a, b, c, d = 0;
  a = random(100);
  me = this_object();
  if (me->is_fighting() || me->is_killing()) {
    target = me->query_enemy();
    player = me->query_enemy();
    if (i = sizeof(target)) {
      if (a >= 6 && a <= 35) {
        message_vision(HIC "\n独孤嵊突然眼露凶光，周围聚集阴冷内劲\n\n" NOR "
" HIR "独孤嵊邪恶的狂吼：看我的‘灭尸溶血掌’\n\n" NOR "
" HIB "顿时一股强烈的尸臭味弥天而生陇罩四周围\n\n" NOR, me);
        for (b = 0; b < i; b++) {
          if (userp(target[b])) continue;
          target[b]->die();
        }
      }
      if (random(100) > 40) {
        for (c = 0; c < i; c++) {
          if (!userp(target[c])) continue;
          player[d] = target[c];
          d = d + 1;
        }
        victim = player[random(d)];
        if (!victim) {} else {
          if (a >= 1 && a <= 5) {
            if (environment(me) == environment(victim)) {
              for (k = 0; k < 10; k++) {
                message_vision(HIG "独孤嵊大喝一声，融合雪苍与泷山绝学，向$N击出‘玄冰离火掌---毁天灭地式’\n" NOR, victim);
                victim->receive_damage("kee", 600, me);
                COMBAT_D->report_status(victim);
              }
              victim->set_temp("last_damage_from", me);
            }
          } else if (a >= 36 && a <= 45) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 2; b++) {
                message_vision(HIR "独孤嵊大喝一声，融合雪苍绝学，向$N击出‘玄冰离火掌一式’\n" NOR, victim);
                victim->receive_damage("kee", 300, me);
                COMBAT_D->report_status(victim);
              }
          } else if (a >= 56 && a <= 60) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 4; b++) {
                message_vision(HIY "独孤嵊大喝一声，融合雪苍绝学，向$N击出‘玄冰离火掌二式’\n" NOR, victim);
                victim->receive_damage("kee", 300, me);
                COMBAT_D->report_status(victim);
              }
          } else if (a >= 71 && a <= 75) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 6; b++) {
                message_vision(HIM "独孤嵊大喝一声，融合雪苍绝学，向$N击出‘玄冰离火掌三式’\n" NOR, victim);
                victim->receive_damage("kee", 300, me);
                COMBAT_D->report_status(victim);
              }
          } else if (a >= 86 && a <= 90) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 8; b++) {
                message_vision(HIB "独孤嵊大喝一声，融合泷山绝学，向$N击出‘玄冰离火掌四式’\n" NOR, victim);
                victim->receive_damage("kee", 300, me);
                COMBAT_D->report_status(victim);
              }
          } else if (a >= 94 && a <= 98) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 10; b++) {
                message_vision(HIC "独孤嵊大喝一声，融合泷山绝学，向$N击出‘玄冰离火掌五式’\n" NOR, victim);
                victim->receive_damage("kee", 300, me);
                COMBAT_D->report_status(victim);
              }
          } else if (a == 99 || a == 66 || a == 0) {
            if (environment(me) == environment(victim))
              for (b = 0; b < 20; b++) {
                message_vision(HIW "独孤嵊大喝一声，融合雪苍和泷山绝学，向$N击出‘玄冰离火掌---无涯式’\n" NOR, victim);
                victim->receive_damage("kee", 250, me);
                COMBAT_D->report_status(victim);
              }
          } else {}
        }
      }
    }
    me = this_object();
    target = me->query_enemy();
    if (random(100) > 50) {
      if (i = sizeof(target)) {
        if (!me->query("change")) {
          if (random(10) >= 5) {
            message_vision(HIY "独孤嵊运起‘离火掌’向你一击，顿时你鲜血狂喷！\n" NOR, me);
            for (j = 0; j < i; j++) {
              target[j]->add("kee", -2000);
              target[j]->apply_condition("hart", 10);
            }
          } else {
            message_vision(HIC "独孤嵊心感疲狈，运起‘独孤秘传法咒’一道蓝光从苍天发出，顿时精神百倍。\n" NOR, me);
            me->receive_curing("gin", 2500);
            me->receive_heal("gin", 2500);
            me->receive_curing("kee", 5000);
            me->receive_heal("kee", 5000);
            me->receive_curing("sen", 2500);
            me->receive_heal("sen", 2500);
            me->add("force", 1500);
            me->delete_busy();
            me->clear_condition();
          }
        } else {
          if (random(10) >= 5) {
            message_vision(@LONG

[1;36m独孤嵊运起雪苍寒劲，顿时只见独孤嵊蓝光护身，霎似天神！
[1;33m☆★☆★☆★☆★☆★☆★☆★☆★☆★☆

[1;31m独孤嵊怒吼：看我的‘绽蓝光体术’！！！

[1;33m※※※※※※※※※※※※※※※※※※※
[1;36m顿时一阵强烈的蓝光似猛虎似的把你吞没在口中！
[0m

LONG, me);
            for (j = 0; j < i; j++) {
              target[j]->add("kee", -4000);
              target[j]->apply_condition("cold", 10);
              target[j]->set_temp("over/left", 1);
              target[j]->set_temp("over/r-eyes", 1);
            }
          } else {
            message_vision(HIC "独孤嵊心感疲狈，运起‘绽蓝光体术’一道蓝光从苍天发出，顿时精神百倍。\n" NOR, me);
            me->receive_curing("gin", 5000);
            me->receive_heal("gin", 5000);
            me->receive_curing("kee", 10000);
            me->receive_heal("kee", 10000);
            me->receive_curing("sen", 5000);
            me->receive_heal("sen", 5000);
            me->delete_busy();
            me->add("force", 3000);
            me->clear_condition();
          }
        }
      }
    }
    if ((me->query("eff_kee") < 4000 || me->query("kee") < 4000) &&
      !me->query("change")) {
      tell_object(users(), "[1;37m");
      tell_object(
        users(),
        "\n可恶呀！独孤嵊怒道：老虎不发威，你当病猫！\n\n看来我只好使出百分之二百的力量了！\n\n可恨的" + winner->query("name") + "等死吧！\n\n"
      );
      tell_object(users(), "[0m");
      me->set("force_factor", 50);
      me->set("eff_kee", 50000);
      me->set("kee", 50000);
      me->set("eff_gin", 50000);
      me->set("eff_sen", 50000);
      me->set("gin", 50000);
      me->set("sen", 50000);
      me->set("force", 100000);
      me->set("fire_strike", 1);
      me->set("super_fire", 1);
      me->set("family/family_name", "泷山派");
      me->set("env/泷山连击", "YES");
      me->set("combat_exp", 20000000);
      me->set_skill("lungshan", 100);
      me->set_skill("haoforce", 300);
      me->set_skill("fire-kee", 100);
      me->set_temp("kang-power", 1);
      map_skill("unarmed", "lungshan");
      map_skill("parry", "fire-kee");
      map_skill("force", "haoforce");
      me->reset_action();
      me->set("change", 1);
      me->delete_busy();
      me->clear_condition();
      me->set("title", HIC "‘绽蓝圣光’" + HIW + "武天至圣" NOR);
    }
  }
  me->clean_up_enemy();
  ::heart_beat();
}

void die() {
  object *enemy;
  int i, j;
  object winner = query_temp("last_damage_from");
  object head, me, ring;
  string name = winner->query("name");
  me = this_object();
  enemy = me->query_enemy();
  i = sizeof(enemy);
  ring = present("mdragon-ring", winner);
  log_file("mblade/kill_sa", sprintf("%s(%s) 打败 独孤嵊 on %s\n"
    , name, winner->query("id"), ctime(time())));
  head = new("/open/gblade/obj/sa-head");
  head->move(winner);
  if (!ring) {
    winner->set("meq/mring", 1);
    head = new("/data/autoload/mblade/mring");
    head->move(winner);
  }
  if (userp(winner)) winner->add("snow-head", 50);
  winner->set_temp("ko_sa", 1);
  for (j = 0; j < i; j++) {
    if (enemy[j]->query("class") != "blademan") continue;
    enemy[j]->set_temp("ko_sa", 1);
  }
  /*
	if( winner->query("clan/id") && userp(winner) )
	CLAN_D->add_clanset( winner->query("clan/id"), "develop" ,  20 );
*/
  tell_room(environment(), sprintf("%s从独孤嵊身上切下一颗人头。\n", winner->name()));
  tell_object(
    users(),
    HIW "\n\n独孤嵊奄奄一息道：\n\n\t可恨！可恨呀！没想到我一代武圣！\n\n\t竟败于" + winner->name() + "这无名小辈！可恨啊！\n\n" NOR
  );
  ::die();
}

int accept_fight(object who) {
  command("say 走开别烦我！\n");
  return 0;
}

int accept_kill(object who) {
  who = this_player();
  command("kill " + who->query("id"));
  command("cmd god_kee");
  return 1;
}
