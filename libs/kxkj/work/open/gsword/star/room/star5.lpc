// Room: /u/b/blue/room/star1.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "[1;32m天机楼[2;37;0m");
  set("long", @LONG
这是七星塔中的第五层楼, 刚步入此地, 一阵刺鼻的药味冲
进了你的鼻子, 令你心中有股恶心的感觉, 你马上向四周观望,
发觉四周摆满了药材, 而在楼中央放置着丹炉, 原来此楼的楼主
喜欢研究医术, 当他看你一上来, 马上恶狠狠的瞪着你, 深怕你
将他炼制的丹药给偷了。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "room11.lpc",
    "out": __DIR__ "room10.lpc",
  ]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
    "/open/gsword/star/npc/star1.lpc": 1,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "up" && present("starman", environment(me)))
    if (!me->query_temp("allow_read", 1))
      return notify_fail("你以为你能活得过去吗??"
        +RANK_D->query_respect(me) + "你去死吧!\n");
  return ::valid_leave(me, dir);
}
