inherit EQUIP;

void create() {
  set_name("[1m[37m结婚戒指[0m", ({ "wedding ring", "ring" }));
  set("unit", "只");
  set("long", "象征永恒坚定的结婚戒指，献给这受上天祝福的两人。\n");
  set("armor_type", "finger");
  set("armor_prop/armor", 5);
  set("material", "pearl");  // 相当于 ??, 对重量跟价值有用
  set("no_drop", 1);
  set("no_sell", 1);
  //	set("thunder",100);//受上天祝福,怎可让雷劈呢....:p
  set("no_put", 1);
  set("light_up", -1);
  set_weight(1200);
  set("value", 999);
  setup();
}

int query_autoload() {
  return 1;
}
