inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "[1;32m炎龙谷入口[2;37;0m");
  set("long", @LONG
一个位于山脚下的地方，也就是传说中凶恶炎龙躲藏的地方
。从这里往山上看去隐约在山顶上有一间宽大的宫殿，一条小路
从宫殿一直延伸到山腰，但山腰被雾遮盖住了，看不出有什么东
西。四周看来死气沉沉，毫无生气，怪恐怖的。旁边有一块石碑
(stone)挡在路中央。
      这里一片雾茫茫看不到任何出路。
LONG);

  set("item_desc", ([ /* sizeof() == 1 */
    "stone": "
   武功\未熟，死路一条
         
         
   ",
  ]));
  set("no_transmit", 1);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/fire-dra.lpc": 2,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "enter": __DIR__ "a2",
    "east": __DIR__ "dr10",
  ]));

