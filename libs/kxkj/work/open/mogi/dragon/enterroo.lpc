int valid_leave(object me, string dir)

{
  if (dir == "enter" && present("fire-dragon guard", environment(me))) {
    if (me->query("combat_exp") < 299999 ||
      me->query("max_force") < 999) {
      message_vision("炎龙武士对$N怒喝 : 这里岂能让你自由进出！？\n", me);
      return 0;
    }
  }
  return 1;
}
