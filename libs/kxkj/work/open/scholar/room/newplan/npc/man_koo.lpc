//by sueplan
#include <ansi.h>
#include "/open/open.h"
inherit NPC;
string do_ans1();
string do_ans2();
string do_ans3();
string do_ans4();
string do_boot1();


void create() {
  set_name("黄石公", ({ "old-man koo", "koo", "old-man" }));
  set("class", "scholar");
  set("nickname", "$HIC$策谋宗师$NOR$");
  set("title", "[1;37m奇略[0m");
  set("long",
    "黄石公为当代著名之兵法家, 着有六韬一书, 
影响后世甚深, 不过看他好像有点烦心事喔。
");
  set("inquiry", ([
    "六韬": (: do_ans1 :),
    "不过": (: do_ans2 :),
    "太公望": (: do_ans3 :),
    "云山": (: do_ans4 :),
    "烦心事": (: do_boot1 :),
  ]));
  set("str", 40);
  set("cor", 25);
  set("gender", "男性");
  set("attitude", "heroism");
  set("family/family_name", "儒门");
  set("max_gin", 5000);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("max_force", 8000);
  set("force", 2000);
  set("force_faxtor", 20);
  set("combat_exp", 5000000);
  set_skill("stabber", 120);
  set_skill("dodge", 120);
  set_skill("move", 120);
  set_skill("parry", 120);
  set_skill("stabber", 200);
  set_skill("knowpen", 100);
  set_skill("god-plan", 100);
  set_skill("plan", 120);
  set_skill("force", 200);
  set_skill("poetforce", 150);
  set_skill("winter-steps", 100);
  map_skill("plan", "god-plan");
  map_skill("dodge", "winter-steps");
  map_skill("move", "winter-steps");
  map_skill("stabber", "knowpen");
  map_skill("parry", "knowpen");
  set("functions/movedown/level", 100);
  set("functions/finger/level", 100);
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action("stabber.movedown") :),
    (: perform_action("stabber.finger") :),
  }));
  set("chat_chance", 50);
  set("chat_msg", ({
  }));
  setup();
  carry_object("/open/scholar/obj/silver-pen")->wield();
  add_money("gold", 50);
}
string do_boot1() {
  object me = this_player();
  if (me->query("family/family_name") == "儒门") {
    if (me->query_temp("get_boots") == 3) {
      return ("ㄟ..没事情啦!!");
    }
    if (me->query_temp("get_boots") == 1) {
      return ("能在帮我拿一次鞋吗??在同一个地方");
    }
    if (me->query_temp("get_boots") == 2) {
      return ("能在帮我拿第三次鞋吗??在同一个地方");
    }
    if (!me->query_temp("get_boots")) {
      me->set_temp("ask_thing_ok", 1);
      return ("你能帮我拿我的鞋子吗?我的鞋子掉了!!");
    }
  } else
    return ("ㄟ??你不是儒门的吧??");
}
string do_ans1() {
  object me = this_player();
  if (me->query("combat_exp") < 7000000) {
    return "你的经验值要到七百万才能知道有关六韬的事情";
  }
  if (me->query("family/family_name") == "儒门" && me->query_temp("get_boots") == 3) {
    me->set_temp("six_ask", 1);
    return ("
          六韬乃是我收集春秋战国各大战策奇谋
          里面记着不少的重要兵法, 不过....。");
  } else
    return ("连六韬都不知道??别在和我说话啦....");
}
string do_ans2() {
  object me = this_player();
  if (me->query_temp("six_ask") == 1) {
    me->set_temp("six_ask", 2);
    return ("
          这本书现在不在我这边, 我把他赠送于
          足智多谋的军师姜子牙 - 太公望了。
          ");
  } else
    return ("这事和你无关吧??");
}
string do_ans3() {
  object me = this_player();
  if (me->query_temp("six_ask") == 2) {
    me->set_temp("six_ask", 3);
    return ("
          他是我所看中的天才策谋家, 能力更在
          我之上哩, 我的六韬交给他之后, 它不
          但将所有的策谋看过后并加以改良, 比
          比我所著之六韬更为有用, 他帮周王朝
          平定江山后, 就隐居于云山中。");
  } else
    return ("汪汪??是狗吗???");
}
string do_ans4() {
  object me = this_player();
  if (me->query_temp("six_ask") == 3) {
    me->set_temp("six_ask", 4);
    return ("
          年轻人, 你不知道云山在那吗? 好吧!!
          云山是在长沙城附近的地方, 你去找找
          吧。");
  } else
    return ("看日出??。");
}
int accept_object(object me, object obj) {
  if (obj->query("id") == "small boots") {
    command("pat " + getuid(me));
    command("say 太好了, 帮我捡了鞋子, 谢了。");
    if (me->query("family/family_name") == "儒门" || me->query_temp("get_boots") < 3) {
      command("say 呵呵, 真的感谢你啰, 以后请你多多帮我捡鞋子。");
      write(this_object()->query("name") + "看着鞋子缓缓穿上。\n\n" +
        "不过脸上却出现了有点恶作剧的表情。\n\n");
      me->add_temp("get_boots", 1);
    } else {
      command("say 我可不要那么多鞋子喔!!");
    }
    destruct(obj);
  } else {
    command("say 干嘛??");
  }
  return 1;
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    //             remove_call_out("greeting");
    //             call_out("greeting",2,ob);
  }
  add_action("do_nod", "nod");
}
int do_nod() {
  object ob = this_object(), me = this_player();
  if (me->query_temp("get_boots") == 3) return 0;
  if (me->query("family/family_name") != "儒门") return 0;
  if (!me->query_temp("ask_thing_ok")) return 0;
  if (me->query_temp("get_boots") == 3) return 0;
  command("say 我的鞋子掉在东南方的桥下, 请你帮我捡回来。");
  me->set_temp("can_get", 1);
  message_vision("$N对$n微微笑着。\n", ob, me);
  return 1;
}
void greeting(object ob) {
  if (ob->query_temp("get_boots") == 3) {
    command("hmm");
    command("say 年轻人, 你真的很有耐性!!");
    command("say 你要问我什么事呢??");
  }
}
