// blade.c
#include <weapon.h>
inherit BLADE;

void create() {
  set_name("乌钢刀", ({ "black blade", "blade" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 5000);
    set("material", "steel");
  }
  set("armor_prop/blade", 10);
  init_blade(30);
  setup();
}
