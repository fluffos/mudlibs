// short_sword.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIY "贯日剑" NOR, ({ "sun sword", "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 10000);
    set("material", "iron");
  }
  init_sword(75, SECONDARY);
  setup();
}
