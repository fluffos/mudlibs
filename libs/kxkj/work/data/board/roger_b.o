lude <forest.msg>inherit ROOM;void create () {        set (\"short\",\"魔森林\");        set (\"long\",(: print_forest_msg :));","author":"小岚耍笨版(any)","time":885270459,"title":"...",]),(["msg":"// forest.msg by konnstring *forest_msg = ({\"在这杂草丛生, 搞木凋零的森林里, 使你由心里面感到发毛, 好像处\\n\"+\"处草木皆兵, 但事实却是如此, 在这里一不小心很可能被妖怪们所吞\\n\"+\"食, 还是小心点好!\\n\\n\\n\\n\\n\",\"来到这里,你觉得四周的气氛突然凝重起来,似乎魔森林内的妖怪全聚\\n\"+\"集在这里,使你不敢再往前面通行,只想赶快离开这妖气深重的地方。\\n\\n\\n\\n\\n\",\"这里是魔森林深邃的内部,来到这里,你突然觉得心里更加发毛, 但好\\n\"+\"像又有一股不知名的吸引力,使你越想往内一探究竟。\\n\\n\\n\\n\\n\",\"妖魔咭咭怪笑的声音在你耳盼回荡良久，忽然一声巨响，四周寂静无\\n\"+\"比，接着在你眼前出现的，是一个极丑的怪物。\\n\\n\\n\\n\\n\",\"走到此只觉得寒气逼人，却不知这森林的出口在哪，委实令人感到担\\n\"+\"忧。前方一处明亮，莫非出口就在前面？赶紧加快脚步向前迈进吧!\\n\\n\\n\\n\\n\",\"四周树木长得特别异常，与其他地方的树似乎没什么两样，但却隐隐\\n\"+\"给人一股杀气般的力量，好像处处都蕴藏着危机。\\n\\n\\n\\n\\n\",\"越逼近森林内部你越觉得气血翻腾，你感到好像有某样东西向你袭击\\n\"+\"而来，却又觉得那只是幻影。听得远方鬼怪的哭叫声使你想要赶快离\\n\"+\"开这里。\\n\\n\\n\\n\\n\",\"四周灰蒙蒙的，什么也看不清楚，你感觉四周好像有妖怪在监视着你\\n\"+\"。一股寒风吹得你直打哆唆。\\n\\n\\n\\n\\n\",\"阴风徐徐的吹了过来, 又扫了过去, 令你对这次远征魔界的壮志悄悄\\n\"+\"的少了半截, 但事到如今除了前进已没有退路了, 倏的你头顶所戴的\\n\"+\"斗笠已被狂风吹得飞了老远, 为了天下苍生, 牺牲了性命也是值得的\\n\"+\", 二十年后又是条好汉, 没什么好怕的。\\n\\n\\n\\n\\n\",\"在这里, 除了一个冰冷的雕像, 和几棵长得张牙虎爪的榴树外, 四周\\n\"+\"静的令人发毛, 四处的景像都差不多, 想走出这座森林可真是相当困\\n\"+\"难, 还是想办法离开这里吧。\\n\\n\\n\\n\\n\",\"妖气重重的森林里, 使你不禁昏昏欲睡, 再加上远方及近处的妖怪哭\\n\"+\"号声, 更让你的精气神受到严重损害, 想不到世上真有这种鸟不生蛋\\n\"+\"的鬼地方, 四周情景让你愈加恐惧。\\n\\n\\n\\n\\n\",\"四周的妖怪不断的出现, 使你愈来愈难以应付, 抬头仰天长叹, 难道\\n\"+\"今朝真要在这森林里度过晚年吗? 或是被妖怪们分尸后死于尸骨无存\\n\"+\", 想到这里不禁捏了把冷汗, 更集中精神向前迈进。\\n\\n\\n\\n\\n\",\"在这种森林里, 最需要的就是同伴们相互间的照顾, 想必组队进入魔\\n\"+\"界应当比单独闯荡来的安全, 何必逞一时之勇呢? 听得远方一阵\"斗笠已被狂风吹得飞了老远, 为了天下苍生, 牺牲了性命也是值得的\\n\"+\", 二十年后又是条好汉, 没什么好怕的。\\n\\n\\n\\n\\n\",\"在这里, 除了一个冰冷的雕像, 和几棵长得张牙虎爪的榴树外, 四周\\n\"+\"静的令人发毛, 四处的景像都差不多, 想走出这座森林可真是相当困\\n\"+\"难, 还是想办法离开这里吧。\\n\\n\\n\\n\\n\",\"妖气重重的森林里, 使你不禁昏昏欲睡, 再加上远方及近处的妖怪哭\\n\"+\"号声, 更让你的精气神受到严重损害, 想不到世上真有这种鸟不生蛋\\n\"+\"的鬼地方, 四周情景让你愈加恐惧。\\n\\n\\n\\n\\n\",\"四周的妖怪不断的出现, 使你愈来愈难以应付, 抬头仰天长叹, 难道\\n\"+\"今朝真要在这森林里度过晚年吗? 或是被妖怪们分尸后死于尸骨无存\\n\"+\", 想到这里不禁捏了把冷汗, 更集中精神向前迈进。\\n\\n\\n\\n\\n\",\"在这种森林里, 最需要的就是同伴们相互间的照顾, 想必组队进入魔\\n\"+\"界应当比单独闯荡来的安全, 何必逞一时之勇呢? 听得远方一阵阵凄\\n\"+\"厉的哀号声, 霎时间心中的雄心壮志已去了一半。\\n\\n\\n\\n\\n\",\"抬头一看, 天色已由黄昏渐渐进入黑夜, 在你身旁数百步处, 有着一\\n\"+\"对对闪烁的怪眼直盯着你看, 看来夜晚比白天还要恐怖了数十倍呀, \\n\"+\"也较白天危险, 怪风一阵阵的吹来, 令你鸡皮疙瘩满地掉。\\n\\n\\n\\n\\n\",});string print_forest_msg(){   return forest_msg[random(sizeof(forest_msg))];   }","author":"小岚耍笨版(any)","time":885270585,"title":"forest.msg",]),(["msg":"#include <ansi.h>inherit NPC;int dec_kee(object);int do_set(object);void create() {        set_name(\"守林神兽\",({\"god beast\" , \"beast\", \"god\"}));        set(\"age\",5);        set(\"race\",\"野兽\");        set(\"gender\",\"雄性\");        set(\"no_kill\",1);        set(\"attitude\",\"friendly\");        set(\"combat_exp\",0);        set(\"env/invisibility\", \"YES\");        set(\"chat_chance\",50);        set(\"chat_msg\",({            HIB\"阵阵透骨刺寒的阴风吹过～～\\n\"NOR,      }));        setup(); }void init() {        object obj;        ::init();        if(interactive(obj=this_player())) {           dec_kee(obj);           do_set(obj);        } }int dec_kee(object obj) {        obj->add(\"gin\",-3);        obj->add(\"kee\",-5);        obj->add(\"sen\",-3);       return 1;}int do_set(object obj) {        object mob;        if(obj->query(\"race\") == \"野兽\") return 1;        if(obj->query(\"max_force\") < 1000 &&           obj->query(\"combat_exp\") < 300000) return 1;        switch(random(8)+1) {           case 1  : mob=new(\"/open/mogi/npc/mob1\");                     mob->move(environment(obj));                     break;           case 3  : mob=new(\"/open/mogi/npc/mob2\");                     mob->move(environment(obj));                     break;           case 5  : mob=new(\"/open/mogi/npc/mob3\");                     mob->move(environment(obj));                     break;           case 8  : mob=new(\"/open/mogi/npc/mob4\");       if(obj->query(\"race\") == \"野兽\") return 1;        if(obj->query(\"max_force\") < 1000 &&           obj->query(\"combat_exp\") < 300000) return 1;        switch(random(8)+1) {           case 1  : mob=new(\"/open/mogi/npc/mob1\");                     mob->move(environment(obj));                     break;           case 3  : mob=new(\"/open/mogi/npc/mob2\");                     mob->move(environment(obj));                     break;           case 5  : mob=new(\"/open/mogi/npc/mob3\");                     mob->move(environment(obj));                     break;           case 8  : mob=new(\"/open/mogi/npc/mob4\");                   mob->move(environment(obj));                     break;           default : break;        }        return 1;}","author":"小岚耍笨版(any)","time":885271122,"title":"beast.c",]),(["msg":"// mask.cinherit EQUIP;void create(){        set_name(\"变身披风\", ({\"cloak\"}) );	set_weight(1);        if(clonep())		set_default_object(__FILE__);	else {		set(\"unit\", \"个\");                set(\"value\", 0);                set(\"material\",\"steel\");                set(\"armor_type\",\"cloak\");                set(\"armor_prop/id\", ({\"evil ghost\"}) );                set(\"armor_prop/name\", ({\"魔石雕像\"}) );                set(\"armor_prop/short\", ({\"魔森林守护者\"}) );	}        set(\"no_drop\",1);        set(\"no_give\",1);        set(\"no_get\",1);        set(\"no_sell\",1);        setup();","author":"小岚耍笨版(any)","time":885271423,"title":"cloak.c",]),(["msg":"[32m:  Re: to roger -- 罗严塔尔(roger) 于 Jan 20: =============================================================: : to roger -- 善良天使(poloer) 于 Jan 19: : =============================================================: : roger..帮我把/u/p/poloer/ques/goroom.c修好: : 并加一点东...我的意思是pray完后给他东西完..就把那把钥匙销毁: : /u/p/poloer/ques/sunblade.c是你说的刀..请你加上技能: : /u/p/poloer/ques/key_room.c帮我设为只有钥匙才能进去: : 麻烦你了...上术的东西最做完..那炎龙谷就快完成了...: : :   /u/p/poloer/ques/goroom.c  销毁东西的技术我到现在还没成功\:   先放着吧...我正想办法解决: 