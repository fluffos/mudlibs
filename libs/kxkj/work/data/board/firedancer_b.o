(\"south\");        ob->move(exit[random(sizeof(exit))]);}        return 1; }","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36mnever mud's ip","time":997168993,"msg":"freeimage.adsldns.org 4000 ","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36mabout king 五区域","time":997536605,"msg":"金 /open/evil-area/d-08.c 木 /open/evil-area/d-05.c 水 /open/evil-area/d-01.c 火 /open/evil-area/d-11.c 土 /open/evil-area/d-14.c 木---obj(\"/open/evil-area/npc/obj/wood_stone.c\") ..包含移动函数水---obj(\"/open/evil-area/npc/obj/water_blood.c\") ..不包含移动函数土---obj(\"/open/evil-area/npc/obj/earth_board.c\") ..不包含移动函数目前全部取消移动功\能...记得补起来","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36mabout 结界虫","time":997536881,"msg":"/open/evil-area/npc/obj/worm.c  多重物件先消去random移位的功\能等房间全部做出来..再来判断random大小附注:物件需要结界内才能使用","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36m区域地图","time":997548437,"msg":"A 区 编号 01 ～ 40 入口 	进入/open/evil-area/water/enter.c 的地图                                               12 -- 33 -- (34)						|                             07 -- 09 -- 10 -- 11			      |     |           |		       04 -- 06 -- 08          13 -- 15 -- 16			|			|	    |<--尚未定案01 -- 02 -- 03		      (14)	   17 -- 21 -- (22)						|			            |		       05 -- 27 -- 28                19 -- 18			|	    |		      |		       35          29                20			|	    |		      |		       36	   30 -- 31          23 -- 24 -- 25 -- (26)			|  		  |	                  |			37 -- (38)       32 -- (39)             (40)","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36mhmm...","time":999766914,"msg":"我注意她很久了... 我注意她很久了，自从她闯入我的视线内，我的目光便深深受到她的吸引。我的眼 神始终离不开她娇小的身驱，无法自拔。 望着她低头思考的模样，我的心里是多么的想一窥她的思绪，想知道她的过去，想 知道她的成长，想知道有关她的一切，究竟是何种环境造就了她这般难以言喻的女 孩。 我，感觉到自己的心跳正随着她的一举手一投足，不断的加速，狂窜。她那谦谦玉 指，仿佛有着无比的魔力，轻易的夺去了我的魂，撩起我的冲动。天！我几乎快无 法控制自己。 她，终于有所决定，在我的注目下走我的面前。我不动声色，等待着她开口，天知 道我的内心是如此的激动。 果然，如我所料，她以优雅的嗓音缓缓说道‘多少钱？’ 我微微一笑‘十五元。’语毕，我熟练且飞快的操纵着收银机，将发票及一枚展新 发亮的五元硬币放到她的掌心。 ‘谢谢！’我和她如相互约定好了般，异口同声说道。 我望着她走出门口，同时，也走出我的生命的轨迹，我知道和她将不再有任何交 集。看着她的背影逐渐消逝在昏暗的路灯中。收回视线，我松了口气。不禁说道… 不禁说道… 请继续往下看~~~ 不禁说道‘妈的勒！三更半夜不睡觉零晨二点耶，跑来买乖乖？这还不打紧，前前 后后给我挑了30分钟。真不知道是什么环境才能造就出这么龟毛的个性。从大乖换 成小乖，再从小乖换成大乖，从五香、巧克力、奶油椰子一直换到日式咖哩。最 后…竟…竟…竟买了旁边的虾味先（辣味的喔）， 看着她的一举一动差点没忍住冲动上前去敲昏她，天知道她终于决定好来结帐时， 我的内心是多么的激动多么的爽快啊……","author":"哇系笑ㄟ(neverend)",]),(["title":"[1;32m[1;36mto firedancer","time":999773664,"msg":"看了你说的新东西50 one的mob而已吗???skill是ok了,whip 也是如果那个mob本来就是50 one,那也应该没问题(血多了点,不过没差)","author":"葛雷新(bss)",]),(["title":"[1;32m[1;36mmaster_snake","time":999957772,"msg":"我稍稍更动了一点点死时的code ...你再看看不合你意再改吧mark的部份是造成重覆的原因","author":"哇系笑ㄟ(neverend)",]),(["title":"[1;32m[1;36m金灵塔 木灵塔","time":1000111904,"msg":"我的区域中有五行灵塔金灵塔 /open/magic-manor/gold木灵塔 /open/magic-manor/wood底下的东西都制作好了  你看看吧  呵呵","author":"哇系笑ㄟ(neverend)",]),(["title":"[1;32mRe: 25[1;36m 金灵塔 木灵塔","time":1000183940,"msg":"[0;32m※ 引述《哇系笑ㄟ(neverend)》之铭言:: [0;36m我的区域中有五行灵塔: 金灵塔 /open/magic-manor/gold: 木灵塔 /open/magic-manor/wood: 底下的东西都制作好了  你看看吧  呵呵[0msorry neverend 我最近忙考试..so 很少能上线你就拜托bss帮你qc吧我想应该没问题啦...就看bss啰..hohoaddoil open area 靠你啰...^^[0m","author":"火神舞(firedancer)",]),(["title":"[1;32m[1;36mpig fire ...","time":1010566432,"msg":"我消失一阵子  你终于舍得出现啰  哈哈","author":"天堂玩的正疯(neverend)",]),(["title":"[1;32mRe: 27[1;36m pig fire ...","time":1010668351,"msg":"[0;32m※ 引述《天堂玩的正疯(neverend)》之铭言:: [0;36m我消失一阵子  你终于舍得出现啰  哈哈[0mㄎㄎ~ 你不是正在疯天堂吗??所以open 区域又没人开发啰以至于我才又回来了阿 >\"< (ㄎㄎz~没啦...开玩笑的啦~我考完试,所以上来轻松一下啦 ^^ )不过时间,如果没有出什么意外的话应该会有空回来帮忙写一些东西^^[0m","author":"火神舞(firedancer)",]),(["title":"[1;32mRe: 27[1;36m pig fire ...","time":1010841076,"msg":"[0;32m※ 引述《天堂玩的正疯(neverend)》之铭言:: [0;36m我消失一阵子  你终于舍得出现啰  哈哈[0mcow...阿你咧...你也失踪很久了吧...--                         [1m[37m超级  [1m[31m大恶魔 [1m[32m傅[1m[36m剑[1m[33m寒[0m[0m","author":"傅剑寒(cgy)",]),(["title":"[1;32mRe: 29[1;36m pig fire ...","time":1011355458,"msg":"[0;32m※ 引述《傅剑寒(cgy)》之铭言:: [0;36m※ 引述《天堂玩的正疯(n