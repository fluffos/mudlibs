{second = 1};#math second {@second * 10};};#math second { @second +  %pos(@str,@num) /2};#add i 2;};max = %max(@first,@second);min = %min(@first,@second);ans = 1;#while (@ans <> 0) {ans = %mod(@max,@min);max = @min;min = @ans;};answer @max}#tri {冰判官说道: (%x)乘上(%x)，个位数等于多少？} {num = \"十一二三四五六七八九\";#math len {%len(%1) -2};str = %right(%1,@len);#math first {%pos(@str,@num) /2};#math len {%len(%2) -2};str = %right(%2,@len);#math second {%pos(@str,@num) /2};#math ans {@first * @second};ans = %mod(@ans,10);answer @ans}#tri {冰判官说道: (%x)乘上(%x)等于多少？} {num = \"十一二三四五六七八九\";#if (%pos(\"个位数\",%2) = 0) { len = %len(%1);#var i 1;#var first 0;#while (@i < @len) {str = %copy(%1,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {first = 1};#math first {@first * 10};};#math first { @first +  %pos(@str,@num) /2};#add i 2;};len = %len(%2);#var i 1;#var second 0;#while (@i < @len) {str = %copy(%2,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {second = 1};#math second {@second * 10};};#math second { @second +  %pos(@str,@num) /2};#add i 2;};#math ans {@first * @second};#sh A => %1 B => %2;answer @ans}}#tri {冰判官说道: (%x)除以(%x)余于多少？} {num = \"十一二三四五六七八九\";len = %len(%1);#var i 1;#var first 0;#while (@i < @len) {str = %copy(%1,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {first = 1};#math first {@first * 10};};#math first { @first +  %pos(@str,@num) /2};#add i 2;};len = %len(%2);#var i 1;#var second 0;#while (@i < @len) {str = %copy(%2,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {second = 1};#math second {@second * 10};};#math second { @second +  %pos(@str,@num) /2};#add i 2;};ans = %mod(@first,@second);answer @ans}#tri {冰判官说道: (%x)减去(%x)等于多少？} {num = \"十一二三四五六七八九\";len = %len(%1);#var i 1;#var first 0;#while (@i < @len) {str = %copy(%1,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {first = 1};#math first {@first * 10};};#math first { @first +  %pos(@str,@num) /2};#add i 2;};len = %len(%2);#var i 1;#var second 0;#while (@i < @len) {str = %copy(%2,@i,2);#if (%pos(@str,\"十\")) {#if (@i = 1) {second = 1};#math second {@second * 10};};#math second { @second +  %pos(@str,@num) /2};#add i 2;};#math ans {@first - @second};answer @ans}","to":"limit","from":"狂练(sas)","time":1006850386,]),(["title":"fs大部分迷","text":"[36m                      FS 大部分的迷[0m[31m卖火材的小女孩     [0m    recall d give cloth to girl[31m农妇的便当[0m    waveto 5 2w ask woman about 便当    s 2e 6s 2w give bento to farmer[31m失落的红宝石[0m    waveto 5 2e n ask woman about 红宝石    waveot 1 6n give any stone[31m展伯承的烦恼     [0m    waveto 2 2n enter 2n w give 500 coin to guard    左侍卫给你一张搜索令.    waveto 2 2s 3e     give su_note to keeper    search 地板    show keeper blood 会跟客栈老板开打    客栈老板晕了或打死后  get all from corpse    w 3n w give picture to chen[31m赌神秘术 [0m  1.recall d n 2w 2s      ask man about 赌神秘术    ask man about 轩辕三光  2.waveto 5 n n sw    ask guan about 赌神秘术    answer yes    answer 正    轩辕三光说道: 哈! 不是反面, 妳猜正面就错了    多跟他玩几次    kill guan    search d search get book[31m经世奇才之神算诸葛[0m  1.in 圣贤书    ask sue about 雪苍山下  2.in 刘全书    s 2d read picture[31m恶人证明[0m 1.wa 4 n n w search n n pass rattan n n out    看见司马烟 (PS:fanset 7) 2.ask yen about 恶人证   ask yen about 燕南天  3.wa 4 n w   ask harlot about 水仙姑娘   ask harlot about 移花宫   ask hoodlum about 恶人谷 4.wa 1 s s s e e e n   ask dipi about 燕南天   ask dipi about 哭风坡 5.waveto 4   buy map from girl   read map 6.wa 3 e e e e e n   buy teapot from man     ask man about 燕南天   ask man about 蒙汗药   buy teapot from man   kill man 7.get paper open paper   put powder in teapot   send teapot to day  (燕南天死了) 8.get corpse waveto 7(回到司马烟那)   give corpse to yen炼妖壶之谜 及 老妇人的伤心事(通常这两个迷都是一起解的)[31m炼妖壶之谜(combat_exp 20000以上比较好解)[0m  1.从金刀门王元霸那开始 (save后 waveto 6 就是这里)    e 2n 2w 2s search shief 得到papyrus  2.2n 2e 2s e s ask liu about 借补虫网 拿到net  3.n w 2n 3w cover butterfly     抓到后give butterfly to girl  4.3e 2s e s give net to liu    它会说大小姐会解疑难杂症    n w 2n 4w s open door w     男的话会进不去,此时去找巧儿(n,e),她会带你去  5.ask leing about 翻译    ask leing about 古文书    give papyrus to leing  翻译完后会给你note  6.waveto 6 ask ba about 炼妖壶    n w 2n 4w n w     search statue move statue (PS:fanset 7)    break box (出现要龙虎刀之讯息)  7.ask ba about 龙虎刀    ask ba about 陈元贵  8.(到仙剑郑士钦那)in teng s s s s w w w     enter n n  见到陈元贵(fanset 8)  9.ask yuan about 金刀门      ask yuan about 龙虎刀    会战斗小让他别打死他,他会给你龙虎刀    waveto 6 give blade to ba       waveto 7 break box look box 10.give blade to ba     ask ba about 炼妖壶   waveto 8    ask yuan about 炼妖壶      ask yuan about 紫金六阳刀法    ask ba about 陈元贵       ask ba about 陈元贵 waveto 8 11.到魔教庄敬柔那 s sd     ask envoy about 锦袋  nod 2e     ask elder about 石牢(这边要有先问过老妇人的迷)    s ask envoy about 钥匙 fight envoy(get key)    原则上只要把他打到黄血他就会给你key    如果你攻击力太强 wp 用 fireger or icefan    fight 后猛吸气 利用 wp 特攻打他会比较好拿 12.n w se se e ed (fanset 9)    unlock north with key   open north    n  look box   push box   search hole (get lotch)    give lotch to ba (解完炼妖壶之谜) [31m老妇人的伤心事[0m  1.waveto 5 4n 3w sw s  fanset 8    ask woman about 儿子    nod (老妇人说等你的消息)  2.waveto 9 (听到赵青云说找envoy拿钥匙)    wu w nw nw e n     ask envoy about 钥匙    fight envoy(get key)     原则上只要把他打到黄血他就会给你key    如果你攻击力太强 wp 用 fireger or icefan    fight 后猛吸气 利用 wp 特攻打他会比较好拿    unlock south with key  open south  s    ask 赵青云 about 帮忙    waveto 8 give woman jade[31m京城大盗(combat_exp 100000以上再解)[0m   1.waveto 1 3s w n enter 2n  (fanset 7)     ask chi about thief      accept test   2.waveto 1 3s     ask fighter about thief     show fighter     ask fighter about thief (得知scar)   3.到段云那 (save后能waveto 6 )     ask duan about thief     ask duan about scar   4.waveto 2 2n enter 3n     ask pin about liu     ask liu about sad_story   5.waveto 6  ask duan about chao     s w 3s unlock door with key     open door s search box     take firecracker  waveto 6     ask duan about firecracker   6.waveto 1 4n nu fire firecracker     (会一直跑...)停了后 search bush(search)   7.3e ask thief about chao     ask chao about thief     会战斗      1.forgive  选择是pill(add max_force 20)或是sword     2.杀死chao get corpse  waveto 7       give corpse to chi[31m血的挑战书及青龙之气[0m[31m血的挑战书(combat_exp 200000以上)[0m  1.到圣贤书那里(save)    ask sue about 挑战书    ask sue about 困扰    ask sue about 因此    nod他会给你挑战书  2.waveto 4,4n,2e,climb pine,3u,w    干掉雪魂...(最好enforce 10以上)    不容易打死  要多打几次    最好是主力攻击的skills  lv 80以上  3.打死后去找圣贤书那里(waveto 6)     他就给你青龙之笛    挑战书就解了    在拿着青龙之笛到雪魂那..use de    青龙之气也解了[31m仙云之气(解完青龙即可解)[0m  1.in刘全书 4n 3w n     tear fon papers (出现一堆snow guard  最好教别人撕)    open box (get poet book)    s enter road n w 2e n e 2w 洋平杀死    searcy eye  get snow token(被拿走了请找人sac or auc)  2.in刘全书 4n 2w 3n enter w n (fanset 7)    give dugur poet book...    独孤云说道: 为了感谢你的帮助!!我就告诉你二个秘密!!!    独孤云说道: 一、刘全书及任正晴曾在玄天圣谷中修习更上层的绝学!!!    独孤云说道: 二、泷山掌门练有传说中的仙云灵气!!!  3.ask dugur about 天灵石      说拿天邪石去换    天邪石拿法        ask liu about 有缘人    say 黄云    say 复活邪神    say 陈蝶衣    他就会给你,一只char 只能拿一次    如果他没给你,在login new char 再问一次就ok    give stone to dugur    in master liu s 2d 2w enter water    2n w enter hole    2n search dragon     use sky_lin_stone   put sun    n stand 平台  仙云之气就解    (请打Help god_kee及sec_god看说明) [31m雪泉之谜   [0m   1.in刘全书 4n 3w enter road n w 2e n e 2w 洋平杀死     searcy eye  get snow token(被拿走了请找人sac or auc)     out w w enter water n n w drink water[31m魔刀现世(加max_force 100)[0m  1.in 刘全书 s d d w kil1 taoist get sword from corpse  2.get 天邪石    天邪石拿法        ask liu about 有缘人    say 黄云    say 复活邪神    say 陈蝶衣  3.in 刘全书 4n e enter n u 9 w push key    give stone sword to oldman[31m武林浩劫[0m    叶狂的放法    in jen 2e s d n 玄武,青龙,青龙    k jen, get key ,unlock door with key ,open door    n d 坤卦,兑卦,坤卦k jen..get key..unlock door with key,open door    n k jen.. get key..unlock north with key,open north...    n.打 free ya..ya就会出来了 u 可以出去    要先被roar 过..ya 会roar 人    ya出来的地点是wa 4 2n 3w    固定地点..要快点拦截..不然就跑了    杀死后 in jen    ask jen about about 叶狂    give jen ya-head... ok[31m镜月岛之谜 (exp最好500以上)[0m    wa 1 n e ask linr about 镜月岛之谜    ask linr about 王妈    wa 10 3s 2w n ask woman about 水灵儿    wa 1 n e ask linr about 上代宫主     wa 1 n底 e(一定要有能力走道那)    ask king about 月半弯 king 会auto kill(要快跑,不然铁死)    找人帮你打天子 他昏时在ko他 他会给你一封信(king's letter)    wa2 n w 2n 2w 2n 2w n wu 2eu n底 jump lake n give yuaa king's    wa1 n底 e give king yuaa's letter..ok          ","to":"limit","time":1015562600,"from":"涟漪(amdxp)",]),})
