string chinese_number(int i) {
  return (string)CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return (string)CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md #15h: this was a GBK lead-byte range check (str[0] > 160
  // && str[0] < 255), meaningful only when str[0] was a raw byte (0-255).
  // On this driver str[0] is a full Unicode codepoint, so the old test
  // was always false for real Chinese text. Use a CJK codepoint range
  // check instead. Also: strlen>=2 used to mean "at least one full
  // 2-byte GBK char present"; under UTF-8 char-counting that would
  // wrongly reject a single trailing Chinese character, so drop it to
  // >=1 (any non-empty string).
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
