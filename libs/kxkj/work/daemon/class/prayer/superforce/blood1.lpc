#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target) {
  object ob;
  int age = me->query("age", 1);
  int lv1 = me->query("functions/blood/level");
  int lv = me->query_skill("superforce", 1);
  int hurt_value = lv1 * age / 4 + lv * age / 8;
  if (hurt_value > 1000) hurt_value = 1000;

  if (!target) target = offensive_target(me);

  if (lv1 < 35)
    return notify_fail("你的[31m血穹苍[0m练的不够纯熟，无法催运出[31m穹苍气劲[0m，须35级。\n");
  if (me->query_skill("superforce", 1) < 200)
    return notify_fail("你浑天宝鉴心法的火侯尚未足够，须200级。\n");

  if (!(ob = me->query_temp("weapon"))) {
    if (me->query_temp("secondary_weapon"))
      return notify_fail("必需放弃身上的武器才能将[31m穹苍气劲[0m化为[31m血海无涯[0m!!\n");
  }
  if (ob = me->query_temp("weapon")) {
    if ((string)ob->query("skill_type") != "unarmed")
      return notify_fail("必需空手才能将[31m穹苍气劲[0m聚于双掌之上!!\n");
  }
  if (me->query("force") < 500)
    return notify_fail("你的内力不够。\n");
  if (me->query("kee") < 180)
    return notify_fail("你的气不够。\n");

  if (!me->is_fighting(target)) {
    tell_object(me, "[31m血海无涯[0m唯在战斗中才能使用。\n");
    return 1;
  }
  message_vision(
    "\t只见$N身旁的[31m血红色蒸气[0m越来越浓厚!!\n\t之后$N大喝一声, [31m穹苍内劲[0m豁然聚于双掌之上!!\n\n",
    me,
    target
  );
  message_vision("$N双掌一连发出数招[31m「血海无涯”[0m, 将敌人的全身周围布满了[31m穹苍气劲[0m！\n", me, target);

  me->add("kee", -(hurt_value / 20));
  me->add("force", -(hurt_value / 4));
  if (70 > random(100)) {
    message_vision(
      "$n将全身周围守的密不透风，企图接下这一击，无奈[31m穹苍气劲[0m似有还无，仍被拍中数掌，霎时高热的血焰窜流$n的全身！！\n",
      me,
      target
    );
    message_vision(NOR, me);
    target->receive_damage("kee", hurt_value);
    target->add("force", -hurt_value / 5);
    COMBAT_D->report_status(target);
  } else {
    message_vision("$n以全身的内力与[31m血穹苍气劲[0m互斗，”澎””砰”之声不绝于耳，交手过后$N被震的受了内伤。\n", me, target);
    message_vision(NOR, me);
    target->receive_damage("kee", hurt_value / 10);
    target->add("force", -hurt_value / 12);
    COMBAT_D->report_status(target);
  }
  message_vision("[31m「血海无涯”[0m使出后，$N内力大量耗损、经脉不顺，$N立刻盘坐在地运息调理\n", me, target);
  me->start_busy(1);
  if (lv1 < 150) function_improved("blood", random(500));
  message_vision(NOR, me);
  return 1;
}
