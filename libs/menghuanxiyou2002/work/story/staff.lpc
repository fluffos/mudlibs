#include <ansi.h>

string give_gift();

private mixed *story = ({
        "……",
        "",
        "观音：孙悟空，你这个畜牲，你本来答应如来佛祖护送你师傅唐三藏去取西经的，你居然跟牛魔王串通要吃你师傅，你知不知道你犯了弥天大罪？",
        "孙悟空：少罗嗦！你追了我三天三夜，因为你是女人我才不杀你，不要以为我怕了你！",
        "唐僧：悟空，你怎么可以这样跟观音姐姐讲话呢？",
        "悟空：哗！不要吵！",
        "唐僧：你又在吓我！",
        "观音：你不是怕我又为什么要打伤紫霞仙子抢她的月光宝盒呢？你不就是想躲开我吗？",
        "悟空：既然躲不了，那老孙就跟你绝一死战！",
        "悟空将月光宝盒随手一抛，正好砸在唐僧头上……",
        "唐僧迷惑道：“咦？”又要干什么？",
        "猴子正要动手，突然……",
        "唐僧：唉唉唉，大家不要生气，生气会犯了嗔戒的！悟空你也太调皮了吧。",
        "唐僧：我跟你说过，叫你不要乱扔东西。乱扔东西这么多……你看我还没说完呢，你把棍子又给扔掉了！",
        "唐僧：月光宝盒是宝物，你把它扔掉会污染环境。唉，要是砸到小朋友呢，怎么办？",
        "唐僧：就算没有砸到小朋友，砸到那些花花草草也是不对的呀",
        "众人狂喷鲜血……",
        "悟空一把抓住唐僧手中的月光宝盒",
        "唐僧：干什么？",
        "悟空：放手，把东西给我！",
        "唐僧：你想要啊？悟空，你想要的话你就说话嘛。你不说我怎么知道你想要呢？虽然你很有诚意地看着我",
        "唐僧：可是你还是要跟我说你想要的。你真的想要吗？那你就拿去吧！你不是真的想要吧？难道你真的想要吗？……",
        "悟空：我Kao！说罢一个猴拳将唐僧打的鼻口喷血。",
        "观音：啊？孙悟空！！！你！！！",
        "悟空：大家看到啦？这个家伙没事就长篇大论婆婆妈妈叽叽歪歪，就好象整天有一只苍蝇，嗡……",
        "悟空：不是一只，是一堆苍蝇围着你呀，嗡…嗡…嗡…嗡…飞到你的耳朵里面。救命啊！救命啊！",
        "悟空倒地翻滚，异常痛苦……",
        "悟空：所以呢我就抓住苍蝇挤破它的肚皮把它的肠子扯出来再用它的肠子勒住它的脖子用力一拉，呵·￥￥·#",
        "悟空：整条舌头都伸出来啦！我再手起刀落，哗－－！整个世界清净了。现在大家明白，为什么，我要杀他！",
        "观音：哼！悟空，你诸多借口，你根本就不想去取西经！",
        "唐僧：姐姐，这是你的不对了！",
        "观音菩萨迷惑道：“咦？”",
        "唐僧：悟空他要吃我，只不过是一个构思，还没有成为事实，你又没有证据，他又何罪之有呢？",
        "唐僧：不如等他吃了我之后，你有凭有据，再定他的罪也不迟啊！",
        "观音：三藏，你罗嗦我早就听说过了，不过没想到你居然这么罗嗦！我给你的紧箍咒制伏这猴子你居然不用！",
        "唐僧：唉，那个金刚圈尺寸太差，前重后轻左宽右窄，他带上之后很不舒服，整晚失眠，会连累我嘛！",
        "唐僧：他虽然是个猴子，可是你也不能这样对他，官府知道了会说我虐待动物的！",
        "唐僧：那紧箍咒，啊，去年我在陈家村认识了一位铁匠，他手工精美、价钱又公道、童叟无欺，干脆我介绍你再定做一个吧！",
        "观音：闭嘴！三藏秃驴",
        "悟空和观音同时伸手去掐唐僧的脖子，刚一掐着，观音才猛然惊觉，急忙缩回手去。",
        "观音：罪过罪过！",
        "悟空：现在你也体会我的痛苦了吧？回答我！",
        "观音：泼猴，今天我要替天行道！",
        "悟空：臭三八，说那么多废话干嘛，吃我一棒！",
        "两人一番斗法，悟空被观音降服收入甘露瓶。",
        "观音：今天我要将这泼猴身首异处。",
        "唐僧：徒弟有错做师傅的也有责任，求姐姐放他一条生路吧",
        "观音：我不消灭他我没法向玉皇大帝交代！",
        "唐僧：我不会使你为难的。请观音姐姐跟玉皇大帝说一声，贫僧愿意一命赔一命！正所谓我不入地狱谁入地狱？",
        "唐僧：求姐姐你体谅，我这样做，无非是想感化劣徒，以配合我佛慈悲的大无畏 精神啊！",
        "喃呒阿弥陀佛，唐僧合十坐地，将法杖向空中一抛。",
        "一声杀猪般的叫声传来……法杖将某人砸死。",
        "…………",
          (: give_gift :),

});

void create()
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

string give_gift()
{
        STORY_D->give_gift("/clone/gift/staff", 1,
                           HIM "\n“轰”的一声根[1;33m九环锡杖[2;37;0m掉到你面前。\n\n" NOR);//我的形容词不错吧.(snicker)
        return HIM "听说某人得到了传说中的[1;33m九环锡杖。\n" NOR;

}
