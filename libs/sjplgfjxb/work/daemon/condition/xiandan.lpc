//xiandan.c 无极仙丹毒 written by john darks
#include <ansi.h>
int update_condition(object me, int duration) {
  object *inv;
  int i;
  me->apply_condition("xiandan", duration - 1);
  if (duration < 1) {
    tell_object(me, HIR "你只觉一股热力直冲顶门！\n" NOR);
    me->unconcious();
  }
  if (duration < 3) {
    tell_object(me, HIR "你感觉体内的一股力量似乎要爆发出来了！\n" NOR);
    if ((int)me->query("mojiao/xiandan") < 3 && (int)me->query("max_force") < 5000)
      me->add("max_force", random(20));
    else
      me->add("force", random(60));
  } else if (duration < 4) {
    tell_object(me, HIR "你脑子里现在只有一个念头．．．．\n" NOR);
    if (me->query("gender") == "女性")
      message("vision", HIG + me->name() + HIG "发出令人想入非非的呻吟声，不停的喘息着。\n" NOR, environment(me), me);
    else
      message(
        "vision",
        HIR + me->name() + HIR "喉咙发着野兽般的吼声，眼光似乎在四处搜索着什么。\n" NOR,
        environment(me),
        me
      );
    inv = all_inventory(environment(me));
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("gender") == "男性" && userp(inv[i])
        && me->query("gender") == "女性") {
        message_vision(
          HIG "$N" + HIG "“嘤咛”一声扑入了$n" + HIG "怀里，$n" + HIG "登时不知所措。\n" NOR,
          me,
          inv[i]
        );
        me->apply_condition("xiandan", duration - 1);
        break;
      } else if (inv[i]->query("gender") == "女性" && userp(inv[i])
        && me->query("gender") == "男性") {
        message_vision(HIR "$N" + HIR "低吼一声扑向了$n" + HIR "，登时把$n" + HIR "吓得尖叫起来。\n" NOR, me, inv[i]);
        me->apply_condition("xiandan", duration - 1);
        break;
      } else me->apply_condition("xiandan", duration);
    }
  } else if (duration < 6) {
    tell_object(me, HIR "你再也难以控制自己，疯狂撕抓自己。\n" NOR);
    message(
      "vision",
      HIR + me->name() + HIR "目光如赤，发狂般的撕抓自己，喉咙发出野兽般的吼声。\n" NOR,
      environment(me),
      me
    );
    me->receive_wound("kee", 40, me);
    me->receive_wound("gin", 40, me);
    me->receive_wound("sen", 40, me);
  } else if (duration < 7) {
    tell_object(me, HIR "你感觉难以自制，开始脱自己的上衣。\n" NOR);
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped") == "worn") {
        inv[i]->move(environment(me));
        message_vision(sprintf("$N丢下一%s$n。\n", inv[i]->query("unit")),
          me, inv[i]);
        me->save();
      } else continue;
    }
    message("vision", HIR + me->name() + HIR "目光如火，全身发红。\n" NOR, environment(me), me);
    me->receive_wound("gin", 30, me);
    me->receive_wound("sen", 30, me);
  } else if (duration < 8) {
    tell_object(me, HIR "你神情恍惚，不时的想入非非！\n" NOR);
    message("vision", HIR + me->name() + HIR "喃喃自语，双颊发红。\n" NOR, environment(me), me);
    me->receive_wound("gin", 20, me);
    me->receive_wound("sen", 20, me);
  } else if (duration < 9) {
    tell_object(me, HIR "你突然全身火烫，神情恍惚！\n" NOR);
    me->receive_wound("sen", 10, me);
  } else if (duration < 10)
    tell_object(me, HIR "你突然感到舌干口躁，全身发热！\n" NOR);
  if (duration < 1)
    return 0;
  return 1;
}
