// force_disease

#include <ansi.h>

int update_condition(object me, int duration)
{
	mapping myskill;
	int i;
      	string *dirs;
        myskill = me->query_skills();
	if( !myskill ) return 0;
       	dirs = keys(myskill);
       	for (i=0 ; i<sizeof(dirs); i++){
       		if (me->query_skill(dirs[i],1) > 4) //4 level
				me->decrease_skill(dirs[i], 1);
				me->set("force", 0);
			if( me->query("max_force") >1 )
				me->add("max_force", -1);
       		else 
       		if (me->query_skill(dirs[i],1))
			{
       			me->map_skill(dirs[i]);	//相当于放弃 但必须事先enable none 不然可能有bug
       						//abandon指令没有这一步
       			me->delete_skill(dirs[i]); 
       			me->reset_action();
       		}
       	}
	me->apply_condition("force_disease", duration - 1);
        if( duration < 1 )
	{
	tell_object(me, HIW "你散去了一部分武功，才渐渐平静下来。。。\n" NOR );
//	me->set_temp("force_disease",1);
	return 0;
	}
	else{
	tell_object(me, HIM "你身上戾气太重，已经走火入魔了！\n" NOR );
	tell_object(me, HIR "你突然感到奇经八脉一阵扭曲，不禁全身痛苦地颤抖起来！\n" NOR );
	}
	return 1;
}
