string *dodge_msg = ({
	"只见$n身影一晃，早已避在七尺之外。\n",
	"$n右步一踏，轻轻松松地闪过。\n",
	"$n身子随着$N的攻势，轻轻一退，已化解来势。\n",
});

string *parry_msg = ({
	"$n左手手指一弹，$v飞击$N破绽，逼得$N不得不收势。\n",
	"$n手中的$v直击$N破绽，逼得$N不得不收势。\n",
});

string *unarmed_parry_msg = ({
        "$n双手一旋，化出一道气墙，挡住了来势。\n",
});


int valid_learn(object me)
{
        int lvl;
        if( (int)me->query_skill("force", 1) < 20 )
                return  notify_fail("你的内功心法火候不足，无法练金陵十八卦。\n");
        if( (lvl = (int)me->query_skill("thforce" ,1) )< 10 )
                return	notify_fail("你的天和内气火候不足，无法练金陵十八卦。\n");
        lvl = me->query_skill("jl-shibagua",1);
        if (lvl > me->query_skill("perception",1))
		return notify_fail("你听风辨位能力太低，无法练金陵十八卦。\n");
	return 1;
}

int practice_skill(object me)
{
	int lvl = me->query_skill("jl-shibagua",1);
	if (lvl> me->query_skill("betting",1))
		return notify_fail("你赌术不够高，不能练这门武功。\n");
	if( (int)me->query("kee") < 40 )
		return notify_fail("你的体力不够练这门武功，还是先休息休息吧。\n");
	me->receive_damage("kee", 40);
	return 1;
}

int valid_enable(string usage)
{
	object me = this_player();
	int lvl = me->query_skill("jl-shibagua",1);
	if (lvl < 51)
		return (usage=="unarmed")|| (usage=="dodge") || (usage=="parry") ;
	else return (usage=="unarmed") || (usage=="parry") || (usage=="throwing")|| (usage=="dodge");
}

int effective_level() { return 12;}

mapping query_action(object me, object weapon)
{
	mapping action1;
	int lvl = me->query_skill("jl-shibagua",1);
	int i = 0;
	object target = me->query_temp("last_opponent");
	
	weapon = me->query_temp("weapon");
	if(objectp(weapon)){
		if ((int)me->query_temp("wangsha/jl18")==1)
			action1 = action[18];
		else if ((int)me->query_temp("wangsha/jl18")==2)
			action1 = action[19];
		else if (lvl<101)
			action1 = action[random(8)+9];
		else    {
			if (random(lvl)>80) i=17;
			else 	i = random(9)+9;
			action1 = action[i];
		}
		throw_weapon(me,weapon,action1["amount"]);
		if (i==17){
			me->set_temp("wangsha/jl18",1);
			COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 2 );
			me->set_temp("wangsha/jl18",2);
			COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 2 );
			me->set_temp("wangsha/jl18",0);
		}
		return action1;
	}
	else {
		if (lvl<101 )
			return action[random(7)];
		else 	return action[random(9)];
	}
}

string query_dodge_msg(string limb)
{
	object me = this_player();
	object *enemy = me->query_enemy();
        object ob,weapon1;
        int i;
        for (i = 0; i< sizeof(enemy);i++){
        	if ( enemy[i] == me->query_temp("last_opponent")){
        		ob = enemy[i];
        		weapon1 = ob->query_temp("weapon");
        	}
        	else continue;
        }
        if (ob && ob->query_busy()>2 )	ob->start_busy(2,1);
        
	return dodge_msg[random(3)];
}

string query_parry_msg(object weapon)
{
        object me = this_player();
        object *enemy = me->query_enemy();
        object ob,weapon1;
        int i;
        for (i = 0; i< sizeof(enemy);i++){
        	if ( enemy[i] == me->query_temp("last_opponent")){
        		ob = enemy[i];
        		weapon1 = ob->query_temp("weapon");
        	}
        	else continue;
        }
        if( weapon1 && ob ){
        	if (weapon1->query("skill_type")=="throwing"){
        		throw_weapon(ob,weapon1,1);
                	return parry_msg[0];
                }else return parry_msg[1];
        }else  return unarmed_parry_msg[0];
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	object me = this_player();
	int lvl = (int)me->query_skill("jl-shibagua",1);
	if (lvl < 101)
		return 50;
	else return -50;
}
int black_white_ness()
{
	return 20;
}

void skill_improved(object me)
{
	int s;
        s = me->query_skill("jl-shibagua", 1);
        if (s == 0) return ;
        if (s == 1){
        	tell_object(me, HIW"\n金陵十八卦是王乞儿从天和道人的散手八扑领悟而来，威力不凡！\n"NOR);
        	tell_object(me, HIW"据说这种武功有十八种变化，在拳脚、轻功中融入了赌术的奥义！\n\n"NOR);
        	tell_object(me, HIW"如果你轻功到家，更可以施展传说中的草上飞(Perform Caoshangfei)轻功！\n\n"NOR);
        }
        if (s == 51)
        	tell_object(me, HIW"由于你苦练武功，领悟了应用于暗器的变化！\n\n"NOR);
        if (s == 101)
        	tell_object(me, HIW"由于你苦练武功，领悟了将赌术融入拳脚、暗器的诀窍！\n\n"NOR);
}

void throw_weapon(object me, object weapon, int amount)
{
        amount = 0 - amount;
        if( objectp(weapon) ) {
                if( (int)weapon->query_amount() + amount <= 0 ) {
                        weapon->unequip();
                        tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
                        weapon->set_amount(0);
                }else   weapon->add_amount(amount);
        }
}
