// 七行玄灵剑法

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N身形一展, 口中吟道：天有情, 手中$w如连绵不绝的情丝, 一圈圈向$n缠了过去",
                "dodge":                -30,
                "parry":                -20,
                "damage":               30,
                "damage_type":  "刺伤"
        ]),
        ([      "action":    
"$N右手剑向左一个虚指, 轻嗬道：天作雨, 猛然间剑光大盛, 便如万点寒雨攻向$n",
                "dodge":                -30,
                "parry":                -20,
                "damage":               50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N向前虚踏一步, 剑光暴长, 化作满天星斗, 打向$n", 
                "dodge":                -30,
                "parry":                -20,
                "damage":               40,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N大喝一声：「天怒」, 手中$w便如漫天黄沙, 源源不断地功向$n",
                "parry":                -50,
                "dodge":                -50,
                "damage":               100,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N运剑入风, 手里$w从上至下从下至上从左至右从右至左迅绝无伦的划了九下, 便如"
"无数电光闪过长空" ,               
                "dodge":                -20,
                "parry":                -50,
                "damage":               50,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N使一招「天光乍亮」, 手中$w舞成一团寒芒, 罩向$n",
                "dodge":                -30,
                "parry":                -10,
                "damage":               30,
                "damage_type":  "割伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练七行玄灵剑法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习七行玄灵剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍七行玄灵剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("kongtong") + "/qxxl-sword/" + action;
}

string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 20;}
int learn_bonus()
{
	return -30;
}
int practice_bonus()
{
	return -30;
}
int black_white_ness()
{
	return -30;
}


 