// zhengqi-force.c

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{ return 1;}

int practice_skill(object me)
{
	int skill,combat_exp;

	combat_exp=(int)me->query("combat_exp");
	skill=(int)me->query_skill("huashan-force", 1);

	if( skill*skill*skill/10 > combat_exp )
       	  return notify_fail("你的实战经验不够，无法练习华山心法。\n");

        if( (int)me->query("gin") < 30 )
                return notify_fail("你的精力不够！\n");
        me->receive_damage("gin", 30);
        return 1;
}
string exert_function_file(string func)
{
	return CLASS_D("huashan") + "/huashan-force/" + func;
}
int effective_level() 
{
	if (this_player()->query("class") == "huashan-sword")
		return 14;
	else
		return 10;
}

int learn_bonus()
{
	if (this_player()->query("class") == "huashan-sword")
		return -10;
	else 
	        return -5;
}
int practice_bonus()
{
        return 10;
}
int black_white_ness()
{
        return 0;
}