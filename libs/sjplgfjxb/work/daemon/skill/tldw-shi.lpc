//天罗地网势
#include <ansi.h>

inherit SKILL;
mapping *action = ({
    ([  "action":       "$N全身拔地而起，空中一个转身，一招「嫦娥奔月」，手指抓向$n的$l",
		"dodge":		5,
		"parry":		5,
        	"force":	120,
        "damage_type":  "内伤"
	]),
    ([  "action":       "$N倏地一个转身，双拳齐出,一招「玉兔东升」直击$n$l",
       		"dodge":		10,
		"parry":		10,
		"force":		90,
		"damage_type":	"内伤"
	]),
    ([  "action":       "$N身形向后一仰，随即跨出一步，右手忽隐忽现地使出「天罗地网」，拍向$n的$l",
		"dodge":		-30,
		"parry":		-40,
		"force":		150,
		"damage_type":	"瘀伤"
	]),
    ([  "action":       "$N左手幽幽使出一招「逢场作戏」，右手顺势推出，对准$n的$l猛击",
		"dodge":		20,
		"parry":		-20,
		"force":		90,
        "damage_type":  "内伤"
	]),
    ([  "action":       "$N右手飘飘，一招「红杏出墙」击向$n$l",
		"dodge":		-20,
		"parry":		 30,
		"force":		80,
		"damage_type":	"内伤"
	]),
    ([  "action":       "$N使出「捕风捉影」，凌空跃起，对准$n$l连击数拳",
		"dodge":		-70,
		"parry":		-40,
		"force":		100,
		"damage_type":	"内伤"
	]),
    ([  "action":       "$N右手往$n$l击去，随後一招「如胶似漆」左拳又向另一方位攻去",
		"parry":		-40,
		"parry":		 20,
		"force":		100,
		"damage_type":	"内伤"
	]),
    ([  "action":       "$N使出「鱼死网破」，双拳交错，撞向$n的$l",
		"dodge":		-70,
		"parry":		-40,
		"force":		150,
		"damage_type":	"瘀伤"
	]),
});

int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练天罗地网势必须空手。\n");
	if( (int)me->query("max_force") < 80 )
        return notify_fail("你的内力太弱，无法练习天罗地网势。\n");
	return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{	
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 25 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");
	if( (int)me->query("force") < 3 )
		return notify_fail("你的内力不够了，休息一下再练吧。\n");
	me->receive_damage("kee", 25);
	me->add("force", -3);
	return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("gumu") + "/tldw-shi/" + action;
}
int effective_level() { return 10;}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if( damage_bonus < 100 ) return 0;

	if( random(damage_bonus/2) > victim->query_str() ) {
		victim->receive_wound("kee", (damage_bonus - 100) / 2 );
		switch(random(4)) {
        case 0: return "$N听到「喀啦」一声脆响，竟似是骨碎的声音！\n";
	    case 1: return "$N劲力一吐，$n的$l发出「喀」地一声脆响！\n";
        case 2: return "只听见$n哼了一声 ...显然已经支持不住\n";
        case 3: return "$N用上绵绵内力，“噔噔噔”，，，$n退了几步，嘴角溢出一丝鲜血！\n";
		}
	}
}
