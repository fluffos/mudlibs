//无形指
inherit SKILL;

mapping *action = ({
([	"action" : "$N双指并拢，和身而上，左右手一前一后戳向$n的胸腹间",
	"force" : 60,
        "dodge" : -5,
        "parry" : -5,
	"damage": 50,
	"damage_type" : "刺伤",
      "weapon":               "剑气",
]),
([	"action" : "$N左掌护胸，右手中指前后划了个半弧，猛地一甩，疾点$n的$l",
	"force" : 120,
        "dodge" : 10,
        "parry" : 15,
	"damage": 60,
        "damage_type" : "刺伤",
      "weapon":               "剑气",
]),
([	"action" : "$N身形闪动，双手食指端部各射出一道青气，射向$n的全身要穴",
	"force" : 240,
        "dodge" : 20,
        "parry" : 20,
	"damage": 90,
        "damage_type" : "刺伤",
      "weapon":               "剑气",
]),
([	"action" : "$N并指如刃，一束束锐利无俦的剑气，凌虚向$n的胸前刺去",
	"force" : 480,
        "dodge" : 40,
        "parry" : 30,
	"damage": 70,
        "damage_type" : "刺伤",
      "weapon":               "剑气",
])
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }


int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练无形指必须空手。\n");
	if ((int)me->query_skill("liuhe-force", 1) < 20)
		return notify_fail("你的六合真气火候不够，无法学无形指。\n");
	if ((int)me->query("max_force") < 100)
		return notify_fail("你的内力太弱，无法练无形指。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
int effective_level() { return 20;}


int practice_skill(object me)
{
	if ((int)me->query("kee") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("force") < 20)
		return notify_fail("你的内力不够练无形指。\n");
	me->receive_damage("kee", 30);
	me->add("force", -10);
	return 1;
}

string *parry_msg = ({
        "$n以守为攻，一招「无形无质」，猛点$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
        "$n左掌向下，右手虚指，一招「指天划地」，将$N封于尺外。\n",

});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return 1;
}
int practice_bonus()
{
	return 1;
}
int black_white_ness()
{
	return 0;
}


string perform_action_file(string action)
{
        return CLASS_D("xueshan") + "/qijian/" + action;
}

