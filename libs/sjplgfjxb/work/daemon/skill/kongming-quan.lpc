// kongming-quan.c

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N侧身一晃，一式「空碗盛饭」，左手拿向$n的肩头，右拳打向$n的胸口", 
                "dodge":                -30,
                "parry":                10,
                "force":                200,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N一式「空屋住人」，反手一推一甩，手肘猛地向$n的胸口撞去，",
               "dodge":                -10,
                "parry":                -30,
                "force":                170,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
 "$N一式「空山鸟语」，左手一勾，反掌只抓$n手腕，跟着右拳挥出，只拿$n的背心",   
               "dodge":                -50,
                "parry":                -50,
                "force":                150,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
 "$N一式「空空如也」，左手虚招，右掌正击，同时左腿横扫而出,急攻$n的全身",
		   "dodge":                -50,
                "parry":                -50,
                "force":                100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N双拳挥舞，一式「虚怀若谷」，两手环扣，拢成圈状，猛击$n的下颌",

		    "dodge":                -20,
                "parry":                -30,
                "force":                220,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N双手抱拳，一式「我心空明」，掌影翻飞，同时攻向$n全身七大穴",
                "dodge":                -70,
                "parry":                -10,
                "force":                200,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N一式「觉后空空」，拳招若隐若现，若有若无，缓缓地拍向$n的丹田",
                "parry":                -60,
                "force":                250,
                "damage_type":  "瘀伤"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练空明拳必须空手。\n");
        if( (int)me->query_skill("jinguan-yusuo", 1) < 20 )
                return notify_fail("你的金关玉锁心法火候不足，无法练空明拳。\n");
	 if ((int)me->query("max_force") < 30)
		return notify_fail("你的内力太弱，无法练空明拳。\n");
   
     return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
string perform_action_file(string action)
{
	return CLASS_D("quanzhen") + "/kongming-quan/" + action;
}

 
