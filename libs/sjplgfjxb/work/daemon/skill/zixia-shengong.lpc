// zixia-shengong.c

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的基本内功修为不够，无法研习紫霞神功。\n");
  if (!me->query("marks/huashan/zixia"))
    return notify_fail("你的师父还不想传你紫霞神功。\n");
  if ((int)me->query_skill("hs-zhengqi") * 3 / 2 < (int)me->query_skill("zixia-shengong"))
    return notify_fail("你的华山正气诀所学不足，无法领悟更高深的紫霞神功。\n");
  if ((int)me->query_skill("huashan-force") * 3 / 2 < (int)me->query_skill("zixia-shengong"))
    return notify_fail("你的内功根基不足，多学学华山心法把。\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("紫霞神功不可以通过练习（practice) 来增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("huashan") + "/zixia-shengong/" + func;
}
int effective_level() { return 16; }
int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 30;
}
