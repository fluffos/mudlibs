// writetao.c
#include <ansi.h>
inherit SKILL;
string type() { return "knowledge"; }
void skill_improved(object me)
{
        int s;
        s = me->query_skill("painting", 1);
        if( s%10==9 && (int)me->query("per") < s/5) {
                tell_object(me, HIW "通过对丹青的修习，你的魅力增加了。\n" NOR);
                me->add("per", 1);
        }
}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 0;
}


