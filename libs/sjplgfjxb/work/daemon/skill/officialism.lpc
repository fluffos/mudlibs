//为官之道

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("officialism", 1);
  if ((int)me->query("relation_exp") < s / 5) {
    tell_object(me, HIW "由於你的勤学为官之道，你的人际关系提高了。\n" NOR);
    me->add("relation_exp", 100);
  }
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
