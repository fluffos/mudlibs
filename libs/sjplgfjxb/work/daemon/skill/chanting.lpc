// 诵经

inherit SKILL;
string type() { return "knowledge"; }
#include <ansi.h>
void skill_improved(object me)
{
        int s;

        s = me->query_skill("chanting", 1);
        if( (int)me->query("cps") < s/4) {
                tell_object(me, HIW
"由於你的诵经修炼有成，你的定力增高了。\n" NOR);
                me->add("cps", 1);
        }
}

int effective_level()
{ return 10;}

int learn_bonus()
{
        return -15;
}
int practice_bonus()
{
        return -5;
}
int black_white_ness()
{
        return 50;
}

