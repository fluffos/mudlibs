// fuhu-ken.c伏虎拳

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一声长啸，使一招「虎啸山林」, $n略一分神，$N双拳击向$n的$l",
    "dodge": -30,
    "parry": -40,
    "damage": 30,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一个箭步冲到$n的面前，一招「猛虎出山」向$n的$l击去",
    "dodge": -10,
    "parry": -40,
    "damage": 20,
    "force": 120,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身子一弓，一招「饿虎扑食」，快似闪电般地向$n的$l打过去",
    "dodge": -20,
    "parry": -30,
    "damage": 20,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N大喝一声，拔地而起，双拳齐出，一招「龙腾虎跃」直向$n的$l招呼过去",
    "dodge": -50,
    "parry": -40,
    "damage": 30,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手一个虚晃，右手一招「虎跃山涧」发出一股内力，$n只感觉一阵眩晕",
    "dodge": -20,
    "parry": -30,
    "damage": 40,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N稳住下盘，双拳紧握，使一招「虎踞龙盘」将$n的攻击反弹回去",
    "dodge": -20,
    "parry": -60,
    "damage": 30,
    "force": 130,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双拳斜出，一招「两虎并进」，分击$n的上下盘",
    "dodge": -20,
    "parry": -30,
    "damage": 60,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一个跨步，将$n按倒在地，抡起拳头，一招「达摩伏虎」直砸向$n的$l",
    "dodge": -80,
    "parry": -50,
    "damage": 80,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
});


int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练伏虎拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 10; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}
string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/fuhu-ken/" + action;
}
