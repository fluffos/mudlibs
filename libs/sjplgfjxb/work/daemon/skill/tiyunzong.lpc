// tiyun-zong.c

inherit SKILL;

string *dodge_msg = ({
  "$n一招「分身化影」，转眼间，四面八方飘动着无数个$n的身影。\n",
  "只见$n一招「白鹤冲天」,身体向上笔直纵起丈余。\n",
  "$n使出「大鹏展翅」，向旁边飘然纵出,轻轻落地，如叶之堕，黯然无声。\n",
  "$n左足一点，一个「鸽子翻身」向后纵开数丈，避开$N的凌厉攻势。\n",
  "$n一个转身，使一招「云雾萦绕」，身子轻轻飘了开去。\n",
  "$n身影一幌，一招「气冲霄汉」，身形如影随形，轻轻闪到一旁。\n",
  "只见$n一招「豪气千云」使出，轻轻落地，十分潇洒！\n"
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练梯云纵。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
string perform_action_file(string action) {
  return CLASS_D("wudang") + "/tiyunzong/" + action;

}
int effective_level() { return 13; }

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练梯云纵。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}
