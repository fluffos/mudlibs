// 乙木旋风掌

inherit SKILL;

mapping *action = ({
    ([  "action":       "$N左掌虚晃，右手使出一招「伐木手」，五指如钢钩般抓向$n的$l",
		"dodge":		-30,
		"parry":		-70,
		"force":		100,
		"damage_type":	"抓伤"
	]),
    ([  "action":       "$N身体往旁边一闪，双手使出「鼓风手」猛敲向$n$l",
		"dodge":		-10,
		"parry":		-60,
		"force":		120,
		"damage_type":	"瘀伤"
	]),
    ([  "action":       "$N向前跨出一步，左手中指食指虚插$n双眼，右掌使出「竹叶手」，拍向$n的
$l",
		"dodge":		-30,
		"parry":		-40,
		"force":		120,
        "damage_type":  "抓伤"
	]),
    ([  "action":       "$N使出「阎王手」，双手微微发黑，对准$n的$l狠狠地拍去",
        "dodge":        5,
		"parry":		-60,
        "force":        180,
        "damage_type":  "抓伤"
	]),
    ([  "action":       "$N左手虚晃，右掌飘飘，一招「七步归阴」击向$n头顶百会穴",
        "dodge":        -40,
		"parry":		-50,
        "force":        150,
		"damage_type":	"瘀伤"
	]),
    ([  "action":       "$N使出「苦海游魂」，凌空跃起，双掌飘拂不定向$n$l劈下",
		"dodge":		-70,
		"parry":		-40,
		"force":		180,
        "damage_type":  "瘀伤"
]),
    ([  "action":       "$N左手使出擒拿手，抓向$n$l，随後右手一招「钻山手」猛力钻打$n肩胛",
		"parry":		-90,
        "force":        150,
        "damage_type":  "瘀伤"
	]),
    ([  "action":       "$N左手使出擒拿手，抓向$n小腿，右手一招「旋子手」猛力钻打$n膝盖骨缝",
		"parry":		-90,
        "force":        130,
        "damage_type":  "瘀伤"
    ]),
    ([  "action":       "$N右手拇、食、中三指捏住$n手腕，左手握$n小臂向下一压",
		"parry":		-90,
        "force":        150,
        "damage_type":  "瘀伤"
    ]),
});

int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练乙木旋风掌必须空手。\n");
	if( (int)me->query("max_force") < 80 )
        return notify_fail("你的内力太弱，无法练乙木旋风掌。\n");
	return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	int sk=me->query_skill("yimu-strike",1);
    if(sk==80 || sk==100 || sk ==120 || sk == 140 || sk==160 || sk==180) {
		write("看来你得找师父学一下了。\n");
        return 0;
	}
	if( (int)me->query("kee") < 25 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");
	if( (int)me->query("force") < 3 )
		return notify_fail("你的内力不够了，休息一下再练吧。\n");
	me->receive_damage("kee", 25);
	me->add("force", -6);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if( damage_bonus < 100 ) return 0;

	if( random(damage_bonus/2) > victim->query_str() ) {
		victim->receive_wound("kee", (damage_bonus - 100) / 2 );
		switch(random(3)) {
			case 0: return "你听到「喀啦」一声轻响，竟似是骨碎的声音！\n";
			case 1: return "$N劲力一吐，$n的$l发出「喀」地一声爆响！\n";
            case 2: return "只听见$n的$l「喀」地一声，竟似是脱臼的声音！\n";
		}
	}
}
int effective_level() { return 23;}

int learn_bonus()
{
	return -60;
}
int practice_bonus()
{
	return -60;
}
int black_white_ness()
{
	return -60;
}

string perform_action_file(string action)
{
        return CLASS_D("kugu") + "/yimu-strike/" + action;
}
