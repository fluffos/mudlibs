// 伏魔剑法

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N一式「穿云势」，剑锋平指，剑势如风，一气呵成横扫$n的$l",
                "dodge":                -40,
                "damage":               70,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N向前跃上一步，左手剑诀，右手$w使出一式「破雾势」直刺$n的$l",
                "dodge":                -20,
                "damage":               40,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N拔步挺腰，一式「推山势」，手中$w沉滞无比，缓缓挥剑撞向$n的$l",
                "dodge":                30,
                "parry":                30,
                "damage":               100,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N一式「搅海势」，$w自左而右划出一个大弧，平平地向$n的$l挥去！",
                "dodge":                -40,
                "parry":                20,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N回身拧腰，右手虚抱成圆，一式「开天势」，$w中宫直进，刺向$n的$l",
                "dodge":                -40,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N一式「劈地势」，$w从上至下猛劈，剑锋直出，挟爆裂之声骤然斩向$n的$l",
                "dodge":                -20,
                "damage":               250,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N运气施出「雷针势」，$w剑尖逼出一道青芒，闪电般破空射向$n的$l",
	         "dodge":                -30,
                "damage":               150,
                "damage_type":  "刺伤"
        ]),
        ([      "action":   
"$N双腿半屈半蹲，一式「龙吞势」，剑尖划出无数圆圈，狂风骤起，笼罩天地！",
	         "dodge":                -50,
                "damage":               60,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够，没有办法练伏魔剑法。\n");

//        if( (string)me->query_skill_mapped("force")!= "fonxanforce")
//                return notify_fail("伏魔剑法必须配合少林派内功才能练。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习伏魔剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按著所学练了一遍伏魔剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/sword/fumo-sword/" + action;
}
string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});
int effective_level() { return 20;}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


 

