// 黄沙万里鞭法
#include <ansi.h>
inherit SKILL;
mapping *action = ({
        ([
                "action":               "$N惊叱一声，双手并举，寒光陡飞，霎时人鞭合一，一招“沙漠孤烟”直向$n飞去",
                "dodge":                10,
                "damage":               30,
                "damage_type":  "刺伤"
        ]),
        ([
                "action":               "$N手中鞭影乍迸，卷起漫天风沙，一招“大漠鸣沙”轰然卷扫。",
                "dodge":                50,
                "damage":               20,
                "damage_type":  "瘀伤"
        ]),
        ([
                "action":               "$N低身进步，手中鞭影席地而卷，一招“流沙铺地”向$n下盘攻至。",
                "dodge":                50,
                "damage":               20,
                "damage_type":  "瘀伤"
        ]),
        ([
                "action":               "$N鞭式一变，杀机四布，展开了一招“戈壁沙丘”",
                "dodge":                40,
                "damage":               75,
                "damage_type":  "刺伤"
        ]),
        ([
                "action":               "$N跃起三丈，身在半空，招式陡变，“飞沙走石”如黄沙壁垒般袭来",
                "dodge":                40,
                "damage":               30,
                "damage_type":  "瘀伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 150 )
                return notify_fail("你的内力不够，没有办法练黄沙万里鞭法。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "whip" )
                return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="whip" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习黄沙万里鞭法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按著所学练了一遍黄沙万里鞭法。\n");
        return 1;
}

int effective_level() { return 21;}

string *parry_msg = ({
        "$n一鞭转空，身形籍式升空三尺，反手连戳“平沙落雁”，卷起一道鞭焰，护住全身。\n",
        "$n一招“沙里淘金”，贯运真力，至截$N手中的$w\n",
        "$n右臂向后一摆，手中的$v向前卷出，鞭影一式［积沙成堆］罩住了$N。\n",
        "$n急踏步斜身，使出［碧血黄沙］让开这一招。\n",
        
});

string *unarmed_parry_msg = ({
        "$n一鞭转空，身形籍式升空三尺，反手连戳“平沙落雁”，卷起一道鞭焰，护住全身。\n",
        "$n右臂向后一摆，手中的$v向前卷出，鞭影一式［积沙成堆］罩住了$N。\n",
        "$n急踏步斜身，使出［碧血黄沙］让开这一招。\n",

});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return 10;
}
int black_white_ness()
{
        return 20;
}

string perform_action_file(string action)
{
        return CLASS_D("mojiao") + "/huangsha-whip/" + action;
}

void skill_improved(object me)
{
	int s;
        s = me->query_skill("huangsha-whip", 1);
        if (s == 0) return ;
        if (s == 1){
        	tell_object(me, HIW"\n黄沙鞭法乃当今威力最大的鞭法之一，变化多端！\n"NOR);
        }
        if (s == 91)
        	tell_object(me, HIW"由于你苦练武功，领悟绝技风沙莽莽(Perform Fengshamangmang)！\n\n"NOR);
}
