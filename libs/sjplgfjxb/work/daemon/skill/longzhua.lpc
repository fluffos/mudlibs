// longzhua.c  龙爪擒拿手

inherit SKILL;

mapping *action = ({
    ([  "action":       "$N双手平提胸前，左手护住面门，一招「苍龙出水」右手推向$n的$l",
        "dodge":        -20,
        "parry":        -20,
		"damage":        20,
        "force":        200,
        
         "damage_type": "瘀伤"
        ]),
    ([  "action":       "$N右腿斜$n二腿之间，一招「二龙戏珠」，上手取目，下手反勾$n$l",
        "dodge":        -30,
        "parry":        -30,
		"damage":        30,
        "force":        100,
        
        "damage_type":  "瘀伤"
        ]),
     ([  "action":       "$N右手虚握，左手掌立如山，一招「游龙归海」，猛地击向$n的$l",
        "dodge":        -30,
        "parry":        -30,
		"damage":        30,
        "force":        100,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N两手胸前环抱，腋下含空，五指如钩，一招「平地飞龙」插向$n的$l",
        "dodge":        -30,
        "parry":        -30,
		"damage":        40,
        "force":        100,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N左手上拦，右手内挥，一招「龙凤呈祥」击向$n的$l",
        "dodge":        -30,
        "parry":        -20,
		"damage":        40,
        "force":        150,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N腾步上前，左手护胸，右手探出，一招「龙行虎步」击向$n的$l",
        "dodge":        -30,
        "parry":        -20,
		"damage":        50,
        "force":        160,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "在呼呼风声中，$N使一招「龙飞天外」，双手如钩如戢，插向$n的$l",
        "dodge":        -30,
        "parry":        -50,
		"damage":        40,
        "force":        180,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N一手虚指，一招「蛟龙摆尾」，一手劈空抓向$n的$l",
        "dodge":        -50,
        "parry":        -50,
		"damage":        60,
        "force":        200,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N双手平伸，十指上下抖动，一招「狂龙搅海」打向$n的$l",
        "dodge":        -60,
        "parry":        -60,
		"damage":        60,
        "force":        200,
        
        "damage_type":  "瘀伤"
    ]),
});


int valid_learn(object me)
{
    if( (int)me->query_skill("puti_force",1) < 80 )
        return notify_fail("你的菩提心法火候不够，无法修习龙爪擒拿手。\n");
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("龙爪擒拿手必须空手。\n");
        return 1;
}

int valid_enable(string usage)
{
    return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{

    if( (int)me->query("kee") < 40 )
        return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
        me->receive_damage("kee", 40);
        return 1;
}
int effective_level() { return 10;}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}

string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/strike/longzhua/"+action;
}
