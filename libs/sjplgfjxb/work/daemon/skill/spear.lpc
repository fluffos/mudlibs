// spear.c

inherit SKILL;
int valid_learn(object me) {
  if ((int)me->query("p_power_rank") < (int)me->query_skill("spear", 1) * 3
    && (int)me->query_skill("spear", 1) > 30)
    return notify_fail("你的武学积累不足，没有办法领会更高的枪法。\n");
  return 1;
}

int learn_bonus() {
  return -5;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
