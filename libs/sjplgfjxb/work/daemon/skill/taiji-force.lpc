// taiji-force.c 太极神功

inherit SKILL;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("force") < (int)me->query_skill("taiji-force"))
    return notify_fail("你的基本内功修为不够，无法领会更高深的太极神功。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("太极神功只能用学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("wudang") + "/taiji-force/" + func;
}
int effective_level() { return 10; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 20;
}
