// yizhi.c  一指禅

inherit SKILL;

mapping *action = ({
  ([ "action": "$N右手食指一晃，一招「一指定乾坤」，和身而上，戳向$n的$l",
    "dodge": -20,
    "parry": -60,
    "damage": 80,
    "force": 300,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左掌护胸，一招「一望无边」，右手中指前后划了个半弧，猛地一甩，疾点$n的$l",
    "dodge": -50,
    "parry": -60,
    "damage": 40,
    "force": 180,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身形闪动，一招「一分为二」，双手食指端部各射出一道青气，射向$n的全身要穴",
    "dodge": -20,
    "parry": -60,
    "force": 200,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N盘膝跌坐，一招「一马当先」，左手握拳托肘，右手拇指直立，遥遥对着$n一捺",
    "dodge": -50,
    "parry": -60,
    "force": 200,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声大喝，一招「一鼓作气」，左手拇指一股劲气点向$n的$l",
    "dodge": -40,
    "parry": -60,
    "force": 220,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N侧转身形，一招「一帆风顺」，左手架住$n的进攻，右手无名指点向$n的肋下",
    "dodge": -60,
    "parry": -50,
    "force": 250,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
});


int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 150)
    return notify_fail("你的内功修为不足，无法修习一指禅。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练一指禅必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 50 || (int)me->query("force") < 50)
    return notify_fail("你的气或内力不足, 还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  me->add("force", -50);
  return 1;
}
int effective_level() { return 16; }

int learn_bonus() {
  return -50;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return -100;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/yizhichan/" + action;
}
