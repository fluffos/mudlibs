// zhengqi-force.c

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("zhengqi-force", 1);
	seteuid(getuid());

	if (( me->query("class") != "shaolin" )&&( me->query("class") != "shaolin1" ))
		return notify_fail("六阳正气功是少林内功，你不能学。\n");

	if ((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候还不够。\n");
	if (lvl>(int)me->query_skill("buddhism", 1) )
		return notify_fail("你的大乘佛法火候还不够。\n");

	if ((int)me->query("bellicosity") > 200) 
		return notify_fail("你的杀气太高了，不适合练此武功。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("六阳正气功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("shaolin") + "/force/zhengqi-force/" + func;
}


