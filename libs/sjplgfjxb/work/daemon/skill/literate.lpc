// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("literate", 1);
  if (((int)me->query("int") < (int)me->query("age") + 10) && (int)me->query("int") < s / 5) {
    tell_object(me, HIW "由於你的勤学苦读，你的悟性提高了。\n" NOR);
    me->add("int", 1);
  }
}
int valid_learn(object me) {
  if ((int)me->query("relation_exp") < (int)me->query_skill("literate", 1) * 100
    && (int)me->query_skill("literate", 1) > 30)
    return notify_fail("你的阅读能力太差了，没有办法领会新的知识。\n");
  return 1;
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
