int valid_learn(object me)
{
        object ob;
        string dodskill;
        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练剑法。\n");
        dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "wave_steps" || (int)me->query_skill("wave_steps",1)<30)
                return notify_fail("逍遥武功必须要凌波微步的配合.\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能学习剑法。\n");
       if( (int)me->query_skill("sword",1)/2 < (int)me->query_skill("gaoge_sword",1)/3 )
                return notify_fail("你的基本剑法功夫根基不够，无法修习。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("gaoge_sword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
  return action[random(i)];

}

int practice_skill(object me)
{
         int skill,combat_exp;
         object ob;
         skill = me->query_skill("gaoge_sword",1);
         if( ( skill >= 99 && skill < 106) || ( skill >= 145 && skill < 151) )
             return notify_fail("你于细微处无法理解，需要向师父继续学习精妙招式。\n");
         combat_exp=(int)me->query("combat_exp");
         skill=(int)me->query_skill("wave_steps", 1);

        if( skill*skill*skill/10 > combat_exp )
          return notify_fail("你的实战经验不够，无法练习高歌剑法.\n");        
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练习剑法。\n");


         if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
        notify_fail("你的内力或气不够，没有办法练习高歌剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍,似乎有些心得。\n");
        return 1;
}
        
string perform_action_file(string action)
{
        return CLASS_D("xiaoyao") + "/gaoge_sword/" + action;
}

string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连削带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 15;}

int learn_bonus()
{
        return -25;
}
int practice_bonus()
{
        return -15;
}
int black_white_ness()
{
        return -20;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

void skill_improved(object me)
{
  if(me->query_skill("gaoge_sword",1)==20){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「匆匆春又归去」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==30){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「惜春长怕花开早」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==40){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「何况落红无数」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==50){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「伊无语!脉脉此情谁诉」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==60){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「君莫舞!玉环飞燕皆尘土」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==70){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「闲愁最苦,休去倚危阑」这一招.\n" NOR);
  return;
  }
  if(me->query_skill("gaoge_sword",1)==80){
  tell_object(me, HIW "你对逍遥高歌剑法的领悟更上一层楼领悟了「斜阳正在，烟柳断肠处」这一招.\n" NOR);
  return;
  }
  
}

