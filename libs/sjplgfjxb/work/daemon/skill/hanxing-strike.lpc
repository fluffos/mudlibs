//hanxing-strike.c by john darks
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N脸上露出诡异的笑容，隐隐泛出绿色的双掌毫无生息的扫向$n的$l",
    "dodge": 130,
    "force": 440,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N突然身形旋转起来扑向$n，双掌飞舞着拍向$n的全身大穴",
    "dodge": 70,
    "force": 370,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N阴阴一笑，突然矮身欺近，毒质运至左手，阴毒无比地抓向$n的下裆",
    "dodge": 50,
    "force": 330,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N侧身一闪，突然抢入中宫，双掌挟着一股腥臭之气拍向$n的$l",
    "dodge": 60,
    "force": 350,
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed"; }

int effective_level() { return 12; }

mapping query_action(object me) {
  object corpse = present("corpse", environment(me));
  object victim = me->query_temp("last_opponent");
  if (corpse && !corpse->is_character()) {
    victim->apply_condition("hanxing_poison", random(me->query_skill("hanxing-strike") / 10) + 20 +
      victim->query_condition("hanxing_poison"));
    victim->add_temp("apply/attack", -(int)(victim->query("force") / 200) + 5);
    victim->add_temp("apply/defense", -(int)(victim->query("force") / 200) + 5);
    tell_room(environment(me), HIB "四周突然充溢着一股难闻的腐尸味！！！！\n" NOR);
  }
  if (random(me->query_skill("unarmed")) > 100 &&
    me->query_skill("force") > 100 &&
    me->query("force") > 100) {
    return ([
      "action": "$N双目赤红，低吼一声，聚集全身的力量扑向$n",
      "force": 800,
      "damage": 300,
      "damage_type": "瘀伤" ]);
  }
  return action[random(sizeof(action))];
}

string *parry_msg = ({
  "$n右掌划出，居然一掌将$N的$w击得荡了开去！\n",
  "$n不退反进，左掌泛绿，一掌向$N脑顶击来，大有同归于尽之势，逼得$N不得不疾退。\n",
  "$n向地上凌空一击，整个人象一片枯叶飞扬起来，堪堪避开$N此招。\n",
});

string *unarmed_parry_msg = ({
  "$n不退反进，左掌泛绿，一掌向$N脑顶击来，大有同归于尽之势，逼得$N不得不疾退。\n",
  "$n向地上凌空一击，整个人象一片枯叶飞扬起来，堪堪避开$N此招。\n",
  "$n阴阴一笑，突然伸出右手，与$N对了一掌。“坪”的一声，两人各退了一步！\n",
});

string query_parry_msg(object weapon) {
  object victim = this_player();
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else {
    victim->apply_condition("hanxing_poison", random(50) + 10 +
      victim->query_condition("hanxing_poison"));
    tell_object(victim, HIB "你似乎觉得有一股寒意无形的侵入了你的体内！！\n" NOR);
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
  }
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够练寒星毒掌。\n");
  if (me->query_skill("hanxing-strike", 1) < 50)
    me->receive_damage("kee", 10);
  else
    me->receive_damage("kee", 20);
  me->add("force", -5);
  return 1;
}

int practice_bonus() {
  return 10;
}

int valid_learn(object me) {
  object corpse = present("corpse", environment());
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练寒星毒掌必须空手。\n");
  if (!corpse || corpse->is_character())
    return notify_fail("附近没有尸体不可以练寒星毒掌！\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练寒星毒掌");
  return 1;
}

int learn_bonus() {
  return -10;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  victim->apply_condition("hanxing_poison", random(me->query_skill("hanxing-strike") / 10) + 1 +
    victim->query_condition("hanxing_poison"));
  tell_object(victim, HIB "你似乎觉得有一股寒意无形的侵入了你的体内！！\n" NOR);
  if (random(damage_bonus / 10) > victim->query_str()) {
    victim->receive_wound("kee", damage_bonus / 2);
    switch (random(2)) {
      case 0: return HIW "$N" + HIW "劲力一吐，$n" + HIW "的$l发出「喀」地一声爆响！\n" NOR;
      case 1: return HIW "只听见$n" + HIW "的$l「喀」地一声，竟似骨碎的声音...\n" NOR;
    }
  }
}

void skill_improved(object me) {
  int lvl;
  lvl = me->query_skill("hanxing-strike", 1);
  if (lvl == 90)
    tell_object(me, HIW "由於你苦练寒星毒掌，你领悟了绝技五毒锁喉(Perfrom Wudusuohou)。\n" NOR);
}

string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/hanxing-strike/" + action;
}
