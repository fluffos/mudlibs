// zuigun.c 醉八仙棍法

inherit SKILL;

mapping *action = ({
  ([ "action":
    "「蓝采和，提篮劝酒醉朦胧」，$N手中$w半提，缓缓划向$n的$l",
    "damage": 40,
    "dodge": -40,
    "parry": -40,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「何仙姑，拦腰敬酒醉仙步」，$N左掌护胸，右臂挟棍猛地扫向$n的$l",
    "damage": 40,
    "dodge": -60,
    "parry": -20,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「曹国舅，千杯不醉倒金盅」，$N倒竖$w，指天打地，向$n的$l劈去",
    "damage": 40,
    "dodge": -10,
    "parry": -40,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「韩湘子，铁棍提胸醉拔萧」，$N横提$w，棍端划了个半圈，击向$n的$l",
    "damage": 40,
    "dodge": -10,
    "parry": -40,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「汉钟离，跌步翻身醉盘龙」，$N手中棍花团团，疾风般向卷向$n",
    "damage": 40,
    "dodge": -10,
    "parry": -10,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「铁拐李，踢倒金山醉玉池」，$N单腿支地，一腿一棍齐齐击向$n的$l",
    "damage": 40,
    "dodge": -10,
    "parry": -20,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「张果老，醉酒抛杯倒骑驴」，$N扭身反背，$w从胯底钻出，戳向$n的$l",
    "damage": 40,
    "dodge": -10,
    "parry": -40,

    "damage_type": "挫伤"
  ]),
  ([ "action":
    "「吕洞宾，酒醉提壶力千钧」，$N腾空而起，如山棍影，疾疾压向$n",
    "damage": 40,
    "dodge": -20,
    "parry": 50,

    "damage_type": "挫伤"
  ]),

});
int valid_learn(object me) {
  if ((int)me->query("str") + (int)me->query("max_force") / 10 < 50)
    return notify_fail("你的膂力还不够，也许该练一练内力来增强力量。\n");

  return 1;
}

int valid_enable(string usage) {
  return (usage == "stick") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "stick")
    return notify_fail("你必须先找一根木棍或者是类似的武器，才能练棍法。\n");

  if ((int)me->query("kee") < 60)
    return notify_fail("你的体力不够练这门棍法，还是先休息休息吧。\n");
  me->receive_damage("kee", 60);
  return 1;
}

string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 18; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}
