//三花聚顶掌法
inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使出一招「天玑离枢」，右掌穿出击向$n的$l",
    "dodge": -30,
    "parry": 10,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使出一招「天璇乱舞」，左掌化虚为实击向$n的$l",
    "dodge": -10,
    "parry": -30,
    "force": 170,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使出一招「倒转天权」，如鬼魅般欺至$n身前，一掌拍向$n的$l",
    "dodge": -50,
    "parry": -50,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N双掌一错，使出「逐影天枢」，对准$n的$l连续拍出三掌",
    "dodge": -50,
    "parry": -50,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N左掌画了个圈圈，右掌推出，一招「风动玉衡」击向$n$l",
    "dodge": -20,
    "parry": -30,
    "force": 220,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使出「开阳薄雾」，身形散作七处同时向$n的$l出掌攻击",
    "dodge": -70,
    "parry": -10,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N吐气扬声，一招「瑶光音迟」双掌并力推出",
    "parry": -60,
    "force": 250,
    "damage_type": "瘀伤"
  ]),
});
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练三花聚顶掌法必须空手。\n");
  if ((int)me->query_skill("ziliu-force", 1) < 20)
    return notify_fail("你的紫流气功火候不足，无法练三花聚顶掌法。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练三花聚顶掌法。\n");
  return 1;
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int effective_level() { return 20; }

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("quanzhen") + "/sanhuajuding/" + action;
}
