//十八手铁掌银钩

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N右掌一招「晚月朗星」，迅捷无比地劈向$n的$l",
                "dodge":                -20,
                "parry":                -20,
                "force":                170,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N使出「幻眼云湮」，双掌由下往上击向$n的$l",
                "dodge":                -20,
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N使出「风伴流云」，身形飞起，双掌并在一起向$n的$l劈下",
                "dodge":                -20,
                "parry":                -20,
                "force":                100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N左掌护胸，右掌使一招「无边落木」上下晃动着击向$n的$l",
                "dodge":                -20,
                "parry":                -20,
                "force":                180,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N门户大开，一招「枯木逢春」向$n的$l劈去",
                "parry":                -20,
                "force":                150,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N突然身形飞起，双掌居高临下一招「天绅倒悬」拍向$n的$l",
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N左掌聚成钩状，右掌一招「天地钩」缓缓推向$n的$l",
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N脚下一转，突然欺到你身前，一招「金蟾归月」拍向$n的$l",
                "parry":                -20,
                "force":                150,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N使出「杯弓蛇影」，左掌封住$n的退路，右掌斜斜地劈向$l",
                "dodge":                -20,
                "parry":                -20,
                "force":                100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N身形滑动，双掌使一招「露草斜阳」一前一后按向$n的$l",
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N使出「水到渠成」，右掌从不可能的角度向$N的$l推出",
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N使出「或跃在渊」，向$n的$l连拍数掌",
                "dodge":                -20,
                "parry":                -20,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               
"$N双掌施出一招「清风袭月」，隐隐带着风声拍向$n的$l",
                "parry":                -20,
                "force":                100,
                "damage_type":  "瘀伤"
        ])
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练十八手铁掌银钩必须空手。\n");
        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力修为不足，无法练十八手铁掌银钩。\n");
        if( (int)me->query_skill("unarmed",1)/2 < (int)me->query_skill("xianglong_strike",1)/3 )
                return notify_fail("你的拳脚功夫根基不够，无法练十八手铁掌银钩。\n");
        return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
int effective_level() { return 8;}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
 
int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}
