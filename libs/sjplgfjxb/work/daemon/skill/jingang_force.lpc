// jingang_force.c金刚不坏体神功

inherit FORCE;

int valid_enable(string usage) { return usage == "iron-cloth" || usage == "force"; }

int valid_learn(object me) {
  int lvl = (int)me->query_skill("jingang_force", 1);
  seteuid(getuid());

  if ((me->query("class") != "shaolin") && (me->query("class") != "shaolin1"))
    return notify_fail("金刚不坏体神功是少林内功，你不能学。\n");

  if ((int)me->query_skill("force", 1) < 150)
    return notify_fail("你的基本内功火候还不够。\n");
  if (lvl > (int)me->query_skill("buddhism", 1))
    return notify_fail("你的大乘佛法火候还不够。\n");

  if ((int)me->query("bellicosity") > 200)
    return notify_fail("你的杀气太高了，不适合练此武功。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("金刚不坏体神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}


int effective_level() { return 22; }

string *absorb_msg = ({
  "$n双臂一震，金刚不坏功力决堤似的澎湃而出。\n",
  "$n施展出金刚不坏功中的「弹」字诀，一股弹力传入$N的体内。\n",
  "$n使出一招「苦海无涯」，凝虚为实，浑身硬如金刚。\n",
  "$n施展出金刚不坏功，对抗$N的一击之力。\n",
});

string query_absorb_msg() {
  return absorb_msg[random(sizeof(absorb_msg))];
}

int bounce_ratio() {
  return 5;
}

int learn_bonus() {
  return -10;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 20;
}

string exert_function_file(string func) {
  return CLASS_D("shaolin") + "/force/jingang_force/" + func;
}
