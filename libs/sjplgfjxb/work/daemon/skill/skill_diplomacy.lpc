// skill_diplomacy  外交能力

inherit SKILL;

string *dodge_msg = ({
  "你端起酒杯，笑容满面地给在座的外国使节敬酒。\n",
  "你与外国使节推杯换盏，说道：今日为恭迎贵国使臣，特准备了宫中精制美酒。请！\n",
  "你陪着外国使节一边欣赏歌舞，一边约定两国永交友好。\n",
  "你和外国使节互送两国礼物，席间充满着和平融洽的气氛。\n"
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 0)
    return notify_fail("你的力气不够，没有办法锻炼。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int effective_level() { return 1; }

string perform_action_file(string action) {
  return CLASS_D("guanfu") + "/other_skills/" + action;
}
