// 无底微剑

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N一招「浪子莫回头」，$w随手刺出，闪电般直刺向$n的$l",
    "dodge": -30,
    "parry": -20,
    "damage": 100,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「秋边一雁声」，$w抖动，发出雁鸣之声，反手挑向$n的$l",
    "dodge": -30,
    "damage": 20,
    "parry": -20,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w飘拂不定，一式「笑看风尘泪」轻轻撩向$n的$l",
    "dodge": -30,
    "parry": -20,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w一抖，化作九点寒星，一招「漫天花雨」，攻向$n的$l",
    "dodge": -100,
    "parry": -100,
    "damage": 80,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左掌虚劈，剑尖从掌风中穿出，一招「无花空折支」，手中的$w直刺$n的$l！",
    "dodge": -30,
    "parry": -20,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N使出一招「霓裳羽衣」，$w舞出一片寒光，罩向$n全身",
    "dodge": -30,
    "parry": -20,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「高山流水」，右手$w自上而下斜削$n的$l",
    "dodge": -60,
    "parry": -20,
    "damage": 50,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「风扫残花」，身体跃起，$w对着$n狂风骤雨般连刺十三剑",
    "dodge": -60,
    "parry": -70,
    "damage": 180,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一侧身，使一招「雨后初晴」，$w划出一道彩虹，劈向$n的$l",
    "dodge": -30,
    "parry": -20,
    "damage": 60,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N右手$w一招「春宵苦短」，剑光摄人心神，剑尖忽然毒蛇般刺向$n的咽喉",
    "dodge": -80,
    "parry": -80,
    "damage": 100,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N使出一招「别离情」，右手$w刺出，在中途忽然一停，反手挑向$n的裆部",
    "dodge": -40,
    "parry": -40,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
});


mapping last_action1 = ([ "action":
  "$N右手$w忽然在半空停了一下，剑气凝结，天地为之变色，一招「曲终人散」，刺向$n的心口",
  "dodge": -150,
  "parry": -150,
  "damage": 300,
  "damage_type": "割伤"
]);

mapping last_action2 = ([ "action":
  "$N使出「唯见林花落」，$w夹着一股强劲的剑气横扫向$n的$l",
  "dodge": -20,
  "parry": -20,
  "damage": 250,
  "damage_type": "刺伤"
]);


int valid_learn(object me) {
  object ob;
  int max_force = me->query("max_force");

  if (max_force < (int)me->query_skill("wudi_sword") * 20)
    return notify_fail("你的内力修为不足，没有办法练无底微剑。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，没有办法练无底微剑。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练无底微剑。\n");
  ob = me->query_temp("weapon");
  if (ob->query("objattrib") != "short")
    return notify_fail("你的剑太长了，没法施展无底微剑。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if (me->query_skill("wudi_sword", 1) >= 105 && random(3) > 1)
    return last_action2;
  if (me->query_skill("wudi_sword", 1) >= 150 && random(3) > 1)
    return last_action1;
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object ob = me->query_temp("weapon");
  int skill = me->query_skill("wudi_sword", 1);
  if ((skill >= 99 && skill < 106) || (skill >= 145 && skill < 151))
    return notify_fail("你所学的无底微剑已经到达极限了，需要向师父继续学习精妙招式。\n");
  if ((int)me->query("kee") < 40
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习无底微剑。\n");
  if (ob->query("objattrib") != "short")
    return notify_fail("你没有足够短的剑，没法施展无底微剑。\n");
  me->receive_damage("kee", 40);
  me->add("force", -10);
  write("你把无底微剑剑法从头到尾练了一遍。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("gumu") + "/wudi_sword/" + action;
}
string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});
int effective_level() { return 25; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
