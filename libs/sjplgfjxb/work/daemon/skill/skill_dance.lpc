// 歌舞技能

inherit SKILL;

mapping *action = ({
  ([ "action": "一片悦耳的歌声响起，$N和着歌声的节奏跳起舞来。",
    "dodge": 0,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N的舞姿曼妙绝伦，令人忍不住击节叫好。",
    "dodge": 0,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N翩翩起舞，在动人的歌曲声伴随中，犹如彩蝶纷飞，煞是好看。",
    "dodge": 0,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N跳起了“迎宾舞”，旋转的舞步带起彩色的裙衣，好似礼花绽放。",
    "dodge": 0,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "国宾馆内到处洋溢着歌舞升平的和乐气氛。",
    "dodge": 0,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 0)
    return notify_fail("你的不够，没有办法练法。\n");
  /*
	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "unarmed" )
		return notify_fail("你必须先找一把才能练法。\n");
*/
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int effective_level() { return 1; }

string *parry_msg = ({
  "$n娇声唱道：东南自古形胜，烟柳画桥，风帘翠幕，参差十万人家．．．\n",
  "$n歌声婉转，唱道：重湖叠翠清嘉，有三秋桂子，十里荷花．．．\n",
  "$n回眸一笑，唱道：箫管弄晴，菱歌泛夜，嬉嬉钓叟莲娃．．．\n",
  "$n银铃般唱道：千骑拥高牙，乘醉听箫鼓，吟赏烟霞．．．\n",
});

string *unarmed_parry_msg = ({
  "$n娇声唱道：东南自古形胜，烟柳画桥，风帘翠幕，参差十万人家．．．\n",
  "$n歌声婉转，唱道：重湖叠翠清嘉，有三秋桂子，十里荷花．．．\n",
  "$n回眸一笑，唱道：箫管弄晴，菱歌泛夜，嬉嬉钓叟莲娃．．．\n",
  "$n银铃般唱道：千骑拥高牙，乘醉听箫鼓，吟赏烟霞．．．\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("guanfu") + "/other_skills/" + action;
}
