// senluo-force.c 森罗万象变
// modify darks
#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me) { return 1; }
int effective_level() { return 19;}
int practice_skill(object me)
{
        return notify_fail("森罗万象变只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("mojiao") + "/senluo-force/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        mixed foo;

        foo = ::hit_ob(me, victim, damage_bonus, factor);
        if( intp(foo) && (damage_bonus + foo > 0) ) {
                if( random(me->query_skill_eff_lvl("senluo-force")) > (damage_bonus + foo) ) {
                        victim->receive_wound("kee", (damage_bonus + foo)*2 );
                        return "$N的招式挟著一股阴寒无比的劲风使得$n不禁打了个寒噤。\n";
                }
        }
        return foo;
}

void skill_improved(object me)
{
        int s;
        s = me->query_skill("senluo-force", 1);
        if (s == 0) return ;
        if (s == 1)
                tell_object(me, HIW"\n森罗万象变乃当今变化最多的内功，据说有种神奇的力量！\n"NOR);
        if (s == 31)
                tell_object(me, HIW"\n你学会了运用森罗万象变发动花树大阵的诀窍(Exert Yihuajiemu)！\n"NOR);
        if (s == 201)
                tell_object(me, HIW"由于你苦练武功，领悟绝技天魔解体大法(Exert Tianmojieti)！\n\n"NOR);
}
