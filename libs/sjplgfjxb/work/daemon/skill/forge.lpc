// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
        int s;

        s = me->query_skill("forge", 1);
        if((int)me->query("dur") < s/4) {
                tell_object(me, HIW "通过对锻造的修习，你的耐力提高了。\n" NOR);
                me->add("dur", 1);
        }
        

}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 0;
}

