//风雷一剑
inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N使一招「春雷震怒」，手中$w隐隐挟着风雷之声卷向$n的$l",
                "dodge":                30,
		"force" :		100,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练风雷一剑。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习风雷一剑。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍风雷一剑。\n");
        return 1;
}
 
int effective_level() { return 23;}

string *parry_msg = ({
        "$n使出一招「春雷震怒」，手中的$v荡开了$N的$w。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v一抖，一招「春雷震怒」换了个方位掠来，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return 10;
}
int practice_bonus()
{
	return 10;
}
int black_white_ness()
{
	return 20;
}
string perform_action_file(string action)
{
        return CLASS_D("xueshan") + "/one-sword/" + action;
}

