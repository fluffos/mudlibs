// puti_force.c
#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

void skill_improved(object me)
{
	int s;

	s = me->query_skill("puti_force", 1);
	if( (s==50||s==100||s==150||s==200||s==250)&&(int)me->query_kar()<35) {
		tell_object(me, HIW "由於你潜心修行，你的福缘提高了。\n" NOR);
		me->add("attr/kar", 1);
	}
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("puti_force", 1);
	seteuid(getuid());

	if (( me->query("class") != "shaolin" )&&( me->query("class") != "shaolin1" ))
		return notify_fail("菩提心法是少林内功，你不能学。\n");

	if ((int)me->query_skill("force", 1) < 90)
		return notify_fail("你的基本内功火候还不够。\n");
	if (lvl>(int)me->query_skill("buddhism", 1) )
		return notify_fail("你的大乘佛法火候还不够。\n");

	if ((int)me->query("bellicosity") > 200) 
		return notify_fail("你的杀气太高了，不适合练此武功。\n");

	return 1;
}

int practice_skill(object me)
{

    if( (int)me->query("gin") < 60 )
        return notify_fail("你的精力不够, 还是先休息吧。\n");
	me->receive_damage("gin", 60);
    return 1;
}
int effective_level() { return 16;}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}

string exert_function_file(string func)
{
        return CLASS_D("shaolin") + "/force/puti_force/" + func;
}


