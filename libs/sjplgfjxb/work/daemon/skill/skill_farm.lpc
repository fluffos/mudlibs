// 农业技术

inherit SKILL;

mapping *action = ({
	([	"action":		"$N挥起镰刀，将稻穗一束束割了下来，扎成一捆扔在旁边。
\n不久田埂上便排满了金黄色的稻穗，犹如一条金色的长龙。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N把割下的稻穗用扁担串起，一人肩头各挑两捆稻穗，大步走向田边。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N将肩头的担子放下，把一捆又一捆稻穗装上了运粮的马车。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N将成捆的稻穗堆了起来，转眼堆成了一座座稻山。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N赶着满载稻穗的马车，运往打谷场。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 0 )
		return notify_fail("你的不够，没有办法练法。\n");
/*
	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "unarmed" )
		return notify_fail("你必须先找一把才能练法。\n");
*/
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int effective_level() { return 1;}

string *parry_msg = ({
        "$n们情绪高涨，大家热火朝天地干了起来。\n",
        "$n擦着头上的汗水，嚷道：再加把劲，快干完了！\n",
        "$n嘴里吆喝着：嗨哟～～嗨哟～～\n",
        "$n们奔波劳碌，忙得不亦乐乎。\n",
        "$n忙中偷闲，对你说道：大人敬请放心，我们决不让您失望！\n",
});

string *unarmed_parry_msg = ({
        "$n们情绪高涨，大家热火朝天地干了起来。\n",
        "$n擦着头上的汗水，嚷道：再加把劲，快干完了！\n",
        "$n嘴里吆喝着：嗨哟～～嗨哟～～\n",
        "$n们奔波劳碌，忙得不亦乐乎。\n",
        "$n忙中偷闲，对你说道：大人敬请放心，我们决不让您失望！\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
        return CLASS_D("guanfu") + "/other_skills/" + action;
}


