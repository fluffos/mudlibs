// leiyin-sword.c

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N使一式「朗日焦雷」，手中$w嗡嗡作振，幻成一条疾光刺向$n的$l！",
                "dodge":                -30,
                "parry":                -60,
                "damage":                40,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N使一式「天际闪电」，手中$w化作一道闪电直刺向$n的$l！",
                "dodge":                -40,
                "parry":                -70,
                "damage":                40,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N一式「声震寰宇」，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l！",
		        "dodge":                -50,
                "parry":                -80,
                "damage":                80,
                "damage_type":  "刺伤"
        ]),
        ([      "action":   
"$N纵身高高跃起，一式「八方霹雳」，剑光如轮疾转，霍霍斩向$n的$l！！",
		        "dodge":                -30,
                "parry":                -70,
                "damage":                50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
 "$N大喝一声，一式「雷镇四方」，手中$w向$n的$l斜斜击出！",
                "dodge":                -60,
                "parry":                -70,
                "damage":                70,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N猛一提气，一式「电闪雷鸣」，手中$w嗡嗡作响，向$n$l劈去",
                "dodge":                -50,
                "parry":                -40,
                "damage":                50,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N手中$w挥舞，激起一式「雷声大作」，如怒雷滚滚，对准$n的$l刺出一剑！",
                "dodge":                -80,
                "parry":                -40,
                "damage":                80,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N身形虚闪，运起丹田之气，一式「惊天动地」，刹那间天地变色，剑芒环绕在$n身上！",
                "dodge":                -100,
                "parry":                -120,
                "damage":                150,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query_skill("force",1) < 100 )
                return notify_fail("你的内功不够，没有办法练雷音剑法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练雷音剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习雷音剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按著所学练了一遍雷音剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/sword/leiyin-sword/" + action;
}
 
string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}



