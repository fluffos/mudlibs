// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("cook", 1);
  if ((int)me->query("kar") < s / 4) {
    tell_object(me, HIW "通过对烹调的修习，你的福缘提高了。\n" NOR);
    me->add("kar", 1);
  }


}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
