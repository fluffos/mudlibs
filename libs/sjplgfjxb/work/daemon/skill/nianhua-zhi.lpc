// nianhuazhi.c  拈花指

inherit SKILL;

mapping *action = ({
  ([ "action": "$N侧身抬臂，右指划了个半圈，一式「瓶花落砚」击向$n的$l！",
    "dodge": -20,
    "parry": -20,
    "damage": 30,
    "force": 200,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N左掌虚托，一式「寒梅吐蕊」，右指穿腋疾出，指向$n的$l！",
    "dodge": -50,
    "parry": -30,
    "damage": 40,
    "force": 120,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N俯身斜倚，左手半推，右手一式「初杏问酒」，向$n的$l划过！",
    "dodge": -30,
    "parry": -30,
    "damage": 30,
    "force": 100,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N双目微睁，一式「露草斜阳」，双手幻化出千百个指影，拂向$n的$l！",
    "dodge": -40,
    "parry": -70,
    "damage": 40,
    "force": 120,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N一式「仰月承霖」，左掌护住丹田，右手斜指苍天，蓄势点向$n的$l！",
    "dodge": -30,
    "parry": -40,
    "damage": 50,
    "force": 130,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N双掌平托胸前，十指叉开，一式「叶底留莲」，指向$n的周身大穴！",
    "dodge": -30,
    "parry": -20,
    "damage": 30,
    "force": 150,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N双掌翻飞，一式「清风拂桂」，指端迸出无数道劲气，射向$n的全身！",
    "dodge": -30,
    "parry": -60,
    "damage": 50,
    "force": 100,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N一式「菊圃秋霜」，并指如刃，一束束锐利无俦的刀气，凌虚向$n的后心砍去！",
    "dodge": -50,
    "parry": -20,
    "damage": 60,
    "force": 180,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N一式「伽叶微笑」，双手食指交叉，指端射出一缕罡气，穿过$n的$l！",
    "dodge": -50,
    "parry": -50,
    "damage": 30,
    "force": 200,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N左掌竖立胸前，一式「佛祖拈花」，右手食指扣住拇指，轻轻对着$n一弹！",
    "dodge": -70,
    "parry": -70,
    "damage": 80,
    "force": 250,
    "damage_type": "指伤"
  ]),
});


int valid_learn(object me) {
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为不够，无法修习更高深的拈花指。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练拈花指必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
  //    return usage=="finger";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((string)me->query_skill_mapped("force") != "shaoyang_force")
    return notify_fail("拈花指法必须配少阳神功才能练习。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 15; }

int learn_bonus() {
  return -50;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return -100;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/nianhua-zhi/" + action;
}
