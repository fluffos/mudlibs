// ziliu-force.c 紫流气功

#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("daoxue-xinfa") < (int)me->query_skill("ziliu-force"))
    return notify_fail("你的道学心法修为不够，无法领会更高深的紫流气功。\n");
  if ((int)me->query_skill("force") < (int)me->query_skill("ziliu-force"))
    return notify_fail("你的基本内功修为不够，无法领会更高深的紫流气功。\n");


  return 1;
}

int practice_skill(object me) {
  return notify_fail("紫流气功只能用学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {

  return CLASS_D("quanzhen") + "/ziliu-force/" + func;
}
int effective_level() { return 18; }

int learn_bonus() {
  return -20;
}
int practice_bonus() {
  return -20;
}
int black_white_ness() {
  return -20;
}
