//yanyun-steps.c written by john darks
#include <ansi.h>
inherit SKILL;
string *dodge_msg = ({
  "$n一招「轻烟缥缈」轻轻巧巧地避了开去。\n",
  "只见$n身影一晃，一式「青云直上」早已避在七尺之外。\n",
  "$n使出「凌空飞渡」，轻轻松松地闪过。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，没有办法练烟云缥缈步法。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀气太高，无法静心领悟烟云缥缈步法。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练烟云缥缈步法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}

int effective_level() { return 15; }

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 20;
}

void skill_improved(object me) {
  int s;
  s = me->query_skill("yanyun-steps", 1);
  if (s == 0) return;
  if (s == 1)
    tell_object(me, HIW "\n烟云缥缈步是天和道人观烟云所悟，一旦施展，轻如烟飘如云！\n" NOR);
  if (s == 50) {
    tell_object(me, HIW "由于你苦练轻功，领悟了绝技 [四海纵横] (Perform Sihaizongheng)！\n" NOR);
    tell_object(me, HIW "这个武功一旦施展，步法将极其灵活，可以将对手一举一动控制在意料之中！\n" NOR);
  }
  if (s == 101)
    tell_object(me, HIW "你苦练轻功，将腿法融入了绝技 [四海纵横]！之中！\n" NOR);
}


string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/yanyun-steps/" + action;
}
