// jingang-ken.c  大金刚拳

inherit SKILL;

mapping *action = ({
  ([ "action": "$N盘膝而坐，二手合十，一式「莲花座」，双拳蓄势而发，击向$n的$l",
    "dodge": -10,
    "parry": 100,
    "force": 250,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「烈火锥」，双掌轮流下击，拳势如焰，吡啪爆响！",
    "dodge": -10,
    "parry": 40,
    "force": 300,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N腾空飞起，一式「八方雨」，双手双腿齐出，令$n无可躲藏",
    "dodge": -60,
    "parry": -10,
    "force": 200,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌虚含，掌缘下沉，一式「掌心雷」，缓缓向$n推出",
    "dodge": 20,
    "parry": 30,
    "force": 300,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一臂前伸，一臂后指，一式「五指山」，攻向$n的身前身后",
    "dodge": 10,
    "parry": 10,
    "force": 100,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「观音渡」，两手十指虚点$n的全身三十六道要穴",
    "dodge": -30,
    "parry": -40,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两目内视，双手内笼，一式「天龙唱」，四面八方响起震人心魄的龙吟",
    "dodge": -40,
    "parry": -40,
    "force": 500,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N似笑非笑，双拳无形无定，一式「如来笑」，骤然击向$n的$l",
    "dodge": -30,
    "parry": 20,
    "force": 100,
    "post_action": (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),

});


int valid_learn(object me) {
  if ((int)me->query("force") < (int)me->query_skill("jingang-ken") * 25)
    return notify_fail("你的内力不够，无法修习更高深的大金刚拳。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练大金刚拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int effective_level() { return 10; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
