// zgongsword.c 周公剑法

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N一长身形，一招「天涯沦落」已然使出，$w象毫无目标的向前挥去",
    "dodge": -30,
    "parry": -20,
    "damage": 45,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N:「长夜漫漫」，手中的$w极其缓慢的，顽强的向$n刺去",
    "dodge": -50,
    "parry": -20,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N横剑当胸：「海枯石烂」，剑光爆长一道剑气, 直指$n, 夹杂着一片爆裂的声音",
    "dodge": -50,
    "parry": -20,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一瞬间已变幻九次身形「捕风捉影」已在变幻中完成, 漫天激荡的已只有剑气，"
    "$n犹如海上行舟",
    "parry": -60,
    "dodge": -60,
    "damage": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N$w交左手，$w从左至右一招「横扫九龙头」, 剑式未满右手轻压$w柄，后半招的"
    "运法却直冲向天剑挑$n咽喉",
    "dodge": -20,
    "parry": -50,
    "damage": 50,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「周公在天」, $w直指$n, 其实这一招包含了36种变化从根本不可能的方向"
    "连绵不绝的攻向$n",
    "dodge": -60,
    "parry": -60,
    "damage": 130,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练周公剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 20
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习周公剑法。\n");
  me->receive_damage("kee", 20);
  me->add("force", -3);
  write("你按著所学练了一遍周公剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("gaibang") + "/tlongsword/" + action;
}
int learn_bonus() {
  return -50;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return -50;
}
