// 先天八卦步法

inherit SKILL;

string *dodge_msg = ({
        "但是$n身形飘忽不定，一式「神游天外」，轻轻一纵，早已避开。\n",
        "$n身形微晃，使出一式「凌波蹋水」，有惊无险地避开了$N这一招。\n",
        "$n一招「瞬息千里」脚蹋乾位，轻轻松松地避开了$N的攻击。\n",
        "$n一式「颠倒阴阳」蹋向兑位，令$N的攻势顿时落空。\n",
        "只见$n身形一转，一式「霸王卸甲」竟然蹋到了坤位，很自然的闪过了$N的攻击。\n",
});

int valid_enable(string usage)
{
        return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    int lb,dg;
    lb=(int)me->query_skill("wave_step",1);
    if( (int)me->query("kee") < 30 )
        return notify_fail("你的气太少了，不能练先天八卦步法。\n");
    me->receive_damage("kee", 30);
        dg = me->query_skill("dodge",1)- me->query_skill("wave_step",1);
        if(me->query_learn("wave_step") > (lb+1)*(lb+1)+10 && dg<=0 ) return 0;
    me->add("force",lb/2);
    if( (int)me->query("force") > (int)me->query("max_force") * 2) {
        if( (int)me->query("max_force") <
                        ((int)me->query_skill("force", 1) + me->query_skill("force")/5) * 10 ) {
            write("你的内力提高了。\n");
                        me->add("max_force", 1);
                }
                me->set("force", me->query("max_force"));
        }       

        return 1;
}
int effective_level() { return 18;}

int learn_bonus()
{
        return -1;
}
int practice_bonus()
{
        return -5;
}
int black_white_ness()
{
        return 20;
}



