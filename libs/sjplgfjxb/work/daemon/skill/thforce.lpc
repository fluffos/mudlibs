//written by john darks
#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me) { return 1; }

int practice_skill(object me)
{
        return notify_fail("天和内气只能用学，或是从运用(exert)中增加熟练度。\n");
}

int effective_level() { return 10;}

int learn_bonus()
{
	return -300;
}
int practice_bonus()
{
	return -50;
}
int black_white_ness()
{
	return 0;
}

void skill_improved(object me)
{
	int s,max;
        s = me->query_skill("thforce", 1);
        if (s == 0) return ;
        if (s == 1){
        	tell_object(me, HIW"\n天和内气最神奇之处就是可以通过锻炼(Exert Practice)提高技能！\n"NOR);
        	tell_object(me, HIW"同时也是疗伤(Exert Lifeheal)的好内功！\n\n"NOR);
        }
        if (s == 100 + (int)me->query("wangsha/thforce")) {
        	tell_object(me, HIR"你突然感觉习练天和内气似乎遇到了瓶颈！！\n"+NOR+"如果你感到无所是从，不妨问问师傅。\n");
        	me->set_skill("thforce", s-1);
        	return;
        }
        if (s == me->query("wangsha/thforce") && s!=( (int)me->query("wangsha/thlvl"))*100 ){
        	tell_object(me, HIW"你突然感觉突破瓶颈，感觉精气神三者合一，达到了前所未有的境界！！\n"NOR);
        	if (!me->query("wangsha/thlvl"))
        		me->set("wangsha/thlvl",1);
        	else me->add("wangsha/thlvl",1);
        	max = me->query("max_atman")>me->query("max_mana")?me->query("max_atman"):me->query("max_mana");
        	max = max>me->query("max_force")?max:me->query("max_force");
        	me->set("max_atman",max + (int)me->query("wangsha/thforce")*2);
        	me->set("max_mana" ,max + (int)me->query("wangsha/thforce")*2);
        	me->set("max_force",max + (int)me->query("wangsha/thforce")*2);
        }
        if( s%10==9 && (int)me->query("spi") < s/4 && s < 150) {
                tell_object(me, HIW "由於你勤习天和内气，你的灵性提高了。\n" NOR);
                me->add("spi", 2);
        }
        if( s%10==9 && (int)me->query("dur") < s/4 && s >= 150) {
                tell_object(me, HIW "由於你勤习天和内气，你的耐力提高了。\n" NOR);
                me->add("dur", 2);
        }
}

string exert_function_file(string func)
{
        return CLASS_D("mojiao") + "/thforce/" + func;
}

