// liandanshu.c

inherit SKILL;

int learn_bonus()
{
	return -20;
}
int practice_bonus()
{
	return -10;
}
int black_white_ness()
{
	return -10;
}
int valid_learn(object me)
{
	if ((string)me->query("class") != "taoist")
	return notify_fail("你不是道士，无法学习炼丹术。\n");
	if( (int)me->query_skill("taoism",1)*2 < (int)me->query_skill("liandanshu",1))
		return notify_fail("你的天师正道修为不够，无法领悟更高深的炼丹术。\n");
        return 1;
}

int effective_level() { return 15;}

int valid_enable(string usage)
{
        return (usage=="literate");
}
