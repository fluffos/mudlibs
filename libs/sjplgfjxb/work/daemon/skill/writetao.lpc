// writetao.c
#include <ansi.h>
inherit SKILL;
string type() { return "knowledge"; }
void skill_improved(object me) {
  int s;
  s = me->query_skill("writetao", 1);
  if (s % 10 == 9 && (int)me->query("cor") < s / 5) {
    tell_object(me, HIW "通过对书法的修习，你的勇气增加了。\n" NOR);
    me->add("cor", 1);
  }
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
