// lunhui-sword

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N一抖手中$w，剑尖对着$n点了三点，一式「凤栖桐」剑尖直刺向$n的$l！",
    "dodge": -40,
    "damage": 70,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N将剑尖朝天，一式「娑婆众生」，自上而下缓慢划向$n的$l。",
    "dodge": -20,
    "damage": 100,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N剑尖一抖，一招「花落无忧」，剑尖抖出朵朵剑花，罩向$n全身！",
    "dodge": 30,
    "parry": 30,
    "damage": 125,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N欺身而上，用剑荡开$n手中$l，左手一招「佛法万乘」印向$n的$l！",
    "dodge": -40,
    "parry": 60,
    "damage_type": "内伤"
  ]),
  ([ "action":
    "$N剑锋一沉，一式「邪魔邪道」，剑从左右攻向$n的$l。",
    "dodge": -80,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N大喝一声“「雾海游龙」”，从$n头顶越过，掌中$w反手一划，划向$n的$l。",
    "dodge": -20,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身子一矮，一式「莲地净身」，转到$n身后，手中$w向一条银蛇，刺向$n的$l。",
    "dodge": -30,
    "damage": 250,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N暴喝一声，一式「万魔入道」，人如陀螺一般旋转，散出万点银芒，又骤的聚为一线，直刺向$n的$l！",
    "dodge": 80,
    "damage": 500,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  if (!me->query("marks/lunhui-sword"))
    return notify_fail("恐怕你师父的水平不足以教你这套剑法。\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够，无法学习轮回剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object ob;
  int sk = me->query_skill("lunhui-sword", 1);

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够，没有办法练轮回剑法。\n");

  if ((string)me->query_skill_mapped("force") != "xuanyue-force")
    return notify_fail("轮回剑法必须配玄月心法才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  if (sk == 100 || sk == 120 || sk == 140 || sk == 160 || sk == 180)
    return notify_fail("你练了一次剑法，发现自己已经不能再提高了。看来是得找人指点一下了。\n");

  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习轮回剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你按著所学练了一遍轮回剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("luoyue") + "/lunhui-sword/" + action;
}
string *parry_msg = ({
  "只听见「叮」一声，$n手中的$v正点中$N手中的$w。\n",
  "$n挥动手中$v边舞边退，令$N的$w无法靠近。\n",
  "$n手中的$v荡起一团剑气，扫开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v连点几点，封住了$N要进攻的方向。\n",
  "$n后撤一步，$v直刺$N的双手。\n",
  "$n将手中的$v一挺，刺向$N的双目，$N见势不妙，连退几步。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 15; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}
