//鬼域叉法
inherit SKILL;

mapping *action = ({
  ([ "action": "$N举起$w往$n的$l刺去",
    "damage": 70,
    "dodge": -30,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  //        if( (int)me->query("max_force") < 100 )
  //                return notify_fail("你的内力不够，没有办法练鬼域叉法。\n");

  //        if( (string)me->query_skill_mapped("force")!= "hotforce")
  //                return notify_fail("鬼域叉法必须配合赤阳内功才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork")
    return notify_fail("你必须先找一面叉子，才能练叉法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "fork") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "fork")
    return notify_fail("你必须先找一面叉子，才能练叉法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门叉法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 5; }

string *parry_msg = ({
  "$n用手中的$v急刺$N的五指。\n",
});

string *unarmed_parry_msg = ({
  "$n手中的$v划出一道弧线，将$N的全身围住。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 30;
}

string perform_action_file(string action) {
  return CLASS_D("taoist") + "/hell-fork/" + action;
}
