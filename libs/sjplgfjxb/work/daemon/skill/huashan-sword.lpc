// huashan-sword.c

inherit SKILL;
#include <ansi.h>;

mapping *action = ({
  ([ "action":
    "$N剑锋斜转，一招「有凤来仪」，$w刺向$n的$l，去势奇疾而收剑极快",
    "dodge": -20,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N突然间剑光一吐，一招「白虹贯日」，$w化作一道白虹，向$n直刺过来",
    "dodge": -10,
    "dmage": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左手向外一分，右手$w滴溜溜地一转，反手刺向$n的$l，使的是招「白云出蚰」",
    "dodge": 30,
    "damage": 80,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N$w一晃，向右滑出三步，紧接着跃到空中，一招「金燕横空」，直斩向$n",
    "dodge": -20,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "只见$N一招「无边落木」，身子骤然拔高数尺，手中$w自上而下向$n的$l砍去",
    "dodge": -30,
    "damage": 100,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N仰天一声清啸，斜行而前，一招「野马奔驰」，$w横削直击，迅捷无比",
    "dodge": 10,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N$w中宫直进，剑尖不住颤动，剑到中途，忽然转而向上，乃是一招「青山隐隐」",
    "dodge": 60,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N侧身闪过$n的攻势，斜刺一剑，还的是一招「古柏森森」",
    "dodge": -30,
    "damage": 130,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身形一顿，一招「苍松迎客」对准$n的$l斜斜刺出一剑",
    "dodge": 10,
    "damage": 140,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N说声: “好!”,接着$w扬空一闪，一招「天坤倒悬」刺向$n的$l",
    "dodge": -50,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一声清啸，叫道：“留神了！”一招「清风送爽」，急刺而出",
    "dodge": 10,
    "damage": 160,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N高高跃起，一招「流星赶月」，全身化作一道剑光,象一颗流星般直飞向$n",
    "dodge": 80,
    "damage": 180,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N侧身向右，$w斜挥，突然回头，剑锋猛地倒刺，正是华山剑法中一招妙着--「浪子回头」",
    "dodge": 100,
    "damage": 180,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，无法练习华山剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me) {
  if ((random((int)me->query_skill("sword", 1)) >= 150) &&
    ((int)me->query_skill("zixia-shengong", 1) >= 120) &&
    ((int)me->query_skill("huashan-sword", 1) >= 150) &&
    ((string)me->query_skill_mapped("force") == "zixia-shengong") &&
    ((int)me->query("force") > 100)) {
    if ((string)me->query("gender") == "女性") {
      me->add("force", -100);
      return ([
        "action":
        "$N一声清啸，剑锋闪烁不定，一招「" + HIM "无双无对" NOR + "」，手中$w猛地一剑挺出，当真是捷如闪电，势若奔雷",
        "dodge": 150,
        "damage": 250,
        "damage_type": "刺伤"
      ]);
    }
    if ((string)me->query("gender") == "男性") {
      me->add("force", -100);
      return ([
        "action":
        "$N将紫霞神功运至极至，脸上紫气顿时大盛，一招「" + HIM "紫电一式" NOR + "」，手中$w挟着一阵隆隆紫气直刺向$n",
        "dodge": -50,
        "damage": 300,
        "damage_type": "刺伤"
      ]);
    }
  }
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  int skill, combat_exp;

  combat_exp = (int)me->query("combat_exp");
  skill = (int)me->query_skill("huashan-sword", 1);

  if (skill * skill * skill / 10 > combat_exp)
    return notify_fail("你的实战经验不够，无法练习华山剑法。\n");


  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，无法练习华山剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍华山剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("huashan") + "/huashan-sword/" + action;
}
string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() {
  if ((string)this_player()->query_skill_mapped("force") == "zixia-shengong")
    return 16;
  else
    return 10;
}

int learn_bonus() {
  return -10;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 60;
}
