#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name("何掌柜", ({ "boss he","he","boss" }) );
	set("gender", "男性" );
	set("age", 51);
	set("title", GRN "济世堂老板"NOR);
	set("long",
		"这位济世堂老板医道精湛。救死扶伤无数。\n");
	set("combat_exp", 9000);
	set("attitude", "friendly");
	set("agi", 30);
	set("str", 130);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 30);
        set("score", 90000);
	set("vendor_goods", ([
                "/d/city/npc/obj/sendrug2":12,
                "/d/city/npc/obj/keedrug2":22,
                "/d/city/npc/obj/gindrug2":12,

	]) );
	set_skill("unarmed",300);
	set_skill("parry",250);
	set_skill("dodge",250);
	set_skill("iron_strike",300);
	set_skill("force",260);
	set_skill("lotusforce",260);
	map_skill("force","lotusforce");
	map_skill("unarmed", "iron_strike");
	setup();
	carry_object("/obj/cloth/changpao")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(20) ) {
		case 0:
message_vision("$N望了$n一眼，低声说道：你面黄肌瘦，肾水亏空，是否．．．过度？\n",this_object(),ob);
			break;
	}
}
