#include <ansi.h>

//inherit NPC;
//inherit F_VENDOR;
inherit F_VENDOR_SALE;

void create()
{
        set_name("娄老板", ({ "boss lou", "lou","boss" }) );
        set("gender", "男性" );
        set("age", 43);
	set("title", "店掌柜");
        set("long", "这是一位乐善好施的店掌柜。\n");
        set("combat_exp", 300000);
	set("str", 300);
        set("attitude", "friendly");
        set_skill("dodge", 100);
        set_skill("parry", 120);
        set("vendor_goods", ([
                "/d/city/npc/obj/shiyan":10,
                "/d/city/npc/obj/jiangyou":10,
                "/d/city/npc/obj/caiyou":10,
                "/d/city/npc/obj/baitang":10,
                "/topten/topten":10,
                "/obj/example/bag":20,
        ]) );

        setup();
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(10) ) {
                case 0:
                        say( " 娄老板笑着道：这位"
                                + RANK_D->query_respect(ob)
                                + "，买东西吗？ \n");
                        break;
                case 1:
                        say( " 娄老板笑着道：这位"
                                + RANK_D->query_respect(ob)
                                + "，买点杂货吧。 \n");
                        break;

        }
}



