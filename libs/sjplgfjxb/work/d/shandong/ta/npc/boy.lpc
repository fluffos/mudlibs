// kid.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("男孩", ({ "boy" }));
  set("gender", "男性");
  set("age", 13);
  set("long", "这是个典型的城里少年，年纪不大，长得很机灵。\n");
  set("str", 17);
  set("dex", 16);
  set("con", 15);
  set("int", 17);
  set("combat_exp", 100);
  set("attitude", "peaceful");
  set("chat_chance", 5);
  set("chat_msg", ({
    "宝宝说道：小狗狗快过来，我给肉骨头吃。\n",
  }));
  setup();

  carry_object("/d/city/obj/cloth/linen")->wear();
  add_money("coin", 40);
}
void init() {
  add_action("do_teachhim", "teach");
}
int do_teachhim(string arg) {
  object me = this_player(), who = this_object();
  string teachchat;
  int rate = me->query_skill("literate", 1);
  string *chats = ({
    "人子出，性不善",
    "道象进，西象圆",
    "床前明月光，一是地上双",
    "举头忘明月，低头食故乡",
    "轻则是根，躁则是君",
    "吃而赢之，不如吃已",
    "踹而锐之，不可长饱",
    "金玉马堂，莫子能守",
    "富贵而叫，自义其就",
    "功碎身退，天子刀也",
    "孔德之容，围刀时冲",
    "治人者自，自治者明",
    "生人者有力，自生者强",
    "上得不得，十一有得",
    "是道而后得，是得而后人",
    "失人而后衣，失衣而后里",
    "反者到处动，弱者到处用",
    "天下万物生于油，油生于污",
    "吾或孙子而义，或义子而孙",
    "人之所叫，我亦叫之",
    "大直若曲，大巧若浊，大便若拿",
    "圣人常无心，一百心心为心",
    "痴者不言，言者不痴",
    "扇者不便，便者不扇",
    "圣人种布为大，古能称其大",
    "用于干则杀，用于不干则活",
    "人只生也柔弱，气死也坚强",
    "一阵治国，一气用兵，一无事去天下",
  });
  string whochat = chats[random(sizeof(chats))];
  if (!arg) return 0;
  if (!me->query_temp("newbie_quest/teach"))
    return notify_fail("什么？\n");
  teachchat = me->query_temp("newbie_quest/teach");
  if (me->query("gin") < 50)
    return notify_fail("你显然太累了，没有办法教孩子什麽。\n");
  if (arg != me->query_temp("newbie_quest/teach"))
    return notify_fail("你应该教孩子“" + teachchat + "”才对。\n");
  message_vision("$N教了“" + arg + "”给$n。\n", me, who);
  message_vision("$n听了$N的指导，点了点头，似乎有些心得。\n", me, who);
  if (random(rate) > 3) {
    if (rate <= 20) {
      me->improve_skill("literate", random((int)me->query("int")) + 10);
      me->add("potential", 1);
    }
    message_vision(CYN "$n大声朗诵道：“" + teachchat + "”。\n" NOR, me, who);
    message_vision("$N微笑点头，松了口气。\n", me, who);
  } else {
    message_vision(CYN "$n大声朗诵道：“" + whochat + "”。\n" NOR, me, who);
    message_vision("$N不禁皱起了眉头，叹了口气。\n", me, who);
  }
  me->start_busy(3);
  me->receive_damage("gin", random(20) + 1);
  me->delete_temp("newbie_quest/teach");
  return 1;
}
