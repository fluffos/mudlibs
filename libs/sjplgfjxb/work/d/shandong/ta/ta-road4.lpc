// Room: /u/shandong/ta-road4.c

inherit ROOM;

void create() {
  set("short", "泰安城里");
  set("long", @LONG
这里是泰安城里的一条小街。由于西面是泰安城的衙门，这里非常
清净。衙门门口摆着一只大鼓(gu)，还有两只的石狮子。东面店铺外的
布幌子上赫然一个大字“衣”，看来是家成衣店。店铺左边还搭了个棚
子，棚子下面有五、六个洗染浆衣用的大缸(gang)。 
    往北走就快到城墙根了，
    往南走则一直通向南门。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "ta-yamen",
    "east": __DIR__ "ta-chengyidian",
    "north": __DIR__ "ta-road5",
    "south": __DIR__ "ta-road3",
  ]));
  set("item_desc", ([ /* sizeof() == 2 */
    "gu": "这是一面牛皮大鼓，是普通百姓报冤时使用的。如果你有冤情也可以(qiao)\n",
    "gang": "一口普通的大缸，成衣店的伙计们用来洗染浆衣。\n"
  ]));
  set("hell", 1);
  set("objects",
    ([  //sizeof() == 1
    "/obj/npc/shaonian": 1,
    ]));
  set("outdoors", "shandong");
}

void init() {
  add_action("do_qiao", "qiao");
}
int do_qiao(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "gu")) return notify_fail("你要敲什么？\n");
  else
    message_vision("               $N拿起鼓槌使劲的敲了几下鼓[咚！咚！咚！。。。],
               接着衙门内传来一阵叫骂[又是哪个王八蛋来捣乱！]\n", this_player());
  return 1;

  setup();
}
