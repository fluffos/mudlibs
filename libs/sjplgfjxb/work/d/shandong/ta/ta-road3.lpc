inherit ROOM;

void create()
{
        set("short", "泰安城里");
        set("long", @LONG
这里是泰安城中心的一个十字路口。两旁的人来来往往，不时有马
车通过。有些农民也在这里摆摊卖些山货以便挣些散钱养家糊口。路中
间有一块官府树立的牌子(board)，上面明确的注明了泰山的登山图，以
便游人登山。往西一直通到西门，往南则直通南门。东、北两面各有一
条小街。
    往西走一直通向西门，
    往南走一直通向南门，
    往东走是一条小街，
    往北走是一条小街。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"ta-road2",
  "east" : __DIR__"ta-road6",
  "north" : __DIR__"ta-road4", 
  "south" : __DIR__"ta-road8",
]));
        set("outdoors", "shandong");
	set("no_fight",1);
	set("no_steal",1);
	set("no_magic",1);
	set("hell",1);
	set("no_study",1);
        set("objects", 
        ([ //sizeof() == 1
                "/npc/newnpc/gongsunzuo" : 1,
                "/npc/newnpc/gongsunyou" : 1,
        ]));
	set("valid_startroom", 1);

        setup();
        call_other( "/obj/board/shandong_b", "???" );
}
