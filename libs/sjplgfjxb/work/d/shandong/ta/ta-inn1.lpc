// Room: /u/shandong/ta-inn1.c

inherit ROOM;

void create() {
  set("short", "宏泰酒楼");
  set("long", @LONG
这里是泰安城最大的“宏泰酒楼”。楼上楼下高朋满座。大多是来爬
泰山的游客，也有的是来拜访泰山派的武林中人，在此歇歇脚。这里的老
板娘据说和泰山派有不俗的交情，在江湖上极有名气。由于开了这酒楼她
的交际甚是广泛。一些江湖上的名人来吃饭她也不要钱，所以为下了不少
江湖豪杰。正中梁上悬着一块匾(bian)。五、六个伙计正楼上楼下忙的不
亦乐乎，见你进来打了个招呼就跑去忙别的了。
    二楼是雅座，
    往南走则是一条东西走向的小街。
LONG
  );
  set("exits", ([
    "south": __DIR__ "ta-road2",
    "up": __DIR__ "ta-inn2",
  ]));
  set("item_desc", ([
    "bian": "匾上龙飞凤舞的写着四个字[宏泰酒楼]，
                        旁边一行小字：裘剑飞题\n",
  ]));
  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/huoji": 2,
    ]));
  set("hell", 1);
  setup();
}
