inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("清汤面", ({ "mian" }));
    set_weight(1000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "一碗香喷喷的清汤面\n");
          set("unit", "碗");
          set("value", 30);
          set("food_remaining", 5);
          set("food_supply", 50);
     }
}


