inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("烤地瓜", ({ "digua" }));
    set_weight(1000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "山东著名小吃，一个大大的香香的烤地瓜\n");
          set("unit", "个");
          set("value", 30);
          set("food_remaining", 5);
          set("food_supply", 50);
     }
}


