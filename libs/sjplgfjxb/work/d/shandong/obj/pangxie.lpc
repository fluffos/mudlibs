inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("清蒸螃蟹", ({ "pangxie" }));
    set_weight(2000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "现在又大又好的螃蟹是不容易吃到了，可是古时候。。。。嘻嘻！\n");
          set("unit", "盘");
          set("value", 2000);
          set("food_remaining", 30);
          set("food_supply", 300);
     }
}


