// butchery.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "城北肉铺");
  set("long", @LONG
你现在正站在城北肉铺里，肉架上挂满了血淋淋的生肉，一股腥
气扑面而来，不时有几只苍蝇在屋里飞来飞去。
    靠近门口的地方有一块牛骨雕成的招牌(sign)，上面写着些
什么。
LONG
  );

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "east": __DIR__ "nwroad1" ]));

  set("objects", ([
    __DIR__ "npc/butcher": 1,
    __DIR__ "npc/fly": 2,
  ]));
  set("hell", 1);

  setup();

}

string look_sign(object me) {
  return (@LONG
本店即将收购死狗。
LONG);
}
