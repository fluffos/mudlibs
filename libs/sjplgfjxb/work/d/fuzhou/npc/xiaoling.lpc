
inherit NEW_VENDOR;

int on_service = 0;

void create()
{
	set_name("小玲", ({ "xiao ling", "ling" }) );
	set("gender","女性");
	set("age", 19);
	set("combat_exp",100000);
	set_skill("dodge",200);
	set_skill("unarmed",200);
	set_skill("spicyclaw",200);
	set_skill("force",200);
	set_skill("parry",200);
	set_skill("stormdance",200);
	set("force",3000);
	set("max_force",3000);
	set("food",200);
	set("water",200);
	set("per",40);
	set("force_factor",100);
	map_skill("unarmed","spicyclaw");
	map_skill("dodge","stormdance");
	set("long",
		"一个约十八、九岁的姑娘，容貌秀美，身体丰满，薄薄的纱衣无法遮掩她\n"
		"那高耸的胸部，她手上挽着一个小竹箩。\n");
	set("chat_chance", 1);
	set("chat_msg", ({
		"小玲冷冷地瞟了你一眼，轻轻叹了一口气。\n",
		"小玲出神地望着亭外的景色，似乎没有注意到有人走了进来。\n",
		"小玲忽然说道：要不要买点新奇的玩意？\n",
	}));
	set("merchandise", ([
		"/u/fuzhou/ghost_pill" : 5,
	]));
	setup();
	carry_object("/new/hangzhou/npc/obj/white_dress")->wear();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
	add_action("do_buy", "buy");
}


