// eba.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("恶霸", ({ "eba" }) );
        set("long",               
"这是一个专门欺负老百姓的恶霸，大家还是远远避开他为妙。\n");

//        set("attitude", "aggressive");
//        set("pursuer", 1);

        set("str", 40);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 120000);
	 set("score",3000);
	 set("daode",-1000);
        set("chat_chance", 10);
	 set("force",2500);
	 set("max_force",2500);
        set("force_factor",60);
        set("chat_msg", ({
                (: random_move :),
        }) );

        set_skill("unarmed", 100);
        set_skill("blade", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("force", 250);

        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 100);

        setup();
        add_money("gold", 2);
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/blade")->wield();

}

void init()
{
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	object me = this_object();
	if( !ob || environment(ob) != environment() ) return;
       if( ob->query("age")<15 ) return;
	if( ob->query("gender")=="女性" ) {
		say( "恶霸色迷迷地奸笑道：这位" + RANK_D->query_respect(ob)
			+ "，跟大爷我上床风流快活如何？\n");
	       me->fight_ob(ob);
              ob->fight_ob(me);
       }
       else {
              if( ob->query("combat_exp")<20000 && random(10)!=5 ) return;
              if( random(4)==1 ) {
		say( "恶霸“哼”的一声：大爷我今天对谁都看不顺眼，去死吧！\n");
	       me->kill_ob(ob);
              ob->fight_ob(me); }
	}
}




 
