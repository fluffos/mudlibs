#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("谢白石", ({ "xie baishi","xie" }) );
	set("gender", "男性" );
	set("nickname", HIW"七手神剑"NOR);
	set("title", "点苍派第三代弟子" );
	set("age", 25);
	set("long",
		"这位年轻人的脸上木无表情．．．\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",30);
	set("str", 130);
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("score", 90000);
	set("vendor_goods", ([
		"/d/city/npc/obj/zhiqian":14,
              "/d/city/npc/obj/zhihua":15,
		"/obj/paper_seal":20,
	]) );
	set_skill("sword",100);
	set_skill("unarmed",100);
	set_skill("parry",100);
	set_skill("wuxing-quan",100);
	set_skill("dodge",100);
	set_skill("force",100);
	set_skill("lotusforce",100);
	set_skill("xiaofeng-sword",100);
	map_skill("force","lotusforce");
	map_skill("unarmed","wuxing-quan");
	map_skill("parry","xiaofeng-sword");
	map_skill("sword","xiaofeng-sword");
        set_temp("apply/damage", 200);
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/longsword")->wield();
}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(10) ) {
                case 0:
message_vision("$N看了$n一眼道：木棺没货，都订了，太多人死了。\n",this_object(),ob);
                        break;
                case 1:
message_vision("$N向$n问道：谁死了？\n",this_object(),ob);
                        break;
        }
}

