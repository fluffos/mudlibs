// Room: /u/fuzhou/dukou.c

inherit ROOM;

void create() {
  set("short", "江北渡口");
  set("long", @LONG
这是个虽说不大却过客甚多的渡口。往北去是通往福州城里的青石
道，南面就是无风亦起浪的闽江了。江面有些渔船，你如果有自己的渔
船就可以出海捕鱼了(chuhai)。向南望去，隐约可见对岸凤凰山的轮廓
，山顶有袅袅炊烟升起。
LONG
  );
  set("objects", ([ /* sizeof() == 2 */
    //    __DIR__"npc/xiaoling" : 1,
  ]));
  set("outdoors", "fuzhou");
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "sroad1",
  ]));
  set("no_clean_up", 0);
  set("hell", 1);

  setup();
  //	replace_program(ROOM);
}
void init() {
  add_action("do_chuhai", "chuhai");
}

int do_chuhai() {
  object boat;
  object me = this_player();
  if (!me->query_temp("fuzhou_boat"))
    return notify_fail("你没有船只，如何出海？\n");
  tell_object(me, "你将渔网、渔钩等捕鱼工具搬上了渔船。\n");
  message_vision("$N架着小舟出海去了...\n\n", this_player());
  boat = new("/d/fuzhou/boat");
  me->move(boat);
  message_vision("\n$N扬起了风帆，迎着轻柔的海风，渔船缓缓驶入了东海海域。\n", this_player());
  return 1;
}
