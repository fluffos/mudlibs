// status cmds (Baiwt  08-04-99)
 
#include <ansi.h>
 
inherit F_CLEAN_UP;
 
string status_color(int current, int max);
 
int main(object me, string arg)
{
	object ob;
	mapping my;

	seteuid(getuid(me));

	if(!arg)
		ob = me;

	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
		return notify_fail("只有巫师能察看别人的状态。\n");
       if (!ob->query("guanfu/battle")) return notify_fail("干什么？\n");
 
	my = ob->query_entire_dbase();

        if ( ob->query("guanfu/battle") == "surface" )
	{
    printf(HIC"    官衔：先锋大将\n\n"NOR
                );

    printf(HIW" 步兵  ： %s%4d/ %4d %s(%3d%%)" HIR "	士气： %d\n" NOR,
                status_color(my["kee"]*100/3, my["eff_kee"]*100/3), my["kee"]*100/3, my["eff_kee"]*100/3,
                status_color(my["eff_kee"]*100/3, my["max_kee"]*100/3),my["eff_kee"] * 100 / my["max_kee"],
                (my["food"]+my["water"])*10/3
                );
    printf(HIY" 骑兵  ： %s%4d/ %4d %s(%3d%%)" HIC "	阵型： %s\n" NOR,
                status_color(my["sen"]*100/3, my["eff_sen"]*100/3), my["sen"]*100/3, my["eff_sen"]*100/3,
                status_color(my["eff_sen"]*100/3, my["max_sen"]*100/3),     my["eff_sen"] * 100 / my["max_sen"],
                ob->query("battle/zhenxing")
                );
	return 1;
	}

        if ( ob->query("guanfu/battle") == "navy" )
	{
    printf(HIC"    "+ me->query("navy_type")+ "战船" + my["kee"]/6 + "艘。\n\n"NOR
                );

    printf(HIW" 士兵  ： %s%4d/ %4d %s(%3d%%)" HIR "	装备： %s(%d)\n" NOR,
                status_color(my["kee"]*100/6, my["eff_kee"]*100/6), my["kee"]*100/6, my["eff_kee"]*100/6,
                status_color(my["kee"]*100/6, my["eff_kee"]*100/6),my["kee"] * 100 / my["eff_kee"],
                ob->query("battle/equip"), my["gin"]*100/3
                );
    printf(HIY" 装甲  ： %s%4d/ %4d %s(%3d%%)" HIC "	粮草： %d\n" NOR,
                status_color(my["sen"]*100/6, my["eff_sen"]*100/6), my["sen"]*100/6, my["eff_sen"]*100/6,
                status_color(my["eff_sen"]*100/6, my["max_sen"]*100/6),     my["eff_sen"] * 100 / my["max_sen"],
                my["water"]*100/6
                );
	return 1;
	}
	else
	return 1;
}
 
string status_color(int current, int max)
{
	int percent;
 
	if( max>0 ) percent = current * 100 / max;
	else percent = 100;
	if( percent > 100 ) return HIC;
	if( percent >= 90 ) return HIG;
	if( percent >= 60 ) return HIY;
	if( percent >= 30 ) return YEL;
	if( percent >= 10 ) return HIR;
	return RED;
}
