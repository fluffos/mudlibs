#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("许钟梁", ({ "xu zhongliang", "xu","master" }) );
        set("long",
                "长安知府，负责刑部各类案件和长安城的治安。\n");
	set("nickname", GRN"铁面无私"NOR);
	set("title","刑部尚书");
        set("attitude", "heroism");
	set("student_title","官员");
	create_family("朝廷",6,"官员");
	set("vendetta_mark", "authority");
	set("str", 30);
	set("int", 30);
	set("cor", 30);
	set("spi", 30);
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("score", 90000);
//	set_temp("apply/damage",30);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/move", 30);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "blade.yezhanbafang" :),
        }) );
        set("combat_exp", 3200000);
        set_skill("unarmed", 200);
	set_skill("blade",200);
	set_skill("force",200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
	set_skill("xingyi-ken",200);
	set_skill("chaos-steps",100);
	set_skill("duanmen_blade",200);
	set_skill("bixueforce",150);
        set_skill("move", 100);
	set_skill("literate",150);
	set_skill("leadership",150);
	set_skill("officialism",150);
	map_skill("unarmed","xingyi-ken");
	map_skill("dodge","chaos-steps");
	map_skill("force","bixueforce");
	map_skill("blade","duanmen_blade");
        setup();

        carry_object(__DIR__"obj/guanfu2")->wear();
        carry_object("/d/city/obj/weapon/blade/gudingdao")->wield();
}

void attempt_apprentice(object me)
{
 	if( !me->query("class"))
	{
	command("smile");
	command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
	}
	else {
	if(me->query("id_type") == 3)
	{
	command("say 你已经是吏部的官员了！\n");
	}
        else {
	if(me->query("id_type") == 4)
	{
	command("say 你已经是兵部的官员了！\n");
	}
	else 
        command("say 朝廷不需要你这种不三不四，来历不明之人！\n");}
        }
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
		ob->set("vendetta_mark", "authority");
                ob->set("id_type", 5);
}
/*
void init()
{
        add_action("give_quest", "quest");
}
*/
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","捕快");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","捕头");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","刑部管事");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","刑部侍郎");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","中书令");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","御史中丞");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","中常侍");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","长史");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","太傅");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","安远侯");
                return ;
        } else
                student->set("title","大司农");
                return ;

}

