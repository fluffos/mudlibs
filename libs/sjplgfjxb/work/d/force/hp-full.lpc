// hp-full.c

inherit SSERVER;

int exert(object me, object target)
{
	 if(wizardp(me) || me->query("wiz") ) {
        target->receive_curing("kee", 10000 );
        target->receive_curing("gin", 10000 );
        target->receive_curing("sen", 10000 );
        target->receive_heal("kee", 10000);
        target->receive_heal("gin", 10000);
        target->receive_heal("sen", 10000);
	 target->set("force",target->query("max_force")*2 -1 ); 
	 write("ok\n");
	 if(target!=me) 
        message_vision("$N默运九天神功为$n疗伤，$n突然吐出一口瘀血，身体竟然完全康复了。\n", me,target);
     }
	 else write("你的气太少！\n");
        return 1;
}
