//changan city

inherit ROOM;

void create() {
  set("short", "白虎大街");
  set("long", @LONG

你走在一条宽阔的石板大街上，北面就快到东市中心了，可以看到钟楼
耸立于前。西面是一家著名的镖局，有天下第一镖局之称的红旗镖局。东面
是一家酒馆，整天看见客人进进出出，显得生意很兴隆。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "baihu-s2",
      "north": __DIR__ "dongshi-center",
      "west": __DIR__ "biaoju/damen",
      "east": __DIR__ "jiuguan",
    ]));

  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
