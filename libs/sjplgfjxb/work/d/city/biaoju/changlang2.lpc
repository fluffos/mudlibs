//biaoju changlang2.c
inherit ROOM;

void create ()
{
        set ("short", "长廊");
        set ("long", @LONG
这是一条宽阔的长廊。不时你能看到有人沿着这里匆匆走过。沿着这里
你能通往镖局的每一个地方。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
           	"west" : __DIR__"changlang1",
		"east" : __DIR__"changlang3",
	       "south" : __DIR__"huiketing", 

        ]));

        set("objects", 
        ([ //sizeof() == 1
              __DIR__"npc/huhaiqiu" : 1,
   
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}

int valid_leave(object me,string dir)
{
        if(dir=="west" && present("hu",environment(me)) && me->query("class")!="biaoju") 
             return notify_fail("胡海秋一手拦住，说道；“非本镖局的弟子不能往里走 ！”\n");
        return ::valid_leave(me,dir);
}

