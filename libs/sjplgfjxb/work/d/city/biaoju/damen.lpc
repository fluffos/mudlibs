//biaoju damen.c
inherit ROOM;

void create ()
{
 set ("short", "红旗镖局大门")
;
        set ("long", @LONG
你来到一座建构宏伟的宅第之前，在大宅之前的左右两座石坛中各竖一
根两丈来高的旗杆，杆顶飘扬青旗。右首旗上黄色丝线绣著一头张牙舞爪、
神态威猛的雄狮，旗子随风招展，显得雄狮更奕奕若生。左首旗上绣著「红
旗镖局」四个黑字，银钩铁划，刚劲非凡。大宅朱漆大门，门上茶杯大小的
铜钉闪闪发光，门顶匾额写著「红旗镖局」四个金漆大字．门口站着两名劲
装结束的汉子，腰板笔挺，显出一股英悍之气。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
		"east" : "/d/city/baihu-s1",
		"west" : __DIR__"dayuan",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//		__DIR__"npc/dahan" : 2,
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}


