inherit ROOM;

void create ()
{
        set ("short", "卧室");
        set ("long", @LONG
你走进了局主的卧室，这里的摆设十分简单，最显眼的就是迎面的一张
紫檀木的大床．床上铺有厚厚的戎垫，躺上去一定很是舒服。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "north" : __DIR__"shufang",
              "south" : __DIR__"changlang7",

        ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/masterqiu" : 1,
        ]));

	set("no_clean_up", 0);
	        setup();
}


