//biaoju fanting.c
inherit ROOM;

void create ()
{
        set ("short", "饭厅");
        set ("long", @LONG
这里是一个极大的饭厅，当中摆着着一排长桌，桌上铺着雪白的桌布．
桌面上有大碗的米饭，肚子饿了可以吃(eat) 一点，西边的角放了一个水
缸，旁边放了一个勺子，你可以用勺子盛水来喝(drink)。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "east" : __DIR__"changlang4",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//		__DIR__"npc/yue" : 1,
        ]));
	set("no_clean_up", 0);
	        setup();
}

void init()
{
	add_action("do_eat", "eat");
	add_action("do_drink", "drink");
}

int do_eat()
{
	if( this_player()->is_busy() )
		return notify_fail("你正忙着其他事情呢。\n");
	if( (int)this_player()->query("food") >= (int)this_player()->max_food_capacity() )
		return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
	this_player()->add("food", 40);
	if( this_player()->is_fighting() ) this_player()->start_busy(2);

	message_vision("$N拿起一碗白米饭吃了几口。\n", this_player());

	return 1;
}

int do_drink()
{
	if( this_player()->is_busy() )
		return notify_fail("你正忙着其他事情呢。\n");
	if( (int)this_player()->query("water") >= (int)this_player()->max_water_capacity() )
		return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
	this_player()->add("water", 40);
	if( this_player()->is_fighting() ) this_player()->start_busy(2);

	message_vision("$N拿起勺子往水缸里盛了一些清水喝了几口。\n", this_player());

	return 1;
}


