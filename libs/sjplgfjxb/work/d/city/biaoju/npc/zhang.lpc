#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_quest();

void create()
{
        set_name("张华堂", ({ "zhang huatang", "zhang" }) );
	 set("nickname","逾越剑客");
        set("gender", "男性");
        set("age", 36);
        set("long",
"张华堂主要负责办理红旗镖局的接镖护镖事宜，是邱震海的得力助手。\n" );
        set("inquiry", ([
                "here": "这里是闻名天下的红旗镖局。",
                "quest" : (: about_quest :),
        ]) ); 
        set("attitude", "peaceful");
        set("str", 26);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
        set("force", 800);
        set("max_force", 800);
        set("force_factor",20);
        set("combat_exp",800000);
	set("class", "biaoju");
        set_skill("unarmed", 90);
        set_skill("sword", 90);
        set_skill("force", 90);
        set_skill("parry", 90);
        set_skill("dodge", 90);

        set_skill("three-sword",90);
        set_skill("xingyi-ken", 90);
        set_skill("taiji-force", 90);
        set_skill("tiyunzong", 90);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "xingyi-ken");
        map_skill("force", "taiji-force");
        map_skill("sword", "three-sword");
        map_skill("parry", "three-sword");

        create_family("红旗镖局", 3, "镖师");

        setup();

        carry_object("/obj/longsword")->wield();
	carry_object(__DIR__"obj/jinzhuang")->wear();
}
void init()
{
	add_action("do_cancel", "cancel");
}

int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!(int)me->query("quest/biaoju")||(int)me->query("quest/biaoju")==0)
          return notify_fail("你现在没有任务。\n");
	say( CYN"张华堂叹道：不想做了吗？好吧，你自己反省一下。\n"NOR);
	if( (int)me->query("combat_exp") <= 100 ) 
		{
			me->set("quest/biaoju", 0);
			me->unconcious();
			return 1;
		}
	me->add("combat_exp", -100);
	me->set("quest/biaoju", 0);
	me->unconcious();
	return 1;
}

int about_quest()
{
	int task, rate;
	object me, biaoche, target;
	me=this_player();
//	if ((string)me->query("class") != "biaoju")
//	return notify_fail("对不起，你不是镖局的镖师。\n");
	if( this_object()->is_busy() )
		return notify_fail("张华堂说道：现在没有人托镖。\n");
	task=random(6);
	if ((int)me->query("quest/biaoju")==0)
{
	if(task<1){
	say( CYN"张华堂说道：现在没有人托镖。\n\n"NOR);
	this_object()->start_busy(7);
	return 1;
	}
 	if(task==2){
     command("say 速把镖车送往太室山庄。");
	me->set("quest/biaoju","taishi");
	biaoche=new(__DIR__"obj/biaoche");
	biaoche->move(environment(me));
      biaoche->set("possessed", me);
	biaoche->set_leader(me);
	return 1;
	}
	if(task==3){
       command("say 速把镖车送给扬州老万。");
	me->set("quest/biaoju","yangzhou");
	biaoche=new(__DIR__"obj/biaoche");
	biaoche->move(environment(me));
       biaoche->set("possessed", me);
	biaoche->set_leader(me);
	return 1;
}
	if(task==4){
       command("say 速把镖车送往金陵燕堂。");
	me->set("quest/biaoju","jinling");
	biaoche=new(__DIR__"obj/biaoche");
	biaoche->move(environment(me));
       biaoche->set("possessed", me);
	biaoche->set_leader(me);
	return 1;
}
	if(task==5){
	say( CYN"张华堂说道：把这个包裹送给金陵一个叫捣衣客的人。\n\n"NOR);
	biaoche=new(__DIR__"obj/biaohuo");
	biaoche->move(me);
	target=new(__DIR__"daoyike");
	rate=random(3);
	if( rate<=1)
	target->move("/d/jinling/fuzimiao.lpc");
	if( rate==2)
	target->move("/d/jinling/yuhuatai.lpc");
	if( rate==3)
	target->move("/d/jinling/jiulou.lpc");
	me->set("quest/biaoju","daoyi");
	return 1;
	}
	if(task==6){
	say( CYN"张华堂说道：把这个包裹送给扬州一个叫断弦客的人。\n\n"NOR);
	biaoche=new(__DIR__"obj/biaohuo");
	biaoche->move(me);
	target=new(__DIR__"duanxianke");
	rate=random(3);
	if( rate<=1)
	target->move("/d/yangzhou/yizhan.lpc");
	if( rate==2)
	target->move("/d/yangzhou/qinglou.lpc");
	if( rate==3)
	target->move("/d/yangzhou/jiulou.lpc");
	me->set("quest/biaoju","duanxian");
	return 1;
	}
	if(task==1){
	say( CYN"张华堂说道：把这个包裹送给关外一个叫纵酒客的人。\n\n"NOR);
	biaoche=new(__DIR__"obj/biaohuo");
	biaoche->move(me);
	target=new(__DIR__"zongjiuke");
	rate=random(3);
	if( rate<=1)
	target->move("/u/guanwai/niaodao.lpc");
	if( rate==2)
	target->move("/u/guanwai/simen.lpc");
	if( rate==3)
	target->move("/u/xiyu/xxroad3.lpc");
	me->set("quest/biaoju","zongjiu");
	return 1;
	}
	return 1;
}
	else{
	command("say 你还站在这里干什么？还不快去做任务？");
	return 1;
	}
	command("say 现在正有一趟镖要送往关外。");
	return 1;
}



