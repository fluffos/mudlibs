
inherit NPC;

void create()
{
        set_name("镖师", ({ "biaoshi", "biao"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位高达六尺的镖师。\n");
        set("combat_exp", random(20)*1000+20000);
        set("attitude", "friendly");
        set_skill("hammer", 90);
	set_skill("dodge", 100);
        set("iron-cloth", 200);
        set("chat_chance", 10);
        set("chat_msg", ({
		"镖师一声大喊: 大～～展～～红～～旗～～！\n",
        }) );
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
	carry_object(__DIR__"obj/stonehammer")->wield();
}

