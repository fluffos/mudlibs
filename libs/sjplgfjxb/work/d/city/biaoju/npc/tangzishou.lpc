
inherit NPC;
string reward_more( object who);

void create()
{
        set_name("趟子手", ({ "tang", "zhi"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位体态轻盈的趟子手。\n");
        set("combat_exp", random(20)*1000+10000);
        set("attitude", "friendly");
        set_skill("unarmed", 90);
	set_skill("dodge", 100);
        set("chat_chance", 5);
        set("chat_msg", ({
                "趟子手又在一人多高的梅花桩上练习了一遍。\n",
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 15000 ) return "1";
			if( enemy[i]->query("combat_exp") > 20000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
			enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}

