#include <ansi.h>
inherit NPC;

void create()
{
    set_name("强盗", ({ "qiang dao","dao","robber" }) );
    set("long","一位十分凶悍的绿林劫匪。\n");
    set("age", 20+random(20));
    set("str", 20+random(20));
	set("gender", "男性");
	set("attitude", "aggressive");
	set("bellicosity", 5000 );
	seteuid(getuid());
    set_skill("unarmed",random(50));
    set_skill("blade",random(50));
    set_skill("dodge",random(50));
    set("combat_exp", random(50)*1000+10000);
    setup();
        carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
        carry_object("/u/baiwt/xueshan/obj/blade")->wield();
}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	object biaoche;
	if (present("biao che", environment(this_object() )))
	biaoche = present("biao che", environment(this_object() ));
	message("vision",
		 name() + "收起了单刀。\n\n"
		+ name() + "匆匆离开了。\n" , environment(),
		this_object() );
	if (present("biao che", environment(this_object() )))
	destruct(biaoche);
	destruct(this_object());
}
