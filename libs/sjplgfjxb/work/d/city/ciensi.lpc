//changan city

inherit ROOM;

void create() {
  set("short", "大慈恩寺");
  set("long", @LONG
大慈恩寺是长安城里规模最大的一家寺院了。整日里香烟袅绕，颂经声
不绝于耳。来这里上香还愿的善男信女也特别多，若到了皇道吉日，更是人
山人海。大家都相信到这里来烧一拄香可以除却往日的恩怨。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "zhuque-s4",
      "east": __DIR__ "baihu-s3",
      "south": __DIR__ "baodian",
      "north": __DIR__ "famous",
      "up": "/d/wiz/hall",
    ]));
  set("oldarea", 1);
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  set("no_study", 1);
  set("objects",
    ([  //sizeof() == 1
    //            __DIR__"npc/sengren0" : 1,
    //		__DIR__"npc/sengren" : 2,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/changan_b", "???");
}
void init() {
  add_action("do_throw", "throw");
}

int do_throw(string arg) {
  return 1;
}


int valid_leave(object me, string dir) {
  if (dir == "up" && !wizardp(me))
    return notify_fail("那里只有巫师才能进去。\n");
  return ::valid_leave(me, dir);
}
