#include <ansi.h>
#include <room.h>

inherit ROOM;
void init();
int do_push(string);
void create() {
  set("short", "地窖");
  set("long", @LONG
这是一个阴暗潮湿的地窖，只有顶上被石板覆盖的缝隙透下一点光亮。
LONG
  );
  set("exits", ([
    "westup": __DIR__ "jiuguan",
  ]));
  set("objects", ([
    "/obj/slumber_drug": 3,
    "/d/city/obj/book/kongzhang.lpc": 1,
  ]));
  create_door("westup", "青石地板", "eastdown", DOOR_CLOSED);
  setup();
}
