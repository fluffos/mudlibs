//changan city

inherit ROOM;

void create ()
{
        set ("short", "白虎大街");
        set ("long", @LONG

你走在一条宽阔的石板大街上，这是白虎大街的南段。西边是长安城
最大的一家赌场，整日热闹非凡，进进出出的客人有达官贵人，南来北往
的商旅，浪迹天涯的游子，三五成群的兵士，有时也能看见一些作俗客打
扮的僧人或道士。东面是一家兵器铺。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"baihu-s3",
                "north" : __DIR__"baihu-s1",
                "west" : __DIR__"club",
                "east" : __DIR__"bingqipu",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/lidx" : 1,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}


