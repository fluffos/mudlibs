//changan city

inherit ROOM;

void create ()
{
        set ("short", "西市中心");
        set ("long", @LONG

这里便是长安城的中心，四条大街交汇于此。一座巍峨高大的钟楼耸
立于前，很是有些气势。每到清晨，响亮的钟声便会伴着淡淡雾气传
向长安城的大街小巷。路口车水马龙，来往人潮不断。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"qinglong-s1",
                "north" : __DIR__"qinglong-n1",
                "west" : __DIR__"xuanwu-w2",
                "east" : __DIR__"xuanwu-w1",
        ]));
        set("objects", 
        ([ //sizeof() == 1
              __DIR__"npc/jiading2" : 1,
              __DIR__"npc/jiading" : 1,
              __DIR__"npc/zhangdh" : 1,
        ]));

        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

