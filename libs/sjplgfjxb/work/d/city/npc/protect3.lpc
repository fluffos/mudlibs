#include <ansi.h>

inherit NPC;
int about_he();
void summon_more(object me);
void summon_me(object me);

void create()
{
	set_name("唐多智", ({ "tang duozhi", "tang" }));
	set("long",
	    "这是一个四十五六岁的中年人, 浓眉大眼,\n"+
	    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n"+
	    "他神色凛然.\n");
	set("title", HIR"大内高手"NOR);
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIB "鬼影子" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 60);
        set("int", 30);
        set("cor", 60);
        set("agi", 60);
        set("kar", 30);
        set("spi", 30);
	set("kee", 10000);
	set("max_kee", 10000);
	set("sen", 5000);
	set("max_sen", 5000);

        set("force", 15000);
        set("max_force", 15000);
        set("force_factor", 60);

        set("atman", 2000);
        set("max_atman", 2000);
        set("atman_factor", 50);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 50);

        set("inquiry", ([
                "悔过" : (: about_he :),
        ]));

        set("combat_exp", 3500000);
        set("score", 20000);

        set_skill("literate", 300);
        set_skill("force", 300);
        set_skill("unarmed", 300);
        set_skill("dagger", 300);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("move", 300);
	  set_skill("piaoxue-strike",200);
	  set_skill("zhichi-dagger",200);
        set_skill("canyun_force", 200);
        set_skill("fengxue-steps", 250);

        map_skill("force", "canyun_force");
        map_skill("parry", "zhichi-dagger");
        map_skill("dagger", "zhichi-dagger");
        map_skill("unarmed", "piaoxue-strike");
        map_skill("dodge", "fengxue-steps");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
		(: summon_me(this_object()) :),
//           (: perform_action, "dodge.xuedipiaofeng" :),
	}) );
	set_temp("apply/damage",50);
	set_temp("apply/armor",50);

	setup();
        carry_object("/obj/cloth/changpao")->wear();
	carry_object("/obj/weapon/m_weapon/dagger")->wield();
}

void summon_more(object me)
{
	string msg;
	if ( me->query("kee") != me->query("max_kee") )
	{
	msg = HIW"\n$N运起九死还生功，内劲鼓动之下，刹那间所有伤痛都恢复了！\n\n" NOR;
	message_vision(msg, me);
	me->set("max_kee", (int)me->query("max_kee"));
	me->set("eff_kee", (int)me->query("max_kee"));
	me->set("kee", (int)me->query("max_kee"));
	}
	return;
}
void summon_me(object me)
{
	string msg;
	if ( me->query("kee") != me->query("max_kee") )
	{
	msg = HIR"\n$N突然一声暴喝，风卷残云功运到了最高境界，四周骤然起了一阵狂风！\n\n" NOR;
	message_vision(msg, me);
	me->set("str", 100);
	me->set("cor", 200);
	me->set_skill("unarmed", 400);
	me->set_skill("parry", 400);
	me->set_skill("dagger", 400);
	me->set_skill("iron-cloth", 300);
	me->set_skill("dodge", 400);
	me->set("force", 15000);
	me->set("max_force", 15000);
	me->set("force_factor", 300);
	}
	return;
}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	object owner;
	message("vision",
		HIC+ name() + "身影闪了闪，眨眼便不见了...\n\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

int about_he()
{
	object me = this_player();
	if( me->query("deposit") > 5000000 )
	{
      command("say 念你有悔过之心，暂且饶你一命。没收你的所有财产，今后好自为之！\n");
	me->set("deposit", 0 );
	me->set("auto_old_pks", (int)me->query("try_kill_newbie") );
	me->remove_all_killer();
	return 1;
	}
	else
      command("say 你丝毫没有诚心悔过之意，哪能饶你！\n");
	return 1;
}