inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
	set_name( "李勤文" , ({ "li zongguan", "li", "zongguan" }) );
	set("title", HIY"大内总管"NOR);
	set("nickname", HIG "快笔先生" NOR);
	set("gender", "男性");
	set("age", 45);
	set("long",
		"李总管是皇上身边的红人，掌管着大内御苑一切事物。据说他以前是个著名的商人。\n");
	set("attitude", "peaceful");
       set("skill_public",1);
	set("str", 126);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);
        set("chat_chance", 1);
        set("chat_msg", ({
                "李总管弹了弹身上的一丝灰尘．．．．\n",
        }) );
	set("id_type", 3);
	set("vendetta_mark", "authority");

	set("force", 4000);
	set("max_force", 8000);
	set("force_factor", 10);
	set("combat_exp", 100000);

	set("relation_exp", 1000000);
	set("score", 200000);

	set_skill("unarmed", 20);
	set_skill("parry", 20);
	set_skill("force", 40);
	set_skill("trade", 100);
	set_temp("apply/attack",30);
	set_temp("apply/damage",30);

	create_family("朝廷",5,"官员");
	setup();

}
int accept_fight(object me)
{
        return 0;
}
void init()
{
        add_action("give_quest", "quest");
}
int accept_object(object who, object ob)
{
        int  exp, pot, score, val;
	object wage;
	string test;
	mapping quest;
	val = ob->value();
	if (val && val >10000 && val < 20000)
	{
		       who->set("quest", 0 );
       	 	tell_object(who,"李总管说道：好吧，这个任务就算了吧．．\n");
		who->delete_temp("quest_number");
		return 1;
	}
        if(!(quest =  who->query("quest")))
	{
        tell_object(who,"李总管说道：这不是我想要的。\n");
	return 0;
	}
        if( (string)ob->query("name") != quest["quest"])
        {
        tell_object(who,"李总管说道：这不是我想要的。\n");
        return 0;
        }
	if( ob->is_character())
        {
        tell_object(who,"李总管说道：这不是我想要的。\n");
        return 0;
        }
        if( (string)who->query("class") != "official")
        {
        tell_object(who,"李总管说道：干得不错，可惜你没有为朝廷效力，没法给你赏赐。\n");
        return 1;
        }
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"李总管说道：真可惜！你没有在指定的时间内完成！\n");
                        return 1;
        }
        else
        {
        tell_object(who,"李总管说道：干得好，这是给你的赏赐！\n");
	exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2)+1;
// put a cap
	if(exp > 150) exp = 150;
	exp = exp * (int) who->query_temp("quest_number");
	pot = exp / 5 + 1;
//	due to weekly quest, each quet worth 20
//	score = quest["score"]/2 + random(quest["score"]/2);
	score = 1;
	wage = new("/obj/money/ten-cash.lpc");
	who->add("relation_exp",exp);
	who->add("potential",pot);
	who->add("score",score);
	wage->move(who);
        tell_object(who,HIW"你获得了：\n" +
	chinese_number(exp) + "点人际关系\n"+
	chinese_number(pot) + "点潜能\n" +
	chinese_number(score)+"点声望\n"NOR);
	who->set("quest", 0 );
                        return 1;
        }
                return 1;
}
int recognize_apprentice(object ob)
{
return 1;
}

