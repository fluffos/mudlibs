#include <armor.h>
inherit CLOTH;
void create() {
  set_name("订做的", ({ "order" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_drop", 1);
    set("owner", "sjpl");
    set("no_get", 1);
    set("material", "cloth");
    set("armor_prop/armor", 10);
    //		set("armor_type", "cloth");
  }
  setup();
}
