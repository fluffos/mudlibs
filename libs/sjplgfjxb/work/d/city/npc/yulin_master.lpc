// /d/city/npc/yulin_master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_quest();
string	summon_more( object who);
void create()
{
        set_name("龙飞虎", ({ "long feihu", "long","master" }) );
        set("long",
                "长安城御林军统帅，负责保护皇城的安全。\n");
	set("nickname", RED"神勇无敌将"NOR);
        set("attitude", "heroism");
	set("student_title","官员");
	create_family("朝廷",6,"官员");
	set("title", "御林军统帅");
	set("vendetta_mark", "authority");
	set("id_type", 4);
	set("str", 90);
	set("int", 30);
	set("cor", 30);
	set("spi", 30);
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 30);
        set("score", 90000);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/move", 50);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
              (: perform_action, "axe.kaitianpidi" :),
		(: summon_more(this_object()) :),
        }) );
        set("combat_exp", 9000000);
        set("relation_exp", 90000);
        set("life_exp", 50000);

        set_skill("unarmed", 200);
	set_skill("axe",300);
	set_skill("force",280);
        set_skill("parry", 200);
        set_skill("dodge", 210);
	set_skill("xingyi-ken",200);
//	set_skill("steps",60);
	set_skill("pangu_axe",300);
	set_skill("bixueforce",250);
        set_skill("move", 200);
	set_skill("literate",130);
	set_skill("officialism",250);
	set_skill("strategy",250);
	map_skill("unarmed","xingyi-ken");
//	map_skill("dodge","steps");
	map_skill("force","bixueforce");
	map_skill("axe","pangu_axe");
        set("inquiry", ([
                "quest" : (: about_quest :),
        ]));
        setup();

        carry_object("/obj/cloth/tiejia")->wear();
        carry_object("/d/city/obj/weapon/axe/huafu")->wield();
}

void attempt_apprentice(object me)
{
       if(me->query_skill("officialism",1)< 40) {
	    command("say 你的为官之道太差了。\n");
	    return;
	}	
        if( me->query("class") == "official" ) 


	{
	command("smile");
	command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
	}
	else
	{
	command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
	return;
	}
	if(me->query("id_type") == 3)
	{
	command("say 你已经是吏部的官员了！\n");
	}
	if(me->query("id_type") == 5)
	{
	command("say 你已经是刑部的官员了！\n");
	}
	    return;
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
		ob->set("vendetta_mark", "authority");
                ob->set("id_type", 4);
                ob->set("title", "小兵");
}
void init()
{
	add_action("do_cancel", "cancel");
}
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("relation_exp")*10+(int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","小兵");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","校尉");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","中郎将");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","牙将");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","偏将");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","参将");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","副将");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","大将军");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","兵马统领");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","兵马大都督");
                return ;
        } else if ( exp <= 16244000 ) {
                student->set("title","平西王");
                return ;
}
}
string summon_more(object who)
{
	object soldier;
	seteuid(getuid());
	soldier = new("/obj/npc/bodyguard");
	soldier->move(environment(who));
	command("escort");
	return "1";
}
int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!me->query("quest/battle"))
          return notify_fail("你现在没有任务。\n");
	message_vision("\n$N向龙飞虎请罪。\n",me);
	say( CYN"\n龙飞虎怒声说道：哼，你还有何面目回来见我？推出去斩了！\n"NOR);
	message_vision(RED"\n两旁刀斧手一涌而上，将$N押往午门。\n"HIW,me);
	me->move("/d/city/wumen");
	message_vision(HIR"\n$N被五花大绑推上了断头台。\n"NOR,me);
	message_vision(HIR"\n刀斧手手起刀落，将$N的人头砍了下来。。。\n"NOR,me);
	if( me->query("quest/battle"))
	me->delete("quest/battle");
	if( me->query("quest/guanfu"))
	me->delete("quest/guanfu");
	if( me->query("battle/equip"))
	me->delete("battle/equip");
	me->die();
	return 1;
}
int about_quest()
{
	object enemy, armymen;
	object me=this_player();
	string enemyname;
	int rate;
	rate = random(60);
	if( me->query("class") != "official" ) return 0;
	if( (int)me->query("id_type") != 4 ) return 0;
	if( (int)me->query("combat_exp") + (int)me->query("relation_exp") < 150000 ) 
		{say("龙飞虎说道：你的官位还不足以领军打仗。\n");
		return 1;}
	if( (int)me->query_skill("strategy") < 10 ) 
		{say("龙飞虎说道：你先去学点兵法再说！\n");
		return 1;}
	if( me->query("quest/battle") ) 
		{say("龙飞虎说道：你正有军务在身！\n");
		return 1;}
	if( rate < 1 ) 
		{say("龙飞虎说道：目前边关没有战事。\n");
		me->start_busy(2);
		return 1;}
	if( rate <30 ) 
		{command("say 速去军校场听候浑缄元帅调遣。\n");
		me->set("quest/battle", "masterhun");
		return 1;}

	enemy = new("/u/xiyu/npc/xiongnu1");
	enemy->move("/u/xiyu/battle5");
	enemyname = enemy->query("name");
	enemy->set("combat_exp", (int)me->query("combat_exp") *3/2 );
	me->set("battle/reward", 1000);
	me->set("quest/battle", enemyname+"的首级");
	say(CYN"龙飞虎说道：匈奴敌寇屡犯我边境，边关百姓苦不堪言！\n"NOR);
	say(CYN"龙飞虎说道：现令你速带援军西出玉门关抗敌，务必提敌将"+enemyname+"的首级前来见我！\n"NOR);

	armymen = new("/u/xiyu/npc/army_"+(string)(random(4)+1) );
	armymen->move(environment(me));
	armymen->set("possessed",me);
	armymen->set("player_army",me->query("id"));
	armymen->set_leader(me);
	armymen->set("quest/battle", 1);

	armymen = new("/u/xiyu/npc/army_"+(string)(random(4)+1) );
	armymen->move(environment(me));
	armymen->set("possessed",me);
	armymen->set("player_army",me->query("id"));
	armymen->set_leader(me);
	armymen->set("quest/battle", 1);

	return 1;
}
int accept_object(object who, object ob)
{
	object me, money;
	me = this_player();
	if( me->query("class") != "official" ) return 0;
	if( (int)me->query("id_type") != 4 ) return 0;
	if( !me->query("quest/battle") || me->query("quest/battle")==0 ) return 0;
	if( ob->query("id") != "enemy head" ) return 0;
	if( ob->query("name") == me->query("quest/battle") ) 
	{
	command("say 很好，记你大功一件，赏赐白银一千两！");
	command("say 今后要继续为国效忠！");
	money = new("/obj/money/thousand-cash");
	money->move(me);
	me->add("combat_exp", (int)me->query("battle/reward")*7/20+ 500 );
	me->add("relation_exp", (int)me->query("battle/reward")/10 + 50 );
	me->add("potential", (int)me->query("battle/reward")*7/40 + 250 );
	me->delete("quest/battle");
	return 1;
	}
	else
	{
		command("say 你没有杀死敌军主将，但是你退敌有功，赏银一百两吧！");
		command("say 今后要继续为国效忠！");
	money = new("/obj/money/hundred-cash");
	money->move(me);
	me->add("combat_exp", (int)me->query("battle/reward")/50 + 250 );
	me->add("potential", (int)me->query("battle/reward")/100 + 50 );
	me->delete("quest/battle");
	return 1;
	}
return 1;
}

