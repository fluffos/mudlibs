#include <ansi.h>

inherit NPC;

string send_mail();
string receive_mail();

void create()
{
	set_name("封如天", ({ "feng rutian", "feng" }) );
	set("title", "长安绎绎长");
	set("nickname", HIY"金发传音"NOR);
	set("gender", "男性" );
	set("age", 43);
	set("long",
		"满头金发的封如天担任长安绎的驿长已经有几年了，人很好，\n"
		"居民对封如天的风评相当不错，常常会来到驿站跟他聊天。\n");
	set("combat_exp", 800000);
	set("attitude", "friendly");
	set("inquiry", ([
		"绎站" : "是啊... 这里就是长安绎，你要寄信吗？",
		"寄信" : (: send_mail :),
		"收信" : (: receive_mail :),
		"mail" : (: receive_mail :),
	]) );
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 30);
        set("score", 90000);
	set_skill("literate", 70);
	set_skill("unarmed", 400);
	set_skill("dodge",250);
	set_skill("parry", 400);
	setup();
	add_money("silver", 70);
	carry_object(__DIR__"obj/jinzhuang")->wear();
}

string send_mail()
{
	object mbox;

	if( this_player()->query_temp("mbox_ob") )
		return "你的信箱还在吧？用信箱就可以寄信了。\n";
	if( !environment()
	||	base_name(environment()) != query("startroom") )
		return "真是抱歉，请您等一下到驿站来找我吧。\n";
	seteuid(getuid());
	mbox = new(MAILBOX_OB);
	mbox->move(this_player());
	return "哦... 要寄信是吗？这是你的信箱，寄信的方法信箱上有说明。\n";
}

string receive_mail()
{
	object mbox;

	if( this_player()->query_temp("mbox_ob") )
		return "你的信箱还在吧？你所有的信都在里面。\n";
	if( !environment()
	||	base_name(environment()) != query("startroom") )
		return "真是抱歉，请您等一下到驿站来找我吧。\n";
	seteuid(getuid());
	mbox = new(MAILBOX_OB);
	mbox->move(this_player());
	return "好，待我找找....有了，你的信箱在这，慢慢看吧，不打搅你了。\n";
}
