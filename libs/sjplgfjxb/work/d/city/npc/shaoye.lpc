// jiading.c

inherit NPC;
void create() {
  set_name("赵三少", ({ "zhao sanshao", "zhao" }));
  set("gender", "男性");
  set("age", 28);
  set("str", 28);
  set("cor", 27);
  set("cps", 25);
  set("int", 23);

  set("max_force", 100);
  set("force", 100);
  set("force_factor", 2);

  set("attitude", "heroism");

  set("long", @LONG
这是赵王府的三少爷，看上去风流倜傥。
LONG);

  set("combat_exp", random(50) * 100 + 5000);
  set("score", 150);

  set_skill("unarmed", random(20) + 10);
  set_skill("dodge", random(20) + 10);
  set_skill("parry", random(20) + 10);
  setup();
  add_money("coin", 50);
  carry_object("/obj/cloth/choupao")->wear();
}
