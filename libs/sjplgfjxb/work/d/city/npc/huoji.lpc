inherit NPC;
string reward_more(object who);

void create() {
  set_name("伙计", ({ "huoji" }));
  set("age", 25);
  set("gender", "男性");
  set("long",
    "一个能干的伙计。\n");
  set("attitude", "peaceful");

  set("combat_exp", 8000);
  set("id_type", 0);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/d/city/obj/cloth/linen")->wear();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 2000) return "1";
      if (enemy[i]->query("combat_exp") > 6000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 200) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
