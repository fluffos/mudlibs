//  /d/city/npc/baodatong.c  created by Baiwt
#include <ansi.h>

inherit NPC;
int about_he1();
int about_he2();
int about_he3();
int about_he4();

void create()
{
        set_name("包大通", ({ "bao datong", "bao"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位穿着长褂的老秀才模样的人，留着山羊胡。\n");
        set("combat_exp", 50000);
	set("title", "普通百姓");
	set("nickname", "无孔不入");
        set("attitude", "friendly");
        set_skill("unarmed", 90);
	set_skill("dodge", 100);
        set("parry", 200);
        set("chat_chance", 10);
        set("chat_msg", ({
                "包大通得意地说道：江湖上的事没有我不知道的。想知道各大门派的最新消息(news)吗？\n",
        }) );
        set("inquiry", ([
                "help" : (: about_he1 :),
                "news" : (: about_he2 :),
                "here" : (: about_he3 :),
                "map" : (: about_he4 :),
        ]));
	
	setup();
	add_money("silver", 50);
        carry_object("/obj/cloth/changpao")->wear();
}

int about_he1()
{
      command("say 你是新手吗？可一定要好好看看help指令提供的帮助系统，对你有很大好处的啊。\n");
          return 1;
}
int about_he2()
{
      command("say 最近最大的事吗？当然是“书剑飘零”开张啦，各位朋友请多来捧场。\n");
          return 1;
}
int about_he3()
{
      command("say 这里是书剑飘零的中心城市长安城，这里的交通四通八达，连接着各个区域。\n");
          return 1;
}
int about_he4()
{
      command("say 书剑飘零的总图可以用help maps查询，具体地图可以去杂货铺购买。\n");
          return 1;
}
