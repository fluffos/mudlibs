#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string summon_more( object who);
int about_quest();
void create()
{
        set_name("浑缄", ({ "master hun", "hun","master" }) );
        set("long",
                "全国兵马大元帅，掌管军机大权。\n");
	set("nickname", RED"开国元勋"NOR);
        set("attitude", "heroism");
	set("student_title","官员");
	create_family("朝廷",6,"官员");
	set("title", "兵马大元帅");
	set("vendetta_mark", "authority");
	set("class", "official");
	set("id_type", 4);
	set("str", 90);
	set("int", 30);
	set("cor", 30);
	set("spi", 30);
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 30);
        set("score", 90000);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/move", 30);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
           (: perform_action, "spear.huima" :),
		(: summon_more(this_object()) :),
		(: command, "escort" :),
        }) );
        set("combat_exp", 5000000);
        set("relation_exp", 90000);
        set("life_exp", 50000);
         set("inquiry", ([
                "quest" : (: about_quest :),
        ]));

        set_skill("unarmed", 200);
	set_skill("spear",280);
	set_skill("force",200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
	set_skill("xingyi-ken",200);
	set_skill("yang_spear",250);
	set_skill("bixueforce",180);
        set_skill("move", 100);
	set_skill("literate",300);
	set_skill("officialism",300);
	set_skill("strategy",300);
	map_skill("unarmed","xingyi-ken");
	map_skill("force","bixueforce");
	map_skill("spear","yang_spear");
        setup();

     carry_object("/d/city/obj/weapon/spear/gangqiang")->wield();
        carry_object("/obj/cloth/tiejia")->wear();
}

void attempt_apprentice(object me)
{
       if(me->query_skill("officialism",1)< 100) {
	    command("say 你的为官之道太差了。\n");
	    return;
	}	
       if(me->query_skill("strategy",1)< 100) {
	    command("say 你的兵法战策太差了。\n");
	    return;
	}	
 	if( me->query("class")=="official" && me->query("id_type")==4)
	{
	command("smile");
	command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
	}
	if(me->query("id_type") == 3)
	{
	command("say 你已经是吏部的官员了！\n");
	}
	if(me->query("id_type") == 5)
	{
	command("say 你已经是刑部的官员了！\n");
	}
	else
	command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
		ob->set("vendetta_mark", "authority");
                ob->set("id_type", 4);
                ob->set("title", "小兵");
}
void init()
{
	add_action("do_cancel", "cancel");
}
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("relation_exp")*2+(int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","小兵");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","校尉");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","中郎将");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","牙将");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","偏将");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","参将");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","副将");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","大将军");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","兵马统领");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","兵马大都督");
                return ;
        } else if ( exp <= 16244000 ) {
                student->set("title","平西王");
                return ;
}
}
string summon_more(object who)
{
	object soldier;
	seteuid(getuid());
	soldier = new("/obj/npc/bodyguard");
	soldier->move(environment(who));
	command("escort");
	return "1";
}

int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!me->query("quest/guanfu")||(int)me->query("quest/guanfu")==0)
          return notify_fail("你现在没有任务。\n");
	message_vision("\n$N向浑缄请罪。\n",me);
	say( CYN"\n浑缄冷冷说道：哼，你还有何面目回来见我？推出去斩了！\n"NOR);
	message_vision(RED"\n两旁刀斧手一涌而上，将$N押往午门。\n"HIW,me);
	me->move("/d/city/wumen");
	message_vision(HIR"\n$N被五花大绑推上了断头台。\n"NOR,me);
	message_vision(HIR"\n刀斧手手起刀落，将$N的人头砍了下来。。。\n"NOR,me);
	if( me->query("quest/battle"))
	me->delete("quest/battle");
	if( me->query("quest/guanfu"))
	me->delete("quest/guanfu");
	if( me->query("battle/equip"))
	me->delete("battle/equip");
	me->die();
	return 1;
}

int about_quest()
{
	object money;
	object me=this_player();
	int rate, prize;

	if( me->query("class") != "official" ) return 0;
	if( (int)me->query("id_type") < 3 || (int)me->query("id_type") > 4 ) return 0;
	if( (int)me->query("combat_exp") > 20000000 ) 
	{
	command("say 大人功勋卓著，国家大事已无需再操劳了。\n");
	return 1;
	}

	if( me->query("quest/guanfu")=="done" )
	{
	command("say 很好，你抗敌有功，赏赐白银一百两，进爵二十点！\n");
	money=new("/obj/money/hundred-cash");
	money->move(me);
	prize = me->query("kee") - me->query("enemy_kee");
	me->add("relation_exp", 20);
	me->add("potential", prize*2/3);
	me->add("combat_exp", prize);
	if( me->query("quest/battle"))
	me->delete("quest/battle");
	if( me->query("quest/guanfu"))
	me->delete("quest/guanfu");
	if( me->query("battle/equip"))
	me->delete("battle/equip");
	return 1;
	}
	if( me->query("quest/battle") != "masterhun" ) return 0;
	if( me->query("quest/guanfu") || (int)me->query("quest/guanfu")!=0 )
	{
	command("say 你正有重任在身，快去完成它吧！\n");
	return 1;
	}

	rate = random(20);
	if( (int)me->query("id_type") == 4 ) 
	{
	if( rate < 10 ) 
	{
	command("say 委寇屡次侵犯我东南沿海，你速去太湖水师跟随萧统领出征。\n");
	me->set("quest/guanfu","navy1");
	return 1;
	}
	else
	command("say 委寇屡次侵犯我东南沿海，你速去赤壁水师跟随叶统领出征。\n");
	me->set("quest/guanfu","navy2");
	return 1;
	}

	rate = random(30);
	if( (int)me->query("id_type") == 3 ) 
	{
	if( rate < 10 ) 
	{
	command("say 边关战事正紧，现命你速去太湖兵工场监造火炮，以加强我军战力。\n");
	me->set("quest/guanfu","huopao");
	return 1;
	}
	if( rate < 20 ) 
	{
	command("say 边关战事正紧，现命你速去赤壁兵工场监造弓箭，以加强我军战力。\n");
	me->set("quest/guanfu","gongjian");
	return 1;
	}
	else
	command("say 边关战事正紧，现命你速去弘农兵工场监造投石器，以加强我军战力。\n");
	me->set("quest/guanfu","toushi");
	return 1;
	}

	return 1;
}

int accept_object(object who, object ob)
{
        int val;
        val = ob->value();
        if( !val )
                return 0;
        else if( val >= 100000) {
	if( who->query("relation_exp") < 500000 )
	who->add("relation_exp", -random(1000));
        }
        say( "浑缄说道：大胆，竟然在我面前行贿。快滚！\n");
        return 1;
}

