// heaven_soldier.c

#include <ansi.h>

inherit NPC;
void backattack();
void create()
{

	set_name("无名老人", ({ "oldgod" }) );
        set("gender", "男性");
        set("age", 82);
	set("long", "这是一位鹤发童颜的老人，传说居住在遥远的东海无名岛...\n");
	set("attitude", "friendly");


        set("str", 20);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

	set("max_kee", 9000);
	set("max_gin", 9000);
	set("max_sen", 9000);
	set("kee", 9000);
	set("gin", 9000);
	set("sen", 9000);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 50);

        set("atman", 2000);
        set("max_atman", 2000);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 50);


	set("combat_exp", 99999999);
	set_skill("parry", 500);
	set_skill("dodge", 500);
	set_skill("unarmed", 200);
	set_skill("move", 500);
        set_skill("piaoxiang-steps", 200);
        set_skill("liuhe-force", 200);
        set_skill("throwing", 200);
	set_skill("force", 200);
        set_skill("wuxing-zhi", 200);
        map_skill("force", "liuhe-force");
        map_skill("dodge", "piaoxiang-steps");
        map_skill("unarmed", "wuxing-zhi");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.qijian" :),
                (: perform_action, "dodge.anxiang" :),
        }) );

	setup();

	carry_object("/obj/cloth")->wear();
}

int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	if( is_fighting() && (int) this_object()->query("kee") <= 100)
	backattack();
	return ::heal_up() + 1;
}

void leave()
{
	object owner;
	message("vision",
		 name() + "说道：好了，有事可随时呼唤我！\n\n"
		+ name() + "拂了拂身上的尘土，扬长而去。\n" , environment(),
		this_object() );
        if(objectp(owner=this_object()->query("possessed")))
		owner->add_temp("max_guard",-1);
	destruct(this_object());
}

void invocation(object who, int level)
{
	int i;
	object *enemy;
	set_skill("parry", 200 + random(level/2));
	set_skill("dodge", 200 + random(level/2));
	set_skill("move", 200 + random(level/2));
	message("vision",
		 name() + "说道：小兄弟不要惊慌，老夫来助你一臂之力！\n" NOR,
		environment(), this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
	set_leader(who);
	set("possessed",who);
}
void backattack()
{
	int i;
	object owner, *enemy;
	if(objectp(owner=this_object()->query("possessed")))
	{
		enemy = this_object()->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        owner->kill_ob(enemy[i]);
                        enemy[i]->kill_ob(owner);
                }
        }

	}

}

void die()
{
	object owner;
        if(objectp(owner=this_object()->query("possessed")))
                owner->add_temp("max_guard",-1);
	::die();
}
