#include <ansi.h>
inherit NPC;
string eff_kees(object me);
void create() {
  object me = this_player();
  set_name("宫女", ({ "dancing girls", "dancing" }));
  set("title", "二十名");
  set("attitude", "heroism");
  set("guanfu/work_attrib", "waijiao");
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 5);
  set("long",
    "这是一队婀娜多姿的宫女，都是一些清丽的女孩。\n");
  set("max_kee", 2000);
  set("max_sen", 200);
  set("max_gin", 200);
  set("kee", 2000);
  set("sen", 200);
  set("gin", 200);
  set("combat_exp", 1000);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set_skill("skill_diplomacy", 100);
  set_skill("skill_dance", 100);
  map_skill("dodge", "skill_diplomacy");
  map_skill("unarmed", "skill_dance");
  map_skill("parry", "skill_dance");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: eff_kees(this_object()) :),
  }));
  setup();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_look", "look");
  add_action("do_work", "dance");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("quest/guanfu") && (int)ob->query("quest/guanfu") != 0) {
    command("say 大人来得正好，贵宾们都等着呢，我们开始吧！(dance)\n");
  }
}

int do_look(string arg) {

  if (arg == "dancing girls" || arg == "dancing") {
    write("这是一队婀娜多姿的宫女，都是一些清丽的女孩。\n");
    write("她们正和着音乐的节拍翩翩起舞。\n");
    return 1;
  }
  return 0;
}

int accept_fight(object me) {
  command("say 我们正接待客人，没空陪你。\n");
  return 0;
}
string eff_kees(object me) {
  object ob, owner;
  ob = this_object();
  owner = this_object()->query("possessed");
  if ((int)ob->query("sen") < 100) {
    owner->set("quest/guanfu", "done");
    command("say 大人，任务已经完成了！\n");
    say(HIC "\n歌舞伎们停止了舞蹈，整齐地排成两列退在一旁。\n\n" NOR);
    owner->add("score", 1);
    owner->set_temp("doing_work", 2);
    ob->remove_all_killer();
    return "1";
  } else
    owner->add("combat_exp", 1);
  owner->add("potential", 1);
  return "1";
}
int do_work(string arg) {
  object me, worker;
  me = this_player();
  if (me->query("quest/guanfu") != "waijiao")
    return notify_fail("什么？");
  if (!objectp(present("dancing girls", environment(me))))
    return notify_fail("这里歌舞的人手不够。");
  if (me->query_temp("doing_work") == 1)
    return notify_fail("你正在进行接待工作。");
  if (me->query_temp("doing_work") > 1)
    return notify_fail("你的任务已经完成了。");
  worker = present("dancing girls", environment(me));
  message_vision(HIC "$N向乐队作了个手势，顿时鼓乐声响了起来。\n" NOR, me);
  this_object()->set("possessed", me);
  worker->set("possessed", me);
  this_object()->kill_ob(worker);
  worker->kill_ob(this_object());
  me->set_temp("doing_work", 1);
  return 1;
}
