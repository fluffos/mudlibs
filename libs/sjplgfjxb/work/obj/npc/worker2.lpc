//worker of farm
#include <ansi.h>
inherit NPC;
string eff_kees(object me);
void create() {
  object me = this_player();
  set_name("农民", ({ "worker team", "worker" }));
  set("title", "一百名");
  set("attitude", "heroism");
  set("guanfu/work_attrib", "farm");
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 5);
  set("long",
    "这是一队身强力壮的农民，约有一百人之多。\n");
  set("max_kee", 10000);
  set("max_sen", 300);
  set("max_gin", 300);
  set("kee", 10000);
  set("sen", 300);
  set("gin", 300);
  set("combat_exp", 1000);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set_skill("skill_working", 100);
  set_skill("skill_farm", 100);
  map_skill("dodge", "skill_working");
  map_skill("unarmed", "skill_farm");
  map_skill("parry", "skill_farm");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: eff_kees(this_object()) :),
  }));
  setup();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_look", "look");
  add_action("do_work", "work");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("quest/guanfu") && (int)ob->query("quest/guanfu") != 0) {
    command("say 大人来得正好，人手都齐了，赶快开工吧！\n");
  }
}

int do_look(string arg) {

  if (arg == "worker" || arg == "worker team") {
    write("这是一队身强力壮的农民，约有一百人之多。\n");
    write("他们摩拳擦掌，正干得热火朝天。\n");
    return 1;
  }
  return 0;
}

string eff_kees(object me) {
  object ob, owner;
  ob = this_object();
  owner = this_object()->query("possessed");
  if ((int)ob->query("sen") < 150) {
    owner->set("quest/guanfu", "done");
    command("say 大人，任务已经完成了！\n");
    say(HIC "\n民伕们望着自己的劳动成果，愉快地微笑着。\n\n" NOR);
    owner->add("score", 1);
    owner->set_temp("doing_work", 2);
    ob->remove_all_killer();
    return "1";
  } else
    owner->add("combat_exp", 1);
  owner->add("potential", 1);
  return "1";
}
int accept_fight(object me) {
  command("say 我们正忙着干活，没空跟人打架。\n");
  return 0;
}
int do_work(string arg) {
  object me, worker;
  me = this_player();
  if (me->query("quest/guanfu") != "farm")
    return notify_fail("什么？");
  if (!objectp(present("worker team", environment(me))))
    return notify_fail("这里干活的人手不够。\n");
  if (me->query_temp("doing_work") == 1)
    return notify_fail("你正在指挥工作。\n");
  if (me->query_temp("doing_work") > 1)
    return notify_fail("你的任务已经完成了。\n");
  worker = present("worker team", environment(me));
  message_vision(HIC "$N一声令下，大家热火朝天地干了起来。\n" NOR, me);
  this_object()->set("possessed", me);
  worker->set("possessed", me);
  this_object()->kill_ob(worker);
  worker->kill_ob(this_object());
  me->set_temp("doing_work", 1);
  return 1;
}
