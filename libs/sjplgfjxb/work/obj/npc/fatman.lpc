// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("大胖子", ({ "fatman" }) );
        set("gender", "男性" );
        set("age", 40);
        set("long",
                "一个白白胖胖的矮胖子．\n");
	set("combat_exp", 5);
        set("chat_chance", 2);
        set("chat_msg", ({
                "大胖子指着你讥笑道：你．．你比我还胖还矮．．．\n",
		"大胖子哼道：书狂拟醉江湖笑，剑胆琴心慰飘零．．．\n",
        }) );

        set("attitude", "friendly");
        set("rank_info/respect", "胖哥");
        setup();
        carry_object("/obj/cloth")->wear();
}
