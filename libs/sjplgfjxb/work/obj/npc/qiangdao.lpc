#include <ansi.h>
inherit NPC;

void create() {
  set_name("强盗", ({ "qiang dao", "dao" }));
  //    set("title","");
  set("long", "一位蒙面强盗。\n");
  set("age", 20 + random(20));
  set("gender", "男性");
  set("attitude", "aggressive");
  set("bellicosity", 8000);
  seteuid(getuid());
  set_skill("unarmed", random(80));
  set_skill("blade", random(80));
  set("combat_exp", 50000);
  setup();
  {
    object carried_ob = carry_object("/u/baiwt/xueshan/obj/cloth");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object("/u/baiwt/xueshan/obj/blade");
    if (carried_ob) carried_ob->wield();
  }
}
