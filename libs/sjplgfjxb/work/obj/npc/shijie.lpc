#include <ansi.h>

inherit NPC;

void create()
{
        set_name("外国使节", ({"shi jie"}));
        set("age", 38);
        set("gender", "男性");
        set("long","一个金发碧眼的外国使臣。\n");
        set("combat_exp", 1000+random(4000));
        set("attitude", "friendly");
        set("max_kee", 200);
        set("max_gin", 200);
	set("max_sen", 200);
        set("force", 100);
        set("max_force", 100);
        set("force_factor", 5);
        set_skill("unarmed", 35);
        set_skill("parry", 35);
        set_skill("dodge", 35);

        setup();
	carry_object("/d/city/obj/cloth/choupao")->wear();
}

