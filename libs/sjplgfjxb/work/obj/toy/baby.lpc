// baby.c    modified by baiwt@sjpl 12,19,1999

#include <ansi.h>
inherit NPC;
int custom1();
int custom2();

void create() {
  set_name("宝宝", ({ "xiao baobao", "baby" }));
  set("gender", "女性");
  set("age", 1);
  set("attitude", "friendly");
  set("long", "乖宝宝。\n");
  set_skill("move", 100);
  set("combat_exp", 1);
  set("str", 3);
  set("parents", ({ "dad", "mom" }));
  set("chat_chance", 1);
  set("chat_msg", ({
    (: custom1 :),
    (: custom2 :),
  }));

  set("is_baby", 1);
  // to allow the identification of baby. by baiwt.
  setup();
  carry_object("/d/city/obj/food/candy");
  carry_object("/d/city/obj/food/candy");
  carry_object("/d/city/obj/food/candy");
}

void init() {
  add_action("do_kill", ({ "kill", "fight", "steal" }));
  add_action("do_get", "get");
  add_action("do_drop", "drop");
  add_action("do_together", "together");
  add_action("do_teach", "teach");
}

int heal_up() {
  object baby = this_object();
  if (!present((string)baby->query("parent_now"), environment(baby)) && !userp(environment(baby))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision", name() + "急急忙忙地离开了。\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

int do_teach(string arg) {
  object me = this_object(), who = this_player();
  if (!arg) return 0;
  if (who->query("gin") < 50)
    return notify_fail("你显然太累了，没有办法教孩子什麽。\n");

  if (who->query("child_1/parents") != me->query("parents"))
    return notify_fail("你不是孩子的亲人。\n");

  if (who->query_skill(arg, 1)) {
    message_vision("$N教了“" + to_chinese(arg) + "”给$n。\n", who, me);
    if (me->query("combat_exp") > random(100)) {
      message_vision("$n听了$N的指导，点了点头，似乎有些心得。\n", who, me);
      if (me->query("age") > 10 && me->query("str") < random(30)) who->add("baby_str", 1);
      if (who->query("baby_str") > 90) who->set("baby_str", 90);
      if (me->query("water") < 200) me->add("water", 1);
      who->add("baby_combat_exp", random(9) + 1);
      if (who->query("baby_skill") < who->query_skill(arg, 1)) who->add("baby_skill", 1);
      who->receive_damage("gin", random(10) + 20);
      who->start_busy(1);
      me->set("per", who->query_per());
      me->set("str", who->query("baby_str") + 1);
      me->set("combat_exp", who->query("baby_combat_exp"));
      me->set_skill(arg, who->query("baby_skill") / 2);
      return 1;
    } else
      message_vision("$n听了$N的指导，眨了眨眼睛，好象并不是很懂。\n", who, me);
    who->add("baby_combat_exp", random(3));
    me->set("combat_exp", who->query("baby_combat_exp"));
    me->set("learned_msg", arg);
    who->receive_damage("gin", 20);
    who->start_busy(1);
    return 1;
  }

  else
    message_vision("$N教了“" + arg + "”给$n。\n", who, me);
  message_vision("$n听了$N的指导，点了点头，似乎有些心得。\n", who, me);
  who->receive_damage("gin", 20);
  who->start_busy(1);
  return 1;
}
int do_together(string arg) {
  object me = this_object(), who = this_player();
  if (!arg)
    return notify_fail("你要谁跟你一起行动？\n");
  if (!objectp(present(arg, environment(who))))
    return notify_fail("这里没有这个人。\n");
  if (who->query("child_1/parents") != me->query("parents"))
    return notify_fail("你不是孩子的亲人。\n");
  message_vision("$n跟随$N一起行动。\n", who, me);
  me->set_leader(who);
  return 1;
}

int do_drop(string arg) {
  object me = this_object(), who = this_player(), env;
  if (!arg) return 0;
  env = environment(who);
  if (present(arg, who) != me) return 0;
  if (me->move(env)) {
    message_vision("$N把$n从怀里放了下来。\n", who, me);
    return 1;
  }
  return 0;
}

int do_get(string arg) {
  object me = this_object(), who = this_player(), env;
  if (!arg) return 0;
  env = environment(who);
  if (present(arg, env) != me) return 0;
  if (member_array(who->query("id"),
    me->query("parents")) > -1) {
    if (me->move(who)) {
      message_vision("$N弯下腰把$n抱了起来，搂在怀里。\n", who, me);
    } else {
      message_vision("$N弯下腰一抱却没把$n抱起来，小家伙好沉哪！\n", who, me);
    }
  } else {
    message_vision("$N蹲下身朝$n伸开双手，$n却一下子闪开了．．．\n", who, me);
  }
  return 1;
}

int do_kill(string arg) {
  object me, who;
  string name, verb, what, obj;
  if (!arg) return 0;
  verb = query_verb();
  me = this_player();

  if (verb == "steal") {
    if (sscanf(arg, "%s from %s", what, obj) != 2)
      return 0;
  } else obj = arg;

  if (!objectp(who = present(obj, environment(me)))
    || !living(who)) return 0;
  //	if(who->query("is_baby")) {
  if (who == this_object()) {
    switch (verb) {
      case "kill":
        //	      command("chat* "+
        tell_object(environment(this_object()),
          who->query("name") + "拼命地哭了起来：爹～～，娘～～，" +
          me->query("name") + "要杀我．．．快回来呀！\n");
        break;
      case "fight":
        //	      command("chat* "+
        tell_object(environment(this_object()),
          who->query("name") + "哭了起来：爹～～，娘～～，" +
          me->query("name") + "要抢我的糖吃．．．快回来呀！\n");
        break;
      case "steal":
        //	      command("chat* "+
        tell_object(environment(this_object()),
          who->query("name") + "哭了起来：爹～～，娘～～，" +
          me->query("name") + "要偷吃我的糖！\n");
        break;
    }
  }
  command(verb);
  return 0;
}

void relay_emote(object ob, string verb) {
  if (!userp(ob)) return;

  switch (verb) {
    case "kick":
      command("say 爹～～，娘～～，" + ob->query("name") + "踢我耶！");
      command("kick " + ob->query("id"));
      break;
    case "slap":
      command("say 爹～～，娘～～，" + ob->query("name") +
        "打我耶，好痛啊～～～～");
      command("slap " + ob->query("id"));
      break;
    case "hit":
      command("pain " + ob->query("id"));
      break;
    case "bite":
      command("heng " + ob->query("id"));
      break;
    case "papaya":
      command("say 爹～～，娘～～，" + ob->query("name") + "骂我耶！");
      command("papaya " + ob->query("id"));
      break;

  }
}

void relay_whisper(object me, string msg) {
  if (member_array(me->query("id"), query("parents")) == -1) {
    message_vision((string)this_object()->query("name")
      + "疑惑地看着$N。\n", me);
    return;
  }

  //note, do not allow the order contain "chat", "tell"...
  //may need disable more later...
  if (strsrch(msg, "chat") != -1 ||
    strsrch(msg, "wiz") != -1 ||
    //            strsrch(msg, "es") != -1 ||
    strsrch(msg, "rumor") != -1 ||
    //            strsrch(msg, "sjpl") != -1 ||  
    strsrch(msg, "tell") != -1 ||
    strsrch(msg, "follow") != -1 ||
    strsrch(msg, "apprentice") != -1 ||
    strsrch(msg, "recruit") != -1)
    return;

  if (msg) {
    remove_call_out("relaying");
    call_out("relaying", 1 + random(3), msg);
  }
}

void relaying(string msg) {  //execute the order.
  command(msg);
}
int custom1() {
  //command("jump");
  //command("kiss");
  command("eat candy");
  return 1;
}
int custom2() {
  object me = this_object();
  //command("whisper "+parents+" 爸爸！");
  //command("whisper "+parents+" 妈妈！");
  if (me->query("learned_msg"))
    command("say " + me->query("learned_msg"));
  if (me->query("age") < 10)
    say(CYN "只见" + me->query("name") + "抓起一团泥巴放在手里玩。\n" NOR);
  return 1;
}

int accept_object(object who, object ob) {
  return 1;
}
