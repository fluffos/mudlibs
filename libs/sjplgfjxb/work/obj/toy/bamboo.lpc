// bamboo.c

#include <weapon.h>

inherit STICK;

void create()
{
        set_name("竹子", ({ "bamboo" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根绿油油的竹子。");
                set("value", 70);
                set("objattrib", 1);
                set("material", "wood");
        }
        init_stick(3);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", "$N把$n紧紧地握在手中。\n");
        set("unwield_msg", "$N松开了手中的$n。\n");

// The setup() is required.

        setup();
}
