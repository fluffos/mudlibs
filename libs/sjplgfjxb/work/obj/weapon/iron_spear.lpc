// dagger.c : an example weapon

#include <weapon.h>

inherit SPEAR;

void create()
{
	set_name("黑铁枪", ({ "iron spear","spear" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条看起相当锋利的铁枪。\n");
		set("value", 1000);
		set("material", "iron");
	}
	init_spear(40);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", "$N把$n一抖，紧紧地握在手中。\n");
        set("unwield_msg", "$N松开了手中的$n。\n");

// The setup() is required.

	setup();
}
