// dart.c

#include <weapon.h>

inherit THROWING;

void create()
{
        set_name("雕翎箭", ({"arrow"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "雕翎箭是弓箭手十分常用的武器。\n");
                set("unit", "支");
                set("base_unit", "支");
                set("base_weight", 50);
                set("value", 50);
        }
        set_amount(60);
        init_throwing(25);
        setup();
}

