#include <ansi.h>

#include <weapon.h>

inherit THROWING;

void create()
{
      string *order1 = ({"勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木","空冥",
"正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
	string *order2 = ({"战士", "武士", "上人", "王者", "圣者",
"大师", "大士", "郎君", "侠客", "使者"});
	string *order3 = ({"金箭", "银箭", "铜箭", "铁箭", "燕尾针", "黄蜂针", "长箭",
"短箭", "无形针", "木箭", "铁莲子", "透骨钉", "竹箭"});
      set_name( HIC + order1[random(18)] + order2[random(9)]+ HIG+ order3[random(12)]+ NOR, ({ "throwing" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("base_unit", "把");
                set("base_weight", 300);
		set("m_ap_rank",2);
		set("m_dp_rank",2);
		set("value", 100000);
		set("base_value", 20000);
                set("material", "iron");
                set("long",     "弓箭是一种十分锐利的远程武器，用来当作暗器使用。\n");
        }
        set_amount(5);
        init_throwing(random(50)+1);
        setup();
}
