#include <ansi.h>

#include <weapon.h>

inherit FORK;

void create()
{
      string *order1 = ({"勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木","空冥",
"正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
	string *order2 = ({"战士", "武士", "上人", "王者", "圣者",
"大师", "大士", "郎君", "侠客", "使者"});
	string *order3 = ({"金旗", "银旗", "铜旗", "铁旗", "枣阳槊", "禹王槊", "鳄鱼剪","三股叉",
"五股叉", "双股叉", "钢叉", "木叉", "竹叉"});
      set_name( HIG + order1[random(18)] + order2[random(9)]+ HIC + order3[random(12)]+ NOR, ({ "flag" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "面");
		set("m_ap_rank",6);
		set("m_dp_rank",6);
		set("value", random(6)*random(100)*100 + 1000);
                set("material", "iron");
                set("long", "一面沉重的铁旗。\n");
                set("wield_msg", "$N抄起一面$n，拿在手中挥舞了一下。\n");
        }
        init_fork(random(90)+10);
        setup();
}

