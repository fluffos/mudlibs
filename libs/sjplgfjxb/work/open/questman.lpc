  "〖伏羲八卦图〗",
  "〖道德经〗",
  "〖伏魔山心经〗",
  "空白帐本",
  "〖云麓漫钞〗",
  "〖女儿经〗",
  "〖青莲剑谱〗",
  "〖太白自选集〗",
  "〖千字文〗",
  "〖三字经〗",
  "〖风水〗",
  "〖真武经〗",
  "〖游玉虚宫〗",
  "〖离均阳雨不止〗",
  "〖玉虚桥上步月〗",
  "〖答永乐皇帝〗",
  "〖南岩〗",
  "〖旗峰〗",
  "〖宿太和绝顶〗",
});

void create() {
  set_name("清虚道人", ({ "qingxu daoren", "daoren", "qingxu" }));
  set("long",
    "这是一个六十多岁的老人, 精神矍铄，神态安详。\n" +
    "他是武当派宿老，久已不问江湖事务。你可以向他申请任务\n");
  set("title", "武当宿老");
  set("gender", "男性");
  set("age", 64);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("kee", 9000);
  set("gin", 9000);
  set("sen", 9000);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set("mana", 2000);
  set("max_mana", 2000);

  set("inquiry", ([
    "quest": (: about_quest :),
  ]));

  set("combat_exp", 7000000);
  set("score", 20000);

  set_skill("move", 240);
  set_skill("dodge", 250);
  set_skill("literate", 230);
  set_skill("unarmed", 250);
  set_skill("parry", 250);
  set_skill("force", 250);
  set_skill("sword", 250);

  set_skill("taiji-sword", 250);
  set_skill("taiji-ken", 250);
  set_skill("taiji-force", 250);
  set_skill("tiyunzong", 250);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.fengbi" :),
  }));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}

void init() {
  add_action("do_cancel", "cancel");
}

int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  if (!me->query("marks/wdjob"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "清虚道人叹道：不想做了吗？好吧，你自己反省一下。\n" NOR);
  if ((int)me->query("combat_exp") <= 100) {
    me->delete("marks/wdjob");
    me->unconcious();
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->delete("marks/wdjob");
  me->unconcious();
  return 1;
}

int about_quest() {
  int task;
  object me = this_player();
  string questname = names[random(sizeof(names))];
  if (random(9) < 5 && !me->query("marks/wdjob")) {
    command("say 后山桃林的桃子熟了，你去和弟子们收摘一下吧！有多余的带一个来我尝尝。");
    me->set("marks/wdjob", "peach");
    return 1;
  }
  if (!me->query("marks/wdjob")) {
    say(CYN "清虚道人说道：我想要［" + questname + "］，你去给我找来。\n" NOR);
    me->set("marks/wdjob", questname);
    return 1;
  } else {
    command("say 你还站在这里干什么？好好用功才是啊！");
    return 1;
  }
  return 1;
}

int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (ob->query("name") == "水蜜桃" && this_player()->query("marks/wdjob") == "peach") {
    say(CYN "清虚道人微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(20) + 10);
    me->set("potential", (int)pot + random(10) + 10);
    me->add("score", random(10));
    me->add("life_exp", random(20));
    if (me->query("marks/wdjob"))
      me->delete("marks/wdjob");
    return 1;
  }
  if (ob->name() == (string)me->query("marks/wdjob")
    || (ob->query("id") == (string)me->query("marks/wdjob") && ob->query("objattrib"))) {
    say(CYN "清虚道人微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(50) + 30);
    me->set("potential", (int)pot + random(30) + 20);
    me->add("score", random(10));
    me->add("life_exp", random(20));
    if (me->query("marks/wdjob"))
      me->delete("marks/wdjob");
    return 1;
  } else {
    say(CYN "清虚道人说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
int accept_fight(object me) {
  return 0;
}
