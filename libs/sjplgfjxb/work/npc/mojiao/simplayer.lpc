//simplayer.c written by john darks
#include <ansi.h>
inherit NPC;
void create()
{
        object player,*ob;
        object dan;
        mapping skill_status, map_status;
        string *sname, *mname;
        int i;
        ob = users();
        player = ob[random(sizeof(ob))];
        while(wizardp(player))
        	player = ob[random(sizeof(ob))];
        set_name(player->query("name"), ({ player->query("id")}));
	set("title",player->query("title"));
	set("nickname",player->query("nickname"));
	set("gender", player->query("gender"));
	set("age", 30);
	set("str", 30);
	set("cor", 30);
	set("agi", 30);
	set("max_gin",2000);
	set("max_kee",3000);
	set("max_sen",2000);
	set("max_force",2000);
	set("force",3000);
	set("force_factor",40);
	set("long",player->query("long"));
	set("attitude", "peaceful");
	set_skill("literate", 150);
	if ( !(skill_status = player->query_skills())||wizardp(player)){
		set_skill("unarmed",200+random(100));
		set_skill("dodge",200+random(100));
		set_skill("parry",200+random(100));
		set_skill("move",200+random(100));
	}else {
		sname  = keys(skill_status);
		for(i=0; i<sizeof(skill_status); i++) {
			set_skill(sname[i], skill_status[sname[i]]);
		}
		if (map_status = player->query_skill_map())
			mname  = keys(map_status);
		for(i=0; i<sizeof(map_status); i++) {
			map_skill(mname[i], map_status[mname[i]]);
		}
	}
	set("combat_exp", 1000000 + player->query("combat_exp"));
	setup();
	dan=new(__DIR__"questobj/wujidan");
	dan->move(this_object());
	carry_object("/obj/cloth")->wear();
}
