#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("林佩奇", ({ "lin peiqi","lin" }) );
        set("gender", "男性" );
        set("age", 29);
	set("combat_exp", (random(7)+1)*100000);
	set("title","青城派");
	set("nickname",HIR"龙舌剑"NOR);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 2);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",2226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("force", 100);
        set_skill("sword", 100);

        set_skill("rain_sword",100);
        set_skill("rain_strike", 100);
        set_skill("siri_force", 100);
        set_skill("five-steps", 100);

        map_skill("dodge", "five-steps");
        map_skill("unarmed", "rain_strike");
        map_skill("parry", "rain_sword");
        map_skill("force", "siri_force");
        map_skill("sword", "rain_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "sword.pangtuo" :),
        }) );

        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/longsword")->wield();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        env = environment(me);
        inv = all_inventory(env);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==1 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

