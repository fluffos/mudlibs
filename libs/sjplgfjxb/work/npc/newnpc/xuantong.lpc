#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("玄通道人", ({ "xuan tong","xuan" }) );
        set("gender", "男性" );
        set("age", 49);
	set("combat_exp", (random(7)+1)*100000);
	set("title","雾灵山玄通观");
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 1);
        set("class", "taoist");

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",1226);
	set("force_factor",30);
	set("max_mana",2731);
	set("mana",3592);	
	set("mana_factor",20);
        set_skill("force", 90);
        set_skill("move", 50);
        set_skill("scratching", 80);
	set_skill("spells",98);
        set_skill("unarmed", 50);
        set_skill("sword", 40);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("gouyee", 90);
	set_skill("sanqing-jian", 40);
        set_skill("taoism", 120);
        set_skill("scratmancy", 70);
	set_skill("necromancy",97);

        map_skill("scratching", "scratmancy");
        map_skill("spells", "necromancy");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
        map_skill("force", "gouyee");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "netherbolt" :),
                (: cast_spell, "feeblebolt" :),
        }) );

        setup();
        carry_object("/u/maoshan/npc/obj/taomujian")->wield();
        carry_object("/u/maoshan/npc/obj/robe")->wear();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==2 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

