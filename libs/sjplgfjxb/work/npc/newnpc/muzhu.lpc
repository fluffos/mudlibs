#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("木珠大师", ({ "muzhu dashi", "muzhu" }));
  set("gender", "男性");
  set("age", 70);
  set("combat_exp", (random(9) + 1) * 100000);
  set("title", "少林寺长老");
  set("nickname", WHT "少林袈裟" NOR);
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("str", 70);
  set("id_type", 1);
  set("class", "bonze");

  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 2226);
  set("force_factor", 30);
  set("atman", 731);
  set("mana", 592);
  set_skill("force", 150);             // 基本内功
  set_skill("luohan_force", 140);    //
  set_skill("unarmed", 150);           // 基本拳脚
  set_skill("jingang-strike", 140);
  set_skill("dodge", 100);            // 基本躲闪
  set_skill("shaolin-dodge", 100);        //七星换位
  set_skill("parry", 150);             // 基本招架

  map_skill("force", "luohan_force");
  map_skill("unarmed", "jingang-strike");
  map_skill("dodge", "shaolin-dodge");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.jingang" :),
  }));

  setup();
  carry_object("/obj/cloth/monk_cloth")->wear();
}
int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  if (me->query("bellicosity") > 10)
    me->set("bellicosity", 1);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 2)
      me->fight_ob(inv[i]);
  }
  return 1;
}
