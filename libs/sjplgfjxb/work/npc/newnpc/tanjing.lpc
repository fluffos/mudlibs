#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("谭菁", ({ "tan jing", "tan" }));
  set("gender", "男性");
  set("age", 30);
  set("combat_exp", (random(7) + 1) * 100000);
  set("title", "乌衫独行客");
  set("nickname", HIB "瘦鹗" NOR);
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("str", 70);
  set("id_type", 2);

  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 2226);
  set("force_factor", 30);
  set("atman", 731);
  set("mana", 592);
  set_skill("force", 150);
  set_skill("ziliu-force", 150);
  set_skill("literate", 140);
  set_skill("sword", 150);
  set_skill("duzhuo_sword", 140);
  set_skill("dodge", 100);
  set_skill("parry", 150);

  map_skill("force", "ziliu-force");
  map_skill("sword", "duzhuo_sword");
  map_skill("parry", "duzhuo_sword");
  /*
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "sword.zhen" :),
        }) );
*/
  setup();
  carry_object("/obj/cloth/choupao")->wear();
  carry_object("/obj/longsword")->wield();
}
int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  if (me->query("bellicosity") > 10)
    me->set("bellicosity", 1);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 1)
      me->fight_ob(inv[i]);
  }
  return 1;
}
