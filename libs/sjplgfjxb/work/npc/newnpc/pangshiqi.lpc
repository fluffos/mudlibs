#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("庞士奇", ({ "pang shiqi","pang" }) );
        set("gender", "男性" );
        set("age", 30);
	set("combat_exp", (random(9)+1)*100000);
	set("title","终南派长老");
	set("nickname",HIC"一指神龙"NOR);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 1);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",1226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
	set_skill("force", 150);             // 基本内功
	set_skill("ziliu-force", 140);    //
	set_skill("unarmed", 150);           // 基本拳脚
	set_skill("tiangang-quanfa", 140);     
	set_skill("dodge",100);      	     // 基本躲闪
	set_skill("qixing-huanwei", 100);        //七星换位
	set_skill("parry", 150);             // 基本招架
     
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed.zhen" :),
        }) );

        setup();
        carry_object("/obj/cloth/changpao")->wear();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==2 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

