#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int goto_inventory = 0;
  int konghegong, xuanyinforce, exp;

  object obj;
  string msg;
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if ((string)me->query("class") != "snowman")
    return notify_fail("你不是琼宫弟子，还是自己照顾自己吧！\n");

  if (!environment(me)->query("outdoors"))
    return notify_fail("这里无法召唤仙鹤！\n");
  if (environment(me)->query("hell"))
    return notify_fail("这里无法召唤仙鹤！\n");
  if (me->is_busy())
    return notify_fail("你现在忙得很，无法召唤仙鹤。\n");

  if (!arg) return notify_fail("你要去哪一个人的身边？\n");
  if (arg == "fan qiuyun" || arg == "maiyi girl" || arg == "old farmer" || arg == "cui rufeng"
    || arg == "small kid" || arg == "ma feng" || arg == "gui tuozi" || arg == "yang sen")
    return notify_fail("你没有办法去那个地方。\n");

  obj = find_player(arg);

  if ((int)me->query("sen") < 110)
    return notify_fail("你的神太差了！\n");
  if ((int)me->query("gin") < 100)
    return notify_fail("你的精太差了！\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够，无法驾驭仙鹤！\n");

  konghegong = (int)me->query_skill("konghegong");
  xuanyinforce = (int)me->query_skill("xuanyinforce");
  exp = (int)me->query("combat_exp");
  if (konghegong < 30 || xuanyinforce < 30)
    return notify_fail("你的控鹤功和玄阴气功太差了，无法召唤仙鹤！\n");

  exp = (int)me->query("combat_exp");
  if (exp < 200000)
    return notify_fail("你的经验还不够，无法施展控鹤功！\n");
  seteuid(getuid());
  me->receive_damage("sen", 100);
  me->receive_damage("gin", 90);
  me->add("force", -10);

  if (!obj) obj = find_living(arg);
  if (!obj) return notify_fail("你没有办法去那个地方。\n");
  if (!environment(obj)) return notify_fail("你没有办法去那个地方。\n");
  if (!obj || !me->visible(obj))
    return notify_fail("你没有办法去那个地方。\n");
  //	if( !wizardp(me) && !environment(obj)->query("outdoors") )
  if (environment(obj)->query("oldarea"))
    return notify_fail("你没有办法去那个地方。\n");
  if (environment(obj)->query("hell"))
    return notify_fail("你没有办法去那个地方。\n");
  if (!environment(obj)->query("outdoors"))
    return notify_fail("你没有办法去那个地方。\n");
  obj = environment(obj);
  //	if(!goto_inventory && environment(obj))
  //		obj = environment(obj);

  if (stringp(msg = me->query("env/msg_mout")))
    message_vision(msg + "\n", me);
  else
    message_vision("只听见一声长长的鹤鸣，一只白色的仙鹤从天而降，驮起$N振翅高飞，冲向了云端...\n", me);
  /*
	if ( random(konghegong) >= random(xuanyinforce))
		return notify_fail("仙鹤飞到半空，你忽然感到呼吸不畅，竟从仙鹤背上落了下来！\n");	
	if ( random(konghegong) < random(xuanyinforce))
*/
  me->move(obj);
  me->start_busy(2);

  if (stringp(msg = me->query("env/msg_min")))
    message_vision(msg + "\n", me);
  else
    message_vision("天上缓缓降落一只白色的仙鹤，$N从仙鹤背上跃了下来。白鹤引吭长鸣，冲上天际不见了...\n", me);

  return 1;
}
