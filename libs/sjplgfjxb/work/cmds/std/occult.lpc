// occult.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts;

  if (!arg || (arg != "none" && !sscanf(arg, "%d", pts)))
    return notify_fail("指令格式：occult <灵力点数>|none

这个指令让你设定在施法中所使用的灵力点数。隐藏的灵力将
使施法者提高法术防御能力。
occult none 则表示你不使用灵力。 

SEE ALSO : enable, enchant
");

  if (!me->query_skill_mapped("magic"))
    return notify_fail("你必须先 enable 一种法术。\n");

  if (arg == "none")
    me->delete("atman_factor");
  else {
    if (pts < 0 || pts > (int)me->query_skill("magic") / 4)
      return notify_fail("你只能用 none 
表示不运灵力，或数字表示每一击用几点灵力。\n");
    me->set("atman_factor", pts);
  }

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：occult  <灵力点数>|none

这个指令让你设定在施法中所使用的灵力点数。隐藏的灵力将
使施法者提高法术防御能力。
 
occult none 则表示你不使用灵力。 

SEE ALSO : enable, enchant
HELP
  );
  return 1;
}
