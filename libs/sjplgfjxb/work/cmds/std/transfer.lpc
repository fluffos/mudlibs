// transfer.c

#include <room.h>

inherit F_CLEAN_UP;

int main(object me)
{
	int exp, pot, tpot;
	tpot = (int) me->query("potential");
	pot = (int) me->query("potential")- (int) me->query("learned_points");
	exp = (int)me->query("age");
       if( (pot - exp) <= 0 )
                return notify_fail("你没有多余的潜能。\n");
	exp = (int) me->query("combat_exp");
	pot = (int)me->query("age");
	exp = exp+ random(pot);
       if( me->is_busy() )
                return notify_fail("你上一个动作还没有完成，不能静下心来。\n");
	me->set("combat_exp",exp );
	me->set("potential", tpot - pot);	
	me->start_busy(3);
	write("你潜心静坐，渐渐进入意识转化阶段。\n");
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : transfer
 
这个指令可以让你将潜能转为经验.
 
HELP
    );
    return 1;
}
