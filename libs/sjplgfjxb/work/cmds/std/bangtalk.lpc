//bangtalk.c write by john darks
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object *ob, *target;
  int i;
  string myfamily, obfamily;
  string fa_name, outarg;
  myfamily = (string)me->query("family/family_name");
  if (!myfamily) return notify_fail("你不属于任何门派！\n");
  ob = users();
  i = sizeof(ob);
  while (i--) {
    obfamily = (string)ob[i]->query("family/family_name");
    if ((myfamily == obfamily || wizardp(ob[i])) && !ob[i]->query("env/bangtalk")) {
      if (sizeof(target) == 0)
        target = ({ ob[i] });
      else
        target += ({ ob[i] });
    }
  }
  if (!stringp(outarg = arg))
    outarg = "．．．．．";
  message("vision", HIW "【" + myfamily + "】" +
    me->query("name") + "(" + capitalize(me->query("id")) + ")" +
    "：" + outarg + "\n" NOR, target);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : bangtalk 内容
与同门的玩家们通过【帮会】频道讲话
bangtalk也可以用bt来代替
HELP
  );
  return 1;
}
