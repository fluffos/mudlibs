// 助妖  zhuyao.c  by baiwt@sjpl 5,15,2000

#include <skill.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob;
  mapping skill;
  string mguard;
  int cost, sena;
  int amount = 0;
  int my_skill;
  if (!wizardp(me) && environment(me)->query("no_study"))
    return notify_fail("这里禁止练功。\n");
  if (me->query_temp("sleeping")) return notify_fail("你正在睡眠中。\n");
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if (me->query("age") > 90)
    return notify_fail("你的年龄不正常，请使用suicide指令修正。\n");
  if (!present("lianyao hu", me))
    return notify_fail("你并没有携带炼妖壶。\n");

  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来转移心神！\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成，不能转移心神。\n");

  if (!arg || sscanf(arg, "%s %d", mguard, sena) != 2)
    return notify_fail("指令格式：zhuyao <妖物名称> <神数量>\n");

  if (objectp(ob = present(mguard, environment(me))))
    return notify_fail("你只能为收在炼妖壶中的妖物增强法力。\n");

  if (!me->query_troop(mguard, 1))
    return notify_fail("你要为谁增强法力？\n");

  if (!me->query_skill("taoism", 1))
    return notify_fail("你不会天师正道，无法为他人增强法力。\n");

  message("vision", me->name() + "心神专一，将法力缓缓注入" + to_chinese(mguard)
    + "体内。\n", environment(me), me);

  cost = (400 - (int)me->query_skill("spells") - (int)me->query_int() * 10) / 2;
  if (cost < 10) cost = 10;
  if (cost > 100) cost = 100;
  if (cost > sena)
    return notify_fail("以你目前的能力，你至少要花" + chinese_number(cost) + "点神\n");
  if ((int)me->query("sen") <= sena) {
    write("你的心神不足，无法转化为他人的法力。\n");
    return 1;
  }

  me->receive_damage("sen", sena);

  amount = (cost + (int)me->query_skill("taoism", 1)) / 2;
  me->improve_troop(mguard, amount);

  write("你心神专一，将法力缓缓注入" + to_chinese(mguard) + "的体内。\n");
  me->start_busy(1);
  return 1;
}
