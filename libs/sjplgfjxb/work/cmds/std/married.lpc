// married.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *married;

  married = me->query("伴侣");
  if (!arg) {
    if (!pointerp(married) || !sizeof(married))
      write("你现在并没有任何伴侣。\n");
    else if (me->query("gender") == "女性")
      write("你现在老公是：" + implode(married, ", ") + "。\n");
    else write("你现在妻子有：" + implode(married, ", ") + "。\n");
    return 1;
  }

  if (pointerp(married) && member_array(arg, married) != -1) {
    write("解除你和 " + arg + " 的婚约。\n");
    married -= ({ arg });
    me->set("伴侣", married);
    return 1;
  } else {
    if (!pointerp(married)) {
      me->set("married", ({}));
      married = me->query("married");
    }
    if (pointerp(married) && member_array(arg, married) != -1)
      write(arg + "已经是你的伴侣。\n");
    else {
      married += ({ arg });
      me->set("伴侣", married);
      write(arg + "现在成为你的伴侣了。\n");
    }
    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式：married [<伴侣名字>]

HELP
  );
  return 1;
}
