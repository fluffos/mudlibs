//内月玄壮
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object env, link_ob, obj;
	int force,zhanyi, exp;
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");

	if((int)me->query("gin")< 50)
	return notify_fail("你的精太差了！\n");
	force = (int)me->query_skill("force");
	zhanyi = (int)me->query_skill("zhanyidie");
	exp = (int)me->query("combat_exp");
	if(force < 30 || zhanyi < 30)
	return notify_fail("你的沾衣十八跌和内功太差了，无法运内月玄壮！\n");	
	seteuid(getuid());
	me->receive_damage("gin",50);
//	me->is_busy(0);
//	me->add("force",-50);
      me->remove_all_killer();

        env = environment(me);
        link_ob = me->query_temp("link_ob");
        obj = LOGIN_D->make_body(link_ob);
        if (!obj) return 0;
        me->save();
        exec(link_ob, me);
        destruct(me);
        obj->restore();
        LOGIN_D->enter_world(link_ob, obj, 1);
        obj->move(env);
        write(HIC"你运起［内月玄壮］，刹那间打通了全身经脉，身体舒泰自如。\n\n"NOR);
//        obj->write_prompt();

	return 1;
}

