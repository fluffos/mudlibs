//释迦重生
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object env, link_ob, obj;
	int force,damo, exp;
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
	if((int)me->query("gin")< 50)
	return notify_fail("你的精太差了！\n");
	force = (int)me->query_skill("force");
	damo = (int)me->query_skill("damo-force");
	exp = (int)me->query("combat_exp");
	if(force < 50 || damo < 50)
	return notify_fail("你的达摩闭息功和内功太差了，无法运“释迦重生”！\n");	
	seteuid(getuid());
	me->receive_damage("gin",50);
//	me->is_busy(0);
//	me->add("force",-50);
      me->remove_all_killer();

        env = environment(me);
        link_ob = me->query_temp("link_ob");
        obj = LOGIN_D->make_body(link_ob);
        if (!obj) return 0;
        me->save();
        exec(link_ob, me);
        destruct(me);

        obj->restore();
        LOGIN_D->enter_world(link_ob, obj, 1);
        write(HIC"你运起［释迦重生］，刹那间打通了全身经脉，头顶现出一轮圆月，达到了三花聚顶的境界！\n\n"NOR);
        obj->move(env);
//        obj->write_prompt();

	return 1;
}

