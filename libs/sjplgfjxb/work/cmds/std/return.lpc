// return.c   created by baiwt@sjpl 1999,8,27

inherit F_CLEAN_UP;

int do_return(object me, object obj, object who);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item, oname;
	object obj, who, *inv, obj2;
	int i, amount;
	oname = me->query("guanfu/borrow_tool");
	if(!oname) 
		return notify_fail("你没有借过任何东西。\n");

	if(!arg) 
	return notify_fail("你目前借了" +oname+ "尚未归还。
指令格式 : return <物品名称> to <某人>\n
");

	if( sscanf(arg, "%s to %s", item, target)==2
	|| sscanf(arg, "%s %s", target, item)==2 );
	else return notify_fail("你要还谁什麽东西？\n");

	if(!objectp(who = present(target, environment(me))) || !living(who))
		return notify_fail("这里没有这个人。\n");

	if(sscanf(item, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )	
			return notify_fail("你身上没有这样东西。\n");
		if( !obj->query("guanfu/objattrib") )
			return notify_fail("这样东西不是借来的。\n");
		if( !obj->query_amount() )	
			return notify_fail( obj->name() + "不能被分开还人。\n");
		if( amount < 1 )
			return notify_fail("东西的数量至少是一个。\n");
		if( amount > obj->query_amount() ) 
			return notify_fail("你没有那麽多的" + obj->name() + "。\n");
		else if( amount == (int)obj->query_amount() )
			return do_return(me, obj, who);
		else {
			obj->set_amount( (int)obj->query_amount() - amount );
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			return do_return(me, obj2, who);
		}
	}

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			do_return(me, inv[i], who);
		}
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(item, me)))
		return notify_fail("你身上没有这样东西。\n");
	return do_return(me, obj, who);
}

int do_return(object me, object obj, object who)
{
		if( !obj->query("guanfu/objattrib") )
			return notify_fail("这样东西不是借来的。\n");

	if( !interactive(who) && !who->accept_object(me, obj) )
		return notify_fail("你只能把东西送还其他玩家操纵的人物。\n");

//	if( !userp(who) && obj->value() ) {
      if( !userp(who) && !who->query("can_carry") ) {
		tell_object(me,"你拿出" + obj->short() + "还" + who->name()+"。\n");
		destruct(obj);
		me->add("relation_exp",random(1));
		return 1;
	} else if( obj->move(who) ) {
		printf("你还%s一%s%s。\n", who->name(), obj->query("unit"),
			obj->name());
		message("vision", sprintf("%s还你一%s%s。\n", me->name(),
			obj->query("unit"), obj->name()), who );
//		message("vision", sprintf("%s还%s一%s%s。\n", me->name(), who->name(),
//			obj->query("unit"), obj->name()), environment(me), ({me, who}) );
		me->add("relation_exp",random(1));
	if( me->query("guanfu/borrow_tool") )
	   me->delete("guanfu/borrow_tool");
		me->save();
	   log_file( "return_LOG", sprintf("(%s)
%s return %s to %s\n", ctime(time()), me->query("id"), obj->query("name"), 
		who->query("id")));
		return 1;
	}
	else return 0;
}
int help(object me)
{
write(@HELP
指令格式 : return <物品名称> to <某人>
      或 : return <某人> <物品名称>
 
这个指令可以让你将某样物品还别人, 当然, 首先你要拥有这样物品.
 
HELP
    );
    return 1;
}
