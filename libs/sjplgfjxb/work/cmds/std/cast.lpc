// cast.c
#include <ansi.h>

#include <skill.h>
#define LOWER_LIMIT 2000
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, spl, trg;
	object target,man;
	
	seteuid(getuid());
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");

	if( me->is_busy() )
		return notify_fail("( 你上一个动作还没有完成，不能念咒文。)\n");

	if( environment(me)->query("no_magic") )
		return notify_fail("这里不准念咒文。\n");
	if (present("biao che", environment(me)))
		return notify_fail("你作法失败了。\n");
        if( !me->is_fighting() )
        return notify_fail("你只能在战斗中作法！\n");

	if( !arg ) return notify_fail("指令格式：cast <法术> [on <目标>]\n");
	if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
		target = present(trg, environment(me));
                if(!objectp(target)) 
	 		return notify_fail(" 你的咒文要用在谁身上？\n");
		if( !target ) target = present(trg, me);
		if( !target ) return notify_fail("这里没有 " + trg + "。\n");
	} else {
		spl = arg;
		target = 0;
	}
// add by baiwt@sjpl,12,17,1999
	if( me->query("kill_player_record") >= 300 )
		{
		me->set("force",0);
		me->set("force_factor",0);
		me->set_temp("weapon",0);
		me->add("kill_player_record", 10);
		return notify_fail("你刚动了意念，忽然感到身体一阵抽蓄，你的心魔发作了！\n");
		}
//	if( ((int)me->query("combat_exp") -(int)target->query("combat_exp") )>5000
//		&& userp(target) && !me->is_fighting() )
//		me->add("kill_player_record", random(99)+1);

	spl = replace_string( spl, " ", "_");
	
	if( stringp(spells = me->query_skill_mapped("spells")) )
	{
if( me->query("magic_exp") < (me->query_skill("spells")+me->query_skill("magic"))*(me->query("age"))*2 )
		me->add("magic_exp", random(5));
		return (int)SKILL_D(spells)->cast_spell(me, spl, target);
	}
		
	return notify_fail("你请先用 enable spells 指令选择你要使用的咒文系。\n");
}

int help (object me)
{
        write(@HELP
指令格式：cast <咒文名称> [on <施咒对象>]
 
施法，你必需要指定<咒文名称>，<施咒对象>则可有可无。
在你使用某一个咒文之前，你必须先用 enable 指令来指定你要使用的咒文系。
 
注：如果你改变自己的咒文系，你原本蓄积的法力并不能直接转换过去，必须
    从 0 开始。
 
HELP
        );
        return 1;
}
