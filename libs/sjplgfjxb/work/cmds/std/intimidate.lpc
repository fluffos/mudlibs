//威逼利诱  intimidate.c  created by Baiwt 12,16,1999
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	mapping my_family;
	int chance;
	string family;
	object target;
	if( !arg ) 
	return notify_fail("你要对谁进行威逼利诱？\n");
	if (!present(arg, environment(me)))
	return notify_fail("这里没有这个人。\n");
	target = present(arg, environment(me));
	if ((string)me->query("class") != "official")
	return notify_fail("什么？\n");
	if (me->query("id_type") != 3)
	return notify_fail("你不能对人进行威逼利诱。\n");
	if( !userp( target ))
	return notify_fail("只能对其他玩家进行威逼利诱。\n");
	if( target->query("class")=="official")
	return notify_fail("不能对其他朝廷命官进行威逼利诱。\n");
        if( !me->is_fighting() )
        return notify_fail("好象没有人要杀你！\n");
        if( (int)me->query("gin") < 50 )     
                return notify_fail("你的精力不够。\n");
        if( (int)me->query_skill("bixueforce",1) < 20) 
                return notify_fail("你的碧血心法还不够。\n");
        if( (int)me->query_skill("officialism",1) < 20) 
                return notify_fail("你的为官之道还不够。\n");
        if( (int)me->query_skill("economics",1) < 20) 
                return notify_fail("你的治国之方还不够。\n");
	seteuid(getuid());
	my_family = target->query("family");
	family = my_family["family_name"];
	if( !family ) family = "普通百姓";
	chance=random(9);
//	威逼here
	if (chance < 5)
	{
	message_vision(HIR"\n$N对$n厉声说道：你是身为"+family+"的人，竟敢对抗朝廷吗？\n" NOR, me,target);	
	message_vision(RED"\n$N正色道：你今天若犯下如此罪行，不仅你要被诛连九族，连所有亲近你的人都要受到严惩！\n" NOR, me,target);	
		if( random(target->query("cps")) < 20 )
		{
		message_vision(HIR"\n$N越想越觉后怕，招式渐渐迟缓下来。\n" NOR, target);	
		target->set("env/wimpy",100);
		me->add("gin",-30);
	       me->add("life_exp",random(1));
		return 1;
		}
		else
		message_vision(HIC"\n$N冷笑说道：我早已将身家性命置之度外了，你吓唬谁？\n" NOR, target);	
		me->add("gin",-30);
		return 1;
	}
//	利诱here
	else
	{
	message_vision(HIC"\n$N对$n说道：阁下是大有前途之人，为何要浪迹江湖？\n" NOR, me,target);	
	message_vision(CYN"\n$N陪笑道：你今天若放过我，包你日后高官厚禄、荣华富贵享用不尽！我会多加进言提拔阁下！\n" NOR, me,target);	
		if( random(target->query("cps")) < 20 )
		{
		message_vision(HIC"\n$N不禁喜上眉梢，说道：那很好啊，今后还要多靠大人栽培。\n" NOR, target);	
		me->remove_all_killer();
		me->add("gin",-30);
	       me->add("life_exp",random(1));
		return 1;
		}
		else
		message_vision(HIR"\n$N冷笑说道：我不会为名利所动，你趁早死了这条心吧！\n" NOR, target);	
		me->add("gin",-30);
		return 1;
	}
	return 1;
}

