#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object soldier, soldier2;
  object target;
  int changesword, dodge, exp, MAX_GUARD;
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的神太差了！\n");

  changesword = (int)me->query_skill("changesword");
  dodge = (int)me->query_skill("piaoxiang-steps");
  exp = (int)me->query("combat_exp");
  if (changesword < 20 || dodge < 20)
    return notify_fail("你的[身外化身剑外化剑]和[飘香步法]太差了，没法施展[分身化影]！\n");
  MAX_GUARD = changesword * dodge / 10000 + 1;
  if ((int)me->query_temp("max_guard") >= 2)
    return notify_fail("你已经施展过［分身化影］了。\n");
  seteuid(getuid());
  me->receive_damage("sen", 100);
  soldier = new("/u/baiwt/xueshan/xsnpc/shadow");
  soldier2 = new("/u/baiwt/xueshan/xsnpc/shadow");
  soldier->move(environment(me));
  soldier2->move(environment(me));
  soldier->invocation(me, (dodge + changesword));
  soldier2->invocation(me, (dodge + changesword));
  soldier->set("possessed", me);
  soldier2->set("possessed", me);
  me->add_temp("max_guard", 2);
  me->remove_all_killer();
  message_vision(HIM "\n$N身形晃动之间，施展出绝技 [分身化影] ！\n" NOR, me);
  message_vision("\n$N的化身出现了！\n" NOR, soldier);
  return 1;
}
