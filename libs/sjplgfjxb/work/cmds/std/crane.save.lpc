#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object soldier;
  int konghegong, xuanyinforce, exp, MAX_GUARD;
  if ((string)me->query("class") != "snowman")
    return notify_fail("你不是琼宫弟子，还是自己照顾自己吧！\n");
  if (!environment(me)->query("outdoors"))
    return notify_fail("这里无法召唤仙鹤！\n");

  if (present("zhangfatu2", environment(me)))
    return notify_fail("这里无法召唤仙鹤！\n");
  if (present("dugu wo", environment(me)))
    return notify_fail("这里无法召唤仙鹤！\n");

  if (!me->is_fighting())
    return notify_fail("好象没有人要杀你！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的神太差了！\n");
  konghegong = (int)me->query_skill("konghegong");
  xuanyinforce = (int)me->query_skill("xuanyinforce");
  exp = (int)me->query("combat_exp");
  if (konghegong < 50 || xuanyinforce < 50)
    return notify_fail("你的控鹤功和玄阴气功太差了，无法召唤仙鹤！\n");
  MAX_GUARD = konghegong * xuanyinforce / 10000 + 1;
  if ((int)me->query_temp("max_guard") >= 2)
    return notify_fail("你已经施展过［仙鹤护法］了。\n");
  seteuid(getuid());
  me->receive_damage("sen", 100);
  soldier = new("/u/baiwt/xueshan/xsnpc/baihe");
  soldier->move(environment(me));
  soldier->invocation(me, (xuanyinforce + konghegong));
  soldier->set("possessed", me);
  soldier->add("combat_exp", me->query("combat_exp") / 10);
  me->add_temp("max_guard", 1);
  me->remove_all_killer();
  me->start_busy(2);
  message_vision(HIC "\n$N发出一声长啸,啸声回旋震荡，远远传了开去...\n" NOR, me);
  message_vision(HIW "\n$N飞了过来。\n" NOR, soldier);
  if (konghegong > 100 || xuanyinforce > 100) {
    soldier->set("combat_exp", 1000000);
    soldier->set_skill("dodge", 300);
    soldier->set_skill("unarmed", 300);
    //	return 1;
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：crane.save
 
这个指令让琼宫弟子呼唤仙鹤来保护自己.
 
HELP
  );
  return 1;
}
