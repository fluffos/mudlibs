// mv.c
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
        string src, dst;
 	string wiz_status;
	wiz_status = SECURITY_D->get_status(me);

        seteuid(geteuid(me));
        if (!arg || sscanf(arg, "%s %s", src, dst)!=2 ) return
        notify_fail("指令格式: mv <原档名> <目标档名> \n");
 
        src = resolve_path(me->query("cwd"), src);
        dst = resolve_path(me->query("cwd"), dst);
/*
	if( file_size(src)>0 && !read_file(src) )  
            return notify_fail("【安全系统】你没有这个权限 ！\n");   
	if( file_size(dst)>0 && !read_file(dst) )  
            return notify_fail("【安全系统】你没有这个权限 ！\n");   
*/
	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "adm") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "include") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "data") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "daemon") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "cmds") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "topten") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "std") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "obj") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(dst, "feature") >=0)
		return notify_fail("你没有这个权限 ！\n");

        if( !rename(src, dst) )
                write("Ok.\n");
        else
                write("你没有足够的读写权利。\n");
        return 1;
}
 
int help(object me)
{
  write(@HELP
指令格式 : mv <原档名> <目标档名>
 
此指令可让你(□)修改某个档案或目录名称。
HELP
    );
    return 1;
}
 
