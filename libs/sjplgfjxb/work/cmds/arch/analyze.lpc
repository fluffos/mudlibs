// analyze.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string str;
	mapping apply, weapon;

	if( !arg ) ob = me;
	else {
		if( !(ob = find_player(arg))
		&&	!(ob = present(arg, environment(me)))
		&&	!(ob = find_living(arg)) )
			return notify_fail("这里没有 " + arg + " 这种生物　\n");
	}

	str = sprintf("%s的各项能力分析：\n\n", ob->name());
	str += sprintf("攻势等级\t%d\n", ob->query_ability("intimidate"));
	str += sprintf("攻击力\t\t能力值 %d，强度 %d\n", ob->query_ability("attack"), ob->query_strength("attack"));
	str += sprintf("守势等级\t%d\n", ob->query_ability("wittiness"));
	str += sprintf("防御力\t\t能力值 %d，强度 %d\n", ob->query_ability("defense"), ob->query_strength("defense"));
//	str += sprintf("魔力\t\t能力值 %d，强度 %d\n", ob->query_ability("magic"), ob->query_strength("magic"));
//	str += sprintf("法力\t\t能力值 %d，强度 %d\n", ob->query_ability("spell"), ob->query_strength("spell"));
//	if( mapp(weapon  = ob->query_temp("weapon")) && sizeof(weapon) ) {
//		string term;
//		str += "使用武器\t";
//		foreach(term in keys(weapon)) {
//		str += sprintf("%-30s  攻击能力值 %+d\n\t\t", weapon[term]->name() + "(" + term + ")",
//					ob->query_skill(term));
//		}
//	}
//	else str += sprintf("徒手攻击\t攻击能力值 %+d\n", ob->query_skill("unarmed"));

//	if( mapp(apply = ob->query_temp("apply")) ) {
//		string term;
//		mixed prop;
//
//		str += "\n其他附加能力/属性\n";
//		foreach(term, prop in apply)
//			str += sprintf("  %-20s  %O\n", term, prop);
//	}

	write(str);
	return 1;
}

int help()
{
	write(@TEXT
指令格式：analyze [<对象>]

这个指令会列出一些有关指定对象的能力值，不指定对象时则列出你自己的
能力值　
TEXT
	);
	return 1;
}
