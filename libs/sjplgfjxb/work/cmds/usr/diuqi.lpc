// diuqi.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mapping troop_status;
	int i;
	string *skname;

	if( !arg )
	{
	troop_status = me->query_troops();
	if( troop_status )
	{
	skname  = keys(troop_status);
	for(i=0; i<sizeof(troop_status); i++) {
		me->delete_troop(skname[i]);
	write("你决定丢弃" + to_chinese(skname[i]) + "。\n");
	continue;
	}
	me->save();
	return 1;
       }
	}
	else{
	if( !me->query_troop(arg,1))
		{
		write("你没有携带该物品或生物。\n");
		return 1;
		}
	me->delete_troop(arg);
	write("你决定丢弃" + to_chinese(arg) + "。\n");
	me->save();
	return 1;
	}
	write("你没有携带战斗队伍。\n");
	return 1;
}

