// home.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string msg,home;
	if( !wizardp(me) )
		return notify_fail("你的工作室不存在。\n");
	if(!(home = me->query("env/home"))) 
		return notify_fail("你没有设定自己的工作室。\n");

//	printf("Your workroom is %s\n",home);
       if( me->is_fighting() || me->is_busy() )
		return notify_fail("你正忙着呢。\n");
 
	if( file_size(home) <= 0 )
		return notify_fail("你的工作室不存在。\n");

	if( stringp(msg = me->query("env/msg_home")) )
		message_vision(msg + "\n", me);
	me->move(home);
	message( "vision", me->name() + "走了过来。\n", environment(me), ({me}) );
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : home

利用此一指令可直接回到自己的工作室。
如果你有 'msg_home' 这个设定, 则在场的人都会看到那个讯息.
HELP
    );
    return 1;
}
