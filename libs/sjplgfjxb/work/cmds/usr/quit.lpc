// quit.c

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
  set("name", "离线指令");
  set("id", "quit");
}

int main(object me, string arg) {
  int i, pprank, ppranked;
  object *inv, link_ob, navy1;
  int stage;

  stage = me->query_temp("suicide_countdown");

  if (!wizardp(me) && (stage < 1) && me->is_busy()) {
    return notify_fail("你上一个动作还没有完成,不能退出。\n");
  }
  if (me->query_temp("xiaoyao/quest")) {
    if ((int)me->query("combat_exp") <= 300) {
      me->set_temp("xiaoyao/quest", 0);
      me->set_temp("over", 0);
      write("朦胧中你仿佛听到一声叹息：“唉. . . . . .”\n");
    } else {
      me->add("combat_exp", -random(200) - 100);
      me->set_temp("xiaoyao/quest", 0);
      me->set_temp("over", 0);
      write("朦胧中你仿佛听到一声叹息：“唉. . . . . .”\n");
    }
  }
  //		return notify_fail("你现在尚有任务，请使用quest指令取消后再退出。\n");
  if (!me->query("mojiao/xtkid") && me->query("age") < 20 && me->query("combat_exp") > 3000000) {
    me->set("checked_old_exp", me->query("combat_exp"));
    me->set("checked_old_pot", (me->query("potential") - me->query("learned_points")));
    me->set("combat_exp", me->query("combat_exp") / 3);
    me->set("potential", me->query("learned_points"));
    me->save();
    return notify_fail("\n你被系统怀疑曾利用BUG练功！如果没有，请与本MUD天神联系。\n");
  }
  if (me->query_temp("sleep/no_move"))
    return notify_fail("你现在无法动弹，不能退出。\n");
  if ((int)me->query_temp("maohe_shenli"))
    return notify_fail("你正在运行［貌合神离］中，不能退出。\n");
  if (me->is_fighting())
    return notify_fail("你抽身想走，但却被挡了回来。\n");
  if (me->query_temp("is_in_battle")) {
    if (me->query("quest/guanfu"))
      me->delete("quest/guanfu");
    if (me->query("battle/equip"))
      me->delete("battle/equip");
    if (environment(me)->query("already_battle")) {
      navy1 = environment(me);
      navy1->delete("already_battle");
    }
    if (present("navy official", environment(me))) {
      navy1 = present("navy official", environment(me));
      navy1->set("gotime", 2);
      navy1->set("kee", 9000);
      navy1->set("sen", 9000);
    }
  }

  if (me->is_busy()) {
    return notify_fail("你上一个动作还没有完成,不能退出。\n");
  }
  if (!wizardp(me)) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }

  link_ob = me->query_temp("link_ob");

  // We might be called on a link_dead player, so check this.
  if (link_ob) {

    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }

    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(me));
    link_ob->save();
    destruct(link_ob);
  }

  write("欢迎下次再来！\n");
  message("system", me->name() + "离开游戏。\n", environment(me), me);

  CHANNEL_D->do_channel(this_object(), "sys",
    me->name() + " ( " + me->query("id") + " ) " + "离开游戏了。");
  // don't why need this, some linux give players full kee if quit with 0 kee
  // but some does not!
  if (!(int)me->query("kee")) me->set("kee", 1);
  me->save();
  log_file("USAGE", sprintf("%s quits at %s with exp: %d, pot: %d, money: %d\n",
    me->query("id"), ctime(time()), me->query("combat_exp"),
    me->query("potential"),
    me->query("deposit")));
  destruct(me);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quit

当你(□)想暂时离开时, 可利用此一指令。
HELP
  );
  return 1;
}
