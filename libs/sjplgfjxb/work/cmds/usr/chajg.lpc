// /cmds/usr/chajg.c  机关查看指令  by baiwt 2000,6,21

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob, *list, couple_ob;
	mapping skl, lrn, map;
	string *sname, *mapped,target,cardname;
	int i, marry_flag;

	seteuid(getuid());

	if( !(string)me->query_temp("use_jiguan_ren") )
		return notify_fail("你现在无法察看自己的机关物品。\n");
	if(!arg)
		ob = me;
	else{
		ob = present(arg, environment(me));
        if ( ob->query("SPTROOPS",1)  ) return ob->troops();		 
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if( !wizardp(me) )
		return notify_fail("你只能察看自己机关物品的情况。\n");
		if (!ob)
		return notify_fail("没有这个人。\n");
	}
	target = (string) me->query("marry");	
	if(stringp(target)) couple_ob = find_player(target);
	if( ob!=me && !wizardp(me) && !ob->is_apprentice_of(me)
	&& !me->is_apprentice_of(ob) && ob!=couple_ob
	&& !ob->query("troop_public") )
		return notify_fail("只有巫师或有师徒关系的人能察看他人所制造的机关。\n");

	skl = ob->query_troops();
	if(!sizeof(skl)) {
		write( (ob==me ? "你" : ob->name()) + "目前并没有携带任何机关。\n");
		return 1;
	}
	write( (ob==me ? "你" : ob->name()) +"目前所携带的机关物品：\n\n");
	write( "　　 机关名称                            属性        等级     战斗力\n\n");
	sname  = sort_array( keys(skl), (: strcmp :) );
	
	map = ob->query_troop_map();
	if( mapp(map) ) mapped = values(map);
	if( !mapped ) mapped = ({});

	lrn = ob->query_trained();
	if( !mapp(lrn) ) lrn = ([]);
	
	for(i=0; i<sizeof(skl); i++) {
		printf(" %s%s%-30s" NOR "- %10s%10d%10d\n", 
			(lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIM : "",
			(member_array(sname[i], mapped)==-1? "  ": "◆"),
			to_chinese(sname[i]) + " (" + sname[i] + ")",
		       (TROOP_D(sname[i])->effective_attrib()),(TROOP_D(sname[i])->effective_level()),
			skl[sname[i]], 
		);
	}
	write("\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : chajg [<某人>]

这个指令可以让你查询所统帅的部属。

你也可以指定一个和你有师徒关系的对象，用 chajg 可以查知对方所统帅的部属状况。

巫师可以查询任何人或 NPC 所统帅的部属状况。

HELP
    );
    return 1;
}
