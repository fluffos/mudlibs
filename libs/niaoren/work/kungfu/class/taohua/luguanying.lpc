// luguanying.c 

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void greeting(object);
void init();


void create()
{
    set_name("陸冠英", ({"lu guanying", "lu", "guanying"}));
    set("title",WHT "歸云庄少庄主" NOR);    
    set("gender", "男性");
    set("age", 23);
    set("long", 
        "這是歸云庄的少庄主。長身玉立，身型矯健，充滿了年輕人的朝氣。\n"
        );

    set("attitude", "peaceful");
      
    set("str", 24);
    set("int", 20);
    set("con", 21);
    set("dex", 20);

    set("qi", 1300);
    set("max_qi", 1300);
    set("jing", 300);
    set("max_jing", 300);
    set("neili", 2300);
    set("max_neili", 2300);
    set("jiali", 100);
       
    set("combat_exp", 700000);
    set("score", 0);
       
    set_skill("force", 130);
    set_skill("bibo-shengong", 120);
    set_skill("unarmed", 130);
    set_skill("luoying-zhang", 120);
    set_skill("dodge", 130);
    set_skill("anying-fuxiang", 120);
    set_skill("parry", 120);
    set_skill("sword", 120);
    set_skill("luoying-shenjian",120);
    set_skill("literate", 120);
    set_skill("qimen-wuxing",120);
    set_skill("cuixin-zhang",120);

    map_skill("force"  , "bibo-shengong");
    map_skill("unarmed", "cuixin-zhang");
    map_skill("dodge"  , "anying-fuxiang");
    map_skill("sword"  , "luoying-shenjian");
    map_skill("parry"  , "luoying-shenjian");
       
    create_family("桃花島", 3, "弟子");

       set("inquiry", ([
           "拜師" : "那你就拜我吧。", 
           "桃花島" : "那是我派師公的駐地，遠在海外。",
            ]) );

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: command("unwield jian") :),
		(: perform_action, "unarmed.cu1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
                (: exert_function, "p" :),
                (: command("wield jian") :),
        }) );
    setup();

    carry_object("/d/taohua/obj/baipao")->wear();
    carry_object("/d/taohua/obj/changjian")->wield();
 }

void init()
{
       object ob;

       ::init();

       if( interactive(ob = this_player()) && !is_fighting() ) {
               remove_call_out("greeting");
               call_out("greeting", 1, ob);
       }
}
void greeting(object ob)
{
       if( !ob || environment(ob) != environment() ) return;
       if((string)ob->query("family/family_name")=="桃花島")
          { say(WHT "陸冠英笑吟吟地說道：這位" + RANK_D->query_respect(ob)
            + "您辛苦了，快請進吧　。\n" NOR);
            return;
           }
       if(!ob->query("family/family_name"))
          { say(WHT "陸冠英滿臉笑容地說道：這位" + RANK_D->query_respect(ob)
            + ",歡迎您到歸云庄做客。\n" NOR);
            return;
           }

}

void attempt_apprentice(object ob)
{
     command("say 好吧，我收下你，你今后要用功群奮，不要辱沒了師門。\n");
     command("recruit "+ob->query("id"));
     command("say 到后堂去休息一下吧。\n");
     return;
}

