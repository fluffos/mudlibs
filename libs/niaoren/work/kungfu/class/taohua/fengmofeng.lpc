// /kungfu/class/fengmofeng
// adx 4:16 99-2-12

#include <ansi.h>
inherit NPC;
string ask_me(string name);

void create()
{
	set_name("馮默風", ({ "feng mofeng", "feng", "mofeng" }));
	set("long", "他是黃藥師最小的弟子，只斷了一條腿。\n");
	set("gender", "男性");
	set("age", 30);
        set("attitude", "peaceful");
	set("str", 30);
	set("dex", 32);
	set("con", 17);
	set("int", 25);
        set("shen_type", 1);

        create_family("桃花島", 2, "弟子");

	set_skill("force", 220);
        set_skill("bibo-shengong", 220);
        set_skill("dodge", 160);
        set_skill("anying-fuxiang", 160);
        set_skill("parry", 250);
	set_skill("sword", 250);
	set_skill("luoying-shenjian",250);
        set_skill("unarmed",230);
	set_skill("luoying-zhang",180);
	set_skill("cuixin-zhang",230);
        set_skill("finger",200);
	set_skill("tanzhi-shentong",200);
	set_skill("qimen-wuxing",200);
	set_skill("literate",200);

        map_skill("force"  , "bibo-shengong");
        map_skill("unarmed" , "cuixin-zhang");
        map_skill("dodge"  , "anying-fuxiang");
        map_skill("parry"  , "cuixin-zhang");
        map_skill("sword"  , "luoying-shenjian");
        map_skill("finger"  , "tanzhi-shentong");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
		(: perform_action, "finger.ta1" :),
		(: perform_action, "finger.ta2" :),
                (: perform_action, "unarmed.cu1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
                (: exert_function, "p" :),
        }) );
	setup();

	set("jiali",150);
	set("combat_exp", 2500000);
	set("max_qi", 5000);
	set("max_jing", 1200);
	set("neili", 8000);
	set("max_neili", 8000);

        set("inquiry", ([
	"武器" :   (: ask_me, "changjian" :),
	"劍" :   (: ask_me, "changjian" :),
        ]));

	set("foor_count", 2);

	setup();
	carry_object("/d/taohua/obj/cloth")->wear();
	
}
string ask_me(string name)
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "桃花島")
		return RANK_D->query_respect(this_player()) + 
		"你與本派素無來往，不知此話從何談起？";

	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你現在身上不是有嗎，怎麼又來要了？真是貪得無厭！";

	if (query("foor_count") < 1)
		return "抱歉，你來得不是時候，長劍已經沒有了。";

	ob = new("/d/taohua/obj/" + name);
	ob->move(this_player());

	add("foor_count", -1);

	message_vision(YEL"馮默風給$N一個" + ob->query("name") + "。\n"NOR, this_player());

	return "給。";
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 25) {
        command("say 我不收資質差的弟子，您請回吧！");
		return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 100 ) {
        command("say 你的本門內功心法太低了,還是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query("shen") < 10000 ) {
        command("say 你多行不義，還是多多行俠仗義，日后在來吧！");
		return;
	}
    command("say 好吧，今后你要群奮練功，光大本門。");
    command("recruit " + ob->query("id"));
}
