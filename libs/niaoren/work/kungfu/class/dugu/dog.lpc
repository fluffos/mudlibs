// dog.c 鐵公雞
//made by jordan
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name(HIC"鐵公雞"NOR, ({ "dog" }));
        set("nickname",HIG "超級有錢" NOR);
        set("long",HIY 
                "他就是獨孤山莊的金主外號鐵狗的鐵公雞，沒事不要殺他哦！\n"
                "他身上沒有錢的！不過金票就不知道有沒有了！\n"NOR);
        set("gender", "男性");
        set("age", 35);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("per", 39);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 4000);
        set("max_jing", 1800);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 120);
        set("combat_exp", 1500000);
        set("score", 400000);

        set_skill("force", 180);
        set_skill("taiji-shengong", 180);
        set_skill("dodge", 180);
        set_skill("tiyunzong", 180);
        set_skill("unarmed", 180);
        set_skill("taiji-quan", 180);
        set_skill("parry", 180);
        set_skill("sword", 200);
        set_skill("taiji-jian", 200);
        set_skill("taoism", 200);
        set_skill("literate", 200);
        set_skill("god-sword", 200);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "god-sword");

        create_family("獨孤山莊", 1, "大金主");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.go1" :),
                (: perform_action, "sword.go2" :),
                (: perform_action, "sword.go3" :),
                (: perform_action, "sword.go4" :),
                (: perform_action, "parry.ta1" :),
                (: perform_action, "parry.ta2" :),
                (: perform_action, "parry.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

        setup();
        carry_object("/d/dugu/obj/changjian")->wield();
        add_money("gold", 50);
        carry_object("/d/dugu/obj/opq_cloth")->wear();
}

