// zhang.c 張三丰
//made by jordan
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name(HIY "問天"NOR, ({ "jordan" }));
        set("nickname", HIC "天劍" NOR);
        set("long", 
                HIY"他就是當今獨孤山莊大莊主、因某種因素，曾拜華山及武當門下，盡得真傳，身兼兩家之長。\n"
                "後來因緣際會成為獨孤山莊大莊主，從而習得獨孤山莊不傳絕學「天劍神訣」，江湖人稱「天劍」。\n"
                "天下第一富商「鐵公雞」是其結拜大哥，也因此獨孤山莊的經濟來源不虞匱乏。\n"NOR);
        set("gender", "男性");
        set("age", 30);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("per", 39);
        set("str", 45);
        set("int", 50);
        set("con", 45);
        set("dex", 45);
        
        set("max_qi", 200000);
        set("max_jing", 10000);
        set("neili", 100000);
        set("max_neili", 100000);
        set("jiali", 350);
        set("combat_exp", 10000000);
        set("score", 3000000);

        set_skill("force", 400);
        set_skill("taiji-shengong", 400);
        set_skill("dodge", 400);
        set_skill("tiyunzong", 400);
        set_skill("unarmed", 400);
        set_skill("taiji-quan", 400);
        set_skill("parry", 400);
        set_skill("sword", 450);
        set_skill("taiji-jian", 450);
        set_skill("blade", 350);
        set_skill("taiji-dao", 350);
        set_skill("taoism", 500);
        set_skill("literate", 500);
        set_skill("dugu-jiujian", 450);
        set_skill("god-sword", 450);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "god-sword");
        map_skill("blade", "taiji-dao");

        create_family("獨孤山莊", 1, "大莊主");
        set("class", "taoist");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.go1" :),
                (: perform_action, "sword.go2" :),
                (: perform_action, "sword.go3" :),
                (: perform_action, "sword.go4" :),
                (: perform_action, "parry.ta1" :),
                (: perform_action, "parry.ta2" :),
                (: perform_action, "parry.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );
        set("inquiry", ([
                "問天神功第一層心法" : "只enable 招架、內功及一門空手特殊功夫。\n",
                "問天神功第二層心法" : "第二層心法跟烤雞腿及雙手互博有關。\n",
                "鐵公雞" : "他是我最敬愛的大哥，也是天下第一富商。\n",
                "鳥人一號" : "他是這武林的天神之一，據說身材異常肥胖，不過他待人很好，為人熱心。\n",
                "尼克" : "他也是這武林的天神之一，曾救了我一命，是我的大恩人。\n",
                "青天" : "他是我嗎計的，目前還在軍中服務，我AOE II最好的戰友。\n",
                "紫炎" : "他也是這武林的天神之一，常常打電話跟我聊天，是個很能跟他商量心事的人。\n",
                "小瑋" : "他是我的好朋友，不過之間好像有點誤會，但是還是我最好的朋友之一。\n",
                "本伊" : "他是我的小弟，為人不拘小節，我跟他處的最和得來，只是近來很少看見他。\n",
                "順" : "他是我的馬子，也是天下第一美女喔！不過脾氣有點古怪。\n",
                "忍者" : "他是我的好對手，武功堪稱天下第一。\n",
                "吉斯" : "他是我以前當兵的學長，常常跟我打MUD打到很晚，蠻懷念以前的時光的。\n",
                "求敗" : "他也是我以前當兵的學長，我常常去他們辦公室串門子。\n",
                "佛道魔" : "他是我認識最沒官架子的軍官，人粉好，沒有什麼脾氣，經常跟我一起聊天\n",
                "曠世" : "他是我的AOE II對手之一，不過他常輸，希望他能加油，呵呵！\n",
                "阿信" : "他是我看過最好相處的人，為人忠厚老實，是我的第一繼承人，是個值得深交的朋友。\n",
                "藍海" : "他是我最傑出的徒弟，也是我最大的金斯貓供應站，與我個性最和。\n",
        ]));
        
        set("chat_chance", 3);
        set("chat_msg", ({
                    "問天說道：不知大鳥跟尼克等巫師過的如何？\n",
                    "問天說道：阿信跟藍海是我的最優秀的繼承人。\n",
                    "問天說道：好久沒看到大哥了！\n",
                    "問天說道：曠世！打AOE II囉！\n",
                    "問天說道：本伊最就好像都沒上來玩！好奇怪！\n",
                    "問天說道：問天神功跟金蛇游身掌和雙手互搏有很大的關係喔！\n",
                    "問天說道：不知道青天調差後過的好不好？\n",
                    "問天說道：獨孤禁地劍塚千萬不要亂闖！\n",
                    "問天說道：吉斯最近好像研究出一種可以增加內力的藥！\n",
        }) );

        setup();
        carry_object("/d/dugu/obj/changjian")->wield();
        carry_object("/d/dugu/obj/jordan_cloth")->wear();
        carry_object("/d/dugu/obj/jordan_ring")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("taiji-shengong", 1) < 250) {
                command("say 我獨孤山莊乃內家武功，最重視內功心法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在太極神功上多下點功夫？");
                return;
        }
        if ((int)ob->query("shen") < 3000000) {
                command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        if (ob->query_int() < 50) {
                command("say 我獨孤山莊武功全從道藏悟出。");
                command("say 要能達到爐火純青之境，體質什么的倒是無關緊要，悟性卻是半點也馬虎不得。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("chat 哈哈哈哈！！！！");
        command("chat 歡迎加入獨孤山莊，希望你能為山莊盡一份心力。");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
                ob->set("class", "taoist");
}
