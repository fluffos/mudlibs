// cms.c 青天

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_me();

void create()
{
        set_name(HIC"青天"NOR, ({ "cms" }));
        set( "nickname",HIB "義薄雲天" NOR);
        set("long", 
                HIY"他就是獨孤山莊二莊主，原本是武當派最傑出的弟子，後來投筆從戎，盡忠報國。\n"
                "身穿一件天空色的空軍軍服，身材瘦長，滿臉紅光，相當英俊，有如白馬王子般。\n"
                "因與問天臭氣相投進而和問天結拜成兄弟並加入獨孤山莊，成為獨孤山莊二莊主。\n"NOR);
        set("gender", "男性");
        set("age", 35);
        set("per",37);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 40);
        set("int", 40);
        set("con", 40);
        set("dex", 40);
        
        set("max_qi", 10000);
        set("max_jing", 5000);
        set("neili", 10000);
        set("max_neili", 10000);
        set("jiali", 210);
        set("combat_exp", 5000000);
        set("score", 2000000);

        set_skill("force", 300);
        set_skill("taiji-shengong", 300);
        set_skill("dodge", 250);
        set_skill("tiyunzong", 250);
        set_skill("unarmed", 250);
        set_skill("taiji-quan", 250);
        set_skill("parry", 300);
        set_skill("sword", 300);
        set_skill("taiji-jian", 300);
        set_skill("taoism", 300);
        set_skill("literate", 250);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        create_family("獨孤山莊" ,2, "二莊主");

        set("inquiry", ([
                "秘籍" : (: ask_me :),
        ]));

        set("book_count", 1);

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

        setup();
        carry_object("/d/dugu/obj/justice")->wield();
        carry_object("/d/dugu/obj/cms_junfu")->wear();

}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("shen") < 1000000 )
         {
                command("say 我獨孤山莊乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
         }
        if ((int)ob->query_skill("taiji-shengong",1) < 200 ||
                (int)ob->query_skill("force",1) < 200 )
        {
                command("say 我獨孤山莊最注重內功心法"+RANK_D->query_respect(ob)+
                        "是否應該在內功上多下點功夫啊?");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚我獨孤山莊的精神!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
                ob->set("class", "taoist");
}

string ask_me()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "獨孤山莊")
                return RANK_D->query_respect(this_player()) + 
                "與本派素無來往，不知此話從何談起？";
        if (query("book_count") < 1)
                return "你來晚了，我的秘笈已經送人了。";
        add("book_count", -1);
        ob = new(__DIR__"cms_book");
        ob->move(this_player());
        return "好吧，這本「青天心法」你拿回去好好鑽研。";
}
