// opq.c 小問天
//made by jordan
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name(HIC"小問天"NOR, ({ "opq" }));
        set("nickname",HIM "活潑可愛" NOR);
        set("long",HIY 
                "他就是獨孤山莊少莊主小問天，承襲了父親優良的血統，天生慧詰。\n"
                "他看起來十多歲，顯得稚氣未脫，一副聰明伶俐的樣子，人見人愛。\n"
                "他已盡得父親問天真傳，武功超過同輩甚多，堪稱年輕一代高手。\n"NOR);
        set("gender", "男性");
        set("age", 15);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("per", 39);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 4000);
        set("max_jing", 1800);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 120);
        set("combat_exp", 1500000);
        set("score", 400000);

        set_skill("force", 180);
        set_skill("taiji-shengong", 180);
        set_skill("dodge", 180);
        set_skill("tiyunzong", 180);
        set_skill("unarmed", 180);
        set_skill("taiji-quan", 180);
        set_skill("parry", 180);
        set_skill("sword", 200);
        set_skill("taiji-jian", 200);
        set_skill("taoism", 200);
        set_skill("literate", 200);
        set_skill("god-sword", 200);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "god-sword");

        create_family("獨孤山莊", 2, "少莊主");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.go1" :),
                (: perform_action, "sword.go2" :),
                (: perform_action, "sword.go3" :),
                (: perform_action, "sword.go4" :),
                (: perform_action, "parry.ta1" :),
                (: perform_action, "parry.ta2" :),
                (: perform_action, "parry.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

        setup();
        carry_object("/d/dugu/obj/changjian")->wield();
        carry_object("/d/dugu/obj/opq_cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("shen") < 30000 )
         {
                command("say 我獨孤山莊乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
         }
        if ((int)ob->query_skill("taiji-shengong",1) < 60 ||
                (int)ob->query_skill("force",1) < 60 )
        {
                command("say 我獨孤山莊最注重內功心法"+RANK_D->query_respect(ob)+
                        "是否應該在內功上多下點功夫啊?");
                return;
        }
        if ((int)ob->query_skill("sword") < 60)
        {
                command("say 我派太極劍精奧博大,要學好他,需得打好基本功,我看你還是不夠用功"); 
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚我獨孤山莊的精神!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
                ob->set("class", "taoist");
}
