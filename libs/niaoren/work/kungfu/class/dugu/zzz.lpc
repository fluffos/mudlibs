// zzz.c 求敗
//made by jordan
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name(HIB "求敗" NOR, ({ "zzz" }));
        set("nickname",HIR "嫉惡如仇" NOR);
        set("long",HIR 
                "他就是獨孤山莊四莊主求敗，嫉惡如仇，性如烈火，常因憤怒而失去了理智。\n"
                "他負責看守獨孤山莊的大門，任何不法份子想闖關的得通過他。\n"
                "他除了一身武當武藝外，還學了一手段家劍，驚天一擊尤其驚人，死在他手上的邪惡之徒不計其數。\n"NOR);
        set("gender", "男性");
        set("age", 30);
        set("attitude", "heroism");
        set("shen_type", 1);
        set("per", 29);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 4200);
        set("max_jing", 3000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 200);
        set("combat_exp", 3000000);
        set("score", 1200000);

        set_skill("force", 220);
        set_skill("taiji-shengong", 220);
        set_skill("dodge", 220);
        set_skill("duanjia-sword", 250);
        set_skill("tiyunzong", 250);
        set_skill("unarmed", 220);
        set_skill("taiji-quan", 200);
        set_skill("parry", 200);
        set_skill("sword", 220);
        set_skill("taiji-jian", 220);
        set_skill("taoism", 200);
        set_skill("literate", 200);
        set_skill("kurong-changong", 250);
        
        map_skill("force", "kurong-changong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "duanjia-sword");
        map_skill("sword", "duanjia-sword");

        create_family("獨孤山莊", 2, "四莊主");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.du1" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        setup();
        carry_object("/d/dugu/obj/changjian")->wield();
        carry_object("/d/dugu/obj/zzz_cloth")->wear();
}
        void init()
        {
                ::init();
        remove_call_out("greeting");
        call_out("greeting", 1, this_player());
}


void greeting(object ob)
{
        mapping fam;
        int i ;
        object me;
        object* obj;
        me = this_object();
        if (interactive(ob) 
        && !environment(ob)->query("no_fight"))
        {
             if (!(fam = ob->query("family")) || fam["family_name"] != "獨孤山莊")
                {
                   if (ob->query("shen")>-1000)      
                        {
                        command("say 這里是獨孤山莊大門，你在這里瞎逛什么？");
                        obj = all_inventory(environment(me));
                        for(i=0; i<sizeof(obj); i++) 
                        {
                        if(obj[i]==this_player()) continue;
                        if(obj[i]==me) continue;
                        if((obj[i]->query("title")=="盜賊")||(obj[i]->query("shen")<-1000)) 
                        {
                                command("say 大膽狗賊,敢在此胡作非為,看招!!");
                                me->kill_ob(obj[i]);
                                obj[i]->kill_ob(me);
                        }
                        }
                        }       

           else{
                        command("say 一定要殺了你這江湖敗類！");
                        me->set_leader(ob);
                        remove_call_out("kill_ob");
                        call_out("kill_ob", 1, ob); 
                
                        }

                }    
        }       

}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("shen") < 500000 )
         {
                command("say 我獨孤山莊乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
         }
        if ((int)ob->query_skill("taiji-shengong",1) < 150 ||
                (int)ob->query_skill("force",1) < 150 )
        {
                command("say 我獨孤山莊最注重內功心法"+RANK_D->query_respect(ob)+
                        "是否應該在內功上多下點功夫啊?");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚我獨孤山莊濟弱除惡的精神!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
                ob->set("class", "taoist");
}
