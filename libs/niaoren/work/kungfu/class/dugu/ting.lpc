inherit NPC;

void create()
{
        set_name("[1;36m十三姨[0m", ({"ting","13"}));
        set("nickname", "絕世美人");
        set("long",
        "他是黃飛鴻的『小老婆』之一．\n");

        set("gender", "女性");
        set("class", "taoist");

        set("age", 18);
        set("shen", 1000000);

        set("per", 22);
        set("str", 100);
        set("dex", 100);
        set("int", 100);
        set("con", 100);
        set("food", 1100);
        set("water", 1100);

        set("qi", 4000);
        set("max_qi", 4000);
        set("jing", 4000);
        set("max_jing", 4000);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiaji", 4000);

        set("combat_exp", 4000000);
        set("score", 100000);

        set("startroom","/u/netws/love4");

        set_skill("force", 400);
        set_skill("taiji-shengong",400);
        set_skill("dodge", 400);
        set_skill("tiyunzong", 400);
        set_skill("unarmed", 400);
        set_skill("taiji-quan",400);
        set_skill("parry", 400);
        set_skill("sword", 400);
        set_skill("taiji-jian", 400);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("unarmed", "taiji-quan");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


set("chat_chance", 10);
        set("chat_msg", ({
                "[1;36m十三姨[0m深情地看著[1;36m黃飛鴻[0m，給了[1;36m黃飛鴻[0m淺淺卻無限情意的吻。\n",
                "[1;36m十三姨[0m和[1;36m黃飛鴻[0m兩個人相互對望著，臉上都顯現出一股回到舊日的神情，不禁令人羨慕他們倆∼\n"
 }) );


        setup();
        carry_object("/d/dugu/obj/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();

}

