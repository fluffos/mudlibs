// chess.c 吉斯
//made by jordan
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();
void create()
{
        set_name(HIG"吉斯"NOR, ({ "chess" }));
        set("nickname",HIW "柴米油鹽" NOR);
        set("long", 
"他是天下第一廚吉斯，原本是前途看好的華山新一代弟子，卻因為天性恬淡，\n"
"再加上喜歡烹飪，無心於練武，而投靠獨孤山莊，他的手藝驚人，味覺亦相當敏銳，。\n"
"曾跟名廚傅培梅學過做菜，天下第一廚當之無愧！\n");
        set("gender", "男性");
        set("age", 35);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("per", 22);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("qi", 3500);
        set("max_qi", 3500);
        set("jing", 1200);
        set("max_jing", 1200);
        
        set("neili", 7000);
        set("max_neili", 7000);
        set("jiali", 100);

        set("combat_exp", 2500000);
        set("score", 500000);

        set_skill("blade", 220);
        set_skill("cuff", 220);
        set_skill("strike",220);
        set_skill("force", 220);
        set_skill("dodge", 220);
        set_skill("parry", 250);
        set_skill("sword", 220);
        set_skill("dugu-jiujian", 220);
        set_skill("zixia-shengong", 250);
        set_skill("poyu-quan", 220);
        set_skill("fanliangyi-dao", 220);
        set_skill("hunyuan-zhang", 220);
        set_skill("huashan-jianfa", 220);
        set_skill("huashan-shenfa",220);
        set_skill("literate", 200);


        map_skill("force", "zixia-shengong");
        map_skill("cuff", "poyu-quan");
        map_skill("blade", "fanliangyi-dao");
        map_skill("strike", "hunyuan-zhang");
        map_skill("dodge", "huashan-shenfa");
        map_skill("parry", "huashan-jianfa");
        map_skill("sword", "dugu-jiujian");


        prepare_skill("strike", "hunyuan-zhang");
        prepare_skill("cuff", "poyu-quan");

        create_family("獨孤山莊", 1, "大廚師");
        
        set("inquiry", ([
                "給我吉斯粥" : (: ask_me :),
                "吉斯粥" : "這是我參考俠客島臘八粥重新做過的吉斯粥，只是效力沒那麼強。\n",
                "千年烤雞腿" : "你有傳說中的千年烤雞腿嗎？\n",
        ]));

        set("book_count", 1);
        
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.po2" :),
                (: perform_action, "sword.po3" :),
                (: perform_action, "sword.po4" :),
                (: perform_action, "sword.po5" :),
                (: perform_action, "sword.po6" :),
                (: perform_action, "sword.po7" :),
                (: perform_action, "sword.po8" :),
                (: perform_action, "sword.po9" :),
                (: perform_action, "parry.hu1" :),
                (: perform_action, "parry.hu2" :),
                (: perform_action, "strike.hu1" :),
                (: perform_action, "cuff.po1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        setup();

        carry_object("/d/dugu/obj/chess_cloth")->wear();
        carry_object("/d/dugu/obj/changjian")->wield();
}


void init()

{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}



void attempt_apprentice(object ob)
{
        if ((int)ob->query("shen") < 300000) {
                command("say 我獨孤山莊乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }

        if ((int)ob->query_str() < 30) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的臂力似乎不適合學我獨孤山莊的武功？");
                return;
        }

        command("say 好吧，我就收下你了。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "swordsman")
                ob->set("class", "swordsman");
        return;
}

string ask_me()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "獨孤山莊")
                return RANK_D->query_respect(this_player()) + 
                "與本派素無來往，不知此話從何談起？";
        if (query("book_count") < 1)
                return "你來晚了，吉斯粥一天只有一碗。";
        add("book_count", -1);
        ob = new(__DIR__"chess_zhou");
        ob->move(this_player());
        return "好吧，這碗吉斯粥你就拿去吃吧！";
}
