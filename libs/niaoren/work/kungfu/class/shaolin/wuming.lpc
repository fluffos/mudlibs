// wuming-laoseng
// by godzilla 99.03.06
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
        set_name("無名老僧", ( {"wuming seng","wuming","seng"} ) );
        set("long","他就是少林無名老僧，看起來已經是風燭殘年。而且雙腿殘廢。 \n" );
        create_family("少林派",2, "弟子");
        set("attitude", "peaceful");
        set("age", 95);
        set("gender", "男性");
        set("shen_type", 1);
        set("no_drop",1);
	set("chat_msg", ({
           CYN"無名僧人言到：“老納自創之少林無影劍，舉世無雙。”\n"NOR,
           CYN "無名僧人言到：“老納一身只敗在獨孤九劍之下，于是鑽研20年終創出無敵的少林無影劍。”\n"NOR,
	}));
        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("str", 30);
	set("per", 15);
	set("ker", 10);
        set("max_jing", 1000);
        set("max_neili", 15000);
        set("max_qi", 10000);
        set("jing",1000);
        set("neili",50000);
        set("qi",10000);
        set("jiali", 300);
        set("shen", -100000);
        set("combat_exp", 2500000);
        set_skill("buddhism",400); 
        set_skill("dodge", 400);
        set_skill("force", 400);
        set_skill("literate",400);
        set_skill("parry", 400);
        set_skill("sword", 400);
        set_skill("finger", 400);
	set_skill("wuying-jian", 400);
        set_skill("hunyuan-yiqi", 400);
        set_skill("shaolin-shenfa", 400);
        set_skill("club",400);
        set_skill("claw",400);
        set_skill("yizhi-chan",400);
        set_skill("staff",400);   
        
	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "wuying-jian");
	map_skill("sword", "wuying-jian");
        map_skill("finger", "yizhi-chan");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "finger.yi1" :),
                (: perform_action, "finger.yi2" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
        }) );

        setup();
        carry_object("/clone/cloth/seng-cloth")->wear();

}
void attempt_apprentice(object who)
{      
       mapping who_fam;
       string name, new_name;
       name = who->query("name");
           if ((int)who->query("bai_wuming") == 1 ){
	        command("say 我不會再收你為徒了，你還是走吧！\n");
                return;
	}
          if (!(who_fam = who->query("family")) || who_fam["family_name"] != "少林派")
	{
		command("say " + RANK_D->query_respect(who) + "與本派素無來往，不知此話從何談起？");
		return;
	}
           if ((int)who->query_skill("buddhism", 1) < 200) {
		command("say 悟禪之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在禪宗心法方面，" + RANK_D->query_respect(who) +
			"是否還做得不夠？");
		return;
	} 
            if ((int)who->query_skill("parry", 1) < 200) {
		command("say 在基本功方面，" + RANK_D->query_respect(who) +
			"是否還做得不夠？");
		return;
	}
             if ((int)who->query_skill("literate",1) < 200) {
		command("say 萬事都講一個緣字。");
		command("say " + RANK_D->query_respect(who) + "與佛無緣，還是請回吧。");
		return;
	}    
              if ((int)who->query_skill("hunyuan-yiqi", 1) < 200) {
		command("say 我少林派乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(who) + 
			"是否還應該在內功上多下點功夫？");
		return;
	}
if ((int)who->query_skill("force", 1) < 200) {
		command("say 在內功方面，" + RANK_D->query_respect(who) +
			"是否還做得不夠？");
		return;
	}
        
        if (who->query("family/generation") == 36){
	        command("chat 想不到老納在垂死之年，又覓得一個可塑之才，好！老衲就將畢生\n""的武學都傳受于你！\n");
	        command("recruit " + who->query("id"));
            
                who->set("title", HIY"少林派之世外高僧"NOR);
                name = who->query("name");
		new_name = "渡" + name[2..3];
		who->set("name", new_name); 
                who->set("bai_wuming", 1); 
                command("say 從今以后你的法名叫做" + new_name + "，恭喜你榮升為少林派渡字輩弟子 !");
                command("recruit " + who->query("id")); 
		
                return;
	}
}
