// zhangcui.c

inherit NPC;
inherit F_MASTER;

void create()
{
set_name("張翠山", ({ "zhang cuishan", "zhang" }));  
set("nickname","武當五俠");
	set("long", 
		"他就是張三丰的五弟子、武當七俠之中的張翠山。\n"
		"身穿一件干干淨淨的白色道袍。\n");
	set("gender", "男性");
        set("age",31);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 28);
	set("int", 35);
	set("con", 28);
	set("dex", 28);
	set("max_qi", 3000);
	set("max_jing", 3000);
	set("neili", 1500);
	set("max_neili", 4500);
	set("jiali", 150);
	set("combat_exp", 1500000);
	set("score", 600000);

	set_skill("force", 200);
	set_skill("taiji-shengong", 200);
	set_skill("dodge", 180);
	set_skill("tiyunzong", 180);
	set_skill("unarmed", 200);
	set_skill("taiji-quan", 200);
	set_skill("parry", 200);
	set_skill("sword", 200);
	set_skill("taiji-jian", 200);
	set_skill("taoism", 200);
	set_skill("literate", 200);

	map_skill("force", "taiji-shengong");
	map_skill("dodge", "tiyunzong");
	map_skill("unarmed", "taiji-quan");
	map_skill("parry", "taiji-quan");
	map_skill("sword", "taiji-jian");

	create_family("武當派", 2, "弟子");
	setup();

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/d/wudang/obj/whiterobe")->wear();

}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 10000 )
	 {
		command("say 我武當乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	 }
	if ((int)ob->query_skill("taiji-shengong",1) < 60 ||
		(int)ob->query_skill("force",1) < 60 )
	{
		command("say 我武當派最注重內功心法"+RANK_D->query_respect(ob)+
			"是否應該在內功上多下點功夫啊?");
		return;
	}
	command("say 好吧，我就收下你了。");
	command("say 希望你能好好用功,發揚我武當精神!");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "taoist")
		ob->set("class", "taoist");
}
