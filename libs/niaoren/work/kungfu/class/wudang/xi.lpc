// xi.c 張松溪

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("張松溪", ({ "zhang songxi", "zhang" }));
	set("nickname", "武當四俠");
	set("long", 
		"他就是張三丰的四弟子張松溪。\n"
		"他今年四十歲，精明能干，以足智多謀著稱。\n");
	set("gender", "男性");
	set("age", 40);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 26);
	set("int", 30);
	set("con", 26);
	set("dex", 28);
	
	set("max_qi", 3500);
	set("max_jing", 1800);
	set("neili", 4700);
	set("max_neili", 4700);
	set("jiali", 120);
	set("combat_exp", 1500000);
	set("score", 500000);

	set_skill("force", 180);
	set_skill("taiji-shengong", 180);
	set_skill("dodge", 150);
	set_skill("tiyunzong", 150);
	set_skill("unarmed", 170);
	set_skill("taiji-quan", 170);
	set_skill("parry", 180);
	set_skill("sword", 160);
	set_skill("taiji-jian", 160);
	set_skill("taoism", 120);
	set_skill("literate", 100);

	map_skill("force", "taiji-shengong");
	map_skill("dodge", "tiyunzong");
	map_skill("unarmed", "taiji-quan");
	map_skill("parry", "taiji-jian");
	map_skill("sword", "taiji-jian");

	create_family("武當派", 2, "弟子");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/d/wudang/obj/whiterobe")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 10000 )
	 {
		command("say 我武當乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	 }
	if ((int)ob->query_skill("taiji-shengong",1) < 60 ||
		(int)ob->query_skill("force",1) < 60 )
	{
		command("say 我武當派最注重內功心法"+RANK_D->query_respect(ob)+
			"是否應該在內功上多下點功夫啊?");
		return;
	}
	
	command("say 好吧，我就收下你了。");
	command("say 希望你能好好用功,發揚我武當精神!");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "taoist")
		ob->set("class", "taoist");
}
