// zhike.c 知客

inherit NPC;
#include <ansi.h>

void create()
{
        set_name("知客道長", ({ "zhike daozhang", "zhike" }));
        set("long",
                "他是武當山的知客道長。\n");
        set("gender", "男性");
        set("age", 30);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("class", "taoist");

        set("str", 20);
        set("int", 20);
        set("con", 25);
        set("dex", 20);

        set("max_qi", 300);
        set("max_jing", 200);
        set("neili", 300);
        set("max_neili", 300);

        set("combat_exp", 5000);
        set("score", 1000);

        set_skill("force", 60);
        set_skill("dodge", 60);
        set_skill("unarmed", 60);
        set_skill("parry", 60);
        set_skill("sword", 60);
        set_skill("taiji-jian", 60);
        set_skill("taiji-shengong", 60);
        set_skill("tiyunzong", 60);
        set_skill("taoism", 60);

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );
        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        create_family("武當派", 3, "弟子");
        set("chat_chance",2);
        set("chat_msg", ({
            "知客道長說道：我武當地靈人杰，香火鼎盛，普天下的人都來朝拜敬香。\n",
            "知客道長說道：玄岳門乃武當出入門戶，我等一定要精心守衛(guard)，不可絲毫懈殆。\n"
        }));

        setup();
        carry_object("/clone/cloth/dao-cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob=this_player()) && !is_fighting() )
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_volunteer","volunteer");
        add_action("do_volunteer","guard");
}

void greeting(object ob)
{
        mapping myfam;

        myfam = (mapping)ob->query("family");
        if(!myfam || myfam["family_name"] != "武當派")
              say ("知客道長笑咪咪地說：這位"+RANK_D->query_respect(ob) + "，歡迎到武當來，進來喝杯茶，歇歇腿吧。\n");
        else
              say ("知客道長笑咪咪地說：這位"+RANK_D->query_respect(ob) + "，一路辛苦了。\n");
        return;
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query("guard", 1) < 10) {
                command("say " + RANK_D->query_respect(ob) +
                        "你對我武當派盡了多少心力，有几分忠心呢？");
                return;
        }
        if ((int)ob->query("shen") < 0) {
                command("say 我武當乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        command("say 好吧，貧道就收下你了。");
        command("recruit " + ob->query("id"));
}

int do_volunteer()
{
        object me=this_player();
        object* ob;
        int i;

        if (me->query_temp("in_guard")) 
           return notify_fail("知客道長對你說：你專心守好山門，別想打兩份工。\n");
        ob = users();
        for (i=sizeof(ob); i>0; i--)
        {
                if (ob[i-1]->query_temp("in_guard"))
                return notify_fail("知客道長對你說：已經有人守山門了，你一會再來吧。\n");
        }
        tell_room(environment(me),me->query("name")+"開始在武當山門值守。\n");
	me->set("old_degree",me->query("degree"));
	me->set("degree", HIG"山門守衛"NOR);
        me->set_temp("in_guard","1"); 
        me->save();
        remove_call_out("end_guard");
        call_out("end_guard", 150, me);
        remove_call_out("clone_meng");
        call_out("clone_meng", 30, me);
        return 1;
}
void clone_meng(object me)
{
        object ob;
        tell_room(environment(me),"山下突然沖上來一伙蒙面大漢。\n");
        ob=new("/d/wudang/npc/mengmian.c");
        ob->move(environment(me));
        call_out("clone_meng", 100, me);
}
void end_guard(object me)
{
        me->set("degree",me->query("old_degree"));
        me->add("guarded",1);
        me->delete_temp("in_guard"); 
        me->save();
        remove_call_out("clone_meng");
        tell_room(environment(me),me->query("name")+"在武當山門值守期已滿。\n");
//        tell_object(me,"你在武當山門值守期已滿。\n");
}
