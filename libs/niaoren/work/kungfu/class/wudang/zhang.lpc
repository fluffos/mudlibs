// zhang.c 張三丰

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
        set_name("張三丰", ({ "zhang sanfeng", "zhang" }));
        set("nickname", HIG "邋遢真人" NOR);
        set("long", 
                "他就是武當派開山鼻祖、當今武林的泰山北斗張三丰真人。\n"
                "身穿一件污穢的灰色道袍，不修邊幅。\n"
                "身材高大，年滿百歲，滿臉紅光，須眉皆白。\n");
        set("gender", "男性");
        set("age", 100);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 40);
        set("int", 40);
        set("con", 40);
        set("dex", 40);
        
        set("max_qi", 15000);
        set("max_jing", 8000);
        set("neili", 20000);
        set("max_neili", 20000);
        set("jiali", 300);
        set("combat_exp", 7000000);
        set("score", 1200000);

        set_skill("force", 400);
        set_skill("taiji-shengong", 400);
        set_skill("dodge", 300);
        set_skill("tiyunzong", 300);
        set_skill("unarmed", 350);
        set_skill("taiji-quan", 350);
        set_skill("jawutaiji-jian", 400);
        set_skill("parry", 400);
        set_skill("sword", 350);
        set_skill("taiji-jian", 350);
        set_skill("blade", 350);
        set_skill("taiji-dao", 350);
        set_skill("taoism", 500);
        set_skill("literate", 500);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "taiji-dao");

        create_family("武當派", 1, "開山祖師");
        set("class", "taoist");

        set("inquiry", ([
                "秘籍" : (: ask_me :),
        ]));

        set("book_count", 1);

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: command, "enable sword jawutaiji-jian" :),
                (: command, "enable sword taiji-jian" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("taiji-shengong", 1) < 100) {
                command("say 我武當派乃內家武功，最重視內功心法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在太極神功上多下點功夫？");
                return;
        }
        if ((int)ob->query("shen") < 100000) {
                command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        if (ob->query_int() < 30) {
                command("say 我武當派武功全從道藏悟出。");
                command("say 要能達到爐火純青之境，體質什么的倒是無關緊要，悟性卻是半點也馬虎不得。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("chat 哈哈哈哈！！！！");
        command("chat 想不到老道在垂死之年，又覓得一個可塑之才，真是可喜可賀。");
        command("recruit " + ob->query("id"));
}

string ask_me()
{
        mapping fam; 
        object ob;

        if (!(fam = this_player()->query("family")) 
            || fam["family_name"] != "武當派")
                return RANK_D->query_respect(this_player()) + 
                "與本派素無來往，不知此話從何談起？";
        if (query("book_count") < 1)
                return "你來晚了，本派的道德真經不在此處。";
        add("book_count", -1);
        ob = new("/clone/book/laozi");
        ob->move(this_player());
        return "好吧，這本「道德經-總訣篇」你拿回去好好鑽研。";
}

