// mo.c 莫聲谷

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("莫聲谷", ({ "mo shenggu", "mo" }));
	set("nickname", "武當七俠");
	set("long", 
		"他就是張三丰的七弟子莫聲谷。\n"
		"他看起來二十多歲，顯得稚氣未脫。\n"
		"但也是江湖中行俠仗義，聲明遠播的俠客。\n");
	set("gender", "男性");
	set("age", 40);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 26);
	set("int", 30);
	set("con", 26);
	set("dex", 27);
	
	set("max_qi", 2500);
	set("max_jing", 1800);
	set("neili", 3500);
	set("max_neili", 3500);
	set("jiali", 100);
	set("combat_exp", 1000000);
	set("score", 300000);

	set_skill("force", 170);
	set_skill("taiji-shengong", 170);
	set_skill("dodge", 180);
	set_skill("tiyunzong", 180);
	set_skill("unarmed", 140);
	set_skill("taiji-quan", 140);
	set_skill("parry", 130);
	set_skill("sword", 130);
	set_skill("taiji-jian", 130);
	set_skill("taoism", 100);
	set_skill("literate", 100);

	map_skill("force", "taiji-shengong");
	map_skill("dodge", "tiyunzong");
	map_skill("unarmed", "taiji-quan");
	map_skill("parry", "taiji-jian");
	map_skill("sword", "taiji-jian");

	create_family("武當派", 2, "弟子");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/d/wudang/obj/whiterobe")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 10000 )
	 {
		command("say 我武當乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	 }
	if ((int)ob->query_skill("taiji-shengong",1) < 60 ||
		(int)ob->query_skill("force",1) < 60 )
	{
		command("say 我武當派最注重內功心法"+RANK_D->query_respect(ob)+
			"是否應該在內功上多下點功夫啊?");
		return;
	}
	if ((int)ob->query_skill("sword") < 60)
	{
		command("say 我派太極劍精奧博大,要學好他,需得打好基本功,我看你還是不夠用功"); 
		return;
	}
	command("say 好吧，我就收下你了。");
	command("say 希望你能好好用功,發揚我武當精神!");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "taoist")
		ob->set("class", "taoist");
}
