inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("岳不群", ({ "yue buqun", "master", "yue" }) );
        set("title", "華山派現任掌門");
        set("nickname", "君子劍");        
	set("gender", "男性");
        set("age", 47);
        set("long",
 "他就是華山派的現任掌門人，江湖上人稱“君子劍”的岳不群。他看上去\n"
 "是個和善的中年人，對人總是彬彬有禮，很有一代宗師的風范。\n" );
        set("inquiry", ([
                "紫霞秘籍": "對不起，你來晚了，紫霞秘籍并不在我這里。\n",
                "手令": "手令，你想進我的書房偷東西嗎，抓賊啊。"
]) );        
	set("attitude", "peaceful");
        set("str", 28);
        set("int", 28);
        set("spi", 25);
        set("per", 28);
        set("cps", 30);
        set("force", 4500);
        set("max_force", 4500);
        set("force_factor",75);
        set("rank_info/respect", "岳掌門");        
        set("combat_exp",1950000);
        set("score",150000);
        set_skill("unarmed", 130);
        set_skill("sword", 130);
        set_skill("force", 130);
        set_skill("blade", 130);
        set_skill("parry", 130);
        set_skill("dodge", 130);
        set_skill("literate", 150);
	set_skill("huashan-jianfa",130);
	set_skill("huashan-zhangfa", 130);
	set_skill("zixia-shengong", 130);
	set_skill("huashan-shenfa", 130);

        map_skill("dodge", "huashan-steps");
        map_skill("unarmed", "huashan-zhangfa");
        map_skill("force", "zixia-shengong");
        map_skill("sword", "huashan-jianfa");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
		(: perform_action, "sword.hu1" :),
		(: perform_action, "sword.hu2" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        create_family("華山派", 13, "掌門人");
        setup();
        catch(carry_object("/d/huashan/obj/bishuijian")->wield()); /* target missing from archive -- guarded */
        carry_object("/clone/cloth/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        if( (string)ob->query("gender") != "男性" )
                command("say 我不收女弟子的，姑娘還是另訪名師吧。");
        else {
                command("nod");
                command("say " + RANK_D->query_respect(ob) + "日后必成大器 ！\n");                command("recruit " + ob->query("id") );
             }
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "huashan");
}
