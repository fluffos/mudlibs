//mu.c
#include <ansi.h>
inherit NPC;
int ask_zhou();

void create()
{
        set_name("木島主", ( { "mu daozhu", "mu" }) );
        set("title", HIB"俠客島島主"NOR);
        set("gender", "男性" );
        set("age", 60);
        set("long","這是個看起來五十來歲的漢子，面眉全白，臉傍消瘦，著一襲白袍，昂然挺立。\n");

        set("int", 30);
        set("str", 25);
        set("con", 30);
        set("dex", 25);

        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 100);
        set("qi",10000);
        set("max_qi", 10000);
        set("jing", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 150);
        set("combat_exp", 5000000);
        set("score", 250000);

        set_skill("force", 180);
        set_skill("taiji-shengong", 150);
        set_skill("dodge", 120);
        set_skill("tiyunzong", 100);
        set_skill("unarmed", 180);
        set_skill("taiji-quan", 150);
        set_skill("parry", 160);
        set_skill("sword", 200);
        set_skill("taiji-jian", 150);
        set_skill("taoism", 200);
        set_skill("literate", 100);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );

        set("chat_chance", 3);
        set("chat_msg", ({
            "木島主忽然一怕腦袋，說：臘八粥可是好東西哇！\n",
            "木島主說道：怎么\這么\多的英雄也不能領悟太玄經呢。\n",
        }) );
        set("inquiry", ([
            "臘八粥" : (: ask_zhou :),
            "俠客島" :  "\n這個島是我和龍兄弟無意中發現的。\n",
        ]));
        create_family("俠客島", 1, "島主");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold",5);
}

int ask_zhou()
{
        say("\n木島主對你說：這是本島特有的東西，它主要由一味'斷腸獨骨腐心草'構成，\n"
"要開花后效力方著，但這種草每十年才開一次花，所以臘八粥很名貴，\n"
"一般人很難得到的,小兄弟想要就要看你的緣分了！\n");
        return 1;
}

int accept_object(object who, object ob)
{
        object obn;

        if ( !present(ob, who) )
                return notify_fail("你沒有這件東西。\n");

        if (  ob->query("id") != "ling pai" && ob->query("id") != "fuxin cao")
                return notify_fail("木島主搖頭道：這不是我想要的呀！\n");

        if ( ob->query("id") == "ling pai" )
        {
                if (random((int)who->query("kar")) <=25 )
                        return notify_fail("木島主搖頭道：我看小兄弟今生于此無緣。\n");
                else
                {
                        remove_call_out("destroy");
                        call_out("destroy", 1, who, ob);

                        if(query_temp("cao"))
                        {
                                message_vision("\n木島主見是賞善罰惡令，大喜道：恭喜這位小兄弟了!\n",who);
                                obn=new("/d/xiakedao/obj/zhou");
                                obn->move(who);
                                delete_temp("lingpai");
                                delete_temp("cao");
                                return 1;
                        }
                        else if(query_temp("lingpai"))
                        {
                                message_vision("\n木島主見是賞善罰惡令，對$N搖頭道：賞善罰惡令我有了。\n",who);
                                return 0;
                        }
                        else
                        {
                                message("vision","木島主看見賞善罰惡令，大喜道：現在只差腐心草了。\n",environment(who));
                                set_temp("lingpai",1);
                                return 1;
                        }
                }
        }
        if ( ob->query("id") == "fuxin cao")
        {
                if (random((int)who->query("kar")) <=25 )
                        return notify_fail("木島主搖頭道：我看小兄弟今生與此無緣。\n");
                else
                {
                        remove_call_out("destroy");
                        call_out("destroy", 1, who, ob);

                        if(query_temp("lingpai"))
                        {
                                message_vision("\n木島主見是腐心草，大喜道：恭喜這位小兄弟了!\n",who);
                                obn=new("/d/xiakedao/obj/zhou");
                                obn->move(who);
                                delete_temp("cao");
                                delete_temp("lingpai");
                                return 1;
                        }
                        else if(query_temp("cao"))
                        {
                                message_vision("\n木島主見是腐心草，對$N搖頭道：腐心草我已經有了。\n",who);
                                return 0;
                        }
                        else
                        {
                                message("vision","木島主看見腐心草，大喜道：現在只差玄冰碧火酒了。\n",environment(who));
                                set_temp("cao",1);
                                return 1;
                        }
                }
        }
        return 1;
}

int recognize_apprentice(object ob)
{

        message_vision("$N搖了搖頭。\n",this_object());
        command("tell "+ob->query("id")+"我是不收弟子的，你可以到石室中自學哇！\n");
        return 0;
}

int do_skills(string arg)
{
        object ob ;
        ob = this_player () ;
        if( !arg || arg!="long" )
                return 0;
        if(wizardp(ob))
                return 0;
        if (ob->query("weiwang") <50 )
        {
                message_vision("$N搖了搖頭。\n",this_object());
                write("木島主說道：你怎么\能看我的武功\呢？\n");
                return 1;
        }
        command("tell "+ob->query("id")+" 我所有的武功\如下：\n"+
"  基本輕功\ (dodge)                         - 一代宗師  100/    \n"+
"  基本內功\ (force)                         - 一代宗師  100/    \n"+
"  讀書寫字 (literate)                      - 一代宗師  100/    \n"+
"  基本招架 (parry)                         - 一代宗師  100/    \n"+
"  基本劍法 (sword)                         - 一代宗師  100/    \n"+
"□太極劍法 (taiji-jian)                    - 深不可測  200/    \n"+
"□太極拳 (taiji-quan)                      - 登峰造極  150/    \n"+
"□太極神功\ (taiji-shengong)                - 登峰造極  150/    \n"+
"  道學心法 (taoism)                        - 深不可測  200/    \n"+
"□梯云縱 (tiyunzong)                       - 登峰造極  100/    \n"+
"  基本拳腳 (unarmed)                       - 一代宗師  100/    \n");
        return 1;
}
