#include <ansi.h>

inherit NPC;

string ask_me_1(string name);
string ask_me_2(string name);
void create()
{
	set_name("裘婆婆", ({ "qiu popo", "qiu", "popo" }));
	set("long",
	    "她是"+HIC"「靈鷲宮」"NOR+"九天九部中赤天部的首領.\n"+
	    "她跟隨童姥多年, 出生入死,飽經風霜.\n");
	set("title", HIC"赤天部首領"NOR);
	set("gender", "女性");
	set("age", 60);
	set("shen_type",0);
	set("attitude", "peaceful");

	set("per", 23);
	set("class", "scholar");
	set("str", 20);
	set("int", 25);
	set("con", 30);
	set("dex", 30);

	set("qi", 1300);
	set("max_qi", 1300);
	set("jing", 500);
	set("max_jing", 500);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 80);

	set("combat_exp", 700000);
	set_skill("force", 100);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("hand",100);
	set_skill("strike", 100);
        set_skill("sword",100);

	set_skill("zhemei-shou",80);
	set_skill("liuyang-zhang",80);
	set_skill("yueying-wubu",80);
        set_skill("bahuang-gong", 70);

	map_skill("force", "bahuang-gong");
	map_skill("strike","liuyang-zhang");
	map_skill("dodge", "yueying-wubu");
	map_skill("unarmed", "liuyang-zhang");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "liuyang-zhang");
   	map_skill("sword", "tianyu-qijian");

        set("inquiry", ([
		"療傷" : (: ask_me_1, "towel" :),
		"毛巾" : (: ask_me_1, "towel" :),
		"鹿皮酒袋" : (: ask_me_2, "lpjiudai" :),
		"白云熊膽丸" : (: ask_me_2, "baiyunwan" :),
        ]));
	set("yaopin_count_1", 5);
	set("yaopin_count_2", 1);

	prepare_skill("strike","liuyang-zhang");
	prepare_skill("hand","zhemei-shou");
	create_family("靈鷲宮",4,"弟子");
	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: command("unwield jian") :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "hand.zh1" :),
		(: perform_action, "hand.zh1" :),
		(: command("wield jian") :),
		(: perform_action, "sword.ti1" :),
		(: perform_action, "sword.ti1" :),
		(: exert_function, "re1" :),
		(: exert_function, "p" :),
            }) );
	setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/lingjiu/obj/qingyi")->wear();
        carry_object("/d/lingjiu/obj/doupeng")->wear();
        carry_object("/clone/food/jiudai");
        add_money("silver",25);
}
string ask_me_1(string name)
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "靈鷲宮")
		return RANK_D->query_respect(this_player()) + 
		"與本派素無來往，不知此話從何談起？";

	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你怎麼又來要了？ 真是貪得無饜！";

	if (query("yaopin_count_1") < 1)
		return "抱歉，你來得不是時候。";

	ob = new("/d/lingjiu/obj/" + name);
	ob->move(this_player());

	add("yaopin_count_1", -1);

	message_vision("裘婆婆給$N一條" + ob->query("name") + "。\n", this_player());

	return "拿去吧。趕快到灤鳳閣沐浴療傷。";
}
string ask_me_2(string name)
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "靈鷲宮")
		return RANK_D->query_respect(this_player()) + 
		"與本派素無來往，不知此話從何談起？";

	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你現在身上不是有嗎，怎麼又來要了？ 真是貪得無饜！";

	if (query("yaopin_count_2") < 1)
		return "抱歉，你來得不是時候。";

	ob = new("/d/lingjiu/obj/" + name);
	ob->move(this_player());

	add("yaopin_count_2", -1);

	message_vision("裘婆婆給$N一顆" + ob->query("name") + "。\n", this_player());

	return "拿去吧。好好練功，保衛靈鷲宮。";
}
void init()
{
	object me, ob;
	mapping fam;

	::init();
	ob = this_player();
	me = this_object();
	
	if (interactive(ob) 
	&& !environment(ob)->query("no_fight")
	&& ((fam = ob->query("family")) && fam["family_name"] != "靈鷲宮" ))
	{
		if( !ob->query_temp("warned") ) {
		command("say 尊主有令：外人不得進入靈鷲宮，速速離開！");
			ob->set_temp("warned", 1);
	}
		else if( ob->query_temp("stay")<5 ) ob->add_temp("stay",1);
		else {
			command("say 大膽狂徒，竟敢擅闖靈鷲宮！！！\n");
			remove_call_out("kill_ob");
			call_out("kill_ob", 1, ob); 
		}
	}
}
void attempt_apprentice(object ob)
{
   if ((string)ob->query("gender")=="女性")
   {
		message_vision("裘婆婆垂目沉思片刻, 說道：“好吧, 我就收下你了。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "dancer")
			ob->set("class", "dancer");
       return;}
   else
      {
		message_vision("裘婆婆瞪著你看了半天,說道：“本宮只收女弟子！”\n",ob);
       return;}
}
