// /NPC xuzhu.c
// By adx @ CuteRabbit 22:21 99-3-19

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me(string name);
void create()
{
	set_name("虛竹", ({ "xu zhu", "xu", "zhu" }));
	set("long",
	    "這是一個二十五六歲的年輕人, 濃眉大眼,\n"+
	    "大大的鼻子扁平下塌, 容貌頗為丑陋. \n"+
	    "身穿一件華貴雅致的長袍, 倒使他更顯几分精神.\n"+
	    "他就是天山童姥的救命恩人.\n");
	set("title", HIC"靈鷲宮尊主"NOR);
	set("gender", "男性");
	set("per", 16);
	set("age", 26);
	set("nickname", HIR "夢郎" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

	set("str", 30);
	set("int", 25);
	set("con", 40);
	set("dex", 30);

	set("max_qi", 6000);
	set("max_jing", 1200);
	set("neili", 8000);
	set("max_neili", 8000);
	set("jiali", 200);

	set("combat_exp", 2500000);
	set_skill("force", 250);
        set_skill("sword", 250);
	set_skill("unarmed", 280);
	set_skill("dodge", 250);
	set_skill("parry", 250);
	set_skill("hand",280);
	set_skill("strike", 280);

	set_skill("zhemei-shou",250);
	set_skill("liuyang-zhang",250);
	set_skill("yueying-wubu",200);
	set_skill("bahuang-gong", 250);
        set_skill("tianyu-qijian", 250);

	map_skill("force", "bahuang-gong");
	map_skill("strike","liuyang-zhang");
	map_skill("dodge", "yueying-wubu");
	map_skill("unarmed", "liuyang-zhang");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "liuyang-zhang");
        map_skill("sword", "tianyu-qijian");

        set("inquiry", ([
		"靈鷲令" : (: ask_me, "lingjiu" :),
		"進修" : (: ask_me, "lingjiu" :),
		"小院" : (: ask_me, "lingjiu" :),
        ]));
	set("ling_count", 1);

	prepare_skill("strike","liuyang-zhang");
	prepare_skill("hand","zhemei-shou");
	create_family("靈鷲宮",2,"尊主");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: command("unwield jian") :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "hand.zh1" :),
		(: perform_action, "hand.zh1" :),
		(: command("wield jian") :),
		(: perform_action, "sword.ti1" :),
		(: perform_action, "sword.ti1" :),
		(: exert_function, "re1" :),
		(: exert_function, "p" :),
            }) );
	setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/lingjiu/obj/qingyi")->wear();
        carry_object("/d/lingjiu/obj/doupeng")->wear();
        carry_object("/clone/food/jiudai");
        add_money("silver",50);
}
string ask_me(string name)
{
	mapping fam;
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "靈鷲宮")
		return RANK_D->query_respect(this_player()) +
		"與本派素無來往，不知此話從何談起？";

	if (query("ling_count") < 1)
		return "你來得不是時候，已經有人在練功了。";

	ob = new("/d/lingjiu/obj/" + name);
	ob->move(this_player());

	add("ling_count", -1);

	message_vision("虛竹給$N一個" + ob->query("name") + "。\n", this_player());

	return "拿去吧。";
}
void attempt_apprentice(object ob)
{
   if ((int)ob->query_skill("bahuang-gong", 1) < 149) 
           {
		command("say " + RANK_D->query_respect(ob) + "是否還應該多練練八荒六合唯我獨尊功？");
		return;
	   }  
   if ((string)ob->query("gender")=="女性")
   {
		message_vision("虛竹垂目沉思片刻, 說道：“好吧, 我就收下你了。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "officer")
			ob->set("class", "officer");
       return;}
   else
      {
		message_vision("虛竹瞪著你看了半天,說道：“閣下不會是想來搶我的生意吧?”\n",ob);
       return;}
}
