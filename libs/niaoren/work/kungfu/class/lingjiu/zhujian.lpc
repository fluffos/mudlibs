#include <ansi.h>

inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("竹劍", ({ "zhu jian", "zhu"}));
	set("long",
	    "這是個容貌姣好的女子, 瓜子臉蛋,\n"+
	    "眼如點漆, 清秀絕俗.\n"+
	    "你總覺得在哪見過她.\n");
	set("gender", "女性");
	set("per", 27);
	set("age", 18);
	set("shen_type",0);
	set("attitude", "peaceful");

	set("per", 31);
	set("class", "officer");
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("shen_type",1);

	set("qi", 1000);
	set("max_qi", 1000);
	set("jing", 500);
	set("max_jing", 500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 100);

	set("combat_exp", 1200000);
	set("score", 10000);
	set_skill("force", 150);
	set_skill("unarmed", 150);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("hand",200);
	set_skill("strike", 150);
	set_skill("sword",150);

	set_skill("zhemei-shou",150);
	set_skill("liuyang-zhang",150);
	set_skill("tianyu-qijian",150);
	set_skill("yueying-wubu",150);
	set_skill("bahuang-gong", 150);

	map_skill("force", "bahuang-gong");
	map_skill("strike","liuyang-zhang");
	map_skill("dodge", "yueying-wubu");
	map_skill("unarmed", "liuyang-zhang");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "liuyang-zhang");
	map_skill("sword", "tianyu-qijian");

	prepare_skill("strike","liuyang-zhang");
	prepare_skill("hand","zhemei-shou");
	create_family("靈鷲宮",3,"弟子");
	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: command("unwield jian") :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "hand.zh1" :),
		(: perform_action, "hand.zh1" :),
		(: command("wield jian") :),
		(: perform_action, "sword.ti1" :),
		(: perform_action, "sword.ti1" :),
		(: exert_function, "re1" :),
		(: exert_function, "p" :),
            }) );
	setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/lingjiu/obj/qingyi")->wear();
        carry_object("/d/lingjiu/obj/doupeng")->wear();
        carry_object("/clone/food/jiudai");
        add_money("silver",15);
}
void init()
{
	object me, ob;
	mapping fam;

	::init();
	ob = this_player();
	me = this_object();
	
	if (interactive(ob) 
	&& !environment(ob)->query("no_fight")
	&& ((fam = ob->query("family")) && fam["family_name"] != "靈鷲宮" ))
	{
		if( !ob->query_temp("warned") ) {
		command("say 尊主有令：外人不得進入靈鷲宮，速速離開！");
			ob->set_temp("warned", 1);
	}
		else if( ob->query_temp("stay")<5 ) ob->add_temp("stay",1);
		else {
			command("say 大膽狂徒，竟敢擅闖靈鷲宮！！！\n");
			remove_call_out("kill_ob");
			call_out("kill_ob", 1, ob); 
		}
	}
}
void attempt_apprentice(object ob)
{
   
	if ((string)ob->query("gender")!="女性")
           {
 		command("say 你找死啊!");
		return;
	   }
	if ((int)ob->query_skill("bahuang-gong", 1) < 50) 
           {
		command("say " + RANK_D->query_respect(ob) + "是否還應該多練練八荒六合唯我獨尊功？");
		return;
	   }
	if (ob->query_con() < 20) 
      	   {
		command("say 本門功法極為難練,你的根骨似乎不夠.");
		return;
	   }
		command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "scholar")
		ob->set("class", "scholar");
	return;
}
