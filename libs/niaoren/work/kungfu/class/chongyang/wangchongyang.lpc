// wangchongyang.c 王重陽

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
	set_name("王重陽", ({ "wang chongyang", "wang" }));
	set("nickname", HIW "中神通" NOR);
	set("long",
		"他就是全真教開山始祖“王重陽”，他几次起兵抗金，都敗了回來\n"+
		"后來，一怒之下出家做了黃冠道人，而辜負了林朝英女俠對他的一番深情厚誼。\n");
	set("gender", "男性");
	set("age", 75);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 30);
	set("int", 20);
	set("con", 20);
	set("dex", 30);
	
	set("inquiry", ([
        "石壁": "你如能幫我想出在石壁上寫字的方法我畢有重謝。 \n"]));
	
	set("max_qi", 10000);
	set("max_jing", 2800);
	set("neili", 12000);
	set("max_neili", 12000);
	set("jiali", 200);

	set("combat_exp", 6000000);
	set("score", 900000);	
	
	set_skill("force",450);
	set_skill("xiantian-gong",450);
	set_skill("literate",400);
	set_skill("sword",420);
	set_skill("quanzhen-jianfa",420);
	set_skill("unarmed",380);
	set_skill("dodge",370);
	set_skill("jinyan-gong",370);
	set_skill("taoism",400);
	set_skill("parry",360);
	set_skill("sanhuajuding",380);

	map_skill("force","xiantian-gong");
	map_skill("unarmed","sanhuajuding");
	map_skill("sword","quanzhen-jianfa");
	map_skill("dodge","jinyan-gong");
	map_skill("parry","quanzhen-jianfa");

	create_family("全真教", 1, "開山祖師");
	set("class", "taoist");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: command("wield jian") :),
		(: command("wield jian") :),
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: command("unwield jian") :),
                (: command("unwield jian") :),
                (: perform_action, "unarmed.sa1" :),
		(: perform_action, "unarmed.sa1" :),
                (: exert_function, "re1" :),
        }) );
	setup();
	catch(carry_object("/d/obj/greenrobe")->wear()); /* target missing from archive -- guarded */
	carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 500000) {
		command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("xiantian-gong", 1) < 270 ) {
		command("say 我全真教乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在先天神功上多下點功夫？");
		return;
	}
	if ((int)ob->query_skill("quanzhen-jianfa", 1) < 280) {
		command("say 我全真教以劍法為重，應該多注重劍法的修行。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在全真劍法上多下點功夫？");
		return;
	}
	command("chat 想不到呀，想不到我居然還能收的這樣的賢才，真是不旺此生。");
	command("say 以后可要加倍的努力了。");
	command("recruit " + ob->query("id"));
}
	
int accept_object(object who, object ob)
{
	object obn;

	if( !who || environment(who) != environment() ) return 0;
	if ( !objectp(ob) ) return 0;
	if ( !present(ob, who) ) return notify_fail("你沒有這件東西。\n");

	if (  (string)ob->query("name") != HIW"化石丹"NOR)
		    return notify_fail("你給我這東西可以在石頭上用手指寫字嗎？\n");
	if ( (string) ob->query("id") =="huashi dan" )
		{
		  message_vision(HIG"\n王重陽看到化石丹，微微一笑說道：“這玄門定陽丹乃是上好之丹藥不到萬不得已不要服用。\n"NOR,who);
		  obn=new("/d/chongyang/obj/xmdydan");
                  obn->move(who);
 	          return 1;		 
		}
}
