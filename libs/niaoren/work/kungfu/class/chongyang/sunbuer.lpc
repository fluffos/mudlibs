// sunbuer.c 孫不二
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
	set_name("孫不二", ({ "sun buer", "sun" }));
	set("nickname", HIC "清淨散人" NOR);
	set("long","他就是孫不二，是全真教中唯一的女子，因為機緣巧合，\n"+
		"王重陽才收了她。\n");
	set("gender", "女性");
	set("age", 50);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 18);
	set("int", 30);
	set("con", 20);
	set("dex", 30);
	
	set("max_qi", 45000);
	set("max_jing", 1300);
	set("neili", 6000);
	set("max_neili", 6000);
	set("jiali", 100);

	set("combat_exp", 3000000);
	set("score", 900000);	
	
	set_skill("force",280);
	set_skill("xiantian-gong",280);
	set_skill("literate",350);
	set_skill("sword",300);
	set_skill("quanzhen-jianfa",300);
	set_skill("unarmed",200);
	set_skill("dodge",320);
	set_skill("jinyan-gong",320);
	set_skill("taoism",350);
	set_skill("parry",280);
	set_skill("sanhuajuding",200);

	map_skill("force","xiantian-gong");
	map_skill("unarmed","sanhuajuding");
	map_skill("sword","quanzhen-jianfa");
	map_skill("dodge","jinyan-gong");
	map_skill("parry","quanzhen-jianfa");

	create_family("全真教", 2, "弟子");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: command("wield jian") :),
		(: command("wield jian") :),
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: command("unwield jian") :),
                (: command("unwield jian") :),
                (: perform_action, "unarmed.sa1" :),
		(: perform_action, "unarmed.sa1" :),
                (: exert_function, "re1" :),
        }) );

	setup();
	catch(carry_object("/d/obj/greenrobe")->wear()); /* target missing from archive -- guarded */
	carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 50000) {
		command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("xiantian-gong", 1) < 200 ) {
		command("say 我全真教乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在先天神功上多下點功夫？");
		return;
	}
	if ((int)ob->query_skill("quanzhen-jianfa", 1) < 200) {
		command("say 我全真教以劍法為重，應該多注重劍法的修行。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在全真劍法上多下點功夫？");
		return;
	}
	command("say 以后可要加倍的努力了。");
	command("recruit " + ob->query("id"));
}
