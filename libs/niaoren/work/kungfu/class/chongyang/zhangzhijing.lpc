// zhangzhijing.c 張志敬

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
	set_name(HIM"張志敬"NOR, ({ "zhang zhijing", "zhang" }));
	set("long",
		"他是一名全真教三代弟子.\n");
	set("gender", "男性");
	set("age", 40);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	
	set("max_qi", 2000);
	set("max_jing", 1800);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 50);

	set("combat_exp", 700000);
	set("score", 8500);	
	
	set_skill("force",200);
	set_skill("xiantian-gong",200);
	set_skill("literate",180);
	set_skill("sanhuajuding",150);
	set_skill("sword",190);
	set_skill("quanzhen-jianfa",190);
	set_skill("unarmed",150);
	set_skill("dodge",180);
	set_skill("jinyan-gong",180);
	set_skill("taoism",180);
	set_skill("parry",160);

	map_skill("force","xiantian-gong");
	map_skill("unarmed","sanhuajuding");
	map_skill("sword","quanzhen-jianfa");
	map_skill("dodge","jinyan-gong");
	map_skill("parry","quanzhen-jianfa");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: command("wield jian") :),
		(: command("wield jian") :),
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: command("unwield jian") :),
                (: command("unwield jian") :),
                (: perform_action, "unarmed.sa1" :),
		(: perform_action, "unarmed.sa1" :),
                (: exert_function, "re1" :),
        }) );

	create_family("全真教", 3, "弟子");
	set("class", "taoist");
	setup();
	carry_object("/clone/weapon/changjian")->wield();
	catch(carry_object("/d/obj/greenrobe")->wear()); /* target missing from archive -- guarded */

}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 5000) {
		command("say 我全真教乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("xiantian-gong", 1) < 100 ) {
		command("say 我全真教乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在先天神功上多下點功夫？");
		return;
	}
	if ((int)ob->query_skill("quanzhen-jianfa", 1) < 100) {
		command("say 我全真教以劍法為重，應該多注重劍法的修行。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在全真劍法上多下點功夫？");
		return;
	}
	command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
}

