// qiuchuji.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
	set_name("秋處機", ({ "qiu chuji", "qiu" }));
	set("nickname", HIC "長春子" NOR);
	set("long",
		"他就是大名鼎鼎的“長春子”秋處機，看上去是一個\n"
		"不怎么樣的糟老頭可是在江湖上他的名頭可是響當當的。\n");
	set("gender", "男性");
	set("age", 52);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 30);
	set("int", 20);
	set("con", 20);
	set("dex", 30);
	
	set("max_qi", 6000);
	set("max_jing", 1800);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 100);

	set("combat_exp", 4000000);
	set("score", 900000);	
	
	set_skill("force",300);
	set_skill("xiantian-gong",300);
	set_skill("literate",280);
	set_skill("sword",290);
	set_skill("quanzhen-jianfa",290);
	set_skill("unarmed",290);
	set_skill("dodge",280);
	set_skill("jinyan-gong",280);
	set_skill("taoism",280);
	set_skill("parry",260);
	set_skill("sanhuajuding",290);

	map_skill("force","xiantian-gong");
	map_skill("unarmed","sanhuajuding");
	map_skill("sword","quanzhen-jianfa");
	map_skill("dodge","jinyan-gong");
	map_skill("parry","quanzhen-jianfa");

	create_family("全真教", 2, "弟子");
	set("class", "taoist");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: command("wield jian") :),
		(: command("wield jian") :),
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: command("unwield jian") :),
                (: command("unwield jian") :),
                (: perform_action, "unarmed.sa1" :),
		(: perform_action, "unarmed.sa1" :),
                (: exert_function, "re1" :),
        }) );

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/d/wudang/obj/greenrobe")->wear();

}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 50000) {
		command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("xiantian-gong", 1) < 200 ) {
		command("say 我全真教乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在先天神功上多下點功夫？");
		return;
	}
	if ((int)ob->query_skill("quanzhen-jianfa", 1) < 200) {
		command("say 我全真教以劍法為重，應該多注重劍法的修行。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在全真劍法上多下點功夫？");
		return;
	}
	command("say 以后可要加倍的努力了。");
	command("recruit " + ob->query("id"));
}


