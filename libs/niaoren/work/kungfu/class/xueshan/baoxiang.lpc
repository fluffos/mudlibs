// /kungfu/class/xueshan/baoxiang.c  寶象
// by secret
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("寶象", ({ "bao xiang", "bao", "xiang" }));
        set("long",@LONG
一個極高極瘦的僧人，倆眼凶芒四射。此人在血刀老祖門下，最是心狠手辣。
LONG
        );
        set("title",HIR"血刀門第五代弟子"NOR);
        set("gender", "男性");
        set("age", 35);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 60);
        set("int", 60);
        set("con", 60);
        set("dex", 60);
        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 1200000);
        set("score", -120000);
        set("shen", -120000);

        set_skill("lamaism", 100);
        set_skill("literate", 100);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("blade", 100);
        set_skill("dodge", 100);
        set_skill("longxiang", 100);
        set_skill("shenkong-xing", 100);
        set_skill("hand", 100);
        set_skill("dashou-yin", 100);
        set_skill("xue-dao", 100);

        map_skill("force", "longxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("hand", "dashou-yin");
        map_skill("parry", "xue-dao");
        map_skill("blade", "xue-dao");

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "blade.xu1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );
        create_family("雪山寺", 5, "弟子");
        set("class", "bonze");
        setup();
        carry_object("/d/xueshan/obj/y-jiasha")->wear();
        carry_object("/clone/weapon/gangdao")->wield();
        add_money("gold",5);
}
void attempt_apprentice(object ob)
{
        if ((string)ob->query("gender") != "男性")
        {
                command("say 我不收女徒弟。\n");
                return;
        }
        if (ob->query("shen") > 0)
        {
                command("say 我正想找你們俠義道的晦氣。\n");
                this_object()->kill_ob(ob);
                return;
        }
        if ((int)ob->query_skill("longxiang", 1) < 50)
        {
                command("say 入我血刀門，修習龍象功法是首要的。\n");
                return;
        }
        command("hehe");
        command("recruit " + ob->query("id"));
        ob->set("title", HIR "血刀門第六代弟子" NOR);
}