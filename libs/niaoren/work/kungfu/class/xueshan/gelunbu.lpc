// /kungfu/class/xueshan/gelunbu.c  葛倫布
// by secret
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("葛倫布", ({ "gelunbu", "ge" }));
        set("long",@LONG
葛倫布是雪山寺中護寺僧兵的頭領。同時向本寺第子傳授武功。
身穿一件黑色袈裟，頭帶僧帽。
LONG
        );
        set("title", HIY "喇嘛" NOR);
        set("nickname", HIG "僧兵頭領" NOR);
        set("gender", "男性");
        set("age", 30);
        set("attitude", "heroism");
        set("shen_type", -1);
        set("str", 60);
        set("int", 60);
        set("con", 60);
        set("dex", 60);

        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 1000000);
        set("score", -100000);
        set("shen", -100000);

        set_skill("mizong-xinfa", 80);
        set_skill("literate", 80);
        set_skill("force", 80);
        set_skill("xiaowuxiang", 80);
        set_skill("dodge", 80);
        set_skill("shenkong-xing", 80);
        set_skill("parry", 80);
        set_skill("staff", 80);
        set_skill("xiangmo-chu", 80 );
        set_skill("hammer", 80);
        set_skill("riyue-lun", 70);
        set_skill("unarmed", 80);
        set_skill("yujiamu-quan", 80);

        map_skill("force", "xiaowuxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("parry", "xiangmo-chu");
        map_skill("staff", "xiangmo-chu");
        map_skill("hammer","riyue-lun");
        map_skill("unarmed","yujiamu-quan");

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );
        create_family("雪山寺", 5, "喇嘛");
        set("class", "bonze");
        setup();
        carry_object("/d/xueshan/obj/b-jiasha")->wear();
        carry_object("/d/xueshan/obj/sengmao")->wear();
        carry_object("/d/xueshan/obj/senggun")->wield();
        add_money("silver",30);
}
void attempt_apprentice(object ob)
{
        if ((string)ob->query("gender") != "男性") {
                command("say 修習密宗內功需要純陽之體。");
                command("say 這位" + RANK_D->query_respect(ob) +
                        "還是請回吧！");
                return;
        }
        command("say 我就傳你一些武功吧！");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "bonze")       {
                ob->set("title","俗家弟子");
        }
        else    {
                ob->set("title",HIY"小喇嘛"NOR);
        }
}