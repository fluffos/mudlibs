// /kungfu/class/xueshan/lingzhi.c  靈智上人
// by secret
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("靈智上人", ({ "lingzhi shangren", "shangren" }));
        set("long",@LONG
靈智上人是雪山寺中地位較高的喇嘛。
身穿一件青色袈裟，頭帶僧帽。
LONG
        );
        set("title",HIY "大喇嘛" NOR);
        set("gender", "男性");
        set("age", 40);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 80);
        set("int", 80);
        set("con", 80);
        set("dex", 80);
        set("max_qi", 4000);
        set("max_jing", 4000);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("combat_exp", 2500000);
        set("score", -2500000);
        set("shen", -2500000);

        set_skill("mizong-xinfa", 250);
        set_skill("literate", 250);
        set_skill("force", 250);
        set_skill("xiaowuxiang", 250);
        set_skill("dodge", 250);
        set_skill("shenkong-xing", 250);
        set_skill("parry", 250);
        set_skill("staff", 250);
        set_skill("xiangmo-chu", 250 );
        set_skill("hammer",250);
        set_skill("riyue-lun",250);
        set_skill("unarmed", 250);
        set_skill("yujiamu-quan", 250);

        map_skill("force", "xiaowuxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("unarmed", "yujiamu-quan");
        map_skill("parry", "yujiamu-quan");
        map_skill("staff", "xiangmo-chu");
        map_skill("hammer", "riyue-lun");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );
        create_family("雪山寺", 4, "大喇嘛");
        set("class", "bonze");
        setup();
        carry_object("/d/xueshan/obj/c-jiasha")->wear();
        carry_object("/d/xueshan/obj/sengmao")->wear();
        add_money("gold",50);
}
void attempt_apprentice(object ob)
{
        if ((string)ob->query("gender") != "男性") {
                command("say 修習密宗內功需要純陽之體。");
                command("say 這位" + RANK_D->query_respect(ob) +
                        "還是請回吧！");
                return;
        }
        if ((string)ob->query("class") != "bonze") {
                command("say 我佛門的清規戒律甚多。");
                command("say 這位" + RANK_D->query_respect(ob) +
                        "還是請回吧！");
                return;
        }
        if ((string)ob->query("family/family_name") != "雪山寺")        {
                command("say 這位" + RANK_D->query_respect(ob) +
                        "既非本寺弟子，還是請回吧！");
                return;
                  }
        if ((int)ob->query_skill("mizong-xinfa", 1) < 150) {
                command("say 入我雪山寺，修習密宗心法是首要的。");
                command("say 這位" + RANK_D->query_respect(ob) +
                        "是否還應該多多鑽研本門的心法？");
                return;
        }
        command("say 就傳你一些武功吧！");
        command("recruit " + ob->query("id"));
        ob->set("title",HIY "大喇嘛" NOR);
}