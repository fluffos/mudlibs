// tang wuqing.c 唐無情

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("唐無情", ({ "tang wuqing", "tang" }));
        set("nickname", HIW "鐵石心腸" NOR);
        set("long", 
                "他就是刑堂堂主唐無情，唐門刑法都有他執行。\n"
                "手段狠毒，殘酷無情，江湖上聽到他的名號都不寒而栗。\n"
                "他大約五十有余，面無表情，雙眼閃著冷光。\n");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 28);
        set("int", 30);
        set("con", 30);
        set("dex", 32);
        
        set("max_qi", 1000);
        set("max_jing", 3000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("combat_exp", 2000000);
        set("score", 100000);

        set_skill("force", 120);
        set_skill("biyun-xinfa",120);
        set_skill("dodge", 120);
        set_skill("qiulinshiye", 120);
        set_skill("strike", 120);
        set_skill("biye-wu", 120);
        set_skill("parry", 120);
        set_skill("unarmed",100);
        set_skill("throwing", 120);
        set_skill("liuxing-dao", 120);
        set_skill("literate", 100);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "liuxing-dao");
        map_skill("throwing", "liuxing-dao");
        
        create_family("唐門", 6 ,"刑堂堂主");
        set("class", "tangmen");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "strike.bi1" :),
                (: exert_function, "p" :),
		(: exert_function, "re1" :),
        }) );

        setup();
        carry_object("/clone/money/gangbiao")->wield();
        carry_object("/clone/cloth/male3-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("biyun-xinfa", 1) < 80) {
                command("say 唐門雖然以暗器為主，但還是要輔以內力。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在碧云心法上多下點功夫？");
                return;
        }
        if (ob->query_int() < 25) {
                command("say 唐門歷來注重弟子的文學修為。");
                command("say 本派功夫要能熟練運用，必須能體會其中所含深遠意境，悟性差了是不行的。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("say 唐門武學精深博大，你好好修習，將唐門發揚光大。");
        command("recruit " + ob->query("id"));
}
