// tang fang.c 唐方

#include <ansi.h>

inherit NPC;
string ask_me();
inherit F_MASTER;
inherit F_DEALER;
inherit F_UNIQUE;
void create()
{
        set_name("唐方", ({ "tang fang", "tang" }));
        set("long", 
                "她面容蒼白，神情憔悴，清麗的面龐仿佛還帶著\n"
                "淚痕。\n"
                "她大約二十有余。\n");
        set("gender", "女性");
        set("age", 20);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 20);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 800);
        set("max_jing", 2000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 60);
        set("combat_exp", 900000);
        set("score", 80000);

        set_skill("force", 100);
        set_skill("biyun-xinfa", 100);
        set_skill("dodge", 100);
        set_skill("qiulinshiye", 100);
        set_skill("strike", 80);
        set_skill("unarmed",80);
        set_skill("biye-wu", 80);
        set_skill("parry", 100);
        set_skill("throwing", 100);
        set_skill("sword",100);
        set_skill("wuzhan-mei", 100);
        set_skill("zhuihun-biao",100);
        set_skill("literate", 100);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/damage", 30);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "wuzhan-mei");
        map_skill("sword", "wuzhan-mei");
        map_skill("throwing","zhuihun-biao");
        
        create_family("唐門", 7, "弟子");
        set("class", "tangmen");

        
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: command("unwield gangbiao") :),
                (: command("wield changjian") :),
                (: command("wield changjian") :),
                (: perform_action, "sword.wu1" :),
                (: perform_action, "sword.wu2" :),
                (: perform_action, "strike.bi1" :),
                (: perform_action, "strike.bi1" :),
                (: exert_function, "p" :),
		(: exert_function, "re1" :),
                (: command("unwield jian") :),
        }) );
        set("chat_chance", 10);
        set("chat_msg", ({
                "唐方幽幽嘆口氣，輕輕按住琴弦，出神得看著遠方的湖面。\n",
                "唐方漫不經心地撥弄了几下琴弦，自言自語道：也不知道蕭郎現在是生是死....。\n",
                "唐方輕輕吹了一下渺渺升起的檀香，兩行清淚緩緩流下面頰。 \n",
        }) );
        set("inquiry", 
                ([
                        "蕭郎" : (: ask_me :)
                ]));


        setup();
        carry_object("/clone/cloth/female2-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
        carry_object("/clone/money/gangbiao")->wield();
        carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("biyun-xinfa", 1) < 100) {
                command("say 唐門雖然以暗器為主，但還是要輔以內力。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在碧云心法上多下點功夫？");
                return;
        }
        if ((int)ob->query_skill("dodge", 1) < 80) {
                command("say 我的功夫需要身法靈巧才可以隨意施展。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在輕功上多下點功夫？");
                return;
        }
        if (ob->query_int() < 30) {
                command("say 唐門歷來注重弟子的文學修為。");
                command("say 本派功夫要能熟練運用，必須能體會其中所含深遠意境，悟性差了是不行的。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("say 好吧，我就收下你吧...");
        command("recruit " + ob->query("id"));
}
string ask_me()
{object me;
me=this_player();
        if (me->query_temp("marks/蕭")){return "算了吧，看來你也不知道蕭郎的消息，你走吧。\n";}
        command("ah " + this_player()->query("id"));
        command("say 你知道蕭郎嗎！？自從他上次大鬧唐門后就失去了消息。\n");
        command("sigh");
        this_player()->set_temp("marks/蕭",1);
        return "老太太為這事非常生氣，再也不許我見他了。\n";
           

}
        
int accept_object(object who, object ob)
{
        object book;
        book = new("/d/tangmen/obj/throwbook");
        if ((string)ob->query("name")=="玉佩") {
              if(!query("yl_trigger")) {
                say(
"唐方說道：這不是蕭郎的玉佩嗎？太謝謝你了，雖然沒有見到蕭郎，\n"
"能見到他的信物,我已經很欣慰了。\n"
"唐方悠悠地嘆了一口氣：這里有一本暗器總訣，就算是給你的酬謝吧。\n"
"唐方把" + book->query("name") + "交給了" + who->query("name") + "。\n");
                book->move(who);
                set("yl_trigger", 1);
              }
           else say("唐方杏目圓睜，說道：你這個人怎么這樣討厭啊。\n");
        call_out("destroy", 1, ob);
        return 1;
        }
                return 0;
}
void destroy(object ob)
{
        destruct(ob);
        return;
}
