// XieXun.c
// pal 1997.05.09

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create()
{
    set_name("謝遜", ({"xie xun", "xie", "xun", }));
	set("long",
        "他是一位身材魁偉異常的的老者，身穿一件白布長袍。\n"
        "他滿頭黃發，威風凜凜，真如天神一般，只是兩只眼睛并不睜開。\n"
	);

	set("title",HIG "明教" HIY "金毛獅王" NOR);
    create_family("明教",35, "護法");
	set("level",9);
	set("gender", "男性");
	set("attitude", "peaceful");

	set("age", 63);
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("max_qi", 3500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 100);
	set("combat_exp", 900000);
	set("score", 800000);
    	set_skill("force", 160);
	set_skill("dodge", 140);
	set_skill("parry", 140);
	set_skill("cuff", 200);
	set_skill("hunyuan-yiqi", 160);
	set_skill("xiaoyao-bu", 140);
    	set_skill("qishang-quan", 200);
    	set_skill("jingang-quan", 150);
    	set_skill("literate", 100);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "xiaoyao-bu");
	map_skill("cuff", "qishang-quan");
    	map_skill("parry", "jingang-quan");

	prepare_skill("cuff","qishang-quan");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "cuff.qi1" :),
                (: perform_action, "cuff.qi2" :),
                (: perform_action, "cuff.qi3" :),
                (: perform_action, "cuff.qi4" :),
                (: perform_action, "cuff.qi5" :),
                (: perform_action, "cuff.qi6" :),
                (: perform_action, "cuff.qi7" :),
                (: perform_action, "cuff.qi8" :),
                (: perform_action, "parry.ji1" :),
                (: perform_action, "parry.ji2" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
        }) );

	setup();

    	carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	object me,ob;
	me = this_object () ;
	ob = this_player () ;

	::init();

	if( interactive(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, me, ob);
	}
}
void attempt_apprentice(object ob)
{

        if((int)ob->query_skill("force")<40)
        {
                command("say 你的基本內功太低了，學習武功要先打好基礎。");
                return 0;
        }

        if((int)ob->query("shen") <= 1000)
        {
                command("say 你應當多作些行俠仗義的事，以修身心。");
                return 0;
        }
        command("recruit " + ob->query("id"));
        ob->set("title",HIG"明教"HIY"金毛獅王"NOR"座下弟子");
        command("say 好，我就收下你這位好兄弟");
        command("say 我明教又得一個可塑之才，可喜可賀！");
        return;
}


