//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;
int ask_me();
string ask_ling();
void greeting(object ob);
void create()
{
    seteuid(getuid());
        set_name("張無忌", ({ "zhang wuji", "zhang", "wuji" }));
        set("long", "明教教主張無忌，統領天下十萬教眾，豪氣干云，叱  千秋，\n"
               +"「九陽神功」、「乾坤大挪移」獨步天下，是江湖中不世出的\n"
               +"少年英雄。\n");
    set("title",HIG"明教"HIW"第三十四代教主"NOR);
    set("gender", "男性");
    set("age", 20);
    set("shen_type",1);
    set("attitude", "friendly");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("qi", 30000);
    set("max_qi", 30000);
    set("jing", 10000);
    set("max_jing", 10000);
    set("neili", 10000);
    set("max_neili", 10000);
    set("jiali", 120);
    set("combat_exp", 7000000);
    set("score", 455000);
    set_skill("force", 350);
    set_skill("dodge", 350);
    set_skill("parry", 350);
    set_skill("jiuyang", 350);
    set_skill("lingfa", 350);
    set_skill("shenghuo-lingfa", 350);
    set_skill("qiankun-nuoyi", 350);
    map_skill("parry", "qiankun-nuoyi");
    map_skill("force", "jiuyang");
    map_skill("dodge", "qiankun-nuoyi");
    map_skill("lingfa", "shenghuo-lingfa");
        prepare_skill("lingfa","shenghuo-lingfa");

    set("chat_chance_combat", 80);
    set("chat_msg_combat", ({
                (: perform_action, "lingfa.sh1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "r" :),
        }) );

    create_family("明教",34, "教主");

    set("inquiry", ([
                "乾坤大挪移" : (: ask_me :),
                "鐵焰令" : (: ask_ling :),
        ]) );
                setup();
        carry_object("/clone/book/shenghuo-ling")->wield();
        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
        object ob;

        ::init();

        if( interactive(ob=this_player()) && !is_fighting())
        {
                remove_call_out("greeting");
                call_out("greeting",1,ob);
        }
}

void greeting(object ob)
{
        if(!ob || environment(ob)!=environment()) return;
        if((int)ob->query("shen")<-50000)
        {
//      command("say
                command("wield yitian jian");
                command("hit"+(string)ob->query("id"));
                command("unwield uitian jian");
        }
        else if((int)ob->query("shen")<-5000)
        {
                command("say 魔從心起，于武學不利，其道必誅，勸君放下屠刀，立地成佛.");
        }
        else if((int)ob->query("shen")<-100)
        {
                command("say 這位朋友，人行江湖，言行當正，切務走進邪魔歪道.");
        }
        else if((int)ob->query("shen")>=0)
        {
                command("say 光明正道任人走，勸君多加保重.");
        }
        else if((int)ob->query("shen")>20000)
        {
                command("say 大俠在上，受無忌一禮，大俠它日必為武林翹楚.");
        }
        return;
}



void attempt_apprentice(object ob)
{
        if((int)ob->query_int()<40)
        {
                command("say 你的悟性太低了，不適合學習我的功夫。");
                return 0;
        }
        if((int)ob->query_skill("force")<100)
        {
                command("say 你的基本內功太低了，學習我的功夫會傷及自身。");
                return 0;
        }

        if((int)ob->query("shen") <= 15000)
        {
                command("say 你應當多作些行俠仗義的事，以修身心。");
                return 0;
        }
        command("recruit " + ob->query("id"));
        ob->set("title",HIW"明教教主親傳弟子"NOR);
        command("say 好，我就收下你這位好兄弟");
        command("say 再接再礪！");
        return;
}

int accept_fight(object ob)
{
    if(((int)ob->query("combat_exp")<30000)&&((int)ob->query("shen")>0))
    {
        message_vision("武林中人最忌爭強斗狠，你不是我的對手，回去吧。\n",ob);
        return 0;
    }
    message_vision("張無忌一拱手說道：這位"+RANK_D->query_respect(ob)+
        "，在下領教了。\n", ob);
    return 1;
}
int ask_me()
{       object obj,me;
        me=this_player();
        if(this_player()->query_skill("shenghuo-xinfa",1)<100) 
        {
                 command("say "+RANK_D->query_respect(me)+"似乎聖火心法修為還不夠。");
        return 1;
        }
        if(this_player()->query("combat_exp")<800000) 
        {
                 command("say "+RANK_D->query_respect(me)+"似乎實戰經驗還不夠。");
        return 1;
        }
        if(this_player()->query_skill("force",1)<100) 
        {
                 command("say "+RANK_D->query_respect(me)+"似乎基本內功修為還不夠。");
        return 1;
        }
        if ( this_player()->query_temp("marks/挪移") ) {
            command("say "+"你不是剛剛才問過嗎？");return 1;
        }
        else {  
                

                command("say "+"好吧，我就准許你修煉乾坤大挪移。以后你要發揚光大明教。");
                command("say "+"你到張中前輩那里去就說是我准許的。");
                command("pat "+me->query("id") );
                command("addoil "+me->query("id") );
                
                
                this_player()->set_temp("marks/挪移", 1);return 1;
        }
        
}
string ask_ling()
{
        mapping fam;
        object ob,me=this_player();

        if (!(fam = me->query("family")) || fam["family_name"] != "明教")
                return RANK_D->query_respect(me) +
                "與本派素無來往，不知此話從何談起？";

        ob = new("/d/mingjiao/obj/tieyanling");
        ob->move(me);
        message_vision("$N獲得一面鐵焰令。\n",me);
        return "好吧，憑這面鐵焰令，可以自由向你的尊長挑戰。";

}

