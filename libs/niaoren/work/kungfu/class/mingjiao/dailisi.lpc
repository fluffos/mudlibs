//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;


void create()
{
    seteuid(getuid());
	set_name("黛麗絲", ({ "dai lisi", "dai", "lisi" }));
	set("long", "明教四大法王之一，據說年輕的時侯相當漂亮。\n一手奪命金花更是曠古絕今。\n");
    set("title",HIM"紫衫龍王"NOR);
    set("gender", "女性");
    set("age", 45);
    set("shen_type",1);
    set("attitude", "friendly");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("qi", 3050);
    set("max_qi", 3050);
    set("jing", 3050);
    set("max_jing", 3050);
    set("neili", 5000);
    set("max_neili", 5000);
    set("jiali", 120);
    set("combat_exp", 1500000);
    set("score", 55000);
    set_skill("force", 250);
    set_skill("dodge", 250);
    set_skill("parry", 250);
    set_skill("shenghuo-shengong", 250);
    set_skill("throwing", 250);
    set_skill("duoming-jinhua", 250);
    set_skill("xiaoyao-bu", 250);

    map_skill("parry", "duoming-jinhua");
    map_skill("force", "shenghuo-shengong");
    map_skill("dodge", "xiaoyao-bu");
    map_skill("throwing", "duoming-jinhua");

    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
                (: exert_function, "re1" :),
        }) );

    create_family("明教",35, "法王");

    setup();
//    catch(carry_object("/d/mingjiao/obj/jinhua")->wield()); /* target missing from archive -- guarded */
    carry_object("/d/mingjiao/obj/baipao")->wear();

}





void attempt_apprentice(object ob)
{

	if((int)ob->query_skill("force")<50)
	{
		command("say 你的基本內功太低了，學習我的功夫會傷及自身。");
		return 0;
	}


	ob->set("title","明教紫衫龍王座下弟子");
	command("recruit " + ob->query("id"));
	command("say 好，我就收下你這位好兄弟");
	command("say 再接再礪！");
	return;
}



