// YangXiao.c
// pal 1997.05.09

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
int ask_me();
string ask_array();


void create()
{
    set_name("楊逍", ({"yang xiao","yang","xiao",}));
        set("long",
        "他是一位中年書生，身穿白布長袍。\n"
        "他相貌俊雅，只是雙眉略向下垂，嘴邊露出几條深深的皺紋，不免略帶衰老淒苦\n"
        "之相。他不言不動，神色漠然，似乎心馳遠方，正在想什么事情。\n"
        );

        set("title",HIG "明教" HIR "光明左使" NOR);
        set("level",11);
        set("gender", "男性");
        set("attitude", "peaceful");
        
        set("age", 42);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("max_qi", 3500);
        set("max_jing", 1500);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 150);
        set("combat_exp", 1000000);
        set("score", 800000);

        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("blade", 200);
        set_skill("sword", 200);

        set_skill("literate", 200);
        set_skill("mingwang-jian", 200);
        set_skill("shenghuo-shengong", 200);
        set_skill("xiaoyao-bu", 200);
        set_skill("shenghuo-xinfa", 200);

        map_skill("force", "shenghuo-shengong");
        map_skill("dodge", "xiaoyao-bu");
        map_skill("parry", "mingwang-jian");
        map_skill("sword", "mingwang-jian");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
        }) );

    create_family("明教",35, "護法");
        set("inquiry", ([
                "炎龍馬" : (: ask_me :),
                "光明聖火陣" : (: ask_array :),
        ]) );

        setup();
        carry_object("/d/mingjiao/obj/changjian")->wield();
        carry_object("/d/mingjiao/obj/baipao")->wear();
}




void attempt_apprentice(object ob)
{

        if((int)ob->query_skill("force")<70)
        {
                command("say 你的基本內功太低了，學習武功要先打好基礎。");
                return 0;
        }

        if((int)ob->query("shen") <= 1000)
        {
                command("say 你應當多作些行俠仗義的事，以修身心。");
                return 0;
        }
        command("recruit " + ob->query("id"));
        ob->set("title",HIG"明教"HIR"光明左使"NOR"座下弟子");
        command("say 好，我就收下你這位好兄弟。");
        command("say 再接再礪！");
        return;
}
void init()
{
        object ob;
        mapping myfam;
        
        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                  myfam = (mapping)ob->query("party");
                       if ((!myfam || myfam["party_name"] != HIG "明教" NOR ) ) {
                        remove_call_out("do_killing");
                        call_out("do_killing",4,ob);
                }
        }
}

void do_killing(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        command("consider " +ob->query("id") );
        this_object()->kill_ob(ob);
}

int ask_me()
{       object obj,me;
        me=this_player();
        if ( this_player()->query_temp("marks/令") ) 
        {
            command("say "+"你不是剛剛才問過嗎？");
            return 1;
        }
        command("say "+"我的炎龍馬不知道哪里去了，不然我可以讓你騎著它去波斯。");
        this_player()->set_temp("marks/令", 1);
        return 1;
}
#include "/kungfu/class/mingjiao/yangxiao.h"
