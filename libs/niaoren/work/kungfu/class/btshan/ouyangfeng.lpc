///ouyangfeng.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("歐陽鋒", ({ "ouyang feng", "ouyang", "feng" }));
	set("long", "他是白駝山庄主，號稱“西毒”的歐陽鋒。\n"
		   +"由于習練「九陰真經」走火入魔，已變得精\n"
		   +"神錯亂，整日披頭散發。\n");
	set("title", "老毒物");
	set("gender", "男性");
	set("age", 53);
	set("nickname", HIR "西毒" NOR);
	set("shen_type",-1);
	set("attitude", "peaceful");

	set("str", 35);
	set("int", 35);
	set("con", 35);
	set("dex", 35);

	set("qi", 4500);
	set("max_qi", 4500);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 5000);
	set("max_neili", 5000);
	set("jiali", 150);

	set("combat_exp", 2500000);
	set("score", 300000);

	set_skill("force", 200);
	set_skill("unarmed", 200);
	set_skill("dodge", 200);
	set_skill("parry", 220);
	set_skill("hand",200);
	set_skill("staff", 250);
	set_skill("hamagong", 250);
	set_skill("chanchu-bufa", 200);
	set_skill("shexing-diaoshou", 250);
	set_skill("lingshe-zhangfa", 250);

	map_skill("force", "hamagong");
	map_skill("dodge", "chanchu-bufa");
	map_skill("unarmed", "shexing-diaoshou");
	map_skill("hand", "shexing-diaoshou");
	map_skill("parry", "lingshe-zhangfa");
	map_skill("staff", "lingshe-zhangfa");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "staff.li1" :),
                (: exert_function, "re1" :),
                (: exert_function, "re" :),
                (: exert_function, "p" :),
        }) );

	create_family("白駝山派",1, "開山祖師");
        set("chat_chance",2);
        set("chat_msg",({
         "歐陽鋒自言自語道：何日白駝山派才能重霸江湖呢…\n",
         "歐陽鋒道：我兒歐陽克必能夠重振白駝山派雄風！\n",
         "歐陽鋒道：江湖險惡，困難重重哪！\n",
        }));
	setup();
	carry_object("/clone/weapon/gangzhang")->wield();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver",50);
}

void attempt_apprentice(object ob)
{
  if((int)ob->query("combat_exp")<100000)
        {
          message_vision("歐陽鋒對$N笑道：你的經驗太低了,我還不能收你！\n",ob);
	return ;
         }
   message_vision("歐陽鋒拍拍$N的頭，微微點了點頭。\n",ob);
   command("recruit " + ob->query("id"));
   return;
}

