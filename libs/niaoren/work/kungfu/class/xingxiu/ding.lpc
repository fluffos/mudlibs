// ding.c 丁春秋

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int do_skill();

void create()
{
	set_name("丁春秋", ({ "ding chunqiu", "ding" }));
	set("nickname", HIR "星宿老怪" NOR);
	set("long", 
		"他就是星宿派開山祖師、令正派人士深惡痛絕的星宿老怪丁春秋。\n"
		"可是他看起來形貌清奇，仙風道骨。\n");
	set("gender", "男性");
	set("age", 60);
	set("attitude", "friendly");
	set("shen_type", -1);
	set("str", 25);
	set("int", 30);
	set("con", 28);
	set("dex", 28);
	
	set("max_qi", 7000);
	set("max_jing", 6000);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali", 100);
	set("combat_exp", 1500000);
	set("score", 400000);

        set_skill("force", 350);
	set_skill("huagong-dafa", 300);
        set_skill("dodge", 300);
	set_skill("zhaixinggong", 310);
        set_skill("strike",350);
	set_skill("xingxiu-duzhang", 290);
        set_skill("parry", 298);
        set_skill("staff", 320);
	set_skill("tianshan-zhang", 325);
	set_skill("literate", 280);

	map_skill("force", "huagong-dafa");
	map_skill("dodge", "zhaixinggong");
	map_skill("strike", "xingxiu-duzhang");
	map_skill("parry", "tianshan-zhang");
        map_skill("staff", "tianshan-zhang");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "strike.xi1" :),
                (: exert_function, "re1" :),
                (: exert_function, "js1" :),
                (: exert_function, "js2" :),
                (: exert_function, "ms" :),
                (: exert_function, "ns" :),
                (: exert_function, "qs" :),
                (: exert_function, "s1" :),
                (: exert_function, "p" :),
        }) );

	create_family("星宿派", 1, "開山祖師");
	set("class", "taoist");

	setup();
        //carry_object("/clone/weapon/gangzhang")->wield();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_flatter", "flatter");
}

void attempt_apprentice(object me)
{
        if ((int)me->query("betrayer")) {
                command("say 我越看你越象是來臥底的。");
                return;
        }

        if( me->query_temp("pending/flatter") ) {
                command("say 你如此不把老仙放在眼里，老仙怎會收你？");
                return;
        } else {
                command("say 我星宿老仙比起古往今來的聖人怎么樣啊？");
                message_vision("星宿老怪微閉雙眼，手捻長須，一付等人拍馬(flatter)的樣子。\n",
                this_player());
                me->set_temp("pending/flatter", 1);
        }
}

int do_flatter(string arg)
{	  object me=this_player();	
        if( !this_player()->query_temp("pending/flatter") )
                return 0;
        if( !arg ) return notify_fail("你說老仙什么？\n");
        this_player()->set_temp("pending/flatter", 0);
        message_vision("$N大聲說道：" + arg + "\n", this_player());
        if( strsrch(arg, "星宿老仙") >=0 && (strsrch(arg, "德配天地") >=0
         || strsrch(arg, "威震寰宇") >=0 || strsrch(arg, "古今無比") >=0 )) {
                command("smile");
                command("say 這還差不多。\n");
			if (do_skill())
                command("recruit " + this_player()->query("id"));
			else command( "say 不過你的化功大法太差了，我不想收你!");
        } else {
                command("say 你如此不把老仙放在眼里，老仙怎會收你？");
        }
        return 1;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                add("apprentice_available", -1);
}

int do_skill()
{ object me=this_player();
	if ((int)me->query_skill("huagong-dafa",1) < 80 ) return 0;
	return 1;
}
// 星宿老仙，德配天地，威震寰宇，古今無比

