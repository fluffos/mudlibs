#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
        set_name("無名老僧", ( {"wuming seng","wuming","seng"} ) );
        set("long","他就是少林無名老僧，看起來已經是風燭殘年。而且雙腿殘廢。 \n" );
        create_family("少林派",2, "弟子");
        set("attitude", "peaceful");
        set("age", 95);
        set("gender", "男性");
        set("shen_type", 1);
        set("no_drop",1);
	set("chat_msg", ({
           CYN"無名僧人言到：“老納自創之少林無影劍，舉世無雙。”\n"NOR,
           CYN "無名僧人言到：“老納一身只敗在獨孤九劍之下，于是鑽研20年終創出無敵的少林無影劍。”\n"NOR,
	}));
        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("str", 30);
	set("per", 15);
	set("ker", 10);
        set("max_jing", 1000);
        set("max_neili", 15000);
        set("max_qi", 10000);
        set("jing",1000);
        set("neili",50000);
        set("qi",10000);
        set("jiali", 150);
        set("shen", -100000);
        set("combat_exp", 2500000);

        set_skill("buddhism",350); 
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("literate",350);
        set_skill("parry", 350);
        set_skill("sword", 350);
        set_skill("finger", 350);
	set_skill("wuying-jian", 300);
        set_skill("hunyuan-yiqi", 350);
        set_skill("shaolin-shenfa", 350);
        
	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "wuying-jian");
	map_skill("sword", "wuying-jian");
	       

        set("chat_chance", 0); 
        set("chat_msg", ({
                    CYN"無名老僧說道：老衲被玄風這小兒害得雙腿盡廢。\n""我一定想法報仇.....\n"NOR,                 
       }));                                 

        set("inquiry", ([
                "玄風" : "少林居然出了玄風這個鼠輩，當年我早看出其心朮 不正\n""因此沒有傳他少林無影劍，這斯卻把我囚禁再此,已有30余年了！\n""想逼我交出劍譜，哼！我豈能給他......\n",
                "少林無影劍" : "少林無影劍是老衲自創絕技。攻擊式如狂風一般勢不可擋！\n",
                "拜師" : "哦！想拜老衲為師？\\老衲大仇未報不想收徒，除非......\n",
		
        ]));

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: command("exert recover") :),
	}) );

        setup();

        carry_object( "/d/shaolin/obj/dao-cloth")->wear();
        carry_object( "/clone/weapon/changjian")->wield();

}
void attempt_apprentice(object who)
{      
       mapping who_fam;
       string name, new_name;
       name = who->query("name");
           if ((int)who->query("bai_wuming") == 1 ){
	        command("say 我不會再收你為徒了，你還是走吧！\n");
                return;
	}
          if (!(who_fam = who->query("family")) || who_fam["family_name"] != "少林派")
	{
		command("say " + RANK_D->query_respect(who) + "與本派素無來往，不知此話從何談起？");
		return;
	}
        if ((int)who->query_skill("buddhism", 1) < 120) {
		command("say 悟禪之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在禪宗心法方面，" + RANK_D->query_respect(who) +
			"是否還做得不夠？");
		return;
	}

        if ((int)who->query("killxf") == 1 ){
	        command("chat 想不到老納在垂死之年，又覓得一個可塑之才，好！老衲就將畢生\n""的武學都傳受于你！\n");
	        command("recruit " + who->query("id"));
            
                who->set("title", HIY"少林派之世外高僧"NOR);
                name = who->query("name");
		new_name = "玄" + name[2..3];
		who->set("name", new_name); 
                who->set("bai_wuming", 1); 
                command("say 從今以后你的法名叫做" + new_name + "，恭喜你榮升為少林派玄字輩弟子 !");
                command("recruit " + who->query("id")); 
		
                return;
	}

	        command("say 哦！想拜老衲為師？\n");
	        command("say 老衲大仇未報不想收徒，除非......\n");
		who->set_temp("go_kill_xf", 1);

        return 0;
}

int accept_object(object who, object ob)
{
        if ((int)who->query("killxf") == 1 ){
	        message_vision("無名老僧看了看$N，說道：我不會再收你了，你還是走吧！\n", ob);
                return 1;
	}

        if ( (string) ob->query("id") =="xf poll" && (int)who->query("shaxf") == 1) 
	{
                message_vision("無名老僧看了看$N送來的人頭，一陣狂笑道：\n"
                               "呵！呵！呵！玄風小兒你也有今天。\n"
                               "看你拜師至誠，老納就收下你這個佳弟子。\n", who);
		who->set("killxf", 1);
                return 1;
        }

        if ( (string) ob->query("id") =="xf poll") 
	{
		if ( (int)who->query("shaxf") != 1) 
		{
                message_vision("無名老僧看了看$N送來的人頭，突然說到:\n"
                               "哼！哼！你這小賊，居然敢騙我！明年的今天就是你的忌日！！！\n"
                               "讓你死也死個明白！告訴你吧！因為玄風不是你…殺…的！\n", who);
		who->set("killxf", 1);
		command("kill " + this_player()->query("id"));
                return 1;
	        }
        }

        return 0;
}
