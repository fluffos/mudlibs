// damo.c 達摩祖師

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
	set_name("達摩祖師", ({ "damo zushi", "damo" }));
	set("nickname", "一葦渡江");
	set("long", 
		"他就是少林派開山鼻祖、當今武林的隱世高僧達摩祖師。\n"
		"身穿一件錦蘭袈挲，手執禪杖。\n"
		"身材高大，年滿百歲，滿臉紅光，須眉皆白。\n");
	set("gender", "男性");
	set("age", 500);
	set("attitude", "friendly");
	set("shen_type", 1);
	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);
	
	set("qi", 10000);
	set("max_qi", 10000);
	set("max_jing", 5000);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 200);
	set("combat_exp", 10000000);
	set("score", 1000000);

	set_skill("force", 500);
	set_skill("jiuyang-shengong", 500);
	set_skill("dodge", 500);
	set_skill("shaolin-shenfa", 500);
	set_skill("cuff", 500);
	set_skill("sword", 500);
	set_skill("parry", 500);
	set_skill("finger", 500);
	set_skill("shaolin-shenfa", 500);
	set_skill("jingang-quan", 500);
	set_skill("riyue-bian",500);
	set_skill("hand", 500);
	set_skill("strike", 500);
	set_skill("claw", 500);
	set_skill("staff", 500);
	set_skill("club", 500);
	set_skill("blade", 500);
	set_skill("whip", 500);
	set_skill("damo-jian", 500);
	set_skill("jingang-quan", 500);
	set_skill("buddhism", 500);
	set_skill("literate", 500);
//	set_skill("unarmed",500);

	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "jingang-quan");
	map_skill("parry", "jingang-quan");
	map_skill("sword", "damo-jian");
	map_skill("whip", "riyue-bian");
        
        prepare_skill("cuff", "jingang-quan"); 
	create_family("少林派", 1, "開山祖師");
	set("class", "buddhism");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
//		(: command("wield changbian") :),
		(: perform_action, "whip.chan" :),
//		(: command("unwield changbian") :),
//		(: command("wield sword") :),
//		(: perform_action, "sword.sanjue" :),
//		(: command("unwield sword") :),
		(: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/shaolin/obj/changbian")->wield();
	carry_object("/clone/weapon/changjian");
}

void attempt_apprentice(object ob)
{
	object me; 
	mapping ob_fam, my_fam;
	string name, new_name;

	me = this_object();
	my_fam  = me->query("family");

	name = ob->query("name");

	if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派")
	{
		command("say " + RANK_D->query_respect(ob) + "與本派素無來往，不知此話從何談起？");
		return;
	}

	if ( (string)ob->query("class")!="bonze" && ob_fam["family_name"] == "少林派") 
	{
		command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺內學藝。");
		return;
	}

	if ( ob_fam["generation"] <= my_fam["generation"] )
	{
		command("say " + RANK_D->query_respect(ob) + "，貧僧哪里敢當 !");
		return;
	}
	if ((int)ob->query_skill("hunyuan-yiqi", 1) < 200) {
		command("say 我少林派乃內家武功，最重視內功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在內功上多下點功夫？");
            		return;
	}
	if ((int)ob->query_skill("buddhism", 1) < 200) {
		command("say 悟禪之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
		command("say 在禪宗心法方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("dodge", 1) < 200) {
		command("say 在輕功方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("shaolin-shenfa", 1) < 200) {
		command("say 在輕功方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("force", 1) < 200) {
		command("say 在內功方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if ((int)ob->query_skill("parry", 1) < 200) {
		command("say 在基本功方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if (ob->query_int() < 45) {
		command("say 萬事都講一個緣字。");
		command("say " + RANK_D->query_respect(ob) + "與佛無緣，還是請回吧。");
		return;
	}
	if (ob->query_MKS() > 0 ) {
		command("say 萬事都講一個緣字。");
		command("say " + RANK_D->query_respect(ob) + "與佛無緣，還是請回吧。");
		return;
	}
	if (ob->query_PKS() > 0 ) {
		command("say 萬事都講一個緣字。");
		command("say " + RANK_D->query_respect(ob) + "與佛無緣，還是請回吧。");
		return;
	}
//	if ( ( ob_fam["generation"] + 35 ) == (my_fam["generation"]) )
	if ( ob->query("family/generation") == 36 )
       
	{
	//	if ((int)ob->query("luohan_winner") )
	//	{	
			command("say 老衲垂死之年，又得一可塑之才，真是可喜可賀 !");
                                           
			name = ob->query("name");
			new_name = "渡" + name[2..3];
			ob->set("name", new_name);
			ob->set("family/generation", 35);

			command("say 從今以后你的法名叫做" + new_name + "，恭喜你榮升為少林派渡字輩羅漢之一 !");
			command("recruit " + ob->query("id"));
		        ob->set("title",HIW"少林達摩祖師親傳弟子"NOR);
		
	}

	return;



}
