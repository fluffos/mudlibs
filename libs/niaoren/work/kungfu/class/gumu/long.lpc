inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int ask_chongyang();
int ask_jiuyin();
string ask_shoutao();
string ask_suo();
string ask_zhen();
void create()
{
        set_name("小龍女", ({ "xiao long nu", "long" }));
        set("long",
                "披著一襲輕紗般的白衣，猶似身在煙中霧里，除了一頭黑發之外，全身雪白，\n"+
"面容秀美絕俗，只是肌膚間少了一層血色.\n");
        set("gender", "女性");
        set("age", 29);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 25);
        set("per",31);
        set("int", 30);
        set("con", 25);
        set("dex", 30);

        set("count",1);
        set("yfzhen",10);
        
        set("shen",600000);
        set("max_jingli",2000);
        set("jingli",2000);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);

        set("combat_exp", 5000000);
        set("score", 8500);     
        
        set_skill("force",350);
        set_skill("yunu-xinfa",350);
        set_skill("yunu-xinjing",350);
        set_skill("literate",300);
        set_skill("meinu-quanfa",300);
        set_skill("tianluo-diwang",300);
        set_skill("sword",400);
        set_skill("yunu-jianfa",400);
        set_skill("unarmed",300);
        set_skill("dodge",400);
        set_skill("yufeng-shu",300);
        set_skill("whip",300);
        set_skill("yinsuo-jinling",300);
        set_skill("xianyun-bufa",400);
        set_skill("throwing",400);
        set_skill("parry",300);

        map_skill("force","yunu-xinjing");
        map_skill("unarmed","meinu-quanfa");
        map_skill("sword","yunu-jianfa");
        map_skill("dodge","xianyun-bufa");
        map_skill("parry","yunu-jianfa");
        map_skill("whip","yinsuo-jinling");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "whip.yi1" :),
                (: perform_action, "whip.yi2" :),
                (: perform_action, "sword.yu1" :),
                (: perform_action, "sword.yu2" :),
                (: perform_action, "unarmed.me1" :),
                (: perform_action, "unarmed.me2" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "r" :),
        }) );

        set("inquiry", ([
        "重陽遺刻":(: ask_chongyang :),
        "玉女心經":(: ask_chongyang :),
        "密室":(: ask_jiuyin :),
        "九陰真經":(: ask_jiuyin :),
        "金鈴索":(: ask_suo :),
        "金絲手套":(: ask_shoutao :),
        "玉蜂針":(: ask_zhen :),
        ]));
        
        create_family("古墓派", 3, "掌門");
        setup();
        carry_object("/d/gumu/npc/obj/shunvjian")->wield();
        carry_object("/d/gumu/npc/obj/baipao")->wear();


}
void attempt_apprentice(object ob)
{
        mapping myfam;
         myfam = (mapping)ob->query("family");
        if(!myfam && myfam["family_name"] != "古墓派")
        {
                command("say 對不起，我不收別派弟子。");
                return;
        }
         
        if(ob->query("class")=="taoist")
                {
                        command("say 你已經是我師姐的弟子了，你還來找我干嘛？");
                        return;
                }
        if ((int)ob->query("shen") < 50000) {
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }

        
        if( (int)ob->query_dex()< 30){
                command("say 你的身法太差.");
                return;
        }
        if( (int)ob->query_int() < 45){
                command("say 你的悟性太差。");
                return;
        }
        if((int)ob->query_skill("yunu-xinfa",1)< 100){
                command("say 你的玉女心法太差了。");
                return ;
        }
        if((int)ob->query_skill("tianluo-diwang",1)<100){
                command("say 你的天羅地網勢火候不夠。");
                return ;
        }
        if((int)ob->query_skill("xianyun-bufa",1)<100){
                command("say 你的纖云步法太生疏了。");
                return ;
        }
        if((int)ob->query("max_neili")< 1000){
                command("say 你的內功修為不夠。");
                return ;
        }
        
                        
                command("say 好吧，我就收下你了。");
                command("say 以后一定更不能做壞事。");
                command("recruit " + ob->query("id"));

}

int ask_chongyang()
{
        object me=this_player(1);
        mapping myfam;
         myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
            {
                if(me->query("class")==!"taoist")
                {
                        command("say 要先在大廳打開機關，再去打開暗門.\n");
                        me->set_temp("gumu/重陽",1);
                        return 1;
                }
                else
                {
                        command("say 你是我師姐的弟子，我干嘛要告訴你？.\n");
                        return 1;
                }
        }
        else
        {
                return 1;
        }
}
int ask_jiuyin()
{
        object me=this_player(1);
        mapping myfam;
         myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
            {
                if(me->query("class")==!"taoist")
                {
                        command("say 你去推開棺木，然后自己去看吧。.\n");
                        me->set_temp("gumu/九陰",1);
                        return 1;
                }
                else
                {
                        command("say 你是我師姐的弟子，我干嘛要告訴你？.\n");
                        return 1;
                }
        }
        else
        {
                return 1;
        }
}
string ask_suo()
{
        object me=this_player();
        object obn;
        mapping myfam;
        if (query("count") < 1)
                return "你來晚了，金鈴索已經給人取走了。\n";

        if(me->query_temp("金鈴索",1))
                return "不是給過你了嗎？\n";
                
         myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
        if(myfam["generation"] == 4)
            {
                if(me->query("class")==!"taoist")
                {
                        obn=new("/d/gumu/obj/jinling-suo");
                        obn->move(me);
                        add("count", -1);
                        me->set_temp("金鈴索",1);
                        return "這條金鈴索我送給你把。";
                }
                else
                {
                        command("say 你是我師姐的弟子，我干嘛要給你？.\n");
                        return 0;
                }
        }
        else
        {
                return 0;
        }
}       
string ask_shoutao()
{
        object me=this_player();
        object obn;
        mapping myfam;
        if (query("count") < 1)
                return "你來晚了，金絲手套已經給人取走了。\n";

        if(me->query_temp("金絲手套",1))
                return "不是給過你了嗎？\n";
                
         myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
        if(myfam["generation"] == 4)
            {
                if(me->query("class")==!"taoist")
                {
                        obn=new("/d/gumu/obj/jinsi-shoutao");
                        obn->move(me);
                        add("count", -1);
                        me->set_temp("金絲手套",1);
                        return "這雙金絲手套就送給你吧。\n";
                }
                else
                {
                        command("say 你是我師姐的弟子，我干嘛要給你？.\n");
                        return 0;
                }
        }
        else
        {
                return 0;
        }
}       
string ask_zhen()
{
        object me=this_player();
        object obn;
        mapping myfam;
        if (query("yfzhen") < 1)
                return "我這里已經沒有玉蜂針了。\n";

         myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
        if(myfam["generation"] == 4)
            {
                if(me->query("class")==!"taoist")
                {
                        obn=new("/d/gumu/obj/yfzhen");
                        obn->move(me);
                        add("yfzhen", -1);
                        return "這些玉蜂針就送給你吧。\n";
                }
                else
                {
                        command("say 你是我師姐的弟子，我干嘛要給你？.\n");
                        return 0;
                }
        }
        else
        {
                return 0;
        }
}       
        
           
