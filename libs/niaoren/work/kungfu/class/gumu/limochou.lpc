inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int do_look(string target);
string ask_zhen();
void create()
{
	set_name("李莫愁", ({ "li mochou", "li","mochou" }));
	set("nickname",HIR"赤煉仙子"NOR);
	set("long",
		"她生得極為美貌，但冰冷的目光讓人不寒而立，\n");
	set("gender", "女性");
	set("age", 34);
	set("attitude", "heroism");
	set("shen_type", 1);
	set("per",29);
	set("str", 30);
	set("dex", 35);
	set("con", 17);
	set("int", 25);

	set("bpzhen",10);
	
	set("shen",600000);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali", 100);

	set("combat_exp", 5000000);
	set("score", 8500);	
	
	set_skill("force",350);
	set_skill("yunu-xinfa",350);
	set_skill("literate",300);
	set_skill("meinu-quanfa",300);
	set_skill("tianluo-diwang",300);
	set_skill("wudu-shenzhang",300);
	set_skill("swsb-shou",300);
	set_skill("unarmed",300);
	set_skill("dodge",400);
	set_skill("whip",300);
	set_skill("xianyun-bufa",400);
	set_skill("throwing",400);
	set_skill("parry",300);

	map_skill("force","yunu-xinfa");
	map_skill("unarmed","wudu-shenzhang");
	map_skill("dodge","xianyun-bufa");
	map_skill("parry","swsb-shou");
	map_skill("whip","swsb-shou");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: command("unwield fuchen") :),
                (: command("unwield fuchen") :),
                (: perform_action, "unarmed.wu1" :),
                (: perform_action, "unarmed.wu1" :),
                (: perform_action, "unarmed.wu1" :),
                (: exert_function, "re1" :),
                (: command("wield fuchen") :),
        }) );

        set("inquiry", ([
	    "冰魄銀針":(: ask_zhen :),
	    "小龍女" : "那是我的師妹。你問她想干什么？",
	    "林朝英" : "那是我的師祖，不該你問的你別問，小心我宰了你。",

	]));
	set("chat_chance", 10);
	set("chat_msg", ({
	    "李莫愁縱聲而歌，音調淒婉，歌道：「問世間，情是何物，直教生死相許？」\n",
	    "李莫愁歌道：「天南地北雙飛客，老翅几回寒暑？」\n",
	    "李莫愁唱道：「歡樂趣，離別苦，就中更有痴兒女。」\n",
	    "李莫愁唱道：「君應有語，渺萬里層云，千山暮雪，只影向誰去？」\n",
	    "李莫愁詞意悲切，聲調更是哀怨，唱道：「橫汾路，寂寞當年簫鼓。荒煙依舊平楚。」\n",
	    "李莫愁歌道：「招魂些何嗟及，山鬼自啼風雨。」\n",
	    "李莫愁唱道：「天也妒，未信興，鶯兒燕子俱黃土。」\n",
	    "李莫愁唱道：「千秋萬古，為留待騷人，狂歌痛飲，來訪雁丘處。」\n",
	}) );

	
	create_family("古墓派", 3, "弟子");
	setup();
        catch(carry_object("/d/gumu/obj/fuchen")->wield()); /* target missing from archive -- guarded */
        carry_object("/d/city/obj/cloth")->wear();

}
void attempt_apprentice(object ob)
{
        mapping myfam;
       	 myfam = (mapping)ob->query("family");
        if(!myfam && myfam["family_name"] != "古墓派")
        {
        	command("say 對不起，我不收別派弟子。");
        	return;
        }
         
        if(ob->query("class")!="taoist")
		{
			command("say 你已經是我師妹的弟子了，你還來找我干嘛？");
			return;
		}
	if ((int)ob->query("shen") > - 50000) {
		command("say " + RANK_D->query_respect(ob) +
			"是否還不夠狠毒？");
		return;
	}

	
	if( (int)ob->query_dex()< 30){
		command("say 你的身法太差.");
		return;
	}
	if( (int)ob->query_int() < 45){
		command("say 你的悟性太差。");
		return;
	}
	if((int)ob->query_skill("yunu-xinfa",1)< 200){
		command("say 你的玉女心法太差了。");
		return ;
	}
	if((int)ob->query_skill("tianluo-diwang",1)<150){
		command("say 你的天羅地網勢火候不夠。");
		return ;
	}
	if((int)ob->query_skill("xianyun-bufa",1)<150){
		command("say 你的纖云步法太生疏了。");
		return ;
	}
	if((int)ob->query("max_neili")< 1000){
		command("say 你的內功修為不夠。");
		return ;
	}
	
			
        	command("say 好吧，我就收下你了。");
		command("recruit " + ob->query("id"));
		if( (string)ob->query("class") != "taoist")
		ob->set("class", "taoist");
}

string ask_zhen()
{
	object me=this_player();
	object obn;
	mapping myfam;
	if (query("bpzhen") < 1)
		return "我這里已經沒有玉蜂針了。\n";

	 myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
       	if(myfam["generation"] == 4)
            {
            	if(me->query("class")=="taoist")
            	{
            		obn=new("/d/gumu/obj/bpzhen");
            		obn->move(me);
            		add("bpzhen", -1);
            		return "這些冰魄銀針就送給你吧。\n";
            	}
            	else
            	{
            		command("say 你是我師妹的弟子，我干嘛要給你？.\n");
            		return 0;
            	}
        }
        else
        {
        	return 0;
        }
}	
int do_look(string target)
{
	object me;

	me = this_player();
	if (target=="li" || target=="li mochou" || target=="mochou" )
           if ((string)me->query("gender") != "女性") {
		   message("vision",
   HIY "李莫愁大怒，喝道：我最恨你們這些薄情的臭男人！去死吧！\n"
       "李莫愁決心殺死" + me->name() +"\n"
   NOR, environment(), this_object() );
                   kill_ob(this_player());
           }
}
