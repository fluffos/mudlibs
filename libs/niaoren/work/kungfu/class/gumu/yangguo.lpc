#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;
inherit F_MASTER;
int do_skills(string arg);
int do_kill(object me, object dest);
void create()
{
	set_name("楊過", ({ "yang guo", "yang" }));
	set("nickname", HIG "神雕大俠" NOR);
	set("gender", "男性");
	set("age", 30);
        set("int",80);
        set("str", 80);
        set("dex", 80);
	set("long", "他是一位高大的男子，相貌俊秀。\n"+
	"一只長袖空空如也，顯是斷了一臂，盡管如此，\n"+
	"仍然掩不住他迷人的風采。\n");
        set("combat_exp", 8000000);
	set("score", 10000);
	set("shen_type", 1);
	set("attitude", "peaceful");
        set_skill("literate", 350);
	set_skill("sword", 350);
	set_skill("force", 400);
	set_skill("unarmed", 400);
	set_skill("dodge", 350);
	set_skill("parry", 350);
	set_skill("anranxiaohun-zhang",400);
	set_skill("quanzhen-jianfa", 350);
	set_skill("xiantian-gong", 400);
	set_skill("xianyun-bufa",350);

	map_skill("sword", "quanzhen-jianfa");
	map_skill("force", "xiantian-gong");
	map_skill("parry", "anranxiaohun-zhang");
	map_skill("unarmed","anranxiaohun-zhang");
	map_skill("dodge", "xianyun-bufa");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: perform_action, "unarmed.an1" :),
                (: exert_function, "re1" :),
                (: command, "unwield jian" :),
                (: command, "wield jian" :),
        }) );

	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/armor", 40);
	set_temp("apply/damage", 100);
        set("qi", 50000); 
        set("max_qi", 50000);
        set("max_jing", 5000);
        set("jing", 5000);
        set("neili", 20000); 
        set("max_neili", 20000); 
	set("jiali", 300);
        set("inquiry", ([
                "小龍女" : "她就在小屋里。\n",
       ]) );
       create_family("古墓派", 3, "弟子");
	setup();
carry_object("/clone/misc/cloth")->wear();
carry_object("/d/gumu/npc/obj/junzijian.lpc")->wield();
	add_money("gold", 2);
}

void init()
{
::init();
add_action("do_skills","skills");
add_action("do_skills","cha");
}

void attempt_apprentice(object ob)
{
    if (ob->query("shen")<50000) 
        message_vision("$N搖了搖頭說道，你的評價好像不是很好呀。\n",this_object());
    else if(!ob->query("couple/have_couple"))
        command("tell "+ob->query("id")+" 對不起，你還沒有所愛的人，我不能教你。\n");
    else {
        command("say 好吧，我就收下你這個徒弟了。\n");
        command("recruit " + ob->query("id"));
    }
}

int do_skills(string arg)
{
   object ob ;
   ob = this_player () ;
   if( !arg || arg!="yang" )
     return 0;
  if (ob->query("shen")<50000)
  {
   message_vision("$N搖了搖頭說道，你的評價不怎么好吧！\n",this_object());
   return 1;
   }
   command("tell "+ob->query("id")+" 我所有的武功如下：\n"+
"□黯然消魂掌 (anranxiaohun-zhang)          - 深不可測 400/    0\n"+
"  讀書識字\ (literate)                      - 深不可測 350/    0\n"+    
"  基本輕功 (dodge)                         - 深不可測 350/    0\n"+    
"  基本內功 (force)                         - 深不可測 400/    0\n"+
"  基本拳腳 (unarmed)                       - 深不可測 400/    0\n"+
"  基本招架 (parry)                         - 深不可測 350/    0\n"+
"□全真劍法 (quanzhen-jianfa)               - 深不可測 350/    0\n"+
"  基本劍法 (sword)                         - 深不可測 350/    0\n"+
"□先天神功 (xiantian-gong)                 - 深不可測 400/    0\n"+
"□纖云步法 (xianyun-bufa)                  - 深不可測 350/    0\n");
return 1;
}

int do_kill(object me, object dest)
{
	if( objectp(dest) && present(dest, environment(me))
		 && !environment(me)->query("no_fight"))
	{
		message_vision(HIR "$N對$n說道：我一見邪派高手就生氣。"
			+RANK_D->query_rude(dest)+"，納命來！\n" NOR, me, dest);
		me->set_leader(dest);
		me->kill_ob(dest);
		dest->fight_ob(me);

		call_out("checking", 0,  me, dest);
	}
	else  
		call_out("waiting", 1, me, dest);
	
	return 1;
}
