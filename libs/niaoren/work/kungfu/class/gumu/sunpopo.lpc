inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int ask_in();

void create()
{
	set_name("孫婆婆", ({ "sun popo", "sun" }));
	set("long",
		"她是一名和藹可親的老婆婆，一張生滿雞皮疙瘩的丑臉,但奇丑之中卻含仁慈溫柔之意.\n");
	set("gender", "女性");
	set("age", 56);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	
	set("max_qi", 800);
	set("max_jing", 300);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 25);

	set("combat_exp", 1500000);
	set("score", 8500);	
	
	set_skill("force",110);
	set_skill("yunu-xinfa",110);
	set_skill("literate",90);
	set_skill("meinu-quanfa",100);
	set_skill("tianluo-diwang",100);
	set_skill("sword",120);
	set_skill("yunu-jianfa",120);
	set_skill("unarmed",100);
	set_skill("dodge",150);
	set_skill("xianyun-bufa",150);
	set_skill("throwing",100);
	set_skill("parry",90);

	map_skill("force","yunu-xinfa");
	map_skill("unarmed","meinu-quanfa");
	map_skill("sword","yunu-jianfa");
	map_skill("dodge","xianyun-bufa");
	map_skill("parry","yunu-jianfa");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.yu1" :),
                (: perform_action, "sword.yu2" :),
                (: perform_action, "unarmed.me1" :),
                (: perform_action, "unarmed.me2" :),
                (: exert_function, "re1" :),
        }) );

        set("inquiry", ([
	"進墓":(: ask_in :),
	"進古墓":(: ask_in :),
	"小龍女":"自從那次以后她就沒有回來過，不過聽說有人在終南山上見過她。\n",
	]));
	
	create_family("古墓派", 4, "弟子");
	setup();
	carry_object("/clone/weapon/changjian")->wield();
          carry_object("/d/city/obj/cloth")->wear();

}
void attempt_apprentice(object ob)
{
        mapping myfam;
        if(ob->query_temp("gumu/吐1",1))
        {
        	command("say 好吧，我就收下你了。");
        	command("say 你以后可以用ask sun about 進墓，ask sun about 進古墓,來問我進入古墓。");
		command("recruit " + ob->query("id"));
		ob->delete_temp("gumu/吐1");
        }
        else
        {
	if ((int)ob->query("shen") < 0) {
		command("say 古墓派已經出過一個魔頭，我不愿讓古墓派再有這等事發生。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if( (string)ob->query("gender") != "女性" )
	{
		command ("say 對不起，本派只收女弟子，你還是另投師們吧。");
		return;
	}
	if( (int)ob->query_kar()< 20){
		command("say 你我無緣，你還是另尋去處吧。");
		return;
	}
	if( (int)ob->query_dex()< 20){
		command("say 你的身法太差，不適合學古墓派的武功.");
		return;
	}
	if( (int)ob->query_int() < 25){
		command("say 你的悟性太差，不適合學古墓派的武功。");
		return;
	}
	if( (int)ob->query_int()< 25){
		command("say 你的相貌。。。我們姑娘是不會收你的。");
		return;
	}
	 myfam = (mapping)ob->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
        if(ob->query("class")=="taoist")
		{
			command("say 你已經是那個叛徒的弟子了,還來這里干什么?");
			return;
		}
	command("say 你自己到里邊去拜師祖婆婆的畫像吧。");
	ob->set_temp("marks/拜師",1);
	ob->move("/d/gumu/xiaoss1");
}
}
int ask_in()
{
	object me=this_player(1);
	mapping myfam;
	 myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] == "古墓派")
            {
            	if(me->query("class")==!"taoist")
            	{
            		command("say 你去吧.\n");
            		me->move("/d/gumu/dating");
            		return 1;
            	}
            	else
            	{
            		command("say 你已經不是古墓派的弟子了,不許你進去.\n");
            		return 1;
            	}
        }
        else
        {
        	command("say 你不是古墓派弟子,我不能讓你進去.\n");
        }
}

            
