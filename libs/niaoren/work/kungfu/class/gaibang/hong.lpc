// hong.c 洪七公
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("洪七公", ({"hong qigong", "hong", "qigong"}));
	set("nickname", "九指神丐");
	set("gender", "男性");
	set("age", 75);
	set("long", 
		"他就是丐幫第十七任幫主，號稱“北丐”的洪七公老爺子。\n");
	set("attitude", "peaceful");
	
	set("str", 35);
	set("int", 25);
	set("con", 33);
	set("dex", 24);

	set("chat_chance", 1);
	set("chat_msg", ({
		"洪七公嘆了口氣道：“唉……何時能再吃到蓉兒做的「叫化雞」啊……”\n",
		"洪七公說道：“俗話說「吃在江南」，所以老叫化特地跑來揚州看看。”\n",
		"洪七公喃喃道：“我們丐幫的「降龍十八掌」是天下最霸道的掌法。”\n",
	}));

	set("inquiry", ([
		"青竹林" : "東北西北東西北。\n",
		"丐幫" : "東北西北東西北。\n",
		"拜師" : "你可以去東城門找我幫總舵的魯有腳，拜他為師。\n",
	]));

	set("qi", 4500);
	set("max_qi", 4500);
	set("jing", 2500);
	set("max_jing", 2500);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 300);
	
	set("combat_exp", 2500000);
	set("score", 400000);
	 
	set_skill("force", 250);             // 基本內功
	set_skill("huntian-qigong", 250);    // 混天氣功
	set_skill("unarmed", 250);           // 基本拳腳
	set_skill("xianglong-zhang", 250);   // 降龍十八掌
	set_skill("dodge", 180);      	     // 基本躲閃
	set_skill("xiaoyaoyou", 180);        // 逍遙游
	set_skill("parry", 230);             // 基本招架
	set_skill("staff", 250);             // 基本棍杖
	set_skill("dagou-bang", 250);        // 打狗棒法
	set_skill("begging", 250);           // 叫化絕活
	set_skill("checking", 250);          // 道聽途說
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("parry", "xianglong-zhang");
	map_skill("staff", "dagou-bang");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "staff.da1" :),
                (: perform_action, "unarmed.xi1" :),
                (: perform_action, "unarmed.xi2" :),
                (: perform_action, "unarmed.xi3" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "s1" :),
        }) );
	
	create_family("丐幫", 17, "幫主");

	setup();
        carry_object("/clone/cloth/cloth")->wear();
	carry_object(__DIR__"yuzhu_zhang");
	carry_object(__DIR__"jiaohuaji");
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query_str() < 20 || (int)ob->query_con() < 20) {
		command("say 當叫化子需要能吃苦耐勞，依我看" + RANK_D->query_respect(ob) + "的資質似乎不適合當叫化子？");
		return;
	}

	if ((string)ob->query("family/family_name") != "" &&
	    (string)ob->query("family/family_name") != "丐幫") {
		command("say " + RANK_D->query_respect(ob) + "既然已有名師指點，何必又來拜老叫化呢？");
		return;
	}

	command("recruit " + ob->query("id"));

	if((string)ob->query("class") != "beggar")
		ob->set("class", "beggar");
	
}

int accept_object(object who, object ob)
{
	object ob_yzz, me = this_object();

	if (ob->query("food_supply") <= 0)
		return 0;
	if ((string)ob->query("name") != "叫化雞") {
		command("say 老叫化對" + (string)ob->query("name") + "沒什么興趣……");
		return 0;
	}
	if (query("food") >= max_food_capacity() - ob->query("food_supply")) {
		command("say 老叫化現在飽得很。");
		return 0;
	}
	command("say 啊……這正是我想吃的叫化雞呀！");
	command("eat ji");
	command("say 想不到你小小年紀，心思卻很細，就跟當年的蓉兒一樣！");

	if ((string)ob->query("family/family_name") != "" &&
	    (string)ob->query("family/family_name") != "丐幫") {
		command("say " + RANK_D->query_respect(ob) + "你還呆在這里干什么？");
		return 1;
	}

	if( ob_yzz = present("yuzhu_zhang", me) )
    {
		ob_yzz->move(who);
		write("這根竹杖跟隨我多年了，就送給你作見面禮吧。");
        return 1;
    }

	else
	{
		write("不過你來得不是時候，玉竹杖已經給別人了。");
        return 1;
	}

//	command("recruit " + who->query("id"));
	return 1;
}
