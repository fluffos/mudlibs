// sample master.c code
// xiake island master.c

inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("彭有敬", ({"peng youjing", "peng", "youjing"}));
	set("title", "丐幫九袋長老");
	set("nickname", "掌缽龍頭");
	set("gender", "男性");
	set("age", 50);
	set("long", 
		"彭有敬是丐幫中淨衣派的首領，衣著干淨華麗，不象叫化子。\n"
		"他臉上挂著慈祥的笑容，一雙眼睛有攝人心魄的力量。\n");

	set("attitude", "peaceful");
	
	set("str", 24);
	set("int", 20);
	set("con", 24);
	set("dex", 20);

	set("qi", 900);
	set("max_qi", 900);
	set("jing", 100);
	set("max_jing", 100);
	set("neili", 1300);
	set("max_neili", 1200);
	
	set("combat_exp", 220000);
	set("score", 20000);
	
	set_skill("force", 90);				// 基本內功
	set_skill("huntian-qigong", 90);	// 混天氣功
	set_skill("unarmed", 85);			// 基本拳腳
	set_skill("xianglong-zhang", 80);	// 降龍十八掌
	set_skill("dodge", 105);			// 基本躲閃
	set_skill("xiaoyaoyou", 95);		// 逍遙游
	set_skill("parry", 90);				// 基本招架
	set_skill("staff", 90);				// 基本棍杖
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("parry", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	
	create_family("丐幫", 18, "九袋長老");

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.xi1" :),
		(: perform_action, "unarmed.xi2" :),
		(: perform_action, "unarmed.xi3" :),
		(: exert_function, "re1" :),
		(: exert_function, "s1" :),
		(: exert_function, "p" :),
	}) );

	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	command("say 老夫不收徒弟，" + RANK_D->query_respect(ob) + "還是請回吧。");
}
