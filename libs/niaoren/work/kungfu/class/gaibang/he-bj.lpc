// gaibang npc code

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("何不淨", ({"he bujing", "he", "bujing"}));
	set("title", "丐幫七袋弟子");
	set("gender", "男性");
	set("age", 30);
	set("long", 
		"這是位衣著邋塌，蓬頭垢面的丐幫七袋弟子。\n");
	set("attitude", "heroism");
	set("class", "beggar");
	set("str", 28);
	set("int", 18);
	set("con", 24);
	set("dex", 20);

	set("qi", 380);
	set("max_qi", 380);
	set("max_jing", 300);
	set("neili", 680);
	set("max_neili", 680);
	set("jiali", 34);
	
	set("combat_exp", 90000);
	
	set_skill("force", 70); 
	set_skill("huntian-qigong", 75); 
	set_skill("unarmed", 75); 
	set_skill("xianglong-zhang", 75); 
	set_skill("dodge", 65); 
	set_skill("xiaoyaoyou", 70); 
	set_skill("parry", 93); 
	set_skill("begging", 60); 
	set_skill("stealing", 70); 
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("parry", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.xi1" :),
                (: perform_action, "unarmed.xi2" :),
                (: perform_action, "unarmed.xi3" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "s1" :),
        }) );

	create_family("丐幫", 19, "弟子");
	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if( ob->query("combat_exp") < 30000 ) return;
	command("say 你很愛打架吧？ 哈哈哈，好吧，我就收下你了！");
	command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "beggar")
		ob->set("class", "beggar");
}
#include "/kungfu/class/gaibang/gaibang.h"
