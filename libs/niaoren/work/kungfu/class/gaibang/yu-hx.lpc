// gaibang npc code

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("余洪興", ({"yu hongxing", "yu", "hongxing"}));
	set("title", "丐幫八袋弟子");
	set("gender", "男性");
	set("age", 30);
	set("long", 
		"這是位笑瞇瞇的丐幫八袋弟子，生性多智，外號小吳用。\n");
	set("attitude", "peaceful");
	set("str", 20);
	set("int", 30);
	set("con", 22);
	set("dex", 20);

	set("qi", 420);
	set("max_qi", 420);
	set("jing", 330);
	set("max_jing", 330);
	set("neili", 780);
	set("max_neili", 780);
	
	set("combat_exp", 82000);
	
	set_skill("force", 78); 
	set_skill("huntian-qigong", 76); 
	set_skill("unarmed", 78); 
	set_skill("xianglong-zhang", 80); 
	set_skill("dodge", 90); 
	set_skill("xiaoyaoyou", 88); 
	set_skill("parry", 81); 
	set_skill("begging", 80); 
	set_skill("stealing", 90); 
	set_skill("checking", 70); 
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.xi1" :),
		(: perform_action, "unarmed.xi2" :),
		(: perform_action, "unarmed.xi3" :),
		(: exert_function, "re1" :),
		(: exert_function, "s1" :),
		(: exert_function, "p" :),
	}) );

	create_family("丐幫", 19, "弟子");
	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if( ob->query("int") < 25 ) return;
	command("say 唉，本幫誠信為本，只有七公他老人家和我才特別收些聰明徒兒，");
	command("say 大家都要為長遠著想啊！");
	command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "beggar")
		ob->set("class", "beggar");
}
