// gaibang npc code

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("全冠清", ({"quan guanqing", "quan", "guanqing"}));
	set("title", "丐幫八袋弟子");
	set("gender", "男性");
	set("age", 35);
	set("long", 
		"這是位沉默寡言卻頗有心計的陰毒的丐幫八袋弟子。\n");
	set("attitude", "peaceful");
        set("class", "beggar");
	set("str", 23);
	set("int", 22);
	set("con", 18);
	set("dex", 25);

	set("max_qi", 360);
	set("max_jing", 300);
	set("neili", 710);
	set("max_neili", 710);
	
	set("combat_exp", 69000);
	
	set_skill("force", 75); 
	set_skill("huntian-qigong", 72); 
	set_skill("unarmed", 75); 
	set_skill("xianglong-zhang", 75); 
	set_skill("dodge", 68); 
	set_skill("xiaoyaoyou", 70); 
	set_skill("parry", 70); 
	set_skill("staff", 75); 
	set_skill("begging", 70); 
	set_skill("training", 60);
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.xi1" :),
		(: perform_action, "unarmed.xi2" :),
		(: perform_action, "unarmed.xi3" :),
		(: exert_function, "re1" :),
		(: exert_function, "s1" :),
		(: exert_function, "p" :),
	}) );

	create_family("丐幫", 19, "弟子");
	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if( ob->query("con") < 20 ) return;
	command("say 你拜我為師，可要做好吃苦的准備，好好做個丐幫弟子！");
	command("recruit " + ob->query("id"));
}
#include "/kungfu/class/gaibang/gaibang.h"
