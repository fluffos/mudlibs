// gaibang npc code

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("黎生", ({"li sheng", "li", "sheng"}));
	set("title", "丐幫八袋弟子");
	set("gender", "男性");
	set("age", 38);
	set("long", 
		"這是位生性剛直，嫉惡如仇的丐幫八袋弟子。\n");
	set("attitude", "peaceful");
	set("str", 25);
	set("int", 18);
	set("con", 20);
	set("dex", 23);

	set("max_qi", 390);
	set("max_jing", 300);
	set("neili", 800);
	set("max_neili", 800);
	
	set("combat_exp", 79000);
	
	set_skill("force", 81); 
	set_skill("huntian-qigong", 82); 
	set_skill("unarmed", 85); 
	set_skill("xianglong-zhang", 75); 
	set_skill("dodge", 80); 
	set_skill("xiaoyaoyou", 82); 
	set_skill("parry", 82); 
	set_skill("staff", 80); 
	set_skill("begging", 70); 
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.xi1" :),
                (: perform_action, "unarmed.xi2" :),
                (: perform_action, "unarmed.xi3" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "s1" :),
        }) );

	create_family("丐幫", 19, "弟子");
	setup();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if( ob->query("shen") < 0 ) return;
	command("say 好，有你這樣一等一的人才做我徒弟，我歡喜還來不及呢！");
	command("recruit " + ob->query("id"));
	if((string)ob->query("class") != "beggar")
		ob->set("class", "beggar");
}
