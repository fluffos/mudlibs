// duanyu.c 段譽

#include <ansi.h>

inherit NPC;
int do_test1();
int do_test2();
void create()
{
	set_name("段譽", ({"duan yu", "duan", "yu"}));
	set("nickname", RED"大理王子"NOR);
	set("gender", "男性");
	set("age", 20);
	set("long", 
		"他是一個身穿青衫的年輕男子。臉孔略尖，自有一股書生的呆氣。\n");
	set("attitude", "peaceful");
	
	set("str", 12);
	set("per", 29);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("chat_chance", 2);
	set("chat_msg", ({
		"段譽嘆了口氣道：“唉......何時能再見到語嫣啊......”\n",
		"段譽皺了皺眉，為什么那么多人想拜我為師又不好好學周易？！！\n",
		(: random_move :),
		(: random_move :),
	}));

	set("inquiry", ([
		"大理" : "大理是個好地方，山清水秀，風景宜人。\n",
		"王語嫣" : "唉，她心里只有她表哥，從來就沒把我放在眼里。\n",
		"拜師" : "嗯....，我的師傅是老子、孔子和庄子，他們的學問我還沒學全呢。\n",

	]));

	set("jing", 2000);
	set("max_jing", 2000);
	set("jingli", 2000);
	set("max_jingli", 2000);
	set("qi", 2000);
	set("max_qi", 2000);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali",200);
	
	set("combat_exp", 2500000);
	set("score", 20000);
	 
	set_skill("force", 300);		// 基本內功
	set_skill("beiming-shengong",280);	// 北冥神功
	set_skill("finger", 320);		// 基本指法
	set_skill("sword", 220);		// 基本劍法
	set_skill("liumai-shenjian", 350);	// 六脈神劍
	set_skill("dodge", 250);		// 基本躲閃
	set_skill("lingboweibu", 390);		// 凌波微步
	set_skill("parry", 220);			// 基本招架
	
	map_skill("sword", "liumai-shenjian");
	map_skill("force", "beiming-shengong");
	map_skill("dodge", "lingboweibu");
	map_skill("parry", "liumai-shenjian");
	map_skill("finger", "liumai-shenjian");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "finger.li1" :),
                (: perform_action, "finger.li2" :),
                (: perform_action, "finger.li3" :),
                (: perform_action, "dodge.li1" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );

	prepare_skill("finger","liumai-shenjian");
	create_family("大理段氏", 3, "弟子");
	setup();

        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{	
	int phlye;
	mapping family= ob->query("family"); 

	if (family["family_name"] != "大理段氏")
	{ 
		command("say 我只識周易，這位"+RANK_D->query_respect(ob)+"也想跟我學學么？");
		return ;  
	}
	if(family["generation"]<3
		&&family["family_name"]=="大理段氏")
	{
		command("say 你的輩分那么高，我怎么能收你為徒呢？");
		return;
	}
	if ((int)ob->query("shen") < 20000) {
		command("say 我大理段氏乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if(ob->query_skill("liumai-shenjian",1)<46)
	{
		command("say 你連六脈合使都練不好，拜我又有什么用呢！");
		return;
	}
	command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
}
