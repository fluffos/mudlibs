inherit NPC;
inherit F_MASTER;

string ask_me();
void create()
{
	set_name("段正明", ({"duan zhenming", "duan", "zhenming"}));
	set("title", "大理國保定帝");
	set("gender", "男性");
	set("long", 
	"他就是大理國王，他手里拿著一卷書，看起來一臉仁慈，沒有半點皇帝的架子。\n");
	set("attitude", "friendly");
	set("class", "bonze");
	set("age", 59);
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("qi", 3000);
	set("max_qi", 3000);
	set("jing", 2000);
	set("max_jing", 2000);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 150);
	set("combat_exp", 2900000);
	set("score", 1800000);

	set_skill("force", 230);
	set_skill("tianlong-shengong",240);
	set_skill("dodge", 230);
	set_skill("qingdie-shenfa",210);
	set_skill("yiyang-zhi",250);
	set_skill("sword",210);
	set_skill("parry", 211);
	set_skill("finger", 240);
	set_skill("unarmed",220);
	set_skill("lm-guanchong", 252);
	set_skill("literate", 220);

	map_skill("force", "tianlong-shengong");
	map_skill("parry", "lm-guanchong");
	map_skill("dodge", "qingdie-shenfa");
	map_skill("finger", "lm-guanchong");

	prepare_skill("finger","lm-guanchong");	

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
        }) );

	create_family("大理段氏", 3, "長老");
	setup();
        carry_object("/d/xueshan/obj/y-jiasha")->wear();
}

void attempt_apprentice(object ob)
{
	int flag;
	mapping family= ob->query("family"); 
	flag=0;
	if(sizeof(family)==0)
	{
		command("say 天龍寺不收無名之徒的！");
		return;
	}
	if ( (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏")
	{
		command("say 你這個逆賊，豈能入我門下，貧僧今天就先殺了你以示后人！");
		kill_ob(ob);
		return ;  
	}
	if(ob->query("phlye")!=5)
	{
		command("say "+RANK_D->query_respect(ob)+
			"的根骨到是不錯喲，我也想收你為徒，可是...\n"+
			"目前大理段氏只傳武功給云南人，你還是等下輩子吧！");
		return;
	}
	if(family["generation"]<=this_object()->query("family/generation")
		&&family["family_name"]=="大理段氏")
	{
		command("say 你的輩分不比我低了，我怎么能收你為徒呢？");
		return;
	}

	if ((int)ob->query("shen") < 200000) {
		command("say 我天龍乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if(ob->query_skill("finger",1)<30)
	{
		command("say 我們天龍很重視指力的練習，你的基本指法太低了！");
		flag = 1 ;
	}
	if(ob->query_skill("force",1)<40)
	{
		command("say 內力修為也應該好好重視的，你的基本內功太低了！");
		flag = 1 ;
	}
	if(ob->query_skill("yiyang-zhi",1)<35)
	{
		command("say 一陽指是天龍的一門必修的功夫，你還得多花些功夫！");
		flag = 1 ;
	}
	if(flag)
	{
		command("say 你還是等達到條件后再來找我吧！");
		return;
	}
	command("say 好吧，貧僧就收下你了。");
	command("recruit " + ob->query("id"));
}



