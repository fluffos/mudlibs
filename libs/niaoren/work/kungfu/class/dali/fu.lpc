inherit NPC;

void create()
{
        set_name("傅思歸", ({ "fu sigui", "fu" }));
        set("title", "四大衛護之一");
        set("age", 37);
        set("gender", "男性");
        set("long", "他一身武官打扮，卻扛著一捆柴，上面還有一把板斧，真是怪異。\n");
        set("attitude", "friendly");
        set("str", 30);
        set("dex", 22);
        set("int", 22);
        set("max_force", 500);
        set("force", 500);
        set("force_factor", 10);
        set("SEN", 100);

        set_skill("unarmed", 220);
        set_skill("dodge", 160);
        set_skill("parry", 170);
        set_skill("force", 170);
        set_skill("axe", 190);
        set_skill("tianlong-shengong", 140);
        set_skill("qingdie-shenfa", 150);

        map_skill("dodge", "qingdie-shenfa");
        map_skill("force", "tianlong-shengong");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
        }) );

        create_family("大理段氏", 6, "弟子");
        setup();
        carry_object("/d/dali/npc/obj/junfu")->wear();
        carry_object("/d/dali/npc/obj/axe")->wield();
}

void attempt_apprentice(object ob)
{       
        int phlye,nf;
        mapping family= ob->query("family"); 
        phlye= (int)ob->query("phlye");
        if(!pointerp(family))
                nf=1;
        else
                nf=0;
        if(phlye!=5)
        {
                command("say "+RANK_D->query_respect(ob)+
                        "的根骨到是不錯喲，我也想收你為徒，可是...\n"+
                        "目前大理段氏只傳武功給云南人，你還是等下輩子吧！");
                return;
        }
        if ( !nf&&(int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏")
        { 
                command("say 你這個逆賊，豈能入我門下，我今天就先殺了你以示后人！");
                kill_ob(ob);
                return ;  
        }
        if(!nf&&family["generation"]>=this_object()->query("family/generation")
                &&family["family_name"]=="大理段氏")
        {
                command("say 你的輩分不比我低了，我怎么能收你為徒呢？");
                return;
        }
        if ((int)ob->query("shen") < 0) {
                command("say 我大理段氏乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("recruit " + ob->query("id"));
}


