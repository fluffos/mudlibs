// /d/dali/npc/zhu.c 僬讀漁耕四大護法之“書”──朱丹臣

inherit NPC;
inherit F_MASTER;

string ask_me();
void create()
{
	set_name("朱丹臣", ({ "zhu danchen","zhu","shusheng","danchen"}) );
	set("gender", "男性" );
	set("title", "中年書生");
	set("class", "bonze");
	set("age", 34);
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("qi", 1200);
	set("max_qi", 1500);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 150);
	set("combat_exp", 800000);
	set("score", 1000000);

	set_skill("force", 140);
	set_skill("tianlong-shengong", 150);
	set_skill("dodge", 160);
	set_skill("qingdie-shenfa",143);
	set_skill("parry", 179);
	set_skill("sword",133);
	set_skill("finger", 149);
	set_skill("literate", 290);
	set_skill("yiyang-zhi",147);

	map_skill("finger","yiyang-zhi");
	map_skill("dodge","qingdie-shenfa");
	map_skill("force", "tianlong-shengong");

	prepare_skill("finger","yiyang-zhi");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
        }) );

	set("inquiry" ,([
		"六脈神劍譜" : "“你不會是打什么主意吧？”\n",
		"六脈神劍" :  "“你不會是想和我較量較量吧？”\n",
		"四大護衛" : (: ask_me :),
	]));
	create_family("大理段氏", 6, "弟子");
	setup();
}

string ask_me()
{
	set("title","四大護衛之一");
	return "呵呵！你怎么知道我的身份的？想來你對大理段家比較熟悉嘛！\n";
}

int recognize_apprentice(object ob)
{
	if(ob->query("family/family_name")=="大理段氏")
		return 1;
	return 0;
}
int is_apprentice_of(object ob)
{
	return recognize_apprentice(ob);
}

void attempt_apprentice(object ob)
{	
	int phlye,nf;
	mapping family= ob->query("family"); 
	nf=0;
	if(!pointerp(family))
		nf=1;
	phlye= (int)ob->query("phlye");
	if(phlye!=5)
	{
		if(ob->query("shen")<200000)
		{
			command("say "+RANK_D->query_respect(ob)+
			"的根骨到是不錯喲，我也想收你為徒，可是...\n"+
			"目前大理段氏只傳武功給云南人，何況你的劣跡太多了，你還是問問自己\n"+
			"夠不夠資格成為大理段氏的一員吧！");
			return;
		}
		command("say 我看這位"+RANK_D->query_respect(ob)+"到是一位俠義中人，就收下你吧！");
		if(ob->query("phlye")!=5)
			command("say 不過你從此就變為云南人氏了喲！");
		ob->set("phlye",5);
		command("recruit " + ob->query("id"));
		return;
	}
	if (!nf&& (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏")
	{ 
		command("say 你這個逆賊，豈能入我門下，我今天就先殺了你以示后人！");
		kill_ob(ob);
		return ;  
	}
	if(!nf&&family["generation"]<=this_object()->query("family/generation")
		&&family["family_name"]=="大理段氏")
	{
		command("say 你的輩分不比我低了，我怎么能收你為徒呢？");
		return;
	}
	if ((int)ob->query("shen") < 0) {
		command("say 我大理段氏乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
}

int accept_object(object me, object ob)
{
	if(me->query_skill("literate",1)>60)
	{
	message_vision("朱丹臣呵呵地笑了笑，你的讀書識字水平已經夠高了，小的水平無法教你！\n",me);
	return 0;
	}
	if (ob->query("money_id") && ob->value() < 2000000)
	{
		message_vision("朱丹臣對$N搖搖頭說：讀書識字得二百兩黃金。\n", me);
		return 0;
	}

	message_vision("朱丹臣點了點頭，你什么時間有空就可以來"+
		"我這里學(xue/learn)點讀書識字的本領了。\n", me);
	me->set("jackyboy/xue_from_zhu", 1);
	add_action("do_xue","xue");
	add_action("do_xue","learn");
	return 1;
}

void init()
{
	object me;
	me=this_player(1);
	if(me->query("jackyboy/xue_from_zhu")==1)
	{
		add_action("do_xue","xue");
		add_action("do_xue","learn");
	}
}

int do_xue(string arg)
{
	object ob,me;
	int gin_cost,grade,my_combat_exp,my_skill;
	string teacher,skill;
	if(!arg||arg=="")
		return notify_fail("指令格式：learn|xue <某人> <技能>\n");
	ob=this_object();
	me=this_player(1);
	if(me->query("jackyboy/xue_from_zhu")!=1)//只有交過錢才可能用xue這個命令！
		return notify_fail("朱丹臣笑了笑，孺子可教，已經這么高的水平了依然不忘了學習！"+
			"\n不過你已經從我這里畢業了，我的水平是不能再教你了，你還是另請高就吧！\n");
	if(sscanf(arg,"%s %s",teacher,skill)!=2)
		return 0;
	if(member_array(teacher,ob->parse_command_id_list())==-1)
		return 0;
	if(skill!="literate")
		return 0;
	if( me->is_fighting() )
		return notify_fail("臨陣磨槍？來不及啦。\n");
	if( !living(ob) )
		return notify_fail("嗯....你得先把" + ob->name() + "弄醒再說。\n");
	if( !SKILL_D(skill)->valid_learn(me) ) return SKILL_D(skill)->valid_learn(me);

	gin_cost = 150 / (int)me->query("int") + 1;
	if( (int)me->query("learned_points") >= (int)me->query("potential") )
		return notify_fail("你的潛能已經發揮到極限了，沒有辦法再成長了。\n");
	printf("你向%s請教有關「%s」的疑問。\n", ob->name(), to_chinese(skill));
	my_combat_exp = (int)me->query("combat_exp");
	if(my_combat_exp < 10000)
		grade = 1;
	else if(my_combat_exp < 80000)
		grade = 3;
	else if(my_combat_exp < 500000)
		grade = 7;
	else
		grade = 13;
	if ( grade < 1 )
		grade = 1;
	if( !(my_skill=me->query_skill(skill,1)) ) 
	{
		gin_cost *= 2;
		me->set_skill(skill,0);
	}
	if((int)me->query("jing") > gin_cost )
	{
		if( (string)SKILL_D(skill)->type()=="martial"
		&&	my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) {
			printf("也許是缺乏實戰經驗，你對%s的回答總是無法領會。\n", ob->name() );
		}
		else
		{
			printf("你聽了%s的指導，似乎有些心得。\n", ob->name());
			me->add("learned_points", 1);
			me->improve_skill(skill, grade * (10 + random((int)me->query("int") - 9)));
		}
	}
	else
	{
		gin_cost = me->query("jing");
		write("你今天太累了，結果什么也沒有學到。\n");
	}
	me->receive_damage("jing", gin_cost );

	if( me->query_skill("literate",1) > 60)
	{
		me->delete("jackyboy/xue_from_zhu");
	message_vision("朱丹臣雙手做了個揖，對$N說道：你已經學業有成，可以畢業了！呵呵。\n",me);
	}
	return 1;
}
