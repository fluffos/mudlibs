inherit NPC;
string ask_me();
void create()
{
        set_name("枯榮大師", ({ "ku rong","ku"}) );
        set("gender", "男性" );
        set("class", "bonze");
        set("age", 100);
        set("shen_type", 1);
        set("str", 40);
        set("int", 40);
        set("con", 40);
        set("dex", 40);

        set("qi", 3000);
        set("max_qi", 3000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 150);
        set("combat_exp", 3500000);
        set("score", 1000000);

        set_skill("force", 350);
        set_skill("dodge", 340);
        set_skill("parry", 350);
        set_skill("finger", 365);
        set_skill("sword", 360);
        set_skill("qingdie-shenfa", 370);
        set_skill("tianlong-shengong",360);
        set_skill("kurong-shengong", 370);
        set_skill("lm-shaoshang", 260);
        set_skill("literate", 360);

        map_skill("force", "tianlong-shengong");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("parry", "lm-shaoshang");
        map_skill("finger", "lm-shaoshang");

        prepare_skill("finger","lm-shaoshang"); 

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
        }) );
        
        set("inquiry" ,([
        "六脈神劍" : (: ask_me :),
        "六脈神劍譜" : (: ask_me :),
        "六脈神劍劍譜" : (: ask_me :),
        ]));
        create_family("大理段氏", 2, "元老");
        setup();
        carry_object("/d/xueshan/obj/y-jiasha")->wear();
}

string ask_me()
{
        object me;
        string str;
        me=this_player(1);
        if(me->query("jackyboy/xue_from_kurong")==1)
        {
                if(me->query_skill("lm-shaoshang",1)<50)
                        str="你的少商劍火候還沒到!\n";
                if(me->query_skill("lm-shangyang",1)<50)
                        str+="你的商陽劍火候還沒到!\n";
                if(me->query_skill("lm-shaoze",1)<50)
                        str+="你的少澤劍火候還沒到!\n";
                if(me->query_skill("lm-guanchong",1)<50)
                        str+="你的關沖劍火候還沒到!\n";
                if(me->query_skill("lm-shaochong",1)<50)
                        str+="你的少沖劍火候還沒到!\n";
                if(me->query_skill("lm-zhongchong",1)<50)
                        str+="你的中沖劍火候還沒到!\n";
                if(strlen(str)>20)
                        return str;
                new("/d/dali/tianlongsi/obj/liumai-jianpu")->move(me);
                return "哈哈！老衲終于覓得一位可造之材！這本劍譜你拿去吧，希望你能早日把六脈\n"+
                        "合用的功夫練成。\n";
        }
        if(me->query("family/family_name")!="大理段氏")
        {
                if(me->query("class")!="bonze")
                        return "這位施主意欲何為？難道你也想象那個番僧一樣毫奪強取？\n";
                return "大家都是佛門中人，自當清心寡欲，怎么你也對這些塵世中物如此感興趣？\n";
        }
        me->set("jackyboy/xue_from_kurong",1);
        return RANK_D->query_respect(me)+"也想學這門武功？好！不過你得把六脈都學全了才可以讀\n"+
                "這本劍譜，不然會走火入魔，命喪黃泉的！從今天起，你就先跟著老衲把少商劍學好吧！\n";
}

void init()
{
        object me;
        me=this_player(1);
        if(me->query("jackyboy/xue_from_kurong")==1)
        {
                add_action("do_xue","xue");
                add_action("do_xue","learn");
        }
}

int do_xue(string arg)
{
        object ob,me;
        int gin_cost,grade,my_combat_exp,my_skill;
        string teacher,skill;
        ob=this_object();
        me=this_player(1);
        if(me->query("jackyboy/xue_from_zhu")!=1)
                return notify_fail("枯榮笑了笑，說：你的少商劍已經小有成就了！\n");
        if(sscanf(arg,"%s %s",teacher,skill)!=2)
                return 0;
        if(member_array(teacher,ob->parse_command_id_list())==-1)
                return 0;
        if(skill!="lm-shaoshang")
                return 0;
        if( me->is_fighting() )
                return notify_fail("臨陣磨槍？來不及啦。\n");
        if( !living(ob) )
                return notify_fail("嗯....你得先把" + ob->name() + "弄醒再說。\n");
        if( !SKILL_D(skill)->valid_learn(me) ) return SKILL_D(skill)->valid_learn(me);

        gin_cost = 150 / (int)me->query("int") + 1;
        if( (int)me->query("learned_points") >= (int)me->query("potential") )
                return notify_fail("你的潛能已經發揮到極限了，沒有辦法再成長了。\n");
        printf("你向%s請教有關「%s」的疑問。\n", ob->name(), to_chinese(skill));
        my_combat_exp = (int)me->query("combat_exp");
        if(my_combat_exp < 10000)
                grade = 1;
        else if(my_combat_exp < 80000)
                grade = 3;
        else if(my_combat_exp < 500000)
                grade = 7;
        else
                grade = 13;
        if ( grade < 1 )
                grade = 1;
        if( !(my_skill=me->query_skill(skill,1)) ) 
        {
                gin_cost *= 2;
                me->set_skill(skill,0);
        }
        if((int)me->query("jing") > gin_cost )
        {
                if( (string)SKILL_D(skill)->type()=="martial"
                &&      my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) {
                        printf("也許是缺乏實戰經驗，你對%s的回答總是無法領會。\n", ob->name() );
                }
                else
                {
                        printf("你聽了%s的指導，似乎有些心得。\n", ob->name());
                        me->add("learned_points", 1);
                        me->improve_skill(skill, grade * (10 + random((int)me->query("int") - 9)));
                }
        }
        else
        {
                gin_cost = me->query("jing");
                write("你今天太累了，結果什么也沒有學到。\n");
        }
        me->receive_damage("jing", gin_cost );

        if( me->query_skill("lm-shaoshang",1) > 50)
        {
                me->delete("jackyboy/xue_from_zhu");
                message_vision("枯榮雙手合十，對$N說道：你已經把少商劍學得差不多了。\n",me);
        }
        return 1;
}

void attempt_apprentice(object ob)
{
        int flag;

        mapping family= ob->query("family"); 
        flag = 0;
        if ( (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏")
        { command("say 你這個逆賊，豈能入我門下，貧僧今天就先殺了你以示后人！");
          kill_ob(ob);
         return ;  
        }
        if(ob->query("phlye")!=5)
        {
                command("say "+RANK_D->query_respect(ob)+
                        "的根骨到是不錯喲，我也想收你為徒，可是...\n"+
                        "目前大理段氏只傳武功給云南人，你還是等下輩子吧！");
                return;
        }
        if(family["generation"]!=(this_object()->query("family/generation")+2)
                &&family["family_name"]=="大理段氏")
        {
                command("say 我只從天龍第四代弟子中挑選人材的，我不能收你為徒了？");
                return;
        }
        if ((int)ob->query("shen") < 200000) 
        {
                command("say 我天龍乃是堂堂名門正派，對弟子要求極嚴。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        if(ob->query_skill("finger",1)<80)
        {
                command("say 你的基本指法太低了！");
                flag = 1 ;
        }
        if(ob->query_skill("force",1)<90)
        {
                command("say 內力修為也應該好好重視的，你的基本內功太低了！");
                flag = 1 ;
        }
        if(ob->query_skill("yiyang-zhi",1)<80)
        {
                command("say 一陽指是天龍的一門必修的功夫，你還得多花些功夫！");
                flag = 1 ;
        }
        if(flag)
                return;
        command("say 好吧，貧僧就收下你了。");
        command("recruit " + ob->query("id"));
}
