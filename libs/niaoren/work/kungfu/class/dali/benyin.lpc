inherit NPC;
inherit F_MASTER;

string ask_me();
void create()
{
	set_name("本因", ({ "ben yin","yin"}) );
	set("gender", "男性" );
	set("title", "天龍寺主持");
	set("class", "bonze");
	set("age", 70);
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("qi", 3500);
	set("max_qi", 3500);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 150);
	set("combat_exp", 2800000);
	set("score", 1000000);

	set_skill("force", 240);
	set_skill("tianlong-shengong",260);
	set_skill("dodge", 230);
	set_skill("qingdie-shenfa",230);
	set_skill("sword",230);
	set_skill("yiyang-zhi",250);
	set_skill("parry", 220);
	set_skill("finger", 285);
	set_skill("unarmed", 220);
	set_skill("lm-shangyang", 260);
	set_skill("literate", 220);

	map_skill("force", "tianlong-shengong");
	map_skill("parry", "lm-shangyang");
	map_skill("dodge", "qingdie-shenfa");
	map_skill("finger", "lm-shangyang");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
        }) );

	prepare_skill("finger","lm-shangyang");	
	set("inquiry" ,([
	"舍利子" : (:ask_me():),
	"六脈神劍譜" : "“施主不會是打什么主意吧？”\n",
	"六脈神劍" :  "“施主不會是想和我較量較量吧？”\n",
	]));
	create_family("大理段氏", 3, "主持");
	setup();
        carry_object("/d/xueshan/obj/y-jiasha")->wear();
}

string ask_me()
{
	object me=this_player();
	if(me->query_temp("marks/ask_temp0"))
		{
		me->set_temp("marks/ask_temp1",1);
		return "“那是本寺的鎮寺之寶，多年以前不慎丟失。施主如能找回此物，\n         老衲必有重謝。”\n";
		}
	else
		return "“施主不可妄言。”\n";
}

int accept_object(object who, object ob)
{
	if (  (string)ob->query("name") == "錦盒")
	{
		message_vision("本因大喜道：“多謝施主！施主若是有緣人，請到牟尼堂取本寺之寶。\n", who);
		who->set_temp("marks/find_temp",1);
		who->move("/d/dali/tianlongsi/banruotai");
		return 1;
		}
	return 0;
}
void attempt_apprentice(object ob)
{
	int flag,gn;
	mapping family;

	flag = 0;
	family=ob->query("family");
	if(sizeof(family)==0)
	{
		command("say 我可不受無名之徒！\n");
		return;
	}
	if ( (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏")
	{ command("say 你這個逆賊，豈能入我門下，貧僧今天就先殺了你以示后人！");
	  kill_ob(ob);
	 return ;  
	}
	if(family["generation"]<=this_object()->query("family/generation")
		&&family["family_name"]=="大理段氏")
	{
		command("say 你的輩分不比我低了，我怎么能收你為徒呢？");
		return;
	}

	if(ob->query("phlye")!=5)
	{
		command("say "+RANK_D->query_respect(ob)+
			"的根骨到是不錯喲，我也想收你為徒，可是...\n"+
			"目前大理段氏只傳武功給云南人，你還是等下輩子吧！");
		return;
	}
	if ((int)ob->query("shen") < 200000) 
	{
		command("say 我天龍乃是堂堂名門正派，對弟子要求極嚴。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否還做得不夠？");
		return;
	}
	if(ob->query_skill("finger",1)<50)
	{
		command("say 我們天龍很重視指力的練習，你的基本指法太低了！");
		flag = 1 ;
	}
	if(ob->query_skill("force",1)<60)
	{
		command("say 內力修為也應該好好重視的，你的基本內功太低了！");
		flag = 1 ;
	}
	if(ob->query_skill("yiyang-zhi",1)<40)
	{
		command("say 一陽指是天龍的一門必修的功夫，你還得多花些功夫！");
		flag = 1 ;
	}
	if(ob->query_skill("tianlong-shengong",1)<40)
	{
		command("say 天龍神功都沒練好，做我的徒弟你的資格還遠遠不夠哪！");
		flag = 1;
	}
	if(flag)
	{
		command("say 你還是等達到條件后再來找我吧！");
		return;
	}
	command("say 好吧，貧僧就收下你了。");
	command("recruit " + ob->query("id"));
}
