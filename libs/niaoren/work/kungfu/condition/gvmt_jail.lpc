#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration)
{
	if (duration < 1) {
		me->move("/wizhome/sharkhome/jyguan/guangchang");
		message("vision",
			HIY "只聽乒地一聲，你嚇了一跳，定睛一看，\n"
			"原來是一個昏昏沉沉的家伙從大門里被扔了出來！\n" NOR, environment(me), me);
		tell_object(me, HIY "只覺一陣騰云駕霧般，你昏昏沉沉地被扔出了牢城營！\n" NOR);
		me->set("startroom", START_ROOM);
		return 0;
	}
//	tell_object(me, "debug: " + duration + " beats more to go...\n");
	me->apply_condition("gvmt_jail", duration - 1);
	return 1;
}
