// linji_youming.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
        if( duration == 2 )
        {
                tell_object(me,
  HIB "忽然你覺得雙手拿不住東西，原來你的
  幽冥庄收功了！\n" NOR );
                  me->add("str", 0 - me->query("linji/str"));
        }
        if( duration == 0 )
        {
                  me->delete("linji/str");
                  return 0;
        }
          me->apply_condition("linji_youming", duration - 1);
        return CND_CONTINUE;
}
