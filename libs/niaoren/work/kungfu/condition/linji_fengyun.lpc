// linji_fengyun.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
	if( duration == 2 )
	{
		tell_object(me, 
HIB "忽然你覺得一股濁氣自腰間猛向下沉去，頓時雙足如灌鉛般沉
重，原來你的風云庄收功了！\n" NOR );
		me->add("dex", 0 - me->query("linji/dex"));
	}
	if( duration == 0 )
	{
		me->delete("linji/dex");
		return 0;
	}
	me->apply_condition("linji_fengyun", duration - 1);
	return CND_CONTINUE;
}
