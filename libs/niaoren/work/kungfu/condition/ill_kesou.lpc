// ill_kesou.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   if( duration < 1 ) return 0;
   if( !living(me) ) {
      message("vision", me->name() + "嘶啞著嗓子咳了兩聲，看來是病了。\n", environment(me), me);
   }
   else {
      tell_object(me, HIB "你嘶啞著嗓子咳了兩聲，然后又連續咳了好一陣，看來是病了不輕！\n" NOR );
      message("vision", me->name() + "的身子弓著身子晃了兩晃，嘶啞著嗓子咳了兩聲，看來是病了。\n",
            environment(me), me);
   }
   me->receive_wound("qi", 1);
   me->receive_damage("qi", 1);
   me->apply_condition("ill_kesou", duration - 1);

   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}
