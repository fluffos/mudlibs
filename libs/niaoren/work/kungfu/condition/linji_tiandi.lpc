// linji_tiandi.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
	if( duration == 1 )
	{
		tell_object(me,
HIB "忽然你心里頭感到一陣失落，原來你的天地庄收功了，你頓時
倍感紅顏老去之嘆！\n" NOR );
		me->add("per", 0 - me->query("linji/per"));
	}
	if( duration == 0 )
	{
		me->delete("linji/per");
		return 0;
	}
	me->apply_condition("linji_tiandi", duration - 1);
	return CND_CONTINUE;
}
