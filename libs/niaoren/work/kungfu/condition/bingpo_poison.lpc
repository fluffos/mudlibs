// bingpo_poison.c 冰魄銀針毒
// By Kayin @ CuteRabbit Studio 1999/3/25 new

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   if( duration < 1 ) return 0;
   if( !living(me) ) {
      message("vision", me->name() + "痛苦地哼了一聲。\n", environment(me), me);
   }
   else {
      tell_object(me, HIB "突然一陣奇寒襲來，你中的"HIW"冰魄銀針"HIB"毒發作了！\n" NOR );
      message("vision", me->name() + "漸漸臉色鐵青,全身發紫,看來中毒已經很深了。\n",
            environment(me), me);
   }
      me->receive_wound("qi",25 + random(50));
      me->receive_wound("jing", 30);
      me->apply_condition("bingpo_poison", duration - 1);
      if ( (int)me->query_temp("powerup") ) 
         { me->add_temp("apply/attack", - (int)(me->query_skill("force")/3));
	     me->add_temp("apply/dodge", - (int)(me->query_skill("force")/3));
	     me->delete_temp("powerup");  }

   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}
