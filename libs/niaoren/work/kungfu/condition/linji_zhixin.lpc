// linji_zhixin.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
	if( duration == 2 )
	{
		tell_object(me,
HIB "忽然你頭腦里感到一陣空白，原來你的之心庄收功了，你頓時
覺得自己還是個大笨木瓜！\n" NOR );
		me->add("int", 0 - me->query("linji/int"));
	}
	if( duration == 0 )
	{
		me->delete("linji/int");
		return 0;
	}
	me->apply_condition("linji_zhixin", duration - 1);
	return CND_CONTINUE;
}
