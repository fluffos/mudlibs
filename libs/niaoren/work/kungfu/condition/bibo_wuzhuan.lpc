// bibo_wuzhuan.c
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
        if( duration == 0 )
        {
        tell_object(me,
  HIB "忽然你覺得再也駕馭不住天地真氣，
  你奇門五轉收功了！\n" NOR );
                  me->delete("bibo/wuzhuan");
                  return 0;
        }
        me->apply_condition("bibo_wuzhuan", duration - 1);
        return CND_CONTINUE;
}
