#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int i, attack_time;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("狂風暴雨只能對戰斗中的對手使用。\n");
//        if(!me->query("family") || (me->query("family/family_name")!="dark派"))
//             return notify_fail("你不是dark派的，你不能用特攻?\n");
	if (!objectp(weapon = me->query_temp("weapon"))
                    || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不對。\n");
	if( (int)me->query_skill("skykill", 1) < 40 )
		return notify_fail("你的驚天六絕殺不夠嫻熟，不會使用狂風暴雨。\n");
	msg = HIY "$N使出"HIC"驚天六絕殺"NOR"之"HIM"狂"HIC"風"HIB"暴"HIY"雨"NOR"，招式陡然變快。\n";
              if( random(me->query("combat_exp")*10) > (int)target->query("combat_exp")/10)
	{
                  attack_time = random((int)me->query_skill("skykill", 1))/10;
		if(attack_time < 1)
			attack_time = 1;
		msg += CYN " 結果$p被$P攻了個措手不及！\n" NOR;
		for(i = 0; i < attack_time; i++)
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
                  me->start_busy(0);
		me->add("neili", -100);
	}
	else
	{
		msg += "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
		me->start_busy(0);
	}
	message_vision(msg, me, target);
	return 1;
}
