mapping *action = ({
([  "action" : "$N屏息靜氣，手起一掌「輕煙裊裊」，輕輕柔柔地拍向$n",
    "force"  : 130,
    "dodge"  : 20,
	"damage" : 0,
    "lvl"    : 0,
	"skill_name" : "輕煙裊裊",
	"damage_type" : "瘀傷"
]),
([  "action" : "$N輕輕淺笑，繞到$n身后，左手做勢溫柔輕擁$n腰間。$n蹙
眉急躲，$N右手一招「煙霧繚繞」，無聲無息向$n的$l拍到",
    "force"  : 150,
    "dodge"  : 20,
	"damage" : 30,
    "lvl"    : 20,
	"skill_name" : "煙霧繚繞",
	"damage_type" : "內傷"
]),
([  "action" : "$N一招「煙海云濤」，雙掌幻化出一片掌影，如一陣輕煙，
將$n細細密密地籠罩于內",
    "force"  : 150,
    "dodge"  : 30,
	"damage" : 45,
    "lvl"    : 40,
	"skill_name" : "煙海云濤",
	"damage_type" : "瘀傷"
]),

([  "action" : "$N返身越出圈外，回首一招「云煙渺渺」，遠遠地向$n的$l
輕輕拍出兩掌，掌風刮到，陡然變盛直讓$n呼不出氣來",
    "force"  : 200,
    "dodge"  : 25,
	"damage" : 55,
    "lvl"    : 60,
	"skill_name" : "云煙渺渺",
    "damage_type" : "瘀傷"
]),
([  "action" : "$N左掌從右掌內圍翻出，輕飄飄地向$n拍去，看到$n起手招
架，右掌卻自胸口疾速圈出，一招「煙霧彌漫」，趕超左掌，拍向$n的$l",
    "force"  : 250,
    "dodge"  : 70,
	"damage" : 10,
    "lvl"    : 80,
	"skill_name" : "煙霧彌漫",
    "damage_type" : "瘀傷"
]),
([  "action" : "$N雙掌齊推，振起一陣勁風，一招「煙消云散」在一丈開外
擊向$n",
    "force"  : 300,
    "dodge"  : 20,
	"damage" : 90,
    "lvl"    : 100,
	"skill_name" : "煙消云散",
    "damage_type" : "瘀傷"
]),
});

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_combine(string combo) { return combo=="jinyu-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練五羅輕煙掌必須空手。\n");
	if ((int)me->query_skill("kurong-changong",1) < 20)
		return notify_fail("你的枯榮禪功太弱，無法練五羅輕煙掌。\n");
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力太弱，無法練五羅輕煙掌。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
    level = (int) me->query_skill("wuluo-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的內力不夠練五羅輕煙掌。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}


