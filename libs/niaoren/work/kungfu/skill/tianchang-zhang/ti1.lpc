// 奪錘式
#include <ansi.h>
inherit F_SSERVER;
int perform(object me)
{
	string msg;
	object weapon, weapon2, target;
	int skill, ap, dp, damage;
	me->clean_up_enemy();
	target = me->select_opponent();
	skill = me->query_skill("tianchang-zhang",1);
	if( !(me->is_fighting() ))
		return notify_fail("「奪錘式」只能對戰斗中的對手使用。\n");
	if (!objectp(weapon2 = target->query_temp("weapon"))
	|| (string)weapon2->query("skill_type") != "hammer")
		return notify_fail("對方沒有使鋼鞭、鐵錘，你用不了「奪錘式」。\n");
	if( skill < 50)
		return notify_fail("你的天長掌法等級不夠, 不能使用「奪錘式」！\n");
	if( me->query("neili") < 50 )
		return notify_fail("你的內力不夠，無法運用「奪錘式」！\n");
	msg = HIC "$N巧使天長掌法「奪錘式」逼近$n，雙手幻出重重掌影，如柔絲般向$n裹去。\n";
	message_vision(msg, me, target);
	damage = 10 + random(skill / 2);
	ap = me->query_skill("unarmed") + skill;
	dp = target->query_skill("hammer") / 2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp)
	{
		if(userp(me))
			me->add("neili",-50);
		msg = "$n頓時覺得壓力驟增，手腕一麻，手中";
		msg += weapon2->name();
		msg += "脫手而出！\n" NOR;
		target->receive_damage("qi", damage);
		target->start_busy(2);
		weapon2->move(environment(me));
        }
	else
	{
		if(userp(me))
			me->add("neili",-30);
		msg = "可是$n看破了$N的掌影，立刻采取守勢，使$N的奪錘式沒有起到作用。\n"NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
