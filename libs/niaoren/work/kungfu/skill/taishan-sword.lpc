#include <ansi.h>

inherit SKILL;

mapping *action = ({
([      "name":    "岱宗如何",
        "action":  "$N右手$w斜指而下，左手五指正在屈指而數，從一數到五，握而成拳，又
將拇指伸出，次而食指，終至五指全展，跟著又屈拇指而屈食指，再屈中
指，然后手中$w劍光暴長，向$n的$l刺去",
        "dodge":    50,
        "damage":  170,
        "damage_type":  "刺傷"
]),
([      "name":    "朗月無云",
        "action":  "$N手中$w一晃，向右滑出三步，一招“朗月無云”，轉過身來，身
子微矮，$w向$n斜斜刺去",
        "dodge":   -70,
        "damage":  120,
        "damage_type":  "刺傷"
]),
([      "name":    "峻嶺橫空",
        "action":  "$N手中$w圈轉，一招「峻嶺橫空」去勢奇疾，無數劍光刺向$n的$l",
        "dodge":   -40,
        "damage":   90,
        "damage_type":  "刺傷"
]),
([      "name":    "泰山十八盤",
        "action":  "$N展開劍勢，身隨劍走，左邊一拐，右邊一彎，越轉越急。猛地
$w劍光暴長，一招「泰山十八盤」往$n$l刺去",
        "dodge":   -40,
        "damage":  140,
        "damage_type":  "刺傷"
]),
([      "name":    "五大夫劍",
        "action":  "$N手中$w倏地刺出，一連五劍，每一劍的劍招皆蒼然有古意。招數
古朴，內藏奇變，正是「五大夫劍」",
        "dodge":   60,
        "damage":  220,
        "damage_type":  "刺傷"
]),
});

int valid_learn(object me)
{
    object ob;
//   if( (string)me->query("gender") != "女性" )
//   return notify_fail("九陰赤煉劍法是只有女子才能練的武功。\n");
    if( (int)me->query("max_neili") < 50 )
        return notify_fail("你的內力不夠，沒有辦法練泰山劍法。\n");
//   if( (string)me->query_skill_mapped("force")!= "zixia-shengong")
//        return notify_fail("華山劍法必須配合紫霞神功才能練。\n");
    if( !(ob = me->query_temp("weapon"))
    ||      (string)ob->query("skill_type") != "sword" )
        return notify_fail("你必須先找一把劍才能練劍法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30
    ||      (int)me->query("neili") < 5 )
        return notify_fail("你的內力或氣不夠，沒有辦法練習泰山劍法。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -5);
    write("你按著所學練了一遍泰山劍法。\n");
    return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

string perform_action_file(string action)
{
        return __DIR__"taishan-sword/" + action;
}
