([	"action" : "$N一式「一柱擎天」，神情突然變得很嚴肅，右手中指戳向$n的胸腹間",
	"force" : 60,
        "dodge" : -5,
        "parry" : -5,
	"damage": 10,
	"lvl" : 0,
	"weapon" : "無形劍氣",
	"damage_type" : "刺傷"
]),
([	"action" : "$N左掌護胸，一式「青松迎客」，中指划了個半弧，猛地一甩，疾點$n的$l",
	"force" : 120,
        "dodge" : 5,
        "parry" : 10,
	"damage": 20,
	"lvl" : 10,
	"weapon" : "無形劍氣",
        "damage_type" : "刺傷"
]),
([	"action" : "$N身形閃動，一式「魂飛九天」，中指端部射出一股劍氣，直射$n的要穴",
	"force" : 180,
        "dodge" : 10,
        "parry" : 20,
	"damage": 30,
	"lvl" : 20,
	"weapon" : "無形劍氣",
        "damage_type" : "刺傷"
]),
([	"action" : "$N盤膝跌坐，一式「遙點蒼山」，左手握拳托肘，右手中指遙遙對著$n一捺",
	"force" : 240,
        "dodge" : 20,
        "parry" : 30,
	"damage": 40,
	"lvl" : 30,
	"weapon" : "無形劍氣",
        "damage_type" : "刺傷"
]),
([	"action" : "$N忽地躍起，左掌撫胸，伸出右手中指，一式「普渡眾生」緩緩向$n頭頂百匯穴點去",
	"force" : 300,
        "dodge" : 30,
        "parry" : 40,
	"damage": 50,
	"lvl" : 40,
	"weapon" : "無形劍氣",
        "damage_type" : "刺傷"
]),
([	"action" : "$N一式「雙香臨風」，出指舒緩自如，對著$n一捺",
	"force" : 360,
	"dodge" : 40,
	"parry" : 50,
	"damage": 60,
	"lvl" : 50,
	"weapon" : "無形劍氣",
	"damage_type" : "刺傷"
]),
([	"action" : "$N手臂顫動，有如輕風吹過，一招「鳳蝶拈花」，拂遍$n全身諸穴",
	"force" : 420,
	"dodge" : 40,
	"parry" : 50,
	"damage": 70,
	"lvl" : 60,
	"weapon" : "無形劍氣",
	"damage_type" : "刺傷"
]),
([	"action" : "$N倏忽之間欺近身去，一招「茶花初放」點向$n，一攻而退，靈動無比",
	"force" : 480,
        "dodge" : 60,
        "parry" : 60,
	"damage": 90,
	"lvl" : 80,
	"weapon" : "無形劍氣",
        "damage_type" : "刺傷"
]),
});

int valid_enable(string usage) { return usage=="finger" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練中沖劍必須空手。\n");
	if ((int)me->query("max_neili") < 150)
		return notify_fail("你的內力太弱，無法練中沖劍。\n");
	if (me->query_skill("liumai-shenjian",1)>0)
		return notify_fail("你連六脈合并都能使用了，還想獨練一劍？\n");
	if ((int)me->query_skill("yiyang-zhi",1)<50)
		return notify_fail("你的一陽指力還不夠！先練好一陽指吧。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("lm-zhongchong", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[random(i)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 30)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("force") < 20)
		return notify_fail("你的內力不夠了。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

int enable_factor() { return 20; }

int learn_bonus() { return 10; }

int practice_bonus() { return 10; }

int study_bonus() { return 10; }
