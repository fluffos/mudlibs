// qudu.c

#include <ansi.h>

int exert(object me, object target)
{
	int con1, con2, con3;
	con1 = me->query_condition("snake_poison");
	con2 = me->query_condition("scorpion_poison");
	con3 = me->query_condition("xx_poison");

	if( me->is_fighting() )
		return notify_fail("戰斗中運功驅毒？找死嗎？\n");

	if( (int)me->query("neili") < 50 )
		return notify_fail("你的真氣不夠。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail("你已經受傷過重，只怕一運真氣便有生命危險！\n");

	if ((int)me->query_skill("hamagong", 1) < 20)
		return notify_fail("你的蛤蟆功修為還不夠。\n");

	if (con1 > 0) 
	{
		if (con1 < 3)
		{
			me->apply_condition("snake_poison", 0);
			write( HIW "你運功把蛇毒驅除干淨了。\n" NOR);
		}
		else
		{
			me->apply_condition("snake_poison", con1 - 4);
			write( HIW "你全身放松，坐下來開始運功驅除蛇毒。\n" NOR);
		}
		message("vision", 
	HIY+me->name()+"吐出一口金燦燦的瘀血，一滴滴黑血從傷口慢慢滲出。\n" NOR,
		environment(me), me);
	}
	else
	if (con2 > 0)
	{
		if (con2 < 3)
		{
			me->apply_condition("scorpion_poison", 0);
			write( HIW "你運功把蠍毒驅除干淨了。\n" NOR);
		}
		else
		{
			me->apply_condition("scorpion_poison", con2 - 4);
			write( HIW "你全身放松，坐下來開始運功驅除蠍毒。\n" NOR);
		}
		message("vision", 
	HIY+me->name()+"吐出一口金燦燦的瘀血，一滴滴青紫血珠從傷口慢慢滲出。\n" NOR,
		environment(me), me);
	}
	else
	if (con3 > 0)
	{
		if ((int)me->query_skill("hamagong", 1) < 30)
			return notify_fail("你的蛤蟆功修為還不夠。\n");
		if (con3 < 3)
		{
			me->apply_condition("xx_poison", 0);
			write( HIW "你運功把星宿掌毒驅除干淨了。\n" NOR);
		}
		else
		{
			me->apply_condition("xx_poison", con3 - 4);
			write( HIW "你全身放松，坐下來開始運功驅除星宿掌毒。\n" NOR);
		}
		message("vision", 
	HIY+me->name()+"吐出一口紫血，蒼白的臉上多了點血色。\n" NOR,
		environment(me), me);
	}
	else write( HIW "你好象沒中毒吧。\n" NOR);

	me->add("neili", -50);
	me->set("jiali", 0);
	me->start_busy(4);

	return 1;
}
