// mogsh.c 魔影迷縱

inherit SKILL;
#include <ansi.h>
string *dodge_msg = ({

    "$n一個「"HIC"魔蹤無定"NOR"」，隨著$N的攻勢飄起，從容躲過這一招。\n",
    "$n使出一招「"HIC"鬼魅無常"NOR"」，猛然縱起丈余，結果$N扑了個空。\n",
    "$n身形一搖，幻出几個人影，一招「"HIR"碎影霧"NOR"」躲過了$N的攻勢。\n",
    "$n一招「"HIB"魔影行"NOR"」縱身躍起，倏忽已落至$N身后。\n",
    "$n左一搖，右一晃，一招「"HIM"幻影術"NOR"」輕鬆閃過。\n",
    "$n雙足一點，斜斜飛起，使出「"MAG"厲鬼纏身"NOR"」已閃到"BLU"$N"NOR"身側。\n",
});

int valid_enable(string usage) 
{ 
    return (usage == "dodge") ;
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 30 )
            return notify_fail("你的體力太差了，不能練暗影浮香。\n");
        if (me->query_skill("yan-shuangfei", 1) < 30)
                me->receive_damage("qi", 10);
                me->receive_damage("qi", 20);
        return 1;
}
