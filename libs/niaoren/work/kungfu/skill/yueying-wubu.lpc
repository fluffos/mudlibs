// yueying-wubu.c  月影舞步
inherit SKILL;

mapping *action = ({
([      "action" : "$n身形一晃，纖腰一扭，一招「星河鷺起」，彈地而起。\n",
        "dodge"  : 30,
]),
([      "action" : "$n一招「歌盡桃花扇底風」，$N只覺眼前一花，不見了$n的身影。\n",
        "dodge"  : 40,
]),
([      "action" :  "$n一招「掃盡浮云風不定」，身形微晃，有驚無險地避開了$N這一招。\n",
        "dodge"  : 50,
]),
([      "action" : "只見$n身子向后一翻，一招「縹渺孤鴻影」，后蕩而起，掠向一旁。\n" ,
        "dodge"  : 60,
]),
([      "action" : "$n一招「起舞弄清影」，長袖翻飛，躲過$N這一招。\n",
        "dodge"  : 70,
]),
([      "action" : "卻見$n「萬頃江田一鷺飛」，沖天而起，一波三折，端是美觀。\n",
        "dodge"  : 80,
]),
([      "action" : "可是$n一個「流水落花春去也」，側身一讓，$N這一招扑了個空。\n",
        "dodge"  : 90,
]),
([      "action" : "只見$n一招「月輪穿沼水無痕」，倒掠身形，凌空兩個翻轉，退出兩丈開外。\n",
        "dodge"  : 100,
]),
([      "action" :  "$n息氣上升，意存玉枕，一招「月在青天影在波」，身子飄然而起。\n",
        "dodge"  : 110,
])
});

mapping query_action(object me, object weapon)
{
        int zhaoshu, level;

        zhaoshu = sizeof(action);
        level   = (int) me->query_skill("yueying-wubu");
        return action[random(zhaoshu)];
}

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        object me, ob;
        mapping action;

        me = this_player();
        action = query_action(me, ob);

        return action["action"];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 45 )
                return notify_fail("你的體力太差了，不能練月隱舞步。\n");
        me->receive_damage("qi", 35);
        return 1;
}

