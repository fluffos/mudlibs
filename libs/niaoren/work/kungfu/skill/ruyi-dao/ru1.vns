// dao.c  如意刀 [如意連環刀]
#include <ansi.h>                                                               
                                                                                
inherit F_SSERVER;                                                              
int perform(object me, object target)                                           
{                                                                               
        int damage;                                                             
        string msg;                                                             
        if( !target                                                             
        ||      !target->is_character()                                         
        ||      !me->is_fighting(target) )                                      
               return notify_fail("「如意連環刀」只能在戰斗中使用。\n");
        if( (int)me->query_skill("beiming-shengong", 1) < 100 )
                return notify_fail("你的北冥神功\火候不夠，不能使用「如意連環刀」。\n");
        if(!me->query("family") || (me->query("family/family_name")!="逍遙派")) 
             return notify_fail("你不是逍遙派的，你不會「如意連環刀」?\n");
                                                                                
        if( (int)me->query_dex() < 25 )
                return notify_fail("你的身法不夠靈活，無法使出「如意連環刀」。\n ");
                                                                                
        if( (int)me->query("neili") < 500 )
                return notify_fail("你的內力不夠高，無法使出「如意連環刀」。\n") ;
                                                                                
        if( (int)me->query_skill("dodge") < 100 )
                return notify_fail("你的輕功\有效等級不夠高，使不出「如意連環刀」。\n");
                                                                                
        if( (int)me->query_skill("blade") < 110 )
                return notify_fail("你的刀法等級不夠高，使不出「如意連環刀」。\n");
                                                                                
        if( target->is_busy() )                                                 
                return notify_fail(target->name() + "目前正驚慌失措，放膽攻擊吧！ n");


    msg =  HIG "$N突然往後退一大步，運起畢身內力向天空大喊："HIM"鳥∼"BLINK"人∼"HIC"萬∼萬∼歲∼"NOR"\n
只聽到天空上傳來一聲奸笑，"BLINK""WHT"驟時天色大變"NOR""HIC"一道閃電"NOR"擊向$N擲向$n的兵器，逍遙派"BLINK"最強密技"NOR"＝\n
＝＞「"HIR"如"HIC"∼"BLINK"意"HIY"∼連∼"HIB"環∼"MAG"刀"NOR"」瞬間飛向$n， $n的全身全身各大要害都已籠罩在刀光下！\n"NOR;

    message_vision(msg, me);

        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3
 ) {                                                                            
        me->start_busy(random(3));                                              
                                                                                
        damage = (int)me->query_skill("ruyi-dan", 1)*3;
        damage = damage + random(damage);                                       
                                                                                
        target->receive_damage("qi", damage);                                   
        target->receive_wound("qi", damage/2);                                  
        me->add("neili", -300);                                                 
        msg += HIC"結果$P的刀身，刀刀都刺中了$p，$p像個噴血的刺蝟般向後飛去。\n" NOR;
        target->start_busy( (int)me->query_skill("ruyi-dao") / 20 + 2);
                                                                                
        } else {                                                                
        me->start_busy(random(3));                                              
                msg += "可是$p技高一籌，$P的攻擊全部失效。\n" NOR;
        }                                                                       
        message_vision(msg, me, target);                                        
                                                                                
        return 1;                                                               
}                                                                               

