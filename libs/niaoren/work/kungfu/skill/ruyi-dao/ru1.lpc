// dao.c  如意刀 [如意連環刀]

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
    string msg, string1;
    int count;
 
    if( !me->is_fighting() )
            return notify_fail("「如意連環刀」只能在戰斗中使用。\n");
        if(!me->query("family") || (me->query("family/family_name")!="逍遙派")) 
             return notify_fail("你不是逍遙派的，你不會「如意連環刀」?\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "blade")
                        return notify_fail("你使用的武器不對。\n");

        if((int)me->query_dex() < 25)
                return notify_fail("你的身法不夠, 目前還不能使用這項絕技! \n");

        if((int)me->query_skill("beiming-shengong",1) < 100)
                return notify_fail("你的北冥神功的修為不夠, 不能使用這一絕技 !\n");

        if((int)me->query_skill("dodge") < 100)
                return notify_fail("你的輕功修為不夠, 不能使用如意連環刀！\n");
 
        if((int)me->query_skill("blade") < 110)
                return notify_fail("你的刀法修為不夠， 目前不能使用如意連環刀! \n");

    if( (int)me->query("neili") < 500 )
                return notify_fail("你的真氣不夠！\n");

    msg =
    HIG "$N突然往後退一大步，運起畢身內力向天空大喊："HIM"鳥∼"BLINK"人∼"HIC"萬∼萬∼歲∼"NOR"\n
只聽到天空上傳來一聲奸笑，"BLINK""WHT"驟時天色大變"NOR""HIC"一道閃電"NOR"擊向$N擲向$n的兵器，逍遙派"BLINK"最強密技"NOR"＝\n
＝＞「"HIR"如"HIC"∼"BLINK"意"HIY"∼連∼"HIB"環∼"MAG"刀"NOR"」瞬間飛向$n， $n的全身各大要害都已籠罩在刀光下！\n"NOR;

      message_vision(msg, me, target);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        me->add("neili", -150);
        me->start_busy(random(2));

    return 1;
}
