// god-sword.c  天劍神訣之天神怒吼(驚天一擊)
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	int damage;
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「天神怒吼」只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
		
        if( (int)me->query_skill("god-sword", 1) < 100 )
                return notify_fail("你的天劍神訣不夠嫻熟，不會使用。\n");
	                        
        if( (int)me->query_skill("force", 1) < 200 )
                return notify_fail("你的基本內功修為不夠高。\n");
			
        if( (int)me->query("neili") < 100 )
                return notify_fail("你現在內力太弱，不能使用「天神怒吼」。\n");
			
        msg = HIW "$N雙手握劍向左肩一勒，眼中血絲倒映劍面，緊接著右臂疾刺，一陣
        罡氣裹住劍影向$n當頭灑落，\n"NOR;


	if (random(me->query_skill("force")) > target->query_skill("force")/2 )
	{
                target->start_busy( (int)me->query_skill("god-sword") / 15 + 1);
		
                damage = (int)me->query_skill("taijishengong", 1);
                damage = damage +  (int)me->query_skill("god-sword", 1);
		damage = damage +  (int)me->query_skill("sword", 1);
		
		target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
		me->add("neili", -damage);
		msg += HIR"只見$N"+BLINK""+HIC"人劍合一"NOR+"，穿向$n,\n$n只覺一股"+HIR"熱流"NOR+"穿心而過，喉頭一甜，鮮血狂噴而出！\n"NOR;
		me->start_busy(2);
	} else 
	{
		msg += CYN"可是$p猛地向邊上一躍,跳出了$P的攻擊范圍。\n"NOR;
                me->add("neili", -100);
		me->start_busy(4);
	}
	message_combatd(msg, me, target);

	if(userp(target)) target->fight_ob(me);
//	else if( !target->is_killing(me->query("id")) ) target->kill_ob(me);
	return 1;
}
