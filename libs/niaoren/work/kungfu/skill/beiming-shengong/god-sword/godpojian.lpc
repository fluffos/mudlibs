// god-sword.c 天劍神訣之天地共滅(破劍式)

#include <ansi.h>

inherit F_SSERVER;

int perform(object me)
{
        string msg;
        object weapon, weapon2, target;
        int skill, ap, dp, damage;

        if (!objectp(weapon = me->query_temp("weapon"))
            || (string)weapon->query("skill_type") != "sword")
           return notify_fail("你使用的武器不對，不能使用絕招！\n");

        if( me->query("dex") < 30 || me->query("str") < 30 )
            return notify_fail("你的先天膂力身法孱弱, 不能使用「天地共滅」！\n");

        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("god-sword",1);

        if( !(me->is_fighting() ))
            return notify_fail("「天地共滅」只能對戰斗中的對手使用。\n");

        if (!objectp(weapon2 = target->query_temp("weapon")))
            return notify_fail("對方沒有使用兵器，你用不了「天地共滅」。\n");

        if( skill < 100)
            return notify_fail("你的天劍神訣等級不夠, 不能使用「天地共滅」！\n");

        if( me->query("neili") < 300 )
            return notify_fail("你的內力不夠，無法運用「天地共滅」！\n");

        msg = HIC "$N左手捏了一個劍訣，默潛天劍神訣之"+HIW"【"NOR+""+BLINK""+HIR"天地共滅"NOR+""+HIW"】"NOR+", 漫天劍意，如直搗黃龍般襲向$n。\n";
        message_vision(msg, me, target);

        damage = 20 + random(skill / 2);
        ap = me->query_skill("sword")/3 + skill;
        dp = target->query_skill("dodge")/2;
        if( dp < 1 )
            dp = 1;
        if( random(ap) > random(dp) )
        {
            if(userp(me))
                 me->add("neili",-50);
            msg = "$n頓時覺得眼前"+HIY"金光一閃"NOR+"，手腕一振，手中";
            msg += weapon2->name();
            msg += "脫手飛出！\n" NOR;
            me->start_busy(random(2));
            target->receive_damage("qi", damage);
            target->start_busy(3);
            weapon2->move(environment(me));
        }
        else
        {
            if(userp(me))
                 me->add("neili",-30);
            msg = "$n急運內力，將手中" + weapon2->name()+
"斜斜順勢一送一搭，抽了回來。\n"NOR;
            me->start_busy(2);
        }
        message_combatd(msg, me, target);

        return 1;
}
