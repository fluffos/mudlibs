// sanqing.c 一劍化三清

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count;
 
        if( !me->is_fighting() )
                return notify_fail("「一劍化三清」只能在戰斗中使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("「一劍化三清」開始時必須拿著一把劍！\n");

        if( (int)me->query("neili") < 100 )
                return notify_fail("你的真氣不夠！\n");

        if( (int)me->query_skill("quanzhen-jianfa",1) < 135 )
                return notify_fail("你的全真劍法還不到家，無法使用「一劍化三清」！\n");

        if( (int)me->query_skill("xiantian-gong",1) < 60 )
                return notify_fail("你的先天神功火候不夠，無法使用「一劍化三清」！\n");

        msg = HIM "$N"HIM"使出全真派絕技"HIY"「一劍化三清」"HIM"，身法陡然加快,手握劍柄晃成三條白龍！\n" NOR;
        message_vision(msg, me);

        me->add_temp("apply/attack", (int)me->query_skill("quanzhen-jianfa",1)/2);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        me->add_temp("apply/attack", - (int)me->query_skill("quanzhen-jianfa",1)/2);

        me->add("neili", -100);
        me->start_busy(random(4));

        return 1;
}

