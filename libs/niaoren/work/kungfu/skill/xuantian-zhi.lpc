// xuantian-zhi.c
inherit SKILL;

mapping *action = ({
([      "action" : "$N左指揮出，一式「黯然消魂」，削向$n的掌緣",
        "force" : 100,
        "dodge" : 5,
        "lvl" : 0,
        "skill_name" : "黯然消魂",
        "damage_type" : "刺傷"
]),
([      "action" : "$N全身之力聚于一指，一式「天似無情」，指向$n的胸前",
        "force" : 140,
        "dodge" : 5,
        "lvl" : 15,
        "damage" : 25,
        "skill_name" : "天似無情",
        "damage_type" : "刺傷"
]),
([      "action" : "$N左掌貼于神道穴，右手一式「情根深種」，向$n的$l划過",
        "force" : 180,
        "dodge" : 8,
        "lvl" : 25,
        "damage" : 55,
        "skill_name" : "情根深種",
        "damage_type" : "刺傷"
]),
([      "action" : "$N雙目怒視，一式「情在天涯」，雙指拂向$n的額、頸、肩、臂、胸
、背",
        "force" : 220,
        "dodge" : 5,
        "damage": 65,
        "lvl" : 45,
        "skill_name" : "情在天涯",
        "damage_type" : "刺傷"
]),
([      "action" : "$N一式「獨飲情傷」，左掌掌心向外，右指蓄勢點向$n的$l",
        "force" : 260,
        "dodge" : 15,
        "damage": 80,
        "lvl" : 60,
        "skill_name" : "獨飲情傷",
        "damage_type" : "刺傷"
]),
([      "action" : "$N右手伸出，十指叉開，一式「無訴別情」，小指拂向$n的太淵穴",
        "force" : 330,
        "dodge" : 20,
        "damage": 100,
        "lvl" : 70,
        "skill_name" : "無訴別情",
        "damage_type" : "刺傷"
]),
([      "action" : "$N雙迸出無數道勁氣，一式「情意綿綿」射向$n的全身",
        "force" : 400,
        "dodge" : 25,
        "damage": 120,
        "lvl" : 80,
        "skill_name" : "情意綿綿",
        "damage_type" : "刺傷"
]),
});

int valid_enable(string usage) { return usage=="finger" || usage=="parry"; }


int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("練玄天無情指必須空手。\n");
//        if ((int)me->query_skill("wuzheng-xinfa", 1) < 80)
//                return notify_fail("你的無爭心法火候不夠，無法學玄天無情指。\n");
        if ((int)me->query("max_neili") < 300)
                return notify_fail("你的內力太弱，無法練玄天無情指。\n");
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("xuantian-zhi",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        if ((int)me->query("jing") < 30)
                return notify_fail("你的精太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的內力不夠練玄天無情指。\n");
        me->receive_damage("jing", 30);
        me->add("neili", -10);
        return 1;
}

