	]),
	([	"name":		"蛇困愁城",
		"action":	"$N身形一矮，一招「蛇困愁城」，手中的$w由下往上刺向$n的$l",
		"dodge":	100,
		"parry" :	200,
		"force" : 	300,
		"damage":	300,
		"damage_type":	"刺傷"
	]),
	([	"name":		"金蛇化龍",
		"action":	"$N手中$w劍光暴長，一招「金蛇化龍」，如千年蛇蠍往$n$l咬去",
		"dodge":	100,
		"parry" :	200,
		"force" : 	300,
		"damage":	400,
		"damage_type":	"刺傷"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_neili") < 500 )
		return notify_fail("你的內力不夠，沒有辦法練金蛇劍法。\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("你必須先找一把劍才能練劍法。\n");

        return notify_fail("金蛇劍法沒法教授。\n");

}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 30
	||	(int)me->query("neili") < 15 )
		return notify_fail("你的內力或氣不夠，沒有辦法練習金蛇劍法。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -15);
	write("你按著所學練了一遍金蛇劍法。\n");
	return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

int effective_level() { return 25;}

string *parry_msg = ({
        "$n不退反進，氣走周天，手中的$v狠狠磕開了$N的$w。\n",
	"$n回劍自守，架住了$N的$w。\n",
	"$n手中的$v化作千百把，護住了全身。\n",
	"$n手中的$v自上削下，几乎將$N的$w削成兩段。\n",
});

string *unarmed_parry_msg = ({
        "$n使動$v，在身前布起了一道銅牆鐵壁，封住了$N的攻勢。\n",
	"$n一抖手中的$v，護住了全身。\n",
	"$n將$v往地上一刺，$v反彈起來，剛好直刺$N的雙臂。\n",
	"$n舉劍靜立，一股內力從劍梢透出，逼開了$N。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
        return __DIR__"jinshe-jian/" + action;
}


