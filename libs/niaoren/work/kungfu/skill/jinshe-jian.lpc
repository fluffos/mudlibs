		"dodge":	50,
		"parry" :	100,
		"force":	170,
		"damage" :	50,
		"damage_type":	"刺傷"
	]),
	([	"name":		"蛇影萬道",
		"action":	"$N使一招「蛇影萬道」，手中$w狂風驟雨般地向$n的$l連攻數劍",
		"dodge":	100,
		"parry" :	200,
		"force" : 	200,
		"damage":	70,
		"damage_type":	"刺傷"
	]),
	([	"name":		"雪地飛蛇",
		"action":	"$N身形一轉，陡地貼地躍起，手中$w靈動夭躍，一招「雪地飛蛇」疾刺$n的$l",
                "dodge":	100,
                "parry" :	200,
		"force":	170,
		"damage" :	50,
		"damage_type":	"刺傷"
	]),
	([	"name":		"金蛇吞信",
		"action":	"$N身形一轉，一招「金蛇吞信」，手中的$w從左肋下向$n的$l戳了過去",
		"dodge":	100,
		"parry" :	200,
		"force" : 	200,
		"damage":	120,
		"damage_type":	"刺傷"
	]),
	([	"name":		"金蛇狂舞",
		"action":	"$N手腕一抖，一招「金蛇狂舞」，$w挾著閃閃劍光，變幻無方逼向$n的$l",
		"dodge":	100,
		"parry" :	200,
		"force" : 	300,
		"damage":	150,
		"damage_type":	"刺傷"
	]),
	([	"name":		"靈蛇電閃",
		"action":	"$N心念電閃手腕疾振處，一招「靈蛇電閃」，$w以無法形容的速度直射$n的$l",
		"dodge":	100,
