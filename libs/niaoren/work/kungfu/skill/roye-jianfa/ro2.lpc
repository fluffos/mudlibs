// roye 24:00 2001-3-1
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int i, attack_time;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("《恨吾多情》只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");

        if( (int)me->query_skill("roye-jianfa", 1) < 150 )
                return notify_fail("你的恨吾多情劍不夠嫻熟，無法使用《恨吾多情》。\n");

	if( (int)me->query_skill("bibo-shengong", 1) < 160 )
                return notify_fail("你的碧波神功不夠嫻熟，無法使用《恨吾多情》。\n");

        msg = CYN "$N仰天長嘯，心中凌亂，一式"BLINK""HIR"《恨吾多情》"NOR""CYN"幻出無數劍影連連進招。\n"NOR;

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
	{
                msg += CYN " 結果$p眼花瞭亂，被$P的招數攻個措手不及！\n" NOR;
                attack_time = random((int)me->query_skill("roye-jianfa", 1) / 50);
		if(attack_time < 1)
			attack_time = 1;

		for(i = 0; i < attack_time; i++)
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

		me->start_busy(random(2));
		me->add("neili", -100);
	}
	else
	{
                msg += "可是$p看破了$P的劍招，巧妙的躲過這一擊。\n" NOR;
		me->start_busy(random(3));
	}
	message_vision(msg, me, target);

	return 1;
}
