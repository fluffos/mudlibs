// /u/roye/skill/yu1.c  恨吾深情

#include <ansi.h>

inherit F_SSERVER;

int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, ap, dp, neili_wound, qi_wound;

        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("roye-jianfa",1);

        if( !(me->is_fighting() ))
            return notify_fail("《恨吾深情》只能對戰斗中的對手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
            return notify_fail("你使用的武器不對。\n");

        if( me->query_skill("bibo-shengong",1) < 150)
            return notify_fail("你的碧波神功等級不夠, 不能使用《恨吾深情》！\n");

        if( skill < 120)
            return notify_fail("你的恨吾多情劍等級不夠, 不能使用《恨吾深情》！\n");

        if( me->query("neili") < 250 )
            return notify_fail("你的內力不夠，無法運用《恨吾深情》！\n");

        msg = HIG 
"$N長嘆一聲，心亂如麻，深吸一口氣，劍附恨意，一式"BLINK""HIR"《恨吾深情》"NOR""HIG"劍招亂中有序，招招攻向$n要害。"NOR"\n";
        message_combatd(msg, me, target);

        ap = me->query_skill("sword") + skill;
        dp = target->query_skill("force") / 2;
        if( dp < 1 )
            dp = 1;
        if( random(ap) > dp )
        {
            if(userp(me))
                 me->add("neili",-150);
            msg = HIC"$n"HIG"頓時覺得眼前金光亂閃動，劍影籠罩全身，雙耳嗡嗡內鳴，"
            "不知那裡一陣刺痛如針扎一般！"NOR"\n";
            qi_wound = (int)me->query_skill("roye-jianfa",1)+(int)me->query_skill("sword",1)/2;
            qi_wound = qi_wound/2 + random(qi_wound);
            if(qi_wound > target->query("qi"))
                 qi_wound = target->query("qi");

            target->receive_damage("qi", qi_wound);
            target->receive_wound("qi", qi_wound/2);
            target->start_busy(2);
            me->start_busy(random(3));
        }
        else
        {
            if(userp(me))
                 me->add("neili",-100);
            msg = HIG"可是"HIC"$n"HIG"寧心靜氣，隨手揮洒，將$N的招數撇在一邊。\n"NOR;
            me->start_busy(random(3));
        }
        message_combatd(msg, me, target);
        if(!target->is_fighting(me)) target->fight_ob(me);
        return 1;
}
