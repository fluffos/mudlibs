// feiyan-huixiang.c 飛燕回翔
// modified by Venus Oct.1997
// pyrobat-steps.c

inherit SKILL;

string *dodge_msg = ({
    "但是$n身形飄忽，輕輕一縱，一招「乳燕投林」，舉重若輕的避開這一擊。\n",
    "$n身隨意轉，一式「雪花飛舞」，倏地往一旁飄開數尺，避過了這一招。\n",
    "可是$n側身一讓，使出「柳絮輕飄」，$N這一招扑了個空。\n",
    "卻見$n足不點地，一招「騰云駕霧」，身形滴溜溜一轉，往旁閃開數尺，躲了開去。\n",
    "$n左腳一點右腳背，身形往上一拔，一招「一鶴沖天」，輕輕巧巧地避開了這一招。\n"
});

int valid_enable(string usage)
{
    return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
    return 1;
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30 )
   return notify_fail("你的體力太差了，不能練飛燕回翔......\n");
    me->receive_damage("qi", 30);
    return 1;
}
