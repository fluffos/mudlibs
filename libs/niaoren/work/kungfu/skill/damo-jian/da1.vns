// sanjue.c 「達摩三絕劍」                                                      
#include <ansi.h>                                                               
                                                                                
inherit F_SSERVER;                                                              
int perform(object me, object target)                                           
{                                                                               
        int damage;                                                             
        string msg;                                                             
        if( !target                                                             
        ||      !target->is_character()                                         
        ||      !me->is_fighting(target) )                                      
               return notify_fail("「達摩三絕劍」只能在戰斗中使用。\n");        
        if( (int)me->query_skill("hunyuan-yiqi", 1) < 60 )                      
                return notify_fail("你的混元一氣功\火候不夠，不會使用「達摩三絕劍
」。\n");                                                                       
                                                                                
        if( (int)me->query_dex() < 30 )                                         
                return notify_fail("你的身法不夠靈活，無法使出「達摩三絕劍」。\n
");                                                                             
                                                                                
        if( (int)me->query("neili") < 300 )                                     
                return notify_fail("你的內力不夠高，無法使出「達摩三絕劍」。\n")
;                                                                               
                                                                                
        if( (int)me->query_skill("dodge") < 135 )                               
                return notify_fail("你的輕功\有效等級不夠高，使不出「達摩三絕劍」
。\n");                                                                         
                                                                                
        if( (int)me->query_skill("sword") < 135 )                               
                return notify_fail("你的劍法有效等級不夠高，使不出「達摩三絕劍」
。\n");                                                                         
                                                                                
        if( target->is_busy() )                                                 
                return notify_fail(target->name() + "目前正驚慌失措，放膽攻擊吧吧
  n");                                                                          
        msg = HIY "                                                             
$N使出「達摩三絕劍」，口喧佛號，瞬間里“唰唰唰”連刺出三劍，同樣的速度！同樣的迅
速！                                                                            
$n的全身全身各大要害都已籠罩在劍光下！\n"NOR;                                   
                                                                                
        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3
 ) {                                                                            
        me->start_busy(random(3));                                              
                                                                                
        damage = (int)me->query_skill("damo-jian", 1)*3;                        
        damage = damage + random(damage);                                       
                                                                                
        target->receive_damage("qi", damage);                                   
        target->receive_wound("qi", damage/2);                                  
        me->add("neili", -300);                                                 
        msg += HIC"結果$P的三劍，劍劍都刺中了$p，$p象個噴血的刺  般向后飛出。\n"
 NOR;                                                                           
        target->start_busy( (int)me->query_skill("damo-jian") / 20 + 2);        
                                                                                
        } else {                                                                
        me->start_busy(random(3));                                              
                msg += "可是$p看破了$P的企圖，急忙躲開，$P沒有得逞。\n" NOR;    
        }                                                                       
        message_vision(msg, me, target);                                        
                                                                                
        return 1;                                                               
}                                                                               

