//zhongping-qiang.c 中平槍法
#include "ansi.h"
inherit SKILL;
mapping *action = ({
([	"action": "$N雙手一別，盡力前伸，使出一招「中平無敵」，手中$w平平直出，刺向$n的$l",
	"force" : 100,
	"dodge": -3,
	"damage": 280,
	"skill_name" : "中平無敵",
	"damage_type": "刺傷"
]),
([	"action": "$N手中$w盤旋回轉，風響陣陣，屈身下蹲，反手一招「夜叉探海」自下向$n的$l刺去",
	"force" : 140,
	"dodge": -5,
	"damage": 250,
	"skill_name" : "夜叉探海",
	"damage_type": "刺傷"
]),
([	"action": "$N舉起$w，抖出一朵槍花，一招「靈蛇出洞」向$n分心扎去",
	"force" : 180,
	"dodge": -10,
	"damage": 220,
	"skill_name" : "靈蛇出洞",
	"damage_type": "刺傷"
]),
([	"action": "$N一招「反身拿槍」，手中$w划個小圈消去$n的后招，而后$w微抬，指向$n的$l",
	"force" : 220,
	"dodge": -5,
	"damage": 200,
	"skill_name" : "反身拿槍",
	"damage_type": "刺傷"
]),
});

int valid_enable(string usage) { return usage=="club" ||  usage=="parry"; }
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 70)
		return notify_fail("你的內力不夠。\n");
	if ((int)me->query_skill("lingyuan-xinfa",1)< 50)
		return notify_fail("你的靈元心法修為不夠，無法練中平槍法。\n");
	return 1;
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力不夠練中平槍法。\n");
	me->receive_damage("qi", 20);
	return 1;
}


