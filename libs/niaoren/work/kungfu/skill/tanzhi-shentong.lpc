([  "action" : "$N右指划了個半圈，一式「划天裂地」自上而下划向$n的全身",
    "force" : 320,
    "dodge" : -5,
    "damage": 35,
    "lvl" : 20,
    "skill_name" : "划天裂地",
	"damage_type" : "刺傷"
]),
([  "action" : "$N左掌護胸，一招「我心悠悠」，右指欲舉無力指向$n的額頭",
    "force" : 280,
    "dodge" : 20,
    "lvl" : 0,
    "skill_name" : "我心悠悠",
    "damage_type" : "刺傷"
]),
([  "action" : "$N雙手齊出，一式「千夫所指」，疾指向$n的$l",
    "force" : 190,
    "dodge" : 15,
    "lvl" : 0,
    "skill_name" : "千夫所指",
    "damage_type" : "刺傷"
]),
([  "action" : "$N仰天一嘆，一招「彈指人生」，雙手幻出重重指影，點向$n的$l",
