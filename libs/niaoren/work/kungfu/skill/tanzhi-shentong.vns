// tanzhi-shentong.c -彈指神通
// modified by Venus Oct.1997
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N使出「空」字訣，右手五指緩緩分開，中指和拇指驟然一合，隨即
中指彈出，一道白光襲向$n的鳩尾穴",
    "force" : 170,
    "dodge" : 35,
    "damage_type" : "扎傷",
    "lvl" : 0,
    "skill_name" : "彈指神通中的「空」字訣"
]),
([      "action" : "$N使出「破」字訣，左手成掌划弧，右手倏地翻腕彈出一指，化作一
點白芒射向$n的玉堂穴",
    "force" : 240,
    "dodge" : 15,
    "damage_type" : "扎傷",
    "lvl" : 14,
    "skill_name" : "彈指神通中的「破」字訣"
]),
([      "action" : "$N使出「化」字訣，右手詐攻兩掌，左手自腋下穿出，疾彈三指分別
射向$n的神庭、肩井、廉泉三穴",
    "force" : 300,
    "dodge" : 5,
    "damage_type" : "內傷",
    "lvl" : 28,
    "skill_name" : "彈指神通中的「化」字訣"
]),
([      "action" : "$N使出「透」字訣，側身而上，身形突閃，繞至$n身后猛地彈出一指，
只聽“波”的一聲，一點青光眼看就要透入$n的命門穴",
    "force" : 350,
    "dodge" : -5,
    "damage_type" : "內傷",
    "lvl" : 42,
    "skill_name" : "彈指神通中的「透」字訣"
]),
([      "action" : "$N使出「亂」字訣，身形向后乍然一閃，雙手疾彈，無數道青芒射向$n，
看似雜亂，實則亂而有序，分兩組襲向$n的氣海、膻中大穴",
    "force" : 400,
    "dodge" : 20,
    "damage_type" : "內傷",
    "lvl" : 56,
    "skill_name" : "彈指神通中的「亂」字訣"
]),
([      "action" : "$N使出「妙」字訣，身法陡變，輕靈飄忽，捉摸不透，$n已看得花了眼，
正欲出招時，卻見一股勁氣逼向自己的中極死穴",
    "force" : 425,
    "dodge" : 15,
    "damage_type" : "內傷",
    "lvl" : 70,
    "skill_name" : "彈指神通中的「妙」字訣"
]),
([      "action" : "$N使出「疾」字訣，輕盈地一個急轉身，右手遞前，由指間射出兩點紫
氣電光火石般地襲向$n目間清明穴",
    "force" : 450,
    "dodge" : 20,
    "damage_type" : "內傷",
    "lvl" : 84,
    "skill_name" : "彈指神通中的「疾」字訣"
]),
([      "action" : "$N凝神使出「通」字訣，身隨意轉，手隨心動，繞著$n疾轉，手中疾點
連連，將$n的神闕、建里、膻中、百會、大椎、命門、啞門等各處要穴、大穴、
死穴均籠罩在自己布下的氣網中",
    "force" : 500,
    "dodge" : 25,
    "damage_type" : "內傷",
    "lvl" : 99,
    "skill_name" : "彈指神通中的「通」字訣"
])
});

int valid_enable(string usage) { return usage=="finger" ||  usage=="parry"; }   

int valid_combine(string combo) { return combo=="lanhua-shou"; }

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail(HIC"練彈指神通手必須空手。\n"NOR);
    if ((int)me->query_skill("luoying-xinfa", 1) < 25)
   return notify_fail("你的落英心法火候不夠，無法學彈指神通。\n");
    if ((int)me->query("max_neili") < 200)
   return notify_fail("你的內力太弱，無法練彈指神通。\n");
    return 1;
}
string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
    return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("tanzhi-shentong", 1);
    for(i = sizeof(action); i > 0; i--)
    if(level > action[i-1]["lvl"])
    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
   return notify_fail("你的體力太低了，無法練彈指神通。\n");
    me->receive_damage("qi", 25);
    return 1;
}

