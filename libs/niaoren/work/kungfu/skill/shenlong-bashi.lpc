// shenlong-bashi 神龍八式
inherit SKILL;

mapping *action = ({
([	"action" : "$N使一招「疏影橫斜」,左手輕輕一抹，向$n的$l拍去",
	"damage" : 20,
	"parry": 10,
	"force": 100,
        "damage_type" : "瘀傷",
	"skill_name" : "疏影橫斜"
]),
([	"action" : "$N鼓氣大喝,雙掌使一招「五丁開山」，推向$n的$l",
	"damage" : 30,
	"parry": 30,
    "damage_type" : "瘀傷",
	"skill_name" : "五丁開山"
]),
([	"action": "$N順勢使一招「風行草偃」，移肩轉身,左掌護面,右掌直擊$n",
	"damage" : 40,
	"dodge": 80,
	"parry": 20,
	"force": 200,
	"damage_type": "瘀傷",
	"skill_name" : "風行草偃"
]),
([	"action": "$N退后几步,突然反手一掌,一招「神龍擺尾」，無比怪異地擊向$n",
	"damage" : 50,
	"dodge": 80,
	"parry": 20,
	"force": 250,
	"damage_type": "瘀傷",
	"skill_name" : "神龍擺尾"
]),
([	"action" : "$N使一式「風卷殘云」，全身飛速旋轉，雙掌一前一后，猛地拍向$n的胸口",
	"damage" : 50,
	"force" : 250,
        "dodge" : 10,
	"lvl" : 30,
        "damage_type" : "瘀傷",
	"skill_name" : "風卷殘云"
]),
([	"action": "$N忽的使出「乾坤倒旋」,以手支地,雙腿翻飛踢向$n",
	"damage" : 60,
	"dodge": -20,
	"parry": -20,
	"force": 250,
	"damage_type": "瘀傷",
	"skill_name" : "乾坤倒旋"
]),
([	"action": "$N大吼一聲，使出「同歸于盡」，不顧一切般扑向$n",
	"dodge": -25,
	"parry": -10,
	"damage" : 60,
	"force": 400,
	"damage_type": "內傷",
	"skill_name" : "同歸于盡"
]),
([	"action": "$N深吸一口氣,身體漲成球狀,猛然流星趕月般直撞向$n",
	"dodge": 80,
	"damage" : 70,
	"parry": -10,
	"force": 400,
	"damage_type": "內傷",
	"skill_name" : "流星趕月"
]),
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練神龍八式必須空手。\n");
	if ((int)me->query_skill("shenlong-xinfa", 1) < 50)
		return notify_fail("你的神龍心法火候不夠，無法學神龍八式.\n");
	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本內功火候不夠，無法學神龍八式。\n");
	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的內力太弱，無法練神龍八式。\n");
	if (2*(int)me->query_skill("shenlong-xinfa",1) <(int)me->query_skill("shenlong-bashi",1))
		return notify_fail("你的神龍心法火
候不夠，無法繼續學神龍八式。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 30)
		return notify_fail("你的內力不夠練神龍八式。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

