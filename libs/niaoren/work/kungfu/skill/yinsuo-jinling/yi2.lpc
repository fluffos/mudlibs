// feng.c 銀索金鈴 封穴
// By Kayin @ CuteRabbit Studio 1999/3/21 new

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	object ob;
	string msg;
	ob=me->query_temp("weapon");
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("封穴只能對戰斗中的對手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "whip")
			return notify_fail("你使用的武器不對。\n");

	if((int)me->query_skill("yunu-xinjing",1) < 100)
		return notify_fail("你玉女心經的功力不夠不能封住敵人穴道!\n");

	if((int)me->query_skill("yinsuo-jinling",1) < 150)
		return notify_fail("你的銀索金鈴修為不夠,目前還不能封住敵人穴道!\n");
	if((int)me->query_skill("tianluo-diwang")< 100)
		return notify_fail("你的天羅地網勢還不夠純熟，連穴道都認不准！\n");

	if((int)me->query("neili") < 800)
		return notify_fail("你內力現在不夠, 不能封穴! \n");

	if( target->is_busy() )
		return notify_fail(target->name() + "的穴道已經被你封住了，你還怕什么n");

	msg = HIC "$N使出"HIY"銀索金鈴"HIC"的上乘點穴功夫，手中"+ ob->name() +""HIC"罩住了$n的全身要穴, 使$n動彈不得。\n";

	if((me->query_skill("whip")) >= (int)target->query_skill("dodge")) {
		msg += "結果$p的檀中大穴被點，不能動彈！\n" NOR;
		target->start_busy( (int)me->query_skill("yinsuo-jinling",1) / 10 + 2);
		me->add("neili", -150);
	} else {
		msg += HIG "可是$p几經艱難終于躲過了$P的攻擊。\n" NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
