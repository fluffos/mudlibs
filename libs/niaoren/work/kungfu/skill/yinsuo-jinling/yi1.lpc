// dian.c 銀索金鈴 點穴
// By Kayin @ CuteRabbit Studio 1999/3/21 new
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	object ob;		
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("點穴只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "whip")
			return notify_fail("你使用的武器不對。\n");

	if( (int)me->query_skill("yinsuo-jinling", 1) < 120 )
		return notify_fail("你的銀索金鈴不夠純熟，還不能認穴\n");

	if( (int)me->query_skill("tianluo-diwang",1)<100)
		return notify_fail("你的天羅地網勢火候不足，手法還不夠靈活\n");
	if( (int)me->query_skill("yunu-xinjing",1)< 135)
		return notify_fail("你的內功修為太差，勁力無法封閉穴道\n");
	
	if( (int)me->query("max_neili")<1000)
		return notify_fail("你的內力不足以施展點穴功夫.\n");
			
	if ( (int)me->query("neili") < 300 )
		return notify_fail("你的內力不夠點穴。\n");
	me->add("neili", - 300);

	msg = CYN " $N"CYN"手上金鈴"CYN"飛出,使出銀索金鈴的上乘點穴功夫,直取$p"CYN"的大椎穴。\n";

	ob = target->query_temp("weapon");
	if( random( me->query_skill("force") ) > random((int) target->query_skill("force") ) )
	{
		me->start_busy(2);
		if (! objectp(ob))
		{
			int damage = 0;

			if (target->query_skill("dodge") > 200 && random(2) == 0)
			{
				switch (random(2))
				{
				case 0:
					msg += HIR " $p連續變了几種上乘身法，終于沒能躲過，"
						"$N的金鈴正點在$p的檀中穴上，$p只覺得一口"
						"涼氣，自丹田而上，心里有種說不出的難受。\n";
					damage = 3;
					break;
				case 1:
					msg += HIR " $p輕身飄開，身法靈動之極，眾人正要喝彩，"
              					"聽「噗」的一聲，如擊敗革，$p臉色煞白，搖搖欲墜。\n";
					damage = 5;
					break;
				}
			} else
			if (target->query_skill("force") > 200 && random(2) == 0)
			{
				switch(random(2))
				{
				case 0:
					msg += HIR " $p冷哼一聲，自持內力高強，反手出招，「啵」"
						"的一聲輕響，掌鈴相交，$p身行微晃，臉如金紙。\n";
					damage = 3;
					break;
				case 1:
					msg += HIR " $p一聲長嘯，雙手幻化出無數掌影，護住身前。"
						"只聽「嗤」的一聲，掌影頓消，$p已經變得臉色慘白。\n";
					damage = 4;
					break;
				}
			} else
			{
				switch(random(2))
				{
				case 0:
					msg += HIR " $p看到這招，竟然不知躲避，「嗤」的一聲，$N"
						"的金鈴正點在$p的大椎穴上,$p全身酸軟,跌倒在地。\n";
					target->unconcious();
					damage = 0;
					break;
				case 1:
					msg += HIR " $p一轉念，已經想出了九十九種化解的辦法，"
						"尚未來得及施展，只聽「嗤」的一聲，已被$N點中大椎穴,$p全身酸軟,跌倒在地。\n";
					target->unconcious();
					damage = 0;
					break;
				}
			}
			if (damage > 0)
				target->receive_damage("qi", target->query("max_qi") * damage / 12);
			message_vision(msg + NOR, me, target);
			return 1;
		}
		if (ob->query("item_make"))
		{
			msg += HIR " $p忙用" + ob->query("name") + "招架，只覺得虎口劇震，所幸兵器完好無損。\n" NOR;
		} else
		{
			msg += HIW " $p連忙招架，只聽見「啪」地一聲，$p手中的" + ob->name()
				+ "寸寸斷裂，散落一地！\n";
			ob->unequip();
			ob->move(environment(target));
			ob->set("name", "斷掉的" + ob->query("name"));
			ob->set("value", 0);
			ob->set("weapon_prop", 0);
		}
		target->start_busy(2);
	} else
	{
		int busy = 0;
		if (target->query_skill("dodge") > 200 && random(2) == 0)
		{
			switch (random(2))
			{
			case 0:
				msg += " $p一聲輕笑，連續變化了几次身法，擾人耳目，一時讓$N無法進攻。\n";
				busy = 2;
				break;
			case 1:
				msg += " $p突然向后飄去，疾若閃電，令$N所有的后繼變化無從施展。\n";
				busy = 1;
				break;
			}
		} else
		if (target->query_skill("force") > 200 && random(2) == 0)
		{
			switch (random(2))
			{
			case 0:
				msg += " $p臉色凝重，加快格架，以巧對巧，讓$N無從下手，只能收回金鈴。\n";
				busy = 3;
				break;
			case 1:
				msg += " $p滿臉不屑，冷笑一聲，雙掌齊出，其快無比，令$N只能回招自救。\n";
				busy = 1;
				break;
			}
		} else
		{
			switch (random(3))
			{
			case 0:
				msg += " $p左搖右晃，看上去毫無章法，偏偏躲過了$N這一擊。\n";
				busy = 2;
				break;
			case 1:
				msg += " $p金鈴點出，看上去靈動精妙，$N一呆，攻勢頓緩。\n";
				busy = 2;
				break;
			case 2:
				msg += "$p攝住心神，真氣貫注" + ob->query("name")
					 + "，堪堪封住了$N的進攻。\n";
				busy = 2;
				break;
			}
		}
		target->start_busy(busy);
		me->start_busy(4);
	}
	message_vision(msg + NOR, me, target);

	return 1;
}
