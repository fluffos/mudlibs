// daxiao.c

#include <ansi.h>

int exert(object me)
{
	int skill;
	skill = (int)me->query_skill("linji-zhuang",1);

        if (me->query_condition("youming_daxiao"))
                return notify_fail("你已經在運幽冥庄了！\n");

	if (me->query("gender") != "女性")
                return notify_fail("你不是純陰之體，不能運幽冥庄！\n");

	if( me->is_fighting() )
                return notify_fail("戰斗中無法運幽冥庄！\n");

        if( (int)me->query("neili") < 1000)
		return notify_fail("你的真氣不夠。\n");

	if( (int)me->query("jing") < skill + 100)
                return notify_fail("你的精不夠運幽冥庄。\n");

        if( (int)me->query_skill("linji-zhuang",1) < 180)
		return notify_fail("你的臨濟庄級別不夠。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail( "已經受傷過重，無法運功\！\n");

	message_vision(
"$N坐了下來運起幽冥庄，呼吸吐納，真氣直透九重。臉上神色一會變"HIR"紅"NOR"，\n"
"一會變"HIC"青"NOR"，一會又變成"HIY"黃"NOR"色，最后終于回復原來的臉色。\n" NOR, me );
        me->apply_condition("youming_daxiao", (int)skill/20);
        me->add("neili",  -1000);
//	me->add("max_jing", 0 + skill);
	me->add("eff_jing", 0 + skill);
	me->add("jing", 0 + skill);
//	me->add("max_qi", 2 * skill);
	me->add("eff_qi", 2 * skill);
	me->add("qi", 2 * skill);
	me->set("linji/jing", skill);
	return 1;
}

