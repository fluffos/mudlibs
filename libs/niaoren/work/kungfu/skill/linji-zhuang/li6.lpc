  // youming.c
#include <ansi.h>
int exert(object me)
{
	int skill;
	skill = (int)me->query_skill("linji-zhuang",1);
          if (me->query_condition("linji_youming"))
                  return notify_fail("你已經在運幽冥庄了！\n");
	if (me->query("gender") != "女性")
                  return notify_fail("你不是純陰之體，不能運幽冥庄！\n");
	if( me->is_fighting() )
                  return notify_fail("戰斗中無法運幽冥庄！\n");
	if( (int)me->query("neili") < 300)
		return notify_fail("你的真氣不夠。\n");
            if( (int)me->query_skill("linji-zhuang",1) < 300)
		return notify_fail("你的臨濟庄級別不夠。\n");
	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail( "已經受傷過重，無法運功！\n");
	message_vision(
  HIR "$N坐了下來運起幽冥庄，將氣血運行至雙臂....\n"
    "頓感雙手有力了點。\n" NOR, me );
          me->apply_condition("linji_youming", (int)skill/20);
          me->add("neili", -700);
          me->add("eff_jing", 100);
          me->add("jing", 100);
          me->add("str", (int)skill/20);
          me->set("linji/str", (int)skill/20);
	return 1;
}

