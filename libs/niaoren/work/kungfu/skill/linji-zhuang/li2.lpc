// zhixin.c

#include <ansi.h>

int exert(object me)
{
	int skill;
	skill = (int)me->query_skill("linji-zhuang",1);

	if (me->query_condition("linji_zhixin"))
		return notify_fail("你已經在運之心庄了！\n");

	if (me->query("gender") != "女性")
		return notify_fail("你不是純陰之體，不能運之心庄！\n");

	if( me->is_fighting() )
		return notify_fail("戰斗中無法運之心庄！\n");

	if( (int)me->query("neili") < 200)
		return notify_fail("你的真氣不夠。\n");

          if( (int)me->query_skill("linji-zhuang",1) < 80)
		return notify_fail("你的臨濟庄級別不夠。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail( "已經受傷過重，無法運功！\n");

	message_vision(
HIY "$N坐了下來運起之心庄，將手掌在腦門上磕了兩下，頓覺靈台清明，....\n"
"站了起來，發現腦袋瓜靈光了不少。\n" NOR, me );
	me->apply_condition("linji_zhixin", (int)skill/20);
	me->add("neili", -200);
        me->add("eff_jing", 10);
        me->add("jing", 20);
        me->add("int", (int)skill/20);
        me->set("linji/int", (int)skill/20);
	return 1;
}

