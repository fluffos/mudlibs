// fengyun.c

#include <ansi.h>

int exert(object me)
{
	int skill;
	skill = (int)me->query_skill("linji-zhuang",1);

	if (me->query_condition("linji_fengyun"))
		return notify_fail("你已經在運風云庄了！\n");

	if (me->query("gender") != "女性")
		return notify_fail("你不是純陰之體，不能運風云庄！\n");

	if( me->is_fighting() )
		return notify_fail("戰斗中無法運風云庄！\n");

	if( (int)me->query("neili") < 400)
		return notify_fail("你的真氣不夠。\n");

          if( (int)me->query_skill("linji-zhuang",1) < 180)
		return notify_fail("你的臨濟庄級別不夠。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail( "已經受傷過重，無法運功！\n");

	message_vision(
HIC "$N坐了下來運起風云庄，緩緩將內力運到腳心涌泉穴，....\n"
"稍許，覺得一股暖流自足底涌洶涌而上，頓時覺得身輕如燕，躍躍欲飛。\n" NOR, me );
	me->apply_condition("linji_fengyun", (int)skill/20);
	me->add("neili", -400);
        me->add("jing", 20);
	me->add("dex", (int)skill/20);
        me->set("linji/dex", (int)skill/20);
	return 1;
}

