// tiandi.c

#include <ansi.h>

int exert(object me)
{
	int skill;
	skill = (int)me->query_skill("linji-zhuang",1);

	if (me->query_condition("linji_tiandi"))
		return notify_fail("你已經在運天地庄了！\n");

	if (me->query("gender") != "女性")
		return notify_fail("你不是純陰之體，不能運天地庄！\n");

	if( me->is_fighting() )
		return notify_fail("戰斗中無法運天地庄！\n");

	if( (int)me->query("neili") < 100)
		return notify_fail("你的真氣不夠。\n");

	if( (int)me->query_skill("linji-zhuang",1) < 30)
		return notify_fail("你的臨濟庄級別不夠。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
		return notify_fail( "已經受傷過重，無法運功！\n");

	message_vision(
HIM "$N坐了下來運起天地庄，將手掌貼在臉上，緩緩地將真氣輕輕扑在臉上....\n"
"過了不久，$N的臉上亮出晶瑩的顏色，緩緩睜開的眼里透出青春的氣息。\n" NOR,
	me );
	me->apply_condition("linji_tiandi", (int)skill/20);
	me->add("neili", -100);
        me->add("jing", 20);
        me->add("eff_jing", 10);
	me->add("per", (int)skill/20);
	me->set("linji/per", (int)skill/20);
	return 1;
}

