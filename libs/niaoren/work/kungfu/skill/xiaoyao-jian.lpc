//
//xiaoyao-jian  逍遙劍法
//

inherit SKILL;

mapping *action = ({
([      "action" : "$N身形微動，一招「赤練長虹」手中$w化做一道白虹，直刺向$n的胸前",
        "skill_name" : "赤練長虹",
        "force" : 120,
        "dodge" : 5,
        "parry" : 20,
        "lvl" : 0,
        "damage" : 30,
        "damage_type" : "刺傷",
]),
([      "action" : "$N使一招「峰回路轉」，看似漫不經心，忽然一劍直出，$w飛刺$n",
        "skill_name" : "峰回路轉",
        "force" : 160,
        "dodge" : 0,
        "parry" : 8,
        "lvl" : 15,
        "damage" : 40,
        "damage_type" : "刺傷",
]),
([      "action" : "$N輕提$w，舞起朵朵劍花，一招「紛紛揚揚」，刺向$n全身",
        "skill_name" : "大風起兮",
        "force" : 220,
        "dodge" : 10,
        "parry" : 15,
        "lvl" : 30,
        "damage" : 50,
        "damage_type" : "刺傷",
]),
([      "action" : "$N腳步輕移，身形飄忽，一招「風吹落花」，$w同是刺向$n的各處要害",
        "skill_name" : "北燕南飛",
        "force" : 240,
        "dodge" : 10,
        "parry" : 20,
        "lvl" : 50,
        "damage" : 50,
        "damage_type" : "刺傷",
]),
([      "action" : "$N身形變幻，反手一劍，一招「回看風云」，急刺$n胸前",
        "skill_name" : "回看風云",
        "force" : 270,
        "dodge" : 20,
        "parry" : 15,
        "lvl" : 80,
        "damage" : 60,
        "damage_type" : "刺傷",
]),
([      "action" : "$N使出一招「笑看春風」，看似輕描淡寫，卻處處擊向$n全身要穴",
        "skill_name" : "笑看春風",
        "force" : 300,
        "dodge" : 35,
        "parry" : 50,
        "lvl" : 100,
        "damage" : 60,
        "damage_type" : "刺傷",
]),
([      "action" : "$N使一式「月光滿地」，$w舞成一道劍光，處處迷茫著劍氣，攻向$n",
        "skill_name" : "月光滿地",
        "force" : 300,
        "dodge" : 40,
        "parry" : 70,
        "lvl" : 130,
        "damage" : 80,
        "damage_type" : "刺傷",
]),
([      "action" : "$N勁運于$w,一招「無聲無息」，$w卻以極慢的速度直直向$n刺去   ",
        "skill_name" : "無聲無息",
        "force" : 500,
        "dodge" : 40,
        "parry" : 70,
        "lvl" : 150,
        "damage" : 100,
        "damage_type" : "刺傷",
]),


});


int valid_enable(string usage) { return usage == "sword" ; }


int valid_learn(object me)
{
	if ((int)me->query_skill("blade", 1) >= 30)
		return 1;
	else if ((int)me->query_skill("sword", 1) < 30)
		return notify_fail("你的基本劍法太差了，練不了逍遙劍法。\n");
	}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("xiaoyao-dao",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 20)
		return notify_fail("你的體力不夠，練不了逍遙劍法。\n");
	me->receive_damage("qi", 30);
	return 1;
}

