int valid_learn(object me)
{
    object ob;
//   if( (string)me->query("gender") != "女性" )
//   return notify_fail("九陰赤煉劍法是只有女子才能練的武功。\n");
    if( (int)me->query("max_neili") < 50 )
        return notify_fail("你的內力不夠，沒有辦法練衡山劍法。\n");
//   if( (string)me->query_skill_mapped("force")!= "zixia-shengong")
//        return notify_fail("華山劍法必須配合紫霞神功才能練。\n");
    if( !(ob = me->query_temp("weapon"))
    ||      (string)ob->query("skill_type") != "sword" )
        return notify_fail("你必須先找一把劍才能練劍法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30
    ||      (int)me->query("neili") < 5 )
        return notify_fail("你的內力或氣不夠，沒有辦法練習衡山劍法。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -5);
    write("你按著所學練了一遍衡山劍法。\n");
    return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

string perform_action_file(string action)
{
        return __DIR__"hengshan-sword/" + action;
}
