// qingdie-shenfa.c 輕蝶身法
// pal 1997.05.26
inherit SKILL;

string *dodge_msg = ({
	"只見$n一招「蝶舞泉邊」，身形飄忽不定，躲過了$N這一招。\n",
	"$n一式「憑虛臨風」，身形晃動，向一旁飄出，避開了$N這一招。。\n"
	"$n使出「蝶隨風飛」，一個空心筋斗向后翻出，避開了$N的凌厲攻勢。\n",
	"$n一招「雙香鳳蝶」，身隨意轉，$N只覺眼前一花，$n已繞至$N的身后。\n",
});
int valid_enable(string usage)
{
	return (usage == "dodge") || (usage == "move");
}
int valid_learn(object me)
{
         if(me->query_skill("dodge",1)<10)
		return notify_fail("你的基本輕功火候不夠。\n");
	return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的體力太差了，不能練青蝠身法。\n");
        me->receive_damage("qi", 30);
        return 1;
}

