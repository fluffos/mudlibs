// wuhu-duanmendao.c 五虎斷門刀

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w斜指，一招「直來直去」，反身一頓，一刀向$n的$l撩去",
        "force" : 120,
        "dodge" : -10,
        "parry" : 5,
        "damage" : 15,
        "damage_type" : "割傷"
]),
([      "action" : "$N一招「童子挂畫」，左右腿虛點，$w一提一收，平刃揮向$n的頸部",
        "force" : 130,
        "dodge" : -10,
        "parry" : 10,
        "damage" : 20,
        "damage_type" : "割傷"
]),
([      "action" : "$N展身虛步，提腰躍落，一招「推窗望月」，刀鋒一卷，攔腰斬向$n",
        "force" : 140,
        "dodge" : -5,
        "parry" : 5,
        "damage" : 25,
        "damage_type" : "割傷"
]),
([      "action" : "$N一招「力劈華山」，$w大開大闔，自上而下划出一個閃電，直劈向$n",
        "force" : 160,
        "dodge" : 5,
        "parry" : 5,
        "damage" : 30,
        "damage_type" : "割傷"
]),
([      "action" : "$N手中$w一沉，一招「臨溪觀魚」，雙手持刃攔腰反切，砍向$n的胸口",
        "force" : 180,
        "dodge" : 10,
        "parry" : 5,
        "damage" : 35,
        "damage_type" : "割傷"
]),
([      "action" : "$N揮舞$w，使出一招「張弓望的」，上劈下撩，左擋右開，齊齊罩向$n",
        "force" : 210,
        "dodge" : 15,
        "parry" : 15,
        "damage" : 45,
        "damage_type" : "割傷"
]),
([      "action" : "$N一招「風送輕舟」，左腳躍步落地，$w順勢往前，挾風聲劈向$n的$l",
        "force" : 240,
        "dodge" : 5,
        "parry" : 15,
        "damage" : 50,
        "damage_type" : "劈傷"
]),
([      "action" : "$N盤身駐地，一招「川流不息」，揮出一片流光般的刀影，向$n的全身涌去",
        "force" : 280,
        "dodge" : 20,
        "parry" : 10,
        "damage" : 60,
        "damage_type" : "刺傷"
]),
([      "action" : "$N右手后撤，手腕一翻，一招「壯士斷腕」，頓時一道白光直斬向$n的手臂",
        "force" : 320,
        "dodge" : 20,
        "parry" : 20,
        "damage" : 70,
        "damage_type" : "砍傷"
]),
([      "action" : "$N高高躍起，一招「人頭落地」，手中$w直劈向$n的頸部",
        "force" : 320,
        "dodge" : 20,
        "parry" : 20,
        "damage" : 70,
        "damage_type" : "劈傷"
]),
([      "action" : "$N貼地滑行，一招「斷子絕孫」，手中$w直撩去$n的襠部",
        "force" : 350,
        "dodge" : 30,
        "parry" : 30,
        "damage" : 80,
        "damage_type" : "割傷"
]),
});


int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的內力不夠。\n");
        if ((int)me->query_skill("blade", 1) < 20)
                return notify_fail("你的基本刀法火候太淺。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
int zhaoshu, level;

zhaoshu = sizeof(action)-1;
level   = (int) me->query_skill("wuhu-duanmendao",1);

if (level < 60 )
zhaoshu--;
if (level < 50 )
zhaoshu--;
if (level < 40 )
zhaoshu--;
if (level < 30 )
zhaoshu--;
if (level < 20 )
zhaoshu--;
if (level < 10 )
zhaoshu--;
return action[random(zhaoshu)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不對。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的體力不夠練五虎斷門刀法。\n");
        me->receive_damage("qi", 30);
        return 1;
}

string exert_function_file(string func)
{
        return __DIR__"wuhu-duanmendao/" + func;
}
string perform_action_file(string action) {
    return __DIR__"wuhu-duanmendao/" + action;
}
