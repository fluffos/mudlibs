int valid_enable(string usage)
{
	return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me)
{
	mapping my_fam  = me->query("family");
	if(my_fam["generation"] != 13)
		return notify_fail("你不是風清揚的弟子，不能學習「獨孤九劍」。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的內力不夠。\n");

	if ((int)me->query_skill("dugu-jiujian",1) > 60)
		return notify_fail("這套劍法我就教到這兒，以后就要靠你自己練了。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

string query_parry_msg(string limb)
{
	return parry_msg[random(sizeof(parry_msg))];
}

int practice_skill(object me)
{
	return notify_fail("獨孤九劍只能通過「總訣式」來演練。\n");
}

string perform_action_file(string action)
{
	return __DIR__"dugu-jiujian/" + action;
}
