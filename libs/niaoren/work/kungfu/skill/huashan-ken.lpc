// huashan-ken.c 華山拳法
// Modified by Venus Oct.1997

inherit SKILL;

mapping *action = ({
    ([  "action":      "$N使一招「云里乾坤」左拳擊出，不等招式使老，右拳已從左拳之底穿出，對准$n的$l「呼」地一拳",
   "dodge":   -40,
   "parry":   40,
   "damage_type":  "瘀傷"
    ]),
    ([  "action":      "$N左拳突然張開，拳開變掌，直擊化為橫掃，一招「霧里看花」便往$n的$l招呼過去",
   "dodge":   -30,
   "parry":   30,
   "damage_type":  "瘀傷"
    ]),
    ([  "action":      "$N兩手虎口相對，往內一圈，一招「金鼓齊鳴」往$n的$l擊出",
   "dodge":   -30,
   "parry":   30,
   "damage_type":  "瘀傷"
    ]),
    ([  "action":      "$N步履一沉，左拳虛晃一招，右拳使出「梅花弄影」擊向$n$l",
   "dodge":   -30,
   "parry":   30,
   "damage_type":  "瘀傷"
    ]),
});

int valid_learn(object me)
{
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
   return notify_fail("練華山拳法必須空手。\n");
    return 1;
}

int valid_enable(string usage)
{
    return usage=="unarmed" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30 )
   return notify_fail("你的體力不夠了，休息一下再練吧。\n");
    me->receive_damage("qi", 30);
    return 1;
}

