// hua.c 化骨綿掌

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;

	if( !target ) target = offensive_target(me);

	if( environment(me)->query("no_fight") )
		return notify_fail("這里不能攻擊別人! \n");

	if( !target || !target->is_character() )
		return notify_fail("辣手化骨只能對對手使用。\n");

	if( (int)me->query_skill("shenlong-xinfa", 1) < 50 )
		return notify_fail("你的神龍心法不夠嫻熟，不能化骨。\n");

	if( (int)me->query_skill("huagu-mianzhang", 1) < 40 )
		return notify_fail("你的化骨綿掌不夠嫻熟，不能化骨。\n");

	if( (int)me->query("neili", 1) < 300 )
		return notify_fail("你的內力不夠，不能化骨。\n");

        me->add("neili", -100);

	msg = MAG "$N掌出如風輕輕落在$n肩頭上。\n"NOR;

	me->start_busy(1);
	if( random( (int)me->query_skill("huagu-mianzhang",1))
          > random(target->query_skill("dodge"))/2 )
        {
		msg += MAG "結果只聽扑的一聲，$p被$P一掌拍中！\n" NOR;
		msg += MAG "$p只覺得全身暖洋洋的，感到有點輕飄無力輕。\n" NOR;
		target->add_temp("apply/attack", -1);
		target->add_temp("apply/dodge", -1);
		target->add_temp("apply/defense", -1);
	} else {
		msg += CYN"可是$p急忙閃在一旁，躲了開去。\n" NOR;
		me->start_busy(3);
	}
	message_combatd(msg, me, target);
	if( !target->is_fighting(me) ) target->fight_ob(me);
	return 1;
}
