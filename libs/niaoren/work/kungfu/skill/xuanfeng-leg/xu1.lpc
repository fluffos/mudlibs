// kuangfeng.c  狂風絕技

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
        string msg, string1;
        int count;
 
	if( !me->is_fighting() )
		return notify_fail("「狂風絕技」只能在戰斗中使用。\n");
 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("「狂風絕技」開始時不能拿著兵器！\n");

	if( (int)me->query("neili") < 100 )
		return notify_fail("你的真氣不夠！\n");

	if( (int)me->query_skill("bibo-shengong",1) < 50 )
		return notify_fail("你的碧波神功不夠！\n");

	if( (int)me->query_skill("luoying-zhang",1) < 100 ||
	    me->query_skill("xuanfeng-leg",1) < 100)
		return notify_fail("你的腿掌功夫還不到家，無法使用狂風絕技！\n");

	msg = HIY "$N使出桃花島絕技「狂風絕技」，身法陡然加快！\n" NOR;
	message_combatd(msg, me);

	me->clean_up_enemy();
	ob = me->select_opponent();

	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

	me->add("neili", -100);
	me->start_busy(2);

	if(!ob->is_fighting(me)) ob->fight_ob(me);
	return 1;
}
string perform_action_file(string action)
{
    return __DIR__"xuanfeng-leg/" + action;
}
