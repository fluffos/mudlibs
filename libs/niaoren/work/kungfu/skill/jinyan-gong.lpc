inherit SKILL;
#include <ansi.h>
string *dodge_msg = ({
	"$n身形晃動，使出一招"HIM" 出有入無 "NOR"，似左實右，忽前忽后，若有若無的閃過$N的攻擊。\n",
	"$n突然身子一縮，一招"HIB"藏形匿跡"NOR"，人已在三尺之外。\n",
	"可是$n一招"HIR" 飛靈八方 "NOR"猛然縱起丈余，身形晃動，躲過了$N的攻勢。\n",
	"只見$n左走三步，又向右斜跨兩步，一招"HIW" 隱景舞天 "NOR"，不知怎的$n已經到了$N的身后。\n",
	"$n不住倒退，忽然身形晃動，一招"RED" 解行遁變 "NOR"轉到了$N的身側。\n",
	"$n身隨意走，一招"YEL" 棄厄飛霄 "NOR"躲過了$N的凌厲攻勢。\n",
	"$n腳下一點，一招"HIY" 回神轉玄 "NOR"斜斜的飛出恰巧躲開了$N的進攻。\n",
	"$n一招"MAG" 乘虛御空 "NOR"側身一讓，$N這招扑了個空。\n",
});

int valid_enable(string usage) { return (usage == "dodge") ;}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的體力太差了，不能練金雁功。\n");
        me->receive_damage("qi", 30);
        return 1;
}

