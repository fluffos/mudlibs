	"force" : 180,
        "dodge" : 5,
	"damage": 10,
	"damage_type" : "抓傷",
	"lvl" : 0,
	"skill_name" : "橫空出世"
]),
([	"action" : "$N左手虛晃，一式「靈猴攀枝」，右手直擊，反扣$n的肩井大穴",
	"force" : 200,
        "dodge" : 10,
	"damage": 20,
        "lvl" : 8,
        "skill_name" : "靈猴攀枝",
        "damage_type" : "瘀傷"
]),
([	"action" : "$N一臂前伸，一臂后指，一式「猿臂輕舒」，攻向$n的兩肋",
	"force" : 230,
        "dodge" : 10,
	"damage": 25,
	"lvl" : 15,
	"skill_name" : "猿臂輕舒",
        "damage_type" : "瘀傷"
