// hui.c 揮斥方遒
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
	string msg;
	object weapon, target;
	int skill, dp, di, wound;

	me->clean_up_enemy();
	target = me->select_opponent();

	skill = me->query_skill("tanzhi-shentong",1);

	if( !(me->is_fighting() ))
		return notify_fail("「揮斥方遒」只能在戰斗中使用。\n");

	if ( objectp(weapon = me->query_temp("weapon")))
		return notify_fail("你使用了武器。\n");

	if( skill < 50)
		return notify_fail("你的彈指神通等級不夠, 不能使用「揮斥方遒」！\n");

	if( me->query("neili") < 150 )
		return notify_fail("你的內力不夠，無法運用「揮斥方遒」！\n");
 
	msg = HIC "$N使出彈指神通之「揮斥方遒」, 頓時眼內精光暴射，\n";
	message_vision(msg, me, target);
	di = me->query_skill("tanzhi_shentong") / 15;
	dp = target->query_skill("force") / 10;
	if( di < 1 )
		di = 1;
	if( dp < 1 )
		dp = 1;
	if( random(skill) > (dp - di) )
	{
		if(userp(me))
			me->add("neili",-150);
		msg = "$n只覺得眼前一花，氣海穴上微微一痛，全身真氣狂泄而出！\n" NOR;

		wound = -(skill+random(200)*7);
		if((int)target->query("neili") < wound)
			wound = target->query("neili");
		target->add("neili", wound);
		target->add("jing", wound / 5);
		target->start_busy(2);
		me->start_busy(2);
	}
	else
	{
		msg = "可是$n的看破了$N的企圖，立刻采取守勢，使$P的「揮斥方遒」沒有起到作用。\n"NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
