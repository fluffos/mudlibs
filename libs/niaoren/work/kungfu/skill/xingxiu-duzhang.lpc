// xingxiu-duzhang.c, based on xianglong-zhang.c
// by yucao

#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action": "$N臉上露出詭異的笑容，隱隱泛出綠色的雙掌掃向$n的$l",
        "dodge": 30,
        "force": 440,
//      "poison": 80,
        "damage_type": "瘀傷"
]),
([      "action": "$N突然身形旋轉起來扑向$n，雙掌飛舞著拍向$n的$l",
        "dodge": 10,
        "force": 370,
//      "poison": 60,
        "damage_type": "瘀傷"
]),
([      "action": "$N將毒質運至右手，一招「腐尸毒」陰毒無比地抓向$n的$l",
        "dodge": -20,
        "force": 230,
//      "poison": 100,
        "damage_type": "瘀傷"
]),
([      "action": "$N雙掌挾著一股腥臭之氣拍向$n的$l",
        "dodge": 10,
        "force": 300,
//      "poison": 80
        "damage_type": "瘀傷"
]),
});

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

mapping query_action(object me)
{
        if (random(me->query_skill("unarmed")) > 60 &&
            me->query_skill("force") > 50 &&
            me->query("neili") > 100 ) {
                me->add("neili", -100);
                return ([
                "action": "$N咬破舌尖，口中噴血，聚集全身的力量擊向$n",
                "force": 300,
                "damage_type": "瘀傷"]);
        }
        return action[random(sizeof(action))];
}

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("練星宿毒掌必須空手。\n");
        if ((int)me->query_skill("huagong-dafa", 1) < 10)
                return notify_fail("你的化功大法火候不夠，無法練星宿毒掌。\n");
        if ((int)me->query("max_neili") < 60)
                return notify_fail("你的內力太弱，無法練星宿毒掌。 \n");
        return 1;
}


int practice_skill(object me)
{
        if ((int)me->query("qi") < 30)
                return notify_fail("你的體力太低了。\n");
        if ((int)me->query("neili") < 8)
                return notify_fail("你的內力不夠練星宿毒掌。\n");
        if (me->query_skill("xingxiu-duzhang", 1) < 50)
                me->receive_damage("qi", 20);
        else
                me->receive_damage("qi", 30);
        me->add("neili", -5);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
                //if( random(me->query_skill("huagong-dafa")) > (damage_bonus + foo)/3 )
        if( random(me->query_skill("huagong-dafa")) > 10 ) {
                //victim->receive_wound("qi", (damage_bonus + foo));
            victim->apply_condition("xx_poison", random(me->query_skill("huagong-dafa")/10) + 1 +
                        victim->query_condition("xx_poison"));
        }
}

string perform_action_file(string action)
{
        return __DIR__"xingxiu-duzhang/" + action;
}
