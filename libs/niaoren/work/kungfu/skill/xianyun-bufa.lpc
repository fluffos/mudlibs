// xianyun-bufa.c 纖云步法
// By Kayin @ CuteRabbit Studio 1999/3/15
inherit SKILL;
#include <ansi.h> 
mapping *action = ({
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"身不傾，腳不移，身體如行云流水般直滑出丈余。\n",
	"dodge"  : 50,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"忽然一彎腰，全身貼地而行，頓時閃過了$N的凌厲攻勢。\n",
	"dodge"  : 100,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"足不動，手不抬，一轉眼間便繞到了$N的身后。\n",
	"dodge"  : 150,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"一轉身間，四面八方飄動著無數個$n的身影，令$N手足無措。\n",
	"dodge"  : 200,
]),	
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"左踏巽，右轉乾，身行一晃，便到几丈遠的地方。\n",
	"dodge"  : 250,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"身在空中，左腳在右足上一點，從$N頭頂騰空而過。\n",
	"dodge"  : 300,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"長袖一拂，全身化為一道白影，幽幽地從$N頭頂飄落。\n",
	"dodge"  : 350,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"身體如陀螺般急轉，登時一股氣流涌出，令$N難以動彈。\n",
	"dodge"  : 400,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"身行倏的從$N的眼前直繞到身后，$N瞪大了兩眼，不明所以。\n",
	"dodge"  : 450,
]),
([	"action" : "$n"NOR"使出"HIC" 纖云步法 "NOR"身行倏的從$N的眼前飄過，長發一甩，瀟洒之極。\n",
	"dodge"  : 500,
]),
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("xianyun-bufa");


	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge";
}


string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的體力太差了，不能練纖云步法。\n");
	me->receive_damage("qi", 20);
	return 1;
}
