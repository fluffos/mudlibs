// jinshe-zhang.c
inherit SKILL;
mapping *action = ({
        ([      "name" :  "千蛇出洞",
                "action": "$N雙掌一錯，一招「千蛇出洞」幻出漫天掌影攏向$n的$l",
                "dodge":  30,
                "parry":  10,
                "damage": 50,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "魔吼天地",
                "action": "$N暴喝一聲，雙掌連環推出，一招「大沼龍蛇」強勁的掌風直扑$n的$l",
                "dodge":  30,
                "parry":  10,
                "damage": 50,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "雙蛇搶珠",
                "action": "$N雙掌紛飛，一招「雙蛇搶珠」直取$n的$l",
                "dodge":  10,
                "parry":  30,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "游走式",
                "action": "$N提氣纏身游走，一招「游走式」，森森掌風無孔不入般地擊向$n的$l",
                "dodge":  10,
                "parry":  50,
                "damage": 70,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "盤身式",
                "action": "$N盤身錯步，雙掌平推，凝神聚氣，一招「盤身式」拍向$n的$l",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "金蛇吐舋",
                "action": "$N左掌立于胸前，右掌推出，一招「金蛇吐舋」擊向$n$l",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "金蛇翻身咬",
                "action": "$N使出「金蛇翻身咬」，身形凌空飛起，從空中當頭向$n的$l出掌攻擊",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "杯弓蛇影",
                "action": "$N使出一招「杯弓蛇影」，左掌化虛為實擊向$n的$l",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "金蛇纏絲手",
                "action": "$N左掌畫了個圈圈，右掌推出，一招「金蛇纏絲手」擊向$n$l",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "靈蛇游八方",
                "action": "$N使出「靈蛇游八方」，身形散作八處同時向$n的$l出掌攻擊",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "金蛇探頭",
                "action": "$N使出金蛇游身掌法「金蛇探頭」，如鬼魅般欺至$n身前，一掌拍向$n的$l",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
        ([      "name" :  "金龍升天",
                "action": "$N內氣上提，全身拔起，一招「金龍升天」，雙掌凌空拍下，$n的全身都被籠罩在掌力之下",
                "dodge":  30,
                "parry":  70,
                "damage": 30,
                "damage_type":  "瘀傷"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("練金蛇游身掌必須空手。\n");
        if( (int)me->query("max_neili", 1) < 500)
                return notify_fail("你的內力不足，無法練金蛇游身掌。\n");
        return notify_fail("金蛇游身掌沒法教授。\n");
}

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 30 )
                return notify_fail("你的體力不夠了，休息一下再練吧。\n");
        if( (int)me->query("neili") < 5 )
                return notify_fail("你的內力不夠了，休息一下再練吧。\n");
        me->receive_damage("qi", 30);
        me->add("force", -5);
        return 1;
}
int effective_level() { return 10;}
 
string *parry_msg = ({
        "$n使出「粘」字訣，雙掌一划，引偏了$N的$w。\n",
});

string *unarmed_parry_msg = ({
        "$n施展出金蛇游身掌，輕描淡寫的化解了$N的攻勢。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
        return __DIR__"jinshe-zhang/" + action;
}

