// cimu.c  辟邪劍法「刺目」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;

    if (!target ) target = offensive_target(me);
    if (!target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「刺目」只能對戰斗中的對手使用。\n");
    if ((int)me->query_skill("pixie-jian", 1) < 80 )
        return notify_fail(WHT"你辟邪劍法不夠嫻熟，使不出「刺目」。\n"NOR);
    if ((int)me->query("max_neili")<400)
        return notify_fail(RED"你內力修為不足，無法運足內力。\n"NOR);
    if ((int)me->query("neili")<200)
    {
        return notify_fail(HIC"你現在內力不夠，沒能將「刺目」使完！\n"NOR);
    }
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
       msg = HIC "$N左手兩指并攏，手臂暴長，迅捷異常分刺$n雙目，\n"NOR;
    else
       msg = HIC "$N手中長劍一振，劍尖一點暴長，分刺$n左右雙目，\n"NOR;
    if (random(me->query_skill("force")) > target->query_skill("force")/2|| 
       random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
    {
        me->start_busy(2);
        target->start_busy(random(4));
        damage = (int)me->query_skill("pixie-jian", 1) + (int)me->query_skill("sword", 1)/2;
        damage = damage/2 + random(damage);
        target->receive_damage("qi", damage);
        target->receive_wound("qi", damage/2);
        msg += HIC"$n只看到寒尖一點，雙目一陣劇痛，眼前一黑，就什么也看不見了，頓時長聲痛極而呼！\n"NOR;
        message_combatd(msg, me, target);
        me->add("neili", -damage/5);
        me->set_temp("pixie/cimu", 1);
        target->set_temp("block_msg/all",1);
        call_out("cimu_end", (int) 2+random(6), me, target);
    } else
    {
        me->start_busy(2);
        msg += HIY"$p情急智生，抬手也$P右眼刺去，迫得$P回劍躍開。\n"NOR;
        message_combatd(msg, me, target);
    }
    if(!target->is_fighting(me)) target->fight_ob(me);
//    if(userp(target)) target->fight_ob(me);
//    else if( !target->is_killing(me->query("id")) ) target->kill_ob(me);
    return 1;
}

void cimu_end(object me, object target)
{
        target->enable_player();
        message_combatd("$N抹了抹流著"HIR"鮮血"NOR"，終于能看見了。\n", target);
        target->set_temp("block_msg/all", 0);
        write(HIR"你終于抹掉了眼前的鮮血，能看見了。\n"NOR);
        me->delete_temp("pixie/tuwu");

        return;
}
