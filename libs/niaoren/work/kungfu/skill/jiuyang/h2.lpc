// lifeheal.c

#include <ansi.h>

int exert(object me, object target)
{
	if( !target )
		return notify_fail("你要用真氣為誰療傷？\n");

	if( me->is_fighting() || target->is_fighting())
		return notify_fail("戰斗中無法運功療傷！\n");
	if(target == me)
		return notify_fail("你可以用yun heal 來為自己療傷。\n");

	if ((int)me->query_skill("jiuyang", 1) < 40)
		return notify_fail("你的九陽神功修為還不夠。\n");

	if( (int)me->query("max_neili") < 300 )
		return notify_fail("你的內力修為不夠。\n");

	if( (int)me->query("neili") < 100 )
		return notify_fail("你的真氣不夠。\n");

	if( (int)target->query("eff_qi") < (int)target->query("max_qi") / 9 )
		return notify_fail( target->name() +
			"已經受傷過重，經受不起你的真氣震蕩！\n");

	if( (int)target->query("eff_qi") == (int)target->query("max_qi"))
		return notify_fail( target->name() +"并沒有受傷。\n");

	message_vision(
		HIR "$N盤膝坐下來運起九陽神功，緩緩將手掌貼在$n胸前，將真氣緩緩輸入$n體內...\n\n"
		"不久，$N收回雙掌，$n吐出一口瘀血，感覺傷勢好多了。\n" NOR,
		me, target );

	target->receive_curing("qi", 10 + (int)me->query_skill("force")/3 );
	target->add("qi", 10 + (int)me->query_skill("force")/3 );
	if( (int)target->query("qi") > (int)target->query("eff_qi") ) target->set("qi", (int)target->query("eff_qi"));

	me->add("neili", -100);
	me->set("jiali", 0);


	return 1;
}
