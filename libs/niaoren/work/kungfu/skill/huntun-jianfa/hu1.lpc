// sanfive.c  混沌劍法 [混沌五殺]

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
    string msg, string1;
    int count;
 
    if( !me->is_fighting() )
            return notify_fail("「混沌五殺」只能在戰斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不對。\n");

        if((int)me->query_dex() < 30)
                return notify_fail("你的身法不夠, 目前還不能使用這項絕技! \n");

        if((int)me->query_skill("taiji-shengong",1) < 200)
                return notify_fail("你的太極神功的修為不夠, 不能使用這項大絕技 !\n");

        if((int)me->query_skill("dodge") < 200)
                return notify_fail("你的輕功修為不夠, 不能使用混沌五殺！\n");
 
        if((int)me->query_skill("sword") < 135)
                return notify_fail("你的劍法修為不夠， 目前不能使用混沌五殺! \n");

    if( (int)me->query("neili") < 500 )
                return notify_fail("你的真氣不夠！\n");


    msg = HIG "$N使出混沌劍法的最強絕技「"MAG"混沌五殺"HIM"」，身法陡然加快！\n" NOR;
    message_vision(msg, me);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


        me->add("neili", -150);
        me->start_busy(random(2));

    return 1;
}
