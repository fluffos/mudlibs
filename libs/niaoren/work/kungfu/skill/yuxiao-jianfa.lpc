// adx 22:13 99-2-10
inherit SKILL;

mapping *action = ({
([	"action" : "$N身形一轉，手中的$w划了個半圈，一式「朝朝暮暮」刺向$n的$l",
	"force" : 60,
	"dodge" : 10,
	"parry" : 5,
	"damage" : 30,
        "lvl" : 0,
	"damage_type" : "刺傷"
]),
([	"action" : "$N左掌橫推，一式「羞花碧月」，$w向前疾出，指向$n的面門",
	"force" : 120,
	"dodge" : 15,
	"parry" : 10,
	"damage" : 60,
        "lvl" : 4,
	"damage_type" : "刺傷"
]),
([	"action" : "$N手中的$w划了個半圈，一式「風花雪夜」，向$n的$l划過",
	"force" : 180,
	"dodge" : 20,
	"parry" : 15,
	"damage" : 90,
        "lvl" : 9,
	"damage_type" : "刺傷"
]),
([	"action" : "$N雙目微睜，一式「怒濤驚魂」，$w泛出几個圓弧，一起刺向$n的$l",
	"force" : 250,
	"dodge" : 25,
	"parry" : 20,
	"damage" : 120,
        "lvl" : 14,
	"damage_type" : "刺傷"
]),
([	"action" : "$N身形躍起，手臂微抬，一式「曾經滄海」，蓄勢捺向$n的$l",
	"force" : 320,
	"dodge" : 30,
	"parry" : 25,
	"damage" : 150,
        "lvl" : 19,
	"damage_type" : "刺傷"
]),
([  "action" : "$N回身擰腰，右手虛抱，一招「推波助瀾」，$w中宮直進，刺向$n的$l",
	"force" : 400,
	"dodge" : 35,
	"parry" : 30,
	"damage" : 180,
        "lvl" : 149,
	"damage_type" : "刺傷"
]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的內力不夠。\n");
	if ((int)me->query_skill("bibo-shengong", 1) < 150)
		return notify_fail("你的碧波神功火候太淺。\n");
	if ((int)me->query_skill("luoying-shenjian", 1) < 100)
		return notify_fail("你的落英神劍火候太淺。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("yuxiao-jianfa",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力不夠練玉蕭劍法。\n");
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yuxiao-jianfa/" + action;
}
