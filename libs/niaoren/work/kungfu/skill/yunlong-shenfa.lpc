// yunlong-shenfa 云龍身法

inherit SKILL;

mapping *action = ({
([	"action" : "$n一式「龍騰虎躍」，身行一轉，猛的跳向一旁,躲過了$N的功勢。\n",
	"dodge"  : 10
]),
([	"action" : "$n一式「沙場點兵」，雙臂置于身后，不急不緩，昂首從$N眼前跨過。\n",
	"dodge"  : 20
]),
([	"action" : "$n一式「風雨同舟」，不退反進，一下子繞到了$N的身后。\n",
	"dodge"  : 30
]),
([	"action" : "$n一式「養精蓄銳」，緩緩的向后一退，輕松讓過了$N的凌厲攻勢。\n",
	"dodge"  : 40
]),
([	"action" : "$n一式「無心插柳」，左手一揚，身行一晃，便向右飄出丈遠。\n",
	"dodge"  : 50
]),
([	"action" : "$n一式「蒼鷹搏兔」，身體如一只蒼鷹，呼的一聲從$N的眼前飛過。\n",
	"dodge"  : 60
]),
([	"action" : "$n一式「九龍在天」，忽的拔地而起，在半空中一轉，已落到几丈遠的地方。\n",
	"dodge"  : 80
]),
([	"action" : "$n一式「瀑落九天」，全身化為一道白影，忽的一個空翻，從左邊飄到右邊。\n",
	"dodge"  : 90
]),
([	"action" : "$n一式「幻眼云煙」，身形陡地變得飄忽不定，令$N無法看清。\n",
	"dodge"  : 100
]),
([	"action" : "$n一式「九天攬月」，宛若一條矯矢蒼龍，倏的拔地而起，令$N不敢仰視。\n",
	"dodge"  : 120
])
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("yunlong-shenfa");

	if (level < 70 )
		zhaoshu--;

	if (level < 50 )
		zhaoshu--;

	if (level < 40 )
		zhaoshu--;

	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的體力太差了，不能練云龍身法。\n");
	me->receive_damage("qi", 20);
	return 1;
}
