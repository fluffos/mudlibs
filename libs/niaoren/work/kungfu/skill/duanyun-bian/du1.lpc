// riyue.c 斷云鞭法[日月無光]

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("牽制攻擊只能對戰斗中的對手使用。\n");

	if( (int)me->query_skill("duanyun-bian",1) < 135)
		return notify_fail("你的「斷云鞭法」還沒學到家，用不了「日月無光」。\n");

	if( (int)me->query_skill("xiantian-gong",1) < 140)
		return notify_fail("你的「先天神功」不夠純熟，用不了「日月無光」。\n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顧不暇，放膽攻擊吧。\n");

	msg = HIC "$N"HIC"使出斷云鞭法的絕招"HIM"「日月無光」"HIC"連揮數鞭企圖把$n"HIC"的全身纏繞起來。\n";

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 ) {
		msg += "結果$p被$P攻了個措手不及。\n" NOR;
		target->start_busy( (int)me->query_skill("duanyun-bian") / 30 +3);
		me->start_busy(random(2));
		me->add("neili", -200);
	} else {
		msg += "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
