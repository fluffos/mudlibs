// duo.c 聖火令法「吸焰」令

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon,weapon2;
        string msg;
        int    iDuo;

        weapon2 = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("聖火令法「吸焰」令只有在戰斗中施用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "lingfa")
                        return notify_fail("你使用的武器不對。\n");

        if (!objectp(weapon = target->query_temp("weapon")))
                return notify_fail("對方手中沒有武器，你使出這招「吸焰令」后自覺象個傻瓜。\n");


        if( target->is_busy() )
                return notify_fail(target->name() + "目前正自顧不暇，放膽攻擊吧  \n");
                
        if( (int)me->query_skill("shenghuo-lingfa", 1) < 40 )
                return notify_fail("你的聖火令法不夠嫻熟，使不出「吸焰」令。\n");

        msg = HIY"$N使出聖火令法「吸焰」令，連遞數個鬼魅般的招式向$n的手腕纏繞。\n"NOR;

        me->start_busy(1);

        if( (string)weapon2->query("id") == "shenghuo-ling" ) 
                iDuo = 3 ;
        else 
                iDuo =2 ;

        if( (int)me->query("combat_exp") > (int)target->query("combat_exp")/(iDuo-random(1)) ) {

                msg += HIR"$n頓時覺得雙手運作不靈，忽然手腕一麻，手中";
                msg += weapon->name();
                msg += "竟然不易而飛！\n";
                msg += "細看時，已被$N收納入了懷中！\n"NOR;

                target->start_busy(2);
                weapon->move(me);
        } else {
                msg += "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
        }


        message_vision(msg, me, target);

        return 1;
}
