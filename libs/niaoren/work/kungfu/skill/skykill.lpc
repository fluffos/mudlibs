// skykill.c 驚天六絕殺
#include <ansi.h>
inherit SKILL;
mapping *action = ({
([	"action" : "$N大喝一聲"HIY"【驚天六絕殺】"NOR"之"HIY"【疾如風】"NOR"，手中$w如狂風般地向$n的$l疾刺，使得$n的$l"HIM"劍痕累累"NOR,
          "damage" : (int)this_player()->query("str")*50000,
          "attack" : (int)this_player()->query("str")*50000,
          "lvl" : 1,
	"damage_type" : "刺傷"
]),
([	"action" : "$N大喝一聲"HIY"【驚天六絕殺】"NOR"之"HIG"【徐如林】"NOR"劍法嚴謹毫無破綻，手中$w一招緩似一招地向$n的$l遞出，由左至右將$n的$l"HIY"劃了一道長長的傷口"NOR,
          "damage" : (int)this_player()->query("str")*60000,
          "attack" : (int)this_player()->query("str")*60000,
        "lvl" : 60,
	"damage_type" : "刺傷"
]),
([	"action" : "$N大喝一聲"HIY"【驚天六絕殺】"NOR"之"HIR"【侵略如火】"NOR"，手中$w發出熊熊的火勁向$n的$l射去，造成$n的$l"HIM"一級灼傷"NOR,
          "damage" : (int)this_player()->query("str")*70000,
          "attack" : (int)this_player()->query("str")*70000,
        "lvl" : 90,
	"damage_type" : "刺傷"
]),
([	"action" : "$N大喝一聲"HIY"【驚天六絕殺】"NOR"之"HIC"【不動如山】"NOR"，以靜制動，謹守"HIB"敵不動我不動"NOR"手中$w平平地刺向$n的$l破綻所在，在$n的$l"HIC"留下一處很深的傷口"NOR,
          "damage" : (int)this_player()->query("str")*80000,
          "attack" : (int)this_player()->query("str")*80000,
        "lvl" : 120,
	"damage_type" : "刺傷"
]),
([	"action" : "$N大喝一聲"HIR"【驚天六絕殺奧義】"NOR"─"HIG"【闢地碎】"NOR"，手中$w發出浩瀚的大地之氣向$n的$l劈去，在$n的$l留下了"HIR"極*為*可*怕*的*創*傷"NOR,
          "damage" : (int)this_player()->query("str")*90000,
          "attack" : (int)this_player()->query("str")*90000,
        "lvl" : 150,
	"damage_type" : "刺傷"
]),
([  "action" : "$N大喝一聲"HIR"【驚天六絕殺奧義】"NOR"─"HIG"【開天破】"NOR"，舞動手中$w將"HIC"風"NOR"、"HIG"林"NOR"、"HIR"火"NOR"、"HIY"山"NOR"、"HIM"闢地"NOR"五式合一往$n的$l招呼，在$n的$l留下了"HIY"難_以_彌_補_的_傷_害"NOR,
          "damage" : (int)this_player()->query("str")*100000,
          "attack" : (int)this_player()->query("str")*100000,
        "lvl" : 200,
	"damage_type" : "刺傷"
]),
  });
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry") || (usage == "blade"); }
int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力不夠。\n");
          if ((int)me->query_skill("beiming-shengong", 1) < 100)
                  return notify_fail("你的北冥神功火候太淺。\n");
          if(!me->query("name") || (me->query("name")!="達克•修耐達"))
               return notify_fail("你不是達克•修耐達，你無法練這項絕技\n");
          if ((int)me->query_skill("lingboweibu", 1) < 100)
                  return notify_fail("你的凌波微步火候太淺。\n");
	return 1;
}
mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("skykill",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}
int practice_skill(object me)
{
	object weapon;
	if (!objectp(weapon = me->query_temp("weapon"))
                    || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力不夠練驚天六絕殺。\n");
	me->receive_damage("qi", 30);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"skykill/" + action;
}
