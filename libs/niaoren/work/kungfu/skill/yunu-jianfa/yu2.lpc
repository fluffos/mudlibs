// suxin.c 玉女素心劍法
// By Kayin @ CuteRabbit 1999/3/14

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int i, attack_time;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("素心劍法只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
	if( (int)me->query_skill("yunu-jianfa",1)< 130)

	if( (int)me->query_skill("yunu-xinjing",1)< 100)
	 	return notify_fail("你的玉女心經修為不夠,不能使用玉女素心劍法。\n");
		
		msg =  "$N"HIY"潛心默念"HIC"玉女心經"HIY"，忽然大喝一聲"HIR"“看招”"HIY"，招式陡然加快攻向$p。\n"NOR;
		if( (me->query_skill("sword")) > (int)target->query_skill("dodge"))
		{
			attack_time = random((int)me->query_skill("sword")/20);
			if(attack_time < 1)
			attack_time = 1;
			msg += HIY " 結果$p被$P攻了個措手不及！\n" NOR;
			for(i = 0; i < attack_time; i++)
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
			me->add("neili", -100);
			me->start_busy(3);
		}
		else
		{
		msg +=HIB "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
		me->add("neili",-100);
		me->start_busy(5);
		}
		message_vision(msg, me, target);
		return 1;
}
