// lianjian.c 玉女素心劍法<<總決式>>
// By Kayin @ CuteRabbit 1999/3/16 update

#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
	mapping myfam;
	string msg;
	object weapon;
	int skill;
	myfam = (mapping)me->query("family");
	skill = me->query_skill("yunu-jianfa",1);

	if ((!myfam || myfam["family_name"] != "古墓派"))
		return notify_fail("你不是古墓派弟子，不能使用總訣式練劍法。\n");

	if( me->is_fighting() )
		return notify_fail("「總訣式」不能在戰斗中演練。\n");
 
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必須先去找一把劍。\n");

	if( !skill || (skill < 20))
		return notify_fail("你的玉女素心劍法等級不夠, 不能用總訣式練劍法！\n");

	if( me->query("neili") < 20 )
		return notify_fail("你的內力不夠，沒有力氣練玉女素心劍！\n");
 
	if( me->query("qi") < me->query("max_qi")/50)
		return notify_fail("你現在太累了，沒有力氣練玉女素心劍！\n");
	if((int)me->query_skill("yunu-xinfa",1)<(int)me->query_skill("yunu-jianfa",1))
	        return notify_fail("你的玉女心法修為不足以練玉女素心劍法了。\n");	

	msg = HIC "$N"HIC"默想劍法，身隨意走，劍隨心出，將手中" + weapon->name() + "舞出條條寒光，演練了一套"HIY"玉女素心劍法"NOR"。\n";
	message_vision(msg, me);

	me->add("neili", -20);
	me->add("qi",- me->query("max_qi")/50);
	me->improve_skill("yunu-jianfa", ((int)me->query_skill("yunu-jianfa",1)+((int)me->query_skill("yunu-jianfa",1)/2)));

	msg = YEL"$P的「玉女素心劍法」進步了！\n"NOR;
	me->start_busy(2);

	message_vision(msg, me);

	return 1;
}
