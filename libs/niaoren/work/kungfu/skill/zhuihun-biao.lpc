// zhuihun-biao.c 追魂奪命鏢

inherit SKILL;

mapping *action = ({
([	"action" : "$N手中$w一閃，一招「無常敲門」，手腕一翻，向$n的$l打去",
	"force" : 120,
        "dodge" : -10,
        "parry" : 5,
	"damage" : 20,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N一招「小鬼鬧花燈」，往地上一滾，$w悄無聲息打向$n的頸部",
	"force" : 130,
        "dodge" : -10,
        "parry" : 10,
	"damage" : 25,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N斜身進步，一招「五鬼抬轎」，手中五枚$w,筆直飛向$n",
	"force" : 140,
        "dodge" : -5,
        "parry" : 5,
	"damage" : 30,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N一招「奈何不歸路」，$w撒手飛出，竟以不可思議的角度，打向$n背面",
	"force" : 160,
        "dodge" : 5,
        "parry" : 5,
	"damage" : 35,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N一招「陰雨綿綿欲斷魂」，一把$w劈頭蓋臉打向$n的胸口。",
	"force" : 180,
        "dodge" : 10,
        "parry" : 5,
	"damage" : 40,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N身子一踉蹌，好象要跌倒，卻見精芒閃動，正是一招「斷腸傷心無去處」，$w飛快罩向$n",
	"force" : 210,
        "dodge" : 15,
        "parry" : 15,
	"damage" : 50,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N一招「閻羅孤燈」，$w閃爍不定，時快時慢，防不勝防打$n的$l",
	"force" : 240,
        "dodge" : 5,
        "parry" : 15,
	"damage" : 60,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
([	"action" : "$N騰空躍起，一招「煉獄流火」，數枚$w脫手而出，一枚接一枚，竟然成了一根火線向$n的全身打去",
	"force" : 280,
        "dodge" : 20,
        "parry" : 10,
	"damage" : 80,
	"damage_type" : "刺傷",
	"post_action":  (: call_other, WEAPON_D, "throw_weapon" :),
]),
});


int valid_enable(string usage) { return (usage == "throwing") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力不夠。\n");
	if ((int)me->query_skill("biyun-xinfa", 1) < 20)
		return notify_fail("你的碧云心法火候不夠。\n");
	if ((int)me->query_skill("biye-wu", 1) < 20)
		return notify_fail("你的碧葉隨風舞火候太淺。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
int zhaoshu, level;

zhaoshu = sizeof(action)-1;
level   = (int) me->query_skill("zhuihun-biao",1);

if (level < 60 )
zhaoshu--;
if (level < 55 )
zhaoshu--;
if (level < 50 )
zhaoshu--;
if (level < 40 )
zhaoshu--;
if (level < 30 )
zhaoshu--;
if (level < 20 )
zhaoshu--;
if (level < 10 )
zhaoshu--;

return action[random(zhaoshu)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力不夠練追魂奪命鏢。\n");
	me->receive_damage("qi", 30);
	return 1;
}

