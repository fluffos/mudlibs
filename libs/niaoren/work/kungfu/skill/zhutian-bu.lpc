// modified by Venus Oct.1997
// written by That

inherit SKILL;

string *dodge_msg = ({
    "只見$n一招「天地鉤」，身體騰空，雙足向上，筆直地縱起丈余，躲過了$N這一招。\n",
    "$n身隨意轉，一式「鳳點頭」頭部前挺，側身收腹，倏地往一旁挪開了三尺，避過了這一招。\n",
    "$n雙足抓地，身形微晃，一招「鷹爪松」有驚無險地避開了$N這一招。\n"
    "但是$n身形飄忽，一式「風擺柳」，輕輕一縱，早已避開。\n",
    "$n一個「陰陽箭」，向后縱出數丈之遠，避開了$N的凌厲攻勢，立即又欺近$N身旁。\n",
    "$n使出「日月扣」，雙手如鉤向一旁飄然縱出，輕輕著地。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");
 }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
      if((int)me->query("qi") < 40 )
  return notify_fail("你的體力太差了，不能練諸天化身步。\n");
      me->receive_damage("qi", 30);
      return 1;
}
