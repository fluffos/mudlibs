// zhong.c 種生死符

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object obj;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !me->is_fighting() )
                return notify_fail("生死符只能種在對手身上。\n");

        if( (int)me->query_skill("bahuang-gong", 1) < 60 )
                return notify_fail("你的八荒六合功不夠嫻熟，不能種生死符。\n");

        if( (int)me->query_skill("liuyang-zhang", 1) < 60 )
                return notify_fail("你的天山六陽掌不夠嫻熟，不能種生死符。\n");

        if (!objectp(obj=present("jiudai", me)))
            return notify_fail("你身上沒有酒袋，不能化水為冰。\n");

        msg = CYN "$N化水為冰，凝于掌中，輕飄飄地拍向$n。\n";

        me->start_busy(1);
        if( random( (int)me->query_skill("liuyang-zhang",1))
          > random(target->query_skill("dodge") ) ) {
                msg += HIW " 結果$P在$p身上種下了生死符！\n" NOR;
                target->receive_damage("qi",(int)me->query_skill("bahuang-gong",1));
                target->receive_wound("qi",15 + random(10));
                target->receive_wound("jing", 10);
                target->apply_condition("ss_poison", random(me->query_skill("liuyang-zhang",1)*3) +
                target->query_condition("ss_poison"));
                me->start_busy(random(2));
        } else {
                msg += "可是$p急忙閃在一旁，躲了開去。\n" NOR;
                me->start_busy(3);
        }
        message_vision(msg, me, target);
        target->start_busy(1 + random(4));

        return 1;
}
