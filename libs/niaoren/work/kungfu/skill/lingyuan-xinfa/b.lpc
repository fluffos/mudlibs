// break -「以柔破鋼」
// made by deaner
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int exert(object me, object target)
{
    string msg;
    object target_w;
    target_w = target->query_temp("weapon");
    if( !target )
    return notify_fail("格式：exert break [目標]\n");
    if( !target
    ||      !target->is_character()
    ||      !me->is_fighting(target) )
   return notify_fail("你只能對戰斗中的對手使用「以柔破鋼」。\n");
    if( target->is_busy() )
   return notify_fail(target->name() + "目前正在發愣，是進攻的好時機!\n");
    if( (int)me->query_skill("lingyuan-xinfa", 1) < 50 )
    return notify_fail("你的靈元心法火候不夠，還不會使用「以柔破鋼」。\n");
    msg = HIC "$N沉肩滑步，自丹田中升起一股陰柔之氣順著血脈經絡傳至雙手勞宮穴， 
接著這股陰柔之氣就激射而出，噴向$n手中的兵刃！\n";
    me->start_busy(2);
    if (target->query_temp("weapon") ||
   target->query_temp("secondary_weapon")) {
    if( random(me->query("combat_exp")) >
   (int)target->query("combat_exp")/3 ) {
    msg += HIW"結果$p手中的"+target_w->query("name")+"與這股陰柔之氣一碰竟被
震了個粉碎！\n" NOR;
    target_w->unequip();
    target_w->move(environment(target));
    target_w->set("name", "震碎的" + target_w->query("name"));
    target_w->set("value", target_w->query("value")/10);
    target_w->set("weapon_prop", 0);
    target->reset_action();
    target->start_busy( (int)me->query_skill("lingyuan-xinfa") / 20 );
    } else {
    msg += "可是$p急急拆招，躲了開去，$P的計謀沒有得逞。\n" NOR;
    }
    message_combatd(msg, me, target);
    return 1;
    }
    return notify_fail(target->name() + "目前是空手，沒什么可以震碎的。\n");
}
