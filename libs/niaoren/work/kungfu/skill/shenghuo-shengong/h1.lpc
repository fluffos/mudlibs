// heal.c

#include <ansi.h>

int exert(object me, object target)
{
	if( me->is_fighting() )
		return notify_fail("戰斗中運功療傷？找死嗎？\n");

	if ((int)me->query_skill("shenghuo-shengong", 1) < 30)
		return notify_fail("你的聖火神功修為還不夠。\n");
	if( (int)me->query("neili") < 50 ) 
		return notify_fail("你的真氣不夠。\n");
	if( (int)me->query("eff_qi") == (int)me->query("max_qi"))
		return notify_fail("你現在沒有受任何傷。\n");

	if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 7 )
		return notify_fail("你已經受傷過重，只怕一運真氣便有生命危險！\n");

        write( HIW "你雙手著飛焰狀運起"+HIR" 聖火神功"+HIW" 療傷。\n" NOR);
	message("vision",
		HIW + me->name() +HIW "雙手著飛焰狀運起"+HIR" 聖火神功 "+HIW"療傷。\n" NOR,
		environment(me), me);

	me->receive_curing("qi", 10 + (int)me->query_skill("force")/5 );
	me->add("neili", -50);
	me->set("jiali", 0);
	return 1;
}
