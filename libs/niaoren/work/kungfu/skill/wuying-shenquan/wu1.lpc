// luanwu
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage;
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("神功殺敵只能對戰斗中的對手使用。\n");

	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必須空手才能使用「亂」字訣！\n");		

	if( (int)me->query_skill("wuying-shenquan", 1) < 100 )
		return notify_fail("你的無影神拳不夠級別，不會使用「亂」字訣。\n");

	if( (int)me->query_skill("xuedao-xinfa", 1) < 30 )
		return notify_fail("你的血刀心法不夠高，不能用來傷敵。\n");

	if( (int)me->query("neili", 1) < 300 )
		return notify_fail("你現在內力太弱，不能使用「亂」字訣。\n");

	msg = HIR "$N大喝一聲,運起無影神拳的終極絕技，陡然增加臂力，欲與$n同歸于盡!\n"NOR;

	if( !target->is_killing(me) ) target->kill_ob(me);

	if (random(me->query_skill("force")) > target->query_skill("force")/2 )
	{
		me->start_busy(3);
		target->start_busy(random(3));
		
		damage = (int)me->query_skill("xuedao-xinfa", 1);
		
                damage = damage + random(damage/2)+50;
		
		target->receive_damage("qi", damage);
		target->receive_wound("qi", damage/3);
                me->add("neili", -damage);
		
		if( damage < 120 )
			msg += HIY"結果$n受到$N的亂舞之拳的攻擊，悶哼一聲。\n"NOR;
       else if( damage < 140 )
			msg += HIY"結果$n被$N的亂舞之拳一擊，「嘿」地一聲退了兩步。\n"NOR;
        else if( damage < 180 )
			msg += RED"結果$n被$N的亂舞之拳一重擊，胸口有如受到一記重錘，連退了五六步！\n"NOR;
		else
			msg += HIR"結果$n被$N的亂舞之拳擊中，眼前一黑，象一捆稻草一樣飛出去好几丈遠！\n"NOR;
		
	}
	else 
	{
		target->start_busy(1);
		msg += CYN"可是$p看破了$P的企圖，并沒有上當。\n"NOR;
	}
	message_vision(msg, me, target);

	return 1;
}
