// ci.c  刺肩式
// congw@CCTX

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	int damage;
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「刺肩式」只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
		
	if( (int)me->query_skill("liancheng-jian", 1) < 50 )
		return notify_fail("你的連城劍法不夠嫻熟，不會使用。\n");
	                        
	if( (int)me->query_skill("force", 1) < 50 )
		return notify_fail("你的基本內功不夠高。\n");
			
	if( (int)me->query("neili", 1) < 300 )
		return notify_fail("你現在內力太弱，不能使用「刺肩試」。\n");
			
	msg = HIY "只見$N劍光一閃，手中武器以意想不到的方位刺向$n的左肩。\n"NOR;



	if (random(me->query_skill("combat_exp")) > target->query_skill("combat_exp") )
	{
		target->start_busy( (int)me->query_skill("liancheng-jian") / 20 + 1);
		
		damage = (int)me->query_skill("liancheng-jian", 1);
		damage = damage +  (int)me->query_skill("liancheng-jian", 1);
		damage = damage +  (int)me->query_skill("sword", 1);
		
		target->receive_damage("qi", damage);
		target->receive_wound("qi", damage/3);
		me->add("neili", -damage);
		msg += CYN"$n只覺肩膀一陣刺痛，身形不由得為之一慢！\n"NOR;
		me->start_busy(2);
	} else 
	{
		msg += CYN"可是$p身形一側,躲過了$P的攻擊。\n"NOR;
		me->add("neili", -100);
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
