//by congw
// qu.c perform laincheng-jian
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{      object weapon;
       object obj;
       string msg;
    if( !target ) target = offensive_target(me);
if( !target || !target->is_character() )
return notify_fail("去劍勢只能對對手使用。\n");
if(me->query_skill("liancheng-jian")<30)
return notify_fail("你的連城劍法不夠嫻熟，不能施用「去」字決。\n");
if (!objectp(weapon = target->query_temp("weapon")))
return notify_fail("對手并沒有使用武器。\n");
msg =  "$N清嘯一聲，抖直手中的兵刃，以連城劍法的「去」字決順勢搭上了$n的兵器！\n";
me->start_busy(1);
if( random( (int)me->query("combat_exp",1))
> random(target->query("combat_exp") ) ) {
msg +=HIY"只聽得一陣金鐵交鳴之聲，結果$p的兵刃被$P手中的兵器一連一帶，遠遠地飛了開去！\n" NOR;
obj=target->query_temp("weapon");
destruct(obj);
target->start_busy(1 + random(2));
} else {
msg += "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
me->start_busy(2);
}
message_vision(msg, me, target);
return 1;
}
