//zongjue.c -「總訣式」
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;
        object target_w;
        target_w = target->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target||!target->is_character()||!me->is_fighting(target) )
        return notify_fail("你只能對戰斗中的對手使用「總訣式」。\n");
        if( (int)me->query_skill("dugu-jiujian-sword",1) < 120)
        return notify_fail("你的獨孤九劍不夠嫻熟，還使不出「總訣式」。\n");
        if( (int)me->query("neili") < 200 )
        return notify_fail("你的內力不夠。\n");
        me->add("neili", -80);
        msg = CYN"$N窺破$n招式的破綻，使出獨孤九劍中的「總訣式」，隨手一劍妙到顛毫！\n"NOR;
        me->start_busy(2);
        if (target->query_temp("weapon") ||
            target->query_temp("secondary_weapon")) {
        if( random(me->query("combat_exp")) >
          (int)target->query("combat_exp")/4 ) {
    msg += "$p莫明其妙，百思不解為何$P隨意一劍竟能如此神妙，只好放棄"+target_w->query("name")+"！\n" NOR;
                 target_w->unequip();
                 target_w->move(environment(target));
                 target->reset_action();
                 target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
        target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
    } else {
        msg += HIC "$p雖然看破了這招「總訣式」的劍路，但仍然几經艱難方能還招擋開！\n"NOR;
    }
        message_vision(msg, me, target);
        return 1;
}
        if( random(me->query("combat_exp")) >
          (int)target->query("combat_exp")/4 ) {
        damage = (int)me->query_skill("dugu-jiujian-sword", 1)+(int)me->query_skill("sword", 1)/2;
        damage = damage/2 + random(damage);

        target->receive_damage("qi", damage);
        target->receive_wound("qi", damage/2);
        target->addd("neili", -((int)me->query_skill("dugu-jiujian-sword", 1)/4+(int)me->query_skill("sword", 1)/2));
        msg += RED
"$n驚駭莫明，對這招「總訣式」欲避不能，被$N刺中丹田，功\力受損！\n"NOR;
        } else {
        msg += HIC "$p雖然看破了這招「總訣式」的劍路，但仍然几經艱難方能還招擋開！\n"NOR;
        }
        message_vision(msg, me, target);
        return 1;
}
