
//podao.c 「破刀式」
//made by deaner
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object target_w;
        target_w = target->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIC"你只能對戰斗中的對手使用「破刀式」。\n"NOR);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正疲于招架，加緊攻擊吧！\n");
    if( (int)me->query_skill("dugu-jiujian-sword", 1) < 80 )
        return notify_fail("你的獨孤九劍不夠嫻熟，不能使用「破刀式」。\n");

    msg = CYN "$N巧使獨孤九劍中的「破刀式」逼近$n，提劍幻出重重劍影，如柔絲般向$n裹去！\n";
    me->start_busy(2);

        if (target->query_temp("weapon") ||
           (string)target_w->query("skill_type") == "blade"){
        if( random(me->query("combat_exp")) >
                     (int)target->query("combat_exp")/4 ) {
    msg += "這招「破刀式」簡直是刀客的客星，$p難以招架，只好舍棄手中"+target_w->query("name")+"以期自保！\n" NOR;
                 target_w->unequip();
                 target_w->move(environment(target));
                 target->reset_action();
                 target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
    } else {
        msg += "$p使出渾身解朮，才勉強接下$P這招「破刀式」！\n" NOR;
    }
    message_vision(msg, me, target);
    return 1;
        }
        return notify_fail(target->name() + "目前手中使的不是刀類兵刃，得用其他招式。\n");
}
