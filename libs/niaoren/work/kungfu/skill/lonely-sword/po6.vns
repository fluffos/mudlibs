//poqi.c -「破氣式」
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target||!target->is_character()||!me->is_fighting(target) )
        return notify_fail("你只能對戰斗中的對手使用「破氣式」。\n");
        if( (int)me->query_skill("dugu-jiujian-sword",1) < 80)
        return notify_fail("你的獨孤九劍不夠嫻熟，還使不出「破氣式」。\n");
        if( (int)me->query("neili") < 200 )
        return notify_fail("你的內力不夠。\n");
        me->add("neili", -80);
        msg = CYN"$N潛運獨孤九劍中的「破氣式」，運氣貫劍使其由利返鈍，毫無花俏地直刺$n的丹田。！\n"NOR;
        me->start_busy(2);
        if (target->query("neili",1)>100) {
        if( random(me->query("combat_exp")) >
          (int)target->query("combat_exp")/4 ) {
        target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
        damage = (int)me->query_skill("dugu-jiujian-sword", 1)/4+(int)me->query_skill("sword", 1)/2;
        target->add("neili", -damage);
        msg += RED
"$n對這招「破氣式」百思不得其解，退避不及，中劍因而導至內力受損！\n"NOR;
    } else {
        msg += HIC "$p急忙沉肩滑步，護住丹田，才勉強避開$P這招「破氣式」。\n" NOR;
    }
        message_vision(msg, me, target);
        return 1;
}
        return notify_fail(target->name() + "目前內氣虛弱得很，無虛再破，換其他招式罷。\n");
}
