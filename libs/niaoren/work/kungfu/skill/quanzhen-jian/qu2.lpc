// ju.c 全真劍-三花聚頂

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
    string msg, string1;
    int count;
 
    if( !me->is_fighting() )
            return notify_fail("「三花聚頂」只能在戰鬥中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的"BLINK"武器不對"NOR"。\n");

        if((int)me->query_dex() < 25)
                return notify_fail("你的"BLINK"身法不夠"NOR", 目前還不能使用這項絕技! \n");

        if((int)me->query_skill("quanzhen-jian",1) < 80)
                return notify_fail("你的"BLINK"全真劍法修為不夠"NOR", 不能使用這一絕技 !\n");

        if((int)me->query_skill("dodge") < 100)
                return notify_fail("你的"BLINK"輕功修為不夠"NOR", 不能使用三花聚頂！\n");
 
        if((int)me->query_skill("sword") < 110)
                return notify_fail("你的"BLINK"基本劍法修為不夠"NOR"， 目前不能使用三花聚頂! \n");

    if( (int)me->query("neili") < 500 )
                return notify_fail("你的真氣不夠！\n");

    msg = HIG "$N身形一閃，運起先天神功，對"HIY"$n "HIG"說道：有潛了！手上長劍突然劍芒一閃。一招\n
"HIC"三∼"HIM"花∼"HIB"聚∼"BLINK"頂∼"NOR"“ $n 的全身各大要害都已籠罩在全真劍氣之下！\n"NOR;

        message_combatd(msg, me, target);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        me->add("neili", -100);
        me->start_busy(random(3));

    return 1;
}
