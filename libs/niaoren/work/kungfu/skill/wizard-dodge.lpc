// wizard-dodge.c 神行       by leos 2000.5.2
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
        CYN "$n端坐微笑，忽而臉現庄嚴之色，$N立刻匍匐在地，虔誠膜拜。\n" NOR ,
        HIR "$n口念：“ " HIM "庵嗎昵趴咪吽 " NOR "“ 八字真言， $N受到無邊佛法沐浴，停止了所有攻擊。\n" NOR ,
        HIG "$n眼神一凝，臉色微變，向$N一望，$N突然發現所做所為均無天地所不容，立即向$n跪地求饒。\n" NOR ,
        HIB "$n雙手一合，身形漸漸消失，$N竟失去了攻擊目標！\n" NOR
        HIM "$n口念：“ " MAG "鳥人萬歲" NOR "“，$N聽到這四字聖語，無法自我的倒在地上痛哭流涕。\n"
        HIY "天空上突然出現一手大黑手向 $N 申出食指晃了幾下，$N被嚇的停止了攻擊。\n" NOR
        MAG "$n輕輕的嘆了一口氣之後突然風起雲湧，這時$N附近起了濃霧申手不見五指，$N連人都看不到。\n" NOR
});

int valid_enable(string usage) { return usage=="dodge" || usage=="parry"; }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 30 )
            return notify_fail("你的體力太差了，不能練神行術。\n");
        if (me->query_skill("yan-shuangfei", 1) < 30)
                me->receive_damage("qi", 10);
                me->receive_damage("qi", 20);
        return 1;
}
