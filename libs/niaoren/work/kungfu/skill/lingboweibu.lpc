// lingboweibu.c 凌波微步
inherit SKILL;
#include <ansi.h> 
mapping *action = ({
([ "action" : "只見$n左一步，右一步，輕而易舉的躲過$N這一招。\n",
   "dodge"  : 600,
]),
([ "action" : "但是$n身形一動，從不可思義的角度轉過身來，避開了$N的攻擊。\n",
   "dodge"  : 650,
]),
([ "action" : "然而$n卻不退反進，腳下步點變幻莫測，反使$N的攻勢全部落空。\n",
   "dodge"  : 700,
]),
([ "action" : "但是$n身形飄忽，忽前忽后，忽左忽右，讓$N無法下手。\n",
   "dodge"  : 750,
]),
([ "action" : "可是$n身隨意轉，腳步微變，人竟已在三丈之外，閃過了這一招。\n",
   "dodge"  : 800,
]),
});
mapping query_action(object me, object weapon)
{
     int zhaoshu, level;
          zhaoshu = sizeof(action);
          level   = (int) me->query_skill("lingboweibu");
            return action[random(zhaoshu)];
}
int valid_enable(string usage)
{
    return (usage=="dodge") || (usage=="move");
}
string query_dodge_msg(string limb)
{
    object me, ob;
    mapping action;
    me = this_player();
    action = query_action(me, ob);
    return action["action"];
}
int practice_skill(object me)
{
    if( (int)me->query("qi") < 30 )
        return notify_fail("你的體力太差了，不能練凌波微步。\n");
    me->receive_damage("qi", 10);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"lingboweibu/" + action;
}
