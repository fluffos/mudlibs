// tianluo-diwang.c 天羅地網勢
// By Kayin @ CuteRabbit 1999/3/16

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) 
{
	int lvl;
	
	lvl = (int)me->query_skill("tianluo-diwang", 1);
	
	if( (int)me->query("dex") < 20 )
		return notify_fail("你的身法太差不能學習古墓派的武功。\n");
		
	if( (int)me->query("int") < 26 )
		return notify_fail("你的悟性太差不適合學習古墓派的武功。\n");

	return 1;
}

int practice_skill(object me)
{	
	return notify_fail("天羅地網勢只能通過練習(lianxi)來增加熟練度。\n");
}
