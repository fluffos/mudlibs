// mie.c  回風拂柳劍法「滅劍」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;
        object weapon;

        if (!target ) target = offensive_target(me);
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail(RED"開什么玩笑，沒裝備劍就想使「滅劍」？\n"NOR);
        if (!target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「滅劍」只能對戰斗中的對手使用。\n");
        if ((int)me->query_skill("huifeng-jian", 1) < 60 )
                return notify_fail(WHT"你的回風拂柳劍法不夠嫻熟，還使不出「滅劍」。\n"NOR);
        if ((int)me->query_skill("linji-zhuang", 1) < 60 )
                return notify_fail(RED"你的臨濟十二庄火候不夠，「滅劍」不成招式。\n"NOR);
        if ((int)me->query("max_neili")<400)
                return notify_fail(RED"你的內力修為不足，無法運足「滅劍」的內力。\n"NOR);
        if ((int)me->query("neili")<200)
        {
               return notify_fail(HIC"你現在內力不夠，沒能將「滅劍」使完！\n"NOR);
        }
        msg = HIC "$N手中長劍劍芒躍動，劍光暴長，幻出死亡的色彩，劍尖漸\n"NOR;
        msg += HIC"漸逼近$n，$n看到漫天劍光，抽身后躍，只這一剎，漫天劍\n"NOR;
        msg += HIC"影化為一劍直刺$n前胸，快捷無倫，只有一劍！\n"NOR;
        if (random(me->query_skill("force"))>target->query_skill("force")/2|| 
           random(me->query("combat_exp"))>(int)target->query("combat_exp")/3)
        {
                me->start_busy(2);
                target->start_busy(random(3));
                damage = (int)me->query_skill("huifeng-jian", 1);
                damage = damage + random(damage);
                target->receive_damage("qi", damage/2);
                target->receive_wound("qi", damage);
                target->receive_damage("jing", damage);
                target->receive_wound("jing", damage/2);
        msg += HIC"$n根本沒法躲避，一式「回風拂柳劍」的絕招「滅劍」端端正\n"NOR;
        msg += HIC"正扎進在$n胸口！$n一低頭，看長劍自胸口拔出！\n"NOR;
                me->add("neili", -200);
        } else
        {
                me->start_busy(2);
        msg += HIY"可是$p輕輕一笑，側身右轉，伸出兩指，正彈在$P的劍上，長\n"NOR;
        msg += HIY"劍在$p身側划過，毫發無傷。\n"NOR;
                me->add("neili", -200);
        }
        message_combatd(msg, me, target);
	if(!target->is_fighting(me)) target->fight_ob(me);
//	if(userp(target)) target->fight_ob(me);
//	else if( !target->is_killing(me) ) target->kill_ob(me);
        return 1;
}
