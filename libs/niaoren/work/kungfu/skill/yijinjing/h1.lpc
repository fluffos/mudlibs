// heal.c
// Modified by Java Feb.21 1998

#include <ansi.h>

int exert(object me, object target)
{
    if( me->is_fighting() )
           return notify_fail("戰斗中運功療傷？找死嗎？\n");

    if ((int)me->query_skill("yijinjing", 1) < 20)
           return notify_fail("你的易筋經氣功修為還不夠。\n");
    if( (int)me->query("neili") < 50 )
           return notify_fail("你的真氣不夠。\n");

    if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 3 )
           return notify_fail("你已經受傷過重，只怕一運真氣便有生命危險！\n");

    write( HIW "你全身放松，坐下來開始運功療傷。\n" NOR);
    message("vision",
           HIW + me->name() + "吐出一口金燦燦的瘀血，臉色看起來好多了。\n" NOR,
           environment(me), me);

    me->receive_curing("qi", 10 + (int)me->query_skill("force")/5 );
    me->add("neili", -50);
    me->set("jiali", 0);

    return 1;
}

