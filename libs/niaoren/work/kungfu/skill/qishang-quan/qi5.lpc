// sanjiao.c 三焦齊逆訣

#include <ansi.h>

inherit F_SSERVER;

int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, ap, dp, neili_wound, qi_wound;

        me->clean_up_enemy();
        target = me->select_opponent();

          skill = me->query_skill("qishang-quan",1) + me->query_skill("jiuyang",1);

        if( !me->is_fighting() )
                return notify_fail("「三焦齊逆訣」只能在戰斗中使用。\n");

        if( (int)me->query("neili") < 2000 )
                return notify_fail("你的內力還不夠高！\n");

          if( (int)me->query_skill("cuff") < 250 )
                return notify_fail("你的拳法還不到家，無法體現七傷拳的各種總訣！\n");

          if( (int)me->query_skill("qishang-quan", 1) < 250)
                return notify_fail("你七傷拳的修為不夠，不能夠體會三焦齊逆訣! \n");

          if( (int)me->query_skill("jiuyang", 1) < 350)
                return notify_fail(HIM "你的九陽神功修為不足，不能隨便使用三焦齊逆訣! \n" NOR);

        if( me->query_skill_mapped("cuff") != "qishang-quan")
                return notify_fail("你沒有激發七傷拳，無法運用三焦齊逆訣！\n");

        msg = HIY "$N凝神定氣，企圖使出七傷拳總訣中的「" HIR "三焦齊逆訣" HIY "」，將敵方招數反彈！\n"NOR;
//  結果發覺這招已經失傳，不能使用，呵呵。\n"
//        message_combatd(msg, me, target);

	ap = me->query("combat_exp") + skill * 400;
	dp = target->query("combat_exp") / 2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		if(userp(me))
			me->add("neili",-100);

		msg += HIG "$n只覺得胸前一陣劇痛，“哇”的一聲噴出一口鮮血！\n"NOR;
		neili_wound = 100 + random(skill);
		if(neili_wound > target->query("neili"))
			neili_wound = target->query("neili");

                  qi_wound = neili_wound / 10;
		if(qi_wound > target->query("qi"))
			qi_wound = target->query("qi");

		target->add("neili", -neili_wound);
		target->receive_wound("qi", qi_wound);
		target->start_busy(2);
		me->start_busy(random(3));
	}
	else
	{
		msg += HIG "只見$n不慌不忙，輕輕一閃，躲過了$N的必殺一擊！\n"NOR;
		if(userp(me))
			me->add("neili",-100);
		me->start_busy(4);
	}
	message_combatd(msg, me, target);

	if(!target->is_fighting(me)) target->fight_ob(me);
//	if(userp(target)) target->fight_ob(me);
//	else if( !target->is_killing(me) ) target->kill_ob(me);
	return 1;
}
