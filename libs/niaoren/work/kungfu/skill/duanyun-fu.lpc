    "damage": 540,
    "dodge" : 25,
    "parry" : 66,
    "damage_type" : "砍傷",
    "lvl" : 68,
    "skill_name" : "五斧奪命"
]),
([  "action" : "$N前腳猛地往地上一頓，大地也微微一震，接著舉起斧頭在頭頂急轉
