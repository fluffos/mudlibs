    "damage": 480,
    "dodge" : 30,
    "parry" : 54,
    "damage_type" : "割傷",
    "lvl" : 55,
    "skill_name" : "回風轉云"
]),
([  "action" : "$N身形微動，就在同一時間自上中下左右砍出五斧，$n見五把$w從不
