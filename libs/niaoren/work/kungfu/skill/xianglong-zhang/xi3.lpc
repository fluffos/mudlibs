// zhang.c 降龍十八式
// By Nick 2000-8-27
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count;
 
        if( !me->is_fighting() )
                return notify_fail("「降龍十八式」只能在戰斗中使用。\n");
 
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return 0;
                
        if( (int)me->query("neili") < 1000 )
                return notify_fail("你的真氣不夠！\n");

        if( (int)me->query_skill("xianglong-zhang",1) < 180 )
                return notify_fail("你的降龍十八掌火候不夠，無法使用「降龍十八式」！\n");

        if( (int)me->query_skill("force") < 200 )
                return notify_fail("你的內功修為不夠，無法使用「降龍十八式」！\n");

        msg =  HIC "$N回想所學掌法，使出了"HIR"「降龍十八式」。\n" NOR;
        message_vision(msg, me);

        me->clean_up_enemy();
        ob = me->select_opponent();
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        

        me->add("neili", -500);
        me->start_busy(random(4));

        return 1;
}

