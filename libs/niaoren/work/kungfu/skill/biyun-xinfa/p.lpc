// powerup.c 碧云心法加力

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

	if ( !wizardp(this_player()) && (me->query("family/family_name") != "唐門"))
		return notify_fail("你不是唐門弟子不能使用碧云心法。碧云心法是唐門獨門心法, 非唐門弟子不傳, 真不知道你是怎么學會的！\n");
	if( target != me ) 
		return notify_fail("你只能用碧云心法來提升自己的戰斗力。\n");

	if( (int)me->query("neili") < 100  ) 
		return notify_fail("你的內力不夠。\n");
	if( (int)me->query_temp("powerup") ) 
		return notify_fail("你已經在運功中了。\n");

	skill = me->query_skill("force");
	me->add("neili", -100);
	me->receive_damage("qi", 0);

	message_vision(
	HIG "$N微一凝神，運起碧云心法，臉上泛過一層碧綠色,身上衣衫如鼓風般揚起。\n" NOR, me);

	me->add_temp("apply/attack", skill/5);
	me->add_temp("apply/dodge", skill/5);
	me->set_temp("powerup",1);

       //me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/3 :), skill);

       //if( me->is_fighting() ) me->start_busy(1);

	return 1;
}

void remove_effect(object me, int amount)
{
  if ( (int)me->query_temp("powerup") ) {
	me->add_temp("apply/attack", - amount);
	me->add_temp("apply/dodge", - amount);
	me->delete_temp("powerup");
	tell_object(me, "你的碧波心法運行完畢，將內力收回丹田。\n");}
}
