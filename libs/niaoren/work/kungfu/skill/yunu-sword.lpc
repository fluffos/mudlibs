#include <ansi.h>

inherit SKILL;

mapping *action = ({
    ([ "name":    "穿針引線",
       "action":  "$N使一招「穿針引線」，腳踏中宮，手中$w直指$n$l",
       "dodge":   50,
       "damage":  170,
       "damage_type":  "刺傷"
    ]),
    ([ "name":    "天衣無縫",
       "action":  "$N劍隨身轉，一招「天衣無縫」，撒出一片劍影，罩向$n的$l",
       "dodge":   30,
       "damage":  80,
       "damage_type":  "刺傷"
    ]),
    ([ "name":    "夜繡鴛鴦",
       "action":  "$N舞動$w，使出一招「夜繡鴛鴦」劍光忽左忽右，閃爍不定，直刺$n的$l",
       "dodge":   40,
       "damage":  90,
       "damage_type":  "刺傷"
    ]),
    ([ "name":    "織女穿梭",
       "action":  "$N一聲嬌喝，祭出「織女穿梭」，手中$w化為一道弧光，射向$n的$l",
       "dodge":   40,
       "damage":  60,
       "damage_type":  "刺傷"
    ]),
    ([ "name":    "小鳥依人",
       "action":  "$N忽然蹂身直上，一招「小鳥依人」，手中$w自下往上刺向$n的$l",
       "dodge":   50,
       "damage":  90,
       "damage_type":  "刺傷"
    ]),
});

int valid_learn(object me)
{
    object ob;
   if( (string)me->query("gender") != "女性" )
       return notify_fail("玉女金針十三劍是只有女子才能練的武功。\n");
    if( (int)me->query("max_neili") < 50 )
       return notify_fail("你的內力不夠，沒有辦法練玉女金針十三劍。\n") ;
   if( (string)me->query_skill_mapped("force")!= "zixia-shengong")
       return notify_fail("玉女金針十三劍必須配合紫霞神功才能練。\n");
   if( !(ob = me->query_temp("weapon"))
       || (string)ob->query("skill_type") != "sword" )
       return notify_fail("你必須先找一把劍才能練劍法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30
    ||  (int)me->query("neili") < 5 )
      return notify_fail("你的內力或氣不夠，沒有辦法練習玉女金針十三劍。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -5);
    write("你按著所學練了一遍玉女金針十三劍。\n");
    return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

string perform_action_file(string action)
{
        return __DIR__"yunu-sword/" + action;
}
