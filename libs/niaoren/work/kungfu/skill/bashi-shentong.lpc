// bashi-shentong.c 八識神通
// Modified by Venus Oct.1997

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage=="magic"; }

int valid_learn(object me)
{
    if( (int)me->query_skill("buddhism",1) < 10
    ||(int)me->query_skill("buddhism",1) <= (int)me->query_skill("bashi-shentong",1) )
    return notify_fail("你的佛法修為還不夠高深，無法學習八識神通。\n");
    return 1;
}


int practice_skill(object me)
{
    object bug;

    if( (int)me->query("jingli") < 10)
    return notify_fail("你的精力不夠。\n");

    if( (int)me->query("jing") < 35 )
   return notify_fail("你的精神無法集中。\n");

    me->add("jingli", -5);
    me->receive_damage("jing", 30);

    message_vision(HIY"$N閉目凝神，神游太虛，開始研習八識神通……\n"NOR,me);
    if( random((int)me->query("jing")) < 10)
    {
    tell_object(me,HIC"突然！一陣狂風刮來，將你的元神吹落云頭！哇∼哇≒哇！\n"NOR);
    tell_room(environment(me),HIY"天空中忽然“嗖”地落下來一團物事，又好象什
么都沒有，卻見"+me->query("name")+"開始口吐白沫了。 \n"NOR,me);
    me->unconcious();
    return 0;
    }
    else return 1;
}


string conjure_magic_file(string spell)
{
    return __DIR__ + "bashi-shentong/" + spell;
}
