// juemen-gun.c 絕門棍
// Modified by Venus Oct.1997
inherit SKILL;
mapping *action = ({
([  "action" : "$N斜里沖前一步，身法詭異，手中$w橫掃$n的$l",
    "damage": 350,
    "dodge" : 50,
    "damage_type" : "挫傷"
]),
([  "action" : "$N忽然直身飛入半空，很久也不見人影，$n正搜尋間，$N已
飛身扑下，$w攻向$n的$l",
    "damage": 400,
    "dodge" : 45,
    "damage_type" : "挫傷"
]),
([  "action" : "$N原地一個后滾翻，卻在落地的一剎那，身體向$n平飛過
去，手中$w指向$n的$l",
    "damage": 350,
    "dodge" : 60,
    "damage_type" : "挫傷"
]),
([  "action" : "$N突然一個急轉身，$w橫掃一圈后挾著猛烈的勁道打向$n的$l",    
    "damage": 450,
    "dodge" : 75,
    "damage_type" : "挫傷"
]),
([  "action" : "$N向前扑出，順勢一滾，接著翻身跳起，手里$w斜向上擊
向$n的$l",
    "damage": 400,
    "dodge" : 65,
    "damage_type" : "挫傷"
])
});
int valid_enable(string usage){return usage=="staff" || usage=="parry"; }
int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
   return notify_fail("你的內力太弱，無法練絕門棍。\n");
    if ((int)me->query_skill("luoying-xinfa", 1) < 50)
   return notify_fail("你的落英心法火候不夠，無法學絕門棍。\n");
    return 1;
}
mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}
int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
   return notify_fail("你的體力太低了。\n");
    if ((int)me->query("neili") < 20)
   return notify_fail("你的內力不夠練絕門棍。\n");
    me->receive_damage("qi", 20);
    return 1;
}
string perform_action_file(string action)
{
        return __DIR__"juemen-gun/" + action;
}
