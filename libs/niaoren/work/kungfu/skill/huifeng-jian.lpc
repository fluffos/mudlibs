        "lvl" : 0,
        "damage_type" : "刺傷"
]),
([      "name":   "烏龍攪柱",
        "action" : "$N劍芒吞吐，幻若靈蛇，右手$w使出一式「烏龍攪柱」，劍勢曼妙，
刺向$n的$l",
        "force" : 130,
        "dodge" : 25,
        "damage" : 300,
