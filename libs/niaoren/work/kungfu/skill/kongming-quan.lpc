// kongming.c

inherit SKILL;

mapping *action = ({
    ([  "action":       "$N使一招「空屋住人」，雙手輕飄飄地箍向$n$l",
        "dodge": 30,
        "parry": 20,
        "force": 80,
        "damage_type": "瘀傷"
	]),
    ([  "action":       "$N左掌一平,右掌一伸,一招「空碗盛飯」直拍$n的$l",
        "dodge": -20,
        "parry": 20,
        "force": 120,
        "damage_type": "瘀傷"
    ]),
    ([  "action":       "$N身形繞$n一轉，雙手上撩,一招「空缽裝水」擊向$n$l",
        "dodge":  25,
        "parry":  20,
        "force": 160,
        "damage_type": "瘀傷"
	]),
    ([  "action":       "$N左掌一按,右掌一揮,一招「虛懷若谷」拍向$n的$l",
        "dodge": -20,
        "parry":  0,
        "force": 200,
        "damage_type": "瘀傷"
	]),
    ([  "action":       "$N使一招「空山鳥語」，$n的$l已圍在$N的重重掌影之下",
        "dodge": -20,
        "parry":  10,
        "force": 240,
        "damage_type": "瘀傷"
    ]),
    ([  "action":       "$N神色一斂，使出「我心空明」，圍繞$n的$l接連出掌",
        "dodge":  40,
        "force": 300,
        "damage_type": "瘀傷"
    ]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("練空明拳必須空手。\n");
	if ((int)me->query("max_neili") < 100)
        return notify_fail("你的內力太弱，無法練空明拳。\n");
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 10)
        return notify_fail("你的內力不夠了！休息一下再練吧。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -5);
	return 1;
}

