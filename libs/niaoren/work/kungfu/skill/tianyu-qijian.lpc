// tianyu-qijian.c 天羽奇劍

inherit SKILL;

mapping *action = ({
([      "action":"$N使一式「海天一線」，手中$w嗡嗡微振，幻成一條疾光刺向$n的$l",
        "force" : 120,
            "dodge" : 0,
        "damage": 40,
        "lvl" : 0,
        "skill_name" : "海天一線",
        "damage_type":  "割傷"
]),
([      "action":"$N錯步上前，使出「閃電驚虹」，手中$w划出一道劍光劈向$n的$l",
        "force" : 140,
            "dodge" : 10,
        "damage": 50,
        "lvl" : 5,
        "skill_name" : "閃電驚虹",
        "damage_type":  "割傷"
]),
([      "action":"$N手中$w一抖，一招「日在九天」，斜斜一劍反腕撩出，攻向$n的$l",
        "force" : 160,
           "dodge" : 5,
        "damage": 60,
        "lvl" : 15,
        "skill_name" : "日在九天",
        "damage_type":  "割傷"
]),
([      "action":"$N手中劍鏘    長吟一聲，一式「咫尺天涯」，一道劍光飛向$n的$l",
        "force" : 180,
            "dodge" : 10,
        "damage": 110,
        "lvl" : 20,
        "skill_name" : "咫尺天涯",
        "damage_type":  "刺傷"
]),
([      "action":"$N一式「怒劍狂花」，手中$w舞出無數劍花，使$n難斷虛實，無可躲避",
        "force" : 220,
            "dodge" : 15,
        "damage": 120,
        "lvl" : 25,
        "skill_name" : "怒劍狂花",
        "damage_type":  "刺傷"
]),
([      "action":"$N手中$w斜指蒼天，劍芒吞吐，一式「九弧震日」，對准$n的$l斜斜擊出",
        "force" : 300,
            "dodge" : 5,
        "damage": 120,
        "lvl" : 30,
        "skill_name" : "九弧震日",
        "damage_type":  "刺傷"
]),
([      "action":"$N一式「漫天風雪」，手腕急抖，揮洒出萬點金光，刺向$n的$l",
        "force" : 320,
            "dodge" : 5,
        "damage": 125,
        "lvl" : 35,
        "skill_name" : "漫天風雪",
        "damage_type":  "刺傷"
]),
([      "action":"$N一式「天河倒瀉」，$w飛斬盤旋，如疾電般射向$n的胸口",
        "force" : 380,
            "dodge" : 5,
        "damage": 140,
        "lvl" : 40,
        "skill_name" : "天河倒瀉",
        "damage_type":  "刺傷"
]),
([      "action":"$N一式「天外飛仙」，$w突然從天而降，一片金光圍掠$n全身",
        "force" : 380,
            "dodge" : 5,
        "damage": 150,
        "lvl" : 50,
        "skill_name" : "天外飛仙",
        "damage_type":  "刺傷"
])
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me) { return 1; }

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("tianyu-qijian",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不對。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的體力不夠練天羽奇劍。\n");
        me->receive_damage("qi", 25);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"tianyu-qijian/" + action;
}
