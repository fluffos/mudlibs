// kurong-shengong.c 枯榮神功
// by jackyboy@cctx

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("kurong-shengong", 1);

	if ( me->query("gender") == "無性" && lvl > 49)
		return notify_fail("你無根無性，陰陽不調，難以領會高深的枯榮神功。\n");
	if ( me->query_skill("force",1)<100)
		return notify_fail("你的基本內功火候不到，無法練習枯榮神功。\n");
	if ( me->query_skill("tianlong-shengong",1)<40)
		return notify_fail("枯榮神功是以天龍神功為基礎的，你必須先練好天龍神功。\n");
	return 1;
}

int practice_skill(object me)
{
    return notify_fail("枯榮神功只能用學的，或是從運用(exert)中增加熟練度。\n");
}

