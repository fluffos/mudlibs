// shaolin-shenfa.c 少林身法
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([	"action" : "$n一式「一葦渡江」，前后腳腳尖腳跟相靠，身體如行云流水般滑出丈余。\n",
	"dodge"  : 10
]),
([	"action" : "$n一式「雨燕掠波」，雙臂前伸，全身貼地平飛，頓時閃過了$N的凌厲攻勢。\n",
	"dodge"  : 20
]),
([	"action" : "$n一式「移步換形」，足不動，手不抬，一轉眼間便繞到了$N的身后。\n",
	"dodge"  : 30
]),
([	"action" : "$n一式「風馳電掣」，雙腳點地，全身一道閃電，急速繞著$N飛奔。\n",
	"dodge"  : 40
]),
([	"action" : "$n一式「孤騖落日」，全身筆直，拔地而起，在半空中一轉，已落到几丈遠的地方。\n",
	"dodge"  : 50
]),
([	"action" : "$n一式「鴻雁雙飛」，兩臂鵬舉如翼，在剌剌風聲中，從$N頭頂橫躍而過。\n",
	"dodge"  : 60
]),
([	"action" : "$n一式「蒼龍出水」，雙腳點地，全身化為一道白影，急速繞著$N打了几轉。\n",
	"dodge"  : 70
]),
([	"action" : "$n一式「稚鳳歸巢」，身體如陀螺般急轉，氣流形成一個個漩渦，令$N陷身其間，動彈不得。\n",
	"dodge"  : 80
])
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("shaolin-shenfa");

	if (level < 80 )
		zhaoshu--;

	if (level < 60)
		zhaoshu--;

	if (level < 40 )
		zhaoshu--;
        if (random(me->query_skill("dodge")) > 100 &&
            me->query_skill("force") > 60 &&
            me->query("neili") > 40) {
            me->add("neili",-5);
            return (["action" : YEL"$n陡然使出「少林身法」之絕技「分身化影」，身形猶如鬼魅消失得無影無蹤!\n"NOR,
                     "dodge"  : 300
                          ]); 
            }

	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的體力太差了，不能練少林身法。\n");
	me->receive_damage("qi", 30);
	return 1;
}
