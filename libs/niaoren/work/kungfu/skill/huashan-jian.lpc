// huashan-jianfa.c 華山劍法
// Modified by Venus Oct.1997

mapping *action = ({
([  "action" : "$N一招「白云出岫」，手中$w點向$n的$l",
    "damage" : 20,
    "damage_type" : "刺傷"
]),
([  "action" : "$N使出「有鳳來儀」，$w閃爍不定，刺向$n的$l",
    "damage" : 25,
    "damage_type" : "刺傷"
]),
([  "action" : "$N一招「天紳倒懸」，$w自上而下划出一個大弧，向$n劈砍下去",  
    "damage" : 30,
    "damage_type" : "刺傷"
]),
([  "action" : "$N向前跨上一步，手中$w使出「白虹貫日」直刺$n的$l",
    "damage" : 35,
    "damage_type" : "刺傷"
]),
([  "action" : "$N手中的$w一晃，使出「蒼松迎客」直刺$n的$l",
    "damage" : 50,
    "damage_type" : "刺傷"
]),
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry")
; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
   return notify_fail("你的內力不夠。\n");
    if ((int)me->query_skill("zixia-shengong", 1) < 20)
   return notify_fail("你的紫霞神功火候太淺。\n");
    if ((int)me->query_skill("huashan-ken", 1) < 20)
   return notify_fail("你的華山拳火候太淺。\n");
    return 1;
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
   return notify_fail("你使用的武器不對。\n");
    if ((int)me->query("qi") < 50)
   return notify_fail("你的體力不夠練華山劍法。\n");
    me->receive_damage("qi", 30);
    return 1;
}

