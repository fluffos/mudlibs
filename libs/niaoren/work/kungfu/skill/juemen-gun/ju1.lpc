// 碎劍
#include <ansi.h>
inherit F_SSERVER;
int perform(object me)
{
	string msg;
	object weapon, weapon2, target;
	int skill, ap, dp, damage;
	me->clean_up_enemy();
	target = me->select_opponent();
	skill = me->query_skill("juemen-gun",1);
	if( !(me->is_fighting() ))
		return notify_fail("「碎劍」只能對戰斗中的對手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不對。\n");

	if (!objectp(weapon2 = target->query_temp("weapon"))
	|| (string)weapon2->query("skill_type") != "sword")
		return notify_fail("對方沒有使劍，你用不了「碎劍」。\n");
	if( skill < 50)
		return notify_fail("你的絕門棍等級不夠, 不能使用「碎劍」！\n");
	if( me->query("neili") < 50 )
		return notify_fail("你的內力不夠，無法運用「碎劍」！\n");
	msg = HIC "$N潛運內力，忽地絕門棍之「碎劍」快如閃電襲向$n。\n";
	message_vision(msg, me, target);
	damage = 10 + random(skill / 2);
	ap = me->query_skill("staff") + skill;
	dp = target->query_skill("sword") / 2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		if(userp(me))
			me->add("neili",-50);
		msg = "$n頓時覺得眼前亮光一閃，手一震，手中";
		msg += weapon2->name();
		msg += "脫手而出！\n" NOR;
		target->receive_damage("qi", damage);
		target->start_busy(2);
		weapon2->move(environment(me));
        }
	else
	{
		if(userp(me))
			me->add("neili",-30);
		msg = "可是$n看破了$N的「碎劍」，立刻將手中" + weapon2->name() + "即時抽回，使$N的「碎劍」沒有起到作用。\n"NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);
	return 1;
}
