#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "skill_name" : "讓字訣",
    "action" : "$N使出「讓字訣」，上身側過，手中刀斜斜砍出，一道白光劈向$n的
$l",
    "force" : 170,
    "dodge" : 30,
    "damage_type" : "砍傷",
    "lvl" : 0
]),
([      "skill_name" : "打字訣",
    "action" : "$N使出「打字訣」，左手護頂，大喝一聲，右手刀當頭直劈，化作一
道白芒直向$n的$l砍落",
    "force" : 240,
    "dodge" : 15,
    "damage_type" : "砍傷",
    "lvl" : 10
]),
([      "skill_name" : "頂字訣",
    "action" : "$N使出「頂字訣」，左手后撤，刀斜上招架，順勢下剁，左手自腋下
穿出，托住對方手腕，刀光不停指向$n的$l",
    "force" : 300,
    "dodge" : 5,
    "damage_type" : "砍傷",
    "lvl" : 20
]),
([      "skill_name" : "引字訣",
    "action" : "$N使出「引字訣」，側身而上，身形突閃，左手帶過對方$n兵刃，右
手刀猛地彈出，把$n絞在刀光中",
    "force" : 350,
    "dodge" : -5,
    "damage_type" : "砍傷",
    "lvl" : 30
]),
([      "skill_name" : "套字訣",
    "action" : "$N使出「套字訣」，身形向后乍然一閃，左手急速纏住$n左手，手中
刀一陣亂披風，刀光罩住$n的$l",
    "force" : 400,
    "dodge" : 20,
    "damage_type" : "砍傷",
    "lvl" : 40
]),
([      "skill_name" : "陳字訣",
    "action" : "$N使出「陳字訣」，身法陡變，輕靈飄忽，捉摸不透，乘$n眼花耳鳴
之際，右手刀光反卷向$n的$l",
    "force" : 425,
    "dodge" : 15,
    "damage_type" : "砍傷",
    "lvl" : 50
]),
([      "skill_name" : "探字訣",
    "action" : "$N使出「探字訣」，輕盈地一個急轉身，兩腳撤步，右手刀盡力向前
，直抵$n的$l",
    "force" : 450,
    "dodge" : 20,
    "damage_type" : "砍傷",
    "lvl" : 60
]),
([      "skill_name" : "逼字訣",
    "action" : "$N凝神使出「逼字訣」，身隨意轉，手隨心動，繞著$n疾轉，手中刀
光漫卷，將$n的全身籠罩在自己布下的刀網中，無從逃脫",
    "force" : 500,
    "dodge" : 25,
    "damage_type" : "砍傷",
    "lvl" : 70
]),
([      "skill_name" : "藏字訣",
    "action" : "$N凝神使出「藏字訣」，側身藏刀，引誘$n前進了一步，刀光陡現，
勢如千軍萬馬，奔騰而出",
    "force" : 500,
    "dodge" : 25,
    "damage_type" : "砍傷",
    "lvl" : 80
]),
([      "skill_name" : "錯字訣",
    "action" : "$N凝神使出「錯字訣」，雙手交叉，刀光批攉，$n實在看不清刀光來
向，退后欲避，只覺一陣寒氣直逼過來",
    "force" : 500,
    "dodge" : 25,
    "damage_type" : "砍傷",
    "lvl" : 90
]),
});

int valid_enable(string usage) { return usage=="blade" ||  usage=="parry"; }    

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 50)
   return notify_fail("你的內力不夠。\n");
    if ((int)me->query_skill("linji-zhuang", 1) < 20)
   return notify_fail("你的臨濟十二庄火候太淺。\n");
    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("yanxing-dao
", 1) )
   return notify_fail("你的基本刀法火候太淺。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
    return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("yanxing-dao", 1);
    for(i = sizeof(action); i > 0; i--)
    if(level > action[i-1]["lvl"])
    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
   return notify_fail("你使用的武器不對。\n");
    if ((int)me->query("qi") < 50)
   return notify_fail("你的體力不夠練雁行刀。\n");
    me->receive_damage("qi", 10);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"yanxing-dao/" + action;
}
