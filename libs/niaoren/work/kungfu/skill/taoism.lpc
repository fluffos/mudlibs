// taoism.c

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) 
{
	int lvl;
	
	lvl = (int)me->query_skill("taoism", 1);
	
/*	if( (int)me->query("shen") < 0 )
		return notify_fail("你的邪氣太重，無法修煉道學心法。\n");
*/		
	if(me->query("gender") == "無性" && lvl > 39)
		return notify_fail("你剛聽一會兒，便覺心智迷糊，原來你沒有陽剛之氣，無法領會里面的陰陽變化之道。\n");
		
	if(me->query("class") == "bonze")
		return notify_fail("哈哈！"+RANK_D->query_respect(me)
			+"即入佛門，怎么卻來學道家心法？\n");


	return 1;
}

int practice_skill(object me)
{	
	return notify_fail("道學心法只能靠學習來提高。\n");
}
