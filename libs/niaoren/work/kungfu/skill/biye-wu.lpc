// biye-wu.c 碧葉隨風舞

inherit SKILL;

mapping *action = ({
([	"action" : "$N雙手揚起，輕飄飄一式「葉落」，掌若落葉，向$n的$l拍去",
	"force" : 60,
	"dodge" : 2,
	"skill_name" : "葉落",
	"lvl" : 0,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N左腳為軸心，右腳一旋，雙手交替揮舞，如竹葉翻飛，正是「葉舞」，向$n的$l拍下",
	"force" : 80,
	"dodge" : 0,
	"skill_name" : "葉舞",
	"lvl" : 20,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N身體高高躍起，左手立在胸前，右臂微曲，使一招「葉飄零」，向$n的$l和面門打去",
	"force" : 100,
	"dodge" : -2,
	"skill_name" : "葉飄零",
	"lvl" : 40,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N微一運勁，雙掌青筋爆露，一式「枯葉」，將$n渾身上下都籠罩在重重掌影之中",
	"force" : 200,
	"dodge" : -4,
	"skill_name" : "枯葉",
	"lvl" : 60,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N雙掌平攤，左掌緩緩收至肩，右掌猛向前推出，\n掌風帶著破空聲，一招「彈枝」，如竹枝反彈，直奔$n心窩而去",
	"force" : 300,
	"dodge" : -6,
	"skill_name" : "彈枝",
	"lvl" : 80,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N突然收掌，由腹部向前向上推出，掌風如濤，一式「葉如潮」，一片勁風直逼$n",
	"force" : 500,
	"dodge" : -8,
	"skill_name" : "葉如潮",
	"lvl" : 100,
        "damage_type" : "瘀傷"
]),
});

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練碧葉隨風舞必須空手。\n");
	if ((int)me->query_skill("biyun-xinfa", 1) < 30)
		return notify_fail("你的碧云心法火候不夠，無法學碧葉隨風舞。\n");
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力太弱，無法練碧葉隨風舞。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

///* ----------------
//mapping query_action(object me, object weapon)
//{
//	return action[random(sizeof(action))];
//}
//-------------------*/

mapping query_action(object me, object weapon)
{
	int i, level;
    level   = (int) me->query_skill("biye-wu",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 5, level/5)];

}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 30)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的內力不夠練碧葉隨風舞。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"biye-wu/" + action;
}
