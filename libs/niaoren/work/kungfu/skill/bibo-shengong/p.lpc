// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

    if( target != me ) return notify_fail("你只能用碧波神功提升自己的戰斗力。\n");

	if( (int)me->query("neili") < 100)
		return notify_fail("你的內力不夠!");
    if( (int)me->query_temp("powerup") ) return notify_fail("你已經在運功中了。\n");

	skill = me->query_skill("force");

	me->add("neili", -100);
    me->receive_damage("qi", 0);

	message_vision(
        HIR "$N舌尖一咬，噴出一口鮮血，運起碧波神功已將全身潛力盡數提起！\n" NOR, me);

	me->add_temp("apply/attack", skill/3);
	me->add_temp("apply/dodge", skill/3);
	me->set_temp("powerup", 1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/3 :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int amount)
{
   if ( (int)me->query_temp("powerup") ) {
	me->add_temp("apply/attack", - amount);
	me->add_temp("apply/dodge", - amount);
	me->delete_temp("powerup");
    tell_object(me, "你的碧波神功運行完畢，將內力收回丹田。\n");}
}
