// wuzhuan.c 奇門五轉
#include <ansi.h>
int exert(object me)
{
        int skill;
        skill = (int)me->query_skill("bibo-shengong",1);
        if (me->query_condition("bibo_wuzhuan"))
                  return notify_fail("你已經在運奇門五轉了！\n");
          if( (int)me->query_skill("bibo-shengong",1) < 100)
                return notify_fail("你的碧波神功級別不夠。\n");
        if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
                return notify_fail( "已經受傷過重，無法運功！\n");
        message_vision(
  HIR "$N坐了下來運起奇門五轉，天地真氣慢慢流入你的體內\n"
    "頓感真氣十足。\n" NOR, me );
              me->apply_condition("bibo_wuzhuan", (int)skill/40);
                me->add("neili", (int)skill*10);
              me->set("bibo/wuzhuan", (int)skill/40);
        return 1;
}
