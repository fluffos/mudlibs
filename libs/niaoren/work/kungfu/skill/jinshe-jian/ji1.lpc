// suo.c 鎖劍訣

#include <ansi.h>

inherit F_SSERVER;

int perform(object me)
{
        string msg;
        object weapon, weapon2, target;
        int skill, ap, dp, damage;



        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("jinshe-jian",1);

        if( !(me->is_fighting() ))
            return notify_fail("「鎖劍訣」只能對戰斗中的對手使用。\n");

        if (!objectp(weapon2 = target->query_temp("weapon")))
            return notify_fail("對方沒有使用兵器，你用不了「鎖劍訣」。\n");

       if( skill < 100)
            return notify_fail("你的金蛇劍法等級不夠, 不能使用「鎖劍訣」！\n");

        if( me->query("neili") < 300 )
            return notify_fail("你的內力不夠，無法運用「鎖劍訣」！\n");

   msg = HIC "$N內力急提並運至手上，手中的劍泛出"YEL"金光"HIC"，$N斜刺一拉，使出「鎖劍訣」！
"HIC"劍身如靈蛇般正好纏在$n的"+weapon2->name()+"上。\n";
        message_combatd(msg, me, target);

        damage = 10 + random(skill / 2);
        ap = me->query_skill("sword")/3 + skill;
        dp = target->query_skill("dodge")/2;
        if( dp < 1 )
            dp = 1;
        if( random(ap) > random(dp) )
        {
            if(userp(me))
                 me->add("neili",-50);
            msg = "$n頓時覺得眼前金光一閃，手腕一振，手中";
            msg += weapon2->name();
            msg += "脫手飛出！\n" NOR;
            me->start_busy(random(2));
            target->receive_damage("qi", damage);
            target->start_busy(2);
            weapon2->move(environment(me));
        }
        else
        {
            if(userp(me))
                 me->add("neili",-30);
            msg = "$n急運內力，將手中" + weapon2->name()+
"斜斜順勢一送一搭，抽了回來。\n"NOR;
            me->start_busy(4);
        }
        message_combatd(msg, me, target);

        return 1;
}
