// chanchu_bufa.c 蟾蜍步法

inherit SKILL;

string *dodge_msg = ({
	"只見$n一招「蟾飛九天」，身體向上筆直地縱起丈余，躲過了$N這一招。\n",
	"但是$n一個使出「蛙鳴震天」，身形飄忽，輕輕一縱，早已避開。\n",
	 "$n一招「蛙入稻田」，身行隨意轉，倏地往一旁挪開了三尺，避過了這一招。\n",
	"可是$n一個「蟾蜍扑虫」，側身一讓，$N這一招扑了個空。\n",
	"卻見$n「蟾翻白肚」，足不點地，往旁竄開數尺，躲了開去。\n",
	"$n身形一招「金蟾歸月」，身形微晃，有驚無險地避開了$N這一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 45 )
		return notify_fail("你的體力太差了，不能練蟾蜍步法。\n");
	me->receive_damage("qi", 35);
	return 1;
}

