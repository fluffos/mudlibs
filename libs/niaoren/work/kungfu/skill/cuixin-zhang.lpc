inherit SKILL;

mapping *action = ({
([	"action" : "$N使一招「風起云涌」，雙手飄移不定擊向$n$l",
	"force" : 160,
	"dodge" : 2,
	"skill_name" : "風起云涌",
	"lvl" : 10,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N倏忽欺至$n身前，一招「揚波起浪」直拍$n的$l",
	"force" : 240,
	"dodge" : 0,
	"skill_name" : "揚波起浪",
	"lvl" : 30,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N身形繞$n一轉，一招「風雷并起」向$n$l接連出掌",
	"force" : 320,
	"dodge" : -2,
	"skill_name" : "風雷并起",
	"lvl" : 50,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N身形拔起，在半空一招「急電驚雷」右掌猛擊$n的$l",
	"force" : 400,
	"dodge" : -4,
	"skill_name" : "急電驚雷",
	"lvl" : 90,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N使一招「含沙射影」，縱起丈余直擊$n的$l",
	"force" : 500,
	"dodge" : -6,
	"skill_name" : "含沙射影",
	"lvl" : 120,
        "damage_type" : "瘀傷"
]),
([	"action" : "$N一聲大喝使出「奪魄催心」，幻出滿天掌影，掌掌不離$n的$l",
	"force" : 620,
	"dodge" : -8,
	"skill_name" : "奪魄催心",
	"lvl" : 150,
        "damage_type" : "瘀傷"
]),
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練催心掌必須空手。\n");
	if ((int)me->query_skill("bibo-shengong", 1) < 20)
		return notify_fail("你的碧波神功火候不夠，無法學催心掌。\n");
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力太弱，無法練催心掌。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
    level   = (int) me->query_skill("cuixin-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 5, level/5)];

}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 30)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的內力不夠練催心掌。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"cuixin-zhang/" + action;
}
