//mahayana.c  大乘涅磐功
inherit SKILL;

string type() { return "knowledge"; }
int valid_learn(object me)
{
    mapping myfam;
    myfam = (mapping)me->query("family");
    if (!myfam || (myfam["family_name"] != "峨嵋派"))
       return notify_fail("你不是峨嵋弟子，不能修煉大乘涅磐功。\n");

    if ((int)me->query("shen") < 0 )
       return notify_fail("你的邪氣太重，無法修煉大乘涅磐功。\n");

//    if (me->query_skill("persuading",1) <= me->query_skill("mahayana",1))
//       return notify_fail("你的善行太少，修煉大乘涅磐功也沒用。\n");

    if(me->query_skill("taoism",1) > 1)
       return notify_fail("哈哈！"+RANK_D->query_respect(me)
                   +"學了牛鼻子的功夫，怎么卻來學大乘涅磐功？\n");
    if( (int)me->query_skill("poison",1) > 1 )
      return notify_fail("你學了邪門毒技，無法修煉大乘涅磐功。\n");

    return 1;
}
void skill_improved(object me)
{}
