// ci.c 六脈神劍 - 刺
// Written by Doing Lu 1999/1/4

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int lvl;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「刺」字決攻擊只能對戰斗中的對手使用。\n");

	if (objectp(weapon = me->query_temp("weapon")))
			return notify_fail("你不能使用武器！\n");

	lvl = (int) me->query_skill("liumai-shenjian", 1);
	if( lvl < 100 )
		return notify_fail("你的六脈神劍太生疏，不會使用「刺」字決。\n");

	if ( me->query("neili") < 400)
		return notify_fail("你的內力不夠，現在無法使用「刺」字決。\n");
	me->add("neili", -40);


	msg = HIG "$N使出六脈神劍「刺」式，指尖飛揚，霎時間劍氣縱橫，將$n包圍在內。\n";

	me->start_busy(2);
	if( random( me->query("neili") + me->query("liumai-shenjian") * 10 ) > random((int) target->query("neili") + (int) target->query("dodge") * 10)) {
		msg += HIR " 結果$p一聲悶哼，連被數創。\n" NOR;
		target->receive_damage("qi", random(lvl) + lvl);
		target->receive_wound("qi", random(lvl));
	} else {
		msg += "可是$p連連招架，堪堪擋住了$P攻勢。\n" NOR;
	}
	message_vision(msg, me, target);

	return 1;
}
