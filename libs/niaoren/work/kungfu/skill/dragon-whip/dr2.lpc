//wd2.c -「群龍無首」 leos 2000.0924
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    if( !target ) target = offensive_target(me);
    if( !target||!target->is_character()||!me->is_fighting(target) )
    return notify_fail("你只能對戰鬥中的對手使用「群龍無首」。\n");
    if( (int)me->query_skill("dragon-whip",1) < 70)
    return notify_fail("你目前功力還使不出「群龍無首」。\n");
    if( (int)me->query("neili") < 200 )
    return notify_fail("你的內力不夠。\n");
    me->add("neili", -60);
    msg = HIC"$N淡然一笑，使出一招 "HIM"[ 群 龍 無 首 ]"NOR"本就攻勢凌厲的鞭法驟然變得更加猛亂！\n
    就在這一瞬之間，"+ "$N"BLINK"已揮舞出數十鞭！鞭鞭雜著勁風，風裡含著鞭影，狂亂攻向$n！\n"NOR;
//  me->start_busy(2);

    if( random(me->query("combat_exp")) >
      (int)target->query("combat_exp")/3 ) {
    target->start_busy( (int)me->query_skill("dragon-whip") / 20 );
    damage = (int)me->query_skill("dragon-whip", 1)+(int)me->query_skill("whip", 1)/2;
    damage = damage + random(damage);

    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage/2);
   msg += RED
"只見$n已被$N鞭得體無完膚，血如箭般由全身噴射而出！\n"NOR;
    } else {
    msg += HIC "只見$p急忙抽身躲開，$P這招沒有得逞。\n" NOR;
    }
    message_combatd(msg, me, target);
    if(userp(target)) target->fight_ob(me);
    else if( !target->is_killing(me) ) target->kill_ob(me);

    return 1;
}
