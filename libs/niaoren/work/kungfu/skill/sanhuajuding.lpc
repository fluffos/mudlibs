  int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_combine(string combo) { return combo=="sanhuajuding"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練三花聚頂掌必須空手。\n");
	if ((int)me->query("max_neili") < 50)
		return notify_fail("你的內力太弱，無法練三花聚頂掌。\n");
         if ((int)me->query_skill("shenzhao-shengong",1)< 20)
            return notify_fail("你的神照神功修為不夠，無法練三花聚頂掌。\n");      
	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("sanhuajuding",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 30)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的內力不夠練三花聚頂掌。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"sanhuajuding/" + action;
}
