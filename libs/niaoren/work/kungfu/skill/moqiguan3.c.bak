//魔拳 mogiquann.c
//menpai skill(can also be used by non-menpai NPCs) leos 2000.4.28

inherit SKILL;

mapping *action = ({
        ([      "action":
"只見$N身形一變，大喝聲中一個對准$n的鼻子呼！地砸了過去",
                "dodge":               25,
                "parry":               25,
       "force":     90,
                "damage_type":  "砸傷"
        ]),
        ([      "action":
"$N一招"HIW" 杞人憂天 "NOR"抬頭向天，渾若不見，呼的一掌向自己頭頂空空拍出，手掌斜下，掌力化成弧形，四散落下拍向$n的$l。",
//"$N左手一分，右拳運氣，一招「"HIC" 惡魔倒天 "NOR"」便往$n的$l招呼過去",
                "dodge":               35,
                "parry":               35,
       "force":     60,
                "damage_type":  "瘀傷"
        ]),
        ([      "action":
"$N右拳在$n面門一晃，左掌使了個「"HIR" 惡魔之擊 "NOR"」往$n的$l狠命一抓",
                "dodge":               55,
                "parry":               55,
       "force":     60,
                "damage_type":  "抓傷"
        ]),
        ([      "action":
"$N步履一沉，左拳拉開，右拳帶風，一招「"HIG" 鳥人大腳踹 "NOR"」勢不可擋地擊向$n$l",
                "dodge":               25,
                "parry":               25,
       "force":     80,
                "damage_type":  "瘀傷"
        ]),
        ([      "action":
"只見$N拉開架式，一招「"HIB" 雙爪通天 "NOR"」使得虎虎有風。底下卻飛起一腳踢向$n$l",
                "dodge":               25,
                "parry":               25,
       "force":     70,
                "damage_type":  "瘀傷"
        ]),
        ([      "action":
"$N打得興起，大喝一聲：看我這招「"MAG" 神魔相交 "NOR"」！\n左手往$n身后一抄，右拳便往$n面門砸了過去",
                "dodge":               45,
                "parry":               45,
       "force":     120,
                "damage_type":  "砸傷"
        ]),
        ([      "action":
"$N拉開后弓步，雙掌使了個「"HIY" 封神掌 "NOR"」往$n的$l一推",
                "dodge":               45,
                "parry":               45,
       "force":     50,
                "damage_type":  "瘀傷"
        ]),
        ([      "action":
"只見$N運足氣力，一連三拳擊向$n$l，力道一拳高過一拳！\n這一招的名字叫作「"BLU" 妖魔破 "NOR"」",
                "dodge":               35,
                "parry":               35,
       "force":     80,
                "damage_type":  "瘀傷"
        ]),
        ([      "action":
"$N往后一縱，就勢使了個「"WHT" 妖樹纏根 "NOR"」，右腿掃向$n的$l",
                "dodge":               25,
                "parry":               25,
       "force":     50,
                "damage_type":  "砸傷"
        ]),
        ([      "action":
"$N一個轉身，左掌護胸，右掌反手使了個「"RED" 毀天滅地 "NOR"」往$n當頭一劈",
                "dodge":               55,
                "parry":               55,
       "force":     90,
                "damage_type":  "砸傷"
        ]),
        ([      "action":
"$N飛身躍起，半空中一腳踢向$n面門，卻是個虛招。\n說時遲那時快，只見$N一個倒翻，雙掌已到了$n的$l",
                "dodge":               25,
                "parry":               25,
       "force":     100,
                "damage_type":  "瘀傷"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon")
)
                return notify_fail("練魔拳必須空手。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="unarmed" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
   if( (int)me->query("jing") < 30)
     return notify_fail("你的精神無法集中了，休息一下再練吧。\n");
   if( (int)me->query("qi") < 30 )
     return notify_fail("你現在手足酸軟，休息一下再練吧。\n");
   if( (int)me->query("neili") < 10 )
     return notify_fail("你的內力不夠了。\n");

   me->receive_damage("qi", 30);
   me->add("neili", -10);

   return 1;
}
