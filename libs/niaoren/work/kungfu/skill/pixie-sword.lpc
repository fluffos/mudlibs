#include <ansi.h>
inherit SKILL;

mapping *action = ({
    ([  "name":    "群邪辟易",
        "action":  "$N使一招「群邪辟易」，手中$w圈起，倏地刺出，銀星點點，劍尖直向$n的$l刺去",
        "dodge":   50,
        "damage":  100,
        "damage_type":  "刺傷"
    ]),
    ([  "name":    "鐘馗抉目",
        "action":  "$N一招「鐘馗抉目」，劍隨身轉，圍著$n身圍疾刺，劍光霍霍罩向$n的$l",
        "dodge":   70,
        "damage":  150,
        "damage_type":  "刺傷"
    ]),
    ([  "name":    "花開見佛",
        "action":  "$N舞動$w，一招「花開見佛」挾著無數劍光刺向$n的$l",
        "dodge":   40,
        "damage":  100,
        "damage_type":  "刺傷"
    ]),
    ([  "name":    "流星趕月",
        "action":  "$N手中$w一聲清嘯，祭出「流星趕月」劍鋒閃爍不定，銀光飛舞，猛地里一劍挺出，直刺$n$l",
        "dodge":   30,
        "damage":  100,
        "damage_type":  "刺傷"
    ]),
    ([  "name":    "飛燕穿柳",
        "action":  "$N手中$w劍光暴長，一招「飛燕穿柳」往$n$l刺去",
        "dodge":   60,
        "damage":  100,
        "damage_type":  "刺傷"
    ]),
    ([  "name":    "江上弄笛",
        "action":  "$N手中$w化成一道光弧，直指$n$l，一招「江上弄笛」發出虎哮龍吟刺去",
        "dodge":   10,
        "damage":  100,
        "damage_type":  "刺傷"
    ]),
});

int valid_learn(object me)
{
    object ob;

    if ( (string)me->query("gender")=="女性" )
        return notify_fail("女子不能學辟邪劍法.\n");

//   if ( (string)me->query("gender")=="男性" )
//        return notify_fail("你必須先自宮,才能練辟邪劍法.\n");

    if( (int)me->query("max_neili") < 50 )
        return notify_fail("你的內力不夠，沒有辦法練辟邪劍法。\n");
//   if( (string)me->query_skill_mapped("force")!= "nine-moon-force")
//        return notify_fail("九陰赤煉劍法必須配合九陰心經才能練。\n");
    if( !(ob = me->query_temp("weapon"))
      || (string)ob->query("skill_type") != "sword" )
          return notify_fail("你必須先找一把劍才能練劍法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 30
    ||  (int)me->query("neili") < 5 )
       return notify_fail("你的內力或氣不夠，沒有辦法練習辟邪劍法！\n");
    me->receive_damage("qi", 30);
    me->add("neili", -5);
    write("你按著所學練了一遍辟邪劍法。\n");
    return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

void skill_improved(object me)
{
    if( (int)me->query_skill("pixie-sword", 1)  % 10 == 0 ) {
        tell_object(me,
           RED "\n你突然覺得一股陰氣沖上心頭，只覺得想殺人....\n\n"NOR);
        me->add("shen", -2000);
    } else
    me->add("shen", -200);
}
