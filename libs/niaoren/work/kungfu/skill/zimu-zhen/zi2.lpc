// poqizhen.c 破氣針
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
	string msg;
	object weapon, target;
	int skill, ap, dp, neili_wound, qi_wound;

	me->clean_up_enemy();
	target = me->select_opponent();

	skill = me->query_skill("zimu-zhen",1);

	if( !(me->is_fighting() ))
		return notify_fail("「破氣針」只能在戰斗中用在對手身上。\n");
 
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不對。\n");

	if( skill < 80)
		return notify_fail("你的子母針法不夠純熟, 不能使用「破氣針」！\n");

	if( me->query("neili") < 150 )
		return notify_fail("你的內力不夠，無法運用「破氣針」！\n");
 
	msg = HIY "$N并指入刀，指縫間夾著三枚暗器,潛運內力，一式「破氣針」，直奔$n的上、中、下丹田打去。\n";
	message_vision(msg, me, target);
 
	ap = me->query_skill("throwing") + skill;
	dp = target->query_skill("force") / 2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		if(userp(me))
			me->add("neili",-100);
		msg = "$N「破氣針」正中目標, $n頓時覺得丹田上一陣刺痛，\n";
		msg += "全身真氣狂泄而出！\n" NOR;

		neili_wound = 500 + random(skill);
		if(neili_wound > target->query("neili"))
			neili_wound = target->query("neili");

		qi_wound = neili_wound / 5;
		if(qi_wound > target->query("qi"))
			qi_wound = target->query("qi");

		target->add("neili", -neili_wound);
		target->add("qi", -qi_wound);
		target->add("eff_qi", -qi_wound);
		target->start_busy(2);
//		me->start_busy(random(2));
	}
	else
	{
		if(userp(me))
			me->add("neili",-80);
		msg = "可是$n瞬間反應過來，騰挪跳躍，躲過了這次重創。\n"NOR;
		me->start_busy(2);
	}
	message_vision(msg, me, target);

	return 1;
}
