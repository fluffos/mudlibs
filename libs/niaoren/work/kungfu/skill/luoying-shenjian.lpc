// luoying-shenjian.c 落英神劍

#include <ansi.h>

inherit SKILL;

mapping *action = ({
    ([  "name":         "落英繽紛",
        "action":       "$N使一招「落英繽紛」，身形向上飄起，手中$w虛虛實實幻出萬點劍花紛紛揚揚撒向$n$l",
        "force":        100,
		"parry":        5,
        "damage":       40,
		"damage_type":	"刺傷"
	]),
    ([  "name":         "人面桃花",
        "action":       "$N舞動$w，一式「人面桃花」，左手向$n面門一晃，右手$w抖出几朵劍花挾著虎虎劍氣刺向$n的$l",
        "force":        140,
        "parry":        -20,
        "damage":       50,
        "damage_type":  "刺傷"
    ]),
    ([  "name":         "急風驟雨",
        "action":       "$N身形繞$n一轉，手中$w望空一指，一式「急風驟雨」幻出滿天劍影，向$n$l接連揮出數劍",
        "force":        180,
		"dodge":        10,
        "damage":       70,
		"damage_type":	"割傷"
	]),
    ([  "name":         "江城飛花",
        "action":       "$N身形飄然而起，在半空中身子一旋，悠然一式「江城飛花」手中$w若有若無淡淡刺向$n的$l",
        "force":        210,
		"dodge":		-10,
        "damage":       120,
		"damage_type":	"刺傷"
	]),
    ([  "name":         "萬花齊落",
        "action":       "$N縱起丈余，一式「細云巧翻胸」頭下腳上，一招「萬花齊落」手中$w舞成一個光球罩向$n的$l",
        "force":        240,
        "dodge":        10,
        "damage":       120,
	"damage_type":	"刺傷"
    ]),
    ([  "name":         "漫天花雨",
        "action":       "$N一聲大喝使出「漫天花雨」，手中$w幻出漫天花瓣，迅若奔雷射向$n的$l",
        "force":        280,
        "dodge":        15,
        "damage":       140,
	"damage_type":	"刺傷"
    ]),
    ([  "name":         "落花無意",
        "action":       "$N輕嘆一聲，手中$w懷中一抱，一時「落花無意」，$w鏘然躍出倏的化作几點帶露的桃花，飄然飛向$n的$l",
        "force":        320,
        "dodge":        0,
        "damage":       140,
	"damage_type":	"刺傷"
    ]),

});

int valid_learn(object me)
{
	object ob;

    if( (int)me->query_skill("bibo-shengong",1) < 30)
        return notify_fail("你的碧波神功火候還不夠。\n");

    if( (int)me->query("max_neili") < 100 )
        return notify_fail("你的內力不夠，不能練落英神劍。\n");

	if (!objectp(ob = me->query_temp("weapon"))
	|| (string)ob->query("skill_type") != "sword")
		return notify_fail("你必須先找一把劍才能學習劍法。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object ob;

    if( (int)me->query("qi") < 30
    ||  (int)me->query("neili") < 5 )
        return notify_fail("你的內力或氣不夠，沒有辦法練習落英神劍。\n");

	if (!objectp(ob = me->query_temp("weapon"))
	|| (string)ob->query("skill_type") != "sword")
		return notify_fail("你必須先找一把劍才能習練劍法。\n");

    me->receive_damage("qi", 30);
	me->add("force", -5);
    write("你按著所學練了一遍落英神劍。\n");
	return 1;
}
