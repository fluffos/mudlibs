int valid_enable(string usage){return usage=="sword" || usage=="parry";}

//int valid_learn(object me)
//{
//     return notify_fail(HIC"天劍神訣無法通過(learn)來取得進步。\n"NOR);
//}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
    return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
            return action[random(sizeof(action))];
}

int practice_skill(object me)
{   if ((int)me->query_skill("tiyunzong", 1) < 150)
    return notify_fail("你的武當梯雲縱火候太淺。\n");
    if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本劍法程度不夠。\n");
    if( (int)me->query("qi") < 35)
    return notify_fail("你的體力目前沒有辦法練習"+HIC"天劍"NOR+"神訣。\n");
    me->receive_damage("qi", 10);
    write("你瀟灑地舞了一遍"+HIC"天劍"NOR+"神訣，渾身劍氣四溢，大有"+MAG"十方無敵"NOR+"之勢。\n");
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"god-sword/" + action;
}

