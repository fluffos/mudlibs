// fire_sense.c 火識神通
// Modified by Venus Oct.1997

#include <ansi.h>

inherit F_SSERVER;
int conjure(object me, object target)
{
    string msg;
    string msg1;
    string msg2;
    string msg3;
    string msg4;
    int damage, ap, dp,i;
    i=random(3);
    if( !target ) target = offensive_target(me);
    if( !target
     || !target->is_character()
     || target->is_corpse()
     || target==me)
    return notify_fail(HIR"你要對誰施展「火識」？\n"NOR);
    if (i==0){
        msg1="$N雙手各捻個法訣，再并攏向外一推，大喝道："+HIC"“般若波羅密，風火雷電……打！！”"NOR+"\n;
        剎那間，風起云涌，濃云密布，一道閃電自天空中疾閃而下向$n劈去！！！\n";
        msg2=HIR"“轟”的一聲打了個正著，"+target->query("name")+"被電得象煙熏豬頭一樣黑！\n"NOR;
        msg3=RED"你只覺得全身發麻，眼前金星亂冒。。。。\n"NOR;
        msg4="jing";
    }
    if(i==1){
        msg1="$N身形一轉散作七處同時口中念道：\n"+HIY"
        “天地無相，萬劍歸宗，浩天正氣，神劍伏魔！！”"NOR+"\n
        只見空中出現萬點金光向$n射去。。。\n";

        msg2="只聽“嗤嗤”聲響不絕，金光射入"+target->query("name")+"身體。"+
        target->query("name")+"變成了千窗百孔的大篩子！！！\n";
        msg3=RED"你只覺的遍體生風，渾身劇痛。\n"NOR;
        msg4="jing";
    }
    if (i==2){
        msg1="$N雙手環抱胸前，口中喃喃念道：\n"+HIR"“天地無極，乾坤借法！！”"NOR+"\n  
        突然大喝一聲：“中！！”\n雙掌并力將一巨大的金色光球推向$n！\n";
        msg2="“砰”！"+target->query("name")+"身子向后一仰，連退了几步………\n";
        msg3="“砰”！你胸口如遭錘擊，兩眼一黑，險些昏了過去！\n";
        msg4="qi";
    }

    if((int)me->query("jingli") < 150 )
        return notify_fail("你的精力不夠！\n");

    if((int)me->query("jing") < 35 )
        return notify_fail("現在你的精神無法有效集中！\n");

    me->add("jingli", -30);

    if( random(me->query("max_jingli")) < 150 ) {
       write("你失敗了。\n");
       return 1;
    }
    msg="\n";
    message_vision(msg1, me, target);
    ap = me->query_skill("bashi-shentong");
    ap = ( ap * ap * ap / 4 ) * (int)me->query("jing") / 100;
    dp = target->query("combat_exp");
    if( random(ap + dp) > dp) {
       damage = (int)me->query("max_jingli") / 10 + random((int)me->query("eff_jing") / 5);
       damage -= (int)target->query("max_jingli") / 20 + random((int)me->query("eff_jing") / 10);
       if(target->is_ghost()) damage=damage*10;
       if( damage > 0 ) {
        target->receive_damage(msg4, damage, me);
        target->receive_wound(msg4, damage/2, me);
        tell_room(environment(me),msg2,target);
        tell_object(target,msg3);
        me->improve_skill("bashi-shentong", 1, 1);
     } else
     {
        msg = "$N的「火識」好象沒有造成任何傷害！\n";
        me->receive_damage("jing", 10);
     }
   } else
   msg = "但是$n巧妙地躲開了。\n";
   message_vision(msg, me, target);

   if( damage > 0 ) COMBAT_D->report_status(target);
   if( !target->is_fighting(me) ) {
     if( living(target) ) {
      if( userp(target) ) target->fight_ob(me);
        else target->kill_ob(me);
     }
     me->kill_ob(target);
   }

   me->start_busy(2);
   return 1;
}

