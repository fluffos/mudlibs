// 雨激梅花半瓣香 五展梅特殊技
// by hem
// yumei.c perform wuzhan-mei
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{      
       int damage;
       object weapon;
       object obj;
       string msg;
        if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() )
	return notify_fail("「雨激梅花半瓣香」只能對對手使用。\n");
	if( (int)me->query_skill("biyun-xinfa", 1) < 60 )
                return notify_fail("你的碧云心法不夠高，不能運用「雨激梅花半瓣香」。\n");

        if( (int)me->query("neili", 1) < 300 )
                return notify_fail("你現在內力太弱，不能使用「雨激梅花半瓣香」。\n");

	if(me->query_skill("wuzhan-mei")<100)
	return notify_fail("你的五展梅不夠嫻熟，不能運用「雨激梅花半瓣香」。\n");
	if (!objectp(weapon = target->query_temp("weapon")))
	return notify_fail("對手并沒有使用武器。\n");
	msg = HIC"$N手中劍斜斜一帶，施展出「雨激梅花半瓣香」，輕飄飄壓住$n的兵器！\n"NOR;
	me->start_busy(1);
//	if (random(me->query_skill("force")) > target->query_skill("force")/4 )
	if( random( (int)me->query("combat_exp",1))>random(target->query("combat_exp") ) )
	{
	msg +=HIC"只聽得一陣金鐵之聲，$p的兵刃竟被$P震碎，碎屑如暴雨般反擊向$p！\n" NOR;
	obj=target->query_temp("weapon");
	destruct(obj);
	damage = (int)me->query_skill("biyun-xinfa", 1);
                
                damage = damage + random(damage/2)+200;
                
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/1);
                me->add("neili", -damage);
	if( damage < 120 )
                        msg += HIY"結果$n被激飛的兵器碎屑擊中，受了點兒傷。\n"NOR;
       else if( damage < 140 )
                        msg += HIY"結果$n被激飛的兵器碎屑擊中，受了些傷。\n"NOR;
        else if( damage < 180 )
                        msg += RED"結果$n被激飛的兵器碎屑擊中，划出滿身傷痕，其狀甚慘！\n"NOR;
                else
                        msg += HIR"結果$n被激飛的兵器碎屑擊中，渾身上下就如刺  一般！\n"NOR;
                
	target->start_busy(1 + random(2));
        } 
	else {
	msg += "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
	me->start_busy(2);
}
message_vision(msg, me, target);
return 1;
}
