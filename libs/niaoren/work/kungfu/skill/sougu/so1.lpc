// muyeyingyang.c 牧野鷹揚

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("牽制攻擊只能對戰斗中的對手使用。\n");

	if((int)me->query_str() < 30)
		return notify_fail("你臂力不夠,不能使用牧野鷹揚！\n");
/*
	if((int)me->query_skill("hunyuan-yiqi",1) < 100)
		return notify_fail("你混元一氣功的功力不夠，不能使用牧野鷹揚！\n");
*/
	if((int)me->query_skill("sougu",1) < 150)
		return notify_fail("你的搜骨鷹爪功修為不夠,目前還不能使用牧野鷹揚！\n");

	if((int)me->query("neili") < 800)
		return notify_fail("你內力現在不夠, 不能使用牧野鷹揚！\n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顧不暇，放膽攻擊吧  \n");

	msg = HIY "$N使出搜骨鷹爪功絕技「牧野鷹揚」，雙爪驀地抓向$n的全身要穴。\n";

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4 ) {
		msg += "結果$p被$P攻了個措手不及，立時動彈不得！\n" NOR;
		target->start_busy( (int)me->query_skill("sougu",1) / 10 + 2);
		me->add("neili", -150);
	} else {
		msg += HIG "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
