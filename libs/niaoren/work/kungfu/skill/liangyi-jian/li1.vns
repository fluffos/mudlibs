// ren.c  兩儀劍法「天地同仁」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;

    if (!target ) target = offensive_target(me);
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
   return notify_fail(RED"開什么\玩笑，沒裝備劍就想使「天地同仁」？\
n"NOR);
    if (!target || !target->is_character() || !me->is_fighting(target) )
   return notify_fail("「天地同仁」只能對戰斗中的對手使用。\n");
    if ((int)me->query_skill("liangyi-jian", 1) < 100 )
   return notify_fail(WHT"你的兩儀劍法不夠嫻熟，還使不出「天地同仁」。\n"NOR);
    if ((int)me->query_skill("taiji-shengong", 1) < 100 )
   return notify_fail(RED"你的太極神功\火候不夠，「天地同仁」不成招式。\n"NOR);
    if ((int)me->query_skill("force", 1) < 100 )
   return notify_fail(RED"你的內功\心法火候不夠，運用「天地同仁」太吃力了。\n"NOR);
    if ((int)me->query("max_neili")<800)
   return notify_fail(RED"你的內力修為不足，無法運足「天地同仁」的內力。\n"NOR);
    if ((int)me->query("neili")<100)
    {
      me->set("neili",10);
      return notify_fail(HIC"你現在內力不夠，沒能將「天地同仁」使完！\n
"NOR);
    }
    msg = HIC "$N手中長劍劍芒躍動，劍光暴長，劍尖顫動似乎分左右刺向$n，$n看到劍光偏左，疾側身向右轉，但只這一剎，劍光剎時襲向右首！\n"NOR;
    if (random(me->query_skill("force")) > target->query_skill("force")/2||
  random(me->query("combat_exp")) > (int)target->query("combat_exp")/3
)
    {
   me->start_busy(2);
   target->start_busy(random(3));
   damage = (int)me->query_skill("liangyi-jian", 1);
   damage = damage + random(damage);
   target->receive_damage("qi", damage);
   target->receive_wound("qi", damage*2);
   target->receive_damage("jing", damage);
   target->receive_wound("jing", damage/2);
   msg += HIC"$n疾忙左轉，卻發現$N的劍根本沒有右偏，一式「天地同仁」在$n左胸留下一個血洞！$n一低頭，看到胸口鮮血涌泉噴出！\n"NOR;
   me->add("neili", -damage/5);
    } else
    {
   me->start_busy(2);
   msg += HIY"可是$p輕輕一笑，側身右轉，果然$P的劍式突然左展，在$p身前划過，僅差半寸。\n"NOR;
    }
    message_vision(msg, me, target);
    return 1;
}

