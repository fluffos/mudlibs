int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_combine(string combo) { return combo=="anranxiaohun-zhang"; }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("練魔界拳必須空手。\n");
        if ((int)me->query("max_neili") < 2000)
                return notify_fail("你的內力太弱，無法練魔界拳。\n");
        if ((int)me->query_str()< 40)
                return notify_fail("你的臂力太弱，無法練魔界拳。\n");       
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("mogiquan",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 50, level)];
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 30)
                return notify_fail("你的體力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的內力不夠練魔界拳。\n");
        me->receive_damage("qi", 25);
        me->add("neili", -30);
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( damage_bonus/2 > victim->query_str() ) {
                victim->receive_wound("qi", (damage_bonus - 100) / 2 );
                return HIR "只聽到“哇”的一聲，"+ victim->name()+"噴出了一大口鮮血！\n" NOR;
        }
}
