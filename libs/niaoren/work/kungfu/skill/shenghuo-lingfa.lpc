int valid_enable(string usage) { return usage == "lingfa"; }

//int valid_combine(string combo) { return combo=="mingwang-jian"; }

int valid_learn(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
           ||(string)weapon->query("skill_type") != "lingfa")
                return notify_fail("你必須使用聖火令才可能練就聖火令法。\n");
        if ((int)me->query_skill("lingfa", 1) < 30)
                return notify_fail("你的基本令法太差了，練不了聖火令法。\n");
        if ((int)me->query_skill("shenghuo-xinfa", 1) < 30)
                return notify_fail("你對聖火心法的領悟不夠，無法學聖火令法。\n");
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        if (random(me->query_skill("lingfa")) > 120 &&
            me->query_skill("force") > 120 &&
            me->query("neili") > 1000 &&
            (string)weapon->query("id") == "shenghuo-ling" ) {
                me->add("neili", -200);
                return ([
          "action" : "只見$N揮力太猛，$w當空墜落，$N急忙俯身去接\n$n看到如此大好時機，豈肯放過，一步搶入准備施展手段\n$n怎知這正中了聖火令法的絕招「偃旗息鼓」\n只見$N突然一個鷂子翻身，$w由下而上急速向$n刺去！",
        "skill_name" : "偃旗息鼓",
//        "force" : 300,
//        "dodge" : 100,
//        "parry" : 100,
//       "lvl" : 120,
        "damage" : 500,
        "damage_type" : "刺傷",
                       ]);
        }
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 50)
                return notify_fail("你的體力不夠，練不了聖火令法。\n");
        if ((int)me->query("neili") < 600)
                return notify_fail("你的內力不夠練聖火令法。\n");
        me->receive_damage("qi", 30);
        me->add("neili", -10);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"shenghuo-lingfa/" + action;
}
