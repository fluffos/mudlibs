// lingxiao.c 天罡指穴法 「凌空指穴」

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("凌空指穴只能對戰斗中的對手使用。\n");

        if( !target ) target = offensive_target(me);

        if((int)me->query_str() < 25)
                return notify_fail("你臂力不夠,不能使用這一絕技!\n");

        if((int)me->query_skill("linji-zhuang",1) < 180)
                return notify_fail("你臨濟十二庄的功力不夠不能使用凌空指穴!\n");

        if((int)me->query_skill("finger") < 180)
                return notify_fail("你的指法修為不夠,目前還不能使用凌空指穴絕技!\n");

        if((int)me->query("neili") < 300)
                return notify_fail("你內力現在不夠, 不能使用凌空指穴! \n");

        if( target->is_busy() > 1 )
                return notify_fail(target->name() + "目前正自顧不暇，放膽攻擊吧  \n");

        msg = 
HIY "$N使出天罡指穴法絕技「凌空指穴」，回過身來，背后竟似生了眼睛一般，左
手食中二指向$n接連戳去，一連七指，全是對向$n的頭臉與前胸重穴。$n不
及攻敵，拼力躲避$N指力頓時動作大亂。\n";
        if( random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2)
        {
                msg +=  HIG "結果$p被$P指力點中几處穴道! \n" NOR;
                  target->start_busy( (int)me->query_skill("tiangang-zhi",1) / 25);
                me->add("neili", -100);
        }
        else
        {
                msg += HIM "$p情急智生，狠力一躍，退出老遠。\n" NOR;
                me->start_busy(4);
        }
        message_combatd(msg, me, target);

        return 1;
}
