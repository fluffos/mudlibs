// jiao.c 巫月刀法「鉸」字訣
// jacki于1997.7.25

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    string msg;
    object my_w,target_w;
    my_w = me->query_temp("weapon");
    target_w = target->query_temp("weapon");

    if( !target ) target = offensive_target(me);

    if( !target
    ||      !target->is_character()
    ||      !me->is_fighting(target) )
   return notify_fail("你只能對戰斗中的對手使用「鉸字訣」。\n");

    if( target->is_busy() )
   return notify_fail(target->name() + "目前正疲于招架，加緊攻擊吧  \n");

    if( (int)me->query_skill("wuyue-blade", 1) < 50 )
   return notify_fail("你的巫月刀法不夠嫻熟，不能使用「鉸」字訣。\n");

    msg = CYN "$N大喝一聲，展開巫月刀法「鉸」字訣，連遞數個急招企圖鉸碎$n的兵刃。\n";
    me->start_busy(2);

    if (target->query_temp("weapon") ||
   target->query_temp("secondary_weapon")) {

    if( random(me->query("combat_exp")) >
   (int)target->query("combat_exp")/2 ) {
    if( target_w->weight() > 2 * random(my_w->weight()) ) {
   msg += "結果$p手中的$w被$P強力一鉸，再也把握不住，立即脫手飛出！\n" NOR;
    target_w->unequip();
    target_w->move(environment(target));
    target->reset_action();
   target->start_busy( (int)me->query_skill("wuyue-blade") / 20 );
}
   msg += "結果$p手中的兵刃被$P的強力一擊鉸了個粉碎！\n" NOR;
    target_w->unequip();
    target_w->move(environment(target));
    target_w->set("name", target_w->query("name") + "的碎片");
    target_w->set("value", 0);
    target_w->set("weapon_prop", 0);
    target->reset_action();
   target->start_busy( (int)me->query_skill("wuyue-blade") / 20 );
    } else {
   msg += "可是$p通過巧妙的招架，并沒有讓$P的計謀得逞。\n" NOR;
    }
    message_combatd(msg, me, target);
    return 1;
    }
    return notify_fail(target->name() + "目前是空手，你想鉸什么？\n");
}

