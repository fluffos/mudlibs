#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count;
 
        if( !me->is_fighting() )
                return notify_fail("「極樂世界」只能在戰斗中使用。\n");
 
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return 0;
                
        if( (int)me->query("neili") < 1000 )
                return notify_fail("你的真氣不夠！\n");

        if( (int)me->query_skill("lulai-zhang",1) < 200 )
                return notify_fail("你的如來火候不夠，無法使用「極樂世界」！\n");

        if( (int)me->query_skill("force") < 300 )
                return notify_fail("你的內功修為不夠，無法使用「極樂世界」！\n");

        msg = HIM "$N"HIC"心如止水，心中只有仙佛，然而心神合一使出了無上氣功"HIR"極樂世界“”！\n" NOR;
        message_vision(msg, me);

        me->clean_up_enemy();
        ob = me->select_opponent();
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        

        me->add("neili", -600);
        me->start_busy(random(4));

        return 1;
}

