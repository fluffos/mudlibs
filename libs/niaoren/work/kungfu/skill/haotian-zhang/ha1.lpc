// ju.c 昊天掌-三花聚頂
// By Lgg,1998.10

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("三花聚頂只能對戰斗中的對手使用。\n");

        if( (int)me->query_skill("haotian-zhang", 1) < 50 )
                return notify_fail("你的昊天掌不夠嫻熟，不會使用三花聚頂。\n");

        if( (int)me->query_skill("xiantian-qigong", 1) < 50 )
                return notify_fail("你的先天功不夠嫻熟，不會使用三花聚頂。\n");

        if( (int)me->query("neili", 1) < 150 )
                return notify_fail("你現在內力太弱，不能使用三花聚頂。\n");

        msg = HIC "$N大喝一聲，合身向$n扑上，雙掌同時擊出，是一招「三花聚頂」。\n"NOR;

//        if( !target->is_killing(me->query("id")) ) target->kill_ob(me);
        if( !target->is_fighting(me) ) target->fight_ob(me);

        if (random(me->query_skill("force")) > target->query_skill("force")/2 )
        {
                me->start_busy(1);

                damage = (int)me->query_skill("haotian-zhang", 1) + (int)me->query_skill("force",1);
                //(昊天掌級別+基本內功)

                damage = damage/2 + random(damage/2) ;

                target->receive_damage("qi", damage);
                target->start_busy(4);
                me->add("neili", -100);

                msg += HIR"結果$n被$N的氣勢所攝，一驚之下，竟然忘了抵擋！\n"NOR;

        }
        else
        {
                me->start_busy(2);
                msg += CYN"可是$p識破了$P這一招，斜斜一躍避開。\n"NOR;
        }
        message_combatd(msg, me, target);

        return 1;
}
