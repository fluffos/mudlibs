		target->receive_damage("jing", 10 );
		target->receive_damage("qi", 10 );
		target->receive_wound("qi", 10);
		}
		if( !target->is_killing(me) ) target->kill_ob(me);
		if( !me->is_killing(target) ) me->fight_ob(target);

	return 1;
}
