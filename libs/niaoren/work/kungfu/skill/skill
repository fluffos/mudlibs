#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
	string msg;
	object weapon, weapon2, target;
	int skill, dp, wound;

	me->clean_up_enemy();
	target = me->select_opponent();

	skill = me->query_skill("tanzhi-shentong",1);

	if( !(me->is_fighting() ))
		return notify_fail("「彈指驚雷」只能在戰斗中使用。\n");

	if ( objectp(weapon = me->query_temp("weapon")))
		return notify_fail("你使用了武器。\n");

	if( skill < 120)
		return notify_fail("你的彈指神通等級不夠, 不能使用「彈指驚雷」！\n");

	if( me->query("neili") < 150 )
		return notify_fail("你的內力不夠，無法運用「彈指驚雷」！\n");
 
	msg = HIC "$N使出彈指神通之「彈指驚雷」, 頓時眼內精光暴射，\n";
	message_combatd(msg, me, target);
 
	dp = target->query("combat_exp");
	if( dp < 1 )
		dp = 1;
	if( random(me->query("combat_exp")) > dp)
	{
		if(userp(me))
			me->add("neili",-150);
		msg = "$n只覺得眼前一花，氣海穴上微微一痛，全身真氣狂泄而出！\n" ;
		if ( objectp(weapon2 = target->query_temp("weapon")))
		{
			msg += "同時手腕一麻，手中";
			msg += weapon2->name();
			msg += "脫手而出！\n" NOR;
			weapon2->move(environment(me));
		}
		wound = 300 + random(200);
		if((int)target->query("neili") < wound)
			wound = target->query("neili");
		target->add("neili", -wound);
		target->receive_wound("jing", wound/5);
		target->start_busy(5);
		me->start_busy(2);
	}
	else
	{
		msg = "可是$n的看破了$N的企圖，立刻采取守勢，使$P的「彈指驚雷」沒有起到作用。\n"NOR;
		me->start_busy(3);
	}
	message_combatd(msg, me, target);

	if(!target->is_fighting(me)) target->fight_ob(me);
//	if(userp(target)) target->fight_ob(me);
//	else if( !target->is_killing(me) ) target->kill_ob(me);

	return 1;
}
