necromancy.c// fuxue.c 拈花指 「拈花拂穴」

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if((int)me->query_str() < 25)
		return notify_fail("你臂力不夠,不能使用這一絕技!\n");

	if((int)me->query_skill("hunyuan-yiqi",1) < 100)
		return notify_fail("你混元一氣功的功力不夠不能使用拈花拂穴!\n");

	if((int)me->query_skill("finger") < 100)
		return notify_fail("你的指法修為不夠,目前還不能使用拈花拂穴絕技!\n");

	if((int)me->query("neili") < 300)
		return notify_fail("你內力現在不夠, 不能使用拈花拂穴! \n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顧不暇，放膽攻擊吧  \n");

	msg = HIY "$N使出拈花指絕技「拈花拂穴」，罩住了$n的全身要穴, 使$n動彈不得。\n";

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4 )
	{
		msg +=  HIG "結果$p被$P攻了個措手不及! \n" NOR;
		target->start_busy( (int)me->query_skill("nianhua-zhi",1) / 20 + 2);
		me->add("neili", -100);
	}
	else
	{
		msg += HIM "可是$p看破了$P的企圖，并沒有上當。\n" NOR;
		me->start_busy(4);
	}
	message_combatd(msg, me, target);

	return 1;
}
