// zhen.c 太極拳「震」字訣

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;

    if( !target ) target = offensive_target(me);

    if( !target || !target->is_character() || !me->is_fighting(target) )
      return notify_fail("神功震敵只能對戰斗中的對手使用。\n");

    if( objectp(me->query_temp("weapon")) )
      return notify_fail("你必須空手才能使用「震」字訣！\n");

    if( (int)me->query_skill("taiji-quan", 1) < 30 )
      return notify_fail("你的太極拳不夠嫻熟，不會使用「震」字訣。\n");

    if( (int)me->query_skill("taiji-shengong", 1) < 30 )
      return notify_fail("你的太極神功不夠高，不能用來反震傷敵。\n");

    if( (int)me->query("neili", 1) < 100 )
      return notify_fail("你現在內力太弱，不能使用「震」字訣。\n");

    msg = CYN "$N默運神功，使出太極拳「震」字訣，企圖以內力震傷$n。\n"NOR;

    if (random(me->query_skill("force")) > target->query_skill("force")/2 )
    {
      me->start_busy(3);
      target->start_busy(random(3));

      damage = (int)me->query_skill("taiji-shengong", 1);
      damage = damage/2 + random(damage);

      target->receive_damage("qi", damage);
      target->receive_wound("qi", damage/3);
      me->add("neili", -damage/10);

      if( damage < 20 ) msg += HIY"結果$n受到$N的內力反震，悶哼一聲。\n"NOR;
      else if( damage < 40 ) msg += HIY"結果$n被$N以內力反震，「嘿」地一聲退了兩步。\n"NOR;
      else if( damage < 80 ) msg += RED"結果$n被$N以內力一震，胸口有如受到一記重錘，連退了五六步！\n"NOR;
      else msg += HIR"結果$N被$n的內力一震，眼前一黑，身子向后飛出丈許！！\n"NOR;

    } else
    {
      me->start_busy(1);
      msg += CYN"可是$p看破了$P的企圖，并沒有上當。\n"NOR;
    }
    message_combatd(msg, me, target);

    if(!target->is_fighting(me)) target->fight_ob(me);
//    if(userp(target)) target->fight_ob(me);
//    else if( !target->is_killing(me) ) target->kill_ob(me);

    return 1;
}

