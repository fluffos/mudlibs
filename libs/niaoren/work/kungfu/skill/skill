#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	int damage;
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「驚天一擊」只能對戰斗中的對手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不對。\n");
		
	if( (int)me->query_skill("duanjia-sword", 1) < 70 )
		return notify_fail("你的段家劍法不夠嫻熟，不會使用。\n");
	                        
	if( (int)me->query_skill("kurong-changong", 1) < 70 )
		return notify_fail("你的枯榮禪功修為不夠高。\n");
			
	if( (int)me->query("neili") < 300 )
		return notify_fail("你現在內力太弱，不能使用「驚天一擊」。\n");
			
	msg = CYN "$N一躍而起，手腕一抖，挽出一個美麗的劍花，飛向$n。\n"NOR;

	if (random(me->query_skill("force")) > target->query_skill("force")/2 )
	{
		target->start_busy( (int)me->query_skill("duanjia-sword") / 20 + 1);
		
		damage = (int)me->query_skill("kurong-changong", 1);
		damage = damage +  (int)me->query_skill("duanjia-sword", 1);
		damage = damage +  (int)me->query_skill("sword", 1);
		
		target->receive_damage("qi", damage);
		target->receive_wound("qi", damage/4);
		me->add("neili", -damage);
		msg += HIR"只見$N人劍合一，穿向$n,\n$n只覺一股熱流穿心而過，喉頭一甜，鮮血狂噴而出！\n"NOR;
		me->start_busy(2);
	} else 
	{
		msg += CYN"可是$p猛地向邊上一躍,跳出了$P的攻擊范圍。\n"NOR;
		me->add("neili", -100);
		me->start_busy(4);
	}
	message_combatd(msg, me, target);

	if(userp(target)) target->fight_ob(me);
//	else if( !target->is_killing(me) ) target->kill_ob(me);
	return 1;
}
