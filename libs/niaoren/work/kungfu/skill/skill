#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
    int skill;

    if( target != me ) return
notify_fail("你只能用落英心法提升自己的戰斗力。\n");

    if( (int)me->query("neili") < 100 ) return
notify_fail("你的內力不夠。\n");
    if( (int)me->query_temp("powerup") ) return
notify_fail("你已經在運功中了。\n");

    skill = me->query_skill("force");

//    me->add("bellicosity", 100 + skill/2 );
    me->add("neili", -45);
    me->receive_damage("qi",0)
      ;

    message_vision( HIC "$N微一凝神，運起落英心法，全身衣裳烈烈做響，眼中精光四射，很是攝人。\n" NOR, me );


    me->add_temp("apply/attack", skill/2);
    me->add_temp("apply/dodge", skill/2);
    me->set_temp("powerup", 1);

    me->start_call_out( (: call_other, __FILE__, "remove_effect", me,
skill/2 :), skill);

    if( me->is_fighting() ) me->start_busy(3);

    return 1;
}

void remove_effect(object me, int amount)
{
    me->add_temp("apply/attack", - amount);
    me->add_temp("apply/dodge", - amount);
    me->delete_temp("powerup");
    tell_object(me, "你的落英心法運行完畢，將內力收回丹田。\n");
}

