// necromancy.c 降伏法
// by Java

inherit SKILL;

int valid_learn(object me)
{
    if( (int)me->query_skill("longxiang",1) <
        (int)me->query_skill("necromancy",1) )
      return notify_fail("你的龍相般若功太低了，無法修煉更高深的降伏法。\n");
    return 1;
}

int practice_skill(object me)
{
    return notify_fail("降伏法只能靠學(learn)來提高。\n");
}

