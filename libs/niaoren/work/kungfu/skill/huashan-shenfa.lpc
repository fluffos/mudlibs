// huashan-shenfa.c 華山身法

inherit SKILL;

mapping *action = ({
([	"action" : "$n一式「巨鵬亮翅」，兩臂鵬舉如翼，在剌剌風聲中，從$N頭頂橫躍而過。\n",
	"dodge"  : 10
]),
([	"action" : "$n一式「風送紫霞」，如一陣清風，舒緩地閃過了$N的凌厲攻勢。\n",
	"dodge"  : 20
]),
([	"action" : "$n一式「燕回朝陽」，輕盈地一躍，一轉眼間便繞到了$N的身后。\n",
	"dodge"  : 30
]),
([	"action" : "$n一式「卻別蒼松」，一轉身間，向后飄出近一丈遠\n",
	"dodge"  : 40
]),
([	"action" : "$n一式「旭日初升」，全身筆直，拔地而起，在半空中一轉，已落到几丈遠的地方。\n",
	"dodge"  : 50
]),
([	"action" : "$n一式「金雁橫空」，身體如一只金雁般行云流水地滑出丈余。\n",
	"dodge"  : 60
]),
([	"action" : "$n一式「晚月朗星」，雙腳點地，全身化為一道白影，急速繞著$N打了几轉。\n",
	"dodge"  : 70
]),
([	"action" : "$n一式「幻眼云湮」，身形陡地變得飄忽不定，令$N無法看清。\n",
	"dodge"  : 80
]),
([	"action" : "$n一式「蒼龍盤嶺」，宛若一條矯矢蒼龍，圍著$N急速地盤旋了几圈。\n",
	"dodge"  : 90
])
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("huashan-shenfa");

	if (level < 80 )
		zhaoshu--;

	if (level < 60 )
		zhaoshu--;

	if (level < 40 )
		zhaoshu--;

	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的體力太差了，不能練華山身法。\n");
	me->receive_damage("qi", 30);
	return 1;
}
