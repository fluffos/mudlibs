// qiufeng-chenfa.c 秋風拂塵

#include <ansi.h>

inherit SKILL;

mapping *action = ({
([	"action":		"$N端坐不動，一招「秋風拂葉」，手中$w帶著一股勁風，擊向$n的臉頰",
	"dodge":		-10,
	"damage":		20,
	"lvl" : 20,
	"skill_name" : "秋風拂葉",
	"damage_type":	"刮傷"
]),
([	"action":		"$N單臂一揮，一招「玉帶圍腰」，手中$w直繞向$n的身后",
	"dodge":		-10,
	"damage":		30,
	"lvl" : 20,
	"skill_name" : "玉帶圍腰",
	"damage_type":	"內傷"
]),
([	"action":		"$N身形一轉，一招「流云斷川」，手中$w如矯龍般騰空一卷，猛地向$n劈頭打下",
	"dodge":		-20,
	"damage":		35,
	"lvl" : 40,
	"skill_name" : "流云斷川",
	"damage_type":	"劈傷"
]),
([	"action":		"$N力貫塵梢，一招「春風化雨」，手中$w舞出滿天幻影，排山倒海般掃向$n全身",
	"dodge":		-40,
	"damage":		50,
	"lvl" : 50,
	"skill_name" : "春風化雨",
	"damage_type":	"刺傷"
]),
([	"action":		"$N忽的向前一躍，一招「野馬分鬃」，手中$w分擊$n左右",
	"dodge":		-50,
	"damage":		60,
	"lvl" : 60,
	"skill_name" : "野馬分鬃",
	"damage_type":	"刺傷"
]),
([	"action":		"$N慢步上前，一招「竹影掃階」，手中$w緩緩罩向$n前胸",
	"dodge":		-60,
	"damage":		70,
	"lvl" : 70,
	"skill_name" : "竹影掃階",
	"damage_type":	"內傷"
])
});

int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }

int valid_learn(object me)
{
	object weapon;

	if( (int)me->query("max_neili") < 300 )
		return notify_fail("你的內力不足，沒有辦法練秋風塵法, 多練些內力再來吧。\n");

	if ((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本氣功火候太淺。\n");

	if ( !objectp(weapon = me->query_temp("weapon"))
	|| ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必須先找一條拂塵才能練塵法。\n");

	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("qiufeng-chenfa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的體力不夠練秋風塵法。\n");
	me->receive_damage("qi", 5);
	return 1;
}

string perform_action_file(string action)
{
	if ( this_player()->query_skill("qiufeng-chenfa", 1) >= 40 )
		return __DIR__"qiufeng-chenfa/" + action;
}

