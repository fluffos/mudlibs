//By Yzuo 97.03

#include <ansi.h>

inherit F_SSERVER;
int exert(object me, object target)
{
	object ob, tar;
	int sp, dp, i, j;

	if ( target == me ) target = offensive_target(me);

	if( environment(me)->query("no_fight") )
		return notify_fail("在這里不能攻擊他人。\n");

	if( !objectp(target) || target->query("id") == "mu ren" )
		return notify_fail("你要吸取誰的內力？\n");

	if ( me->query_temp("sucked") )
		return notify_fail("你剛剛吸取過內力！\n");

	if( !objectp(ob=me->query_temp("weapon")) )
		return notify_fail("你沒有用兵器！\n");

	if( !objectp(tar=target->query_temp("weapon")) )
		return notify_fail("你的對手沒有用兵器！\n");

        if( !me->is_fighting() || !target->is_fighting())

	if( (int)me->query_skill("huagong-dafa",1) < 60 )
		return notify_fail("你的化功\大法功\力不夠，不能吸取對方的內力！  n");

	if( (int)me->query("neili",1) < 20 )
		return notify_fail("你的內力不夠，不能使用化功\大法。\n");

	if( (int)target->query("max_neili") <= 0 )
		return notify_fail( target->name() +
			"沒有任何內力！\n");

        if( (int)target->query("neili") < 60 )
		return notify_fail( target->name() +
			"已經內力渙散，你已經無法從他體內吸取任何內力了！\n");

	  message_vision(
		HIR "$N突然將"+ob->query("name")+"朝$n的"+tar->query("name")+"壓上去！\n\n" NOR,
		me, target );

	if( !target->is_killing(me) ) target->kill_ob(me);

        sp = me->query_skill("force") + me->query_skill("dodge") + me->query_skill("zhaixinggong",1)/2;
        dp = target->query_skill("force") + target->query_skill("dodge");

	me->set_temp("sucked", 1);		

        if (( random(sp) > random(dp) ) || !living(target) )
	{
		tell_object(target, HIR "你全身內力如水銀般循孔從手掌飛泄而出！\n" NOR);
		tell_object(me, HIG "你覺得" + target->name() + "的內力自手掌源源不絕地流了進來。\n" NOR);

		target->add("neili", -1*((int)me->query_skill("huagong-dafa", 1) + target->query("jiali")) );
            if ( target->query("neili") <1 ) target->set("neili",0);
		me->add("neili", (int)me->query_skill("huagong-dafa", 1) + target->query("jiali") );

		if( target->query("combat_exp") >= me->query("combat_exp") ) {		
			if( (int)me->query("potential") - (int)me->query("learned_points") < 100 )
				me->add("potential", 1);
			me->add("combat_exp", 1);
		}

                me->start_busy(3);
		target->start_busy(random(3));
                me->add("neili", -7);

		call_out("del_sucked", 2, me);
	}
	else
	{	
		message_vision(HIY "可是$p看破了$P的企圖，機靈地閃了開去。\n" NOR, me, target);
		me->start_busy(3);
		call_out("del_sucked", 4, me);
	}

	return 1;
}

void del_sucked(object me)
{
	if ( me->query_temp("sucked"))
	me->delete_temp("sucked");
}

