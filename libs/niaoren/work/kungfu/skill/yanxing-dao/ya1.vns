// huanying.c  雁行刀法「無形幻影」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;

    if (!target ) target = offensive_target(me);
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
   return notify_fail(RED"開什么\玩笑，沒裝備刀怎么\使「無形幻影」？\n"NOR);
    if (!target || !target->is_character() || !me->is_fighting(target) )
   return notify_fail("「無形幻影」只能對戰斗中的對手使用。\n");
    if ((int)me->query_skill("yanxing-dao", 1) < 90 )
   return notify_fail(WHT"你的雁行刀法不夠嫻熟，還使不出「無形幻影」。\n"NOR);
    if ((int)me->query_skill("linji-zhuang", 1) < 70 )
   return notify_fail(RED"你的臨濟十二庄火候不夠，「無形幻影」不成招式。\n"NOR);
    if ((int)me->query("max_neili")<300)
   return notify_fail(RED"你的內力修為不足，無法運足「無形幻影」的內力。\n"NOR);
    if ((int)me->query("neili")<60)
    {
      me->set("neili",10);
      return notify_fail(HIC"你現在內力不夠，沒能將「無形幻影」使完！\n"NOR);
    }
    msg = HIC "$N大喝一聲，全場四處游動，$n只看到$N化做數團身影，漫天刀光席卷而來，$n奮力一架，但$N刀分數路，$n只架住一刀！\n"NOR;
    if (random(me->query_skill("force")) > target->query_skill("force")/2||
  random(me->query("combat_exp")) > (int)target->query("combat_exp")/3
)
    {
   me->start_busy(1);
   target->start_busy(random(3));
   damage = (int)me->query_skill("yanxing-dao", 1);
   damage = damage + random(damage);
   target->receive_damage("qi", damage/2);
   target->receive_wound("qi", damage);
   target->receive_damage("jing", damage/3);
   target->receive_wound("jing", damage/4);
   msg += HIC"$n根本沒法躲避，頓時几刀都砍在$n肩頭！鮮血濺起，$n自覺眼前一片鮮紅，遮住視線！\n"NOR;
   me->add("neili", -damage/5);
    } else
    {
   me->start_busy(2);
   msg += HIY"可是$p早以看出那是虛招，毫不在意地坦然面對，果真只有架住的是實招。\n"NOR;
    }
    message_combatd(msg, me, target);
    return 1;
}

