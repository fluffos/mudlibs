// fugu.c 金蛇游身掌-附骨纏身

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("附骨纏身只能對戰斗中的對手使用。\n");

        if( me->query_temp("weapon"))
                return notify_fail("你不是空手，不能使用附骨纏身。\n");

        if( (int)me->query_skill("jinshe-zhang", 1) < 100 )
                return notify_fail("你的金蛇掌不夠嫻熟，不會使用附骨纏身。\n");

        if( (int)me->query("neili", 1) < 300 )
                return notify_fail("你現在內力太弱，不能使用附骨纏身。\n");

        msg = HIC "$N大喝一聲，纏身而上左手一探刁住$n手腕，右掌猛下殺手！\n"NOR;
        message_combatd(msg, me, target);

        if( !target->is_fighting(me) ) target->fight_ob(me);

        if (random(me->query_skill("strike")) > target->query_skill("dodge")/2 )
        {
                me->clean_up_enemy();
                target = me->select_opponent();

                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

                me->add("neili", -50);
                me->start_busy(random(2));
                msg = HIR"結果$n被$N的左手所制，在「附骨纏身」下，竟然無法還手！\n"NOR;
        }
        else
        {
                me->start_busy(3);
                msg = CYN"可是$p識破了$P這一招，手肘一送，擺脫了對方控制。\n"NOR;
        }
        message_combatd(msg, me, target);

        return 1;
}
