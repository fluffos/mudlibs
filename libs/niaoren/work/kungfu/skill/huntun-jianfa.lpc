#include <ansi.h>
inherit SKILL;
mapping *action = ({
([
     "skill_name" : "盤古一吼開天地",
     "action":     "$N使一式"+YEL"『盤古一吼開天地』"NOR+"，騰身飛躍，手中$w于半空中閃下，化作一道白色長弧洒向$n的$l",
     "dodge":   30,
     "force" : 500,
     "lvl" : 1,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "隻手逆指風四起",
     "action":     "$N使一式"+GRN"『隻手逆指風四起』"NOR+"，矮身側步，手中$w反手疾挑而出，唰”的一聲往$n的$l刺去",
     "dodge":   65,
     "force" : 540,
     "lvl" : 100,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "昂首怒吼云翻湧",
     "action":     "$N使一式"+WHT"『昂首怒吼云翻湧』"NOR+"，驀地疾退一步，又沖前三步，手中$w化為光弧往$n的$l刺去",
     "dodge":   40,
     "force" : 590,
     "lvl" : 110,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "五指幻化群山嶽",
     "action":     "$N使一式"+HIB"『五指幻化群山嶽』"NOR+"，縱身躍起，不見蹤影，接著卻又從半空中穿下，雙手握著$w，幻化成五道身影聲勢逼人地刺向$n的$l",
     "dodge":   60,
     "force" : 640,
     "lvl" : 120,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "血脈賁裂成海河",
     "action":     "$N使一式"+HIR"『血脈賁裂成海河』"NOR+"，手中$w“嗤”的一聲斜刺向天空，隨即向下形成萬千道劍芒，往$n的$l刺去",
     "dodge":   45,
    "force" : 700,
     "lvl" : 130,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "斜臥揚首吐雲日",
     "action":     "$N使一式"+HIW"『斜臥揚首吐雲日』"NOR+"，左腿微抬，手中$w自下方挑起，激起一股勁風反挑$n的$l",
     "dodge":   50,
     "force" : 760,
     "lvl" : 140,
     "damage_type":  "刺傷"
]),
([
     "skill_name" : "吞雷吐電天地變",
     "action":     "$N傾盡全力舞出"+HIY"『吞雷吐電天地變』"NOR+"，神色十分激動，眼中血絲浮現，手中$w疾舞不停，全身都已籠罩在迫人的劍氣中，$n不由駭然，只見$N身形微變，無數道劍氣已逼向$n的$l",
     "dodge":   70,
     "force" : 850,
     "lvl" : 150,
     "damage_type":  "刺傷"
]),
});
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
    return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    int i, level;
    level   = (int) me->query_skill("huntun-jianfa",1);
    for(i = sizeof(action); i > 0; i--)
   if(level > action[i-1]["lvl"])
    return action[NewRandom(i, 20, level/5)];
}
int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
	return notify_fail("你使用的武器不對。\n");
    if ((int)me->query_skill("lingboweibu", 1) < 50)
    return notify_fail("你的凌波微步\火候太淺。\n");
    if ((int)me->query_skill("taiji-quan", 1) < 20)
    return notify_fail("你的太極拳火候太淺。\n");
    if( (int)me->query("qi") < 35)
    return notify_fail("你的體力目前沒有辦法練習混沌劍法。\n");
    me->receive_damage("qi", 30);
    write("你傾情舞了一遍混沌劍法。\n");
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"huntun-jianfa/" + action;
}
