        "dodge" : 5,
        "parry" : 20,
        "lvl" : 0,
        "damage" : 30,
        "damage_type" : "劈傷",
]),
([      "action" : "$N身形急轉，一招「回風轉云」，舞起一片刀花，$w飛劈$n",
        "skill_name" : "回風轉云",
        "force" : 160,
        "dodge" : 0,
        "parry" : 8,
        "lvl" : 15,
        "damage" : 40,
        "damage_type" : "劈傷",
]),
([      "action" : "$N氣貫刀鋒，$w揚起一陣風聲，一招「大風起兮」，劈向$n的頭頂",
        "skill_name" : "大風起兮",
        "force" : 220,
        "dodge" : 10,
        "parry" : 15,
        "lvl" : 30,
        "damage" : 50,
        "damage_type" : "割傷",
]),
([      "action" : "$N刀鋒急轉，變幻莫測，一招「北燕南歸」，$w反劈向$n的后心",
        "skill_name" : "北燕南飛",
        "force" : 240,
        "dodge" : 10,
        "parry" : 20,
        "lvl" : 50,
        "damage" : 50,
        "damage_type" : "劈傷",
]),
([      "action" : "$N面帶微笑，刀尖化出無數白點，一招「人面桃花」，攻擊向$n全身",
        "skill_name" : "人面桃花",
        "force" : 270,
        "dodge" : 20,
        "parry" : 15,
        "lvl" : 80,
        "damage" : 60,
        "damage_type" : "割傷",
]),
([      "action" : "$N使出一招「似是而非」，刀不象刀，劍不象劍，攻擊向$n周身要害",
        "skill_name" : "似是而非",
        "force" : 300,
        "dodge" : 35,
        "parry" : 50,
        "lvl" : 100,
        "damage" : 60,
        "damage_type" : "割傷",
]),
([      "action" : "$N使一式「輕于鴻毛」，$w如同虛無飄渺一般，不斷的直向$n攻去   ",
        "skill_name" : "輕于鴻毛",
        "force" : 300,
        "dodge" : 40,
        "parry" : 70,
        "lvl" : 130,
        "damage" : 80,
        "damage_type" : "割傷",
]),
([      "action" : "$N勁運于$w,一招「天外來峰」，$w如有千斤一般，直直向$n劈去   ",
        "skill_name" : "天外來峰",
        "force" : 500,
        "dodge" : 40,
        "parry" : 70,
        "lvl" : 150,
        "damage" : 100,
        "damage_type" : "割傷",
]),


});


int valid_enable(string usage) { return usage == "blade" ; }


int valid_learn(object me)
{
	if ((int)me->query_skill("blade", 1) >= 30)
		return 1;
	else if ((int)me->query_skill("blade", 1) < 30)
		return notify_fail("你的基本刀法太差了，練不了逍遙刀法。\n");
	}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("xiaoyao-dao",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不對。\n");
	if ((int)me->query("qi") < 20)
		return notify_fail("你的體力不夠，練不了逍遙刀法。\n");
	me->receive_damage("qi", 30);
	return 1;
}

