// feilong.c  華山劍法「天外飛龍」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;

    if (!target ) target = offensive_target(me);
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
        return notify_fail(RED"裝備劍才能使用「天外飛龍」？\n"NOR);
    if (!target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「天外飛龍」只能對戰斗中的對手使用。\n");
    if ((int)me->query_skill("huashan-sword", 1) < 150 )
        return notify_fail(WHT"你華山劍法不夠嫻熟，使不出「天外飛龍」。\n"NOR);
//  if ((int)me->query_skill("huashan-neigong", 1) < 100 )
//      return notify_fail(RED"你華山內功火候不夠，使不出「天外飛龍」。\n"NOR);
    if ((int)me->query_skill("zixia-shengong", 1) < 100 )
        return notify_fail(RED"你紫霞神功火候不夠，使不出「天外飛龍」。\n"NOR);
    if ((int)me->query("max_neili") < 600)
        return notify_fail(RED"你內力修為不足，無法運足內力。\n"NOR);
    if ((int)me->query("neili") < 400)
    {
        return notify_fail(HIC"你現在內力不夠，沒能將「天外飛龍」使完！\n"NOR);
    }
    msg = HIC "$N心念電閃，一提內力，勒手仗劍，運勁于臂，呼的一聲向$n擲了出去，\n"NOR;
    if ( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
    {
        me->start_busy(2);
        target->start_busy(random(3));
        damage = target->query("qi");
        target->receive_damage("qi", damage-10);
        target->receive_wound("qi", damage/2);
msg += HIC"$n疾忙躍起，但劍如電閃，只覺一陣劇痛，劍刃攔腰而過，鮮血飛濺，皮肉卷起！\n"NOR;
        me->set("neili", 100);
    } else
    {
        me->start_busy(2);
msg += HIY"可是$n輕輕一笑，側身伸指，正彈在$N的劍脊上，劍斜飛落地。\n"NOR;
        me->add("neili", -200);
    }
    weapon->move(environment(me));
    message_combatd(msg, me, target);
    if(!target->is_fighting(me)) target->fight_ob(me);
    return 1;
}
