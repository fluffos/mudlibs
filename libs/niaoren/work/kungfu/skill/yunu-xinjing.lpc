// yunu-xinjing.c 玉女心經
// Kayin @ CuteRabbit /1999/3/13

inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }
int valid_learn(object me)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "古墓派"))
		return notify_fail("你不是古墓派的弟子,不能學習玉女心經?\n");

	if ( me->query("class") == "taoist" )
		return notify_fail("玉女心經是古墓派的決學,"
			+RANK_D->query_respect(me)+"已是李莫愁的弟子,就不可再學此功了。\n");

	if ((int)me->query_skill("yunu-xinfa", 1) < 10)
		return notify_fail("你的玉女心法火候還不夠,不能修練玉女心經。\n");

	if ( me->query_skill("bibo-shengong",1)
	|| me->query_skill("beiming-shengong",1)
	|| me->query_skill("biyun-xinfa",1)
	|| me->query_skill("xuedao-xinfa",1)
	|| me->query_skill("shenzhao-shengong",1)
	|| me->query_skill("tianlong-shengong",1)
	|| me->query_skill("bahuang-gong",1)
	|| me->query_skill("hamagong",1)
	|| me->query_skill("huagong-dafa",1)
	|| me->query_skill("huntian-qigong",1)
  	|| me->query_skill("jiuyang-shengong",1)
  	|| me->query_skill("xiantian-gong",1)
  	|| me->query_skill("wudu-xinfa",1)
  	|| me->query_skill("hunyuan-yiqi",1)
	|| me->query_skill("longxiang",1)
	|| me->query_skill("xiaowuxiang",1)
	|| me->query_skill("yunlong-shengong",1)
	|| me->query_skill("zixia-shengong",1)
	|| me->query_skill("taiji-shengong",1) )
		return notify_fail("你不先散了別派內功，怎能學玉女心經？！\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("玉女心經只能用學(learn)的來增加熟練度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yunu-xinjing/" + func;
}

