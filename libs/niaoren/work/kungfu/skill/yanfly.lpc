// yanfly.c 燕雙飛

inherit SKILL;

string *dodge_msg = ({
    "$n一個「比翼雙飛」，隨著$N的攻勢飄起，從容躲過這一招。\n",
    "$n使出一招「巧燕穿云」，猛然縱起丈余，結果$N扑了個空。\n",
    "$n身形一搖，幻出几個人影，一招「望穿秋水」躲過了$N的攻勢。\n",
    "$n一招「飛鳥投林」縱身躍起，倏忽已落至$N身后。\n",
    "$n左一搖，右一晃，一招「紫燕呢喃」已輕松閃過。\n",
});

int valid_enable(string usage)
{
    return (usage == "dodge") ;
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 30 )
                return notify_fail("你的體力太差了，不能練燕雙飛。\n");
        if (me->query_skill("yan-fly", 1) < 30)
                me->receive_damage("qi", 10);

        me->receive_damage("qi", 20);
        return 1;
}

