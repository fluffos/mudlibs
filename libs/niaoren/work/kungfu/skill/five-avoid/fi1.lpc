// break.c 五遁絕殺
// Modified by Venus Oct.1997
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
string msg;
int count;
if( !me->is_fighting() )
      return notify_fail("「五遁絕殺」只能在戰斗中使用。\n");
if( (int)me->query("qi") < 70 )
      return notify_fail("你的氣不夠！\n");
if( (int)me->query("max_neili") < 100 )
      return notify_fail("你的內力不夠！\n");
if( (int)me->query("neili") < (int)me->query("max_neili")/2)
      return notify_fail("你的真氣不夠！\n");
msg = HIC "$N使出五行遁中的「五遁絕殺」，身法陡然間變得變幻莫測！\n" NOR;
message_combatd(msg, me);
count = (int)me->query_skill("five-avoid") / 20 + 2;
   if( count > 5 ) count = 5;
   while( count-- )
 {
  object ob;
  me->clean_up_enemy();
  ob = me->select_opponent();
  if( !ob || (environment(ob) != environment(me))) {
  message_combatd(WHT "$N的身形倏地一轉，收身停住了腳步。\n" NOR, me);
     break;
   }
  else

  message_combatd(WHT "$N的身影在$n身旁時隱時現 ...\n" NOR, me, ob);
  if( !COMBAT_D->fight(me, ob) )
      message_combatd(WHT "但是$N始終沒有找到機會出手！\n" NOR, me);
  me->receive_damage("qi", 10);
  me->add("neili", -10);
 }
    me->start_busy(1);
    return 1;
}

