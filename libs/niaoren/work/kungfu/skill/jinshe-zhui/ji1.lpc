// tuwu.c

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	int skill;
	string msg;
	object weapon;

	if( !target ) target = offensive_target(me);
	if (me->query_temp("jinshe/tuwu"))
		return notify_fail("你才用的金蛇吐霧，沒法接著就出招。\n");

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("金蛇吐霧只能在戰斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
            || (string)weapon->query("id") != "jinshe zhui")
           return notify_fail("你沒用金蛇錐，不能使用絕招！\n");

	if( (int)me->query_skill("jinshe-zhui", 1) < 100 )
		return notify_fail("你的金蛇錐法不夠嫻熟，不會使用金蛇吐霧。\n");

	if( (int)me->query("neili") < 300 )
		return notify_fail("你內力不夠了。\n");

	skill = me->query_skill("jinshe-zhui", 1);

	me->add("neili", -200);
	target->receive_damage("qi", (int)skill/ 3);

	message_combatd(
        HIY "只聽一陣狂風掃葉般的聲響中，$N手中的"YEL"金蛇錐"HIY"閃出奪目的光芒，閃耀得
$n眼冒金花，“金蛇吐霧”！除了眼前一重重的霧氣外，$n啥也看不見了！\n" NOR, me, target);
	me->set_temp("jinshe/tuwu", 1);
	target->set_temp("block_msg/all",1);
	call_out("tuwu_end", (int) skill/30, me, target);

	return 1;
}
void tuwu_end(object me, object target)
{
	target->enable_player();
	message_combatd("$N抹了抹滿臉的"HIR"鮮血"NOR"，終于睜開了眼。\n", target);
	target->set_temp("block_msg/all", 0);
	write(HIR"你終于抹掉了滿臉的鮮血，看到了周圍的情景。\n"NOR);
	me->delete_temp("jinshe/tuwu");

	return;
}
