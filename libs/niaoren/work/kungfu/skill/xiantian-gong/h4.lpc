// jing.c

#include <ansi.h>

int exert(object me, object target)
{
	if( me->is_fighting() )
		return notify_fail("戰斗中療精？找死嗎？\n");

	if ((int)me->query_skill("xiantian-gong", 1) < 50)
		return notify_fail("你的先天神功修為還不夠。\n");
	if( (int)me->query("neili") < 50 ) 
		return notify_fail("你的真氣不夠。\n");

	if( (int)me->query_skill("xiantian-gong",1) < 30 )
		return notify_fail("你的先天神功修為不夠。\n");

	if( (int)me->query("eff_jing") < (int)me->query("max_jing") / 2 )
		return notify_fail("你的精損傷太多，只怕一運真氣便有生命危險！\n");

	write( HIW "你全身放松，坐下來開始打座療精。\n" NOR);
	message("vision",
		HIW + me->name() + "頭上冒出屢屢熱氣，精神看起來好多了。\n" NOR,
		environment(me), me);

	me->receive_curing("jing", 10 + (int)me->query_skill("taoism")/10 );
	me->add("neili", -50);
	me->set("jiali", 0);
      me->start_busy(4);

	return 1;
}
