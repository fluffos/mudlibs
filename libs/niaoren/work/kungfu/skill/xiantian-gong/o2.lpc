// bidu.c

#include <ansi.h>

int exert(object me, object target)
{
        if( !target )
                return notify_fail("你要為誰逼毒?！\n");
        if(target == me)
                return notify_fail("你要為誰逼毒?！\n");

        if( me->is_fighting() || target->is_fighting())
                return notify_fail("戰斗中無法運功逼毒！\n");

        if( (int)me->query("max_neili") < 500 )
                return notify_fail("你的內力修為不夠。\n");

        if ((int)me->query_skill("xiantian-gong", 1) < 50)
                return notify_fail("你的先天神功修為還不夠。\n");
        if( (int)me->query("neili") < (int)me->query("max_neili")/10 ) 
                return notify_fail("你的真氣不夠。\n");
        
        message_vision(
                HIY"$N"HIC"坐了下來運起內功，將手掌貼在"HIY"$n"HIC"的背心，緩緩地將真氣輸入"HIY"$n"HIC"的體內....\n" NOR,
                me,target);

   if ((int)target->query_condition("zm_poison") > 0 )
    {
    if ((int)target->query_condition("zm_poison") < (int)me->query_skill("xiantian-gong",1)/20 + 1 )
    {
      target->apply_condition("zm_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"子母飛針之毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
    }
   else {
   target->apply_condition("zm_poison", (int)target->query_condition("zm_poison") -(int)me->query_skill("xiantian-gong",1)/20 );
      message_vision(HIY"$n"HIY"身上的"HIR"子母飛針之毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);
     return 1;

   }
   if ((int)target->query_condition("ice_poison") > 0 )
     {
    if ((int)target->query_condition("ice_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    {
      target->apply_condition("ice_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"寒冰綿掌"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
    }
   else {
   target->apply_condition("ice_poison", (int)target->query_condition("ice_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"寒冰綿掌"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);
     return 1;

   }
    if ((int)target->query_condition("jy_poison") > 0 )
     {
    if ((int)target->query_condition("jy_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("jy_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"九陰白骨爪毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("jy_poison", (int)target->query_condition("jy_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"九陰白骨爪毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);
     return 1;
     }
     
        if ((int)target->query_condition("xx_poison") > 0 )
     {
    if ((int)target->query_condition("xx_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("xx_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"星宿掌毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("xx_poison", (int)target->query_condition("xx_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"星宿掌毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);
     return 1;
     }
   
        if ((int)target->query_condition("ss_poison") > 0 )
     {
    if ((int)target->query_condition("ss_poison") < (int)me->query_skill("xiantian-gong",1)/8+1 )
    
    {
      target->apply_condition("ss_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"生死符"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("ss_poison", (int)target->query_condition("ss_poison") -(int)me->query_skill("xiantian-gong",1)/8);
      message_vision(HIY"$n"NOR"身上的"HIR"生死符"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);      
     return 1;
     }
      
    if ((int)target->query_condition("rose_poison") > 0 )
     {
    if ((int)target->query_condition("rose_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("rose_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"火玫瑰毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("rose_poison", (int)target->query_condition("rose_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"火玫瑰毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);      
     return 1;
     }
 
    if ((int)target->query_condition("zhua_poison") > 0 )
     {
    if ((int)target->query_condition("zhua_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("zhua_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"凝血神爪"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("zhua_poison", (int)target->query_condition("zhua_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"凝血神爪"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);      
     return 1;
     }
     if ((int)target->query_condition("snake_poison") > 0 )
     {
    if ((int)target->query_condition("snake_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("snake_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"蛇毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("snake_poison", (int)target->query_condition("snake_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"蛇毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);      
     return 1;
     }
        if ((int)target->query_condition("wudu_poison") > 0 )
     {
    if ((int)target->query_condition("wudu_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("wudu_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"五毒氣"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("wudu_poison", (int)target->query_condition("wudu_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"五毒氣"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);    
     return 1;
        }
if ((int)target->query_condition("yufeng_poison") > 0 )
     {
    if ((int)target->query_condition("yufeng_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("yufeng_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"玉蜂針毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("yufeng_poison", (int)target->query_condition("yufeng_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"玉蜂針毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);   
      target->start_busy(4);
     return 1;
     }
        if ((int)target->query_condition("bingpo_poison") > 0 )
     {
    if ((int)target->query_condition("bingpo_poison") < (int)me->query_skill("xiantian-gong",1)/20+1 )
    
    {
      target->apply_condition("bingpo_poison", 0);
      message_vision(HIY"$n"HIY"身上的"HIR"冰魄銀針毒"HIC"盡退"HIY"，臉色看上去好多了。\n"NOR, me,target); 
   }
   else {
   target->apply_condition("bingpo_poison", (int)target->query_condition("bingpo_poison") -(int)me->query_skill("xiantian-gong",1)/20);
      message_vision(HIY"$n"HIY"身上的"HIR"冰魄銀針毒"HIC"清去小半"HIY"臉色漸漸紅潤起來。\n"NOR, me,target);
        }
        
             me->add("neili", -(int)me->query("max_neili")/10);
        me->set("jiali", 0);
      me->start_busy(4);
      target->start_busy(4);   
     return 1;
     }

    else tell_object(me, "他現在沒有中毒。\n" NOR );
     return 1;
}  

