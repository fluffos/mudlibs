int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_combine(string combo) { return combo=="lulai-zhang"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 2500)
                return notify_fail("你的內力太弱，無法練如來神掌。\n");
        if ((int)me->query_str()< 45)
                return notify_fail("你的臂力太弱，無法練如來神掌。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("lulai-zhang",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 80, level)];
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 30)
                return notify_fail("你的體力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的內力不夠練如來神掌。\n");
        me->receive_damage("qi", 25);
        me->add("neili", -30);
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 250 ) return 0;

        if( damage_bonus/2 > victim->query_str() ) {
                victim->receive_wound("qi", (damage_bonus - 300) / 2 );
                return HIR "只聽到“哇”的一聲，"+ victim->name()+"噴出了一大口鮮血！\n" NOR;
        }
}
string perform_action_file(string action)
{
        return __DIR__"lulai-zhang/" + action;
}
