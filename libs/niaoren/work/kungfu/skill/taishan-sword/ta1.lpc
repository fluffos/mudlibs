// 破雲斬
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    if( !target ) target = offensive_target(me);
    if( !target||!target->is_character()||!me->is_fighting(target) )
    return notify_fail("你只能對戰斗中的對手使用「破雲斬」。\n");
    if( (int)me->query_skill("taishan-sword",1) < 100)
    return notify_fail("你目前功力還使不出「破雲斬」。\n");
    if( (int)me->query_skill("ding-force",1) < 100)
    return notify_fail("你目前定天氣功功力還使不出「破雲斬」。\n");
    if( (int)me->query("neili") < 200 )
    return notify_fail("你的內力不夠。\n");
    me->add("neili", -60);
    msg = HIC"$N突然暴喝一聲，將手中$w斜向上舉起，然后在半空中划出一
道圓弧，隨即徑直斜下斬向$n！這一瞬間，$n只覺得呼吸都停止了！\n"NOR;
    me->start_busy(1);

    if( random(me->query("combat_exp")) >
      (int)target->query("combat_exp")/4 ) {
    target->start_busy( (int)me->query_skill("taishan-sword") / 20 );
    damage = (int)me->query_skill("taishan-sword", 1)+(int)me->query_skill("sword", 1)/2;
    damage = damage/2 + random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage/2);
   msg += RED
    "只見$n被$N一劍砍中，胸前裂開一道深深的傷口，血如箭般噴射而出！\n"NOR;
    } else {
    msg += HIC "可是$p急忙抽身躲開，$P這招沒有得逞。\n" NOR;
    }
    message_combatd(msg, me, target);
    return 1;
}

