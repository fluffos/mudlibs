// poqi.c 天劍神訣之天地不容(破氣式)
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, ap, dp, neili_wound, qi_wound;

        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("god-sword",1);

        if( !(me->is_fighting() ))
                return notify_fail("「天地不容」只能對戰鬥中的對手使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不對。\n");

        if( skill < 90)
                return notify_fail("你的天劍神訣等級不夠, 不能使用「天地不容」！\n");

        if( me->query("neili") < 150 )
                return notify_fail("你的內力不夠，無法運用「天地不容」！\n");
 
        msg = HIW "$N潛運天劍神訣之"+HIW"【"NOR+""+BLINK""+HIY"天地不容"NOR+""+HIW"】"NOR+"，運氣貫劍使其由利返鈍，毫無花俏地直刺$n的丹田。\n";
        message_vision(msg, me, target);
 
        ap = me->query_skill("sword") + skill;
        dp = target->query_skill("force") / 2;
        if( dp < 1 )
                dp = 1;
        if( random(ap) > dp )
        {
                if(userp(me))
                        me->add("neili",-450);
                msg = "$N運起「天地不容」, $n頓時覺得眼前一花，氣海穴上微微一痛，\n";
                msg += "全身真氣狂泄不止！\n" NOR;

                neili_wound = 300 + random(skill);
                if(neili_wound > target->query("neili"))
                        neili_wound = target->query("neili");

                qi_wound = neili_wound / 5;
                if(qi_wound > target->query("qi"))
                        qi_wound = target->query("qi");

                target->add("neili", -neili_wound);
                target->add("qi", -qi_wound);
                target->add("eff_qi", -qi_wound);
                target->start_busy(2);
                me->start_busy(random(3));
        }
        else
        {
                if(userp(me))
                        me->add("neili",-100);
                msg = "可是$n看破了$N天地不容的招式，立刻守緊門戶，几經艱難終于還招擋開。\n"NOR;
                me->start_busy(4);
        }
        message_vision(msg, me, target);

        return 1;
}
