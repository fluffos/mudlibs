int valid_enable(string usage) { return usage=="hand"; }

//int valid_combine(string combo) { return combo=="fengyun-shou"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("練鷹手必須空手。\n");
	if ((int)me->query_skill("hand",1) < 20)
		return notify_fail("你的基本手法太差勁了，無法學鷹爪手。\n");
        if ((int)me->query_skill("shenghuo-shengong", 1) < 30)
                return notify_fail("你的聖火令神功還不到家，無法學鷹爪手。\n");
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的內力太弱，無法練鷹爪手。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
      int i, level;
	level   = (int) me->query_skill("yingzhua-shou",1);
      for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 30)
		return notify_fail("你的體力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的內力不夠練鷹爪手。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

