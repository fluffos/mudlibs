int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("score") < 1000)
                return notify_fail("這套劍法只傳給有名望的俠客。\n");
        if ((int)me->query("max_neili") < 2000)
                return notify_fail("你的內力不夠。\n");
        if ((int)me->query_skill("taiji-shengong", 1) < 300)
                return notify_fail("你的太極神功火候太淺。\n");
        if ((int)me->query_skill("taiji-quan", 1) < 300)
                return notify_fail("你對太極拳瞭解太淺。\n");
        if ((int)me->query_skill("sword", 1) < 300)
                return notify_fail("你的劍法火候太淺。\n");
        if ((int)me->query("score") < ((int)me->query_skill("jawutaiji-jian",1) * 20) )
		return notify_fail("你的名望不夠了，再高點再學吧。\n");
        return 1;
}
string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
    if(level >= action[i]["lvl"])
    return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
        object ob;
        int i, level;
        me->clean_up_enemy();
        ob = me->select_opponent();
        level   = (int) me->query_skill("jawutaiji-jian",1);
        if(random(5) <1)
        {
        message_vision("\n$N使出"HIC"真武太極劍法"NOR"中的奧義，"HIY"借力打力"NOR"將$n的攻擊反推回去！\n", me,ob);
        COMBAT_D->do_attack(ob, ob, ob->query_temp("weapon") , );
        }
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不對。\n");
        if ((int)me->query("qi") < 100)
                return notify_fail("你的體力不夠練真武太極劍法。\n");
        me->receive_damage("qi", 100);
        write("你將太極心法的奧義反覆思考一遍，不由自主的舞起"HIC"真武太極劍法"NOR"，也因此獲益良多。\n");
        return 1;
}
string perform_action_file(string action)
{
    return __DIR__"jawutaiji-jian/" + action;
}
