#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("翔少爺", ({"xiang"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "這是一粒助長內力的靈藥，吃了之后有要飛翔的欲望，像個少爺似的。\n");
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");

        if ( me->query("neili") >= me->query("max_neili")*2 )
        return notify_fail("你現在沒必要吃翔少爺。\n");

        me->add("neili", 1);
        message_vision(HIY "$N吃下一粒翔少爺，只覺得身輕如燕要飛翔！\n" NOR, me);

        destruct(this_object());
        return 1;
}

