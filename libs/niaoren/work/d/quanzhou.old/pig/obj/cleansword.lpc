#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("清平劍", ({ "cleansword", "sword", "jian" }));
        set_weight(5);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄清澈的精鋼劍，很平。\n");
                set("material", "steel");
                set("wield_msg", "$N「唰」的一聲抽出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n插回劍鞘。\n");
        }
        init_sword(10);
        setup();
}

