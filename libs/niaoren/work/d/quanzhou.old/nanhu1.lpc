// Room: /d/quanzhou/nanhu1.c
// Date: May 21, 96   Jay

inherit ROOM;

void init();
int do_out();

void create()
{
	set("short", "嘉興南湖");
	set("long", @LONG
這里是煙波浩淼的南湖。湖上几只畫舫在游蕩，船上的游客和
青樓女子在嘻笑。湖水很深，沒有船是渡不過去的。但不知是誰在
湖底釘了一些木樁。樁頂潛在水面之下一兩寸的地方。即使是不懂
輕功的人走上去也像是水上漂的樣子。似乎水下有了些什么. 近來
有人潛(out)下湖去搜尋什么, 總也不知道結果如何. 只是有人傳
聞在湖底找到了什么寶貝.
LONG );
	set("exits", ([
		"south"     : __DIR__"yanyu",
                "northwest" : __DIR__ "nanhu",
	]));
	set("outdoors", "quanzhou");
	set("no_clean_up", 0);
	setup();
}

void init()
{
	add_action("do_out","out");
}

int do_out()
{
	object me = this_player();
	message_vision("$N縱身躍起，空中一個浪里翻花，頭下腳上，咚的一聲潛入湖中不見了.\n", me);
	me->move("/d/npc/m_weapon/tan/tan1");
	return 1;
}

