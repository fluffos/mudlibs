// youxun.c
// pal 1997.05.28

#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

int ask_news();
int ask_meeting();

void create()
{
        set_name("游訊", ({ "you xun", "you", "xun" }) );
        set("nickname", "滑不留手");
        set("gender", "男性" );
        set("age", 42);
        set("long",
                "他就是專門打探、販賣消息的游訊。\n");
        set("combat_exp", 100000);
        set("attitude", "friendly");

	set("max_jing",500);
	set("max_qi",500);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 30);

        set("inquiry", ([
		"name" : "小的就是游訊，不知您要打聽點什么？",
		"hop"  : "您是問清嫵呀，她是一位年輕女子, 略有几分姿色. 就是腦門大了點。",
		"wind" : "您是問風云呀，他是金庸群俠傳第一代大俠，想當年一劍平天下，何等威風。\n如今功成身退，歸隱山谷，據說正潛心于一些幕后設計。",
                "tellmewhy" : "您是問小志呀，他最近被應科的一位小妹妹迷住了，也不成心編程，\n一代大蝦為情所困，唉......\n",
		"歐冶子"  : "您問可以幫玩家造兵器的歐冶老爺子呀！據說他現在帶著徒弟到西域去\n居住了，有人說他現在本事更大了，也不知真假\n",
		"news" : (: ask_news :),
		"meeting" : (: ask_meeting :),
		"新聞" : (: ask_news :),
		"比武大會" : (: ask_meeting :),
        ]) );

        set_skill("literate", 100);
        set_skill("dodge", 500);
        set_skill("unarmed", 300);
        setup();
        add_money("gold", 5);
	carry_object("d/city/obj/cloth")->wear();
}

void init()
{
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( environment(ob) != environment() ) return;
	command("hi "+ob->query("id"));
}

int ask_news()
{
	int rows;
	string temp;

	temp = read_file(__DIR__"news.txt", 2, 1);
	rows = atoi(temp);
	temp = read_file(__DIR__"news.txt", 3, rows);
	temp = "游訊說道：\n"+temp+"\n";
	write(temp);

	return 1 ;

}

int ask_meeting()
{
	int rows;
	string temp;

	temp = read_file(__DIR__"meeting.txt", 2, 1);
	rows = atoi(temp);
	temp = read_file(__DIR__"meeting.txt", 3, rows);
	temp = "游訊說道：\n"+temp+"\n";
	write(temp);

	return 1 ;

}
