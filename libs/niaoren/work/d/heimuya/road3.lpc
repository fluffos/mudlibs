inherit ROOM;

void create()
{
        set("short", "黃土路");
	set("long", @LONG
你走在一條黃土路上。西面望去，隱隱可以看到平定州。望
東，北京城快到了。
LONG );
        set("outdoors", "heimuya");
        set("exits", ([
                "east" : "/d/city2/ximenwai",
                "west" : __DIR__"pingdingzhou",
        ]));
        set("no_clean_up", 0);
        setup();
}
