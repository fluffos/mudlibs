inherit ROOM;

void create()
{
        set("short", "黃土路");
	set("long", @LONG
你走在一條黃土路上。這里已經是陝西地面了，向南一條黃
土大道，兩邊望不盡的黃土高坡，沒有一絲吝嗇的綠色。東北隱
隱傳來流水的聲響。
LONG );
        set("outdoors", "heimuya");
        set("exits", ([
                "northeast" : "/d/huanghe/weifen",
                "south"     : __DIR__"road6",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
