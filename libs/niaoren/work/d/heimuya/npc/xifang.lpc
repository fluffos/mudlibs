#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
    set_name("西方失敗", ({"xifang shibai", "xifang"}));
    set("nickname", HIY "天下無敵" NOR );
    set("gender", "女性");
    set("age", 42);
    set("long",
        "她就是日月神教教主。號稱無人可敵，因此有一稱號為「西方失敗」。\n");
    set("attitude", "peaceful");

    set("str", 31);
    set("int", 10);
    set("con", 26);
    set("dex", 30);

    set("chat_chance", 1);
    set("chat_msg", ({
 "西方失敗嘆了口氣道：“唉 …… 那東方不敗是誰呀，你們煩不煩啊！\n",
        }));
    set("inquiry", ([
        "楊蓮亭"   : "你敢直稱我愛人的名字,想找死呀？ \n",
        "葵花寶典" : "如果你能幫我取得葵花寶典上冊，我一定重重謝你。\n",
    ]));

    set("qi", 1000);
    set("max_qi", 1000);
    set("jing", 500);
    set("max_jing", 500);
    set("neili", 500);
    set("max_neili", 500);
    set("jiali", 20);

    set("combat_exp", 250000);
    set("score", 0);

    set_skill("force", 100);             // 基本內功
    set_skill("finger", 100);            // 基本指法
    set_skill("tanzhi-shentong", 100);   // 彈指神通
    set_skill("dodge", 100);             // 基本躲閃
    set_skill("anying-fuxiang", 100);    // 暗影浮香
    set_skill("parry", 100);             // 基本招架
    set_skill("sword", 100);             // 基本劍法
    set_skill("pixie-jian", 80);        // PiXieJian
    set_skill("qimen-wuxing",100);       // 奇門五行
    set_skill("literate",100);           // 讀書識字
    set_skill("kuihua-xinfa", 100);       // 葵花心法

    map_skill("force"  , "kuihua-xinfa");
    map_skill("sword", "pixie-jian");
    map_skill("finger" , "tanzhi-shentong");
    map_skill("dodge"  , "anying-fuxiang");
    map_skill("parry"  , "pixie-jian");

    create_family("日月神教", 2, "教主");

    set("chat_chance_combat", 40);
    set("chat_msg_combat", ({
                (: perform_action, "sword.pi1" :),
                (: perform_action, "finger.ta1" :),
                (: perform_action, "finger.ta2" :),
                (: exert_function, "re1" :),
        }) );

    setup();
    carry_object(__DIR__"obj/zhen")->wield();
    carry_object(__DIR__"obj/hongchouxiaoshan")->wear();

}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 20) {
        command("say 我不收資質差的弟子，您請回吧！\n");
                return;
    }
   
    command("say 很好，很好。\n");
    command("recruit " + ob->query("id"));
}
int recognize_apprentice(object ob)
{
        mapping myfam;
        myfam = (mapping)ob->query("family");
        if ( myfam["family_name"] == "黑木崖") return 1 ;
        if ((int)ob->query_temp("tmark/東") == 1 )
        message_vision("東方不敗看了看$N，說道：咱們現在是誰也不欠誰,\n"
                          "你不要再找我學習技藝了。\n", ob);
        if (!(int)ob->query_temp("tmark/東"))
                return 0;
        ob->add_temp("tmark/東", -1);
        return 1;
}



int accept_object(object who, object ob)
{

        if ( (string) ob->query("id") =="kuihua baodian1" ) {
                if (!(int)who->query_temp("tmark/東",)) who->set_temp("tmark/東",100);
                message_vision("東方不敗看了看$N送來的秘籍，點了點頭，說道：\n"
                               "難得你將寶典送回。你送我的東西我就收下了。\n"
                               "作為補償,你可以從我這里學點功夫。\n", who);
                who->add_temp("tmark/東", 100);
                return 1;

        }
        return 0;
}
