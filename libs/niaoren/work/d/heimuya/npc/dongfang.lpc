// dongfang.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
    set_name("東方不敗", ({"dongfang bubai", "dongfang", "bubai"}));
    set("nickname", HIY "天下無敵" NOR );
    set("title", HIM"日月神教教主"NOR);
    set("gender", "男性");
    set("shen_type", -1);
    set("age", 42);
    set("long",
        "他就是日月神教教主。號稱無人可敵，因此有一稱號為「東方不敗」。\n");
    set("attitude", "peaceful");

    set("per", 21);
    set("str", 21);
    set("int", 30);
    set("con", 26);
    set("dex", 30);

    set("chat_chance", 1);
    set("chat_msg", ({
 "東方不敗嘆了口氣道：“唉 …… 我的楊大哥....他怎么還不回來,我好\n"
 "挂念他 ……東方不敗眼中流露無限迷茫。\n",
        }));
    set("inquiry", ([
        "楊蓮亭"   : "你敢直稱我愛人的名字,想找死呀？ \n",
        "葵花寶典" : "嗯，近來奴家已不再需要這本了只是，本教的葵花寶典上冊卻被失蹤已久的前任長老們帶走，\n
，但如果你能幫我找回葵花寶典上冊，我一定重重謝你。\n",
    ]));

    set("qi", 4000);
    set("max_qi", 4000);
    set("jing", 1000);
    set("max_jing", 1000);
    set("neili", 4500);
    set("max_neili", 4500);
    set("jiali", 400);

    set("combat_exp", 2500000);
    set("score", 0);

    set_skill("force", 450);             // 基本內功
    set_skill("finger", 450);            // 基本指法
    set_skill("unarmed", 450);           // 基本拳腳
    set_skill("dodge", 450);             // 基本躲閃
    set_skill("parry", 450);             // 基本招架
    set_skill("sword", 450);             // 基本劍法
    set_skill("pixie-jian", 450);        // 辟邪劍法
    set_skill("changquan", 450);         // 太祖長拳
    set_skill("literate", 350);          // 讀書識字
    set_skill("kuihua-xinfa", 450);      // 葵花心法

    map_skill("force", "kuihua-xinfa");
    map_skill("sword", "pixie-jian");
    map_skill("unarmed", "changquan");
    map_skill("dodge", "pixie-jian");
    map_skill("parry", "pixie-jian");

    set("chat_msg_combat", ({
                             (: exert_function, "f" :),
                             (: exert_function, "s" :),
                             (: exert_function, "h" :),
                             (: perform_action, "sword.pi1" :),
                     }) );

    create_family("日月神教", 1, "教主");

    set("book_count", 1);

    setup();
    carry_object("/d/fuzhou/obj/xiuhua")->wield();
    carry_object("/d/wanjiegu/npc/obj/qi-dress")->wear();

}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 30) {
        command("say 我不收資質差的弟子，您請回吧！\n");
                return;
    }
//  if (ob->query("gender") !="無性" ) {
//      command("say 要練神功，必須自宮。");
//            return;
//  }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -10000 ) {
        command("say 我黑木崖與世隔絕，向來不與您這種成名人物打交道，您請回吧！\n");
                return;
        }
    command("say 很好，很好。\n");
    command("chat 哈哈哈！！我日月神教又獲一大將，血洗江湖之日不遠了！\n");
    command("chat* hoho");
    command("recruit " + ob->query("id"));
}

int accept_object(object who, object ob)
{

        mapping fam; 

        if (!(fam = this_player()->query("family")) 
            || fam["family_name"] != "日月神教")
            {
                command( "say 你想作什麼！你不是日月神教教眾，再不離開休怪奴家無情了！");
                return 0;
            }

        if (query("book_count") < 1)
            {
                message_vision("咦？上冊已經有人拿給我了，這本是你是從何得來？。");
                return 0;
            }
        if ( (string) ob->query("id") =="kuikua1" ) {
                message_vision("東方不敗看了看$N送來的秘籍，點了點頭，說道：\n"
                               "難得你能找回本教寶典。嗯，待奴家看看\n\n\n"
                               "啊~~原來如此，原來這上冊只是任我行騙我的幌子，很好你作的不錯解了我心頭的大解，那這本寶典就給你吧\n"
                               "希望你拿好好鑽研， 早日接下奴家的位子\n", who);
                message("channel:rumor", MAG"【謠言】某人："+this_player()->query("name")+
                        "得到葵花寶典啦。\n"NOR, users());
                add("book_count", -1);
                ob = new("/clone/book/kuihua");
                ob->move(this_player());
                return 1;

        }
        return 0;

}

