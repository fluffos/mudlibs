// dongfang.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
    set_name("東方不敗", ({"dongfang bubai", "dongfang", "bubai"}));
    set("nickname", HIY "天下無敵" NOR );
    set("title", HIM"日月神教教主"NOR);
    set("gender", "男性");
    set("shen_type", -1);
    set("age", 42);
    set("long",
        "他就是日月神教教主。號稱無人可敵，因此有一稱號為「東方不敗」。\n");
    set("attitude", "peaceful");

    set("per", 21);
    set("str", 21);
    set("int", 30);
    set("con", 26);
    set("dex", 30);

    set("chat_chance", 1);
    set("chat_msg", ({
 "東方不敗嘆了口氣道：“唉 …… 我的楊大哥....他怎么還不回來,我好\n"
 "挂念他 ……東方不敗眼中流露無限迷茫。\n",
        }));
    set("inquiry", ([
        "楊蓮亭"   : "你敢直稱我愛人的名字,想找死呀？ \n",
        "葵花寶典" : "如果你能幫我取得葵花寶典上冊，我一定重重謝你。\n",
    ]));

    set("qi", 4000);
    set("max_qi", 4000);
    set("jing", 1000);
    set("max_jing", 1000);
    set("neili", 4500);
    set("max_neili", 4500);
    set("jiali", 400);

    set("combat_exp", 2500000);
    set("score", 0);

    set_skill("force", 450);             // 基本內功
    set_skill("finger", 450);            // 基本指法
    set_skill("unarmed", 450);           // 基本拳腳
    set_skill("dodge", 450);             // 基本躲閃
    set_skill("parry", 450);             // 基本招架
    set_skill("sword", 450);             // 基本劍法
    set_skill("pixie-jian", 450);        // 辟邪劍法
    set_skill("changquan", 450);         // 太祖長拳
    set_skill("literate", 350);          // 讀書識字
    set_skill("kuihua-xinfa", 450);      // 葵花心法

    map_skill("force", "kuihua-xinfa");
    map_skill("sword", "pixie-jian");
    map_skill("unarmed", "changquan");
    map_skill("dodge", "pixie-jian");
    map_skill("parry", "pixie-jian");

    set("chat_msg_combat", ({
                             (: exert_function, "f" :),
                             (: exert_function, "s" :),
                             (: exert_function, "h" :),
                             (: perform_action, "sword.pi1" :),
                     }) );

    create_family("日月神教", 1, "教主");

    setup();
    carry_object("/d/fuzhou/obj/xiuhua")->wield();
    carry_object("/d/wanjiegu/npc/obj/qi-dress")->wear();

}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 30) {
        command("say 我不收資質差的弟子，您請回吧！\n");
                return;
    }
//  if (ob->query("gender") !="無性" ) {
//      command("say 要練神功，必須自宮。");
//            return;
//  }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我黑木崖與世隔絕，向來不與您這種成名人物打交道，您請回吧！;\n");
                return;
        }
    command("say 很好，很好。\n");
    command("recruit " + ob->query("id"));
}
int recognize_apprentice(object ob)
{
        mapping myfam;
        myfam = (mapping)ob->query("family");
        if ( myfam["family_name"] == "黑木崖") return 1 ;
        if ((int)ob->query_temp("tmark/東") == 1 )
        message_vision("東方不敗看了看$N，說道：咱們現在是誰也不欠誰,\n"
                          "你不要再找我學習技藝了。\n", ob);
        if (!(int)ob->query_temp("tmark/東"))
                return 0;
        ob->add_temp("tmark/東", -1);
        return 1;
}



int accept_object(object who, object ob)
{

        if ( (string) ob->query("id") =="kuikua1" ) {
                if (!(int)who->query_temp("tmark/東",)) who->set_temp("tmark/東",100);
                message_vision("東方不敗看了看$N送來的秘籍，點了點頭，說道：\n"
                               "難得你將寶典送回。你送我的東西我就收下了。\n"
                               "作為補償,你可以從我這里學點功夫。\n", who);
                who->add_temp("tmark/東", 100);
                return 1;

        }
        return 0;
}
