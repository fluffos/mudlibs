inherit ROOM;

void create()
{
        set("short", "黃土路");
	set("long", @LONG
你走在一條黃土路上。陝西的地面，就是看不盡的黃土。向
南方望，遠遠有高山插云，近處好象有個小小村落。隱隱傳來犬
吠雞啼，給你長途的奔波帶來一絲生氣。
LONG );
        set("outdoors", "heimuya");
        set("exits", ([
                "southeast" : "/d/village/wexit",
                "north"     : __DIR__"road5",
        ]));
        set("no_clean_up", 0);
        setup();
}
