inherit ROOM;

void create()
{
	set("short", "新羅坊");
	set("long", @LONG
新羅坊，顧名思義是給新羅人住的地方，不過其實現在新
羅已經被高麗所滅掉，這里應該叫做高麗坊的。可是大家已經
習慣了，于是便還這么叫。這里住著許多高麗商人，也有些高
麗的使臣進東京城路過襄陽，便也住在這里。這里的高麗商人
總有很多很好的貨物，大家都喜歡來買，于是這里就非常的熱
鬧了。
LONG );
	set("exits", ([
		"south" : __DIR__"northroad1",
	]));
	set("objects", ([
		__DIR__"npc/gaoli" : 1,
	]));
	setup();
	replace_program(ROOM);
}

