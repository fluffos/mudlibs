inherit ROOM;

void create()
{
	set("short", "水上走廊");
	set("long", @LONG
這時一條筆直的走廊，廊下是一湖池水。湖水映著長長垂
柳，碧綠清澈，你能看見一些魚在游來游去。南面就是一個大
花園，圓內東西兩側各有一排廂房。
LONG );
        set("outdoors", "xiangyang");
	set("no_clean_up", 0);

	set("exits", ([
		"south" : __DIR__"juyihuayuan",
		"north" : __DIR__"juyiyuan",
	]));
	setup();
	replace_program(ROOM);
}

