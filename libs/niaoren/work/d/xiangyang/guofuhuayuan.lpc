inherit ROOM;

void create()
{
	set("short", "郭府后花園");
	set("long", @LONG
這里是郭府的后花園，園內假山林立，西邊種著一些青竹，
東邊是几棵枝葉茂盛的木筆花樹。你一走進來，就聞到一陣陣
清新的、淡淡的花香。
LONG );
	set("exits", ([
		"east"  : __DIR__"guofuwoshi",
		"west"  : __DIR__"guofukefang",
		"south" : __DIR__"guofuting",
		"north" : __DIR__"guofushufang",
	]));
	set("objects", ([
		__DIR__"npc/huang" : 1,
	]));
	setup();
	replace_program(ROOM);
}

