inherit ROOM;

void create()
{
	set("short", "錢庄");
	set("long", @LONG
這里是襄陽的錢庄，因為這里商業相當發達，各地的商號
都和這里有銀錢來往。錢庄里有很多人在存取錢，也有人在兌
換銀兩。看著這么多的錢財滾來滾去，真是讓人眼饞啊。但眼
下大敵當前，全城一致抵御元兵。錢庄的業務由華山弟子接管，
支援大俠郭靖和郭夫人。牆上貼著一個牌子(paizi)。
LONG );
	set("item_desc", ([
		"paizi" : @TEXT
     本錢庄提供以下服務：
      存錢        deposit或者cun
      取錢        withdraw或者qu
      錢幣兌換    convert或者duihuan
      查帳        check或者chazhang
TEXT
	]));
	set("no_fight", 1);
	set("exits", ([
		"east" : __DIR__"southjie1",
	]));
	set("objects", ([
		__DIR__"npc/huangzhen" : 1,
	]));
	setup();
}

