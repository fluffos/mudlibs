// benchen.c
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("本塵", ({ "ben chen","chen"}) );
        set("gender", "男性" );
        set("long", "他就是天南為帝的大理保定帝段正明。大理歷代國主均遜位
天龍寺出家為僧，保定帝亦不例外。\n" );
        set("title", "天龍寺第十七代僧人");
        set("class", "bonze");
        set("age", 45);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("qi", 2500);
        set("max_qi", 2500);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 800000);
        set("score", 1000000);

        set_skill("force", 230);
        set_skill("tianlong-shengong",240);
        set_skill("dodge", 230);
        set_skill("qingdie-shenfa",210);
        set_skill("yiyang-zhi",250);
        set_skill("sword",210);
        set_skill("parry", 211);
        set_skill("finger", 240);
        set_skill("unarmed",220);
        set_skill("lm-guanchong", 252);
        set_skill("literate", 220);
        map_skill("force", "tianlong-shengong");
        map_skill("parry", "lm-guanchong");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("finger", "lm-guanchong");

        prepare_skill("finger","lm-guanchong"); 

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: exert_function, "f" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        create_family("大理段家",17,"高僧");
        setup();
        carry_object("/d/xueshan/obj/b-jiasha")->wear();
}
#include "ben.h"
