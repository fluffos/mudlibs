// bencan.c

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("本參", ({ "ben can","can"}) );
        set("gender", "男性" );
        set("long", "他身材魁偉，為本因方丈的師兄。\n" );
        set("title", "天龍寺第十七代僧人");
        set("class", "bonze");
        set("age", 49);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("qi", 2500);
        set("max_qi", 2500);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 800000);
        set("score", 1000000);

        set_skill("force", 210);
        set_skill("tianlong-shengong",240);
        set_skill("dodge", 217);
        set_skill("qingdie-shenfa",210);
        set_skill("yiyang-zhi",220);
        set_skill("sword",213);
        set_skill("parry", 189);
        set_skill("finger", 220);
        set_skill("lm-shaoze", 247);
        set_skill("unarmed", 200);
        set_skill("literate", 190);

        map_skill("force", "tianlong-shengong");
        map_skill("parry", "lm-shaoze");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("finger", "lm-shaoze");
        prepare_skill("finger","lm-shaoze");    

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "f" :),
                (: exert_function, "p" :),
        }) );

        create_family("大理段家",17,"高僧");
        setup();
        carry_object("/d/xueshan/obj/b-jiasha")->wear();
}
#include "ben.h"
