// benxiang.c
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("本相", ({ "ben xiang","xiang"}) );
        set("gender", "男性" );
        set("long", "一個枯黃精瘦的僧人，他是本因方丈的師兄。\n");
        set("title", "天龍寺第十七代僧人");
        set("class", "bonze");
        set("age", 50);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("qi", 2500);
        set("max_qi", 2500);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 800000);
        set("score", 1000000);

        set_skill("force", 210);
        set_skill("tianlong-shengong",213);
        set_skill("dodge", 208);
        set_skill("qingdie-shenfa",220);
        set_skill("yiyang-zhi",227);
        set_skill("parry", 180);
        set_skill("finger", 210);
        set_skill("unarmed", 187);
        set_skill("lm-shaochong", 259);
        set_skill("literate", 220);

        map_skill("force", "tianlong-shengong");
        map_skill("parry", "lm-shaochong");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("finger", "lm-shaochong");
        prepare_skill("finger","lm-shaochong"); 
        create_family("大理段氏", 3, "長老");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: exert_function, "f" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        create_family("大理段家",17,"高僧");
        setup();
        carry_object("/d/xueshan/obj/b-jiasha")->wear();
}
#include "ben.h"

