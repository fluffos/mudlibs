// benguan.c
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("本觀", ({ "ben guan","guan"}) );
        set("gender", "男性" );
        set("long", "一個枯黃精瘦的僧人，他是本因方丈的師兄。\n");
        set("title", "天龍寺第十七代僧人");
        set("class", "bonze");
        set("age", 47);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("qi", 2500);
        set("max_qi", 2500);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 800000);
        set("score", 1000000);

        set_skill("force", 200);
        set_skill("tianlong-shengong",210);
        set_skill("dodge", 197);
        set_skill("qingdie-shenfa",200);
        set_skill("yiyang-zhi",210);
        set_skill("sword",200);
        set_skill("parry", 199);
        set_skill("finger", 220);
        set_skill("unarmed", 180);
        set_skill("lm-zhongchong", 261);
        set_skill("literate", 210);
        map_skill("force", "tianlong-shengong");
        map_skill("parry", "lm-zhongchong");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("finger", "lm-zhongchong");
        prepare_skill("finger","lm-zhongchong");        

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: exert_function, "f" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        create_family("大理段家",17,"高僧");
        setup();
        carry_object("/d/xueshan/obj/b-jiasha")->wear();
}
#include "ben.h"
