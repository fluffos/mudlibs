inherit ROOM;

void create()
{
	set("short", "青石大道");
	set("long", @LONG
你走在一條青石大道上，人來人往非常繁忙，不時地有人騎著馬匆匆而過。
大道兩旁有一些小貨攤，似乎是一處集市。往南就是名剎──天龍寺了。
LONG );
        set("outdoors", "tianlongsi");
	set("exits", ([
		"south" : __DIR__"damen",
		"east" : __DIR__"dadao3",
	]));
        set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

