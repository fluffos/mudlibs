//changan  city

inherit  ROOM;

void  create  ()
{
        set  ("short",  "長安城西門");
        set  ("long",  @LONG
這里是長安城的西門。東面就到了城中，遠望人山人海，往來
行人車流不絕。西面一條大路通向遠方。城門下有一些執勤的兵士。
時下雖已天下太平，但一干兵將還是英姿勃勃，警惕的盯著往來人
士。
LONG);
        //set("item_desc",  (["  ***  "  :  "  ***  ",  ]));
        set("exits",  ([  //sizeof()  ==  4
            "west"  :  "/d/xingxiu/xxroad1",
            "east"  :  __DIR__"center",
        ]));

        set("objects",  ([  //sizeof()  ==  1
                "/d/city/npc/wujiang"  :  1,
                "/d/city/npc/bing"  :  1,
        ]));
        set("outdoors",  "changan");
        set("no_clean_up",  0);
        setup();
        replace_program(ROOM);
}



