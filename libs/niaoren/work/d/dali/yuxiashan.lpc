inherit ROOM;
void create()
{
	set("short","玉霞山");
	set("long",@LONG
玉霞山東鎮星云湖，山清林秀，許多游人來此欣賞湖光山色，無
不為之傾倒。古人有詩曰：
      玉霞淒清秋氣涼，
      星云湖水澄明光，
      近嶼含煙凝紫翠，
      遠山峭壁摩青蒼，
      水光山色相輝映，
      萬里無云碧天淨。
LONG);
	set("objects", ([
	   __DIR__"npc/youke": 1,
	]));
	set("outdoors", "dali");
	set("exits",([ /* sizeof() == 1 */
	    "westdown"  : __DIR__"xingyunhu",
	]));
	setup();
}

