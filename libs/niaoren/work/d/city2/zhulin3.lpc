
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "竹林小道");
	set("long", @LONG
四周都是密密的竹林，一踏進這里你就迷了路。這里人跡罕至，
惟聞足踏草坪之聲。偶爾有微風輕拂竹葉，又如簌簌禪唱，令人塵
心為之一滌，真是絕佳的清修所在。
LONG );
	set("exits", ([
		"northeast" : __FILE__,
		"southwest" : __FILE__,
		"east" : __FILE__,
		"west" : __FILE__,
		"south" : __DIR__"zhulin2",
		"north" : __DIR__"zhulin4",
	]));
	set("no_clean_up", 0);
	set("outdoors", "city2");
	setup();
	replace_program(ROOM);
}

