
inherit ITEM;
int do_tear(string arg);

void init()
{
        add_action("do_tear", "tear");
}

void create()
{
        set_name("四十二章經三", ({"book3"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "\n一本正藍旗的經書,封皮(binding)很精致。\n");
                set("unit", "本");
                set("material", "paper");
        }
        setup();
}



int do_tear(string arg)
{
	object me;
	string dir;
	me = this_player();

        if( !arg || arg=="" ) return 0;

	if(arg=="book3")
	{
	message_vision("$N一下把經書撕得粉碎。\n", this_player());
	destruct(this_object());
	return 1;
	}

	if( sscanf(arg, "book3 %s", dir)==1 ) {
	if( dir=="binding" ) {
		if(this_object()->query("hasgot"))
		message_vision("$N將封皮撕開,發現羊皮已經被取走了。\n", this_player());
		else
		{
		message_vision("$N將封皮撕開，几塊羊皮掉了下來。\n", this_player());
		message_vision("$N先將羊皮上的地圖記了下來，然后把它們燒掉了。\n", this_player());
	        me->set("huanggong\\haspi3", 1);
                this_object()->set("hasgot",1);  
        	}
	}
        else
	{
	message_vision("$N一下把經書撕得粉碎。\n", this_player());
	destruct(this_object());
	}
	return 1;
        }	
}

