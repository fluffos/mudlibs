// ring.c 訂婚戒指

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
	set_name(HIC "訂婚戒指" NOR, ({ "diamand ring", "diamand", "ring" }));
       	set("long", "這是風兒送給凌兒的訂婚戒指，襯著她纖纖柔荑，益發光彩照人。\n");
	set("weight", 200);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("value", 100000);
		set("material", "鑽石");
		set("armor_prop/armor", 2);
		set("armor_prop/personality", 3);
		set("female_only", 1);
	}
	setup();
}	
