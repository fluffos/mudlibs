
string look_shelf();

#define STORY_TOC   "/doc/story/toc"
#define STORY_DIR "/doc/story/"
inherit ROOM;

void create()
{
	set("short", "性文學圖書館");
	set("long", @LONG
這是一間極為隱蔽的圖書收藏室。你可以用 read 來閱讀一些書架 (shelf)
上的黃色小說。
LONG );
        set("item_desc", ([
                "shelf" : (: look_shelf :),
        ]));
	set("exits", ([
		"south" : __DIR__"yihongyu",
	]));
	set("no_clean_up", 0);
	setup();
}

void init()
{
	add_action("do_read", "read");
}

string look_shelf()
{
        this_player()->start_more(read_file(STORY_TOC));
        return "\n";
}

int do_read(string arg)
{
        if (arg == "" || file_size(STORY_DIR + arg) <= 0)
                return notify_fail("我們沒有這本書。\n");

	switch (MONEY_D->player_pay(this_player(), 20000)) {
	        case 0:
                return notify_fail("窮光蛋，一邊呆著去！\n");
	        case 2:
                return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
	}
	log_file("LIBRARY", sprintf("%s read %s.\n", this_player()->query("name"), arg));
	this_player()->start_more(read_file(STORY_DIR + arg));
	return 1;
}
