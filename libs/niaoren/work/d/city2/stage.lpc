#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "戲台");
	set("long", @LONG
這里是戲台，雖然有些小，但是很干淨。一個戲子正在表演。
你一踏上戲台，情不自禁地就唱起歌來。
LONG );
	set("exits", ([
		"down" : __DIR__"xiyuan",
	        "southdown":__DIR__"houtai",
	]));
	set("objects", ([
		"/d/city2/npc/xizi": 1,
	]));
//	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
    int i;
if(dir=="down")
{
message_vision(
"\n$N一曲唱罷，一揖作禮，身子平飛，從台上躍出，雙手兀自\n"+
"抱拳向觀眾行禮，姿態美妙，眾人齊聲喝采。\n",this_player());
i=this_player()->query("meili");
if(i<20) 
{
i=i+10;
this_player()->set("meili",i);
message_vision(HIC "\n$N的魅力值提高了。\n" NOR,this_player());
}
}
this_player()->delete_temp("hastryup");
return ::valid_leave(me, dir);
}
