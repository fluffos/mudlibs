inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "安定門");
	set("long", @LONG
這里是永定門，城門正上方刻著“安定門”三個大字，城牆上貼著
几張官府告示 (gaoshi)。几個官兵守在兩旁。
LONG );
        set("outdoors", "city2");
	set("item_desc", ([
		"gaoshi" : (: look_gaoshi :),
	]));
	set("exits", ([
		"south" : __DIR__"di_anmen",
	]));
	set("objects", ([
		"/d/city/npc/wujiang" : 1,
		"/d/city/npc/bing" : 2,
	]));
//	set("no_clean_up", 0);
	setup();
}

string look_gaoshi()
{
	return "輯拿天地會一眾反賊! \n舉報一人，賞金十兩;\n"
          "捉拿一人，賞金百兩。\n知情不報者，立斬!\n鰲拜發\n";
}

