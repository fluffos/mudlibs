void create()
{
	set("short", "鰲拜臥房");
	set("long", @LONG
這是鰲拜的臥房。鰲拜躺在床上睡著了，粗聲粗氣地打著呼嚕。
北邊有一扇門(door)。
LONG );
	set("exits", ([
		"east" : __DIR__"aobai4",
		"north" : __DIR__"aobai10",
	]));
	set("item_desc", ([
