// Room: /city/shuyuan.c
// YZC 1995/12/04 

inherit ROOM;

void create()
{
	set("short", "書院");
	set("long", @LONG
這里是書院的講堂，窗明几淨，一塵不染。一位庄重嚴肅的老者坐在太師
椅上講學，那就是京城的大儒顧炎武了。在他的兩側坐滿了求學的學生。一張
古意盎然的書案放在顧先生的前面，案上擺著几本翻開了的線裝書籍。顧先生
的身后是一個書架(shujia)講堂內多歷代楹聯石刻，足見書院歷史的悠久。值
得一提的是嵌在講堂前左壁的學規(xuegui)。
LONG );
	set("exits", ([
		"south" : __DIR__"xisi2",
	]));
	set("item_desc", ([
		"xuegui" : "日講經書三起，日看綱目數頁。"  
			"\n通曉時務物理，參讀古文詩賦。" 
			"\n讀書必須過筆，會課按時蚤完。"
			"\n夜讀仍戒晏起，疑誤定要力爭。\n\n"
			"求學需繳學費五十兩\n",
	]));
	set("objects", ([
		__DIR__"npc/gu": 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	me->set_temp("mark/朱", 0);
	return 1;
}
