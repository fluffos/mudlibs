
inherit ROOM;
int do_out(string arg);

void create()
{
        set("short", "小橋");
        set("long",
        "這是一座破舊的石橋，橋下是護城河緩緩的流水。水看上去很清，\n"+
	"這里是進皇宮后門的必經之路。\n");
        set("outdoors", "city2");
        set("exits", ([
                "north" : __DIR__"di_anmen",
        ]));
	set("no_clean_up", 0);
        setup();
}


