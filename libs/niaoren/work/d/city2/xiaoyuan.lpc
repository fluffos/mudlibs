// xiaoyuan.c 

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "小院");
	set("long", @LONG
這里是竹林深處的一座小院，環境十分幽雅。自然的嘯聲在林中回響，
直引枯木作龍吟。面對浩蕩、神秘、不可把握的自然，你清楚地看到了自
身的渺小。在這無邊的天地宇宙之中，一個人的生命是多么的短暫和輕飄，
又是多么的無足輕重和微不足道。你靜靜地站在這里，品味著這份久違的
孤獨的靜謐，竟久久不愿轉身離去。北邊就是“聽雨軒”。
LONG );
	set("exits", ([
		"north" : "/d/city2/tingyu",
		"south" : __DIR__"zhulin5",
	]));
	create_door("south", "竹門", "north", DOOR_CLOSED);
	set("no_clean_up", 0);
	setup();
}

