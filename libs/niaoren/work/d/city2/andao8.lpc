
inherit ROOM;

void create()
{
	set("short", "天地會暗道");
	set("long", @LONG
地道里一片漆黑，呼呼的風聲從四面八方傳來。你什么也看不
見，只能在地道里瞎摸亂撞。北面似乎隱隱約約有人說話，但只一
會兒又沒聲了。你使勁地搖了搖頭，很懷疑這到底是不是幻覺。好
象你已經迷路了。
LONG );
	set("exits", ([
		"east" : __DIR__"andao9",
		"south" : __DIR__"andao7",
		"north" : __DIR__"andao5",
		"west" : __DIR__"andao4",
	]));
	set("no_clean_up", 0);
	setup();
}

