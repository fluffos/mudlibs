
inherit ROOM;

string* books = ({
	"/clone/book/yljing",
	"/clone/book/yljing1",
	"/clone/book/yljing2",
//	"/clone/book/yljian",
//	"/clone/book/ylbian",
	"/clone/book/book-bamboo",
//	"/clone/book/book-paper",
	"/clone/book/book-silk",
	"/clone/book/book-stone",
	"/clone/book/book-iron",
	"/clone/book/quanpu",
	"/clone/book/dujing_1",
});

void create()
{
	set("short", "側廳");
	set("long", @LONG
這里是側廳，靠牆是一排書架，擺滿了各種拳譜、書籍。牆角有一張木床。
天地會總舵主陳近南常常在這里讀書、休息。
LONG );
	set("exits", ([
		"west" : __DIR__"dating",
	]));
        set("sleep_room", 1);   
	set("objects", ([
		books[random(sizeof(books))] : 1,
		books[random(sizeof(books))] : 1,
		books[random(sizeof(books))] : 1,
		books[random(sizeof(books))] : 1,
	]));
//	set("no_clean_up", 0);
