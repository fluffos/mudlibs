inherit ROOM;

void create()
{
	set("short", "西單");
	set("long", @LONG
這里就是西單，人來人往，十分熱鬧。游人雖然多，但大都只四處晃悠,
著東瞅瞅西看看，也不急著買什么。西邊有家雜貨鋪，去那里買東西的人很多。
不斷有人從北邊走來，似乎那里也挺熱鬧。南邊是西長安街。
LONG );
        set("outdoors", "city2");
