inherit ROOM;

void create()
{
	set("short", "回春堂藥店");
	set("long", @LONG
這是一家藥鋪，一股濃濃的藥味讓你几欲窒息，那是從藥柜上的
几百個小抽屜里散發出來的。一位老者在柜台后站著。柜台上貼著一
張發黃的廣告(guanggao)。柜台后面往西是一間內室(neishi)。
LONG );
	set("item_desc", ([
		"guanggao" : "本店出售以下藥品：
金創藥：\t五十兩白銀
其他神藥與老板面議。\n",
	]));
	set("objects", ([
		"/d/city2/npc/huoji2" : 1,
		"/d/city2/npc/xutianch" : 1,
	]));
	set("exits", ([
		"north" : __DIR__"xichang1",
                "west" : __DIR__"neishi",   
	]));
//	set("no_clean_up", 0);
	setup();
}

