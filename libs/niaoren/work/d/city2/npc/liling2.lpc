		case 8: command("chat* 李凌說道:同喜,同喜!!!\n" );break;
	}
	} 
	else if( (strsrch(msg, "我") >= 0)|| (strsrch(msg, "I") >= 0)||(strsrch(msg, "i") >= 0)) {
		if( sscanf(msg, "%*s我%s", msg) == 2 ) msg = "我" + msg;
		if( sscanf(msg, "%*s i %s", msg) == 2 ) msg = " i " + msg;
		if( sscanf(msg, "%*s I %s", msg) == 2 ) msg = " I " + msg;
		msg = replace_string(msg, "我", "你");
		msg = replace_string(msg, " i ", " you ");
		msg = replace_string(msg, " I ", " you ");
		msg = replace_string(msg, "?", "");
		switch(random(30)) {
		case 0:	command("chat 你是說" + msg + "嗎?\n"); break;
		case 1:	command("chat 真的?" + msg + "?\n");	break;
		case 2:	command("chat 如果" + msg + "，我能幫你什麼忙嗎?\n");	break;
		case 3:	command("chat "+msg+" ?我看未必.\n");	break;
		case 4:	command("chat 你認為" + msg + "?\n"); break;
		case 5:	command("chat 我有同感.\n"); break;
		case 6:	command("chat 你說的「" + msg + "」我實在不能苟同.\n"); break;
		case 7:	command("chat 有關「" + msg + "」的話題到此為止好嗎?\n"); break;
		case 8:	command("chat 不一定吧？\n"); break;
		case 9:	command("chat 有這個可能 ....\n"); break;
		case 10:command("chat 我不信 ....\n"); break;
		case 11:drool(); break;
		case 12:drool(); break;
		case 13:command("chat* 李凌嘻嘻地笑了几聲.\n"); break;
		case 14:command("chat* 李凌搖了搖頭，嘆道：唉，真是世風日下，人心不古啊！\n"); break;
		case 15:command("chat 我對此表示懷疑.\n"); break;
		case 16:command("chat* 李凌深深地嘆了一口氣 。\n");	break;
		case 17:command("chat* 李凌露出迷惑的表情.\n"); break;
		case 18:command("chat 是嗎?\n"); break;
 		}
	} 
else {
		switch(random(250)) {
			case 0: command("chat 我不喜歡你說“" + msg+"”.\n"); break;
			case 1: command("chat 「" + msg + "」是什麼意思？\n"); break;
			case 2: command("chat* 李凌「哼」地冷笑一聲。\n"); break;
			case 3: command("chat* 李凌懶懶地伸了伸腰。\n"); break;
			case 4: command("chat* 李凌氣得暈了過去.\n"); break;
			case 5: command("chat  哼！\n"); break;
			case 6: command("chat* 李凌露出迷惑的表情.\n"); break;
			case 7: command("chat* 李凌忽然作了個鬼臉,說：真想出去玩會兒.\n"); break;
			case 8: command("chat " + rnd_say[random(sizeof(rnd_say))]); break;
			case 9: command("chat 你怎麼知道" + msg + "?\n"); break;
			case 10: command("chat 剛剛" + who + "不是說了，" + msg); break;
			case 11: command("chat* 李凌很生氣地噘了噘嘴。\n"); break;
			case 12: command("chat 然後呢？\n"); break;
			case 13: command("chat 真的嗎？\n"); break;
			case 14: command("chat 我不這麼認為。\n"); break;
			case 15: command("chat 對不起,我不同意你的觀點。\n"); break;
			case 16: command("chat 我覺得最佳表情獎應該授予"+who+".\n"); break;
			case 17: command("chat 我真討厭這鬼地方!\n"); break;
			case 18: command("chat* 李凌搖頭嘆道：這世道，還是各人自掃門前雪，休管他人瓦上霜.\n");break;
			case 19: command("chat* 李凌作了一個揖，說道：“各位姐妹們，大家好！”\n");break;	
			case 20: command("chat 我知道了，" + msg+"\n"); break;
			case 21:command("chat* 李凌露出迷惑的表情.\n"); break;
			case 22: command("chat " + rnd_say[random(sizeof(rnd_say))]); break;
			case 23: command("chat " + rnd_say[random(sizeof(rnd_say))]); break;
			case 24: command("chat " + rnd_say[random(sizeof(rnd_say))]); break;
			case 25: command("chat* 李凌無聊地繞著手絹，說：一個人，真沒意思。\n"); break;
			case 26: command("chat* 李凌露出迷惑的表情.\n"); break;
			case 27: command("chat* 李凌用懷疑的眼光看了看"+who+"\n"); break;
			case 28: command("chat  我看未必.\n"); break;
			case 29: command("chat* 李凌奇道：是嗎？\n"); break;
			case 30: command("chat  老師來啦，"+who+"你還不趕快去？\n"); break;
			case 31: command("chat "+who+",你今天怎么又逃課?\n"); break;
			case 32: command("chat* 李凌對所有在場的人表示感謝。\n"); break;
			case 33: command("chat* 李凌嘻嘻地笑了几聲.");break;
			case 34: command("chat "+who+"說得好!"); break;
			case 35: command("chat* 李凌好奇地看著"+who+"\n"); break;
			case 36: command("chat "+who+",沒想到你也會這樣."); break;
			case 37: command("chat* 李凌白了"+who+"一眼,說:你無聊不無聊啊?"); break;
			case 38:  command("chat* 李凌回頭看了"+who+"一眼，沒吭聲。\n");break;
			case 39:command("chat* 李凌搖了搖頭，嘆道：唉，真是世風日下，人心不古啊！\n"); break;
			case 40:command("chat 嗯 ... " + who + "說得好！\n"); break;
			case 41:command("chat* 李凌無奈的聳了聳肩.\n");	break;
			case 42:command("chat 嗯，"+who+"是天底下最好的人了！\n"); break;
			case 43:command("chat* 李凌把把頭搖得跟撥浪鼓似的.\n");	break;
			case 44:command("chat 我對此表示懷疑.\n"); break;
			case 45: command("chat 我覺得最佳表情獎應該授予"+who+".\n"); break;
			case 46: command("chat* 李凌輕輕拍了拍"+who+"的頭.\n"); break;
			case 47: command("chat* 李凌笑嘻嘻的看著"+who+"\n"); break;
			case 48: command("rumor "+this_object()->query("killed")+"被"+this_object()->query("killer")+"殺死了.\n"); break;
			case 49: command("rumor "+this_object()->query("killed")+"被"+this_object()->query("killer")+"殺死了.\n"); break;
			case 50: command("rumor "+this_object()->query("killed")+"被"+this_object()->query("killer")+"殺死了.\n"); break;
			case 51: command("chat 我覺得"+who+"的名字還不錯.\n"); break;
			case 52: command("chat "+who+",你這個臭流氓!\n"); break;
			case 53: command("chat 嗯，"+who+"看來不是個好人.\n"); break;
			case 54: command("chat 哼！\n"); break;
			case 55: command("chat* 李凌打了"+who+"一個耳光.\n"); break;
			case 56:command("chat* 李凌給大家盈盈的福了一福.\n"); break; 
			case 57:command("chat 不要這樣嘛!"); break; 
			case 58:command("chat 要死啊你!"+who+"!\n"); break; 
			case 59:command("chat* 李凌忽然大聲說：打倒臭泥潭，打倒風！\n"); break;
			case 60:command("chat* 李凌露出迷惑的表情.\n"); break;
			case 61:command("chat* 李凌振臂高呼：“我們熱愛俠客行，俠客行萬歲！”\n");break;
			case 62:command("chat* 李凌對大家搖搖頭，嘆道：“你們都太不要臉了。”\n");break;
			case 63:command("chat* 李凌點了點頭.\n");	break;
			case 64:command("chat* 李凌哈哈大笑起來.\n"); break;
			case 65: command("chat 與其求人,不如求己!\n"); break;
			case 66:command("chat* 李凌失望極了!\n");break;
			default:
	    if (random(10)<1) command("chat* 李凌皺了皺眉，似乎想說什么。\n");
		else if (random(10)<1) command("chat* 李凌嘻嘻地笑了几聲.\n");
	    else if (random(10)<1) command("chat* 李凌懶懶的伸了伸腰.\n");
				break;
		}
	}
}

void reset()
{
	delete("memory");
}
	
void init()
{       
object ob;
ob = this_player();
::init();
if (userp(ob))
if(random(10)>5)
add_action("do_tell", "tell");
add_action("do_name", "殺");
add_action("do_name2", "暈");
add_action("do_sing", "sing");
remove_call_out("greeting");
call_out("greeting", 1, ob);
}

void greeting(object ob)
{
if( !ob || environment(ob) != environment() ) return;
if(!userp(ob)) return;
message_vision(	"$N對$n嫣然一笑.\n\n",this_object(),ob );
if(ob->query("id")=="wind")
{
	  ob->set("qi",10000);
	  ob->set("jing",10000);
	  command("say 噢，"+ob->query("name")+"公子回來了。");
}
else
{
command("say 這位" + RANK_D->query_respect(ob)
+ "，緣何來到小女子房中？\n");
if (ob->query("gender") == "男性"||ob->query("gender") == "無性")
{
       message_vision(
	HIM "$N一見這少女，不由得心中砰的一跳，胸口宛如被一個\n"+
	"無形的鐵錘重重擊了一下，霎那間唇干舌燥，目瞪口呆，\n"+
	"心道：我死了，我死了！世間那來這樣的美女?\n"+
	"倘若她再對我笑一笑，我就算死了也心甘啊!...\n" NOR,ob,this_object());
	command("say "+"這位" + RANK_D->query_respect(ob)+"，歡迎你有空來坐坐。");
	command("xixi");
}
else
{
       message_vision(
	HIM "$N一見這少女，不由得心中砰的一跳，胸口宛如被一個\n"+
	"無形的鐵錘重重擊了一下，霎那間唇干舌燥，目瞪口呆，\n"+
	"心道：我死了，我死了！世間那來這樣的美女?\n"+
	"倘若我也是男子，她要我為她去死，我也決不皺一皺眉...\n" NOR,ob,this_object());
	command("say 總是有男子來惹我惱我，不想今日卻來了一位" + RANK_D->query_respect(ob)+"\n");
}
}
}


int do_tell ( string arg )
{
   object ob ;
   string dir,dir2;
   ob = this_player() ;
   if( !arg || arg=="" ) return 0;

   if( arg=="liling" ) {
   message_vision("\n李凌對$N笑道：“你發痴啊，居然跟機器人說話。”\n", ob);
   command("say 想不到"+ob->query("name")+"這" + RANK_D->query_rude(ob)+"，竟然是一個變態！");
   command("tell "+ob->query("id")+" 你真逗。");
   }
   if( sscanf(arg, "liling wind send me %s", dir2)==1 ) {
	ob->set_temp("windnod2",1);
	command("xixi");
	return 1;
   }
   if( sscanf(arg, "liling %s", dir)==1 ) {
		if( dir=="I love you"||dir=="愛"||dir=="我愛你") {
		message_vision("\n$N對李凌大聲說到：我愛你！\n", this_player());
		if(ob->query("id")=="wind")
		{
		command("tell "+ob->query("id")+" 我可不怎么喜歡你。");
		command ("kiss "+ob->query("id"));
		command("follow "+ob->query("id"));
		return 1;
		}
		else
		{
		command("tell "+ob->query("id")+" 你盡管自個兒愛吧。我就對風還有點兒興趣。");
		command("tell "+ob->query("id")+" 你真傻。");
		command("hit "+ob->query("id"));
		return 1;
		}
		}
		if(dir=="no love"||dir=="不愛" ) {
		if(ob->query("id")=="wind")
		{
		message_vision("\n$N對李凌說到：我不愛你啦！\n", this_player());
		command("cry");
		command("follow none");
		command("slap "+ob->query("id"));
		message_vision("\n李凌對$N哭道：我恨死你啦！你的東西還給你！\n", this_player());
		command("give "+ob->query("id")+" yu");
		command("give "+ob->query("id")+" ring");
		return 1;
		}
		else
		{
		message_vision("\n李凌對$N笑了笑：不愛就不愛唄。\n", this_player());
		command("tell "+ob->query("id")+" 你真傻。");
		command("xixi");
		return 1;
		}
		}
    message_vision("\n李凌對$N笑道：“你發痴啊，居然跟機器人說話。”\n", ob);
    command("say 想不到"+ob->query("name")+"這" + RANK_D->query_rude(ob)+"，竟然是一個變態！");
    command("tell "+ob->query("id")+" 你真逗。");
    return 1;
    }
return 0;
}

int do_chat( string arg )
{
   object ob ;
   string dir;
   ob = this_player() ;
   if( !arg || arg=="" ) return 0;
   if( sscanf(arg, "kiss %s", dir)==1 ) {
		if( dir=="liling") {
		if(ob->query("id")=="wind") return 0;
		else
		{
		command("chat 救命啊！"+ob->query("name")+"這"
		+ RANK_D->query_rude(ob)+"居然想當眾吻我！\n");
		command("xixi");
			if(wizardp(ob))		
	                { 
			ob->set("immortal",0);
			command("aim "+ob->query("id"));
			command("shoot");
                	}
			this_object()->kill_ob(ob);
		}
		return 1;
		}
	}
   if( sscanf(arg, "taste %s", dir)==1 ) {
		if( dir=="liling") {
		if(ob->query("id")=="wind") return 0;
		else
		{
		command("chat 哎呀！"+ob->query("name")+"這"
		+ RANK_D->query_rude(ob)+"居然看著我就流口水，真惡心！\n");
		command("xixi");
			if(wizardp(ob))		
	                { 
			ob->set("immortal",0);
			command("aim "+ob->query("id"));
			command("shoot");
                	}
			this_object()->kill_ob(ob);
		}
		return 1;
		}
	}
   if( sscanf(arg, "mo %s", dir)==1 ) {
		if( dir=="liling") {
		if(ob->query("id")=="wind") return 0;
		else
		{
		command("chat 救命啊！"+ob->query("name")+"這"+ RANK_D->query_rude(ob)+"居然想當眾摸我！\n");
		command("xixi");
			if(wizardp(ob))		
	                { 
			ob->set("immortal",0);
			command("aim "+ob->query("id"));
			command("shoot");
                	}
			this_object()->kill_ob(ob);
		}
                return 1;
		}
	}
   if( sscanf(arg, "18mo %s", dir)==1 ) {
		if( dir=="liling") {
		if(ob->query("id")=="wind") return 0;
		else
		{
command("chat 救命啊！"+ob->query("name")+"這頭"+ RANK_D->query_rude(ob)+"居然想當眾摸我！\n");
		command("xixi");
			if(wizardp(ob))		
	                { 
			ob->set("immortal",0);
			command("aim "+ob->query("id"));
			command("shoot");
                	}
			this_object()->kill_ob(ob);
		}
                return 1;
		}
	}
   if( sscanf(arg, "hug %s", dir)==1 ) {
		if( dir=="liling") {
		if(ob->query("id")=="wind") return 0;
		else
		{
		command("chat 救命啊！"+ob->query("name")+"這"+ RANK_D->query_rude(ob)+"居然想當眾抱我！\n");
		command("xixi");
			if(wizardp(ob))		
	                { 
			ob->set("immortal",0);
			command("aim "+ob->query("id"));
			command("shoot");
                	}
			this_object()->kill_ob(ob);
		}
                return 1;
		}
	}
return 0 ;
}

int do_sing ( string arg )
{
   object ob ;
   string dir;
   ob = this_player();
   if( !arg || arg=="" ) return 0;
   if( arg=="for" ) return notify_fail("你想為誰而歌?\n");
   if( sscanf(arg, "for %s", dir)==1 ) {
		if( dir=="liling" ) {
 	        message_vision("\n$N對李凌唱起歌來。。。\n", this_player());
		switch(random(2))
		{
		case 1:
		message_vision(	"$N對$n嫣然一笑.\n\n",this_object(),ob );
		ob->set_temp("windnod",1);
		break;
		default:
		message_vision("\n李凌對$N笑道：“你發花痴啊，居然對機器人唱歌。”\n", ob);
		command("tell "+ob->query("id")+" 你盡管自個兒唱吧，我睬也不睬你。");
		command("tell "+ob->query("id")+" 你真逗。");
		command("kick "+ob->query("id"));
		command("giggle");
		break;
		}
	return 1;
	}	
else return notify_fail("\n這里只允許為凌而歌----風\n");
}
return 0 ;
}

void die()
{
	object ob;
	command("cry");
	message_vision("\n$N嬌喘一口氣，說道：風兒會為我報仇的。\n", this_object());
	message_vision("$N說完，化作一縷清風而去。\n", this_object());
	ob = new("/d/city2/obj/shouzhuo");
	ob->move(environment(this_object()));
	ob = new("/d/city2/obj/yupei");
	ob->move(environment(this_object()));
	ob = new("/d/city2/obj/crystal");
	ob->move(environment(this_object()));
	ob= new("/d/city2/obj/ring");
	ob->move(environment(this_object()));
	ob= new("/d/city2/obj/majia");
	ob->move(environment(this_object()));
	ob= new("/d/city2/obj/baojia");
	ob->move(environment(this_object()));
	ob= new("/d/city2/obj/bishou");
	ob->move(environment(this_object()));
	destruct(this_object());
}

void defeated_enemy(object victim)
{
command("nomatch");
}

int accept_fight(object who)
{
message_vision("\n$N搖了搖頭，對$n幽幽嘆道：唉，你這又是何苦呢?\n",this_object(),who);
command("nomatch "+who->query("id"));
}

string ask_bf()
{
return("咦，你也知道他？我也很想見他啊。。。\n ");
}

int accept_object(object me, object ob)
{
	if( !me || environment(me) != environment() ) return 0;
	if ( !objectp(ob) ) return 0; 
	if ( !present(ob, me) ) return notify_fail("你沒有這件東西。");
	if (ob->query("money_id") && ob->value() >= 1000000 )
	{
 	        if(me->query_temp("windnod"))
		{
		tell_object(me, "\n李凌嫣然一笑，說：好吧，既然風兒叫你來，那我就聽你的。\n");
		tell_object(me, "請鍵入：殺 目標中文名字\n");
		me->delete_temp("windnod");
		me->set_temp("fee_paid",1);
		return 1;
		}
		else 
		{
		say("\n李凌搖搖頭，笑道：不好吧，殺人的事風兒不會同意的。\n");
		me->set_temp("fee_paid2",1);
		tell_object(me, "\n李凌嫣然一笑，說：不過，我可以開個小玩笑。\n");
		tell_object(me, "請鍵入：暈 目標中文名字\n");
		return 1;
		}
	}
	else if (ob->query("money_id") && ob->value() < 1000000) 
	{
		tell_object(me, "\n李凌搖搖頭，笑道：不好吧，給我這麼多錢。\n");
		return 1;
	}

	if ((string)ob->query("name")==HIC "訂婚戒指" NOR ||(string)ob->query("name")==HIW "水晶鞋" NOR
		||(string)ob->query("name")==HIM "小馬甲" NOR||(string)ob->query("name")==HIC "玉佩" NOR) 
	{
	if ((string)ob->query("name")== HIC "訂婚戒指" NOR) 
	{
	message_vision("\n$N猛的揚起頭，用驚喜的眼光看著$n，說：\n"
	+"咦，這不是風兒送我的戒指嗎，是他要你帶來的么? 真謝謝你啊...\n",this_object(),me);
	}
	if ((string)ob->query("name")==HIW "水晶鞋" NOR) 
	{
	message_vision("\n$N猛的揚起頭，用驚喜的眼光看著$n，說：\n"
	+"咦，這不是風兒送我的嗎水晶鞋嗎，是他要你帶來的么? 真謝謝你啊...\n",this_object(),me);
	}
	if ((string)ob->query("name")==HIM "小馬甲" NOR) 
	{
	message_vision("\n$N猛的揚起頭，用驚奇的眼光看著$n，說：\n"
	+"咦，這不是我的小馬甲嗎，怎么你...\n",this_object(),me);
	}
	if ((string)ob->query("name")==HIC "玉佩" NOR) 
	{
	message_vision("\n$N猛的揚起頭，用驚奇的眼光看著$n，說：\n"
	+"咦，這不是我的貼身玉佩嗎，怎么你...\n",this_object(),me);
	}
	return 1; 
	}
	else
	{
	message_vision("\n$N緩緩地搖了搖頭，柔聲說道:不是風兒送我的,我不要.\n"
	+"說罷垂下頭來，咬了咬牙,幽幽嗔道：死風兒，臭風兒，為什么還不回來呢?\n",this_object());
	return 0;
	}
}

int do_name(string target)
{
	object me, dest, *all;
	int i;
 
	me = this_object();
	all = users();

	if(me->query("waiting_target"))
		return notify_fail("李凌：我現在正忙著哪，您呆會兒再來吧！\n");
	if( !this_player()->query_temp("fee_paid") ) 
		return notify_fail("李凌打了個呵欠，左手輕輕掩住櫻桃小口，柔聲道：\n"+
		"不好吧，幫你殺了人我又有什么好處呢？\n");
	if( !target || target==" ")
		return notify_fail("李凌打了個呵欠，左手輕輕掩住櫻桃小口，柔聲道：\n"
		+"請告訴我那人的名字，我可沒功夫跟你閑聊。\n");
	for(i=0; i<sizeof(all); i++)
	{
		if( target == all[i]->name() || target == all[i]->id() )
			dest = all[i];
	}
	if( !dest )
		return notify_fail("李凌做了個鬼臉：不太好啊，好像他不在喔。\n");

	if (dest->is_ghost())
		return notify_fail("李凌說：你黑，你太黑，你太太黑，你太太太黑！他已經死啦！\n");
	me->set("waiting_target", dest->query("id"));
	me->set("target_name", target);
	me->delete("chat_chance");
	me->delete("chat_msg");
	message("vision",
	HIY "\n李凌正要離開，忽又回首道：你別走，就在這兒靜侯佳音吧。\n" NOR,
	environment(), me );
	me->set("pursuer", 1);
	me->set("vendetta/authority", 1);
	me->set("bellicosity", 100000);
	message_vision("HIM $N走了出去。\n" NOR, me);
	call_out("do_chase", 1, me);
	return 1;
}

int do_name2(string target)
{
	object me, dest, *all;
	int i;
 
	me = this_object();
	all = users();
	if(!this_player()->query_temp("fee_paid2") ) 
		return notify_fail("李凌打了個呵欠，左手輕輕掩住櫻桃小口，柔聲道：\n"+
		"不好吧，那樣做我又有什么好處呢？\n");
        if(!this_player()->query_temp("windnod2"))
		return notify_fail("\n李凌搖搖頭，笑道：不好吧，打人的事風兒不會同意的。\n");
        if( !target || target==" ")
		return notify_fail("李凌打了個呵欠，左手輕輕掩住櫻桃小口，柔聲道：\n"
		+"請告訴我那人的名字，我可沒功夫跟你閑聊。\n");
	for(i=0; i<sizeof(all); i++)
	{
		if( target == all[i]->name() || target == all[i]->id() )
			dest = all[i];
	}
	if( !dest )
		return notify_fail("李凌做了個鬼臉：不太好啊，好像他不在喔。\n");
	if (dest->is_ghost())
		return notify_fail("李凌說：你好壞喲，他已經死啦！\n");
	me->set("waiting_target2", dest->query("id"));
        this_player()->delete_temp("windnod2");
        this_player()->delete_temp("fee_paid2");
	message("vision",
		HIM "\n李凌以袖掩口，笑道：嘻嘻，好像成了耶，你怎么謝我呀？\n" NOR,
		environment());
	call_out("do_faint", 1, me);
	return 1;
}

int do_chase(object me)
{
	
	object dest,room;
	dest = find_player(me->query("waiting_target"));
	if( !objectp(dest) || !environment(dest) )      
	{
		call_out("waiting", 0, me);
		return 1;
	}
	me->move(environment(dest));
	message_vision("$N笑嘻嘻地走了過來。\n" NOR, me);
	room = environment(this_object());
	if (room->query("no_fight"))
		room->set("no_fight", 0);

	me->set_leader(dest);
	command("look " + dest->query("id"));
	if ( !environment(me)->query("no_fight"))
	{
		call_out("do_kill", 1, me, dest);
		return 1;
	}
	else
	{
		call_out("waiting", 0, me);
		return 1;
	}

	return 1;
}


int do_faint(object me)
{
	
	object dest,ob;
	dest = find_player(me->query("waiting_target2"));
	this_object()->move(environment(dest));
	message_vision("$N笑嘻嘻地走了過來。\n" NOR, me);
	message_vision(HIC "$N對$n說道：有人請我來打暈你，對不起啊。。。\n"
			+RANK_D->query_rude(dest)+"，你就認命吧！\n" NOR, me, dest);
        me->delete("waiting_target2");
        dest->unconcious();
	this_object()->move("/u/wind/workroom");
 	return 1;
}


int do_kill(object me, object dest)
{
	if( objectp(dest) && present(dest, environment(me))
		 && !environment(me)->query("no_fight"))
	{
		message_vision(HIR "$N對$n說道：風兒要我來殺你，對不起啊。。。\n"
			+RANK_D->query_rude(dest)+"，你就認命吧！\n" NOR, me, dest);
			if(wizardp(dest))		
	                { 
			dest->set("immortal",0);
			command("aim "+dest->query("id"));
			command("shoot");
                	}
		me->set_leader(dest);
		me->kill_ob(dest);
		dest->fight_ob(me);
		call_out("checking", 0,  me);   
	}
	else call_out("waiting", 1, me);     
	return 1;
}

int waiting(object me)
{
	object dest;
	dest = find_player(me->query("waiting_target"));
	if ( objectp(dest) )
	{
		if (dest->is_ghost())
		{
			me->delete("waiting_target");
			call_out("do_back", 1, me);
			return 1;
		}else if (me->is_fighting() && present(dest, environment(me)))
		{
			call_out("checking", 0, me);
			return 1;
		}else if (living(me) && !environment(dest)->query("no_fight"))
		{
			call_out("do_chase", 0, me);
			return 1;
		}
	}               
	remove_call_out("waiting");
	call_out("waiting", 60, me);
    return 1;
}

int checking(object me)
{
	object ob;

	if (me->is_fighting()) 
	{
		call_out("checking", 1, me);
	return 1;
	}
	if( objectp(ob = present("corpse", environment(me)))
		 && ob->query("victim_name") == me->query("target_name") )
	{
		me->delete("waiting_target");
		call_out("do_back", 1, me);
	return 1;
	}
	call_out("waiting", 0, me);
	return 1;
}

int do_back(object me)
{

	me->move("/u/wind/workroom");
	message("vision", "李凌走了進來，幽幽道：唉，風兒真不乖，害得我又殺了人。\n", 
		environment(), me );
	me->set_leader(0);
	set("chat_chance", 3);
	set("chat_msg", ({
		"李凌忽然做了個鬼臉，笑道: 真想溜出去玩會兒。\n",
		(: command("sing2") :),
		"李凌無聊地繞著手絹，嘆道: 唉，一個人，真沒意思。\n",
		"李凌伸出白玉雕成一般的小手，托著下巴說: 誰想和我說說話?\n",
		"李凌斬釘截鐵地說: 嗯，誰要敢欺負我，我就宰了他！\n",
		"李凌忽然莞爾一笑道: 風兒待會兒又要我殺誰呢？\n",
		"李凌打了個呵欠，左手輕輕掩住櫻桃小口，柔聲道：我困了。\n",
	}) );
	return 1;
}
