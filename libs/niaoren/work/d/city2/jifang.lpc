
inherit ROOM;
#include <ansi.h>


void create()
{
	set("short", "網絡機房");
	set("long", @LONG
這里是一個擁有兩百多台586的超大規模機房.計算機系、電信系、信息系、
應科系等各系的網虫們，都經常聚在這里泡網。今天屋里又座無虛席,然而竟然
沒有一個人play MUD。牆上貼著一份通告 (tonggao)，旁邊的架子上擺著一塊
小黑板(board).
LONG );
	set("exits", ([ 
		"west" : __DIR__"xukong",
		"north" : __DIR__"ximenwai",
	]));

       set("item_desc", ([
                "tonggao" :   
  HIR "本機房鄭重宣布,以下大蝦小蝦皆被停機一月:\n" NOR +
  HIR "并罰款五十兩白銀,望其它蝦咪引以為戒:\n" NOR +
  HIM "華山第十四代弟子[武痴]卓云白(zyb)\n" NOR +
  HIM "云龍門第三代弟子[笑比哭好]司馬湘云(huak)\n" NOR +
  HIM "武當第三代弟子 何停雨(xiao)\n" NOR +
  HIR ".......\n" NOR,
 "board" :   HIC "請注意,以下機器因長期被敲敲打打，已不能正常使用：\n" NOR +
  HIM "55號機，60號機，78號機，136號，。。。。。\n" NOR,
	]));

	set("valid_startroom",1);
	set("objects", ([ 
		"/d/city2/npc/zhuge" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
    int i;
    object *inv;
if(dir=="west")
 {
        inv = all_inventory(me);
        for(i=sizeof(inv)-1; i>=0; i--)
		if(objectp(present("zhuge", environment(me)))&&living(present("zhuge", environment(me))))
                    return notify_fail("諸葛老太上前大喝一聲："+
                        RANK_D->query_rude(me) + "哪里走？！\n");
	return ::valid_leave(me, dir);
 }
return ::valid_leave(me, dir);
}

