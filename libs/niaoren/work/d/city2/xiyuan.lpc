
inherit ROOM;

void create()
{
	set("short", "長安戲院");
	set("long", @LONG
這里就是著名的長安戲院，几個戲子在台上(stage)唱戲。
台下黑壓壓的一片都是人。唱到妙處，觀眾們禁不住大聲喝采。
東邊是后台。
LONG );
	set("exits", ([
		"south" : __DIR__"xichang1",
                "up" : __DIR__"stage",
                "east" : __DIR__"houtai",
	]));
        set("item_desc", ([
		"stage" : "\n看到戲台，你突然有種想登台表演的沖動。\n" ,
	]));
        set("objects", ([
		"/d/city2/npc/guanzho":  5,
	]));
//	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
    int i;
    object man,*ob;
    if(dir=="up")
    {
 	if(!me->query_temp("hastryup"))
        {
        me->set_temp("hastryup",1);
       	if((int)me->query("meili")>=20)
		{
	message_vision(  
	"只聽嘩啦啦一片掌聲，觀眾們一起鼓掌。有人大聲說道：\n"
	"淨一淨，請看這位" + RANK_D->query_respect(me)+ "表演。\n",this_player());
        return ::valid_leave(me, dir);
	        }
        	else
		{
	message_vision(
	"\n突然觀眾一擁而上，對$N大叫道：憑你也敢上台鬧事？老子宰了你這" +
                        RANK_D->query_rude(me) + "！\n",this_player());
        if(!present("jia", environment(this_player())))
	{
	man=new(__DIR__"npc/guanzho1");
	man->move(this_object());
	}
	if(!present("yi", environment(this_player())))
	{
	man=new(__DIR__"npc/guanzho2");
	man->move(this_object());
	}
	if(!present("bing", environment(this_player())))
	{
	man=new(__DIR__"npc/guanzho3");
	man->move(this_object());
	}
	if(!present("ding", environment(this_player())))
	{
	man=new(__DIR__"npc/guanzho4");
	man->move(this_object());
	}
	if(!present("wu", environment(this_player())))
	{
	man=new(__DIR__"npc/guanzho5");
	man->move(this_object());
	}
	ob = all_inventory(this_object());
	for(i=0; i<sizeof(ob); i++) {
		if( !userp(ob[i]) ) { 
			ob[i]->set_leader(me);
			ob[i]->kill_ob(me);
			me->fight_ob(ob[i]);
		}
		}
        return notify_fail("觀眾們拼死也不讓你上台。\n");
        }
}
message_vision("$N拼死沖上台去。\n",this_player());
return ::valid_leave(me, dir);
} 
return ::valid_leave(me, dir);
}
