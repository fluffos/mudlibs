// shadown.c 某人的影子

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("巨大的神秘影子", ({ "shadow", "sh" }));
        set("nickname", HIG "血腥的黑暗鳥人" NOR);
        set("long", 
                "你無法確定你看到的是什麼，但是卻有一股寒意自腳底升起\n
                 你還是快離這個可怕的神秘影子遠點吧！\n");
        set("gender", "男性");
        set("age", 100);
        set("attitude", "peaceful");
        set("shen_type", -100000000);
        set("str", 20);
        set("int", 40);
        set("con", 140);
        set("dex", 40);
        
        set("max_qi", 100000000);
        set("max_jing", 50000);
        set("neili", 20000);
        set("max_neili", 20000);
        set("jiali", 3000);
        set("combat_exp", 10000);
        set("score", 12000000);

        set_skill("force", 440);
        set_skill("taiji-shengong", 500);
        set_skill("dodge", 400);
        set_skill("tiyunzong", 400);
        set_skill("unarmed", 350);
        set_skill("taiji-quan", 350);
        set_skill("parry", 300);
        set_skill("sword", 350);
        set_skill("taiji-jian", 250);
        set_skill("blade", 250);
        set_skill("taiji-dao", 250);
        set_skill("taoism", 500);
        set_skill("literate", 500);
        set_skill("liangyi-jian", 250);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "taiji-dao");

        create_family("反機器人協會", 2, "殘忍無比的護會者");
        set("class", "shaman");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: exert_function, "re1" :),
        }) );

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}

