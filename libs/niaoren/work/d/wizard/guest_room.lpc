// /d/wizard/guest_room.c

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "巫師會客室");
	set("long", @LONG
這裡是巫師和玩家交流的地方，如果你有什麼問題需要向巫師請
教，可以在這里留言(post)。不過如果問題牽涉到解謎或者已經在幫
助文件裡有詳細說明，巫師們就不一定會回答。樓上是巫師休息室，
一般玩家到這裡後就上不去了。
LONG );

	set("exits", ([
		"up": __DIR__"wizard_room",
		"southeast": "/d/city/wumiao",
        ]));
	set("no_fight", "1");
	set("no_clean_up", 0);
	create_door("southeast", "竹門", "northwest", DOOR_CLOSED);
	setup();
        call_other("/clone/board/towiz_b", "???");
}

int valid_leave(object me, string dir)
{
        if( dir=="up" && !wizardp(me) )
                return notify_fail("那里只有巫師才能進去。\n");
        return ::valid_leave(me, dir);
}

