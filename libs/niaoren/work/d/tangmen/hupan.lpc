
// moon 2000.12.30

inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_yell(string arg);
void reset();

void create()
{
         set("short", "迴廊碼頭");
         set("long", @LONG
千碧湖(hu)云煙渺渺。湖中不時傳來的笛聲，令你有有股慾望前往打探
。往下一看，湖水碧綠，深不見底，放眼皆碧，有股身在云中不知處的
感想。
LONG );
        set("exits", ([
            "east" : __DIR__"lan6",
        ]));

        set("item_desc", ([
            "hu":"煙淼處有一葉小舟，舟上一個粉衫姑娘正在玩水。喊(yell boat)一聲試試吧。\n",
        ]));

        set("outdoors", "tangmen");
        set("no_clean_up", 0);
        setup();
}
void init()
{
        add_action("do_yell", "yell");
}

void check_trigger()
{
    object room;

    if(!query("exits/enter") ) {
        if( !(room = find_object(__DIR__"xiaozhou")) )
            room = load_object(__DIR__"xiaozhou");
        if( room = find_object(__DIR__"xiaozhou") ) {
            if((int)room->query("yell_trigger")==0 ) {
                room->set("yell_trigger", 1);
                set("exits/enter", __DIR__"xiaozhou");
                room->set("exits/out", __FILE__);
                message("vision", "一葉小舟緩緩地滑過來，一個粉裝少女招手讓你登舟。\n", this_object() );
                remove_call_out("on_board");
                call_out("on_board", 15);
            }
            else
                message("vision", "只聽得湖面上隱隱傳來：“嘻嘻，來了啦……”\n",this_object() );
        }
        else
            message("vision", "ERROR: boat not found\n", this_object() );
    }
    else 
        message("vision", "湖畔一葉小舟上一個粉衫少女細聲嗲到：你要幹什麼呢？\n",
            this_object() );
}


void on_board()
{
    object room;

    if( !query("exits/enter") ) return;

    message("vision", "少女內力一發，小舟快速離岸向湖心滑去。\n",
        this_object() );

    if( room = find_object(__DIR__"xiaozhou") )
    {
        room->delete("exits/out");
        message("vision",
"\n少女說了一聲“坐穩嘍”，聲音極甜極清，令人一聽之下，說不出的舒
適。然後嬌叱一聲，小舟向湖心滑去。\n", room );
    }
    delete("exits/enter");

    remove_call_out("arrive");
    call_out("arrive", 20);
}

void arrive()
{
    object room;
    if( room = find_object(__DIR__"xiaozhou") )
    {
        room->set("exits/out", __DIR__"matou");
message("vision","少女說: “到啦，請上岸吧。”，隨即纖手一揮，把小舟綁好。\n",room);
    }
    remove_call_out("close_passage");
    call_out("close_passage", 20);
}

void close_passage()
{
    object room;
    if( room = find_object(__DIR__"xiaozhou") ) {
        room->delete("exits/out");
        message("vision","少女輕手朝湖面一拍，小舟一滑就到湖中去了。\n", room);
        room->delete("yell_trigger"); 
    }
}

int do_yell(string arg)
{
    string dir;

    if( !arg || arg=="" ) return 0;

    if( arg=="boat" ) arg = "姑娘";
    if( (int)this_player()->query("age") < 16 )
        message_vision("$N提勁喊了一聲：“" + arg + "”\n",
            this_player());
    else if( (int)this_player()->query("neili") > 500 )
        message_vision("$N吸了口氣，一聲“" + arg + "”，聲音中正平和地遠遠傳"
            "了出去。\n", this_player());
    else
        message_vision("$N鼓足中氣，長嘯一聲：“" + arg + "！”\n",
            this_player());
    if( arg=="姑娘")
    {
        check_trigger();
        return 1;
    }
    else
        message_vision("湖面上遠遠傳來一陣回聲：“"+arg+"∼∼∼”\n",this_player());
    return 1;
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"xiaozhou") )
        room->delete("yell_trigger"); 
}
