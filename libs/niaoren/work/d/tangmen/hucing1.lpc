//moon 2001.1.1

inherit ROOM;

string look_briege();
void back(object me);
void init();
int do_jump();
void reset();

void create()
{
        set("short", "回心三折橋");
        set("long",@LONG
玉石欄杆和大理石所砌成的橋(briege)，原本這座橋稱為『輕燕橋』
，因為許多唐門弟子來此鍛鍊輕功，宛如許多燕子在此盤旋。如今，因蕭
秋水的失蹤，唐大小姐將此橋稱為『回心橋』。橋上雖平平無奇，但橋旁的
扶手卻內涵八卦五行之變。
LONG );
        set("outdoors", "tangmen");
        set("exits", ([
            "east"  : __DIR__"hucingting",
            "southup"  : __DIR__"hucing2",
        ]));
        set("item_desc",([
            "briege" : ( :look_briege:),
        ]));
        set("no_clean_up", 0);
        setup();
}

string look_briege()
{
 return "你定睛看來，看似平淡無奇的石橋，扶手卻內涵八卦五行之變。\n"
        "再多看一會兒，你覺得頭暈目眩起來。\n"
        "如果你認為自身技藝不錯，是不是想要跳上去(jump)一試身手呢。\n";
}

void init()
{
        add_action("do_jump", "jump");
}

int do_jump ()
{
    object room;
    object me = this_player () ;

    if( !(room = find_object(__DIR__"muzhuang")) )
            room = load_object(__DIR__"muzhuang");
    if( room = find_object(__DIR__"muzhuang") )
    if((int)room->query_temp("mu_trigger")==1 )
    {
       message_vision("$N一個縱身躍上扶手，身形甚是靈動...猛然$N又躍了回來，真奇怪。", me) ;
       me -> move( __DIR__"muzhuang");
       me -> move( __DIR__"hucing1");
       tell_object(me,"原來是你發現有個人影在扶手上快速移動，眼看就要撞上，急中生智，空中\n"
                      "硬生生提氣回身，轉了回來。");
       return 1 ;
    }
    room->set_temp("mu_trigger", 1);
    message_vision("$N一躍身飛上扶手，真是帥呆酷斃了。\n", me );
    me->move(room) ;
    tell_object(me,"\n你一踏上扶手，輕靈躍動，腳下橫行踏出北斗南罡陣，口中高聲吟唱『俠客行』:\n"
                   "“天地悠悠任我行，豪氣勃發孤身闖.....”\n"  ) ;
    call_out("back", 10 , me );
    room->delete_temp("mu_trigger");
    return 1 ;
}

void back( object me )
{
    int c_exp,c_skill;
    me->move(__DIR__"hucing1");
    message_vision("$N縱身躍回橋來，周圍的人都讚喝一聲。\n",me);
    c_exp=me->query("combat_exp");
    c_skill=me->query_skill("dodge",1);
    me->add("qi",-5);
    me->add("eff_qi",-1);
    if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill<201))
    {
        me->improve_skill("dodge", 2*(int)me->query_skill("dodge", 1));
        tell_object(me,"你的基本輕功進步了!\n");
    }
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"muzhuang") )
        room->delete("mu_trigger");
}

