#include <ansi.h>
// void init();
// void close_gate();
// int do_close(string arg);
// int do_open(string arg);
inherit ROOM;

void create()
{
        set("short", "大門石階");
	set("long", @LONG
這裡是唐家大門(gate)的裡面。旁邊擺著一張桌子，上面放著一本留
言簿，專供來訪遊客留言用。北面一段青石階梯接往寬廣的練武場，
從這裡看去就發現許多人正整齊劃一的練武。
LONG );
	set("exits", ([
		"north" : __DIR__"gongchan1",
	]));
	set("item_desc",([
		"gate"    :"一道四丈來高的黑鐵皮銅環扣大門。\n",
	]));
	set("objects",([
		__DIR__"npc/tanren" : 2,
	]));
//	set("no_clean_up", 0);
	setup();
        "/clone/board/tangmen_b"->foo();
}

void init()
{
	add_action("do_open", "open");
	add_action("do_close", "close");	
}

void close_gate()
{
	object room;

        if(!( room = find_object(__DIR__"tangmen")) )
              room = load_object(__DIR__"tangmen");

	if(objectp(room))
	{
		delete("exits/south");
			message("vision", "唐家子弟上前把大門關了起來。\n", this_object());

	       	room->delete("exits/north");
                        message("vision", "碰地一聲，唐家子弟把大門關上了。\n", room);
	}
}

int do_close(string arg)
{
	if (!query("exits/south"))
		return notify_fail("大門已經是關著的了。\n");

	if (!arg || (arg != "gate" && arg != "south"))
		return notify_fail("你要關什麼啊？\n");

	message_vision("$N朝唐家子弟點了點頭。\n", this_player());
         	remove_call_out("close_gate");

        call_out("close_gate", 2);
     
     return 1;
}

int do_open(string arg)
{
        object room;

	if (query("exits/south"))
		return notify_fail("大門已經是開著了。\n");

	if (!arg || (arg != "gate" && arg != "south"))
		return notify_fail("你要開什麼啊？\n");

	if(!( room = find_object(__DIR__"tangmen")) )
		room = load_object(__DIR__"tangmen");

	if(objectp(room))
	{
            set("exits/south", __DIR__"tangmen");
		message_vision("$N使勁把大門打了開來。\n", this_player());

            room->set("exits/north", __DIR__"damen");
		message("vision", "碰地一聲，裡面有人把大門打開了。\n", room);

            remove_call_out("close_gate");
		call_out("close_gate", 10);
	}
     return 1;
}
