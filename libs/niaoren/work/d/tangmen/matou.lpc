//moon 2000.12.30
inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "湖心碼頭");
        set("long",@LONG
一座檜木橋倚著紅杉梯，傍在湖心亭旁，只見水鴨、鴛鴦四處漫游著，
一陣煙波皓淼，蝴蝶飛舞。湖面正泊著一葉小舟(boat)。
LONG );
        set("outdoors", "tangmen");
        set("exits", ([
            "north"  : __DIR__"hucingting",
        ]));
        set("item_desc", ([
            "boat" : "一葉柳木製成的輕舟。舟上的粉衫少女為唐方姑娘的伺婢，唐姑娘休息時，她就常到
湖上遊玩。你要離開只要進入(enter)小舟即可，她會順便送你一程。\n",
        ]));
        set("no_clean_up", 0);
        setup();
}
void init()
{
       add_action("do_enter", "enter");
}
int do_enter(string arg)
{
       object ob ;
       string dir;
       if( !arg || arg !="boat" ) 
       {
             tell_object(this_player() , "粉衫姑娘微笑說道：你要游泳嗎？\n" ) ;
             return 1 ;
       }
       ob = this_player();
message_vision("船上一個秀美溫柔的粉杉少女看到$N登舟，雙手聚勁輕拍湖面，小舟順勢滑出，
湖心亭漸漸消逝在視野中。\n", ob);
       ob ->move(__DIR__"xiaozhou") ;
       tell_object(ob, HIG "你在湖上飄蕩，四周看不盡的湖光美景。\n" NOR ) ;
       call_out("home", 10 , ob );
       return 1 ;
}
void home( object ob )
{
       tell_object(ob , "小舟終於緩緩地靠岸了。你走下小舟來，心中不禁一陣憂傷，唉，要和少女揮手道別了。\n" ) ;
       ob->move (__DIR__"hupan") ;
}
