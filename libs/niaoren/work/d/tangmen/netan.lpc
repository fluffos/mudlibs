// moon 2000.12.31
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "內堂");
	set("long", @LONG
這是大廳後的內堂，多半遊客或新進弟子只能到這，因唐老
太太有個非常美麗的女兒，許多好逑者前仆後繼的來到，故吩咐
唐猛在此把關。東邊有扇門(door)，一股香氣裊裊地飄了過來。
北面有個大門，兩位黑衣人在此把守著。
LONG );
	set("exits", ([
		"south" : __DIR__"dating",
		"north" : __DIR__"fonhoang",
                "east"  : "/d/tangmen/moon/moonroom", 
	]));
//	set("no_clean_up", 0);
	set("objects",([
		__DIR__"npc/heiren" : 2,
		__DIR__"npc/tang_meng" : 1,
	]));
        create_door("east", MAG"紫福門"NOR, "west", DOOR_CLOSED);
        set("item_desc", ([
            "door":"此門為天山上砍伐下千年紅檜融合海底紫金而製成。\n",
        ]));
	setup();
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "唐門") && dir == "north" &&
		objectp(present("hei ren", environment(me))))
			return notify_fail("黑衣人突然鬼魅般閃身擋在你之前並陰沉說道：閣下請自重，此處為本門禁地，請離開！\n");
	return ::valid_leave(me, dir);
}

