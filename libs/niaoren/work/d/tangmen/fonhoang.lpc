inherit ROOM;

void create()
{
      set("short","鳳凰廳");
      set("long",@LONG
鳳凰廳為唐門私家大廳，雖無華麗裝潢，但樑柱上雕滿鳳凰與月神圖像，多達
十萬幅，美不勝收。通常唐老太太與家人在此共敘話家常，除非是唐門非常熟
識的賓客或親人是不可能進到這的。
LONG);
      set("objects", ([
           __DIR__"npc/puren" : 2,
      ]));
      set("exits",([ /* sizeof() == 1 */
          "east"    : __DIR__"milin1",
          "west"  : __DIR__"milin2",
          "south" : __DIR__"netan",
      ]));
//    set("no_clean_up", 0);
      setup();
      replace_program(ROOM);
}
