#include <ansi.h>
//void init();
//void close_gate();
//int do_open();
string look_gate();
inherit ROOM;

void create()
{
    set("short", "唐家大門");
    set("long", 
"這裡是唐家的大門前，正前方朱牆靛瓦，飛檐翹檁，中央三丈\n"
"來寬，四丈來高的黑鐵皮銅環扣大門(gate)。左右兩之石獅盤據一\n"
"方。上方一匾黃金方框，蒼勁有力的書著"HIY"『唐門』"NOR"二個大字。\n"
);
    set("exits", ([
//      "east" : __DIR__"guangchang1e",
//      "west" : __DIR__"guangchang1w",
    ]));

    set("outdoors", "tangmen");
    set("item_desc",([
        "gate"        :    (: look_gate :),
    ]));
//    set("no_clean_up", 0);
    setup();
}

void init()
{
    add_action("do_knock", "knock");
}

int close_gate()
{
    object room;

    if(!( room = find_object(__DIR__"damen")) )
        room = load_object(__DIR__"damen");
    if(objectp(room))
    {
        delete("exits/north");
message("vision", "弟子說：『你還待在那幹嘛，如果要討飯，去別家吧！』碰地一聲，大門被重重的關上了。\n",
            this_object());
        room->delete("exits/south");
        if (objectp(present("tangren", room)))
            message("vision", "唐門弟子上前把大門關了起來。\n", room);
        else
            message("vision", "一位掃地的傭人上前把大門關了起來。\n", room);
    }
    else message("vision", "ERROR: gate not found(close).\n", room);
}

int do_knock(string arg)
{
    object room;

    if (query("exits/north"))
        return notify_fail("大門已經是開著了。\n");

    if (!arg || (arg != "gate" && arg != "north"))
        return notify_fail("你要敲什麼啊？\n");

    if(!( room = find_object(__DIR__"damen")) )
        room = load_object(__DIR__"damen");
    if(objectp(room))
    {
        set("exits/north", __DIR__"damen");
        message_vision("$N輕輕地用銅環敲了敲門，只聽扣扣聲，"
            "一位唐門弟子應聲打開大門，\n"
            "他用精銳的目光上上下下打量著$N，然後說：『原來是貴客臨門，請進！』\n",
            this_player());
        room->set("exits/south", __FILE__);
        message("vision", "外面傳來一陣敲門聲，唐門弟子應聲上前把大門打開。\n", room);
        remove_call_out("close_gate");
        call_out("close_gate", 10);
    }

    return 1;
}


string look_gate()
{
return "一道四丈來高的黑鐵皮銅環扣大門，想進去你可以用銅環敲敲(knock)看吧\n";
}
