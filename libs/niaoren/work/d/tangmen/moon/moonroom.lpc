// moon 2000.12.25
#include <room.h>
#include <ansi.h>
inherit ROOM;

void check_trigger();
void close_passage();
void reset();
int do_push(string arg);
int do_shout(string arg);

void create()
{
	set("short", "祀堂");
	set("long", @LONG
這里是唐門所祭拜祖先及月神的神堂。也是歷代門主閉關的地方。
一座漢白玉雕約有一人高的月神像(moon)，栩栩如生，精工雕鑿，
彷彿月神下凡，觀之可靜心驅俗。地上擺著幾個蒲團(pu)，兩旁分
立唐門祖先，香煙裊裊，莊嚴肅穆。
LONG );
	set("exits", ([
		"west" : "/d/tangmen/netan",
	]));
        set("no_clean_up", 0);
        create_door("west", MAG"紫福門"NOR, "east", DOOR_CLOSED);
        set("item_desc", ([
            "door":"此門為天山上砍伐下千年紅檜融合海底紫金而製成。\n",
            "moon":"只見潔白無暇的月神像上，有人刻著非常細的字:\n"
	    "\n"
	    "莫忘先祖開拓難，光耀門楣由我扛；\n"
"\n"
            "凡我唐門眾弟子，需由丹田貫百匯；\n"
            "\n"
            "意至氣海蓄內勁，聚神一吼月神睞；\n"
            "\n"
	    "七玄天上月神嘆，八降神招振我郎！\n",
            "pu":"幾個在佛堂中常見的蒲團，看起來有沒什麼。\n",
        ]));
	setup();
}

void init()
{
	add_action("do_push", "push");
	add_action("do_pull", "pull");
	add_action("do_shout", "shout");
}

void check_trigger()
{
	object room;

	if( (int)query("up_trigger")==7
	&&	(int)query("down_trigger")==8
	&&	!query("exits/down") ) {
		message("vision", "月神像忽然發出軋軋的聲音，向一側緩緩移開，"
			"向下露出一個黑洞洞的入口。\n", this_object() );
		set("exits/down", __DIR__"moon");
		if( room = find_object(__DIR__"moon") ) {
		        room->set("exits/up", __FILE__);
		        message("vision", 
"頭頂上的神像忽然發出軋軋的聲音，露出一個光亮亮的洞口。"
"一塊塊踏腳石從牆壁中凸了出來，形成一個向上的階梯。\n",room );
		}
		delete("poem_said");
		delete("up_trigger");
		delete("down_trigger");
		remove_call_out("close_passage");
		call_out("close_passage", 10);
	}
}

void close_passage()
{
	object room;

	if( !query("exits/down") ) return;
	message("vision", "月神像忽然發出軋軋的聲音，緩緩地移回原處，"
		"將向下的洞口蓋住了。\n", this_object() );
	if( room = find_object(__DIR__"moon") ) {
		room->delete("exits/up");
		message("vision", "頭頂上的神像忽然發出軋軋的聲音，"
			"牆上的石塊又緩緩地收了回去，階梯消失了。\n", room );
	}
	delete("exits/down");
}


int do_pull(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="pu" && (int)query("poem_said")==1 ) {
		write("你試著扳動這塊蒲團，發現可以往上抬......\n");
		return 1;
	}
	if( sscanf(arg, "pu %s", dir)==1 && (int)query("poem_said")==1 ) {
		if( dir=="up" ) {
			message_vision("$N將蒲團往上抬...，忽然「喀」一聲蒲團又移回原位。\n",
				this_player());
			add("up_trigger", 1);
			check_trigger();
			return 1;
		} else {
			write("你要將蒲團推向那個方向？\n");
			return 1;
		}
	}
}

int do_push(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="pu" && (int)query("poem_said")==1 ) {
		write("你試著扳動這塊蒲團，發現可以往下壓......\n");
		return 1;
	}
	if( sscanf(arg, "pu %s", dir)==1 && (int)query("poem_said")==1 ) {
		if( dir=="down" ) {
			message_vision("$N將蒲團往下壓...，忽然「喀」一聲蒲團又移回原位。\n",
				this_player());
			add("down_trigger", 1);
			check_trigger();
			return 1;
		} else {
			write("你要將蒲團推向那個方向？\n");
			return 1;
		}
	}
}

int do_shout(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="莫忘先祖開拓難，光耀門楣由我扛；" ) {
                write("不錯，有此情操不失我唐門子弟之威風！\n");
		return 1;
	}

	if( arg=="七玄天上月神嘆，八降神招振我郎！" ) {
		write("只見月神像眼睛發出一道光芒射向蒲團，蒲團猛烈震動起來。\n");
		add("poem_said", 1);
		return 1;
	}
}

void reset()
{
	::reset();
	delete("poem_said");
	delete("up_trigger");
	delete("down_trigger");
}
