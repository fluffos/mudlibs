// tang liang.c 唐亮

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("唐亮", ({ "tang liang", "tang" }));
        set("nickname", HIW "千手千眼" NOR);
        set("long", 
                "他是唐門第一高手，傳說他可以同時發出一千種不同暗器。\n"
                "也可以同時接下一千種暗器。\n"
                "他大約五十有余，雙手總是籠在袖中。\n");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 28);
        set("int", 30);
        set("con", 30);
        set("dex", 32);
        
        set("max_qi", 1000);
        set("max_jing", 3000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("combat_exp", 2000000);
        set("score", 100000);

        set_skill("force", 180);
        set_skill("biyun-xinfa",180);
        set_skill("dodge", 120);
        set_skill("qiulinshiye", 120);
        set_skill("strike", 120);
        set_skill("unarmed",100);
        set_skill("biye-wu", 120);
        set_skill("parry", 120);
        set_skill("throwing", 180);
        set_skill("liuxing-dao", 180);
        set_skill("literate", 100);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","bieye-wu");
        map_skill("parry", "liuxing-dao");
        map_skill("throwing", "liuxing-dao");
        
        create_family("唐門", 6 ,"精益堂堂主");
        set("class", "tangmen");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "strike.bi1" :),
                (: exert_function, "p" :),
		(: exert_function, "re1" :),
        }) );

        setup();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/cloth/male3-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("biyun-xinfa", 1) < 80) {
                command("say 唐門雖然以暗器為主，但還是要輔以內力。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在碧云心法上多下點功夫？");
                return;
        }
        if (ob->query_int() < 25) {
                command("say 唐門歷來注重弟子的文學修為。");
                command("say 本派功夫要能熟練運用，必須能體會其中所含深遠意境，悟性差了是不行的。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("say 唐門武學精深博大，你好好修習，將唐門發揚光大。");
        command("recruit " + ob->query("id"));
}
