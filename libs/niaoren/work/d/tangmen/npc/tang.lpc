// tang.c 唐老太太

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string ask_me();
void create()
{
        set_name("唐老太太", ({ "tang laotai", "tang","laotai" }));
        set("nickname", HIW "霹靂夫人" NOR);
        set("long", 
                "她就是唐門第四代掌門唐老太太，在她的經營下，\n"
                "唐門在江湖中聲名更加顯赫。\n"
                "她大約七十有余，一頭銀發，紅光滿面。\n");
        set("gender", "女性");
        set("age", 75);
        set("attitude", "friendly");
        set("shen_type", 50);
        set("str", 20);
        set("int", 40);
        set("con", 40);
        set("dex", 50);
        
        set("max_qi", 6000);
        set("max_jing", 5000);
        set("neili", 20000);
        set("max_neili", 20000);
        set("jiali", 300);
        set("combat_exp", 12000000);
        set("score", 600000);

        set_skill("force", 400);
        set_skill("biyun-xinfa", 400);
        set_skill("dodge", 400);
        set_skill("qiulinshiye", 400);
        set_skill("strike", 400);
        set_skill("unarmed",390);
        set_skill("biye-wu", 400);
        set_skill("parry", 400);
        set_skill("throwing", 420);
        set_skill("zimu-zhen", 420);
        set_skill("literate", 400);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "zimu-zhen");
        map_skill("throwing", "zimu-zhen");
        
        create_family("唐門", 4, "掌門");
        set("class", "tangmen");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "throwing.zi1" :),
                (: perform_action, "throwing.zi2" :),
                (: perform_action, "strike.bi1" :),
                (: exert_function, "p" :),
		(: exert_function, "re1" :),
        }) );
        set("inquiry", 
                ([
                        "大鬧唐門" : (: ask_me :)
                ]));

        setup();
        carry_object("/clone/money/zimuzhen")->wield();
        carry_object("/clone/cloth/female2-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("biyun-xinfa", 1) < 300) {
                command("say 唐門雖然以暗器為主，但還是要輔以內力，方可傷敵。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在碧云心法上多下點火侯？");
                return;
        }
        if (ob->query_int() < 35) {
                command("say 唐門歷來注重弟子的後天文學修為。");
                command("say 本派武技要能熟練運用，必須能體會其中所含深遠意境，悟性差了是不行的。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("chat 哇哈哈哈哈！！！！");
        command("chat 唐門又出了一個優秀的人才，唐家祖先有靈啊，哈哈哈哈！");
        command("recruit " + ob->query("id"));
        this_player()->set("title",YEL"唐門門主親傳弟子"NOR);
}
string ask_me()
{object me;
me =this_player();
        if (me->query_temp("marks/鬧")){
                command("say 你想幫唐方那個死丫頭打探消息嗎？看我不劈了你");
                command("hit " + me->query("id"));
                return "看來老太婆非得教訓你一下不可。\n";}
       if (me->query_temp("marks/蕭")){
        command("angry " + this_player()->query("id"));
        command("say 難道你想像蕭秋水一樣來個大鬧唐門嗎？\n");
        command("heng " + this_player()->query("id"));
        command("say 唐方那個死丫頭！\n");
        this_player()->set_temp("marks/鬧",1);
        me->delete_temp("marks/蕭");
        return"蕭秋水已被我關起來了！她別想再見到這個混小子了！\n";
                                                        }
else{   
        return "瓜娃子，你說啥子？老太婆聽不懂哦！\n";
    }


}
