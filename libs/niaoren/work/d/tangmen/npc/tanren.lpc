#include <ansi.h>

inherit NPC;

void create()
{
	set_name("唐門子弟", ({
		"tang ren",
		"ren",
		"tang",
	}));
	set("long",
		"他是一位略帶稚氣的少年，動作敏捷，馬步沉穩。他手持鋼\n"
                "鏢，身穿一襲黑色勁裝，似乎武藝已有小成。\n"
	);

	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 15);
	set("shen_type", 20);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 30);
	set("max_qi", 300);
	set("neili", 200);
	set("max_neili", 200);
	set("jiaji", 50);
	set("combat_exp", 30000);
	set("score", 0);

        set_skill("force", 50);
        set_skill("biyun-xinfa",50);
        set_skill("dodge", 50);
        set_skill("qiulinshiye", 50);
        set_skill("strike", 50);
        set_skill("unarmed",50);
        set_skill("biye-wu", 50);
        set_skill("parry", 50);
        set_skill("throwing", 60);
        set_skill("zhuihun-biao", 60);
        set_skill("literate", 100);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "zhuihun-biao");
        map_skill("throwing", "zhuihun-biao");
        set("chat_chance", 5);
        set("chat_msg", ({
                "唐門子弟：呼∼喝....呀！\n"
                "運氣丹田，馬步沉穩，出掌有力，標無虛發，喝！喝！\n",
        }) );
	setup();
        carry_object("/clone/money/gangbiao")->wield();
        carry_object("/clone/cloth/male3-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}
