#include <ansi.h>

inherit NPC;

void create()
{
	set_name("唐門漢子", ({
		"tang ren",
		"ren",
		"tang",
	}));
	set("long",
		"他是一位內力深沉的漢子，目光內斂，筋肉盤紮。他手持鋼\n"
                "鏢，身穿一襲黑色勁裝，為唐門的守衛。\n"
	);

	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 36);
	set("shen_type", 100);
	set("str", 35);
	set("int", 35);
	set("con", 35);
	set("dex", 40);
	set("max_qi", 800);
	set("neili", 500);
	set("max_neili", 500);
	set("jiaji", 90);
	set("combat_exp", 900000);
	set("score", 60);

        set_skill("force", 100);
        set_skill("biyun-xinfa",100);
        set_skill("dodge", 100);
        set_skill("qiulinshiye", 100);
        set_skill("strike", 100);
        set_skill("unarmed",100);
        set_skill("biye-wu", 100);
        set_skill("parry", 100);
        set_skill("throwing", 120);
        set_skill("zhuihun-biao", 120);
        set_skill("literate", 150);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "zhuihun-biao");
        map_skill("throwing", "zhuihun-biao");

	setup();
        carry_object("/clone/money/gangbiao")->wield();
        carry_object("/clone/cloth/male3-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}
