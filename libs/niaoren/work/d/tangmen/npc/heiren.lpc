// moon 2000.12.30

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("黑衣人", ({
		"hei ren",
		"ren",
		"hei",
	}));
	set("long",
		"他身著一襲黑色蒙面貼身衣，目光冷峻。這些高手都是唐老太太親自挑選訓練。\n"
                "下手狠辣，且非常忠心，甚至不惜以死效忠唐門。他手把玩著子母飛針，看來擅\n"
             	"使用這類的武器。\n"
                 );

	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 30);
	set("shen_type", 500);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 40);
	set("max_qi", 1500);
	set("neili", 600);
	set("max_neili", 600);
	set("jiaji", 90);
	set("combat_exp", 1100000);
	set("score", 10);

        set_skill("force", 130);
        set_skill("biyun-xinfa",130);
        set_skill("dodge", 150);
        set_skill("qiulinshiye", 150);
        set_skill("strike", 130);
        set_skill("unarmed",130);
        set_skill("biye-wu", 130);
        set_skill("parry", 130);
        set_skill("throwing", 130);
        set_skill("zhuihun-biao", 130);
        set_skill("zimu-zhen", 130);
        set_skill("literate", 200);

        map_skill("force", "biyun-xinfa");
        map_skill("dodge", "qiulinshiye");
        map_skill("strike", "biye-wu");
        map_skill("unarmed","biye-wu");
        map_skill("parry", "zimu-zhen");
        map_skill("throwing", "zimu-zhen");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "throwing.zi1" :),
                (: perform_action, "throwing.zi2" :),
                (: perform_action, "strike.bi1" :),
                (: exert_function, "p" :),
		(: exert_function, "re1" :),
        }) );

	setup();
        carry_object("/d/tangmen/obj/zimuzhen")->wield();
        carry_object("/clone/cloth/male3-cloth")->wear();
        carry_object("/clone/cloth/male-shoe")->wear();
}
