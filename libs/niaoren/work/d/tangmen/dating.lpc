// moon 2000.12.29
inherit ROOM;

void create()
{
	set("short", "大廳");
	set("long", @LONG
這裡是唐家接待外賓的大廳，兩旁立著精悍漢子，中央一把太師椅
上坐著一個老太婆。地面氣派花崗石舖面，四周牆面掛滿詩畫，與廳內一
股肅殺之氣形成強烈對比。往前看，一股檀香裊裊地飄了過來。
LONG );
	set("exits", ([
                "west" : __DIR__"lan21",
                "east" : __DIR__"lan1",
                "south" : __DIR__"gongchan2",
               "north" : __DIR__"netan",
	]));
//	set("no_clean_up", 0);
	set("objects",([
		__DIR__"npc/tang" : 1,
		__DIR__"npc/tangren" : 6,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "唐門") && dir == "east","west" &&
		objectp(present("tangren", environment(me))))
			return notify_fail("漢子喝道：你不是唐門子弟，不得進入本門私地。\n");
	return ::valid_leave(me, dir);
}

