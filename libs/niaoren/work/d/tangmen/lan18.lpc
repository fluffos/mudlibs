//moon 2000.12.30
inherit ROOM;

void create()
{
  set("short","濱湖西迴廊");
  set("long",@LONG
這是一條非常幽美的迴廊，環抱唐門中最有名的"千碧湖"，柱子和欄杆是
用的紅杉木制成，上面的雕刻美不勝收，雕工之巧，不知是出自哪位大師
之手。上面掛著整串的花燈，映著湖面，加上湖面上白煙渺渺，一番詩情
畫意，彷彿置身於人間仙境。湖中更不時傳來一陣陣笛聲。
LONG );
  set("exits",([
      "south" : __DIR__"lan19",
      "north" : __DIR__"lan17",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
