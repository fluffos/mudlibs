inherit ROOM;

void create()
{
	set("short", "五大夫松");
	set("long", @LONG
相傳當年秦始皇上泰山，來到這里下起雨來，他就到兩棵松樹
底下避雨，結果沒淋著。因此，他就封這兩棵松樹為「五大夫」。
后來不知從哪里來了一塊巨大的飛來石把兩棵松樹砸死了。后人再
在旁補種五株松樹。在不遠處還有一個御帳坪，據說就是秦始皇當
年結帳的位置。從這里再往山上走便會到達十八盤的入口。
LONG );
	set("exits", ([
		"northup" : __DIR__"longmen",
		"southdown" : __DIR__"ertian",
	]));
	set("no_clean_up", 0);
	set("outdoors", "taishan");
	setup();
}

