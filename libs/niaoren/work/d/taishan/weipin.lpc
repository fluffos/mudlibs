inherit ROOM;

void create()
{
	set("short", "圍屏山");
	set("long", @LONG
這里是泰山的其中一座山峰。山的東面有一個虎頭崖，其形狀
有如一頭伏虎。南面有避風崖，崖上大大地刻著「振衣岡」三字于
上面。北邊則有北斗壇。從這里往東走，便可到達伺奉泰山之神碧
霞元君的碧霞祠。
LONG );
	set("exits", ([
		"westdown" : __DIR__"tianjie",
		"east" : __DIR__"bixia",
	]));
	set("no_clean_up", 0);
	set("outdoors", "taishan");
	setup();
}

