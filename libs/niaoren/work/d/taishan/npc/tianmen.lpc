// tianmen.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("天門道人", ({ "tianmen daoren", "daoren", "tianmen" }) );
        set("gender", "男性");
        set("title", HIG"泰山派第十三代掌門"NOR);
        set("class", "taoist");
        set("age", 45);
        set("attitude", "peaceful");
        set("str", 50);
        set("con", 50);
        set("dex", 50);
        set("int", 50);

        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 100);
        set("max_qi",5000);
        set("max_jing",5000);
        set("combat_exp", 3000000);
        set("shen_type", 1);

        set_skill("force", 350);
        set_skill("sword", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("axe", 350);
        set_skill("literate", 350);
        set_skill("unarmed", 350);
        set_skill("ding-force", 350);
        set_skill("duanyun-fu", 350);
        set_skill("taishan-sword", 350);
        set_skill("lingxu-bu", 350);

        map_skill("sword", "taishan-sword");
        map_skill("force", "ding-force");
        map_skill("axe", "duanyun-fu");
        map_skill("whip", "duanyun-bian");
        map_skill("parry", "taishan-sword");
        map_skill("dodge", "lingxu-bu");

        create_family("泰山派", 13, "掌門");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 200) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("chat 嘿嘿嘿嘿嘿！！！！");
        command("chat 我泰山派又多一個人才了。");
        command("recruit " + ob->query("id"));
}
