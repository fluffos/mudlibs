// yujizi.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("玉璣子", ({ "yuji zi", "zi", "yuji" }) );
        set("gender", "男性");
        set("class", "taoist");
        set("age", 45);
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 3500);
        set("max_neili", 3500);
        set("jiali", 100);
        set("max_qi",3500);
        set("max_jing",3500);
        set("combat_exp", 1500000);
        set("shen_type", 1);

        set_skill("force", 250);
        set_skill("sword", 250);
        set_skill("dodge", 250);
        set_skill("parry", 250);
        set_skill("axe", 250);
        set_skill("literate", 250);
        set_skill("unarmed", 250);
        set_skill("ding-force", 250);
        set_skill("duanyun-fu", 250);
        set_skill("taishan-sword", 250);
        set_skill("lingxu-bu", 250);

        map_skill("sword", "taishan-sword");
        map_skill("force", "ding-force");
        map_skill("axe", "duanyun-fu");
        map_skill("parry", "taishan-sword");
        map_skill("dodge", "lingxu-bu");

        create_family("泰山派", 12, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}


void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 150) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
}