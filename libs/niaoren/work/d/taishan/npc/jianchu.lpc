// jianchu.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("建除道人", ({ "jianchu daoren", "daoren", "jianchu" }) );
        set("gender", "男性");
        set("class", "taoist");
        set("age", 25);
        set("attitude", "peaceful");
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);

        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 50);
        set("max_qi",2000);
        set("max_jing",2000);
        set("combat_exp", 500000);
        set("shen_type", 1);

        set_skill("force", 120);
        set_skill("sword", 120);
        set_skill("dodge", 120);
        set_skill("parry", 120);
        set_skill("literate", 120);
        set_skill("unarmed", 120);
        set_skill("ding-force", 120);
        set_skill("taishan-sword", 120);
        set_skill("lingxu-bu", 120);

        map_skill("sword", "taishan-sword");
        map_skill("force", "ding-force");
        map_skill("parry", "taishan-sword");
        map_skill("dodge", "lingxu-bu");

        create_family("泰山派", 14, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}


void attempt_apprentice(object ob)
{
        if (ob->query_str() < 22) {
                command("say 我泰山派武功講求臂力。");
                command("say 要能達到劍法爐火純青之境，臂力是半點也馬虎不得。");
                command("say " + RANK_D->query_respect(ob) + "的臂力不夠，還是請回吧。");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
        ob->set("class", "taoist");
}