inherit ROOM;

void create()
{
	set("short", "一天門");
	set("long", @LONG
從岱宗坊上山大約走四里，便來到一天門。北面有一座天階坊，過
了此坊便進入了登泰山的盤道。南面有一座更衣亭，士大夫們及其
隨從，都會在這里換上輕便的服裝，才繼續登山。從一天門向北眺
望，南天門與十八盤在云霧明滅間或隱或現，登泰山的人到此已有
觀止之嘆。附近有一牌坊，上寫「孔子登臨處」，相傳為「孔子過
泰山側」的故事發生的地方。
LONG );
	set("exits", ([
		"northup" : __DIR__"doumo",
		"southdown" : __DIR__"baihe",
	]));
	set("objects",([
		__DIR__"npc/dao-ke" : 1,
	]));
//	set("no_clean_up", 0);
	set("outdoors", "taishan");
	setup();
}

