inherit ROOM;

void create()
{
        set("short", "伊犁");
        set("long", @LONG
這里是一座維吾爾族聚居的小鎮。鎮上人來人往，十分熱鬧。只是
他們說的話你聽不懂。鎮西有家小店鋪，西北邊人聲鼎沸，好像在舉行
什么比賽。東面有家院落，院門口有棵大樹。北邊是一家馬廄。
LONG );
        set("exits", ([ 
            "west"      : __DIR__"store",
            "east"      : __DIR__"house",
            "north"     : __DIR__"majiu",
            "northwest" : __DIR__"saimachang",
            "southeast" : __DIR__"shanjiao",
        ]));
        set("objects", ([
                __DIR__"npc/woman": 2 ]) );
//        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
}

