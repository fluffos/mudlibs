// Room: /d/xingxiu/xxroad4.c

inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
山勢在這里漸漸變得平緩，你已經可以聽見西邊山澗底的水聲。東面有一
個山洞。
LONG );
        set("exits", ([
            "south" : __DIR__"xxroad4",
            "enter" : __DIR__"cangku",
            "north" : __DIR__"xxroad6",
        ]));
        set("objects", ([
            CLASS_D("xingxiu")+"/chuchen" : 1,
        ]) );
//        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");
        setup();
}

int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ((!myfam || myfam["family_name"] != "星宿派") && dir != "south"
		 && (present("chuchen zi", environment(me)))) {
		say("出塵子一言不發，閃身攔在"+me->name()+"面前。\n");
                return notify_fail("出塵子一言不發，閃身攔在你面前。\n");
        }
        return ::valid_leave(me, dir);
}

