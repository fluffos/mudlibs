inherit ROOM;

void create()
{
        set("short", "絲綢之路");
        set("long", @LONG
這是一條中原和西域之間的商道。南面連綿的祁連山脈在陽光的照射下
好像是一條玉帶。東邊是中原，西面則通往西域。
LONG );
        set("outdoors", "xingxiuhai");
        set("exits", ([
            "east" : __DIR__"silk1",
            "west" : "/d/mingjiao/westroad1",
            "northwest" : __DIR__"silk3",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

