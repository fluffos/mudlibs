inherit ROOM;

void create()
{
        set("short", "天山山路");
        set("long", @LONG
這里是天山東麓，山風從山上吹來，你冷得瑟瑟發抖。路邊是一片針葉林。
西邊望去，頂峰遙遙可見。南邊有個黑    的山洞(cave)。
LONG );
        set("exits", ([
            "westup" : __DIR__"tianroad6",
            "eastdown" : __DIR__"tianroad4",
            "enter" : __DIR__"cave",
	    "north" : "/d/npc/m_weapon/liandaoshi",
        ]));
        set("objects", ([
               __DIR__"npc/caiyaoren" : 1, 
        ]));
        set("item_desc", ([
              "cave" : "黑    的山洞里飄出一陣陰風，嚇得你直打哆嗦。\n"
        ]) );
//        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");
        setup();
}

