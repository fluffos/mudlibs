// Xiaoyao.c:  the sleeping room for Xingxiu
// Jay May 13, 96

inherit ROOM;

void create()
{
        set("short", "逍遙洞");
        set("long", @LONG
這是一個粗糙的石洞，里面鋪了几張臭哄哄的草墊子。墊子旁邊
是一些破酒罐子。洞壁(wall)上有些字跡。
LONG );
        set_light(0);
        set("sleep_room", "1");
        set("no_fight", "1");
        set("exits", ([
                "out" : __DIR__"xxh6",
        ]));
        set("item_desc", ([
                "wall" : "星宿淫賊人人得而株之！\n",
        ]) );
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

