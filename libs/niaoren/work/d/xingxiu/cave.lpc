// room: /d/xingxiu/cave.c
// Jay 3/18/96

inherit ROOM;

int do_use(string arg);
int do_zuan(string arg);

void create()
{
        set("short", "山洞");
        set("long", @LONG
這個山洞里伸手不見五指，只有出口處透進一絲光線。
LONG );
        set("exits", ([
            "out" : __DIR__"tianroad5",
        ]));

        set("no_clean_up", 0);

        setup();
}

void init()
{
        add_action("do_use", "use");
        add_action("do_zuan", "zuan");
}

int do_use(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;
        if (!present("fire", me))  return 0;
        if( arg=="fire" ) {
             write(
             "你點燃了火折，發現西面石壁上有一道裂縫，似乎可以鑽(zuan)出去。\n"
             );
             this_player()->set_temp("marks/鑽", 1);
             return 1;
       }
}

int do_zuan(string arg)
{
        object me;
        me = this_player();

        if (me->query_temp("marks/鑽") ) {
            message("vision", me->name() + "滋溜一下不知從什么地方鑽出去了。\n",
                    environment(me), ({me}) );
            me->move("/d/xingxiu/tianroad5");
            message("vision", me->name() + "從石縫里鑽了出來。\n",
                    environment(me), ({me}) );
            this_player()->set_temp("marks/鑽", 0);

            return 1;
        }
        else {
            write("你想往哪兒鑽?!\n");
            return 1;
        }
}

