// room: /d/xingxiu/btshan
// Jay 3/27/96

inherit ROOM;

void create()
{
        set("short", "白駝山");
        set("long", @LONG
這是傳說中神秘的白駝山。遠遠望去，兩座白沙堆積形成的山峰好像
一只駱駝的脊背。一座山門立在你的眼前。山門后一條小路通向一座山腰
上的山庄。這里是「西毒」歐陽鋒的秘宅，一般人闖進去非死既傷。
LONG
        );
        set("exits", ([ 
            "east" : __DIR__"shamo4",
            "west" : __DIR__"btshan1",
        ]));
        set("objects", ([ 
            __DIR__"npc/ke" : 1,
            __DIR__"npc/snake" : 3,
         ]) );

        set("no_clean_up", 0);

        setup();
}
int valid_leave(object me, string dir)
{
   if (dir =="west" ) {
        if (objectp(present("snake", environment(me))))
                return notify_fail("蛇陣不過，如何上山?\n");

        if (objectp(present("ouyang ke", environment(me))))
                return notify_fail(
"歐陽克抖開折扇，一伸手擋住了你的去路：叔父正在練功，請改日再來。\n");
        
       
        me->move(__DIR__"btshan1");
        write("歐陽鋒弓身伏拳，口內發出「咕咕」的叫聲，雙目圓睜。\n");
        write("猛然間歐陽鋒雙腿一蹬，兩掌平伸向你打來。\n");
        write("這一掌正中你的前胸，你感覺五臟六腑都像被震碎了一樣。\n");
        write("你平飛出了白駝山庄。\n");
        me->move(__DIR__"btshan");
        me->set("qi",10);
        me->unconcious();
        return 1;
   }
   return ::valid_leave(me, dir);
}

