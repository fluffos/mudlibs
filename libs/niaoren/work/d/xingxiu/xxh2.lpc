#include <room.h>

inherit ROOM;

void create()
{
        set("short", "星宿海");
        set("long", @LONG
這里是星宿海邊。說是海，其實是片湖泊和沼澤，地形十分險惡。
這里左右兩廂通向星宿海的深處，南邊是星宿派總舵──日月洞。
洞口立著一個牌子(paizi)。
LONG );
        set("exits", ([
             "north" : __DIR__"riyuedong",
             "south" : __DIR__"xxh1",
             "northeast" : __DIR__"xxh3",
             "northwest" : __DIR__"xxh4",
        ]));

        set("valid_startroom",1);
        set("item_desc", ([
                "paizi" : "星宿海福地，日月洞洞天。\n",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");
        setup();
        "/clone/board/xingxiu_b"->foo();
}

