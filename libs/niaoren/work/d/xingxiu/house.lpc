// /d/xingxiu/house.c
// Jay 3/26/96

inherit ROOM;

void create()
{
        set("short", "巴依家院");
        set("long", @LONG
這是一個巴依家的庭院。門口大樹的樹蔭投到院子里，讓人覺得很涼快。
院子東面是巴依的客廳，西邊就是小鎮大街。
LONG
        );
        set("exits", ([ 
            "west" : __DIR__"beijiang",
            "east" : __DIR__"house1",
        ]));
        set("objects", ([
                __DIR__"npc/kid": 1,
                __DIR__"npc/bayi": 1
        ]) );
//        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
}

int valid_leave(object me, string dir)
{
        if (!wizardp(me) && objectp(present("bayi", environment(me))) && 
                dir == "east")
                return notify_fail("巴依說: 我把阿凡提關在我的客廳里了，誰也不許進去。\n");
        return ::valid_leave(me, dir);
}

