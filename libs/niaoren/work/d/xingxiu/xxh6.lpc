inherit ROOM;

void create()
{
        set("short", "石道");
        set("long", @LONG
這是星宿海邊有人用石頭鋪成的一條小道，周圍彌漫著沼澤的瘴氣和一
種說不出來的香味。路邊有個石洞。
LONG );
        set("exits", ([ 
            "east" : __DIR__"xxh4",
            "enter" : __DIR__"xiaoyao",
        ]));
        set("objects", ([ 
            __DIR__"npc/caihua" : 1,
        ]) );
//        set("no_clean_up", 0);
        setup();
}
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

   if (dir =="enter" ) {
	if (present("caihua zi", environment(me))) {
            if (!myfam || myfam["family_name"] != "星宿派") 
		return notify_fail("采花子擋住了你：我的小妞可不是給你們邪派弟子准備的！\n");
            if  (me->query("gender")=="無性") 
                return notify_fail("采花子擋住了你，一臉譏笑：您這小身板還想玩妞？別開玩笑了。\n");
            if (!(int)this_player()->query_temp("marks/花"))
                return notify_fail("采花子擋住了你：喂，你總該意思意思吧？\n");
        }
	return 1;
   }
   return ::valid_leave(me, dir);
}

