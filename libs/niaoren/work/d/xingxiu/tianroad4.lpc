// room: /d/xingxiu/tianroad4.c
// Jay 3/18/96

inherit ROOM;

void init();
int do_jump(string arg);

void create()
{
        set("short", "天山山路");
        set("long", @LONG
這里是天山東麓，山風從山上吹來，你冷得瑟瑟發抖。路邊是一片針葉
林。石壁上盛開著一朵潔白的天山雪蓮，一個采藥人正在采藥。東面一條深
澗(valley)擋住了下山的路。
LONG );
        set("exits", ([
            "westup" : __DIR__"tianroad5"
        ]));
        set("objects", ([
                __DIR__"npc/caiyaoren"  : 1,
                __DIR__"npc/obj/xuelian" : 1
        ]));

        set("item_desc", ([
        "valley" : "深澗有三丈多寬，不過因為這邊地勢高，應該不難跳(jump)過去。\n"
        ]) );
//        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();
}

void init()
{
        add_action("do_jump", "jump");
}

int do_jump(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;
        if( arg=="valley" ) {
               message("vision", me->name() + 
                          "一提氣，雙足點地跳過了深澗。\n",
               environment(me), ({me}) );
               me->move("/d/xingxiu/tianroad3");
               message("vision", me->name() + 
                          "從深澗上面跳了下來。\n",
               environment(me), ({me}) );
               return 1;
       }
}
