inherit ROOM;

void create()
{
        set("short", "嘉峪關");
        set("long", @LONG
這是長城最西的關隘。歲月滄桑，仍掩不住它的風采。群山環抱之下，更顯它
的雄渾。由于西域安定，久無戰事，邊關守軍已大為減少。一條大道向東延伸通向
中原。出關向西，便是著名的“絲綢之路”。
LONG );
        set("outdoors", "xingxiuhai");
        set("exits", ([
                "eastup" : __DIR__"xxroad3.lpc",
                "west" : __DIR__"silk1.lpc",
        ]));
        set("objects", ([
                __DIR__"npc/wujiang" : 1,
                __DIR__"npc/bing" : 2,
        ]));
//        set("no_clean_up", 0);
        setup();
}

