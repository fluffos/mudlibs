inherit ROOM;

void create()
{
	set("short", "懸空寺南樓");
	set("long", @LONG
這里是懸空寺的南門樓，也是南碑亭。懸空寺于陡崖上鑿石穴
插懸梁為基，樓宇間棧橋相連。全寺面東座西，南北危樓對望，斷
崖分斷，很是艱險。
LONG
	);
	set("exits", ([
		"north"   : __DIR__"zhanqiao",
		"southup" : __DIR__"zhandao",
