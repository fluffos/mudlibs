// jing.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("定靜師太", ({ "dingjing shitai", "shitai", "dingjing" }) );
        set("gender", "女性");
        set("class", "bonze");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 25);
        set("str", 80);
        set("con", 80);
        set("dex", 80);
        set("int", 80);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 200);
        set("max_qi",4000);
        set("max_jing",4000);
        set("combat_exp", 1500000);
        set("shen_type", 1);

        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("unarmed", 200);
        set_skill("literate", 200);
        set_skill("sword", 200);
        set_skill("buddhism", 200);
        set_skill("strike", 200);
        set_skill("yan-shuangfei", 200);
        set_skill("shenzhao-shengong", 200);
        set_skill("sanhuajuding", 200);
        set_skill("changquan", 200);
        set_skill("hengshan-jian", 200);

        map_skill("force", "shenzhao-shengong");
        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("unarmed", "changquan");
        map_skill("strike", "sanhuajuding");
        map_skill("dodge", "yan-shuangfei");

        create_family("恆山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 80) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
}