// xian.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("定閑師太", ({ "dingxian shitai", "shitai", "dingxian" }) );
        set("gender", "女性");
        set("title", HIB"恆山派第十三代掌門"NOR);
        set("class", "bonze");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 20);
        set("str", 80);
        set("con", 80);
        set("dex", 80);
        set("int", 80);

        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 200);
        set("max_qi",5000);
        set("max_jing",5000);
        set("combat_exp", 3000000);
        set("shen_type", 1);

        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("literate", 350);
        set_skill("sword", 350);
        set_skill("buddhism", 350);
        set_skill("strike", 350);
        set_skill("yan-shuangfei", 350);
        set_skill("shenzhao-shengong", 350);
        set_skill("sanhuajuding", 350);
        set_skill("changquan", 350);
        set_skill("hengshan-jian", 350);

        map_skill("force", "shenzhao-shengong");
        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("unarmed", "changquan");
        map_skill("strike", "sanhuajuding");
        map_skill("dodge", "yan-shuangfei");

        create_family("恆山派", 13, "掌門");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}


void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 160) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("chat* smile");
        command("chat 我恆山派以後就靠你了。");
        command("recruit " + ob->query("id"));
}