// lin.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("儀琳", ({ "yi lin", "lin" }) );
        set("gender", "女性");
        set("class", "bonze");
        set("age", 16);
        set("attitude", "peaceful");
        set("per", 30);
        set("str", 80);
        set("con", 80);
        set("dex", 80);
        set("int", 80);

        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("max_qi", 3000);
        set("max_jing", 3000);
        set("combat_exp", 1000000);
        set("shen_type", 1);

        set_skill("force", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("unarmed", 100);
        set_skill("literate", 100);
        set_skill("sword", 100);
        set_skill("buddhism", 100);
        set_skill("strike", 100);
        set_skill("yan-shuangfei", 100);
        set_skill("shenzhao-shengong", 100);
        set_skill("sanhuajuding", 100);
        set_skill("changquan", 100);
        set_skill("hengshan-jian", 100);

        map_skill("force", "shenzhao-shengong");
        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("unarmed", "changquan");
        map_skill("strike", "sanhuajuding");
        map_skill("dodge", "yan-shuangfei");

        create_family("恆山派", 14, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if (ob->query_con() < 22) {
                command("say 我恆山派武功講求根骨。");
                command("say 要能達到內外兼修之境，根骨是低不得的。");
                command("say " + RANK_D->query_respect(ob) + "的根骨不佳，還是請回吧。");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "bonze")
        ob->set("class", "bonze");
}