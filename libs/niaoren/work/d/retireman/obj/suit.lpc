// suit.c 大禮服
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
        set_name(HIB"退伍禮服"NOR, ({ "suit" }) );
        set("long", "這是一件國軍退伍人員專用的禮服，參加退伍慶典時的重要服飾。\n");
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "steel");
                set("value", 50);
                set("armor_prop/armor",100);
        }
        setup();
}
