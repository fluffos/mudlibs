// ling.c 退伍令

#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("絕世好賤", ({ "jian", "ji" }));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是一張傳說中的絕世好劍，不是賤人還真是拿不到這個。\n");
                set("value", 10000000);
                set("material", "steel");
                set("wield_msg", "$N大喊：「我很賤」之後，拿出一把$n向你炫耀一番。\n");
                set("unwield_msg", "$N小心翼翼的將手中的$n收起來。\n");
        }
        init_sword(925);
        setup();
}

int query_autoload()
{
   return 1;
}
