//yitianjian.c
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
    set_name(MAG"絕"HIG"世"HIC"好"HIM"賤"NOR, ({ "beach-sword" }) );
    set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        	set("unit", "柄");
        	set("value", 50000);
//        	set("no_drop", "1");
        	set("material", "iron");
                set("long", "這是一口用寒絲羽竹打造而成的絕世好賤。看起來晶瑩碧綠，透著絲絲的寒意。一種庄嚴，溫和，凜然而不可侵犯的氣息讓人不敢有一絲褻瀆之意, 它已經返朴歸真，成為真正的上古神兵. 上面用小篆刻著一行小字：哇沙米造予。\n");
                set("wield_msg","$N緩緩舉起右手，突然金光一閃讓你張不開眼睛，等你回神時$n已在$N手中了。\n");
                set("unwield_msg", "$N緩緩舉起$n，突然爆發出七彩光芒，光芒斂去時$n已經消失在$N手中。\n");

	}
        init_sword(500);
	setup();
}
int query_autoload()
{
   return 1;
}
