#include <ansi.h>

inherit NPC;

void create()
{
        set_name("哇沙米", ({"wasami"}));
        set("gender", "男性");
        set("age", 25);
        set("long",
                "我是發呆王!!\n"
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("qi", 2162);
        set("max_qi", 2162);
        set("jing", 220);
        set("max_jing", 220);
        set("neili", 1756);
        set("max_neili", 1756);
        set("jiali", 40);

        set("combat_exp", 7669403);
        set("score", 0);

        set_skill("force", 280);
        set_skill("sword", 400);
        set_skill("dodge", 425);
        set_skill("parry", 422);
        set_skill("unarmed",425);
        set_skill("literate",380);
        set_skill("liangyi-jian",400);
        set_skill("taiji-dao",230);
        set_skill("taiji-quan",425);
        set_skill("taiji-jian",425);
        set_skill("taoism",380);
        set_skill("taiji-shengong",280);
        set_skill("tianyu-qijian",151);
        set_skill("tiyunzong",425);


        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-quan");
        map_skill("unarmed", "taiji-quan");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family(" 鳥人神教", 2, HIB"世界"HIC"最冷"HIM"北極熊"NOR" 「"HIG"混"HIR"吃"HIC"等"HIM"死"NOR"」");

        set("env/wimpy", 50);
        setup();

        carry_object("/d/retireman/obj/beach-sword")->wield();
        carry_object("/d/retireman/obj/kingcloth")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");
tell_object(ob," 哇沙米說道：你說什麼 ? 想要東西 ?? 要東西不要找我..有bug也不要找我..我什麼都不會！\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "哇沙米說道：該死的leos..每次都搞笑..可是又一點都不好笑....真是冷。\n");
                        break;
                case 1:
                        say( "哇沙米悄悄地說道：我是海軍516梯的，在89年12月15日退伍 ！\n");
                        break;
                case 2:
                        say( "哇沙米笑咪咪地說道：你說什麼?覺得我很帥?!想要我的簽名!沒問題..馬上給你。要不要電話啊 ?\n");
                        break;
        }
}


