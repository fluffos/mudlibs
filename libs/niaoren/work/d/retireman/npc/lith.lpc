// ozzzyi.c 阿笨

// 2000.11 by Leos

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("阿笨", ({"ozzyi", "oz"}));
        set("gender", "男性");
        set("age", 25);
        set("long",
                "阿笨開始攻擊你!!\n
                 阿笨開始攻擊你!!\n
                 .
                 .
                 .
你眼前一黑,接著麼都不知道了..... "
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("qi", 2162);
        set("max_qi", 2162);
        set("jing", 220);
        set("max_jing", 220);
        set("neili", 1756);
        set("max_neili", 1756);
        set("jiali", 40);

        set("combat_exp", 7669403);
        set("score", 0);

        set_skill("force", 280);
        set_skill("sword", 400);
        set_skill("dodge", 425);
        set_skill("parry", 422);
        set_skill("unarmed",425);
        set_skill("literate",380);
        set_skill("liangyi-jian",400);
        set_skill("taiji-dao",230);
        set_skill("taiji-quan",425);
        set_skill("taiji-jian",425);
        set_skill("taoism",380);
        set_skill("taiji-shengong",280);
        set_skill("tianyu-qijian",151);
        set_skill("tiyunzong",425);


        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-quan");
        map_skill("unarmed", "taiji-quan");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family("古墓派", 4, HIR"義勇民兵"HIM"| 肉~蒲~團 |"NOR"--右腿護法");

        set("env/wimpy", 50);
        setup();

        carry_object("/d/retireman/obj/ling")->wield();
        carry_object("/d/retireman/obj/suit")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");
tell_object(ob,"阿笨一臉正氣凜然的說道：給你一個諫言：不要問mud為你作了什麼，要自問自已為mud作了什麼！\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "阿笨說道： 什麼？你問我是什麼時候退伍的？真是的，我是空軍飛虎682梯的，在89年11月18日退伍啦。\n");
                        break;
                case 1:
                        say( "阿笨悄悄地說道： 老兵八字輕,別不信邪！\n");
                        break;
                case 2:
                        say( "阿笨笑咪咪地說道：嘿嘿，你是不是羨慕我退伍了啊！\n");
                        break;
        }
}


