#include <ansi.h>

inherit NPC;

void create()
{
        set_name("影", ({"lsy"}));
        set("gender", "男性");
        set("age", 25);
        set("long",
                "影開始攻擊你!!\n
                 影開始攻擊你!!\n
                 .
                 .
                 .
你眼前一黑,接著麼都不知道了..... "
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("qi", 500);
        set("max_qi", 500);
        set("jing", 360);
        set("max_jing", 360);
        set("neili", 1300);
        set("max_neili", 1300);
        set("jiali", 550);

        set("combat_exp", 212211);
        set("score", 2431);
        set("shen",  17800);

        set_skill("force", 140);
        set_skill("sword", 120);
        set_skill("dodge", 140);
        set_skill("parry", 122);
        set_skill("unarmed",140);
        set_skill("literate",310);
        set_skill("blade",110);
        set_skill("buddhism",120);
        set_skill("checking",120);
        set_skill("dagou-bang",120);
        set_skill("begging",120);
        set_skill("feixing-shu",110);
        set_skill("hammer",110);
        set_skill("hand",110);
        set_skill("liuyang-zhang",110);
        set_skill("pixie-sword",110);
        set_skill("huntian-qigong",110);
        set_skill("xianglong-zhang",111);
        set_skill("xiaoyaoyou",125);
        set_skill("wuyun-jianfa",125);
        set_skill("taoism",125);
        set_skill("staff",125);


        map_skill("force", "huntian-qigong");
        map_skill("sword", "pixie-sword");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "wuyun-jianfa");
        map_skill("unarmed", "wuyun-jianfa");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family("丐幫",18, "九袋弟子"BLINK MAG"被ㄠ死的"HIC"上兵"NOR);

        set("env/wimpy", 50);
        setup();

        carry_object("/d/retireman/obj/ling")->wield();
        carry_object("/d/retireman/obj/suit")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");

tell_object(ob,"影難過說道：退伍了..想到不能再上來看看！覺得粉捨不得..畢竟,鳥人世界是我軍中唯一見過的mud..\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "影說道：我是空軍飛虎683梯的，在89年12月28日退伍啦。\n");
                        break;
                case 1:

                        say( "影說道：希望鳥人和眾巫師們能繼續加油..！\n");
                        break;
                case 2:

                        say( "影不捨地說道：能陪軍中的苦難弟兄們度過一段難忘的時光是最難能可貴的~~\n");
                        break;
        }
}


