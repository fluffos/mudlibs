// herk.c 藍海

// 2001.01 by URD

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("西門吹雪", ({"landy", "oz"}));
        set("gender", "男性");
        set("age", 31);
        set("long",
                "西門吹雪原為武當弟子，後投入明教，現為明教教主親傳弟子。\n
                 年少時得遇機緣，修得絕技黯然銷魂掌...\n
                 仗著一手太極劍，不知有多少亡魂死於他的劍下。\n\n
                 西門吹雪面無表情，眼光不時的往你飄過來，似乎想跟你較量較量\n "
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("qi", 1431);
        set("max_qi", 1431);
        set("jing", 315);
        set("max_jing", 315);
        set("neili", 2900);
        set("max_neili", 2900);
        set("jingli", 383);

        set("combat_exp", 2000132);
        set("env/wimpy", 50);
        set("score", 0);

        set_skill("force", 200);
        set_skill("sword", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("unarmed",200);
        set_skill("literate",350);
        set_skill("taiji-shengong",200);
        set_skill("jiuyang",37);
        set_skill("wuyun-jianfa",200);
        set_skill("hubo",150);
        set_skill("taoism",200);
        set_skill("anranxiaohun-zhang",200);
        set_skill("taiji-quan",200);
        set_skill("tiyunzong",200);


        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-quan");
        map_skill("unarmed", "anranxiaohun-zhang");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.an1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family("明教教主親傳弟子", 4, HIM" 武 當 七 俠 "BLINK" 劍 聖 "NOR);

        setup();

        carry_object("/d/retireman/obj/ling")->wield();
        carry_object("/d/retireman/obj/suit")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");

tell_object(ob,"西門吹雪笑了笑，說道：退伍了...可是我還沒有千人斬，真是可惜！\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "西門吹雪對著你冷冷一笑，說道：「我希望能殺一千個人，你願意幫我達成願望嗎？」。\n");
                        break;
                case 1:
                        say( "西門吹雪悄悄地說道：「其實我也不是很強啦，殺了三百多個人而已啦！」\n");
                        break;
                case 2:
                        say( "西門吹雪對你挑釁的說道：「想跟我對打？先去跟張三豐打贏了再來！」！\n");
                        break;
        }
}
