// 小火

// 2000.11 by Leos

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("小火", ({"isotonic"}));
        set("gender", "男性");
        set("age", 20);
        set("long",
                "小火開始攻擊你!!\n
                 小火開始攻擊你!!\n
                 小火開始攻擊你!!\n
                 .
                 .
                 .
                 .
                 .
                 .
                 .
你眼前一黑,接著麼都不知道了..... "
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("str", 23);
        set("con", 26);
        set("int", 44);
        set("dex", 22);
        set("qi", 324);
        set("max_qi", 324);
        set("jing", 220);
        set("max_jing", 220);
        set("neili", 300);
        set("max_neili", 300);
        set("jiali", 0);
        set("shen", 713);
        set("combat_exp", 69037);
        set("score", 2552);

        set_skill("force", 69);
        set_skill("sword", 54);
        set_skill("dodge", 30);
        set_skill("parry", 20);
        set_skill("unarmed",21);
        set_skill("literate",243);
        set_skill("taiji-jian",64);
        set_skill("taiji-quan",31);
        set_skill("taiji-shengong",39);
        set_skill("taoism",99);
        set_skill("zhengqijue",5);
        set_skill("tiyunzong",81);
        set_skill("jiuyang",46);

        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-quan");
        map_skill("unarmed", "taiji-quan");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family("武當派", 4, HIR"天乾物燥"HIM" 小心火燭 "NOR );

        set("env/wimpy", 50);
        setup();

        carry_object("/d/retireman/obj/ling")->wield();
        carry_object("/d/retireman/obj/suit")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");
tell_object(ob,"小火說道：呵呵，鳥人~~~你的生意越來越好了哦！\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "小火說道： 我是海軍516梯的，在89年12月15日退伍啦。\n");
                        break;
                case 1:
                        say( "小火說道： 台中是個好地方。希望大家有空多到台中走走！\n");
                        break;
                case 2:
                        say( "小火笑咪咪地說道：祝所有人身體健康、天天快樂！\n");
                        break;
        }
}


