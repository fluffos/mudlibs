// herk.c 藍海

// 2001.01 by URD

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("藍海", ({"herk", "oz"}));
        set("gender", "男性");
        set("age", 38);
        set("long",
                "藍海，是鳥人神教的開山大弟子。\n
                 投入古墓派後沒多久就退伍了...\n
                 行俠仗義，好客疏財，人見人愛唷。\n\n
                 藍海正在笑瞇瞇的看著你^^\n "
        );
        set("attitude", "friendly");

        set("spi", 27);
        set("qi", 1036);
        set("max_qi", 1036);
        set("jing", 382);
        set("max_jing", 382);
        set("neili", 3240);
        set("max_neili", 3240);
        set("jingli", 650);

        set("combat_exp", 1719387);
        set("env/wimpy", 50);
        set("score", 515);

        set_skill("force", 249);
        set_skill("sword", 249);
        set_skill("dodge", 250);
        set_skill("parry", 250);
        set_skill("unarmed",249);
        set_skill("literate",300);
        set_skill("god-sword",249);
        set_skill("jiuyang",259);
        set_skill("strike",249);
        set_skill("jiuyin-baiguzhao",219);
        set_skill("taoism",193);
        set_skill("beiming-shengong",199);
        set_skill("tianyu-qijian",248);
        set_skill("tiyunzong",249);


        map_skill("force", "jiuyang");
        map_skill("sword", "god-sword");
        map_skill("dodge", "wizard-dodge");
        map_skill("parry", "jiuyin-baiguzhao");
        map_skill("unarmed", "jiuyin-baiguzhao");

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "sword.go1" :),
                (: perform_action, "sword.go2" :),
                (: perform_action, "sword.go3" :),
                (: perform_action, "unarmed.ji1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );


        create_family("古墓派", 4, HIB"藍 藍"BLU" 深"CYN" 海"NOR);

        setup();

        carry_object("/d/retireman/obj/ling")->wield();
        carry_object("/d/retireman/obj/suit")->wear();

}


void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");

tell_object(ob,"藍海堅定的說道：我決對沒有禿頭，是曠世那死傢伙亂說的！那死曠世的單位一定是在 謠指部...\n\n");
        }
        switch( random(3) ) {
                case 0:
                        say( "藍海唱道： 愛陷入一片藍藍深海，在情深處搖擺∼。\n");
                        break;
                case 1:
                        say( "藍海悄悄地說道： 鳥人師傅每次都會偷偷留招，像露鳥術就沒有教我！\n");
                        break;
                case 2:
                        say( "藍海笑瞇瞇地說道：嘿嘿，沒想到有MUD的日子過得這麼快，一下就退伍了！\n");
                        break;
        }
}
