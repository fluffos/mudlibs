// maoniu.c   牛
// by secret

inherit NPC;

void create()
{
        set_name("  牛", ({ "mao niu", "niu" ,"yak"}) );
	set("race", "野獸");
	set("age", 5);
        set("long", "一只身強體壯的  牛，全身長著長毛，似乎在覓食。\n");
	set("attitude", "peaceful");
        set("str",60);
        set("max_qi",1000);
        set("qi",1000);
        set("max_jing",1000);
        set("jing",1000);
	
	set("limbs", ({ "頭部", "身體", "前腳", "后腳", "尾巴" }) );
        set("verbs", ({ "knock", "hoof" }) );

        set("combat_exp", 50000);

        set_temp("apply/attack", 200);
        set_temp("apply/defense", 500);
        set_temp("apply/damage", 20);
        set_temp("apply/armor", 100);

	setup();
}

