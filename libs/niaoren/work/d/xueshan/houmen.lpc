inherit ROOM;

void create()
{
        set("short","后門");
        set("long",@LONG
這是雪山寺的后門。一片破落而蕭索模樣。喇嘛們香
火也足，花用也大。這是后門，雖然未免寒酸，可也總可
以掖著。
LONG );
        set("exits",([
            "south" : __DIR__"houyuan",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

