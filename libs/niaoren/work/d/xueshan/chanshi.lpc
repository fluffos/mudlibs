inherit ROOM;

void create()
{
        set("short","禪室");
        set("long",@LONG
這里是僧人門參禪打坐的地方。側壁一列禪床讓人看
了就想到該想的事。
LONG );
        set("no_fight",1);
        set("sleep_room",1);
        set("no_steal",1);
        set("exits",([
                "southwest" : __DIR__"dating",
        ]));
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
