inherit ROOM;

void create()
{
        set("short","聖湖");
        set("long",@LONG
眼前就是著名的聖湖，碧藍的湖面倒影著藍天和白云，
浩淼的水面讓人心曠神怡。遠處金碧輝煌的雪山寺清晰可
見，再遠處是几座延綿的大雪山，其中最高大的是神山，
相傳山中有神仙居住。雪山中融化的雪水都匯入湖中。
LONG );
        set("resource/water",1);
        set("exits",([
                "south" : __DIR__"tulu3",
                "east"  : __DIR__"hubian1",
		"west"  : "/d/npc/m_weapon/liangunshi",
        ]));
        set("no_clean_up", 0);
        setup();
}

