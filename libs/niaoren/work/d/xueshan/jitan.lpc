//  jitan.c 祭壇

inherit ROOM;

void create()
{
        set("short","雪山祭壇");
        set("long",@LONG
這里是雪山寺雪山祭壇，中間一個高台，青石砌就。
周圍擺滿了木柴和酥油，旁邊一個盛水的顱缽擱著擺著一
只法鈴。一些痛苦和可憐的亡靈可以在這里獲得超度。
LONG );
        set("outdoors","xueshan");
        set("no_fight","1");
        set("exits",([
                "north" : __DIR__"chang",
        ]));
        set("objects",([
                __DIR__"npc/x_lama": 2,
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

