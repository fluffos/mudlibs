inherit ROOM;

void create()
{
        set("short","小院");
        set("long",@LONG
這里是寺內的小院，收拾的相當干淨利索。來來往往
的香客和喇嘛，一邊在暗示著雪山寺香火之盛，一邊也好
象在表示喇嘛的口福也真不壞。因為北邊就是個廚房。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "west" : __DIR__"guangchang",
                "north" : __DIR__"chufang",
        ]));
        set("no_clean_up", 0);
        setup();
}

