inherit ROOM;

void create()
{
        set("short","土路");
        set("long",@LONG
這是一條不起眼的土路，卻是連接雪山寺與中原的必
經之路。西邊點點的炊煙依稀可見。往北可以通往聲震西
域的雪山寺。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "east" : __DIR__"tulu1",
                "north" : __DIR__"tulu3",
                "west" : __DIR__"kedian",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

