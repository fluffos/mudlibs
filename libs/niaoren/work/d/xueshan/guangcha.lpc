inherit ROOM;

void create()
{
        set("short","廣場");
        set("long",@LONG
這里是雪山寺內的廣場。廣場石埕鋪就, 黃土墊砌, 平整而堅實。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "east" : __DIR__"xiaoyuan",
                "west" : __DIR__"chang",
                "north" : __DIR__"dadian",
                "south" : __DIR__"shanmen",
        ]));
        set("no_clean_up", 0);
        setup();
}


