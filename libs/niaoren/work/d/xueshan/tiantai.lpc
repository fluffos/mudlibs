inherit ROOM;

void create()
{
        set("short","天台");
        set("long",@LONG
這里是雪山寺的高處。北邊可見雄偉的大雪山，南邊
可以俯瞰美麗如鏡的聖湖。
LONG );
        set("exits",([
                "west" : __DIR__"neidian",
        ]));
        set("no_clean_up", 0);
        setup();
}

