inherit ROOM;

void create()
{
        set("short","土路");
        set("long",@LONG
這是一條不起眼的土路，不寬卻也不窄，松散的浮塵
顯露出來往行商的頻繁。它是連接雪山寺與中原的必經之
路。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "east" : __DIR__"caoyuan",
                "west" : __DIR__"tulu2",
        ]));
        set("no_clean_up", 0);
        setup();
}

