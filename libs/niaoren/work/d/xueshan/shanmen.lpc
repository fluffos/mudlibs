inherit ROOM;

void create()
{
        set("short","雪山寺山門");
        set("long",@LONG
這里是大輪寺的山門，門前是絡繹不絕的進香朝聖的
信徒，有的甚至來自烏絲藏西南的波絲。山門(gate)前站
了個手持法器的葛倫布在維持秩序，東方是一條青石板鋪
成的山路。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "north"    : __DIR__"guangchang",
                "eastdown" : "/d/xuedao/nroad4",
        ]));
        set("item_desc",([
                "gate" : "兩扇厚厚的銅色大門，非合數人之力，是難以推動的。\n",
        ]));
        set("objects",([
                CLASS_D("xueshan")+"/gelunbu": 1,
                "/d/wudang/npc/guest": 2,
        ]));
        setup();
}
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ((!myfam || myfam["family_name"] != "雪山寺") && dir == "north" &&
                objectp(present("gelunbu", environment(me))))
           return notify_fail("葛倫布擋住你說：你准備用什麼供奉我們佛爺呀？\n");

        return ::valid_leave(me, dir);
}

