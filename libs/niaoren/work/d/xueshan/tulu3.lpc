inherit ROOM;

void create()
{
        set("short","土路");
        set("long",@LONG
這是一條不起眼的土路。塵埃泛起的遠方，北邊波光
瀲灩的一大片幽藍水光處，就是著名的聖湖。
LONG );
        set("outdoors","xueshan");
        set("exits",([
                "south" : __DIR__"tulu2",
                "north" : __DIR__"shenghu",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

