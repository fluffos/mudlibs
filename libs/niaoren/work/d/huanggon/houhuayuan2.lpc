// houhuayuan2.c 后花苑

inherit ROOM;

void create()
{
        set("short", "后花苑");
        set("long", @LONG
這里是皇上賞花的后花苑.平日里皇上時常會來這兒,和貴妃娘娘
一起賞花品茗.所以,這兒是平常太監,侍衛不能來的.這里的宮女多是
心靈手巧,精通花道的.放眼四顧,滿目皆是似錦繁花,你仔細分辨,竟
然品目齊全,大凡你想得的,甚至你想都不敢想的,這里都有了.你不經
有些妒疾起皇帝老兒來.
LONG
);
        set("outdoors", "huanggon");
        set("exits", ([
                "east" : __DIR__"houhuayuan",
                "west" : __DIR__"majuan.lpc",
        ]) );
        set("objects", ([
                "/d/huanggon/npc/gonnv" : 2,
        ]) );
        setup();
        replace_program(ROOM);
}
