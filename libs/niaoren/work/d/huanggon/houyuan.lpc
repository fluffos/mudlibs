inherit ROOM;

void create()
{
	set("short", "清和殿后院");
	set("long", @LONG
這里是清和殿后院。院里種著些青菜。牆角有一口水井(well)。
站在水井邊往下看，只覺深不見底，井壁上滿是滑溜溜的青苔。一個
  轆吊著一根長繩，繩端系著一個木桶。東邊是一條走廊，通往清和
殿。
LONG );
        set("outdoors", "huanggon");
	set("resource/water", 1);
	set("exits", ([
		"east" : "/d/huanggon/zoulang1",
	]));

	set("no_clean_up", 0);
	setup();
}

