
inherit ROOM;

string look_writing();

void create()
{
	set("short", "走廊");
	set("long", @LONG
這是一條走廊。房頂一側支在西面的高牆上，另一側則與東
側的清和殿屋頂相連。彩梁畫棟，連頂棚也用彩漆繪滿了各種飛
天的圖形，每幅精美的雕畫似乎都在訴說一個娓娓動人的故事。
往西通往后院，南北都有房間。
LONG );
	set("exits", ([
		"west" : __DIR__"houyuan",
		"east" : __DIR__"qihedian",
		"south" : __DIR__"fang1",
		"north" : __DIR__"fang2",
	]));
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
