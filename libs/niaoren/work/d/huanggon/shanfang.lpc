//shanfang.c 御膳房

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "御膳房");
        set("long", @LONG
皇宮里的膳食與平常民間的自然不同,這里就是負責皇上用膳的御
膳房.你不禁想把這里的美味都嘗一遍,可別忘了這可是皇宮啊.
LONG
        );
        set("objects", ([
        "/d/huanggon/obj/yuchi" : 2,
 "/d/huanggon/obj/nverhong" : 1,
        ]));
        setup();
}
