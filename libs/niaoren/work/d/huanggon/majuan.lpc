// majuan.c.c 馬圈

inherit ROOM;

void create()
{
        set("short", "馬圈");
        set("long", @LONG
皇家馬圈,自然是好馬云集.一排排齊整的馬廄,一匹匹英挺
高頭俊馬,讓你不由想起大草原上萬馬奔騰的壯偉景象.
LONG
        );
        set("exits", ([
                "east" : __DIR__"houhuayuan2",
        ]) );
        set("objects", ([
                "/d/city2/npc/yucongma" : 1,
        ]) );
        setup();
        replace_program(ROOM);
}
