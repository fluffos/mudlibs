// tinglang2.c 廳廊

inherit ROOM;

void create()
{
        set("short", "廳廊");
        set("long", @LONG
飛檐雕欄的廳廊.兩邊是喜人的花草,站在這兒,隱約聽得到后宮里
嬪妃宮女們嬉笑的聲音,宮里的人來來往往的,顯得井井有條,看來宮里
的規矩挺嚴的.
LONG
        );
        set("exits", ([
        "north" : __DIR__"tinglang1",
        "south" : __DIR__"taihedai",
        "west" : __DIR__"tinglang3",
        ]));
        set("outdoors", "huangon");
        setup();
        replace_program(ROOM);
}
