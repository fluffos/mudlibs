
inherit ROOM;

void create()
{
    set("short", "密室");
    set("long", @LONG
這是個陰暗的密室，牆上的油燈發出昏暗的黃光。
LONG );
    set("exits", ([
        "up" : __DIR__"huayuan",
    ]));
    set("objects",([
          "/d/xiaoyao/npc/obj/zhemei_book1" : 1,
          "/d/xiaoyao/npc/obj/zhemei_book2" : 1,
          "/d/xiaoyao/npc/obj/liuyang_book1" : 1,
          "/d/xiaoyao/npc/obj/liuyang_book2" : 1,
          "/d/xiaoyao/npc/obj/qijianpu" : 1,
    ]));
    set("no_clean_up", 0);
    setup();
}

int valid_leave(object me, string dir)
{
    me=this_player();
   if ((dir=="up") &&
      (!present("zhangfa tu1", this_object())) ||
      (!present("zhangfa tu2", this_object())) ||
      (!present("shoufa tu1", this_object())) ||
      (!present("shoufa tu2", this_object())) ||
      (!present("pu", this_object())) )
          return notify_fail("這的秘輯不見了你怎能就走呢！\n");

    return ::valid_leave(me, dir);
}
