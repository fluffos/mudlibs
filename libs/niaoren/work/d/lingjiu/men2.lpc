//ROOM men1.c

inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "書房大門");
        set("long",@LONG
這是書房門口，只看見大門兩旁貼著一副對聯(duilian)，抬頭上望。
門楣上一塊大匾(bian)上寫著几個大字。
LONG );
        set("outdoors", "lingjiu");
        set("exits", ([
		"east" : __DIR__"shufang",
		"west" : __DIR__"changl12",
        ]));
	set("objects",([
      CLASS_D("lingjiu")+"/zhujian" : 1,
	]));
	set("item_desc", ([
	    "duilian" : "行到水窮處，坐看云起時.\n",
	    "bian" : HIC "任我逍遙\n" NOR,
        ]));
//        set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
	if (  (dir == "east")
	   && ((string)me->query("family/family_name") != "靈鷲宮")
	   && objectp(present("zhu jian", environment(me))) )
	 return notify_fail
		("竹劍伸手攔住你，說道：“對不起，本門重地，請回！”\n");
	return ::valid_leave(me, dir);
}
