//room: ya.c
inherit ROOM;

void create()
{
  set("short","斷魂崖");
  set("long",@LONG
這是通向[靈鷲宮]的必經之路，一條小道蜿蜒曲折地通向縹緲峰頂。
路的右側是一條陡峭的山崖，一陣山風吹過，你似乎聽見從下面傳來几聲
慘號，你心中一凜，不禁加快腳步趕緊離開這里。
LONG );
  set("outdoors", "lingjiu");
  set("exits",([
      "westup"   : __DIR__"yan",
      "eastdown" : __DIR__"shanjiao",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
