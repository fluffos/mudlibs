//zhang.c
inherit NPC;

void create()
{
        set_name("獐", ({ "zhang" }) );
        set("race", "野獸");
        set("age", 2);
        set("long", "一頭可愛的獐，它的血是大補之物。\n");
        set("attitude", "peaceful");
 
        set("str", 30);
        set("cor", 26);

        set("limbs", ({ "頭部", "身體", "爪子", "尾巴" }) );
        set("verbs", ({ "bite" }) );
 
        set("combat_exp", 3000);

        set_temp("apply/attack", 50);
        set_temp("apply/damage", 10);
	set_temp("apply/defence",30);
	set_temp("apply/armor",10);

	setup();
}

void die()
{
	message_vision("$N兩腿一蹬，$N死了。\n", this_object());
	destruct(this_object());
}
