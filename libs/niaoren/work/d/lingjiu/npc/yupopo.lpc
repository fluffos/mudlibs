// NPC yupopo.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("余婆婆", ({ "yu popo", "yu", "popo" }));
	set("long",
	    "她是「靈鷲宮」九天九部中昊天部的首領.\n"+
	    "她跟隨童姥多年, 出生入死,飽經風霜.\n");
	set("title", "昊天部首領");
	set("gender", "女性");
	set("age", 60);
	set("shen_type",1);
	set("attitude", "peaceful");

	set("str", 20);
	set("int", 25);
	set("con", 30);
	set("dex", 30);

	set("qi", 2000);
	set("max_qi", 2000);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 1000);
	set("max_neili", 1000);
	set("jiali", 50);

	set("combat_exp", 100000);
	set("score", 10000);
	set_skill("force", 100);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("hand",100);
	set_skill("strike", 100);
        set_skill("sword",100);

        set_skill("tianyu-qijian",100);
	set_skill("zhemei-shou",100);
	set_skill("liuyang-zhang",100);
	set_skill("yueying-wubu",100);
	set_skill("bahuang-gong", 100);

	map_skill("force", "bahuang-gong");
	map_skill("strike","liuyang-zhang");
	map_skill("dodge", "yueying-wubu");
	map_skill("unarmed", "liuyang-zhang");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "liuyang-zhang");
   	map_skill("sword", "tianyu-qijian");

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: perform_action, "strike.li2" :),
		(: perform_action, "strike.li2" :),
		(: perform_action, "hand.zh1" :),
		(: perform_action, "hand.zh1" :),
		(: perform_action, "sword.ti1" :),
		(: perform_action, "sword.ti1" :),
		(: exert_function, "re1" :),
		(: exert_function, "p" :),
            }) );

	create_family("靈鷲宮",2,"弟子");
	setup();
        carry_object("/d/lingjiu/obj/qingyi")->wear();
        carry_object("/d/lingjiu/obj/doupeng")->wear();
	carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/food/jiudai");
	add_money("silver",40);
}
