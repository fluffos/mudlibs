//room: xianchou.c
inherit ROOM;

void create()
{
  set("short","仙愁門");
  set("long",@LONG
這里就快到縹緲峰絕頂了，越往上走，山勢越高，繚繞在你身邊的白
霧愈來愈濃，往南則是下山的路。沿著山道沒走几步，在你眼前出現一個
石坊，上書『仙愁門』三個大字，蓋因上山之艱辛吧。
LONG );
  set("outdoors", "lingjiu");
  set("exits",([
      "eastup" : __DIR__"dadao1",
      "southdown" : __DIR__"jian",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
