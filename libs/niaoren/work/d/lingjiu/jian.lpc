//room: jian.c

inherit ROOM;

void init();
int do_zou(string);

void create()
{
  set("short","百丈澗");
  set("long",@LONG
山道到此突然消失，在你面前是一條山澗，山澗之中云霧繚繞，你根
本無法看清對面。一條鐵索(tiesuo)深入云中，旁邊有一塊石碑(bei)。
LONG );
  set("outdoors", "lingjiu");
  set("exits",([
      "southdown" : __DIR__"yan",
  ]));
  set("objects",([
      CLASS_D("lingjiu")+"/tbhao" : 1,
  ]));
  set("item_desc",([
      "bei" : "『靈鷲宮』重地，擅入者死！\n" ,
      "tiesuo" : "這是通往對面的“接天橋”，你也許可以走過(zou)去。\n" ,
  ]));
//  set("no_clean_up", 0);
  setup();
}

void init()
{
	add_action("do_zou", "zou");
}

int do_zou(string arg)
{
	object me=this_player(), room;

	if(!arg || arg!="tiesuo")
		return notify_fail("你要走什么？\n");

	if(!( room = find_object(__DIR__"xianchou")) )
		room = load_object(__DIR__"xianchou");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'xianchou.c' \n");
	message_vision("$N踩上鐵索，飄然而去。\n",me);
//       　message("vision","你只見一個身影飄然而來。\n", room);
        me->move(room);
        return 1;
}
