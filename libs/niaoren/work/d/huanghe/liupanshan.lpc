#include <room.h>

inherit ROOM;
void create()
{
	set("short", "六盤山");
	set("long", @LONG
這是一座不太高的小山。山頂望去，瓦藍的天空(sky)飄著几朵淡淡
的白云。一群大雁發出「嘎嘎」的叫聲，從頭上飛過。西面山下長城的殘
垣斷壁依稀可辨。路旁有一處懸崖之上刻著首詞(poem)。北邊山下是永登
城，東面山下是一處小村庄。
LONG );
	set("exits", ([
		"northdown" : __DIR__"yongdeng",
		"eastdown"  : "/d/village/wexit",
	]));
	set("item_desc", ([
		"poem" : "
崖壁上刻著一首清平樂：

  何  今  紅  六  屈  不  望  天
  時  日  旗  盤  指  到  斷  高
  縛  長  漫  山  行  長  南  云
  得  纓  卷  上  程  城  飛  淡
  蒼  在  西  高  二  非  雁
  龍  手  風  峰  萬  好
                      漢

你現在是好漢了！
\n",
	]));
	set("no_clean_up", 0);
	set("outdoors", "huanghe");
	setup();
}

