inherit ROOM;

void create()
{
	set("short", "營盤水");
	set("long", @LONG
這里是當年蒙恬修長城時駐軍的地方，蒙恬治軍有方，當年他親
自帶人在駐地挖了好几口甜水井，使士卒們不用喝又苦又澀的咸水，
后來此地的百姓們叫這里為營盤水，稱這里的井為“蒙恬井”。
LONG );
	set("exits", ([
