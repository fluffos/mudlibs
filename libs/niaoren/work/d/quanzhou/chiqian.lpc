#include <ansi.h>;
inherit ROOM;

void create()
{
	set("short", "赤嵌城");
	set("long", @LONG
此地為台灣府駐所。台灣開化未久，國姓爺東征，收
復此城，圍困紅毛鬼達兩年之久，終致金甌無缺。
    城外海港，有舟(zhou)船來往澎湖。
LONG );
	set("exits", ([
                "eastup" : __DIR__"riyuetang",
                "north"  : __DIR__"jilong",
                "south"  : __DIR__"dagou",
	]));
	set("item_desc", ([
                "zhou" : "一條兵舟，往返澎湖的交通兵船。\n",
	]));
	set("objects", ([
		__DIR__"npc/hongmao": 1,
	]));
//	set("no_clean_up", 0);
	set("outdoors", "quanzhou");
	setup();
//	replace_program(ROOM);
}

void init()
{
    add_action("do_enter", "enter");
}
int do_enter ( string arg )
{
    object ob ;
    string dir;
    if( !arg || arg !="zhou" ) 
       {
         tell_object(this_player() , "你要 enter 哪兒？\n" ) ;
         return 1 ;
       }
    ob = this_player () ;
    message_vision("水兵一見有人上船，忙叫了一聲：開船嘍！\n", ob);
    message_vision("水兵升起帆，船就向西方航行。\n", ob);
    ob ->move(__DIR__"dahai") ;
    tell_object(ob, BLU "你在海上航行了很久很久.......\n" NOR ) ;
    call_out("tpenghu", 10 , ob );
    return 1 ;
}
void tpenghu(object ob )
{
    tell_object(ob , "兵舟終于抵達了海峽中一個大島。你走下船來。\n" ) ;
    ob->move (__DIR__"penghu") ;
}
