#include <room.h>
inherit ROOM;

void create()
{
	set("short", "青龍會前庭");
	set("long", @LONG
這是一片密密的竹林。這里人跡罕至，惟聞足底叩擊路面，有僧
敲木魚聲﹔微風吹拂竹葉，又如簌簌禪唱。令人塵心為之一滌，
真是絕佳的禪修所在。
LONG );
	set("exits", ([
		"west"  : __DIR__"qinglong1",
		"south" : __DIR__"qinglong2",
		"north" : __DIR__"qinglong3",
		"east"  : __DIR__"bamboo",
	]));
//	set("objects",([
//		__DIR__"npc/tang" : 1,
//	]));
	create_door("east","木門","west",DOOR_CLOSED);
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

