#include <room.h>
inherit ROOM;

void create()
{
	set("short", "竹林小道");
	set("long", @LONG
這是一條卵石鋪成的小道，曲曲折折地通向前方。兩邊是
密密的竹林。這里人跡罕至，惟聞足底叩擊路面，微風吹拂竹
葉，令人塵心為之一滌。但除了幽靜之外，卻隱隱有股殺氣彌
漫在這竹林之中，不禁讓人心里一緊。
LONG );
	set("exits", ([
		"west"  : __DIR__"qinglong",
//		"south" : __DIR__"zhulin1",
		"north" : __DIR__"nanmen",
	]));

	set("outdoors", "quanzhou");
	create_door("west","木門","east",DOOR_CLOSED);
	set("no_clean_up", 0);
	setup();
}

