inherit ROOM;

void reset();
int valid_leave();

void create()
{
        set("short", "拱豬王宮");
        set("long", @LONG
這是一座豪華的王宮，殿內金壁輝煌，金磚漫地，到處是金子做的
豬食盆，里面放滿了豬王愛吃的豬食──小白菜、木瓜、豆子、小青草、
胡蘿卜、ｅｔｃ．。
LONG
        );

        set("exits", ([
                "sl" : "/d/shaolin/guangchang1",
                "wn" : "/d/wudang/sanqingdian",
                "xx" : "/d/xingxiu/xxh2",
                "gb" : "/d/city/gbxiaowu",
                "kd" : "/d/city/kedian",
                "qz" : "/d/quanzhou/zhongxin",
        ]));
        set("objects", ([
            __DIR__"obj/cleansword" : 1,
            __DIR__"obj/marz" : 1,
            __DIR__"obj/rover" : 1,
            __DIR__"obj/xiang" : 1,
	]));

        set("valid_startroom",1);

        set("outdoors", "quanzhou");
        setup();
}

void init()
{
        add_action("do_leave", "leave");
}

int valid_leave(object me, string dir)
{
        if ((string)me->query("name")!="拱豬王"){
                write("豬王一把揪住你的衣領說：“慢著，你太瘦，還不能出欄！”\n");
		return 0;
	}
        return ::valid_leave(me, dir);
}

int do_leave()
{
        object me = this_player();
        if(me)
                me->move("/d/wizard/wizard_room");
        return 0;
}
