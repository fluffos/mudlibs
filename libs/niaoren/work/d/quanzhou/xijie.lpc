inherit ROOM;

void create()
{
	set("short", "西街");
	set("long", @LONG
這里是泉州的西大街，北面有一所破敗的宅子。西面有一家雜貨鋪，
專賣女人家用的東西，男人不可以進去。
LONG );

	set("exits", ([
                "east" : __DIR__"zhongxin",
                "north" : __DIR__"laozhai",
                "west" : __DIR__"zahuopu",
	]));
	set("no_clean_up", 0);
	set("outdoors", "quanzhou");
	setup();
}

int valid_leave(object me, string dir)
{
        if (dir == "west" && ((string)me->query("gender") =="男性") && !wizardp(me))
                return notify_fail("你個大老爺們兒去那干嘛！！\n");
        return 1;
}


