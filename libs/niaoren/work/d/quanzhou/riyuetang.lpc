#include <ansi.h>;
inherit ROOM;

void create()
{
	set("short", "日月潭");
	set("long", @LONG
翠峰環抱，湖水澄碧的日月潭，潭北形如日輪，潭南
彎曲如月，為台灣避暑勝地。
LONG );
	set("exits", ([
                "westdown" : __DIR__"chiqian",
	]));
	set("no_clean_up", 0);
	set("outdoors", "quanzhou");
	setup();
}

