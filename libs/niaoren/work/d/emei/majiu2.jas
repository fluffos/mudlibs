inherit ROOM;

void create()
{
      set("short","馬廄\");
      set("long",@LONG
這是一間馬廄\，常年供應新鮮草料。此地民風淳朴，馬夫們把馬牽到馬廄
好生照看，將它們喂飽飲足，再洗刷得干乾淨淨，一直伺候到客人離店上路。
馬廄\中堆放著几堆草料，正中有一口泔槽。
LONG);
      set("objects", ([
           __DIR__"npc/baima" : 2,
           __DIR__"npc/heima" : 1,
           __DIR__"npc/mafu2" : 1,
      ]));
      set("outdoors", "emei");
      set("exits",([ /* sizeof() == 1 */
          "south"      : __DIR__"huayanding",
      ]));
      set("no_clean_up", 0);
      setup();
      replace_program(ROOM);
}
