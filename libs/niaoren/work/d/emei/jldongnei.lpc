//Room: jldongnei.c 九老洞
//Date: Oct. 2 1997 by That

inherit ROOM;

void create()
{
      set("short","九老洞");
      set("long",@LONG
這就是峨嵋第一大洞，洞內深窈無比，神秘難測。你一走進來，便發覺洞
中叉叉洞多如迷宮，怪異莫測，似乎黝黑無底。洞里隱隱傳來雞犬鼓樂之聲，
令人驚異間，忽有蝙蝠群涌而至，扑熄火炬。還是快快離開吧。
LONG);
      set("objects", ([
           __DIR__"npc/poorman" : 2,
           __DIR__"npc/little_monkey" : 3,
           __DIR__"npc/bat" : 4,
      ]));
      set("no_clean_up", 0);
      setup();
}
void init()
{
        add_action("do_leave", "leave");
}

int do_leave(string arg)
{
        object me;

        me = this_player();
        me->move(__DIR__"jiulaodong");
        return 1;
}
