inherit ROOM;

void create()
{
      set("short","睹光台");
      set("long",@LONG
這里是看日出、云海、佛光、神燈之地。台下深崖萬丈，陡徹無底，云遮
霧掩。極目四望，數百里外的大小雪山皆歷歷在目。
　　金頂云海，迷迷茫茫，籠罩四野，遠接天際。云海輕蕩時，你在金頂，腳
踏白云，大有飄飄欲仙之感﹔當云濤迅猛涌來時，整個金頂都似在向前浮動，
令人有乘舟欲風之意。
LONG);
      set("objects", ([
           CLASS_D("emei") + "/bei" : 1,
      ]));
      set("outdoors", "emei");
      set("exits",([ /* sizeof() == 1 */
          "north"    : __DIR__"huacangan",
          "west"     : __DIR__"dgtsheshenya", 
      ]));
//      set("no_clean_up", 0);
      setup();
}
