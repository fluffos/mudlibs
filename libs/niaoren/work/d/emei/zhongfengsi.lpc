inherit ROOM;

void create()
{
      set("short","中峰寺");
      set("long",@LONG
中峰寺在白云峰下，始建于晉代，原為道觀。傳說觀內的道人每年在三月
三日都獻身給山中一條大蟒，以為可以升仙。后來有個從資州來的明果禪師，
殺了那條大蟒，道士們始知上當，感激不已，自愿改信佛教，從此改觀為寺。
這里往北可到清音閣，東下至神水庵。
LONG);
      set("objects", ([
               __DIR__+"npc/guest": 1,
      ]));
      set("exits",([ /* sizeof() == 1 */
          "northwest"    : __DIR__"qingyinge",
          "eastdown"     : __DIR__"shenshuian",
      ]));
      set("outdoors", "emei");
//      set("no_clean_up", 0);
      setup();
}
