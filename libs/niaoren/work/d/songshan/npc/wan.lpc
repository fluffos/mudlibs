// wan.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("萬大平", ({ "wan daping", "daping", "wan" }) );
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 25);
        set("attitude", "peaceful");
        set("str", 100);
        set("con", 100);
        set("dex", 100);
        set("int", 100);

        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("max_qi",2000);
        set("max_jing",2000);
        set("combat_exp", 1000000);
        set("shen", -400000);

        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("sword", 100);
        set_skill("dodge", 100);
        set_skill("literate", 100);
        set_skill("piaoyibu", 100);
        set_skill("songshan-sword", 100);
        set_skill("unarmed", 100);
        set_skill("luoying-xinfa", 100);
        set_skill("hanbing-strike", 100);
        set_skill("juemen-gun", 100);
        set_skill("staff", 100);

        map_skill("sword", "songshan-sword");
        map_skill("parry", "songshan-sword");
        map_skill("dodge", "piaoyibu");
        map_skill("unarmed", "hanbing-strike");
        map_skill("staff", "juemen-gun");
        map_skill("force", "luoying-xinfa");

        create_family("嵩山派", 14, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if (ob->query_per() < 22) {
                command("say 凡我嵩山派一定要是帥哥美女。");
                command("say " + RANK_D->query_respect(ob) + "你這醜人快滾吧。");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
}
