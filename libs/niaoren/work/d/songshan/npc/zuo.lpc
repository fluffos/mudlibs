// zuo.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("左冷禪", ({ "zuo lengchan", "zuo" }) );
        set("title", HIR"五岳劍派盟主"HIY"嵩山派第十三掌門"NOR);
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 55);
        set("attitude", "peaceful");
        set("str", 100);
        set("con", 100);
        set("dex", 100);
        set("int", 100);

        set("neili", 6000);
        set("max_neili", 6000);
        set("jiali", 200);
        set("max_qi",6000);
        set("max_jing",6000);
        set("combat_exp", 3000000);
        set("shen", -1000000);

        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("sword", 350);
        set_skill("dodge", 350);
        set_skill("literate", 350);
        set_skill("piaoyibu", 350);
        set_skill("songshan-sword", 350);
        set_skill("unarmed", 350);
        set_skill("luoying-xinfa", 350);
        set_skill("hanbing-strike", 350);
        set_skill("juemen-gun", 350);
        set_skill("staff", 350);

        map_skill("sword", "songshan-sword");
        map_skill("parry", "songshan-sword");
        map_skill("dodge", "piaoyibu");
        map_skill("unarmed", "hanbing-strike");
        map_skill("staff", "juemen-gun");
        map_skill("force", "luoying-xinfa");

        create_family("嵩山派", 13, "掌門");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 160) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("chat 嗯，就是你了");
        command("chat 嵩山派永遠是五嶽劍派之首。");
        command("recruit " + ob->query("id"));
}
