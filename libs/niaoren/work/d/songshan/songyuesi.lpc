inherit ROOM;

void create()
{
	set("short", "嵩岳寺");
	set("long", @LONG
這里原是北魏離宮。孝明帝舍為佛院，至隋方有今名，寺圍闊
大，僧舍連云。院內風動旌揚，松搖竹亂，別有一般清靜。
LONG );
	set("exits", ([
		"southdown" : __DIR__"shandao3",
		"northwest" : __DIR__"shandao4",
		"west"      : __DIR__"songyueta",
	]));
	set("no_clean_up", 0);
	setup();
}

