inherit ROOM;

void create()
{
	set("short", "太室闕");
	set("long", @LONG
嵩山古稱方外，又稱崇山，為五岳中的中岳，由太室少室二山沿
綿而成。漢武帝時稱 "嵩高" ，取自詩經 "嵩岳維高，峻極于天" ，
道教以之為第六小洞天。闋高丈余，南面刻 "中岳太室陽城" 六字，
篆文古朴，蒼勁有力。向西就是去少室山少林寺的路。向北一里許便
是中岳廟了。
LONG );
	set("exits", ([
		"north" : __DIR__"tianzhongge",
		"east"  : "/d/shaolin/ruzhou",
		"west"  : "/d/shaolin/shijie1",
	]));
	set("outdoors", "songshan");
	set("objects", ([
		__DIR__"npc/yao" : 1,
	]));
//	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

