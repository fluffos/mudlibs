inherit ROOM;
inherit F_DEALER;

void create()
{
	set("name", "迎賓樓");
	set("short", "迎賓樓二樓");
	set("long", @LONG
這里是雅座，文人學士經常在這里吟詩作畫，富商土豪也在這里
邊吃喝邊作交易。這里也是城里舉辦喜宴的最佳場所。你站在樓上眺
望，只覺得心曠神怡。東面是一池湖水，碧波蕩漾。北面是崇山峻嶺。
牆上挂著價格牌子(paizi)。
LONG );
	set("item_desc", ([
		"paizi" : "本店專辦上等素齊。\n",
	]));
	set("exits", ([
		"down" : __DIR__"jiulou1",
	]));
	set("no_clean_up", 0);
	setup();
}

