inherit ROOM;

void create()
{
	set("short", "達摩院二樓");
	set("long", @LONG
這是一座古朴的殿堂。西首的牆上挂滿了各類武功圖譜，不
少白須白眉的老僧們正端坐在圖譜畫軸之前，似乎在苦苦思索。
南北山牆是高及屋頂的大書架，走近細看，它們是各門各派的武
功秘笈，屋正中擺著几張矮几訶和几個團，几位老僧正在入定中。
LONG );
	set("exits", ([
		"down" : __DIR__"dmyuan",
	]));
	set("objects",([
		CLASS_D("shaolin") + "/xuan-bei" : 1,
		"/clone/book/xisuijing" : 1,
		__DIR__"npc/xiao-bei" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	if (!present("xisuijing",this_object()) )
		return notify_fail("本寺最高心法不見了，你怎敢就走？\n");
	return 1;
}
