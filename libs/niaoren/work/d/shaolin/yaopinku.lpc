#include <room.h>
inherit ROOM;

void create()
{
	set("short", "藥品庫");
	set("long", @LONG
這里是全寺僧侶領用藥品的地方。房間里弭漫著股濃濃
的藥味。靠牆是一排排高及房頂的藥柜，每個藥柜都由上百
個裝藥的小抽屜，上面貼滿了密密麻麻的各種草頭藥名。東
首牆邊放著個巨大的暗紅色杉木藥柜，上面貼著個蓋有方丈
印簽的大封條。一位中年僧人正來回忙碌著稱量藥品，熬藥
煎湯。
LONG );
	set("exits", ([
		"south" : __DIR__"fangjuku",
	]));
	set("objects",([
		CLASS_D("shaolin") + "/dao-xiang2" : 1,
	]));
//	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

