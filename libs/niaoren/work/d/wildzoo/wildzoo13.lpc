#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC "神秘大草原" NOR);
        set("long",@LONG
在你眼前的盡是綠油油的一片，茂盛的野草長到幾乎與人同高，
伴隨著微風吹過後，一種風聲鶴唳的感覺湧上心頭。在你面前有一塊
巨石(stone)擋住洞口。
LONG);
        set("exits", ([
//          "east": __DIR__"wildzoo1",
            "west": __DIR__"wildzoo2",
            "north": __DIR__"wildzoo12",
            "south": __DIR__"wildzoo14",
//          "northwest": __DIR__"wildzoo6",
//          "southwest": __DIR__"wildzoo7",
                       ]));

        set("item_desc", ([
        "stone": "這塊巨石看起來相當沈重，你不知道是否可以推動的了。\n"+
                 "在石頭的右下方還有一行小字(word)。\n",
        "word": BLINK""HIM"惡作劇之石              made by 蓓兒丹悌 2000/11/23 \n"NOR,
        ]));

//      set("objects", ([
//              __DIR__"npc/goose" : random(4),
//                       ]));

        setup();
        set("outdoors", "wildzoo");
//      replace_program(ROOM);
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        object me = this_player();

        if( !arg || arg != "stone" )
        {
        return notify_fail("你要推什麼\？\n");
        }

        if( arg == "stone" )
        {
          message_vision(HIC"$N用盡全力想移開巨石，沒想到一摸到巨石洞口就打開了。\n"NOR, me);
          this_object()->set("exits/east", "/d/wildzoo/wildzoo1");
          remove_call_out("close");
          call_out("close", 5, this_object());
        }
          return 1;
}

void close(object room)
{
        message("vision", HIC"只見巨石碰的一聲又把洞口封閉起來了。\n"NOR, room);
        this_object()->delete("exits/east");
        return;
}
