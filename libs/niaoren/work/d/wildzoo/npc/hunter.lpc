#include <quest.h>;
#include <ansi.h>;

inherit NPC;

void create()
{
        set_name("盜獵者",({ "hunter" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "這是專門獵殺保護動物賺錢的獵人。\n");
//      set("title","野生動物的天敵");
        set("nickname","野生動物的天敵");
        set("combat_exp", 300000);
        set("shen_type", -1);
        set("max_qi", 8000);
        set("qi", 8000);
        set("str", 30);
        set("dex", 30);
        set("con", 40);
        set("int", 20);
        set("startroom", "/d/wildzoo/wildzoo3");
        set_skill("unarmed", 120);           // 基本拳腳
        set_skill("parry", 100);             // 基本招架
        set_skill("dodge", 120);             // 基本躲閃
        set("attitude", "friendly");
        set("chat_chance", 5);
        set("chat_msg", ({
                "盜獵者暗喜道：嘿嘿，這邊有好多的小動物啊。\n",
                "盜獵者說道：誰能幫我一起抓牠們，我一定好好謝謝你。\n",
                (: random_move :),
                      }) );
        setup();
        add_money("gold", 2);
        carry_object("/clone/misc/cloth")->wear();
}

int accept_fight(object ob)
{
        command("say "+ ob->query("name") +"居然敢向我挑戰，找死！！\n");
        command("kill "+ ob->query("id"));
}

int hit_ob(object me, object ob, int damage)
{
      if(random(5) > 2)
        switch(random(3))
        {
        case 0:
        message_vision(RED"\n盜獵者拿出炸藥丟向$N，並且爆炸了！\n"NOR, ob);
        message_vision(RED"\n$N受到嚴重的炸傷！！\n"NOR, ob);
        ob->receive_damage("qi", 200 + random(100));
                break;
        case 1:
        message_vision(CYN"\n盜獵者拿出鞋邊的短刀射向$N。\n"NOR, ob);
        message_vision(CYN"\n$N閃避不及中標了！！\n"NOR, ob);
        ob->receive_damage("qi", 100 + random(50));
                break;
        case 2:
        message_vision(MAG"\n盜獵者使出麻醉飛鏢射向$N。\n"NOR, ob);
        message_vision(MAG"\n$N閃避不及中標了！！\n"NOR, ob);
        message_vision(MAG"\n$N感覺到身體漸漸失去知覺了！！\n"NOR, ob);
        command("halt ");
        ob->unconcious();
                break;
        }
}

int accept_object(object who, object ob)
{
        int bonus, exp, pot, score,factor;
        exp = 100 + random(50);
        pot = 20 + random(10);
        score = 3 + random(3);

       if (who->query("combat_exp") > 100000)
        {
         command("kick "+ who->query("id"));
         command("chat "+ who->query("name") +"真是可恥，老鳥居然搶新手的經驗值！\n");
         return 1;
        }

        if (strsrch(ob->query("id"), "goose") < 0 &&
            strsrch(ob->query("id"), "dog") < 0 &&
            strsrch(ob->query("id"), "cat") < 0 &&
            strsrch(ob->query("id"), "duck") < 0 &&
            strsrch(ob->query("id"), "rabbit") < 0 &&
            strsrch(ob->query("id"), "fox") < 0 &&
            strsrch(ob->query("id"), "monkey") < 0 &&
            strsrch(ob->query("id"), "bee") < 0 )
        {
         command("say 這不是我要的東西！\n");
         return 0;
        }
        else
        {
        command("clap " + who->query("id"));
        destruct(ob);

        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
        bonus = (int) who->query("potential");
        bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
        if( bonus > 300) bonus = 300;
        bonus += (int) who->query("learned_points");
        who->set("potential", bonus );
        bonus = (int) who->query("score");
        bonus += score;
        who->set("score", bonus);
        tell_object(who,HIW"你被獎勵了：" + chinese_number(exp)
        + "點實戰經驗，"+ chinese_number(pot) + "點潛能，"
        + chinese_number(score)+"點江湖閱歷。\n"NOR);
        }
}
