// 小貓 /u/belldandy/npc/cat.c
// 2000/11/08

#include <ansi.h>
#include <command.h>

inherit NPC;

void create()
{
      set_name("小花貓", ({ "cat" }) );
      set("nickname", "人見人愛的小東西");
      set("long", "你看到的是血統高貴的小貓。\n");
      set("race", "野獸");
      set("gender", "雌性" );
      set("age", 10);
      set("str", 22);
      set("int", 30);
      set("dex", 30);
      set("con", 30);
      set("max_qi",   1200);
      set("combat_exp", 2000);
      set("attitude", "friendly");
      set("limbs", ({ "牙齒", "爪子", "身體", "頭" }) );
      set("verbs", ({ "bite", "claw" }) );
      set("chat_chance", 5);
      set("chat_msg", ({
                "小花貓在你腳邊廝磨著。\n",
                (: random_move :),
                        }));
      setup();
}

void init()
{    
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(2) ) {
        case 0:
          command("cat ");
          command("cat " + ob->query("id"));
               break;
        case 1:
          command("lazy ");
          command("yawn " + ob->query("id"));
               break;
            }
}
