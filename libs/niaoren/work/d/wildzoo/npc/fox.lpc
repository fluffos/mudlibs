// 狐狸 /u/belldandy/npc/fox.c
// Date: 2000/11/08

inherit NPC;

void create()
{
        set_name("狐狸", ({ "fox", "huli", "hu" }) );
        set("race", "野獸");
        set("age", 4);
        set("long", "一隻多疑成性的狐狸。\n");
//        set("attitude", "aggressive");
        set("attitude", "peace");
        set("shen_type", -1);

        set("limbs", ({ "狐頭", "狐身", "前爪", "后抓", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );
        set("combat_exp",   800);

        set_temp("apply/attack", 10);
        set_temp("apply/defense", 10);
        set_temp("apply/armor", 10);

        setup();

        set("chat_chance", 5);
        set("chat_msg", ({
                "狐狸向后挪了挪，很是戒備的神情。\n",
                "狐狸瞪著多疑的眼光沖你看，全身一副很緊張的模樣。\n",
                (: random_move :),
                        }));
}

