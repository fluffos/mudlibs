#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIW"小白鵝"NOR, ( { "white goose", "goose"}));
        set("long", "一隻可愛的小白鵝。\n");
//      set("title",BLINK""HIC"神"HIY"奇"HIB"寶"HIM"貝"NOR);
//      set("nickname",BLINK""HIC"神"HIY"奇"HIB"寶"HIM"貝"NOR);
        set("race", "野獸");
        set("gender", "男性");
        set("age", 2);
//      set("attitude", "peace");
        set("shen_type", 0);
        set("limbs", ({ "嘴巴", "尾巴", "身體", "蹼" }) );
        set("verbs", ({ "bite", "claw" }) );
        set("combat_exp",  300);

        set_temp("apply/attack", 5);
        set_temp("apply/defense", 5);
//      set_temp("apply/damage", 10);
        set_temp("apply/armor", 5);

        set("chat_chance", 5);
        set("chat_msg", ({
                "小白鵝拍動翅膀，嘎∼嘎∼地叫了幾聲。\n",
                "小白鵝一邊搖晃身體，一邊慢慢地走了幾步。\n",
                "小白鵝抖一抖牠的小尾巴。\n",
                (: random_move :),
                      }) );
//      carry_object("/u/belldandy/obj/diamond");
        setup();
}

void die()
{
        switch(random(2))
        {
        case 0:
        message_vision("$N嘎嘎的叫了一聲，死了。\n", this_object());
        message_vision("天空中突然出現一只禿鷹，把$N叼走了。\n", this_object());
        destruct(this_object());
                break;
        case 1:
        message_vision("$N嘎嘎的叫了一聲，死了。\n", this_object());
        ::die();
                break;
        }
}
