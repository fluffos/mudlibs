// 小狗 /u/belldandy/npc/dog.c
// 2000/11/08

#include <ansi.h>
#include <command.h>

inherit NPC;

void create()
{
      set_name("小黑狗", ({ "dog" }) );
      set("nickname", "人見人愛的小東西");
      set("long", "你看到的是血統高貴的小狗。\n");
      set("race", "野獸");
      set("gender", "雄性" );
      set("age", 10);
      set("str", 22);
      set("int", 30);
      set("dex", 30);
      set("con", 30);
      set("max_qi",   800);
      set("combat_exp", 1500);
      set("attitude", "friendly");
      set("limbs", ({ "牙齒", "爪子", "身體", "頭" }) );
      set("verbs", ({ "bite", "claw" }) );
      set("chat_chance", 5);
      set("chat_msg", ({
                "小黑狗高興地在你面前搖尾巴。\n",
                (: random_move :),
                        }));
      setup();
}

void init()
{    
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(2) ) {
        case 0:
          command("dog ");
          command("dog " + ob->query("id"));
               break;
        case 1:
          command("lick ");
          command("lick " + ob->query("id"));
               break;
            }
}
