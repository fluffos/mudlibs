// 蜜蜂 /u/belldandy/npc/bee.c
// By Lgg,1998.9

#include <ansi.h>
inherit NPC;

void create()
{
        set_name(HIW "蜜蜂" NOR, ({ "bee" }) );
        set("race", "野獸");
        set("age", 8);
        set("long", "這是一只黃色的蜜蜂，個頭比普通蜜蜂大得多。\n");
        set("str", 40);
        set("dex", 50);

        set("limbs", ({ "頭部", "身體", "翅膀", "尾巴" }) );
        set("verbs", ({ "bite", "poke" }) );

        set_temp("apply/attack", 35);
        set_temp("apply/armor", 25);

        set("chat_chance", 5);
        set("chat_msg", ({
                (: random_move :),
        "蜜蜂在你頭頂轉了一圈，似乎發現這不是可采蜜的地方，就嗡嗡嗡地飛走了。\n",
        "蜜蜂圍繞著鮮花飛飛停停，似乎也不著重在採蜜上。\n",
         }) );
        setup();
}
