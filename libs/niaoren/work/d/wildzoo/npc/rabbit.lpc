// 小白兔 /u/belldandy/npc/rabbit.c
// belldandy 2000/11/06

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIW"小白兔"NOR, ( { "white rabbit", "rabbit"}));
        set("long", "一隻可愛的小白兔。\n");
//      set("title",BLINK""HIC"神"HIY"奇"HIB"寶"HIM"貝"NOR);
//      set("nickname",BLINK""HIC"神"HIY"奇"HIB"寶"HIM"貝"NOR);
        set("race", "野獸");
        set("gender", "女性");
        set("age", 3);
//      set("attitude", "peace");
        set("shen_type", 0);
        set("limbs", ({ "牙齒", "爪子", "身體", "頭" }) );
        set("verbs", ({ "bite", "claw" }) );
        set("combat_exp",  500);

        set_temp("apply/attack", 8);
        set_temp("apply/defense", 8);
        set_temp("apply/damage",  8);
        set_temp("apply/armor", 8);

        set("chat_chance", 5);
        set("chat_msg", ({
                "小白兔在你的面前蹦蹦跳跳著。\n",
                "小白兔用牠的前腳擦拭牠的臉。\n",
                (: random_move :),
                      }) );
        setup();
}

void die()
{
        switch(random(2))
        {
        case 0:
        message_vision("$N掙扎了幾下，死了。\n", this_object());
        message_vision("天空中突然出現一只禿鷹，把$N叼走了。\n", this_object());
        destruct(this_object());
                break;
        case 1:
        message_vision("$N身體抽搐了幾下，死了。\n", this_object());
        ::die();
                break;
        }
}
