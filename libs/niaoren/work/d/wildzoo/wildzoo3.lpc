// 神秘大草原  /d/wildzoo/wildzoo3.c
// belldandy 2000/11/06

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", HIC "神秘大草原" NOR);
        set("long",@LONG
在你眼前的盡是綠油油的一片，茂盛的野草長到幾乎與人同高，
伴隨著微風吹過後，一種風聲鶴唳的感覺湧上心頭。中央附近有一座
池塘(pool)，許多動物都停在池塘邊喝水。
LONG);
        set("exits", ([
            "east": __DIR__"wildzoo2",
            "west": __DIR__"wildzoo8",
            "north": __DIR__"wildzoo6",
            "south": __DIR__"wildzoo7",
                       ]));

        set("item_desc", ([
        "pool": "池子的水非常清澈見底，似乎可以看到天空的倒影，池子裡面還有幾條魚(fish)。\n",
        "fish": "一群不知道是什麼種類的魚，正在悠閒的游來游去。\n",
        ]));

        set("objects", ([
             __DIR__"npc/hunter" : 1,
                         ]));
        set("sleep_room", 1);
        set("cure_times", 10);
        set("outdoors", "wildzoo");
        setup();
//      replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
    if(query("cure_times") > 0 && (random(5) > 2))
     {
        me->add("qi",50);
        me->add("jing",30);
        tell_object(me,HIM"\n一陣暖意掃過你心頭，你只覺得身體的狀態好多了！\n\n"NOR);
     if(me->query("qi") >= me->query("max_qi"))
        me->set("qi",me->query("max_qi"));
     if(me->query("jing") >= me->query("max_jing"))
        me->set("jing", me->query("max_jing"));
        add("cure_times", -1);
     }
        return 1;

}
