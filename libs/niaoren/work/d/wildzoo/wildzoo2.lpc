#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC "神秘大草原" NOR);
        set("long",@LONG
在你眼前的盡是綠油油的一片，茂盛的野草長到幾乎與人同高，
伴隨著微風吹過後，一種風聲鶴唳的感覺湧上心頭。
LONG);
        set("exits", ([
            "east": __DIR__"wildzoo13",
            "west": __DIR__"wildzoo3",
            "north": __DIR__"wildzoo4",
            "south": __DIR__"wildzoo5",
            "northwest": __DIR__"wildzoo6",
            "southwest": __DIR__"wildzoo7",
                       ]));

        set("objects", ([
             __DIR__"npc/bee" : random(4),
                         ]));

        setup();
        set("outdoors", "wildzoo");
}
