// 神秘谷  /d/wildzoo/wildzoo1.c
// belldandy 2000/11/06

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", HIC "神秘谷" NOR);
        set("long",@LONG
這是通往另外一片與世無爭的世界的通道，那裡有著一望無際的
草原，看了真讓人感到無比的舒暢。在你面前有一塊巨石(stone)擋
住洞口。
LONG);
        set("exits", ([
            "east":"/d/heimuya/road2",
//          "west": __DIR__"wildzoo13",
                       ]));
        set("item_desc", ([
        "stone": "這塊巨石看起來相當沈重，你不知道是否可以推動的了。\n"+
                 "在石頭的右下方還有一行小字(word)。\n",
        "word": BLINK""HIM"惡作劇之石   made by 蓓兒丹悌 2000/11/23 \n"NOR,
                            ]));
/*      set("objects", ([
              __DIR__"npc/7colorbird" : 1,
                         ])); */
        set("outdoors", "wildzoo");
        setup();
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        object me = this_player();

        if( !arg || arg != "stone" )
        {
        return notify_fail("你要推什麼\？\n");
        }

        if( arg == "stone" )
        {
          message_vision(HIC"$N用盡全力想移開巨石，沒想到一摸到巨石洞口就打開了。\n"NOR, me);
          this_object()->set("exits/west", "/d/wildzoo/wildzoo13");
          remove_call_out("close");
          call_out("close", 5, this_object());
        }
          return 1;
}

void close(object room)
{
        message("vision", HIC"只見巨石碰的一聲又把洞口封閉起來了。\n"NOR, room);
        this_object()->delete("exits/west");
        return;
}
