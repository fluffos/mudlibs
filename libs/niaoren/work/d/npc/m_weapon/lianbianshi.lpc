//ROOM lianbianshi.c
inherit ROOM;

void create()
{
        set("short", "造鞭潭");
        set("long",
		"這里是玄兵古洞的打造鋼鞭的地方。處在荒蕪人煙的戈壁灘上。居然能有這\n"
		"樣一泓漂亮的潭水，真是讓人不得不贊嘆大自然的鬼斧神工。潭邊婷婷站者一位\n"
		"妙齡的少女，手中把玩著一把看似極是鋒利的匕首，呆呆的看著深邃的潭水出神。\n"
        );
        set("exits", ([
                "north" : "/d/xingxiu/nanjiang3",
        ]));

	set("objects",([__DIR__"npc/shibian" :1,]));

        setup();
	replace_program(ROOM);
}
