// npc: shijian.c
// Jay 3/26/96
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("侍劍", ({ "shijian"}) );
	set("nickname", RED "劍" NOR );
	set("gender", "男性" );
	set("age", 20);
	set("long", 	
		"他頭上包著白布頭巾，一襲白袍，沒有一絲褶皺。\n");
	set("str", 25);
	set("dex", 20);
	set("con", 17);
	set("int", 30);
	set("shen_type", 0);
	set("max_neli",500);
	set("jiali",50);

	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("force",150);
	set_skill("sword",150);
	set_skill("parry",90);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/damage",50);

	set("combat_exp", 250000);
	set("score",0);
	
	set("attitude", "peaceful");
        
	set("inquiry", ([
		"鑄劍"  : "師傅命我幫助別人鑄劍，但到現在也不見一個人影。誰要鑄劍呢？\n",
		"原料"  : "鑄劍可用寒絲羽竹，海底金母，千年神木。但效果各不一樣。\n",
	]) );

	setup();

	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	::init();
	add_action("do_zhu","zhu");
}


int accept_object(object who, object ob)
{	
	if(!(who->query_temp("sword") ) ){
		message_vision(HIC"師傅沒有同意為你鑄劍，您請回吧！\n"NOR, who);
		return 1;
	}
	who->delete_temp("sword");
	who->set_temp("m_sword",1);
//	switch ((string)ob->query("name") ) 
	switch ((string)ob->query("id") ) 
	{
//		case "千年神木": 
		case "shen mu": 
			who->add_temp("shenmu",1);
			break;
//		case "海底金母":
		case "jin mu":
			who->add_temp("jinmu",1);
			break;
//		case "寒絲羽竹": 
		case "han zhu": 
			who->add_temp("hanzhu",1);
			break;
		default :
			message("vision","這是什么！師傅說這不能用來打造兵器！",who);
			return 0;
	}
	message("vision","侍劍低頭檢視了一下手中的"+(string)ob->query("name")+
			"點了點頭說：\n", who);
	message("vision","。。。好我們現在就開始鑄劍\n", who);
	write("請這位"+RANK_D->query_respect(who)+"給劍起名字吧！(zhu 劍的名字 英文代號)\n");
	return 2;
}

int do_zhu(string arg)
{
	string o_name,id,w_name;
	object sword,make_time;   //生成的武器句柄
	object me;
	me = this_player();
	if(!(me->query_temp("m_sword")) ) 
		return notify_fail("什么?\n");
	me->delete_temp("m_sword");
	me->delete_temp("get_orc");
	me->delete_temp("or");

	if((me->query("weapon/make")) ){
		say("侍劍一臉茫然：您已經有一把自造的武器了，還來干什么？難到不可手么？\n");
		return 1;
	}
	if( !arg )
		return notify_fail("侍劍認真的說：想好劍的名稱及代號后在對我說。\n");

	sscanf(arg ,"%s %s" ,w_name ,id);
	if(!w_name||!id)
		return notify_fail("什么?(使用zhu 劍的名字 英文代號\n)");
	if(me->query_temp("shenmu") ) o_name="千年神木";
	if(me->query_temp("jinmu") )   o_name="海底金母";
	if(me->query_temp("hanzhu") )   o_name="寒絲羽竹";
	make_time=NATURE_D->game_time();
	message_vision(me->name()+"沉吟了一會，對侍劍悄聲說了几句話。侍劍點了點頭。說：好吧！\n",me );
	message_vision("\n侍劍回過身，轉向身后的一個巨大的火爐，鼓動真氣燃起了熊熊的大火。說：開始！\n",me );
	message_vision(BLU "$N雙手握住一個巨大的鐵錘，猛的向爐中漸漸紅熱起來的"+o_name+"揮去！\n" NOR,me);
	message_vision(RED "只聽得棚的一聲巨響，錘頭和"+o_name+"粘在了一起。\n" NOR,me );
	message_vision(YEL "$N只覺得掌心一熱，渾身的血液似乎都沸騰了起來！\n" NOR,me);
	message_vision(HIM "一身精血膠合著    的內氣，源源不斷的向爐中的"+o_name+"涌去！\n" NOR,me );
	if( (me->query("qi"))<(me->query("max_qi")) || (me->query("jing"))<(me->query("max_jing")) || (me->query("neili"))<(me->query("max_neili")) )
	{
		message_vision(HIR "突然$N覺得氣血一陣翻涌，一口真氣接不上來。。。。 \n" NOR, me);
		me->set("neili",0);
		me->unconcious();
		return 1;
	}
	message_vision(HIR "只聽咯的一聲輕響，一柄巨劍從爐中倏然躍起。化作一道青電猛的向$N的前胸刺來！！\n" NOR,me );
	say("侍劍見狀大叫：神劍初成，人血以祭！！閃開！\n");
	message_vision("$N只覺得眼前一花，一條白影迅捷無比的擋在了$N的身前。\n",me );	
	message_vision("巨劍透胸穿出，侍劍慘號一聲，鮮血濺得你滿臉都是！\n",me );
	message_vision(RED "侍劍腳下一個不穩，倒在了地上。侍劍已經奄奄一息了。\n" NOR,me);
	this_object()->set("max_qi",10);
	message_vision("巨劍又飛了起來，飛到半空，當的一聲落回到地上。\n爐中的火滅了。一室的勁氣化于無形，一切又歸于沉寂。\n",me );
	
	me->set("qi",10);
	me->set("jing",10);
	me->set("neili",0);

        w_name = replace_string(w_name, "$BLK$", BLK);
        w_name = replace_string(w_name, "$RED$", RED);
        w_name = replace_string(w_name, "$GRN$", GRN);
        w_name = replace_string(w_name, "$YEL$", YEL);
        w_name = replace_string(w_name, "$BLU$", BLU);
        w_name = replace_string(w_name, "$MAG$", MAG);
        w_name = replace_string(w_name, "$CYN$", CYN);
        w_name = replace_string(w_name, "$WHT$", WHT);
        w_name = replace_string(w_name, "$HIR$", HIR);
        w_name = replace_string(w_name, "$HIG$", HIG);
        w_name = replace_string(w_name, "$HIY$", HIY);
        w_name = replace_string(w_name, "$HIB$", HIB);
        w_name = replace_string(w_name, "$HIM$", HIM);
        w_name = replace_string(w_name, "$HIC$", HIC);
        w_name = replace_string(w_name, "$HIW$", HIW);
        w_name = replace_string(w_name, "$NOR$", NOR);

	me->set("weapon/make",1);		//武器制造后防止再造的標志		
	me->set("weapon/name",w_name +NOR);	//武器的名稱
	me->set("weapon/id",id);		//武器的代號
	me->set("weapon/lv",1);    	//武器等級
	me->set("weapon/or",o_name);	//記錄制造原料
	me->set("weapon/value",0);	      	//記錄武器升級已有的點數	
	me->set("weapon/type","劍");
	me->set("weapon/time",make_time);

	sword=new("/d/npc/m_weapon/weapon/m_sword",1);	//生成新劍
	sword->move(this_player());
	message_vision("侍劍摸起地上，帶著斑斑血跡還有些燙手的巨劍，說：\n劍。。已。。成。。，侍劍的任務。。。也就完成了。。。。\n",me );
	say("侍劍艱難的說：劍。。您。。收好，我該走了。。。\n");
	message_vision("侍劍說完。倏的便不見了。\n",me);
	this_object()->die();
	return 1;
}

