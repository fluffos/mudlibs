// npc: shibian.c
// Jay 3/26/96
#include <ansi.h>
inherit NPC;


void create()
{
	set_name("侍鞭", ({ "shibian"}) );
	set("nickname", HIM "鞭" NOR );
	set("gender", "女性" );
	set("age", 20);
	set("long", 	
		"她頭上包著天青色紗巾，一領天青色布袍，沒有一絲褶皺。\n");
	set("str", 25);
	set("dex", 20);
	set("con", 17);
	set("int", 30);
	set("shen_type", 0);
	set("max_neli",500);
	set("jiali",50);

	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("force",150);
	set_skill("sword",150);
	set_skill("parry",90);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/damage",50);

	set("combat_exp", 250000);
	set("score",0);
	
	set("attitude", "peaceful");
        
	set("inquiry", ([
		"造鞭"  : "師傅命我幫助別人造鞭，但到現在也不見一個人影。誰要造鞭呢？\n",
		"原料"  : "造鞭只能用寒絲羽竹。\n",
	]) );

	setup();

	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	::init();
	add_action("do_zhu","zhu");
}


int accept_object(object who, object ob)
{	
	if(!(who->query_temp("whip") ) ){
		message_vision(HIC"師傅沒有同意為你造鞭，您請回吧！\n"NOR, who);
		return 1;
	}
	who->delete_temp("whip");
	who->set_temp("m_whip",1);
//	switch ((string)ob->query("name") ) 
	switch ((string)ob->query("id") ) 
	{
		case "寒絲羽竹": 
		case "han zhu": 
			break;
		default :
			message("vision","這是什么！師傅說這不能用來打造長鞭！",who);
			return 0;
	}
	message("vision","侍鞭低頭檢視了一下手中的"+(string)ob->query("name")+
			"點了點頭說：\n", who);
	message("vision","。。。好我們現在就開始造鞭！\n", who);
	write("請這位"+RANK_D->query_respect(who)+"給鞭起名字吧！(zhu 鞭的名字 英文代號)\n");
	return 1;

}

int do_zhu(string arg)
{
	string o_name,id,w_name;
	object whip,make_time;   //生成的武器句柄
	object me;
	me = this_player();
	if(!(me->query_temp("m_whip")) ) 
		return notify_fail("什么?\n");
	me->delete_temp("m_whip");
	me->delete_temp("get_orc");
	me->delete_temp("or");

	if((me->query("weapon/make")) ){
		say("侍鞭一臉茫然：您已經有一把自造的武器了，還來干什么？難到不可手么？\n");
		return 2;
	}
	if( !arg )
		return notify_fail("侍鞭認真的說：想好劍的名稱及代號后在對我說。\n");

	sscanf(arg ,"%s %s" ,w_name ,id);
	if(!w_name||!id)
		return notify_fail("什么?(使用zhu 鞭的名字 英文代號\n)");
	o_name="寒絲羽竹";
	make_time=NATURE_D->game_time();
	message_vision(me->name()+"沉吟了一會，對侍鞭悄聲說了几句話。侍鞭點了點頭。說：好吧！\n",me );
	message_vision("\n侍鞭回過身，拿出一把寒氣逼人的匕首，交到了$N的手中，自己拿出寒絲羽竹說：開始吧！\n",me );
	message_vision(HIB "$N雙手緊緊握住匕首，用盡全身的力氣向竹杆削去！\n" NOR,me);
	message_vision(RED "只聽得嗤的一聲輕響，匕首一滑竟刺到了$N的手上！\n" NOR,me );
	message_vision(YEL "$N只覺得手背的傷口一熱，隨著鮮血的流出，渾身的血液似乎都沸騰了起來！\n" NOR,me);
	message_vision(HIM "一身精血膠合著    的內氣，源源不斷的向侍鞭手中的寒絲羽竹涌去\n" NOR,me );
	if( (me->query("qi"))<(me->query("max_qi")) || (me->query("jing"))<(me->query("max_jing")) || (me->query("neili"))<(me->query("max_neili")) )
	{
		message_vision(HIR "突然$N覺得傷口一陣巨痛，氣血一陣翻涌，一口真氣接不上來。。。。 \n" NOR, me);
		me->set("neili",0);
		me->unconcious();
		return 1;
	}
	message_vision(HIR "只聽咯的一聲輕響，一柄長鞭從爐中倏然躍起。化作一道青電猛的向$N的前胸刺來！！\n" NOR,me );
	say("侍鞭見狀大叫：神鞭初成，人血以祭！！閃開！\n");
	message_vision("$N只覺得眼前一花，一條青影迅捷無比的擋在了$N的身前。\n",me );	
	message_vision(HIR "長鞭透胸穿出，侍鞭慘號一聲，鮮血濺得$N滿臉都是！\n" NOR,me );
	message_vision(RED "侍鞭腳下一個不穩，倒在了地上。侍鞭已經奄奄一息了。\n" NOR,me);
	this_object()->set("max_qi",10);
	message_vision("長鞭又飛了起來，飛到半空，扑的一聲落回到地上。\n一室的勁氣化于無形，一切又歸于沉寂。\n",me );

	me->set("qi",0);
	me->set("jing",0);
	me->set("neili",0);

        w_name = replace_string(w_name, "$BLK$", BLK);
        w_name = replace_string(w_name, "$RED$", RED);
        w_name = replace_string(w_name, "$GRN$", GRN);
        w_name = replace_string(w_name, "$YEL$", YEL);
        w_name = replace_string(w_name, "$BLU$", BLU);
        w_name = replace_string(w_name, "$MAG$", MAG);
        w_name = replace_string(w_name, "$CYN$", CYN);
        w_name = replace_string(w_name, "$WHT$", WHT);
        w_name = replace_string(w_name, "$HIR$", HIR);
        w_name = replace_string(w_name, "$HIG$", HIG);
        w_name = replace_string(w_name, "$HIY$", HIY);
        w_name = replace_string(w_name, "$HIB$", HIB);
        w_name = replace_string(w_name, "$HIM$", HIM);
        w_name = replace_string(w_name, "$HIC$", HIC);
        w_name = replace_string(w_name, "$HIW$", HIW);
        w_name = replace_string(w_name, "$NOR$", NOR);

	me->set("weapon/make",1);		//武器制造后防止再造的標志		
	me->set("weapon/name",w_name +NOR);	//武器的名稱
	me->set("weapon/id",id);		//武器的代號
	me->set("weapon/lv",1);    	//武器等級
	me->set("weapon/or",o_name);	//記錄制造原料
	me->set("weapon/value",0);	      	//記錄武器升級已有的點數	
	me->set("weapon/type","鞭");
	me->set("weapon/time",make_time);

	whip=new("/d/npc/m_weapon/weapon/m_whip",1);	//生成新劍
	whip->move(this_player());
	message_vision("侍鞭摸起地上，帶著斑斑血跡的長鞭，說：\n鞭。。已。。成。。，侍鞭的任務。。。也就完成了。。。。\n",me );
	say("侍鞭艱難的說：鞭。。您。。收好，我該走了。。。\n");
	message_vision("侍鞭說完。倏的便不見了。\n",me);
	this_object()->die();
	return 1;
}

		
