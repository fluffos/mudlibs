//tan7.c

inherit ROOM;

void create()
{
	set("short", "嘉興南湖 ");
	set("long",
		"這里是嘉興南湖底，四周黑忽忽的，頭頂上看不見一點亮光，身邊的水流\n"
		"忽上忽下的涌動著。看起來是一處海眼。腳下似乎有一點亮光，也不知是些\n"
		"什么。周圍一片死寂，似乎暗藏著層層殺機。\n"
	);
	set("exits", ([
		"up" : __DIR__"tan6",	
		"east" : __DIR__"tan5",
		"west" : __DIR__"tan7",
		"south" : __DIR__"tan7",
		"north" : __DIR__"tan7",
	]));
        set("objects" , ([
               __DIR__"npc/fish" : 3,
	       __DIR__"item/zhenzhu" :1,	
             ]) );
	setup();
	replace_program(ROOM);
}
