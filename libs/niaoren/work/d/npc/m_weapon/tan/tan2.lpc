//tan2.c

inherit ROOM;

void create()
{
	set("short", "嘉興南湖 ");
	set("long",
		"這里是嘉興南湖水下 ，四周倒還漸漸有些昏暗了，几道天光從頭頂的潭水中投射下\n"
		"來，此時也不那么瑰麗了，昏沉沉的猶如天邊的晚霞。腳下漆黑一片也不知有\n"
		"些什么。四周的水流也沒有那么平靜了，似乎在向一個方向流動著。你不由心中\n"
		"一動：不會有暗流吧！！\n"

	);
	set("exits", ([
		"up" : __DIR__"tan1",
		"down" : __DIR__"tan3",
	]));
	setup();
}
