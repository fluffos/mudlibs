//ROOM lianzhangshi.c
inherit ROOM;

void create()
{
        set("short", "杖場");
        set("long",
		"這里是玄兵古洞的造杖的地方。四周道也不是十分荒涼，相反還可說有\n"
		"几分景致。露天放著一個巨大的爐子，冒著蓬蓬的藍炎，似乎什么都能被它\n"
		"融化似的。\n"	
        );
        set("exits", ([
                "eastup" : "/d/baituo/xiaolu4",
        ]));

	set("objects",([__DIR__"npc/shizhang" :1,]));

        setup();
}
