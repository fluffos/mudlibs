//ROOM liandaoshi.c
inherit ROOM;

void create()
{
        set("short", "煉刀場");
        set("long",
		"這里是玄兵古洞的煉刀場。四處充滿了金屬的氣味，炙熱的氣浪沖的人\n"
		"不由打了個趔趄。一個皮膚黝黑的小伙正坐在一塊石頭上休息，手中一個\n"
		"巨大的錘頭正不停的來回擺動著。看來這小伙快要睡著了。\n"
        );
        set("exits", ([
                "south" : "/d/xingxiu/tianroad5",
        ]));

	set("objects",([__DIR__"npc/shidao" :1,]));

        setup();
}
