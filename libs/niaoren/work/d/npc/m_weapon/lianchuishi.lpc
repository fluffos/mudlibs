//ROOM lianchuishi.c
inherit ROOM;

void create()
{
        set("short", "打錘坪");
        set("long",
	"這里是玄兵古洞的打造鋼錘的地方。處在荒蕪人煙的大雪山上。大雪山長年\n"
	"積雪，這里卻是一坪長草扶地的山谷。四周擺了很多銅鐵五金，一個  腆少年手\n"
	"執大錘，看著你走近身來。\n"
        );
        set("exits", ([
                "eastdown" : "/d/xuedao/nroad5",
        ]));

	set("objects",([__DIR__"npc/shichui" :1,]));

        setup();
	replace_program(ROOM);
}
