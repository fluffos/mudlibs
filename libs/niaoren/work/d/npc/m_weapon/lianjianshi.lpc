//ROOM lianjianshi.c
inherit ROOM;

void create()
{
        set("short", "煉劍場");
        set("long",
		"這里是玄兵古洞的煉劍場。四周荒涼沒有人煙，地上隱約還能看見斑斑\n"
		"的血跡，偶爾能看見的几棵樹似乎也成了劍的表征，一個個劍拔弩張的。露\n"
		"天放著一個巨大的爐子，冒著蓬蓬的藍炎，激烈的罡氣震得你一陣暈眩，原\n"
		"來這里正在以內家真氣煉劍。\n"	
        );
        set("exits", ([
                "south" : "/d/xingxiu/shamo3",
        ]));

	set("objects",([__DIR__"npc/shijian" :1,]));

        setup();
	replace_program(ROOM);
}
