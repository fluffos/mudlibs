//xuanbing.c

inherit ROOM;

void create()
{
	set("short", "玄兵古洞");
	set("long",
		"這里是玄兵古洞，四面洞壁之上結滿了石英的柱狀結晶體，顯得\n"
		"十分漂亮。前方一個巨大的爐子前站著一位長髯老者正看著爐火想著\n"
		"什么心事，旁邊几個彪形大漢正揮舞著錘頭敲打著一塊似乎總也燒不\n"
		"紅的什么金屬。旁邊仔細的放著几把剛剛出爐的兵器。那種駭人的殺\n"
		"氣竟是從這些兵器上散發出來的。\n"

	);
	set("exits", ([
		"out" : __DIR__"xuanbing",
	]));
        set("objects" , ([
               __DIR__"npc/tianjianshi" : 1,

             ]) );
	setup();
}
