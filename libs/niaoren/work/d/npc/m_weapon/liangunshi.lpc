//ROOM liangunshi.c
inherit ROOM;

void create()
{
        set("short", "棍窠");
        set("long",
		"這里是玄兵古洞造棍的地方。周圍整齊的堆放著造棍用的原料，一個年輕\n"
		"小伙手里拿著一本玄天棍法，正在仔細的研讀著。看到你走了過來，連忙放下\n"
		"手中的書，帶著一臉純真沖你憨憨的一笑，臉不由又紅了。\n"
        );
        set("exits", ([
                "east" : "/d/xueshan/shenghu",
        ]));

	set("objects",([__DIR__"npc/shigun" : 1,]));

        setup();
	replace_program(ROOM);
}
