// yzuo.c 霧雨
 
#include <ansi.h>
 
inherit NPC;
 
void create()
{
        set_name("霧雨", ({"yzuo"}));
        set("nickname",HIM"星宿祖師"NOR);
        set("gender", "男性");
        set("age", 20);
        set("long",
                "他就是負擔起振興星宿派大業的大巫師霧雨！\n");
        set("attitude", "peaceful");
 
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
 
        setup();
        carry_object("/clone/misc/cloth")->wear();
}

