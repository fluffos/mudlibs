
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("欣云", ({"wwl"}));
	set("nickname", HIM "我是一片云" NOR);
	set("title", "桃花島第二代弟子");
	set("gender", "女性");
	set("age", 20);
	set("long", 
		"他就是桃花島的才女欣云，后來被風云給騙去了。");
        setup();
	
	carry_object("/d/city2/obj/jinduan")->wear();
}
