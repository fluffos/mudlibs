// doll.c 阿甘

#include <ansi.h>

inherit NPC;

string ask_me();

void create()
{
	set_name("阿甘", ({"doll"}));
	set("nickname", GRN"中場隊員"NOR);
	set("gender", "男性");
	set("age", 20);
	set("long", 
		"他就是著名的「阿甘」。金庸群俠傳的自動啟動程序就出自于他之手\n"
		"他還是一位狂熱的球迷，曾任TMN BBS足球板的板主。\n");
	setup();

	carry_object("/d/city2/obj/jinduan")->wear();
}
