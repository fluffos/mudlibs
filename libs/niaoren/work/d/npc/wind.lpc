
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("風云", ({"wind"}));
	set("nickname",HIC"云龍門開山祖師"NOR);
	set("gender", "男性");
	set("age", 20);
	set("long", 
		"他就是當年的風，一劍平天下以后，功成身退，歸隱山谷。\n"+
                "他就是天神風云，北京城、神龍島皆出自他手。\n");
	

	setup();
	
	carry_object("/d/city2/obj/jinduan")->wear();
}
