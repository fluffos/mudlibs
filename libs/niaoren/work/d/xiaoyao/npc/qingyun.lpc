// qingyun.c
// shilling 97.2

inherit NPC;

#include <ansi.h>

void create()
{
        set_name("青云", ({ "qingyun", "shizhe" }));
        set("long", 
                "他是掌門人的得意門生，一個十分厲害的神秘人物。\n");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "friendly");
        set("class", "fighter");
        set("shen_type", 1);
        set("str", 100);
        set("int", 100);
        set("con", 100);
        set("dex", 100);
        set("per", 32);
        set("kar", 100);
        
        set("max_qi", 3000);
        set("max_jing", 3000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 200);
        set("combat_exp", 3000000);
        set("score", 3000000);

        set_skill("blade",200);
        set_skill("ruyi-dao",200);
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("unarmed", 200);
        set_skill("parry", 200);
        set_skill("lingboweibu", 200);
        set_skill("beiming-shengong", 200);
        set_skill("liuyang-zhang", 200);
        set_skill("zhemei-shou", 200);

        map_skill("force", "beiming-shengong");
        map_skill("dodge", "lingboweibu");
        map_skill("unarmed", "zhemei-shou");
        map_skill("hand", "zhemei-shou");
        map_skill("strike", "liuyang-zhang");
        map_skill("parry", "ruyi-dao");
        map_skill("blade", "ruyi-dao");

        prepare_skill("hand","zhemei-shou");
        prepare_skill("strike","liuyang-zhang");


        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
		(: perform_action, "hand.zh1" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );

        create_family("逍遙派", 2, "弟子");
        set("title","逍遙派護法使者");
        set("nickname","天使之侶");
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        carry_object(__DIR__"obj/blade")->wield();

}

void init()
{
        object ob;

        ::init();

        ob = this_player();

        if (interactive(ob) && (!ob->query("family") || ob->query("family")["family_name"]!="逍遙派"))
        {
                command("hehe");
                command("say 你好大的膽子，本派的密室也敢闖進來 ？！你找死\n");
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob); 
        }
        else if(ob->query("family")["family_name"]=="逍遙派")
        {
                command("smile");
                command("say 師弟辛苦啦，快去見祖師爺吧，他惦記著你呢。");
        }
}
