// mengmianr.c
// shilling 97.2
inherit NPC;
void create()
{
	set_name("蒙面人", ({ "mengmian ren", "ren" }));
	set("long", 
		"一個蒙著面部，身穿黑色夜行衣服的神秘人。\n");
	set("gender", "男性");
	set("age", 25);
	set("attitude", "peaceful");
	set("class", "fighter");
	set("shen_type", -1);
	set("str", 30);
	set("int", 20);
	set("con", 30);
	set("dex", 30);
	set("kar", 30);
	set("per", 24);
	set("max_qi", 5000);
	set("max_jing", 2000);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 100);
	set("combat_exp", 100000);
	set_skill("force", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("blade", 100);
	set_skill("lingboweibu", 100);
	set_skill("beiming-shengong", 100);
	set_skill("ruyi-dao", 100);

	map_skill("blade", "ruyi-dao");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );

	create_family("逍遙派", 5, "弟子");
	setup();
	
	carry_object(__DIR__"obj/blade")->wield();
	carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();

        ob = this_player();

        if (interactive(ob) && (!ob->query("family") || ob->query("family")["family_name"]!="逍遙派"))
        {
                command("say 你好大的膽子，本派重地也敢闖進來 ？！你找死\n");
        }
        else if(ob->query("family")["family_name"]=="逍遙派")
        {
                command("say 師兄辛苦啦，快進去吧。");
        }
}
