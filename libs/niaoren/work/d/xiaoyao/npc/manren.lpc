// mengmianr.c
// shilling 97.2

inherit NPC;

void create()
{
        set_name("蒙面人", ({ "mengmian ren", "ren" }));
        set("long", 
                "一個蒙著面部，身穿黑色夜行衣服的神秘人。\n");
        set("gender", "男性");
        set("age", 25);
        set("attitude", "peaceful");
        set("class", "fighter");
        set("shen_type", -1);
        set("str", 50);
        set("int", 50);
        set("con", 50);
        set("dex", 50);
        set("kar", 50);
        set("per", 24);
        
        set("max_qi", 3000);
        set("max_jing", 200);
        set("neili", 200000);
        set("max_neili", 200000);
        set("combat_exp", 100);

        set_skill("force", 10);
        set_skill("dodge", 10);
        set_skill("parry", 10);
        set_skill("blade", 10);
        set_skill("lingboweibu", 10);
        set_skill("beiming-shengong", 10);
        set_skill("ruyi-dao", 10);

        map_skill("blade", "ruyi-dao");
        map_skill("dodge", "lingboweibu");
        map_skill("force", "beiming-shengong");

        create_family("逍遙派", 5, "弟子");
        setup();
        
        carry_object(__DIR__"obj/blade")->wield();
        carry_object(__DIR__"obj/cloth")->wear();
}
