// suxingh.c
// shilling 97.2

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
	set_name("蘇星河",({"su xinghe","su"}));
	set("gender", "男性" );
	set("nickname", "聰辯老人");
	set("shen_type", 0);
	set("class", "scholar");
	set("age",60);
	set("str", 80);
	set("con", 80);
	set("int", 80);
	set("dex", 80);
	set("kar", 80);
	set("per", 29);
	set("long",
"此人就是號稱聰辯老人的蘇星河，據說他能言善辯， \n"
"是一個武林中的智者，而他的武功也是無人能知。\n");

	set("combat_exp", 2500000);
	set("attitude", "peaceful");
	set("max_qi", 4000);
	set("max_jing", 4000);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali", 200);
	set("env/wimpy", 30);

	set_skill("force", 200);
	set_skill("dodge", 200);
	set_skill("unarmed", 200);
        set_skill("hand", 200);
        set_skill("strike", 200);
	set_skill("parry", 200);
	set_skill("blade", 200);
	set_skill("lingboweibu", 200);
	set_skill("beiming-shengong", 200);
	set_skill("ruyi-dao", 200);
	set_skill("liuyang-zhang", 200);
	set_skill("zhemei-shou", 200);
	set_skill("literate", 200);

	map_skill("unarmed", "zhemei-shou");
        map_skill("hand", "zhemei-shou");
        map_skill("strike", "liuyang-zhang");
	map_skill("blade", "ruyi-dao");
        map_skill("parry", "ruyi-dao");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");

	prepare_skill("hand","zhemei-shou");
	prepare_skill("strike","liuyang-zhang");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
		(: perform_action, "hand.zh1" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );
        set("book_count", 3);
	set("inquiry", ([
		"秘笈":(:ask_me:),
	]) );
	create_family("逍遙派", 2, "弟子");
	set("title","逍遙派第二代大弟子");
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/blade")->wield();
}


void attempt_apprentice(object ob)
{

	if (ob->query_int() < 25) {
		command("shake"+ ob->query("id")); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否還應該在學問上多下點功夫？");
		return;
	}

	command("say 好吧，我就收下你了，今后要多加努力啊！");
	command("recruit " + ob->query("id"));
 }

string ask_me()
{
	object me,ob;
	ob=this_player(); 

	if (query("book_count") < 1)
		return "你來晚了，我已經贈送給別人了。";   
	add("book_count", -1);                  

	if(ob->query("family/family_name")=="逍遙派")
	{
		command("say 秘笈拿去吧。");
		message_vision(HIY"蘇星河從懷里掏出秘笈，交了給$N \n\n"NOR,ob);
		me=new("/d/xiaoyao/npc/obj/liuyang_book1");
		me->move(ob);
		me=new("/d/xiaoyao/npc/obj/liuyang_book2");
		me->move(ob);
		me=new("/d/xiaoyao/npc/obj/zhemei_book1");
		me->move(ob);
		me=new("/d/xiaoyao/npc/obj/zhemei_book2");
		me->move(ob);
		me=new("/d/xiaoyao/npc/obj/qijianpu");
		me->move(ob);
		return "秘笈可千萬不要借給別人啊，他們一借就不還的了。\n";
	}
}
