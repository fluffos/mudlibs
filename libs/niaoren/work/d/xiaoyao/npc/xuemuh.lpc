//xuemuh.c 薛慕華
// shilling 97.2

inherit NPC;
inherit F_MASTER;

//void attempt_apprentice(object ob);
int ask_me();

void create()
{
	set_name("薛慕華", ({ "xue muhua", "xue" }));
	set("long", 
		"他就是號稱閻王敵的神醫──薛慕華，據說他精通醫理，可以起死回生。\n");
	set("gender", "男性");
	set("title","逍遙派“函谷八友”");
	set("nickname","閻王敵薛神醫");
	set("age", 50);
	set("class", "shaman");
	set("attitude", "peaceful");
	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);
	set("kar", 50);
	set("per", 28);
	set("inquiry", ([
		"療傷" : (:ask_me:),
	]) );

	set("max_qi", 3000);
	set("max_jing", 3000);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 100);
	set("combat_exp", 2000000);
	set("score", 800000);

	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("unarmed",150);
	set_skill("parry", 150);
	set_skill("lingboweibu",150);
	set_skill("beiming-shengong", 150);
	set_skill("zhemei-shou", 150);

	map_skill("unarmed", "zhemei-shou");
        map_skill("hand", "zhemei-shou");
        map_skill("parry", "zhemei-shou");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");

	prepare_skill("hand","zhemei-shou");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
		(: perform_action, "hand.zh1" :),
                (: exert_function, "re1" :),
                  (: perform_action, "dodge.lin" :),
                (: exert_function, "s" :),
        }) );



	create_family("逍遙派", 3, "弟子");
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	command("say 好吧，我就收下你了，以后要多為逍遙派出力啊。");
	command("recruit " + ob->query("id"));
 }

int ask_me()
{
	object ob;
	ob=this_player();

	if (ob->query("family/family_name") != "逍遙派")
		return notify_fail("你不是我派弟子，我不可以為你療傷。\n");
	if ((int)ob->query("eff_qi") == (int)ob->query("max_qi"))
	{
		command("?"+ob->query("id"));     
		command("say 你沒有受任何傷啊？\n");
		return 1;
	}
	else
	{
		message_vision("薛慕華喂$N服下一顆藥丸,然后盤膝坐下，雙掌貼著$N的背心。\n", ob);
		remove_call_out("re1");
		call_out("re1",2,ob);
		return 1;
	}
}


int re1(object ob)
{
	ob->set("eff_qi", (int)ob->query("max_qi"));
	ob->set("eff_jing", (int)ob->query("max_jing"));  
	message_vision("大約過了一盅茶的時份，薛慕華慢慢地站了起來。\n",ob);
	command("say 你的傷勢已經全好了,可以走啦。\n");
	return 1;
}
