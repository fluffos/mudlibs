// xiaoyaozi.c 逍遙子
// shilling 97.2

inherit NPC;
inherit F_MASTER;
string ask_me();
#include <ansi.h>

void create()
{
        set_name("逍遙子", ({ "xiaoyao zi", "xiaoyao","zi" }));
        set("title", "逍遙派開山祖師");
        set("long", 
                "他就是逍遙派開山祖師、但是因為逍遙派屬于一個在江湖中\n"
                "的秘密教派，所以他在江湖中不是很多人知道，但其實他的\n"
                "功夫卻是。。。。他年滿七旬，滿臉紅光，須眉皆白。\n");
        set("gender", "男性");
        set("age", 75);
        set("class", "scholar");
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 150);
        set("int", 150);
        set("con", 150);
        set("dex", 150);
        set("per", 150);
		set("kar", 150);

        set("max_qi", 5000);
        set("max_jing", 5000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jingli", 2500);
        set("max_jingli", 2500);
        set("jiali", 300);
        set("combat_exp", 7000000);
        set("score", 9000000);

          set_skill("force", 350);
          set_skill("beiming-shengong", 350);
          set_skill("dodge", 350);
          set_skill("lingboweibu", 400);
          set_skill("unarmed", 350);
          set_skill("liuyang-zhang", 350);
          set_skill("parry", 350);
          set_skill("blade", 400);
          set_skill("sword", 350);
          set_skill("ruyi-dao", 350);
          set_skill("zhemei-shou", 350);
          set_skill("hand", 350);
          set_skill("strike", 350);
          set_skill("literate", 350);

        map_skill("force", "beiming-shengong");
        map_skill("dodge", "lingboweibu");
        map_skill("unarmed", "zhemei-shou");
        map_skill("hand", "zhemei-shou");
        map_skill("strike", "liuyang-zhang");
        map_skill("parry", "ruyi-dao");
        map_skill("blade", "ruyi-dao");

        prepare_skill("hand","zhemei-shou");
        prepare_skill("strike","liuyang-zhang");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
		(: perform_action, "hand.zh1" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );
        create_family("逍遙派", 1, "開山祖師");
        set("class", "taoist");

        setup();
        carry_object(__DIR__"obj/blade")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("beiming-shengong", 1) < 150) {
                command("say 我逍遙派內功的源泉來自于北冥神功的心法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "的北冥神功是否還應該有所提高啊？");
                return;
        }

        if (ob->query_int() < 35) {
                command("say 我逍遙派武功最重視“逍遙”二字。");
                command("say 而何謂“逍遙”，這只能靠你自己去領悟。");
                command("say 但是" + RANK_D->query_respect(ob) + "的悟性似乎還有待提高啊。");
                return;
        }
        command("smile");
        command("say 想不到在這世上竟然還有人可以繼承我的逍遙心法！");
        command("recruit " + ob->query("id"));
        ob->set("title","逍遙派護法使者");
}

