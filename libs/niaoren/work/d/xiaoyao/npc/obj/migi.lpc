// migi.c 逍遙心法

inherit ITEM;
#include <ansi.h>
int do_study(string);
string* skill = ({
	"beiming-shengong",
	"strike",
	"force",
	"hand",
	"parry",
	"sword",
	"blade",
	"dodge",
	"lingboweibu",
	"zhemei-shou",
	"unarmed",
	"liuyang-zhang",
	"tianyu-qijian",
	"literate",
});
void create()
{
        set_name(HIW"逍遙心法"NOR, ({ "migi" }));
        set_weight(100);
        if( clonep() )
				set_default_object(__FILE__);
        else
        {
                set("unit", "本");
                set("long","這是逍遙派紀錄各派武學的經典，你只能參悟(canwu)。\n");
                set("value", 0);
                set("no_drop", 1);
		set("no_get", "送人？虧你想的出來！\n");
                set("material", "book");
        }
}

void init()
{
	add_action("do_study","canwu");
}

int do_study(string arg)
{
	object where;
	object ob = this_object();
	object me = this_player();
	int myskill, cost, i, exp;

	cost=100;
	where = environment(me);
	if (!arg || !objectp(ob = present(arg, me)))
		return notify_fail("你要參悟什么？\n");
	if ((string)where->query("short")!="逍遙小屋")
		return notify_fail("逍遙心法只能在逍遙小屋參悟！\n");
        if(!me->query("family") || (me->query("family/family_name")!="逍遙派")) 
             return notify_fail("你不是消遙派的弟子,不能參悟消遙心法?\n");

	if (!me->query_skill("literate",1)||me->query_skill("literate",1)<200)
	{
		write("你把逍遙心法翻來翻去，就是什么都讀不懂。\n");
		return 1;
	}
	if (me->is_busy())
		return notify_fail("你現在正忙著呢。\n");
	if (me->is_fighting() )
		return notify_fail("你無法在戰斗中專心下來研讀新知！\n");
	exp = (int)me->query("combat_exp");
	if (exp < 3000000)
	{
		write("你的實戰經驗不足，不能參悟逍遙心法。\n");
		return 1;
	}
	if ((int)me->query("jing")>cost)
	{
		for ( i=sizeof(skill); i>0; i-- )
		{
			myskill=me->query_skill(skill[i-1], 1);
                          me->improve_skill(skill[i-1], (me->query_skill(skill[i-1], 1)+me->query("int")*50));
		}
		printf("你參悟逍遙心法的武功，似乎有點心得。\n");
		me->receive_damage("jing", cost );
	}
	else
	{
		cost=me->query("jing");
		write("你現在過于疲倦，無法專心下來參悟逍遙心法。\n");
	}
	return 1;
}
