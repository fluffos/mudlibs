// fengas.c
// shilling 97.2

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string ask_me();

void create()
{
	set_name("馮阿三", ({ "feng asan", "feng" }));
	set("long", 
		"據說他就是魯班的后人，當代的第一巧匠，設計機關的能手。\n");
	set("gender", "男性");
	set("age", 40);
	set("attitude", "friendly");
	set("class", "alchemist");
	set("shen_type", 1);
	set("str", 50);
	set("kar", 50);
	set("per", 25);
	set("int", 50);
	set("con", 50);
	set("dex", 50);

	set("inquiry", ([
		"機關":(:ask_me:),
	]) );

	set("max_qi", 3000);
	set("max_jing", 3000);
	set("neili", 3000);
	set("max_neili", 2000);
	set("jiali", 100);
	set("combat_exp", 1000000);
	set("score", 200000);

	set_skill("blade",150);
	set_skill("ruyi-dao",150);
	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("unarmed", 150);
	set_skill("parry", 150);
	set_skill("lingboweibu", 150);
	set_skill("beiming-shengong",150);
	set_skill("liuyang-zhang", 150);

	map_skill("unarmed", "liuyang-zhang");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");
	map_skill("blade", "ruyi-dao");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );

	create_family("逍遙派", 3, "弟子");
	set("title","逍遙派“函谷八友”");
	set("nickname","巧匠");
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/blade")->wield();

}

string ask_me()
{
	object me,ob;
	ob=this_player(); 

	if (random(100)<70)
		return "我在設計機關方面是有點特長，讓大家見笑了。";   
	command("laugh");
	return "別吵著我，我在看書呢。哈哈，鳥人萬歲。。。。這書真好笑\n";
}

void attempt_apprentice(object ob)
{

	if (ob->query_int() < 20) {
		command("shake"+ ob->query("id")); 
		command("say " + RANK_D->query_respect(ob) + 
			"你的悟性太低了？");
		return;
	}

	command("say 好吧，我就收下你了，今后要多加努力啊！");
	command("recruit " + ob->query("id"));
}
void recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "scholar");
}
