// goudu.c
// shilling 97.2

inherit NPC;
//inherit F_MASTER;

#include <ansi.h>

string ask_me();

void create()
{
	set_name("苟讀", ({ "gou du", "gou" }));
	set("long", 
		"他看上去也是几十歲的人了，卻是純然一個書呆子的模樣。\n");
	set("gender", "男性");
	set("age", 50);
	set("attitude", "friendly");
	set("class", "scholar");
	set("shen_type", 1);
	set("str", 50);
	set("kar", 50);
	set("per", 26);
	set("int", 50);
	set("con", 50);
	set("dex", 50);

	set("inquiry", ([
		"論語":(:ask_me:),
	]) );

	set("max_qi", 3000);
	set("max_jing", 3000);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 100);
	set("combat_exp", 2000000);
	set("score", 400000);

	set_skill("blade",150);
	set_skill("ruyi-dao",150);
	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("unarmed", 150);
	set_skill("parry", 150);
	set_skill("lingboweibu", 150);
	set_skill("beiming-shengong",150);
	set_skill("zhemei-shou", 150);

	map_skill("unarmed", "zhemei-shou");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");
	map_skill("blade", "ruyi-dao");

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                  (: perform_action, "dodge.lin" :),
		(: perform_action, "unarmed.zh1" :),
                (: exert_function, "re1" :),
                (: exert_function, "s" :),
        }) );

	set("book_count", 1);

	create_family("逍遙派", 3, "弟子");
	set("title","逍遙派“函谷八友”");
	set("nickname","書呆");
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/blade")->wield();

}


string ask_me()
{
	object me,ob;
	ob=this_player(); 

	if (query("book_count") < 1)
		return "你來晚了，那本《論語》我已經贈送給別入了。";   
	add("book_count", -1);                  

	if(ob->query("family/master_id")=="xiaoyao zi")
	{
		command("say 師叔想要《論語》，拿去就是。");
		message_vision(HIY"苟讀從懷里掏出一本舊書，交了給$N \n\n"NOR,ob);
		me=new("/d/xiaoyao/npc/obj/lbook4");
		me->move(ob);
		return "這本書可千萬不要借給別人啊，他們一借就不還的了。\n";
	}
	command("say 哈哈，《論語》就沒有了，這里有我派高手從少林盜來的書。");
	command("say 既然你那么好學，我就把它送給你吧。\n");
	message_vision(HIY"苟讀翻箱倒柜找了半天，找出一本舊書，交了給$N \n\n"NOR,ob);
	if (random(2) == 1) me=new("/clone/book/strike_book");
	else me=new("/clone/book/book-paper");
	me->move(ob);

	return "這本書可千萬不要借給別人啊，他們一借就不還的了。\n";
}
