#include <room.h>
inherit ROOM;

void create()
{
	set("short", "石室");
	set("long", @LONG
這是一個石頭砌成的房間，因為好久沒有人來過，散發著一些很難聞的
氣味，房間中到處可以看到蛛絲和虫跡。
LONG );
	set("exits", ([
		"north" : __DIR__"shiji3",
		"west" : __DIR__"shiji2",
	]));
	create_door("north", "石門", "south", DOOR_CLOSED);
	set("no_clean_up", 0);
	setup();
}
