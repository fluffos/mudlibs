inherit ROOM;

void create()
{
	set("short", "岩縫");
	set("long", @LONG
忽然，你感覺到被什么東西鉤了一下，原來是一棵橫著伸出懸崖的古松
止住了下墜之勢，細看山崖中裂開了一條大縫，似乎可以攀緣而下。
LONG );
	set("exits", ([
		"up" : __DIR__"pubu",
		"down" : __DIR__"gudi",
	]));
	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me,string dir)
{
        if(dir=="up") 
	tell_object(me,"你攀著藤蔓，很艱難地向上爬。哎呀唷。，哎呀。。唷。。\n");
	return ::valid_leave(me,dir);
}

