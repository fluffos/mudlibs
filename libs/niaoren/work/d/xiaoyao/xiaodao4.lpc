// xiaodao4.c
// shilling 97.2

inherit ROOM;

void create()
{
	set("short", "林間小道");
	set("long", @LONG
這是一條長長的林間小道，從東邊一直通到西邊，一眼望去，看不到路
的盡頭。兩旁百花爭艷。令人留連忘返。
LONG );
	set("exits", ([
		"east" : __DIR__"shulin1",
		"west" : __DIR__"qingcaop",
		"north" : __DIR__"liangong",
		"south" : __DIR__"mubanlu",
	]));
 	set("objects", ([
		__DIR__"npc/mengmianr": 2,
	]));
	//set("outdoors", "xiaoyao");
	//set("no_clean_up", 0);
	setup();
}
int valid_leave(object me,string dir)
{
        if(dir=="west" && (!me->query("family") || (me->query("family/family_name")!="逍遙派")) && present("mengmian ren",environment(me))) 
             return notify_fail("蒙面人一個閃身，擋住了你的去路！\n");
        return ::valid_leave(me,dir);
}