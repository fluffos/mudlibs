inherit ROOM;

void create()
{
        set("short", "石級");
        set("long", @LONG
這是一段長長的石級，四周由于缺乏光亮，難免有點陰深深的感覺，石
級向著東西兩面伸展，一眼望去，不可以望到盡頭。
LONG );
	set("exits", ([
		"east" : __DIR__"shishi2",
		"west" : __DIR__"shidong",
		"north" : __DIR__"fangjian2",
	]));
	set("no_clean_up", 0);
	setup();
}
