inherit ROOM;

void create()
{
        set("short", "樹林");
        set("long", @LONG
這是一片茂密的樹林。很多棵几十丈高的大樹聚在一塊，象一把把瓊天
大傘，連日月都被遮蔽得暗然無光。樹林中還不時可以聽到大自然發出的聲響。
LONG );
        set("exits", ([
               "north" : __DIR__"shulin3",
               "south" : __DIR__"shulin1",
               "east" : __DIR__"shulin2",
               "west" : __DIR__"shulin2",
        ]));
	set("outdoors", "xiaoyao");
	set("no_clean_up", 0);
	setup();
}
