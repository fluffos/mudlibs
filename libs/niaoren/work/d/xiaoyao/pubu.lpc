// pubu.c 
// shilling 97.2

inherit ROOM;

#include <ansi.h>
void create()
{
        set("short", "瀑布");
        set("long", @LONG
你猛聽得水聲響亮，轟轟隆隆，便如潮水大至一般，抬頭一看，只見一
條大瀑布，猶如銀河倒懸，從高崖上直瀉下來。下面是萬丈深淵，云霧彌漫，
望不到盡頭。。。。
LONG );
        set("exits", ([ /* sizeof() == 2 */
                "east" : "/d/huashan/sheshen",
        ]));
        set("outdoors", "xiaoyao" );
        set("no_clean_up", 0);
        setup();
}
 
void init()
{
        add_action("do_jump","jump");
}

int do_jump(string arg)
{
        object ob;
        int new_gin;
        ob = this_player();
        new_gin = random( ob->query("max_gin")*3 );
        if ( new_gin > ob->query("gin") ) new_gin = ob->query("gin") + 1;
        if( !arg || arg=="" ) return 0;
        if( arg != "down" )
                return notify_fail("你想要跳崖自殺？這么想不開啊？\n");
        tell_object(ob, HIR"你不加思索，縱身一躍，跳下了懸崖。。。。\n"NOR);
        message("vision", NOR"只見" + ob->query("name") + "萬念俱灰，縱身跳入了懸崖之中。。。。\n"NOR, environment(ob), ob);
        if((random((int)ob->query("kar")) < 5 ) && ((int)ob->query_skill("dodge")<30) )
        {
                ob->die();
                return 1;
        }
        ob->add("gin", 0 - new_gin);
        ob->move(__DIR__"yanfeng");
        return 1;
}

