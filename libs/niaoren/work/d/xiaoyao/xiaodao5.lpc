// shilling 97.2

inherit ROOM;

void create()
{
	set("short", "林間小道");
	set("long", @LONG
這是一條從南到北的林間小道，沿途風景極之清幽，參天古樹，拔地而
起，兩旁百花爭艷。令人留連忘返。
LONG );
	set("exits", ([
		"south" : __DIR__"muwu1",
		"north" : __DIR__"qingcaop",
	]));
	set("no_clean_up", 0);
	set("outdoors", "xiaoyao");
	setup();
	replace_program(ROOM);
}
