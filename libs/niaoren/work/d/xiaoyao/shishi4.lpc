inherit ROOM;

void create()
{
	set("short", "地下石室");
	set("long", @LONG
這是一個地下的秘密石室，四面可以感覺得到的只有強烈的殺氣，以及
處身地底的一些難聞的氣味。在微弱的燈光下，你竟然看到有個人站著那里。
繼續往下好象還有路。
LONG );
	set("exits", ([
		"up" : __DIR__"fangjian2",
		"down" : __DIR__"shishi5",
	]));
	set("objects",([
		__DIR__"npc/qingyun" : 1,
	]));
	//set("no_clean_up", 0);
	setup();
}

int valid_leave(object me,string dir)
{
        if(dir=="down" && (!me->query("family") || (me->query("family/family_name")!="逍遙派")) && present("qingyun",environment(me))) 
             return notify_fail("青云一個閃身，擋住了你的去路！\n");
        return ::valid_leave(me,dir);
}

