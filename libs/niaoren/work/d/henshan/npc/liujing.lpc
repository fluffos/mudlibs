// liujing.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("劉菁", ({ "liu jing", "jing" }) );
        set("gender", "女性");
        set("class", "swordsman");
        set("long", "她是劉正風的女兒。\n");
        set("age", 17);
        set("attitude", "peaceful");
        set("per", 29);
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("max_qi",3000);
        set("max_jing",3000);
        set("combat_exp", 1000000);
        set("shen_type", 1);

        set_skill("force", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("sword", 100);
        set_skill("unarmed", 100);
        set_skill("literate", 100);
        set_skill("club", 100);
        set_skill("lingyuan-xinfa", 100);
        set_skill("qingdie-shenfa", 100);
        set_skill("tianchang-zhang", 100);
        set_skill("zhongping-qiang", 100);
        set_skill("hengshan-sword", 100);

        map_skill("sword", "hengshan-sword");
        map_skill("force", "lingyuan-xinfa");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("club", "zhongping-qiang");
        map_skill("unarmed", "tianchang-zhang");
        map_skill("parry", "hengshan-sword");

        create_family("衡山派", 14, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/female1-cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if (ob->query_int() < 22) {
                command("say 我衡山派武功講求悟性。");
                command("say 劍法要靈動瀟灑，高悟性是必要的。");
                command("say " + RANK_D->query_respect(ob) + "的悟性太低，還是請回吧。");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
}