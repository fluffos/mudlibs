// moda.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("莫大", ({ "mo da", "mo" }) );
        set("title", HIR"衡山派第十三掌門"NOR);
        set("nickname", "瀟湘夜雨");
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 55);
        set("attitude", "peaceful");
        set("per", 22);
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 200);
        set("max_qi",5000);
        set("max_jing",5000);
        set("combat_exp", 3000000);
        set("shen_type", 1);

        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("sword", 350);
        set_skill("unarmed", 350);
        set_skill("literate", 350);
        set_skill("club", 350);
        set_skill("lingyuan-xinfa", 350);
        set_skill("qingdie-shenfa", 350);
        set_skill("tianchang-zhang", 350);
        set_skill("zhongping-qiang", 350);
        set_skill("hengshan-sword", 350);

        map_skill("sword", "hengshan-sword");
        map_skill("force", "lingyuan-xinfa");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("club", "zhongping-qiang");
        map_skill("unarmed", "tianchang-zhang");
        map_skill("parry", "hengshan-sword");

        create_family("衡山派", 13, "掌門");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 160) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("chat* laugh");
        command("chat 衡山派是最強的拉。");
        command("recruit " + ob->query("id"));
}