// liu.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("劉正風", ({ "liu zhengfeng", "liu" }) );
        set("gender", "男性");
        set("class", "swordsman");
        set("long", "一個胖老者。恂恂有禮，便如一個財主鄉紳，有些小小的
富貴之氣，又有些土氣，但有時突然顯出勃勃英氣，不失
高手風范。\n");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 19);
        set("str", 60);
        set("con", 60);
        set("dex", 60);
        set("int", 60);

        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 100);
        set("max_qi",4000);
        set("max_jing",4000);
        set("combat_exp", 1500000);
        set("shen_type", 1);

        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("unarmed", 200);
        set_skill("literate", 200);
        set_skill("club", 200);
        set_skill("lingyuan-xinfa", 200);
        set_skill("qingdie-shenfa", 200);
        set_skill("tianchang-zhang", 200);
        set_skill("zhongping-qiang", 200);
        set_skill("hengshan-sword", 200);

        map_skill("sword", "hengshan-sword");
        map_skill("force", "lingyuan-xinfa");
        map_skill("dodge", "qingdie-shenfa");
        map_skill("club", "zhongping-qiang");
        map_skill("unarmed", "tianchang-zhang");
        map_skill("parry", "hengshan-sword");

        create_family("衡山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object(__DIR__"obj/luo_cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("sword", 1) < 80) {
                command("say 我五嶽劍派武功，最重視劍法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在劍法上多下點功夫？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("say 希望你能好好用功,發揚吾派劍法!");
        command("recruit " + ob->query("id"));
}