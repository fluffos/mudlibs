#include <room.h>
inherit ROOM;
int do_knock(string arg);

void create()
{
        set("short", "劉府西廂房");
        set("long", @LONG
這兒是西廂房，這兒整理得干干淨淨，窗外露出點綠綠的枝葉，家
具上一塵不染，地上鋪著很大塊的青磚，一點灰塵也不沾。劉府的小孩
們不知在這里悄悄說著什么。
LONG);
        set("exits", ([
            "east"   : __DIR__"liufudating",
        ]));
        set("objects", ([
                __DIR__"npc/liujing" : 1,
                __DIR__"npc/liuqin" : 1,
        ]));
//        set("no_clean_up", 0);
        setup();
}
