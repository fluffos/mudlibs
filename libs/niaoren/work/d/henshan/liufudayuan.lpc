#include <room.h>
inherit ROOM;
int do_knock(string arg);

void create()
{
        set("short", "劉府大院");
        set("long", @LONG
劉府大院里現在擠著很多江湖豪客，原來今天是劉正風金盆洗手的
好日子。劉老爺子在衡陽人緣很好，來捧場的自然不少，大院里已擺了
很多張桌子，杯筷往來，很是熱鬧。
LONG);
        set("exits", ([
            "north"  : __DIR__"liufudating",
            "out"    : __DIR__"liufugate",
        ]));
        set("objects", ([
                "/d/taishan/npc/dao-ke" : 1,
                "/d/taishan/npc/jian-ke" : 1,
                "/d/huashan/npc/haoke" : 1,
        ]));
//        set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}
