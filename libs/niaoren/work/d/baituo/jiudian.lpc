//jiudian.c

inherit ROOM;

void create()
{
        set("short", "酒店");
        set("long",
             "這里是一家獨具特色的酒店，由于地處『白駝山』下，\n"
         "酒店可以供應風味食品－－蛇肉。許多中原來客都愛來嘗嘗\n"
         "鮮，所以酒店生意興隆。酒店還經營打散裝酒的業務。\n"
        );
        set("exits", ([
                "south" : __DIR__"xijie",
        ]));
	set("objects",([
		__DIR__"npc/xiaoer" : 1,
	]));
//        set("no_clean_up", 0);
        set("resource/water", 1);
        setup();
}





