//shijie.c
inherit ROOM;

void create()
{
	set("short","石階");
	set("long",@TEXT
你走在青石板鋪成的石階上。這里就是傳說中神秘的白駝山。遠遠
望去，兩座白沙堆積形成的山峰好像一只駱駝的脊背。一座山門立在你
的眼前。
TEXT );
	set("exits",([
		"east" : __DIR__"caoping",
		"northup" : __DIR__"damen",
		"southdown" : __DIR__"guangchang" ,
	]));
	set("outdoors", "baituo");
//	set("no_clean_up", 0);
	setup();
}

