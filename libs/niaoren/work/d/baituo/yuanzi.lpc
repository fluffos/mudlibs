// yuanzi.c

inherit ROOM;

void init();
string look_gate();
int do_open(string);
int do_lock(string);

void create()
{
        set("short", "院子");
        set("long",
             "這是一個大院子，打掃得一塵不染。四周裝點著青青翠竹，錯落\n"
         "有致。西邊是武器庫。東邊有一間儲藏室，房門(door)關閉著。北邊\n"
         "是『白駝山庄』的大廳。南邊就是大門了。\n"
        );

        set("exits", ([
                "northup" : __DIR__"dating",
                "west" : __DIR__"wuqiku",
                "south" : __DIR__"damen",
        ]));

        set("outdoors", "baituo");
        set("no_clean_up", 0);

        set("item_desc", ([
            "door" : (: look_gate :),
        ]));

        set_temp("lock",1);

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_open", "open");
	add_action("do_lock", "lock");

}

string look_gate()
{
	if (query_temp("lock") == 0)
		return "門上的鐵鎖被打開了。\n";
	return "這扇門被鐵鎖牢牢鎖住。\n";
}

int do_open(string arg)
{
	object me=this_player(), room;

	if(!arg || arg!="door")
		return notify_fail("你要開什么？\n");

	if( query_temp("lock") == 1 && !present("key", me) )
		return notify_fail("鑰匙都沒有，怎么開門？\n");

	if(!( room = find_object(__DIR__"storeroom")) )
		room = load_object(__DIR__"storeroom");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'storeroom.c' \n");

	if(query_temp("lock") == 1 && present("key", me))
	{
		set_temp("lock", 0);
		message_vision("$N把鑰匙插進鎖孔，只聽見‘卡嗒’一聲，鎖開了。\n", me);
		message("vision", "外面傳來一陣開鎖的聲音，只聽見‘卡嗒’一聲，鎖開了。
  \n",room);
}
   message_vision("$N輕輕推開門，走了進去，隨手把門掩了起來。\n",me);
   message("vision", "有人走了進來，隨手把門掩上了。\n",room);
   me->move(room);
   return 1;
}

int do_lock(string arg)
{
	object me=this_player();
	object room;

	if(!arg ||  arg!="door")
		return notify_fail("你要鎖什么？\n");
	if( !present("key",me))
		return notify_fail("鑰匙都沒有，怎么鎖門？\n");
	if(!( room = find_object(__DIR__"storeroom")) )
		room = load_object(__DIR__"storeroom");
	if(!objectp(room))
		return notify_fail("ERROR:not found 'storeroom.c' \n");

	if(query_temp("lock") == 1)
		return notify_fail("門已經鎖好了。\n");
	set_temp("lock",1);
	message_vision("$N把鑰匙插進鎖孔，只聽見‘卡嗒’一聲，鎖被鎖上。\n",me);
	message("vision", "外面傳來一陣鎖鐵鎖的聲音，只聽見‘卡嗒’一聲，鎖被鎖上了。
  \n",room);

	return 1;
}

int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ((!myfam || myfam["family_name"] != "白駝山派") && dir == "west")
           return notify_fail("此處乃本派禁地，請止步。\n");

        return ::valid_leave(me, dir);
}
