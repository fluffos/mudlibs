//nongshe.c
inherit ROOM;

void create()
{
        set("short", "農舍");
        set("long",
             "這里是一間小農舍，家具很新。看來主人比較富裕。\n"
        );
        set("exits", ([
                "west" : __DIR__"guangchang",
        ]));
        set("objects",([
		__DIR__"npc/woman" : 1,
        ]));
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
