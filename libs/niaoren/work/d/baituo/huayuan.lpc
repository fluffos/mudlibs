{
  set("short","花園");
  set("long",
       "這是個美麗的大花園，園子里面種著鮮艷的紅玫瑰。\n"
   "白衣少女常來這里嬉戲。沿著彎彎曲曲的花徑，可以通到\n"
   "山庄的許多地方。東邊是廚房。西邊是白駝山少主『歐陽\n"
   "克』的內室，門虛掩著，不知主人在不在。\n"
      );
  set("exits",([
      "west" : __DIR__"neishi",
      "north" : __DIR__"zhuyuan",
      "east" : __DIR__"chufang",
      "south" : __DIR__"menlang",
     ]));
  set("outdoors", "baituo");
//  set("no_clean_up", 0);
  set("objects",([
    __DIR__"npc/whitelady" : 2,
    ]));
 setup();
}






