//ROM yuanzi

inherit ROOM;

void create()
{
        set("short", "大門");
        set("long",
             "這就是聞名天下的『白駝山庄』的大門。大門梁上雕龍刻鳳，美奐\n"
         "美侖，不知凝聚著多少能工巧匠的心血。更顯出庄主的富有與顯貴。門\n"
         "前左右各蹲著一只威武庄嚴的石獅子。\n"
        );
        set("outdoors", "baituo");
//        set("no_clean_up", 0);
        set("exits", ([
		"north" : __DIR__"yuanzi",
                "southdown" : __DIR__"shijie",
        ]));
        set("objects",([
                __DIR__"npc/menwei" : 2,
	]));
	setup();
}

int valid_leave(object me, string dir)
{

	if (  (dir == "north")
	   && ((int)me->query("shen") > 300)
	   && objectp(present("men wei", environment(me)))
	   && living(present("men wei", environment(me))))
	 return notify_fail
		("門衛把手一攔：你這種正派人物，老子一看就惡心，快滾！\n");
	return ::valid_leave(me, dir);
}
