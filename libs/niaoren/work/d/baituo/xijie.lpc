//xijie

inherit ROOM;

void create()
{
        set("short", "西街");
        set("long",
             "這里是小鎮的西街。北邊有個酒店，門前樹立著高高的旗\n"
         "杆，一塊青布幌子迎風飄揚，上面印著朱紅色的大字‘酒’。\n"
        );
        set("outdoors", "baituo");
        set("exits", ([
                "west" : __DIR__"bridge",
		"east" : __DIR__"dongjie",
                "north" : __DIR__"jiudian",
        ]));
	set("objects",([
		__DIR__"npc/man" : 1,
                __DIR__"npc/snaker"  :1,
	]));
//        set("no_clean_up", 0);
        setup();
}
