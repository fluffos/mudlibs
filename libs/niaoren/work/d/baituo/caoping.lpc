// caoping.c
inherit ROOM;
void create()
{
        set("short","草坪");
        set("long",
             "這里是一塊芳草坪，綠草茵茵，蝴蝶漫舞，讓人感到愜意。\n"
         "不過偶爾也會碰到菜花蛇。\n"
        );
        set("exits", ([
                "west" : __DIR__"shijie",
        ]));
        set("objects" , ([
             __DIR__"npc/caihuashe" : random(2),
        ]));
        set("outdoors", "baituo");
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
