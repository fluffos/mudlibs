//zhulin.c
inherit ROOM;
void create()
{
  set("short","竹林");
  set("long",
  "這里是青竹林，常有蛇出沒。南邊是蒿草叢。北邊有一個大岩洞。\n"
      );
  set("exits",([
      "northup" : __DIR__"cave",
      "south" : __DIR__"cao2",
     ]));
  set("objects",([
      __DIR__"npc/qingshe" : random(2),
      __DIR__"npc/snake" : random(3),
      ]));
//  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}

