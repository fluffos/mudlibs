//fang.c
inherit ROOM;
void create()
{
  set("short","練功房");
  set("long",
      "這里是白駝山弟子的練功房。里面有几個單間，是練功室。\n"
      "第子們在里邊砌磋武藝，絕對不允許外人打攪。\n"
    );
  set("exits",([
      "west" : __DIR__"liangong",
      "1" : __DIR__"room1",
      "2" : __DIR__"room2",
      "3" : __DIR__"room3",
     
     ]));

 set("objects",([
     __DIR__"npc/trainer" : 1,
     ]));

// set("no_clean_up", 0);
 setup();

}
int valid_leave(object who ,string dir)
{
 if((string)who->query("family/family_name")!="白駝山派"
    &&(dir!="west"))
   return notify_fail("那里禁止外人進入！\n");
 return 1 ;
}
