//dongjie

inherit ROOM;

void create()
{
	set("short", "東街");
	set("long",
	     "這里是小鎮的東街。南邊有個打鐵鋪，里面傳來丁丁當當\n"
	 "的聲音。東南方是荒涼的戈壁，東北方有條小路可上山。\n"
	);
	set("outdoors", "baituo");
	set("exits", ([
		"west" : __DIR__"xijie",
		"south" : __DIR__"datiepu",
		"southeast" : __DIR__"gebi",
		"northeast" : __DIR__"xiaolu1",
	]));
//        set("no_clean_up", 0);
	set("objects",([
		__DIR__"npc/playboy" : 1,
	]));
	setup();
}
