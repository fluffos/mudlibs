//room: sheyuan.c
inherit ROOM;

void create()
{
	set("short","蛇園");
	set("long", @LONG
這里是白駝山庄的蛇園。白駝山以毒名揚天下，最重要的
毒質就來自毒蛇。這里遍地是蛇，牆上也巴著蛇，屋檐上也向
下垂著蛇，樹枝上也盤繞著蛇，不由你不心驚。
LONG );
	set("exits",([
		"west"  : __DIR__"tuyuan",
	]));
	set("outdoors", "baituo");
	set("objects",([
		"/d/shenlong/npc/jinshe" :1,
		"/d/shenlong/npc/dushe" :1,
		"/d/shenlong/npc/fushe" :1,
		"/d/shenlong/npc/qingshe" :1,
		"/d/fuzhou/npc/wubushe" :1,
	]));
	setup();
	replace_program(ROOM);
}

