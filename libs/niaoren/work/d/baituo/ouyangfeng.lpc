
inherit NPC;
void greeting(object ob);
string inquiry_map();

void create()
{
        set_name("歐陽鋒", ({ "ouyang feng", "ouyang", "feng" }));
        set("long", "他是白駝山庄主，號稱“西毒”的歐陽鋒。\n"
                   +"由于習練「九陰真經」走火入魔，已變得精\n"
                   +"神錯亂，整日披頭散發，衣冠不整。\n");
        set("title", "老毒物");
        set("gender", "男性");
        set("age", 53);
        set("nickname","西毒");
 
        set("attitude", "peaceful");
 
        set("str", 30);
        set("int", 24);
        set("con", 30);
        set("dex", 24);
 
        set("qi", 500);
        set("max_qi", 500);
        set("jing", 300);
        set("str", 30);
        set("int", 24);
        set("con", 30);
        set("dex", 24);
 
        set("qi", 500);
        set("max_qi", 500);
        set("jing", 300);
        set("max_jing", 300);
        set("neili", 1500);
        set("max_neili", 1500);
        set("jiali", 50);
 
        set("combat_exp", 1500000);
        set("score", 200000);
        set_skill("force", 200);
        create_family("白駝山派",1, "開山祖師");

   // other set needed for future use.
        set("class", "taoist");
        set("inquiry", ([
        "地圖": (: inquiry_map :),
        ]));

        setup();
}
 
void init()
{
        object ob;
 
        ::init();
 
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch(random(3)) {
        case 0:write("你是誰？我要殺了你！哈‾哈‾哈‾")
                break;
        case 1:write("誰說我瘋了！我沒瘋‾");
                break;
        }
}
string inquiry_map()
{
	object ob;
	object me=this-player();
	if((string)me->query("family/family_name")!="白駝山派")
		return "我豈能把秘密告訴外幫弟子。你以為我真的啥都不知道了嗎？哈‾";
	else
	{
		if(me->query("combat_exp")<=10)
			return "哼！你剛拜完師就問這問那，難道想當家賊？小心我宰了你！";
    message_vision("歐陽鋒微微一笑，湊近$N的耳根，小聲嘀咕起來。",me);
    command("tell "+(string)me->query("id")+
              "這是從走出沙漠的正確通路，你要聽仔細。東。。");
    command("smile");
    return "記住了吧。";
   }
}
