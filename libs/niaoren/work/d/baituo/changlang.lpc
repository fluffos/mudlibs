inherit ROOM;

void create()
{
  set("short","長廊");
  set("long",
      "這里是非常氣派的長廊。北邊是間休息室。南邊有間藥房，里面傳來\n"
  "一陣器皿碰擊的聲音。西邊是扇拱月形小敞門。東邊是練功場。\n"
     );

  set("exits",([
      "west" : __DIR__"ximen",
      "north" : __DIR__"restroom",
      "east" : __DIR__"liangong",
      "south" : __DIR__"yaofang",
     ]));
//  set("no_clean_up", 0);

 setup();
}

