//bridge.c

inherit ROOM;

void create()
{
        set("short", "小橋");
        set("long",
             "這是一座小竹橋，『白駝山』上的冰雪融化形成一條清澈的小溪\n"
         "，從橋下緩緩流過。不時有頑皮的小魚躍出水面，在陽光下划出一條\n"
         "銀白色的弧線。\n"
        );
        set("outdoors", "baituo");
//        set("no_clean_up", 0);
        set("exits", ([
                "northwest" : __DIR__"guangchang",
                "east" : __DIR__"xijie",
        ]));
        set("objects",([
                __DIR__"npc/cungu" : 1,
        ]));
        setup();
}
