//wuqiku.c

inherit ROOM;

void create()
{
        set("short", "武器庫");
        set("long",
             "這里是『白駝山』弟子的武器庫，『白駝山』弟子可以到此\n"
         "拿取練功用的各種武器。不過別派弟子是不允許進來的。\n"
        );
        set("exits", ([
                "east" : __DIR__"yuanzi",
        ]));
        set("objects",([
             __DIR__"npc/shiwei" : 1,
             __DIR__"obj/shezhang" : 1,
             "/clone/weapon/gangzhang" : 2,
        ]));
//        set("no_clean_up", 0);
        setup();
}
int valid_leave(object me, string dir)
{
	int i, j;
	object *inv;
	inv = all_inventory(me);
	i = sizeof(inv);
	for (i = 0; i < sizeof(inv); i++)
	{
		if (inv[i]->query("id") == "gangzhang") j++;
	}
	if (j > 1)
                return notify_fail("這位" + RANK_D->query_respect(me) + "別那麼貪心，帶走一條鋼杖就夠啦。\n");
        return ::valid_leave(me, dir);
}

