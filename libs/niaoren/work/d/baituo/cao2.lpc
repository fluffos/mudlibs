//room:cao2.c

inherit ROOM;

void create()
{
  set("short","草叢");
  set("long",
      "這里是亂草叢。北邊是青竹林。其余三面都是齊腰高的蒿草，\n"
  "常有蛇出沒。\n"
     );
  set("exits",([
      "west" : __FILE__,
      "north" :__DIR__"zhulin",
      "east" : __DIR__"cao1",
      "south" : __DIR__"cao1",
     ]));
 set("objects",([
      __DIR__"npc/qingshe" : random(2),
      __DIR__"npc/jinshe" : random(2),
      __DIR__"npc/snake" : random(2),
      ]));
// set("no_clean_up", 0);
 set("outdoors","baituo");
 setup();
}


