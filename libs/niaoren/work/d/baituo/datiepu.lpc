inherit ROOM;

void create()
{
        set("short", "打鐵鋪");
        set("long",
             "這里是一家打鐵鋪，鐵匠忙著打制鐵制兵器，賣給江湖俠客。\n"
        );
        set("exits", ([
                "north" : __DIR__"dongjie",
        ]));
	set("objects",([
		__DIR__"npc/smith" : 1,
	]));
//        set("no_clean_up", 0);
        setup();
}

