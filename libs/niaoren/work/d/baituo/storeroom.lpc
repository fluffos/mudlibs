// storeroom.c

inherit ROOM;
void init();
int do_open(string);

void create()
{
        set("short", "儲藏室");
        set("long", "這是一個儲藏室，四周密不透風。只有關閉著的大門(door)。\n");
//      case(random(6))
//        { case 0 :
//          case 1:
//                set("objects" , ([
//                 "  " :        ,
//                   ]));
//                  break;
        set("item_desc" , ([
         "door" : "一扇木門，也許能打開。\n",
         ]) );
        set("no_clean_up", 0);
        setup();
//        replace_program(ROOM);
}

void init()
{
 add_action("do_open","open");
}

int do_open(string arg)
{
  object me=this_player();
  object room;
 if( !arg|| arg!="door")
  return notify_fail("你要開什么？\n");
 if(!( room = find_object(__DIR__"yuanzi")) )
    room = load_object(__DIR__"yuanzi");
 if(!objectp(room))  return notify_fail("ERROR:not found 'yuanzi.c' \n");
 if(room->query_temp("lock")==1)
   return notify_fail("門已經從外面鎖住了。\n");
 message_vision("$N輕輕推開門，走了出去，隨手把門掩了起來。\n",me);
 message("vision", "有人走了出來，隨手把門掩上了。\n",room);
 me->move(room);
 return 1;
}
