//room: /d/btshan/zhailou.c
inherit ROOM;

void create()
{
  set("short","小宅落");
  set("long",
      "這里是一個樹影婆娑的靜謐的小宅落，當中放著一口烏黑發亮的大\n"
  "水缸。白駝山上常年積雪，這里的主人架起一條長長的竹渠，把清涼的\n"
  "雪水引到家中的水缸里來。\n"
     );

  set("exits",([
      "west" : __DIR__"liangong",
     ]));

  set("no_clean_up", 0);
  set("outdoors", "baituo");
  set("resource/water", 1); 
  setup();

}





