//dongnei.c

inherit ROOM;

void create()
{
	set("short", "洞內");
	set("long",
	     "這里是山賊的老窩的所在。旁邊有一側洞，里面隱隱傳來女子的哭聲。\n"
	);
	set("exits", ([
		"west" : __DIR__"cedong",
		"south" : __DIR__"dongkou",
	]));
	set("objects",([
		__DIR__"npc/shanzei3" : 1,
	]));
//        set("no_clean_up", 0);
	setup();
}
int valid_leave(object me, string dir)
{

	if (  (dir == "west")
	   && objectp(present("shanzei tou", environment(me))) )
	 return notify_fail
		("山賊頭操起拳頭：你想占我老婆的便宜？快滾！\n");
	return ::valid_leave(me, dir);
}
