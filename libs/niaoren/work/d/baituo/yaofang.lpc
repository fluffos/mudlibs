//room: /d/btshan/restroom.c
inherit ROOM;

void create()
{
  set("short","藥房");
  set("long",
      "這里是間藥房，靠牆放著一只大藥柜。屋子里有張桌子，上邊擺滿了煉\n"
  "藥用的瓶瓶罐罐。其中一個藥瓶(bottle)里只裝了清水。煉藥師是位小姑娘\n"
  "，正在那里發呆，不知在想什么。北面是氣派的長廊。\n"
     );

  set("exits",([
      "north" : __DIR__"changlang",
     ]));

  set("item_desc",([
      "bottle" : "藥罐上貼著標簽：『蛇膽膏』，乃珍貴補品，生精補氣，效果奇佳。\n",
      ]));

  set("objects",([
// __DIR__"obj/wan" :1,
    __DIR__"npc/xiaoqing" : 1,
    ]));

//  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}

