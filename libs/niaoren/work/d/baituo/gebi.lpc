{
	set("short", "戈壁");
	set("long",
	     "這里是臨近沙漠的戈壁灘，荒無人煙。東邊是一望無際的大沙漠，\n"
	 "西北方可以看見一座小鎮。\n"
	);
	set("outdoors", "baituo");
        set("no_clean_up", 0);
