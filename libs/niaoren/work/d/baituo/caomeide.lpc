//ROOM caomeide.c
inherit ROOM;
void create()
{
        set("short","草莓地");
        set("long",
             "這里是一塊草莓地，鮮紅的草莓散落在綠草中，讓人感到美妙愜意。\n"
        );
        set("exits", ([
                "northeast" : __DIR__"shulin1",
        ]));
        set("objects" , ([
             __DIR__"obj/caomei" : random(7),
        ]));
//        set("no_clean_up", 0);
        set("outdoors","baituo");
        setup();
        replace_program(ROOM);
}
