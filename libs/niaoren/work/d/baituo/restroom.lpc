//restroom
inherit ROOM;

void create()
{
  set("short","休息室");
  set("long",
      "這里是間休息室，里面有張大床。在這里睡覺非常舒服，沒人能\n"
  "打擾。南面是氣派的長廊。\n"
     );

  set("exits",([
      "south" : __DIR__"changlang",
     ]));

  set("sleep_room", 1);
  set("no_fight",1);
  set("no_steal",1);
  set("no_clean_up", 0);

 setup();
 replace_program(ROOM);
}


