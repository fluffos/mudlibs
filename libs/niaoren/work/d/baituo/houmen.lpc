//room: houmen.c

inherit ROOM;

void create()
{
	set("short","后門");
	set("long",
       "這是個山庄的后門。這里有捷徑可以通向星宿海。\n"
	);
	set("exits",([
		"north" : "/d/xingxiu/xxh1",
		"south" : __DIR__"tuyuan",
	]));
        set("objects", ([
            __DIR__"npc/menwei" : 1 ,
        ]));
//        set("no_clean_up", 0);
	set("outdoors", "baituo");
	setup();
}

int valid_leave(object me, string dir)
{

	if (  (dir == "south")
	   && ((int)me->query("shen") > 300)
	   && objectp(present("men wei", environment(me)))) 
	 return notify_fail
		("門衛把手一攔：你這種正派人物，老子一看就惡心，快滾！\n");
	return ::valid_leave(me, dir);
}
