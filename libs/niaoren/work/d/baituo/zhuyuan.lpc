//zhuyuan.c
inherit ROOM;

void create()
{
  set("short","竹園");
  set("long",
      "這里是一個幽靜的竹園，高高低低的翠竹把這里裝點得\n"
  "別有情致。西北方是后院，東北方有個兔苑。南邊是花園。\n"
     );
  set("exits",([
      "northeast" : __DIR__"tuyuan",
      "northwest" : __DIR__"houyuan",
      "south" : __DIR__"huayuan",
     ]));
  set("no_clean_up", 0);
  set("outdoors", "baituo");
  setup();
}

