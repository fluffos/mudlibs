//ROM dating

inherit ROOM;

void create()
{
        set("short", "大廳");
        set("long",
             "這是『白駝山庄』的大廳，內部擺設極盡豪華，當中一張黑色檀木\n"
         "條案，上面陳放著精美的花瓶和一些珍貴的瓷器，四壁挂滿名家的字畫。\n"
        );
	set("valid_startroom",1);

        set("exits", ([
                "north" : __DIR__"liangong",
                "southdown" : __DIR__"yuanzi",
        ]));
 
        set("objects",([
		CLASS_D("btshan") + "/ouyangfeng" : 1,
                __DIR__"npc/yahuan" : 2,
        ]));
//        set("no_clean_up", 0);
        setup();

        "/clone/board/baituo_b"->foo();

}
