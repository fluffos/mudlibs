// smallbox.c
#include <ansi.h>
inherit ITEM;

void create()
{
	set_name("小鐵盒", ({"small box", "box"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
        	set("long",
"這只盒子小得多，只一尺見方。盒中一張箋上寫道：“君
是忠厚仁者，葬我骸骨，當酬以重寶秘朮。大鐵盒開啟時
有毒箭射出，愈中書譜地圖均假，上有劇毒，以懲貪欲惡
徒。真者在此小鐵盒內。”\n");
        	set("unit", "只");
        	set("open_count", 1);
        	set("weight", 1000);
        }
}

void init()
{
        add_action("do_open","open");
}

int do_open()
{
        object ob, me = this_player();
	if (query("open_count") > 0)
	{
       	        message_vision(HIR 
"$N伸手打開鐵盒，盒子里有三本書，上寫《金蛇秘笈》四字，用
鉗子揭開數頁，見寫滿密密小字，又有許多圖畫。有的是地圖，
有的是武朮姿勢，更有些兵刃機關的圖樣。\n" NOR, this_player());
	        add("open_count", -1);
                ob = new("/clone/book/jinshe1");
                ob -> move(me);
                ob = new("/clone/book/jinshe2");
                ob -> move(me);
                ob = new("/clone/book/jinshe3");
                ob -> move(me);
                return 1;
        }
        else return notify_fail("鐵盒已經被別人打開過了。\n");
}
