// buwei1.c

inherit ROOM;

void create()
{
        set("short", "有所不為軒");
	set("long", @LONG
這是華山掌門岳不群的居所「有所不為軒」，此處是前廳，廳上挂著
「正氣堂」三字匾額。廳中很寬敞，卻沒什么擺設，靠牆放著兩把交椅，
這里是岳不群議事、授徒的地方，后面是寢室。
LONG );
        set("exits", ([ /* sizeof() == 2 */
            "north" : __DIR__"buwei2",
            "south" : __DIR__"qunxianguan",
            "west"  : __DIR__"garden",
            "east"  : __DIR__"buwei3",
	]));
        set("objects", ([
             __DIR__"npc/dayou": 1,
             __DIR__"npc/little_monkey": 1,
        ]) );

//        set("no_clean_up", 0);
        setup();
}
int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam=(mapping)me->query("family");
	if ((!myfam ||myfam["family_name"] != "華山派") && dir == "north" &&
		objectp(present("lu dayou", environment(me))))
		return notify_fail(
"陸大有喝道：后面是家師寢室，這位" + RANK_D->query_respect(me) + "請止步。\n");
	return ::valid_leave(me, dir);
}
 
