#include <room.h>
inherit ROOM;

void create()
{
      set("short","小山路");
      set("long",@LONG
這里是華山的一條小山路，地勢較為平緩，不似其它地方那么\險
峻。你走在這里，四周靜悄悄的，你就象走進了一個世外桃源。東面
好象有一扇竹門(men)。
LONG);
      set("outdoors", "xx");
      set("exits",([ /* sizeof() == 1 */
          "southwest"  : __DIR__"xiaolu1",
          "east"       : __DIR__"xiuxishi",
      ]));
      create_door("east", "竹門", "west", DOOR_CLOSED);
      setup();
}
