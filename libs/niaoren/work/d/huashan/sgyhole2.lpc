// Room: /d/huashan/sgyhole.c

inherit ROOM;

void create()
{
        set("short", "山洞");
        set("long", @LONG
這是一個極大的山洞，以容得不千人之 眾，洞中有七具骸骨，
或坐或臥，身旁均有兵刃，一對鐵牌，一對判官筆， 一根鐵棍，
一根銅棒，一具似是雷震擋，另一件是生滿狼牙的三尖兩刃刀，
更有一件兵刃似刀非刀，似劍非劍，從來沒有見過。右首山壁旁
數丈處突出一塊大石，似是個平台(pintai)
LONG );
        set("exits", ([ /* sizeof() == 4 */
            "east"     : __DIR__"sgyhole",
        ]));
       set("objects", ([
                    "/clone/misc/skeleton": 1,
               ]));
        set("item_desc", ([
            "pintai" : @TEXT
          五岳劍派，無恥下流，比武不勝， 暗算害人
          卑鄙無賴 可恥已極 低能 懦怯
TEXT
        ]));
        set("no_clean_up", 0);

        setup();
}
