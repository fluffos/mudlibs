// Room: /d/huashan/lianhua.c

inherit ROOM;

void create()
{
        set("short", "蓮花峰");
        set("long", @LONG
太華西峰－又名蓮花峰，也叫芙蓉峰，峰頂有一塊巨石，狀如蓮花，覆蓋
崖巔。該處由此得名。這里懸崖陡峭，壁立千仞，登臨遠眺，秦川莽莽，渭、
洛二水盤屈如帶。峰頂有石名“摘星石”，取“手可摘星辰”之意，以狀西峰
之高。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
             "eastdown" : __DIR__"chengxiang",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "huashan");

        setup();
        replace_program(ROOM);
}
 
void init()
{
        object me = this_player();
        if (me->query_temp("xunshan")) me->set_temp("xunshan/lianhua", 1);
        return;
}
