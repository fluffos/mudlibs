// yunu.c

inherit ROOM;

void create()
{
        set("short", "玉女峰");
	set("long", @LONG
這里是華山的中峰，玉女峰。傳說春秋時隱士蕭史善吹洞簫，簫聲引
動了秦穆公女兒弄玉的愛慕，拋棄了宮廷生活，跟蕭史來此隱居，故稱玉
女峰。這里地勢略為平緩，不似其它四峰般險峻，江湖上赫赫有名的華山
劍派就在此處。東邊有所小小的廟宇，那就是玉女祠了。北面稀稀落落有
十几間房子，是華山派的地方，閑雜游客最好別往那里去。
LONG
        );
        set("exits", ([ /* sizeof() == 3 */
            "westdown"  : __DIR__"zhenyue",
            "west"      : __DIR__"yunuci",
            "north"     : __DIR__"square",
            "southdown" : __DIR__"yunupath1",
            "northeast" : __DIR__"xiaolu1",
       ]));
       set("objects", ([
            __DIR__"npc/yue-lingshan" : 1,
       ]));

//        set("no_clean_up", 0);
        set("outdoors", "xx" );

        setup();
}
 
