//Room: siguoya.c 思過崖
//Date: Oct. 2 1997 by Venus
#include <ansi.h>
inherit ROOM;
int do_break(string arg);
void close_out();

void create()
{
      set("short","思過崖");
      set("long",@LONG
這里便是華山派弟子受罰思過的地方。位于玉女峰頂，正好有一
小快平地，一面是深不可測的山谷、一面是陡峭的懸壁(bi)，零零落
落的有几快山石。
LONG);
      set("outdoors", "xx");
      set("objects", ([
          __DIR__"npc/ling-huchong": 1,
      ]));
      set("item_desc", ([
"bi":"你看著看著忽然發現有一處石壁上的青苔比別處少得多。不禁想....\n",
      ]));
      set("exits",([ /* sizeof() == 1 */
          "northdown" : __DIR__"yunupath2",
      ]));
      setup();
}

string look_bi()
{
        return
"你看著看著忽然發現有一處石壁上的青苔比別處少得多。不禁想....\n";
}
void init()
{
     add_action("do_break", "break");
}
int do_break(string arg)
{
     object me,weapon;
     mapping fam;

     me = this_player();
     if( (fam = me->query("family")) && (fam["family_name"] != "華山派")
        || !arg || arg!="bi" ) return notify_fail("這是干嘛？\n");
     if (!objectp(weapon = me->query_temp("weapon"))
         || (string)weapon->query("skill_type") != "sword")
         return notify_fail("你一掌打在石壁，滿手都是鮮血。\n");
     if (me->query("neili") < 200)
     {
         me->set("qi",10);
         me->add("qi",-10);
         return notify_fail("你走到石壁前，拔出腰間所懸長劍，運勁向石壁刺了過去。
\n結果只聽一聲悶哼，$N被石壁的反彈力震得眼前一黑....");
     }
     message_vision(HIC"$N一劍將石壁刺個透明，露出洞來。\n"NOR,me);
     set("exits/enter",__DIR__"sgyhole");
     remove_call_out("close_out");
     call_out("close_out", 3);
     return 1;
}
void close_out()
{
    if (query("exits/enter")) delete("exits/enter");
}
