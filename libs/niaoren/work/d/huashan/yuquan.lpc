// yuquan.c

inherit ROOM;

void create()
{
        set("short", "玉泉院");
        set("long", @LONG
這里因屋后的玉泉而得名，是宋代陳希夷隱居的地方。周圍生著十二
株大龍藤，夭矯多姿，枝干中空，就如飛龍相似，相傳是希夷先生陳摶老
祖所植。院內綠蔭蔽日，泉石如畫，流水縈回，回廊曲折。院中有清泉一
股，泉水甘冽，傳與山頂鎮岳宮玉井相通，故名玉泉，玉泉院因此得名。
LONG );
        set("exits", ([ /* sizeof() == 1 */
            "south" : __DIR__"path1",
        ]));
//        set("no_clean_up", 0);
        set("objects", ([
                __DIR__"npc/teller": 1
        ]) );

        setup();
        replace_program(ROOM);
}
 
