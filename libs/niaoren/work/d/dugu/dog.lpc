inherit ROOM;
#include <ansi.h>
void create()
{
          set("short",BLINK "鐵公雞樓" NOR);
        set("long",
"這里是獨孤山莊的金主鐵公雞的專用大樓，裡面全是這位又色又無聊的人的東西\n"
"看來這兒似乎是還沒完工，快叫尼克大神來作吧，嘿嘿嘿！一旁有塊小板子(list)\n"
);
        set("exits", ([ /* sizeof() == 2 */
            "east"      : __DIR__"opq_bu",
        ]));
        set("objects", ([ "/kungfu/class/dugu/dog.lpc" : 1,
                          "/kungfu/class/dugu/ting.lpc" : 1,
                          "/kungfu/class/dugu/robert.lpc" : 1,
                       ]) );
        set("item_desc",([
            "list"   : HIG"                           沒事不要亂看！"NOR"\n
                                  _
                                ／ ＼
                                ||_||
                                |---|
                                |   |
                                |   |
                              _ |=-=| _
                          _  / ||   |/ |
                         / ||   |   |   |||
                        |   |   |   |   | |>
                        |   |   |   |   |   |
                        | -   -   -   - |)   )
                        |         鳥         /
                         ＼       人        /
                          ＼      萬       /
                           ＼     歲      /
                            ＼    ！     /
                             |         |
                               看三小！          \n",]) );
        set("no_clean_up", 0);
        set("outdoors", "xx" );

        setup();
}

