// sundo.c

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "隱密的山洞");
        set("long", @LONG
來到這忽然覺得四周盡是花花草草，沒想到在山洞中竟有這種美麗的地方，
這兒一定是有人長年照顧，前方的亮處傳來陣陣的練功聲，這個場景令人想
起武林傳說中的一位強者“問天“所一手建立的問天山莊，看來這會兒到是
誤打誤撞來到這武林聖地了，一旁的樹藤中似乎有塊牌子(list)。
LONG );
        set("exits", ([
               "north" : __DIR__"dugu_gate",
                "out" : "/d/wudang/songlin3",
        ]));
        set("no_clean_up", 0);
        set("item_desc",([
            "list"   : HIG"問天山莊"NOR"就在前面，不想死的人還是快回去吧！\n
                                       整理這裡的阿伯仔留\n",]) );
