// rest_room.c 獨孤山莊休息室
// Made by Jordan

#include <ansi.h>
inherit ROOM;

void create()
{
            set("short",BLINK "獨孤山莊休息室" NOR);
        set("long",
"這是獨孤山莊休息室，裡面佈置十分優雅，四周光線充足，牆上的冷氣\n"
"正吹著陣陣的涼風，相當舒服，右邊一組豪華的"YEL"牛皮沙發"NOR"，50吋的電視正撥\n"
"放著由阿豆仔「湯姆克魯斯」所主演的「"HIB"Mission Impossible II"NOR"」，中央是\n"
"一張由波斯進口的"HIW"大型特製水床"NOR"，床單剛剛換新的，十分舒服，讓人一見就\n"
"想上去躺躺 ！\n"
);
        set("no_fight",1);
        set("sleep_room",1);
        set("no_steal",1);
        set("exits",([
                "west" : __DIR__"dugudoor1",
        ]));
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
