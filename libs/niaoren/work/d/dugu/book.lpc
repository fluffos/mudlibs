// book.c 獨孤山莊藏書閣
//made by jordan
#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",BLINK "獨孤山莊藏書閣一樓" NOR);
        set("long", 
"這是獨孤山莊藏書閣，裡面陳列了各門各派的武功心法及破解之道，\n"
"傳聞裡面有莊主問天畢生武功的精華"BLINK""MAG"「問天神功」"NOR"的秘笈，此處目前由莊\n"
"主問天的結拜兄弟二莊主"HIC"青天"NOR"鎮守，閒雜人等勿進。 \n"
);
        set("outdoors", "xx");
        set("exits",([ /* sizeof() == 1 */
            "west": __DIR__"opq_bu",
        ]));
        set("objects", ([
                CLASS_D("dugu")+"/cms" : 1,
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
void init()
{
        object me;
        me=this_player();

        if (me->query_dex() > 50)
             this_object()->set("exits/up", "/d/dugu/book1");
	else
             this_object()->delete("exits/up");
        remove_call_out("close");
        call_out("close", 5, this_object());
        return;
}
void close(object room)
{
        this_object()->delete("exits/up");
        return;
}

