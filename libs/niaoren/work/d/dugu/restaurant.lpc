//restaurant.c 吉斯大餐廳
//made by jordan
#include <ansi.h>
inherit ROOM;
void create()
{
          set("short",BLINK "吉斯大餐廳" NOR);
        set("long",
"這是獨孤山莊的吉斯大飯店，一位頭戴廚師帽，身穿"HIW"白色廚師衣"NOR"，身材微胖的廚師\n"
"正在做菜，只見他刀法俐落，鏟法也相當高明，"RED"大火高溫"NOR"下竟不流一滴汗，內功深厚異\n"
"常，原來他就是武林之中頂頂有名的天下第一廚「"HIG"吉斯"NOR"」，你可以跟大廚師吉斯點(da) \n"
"些吃的喝的。牆上貼著一張POP海報(pop)。\n"
);
        set("exits",([
                "east" : __DIR__"dugudoor1",
        ]));
        set("item_desc",([
                "pop" : MAG "每日一菜"NOR"："HIY"黃金炒飯"NOR"，"CYN"熊掌燕窩魚翅湯"NOR"。\n",
        ]));
        set("objects", ([
                CLASS_D("dugu")+"/chess" : 1,
        ]));
//      set("no_clean_up", 0);
        set("ricewater", 10);
        set("no_fight","1");
        setup();
}
int valid_leave(object me, string dir)
{
        if ( present("soup", me) || present("rice", me))
        return notify_fail("吉斯瞪了你一眼: 吃不了要兜著走啊? \n");
        return ::valid_leave(me, dir);
}

void init()
{
        add_action("do_da","da");
}

int do_da()
{
        object me;
        object food;
        object jitui;
        object water;
        me=this_player();
        if (me->query("family/family_name") != "獨孤山莊")
                return notify_fail("吉斯道：你不是獨孤山莊弟子，後面的狗食請自便吧。\n");
        if(present("rice",this_player()) ) 
                return notify_fail("吉斯道：吃完了再拿，別浪費食物。\n");
        if(present("rice",this_object()) ) 
                return notify_fail("吉斯道：吃完了再拿，別浪費食物。\n");
        if (query("ricewater")>0)
        {
                message_vision("吉斯連聲答應，給$N一碗黃金炒飯和一碗熊掌燕窩魚翅湯還有一隻雞腿。\n",me);
                food=new(__DIR__"obj/chess_rice");
                water=new(__DIR__"obj/chess_soup");
                jitui=new("/clone/food/jitui");
                food->move(me);
                water->move(me);
                jitui->move(me);
                add("ricewater",-1);
        }
        else 
                message_vision("吉斯對$N歉聲道: 現在不是吃飯時間，不開伙。\n",me);
        return 1; 
}
