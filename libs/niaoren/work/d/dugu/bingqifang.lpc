// bingqifang.c 兵器房
#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",BLINK "兵器房" NOR);
        set("long", @LONG
這里是獨孤山莊的兵器房，四周放這几個兵器架，上面是獨孤山莊各弟子
平時練功用的竹劍。
LONG );
        set("exits", ([
                "west" : __DIR__"square",
        ]));
        set("objects", ([ 
            "/clone/weapon/zhujian" : 5
        ]));
//      set("no_clean_up", 0);
        set("no_fight", 1);

        setup();
}
int valid_leave(object me, string dir)
{
	int i, j;
	object *inv;
	inv = all_inventory(me);
	i = sizeof(inv);
	for (i = 0; i < sizeof(inv); i++)
	{
		if (inv[i]->query("id") == "zhujian") j++;
	}
	if (j > 1)
                return notify_fail("這位" + RANK_D->query_respect(me) + "別那麼貪心，帶走一把竹劍就夠啦。\n");
        return ::valid_leave(me, dir);
}
