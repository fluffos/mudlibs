// chess_cloth.c 吉斯廚師服
//made by jordan

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(HIW"廚師服"NOR, ({ "chess_cloth" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "這是一件皇帝御賜的廚師服，上面寫天下第一廚「吉斯」。\n");
                set("material", "cloth");
		set("value", 0);
                set("armor_prop/armor", 100);
        }
        setup();
}

