// justice.c 尚方寶劍
#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
        set_name(HIY "尚方寶劍" NOR,({"justice","sword","jian"}));
        set_weight(1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIY "此劍是天界劍神問天賜給青天的寶劍，乃天界十大天神兵之一，代表著公平正義。\n" NOR);
                set("value", 150000);
                set("material", "iron");
                set("wield_msg", HIY "尚方寶劍似有靈性地躍出劍鞘，落在$N手中，一股正義之氣凝聚在你的手中，此時的你嫉惡如仇，
你附近的邪惡之氣頓時消失無蹤。\n" NOR);
                set("unwield_msg", HIY "尚方寶劍感應到四周已無邪惡之氣，自動脫離$N手上，回到劍鞘裡。\n" NOR);
        }
        init_sword(200);
        setup();
}
int query_autoload()
{
   return 1;
}
