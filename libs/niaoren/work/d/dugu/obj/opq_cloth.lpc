// opq_cloth.c 小問天的衣服
// made by jordan

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(HIM"紫"HIY"金"HIW"球衣"NOR, ({ "cloth" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "這是一件美國NBA湖人隊的球衣，是問天派人專程去美國採買的。\n");
                set("material", "cloth");
		set("value", 0);
                set("armor_prop/armor", 200);
        }
        setup();
}

