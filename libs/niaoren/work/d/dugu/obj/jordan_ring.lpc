// jordan_ring.c 問天的戒指

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
	set_name(HIW "問天的戒指" NOR, ({ "jordan_ring", "ring" }));
       	set("long", HIW "這是天界劍神問天平時戴的戒指，傳聞此戒指擁有不平凡的能量。\n");
	set("weight", 200);
	set("wear_msg", HIW "你戴上$n" +HIW "，一股優雅的風範出現在你的臉上，令人著迷，而且全身正被一股無形的能量
保護著。\n" NOR);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("value", 1000000);
		set("material", "鑽石");
		set("armor_prop/armor", 1000);
		set("armor_prop/personality", 20);
		set("male_only", 1);
	}
	setup();
}	
