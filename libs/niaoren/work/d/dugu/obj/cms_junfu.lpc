// cms_junfu.c 青天的空軍軍服
#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
	set_name(HIC"空軍軍服"NOR, ({ "junfu", "cloth" }));
	set("long", "這是一件肩掛上校的空軍軍服服。\n");
	set_weight(2000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("material", "cloth");
		set("unit", "件");
		set("value", 200);
		set("armor_prop/armor", 100);
	}
	setup();
}
