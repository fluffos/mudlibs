// chess_rice.c 吉斯黃金炒飯

inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

void create()
{
	set_name(HIY"黃金炒飯"NOR, ({ "rice", "mi fan" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碗香噴噴的黃金炒飯。\n");
		set("unit", "碗");
		set("value", 80);
		set("food_remaining", 5);
		set("food_supply", 25);
		set("material", "rice");
	}
	setup();
}

