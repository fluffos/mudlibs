// chess_soup.c 吉斯熊掌燕窩魚翅湯
// made by jordan
inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>
void create()
{
	set_name(MAG"熊掌燕窩魚翅湯"NOR, ({"soup"}));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一碗香氣扑鼻的熊掌燕窩魚翅湯。\n");
		set("unit", "碗");
		set("value", 80);
        set("max_liquid", 4);
    }

    // because a container can contain different liquid
    // we set it to contain tea at the beginning
    set("liquid", ([
        "type": "water",
        "name": "熊掌燕窩魚翅湯",
        "remaining": 7,
        "drunk_supply": 25,
    ]));
}
