//crystal.c 天晶神劍 
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIC "天晶神劍" NOR,({"crystal","sword","jian"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIC "此劍是天下第一劍問天的配劍，乃天界十大天神兵之首，代表天下無敵。\n" NOR);
                set("material", "steel");
                set("no_drop", RED "如此寶貴的武器再世難求啊。\n" NOR);
                set("no_get", RED "送人？虧你想的出來！\n" NOR);
//              set("no_put", MAG "珍惜它吧。\n" NOR);
                set("value", 200000);
                set("wield_msg", HIC "天晶神劍自動躍出劍鞘，落在$N手中，放射出水晶般的燦爛光芒，瑰麗絕倫，靈光閃動，
你突然全身充滿了天驚地動的力量。\n" NOR);
                set("unwield_msg", HIC "$N手中的天晶神劍自動回鞘，周圍那神奇的光芒漸散，你那天驚地動的力量也消失了。\n" NOR);
       }
       init_sword(500);
       setup();
}

void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}
