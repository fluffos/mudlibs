// book1.c 獨孤山莊藏書閣二樓
// made by jordan
#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",BLINK "藏書閣二樓" NOR);
        set("long", 
"這是獨孤莊主"HIY"問天"NOR"閉關的地方，此處環境清幽，窗外望去一片"HIG"山林綠野"NOR"，空氣清新，一股\n"
"徐徐的暖風吹來，好不快活，你一到此只覺得四周洋溢著一股無形的"HIW"劍氣"NOR"(sword_qi)，這股劍\n"
"氣隱隱約約地形成了一些奇妙的招式，讓你不禁想跟著一起"HIR"舞劍"NOR"(wu_sword)。\n"
);
        set("exits", ([ /* sizeof() == 4 */
            "down" : __DIR__"book",
        ]));
        set("item_desc", ([ 
            "sword_qi" : HIW"

       o     |o     o   \\ o     o       o     <o    <o>
    --^|\\    ^|^ --v|^   v|v   |/v    \\|X|    \\|     |
       /\\     >\\   /<     >\\    /<      >\\    /<     >\

       o>     o      o      o      o      o      o       o
       \\ __   x     </     <|>    </>    <\\>    <)>     |\\__
       /<      >\\  /<       >\\   /<      >\\     >>      L
\n"NOR
        ]));
        set("no_clean_up", 0);

        setup();
}
void init()
{
        add_action("do_wusword", "wu_sword");
}

int do_wusword
()
{
   object ob;
   int c_exp,c_skill;
   ob = this_player();

   c_skill=(int)ob->query_skill("sword", 1);
   if (c_skill <50)
   {
      message_vision("$N的基本劍法顯然太低，無法跟的上無形劍氣的速度。\n",ob);
      return 1; 
   }
   c_exp=ob->query("combat_exp");

   if ((c_skill*c_skill*c_skill/10)> c_exp)
   {
      message_vision("$N的實戰經驗不足，簡直對牛彈琴。\n",ob);
      return 1; 
   }
   if (ob->query("jing")<20)
   {
      message_vision("$N太累了，根本沒辦法感覺到無形劍氣。\n",ob);
      return 1; 
   }
   if (c_skill>300)
   {
      message_vision("$N覺得無形劍氣舞的太簡單了。\n",ob);
      return 1; 
   }

   message_vision("$N憑感覺跟著無形劍氣一起舞劍，過了一刻鐘，你對基本劍法似有所悟。\n",ob);
   ob->improve_skill("sword", random(10*ob->query("int")));
   ob->add("jing",-10);
   return 1;
}

