// dugu_gate.c 獨孤山莊大門口
// made by jordan
#include <ansi.h>
#include <room.h>
inherit ROOM;


void create()
{
        set("short", BLINK HIR "獨"HIY"孤"HIG"山"HIC"莊"NOR);
        set("long", 
"這是武林名宿獨孤山莊的所在地，當初獨孤山莊的開山祖師看中這塊龍穴，\n"
"在這裡興建了獨孤山莊，此莊氣派非凡，目前由莊主問天當家，並廣招人馬，\n"
"成為天下第一大莊。\n"
);
        set("exits", ([
                "south"     : __DIR__"sundo",
                "north"     : __DIR__"square",
        ]));
//      set("no_clean_up", 0);
        set("objects", ([
                CLASS_D("dugu") + "/zzz" : 1
        ]));
        setup();
}

