// jordan_bu.c 問天樓
// made by jordan
#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",BLINK HIC "問天樓" NOR);
        set("long",
"                                                    \n"
"              "HIC"------------------------"NOR"                  \n"
"              "HIC"|"NOR" "BLINK""HIY"問       天       樓"NOR""HIC" |"NOR"\n"
"              "HIC"------------------------"NOR"                  \n"
"這裡是獨孤山莊問天樓，是莊主"HIY"問天"NOR"平時居家休閒的地方，這四週充\n"
"斥著強烈無比的"HIC"劍氣"NOR"，在這兒你感覺到一種"HIW"浩然光明"NOR"的力量在保護著\n"
"你，你的心靈似乎更平靜，據說這房間暗藏著一個玄機，但是至今無\n"
"人能說出那到底是什麼！\n"
);
        set("no_fight", 1);
        set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"leos_shen",
                "south" : __DIR__"opq_bu",
        ]));
        set("objects", ([
                CLASS_D("dugu")+"/jordan" : 1,
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
void init()
{
        object me;
        me=this_player();
        if (me->query_dex() > 70)
             this_object()->set("exits/up", "/d/dugu/anywhere");
	else
             this_object()->delete("exits/up");
        remove_call_out("close");
        call_out("close", 5, this_object());
        return;
}
void close(object room)
{
        this_object()->delete("exits/up");
        return;
}
