// square.c 獨孤山莊練武場
//made by jordan
inherit ROOM;
#include <ansi.h>
void create()
{
          set("short",BLINK "獨孤山莊練武場" NOR);
        set("long",
"這里是獨孤山莊的練武場，場上立這几個木人，東邊是獨孤山莊兵器庫，西邊是\n"
"獨孤山莊進階練武場。通常有許多獨孤山莊弟子在此習武練劍。南邊的大門上掛著一\n"
"塊霓虹燈的匾額，上書「"BLINK""HIR"獨"HIY"孤"HIG"山"HIC"莊"NOR"」四個大字。\n"
);
        set("exits", ([ /* sizeof() == 2 */
            "south"     : __DIR__"dugu_gate",
            "north"     : __DIR__"dugudoor1",
            "west"      : __DIR__"square1",
            "east"      : __DIR__"bingqifang",
        ]));
        set("objects", ([
            "/d/shaolin/npc/mu-ren" : 10,
        ]));
//        set("no_clean_up", 0);
        set("outdoors", "xx" );

        setup();
}
 
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam=(mapping)me->query("family");
        if ((!myfam ||myfam["family_name"] != "獨孤山莊") && (dir == "east"))
                return notify_fail(
"那邊是獨孤山莊的兵器庫，這位" + RANK_D->query_respect(me) + "請止步。\n");
        return ::valid_leave(me, dir);
}
 
