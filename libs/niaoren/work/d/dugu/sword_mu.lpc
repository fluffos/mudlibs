// sword_mu.c
#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",BLINK "劍塚" NOR);
        set("long",
"這是獨孤山莊的禁地「"HIR"劍塚"NOR"」，地面上橫七豎八地插著數以萬計的名劍，\n"
"石壁上有几百幅用利器刻成的簡陋人形(map) 。圖形盡處，石壁上出現了二\n"
"十個字("BLINK""HIY"word"NOR")，也是以利器所刻，這二十個字個字散發出動人的光芒，似是\n"
"以高深的內力所留。二十個字之旁，有一柄散發出水晶般強光的劍插在劍塚\n"
"裡最高的石柱上，只見此劍放射出水晶般的燦爛光芒，瑰麗絕倫，靈光閃動\n"
"，此乃天界十大天神兵之首的"HIC"天晶神劍"NOR"。\n"
);
        set("outdoors", "dugu");
        set("sword_count", 1);
        set("exits", ([ /* sizeof() == 2 */
            "east" : __DIR__"leos_shen",
        ]));
        set("item_desc", ([
            "map"  : "石壁每個人形均不相同，舉手踢足，似在練武。\n",
            "word" : "“"BLINK""HIC"劍在手不現"NOR"  "BLINK""HIM"道在心不留"NOR"  "BLINK""HIY"招在訣不在"NOR"  "BLINK""HIG"無劍又無天"NOR"”\n",
        ]) );
        set("no_clean_up", 0);
        setup();
}
void init()
{
        add_action("do_think", "think");
        add_action("do_pull", "pull");
}
int do_pull(string arg)
{
        object ob, me= this_player();
	if (arg != "sword") return 0;
	if (query("sword_count") < 1)
		return notify_fail("天晶神劍好象已經被人拔走了。\n");
        if (this_player()->query("neili") < 4000)
        {
                message_vision(
"$N好奇心起，握住天晶神劍劍柄向外一拔，卻是紋絲不動，竟似鑄在石里一般。\n", me);
                me->set("neili", 1000);
                return 0;
        }
        ob = new(__DIR__"obj/crystal");
        ob->move(me);
                message_vision(
"$N緊緊握住"HIC"天晶神劍"NOR"劍柄，潛運內力，只見你滿頭大汗，終於拔出了"HIC"天晶神劍"NOR"。\n", me);
        me->add("neili",-4000);
	add("sword_count", -1);
        return 1;
}
int do_think(string arg)
{
        object ob;
        int c_exp,c_skill;
        ob = this_player();

	if (arg != "map") return 0;
        c_skill=(int)ob->query_skill("god-sword", 1);
        c_exp=ob->query("combat_exp");

        if ((c_skill*c_skill*c_skill/10)> c_exp)
        {
                message_vision("$N的實戰經驗不足，無法領悟石壁上天劍神訣精妙的招式。\n",ob);
                return 1; 
        }
        if (ob->query("jing")<20)
        {
                message_vision("$N太累了，現在無法領悟石壁內容。\n",ob);
                return 1; 
        }
        if (c_skill> 50)
        {
                message_vision("$N覺得石壁內容太膚淺了。\n",ob);
                return 1; 
        }

        message_vision("$N面對著石壁靜思良久，對天劍神訣似有所悟。\n",ob);
        ob->improve_skill("god-sword", random(10*ob->query("int")));
        ob->receive_damage("jing", 20);
        return 1;
}

