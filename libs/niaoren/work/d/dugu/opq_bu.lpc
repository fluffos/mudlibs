#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",BLINK "小問天樓" NOR);
    set("long", 
"這是獨孤山莊小問天樓，整個大樓十分寬闊，適合玩耍，廳中挂滿了各種玩具，\n"
"一看就知道是小孩子的房間，裡面更有"HIW"室內籃球場"NOR"供小問天打籃球用。\n"
"東邊是獨孤山莊藏書閣，西邊是鐵公雞錢莊房，北邊是問天樓，南邊是中庭花園。\n"
"                                                                               \n"     
HIW "                 -|-O                     O-|-
                 |                           |     
                 |                           |
                 |          O                |
                 |         /|>               | 
            _____M________O<_<_______________M_____                 
\n"NOR
);
        set("exits", ([
            "north" : __DIR__"jordan_bu",
            "south" : __DIR__"dugudoor1",
            "east"  : __DIR__"book",
            "west"  : __DIR__"dog" ,
        ]));
        set("objects", ([
            "/kungfu/class/dugu/opq.lpc" : 1,
        ]) );    
        set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("no_beg", "1");
        setup();
         "/clone/board/dugu_b"->foo();
        replace_program(ROOM);
}
