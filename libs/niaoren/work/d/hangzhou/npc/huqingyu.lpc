// huqingyu.c
#include <ansi.h>
#include <command.h>
//  inherit F_CLEAN_UP;
inherit NPC;

void create()
{
        set_name("胡慶余",({ "hu qingyu","hu" }));
        set("gender", "男性" );
        set("age", 63);
        set("long",
"胡慶余是當世一大明醫，他的本事神奇無比。真有生死肉骨之功。\n");
        set("combat_exp", 200000);
        set("attitude", "friendly");
        set("inquiry", ([
            "改名": "好說，五百兩黃金，款到即辦！",
            "叛師": "好說，五百兩黃金，給你改頭換面，江湖上沒人會知道你的！",
            "年齡": "這個價格嘛...!嘿嘿,一律五百兩黃金年輕一歲。",
            "整型": "整型？你想整型？嘿嘿，不後悔的話就給500兩吧！",
        ]) );
        set("chat_msg",({
            "胡慶余翹著二郎腿:要想喚回你們的青春,拿出你的誠意來!!\n",
            "胡慶余冷笑道:要叛師? 容易。快快拿出你的銀子來!\n",
            "胡慶余奸笑地說:整型找我的話，後果我是不負責的。\n",
            "胡慶余淡淡說道:改個名,就是新人了。\n",
        }));
        setup();
}
void init()
{
        object ob,me;
        add_action("do_name","name");
        add_action("do_betrayer","betrayer");
        add_action("do_pe","pe");
        add_action("do_age","age");
}
int accept_object(object me, object ob)
{
        if( ob->query("money_id") && ob->value() >= 5000000)
        {
        command("nod");
        command("say 好吧，"+me->query("name")+"你說個章程！\n");
        me->set_temp("marks/huqingyu",1);
        return 1;
        }
}
int do_name(string arg,object me)
{
        string *banned_name = ({
                "你", "你", "我", "他", "她", "它", "它", "爸", "　",
                "翔少爺", "方舟子", "草魚", "時空", "丁",
                "仙子", "天馬行空", "迪陽", "風兒"
        });
        int i;

        me = this_player();
        if(!(int)me->query_temp("marks/huqingyu"))
        {
            return notify_fail("胡慶余翻著黑白眼：錢呢？沒給錢想占便宜？\n");
        }
        if( !arg ) return notify_fail("胡慶余笑道：名字總該寫全吧。\n");
        if( strlen(arg) > 10 )
        return notify_fail("胡慶余驚呼起來：哪有這麼\長的名字？\n");
        if( strlen(arg) < 4 )
        return notify_fail("胡慶余哼了一聲：這麼\短算啥名字？\n");
        while(i--) {
                if( arg[i]<=' ' ) {
                        write("對不起，你的中文名字不能用控制字元。\n");
                        return 0;
                }
                if( (strsrch(arg, "　") >= 0) ||
                    (strsrch(arg, "爸") >= 0)) {
                        write("對不起，你的中文名字不能用引起誤會的單字。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(arg[i..<0]) ) {
                        write("對不起，請您用「中文」取名字。\n");
                        return 0;
                }
        }
        if( member_array(arg, banned_name)!=-1 ) {
                write("對不起，這種名字會造成其他人的困擾。\n");
                return 0;
        }
        if( (strlen(arg) < 2) || (strlen(arg) > 10 ) ) {
                write("對不起，你的中文名字必須是 1 到 5 個中文字。\n");
                return 0;
        }

        me->delete_temp("marks/huqingyu");
        if (me->query("gender")=="女性")
        message_vision(CYN"胡大夫大筆一揮就改了$N的芳名 !真爽呆了....\n"NOR,me);
        else
        message_vision(CYN"胡大夫大筆一揮就改了$N的大名..真神!!\n"NOR,me);
        me->set("name",arg);

        return 1;
}

int do_betrayer(object me)
{
        me = this_player();
        if(!(int)me->query_temp("marks/huqingyu"))
        {
            return notify_fail("胡慶余翻著黑白眼：錢呢？沒給錢想占便宜？\n");
        }

        me->delete_temp("marks/huqingyu");
        if (me->query("combat_exp")<10000)
            return notify_fail("真冤枉!!你的經驗還可以隨便叛師的! \n");

        me->set("betrayer",me->query("betrayer") + 1);
        me->set("shen",me->query("shen") /100  - 10000 );
        me->set("score",me->query("score") /100 - 200 );
        me->set("title","普通百姓");
        me->set("class","0");
        me->delete("family");
        me->delete("party");
    message_vision(CYN"胡大夫笑道: 江湖上海闊天空, 都是$N的天地了! \n"NOR,me);

        return 1;
}


int do_pe(object me)
{
        object obj;
        me = this_player();

        if(!(int)me->query_temp("marks/huqingyu"))
        {
            return notify_fail("胡慶余翻著黑白眼：錢呢？沒給錢想占便宜？\n");
        }
        me->delete_temp("marks/huqingyu");
//        return notify_fail("胡慶余翻著黑白眼：年齡暫時就不考慮了！\n");

        if (me->query("per")>30)
        {
            obj=new("/clone/money/gold");
            obj->set_amount(100);
            obj->move(me);
              return notify_fail("胡大夫道: 咦~你長的還不錯嘛,嘿嘿，那這五百兩黃金就算是送我的哦! \n");
        }


        if(random(10) == 9)
        {
        message_vision(CYN"胡大夫拿起榔頭.鋸子和螺絲起子朝你的臉上敲敲打打，忙了一會兒，但你總覺的不對勁。 \n"NOR,me);
        message_vision(CYN"胡大夫有點無耐地說：ㄟ....我剛剛一時ㄔㄨㄚ\手,不小心多敲了一下,你的臉..嗯....下次打折....。 \n"NOR,me);
        me->add("per",-5);
        }
    else
        {
        message_vision(CYN"胡大夫拿起榔頭.鋸子和螺絲起子朝你的臉上敲敲打打，忙了一會兒。 \n"NOR,me);
        message_vision(CYN"胡大夫沒耐心地說：好了好了，整型完成，別再煩那些鳥巫師了，只會累死我的。 \n"NOR,me);
        me->add("per",10);
        }

        return 1;
}

int do_age(object me)
{
        object obj;
        me = this_player();

        if(!(int)me->query_temp("marks/huqingyu"))
        {
            return notify_fail("胡慶余翻著黑白眼：錢呢？沒給錢想占便宜？\n");
        }
        me->delete_temp("marks/huqingyu");
//        return notify_fail("胡慶余翻著黑白眼：年齡暫時就不考慮了！\n");

        if (me->query("mud_age")<864000)
        {
            obj=new("/clone/money/gold");
            obj->set_amount(100);
            obj->move(me);
              return notify_fail("胡大夫道: 你還很年輕的, 這四百兩黃金白花了! \n");
        }

        me->add("mud_age",-86400);
        me->add("age",-1);
        message_vision(CYN"胡大夫道: 果然有錢能使鬼推磨, $N現在看是年輕多了! \n"NOR,me);

        return 1;
}
