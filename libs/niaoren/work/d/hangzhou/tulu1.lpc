#include <room.h>
inherit ROOM;
void create()
{
        set("short", "土路");
        set("long", @LONG
路旁一條小溪。溪水嘩嘩地流著，不時有魚兒(fish)躍出水面。
溪旁几各男孩正低著頭專心在釣魚。
LONG);
        set("exits", ([
            "southwest"     : __DIR__"shanlu5",
            "northeast"     : __DIR__"maojiabu",
        ]));
        set("objects", ([
            __DIR__"npc/boy" : 2,
        ]));
        set("item_desc", ([
            "fish" : "“嘩”一條大魚躍水而出，“噗”的一聲又掉回水里。漸得男孩一身水。\n",
        ]));
        set("outdoors", "hangzhou");
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
