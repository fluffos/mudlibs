#include <room.h>
inherit ROOM;
void create()
{
        set("short", "蘇堤");
        set("long", @LONG
秋月之夜，月下觀湖，滿湖銀波粼粼，陣陣微風，風中桂子飄香，
令人為之心醉。堤邊泊著小舟是送游客去三潭映月的。往西邊是去
花港，東面可見三潭映月遙立湖中，北邊是鎖瀾橋，南面映波橋。
LONG);
        set("exits", ([
            "north"     : __DIR__"suti5",
            "south"     : __DIR__"suti7",
            "west"      : __DIR__"huagang",
        ]));
        set("outdoors", "hangzhou");
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
