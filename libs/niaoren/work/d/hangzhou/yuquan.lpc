#include <room.h>
inherit ROOM;
void create()
{
        set("short", "玉泉");
        set("long", @LONG
玉泉寺建在玉泉山上，原名清漣寺。走進玉泉寺，只見這里有几個水池(pond)。
朝東就是出寺下山的路。
LONG);
        set("exits", ([
            "eastdown"  : __DIR__"road5",
        ]));
        set("item_desc", ([
            "pond":
"池旁的石碑刻著“古珍珠泉”，池內偶有小水泡上涌，好象一串珍珠\n",
        ]));
        set("objects" , ([
            __DIR__"npc/you-ke" :1,
        ]));
        set("outdoors", "hangzhou");
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
