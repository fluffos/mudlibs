#include <room.h>
inherit ROOM;
void create()
{
        set("short", "胡慶余堂");
        set("long", @LONG
這是一家明淨寬敞的藥堂，後牆上是一個大藥柜。几個伙計正忙
著爬上爬下地從小抽屜里抓藥。藥柜前擺著一張桌子，桌旁一位老者
正在為人把脈。他就是名醫胡慶余。
    柜台上方高挂一個大牌子(paizi).
LONG);
        set("exits", ([
            "west"      : __DIR__"road14",
        ]));
        set("no_fight","1");
        set("no_beg","1");
        set("objects", ([
            __DIR__"npc/huqingyu" : 1,
        ]));
        set("item_desc", ([
            "paizi" :
@TEXT
        本店提供下列服務:
    先給胡大夫五百兩黃金, 然后:

    改名:                   name 新名
      叛師:                   betrayer
    恢復青春:               age

TEXT]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
