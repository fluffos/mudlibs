//ROOM: /d/yanziwu/canheju.c

inherit ROOM;

void create()
{
        set("short", "參合居");
        set("long",@LONG
這是慕容世家首腦人物日常起居之地，布置得華麗中不乏清雅，平
實中透著高貴。楠木方桌，大太師椅，以及牆上的字畫都透著一股非凡
之氣。
LONG  );
        set("exits", ([
            "west" : __DIR__"qiushuan",
            "east" : __DIR__"zuijing",
            "north": __DIR__"yimen",
            "south": __DIR__"shuwu",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
