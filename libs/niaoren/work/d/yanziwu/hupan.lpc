
// Room: /d/yanziwu/hupan.c
// Date: Feb.14.1998 by Java

inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_yell(string arg);
void reset();

void create()
{
         set("short", "太湖湖畔");
         set("long", @LONG
太湖(hu)處江浙之間。她襟帶三江，東南之水盡匯于此，周行五百
里，古稱五湖。矗立湖岸，唯見長天遠波，放眼皆碧，七十二峰蒼翠挺
立在三萬六千頃波濤之中，使人心襟大開，直欲仰天長嘯，方能表此喜
樂。
LONG );
        set("exits", ([
            "northeast" : "/d/suzhou/road5",
        ]));

        set("item_desc", ([
            "hu":"近湖畔處有一葉小舟，舟上一個綠衫姑娘正在戲水。喊(yell)一聲試試吧。\n",
        ]));

        set("outdoors", "shaolin");
        set("no_clean_up", 0);
        setup();
}
void init()
{
        add_action("do_yell", "yell");
}

void check_trigger()
{
    object room;

    if(!query("exits/enter") ) {
        if( !(room = find_object(__DIR__"xiaozhou")) )
            room = load_object(__DIR__"xiaozhou");
        if( room = find_object(__DIR__"xiaozhou") ) {
            if((int)room->query("yell_trigger")==0 ) {
                room->set("yell_trigger", 1);
                set("exits/enter", __DIR__"xiaozhou");
                room->set("exits/out", __FILE__);
                message("vision", "一尾小舟緩緩地駛了過來，一個采蓮少女招手讓你登舟。\n", this_object() );
                remove_call_out("on_board");
                call_out("on_board", 15);
            }
            else
                message("vision", "只聽得湖面上隱隱傳來：“就來了啦……”\n",this_object() );
        }
        else
            message("vision", "ERROR: boat not found\n", this_object() );
    }
    else 
        message("vision", "湖畔一尾小舟上一個綠衫少女細聲說到：儂有啥事體。\n",
            this_object() );
}


void on_board()
{
    object room;

    if( !query("exits/enter") ) return;

    message("vision", "少女竹篙一點，小舟離岸向湖心滑去。\n",
        this_object() );

    if( room = find_object(__DIR__"xiaozhou") )
    {
        room->delete("exits/out");
        message("vision",
"\n少女說了一聲“坐穩嘍”，聲音極甜極清，令人一聽之下，說不出的舒
適。然后竹篙一點，扁舟向湖心滑去。\n", room );
    }
    delete("exits/enter");

    remove_call_out("arrive");
    call_out("arrive", 20);
}

void arrive()
{
    object room;
    if( room = find_object(__DIR__"xiaozhou") )
    {
        room->set("exits/out", __DIR__"muti");
message("vision","少女說: “到啦，上岸吧。”，隨即一點竹篙，把舟泊好。\n",room);
    }
    remove_call_out("close_passage");
    call_out("close_passage", 20);
}

void close_passage()
{
    object room;
    if( room = find_object(__DIR__"xiaozhou") ) {
        room->delete("exits/out");
        message("vision","少女竹篙一點，撐了小舟到湖中采蓮戲水。\n", room);
        room->delete("yell_trigger"); 
    }
}

int do_yell(string arg)
{
    string dir;

    if( !arg || arg=="" ) return 0;

    if( arg=="boat" ) arg = "姑娘";
    if( (int)this_player()->query("age") < 16 )
        message_vision("$N使出吃奶的力氣喊了一聲：“" + arg + "”\n",
            this_player());
    else if( (int)this_player()->query("neili") > 500 )
        message_vision("$N吸了口氣，一聲“" + arg + "”，聲音中正平和地遠遠傳"
            "了出去。\n", this_player());
    else
        message_vision("$N鼓足中氣，長嘯一聲：“" + arg + "！”\n",
            this_player());
    if( arg=="姑娘")
    {
        check_trigger();
        return 1;
    }
    else
        message_vision("湖面上遠遠傳來一陣回聲：“"+arg+"∼∼∼”\n",this_player());
    return 1;
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"xiaozhou") )
        room->delete("yell_trigger"); 
}
