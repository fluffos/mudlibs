void create()
{
	set("short", "萬景山庄");
	set("long", @LONG
在虎丘山東面就是萬景山庄，是一個較大的盆景園，有盆
名為“秦漢遺韻”的圓柏，樹齡已逾五百年，被譽為“盆景之
王”。還有盆景為“云蒸霞蔚”的樹石盆景和另一盆四百多年
的雀梅古樁盆景，都是盆景藝朮的中的珍品。圓內景色優美，
頗富園林雅趣。
LONG );
	set("outdoors", "suzhou");
