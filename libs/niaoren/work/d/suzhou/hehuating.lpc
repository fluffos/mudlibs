inherit ROOM;

void create()
{
	set("short", "荷花廳");
	set("long", @LONG
荷花廳的主建筑面闊三間，寬敝高爽，廳名取朱熹：“一
水方涵碧，千林以變紅”之詩意。廳前寬廣的平台依臨荷池，
為夏日賞荷納涼勝處，故稱“荷花廳”。廳后有花台庭院，
疊石種樹，自成一景。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"east"  : __DIR__"liuyuan",
		"west"  : __DIR__"gumujiaohe",
	]));
	setup();
	replace_program(ROOM);
}

