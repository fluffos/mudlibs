inherit ROOM;

string look_gaoshi();
void create()
{
	set("short", "西門");
	set("long", @LONG
這是號稱天堂的蘇州西城門，城門正上方刻著“西門”兩
個楷書大字，城牆上貼著几張官府告示(gaoshi)。西門外通向
寒山寺一條筆直的青石板大道向東西兩邊延伸，東邊是城里。
LONG );
	set("outdoors", "suzhou");
//	set("no_clean_up", 0);
	set("item_desc", ([
		"gaoshi" : (: look_gaoshi :),
	]));
	set("exits", ([
		"west" : __DIR__"road2",
		"east" : __DIR__"xidajie2",
	]));
        set("objects", ([
                "/d/city/npc/wujiang" : 1,
                "/d/city/npc/bing" : 2,
        ]));
	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n蘇州知府\n馮正東\n";
}

