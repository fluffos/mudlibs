inherit ROOM;

void create()
{
	set("short", "憨憨泉");
	set("long", @LONG
在山道西側有一憨憨泉，系南朝梁代高僧憨憨尊者所開鑿，
距今一千四百多年。據說泉眼通海，姑又名“海涌泉”。水甚
清冽為“天下第五泉”。石刻“憨憨泉”三字，系北宋呂升卿
所題。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"eastdown"   : __DIR__"wanjing",
	]));
	setup();
	replace_program(ROOM);
}

