inherit ROOM;

void create()
{
	set("short", "玄妙觀");
	set("long", @LONG
你一走進玄妙觀，看到觀中香火繚繞，香客眾多。殿是重
檐歇山式，屋脊高十几米，內有高大殿柱四十根。屋面坡度平
緩，出檐較深，斗拱疏朗宏大，殿內正中有磚砌須彌座，座上
供奉著的三尊高十几米的泥塑三清金身像，法像庄嚴，神采奕
奕，不失為道教雕塑中的精品。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"north"  : __DIR__"xidajie2",
	]));
	setup();
}
