inherit ROOM;

string look_gaoshi();
void create()
{
	set("short", "南門");
	set("long", @LONG
這是蘇州府的南城門。進進出出的吳儂軟語，聽來特讓人
舒服。門口的官兵開口喝罵，也是這種軟綿聲氣。門上貼著一
份告示(gaoshi)。南北一條筆直的官道。
LONG );
	set("outdoors", "suzhou");
//	set("no_clean_up", 0);
	set("item_desc", ([
		"gaoshi" : (: look_gaoshi :),
	]));
	set("exits", ([
		"north" : __DIR__"nandajie2",
		"south" : __DIR__"road5",
	]));
        set("objects", ([
                "/d/city/npc/wujiang" : 1,
                "/d/city/npc/bing" : 2,
        ]));
	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n蘇州知府\n馮正東\n";
}

