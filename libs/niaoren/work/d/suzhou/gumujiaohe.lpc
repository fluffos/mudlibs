inherit ROOM;

void create()
{
	set("short", "古木交訶");
	set("long", @LONG
古木交訶在荷花廳的西面，一排不同圖案的漏窗，使你透
過漏窗隱隱看到中部的水光山色和高低錯落的樓閣，此處賞景，
有“移步幻影”之妙。向西窗孔可以遙望綠蔭軒、明瑟樓，給
人一種“庭院深深深几許”和空間不盡之感。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"east"      : __DIR__"hehuating",
		"southwest" : __DIR__"chitang",
	]));
	setup();
}

