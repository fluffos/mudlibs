inherit ROOM;

void create()
{
	set("short", "真娘墓");
	set("long", @LONG
在試劍石北面就是古真娘墓，真娘也稱貞娘，因安史之亂
流落江南，受騙流落墮入青樓。貞娘為守貞操，自盡抗之。后
人筑亭其上，墓前石刻“香魂”兩字，墓上遍栽花卉。唐代白
居易等詩人墨客紛紛為之題詩，褒贊真娘之貞烈。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"north"     : __DIR__"sunwuting",
		"southwest" : __DIR__"shijianshi",
	]));
	setup();
}

