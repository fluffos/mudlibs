inherit ROOM;

void create()
{
	set("short", "東大街");
	set("long", @LONG
你走在東大街上，踩著堅實的青石板地面。東邊是東城門，
可以聽到守城官兵的吆喝聲，北邊是一家老字號的藥鋪，南邊
是打鐵鋪，叮叮當當的聲音老遠就能聽到。
LONG );
	set("outdoors", "suzhou");
	set("no_clean_up", 0);
	set("exits", ([
		"east"      : __DIR__"dongmen",
		"north"     : __DIR__"yaopu",
		"south"     : __DIR__"datiepu",
		"west"      : __DIR__"dongdajie1",
		"northwest" : __DIR__"hutong3",
	]));
	setup();
}

