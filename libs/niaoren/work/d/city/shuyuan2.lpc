//Room: /d/city/shuyuan2.c

string look_shelf();

#define STORY_TOC "/doc/legend/toc"
#define STORY_DIR "/doc/legend/"
inherit ROOM;

void create()
{
        set("short", "書院書庫");
        set("long", @LONG
這里是書院的圖書館，窗明几淨，一塵不染。壁上的書架(shelf)堆
滿俠客行的先賢們的文選，記錄了俠客行的風風雨雨和無數淒婉的、遙
遠磨滅不去的傳說。你可以閱讀(read)到這些古老的故事。
LONG);
        set("item_desc", ([
            "shelf" : (: look_shelf :),
        ]));
        set("exits", ([
            "down" : __DIR__"shuyuan",
        ]));
        set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_read", "read" ,);
}

string look_shelf()
{
        this_player()->start_more(read_file(STORY_TOC));
        return "\n";
}

int do_read(string arg)
{
        object me=this_player();
        if (arg == "" || file_size(STORY_DIR + arg) <= 0)
                return notify_fail("我們沒有這本書。\n");

        log_file("LIBRARY", sprintf("%s read %s.\n", me->query("name"), arg));
        me->start_more(read_file(STORY_DIR + arg));
        return 1;
}

