// Room: bite.c
// Date: Sep.6 1997

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
      set("short", "忘塵居");
      set("long",
"這里是“忘塵居”，是名與春泥格格小倆口的家。家具擺設雅致\n"
"舒適，四處遍植各色奇花異草，花團錦簇，滿室生香。光線自玻璃\n"
"屋頂投射進來，五彩斑爛，炫麗異常，令人恍如置身仙境。右首一\n"
"張大床，床頭置有七色錦緞一床，繡金鴛鴦枕一對。\n"
"    正中牆上書有四行大字：\n"
HIR"      菩提本無樹\n"
"      明鏡亦非台\n"
"      本來無一物\n"
"      何處染塵埃\n"NOR
"字跡瘦勁挺拔，清峻遒美，充滿奇逸之氣，令人嘆為觀止。\n"
);
      set("exits", ([ /* sizeof() == 1 */
          "west" : __DIR__"jiaowai1",
          "south": "/u/java/room/house",
      ]));
      set("valid_startroom","1");

      set("no_fight", 1);
      set("no_clean_up", 0);
      set("sleep_room", 1);
      setup();
      create_door("west", "垂花小門", "east", DOOR_CLOSED);
}
int valid_leave(object me, string dir)
{
      if (dir=="south")
      return notify_fail(GRN"那是人家女孩子的書房，看看就別進去了。\n"NOR);
      return ::valid_leave(me, dir);
}               

