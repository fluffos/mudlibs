// waiter.c

inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("店小二", ({ "xiao er", "xiao", "waiter" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long",
                "這位店小二正笑咪咪地忙著，還不時拿起挂在脖子上的抹布擦臉。\n");
        set("combat_exp", 100);
        set("attitude", "friendly");
        set("rank_info/respect", "小二哥");
        setup();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if (!ob->query_temp("welcome100") || ob->query("mud_age")<1000)
        {
                ob->set_temp("welcome100","1");
tell_object(ob,"店小二笑咪咪地說道：這位"+RANK_D->query_respect(ob)+"，歡迎來到"GRN"鳥人世界。"NOR"

    如果你有什麼\不明白的，可以問老玩家。缺錢花，也可以請老玩家
幫你暫渡難關。大俠們都會樂于助人的。當然你也可以用"RED"help"NOR"來獲得我
們給您的幫助。
    你在help中能看到很多幫助項目。
    這裡的故事和情節，謎語的基本依據是金庸的十五本小說。如果你
對故事不太記得了或想了解多些可以用"RED"help intro"NOR"這個幫助項。如果你
從沒玩過 MUD游戲，那就先看看"RED"help newbie"NOR"來新手上路吧。"RED"help cmds"NOR"
是這里所有玩家都能用的命令。想認識一下這里的地圖就"RED"help map"NOR"，里
面有很多項目的，你可以選擇地圖項目"RED"help map_all"NOR"看到整個游戲的地
圖。而"RED"help map_yz "NOR"就是你現在呆的城市的地圖。當然最重要的是向老
玩家請教，這就一定要會使用"RED"chat"NOR"這個命令啦。這里的幫助文件也因為
我們的工作而更新，多多留意哦。客店往西，南，西，西，南就到武館
了，叛師在這里會吃虧的，所以沒想好拜哪個門派就先去武館學。揚州
的武廟是信息中心，常去看看那里的公告，最新的消息一定最早出現在
那里。
    如果您對這個游戲的設計和管理有什么建議或意見請"RED"mail to leos"NOR"，
我們一定會認真考慮的。\n\n");
        }
        switch( random(2) ) {
                case 0:
                        say( "店小二笑咪咪地說道：這位" + RANK_D->query_respect(ob)
                                + "，進來喝杯茶，歇歇腿吧。\n");
                        break;
                case 1:
                        say( "店小二用脖子上的毛巾抹了抹手，說道：這位" + RANK_D->query_respect(ob)
                                + "，請進請進。\n");
                        break;
        }
}

int accept_object(object who, object ob)
{
        
        if (ob->query("money_id") && ob->value() >= 5000) 
        {
                tell_object(who, "小二一哈腰，說道：多謝您老，客官請上樓歇息。\n");

                who->set_temp("rent_paid",1);

                return 1;
        }

        return 0;
}
