// smith.c

inherit NPC;
inherit F_DEALER;

void create()
{
        set_name("鐵匠", ({ "tiejiang", "smith" }));
        set("title", "鐵匠鋪老板");
        set("shen_type", 1);

        set("gender", "男性" );
        set("age", 33);
        set("long", "鐵匠正用鐵鉗夾住一塊紅熱的鐵塊放進爐中。\n");

        set("combat_exp", 400);
        set("attitude", "friendly");
        set("vendor_goods",({
                  "/d/city/obj/changjian",
                  "/d/city/obj/hammer",
                  "/d/city2/obj/tudao",
                  "/d/city/obj/dagger",
                  "/d/xingxiu/obj/tiegun",
                  "/d/city/obj/gangdao",
                  "/d/city/obj/goodsword",
                  "/clone/lie/weapon/bird",
                  "/clone/weapon/s-blade",
                  "/clone/weapon/goodblade",
                  "/clone/weapon/whip",
                  "/clone/weapon/whip/9whip",
                  "/clone/weapon/whip/smwhip",
        }));

        setup();

        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

