// guigong.c
inherit NPC;

void create()
{
        set_name("龜公", ({ "gui gong", "gui", "gong" }));
        set("gender", "男性");
        set("age", 25);

        set("long", "一個滿臉狠肉的漢子，在麗春院日子久了，養的白白肥肥。\n");
        set("combat_exp", 30000);
        set("shen_type", 2);
        set_skill("unarmed", 70);
        set_skill("dodge", 70);
        set("chat_msg", ({
             "小娘皮，來了這里就乖乖地侍侯大爺們吧。",
             "想跑？跑到天涯海角都給你追回來！",
             "哼！你們這些小賤人，活該！",
        }) );
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{
        add_action("do_piao", "piao");
}

int do_piao(string arg)
{
        object ob,myenv,me=this_player();
        int value;
        object *inv;
        
        if( !arg || arg=="")
                return notify_fail("你要做什麼？\n");
        if( arg=="me" && me->query("class")==0 )  return notify_fail("你要做什麼？\n");
        else if( arg=="me" && me->query("class")=="prostitute")
        {        
        switch (MONEY_D->player_pay(this_player(), me->query("per") * 700))
        {
        case 0:
                return notify_fail("窮光蛋，一邊呆著去！\n");
        case 2:
                return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
        default:

        myenv = environment (this_player());
        tell_room(myenv,"龜公開心說：好了你不用賣了，你能走了。\n", me);
        me->move("/d/city/lichunyuan2");
        me->set("startroom","/d/city/lichunyuan2");
        me->apply_condition("prostitute", 0);
        me->delete_temp("selled");
        me->set("class", "0");
        return 1;
        }}
}
