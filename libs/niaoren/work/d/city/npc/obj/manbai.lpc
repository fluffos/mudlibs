// manbai.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( HIC"絲質羽毛被"NOR, ({ "manbai", "bai"}) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "條");
                set("value", 3000);
                set("material", "cloth");
                set("armor_prop/armor", 50);
                set("wear_msg", "$N不知道從哪裡抽出一條$n，披在身上；此時$N感到一陣溫暖．\n");
                set("remove_msg", "$N把$n掀了開來，輕輕的抖了一下後，$n就消失了．\n");
        }
        setup();
}
void owner_is_killed()
{
        write(HIY"只見眼前一堆棉絮在飄...好象是.....\n"NOR);
        destruct(this_object());
} 
