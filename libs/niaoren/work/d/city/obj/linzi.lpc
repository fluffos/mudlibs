// linzi.c 千年靈芝

#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"千年靈芝"NOR, ({"linzi", "zi"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "這是一根看起來活了很久的"HIR"千年靈芝"NOR"，是中國的一大奇藥，採之不易！\n");
                set("value", 1000000);
        }
        setup();
}

int do_eat(string arg)
{
        int force_limit, jingli_limit, force_skill, add_skill, improve;

        object me = this_player();

        //force_limit = me->query_skill("force")*10;
        //jingli_limit = me->query("max_jingli");
        //force_skill = me->query_skill("force", 1);

        if (!id(arg))
        return notify_fail("你要吃什麼？\n");
        if ( (int)me->query_temp("num" ) > 0 )
        {
                me->add_temp("num", 1);
                if ( (int)me->query("max_jingli")<110)
                 {
                message_vision(HIB"$N又吃下一根千年靈芝，突然間不小心卡到喉嚨，原來吃得太急，反而失去效用！\n" NOR, me);
                 }
                else
                 {
                me->add("max_jingli", -100);
                message_vision(HIR"$N又吃下一根千年靈芝，突然間不小心卡到喉嚨，原來吃得太急太多，即使靈藥亦得其反！\n" NOR, me);
                 }
        }

        else
        {
/*              if ( improve < 100 ) {
                        add_skill = force_skill + (50 - improve)/5 + 1;
                        me->set_skill("force", add_skill );
                }
*/
                me->add("max_jingli", 50);
                me->add("jingli", 50);

                message_vision(HIY"$N吃下一根"HIR"千年靈芝"HIY"，頓然間只覺一股"HIW"浩蕩無比"HIY"的精氣直逼頂門..."NOR"\n" NOR, this_player());
                me->set_temp("num", 1);
        }

        me->unconcious();
        destruct(this_object());
        return 1;
}

