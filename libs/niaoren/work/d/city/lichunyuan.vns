inherit ROOM;

void create()
{
	set("short", "麗春院");
	set("long", @LONG
	你一走進來，一眼就看到大廳的牆上挂著一幅幅春宮圖(tu)，一下子就
明白了這是什么\地方。廳內到處張燈結彩，香氣扑鼻。几名打扮得妖里妖氣的女人
分站兩旁對你發出媚笑。主人韋春芳上上下下、前前后后招呼著客人。從樓上傳來
了陣陣打情罵俏的聲音。
LONG );

	set("objects", ([
                CLASS_D("gaibang") + "/kongkong" : 1,
                __DIR__"npc/wei" : 1,
                "/d/city2/npc/mao18" : 1, 
	]));

	set("item_desc", ([
		"tu" :
"      精神文明建設，剔除不良信息。
	\n"]));
	set("exits", ([
		"west" : __DIR__"nandajie2",
	]));
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

