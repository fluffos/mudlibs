// Room: /city/duchang.c
// YZC 1995/12/04 

inherit ROOM;

void create()
{
	set("short", "賭場");
	set("long", @LONG
這里是賭場的大堂，四周的房間里傳出來吆五喝六的賭博聲。
西邊是賭「大小」的房間，北邊是賭「牌九」的房間(建設中)，南
面是閩南特有的搏餅娛樂間。牆上顯眼處挂著一塊牌子(paizi)。
LONG );
	set("item_desc", ([
		"paizi" : "二樓的拱豬房正處于測試階段。\n",
	]));
	set("objects", ([
		CLASS_D("shenlong")+"/pang" : 1,
	]));
	set("exits", ([
		"west" : __DIR__"daxiao",
		"up"   : __DIR__"duchang2",
		"east" : __DIR__"nandajie1",
		"south": __DIR__"bobing",
	]));
	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
        if (dir == "west" && this_player()->query("age")<18)
                return notify_fail("小毛孩子往這兒瞎湊合什么?!\n");
        return ::valid_leave(me, dir);
}

