// fandog.c
#include <ansi.h>
inherit NPC;
int do_hp();
int do_score();
int do_skills();
void create()
{
	set_name("凡狗", ({ "fandog"}));
	set("gender", "無性");
	set("long","這是一只純種博美名犬，身上的毛沒有几根，
但卻如黃金般璀璨，梳理得一絲不苟，油光
水滑，兩只眼睛水靈靈的，溫情脈脈地看著
你......人耶？狗耶？如果是狗應是一條好
狗，是人更應是一條好漢！\n");
	set("title", HIY"翰林博士"HIG"明教天字門教眾"NOR"丐幫第十八代弟子");
	set("nickname", HIY"沒毛犬"NOR);
	set("age", 46);
	set("class", "eunach");
	set("attitude", "friendly");

	set("kar", 10);
	set("per", 25);
	set("int", 23);
	set("dex", 20);
	set("con", 21);
	set("str", 16);
	set("weiwang", 70);
	set("shen", 239340);
	set("combat_exp", 2137847);
	set("PKS", 4);
	set("MKS", 2629);

	set("max_jing", 593);
	set("jing", 593);
	set("max_qi", 1251);
	set("qi", 1251);
	set("max_jingli", 500);
	set("jingli", 500);
	set("max_neili", 3260);
	set("neili", 3260);
	set("meili", 60);

	set_skill("literate", 135);
	set_skill("taoism", 100);
	set_skill("hubo", 100);
	set_skill("force", 253);
	set_skill("unarmed",250);
	set_skill("parry", 255);
	set_skill("dodge", 253);
	set_skill("sword", 250);
	set_skill("blade", 250);
	set_skill("staff", 250);
	set_skill("shenxing-baibian", 20);
	set_skill("yunlong-jian", 250);
	set_skill("pixie-jian", 250);
	set_skill("houquan", 238);
	set_skill("xianglong-zhang", 278);
	set_skill("xiaoyaoyou", 278);
	set_skill("huntian-qigong", 200);
	set_skill("dagou-bang", 278);
	set_skill("kongming-quan", 214);

	map_skill("force", "huntian-qigong");
	map_skill("dodge", "pixie-jian");
	map_skill("parry", "pixie-jian");
	map_skill("sword", "pixie-jian");
	map_skill("unarmed","xianglong-zhang");
	map_skill("staff","dagou-bang");
	set("inquiry", ([
		"hp"    : (: do_hp :),
		"score" : (: do_score :),
		"skill" : (: do_skills :),
		"武功"  : (: do_skills :),
	]));

	create_family("丐幫",18, "弟子");
	setup();
	carry_object(__DIR__"fandog_sword")->wield();
	carry_object("/d/city/npc/obj/jinsijia")->wear();
}

int do_skills()
{
message_vision("$N說： 我所有的基本武功如下：\n"+
"  基本刀法 (blade)                         - 深不可測 250/    0\n"+
"□打狗棒法 (dagou-bang)                    - 深不可測 278/    0\n"+
"  基本輕功 (dodge)                         - 深不可測 253/    0\n"+
"  基本內功 (force)                         - 深不可測 253/    0\n"+
"  猴拳 (houquan)                           - 深不可測 238/    0\n"+
"  左右互搏 (hubo)                          - 心領神會 100/    0\n"+
"□混天氣功 (huntian-qigong)                - 深不可測 200/    0\n"+
"  空明拳 (kongming-quan)                   - 深不可測 214/    0\n"+
"  讀書寫字 (literate)                      - 了然於胸 135/    0\n"+
"  基本招架 (parry)                         - 深不可測 255/    0\n"+
"□辟邪劍法 (pixie-jian)                    - 深不可測 250/    0\n"+
"  神行百變 (shenxing-baibian)              - 粗通皮毛  20/    0\n"+
"  基本杖法 (staff)                         - 深不可測 250/    0\n"+
"  基本劍法 (sword)                         - 深不可測 250/    0\n"+
"  道學心法 (taoism)                        - 心領神會 100/    0\n"+
"  基本拳腳 (unarmed)                       - 出神入化 250/    0\n"+
"□降龍十八掌 (xianglong-zhang)             - 深不可測 278/    0\n"+
"  逍遙游 (xiaoyaoyou)                      - 深不可測 278/    0\n"+
"  云龍劍 (yunlong-jian)                    - 深不可測 250/    0\n", this_object());

	return 1;
}
