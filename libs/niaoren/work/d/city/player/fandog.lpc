"≡──────────────────────────────≡\n"+
"【 精 氣 】  593/  593 (100%)    【 精 力 】  500 /  500 (+0)\n"+
"【 氣 血 】 1251/ 1251 (100%)    【 內 力 】 3260 / 3260 (+0)\n"+
"【 食 物 】    0/  260           【 潛 能 】  0\n"+
"【 飲 水 】    0/  260           【 經 驗 】  2137847\n"+
"≡──────────────────────────────≡\n", this_object());
	return 1;
}

