inherit ROOM;

void create()
{
	set("short", "桃花村");
	set("long", @LONG
進了桃花谷便是桃花村。世外的感受，讓你陶醉這山野的風、
山間的春泥味、山村的直朴、村民的寬容、山里的桃花、桃花溪的
少女，讓你不會再去想塵世的名利、江湖的血腥、人心的險惡。你
盡可忘了一切，來凝望桃花村碧藍的瓦、彤紅的牆。
LONG );
	set("outdoors", "city");
//	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/cunzhang" : 1,
	]));
	set("exits", ([
		"southdown" : __DIR__"taohua3",
		"north"     : __DIR__"taohua5",
	]));
	setup();
	replace_program(ROOM);
}
