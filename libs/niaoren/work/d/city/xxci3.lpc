#include <room.h>
inherit ROOM;

void create()
{
	set("short", "先賢祠－女玩家部");
	set("long", @LONG
這里是一間黑黝黝的小屋，使你想起了那個不知關過多少江湖女杰的破倉庫。
抬頭一張橫匾(bian)，上面有几個黑乎乎的大字：巾幗不讓須眉。
注：排名不分先后。按字母順序。
LONG );
	set("exits", ([ 
		"north" : __DIR__"xxci1",
	]));
	set("item_desc", ([ 
		"bian" : "匾上有几個大字，再一看，旁邊另注了一行小字：\n女人的名字是弱者。\n",
	]));
	set("no_fight",1);
	set("no_clean_up", 0);

	set("objects", ([ 
		"/d/npc/wwl" : 1,
	]));

	create_door("north","木門","south",DOOR_CLOSED); 	
	setup();
	replace_program(ROOM);
}
