#include <room.h>
inherit ROOM;

void create()
{
	set("short", "兵器庫");
	set("long", @LONG
這里是兵器庫，到處銀光閃閃，讓人眼花繚亂。寶刀、寶劍、金箍棒，大
刀、長劍、哨棒，短刀、短劍、短棍，各色各樣的兵器應有盡有，你一時不知
道挑什么好。
LONG );
	set("exits", ([
		"north" : __DIR__"bingyin",
	]));
	set("no_clean_up", 0);
	create_door("north", "鐵門", "south", DOOR_CLOSED);
	setup();
}

