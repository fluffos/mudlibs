#include <room.h>
inherit ROOM;

void create()
{
    set("short", "密林");
    set("long", @LONG
揚州郊外的茂密樹林，陰森可怖。抬頭不見天日。這里也
是揚州命案發生最多的地方。鳥獸蛇虫游蕩不窮。
LONG );
    set("exits", ([
        "east"  : __DIR__"jiaowai8",
        "west"  : __DIR__"jiaowai10",
    ]));
    set("objects", ([
        __DIR__"obj/shuzhi": 2,
        __DIR__"npc/dushe" : 1,
    ]));
//    set("no_clean_up", 0);
    setup();
    replace_program(ROOM);
}
