inherit ROOM;

void create()
{
	set("short", "福威鏢局");
	set("long", @LONG
你來到一座結構宏偉的建筑前，左右石壇上各插著一根兩丈多高的旗杆，
杆上青旗飄揚。右首旗子用金線繡著一頭張牙舞爪的獅子，獅子上頭有一只
蝙蝠飛翔。左首旗子上寫著“福威鏢局”四個黑字，銀鉤鐵划，剛勁非凡。
入口處排著兩條長凳，几名鏢頭坐著把守。少鏢頭正跟他們說笑。
LONG );

	set("exits", ([
		"south" : __DIR__"zhengting",
		"north" : __DIR__"xidajie2",
	]));
	set("objects", ([
		__DIR__"npc/linpingzhi" : 1,
		__DIR__"npc/biaotou" : 2,
	]));
//	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

