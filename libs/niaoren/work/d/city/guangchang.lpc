inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "中央廣場");
        set("long", @LONG
這里是城市的正中心，一個很寬闊的廣場，鋪著青石地面。一些游手好
閑的人在這里溜溜達達，經常有藝人在這里表演。旁邊有一棵大榕樹，盤根
錯節，據傳已有千年的樹齡，是這座城市的歷史見証。樹干底部有一個很大
的樹洞 (dong)。 你可以看到北邊有來自各地的行人來來往往，南面人聲鼎
沸，一派繁華景象，東邊不時地傳來朗朗的讀書聲，西邊則見不到几個行人，
一片肅靜。豎立在廣場中央的是一塊武林中人所公認的名人榜(list)，能在這
榜上的都是些昔日馳騁於江湖中的故人或是當今為人所稱讚的大俠，當然也有
一些惡名昭彰的混球名列於榜上。總之，武林中人都能以身列於榜上而感到光榮。
LONG );
        set("no_sleep_room",1);
        set("outdoors", "city");
//      set("no_clean_up", 0);
        set("item_desc", ([
                "dong" : "這是一個黑不溜湫的大洞，里面不知道有些什么古怪。\n",
        ]));

        set("exits", ([
                "east" : __DIR__"dongdajie1",
                "south" : __DIR__"nandajie1",
                "west" : __DIR__"xidajie1",
                "north" : __DIR__"beidajie1",
        ]));
        set("objects", ([
                __DIR__"npc/xunbu" : 1,
                __DIR__"npc/liumang" : 4,
                __DIR__"npc/liumangtou" : 1,
        ]));

        set("item_desc", ([
                "list" : "武林第一位退伍者：認吾師GOGO，本mud創mud元老，丐幫第一位弟子\n
武林第二位榮退者：野茂英雄NOMO，本mud創mud元老，丐幫第二人\n
武林第三位榮退者：吉斯CHESS華山強者，熱心公益！\n
武林第四位榮退者：哈哈HOHO本mud創mud元老，精通各派武學精華，堪稱武林第一人\n
武林第五位榮退者：問天JORDAN，本mud創mud元老，強！精通本mud！強！強！強！\n
武林第六位榮退者：鐵公雞DOG， 本mud創mud元老，為鳥人親傳的最弱、最煩弟子，超有錢!\n
武林第七位榮退者：忍者RECALL，本mud創mud元老，終於退伍了！唉！ \n
武林第八位榮退者：【曠世大俠】明教天字門教眾 武當派第二代弟子「奇神」楊小邪(Weiboy)
"HIB"weiboy的留言：哈哈~不知不覺的就快伍了~真不知該說些什麼哩~只能說大家加油哦~"NOR"\n"
        ]));
        setup();
}

void init()
{
        add_action("do_enter", "enter");
//      UPDATE_D->check_user(this_player());
}

int do_enter(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;

        if( arg=="dong" ) 
        {
                message("vision",
                        me->name() + "一彎腰往洞里走了進去。\n",
                        environment(me), ({me}) );
                me->move("/d/gaibang/inhole");
                message("vision",
                        me->name() + "從洞里走了進來。\n",
                        environment(me), ({me}) );
                return 1;
        }
}       
