// rma4.c
#include <ansi.h>
inherit F_UNIQUE;
inherit ITEM;

void create()
{
        set_name(HIR"馬哨"NOR, ({"ma sh","sh"}));
           if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long",
                "這是用來控制你所騎乘的"+ this_player()->query_temp("ma/1") +"的工具，它的控制指令如下，共有三個指令。\n
                 前往格式: got <number>  ex:got 1,got 2....(共有四個目的地)。\n
                 記憶格式: maset <number>   ex: maset 1,maset 2 ..(共有四個記憶地)。\n
                 查詢格式: mashow 可以查詢你的記憶點所在。\n");
        set("no_get", "這件東西不能送人。\n");
        set("no_drop", "這件東西不能亂丟。\n");
        set("no_sell", "這東西不值錢阿。\n");
        set("value", 2000);
        set("unit", "粒");
        set("weight", 10);
}
}

void init()
{
        add_action("do_got", "got");
        add_action("do_maset", "maset");
        add_action("do_mashow", "mashow");        
}                    
int do_maset(string arg)
{
  object where, me, ob, hor;
  string str,str_s;
  int no_transmit;
  me = this_player();
  ob = this_object();
  if ( !arg || arg=="" )  return notify_fail("你設定為那呢？\n");
  if( (arg != "1") && (arg != "2") && (arg != "3") && (arg != "4") )
    {
      write(this_player()->query_temp("ma/1") +NOR"能記憶的地點只有點 1,2,3,4...\n");
      return 1;
    } 
    where = environment(me);
    no_transmit = where->query("no_transmit",1);
    if(no_transmit)
    {
     write("這裡似乎怪怪的，"+ this_player()->query_temp("ma/1") +NOR"不聽你的命令了。\n");
     return 1;
    }
    str_s = where->query("short");
    str=file_name(where);
    if( arg == "1")
    {
      ob->set_temp("fan/1",str);
      ob->set_temp("fan_s/1",str_s);
    }
    if( arg == "2")
    {
      ob->set_temp("fan/2",str);
      ob->set_temp("fan_s/2",str_s);
    }
    if( arg == "3")
    {
      ob->set_temp("fan/3",str);
      ob->set_temp("fan_s/3",str_s);
    }
    if( arg == "4")
    {
      ob->set_temp("fan/4",str);
      ob->set_temp("fan_s/4",str_s);
    }
    write("你設定這裡為你的新傳送點.\n");
    return 1;
}
int do_mashow(string arg)
{
    object ob;
    string str_s,hor;
    ob = this_object();
    str_s = ob->query_temp("fan_s/1");
    printf(" 1  ： %s \n",str_s);
    str_s = ob->query_temp("fan_s/2");
    printf(" 2  ： %s \n",str_s);
    str_s = ob->query_temp("fan_s/3");
    printf(" 3  ： %s \n",str_s);
    str_s = ob->query_temp("fan_s/4");
    printf(" 4  ： %s \n",str_s);
    hor = this_player()->query_temp("ma/1");
    printf("座騎： %s \n",hor);
    return 1;
}   
int do_got(string arg)
{ 
    object me,ob,hor;
    string room="";
    me = this_player();
    ob = this_object();
    if( (arg != "1") && (arg != "2") && (arg != "3") && (arg != "4") )
    {
      write(this_player()->query_temp("ma/1") +NOR"能去的記憶地點只有 1,2,3,4...\n");
      return 1;
    }
    if( environment(me)->query("no_transmit") )
    {
     write("這裡似乎怪怪的，"+ this_player()->query_temp("ma/1")+NOR"不聽你的命令了。\n");
     return 1;
    }
    if( me->query_temp("unconcious") )          return 0;
    if( me->is_fighting() )
        return notify_fail("戰鬥中無法移動。\n");
    if( environment(me)->query("no_transmit") )
    {
       write(this_player()->query_temp("ma/1") +NOR"不聽你指揮了。\n");
       return 1;
    }
    message_vision("$N騎在"+ this_player()->query_temp("ma/1") +NOR"上往目的地移動了。\n", me);
    switch(arg)
    {
       case "1":
         room = ob->query_temp("fan/1");        break;
       case "2":
         room = ob->query_temp("fan/2");        break;
       case "3":
         room = ob->query_temp("fan/3");        break;
       case "4":
         room = ob->query_temp("fan/3");        break;
       default:
     }
     if( !me->move(room) ){
        write("但"+ this_player()->query_temp("ma/1") +NOR"似乎找不到那裡。\n", hor);
        return 1;
     }
     else
        message_vision("$N騎在"+ this_player()->query_temp("ma/1") +NOR"上迅速的往這過來。\n",me);
     return 1;
}
