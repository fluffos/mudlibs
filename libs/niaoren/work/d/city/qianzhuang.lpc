inherit ROOM;

void create()
{
	set("short", "錢庄");
	set("long", @LONG
這是一家老字號的錢庄，已有几百年的歷史，在全國各地都有分店。它發
行的銀票信譽非常好，通行全國。
    在對面的牆上挂了塊牌子(paizi)。
LONG );
	set("exits", ([
		"east" : __DIR__"beidajie1",
	]));
	set("item_desc", ([
		"paizi" : @TEXT
     本錢庄提供以下服務：
      存錢        deposit或者cun
      取錢        withdraw或者qu
      錢幣兌換    convert或者duihuan
      查帳        check或者chazhang
      銀票種類    100-cash 一百兩金票 1000-cash 一千兩銀票
TEXT
	]) );

	set("objects", ([
		__DIR__"npc/qian" : 1
	]));
	set("no_clean_up", 0);
	set("no_fight", 1);
	set("no_beg", 1);
	setup();
}

