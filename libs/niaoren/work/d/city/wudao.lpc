// Room: /city/wudao.c
// Date: Feb.28 1998 by Java
#include <ansi.h>
inherit ROOM;
string look_list();
string look_sop();
string look_pai();
  string  clear_title(string arg);
void add_title(object me,string arg);
void create()
{
        set("short", "武道場");
        set("long", @LONG
這里是比武大會巫師席，高據擂台之上，雕梁琉瓦，花木游欄。四望青山
迎爽，擂台周圍的人頭攢動。桌上放著一塊小木牌 (pai)，后壁上貼著一
張紅紙告示(list)，比武作業程序(sop)。
LONG );
        set("outdoors", "city");
        set("item_desc", ([
                "list" : (: look_list :),
                "pai"    : (: look_pai :),
                "sop"    : (: look_sop :),
        ]));
        set("exits", ([
                "west"      : __DIR__"leitai",
        ]));
        set("no_clean_up", 0);
        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        setup();
//      replace_program(ROOM);
}


string look_sop()
{
        return 
HIR"\n\n                           
                 比武作業程序
\n"HIY"
第一、依年齡選擇自已的組別。
第二、依自已的組別挑選自已的對手並告訴巫師，不知道要和誰比的告訴第二位
      主持人(巫師)，由該主持人(巫師)決定。
第三、檢查自已的狀態是否在最完美情況，如果是就等候通知上台比武(
      就是等，或是上擂台看人打)，如果不是在最快的時間內準備好。
第四、當主持人(巫師)拉你上台就表示換你打了。(你不需要作動作)
第五、上擂台後脫下自已的武器、防具，從兵器架上自行拿鐵甲及自已練的兵器
      指令為take armor . take sword。
第六、裝、穿上鐵甲及兵器後，exert 內功的特功，例如exert powerup(shield)。
第七、最後一次檢查自已的狀態，都好了就說ok。(為避免浪費其他人的時間請盡快)
第八、等主持人(巫師)執行開始指令。
"HIG"                                     鳥人一號 敬啟
\n"NOR;
}

string look_pai()
{
        return 
"\n
"HIR"start                  "HIY"----  擂台上之玩家開始比武。
"HIR"allow    <player id>   "HIY"----  設定允許上擂台之玩家。
"HIR"deny     <player id>   "HIY"----  取消玩家上台資格。
"HIR"load     <player id>   "HIY"----  拉玩家上擂台。
"HIR"kick     <player id>   "HIY"----  踢玩家下擂台。
"HIR"heal     <player id>   "HIY"----  給擂台上玩家九花玉露丸。
"HIR"life     <player id>   "HIY"----  送被殺玩家上天堂恢復。

"HIG"titles  <player id> 01 "HIY"----  贈玩家幼年天下第一 (15以下)。
"HIG"titles  <player id> 02 "HIY"----  贈玩家幼年天下第二 (15以下)。
"HIG"titles  <player id> 11 "HIY"----  贈玩家少年天下第一 (20以下)。
"HIG"titles  <player id> 12 "HIY"----  贈玩家少年天下第二 (20以下)。
"HIG"titles  <player id> 21 "HIY"----  贈玩家天下第一俠少 (30以下)。
"HIG"titles  <player id> 22 "HIY"----  贈玩家天下第二俠少 (30以下)。
"HIG"titles  <player id> 31 "HIY"----  贈玩家天下第一俠客 (40以下)。
"HIG"titles  <player id> 32 "HIY"----  贈玩家天下第二俠客 (40以下)。
"HIG"titles  <player id> 41 "HIY"----  贈玩家天下第一大俠 (40以上)。
"HIG"titles  <player id> 42 "HIY"----  贈玩家天下第二大俠 (40以上)。

\n"NOR;
}
string look_list()
{
        return 
HIR"\n\n                           
                 比武大會實施辦法
\n"HIY"
第一、每週四中午1200時舉行，1130至1200時為報名時間，逾時不候
第二、比賽按年齡分組，每組設天下第一，第二稱號。分組如下：
      幼年組 十五到十七歲 青年組 十七到三十歲 壯年組 卅一
第三、如果在某組內只有兩人，該二員就直接獲得該組第一、二名。
      若某組報名人數不滿二員，該組不予比賽。分組後請自行找對手，
      自已不找的由巫師在該組中分配。
第四、為使天下第一名實相符，允許使用現行所有武功，允許perform，
      powerup，enforce，poison等。但roar由于嚴重影響比武秩序，
      因此謝絕使用。違者停賽。
第五、比武實行淘汰制。每輪實行三局兩勝制，分別為：第一場比空手，
      第二場比兵器，第三場比兵器(不用特攻)，先勝兩局者進入下一輪。
第六、比賽時所用兵器和防具請在擂台上的兵器架上自行拿取，禁止使用
      非兵器架以外兵器及防具。
第七、比賽時請注意言行，犯眾怒者、違反現場巫師安排者，取消一年
      比賽資格。
第八、非比武選手請勿自行上擂台，要觀戰者於聽到公子平說：某人和某
      人開打時打到擂台觀戰，有違者，試試看！

"HIG"                                     鳥人一號 敬啟
\n"NOR;
}

void init()
{
//      add_action("do_start", "start");
        add_action("do_allow", "allow");
        add_action("do_deny", "deny");
        add_action("do_load", "load");
        add_action("do_kick", "kick");
        add_action("do_heal", "heal");
        add_action("do_life", "life");
        add_action("do_titles", "titles");
}

int do_start()
{
        int i,j;
        object *allob, ob, me;

        allob = users();
        me = this_object();
        ob = this_player();

        j = 0;
        for ( i=sizeof(allob); i>0; i-- ) {
             if (environment(allob[i-1]) ->query("short") =="擂台") {
                if (j == 0) {
                    me = allob[i-1];
                    j = 1;
                }
                else ob = allob[i-1]; 
             }
        }
        if (ob != this_player()) me->fight_ob(ob);
        return 1;
}
int do_allow(string arg)
{
        object ob, me;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: allow <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N設定讓"+ob->name()+"上擂台。\n"NOR, me);
        ob -> set_temp("leitai_allow",1);
        ob -> delete("env/combatd");
        tell_object(ob,HIR"\n該你上擂台了。\n"NOR);
        return 1;
}
int do_deny(string arg)
{
        object ob, me;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: deny <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N設定讓"+ob->name()+"先暫時別上擂台。\n"NOR, me);
        ob -> delete_temp("leitai_allow");
        tell_object(ob,HIR"\n先不急上擂台了吧。\n"NOR);
        return 1;
}
int do_load(string arg)
{
        object ob, me;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: loadup <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N拉"+ob->name()+"上擂台。\n"NOR, me);
        message_vision(HIG"$N雙腿一蹬，騰空而起，輕輕落在擂台邊上，衣袂襟風，十分瀟洒。\n"NOR, ob);
        ob -> delete_temp("leitai_allow");
        tell_object(ob,HIR"\n發什么呆呀你，先上來吧給我。\n"NOR);
        ob -> move("/d/city/leitai");
        ob -> delete_temp("view_leitai");
        ob -> delete("env/combatd");
        message_vision(HIG"$N騰空落在擂台邊上，衣袂襟風，十分瀟洒。\n"NOR, ob);
        return 1;
}
int do_kick(string arg)
{
        object ob, me;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: kickdown <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N把"+ob->name()+"踢下擂台。\n"NOR, me);
        ob -> delete_temp("leitai_allow");
        message_vision(HIG"只聽得$N嗷的一聲，飛身跳下擂台去了。\n"NOR, ob);
        tell_object(ob,HIR"\n沒玩夠啊，先下去吧你給我。\n"NOR);
        ob -> move("/d/city/wudao1");
        ob -> set_temp("view_leitai",1);
        message_vision(HIG"只見$N長呼聲中，一個大屁股墩坐在地上唉唉不絕。\n"NOR, ob);
        return 1;
}
int do_heal(string arg)
{
        object ob, me, obj;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: heal <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N給"+ob->name()+"一粒九花玉露丸。\n"NOR, me);
        obj = new("/clone/misc/jiuhua");
        obj -> move(ob); 
        tell_object(ob,HIR"\n給你一粒九花玉露丸恢復體力。\n"NOR);
        return 1;
}
int do_life(string arg)
{
        object ob, me;

        me = this_player();
        if (!arg) return notify_fail("<Syntax>: reback <player id>\n");
        ob = LOGIN_D->find_body(arg);
        if (!ob) return notify_fail("沒這個人耶。\n");
        message_vision(HIG"$N送"+ob->name()+"上天堂恢復損失。\n"NOR, me);
        ob -> delete_temp("leitai_allow");
        tell_object(ob,HIR"\n送你上天堂，下來后就會恢復的。\n"NOR);
        ob -> move("/d/death/god2");
        ob -> delete_temp("view_leitai");
        return 1;
}
int do_titles(string arg)
{
        object obj, me=this_player();
        string dest, topic;

        if( !arg || sscanf(arg, "%s %s", dest, topic)!=2 )
                return notify_fail("你要封誰什么稱號？\n");
        obj = find_player(dest);
        if(!obj || !me->visible(obj)) return notify_fail("沒有這個人....。\n");
        switch (topic)
        {
                case "01": add_title(obj, "幼年天下第一"); break;
                case "02": add_title(obj, "幼年天下第二"); break;
                case "11": add_title(obj, "少年天下第一"); break;
                case "12": add_title(obj, "少年天下第二"); break;
                case "21": add_title(obj, "天下第一俠少"); break;
                case "22": add_title(obj, "天下第二俠少"); break;
                case "31": add_title(obj, "天下第一俠客"); break;
                case "32": add_title(obj, "天下第二俠客"); break;
                case "41": add_title(obj, "天下第一大俠"); break;
                case "42": add_title(obj, "天下第二大俠"); break;
                default: break;
        }
        message_vision(HIG"$N授"+obj->name()+"封號。\n"NOR, me);
        return 1;
}
void add_title(object me,string arg)
{
        string title;
        title=arg+clear_title(me->query("title"));
        me->set("title",title);
}
string clear_title(string arg)
{
        if( (strsrch(arg, "幼年天下第一") >= 0) ||
            (strsrch(arg, "幼年天下第二") >= 0) ||
            (strsrch(arg, "少年天下第一") >= 0) ||
            (strsrch(arg, "少年天下第二") >= 0) ||
            (strsrch(arg, "天下第一俠少") >= 0) ||
            (strsrch(arg, "天下第二俠少") >= 0) ||
            (strsrch(arg, "天下第一俠客") >= 0) ||
            (strsrch(arg, "天下第二俠客") >= 0) ||
            (strsrch(arg, "天下第一大俠") >= 0) ||
            (strsrch(arg, "天下第二大俠") >= 0))
                {
                arg = replace_string(arg, "幼年天下第一","");
                arg = replace_string(arg, "幼年天下第二","");
                arg = replace_string(arg, "少年天下第一","");
                arg = replace_string(arg, "少年天下第二","");
                arg = replace_string(arg, "天下第一俠少","");
                arg = replace_string(arg, "天下第二俠少","");
                arg = replace_string(arg, "天下第一俠客","");
                arg = replace_string(arg, "天下第二俠客","");
                arg = replace_string(arg, "天下第一大俠","");
                arg = replace_string(arg, "天下第二大俠","");
        }
        return arg;
}
