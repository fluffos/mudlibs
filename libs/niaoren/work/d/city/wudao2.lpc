#include <ansi.h>;
inherit ROOM;
string look_list();
string look_sop();
void create()
{
        set("short", "比武大會壯年組報名區");
        set("long", @LONG
[1;36m            ╭[m
       [1;36m         ║[m
    [1;31m╭[33m◎[43m巛巛巛巛[46;35m■[47;37m▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃▃[m◣
[m[1;31m    │[36m          ║[m
[1;31m    ║[36m          ╯[m
[1;31m    ║[m
這裡是壯年組比武報名區，只有西面有條通向幼年組報名區的山間平地。山坡山陣
陣松濤嘩嘩作響，山腳下的平地綠草如茵，前方高地已經架起了個擂台，四周一溜
過去搭著涼棚，棚中桌椅杯盆俱全，看來比武大會快開始了。
    場中立有一面告示牌(list)及比武作業程序(sop)。
LONG );
        set("outdoors", "city");
        set("item_desc", ([
                "list" : (: look_list :),
                "sop" : (: look_sop :),
        ]));
        set("exits", ([
                "east"   : __DIR__"wudao4",
        ]));
        set("no_clean_up", 0);
        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        setup();
        "/clone/board/wudao_old"->foo();
}

void init()
{
        add_action("do_quit","quit");
        add_action("do_quit","exit");

        add_action("do_quit","exercise");
        add_action("do_quit","dazuo");
        add_action("do_quit","exert");
        add_action("do_quit","yun");
        add_action("do_quit","learn");
        add_action("do_quit","xue");
        add_action("do_quit","respirate");
        add_action("do_quit","tuna");
        add_action("do_quit","perform");
        add_action("do_quit","persuade");
        add_action("do_quit","quanjia");
        add_action("do_quit","practice");
        add_action("do_quit","lian");
        add_action("do_quit","study");
        add_action("do_quit","du");
        add_action("do_quit","teach");
        add_action("do_quit","jiao");
}

int do_quit(string arg)
{
        write(this_player()->query("name")+"，折騰個啥勁兒呀，專心看比武吧！\n");
        return 1;
}
int valid_leave(object me, string dir)
{
        object obj;
//      if ((dir == "leitai") && (!me->query_temp("leitai_allow")) && !wizardp(me))
//              return notify_fail("還沒到你比武呢，別猴急上去。\n");
//      if ((dir == "leitai") && (me->query_temp("leitai_allow")))
        if (dir == "leitai")
        {
                me->delete_temp("leitai_allow");
                me->delete_temp("view_leitai");
        }
        return ::valid_leave(me, dir);
}

string look_sop()
{
        return 
HIR"\n\n                           
                 比武作業程序
\n"HIY"
第一、依年齡選擇自已的組別。
第二、依自已的組別挑選自已的對手並告訴巫師，不知道要和誰比的告訴第二位
      主持人(巫師)，由該主持人(巫師)決定。
第三、檢查自已的狀態是否在最完美情況，如果是就等候通知上台比武(
      就是等，或是上擂台看人打)，如果不是在最快的時間內準備好。
第四、當主持人(巫師)拉你上台就表示換你打了。(你不需要作動作)
第五、上擂台後脫下自已的武器、防具，從兵器架上自行拿鐵甲及自已練的兵器
      指令為take armor . take sword。
第六、裝、穿上鐵甲及兵器後，exert 內功的特功，例如exert powerup(shield)。
第七、最後一次檢查自已的狀態，都好了就說ok。(為避免浪費其他人的時間請盡快)
第八、等主持人(巫師)執行開始指令。
"HIG"                                     鳥人一號 敬啟
\n"NOR;
}

string look_list()
{
        return 
HIR"\n\n
                 比武大會實施辦法
\n"HIY"
第一、每週四中午1200時舉行，1130至1200時為報名時間，逾時不候
第二、比賽按年齡分組，每組設天下第一，第二稱號。分組如下：
      幼年組 十五到十七歲 青年組 十七到三十歲 壯年組 卅一
第三、如果在某組內只有兩人，該二員就直接獲得該組第一、二名。
      若某組報名人數不滿二員，該組不予比賽。分組後請自行找對手，
      自已不找的由巫師在該組中分配。
第四、為使天下第一名實相符，允許使用現行所有武功，允許perform，
      powerup，enforce，poison等。但roar由于嚴重影響比武秩序，
      因此謝絕使用。違者停賽。
第五、比武實行淘汰制。每輪實行三局兩勝制，分別為：第一場比空手，
      第二場比兵器，第三場比兵器(不用特攻)，先勝兩局者進入下一輪。
第六、比賽時所用兵器和防具請在擂台上的兵器架上自行拿取，禁止使用
      非兵器架以外兵器及防具。
第七、比賽時請注意言行，犯眾怒者、違反現場巫師安排者，取消一年
      比賽資格。
第八、非比武選手請勿自行上擂台，要觀戰者於聽到公子平說：某人和某
      人開打時打到擂台觀戰，有違者，試試看！

"HIG"                                    鳥人一號  敬啟
\n"NOR;
}
