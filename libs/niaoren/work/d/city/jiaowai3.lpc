#include <room.h>
inherit ROOM;

void create()
{
    set("short", "樹林");
    set("long", @LONG
揚州郊外的樹林，松枝挺拔，喬木橫斜。林間小道，逶迤
隨遠。林中蟬鳴  鬧，鳥啼宛轉，使你頓時煩意盡消。
    地上落了很多樹枝石塊。
LONG );
    set("exits", ([
        "north" : __DIR__"jiaowai2",
        "south" : __DIR__"jiaowai4",
    ]));
    set("objects", ([
        __DIR__"obj/shitou": 2,
    ]));
//    set("no_clean_up", 0);
    set("outdoors", "yangzhou");
    setup();
    replace_program(ROOM);
}

