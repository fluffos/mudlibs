inherit ROOM;

void create()
{
	set("short", "桃花坪");
	set("long", @LONG
桃花坪是個小盆地。此處四面環山，山間白云繚繞，山上桃林
層疊，如列屏障。中有小溪潺潺流過，清澈碧透。春鳥嬌鳴，游魚
踴躍，春嵐氣動，景象萬千。坪中大大小小琉瓦別墅，山野之中諸
多風味。
LONG );
	set("outdoors", "city");
	set("no_clean_up", 0);
	set("exits", ([
		"south"     : __DIR__"taohua4",
	]));
	setup();
}
