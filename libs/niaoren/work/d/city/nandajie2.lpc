inherit ROOM;

void create()
{
	set("short", "南大街");
	set("long", @LONG
你走在一條繁華的街道上，向南北兩頭延伸。南邊是南城門，北邊通往市
中心，西邊是一家顧客眾多的茶館，三教九流人士都在那里談天說地。東邊一
座兩層的樓房傳來陣陣浪笑，那就是天下聞名的麗春院。
LONG );
        set("outdoors", "city");
//	set("no_clean_up", 0);
	set("exits", ([
		"east"  : __DIR__"lichunyuan",
		"south" : __DIR__"nanmen",
		"west"  : __DIR__"chaguan",
		"north" : __DIR__"nandajie1",
	]));
        set("objects", ([
                CLASS_D("shaolin") + "/tuoboseng" : 1,
                "/d/dali/npc/duanyu": 1,
        ]));
	setup();
}

int valid_leave(object me, string dir)
{
	if (dir == "east" && (int)me->query("age") < 18 && !wizardp(me))
		return notify_fail("小朋友不要到那種地方去！！\n");
	return 1;
}
