inherit ROOM;

void create()
{
      set("short","馬廄\");
      set("long",@LONG
這是客店后的馬廄\，常年供應新鮮草料。揚州民風淳朴，馬夫們會把
馬牽到馬廄\好生照看，將它們喂飽飲足，再洗刷得干乾淨淨，一直伺候到
客人上路。馬廄\雨檐下的爛木柱上釘著一塊破木牌(paizi)。
    馬廄\中堆放著几堆草料，正中有一口泔槽。
LONG);
      set("outdoors", "city");
      set("no_fight", "1");
      set("no_beg", "1");
      set("no_clean_up", 0);
      set("objects", ([
               __DIR__"npc/zaohongma": 1,
               __DIR__"npc/huangbiaoma": 1,
               __DIR__"npc/ziliuma": 1,
               __DIR__"npc/mafu": 1,
      ]));
      set("item_desc", ([
          "paizi": @TEXT
客人們只要給馬夫一兩白銀的租金就可以雇到一匹馬了。

前往      北京城:  ridebj
          蘇州城:  ridesz
          杭州城:  ridehz
          福州城:  ridefz
          大理城:  ridedl
          襄陽城:  ridexy
          永登城:  rideyd
          伊犁鎮:  rideyl
          佛山鎮:  ridefs
          峨嵋山:  rideem

TEXT]));
      set("exits",([ /* sizeof() == 1 */
          "west"      : __DIR__"kedian",
      ]));
      setup();
      replace_program(ROOM);
}
