// square.c

inherit ROOM;

void create()
{
        set("short", "練武場");
        set("long", @LONG
這裡是揚州武館的練武場，場上立著幾個木人看來是讓新手練習的好對象，
你可以用"fight mu"來練習，記得武器要用雞骨頭，身上可以到雜貨店去買
金絲甲來穿，你看到西邊靠牆有張桌子，你可以用push或move這個指令，
牆上有塊牌子(list)。
LONG );
        set("exits", ([ /* sizeof() == 2 */
            "north"     : __DIR__"wuguan2",
            "south"     : __DIR__"wuguan7",
            "east"     : __DIR__"wuguan8",
            "west"     : __DIR__"wuguan9",
            "northwest"     : __DIR__"wuguan10",
            "northeast"     : __DIR__"wuguan11",
        ]));
        set("objects", ([
            "/d/shaolin/npc/mu-ren" : 5,
        ]));
        set("item_desc", ([
                "list" : "桌子是鳥人一號虎爛的，哈哈哈！
                          你被騙了！好爽！！！
                          為了獎賞你被騙鳥人一號特地在南
                          邊作一些很有用的房間哦！\n",
        ]));
//        set("no_clean_up", 0);
        set("outdoors", "xx" );

        setup();
}


