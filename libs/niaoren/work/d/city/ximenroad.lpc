inherit ROOM;

string look_gaoshi();

void create()
{
    set("short", "西門大道");
	set("long", @LONG
這里是揚州西城門外大道。西通長安城，向東就是西門了。南邊，新開了
個武道大會場，每到比武之期，人聲鼎沸，你不禁想去見識一下當今的成名人
物。
LONG );
        set("outdoors", "city");
//	set("no_clean_up", 0);
	set("item_desc", ([
		"gaoshi" : (: look_gaoshi :),
	]));
	set("exits", ([
		"east"  : __DIR__"ximen",
  		"west"  : "/d/city4/road1",
		"south" : __DIR__"wudao4",
	]));
        set("objects", ([
            "/d/village/npc/boy" : 3,
        ]));
	setup();
}
int valid_leave(object me, string dir)
{
	object obj;
	if (dir == "south") me->set_temp("view_leitai",1);
        return ::valid_leave(me, dir);
}

