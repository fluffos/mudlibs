#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
      set("short", "聽月閣");
      set("long",
"這里是‘聽月閣’，是江湖奇人淨南的家。屋內布置古朴典雅，\n"
"不帶一絲俗氣。房內家具雖然不多，但都顯得恰到好處，最引人注目\n"
"的是右首一個古色古香的紅木書柜，里面放滿了各門派的武功密籍。\n"
"左首是一張大床，床邊茶几上還有一套別致的茶具，里面的茶正冒著\n"
"熱氣，使整個房間彌漫著淡淡的茶香。牆上貼著一幅主人手書的狂草：\n"
BLU"        閑看庭前花開花落\n"
"        漫隨天外云卷云舒\n"NOR
);
      set("exits", ([ /* sizeof() == 1 */
          "south" : __DIR__"jiaowai7",
      ]));
      set("valid_startroom","1");

      set("no_fight", 1);
      set("no_clean_up", 0);
      set("sleep_room", 1);
      setup();
      create_door("south", "雕花小門", "north", DOOR_CLOSED);
}


