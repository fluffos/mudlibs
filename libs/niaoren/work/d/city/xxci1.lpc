#include <room.h>
inherit ROOM;

void create()
{
	set("short", "先賢祠－玩家部");
	set("long", @LONG
這里是紀念杰出玩家的地方。供奉在這里的無論是俠客還是魔頭，
都曾經叱詫一時。抬頭一張橫匾，上書七個閃閃發光的金字：
天下誰人不識君
注：排名不分先后。按字母順序。
LONG );
	set("exits", ([ /* sizeof() == 2 */
		"up" : __DIR__"xxci2",
		"down" : __DIR__"shuyuan",
		"south" : __DIR__"xxci3",
	]));
	set("no_fight",1);
	set("no_clean_up", 0);

	set("objects", ([ /* sizeof() == 1 */
		"/d/npc/arnzh" : 1,
		"/d/npc/swh" : 1,
		"/d/npc/oscar" : 1,
		"/d/npc/peter" : 1,
		"/d/npc/rew":1,
		"/d/npc/basic" : 1,
		"/d/npc/goose" : 1,
		"/d/npc/sasa" : 1,
		"/d/npc/rose" : 1,
		"/d/npc/icom" : 1,
	]));

	create_door("south","木門","north",DOOR_CLOSED); 	
	setup();
	replace_program(ROOM);
}
