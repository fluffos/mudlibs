inherit ROOM;

void create()
{
	set("short", "醉仙樓");
	set("long", @LONG
方圓數百里內提起醉仙樓可以說是無人不知，無人不曉。當年蘇學士云
游到此，對醉仙樓的花雕酒贊不絕口，欣然為其題匾，流下一段傳遍海內的
佳話，從此醉仙樓名聲大震。樓下布置簡易，顧客多是匆匆的行人，買點包
子、雞腿、米酒就趕路去了。樓上是雅座。
LONG );
	set("exits", ([
		"west" : __DIR__"beidajie2",
                  "east" : __DIR__"chufang",
		"up" : __DIR__"zuixianlou2",
	]));
	set("objects", ([
		__DIR__"npc/xiaoer2" : 1,
	]));
//	set("no_clean_up", 0);
	setup();
}

