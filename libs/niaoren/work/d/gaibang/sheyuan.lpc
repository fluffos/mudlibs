//room: sheyuan.c
inherit ROOM;

void create()
{
	set("short","蛇園");
	set("long", @LONG
這里是丐幫弟子的蛇園。丐幫弟子生活儉朴，隨地坐臥，不免常
受蛇虫侵犯。日久天長，漸漸摸索出馴養之道。這里遍地是蛇，牆上
也巴著蛇，屋檐上也向下垂著蛇，樹枝上也盤繞著蛇，不由你不心驚。
LONG );
	set("exits",([
		"west"  : "/d/city/pomiao",
	]));
	set("outdoors", "baituo");
	set("objects",([
		"/d/shenlong/npc/jinshe" :1,
		"/d/shenlong/npc/dushe" :1,
		"/d/shenlong/npc/fushe" :1,
		"/d/shenlong/npc/qingshe" :1,
		"/d/fuzhou/npc/wubushe" :1,
	]));
	setup();
}

