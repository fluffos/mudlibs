inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
這里是一條很普通的山路，路邊的樹林密集，芳草流香，草叢
中星星點點地點綴著一些白色野花，漸行漸低，兩邊草木茂盛，處
高崖下，天色漸陰。
LONG );
	set("exits", ([
		"southwest" :__DIR__"tohtq1",
		"northdown" :__DIR__"tohtq3",
	]));
	set("outdoors", "mingjiao");
	set("no_clean_up", 0);
	setup();
}
