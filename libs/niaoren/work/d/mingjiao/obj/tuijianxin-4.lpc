// tuijianxin-4.c 推荐信 堂-王

inherit ITEM;

void create()
{
        set_name("推荐信", ({"tuijian xin4", "xin4", "letter4"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("long","這是一封堂主為你寫的推荐信，憑此可去見護教法王。\n");
                set("material", "paper");
        }
}

