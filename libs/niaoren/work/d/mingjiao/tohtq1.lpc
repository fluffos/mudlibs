//TOHTQ1.C

inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
這里是一條很普通的山路，路邊的樹林密集，芳草流香，草叢
中星星點點地點綴著一些白色野花，路面也越來越干燥，遠處可見
陣陣塵土飛揚，為這山谷陡增了几分生氣。
LONG );
	set("exits", ([
		"southwest" :__DIR__"tojmq3",
		"northeast" :__DIR__"tohtq2",
	]));
	set("outdoors", "mingjiao");
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}
