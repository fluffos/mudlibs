// jianyu.c
inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", BLU"梅庄地牢"NOR);
        set("long", @LONG
這里黑黑暗暗，几乎伸手不見五指。唯一的光亮來自牆上忽明忽暗的
松油燈。地上和牆上布滿了暗紅色的血痕，散發出陣陣腥氣。不斷傳來的
喘息聲在死沉的地牢里回蕩，令人毛骨聳然。從地牢的牆縫里透出几縷陽
光。
LONG
        );
        set("item_desc", ([
                "wall": "牆上的青石磚似乎以前有人動過什么手腳。\n",
        ]) );
        set("objects", ([
                "/d/heimuya/npc/renwoxing" : 1,
        ]) );
        set("valid_startroom","1");

        setup();
}

void init()
{
        add_action("do_push", "push");
}

void check_trigger()
{
        object room;
        if( (int)query("trigger")==8 && !query("exits/out") )
        {
message("vision", "牆壁被你推得裂開了一道縫隙，剛好可以容你鑽出去。\n", this_object() );
                set("exits/out", __DIR__"xiaowu");
                if(!( room = find_object(__DIR__"xiaowu")) )
                     room = load_object(__DIR__"xiaowu");
                message("vision", "地下突然裂開一條窄縫。\n", room );
                room->set("exits/enter", __FILE__);
                delete("trigger");
                call_out("close_passage", 5);
        }
}

void close_passage()
{
        object room;

        if( !query("exits/out") ) return;
        message("vision",
"一片沙土落下來, 又將通道掩蓋住了。\n", this_object());
//        if( room = find_object(__DIR__"east_castle") ) {
        if( room = find_object(__DIR__"xiaowu") )
        {
message("vision", "一片沙土落下來，又將通道掩蓋住了。\n", room );
                room->delete("exits/enter");
        }
        delete("exits/out");
}

int do_push(string arg)
{
        string dir;

        if( !arg || arg=="" )
        {
                write("你要推什么？\n");
                return 1;
        }

        if( arg=="wall" || arg == "牆壁")
        {
                add("trigger", 1);
                write("你試著用力推著牆壁上的青磚，似乎有一點松動....\n");
                check_trigger();
                return 1;
        }
}

void reset()
{
        ::reset();
        delete("trigger");
}

