// keting.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "迎客亭"); 
        set("long", @LONG
通過四雅清風，你來到了梅庄的迎客亭，這里雖然只有一張石桌
几個石凳，但卻是一塵不染，石凳和石桌之間的空隙很大，顯是方便
來客與主人相互寒暄。一位漢子正站在亭前，沖你拱手微笑。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
            "south" : __DIR__"dating",
            "north" : __DIR__"senlin1",
        ]));

        set("objects", ([ /* sizeof() == 1 */
            __DIR__"npc/shi.lpc" : 1,
        ]));
        set("no_clean_up", 0);
        set("item_desc", ([
            "table": "一張很平常的石桌，但是......自己猜吧。\n"
        ]) );

        setup();
}
void init()
{
        add_action("do_zuan", "zuan");
}
int do_zuan(string arg)
{
        string dir;
        object me=this_player();

        if( !arg || arg=="" )
        {
                write("你要往哪兒鑽？\n");return 1;
        }
        if( arg=="table" )
        {
                write("你躡手躡腳的繞到石桌的后面，鑽進了下面的一個小洞。\n");
                if((int)me->query_skill("dodge",1)>=30)
                {
                      write("你費盡九牛二虎之力，發現自己到了一個很神秘的地道里。\n");
                      me->move(__DIR__"didao1");
                      return 1;
                }
                write(RED"你試著鑽了一下后面的一個小洞，發現鑽不進去。\n"NOR);
                me->add("jing",-10);
                me->add("qi",-10);

                return 1;
        }
}

