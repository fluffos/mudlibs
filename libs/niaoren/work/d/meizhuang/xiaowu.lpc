// xiaowu.c
inherit ROOM;

void create()
{
        set("short", "小屋");
        set("long", @LONG
你進了這間小屋以后，發現這里竟然和你想象的差別很大，這里
雖然不能說是金碧輝煌，但到處都是玉制的物器，玉桌，玉椅，玉屏
風，玉茶壺，玉杯......數不勝數。牆上挂著一根綠玉蕭和一具白玉
瑤琴。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
            "out" : __DIR__"xiaoyuan",
        ]));
        set("objects", ([ /* sizeof() == 2 */
            __DIR__"npc/huangzhong-gong" : 1,
            __DIR__"obj/wall" : 0,
        ]));
//        set("no_clean_up", 0);
        set("outdoors", "meizhuang");

        setup();
}

