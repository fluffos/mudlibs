// xiaolu.c
inherit ROOM;

void create()
{
        set("short", "蜿蜒小徑");
        set("long", @LONG
這條小路的兩旁種著無數的梅花，雖然還沒到梅花盛開的季節，
但透過這密密的梅林，你似乎已經聞到了陣陣的梅花的幽香，這時你
已經發現你快走到庄園的門口，你暗地里加快了腳步．
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
            "south" : __DIR__"shijie",
            "north" : __DIR__"gate",
        ]));
        set("outdoors", "meizhuang");
        set("no_clean_up", 0);

        setup();
}

