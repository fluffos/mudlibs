#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short","正廳");
        set("long",
"這裡是邪神山莊的正廳，平時莊主【"HIB"邪神曠世"NOR"】於此坐鎮指揮，據說能打敗\n"
"他的人不多，讓人懷疑他的能力，若你能力未及張三豐，切勿向他挑戰，避免招\n"
"來殺身之禍。\n"
"由此往北是"HIR"邪神曠世廳"NOR"，往南則是"HIG"菜菜居"NOR"。\n"
"                                \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"cloud_c",
                "south" : __DIR__"nanako",
        ]));

// 一個曠世(andy.c)
        set("objects", ([
                __DIR__"npc/andy" : 1,
        ]));

        create_door("south", "木門", "north", DOOR_CLOSED);
//        set("no_clean_up", 0);
        setup();
        "/clone/board/kedian_b"->foo();
        replace_program(ROOM);
}
