#include <ansi.h>
inherit ROOM;

void create()
{
       set("short",HIR "將邪窟"NOR);
        set("long",
"到了這裡，你感到一陣炙熱氣息向你撲來，抬頭一看，原來這有著兩座\n"
"奇大無比的練劍爐，在練劍爐前站著一對男女；走近一看，你驚異的發現他\n"
"門兩個居然是江湖盛傳為鑄造聖手的『干將』與『莫邪』！\n"
"                                                              \n"
"看來你可以為自己鑄造一些裝備用了...............\n"
"                                                              \n"
);
        set("outdoors", "cloud");
        set("exits", ([
//                "north" : __DIR__"hunto2",
                "south" : __DIR__"diejian",
        ]));

        set("objects", ([
                __DIR__"npc/ganjiang" : 1,
                __DIR__"npc/moye" : 1,
        ]));

        setup();
        //replace_program(ROOM);
}
