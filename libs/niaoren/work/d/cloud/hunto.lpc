inherit ROOM;

void create()
{
        set("short", "黃土路");
        set("long", @LONG
這裡是一條黃土小路，路面很新，似乎常有人從這經過，南方不遠處似
乎有一個山莊，正裊裊冒著炊煙。
LONG
        );
        set("outdoors", "cloud");
        set("exits", ([
                "west" : "/d/taishan/taishanjiao",
                "south" : __DIR__"hunto2",
        ]));

        setup();
        replace_program(ROOM);
}
