#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIG "左邪一進"NOR);
        set("long",
"這裡是左邪一進，平時這裡少有人煙，除了一些打雜的雜役外，幾乎沒人。\n"
"                                              \n"
"由此往西是"HIG"左邪二進"NOR"，往東是"HIG"邪雲廣場"NOR"，往南是休息室，向北則是"HIW"名人劍塚"NOR"。\n"
"                                \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"diejian",
                "south" : __DIR__"qkroom1",
                "west" : __DIR__"ls_2",
                "east" : __DIR__"cloud_c",
        ]));

//      set("objects", ([
//              __DIR__"" : 1,
//      ]));

        set("no_clean_up", 0);
        setup();
}
