#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",HIW "名人劍塚"NOR);
        set("long",
"                                        \n"
"                           "HIB"************"NOR"\n"
"                           "HIB"**        **"NOR"\n"
"                           "HIB"**        **"NOR"\n"
"                           "HIB"**   "HIW"名"HIB"   **"NOR"\n"
"                           "HIB"**   "HIW"人"HIB"   **"NOR"\n"
"                           "HIB"**   "HIW"劍"HIB"   **"NOR"\n"
"                           "HIB"**   "HIW"塚"HIB"   **"NOR"\n"
"                           "HIB"**        **"NOR"\n"
"                           "HIB"**        **"NOR"\n"
"                          "HIB"**************"NOR"\n"
"                         "HIB"****************"NOR"\n"
"                    \n"
"    這裡就是劍塚了，地上散佈無數片劍的碎片，由碎片的材質看來，似乎\n"
"都是名劍的碎片；這裡充斥著奇大無比的憤怨氣息，看來是由這些碎片所散\n"
"發出來，不知這些名劍原是哪些江湖高手所用，竟帶著靈氣，令人感到十分\n"
"惋惜。\n"
"                                                              \n"
"你突然感到一股寒氣急速向你逼近。\n"
"你的潛意識告訴你：此地不宜久留，速速離開為妙。\n"
"                                                              \n"
);
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"jsku",
                "south" : __DIR__"ls_1",
        ]));

//      set("objects", ([
//              __DIR__"npc/tufay" : 2,
//      ]));

        setup();
        //replace_program(ROOM);
}
