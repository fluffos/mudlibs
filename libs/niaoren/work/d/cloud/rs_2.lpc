#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",HIW "右邪二進"NOR);
        set("long",
"這裡是右邪二進，平時這裡少有人煙，除了一些打雜的雜役外，幾乎沒人。\n"
"                                              \n"
"由此往西是"HIG"右邪一進"NOR"，往東則是"HIG"右邪三進"NOR"，往南是武器室。\n"
"                                \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("outdoors", "cloud");
        set("exits", ([
                "west" : __DIR__"rs_1",
                "south": __DIR__"binchi",
                "east" : __DIR__"rs_3",
        ]));

//      set("objects", ([
//              __DIR__"" : 1,
//      ]));

        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
