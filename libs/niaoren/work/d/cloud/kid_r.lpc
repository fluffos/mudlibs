#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "弒佛門");
        set("long",
"                                                    \n"
"                    "HIY"------------------------"NOR"                  \n"
"                    "HIY"|"NOR" "HIW"弒       佛       居"NOR""HIY" |"NOR"\n"
"                    "HIY"------------------------"NOR"                  \n"
"這裡是無悔居，是三莊主無名與夫人回憶平時起居的場所，門口站著兩隻\n"
"好不威風；在門旁佔了兩位土匪，似乎是負責看門的吧。\n"
"                                                              \n"
"由此往北是"HIY"右邪三進"NOR"，往南則是弒佛園。\n"
"                                                              \n"
);
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"rs_3",
                "south" : __DIR__"kid_f",
        ]));

// 兩個 NO AUTO K NPC 土匪(tufay_na.c)
        set("objects", ([
                __DIR__"npc/tufay_na" : 2,
        ]));

        setup();
        //replace_program(ROOM);
}
