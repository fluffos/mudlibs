// chanjung.c 土匪錢莊
// 2000.8 by andy

inherit ROOM;

void create()
{
        set("short", "土匪錢庄");
        set("long", @LONG
這是莊主曠世為了培養莊內土匪養成儲蓄的好習慣而成立的錢莊，但外界
的人似乎不相信他們會存錢。但這卻是真的錢莊，而且還是楊州錢莊的分店呢
。
      在對面的牆上挂了塊牌子(paizi)。
LONG );
        set("exits", ([
                "west" : __DIR__"sgodrold",
        ]));
        set("item_desc", ([
                "paizi" : @TEXT
     本錢庄提供以下服務：
      存錢        deposit  或者 cun
      取錢        withdraw 或者 qu
      錢幣兌換    convert  或者 duihuan
      查帳        check或  者   chazhang
TEXT
        ]) );

        set("objects", ([
                __DIR__"npc/qian" : 1
        ]));
        set("no_clean_up", 0);
        set("no_fight", 1);
        set("no_beg", 1);
        setup();
        replace_program(ROOM);
}

