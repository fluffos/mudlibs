#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",HIG "邪雲廣場"NOR);
        set("long",
"這裡就是邪雲廣場了，四周充斥著"HIG"邪靈"NOR"的氣息，在這裡的土匪們似乎已，\n"
"被邪靈影響！雙眼泛紅，嗜"HIR"血"NOR"如命；若你還沒有充分準備，千萬不要向他們挑\n"
"戰。\n"
"由此往北是"HIW"邪神道"NOR"，往南是"HIR"邪神曠世殿"NOR"，往東是"HIG"右邪一進"NOR"，往西則是"HIG"左邪一進"NOR"。\n"
"                                \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"sgodrold",
                "east" : __DIR__"rs_1",
                "west" : __DIR__"ls_1",
                "south" : __DIR__"andy_r",
        ]));

// 五個 NPC 瘋狂土匪(tufay.c)
        set("objects", ([
                __DIR__"npc/c_tufay" : 5,
        ]));

        set("no_clean_up", 0);
        setup();
}
