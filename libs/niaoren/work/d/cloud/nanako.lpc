#include <ansi.h>
#include <room.h>

inherit ROOM;
void create()
{
        set("short","菜菜居");
        set("long","這裡就是菜菜子之家了，平時莊主【"HIB"邪神曠世"NOR"】的"HIR"情婦"HIG"松島菜菜子"NOR"都在此修\n"
"行，據說菜菜子"HIR"極其淫蕩"NOR"之本能，勾引男人的功力無人能敵，若你自認"HIW"很有檔頭\n"
"（台語）"NOR"的話，不訪和他"HIW"嘿咻嘿咻 【ask nanako about hs】"NOR"看看（"HIR"如果你不怕\n"
"被曠世幹掉的話"NOR"）。\n\n"
"由此往北是正廳，往南則是【沒有路了】。\n\n");

//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"c_tin",
//              "south" : __DIR__"",
        ]));

// 一個松島菜菜子(nanako.c)
        set("objects", ([
                __DIR__"npc/nanako" : 1,
                "/d/city/npc/obj/manbai" : 1,
        ]));

        create_door("north", "木門", "south", DOOR_CLOSED);
//      set("no_clean_up", 0);
        setup();
}
