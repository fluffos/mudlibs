// tufay.c 土匪嘍囉
// 2000.8 by andy

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("土匪嘍囉", ({"tufay", "tu"}));
        set("gender", "男性");
        set("age", 30);
        set("per", 15);
        set("long",
                "他看來尖嘴猴腮，斜眼看著你不知在想些什麼好事！\n"
        );
        set("attitude", "friendly");

        set("qi", 200);
        set("max_qi", 200);
        set("jing", 100);
        set("max_jing", 100);
        set("neili", 180);
        set("max_neili", 180);
        set("jiali", 30);

        set("combat_exp", 1500);
        set("score", 0);

        set_skill("force", 10);
        set_skill("unarmed", 10);
        set_skill("dodge", 10);
        set_skill("club", 10);
        set_skill("parry", 10);
        set_skill("literate", 10);
        set_skill("shaolin-shenfa", 10);
        set_skill("zui-gun", 10);
        map_skill("force", "hunyuan-yiqi");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("club", "zui-gun");
        map_skill("parry", "zui-gun");

        set("inquiry", ([
                "邪將" :  "曠世是我們的頭子，他對我們實在很好，現在還搞了一個這麼大的房子給我們住，真是他媽的好丫...\n",
        ]) );

        set("env/wimpy", 10);
        setup();

        carry_object("/clone/weapon/gun")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("silver", 25);
}
