// roye.c 亂世間
// 2000.8 by andy
#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR"亂世間"NOR, ({ "roy" }) );
        set("title", HIB"邪神山莊"HIW"二"HIB"莊主");
//      set("title", "二莊主");
        set("gender", "男性" );
        set("age", 23);
        set("per", 45);
        set("long","他是這個"HIB"邪神山莊"NOR"的"HIR"二"NOR"莊主，平時為非作歹；行事怪僻、\n"
                   "聽說他有一個接班人，叫做"HIW"【平天下】"NOR"，老是跟他唱反調\n"
                   "，連名字都和他相反；實在是絕配丫。"NOR"\n"
        );

        // 膂力
        set("str", 35);
        // 根骨
        set("con", 35);
        // 身法
        set("dex", 30);
        // 悟性
        set("int", 30);

        // 氣
        set("qi",550);
        // 最大氣
        set("max_qi", 550);
        // 精
        set("jing",60);
        // 最大精
        set("max_jing", 60);
        // 內力
        set("neili", 800);
        // 最大內力
        set("max_neili", 800);
        // 精力
        set("jiali", 30);
        set("shen_type", 0);
        set_temp("apply/attack",  20);
        set_temp("apply/defense", 20);
        set_temp("apply/damage",  20);

        set("combat_exp", 2000000);
        set("str", 27);
        set("kar", 100);
        set("thief", 0);
	set("shen", -1000);

        // 最大內力
        set("max_force", 200);
        set("force_factor", 2);

        set_skill("force", 150);
        set_skill("yunv-xinfa", 150);    //玉女心法
        set_skill("sword", 150);
        set_skill("yunv-jian", 150);     //玉女劍
        set_skill("quanzhen-jian",150);  //全真劍
        set_skill("dodge", 150);
        set_skill("yunv-shenfa", 150);   //玉女身法
        set_skill("parry", 150);
        set_skill("hubo", 150);          //雙手互搏
        set_skill("unarmed", 150);
        set_skill("meinv-quan", 150);    //美女拳法
        set_skill("literate", 150);
        set_skill("qufeng", 150);        //驅蜂之朮
        set_skill("anranxiaohun-zhang", 100);  // 黯然消魂掌

        map_skill("force", "yunv-xinfa");
        map_skill("sword", "yunv-jian");
        map_skill("dodge", "yunv-shenfa");
        map_skill("parry", "meinv-quan");
        map_skill("unarmed", "anranxiaohun-zhang");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.yu1" :),
                (: perform_action, "parry.me1" :),
                (: perform_action, "unarmed.an1" :),
                (: command("hubo") :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "r" :),
        }) );

        setup();
        set("chat_chance", 3);
        set("chat_msg", ({
                "亂世間說道：你不是本山莊的人，來這裡要做什麼！？\n",
                "亂世間懶洋洋地打了個哈欠。\n",
                "亂世間反手一扭打開了紙扇，說道：世間本平靜，惟我亂世間。 \n",
                "亂世間說道：狗娘養的！這個死曠世，一個月只給我一百五十兩白銀來噹啷，連嫖個妓都不夠！\n",
                (: random_move :)
        }) );
        carry_object(__DIR__"obj/rysword")->wield();
        carry_object(__DIR__"obj/magjia")->wear();
        add_money("silver", 150);
}