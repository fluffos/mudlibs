// andy.c 曠世
// 2000.8 by andy

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create()
{
        set_name(HIR"『"HIY"邪神"HIR"』"HIB"曠世"NOR, ({ "andyc" }) );
        set("title", HIB"邪神山莊"NOR"大莊主");
//      set("title", "莊主");
        set("gender", "男性" );
        set("age", 23);
        set("per", 45);
        set("long","他就是武林頭號"HIB"優質"NOR"土匪"HIR"【"HIG"邪將" HIR"】"HIB"曠世"NOR"，不過他長的玉樹臨風、成熟穩重\n"
                   "；似乎沒有一點土匪的氣息。因為早年曾拜武當祖師  張三豐門下，對太\n"
                   "極神功頗用心鑽研；本為武林正派人士，無奈其友遭人殺害，決心創立邪\n"
                   "神山莊，危害武林。\n"NOR);

        // 膂力
        set("str", 35);
        // 根骨
        set("con", 35);
        // 身法
        set("dex", 30);
        // 悟性
        set("int", 30);

        // 氣
        set("qi",600);
        // 最大氣
        set("max_qi", 600);
        // 精
        set("jing",60);
        // 最大精
        set("max_jing", 60);
        // 內力
        set("neili", 800);
        // 最大內力
        set("max_neili", 800);
        // 精力
        set("jiali", 30);
        set("shen_type", 0);
        set("combat_exp", 5500000);
        set("str", 27);
        set("kar", 100);
        set("thief", 0);
        set("shen", -1000000);
        // 內力
        set("force", 600);
        // 最大內力
        set("max_force", 600);
        set("force_factor", 2);
 
        set_skill("force", 400);           // 基本內功
        set_skill("taiji-shengong", 400);  // 太極神功
        set_skill("dodge", 400);           // 基本輕功
        set_skill("tiyunzong", 400);       // 梯雲縱
        set_skill("unarmed", 400);         // 基本拳腳
        set_skill("taiji-quan", 400);      // 太極拳
        set_skill("parry", 400);           // 基本招架
        set_skill("sword", 400);           // 基本劍法
        set_skill("taiji-jian", 400);      // 太極劍法
        set_skill("blade", 400);           // 基本刀法
        set_skill("taiji-dao", 400);       // 太極刀
        set_skill("taoism", 400);          // 道學心法
        set_skill("literate", 400);        // 讀書寫字

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "taiji-dao");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );
        
        setup();
        set("chat_chance", 3);
        set("inquiry", ([
                "問天" : "他是我打 AOE 2 的假想敵，亂強一把的。\n",
                "曠世邪神劍" : "那是邪神曠世耗了七七四十九天打造出來的一級邪神兵。\n",
                "亂世間" : "他是天下第一大痞子，沒有人能夠比他更痞了。\n",
                "青玹" : "我也不是粉清楚說，他是突然有一天出現要跟我比武加入山莊當莊主\n",
                "鳥人一號" : "他乃是神界第一人，也是提拔我升級到『大巫師』的恩人。\n",
                "曠世" : "就是我啦！沒看過這麼帥的人對不對，不好意思啦！\n",
        ]));

        set("chat_msg", ({
                "曠世說道：我本是武林正派人仕，無奈遭人陷害，心有不平；決心反叛報復。\n",
                "曠世反手一扭打開了紙扇，說道：我心本善，無奈眾人皆叛我。 \n",
                "曠世說道：奶奶你個熊！這個亂世間，有事沒事給我亂跑，想找他比登天還難！\n",
        }) );
        // 身上帶著一把曠世戰神劍，身穿紫金戰甲
        carry_object(__DIR__"obj/warsword")->wield();
        carry_object(__DIR__"obj/magjia")->wear();
        // 和 20 兩黃金
        add_money("gold", 20);
}
