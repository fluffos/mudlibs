#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR"阿信"NOR, ({ "kidc" }) ); 
        set("title", HIB"邪神山莊"HIW"四"HIB"莊主");
        set("gender", "男性" );
        set("age", 23);
        set("per", 45);
        set("long","他是這個邪神山莊的四莊主，平時色膽無邊；行事怪僻、\n"
                   "聽說他家中 a-pan 收藏逾萬，實為第一色魔。\n"
        );

        // 膂力
        set("str", 35);
        // 根骨
        set("con", 35);
        // 身法
        set("dex", 30);
        // 悟性
        set("int", 30);

        // 氣
        set("qi",550);
        // 最大氣
        set("max_qi", 550);
        // 精
        set("jing",60);
        // 最大精
        set("max_jing", 60);
        // 內力
        set("neili", 800);
        // 最大內力
        set("max_neili", 800);
        // 精力
        set("jiali", 30);
        set("shen_type", 0);

        set_temp("apply/attack",  20);
        set_temp("apply/defense", 20);
        set_temp("apply/damage",  20);
        set("combat_exp", 3000000);
        set("str", 27);
        set("kar", 100);
        set("thief", 0);
	set("shen", -5000);

        // 最大內力
        set("max_force", 200);
        set("force_factor", 2);
        set_skill("array", 111);            // 基本陣法
        set_skill("cuff", 168);             // 基本拳法
        set_skill("dodge", 209);            // 基本輕功
        set_skill("dugu-jiujian", 242);     // 獨孤九劍
        set_skill("force", 229);            // 基本內功
        set_skill("huashan-shenfa", 175);   // 華山身法
        set_skill("hubo", 29);              // 左右互搏
        set_skill("hunyuan-zhang", 168);    // 混元掌
        set_skill("jinshe-jian", 48);       // 金蛇劍法
        set_skill("jinshe-zhang", 82);      // 金蛇游身掌
        set_skill("jinyan-gong", 195);      // 金雁功
        set_skill("jiuyin-baiguzhao", 231); // 九陰白骨抓
        set_skill("literate", 450);         // 讀書寫字
        set_skill("parry", 209);            // 基本招架
        set_skill("poyu-quan", 160);        // 劈石破玉拳
        set_skill("strike", 183);           // 基本掌法
        set_skill("sword", 239);            // 基本劍法
        set_skill("taoism", 99);            // 道學心法
        set_skill("unarmed", 155);          // 基本拳腳
        set_skill("wuyun-jianfa", 80);      // 五韻七弦劍
        set_skill("xuantian-zhi", 90);      // 玄天無情指
        set_skill("zixia-shengong", 229);   // 紫霞神功

        map_skill("force", "zixia-shengong");
        map_skill("sword", "dugu-jiujian");
        map_skill("strike", "jinshe-zhang");
        map_skill("dodge", "jinyan-gong");

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: perform_action, "sword.po2" :),
                (: perform_action, "sword.po3" :),
                (: perform_action, "sword.po4" :),
                (: perform_action, "sword.po5" :),
                (: perform_action, "sword.po6" :),
                (: perform_action, "sword.po7" :),
                (: perform_action, "sword.po8" :),
                (: perform_action, "sword.po9" :),
                (: perform_action, "strike.ji1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
        }) );

        setup();
        set("chat_chance", 3);
        set("chat_msg", ({
                "阿信說道：你不是本山莊的人，來這裡要做什麼！？\n",
        }) );
        carry_object(__DIR__"obj/kidsword")->wield();
        carry_object(__DIR__"obj/magjia")->wear();
        add_money("gold", 5);
}