// asd.c 青玹

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR"『"HIY"邪神"HIR"』"HIB"青玹"NOR, ({ "asd" }) );
        set("title", HIB"邪神山莊"NOR"三莊主");
        set("long","他就是武林中最神秘的人物\n"
                    "其武功佛、道、魔三修\n"
                    "終其一生浪跡天涯，尋找著某項事物\n"
                    "傳說他具有二種身分，不過卻是誰也不知道\n"
                    "就連山莊內的人也都沒人曉得");
        set("gender", "男性");
        set("age", 23);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("kar", 30);
        set("per", 32);
        
        set("max_qi", 5000);
        set("max_jing", 5000);
        set("neili", 50000);
        set("max_neili", 50000);
        set("jiali", 0);
        set("combat_exp", 20000000);
        set("score", 2000000);

        set_skill("force", 100);
        set_skill("hand", 100);
        set_skill("cuff", 100);
        set_skill("strike", 100);
        set_skill("finger", 100);
        set_skill("jiuyang-shengong", 100);
        set_skill("jiuyin-baiguzhao", 100);
        set_skill("liumai-shenjian", 100);
        set_skill("liuyang-zhang", 100);
        set_skill("dugu-jiujian", 100);
        set_skill("qishang-quan", 100);
        set_skill("ruyi-dao", 100);
        set_skill("zhemei-shou", 100);
        set_skill("zixia-shengong", 100);
        set_skill("bibo-shengong", 100);
        set_skill("bahuang-gong", 100);
        set_skill("beiming-shengong", 100);
        set_skill("buddhism", 100);
        set_skill("hanbing-mianzhang", 100);
        set_skill("taiji-shengong", 100);
        set_skill("dodge", 500);
        set_skill("lingboweibu", 500);
        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("sword", 100);
        set_skill("blade", 100);
        set_skill("anranxiaohun-zhang", 100);
        set_skill("taoism", 100);
        set_skill("literate", 100);
        set_skill("hubo", 100);

        map_skill("force", "jiuyang-shengong");
        map_skill("dodge", "lingboweibu");
        map_skill("unarmed", "anranxiaohun-zhang");
        map_skill("parry", "jiuyin-baiguzhao");
        map_skill("sword", "dugu-jiujian");
        map_skill("blade", "ruyi-dao");
        map_skill("hand", "zhemei-shou");
        map_skill("strike", "liuyang-zhang");
        map_skill("finger", "liumai-shenjian");
        map_skill("cuff", "qishang-quan");

        prepare_skill("hand","zhemei-shou");
        prepare_skill("strike","liuyang-zhang");
                
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: command("wield blade") :),
                (: perform_action, "blade.ru1" :),
                (: perform_action, "blade.ru2" :),
                (: perform_action, "blade.ru1" :),
                (: perform_action, "blade.ru2" :),
                (: perform_action, "cuff.qi1" :),
                (: command("unwield blade") :),
                (: command("wield jian") :),
                (: perform_action, "sword.po2" :),
                (: perform_action, "sword.po3" :),
                (: perform_action, "sword.po4" :),
                (: perform_action, "sword.po5" :),
                (: perform_action, "sword.po6" :),
                (: perform_action, "sword.po7" :),
                (: perform_action, "sword.po8" :),
                (: perform_action, "sword.po9" :),
                (: perform_action, "cuff.qi2" :),
                (: command("unwield jian") :),
                (: perform_action, "unarmed.an1" :),
                (: perform_action, "parry.ji1" :),
                (: perform_action, "hand.zh1" :),
                (: perform_action, "strike.li2" :),
                (: perform_action, "finger.li1" :),
                (: perform_action, "finger.li2" :),
                (: perform_action, "finger.li3" :),
                (: perform_action, "cuff.qi3" :),
                (: command("hubo") :),
                (: perform_action, "unarmed.an1" :),
                (: perform_action, "cuff.qi5" :),
                (: perform_action, "finger.li2" :),
                (: perform_action, "cuff.qi8" :),
                (: perform_action, "finger.li1" :),
                (: command("enable strike hanbing-mianzhang") :),
                (: perform_action, "unarmed.an1" :),
                (: command("enable strike liuyang-zhang") :),
                (: perform_action, "unarmed.an1" :),
                (: perform_action, "finger.li3" :),
                (: exert_function, "re1" :),
                (: perform_action, "cuff.qi7" :),
                (: exert_function, "p" :),
                (: perform_action, "cuff.qi4" :),
                (: exert_function, "r" :),
                (: perform_action, "cuff.qi6" :),
        }) );

        setup();
        carry_object("/clone/cloth/male5-cloth")->wear();
        carry_object("/clone/weapon/changjian");
        carry_object("/clone/weapon/blade");
        carry_object("/clone/food/jiudai");
}
