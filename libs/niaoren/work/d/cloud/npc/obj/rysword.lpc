// rysword.c 亂世寒兵
// 2000.8 by andy
#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
        set_name(HIY "亂世"HIW"寒"HIY"兵" NOR,({"roye_s","sword1","jian1"}));
        set_weight(1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIY "此劍是邪神曠世為亂世間打造的隨身配劍，也是邪界一級神兵之一。\n" NOR);
                set("value", 15000);
                set("material", "iron");
                set("wield_msg", HIY "亂世寒兵似有邪性地躍出劍鞘，落在$N手中，一股邪惡之氣凝聚在你的手中，此時的你充滿殺氣，
你附近的牲畜頓時四散奔逃。\n" NOR);
                set("unwield_msg", HIY "亂世寒兵感應到四周已無正義之氣，自動脫離$N手上，回到劍鞘裡。\n" NOR);
        }
        init_sword(75);
        setup();
}
