// bosa.c 薄紗
// 2000.8 by andy

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIW "薄紗" NOR, ({"bosa", "bo"}) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "這是件輕紗制成的白色薄紗。\n");
                set("material", "silk");
                set("armor_prop/armor", 8);
                set("value",10000);
        }
        setup();
}