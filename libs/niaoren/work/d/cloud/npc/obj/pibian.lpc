// pibian.c 曠世虐神鞭
// 2000.8 by andy

#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
        set_name(HIR"菜菜"HIG"虐神"NOR"鞭", ({ "nanakobian" }));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄邪神曠世打造的"HIR"菜菜"HIG"虐神"NOR"鞭，由"BLINK"一千個男人的包皮"NOR"精工編織而成。\n");
                set("value", 100);
                set("material", "leather");
                set("wield_msg", "$N「唰」的一聲抖出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n卷回腰間。\n");
        }
        init_whip(25);
        setup();
}