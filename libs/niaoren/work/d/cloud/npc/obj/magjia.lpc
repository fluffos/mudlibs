//baipao.c
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(CYN "紫" HIY "金" NOR "戰甲", ({"mag jia", "mag"}) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "這是件用海底金母製成的金屬戰甲。\n");
                set("material", "cloth");
                set("armor_prop/armor", 200);
                set("value",100);
        }
}