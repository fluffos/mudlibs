// kidsword.c 信天邪劍
// 2000.8 by andy
#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
        set_name(HIR "信"HIG"天"HIG"邪"HIW"劍" NOR,({"kid_s","sword2","jian2"}));
        set_weight(1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIY "此劍是邪神曠世為阿信打造的隨身配劍，為邪界一級神兵之一。\n" NOR);
                set("value", 15000);
                set("material", "iron");
                set("wield_msg", HIY "信天邪劍似有邪性地躍出劍鞘，落在$N手中，一股暴唳之氣凝聚在你的手中，此時的你充滿殺氣，
你附近的牲畜頓時四散奔逃。\n" NOR);
                set("unwield_msg", HIY "信天邪劍感應到四周已無正義之氣，自動脫離$N手上，回到劍鞘裡。\n" NOR);
        }
        init_sword(75);
        setup();
}
