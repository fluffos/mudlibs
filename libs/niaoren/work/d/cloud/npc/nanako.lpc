#include <ansi.h>

inherit NPC;

int hs_me();

void create()
{
        set_name(HIG"松島菜菜子"NOR, ({ "nanako" }) );
        set("gender", "女性");
        set("age", 20);
        set("title", HIW"莊主"HIR"專用情婦");
//      set("title", "二莊主");
        set("per", 45);
        set("long","他看來淫蕩無比，似乎這世上沒有另一個人能比他更淫蕩。\n"
        );

        // 膂力
        set("str", 35);
        // 根骨
        set("con", 35);
        // 身法
        set("dex", 35);
        // 悟性
        set("int", 35);

        // 氣
        set("qi",600);
        // 最大氣
        set("max_qi", 600);
        // 精
        set("jing",60);
        // 最大精
        set("max_jing", 60);
        // 內力
        set("neili", 800);
        // 最大內力
        set("max_neili", 800);
        // 精力
        set("jiali", 30);
        set("shen_type", 0);

        set_temp("apply/attack",  20);
        set_temp("apply/defense", 20);
        set_temp("apply/damage",  20);

        set("combat_exp", 20000);
        set("str", 27);
        set("kar", 100);
        set("thief", 0);

        // 最大內力
        set("max_force", 200);
        set("force_factor", 2);
        
        set_skill("force", 10);
        set_skill("yunv-xinfa", 10);    //玉女心法
        set_skill("sword", 10);
        set_skill("yunv-jian", 10);     //玉女劍
        set_skill("quanzhen-jian",10);  //全真劍
        set_skill("dodge", 10);
        set_skill("yunv-shenfa", 10);   //玉女身法
        set_skill("parry", 10);
        set_skill("hubo", 10);          //雙手互搏
        set_skill("unarmed", 10);
        set_skill("meinv-quan", 10);    //美女拳法
        set_skill("literate", 10);
        set_skill("qufeng", 10);        //驅蜂之朮
        set_skill("anranxiaohun-zhang", 10);  // 黯然消魂掌

        map_skill("force", "yunv-xinfa");
        map_skill("sword", "yunv-jian");
        map_skill("dodge", "yunv-shenfa");
        map_skill("parry", "meinv-quan");
        map_skill("unarmed", "anranxiaohun-zhang");

        setup();

        set("chat_chance", 3);
        set("chat_msg", ({
                "菜菜子懶洋洋地打了個哈欠。\n",
                "菜菜子軟綿綿的說著：來吧！我快受不了了！我需要你............\n",
                "松島菜菜子(nanako)說道：我的心肝小曠世，你怎麼不快來找我..................\n",
        }) );

        set("inquiry", ([
                "hs" : (: hs_me :),
                "曠世" :  "他是我的好情夫，你永遠比不上他的！\n",
        ]) );

        carry_object(__DIR__"obj/pibian")->wield();
        carry_object(__DIR__"obj/bosa")->wear();
        add_money("coin", 10);
}

int hs_me()
{
    command("say 嘿咻嘿咻！快來！");
    command("say 啊∼∼嗚∼∼嗯∼∼∼∼∼∼∼∼∼");
    command("say 喔∼∼∼∼∼耶∼∼∼∼∼∼繼續∼∼用力∼∼∼∼∼∼∼");
    command("say 啊∼∼∼∼∼∼∼∼啊∼∼∼∼∼∼∼∼∼∼深一點∼∼∼∼∼∼∼∼");
    command("say │     ○          │         ○     │    ○○     │");
    command("say │     ├┐        │         ├┐   │    ├┤     │");
    command("say │     ├┬─┬○  │     ┌┌┤     │    └┼┐   │");
    command("say │   ─┘┘  └    │   ○┴┼┴─   │      │     │");
    command("say 啊∼∼∼∼∼用力∼∼∼∼∼∼∼");
    command("say 啊∼∼∼∼∼∼∼口阿∼∼∼∼∼∼∼∼∼");
    command("say 我∼∼∼快∼∼∼出∼∼∼來∼∼∼了∼∼∼");
    command("say 喔！∼∼ ｙｅｓ ∼∼ ｃｏｍｅ ｏｎ ∼∼不行了∼∼∼∼∼∼∼∼");
    command("say 喔！∼∼丟了丟了∼∼∼∼∼∼∼∼啊∼∼∼∼∼∼");
    return 1;
}