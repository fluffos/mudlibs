#include <ansi.h>

inherit ROOM;

void create()
{
       set("short",HIW "邪神道"NOR);
        set("long", @LONG
　　這裡就是邪神道了，你莫名的感到一陣寒冷，似乎有一些邪靈逐漸向你身邊
靠近，往北是石階，往南是邪雲廣場，向東則是土匪錢莊。
LONG
        );
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"stonelat",
                "south" : __DIR__"cloud_c",
                "east" : __DIR__"chanjung",
        ]));

        setup();
        replace_program(ROOM);
}
