#include <ansi.h>
inherit ROOM;

void create()
{
          set("short",HIR "曠世邪神殿"NOR);
        set("long",
"這裡是曠世邪神殿，四周一片誨黯之氣，有時二莊主亂世間會在這裡坐鎮\n"
"。在這裡你可以看到一尊神像，但那似乎不是正義之神，反而帶著邪氣，令人\n"
"感到不寒而慄。\n"
"由此往北是"HIG"邪雲廣場"NOR"，往南則是正廳。\n"
"                                \n"
);
//      set("no_fight", 1);
        set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"cloud_c",
                "south" : __DIR__"c_tin",
        ]));

// 一個亂世間(roye.c) + 五個 NPC 土匪嘍囉(tufay.c)
        set("objects", ([
                __DIR__"npc/roye" : 1,
                __DIR__"npc/tufay" : 5,
        ]));

//        set("no_clean_up", 0);
        setup();
}
