inherit ROOM;

void create()
{
        set("short", "武器房");
        set("long", @LONG
這是一間存放武器的房間。刀、槍、劍、戟等各種武器都按類放在
各自的武器架上。整個屋子乾乾淨淨，顯然時常有人整理。往北是右邪二進。
LONG );
        set("exits", ([
                "north" : __DIR__"rs_2",
        ]));

        set("objects", ([
                __DIR__"obj/changjian": 2,
                __DIR__"obj/qimeigun": 2,
                __DIR__"obj/gun": 2,
        ]) );

//      set("no_clean_up", 0);
        setup();
}
