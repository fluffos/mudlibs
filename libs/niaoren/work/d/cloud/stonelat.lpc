#include <ansi.h>

inherit ROOM;

void create()
{
       set("short",HIW "石階"NOR);
        set("long", @LONG
　　這裡是一段用石頭打造的石階，往南走就是邪神道，向北走就是邪神
關了。
LONG
        );
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"shanku",
                "south" : __DIR__"sgodrold",
        ]));

        setup();
        replace_program(ROOM);
}
