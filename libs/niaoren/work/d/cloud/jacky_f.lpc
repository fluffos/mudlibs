#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "無悔園");
        set("long",
"這裡是無悔園，四周種滿了各式各樣的奇花異草，香味撲鼻而來，\n"
"令你感到一陣清爽，沒想到此山莊內還有如此清新脫俗的地方，\n"
"令人無法想像。\n"
"                                                              \n"
"由此往北是無悔居前聽，往南則是無悔門。\n"
"                                                              \n"
);
        set("outdoors", "cloud");
        set("exits", ([
                "north" : __DIR__"jacky_rm",
                "south" : __DIR__"jacky_r",
        ]));

// 兩個 NO AUTO K NPC 土匪(tufay_na.c)
//      set("objects", ([
//              __DIR__"npc/tufay_na" : 2,
//      ]));

        setup();
        //replace_program(ROOM);
}
