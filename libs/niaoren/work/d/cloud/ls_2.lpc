//      set("no_clean_up", 0);
        set("outdoors", "cloud");
        set("exits", ([
//              "north": __DIR__"",
                "south": __DIR__"yaopu",
                "west" : __DIR__"ls_3",
                "east" : __DIR__"ls_1",
        ]));

//      set("objects", ([
//              __DIR__"" : 1,
//      ]));

        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
