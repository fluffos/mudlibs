#include <ansi.h>
inherit ROOM;

void create()
{
       set("short",HIW "弒佛居前廳"NOR);
        set("long",
"這裡是弒佛居，平時阿信坐鎮於此；此地亦是他用心佈置，牆上掛著一幅\n"
"一幅的"HIG"Ｈ圖"NOR"，有"HIB"富士三號等等名家的真跡和簽名"NOR"，一般人一進到這，都會受不\n"
"了而噴出鼻血，以致地上全是"HIR"腥紅一片"NOR"；向南是四莊主阿信的起居室，沒有足\n"
"夠的功力的人請勿隨意進入，以免造成內傷。\n"
"                                      \n"
"由此往北是弒佛園，往南則是"HIG"阿信起居室"NOR"。\n"
"                                      \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"kid_f",
                "south" : __DIR__"kid_rm1",
        ]));

//        set("objects", ([
//                __DIR__"npc/nanako" : 1,
//        ]));

//        set("no_clean_up", 0);
        setup();
}
