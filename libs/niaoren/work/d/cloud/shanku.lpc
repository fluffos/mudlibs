#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIW "邪神關"NOR);
        set("long",
"這裡是邪神山莊邪神關，也是本莊的玄關，據說這裡暗藏著一個玄機，\n"
"但是至今無人能說出那到底是什麼！向北走是山莊大門，往南就是石階了\n"
"。\n"
"                                \n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"ganman",
                "south" : __DIR__"stonelat",
        ]));

//        set("objects", ([
//                __DIR__"npc/roye": 1,
//        ]));

        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
