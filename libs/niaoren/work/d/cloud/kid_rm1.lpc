#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIG "阿信起居室"NOR);
        set("long",
"這裡是阿信的起居室，平時阿信都在這休息；此地亦是他用心佈置，牆上\n"
"佈滿著一沱沱的"HIW"白色粘稠液體"NOR"，讓人覺得非常噁心，只想儘快把阿信殺掉，離\n"
"開這個可怕的地方。\n\n"
"由此往北是弒佛居前廳。NOR\n\n"
);
//      set("no_fight", 1);
//      set("valid_startroom", 1);
//      set("no_clean_up", 0);
        set("exits", ([
                "north" : __DIR__"kid_rm",
//              "south" : __DIR__"",
        ]));
        set("objects", ([
                __DIR__"npc/kid" : 1,
        ]));

//      set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
