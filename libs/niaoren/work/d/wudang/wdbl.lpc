inherit ROOM;

void create()
{
      set("short","武當柏林");
      set("long",@LONG
你穿行在一片茂密的柏林中，陰森郁翠，怪石嶙峋，草深沒人。不時地
有兔子從你的身邊飛跑而過。
LONG);
      set("objects", ([
          __DIR__"npc/yetu" : 2,
      ]));
      set("outdoors", "wudang");
      set("exits",([ /* sizeof() == 1 */
          "northdown": __DIR__"yuzhengong",
          "southup"  : __DIR__"haohanpo",
      ]));
//      set("no_clean_up", 0);
      setup();
}
