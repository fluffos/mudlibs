#include <room.h>
inherit ROOM;

void create()
{
        set("short", "后山小院");
        set("long", @LONG
這是后山的一座小院，布置簡簡單單，除了一床、一桌、一椅、一蒲團，
再也沒有別的什物。比較引人注目的是牆上挂著一把劍。這里就是武當開山
祖師張三丰的練功所在。
LONG );
        set("exits", ([
                "north" : __DIR__"xiaolu2",
        ]));
        set("objects", ([
                CLASS_D("wudang") + "/zhang" : 1 
        ]));
        create_door("north", "竹門", "south", DOOR_CLOSED);
//        set("no_clean_up", 0);
        setup();
}
