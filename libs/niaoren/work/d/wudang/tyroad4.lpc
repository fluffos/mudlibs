// tyroad4.c 崎嶇山路
// by Marz 

inherit ROOM;


string* npcs = ({
        "guest",
        "tufei2",
        "guest",
        "xiao_tufei",
        "guest",
        "xiao_louluo",
});

void create()
{
        int i = random(sizeof(npcs));

        set("short", "崎嶇山路");
        set("long", @LONG
你走在一條崎嶇狹隘的山路上，一邊是峭壁，一邊是懸崖。高高的天柱峰
籠罩在云霧中，隱約可見。可是身旁的進香客和游人都仔細地町著自己的腳下，不敢
抬頭望一眼，惟恐一不小心摔下去。更有強人趁機打劫，行人無不噤聲閉氣，只求快
點趕路。
LONG );
        set("outdoors", "wudang");
        set("exits", ([
                "westup" : __DIR__"tyroad3",
                "southdown" : __DIR__"tyroad8",
        ]));
        set("item_desc", ([
        ]));
        set("objects", ([
                __DIR__"npc/"+npcs[i] : 1
        ]));
      set("no_clean_up", 0);
        setup();
}
