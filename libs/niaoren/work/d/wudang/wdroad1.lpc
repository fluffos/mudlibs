inherit ROOM;

void create()
{
	set("short", "青石大道");
	set("long", @LONG
你走在一條青石大道上，人來人往非常繁忙，不時地有人騎著馬匆匆
而過。大道兩旁有一些小貨攤，似乎是一處集市。北邊通向揚州城。東南
是一大片樹林。
LONG );
        set("outdoors", "wudang");
	set("exits", ([
		"south"     : __DIR__"wdroad2",
		"north"     : "/d/city/nanmen",
	]));
        set("no_clean_up", 0);
	setup();
}

