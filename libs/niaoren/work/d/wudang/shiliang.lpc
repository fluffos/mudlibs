inherit ROOM;

void create()
{
      set("short","石梁");
      set("long",@LONG
你走入山塢中，有一道石梁跨溪而建，這里是九渡澗的下流，各嶺之水均
在此交匯，景色極佳。附近設有許多小吃店，游人至此，大多小住歇歇腳力。
再往上就是陡峭的十八盤了。
LONG);
      set("exits",([ /* sizeof() == 1 */
          "northup"    : __DIR__"taizipo",
          "southup"    : __DIR__"shibapan",
          "east"       : __DIR__"shop",
      ]));
      set("outdoors", "wudang");
      set("no_clean_up", 0);
      setup();
      replace_program(ROOM);
}
