inherit ROOM;

void create()
{
      set("short","武當廣場");
      set("long",@LONG
這是一個由大石板鋪成的廣場，是武當弟子學習武功\和互相切磋的地點。
周圍種滿了梧桐樹，一到秋天就是滿地的落葉。一個年紀輕輕的道童正在打掃。
南邊是靈霄宮三清殿。
LONG);
      set("objects", ([
           CLASS_D("wudang") +"/daotong": 2,
      ]));
      set("exits",([ /* sizeof() == 1 */
          "northdown"  : __DIR__"zixiaogate",
          "south"      : __DIR__"sanqingdian",
          "east"       : __DIR__"shanlu2",
      ]));
      set("outdoors", "wudang");
      setup();
      replace_program(ROOM);
}
