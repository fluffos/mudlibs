//Room: nanyanfeng.c 南岩峰
//Date: Sep 22 1997

inherit ROOM;

void create()
{
      set("short","南岩峰");
      set("long",@LONG
這里是武當三十六岩之最，松樹翳天，木石爭奇，峭壁萬仞。在懸崖
之半筑有一宮宇，下臨深淵，工程浩大。宮前有一石柱，自峭壁上橫出。
LONG);
      set("objects", ([
           CLASS_D("wudang") +"/mo": 1,
      ]));

      set("exits",([ /* sizeof() == 1 */
          "eastdown" : __DIR__"langmeiyuan",
          "southdown": __DIR__"shizhu",
          "west"     : __DIR__"sheshenya",
      ]));
      set("outdoors", "wudang");
//      set("no_clean_up", 0);
      setup();
}

int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ((!myfam || myfam["family_name"] != "武當派") && dir == "southdown" &&
                objectp(present("mo shenggu", environment(me))))
           return notify_fail("莫聲谷攔住你說：此處乃本派禁地，請止步。\n");

        return ::valid_leave(me, dir);
}
