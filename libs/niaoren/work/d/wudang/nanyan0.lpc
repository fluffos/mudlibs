// Room: nanyan0.c 南岩宮地下室
// Date: Oct.5 1997
#include <login.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "南岩宮地下室");
        set("long", @LONG
這是一個干燥潔淨的地下室，四壁用光滑的大理石砌就，十數支松明
照得這里通明透亮。
LONG );
        set("objects", ([
           CLASS_D("wudang") +"/xiaosong": 1,
        ]));

        set("exits", ([
                "up"     : __DIR__"nanyangong",
                "east"   : __DIR__"nanyan1",
                "west"   : __DIR__"nanyan2",
                "south"  : __DIR__"nanyan3",
                "nortn"  : __DIR__"nanyan4",
        ]));
//        set("no_clean_up", 0);
        setup();
}

int valid_leave(object me, string dir)
{
    if ( dir == "up" )
    {
       if ( me->query_skill("taiji-shengong", 1) < 80 )
          {
              return notify_fail("你試著推了推頂上的磚蓋，觸手冰涼，紋絲不動。\n"
              + "哈哈，你完蛋了。\n");
          }
          message_vision( HIY
            "$N全身運足太極神功，拔身錯步，嘿地一聲，舉起雙掌向上猛擊。只見\n"
            "一股白氣自$N掌心而出，迅猛無比地擊中頂上的磚蓋。克剌剌一聲\n"
            "巨響，磚蓋被震成無數小碎片四散飄飛。露出一個向上的洞口來。\n" NOR, me );
     }
     return ::valid_leave(me, dir);
}
