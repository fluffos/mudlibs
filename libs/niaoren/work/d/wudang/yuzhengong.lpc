inherit ROOM;

void create()
{
      set("short","遇真宮");
      set("long",@LONG
這里是進入武當山的第一道宮宇遇真宮，寬敞無比，可容千人食宿，
是進香客的一大歇腳處。三丰真人曾在此結庵修煉，因此宮中供著張三
丰真人像。由于張真人閉關已久，外人不知其是否仍在人間，民間傳說
他已得道仙逝，立像膜拜。
LONG);
      set("objects", ([
