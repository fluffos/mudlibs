// tyroad8.c 桃園小路
// by Marz 

inherit ROOM;

void create()
{
        set("short", "桃園小路");
        set("long", @LONG
眼前豁然開朗，你輕松地走在桃園邊的小路上。兩邊是桃樹林，樹上盛開
著粉紅的桃花，紅云一片，望不到邊。不時有蜜蜂「嗡嗡」地飛過，消失在在
花叢中﹔几只猴子在樹上互相追逐著，嘰嘰喳喳地爭搶桃子。這是武當山腳，
西邊有條陡峭的山路，通向山頂。
LONG );
        set("outdoors", "wudang");
        set("exits", ([
                "westup" : __DIR__"tyroad4",
                "east" : __DIR__"tyroad9",
                "north" : __DIR__"tynroad",
                "south" : __DIR__"tysroad",
        ]));
        set("no_clean_up", 0);
        setup();
}
