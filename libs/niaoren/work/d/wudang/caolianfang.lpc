// caolianfang.c 操練房
// Modified by Marz 03/27/96

#include <room.h>
inherit ROOM;

void create()
{
        set("short", "操練房");
        set("long", @LONG
這是二樓操練房上，四面八方都是打斗聲，武當弟子來去匆匆。
LONG );
        set("exits", ([
                "south"     : __DIR__"caolian1",
                "north"     : __DIR__"caolian2",
                "east"     : __DIR__"caolian4",
                "west"     : __DIR__"caolian3",
                "eastdown"  : __DIR__"xilang"
        ]));
//	set("no_clean_up", 0);
        set("objects", ([
                CLASS_D("wudang") + "/yin" : 1
        ]));
        setup();
}
