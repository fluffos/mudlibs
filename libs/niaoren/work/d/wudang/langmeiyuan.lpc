inherit ROOM;

void create()
{
      set("short","榔梅園");
      set("long",@LONG
這里種滿了榔梅樹，花色深淺一如桃花，蒂垂絲作海棠狀。榔和梅本是山
中的兩種樹，相傳有一天玄武帝把梅枝插在榔干上，久而復合，成此異種。據
說榔梅果核不可以帶出武當山，違者必遭不昌。
LONG);
// 應可采摘榔梅，守圓道長可適當阻止。
      set("objects", ([
            CLASS_D("wudang") +"/shouyuan": 1,

      ]));
      set("exits",([ /* sizeof() == 1 */
          "northup"  : __DIR__"taiziyan",
          "southup"  : __DIR__"wuyaling",
          "westup"   : __DIR__"nanyanfeng",
      ]));
//      set("no_clean_up", 0);
      set("outdoors", "wudang");
      setup();
      replace_program(ROOM);
}
