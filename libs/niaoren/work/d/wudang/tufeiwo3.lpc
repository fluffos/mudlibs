inherit ROOM;

void create()
{
	set("short", "林中小路");
	set("long", @LONG
你走在一條僻靜的林中小路上，兩旁是陰森森的樹林。只見左右前后，到處
都是鋪天蓋地的松樹林。几十丈高的大松樹簇在一塊，密實的枝葉象一蓬蓬巨傘
般伸向天空，把陽光遮得絲毫也無。據說這里經常有土匪出沒，不可久留。
LONG );
        set("outdoors", "wudang");
	set("no_sleep_room",1);
	set("exits", ([
		"west" : __DIR__"tufeiwo2",
	]));
        set("objects", ([
                __DIR__"npc/tufei1" : 2 ,
                __DIR__"npc/tufeitou" : 1, 
        ]));
//        set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

