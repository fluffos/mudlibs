//Room: jinding.c 金頂
//Date: Sep 22 1997

inherit ROOM;

void create()
{
      set("short","金頂");
      set("long",@LONG
你感到寒意陣陣襲來，原來你已到了武當山的主峰天柱峰的絕頂。前面
的金殿由銅鑄成，鍍以黃金，每當旭日臨空，整個殿宇金光閃閃，故名金頂。
天柱峰高高獨立于群峰之上，東西壁立二山，名叫蠟燭峰，中壁立一山似香
爐，名香爐峰，萬山千壑，隱隱下伏。
LONG);
      set("exits",([ /* sizeof() == 1 */
          "northdown": __DIR__"santiangate",
          "south"    : __DIR__"zijincheng",
          "west"     : __DIR__"shierliantai",
      ]));
      set("outdoors", "wudang");
      set("no_clean_up", 0);
      setup();
}
