// gytoad2.c 果園小路
// by Java

inherit ROOM;
#include <ansi.h>
int do_zhai(string arg);
void create()
{
        set("short", "果園");
        set("long", @LONG
你輕松地走進果園。園中落英繽紛，兩邊是桃樹林，盛開著粉紅的桃花，
紅云一片，望不到邊。中間卻是一株冠蓋數畝的大樹(tree)，遮住地面好大一
片綠蔭。
LONG );
        set("outdoors", "wudang");
        set("item_desc", ([
                "tree" : 
"這是一株人參果樹，上面結著人參果(renshen guo)，據說摘下吃了對武功進益很有好處。\n"
        ]));
        set("exits", ([
                "west" : __DIR__"gyroad1",
        ]));
        set("no_clean_up", 0);
        set("guocount",1);
        setup();
}

void init()
{
        add_action("do_zhai","zhai");
}

int do_zhai(string arg)
{
        object guo;
        if( !arg || arg=="" )
        {
                message_vision("你想摘什么？\n", this_player());
                return 1;
        }
        if( arg=="guo"||arg=="renshen guo" )
        {
                if(uptime() < 1800)
                {
        message_vision("人參果未熟呢，$N等一會再來吧。\n",this_player());
                        return 1;
                }
                if(query("guocount") > 0 && random(2)==1)
                {
//message("channel:rumor", MAG"【謠言】某人："+this_player()->query("name")+"得到一個人參果了。\n"NOR, users());
        message_vision("$N人參果樹上摘下一個熟透的"HIR"人參果。\n"NOR,
                        this_player());
                        guo = new(__DIR__"obj/renshenguo");
                        guo->move(this_player());
                        add("guocount",-1);
                        return 1;
                }
                else
                {
                        set("guocount",0);
                        message_vision("$N真是好可憐啊？人參果剛被摘走。\n",this_player());
                        return 1;            
                }
        }
        return 0;
}
