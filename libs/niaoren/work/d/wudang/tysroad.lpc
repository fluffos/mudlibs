// tysroad.c 桃園小路
// by Marz 

inherit ROOM;

string* npcs = ({
	"little_monkey",
	"monkey",
	"little_monkey",
	"little_bee",
	"bee",
	"little_bee",
});
                                
void create()
{
	int i = random(sizeof(npcs));
	    
	set("short", "桃園小路");
	set("long", @LONG
眼前豁然開朗，你輕松地走在桃園邊的小路上。路上落英繽紛，一邊是桃樹林，
盛開著粉紅的桃花，紅云一片，望不到邊。還可以看見蜜蜂「嗡嗡」地在花間飛上
飛下忙個不停，間或傳來猿猴的嘰咋聲。這兒是武當山腳，南邊是條環山的黃土路。
LONG );
	set("outdoors", "wudang");
	set("exits", ([
		"north" : __DIR__"tyroad8",
	]));
	set("objects", ([
		__DIR__"npc/"+npcs[i] : 1
	]));
//	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}
