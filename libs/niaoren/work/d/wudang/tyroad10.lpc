// tyroad10.c 桃園小路
// by Marz 

inherit ROOM;

void create()
{
	set("short", "桃園小路");
	set("long", @LONG
眼前豁然開朗，你輕松地走在桃園邊的小路上。兩邊是桃樹林，樹上盛開
著粉紅的桃花，紅云一片，望不到邊。不時有蜜蜂「嗡嗡」地飛過，消失在在
花叢中﹔几只猴子在樹上互相追逐著，嘰嘰喳喳地爭搶桃子。南北方向是通向
兩個桃園的入口。
LONG );
	set("outdoors", "wudang");
	set("exits", ([
		"east" : __DIR__"tyroad11",
		"west" : __DIR__"tyroad9",
		"north" : __DIR__"tygate1",
		"south" : __DIR__"tygate2",
	]));
	set("no_clean_up", 0);
	setup();
}
