inherit ROOM;

void create()
{
      set("short","復真觀五層樓");
      set("long",@LONG
復真觀五層樓構造奇特，其間有十二根梁枋交叉重疊，下面僅用
一柱支撐，即有名的“一柱十二梁”。在這里俯瞰群山，煙云迷離，
遠望金頂，一柱擎天，為觀景勝地。
LONG);
      set("exits",([ /* sizeof() == 1 */
          "west"     : __DIR__"taizipo",
      ]));
      set("outdoors", "wudang");
      set("no_clean_up", 0);
      setup();
}
