// paper.c
#include <ansi.h>;
inherit ITEM;
void create()
{
        set_name(HIR"賀卡"NOR, ({"card"}));
        set("unit", "張");
        set("long",HIR" 

                     新婚志喜                     
    ┌───────────────────┐    
    │                                      │    
    │                                      │    
    │  homename: 設定房間名稱。            │    
    │  homedesc: 設定房間描述。            │    
    │  bedname : 設定床鋪名稱。            │    
    │  beddesc : 設定床鋪描述。            │    
    │  findbaby: 找你們的小孩。            │    
    │  gosleep : 上床睡覺。這樣才會有baby。│    
    │  sleep <sb>: 創造愛的結晶。          │    
    │                                      │    
    │                    俠客行一百恭賀    │    
    │                                      │    
    └───────────────────┘    
                                                  

");
        set("value", 0);
        set_weight(10);
        setup();
}


