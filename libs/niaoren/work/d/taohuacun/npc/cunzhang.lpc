// cunzhang.c

inherit NPC;

int zao(string msg);
int xiu(string msg);
int chai();

void create()
{
	set_name("桃花村長", ({ "cun zhang", "zhang" }));
	set("gender", "男性");
	set("age", random(10) + 40);
	set("str", 25);
	set("dex", 16);
	set("per", 20);
	set("long", "他是桃花村長，誰想在桃花村造屋安家，都要經過他老人家的
同意。他是個面目慈善的老漢。很得全村人的尊重。\n");
	set("combat_exp", 75000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 60);
	set_skill("force", 60);
	set_skill("sword", 60);
	set_skill("dodge", 60);
	set_skill("parry", 60);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/armor", 50);
	set_temp("apply/damage", 30);

	set("neili", 400); 
	set("max_neili", 400);
	set("jiali", 10);
	set("inquiry", ([
		"造屋" : "造屋就是 (zao 屋名 屋子說明) 就可以了。\n",
		"修屋" : "如果對屋子陳設不滿意了，(xiu 新屋名 屋子新描述) 就會重新裝修了。\n",
		"拆屋" : "不想要房子了或鑰匙丟了就(chai)吧。\n",
	]));

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
	object ob;

	::init();
	if( interactive(ob=this_player()) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("zao","zao");
	add_action("xiu","xiu");
	add_action("chai","chai");
}

void greeting(object ob)
{
	if (ob->query("age")>17)
say ("村長笑咪咪地說：這位"+RANK_D->query_respect(ob) + "，歡迎到桃花村來。
你可以造屋(zao)，也可以修改屋里的裝修(xiu)，如果丟了鑰匙
就得拆除房屋(chai)了。屋內裝修該換行的地方請用 $ 代替。\n");
        else
say ("村長笑咪咪地說：這位"+RANK_D->query_respect(ob) + "，還不夠年齡修造自己的房子呢。\n");
        return;
}

int zao(string msg)
{
	object obj, ob = this_player();
	string homename, homedesc, tmpdesc;

	if (ob->query("age")<17)
	{
		write("\n村長說道：你還沒成人呢，不能造私宅的。\n");
		return 1;
	}
	if (ob->query("home") )
	{
		write("\n村長說道：你在已經本村有房屋了，不能再造了。\n");
		return 1;
	}
	if( !msg ) return notify_fail("你要造什么東西？\n");
	if( sscanf(msg ,"%s %s" ,homename, tmpdesc) != 2)
		 return notify_fail("zao 屋名 屋中陳設說明\n");
	homedesc = replace_string(tmpdesc, "$", "\n");
	ob -> set("home/home_name", homename);
	ob -> set("home/home_desc", homedesc);
	ob -> save();
	obj = new("/clone/misc/key");
	obj -> move(ob);
	write("\n村長說道：我馬上派人去桃花坪幫你造屋，這是鑰匙，你
退出游戲后再連進來就可以去看看了。\n");
	return 1;
}

int xiu(string msg)
{
	object obj, ob = this_player();
	string homename, homedesc, tmpdesc;

	if (!ob->query("home") )
	{
		write("\n村長說道：你在本村根本沒有房屋了，修什么修？\n");
		return 1;
	}
	if( !msg ) return notify_fail("你要修什么東西？\n");
	if( sscanf(msg ,"%s %s" ,homename, tmpdesc) != 2)
		 return notify_fail("xiu 新屋名 屋中陳設的新說明\n");
	homedesc = replace_string(tmpdesc, "$", "\n");
	ob -> set("home/home_name", homename);
	ob -> set("home/home_desc", homedesc);
	ob -> save();
	write("\n村長說道：我馬上派人去桃花坪幫你改裝房屋，你馬上就可以去看看了。\n");
	return 1;
}

int chai()
{
	object ob = this_player();
	ob->delete("home");
	write("\n村長說道：好吧，你這里的房屋我已經派人去拆了。\n");
	return 1;
}
