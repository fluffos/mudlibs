// Room: /lingzhou/chema.c
// Java Sep. 23 1998

inherit ROOM;

void create()
{
	set("short", "車馬店");
	set("long", @LONG
一家低檔的車馬客棧，建筑相當陳舊，很不起眼，不過由于價錢低
廉，又是在北門的交通要道上，三教九流多選擇這里落腳，生意也相當
不錯，你也可以在這里打聽到當地的風土人情。
    牆上挂著一個牌子(paizi)。
LONG );
	set("no_fight", 1);
        set("no_sleep_room",1);
//	set("no_clean_up", 0);
	set("item_desc", ([
		"paizi" : "樓上雅房，每夜十兩白銀。\n",
	]));
	set("objects", ([
		__DIR__"npc/xiaoer" : 1,
	]));
	set("exits", ([
		"east" : __DIR__"majiu",
		"west" : __DIR__"nandajie",
		"up"   : __DIR__"chema2",
	]));
	setup();
}

int valid_leave(object me, string dir)
{

	if ( !me->query_temp("rent_paid") && dir == "up" )
	return notify_fail("店小二一下擋在樓梯前，白眼一翻：怎麼著，想白住啊！\n");

	if ( me->query_temp("rent_paid") && dir == "west" )
	return notify_fail("店小二跑到門邊攔住：客官已經付了銀子，怎麼不住店就走了呢！
旁人還以為小店伺候不周呢！\n");

	return ::valid_leave(me, dir);
}
