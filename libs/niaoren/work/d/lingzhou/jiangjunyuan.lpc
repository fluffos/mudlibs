#include <room.h>

inherit ROOM;
void create()
{
	set("short", "將軍府大院");
	set("long", @LONG
這里是將軍府的大院，當面一堵寬闊的白玉照壁，上書“忠心報國”
四個大字，落款是當今西夏皇帝李元昊。一色的青磚鋪地，有几個仆役
正在院中洒掃，南面是內宅，西面是帳房，東面是個小院。
LONG );
	set("exits", ([
		"east"  : __DIR__"xiaoyuan",
		"west"  : __DIR__"zhangfang",
		"enter" : __DIR__"neizai",
		"north" : __DIR__"jiangjungate",
	]));
	set("no_fight",1);
	set("objects", ([
		"/d/city/npc/jiading" : 2,
	]));
	setup();
	create_door("north" , "油木大門", "south" , DOOR_CLOSED);
//	create_door("south" , "卷帘門", "north" , DOOR_CLOSED);
}

int valid_leave(object me, string dir)
{
        if (dir == "south" && 
            objectp(present("xiao wei", environment(me))))
           return notify_fail("校尉擋住了你的去路：大將軍不在府上！\n");

        return ::valid_leave(me, dir);
}

