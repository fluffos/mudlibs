// /guanwai/milin1.c

inherit ROOM;

void create()
{
	set("short", "密林");
	set("long", @LONG
這是一片茂密的松林，雜亂的生長在傾斜的山坡上。每棵松樹都有三四
抱粗細，高達十几丈。樹冠枝多葉密，將天空完全遮住，因此林內顯得有些
昏暗。樹木之間長著很多灌木雜草，使行走很艱難，據說人參就生長在這些
雜草之中。
LONG );
	set("exits", ([
		"west"    : __DIR__"baihe",
		"eastup"  : __DIR__"milin2",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
	replace_program(ROOM);
}
