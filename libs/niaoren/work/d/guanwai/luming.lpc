// /guanwai/luming.c

inherit ROOM;

void create()
{
	set("short", "鹿鳴峰");
	set("long", @LONG
龍門峰西側就是鹿鳴峰。鹿鳴峰又稱芝盤峰，因峰上有一草甸子，形圓
如蓋，有熱氣從地下冒出，每到嚴冬，其它峰均積雪甚厚，唯鹿鳴峰依然植
物茂盛，且盛產芝草，鹿多居之。常有鶴、雀、雕、燕飛落其上，有“鹿鳴
翠谷，雕飛芝蓋”之稱。
LONG );
	set("exits", ([
		"south"   : __DIR__"baiyun",
		"east"    : __DIR__"longmen",
	]));
	set("objects", ([
		__DIR__"npc/buck" : 1,
		__DIR__"npc/doe" : 1,
		__DIR__"npc/diao" : 1,
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
}
