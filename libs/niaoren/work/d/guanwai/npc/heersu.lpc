// heersu.c
#include <ansi.h>;
inherit NPC;
string ask_me();
string ask_he();

void create()
{
	set_name("赫爾蘇", ({"heersu"}));
	set("gender", "男性");
	set("age", 65);
	set("long", 
		"他是一個老參客，可是一貧如洗。\n");
	set("attitude", "peaceful");
	set("str", 25);
	set("int", 20);
	set("con", 20);
	set("dex", 20);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);
	set_temp("apply/armor", 10);
	set_temp("apply/damage", 10);

	set("inquiry",([
		"人參"    :     (: ask_me :),
		"山參"    :     (: ask_me :),
		"參"      :     (: ask_me :),
		"何首烏"  :     (: ask_he :),
		"首烏"    :     (: ask_he :)
	]));
	set("item_count",1);
	setup();
	carry_object("/d/city/obj/cloth")->wear();
}

string ask_me()
{
	object ob, me;
	
	me = this_player();
	if((int)(me->query("shen")<0)) return "你又來搶參啦，早被搶光了，沒有了。\n";
	me -> set_temp("人參",1);
	return "那你就拿出錢來吧。\n";
}
string ask_he()
{
	object ob, me;
	
	me = this_player();
	if((int)(me->query("shen")<0)) return "你又來搶首烏啦，早被搶光了，沒有了。\n";
	me -> set_temp("首烏",1);
	return "那你就拿出錢來吧。\n";
}

int accept_object(object me, object ob)
{
	object obj;
    if (!(int)me->query_temp("人參") && !(int)me->query_temp("首烏"))
    {
	message_vision("赫爾蘇惶恐地對$N說：我不敢要您老的錢。\n", me);
	return 0 ;
    }
    if (ob->query("money_id") && ob->value() >= 50000)
    {
       if ((int)me->query_temp("首烏"))
       {
           if (query("item_count")>0)
           {
message_vision("赫爾蘇對$N說：好！既然這位" + RANK_D->query_respect(me) +
     "如此看得起我老頭子，\n這棵首烏我留了很久了，就送給你吧！\n" , me);
               me->delete_temp("首烏");
               obj = new("/d/city/obj/shouwu");
               obj -> move(me);
               add("item_count", -1);
           }
           else
message_vision("赫爾蘇對$N說：錢我先收著，有首烏時再說吧！\n", me);
       } else
       {
           if (query("item_count")>0)
           {
message_vision("赫爾蘇對$N說：好！既然這位" + RANK_D->query_respect(me) +
     "如此看得起我老頭子，\n這棵參我留了很久了，就送給你吧！\n" , me);
               me->delete_temp("人參");
               obj = new("/d/city/obj/shanshen");
               obj -> move(me);
               add("item_count", -1);
           }
           else
message_vision("赫爾蘇對$N說：錢我先收著，我一定找個最大的老山參給您！\n", me);
       }
    }
    else  
	message_vision("赫爾蘇皺眉對$N說：您給的也太少了吧？\n", me);
    return 1;
}

