inherit ROOM;

void create()
{
	set("short", "南城");
	set("long", @LONG
這里是用黃土鋪就的街道，街上的行人不多，看起來很冷清。偶爾有几
個身著異域服飾的行人走過，看起來是滿族，鮮祖的居民。西面有一座低埃
的土房，門口挂著一個寫滿鮮文的幌子，還傳來陣陣的肉香，看起來象一個
小飯館。
LONG );
	set("exits", ([
		"north" : __DIR__"jishi",
		"south" : __DIR__"muqiao",
		"west"  : __DIR__"rouguan",
	]));
	set("objects", ([
		__DIR__"npc/tengyilei" : 1,
	]));
//	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
	replace_program(ROOM);
}

