// /guanwai/huandi1.c

inherit ROOM;

void create()
{
	set("short", "荒路");
	set("long", @LONG
這是城東的一條荒路，路旁雜亂的長著齊膝的荒草，遠近荒無一人。兩
旁干枯的老樹上落滿了成群的烏鴉，淒涼的鳴叫聲在荒野上遠遠傳去，一派
淒涼的景象。
LONG );
	set("exits", ([
		"southwest" : __DIR__"dongcheng",
		"northeast" : __DIR__"huandi2",
	]));
	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
}

