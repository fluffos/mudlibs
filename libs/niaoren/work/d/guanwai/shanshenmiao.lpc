// /guanwai/shanshenmiao.c

inherit ROOM;

void create()
{
	set("short", "山神廟");
	set("long", @LONG
這是一個用木板和石頭壘成的小廟，廟前地上散落著一些然過的灰燼。
廟里供奉著山神爺老把頭的靈位(lingwei)。傳說他是所有采參人的祖師爺，
所以每個進山挖參的參客都要來這里祭拜，希望能得到他老人家的保佑。
LONG );
	set("item_desc", ([
		"lingwei"  : 
"
**************
*            *
*     山     *
*     神     *
*     爺     *
*     老     *
*     把     *
*     頭     *
*            *
*     孫     *
*     良     *
*            *
*     之     *
*     位     *
*            *
**************
"
	]));
	set("exits", ([
		"out"  : __DIR__"huandi2",
	]));
	set("objects", ([
		__DIR__"npc/yanji" : 1,
	]));
//	set("no_clean_up", 0);
	set("outdoors", "guanwai");
	setup();
}

