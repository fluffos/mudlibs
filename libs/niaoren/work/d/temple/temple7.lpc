#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "蛇神殿");
        set("long","這裡是神殿的最頂層。你可以明顯的看到一扇用紙糊成的窗戶"HIC"(window)"NOR"，\n"
                   "另外窗戶的左側有個桿子"HIC"(lever)"NOR"，看起來有點詭異，殿裡淡淡的燈光，磁磚\n"
                   "砌地，每根柱子週圍還纏了些許蜘蛛網。\n"
           );

//      set("exits", ([
//          "west": __DIR__"stoneroad",
//                     ]));

        set("item_desc", ([
            "lever": "一隻製作精細的桿子，似乎可以往下拉"HIC"(pull)"NOR"的樣子。\n",
            "window": "從窗口望將出去，景色如常。附近仍是一片綠油油的草地。\n",
        ]));

        set("objects", ([
              __DIR__"npc/snakegod" : 1,
                       ]));

        set("no_clean_up", 1);
        set("no_steal", 1);
        setup();
}

void init()
{
        add_action("do_pull", "pull");
}

int do_pull(string arg)
{
        object me = this_player();
        if( !arg || arg != "lever" )
        {
        return notify_fail("你想要拉什麼？\n");
        }
        if( arg == "lever" )
        {
          if (objectp(present("snake god", environment(me))))
            {
          message_vision(HIC"蛇神喝道：$N想要幹什麼？\n", me);
          return 1;
            }
          if (!me->query_temp("pull_lever"))
            {
          message_vision(HIC"$N拉了一下牆上的拉桿，你聽到遠處傳來轟隆轟隆的聲音。\n"NOR, me);
          message_vision(HIC"碰∼∼的一聲，一道"BLINK""HIW"強光"NOR""HIC"射入你的眼睛，原來是看到出口了！\n"NOR, me);
          me->set_temp("pull_lever", 1);
          this_object()->set("exits/northeast", __DIR__"temple6-3");
          remove_call_out("close");
          call_out("close", 5, this_object());
          return 1;
            }
          message_vision(HIR"突然聽到『咻』的一聲，$N被機關裡的暗器射中。\n"NOR, me);
          me->receive_damage("qi",50);
          return 1;
              }
      return 0;
}

void close(object room)
{
        message("vision",HIC"只見出口又慢慢的消失了。\n"NOR, room);
        this_object()->delete("exits/northeast");
        return;
}

