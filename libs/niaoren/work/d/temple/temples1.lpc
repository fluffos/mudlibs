// 神殿二殿  /u/roye/temples1.c
// temples1 2000/11/04
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "神殿二殿");
        set("long","這裡是神殿二殿的大門口。你可以明顯的看到一扇用紙糊成的窗戶"HIC"(window)"NOR"，\n"
                   "還有一扇大鐵門"HIC"(gate)"NOR"，鐵門的上方還掛著一個匾"HIC"(bian)"NOR"。\n"
           );
        set("exits", ([
//          "up"   : "/u/roye/temple/temples2",
            "northwest" : __DIR__"temples-3",
                     ]));

        set("item_desc", ([
            "window": "從窗口望將出去，景色如常。附近仍是一片綠油油的草地。\n",
            "gate": "這是一扇厚重的大鐵門，不妨推推"HIC"(push)"HIW"看。\n",
            "bian": HIG"                                                    \n"
                       "   ◤◢◤◢◤◢◤◢◤◢◤◢ \n"
                       "   §"BLINK""HIC"神    殿    二    殿 "NOR""HIG"§\n"
                       "   ◣◥◣◥◣◥◣◥◣◥◣◥ \n"
                       "                                               "NOR"\n"
        ]));

        setup();
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        object me = this_player();

        if( !arg || arg != "gate" )
        {
        return notify_fail("你想要推什麼？\n");
        }

        if( arg == "gate" )
        {

          if (me->query_temp("pull_lever") == 1)
            {
          message_vision(HIC"$N死命地推著厚重的大門，只見大門緩緩地被打開了。\n"NOR, me);
          this_object()->set("exits/up", __DIR__"temples1-1");
          me->delete_temp("pull_lever");
          remove_call_out("close");
          call_out("close", 5, this_object());
          return 1;
            }

          message_vision(HIR"$N誤觸動門上的機關！！結果被機關射中。\n"NOR, me);
          me->receive_damage("qi",50);
//不想讓玩家受傷可以把上面一行註解掉！
          return 1;
              }
      return 0;
}

void close(object room)
{
        message("vision",HIC"只見鐵門又自動地關上了。\n"NOR, room);
        this_object()->delete("exits/up");
        return;
}
