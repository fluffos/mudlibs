#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石山道");
        set("long",@long
陡峭石砌大道一直延伸到這裡為止，四週盡是白雲繚繞，宛如仙境
，雄偉的神殿已矗立在眼前不遠處。
long);
        set("exits", ([
            "east": __DIR__"temple",
            "westdown": __DIR__"stoneroad6",
                       ]));

        set("objects", ([
               "/d/baituo/npc/woman" : 1,
               "/d/baituo/npc/kid" : 1,
                         ]));

        set("outdoors", "temple");
        setup();
        replace_program(ROOM);
}
