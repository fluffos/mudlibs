// 雞神  /u/belldandy/12god/chickengod.c
// 改自天地會陳進南

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(GRN"雞"HIW"神"NOR, ({"chicken god", "chicken", "god"}));
        set("nickname", "十二生肖之十" );
        set("gender", "男性");
        set("age", 261);
        set("long", "他就是雞神，全身長滿炫麗的雞毛。\n");
        set("attitude", "peaceful");
        
        set("str", 35);
        set("int", 35);
        set("con", 35);
        set("dex", 35);
        set("food", 999999);
        set("water", 999999);

        set("qi", 55000);
        set("max_qi", 55000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 280);
        set("shen_type", 1);
        set("combat_exp", 5500000);
         
        set_skill("force", 290);
        set_skill("hubo", 290);
        set_skill("yunlong-shengong", 290);
        set_skill("unarmed", 290);
        set_skill("yunlong-shou", 290);
        set_skill("dodge", 290);
        set_skill("yunlong-shenfa", 290);
        set_skill("parry", 290);
        set_skill("whip", 290);
        set_skill("literate",290);
        set_skill("yunlong-bian",290);
        
        map_skill("force"  , "yunlong-shengong");
        map_skill("unarmed"  , "yunlong-shou");
        map_skill("dodge"  , "yunlong-shenfa");
        map_skill("parry"  , "yunlong-bian");
        map_skill("whip"  , "yunlong-bian");
        
        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("sigh") :),
                (: command("say 二百多年前那一場「老鷹抓小雞」害我家破人亡。") :),
                (: command("say 一想到狗神，就讓我感到「雞犬不寧」。") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun p") :),
                (: command("yun re1"):),
                (: command("perform whip.yu1") :),
                (: command("yun re1") :),
                (: command("perform whip.yu1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun re1") :),
                   }) );

        setup();
        
        carry_object("/d/temple/obj/chickenbian")->wield();
        carry_object("/d/temple/obj/greenarmor")->wear();
}

void die()
{
        object ob, me = this_player();
          if(random(10) == 3)
          {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/handseq");
        ob->move(environment(this_object()));
        destruct(this_object());
          }
      else
          {
        ::die();
          }
}
