#include <ansi.h>

inherit NPC;

void create()
{
        set_name(WHT"狗"HIW"神"NOR, ({ "dog god", "dog", "god", }));
        set("long", "他是一位白須白眉的老狗，身穿一襲灰色鎧甲。\n" );
        set("nickname", "十二生肖之十一");
        set("gender", "男性");
        set("attitude", "friendly");

        set("age", 309);
        set("str", 40);
        set("int", 40);
        set("con", 40);
        set("dex", 40);
        set("food", 999999);
        set("water", 999999);

        set("shen_type", 1);
        set("max_qi", 60000);
        set("max_qi", 60000);
        set("max_jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 300);
        set("combat_exp", 6000000);

        set_skill("force", 300);
        set_skill("hubo", 300);
        set_skill("hunyuan-yiqi", 300);
        set_skill("dodge", 300);
        set_skill("shaolin-shenfa", 300);
        set_skill("parry", 300);
        set_skill("hand", 300);
        set_skill("claw", 300);
        set_skill("club", 300);
        set_skill("staff", 300);
        set_skill("zui-gun", 300);
        set_skill("pudu-zhang", 300);
        set_skill("qianye-shou", 300);
        set_skill("yingzhua-gong", 300);
        set_skill("buddhism", 300);
        set_skill("literate", 300);

        map_skill("force", "hunyuan-yiqi");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "nianhua-zhi");
        map_skill("hand", "qianye-shou");
        map_skill("claw", "yingzhua-gong");
        map_skill("staff", "pudu-zhang");
        map_skill("club", "zui-gun");
        map_skill("parry", "yingzhua-gong");

        prepare_skill("finger", "nianhua-zhi");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("la") :),
                (: command("say 想到那隻虎神被我欺負的好慘，真是笑死我了！") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform finger.ni1") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("perform staff.zu1") :),
                (: command("yun re1") :),
                (: command("yun re1") :),
        }) );

        setup();

        carry_object("/d/temple/obj/dogclub")->wield();
        carry_object("/d/temple/obj/brownarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 2)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/bootseq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
