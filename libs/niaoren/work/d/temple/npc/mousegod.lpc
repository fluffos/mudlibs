// 鼠神 /u/belldandy/npc/mousegod.c
// 改自段延慶 2000/11/10

#include <ansi.h>

inherit NPC;

void create()
{
        set_name( WHT"鼠"HIW"神"NOR, ({"mouse god", "mouse", "god"}));
        set("gender", "男性");
        set("nickname", "十二生肖之首");
        set("age", 111);
        set("long", "他長的獐頭鼠目，嘴巴前面還露出兩顆大鼠牙。\n");
        set("attitude", "peaceful");
        
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        set("food", 999999);
        set("water", 999999);

        set("qi", 10000);
        set("max_qi", 10000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 100);
        set("shen_type", 1);
        set("combat_exp", 1000000);
         
        set_skill("force", 200);
        set_skill("hand", 200);              // 基本手法
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("staff", 200);
        set_skill("hubo", 200);
        set_skill("xiaoyaoyou", 200);        // 逍遙游
        set_skill("shexing-diaoshou", 200);
        set_skill("tianshan-zhang", 200);
        set_skill("hunyuan-yiqi", 200);
        
        map_skill("force", "hunyuan-yiqi");
        map_skill("hand", "shexing-diaoshou");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "tianshan-zhang");
        map_skill("staff", "tianshan-zhang");
        
        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("sob") :),
                (: command("say 我好可憐，每個玩家都要砍我，難道「人人喊打」是冥冥中就注定的？") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                        }) );

        setup();
        
        carry_object("/d/temple/obj/mousestaff")->wield();
        carry_object("/d/temple/obj/blackarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 3)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/headeq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
