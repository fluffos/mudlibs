// 虎神  /u/belldandy/12god/tigergod.c
// 改自 王重陽  2000/11/11

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(RED"虎"HIW"神"NOR, ({"tiger god", "god", "tiger"}));
        set("gender", "男性");
        set("age", 146);
        set("nickname", "十二生肖之三");
        set("long", "他天生一副虎背雄腰的身材，手上拿著闊劍，威風凜凜。\n");
        set("attitude", "peaceful");

        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        set("food", 999999);
        set("water", 999999);

        set("qi", 20000);
        set("max_qi", 20000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali",  140);
        set("shen_type", 1);
        set("combat_exp", 2000000);

        set_skill("force", 220);
        set_skill("hubo", 220);
        set_skill("xiantian-qigong", 220);    //先天氣功
        set_skill("sword", 220);
        set_skill("quanzhen-jian", 220);  //全真劍
        set_skill("dodge", 220);
        set_skill("jinyan-gong", 220);   //金雁功
        set_skill("parry", 220);
        set_skill("unarmed", 220);
        set_skill("haotian-zhang", 220);    //昊天掌
        set_skill("literate",220);
        set_skill("strike",220);
        set_skill("taoism",220);
        set_skill("finger",220);
        set_skill("sun-finger",220);  //一陽指

        map_skill("force", "xiantian-qigong");
        map_skill("sword", "quanzhen-jian");
        map_skill("dodge", "jinyan-gong");
        map_skill("parry", "quanzhen-jian");
        map_skill("strike", "haotian-zhang");
        map_skill("finger","sun-finger");

        prepare_skill("finger","sun-finger");
        prepare_skill("strike","haotian-zhang");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("angry") :),
                (: command("say 我恨死狗神了，說什麼要招待我，明明就是要給我難看！") :),
                (: command("say 不曉得「獅子他媽媽好不好」？") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform sword.qu1") :),
                (: command("yun p") :),
                (: command("perform finger.su1") :),
                (: command("yun re1") :),
                (: command("perform sword.qu2") :),
                (: command("yun re1") :),
                (: command("perform finger.su1") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                   }));

        setup();

        carry_object("/d/temple/obj/tigersword")->wield();
        carry_object("/d/temple/obj/redarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 7)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/clotheq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
