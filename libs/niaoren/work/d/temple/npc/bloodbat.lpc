// 吸血蝙蝠  /u/belldandy/npc/bloodbat.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR"吸血"WHT"蝙蝠"NOR, ({ "blood bat", "bat" }) );
        set("gender", "怪獸" );
        set("age", 10);
        set("long", "晝伏夜出的動物，演進成專吸人血的怪物。\n");
//      set("attitude", "aggressive");
        set("attitude", "friendly");

        set("str", 25);
        set("con", 25);
        set("int", 25);
        set("dex", 25);

        set("max_qi", 400);
        set("eff_qi", 400);
        set("qi", 400);
        set("max_jing", 200);
        set("jing", 200);
        set("neili", 300);
        set("max_neili", 300);
//      set("jiali", 30);
        set("shen_type", 0);
        set("combat_exp", 50000);
        set("chat_chance", 10);
        set("chat_msg", ({
             HIR"吸血"WHT"蝙蝠"NOR"趴咑趴咑地在空中飛舞著。\n",
             HIR"吸血"WHT"蝙蝠"NOR"說道：我最愛吸玩家的血，因為我是吸血蝙蝠。\n",
//              (: random_move :),
                      }) );

        set_skill("force", 80); 
        set_skill("unarmed", 100);
        set_skill("dodge", 80);
        set_skill("parry", 80);

        set("fight_times", 3);
        set("suck_times", 5);
        setup();
}

void init()
{    
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() )
        {
          remove_call_out("greeting");
          call_out("greeting", 0, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
     command("hehe " + ob->query("id"));
     message_vision(HIR"\n吸血"WHT"蝙蝠"NOR"往$N的手臂一口咬下去，開始吸起"BLINK""HIR"血"NOR"來！\n", ob);
     set_leader(this_player());
     add("suck_times", -1);
     if(query("suck_times") == 0)
     {
     message_vision(HIR"\n吸血"WHT"蝙蝠"NOR"吸完最後一口，因為身體承受不了而脹破了！\n", ob);
     destruct(this_object());
//   return 1;
     }
     ob->receive_damage("qi", 10);
     if(ob->query("qi") <= 0)
     ob->unconcious();
}

int accept_fight(object ob)
{
        object me  = this_object();
                
        me->set("eff_qi", me->query("max_qi"));
        me->set("qi",     me->query("max_qi"));
        me->set("jing",   me->query("max_jing"));
        me->set("neili",  me->query("max_neili"));

        if ( me->is_fighting()) return 0;
        if ( !present(ob, environment()) ) return 0;
        if ( me->query("fight_times") == 0 )
          return notify_fail(HIR"\n吸血"WHT"蝙蝠"NOR"已經全身脫力，趴在地上大口地喘著粗氣！\n");
        me->add("fight_times", -1);
        remove_call_out("checking");
        call_out("checking", 0, me, ob);
        return 1;
}

int checking(object me, object ob)
{
        object obj, man;
        int my_max_qi, his_max_qi;

        if ( !present(ob, environment()) ) return 1; 

        my_max_qi  = me->query("max_qi");
        his_max_qi = ob->query("max_qi");

        if( me->is_fighting() && (int)me->query("fight_times") > 0 )
        {
          if (( (int)me->query("qi") < 300 ))
           {
            say(HIC"\n吸血蝙蝠喊道：我快招架不住了，兄弟們快點來幫我吧！！\n" NOR);
            message_vision(HIY"\n吸血蝙蝠大喊一聲：萬能的天神，請賜與我神奇的力量！！\n" NOR, ob);
            me->set("eff_qi", me->query("max_qi"));
            me->set("qi",     me->query("max_qi"));
            me->set("jing",   me->query("max_jing"));
            me->set("neili",  me->query("max_neili"));
            man=new("/u/belldandy/npc/bloodbat");
            man->move(environment(this_object()));
            man->fight_ob(this_player());
            this_player()->fight_ob(man);
            me->add("fight_times", -1);
           }
          else if (( (int)ob->query("qi")*100 / his_max_qi) < 50 )
           {
            say(HIC"\n吸血蝙蝠笑道：你這小子跟我還差著一大截呢，回去練上十年再來吧！\n"NOR);
            return 1;
           }

         if ( present(ob, environment()) ) call_out("checking", 0, me, ob);
        }
       return 1;
}
