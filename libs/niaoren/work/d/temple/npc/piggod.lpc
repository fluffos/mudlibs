// 豬神  /u/belldandy/12god/piggod.c
// 改自血刀門老祖

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(MAG"豬"HIW"神"NOR, ({ "pig god", "pig", "god" }));
        set("long", "正如你所見的，滿身的肥油和一張醜惡的臉，鼻子和耳朵就是牠的象徵。\n");
        set("nickname", "十二生肖之末");
        set("gender", "男性");
        set("age", 325);
        set("attitude", "peaceful");
        set("shen_type", 1);

        set("str", 45);
        set("int", 45);
        set("con", 45);
        set("dex", 45);
        set("food", 999999);
        set("water", 999999);

        set("qi", 65000);
        set("max_qi", 65000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 320);
        set("combat_exp", 6500000);

        set_skill("mizong-xinfa", 310);
        set_skill("literate", 310);
        set_skill("force", 310);
        set_skill("hubo", 310);
        set_skill("parry", 310);
        set_skill("blade", 310);
        set_skill("hammer", 310);
        set_skill("sword", 310);
        set_skill("dodge", 310);
        set_skill("longxiang", 310);
        set_skill("shenkong-xing", 310);
        set_skill("hand", 310);
        set_skill("dashou-yin", 310);
        set_skill("mingwang-jian", 310);
        set_skill("xue-dao", 310);
        set_skill("riyue-lun", 310);

        map_skill("force", "longxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("hand", "dashou-yin");
        map_skill("parry", "xue-dao");
        map_skill("blade", "xue-dao");
        map_skill("sword", "mingwang-jian");
        map_skill("hammer", "riyue-lun");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("pig god") :),
                (: command("say 我一直想不起來，豬到底是怎麼死的啊？") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                 }) );

        setup();

        carry_object("/d/temple/obj/purplearmor")->wear();
        carry_object("/d/temple/obj/pighammer")->wield();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 4)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/redgem");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
