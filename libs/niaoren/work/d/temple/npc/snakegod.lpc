// 蛇神  /u/belldandy/12god/snakegod.c
// 改自武當張三豐

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(CYN"蛇"HIW"神"NOR, ({ "snake god", "snake", "god" }));
        set("nickname", "十二生肖之六");
        set("long", "他身材高大，全身覆滿蛇鱗，散發出怪異的青光。\n");
        set("gender", "女性");
        set("age", 203);
        set("attitude", "friendly");

        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("food", 999999);
        set("water", 999999);

        set("qi", 35000);
        set("max_qi", 35000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 200);
        set("shen_type", -1);
        set("combat_exp", 3500000);

        set_skill("force", 250);
        set_skill("hubo", 250);
        set_skill("taiji-shengong", 250);
        set_skill("dodge", 250);
        set_skill("tiyunzong", 250);
        set_skill("unarmed", 250);
        set_skill("taiji-quan", 250);
        set_skill("parry", 250);
        set_skill("sword", 250);
        set_skill("taiji-jian", 250);
        set_skill("blade", 250);
        set_skill("taiji-dao", 250);
        set_skill("taoism", 250);
        set_skill("literate", 250);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "taiji-dao");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("yawn") :),
                (: command("say 等了好幾百年居然都沒人拜訪，唉！") :),
                      }) );

        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform unarmed.ta1") :),
                (: command("yun re1") :),
                (: command("perform unarmed.ta1") :),
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("perform unarmed.ta1") :),
                (: command("yun re1") :),
        }) );

        setup();

        carry_object("/d/temple/obj/snakeblade")->wield();
        carry_object("/d/temple/obj/cynarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 6)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/waisteq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
