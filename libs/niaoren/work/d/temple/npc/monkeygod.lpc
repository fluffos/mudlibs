// 改自峨眉滅絕師太

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(YEL"猴"HIW"神"NOR, ({ "monkey god", "monkey", "god"}));
        set("long", "牠就是猴神，曾經是齊天大聖。\n");
        set("nickname", "十二生肖之九");
        set("gender", "女性");
        set("age", 262);
        set("attitude", "peaceful");
        set("shen_type", 1);

        set("str", 35);
        set("int", 35);
        set("con", 35);
        set("dex", 35);
        set("food", 999999);
        set("water", 999999);

        set("qi", 50000);
        set("max_qi", 50000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("combat_exp", 5000000);
        set("jiali", 260);

        set_skill("force", 280);
        set_skill("dodge", 280);
        set_skill("finger", 280);
        set_skill("parry", 280);
        set_skill("strike", 280);
        set_skill("sword", 280);
        set_skill("blade", 280);
        set_skill("literate", 280);
        set_skill("mahayana", 280);
        set_skill("buddhism", 280);
        set_skill("jinding-zhang", 280);
        set_skill("tiangang-zhi", 280);
        set_skill("huifeng-jian", 280);
        set_skill("yanxing-dao", 280);
        set_skill("zhutian-bu", 280);
        set_skill("linji-zhuang", 280);

        map_skill("force","linji-zhuang");
        map_skill("finger","tiangang-zhi");
        map_skill("dodge","zhutian-bu");
        map_skill("strike","jinding-zhang");
        map_skill("sword","huifeng-jian");
        map_skill("blade","yanxing-dao");
        map_skill("parry","yanxing-dao");

        prepare_skill("finger","tiangang-zhi");
        prepare_skill("strike","jinding-zhang");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun li2") :),
                (: command("yun li3") :),
                (: command("yun li4") :),
                (: command("yun li5") :),
                (: command("pose") :),
                (: command("say 十二生肖裡面就屬我最聰明，我的祖先還是「齊天大聖」耶！") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform blade.ya1") :),
                (: command("yun re1") :),
                (: command("perform finger.ti1") :),
                (: command("yun re1") :),
                (: command("perform strike.ji1") :),
                (: command("yun re1") :),
                (: command("perform blade.ya1") :),
                (: command("yun re1") :),
                (: command("perform finger.ti1") :),
                (: command("yun p") :),
                (: command("hubo") :),
                    }) );

        setup();

        carry_object("/d/temple/obj/monkeyblade")->wield();
        carry_object("/d/temple/obj/orangearmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 2)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/fingereq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
