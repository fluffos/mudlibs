// 牛神 /u/belldandy/npc/cowgod.c
// 改自 丐幫 2000/11/11

#include <ansi.h>

inherit NPC;

void create()
{
        set_name( YEL"牛"HIW"神"NOR, ({"cow god", "cow", "god"}));
        set("gender", "男性");
        set("nickname", "十二生肖之二");
        set("age", 123);
        set("long", "他的體型非常碩大，有著大大的牛眼，鼻子上有個套環。\n");
        set("attitude", "peaceful");
        
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        set("food", 999999);
        set("water", 999999);

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("say 你沒有聽過「牛一下水就不叫啦」的謎語啊？") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform staff.da1") :),
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("perform staff.da1") :),
                (: command("yun re1") :),
                        }) );

        set("qi", 15000);
        set("max_qi", 15000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 120);
        set("shen_type", -1);
        set("combat_exp", 1500000);
         
        set_skill("force", 210);
        set_skill("hand", 210);              // 基本手法
        set_skill("dodge", 210);
        set_skill("parry", 210);
        set_skill("staff", 210);
        set_skill("hubo", 210);
        set_skill("hunyuan-yiqi", 210);
        set_skill("shexing-diaoshou", 210);
        set_skill("xiaoyaoyou", 210);        // 逍遙游
        set_skill("dagou-bang", 210);
        
        map_skill("force", "huntian-qigong");
        map_skill("hand", "shexing-diaoshou");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "dagou-bang");
        map_skill("staff", "dagou-bang");
        
        setup();
        
        carry_object("/d/temple/obj/cowclub")->wield();
        carry_object("/d/temple/obj/dirtarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 4)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/neckeq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
