#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIY"龍"HIW"神"NOR, ({ "dragon god", "dragon", "god" }));
        set("nickname", "十二生肖之五");
        set("long", "他就是龍神，有著長長的龍鬚和一張嚴肅威嚴的臉，令人望而生畏。\n");
        set("gender", "男性");
        set("age", 189);
        set("attitude", "peaceful");

        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("food", 999999);
        set("water", 999999);

        set("qi", 30000);
        set("max_qi", 30000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 180);
        set("shen_type", 1);
        set("combat_exp", 3000000);

        set_skill("cuff", 240);
        set_skill("hubo", 240);
        set_skill("force", 240);
        set_skill("blade", 240);
        set_skill("sword", 240);
        set_skill("dodge", 240);
        set_skill("parry", 240);
        set_skill("strike", 240);
        set_skill("zixia-shengong", 240);
        set_skill("poyu-quan", 240);
        set_skill("fanliangyi-dao", 240);
        set_skill("huashan-sword", 240);
        set_skill("hunyuan-zhang", 240);
        set_skill("feiyan-huixiang",240);
        set_skill("literate", 240);

        map_skill("cuff", "poyu-quan");
        map_skill("force", "zixia-shengong");
        map_skill("dodge", "feiyan-huixiang");
        map_skill("parry", "huashan-sword");
        map_skill("blade", "fanliangyi-dao");
        map_skill("sword", "huashan-sword");
        map_skill("strike", "hunyuan-zhang");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("hmm") :),
                (: command("say 眾神們只有和虎神不合，誰叫我們一定要「龍爭虎鬥」呢！") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("perform sword.hu1") :),
                (: command("yun re1") :),
                (: command("perform sword.hu2") :),
                (: command("yun re1") :),
                (: command("perform cuff.po1") :),
                (: command("yun re1") :),
                (: command("perform strike.hu1") :),
                (: command("yun p") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                                }) );

        setup();
        carry_object("/d/temple/obj/dragonsword")->wield();
        carry_object("/d/temple/obj/goldarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 5)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/surcoateq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
