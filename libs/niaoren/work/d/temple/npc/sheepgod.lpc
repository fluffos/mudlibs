// 羊神  /u/belldandy/12god/sheepgod.c
// 改自神龍教洪安通

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIC"羊"HIW"神"NOR, ({ "sheep god", "sheep", "god" }));
        set("nickname", "十二生肖之八" );
        set("long", "他就是羊神，全身長滿茂密捲曲的羊毛，頭上頂著兩隻尖羊角。\n");
        set("gender", "男性");
        set("age", 241);
        set("attitude", "friendly");
        set("shen_type", -1);

        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("food", 999999);
        set("water", 999999);
        
        set("qi", 45000);
        set("max_qi", 45000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 240);
        set("combat_exp", 4500000);

        set_skill("force", 270);
        set_skill("hubo", 270);
        set_skill("hunyuan-yiqi", 270);
        set_skill("shenlong-xinfa", 270);
        set_skill("dodge", 270);
        set_skill("yixingbu", 270);
        set_skill("unarmed", 270);
        set_skill("shenlong-bashi", 270);
        set_skill("parry", 270);
        set_skill("staff", 270);
        set_skill("shedao-qigong", 270);
        set_skill("literate", 270);

        map_skill("force", "hunyuan-yiqi");
        map_skill("dodge", "yixingbu");
        map_skill("unarmed", "shenlong-bashi");
        map_skill("parry", "shedao-qigong");
        map_skill("staff", "shedao-qigong");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("fear") :),
                (: command("say 所最怕虎神了，別人告訴我要小心「羊入虎口」啊！") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform staff.sh1") :),
                (: command("yun re1") :),
                (: command("perform staff.sh2") :),
                (: command("yun re1") :),
                (: command("perform staff.sh3") :),
                (: command("yun re1") :),
                (: command("yun r") :),
                (: command("yun re1") :),
                (: command("hubo") :),
                          }) );

        setup();

        carry_object("/d/temple/obj/sheepstaff")->wield();
        carry_object("/d/temple/obj/miarmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 5)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/shieldeq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
