// 新鳥人
#include <ansi.h>
inherit NPC;

void create()
{
        set_name(CYN"新鳥人"NOR, ({ "bird man", "bird", "man" }));
        set("long", 
"它就是傳說中的鳥人神教的第四代打手，手上拿的至寶->鳥爪正是它的身份象徵。\n");
        set("gender", "男性");
        set("age", 30);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 30);
        set("int", 40);
        set("con", 35);
        set("dex", 35);
        
        set("qi", 15000);
        set("max_qi", 15000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 15000);
        set("max_neili", 15000);
        set("jiali", 500);

        set("combat_exp", 5550000);
        set("score", 200000);

        set_skill("unarmed", 350);
        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("sword", 350);
        set_skill("xiantian-gong", 350);
        set_skill("anranxiaohun-zhang", 350);
        set_skill("dugu-jiujian", 350);
        set_skill("wizard-dodge",350);
        set_skill("literate", 200);

        map_skill("force", "xiantian-gong");
        map_skill("dodge", "wizard-dodge");
        map_skill("parry", "dugu-jiujian");
        map_skill("sword", "dugu-jiujian");
        map_skill("unarmed", "anranxiaohun-zhang");

        create_family("鳥人神教", 4, "打手");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "p" :),
                (: perform_action, "sword.po2" :),
                (: perform_action, "sword.po2" :),
                (: perform_action, "sword.po3" :),
                (: perform_action, "sword.po4" :),
                (: perform_action, "sword.po5" :),
                (: perform_action, "sword.po6" :),
                (: perform_action, "sword.po7" :),
                (: perform_action, "sword.po8" :),
                (: perform_action, "sword.po9" :),
                (: perform_action, "strike.hu1" :),
                (: perform_action, "unarmed.an1" :),
                (: exert_function, "re1" :),
        }) );

        setup();
        carry_object("/d/city/obj/cloth")->wear();
        carry_object("/d/temple/obj/claw")->wield();
}
int accept_fight(object ob)
{
        command("say "+ ob->query("name") +"居然敢向我挑戰，找死！！\n");
        command("kill "+ ob->query("id"));
}
