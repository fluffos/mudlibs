// 馬神  /u/belldandy/12god/horsegod.c
// 改自華山風清揚

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIY"馬"HIW"神"NOR, ({ "horse god", "horse", "god" }));
        set("long", "所謂馬不知臉長就是牠的特徵，除此之外與一般馬無異。\n");
        set("nickname", "十二生肖之七");
        set("gender", "男性");
        set("age", 225);
        set("attitude", "peaceful");
        set("shen_type", 1);

        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("food", 999999);
        set("water", 999999);

        set("qi", 40000);
        set("max_qi", 40000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 220);
        set("combat_exp", 4000000);

        set_skill("mizong-xinfa", 260);
        set_skill("literate", 260);
        set_skill("force", 260);
        set_skill("hubo", 260);
        set_skill("parry", 260);
        set_skill("blade", 260);
        set_skill("hammer", 260);
        set_skill("unarmed", 260);
        set_skill("sword", 260);
        set_skill("dodge", 260);
        set_skill("zixia-shengong", 260);
        set_skill("poyu-quan", 260);
        set_skill("fanliangyi-dao", 260);
        set_skill("huashan-sword", 260);
        set_skill("hunyuan-zhang", 260);
        set_skill("lonely-sword", 260);
        set_skill("feiyan-huixiang",260);

        map_skill("cuff", "poyu-quan");
        map_skill("force", "zixia-shengong");
        map_skill("dodge", "feiyan-huixiang");
        map_skill("parry", "lonely-sword");
        map_skill("sword", "lonely-sword");
        map_skill("blade", "fanliangyi-dao");
        map_skill("strike", "hunyuan-zhang");

        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun p") :),
                (: command("yun h1") :),
                (: command("pout") :),
                (: command("say 誰說屬馬的就「不知臉長」？我還嫌別人的比我短咧！") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("perform strike.hu1") :),
                (: command("yun p") :),
                (: command("perform cuff.po1") :),
                (: command("yun re1") :),
                (: command("perform sword.po4") :),
                (: command("yun re1") :),
                (: command("perform sword.po5") :),
                (: command("yun re1") :),
                (: command("perform sword.po6") :),
                (: command("yun re1") :),
                (: command("perform sword.po7") :),
                (: command("yun re1") :),
                (: command("perform sword.po8") :),
                (: command("hubo") :),
                (: command("perform sword.po9") :),
                                 }) );

        setup();

        carry_object("/d/temple/obj/yellowarmor")->wear();
        carry_object("/d/temple/obj/horsesword")->wield();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 4)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/wristseq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
