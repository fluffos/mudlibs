// 兔神  /u/belldandy/12god/rabbitgod.c
// 改自 大理段譽

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIW"兔神"NOR, ({"rabbit god", "rabbit", "god"}));
        set("nickname", "十二生肖之四");
        set("gender", "男性");
        set("age", 168);
        set("long", "他全身佈滿銀白色的短毛，紅紅的眼睛讓人覺得恐怖。\n");
        set("attitude", "peaceful");
        
        set("str", 30);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        set("food", 999999);
        set("water", 999999);

        set("qi", 25000);
        set("max_qi", 25000);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 9000);
        set("max_neili", 9000);
        set("jiali", 160);
        set("shen_type", -1);
        set("combat_exp", 2500000);
         
        set_skill("force", 230);                // 基本內功
        set_skill("hubo", 230);                // 雙手互博
        set_skill("unarmed", 230);
        set_skill("beiming-shengong", 230);     // 北冥神功
        set_skill("finger", 230);               // 基本指法
        set_skill("six-finger", 230);           // 六脈神劍
        set_skill("dodge", 230);                // 基本躲閃
        set_skill("lingboweibu", 230);          // 凌波微步
        set_skill("parry", 230);                 // 基本招架
        set_skill("whip", 230);                 // 基本鞭法
        set_skill("feifeng-whip", 230);          // 飛鳳鞭法
        
        map_skill("force", "beiming-shengong");
        map_skill("dodge", "lingboweibu");
        map_skill("parry", "feifeng-whip");
        map_skill("finger", "six-finger");
        map_skill("whip", "feifeng-whip");
        prepare_skill("finger","six-finger");
        
        set("chat_chance", 100);
        set("chat_msg", ({
                (: command("yun re1") :),
                (: command("yun h1") :),
                (: command("yun p") :),
                (: command("yun s") :),
                (: command("jump") :),
                (: command("say 所謂「狡兔死，走狗烹」，為了狗神好，我千萬不能死！") :),
                (: command("say 我一直伴隨嫦娥姊姊擣藥有\功，所以封神。") :),
                      }) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: command("yun re1") :),
                (: command("hubo") :),
                (: command("yun re1") :),
                (: command("perform dodge.li1") :),
                (: command("yun re1") :),
                (: command("perform finger.si1") :),
                (: command("yun p") :),
                (: command("perform finger.si2") :),
                (: command("yun re1") :),
                (: command("perform finger.si3") :),
                (: command("yun re1") :),
                (: command("perform finger.si4") :),
                (: command("yun re1") :),
                (: command("perform finger.si5") :),
                (: command("yun re1") :),
                (: command("perform finger.si6") :),
        }) );
        setup();
        
        carry_object("/d/temple/obj/rabbitbian")->wield();
        carry_object("/d/temple/obj/whitearmor")->wear();
}

void die()
{
        object ob, me = this_player();
        if(random(10) == 2)
        {
        message_vision("\n$N嘆氣說道：想不到經過百年之後，居然有人能夠勝過我！！\n", this_object());
        message_vision("\n你看見$N的身體漸漸化成雲霧般消失不見了，發覺腳邊卻多了一樣東西。\n", this_object());
        ob = new("/d/temple/obj/armoreq");
        ob->move(environment(this_object()));
        destruct(this_object());
        }
    else
        {
        ::die();
        }
}
