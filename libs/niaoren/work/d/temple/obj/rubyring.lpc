#include <ansi.h>
#include <armor.h>
inherit RING;
int cor;
object user, ob=this_object();
void create()
{
        set_name(HIR"紅"NOR"寶石"HIC"戒指"NOR, ({"ruby ring", "ring"}));
           if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long",
             "它是用"MAG"豬"HIW"神"NOR"的紅寶石鑲嵌其中，再加上太乙星君祝福的戒指。\n");
        set("value", 10000000);
        set("material", "ruby");
        set("wear_msg", "$N拿出一只$n帶在手指上，$n發出異樣的紅光！\n");
        set("unequip_msg", "$N脫下了$n，奇異的紅光也隨之消逝。\n");
        set("unit", "只");
        set("weight", 1000);
        set("armor_prop/armor", 10);
        set("armor_type", "ring");
        set("left_time", 3);
        set("raise_up", 0);
                  }
        setup();
}

void init()
{
     add_action("do_drop","drop"); 
     add_action("do_wear","wear");
     add_action("do_drop","give");
     add_action("do_drop","sell");
     add_action("do_drop","remove");
     add_action("do_heal","heal");
}

int do_wear(string str)
{ 
  if(str=="ring" || str=="all")
    if(!query("equipped") )
    {
     user = this_player();     // 取得使用者
     cor = user->query("con");
     cor = cor *2;
     set_heart_beat(1);
     if(user->query_temp("apply/12godeq") == 11 && query("raise_up") == 0)
       {
        user->add_temp("apply/armor", 500);
        tell_object(user, HIY"你感覺到十二生肖的裝備產生共鳴！\n"NOR);
        set("raise_up", 1);
       }
    }
}

int do_drop(string str)
{  
   if(str=="ring" || str=="all")
     if( query("equipped") )
     {
      set_heart_beat(0);
       if(query("raise_up") == 1)
        {
         user->add_temp("apply/armor", -500);
         tell_object(user, HIY"你感覺到十二生肖裝備附的神力消去了！\n"NOR);
         set("raise_up", 0);
        }
     }
}

int do_heal(string str)
{
  if(query("equipped"))
  if (query("left_time") > 0)
  {
    user->set("jing", user->query("max_jing"));
    user->set("eff_jing", user->query("max_jing"));
    user->set("qi", user->query("max_qi"));
    user->set("eff_qi", user->query("max_qi"));
    user->set("neili", user->query("max_neili"));
    user->clear_condition();
    tell_object(user, HIM"哇喔，太好了，你覺得全身精神百倍！\n"NOR);
    add("left_time", -1);
    return 1;
  }
    tell_object(user, HIR"紅寶石戒指的神力耗盡，化為粉末消失了！\n"NOR);
    destruct(this_object());
}

void heart_beat()
{
   if(user->query_temp("apply/12godeq") == 11 && query("raise_up") == 0)
    {
     set("raise_up", 1);
     user->add_temp("apply/armor", 500);
     tell_object(user, HIY"你感覺到十二生肖的裝備產生共鳴！\n"NOR);
    }

   if(user->query_temp("apply/12godeq") != 11 && query("raise_up") == 1)
    {
     set("raise_up", 0);
     user->add_temp("apply/armor", -500);
     tell_object(user, HIY"你感覺到十二生肖裝備附的神力消去了！\n"NOR);
    }

  if( user->is_fighting() && query("equipped"))
   {
    if( random(100) > 80)
     {
      user->receive_curing("qi", cor);
      user->receive_heal("qi", cor);
      message_vision(HIM"戒指發出一道紅光籠罩著$N,$N的傷口癒合了。\n"NOR, user);
     }
   }
  return;
}  

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
