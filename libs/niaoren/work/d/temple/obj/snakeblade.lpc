// 青蛇刀  /u/belldandy/12god/snakeblade.c
// 2000/11/10

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
        set_name(CYN"青蛇刀"NOR, ({ "snake blade", "blade" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 600000);
                set("material", "steel");
                set("no_get","這是神的專屬裝備！\n");
                set("long", "這是一把沈重且鋒利的寶刀，刀柄上用金絲銀絲鑲成一隻蛇形，是蛇神的武器。\n");
                set("wield_msg", CYN"只見冷森森的一道青光激射而出，$n已握入$N的手裡。\n"NOR);
                set("unwield_msg", CYN"「唰」的一聲，寒光已不見。$n已被$N收入刀鞘裡面。\n"NOR);
        }
        init_blade(200);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

