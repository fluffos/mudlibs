// 白兔鞭  /u/belldandy/12god/rabbitbian.c
// 2000/11/10

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name(HIW"白兔鞭"NOR, ({ "rabbit bian", "bian" }));
        set_weight(2500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄由兔神的鬍鬚所編織而成的長鞭，是兔神的武器。\n");
                set("value", 400000);
                set("material", "silk");
                set("weapon_prop/dodge", 2);
                set("no_get","這是神的專屬裝備！\n");
                set("wield_msg", "$N「咻」的一聲甩出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n卷回腰間。\n");
        }
        init_whip(160);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

