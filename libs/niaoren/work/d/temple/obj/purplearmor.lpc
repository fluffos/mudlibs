// 紫之鎧 /u/belldandy/12god/purplearmor.c

#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create()
{
        set_name( MAG"紫之鎧"NOR, ({ "purple armor", "armor" }) );
        set("long", "這是一件豬神專用鎧甲。\n");
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "leather");
                set("wear_msg", "$N從背包拿出一件$n穿在身上。\n");
//              set("value", 1200000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("no_get","這是神的專屬裝備！\n");
                set("armor_prop/armor", 320);
                set("armor_prop/dodge", 10);
                set("armor_prop/strength", 10);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

