// 紅寶石  /u/belldandy/12god/redgem.c
// 改自 dream 的赤龍珠

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIR"紅寶石"NOR, ({"red gem", "gem"}));
           if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long",
                "它是"MAG"豬"HIW"神"NOR"死後身上流的血乾涸而成的物品，不曉得有何作用。\n");
        set("value", 10000000);
        set("unit", "顆");
        set("weight", 100);
            }
}

void init()
{
     add_action( "do_heal", "eat" );
}

int do_heal(string arg)
{
  if( arg == "gem" )
   {
    object mme;
    mme=this_player();
    mme->set("jing",mme->query("max_jing")*2);
    mme->set("eff_jing",mme->query("max_jing")*2);
    mme->set("qi",mme->query("max_qi")*2);
    mme->set("eff_qi",mme->query("max_qi")*2);
    mme->set("neili",mme->query("max_neili"));
//  mme->set("con",mme->query("con") + 1);
    mme->clear_condition();
    tell_object(mme,HIM"哇喔，太好了，你覺得全身都是力量!\n"NOR);
    destruct(this_object());
    return 1;
   }
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
