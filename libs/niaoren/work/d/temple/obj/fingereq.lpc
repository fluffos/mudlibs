// /u/belldandy/12god/fingereq.c

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name( YEL"猴神指箍"NOR, ({ "monkey finger", "finger" }) );
        set("long", "這是一件神賜的裝備，是打敗猴神的證明。\n");
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "steel");
                set("wear_msg", "$N從背包拿出一件$n套在手指上。\n");
                set("value", 900000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 50);
                set("armor_prop/attack", 2);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
