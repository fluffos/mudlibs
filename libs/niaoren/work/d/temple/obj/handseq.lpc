// /u/belldandy/12god/handseq.c

#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create()
{
        set_name( GRN"雞神手套"NOR, ({ "chicken hands", "hands" }) );
        set("long", "這是一件神賜的裝備，是打敗雞神的證明。\n");
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "雙");
                set("material", "steel");
                set("wear_msg", "$N從背包拿出一雙$n套在手上。\n");
                set("value", 1000000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 100);
                set("armor_prop/attack", 3);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
