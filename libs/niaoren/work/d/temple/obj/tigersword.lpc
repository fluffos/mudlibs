#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(RED"紅虎劍"NOR, ({ "tiger sword", "sword" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄由朱紅神鐵煉製的精鋼劍，是虎神的武器。\n");
                set("value", 300000);
                set("material", "steel");
                set("no_get","這是神的專屬裝備！\n");
                set("weapon_prop/attack", 2);
                set("weapon_prop/strength", 2);
                set("wield_msg", RED"$N「唰」的一聲抽出一柄$n握在手中，四週散佈如同火一般的紅光。\n"NOR);
                set("unwield_msg", RED"$N將手中的$n插回劍鞘，四週的焰氣逐漸消散。\n"NOR);
        }
        init_sword(140);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

