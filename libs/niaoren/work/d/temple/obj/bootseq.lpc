// /u/belldandy/12god/bootseq.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create()
{
        set_name( WHT"狗神灰靴"NOR, ({ "dog boots", "boots" }) );
        set("long", "這是一件神賜的裝備，是打敗狗神的證明。\n");
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "雙");
                set("material", "steel");
                set("wear_msg", "$N從背包拿出一雙$n穿在雙腳上。\n");
                set("value", 1100000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 100);
                set("armor_prop/attack", 2);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 4);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
