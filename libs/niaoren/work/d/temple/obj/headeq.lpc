#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name( WHT"鼠神"BLINK""HIM"之"NOR""HIW"帽"NOR, ({ "mouse hat", "hat" }));
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "leather");
                set("unit", "頂");
                set("long", "這是一頂神賜的裝備，是打敗鼠神的證明。\n");
                set("value", 100000);
                set("wear_msg", "$N從背包拿出一頂$n戴在頭上。\n");
//              set("no_drop","好好珍惜它吧！\n");
                set("armor_prop/armor", 50);
                set("armor_prop/dodge", 3);
                set("armor_prop/attack", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/strength", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
