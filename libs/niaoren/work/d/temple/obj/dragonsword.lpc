#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIY"金龍劍"NOR, ({ "dragon sword", "sword" }));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄由精鋼所鍛造的闊劍，是龍神所使用的武器。\n");
                set("value", 500000);
                set("rigidity",100);
                set("material", "steel");
                set("no_get","這是神的專屬裝備！\n");
                set("wield_msg", "$N緩緩的從背後拿出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n掛回背後。\n");
        }
        init_sword(180);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

