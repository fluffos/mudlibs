#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIY"黃馬劍"NOR, ({ "horse sword", "sword" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是一把極為精良的鋼劍，打造的相當堅實，是馬神的武器。\n");
                set("value", 700000);
                set("material", "steel");
                set("weapon_prop/strength", 3);
                set("no_get","這是神的專屬裝備！\n");
                set("wield_msg", "$N從背後抽出一把$n，然後握在手中。\n");
                set("unwield_msg", "$N將手中的$n收回劍鞘中。\n");
        }

        init_sword(220);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

