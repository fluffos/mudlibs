#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name(MAG"紫豬錘"NOR, ({ "pig hammer", "hammer" }) );
        set_weight(9000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是一把極為沈重的大鐵錘，打造的相當堅實，是豬神的武器。\n");
                set("value", 1200000);
                set("material", "iron");
                set("no_get","這是神的專屬裝備！\n");
                set("weapon_prop/strength", 5);
                set("wield_msg", "$N拿出一把$n，試了試重量，然後握在手中。\n");
                set("unwield_msg", "$N將手中的$n扛在肩上。\n");
        }

        init_hammer(320);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

