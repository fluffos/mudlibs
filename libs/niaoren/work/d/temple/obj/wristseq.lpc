// /u/belldandy/12god/wristseq.c

#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
        set_name( HIY"馬神護腕"NOR, ({ "horse wrists", "wrists" }) );
        set("long", "這是一件神賜的裝備，是打敗馬神的證明。\n");
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "leather");
                set("wear_msg", "$N從背包拿出一件$n穿在身上。\n");
                set("value", 700000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 50);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 2);
                set("armor_prop/attack", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
