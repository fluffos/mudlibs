#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIC"鳥爪"NOR, ({ "bird claw","claw" }) );
        set_weight(25);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
         set("long", "這是由"CYN"新鳥人"NOR"所遺失的拳套，本屬"BLINK""HIY"天地神兵"NOR"之一，但確因威力太強而被封印。\n如今只有1/2的力量。全長一尺，共有四爪，由臂連拳，一體成型。\n");
                set("value", 100000);
                   set("no_drop", "如此寶貴的武器再世難求啊。\n");
//                set("no_get", "這件武器不能送人。\n");
                set("material", "blacksteel");
                set("wield_msg",
        "$N重腰間所繫的"HIC"$n"NOR"拿了出來，迅速的裝備在手臂上，剎那間變成鳥人了。\n");
                set("unwield_msg", 
        "$N將手臂的"HIC"$n"NOR"拿了下來，並以優雅的姿勢掛回腰間，又恢復成原來的模樣了。\n");
        }
 init_sword(500);
        setup();
}
//int query_autoload()
//{
//   return 1;
//}
int hit_ob(object me, object ob, int damage)
{
        if( random(8) >1 )      {
         message_vision("\n$N被$n手上的"HIC"鳥爪"NOR"發出莫名的"HIW"光茫"NOR"給灼傷了！\n", ob);

        ob->receive_damage("qi",400);
        }
}
