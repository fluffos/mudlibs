//土牛棍  /u/belldandy/12god/cowclub.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
        set_name(YEL"土牛棍"NOR, ({ "cow staff", "staff" }));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "這是一根樺木白臘棍，輕重合宜，是牛神的武器。\n");
                set("value", 200000);
                set("material", "steel");
                set("no_get","這是神的專屬裝備！\n");
                set("wield_msg", "$N抽出一根$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n插回腰間。\n");
        }
        init_staff(120);
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

