// /u/belldandy/12god/clotheq.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name( RED"虎神紅衫"NOR, ({ "tiger cloth", "cloth" }) );
        set("long", "這是一件神賜的裝備，是打敗虎神的證明。\n");
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("wear_msg", "$N從背包拿出一件$n穿在身上。\n");
                set("value", 300000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 100);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
