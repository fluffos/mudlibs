// /u/belldandy/12god/shieldeq.c

#include <armor.h>
#include <ansi.h>

inherit SHIELD;

void create()
{
        set_name( HIC"羊神盾牌"NOR, ({ "sheep shield", "shield" }) );
        set("long", "這是一件神賜的裝備，是打敗羊神的證明。\n");
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "面");
                set("material", "leather");
                set("wear_msg", "$N從背包拿出一面$n握在手上。\n");
                set("value", 800000);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 250);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 4);
                set("armor_prop/attack", 3);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
