#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石山道");
        set("long",@long
石砌大道沿山勢扶搖直上，險峻萬分，四週不復見翠綠色山野景色
，白雲從你腳邊快速的流竄過。
long);
        set("exits", ([
            "eastup": __DIR__"stoneroad5",
            "westdown": __DIR__"stoneroad3",
                       ]));

        set("objects", ([
               __DIR__"npc/birdman" : 2,
                         ]));

        set("outdoors", "temple");
        setup();
}
