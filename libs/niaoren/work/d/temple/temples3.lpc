// temples3.c
// Date: Nov.1997 by Java
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short", "羊神殿");
        set("long", "這裡是神殿二殿的第二層。你可以明顯的看到一扇用紙糊成的窗戶"HIC"(window)"NOR"，\n"
                    "殿裡淡淡的燈光，磁磚砌地，每根柱子週圍還纏了些許蜘蛛網。\n"
            );
        set("exits", ([
            "northwest"  : __DIR__"temples2-3",
            "up"    : __DIR__"temples3-1",
        ]));
        set("objects", ([
            __DIR__"npc/sheepgod" :1,
        ]));
        set("item_desc", ([
            "window": "從窗口望將出去，景色如常。附近仍是一片綠油油的草地。\n",
        ]));
        set("no_clean_up", 1);
        set("no_steal", 1);
        setup();
}

int valid_leave(object me, string dir)
{
        int c_exp,c_skill;
        me = this_player();
        if (dir == "up" )
        {
      if(objectp(present("god", environment(me))))
       {
       return notify_fail(HIC"羊神喝道：本層由我鎮守，任何人休想往上層去！\n"NOR);
       }
        else
        {
                c_exp=me->query("combat_exp");
                c_skill=me->query_skill("dodge",1);
                me->add("qi", -20);
                if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill<201))
                me->improve_skill("dodge", (int)me->query_skill("dodge", 1));
                tell_object(me,HIM"你往上爬一層樓，感到有些疲倦了。\n"NOR);
        }
      }
        return 1;
}
