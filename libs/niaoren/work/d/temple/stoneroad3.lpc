#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石大道");
        set("long",@long
從這裡往開始，石砌大道沿山勢扶搖直上，險峻萬分，四週不復見
翠綠色山野景色，白雲從你腳邊快速的流竄過。
long);
        set("exits", ([
            "eastup": __DIR__"stoneroad4",
            "west": __DIR__"stoneroad2",
                       ]));

        set("outdoors", "temple");
        setup();
}
