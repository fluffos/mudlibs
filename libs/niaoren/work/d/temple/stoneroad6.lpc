#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石山道");
        set("long",@long
石砌大道沿山勢扶搖直上，險峻萬分，四週盡是白雲繚繞，遠處的
高塔已清晰可見。
long);
        set("exits", ([
            "eastup": __DIR__"stoneroad7",
            "westdown": __DIR__"stoneroad5",
                       ]));

        set("outdoors", "temple");
        setup();
}
