#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石山道");
        set("long",@long
石砌大道沿山勢扶搖直上，險峻萬分，四週盡是白雲繚繞，遠處可
以隱約看見一座聳立的高塔。
long);
        set("exits", ([
            "eastup": __DIR__"stoneroad6",
            "westdown": __DIR__"stoneroad4",
                       ]));

        set("outdoors", "temple");
        setup();
        replace_program(ROOM);
}
