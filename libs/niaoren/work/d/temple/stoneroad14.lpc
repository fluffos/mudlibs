#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石山道");
        set("long",@long
陡峭石砌大道一直延伸到這裡為止，四週盡是白雲繚繞，宛如仙境
，雄偉的神殿已矗立在眼前不遠處。
long);
        set("exits", ([
            "west": __DIR__"temples",
            "eastdown": __DIR__"stoneroad13",
                       ]));

        set("outdoors", "temple");
        setup();
}
