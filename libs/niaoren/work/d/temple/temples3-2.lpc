#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "神殿二殿第三層迴廊");
        set("long", "漆黑的走道，四周只有幾盞燈火閃爍著，空氣中瀰漫恐怖氣氛！\n"
           );
        set("exits", ([
            "southwest" : __DIR__"temples3-3",
            "southeast" : __DIR__"temples3-1",
        ]));
        set("no_clean_up", 0);
        setup();
}

void init()
{
        int trap_trigger;
        object me,mob;
        me = this_player();

     if(random(5) == 3)
      {
        me->add_temp("trap_trigger", 1);
        trap_trigger = (int)me->query_temp("trap_trigger");
        switch(trap_trigger)
        {
        case 1:
        tell_object(me, HIC"\n你感覺到四週有點不太對勁！\n"NOR);
               break;
        case 2:
        tell_object(me, HIY"\n你不小心踏到地板上的機關！\n"NOR);
        me->receive_damage("qi", 300 + random(100));
              break;
        case 3:
        tell_object(me, HIM"\n你的直覺告訴你即將有狀況發生！\n"NOR);
              break;
        case 4:
        tell_object(me, HIR"\n在你的面前突然出現恐怖的怪物！\n"NOR);
        mob=new("/d/temple/npc/bloodbat");
        mob->move(environment(me));
        me->delete_temp("trap_trigger");
              break;
        }
      }
        return;
}
