#include <room.h>
inherit ROOM;
void create()
{
        set("short", "神殿底層");
        set("long", "此地看似詭異，冷冷清清，荒涼異常！\n"
           );
        set("exits", ([
            "up" : __DIR__"temple-1",
            "west" : __DIR__"stoneroad7",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "temple");
        setup();
        replace_program(ROOM);
}
