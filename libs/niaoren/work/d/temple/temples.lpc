#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short", "神殿二殿底層");
        set("long", "此地看似詭異，冷冷清清，荒涼異常！\n"
           );
        set("exits", ([
            "up" : __DIR__"temples-1",
            "east" : __DIR__"stoneroad14",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "temple");
        setup();
        replace_program(ROOM);
}
