#include <ansi.h>
//#include <room.h>

inherit ROOM;

void create()
{
        set("short", "神殿大門");
        set("long", "這裡是神殿的大門口。你可以明顯的看到一扇用紙糊成的窗戶"HIC"(window)"NOR"，\n"+
                    "還有一扇大鐵門"HIC"(gate)"NOR"，鐵門的上方還掛著一個匾"HIC"(bian)"NOR"。\n"
                    );
        set("exits", ([
            "down" : __DIR__"temple",
            "northeast" : __DIR__"temple-3",
        ]));

//　    set("objects", ([ __DIR__"npc/mousegod" : 1, ]));

        set("item_desc", ([
            "window": "從窗口望將出去，景色如常。附近仍是一片綠油油的草地。"NOR"\n",
            "gate": "這是一扇厚重的大鐵門，不妨推推"HIC"(push)"NOR"看。\n",
            "bian":HIG"                                                    \n"
                      "   ◤◢◤◢◤◢◤◢◤◢◤◢ \n"
                      "   §"BLINK""HIC"   神        　殿 "NOR""HIG"   §\n"
                      "   ◣◥◣◥◣◥◣◥◣◥◣◥ \n"
                      "                                               "NOR"\n"
                    ]));
//      set("no_clean_up", 1);
        setup();
//      replace_program(ROOM);
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        object me=this_player();

        if( !arg || arg != "gate" ) {
                return notify_fail("你要推動什麼？\n");
        }
     if( arg == "gate" )
      {
        if((int)me->query_str() > 40) //膂力大于40
         {
          message_vision(HIW"$N"HIC"站在鐵門前，使盡力氣的往鐵門一推，只聽見鐵門應聲而動，\n"NOR,this_player());
          message_vision(HIC"只見鐵門緩緩的往後移去，出現一道門戶來。\n"NOR, this_player());
          set("exits/up", __DIR__"temple1-1");
          remove_call_out("close");
          call_out("close", 5, this_object());
         }
        else
        message_vision(HIC"$N試著推了推鐵門，鐵門絲紋不動，只得罷手。\n", this_player());
       return 1;
     }
}

void close(object room)
{
        message("vision",HIC"只見鐵門又自動地關上了。\n"NOR, room);
        room->delete("exits/up");
}

int valid_leave(object me, string dir)
{
        int c_exp,c_skill;
        me = this_player();
        if (dir == "up" )
        {
                c_exp=me->query("combat_exp");
                c_skill=me->query_skill("dodge",1);
                me->add("qi", -20);
                if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill<201))
                me->improve_skill("dodge", (int)me->query_skill("dodge", 1));
                tell_object(me,HIM"你往上爬一層樓，感到有些疲倦了。\n"NOR);
        }
        return 1;
}
