// temples6.c
// Date: Nov.1997 by Java
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short", "豬神殿");
        set("long", "這裡是神殿二殿的最頂層。你可以明顯的看到一扇用紙糊成的窗戶"HIC"(window)"NOR"，\n"
                    "殿裡淡淡的燈光，磁磚砌地，每根柱子週圍還纏了些許蜘蛛網。\n"
           );
        set("exits", ([
            "northwest"  : __DIR__"temples6-3",
        ]));
        set("objects", ([
            __DIR__"npc/piggod" :1,
        ]));
        set("item_desc", ([
            "window": "從窗口望將出去，景色如常。附近仍是一片綠油油的草地。\n",
        ]));
        set("no_clean_up", 1);
        set("no_steal", 1);
        setup();
}

void init()
{
  object me = this_player();

     if(random(6) > 3)
     {
     message_vision(HIY"\n\n忽然間一陣天搖地動，眼尖的你立刻發現牆壁上的磁磚(wall)已剝落了幾片\n，面後似乎寫著幾行字。\n"NOR, me);
     add_action("do_dig", "dig");
     }
  return;
}

int do_dig (string arg)
{
        object me = this_player();

        if( !arg || arg != "wall" )
        {
        return notify_fail("你要挖什麼？\n");
        }

  if( arg == "wall" )
   {
    if (objectp(present("pig god", environment(me))))
       {
        message_vision(HIC"豬神喝道：$N想要幹什麼？\n"NOR, me);
        return 1;
       }
      message_vision(HIC"\n\n$N用雙手使勁的撥去牆上的磁磚，隱藏的字終於顯現出來。\n\n"NOR, me);
      me->receive_damage("qi", 100);
      me->set("marks/12god", 1);
      remove_call_out("watch");
      call_out("watch", 5, this_object());
      me->start_busy(5);
   }
  return 1;
}

void watch(object room)
{
     message("vision",HIC"\n\n牆上斗大的字體寫著：摩天崖  筋斗雲  帶朱玉  見星君。\n\n"NOR, room);
     return;
}
