#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "巨石大道");
        set("long",@long
從這裡往東看去，路面上都是用巨大的花崗石鋪砌而成，鳥瞰四週
是一大片綠色的山脈，這種壯觀的景象不由得讓你心生敬畏。
long);
        set("exits", ([
            "east": __DIR__"stoneroad2",
            "west": __DIR__"stoneroad",
                       ]));

        set("outdoors", "temple");
        setup();
        replace_program(ROOM);
}
