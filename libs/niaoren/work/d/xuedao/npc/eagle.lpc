// Jay 5/23/96

inherit NPC;

void create()
{
        set_name("禿鷹", ({ "eagle" }) );
        set("race", "野獸");
        set("age", 3);
        set("long", "一只黑色的禿鷹，禿頭黑羽，好吃腐尸，看起來討厭極了。\n");
        set("attitude", "peaceful");

        set("limbs", ({ "頭部", "身體", "翅膀", "爪子", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("combat_exp", 3000);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 50);
        set_temp("apply/armor", 10);

        setup();
}
