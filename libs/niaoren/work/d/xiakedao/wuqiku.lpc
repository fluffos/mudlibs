// wuqiku.c
inherit ROOM;

void create()
{
        set("short", "武器庫");
        set("long", @LONG
這里是俠客島的武器庫，架上擺滿了各種武器，任由來島的武士
們挑選。
LONG );
        set("exits", ([
                "east" : __DIR__"dating",
        ]));
        set("objects", ([
                "/d/village/obj/zhujian" : 2,
                "/d/city/obj/zhubang" : 2,
                "/d/shaolin/obj/changbian" : 1,
                "/d/city/obj/duanjian" : 1,
                "/d/city/obj/gangdao" : 1,
                "/d/city2/obj/fuchen" : 1
        ]));
        setup();
}
