// lisi.c 李四

inherit NPC;
#include <ansi.h>
int inquiry_yu();

void create()
{
        set_name("李四", ({ "li si", "li" }));
        set("nickname", "俠客島賞善罰惡使者");
        set("title", "冷面閻羅");
        set("long",
                "他就是江湖傳聞中賞善罰惡使者之一。\n"
                "他大約二十多歲，精明能干，總是陰沉著臉。但卻嫉惡如仇，性如烈火火
  n");
        set("gender", "男性");
        set("age", 25);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 35);
        set("con", 27);
        set("dex", 28);
        set("inquiry", ([
                 "臘八粥":"去找龍島主看看你的緣分吧。\n",
                 "俠客島":"要同時有賞善銅牌和伐惡銅牌的人才能去。\n",
                 "石破天":"他是我的結拜兄弟呀，他也在這呢。\n",
                 "罰惡銅牌" : (: inquiry_yu :),
                 "賞善罰惡令":"這是我們兄弟的信物，我是管罰惡銅牌。\n",
]) );

        set("max_qi", 2000);
        set("qi", 2000);
        set("max_jing", 2000);
        set("jing", 2000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("combat_exp", 3000000);
        set("score", 60000);

        set_skill("force", 150);
        set_skill("taiji-shengong", 150);
        set_skill("dodge", 150);
        set_skill("tiyunzong", 150);
        set_skill("unarmed", 150);
        set_skill("taiji-quan", 200);
        set_skill("parry", 150);
        set_skill("sword", 150);
       set_skill("taiji-jian", 200);
        set_skill("taoism", 100);
        set_skill("literate", 100);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.ta1" :),
                (: perform_action, "sword.ta2" :),
                (: perform_action, "sword.ta3" :),
                (: perform_action, "unarmed.ta1" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: exert_function, "f" :),
        }) );
        set_temp("shoupa",1);
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/whiterobe")->wear();
}
int accept_object(object who, object ob)
{
    object me = this_player();
    object sbu,ling1;

  if (query_temp("shoupa") < 1)
   {
   command("smile " +who->query("id"));
   command("say "+who->query("name")+"你來晚了，銅牌已經被人取走了。\n" );
   return notify_fail("你來晚了，銅牌已經被人取走了。\n");
   }
   else
     if (!who->query_temp("lisi2")) return notify_fail("我不需要這件東西。\n");
     if ( (string)ob->query("id") == "gold pai")
      {
       message_vision(CYN"李四說道：這位"+ RANK_D->query_respect(me)+"，這塊罰惡銅牌就給你了。\n"NOR, me);
       add_temp("shoupa",-1);
       me->delete_temp("lisi2");
       me->delete_temp("lisi1");
       ling1 = new("/d/xiakedao/obj/tongpai2");
       ling1->set_temp("own",who->query("id"));
       ling1->move(who);
       return 1;
       }
}

int inquiry_yu()
{
    object ob,me;
    ob = this_player();
    me = this_object();
    if (ob->query_temp("lisi1"))
    {
        command("say " + ob->query("name") + "，你既然幫了我兄弟一件事，\n"
         +"那我只好放個人情給你，只要有名單內幫派的掌門令牌，我就送你。\n");
     ob->set_temp("lisi2",1);
    }
    else
    {
        command("say " + ob->query("name") + "，你不在名單內。\n");
    }
     return 1; 
}

