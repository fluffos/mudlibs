// shipopo.c 史婆婆

inherit NPC;
inherit F_UNIQUE;
string inquiry_yu();
string inquiry_iu();

void create()
{
        set_name("史婆婆", ({ "shi", "popo" }));
        set("title", "金烏派掌門人");
        set("gender", "女性");
        set("long", "她是雪山派掌門人白自在的妻子，雖說現在人已顯得蒼老，\n"
        "但几十年前提起“江湖一枝花”史小翠來，武林中卻是無人不知。\n");
        set("age", 68);

        set("int", 30);

        set("qi", 500);
        set("max_qi", 500);
        set("jing", 500);
        set("max_jing", 500);
        set("shen_type", 1);

        set("combat_exp", 75000);
        set("attitude", "friendly");
        set("inquiry", ([
                "俠客島" : "俠客島是在泉州附近的一個小島。\n",
                "賞善罰惡令" : (: inquiry_iu :),
                "金烏派掌門令牌" : (: inquiry_yu :),
        ]) );
        set_skill("force", 70);
        set_skill("dodge", 70);
        set_skill("blade", 40);
        set_skill("parry", 90);
        set_skill("unarmed", 90);
        set_skill("jinwu-daofa", 70);
        set_skill("yanfly", 70);
//      set_skill("houquan", 100);

        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage", 35);


        map_skill("blade", "jinwu-daofa");
        map_skill("parry", "jinwu-daofa");
        map_skill("dodge", "yan-fly");
        set_temp("shoupa",0);
        set_temp("shoupa1",1);
        setup();
        carry_object("/clone/weapon/gangdao")->wield();
}
string inquiry_iu()
{
   object me=this_player();
   object obn;
   message_vision("史婆婆說道：這位"+ RANK_D->query_respect(me)+"，那是要去俠客島必須要的物品。\n",me);
   set_temp("shoupa",1);
   return "我正猶豫要不要帶著掌門令牌去呢！\n";
}
string inquiry_yu()
{
 object me=this_player();
 object obn;
 if(query_temp("shoupa")==1 && query_temp("shoupa1")==1)
 {  
   message_vision("史婆婆說道：這位"+ RANK_D->query_respect(me)+"，你若要代替本派去俠客島那就給你吧。\n"
               , me );
   obn=new("/d/xiakedao/obj/goldpai");
   obn->move(me);
   set_temp("shoupa",0);
   set_temp("shoupa1",0);
   return "金烏派掌門令牌就交給你了。\n";
 }
   message_vision("史婆婆說道：這位"+ RANK_D->query_respect(me)+"，你問這做什麼？\n",me);
   return 0;  
}
