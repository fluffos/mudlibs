// yongdao2.c 甬道


inherit ROOM;

void create()
{
        set("short", "甬道");
        set("long", @LONG
這是一條長長的甬道，兩邊點著油燈，光線雖暗，卻也可辨道
路，甬道依著山腹中天然洞穴修鑿而成，此處開鑿的豁然開朗，有
很多的江湖豪杰在此休息。
LONG );
        set("exits", ([
               "south" : __DIR__"shidong1",
               "north" : __DIR__"yongdao1",
        ]));
        set("objects", ([
               "/d/huashan/npc/haoke" : 2,
        ]));
        setup();
        replace_program(ROOM);
}
