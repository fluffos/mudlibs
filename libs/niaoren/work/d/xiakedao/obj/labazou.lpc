// labazou.c 臘八粥

#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("臘八粥", ({"laba", "zhou"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "碗");
                set("long", "這是一碗熱粥，其中蒸氣上冒，兀自有一個個氣泡從粥
底沖將上來，一碗粥盡作深綠之色，看上去說不出的詭異。聞著藥氣刺鼻，其毒可知。\n");
                set("value", 50000);
        }
        setup();
}

int do_eat(string arg)
{
        int force_limit, neili_limit, force_skill, add_skill, improve;

        object me = this_player();

        //force_limit = me->query_skill("force")*10;
        //neili_limit = me->query("max_neili");
        //force_skill = me->query_skill("force", 1);

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        if ( (int)me->query_temp("num" ) > 0 )
        {
                me->add_temp("num", 1);
                me->add("max_neili", -100);
                message_vision(HIR "$N又喝下一碗臘八粥，只覺得肝腸寸斷，五臟欲裂
，原來喝得太急太多，藥效適得其反！\n" NOR, me);
        }

        else
        {
/*              if ( improve < 100 ) {
                        add_skill = force_skill + (100 - improve)/5 + 1;
                        me->set_skill("force", add_skill );
                }
*/
                me->add("max_neili", 100);
                me->add("neili", 100);

                message_vision(HIY "$N喝下一碗臘八粥，頓然間只覺一股浩蕩無比的真
氣直沖頂門...\n" NOR, this_player());
                me->set_temp("num", 1);
        }

        me->unconcious();
        destruct(this_object());
        return 1;
}


