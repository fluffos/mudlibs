//goldpai.c
//edit by dream
#include <ansi.h>

inherit ITEM;

void create()
{
  set_name(HIY"金烏派掌門令牌"NOR,({"gold pai","pai"}));
  set_weight(100);

  if( clonep() )
        set_default_object(__FILE__);

  set("unit", "塊");
  set("long", "這是一塊閃閃發亮的金色令牌，約有巴掌大小，牌子正面刻著一隻金烏。\n");
  set("value", 100);

  setup();
}
void owner_is_killed()
{
       destruct(this_object());
}
