// mtxiaowu.c 木屋

inherit ROOM;

void create()
{
        set("short", "木屋");
        set("long", @TEXT
這里是一個很小的木屋，室中放著一些亂七八遭的家具，牆角
邊還有一張破爛的小床，有一個英俊的少年在屋內走來走去，似乎
有什么心事，不時的發出几聲長嘆...... 
TEXT );
       set("exits", ([
           "west" : __DIR__"mtdating",
       ]));
       set("objects",([
           __DIR__"npc/shizhongyu" : 1,
       ]));
       setup();
}
