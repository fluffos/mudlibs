// wugen.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("無根道長", ( { "wugen daozhang", "wugen","daozhang" }) );
	set("title", "神龍教赤龍使");
	set("gender", "男性" );
	set("age", 55);
	set("long",
	      "這是個五十來歲的黑須道長,相貌威武,眼中略帶殺氣。\n"
	     );

	set("int", 30);
	set("str", 25);
	set("con", 25);
	set("dex", 25);

	set("qi", 3000);
	set("max_qi", 3000);
	set("jing", 1000);
	set("max_jing", 1000);
	set("neili", 1000);
	set("max_neili", 1000);
	set("jiali", 100);
	set("combat_exp", 500000);
	set("score", 15000);
	set_temp("apply/attack", 60);
	set_temp("apply/defense", 60);
	set_temp("apply/damage", 40);

	set_skill("unarmed",90);
	set_skill("force", 90);
	set_skill("dodge", 90);
	set_skill("parry", 90);
	set_skill("sword", 100);
	set_skill("staff", 100);
	set_skill("literate", 80);
	set_skill("huashan-zhangfa", 60);
	set_skill("huashan-shenfa",80);
	set_skill("huashan-jianfa", 90);
	set_skill("zixia-shengong", 80);
	set_skill("shenlong-xinfa", 90);
	set_skill("shedao-qigong", 90);

	map_skill("force", "zixia-shengong");
	map_skill("unarmed", "huashan-zhangfa");
	map_skill("dodge", "huashan-shenfa");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "sword.hu1" :),
                (: perform_action, "sword.hu2" :),
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                
        }) );


       set("inquiry", ([
		"神龍教" :  "\n一般人是入不了我神龍教的(join shenlongjiao).\n",
		"洪安通" :  "\n教主脾氣不好,要討他歡心才好。\n",
		"教主" :  "\n教主脾氣不好,要討他歡心才好。\n",
		"入教" :  "\n一般人是入不了我神龍教的(join shenlongjiao).\n",
		"口號" : "\n萬年不老!永享仙福!壽與天齊!文武仁聖!\n",
	]));
	setup();
        carry_object("/d/city/obj/duanjian")->wield();
	add_money("silver",10);
}

int do_join(string arg)
{
   object ob ;
   ob = this_player () ;
   if( !arg || arg!="shenlongjiao" )
	return notify_fail("你要加入什么組織？\n"); 
   if(ob->query("shenlongjiao")) 
	{
	message_vision(HIC "無根道長說道：你已經是神龍教弟子了。\n" NOR,this_player());
	return 1;
	}
   if ((int)ob->query("shen")>-1000)
        {
	message_vision(HIC "無根道長對$N大怒道：還想入教?一看你就不是好人!\n" NOR,this_player());
	set_leader(this_player());
	remove_call_out("kill_ob");
	call_out("kill_ob", 1, this_player()); 
  	return 1;
	}
   if (ob->query("combat_exp")<20000)
        {
	message_vision(HIC "無根道長對$N搖頭道：你的實戰經驗太低。\n" NOR,this_player());
  	return 1;
  	}
  if ( ob->query_skill("bibo-shengong",1)
	|| ob->query_skill("hamagong",1)
	|| ob->query_skill("huagong-dafa",1))
   {
    ob->set("shenlongjiao",1);
    command("tell "+this_player()->query("id")+" 你現在就是神龍教弟子了.\n");
    return 1;	
   }
   else 
   {
   message_vision(HIC "無根道長對$N大怒道：還想入教?一看你就不是好人!\n" NOR,this_player());
	set_leader(this_player());
	remove_call_out("kill_ob");
	call_out("kill_ob", 1, this_player()); 
  	return 1;
	}
}
void init()
{
	object ob;

	::init();
add_action("do_join","join");
	if( interactive(ob = this_player()) && !is_fighting() ) {

		remove_call_out("greeting");
		call_out("greeting", 50, ob);
	}
}


void greeting(object ob)
{
	object obj;
        if (interactive(ob))
        {
	if (obj = present("usedgao", ob))          
	   set("combat_exp",100000);
	   set("qi",100);
	   set("jing",100);
	}
	return;
}

void attempt_apprentice(object ob)
{
    if ((int)ob->query_skill("shenlong-xinfa",1) < 40 ) {
        command("say 你的本門內功心法太低了,還是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query_skill("shedao-qigong",1) < 40 ) {
        command("say 你的本門杖法太低了,還是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query("shen") > -5000  ) {
        command("say 我神龍教與世隔絕，向來不與您這種白道人物打交道，您請回吧！");
		return;
	}
    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}
 
