void create()
{
	set_name("無名花", ({"hua2", "wuming"}));
	set("unit", "朵");
	set("long", "這是一朵無名小花，花蕊雖小，卻十分美麗。\n");
	setup();
}

int do_eat(string arg)
{
	object me=this_player();
	if (!id(arg))  return notify_fail("你要吃什么？\n");
	if(arg=="hua2")
	{
//		me->add("max_neili",5);
//		me->unconcious();
		destruct(this_object());
	}
	return 1;
}
