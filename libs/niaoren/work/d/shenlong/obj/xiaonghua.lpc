#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name("雄黃", ({"xionghuang" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "包");
		set("long", "這是一包雄黃,據說可驅百毒。\n");
		set("value", 1000);
	}
	setup();
}

int do_eat(string arg)
{
	return notify_fail("想死啊？雄黃不能吃.\n");
}

