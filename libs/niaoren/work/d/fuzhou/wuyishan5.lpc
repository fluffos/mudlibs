inherit ROOM;

void create()
{
	set("short", "九曲溪");
	set("long", @LONG
盈盈一水，折為九曲。兩岸樹綠竹翠，奇峰突兀，真是“溪
流九曲瀉云液，山光倒浸清漣漪”。
LONG );
	set("exits", ([
		"east"      : __DIR__"wuyishan2",
		"northup"   : __DIR__"wuyishan3",
		"northwest" : __DIR__"wuyishan4",
	]));
	set("resource/water", 1);
	set("no_clean_up", 0);
	set("outdoors", "quanzhou");
	setup();
	replace_program(ROOM);
}

