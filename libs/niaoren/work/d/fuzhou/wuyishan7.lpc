inherit ROOM;

void create()
{
	set("short", "玉女峰");
	set("long", @LONG
玉女峰亭亭如少女玉立，突兀挺拔。峰頂花卉參簇，恰似山
花插鬢。岩壁秀潤光滑，宛如玉肌清涼。俏立溪畔，凜然不可侵
犯，無路攀登。“插花臨水一奇峰，玉骨冰肌處女容”即其寫照。
峰下浴香潭，為玉女沐浴處。峰東圓石如鏡，是為梳妝台。
LONG );
	set("exits", ([
		"north" : __DIR__"wuyishan2",
	]));
	set("no_clean_up", 0);
	set("outdoors", "quanzhou");
	setup();
}

