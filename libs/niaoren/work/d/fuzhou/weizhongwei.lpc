#include <room.h>
inherit ROOM;
void create()
{
        set("short", "味中味");
        set("long", @LONG
提起“樓外樓”方圓百里無人不知。這里各式閩菜均是
福州一絕。來游湖的人們都一定會來這里嘗嘗。整個大堂鬧
哄哄的擠滿了各式人等。店小兒跑來跑去，忙著招呼客人。
牆上挂著價格牌子(paizi)。
LONG);
        set("exits", ([
            "west"  : __DIR__"nandajie",
              "east"  : __DIR__"chufang",
        ]));
        set("objects", ([
            __DIR__"npc/xiaoer3" : 1,
        ]));
        set("item_desc", ([
            "paizi" : "
佛跳牆(Fotiaoqiang)   ：五兩白銀
福建老酒(Jiuping)     ：二兩白銀\n",
        ]));
//        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

