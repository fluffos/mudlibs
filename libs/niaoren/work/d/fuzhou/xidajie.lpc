inherit ROOM;

void create()
{
	set("short", "西大街");
	set("long", @LONG
大街北面，一座結構宏偉的建筑前，左右石壇上各插著
一根兩丈多高的旗杆，杆上青旗飄揚。右首旗子用金線繡著
一頭張牙舞爪的獅子，旗風招展，奕奕如生。雄獅上頭有一
對黑絲線繡的蝙蝠展翅飛翔。左首旗子上寫著“福威鏢局”
四個黑字，銀鉤鐵划，剛勁非凡。
LONG );

	set("exits", ([
		"southup" : __DIR__"wushan",
		"north"   : __DIR__"biaoju",
		"east"    : __DIR__"dongjiekou",
		"west"    : __DIR__"ximendajie",
	]));
	set("outdoors", "quanzhou");
	set("no_clean_up", 0);
	setup();
}

