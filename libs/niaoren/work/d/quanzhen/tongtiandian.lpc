#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "通天殿");
        set("long", @LONG
這里是供奉三清之末--通天教主的大殿，殿內的香煙不甚旺盛。
在通天教主的金身旁邊，塑著几位截教道友象長耳仙、歸云仙、申
公豹的塑像。
LONG
        );
        set("exits", ([
                "north" : __DIR__"laojundian",
        ]));
        set("no_clean_up", 0);
        setup();
}
