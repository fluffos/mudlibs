inherit ROOM;

void create()
{
        set("short", "西門");
        set("long", @LONG
這里是武功鎮的西門，眼前城牆高聳，牆上的箭垛里好象還有
人走來走去。陽光照來，城牆上閃過几道白光，似乎是兵器反射出
的光。城門上題著‘西門’兩個大字，門口站著一些官兵，正手持
兵刃盤問著來往的行人們。從這里折而向北，就是終南山腳了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __DIR__"xijie",
                "northeast" : __DIR__"shanlu1",
        ]));

        set("objects", ([
                __DIR__"npc/wujiang" : 1,
                __DIR__"npc/bing" : 2,
        ]));
        setup();
}
