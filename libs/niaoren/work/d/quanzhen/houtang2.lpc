#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "后堂二進");
        set("long", @LONG
這里是全真教弟子平常研討武功的地方，這個堂不大，由于經常
要在這里演武，索性連桌椅也全都靠到牆邊去了，這樣騰出了一大片
空地來。
LONG
        );
        set("no_clean_up", 0);
        set("exits", ([
                "east" : __DIR__"houtang3",
                "west" : __DIR__"houtang1",
                "south" : __DIR__"wuchang1",
                "north" : __DIR__"liangong",
        ]));

        set("objects", ([
                __DIR__"npc/mu-ren" : 6,
        ]));

        setup();
}
