inherit ROOM;

void create()
{
        set("short", "民居");
        set("long", @LONG
這好象是一家相對殷實的小康人家，屋內鋪著青磚，擺著一套紅
木桌椅。牆上挂著几幅山水畫(hua)， 主人不在家里。
LONG
        );
        set("exits", ([
                "east" : __DIR__"beijie",
        ]));
        set("item_desc", ([
        "hua": "這不是北宋范寬的‘溪山行旅圖’嗎？你大吃一驚。揉了揉眼睛仔細一看，原來是副贗品。\n"
        ]) );
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
