// xiaolu8.c 后山小路
// By Lgg,1998.10

inherit ROOM;
string l_pattern();

void create()
{
        set("short", "后山小路");
        set("long", @LONG
這里是后山上的小路。這條小路好象不是人工刻意修出來的，
也許只是以前的采藥人踩多了，現出這樣一條小路來。山壁上好象
刻著一些什么字跡(pattern)。走到這里，你好象迷路了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __FILE__,
                "west" : __DIR__"xiaolu7",
                "north" : __DIR__"xiaolu4",
                "south" : __FILE__,
        ]));
        set("item_desc",([
          "pattern" : (:l_pattern():),
        ]));
        set("no_clean_up", 0);

        setup();
        //replace_program(ROOM);
}

string l_pattern()
{
        object me=this_player();
        if(me->query_temp("tmark/指")==3) {
                me->add_temp("tmark/指",1);
                return("好象是被人用大力金剛指力之類的功夫在山石上刻下一首詩，這
人的指力可真了得。\n");
        }
        else {
                me->set_temp("tmark/指",0);
                return("山壁上刻著一首詩，不知道是怎么刻上去的。\n");
        }
}
