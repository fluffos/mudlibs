#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "禪房");
        set("long", @LONG
這里是全真弟子修身養性、打熬氣力的地方。為了方便練功，桌
椅都沒有擺放，僅僅在地下丟了几個小蒲團。
LONG
        );
        set("exits", ([
                "east" : __DIR__"xiaohuayuan2",
                "west" : __DIR__"chanfang2",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
