#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "過真殿");
        set("long", @LONG
這里是大堂旁邊的一個側殿，也是接待重要客人的地方。殿不
大，只擺放著一張桌子和几把椅子。桌上擺放著一盆青山隱隱的盆
景，牆壁上挂著一些字畫。從這里往北，好象有一座四層的小塔。
LONG
        );
        set("exits", ([
                "south" : __DIR__"datang3",
                "west" : __DIR__"cetang",
                "north" : __DIR__"cundaota1",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
