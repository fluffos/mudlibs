inherit ROOM;

void create()
{
        set("short", "密室");
        set("long", @LONG
這里是一間密室，四周散布著几條帶血的鞭子，還有一些各
種各樣的刑具。看來傳說果然不虛，這侯員外果真是個魚肉鄉里
的惡霸。
LONG
        );
        set("exits", ([
                "northwest" : __DIR__"fu-midao",
                "up" : __DIR__"fu-woshi",
        ]));
        set("objects", ([
                __DIR__"obj/xuejie" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
