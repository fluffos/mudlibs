#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "元始殿");
        set("long", @LONG
這里是供奉元始天尊的大殿。殿內香煙繚繞，正中央塑著元始天
尊的金身，旁邊還塑著几位道友如太乙、俱留孫、云中子、廣和子等
等的像，正聚在一處或躺或坐，或棋或茶。
LONG
        );
        set("exits", ([
                "south" : __DIR__"laojundian",
        ]));
        set("objects", ([
                __DIR__"npc/qi" : 1,
        ] ));

        setup();
}
