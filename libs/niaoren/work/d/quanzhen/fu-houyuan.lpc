// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "后院");
        set("long", @LONG
這里是后院。走到這里，花香味更加濃烈了。你仔細一看，
東南邊有一道圓形門，似乎花香是從那里傳出來的。從這里再往
南走，就是侯員外的臥室了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southeast" : __DIR__"houhuayuan",
                "north" : __DIR__"fu-datang",
                "south" : __DIR__"fu-woshi",
        ]));
        set("no_clean_up", 0);
        setup();
}
