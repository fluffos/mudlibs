#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "廣寧居");
        set("long", @LONG
這里是全真七子之六郝大通的臥室，臥室很小，除了一張小床，
一張小茶几而外沒有什么別的擺設。茶几晶螢透明，仔細一看，原來
几面是用整塊的玉琢磨成的。茶几上擺放著几本先天課朮的書，還有
一些卜卦用的金錢。
LONG
        );
        set("exits", ([
                "north" : __DIR__"piandian",
        ]));

        set("objects", ([
                __DIR__"npc/hao" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
