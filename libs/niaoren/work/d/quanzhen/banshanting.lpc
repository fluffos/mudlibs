inherit ROOM;

void create()
{
        set("short", "半山亭");
        set("long", @LONG
這里是半山腰的一個小涼亭，游客們爬山爬的累了，就轉個彎到
這里來坐一坐，歇一歇腳。從這里看下去，剛好可以看見翠屏峰的峰
頂。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southdown" : __DIR__"shijie5",
        ]));

        set("objects",([
                __DIR__"npc/youke" : 2,
        ]));

        setup();
}
