inherit ROOM;

void create()
{
        set("short", "后山小路");
        set("long", @LONG
這里是后山上的小路。這條小路好象不是人工刻意修出來的，
也許只是以前的采藥人踩多了，現出這樣一條小路來。走到這里，
你好象迷路了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __FILE__,
                "west" : __DIR__"xiaolu3",
                "north" : __FILE__,
                "south" : __DIR__"xiaolu8",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

