inherit ROOM;

void create()
{
        set("short", "試劍岩");
        set("long", @LONG
石階旁立著一塊大岩石，上面斑斑駁駁的盡是砍傷。這塊大岩
石便是全真教的試劍岩，天下的英雄來到這里，望著先輩們練劍時
在岩石上的砍痕，無不肅然起敬。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "northdown" : __DIR__"shijie4",
                "southup" : __DIR__"shijie8",
                "east" : __DIR__"jiaobei",
        ]));
        set("objects",([
                __DIR__"npc/yin" : 1,
                __DIR__"npc/daotong" : 2,
        ]));

        setup();
}
