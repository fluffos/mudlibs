inherit ROOM;

void create()
{
        set("short", "富家大門");
        set("long", @LONG
這里是武功鎮上首富--侯員外家的大門，門上挂著一塊大橫匾，
上面寫著‘侯府’兩個大字。門內立著一面朱紅的影壁，模模糊糊
好象題著一些詩句之類的東西。几個橫眉立眼的家丁正挺胸凸肚地
站在門口耀武揚威，看來這是一家為富不仁的鄉紳列霸。
LONG
        );
        set("exits", ([
                "north" : __DIR__"dongjie",
                "south" : __DIR__"fu-xiaoyuan",
        ]));
        set("objects", ([
                __DIR__"npc/jiading" : 3,
        ]));

        setup();
}
