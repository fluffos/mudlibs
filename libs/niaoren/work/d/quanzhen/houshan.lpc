inherit ROOM;

void create()
{
        set("short", "后山");
        set("long", @LONG
這里已經出了重陽宮，到了終南山的后山。這里鳥語花香，
空氣清新，山勢也平緩得多了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "west" : __DIR__"jingxiushi",
                "northeast" : __DIR__"xiaolu1",
        ]));
        set("no_clean_up", 0);
        setup();
}

