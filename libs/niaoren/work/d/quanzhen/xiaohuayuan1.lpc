#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "小花園");
        set("long", @LONG
這里是重陽觀里的小花園，空氣中飄著一股鮮花的香味。再往
北去，就是金魚池了。這個花園不大，卻是全真弟子練功間隙最愛
來游玩的地方。園中見不到一根雜草，也許專門有人負責管理這里。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southwest" : __DIR__"houtang3",
                "northeast" : __DIR__"xiaohuayuan2",
        ]));

        set("objects", ([
                __DIR__"npc/zhangyuan" : 1,
        ]));

        setup();
}
