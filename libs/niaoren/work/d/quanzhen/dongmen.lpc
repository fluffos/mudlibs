// dongmen.c 東門
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "東門");
        set("long", @LONG
這里是武功鎮的東門，眼前城牆高聳，牆上的箭垛里好象還有
人走來走去。陽光照來，城牆上閃過几道白光，似乎是兵器反射出
的光。城門上題著‘東門’兩個大字，門口站著一些官兵，正手持
兵刃盤問著來往的行人們。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __DIR__"guandao2",
                "west" : __DIR__"dongjie",
        ]));
        set("objects", ([
                __DIR__"npc/wujiang" : 1,
                __DIR__"npc/bing" : 2,
        ]));
        setup();
        replace_program(ROOM);
}
