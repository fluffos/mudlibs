#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "容物堂");
        set("long", @LONG
這里是全真七子之二譚處端的居室，這間房間收拾的和普通的民
居沒什么區別，只是一塵不染，牆上斜挂著一把寶劍。
LONG
        );
        set("exits", ([
                "north" : __DIR__"xianzhentang",
        ]));
        set("objects",([
                __DIR__"npc/tan" : 1,
        ]));
        setup();
}
