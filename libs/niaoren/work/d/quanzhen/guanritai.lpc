inherit ROOM;

void create()
{
        set("short", "觀日台");
        set("long", @LONG
這里是終南山上的觀日台，不知哪朝哪代何人在這里修筑了這個
平台，用來觀瞻日出的美景。這里的山勢非常陡峻，往下一看，懸崖
壁立，腳下白云飄過，真不知身在何境。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "north" : __DIR__"shijie9",
        ]));
        set("objects",([
                __DIR__"npc/youke" : 1,
                __DIR__"npc/xiangke" : 1,
        ]));
        setup();
}
