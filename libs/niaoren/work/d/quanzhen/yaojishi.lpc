// yaojishi.c 藥劑室
// By Lgg,1998.10

inherit ROOM;
int do_pullout(string arg);

void create()
{
        set("short", "藥劑室");
        set("long", @LONG
這里是全真教制藥、配藥的地方。這間房間本來很大，只是
被前后左右堆放的藥柜藥箱擠的顯得小多了。藥柜已經很陳舊了，
不過是用上好的南海沉香木做成的，據說用這種木材做成的柜子
用來儲藏東西不會遭虫蛀。藥柜上面有個抽屜(drawer)。
LONG
        );
        set("sleep_room",1);
        set("exits", ([
                "east" : __DIR__"xianzhentang",
        ]));

        set("objects", ([
                __DIR__"npc/zhangyao" : 1,
        ]));

        set("item_desc", ([
        "drawer": "一個抽屜，不知道是因為粗心還是什么原因，沒有上鎖。\n"
        ]) );

        set("count",1);
        setup();
        //replace_program(ROOM);
}

void init()
{
        add_action("do_pullout","pullout");
}

int do_pullout(string arg)
{
        object me=this_player();
        object ob;

        if( !arg || arg != "drawer" ) {
                return notify_fail("你要拉開什么？\n");
        }

        if (query("count")>0) {
        message_vision("$N趁著掌藥道長轉過身去，飛快地把抽屜拉開，里面好象有什么東西，\n",this_player());
        message_vision("還沒來得及看，掌藥道長又轉過身來。只嚇得$N一把抓起抽屜里的東西\n", this_player());
        message_vision("塞進懷里，然后裝作抬頭看藥柜的木質，做出一副若無其事的樣子。哈\n",this_player());
        message_vision("哈，掌藥道長居然沒發覺，$N長出了一口氣，把無辜的表情收了回來。\n",this_player());
        add("count",-1);
        ob=new(__DIR__"obj/tianqi.lpc");
        ob->move(me);
        }
        else {
        message_vision("$N趁著掌藥道長轉過身去，飛快地把抽屜拉開，里面空空如也，原本在\n",this_player());
        message_vision("里面的東西好象已經被人取走了。\n", this_player());
        }

        return 1;
}

