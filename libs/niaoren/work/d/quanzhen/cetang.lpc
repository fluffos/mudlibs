#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "側堂");
        set("long", @LONG
這里是大堂旁邊的一個側廳，也是接待重要客人的地方。廳不
大，只擺放著一張桌子和几把椅子。桌上擺放著一盆青松山石的盆
景，牆壁上挂著一些字畫。
LONG
        );
        set("exits", ([
                "east" : __DIR__"guozhendian",
                "west" : __DIR__"huizhentang",
                "north" : __DIR__"shiweishi",
                "south" : __DIR__"datang2",
        ]));
        set("objects", ([
                __DIR__"npc/li" : 1,
        ]));

        setup();
}
