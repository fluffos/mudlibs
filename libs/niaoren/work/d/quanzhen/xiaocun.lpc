inherit ROOM;

void create()
{
        set("short", "小村庄");
        set("long", @LONG
這是一片小村庄，隱藏在一個小山坳里。這里的居民們都很少到
城里去，雖然離武功鎮不過是五、六里的山路，他們寧愿秉承著男耕
女紡織、日出而作日落而歇的老傳統。日子雖然清貧，卻還算逍遙。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "northwest" : __DIR__"guchang",
                "southdown" : __DIR__"shanlu1",
        ]));
        set("no_clean_up", 0);
        setup();
}
