// seller.c

inherit NPC;
inherit F_VENDOR;

string ask_me();

void create()
{
        set_name("小販", ({ "seller" }) );
        set("gender", "男性" );
        set("age", 32);
        set("long",
                "這是個小販，別看他長的老老實實，可你別想從他那兒掏便宜。\n");
        set("combat_exp", 300);
        set("str", 17);
        set("dex", 20);
        set("con", 17);
        set("int", 22);
        set("attitude", "friendly");
        set("vendor_goods", ({
                __DIR__"obj/stick",
                __DIR__"obj/bottle",
                __DIR__"obj/egg",
                "/d/xingxiu/obj/fire",
        }) );
        set("inquiry", ([
                "藥" : (: ask_me :),
                "藥材" : (: ask_me :),
        ]) );
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        add_money("coin", 100);
}

void init()
{
        ::init();
        add_action("do_list","list");
        add_action("do_buy", "buy");
}

string ask_me()
{
        object me=this_player();
        if ( me->query_temp("tmark/藥")) {
                return "我走南闖北，沒見過你這么羅嗦的人！\n";
        }
        else {
                me->set_temp("tmark/藥",1);
                return "當年我到極北森林中采藥，還真遇到了一些好藥材，要買得先交
錢。\n";
        }
}

int accept_object(object who, object ob)
{
        object obj;

        if ((ob->query("money_id")) && (ob->value() >= 10000)
         && (who->query_temp("tmark/藥")))
        {
                obj = new(__DIR__"obj/shouwu");
                obj->move(who);
                who->add_temp("tmark/藥",0);
                write("小販說道：“既然您出得起價錢，這味藥可就歸您了。”\n");
                return 1;
        }
        else
                if (ob->query("money_id"))
                {
                        write("小販陰笑一聲，說道：“嘿嘿，給我這么多錢哪。”\n");
                        return 1;
                }
                else {
                        return notify_fail("小販詫異地說道：“給我這個干什么？”\n");
                }
}
