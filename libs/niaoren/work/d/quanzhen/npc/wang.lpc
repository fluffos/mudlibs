// wang.c 王重陽
// By Lgg,1998.10

#include <ansi.h>

inherit NPC;

string ask_jiuyin();
string ask_zhipu();
string ask_duan();

void create()
{
        set_name("王重陽", ({"wang chongyang", "wang"}));
        set("gender", "男性");
        set("age", 66);
        set("class", "taoist");
        set("nickname",HIW"活死人"NOR);
        set("long",
                "他就是全真教的開山祖師、首代掌教王重陽王真人。他白須飄\n"
                "飄，寬袍緩袖，眉目清  ，頗有些仙風道骨的味道。他本來一\n"
                "腔熱血欲報效國家力抗金兵，可惜朝廷腐敗，于是心灰意冷，\n"
                "又從道德經中悟得了天地滋生的大道，手創全真教。\n");
        set("attitude", "peaceful");
        set("shen_type",1);
        set("str", 45);
        set("int", 45);
        set("con", 45);
        set("dex", 45);
        set("qi", 6500);
        set("max_qi", 6500);
        set("jing", 2400);
        set("max_jing", 2400);
        set("neili", 9000);
        set("max_neili", 9000);
        set("max_jiali", 100);
        set("jiali", 100);
        set("max_qi", 50000);
        set("qi", 50000);
        set("combat_exp", 2000000);
        set("score", 500000);

        set_skill("force", 450);
        set_skill("xiantian-qigong", 450);    //先天氣功
        set_skill("sword", 420);
        set_skill("quanzhen-jian",420);  //全真劍
        set_skill("dodge", 420);
        set_skill("jinyan-gong", 420);   //金雁功
        set_skill("parry", 420);
        set_skill("unarmed",380);
        set_skill("haotian-zhang", 350);    //昊天掌
        set_skill("literate",400);
        set_skill("strike",400);
        set_skill("taoism",450);
        set_skill("finger",400);
        set_skill("sun-finger",300);  //一陽指
        map_skill("force", "xiantian-qigong");
        map_skill("sword", "quanzhen-jian");
        map_skill("dodge", "jinyan-gong");
        map_skill("parry", "quanzhen-jian");
        map_skill("strike", "haotian-zhang");
        map_skill("finger","sun-finger");
        prepare_skill("finger","sun-finger");
        prepare_skill("strike","haotian-zhang");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "re1" :),
                (: exert_function, "p" :),
                (: perform_action, "sword.qu1" :),
                (: perform_action, "sword.qu2" :),
                (: command("unwield changjian") :),
                (: command("wield changjian") :),
                (: perform_action, "finger.su1" :),
                (: perform_action, "strike.ha1" :),
        }));

        create_family("全真教", 1, "掌教");

        set("book_count",1);
        set("inquiry", ([
                "全真教" :  "我全真教是天下道家玄門正宗。\n",
                "九陰真經" : (: ask_jiuyin :),
                "一陽指" : (: ask_zhipu :),
                "段皇爺" : (: ask_duan :),
        ]) );

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object(__DIR__"obj/greenrobe")->wear();

}

void attempt_apprentice(object ob)
{
        if (ob->query_int() < 30) {
                command("say 你的資質不夠，還是先找我那几個徒弟學習吧。");
                return;
        }
        if ((int)ob->query_skill("xiantian-qigong",1) < 100 ) {
                command("say 你的本門內功心法火候不足,難以領略更高深的武功。");
                return;
        }
        if ((int)ob->query("shen")<10000) {
                command("say 行俠仗義是我輩學武人的基本品質，你若能多做些狹義之
事，我一定收你為徒。\n");
                return;
        }
        command("say 好吧，依你資質，定可傳我衣缽，我就收下你這個徒弟了。");
        command("recruit " + ob->query("id"));
}

string ask_jiuyin()
{
        mapping fam;
        int lvl_force;

        if (!(fam = this_player()->query("family"))
            || fam["family_name"] != "全真教")
                return RANK_D->query_respect(this_player()) +
                "與本教毫無瓜葛，這話從何說起？";
        if (!(lvl_force = this_player()->query_skill("force",1))
            || lvl_force < 50)
                return RANK_D->query_respect(this_player()) +
                "的基本內功火候如此之淺，強練真經上的上乘武功有害無益。";
        return "九陰真經是天下武學正宗，我已交給我師弟周伯通保管，\n"
                +"不過....在古墓派的石棺內，我還刻著一些圖形。\n";
}

string ask_duan()
{
        object me=this_player();
        if(me->query_temp("tmark/指")==4) {
                me->add_temp("tmark/指",1);
                return("段皇爺號稱‘南帝’，家傳的一陽指是天下最厲害的指法。\n");
        }
        else {
                me->set_temp("tmark/指",0);
                return("你問段皇爺做甚么，莫非想與他為難？\n");
        }
}

string ask_zhipu()
{
        object ob,me=this_player();
        if(me->query_temp("tmark/指")==5) {
                me->set_temp("tmark/指",0);
                if(query("book_count")>0) {
                        ob=new("/clone/book/zhifapu");
                        ob->move(me);
                        add("book_count",-1);
                        return("好吧，你歷經艱苦，意志甚堅，這本指法譜就交給你了。\n");
                }
                else
                        return("你來晚了，指法譜已經被人取走了。\n");
        }
        else {
                me->set_temp("tmark/指",0);
                return  RANK_D->query_respect(me) +
                        "不是想跟我較量較量吧？\n";
        }
}
