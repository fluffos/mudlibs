// gao.c 龜苓膏
// By Lgg,1998.10

inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"龜苓膏"NOR, ({"guiling gao","gao"}));
        set_weight(3000);
        set("unit", "塊");
        set("long", "這是一塊用烏龜甲和茯苓配置成的龜苓膏，功能延年益壽。\n");
        setup();
}

int do_eat(string arg)
{
        object me=this_player();

        if (!(arg))  return notify_fail("你要吃什么？\n");
        if(arg=="gao")
        {
                if ((int)me->query("max_jingli")<=300) {
                        write(YEL"你吃下了一塊龜苓膏，只覺得精神健旺之極，精力直
欲奔騰而出。\n"NOR);
                        me->add("max_jingli",20);
                        me->add("jingli",20);
                }
                else {
                        write("你吃下了一塊龜苓膏，但是好象沒什么用。\n");
                }
                destruct(this_object());
                me->unconcious();
        }
        return 1;
}
