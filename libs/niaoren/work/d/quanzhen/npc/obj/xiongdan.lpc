// xiongdan.c 熊膽
// By Lgg,1998.10

inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"熊膽"NOR, ({"xiongdan"}));
        set_weight(1000);
        set("unit", "顆");
        set("long", "這是一顆鮮紅的熊膽，看來可以入藥。\n");
        setup();
}

int do_eat(string arg)
{
        if (!(arg))  return notify_fail("你要吃什么？\n");
        if(arg=="xiongdan")
        {
                write("你三口兩口把熊膽吃了下去。\n");
                destruct(this_object());
        }
        return 1;
}

