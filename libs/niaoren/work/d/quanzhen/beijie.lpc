inherit ROOM;

void create()
{
        set("short", "北街");
        set("long", @LONG
北街是武功鎮最繁華的街道，每逢初一十五，還要在這里舉行
些廟會之類的聚會。街北面是一家酒樓，樓前挂著一條藍幅，上面
寫了個大大的‘酒’字。西面是一戶人家。几個小孩在街上笑著鬧
著互相追逐。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "south" : __DIR__"zhongxin",
                "north" : __DIR__"jiulou1",
                "west" : __DIR__"minju1",
        ]));
        set("objects", ([
                __DIR__"npc/kid" : 3,
        ]));

        setup();
        replace_program(ROOM);
}
