#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "大堂二進");
        set("long", @LONG
這里是大堂的第二重，是全真教弟子做功課的所在。現在還不到
功課時間，大堂里空蕩蕩的，只有全真教掌管上下雜事的掌理道長帶
領著几個小道童在整理桌椅，預備餐飯。
LONG
        );
        set("exits", ([
                "east" : __DIR__"datang3",
                "west" : __DIR__"datang1",
                "north" : __DIR__"cetang",
                "south" : __DIR__"piandian",
        ]));
        set("objects",([
                __DIR__"npc/zhangli" : 1,
                __DIR__"npc/daotong1" : 1,
        ]));
        setup();
}
