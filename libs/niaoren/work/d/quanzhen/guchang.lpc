// guchang.c 晒谷場
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "晒谷場");
        set("long", @LONG
這里是村庄中心的晒谷場，地方不大，不過村里也就五、六戶人
家，種的谷子也夠晒了。現在正是收獲的季節，谷場中堆滿了谷子，
几個男女童子正在場中嬉鬧，不時地揚起一捧谷子相互撒去。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southeast" : __DIR__"xiaocun",
                "north" : __DIR__"cunzhangjia",
                "northwest" : __DIR__"minju3",
                "southwest" : __DIR__"minju4",
        ]));
        set("objects", ([
                __DIR__"npc/boy" : 2,
                __DIR__"npc/girl" : 1,
        ]));

        setup();
        replace_program(ROOM);
}
