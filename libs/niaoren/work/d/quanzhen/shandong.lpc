#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "后山山洞");
        set("long", @LONG
這里是全真教開山祖師王重陽真人靜修的山洞。洞不大，但
里面布置得很雅致，象大戶人家的客廳一樣。洞壁上挂著一副畫
(hua)，桌椅茶几都很精致。
LONG
        );
        set("exits", ([
                "out" : __DIR__"xiaolu12",
        ]));
        set("item_desc", ([
        "hua": "畫中是一個中年道士的背影，看不出什么相貌，畫中人一手指天，畫角題
著‘"+MAG"活死人像"NOR+"’几個大字。\n"
        ]) );

        set("objects", ([
                __DIR__"npc/wang" : 1,
        ]));

        setup();
        replace_program(ROOM);
}

