#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "武場");
        set("long", @LONG
這里是全真教的演武場，地下的青磚本來鋪的整整齊齊，卻
不知道被誰踩出了几十個大大小小的凹坑。看的出來，這里成年
累月的有弟子修煉掌法步法，天長日久，地下就踩出了凹坑。武
場中央立著几個練功用的木人。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "north" : __DIR__"wuchang1",
                "east" : __DIR__"xiuxishi",
                "southeast" : __DIR__"shantang",
        ]));

        set("objects", ([
                __DIR__"npc/mu-ren" : 5,
        ]));

        setup();
        replace_program(ROOM);
}
