inherit ROOM;

void create()
{
        set("short", "石階");
        set("long", @LONG
這是一條整齊的石板路，依山而建，隨著山勢的曲折蜿蜒曲折。
由于山勢陡了，當初修建這條石階時肯定費了不小的功夫。走到這
里，已經可以看見全真教重陽觀的檐角了。西面好象有一條小路。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "northdown" : __DIR__"shijie8",
                "south" : __DIR__"guanritai",
//                "westdown" : "/d/gumu/caodi2",
        ]));
        set("objects",([
                __DIR__"npc/daotong" : 2,
        ]));

        setup();
}
