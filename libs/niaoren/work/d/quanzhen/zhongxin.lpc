inherit ROOM;

void create()
{
        set("short", "中心廣場");
        set("long", @LONG
這里是武功鎮的中心廣場，武功鎮是個小鎮，只有四條大街--
分別是東街，西街，南街和北街，都在這里匯合。走到這里，路上
的行人多了些，見了你都和和氣氣地拱手為禮。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __DIR__"dongjie",
                "west" : __DIR__"xijie",
                "north" : __DIR__"beijie",
                "south" : __DIR__"nanjie",
        ]));

        set("objects", ([
