inherit ROOM;

void create()
{
        set("short", "密道");
        set("long", @LONG
這里是侯員外臥室下的密道，聽說許多佃戶由于繳不起租，
被侯員外的爪牙抓到這里來拷打。四周好象有一些淺褐色干的血
漬，空氣中夾雜著一種令人毛骨悚然的腥氣。你不由地有些害怕
起來，心想還是趕快離開這里吧。
LONG
        );
        set("exits", ([
                "southeast" : __DIR__"fu-mishi",
        ]));
        set("no_clean_up", 0);
        setup();
}
