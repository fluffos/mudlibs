inherit ROOM;

void create()
{
        set("short", "訪真橋");
        set("long", @LONG
跨過石階，眼前是一座石頭砌成的小小拱橋。橋上欄杆上雕龍描
鳳，栩栩如生。這里的山勢非常陡峻，往下一看，懸崖壁立，腳下白
云飄過，真不知身在何境。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "north" : __DIR__"yuzhengong",
                "southdown" : __DIR__"shijie7",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
