inherit ROOM;

void create()
{
        set("short", "山路");
        set("long", @LONG
這里是山路的盡頭，南面好象有一片小樹林，折而向東，就是終南
山的山腳了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "northwest" : __DIR__"shanlu2",
                "eastup" : __DIR__"shanjiao",
//                "southwest" : "/d/gumu/shulin1",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
