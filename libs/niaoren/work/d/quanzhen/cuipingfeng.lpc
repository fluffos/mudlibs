inherit ROOM;

void create()
{
        set("short", "翠屏峰頂");
        set("long", @LONG
這里是翠屏峰的峰頂。翠屏峰是終南山的第一峰，也是最矮的一
個山峰。懸崖邊建有一個小亭子，你走進亭中憑攔遠望，遠處的山間
白云漂浮繚繞，好象修筑著什么建筑，山景清麗，可惜被白云盡遮住
了。几個游客也在亭中歇腳，正嘖嘖贊美著此地美景。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southdown" : __DIR__"baishulin3",
        ]));
        set("objects",([
                __DIR__"npc/youke" : 2,
        ]));

        setup();
        replace_program(ROOM);
}
