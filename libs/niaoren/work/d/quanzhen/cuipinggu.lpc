// cuipinggu.c 翠屏谷
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "翠屏谷");
        set("long", @LONG
你的面前是一座形如屏風的大山壁，山壁上郁郁蔥蔥都是樹，一
眼看過去，全是一片翠綠色。這就是此地名叫翠屏谷的由來。從這里
繼續北上，就到了終南山上的柏樹林了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "southdown" : __DIR__"shanlu3",
                "northup" : __DIR__"baishulin1",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
