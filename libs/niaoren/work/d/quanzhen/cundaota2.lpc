#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "存道塔二層");
        set("long", @LONG
這里是存道塔的二層，塔梯繞著塔內向塔頂延伸。這里空空如
也，經書也許全被全真弟子們借去閱讀了。
LONG
        );
        set("exits", ([
                "eastup" : __DIR__"cundaota3",
                "eastdown" : __DIR__"cundaota1",
        ]));
        set("no_clean_up", 0);
        setup();
}
