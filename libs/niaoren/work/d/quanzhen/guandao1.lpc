inherit ROOM;

void create()
{
        set("short", "官道");
        set("long", @LONG
這是一條大道，西面通往武功鎮。道上的行人很多，大多是低
著頭自己趕自己的路。忽然在你的身后響起得得的馬蹄聲，不一會
兒，几匹駿馬從你身邊飛馳而過，掠起了一片黃沙。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "west" : __DIR__"guandao2",
                "east" : "/d/city4/road3",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
