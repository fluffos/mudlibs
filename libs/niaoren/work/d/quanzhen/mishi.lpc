inherit ROOM;

void create()
{
        set("short", "密室");
        set("long", @LONG
這里是全真教弟子為了直達中原修建的密室，這里的光線非常
昏暗，也許已經身處地下了。
LONG
        );
        set("exits", ([
                "up" : __DIR__"diziju",
                "eastup" : "/d/city/guangchang",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

