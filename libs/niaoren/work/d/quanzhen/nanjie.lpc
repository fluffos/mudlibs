inherit ROOM;

void create()
{
        set("short", "南街");
        set("long", @LONG
這里是武功的南街，說是街，不過是一條小胡同而已。路上一個
人也沒有。街的盡頭有一扇小門。從這里往北，就是武功鎮的中心了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "north" : __DIR__"zhongxin",
                "southeast" : __DIR__"fu-cemen",
        ]));
        set("no_clean_up", 0);
