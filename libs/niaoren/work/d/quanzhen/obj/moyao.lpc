// moyao.c 沒藥
// By Lgg,1998.10

inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"沒藥"NOR, ({"moyao"}));
        set_weight(500);
        set("unit", "根");
        set("long", "這是一根名貴藥材-沒藥，看來可以入藥。\n");
        setup();
}

int do_eat(string arg)
{
        if (!(arg))  return notify_fail("你要吃什么？\n");
        if(arg=="moyao")
        {
                write("你三口兩口把沒藥吃了下去。\n");
                destruct(this_object());
        }
        return 1;
}
