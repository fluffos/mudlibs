inherit ROOM;

void create()
{
        set("short", "西街");
        set("long", @LONG
武功鎮的西面是貧苦百姓的聚居區，西街比起其他几條街道來也
顯得破朽雜亂得多。街南面是一座年久失修的小廟，已經搖搖欲墜了。
北面是一戶低矮的茅屋，西面是武功的西門。從這里轉而往東，就走
到武功鎮的中心了。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "east" : __DIR__"zhongxin",
                "north" : __DIR__"minju2",
                "south" : __DIR__"xiaomiao",
                "west" : __DIR__"ximen",
        ]));
        set("objects", ([
                __DIR__"npc/punk" : 1,
        ]));

        setup();
}
