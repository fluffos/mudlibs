#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "小花園");
        set("long", @LONG
這里是重陽觀里的小花園，種植著一些叫不出名字來的花木，
園角砌著一座假山，假山下是一潭小小的金魚池，池水清澈見底，
你看見有數條紅色的金魚在里面悠哉游哉地游來游去。几個道童正
在這里嬉戲著。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "west" : __DIR__"xiaohuayuan2",
        ]));

        set("objects", ([
                __DIR__"npc/daotong" : random(2),
        ]));

        setup();
}
