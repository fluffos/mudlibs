inherit ROOM;

void create()
{
        set("short", "終南山腳");
        set("long", @LONG
這里是終南山的山腳，終南山號稱西北的第一山，以山勢奇峻，
環境清幽著稱。這里的山勢還很平緩，一道石階蜿蜒通往山上。面前
是一座高山，如同擎天一柱般插向天空，所以古人的詩句中有‘終南
一柱’的說法。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
//                "northup" : __DIR__"shijie1",
                "north"    : "/d/gumu/shanlu13",
                "westdown" : __DIR__"shanlu4",
        ]));
        set("objects",([
                __DIR__"npc/youke" : 1,
                __DIR__"npc/xiangke" : 2,
        ]));

        setup();
}
