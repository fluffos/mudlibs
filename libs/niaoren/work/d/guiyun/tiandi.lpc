inherit ROOM;

void create()
{
	set("short", "田地");
	set("long", @LONG
這里是一片農田。不遠處有一些村庄，炊煙裊裊升起。村庄周圍
是一塊塊的田地，很有次序的排成一個個井字，田里有一些正在耕作
的農人，過路人貪近路也可以從田間井字分割的小徑穿過。
LONG );
        set("outdoors", "guiyun");
//	set("no_clean_up", 0);
	set("exits", ([
		"northeast"  : __DIR__"shulin5",
		"west"       : __DIR__"yixing",
	]));
	set("objects", ([
		__DIR__"npc/banjiu" : 1,
	]));
	setup();
}
int valid_leave(object me, string dir)
{
	int c_exp,c_skill;
	me = this_player();
	if (dir == "west" )
	{
		me->receive_damage("qi", 10);
		tell_object(me,"你走上田間突起的小土  ，覺的很是狹窄，慢慢的走了進去。\n");
	}
	else
	{
		me->receive_damage("qi", 10);
		message_vision("$N踩著田間的小土  ，慢慢向前走去。\n", me);
	}
	return 1;
}

