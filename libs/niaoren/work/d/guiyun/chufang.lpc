// Room: /guiyun/.c
// Date: Nov.18 1998 by Winder

inherit ROOM;

void create()
{
	set("short", "廚房");
	set("long", @LONG
這里是歸云庄的廚房，一個鄉下婦人正在灶邊忙來忙去，看來
她就是這里的廚娘了。如果肚子餓了，就趕快找廚娘要 (serve)些
吃的吧。
LONG );
	set("no_clean_up", 0);
	set("exits", ([
		"south" : __DIR__"huayuan",
	]));
	set("ricewater", 5);
	setup();
}

void init()
{
        add_action("do_serve","serve");
}

int do_serve()
{
	object me;
	object food;
	object water;
	me=this_player();
	if (me->query("family/family_name") != "桃花島")
		return notify_fail("廚娘道：你不是桃花島弟子，不能拿取食物。\n");
        if(present("zongzi",this_player()) || present("tea",this_player())) 
		return notify_fail("廚娘道：吃完了再拿，別浪費食物。\n");
        if(present("zongzi",this_object()) || present("tea",this_object())) 
		return notify_fail("廚娘道：吃完了再拿，別浪費食物。\n");
	if (query("ricewater")>0)
	{
		message_vision("廚娘連聲答應，給$N一杯香茶和一個粽子。\n",me);
		food=new(__DIR__"obj/zongzi");
		water=new("/d/wudang/obj/xiangcha");
		food->move(me);
		water->move(me);
		add("ricewater",-1);
	}
	else 
		message_vision("廚娘對$N歉聲道: 嗨，吃的喝的都沒了。\n",me);
	return 1; 
}
int valid_leave(object me,string dir)
{
	me=this_player();
        if(dir=="south" && (present("zongzi",this_player()) || present("tea",this_player()))) 
             return notify_fail("廚娘說道：吃了就別帶走。\n");
        return ::valid_leave(me,dir);
}
