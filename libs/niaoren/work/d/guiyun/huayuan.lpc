inherit ROOM;

void create()
{
	set("short", "花園");
	set("long", @LONG
這是一處典型的江南園林，規模雖不大，構造得卻頗為精致，
想必當年建園之人很費了一番心力。園中花氣襲人，鶯啼燕舞，柳
條隨風，綠波蕩漾，只待得片刻便令人如沐春風，流連忘返。
LONG );
        set("outdoors", "guiyun");
//	set("no_clean_up", 0);

	set("exits", ([
		"north" : __DIR__"chufang",
		"south" : __DIR__"huating",
		"east"  : __DIR__"liangong",
	]));
	set("objects", ([
		__DIR__"npc/xiaoju" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "桃花島") && (dir == "east") ) 
		return notify_fail("歸云庄不留外客，你不能往那里走！\n");

	return ::valid_leave(me, dir);
}
