inherit ROOM;

void create()
{
	set("short", "大門");
	set("long", @LONG
面前是一座庄院，門樓不甚高大，青磚綠瓦，灰色底的匾上寫
著『歸云庄』三個大黑字。牌匾較為陳舊，邊角處的漆皮已剝落，
露出暗黃色的木質。看來挂在那已不下二十個春秋了。
LONG );
        set("outdoors", "guiyun");
//	set("no_clean_up", 0);

	set("exits", ([
		"enter" : __DIR__"qianyuan",
		"south" : __DIR__"matou",
	]));
	set("objects", ([
		__DIR__"npc/jiading" : 2,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "桃花島") &&
		!me->query_temp("marks/guiyun") &&
		dir == "enter" &&
		objectp(present("jia ding", environment(me))))
		return notify_fail("家丁做了個揖，說道：尊駕與敝庄素無往來，庄主不見外客，還是請回吧。\n");

	return ::valid_leave(me, dir);
}
