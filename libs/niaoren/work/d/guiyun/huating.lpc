inherit ROOM;

void create()
{
	set("short", "花廳");
	set("long", @LONG
這是一間四方型的廳亭，沒有牌匾，正面兩方木柱，柱上挂了
幅缺了半闕的『詩詞』(poem)。廳內擺設了几張桌椅。一個丫環正
在抹拭桌面。
LONG );
        set("outdoors", "guiyun");
//	set("no_clean_up", 0);

	set("exits", ([
		"north" : __DIR__"huayuan",
		"south" : __DIR__"dating",
		"east"  : __DIR__"nanxiangfang",
		"west"  : __DIR__"nvxiangfang",
	]));
	set("item_desc", ([
		"poem" :
"
      ┌─┐             ┌─┐
      │兵│             │  │
      │火│             │  │
      │有│             │  │
      │餘│             │  │
      │燼│             │  │
      │貧│             │  │
      │村│             │  │
      │才│             │  │
      │數│             │  │
      │家│             │  │
      └─┘             └─┘
",
	]));
	set("objects", ([
		__DIR__"npc/xiaolan" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "桃花島") &&
		(dir == "east" || dir == "west") ) 
		return notify_fail("歸云庄不留外客，你不能住在這里！\n");
	if (me->query("gender") != "男性" && dir == "east") 
		return notify_fail("男女有別，請到對面住！\n");

	if (me->query("gender") != "女性" && dir == "west") 
		return notify_fail("男女有別，請到對面住！\n");

	return ::valid_leave(me, dir);
}
