inherit ROOM;

void create()
{
	set("short", "大廳");
	set("long", @LONG
這是歸云庄的正廳，由于修建年代久遠，看起來已頗為陳舊，
但打掃得十分干淨，光線也較為充足，完全沒有陳年舊宅的陰晦之
氣。四壁挂著一些古人書畫精品，皆為上乘之作，顯得主人眼光不
凡，胸中大有丘壑。
LONG );
//      set("outdoors", "guiyun");
//	set("no_clean_up", 0);

	set("exits", ([
		"north" : __DIR__"huating",
		"south" : __DIR__"qianyuan",
		"east"  : __DIR__"shufang",
	]));
	set("objects", ([
		__DIR__"npc/kezhene" : 1,
		__DIR__"npc/zhucong" : 1,
		__DIR__"npc/hanbaoju" : 1,
		__DIR__"npc/nanxiren" : 1,
		__DIR__"npc/zhangasheng" : 1,
		__DIR__"npc/quanjinfa" : 1,
		__DIR__"npc/hanxiaoyin" : 1,
	]));
	setup();
	replace_program(ROOM);
