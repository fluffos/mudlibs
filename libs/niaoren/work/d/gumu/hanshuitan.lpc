// hanshuitan.c 寒水潭
// Java Oct.10 1998

#include <ansi.h>
inherit ROOM;

int do_qian(string arg);

void create()
{
        set("short", "寒水潭");
        set("long", @LONG
這里是草地的邊緣，青草已經很稀疏了，仍然有一二玉蜂來回地
飛過尋覓食物。你的面前是一個清波蕩漾的大水潭 (tan)，水很清，
隱約可以見過水底的怪石嶙峋，一二游魚倏地從水底游過，又不知道
躲到哪塊石頭后面藏身去了。陽光映照下，水面泛起了一道七色彩虹，
望著這般美景，你俗念盡消。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "northwest" : __DIR__"caodi2",
        ]));

        set("objects", ([
                __DIR__"npc/yufeng" : random(3),
        ]));

        set("item_desc", ([
        "tan": "一口很深的水攤，不知道可不可以潛(qian)下到這水底世界去？\n"
        ]) );

        setup();
        //replace_program(ROOM);
}

void init()
{
        add_action("do_qian", "qian");
}


int do_qian(string arg)
{
        object me=this_player();

        if( !arg || arg != "tan" ) {
                return notify_fail("你要往哪里潛水？\n");
        }

        message_vision(HIG"$N縱身一躍，跳入水攤之中，許多游魚從你身邊游過，
你伸手一撈，\n"NOR,this_player());
        message_vision(HIG"卻抓了空。突然$N眼前一亮，一股暗流扑面而來，將$N
沖入一個所在。\n"NOR, this_player());

        me->move(__DIR__"mishi1");

        return 1;
}

