// shulin7.c 樹林
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "樹林");
        set("long", @LONG
這位於終南山間的一大片樹林，生的頗為茂密。走在其間，只聽
得腳下沙沙的落葉聲，四周昏昏暗暗的，不時几道日光穿過濃密的枝
頭，投射而下。偶而遠處几聲獸吼聲，更添了一份神密感。往北、南、
和東各有一條小徑。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "south"    : __DIR__"shenheyuan",
                "northup"  : __DIR__"juyan",
                "eastdown" : __DIR__"heifengdong",
        ]));

        setup();
}
