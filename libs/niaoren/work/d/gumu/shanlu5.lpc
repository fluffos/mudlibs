inherit ROOM;

void create()
{
        set("short", "山路");
        set("long", @LONG
這條山路盤終南山主峰而上，山路貼著石璧鑿出，只容一人可過，
形勢極為險峻。往遠處望去。群山環繞，列於腳下，百里美景盡收眼
底，頓時令人豪氣陡聲，想要長嘯一聲。往南下和西上各是一條山路。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "westup"     : __DIR__"shanlu4",
                "southdown"  : __DIR__"shanlu6",
        ]));

        setup();
        replace_program(ROOM);
}
