inherit ROOM;

void create()
{
        set("short", "重陽宮大門");
        set("long", @LONG
你已走到了終南山半山腰，前面就是全真教的總部重陽宮了。殿
宇依山而筑，高低錯落有致。周圍古木森森，翠竹成林，景色清幽。
正前方黃牆碧瓦，飛檐翹檁，正中一道二丈來寬，三丈來高的朱紅杉
木包銅大門(door)。上方一塊大匾，龍飛鳳舞地書著『重陽宮』三個
大字。南下是廣場。
    全真派暫不開放。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "southdown"   : __DIR__"daxiaochang",
        ]));

        setup();
        replace_program(ROOM);
}
