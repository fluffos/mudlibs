inherit ROOM;

void create()
{
        set("short", "休息室");
        set("long", @LONG
這是間很大的房間，光線非常昏暗。房里沒有什么別的東西，只
有中間放著一張收拾得舒舒服服的大床，床上的被褥也整理得整整潔
潔，看著就讓人想睡覺。
LONG
        );

        set("exits", ([
                "southeast" : __DIR__"xiaowu1",
                "south" : __DIR__"liangong",
                "east" : __DIR__"qianting",
        ]));

        set("sleep_room",1);
        set("no_fight",1);
        set("no_steal",1);

        setup();
}
