// mishi1.c 密室
// Java Oct.10 1998

#include <ansi.h>
inherit ROOM;

int do_ci(string arg);
int do_zhan(string arg);

void create()
{
        set("short", "密室");
        set("long", @LONG
這里是古墓中的密室，四周密不透風，你只能借著牆上昏暗的燈
光來勉強分辨方向。牆是用整塊的青石砌合起來的，接合的甚是完美，
你難以從中找出一絲縫隙。你正在欣賞，突然間發覺牆上似乎有几塊
磚 (brick)高高凸起，與周圍的磚很不和諧。
LONG
        );

        set("exits", ([
                "up" : __DIR__"hanshuitan",
        ]));

        set("item_desc", ([
        "brick": "几塊普通的青磚，看不出有什么特別的。\n",
        ]) );

        //set("getbook",1);

        setup();
        //replace_program(ROOM);
}

void init()
{
        add_action("do_ci", "ci");
        add_action("do_zhan", "zhan");
}


int do_ci(string arg)
{
        object me=this_player();
        object weapon;

        if( !arg || arg != "brick" ) {
                return notify_fail("你要刺什么？\n");
        }

        if (!objectp(weapon = me->query_temp("weapon")))
                return notify_fail("要刺牆不用家伙恐怕不行吧！\n");

        message_vision("$N拔出兵刃，向青磚輕輕刺去，只聽得空空作聲，青磚的另一頭\n",this_player());
        message_vision("仿佛是空的。\n", this_player());

        me->set_temp("tmarks/磚",1);
        return 1;
}

int do_zhan(string arg)
{
        object me=this_player();

        if( !arg || arg != "brick" || me->query_temp("tmarks/磚",1)<1) {
                return notify_fail("你要粘住什么？\n");
        }

        message_vision("$N雙手緊貼青磚，使個‘粘’字訣，輕輕巧巧地將這塊青磚粘了\n", this_player());
        message_vision("出來。如此沒粘到几塊磚，牆壁上就現出了一個大洞。\n",this_player());
        set("exits/down",__DIR__"houting");

        remove_call_out("close");
        call_out("close", 5, this_object());

        me->set_temp("tmarks/磚",0);
        return 1;

}

void close(object room)
{
        message("vision","過不多一會兒，梁上落下几塊青磚，又將牆上的洞遮住了。\n", room);
        room->delete("exits/down");
}

