// xiaoting.c 小廳
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "小廳");
        set("long", @LONG
這里是一個小小的廳堂，也許是為了連接前廳與正廳用的。你走
到這里，周圍的光線亮了一些，你發覺壁上燃點著一些油燈。廳里的
布置整潔而不簡陋，一桌一椅都收拾的井井有條。
LONG
        );

        set("exits", ([
                "south" : __DIR__"zhengting",
                "north" : __DIR__"qianting",
                "west" : __DIR__"xiaowu1",
                "east" : __DIR__"xiaowu2",
        ]));

        setup();
}
