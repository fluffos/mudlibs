// zhengting.c 正廳
// Java Oct.10 1998

#include <ansi.h>
inherit ROOM;

int do_sleep(string arg);

void create()
{
        set("short", "正廳");
        set("long", @LONG
這里是古墓的正廳，本來應該停放靈柩棺木之類的東西，卻不知
道被人般到哪里去了。廳正中端坐著一位白衣少女，廳角上擺放著一
張石頭做成的大床(chuang)，廳中橫系著一條繩子，不知道做什么用
的，除此之外，別無擺設。
LONG
        );

        set("exits", ([
                "west" : __DIR__"liangong",
                "north" : __DIR__"xiaoting",
                "south" : __DIR__"houting",
        ]));

        set("objects", ([
                __DIR__"npc/longnv" : 1,
                CLASS_D("gumu") + "/yangguo" : 1,
        ]));
        set("valid_startroom",1);

        set("item_desc", ([
        "chuang": "這是一張用"+HIB"千年寒玉"NOR+"雕成的寒玉床。\n"
        ]) );
        setup();
        replace_program(ROOM);
        "/clone/board/gumu_b"->foo();
}

void init()
{
        add_action("do_sleep", "sleep");
}

int do_sleep(string arg)
{
        object me=this_player();
        int lvl_force, c_exp, c_skill;

        if( !arg || arg == "" ) {
                return notify_fail("你要睡在哪兒？\n");
        }

        lvl_force=(int)me->query_skill("force",1);
        if(lvl_force>150) //force 大于 150
                {
                message_vision("$N躺上了寒玉床，開始潛運內功，使內息遍行大小周天。\n",this_player());
                if (random(20)>12) {
                        message_vision("$N調息完畢，只覺得精神健旺，內息充沛欲奔騰而出。\n", this_player());
                        c_exp=me->query("combat_exp");
                        c_skill=me->query_skill("force",1);
                        if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill<250))
                        {
                                me->improve_skill("force", random(lvl_force));
                        }
                        me->receive_damage("qi",random(lvl_force/3));
                }
                else
                        message_vision("$N調息完畢，站起身來，提了提內力，好象沒什么長進。\n", this_player());
                }
        else
                message_vision("$N躺上寒玉床，只覺得冰冷刺骨，‘啊’的一聲狼狽不堪地跳了起來。\n", this_player());
        return 1;
}
