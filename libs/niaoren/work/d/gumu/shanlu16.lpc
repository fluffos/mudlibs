inherit ROOM;

void create()
{
        set("short", "山間小徑");
        set("long", @LONG
這是一條位於終南山腳，鮮為人知的小徑。四周古木三天，樹林
蒼翠，遍地山花，枝頭啼鳥唱和不絕。往南可看到一條小河。往東
可通往山林深處。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "east"  : __DIR__"shanlu15",
                "south" : __DIR__"xiaohebian",
        ]));

        setup();
}
