inherit ROOM;

void create()
{
        set("short", "老嫗岩");
        set("long", @LONG
一路過來，山路是越來越險。只見一塊大岩石擋在路中，自空憑
臨，宛似一個老婦彎腰俯視，但形狀陰森可怖，令人望而生畏。不少
游客在此駐足觀看，往南是一片茂密的松林。往北上是一條陡峭的山
路。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "northup"    : __DIR__"shanlu8",
                "southdown"  : __DIR__"shulin7",
        ]));
        set("objects", ([
                "/d/quanzhen/npc/ji": 1,
        ]));

        setup();
}
