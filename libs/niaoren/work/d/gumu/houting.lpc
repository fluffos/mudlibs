// houting.c 后廳
// Java Oct.10 1998

#include <ansi.h>
inherit ROOM;

int do_tang(string arg);
int do_niu(string arg);

void create()
{
        set("short", "后廳");
        set("long", @LONG
這里是古墓的后廳，密封得嚴嚴實實，沒有一絲的縫隙。在昏暗
的燈光下，你發現牆上懸挂著一幅畫 (picture)，似乎是一幅人物的
肖像。在廳的中央，擺放著几具棺材(coffin)，其中只有一具棺材的
棺板沒有合上，棺材中好象空空如也。
LONG
        );

        set("exits", ([
                "north" : __DIR__"zhengting",
        ]));

        set("item_desc", ([
        "picture": "畫中是一個中年道士的背影，看不出什么相貌，畫中人一手指天，畫
角題著‘"+MAG"活死人像"NOR+"’几個大字。\n",
        "coffin": "用厚厚的石板做成的棺材，棺板合上后，就沒有一絲的縫隙了。\n"
        ]) );

        set("getbook",1);

        setup();
        //replace_program(ROOM);
}

void init()
{
        add_action("do_tang", "tang");
        add_action("do_niu", "niu");
}

int do_tang(string arg)
{
        object me=this_player();
        object ob;

        if( !arg || arg != "coffin" ) {
                return notify_fail("你要躺在哪兒？\n");
        }

        if (query("getbook")>0) {
        message_vision("$N躺進棺材中，把棺板合上，頓時一片黑暗，似乎與紅塵隔絕了，\n",this_player());
        message_vision("摸索中$N似乎發覺棺板內壁題著有字，細細摸來，好象一頭寫著\n", this_player());
        message_vision("‘"+HIW"玉女心經，技壓全真﹔重陽一生，不輸與人"NOR+"’這樣十六個大字，\n", this_player());
        message_vision("另一頭好象是一些圖形之類的符號。$N不知所以，心想管他的先\n", this_player());
        message_vision("拓下來再說，于是脫下身上布衫，細細地將板上文字全部拓了下\n", this_player());
        message_vision("來。正在拓字之間，似乎摸到棺角上有一塊凸起的機關(lock)。\n", this_player());

        if (random(21)>10)
                ob=new("/clone/book/jiuyin2");
        else
                ob=new("/clone/book/jiuyin1");
        ob->move(me);
        add("getbook",-1);
        }
        else {
        message_vision("$N躺進棺材中，把棺板合上，頓時一片黑暗，似乎與紅塵隔絕，\n",this_player());
        message_vision("摸索中$N似乎發覺棺板內壁以前刻著有字，不過這字跡已經被人\n", this_player());
        message_vision("故意刮掉了。突然間，似乎摸到棺角上有一塊凸起的機關(lock)。\n", this_player());
        }

        me->set_temp("tmarks/棺",1);
        return 1;
}

int do_niu(string arg)
{
        object me=this_player();

        if( !arg || arg != "lock" || me->query_temp("tmarks/棺",1)<1) {
                return notify_fail("你要扭動什么？\n");
        }

        message_vision("$N手握機關，輕輕向下扭動，忽然間棺底吱吱作響，裂開了一個
\n",this_player());
        message_vision("大洞，$N向洞中落了下去。\n", this_player());
        me->move(__DIR__"mishi2");

        me->set_temp("tmarks/棺",0);
        return 1;

}

