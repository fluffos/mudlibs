// liangong.c 練功室
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "練功室");
        set("long", @LONG
這座石室形狀甚是奇特，前窄後寬，成為梯形，東邊半圓，西邊
卻作三角形狀，原來這是以前重陽祖師的練功室，前窄練掌，後寬使
拳，東圓研劍，西角發鏢。
LONG
        );

        set("exits", ([
                "east" : __DIR__"liangong",
        ]));
        set("objects", ([
                  "/d/shaolin/npc/mu-ren" : 10,
        ]));

        setup();
        replace_program(ROOM);
}
