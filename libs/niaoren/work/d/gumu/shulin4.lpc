// shulin4.c 樹林
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "小樹林");
        set("long", @LONG
走在林中，你只聞錚錚琴聲，一股淡淡白煙，帶著極甜的花香，
自密林深處傳出。一群乳白色的蜜蜂在你身旁飛來飛去。不論往哪ㄦ
走盡是茂密的樹林。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "north"  : __DIR__"kongdi",
                "south"  : __DIR__"shulin0",
                "east"   : __DIR__"shulin6",
                "west"   : __DIR__"shulin5",
        ]));

        setup();
        replace_program(ROOM);
}
