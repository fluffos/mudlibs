// caodi2.c 草地
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "草地");
        set("long", @LONG
這里是一片草地，草很深，几乎淹沒了小腿。草間散布著一些奇
花，微風吹過，芬芳扑鼻。你聽到時而有“嗡嗡嗡”的聲音，看見有
一些個頭奇大的白色的蜜蜂在草地上飛舞盤旋。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
                "west" : __DIR__"caodi",
                "southeast" : __DIR__"hanshuitan",
        ]));

        set("objects", ([
                __DIR__"npc/yufeng" : random(3),
        ]));

        setup();
        replace_program(ROOM);
}
