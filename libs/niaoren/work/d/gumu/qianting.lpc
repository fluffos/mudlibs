// qianting.c 前廳
// Java Oct.10 1998

inherit ROOM;

void create()
{
        set("short", "前廳");
        set("long", @LONG
這里是古墓的前廳，黑黝黝的，你几乎什么也看不清。全靠大廳
正中間的梁上懸挂著一顆夜明珠，映射出淡淡的黃光。廳柱都是由碩
大的石柱砌成的，上面似乎還寫著一些什么字--你怎么也看不清楚了。
LONG
        );

        set("exits", ([
                "south" : __DIR__"xiaoting",
                "north" : __DIR__"mumen",
                "west" : __DIR__"xiuxishi",
        ]));

        setup();
        replace_program(ROOM);
}
