#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
        set("short", "桃花迷陣");
        set("long",@LONG
這是一片桃花的海洋。四周一望無際，全是盛開的桃花。微風拂過，
落英繽紛。周圍靜悄悄的。遠處偶爾傳來一聲鳥叫。往北是一片桃
花林，往南則是一個小亭子。
LONG );
       set("exits", ([
           "south" : __DIR__"tingzi",
           "north" : __DIR__"tao0",
       ]));
       set("outdoors","taohua");
       set("no_clean_up", 0);
       setup();
}
void init()
{       object ob;
        mapping myfam;
        if( interactive( ob = this_player()))
        if(query("exits/north")) 
        if ((int)ob->query_skill("qimen-wuxing",1) >= 100 )
        {
            delete("exits/north");
            set("exits/north", __DIR__"tao_in");
            return ;
        }
        myfam = (mapping)ob->query("family");
        if(myfam && myfam["family_name"] == "桃花島")
        {
            delete("exits/north");
            set("exits/north", __DIR__"tao_in");
            return ;
        }       
  	delete("exits/north");
        set("exits/north", __DIR__"tao0");
}
