#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "桃花山庄正廳");
    set("long", 
"這里是桃花山庄的正廳。整個大廳十分寬闊。廳中挂滿了各種\n"
"名家的書法真跡。但最顯眼的則是正中挂的一幅對聯：\n\n"
   
BLU "            桃花影落飛神劍\n"
    "            碧海潮生按玉簫\n\n"
NOR

"字體遒勁挺拔，氣勢宏偉。\n"
);
	set("exits", ([
	    "north" : __DIR__"qianyuan",
	    "south" : __DIR__"houyuan",
	    "east"  : __DIR__"daojufang",
	    "west"  : __DIR__"wofang" ,
	]));
	set("objects", ([
	    "/kungfu/class/taohua/huang" : 1,
	]) );    
	set("valid_startroom", 1);
//	set("no_clean_up", 0);
	set("no_beg", "1");
	setup();
	 "/clone/board/taohua_b"->foo();	
	replace_program(ROOM);
}
