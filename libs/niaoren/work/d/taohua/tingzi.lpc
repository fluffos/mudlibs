inherit ROOM;

void create()
{
    set("short", "試劍亭");
    set("long",@LONG
這里是一個用白玉石砌成的亭子，亭子砌得小巧玲瓏，十分精巧。
亭子的北面是一片桃花林，南面則是桃花山庄的正門。
LONG);
    set("exits", ([
        "south" : __DIR__"damen",
        "north" : __DIR__"tao_out",
    ]));
    set("outdoors", "taohua");
    set("no_clean_up", 0);
    setup();
    replace_program(ROOM);
}
