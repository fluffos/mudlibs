// Room: xiuxishi.c

inherit ROOM;

void init();
void close_men();
int do_open(string);
int do_close(string);


void create()
{
        set("short", "桃花軒");
        set("long", @LONG
這是間整潔的廂房，因門窗常閉著，光線很昏暗。房里別無他物，
只有中間放著一張收拾得舒舒服服的大床，看著就讓人想睡覺。
LONG );
        set("sleep_room", 1);
        set("no_fight", 1);
        set("no_clean_up", 0);
        setup();
}

void init()
{
	add_action("do_open", "open");
	add_action("do_close", "close");
}

void close_men()
{
	object room;

	if(!( room = find_object(__DIR__"siguoshi")) )
		room = load_object(__DIR__"siguoshi");
	if(objectp(room))
	{
		delete("exits/west");
			message("vision", "門咿咿呀呀地自己合上了。\n", this_object());
		room->delete("exits/east");
		message("vision", "門咿咿呀呀地自己合上了。\n", room);
	}
}

int do_close(string arg)
{
	if (!query("exits/west"))
		return notify_fail("門已經是關著的了。\n");

	if (!arg || (arg != "men" && arg != "door"))
		return notify_fail("你要關什么？\n");

	message_vision("$N想把門關上。\n", this_player());

	remove_call_out("close_men");
	call_out("close_men", 2);

	return 1;
}

int do_open(string arg)
{
	object room;
	object me = this_player();

	if (query("exits/west"))
		return notify_fail("大門已經是開著了。\n");

	if (!arg || (arg != "men" && arg != "door" && arg != "west"))
		return notify_fail("你要開什么？\n");

	if(!( room = find_object(__DIR__"siguoshi")) )
		room = load_object(__DIR__"siguoshi");
	if(objectp(room))
	{
		set("exits/west", __DIR__"siguoshi");
		message_vision("$N輕手輕腳地把門打開。\n", this_player());
		room->set("exits/east", __FILE__);
		
		if (me->query_temp("sleeped"))
		{
		message("vision", "吱地一聲，"+me->query("name")+"精神煥發地從里面把門打開了。\n",
		room);
		} else 
		{
		message("vision", "梆地一聲，"+me->query("name")+"從里面把門打開，一臉的不耐煩。\n",
			 room);
		}	
		
		remove_call_out("close_men");
		call_out("close_men", 10);
	}

	return 1;
}


int valid_leave(object me, string dir)
{
	object room;

	if ( !::valid_leave(me, dir) ) 
		return 0;
	
	if(!(room = find_object(__FILE__)) )
		room = load_object(__FILE__);
	if(objectp(room))
	{
		room->add_temp("person_inside", -1);	
		if ((int)room->add_temp("person_inside", -1) <= 0)
			room->delete_temp("person_inside");	
	}
	
	return 1;
}
