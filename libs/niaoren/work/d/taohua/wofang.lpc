
#include <room.h>
inherit ROOM;

void create()
{
    set("short", "臥房");
	set("long", @LONG
你走進了一間臥房。一股若有若無的甜香扑鼻而來。琴劍書畫，
挂在牆上。錦籠紗罩，金彩珠光。小几上汝窯美人瓶內的桃花正自盛
開。右首一張床，床頭放著五彩鸞紋被。
LONG );
    set("exits", ([
        "east" :__DIR__"dating",
    ]));
    set("objects", ([
        CLASS_D("taohua")+"/rong" : 1,
        __DIR__"npc/binu" : 2,
    ]) );
//    set("no_clean_up", 0);
    setup();
}
