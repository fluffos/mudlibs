// /kungfu/class/luchenfeng
// adx 4:16 99-2-12
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me(string name);

void create()
{
        set_name("陸乘風", ({ "lu chengfeng", "lu", "chengfeng" }));
        set("long", "他是黃藥師的弟子，雙腿齊膝而斷，面目慈善，象是一位員外。\n");
        set("title",WHT "歸云庄庄主" NOR);  
        set("gender", "男性");
        set("age", 37);
        set("attitude", "peaceful");
        set("str", 30);
        set("dex", 32);
        set("con", 17);
        set("int", 25);
        set("shen_type", 1);

        create_family("桃花島", 2, "弟子");

        set_skill("force", 220);
        set_skill("bibo-shengong", 220);
        set_skill("dodge", 160);
        set_skill("anying-fuxiang", 160);
        set_skill("parry", 220);
        set_skill("sword", 220);
        set_skill("luoying-shenjian",230);
        set_skill("unarmed",230);
        set_skill("luoying-zhang",230);
        set_skill("finger",180);
        set_skill("tanzhi-shentong",180);
        set_skill("qimen-wuxing",250);
        set_skill("literate",250);

        map_skill("force"  , "bibo-shengong");
        map_skill("unarmed" , "luoying-zhang");
        map_skill("dodge"  , "anying-fuxiang");
        map_skill("parry"  , "luoying-shenjian");
        map_skill("sword"  , "luoying-shenjian");
        map_skill("finger"  , "tanzhi-shentong");

        set("jiali",150);

        set("combat_exp", 2200000);

        set("max_qi", 4000);
        set("max_jing", 1000);
        set("neili", 8000);
        set("max_neili", 8000);

        set("inquiry", ([
        "黃藥師" : "大膽，你敢直呼我師父的名謂",
       "桃花島" : "哪是我師父的駐地，遠在海外",
        "黃島主" :   (: ask_me, "qingjian" :),
        "請柬" :   (: ask_me, "qingjian" :),
        "歸云庄" : "這是桃花島弟子在中原的落腳點。",
        ]));

        set("foor_count", 2);

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "finger.ta1" :),
                (: perform_action, "finger.ta2" :),
                (: perform_action, "strike.xu1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
                (: exert_function, "p" :),
        }) );
        setup();
        carry_object("/kungfu/class/taohua/obj/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 25) {
        command("say 我不收資質差的弟子，您請回吧！");
                return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 100 ) {
        command("say 你的本門內功心法太低了,還是努努力先提高一下吧!");
                return;
    }
    if ((int)ob->query("shen") < 10000 ) {
        command("say 你多行不義，還是多多行俠仗義，日后在來吧！");
                return;
        }
    command("say 好吧，今后你要群奮練功，光大本門。");
    command("recruit " + ob->query("id"));
}
string ask_me(string name)
{
        mapping fam; 
        object ob;

        if (  present(name, this_player()) )
                return RANK_D->query_respect(this_player()) + 
                "你現在身上不是有嗎，憑"+HIR"請柬"NOR+"可以自由出入桃花島！";

        if (query("foor_count") < 1)
                return "抱歉，你來得不是時候，我師父現在不會客。";

        ob = new("/d/taohua/obj/" + name);
        ob->move(this_player());

        add("foor_count", -1);

        message_vision(YEL"陸乘風給$N一個" + ob->query("name") + "。\n"NOR, this_player());

        return "給，憑此"+HIR"請柬"NOR+"你可以去拜會我師父，有效期一日，期滿請速速離開。";
}
