#include <ansi.h>

inherit NPC;

int do_look(string var);
int ask_me();

void consider();

void create()
{
	set_name("梅超風", ({ "mei chaofeng", "mei", "chaofeng" }));
	set("long", "她是一個盲了雙眼的中年婦人，面目猙獰，好似有什么n"+
            "深仇大恨。\n");
	set("nickname",HIW"黑風雙煞"+HIB "鐵尸" NOR);
	set("gender", "女性");
	set("age", 37);
        set("attitude", "peaceful");
	set("str", 30);
	set("dex", 32);
	set("con", 17);
	set("int", 25);
        set("shen_type", -1);

        create_family("桃花島", 2, "弟子");

	set_skill("force", 180);
        set_skill("bibo-shengong", 180);
        set_skill("dodge", 250);
        set_skill("anying-fuxiang", 250);
        set_skill("parry", 230);
	set_skill("sword", 160);
	set_skill("luoying-shenjian",160);
	set_skill("luoying-zhang",160);
        set_skill("unarmed",170);
        set_skill("jiuyin-baiguzhao",200);
        set_skill("finger",150);
	set_skill("tanzhi-shentong",150);
	set_skill("qimen-wuxing",200);
	set_skill("literate",200);

        map_skill("force"  , "bibo-shengong");
        map_skill("unarmed"   , "jiuyin-baiguzhao");
        map_skill("dodge"  , "anying-fuxiang");
        map_skill("parry"  , "jiuyin-baiguzhao");
        map_skill("finger"  , "tanzhi-shentong");

	set("jiali",150);

	set("combat_exp", 2200000);

	set("max_qi", 4000);
	set("max_jing", 1000);
	set("neili", 8000);
	set("max_neili", 8000);

	set("inquiry", ([
	    "name" : "站遠點！",
	    "陳玄風" : "你問我的賊漢子做什么？",
	    "九陰真經" : (: ask_me :),
            "黑風雙煞" : "那是我和我的賊漢子的名號，你也聽說過？",
       ]) );

	set("chat_chance", 10);
	set("chat_msg", ({
	    "梅超風幽幽地嘆了一口氣：「不知道江湖上的人是否還記得我們夫妻？」\n",
	    "梅超風說道：「當年我和我的賊漢子是何等的威風！」\n",
	     }) );

    set("chat_chance_combat", 40);
    set("chat_msg_combat", ({
                (: perform_action, "finger.ta1" :),
                (: perform_action, "finger.ta2" :),
                (: perform_action, "unarmed.ji1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
                (: exert_function, "p" :),
        }) );
	setup();
	carry_object("/d/taohua/obj/cloth")->wear();
	
}


int ask_me()
{
	object me;

	me = this_player();
	   message("vision",
   HIY "梅超風冷笑一聲：『我這就帶你去找。』\n"
       "梅超風決心殺死" + me->name() +"\n"
   NOR, environment(), this_object() );
		   kill_ob(this_player());
   return 1;
}
void init()
{
	object me, ob;
	mapping fam;

	::init();

	ob = this_player();
	me = this_object();
	
	if (interactive(ob) 
	&& !environment(ob)->query("no_fight")
	&& !present("qingjian", ob) 
	&& ( (fam = ob->query("family")) && fam["family_name"] != "桃花島" ) )
	{
		if( !ob->query_temp("warned") ) {
			command("say 你是誰？  怎么闖到桃花島里來了？速速離開！");
			command("say 師父有令：外人不得擅自上島！");
			ob->set_temp("warned", 1);
		}
		else if( ob->query_temp("stay") < 3 ) ob->add_temp("stay", 1);
		else {
			command("say 大膽狂徒，竟敢擅闖桃花島！！！\n");
			me->set_leader(ob);
			remove_call_out("kill_ob");
			call_out("kill_ob", 1, ob); 
		}
	}
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 30) {
        command("say 我不收資質差的弟子，您請回吧！");
		return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 100 ) {
        command("say 你的本門內功心法太低了,還是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query ("shen") > -10000 ) {
        command("say 你辦事不夠狠毒果斷，你還是到江湖上多歷練吧！");
		return;
	}
    command("say 好吧，今后你要群奮練功，光大本門。");
    command("recruit " + ob->query("id"));
}
