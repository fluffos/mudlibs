#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("黃藥師", ({"huang yaoshi", "huang", "yaoshi"}));
	set("nickname", HIY "東邪" NOR );
	set("gender", "男性");
	set("age", 42);
	set("long", 
        "他就是桃花島主。行事好惡全由己心，因此被人稱作「東邪」。\n");
	set("attitude", "peaceful");
	
	set("str", 21);
	set("int", 30);
	set("con", 26);
	set("dex", 30);

	set("chat_chance", 1);
	set("chat_msg", ({
        "黃藥師嘆了口氣道：“唉 …… 蓉兒這苦命的孩子，從小就沒了娘 ……”\n",
        "黃藥師低頭沉思，悠然不語。\n",
}));
	set("inquiry", ([
        "黃蓉"     : "蓉兒可會作菜了，最拿手的就是“玉笛誰家聽落梅”。 \n",
        "九陰真經" : "我把九陰真經藏在一個極秘密的地方。\n",
]));

	set("qi", 8000);
	set("max_qi", 8000);
	set("jing", 4000);
	set("max_jing", 4000);
	set("neili", 7000);
	set("max_neili", 7000);
	set("jiali", 200);
	
	set("combat_exp", 5000000);
	set("score", 100);
	 
	set_skill("force", 300);
	set_skill("bibo-shengong", 400);
	set_skill("finger", 340);
	set_skill("tanzhi-shentong", 340);
	set_skill("unarmed", 250);
	set_skill("luoying-zhang", 250);
	set_skill("dodge", 300);
	set_skill("anying-fuxiang", 250);
	set_skill("parry", 300);
	set_skill("sword", 400);
	set_skill("luoying-shenjian", 400);
	set_skill("yuxiao-jianfa", 350);
	set_skill("cuixin-zhang", 300);
	set_skill("qimen-wuxing",300);
	set_skill("literate",300);
	
	map_skill("force"  , "bibo-shengong");
	map_skill("finger" , "tanzhi-shentong");
	map_skill("unarmed", "cuixin-zhang");
	map_skill("dodge"  , "anying-fuxiang");
	map_skill("parry"  , "yuxiao-jianfa");
	map_skill("sword"  , "yuxiao-jianfa");
	
	create_family("桃花島", 1, "島主");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.yu1" :),
                (: perform_action, "finger.ta1" :),
                (: perform_action, "finger.ta2" :),
                (: perform_action, "unarmed.cu1" :),
                (: exert_function, "re1" :),
                (: exert_function, "r" :),
                (: exert_function, "p" :),
        }) );
	setup();
	
	carry_object("/d/taohua/obj/yuxiao")->wield();
	carry_object("/d/taohua/obj/bupao")->wear();
    
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 30) {
        command("say 我不收資質差的弟子，您請回吧！");
		return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 200 ) {
        command("say 你的本門內功心法太低了,還是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我桃花島與世隔絕，你在江湖上已經成名，何必留在桃花島！");
		return;
	}
    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}
