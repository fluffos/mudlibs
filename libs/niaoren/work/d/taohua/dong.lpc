#include <ansi.h>
inherit ROOM;
 
int do_pick(string arg) ;

void create()
{
        set("short", "山洞");
        set("long",@LONG
你正處在一個小山洞中。這里光線很暗，只能隱隱約約看出地上有一堆
干草。干草上好象放著一個石匣(xia)。 你突然聞到一股難聞的氣味，顯然
是有人長期住在這里卻不打掃的緣故。
LONG);   
        set("item_desc", ([
        "xia" : @TEXT
你仔細看了一下石匣，發現里面似乎放著一本書，似乎可以試著拿出來(pick book)。
TEXT ]) );
        set("exits", ([
            "out"  : __DIR__"road5",
        ]));
        set("objects", ([
            __DIR__"npc/zhou" : 1,
        ]) );    
//	set("no_clean_up", 0);
        setup();
}
void init()
{
        add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="book" )
              return notify_fail("你要拿什么?\n");
       if ( present("zhou botong",environment(me)))
        
       {
              message_vision(YEL"周伯通兩眼一瞪，哼了一聲道：別在我這里偷偷摸摸！"
                       "我周伯通還沒死哪！\n" NOR,me) ;
              return 1 ;
       }
       if ( query("get_available") )  {
              obj = new ("/clone/book/jiuyin1");
              obj->move(me);
              add("get_available", -1);
              message_vision("$N從石匣中取出一本書。\n",me );
message("channel:rumor", MAG"【謠言】某人："+this_player()->query("name")+"拿到九陰真經上卷啦。\n"NOR, users());
       }
       else
              return notify_fail("你要拿起那本書，卻發現你看花了眼，其實那里什么都沒有。\n");
       return 1;
}

