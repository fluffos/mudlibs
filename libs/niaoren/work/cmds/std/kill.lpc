// kill.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj;
	string *killer, callname;
	if(me->query_temp("biwu")) return notify_fail("此命令比武期間禁止使用！\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("這里不准戰斗。\n");

	if( !arg )
		return notify_fail("你想殺誰？\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("這里沒有這個人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一點，那并不是活物。\n");

	if(obj==me)
		return notify_fail("用 suicide 指令會比較快:P。\n");

	if((int)obj->query("age") <= 15 && userp(obj))
		return notify_fail("為了世界更美好，放過小孩子吧.\n");

	callname = RANK_D->query_rude(obj);

	message_vision("\n$N對著$n喝道：「" 
		+ callname + "！今日不是你死就是我活！」\n\n", me, obj);

	me->kill_ob(obj);
	// Add by jungu             
	if ( userp(obj))
	write_file("/log/nosave/ATTEMP_KILL",sprintf("%s   試圖殺死   %s on %s\n",
        me->name(1),obj->name(1), ctime(time()) ));
	// Look for PKS 
	if( !userp(obj) )
		obj->kill_ob(me);
	else {
		obj->fight_ob(me);
		tell_object(obj, HIR "如果你要和" + me->name() 
			+ "性命相搏，請你也對這個人下一次 kill 指令。\n" NOR);
	}

	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : kill <人物>
 
這個指令讓你主動開始攻擊一個人物，并且試圖殺死對方，kill 和 fight 最大的
不同在於雙方將會真刀實槍地打斗，也就是說，會真的受傷。由於 kill 只需單方
面一廂情愿就可以成立，因此你對任何人使用 kill 指令都會開始戰斗，通常如果
對方是 NPC 的話，他們也會同樣對你使用 kill。

當有人對你使用 kill 指令時會出現紅色的字樣警告你，對於一個玩家而言，如果
你沒有對一名敵人使用過 kill 指令，就不會將對方真的打傷或殺死( 使用法朮除
外)。

其他相關指令: hit, fight

有關 fight 跟 kill 的區分請看 'help combat'.
HELP
    );
    return 1;
}
 
