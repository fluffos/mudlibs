//setwmsg.c
// SetWeaponMsg
//Creat by ZCooker 97.12.6

#include <ansi.h>

inherit F_CLEAN_UP;

string creat_info(string msg1,int flag);
//flag is a variable to say which should be returned
int help();

int main(object me, string info)
{
        string msg,command,msg1;
        object weapon;
        if( !info ) return help();
        if (strsrch(info, "$N") < 0)
                return notify_fail("描述裡要有$N表示你自己！\n");
        if (strsrch(info, "$WEAPON$") < 0)
                return notify_fail("描述裡要帶$WEAPON$表示你的兵器！\n");
        if (strsrch(info, "【") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "】") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "仙子") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "風兒") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "巫師") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "天神") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "告訴") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if (strsrch(info, "回答") > 0)
                return notify_fail("描述裡出現了非法字符！\n");
        if( !(me->query("weapon/make")))
                return notify_fail("你沒有自製的兵器！\n");
        weapon = present( (me->query("weapon/id")), me );
        if( !objectp(weapon))
                return notify_fail("你的兵器不在身邊！\n");
        sscanf(info ,"%s %s" ,command ,msg1);
        switch(command)
        {
                case "-w":
                        msg = creat_info(msg1,1);
                        me->set("weapon/wield_msg",msg);
                        weapon->set("wield_msg",msg+"\n");
                        break;
                case "-u":
                        msg = creat_info(msg1,1);
                        me->set("weapon/unwield_msg",msg);
                        weapon->set("unwield_msg",msg+"\n");
                        break;
                default :
                        return notify_fail("描述設置失敗，請選擇具體參數。詳細請
看幫助文件。\n");
        }
        write("Ok.\n");
        return 1;
}

string creat_info(string msg1,int flag)
{
        string w_name,name;
        int w_lv,color;
        w_lv = this_player()->query("weapon/lv");
        w_name = this_player()->query("weapon/name");
        color = (w_lv/10);
        color = w_lv - color*10;
        switch(color){
                case 1:
                case 2:
                        name = HIR + w_name + NOR;
                        break;
                case 3:
                case 4:
                        name = HIG + w_name + NOR;
                        break;
                case 5:
                case 6:
                        name = HIY + w_name + NOR;
                        break;
                case 7:
                case 8:
                        name = HIB + w_name + NOR;
                        break;
                case 9:
                        name = HIM + w_name + NOR;
                        break;
                case 0:
                        name = HIC + w_name + NOR;
                        break;
        }
        if ( flag==2 )
                return name;
        msg1 = replace_string(msg1, "$WEAPON$",name);
        msg1 = replace_string(msg1, "$BLK$", BLK);
        msg1 = replace_string(msg1, "$RED$", RED);
        msg1 = replace_string(msg1, "$GRN$", GRN);
        msg1 = replace_string(msg1, "$YEL$", YEL);
        msg1 = replace_string(msg1, "$BLU$", BLU);
        msg1 = replace_string(msg1, "$MAG$", MAG);
        msg1 = replace_string(msg1, "$CYN$", CYN);
        msg1 = replace_string(msg1, "$WHT$", WHT);
        msg1 = replace_string(msg1, "$HIR$", HIR);
        msg1 = replace_string(msg1, "$HIG$", HIG);
        msg1 = replace_string(msg1, "$HIY$", HIY);
        msg1 = replace_string(msg1, "$HIB$", HIB);
        msg1 = replace_string(msg1, "$HIM$", HIM);
        msg1 = replace_string(msg1, "$HIC$", HIC);
        msg1 = replace_string(msg1, "$HIW$", HIW);
        msg1 = replace_string(msg1, "$NOR$", NOR);
        if ( flag==1)
                return msg1;

}

int help()
{
        string  f=RED+"★"+NOR;
        write(
"指令格式 : setwmsg -w|-u <具體描述>\n"
+"\n"
+f+"這個指令可以讓你為自己的武器加入裝備以及卸下時的描述\n"
+"    語言。\n"
+"    -w : 將後續文字作為兵器裝備時的描述語言。\n"
+"    -u : 將後續文字作為卸下兵器時的描述語言。\n"
+"\n"
+f+"你如果希望在描述中使用 ANSI 的控製字元改變顏色，\n"
+"    可以用以下的控製字串﹕\n"
+"\n"
+"$BLK$ - 黑色    $NOR$ - 正常色   $RED$ - 紅色    $HIR$ - 亮紅色\n"
+"$GRN$ - 綠色    $HIG$ - 亮綠色   $YEL$ - 土黃色  $HIY$ - 黃色\n"
+"$BLU$ - 深藍色  $HIB$ - 藍色     $MAG$ - 淺紫色  $HIM$ - 粉紅色\n"
+"$CYN$ - 藍綠色  $HIC$ - 天青色   $WHT$ - 淺灰色  $HIW$ - 白色\n"
+"其中系統自動會在字串尾端加一個 $NOR$。\n"
+"\n"
+f+"在描寫中使用$N代替自己；使用$WEAPON$代替兵器名稱。\n"
+"\n"
+f+"注意如果在兵器名稱後還有描寫文字那麼需要從新定義顏色\n"
+"  否則按原顏色處理。\n"

        );
        return 1;
}
