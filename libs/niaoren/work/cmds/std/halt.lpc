#include <ansi.h>

int main(object me, string arg)
{
	if (me->is_fighting()) {
		me->remove_all_enemy();
		message_vision("$N身形向后一躍，跳出戰圈不打了。\n", me); 
		if(me->query_temp("biwu")) 
		shout(WHT"【江湖傳聞】"+me->name()+"中途放棄比武！\n" NOR);
	}
	else if (!me->is_busy()) 
		return notify_fail("你現在不忙。\n");
	else if ((int)me->query_temp("pending/exercise") != 0) {
		message_vision("$N把正在運行的真氣強行壓回丹田，站了起來。\n", me);
		me->interrupt_me();
	}
	else if ((int)me->query_temp("pending/respirate") != 0){
		message_vision("$N把正在靈台中運行的先天之氣徐徐吐出，睜眼站了起來。\n", me);
		me->interrupt_me();
	}
	me->interrupt_me();

	return 1;
}
	
