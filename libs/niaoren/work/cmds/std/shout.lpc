// shout.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{	
	    if (!arg) return notify_fail("你想要大叫什么？\n");
	    if ((int)me->query("max_neili") < 300 ) return notify_fail("你的內力不夠\n"); 
	    if ((int)me->query("qi") < 100 ) return notify_fail("你的真氣不足，沒法運氣長嘯。\n");
	    if ((int)me->query("neili") < 150)
		{
	    shout( YEL "" + me->name() + YEL"縱聲長嘯：∼∼∼∼\n"NOR );
	    write(YEL "你縱聲長嘯：∼∼∼∼\n"NOR );
	    write( "由于你的內力不夠，你的聲音沒法聽清楚\n" );
		return 1;
		}
		else 
		{ shout( YEL "" +me->name() +  "縱聲長嘯："  + arg + "\n" NOR);
	    write( YEL"你縱聲長嘯："+arg+"\n" NOR );
		 me->add("neili", -150 );
		}
	 return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : shout <訊息>
 
這個指令讓你將 <訊息> 傳送出去, 所有正在游戲中的人都
會聽見你的話。當然。這是需要一定的內力和氣的。
 
see also : tune
HELP
    );
    return 1;
}
 
