// kill.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj;
	string *killer, callname;
	object *t;
	int i;

	if( environment(me)->query("no_fight") )
		return notify_fail("這里不准戰斗。\n");

	if( !arg )
		return notify_fail("你想殺誰？\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("這里沒有這個人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一點，那并不是活物。\n");

	if(obj==me)
		return notify_fail("用 suicide 指令會比較快:P。\n");

	callname = RANK_D->query_rude(obj);
        t = me->query_team();
	if(sizeof(t) <=1)
	return notify_fail("你現在并沒有參加任何隊伍或隊伍只你一個人。(use kill)\n");
	if( userp(obj) )
		return notify_fail("唉！你可不可以改掉以眾欺寡的惡習？\n");
	for(i=0;i<sizeof(t);i++)
	if( t[i])
	if( environment(me) != environment(t[i]))
		return notify_fail("隊員不都在場。(use kill)\n");		
	message_vision("\n$N對著$n喝道：「" 
		+ callname + "！今日不是你死就是我們活！」\n\n", me, obj);
        for(i=0;i<sizeof(t);i++)
	{
	if(t[i]){
		t[i]->set_temp("ttarget",obj->query("id"));
		t[i]->kill_ob(obj);
		obj->kill_ob(t[i]);
		}
	}
	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : teamkill <人物>
 
這個指令讓你的隊伍主動攻擊一個人物．所得獎勵在所有隊員間均分．
但必需是拿到任務的隊員親手殺死才行．
其他相關指令: team,fight,kill

HELP
    );
    return 1;
}
 
