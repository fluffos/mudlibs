// hubo.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me)
{
        string msg;
        int count;

    if( me->is_busy() )
        return notify_fail("你的動作還沒有完成，不能使用「雙手互博之朮」。\n");
    if (!me->query_skill("hubo",50))
       return notify_fail("你的「雙手互博」還不夠熟練。\n");
    if( !me->is_fighting() )
        return notify_fail("「雙手互博之朮」只能在戰鬥中使用。\n");

    if( (int)me->query("jing") < 100 ) return notify_fail("你的精不夠！\n");
    if( (int)me->query("neili") < 150 )
        return notify_fail("你的內力不夠！\n");

    msg = HIY "$N平心靜氣，靈台空明，使出「雙手互博之朮」，雙手同時出招！\n" NOR;

    message_vision(msg, me);
    count = (40 - (int)me->query("int")) / 5 + (int)me->query_skill("hubo") / 20 ;
    if( count < 1 ) count = 1 ;
    if ( count > 7 ) count = 7 ;
        while( count-- ) {
                object ob;

        me->clean_up_enemy();
        ob = me->select_opponent();
        if(!ob || (environment(ob) != environment(me))) 
        {
            message_vision(CYN "$N突然心中一亂，已不能繼續雙手互博！\n" NOR, me);
                        break;
        }
        COMBAT_D->do_attzck(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->fight(me, ob) ;
        me->add("jing",- 500 / me->query_skill("hubo"));
//      me->receive_damage("jing", 1500 / me->query_skill("hubo"));
        me->add("neili", -1000 / me->query_skill("hubo"));
        }
        me->start_busy(1);
    return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : hubo
 
這個指令可以讓你在對敵時使用雙手互博之術,快速出招。
 
HELP
    );
    return 1;
}
