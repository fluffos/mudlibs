// yihun.c 移魂大法
// By Kayin@CuteRabbit Studio 99-4-15 16:26 new
#include <ansi.h>
inherit F_SSERVER;
int main(object me, string arg)
{
	object target, victim;
	int damage, lvl, r_lvl, skill, i;
        string msg;

	if( !me->query_skill("yihun-dafa", 1) )
                return notify_fail("你不會移魂大法。\n");

	if( !arg )
	{	target = offensive_target(me);
	        if( !target || !target->is_character() || !me->is_fighting(target) )
        	        return notify_fail("移魂大法只能對自己或戰斗中的對手使用。\n");
	}
	if( me->is_busy() )
		return notify_fail("你的動作還沒有完成，不能使用移魂大法。\n");

	if( (int)me->query_skill("yihun-dafa", 1) < 50 )
                return notify_fail("你的移魂大法不夠高，小心走火入魔！\n");

        if( (int)me->query("jing") < 51 )
                return notify_fail("你現在精神不好，不能使用移魂大法。\n");
                
       	skill = (int)me->query_skill("yihun-dafa", 1);
	lvl = skill/10;
	if(!(int)me->query_temp("yihun"))
	{
	message ("vision",HIB""+ me->name()+"由「制心止」而至「體真止」，寧神歸一，竟無半點雜念。眼光呆呆的瞪著"+ target->name() +".\n"NOR,me,target);	

        if  (me->query("jing") > target->query("jing"))
        {
                write( CYN"哈哈，成功了！\n"NOR);
		me->enable_player();
		me->set_temp("yihun",1);
		tell_object(target, CYN"你身不由己，招招攻向自己！\n"NOR);
		message("vision", CYN"\n" + target->name() + "心神被制，招招擊向自己！\n"NOR, me, target);
		for(i = 0; i < lvl; i++)
			COMBAT_D->do_attack(target, target, target->query_temp("weapon") );
		me->add("jing", -50);
		if( !target->is_killing(me->query("id")) ) target->kill_ob(me);
		call_out("del_yihun",300/( me->query_skill("yihun-dafa")/100),me);
		return 1;
	}
	else
	{
		if(!(int)me->query_temp("yihun1"))
		{
		write( CYN"可惜沒成功。你精力不佳，不要再對其使用移魂大法了。\n"NOR);
		tell_object(target, CYN"你強用心神，終于控制住自己。\n"NOR);
		me->add("jing", -50);
		if( !target->is_killing(me->query("id")) ) target->kill_ob(me);	
		me->enable_player();
		me->set_temp("yihun",1);
		call_out("del_yihun",300/(me->query_skill("yihun-dafa")/100),me);
		me->set_temp("yihun1",1);
		call_out("del_yihun1",me->query_skill("yihun-dafa")*2,me);
		return 1;
		}
		else
		{
			write( CYN"你心煩意亂，心神反被制約，身不由己的招招攻向自己。\n"NOR);
			tell_object(target, CYN"" + target->name() + "像著魔似的，招招擊向自己！。\n"NOR);
			me->add("jing", -50);
			me->enable_player();
			me->set_temp("yihun",1);
			call_out("del_yihun",300/( me->query_skill("yihun-dafa")/100),me);
			for(i = 0; i < lvl; i++)
			COMBAT_D->do_attack(me, me, me->query_temp("weapon") );
			me->delete_temp("yihun1");
			return 1;
		}
		

	}
	}
	else
	write(CYN"你現在心神不寧，不能使用移魂大法。\n"NOR);
	return 1;

}
void del_yihun(object me)
{
	if (objectp(me) &&  me->query_temp("yihun"))
		me->delete_temp("yihun");
		
}
void del_yihun1(object me)
{
	if (objectp(me) &&  me->query_temp("yihun1"))
		me->delete_temp("yihun1");
		
}
