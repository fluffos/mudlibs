// kantou.c
// modify by Luky
inherit F_CLEAN_UP;

//#include <new_ride.h>
#include <ansi.h>
#include <dbase.h>

int main(object me, string arg)
{
        object obj,*ob,toulu,corpse;
        object wield1,wield2;
        object *inv;
        mapping weapon_prop;

        string *killer, callname;
        int i,count;
        int value2;
        if( environment(me)->query("no_fight") )
                return notify_fail("這里不准露出兵器。\n");

        if( !arg )
                return notify_fail("你想要誰的頭顱？\n");

        if(!obj)
                obj = present(arg, environment(me));

        if(!obj )
                return notify_fail("這里沒有這個死人。\n");

        if(!obj->is_corpse() )
                return notify_fail("你必須先殺了這個人。\n");

        if(obj->query("name")=="腐爛的尸體"
                 || obj->query("name")=="腐爛的無頭尸體"
                 || obj->query("name")=="腐爛的無頭女尸"
                 || obj->query("name")=="腐爛的無頭男尸"
                 )
                return notify_fail("那已是腐爛的尸體了。\n");

        if(obj->query("name")=="無頭的尸體"
                 || obj->query("name")=="無頭的男尸"
                 || obj->query("name")=="無頭的女尸"
                 )
                return notify_fail("那是不是完整的尸體。\n");

        if(arg!="corpse" )
                return notify_fail("那是不是完整的尸體。\n");

        if(obj==me)
                return notify_fail("你想自刎？\n");
/* cctx中尚無此函數！
       if(!together(me,obj))
                return notify_fail(HIC"這種情況下你砍不到。\n"NOR);
*/
        if(!wield1=me->query_temp("weapon"))
                return notify_fail("你應該先有武器。\n");

        if(((string)wield1->query("skill_type")!="sword"
             && ((string)wield1->query("skill_type")!="blade")))
                return notify_fail("你應該找把劍，或是刀什么的。\n");

        message_vision("\n$N嚓地一下，把$n的頭砍了下來。\n"
			+HIR+"鮮血濺了$P一身。\n"+NOR, me, obj);
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++) {
                        if( inv[i]->query("equipped")
                        && inv[i]->query("armor_type")=="cloth"
                          && !(int)inv[i]->query("blood_onit")) {
                                inv[i]->set("blood_onit",1);
                                inv[i]->set("name",HIR"粘滿鮮血的"NOR+inv[i]->query("name"));
                                continue;
                        }
        }

        if( objectp(corpse = CHAR_D->make_wutoucorpse(obj)) )
	{
		message_vision("只看見鮮血還在不斷地從"+corpse->query("name")+
			"的斷脖流了出來。\n",me);
                corpse->move(environment(me));
	}
	else
		write("不能創建無頭尸體，請告訴巫師。\n");
        if( objectp(toulu = CHAR_D->make_toulu(obj) ))
                toulu->move(me);
	else
		write("不能創建頭顱，請告訴巫師。\n");
                destruct(obj);
                return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : kantou <corpse>

砍下某個死人的頭顱。
HELP
    );
    return 1;
}
