// It's made by Gooder
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
  {
   object ob;
                   string who,which,howmuch;
    if(!arg || arg == "") 
return notify_fail(HIG" make  <人>  <屬性>  <數值>\n"NOR

);
  if( sscanf(arg,"%s %s %d",who,which,howmuch) == 3) {    
  ob = present(who,environment(this_player()));
  if(!ob){ return notify_fail("這裡沒這個人。\n");} else { 
  write(HIC"ok...."+ob->query("name")+"的"+ which + "設定為: " + howmuch + "。\n"NOR,ob);
  ob->set(which,howmuch);
  return 1;}}
}

int help(object me)
{
write(@HELP
指令格式 : make  <人>  <屬性>  <數值>
    <str>        : 力量                     <con>     : 根骨
    <int>        : 悟性                     <dex>     : 敏捷
    <cor>        : 膽識                     <spi>     : 靈性
    <cps>        : 定力                     <per>     : 容貌
    <age>        : 在MUD上的年齡            <mud_age> : 在MUD上的時間(秒)
    <kee>        : 氣的目前值               <gin>     : 精的目前值
    <eff_kee>    : 氣目前上限               <eff_gin> : 精目前上限
    <max_kee>    : 氣最大上限               <max_gin> : 精最大上限
    <sen>        : 神的目前值               <score>   : 評價值 
    <eff_sen>    : 神的目前上限             <level>   : 等級
    <max_sen>    : 神的最大上限
    <PKS>        : 殺死的player數           <MKS>     : 殺死的object數\
    <combat_exp> : 實戰經驗                 <exp>     : 經驗值
    <water>      : 水的目前值               <food>    : 食物的目前值 
 
HELP
    );
    return 1;
}