#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
  {
   object ob;
        
        if( !arg ) {
           me->clear_condition();
           me->set("qi",me->query("max_qi") );
           me->set("eff_qi",me->query("max_qi") );
           me->set("jing",me->query("max_jing"));
           me->set("eff_jing",me->query("max_jing"));
           me->set("food", (int)me->max_food_capacity() );
           me->set("water", (int)me->max_water_capacity() );
write(HIY"你喃喃自語唸道: 最美麗的創世女神...給我回復的力量吧!!\n"NOR);
           return 1;    }
          else {
            ob = present(arg,environment(me));
            if (!ob) ob = find_living(arg);
            if (!ob) return notify_fail("沒有這玩家或是生物。\n");
    else   ob->set("qi",ob->query("max_qi") );
           ob->clear_condition();
           ob->set("eff_qi",ob->query("max_qi") );
           ob->set("jing",ob->query("max_jing"));
           ob->set("eff_jing",ob->query("max_jing"));
           ob->set("food", (int)ob->max_food_capacity() );
           ob->set("water", (int)ob->max_water_capacity() );
write(ob->query("name")+HIW"突然被一道光射中，覺的全身充滿活力。\n"NOR);
                return 1;    
             }     
        
        
        
}

int help(object me)
{
write(@HELP
指令格式 : full <對象>

這可以讓你恢復體力.
 
HELP
    );
    return 1;
}


