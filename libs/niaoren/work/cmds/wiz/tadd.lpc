// toptenadd.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string type,player;
	object ob;

	seteuid(geteuid(me));
	if (!arg||sscanf(arg,"%s %s",type,player)!=2)
		return notify_fail("指令格式 : toptenadd <類型> <玩家ID>\n");
	if(!objectp(ob=find_player(player)))
		return notify_fail("沒有"+player+"這個玩家或"+player+"不在線。\n");
	switch(type)
	{
	case "rich":
		if(TOPTEN_D->topten_add(ob,type))
			write("玩家"+player+"成功擠入"+RICH_B+"！\n");
		else
			write("玩家"+player+"沒資格列入"+RICH_B+"！\n");
		break;
	case "pker":
		if(TOPTEN_D->topten_add(ob,type))
			write("玩家"+player+"成功擠入"+PKER_B+"！\n");
		else
			write("玩家"+player+"沒資格列入"+PKER_B+"！\n");
		break;
	case "exp":
		if(TOPTEN_D->topten_add(ob,type))
			write("玩家"+player+"成功擠入"+EXP_B+"！\n");
		else
			write("玩家"+player+"沒資格列入"+EXP_B+"！\n");
		break;
	default:
		return notify_fail("現在還沒有"+type+"這種排行榜。\n");
	}
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : topten <類型> <玩家ID>
HELP
    );
    return 1;
}
