//未對emote內部順序排序
#define MASTER "/adm/obj/master"
#define MAX 40
inherit F_CLEAN_UP;
#define SPLIT "\n.\n"
#define EM_HEAD "\n.\nbegin:\n.\n"
int main(object me,string file)
{
	string *all_keys,key,str,item,str1,fn;
	mapping *emotes,emote;
	int i,j;
	if(!file||file=="")
		return notify_fail("用法：export 文件名\n");
	file=MASTER->make_path_absolute(file);
	write("准備輸出emote數據到文件"+file+"里。\n");
	if(MASTER->valid_write(file,me,"write_file")==0)
		return notify_fail("你不能寫該文件！輸出失敗！\n");
	if(file_size(file)!=-1)
		return notify_fail("檔案已經存在！請先將其刪除！\n");//可以多寫判斷的！
	all_keys=sort_array(EMOTE_D->query_all_emote(),1);
	str="";i=0;j=0;
	foreach(key in all_keys)
	{
		emote=EMOTE_D->query_emote(key);
		str+=EM_HEAD+key+"\n\n"SPLIT;
		foreach(item in keys(emote))
			switch(item)
			{
				case "updated":break;
				default:
					str+=item+":"+emote[item]+SPLIT;
			}
			str+="=======================================\n";
		if((++i%MAX)==0)
		{
			str=replace_string(str,EM_HEAD,"");
			str=replace_string(str,SPLIT,"");
			fn=file+(string)j;
			if(write_file(fn,str,1)==0)
				return notify_fail("輸出到文件"+fn+"出錯！\n");
			write("輸出到 >>"+fn+"\n");
			str="";j++;
		}
	}
	str=replace_string(str,EM_HEAD,"");
	str=replace_string(str,SPLIT,"");
	fn=file+(string)j;
	if(write_file(fn,str,1)==0)
		return notify_fail("輸出到文件"+fn+"出錯！\n");
	write("輸出到 >>"+fn+"\n");
	write("輸出成功！>>"+file+"X\n");
	return 1;
}
