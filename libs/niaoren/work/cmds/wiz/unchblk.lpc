// write by jackyboy@cctx 1999/2/8

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string who, ch_name,str;
	string* channels=({"all","rumor","chat","es","party","new","wiz","arch","gwiz","gbwiz"});

	if (!arg)
		return notify_fail("語法: unchblk <玩家id> <頻道名>\n");
	if (sscanf(arg, "%s %s", who, ch_name) != 2)
		return  notify_fail("語法: chblk <玩家id> <頻道名>\n");
	ob = LOGIN_D->find_body(who);
	if (!ob) return notify_fail("這個人不在！\n");
	if (wizardp(ob)) return notify_fail("不能對巫師進行頻道操作。\n");
	if(member_array(ch_name,channels)!=-1)
	{
		if(ch_name!="all")
		{
			ob->set("chblk_channel/"+ch_name,time());
			tell_object(me,ob->query("name")+"的"+ch_name+"頻道被打開了。\n");
		}
		else
		{
			ob->delete("chblk_channel");
			tell_object(me,ob->query("name")+"的所有頻道都被打開了。\n");
		}
	}
	else
		return notify_fail("沒有這個頻道！\n");
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : unchblk <某人> <頻道名>

此命令將打開某人的頻道。如果沒有頻道名就打開所有合法頻道。
<某人>　也可以是頻道名。
<頻道名> 可以是rumor、chat、es等，或 all 打開全部。

HELP
    );
    return 1;
}
