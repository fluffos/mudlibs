// channel block command..
// Write by JackyBoy@cctx 1999/2/8

#include <globals.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob;
        string who, ch_name,str;
        string* channels=({"all","rumor","chat","es","party","new","wiz","arch","gwiz","gbwiz"});

        if (!arg)
                return notify_fail("語法: chblk <玩家id> <頻道名>\n");
        if (sscanf(arg, "%s %s", who, ch_name) != 2)
        {
                ch_name = "";
                if (sscanf(arg, "%s", who) != 1)
                        return  notify_fail("語法: chblk <玩家id> <頻道名>\n");
        }
        ob = LOGIN_D->find_body(who);
        if (!ob) return notify_fail("這個人不在！\n");
        if (wizardp(ob)) return notify_fail("不能關閉巫師的頻道。\n");
        if (ch_name == "" || ch_name == " ") 
        {
                str=ob->query("name")+"("+ob->query("id")+")的頻道關閉情況如下：\n";
                if ( (time() - (int)ob->query("chblk_channel/all")) < 3600)
                        str+=(string)ob->query("name")+"的所有頻道都被關閉了。\n";
                if ( (time() - (int)ob->query("chblk_channel/shout")) < 3600)
                        str+=(string)ob->query("name")+"的長嘯頻道被關閉了。\n";
                if ( time() - (int)ob->query("chblk_channel/rumor") < 3600)
                        str+=(string)ob->query("name")+"的謠言頻道被關閉了。\n";
                if ( time() - (int)ob->query("chblk_channel/chat") < 3600)
                        str+=(string)ob->query("name")+"的閑聊頻道被關閉了。\n";
                if ( time() - (int)ob->query("chblk_channel/new") < 3600)
                        str+=(string)ob->query("name")+"的新手頻道被關閉了。\n";
                if ( time() - (int)ob->query("chblk_channel/party") < 3600)
                        str+=(string)ob->query("name")+"的門派頻道被關閉了。\n";
                if ( time() - (int)ob->query("chblk_channel/es") < 3600)
                        str+=(string)ob->query("name")+"的網際頻道被關閉了。\n";
                if(str==(ob->query("name")+"("+ob->query("id")+")的頻道關閉情況如下：\n"))
                        str+=ob->query("name")+"沒有被關閉的頻道。\n";
                tell_object(me,str);
        }
        else
        if(member_array(ch_name,channels)!=-1)
        {
                ob->set("chblk_channel/"+ch_name,time());
                if(ch_name!="all")
                        tell_object(me,ob->query("name")+"的"+ch_name+"頻道被關閉了。\n");
                else
                        tell_object(me,ob->query("name")+"的所有頻道都被關閉了。\n");

        }
        else
                return notify_fail("沒有這個頻道！\n");
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : chblk <某人> <頻道名>

此命令將關閉某人的某個頻道。
<頻道名>：可以是rumor、chat等或all封閉所有頻道。
如果不提供頻道名，則顯示某人當前的頻道狀態。 

HELP
    );
    return 1;
}
