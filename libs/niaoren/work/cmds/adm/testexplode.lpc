int main()
{
        write("這個命令用來測試OS的explode設定。");
        write("請輸入帶分隔符“,”的字符串：");
        input_to("test");
        return 1;
}
int test(string z)
{

        string *x;
        int i,j;
        x= explode(z,",");
        i= sizeof (x);
        printf("total=%d:\n",i);
        for(j=0;j<i;j++){
                printf("j=%d,x=%s\n",j,x[j]);
        }
        return 1;
}
