// finger2.c
// by sunpoet 2000/09/04

#include "/u/sunpoet/include/fingerd.h"

inherit F_CLEAN_UP;

void create() {
	seteuid(getuid());
}

int main(object obj, string arg)
{
    if (!arg)
		finger_all_ipsorted();
	else
		finger_user(arg);
	return 1;
}

int help(object obj) {
    write(@HELP
指令格式 : finger2 [使用者姓名]
 
這個指令，如果沒有指定使用者姓名，會顯示出所有正在線上玩家
的連線資料。反之，則可顯示有關某個玩家的連線、權限等資料。
 
SeeAlso: who
Author: sunpoet
HELP);
    return 1;
}
