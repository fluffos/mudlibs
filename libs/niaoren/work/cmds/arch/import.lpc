#define MASTER "/adm/obj/master"
inherit F_CLEAN_UP;
#define SPLIT "\n.\n"
#define EM_HEAD "\n.\nbegin:\n.\n"
int main(object me,string file)
{
	string *all_keys,key,str,str1,item,type,mesg;
	mapping *emotes,emote;
	if(!file||file=="")
		return notify_fail("用法：import 文件名\n");
	file=MASTER->make_path_absolute(file);
	write("准備從文件"+file+"導入emote數據。\n");
	if(MASTER->valid_read(file,me,"read_file")==0)
		return notify_fail("你不能寫該文件！輸出失敗！\n");
	if(file_size(file)<0)
		return notify_fail("檔案不存在！\n");
	str=read_file(file);
	foreach(str1 in explode(str,EM_HEAD))
	{
		emote=([]);
		if(sscanf(str1,"%s"+SPLIT+"%s",key,str1)!=2)
			return notify_fail("關鍵字emote動詞讀取出錯！\n");
		//if(mapp(EMOTE_D->query_emote(key)))//跳過key這個emote!
		//	continue;
		foreach(item in explode(str1,SPLIT))
		{
			if(sscanf(item,"%s:%s",type,mesg)!=2)
				return notify_fail("動詞"+key+"的內容分析錯誤！\n");
			emote[type]=mesg;
		}
		emote["updated"]=me->id(1);
		EMOTE_D->set_emote(key,emote);
		write("成功增加emote -> "+key+"!\n");
	}
	return 1;
}
