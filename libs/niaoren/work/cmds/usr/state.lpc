// state.c

#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
	if( !arg ) return help(me);
	if( strlen(arg) > 24 )
		return notify_fail("你的狀態要那么長才能描述清楚嗎？\n");
	if(arg=="cancel")
	{
		me->delete_temp("state");
		write("狀態已被清除。\n");
		return 1;
	}
	me->set_temp("state", arg);
	write("設置狀態為：<"+arg+">\n");
	return 1;
}
int help(object me)
{
	write(@HELP
指令格式 : state <狀態名字> | cancel
	設置自己的狀態：
	比如 state 找BUG中,那么別人look you的時候在名字后就會顯示"<找BUG中>"。
	參數cancel取消狀態顯示。
HELP
	);
	return 1;
}
