#include <ansi.h>
 
inherit F_CLEAN_UP;
int time_period(int timep, object me);
int main(object me, string arg)
{
	int nowtime = time();
	mapping quest;
	if(!(quest =  me->query("quest")))
		return notify_fail("你現在沒有任何任務！\n");
	switch(quest["quest_type"])
	{
	case "送":
		write("你現在的任務是送『" + quest["quest_obj_name"] + 
			"("+quest["quest_obj_id"]+")』給『"+quest["quest_npc_name"]+
			"("+quest["quest_npc_id"]+")』。\n");
		break;
	case "尋":
		write("你現在的任務是尋『" + quest["quest_obj_name"] + 
			"("+quest["quest_obj_id"]+")』。\n");
		break;
	case "殺":
		write("你現在的任務是殺『" + quest["quest_npc_name"] + 
			"("+quest["quest_npc_id"]+")』。\n");
		break;
	default:
		write("沒有這種任務的，請向巫師報告出錯！\n");
	}
	nowtime = (int) me->query("task_time") - time();
	if( nowtime  > 0 )
		time_period(nowtime, me);
	else
		write("但是你已經沒有足夠的時間來完成它了。\n");
	return 1;
}

int time_period(int timep, object me)
{
	int t, d, h, m, s;
	string time;
	t = timep;
	s = t % 60;             t /= 60;
	m = t % 60;             t /= 60;
	h = t % 24;             t /= 24;
	d = t;
	if(d) 
		time = chinese_number(d) + "天";
	else 
		time = "";
	if(h) time += chinese_number(h) + "小時";
	if(m) time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒";
	tell_object(me,"你還有" + time + "去完成它。\n");
	return 1;
}
 
int help(object me)
{
        write(@HELP
指令格式 : quest  這個指令可以顯示出你當前的任務。
HELP
        );
        return 1;
}
