// quit.c

#include <command.h>
#include <mudlib.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() 
{
	seteuid(getuid());
	set("channel_id", "離線精靈(Quit)");
}

int main(object me, string arg)
{
	int i;
	object *inv, link_ob;
	object where = environment(me);
	object startroom;

	if( LOGIN_D->get_madlock()) 
		return notify_fail("時空已經封閉，沒有人能夠退出這個時空了。\n");

	if( (me->is_busy()) && (!me->query_temp("suicide_countdown")))
		return notify_fail("你現在正忙著做其他事，不能退出游戲！\n");

	if( !wizardp(me) ) {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			if( !inv[i]->query_autoload() )
				DROP_CMD->do_drop(me, inv[i]);
	}

	link_ob = me->query_temp("link_ob");

	// We might be called on a link_dead player, so check this.
	if( link_ob ) {

		// Are we possessing in others body ?
		if( link_ob->is_character() ) {
			write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
			exec(link_ob, me);
			link_ob->setup();
			return 1;
		}

		link_ob->set("last_on", time());
		link_ob->set("last_from", query_ip_name(me));
		link_ob->save();

		if( environment(me)->query("valid_startroom") )
		{
			me->set("startroom", base_name(environment(me)));
			write("當你下次連線進來時，會從這里開始。\n");
		}

		destruct(link_ob);
	}

	write("歡迎下次再來！\n");
	message("system", me->name() + "離開游戲。\n", environment(me), me);
	i=me->query("combat_exp")-me->query_temp("temp_exp");
	if (i < 0 ) i=0;
	CHANNEL_D->do_channel(this_object(), "sys",
		me->name() + "(" + me->query("id") + ")離開游戲了。\n\t本次連線經驗增長"+i+
			"。\n\t連線時間"+
			CHINESE_D->chinese_period(FINGER_D->online_time(me))+
			"。\n");
	if(wizardp(me))
		CHANNEL_D->do_channel(this_object(),"wiz",me->name(1)+
			"離開了"+CHINESE_MUD_NAME+"。\n");
	me->set("time_aged",me->query("time_aged")+time()-me->query_temp("temp_time"));
	//增加總連線時間到time_aged屬性中！涉及FINGER_D和LOGIN_D,CHINESE_D #By JackyBoy@cctx
	me->save();
	destruct(me);

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : quit
當你(你)想暫時離開時, 可利用此一指令。
HELP
    );
    return 1;
}
