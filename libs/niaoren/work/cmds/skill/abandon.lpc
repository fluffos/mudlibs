// abandon.c
// write by jackyboy for CCTX

inherit F_CLEAN_UP;
mapping valid_types = ([
        "unarmed":      "拳腳",
        "sword":        "劍法",
        "blade":        "刀法",
        "stick":        "棒法",
        "staff":        "杖法",
        "club" :        "棍法",
        "throwing":     "暗器",
        "force":        "內功",
        "parry":        "招架",
        "dodge":        "輕功",
        "magic":        "法朮",
        "whip":     "鞭法",
        "lingfa":  "令法",

//      shaolin skills
        "finger":   "指法",
        "hand":     "手法",
        "cuff":     "拳法",
        "claw":     "爪法",
        "strike":   "掌法",
]);
int main(object me, string arg)
{
        mapping smap;
        string *skill;
        int level,old,i;
        if( !arg || arg=="" ) 
                return notify_fail("你要放棄哪一項技能？\n");
        if( sscanf(arg,"%s %d",arg,level)==2)
        {
                if((old=me->query_skill(arg,1))>level)
                {
                        me->set_skill(arg,old-level);
                        write("你放棄了"+level+"級"+to_chinese(arg)+"。\n");
                        me->start_busy(2);
                        return 1;
                }
        }
        //必須去除map_skill，不然戰斗的時候還是要出錯！
        //但是是否要去除skill_pre就不清楚了以后如果skill還出問題，可看看這個問題
        smap = me->query_skill_map();
        if( !(!mapp(smap) || sizeof(smap)==0 ))
        {
                skill = keys(valid_types);
                for (i=0; i<sizeof(skill); i++) 
                {
                        if( undefinedp(valid_types[skill[i]]) ) 
                        {
                                map_delete(smap, skill[i]);
                                continue;
                        }
                        if( !me->query_skill(skill[i]) ) continue;
                        if(smap[skill[i]]==arg)
                        {
                                write("去除激發："+skill[i]+" => "+smap[skill[i]]+"。\n");
                                me->map_skill(skill[i]);
                        }
                }
        }
        if( !me->delete_skill(arg) )
                return notify_fail("你并沒有學過這項技能。\n");
        write("你決定放棄繼續學習" + to_chinese(arg) + "。\n");
        me->start_busy(2);
        return 1;
}

int help()
{
        write(@TEXT
指令格式：abandon|fangqi <技能名稱>

放棄一項你所學過的技能，可以將這項技能從你的人物資料中刪除，可以選擇
需要放棄的級別數。

這個指令使用的場合通常是用來刪除一些「不小心」練出來的技能，由于每個
人有著不同的天賦，所修習的武功也不會相同。如果樣樣都學，到頭來只會樣
樣不精。
TEXT
        );
        return 1;
}
