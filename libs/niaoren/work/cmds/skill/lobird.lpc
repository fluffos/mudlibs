// funny.c鳥人神教專用指令耍寶

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string what, who;
        object ob, victim;
        mapping myfam, vtfam;
        int sp, dp;

        object where = environment(me);
        
        seteuid(getuid());

    if ( (!(myfam = me->query("family")) || myfam["family_name"] != "鳥人神教") )
        return notify_fail("只有鳥人神教才能露鳥！\n");

        if( environment(me)->query("no_fight") )
                return notify_fail("這裡沒有人在幹架！\n");

        if( me->query_temp("funny") )
                return notify_fail("你已經在露鳥了！\n");

        if( !arg || sscanf(arg, "%s stop", who)!=1 ) return
                notify_fail("指令格式：lobird <人物> stop\n");

        victim = present(who, environment(me));

        if( !victim || victim == me) return notify_fail("你想要露鳥的對象不在這裡。\n");

        if( !living(victim) || !objectp(victim))
                return notify_fail("你要對誰露鳥？\n");

        if( !wizardp(me) && wizardp(victim) )
                return notify_fail("你不能對巫師露鳥。\n");

        if( me->is_fighting() )
                return notify_fail("一邊打架一邊露鳥？你還真行耶！\n");


        sp = (int)me->query_skill("lobird",1) + (int)me->query("kar") * 5;
        if( sp < 1 ) sp = 1;
        dp = (int)victim->query("jing");

        tell_object(me, "你慢慢地走向" + victim->name() + "冷不防的脫下你的褲子，大剌剌的露出你的"HIG"小牙籤"NOR"！"
                        + "...\n\n");
        tell_object(victim, me->name() + "臉色鬼異地向你慢慢走過來，冷不防的脫下他的褲子，大剌剌的露出他的"HIG"小牙籤"NOR"\n\n");

        message("vision", "只見" + me->name() + "慢慢地向"
                + victim->name() + "走過去，\n 冷不防的脫下他的褲子，露出他的"HIG"小牙籤"NOR"\n\n", environment(me), ({ me, victim }) );

        me->set_temp("funny", 1);
        call_out( "compelete_funny", 2, me, victim, ob, sp, dp);

        return 1;
}

void compelete_dushi(object me, object victim, object ob, int sp, int dp)
{
        int amount;
        object ob1;
        object where = environment(me);

        me->delete_temp("funny");

        if( environment(victim) != environment(me) ) {
                tell_object(me, "太可惜了，你要耍寶的對象已經走了。\n");
                return;
        }

        if( living(victim) && (random(sp+dp) > dp) ) 
        {
                victim ->remove_all_enemy();
                tell_object(me, victim->name() + "看到了你的小牙籤，笑的倒在地上打滾。\n");
                tell_object(victim, "你看到了他的小牙籤，笑到肚子痛的受不了，倒在地上打滾。\n");

                me->improve_skill("lobird", random(me->query("int")));
                if(((int)me->query("learned_points") + 120) > (int)me->query("potential"))
                        me->add("potential",1);
                me->add("combat_exp",(int)me->query_skill("lobird") / 6);

                me->start_busy(4);
        } 
        else 
        {
                if( random(sp) > dp/2 ) {
                        message_vision(victim->name() + "狠狠地瞪了"HIB"$N"NOR"一眼，喝道：死鳥人，牙籤那麼小也敢拿出來現！ \n", me);

                        return;
                }
        
                tell_object(me, victim->name() + "似乎是看不起你的小牙籤，對你理都不理。\n");
                tell_object(victim, "你根本看不起" + me->name() + "的小牙籤，理都不理他。\n");
                message("vision", victim->name() + "似乎是看不起" + me->name() + "的小牙籤，理都不理他。\n",
                        environment(me), ({ me, victim }) );

        }
}

int help(object me)
{
write(@HELP
指令格式 : lobird <某人> stop

HELP
    );
    return 1;
}
