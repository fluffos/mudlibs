// checkmoney.c
// by hello, 1996.12.04

#include <net/dns.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

mixed main(object me, string arg, int remote)
{
    
    object *list,g_ob,s_ob,c_ob, * inv;
    string str;
    int money,tdc,tc,gc,sc,cc,j;

    str = "◎ " + MUD_NAME + " 當前玩家資料金錢統計\n\n";
    str += "帳號            姓名        金票  銀票  金子  銀子  銅板  存款(金子)          物品數量\n";
    str += "─────────────────────────────────────────────\n";
    list = users();
    j=sizeof(list);
    while( j-- ) {
        if( !environment(list[j]) || !me->visible(list[j])) continue;
        inv = all_inventory(list[j]);  
        if (g_ob = present("hundred-cash_money", list[j]))
            tdc = g_ob->query_amount();
        else
            tdc = 0;
        if (g_ob = present("thousand-cash_money", list[j]))
            tc = g_ob->query_amount();
        else
            tc = 0;
        if (g_ob = present("gold_money", list[j]))
            gc = g_ob->query_amount();
        else
            gc = 0;
        if (s_ob = present("silver_money", list[j]))
            sc = s_ob->query_amount();
        else
            sc = 0;
        if (c_ob = present("coin_money", list[j]))
            cc = c_ob->query_amount();
        else
            cc = 0;    
            
        str = sprintf("%s%-15s %-10s%5d %5d %5d %5d %5d   %5d""兩黃金""   %10d\n",
                str,
                  list[j]->query("id"),list[j]->name(1),tdc,tc, gc,sc,cc,list[j]->query("balance")/10000, sizeof(inv)
            );
    }
        
    str += "─────────────────────────────────────────────\n";
    str = sprintf("%s共有 %d 位使用者連線中，系統負擔：%s\n", str, sizeof(list),
        query_load_average() + "\n");

    write(str);
    return 1;

}

int sort_user(object ob1, object ob2)
{
    if( wizardp(ob1) && !wizardp(ob2) ) return -1;
    
    if( wizardp(ob2) && !wizardp(ob1) ) return 1;

    if( wizardp(ob1) && wizardp(ob2) )
        return (int)SECURITY_D->get_wiz_level(ob2) 
            - (int)SECURITY_D->get_wiz_level(ob1);
    
    return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me)
{
write(@HELP
指令格式 : checkmoney

這個指令可以列出所有在線上的玩家的金錢以及身上物品的數量。

相關指令： finger, who
HELP
    );
    return 1;
}

