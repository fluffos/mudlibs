#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str)
{
        object ob;
        int i;
        if (!str) ob =me; //return notify_fail("<Syntax>: god <player id>\n");
        else ob = LOGIN_D->find_body(str);
        if (!ob) return notify_fail( HIW "< 此人不在這個時空。 >\n" NOR );
        // moving
        message("system",
HIW BLINK"\n\t＜ 忽 然 天 上 閃 過 一 道 光 芒 ＞
      "HIM" ＜你彷彿看到一位天使出現在天空上＞"NOR"
[1;33m                        (══)[m
                       [43;30m◤    ◥[m
               [1;37m╭══╮[0;43;30m  ∩∩  [0;1;37m╭══╮[m
               [1;37m║::::[33m★[0;33m◥[43;31;1m ︶ [0;33m◤[1;37m╯::::║[m
               [1;37m║::::│[0;30;47m◤    ◥[0;33m●[1;37m::::║[m
               [1;37m╰╮::[0;33m●[47;37;1m   ｏ   [0;1;37m╯::╭╯[m
                 [1;37m╰══[47;37;1m   ｏ   [0;1;37m══╯[m
[1;37m                       ◥██◤[m
       [33m                  ▉▉[m
                \n\n\n\n"NOR,
                users() );
        tell_room(environment(ob),"
        "HIW "< 你看到許多小天使把" HIY +
        (string)ob->query("name") + HIW "抓了起來, 然後不見了 >\n" NOR , ob);
        tell_object(ob, HIW "<一群 " HIY "小天使"HIW "將你抓起.飛往空中 >\n" NOR );
        ob->move(environment(me));
        ob->reincarnate();
        ob->set("water", ob->max_water_capacity());
        ob->set("food", ob->max_food_capacity());
        ob->set("kee", ob->query("max_kee"));
        ob->set("sen", ob->query("max_sen"));
        ob->set("skill",ob->query("max_skill"));
        ob->set("mana",ob->query("max_mana"));
        tell_object(me, HIG "< 你成功的把" HIY +(string)ob->query("name")+ HIG "復活了 >.\n" NOR );
        tell_object(ob, HIW "< 你醒來時發現是" HIY +(string)me->query("name")+ 
        HIW  "把你復活的 >\n" NOR );
        tell_room(environment(ob), HIG "< " + (string)ob->query("name") + HIW "被幾位小天使" +
        "慢慢的從天空放了下來 >\n" NOR ,({me,ob}));
        return 1;
}

