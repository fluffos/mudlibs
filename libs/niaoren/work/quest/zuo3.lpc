leftkiller.c000",
		"8000",
		"10000",
		"13000",
		"17000",
		"22000",
		"30000",
		"45000",
		"60000",
		"80000",
		"100000",
		"200000",
//		"350000",
//		"600000",
//		"1000000"
	});
	me = this_player();
	combatexp = (int)(me->query("combat_exp"));

	if(combatexp < 1000)
	{
		message_vision("左三對$N哼了一聲道: 這種小角色還想進天殺門, 你也真好意思開口....\n", me);
		return 1;
	}
 
// Let's see if this player still carries an un-expired task
	if((quest =  me->query("quest")))
	{
		if( ((int)me->query("task_time")) >  time() )
			return 0;
		else
		{
			message_vision("左三對$N哼了一聲道: 真給天殺門丟臉, 就再給你一次機會試試。\n", me);
			me->set("kee", (int)(me->query("kee")/2+10));
		}
	}

	for(j = sizeof(levels) - 1 ; j >= 0; j--)
	{
		if( atoi(levels[j])  <= combatexp )
		{
			num = j;
			factor = 10;
			break;
		}
	}
	if(num > 0)
	{
		if (random(50) > 45)
		{
			num = num - 1;
		}
	}
	else
	{
		if ((num < sizeof(levels) - 1) && (random(100) > 95))
		{
			num = num + 1;
			factor = 15;
		}
	}
	tag = levels[num];
	quest = QUEST_D(tag)->query_quest();
	timep = quest["time"];

	while(quest["quest_type"] == "尋")
	{
		quest = QUEST_D(tag)->query_quest();
		timep = quest["time"];
	}

	time_period(timep, me);
	tell_object(me, "殺了『" + quest["quest"] + "』為天殺門立功。\n" NOR);
	quest["exp_bonus"] = quest["exp_bonus"];
	quest["pot_bonus"] = quest["pot_bonus"];
	quest["score"] = quest["score"];

	me->set("quest", quest);
	me->set("task_time", (int)time() + (int)quest["time"]);
	me->set("quest_factor", factor);
	return 1;
}

int time_period(int timep, object me)
{
	int t, d, h, m, s;
	string time;
	t = timep;
	s = t % 60;             t /= 60;
	m = t % 60;             t /= 60;
	h = t % 24;             t /= 24;
	d = t;

	if(d)
		time = chinese_number(d) + "天";
	else
		time = "";

	if(h)
		time += chinese_number(h) + "小時";
	if(m)
		time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒";

	tell_object(me, HIW "左三說道：\n在" + time + "內");
		return 1;
}
