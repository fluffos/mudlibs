        set_skill("whip", 120);
        map_skill("whip", "snowwhip");

       set("inquiry", ([  "天殺門": "你敢亂說, 小心姑奶奶宰了你! \n",
        ]) );

        setup();
}
int accept_fight(object me)
{
        command("say 小子！你趕惹天殺門, 不要命了！");
        return 0;
}

void init()
{
        add_action("give_quest", "quest");
}

int give_quest()
{
        mapping quest ;
        object me;
        int j, combatexp, timep,factor,num;
        string tag = "1000000";
        string *levels = ({
                         "1000",
                        "1500",
                        "2000",
                        "3000",
                        "5000",
                        "8000",
                        "10000",
                        "13000",
                        "17000",
                        "22000",
                        "30000",
                        "45000",
                        "60000",
                        "80000",
                        "100000",
                        "200000"
//                        "350000",
//                        "600000",
//                        "1000000"
        });
        me = this_player();
        combatexp = (int) (me->query("combat_exp"));

        if(combatexp<1000)
          {
        message_vision("右四對$N哼了一聲道: 這種小角色還想請天殺門, 你也真好意思
開口....\n",me);
         return 1;
          }

// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
        {
        if( ((int) me->query("task_time")) >  time() )
        {
          message_vision("右四對$N嫵媚的一笑道: 想要天殺門出手, 還是先把你的任務完成吧。\n", me);
                  message_vision("然后歪頭想了想又說道：你要是決定放棄，就得付點兒費用了。\n",me);
          return 0;
        }
        else
        {
          message_vision("右四對著$N嘆了一口氣:哎，我就再給你一次機會吧。\n", me);
          me->add("qi",-(int)(me->query("qi")/10));
        }
        }

        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                      num=j;
                          factor=10;
                          break;
                        }
        }
        if (num>0)
        {
                if (random(50)>45)
                {
                num=num-1;
                }
        } else {
                if ((num<sizeof(levels)-1)&&(random(100)>95))
                {
                num=num+1;
                factor=15;
                }
        }
        tag=levels[num];
        quest = QUEST_D(tag)->query_quest();
        timep = quest["time"];

 //       while (quest["quest_type"] == "殺")
 //       {
 //       quest = QUEST_D(tag)->query_quest();
 //       timep = quest["time"];
 //       }

        time_period(timep, me);
        if(quest["quest_type"]=="殺")
        tell_object(me,"先替我殺了『"+quest["quest"]+"』,或許我給你派殺手。\n" NOR);
        else
        tell_object(me,"先找回『"+quest["quest"]+"』給我,或許我給你派殺手。\n" NOR);
        quest["exp_bonus"]=quest["exp_bonus"];
        quest["pot_bonus"]=quest["pot_bonus"];
        quest["score"]=quest["score"];

        me->set("quest", quest);
        me->set("task_time", (int) time()+(int) quest["time"]);
        me->set("quest_factor",factor);
        return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小時";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,HIW "右四說道：\n在" + time + "內");
        return 1;
}

int accept_object(object who, object ob)
{
        int bonus, exp, pot, score,factor;
        string test;
        mapping quest;

                if (ob->query("money_id"))
                {
                        if(!who->query("quest"))
                        {
              message_vision("右四笑道: 那我可就不客氣了。\n",who);
                          return 1;
                        }
                        if ( ob->value() < 10000)
                        {
                                message_vision("右四一雙美麗的眼睛直盯著$N:這點錢可不夠我們的開銷呀!\n", who);
                                return 1;
                        }
                        else
                        {
              message_vision("右四笑道: 那好，咱們買賣不成仁義在。有事再找我吧！\n",who);
                          who->set("quest",0);
                          return 1;
                        }

                }

        if(!(quest =  who->query("quest")))
        {
        tell_object(who,"右四說道：這不是我想要的。\n");
        return 0;
        }

        if( ob->query("name") != quest["quest"])
        {
        tell_object(who,"右四說道：這不是我想要的。\n");
        return 0;
        }

        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"右四說道：真可惜！你沒有在指定的時間內回來！\n");
        destruct(ob);
        return 0;
        }

        else
        {
        tell_object(who,"右四說道：對不起！現在天殺門還不能派殺手！\n");
        exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
        pot = quest["pot_bonus"]/2 + random(quest["pot_bonus"]/2);
        score = quest["score"]/2 + random(quest["score"]/2);
        factor=who->query("quest_factor");
        destruct(ob);

        if (factor)
        {
                exp=exp*factor/10;
                pot=pot*factor/10;
                score=score*factor/10;
        }

        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
        bonus = (int) who->query("potential");
        bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
        if( bonus > 300) bonus = 300;
        bonus += (int) who->query("learned_points");
        who->set("potential", bonus );
        bonus = (int) who->query("score");
        bonus += score;
        who->set("score", bonus);
        tell_object(who,HIW"你被獎勵了\n" + chinese_number(exp)
          + "點實戰經驗\n"+ chinese_number(pot) + "點潛能\n"
          + chinese_number(score)+"點綜合評價\n"NOR);
        who->set("quest", 0 );
         return notify_fail("恭喜你完成一個任務！\n");;
        }
     return 1;
}
