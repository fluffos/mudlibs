// shan.c
#include <quest.h>;

inherit NPC;
inherit F_SKILL;
#include <ansi.h>;
int time_period(int timep,object me);
void create()
{
	set_name("單正", ({ "shan zheng", "shan", "zheng" }));
	set("nickname", HIB"鐵面判官"NOR);
	set("age", 63);
	set("str", 25);
	set("dex", 16);
	set("per", 22);
	set("long", 
"他生平嫉惡如仇，只要知道江湖上有什么不公道之事，定然伸手
要管。他滿臉紅光，當得起“童顏鶴發”四字，神情卻甚謙和，
不似江湖上傳說的出手無情。\n");
	set("combat_exp", 300000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 80);
	set_skill("force", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/armor", 100);
	set_temp("apply/damage", 100);

	set("neili", 800); 
	set("max_neili", 800);
	set("jiali", 50);

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("give_quest", "quest");
}

int give_quest()
{
        mapping quest ;
        object me;
        int j, combatexp, timep,factor,num;
        string tag = "1000000";
        string *levels = ({
                        "1000",
                        "1500",
                        "2000",
                        "3000",
                        "5000",
                        "8000",
                        "10000",
                        "13000",
                        "17000",
                        "22000",
                        "30000",
                        "45000",
                        "60000",
                        "80000",
                        "100000",
                        "200000"
//                        "350000",
//                        "600000",
//                        "1000000"
        });
        me = this_player();
        combatexp = (int) (me->query("combat_exp"));
        if(combatexp<1000)
        {
message_vision("單正對$N哼了一聲道：“這種小角色還想除暴安良？”\n",me);
             return 1;
        }

// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
        {
             if( ((int) me->query("task_time")) >  time() )
             {
message_vision("單正對$N冷冷一笑道：讓你辦的事如何了？\n", me);
message_vision("單正瞟了$N一眼說道：你要是沒本事，就拿點兒費用出來我讓別的人去申張正義。\n",me);
                   return 0;
             }
             else
             {
message_vision("單正對著$N嘆了一口氣：哎，我就再給你一次機會吧。\n", me);
                   me->add("qi",-(int)(me->query("qi")/10));
             }
        }

        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
             if( atoi(levels[j])  <= combatexp )
             {
                   num=j;
                   factor=10;
                   break;
             }
        }
        if (num>0)
        {
             if (random(50)>45)
             {
                   num=num-1;
             }
        } 
        else
        {
             if ((num<sizeof(levels)-1)&&(random(100)>95))
             {
                   num=num+1;
                   factor=15;
             }
        }
        tag=levels[num];
       quest = QUESTS_D(tag)->query_quest();
        timep = quest["time"];

 //       while (quest["quest_type"] == "殺")
 //       {
 //       quest = QUEST_D(tag)->query_quest();
 //       timep = quest["time"];
 //       }

        time_period(timep, me);
        if(quest["quest_type"]=="殺")
             tell_object(me,"先替我把『"+quest["quest"]+"』給我殺了，別的差使以后再說。\n" NOR);
        else
             tell_object(me,"先找回『"+quest["quest"]+"』給我，別的差使以后再說。\n" NOR);
        quest["exp_bonus"]=quest["exp_bonus"];
        quest["pot_bonus"]=quest["pot_bonus"];
        quest["score"]=quest["score"];

        me->set("quest", quest);
        me->set("task_time", (int) time()+(int) quest["time"]);
        me->set("quest_factor",factor);
        return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小時";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,HIW "單正吩咐道：給你在" + time + "內");
        return 1;
}

int accept_object(object who, object ob)
{
        int bonus, exp, pot, score,factor;
        string test;
        mapping quest;

        if (ob->query("money_id"))
        {
             if(!who->query("quest"))
             {
                   message_vision("單正笑道：那我可就不客氣了。\n",who);
                   return 1;
             }
             if ( ob->value() < 5000)
             {
message_vision("單正一雙尖針般的眼睛直盯著$N：這點錢可不夠我們的開銷！\n", who);
                   return 1;
             }
             else
             {
message_vision("單正笑道：那好，咱們買賣不成仁義在。想討差使再找我吧！\n",who);
                   who->set("quest",0);
                   return 1;
             }
        }

        if(!(quest =  who->query("quest")))
        {
             tell_object(who,"單正說道：這不是我想要的。\n");
             return 0;
        }

        if( ob->query("name") != quest["quest"])
        {
             tell_object(who,"單正說道：這是什么東西？我叫你辦的差使你就這樣糊弄？！\n");
             return 0;
        }

        if ((int) who->query("task_time") < time() )
        {
             tell_object(who,"單正說道：真是廢物！你沒有在指定的時間內回來！\n");
             destruct(ob);
             return 0;
        }
        else
        {
             tell_object(who,"單正贊許地點頭說道：不錯！差使辦得還不錯！\n");
             exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
             pot = quest["pot_bonus"]/2 + random(quest["pot_bonus"]/2);
             score = quest["score"]/2 + random(quest["score"]/2);
             factor=who->query("quest_factor");
             destruct(ob);

             if (factor)
             {
                  exp=exp*factor/10;
                  pot=pot*factor/10;
                  score=score*factor/10;
             }
             bonus = (int) who->query("combat_exp");
             bonus += exp;
             who->set("combat_exp", bonus);
             bonus = (int) who->query("potential");
             bonus = bonus - (int) who->query("learned_points");
             bonus = bonus + pot;
             if( bonus > 300) bonus = 300;
             bonus += (int) who->query("learned_points");
             who->set("potential", bonus );
             bonus = (int) who->query("score");
             bonus += score;
             who->set("score", bonus);
             tell_object(who,HIW"你被獎勵了：" + chinese_number(exp)
               + "點實戰經驗，"+ chinese_number(pot) + "點潛能，"
               + chinese_number(score)+"點江湖閱歷。\n"NOR);
             who->set("quest", 0 );
             tell_object(who,HIW"恭喜你完成一個差使！\n"NOR);
             return 0;
        }
        return 1;
}
