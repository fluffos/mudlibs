// badun.c 臭酸的便當

#include <weapon.h>

inherit HAMMER;
inherit F_FOOD;

void create()
{
        set_name("臭酸的便當", ({ "badun", "ba" }) );
        set_weight(350);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一個聯合 餐廳作的超難吃又被人丟掉的臭酸便當，
                             而你竟然有股衝動想把它吃光光，嘔~~~~~~~。\n");
                set("unit", "個");
                set("value", 30);
                set("food_remaining", 14);
                set("food_supply", 40);
                set("wield_msg", "$N抓起一個$n，握在手中當武器。\n");
                set("material", "bone");
        }
        init_hammer(1);
        setup();
}

int finish_eat()
{
        if( !query("weapon_prop") ) return 0;
        set_name("被吃光的臭酸便當", ({ "bone" }) );
        set_weight(150);
        set("long", "一個吃得精光的便當盒。\n");
        return 1;
}
