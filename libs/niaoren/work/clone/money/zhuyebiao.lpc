// zhuyebiao.c
#include <weapon.h>
inherit THROWING;

void create()
{
	set_name("竹葉鏢", ({"zhuyebiao", "biao" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "這是一把形如竹葉的飛鏢。\n");
		set("unit", "些");
                set("base_value", 1);
		set("material", "steel");
                set("base_unit", "枚");
		set("base_weight", 10); 
	}	
        set_amount(1);
        init_throwing(40);
        setup();
}


