// diamond.c

inherit MONEY;

void create()
{
        set_name("鑽石", ({"diamond", "zuanshi", "diamond_money"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "diamond");
                set("long", "亮晶淨的鑽石，人見人愛的鑽石，啊∼∼鑽石！\n");
                set("unit", "克拉");
                set("base_value", 1000000 );
                set("base_unit", "克拉");
                set("base_weight", 5);
        }
        set_amount(1);
}


