// hundred.c

inherit MONEY;

void create()
{
        set_name("一百兩金票", ({"hundred-cash", "hundred-cash_money", "cash"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "hundred-cash");
                set("long", "一張面額值一百兩金子的金票。\n");
                set("unit", "疊");
                set("base_value", 1000000);
                set("base_unit", "張");
                set("base_weight", 3);
        }
        set_amount(1);
}

