// square.c  給jordan的練功房
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC "大鳥讓問天送給藍海的專用練武場");
        set("long", "這裡是"HIY"大巫師"HIC"問天"NOR"送給藍海的專用練武場，除了木人什麼東沒有。"NOR"\n"
);
        set("exits", ([
            "west"     :"/d/dugu/square1",
        ]));
        set("objects", ([
            "/d/shaolin/npc/mu-ren" :30,
        ]));
        set("no_clean_up", 0);
        set("outdoors", "xx" );

        setup();
}


