// ring.c

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
        set_name( HIC"武道大會"HIY"冠軍戒"NOR, ({ "ring"}) );
        set_weight(5);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
/*
                set("no_put", "1");
                set("no_beg", "1");
                set("no_get", "1");
                set("no_steal", "1");
*/
                set("long", HIG" 這是只比武大會冠軍的戒指，上面刻著“"BLINK"叫我第一名"NOR"“。\n "NOR);
                set("value", 5000000);
                set("no_drop", "丟掉這只冠軍戒？！你的榮譽到那去了？餵狗了嗎？\n");
//              set("no_give", "送人？你不怕被那群得不到冠軍戒的人公幹嗎？！\n");
                set("material", "steel");
                set("armor_prop/armor", 200);
                set("wear_msg", HIG " $N向周圍的人們比了一個YA的手勢後，將冠軍戒套入豎起已久的中指\n" NOR);
                set("remove_msg", HIW " $N嘆了一聲之後，小心翼翼地將冠軍戒收藏起來\n" NOR);
        }
        setup();
}

int query_autoload()
{
   return 1;
}
void owner_is_killed()
{
        write(HIY"只見眼前金光一閃...好象是戒指...\n"NOR);
        destruct(this_object());
} 
