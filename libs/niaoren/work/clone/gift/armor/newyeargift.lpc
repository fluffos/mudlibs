// newyear.c 新年禮物

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
        set_name( YEL"大紅戒指"NOR, ({ "newyear", "finger" }) );
        set("long", "這是由一位賭徒以他的生命換來的戒指，傳說戴上這個戒指十賭十輸。\n");
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "steel");
                set("wear_msg", "$N神秘兮兮地從口袋中拿出一個$n套在手指上。\n");
                set("value", 900);
//              set("no_drop", "如此神器再世難求啊。\n");
                set("armor_prop/armor", 10);
                set("armor_prop/attack", 1);
                set("armor_prop/strength", 1);
                set("armor_prop/dodge", 1);
                set("armor_prop/intelligence", 1);
                set("armor_prop/12godeq", 1);
        }
        setup();
}

void owner_is_killed()
{
       destruct(this_object());
}

int query_autoload()
{
       return 1;
}
