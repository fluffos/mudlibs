//newyear.c 太白劍
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIC "太白劍" NOR,({"newyear","sword"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIG" 這是一把潔白亮目如深秋縣空皓月的劍，傳說是由某位名匠為慶祝新年而製作的劍。\n "NOR);
                set("material", "steel");
//              set("no_drop", "如此寶貴的武器再世難求啊。\n");
//              set("no_get", "送人？虧你想的出來！\n");
//              set("no_put", "珍惜它吧。\n");
                set("value",100);
                set("wield_msg", HIG " $N將太白劍從劍鞘抽出，頓時一道如閃電御空般的光華自"BLINK"太白劍"NOR"中發出！\n" NOR);
                set("unwield_msg", HIW " $N舞了一手漂亮的劍法之後將太白劍收回劍竅之中\n" NOR);
       }
       init_sword(140);
       setup();
}

int hit_ob(object me, object ob, int damage)
{
        if( random(8) >2 )      {
         message_vision("\n$N被$n手上的"HIB"太白劍"NOR"發出的"HIW"劍氣"NOR"給剌傷了！\n", ob);

        ob->receive_damage("qi",20);
        }
}


void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}
