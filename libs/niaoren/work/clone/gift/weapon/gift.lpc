//newyear.c 長干劍
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIC "長干劍" NOR,({"newyear","sword"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIG" 這是某位名匠為慶祝新年而製作的劍，劍長七尺是快劍手的最愛。\n "NOR);
                set("material", "steel");
//              set("no_drop", "如此寶貴的武器再世難求啊。\n");
//              set("no_get", "送人？虧你想的出來！\n");
//              set("no_put", "珍惜它吧。\n");
                set("value",100);
                set("wield_msg", HIG " $N說道：讓你看看我的劍法的利害。\n" NOR);
                set("unwield_msg", HIW " $N舞了一手漂亮的劍法之後將長干劍收回劍竅之中\n" NOR);
       }
       init_sword(140);
       setup();
}

void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}
