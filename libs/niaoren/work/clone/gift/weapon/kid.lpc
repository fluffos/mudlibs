// longsword.c 阿信的劍

#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("阿信的劍", ({ "goodsword", "good" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是由鳥人一號授封給阿信的劍，這柄劍看起來鋒銳無比。\n");
                set("value", 100);
                set("material", "steel");
                set("wield_msg", "$N「唰」的一聲抽出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n插回劍鞘。\n");
        }
        init_sword(225);
        setup();
}
int query_autoload()
{
   return 1;
}
