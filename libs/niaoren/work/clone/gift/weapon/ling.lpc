// ling.c 免死令

#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("免死令", ({ "lin", "li" }));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "張");
                set("long", "這是張大鳥給x的免死令，沒有特殊功績是拿不到這個的。上面寫著使用至90.01.31\n");
                set("value", 10000000);
                set("material", "steel");
                set("wield_msg", "$N「耶」的一聲拿出一張$n向你炫耀一番。\n");
                set("unwield_msg", "$N小心翼翼的將手中的$n收起來。\n");
        }
        init_sword(500);
        setup();
}

int query_autoload()
{
   return 1;
}
