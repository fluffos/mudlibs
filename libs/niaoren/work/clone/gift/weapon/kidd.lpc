//ytjian.c 極樂劍
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIC "極樂劍" NOR,({"kidsword","sword"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIG" 這是柄天神的劍，劍身隱隱流動著如虎眼般的光華，又彷彿天上星子降臨般璀璨\n
 握在手中略一揮動，四周流光飛舞，以飄忽變幻的弧度，畫過一道美麗奇異的\n
 曲線，如夢似幻，似真還虛，變幻莫測，淡淡的光芒靜靜照耀於四周。\n "NOR);
                set("material", "steel");
//              set("no_drop", "如此寶貴的武器再世難求啊。\n");
//              set("no_get", "送人？虧你想的出來！\n");
//              set("no_put", "珍惜它吧。\n");
                set("value",100);
                set("wield_msg", HIG " 一陣強大而不刺眼的光從$N身上 閃過，逐漸凝聚成一把劍型\n" NOR);
                set("unwield_msg", HIW "一陣柔柔的光華如同溫柔的情人之手從$N身邊流過，剎那間消失於無窮無盡的茫茫蒼穹中\n" NOR);
       }
       init_sword(300);
       setup();
}

void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}
