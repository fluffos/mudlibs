//ytjian.c 傳說聖劍
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIC "傳說聖劍" NOR,({"robertS","sword"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIG" 這把傳說的聖劍有著懾人的霸氣,劍身閃爍的耀眼的七彩光芒。\n "NOR);
                set("material", "steel");
                set("no_drop", "如此寶貴的武器再世難求啊。\n");
                set("no_get", "送人？虧你想的出來！\n");
//              set("no_put", "珍惜它吧。\n");
                set("value",100);
                set("wield_msg", HIG " $N大喊一聲聖劍出竅;只見眼前綻放出耀眼的七彩光芒,傳說聖劍由劍竅飛入$N手中\n" NOR);
                set("unwield_msg", HIW " $N將傳說聖劍往空中一丟,此刻地動山搖,鬼哭神號,直至傳說聖劍飛入劍竅之中\n" NOR);
       }
       init_sword(300);
       setup();
}

void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}
