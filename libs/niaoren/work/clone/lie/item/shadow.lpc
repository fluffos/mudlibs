// shadown.c 某人的影子

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("某人的影子", ({ "shadow", "sh" }));
        set("nickname", HIG "真是鳥人" NOR);
        set("long", 
                "你看到的似乎是某人的影子，沒事別找他麻煩\n");
        set("gender", "男性");
        set("age", 100);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 40);
        set("int", 40);
        set("con", 140);
        set("dex", 40);
        
        set("max_qi", 1000000);
        set("max_jing", 50000);
        set("neili", 20000);
        set("max_neili", 20000);
        set("jiali", 3000);
        set("combat_exp", 70000000);
        set("score", 12000000);

        set_skill("force", 400);
        set_skill("taiji-shengong", 400);
        set_skill("dodge", 300);
        set_skill("tiyunzong", 300);
        set_skill("unarmed", 350);
        set_skill("taiji-quan", 350);
        set_skill("parry", 400);
        set_skill("sword", 350);
        set_skill("taiji-jian", 350);
        set_skill("blade", 350);
        set_skill("taiji-dao", 350);
        set_skill("taoism", 500);
        set_skill("literate", 500);
        set_skill("liangyi-jian", 350);

        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-quan");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");
        map_skill("blade", "taiji-dao");

        create_family("鳥人神教", 3, "護教者");
        set("class", "taoist");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.lian" :),
                (: perform_action, "sword.chan" :),
                (: perform_action, "sword.sui" :),
                (: exert_function, "recover" :),
        }) );

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("taiji-shengong", 1) < 100) {
                command("say 我武當派乃內家武功，最重視內功心法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否還應該在太極神功上多下點功夫？");
                return;
        }
        if ((int)ob->query("shen") < 100000) {
                command("say 學武之人，德義為先，功夫的高低倒還在其次，未練武，要先學做人。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否還做得不夠？");
                return;
        }
        if (ob->query_int() < 30) {
                command("say 我武當派武功全從道藏悟出。");
                command("say 要能達到爐火純青之境，體質什么的倒是無關緊要，悟性卻是半點也馬虎不得。");
                command("say " + RANK_D->query_respect(ob) + "的悟性還大有潛力可挖，還是請回吧。");
                return;
        }
        command("chat 哈哈哈哈！！！！");
        command("chat 想不到老道在垂死之年，又覓得一個可塑之才，真是可喜可賀。");
        command("recruit " + ob->query("id"));
}
