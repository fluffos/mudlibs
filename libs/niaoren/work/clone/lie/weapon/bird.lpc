// bird.c 大鳥的劍

#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("鳥人之劍", ({ "bird" }));
        set_weight(1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄給那些鳥人用的神劍，並不是每個人都能有緣份拿到，除非你真的是個鳥人，聽說這把劍最近會有改良版出來。\n");
                set("value", 15000000);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一聲將$n抽出，並將$n握在手中，你發現自已真的是個鳥人！\n");
                set("unwield_msg", "$N手中的$n自動回到劍鞘中。\n");
        }
        init_sword(500);
        setup();
}
int query_autoload()
{
   return 1;
}
