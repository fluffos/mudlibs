// goodsword.c 絕世很好劍

#include <weapon.h>
inherit SWORD;

void create()
{
        set_name("絕世很好劍", ({ "goodsword", "good" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄天神不小心遺留在人間的神劍，並不是每個人都能有緣份拿到的。\n");
                set("value", 1500000);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一聲將絕世很好劍抽出，並將$n握在手中，你發現有些地方不太對。\n");
                set("unwield_msg", "$N手中的$n自動回到劍鞘中。\n");
        }
        init_sword(1);
        setup();
}
int query_autoload()
{
   return 1;
}
