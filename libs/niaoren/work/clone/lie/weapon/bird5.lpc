// bird.c 大鳥的劍改良版回收錢賣給khe，其他人不可給

#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
        set_name(BLINK"鳥人專用劍之五"NOR, ({ "bird5" }));
        set_weight(1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是"BLINK"第五柄"NOR"給那些鳥人用的神劍，在這世上只有十位鳥人擁有它。\n");
                set("value", 150000000);
                set("material", "iron");
                set("wield_msg", "$N大喊一聲「我是鳥人」之後，「唰」的一聲將$n抽出，並將$n握在手中！\n");
                set("unwield_msg", "$N手中的$n自動回到鳥籠中。\n");
        }
        init_sword(1000);
        setup();
}
int query_autoload()
{
   return 1;
}
