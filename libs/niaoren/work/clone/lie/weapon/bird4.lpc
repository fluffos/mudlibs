// bird.c 大鳥的劍改良版回收錢賣給rukuwa，其他人不可給
// 2000.12.17 由 belldandy 修正兩處
//  1.unequip_msg 改成 unwield_msg
//  2.物件宣告為 BLADE , init_blade(1000)

#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create()
{
        set_name(BLINK""HIC"鳥人"NOR"專用刀之"BLINK""HIR"四"NOR, ({ "bird4", "blade" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是"BLINK"第四柄"NOR"給那些鳥人用的神刀，在這世上只有十位鳥人擁有它。\n");
                set("value", 150000000);
                set("material", "iron");
                set("wield_msg", HIY"$N大喊一聲「我是鳥人」之後，「唰」的一聲將$n抽出，並將$n握在手中！\n"NOR);
                set("unwield_msg", HIY"$N手中的$n自動回到鳥籠中。\n"NOR);
        }
        init_blade(1000);
        setup();
}
int query_autoload()
{
   return 1;
}
