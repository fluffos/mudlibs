// 9whip.c leos 2000.09.14

#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
        set_name("九節鞭", ({ "9whip","whip" }) );
        set_weight(40);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是條用九片上等軟鋼經由熟練鐵匠打造後結合成的九節連鞭，在高手的使用下相信必能發揮它大的能力。\n");
                set("value", 100000);
                set("material", "iron");
                set("wield_msg", "$N從腰間抽出$n，甩了一手令人讚賞的鞭法。\n");
                set("unwield_msg", "$N將手中的$n捲在腰際。\n");
        }

        init_whip(55);
        setup();
}
