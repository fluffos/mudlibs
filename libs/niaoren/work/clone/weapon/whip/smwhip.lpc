// smwhip.c leos 2000.09.14

#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
        set_name("SM鞭子", ({ "smwhip","sm" }) );
        set_weight(20);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是一把"HIR"ＳＭ女王"NOR"所使用的鞭子，任何人被這條鞭子抽到的人都會像條發情的狗似的大叫$N"HIR""BLINK"女王！"NOR"。\n");
                set("value", 2000000);
                set("material", "iron");
                set("wield_msg", "$N從私處抽出"MAG"$n"NOR"，朝地上抽了一下附近的男人都忍不住跪下。\n");
                set("unwield_msg", "$N將手中的"MAG"$n"NOR"捲在某處，真不知去了多了附近的男人欲望。\n");
        }

        init_whip(90);
        setup();
}
