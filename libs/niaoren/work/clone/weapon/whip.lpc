// whip.c leos 2000.09.14

#include <weapon.h>
#include <ansi.h>
inherit WHIP;

void create()
{
        set_name("牛皮鞭", ({ "whip" }) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "這是一條用上等牛皮製成的鞭子，攻擊力雖然不強但還算是耐用了。\n");
                set("value", 3);
                set("material", "iron");
                set("wield_msg", "$N從腰間抽出$n，甩了一手好看的鞭法。\n");
                set("unwield_msg", "$N將手中的$n捲在腰際。\n");
        }

        init_whip(15);
        setup();
}
