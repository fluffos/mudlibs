// goodblade.c leos 2000.0913

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name(HIC"斬"BLINK""HIR"鳥"NOR""HIC"刀"NOR, ({ "goodblade","bird" }) );
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 120000);
                set("material", "iron");
                set("long", "這是一很好的"HIC"斬"HIR""BLINK"鳥"NOR""HIC"刀"NOR"，用這把刀的人一定很有眼光！不過對其他的男人就..嘿嘿\n");
                set("wield_msg", "$N抽出一把明晃晃的$n握在手中，臉上出現了自信的笑容，看來不可忽視$N\n");
                set("unwield_msg", "$N將手中的$n插入腰間的刀鞘，周圍的男人都放心多了！\n");
        }
        init_blade(100);
        setup();
}
