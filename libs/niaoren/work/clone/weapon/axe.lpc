// axe.c 斧
//2000.4.18 by leos

#include <weapon.h>
inherit AXE;

void create()
{
        set_name("斧頭", ({ "axe" }));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄普通的斧頭，由上等精鋼打造而成。\n");
                set("value", 1500);
                set("rigidity",100);
                set("material", "steel");
                set("wield_msg", "$N「唰」的一聲抖出一柄$n握在手中。\n");
                set("unwield_msg", "$N將手中的$n卷回腰後。\n");
        }
        init_axe(15);
        setup();
}

