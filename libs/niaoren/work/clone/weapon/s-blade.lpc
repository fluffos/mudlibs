// s-blade.c leos 2000.0913

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name(BLINK"超級小刀"NOR, ({ "sblade" }) );
        set_weight(40);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 10);
                set("material", "iron");
                set("long", "這是把最有名的"BLINK"手牌"HIR"超級小刀"NOR"，只要是念過小學的人都用過這把刀，
拿這把刀來對付敵人的人不是非常強就是非常不要命了，再不然就是在欺侮小動物了。");
                set("wield_msg", "$N從鉛筆盒中拿出$n再打開後握在手中　\n");
                set("unwield_msg", "$N將手中的$n放回了隨身攜帶的鉛筆盒\n");
        }
        init_blade(1);
        setup();
}
