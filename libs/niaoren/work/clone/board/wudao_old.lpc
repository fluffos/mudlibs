// /clone/board/wudao_old.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("壯年組比武報名板", ({ "board" }) );
        set("location", "/d/city/wudao2");
        set("board_id", "wudao_old");
        set("long", "這是一個專供壯年組比武報名的布告板，其他灌水者禁言乙週。\n" );
        setup();
        set("capacity", 100);
}

