// /clone/board/dugu_b.c


inherit BULLETIN_BOARD;

void create()
{
        set_name("問天山莊留言板",({"board"}));
        set("location","/d/dugu/opq_bu");
        set("board_id", "dugu_b");
        set("long", "這是供問天山莊門下留言的板子.\n");
        setup();
        set("capacity", 30);
        replace_program(BULLETIN_BOARD);
}

