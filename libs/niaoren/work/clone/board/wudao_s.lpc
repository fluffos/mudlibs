// /clone/board/wudao_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("幼年組比武報名板", ({ "board" }) );
        set("location", "/d/city/wudao4");
        set("board_id", "wudao_s");
        set("long", "這是一個專供幼年組比武報名的佈告板，其他灌水者禁言乙週。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

