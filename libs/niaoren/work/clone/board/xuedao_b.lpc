// /clone/board/xuedao_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;


void create()
{
        set_name(HIR"血刀門"NOR+"弟子留言板", ({ "board" }) );
        set("location", "/d/xuedao/shandong3");
	set("board_id", "xuedao_b");
        set("long", "這是一個"+HIR"血刀門"NOR+"下交留的留言板。\n" );
	setup();
	set("capacity", 30);
	replace_program(BULLETIN_BOARD);
}

