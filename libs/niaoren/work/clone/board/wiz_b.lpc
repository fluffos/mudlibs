// /clone/board/wiz_b.c

inherit W_BOARD;

void create()
{
        set_name("巫師留言簿", ({ "board" }) );
        set("location", "/d/wizard/wizard_room");
        set("board_id", "wiz_b");
        set("long", "這是一個專供巫師使用的留言板。\n" );
        setup();
        set("capacity", 30);
        replace_program(W_BOARD);
}

