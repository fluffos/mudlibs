// /clone/board/kedian_ca.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("客店留言板", ({ "board" }) );
	set("location", "/d/changan/kedian");
	set("board_id", "kedian_ca");
	set("long", "有有用的話就往這里說，亂灌水殺無赦。\n" );
	setup();
	set("capacity", 100);
	replace_program(BULLETIN_BOARD);
}

