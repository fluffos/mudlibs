// /clone/board/wudao_yung.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("青年組比武報名板", ({ "board" }) );
        set("location", "/d/city/wudao3");
        set("board_id", "wudao_yung");
        set("long", "這是一個專供青年組比武報名的布告板，其他灌水者禁言乙週。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

