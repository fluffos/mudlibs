// /clone/board/news_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("新聞發布板", ({ "board" }) );
        set("location", "/d/wizard/newsroom");
        set("board_id", "news_b");
        set("long", "這是一個巫師們發布新聞的發布板。\n" );
        setup();
        set("capacity",200);
        replace_program(BULLETIN_BOARD);
}
