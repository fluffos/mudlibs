// /clone/board/news_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("客人留言簿", ({ "board" }) );
        set("location", "/d/welcome/wel1");
        set("board_id", "guest_b");
        set("long", "這是一個讓前來胖胖工作室的客人留言的本子。\n" );
        setup();
        set("capacity",200);
        replace_program(BULLETIN_BOARD);
}
