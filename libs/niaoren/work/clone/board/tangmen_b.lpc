// /clone/board/tangmen_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
	set_name(HIM"唐門留言冊"NOR, ({ "board" }) );
	set("location", "/d/tangmen/damen");
	set("board_id", "tangmen_b");
	set("long", "這是一個專供唐門弟子使用的留言簿。\n" );
	setup();
	set("capacity",100);
	replace_program(BULLETIN_BOARD);
}
