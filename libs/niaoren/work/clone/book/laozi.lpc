#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( "道德經「[33m總訣篇[0m」", ({ "jing", "daode jing" }));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "\t-總訣篇-\n"
                        "這是一本厚重的黃皮書，外表看起有點破舊。\n"
                        "大概是轉手多人之故吧！寫書的作者已經不可考了。\n\n"
                        "傳說是武當的一位前輩所寫。\n"
                        "後因修道大成，終入仙道，成道為神。\n"
                );
                set("value", 500);
                set("material", "paper");
                set("skill", ([
                        "name": "taoism",                  // name of the skill
                        "exp_required":  100000,           // minimum combat experience required
                        "jing_cost":    20+random(20),     // jing cost every time study this
                        "difficulty":   15,                // the base int to learn this skill
                        "max_skill":    250,               // the maximum level you can learn
                ]) );
        }
}
