// kuikuabook.c leos
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name( HIR"葵花寶典上冊"NOR,({ "kuikua1", "kuikuabook", "book"}));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long","這就是武林第一秘籍《葵花寶典上冊》，裡面卻是一遍空白。\n");
                set("value", 500);
                set("material", "paper");
        }
}

