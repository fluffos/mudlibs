#define RMK_VERSION "(v1.0)" 
 
inherit ITEM; 
inherit F_AUTOLOAD; 
 
string *special_props = ({ 
        "name", "long" }); 
 
int save_room_file(string file,string str); 
 
void create() 
{ 
        set_name("物件編輯器" + RMK_VERSION, ({ "objmaker", "maker" }) ); 
        set_weight(100); 
        set("unit", "個" ); 
        set("long", @LONG 
這是一個用來「快速」制造房間的工具，幫助時間不多或有嚴重  lag 的巫師 
利用線上輸入制造簡單的房間，不過如果你想提高自己區域房間的品質，最好 
不要太依賴這個東西，你可以使用以下几個指令： 
 
mkobj <物件檔名> 
 
    造出一個「廢物」放在身上，之後你可以 rrset 設定物件的    敘述或 
屬性。 
 
rset1 <物件屬性> <屬性內容> 
 
    設定你身上的臨時物件屬性，如 name(not short!)，long,id 等 set 內 
有引號的set 。 
 
 
saveobj 
 
    將你身上的臨時物件存檔為正式物件。 
 
rset2 <物件屬性> <屬性內容> 
        設定那些 set 內沒有引號的屬性，如 no_drop,no_get,value等。 
LONG 
        ); 
} 
 
int query_autoload() { return 1; } 
 
void init() 
{ 
        if( wizardp(environment()) ) { 
                seteuid(getuid(environment())); 
                add_action("do_mkobj", "mkobj"); 
                add_action("do_rset", "rset1"); 
                add_action("do_saveobj", "saveobj"); 
                add_action("do_rrset","rset2"); 
        } 
} 
 
int do_mkobj(string arg) 
{ 
        string file,code; 
        object file1; 
 
        if( sscanf(arg, "%s", file)!=1 ) 
return notify_fail("指令格式：mkobj <物件檔名>\n"); 
        seteuid(geteuid(this_player())); 
        file = resolve_path(this_player()->query("cwd"), file) + ".lpc"; 
        if( file_size(file)!=-1 ) 
                return notify_fail("檔案 " + file + " 已經存在了。\n"); 
        if( !write_file(file ,@OBJ_CODE 
