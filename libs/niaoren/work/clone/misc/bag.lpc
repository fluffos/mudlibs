/* <SecCrypt CPL V3R05> */
 
// bag.c

inherit ITEM;

void create()
{
   set_name("袋子", ({ "bag" }) );
   set_weight(50000);
   set_max_encumbrance(8000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "個");
     set("long", "這是一個用來裝東西的布袋﹝\n");
     set("value", 1);
   }
}

int is_container() { return 1; }
