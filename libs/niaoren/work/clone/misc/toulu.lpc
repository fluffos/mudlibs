// toulu.c

inherit ITEM;

int decayed;

void create()
{
        set_name("無名頭顱", ({ "toulu" }) );
        set("long", "這是一具無名頭顱。\n");
        set("short","頭顱");
        set("unit", "顆" );
        set_weight(100);
        decayed = 0;
        if( clonep(this_object()) ) call_out("decay", 180, 1);
}

// int is_corpse() { return decayed < 2; }
// int is_character() { return decayed < 1; }
// int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase)
{
        decayed = phase;
        switch(phase) {
                case 1:
                        say( query("name") + "開始腐爛了，發出一股難聞的惡臭。\n" );
                        switch(query("gender")) {
                                case "男性":{
                                        set_name("腐爛的男頭顱", ({ "toulu", "頭顱" }) );
					            break;
							 }
                                case "女性":{
                                        set_name("腐爛的女頭顱", ({ "toulu", "頭顱" }) );
							 break;
							 }
                                default:{
                                        set_name("腐爛的頭顱", ({ "toulu", "頭顱" }) );
						   break;
						    }
//by maxim jiang 1997.7.15

                        }
                        set("long","這個頭顱顯然已經在這里有一段時間了，正散發著一股腐爛的味道。\n");
                        call_out("decay", 120, phase + 1);
                        break;
                case 2:
                        say( query("name") + "被風吹乾了，變成一具骸骨。\n" );
                        set_name("一具枯乾的頭骨", ({ "tougu", "頭骨" }) );
                        set("long", "這副頭骨已經躺在這里很久了。\n");
                        call_out("decay", 60, phase + 1);
                        break;
                case 3:
                        say( "一陣風吹過，把" + query("name") + "化成骨灰吹散了。\n" );
                        if( environment() ) {
                                object *inv;
                                int i;

                                inv = all_inventory(this_object());
                                for(i=0; i<sizeof(inv); i++) inv[i]->move(environment());
                        }
                        destruct(this_object());
                        break;
        }
}
