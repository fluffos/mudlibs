// skeleton.c leos
#include <ansi.h>;
inherit ITEM;

void create()
{
        set_name("骸骨", ({ "ske"  }));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "具");
                set("long", "這是一具前人的骸骨。\n");
                set("value", 500);
                set("material", "cloth");
        }
        set("skeleton", 1);
}

void init()
{
        if( this_player() == environment() )
        {
                add_action("do_open", "find");
                add_action("do_open", "unpack");
                add_action("do_open", "open");
        }
}

int do_open(string arg)
{
        object me, book;
        object where;

        if ( !arg )
        {
                return notify_fail("什麼\？\n");
        }
        if ( query("skeleton") < 1)
        {
                return notify_fail("骸骨裡面什麼\也沒有了。\n");
        }

        me = this_player();
        if ( arg == "ske")
        {
                where = environment(me);
message("channel:rumor", MAG"【謠言】某人："+this_player()->query("name")+"找到葵花寶典上冊啦。\n"NOR, users());
                message_vision(
"$N仔細地把骸骨翻來看時，發現裡面竟然有本薄薄的經書，雖長期藏在這裡，書頁仍然完好無損。\n", me);
                book = new("/clone/book/kuikuabook");
                book->move(file_name(where));
                add("skeleton",-1);
        }
        return 1;
}
