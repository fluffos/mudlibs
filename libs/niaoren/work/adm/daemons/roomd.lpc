// roomd.c

// Written by Doing Lu 1998/11/14



// 接受來自SECURITD的查詢，返回一個object存盤的文檔名，SECURITYD比較這個

// 文檔名和來自object的請求寫入的文檔名，如果一致，方可寫入。



void create()

{

	seteuid(getuid());

}



string get_file_name(object ob)

{

	string file;

	if (objectp(ob))

	{		

		file = base_name(ob) + ".sav"; 

		// 如果這是一個普通的可紀錄的房屋，存盤文件要存放在/data/room中

		// 如果不是紀錄的房屋，又不是私有房屋，不能紀錄。

		if (ob->query("recordable_room")) file = "/data/room" + file; else

		if (! ob->query("private_room")) file = "";

	} else

		file = "";



	return file;

}

