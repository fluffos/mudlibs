#include <ansi.h>
#include <command.h>
#include <login.h>
#include <runtime_config.h>
#include <mudlib.h>

inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;
int mad_lock = 0;
string *banned_name = ({
  "你", "我", "他", "她", "它",
  "時空",
});
void logon_main(string no_use, object ob);
void get_id(string arg, object ob);
void confirm_id(string yn, object ob);
object make_body(object ob);
void init_new_player(object user);
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);

void random_gift(mapping my) {
  int i;
  int tmpstr, tmpint, tmpcon, tmpdex;
  tmpstr = tmpint = tmpcon = tmpdex = 10;

  for (i = 0; i < 40; i++) {
    switch (random(4)) {
      case 0: tmpstr++; break;
      case 1: tmpint++; break;
      case 2: tmpcon++; break;
      case 3: tmpdex++; break;
    }
  }
  if (tmpstr <= 30) my["str"] = tmpstr; else my["str"] = 30;
  if (tmpint <= 30) my["int"] = tmpint; else my["int"] = 30;
  if (tmpcon <= 30) my["con"] = tmpcon; else my["con"] = 30;
  if (tmpdex <= 30) my["dex"] = tmpdex; else my["dex"] = 30;
  // next 2 are randomly selected
  my["kar"] = 10 + random(21);
  my["per"] = 10 + random(21);
}

void create() {
  seteuid(getuid());
  set("channel_id", "連線精靈");
}

void logon(object ob) {
  write(read_file(WELCOME));
  write("輸入任意鍵繼續...");
  input_to((: logon_main :), ob);
}

void logon_main(string no_use, object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt, i_user, log_num = 0;
  string user_num;
  write(read_file("/adm/etc/cctxinfo") + "\n");
  if (mad_lock == 1) {
    write("現在時空已經封閉了，不能進入！！ \n");
    destruct(ob);
    return;
  }
  if (BAN_D->is_banned(query_ip_number(ob)) == 1) {
    write("你的地址在本 MUD 不受歡迎。\n");
    destruct(ob);
    return;
  }
  UPTIME_CMD->main();
  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i])) {
      if (usr[i]->query("env/invisibility") == 0)
        wiz_cnt++;
    } else ppl_cnt++;
  }
  user_num = read_file(__DIR__ "users", 1);
  i_user = atoi(user_num);
  printf(BBLK + HIW "自二０００年八月起，" + CHINESE_MUD_NAME + "共有%s人次來訪。\n", chinese_number(i_user));
  i_user = i_user + 1;
  user_num = sprintf("%d", i_user);
  write_file(__DIR__ "users", user_num, 1);
  user_num = read_file(__DIR__ "iduser", 1);
  i_user = atoi(user_num);
  printf(CHINESE_MUD_NAME + "共有" HIB "%s個玩家" NOR "。\n", chinese_number(i_user));
  printf("目前線上有" HIR " %d 位巫師及 " HIC "%d 位玩家" NOR "在線上，以及" MAG " %d 位使用者" NOR "嘗試連線中。\n\n",
    wiz_cnt, ppl_cnt, login_cnt);
  // Same-IP concurrent-login cap; loopback (local/WASM play) is always
  // exempt so it never gets blocked by this per-IP gate.
  if (query_ip_name(ob) != "127.0.0.1" && query_ip_name(ob) != "localhost" &&
    query_ip_name(ob) != "::1") {
    for (i = 0; i < sizeof(usr); i++)
      if (ob != usr[i])
        if (
          (
            //這里設置一些特別允許的可以不限制的站點(必須是有固定IP的站點)
            query_ip_name(ob) != "10.163.180.3" &&
            query_ip_name(ob) != "10.163.180.2"
          )
          &&
          query_ip_name(ob) == query_ip_name(usr[i])
        )
          log_num++; if (log_num >= 3) {
            write(HIR + "    你只允許同時登陸三個IP，請退出其他帳號再試。\n" + NOR);
            destruct(ob);
            return;
          }
  }
  write("您的英文名字：");
  input_to((: get_id :), ob);
}

void get_id(string arg, object ob) {
  object ppl;
  object *usr;
  int i, wiz_cnt;
  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("您的英文名字：");
    input_to("get_id", ob);
    return;
  }

  usr = users();
  wiz_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (wizardp(usr[i]))
      wiz_cnt++;
  }
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && (sizeof(users()) - wiz_cnt) >= 120) {
    ppl = find_body(arg);

    if (!ppl || !interactive(ppl)) {
      write("對不起，" + CHINESE_MUD_NAME + "的使用者已經太多了，請待會再來。\n");
      destruct(ob);
      return;
    }
  }

  if (wiz_level(arg) < wiz_lock_level) {
    write("對不起，" + CHINESE_MUD_NAME + "目前限制巫師等級 " + WIZ_LOCK_LEVEL
      + " 以上的人才能連線。\n");
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("無法正常設置用戶名。\n");
    destruct(ob);
    return;
  }

  if (arg == "guest") {
    // If guest, let them create the character.
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("這個名字已經有人注冊了，請輸入密碼：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("您的人物檔出了一些問題，請利用guest(密碼:guest)人物通知巫師處理。\n");
    destruct(ob);
    return;
  }
  write("使用 " + (string)ob->query("id") + " 這個名字將會創造一個新的人物，您確定嗎(y/n)？");
  input_to("confirm_id", ob);
}

void get_passwd(string pass, object ob) {
  string my_pass;
  object user;
  int time_rl;
  string temps;
  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密碼錯誤！\n");
    destruct(ob);
    return;
  }
  time_rl = time() - ob->query("last_on");
  temps = query_ip_number(ob);
  // Check if logout recently -- anti-flood reconnect throttle. Loopback
  // is always exempt; everything else (including an empty/malformed
  // value the driver couldn't resolve) is fail-closed and still
  // subject to the throttle rather than silently let through.
  if (!(stringp(temps) && (temps == "127.0.0.1" || temps == "::1" ||
    (strlen(temps) >= 4 && temps[0..3] == "127."))) &&
    time_rl >= 0 && time_rl <= 16) {
    temps = sprintf("你距上次退出僅 %d tick.\n", time_rl);
    write(temps);
    if ((string)SECURITY_D->get_status(ob->query("id")) == "(player)") {
      write("對不起，為了降低系統負荷，請稍后再login，多謝您的合作。\n");
      destruct(ob);
      return;
    } else {
      write("雖然你是巫師，也不要頻繁的login哦。\n");
    }
  }

  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write("您要將另一個連線中的相同人物趕出去，取而代之嗎？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s loggined from %s (%s)\n", user->query("name"),
        query_ip_name(ob), ctime(time())));
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write("請您重新創造這個人物。\n");
  confirm_id("y", ob);
}

void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要將另一個連線中的相同人物趕出去，取而代之嗎？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }
  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，歡迎下次再來。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人從別處( " + query_ip_number(ob)
      + " )連線取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s replaced by %s (%s)\n", user->query("name"),
      query_ip_name(ob), ctime(time())));
  }
  // Kick out tho old player.
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }
  reconnect(ob, user);
}

void confirm_id(string yn, object ob) {
  if (yn == "") {
    write("使用這個名字將會創造一個新的人物，您確定嗎(y/n)？");
    input_to("confirm_id", ob);
    return;
  }
  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那么請重新輸入您的英文名字：");
    input_to("get_id", ob);
    return;
  }
  write(@TEXT

請輸入您的高姓大名，由于這個名字代表你的人物，而且以后不能更改，
務必慎重擇名（不雅觀的姓名將被刪除）。另：請不要選擇金庸小說中
已有人物姓名。
(除了名字之外，本 mud 有許多取綽號、別稱的設計，所以鄭重建議您
 取一個比較像名字的中文名字。)

TEXT
  );
  write("您的中文名字：");
  input_to("get_name", ob);
}

void get_name(string arg, object ob) {
  if (!check_legal_name(arg)) {
    write("您的中文名字：");
    input_to("get_name", ob);
    return;
  }
  ob->set("name", arg);
  write("請設定您的密碼：");
  input_to("new_password", 1, ob);
}

void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write("密碼的長度至少要五個字符，請重設您的密碼：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("請再輸入一次您的密碼，以確認您沒記錯：");
  input_to("confirm_password", 1, ob);
}

void confirm_password(string pass, object ob) {
  mapping my;
  string old_pass;
  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您兩次輸入的密碼并不一樣，請重新設定一次密碼：");
    input_to("new_password", 1, ob);
    return;
  }
  write(@TEXT

一個人物的天賦對于他或她所修習的武藝息息相關。俠馳騁江湖中的人物大多具有
以下四項天賦：
        膂力：影響攻擊能力及負荷量的大小。
        悟性：影響學習武功秘籍的速度及理解師傅的能力。
        根骨：影響體力恢復的速度及升級后所增加的體力。
        身法：影響防御及躲避的能力。

TEXT);
  my = ([]);
  random_gift(my);
  printf("\n膂力[%d]， 悟性[%d]， 根骨[%d]， 身法[%d]\n",
    my["str"], my["int"], my["con"], my["dex"]);
  write("您接受這一組天賦嗎？");
  input_to("get_gift", ob, my);
}

void get_gift(string yn, object ob, mapping my) {
  if (yn[0] != 'y' && yn[0] != 'Y') {
    random_gift(my);
    printf("\n力量[%d]， 悟性[%d]， 根骨[%d]， 身法[%d]\n",
      my["str"], my["int"], my["con"], my["dex"]);
    write("您同意這一組天賦嗎？");
    input_to("get_gift", ob, my);
  }
  if (yn[0] == 'y' || yn[0] == 'Y') {
    write("\n您的電子郵件地址：");
    input_to("get_email", ob, my);
  }
}

void get_email(string email, object ob, mapping my) {
  object user;
  string id, address;
  write("\n");
  if (email == "" || strsrch(email, "@") == -1 ||
    sscanf(email, "%s@%s", id, address) != 2 || strsrch(address, ".") == -1) {
    write("電子郵件地址需要是 id@address 的格式。\n");
    write("您的電子郵件地址：");
    input_to("get_email", ob, my);
    return;
  }
  ob->set("email", email);
  ob->set("registered", 1);
  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob)))
    return;
  user->set("str", my["str"]);
  user->set("dex", my["dex"]);
  user->set("con", my["con"]);
  user->set("int", my["int"]);
  ob->set("registered", 1);
  user->set("registered", 1);
  write("您要扮演男性(m)的角色或女性(f)的角色？");
  input_to("get_gender", ob, user);
}

void get_gender(string gender, object ob, object user) {
  int id_temp; string id_num;
  write("\n");
  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, user);
    return;
  }
  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("對不起，您只能選擇男性(m)或女性(f)的角色：");
    input_to("get_gender", ob, user);
    return;
  }
  log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
    query_ip_name(ob), ctime(time())));
  catch(init_new_player(user));
  enter_world(ob, user);
  //統計注冊人數
  id_num = read_file(__DIR__ "iduser", 1);
  id_temp = atoi(id_num); id_temp = id_temp + 1;
  id_num = sprintf("%d", id_temp);
  write_file(__DIR__ "iduser", id_num, 1);
  write("\n");
}

object make_body(object ob) {
  string err;
  object user;
  int n;
  user = new(ob->query("body"));
  if (!user) {
    write("現在可能有人正在修改使用者物件的程式，無法進行復制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

void init_new_player(object user) {
  user->set("title", "普通百姓");
  user->set("birthday", time());
  user->set("potential", 99);
  user->set("degree", "文盲");
  user->set("channels", ({ "chat", "rumor", "es", "new" }));

}


varargs void enter_world(object ob, object user, int silent) {
  object cloth, room, mailbox, site;
  string startroom;
  object login_ob;

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  user->set("registered", ob->query("registered"));
  exec(user, ob);
  write("\n目前權限：" + wizhood(user) + "\n");
  user->setup();
  if (!user->query("food") && !user->query("water") && user->query("age") == 14) {
    user->set("food", user->max_food_capacity());
    user->set("water", user->max_water_capacity());
  }
  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();
  cloth = new("/clone/misc/cloth");
  cloth->move(user);
  cloth->wear();

  // Give user a mailbox.
  // Modified by Hop at 1997.04.10
  mailbox = new("clone/misc/mailbox");
  mailbox->move(user);
  // End of modification
  if (!silent) {
    write(read_file(MOTD));
    write("  \n" NOR);
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom")))
      startroom = "/d/city/kedian";
    //巫師必須先到休息室報到
    if (wiz_level(user->query("id")) > 1) {
      user->move("/d/wizard/wizard_room");
      CHANNEL_D->do_channel(user, "wiz*",
        sprintf("連線進入" + get_config(__MUD_NAME__) + "。"));
    } else {
      if (!catch(load_object(startroom)))
        user->move(startroom);
      else {
        user->move(START_ROOM);
        startroom = START_ROOM;
        user->set("startroom", START_ROOM);
      }
      tell_room(startroom, user->query("name") + "連線進入俠客行１００。\n", ({ user }));
    }
  }
  login_ob = new(LOGIN_OB);
  login_ob->set("id", user->query("id"));
  login_ob->restore();
  write("你上次連線是從" + HIR + login_ob->query("last_from") + NOR + " on " +
    HIR + ctime(login_ob->query("last_on")) + NOR + "\n");
  destruct(login_ob);
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s由%s連線進入。[" + ctime(time()) + "]",
      user->name() + "(" + user->query("id") + ")", query_ip_name(user)));
  UPDATE_D->check_user(user);
  //檢查是否進入排行榜！add by jackyboy@cctx 1999/3/8
  TOPTEN_D->topten_checkplayer(user);
  //記錄連線時的exp和time add by jackyboy@cctx 1999/3/8
  user->set_temp("temp_exp", user->query("combat_exp"));
  user->set_temp("temp_time", time());
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);
  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") + "重新連線回鳥世界。\n",
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s由%s重新連線進入。", user->query("name") + "(" + user->query("id") +
      ")", query_ip_name(user)));
  UPDATE_D->check_user(user);
}

int check_legal_id(string id) {
  int i, j;
  string *bad_word = ({ "fuck", "shit", "sex", "father", "mother" });
  i = strlen(id);
  if ((strlen(id) < 3) || (strlen(id) > 12)) {
    write("對不起，你的英文名字必須是 3 到 12 個英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("對不起，你的英文名字只能用英文字母。\n");
      return 0;
    }
  for (j = 0; j < sizeof(bad_word); j++)
    if (strsrch(id, bad_word[j]) != -1) {
      write("對不起，請不要用含著" HIY + BLINK + bad_word[j] + NOR "這樣的ID！\n" +
        "如果你確實要使用該ID，請與巫師聯系！\n");
      return 0;
    }

  return 1;
}

int check_legal_name(string name) {
  int i, j;
  string *bad_word = ({ "爸", "媽", "姨", "妓", "爺", "奶" });
  i = strlen(name);
  if ((strlen(name) < 1) || (strlen(name) > 6)) /* chars, was GBK bytes 2..12 */ {
    write("對不起，你的中文名字必須是 1 到 6 個中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("對不起，你的中文名字不能用控制字元。\n");
      return 0;
    }
    if (!is_chinese(name[i..<0])) /* every char; was GBK lead-byte stride */ {
      write("對不起，請您用「中文」取名字。\n");
      return 0;
    }
  }
  for (j = 0; j < sizeof(bad_word); j++)
    if (strsrch(name, bad_word[j]) != -1) {
      write("對不起，請不要用含著" HIY + BLINK + bad_word[j] + NOR "這樣的名字！\n" +
        "如果你確實要使用該名字，另起一個名字進入后請巫師來修改！\n");
      return 0;
    }
  if (member_array(name, banned_name) != -1) {
    write("對不起，這種名字會造成其他人的困擾。\n");
    return 0;
  }
  return 1;
}

object find_body(string name) {
  object ob, *body;
  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i]) && getuid(body[i]) == name)
      return body[i];
  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}

int set_madlock(int setmark) {
  if (wiz_level(this_player(1)) < wiz_level("(arch)"))
    return 0;
  if (setmark == 1)
    mad_lock = 1;
  else
    mad_lock = 0;
  return 1;
}

int get_madlock() {
  return mad_lock;
}
