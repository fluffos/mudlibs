// rankd.c
// 1996-02-15 dts ranking related to "shen"

#include <ansi.h>

string query_rank(object ob)
{
        mapping fam;

        int shen;
        int budd;

        if( ob->is_ghost() ) 
                return BLINK "【 鬼  魂 】" NOR;
        shen = ob->query("shen");
        if ( (fam = ob->query("family")) && fam["family_name"] == "少林派" ) 
        budd = ob->query_skill("buddhism",1);

        switch(ob->query("gender")) {
        case "蟲蟲":
                switch(wizhood(ob)) {
                case "(admin)":         
                        return HIW "【除蟲天師】" NOR;
                                    }
                                    }



        switch(ob->query("gender")) {
        case "女性":
                switch(wizhood(ob)) {
                case "(admin)":         
                        return HIW "【 女天帝 】" NOR;
                case "(arch)":          
                        return HIR "【 大巫女 】" NOR;
                case "(wizard)":        
                        return HIY "【 巫  女 】" NOR;
                case "(immortal)":      
                        return HIC "【 小巫女 】" NOR;
                default:
                        if( ((int)ob->query("PKS") > 30) )
                                return "东女殺人魔东";
                        else if (shen >= 40000000)
                                return BLINK HIB "奵練工力狂奵" NOR;
                        else if (shen >= 20000000)
                                return BLINK HIB "奵仙流人物奵" NOR;
                        else if (shen >= 10000000)
                                return HIB "奵武林傳說奵" NOR;
                        else if (shen >= 5000000)
                                return HIB "奵隱世高人奵" NOR;
                        else if (shen >= 2000000)
                                return HIG "【武林護法】" NOR;
                        else if (shen >= 1000000)
                                return HIY "【 女聖俠 】" NOR;
                        else if (shen >= 500000)
                                return MAG "【曠世女俠】" NOR;
                        else if (shen >= 50000)
                                return YEL "【 女大俠 】" NOR;
                        else if (shen >= 5000)
                                return HIC "【 女  俠 】" NOR;
                        else if (shen >= 500)
                                return HIC "【 女少俠 】" NOR;
                        else if (shen <= -15000000)
                                return BLINK MAG "东 女魔神 东" NOR;
                        else if (shen <= -6000000)
                                return HIM "东大 魔 王东" NOR;
                        else if (shen <= -2500000)
                                return HIR "东 女魔王 东" NOR;
                        else if (shen <= -1000000)
                                return HIR "东 大魔頭 东" NOR;
                        else if (shen <= -500000)
                                return HIR "东 女魔頭 东" NOR;
                        else if (shen <= -50000)
                                return HIR "东 女惡人 东" NOR;
                        else if (shen <= -10000)
                                return HIR "东 大姐頭 东" NOR;
                        else if (shen <= -5000)
                                return HIR "东 女流氓 东" NOR;
                        else if (shen <= -500)
                                return HIR "东 女混混 东" NOR;
                        else if( (int)ob->query("thief") > 10 ) 
                                return "𦌵女 慣 竊𦌵";
                        else
                        switch(ob->query("class")) {
                        case "bonze":   
                                return "遌 尼  姑 遌";
                        case "taoist":  
                                return "【 女  冠 】";
                        case "bandit":  
                                return "【 女飛賊 】";
                        case "dancer":  
                                return "【 舞  妓 】";
                        case "scholar": 
                                return "【 才  女 】";
                        case "officer": 
                                return "【 女  官 】";
                        case "fighter": 
                                return "【 女武者 】";
                        case "swordsman":       
                                return "【 女劍士 】";
                        case "alchemist":       
                                return "【 女方士 】";
                        case "shaman":          
                                return "【 女巫醫 】";
                        case "beggar":          
                                return "𦌵女叫化子𦌵";
                        default:                        
                                return "【 平  民 】";
                        }
                }
        default:
                switch(wizhood(ob)) {
                case "(admin)":                 
                        return HIW "【 大鳥人 】" NOR;
                case "(arch)":                  
                        return HIY "【 大巫師 】" NOR;
                case "(wizard)":                
                        return HIY "【 巫  師 】" NOR;
                case "(immortal)":
                        return HIC "【 新鳥人 】" NOR;
                default:
                        if( ((int)ob->query("PKS") > 30) )
                                return "【 殺人魔 】";
                        else if (shen >= 40000000)
                                return BLINK HIB "奵練工力狂奵" NOR;
                        else if (shen >= 20000000)
                                return BLINK HIB "奵仙流人物奵" NOR;
                        else if (shen >= 10000000)
                                return HIB "奵武林傳說奵" NOR;
                        else if (shen >= 5000000)
                                return HIB "奵隱世高人奵" NOR;
                        else if (shen >= 2000000)
                                return HIG "【武林護法】" NOR;
                        else if (shen >= 1000000)
                                return HIY "【 聖  俠 】" NOR;
                        else if (shen >= 500000)
                                return MAG "【曠世大俠】" NOR;
                        else if (shen >= 50000)
                                return YEL "【 大  俠 】" NOR;
                        else if (shen >= 5000)
                                return HIC "【 俠  客 】" NOR;
                        else if (shen >= 500)
                                return HIC "【 少  俠 】" NOR;
                        else if (shen <= -15000000)
                                return BLINK MAG "东 魔  神 东" NOR;
                        else if (shen <= -6000000)
                                return HIM "东大 魔 王东" NOR;
                        else if (shen <= -2500000)
                                return HIR "东 魔  王 东" NOR;
                        else if (shen <= -1000000)
                                return HIR "东 大魔頭 东" NOR;
                        else if (shen <= -500000)
                                return HIR "东 魔  頭 东" NOR;
                        else if (shen <= -50000)
                                return HIR "东 惡  人 东" NOR;
                        else if (shen <= -10000)
                                return HIR "东 流氓頭 东" NOR;
                        else if (shen <= -5000)
                                return HIR "东 流  氓 东" NOR;
                        else if (shen <= -500)
                                return HIR "东 小混混 东" NOR;
                        else if( (int)ob->query("thief") > 10 ) 
                                return "𦌵 慣  竊 𦌵";
                        else
                                switch(ob->query("class")) {
                                case "bonze":           
                                        if (budd >= 150)
                                                return HIY "【 長  老 】" NOR;
                                        else if (budd >= 120)
                                                return HIY "遌 聖  僧 遌" NOR;
                                        else if (budd >= 90)
                                                return HIY "遌 羅  漢 遌" NOR;
                                        else if (budd >= 60)
                                                return HIY "遌 尊  者 遌" NOR;
                                        else if (budd >= 40)
                                                return HIY "遌 禪  師 遌" NOR;
                                        else if (budd >= 30)
                                                return HIY "遌 比  丘 遌" NOR;
                                        else
                                                return "遌 僧  人 遌";
                                case "taoist":          
                                        return "遌 道  士 遌";
                                case "bandit":          
                                        return "【 盜  賊 】";
                                case "scholar":         
                                        return "【 書  生 】";
                                case "officer":         
                                        return "【 官  差 】";
                                case "fighter":         
                                        return "【 武  者 】";
                                case "swordsman":       
                                        return "【 劍  士 】";
                                case "alchemist":       
                                        return "遌 方  士 遌";
                                case "shaman":          
                                        return "遌 巫  醫 遌";
                                case "beggar":          
                                        return "𦌵 叫化子 𦌵";
                                default:                
                                        return "【 平  民 】";
                                }
                }
        }
}

string query_score(object ob) {
    int score;
    score = ob->query("score");
    if (score >= 15000)
        return HIC+"武林霸主"+NOR;
    else if (score >= 8000)
        return HIB+"武林公爵"+NOR;
    else if (score >= 4500)
        return HIR+"武林侯爵"+NOR;
    else if (score >= 2500)
        return HIG+"武林伯爵"+NOR;
    else if (score >= 1600)
        return HIM+"武林子爵"+NOR;
    else if (score >= 1000)
        return MAG+"武林男爵"+NOR;
    else if (score >= 500)
        return HIY+"武林名人"+NOR;
    else if (score >= 100)
        return HIB+"地方名人"+NOR;
    else if (score <= -100)
        return HIR BLINK+"江湖敗類"+NOR;
    else if (score <= -10)
        return HIC+"武林爛人"+NOR;
    else
        return HIW+"無名小卒"+NOR;
}

string query_respect(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/respect")) )
                return str;

        age = ob->query("age");
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 18 ) return "小師太";
                                else return "師太";
                                break;
                        case "taoist":
                                if( age < 18 ) return "小仙姑";
                                else return "仙姑";
                                break;
                        default:
                                if( age < 18 ) return "小姑娘";
                                else if( age < 50 ) return "姑娘";
                                else return "婆婆";
                                break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 18 ) return "小師父";
                                else return "大師";
                                break;
                        case "taoist":
                                if( age < 18 ) return "道兄";
                                else return "道長";
                                break;
                        case "fighter":
                        case "swordsman":
                                if( age < 18 ) return "小老弟";
                                else if( age < 50 ) return "壯士";
                                else return "老前輩";
                                break;
                        default:
                                if( age < 20 ) return "小兄弟";
                                else if( age < 50 ) return "壯士";
                                else return "老爺子";
                                break;
                        }
        }
}

string query_rude(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/rude")) )
                return str;

        age = ob->query("age");
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                return "賊尼";
                                break;
                        case "taoist":
                                return "妖女";
                                break;
                        default:
                                if( age < 30 ) return "小賤人";
                                else return "死老太婆";
                                break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "死禿驢";
                                else return "老禿驢";
                                break;
                        case "taoist":
                                return "死牛鼻子";
                                break;
                        default:
                                if( age < 20 ) return "小王八蛋";
                                if( age < 50 ) return "臭賊";
                                else return "老匹夫";
                                break;
                        }
        }
}

string query_self(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/self")) )
                return str;

        age = ob->query("age");
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "貧尼";
                                else return "老尼";
                                break;
                        default:
                                if( age < 30 ) return "小女子";
                                else return "妾身";
                                break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "貧僧";
                                else return "老納";
                                break;
                        case "taoist":
                                return "貧道";
                                break;
                        default:
                                if( age < 50 ) return "在下";
                                else return "老頭子";
                                break;
                        }
        }
}

string query_self_rude(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/self_rude")) )
                return str;

        age = ob->query("age");
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "貧尼";
                                else return "老尼";
                                break;
                        default:
                                if( age < 30 ) return "本姑娘";
                                else return "老娘";
                                break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "大和尚我";
                                else return "老和尚我";
                                break;
                        case "taoist":
                                return "本山人";
                                break;
                        default:
                                if( age < 50 ) return "大爺我";
                                else return "老子";
                                break;
                        }
        }
}
string query_close(object ob)
{
        int a1, a2;

        if (objectp(ob))
        {
                if (a2 = (int)ob->query("mud_age"))
                {
                        a1 = this_player()->query("mud_age");
                } else 
                {       
                        a1 = this_player()->query("age");
                        a2 = ob->query("age");
                }
        } else 
        {       
                a1 = this_player()->query("age");
                a2 = 0;
        }
                                                        
        switch (ob->query("gender")) {
        case "女性" :
                if (a1 >= a2)
                        return "妹妹";
                else
                        return "姐姐";
                break;
        default :
                if (a1 >= a2)
                        return "弟弟";
                else
                        return "哥哥";
        }
}

string query_self_close(object ob)
{
        int a1, a2;
        if (objectp(ob))
        {
                if (a2 = (int)ob->query("mud_age"))
                {
                        a1 = this_player()->query("mud_age");
                } else 
                {       
                        a1 = this_player()->query("age");
                        a2 = ob->query("age");
                }
        } else 
        {       
                a1 = this_player()->query("age");
                a2 = 0;
        }
                
        switch (this_player()->query("gender")) {
        case "女性" :
                if (a1 >= a2)
                        return "姐姐我";
                else
                        return "小妹我";
                break;
        default :
                if (a1 >= a2)
                        return "愚兄我";
                else
                        return "小弟我";
        }
        return "錯誤：rankd.c -> query_self_close()\n";
}
//=========================以下為了完成imud的emote功能而補充=====================
string imud_query_self_close(object ob,int age,string gender)
{
        int a1, a2;
        if (objectp(ob))
        {
                a1=ob->query("age");
                a2=age;
        } 
        else 
        {       
                a1 = this_player()->query("age");
                a2 = 0;
        }
        switch (gender) {
        case "女性" :
                if (a1 >= a2)
                        return "姐姐我";
                else
                        return "小妹我";
                break;
        default :
                if (a1 >= a2)
                        return "愚兄我";
                else
                        return "小弟我";
        }
}

string imud_query_close(object ob,int age,string gender)
{
        int a1, a2;

        if (objectp(ob))
        {
                a1=ob->query("age");
                a2=age;
        } else 
        {       
                a1 = this_player()->query("age");
                a2 = 0;
        }
                                                        
        switch (gender) {
        case "女性" :
                if (a1 >= a2)
                        return "妹妹";
                else
                        return "姐姐";
                break;
        default :
                if (a1 >= a2)
                        return "弟弟";
                else
                        return "哥哥";
        }
}
