// gun.c




#include <ansi.h>
#include <weapon.h>




inherit BLADE;
inherit F_CLEAN_UP;




void init()
{
        add_action("do_aim","aim");
        add_action("do_fire","fire");
	add_action("do_moto","moto");
	add_action("do_spy","spy");
}




void create()
{
        set_name("迷你機關槍", ({ "qiang", "gun","temp"}) );




        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("bullet", 10000);
		set("value", 0);
                set("material", "steel");
                set("long", "這是一把阿諾用過的迷你機關槍。\n");
                set("wield_msg", "$N端出一把$n，取出一箱子彈扛在肩上。\n");
                set("unequip_msg", "$N放下手中$n，取下子彈箱。\n");
        }
        init_blade(100);
        setup();
}




int do_spy(string arg)
{	
	object me,ob;
	mapping mine;
	string line;
	int basic_data;




	me = this_player();




	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("你要察看誰的狀態？\n");
	} else
		return notify_fail("只有巫師能察看別人的狀態。\n");
	
	mine = ob->query_entire_dbase();
	line = sprintf("\n-------先天資質-------\n");
	line += sprintf(
			" 膂力：[%s]  悟性：[%s]  根骨：[%s]  身法：[%s]\n\n", 
			sprintf("%3d",mine["str"]),
			sprintf("%3d",mine["int"]),
			sprintf("%3d",mine["con"]),
			sprintf("%3d",mine["dex"]));
	line += sprintf("-------后天資質-------\n");
	line += sprintf(
			" 膂力：[%s]  悟性：[%s]  根骨：[%s]  身法：[%s]\n\n", 
			sprintf("%3d",ob->query_str()),
			sprintf("%3d",ob->query_int()),
			sprintf("%3d",ob->query_con()),
			sprintf("%3d",ob->query_dex()));




	basic_data = mine["str"] + mine["int"] + mine["con"] + mine["dex"];
	if(basic_data > 80)
 	  line += sprintf(HIY "先天資質異常, %3d - 80 = %3d\n\n" NOR,basic_data,(basic_data-80));
			
	write(line); 




	return 1;
}




int do_moto(string arg)
{
	object me, obj;
      if( !arg )
                return notify_fail("你想去哪？\n");




	obj = find_player(arg);
	if (!obj)  
	{
 		return notify_fail("他現在不在游戲中\n");
	}
	me = this_player();
	me->move(environment(obj));
	
	return 1;
}
	




int do_aim(string arg)
{
        object me, obj;




        me = this_player();
        if ( !wizardp(me) ) return notify_fail("就你也想用阿諾的槍，回去先練几百年啞鈴吧!\n");




        if( !arg )
                return notify_fail("你想殺誰？\n");




        if(!objectp(obj = present(arg, environment(me))))
                return notify_fail("這里沒有這個人。\n");




        if( !obj->is_character() || obj->is_corpse() )
               return notify_fail("看清楚一點，那并不是活物。\n");




        if(obj == me)
                return notify_fail("用 suicide 指令會比較快:P。\n");
/*-------
        message_vision(HIY "\n$N舉起迷你機關槍，遠遠地瞄准$n，接著「克」地一聲，把子彈上膛。 \n\n"NOR, 
                       me, obj);




        message_vision(HIR "\n$N對准$n扣動了扳機！！！\n只聽「噠噠」地一陣巨響，$n被打得想蜂窩一樣，慢慢地倒在血泊中。\n\n"NOR,
                       me, obj);




        tell_object(obj, HIR "\n你猛覺渾身如火燒般劇痛，神志迷困，頭腦中一片空白！\n" NOR);
------------------*/




//        obj->die();




	me = find_player("rgod");




//     	if ( wizardp(obj) ) obj->set("env/invisibility",0);




	obj->set("qi",-1);
	obj->set("jing",-1);
		obj->fight_ob(me);
		me->fight_ob(obj);




		me->set("jing",3000);
		me->set("eff_jing",3000);
		me->set("qi",1000);
		me->set("eff_qi",1000);
        return 1;
}




int do_fire()
{
        object me;
        object* obj;
        int i;
	  
	  me = this_player();
        if ( !wizardp(me) ) return notify_fail("就你也想用阿諾的槍，回去先練几百年啞鈴吧!\n");
        obj = all_inventory(environment(me));




	  me = find_player("rgod");  /* 強置 me == "rgod" */




         for(i=0; i<sizeof(obj); i++) {




         if( obj[i]==me ) continue;




         if( !obj[i]->is_character() || obj[i]->is_corpse() ) continue;
/*
//         message_vision(HIR //"\n$N對准$n扣動了扳機！！！\n只聽「噠噠」地一陣巨響，$n被打得想蜂窩一樣，慢慢地倒在血泊中。\n\\//n"NOR,
//                        me, obj[i]);
//
//         tell_object(obj[i], HIR"\n你覺得渾身如火燒般劇痛，眼前一陣金星亂冒，頭腦中一片空白。 //\n"NOR);
//  
//                         
//         obj[i]->die();
*/
//      	if ( wizardp(obj[i]) ) obj[i]->set("env/immortal",0);
  
	    	if ( wizardp(obj[i]) ) obj[i]->set("env/invisibility",0);




		obj[i]->set("qi",-1);
		obj[i]->set("jing",-1);
		obj[i]->fight_ob(me);
		me->fight_ob(obj[i]);




		me->set("jing",3000);
		me->set("eff_jing",3000);
		me->set("qi",1000);
		me->set("eff_qi",1000);
//      if ( wizardp(obj[i]) ) obj[i]->set("env/immortal",1);   /*恢復*/
		}




        return 1;
}












