#include <mudlib.h>

void create() { seteuid( getuid() ); }

string gateway(string args) {

    object ob,body;
    string str;
    int online;

    online = 0;

    if( sscanf(args,"id=%s",args) == 0)
        return "請先填好表格";

    ob = new(LOGIN_OB);
    ob->set("id", args);

    if( !ob->restore() ) return "沒有這個玩家"+args+"。\n";

    if( objectp(body = find_player(args)) && geteuid(body)==args ) {
        if( body->query("env/invisibility") < 1 )
            if( !body->is_ghost() )
                online = 1;
    }
    str = "<html><title>查詢玩家</title><body>";

    str += sprintf(
                "<h3 align=center><font face='幼圓' color=#ff0000>%s"
                "<font face='幼圓'color=#000000>玩家查詢</font>"
                "</h3><p><hr></p>",
                CHINESE_MUD_NAME
                );

    str += sprintf(
        "<center><TABLE BORDER=5>"
        "<TR><TH>英文代號：</TH><TD>%s</TD></TR>"
        "<TR><TH>姓    名：</TH><TD>%s</TD></TR>"
        "<TR><TH>權限等級：</TH><TD>%s</TD></TR>"
        "<TR><TH>上次連線：</TH><TD>%s</TD></TR>"
        "<TR><TH>是否在線：</TH><TD>%s</TD></TR>"
        "</TABLE>",
        body->query("id"),
        body->query("name"),
        SECURITY_D->get_status(args),
        ctime(ob->query("last_on")),
        online
? "是" : "否"
        );
    destruct(ob);
    str += "</center></body></html>";
    return str;
}
