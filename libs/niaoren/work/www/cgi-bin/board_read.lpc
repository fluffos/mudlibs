#include <ansi.h>
#include <mudlib.h>

#define BOARD_CAPACITY 1024

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_SAVE;

string long(int);
string short();
string read(int);
string query_save_file();
void setup();

private mapping notes;

string gateway(string arg) {
	int bn,pn,select=0;
	string str,board;
	mapping vaild_board = "/www/cgi-bin/board_list.lpc"->query_boards();

	if( sscanf(arg,"%s&%d&%d",board,pn,bn) == 3 )
		select = 1;

	if( undefinedp(vaild_board[board]) )
		return sprintf("留言板(%s)不存在。", board);

	set("board_id",board);
	setup();

	str = sprintf(	"<body background=/images/body_bg.jpg><font color='#ff0000' face='幼圓'>"
			"<h3 align='center'>%s</font><font face='幼圓'> "
			"%s</font></h3>",
			CHINESE_MUD_NAME,
			query("name")
			);
	
	if( !select )
		str += sprintf("<p><hr></p>%s</body>", read(pn) );
	else
		str += sprintf(	"<hr><center><table border=1><br><font size=3 face='幼圓'>"
			"%s</font></table></body>", long(bn) );
	return str;
}

void create() {
	seteuid( geteuid() );
}

string query_save_file()
{
	string id;
	if( !stringp(id = query("board_id")) ) return 0;
	return DATA_DIR + "board/" + id;
}

void setup() {
	if( restore() )
		notes = query("notes");
	else
		notes = ([]);
}

string short()
{
	if( !pointerp(notes) || !sizeof(notes) )
		return " [ 沒有任何留言 ]";

	return sprintf("[ 共 %d 張留言 ]", sizeof(notes) );
}

string long(int arg)
{
	int i,bof,eof;
	string msg;

	msg = "<th>序號<th>標題<th>作者<tr>";
	if( !pointerp(notes) || !sizeof(notes) ) return query("long");

	eof = arg - 1;

	if( eof > sizeof(notes)-1 )
		eof = sizeof(notes)-1;

	bof = eof - 20;
	if( bof < 0 ) {
		eof = sizeof(notes) > 19 ? 19 : sizeof(notes)-1;
		bof = 0;
	}

	for( i=eof; i+1>bof; i-- )
		msg += sprintf("<tr><td><font size=4 face='OCR A Extended'>%d</font>"
			"<td><font size=2 face='楷體_GB2312'><a href=board_read?%s&%d>%s</a></font>"
			"<td><font size=2 face='楷體_GB2312'>%s</font>",
			i+1,
			query("board_id"),
			i+1,
			notes[i]["title"],
			notes[i]["author"],
			);
	msg +=	sprintf("</table><p><hr><p><table border=1>"
			"<td><a href=board_read?%s&0&%d>%s</a>"
			"<td><a href=post?%s>發表文章</a>"
			"<td><a href=board_list>選擇留言板</a>"
			"<td><a href=board_read?%s&0&%d>%s</a>"
			"</table>",
			query("board_id"),
			bof == 0 ? 9999 : eof - 20 + 1,
			bof == 0 ? "轉到最后一頁" : "上一頁",
			query("board_id"),
			query("board_id"),
			eof == sizeof(notes)-1 ? 20 : eof + 20 + 1,
			eof == sizeof(notes)-1 ? "轉到第一頁" : "下一頁",

			);

	return msg;
}

string read(int arg)
{
	int num=arg;
	string body,myid,*msg,note_body="";

	myid = query("board_id");

	if( !pointerp(notes) || !sizeof(notes) )
		return "留言板上目前沒有任何留言。";

	if( num < 1 || num > sizeof(notes) )
		return "沒有這張留言。";

	num--;
	msg = explode(notes[num]["msg"],"\n");
	for( int i=0;i<sizeof(msg);i++ ) {
		note_body += sprintf("%s<br>",msg[i]);
	}

	if( note_body=="" ) note_body= "無內容。<br>";

	body =  sprintf("<center><table border=1><th>序號<td>%d<tr>"
			"<th>標題<td>%s<tr>"
			"<th>作者<td>%s<tr>"
			"<th>發表時間<td>%s</table><p><hr></p>"
			"<table border=1><center><th>內容<tr><td>%s"
//			"<TEXTAREA name=contents ROWS=12 COLS=63 WRAP=off>%s</TEXTAREA>",
			"</center></table></center>",
				num + 1,
				notes[num]["title"],
				notes[num]["author"],
				ctime(notes[num]["time"]),
				note_body
			);
	num ++;
	body +=	sprintf("<p><hr><p><table border=1>"
			"<td><a href=board_read?%s&%d>%s</a>"
			"<td><a href=board_read?%s&0&%d>返回%s</a>"
			"<td><a href=board_read?%s&%d>%s</a>"
			"</table>",
			query("board_id"),
			num == 1 ? sizeof(notes) : num-1,
			num == 1 ? "轉到最后一篇" : "上一篇",
			query("board_id"),
			num,
			query("name"),
			query("board_id"),
			num == sizeof(notes) ? 1 : num+1,
			num == sizeof(notes) ? "轉到第一篇" : "下一篇",

			);
	return body;
}
