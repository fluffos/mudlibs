#include <ansi.h>
void more(string cmd, string *text, int line)
{
    int i;
    switch(cmd) {
    case "b":
        line = line - 46;
        if(line<-22) line=-23;
                write(ESC+"[1A"+ESC+"[200D"+ESC+"[K\n\n");
        for(i=line + 23; line < i;line++)
        write(text[line]+"\n");
        break;
    case "q":
            write(ESC+"[1A"+ESC+"[200D"+ESC+"[K\n\n");
        return;
    default:
                write(ESC+"[1A"+ESC+"[200D"+ESC+"[K");
        for(i=line + 23; line<sizeof(text) && line<i; line++)
            write(text[line] + "\n");
        if( line>=sizeof(text) ) return;
        break;
    }
    printf("== 未完繼續 " HIY "%d%%" NOR " == ("+HIC+"q"+NOR+" 離開，"+HIC+"b"+NOR+" 前一頁，其他繼續下一頁)",
        (line*100/sizeof(text)) );
    input_to("more", text, line);
}
void start_more(string msg)
{
     write("\n");
    more("", explode(msg, "\n"), 0);
}

void more_file (string cmd, string fn, int ln)
{
  string        buf;

  if (buf = read_file (fn, ln, 20)) {
    ln += 20;
    write (buf);
    if (read_file (fn, ln, 1)) {
      write ("== 未完繼續 == (ENTER 繼續下一頁) ");
      input_to ("more_file", fn, ln);
    }
  }
 }
