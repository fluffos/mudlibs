// 相關文件：在/include/globals.h里增加了 #define PAWN "/feature/pawn"
// 為當鋪提供pawn,redeem,redeemp,value,sell,list,buy指令
// write by jackyboy @ cctx 98/12/23

// 為了避免玩家作弊，必須在當鋪設置no_fight為1，并且必須設置npc屬性no_get為1
// 因為無no_fight,玩家就可以打暈npc然后steal，如果不設置no_get，玩家就可以利用一些特殊
// 的npc把當鋪里的npc打暈，然后get起來，背到其他地方steal!

#include <ansi.h>

inherit F_DEALER;

int redeem(string arg);
string getid(string target);
string getname(string number,string target);
void setup()
{
	set("no_get",1);
	set("no_get_from",1);
	::setup();
}
void init()
{
	add_action("do_list", "list");
	add_action("do_buy", "buy");
	add_action("do_sell", "sell");
	add_action("do_pawn", "pawn");
	add_action("do_value", "value");
	add_action("do_redeem", "redeem");
	add_action("do_redeemp", "redeemp");//贖人的命令
}

int do_pawn(string arg)
{
	object me,ob;
	string str,*nopawn;
	int i,value;
	
	nopawn = ({"coin", "silver","gold","cash",
			"thousand-cash","mailbox","box"});
	if (!arg||arg=="")
		return notify_fail("你要典當什么？\n");
	me=this_player();
	if(!objectp(ob=present(arg,me)))
		return notify_fail("你沒有這樣東西。\n");

	if (ob->query("item_origin"))
		return notify_fail("粗坯是不能當的。\n");
	if (ob->query("money_id"))
		return notify_fail("你想當「錢」？？\n");
	if (ob->query("food_supply"))
		return notify_fail("剩菜剩飯留給您自己用吧。\n");
	if(member_array(arg,nopawn)!=-1
		||ob->query("nopawn")==1)
		return notify_fail("這樣東西不能典當！\n");
	if((ob->query("enpawn")==0)//如果這個屬性不為0，說明它是可以當的！
		&&(
			ob->query("hunmi")!=0||living(ob)
			||ob->query_temp("block_msg/all")==1
		)
	)
		return notify_fail("這個東西是活的呀？！怎么當嘛，真夠papaya的了！\n");
	value=ob->query("value");

	/*由于一些物品，沒有設置value,所以無法典當，但是又很有用，所以暫時注釋這几句
           如果允許這里，請注意enpawn屬性也應該判斷一下
	if(value<30)
		return notify_fail("這是什么垃圾？居然也拿來典當!\n");
	*/

	//典當值value的60%！
	MONEY_D->pay_player(me, value * 60 / 100);

	//str保存基本文件名
	str=base_name(ob);
	str=replace_string(str,"/","\\");		//注意："\\"即"\"!
	//避免出錯！即在map里存map!


	//設置i為已典當了的數量,如是第一次是否為0呢？!!!!!!
	i=me->query("pawn/"+str);

	me->set("pawn/"+str,i+1);  //保存數量(+1)

	message_vision("$N拿出"+ob->query("name")+"典當了"+
		MONEY_D->price_str(value* 60/100)+"。\n",me);
	destruct(ob);
	return 1;
}

int do_redeemp(string target)
{
	object me,ob,dest;
	me=this_player();
	ob=this_object();
	if(!target||target=="")
		return notify_fail(ob->query("name")+"俯到你的耳邊悄聲問道：你要贖什么人？\n");
	if(!objectp(dest=find_player(target)))
		return notify_fail("玩家("+target+")目前不在線上！\n");
	if( !dest->query("jackyboy/selled"))
		return notify_fail(ob->query("name")+"急道：你可別誣陷好人，我怎么會非法扣押玩家呢！\n");
	switch (MONEY_D->player_pay(me, dest->query("per") * 700))
	{
	case 0:
		return notify_fail("窮光蛋，一邊呆著去！\n");
	case 2:
		return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
	default:
		message_vision("$N從$n那里贖回了一" + dest->query("unit") + 
			dest->query("name") + "。\n", me, this_object());
		dest->move(environment(ob));
		dest->set("startroom",base_name(environment(ob)));
		dest->set("jackyboy/selled",0);
		message("vision",
			HIY "只聽見嗖的一聲，一個遍體鱗傷的家伙從天花板上掉了下來！\n" NOR,
			environment(dest), dest);
		tell_object(dest, "你被" + me->query("name") + "贖了出來。\n");
	}
	return 1;
}
string getid(string target)
{
	string temp;
	object ob=new(target);
	temp = implode(ob->parse_command_id_list(),",");
	destruct(ob);
	return temp;
}

string getname(string number,string target)
{
	string str1,str2;
	int i;
	//為了統一格式，可以把所有ansi顏色控制字符刪除掉！這樣來算長度！
	str2 = number+(target)->query("unit")+(target)->query("name");
	str1 = str2;
	str2 = replace_string(str2, BLK,"");
	str2 = replace_string(str2, RED,"");
	str2 = replace_string(str2, GRN,"");
	str2 = replace_string(str2, YEL,"");
	str2 = replace_string(str2, BLU,"");
	str2 = replace_string(str2, MAG,"");
	str2 = replace_string(str2, CYN,"");
	str2 = replace_string(str2, WHT,"");
	str2 = replace_string(str2, HIR,"");
	str2 = replace_string(str2, HIG,"");
	str2 = replace_string(str2, HIY,"");
	str2 = replace_string(str2, HIB,"");
	str2 = replace_string(str2, HIM,"");
	str2 = replace_string(str2, HIC,"");
	str2 = replace_string(str2, HIW,"");
	str2 = replace_string(str2, NOR,"");
	str2 = replace_string(str2, BLINK,"");
	if(strlen(str2)>=30)
		return str1;
	for(i=strlen(str2);i<30;i++)
		str1+=" ";
	return str1;
}

int do_redeem(string target)
{
	object dest, *all,me,ob;
	int i, value,num,snum;
	string term, *terms,str,id;
	mapping env;

	all = users();
	me=this_player();
	env=me->query("pawn");
	if( !mapp(env) || !sizeof(env) )
	{
		write("你沒有當過任何物品。\n");
		return 1;
	}
	if (!target)
	{
		write("你目前當了的物品有：\n");
		terms = keys(env);
		for(i=0; i<sizeof(terms); i++)
		{
			sscanf(terms[i],"%s",str);
			str=replace_string(str,"\\","/");//文件名
			value=me->query("pawn/"+terms[i]);//數量
			term=getid(str);//查所有的ID
			printf("%d\t%s %s\n",
				i+1,
				getname(chinese_number(value),str),
				term);
		}
		return 1;
	}
	//num為要贖的物品個數，snum為同類id的物品的第几個。

	if(sscanf(target,"%d %d",num,snum)!=2)
	{
		if(sscanf(target,"%d %s %d",num,id,snum)!=3)
			if(sscanf(target,"%d %s",num,id)!=2)
				if(sscanf(target,"%s %d",id,snum)!=2)
					if(sscanf(target,"%d",snum)!=1)
					{
						if(sscanf(target,"%s",id)!=1)
							return notify_fail("sorry!\n");
						else
						{
							snum=1;
							num=1;
						}
					}
					else//這里也要特殊處理
					{
						snum--;
						num=1;
						terms = keys(env);
						if(num<=0)
							num=1;
						i=sizeof(terms);
						if(snum>=sizeof(terms))
							return notify_fail("對不起，你沒當過這件東西。\n");
						sscanf(terms[snum],"%s",str);
						value=me->query("pawn/"+terms[snum]);
						if(value<num)
							return notify_fail("你沒有當過這么多，難道你想白賺？\n");
						str=replace_string(str,"\\","/");//文件名
						if(!objectp(ob=new(str)))
							return notify_fail("你所要贖的物品已經不再存在了。\n");
						switch(MONEY_D->player_pay(me,ob->query("value")*num*4/5))
						//贖回要花value的80%
						{
						case 0:
							return notify_fail("窮光蛋，一邊呆著去！\n");
						case 2:
							return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
						default:
						}
						message_vision("$N從"+this_object()->query("name")+
							"那里花"+
						MONEY_D->price_str(ob->query("value")*num*4/5)+"贖了"+
							chinese_number(num)+
							ob->query("unit")+
							ob->query("name")+"。\n",me);
						if(value==num)
							me->delete("pawn/"+terms[snum]);
						else
							me->set("pawn/"+terms[snum],value-num);
						for(i=0;i<num;i++)
							new(str)->move(me);
						return 1;
						
					}
				else
					num=1;
			else
				snum=1;//利用下面的程序段
		//else// 全集：num id snum的處理
		{
			if(snum<=0)
				snum=1;
			terms = keys(env);
			for(i=0; i<sizeof(terms);i++)
			{
				sscanf(terms[i],"%s",str);
				str=replace_string(str,"\\","/");//文件名
				value=me->query("pawn/"+terms[i]);//數量
				if(member_array(id,(str)->parse_command_id_list())!=-1)
					snum--;
				if(snum==0)
					break;//中斷循環
			}
			//如果此時snum=0,說明已經找到了，并且數目也足夠！此時str里保存有該文件名
			if(snum==0)
			{
				if(value<num)
					return notify_fail("你沒有那么多的"+(str)->query("name")+
						"典當在這里。\n");
				if(!objectp(ob=new(str)))
					return notify_fail("你所要贖的物品已經不再存在了。\n");
				switch(MONEY_D->player_pay(me,ob->query("value")*num*4/5))
				//贖回要花value的80%
				{
				case 0:
					return notify_fail("窮光蛋，一邊呆著去！\n");
				case 2:
					return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
				default:
				}
				message_vision("$N從"+this_object()->query("name")+
					"那里花"+
					MONEY_D->price_str(ob->query("value")*num*4/5)+"贖了"+
					chinese_number(num)+
					ob->query("unit")+
					ob->query("name")+"。\n",me);
				if(value==num)
					me->delete("pawn/"+terms[i]);
				else
					me->set("pawn/"+terms[i],value-num);			
				for(i=0;i<num;i++)
					new(str)->move(me);
				return 1;
			}
			else //否則snum不為0說明沒有這樣東西
				return notify_fail("沒有你要贖回的東西！請仔細看看你當了些什么！\n");
		}
	}
	else//這里要特殊處理
	{
		terms = keys(env);
		if(num<=0)
			num=1;
		snum--;
		if(snum>=sizeof(terms))
			return notify_fail("對不起，你沒當過這件東西。\n");
		sscanf(terms[snum],"%s",str);
		value=me->query("pawn/"+terms[snum]);
		if(value<num)
			return notify_fail("你沒有當過這么多，難道你想白賺？\n");
		str=replace_string(str,"\\","/");//文件名
		if(!objectp(ob=new(str)))
			return notify_fail("你所要贖的物品已經不再存在了。\n");
		switch(MONEY_D->player_pay(me,ob->query("value")*num*4/5))
		//贖回要花value的80%
		{
		case 0:
			return notify_fail("窮光蛋，一邊呆著去！\n");
		case 2:
			return notify_fail("您的零錢不夠了，銀票又沒人找得開。\n");
		default:
		}
		message_vision("$N從"+this_object()->query("name")+"那里花"+
		MONEY_D->price_str(ob->query("value")*num*4/5)+"贖了"+
			chinese_number(num)+
			ob->query("unit")+
			ob->query("name")+"。\n",me);
		if(value==num)
			me->delete("pawn/"+terms[snum]);
		else
			me->set("pawn/"+terms[snum],value-num);
		for(i=0;i<num;i++)
			new(str)->move(me);
		return 1;
	}


	return 0;		
}
	
int do_sell(string arg)
{
	object ob;
	int value;
	
	if (!arg || !(ob = present(arg, this_player())))
		return notify_fail("你要賣什么？\n");

	if (ob->query("money_id"))
		return notify_fail("你想賣「錢」？？\n");

	if (stringp(ob->query("no_drop")))
		return notify_fail("這樣東西不能賣。\n");

	if (is_vendor_good(arg) != "") 
		return notify_fail("賣給你好不好？\n");

	if (ob->query("food_supply"))
		return notify_fail("剩菜剩飯留給您自己用吧。\n");
	
        if (ob->query("shaolin"))
                return notify_fail("小的只有一個腦袋，可不敢買少林廟產。\n");

	if (userp(ob))
	{
		ob->set("value", ob->query("per") * 500);
		CHANNEL_D->do_channel(ob, "rumor",
			sprintf("%s被某人拐賣給"+this_object()->query("name")+
				"了。", ob->name(1)));
	}

	value = ob->query("value");
	if (value < 30)
		write(ob->query("name") + "一文不值！\n");
	else {
		message_vision("$N賣掉了一" + ob->query("unit") + 
		ob->query("name") + "給$n。\n", this_player(), this_object());
		MONEY_D->pay_player(this_player(), value * 70 / 100);
		if ( userp(ob))
		{
			ob->move("/d/dali/storage");
			ob->set("startroom","/d/dali/storage");
			ob->set("jackyboy/selled",1);
		}
		else if (value < 50)
			destruct(ob);
		else
			ob->move(this_object());
	}
	return 1;
}

