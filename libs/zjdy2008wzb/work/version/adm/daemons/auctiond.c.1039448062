#pragma optimize
#pragma save_binary

#include <ansi.h>
#include <config.h>

inherit F_DBASE;

int clean_up() { return 1; }

#define auction_info    my["auction_info"]
#define lot_percent     5 / 100
#define MAX_PERIOD      600
#define MAX_STATE       3

varargs public  void   add_auction(object me, object ob, int money, string memo);
public  void   cancel_auction(object me);
public  void   confirm_auction(object me);
public  string check_auction_info();
private void   message_auction(string msg);
private string check_auction(object me, object ob);
private int    finish_auction(object me, object ob, object obj, string id);

void create()
{
        mapping my;
        
        seteuid(getuid());
        
        set("channel_id", "拍卖师[Auction Master]");
        CHANNEL_D->do_channel(this_object(), "sys", "拍卖精灵已经启动。");

        my = query_entire_dbase();
        auction_info = ([ ]);
        set_heart_beat(300);
}

void heart_beat()
{
        mapping my;
        string *id;
        int     i, money;
        object  me;
        object  ob;
        object  obj;
        int     max;
        int     succeed;

        my = query_entire_dbase();

        if (! mapp(auction_info) || ! sizeof(auction_info))
                return;

        id = keys(auction_info);
        max = sizeof(id);

        for (i = 0; i < max; i++)
        {
                if (! objectp(me = find_player(id[i])) ||
                    ! objectp(obj = auction_info[id[i]]["goods"]))
                {
                        map_delete(auction_info, id[i]);
                        continue;
                }

                if (stringp(auction_info[id[i]]["now"]) &&
                    ! objectp(ob = find_player(auction_info[id[i]]["now"])))
                        map_delete(auction_info[id[i]], "now");

                if (time() - auction_info[id[i]]["time"] >= MAX_PERIOD)
                {
                        auction_info[id[i]]["state"] += 1;
