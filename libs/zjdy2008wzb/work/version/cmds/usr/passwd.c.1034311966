private void select_fun(string fun, object ob)
{
        if (! objectp(ob))
        {
                write("ÎŞ·¨ÕÒµ½Á¬½Ó¶ÔÏó£¬´Ë´Î²Ù×÷ÖĞÖ¹ÁË¡£\n");
                return;
