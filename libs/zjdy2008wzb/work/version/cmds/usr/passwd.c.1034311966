                write("ÇëÄãÊäÈëĞÂµÄÆÕÍ¨ÃÜÂë£º");
                input_to("get_new_pass", 1, ob);
                return;

        case "":
        case "3":
                write("²Ù×÷Íê±Ï¡£\n");
                return;

        default:
                write("Ã»ÓĞÕâÏî¹¦ÄÜ¡£\n");
                return;
        }
}

string trans_char(int c)
{
        return sprintf("%c ", c);
}

private void get_new_pass(string pass, object ob)
{
        string old_pass;

        if (! objectp(ob))
        {
                write("ÎŞ·¨ÕÒµ½Á¬½Ó¶ÔÏó£¬´Ë´Î²Ù×÷ÖĞÖ¹ÁË¡£\n");
                return;
        }

        if (pass == "")
        {
                write("²Ù×÷È¡ÏûÁË¡£\n");
                return;
        }

        if (strlen(pass) < 3)
        {
                write("¶Ô²»Æğ£¬ÄãµÄÆÕÍ¨ÃÜÂë³¤¶È±ØĞë´óÓÚÈıÎ»£¬ÇëÖØĞÂÊäÈë£º");
                input_to("get_new_pass", 1, ob);
                return;
        }

        old_pass = ob->query("ad_password");
        if (stringp(old_pass) && crypt(pass, old_pass) == old_pass)
        {
                write(HIR "\nÎªÁË°²È«Æğ¼û£¬ÆÕÍ¨ÃÜÂëºÍ¹ÜÀíÃÜÂë²»ÄÜÒ»Ñù¡£\n\n" NOR);
                write("ÇëÖØĞÂÊäÈëÄãµÄÆÕÍ¨ÃÜÂë£º");
                input_to("get_new_pass", 1, ob);
                return;
        }

        write("\nÇëÔÙÊäÈëÒ»´ÎĞÂµÄÆÕÍ¨ÃÜÂë£º");
        input_to("confirm_new_pass", 1, ob, crypt(pass, 0));
}

private void confirm_new_pass(string pass, object ob, string new_pass)
{
        object me;
        object body;
        string email;
        string msg;

        if (! objectp(ob))
        {
                write("ÎŞ·¨ÕÒµ½Á¬½Ó¶ÔÏó£¬´Ë´Î²Ù×÷ÖĞÖ¹ÁË¡£\n");
                return;
        }

        write("\n");
        if (crypt(pass, new_pass) != new_pass)
        {
                write("¶Ô²»Æğ£¬ÄúÁ½´ÎÊäÈëµÄ²¢²»ÏàÍ¬£¬ÇëÖØĞÂÊäÈëÄãµÄÆÕÍ¨ÃÜÂë£º");
                input_to("get_new_pass", 1, ob);
                return;
        }

        seteuid(getuid());
        if (! ob->set("password", new_pass))
        {
                write("ÆÕÍ¨ÃÜÂë±ä¸üÊ§°Ü£¡\n");
                return;
        }

        ob->save();
        me = this_player();
        log_file("static/passwd", sprintf("%s %s's normal passwd changed by %s(%s)\n",
                                          log_time(),
                                          ob->query("id"),
                                          geteuid(me),
                                          interactive(me) ? query_ip_name(me)
                                                          : 0,
                                          ctime(time())));

        write("ÆÕÍ¨ÃÜÂë±ä¸ü³É¹¦¡£\n");
}

