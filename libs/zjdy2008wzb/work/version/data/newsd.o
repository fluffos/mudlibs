dbase (["notes":({(["author":"微尘-doing","title":"新闻系统启动[2;37;0m","time":973081328,"msg":"以后请通过news命令来查阅系统的更新。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于[1;33mgive[2;37;0m命令的修改[2;37;0m","time":973173389,"msg":"由于太多的新玩家不会使用[1;33mgive[2;37;0m命令将物品传递给英文代号带有空格的人物，因此这个命令作了一点调整。你可以直接书写以下的格式：例：[1;33mgive ouyang ke 1 silver[2;37;0m系统自动判断场景中是否有ouyang ke这个人物。 如果ID中有两个以上的空格，则不能使用这种格式，必须使用[1;33mgive sth. to sb.[2;37;0m--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"hide兵器需要精力。[2;37;0m","time":973240084,"msg":"比[1;33msummon[2;37;0m时需要的精力少一些。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"对于辱骂其他玩家或是FLOOD的处理原则[2;37;0m","time":973305009,"msg":"对骂人和处理FLOOD的方法：公开频道骂人，立刻禁闭24h+， 所谓的公开频道就是大部分人能够看到的，也就是除了inter，team频道其他所有的频道。如果是用say进行flood和骂人，那么不是在公开场合 - 主要是那么人物聚集的的地方如扬州客栈等 - 的一概不管，在公开场合进行骂人和FLOOD的禁闭12h+用tell和whisper进行骂人或是flood的不管。之所以这么做是两个原因。如果用tell/whisper/或是在一些人少的场合发布信息你可以选择躲开，不受干扰。 令一个原因就是于巫师无法查证在这些场合发布的信息是否属实。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"回答杨潇潇潇(mmmud)关于程铁衣(jingmi)的质疑[2;37;0m","time":973305240,"msg":"前天杨潇潇潇(mmmud)想我询问为什么who中发现程铁衣(jingmi)是桃花到弟子并且look的时候是自己的同门长辈。经过查证，现在已经找出其中原因：由于桃花岛拜师有一个BUG， 就是ask 完黄药师以后系统会临时设置该玩家为桃花岛弟子，并且辈分是0， 所以导致上述情况的发生。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于放弃[1;36m实战经验[2;37;0m的说明[2;37;0m","time":973319127,"msg":"可以使用abandon|fangqi命令来放弃你的实战经验，每次成功可以损失1%以内的实战经验。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"少林派新增武功 - 一拍两散 & 玄寂调整[2;37;0m","time":973334769,"msg":"少林寺新增的技能可以查看少林的帮助。玄寂大师的武功技能调整了，改用一拍两散，交手时务必小心。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于负重的调整[2;37;0m","time":973429300,"msg":"负重和后天膂力相关。一般来说，臂力先天30的出生时最大负重为100 千克左右，先天膂力15的最大负重为60千克左右。随着后天膂力的变化，负重能力会有一定的提升。调整过以后的负重比原先合理一些，在带物品的时候务必需要考虑负重的影响。注：先天膂力为30的人物体重一般是80千克，15的人物体重一般是50千克。背负玩家只需要70% 的负重，即背负起80千克的人物只需要占用56千克的负重。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"增加鞭类高级武器：黑索[2;37;0m","time":973492748,"msg":"在渡字辈高僧手中。如果是少林派弟子满足条件可以索取该兵器。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于投票系统的更新[2;37;0m","time":973499609,"msg":"新的投票规则制定：如果需要关闭一个玩家的频道，只需要简单多数或是[1;36m10[2;37;0m票合法票数，如果是针对[1;36m14[2;37;0m岁的玩家，只需要[1;36m3[2;37;0m 票。如果需要投票关闭一个玩家的频道：可以使用[1;33mvote chblk <玩家ID>[2;37;0m。投票时一个IP地址只能投出一票。使用投票骚扰其他玩家将遭到严厉的惩罚，具体清参见[1;33mvote[2;37;0m命令。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于雪山派金轮法王辈分的调整[2;37;0m","time":973506636,"msg":"调整为和鸠摩智一个辈分，都是第一代的。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"古墓内功更新[2;37;0m","time":973525102,"msg":"新增[1;36m怒海狂涛(surge-force)[2;37;0m，必须向扬过学习，要求男性，并且具有足够的后天膂力。这是江湖中唯一能够增加空手伤害力的内功。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于关外胡家的改动[2;37;0m","time":973595162,"msg":"地图有变化，增加踏雪院。冬天胡家弟子可以到此地尝试修炼轻功技能。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于华山派的改动[2;37;0m","time":973596786,"msg":"修习华山派的[1;33m混元掌法[2;37;0m时可以同时锻炼基本内功。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"凌波微步的修改[2;37;0m","time":973674048,"msg":"凌波微步具有成功躲避攻击的自动perform。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于师门QUEST银两奖励的变化[2;37;0m","time":973675081,"msg":"改由从QUEST NPC处获得，师傅不再给与银两的奖励。其他物品的奖励不变。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于丐帮空空儿的调整[2;37;0m","time":973684823,"msg":"只要是丐帮弟子，都可以象空空儿学习偷窃、打探、乞讨的技能。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"地狱诚招分站合作[2;37;0m","time":973702722,"msg":"请通过help sites查看相关说明。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于师门QUEST的调整[2;37;0m","time":973745929,"msg":"完成后的经验潜能奖励上调，难度不变。同时前10个QUEST的奖励维持不变，仍然很少。如果觉得QUEST难度较高，应考虑和同门的师兄弟一起完成，不能总寄希望于单打独斗。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于负重问题的说明[2;37;0m","time":973773943,"msg":"首先，任何ID出生时的先天膂力将在13 - 30之间，其中13 将是一个膂力相当孱弱的人物，负重比较有限，而后天膂力变化对负重能力的影响不如先天膂力显著，所以如果先天膂力不足的人很难或是无法超重武器：主要是使用玄铁炼制的武器。但是杀伤力最高的兵器并非是玄铁两成，以补天石即神铁炼制的兵器具有最高的杀伤力，但是分量一般重。高负重并不会具有更高的杀伤力，只是对于某一些特殊的招式如杨过的大江东去有着很强的辅助作用。玩家炼制武器时，炼制出的兵器分量将会超过原料许多，因为制作时兵器同时需要参杂其他金属。另外，由于很多玩家喜欢选取高悟性的人物，在游戏中，虽然低悟性的人成长叫高悟性慢，但是游戏的设计宗旨是平衡各种类型的人物，高膂力的人物并不会比高悟性的人物逊色。即使由于游戏本身设计的缺陷可能造成偏差，也必将依据此原则进行调整。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于GUARD的更新[2;37;0m","time":973837437,"msg":"如果你试图把守路口，那么当有人经过的时候将会比较双方的膂力和内功水平，如果对方高出自己太多，将无法阻拦，并且会导致自己受伤。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"新增FREEQUEST[2;37;0m","time":973843781,"msg":"打听消息，杀死反贼或是飞贼，可以获得负神|正神。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"about idle-force[2;37;0m","time":974282762,"msg":"修改了命令的格式，可以使用指明idle的次数。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"丐帮的变动[2;37;0m","time":974285499,"msg":"丐帮弟子升级的时候可以获得一些潜能，并且有可能超过潜能上限，所以在充分发挥潜能的作用前请小心，不要因为做任务或是其他原因损失潜能。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于浙江站瘫痪的问题[2;37;0m","time":974286420,"msg":"现在是因为服务器瘫痪，由于系统已经无法登录，所以现在不能确定问题发生的原因和已经造成的损失。等到管理员修复了机器以后才能进行进一步处理。目前问题不是MUD巫师组所能处理的。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于PERFORM的调整[2;37;0m","time":974471549,"msg":"调整了一招杀伤技的威力，杀伤对手时和自身的加力相关。如果使用加力，则杀伤对手的威力将增强。加力越大，杀伤程度越高。调整以后一招杀伤技的威力相当于提高了。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于年龄的变化[2;37;0m","time":974472264,"msg":"关于年纪的变化暂定为14-18岁24小时+1age      18-30岁48小时+1age      30+  岁72小时+1age      60+  岁96小时+1age/--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于吐纳(tuna)的修改[2;37;0m","time":974519778,"msg":"因为年龄的调整，所以吐纳要求的年龄修改成为24岁.--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于QUEST的修改[2;37;0m","time":974519814,"msg":"推出游戏以后重新进入仍然可以连续计算QUEST，只有QUEST CANCEL或者是无法完成任务才停止计算。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"丐帮的修改[2;37;0m","time":974548512,"msg":"梁长老处修改成非战斗的了。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于增加的攻击性武器的说明[2;37;0m","time":974635321,"msg":"由于初期某些门派武功比较弱，这时候你可以考虑使用一些攻击性武器辅助攻击敌人。目前射击的武器有：弓类 箭类使用弓可以发射箭，伤害对手，具体依赖对手的经验和本人的经验。长安兵器铺和扬州铁匠铺有这些武器销售。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"新的系统命令：system[2;37;0m","time":974829172,"msg":"你可以用 [1;33msystem[2;37;0m 命令察看目前系统使用资源的情况。如果你感到游戏速度变慢，可以使用该命令察看主机资源是否满足。如果满足，那么可能是因为网络的原因导致速度变慢。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"新增事件系统[2;37;0m","time":975073293,"msg":"请用help event察看有关帮助。对于新手来说，通过目前的一些事件可以获得一些武功方面的帮助。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于[1;36m折梅手[2;37;0m的修改[2;37;0m","time":975247044,"msg":"增加了一个perform。perform hand.zhe具有busy的功效，lingjiu & xiaoyao 弟子可以尝试使用。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"增加基本武功书籍[2;37;0m","time":975335456,"msg":"可以去陈有德，马五德，龙全处购买各种武功三个等级的书籍。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于地图全集[2;37;0m","time":975418808,"msg":"查看 help quest 有关地图全集的说明。完成地图任务以后可以获得大量的潜能和江湖阅历。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"补充31[2;37;0m","time":975831591,"msg":"使用弓箭需要先将弓抓在手上(hand 弓)然后使用shot命令。shot sb with 箭--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"关于欧阳世家的调整[2;37;0m","time":975903459,"msg":"欧阳克 & 欧阳锋增加了 literate 技能。--------------------------------[1;32m路漫漫其[1;33m修远[1;32m兮，吾将上下而[1;37m求索[1;32m。[2;37;0m[2;37;0m",]),(["author":"微尘-doing","title":"新的景观[2;37;0m","time":975903859,"msg":"黄果树瀑布，在大理。具体可以 help e