        "欧阳世家" : (: from_ouyang :),
        "慕容世家" : (: from_murong :),         // add by chenzzz
        "灵鹫宫"   : (: from_lingjiu :),        // add by chenzzz
        "峨嵋派"   : (: from_emei :),           // add by chenzzz
        "华山剑宗" : (: from_jianzong :),       // add by chenzzz
        "关外胡家NPC" : (: from_hu :),          // add by chenzzz
        "明教叛徒" : (: from_mingjiao :),       // add by chenzzz
        "武当派" : (: from_shenzhao :),         // add by chenzzz

         ]);


void create()
{
        string *fams;

        NPC_D->generate_cn_name(this_object());
	set("long", "一个人。\n");
	set("gender", "男性");
	set("age", 20);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

        // the follow 5 setting has no use	
	set("max_qi", 100);
	set("max_jing", 100);
	set("neili", 100);
	set("max_neili", 100);
	set("jiali", 100);

	set("combat_exp", 3000000);

	setup();

        fams = keys(init_family);
        setup_family(fams[random(sizeof(fams))]);
}

void setup_family(string family)
{
        function f;
        mapping skills;
        string skill;

        family = FAMILY_D->query_family_name(family);
        if (! functionp(f = init_family[family]))
                return;

        if (mapp(skills = query_skills()))
        {
                // remove all skill
                foreach (skill in keys(skills))
                        delete_skill(skill);

        }

        // set family information
        set("family/family_name", family);
        set("family/generation", 0);

        evaluate(f);
}

private void from_wudang()
{
        set("scale", 200);
        set("from", ({
                "据说此人出自武当，是武当派的高手，然而修武不修德，可惜啊可惜。",
                "听闻此人本是武当山下一农夫，耳渎目染，居然练就成非凡武功。",
                "据说此人乃武当弃徒，当年犯了杀戒逃至东洋，不想今日返回中原！",
        }));

        set_skill("force", 1);
        set_skill("taiji-shengong", 1);
        set_skill("parry", 1);
        set_skill("dodge", 1);
        set_skill("tiyunzong", 1);
        set_skill("sword", 1);
        set_skill("taiji-jian", 1);
        set_skill("hand", 1);
        set_skill("paiyun-shou", 1);
        set_skill("unarmed", 1);
        set_skill("taiji-quan", 1);

        map_skill("parry", "taiji-jian");
        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("sword", "taiji-jian");
        map_skill("hand", "paiyun-shou");
        map_skill("unarmed", "taiji-quan");

        prepare_skill("hand", "paiyun-shou");
        prepare_skill("unarmed", "taiji-quan");

        set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "sword.chan" :),
		(: perform_action, "sword.sui" :),
                (: perform_action, "sword.zhenwu" :),
		(: perform_action, "unarmed.zhen" :),
                (: exert_function, "recover" :),
	}) );

	set("class", "taoist");

        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
	carry_object("/d/wudang/obj/greyrobe")->wear();
        carry_object("/clone/weapon/ultra_weapon/tieshou")->wear();
}

private void from_shaolin()
{
        set("scale", 200);
        set("from", ({
                "据说此人出自少林，是少林的俗家高手，可却没有半点慈悲之心，唉！",
                "听闻此人偷师于少林，练就了一身超凡脱俗的本领。",
                "据说此人乃少林的火工头陀，偷学武艺后被发现，竟然打死"
                + "达摩院长老出逃西域，想不到今日返回中原！",
                "据说此人当年犯了少林的戒律，被迫离寺，想不到隐居多年"
                + "以后居然重出江湖。"
        }));

        set_skill("force", 1);
        set_skill("yijinjing", 1);
        set_skill("parry", 1);
        set_skill("jingang-buhuaiti", 1);
        set_skill("dodge", 1);
        set_skill("yiwei-dujiang", 1);
        set_skill("whip", 1);
        set_skill("riyue-bian", 1);
        set_skill("strike", 1);
        set_skill("yipai-liangsan", 1);
        set_skill("cuff", 1);
        set_skill("jingang-quan", 1);

        map_skill("parry", "jingang-buhuaiti");
        map_skill("force", "yijinjing");
        map_skill("dodge", "yiwei-dujiang");
        map_skill("whip", "riyue-bian");
        map_skill("strike", "yipai-liangsan");
        map_skill("cuff", "jingang-quan");

        prepare_skill("strike", "yipai-liangsan");

        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: perform_action, "whip.he" :),
                (: perform_action, "whip.shang" :),
                (: perform_action, "whip.chan" :),
                (: perform_action, "cuff.jingang" :),
                (: exert_function, "recover" :),
        }) );

        set("class", "bonze");

        carry_object("/clone/weapon/ultra_weapon/changbian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/ultra_weapon/tieshou")->wear();
}

