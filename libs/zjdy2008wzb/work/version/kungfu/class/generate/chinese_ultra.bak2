                        set_skill("ningxue-shenzhao", 1);
                        map_skill("claw", "ningxue-shenzhao");
                        prepare_skill("claw", "ningxue-shenzhao");
                        add("chat_msg_combat", ({
                                (: perform_action, "claw.ji" :),
