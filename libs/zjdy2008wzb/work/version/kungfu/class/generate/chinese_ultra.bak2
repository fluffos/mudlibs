                case 13:
                        set_skill("strike", 1);
                        set_skill("hand", 1);
                        set_skill("liuyang-zhang", 1);
                        set_skill("zhemei-shou", 1);
                        map_skill("strike", "liuyang-zhang");
                        map_skill("hand", "zhemei-shou");
