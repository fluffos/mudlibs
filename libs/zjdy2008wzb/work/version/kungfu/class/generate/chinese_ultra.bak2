                        }) );
                        carry_object("/clone/weapon/ultra_weapon/changbian")->wield();
                        break;
        }
}

private void init_force()
{
        string name;
        string *names = ({
                "taiji-shengong",
                "xixing-dafa",
                "beiming-shengong",
                "huagong-dafa",
                "linji-zhuang",
                "xiantiangong",
                "yijinjing",
                "huntian-qigong",
                "surge-force",
                "longxiang",
                "xuehai-mogong",
                "lengyue-shengong",
                "bahuang-gong",
                "shenghuo-xinfa",
                "shenzhaojing",
        });
        name = names[random(sizeof(names))];
        set_skill("force", 1);
        set_skill(name, 1);
        
        map_skill("force", name);
        switch(name)
        {
                case "huntian-qigong" :
                        add("chat_msg_combat", ({
                                (: exert_function, "shengang" :),
                        }) );
                        break;
                case "lengyue-shengong" :
                        add("chat_msg_combat", ({
                                (: exert_function, "freeze" :),
                        }) );
                        break;
                case "huagong-dafa" :
                        add("chat_msg_combat", ({
                                (: exert_function, "hua" :),
                        }) );
                        break;
                case "shenzhaojing" :
                        set_temp("notNeedWeapon", 1);
                        set_skill("unarmed", 1);
                        set_skill("shenzhaojing", 1);
                        map_skill("unarmed", "shenzhaojing");
                        prepare_skill("unarmed", "shenzhaojing");
                        add("chat_msg_combat", ({
                                (: perform_action, "unarmed.ying" :),
                                (: perform_action, "unarmed.wu" :),
                        }) );
                        break;
        }
}
private void init_parry()
{
        string name;
        string *names = ({
                "taiji-quan",
                "taiji-jian",
                "qiankun-danuoyi",
                "douzhuan-xingyi",
                "jingang-buhuaiti",
                "kongming-quan",
                "jinguan-yusuo",
                "yijin-duangu",
                "wai-bagua",
                "six-finger",
                "dragon-strike",
                "sad-strike",
                "pixie-jian",
                "quanzhen-jian",
                "dagou-bang",
                "riyue-bian",
        });
        name = names[random(sizeof(names))];
        set_skill("parry", 1);
        set_skill(name, 1);
        
        map_skill("parry", name);
        switch(name)
        {
                case "douzhuan-xingyi" :
                        add("chat_msg_combat", ({
                                (: perform_action, "parry.yi" :),
                        }) );
                        break;
        }
}

private void init_dodge()
{
        string name;
        string *names = ({
                "bianfu-bu",
                "qiankun-danuoyi",
                "lingbo-weibu",
                "caiyan-gong",
                "zhuangzi-wu",
                "shexing-lifan",
                "tiyunzong",
                "feiyan-huixiang",
                "beidou-xianzong",
                "sixiang-bufa",
                "zhutian-bu",
        });
        name = names[random(sizeof(names))];
        set_skill("dodge", 1);
        set_skill(name, 1);
        
        map_skill("dodge", name);
}
