                        set_skill("jingang-quan", 1);
                        map_skill("strike", "xumishan-zhang");
                        map_skill("cuff", "jingang-quan");
                        prepare_skill("strike", "xumishan-zhang");
                        add("chat_msg_combat", ({
                                (: perform_action, "cuff.jingang" :),                           
