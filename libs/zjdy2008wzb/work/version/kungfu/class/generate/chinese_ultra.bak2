// chan_cler 中国挑战者

inherit NPC;

// internal functions
private void init_force();
private void init_unarmed();
private void init_weapon();
private void init_parry();
private void init_dodge();

// external functions
public void setup_family(string family);

void create()
{
        string *fams;

        NPC_D->generate_cn_name(this_object());
        set("long", "一个人。\n");
        set("gender", "男性");
        set("age", 20);
        set("str", 20);
        set("int", 20);
        set("con", 20);
        set("dex", 20);

        // the follow 5 setting has no use      
        set("max_qi", 100);
        set("max_jing", 100);
        set("neili", 100);
        set("max_neili", 100);
        set("jiali", 100);

        set("combat_exp", 3000000);

        setup();

        // set family information
        set("family/family_name", "江湖人士");
        set("family/generation", 0);
        set("scale", 180);
        set("chat_chance_combat", 130);
        set("chat_msg_combat", ({
                (: exert_function, "recover" :),
        }) );        
        carry_object("/clone/weapon/ultra_weapon/tieshou")->wear();
        carry_object("/clone/weapon/tiejia")->wear();

        init_force();
        init_unarmed();
        init_weapon();
        init_parry();
        init_dodge();
}

private void init_unarmed()
{
        switch(random(17))
        {
                case 0:
                        set_skill("unarmed", 1);
                        set_skill("taiji-quan", 1);
                        set_skill("hand", 1);
                        set_skill("paiyun-shou", 1);
                        map_skill("unarmed", "taiji-quan");
                        map_skill("hand", "paiyun-shou");
                        prepare_skill("unarmed", "taiji-quan");
                        prepare_skill("hand", "paiyun-shou");
                        add("chat_msg_combat", ({
                                (: perform_action, "unarmed.zhen" :),                           
                        }) );
                        break;
                case 1:
                        set_skill("strike", 1);
                        set_skill("yitian-zhang", 1);
                        map_skill("strike", "yitian-zhang");
                        prepare_skill("strike", "yitian-zhang");
                        add("chat_msg_combat", ({
                                (: perform_action, "strike.zheng" :),                           
                        }) );
                        break;
                case 2:
                        set_skill("strike", 1);
                        set_skill("yipai-liangsan", 1);
                        map_skill("strike", "yipai-liangsan");
                        prepare_skill("strike", "yipai-liangsan");
                        break;
                case 3:
                        set_skill("strike", 1);
                        set_skill("cuff", 1);
