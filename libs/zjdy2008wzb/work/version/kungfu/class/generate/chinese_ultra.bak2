                                (: perform_action, "staff.wugou" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/gangzhang")->wield();
                        break;
                case 5:
                        set_skill("staff", 1);
                        set_skill("dagou-bang", 1);
                        map_skill("staff", "dagou-bang");
                        add("chat_msg_combat", ({
                                (: perform_action, "staff.chan" :),
