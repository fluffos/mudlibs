                        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
                        break;
                case 11:
                        set_skill("blade", 1);
                        set_skill("hujia-daofa", 1);
                        map_skill("blade", "hujia-daofa");
                        add("chat_msg_combat", ({
                                (: perform_action, "blade.bafang" :),
                                (: perform_action, "blade.pi" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/gangdao")->wield();
                        break;
                case 12:
                        set_skill("sword", 1);
                        set_skill("kuangfeng-jian", 1);
                        map_skill("sword", "kuangfeng-jian");
                        add("chat_msg_combat", ({
                                (: perform_action, "sword.kuang" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
                        break;
                case 13:
                        set_skill("sword", 1);
                        set_skill("pixie-jian", 1);
                        map_skill("sword", "pixie-jian");
                        add("chat_msg_combat", ({
