                        }) );
                        break;
                case 14:
                        set_temp("notNeedWeapon", 1);
                        set_skill("cuff", 1);
                        set_skill("qishang-quan", 1);
                        map_skill("cuff", "qishang-quan");
                        prepare_skill("cuff", "qishang-quan");
                        add("chat_msg_combat", ({
                                (: perform_action, "cuff.qimai" :),
