                        break;
                case 7:
                        set_skill("blade", 1);
                        set_skill("xue-dao", 1);
                        map_skill("blade", "xue-dao");
                        add("chat_msg_combat", ({
                                (: perform_action, "blade.xueyu" :),
                                (: perform_action, "blade.shendao" :),
                                (: perform_action, "blade.huan" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/gangdao")->wield();
                        break;
                case 8:
                        set_skill("staff", 1);
                        set_skill("shedao-qigong", 1);
                        map_skill("staff", "shedao-qigong");
                        add("chat_msg_combat", ({
                                (: perform_action, "staff.cui" :),
