                                (: perform_action, "strike.xiang" :),
                                (: perform_action, "strike.leiting" :),
                                (: perform_action, "strike.pai" :),
                        }) );
                        break;
                case 6:
                        set_skill("strike", 1);
                        set_skill("claw", 1);
                        set_skill("chousui-zhang", 1);
                        set_skill("sanyin-wugongzhao", 1);
                        map_skill("claw", "sanyin-wugongzhao");
                        map_skill("strike", "chousui-zhang");
                        prepare_skill("claw", "sanyin-wugongzhao");
                        prepare_skill("strike", "chousui-zhang");
                        add("chat_msg_combat", ({
                                (: perform_action, "strike.biyan" :),
                                (: perform_action, "strike.throw" :),
                                (: perform_action, "strike.huolang" :),
                                (: perform_action, "claw.zhua" :),
                        }) );
                        break;
                case 7:
                        set_skill("unarmed", 1);
                        set_skill("longxiang", 1);
                        map_skill("unarmed", "longxiang");
                        prepare_skill("unarmed", "longxiang");
                        add("chat_msg_combat", ({
                                (: perform_action, "unarmed.ji" :),                             
                        }) );
                        break;
                case 8:
                        set_temp("notNeedWeapon", 1);
