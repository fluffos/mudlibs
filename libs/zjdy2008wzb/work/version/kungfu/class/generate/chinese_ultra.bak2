                        break;
                default:
                        set_temp("notNeedWeapon", 1);
                        set_skill("unarmed", 1);
                        set_skill("baihua-quan", 1);
                        map_skill("unarmed", "baihua-quan");
                        prepare_skill("unarmed", "baihua-quan");
                        add("chat_msg_combat", ({
                                (: perform_action, "unarmed.cuo" :),                            
                        }) );
                        break;
        }
}

private void init_weapon()
{
        if (query_temp("notNeedWeapon"))
                return;

        switch(random(15))
        {
                case 0:
                        set_skill("sword", 1);
                        set_skill("taiji-jian", 1);
                        map_skill("sword", "taiji-jian");
                        add("chat_msg_combat", ({
                                (: perform_action, "sword.chan" :),
                                (: perform_action, "sword.zhenwu" :),
                                (: perform_action, "sword.lian" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
                        break;
                case 1:
                        set_skill("sword", 1);
                        set_skill("quanzhen-jian", 1);
                        set_skill("xiantiangong", 1);
			set_skill("xiantian-gong", 1);
                        map_skill("sword", "quanzhen-jian");
                        add("chat_msg_combat", ({
                                (: perform_action, "sword.chan" :),
                                (: perform_action, "sword.hua" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
                        break;
                case 2:
                        set_skill("sword", 1);
                        set_skill("huashan-sword", 1);
                        set_skill("xiantian-gong", 1);
                        map_skill("sword", "huashan-sword");
                        add("chat_msg_combat", ({
                                (: perform_action, "sword.sanxian" :),
                                (: perform_action, "sword.jie" :),
                        }) );
                        carry_object("/clone/weapon/ultra_weapon/changjian")->wield();
                        break;
                case 3:
                        set_skill("staff", 1);
