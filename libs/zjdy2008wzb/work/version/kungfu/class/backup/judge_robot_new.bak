// judge_robot.c
// Create by Chenzzz@HELL.RV
// 判断机器人（简单回答）
#include <ansi.h>;
// 入口方法
mixed do_ask();
mixed do_cancel();
mixed do_answer(string arg);
// 内部方法
mixed do_ask_digital();
mixed do_ask_color();
string set_color(int color, string str);
string *str_xxx = ({"1111110001100011000111111",    // 0
                    "0110000100001000010001110",    // 1
                    "1111100001111111000011111",    // 2
                    "1111100001111110000111111",
                    "1000110001111110000100001",
                    "1111110000111110000111111",    // 5
                    "1111110000111111000111111",
                    "1111100001000010000100001",
                    "1111110001111111000111111",
                    "1111110001111110000111111",});

mixed do_ask()
{
        switch(random(9)){
                case 0:
                        return do_ask_digital();
                default:
                        return do_ask_color();
        }
}

mixed do_answer(string arg)
{
        object me = this_player();
        string str_answer = me->query_temp("robot_judge/answer");

        if (!arg)
        {
                tell_object(me, "你要回答什么？\n");
                return 1;
        }
        if (me->is_busy())
        {
                tell_object(me, "你正忙着呢！\n");
                return 1;
        }
        if (undefinedp(me->query_temp("robot_judge/answer")))
        {
                tell_object(me, "没有人向你提问啊。\n");
                return 1;
        }
        if (me->query_temp("robot_judge/time") < time())
        {
                tell_object(me, "已经超过十秒的回答时间了。\n");
                return 1;
        }
        if (arg == str_answer)
        {
                message_vision("$N点了点头，说道：好，$n答对了。\n",
                       this_object(), me);
                me->delete_temp("robot_judge/answer");
                me->set_temp("robot_judge/ok", 1);
                return 1;
        }
        else
        {
                message_vision("$N叹了口气，对$n道：这么简单都答不对？\n",
                                this_object(), me);
                me->start_busy(1 + random(3));
                return 1;
        }
        return 1;
}

mixed do_cancel()
{
        object me = this_player();

        if (me->is_busy())
                return "你正忙着呢！";

        if (undefinedp(me->query_temp("robot_judge/answer")))
                return "没有人向你提问啊。";

        me->delete_temp("robot_judge/answer");
        message_vision("$N叹了口气，对$n道：回答不上就算了，你休息一会吧。\n",
                       this_object(), me);
        me->start_busy(1 + random(3));

        return 1;
}

mixed do_ask_color()
{
        object me = this_player();
        int i, j, k;
        int rnd;
        string msg = "";
        int *int_long = ({ });
        int *int_long_discove = ({0, 0, 0, 0, 0, });
        int *int_color = ({ });
        int *int_color_discove = ({0, 0, 0, 0, 0, });
        int int_answer = 0;
        string str_answer;
        int int_row = random(3);
        // 显示三行
        for (k = 0; k < 3; k++)
        {
                int_long  = ({1, 3, 5, 7, 10, });
                int_color = ({0, 1, 2, 3, 4, });
                // 数组从新随机排序
                for (i = sizeof(int_long); i > 0; i--)
                {
                        rnd = random(i);
                        int_long_discove[i - 1] = int_long[rnd];
                        int_long[rnd] = int_long[i - 1];
                        rnd = random(i);
                        int_color_discove[i - 1] = int_color[rnd];
                        int_color[rnd] = int_color[i - 1];
                }
                // 循环多种颜色
                for (i = 0; i < sizeof(int_long_discove); i++)
                {
                        tell_object(me, "** k = " + k + ", i = " + i + ", row = " + int_row + ", long = " + int_long_discove[i] + ", answer = " + int_answer + "\n");
                        // 找出其中最多的
                        if (k == int_row && int_long_discove[i] > int_long_discove[int_answer])
                                int_answer = i;
                        // 显示同颜色的多个字符
                        for (j = 0; j < int_long_discove[i]; j++)
                        {
                                msg += set_color(int_color_discove[i], "■");
                        }
                }
                tell_object(me, "int_answer = " + int_answer + "\n");
                if (k == int_row)
                        int_answer = int_color_discove[int_answer];
                tell_object(me, "int_answer = " + int_answer + "\n");
                msg += "\n\n" NOR;
        }
        msg += "\n\n" NOR;
        tell_object(me, "大宗师对着你说道：\n\n" + msg + "请回答（answer）第" +
                        HIY + chinese_number(int_row + 1)  + NOR + "行中哪种颜色出现最多：\n");

        switch(int_answer){
                case 0:
                        str_answer = "R";
                        break;
                case 1:
                        str_answer = "H";
                        break;
                case 2:
                        str_answer = "Y";
                        break;
                case 3:
                        str_answer = "B";
                        break;
                default:
                        str_answer = "W";
                        break;
        }
        tell_object(me, "str_answer = " + str_answer + "\n");
        me->set_temp("robot_judge/answer", str_answer);
        me->set_temp("robot_judge/time", time() + 10);
        me->delete_temp("robot_judge/ok", 1);
        return 1;
}
mixed do_ask_digital()
{
        object me = this_player();
        string message = "";
        string *str_key = ({"B", "D", "M", "Q", "O", "#", "&", "$"});
        string str_char;
        int i, j, k;
        int message_long = 1 + random(6);
        int *int_answer = ({random(10), random(10), random(10), random(10), random(10), random(10)});
        int *int_row    = ({random(3), random(3), random(3), random(3), random(3), random(3)});
        int *int_index  = ({0, 0, 0, 0, 0, 0});

        if (me->is_busy())
                return "你正忙着呢！";

        if (! undefinedp(me->query_temp("robot_judge/answer")))
        {
                me->start_busy(2);
                return "你已经收到问题了，请尽早回答。";
        }
        message = HIC "";
        for (i = 0; i < 8; i++)
        {
                for (j = 0; j < message_long;)
                {
                        message += " ";
                        if (i >= int_row[j] && i <= 5 + int_row[j])
                        {
                                for (k = 0; k < 5; k++)
                                {
                                        if (str_xxx[int_answer[j]][int_index[j]..int_index[j]++] == "1")
                                                message += str_key[random(sizeof(str_key))];
                                        else
                                                message += " ";
                                }
                        }
                        else
                        {
                                message += "     ";
                        }
                        if (++j == message_long)
                                message += "\n";
                        else
                                message += " ";
                }
        }
        message += "" NOR;
        tell_object(me, "大宗师对着你说道：\n\n" + message + "请回答（answer）这组数字是多少：\n");

        message = "";
        for (i = 0; i < message_long; i++)
                message += (string)int_answer[i];
        me->set_temp("robot_judge/answer", message);
        me->set_temp("robot_judge/time", time() + 10);
        me->delete_temp("robot_judge/ok", 1);
        return 1;
}

string set_color(int color, string str)
{
        switch(color){
                case 0:  return HIR "" + str;
                case 1:  return HIG "" + str;
                case 2:  return HIY "" + str;
                case 3:  return HIB "" + str;
                default: return HIW "" + str;
        }

}
