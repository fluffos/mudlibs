#include <ansi.h>;

mixed do_ask();
mixed do_cancel();
mixed do_answer(string arg);

string *str_xxx = ({"1111110001100011000111111",    // 0
                    "0110000100001000010001110",    // 1
                    "1111100001111111000011111",    // 2
                    "1111100001111110000111111",
                    "1000110001111110000100001",
                    "1111110000111110000111111",    // 5
                    "1111110000111111000111111",
                    "1111100001000010000100001",
                    "1111110001111111000111111",
                    "1111110001111110000111111",});

mixed do_ask()
{
        object me = this_player();
        string message = "";        
        string *str_key = ({"B", "D", "M", "Q", "O", "#", "&", "$"});
        string str_char;
        int i, j, k;
        int message_long = 1 + random(6);
        int *int_answer = ({random(10), random(10), random(10), random(10), random(10), random(10)});
        int *int_row    = ({random(3), random(3), random(3), random(3), random(3), random(3)});
        int *int_index  = ({0, 0, 0, 0, 0, 0});
        
        if (me->is_busy())
                return "你正忙着呢！";

        if (! undefinedp(me->query_temp("robot_judge/answer")))
        {
                me->start_busy(2);
                return "你已经收到问题了，请尽早回答。";
        }        
        message = HIC "";
        for (i = 0; i < 8; i++)
        {
                for (j = 0; j < message_long;)
                {
                        message += " ";
                        if (i >= int_row[j] && i <= 5 + int_row[j])
                        {
                                for (k = 0; k < 5; k++)
                                {
                                        if (str_xxx[int_answer[j]][int_index[j]..int_index[j]++] == "1")
                                                message += str_key[random(sizeof(str_key))];                               
                                        else
                                                message += " ";
                                }
                        }
                        else
                        {
                                message += "     ";
                        }
                        if (++j == message_long)
                                message += "\n";
                        else
                                message += " ";
                }
        }
        message += "" NOR;
        tell_object(me, "大宗师对着你说道：\n\n" + message + "请回答（huida）这组数字是多少：\n");
        
        message = "";
        for (i = 0; i < message_long; i++)
                message += (string)int_answer[i];
        me->set_temp("robot_judge/answer", message);
        return 1;
}

mixed do_answer(string arg)
{
        object me = this_player();
        string str_answer = me->query_temp("robot_judge/answer");

        if (!arg)
        {
                tell_object(me, "你要回答什么？\n");
                return 1;
        }
        if (me->is_busy())
        {
                tell_object(me, "你正忙着呢！\n");
                return 1;
        }
        if (undefinedp(me->query_temp("robot_judge/answer")))
        {
                tell_object(me, "没有人向你提问啊。\n");
                return 1;
        }
        if (arg == str_answer)
        {
        message_vision("$N点了点头，说道：OK，你答对了。\n",
                       this_object(), me);
                me->delete_temp("robot_judge/answer");
                me->set_temp("robot_judge/ok");
                return 1;
        }
        else
        {
                message_vision("$N叹了口气，对$n道：这么简单都答不对？\n",
                		this_object(), me);
                me->start_busy(2 + random(10));
                return 1;
        }
        return 1;
}

mixed do_cancel()
{
        object me = this_player();
        
        if (me->is_busy())
                return "你正忙着呢！";

        if (undefinedp(me->query_temp("robot_judge/answer")))
                return "没有人向你提问啊。";
                
        me->delete_temp("robot_judge/answer");
        message_vision("$N叹了口气，对$n道：回答不上就算了，你休息一会吧。\n",
                       this_object(), me);
        me->start_busy(2 + random(10));
        
        return 1;
}

