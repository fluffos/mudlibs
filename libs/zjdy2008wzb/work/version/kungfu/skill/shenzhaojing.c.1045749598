int valid_force(string force)
{
        return 1;
}

int valid_enable(string usage)
{ 
        return usage == "force" || usage=="unarmed" || usage=="cuff" || usage =="parry";
}

int valid_learn(object me)
{
        if (me->query("gender") == "无性" && me->query("shenzhaojing", 1) > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的神照经神功。\n");

        if ((int)me->query_skill("force", 1) < 100)
                return notify_fail("你的基本内功火候不足，不能学神照经神功。\n");

        if ((int)me->query_skill("unarmed", 1) < 100)
                return notify_fail("你的基本拳脚火候不足，不能学神照经神功。\n");

        if ((int)me->query("max_neili", 1) < 1000)
                return notify_fail("你的内力修为不足，不能学神照经神功。\n");

        if (me->query_skill("force", 1) < me->query_skill("shenzhaojing", 1))
                return notify_fail("你的基本内功水平不够，难以锻炼更深厚的神照经神功。\n");

        if (me->query_skill("unarmed", 1) < me->query_skill("shenzhaojing", 1))
                return notify_fail("你的基本拳脚水平不够，难以锻炼更深厚的神照经神功。\n");
        
        if (me->query_skill("parry", 1) < me->query_skill("shenzhaojing", 1))
                return notify_fail("你的基本招架水平不够，难以锻炼更深厚的神照经神功。\n");
        
        if (me->query_skill("cuff", 1) < me->query_skill("shenzhaojing", 1) * 8 / 10)
                return notify_fail("你的基本拳法水平不够，难以锻炼更深厚的神照经神功。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        int enforce;
        int lv_force;
        level = me->query_skill("shenzhaojing", 1);
        enforce = me->query("jiali");
        lv_force = me->query_skill("force", 1);
        
        if (me->query_temp("shenzhaojing/wuyingquanjin") &&
            random(level) > 240 &&
            random(enforce) > lv_force / 4 &&
            me->query("neili") > 1500 &&
            !random(3))
        {
                me->add("neili", -50);
                me->set_temp("shenzhaojing/wuyin",1);
                return ([
                        "action": HIR "$N默默聚集神照经神功之无影拳劲于双拳之上，然后猛的一声狂啸，"
                                  HIR "拳路大开大阖，接连向$n击出数拳，每一拳击出便如诸神震怒、石"
                                  HIR "破天惊，皆含催破内家真气的无影拳劲。",
                        "dodge"  : 125 + enforce / 10,
                        "force"  : 450 + enforce / 8,
                        "attack" : 173 + enforce / 10,
                        "parry"  : 127 + enforce / 10,
                        "damage" : 123 + enforce / 10,
                        "option" : ENABLE_SORT | IGNORE_FORCE | IGNORE_ARMOR,
                        "weapon" : "无影拳劲",
                        "damage_type": "震伤"]);        
        }


        else
        if (me->query_temp("shenzhaojing/wuyingquanjin") &&
            random(level) > 180 &&
            random(enforce) > lv_force / 5 &&
            me->query("neili") > 1000 &&
            !random(3))
        {
                me->add("neili", -50);
                me->set_temp("shenzhaojing/wuyin",1);
                return ([
                        "action": HIR "$N默默聚集神照经神功之无影拳劲于双拳之上，突然一声吆喝，宛"
                                  HIR "似凭空打了个霹雳，猛响声中，一拳暗含催破内家真气的无影拳劲"
                                  HIR "直出打在$n的$l之上。",
                        "dodge"  : 105 + enforce / 10,
                        "force"  : 380 + enforce / 8,
                        "attack" : 153 + enforce / 10,
                        "parry"  : 107 + enforce / 10,
                        "damage" : 113 + enforce / 10,
                        "option" : ENABLE_SORT | IGNORE_FORCE | IGNORE_ARMOR,
                        "weapon" : "无影拳劲",
                        "damage_type": "震伤"]);        
        }
            
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 50, level)];
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int lvl;
        
        lvl = me->query_skill("shenzhaojing", 1);

        if (damage_bonus < 160 || lvl < 180) return 0;
        // 运用神照经的无影拳劲后的额外伤害
        if (me->query_temp("shenzhaojing/wuyin",1) && random(5) > 1)
        {
                me->delete_temp("shenzhaojing/wuyin");
                victim->receive_wound("qi", (damage_bonus - 50) / 2, me);
                victim->affect_by("shenzhao",
                               ([ "level" : me->query("jiali") + random(me->query("jiali")),
                                  "id"    : me->query("id"),
                                  "duration" : lvl / 50 + random(lvl / 5) ]));
                return HIR "$n" HIR "一声惨嚎，「" HIY "无影拳劲" HIR "」穿透护身真气"
                       "直击全身上下三十六道要穴。\n" NOR;
        }        
        // 神照经神功所具有的既添设额外伤害又使对手中
        // 毒的max_hit 在所有武功中是绝无仅有的，但是
        // 它出现的几率以及伤害值又及毒性伤害相对于其
        // 他武功大大减弱。
        if (damage_bonus / 6 > victim->query_con() && random(5) > 2)
        {
                victim->receive_wound("qi", (damage_bonus - 100) / 3, me);
                victim->affect_by("shenzhao",
                               ([ "level" : me->query("jiali") + random(me->query("jiali")),
                                  "id"    : me->query("id"),
                                  "duration" : lvl / 100 + random(lvl / 10) ]));
                return HIR "$n" HIR "一声惨嚎，全身骨骼格格格格爆声不"
                       "绝，肋骨、臂骨、腿骨同时断折。\n" NOR;
        }
}

int practice_skill(object me)
{
        int lvl;
        lvl = me->query_skill("shenzhaojing", 1);
        
        if (me->query_temp("shenzhaojing/parctice"))
                return notify_fail("你正想练习神照经神功却发现内力提不起来，看来还是得等一会再练习。\n");
                
        if (lvl < 40)
                return notify_fail("你对神照经神功认识太浅，只能用学(learn)的来增加熟练度。\n");
        
        if (lvl > 180)
                return notify_fail("你觉得神照经神功高深无比，不有通过简单的练习来增加熟练度。\n");
        
        if ((int)me->query("neili") < 200 + (20 * lvl) / 3)
                return notify_fail("你现在的内力太低了，神照经神功。\n");
                
        if (me->query("potential") - me->query("learned_points") >= 10)
        {
                me->improve_skill("shenzhaojing", me->query("con") * 5 + 120);
                me->set_temp("shenzhaojing/parctice",1);
                me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), 2);
                me->add("neili", - (20 * lvl) / 3); 
                me->add("potential", -10);
                return 1;
        }
        else 
                return notify_fail("你现在没有潜能来提高神照经神功了。\n");
        
        return notify_fail("神照经神功只能用学(learn)的来增加熟练度。\n");
}

void skill_improved(object me)
{
        int lvl;
        int neili_add;
        lvl = me->query_skill("shenzhaojing", 1);
        if (lvl > 100 && me->query_neili_limit() > me->query("max_neili"))
        {
                tell_object(me, HIW"随着神照经神功的提高，你突然发现丹田里的内息更加充沛。\n"NOR);
                neili_add = 10 + random(lvl / 4);
                if (neili_add > 50)
                        neili_add = 50 + random((neili_add - 50) / 3);
                me->add("max_neili", neili_add);
        }
}

int difficult_level()
{
        return 500;
}

void remove_effect(object me)
{
        if (me->query_temp("shenzhaojing/parctice"))
        {
                me->delete_temp("shenzhaojing/parctice");
        }
}

string perform_action_file(string action)
{
        return __DIR__"shenzhaojing/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"shenzhaojing/exert/" + action;
}

