// shield.c 先天无极劲

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int a_amount);

int exert(object me, object target)
{
        int skill;
        string msg;

        if ((int)me->query_skill("xiantiangong", 1) < 300)
                return notify_fail("你的先天功不够深厚，不能使用先天无极劲。\n");

        if ((int)me->query("neili") < 200) 
                return notify_fail("你现在的真气不够。\n");

        if ((int)me->query_temp("xiantian"))
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("xiantiangong", 1);
        msg = HIY "$N" HIY "双目微闭，凝聚先天真气，顿时迸出"
              "一股先天罡气将$P" HIY "全全笼罩。\n" NOR;
        message_combatd(msg, me);

        me->add_temp("apply/attack", skill / 5);
        me->add_temp("apply/defense", skill / 5);
        me->add_temp("apply/dodge", skill / 8);
        me->add_temp("apply/parry", skill / 8);
        me->add_temp("apply/armor", skill / 5);
        me->set_temp("xiantian", 1);

        me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

        me->add("neili", -100);
        if (me->is_fighting()) me->start_busy(2);

        return 1;
}

void remove_effect(object me, int amount)
{
        if (me->query_temp("xiantian"))
        {
                me->add_temp("apply/attack", -amount / 5);
                me->add_temp("apply/defense", -amount / 5);
                me->add_temp("apply/dodge", -amount / 8);
                me->add_temp("apply/parry", -amount / 8);
                me->add_temp("apply/armor", -amount / 5);
                me->delete_temp("xiantian");
                tell_object(me, "你将先天真气运转过一个周天，将内力收回丹田。\n");
        }
}

