#include <ansi.h>
#include <combat.h>

#define JI "「" HIY "般若极" NOR "」"

inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
        int ap, dp, jia, layer, damage;
        int change;
        int busy_time;
        string msg;

        if (! target) target = offensive_target(me);

        if (! target || ! me->is_fighting(target))
                return notify_fail(JI "只能对战斗中的对手使用。\n");

        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail(JI "只能空手施展。\n");

        if ((int)me->query_skill("longxiang", 1) < 200)
                return notify_fail("你的龙象般若功修为不够，难以施展" JI "。\n");

        if (me->query("max_neili") < 3000)
                return notify_fail("你的内力修为不足，难以施展" JI "。\n");

        if (me->query_skill_mapped("unarmed") != "longxiang")
                return notify_fail("你没有激发龙象般若功为拳脚，难以施展" JI "。\n");

        if (me->query_skill_mapped("force") != "longxiang")
                return notify_fail("你没有激发龙象般若功为内功，难以施展" JI "。\n");

        if (me->query("neili") < 800)
                return notify_fail("你现在的真气不足，难以施展" JI "。\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

        layer = me->query_skill("longxiang", 1) / 30;

        if (layer > 13) layer = 13;

        msg = HIY "$N" HIY "运转龙象般若功第" + chinese_number(layer) + "层"
              "功力，双拳携着龙象之力朝$n" HIY "崩击而出，\n一拳打出，竟卷"
              "起四周数尺尘埃，正是密宗绝学「" HIW "般若极" HIY "」。\n" NOR;

        ap = me->query_skill("unarmed") +
             me->query_skill("force");

        dp = target->query_skill("force") * 2;

        if (ap / 2 + random(ap) > dp)
        {
                if (layer = 13) 
                        ap *= 12 / 10;
                        
                busy_time = 2;
                if (ap / 3 + random(ap) > dp && target->query_temp("shield"))
                {
                        target->add_temp("apply/armor", - target->query_temp("add/armor"));
                        target->delete_temp("shield");
                        busy_time += 1;

                        msg += HIW "$N" HIW "罡气涌至，竟然激起层层气浪，顿时将$n"
                               HIW "的护体真气摧毁得荡然无存！\n" NOR;
                }
                if (ap / 4 + random(ap) > dp && target->query_temp("powerup"))
                {
                        target->add_temp("apply/attack", - target->query_temp("add/attack"));
                        target->add_temp("apply/defense", - target->query_temp("add/defense"));
                        target->add_temp("apply/parry", - target->query_temp("add/parry"));
                        target->add_temp("apply/dodge", - target->query_temp("add/dodge"));
                        target->add_temp("apply/damage", - target->query_temp("add/damage"));
                        target->add_temp("apply/unarmed_damage", - target->query_temp("add/unarmed_damage"));
                        target->delete_temp("powerup");
                        busy_time += 1;

                        msg += HIW "$N" HIW "罡气破体而入，竟然侵入$n"
                               HIW "丹田之内，顿时将$n"
                               HIW "凝聚于丹田内的真气摧毁！\n" NOR;
                }
                jia = me->query("jiali");
                damage = ap / 2 + random(jia * 3);
                me->add_temp("break/defend", me->query_skill("longxiang", 1) / 8);

                msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 100,
                                               HIR "$n" HIR "不及闪避，顿被$N" HIR
                                               "双拳击个正中，般若罡劲破体而入，尽"
                                               "伤三焦六脉。\n" NOR);

                me->delete_temp("break/defend");
                me->start_busy(busy_time + random(3));
                me->add("neili", -800);
        } else
        {
                me->start_busy(3 + random(3));
                me->add("neili", -500);
                msg += CYN "可是$p" CYN "识破了$P"
                       CYN "这一招杀着，斜斜一跃避开。\n" NOR;
        }
        message_combatd(msg, me, target);

        return 1;
}

