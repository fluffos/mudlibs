// shexing-lifan.c 蛇行狸翻
// Modified by chenzzz 2002 Christmas
#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({
        "只见$n清啸一声，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
        "$n身形飘忽，灵巧无比，轻轻向后一纵，早已避开。\n",
        "只见$n身行随意转，如同水蛇一般，倏地往一旁挪开了三尺，避过了这一招。\n",
        "可是$n着地一个猛翻，侧身一让，$N这一招扑了个空。\n",
        "却见$n蛮腰摆动，足不点地，往旁窜开数尺，躲了开去。\n",
        "$n飞身跃起，在半空中一个翻滚，身形一晃，有惊无险地避开了$N这一招。\n"

});

int valid_enable(string usage) 
{ 
        return usage == "dodge"; 
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

mixed valid_damage(object ob, object me, int damage, object weapon) 
{ 
        mixed result; 
        int ap, dp, mp; 
        int base;
       
        if ((int)me->query_skill("shexing-lifan", 1) < 100 || 
            ! living(me)) 
                return; 
        
        mp = ob->query_skill("count", 1) / 2;
        ap = ob->query_skill("dodge", 1) + ob->query_skill("martial-cognize", 1) / 2 + mp;
        dp = me->query_skill("shexing-lifan", 1) + me->query_skill("martial-cognize", 1) / 2; 
        
        // 若 parry 使用配套的 yijin-duangu，效果较强。
        base = (me->query_skill_mapped("parry") == "yijin-duangu") ? 3 : 5;
        
        // 若 force 使用的是 jiuyin-shengong，效果增强。
        if(me->query_skill_mapped("force") == "jiuyin-shengong")
                base -= 1;
        
        // 若学了 sad-strike / never-defeated / bluesea-force / kuihua-mogong 效果减弱。
        if(me->query_skill("sad-strike", 1) > 100 || me->query_skill("never-defeated", 1) > 300 || 
           me->query_skill("bluesea-force", 1) > 300 || me->query_skill("kuihua-mogong", 1) > 300)
                base += 3;        
       
        // 由于不需要研究，基本效果一般
        if ((ap / 2 + random(ap)) * base / 2 < dp) 
        { 
                result = ([ "damage": -damage ]); 
       
                switch (random(4)) 
                { 
                case 0: 
                        result += (["msg" : HIW "只见$n" HIW "身形随意转，如同水蛇一般，" 
                                            HIW "倏地往一旁挪开了三尺，轻易避过了$N" 
                                            HIW "这一招。\n" NOR]); 
                        break; 
                case 1: 
                        result += (["msg" : HIW "$n" HIW "飞身跃起，在半空中一个翻滚，"
                                            HIW "身形忽然一晃，有惊无险地避开了$N"
                                            HIW "这一击。\n" NOR]); 
                        break; 
                case 2: 
                        result += (["msg" : HIW "$n" HIW "就地一个猛翻，侧身一让，" 
                                            HIW "已然躲至三尺之外，$N" 
                                            HIW "这一招扑了个空。\n" NOR]); 
                        break; 
                default: 
                        result += (["msg" : HIW "但见$n" HIW "踏着蛇行步，身体曲成一团冲向$N" 
                                            HIW "，迎面却是一个翻身，使$N" 
                                            HIW "不知如何攻击是好。\n" NOR]); 
                        break;                  
                } 
                return result; 
        } else
        if (mp >= 100)
        {
                switch (random(3))
                {
                case 0:
                        result = HIY "只见$n" HIY "身形随意转，如同水蛇一般，$N" 
                                 HIY "可是早已看穿其中奥妙，一步追了上去，挥招直入。\n" NOR;
                        break;

                case 1:
                        result = HIY "$n" HIY "飞身跃起，在半空中一个翻滚，却见$N"
                                 HIY "立即攻出一招，$n" HIY "身在空中无从躲避。\n" NOR;
                        break;

                default:
                        result = HIY "$n" HIY "就地一个猛翻，侧身一让，然而$N" 
                                 HIY "已然看出其中变化，抢先一步攻向三尺之外处。\n" NOR;
                        break;
                }
                COMBAT_D->set_bhinfo(result);
        }
} 

int valid_learn(object me)
{
        int level;
        int lv_martial;
        
        lv_martial = me->query_skill("martial-cognize", 1);

        if (lv_martial < 50)
                return notify_fail("你觉得蛇行狸翻过于深奥，以"
                                   "自己现在的武学修养全然无法明白。\n");
        //        return notify_fail("你觉得自己的身法总是没法适应蛇行狸翻的节奏。\n");
                
        level = me->query_skill("shexing-lifan", 1);      
        
        if (level < 199)
                if (me->query("gift/xiandan")  > 0 || me->query("gift/unknowdan") > 0)
                        return notify_fail("你刚想练习蛇行狸翻，却发现总是有点不正常，看来是受药物的影响。\n");
        if (me->query("gender") == "无性" && level > 199)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的蛇行狸翻。\n");          
        
        if (lv_martial < 200 && lv_martial < level)
                return notify_fail("你觉得自己的武学修养有限，难以领会更高深的蛇行狸翻。\n");

        return 1;
}

int practice_skill(object me)
{
        int cost;

        cost = 10 + me->query_skill("shexing-lifan", 1) / 3;
        if ((int)me->query("qi") < 60) 
                return notify_fail("你的体力太差了，难以练习蛇行狸翻。\n"); 
     
        if ((int)me->query("neili") < cost) 
                return notify_fail("你的内力不够了，无法练习蛇行狸翻。\n"); 
      
        me->receive_damage("qi", 30); 
        me->add("neili", -cost); 
        return 1;         
}

string perform_action_file(string action)
{
        return __DIR__"shexing-lifan/" + action;
}
