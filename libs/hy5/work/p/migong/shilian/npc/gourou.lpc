// turou.c 红烧狗肉

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("动物鲜肉", ({ "xian rou", "xianrou" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块血淋淋的动物鲜肉。\n");
    set("unit", "碗");
    set("value", 200 + random(300));
    set("food_remaining", 4);
    set("food_supply", 80);
  }
}
