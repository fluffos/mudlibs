// grape.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("葡萄", ({ "grape" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一串紫红色的葡萄。\n");
		set("unit", "串");
		set("value", 50);
		set("food_remaining", 4);
		set("food_supply", 10);
	}
	setup();
}