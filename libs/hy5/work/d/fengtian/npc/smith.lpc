// smith.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("周铁匠", ({ "smith zhou","zhou","smith" }) );
        set("gender", "男性" );
        set("age", 38);
	set("str",88);
        set("long", "铁匠铺老板张铁匠。\n");
        set("combat_exp", 300);
        set("attitude", "friendly");
        set_skill("dodge", 60);
        set_skill("unarmed", 60);
	set("attitude", "friendly");
        set("vendor_goods",({
                   "/d/city/obj/changjian",
                   "/d/city/obj/hammer",
                   "/d/city2/obj/tudao",
		"/d/city/obj/dagger",
                  "/d/xingxiu/obj/tiegun",
                  "/d/city/obj/gangdao",
        }));
        setup();

	carry_object("/clone/misc/cloth")->wear();
}
void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
