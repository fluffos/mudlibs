// suji.c 素鸡

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("酱香牛肉", ({"niu rou", "niurou"}));
	set_weight(200);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一斤做工考究酱香牛肉。\n");
		set("unit", "斤");
		set("value", 350);
		set("food_remaining", 10);
		set("food_supply", 90);
	}
}
