
// magic_armor.c
#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create()
{	set_name("奇门遁甲", ({"magic armor","armor"}));
	set_weight(1);
	if(clonep())
		set_default_object(__FILE__);
	else{
	set("unit","件");
	set("material","gold");
	set("armor_prop/armor",50);
	set("armor_prop/dodge",10);
	    }
	set("no_get",1);
	setup();
}
