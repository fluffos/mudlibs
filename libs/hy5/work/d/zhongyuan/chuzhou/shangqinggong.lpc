inherit ROOM;
#include <ansi.h>

void create() {
  set("short", WHT "上清宫" NOR);
  set("long", @LONG
上清宫真是一座香火鼎盛的大道观。这里每天都有成百上千的人前来问吉凶，
求保佑。那些大财主们往往一出手就是上千上万银子的捐赠，所以观里面的道士
也一个个春风得意。不过据说这里的天尊真的十分灵验，而这里的道士算命更是
十二分的准。
LONG
  );
  set("no_kill", "yangzhou");
  set("exits", ([
    "west": __DIR__ "qingyun_lu",
  ]));
  set("objects", ([
    __DIR__ "npc/daoshi": 1,
    __DIR__ "npc/daoshi2": 1,
  ]));
  setup();
}
