#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("兽皮", ({ "hide"}) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("for_create_cloth",1);
                set("material", "cloth");
                set("long", "一件野兽皮。\n");
                set("value", 1000);
                set("armor_prop/armor", 50);
        }
        
}   
