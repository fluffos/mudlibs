// dumpling.c
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("泞", ({ "jibao" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "泞糛糛荐乃乃\n");
    set("unit", "泞");
    set("value", 90);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
  setup();
}
