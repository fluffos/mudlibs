#include <ansi.h>
inherit NPC;

void create() {
  set_name(YEL "山庄门卫" NOR, ({ "menwei", "men wei" }));
  set("gender", "男性");
  set("age", 23);

  set("combat_exp", 50000);
  set("shen_type", 1);
  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  create_family("雁荡派", 3, "弟子");
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
