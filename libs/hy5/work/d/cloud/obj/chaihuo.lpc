
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( "一捆柴火", ({ "chaihuo"}) );
        set_weight(50000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "捆");               
                set("value", 0);
                set("material", "iron");
        }
        setup();
}
