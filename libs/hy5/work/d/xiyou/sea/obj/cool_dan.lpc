#include <ansi.h>

inherit ITEM;

int do_eat(string);
void create()
{
  set_name(HIC "碧水丹" NOR, ({"bishui dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "碧油油的一颗碧水丹。\n");
    set("value", 500);
    set("no_sell", 1);
  }
  
  setup();
}

