// 轩辕古墓 守墓妖狐狸
//by junhyun@SK

#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIC "护宝妖狐" NOR, ({ "hubao yaohu", "fox", "hu" }));
  set("title", HIW "轩辕古墓" NOR);
  set("gender", "女性");
  set("taskguai", 1);
  set("age", 20);
  set("per", 40);
  set("str", 30);
  set("family/family_name", "轩辕古墓");
  set("class", "yaomo");
  set("long", "守卫着轩辕古墓中众多宝物的妖狐\n");

  set("attitude", "aggressive");

  set("combat_exp", 10000000);
  set("daoxing", 100000000);


  set_temp("apply/armor", 50);
  set_temp("apply/dodge", 50);

  setup();

  carry_object("/d/obj/weapon/sword/xy_sword.lpc")->wield();
}
