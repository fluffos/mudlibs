string cast_spell_file(string spell)
{
	string dir;
	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("cast_dir")) 
	 || strlen(dir)<2 )
		return 0;	 
        return CLASS_D("equip") + "/cast/"+dir+"/" + spell;
}

string perform_action_file(string action)
{
	string dir;
	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("perform_dir")) 
	 || strlen(dir)<2 )
		return 0;	
  	return CLASS_D("equip") + "/perform/" + dir+"/"+action;
}

string exert_function_file(string func)
{
	string dir;
	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("exert_dir")) 
	 || strlen(dir)<2 )
		return 0;
        return CLASS_D("equip") + "/exert/" + dir+"/"+func;
}

int exert_function(object me, string arg)
{
	string dir,action, target, file,msg;
	object target_ob,ob;

	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("exert_dir")) 
	 || strlen(dir)<2 )
	 	return 0;
	if( sscanf(arg,"%s %s",action,target)==2 ) 
    	{
    		target_ob = present(target, environment(me));
		if( !target_ob ) 
			return notify_fail("这里没有 " + target + "。\n");
	} 
	else 	action = arg;
	if( !stringp(file = (string)this_object()->exert_function_file(action))
  	|| file_size(file + ".lpc") <= 0 ) 
    		return 0;

	if( time()<(me->query_temp("no_exert/start")+me->query_temp("no_exert/time")) )
    	{
    		if( stringp(msg=me->query_temp("no_exert/msg")) )
        		return notify_fail(msg+"\n"NOR);
	}
	me->set_temp("kill_msg","exert_equip_"+action);
	return (int)call_other( file, "exert", me, this_object(),target_ob);	
}

int perform_action(object me, string arg)
{
	string dir,action, target, file,msg;
	object target_ob;
	
	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("perform_dir")) 
	 || strlen(dir)<2 )
		return 0;
	if( sscanf(arg,"%s %s",action,target)==2 ) 
    	{
    		target_ob = present(target, environment(me));
		if( !target_ob ) 
			return notify_fail("这里没有 " + target + "。\n");
	} 
	else    action = arg;
	if( !stringp(file = (string)this_object()->perform_action_file(action))
  	|| file_size(file + ".lpc") <= 0 ) 
    		return 0;
	if( time()<(me->query_temp("no_perform/start")+me->query_temp("no_perform/time")) )
    	{
    		if( stringp(msg=me->query_temp("no_perform/msg")) )
        		return notify_fail(msg+"\n"NOR);
        	else	return notify_fail("你现在不能施展外功。\n");	
	}
	me->set_temp("kill_msg","perform_equip_"+action);
	return (int)call_other( file, "perform", me, this_object(),target_ob);
}

int cast_spell(object me, string arg)
{
	string dir,action, target, file,msg;
	object target_ob;

	if( !query("equipped") )
		return 0;
	if( !stringp(dir=query("cast_dir")) 
	 || strlen(dir)<2 )
		return 0;
	if( sscanf(arg,"%s %s",action,target)==2 ) 
    	{
    		target_ob = present(target, environment(me));
		if( !target_ob ) 
			return notify_fail("这里没有 " + target + "。\n");
	} 
	else    action = arg;
	if( !stringp(file = (string)this_object()->cast_spell_file(action))
  	|| file_size(file + ".lpc") <= 0 ) 
    		return 0;
	if( time()<(me->query_temp("no_cast/start")+me->query_temp("no_cast/time")) )
    	{
    		if( stringp(msg=me->query_temp("no_cast/msg")) )
        		return notify_fail(msg+"\n"NOR);
        	else	return notify_fail("你现在不能施展法术。\n");	
	}
	me->set_temp("kill_msg","cast_equip_"+action);
	return (int)call_other( file, "cast", me, this_object(),target_ob);
}

int query_fu_level(string fu)
{
	string type,*fus = ({
		"寒冰",	"飞轮",	"血石",	"清风",	"惊雷",	"万寒",	"月轮",	"凝血",	"冰风",	"寒雷",	
		"万轮",	"血轮",	"风轮",	"雷爆",	"戾血",	"腥风",	"血雷",	"飓风",	"风雷",	"万雷",
	});
	if( !fu || member_array(fu,fus)==-1 )
		return 0;
	if( this_object()->query("combination") )
	{
		if( !stringp(type=this_object()->query("skill_type")) )
			return 0;
		return (int)this_object()->query("combination_dbase/"+type+"/fu/"+fu);		
	}
	else	return (int)this_object()->query("fu/"+fu);
}

int save()
{
	int i;
	object env;
	string type,save_type;
	if( !query("combination") )
		return ::save();
	if( !objectp(env=environment()) )
		return ::save();		
	if( !stringp(type = query("skill_type")) )
		return ::save();
	if( !stringp(save_type = combination_type(env)) )
		return ::save();
	if( !update_combination(save_type) )
		return ::save();
	i = ::save();
	update_combination(type);
	return i;
}