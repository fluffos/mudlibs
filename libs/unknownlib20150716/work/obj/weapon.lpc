string name()
{
	string cls,name = ::name();
        if( query("weapon_title") )
                name = query("weapon_title")+"之"+name;
	if( query("weapon_color") )
	{
                name = query("weapon_color")+name;       
		name = COLOR_D->replace_color(name,1);
                if( query("weapon_color")=="HIM" )
		{
			if( query("level")<30 )
				name = HIM"(鬼)"+name;
			else if( !stringp(cls=query("class")) )
				name = HIM"(灵)"+name;
			else
			{
				switch(cls)
				{
					case "shen" : 
					case "dragon" :
					case "fighter" :
					case "xian" : name = HIM"(仙)"+name;break;
					case "youling" :
					case "ghost" : name = HIM"(鬼)"+name;break;
					case "seng"  :
					case "bonze" : name = HIM"(佛)"+name;break;
					case "taoist": name = HIM"(道)"+name;break;
					case "scholar" : name = HIM"(儒)"+name;break;
					case "dancer" : name = HIM"(魅)"+name;break;
					case "yaomo" : name = HIM"(妖)"+name;break;
					case "tianmo" : name = HIM"(魔)"+name;break;
					default : name = HIM"(灵)"+name;break;
				}
			}	
		}
	}
	return name;
}

int is_weapon(){return 1;}

int query_max_exp()
{
	int p,lvl;
	if( !query("combination") )
		lvl = query("level")/10+1;
	else	lvl = query("combination_dbase/"+query("skill_type")+"/level")/10+1;
	
	if( lvl>=100 )
		return 100000000;
	if( lvl<50 )		
		p = ((lvl*lvl*lvl+60)/5*((lvl-1)*2+60))/8*10;
	else	p = ((lvl*lvl*lvl+60)/5*((lvl-1)*2+600))/8*18;	
	if( p<12000 )
		p = 12000;
	return p;	
}

int level_up()
{
	mapping my_data,base_data,equip_apply_prop,equip_apply_prop2,a_name;
	string *tmp,*base_prop,str,str2,color,name,*ids,data,*euqips;
	int i,k,j,num,lvl,t,v;
	mixed type;	
	object me,newob,obj = this_object();
	
	if( !objectp(me=environment()) || !me->is_character() 
	 || !query("owner_id") || query("owner_id")!=me->query("id") )
		return 0;
	if( obj->query("equipped") )
		return 0;
	if( !obj->query("combination") )
	{
		if( obj->query("level")>=me->query_level() )
			return 0;
	}
	else 
	{
		if( obj->query("combination_dbase/"+obj->query("skill_type")+"/level")>=me->query_level() )
			return 0;
	}		
		
	if( !pointerp(euqips=me->query("euqips"))
	 || sizeof(euqips)<1 )
	 	return 0;
	data = sprintf("%s_%d_%s",obj->query("skill_type"),obj->query("valid_time"),COLOR_D->clean_color(obj->name()));
	if( !data || !stringp(data) )
		return 0;
	if( member_array(data,euqips)==-1 && !obj->query("combination") )
		return 0;	
	
	switch(obj->query("skill_type"))
	{
		case "unarmed" : newob=new("/d/obj/nweapon/unarmed");break;
		case "sword"   : newob=new("/d/obj/nweapon/sword");break;
		case "stick"   : newob=new("/d/obj/nweapon/stick");break;
		case "staff"   : newob=new("/d/obj/nweapon/staff");break;
		case "spear"   : newob=new("/d/obj/nweapon/spear");break;
		case "mace"    : newob=new("/d/obj/nweapon/mace");break;
		case "hammer"  : newob=new("/d/obj/nweapon/hammer");break;
		case "fork"    : newob=new("/d/obj/nweapon/fork");break;
		case "blade"   : newob=new("/d/obj/nweapon/blade");break;
		case "axe"     : newob=new("/d/obj/nweapon/axe");break;
		case "whip"    : newob=new("/d/obj/nweapon/whip");break;
		default : return 0;
	}
		
	equip_apply_prop  = ("/cmds/std/look.lpc")->query_euqip_look1();
	equip_apply_prop2 = ("/cmds/std/look.lpc")->query_euqip_look2();   
	
	if( !obj->query("combination") )
	{	
		my_data = obj->query("weapon_prop");	
		base_data = ("/d/obj/nweapon/newweapon.lpc")->equip_base(obj);
	}
	else
	{
		my_data = obj->query("combination_dbase/"+query("skill_type")+"/weapon_pro");	
		base_data = obj->query("combination_dbase/"+query("skill_type")+"/base_prop");	
	}	
	
	if( !obj->query("combination") )
		color = obj->query("weapon_color");
	else	color = obj->query("combination_dbase/"+query("skill_type")+"/weapon_color");	
	if( color && stringp(color) )
	{
		switch(color)
		{
			case "HIY" : num = 1;break;
			case "HIB" : num = 1;break;
			case "HIC" : num = 2;break;
			case "HIR" : num = 3;break;
			case "HIM" : num = 5;break;
			default : num = 0;break;
		} 		
	}
	else	num = 0;
	base_prop = keys(base_data);
		
	tmp = keys(my_data);
	if( tmp && arrayp(tmp) )
	{
		j = sizeof(tmp);
		for(i=0;i<j;i++)
		{
			type = tmp[i];
			if( !stringp(type) || random(3) )
				continue;
			if( member_array(type,base_prop)!=-1 && random(10)<8 )
				continue; 				
			if( my_data[type]<=0 )
				continue;
			if( type=="combat_damage" || type=="spells_damage" )
			 	continue;
			k = random(obj->query("level")/10)+random(num*2)+1;
			if( member_array(type,keys(equip_apply_prop2))!=-1 )
			{
				k = k/5+1;
				if( k>5 )
					k = 5;
			}
			if( k>0 )
			{
				my_data[type]+= k;
				
				if( !undefinedp(equip_apply_prop[type]) )
					str = equip_apply_prop[type];
				else if( !undefinedp(equip_apply_prop2[type]) )	
					str = equip_apply_prop2[type];
				else
				{
					str = type;
					if( is_chinese(to_chinese(str)) )
						str = to_chinese(str)+"有效等级";
					else if( sscanf(str,"ad_%s",str2) )
					{
						if( is_chinese(to_chinese(str2)) )
							str = to_chinese(str2)+"技能等级";
					}
				}
				tell_object(me,HIG"【系统】"+obj->name()+HIG"的 "HIY+str+HIG" 增加了"HIR+k+HIG" 点。\n"NOR);	
			}	
		}
	}
	for(i=0;i<sizeof(base_prop);i++)
	{
		if( base_prop[i]=="combat_damage" || base_prop[i]=="spells_damage" )
			k = random(obj->query("level")/5)+random(num*3);
		else	k = random(obj->query("level")/20)+random(num*2);
		if( k<1 ) k = 1;
		if( member_array(base_prop[i],keys(equip_apply_prop2))!=-1 )
		{
			k = k/5+1;
			if( k>5 )
				k = 5;
		}
		
		if( !obj->query("combination") )
			obj->add("weapon_prop/"+base_prop[i],k);
		else	obj->add("combination_dbase/"+obj->query("skill_type")+"/base_prop/"+base_prop[i],k);	
		
		if( !undefinedp(equip_apply_prop[base_prop[i]]) )
			str = equip_apply_prop[base_prop[i]];
		else if( !undefinedp(equip_apply_prop2[base_prop[i]]) )	
			str = equip_apply_prop2[base_prop[i]];
		else
		{
			str = base_prop[i];
			if( is_chinese(to_chinese(str)) )
				str = to_chinese(str)+"有效等级";
			else if( sscanf(str,"ad_%s",str2) )
			{
				if( is_chinese(to_chinese(str2)) )
					str = to_chinese(str2)+"技能等级";
			}
		}	
		tell_object(me,HIG"【系统】"+obj->name()+HIG"的 "HIY+str+HIG" 增加了 "HIR+k+" 点"HIG"。\n"NOR);
	}
	tell_object(me,HIG"【系统】"+obj->name()+HIG"升级成功！\n"NOR);
	obj->set("exp",0);
	if( obj->query("combination") )
		obj->set("combination_dbase/"+obj->query("skill_type")+"/exp",0);
	if( !obj->query("combination") )	
		obj->add("level",1);
	else	obj->add("combination_dbase/"+obj->query("skill_type")+"/level",1);
	if( obj->query("combination") )	
	{
		if( newob )
		{  
			newob->move("/obj/empty");
			REMOVE_D->add_obj(newob,1);
		}
		if( obj->save() )
			tell_object(me,HIR"【系统】"+obj->name()+HIR"数据保存成功。"NOR"\n");
		if( update_combination(obj->query("skill_type")) )
			tell_object(me,HIR"【系统】"+obj->name()+HIR"数据更新成功。"NOR"\n");
		return 1;
	}	
	lvl = obj->query("level");
	a_name = newob->w_names();
	if( newob )
	{  
		newob->move("/obj/empty");
		REMOVE_D->add_obj(newob,1);
	}
	if( undefinedp(a_name[lvl]) 
	 || query("no_name") )
	{
		if( obj->save() )
			tell_object(me,HIR"【系统】"+obj->name()+HIR"保存成功。"NOR"\n");
		return 1;	
	}
	name = a_name[lvl][0];
	if( name==obj->query("name") )
	{
		if( obj->save() )
			tell_object(me,HIR"【系统】"+obj->name()+HIR"保存成功。"NOR"\n");
		return 1;	
	}
	euqips-= ({data});
	euqips-= ({0});
	if( sizeof(euqips)<1 )
		euqips = ({});
	v = obj->query("valid_time");
	obj->delete("valid_time");
	tell_object(me,HIY"【系统】你的"+obj->query("name")+HIY"进阶为"+HIR+name+HIY"。\n"NOR);
	ids = a_name[lvl][1];
	obj->set_name(name,ids);
	obj->set("names",name);
	obj->set("ids",ids);	
	obj->delete("no_save");

	t = time();
	obj->set("valid_time",t);
	if( obj->save() )
	{
		set("no_give",1);
        	name = obj->name();
        	if( !name || !stringp(name) )
        		name = "无名";
        	name = COLOR_D->clean_color(name);
        	type = obj->query("skill_type");
        	euqips+= ({type+"_"+t+"_"+name});
		me->set("euqips",euqips);
		me->save(1);
		tell_object(me,HIG"【系统】"+obj->name()+HIG"保存成功。"NOR"\n");
		return 1;
	}
	else	
	{
		tell_object(me,HIR"【系统】"+obj->name()+HIR"保存失败。"NOR"\n");
		obj->move("/obj/empty");
		REMOVE_D->add_obj(obj,1);
		return 0;
	}
}	

mixed add(string prop, mixed data)
{
	int max,lvl,old,n;
	object who;
	
	if( !objectp(who=environment()) || !who->is_character() 
	 || !query("owner_id") || query("owner_id")!=who->query("id") )
		return 0;
	
	if( data && prop=="exp" )
	{
		if( !query("combination") )
			old = (int)query(prop,1);
		else	old = (int)query("combination_dbase/"+query("skill_type")+"/exp");	
		max = this_object()->query_max_exp();
		n = old+(int)data;
		if( (n<0 || old>=2100000000) && (int)data>0 )
			return 0;
		if( (int)data>0 )
		{
			if( old>=max )
				return 0;
			if( n>=max )
			{
				if( !query("combination") )
					this_object()->set("exp",max);
				else	this_object()->set("combination_dbase/"+query("skill_type")+"/exp",max);	
				if( time()>who->query("channel/last_equip_up")+3600 )
				{
					who->set("channel/last_equip_up",time());
					tell_object(who,HIY"【系统】你的"+this_object()->name()+HIY"成长已到瓶颈，需要通过炼器师来提升等级。\n"NOR);
				}				
			}
		}				
	}
	if( query("combination") && prop=="exp" )
		prop = sprintf("combination_dbase/%s/%s",query("skill_type"),prop);
	return ::add(prop, data);
}
