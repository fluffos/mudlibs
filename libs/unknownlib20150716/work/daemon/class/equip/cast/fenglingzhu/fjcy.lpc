// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){return "风卷残云";}

int cast(object me, object my_zhu,object target)
{
	object zhu;
	int success_adj,succ;
	string msg,succ_msg;
	
	success_adj = 50;
	if( !my_zhu || !present(my_zhu,me) )
		return 0;
	if( me->query_level()<10 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够！\n");
	if( time()<me->query_temp("lingzhu_fjcy")+5 )
		return notify_fail("你不能频繁使用「"+name()+"」。\n");
				
	if( !target ) target = offensive_target(me);

	if( !target
	|| !target->is_character()
	|| target->is_corpse()
	|| target==me
	|| !me->is_fighting(target) )
		return notify_fail("你要对谁施展「"+name()+"」？\n");
	
	if( objectp(zhu=present("feng lingzhu",target))
	 && zhu->query("equipped") )
		return notify_fail("对方身携"HIG"风灵珠"NOR"，你无法施展「"+name()+"」。\n");
	
	me->add("mana", -200);
	msg = HIY"风灵珠发出呜呜的声音，$n"HIY"耳中突然响起"+(me->query("gender")=="女性"?"银铃般的笑声":"一声朗笑")+"，只见$N"HIY"双手轻摇，长衫飘飘，说不出的潇洒快活。却有一股疾风朝$n"HIY"刮去。\n"NOR;
	succ_msg = HIC"结果$n"HIC"躲避不及，被风迷了双眼，动弹不得！\n" NOR;
	message_vision(msg,me,target);
	me->set_temp("lingzhu_fjcy",time());
	me->add_temp("apply/spells_succ",success_adj);

	succ = COMBAT_D->attack_percent(me,target,TYPE_CAST);
	
	me->add_temp("apply/spells_succ",-success_adj);
	
	if( succ>0 && !target->is_busy() )
	{
		message_vision(succ_msg,me,target);
		target->start_busy(4);
	}	
	else if( target->is_busy() )
		message_vision(HIC "谁知$N"HIC"毫无反应。\n" NOR,target);
	else	message_vision(HIC"但是被$N"HIC"躲开了。\n"NOR,target);
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：风卷残云
        法术所属：风灵珠
        法术效果：使对方busy 4 秒
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗200点
                  
STR;
        me->start_more(str);
        return 1;
}