// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){return "双龙出水";}

int cast(object me,object my_zhu, object target)
{
	object zhu;
	int success_adj, damage_adj,damage;
	string msg,succ_msg;
	
	success_adj = 50;
	damage_adj = 100;
	if( !my_zhu || !present(my_zhu,me) )
		return 0;

	if( me->query_level()<10 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够！\n");
	if( time()<me->query_temp("shuilingzhu_slcs")+5 )
		return notify_fail("你不能频繁使用「"+name()+"」。\n");
				
	if( !target ) target = offensive_target(me);

	if( !target
	|| !target->is_character()
	|| target->is_corpse()
	|| target==me
	|| !me->is_fighting(target) )
		return notify_fail("你要对谁施展「"+name()+"」？\n");

	if( objectp(zhu=present("shui lingzhu",target))
	 && zhu->query("equipped") )
		return notify_fail("对方身携"HIW"水灵珠"NOR"，你无法施展「"+name()+"」。\n");
		
	me->add("mana", -250);

	msg = HIC"水灵珠陡现白光，半空中呼地现出两条气势威猛的银角背苍龙，纵身一吐，两股奇寒无比的水柱冲着$n"HIC"喷去！\n"NOR;
	succ_msg = HIR "结果$n"HIR"躲避不及，被水柱激个正着。\n"NOR;
	
	me->set_temp("shuilingzhu_slcs",time());
	me->add_temp("apply/spells_succ",success_adj);
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage_adj,"kee");
	me->add_temp("apply/spells_succ",-success_adj);
	me->delete_temp("pfm_msg");
	if( damage<1 )
		message_vision(HIC"$N"HIC"连忙一侧身闪在一旁。\n" NOR,target);
	else if( !target->is_busy() )
		target->start_busy(2);	
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：双龙出水
        法术所属：水灵珠
        法术效果：法术攻击，固定伤害100点
        	  可能造成对方2秒busy	
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗250点
                  
STR;
        me->start_more(str);
        return 1;
}