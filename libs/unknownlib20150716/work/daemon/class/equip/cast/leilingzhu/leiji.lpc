// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "雷击术"; }

int cast(object me, object my_zhu, object target) {
  object zhu;
  int success_adj, damage_adj, damage;
  string msg, succ_msg;

  success_adj = 30;
  damage_adj = 500;

  if (!my_zhu || !present(my_zhu, me))
    return 0;

  if (me->query_level() < 10)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够！\n");
  if (time() < me->query_temp("leilingzhu_leiji") + 5)
    return notify_fail("你不能频繁使用「" + name() + "」。\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展「" + name() + "」？\n");

  if (objectp(zhu = present("lei lingzhu", target))
    && zhu->query("equipped"))
    return notify_fail("对方身携" HIB "雷灵珠" NOR "，你无法施展「" + name() + "」。\n");

  me->add("mana", -250);

  msg = HIR "雷灵珠突发异彩，半空走出位尖头鹰鼻的雷公，左手执斧，右手提锥。斧锥相击，在$n" HIR "的头顶炸起一片响雷！\n" NOR;
  succ_msg = HIC "结果$n" HIC "被雷声震的眼冒金星，心神不定，差点跌倒在地。\n" NOR;

  me->set_temp("leilingzhu_leiji", time());
  me->add_temp("apply/spells_succ", success_adj);
  me->set_temp("pfm_msg", 1);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage_adj,
    "kee"
  );
  me->add_temp("apply/spells_succ", -success_adj);
  me->delete_temp("pfm_msg");
  if (damage < 1)
    message_vision(HIC "$N" HIC "连忙一侧身闪在一旁。\n" NOR, target);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        法术名称：雷击术
        法术所属：雷灵珠
        法术效果：法术攻击，固定伤害500点
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗250点
                  
STR;
  me->start_more(str);
  return 1;
}
