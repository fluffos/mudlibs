// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){return "五行咒";}

int cast(object me, object my_zhu,object target)
{
	object zhu;
	int success_adj, damage_adj,damage,no_busy,no_hunluan;
	string msg,succ_msg;
	
	no_busy = no_hunluan = 0;
	success_adj = 100;
	damage_adj = 1500;
	if( !my_zhu || !present(my_zhu,me) )
		return 0;

	if( me->query_level()<10 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够！\n");
	if( time()<me->query_temp("tulingzhu_luoshi")+5 )
		return notify_fail("你不能频繁使用「"+name()+"」。\n");
				
	if( !target ) target = offensive_target(me);

	if( !target
	|| !target->is_character()
	|| target->is_corpse()
	|| target==me
	|| !me->is_fighting(target) )
		return notify_fail("你要对谁施展「"+name()+"」？\n");

	succ_msg = HIC "结果$n"HIC"躲避不及，";

	if( objectp(zhu=present("tu lingzhu",target))
	 && zhu->query("equipped") )
	{
		no_hunluan = 1;
		damage_adj-= 300;
		succ_msg+= "$n"HIC"身上"HIY"土灵珠"HIC"闪了几闪，";
	}
	else	succ_msg+= "被山石砸得皮破血流，";

	if( objectp(zhu=present("feng lingzhu",target))
	 && zhu->query("equipped") )
	{
		damage_adj-= 300;
		succ_msg+= "$n"HIC"身上"HIG"风灵珠"HIC"闪了几闪，";
	}
	else
	{
		if( succ_msg == HIC "结果$n"HIC"躲避不及，" )
			succ_msg+= "被风迷了双眼，";
		else	succ_msg+= "又被风迷了双眼，";
	}
	
	if( objectp(zhu=present("shui lingzhu",target))
	 && zhu->query("equipped") )
	{
		no_busy = 1;
		damage_adj-= 300;
		succ_msg+= "$n"HIC"身上"HIW"水灵珠"HIC"闪了几闪，";
	}
	else
	{
		if( succ_msg == HIC "结果$n"HIC"躲避不及，" )
			succ_msg+= "被水浇个透心凉，";
		else	succ_msg+= "加上被水浇个透心凉，";	
	}
	
	if( objectp(zhu=present("huo lingzhu",target))
	 && zhu->query("equipped") )
	{
		damage_adj-= 300;
		succ_msg+= "$n"HIC"身上"HIR"火灵珠"HIC"闪了几闪，";
	}
	else
	{
		if( succ_msg == HIC "结果$n"HIC"躲避不及，" )
			succ_msg+= "被地火烧得皮焦骨烂，";
		else	succ_msg+= "还被地火烧得皮焦骨烂，";	
	}
	
	if( objectp(zhu=present("lei lingzhu",target))
	 && zhu->query("equipped") )
	{
		damage_adj-= 300;
		succ_msg+= "$n"HIC"身上"HIB"雷灵珠"HIC"闪了几闪，";
	}
	else
	{
		if( succ_msg == HIC "结果$n"HIC"躲避不及，" )
			succ_msg+= "被雷电劈个正着，肌肤尽裂。\n";
		else	succ_msg+= "最后被雷电劈个正着，肌肤尽裂。\n";	
	}
	succ_msg+= NOR;

	me->add("mana", -250);

	msg = HIR"圣灵珠五彩毫光猛然四射，刹时风雨雷电齐至，山崩地裂！\n"NOR;
	
	me->set_temp("tulingzhu_luoshi",time());
	me->add_temp("apply/spells_succ",success_adj);
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage_adj,"kee");
	me->add_temp("apply/spells_succ",-success_adj);
	me->delete_temp("pfm_msg");
	if( damage<1 )
		message_vision(HIC"$N"HIC"连忙一侧身闪在一旁。\n" NOR,target);
	else
	{
		if( no_busy==0 && !target->is_busy() )
			target->start_busy(3);
		if( no_hunluan==0 )	
			target->start_hunluan(3,"你被落石砸得昏头转向。\n");
	}
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：五行咒
        法术所属：圣灵珠
        法术效果：以五行法术攻击，每五行固定伤害增加300点
        	  可能造成对方3秒混乱
        	  可能造成对方3秒busy
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗250点
                  
STR;
        me->start_more(str);
        return 1;
}