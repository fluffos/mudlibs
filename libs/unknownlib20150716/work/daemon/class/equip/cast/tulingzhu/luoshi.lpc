// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){return "落石术";}

int cast(object me, object my_zhu,object target)
{
	object zhu;
	int success_adj, damage_adj,damage;
	string msg,succ_msg;
	
	success_adj = 30;
	damage_adj = 200;
	if( !my_zhu || !present(my_zhu,me) )
		return 0;

	if( me->query_level()<10 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够！\n");
	if( time()<me->query_temp("tulingzhu_luoshi")+5 )
		return notify_fail("你不能频繁使用「"+name()+"」。\n");
				
	if( !target ) target = offensive_target(me);

	if( !target
	|| !target->is_character()
	|| target->is_corpse()
	|| target==me
	|| !me->is_fighting(target) )
		return notify_fail("你要对谁施展「"+name()+"」？\n");

	if( objectp(zhu=present("tu lingzhu",target))
	 && zhu->query("equipped") )
		return notify_fail("对方身携"HIY"土灵珠"NOR"，你无法施展「"+name()+"」。\n");
		
	me->add("mana", -250);

	msg = YEL"土灵珠冉冉升起，$n"YEL"的头上出现一座巨大的石山，只见土灵珠一沉，石山急速下落！\n"NOR;
	succ_msg = HIR "结果$n"HIR"躲避不及，被石山砸个正着！头破血流。\n"NOR;
	
	me->set_temp("tulingzhu_luoshi",time());
	me->add_temp("apply/spells_succ",success_adj);
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage_adj,"kee");
	me->add_temp("apply/spells_succ",-success_adj);
	me->delete_temp("pfm_msg");
	if( damage<1 )
		message_vision(HIC"$N"HIC"连忙一侧身闪在一旁。\n" NOR,target);
	else	target->start_hunluan(3,"你被落石砸得昏头转向。\n");
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：落石术
        法术所属：土灵珠
        法术效果：法术攻击，固定伤害200点
        	  可能造成对方3秒混乱
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗250点
                  
STR;
        me->start_more(str);
        return 1;
}