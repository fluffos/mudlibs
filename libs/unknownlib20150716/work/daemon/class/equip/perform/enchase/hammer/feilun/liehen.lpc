#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "大地裂痕"; }

mapping *action = ({
  ([
    "action": "\n",
    "dodge": -30,
    "parry": -30,
    "force": 100,
    "damage": 100,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "砸伤",
  ]),
  ([
    "action": "\n",
    "dodge": -50,
    "parry": -50,
    "force": 120,
    "damage": 120,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "砸伤",
  ]),
});

int perform(object me, object equip, object target) {
  object weapon;
  int damage, i, lvl;
  string msg, succ_msg;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("飞轮"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招「大地裂痕」？\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if (me->query_skill("hammer", 1) < 200)
    return notify_fail("你的基本锤法太差。\n");
  if (me->query_skill("force", 1) < 200)
    return notify_fail("你的内功底子太差。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "hammer")
    return notify_fail("「大地裂痕」是锤子的绝招。\n");

  damage = 500;

  me->add("force", -300);
  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 10);

  msg = "\n" HIY "$N" HIY "突然招式一变，手中$w" HIY "绽放万道金光，喷薄出凌厉的劲气，惊涛骇浪般扑向$n" HIY "！\n" NOR;
  succ_msg = WHT "$n" WHT "只觉得劲气袭体，登时四肢麻木动弹不得。\n" NOR;
  succ_msg += ({
    RED "结果$n" RED "胸口一痛，闷哼一声。\n" NOR,
    HIR "结果$n" HIR "被$N" HIR "连连击中，『嘿』的一声退了数步。\n" NOR,
    WHT "结果$n" WHT "犹如受到数记重锤，连退了五六步！\n" NOR,
  })[random(3)];

  if (lvl < 2)
    me->set("actions", action[0]);
  else me->set("actions", action[1]);

  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    succ_msg,
    0,
    damage
  );
  if (damage < 1)
    message_combatd(HIC "谁知$n" HIC "运起内力生生接下$N" HIC "凌厉的劲气，毫发无伤。\n" NOR, me, target);

  me->add_temp("apply/attack", -10);
  me->delete_temp("pfm_msg");
  me->reset_action();
  me->start_busy(1);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：大地裂痕
        外功所属：飞轮符(镶嵌)
        外功效果：物理攻击对方
        	  自身busy1秒
        法术条件：
        	  人物等级20级
                  内力500点，消耗300点
                  基本锤法200级
                  基本内功200级

STR;
  me->start_more(str);
  return 1;
}
