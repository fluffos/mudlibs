//血海红花
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "血海红花"; }

mapping *action = ({
  ([
    "action": "\n",
    "dodge": -60,
    "parry": -60,
    "damage": 125,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "\n",
    "dodge": -80,
    "parry": -80,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
});

int perform(object me, object equip, object target) {
  object weapon;
  int damage, lvl, t;
  string succ_msg, msg;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("血石"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)
    || target->is_ghost())
    return notify_fail("「血海红花」只能对战斗中的对手使用。\n");
  if (me->query_skill("sword", 1) < 200)
    return notify_fail("你的剑法不够娴熟。\n");
  if (lvl < 2)
    t = 7;
  else t = 4;
  if (time() < me->query_temp("equip_honghua") + t)
    return notify_fail("你刚用完这招，再用会有危险!\n");
  if (me->query_skill("force", 1) < 200)
    return notify_fail("你的内功修为不够高。\n");
  if (me->query("force") < 600)
    return notify_fail("你现在内力太弱，不能使用「血海红花」。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "sword")
    return notify_fail("你的剑呢？\n");

  msg = HIM "$N" HIM "一声清啸，气运丹田，围绕$n" HIC "疾转，手中" + weapon->name() + HIM "闪出无数血红的剑光！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("equip_honghua", time());
  me->add("force", -250);

  msg = HIM "$n" HIM "顿觉四周眼花缭乱，仿佛置身于重重" HIR "血海" HIM "之中，却见$N" HIM "突然身形一顿，人剑合一，带着一丝淡淡的血光，穿向$n！\n" NOR;
  succ_msg = HIM "$n" HIM "只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出，$l处顿时盛开出一朵斗大的凄厉" HIR "红花" HIM "！\n" NOR;
  damage = 800;

  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 30);
  if (lvl < 2)
    me->set("actions", action[0]);
  else me->set("actions", action[1]);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    succ_msg,
    0,
    damage
  );
  me->add_temp("apply/attack", -30);
  me->set_temp("pfm_msg", 0);
  if (damage < 1) {
    message_combatd(HIM "可是$n" HIM "猛地向边上一跃,跳出了$N" HIM "的攻击范围。\n" NOR, me, target);
    if (me->query("force") > 50)
      me->add("force", -50);
  }
  me->reset_action();
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：血海红花
        外功所属：血石符(镶嵌)
        外功效果：物理攻击对方1次，固定伤害800
        	  冷却4或7秒
        法术条件：
        	  人物等级20级
                  内力600点，消耗250-300点
                  基本剑法200级
                  基本内功200级

STR;
  me->start_more(str);
  return 1;
}
