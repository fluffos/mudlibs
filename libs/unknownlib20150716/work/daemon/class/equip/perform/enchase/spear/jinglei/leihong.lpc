//雷炎飞虹
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){ return "雷炎飞虹";}

mapping *action = ({
        ([      "action" : HIM"$N"HIM"手中$w"HIM"脱手飞出，整个人随枪而起，顺势攥住枪尾，抖出无数枪影，$w"HIM"如彩虹般直上云霄，『"HIW"雷炎飞虹"HIM"』纵然直下！\n"NOR,
                "damage" : 150,	              		                
                "dodge"  : -30,
                "parry"  : -40,
                "damage_type":  "刺伤"
        ]),
        ([      "action": HIM"$N"HIM"身形转动，原来还有后招，转眼间又刺出一枪！这一招『"HIW"雷炎再现"HIM"』比刚才那招更快，冷冷的枪锋直刺$n"HIM"$l！\n"NOR,
                "damage" : 165,
                "dodge"  : -50,
                "parry"  : -70,
                "damage_type":  "刺伤"
        ]),
	([      "action": HIM"$N"HIM"突然收住身形，回步而立，$w"HIM"背于背后，无招胜有招，无形胜有形。这一招正是「"HIR"雷炎飞虹"HIM"」的精华，无数光华盖向$n"HIM"！"NOR"\n",
                "damage" : 200,	              				
                "dodge"  : -70,
                "parry"  : -80,
                "damage_type":  "内伤"
        ]),
 });
  
int perform(object me, object equip,object target)
{
        object weapon;
	int lvl,p;
	string msg;

	if( !equip || !present(equip,me) )
		return 0;
	if( !intp(lvl = equip->query_fu_level("惊雷"))
	 || lvl<1 )
	 	return 0;
	
	if( me->query_level()<20 )
		return notify_fail("你的人物等级不够。\n");
        if( me->query_skill("dodge")<200 ) 
        	return notify_fail("你轻功修为还不够高深，无法施展「"HIM"雷炎飞虹"NOR"」。\n");
        if( me->query_skill("force")<200 ) 
        	return notify_fail("你的内功心法修为还不够高深，无法施展「"HIM"雷炎飞虹"NOR"」。\n");
        if( me->query_skill("spear")<200 ) 
		return notify_fail("你的基本枪法修为还不够高深，无法施展「"HIM"雷炎飞虹"NOR"」。\n");
        if( (int)me->query("force")<300 )      
                return notify_fail("你的内力不够。\n");
        if( !objectp(weapon=me->query_temp("weapon"))
         || weapon->query("skill_type")!="spear" )
        	return notify_fail("你的枪呢？\n");
        if( !target ) target = offensive_target(me);
	if( !target 
	 || !target->is_character()
	 || !me->is_fighting(target) 
	 || target->is_ghost() )
                return notify_fail("「"HIM"雷炎飞虹"NOR"」只能在战斗中使用！\n");
                
        if( lvl<2 )
        	p = 50;
        else	p = 80;
        	
        me->add("force", -100);
        me->add_temp("apply/combat_succ",p);
        me->set_temp("pfm_color",HIM);
        
        me->set("actions",action[0]);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);

        me->set("actions",action[1]);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);

        me->set("actions",action[2]);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
	 	
	me->add_temp("apply/combat_succ",-p);
	me->delete_temp("pfm_color");
	me->reset_action();
	me->start_busy(2);
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：雷炎飞虹
        外功所属：惊雷符(镶嵌)
        外功效果：连续攻击对方三次
        	  自身busy2秒
        法术条件：
        	  人物等级20级
                  内力300点，消耗100点
                  有效轻功200级
                  有效内力200级
                  有效枪法200级

STR;
        me->start_more(str);
        return 1;
} 