//清风拂柳
#include <ansi.h>
inherit SSERVER;

string name() { return "清风拂柳"; }

int perform(object me, object equip, object target) {
  object weapon;
  int lvl, p;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("清风"))
    || lvl < 1)
    return 0;

  if (me->query_level() < 10)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill("dodge") < 100)
    return notify_fail("你轻功修为还不够高深，无法施展「" HIC "清风拂柳" NOR "」。\n");
  if (me->query_skill("force") < 100)
    return notify_fail("你的内功心法修为还不够高深，无法施展「" HIC "清风拂柳" NOR "」。\n");
  if (me->query_skill("whip") < 100)
    return notify_fail("你的基本鞭术修为还不够高深，无法施展「" HIC "清风拂柳" NOR "」。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("equip_whip_fuliu"))
    return notify_fail("你已经在运功中了。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "whip")
    return notify_fail("没有鞭子如何拂柳？\n");

  if (lvl < 2)
    p = 10;
  else p = 20;

  me->add("force", -50);
  message_vision(HIW "$N" HIW "一甩" + weapon->name(1) + HIW "，顿时整个人步法轻灵，如行云流水，风中拂柳。\n" NOR, me);
  me->set_temp("equip_whip_fuliu", 1);

  me->add_temp("apply/combat_succ", p);
  me->add_temp("apply/dodge", -p);

  if (me->is_fighting())
    me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：清风拂柳
        外功所属：清风符(镶嵌)
        外功效果：降低自身闪避10%或20%转移为物理命中
                  可与其他增益类状态叠加
        	  战斗中使用自身busy2秒
        法术条件：
        	  人物等级10级
                  内力100点，消耗50点
                  有效轻功100级
                  有效内力100级
                  有效鞭法100级

STR;
  me->start_more(str);
  return 1;
}
