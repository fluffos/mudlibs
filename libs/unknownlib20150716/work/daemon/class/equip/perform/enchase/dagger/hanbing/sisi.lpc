#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name(){ return "丝丝入扣";}

mapping *action = ({
        ([      "action" : "\n",
     		"damage" : 20,
     		"force"  : 50,
     		"parry"  : -50,
     		"dodge"  : -50,
     		"damage_type":     "割伤"
        ]),
        ([      "action" : "\n",
     		"damage" : 30,
     		"force"  : 100,     		
     		"parry"  : -80,
     		"dodge"  : -80,
     		"damage_type":     "割伤"
        ]),
        ([      "action" : "\n",
     		"damage" : 40,
     		"force"  : 150,     		
     		"parry"  : -100,
     		"dodge"  : -100,
     		"damage_type":     "割伤"
        ]),
});

int perform(object me,object equip,object target)
{
	object weapon;
	int damage,i,lvl;
	string msg,succ_msg;
	
	if( !equip || !present(equip,me) )
		return 0;
	if( !intp(lvl = equip->query_fu_level("寒冰"))
	 || lvl<1 )
	 	return 0;
      	if( me->query_level()<20 )
      		return notify_fail("你的人物等级不够。\n");
	if( !target ) target = offensive_target(me);
	if( !target
  	 || !target->is_character()
  	 || target->is_corpse()
  	 || target==me 
  	 || !me->is_fighting(target) )
		return notify_fail("你要对谁施展这一招「丝丝入扣」？\n");
	if( me->query("force")<400 )
        	return notify_fail("你的内力不足！\n");
        if( me->query_skill("dagger",1)<200 )
        	return notify_fail("你的短兵技能太差。\n");
        if( !objectp(weapon=me->query_temp("weapon"))
         || weapon->query("skill_type")!="dagger" )
         	return notify_fail("「丝丝入扣」是短兵的绝招。\n");
	if( time()<me->query_temp("equip_dagger_sisi",time())+4 )
		return notify_fail("绝招用多就不灵了。\n");
	damage = 300;

	msg = "\n"NOR+BLK+HIW"$N"NOR+BLK+HIW"突然收起手中"+ weapon->name()+ NOR+BLK+HIW"，悄无声息地走到$n"NOR+BLK+HIW"身边！"NOR"\n";
        message_vision(msg,me,target);
        me->set_temp("equip_dagger_sisi",time());
	me->add("force",-150);
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",10);
	
	succ_msg = ({
		YEL "结果$n"YEL"躲闪不及，被$w"YEL"刺个正着，鲜血从$l汩汩而出！\n"NOR,
		MAG "眨眼间，$N"MAG"手中的$w"MAG "无声无息地刺中了$n"MAG"的$l！\n" NOR,
		HIM "结果$n"HIM"突然$l一阵剧痛，原来被$N手上的$w"HIM "狠狠刺伤！\n" NOR,
	})[random(3)];		

	me->set("actions",action[0]);
	msg = HIG "\n「丝丝入扣」-- 一丝两气！\n" NOR;
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,damage);
	
	if( lvl>1 )
	{
		me->set("actions",action[1]);
		msg = HIR "\n「丝丝入扣」-- 命若悬丝！\n" NOR;
        	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,damage);
        }
        
        if( lvl>2 )
        {	
        	msg = HIY "\n「丝丝入扣」-- 病去如抽丝！\n" NOR;	
        	me->set("actions",action[2]);
        	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,damage);
        }
	
	me->add_temp("apply/attack",-10);
	me->delete_temp("pfm_msg");
	me->reset_action();				
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：丝丝入扣
        外功所属：寒冰符(镶嵌)
        外功效果：物理攻击对方1-3次
        	  冷却4秒
        法术条件：
        	  人物等级20级
                  内力400点，消耗150点
                  短兵刃200级

STR;
        me->start_more(str);
        return 1;
}