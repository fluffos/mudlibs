//雷炎飞虹
#include <ansi.h>
inherit SSERVER;

string name(){ return "天河惊雷";}

int perform(object me, object equip,object target)
{
	return notify_fail("暂未开放。\n");
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：天河惊雷
        外功所属：惊雷符(镶嵌)
        外功效果：暂未开放

STR;
        me->start_more(str);
        return 1;
} 