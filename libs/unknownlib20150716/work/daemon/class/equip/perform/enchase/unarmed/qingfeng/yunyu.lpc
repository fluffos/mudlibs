#include <combat.h>
#include <ansi.h>
inherit SSERVER;

string name(){ return "翻云覆雨";}

mapping *action = ({
        ([      "action": "\n",
                "dodge": -35,
                "parry": -40,
                "force": 150,
                "damage_type": "撞伤",
        ]),
	([  
		"action": "\n",
                "dodge": -40,
                "parry": -55,
                "force": 155,
                "damage_type": "内伤",
        ]),
	([  	"action": "\n",
                "dodge": -50,
                "parry": -60,
                "force": 160,
                "damage_type": "瘀伤",
        ]),
});

int perform(object me,object equip,object target)
{       
	object weapon;
	string msg,succ_msg;
	int damage,lvl,p,time;
	
	if( !equip || !present(equip,me) )
		return 0;
	if( !intp(lvl = equip->query_fu_level("清风"))
	 || lvl<1 )
	 	return 0;
	if( me->query_level()<15 )
		return notify_fail("你的人物等级不够。\n");
	
	if( !target ) target = offensive_target(me);
	if( !target 
	 || !target->is_character()
	 || !me->is_fighting(target) 
	 || target->is_ghost() )
        	return notify_fail("「翻云覆雨」只能在战斗中使用。\n");
	
	if( me->query_skill("unarmed", 1)<150 )
        	return notify_fail("你有的功夫还不够娴熟，不会使用「翻云覆雨」。\n");
	if( me->query_skill("force",1)<150 )
        	return notify_fail("以你现在的内功修为还使不出「翻云覆雨」。\n");        
	if( me->query("force") < 400 )
        	return notify_fail("你的真气不够！\n");
	
	if( objectp(weapon=me->query_temp("weapon"))
         && weapon->query("skill_type")!="unarmed" )
         	return notify_fail("这是拳脚上的功夫。\n");
	
	msg = HIC "$N"HIC"脸色一变，左脚点地，身体向后旋转，右腿随即「翻云覆雨」般扫向$n"HIC"！\n" NOR;
	message_vision(msg,me,target);
	msg = WHT "这一腿力度奇大!速度奇快！$n"WHT"一愣之间，风声已经踢到了面前。\n"NOR;
	succ_msg = HIC"$n"HIC"招架不住这凌厉的一腿，被踢了个正着！\n" NOR;
	
	me->add("force",-200);
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",10);
	me->set("actions",action[0]);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,300);
	me->add_temp("apply/attack",-10);
	if( damage>0 )
	{
		msg = HIY"\n$N"HIY"突然侧身，一个前空翻，右脚自上而下，足带风尘，照$n"HIY"直劈下来！\n"NOR;
		succ_msg = MAG "$n"MAG"眼睁睁的看着$N"MAG"迎面一腿踢下，却无招架之力！\n" NOR;
		me->add_temp("apply/attack",15);
		if( lvl<2 )
			me->set("actions",action[0]);
		else	me->set("actions",action[1]);	
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,500);
		me->add_temp("apply/attack",-15);
		if( damage<1 )
		{
			message_combatd(WHT"$n"WHT"一个反身,闪过$N"WHT"凌厉的进攻。\n"NOR,me,target);
			me->start_busy(2);
		}
	}
	else
	{
		msg = HIB"\n没等$n"HIB"反过神来，$N"HIB"忽然身形急转，收右腿，抬左腿，一前一后，一连二腿袭向$n"HIB"，一腿快过一腿，连绵不尽！\n"NOR;
		message_combatd(msg,me,target);
		me->add_temp("apply/attack",15);
		msg = HIY"第一腿，直奔$n"HIY"的$l！\n"NOR;
		if( lvl<2 )
			me->set("actions",action[1]);
		else	me->set("actions",action[2]);	
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,300);
		msg = HIY"第二腿，直奔$n"HIY"的$l！\n"NOR;
		if( lvl<2 )
			me->set("actions",action[1]);
		else	me->set("actions",action[2]);	
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,300);
		me->add_temp("apply/attack",-15);
		me->start_busy(3);
	}
	me->delete_temp("pfm_msg");
	me->reset_action();
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：翻云覆雨
        外功所属：清风符(镶嵌)
        外功效果：物理攻击对方2-3次
        	  自身busy2-3秒
        法术条件：
        	  人物等级15级
                  内力400点，消耗200点
                  扑击格斗之技150级
                  基本内功150级

STR;
        me->start_more(str);
        return 1;
}