#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "寒潭飞花"; }

mapping *action = ({
  ([ "action": "\n",
    "damage": 85,
    "parry": -30,
    "dodge": -30,
    "damage_type": "割伤"
  ]),
  ([ "action": "\n",
    "damage": 90,
    "parry": -30,
    "dodge": -30,
    "damage_type": "割伤"
  ]),
  ([ "action": "\n",
    "damage": 90,
    "parry": -50,
    "dodge": -50,
    "damage_type": "割伤"
  ]),
  ([ "action": "\n",
    "damage": 95,
    "parry": -50,
    "dodge": -50,
    "damage_type": "割伤"
  ]),
  ([ "action": "\n",
    "damage": 95,
    "parry": -80,
    "dodge": -80,
    "damage_type": "割伤"
  ]),
  ([ "action": "\n",
    "damage": 100,
    "parry": -80,
    "dodge": -80,
    "damage_type": "割伤"
  ]),
});

int perform(object me, object equip, object target) {
  object weapon;
  int times, damage, i, lvl;
  string msg, succ_msg;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("寒冰"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招「寒潭飞花」？\n");
  if (me->query("force") < 600)
    return notify_fail("你的内力不足！\n");
  if (me->query_skill("blade", 1) < 200)
    return notify_fail("你的刀法太差。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "blade")
    return notify_fail("你的刀呢？\n");

  times = lvl;
  if (times < 3)
    times = 3;
  if (times > 5)
    times = 5;

  damage = 300;

  msg = HIC "$N" HIC "一声长啸，$w" HIR "血光" HIC "一闪，一式" HIR "「寒潭飞花」" HIC "闪电般向$n" HIC "攻出了" HIM + chinese_number(times) + HIC "刀！\n第一刀！直劈$n" HIC "$l！\n" NOR;
  succ_msg = HIR "$n" HIR "一愣，$l已被$N" HIR "的$w" HIR "砍的深可见骨！\n" NOR;

  me->add("force", -times * 45);
  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 10);
  me->set("actions", action[0]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg, succ_msg, 0, damage);
  me->add_temp("apply/attack", -10);

  for (i = 1; i < times; i++) {
    msg = HIC "第" + chinese_number(i + 1) + "刀！直劈$n" HIC "$l！\n" NOR;
    me->add_temp("apply/attack", i * 15);
    me->set("actions", action[i]);
    COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      damage
    );
    me->add_temp("apply/attack", -i * 15);
  }
  me->delete_temp("pfm_msg");
  me->reset_action();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：寒潭飞花
        外功所属：寒冰符(镶嵌)
        外功效果：物理攻击对方3-5次
        	  伤害、固定伤害、命中递增
        	  自身busy2-3秒
        法术条件：
        	  人物等级20级
                  内力600点，消耗135-225点
                  基本刀法200级

STR;
  me->start_more(str);
  return 1;
}
