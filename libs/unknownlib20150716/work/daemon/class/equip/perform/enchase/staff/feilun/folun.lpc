#include <ansi.h>
#include <combat.h>
inherit SSERVER;

mapping *action = ({
   ([   
   	"action"   : "\n",
	"dodge"    : -50,
	"parry"    : -50,
	"damage"   : 50,
     "damage_type" : "砸伤",
   ]),
   ([   
   	"action"   : "\n",
	"dodge"    : -80,
	"parry"    : -80,
	"damage"   : 80,
     "damage_type" : "砸伤",
   ]),
});

string name(){ return "金刚佛轮";}

int perform(object me,object equip,object target)
{
	object weapon;
        int damage,succ,lvl,lv;
	string msg,succ_msg;
	
	if( !equip || !present(equip,me) )
		return 0;
	if( !intp(lvl = equip->query_fu_level("飞轮"))
	 || lvl<1 )
	 	return 0;
      	if( me->query_level()<20 )
      		return notify_fail("你的人物等级不够。\n");
	if( !target ) target = offensive_target(me);
	if( !target
  	 || !target->is_character()
  	 || target->is_corpse()
  	 || target==me 
  	 || !me->is_fighting(target) )
		return notify_fail("你要对谁施展这一招「金刚佛轮」？\n");
	if( me->query("force")<500 )
        	return notify_fail("你的内力不足！\n");
        if( me->query_skill("staff",1)<200 )
        	return notify_fail("你的基本杖法太差。\n");
        if( me->query_skill("force",1)<200 )
        	return notify_fail("你的内功底子太差。\n");
        if( !objectp(weapon=me->query_temp("weapon"))
         || weapon->query("skill_type")!="staff" )
         	return notify_fail("「金刚佛轮」是长杖的绝招。\n");
	if( time()<me->query_temp("eauip_staff_folun")+5 )
		return notify_fail("绝招用多就不灵了。\n");
	if( target->is_busy() )
		return notify_fail("对方已经自顾不暇了，放胆攻击吧。\n");	
	
	damage = 500;

	me->add("force",-200);
        lv = lvl;
        me->add_temp("apply/attack",lv*10);
	if( lvl<2 )
		me->set("actions",action[0]);
	else	me->set("actions",action[1]);
	
	msg = "\n"HIY"$N"HIY"手中"+weapon->name(1)+HIY"忽然绽放万道金光，其上梵音阵阵，异香扑鼻。有过丈八人影重重，怒发金刚吼！\n"NOR;
	succ_msg = HIY"$n"HIY"只觉心神一颤，登时四肢麻木动弹不得。\n"NOR;
	if( lvl<2 )
		me->set("actions",action[0]);
	else	me->set("actions",action[1]);	
	if( lvl>2 )
		lvl = 2;
	lvl = lvl*3;
	succ = COMBAT_D->attack_percent(me,target,TYPE_PERFORM);
	message_vision(msg,me);
	if( succ>0 )
	{
		message_vision(succ_msg,me,target);
		target->start_busy(lvl);
	}
	else
	{
		message_combatd(HIC"谁知$n"HIC"置若罔闻，丝毫不受影响。\n"NOR,me,target);
		me->add("force",-100);
	}
        me->add_temp("apply/attack",-lv*10);
	me->reset_action();
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：金刚佛轮
        外功所属：飞轮符(镶嵌)
        外功效果：使对方busy3或6秒
        	  冷却5秒
        法术条件：
        	  人物等级20级
                  内力500点，消耗200点，不命中增加消耗100点
                  基本杖法200级
                  基本内功200级

STR;
        me->start_more(str);
        return 1;
}
