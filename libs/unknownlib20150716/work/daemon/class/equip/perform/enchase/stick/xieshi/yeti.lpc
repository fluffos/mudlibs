#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "小儿夜啼"; }

mapping *action = ({
  ([
    "action": HIB "第一招----春晓饿啼，$N" HIB "手中$w" HIB "如一阵疾风般攻向$n" HIB "！\n" NOR,
    "dodge": -30,
    "parry": -50,
    "damage": 150,
    "damage_type": "砸伤"
  ]),
  ([
    "action": HIR "第二招----子夜恸哭，$N" HIB "手中$w" HIR "突闪一道寒光，如片片雪花捅向$n" HIR "！\n" NOR,
    "dodge": -50,
    "parry": -70,
    "damage": 180,
    "damage_type": "砸伤"
  ]),
  ([
    "action": HIB "第三招----撕心裂肺，$N" HIB "手中$w" HIB "舞动如风，带着阵阵风声砸向$n" HIB "！\n" NOR,
    "dodge": -70,
    "parry": -100,
    "damage": 200,
    "damage_type": "砸伤"
  ]),
});

int perform(object me, object equip, object target) {
  object weapon;
  int damage, lvl;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("血石"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)
    || target->is_ghost())
    return notify_fail("「" HIR "小儿夜啼" NOR "」只能在战斗中使用！\n");
  if ((int)me->query("force") < 800)
    return notify_fail(HIC "你现在内力不够，没能将「小儿夜啼」使完！\n" NOR);
  if ((int)me->query_skill("stick", 1) < 200)
    return notify_fail("你的基本棍法不够娴熟，还使不出「小儿夜啼」。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "stick")
    return notify_fail("「" HIR "小儿夜啼" NOR "」是棍子的绝招。\n");

  if (lvl > 2)
    lvl = 2;
  me->add("force", -200);
  me->add_temp("apply/attack", lvl * 20);

  me->set("actions", action[0]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  me->set("actions", action[1]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  me->set("actions", action[2]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);

  me->add_temp("apply/attack", -lvl * 20);
  me->reset_action();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：小儿夜啼
        外功所属：血石符(镶嵌)
        外功效果：连续攻击对方三次
        	  自身busy2秒
        法术条件：
        	  人物等级20级
                  内力800点，消耗200点
                  基本棍法200级
                  基本内功200级

STR;
  me->start_more(str);
  return 1;
}
