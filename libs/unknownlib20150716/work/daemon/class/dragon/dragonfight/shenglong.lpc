#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg,*names,name,succ_msg,*smsgs;
        
        if( me->query_level()<20 )
                return notify_fail("你的人物等级不够。\n");
        if((string)me->query("family/family_name") != "东海龙宫" ) 
                return notify_fail("你又不是龙宫弟子。\n");
        if((int)me->query_skill("seashentong", 1) < 200)
                return notify_fail("你的碧海神通修为不深，请不动八仙。\n");
        if( me->query("family/family_name") != "东海龙宫" ) 
                return notify_fail("你又不是东海弟子，不会升龙技。\n");
        if( me->query_skill("dragonfight",1)<200 )
                return notify_fail("你的龙形搏击修为不深，施展不出升龙技。\n");
        if( time()-(int)me->query_temp("shenglong_end")<10 )
                return notify_fail("你刚用过「升龙技」,内息还无法调整！\n");
        if( me->query("force")<300 )
                return notify_fail("你的内力不够。\n");
                                
        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("你对谁施展升龙技？\n");
        if((string)target->query("family/family_name") == "东海龙宫" )
                return notify_fail("此招对同门无效。\n");

        me->add("force", -150);
        me->receive_damage("kee",100,me);

        message_combatd(HIY"$N"HIY"咬破舌尖，吐出一口鲜血，背后现出惊涛骇浪幻象，数条巨龙在其他翻腾出入！\n"NOR,me);
        message_vision(HIB"$N"HIB"默运碧海神通，身法一展，竟然使出「升龙技」舍身扑向$n"HIB"！\n"NOR,me,target);
        me->set_temp("pfm_msg",1);
        
        if( !target->is_killing(me->query("id")) )
        {
                msg = HIR "$n"HIR"对着$N"HIR"高声骂道：好家伙，一拥而上了，我宰了你！\n" NOR;
                message_vision(msg, me, target);
                target->kill_ob(me);
        }       
        names = ({
                "花皮", "金角", "金尾","银角","背苍","虬髯","螭虬",
                "蜧金","神通","锦鲤",
        });
        smsgs = ({
        	"结果$n"HIR"体内一阵剧痛，看起来内伤不轻！\n",
        	"结果「嗡」地一声$n"HIR"只觉得眼前一黑，双耳轰鸣不止！\n",
        	"结果只听「啪」地一声，$n"HIR"的$l被抽得皮开肉绽，痛得$p咬牙切齿！\n",
        	"结果「啪」地一声爆响！这一下好厉害，只抽得$n"HIR"皮开肉绽，血花飞溅！\n",
        	"结果只听见$n"HIR"一声惨嚎，龙尾重重地抽上了$p的$l，顿时血肉横飞，十命断了九条！\n",
       	        "结果这一下「轰」地一声撞得$n"HIR"眼冒金星，差一点摔倒！\n",
	        "结果重重地撞中，$n"HIR"眼前一黑，「哇」地一声吐出一口鲜血！\n",
        	"结果只听见「轰」地一声巨响，$n"HIR"像一捆稻草般飞了出去！\n",
        });
        name = "一爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",5);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg);
        me->add_temp("apply/attack",-5);
        if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<250 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(1);
		return 1;
	}

        name = "二爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",10);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg);
        me->add_temp("apply/attack",-10);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<300 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(1);
		return 1;
	}

        name = "三爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",15);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg);
        me->add_temp("apply/attack",-15);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<350 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(2);
		return 1;
	}

        name = "四爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",20);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,300,"kee");
        me->add_temp("apply/attack",-20);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<400 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(2);
		return 1;
	}
	
	name = "五爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",25);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,500,"kee");
        me->add_temp("apply/attack",-25);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<450 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(2);
		return 1;
	}

	name = "六爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",30);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,600,"kee");
        me->add_temp("apply/attack",-30);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<500 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(2);
		return 1;
	}
	
	name = "七爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",35);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,800);
        me->add_temp("apply/attack",-35);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<550 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(3);
		return 1;
	}
	
	name = "八爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",40);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,1000);
        me->add_temp("apply/attack",-40);
	if( !me || !target || !me->is_fighting(target)
         || me->query_skill("dragonfight",1)<600 )
	{
		me->delete_temp("pfm_msg");
		me->start_busy(3);
		return 1;
	}
	
	name = "九爪"+names[random(sizeof(names))]+"龙"; 
        msg = HIY"\n只听$N"HIY"背后东海幻象中冲出一条"+name+HIY"，将尾一摇，一道飓风卷向$n"HIY"$l！ \n"NOR;
        succ_msg = HIR+smsgs[random(sizeof(smsgs))]+NOR;
        me->add_temp("apply/attack",45);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,1500);
        me->add_temp("apply/attack",-45);
	me->start_busy(3);
	me->delete_temp("pfm_msg");
        return 1;
}

int help(object me)
{
string str;
if( !me )      return 0;
str = @LONG
        外功名称：升龙技
        外功所属：龙形搏击
        外功效果：以东海九龙虚影攻击对手
                  每50级增加一条神龙虚影
                  中三击为法术型气血伤害
                  自身busy2-3秒
        外功条件：
                  龙宫弟子
                  人物等级20级
                  内力300点，消耗150点
                  龙形搏击200级
                  碧海神通200级
LONG;
me->start_more(str);
return 1;
}

