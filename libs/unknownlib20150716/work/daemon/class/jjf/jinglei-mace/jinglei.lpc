#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#define TENGSHE HIR "「雨后惊雷」"NOR

int perform(object me, object target)
{
        object weapon;
        string msg,succ_msg;
        int damage;
 
 	if( me->query_level()<10 )
 		return notify_fail("你的人物等级不够。\n");
        if( !objectp(weapon = me->query_temp("weapon")) 
         || (string)weapon->query("skill_type") != "mace" 
         || me->query_skill_mapped("mace") != "jinglei-mace" )
		return notify_fail("你的锏呢？\n");
 	if((int)me->query_skill("wusi-mace", 1) < 100)
                return notify_fail("你的无私锏法不够熟练，无法施展" TENGSHE "。\n");	
        if( me->query("force")<100 )
                return notify_fail("你的内力不够，无法施展" TENGSHE "。\n");
 		
        if(! target) target = offensive_target(me);

	if( !target
	 || !target->is_character()
	 || target->is_corpse()
	 || target == me 
	 || !me->is_fighting(target) )
		return notify_fail(TENGSHE "只能在战斗中对对手使用。\n");
	
	me->add("force",-80);
        msg = HIY"$N"HIY"陡然施展出"NOR+TENGSHE+NOR HIY"，手腕轻轻一抖，$w"HIY"顿时拔地弹起，其上电芒闪烁，如同活物一般袭向$n"HIY"！\n" NOR;
	succ_msg = HIR "结果$n" HIR "未能看破企图，一声惨嚎，$w"HIR "前端已没入体内半寸，登时连退数步！\n"NOR;
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,500,"kee");
	me->set_temp("pfm_msg",0);
        if( damage<1 )
        {
                me->start_busy(2);
                msg = CYN "可是$p运足内力，奋力挡住了$P这神鬼莫测的一击！\n"NOR;
                message_combatd(msg,me,target);
        }
	else	me->start_busy(1);
        return 1;
}

int help(object me)
{
string str;     
if ( !me )      return 0;
str = @LONG
        外功名称：雨后惊雷
        外功所属：惊雷鞭法
        外功效果：带固定伤害的法术型气血攻击
                  使用后自身busy 1 秒
                  不中则自身busy 2 秒
        外功条件：
                  人物等级10级
                  内力100点，消耗80点
                  惊雷鞭法100级并激发
                  
LONG;
me->start_more(str);
return 1;
}
