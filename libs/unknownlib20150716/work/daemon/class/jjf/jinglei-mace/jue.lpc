#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me,object target)
{
	string msg,unarmed,spear,axe,mace;
	int damage;
	
	if((string)me->query("family/family_name") != "将军府" )
        	return notify_fail("你不是将军府门下，如何能领悟得了此招「万刃神兵诀」？\n");
	if( me->query_level()<50 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("sen") < 200 || me->query("kee") < 200 )
        	return notify_fail("你现在状态不佳，使用这招「万刃神兵诀」恐怕有危险．\n");
	if( me->query("force") < 800 )
        	return notify_fail("你的当前内力太少了，会有危险的．\n");
	if( me->query_skill("lengquan-force",1) <500 )
        	return notify_fail("你的冷泉神功级别太低，还用不了这招．\n");
	if( me->query_skill("spear",1) < 500 )
        	return notify_fail("你的基本枪法别太低，使用这招恐怕有危险．\n");
	if( me->query_skill("mace",1) <500 )
        	return notify_fail("你的基本锏法级别太低，还用不了这招．\n");
	if( me->query_skill("axe",1) < 500 )
        	return notify_fail("你的基本斧法级别太低，还用不了这招．\n");
	if( me->query_skill("jinglei-mace",1)<500 )
        	return notify_fail("你的惊雷鞭法级别太低，还用不了这招．\n");   
	if( !stringp(unarmed = me->query_skill_mapped("unarmed"))
	 || !stringp(spear = me->query_skill_mapped("spear"))
	 || !stringp(axe = me->query_skill_mapped("axe"))
	 || !stringp(mace = me->query_skill_mapped("mace")) )
		return notify_fail("你学到的基本武器技能太少，用不了「万刃神兵诀」。\n");	 
	if( time()<me->query_temp("jjf_jue")+7 )
		return notify_fail("你不能频繁使用「万刃神兵诀」。\n");	 
		
	if(!target)      target = offensive_target(me);        
	if( !target
 	 || !target->is_character()
 	 || target->is_corpse()
 	 || target == me 
 	 || !me->is_fighting(target) )
		return notify_fail("你准备对谁用这招「万刃神兵诀」？\n");
		
	 
	msg = HIR"\n$N"HIR"暗念八卦咒，运起澎湃护体真气，脚下是越转越快，出手是越来越狠．．．．\n"NOR;
	message_vision(msg,me);
	me->set_temp("jjf_jue",time());
	me->add("force",-100);
	me->receive_damage("kee",100,me);
	me->receive_damage("sen",100,me);
	
	("/daemon/class/jjf/jinglei-mace/tiancheng.lpc")->perform(me,target);
	me->stop_busy();
	me->reset_action();
        message_vision(NOR"\n"HBBLU"轰!!轰!!轰!!$N"HBBLU"被$n"HBBLU"砸得天旋地转,站立不稳,差点去见崔爷爷！"NOR"\n",target,me);
	damage = COMBAT_D->valid_damage(me,target,"jinglei-mace",TYPE_PERFORM);
	if( me->query("mark/jjf_jinglei-mace")>1 )
	{
        	target->receive_wound("kee",damage,me,TYPE_CAST);
		target->receive_damage("kee",damage,me,TYPE_CAST);
	}
	else
	{
        	target->receive_wound("kee",damage,me,TYPE_PERFORM);
		target->receive_damage("kee",damage,me,TYPE_PERFORM);
	}
	COMBAT_D->report_status(target,1);
	COMBAT_D->report_status(target);
	return 1;
}

int help(object me)
{
string str;     
if ( !me )      return 0;
str = @LONG
        外功名称：万刃神兵诀
        外功所属：惊雷鞭法
        外功效果：连续攻击对方，命中递增
        	  每一击，内力消耗增加50点
        	  最后一击必中
                  冷却7秒
        外功条件：
                  人物等级50级
                  将军府弟子
                  内力800点，消耗200点
                  气血、精神200点，各消耗100点
                  冷泉神功500级
                  惊雷锏法500级
                  基本枪法500级并有激发
                  基本斧法500级并有激发
                  基本锏法500级并有激发
                  
LONG;
me->start_more(str);
return 1;
}
