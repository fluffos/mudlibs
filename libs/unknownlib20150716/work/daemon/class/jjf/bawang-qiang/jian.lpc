#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	object weapon;
	int damage,p;
	string msg,succ_msg;
	
	if( me->query_level()<50 )
		return notify_fail("你的人物等级不够。\n");
	weapon = me->query_temp("weapon");
	if( !weapon
	 || ( weapon->query("skill_type")!="spear"
	   && weapon->query("use_apply_skill")!="spear" ) )
	   	return notify_fail("你手里没枪。\n");
	if( me->query_skill("wusi-mace",1)<300
	 && me->query_skill("jinglei-mace",1)<300 )
	 	return notify_fail("你至少得提高一种锏法。\n");
	if(me->query("family/family_name")!="将军府"  
 	 &&me->query("chushi/chushi_jjf")!="yes")
        	return notify_fail("你不能使用这项技能！\n"); 	
	if( me->query_skill("bawang-qiang",1)<500
	 || me->query_skill_mapped("spear")!= "bawang-qiang" )
		return notify_fail("此乃罗家霸王枪的精髓之技。\n");
	if( me->query_skill_mapped("mace")!= "wusi-mace" 
	 && me->query_skill_mapped("mace")!= "jinglei-mace" )
		return notify_fail("你的锏法呢。\n");
	if( me->query("force")<500 )
		return notify_fail("你内力不足。\n");
if( time()<me->query_temp("jjf_feijian")+5 )  return notify_fail("你不能频繁飞锏。\n");
      	if( !target ) target = offensive_target(me);
	if( !target
 	|| !target->is_character()
 	|| target->is_corpse()
 	|| target==me
 	|| !me->is_fighting(target) )
 		return notify_fail("你要对谁施展这一招「枪里加锏」？\n");
	
	me->add_temp("force",-150);
	me->set_temp("jjf_feijian",time());
	msg = HIC"$N"HIC"双手一抖，$w"HIC"抖出三四个枪花，朵朵枪花闪电般扎向$n"HIC"$l！\n"NOR;
	succ_msg = HIR"只听“扑哧”一声，$n"HIR"$l处顿时绽开一朵凄厉的鲜红梅花，鲜血冒出寸许！\n"NOR;
	p = me->query_skill("spear");
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/combat_succ",25);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_EXERT,msg,succ_msg,0,p,"kee");
	me->add_temp("apply/combat_succ",-25);
	me->set_temp("pfm_msg",0);
	if( objectp(weapon = me->query_temp("weapon")) )
	{
		if( damage<1 )
		{
			message_combatd(HIC"结果这一击被$n"HIC"堪堪架住。\n"NOR,me,target);
			msg = HIY"\n$N"HIY"趁$n"HIY"忙于招架，"NOR;
		}
		else	msg = HIY"\n$N"HIY"一招得手，"NOR;
		p = 25+(me->query_skill("dodge",1)-500)/100;
		if( p>50 )
			p = 50;
		msg+= HIY"顺势倒转枪头，枪作鞭势，一招「枪里加锏」，狠狠砸向$n"HIY"$l！\n"NOR;
		succ_msg = HIR"只听“轰”的一声，$n"HIR"一声惨叫，$l处顿时肿起了老大一块，疼得$p哧哧直咧嘴。\n"NOR,
		weapon->set("use_apply_skill","mace");
		me->reset_action();
		me->set_temp("pfm_msg",1);
		me->add_temp("apply/combat_succ",p);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_EXERT,msg,succ_msg,0,me->query_skill("mace")+me->query_skill("spear"),"kee");
		me->add_temp("apply/combat_succ",-p);
		me->set_temp("pfm_msg",0);
		if( weapon )
			weapon->delete("use_apply_skill");
		me->reset_action();
	}		
	return 1;
}

int help(object me)
{
string str;
if ( !me )      return 0;

str = @LONG
        外功名称：枪里加锏
        外功所属：霸王枪法
        外功效果：以枪法、锏法分别攻击对方
                  内功型攻击
		  冷却时间5秒
        外功条件：
                  将军府(出师)弟子         
                  人物等级50级 
                  内力500点，消耗150点
                  霸王枪法500级并激发
                  无私锏法、惊雷锏法任一达500级并激发
LONG;
me->start_more(str);
return 1;
}

