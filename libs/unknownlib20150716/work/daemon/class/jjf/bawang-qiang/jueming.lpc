// huima.c 霸王枪法
//姜家之绝命九枪
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	object weapon,env,*inv,*enemy,ev;
	string msg,succ_msg;
	int max_lvl,damage,bt,i,k,t;
	mixed b_time;

	if( me->query_level()<60 )
		return notify_fail("你的人物等级不够。\n");
        if( me->query("family/master_id")!="lao ren"
	 && me->query("family/master_id")!="luo cheng" )
		return notify_fail("「绝命九枪」唯有罗家枪传人才能施展。\n");	 
	if( me->query("family/family_name") != "将军府" )
        	return notify_fail("你是哪儿偷学来的武功！\n");
	if( me->query("force")<800 ) 
        	return notify_fail("你的内力太少。\n");
	max_lvl = 600;
	max_lvl+= (int)me->query("betray/count")*50;
	if( (int)me->query_skill("lengquan-force", 1) < max_lvl )
        	return notify_fail("你的冷泉心法还差些火候。\n");
	if( (int)me->query_skill("yanxing-steps", 1) < max_lvl )
        	return notify_fail("你的雁行步法无法配合「绝命九枪」。\n");
	if( (int)me->query_skill("bawang-qiang", 1) < max_lvl )
        	return notify_fail("你的霸王枪法不够娴熟，不能施展「绝命九枪」。\n");
	
	if( !objectp(weapon=me->query_temp("weapon"))
	 || weapon->query("skill_type")!="spear" )
	 	return notify_fail("你的枪呢？\n");
			
	if( !target ) target = offensive_target(me);
	if( !target
 	 || !target->is_character()
 	 || target->is_ghost() 
 	 || !me->is_fighting(target) )
		return notify_fail("绝命九枪只能对战斗中的对手使用。\n");
		
	me->add("force",-200);		
	if( me->query("cor")>random(target->query_cps()) 
	 && !target->is_busy() )
	{
		target->start_busy(1+random(2));
		msg = HIR"双方交战多时，$N"HIR"招式陡然一变，"+weapon->name(1)+HIR"舞动如风，一股冲天战气笼罩全场，$n"HIR"只觉举步唯艰。\n"NOR;
		message_vision(msg,me,target);
	}	
	message_vision(HIR"\n$N"HIR"暴喝一声，状若怒虎，双把合一，"+weapon->name()+HIR"舞出漫天的枪花，压向$n"HIR"！\n"NOR,me,target);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
	me->add_temp("apply/combat_succ",20);
        COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
	me->add_temp("apply/combat_succ",-20);

	if( COMBAT_D->query_message_type(me,target)<1 )
		message_vision(HIR"\n三枪使完，$N"HIR"枪头一转，抖出五个枪影，带出风雷之声，狠狠砸向$n"HIR"！\n"NOR,me,target);
	me->add_temp("apply/combat_succ",30);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK);
	me->add_temp("apply/combat_succ",-30);

	if( me->query_skill("bawang-qiang",2)>800 
  	 && me->query_skill("literate",1)>800 
  	 && me->query("force")>150 )
        {       
        	msg = HIR"\n$N"HIR"八枪使完，似无续招，猛然思起祖师爷传授此招时说道的最后一式乃是承随心所欲之势，不由恍然，手中$w"HIR"急摆，也不管它什么招势，但凭风指云引。\n"HIC"$N"HIC"手腕一抖，$w"HIC"似乎毒蛇吐信般急点$n"HIC"命门！\n"NOR;
        	succ_msg = HIY"结果$n"HIY"闪避不及，被$w"HIY"刺了个正着，顿时血流满面！\n"NOR;
        	me->add("force",-150);
        	me->set_temp("pfm_msg",1);
        	me->add_temp("apply/attack",30);
        	if( me->query("mark/jjf_bawang-qiang")>0 )
        		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,"头部",me->query_skill("spear"),"kee");
        	else	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,"头部",me->query_skill("spear"));	
        	me->add_temp("apply/attack",-30);
        	me->delete_temp("pfm_msg");
        	if( damage<1 )
        		message_combatd(HIC"$N"HIC"不慌不忙，从容闪过。\n"NOR,target);
	}                               
	me->start_busy(2);              
	return 1;
}               
                                
int help(object me)
{
string str;     
if ( !me )      return 0;
str = @LONG
        外功名称：绝命枪法
        外功所属：霸王枪法
        外功效果：连续攻击对方
        	  霸王枪800级后以法术型伤害给予敌人以气血重创
                  使后自身busy 2 秒
        外功条件：
        	  将军府弟子
        	  人物等级60级
                  内力800点，消耗200-350点
                  霸王枪法、冷泉心法、雁行步法最低600级
                  每叛师一次要求提高50级
LONG;
me->start_more(str);
return 1;
}       
