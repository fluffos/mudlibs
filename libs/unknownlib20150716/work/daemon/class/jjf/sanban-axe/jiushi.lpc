// nine.c 
//将军府终极pfm 盘古九式 
#include <ansi.h>
#include <combat.h>
inherit SSERVER; 

string name()
{
	return "「"NOR YEL"盘古九式"NOR"」";
}

int valid_perform(object me)
{
	int i,base=500;
	string sk,*skills = ({
        	"lengquan-force","sanban-axe",
	});     
	if( !me )
        	return 0;
	if( me->query("family/family_name")!= "将军府" )
        	return notify_fail(name()+"乃是将军府不传绝招。\n");
	if( me->query_level()<50 )
		return notify_fail("你的人物等级不够。\n");        	
        if( me->query("betray/count")>0 )
        	base+= me->query("betray/count")*50;	
	i = sizeof(skills);
	while ( i-- )
        {
        	sk = skills[i];
        	if( !sk || !stringp(sk) )
                	continue;       
        	if( me->query_skill(sk,1)<base )
                	return notify_fail("你的"+to_chinese(sk)+"等级不足，不能施展"+name()+"。\n");       
        }
	if( me->query("faith")<5000 )
        	return notify_fail("你的门忠不足，不能施展"+name()+"。\n");
	if( me->query("force")<800 )
        	return notify_fail("你的内力不足，不能施展"+name()+"。\n");   
	if( time()<me->query_temp("zjpfm_jjf_nine")+5 )
        	return notify_fail("你刚刚想施展"+name()+"，只觉浑身乏力，提不起力来。\n");    
	return 1;               
}

int perform(object me, object target)
{
	object weapon;
	int damage,fail=0;
	string tmp,msg,succ_msg;
	if( !valid_perform(me) )
        	return 0;
	if( !objectp(weapon = me->query_temp("weapon"))
	 || weapon->query("skill_type")!="axe" 
	 || me->query_skill_mapped("axe")!= "sanban-axe" )
		return notify_fail("你的斧子呢？\n");
				 
	if( !target ) 
        	target = offensive_target(me);
	if( !target
  	 || !target->is_character()
  	 || !me->is_fighting(target) )
        	return notify_fail(name()+"只能对战斗中的对手使用。\n");

	
	me->set_temp("zjpfm_jjf_nine",time());
	me->add("force",-100);
//1
	msg = HIY"$N"HIY"一声大喝“开”！一道血影划过，$w"HIY"直劈$n"HIY"面门，竟是程咬金三板斧中「开瓜」之招式，但其威武却不可同语。\n"NOR;
	succ_msg = HIR"结果$n"HIR"披头散发，满面流血，惨叫不迭。\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/combat_succ",30);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,"头部",500);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/combat_succ",-30);

	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}
//2			
	if( damage<1 )
	{
		msg = "\n虽然第一击落空，";
		fail++;
	}
	else	msg = "\n一击得手，";	
	me->add("force",-100);        
	msg+= "$N又喝道：“剔牙！”！$w疾挑，寒光闪动，映得$n面目一阵铁青。这式「剔牙」出招刁钻，叫人防不胜防！\n";
	msg = HIB+COLOR_D->clean_color(msg)+NOR;	
	if( damage>0 )
		succ_msg = HIR"结果$n"HIR"伤上加伤，脸上又添一道触目惊心的伤口！\n"NOR;
	else	succ_msg = HIR"结果$n"HIR"这一下终于闪避不了，顿时脸上添上一道触目惊心的伤痕！\n"NOR;	
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/combat_succ",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,"头部",600);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/combat_succ",-50);

	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}
//3
	if( damage<1 )
	{
		fail++;
		if( fail==2 )
			msg = "\n虽然前两击落空，";
		else	msg = "\n虽然$n躲开了一招「剔牙」，";
	}
	else
	{
		if( fail==0 )
			msg = "\n$N连连得手，";	
		else	msg = "\n$N终开头筹，";	
	}
	me->add("force",-100);        
	msg+= "$w顺势一带，寒光一闪，斧子仍不离$n面门，一招「掏耳朵」直削$p的太阳穴！\n";
	msg = HIW+COLOR_D->clean_color(msg)+NOR;
	if( fail==2 )
		succ_msg = HIR"结果$n"HIR"虽躲开前两招，却躲不开这记杀招！"NOR;
	else if( fail==1 )
		succ_msg = HIR"结果$n"HIR"鲜血模糊了双眼，这一招也是躲无可躲！"NOR;
	else	succ_msg = HIR"结果$n"HIR"面门接连受创，哪里还躲得开第三招！"NOR;
	succ_msg+= HIR"惨叫声中，$n"HIR"披头盖发，状若疯癫，满面血痕，叫人惨不忍睹。\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/combat_succ",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,"头部",800);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/combat_succ",-50);		
	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}
	
	if( me->query("mark/jjf_sanban-axe")<1 )
		return 1;
	
//4	      
	tell_object(me,HIR"\n三式过后，你收回"+weapon->name()+HIR"，情形是大同，单臂血脉贲张，暴涨了一倍有余，通臂现出血色雾气。\n"NOR);
	message("vision",HIR+me->name()+HIR"三招过后，单臂血脉贲张，暴涨了一倍有余，通臂现出血色雾气。"NOR,environment(me),me);
	me->add("force",-100);
	msg = HIC"$N"HIC"$w"HIC"回转，暴喝一声“挖”！这一式除却斧的大力，又兼收了枪的灵动，锏的豪迈，如影随形，贴身而来，让人避无可避。\n"NOR;
	succ_msg = HIR"结果血箭飞溅，$n"HIR"被$w"HIR"带起风势卷起，在半空翻转腾挪，弄得是手忙脚乱。\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,1500,"kee");
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-50);		
	if( damage<=0 )
        	message_combatd(HIC"$n"HIC"腰马合一，倒也抗住了这一击。\n"NOR,me,target);
	else if( !target->is_busy() )
		target->start_busy(3);

	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}

	if( me->query("mark/jjf_sanban-axe")<2 )
		return 1;
	
//5
	tmp = ({
        	"口喷鲜血整个人横飞了出去",
	        "整个人似一捆稻草般飞了出去",
        	"狂吐鲜血，身子象断了线的风筝向後飞去",
	        "血肉横飞，十命断了九条",
        	"闷哼一声，吐出一口鲜血，五脏六腑都错了位",
	})[random(4)];

	msg = HIB"\n$N"HIB"毫无停手之意，大喝一声，$w"HIB"璇飞而出，只带得飞沙走石，令人难睁双目，待看得清了，那还来得及闪避。先是一记，紧跟再一记，招式中竟有些许鞭和枪的特质，却比鞭，棍的力量更浑厚，更霸道。$n"HIB"切肤感觉到的只能是斧的冰冷和血的滚烫。\n"NOR;
	me->add("force",-100);
	succ_msg = HIR"$n"HIR"但见眼前净是扑面的风沙，虽知命悬一线，可惜心神已乱，给打得"+tmp+"！\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,1000,"kee");
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-50);
	if( damage<1 )
		message_combatd(HIG"$n"HIG"虽双目紧闭，但凭扑面而来风沙，已知命悬一线，即刻攒起身躯，缩成一团，这才护住要害。\n"NOR,me,target);
	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}
	
	if( me->query("mark/jjf_sanban-axe")<3 )
		return 1;

//6	
	tmp = ({
        	"口喷鲜血整个人横飞了出去",
	        "整个人似一捆稻草般飞了出去",
        	"狂吐鲜血，身子象断了线的风筝向後飞去",
	        "血肉横飞，十命断了九条",
        	"闷哼一声，吐出一口鲜血，五脏六腑都错了位",
	})[random(4)];

	msg = HIW"\n风雷乍起，$w"HIW"飞旋而回，带起一地沙石，直接划向$n"HIW"$l！\n"NOR;
	me->add("force",-100);
	succ_msg = HIR"$n"HIR"一身闷哼"+tmp+"！\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",30);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-30);
	if( damage<1 )
		message_combatd(CYN"$n"CYN"慌忙侧身闪过，有惊无险，却也惊出了一身冷汗。\n"NOR,me,target);
	message_vision(CYN"$N"CYN"一把擎住巨斧，哈哈大笑了一声。\n"NOR,me);		
	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}	

	if( me->query("mark/jjf_sanban-axe")<4 )
		return 1;
	
//7		
	msg = "\n$N战意澎湃，仰天一声怒吼，只见$P背后隐现一尊顶天立地的巨人虚像，体表明光溢彩，符文流转，宛如神灵！";
	msg+= "像随心动，巨人怒吼，声音滚滚如雷，一把巨大的$w幻化在手，挟开天之势，化万千影像，劈头盖脸的砸向$n！\n"NOR;
	msg = HIY+COLOR_D->clean_color(msg)+NOR;
	succ_msg = HIR"结果$n"HIR"不知如何藏身，浑身上下有如被千刀万剐，血流如注！\n"NOR;
	me->add("force",-150);
        me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,1500,"kee");
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-50);
	if( me->query("force")<200 )
	{
		message_vision(CYN"\n$N"CYN"内力不济，无力再发起后击，只得后退一步，伺机而动。\n"NOR,me);
		return 1;
	}
	if( me->query("mark/jjf_sanban-axe")<5 )
		return 1;
	
//8	
	msg = "\n巨人又是一声怒吼，漫天斧影，尽皆化去。不再如先前般狂妄，神情倒变得更加凝重，$w缓缓挥动，如混沌初开之纯粹浩荡，顿时，风雷哀号，天与地闪过一阵阵的胆怯。\n";
	msg = HIC+COLOR_D->clean_color(msg)+NOR;
	succ_msg = HIR"$n"HIR"如中魔咒，再低头看向自己，身上虽一片的血色，却并无新伤。心里明白，内里已经心胆尽碎，肝肠寸断。\n"NOR;
	me->add("force",-100);
        me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",50);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,1500);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-50);
	if( damage<1 )
		message_combatd(HIR"$n"HIR"观此气象，不敢怠慢，运足内劲，护于体内要害之穴道，但觉一股大力涌来时，爆出毕生功力将其抗出体外。\n"NOR,me,target);

        if( me->query("mark/jjf_sanban-axe")<6 || me->query("faith")<500 )
		return 1;
//9
	me->add("faith",-500);
	msg = "\n可一切尚未结束，最后一声若旱地焦雷再度响起，$w瞬息向前劈出，$n胸前虚空顿时现出一只巨大金色手臂，尽皆没入$p胸前，贯胸而出！\n";
	if( weapon && weapon==me->query_temp("weapon") )
		msg = replace_string(msg,"$w",weapon->name(1));
	else	msg = replace_string(msg,"$w","巨斧");
	msg = HIY+COLOR_D->clean_color(msg)+NOR;
	message_vision(msg,me,target);
	if( !target->is_boss() && !target->query("任务") )
	{
		succ_msg = HIR"$n"HIR"双眸之中顿时生机尽失，宛如稻草般横空飞出！\n"NOR;
		damage = target->query_maxkee();
	}
	else
	{
		succ_msg = HIR"”砰“的一声巨响，$n"HIR"受此重击，顿时整个人萎靡下去，宛如稻草般横空飞出！\n"NOR;
		damage = target->query_maxkee()/3+1;
	}
	message_vision(succ_msg,me,target);	
	target->receive_wound("kee",damage,me,TYPE_CAST);
	COMBAT_D->report_status(target,1);
	message_combatd(HIC"\n$N"HIC"背后巨人像渐渐淡去，唯有四下浓郁的血腥气似依然在诉说着杀戮...\n"NOR,me);
	return 1;
}

int help(object me)
{
string str;     
if( !me )      return 0;
str = @LONG
        外功名称：盘古九式
        外功所属：宣花三斧
        外功效果：连续攻击对方，命中和固定伤害递增
        	  前三击物理伤害
        	  后五击法术型气血伤害
        	  最后一击必中，非特殊怪必杀
        	  最后一击必中，特殊怪固定伤害为30%气血上限
        	  从第四击起需战斗中领悟，每次领悟增加一击
                  冷却时间5秒
        外功条件：
                  将军府弟子
                  人物等级50级
                  内力800点，初始消耗100点，每击消耗100点
                  门忠5000点，最后一击消耗500点
                  宣花三斧、冷泉心法500级
                  每叛师一次增加50级限制
LONG;
me->start_more(str);
return 1;
}
