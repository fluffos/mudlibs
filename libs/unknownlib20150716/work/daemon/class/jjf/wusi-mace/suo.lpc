#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon, his_weapon;
  string msg, succ_msg;
  int skill, b_time, succ;

  if (me->query_level() < 25)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill_mapped("dodge") != "yanxing-steps")
    return notify_fail("『锁字锏』需要雁行步法的配合！\n");
  if ((int)me->query_skill("wusi-mace", 1) < 250
    || me->query_skill_mapped("mace") != "wusi-mace"
    || (int)me->query_skill("wusi-mace", 1) < 250)
    return notify_fail("你的锏法不够精深！\n");
  if ((int)me->query_skill("yanxing-steps", 1) < 250)
    return notify_fail("你的『雁行步法』等级不够！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你体内的内力不足！\n");
  weapon = me->query_temp("weapon");
  if (!weapon
    || (weapon->query("skill_type") != "mace"
      && weapon->query("use_apply_skill") != "mace"))
    return notify_fail("你需要一把锏！\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招『锁字锏』？\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经手忙脚乱了！\n");

  skill = (int)me->query_skill("wusi-mace", 1);
  b_time = 3 + skill / 100;
  if (b_time > 9)
    b_time = 9;

  msg = "$N使出无私锏法中的「锁字锏」，手中$w如鬼似魅般缠向$n！\n" NOR;
  succ_msg = "$N手中$w如影随行，似灵蛇般锁住$n的$W！\n" NOR;

  msg = replace_string(msg, "$w", weapon->name(1));
  msg = HIW + COLOR_D->clean_color(msg) + NOR;
  message_vision(msg, me, target);
  me->add("force", -100);

  me->add_temp("apply/attack", 10);
  succ = COMBAT_D->attack_percent(me, target, TYPE_PERFORM);
  me->add_temp("apply/attack", -10);

  if (succ < 1) {
    message_combatd(HIY "结果被$n" HIY "奋力招架住了！\n" NOR, me, target);
    me->start_busy(1);
  } else {
    succ_msg = replace_string(succ_msg, "$w", weapon->name(1));
    if (objectp(his_weapon = target->query_temp("weapon")))
      succ_msg = replace_string(succ_msg, "$W", his_weapon->name(1));
    else succ_msg = replace_string(succ_msg, "$W", "招式");
    succ_msg = HIR "结果" + COLOR_D->clean_color(succ_msg) + NOR;
    message_vision(succ_msg, me, target);
    target->start_busy(b_time);
  }
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @LONG
        外功名称：锁字锏
        外功所属：无私锏法
        外功效果：使对方busy 3-9 秒
                  失败则自身busy 1 秒
                  不能对busy中的对象使用
        外功条件：
		  人物等级25级
                  内力500点，消耗100点
                  无私锏法250级并激发
                  雁行步法250级并激发
                 
LONG;
  me->start_more(str);
  return 1;
}
