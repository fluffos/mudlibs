// thunder.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{
	string msg,succ_msg;
	int damage,success_adj, damage_adj;
	success_adj = 120;
	damage_adj = 800;

	if( me->query_level()<45 )
		return notify_fail("你的人物等级不够。\n");
	if(me->query("family/family_name")!="方寸山三星洞")
		return notify_fail("你不能用「五雷咒」！\n");
	if((int)me->query("mana") < 500 )
		return notify_fail("你的法力不够！\n");
	if((int)me->query("sen") < 100 )
		return notify_fail("你无法集中精力！\n");
	if( time()<me->query_temp("fc_thunder")+8 )
		return notify_fail("你不能频繁施展「五雷咒」。\n");
	
	if( !target ) target = offensive_target(me);

	if( !target
	||      !target->is_character()
	||      target->is_corpse()
	||      target==me)
		return notify_fail("你要对谁施展「五雷咒」？\n");


	me->set_temp("fc_thunder",time());
	me->add("mana", -200);
	me->receive_damage("sen", 50);

	if( random(me->query_maxmana()) < 50 ) 
	{
		write("糟糕，雷公今天不当差！\n");
		return 1;
	}

	msg = HIC "\n$N"HIC"口中念了句咒文，半空走出位尖头鹰鼻的雷公，左手执斧，右手提锥。斧锥相击，在$n"HIC"的头顶炸起一片响雷！\n" NOR;
	succ_msg = HIR "结果$n"HIR"被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR;
	me->add_temp("apply/spells_succ",success_adj);
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,damage_adj,"kee");
	me->delete_temp("pfm_msg");
	me->add_temp("apply/spells_succ",-success_adj);
	if( damage>0 )
	{
		if( target && living(target) && !target->is_hunluan() )
			target->start_hunluan(3,HIR"你被"+me->name()+HIR"的雷声震得眼冒金星，心神不定，差点跌倒在地！"NOR"\n");
	}
	else	message_combatd(HIB"谁知$N"HIB"毫无反应，就象聋子似的。\n"NOR,target);	
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：五雷咒
        法术所属：道家仙法
        法术效果：带固定伤害的法术伤害
        	  有一定几率使对方陷入混乱状态
                  冷却时间 8 秒
        法术条件：
                  方寸弟子
        	  人物等级45级
                  法力500点，消耗200点
                  精神100点，消耗50点
STR;
        me->start_more(str);
        return 1;
}