// fenshen.c 分身术
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target) {
  int num, fenshen_time;  //this time is the time interval fenshen can be used again. 
  object *hufa, soldier;

  if (!userp(me) && me->query("jiashen"))
    return 0;
  if (me->query_level() < 30)
    return notify_fail("你的人物等级不够。\n");
  if (!me->is_fighting())
    return notify_fail("只有战斗中才能使用分身法！\n");
  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("你不能用「分身术」！\n");
  if (time() < me->query_temp("fc_fenshen") + 15)
    return notify_fail("你不能频繁施展「分身术」。\n");
  if (me->query_level() < 50)
    num = 1;
  else if (me->query_level() < 80)
    num = 2;
  else num = 3;
  if (pointerp(hufa = me->query_temp("invocation"))
    && sizeof(hufa) >= num)
    return notify_fail("你分不了更多的假身了。\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N喃喃地念了几句咒语。\n", me);
  me->set_temp("fc_fenshen", time());

  if (random(me->query_maxmana()) < 200) {
    me->add("mana", -50);
    me->receive_damage("sen", 10);
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }

  me->add("mana", -300);
  me->receive_damage("sen", 50);

  seteuid(getuid());
  soldier = new("/d/lingtai/npc/fenshen.lpc");
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->set_temp("invoker", me);
  me->set("last_fenshen", time());
  me->start_busy(1);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        法术名称：分身术
        法术所属：道家仙法
        法术效果：分出一至三个与自身属性相似的假身参加战斗
                  冷却时间 15 秒
                  自身busy 1 秒
        法术条件：
                  方寸弟子
        	  人物等级30级
                  法力500点，消耗300点
                  精神100点，消耗50点
STR;
  me->start_more(str);
  return 1;
}
