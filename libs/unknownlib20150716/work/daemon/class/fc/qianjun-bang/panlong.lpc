#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int j, skill, dodge, damage;
  string msg, limb;

  if (me->query_level() < 50)
    return notify_fail("你的人物等级不够。\n");
  if ((userp(me) && !wizardp(me)) && me->is_knowing("puti_panlong") != "succ")
    return notify_fail("你还不会这一招。\n");
  if (!userp(me) && !me->query("panlong"))
    return 0;
  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("你是哪儿偷学来的武功，也想用「盘龙八式」?\n");
  if (!weapon = me->query_temp("weapon")
    || (weapon->query("skill_type") != "stick"
      && weapon->query("use_apply_skill") != "stick"))
    return notify_fail("「盘龙八式」必须用棍棒才能施展。\n");
  if ((int)me->query_skill("qianjun-bang", 1) < 500)
    return notify_fail("你的「千钧棒」不够娴熟，不会使用「盘龙八打」。\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的内力不够。\n");

  if (!target) target = offensive_target(me);
  if (!target || target->is_ghost()
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「盘龙八式」只能在战斗中使用。\n");

  if (target->query_temp("jldl")) {
    target->delete_temp("jldl");
    target->set_temp("jldl_end", time());
    target->delete_temp("jldl_time");
    message_vision(HIY "\n$N" HIY "运起盘龙八式，面对强大的气劲，$n" HIY "的借力打力也失去了作用！\n\n" NOR, me, target);
  }

  msg = HIC "$N" HIC "跳至空中，手中的" + weapon->name(1) + HIC "好似" + HIY "盘龙出沧海" + HIC "顿时化作无数条影子。\n" NOR;
  message_vision(msg, me, weapon);
  me->add_temp("apply/baoji", 50);
  me->set_temp("pl_end", time());
  me->add("force", -300);
  skill = me->query_skill("qianjun-bang", 1);
  dodge = (me->query_skill("dodge") - 150) / 2;
  if (dodge < 50)
    dodge = 50;
  if (dodge > 200)
    dodge = 200;
  me->add_temp("apply/attack", dodge);
  me->set_temp("pfm_color", HBBLU);
  me->set_temp("pfm_msg", 1);
  me->set_temp("QJB_perform", 9);

  limb = ({ "胸口", "后心", "小腹", "颈部", })[random(4)];
  j = 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    0,
    limb,
    skill / 3
  );
  if (damage < 1)
    me->add_temp("anger", 10);

  limb = ({ "胸口", "后心", "小腹", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    0,
    limb,
    skill / 3
  );
  if (damage < 1)
    me->add_temp("anger", 10);

  limb = ({ "胸口", "后心", "小腹", "腰间", })[random(4)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    0,
    limb,
    skill / 2
  );
  if (damage < 1)
    me->add_temp("anger", 10);

  limb = ({ "胸口", "后心", "小腹", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    0,
    limb,
    skill / 2,
    "kee"
  );
  if (damage < 1)
    me->add_temp("anger", 20);

  limb = ({ "胸口", "后心", "小腹", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    0,
    limb,
    skill / 2,
    "kee"
  );
  if (damage < 1)
    me->add_temp("anger", 20);

  limb = ({ "胸口", "后心", "小腹", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    0,
    limb,
    skill,
    "kee"
  );
  if (damage < 1)
    me->add_temp("anger", 20);

  limb = ({ "胸口", "后心", "小腹", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST_2,
    msg,
    0,
    limb,
    skill * 3 / 2,
    "kee"
  );
  if (damage < 1)
    me->add_temp("anger", 30);

  limb = ({ "胸口", "后心", "头部", })[random(3)];
  j += 1;
  msg = HIY "\n$N" HIY "身形如风，舞起手中$w" HIY "砸出了第" + chinese_number(j) + "棍！\n" NOR;
  me->set_temp("QJB_perform", 7);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_EXERT,
    msg,
    0,
    limb,
    skill * 3 / 2,
    "kee"
  );
  if (damage < 1)
    me->add_temp("anger", 30);

  me->add_temp("apply/attack", -dodge);
  me->delete_temp("pfm_color");
  me->delete_temp("QJB_perform");
  me->delete_temp("anger");
  me->delete_temp("pfm_msg");
  me->reset_action();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me)
    return 0;
  str = @LONG
        外功名称：盘龙八式
        外功所属：千钧棒
        外功效果：连续攻击对方八次，打击对方气血
        	  前四击物理伤害，后四击法术伤害
        	  最后一击内功伤害
		  自身busy 2 秒
		  需要在云阳小天师处领悟
        外功条件：
        	  方寸弟子
        	  人物等级50级
        	  千钧棒法500级
        	  基本棍法500级
                  内力800点，消耗300点
LONG;
  me->start_more(str);
  return 1;
}
