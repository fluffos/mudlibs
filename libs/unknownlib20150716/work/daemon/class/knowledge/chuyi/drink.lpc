mapping query_niang() { return Niang; }

int can_niang(object me, string name) {
  int lvl;
  if (!me || !name)
    return 0;
  lvl = me->query_skill("chuyi", 1);
  if (lvl < 30)
    return 0;
  switch (name) {
    case "老白干":
    case "米酒":
    case "绿茶":
    case "红茶":
      if (lvl < 50)
        return 0;
      break;
    case "女儿红":
    case "香醋":
    case "白烧酒":
      if (lvl < 80)
        return 0;
      break;
    case "玄火酒":
    case "碧樨茶":
    case "清泉碧竹茶":
    case "云雾山香茶":
      if (lvl < 90)
        return 0;
      break;
    case "梦醒时分":
    case "醉生梦死":
      if (lvl < 100)
        return 0;
      break;
    default: return 0;
  }
  return 1;
}

string art_list(object me) {
  string *names, str, arg, *needs, file, temp, msg;
  mapping need, tmp;
  int i, n, x;
  if (!me)
    return 0;
  names = keys(Niang);
  str = HIC "★" NOR "目前能酿造的饮料有：\n";
  for (i = 0; i < sizeof(names); i++) {
    if (!can_niang(me, names[i]))
      continue;
    str += sprintf("\t%20-s = ", names[i]);
    need = Niang[names[i]]["need"];
    needs = keys(need);
    for (n = 0; n < sizeof(needs); n++) {
      temp = needs[n];
      file = need[temp];
      if (sscanf(file, "%s_%d", file, x) != 2)
        continue;
      msg = sprintf("%s" HIY "*" HIR "%d" NOR, temp, x);
      str += sprintf("%s", msg);
      if (n < (sizeof(needs) - 1))
        str += "、";
    }
    str += "\n";
  }
  return str;
}

mixed have_item(object me, string file, int v) {
  int i;
  object *inv;
  if (!me || !living(me))
    return 0;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (base_name(inv[i]) == file) {
      if (inv[i]->query_amount() > 0) {
        if (inv[i]->query_amount() >= v)
          return inv[i];
      } else if (v > 1) {
        tell_object(me, HIR "【系统】生活技能：发现一个错误：需求的道具数量>1且非叠加，请联系巫师。\n" NOR);
        return 0;
      } else return inv[i];
    }
  }
  return 0;
}

void finish_niang(object me) {
  object ob;
  string file;
  if (!me)
    return;
  me->delete_temp("art_drinking");
  if (!living(me)
    || !stringp(file = me->query_temp("pending/chuyi_drink"))
    || strlen(file) < 2) {
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "酿造失败了。\n" NOR, environment(me));
      return 0;
    } else tell_object(me, HIR "【系统】生活技能：酿造失败！\n" NOR);
    return;
  }
  if (!objectp(ob = new(file))) {
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "因为文件残缺导致酿造失败了。\n" NOR, environment(me));
      return 0;
    } else tell_object(me, HIR "【系统】生活技能：因为文件残缺导致酿造失败！\n" NOR);
    return;
  }
  if (!ob->move(me)) {
    if (ob) destruct(ob);
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "因为包裹已满导致酿造失败了。\n" NOR, environment(me));
      return 0;
    } else tell_object(me, HIR "【系统】生活技能：因为包裹已满导致酿造失败！\n" NOR);
    return;
  }
  message_vision(
    HIC "$N" HIC "成功酿造出了" HIG "「" + ob->query("liquid/name") + HIG "」" NOR HIC "。\n" NOR,
    me
  );
}

int do_niang(object me, string arg) {
  object obj, *cls, temp;
  int i, v;
  string file, *needs, file2, name;
  mapping nz, need, cl;

  if (!me || !living(me))
    return 0;
  if (me->query_temp("art_drinking"))
    return 0;
  if (undefinedp(Niang[arg]))
    return 0;
  nz = Niang[arg];
  if (undefinedp(nz["file"])
    || undefinedp(nz["need"]))
    return 0;
  file = nz["file"];
  file = "/d/obj/knowledge/chuyi/drink/" + file;

  need = nz["need"];
  needs = keys(need);
  cl = ([]);
  for (i = 0; i < sizeof(needs); i++) {
    name = needs[i];
    file2 = need[name];
    if (sscanf(file2, "%s_%d", file2, v) != 2)
      continue;
    if (!objectp(temp = have_item(me, file2, v))) {
      if (!userp(me)) {
        message(
          "vision",
          CYN + me->name() + CYN "说道：缺少" + name + HIR "*" HIY + v + NOR "。\n" NOR,
          environment(me)
        );
        return 0;
      } else return notify_fail("缺少材料：" + name + HIR "*" HIY + v + NOR "。\n");
    } else cl[temp] = v;
  }
  cls = keys(cl);
  for (i = 0; i < sizeof(cls); i++) {

    if (!objectp(temp = cls[i])
      || !intp(v = cl[cls[i]])
      || v < 1
      || !present(temp, me)
      || (temp->query_amount() > 0 && temp->query_amount() < v)) {
      if (!userp(me)) {
        message("vision", CYN + me->name() + CYN "说道：掉了一样材料。\n" NOR, environment(me));
        return 0;
      } else return notify_fail("掉了一样材料。\n");
    } else {
      if (temp->query_amount() < 1)
        destruct(temp);
      else if (temp->query_amount() == v)
        destruct(temp);
      else temp->add_amount(-v);
    }
  }
  me->set_temp("art_drinking", 1);
  if (userp(me))
    me->add("gin", -3);
  message_vision("$N开始专心致志的酿造起" + HIC "「" + arg + "」" NOR "来。\n", me);
  me->set_temp("pending/chuyi_drink", file);
  me->start_no_move(5, "你现在正在酿造中。\n");
  if (userp(me))
    tell_object(me, HIR "【系统】酿造中请勿走动，否则酿造将失败。\n" NOR);
  call_out("finish_niang", 5, me);
  return 1;
}

int art(object me, string arg) {
  string *names, *can;
  int v, num, max, i;
  if (userp(me) && (int)me->query("gin") < 3)
    return notify_fail("你的活力不够。\n");
  if ((int)me->query_skill("chuyi", 1) < 15)
    return notify_fail("你的厨艺不够精深。\n");
  if (me->query_temp("art_drinking")) {
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "说道：我现在正在酿造中呢。\n" NOR, environment(me));
      return 0;
    } else return notify_fail("你现在正在酿造中。\n");
  }
  if (!arg) {
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "说道：你要酿造什么？\n" NOR, environment(me));
      return 0;
    } else return notify_fail("你要酿造什么？\n");
  }
  if (arg == "list") {
    arg = art_list(me);
    if (!userp(me)) {
      message("vision", arg, environment(me));
      return 1;
    } else {
      me->start_more(arg);
      return 1;
    }
  }

  names = keys(Niang);
  can = ({});
  for (i = 0; i < sizeof(names); i++) {
    if (!can_niang(me, names[i]))
      continue;
    can += ({ names[i] });
  }
  if (member_array(arg, can) == -1) {
    if (!userp(me)) {
      message("vision", CYN + me->name() + CYN "说道：我酿不出" + arg + "。\n" NOR, environment(me));
      return 0;
    } else return notify_fail("你没法酿造" + arg + "。\n");
  }
  notify_fail("酿造失败。\n");
  return do_niang(me, arg);
}
