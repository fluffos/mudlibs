#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	object weapon;
	string str;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<350 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_pkyuan") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「巨鸢破空」了。\n");
		else	return notify_fail("你已经施展了「破空鸢」了。\n");
	} 				

	if( objectp(weapon=me->query_temp("weapon")) )
		str = weapon->name(1);
	else	str = "双手";
	str = COLOR_D->clean_color(str);			
	message_vision(HIC"$N"HIC"将手一招，一道青气从背后闪现，凌空化作一只巨鸢，盘旋片刻，顿时没入$P"+str+"之中。\n"NOR,me);
	me->set_temp("XST_pkyuan",1);
	me->add("mana",-350);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：巨鸢破空
	神通效果：攻击命中+13%
HELP);
	else	write(@HELP
	神通名称：破空鸢	
	神通效果：攻击命中+2%
HELP);
	return 1;		
}
