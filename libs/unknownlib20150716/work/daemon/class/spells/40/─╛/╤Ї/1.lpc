#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  object weapon;
  string str;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_yaodun")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「妖盾沁体」了。\n");
    else return notify_fail("你已经施展了「妖盾」了。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")))
    str = weapon->name(1);
  else str = "双手";
  str = COLOR_D->clean_color(str);
  message_vision(
    HIG "$N" HIG "张口吐出一道青气，在胸前幻化成一面符文闪烁的盾形光幕，盘旋片刻在$P" + str + "上一扑，顿时$N" HIG + str + "青光大作。\n" NOR,
    me
  );
  me->set_temp("XST_yaodun", 1);
  me->add("mana", -200);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：妖盾沁体
	神通效果：使自身鞭、锏、拳、暗器、短兵类伤害+10%
HELP);
  else write(@HELP
	神通名称：妖盾	
	神通效果：使自身鞭、锏、拳、暗器、短兵类伤害+1%
HELP);
  return 1;
}
