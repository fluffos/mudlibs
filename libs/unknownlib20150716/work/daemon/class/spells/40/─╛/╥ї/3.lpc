#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	object weapon;
	string str;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_wuleixi") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「五雷袭顶」了。\n");
		else	return notify_fail("你已经施展了「五雷袭」了。\n");
	} 						

	if( objectp(weapon=me->query_temp("weapon")) )
		str = weapon->name(1);
	else	str = "双手";
	str = COLOR_D->clean_color(str);			
	message_vision(HIM"$N"HIM"念叨法咒，顿时电闪雷鸣，凌空降下一道紫电，没入$P"+str+HIM"之中。\n"NOR,me);
	me->set_temp("XST_wuleixi",1);
	me->add("mana",-300);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：五雷袭顶	
	神通效果：法术攻击伤害+10%
HELP);
	else	write(@HELP
	神通名称：五雷袭	
	神通效果：法术攻击伤害+1%
HELP);
	return 1;		
}
