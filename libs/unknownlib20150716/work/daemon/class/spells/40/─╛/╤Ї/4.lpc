#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me) {
  if (me) {
    if (me->query_temp("pfm_action") == "XST_LGBD"
      || me->query_temp("cast_action") == "XST_LGBD") {
      me->set_temp("XST_LGBD", time());
      me->delete_temp("pfm_action");
      message_vision("$N脸色青气渐渐淡去，弹指间的电弧渐渐化作虚影。\n", me);
    }
  }
}

int cast(object me, object target) {
  string msg;
  int t;

  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 300)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_LGBD") + 8)
    return notify_fail("你不能频繁调用天气元气。\n");
  if (me->query_temp("pfm_action") == "XST_LGBD"
    || me->query_temp("cast_action") == "XST_LGBD")
    return notify_fail("你已经施展了「雷光波动」。\n");

  if (!me->query_temp("weapon"))
    message_vision(HIG "$N" HIG "张口吐出一团青光闪烁的气团，悬空炸成一圈青色电弧，布于双掌之上。\n" NOR, me);
  else message_vision(
    HIG "$N" HIG "张口吐出一团青光闪烁的气团，悬空炸成一圈青色电弧，布于" + (me->query_temp("weapon"))->name(1) + HIG "之上。\n" NOR,
    me
  );
  t = 60;
  me->add("mana", -300);
  me->set_temp("XST_LGBD", time());
  me->set_temp("pfm_action", "XST_LGBD");
  me->set_temp("cast_action", "XST_LGBD");
  //me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), t);
  call_out("remove_effect", t, me);
  return 1;
}

void thunder_result(object me, object target, object weapon, int damage) {
  string msg, succ_msg;
  if (!me)
    return;
  if (!living(me)) {
    remove_effect(me);
    return;
  }

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return;

  if (random(target->query_skill("spells")) > me->query_skill("spells")
    || random(me->query("mana") / 10) < 10)
    return;

  if (target->query("family/family_name") == "南海普陀山"
    || target->query("family/family_name") == "月宫"
    || target->query("family/family_name") == "百花谷")
    return;

  me->add("mana", -25);
  msg = HIG "\n$N" HIG "面上青气一闪，$w" HIG "上闪出一道电弧，凌空啪啪作响，朝着$n" HIG "$l刺去！\n" NOR;
  succ_msg = ({
    "结果只是轻轻地刺破$p的皮肉。\n",
    "结果在$p$l刺出一个创口。\n",
    "结果「噗」地一声刺入了$n$l寸许！\n",
    "结果「噗」地一声刺进$n的$l，使$p不由自主地退了步！\n",
    "结果「噗嗤」地一声，电弧已在$p$l刺出一个血肉焦黑的血窟窿！\n",
    "结果只听见$n一声惨嚎，电光已在$p的$l对穿而出，传出一股恶臭！\n",
  })[random(6)];
  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 50);
  COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST_2,
    msg,
    succ_msg,
    0,
    0,
    "kee"
  );
  me->add_temp("apply/attack", -50);
}

int help(object me) {
  write(@HELP
	神通名称：雷光波动
	神通效果：使60秒内自身战斗中附带雷电攻击
		  冷却时间8秒	
		  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
