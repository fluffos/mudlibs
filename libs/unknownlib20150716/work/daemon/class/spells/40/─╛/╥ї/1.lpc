#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<200 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_fulei") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「飞雷护体」了。\n");
		else	return notify_fail("你已经施展了「浮雷」了。\n");
	} 							

	message_vision(HIG"$N"HIG"张口吐出一道青气，胸前顿时浮现一层电光闪烁雷网，在周身隐约盘旋。\n"NOR,me);
	me->set_temp("XST_fulei",1);
	me->add("mana",-200);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：飞雷护体	
	神通效果：鞭、锏、拳、暗器、短兵类伤害-5%
HELP);
	else	write(@HELP
	神通名称：浮雷	
	神通效果：鞭、锏、拳、暗器、短兵类伤害-1%
HELP);		
	return 1;		
}
