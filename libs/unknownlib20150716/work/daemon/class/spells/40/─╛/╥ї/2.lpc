#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<250 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_dqc") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「龙脉护体」了。\n");
		else	return notify_fail("你已经施展了「地泉冲」了。\n");
	} 					
	message_vision(HIG"$N"HIG"脸上青气一闪，跺了跺脚，顿时一道青色木气如涌泉般从脚下冒出，化作一道青幕将$P紧紧护住。\n"NOR,me);
	me->set_temp("XST_dqc",1);
	me->add("mana",-250);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：龙脉护体
	神通效果：鞭、锏、拳、暗器、短兵类伤害-7%
HELP);
	else	write(@HELP
	神通名称：地泉冲
	神通效果：鞭、锏、拳、暗器、短兵类伤害-3%
HELP);		
	return 1;		
}
