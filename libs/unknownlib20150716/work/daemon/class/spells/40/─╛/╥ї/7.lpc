#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage, i;
  string msg, succ_msg;
  object *enemy;

  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_tljd") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  me->clean_up_enemy();
  if (!me->is_fighting())
    return notify_fail("「天雷殛电」只能战斗中使用。\n");
  enemy = me->query_enemy();
  if (!intp(i = sizeof(enemy))
    || i < 1)
    return notify_fail("「天雷殛电」只能战斗中使用。\n");


  me->add("mana", -500);
  me->set_temp("XST_tljd", time());
  me->add_temp("apply/attack", 100);
  me->set_temp("pfm_msg", 1);

  msg = HIC "$N" HIC "念动咒决，将一指，半空立刻出现了一团丈许大小的乌云，云中”轰隆隆“阵阵雷鸣，一道道" HIW "闪电" HIC "掉落下来。\n" NOR;
  message_vision(msg, me);

  while (i--) {
    target = enemy[i];
    if (!target || !target->is_character()
      || target->is_corpse()
      || target == me
      || !me->is_fighting(target))
      continue;
    if (target->query("family/family_name") == "南海普陀山"
      || target->query("family/family_name") == "月宫"
      || target->query("family/family_name") == "百花谷")
      continue;
    msg = HIG "\n凌空一声霹雳，数道雷电闪烁电舌，对着$n" HIG "劈将下来。\n" NOR;
    succ_msg = HIR "结果$n" HIR "周身电弧闪烁，晃了一晃，吃了不小的亏。\n" NOR;
    if (me && me->query_level() >= 90 && me->query("shentong/90"))
      damage = 4000 + random(1001);
    else damage = 600 + random(300);
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      damage,
      "kee"
    );
    if (damage < 1)
      message_vision(HIC "$N" HIC "周身护身霞光震荡，却也挡住了这波攻击。\n" NOR, target);
    else target->apply_condition("thunder_poison", 10);
  }

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -100);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：天雷殛电
	神通效果：对区域内的敌人进行攻击
		  击中会使对方身中雷电之苦
                  冷却时间6秒
                  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
