#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 300)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_tujishi")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「袭石盘旋」。\n");
    else return notify_fail("你已经施展了「突袭石」。\n");
  }

  message_vision(HBRED HIY "$N" HBRED HIY "念了几句咒语，四下土气瞬间汇聚，化作数块怪石，在$P周围不时盘旋。\n" NOR, me);
  me->set_temp("XST_tujishi", 1);
  me->add("mana", -300);
  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    me->add_temp("apply/combat_def", 1000);
    me->add_temp("apply/spells_def", 1000);
    me->add_temp("apply/re_spells_effdamage", 15);
    me->add_temp("apply/re_combat_effdamage", 15);
    me->add_temp("apply/re_combat_damage", 15);
    me->add_temp("apply/re_spells_damage", 15);
  } else {
    me->add_temp("apply/combat_def", 100);
    me->add_temp("apply/spells_def", 100);
    me->add_temp("apply/re_spells_effdamage", 5);
    me->add_temp("apply/re_combat_effdamage", 5);
    me->add_temp("apply/re_combat_damage", 5);
    me->add_temp("apply/re_spells_damage", 5);
  }
  me->set_temp(
    "combat/re_damage_msg",
    HBRED HIY "$n" HBRED HIY "身前忽现一块尖石，一闪之间便朝$N" HBRED HIY "刺去！\n" NOR
  );
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：袭石盘旋
	神通效果：自身防御+1000,伤害反弹+15%
HELP);
  else write(@HELP
	神通名称：突袭石
	神通效果：自身防御+100,伤害反弹+5%
HELP);
  return 1;
}
