#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage, i;
  string msg, succ_msg;
  object *enemy;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_zhendijue") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");

  me->clean_up_enemy();
  if (!me->is_fighting()) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("「地龙翻身」只能战斗中使用。\n");
    else return notify_fail("「震地诀」只能战斗中使用。\n");
  }
  enemy = me->query_enemy();
  if (!intp(i = sizeof(enemy))
    || i < 1) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("「地龙翻身」只能战斗中使用。\n");
    else return notify_fail("「震地诀」只能战斗中使用。\n");
  }


  if (COMBAT_D->query_message_type(me, target) < 2)
    message_vision(
      BYEL + HIW "$N" BYEL + HIW "掐法咒一指地面，一道气波瞬间扩开，地表顿时发出“轰隆”之声，仿佛地龙翻身般，碎石翻滚，泥土裂口，朝四周扩散开去！\n" NOR,
      me
    );
  else {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      message_vision(BYEL + HIW "$N" BYEL + HIW "施展了「" HIR "地龙翻身" NOR BYEL + HIW "」。\n" NOR, me);
    else message_vision(BYEL + HIW "$N" BYEL + HIW "施展了「" HIR "震地诀" NOR BYEL + HIW "」。\n" NOR, me);
  }
  me->add("mana", -350);
  me->set_temp("XST_zhendijue", time());
  msg = "\n";
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  while (i--) {
    target = enemy[i];
    if (!target || !target->is_character()
      || target->is_corpse()
      || target == me
      || !me->is_fighting(target))
      continue;
    if (target->query("family/family_name") == "陷空山无底洞"
      || target->query("family/family_name") == "盘丝洞"
      || target->query("family/family_name") == "阎罗地府")
      continue;
    succ_msg = BYEL + HIW "$n" BYEL + HIW "脚下一个踉跄，脸色一白，看来时受了不小的伤。\n" NOR;
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      500,
      "kee"
    );
    if (damage < 1 || target->is_busy())
      ;
    else {
      if (me && me->query_level() >= 90 && me->query("shentong/90"))
        target->start_busy(4);
      else target->start_busy(2);
    }
  }

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：地龙翻身
	神通效果：对区域内所有敌方进行法术型气血攻击
		  并可能使之busy4秒
		  冷却时间7秒
		  对无底洞、盘丝洞、地府弟子无效 	
HELP);
  else write(@HELP
	神通名称：震地诀
	神通效果：对区域内所有敌方进行法术型气血攻击
		  并可能使之busy2秒
		  冷却时间7秒
		  对无底洞、盘丝洞、地府弟子无效 	
HELP);
  return 1;
}
