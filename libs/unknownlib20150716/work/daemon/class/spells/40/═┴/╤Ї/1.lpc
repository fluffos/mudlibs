#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<100 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_jushi")+8 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「炬石轰天」只能对战斗中的对手使用。\n");
		else	return notify_fail("「炬石」只能对战斗中的对手使用。\n");
	}	

	if( target->query("family/family_name")=="陷空山无底洞"
	 || target->query("family/family_name")=="盘丝洞"
	 || target->query("family/family_name")=="阎罗地府" )
	 	return notify_fail("这招对他没用。\n");
		
	me->add("mana",-100);
	me->set_temp("XST_jushi",time());
	me->add_temp("apply/attack",10);
	
	msg = HBYEL"$N"HBYEL"张口吐出一道黄气，凭空化作一块面盆大小的飞石，风驰电掣般砸向$n"HBYEL"！"NOR"\n";
	succ_msg = ({
		HBYEL"结果砸个正着，$n"HBYEL"闷哼一声显然吃了不小的亏！"NOR"\n",
        	HBYEL"结果「砰」地一声，$n"HBYEL"疼得连腰都弯了！"NOR"\n",
        	HBYEL"结果这一下「轰」地一声砸得$n"HBYEL"眼冒金星，差一点摔倒！"NOR"\n",
        	HBYEL"结果只听见「轰」地一声巨响，$n"HBYEL"被砸得血肉模糊，惨不忍睹！"NOR"\n",
	})[random(4)];
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,0,0,100,"kee");
	if( damage<1 )
		message_vision(HIC"$N"HIC"身随心动，飞快地闪开了。\n"NOR,target);
	else
	{	
		if( !target->is_no_move() )
			target->start_no_move(5,HBYEL"你被"+me->name()+HBYEL"震得双腿发麻，难以行动。"NOR"\n");	
		if( me && me->query_level()>=90 && me->query("shentong/90") 
		 && !target->is_busy() )
		 	target->start_busy(2);	
	}	
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-10);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：炬石轰天
	神通效果：对敌进行法术型气血攻击
	          并使其5秒内不能移动并busy2秒
                  冷却时间8秒 
                  对无底洞、盘丝洞、地府弟子无效 	
HELP);	
	else	write(@HELP
	神通名称：炬石
	神通效果：对敌进行法术型气血攻击
	          并使其5秒内不能移动
                  冷却时间8秒 
                  对无底洞、盘丝洞、地府弟子无效 	
HELP);	
	return 1;		
}
