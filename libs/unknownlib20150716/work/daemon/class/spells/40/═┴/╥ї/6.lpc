#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;

	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<350 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_DQLJ")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「地脉挛动」只能对战斗中的对手使用。\n");
		else	return notify_fail("「地泉列劲」只能对战斗中的对手使用。\n");
	}	        	
	
	if( target->query("family/family_name")=="陷空山无底洞"
	 || target->query("family/family_name")=="盘丝洞"
	 || target->query("family/family_name")=="阎罗地府" )
	 	return notify_fail("这招对他没用。\n");
	 		
	me->add("mana",-350);
	me->set_temp("XST_DQLJ",time());
	me->add_temp("apply/attack",90);
	me->set_temp("pfm_msg",1);

	if( me && me->query_level()>=90 && me->query("shentong/90") )
		damage = 3500;
	else	damage = 1000;
	msg = HIC"$N"HIC"一跺脚，地面顿时猛然晃动，现出一道裂口，从中冒出一道黄光，径直刺向$n"HIY"$l！\n"NOR;
	succ_msg = HIR"结果刺了个正着，$n"HIR"脸色一白，好似受伤不轻。\n"NOR;
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,0,damage,"kee");
	if( damage>0 && !target->is_busy() )
		target->start_busy(3);
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-90);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：地脉挛动	
	神通效果：对敌物理攻击 固定伤害3500
		  冷却时间6秒
		  对无底洞、盘丝洞、地府弟子无效 	
HELP);	
	else	write(@HELP
	神通名称：地泉列劲	
	神通效果：对敌物理攻击 固定伤害1000
		  冷却时间6秒
		  对无底洞、盘丝洞、地府弟子无效 	
HELP);	
	return 1;		
}
