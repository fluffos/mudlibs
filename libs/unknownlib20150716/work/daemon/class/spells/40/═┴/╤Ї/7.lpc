#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage,i;
	string msg,succ_msg;
	object *enemy;
	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_ddkx")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	me->clean_up_enemy();                
        if( !me->is_fighting() )
        	return notify_fail("「大地狂啸」只能战斗中使用。\n");
        enemy = me->query_enemy();
	if( !intp(i=sizeof(enemy)) 
	 || i<1 )
		return notify_fail("「大地狂啸」只能战斗中使用。\n");			
	
		
	me->add("mana",-500);
	me->set_temp("XST_ddkx",time());
	me->add_temp("apply/attack",100);
	me->set_temp("pfm_msg",1);
	
	msg = HIY"$N"HIY"面上黄气一闪，跃身半空，将手一指，一声巨响，地面一阵的剧烈晃动，随之一圈土黄色气浪仿佛波涛般的四下蔓延而去。\n"NOR;
	message_vision(msg,me);
	
	while(i--)
	{
		target = enemy[i];
		if( !target || !target->is_character()
         	  || target->is_corpse()
         	  || target==me
         	  || !me->is_fighting(target) )
			continue;
		if( target->query("family/family_name")=="陷空山无底洞"
		 || target->query("family/family_name")=="盘丝洞"
		 || target->query("family/family_name")=="阎罗地府" )
		 	continue;
		msg = "";
		succ_msg = HIB"\n$N"HIB"抵不住脚下的剧烈晃动，一个趔趄，栽倒在地。\n"NOR;
		if( me && me->query_level()>=90 && me->query("shentong/90") )
			damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,2500,"kee");
		else	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,700,"kee");
		if( damage<1 || target->is_no_move() )
			;
		else if( target )
		{
			target->start_no_move(10,HIR"你只觉脚下无力，难以行走。"NOR"\n");
			if( me && me->query_level()>=90 && me->query("shentong/90") 
			 && !target->is_busy() )
			 	target->start_busy(3);
		}	
	}
	
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-100);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：大地狂啸
	神通效果：对区域内的敌人进行攻击
		  击中会使对方10秒内暂时不能行动，busy 3 秒
                  冷却时间6秒
                  对无底洞、盘丝洞、地府弟子无效 
HELP);	
	else	write(@HELP
	神通名称：大地狂啸
	神通效果：对区域内的敌人进行攻击
		  击中会使对方10秒内暂时不能行动
                  冷却时间6秒
                  对无底洞、盘丝洞、地府弟子无效 
HELP);
	return 1;		
}
