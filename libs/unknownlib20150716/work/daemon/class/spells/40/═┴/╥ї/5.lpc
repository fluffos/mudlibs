#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg;

  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_LDren") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target)) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("「裂地巨刃」只能对战斗中的对手使用。\n");
    else return notify_fail("「裂地刃」只能对战斗中的对手使用。\n");
  }

  if (target->query("family/family_name") == "陷空山无底洞"
    || target->query("family/family_name") == "盘丝洞"
    || target->query("family/family_name") == "阎罗地府")
    return notify_fail("这招对他没用。\n");

  me->add("mana", -350);
  me->set_temp("XST_LDren", time());
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 2500;
  else damage = 850;
  msg = HIY "$N" HIY "吐出一道黄光，迎风一涨，化作一道土黄色的半月巨刃，盘旋着飞向$n" HIY "。\n" NOR;
  succ_msg = HIR "血光一溅，$n" HIR "连连踉跄后退。\n" NOR;
  COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：裂地巨刃
	神通效果：对敌法术攻击 固定伤害2500
		  冷却时间7秒	
		  对无底洞、盘丝洞、地府弟子无效 
HELP);
  else write(@HELP
	神通名称：裂地刃
	神通效果：对敌法术攻击 固定伤害850
		  冷却时间7秒	
		  对无底洞、盘丝洞、地府弟子无效 
HELP);
  return 1;
}
