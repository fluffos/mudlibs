#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me)
{
	if( me 
	 && (me->query_temp("pfm_action")=="XST_JSzhui"||me->query_temp("cast_action")=="XST_JSzhui") )
	{
		me->set_temp("XST_JSzhui",time());
		me->delete_temp("pfm_action");
		me->delete_temp("cast_action");
		message_vision("$N脸色黄气渐渐淡去，头顶的黄云迎风一晃，化作虚无。\n",me);
	}
}

int cast(object me, object target)
{	
	string msg;
	int t;
	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_JSzhui")+7 )
		return notify_fail("你不能频繁调用天气元气。\n");
	if( me->query_temp("pfm_action")=="XST_JSzhui" 
	 || me->query_temp("cast_action")=="XST_JSzhui" )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「九霄石箭」。\n");
		else	return notify_fail("你已经施展了「箭石坠」。\n");
	}	 

	message_vision(HIY"$N"HIY"张口吐出一团闪烁霞光的黄色气团，在半空斗然炸开，化作半亩大小的黄云悬浮头顶，其内不时传来轰鸣之声。\n"NOR,me);
	
	t = 60;
	me->add("mana",-300);
	me->set_temp("XST_JSzhui",time());
	me->set_temp("pfm_action","XST_JSzhui");
	me->set_temp("cast_action","XST_JSzhui");
	//me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), t);
	call_out("remove_effect",t,me);
	return 1;				
}

void stone_result(object me,object target,object weapon,int damage)
{       
	string msg,succ_msg;	 
        if( !me ) 
                return;
	if( !living(me) )
	{
		remove_effect(me);
		return;
	}	

	if( !target )  target = offensive_target(me);
	if( !target
 	 || !target->is_character()
 	 || target->is_corpse()
 	 || target==me 
 	 || !me->is_fighting(target) )
		return; 

	if( target->query("family/family_name")=="陷空山无底洞"
	 || target->query("family/family_name")=="盘丝洞"
	 || target->query("family/family_name")=="阎罗地府" )
	 	return;
	if( random(target->query_skill("spells"))>me->query_skill("spells") 
	 || random(me->query("mana")/10)<10 )
		return;
	
	me->add("mana",-25);
	msg = HBYEL"\n半空黄云翻滚，一支半臂长短的石箭竞相冲出，铺天盖地地射向$n"HBYEL"！"NOR"\n";
	succ_msg = HIR"结果$n"HIR"浑身顿时出现了数道一指宽的血痕，闷哼一声，不迭后退。\n"NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",30);
	me->delete_temp("pfm_color");
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage/3+1,"kee");
	else	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg,0,0,"kee");
	me->add_temp("apply/attack",-30);
}


int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )	 
		write(@HELP
	神通名称：九霄石箭
	神通效果：使60秒内自身战斗中附带箭石攻击
                  冷却时间7秒 
                  对无底洞、盘丝洞、地府弟子无效  	
HELP);	
	else	write(@HELP
	神通名称：箭石坠
	神通效果：使60秒内自身战斗中附带箭石攻击
                  冷却时间7秒 
                  对无底洞、盘丝洞、地府弟子无效  	
HELP);		
	return 1;		
}
