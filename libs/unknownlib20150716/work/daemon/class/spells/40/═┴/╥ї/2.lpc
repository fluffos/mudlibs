#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 250)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_JMB")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「护身石坝」。\n");
    else return notify_fail("你已经施展了「绝命坝」。\n");
  }

  message_vision(
    HIC "$N" HIC "念了几句咒语，四下" NOR YEL "土石之气" NOR HIC "瞬间汇聚，化作一道透明的" NOR YEL "土墙" NOR HIC "，护住周身。\n" NOR,
    me
  );
  me->set_temp("XST_JMB", 1);
  me->add("mana", -250);
  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    me->add_temp("apply/combat_def", 1200);
    me->add_temp("apply/spells_def", 1200);
  } else {
    me->add_temp("apply/combat_def", 300);
    me->add_temp("apply/spells_def", 300);
  }
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：护身石坝
	神通效果：自身防御+1200
HELP);
  else write(@HELP
	神通名称：绝命坝
	神通效果：自身防御+300
HELP);
  return 1;
}
