#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	object weapon;
	int damage;
	string msg,succ_msg,str;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<150 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_tushijian")+7 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「石剑棘突」只能对战斗中的对手使用。\n");
		else	return notify_fail("「突石剑」只能对战斗中的对手使用。\n");
	}
	
	if( target->query("family/family_name")=="陷空山无底洞"
	 || target->query("family/family_name")=="盘丝洞"
	 || target->query("family/family_name")=="阎罗地府" )
	 	return notify_fail("这招对他没用。\n");
	 			
	me->add("mana",-150);
	me->set_temp("XST_tushijian",time());
	me->add_temp("apply/attack",10);
	
	if( objectp(weapon=me->query_temp("weapon")) )
		str = weapon->name(1);
	else	str = "双手";
	str = COLOR_D->clean_color(str);	
	
	msg = HBYEL"$N"HBYEL+str+"之上黄气大作，凭空化作一把七尺长短的石剑，即如闪电般直刺$n"HBYEL"$l！"NOR"\n";
	succ_msg = ({
        	HBYEL"结果「噗」地一声刺进$n"HBYEL"的$l，使$p不由自主地退了步！"NOR"\n",
        	HBYEL"结果「噗嗤」地一声，石剑已在$p$l刺出一个血肉模糊的血窟窿！"NOR"\n",
        	HBYEL"结果只听见$n"HBYEL"一声惨嚎，石剑已在$p的$l对穿而出，鲜血溅得满地！"NOR"\n",
	})[random(3)];
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,0,0,300,"kee");
	if( damage<1 )
		message_vision(HIC"$N"HIC"身随心动，连忙纵身闪开。\n"NOR,target);
	else
	{	
		if( !target->is_no_move() )
			target->start_no_move(5,HBYEL"你被"+me->name()+HBYEL"的驱石术震得双腿发麻，难以行动。"NOR"\n");	
		if( me && me->query_level()>=90 && me->query("shentong/90") 
		 && !target->is_busy() )
		 	target->start_busy(3);	
	}		
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-10);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：石剑棘突
	神通效果：对敌进行法术型气血攻击
	          并使其5秒内不能移动，并busy3秒
                  冷却时间7秒  	
                  对无底洞、盘丝洞、地府弟子无效
HELP);
	else	write(@HELP
	神通名称：突石剑
	神通效果：对敌进行法术型气血攻击
	          并使其5秒内不能移动
                  冷却时间7秒  	
                  对无底洞、盘丝洞、地府弟子无效
HELP);
	return 1;		
}
