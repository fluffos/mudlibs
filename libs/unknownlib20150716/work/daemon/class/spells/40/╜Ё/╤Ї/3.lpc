#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 300)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_sifang") + 8)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「突剑四方」只能对战斗中的对手使用。\n");
  damage = random(me->query("mana_factor") / 10);
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 1500;
  else {
    if (damage < 100)
      damage = 100;
    if (damage > 300)
      damage = 300;
  }
  message_vision(HIY "$N" HIY "口中喃喃念叨了几句咒语，只见四周顿时元气暗涌，瞬间凝成了无数柄金色小剑。\n" NOR, me);
  if (target->query("family/family") == "蜀山派"
    || target->query("family/family") == "将军府"
    || target->query("family/family") == "方寸山三星洞")
    message_vision(HIC "$N" HIC "熟视无睹。\n" NOR, target);
  else {
    me->add("mana", -300);
    me->set_temp("XST_sifang", time());
    msg = HIY "金光一闪，一柄金色小剑在半空一闪，瞬间已至$n" HIY "面前，朝$p$l直刺而去！\n" NOR;
    me->add_temp("apply/attack", 60);
    me->set_temp("pfm_msg", 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_CAST, msg, 0, 0, damage, "kee");
    if (me->query_level() >= 45)
      COMBAT_D->do_attack(
        me,
        target,
        me->query_temp("weapon"),
        TYPE_CAST,
        msg,
        0,
        0,
        damage,
        "kee"
      );
    if (me->query_level() >= 50)
      COMBAT_D->do_attack(
        me,
        target,
        me->query_temp("weapon"),
        TYPE_CAST,
        msg,
        0,
        0,
        damage,
        "kee"
      );
    if (me->query_level() >= 55)
      COMBAT_D->do_attack(
        me,
        target,
        me->query_temp("weapon"),
        TYPE_CAST,
        msg,
        0,
        0,
        damage,
        "kee"
      );
  }
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -60);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：突剑四方
	神通效果：对敌进行法术型气血攻击
                  40级后每5级增加一击，最高4击  
                  冷却时间8秒  	
                  对蜀山、将军府、方寸山弟子无效
HELP);
  return 1;
}
