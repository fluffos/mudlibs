#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage, max;
  string msg, succ_msg;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 450)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_riyue") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「日月轮斩」只能对战斗中的对手使用。\n");

  if (target->query("family/family") == "蜀山派"
    || target->query("family/family") == "将军府"
    || target->query("family/family") == "方寸山三星洞")
    return notify_fail("对方不吃这一套。\n");
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    max = 3000;
  else max = 1000;
  me->add("mana", -450);
  me->set_temp("XST_riyue", time());
  me->add_temp("apply/attack", 90);
  me->set_temp("pfm_msg", 1);

  msg = HIC "$N" HIC "将手一招，" HIY "金光" HIC "一闪，顿时手中现出一面光轮，其上符文闪烁，绽放出万道" HIY "金光" HIC "，仿佛烈阳一般！\n" HIY "光轮" HIC "一闪，阵阵破空之声中已在$n" HIC "周身盘旋，朝着$l狠狠砸去！\n" NOR;
  succ_msg = HIC "$n" HIC "脸色一" HIW "白" HIC "，脚下踉跄了几步，方才站稳。\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_QUICK,
    msg,
    succ_msg,
    0,
    0,
    "kee"
  );
  if (damage < 1) {
    message_vision(HIC "$N" HIC "脚下霞光浮动，人影一闪，光轮擦身而过。\n" NOR, target);
    if (me && me->query_level() >= 90 && me->query("shentong/90"))
      max = 3000;
    else max = 1000;
  } else max = max - damage;
  if (max < 1)
    max = 1;

  msg = HIG "\n$N" HIG "冷冷一笑，将手再一招，又是一道" HIC "光轮" HIG "浮现，其上冷光氤氲，直入人心脾。\n$N" HIG "喃喃念咒，" HIC "光轮" HIG "在半空一个翻腾，顿时霞光绽放，一道青光直射$n" HIG "$l！\n" NOR;
  succ_msg = HIR "$n" HIG "闪避不及，被青光照出，顿时$l处显出一道焦痕，发出一声闷哼。\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    max,
    "kee"
  );
  if (damage < 1)
    message_vision(HIC "$N" HIC "知道此招厉害，连忙堪堪闪过。\n" NOR, target);

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -90);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：日月轮斩
	神通效果：对敌进行两次攻击
		  最低固定伤害3000
                  冷却时间6秒
                  对蜀山、将军府、方寸山弟子无效
HELP);
  else write(@HELP
	神通名称：日月轮斩
	神通效果：对敌进行两次攻击
		  最低固定伤害1000
                  冷却时间6秒
                  对蜀山、将军府、方寸山弟子无效
HELP);
  return 1;
}
