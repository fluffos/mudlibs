#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_huazhan") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「五狱华斩」只能对战斗中的对手使用。\n");

  if (target->query("family/family") == "蜀山派"
    || target->query("family/family") == "将军府"
    || target->query("family/family") == "方寸山三星洞")
    return notify_fail("对方不吃这一套。\n");

  damage = random(me->query("mana_factor"));
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 4000;
  else {
    if (damage < 800)
      damage = 800;
    if (damage > 2000)
      damage = 2000;
  }
  me->add("mana", -400);
  me->set_temp("XST_huazhan", time());
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  msg = HIY "$N" HIY "以手指天，口中念叨真言，顿时天地之色骤变，宛若金戈海洋。眨眼间聚变作一巨大长刃，向下狠狠一劈，风起云涌间一道巨刃在$n" HIY "$l一闪而没！\n" NOR;
  succ_msg = HIR "$n" HIR "$l处顿时血花飞溅，一声闷哼中，$p脸色一白，看来伤势不轻。\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );
  if (damage < 1) {
    message_vision(HIC "$n" HIC "对之置若罔闻，胸前霞光一闪，光刃顿时间化作碎影消失在天地之间。\n" NOR, me, target);
    me->add_temp("XST_huazhan", 6);
  }
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：五狱华斩
	神通效果：对敌进行法术型气血攻击
		  最低固定伤害800
                  冷却时间6秒，不中加倍 
                  对蜀山、将军府、方寸山弟子无效 	
HELP);
  else write(@HELP
	神通名称：五狱华斩
	神通效果：对敌进行法术型气血攻击
		  最低固定伤害4000
                  冷却时间6秒，不中加倍 
                  对蜀山、将军府、方寸山弟子无效 	
HELP);
  return 1;
}
