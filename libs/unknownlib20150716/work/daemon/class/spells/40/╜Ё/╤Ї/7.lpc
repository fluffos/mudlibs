#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_tiandi")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
		return notify_fail("「天地无用」只能对战斗中的对手使用。\n");

	if( target->query("family/family")=="蜀山派"
	 || target->query("family/family")=="将军府"
	 || target->query("family/family")=="方寸山三星洞" )
		return notify_fail("对方不吃这一套。\n");	
		
	me->add("mana",-500);
	me->set_temp("XST_tiandi",time());
	me->add_temp("apply/attack",100);
	me->set_temp("pfm_msg",1);
	
	msg = HIY"$N"HIY"牵引天地金元之气，顿时半空中诸多异象。$N"HIY"背后阵纹转动，蓬发出耀眼的金光，宛如神灵！\n"NOR;
	message_vision(msg,me);
	msg = HIY"$N"HIY"右手往上一抬，顿时地动山摇，只见$n"HIY"脚下金光绽放，一道法阵在光圈中运转，轰鸣声中一座巨山虚像冉冉升起，出现在$n"HIY"脚下！\n"NOR;
	succ_msg = HIY"“轰”的一声，山石崩塌，金光四溢，虚像陡然炸开，道道金光将$n"HIY"刺得鲜血淋漓！\n"NOR;
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,2500,"kee");
	else	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,800,"kee");
	if( damage<1 )
		message_vision(HIC"$N"HIC"嘿嘿一声，将脚一顿，虚影顿时仿若镜中水月，一闪而没。\n"NOR,target);
	
	msg = HIY"\n$N"HIY"右手顺势向下一压，一只巨大的金手顿时出现在半空，铺天盖地压向$n"HIY"！\n"NOR;
	succ_msg = HIY"$n"HIY"避无可避，被巨手压住，“轰”的一声，顿时一阵萎靡！\n"NOR;
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,3500,"kee");
	else	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,1200,"kee");
	if( damage<1 )
		message_vision(HIC"$N"HIC"周身霞光闪烁，熟视无睹，这一招对其没有任何作用。\n"NOR,target);
	
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-100);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：天地无用
	神通效果：对敌方各进行两次攻击
		  固定伤害6000
                  冷却时间6秒
                  对蜀山、将军府、方寸山弟子无效
HELP);	
	else	write(@HELP
	神通名称：天地无用
	神通效果：对敌方各进行两次攻击
		  固定伤害2000
                  冷却时间6秒
                  对蜀山、将军府、方寸山弟子无效
HELP);		
	return 1;		
}
