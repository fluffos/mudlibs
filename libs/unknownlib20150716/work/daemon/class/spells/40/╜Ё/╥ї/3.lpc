#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_bamen") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「奇门遁甲」了。\n");
		else	return notify_fail("你已经施展了「八门金锁」了。\n");
	} 	

	message_vision(HIC"$N"HIC"脸上"HIY"金色"HIC"一闪，瞬间周身金气肉眼可见地猛的一缩，又骤然绽开，凌空化成八面"HIY"金锁"HIC"护住其周身要害。\n"NOR,me);
	me->set_temp("XST_bamen",1);
	if( me && me->query_level()>=90 && me->query("shentong/90") )
	{
		me->add_temp("apply/re_spells_effdamage",10);
		me->add_temp("apply/re_combat_effdamage",10);
		me->add_temp("apply/re_spells_damage",10);
		me->add_temp("apply/re_combat_damage",10);		
	}
	else
	{
		me->add_temp("apply/re_spells_effdamage",5);
		me->add_temp("apply/re_combat_effdamage",5);
		me->add_temp("apply/re_spells_damage",5);
		me->add_temp("apply/re_combat_damage",5);
	}
	me->set_temp("combat/re_damage_msg",HIY"$n"HIY"$l处隐现一面金锁，一阵波纹荡漾，将伤害反弹了部分回去！\n"NOR);
	me->add("mana",-300);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：奇门遁甲
	神通效果：伤害反弹+10%
HELP);	
	else	write(@HELP
	神通名称：八门金锁
	神通效果：伤害反弹+5%
HELP);		
	return 1;		
}
