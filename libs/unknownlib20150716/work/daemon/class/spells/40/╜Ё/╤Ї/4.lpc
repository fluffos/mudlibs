#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage,i;
	string msg,succ_msg;
	object *enemy;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<350 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_luanwu")+7 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	me->clean_up_enemy();                
        if( !me->is_fighting() )
        	return notify_fail("「乱刃狂舞」只能战斗中使用。\n");
        enemy = me->query_enemy();
	if( !intp(i=sizeof(enemy)) 
	 || i<1 )
		return notify_fail("「乱刃狂舞」只能战斗中使用。\n");
			
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
		return notify_fail("「乱刃狂舞」只能对战斗中的对手使用。\n");
	damage = random(me->query("mana_factor")/5);
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		damage = 2500;
	else
	{	
		if( damage<300 )
			damage = 300;
		if( damage>2000 )
			damage = 2000;
	}		
	message_vision(HIY"$N"HIY"口中喃喃念叨了几句咒语，只见四周顿时元气暗涌，瞬间凝成一把宽约丈许的巨剑。\n"NOR,me);
	me->add("mana",-350);
	me->set_temp("XST_luanwu",time());
	msg = HIC"剑光一闪，一道剑锋径直划向$n"HIC"$l！\n"NOR;
	me->add_temp("apply/attack",70);
	me->set_temp("pfm_msg",1);
	
	while(i--)
	{
		target = enemy[i];
		if( !target || !target->is_character()
         	  || target->is_corpse()
         	  || target==me
         	  || !me->is_fighting(target) )
			continue;
		if( target->query("family/family")=="蜀山派"
		 || target->query("family/family")=="将军府"
		 || target->query("family/family")=="方寸山三星洞" )
			continue;
			
		succ_msg = ({
			HIR"结果「噗嗤」一声劈出一道血淋淋的伤口！\n"NOR,
        		HIR"结果只听「噗」地一声，$n"HIR"的$l被劈得血如泉涌，痛得$p咬牙切齿！\n"NOR,
        		HIR"结果「噗」地一声砍出一道又长又深的伤口，溅得$N"HIR"满脸鲜血！\n"NOR,
        		HIR"结果只听见$n"HIR"一声惨嚎，$p的$l被劈开一道深及见骨的可怕伤口！\n"NOR,
		})[random(4)];
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
	}

	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-70);
	return 1;				
}

int help(object me)
{
	write(@HELP
	神通名称：乱刃狂舞
	神通效果：对区域内所有敌方进行法术型气血攻击
		  冷却时间7秒
		  对蜀山、将军府、方寸山弟子无效	
HELP);		
	return 1;		
}
