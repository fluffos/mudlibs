#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_shenjian")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「灵剑附体」了。\n");
    else return notify_fail("你已经施展了「神剑」了。\n");
  }

  message_vision(HIY "$N" HIY "口中喃喃念叨了几句咒语，只见四周顿时元气暗涌，瞬间凝成了一把丈许长的金色巨剑，在$P背后一闪而没！\n" NOR, me);
  me->set_temp("XST_shenjian", 1);
  me->add("mana", -200);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：灵剑附体
	神通效果：使自身剑技、刀技伤害增加10%
HELP);
  else write(@HELP
	神通名称：神剑
	神通效果：使自身剑技、刀技伤害增加1%
HELP);
  return 1;
}
