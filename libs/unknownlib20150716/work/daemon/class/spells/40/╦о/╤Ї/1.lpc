#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_xuandeng")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「上古寒灯」了。\n");
    else return notify_fail("你已经施展了「旋灯」了。\n");
  }
  message_vision(HIW "$N" HIW "念动咒语，背后隐现一道巨涛虚像，从中冲出数道浪波，滴溜溜转了几转，化作数个带着寒气的古灯，围绕着$P不停打转。\n" NOR, me);
  me->set_temp("XST_xuandeng", 1);
  me->add("mana", -200);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：上古寒灯	
	神通效果：使自身叉、锤、拳脚、内功伤害+10%
HELP);
  else write(@HELP
	神通名称：旋灯	
	神通效果：使自身叉、锤、拳脚、内功伤害+1%
HELP);
  return 1;
}
