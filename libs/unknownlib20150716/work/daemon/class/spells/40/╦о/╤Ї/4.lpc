#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  object weapon;
  string str;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_shuiyuezhan")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「水月镜心」了。\n");
    else return notify_fail("你已经施展了「水月斩」了。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")))
    str = weapon->name(1);
  else str = "双手";
  str = COLOR_D->clean_color(str);
  message_vision(HIW "$N" HIW "目中白光一闪，凭空化作一面晶莹剔透的水镜，圆月大小，旋转片刻即时在$P" + str + "上一闪而没。\n" NOR, me);
  me->set_temp("XST_shuiyuezhan", 1);
  me->add("mana", -350);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：水月镜心	
	神通效果：物理攻击伤害增加800
HELP);
  else write(@HELP
	神通名称：水月斩	
	神通效果：物理攻击伤害增加300
HELP);
  return 1;
}
