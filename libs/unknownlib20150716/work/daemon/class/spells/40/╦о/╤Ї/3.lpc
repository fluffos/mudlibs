#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int i,ap,dp;
	string msg,succ_msg;
	object *enemy;
	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_lianhb")+8 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	me->clean_up_enemy();                
        if( !me->is_fighting() )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「爆破莲华」只能战斗中使用。\n");
		else	return notify_fail("「莲华爆」只能战斗中使用。\n");
	}        

        enemy = me->query_enemy();
	if( !intp(i=sizeof(enemy)) 
	 || i<1 )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「爆破莲华」只能战斗中使用。\n");
		else	return notify_fail("「莲华爆」只能战斗中使用。\n");
	} 
	
	me->add("mana",-300);
	me->set_temp("XST_lianhb",time());

	msg = HIW"$N"HIW"口中念咒，胸前一指，凭空现出一朵冰花，在半空滴溜溜转了几转，骤然炸开，化作点点寒星落了下来！\n"NOR;
	message_vision(msg,me);
	
	while(i--)
	{
		target = enemy[i];
		if( !target || !target->is_character()
         	  || target->is_corpse()
         	  || target==me
         	  || !me->is_fighting(target) )
			continue;
		else if( target->query("family/family_name")=="大雪山" )
		{
			message_combatd(HIC"$N"HIC"如鱼得水。\n"NOR,target);
			continue;
		}
		else if( target->query("family/family_name")=="东海龙宫" )
		{
			message_combatd(HIG"$N"HIG"背后现出一条巨浪，将寒星卷入了其中。\n"NOR,target);
			continue;
		}
		else if( target->is_busy() )
			continue;		
		
		succ_msg = ({
 			HIC"结果$n"HIC"体表冒出丝丝寒气，顿时动弹不得。\n"NOR,
        		HIC"结果$n"HIC"气息一窒，显然有点动作不畅！\n"NOR,
		})[random(2)];

		message_vision(succ_msg,me,target);
		if( me && me->query_level()>=90 && me->query("shentong/90") )
			target->start_busy(5);
		else	target->start_busy(2);
	}
	
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：爆破莲华
	神通效果：使区域内的敌人busy5秒
                  冷却时间8秒
                  对龙宫、大雪山弟子无效
HELP);		
	else	write(@HELP
	神通名称：莲华爆
	神通效果：使区域内的敌人busy2秒
                  冷却时间8秒
                  对龙宫、大雪山弟子无效
HELP);	
	return 1;		
}
