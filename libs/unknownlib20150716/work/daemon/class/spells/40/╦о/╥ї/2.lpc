#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<250 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_lianhua") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「护体莲华」了。\n");
		else	return notify_fail("你已经施展了「莲华」了。\n");
	}	

	message_vision(HIW"$N"HIW"念动咒语，四周顿时水气弥盛，眨眼间变聚成一朵霞光闪闪的莲花，在$N"HIW"背后时隐时现，一开一合。\n"NOR,me);
	me->set_temp("XST_lianhua",1);
	me->add("mana",-250);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：护体莲华
	神通效果：叉、锤、拳脚、内功伤害-7%
HELP);
	else	write(@HELP
	神通名称：莲华
	神通效果：叉、锤、拳脚、内功伤害-3%
HELP);		
	return 1;		
}
