#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<200 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_diquan") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「地脉护体」了。\n");
		else	return notify_fail("你已经施展了「地泉」了。\n");
	}	
	message_vision(HIC"$N"HIC"一顿足，脚下顿时冒起一股泉水，凭空化作一道青气，钻入$P体内不见了。\n"NOR,me);
	me->set_temp("XST_diquan",1);
	me->add("mana",-200);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：地脉护体	
	神通效果：叉、锤、拳脚、内功伤害-5%
HELP);
	else	write(@HELP
	神通名称：地泉
	神通效果：叉、锤、拳脚、内功伤害-1%
HELP);		
	return 1;		
}
