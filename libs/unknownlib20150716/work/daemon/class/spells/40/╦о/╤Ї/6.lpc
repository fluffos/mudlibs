#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage,i;
	string msg,succ_msg;
	object *enemy;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<450 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_bzqf")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	me->clean_up_enemy();                
        if( !me->is_fighting() )
        	return notify_fail("「冰柱群峰」只能战斗中使用。\n");
        enemy = me->query_enemy();
	if( !intp(i=sizeof(enemy)) 
	 || i<1 )
		return notify_fail("「冰柱群峰」只能战斗中使用。\n");
			
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
		return notify_fail("「冰柱群峰」只能对战斗中的对手使用。\n");
	damage = random(me->query("mana_factor")/5)+300;
	if( damage>1000 )
		damage = 1000;
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		damage = damage*2+random(damage);	
	if( COMBAT_D->query_message_type(me,target)<2 )	
		message_vision(HIW"$N"HIW"口念法咒，将手一指，半空骤然”轰鸣“大作。一座巨大的冰柱带着丝丝寒气从虚空直坠而下，距地三尺离奇的消失，猛然间方圆数丈之内寒气刺骨，宛如冰雪世界，一道道闪着狰狞寒光的冰峰从地下冒出，个个锋利无比！\n"NOR,me);
	else	message_vision(HIW"$N"HIW"施展了「"HIR"冰柱群峰"HIW"」。\n"NOR,me);
	me->add("mana",-450);
	me->set_temp("XST_bzqf",time());
	msg = "\n";
	me->add_temp("apply/attack",90);
	me->set_temp("pfm_msg",1);
	
	while(i--)
	{
		target = enemy[i];
		if( !target || !target->is_character()
         	  || target->is_corpse()
         	  || target==me
         	  || !me->is_fighting(target) )
			continue;
		if( target->query("family/family_name")=="大雪山"
		 || target->query("family/family_name")=="东海龙宫" )
		 	continue;
		succ_msg = ({
        		WHT"结果「噗」地一声扎进$n"WHT"的$l，使$p不由自主地退了步！\n"NOR,
        		WHT"结果「噗嗤」地一声，已在$n"WHT"$l扎出一个血肉模糊的血窟窿！\n"NOR,
        		WHT"结果只听见$n"WHT"一声惨嚎，已在$p的$l对穿而出，鲜血溅得满地！\n"NOR,
		})[random(3)];
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,0,damage);
	}

	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-90);
	return 1;				
}

int help(object me)
{
	write(@HELP
	神通名称：冰柱群峰
	神通效果：对区域内所有敌方进行物理攻击
		  冷却时间6秒
		  对龙宫、大雪山弟子无效	
HELP);		
	return 1;		
}
