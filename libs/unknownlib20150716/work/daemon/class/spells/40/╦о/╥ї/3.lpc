#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{
	int pp;	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_mingliao")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
	if( me->query("kee")>=me->query("eff_kee")
	 && me->query("eff_kee")>=me->query_maxkee() 
	 && me->query("sen")>=me->query("eff_sen")
	 && me->query("eff_sen")>=me->query_maxsen() )
	 	return notify_fail("没有这个必要。\n");
	
	message_vision(HIC"$N"HIC"口中念叨了几句咒语，立刻四周的水气以惊人的速度聚集过来，化作点点霞光没入$P的头顶。\n"NOR"$N脸色越来越红润。\n",me);
	me->set_temp("XST_mingliao",time());
	me->add("mana",-300);
	
	if( me && me->query_level()>=90 && me->query("shentong/90") )
	{
		pp = me->query_maxkee()/2+1;
		if( pp<5000 )
			pp = 5000;
	}
	else
	{
		pp = me->query_maxkee()*3/10+1;
		if( pp<1000 )
			pp = 1000; 			
	}		
	me->receive_curing("kee",pp);
	me->receive_heal("kee",pp);
	
	if( me && me->query_level()>=90 && me->query("shentong/90") )
	{
		pp = me->query_maxsen()/2+1; 			
		if( pp<5000 )
			pp = 5000; 
	}
	else
	{
		pp = me->query_maxsen()*3/10+1; 			
		if( pp<1000 )
			pp = 1000; 			
	}		
	me->receive_curing("sen",pp);
	me->receive_heal("sen",pp);
	
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：五气朝元
	神通效果：恢复并治疗自身50%(至少5000点)的气血、精神
		  冷却8秒
HELP);	
	else	write(@HELP
	神通名称：命疗术
	神通效果：恢复并治疗自身30%(至少1000点)的气血、精神
		  冷却8秒
HELP);		
	return 1;		
}
