#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<450 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_xuandengjian")+7 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「炎剑弑敌」只能对战斗中的对手使用。\n");
		else	return notify_fail("「旋灯剑」只能对战斗中的对手使用。\n");
	}	

	damage = random(me->query("mana_factor"));
	
	if( me->query_level()>=90 && me->query("shentong/90") )
	{
		if( damage<3000 )
			damage = 3000;
		if( damage>8000 )
			damage = 8000;		
	}
	else
	{
		if( damage<1000 )
			damage = 1000;
		if( damage>2000 )
			damage = 2000;
	}	
	damage = damage/2+random(damage/2);		
	me->add("mana",-450);
	me->set_temp("XST_xuandengjian",time());
	me->add_temp("apply/attack",80);
	me->set_temp("pfm_msg",1);
	
	msg = HIR"$N"HIR"一甩衣袖，一串火焰凭空现出，在半空红光一闪，化作一把烈焰四溢的"NOR RED"炎剑"NOR HIR"，剑身上不停盘旋星点火舌。\n"NOR;
	message_vision(msg,me);
	
	if( target->query("family/family_name")=="火云洞"
	 || target->query("family/family_name")=="五庄观" )
		message_vision(HIC"$n"HIC"对之置若罔闻。\n"NOR,me,target);
	else
	{		
		msg = HIR"$N"HIR"一指$n"HIR"，”咄“一声，"NOR RED"炎剑"NOR HIR"上红光大盛，恶狠狠朝$n"HIR"劈去！\n"NOR;
		succ_msg = HIR"$n"HIR"$l处顿时青烟一冒，一股焦臭传出。\n"NOR;
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
		if( damage<1 )
			message_vision(HIC"$n"HIC"对之置若罔闻，胸前霞光一闪，光刃顿时间化作碎影消失在天地之间。\n"NOR,me,target);
		else	target->apply_condition("fire2_poison",3);
	}	
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-80);
	return 1;				
}

int help(object me)
{
	if( me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：炎剑弑敌	
	神通效果：召唤炎剑攻击对方，并可能使对方身中火毒
		  冷却7秒
		  对火云洞、五庄观弟子无效
HELP);	
	else	write(@HELP
	神通名称：旋灯剑	
	神通效果：召唤炎剑攻击对方，并可能使对方身中火毒
		  冷却7秒
		  对火云洞、五庄观弟子无效
HELP);	
	return 1;		
}
