#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<350 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_jihuozhu") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「焰柱冲天」了。\n");
		else	return notify_fail("你已经施展了「集火柱」了。\n");
	}	
	message_vision(HIR"$N"HIR"将手一招，一道炽热的火柱冲天而起，红光一闪，$N"HIR"顿时攻势逼人。\n"NOR,me);
	me->set_temp("XST_jihuozhu",1);
	me->add("mana",-350);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：焰柱冲天	
	神通效果：自身固定伤害增加800点
HELP);		
	else	write(@HELP
	神通名称：集火柱	
	神通效果：自身固定伤害增加300点
HELP);
	return 1;		
}
