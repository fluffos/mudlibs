#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<300 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_bamianhuo") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「八面焰盾」了。\n");
		else	return notify_fail("你已经施展了「八面火」了。\n");
	}	

	message_vision(HIR"$N"HIR"一掐法咒，周身腾起道道烈焰，将四周空气烘烤得一阵扭曲！\n"NOR,me);
	me->set_temp("XST_bamianhuo",1);
	me->add("mana",-300);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：八面焰盾	
	神通效果：伤害抵消1200点
HELP);	
	else	write(@HELP
	神通名称：八面火	
	神通效果：伤害抵消500点
HELP);		
	return 1;		
}
