#include <ansi.h>
#include <combat.h>
inherit SSERVER;
//刹那间，无数的大小火球从其手中争先恐后的涌了出来，暴风骤雨一样的密密麻麻打了过去，附近的天空都染被成了火红之色。
//就一阵热风吹过，浑身上下立刻燥热无比。
//冰网中的火球一下爆裂开来，冰网随之在青焰中燃烧溶解，眨眼间化为了无有。脱困青焰化为一道火柱，气势汹汹的向众人射来。

int cast(object me, object target)
{	
	int damage,i;
	string msg,succ_msg;
	object *enemy;
	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<500 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_hlxy")+6 )
		return notify_fail("你不能频繁调用天气元气。\n");
	
	me->clean_up_enemy();                
        if( !me->is_fighting() )
        	return notify_fail("「火雷星雨」只能战斗中使用。\n");
        enemy = me->query_enemy();
	if( !intp(i=sizeof(enemy)) 
	 || i<1 )
		return notify_fail("「火雷星雨」只能战斗中使用。\n");			
	
		
	me->add("mana",-500);
	me->set_temp("XST_hlxy",time());
	me->add_temp("apply/attack",100);
	me->set_temp("pfm_msg",1);
	
	msg = HIR"$N"HIR"双手一搓，刹那间，无数的大小火球从其手中争先恐后的涌了出来，暴风骤雨一样的飞到半空，密密麻麻将天空都染被成了火红之色！\n"NOR;
	message_vision(msg,me,target);
	
	while(i--)
	{
		target = enemy[i];
		if( !target || !target->is_character()
         	  || target->is_corpse()
         	  || target==me
         	  || !me->is_fighting(target) )
			continue;
		if( target->query("family/family_name")=="火云洞"
		 || target->query("family/family_name")=="五庄观" )
		 	continue;			
		msg = HIY"\n$n"HIY"只觉一阵热风吹过，浑身上下立刻燥热无比。\n"NOR;
		succ_msg = ({
 			HIC"结果$n"HIC"晃了一晃，吃了点小亏。\n"NOR,
        		HIC"结果$n"HIC"气息一窒，显然有点呼吸不畅！\n"NOR,
        		HIC"结果$n"HIC"体内一阵剧痛，看起来内伤不轻！\n"NOR,
        		HIC"结果「嗡」地一声$n"HIC"只觉得眼前一黑，双耳轰鸣不止！\n"NOR,
		})[random(4)];
		damage = 900+random(400);
		if( me->query_level()>=90 && me->query("shentong/90") )
			damage = damage*5+1;
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
		if( damage<1 )
			message_vision(HIC"$N"HIC"周身护身霞光闪动，真气运转周天，顿时不觉异常。\n"NOR,target);
		else	target->apply_condition("fire2_poison",3);	
	}
	
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-100);
	return 1;				
}

int help(object me)
{
	write(@HELP
	神通名称：火雷星雨	
	神通效果：对区域内的敌人进行攻击
		  击中会使对方身中火毒
                  冷却时间6秒
                  对火云洞、五庄观弟子无效
HELP);		
	return 1;		
}
