#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<400 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_lhxd")+7 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
		return notify_fail("「烈火旋灯」只能对战斗中的对手使用。\n");
	damage = random(me->query("mana_factor"));
	if( me && me->query_level()>=90 && me->query("shentong/90") )
	{
		if( damage<2000 )
			damage = 2000;
		if( damage>5000 )
			damage = 5000;		
	}
	else
	{
		if( damage<800 )
			damage = 800;
		if( damage>1200 )
			damage = 1200;
	}
	me->add("mana",-400);
	me->set_temp("XST_lhxd",time());
	me->add_temp("apply/attack",90);
	me->set_temp("pfm_msg",1);
	
	msg = HIC"$N"HIC"一拍顶梁门，泥丸宫顿时升起一圈不停飞旋的"HIR"烈火灯焰"HIC"，朝着$n"HIC"飞去！\n"NOR;
	message_vision(msg,me,target);
	
	if( target->query("family/family_name")=="火云洞"
	 || target->query("family/family_name")=="五庄观" )
		message_vision(HIC"$n"HIC"对之置若罔闻，将手一指"HIC"灯焰"HIC"，一声“破”，顿时虚影化作丝丝火星消逝在空气之中。\n"NOR,me,target);
	
	else
	{	
		msg = HIC"灯焰上"HIR"红光"HIC"一闪，一道"HIR"赤焰"HIC"卷起阵阵风云，朝$n"HIC"$l压去！\n"NOR;
		succ_msg = ({
			HIR"结果砸个正着，$n"HIR"闷哼一声显然吃了不小的亏！\n"NOR,
	        	HIR"结果「砰」地一声，$n"HIR"疼得连腰都弯了！\n"NOR,
        		HIR"结果这一下「轰」地一声砸得$n"HIR"眼冒金星，差一点摔倒！\n"NOR,
        		HIR"结果只听见「轰」地一声巨响，$n"HIR"被砸得血肉模糊，惨不忍睹！\n"NOR,
		})[random(4)];
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,0,damage,"kee");
	
		if( damage<1 )
			message_vision(HIC"$n"HIC"对之置若罔闻，将手一指"HIC"灯焰"HIC"，一声“破”，顿时虚影化作丝丝火星消逝在空气之中。\n"NOR,me,target);
		else
		{
			msg = HIR"\n赤焰"HIC"在半空一个翻腾，红光一闪，又朝$n"HIC"$l压去！\n"NOR;
			succ_msg = ({
				HIR"结果砸个正着，",
	        		HIR"结果「砰」地一声，",
        			HIR"结果这一下「轰」地一声，",
	        		HIR"结果只听见「轰」地一声巨响，",
			})[random(4)];
			succ_msg+= "$n"HIR"$l处火光一闪，";
			succ_msg+= ({
				"$p闷哼一声显然吃了不小的亏！\n"NOR,
				"$p疼得连腰都弯了！\n"NOR,
				"砸得$p眼冒金星，差一点摔倒！\n"NOR,
				"$p被砸得血肉模糊，惨不忍睹！\n"NOR,
			})[random(4)];
			damage = random(me->query("mana_factor"));
			if( me && me->query_level()>=90 && me->query("shentong/90") )
			{
				if( damage<2000 )
					damage = 2000;
				if( damage>5000 )
					damage = 5000;	
			}
			else
			{
				if( damage<800 )
					damage = 800;
				if( damage>1200 )
					damage = 1200;	
			}		
			damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
			target->apply_condition("fire_poison",3);
		}
	}			
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-90);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：烈火旋灯	
	神通效果：对敌进行两次攻击
		  最低固定伤害2000
		  击中会使对方身中火毒
                  冷却时间7秒
                  对火云洞、五庄观弟子无效
HELP);	
	else	write(@HELP
	神通名称：烈火旋灯	
	神通效果：对敌进行两次攻击
		  最低固定伤害800
		  击中会使对方身中火毒
                  冷却时间7秒
                  对火云洞、五庄观弟子无效
HELP);		
	return 1;		
}
