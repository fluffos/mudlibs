#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<250 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( me->query_temp("XST_yanqiang") )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("你已经施展了「炙热炎墙」了。\n");
		else	return notify_fail("你已经施展了「炎墙」了。\n");
	}	
		
	message_vision(HIR"$N"HIR"将手一招，一道冲天的火墙凌空冒起，$N"HIR"身处火墙之内，却是毫发无损。\n"NOR,me);
	me->set_temp("XST_yanqiang",1);
	me->add("mana",-250);
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：炙热炎墙	
	神通效果：使自身枪技、杖技、棍技伤害增加15%
HELP);
	else	write(@HELP
	神通名称：炎墙	
	神通效果：使自身枪技、杖技、棍技伤害增加3%
HELP);		
	return 1;		
}
