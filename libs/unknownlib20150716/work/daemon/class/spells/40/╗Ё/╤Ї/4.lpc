#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_tianhuofen")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「天外飞火」了。\n");
    else return notify_fail("你已经施展了「天火焚」了。\n");
  }

  message_vision(HIR "$N" HIR "将身一晃，背后顿时异象横生，只见层层叠叠烈焰在其背后翻腾窜越，$N" HIR "整个人气势更为猛厉！\n" NOR, me);
  me->set_temp("XST_tianhuofen", 1);
  me->add("mana", -400);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：天外飞火	
	神通效果：固定伤害增加1000点
HELP);
  else write(@HELP
	神通名称：天火焚	
	神通效果：固定伤害增加500点
HELP);
  return 1;
}
