#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int damage;
	string msg,succ_msg;
	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("mana")<400 )
		return notify_fail("你的法力不够。\n");
	if( me->query_skill("spells")<600 )
		return notify_fail("你的法术修为过低。\n");
	if( time()<me->query_temp("XST_ylws")+8 )
		return notify_fail("你不能频繁调用天气元气。\n");
				
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	|| target==me
	||	!me->is_fighting(target) )
	{
		if( me->query_level()>=90 && me->query("shentong/90") )	 	 
			return notify_fail("「无双炎龙」只能对战斗中的对手使用。\n");
		else	return notify_fail("「炎龙无双」只能对战斗中的对手使用。\n");
	}	

	damage = random(me->query("mana_factor"));
	if( me && me->query_level()>=90 && me->query("shentong/90") )
	{
		if( damage<1200 )
			damage = 1200;
		if( damage>8000 )
			damage = 8000;
	}
	else
	{
		if( damage<600 )
			damage = 600;
		if( damage>1000 )
			damage = 1000;
	}
	me->add("mana",-400);
	me->set_temp("XST_ylws",time());
	me->add_temp("apply/attack",80);
	me->set_temp("pfm_msg",1);
	
	msg = HIR"$N"HIR"指尖红光大作，念动咒语，一指$n"HIR"，大喝一声“去！”。\n"NOR;
	message_vision(msg,me,target);
	
	if( target->query("family/family_name")=="火云洞"
	 || target->query("family/family_name")=="五庄观" )
	 	message_vision(HIC"$n"HIC"对之置若罔闻。\n"NOR,me,target);
	
	else
	{
		msg = HIR"红光"HIC"一闪，一条浑身"HIR"烈焰"HIC"缭绕的"HIR"火龙"HIC"从虚空中顿现，恶狠狠朝向$n"HIC"$l咬去！\n"NOR;
		succ_msg = HIR"结果$n"HIR"一声闷哼，手捂$l连忙后退，指缝间冒出丝丝赤气。\n"NOR;
		damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
		if( damage<1 )
		{
			message_vision(HIC"$n"HIC"对之置若罔闻，将手一指"HIR"火龙"HIC"，一声“破”，顿时虚影化作丝丝火光消逝在空气之中。\n"NOR,me,target);
			me->start_busy(1);
		}
		else	target->apply_condition("fire_poison",3);
	}
	me->set_temp("pfm_msg",0);
	me->add_temp("apply/attack",-80);
	return 1;				
}

int help(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") )
		write(@HELP
	神通名称：无双炎龙	
	神通效果：对敌进行法术型气血攻击
		  最低固定伤害1200
		  击中会使对方身中火毒
		  否则自身busy1秒
                  冷却时间8秒
                  对火云洞、五庄观弟子无效
HELP);	
	else	write(@HELP
	神通名称：炎龙无双	
	神通效果：对敌进行法术型气血攻击
		  最低固定伤害600
		  击中会使对方身中火毒
		  否则自身busy1秒
                  冷却时间8秒
                  对火云洞、五庄观弟子无效
HELP);	
	return 1;		
}
