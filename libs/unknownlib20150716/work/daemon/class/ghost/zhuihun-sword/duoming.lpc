#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string *msgs = ({
  "无常", "判官", "阎罗", "追魂", "夺魄",
});

int perform(object me, object target) {
  string msg;
  int extra, i, apply_damage, flag = 0;
  object weapon;

  if (me->query_level() < 60)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill("zhuihun-sword", 1) < 600)
    return notify_fail("你的追魂剑法还不够纯熟！\n");
  if (me->query_skill("tonsillit", 1) < 600)
    return notify_fail("你的摄气诀还不够纯熟，无法发挥追魂剑的威力！\n");
  if (me->query("force") < 800)
    return notify_fail("你的内力不够了。\n");
  if (time() - (int)me->query_temp("hell_duoming") < 5)
    return notify_fail("绝招用多就不灵了！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "zhuihun-sword")
    return notify_fail("「追魂夺命」是追魂剑法的绝招。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「追魂夺命」只能对战斗中的对手使用。\n");

  if (me->query_temp("yunwu"))
    me->delete_temp("yunwu");
  weapon = me->query_temp("weapon");
  message_vision(
    HIY "\n$N" HIY "脸上鬼气大作，按捺不住胸中戾气，手中的" + weapon->name() + HIY "狂风暴雨般地向$n" HIY "袭来！\n" NOR,
    me,
    target
  );
  message_combatd(HIY "$N" HIY "使出夺命追魂连环剑绝招，一连五招向$n" HIY "连环攻出！\n" NOR, me, target);
  me->add("force", -300);
  me->set_temp("hell_duoming", time());
  me->add_temp("apply/attack", 30);

  extra = 0;
  for (i = 0; i < sizeof(msgs); i++) {
    if (!me || !target || !living(me)
      || !me->is_fighting(target))
      continue;
    msg = sprintf(BRED + HIB "         第%s剑『%s』！         \n" NOR, chinese_number(i + 1), msgs[i]);
    flag = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      0,
      0,
      (i + 1) * 800
    );
    if (flag > 0) {
      if (me->query_temp("hell_dm_damage") <= 0) {
        apply_damage = me->query_combat_damage();
        me->set_temp("hell_dm_damage", apply_damage);
      }
      if (me->query_temp("hell_dm_damage2") > me->query_temp("hell_dm_damage"))
        continue;
      extra = (int)me->query_temp("hell_dm_damage") / 30;
      if (extra < 50)
        extra = 50;
      me->add_temp("hell_dm_damage2", extra);
      me->add_temp("apply/combat_damage", extra);
    }
  }
  if (me)
    me->add_temp("apply/attack", -30);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @LONG
        外功名称：追魂夺命
        外功所属：追 魂 剑
        外功效果：疯狂攻击敌人5次
        	  每击中一次，自身物理攻击增加3%
        	  最高可叠加至自身物理攻击的100%
        	  冷却5秒
        外功条件：
        	  人物等级60级
                  追 魂 剑 600 级
                  摄 气 诀 600 级
                  内力800点，消耗300点
LONG;
  me->start_more(str);
  return 1;
}
