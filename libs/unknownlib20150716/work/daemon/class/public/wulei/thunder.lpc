// thunder.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj, d;
  string msg, succ_msg;

  success_adj = 220;
  damage_adj = 600;

  if (me->query_level() < 10)
    return notify_fail("你的等级不够。\n");

  if (me->query_skill("wulei", 2) < 100)
    return notify_fail("你的「五雷正法」还不够娴熟。\n");

  if (userp(me) && !me->query("mark/wuleiget"))
    return notify_fail("你哪儿偷来的武功？\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展五雷咒？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query_maxmana()) < 50) {
    write("糟糕，雷公今天不当差！\n");
    return 1;
  }

  msg = HIC "\n$N" HIC "口中念了句咒文，半空中现出一位尖头鹰鼻的神灵虚像，左手执斧，右手提锥。斧锥相击，在$n" HIC "的头顶炸起一片响雷！\n" NOR;
  succ_msg = HIR "结果$n" HIR "被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR;

  me->add_temp("apply/spells_succ", success_adj);
  me->set_temp("pfm_msg", 1);
  d = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage_adj,
    "kee"
  );
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/spells_succ", -success_adj);
  if (d <= 0)
    message_vision(HIC "谁知$N" HIC "毫无反应，就象聋子似的。\n" NOR, target);
  me->start_busy(1 + random(2));
  return 1;
}
