// leidong.c 雷动九天
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  string msg, succ_msg;
  int damage, p, succ;

  if (me->query_level() < 20)
    return notify_fail("你的等级不够。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要打谁？\n");
  if (time() < me->query_temp("wulei_leidong") + 5)
    return notify_fail("你不能频繁招雷。\n");

  if (userp(me) && !me->query("mark/wuleiget"))
    return notify_fail("你哪儿偷来的武功？\n");

  if ((int)me->query_skill("wulei", 2) < 200)
    return notify_fail("你的五雷正法级别还不够，使用这一招会有困难！\n");

  if ((int)me->query("mana") < 200 + (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你无法集中精力使用雷动九天！\n");

  me->set_temp("wulei_leidong", time());
  me->add("mana", -100 - (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);
  if (random(me->query_maxmana()) < 100) {
    write("失败了！\n");
    return 1;
  }
  msg = HIC "\n$N" HIC "口中大喝一声：九天雷神何在！电闪雷鸣之中，半空中有九道巨大神相齐现云端，九道蓝光向$n" HIC "激射而来！\n" NOR;
  succ_msg = HIB "结果$n" HIB "被蓝光劈个正着，血花飞溅，显然受伤不轻！\n" NOR;
  succ = me->query_skill("spells") / 20;

  me->add_temp("apply/spells_succ", succ);
  me->set_temp("pfm_msg", 1);
  p = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    800,
    "both"
  );
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/spells_succ", -succ);
  if (p <= 0)
    message_vision(HIC "但是被$N" HIC "躲开了。\n" NOR, target);
  return 1;
}
