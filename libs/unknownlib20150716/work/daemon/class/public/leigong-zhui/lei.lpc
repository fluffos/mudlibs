#include <ansi.h>
#include <combat.h>
inherit SSERVER;
 
int perform(object me, object target)
{
	int skill,extra;
	    
	if( !target ) 
		target = offensive_target(me);
	if( !target
 	 || !target->is_character()
 	 || !me->is_fighting(target) )
		return notify_fail("「电闪雷鸣」只能在战斗中使用。\n");
	if( (int)me->query("force") < 600 )
        	return notify_fail("你的真气不够！\n");
	if( time()-(int)me->query_temp("pfm_leigong-zhui") < 5 )
        	return notify_fail("绝招用多就不灵了！\n");                
	if( (int)me->query_skill("leigong-zhui",1) < 150 )
        	return notify_fail("你的「雷公椎」火候不够，无法使用「电闪雷鸣」！\n");
	if( (int)me->query_skill("force",1) < 150 )
        	return notify_fail("你的内功修为不够，无法使用「电闪雷鸣」！\n");

	me->set_temp("pfm_leigong-zhui",time());
	me->add("force",-100);
	
    	extra=(int)me->query_skill("leigong-zhui",1);
    	skill = extra/10;
	if(extra >500) extra =500;
	me->add_temp("apply/attack",skill);
	me->add_temp("apply/combat_damage",extra);
	
	message_vision(HIB"\n$N"HIB"浑身电光闪烁，宛如天神，对$n"HIB"发起了猛烈的进攻！\n"NOR,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_PERFORM);
	
	me->add_temp("apply/attack",-skill);
	me->add_temp("apply/combat_damage",-extra);        

	return 1;
}