#include <ansi.h>
inherit SSERVER;
inherit F_CLEAN_UP;

void remove_effect(object, int, int);

int valid_perform(object me) {
  if (me->query_level() < 30)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill_mapped("dodge") != "lihuo-dodge")
    return notify_fail("你还没有施展离火身法呢。\n");
  if (me->query_skill("dodge") < 400)
    return notify_fail("你身法还不够高明。\n");
  if (me->query_skill("force") < 400)
    return notify_fail("你的内功修为太差。\n");
  return 1;
}

int perform(object me, object target) {
  int skill_sword, skill_dodge;

  if (!target)
    target = me;

  if (!valid_perform(me))
    return 0;

  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup_fire"))
    return notify_fail("你已经在运功中了。\n");

  me->add("force", -30);
  message_vision(HIR "$N" HIR "略一提气，只见火花一闪，$N" HIR "背后隐现上古大巫祝融虚影，整个人逐渐幻做一团红雾，满堂滚动。\n" NOR, me);
  skill_dodge = me->query_skill("dodge") / 150 + 5;
  if (skill_dodge > 55)
    skill_dodge = 55;
  skill_sword = (me->query_skill("sword") + me->query_skill("spear") + me->query_skill("blade")) / 3;
  skill_sword = skill_sword / 10 + 5;
  if (skill_sword > 55)
    skill_sword = 55;
  me->add_temp("apply/combat_succ", skill_sword);
  me->add_temp("apply/spells_succ", skill_sword);
  me->add_temp("apply/combat_dodge", skill_dodge);
  me->add_temp("apply/spells_dodge", skill_dodge);
  me->set_temp("powerup_fire", 1);
  me->start_call_out(
    (: call_other, __FILE__, "remove_effect", me, skill_sword, skill_dodge :),
    120
  );
  return 1;
}

void remove_effect(object me, int skill_sword, int skill_dodge) {
  if (me && me->query_temp("powerup_fire")) {
    me->add_temp("apply/combat_succ", -skill_sword);
    me->add_temp("apply/spells_succ", -skill_sword);
    me->add_temp("apply/combat_dodge", -skill_dodge);
    me->add_temp("apply/spells_dodge", -skill_dodge);
    me->delete_temp("powerup_fire");
    message_vision(HIR "火气渐渐散去，$N" HIR "不得不放慢脚步。\n" NOR, me);
  }
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：火云步
        外功所属：离火身法
        外功效果：2分钟内增强自身的命中率以及闪避率
                  可与其他增益类状态叠加
        外功条件：
                  人物等级30级  
                  内力30点，消耗30点
                  轻功有效等级 400 级
                  内功有效等级 400 级
                  基本轻功激法离火身法
STR;
  me->start_more(str);
  return 1;
}
