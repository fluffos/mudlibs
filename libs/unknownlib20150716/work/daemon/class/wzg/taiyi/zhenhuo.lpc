//zhenhuo.c 【太乙真火】weiqi...980305
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target)
{
	int success_adj, damage_adj,dd;
	string msg,succ_msg;
	
	if( me->query_level()<35 )
		return notify_fail("你的人物等级不够。\n");
	if(me->query("family/family_name")!="五庄观" 
        && me->query("chushi/chushi_wzg")!="yes" )
		return notify_fail("你不能使用这项技能！\n");
        if((int)me->query_skill("taiyi", 1) < 350 )
		return notify_fail("你的太乙仙法火候不够，哪里喷得出真火！\n");
	if((int)me->query("mana")< 300 )
		return notify_fail("你的法力不够，喷出的真火恐怕没有什么用！\n");
	if((int)me->query("sen") < 50 )
		return notify_fail("你现在神智不清，别把自己烧伤了！\n");

        success_adj = 60;
        damage_adj = 600;

	if( !target ) target = offensive_target(me);

	if( !target
	||   !target->is_character()
	||   target->is_corpse()
	||   target==me)
		return notify_fail("你要对谁喷太乙真火？\n");

	me->add("mana", -150);
	me->receive_damage("sen", 10);

	if( random(me->query_maxmana()/10)<5 ) 
	{
		write("这一次好像不灵。\n");
		return 1;
	}

	msg = HIC"\n$N"HIC"几个指头迅速捻动，突然张嘴一喷！"HIR"红"HIM"橙"HIY"黄"HIC"三道火焰呼！地一声向$n"HIC"卷去！\n" NOR;
	succ_msg = HIC "结果$n"HIC"被烧得焦头烂额！\n" NOR;
	me->set_temp("pfm_msg",1);
	me->add_temp("apply/attack",success_adj);
	dd = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage_adj,"both");
	me->delete_temp("pfm_msg");
	me->add_temp("apply/attack",-success_adj);
	if( dd<1 )
		message_vision(HIC"但是$N"HIC"轻轻一跳就躲了开来。\n" NOR,target);
	me->start_busy(1+random(2));
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：太乙真火
        法术所属：太乙仙法
        法术效果：法术攻击造成对方气血、精神减少与损伤
		  自身busy 1-2 秒
        法术条件：
                  五庄观(出师)弟子
        	  人物等级35级
                  法力300点，消耗150点
                  精神50点，消耗10点
                  太乙仙法350级
                  
STR;
        me->start_more(str);
        return 1;
}