//bagua.c
#include <ansi.h>
inherit SSERVER;
inherit F_CLEAN_UP;

string name(){return "「八卦护体」";}

string *bagua = ({
        "乾","坤","震","巽","坎","离","艮","兑",
});

void remove_effect(object me)
{
	int p;
	if( !me )
		return;
	if( !intp(p=me->query_temp("wzg_bagua"))
	 || p<=0 )
	 	return;
	me->add_temp("apply/receive_force",-p);
	me->add_temp("apply/receive_mana",-p);
	me->add_temp("apply/receive_kee",-p);
	me->add_temp("apply/receive_sen",-p);
	me->delete_temp("wzg_bagua");
	me->set_temp("wzg_castbagua",time());
	message_vision("$N背后的八卦图渐渐隐去。\n",me);
}

int cast(object me, object target)
{
	string msg;
	int time,p;

	if( me->query_level()<15 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("family/family_name") != "五庄观" )
		return notify_fail(name()+"乃五庄观密修之法。\n");
	if( me->query_skill("taiyi", 1)<150)
        	return notify_fail("你的太乙仙法修为不深，使不了"+name()+"。\n");
	if( me->query("mana")<100 )
        	return notify_fail("你的法力不够，使不了"+name()+"。\n");
	if( me->is_fighting())
        	return notify_fail("战斗中施展"+name()+"恐怕有些危险。\n");
	if( me->query("sen")<50 )
        	return notify_fail("你现在神智不清，难以施展"+name()+"。\n");
	if( time()<me->query_temp("wzg_castbagua")+8 )
        	return notify_fail("你刚刚用过"+name()+"，还是歇歇再试吧。\n");
        if( me->query_temp("wzg_bagua")>0 )
        	return notify_fail("你已经在运功中了。\n");	

	me->add("mana",-50);
	me->receive_damage("sen",30);
	if( random(me->query_maxmana()/10)<5 ) 
        {
        	write("咦？这一次好像不灵。\n");
        	return 1;
        }
        time = 300;
        p = 300+(me->query_skill("taiyi",1)-150)/50;
        
	message_vision(HIC"$N"HIC"左手捏咒，口中喃喃念叨了几句真言，右手掐指往背后一指，大喝一声“立”！只见$P身后渐渐现出一幅巨大的八卦图！\n"NOR,me);
	message_combatd(HIC"$N"HIC"背后八卦图一闪，"+bagua[random(sizeof(bagua))]+"方生门中一道金光射入$N"HIC"体内。\n"NOR,me);           
	me->set_temp("wzg_bagua",p);
	me->add_temp("apply/receive_force",p);
	me->add_temp("apply/receive_mana",p);
	me->add_temp("apply/receive_kee",p);
	me->add_temp("apply/receive_sen",p);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), time);
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        法术名称：八卦护体
        法术所属：太乙仙法
        法术效果：五分钟内增加自身的内法精气自动回复值
        	  战斗中不能使用
                  状态结束后冷却8秒
        法术条件：
        	  五庄观弟子
        	  人物等级15级	
                  法力100点，消耗50点
                  精神50点，消耗10点
                  太乙仙法 150 级
STR;
        me->start_more(str);
        return 1;
}