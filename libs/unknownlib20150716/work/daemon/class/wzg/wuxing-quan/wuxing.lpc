#include <ansi.h>
#include <combat.h>
inherit SSERVER;

mapping xiangke = ([
  "金": "火",
  "木": "金",
  "土": "木",
  "水": "土",
  "火": "水"
]);
mapping xiangsh = ([
  "金": "水",
  "木": "火",
  "土": "金",
  "水": "木",
  "火": "土"
]);

string name() { return "「相生相克」"; }

int valid_perform(object me) {
  if (me->query_level() < 5)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill("wuxing-quan", 1) < 50)
    return notify_fail("你的" + to_chinese("wuxing-quan") + "等级不足。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不足。\n");
  if (me->query("kee") < 50)
    return notify_fail("你的气血不足。\n");
  return 1;
}

string _query_char_wx(object who) {
  string str, wx;
  int lvl;
  if (!who)
    return 0;
  if (stringp(str = who->query("shentong/40"))) {
    if (sscanf(str, "%s_%s_%d", wx, str, lvl) == 3)
      return wx;
  }
  if (stringp(wx = FAMILY_D->family_wuxing(who))
    && wx != "NONE")
    return wx;
  if (stringp(wx = SPELL_D->query_time_wuxing()))
    return wx;
  return ({ "金", "木", "水", "火", "土", })[random(5)];
}

int perform(object me, object target) {
  int damage, p, i;
  string msg, succ_msg, my_wx, str, his_wx;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || me == target
    || !me->is_fighting(target))
    return notify_fail(name() + "只能在战斗中使用。\n");

  me->add("force", -50);
  me->receive_damage("kee", 10, me);

  my_wx = _query_char_wx(me);
  his_wx = _query_char_wx(target);

  msg = HIC "\n$N" HIC "调动体内五行之力，将自身" + my_wx + "之力融入$w" HIC "，全力朝$n" HIC "$l打出一拳！\n" NOR;

  damage = 300;
  i = me->query("mark/wzg_wuxing-quan");
  if (i > 0 && i < 2) {  //金
    str = HIY "$N" HIY "明辨$n" HIY "体内" + his_wx + "行之气，";
    if (SPELL_D->wuxing_xs("金", his_wx) == 1) {
      str += "此拳中夹带一丝金戈之力！$n" HIY "只觉一股大力迎面而来，有如利刃" HIR "临体" HIY "！\n" NOR;
      damage += 250;
    } else if (SPELL_D->wuxing_xs("金", his_wx) == -1) {
      damage += 100;
      str = "";
    } else if (SPELL_D->wuxing_xs("金", his_wx) == 2) {
      str += "顿时体内金行之气与之相生相激，犹如春江滚滚！" NOR;
      str += ({
        HIY "$n" HIY "彷佛听到一声极大的轰鸣，起于心底，散之天地！\n" NOR,
        HIY "$N" HIY "将无坚不摧的浩然正气，聚于拳头之上，直击$n" HIY "！\n" NOR,
        HIY "$n" HIY "被$N" HIY "气劲压的喘不过起来，浑身骨骼发出阵阵闷响！\n" NOR,
      })[random(3)];
      damage += 150;
    } else str = "";
    msg += str;
  }
  if (i > 0 && i < 3) {  //木
    str = HIY "$N" HIY "明辨$n" HIY "体内" + his_wx + "行之气，";
    if (SPELL_D->wuxing_xs("木", his_wx) == 1) {
      str += "此拳中夹带一丝青木之力！$n" HIY "只觉一股大力由四面八方而来，四周" HIG "植物" HIY "疯狂生长蔓延！\n" NOR;
      damage += 100;
    } else if (SPELL_D->wuxing_xs("木", his_wx) == -1) {
      damage += 50;
      str = "";
    } else if (SPELL_D->wuxing_xs("木", his_wx) == 2) {
      str += "顿时体内" HIG "木行之气" HIY "与之相生相激，犹如万木逢春！" NOR;
      str += ({
        HIY "$n" HIY "彷佛听到一声极大的轰鸣，起于心底，散之天地！\n" NOR,
        HIY "$N" HIY "将无坚不摧的浩然正气，聚于拳头之上，直击$n" HIY "！\n" NOR,
        HIY "$n" HIY "被$N" HIY "气劲压的喘不过起来，浑身骨骼发出阵阵闷响！\n" NOR,
      })[random(3)];
      damage += 80;
    } else str = "";
    msg += str;
  }
  if (i > 0 && i < 4) {  ////水
    str = HIY "$N" HIY "明辨$n" HIY "体内" + his_wx + "行之气，";
    if (SPELL_D->wuxing_xs("水", his_wx) == 1) {
      str += "调动体内" HIG "水行之气" HIY "，犹如春江滚滚！$n" HIY "只觉一股大力将自己团团围住，有如置身" HIW "大海" HIY "，无法立足！\n" NOR;
      damage += 100;
    } else if (SPELL_D->wuxing_xs("水", his_wx) == -1) {
      damage += 50;
      str = "";
    } else if (SPELL_D->wuxing_xs("水", his_wx) == 2) {
      str += "顿时体内" HIW "水行之气" HIY "与之相生相激，犹如春江滚滚！\n" NOR;
      str += ({
        HIY "$n" HIY "彷佛听到一声极大的轰鸣，起于心底，散之天地！\n" NOR,
        HIY "$N" HIY "将无坚不摧的浩然正气，聚于拳头之上，直击$n" HIY "！\n" NOR,
        HIY "$n" HIY "被$N" HIY "气劲压的喘不过起来，浑身骨骼发出阵阵闷响！\n" NOR,
      })[random(3)];
      damage += 80;
    } else str = "";
    msg += str;
  }
  if (i > 0 && i < 5) {  //火
    str = HIY "$N" HIY "明辨$n" HIY "体内" + his_wx + "行之气，";
    if (SPELL_D->wuxing_xs("火", his_wx) == 1) {
      str += "调动体内火行之气，拳风之中夹带炽热之风！\n$n" HIY "只觉一股" HIR "火热" HIY "扑面而来，如烈日当空，浩漠千里，四周再无一丝生机！\n" NOR;
      damage += 200;
    } else if (SPELL_D->wuxing_xs("火", his_wx) == -1) {
      damage += 100;
      str = "";
    } else if (SPELL_D->wuxing_xs("火", his_wx) == 2) {
      str += "顿时体内" HIR "火行之气" HIY "与之相生相激，犹如熊熊烈焰！\n" NOR;
      str += ({
        HIY "$n" HIY "彷佛听到一声极大的轰鸣，起于心底，散之天地！\n" NOR,
        HIY "$N" HIY "将无坚不摧的浩然正气，聚于拳头之上，直击$n" HIY "！\n" NOR,
        HIY "$n" HIY "被$N" HIY "气劲压的喘不过起来，浑身骨骼发出阵阵闷响！\n" NOR,
      })[random(3)];
      damage += 150;
    } else str = "";
    msg += str;
  } else if (i > 0) {  //土
    str = HIY "$N" HIY "明辨$n" HIY "体内" + his_wx + "行之气，";
    if (SPELL_D->wuxing_xs("土", his_wx) == 1) {
      str += "拳风中暗含土腥气味！\n$n" HIY "只觉一股大力从脚下大地传来，一时间" NOR YEL "地动山摇" NOR HIY "，再也无法立足！\n" NOR;
      damage += 120;
    } else if (SPELL_D->wuxing_xs("土", his_wx) == -1) {
      damage += 60;
      str = "";
    } else if (SPELL_D->wuxing_xs("土", his_wx) == 2) {
      str += "顿时体内" NOR YEL "土行之气" NOR HIY "与之相生相激，犹如滚石不绝！\n" NOR;
      str += ({
        HIY "$n" HIY "彷佛听到一声极大的轰鸣，起于心底，散之天地！\n" NOR,
        HIY "$N" HIY "将无坚不摧的浩然正气，聚于拳头之上，直击$n" HIY "！\n" NOR,
        HIY "$n" HIY "被$N" HIY "气劲压的喘不过起来，浑身骨骼发出阵阵闷响！\n" NOR,
      })[random(3)];
      damage += 100;
    } else str = "";
    msg += str;
  }
  succ_msg = ({
    HIR "结果一击命中，$n" HIR "闷哼了一声显然吃了不小的亏！\n" NOR,
    HIR "结果这一下「砰」地一声打得$n" HIR "连退了好几步，差一点摔倒！\n" NOR,
    HIR "结果重重地击中，$n" HIR "「哇」地一声吐出一口鲜血！\n" NOR,
    HIR "结果只听见「砰」地一声巨响，$n" HIR "像一捆稻草般飞了出去！\n" NOR,
  })[random(4)];

  me->add_temp("apply/attack", 50);
  me->set_temp("pfm_msg", 1);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );
  me->delete_temp("pfm_msg");
  me->add_temp("apply/attack", -50);

  me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：相生相克
        外功所属：五行拳
        外功效果：法术型气血伤害
                  自身busy 2 秒
                  五行拳战斗过程中会自动领悟五行之力
        外功条件：
                  人物等级 5 级
                  内力100点，消耗50点
		  气血50点，消耗10点 
                  五行拳 50 级
STR;
  me->start_more(str);
  return 1;
}
