#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_kee(object who,int p)
{
	if( who && who->query_temp("wzg_poyuaned") )
	{
		who->add_temp("apply/max_kee",p);
		who->receive_curing("kee",1);
		who->receive_heal("kee",1);
		who->delete_temp("wzg_poyuaned");
		message_vision("$N终于平复了气海中翻江倒海般的伤势。\n",who);
	}
}

int perform(object me, object target)
{
        string msg;
        int damage,kee,init_kee;

	if( me->query_level()<30 )
		return notify_fail("你的人物等级不够。\n");
        if(me->query("family/family_name")!="五庄观")
                return notify_fail("「破元击」只有五庄观门人才可以用！\n");
        if(me->query_skill("kaishan-chui",1) < 300)
                return notify_fail("你的开山锤还不够纯熟。\n");
        if(me->query_skill_mapped("force")!="zhenyuan-force")
                return notify_fail("「破元击」必须和镇元神功配合。\n");
        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不够！\n");
        
        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("「破元击」只能对战斗中的对手使用。\n");
	if( (int)target->query_maxkee()<500
	 || (int)target->query_maxkee()<target->query("max_kee")/20 )
		return notify_fail("对方目前气血已经不够充沛了。\n");
		
	init_kee = 0;
        me->add("force",-100);
        me->add_temp("apply/attack", 10);
        msg = HIC"$N"HIC"一抖仙衣，$w"HIC"发出呼啸之声，一式"+HIC"－破－云－击－"HIC+"如急电般砸向$n"HIC"！\n" NOR;
        damage = COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,500);
        me->add_temp("apply/attack", -10);
        if( damage>0 )
        {
        	kee = target->query_maxkee()/20;
        	if( kee>0 )
        	{
        		message_combatd(HIY"这一击震得$N"HIY"胆战心惊，摇摇欲坠！\n\n"NOR,target);
        		target->add_temp("apply/max_kee",-kee);
        		if( !target->query_temp("wzg_poyuaned") )
        			target->set_temp("wzg_poyuaned",1);
        		init_kee+= kee;
        	}	
        }

	msg = HIC"$N"HIC"手中$w"HIC"幻出奇异的光华砸向$n"HIC"！\n" NOR;
	me->add_temp("apply/attack", 15);
	damage = COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,550);
	me->add_temp("apply/attack",-15);
	if( damage>0 )
        {
        	kee = target->query_maxkee()/20;
        	if( kee>0 )
        	{
        		message_combatd(HIY"这一击震得$N"HIY"胆战心惊，摇摇欲坠！\n\n"NOR,target);
        		target->add_temp("apply/max_kee",-kee);
        		if( !target->query_temp("wzg_poyuaned") )
        			target->set_temp("wzg_poyuaned",1);
        		init_kee+= kee;
        	}	
        }
        
        if( me->query_skill("kaishan-chui",1)>=350 )
        {
                msg = HIC"\n$N"HIC"手中$w"HIC"发出摄人心魄的呼啸向$n"HIC"砸去！\n" NOR;
                me->add_temp("apply/attack",20);
	        damage = COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,600);
	        me->add_temp("apply/attack",-20);
        	if( damage>0 )
		{
			kee = target->query_maxkee()/20;
        		if( kee>0 )
        		{
        			message_combatd(HIY"这一击震得$N"HIY"胆战心惊，摇摇欲坠！\n\n"NOR,target);
        			target->add_temp("apply/max_kee",-kee);
        			if( !target->query_temp("wzg_poyuaned") )
        				target->set_temp("wzg_poyuaned",1);
        			init_kee+= kee;
        		}
		}
	} 
        
        if( me->query_skill("kaishan-chui",1)>=400 )
        {
                msg = HIC"\n$N"HIC"手中$w"HIC"竟然发出耀人双目的奇光砸向$n"HIC"！\n" NOR;
                me->add_temp("apply/attack",30);
	        damage = COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_PERFORM,msg,0,0,800);
	        me->add_temp("apply/attack",-30);
        	if( damage>0 )
        	{
			kee = target->query_maxkee()/20;
        		if( kee>0 )
        		{
        			message_combatd(HIY"这一击震得$N"HIY"胆战心惊，摇摇欲坠！\n\n"NOR,target);
        			target->add_temp("apply/max_kee",-kee);
        			if( !target->query_temp("wzg_poyuaned") )
        				target->set_temp("wzg_poyuaned",1);
        			init_kee+= kee;
        		}
		}
	} 
        me->start_busy(3);
        if( target && init_kee>0 )
        {
        	message_vision(HIR"$N"HIR"浑身气血翻腾，看样子是十分不妥。\n"NOR,target);
        	if( !target->is_boss() && !target->query("任务") )
        	{
			target->receive_curing("kee",1);
			target->receive_heal("kee",1);
        	}
        	call_out("remove_kee",me->query_skill("hammer"),target,init_kee);
        }
        return 1;
}

int help(object me)
{
string str;     
if ( !me )      return 0;
str = @LONG
        外功名称：破元击
        外功所属：开山锤
        外功效果：对敌进行带固定伤害的攻击，最多4击
        	  固定伤害递增
        	  每击中一次，降低对方气血上限5%
                  使用后自身busy 3 秒
        外功条件：
                  五庄观弟子
                  人物等级30级
                  内功激发镇元神功
                  内力500点，消耗100点，每增一击，消耗100点
                  开山锤300级
                  
LONG;
me->start_more(str);
return 1;
}

