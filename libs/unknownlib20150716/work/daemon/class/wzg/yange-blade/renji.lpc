#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        int damage,drop=0;
        string msg,succ_msg;
        object weapon,his_weapon;
	
	if( me->query_level()<25 )
		return notify_fail("你的人物等级不够。\n");
        if(!objectp(weapon = me->query_temp("weapon"))
        || ( weapon->query("skill_type") != "blade"
          && weapon->query("use_apply_skill") != "blade" ) )
                return notify_fail("开什么玩笑，没装备刀就想使「了无人迹」？\n");
        if((int)me->query_skill("yange-blade", 1) < 200 )
                return notify_fail("你的雁歌刀法不够娴熟，还使不出「了无人迹」。\n");
        if((int)me->query("force")<200)
		return notify_fail("你现在内力不够，没能将「了无人迹」使完！\n");

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("「了无人迹」只能对战斗中的对手使用。\n");

	me->add("force",-100);
        msg = HIC "$N"HIC"手中长刀刀芒跃动，刀光暴长，一刀砍出，刀尖渐渐逼近$n"HIC"，$n"HIC"看到漫天刀光，抽身后跃，只这一刹，漫天刀影化为一刀劈至胸前，"NOR;
        if( objectp(his_weapon = target->query_temp("weapon"))
         && random(me->query_str())>target->query("str") )
	{         
		drop = 1;         
		msg += HIC"只觉得浑身一热，手掌虎口巨痛，手中$W"HIC"脱手而出。\n" NOR;
	}
	
	succ_msg = ({
		HIC"结果$n"HIC"脸色一变，被一刀砍中，昏昏沉沉接连退了好几步！\n"NOR,
		HIC"结果一刀砍中，$n"HIC"「哇」地一声吐出一口鲜血！\n"NOR,
		HIR"结果「轰」地一声，一刀正中要害，$n"HIR"全身气血倒流，口中鲜血狂喷而出！\n"NOR,
		HIR"结果只听见几声喀喀轻响，$n"HIR"一声惨叫，像滩软泥般塌了下去！\n"NOR,
	})[random(4)];
	
	me->add_temp("apply/attack",30);
	me->set_temp("pfm_msg",1);
	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,500);
	me->add_temp("apply/attack",-30);
	me->delete_temp("pfm_msg");
	
	if( damage<1 )
        {
                me->start_busy(1);
    		message_vision(HIY"$N"HIY"危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR,target);
        }
       	else
       	{
       		me->start_busy(2);
       	 	if( drop && target && his_weapon && his_weapon==target->query_temp("weapon") )
       		{
  			his_weapon->unequip();	
			if( his_weapon->query("level")<weapon->query("level")/2 )
			{
				his_weapon->move(environment(me));
				WEAPON_D->add_broken_obj(his_weapon,60);
			}
			target->reset_action();
		}
	}
        return 1;
}

int help(object me)
{
        string str;     
        if( !me )      
                return 0;
        str = @LONG
        外功名称：了无人迹
        外功所属：雁歌刀法
        外功效果：攻击对方并可能打落对方武器
                  未中自身busy1秒，否则自身busy2秒
        外功条件：
        	  人物等级25级	
                  内力200点,消耗100点
                  雁歌刀法200级并激发
LONG;
        me->start_more(str);
        return 1;
}
