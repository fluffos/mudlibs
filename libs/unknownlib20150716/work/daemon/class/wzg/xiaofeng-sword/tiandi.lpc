#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
	string msg;
	
	if( me->query_level()<8 )
		return notify_fail("你的人物等级不够。\n");
	if(me->query("family/family_name") != "五庄观" )
                return notify_fail("你是哪儿偷学来的武功，也想用「天地同寿」?\n");
        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if( me->query_skill_mapped("force")!="zhenyuan-force" )
                return notify_fail("天地同寿必须配合镇元神功才能使用。\n");
	if( !objectp(weapon=me->query_temp("weapon"))
	 || weapon->query("skill_type")!="sword" )
	 	return notify_fail("你的剑呢？\n");
	
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me
        || !me->is_fighting(target) )
                return notify_fail("你要对谁施展这一招「天地同寿」？\n");

	msg = HIW"\n$N"HIW"清啸一声，一招「天地同寿」，$w"HIW"不住颤动，宛如冰轮横空，清光铺地，带着一抹寒光直刺$n"HIW"咽喉！。\n"NOR;
	me->receive_damage("sen",50);
	me->add("force",-100);
	me->add_temp("apply/attack",50);

	me->set_temp("pfm_msg",1);
   	me->set_temp("XFJ_perform",1);
   	COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_PERFORM,msg,0,"颈部",100);
	me->delete_temp("XFJ_perform");
	me->add_temp("apply/attack",-50);
	me->delete_temp("pfm_msg");

	me->start_busy(2);
        return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：天地同寿
        外功所属：晓风残月剑
        外功效果：攻击对方要害
                  自身busy 2 秒
        外功条件：
        	  五庄观弟子
        	  人物等级8级	
                  内力300点，消耗100点
                  精神100点，消耗50点
                  内功激发镇元神功
                  
STR;
        me->start_more(str);
        return 1;
}
