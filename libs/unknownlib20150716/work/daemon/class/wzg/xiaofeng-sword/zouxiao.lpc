// zouxiao.c  碧箫传情  
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage,p,succ;
        object weapon;
        
        if( me->query_level()<15 )
        	return notify_fail("你的人物等级不够。\n");
        if(me->query_skill("xiaofeng-sword",1)<150 )
		return notify_fail("你的晓风残月剑还得再练练。\n");
        if((int)me->query("force") < 200 )
                return notify_fail("你的内力还不到火候。\n");

	if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("你要对谁奏箫？\n");
                
	if( target->is_busy() )
		return notify_fail("对方现在忙的焦头烂额，哪里听得你的曲儿？\n");                
        
        if( !objectp(weapon=me->query_temp("weapon")) )  return notify_fail("你要以何作箫？\n");
        msg = HIC"$N"HIC"将"+weapon->name(1)+HIC"一收，凝气成箫，对着$n"HIC"奏起了一曲，箫声凄凉，似是叹息，又似哭泣，跟着箫声颤抖，发出瑟瑟瑟断续之音，如是一滴滴小雨落上树叶。\n"NOR;
        p = me->query_skill("sword")/60;
        me->add("force",-50);
	me->add_temp("apply/attack",80);
	succ = COMBAT_D->attack_percent(me,target,TYPE_PERFORM);
        me->add_temp("apply/attack",-80);
        
        if( succ<1 )
        {
        	me->start_busy(1);
        	msg+= HIG"结果$n"HIG"置若罔闻，无动于衷。\n"NOR;
        }
        else
        {
        	target->start_busy(p);
        	msg+= HIR"$n"HIR"听了箫声，心中莫名其妙的感到一阵酸楚，悲从中来，泪水正涔涔落下。\n"NOR;
        }
        message_vision(msg,me,target);
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：碧箫传情
        外功所属：晓风残月剑
        外功效果：以箫声伤敌busy至少3秒
                  不中则自身busy 1 秒
                  不能对busy中的敌方使用
        外功条件：
        	  五庄观弟子
        	  人物等级15级	
                  内力200点，消耗50点
                  晓风残月剑 150 级
                  
STR;
        me->start_more(str);
        return 1;
}
