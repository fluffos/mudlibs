#include <ansi.h>
inherit SSERVER;
 
void remove_effect(object me,object weapon);
 
int perform(object me, object target)
{
	object weapon;
	if( me->query_level()<10 )
		return notify_fail("你的人物等级不够。\n");
	if(me->query("family/family_name") != "五庄观" )
        	return notify_fail("你是哪儿偷学来的武功，也想用「化剑为杖」?\n");
	if( me->query_skill("xiaofeng-sword",1)<100 )
		return notify_fail("你晓风残月剑法等级还不够。\n");
        if(me->query_skill_mapped("force")!="zhenyuan-force")
		return notify_fail("「化剑为杖」必须配合镇元神功才能使用。\n");
        if((int)me->query_skill("fumo-zhang", 1) <100
         || !me->query_skill_mapped("staff") )
		return notify_fail("你的伏魔杖级别还不够，使用这一招会有困难！\n");
	if( (int)me->query("force") < 50 )      
		return notify_fail("你的内力不够。\n");
	if( !objectp(weapon=me->query_temp("weapon"))
	 || weapon->query("skill_type")!="sword" )
	 	return notify_fail("你的剑呢？\n");
	if( weapon->query("use_apply_skill")
	 && weapon->query("use_apply_skill")=="staff" )
	        return notify_fail("你已经「化剑为杖」了。\n");  
        me->add("force", -50);
        message_vision(HIY"$N"HIY"招式一转，手中"+weapon->query("name")+HIY"越舞越快，化剑为杖，怪招迭出。\n" NOR, me);
        weapon->set("use_apply_skill","staff");
        me->reset_action();
        
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me,weapon:),300);
 	return 1;
}
 
void remove_effect(object me, object weapon)
{
	if( me && weapon && present(weapon,me) )
	{
		weapon->delete("use_apply_skill");
		if( weapon==me->query_temp("weapon") )
			me->reset_action();
		message_vision(HIY"$N"HIY"深吸了一口气，收起招式，"+weapon->query("name")+HIY"恢复了常态。\n"NOR,me);
	}
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：化剑为杖
        外功所属：晓风残月剑
        外功效果：使手中长剑支持杖法攻击
        	  时效五分钟
        外功条件：
        	  五庄观弟子
        	  人物等级10级	
                  内力50点，消耗50点
                  晓风残月剑100级
                  伏魔杖100级
                  内功激发镇元神功
                  
STR;
        me->start_more(str);
        return 1;
}