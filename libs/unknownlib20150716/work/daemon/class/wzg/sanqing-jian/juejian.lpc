#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string str;
  int wp, dp, i;

  if (me->query_level() < 45)
    return notify_fail("你的人物等级不够。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query_skill("sanqing-jian", 1) < 400)
    return notify_fail("你的三清剑法级别还不够，使用这一招会有困难！\n");
  if (time() < me->query_temp("wzg_juejian") + 4)
    return notify_fail("你不能频繁使用。\n");
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招「绝剑诀」？\n");

  message_vision(HIC "$N" HIC "深深吸了一口真气，足尖轻轻点地，身形腾空而起，凌空向$n" HIC "使出了「绝剑诀」！\n" NOR, me, target);
  me->set_temp("wzg_juejian", time());
  me->add("force", -100);
  me->set_temp("SQJ_perform", 7);
  me->reset_action();

  wp = me->query_skill("sanqing-jian", 1) / 10;
  if (wp < 15)
    wp = 15;
  if (wp > 50)
    wp = 50;
  dp = me->query_skill("sword");

  target->add_temp("apply/defense", -wp);
  target->add_temp("apply/combat_parry", -wp);
  me->add_temp("apply/attack", wp);
  me->add_temp("apply/combat_damage", dp);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  target->add_temp("apply/defense", wp);
  target->add_temp("apply/combat_parry", wp);
  me->add_temp("apply/attack", -wp);
  me->add_temp("apply/combat_damage", -dp);

  me->delete_temp("SQJ_perform");
  me->reset_action();
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：绝剑诀
        外功所属：三清剑法
        外功效果：短时间内提高自身的命中和伤害，并降低对方的闪避与招架
        	  进行物理攻击
                  冷却4秒
        外功条件：
        	  人物等级45级	
                  内力300点，消耗100点
                  三清剑法400 级
STR;
  me->start_more(str);
  return 1;
}
