//「醉剑诀」　by qingniu 06/2009
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg,succ_msg;
        object weapon;
        int damage,p;

	if( me->query_level()<50 )
		return notify_fail("你的人物等级不够。\n");
	weapon=me->query_temp("weapon");
	if( !weapon 
	 || me->query_skill_mapped("sword")!="sanqing-jian"
	 || (weapon->query("skill_type")!="sword"
	  && weapon->query("use_apply_skill")!="sword") )
		return notify_fail("「醉剑诀」乃是三清剑法的绝技。\n");
        if((me->query("family/family_name") != "五庄观" ) && !wizardp(me))
                return notify_fail("非镇元门生不得使用「醉剑诀」！\n");        
        if((int)me->query_skill("taiyi", 1) < 500)
                return notify_fail("你的太乙仙法修为太浅，无法使用「醉剑诀」。\n");
        if((int)me->query_skill("sanqing-jian", 1) <500)
                return notify_fail("你的三清剑法修为太浅，无法使用「醉剑诀」。\n");
        if((int)me->query("force") < 800 )
                return notify_fail("你的内力不够，没办法使用「醉剑诀」。\n");
        if( time()<me->query_temp("wzg_bxzui")+7 )
                return notify_fail(HIR"你忽然觉得酒意已浓，猛然收住攻势！\n"NOR);

	if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("你要对谁使用「醉剑诀」？\n");

        msg = HIG "\n只见$N"HIG"突然解下腰中的白玉葫芦，于战局之中竟然庞若无人，仰天长饮仙酒飘香之际，向$n"HIG"使出了五庄绝学“「醉剑诀」”。\n" NOR;
        message_vision(msg, me, target);
        me->add("force", -250);
        me->set_temp("wzg_bxzui",time());
        me->add_temp("apply/attack",50);
        me->set_temp("pfm_msg",1);
        
        p = 10;
        if( (int)me->query_condition("drunk")>0 )
        	p*= 2;
        msg = HBBLU "「铁拐李旋踵膝撞醉还真」，$N"HBBLU"踉踉跄跄朝$n"HBBLU"撞去！\n" NOR;
        succ_msg = HIR"结果$n"HIR"脚步踉跄，顿时动弹不得。\n" NOR;
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,0,p);
        if( damage>0 && !target->is_busy() )
        	target->start_busy(3);
        else	message_vision(YEL "结果$N"YEL"以静制动，应付自如。\n" NOR,target);
        	
        msg = "\n"HBBLU"「韩湘子擒腕击胸醉吹箫」，$N"HBBLU"以剑作箫，一缕剑气直刺$n"HBBLU"$l！\n"NOR;
	succ_msg = HIR"$n"HIR"浑噩不觉，只觉心里一酸，不由泪眼迷离。\n" NOR;
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,0,p);
        
        msg = "\n"HBBLU"「汉钟离，跌步抱酲兜心顶」，$N"HBBLU"收剑团身，合身撞向$n"HBBLU"！\n"NOR;
        succ_msg = HIR"$n"HIR"胸口巨震，脚步踉踉跄跄。\n"NOR;
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,succ_msg,"胸口",p);
        
        msg = "\n"HBBLU"「蓝采和，单提敬酒拦腰破」，$N"HBBLU"手中$w"HBBLU"风驰电掣，朝$n"HBBLU"拦腰扫去！\n"NOR;
        succ_msg = HIR"$n"YEL"顿时五脏挪移，感觉疼痛深入骨髓。\n" NOR;
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,"腰间",p,"kee");

        me->add_temp("apply/attack",30);        
        p = 20;
        if( (int)me->query_condition("drunk")>0 )
        	p*= 2;
        if( me->query_skill("sanqing-jian",1)>=450 )
	{
		msg = "\n"HBBLU"「何仙姑，弹腰献酒醉荡步」，$N"HBBLU"手中$w"HBBLU"发出绚烂夺目的光华！\n"NOR;
        	succ_msg = HIR"$n"HIR"顿时眼神恍惚，一时难辨方向。\n" NOR;
        	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,p,"kee");
		if( damage>0 && !target->is_no_move() )
        		target->start_no_move(3+random(3),"你被"+me->name()+"的剑光闪了眼。\n");
        }
        p = 30;
        if( (int)me->query_condition("drunk")>0 )
        	p*= 2;	
        if( me->query_skill("sanqing-jian",1)>=500 )
	{
        	msg = "\n"HBBLU"「曹国舅，仙人敬酒锁喉扣」，$N"HBBLU"手中$w"HBBLU"飞舞灵动，如毒蛇般刺向$n"HBBLU"颈部！\n"NOR;
        	succ_msg = HIR"$n"HIR"只觉咽喉一紧，剑气透体而入。\n" NOR;
        	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,"颈部",p,"kee");
        }
        if( me->query_skill("sanqing-jian",1)>=550 )
	{
        	msg = "\n"HBBLU"「张果老，醉酒抛杯踢连环」，$N"HBBLU"将手一抖，连发数道剑气冲向$n"HBBLU"$l！\n"NOR;
        	succ_msg = HIR"$n"HIR"连续受创，已到垂死边缘。\n" NOR;
        	damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,p,"kee");
        }
	me->add_temp("apply/attack",-30);
	
        p = 50;
        if( (int)me->query_condition("drunk")>0 )
        	p*= 2;
        msg = "\n"HBBLU"「吕洞宾 醉酒提壶力千钧」，$N"HBBLU"手中$w"HBBLU"化作一道长虹，直奔$n"HBBLU"$l而去！\n"NOR;
        succ_msg = HIR"$n"HIR"目瞪口呆，被这一剑势惊呆。\n" NOR;
        me->set_temp("SQJ_perform",7);
        me->add_temp("apply/attack",150);
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg,succ_msg,0,p);
	me->add_temp("apply/attack",-150);
	
        me->delete_temp("SQJ_perform");
        me->delete_temp("pfm_msg");
        me->add_temp("apply/attack",-50);
        me->reset_action();
        return 1;
}

int help(object me)
{
string str;     
if ( !me )      return 0;
str = @LONG
        外功名称：醉剑诀
        外功所属：三清剑法
        外功效果：连续攻击对方
        	  醉酒状态下固定伤害翻倍
        	  最多八击，后四击法术型气血伤害        	  
                  冷却时间7秒
        外功条件：
                  五庄观弟子
                  人物等级50级	
                  内力800点，消耗250点
                  太乙仙法500级
                  三清剑法500级
LONG;
me->start_more(str);
return 1;
}


