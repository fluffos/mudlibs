// Move.c 星移斗转
// Cracked by 凌惊雪 5-17-2003
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int check_action(object who,string type)
{
	if( !who || !type )
		return 0;
	if( who->query("family/family_name")=="五庄观" )
	{
		switch(type)
		{
			case "dodge" : return -50;
			case "parry" : return -50;
			case "damage": return 125;
			default : return 0;
		} 
	}
	else
	{
		switch(type)
		{
			case "dodge" : return -30;
			case "parry" : return -30;
			case "damage": return 80;
			default : return 0;
		}
	}	
}

int perform(object me, object target)
{
	int i,k;
	string msg;
	object weapon;
	mapping style;
	
	if( me->query_level()<45 )
		return notify_fail("你的人物等级不够。\n");
	if( me->query("force") < 500 )
        	return notify_fail("你的内力不足！\n");        
	if( me->query_skill("sanqing-jian", 1) <450)
        	return notify_fail("你的三清剑法等级还不够！\n");
	weapon = me->query_temp("weapon");
	if( !weapon 
	 || (weapon->query("skill_type")!="sword"
	  && weapon->query("use_apply_skill")!="sword") )
		return notify_fail("你的剑呢？\n");	  
			
	if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
        	return notify_fail("你要对谁施展这一招「驭星诀」？\n");

	style= ([
		"action": "\n",
		"weapon": "剑气",
		"damage_type": "刺伤",
		"dodge"	: check_action(me,"dodge"),
		"parry"	: check_action(me,"parry"),
        	"damage": check_action(me,"damage"),
	]);

	me->add_temp("apply/attack",50);
	me->set_temp("pfm_msg",1);
	me->set("actions",style);
	
	msg = HIG "\n$N"HIG"脚踩连环七星步，手中$w"HIG"电光火石间闪出无数道剑气！$n"HIG"周围顿时上下繁星闪烁，叫人不知所措！\n"NOR;
	msg+= HIY"$N"HIY"使出一招"HIC"「"NOR REV HIY"天枢剔斗"NOR HIC"」"HIY"，剑光闪烁不定，若有若无地刺向$n"HIY"$l！\n"NOR;
	me->add("force",-150);
	if(me->query("family/family_name")!="五庄观") 
		me->add("force",-50);
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,0,0,100);
	
	msg = HIC"\n$N"HIC"脚下踏了个七星步，一招"HIC"「"NOR REV HIC"天璇射月"NOR HIC"」"HIY"手中$w"HIC"势若飞瀑向$n"HIC"拦腰一斩！\n"NOR;
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg);

	msg = HIG"\n$N"HIG"轻轻一跃，使了个"HIC"「"NOR HIG"天机开展"NOR HIC"」"HIG"，却在转身之际对准$n"HIG"$l斜斜挥出一剑！\n"NOR;
	COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,0,0,150);
	
	if( me->query_skill("sanqing-jian",1)>=300 )
	{
		msg = HIB"\n$N"HIB"神态悠闲，手中$w"HIB"凭空一指，一招"HIC"「"NOR REV HIB"天权银河"NOR HIC"」"HIB"轻妙地划向$n"HIB"的$l！\n"NOR;
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,0,0,200);	
	}
	
	if( me->query_skill("sanqing-jian",1)>=350 )
	{
		msg = HIM"\n$N"HIM"手中$w"HIM"向外一分，使一招"HIC"「"NOR REV HIM"玉衡百里"NOR HIC"」"HIM"反手对准$n"HIM"$l一剑刺去！\n"NOR;
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,0,0,250);			
	}
	
	if( me->query_skill("sanqing-jian",1)>=400 )
	{
		msg = HIR"\n$N"HIR"身形转个不停，突然一招"HIC"「"NOR REV HIR"开阳星流"NOR HIC"」"HIR"使出，手中$w"HIR"划出一道银弧，径刺$n"HIR"$l！\n"NOR;
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_QUICK,msg,0,0,300);
	}
	
	if( me->query_skill("sanqing-jian",1)>=500
	 && me->query("family/family_name")=="五庄观" )
	{
		msg = HIW"\n$N"HIW"手中$w"HIW"平平一挥，平平无奇的点向$n"HIW"的周身大穴，$n"HIW"大惑不解，一愣神间，剑尖已经涌射出无限剑气，正是五庄剑法之极致"HIC"「"NOR REV HIW"万流归宗"NOR HIC"」"HIW"！\n"NOR;
		me->add_temp("apply/attack",150);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,0,0,500,"kee");
		me->add_temp("apply/attack",-150);
	}
	me->add_temp("apply/attack",-50);
	me->delete_temp("pfm_msg");
	me->reset_action();  
	me->start_busy(2);
	return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：驭星诀
        外功所属：三清剑法
        外功效果：对敌进行最多7次的连续攻击
                  最后一击为法术型气血攻击
                  自身busy 2 秒
                  
        外功条件：
        	  人物等级45级	
                  内力500点，消耗150点
                  三清剑法450级并激发
STR;
        me->start_more(str);
        return 1;
}