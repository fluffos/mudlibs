// moon_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  me->receive_damage("kee", 200);
  me->receive_damage("sen", 200);
  me->set_temp("death_msg", "被雷击而亡。\n");
  me->apply_condition("thunder_poison", duration - 1);
  message(
    "vision",
    HIG "一道雷光在" + me->name() + HIG "身上窜起，霹雳声中，" + me->name() + "浑身一颤。\n" NOR,
    environment(me),
    me
  );
  tell_object(me, "你感到伤口传来一阵阵酸麻！\n" NOR);
  if (me->is_fighting() && !me->is_busy() && random(3) == 1)
    me->start_busy(1);
  if (duration < 1) {
    if (me->query_temp("death_msg") == "被雷击而亡。\n")
      me->delete_temp("death_msg");
    return 0;
  }
  return 1;
}

int no_apply(object who) {
  string fam;
  if (!who || !living(who))
    return 0;
  if (random(who->query_mana() / 10) < 50)
    return 0;
  if (random(who->query_skill("pingfeng", 1) / 10) > 10) {
    message_vision(HIG "$N" HIG "脸上闪出一抹青气，屏风四扇门飞快运转，压制住了体力的雷电之气。\n" NOR, who);
    return 1;
  }
  return 0;
}
