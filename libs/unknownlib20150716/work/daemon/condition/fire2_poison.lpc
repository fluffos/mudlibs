// moon_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  int damage;
  if (duration > 4)
    duration = 4;
  if (random(duration) > 0)
    return 1;
  damage = duration * 180;
  me->receive_damage("sen", damage);
  me->receive_wound("sen", damage);
  me->set_temp("death_msg", NOR RED "火毒" NOR HIM "攻心而死。\n" NOR);

  me->apply_condition("fire2_poison", duration - 1);
  message(
    "vision",
    RED "一道火苗从" + me->name() + RED "身上无由窜起，直通心灵，" + me->name() + RED "脸色一阵扭曲，现出狰狞之色。\n" NOR,
    environment(me),
    me
  );
  tell_object(me, HIB "你感到心神一阵不宁。\n" NOR);
  if (duration < 1) {
    if (me->query_temp("death_msg") == NOR RED "火毒" NOR HIM "攻心而死。\n" NOR)
      me->delete_temp("death_msg");
    return 0;
  }
  return 1;
}

int no_apply(object who) {
  string fam;
  if (!who || !living(who))
    return 0;
  fam = who->query("family/family_name");
  if (!fam || (fam != "火云洞" && fam != "大雪山"))
    return 0;
  if (random(who->query_maxforce()) < 500)
    return 0;
  if (fam == "火云洞")
    message_vision(RED "$N" RED "身上红光一闪，顿时将身上的火毒压制住了。\n" NOR, who);
  else message_vision(WHT "$N" WHT "身上寒气一闪，顿时将身上的火毒压制住了。\n" NOR, who);
  return 1;
}
