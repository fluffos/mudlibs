// moon_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	me->receive_damage("kee", 500);
	me->receive_wound("kee", 500);
	me->set_temp("death_msg","火毒攻心而死。\n");
	if( duration>4 )
		duration = 4;
	me->apply_condition("fire_poison", duration-1);
	message("vision",HIR+me->name()+HIR"身上忽地窜起一道火苗，一股焦臭顿时传来。\n"NOR,environment(me),me);
	tell_object(me, HIR "你感到伤口传来一阵阵疼痛！\n" NOR );
	if( duration < 1 )
	{
		if( me->query_temp("death_msg")=="火毒攻心而死。\n" )
			me->delete_temp("death_msg");
		return 0;	
	}
	return 1;
}

int no_apply(object who)
{
	string fam;
	if( !who || !living(who) )
		return 0;
	fam = who->query("family/family_name");
	if( !fam || (fam!="火云洞"&&fam!="大雪山") )
		return 0;
	if( random(who->query_maxforce())<500 )
		return 0;
	if( fam=="火云洞" )	
		message_vision(HIR"$N"HIR"身上红光一闪，顿时将身上的火毒压制住了。\n"NOR,who);
	else	message_vision(HIW"$N"HIW"身上寒气一闪，顿时将身上的火毒压制住了。\n"NOR,who);	
	return 1;
}