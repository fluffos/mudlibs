mapping *action = ({
  ([ "action": "$N使出一招" + HIR "「星河影动」" NOR + "，剑光闪烁不定，若有若无地刺向$n$l。\n",
    "dodge": 0,
    "parry": 15,
    "damage": 75,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身形转个不停，突然一招" + HIY "「一点灵犀」" NOR + "使出，手中$w划出一道银弧，径刺$n$l。\n",
    "dodge": -10,
    "parry": -15,
    "damage": 75,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N脚下踏了个七星步，一招" + HIM "「古道西风」" NOR + "手中$w势若飞瀑向$n拦腰一斩。\n",
    "dodge": -5,
    "parry": -15,
    "damage": 80,
    "damage_type": "劈伤"
  ]),
