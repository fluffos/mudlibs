#include <ansi.h>
#include <combat.h>
inherit SKILL;

string *msg1 = ({
  "运足力气，",
  "一声高叫：还不缚手就擒！",
  "略略一退，旋即一个跨步，",
  "暗运真气，",
  "使了个巧劲，",
});

string *msg2 = ({
  "$W抡了几个大圆，",
  "手中的$W一绞，",
  "$W带出飞沙走石般的杖风，",
  "$W划出一道弧光，",
  "横持$W，只见杖头一跳，",
  "$W望上一挑，",
});

string *msg3 = ({
  "“镗”的一声，格开了。",
  "将其挡住。\n",
  "“镗”的一声，挡住了。",
});

mapping *action = ({
  ([ "action": "$N运足力气将$w抡了几个大圆，呼！地一声向$n当头砸下。\n",
    "dodge": 5,
    "parry": -15,
    "damage": 95,
    "damage_type": "砸伤"
  ]),
  ([ "action": "只听$N一声高叫：还不缚手就擒！手中的$w一绞，扫向$n$l。\n",
    "dodge": 0,
    "parry": -20,
    "damage": 115,
    "damage_type": "砸伤"
  ]),
  ([ "action": "$N使出一招「群魔伏首」，手中的$w带出飞沙走石般的杖风压向$n的$l。\n",
    "dodge": -5,
    "parry": -25,
    "damage": 130,
    "damage_type": "砸伤"
  ]),
  ([ "action": "只见$N略略一退，旋即一个跨步，$w划出一道弧光刺向$n$l。\n",
    "dodge": -10,
    "parry": -30,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N横持$w，暗运真气，忽然间只见杖头一跳，灵蛇般钻向$n的$l。\n",
    "dodge": -15,
    "parry": -20,
    "damage": 115,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N的$w望上一挑，中途却使了个巧劲，杖尾嗖！地一翻，砸向$n$l。\n",
    "dodge": -15,
    "parry": -30,
    "damage": 125,
    "damage_type": "砸伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  if ((int)me->query_maxforce() < 100)
    return notify_fail("你的内力不够，没有办法学伏魔杖。\n");
  if (!(objectp(ob = me->query_temp("weapon")))
    || (string)ob->query("skill_type") != "staff")
    return notify_fail("你必须先找一条禅杖才能学伏魔杖。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "staff") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

varargs int practice_skill(object me, int flag) {
  if ((int)me->query("kee") < 30 || (int)me->query("force") < 5)
    return notify_fail("你现在太累了，强练无益。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  if (flag)
    write("你按着所学练了一遍伏魔杖。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("wzg") + "/fumo-zhang/" + func;
}

string query_parry_msg(object me, object target) {
  return "结果$n" + msg1[random(sizeof(msg1))] + msg2[random(sizeof(msg2))] + msg3[random(sizeof(msg3))] + "\n";
}
