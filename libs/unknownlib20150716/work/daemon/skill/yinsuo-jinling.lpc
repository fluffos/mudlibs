string query_parry_msg(object me,object target)
{
	return "结果$n"+parry_msg1[random(sizeof(parry_msg1))]+"一式"+parry_msg2[random(sizeof(parry_msg2))]+parry_msg3[random(sizeof(parry_msg3))];	
}

void remove_effect(object me)
{
	if( !me )	
		return;
	if( me->query_temp("psd_wang") )
	{	
		me->set_temp("psd_wang_end",time());
		me->delete_temp("psd_wang");
		message_vision(HIW"$N"HIW"收起了银线。\n"NOR,me);
	}
}

