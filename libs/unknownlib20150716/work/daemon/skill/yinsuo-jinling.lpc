void postwang(object me,object target,object weapon, int damage)
{
	string msg;
	int succ;
        if( !me || me->query_temp("psd_wang")<=0 )
        	return;
	me->add_temp("psd_wang",-1);
	if( me->query_temp("psd_wang")<=1 
	 || !living(me) || me->query("force")<50 )
	{
		remove_effect(me);
		return;
	}
	if( !weapon || weapon!=me->query_temp("weapon") )
		weapon = me->query_temp("weapon");
	if( !weapon 
    	 || ( weapon->query("skill_type") != "whip" 
    	   && weapon->query("use_apply_skill") != "whip" ) )
	{
		remove_effect(me);
		return;
	}
	if( !target )  target = SSERVER->offensive_target(me);
	if( !target
 	 || !target->is_character()
 	 || target->is_corpse()
 	 || target==me 
 	 || !me->is_fighting(target) )
		return; 
	
	msg = "\n"+chan_msg[random(sizeof(chan_msg))];
	msg+= chaned[random(sizeof(chaned))];
	msg = replace_string(msg,"$R",number_msg[random(sizeof(number_msg))]);
	msg = replace_string(msg,"$S",whip_msg[random(sizeof(whip_msg))]);
	msg = replace_string(msg,"$w",weapon->name(1));

	me->add_temp("apply/attack",15);
	succ = COMBAT_D->attack_percent(me,target,TYPE_PERFORM);
	me->add_temp("apply/attack",-15);
	
	if( succ>0 )
	{
		me->add_temp("psd_wang",-5);
		if( !target->is_busy() )
			target->start_busy(1+random(2));
		msg = COLOR_D->clean_color(msg);
		msg = COLOR_D->replace_color(HIW+msg)+NOR;
		message_combatd(msg,me,target);			
		damage = COMBAT_D->valid_damage(me,target,"yinsuo-jinling",TYPE_PERFORM);
		if( damage>0 )
		{
			target->receive_wound("kee", damage,me,TYPE_PERFORM);
			COMBAT_D->report_status(target,1);
		}
	}	
	else	
	{
		me->add_temp("psd_wang",-3);
		msg = dodged[random(sizeof(dodged))];
		msg = COLOR_D->clean_color(msg);
		msg = COLOR_D->replace_color(HIW+msg,2)+NOR;
		message_combatd(msg,me,target);
	}
}
