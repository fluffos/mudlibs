#include <ansi.h>
inherit SKILL;

mapping *action = ({
        ([      "action" : "$N轻抚手中的$w，突然间只见刀光一闪，再闪，又一闪！三道刺骨的寒气已然袭上了$n的$l。\n",
     		"damage":     55,
     		"damage_type":     "割伤"
        ]),
        ([      "action": "只见$N倒提$w，身形急冲，就在与$n错身之际，突然反手一刀从$n后脑斜劈而下。\n",
     		"dodge":     5,
     		"parry":     5,
		"damage":    60,
                "damage_type":     "劈伤"
        ]),
        ([      "action": "$N斜身飞起，带出一片匹练也似的刀光卷向$n的$l。\n",
                "damage":                  45,
                "damage_type":     "劈伤"
        ]),
        ([      "action": "$N突然一脚踢出，手中的$w划出一道轻妙的圆弧，淡淡的刀光封住了$n的头脸，切断了$n的呼吸。\n",
		"dodge":     -5,
     		"parry":     -5,
		"damage":    70,
                   "damage_type":     "割伤"
        ]),
        ([      "action": "只见$N脸色一寒，一招「千里冰封」使出，从眉捷到脚跟，$n周身的血液都似被这无尽的刀势冻住，而生命也仿佛要离体而去。\n",
		"dodge":  -10,
     		"parry":  -10,
		"damage":   85,
                   "damage_type":     "劈伤"
        ]),   
        ([      "action": "$N刀势渐慢，而$w上带出的寒气却越来越浓。就在这时，$n的心头一紧，一道比针尖还要锐利的寒气已刺上了$n$l。\n",
		"dodge":                   -15,
     		"parry":     -15,
		"damage": 90,
		"damage_type":     "刺伤"
        ]),   
        ([      "action": "$N也不管三七二十一，高举$w呼！地就是一刀向$n迎面斩下！虽然只有一刀，可怕的刀势却似万古不化的寒冰封死了$n的一切退路。\n",
		"dodge":                   -20,
     		"parry":     -20,
		"damage":   100,
		"damage_type":     "劈伤"
        ]),   
});

