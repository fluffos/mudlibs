//神通技能 移景	反弹伤害减免
#include <ansi.h>
inherit SKILL;

string type() { return "shentong"; }

int valid_learn(object me)
{
	if( me && me->query_level()>=90 && me->query("shentong/90") 
	 && me->query("dntg/hell")=="done" )
	 	return 1;
	return notify_fail("你还不符合激活「移景」的条件。\n");
}

varargs int practice_skill(object me,int v)	
{
	if( me && me->query_level()>=90 && me->query("shentong/90") 
	 && me->query("dntg/hell")=="done" )
	 	return 1;
	return notify_fail("你还不符合激活「移景」的条件。\n");
}