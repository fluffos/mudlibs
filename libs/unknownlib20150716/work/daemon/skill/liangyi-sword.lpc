// liangyi-sword. 【两仪剑法】
/*
两仪剑法    dodge  -10    parry  -10    damage  15
此剑法为菩提祖师年少之时偶然悟出，共八式，分为阴阳二部，威力不算强，但练习
时一招一式与体内阴阳之气相合，于内功修为颇有益处。
*/

// 阴：幻，绕，缠，点
// 阳：劈，砍，刺，扑
#include <ansi.h>
#include <combat.h>
inherit SKILL;

string *msg1 = ({
        "一抖手中的$W，",
        "手中的$W突然弯了过来，",
        "手中$W连续划出几个光环，",
        "一转身，手中$W从腋下反刺而出，",
        "手中$W自上而下，",
        "身子一侧，$W平着挥出，",
        "$W中宫直进，",
});

string *msg2 =({
        "将之格开。",
        "将之凌空弹开。",
        "将之卸在一旁。",
        "“镗”的一声，将之格开。",
        "“镗”的一声挡住了。",        
});

string query_parry_msg(object me,object target)
{
	return "结果$n"+msg1[random(sizeof(msg1))]+msg2[random(sizeof(msg2))]+"\n";	
}

mapping *action = ({
	([	"action" : "$N一抖手中的$w，瞬间刺出三十六剑，$n顿时手忙脚乱，分不清虚实。\n",
		"dodge":		-10,
                "parry":                -20,
		"damage":		55,
		"damage_type":		"刺伤"
	]),
	([	"action" : "$N一剑刺向$n，$n急忙向旁边一闪，不料$N一运劲儿，手中的$w突然弯了过来，转而刺向$n的$l。\n",
		"dodge":		-25,
                "parry":                -15,
		"damage":		55,
		"damage_type":		"刺伤"
	]),
	([	"action" : "$N手中$w连续划出几个光环，一阵吸力带得$n向前踏出一步，$N左手剑指已刺向$n的$l。\n",
		"dodge":		-20,
                "parry":                -30,
		"damage":		60,
		"damage_type":		"刺伤"
	]),
	([	"action" : "$N一转身，背向$n，手中$w从腋下反手刺向$n的$l。\n",
		"dodge":		-25,
                "parry":                -30,
		"damage":		60,
		"damage_type":		"刺伤"
	]),
	([	"action" : "$N举起手中的$w，自上而下，劈向$n的$l。\n",
		"dodge":		0,
                "parry":                -10,
		"damage":		95,
		"damage_type":		"割伤"
	]),
        ([      "action" : "$N身子一侧，手中的$w平着挥出，砍向$n的$l。\n",
                "dodge":                -5,
                "parry":                -5,
                "damage":      		115, 
                "damage_type":  	"割伤"
        ]),
	([      "action" : "$N向前踏出半步，手中$w中宫直进，刺向$n的前心。\n",
                "dodge":                -10,
                "parry":                0,
                "damage":     		120,
                "damage_type":  	"刺伤"
        ]),
	([      "action" : "$N双脚一顿，身子凌空，头下脚上，手中$w刺向$n的头顶。\n",
                "dodge":                -5,
                "parry":                -5,
                "damage":               120,
                "damage_type":  	"刺伤"
        ]),
});

int valid_learn(object me)
{
	object ob;
	if( (int)me->query_maxforce() < 50 )
		return notify_fail("你的内力不够，没有办法练两仪剑法。\n");
	if( (string)me->query_skill_mapped("force")!= "wuxiangforce")
        	return notify_fail("两仪剑法必须配合方寸山的小无相功才能练。\n");
	if( !(ob = me->query_temp("weapon"))
	 || (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能练剑法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

varargs int practice_skill(object me,int flag)
{
	int flvl=(int)me->query_skill("force");
	int slvl=(int)me->query_skill("sword");

	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("你的内力或气不够，没有办法练习两仪剑法。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	if( flag )
		write("你按著所学练了一遍两仪剑法。\n");
        if( me->query("family/family_name")=="方寸山三星洞"
         && random(slvl)>flvl )
         	me->improve_skill("force", 1);
	return 1;
}

string perform_action_file(string func)
{
	return CLASS_D("fc") + "/liangyi-sword/" + func;
}
