//长拳 changquan.c
#include <ansi.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
        ([      "action" : "只见$N右脚撇步上前，成扣步坐定，一招「双抄封天」双手化掌，向前双抄而上，攻向$n。\n",
                "dodge" : 5,
                "parry" : 5,
            	"damage": 50,
                "damage_type":  "砸伤"
        ]),
        ([      "action" : "$N一个弓步，腰间双掌一个双撑掌直推$n而出，这一招「冲步双掌」名不虚传。\n",
                "dodge" : 0,
                "parry" : 0,
            	"damage": 80,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N右拳在$n面门一晃，左手使了个「回首双刁」往$n的$l狠命一抓。\n",
                "dodge" : -5,
                "parry" : -5,
            	"damage": 80,
            	"weapon": "左爪",
                "damage_type":  "抓伤"
        ]),
        ([      "action" : "$N步履一沉，左拳拉开，右拳带风，一招「进步冲捶」势不可挡地击向$n$l。\n",
                "dodge" : -5,
                "parry" : -5,
            	"damage": 90,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N步履一沉，右拳拉开，左拳带风，一招「弓步冲打」势不可挡地击向$n$l。\n",
                "dodge" : -10,
                "parry" : -10,
            	"damage": 90,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "只见$N拉开架式，一招「魁星踢斗」，飞起一脚踢向$n$l。\n",
                "dodge" : -15,
                "parry" : -15,
            	"damage": 95,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N打得兴起，大喝一声：看我这招「扭步断肘」，右手以平肘便往$n面门砸了过去。\n",
                "dodge" : -20,
                "parry" : -20,
            	"damage": 95,
            	"weapon": "右肘",
                "damage_type":  "砸伤"
        ]),
        ([      "action" : "$N拉开后弓步，双掌使了个「双采冲捶」往$n的$l一推。\n",
                "dodge" : -25,
                "parry" : -25,
            	"damage": 100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "只见$N运足气力，连连发拳击向$n$l，力道一拳高过一拳！这一招的名字叫作「马式挑打」。\n",
                "dodge" : -25,
                "parry" : -25,
            	"damage": 115,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N往后一纵，就势使了个「斜步插花」，右腿扫向$n的$l。\n",
                "dodge" : -30,
                "parry" : -25,
            	"damage": 115,
            	"weapon": "右腿",
                "damage_type":  "砸伤"
        ]),
        ([      "action": "$N一个转身，左掌护胸，右掌反手如棍，使了个「落步盘花」往$n当头一劈。\n",
                "dodge" : -35,
                "parry" : -25,
            	"damage": 120,
            	"weapon": "右臂",
                "damage_type":  "砸伤"
        ]),
        ([      "action": "$N飞身跃起，半空中一脚踢向$n面门，却是一招「朝天一蹬」。\n",
                "dodge" : -35,
                "parry" : -35,
            	"damage": 120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N一招「回身挫捶」，全身原地左转，双手顺势向左，先左後右，以双封手连续封出，直冲$n$l。\n",
                "dodge" : -35,
                "parry" : -35,
            	"damage": 125,
                "damage_type":  "瘀伤"
        ]),
        ([      "action" : "$N双掌向前反切而出，一招「回步双切」，发出一阵巨响，直劈$n$l。\n",
                "dodge" : -45,
                "parry" : -45,
            	"damage": 150,
                "damage_type":  "瘀伤"
        ]),
        
});

int valid_learn(object me)
{
	object weapon;
        if( objectp(weapon=me->query_temp("weapon"))
         && weapon->query("skill_type")!="unarmed" )
                return notify_fail("练长拳必须空手或装备拳套。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30 )
        	return notify_fail("你现在手足酸软，休息一下再练吧。\n");
    	if( (int)me->query("force") < 10 )
        	return notify_fail("你的内力不够了。\n");
	me->receive_damage("kee", 30);
    	me->add("force", -10);
	return 1;
}

string perform_action_file(string func)
{
	return CLASS_D("jjf") + "/changquan/"+func;
}

