int valid_learn(object me) {
  object ob;

  if ((int)me->query_maxforce() < 100)
    return notify_fail("你的内力修为不够深，不能学惊雷鞭法。\n");
  if ((string)me->query_skill_mapped("force") != "lengquan-force")
    return notify_fail("惊雷鞭法必须配合将军府的冷泉神功才能练。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "mace")
    return notify_fail("手里没有兵器怎么练？\n");
  return 1;
}

varargs int practice_skill(object me, int flag) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你体质欠佳，强练惊雷鞭法有害无益。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你内力不足，强练惊雷鞭法有走火入魔的危险。\n");
  //斧系或是枪系不可学
  if (me->query("family/jjf_type") && me->query("family/jjf_type") != "mace")
    return notify_fail("你既不是将军府鞭系亲兵，自然不能再练惊雷鞭法。\n");
  me->receive_damage("kee", 10);
  me->add("force", -5);
  if (flag) message_vision("只见一团黑影中走出$N，原来刚练完惊雷鞭法。\n", me);
  return 1;
}

int valid_enable(string usage) {
  return usage == "mace" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  int v = me->query_skill("jinglei-mace", 1);
  v /= 30;
  if (v > sizeof(action))
    v = sizeof(action);
  return action[random(v)];
}

string perform_action_file(string func) {
  return CLASS_D("jjf") + "/jinglei-mace/" + func;
}

void post_jjf(object me, object victim, object weapon, int damage) {
  if (!me->query_temp("jjf_powerup"))
    return;
  WEAPON_D->bash_weapon(me, victim, weapon, damage);
}

string query_parry_msg(object me, object target) {
  return "结果$n" + parry_msg1[random(sizeof(parry_msg1))] + parry_msg2[random(sizeof(parry_msg2))] + parry_msg3[random(sizeof(parry_msg3))];
}

varargs mixed hit_ob(object me, object victim, int damage_bonus, object weapon, string limb) {
  if (me && victim && living(me) && me->is_fighting(victim)) {
    if (!userp(me) || me->query("mark/jjf_jinglei-mace") > 0)
      return 0;
    me->add("mark/jjf_jinglei-maced", 1);
    if (random(me->query("mark/jinglei-maced") / 60) >= 100) {
      me->delete("mark/jinglei-maced");
      me->set("mark/jjf_jinglei-mace", 1);
      tell_object(me, "\n" HIC "你于战斗之中福至心灵，对" HIR "「惊雷鞭法」" HIC "领悟加深了！\n" NOR);
      return 0;
    }
  }
  return 0;
}
