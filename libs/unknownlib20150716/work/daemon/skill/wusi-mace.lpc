int valid_learn(object me) {
  object ob;
  if ((int)me->query_maxforce() < 150)
    return notify_fail("你的内力不够，不能学无私锏法， 多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "mace")
    return notify_fail("你必须先找一柄锏才能练锏法。\n");
  return 1;
}

varargs int practice_skill(object me, int flag) {
  string myforce = me->query_skill_mapped("force");
  if (myforce != "lengquan-force")
    return notify_fail("无私锏需配合将军府冷泉神功才可发挥威力。\n");
  if ((int)me->query("kee") < 35)
    return notify_fail("你体质欠佳，强练锏法有害无益。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你内力不足，强练无私锏有走火入魔的危险。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  if (flag) message_vision("$N运起内力练了一套无私锏法。\n", me);
  return 1;
}

int valid_enable(string usage) {
  return usage == "mace" || usage == "parry";
}

string perform_action_file(string func) {
  return CLASS_D("jjf") + "/wusi-mace/" + func;
}

mapping query_action(object me, object weapon) {
  int v = me->query_skill("wusi-mace", 1);
  v /= 45;
  if (v > sizeof(action))
    v = sizeof(action);
  return action[random(v)];
}

void post_jjf(object me, object victim, object weapon, int damage) {
  if (!me->query_temp("jjf_powerup"))
    return;
  WEAPON_D->bash_weapon(me, victim, weapon, damage);
}

string query_parry_msg(object me, object target) {
  return "结果$n" + parry_msg1[random(sizeof(parry_msg1))] + parry_msg2[random(sizeof(parry_msg2))] + parry_msg3[random(sizeof(parry_msg3))];
}

varargs mixed hit_ob(object me, object victim, int damage_bonus, object weapon, string limb) {
  if (me && victim && living(me) && me->is_fighting(victim)) {
    if (!userp(me) || me->query("mark/jjf_wusi-mace") > 0)
      return 0;
    me->add("mark/wusi-maced", 1);
    if (random(me->query("mark/wusi-maced") / 60) >= 100) {
      me->delete("mark/wusi-maced");
      me->set("mark/jjf_jinglei-mace", 1);
      tell_object(me, "\n" HIR "你于战斗之中福至心灵，对" HIY "「无私锏法」" HIR "领悟加深了！\n" NOR);
      return 0;
    }
  }
  return 0;
}
