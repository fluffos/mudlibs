    "damage_type": "砸伤"
  ]),
  ([ "action": "$N跃起数尺，居高临下，一锏向$n当头砸下。这招「杀手锏」乃是秦家无私锏中的绝招，果然气势威猛。\n",
    "dodge": -25,
    "parry": -35,
    "damage": 135,
    "post_action": (: post_jjf :),
    "damage_type": "砸伤"
