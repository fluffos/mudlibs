//无私锏法，wusi-mace.c
//created 5-12-97 pickle

/*
无私锏法    dodge  5    parry  -5    damage  25
原名秦家无敌锏，为秦家祖传秘技，后秦琼决定公开传给
大唐官兵，皇上感其无私，赐名无私锏法。此锏法相当实
用，上阵杀敌，势如破竹。
*/
// 呕心，沥血，捕风，捉影，
// 追魂，夺命，杀手，无情。
#include <ansi.h>;
inherit SKILL;

void post_jjf(object me, object victim, object weapon, int damage);

