#include <ansi.h>

inherit SKILL;

mapping *action = ({
        ([      "action": "$N左掌微分，右手一长使出一招"+HIB"「小鬼讨债」"NOR"，一只惨白的利爪探向$n的$l。\n",
                "dodge":                5,
                "parry":                5,
                "force":                130,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N倏地一个转身，双手往脸上一抹，现出"+HIB"「青面缭牙」"NOR"，张口一吹，一股阴风直扑$n。\n",
                "dodge":                -35,
                "parry":                -35,
                "force":                115,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N身子微斜，随即跨出一步，左手忽掌忽爪使出"+HIB"「群魔乱舞」"NOR"，拍向$n的$l。\n",
                "dodge":                -10,
                "parry":                -15,
                "force":                120,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N使出"+HIB"「鬼影幢幢」"NOR"，双手滑溜异常对准$n的$l抓去。\n",
                "dodge":                -5,
                "parry":                -10,
                "force":                110,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N左手虚晃，右掌飘飘，掌心呈碧绿，一招"+HIB"「秋坟鬼唱」"NOR"击向$n$l。\n",
                "dodge":                15,
                "parry":                15,
                "force":                150,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N使出"+HIB"「饿鬼拦路」"NOR"，凌空跃起，冷不防在落地前对准$n$l踢出一脚。\n",
                "dodge":                -15,
                "parry":                -15,
                "force":                150,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N右手在$n$l划过，随后一招"+HIB"「厉鬼缠身」"NOR"左爪又向同一方位抓到。\n",
	    "dodge":                -25,
                "parry":                -25,
                "force":                150,
                "damage_type":  "抓伤"
        ]),
});

int valid_learn(object me)
{
	object weapon;
        if( objectp(weapon=me->query_temp("weapon"))
         && weapon->query("skill_type")!="unarmed" )
                return notify_fail("练惊魂掌必须空手或者装备拳套。\n");
        if( (int)me->query_maxforce() < 50 )
                return notify_fail("你的内力太弱，无法练惊魂掌。\n");
        return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
        int i;
        if( !intp(i=me->query("HellZhen"))
         || i<1 )
        	return action[random(sizeof(action))];
        else 
        {
        	if( i>7 )
        		i = 7;
        	return action[i-1];
        }
}

int practice_skill(object me)
{
	if( (int)me->query("sen") < 40)
		return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
	if( (int)me->query("kee") < 40 )
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");
	if( (int)me->query("force") < 10 )
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("kee", 10);
	me->receive_damage("sen", 10);
	me->add("force", -10);

	return 1;
}

varargs mixed hit_ob(object me, object victim, int damage_bonus,object weapon,string limb)
{
	if(  environment(me)->query("hell") )
	{
		if( !me->is_killing(victim->query("id")) )
			return damage_bonus;
		else	damage_bonus = damage_bonus*2;	
	}
        if( damage_bonus < 100 ) return 0;
        if( random(damage_bonus/2) > victim->query_str() ) 
        {
        	victim->receive_wound("kee", (damage_bonus - 100) / 2 );
                switch(random(3)) {
                        case 0: return RED"$n"RED"听到「喀啦」一声轻响，竟似是骨碎的声音！\n"NOR;
                        case 1: return HIB"$N"HIB"劲力一吐，$n"HIB"的$l发出「喀」地一声爆响！\n"NOR;
                        case 2: return YEL"只听见$n"YEL"的$l「喀」地一声 ...\n"NOR;
                }
        }
}

string perform_action_file(string func)
{
return CLASS_D("ghost") + "/jinghun-zhang/" + func;
}

