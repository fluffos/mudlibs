mapping *action = ({
        ([      "action": "$N面有喜色，手中$w一迎，飘然间「"+BLINK""+HIY"天界求佛"+NOR"」这招业已使出。\n",
                "dodge":                -30,
                "parry":                -20,
                "damage":               60,
                "damage_type":  "刺伤"
        ]),
        ([      "action": "$N满面愁容，情意缠绵，鞭意更缠绵，「"+BLINK""+HIG"人间苦难"+NOR"」使得怅然苦楚，$n为之黯然神伤。\n",
                "dodge":                -30,
                "parry":                -50,
                "damage":               70,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N杀气笼罩一身，$w如铁链般疯狂砸去，「"+BLINK""+HIM"地狱受刑"+NOR"」的威力发挥得淋漓尽致。\n",
                "dodge":                -20,
                "parry":                -40,
                "damage":               80,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N怒发冲冠，$w舞得如天罗地网，$n方悟得这招叫「"+BLINK""+HIR"修罗无敌"+NOR"」。\n",
                "dodge":                -50,
                "parry":                -50,
                "damage":               90,
                "damage_type":  "刺伤"
        ]),
        ([      "action": "$N悲愤之色俱现于形，所生之力贯彻于$w朝$n抽出「"+BLINK""+HIB"饿鬼讨羹"+NOR"」这招。\n",
                "dodge":                -50,
                "parry":                -20,
                "damage":               100,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N百无聊奈，顺手一掷，$w却绷直如箭，朝$n射去，好一招「"+BLINK""+YEL"牲畜投胎"+NOR"」。\n",
                "dodge":                -30,
                "parry":                -30,
                "damage":               110,
                "damage_type":  "刺伤"
        ]),               
        ([      "action": "$N手腕一翻，一招"+BLINK""+HIW"「地藏点卯」"NOR"$w抖得笔直，带出一股锐啸猛刺$n$l。\n",
                "dodge":                -30,
                "parry":                -55,
                "damage":               125,
                "damage_type":  "刺伤"
        ]),
        //8
        ([      "action": "$N大喝一声，手中$w宛若矫龙飞在半空，大有"+BLINK""+HIR"「横空出世」"NOR"的气概。$n只觉得全身俱在$w笼罩之下。\n",
                "dodge":                -20,
                "parry":                -20,
                "damage":               150,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N右手一引，一招"+BLINK""+MAG"「歌舞阎罗」"NOR"$w贴地而飞，再疾卷而上，仿佛带出了地狱中的烈火，夹头夹脑地扑向$n。\n",
                "dodge":                -25,
                "parry":                -35,
                "damage":               145,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "也不知$N如何动了一动，一招"+BLINK""+RED"「枉死城中渡鬼魂」"NOR"但见长空中青光一闪，$n只觉$w已击上了$l。\n",
                "dodge":                -35,
                "parry":                -55,
                "damage":               155,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N身形往前滑出，手中$w霹啪有声，一圈套一圈地卷向$n,好一招"+BLINK""+HIC"「幽冥做鬼上雷音」"NOR"。\n",
                "dodge":                -55,
                "parry":                -20,
                "damage":               165,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "长笑声中$N一个倒翻，手中$w急绞，但见方圆丈许飞沙走石，劲气纵横！$n不知如何才能脱困而出，脸都绿了。\n",
                "dodge":                -35,
                "parry":                -50,
                "damage":               150,
                "damage_type":  "抽伤"
        ]),
        ([      "action": "$N喉咙里发出几声嚎叫，高举$w，不顾一切地冲向$n，几乎与$n贴脸而立！手中$w却悄无声息地刺向$n的$l，好厉害的"+BLINK""+HIB"「小楼夜哭」"NOR"。\n",
                "dodge":                -35,
                "parry":                -45,
                "damage":               150,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N左手虚晃，右掌飘飘，掌心呈碧绿，一招"+BLINK""+HIB"「秋坟鬼唱」"NOR"击向$n$l。\n",
                "dodge":                -40,
                "parry":                -40,
                "damage":                150,
                "damage_type":  "瘀伤"
        ]),
});

string *liudao=({
                NOR"\n"REV HIY"$N"NOR REV HIY"口中唱道：天界道，神仙道，金碧琉璃谁人造? "NOR,
                NOR"\n"REV HIG"$N"NOR REV HIG"口中唱道：人界道，好了道，爱欲痴情谁忘了？"NOR,
                NOR"\n"REV HIM"$N"NOR REV HIM"口中唱道：冥界道，负债道，辜罪刑罚谁还掉？"NOR,
                NOR"\n"REV HIR"$N"NOR REV HIR"口中唱道：修罗道，杀戮道，斗战征伐谁最骁？"NOR,
                NOR"\n"REV HIB"$N"NOR REV HIB"口中唱道：饿鬼道，无常道，卤肴羹炙谁吃到？"NOR,
                NOR"\n"NOR YEL"$N"NOR REV YEL"口中唱道：牲畜道，断欲道，猪狗牛马谁说好？"NOR,
});
                
int valid_learn(object me)
{
        object ob;

        if( (int)me->query_maxforce() < 150 )
                return notify_fail("你的内力不够，没有办法练烈火鞭。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "whip" )
                return notify_fail("你必须先找一根鞭子才能练烈火鞭。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="whip" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	int i;
	if( intp(i=me->query_temp("ldlh"))
	 && i>0 )
	{
		if( i>6 )
		{
			i = 1;
			me->set_temp("lunhui",1);
		}
		return 	action[7+i];
	}	 
	else	return 	action[random(6)];
}
                
varargs int practice_skill(object me,int flag)
{
        if( (int)me->query("kee") < 25
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习烈火鞭。\n");
        me->receive_damage("kee", 25);
        me->add("force", -5);
	if( flag )        write("你按着所学练了一遍烈火鞭。\n");
        return 1;
}

string perform_action_file(string func)
{
return CLASS_D("ghost") + "/hellfire-whip/" + func;
}

varargs mixed hit_ob(object me, object victim, int damage_bonus,object weapon,string limb)
{
	string msg,succ_msg,*sc,*fail;     
	int damage,j;
	if( intp(j=me->query_temp("ldlh"))
	 && me->query("mana")>100 
	 && j>0 )
	{
		me->add_temp("lunhui",1);
		j = me->query_temp("lunhui");
		if( j>6 )
		{
			j = 6;
			me->set_temp("lunhui",0);
		}
		msg = liudao[j-1];
		sc = ({
 			REV HIY"天界美奂美仑，霞举虹飞入目，轻舞罗香侍鼻，丝竹声不绝于耳，$n"NOR REV HIY"陶醉于中而不知返。\n"NOR,
                        REV HIG"$n"NOR REV HIG"想起人世间的殇情冷暖，悲欢离合，不觉黯然。\n"NOR,
                        REV HIM"$n"NOR REV HIM"被阵阵撕心裂肺的叫喊声包围，吓得浑身直冒冷汗。\n"NOR,
                        REV HIR"$n"NOR REV HIR"被从四方赶至的修罗追杀，失措逃亡，精疲力竭。\n"NOR,
                        REV HIB"$n"NOR REV HIB"看到饿鬼的样子感觉自己的喉咙也被勒成只有一条细缝不能进食。\n"NOR,
                        REV YEL"$n"NOR REV YEL"感叹牲畜的愚昧无知和可怜，不知不觉就耽误了行程。\n"NOR,
		}); 
		succ_msg = sc[j-1]; 
		me->add("mana",-50);
		me->set_temp("pfm_msg",1);
                damage = COMBAT_D->do_attack(me,victim,me->query_temp("weapon"),TYPE_CAST_2,msg,succ_msg);
		me->set_temp("pfm_msg",0);
		fail = ({
			REV HIY"$n"NOR REV HIY"不为欲仙欲圣的美景所惑，收紧心神，弹指间便离天界道而去。\n"NOR,
			REV HIG"$n"NOR REV HIG"硬起心肠，无视身旁的是是非非，快步离开人界道。\n"NOR,
			REV HIM"$n"NOR REV HIM"对惨号声不屑于顾，游弋之中胜似闲庭信步。\n"NOR,
			REV HIR"$n"NOR REV HIR"对付修罗游刃有余，很快就杀出一条血路离开了。\n"NOR,
			REV HIB"$n"NOR REV HIB"看到一大群饿鬼就远远的躲了开去。\n"NOR,
			REV YEL"$n"NOR REV YEL"看中了一匹白马，跳上马背星夜兼程离开了牲畜界。\n"NOR,
		});
		if( damage<1 )
		{
			msg = fail[j-1];
			message_combatd(msg,me,victim);
		}
		return 1;
	}
	else if( damage_bonus<1 )
		return 0;
	else if(  environment(me)->query("hell")
	 && me->is_killing(victim->query("id")) )
		return damage_bonus;
	else	return 0;
}

void skill_improved(object me)
{
	if( (int)me->query_skill("hellfire-whip", 1)  % 10 == 0 ) 
	{
        	tell_object(me,RED "\n你突然觉得一股恶气冲上心头，只觉得想杀人....\n\n" NOR);
		me->add("bellicosity", 50);
	} 
	else	me->add("bellicosity", 5);
}

string query_parry_msg(object me,object target)
{
	return "结果"+parry_msg1[random(sizeof(parry_msg1))]+parry_msg2[random(sizeof(parry_msg2))]+parry_msg3[random(sizeof(parry_msg3))];	
}
