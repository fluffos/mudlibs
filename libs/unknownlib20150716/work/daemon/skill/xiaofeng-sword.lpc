/*
晓风残月剑    dodge  -10    parry  0    damage  20
此剑法用意高妙，轻巧潇洒，剑中颇含诗意，多为江湖
年少所喜。
*/

// 皓月当空，水银泄地，花明月暗，清雨朦胧
// 飞花似梦，丝雨如愁，潇湘夜雨，月白风清
// 金波低转
inherit SKILL;
#include <ansi.h>
#include <combat.h>

string *msg1 = ({
        "手中$W连续划出几个光环，",
        "手中$W不停地颤抖着，",
        "手中$W带起点点寒光，",
        "手中$W去势飘忽不定，",
        "$W划出五朵桃花，",
        "手中$W中宫直进，",
});

string *msg2 = ({
	"「皓月当空」，",
	"「水银泄地」，",
	"「花明月暗」，",
	"「清雨朦胧」，",
	"「飞花似梦」，",
	"「丝雨如愁」，",
	"「潇湘夜雨」，",
	"「月白风清」，",
	"「金波低转」，",
});

string *msg3 =({
        "将之格开。",
        "将之凌空弹开。",
        "将之卸在一旁。",
        "“镗”的一声，将之格开。",
        "“镗”的一声挡住了。",        
});

mapping *action = ({
	([	"action" : "$N轻飘飘地纵身跃起，手中$w连续划出几个光环，一招「皓月当空」向$n的$l圈去。\n",
     		"dodge"  : -15,
     		"parry"  : 10,
     		"damage" : 50,
     		"damage_type"  : "割伤"
	]),
   	([   	"action" : "$N双脚一顿，笔直跃起，手中$w不停地颤抖着，笼罩住$n全身。这势「水银泄地」果然是无孔不入。\n",
     		"dodge"  : -5,
     		"parry"  : -10,
     		"damage" : 55,
     		"damage_type"  : "刺伤"
   	]),
   	([ 	"action" : "$N手中$w带起点点寒光，指向$n前胸穴道。$n正专心致志地对付着剑招，不料$N左手运力拍向$n的$l。这势「花明月暗」亦真亦幻，实是难防。\n",
     		"dodge"  : -5,
     		"parry"  : -5,
     		"damage" : 65,
     		"damage_type"  : "震伤"
   	]),
   	([   	"action" : "$N在$n四周游走，手中$w去势飘忽不定，这招「清雨朦胧」只看得$n眼花缭乱。趁此良机，$N于朦朦胧胧中一抖$w，向$n的$l疾挑。\n",
     		"dodge"  : -15,
     		"parry"  : 5,
     		"damage" : 65,
     		"damage_type"  : "刺伤"
   	]),
   	([   	"action" : "激战中，$N一式飞花似梦从$n面前斜斜跃过，手中$w划出五朵桃花，点向$n的$l。\n",
     		"dodge"  : -5,
     		"parry"  : 0,
     		"damage" : 75,
     		"damage_type"  : "刺伤"
   	]),
   	([	"action":"$N展开身形，$w之攻势绵绵不绝地缠向$n的$l。诗云：无边丝雨细如愁。$N的这招果然深得诗中三味。\n",
     		"dodge"  : -20,
     		"parry"  : 10,
     		"damage" : 80,
     		"damage_type"  : "割伤"
   	]),
   	([   	"action" : "$N仗起手中$w，带出点点寒光，罩住$n的胸腹，只等$n的破绽。这招「潇湘夜雨」直如细雨般紧密，$n实在不知$w将要指向自己身上何处。\n",
     		"dodge"  : -5,
     		"parry"  : -10,
     		"damage" : 90,
     		"damage_type"  : "刺伤"
   	]),
   	([   	"action" : "$N手中$w中宫直进，疾速刺向$n的前心。这招「月白风清」令人耳目一新。$n只觉浑身一紧，$w已刺到了$l。\n",
     		"dodge"  : -15,
     		"parry"  : 15,
     		"damage" : 95,
     		"damage_type"  : "刺伤"
   	]),
   	([   	"action" : "$N手中$w向$n的右手疾刺，但正当$n要招架时，$w却突然转向了$n的左足！这招「金波低转」确实神鬼莫测。\n",
     		"dodge"  : -15,
     		"parry"  : -15,
     		"damage" : 150,
     		"damage_type"  : "刺伤"
   	]),
	([	"action" : HIC"$N"HIC"一招「花前月下」，$w"HIC"自上而下搏击，模拟冰轮横空，清光铺地的光景。不住颤动，如鲜花招展风中，来回挥削，只晃得$n"HIC"眼花撩乱。\n"NOR,
    		"dodge"  : -80,
    		"parry"  : -50,
     		"damage" : 200,
     		"force"  : 150,
    		"damage_type": "刺伤"
	]),
});

int valid_learn(object me)
{
	object ob;
   	if( (int)me->query_maxforce() < 50 )
     		return notify_fail("你的内力修为不够深，晓风残月剑学了也没用。\n");
   	if(!(ob = me->query_temp("weapon"))
        || (string)ob->query("skill_type") != "sword" )
     		return notify_fail("你必须先找一柄剑才能练习剑法。\n");
   	return 1;
}

mapping query_action(object me, object weapon)
{
 	if ( ! me->query_temp("XFS_perform")) 
 	{
 		return action[random(8)];
 	} 
 	else 
 	{
 		return action[9];
	}
	return action[random(sizeof(action))];
}

int valid_enable(string usage)
{
	return usage=="sword"||usage=="parry";
}

string perform_action_file(string func)
{
return CLASS_D("wzg") + "/xiaofeng-sword/" + func;
}

string query_parry_msg(object me,object target)
{
	return "结果$n"+msg1[random(sizeof(msg1))]+msg2[random(sizeof(msg2))]+msg3[random(sizeof(msg3))]+"\n";	
}
