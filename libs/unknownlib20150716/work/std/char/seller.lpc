#include <ansi.h>
inherit NPC;

nosave string goods_msg="";
nosave mapping goods_list = ([]);
nosave mapping temp_list = ([]);

void init_shop_goods();

void setup()
{
        ::setup();
        init_shop_goods();
}

void init()
{
        add_action("do_list", "list");
}

void init_shop_goods()
{
	int i,n,k,base_value = this_object()->query("goods/base_value");
	object ob;
	string type,dir,*tmp,*files = this_object()->query("goods/goods");
	n = 0;
	k = this_object()->query("goods/level");
	tmp = ({});
	if( base_value<500 )
		base_value = 500;
	if( !stringp(dir = this_object()->query("goods/goods_dir")) )
		dir = "/d/obj/nweapon/";
	if( !stringp(type=this_object()->query("goods/type")) )
		type = "weapon";		
	while(k--)
	{
		n++;
		reset_eval_cost();
		for(i=0;i<sizeof(files);i++)
		{
			if( member_array(files[i],tmp)!=-1 )
				continue;
			ob = new(sprintf(dir+"%s",files[i]));
			if( !ob )
				continue;
			if( type=="weapon" && !ob->init_weapon(k) )
				continue;
			if( type!="weapon" && !ob->init_armor(k) )
				continue;	
			if( !undefinedp(temp_list[ob->short()]) )
				continue;
			tmp+= ({files[i]});				
			if( !temp_list || !mapp(temp_list) )
				temp_list = ([ ob->short() : files[i]+" "+n ]);
			else	temp_list[ob->short()] = files[i]+" "+n;	
			if( !goods_list || !mapp(goods_list) )
				goods_list = ([ files[i] : ({files[i],k,k*base_value}),]);
			else	goods_list[files[i]] = ({files[i],k,k*base_value});	
			if( type=="weapon" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物攻%4-d 法攻%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("weapon_prop/combat_damage"),ob->query("weapon_prop/spells_damage"));
			else if( type=="armor" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物防%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_def"));	
			else if( type=="pifeng" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  法防%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/spells_def"));	
			else if( type=="kui" )	
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物防%4-d 法防%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_def"),ob->query("armor_prop/spells_def"));
			else if( type=="shield" )	
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物防%4-d 法防%4-d 格挡%4-d%%\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_def"),ob->query("armor_prop/spells_def"),ob->query("armor_prop/combat_parry"));
			else if( type=="shoes" )	
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物防%4-d 法防%4-d 物闪%4-d%% 法闪%4-d%%\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_def"),ob->query("armor_prop/spells_def"),ob->query("armor_prop/combat_dodge"),ob->query("armor_prop/spells_dodge"));
			else if( type=="waist" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  气血%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/max_kee"));	
			else if( type=="wrists" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  精神%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/max_sen"));
			else if( type=="ring" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  物攻%4-d 法攻%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_damage"),ob->query("armor_prop/spells_damage"));
			else if( type=="hand" )
				goods_msg+= sprintf("%30-s  %4-s  %15-s  格挡%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_parry"));				
			else	goods_msg+= sprintf("%30-s  %4-s  %15-s  物防%4-d 法防%4-d\n",ob->name(1)+"("+files[i]+")",ob->query("level")+"",MONEY_D->money_str(k*base_value,1),ob->query("armor_prop/combat_def"),ob->query("armor_prop/spells_def"));	
			if( ob )
				destruct(ob);
		}
	}		
}

int do_list()
{
	string str;
	object me = this_player();
	printf("你可以从"+this_object()->name()+"处购买下列这些东西：\n");
	printf(REV CYN"       名称                 等级要求    价格              属性         \n"NOR);
	me->start_more(goods_msg); 
	return 1;
}

void kill_ob(object who)
{
	remove_killer(who);
	who->remove_killer(this_object());
	if( userp(who) )
		tell_object(who,"\n"HIR+name()+HIR"说道：哼，"+RANK_D->query_self_rude(this_object())+"地盘上也敢撒野！"NOR"\n");
}

int buy_object(object who,string str)
{
	string dir,arg;
	object ob;
	int value,v;
	if( !goods_list || !mapp(goods_list) )
	{
		tell_object(who,"现在暂无商品可卖。\n");
		return -1;
	}
	if( undefinedp(goods_list[str]) )
	{
		tell_object(who,"没有此装备可买，请看清ID，比如 buy axe from xiaoxiao\n");
		return -1;
	}
	if( !stringp(dir = this_object()->query("goods/goods_dir")) )
		dir = "/d/obj/nweapon/";
	arg = goods_list[str][0];
	v = goods_list[str][1];
	value = goods_list[str][2];
	if( value<=0 )
	{
		tell_object(who,"装备价格初始出错，请联系巫师。\n");
		return -1;
	}
	if( !who->check_pay(value) )
	{
		tell_object(who,"你身上的钱不足"+MONEY_D->money_str(value,1)+"。\n");
		return -1;
	}
	ob = new(dir+arg);
	if( !ob )
	{
		tell_object(who,"装备初始出错，请联系巫师。\n");
		return -1;
	}
	if( dir=="/d/obj/nweapon/" )
	{
		if( !ob->init_weapon(v) )
		{
			if( ob )  destruct(ob);
			tell_object(who,"装备初始出错，请联系巫师。\n");
			return -1;
		}
	}
	else
	{
		if( !ob->init_armor(v) )
		{
			if( ob )  destruct(ob);
			tell_object(who,"装备初始出错，请联系巫师。\n");
			return -1;
		}
	}	
	if( !ob->move(who) )
	{
		if( ob )  destruct(ob);
		tell_object(who,"你的背包满了。\n");
		return -1;
	}
	if( !who->money_add(-value) )
	{
		if( ob )  destruct(ob);
		tell_object(who,"购买失败，请联系巫师。\n");
		return -1;
	}
	tell_object(who,HIY"你购买了一"+ob->query("unit")+ob->short()+HIY"。\n"NOR);
	ob->set("value",1);				 
	return -1;
}