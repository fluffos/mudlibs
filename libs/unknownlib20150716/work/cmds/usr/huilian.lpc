//装备回炼
#include <ansi.h>
inherit F_CLEAN_UP;

mapping equip_apply_prop  = ("/cmds/std/look.lpc")->query_euqip_look1();
mapping equip_apply_prop2 = ("/cmds/std/look.lpc")->query_euqip_look2();     	

string query_prop_name(string data)
{
	mapping all_prop = ("/cmds/std/look.lpc")->query_euqip_look();
	if( !undefinedp(all_prop[data]) )
		return all_prop[data];
	if( is_chinese(to_chinese(data)) )
		return to_chinese(data)+"有效等级";		
	else if( sscanf(data,"ad_%s",data) )
		return to_chinese(data)+"技能等级";
	else	return data;
}

varargs mixed show_equip(object me,object obj,int f)
{
	string str,str2,arg,*temp,*base;
	mapping prop,E_temp,base_prop;
	int i;
	
	if( !me || !obj || !present(obj,me) )
		return 0;
	
	if( obj->is_armor() )
		prop = obj->query("armor_prop");
	else	prop = obj->query("weapon_prop");	
	if( !prop || !mapp(prop) )
	{
		write("装备无属性。\n");
		return 0;
	}
	if( obj->is_armor() )
		base_prop = ("/d/obj/narmor/newcloth.lpc")->equip_base(obj);
	else	base_prop = ("/d/obj/nweapon/newweapon.lpc")->equip_base(obj);
	
	arg = " "+obj->name()+"\n";
	arg+= "基本属性：\n";
	base = keys(base_prop);
	for(i=0;i<sizeof(base);i++)
	{
		if( prop[base[i]]==0 )
			continue;
		if( !undefinedp(equip_apply_prop[base[i]]) )
			str = equip_apply_prop[base[i]];
		else if( !undefinedp(equip_apply_prop2[base[i]]) )	
			str = equip_apply_prop2[base[i]];
		else
		{
			str = base[i];
			if( is_chinese(to_chinese(str)) )
				str = to_chinese(str)+"有效等级";
			else if( sscanf(str,"ad_%s",str2) )
			{
				if( is_chinese(to_chinese(str2)) )
					str = to_chinese(str2)+"技能等级";
			}	
		}	
		str2 = sprintf("%d%s",prop[base[i]]>=0?prop[base[i]]:-prop[base[i]],!undefinedp(equip_apply_prop2[base[i]])?"%":"点");	
		arg+= sprintf("      %20s : "HIR"%s"HIY"%s"NOR"\n",str,prop[base[i]]>0?"+":"-",str2);
		str = str2 = "";		
	}
	
	temp = keys(prop);
	arg+= "可洗炼属性：\n";
	E_temp = ([]);
	for(i=0;i<sizeof(temp);i++)
	{
		if( prop[temp[i]]==0 )
			continue;
		if( member_array(temp[i],base)!=-1 )
			continue;	
		if( !undefinedp(equip_apply_prop[temp[i]]) )
			str = equip_apply_prop[temp[i]];
		else if( !undefinedp(equip_apply_prop2[temp[i]]) )	
			str = equip_apply_prop2[temp[i]];
		else
		{
			str = temp[i];
			if( is_chinese(to_chinese(str)) )
				str = to_chinese(str)+"有效等级";
			else if( sscanf(str,"ad_%s",str2) )
			{
				if( is_chinese(to_chinese(str2)) )
					str = to_chinese(str2)+"技能等级";
			}	
		}	
		str2 = sprintf("%d%s",prop[temp[i]]>=0?prop[temp[i]]:-prop[temp[i]],!undefinedp(equip_apply_prop2[temp[i]])?"%":"点");	
		arg+= sprintf("      %20s : "HIR"%s"HIY"%s"NOR"\n",str,prop[temp[i]]>0?"+":"-",str2);
		E_temp[str] = temp[i];
		str = str2 = "";
	}
	if( !f )
		return E_temp;
	write(arg);
	return 0;
}

int main(object me,string arg)
{
	int need,have,score,p,pp;
	string last_pro,now_pro,before,after;
	object shi,ob;

	if( me->query_level()<25 )
		return notify_fail("此功能25级开放。\n");	 	
	if( !wizardp(me) )
	{	
		if( !me->query_temp("mark/xilian_room") )
			return notify_fail("你需要先找一处灵气浓郁的地方，可以在袁守城处购得「罗盘」来查询。\n");
		else if( base_name(environment(me))!=me->query_temp("mark/xilian_room") )
			return notify_fail("此处灵气稀薄，难以回炼装备。\n");
	}
	
	if( !arg )
		return notify_fail("你要回炼哪个装备？\n");
	ob = present(arg,me);
	if( !ob || (!ob->is_armor()&&!ob->is_weapon()) )
		return notify_fail("你身上没有"+arg+"，或它不是一件装备。\n");
	
	if( me->query("family/family_name") && ob->query("armor_title")==me->query("family/family_name") )
		return notify_fail("门派套装不能回炼。\n");
	if( ob->query("combination") )
		return notify_fail("组合武器不支持回炼。\n");
	if( !stringp(after=ob->query("after_xilian")) 
	 || sscanf(after,"%s#%d",now_pro,pp)!=2 )
	 	return notify_fail(ob->name()+"没有洗炼过。\n");

	if( !stringp(before=ob->query("before_xilian"))
	 || sscanf(before,"%s#%d",last_pro,p)!=2 )
	 	return notify_fail("找不到"+ob->name()+"洗炼前的属性。\n");
		 
	have = (int)me->query("inventory/yingshi");
	if( ob->is_armor() )
		score = ("/cmds/usr/top.lpc")->get_score4(ob);
	else	score = ("/cmds/usr/top.lpc")->get_score3(ob);

	need = score/36;
	if( need<1 )
		need = 1;
	if( have<need )
		return notify_fail("回炼"+ob->name(1)+"需要消耗"+chinese_number(need)+"颗萤石。\n");
		
	if( ob->is_armor() )
	{
		ob->add("armor_prop/"+now_pro,-pp);
		if( ob->query("armor_prop/"+now_pro)==0 )
			ob->delete("armor_prop/"+now_pro);
		ob->add("armor_prop/"+last_pro,p);
	}
	else
	{
		ob->add("weapon_prop/"+now_pro,-pp);
		if( ob->query("weapon_prop/"+now_pro)==0 )
			ob->delete("weapon_prop/"+now_pro);
		ob->add("weapon_prop/"+last_pro,p);
	}	
	ob->delete("before_xilian");
	ob->delete("after_xilian");
	write(HBBLU"【洗炼】"+ob->name()+NOR HBBLU"的 "HIY+query_prop_name(now_pro)+HIG" 回炼为 "HIR+query_prop_name(last_pro)+HIG"。"NOR"\n");	
	if( ob->save() )
		write(HIY"【系统】"+ob->name(1)+HIY"存储成功。\n"NOR);
	else	me->add("potential",-300);
	me->add("inventory/yingshi",-need);
	write(HIG"【系统】"+ob->name(1)+HIG"洗炼完毕。\n"NOR);
	show_equip(me,ob,1);	
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : huilian [装备ID]

  将洗练过的装备属性还原为洗炼之前的，需要消耗 萤石。
        装备碎片x100 + 莹玉x3 = 萤石x1
  萤石可以用来洗炼(xilian)装备或回炼(huilian)装备。
  洗炼：你可以指定需要洗炼装备的某一属性，让它重新随机属性及数值
  回炼：使洗炼过的装备回到上一次洗炼前的属性。

相关帮助 : help fenjie
           help xilian  

HELP );
    return 1;
}

