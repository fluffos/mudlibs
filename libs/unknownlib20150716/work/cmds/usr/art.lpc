#include <ansi.h>
#include <skill.h>
inherit F_CLEAN_UP;

object query_equip_art(object who,string arg)
{
	string file;
	mapping armor;
	int i;
	object eq,*ar;
	if( !who || !living(who) || who->is_busy() 
	 || !arg )
		return 0;
	if( objectp(eq=who->query_temp("weapon")) )
	{
		if( stringp(file=eq->art_knowledge_file(arg)) 
		 && file_size(file+".lpc")>0 )
			return eq;
	}
	
	if( mapp(armor=who->query_temp("armor"))
	 && sizeof(armor)>0 )
	{
		ar = values(armor);
		for(i=0;i<sizeof(ar);i++)
		{
			if( stringp(file=ar[i]->art_knowledge_file(arg)) 
			 && file_size(file+".lpc")>0 )
				return ar[i];
		}
	}	 
	return 0;
}

int main(object me, string arg)
{
	object weapon, target,pfm,equip;
	string martial, skill, perf,msg,tmp;
    
	seteuid(getuid());
    
	if( me->is_busy() || me->is_fighting() )
        	return notify_fail("( 你上一个动作还没有完成，不能使用生活技能。)\n");
	if( !arg ) 
		return notify_fail("你要做什么？\n");
	if( userp(me) && me->query("gin")<1 )
		return notify_fail("你的活力不够了。\n");

	tmp = arg;
	if( sscanf(arg, "%s %s", perf, arg)!=2 )
		return notify_fail(@LONG
命令格式: art <制作类型> <制作名称>
其中，制作类型有：
	饮料 -- drink
	食物 -- food
	丹药 -- drug
	物品 -- item
	武器 -- weapon
	防具 -- armor
制作名称可以通过 art <制作类型> list 命令来查询。
LONG);	
	if( perf!="drink" )
		return notify_fail("目前只开放了 饮料 的制作。\n");
		
	notify_fail("你所学的生活技能中没有这种功能。\n");
	skill = "chuyi";
	if( SKILL_D(skill)->art_knowledge(me,perf,arg) ) 
	{
        	if( random(120) < (int)me->query_skill(skill) )
                	me->improve_skill(skill, 1, 1);
		return 1;
	} 
	else if( objectp(equip= query_equip_art(me,perf)) )
        {
		if( equip->art_knowledge(me,perf,arg) )
		{
        		if( random(120) < (int)me->query_skill(martial, 1) )
        			me->improve_skill(martial, 1, 1);
			return 1;
		}
        	else	return 0;
        }
	else	return 0;
}

int help (object me)
{
        write(@HELP
命令格式: art <制作类型> <制作名称>
其中，制作类型有：
	饮料 -- drink
	食物 -- food
	丹药 -- drug
	物品 -- item
	武器 -- weapon
	防具 -- armor
制作名称可以通过 art <制作类型> list 命令来查询。
这些需要相应的生活技能的支持。

HELP
        );
return 1;
}

