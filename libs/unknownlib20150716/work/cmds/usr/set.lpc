// set.c
#include <ansi.h>
#define MAX_ENV_VARS	20
inherit F_CLEAN_UP;
 
int help();

mapping Sets = ([
	"block_tell"	: "关闭了私聊频道",
	"brief"		: "关闭区域描述显示",
	"brief_message" : "设置战斗信息过滤模式为%O",
	"no_accept"	: "关闭了物品接受",
	"wimpy"		: "设置当气血、精神百分比小于%O%%时逃跑",
	"PK"		: "打开了PK模式",
	"limit_toget"   : "设置昏迷后别人不能get", 
	"reply_msg"	: "设置自动回复私聊信息：%O",
	"no_help"	: "设置不接受系统升级提示",
	"brief_all"	: "设置仅显示区域名称",
	"armor_change"  : "设置自动成长的防具类型为%O",
	"weapon_change" : "设置自动成长的武器类型为%O",
	"armor_ratio"	: "设置防具自动成长消耗自身经验的%O%%",
	"weapon_ratio"	: "设置武器自动成长消耗自身经验的%O%%",
        "no_teach"  : "不想教授自己的徒弟",
]);
 
int main(object me, string arg)
{
	int i;
    	string term, *terms, *wiz_only;
    	mixed data;
    	mapping env;
 
    	wiz_only = ({"invisibility", "immortal"});
 
	if( me != this_player(1) ) 
		return 0;
 
	env = me->query("env");
 
	if( !arg || arg=="" ) 
	{
		write("你目前设定的环境变数有：\n");
		if( !mapp(env) || !sizeof(env) )
			write("\t没有设定任何环境变数。\n");
		else 
		{
			terms = keys(env);
			for(i=0; i<sizeof(terms); i++)
			{
				term = terms[i];
				if( member_array(term, keys(Sets))==-1 )
					printf("%-20s：%O\n", term, env[terms[i]]);
				else	printf("%-20s："+Sets[term]+"\n", term,env[terms[i]]);	
			}
		}
		return 1;
	}
 
	if( sscanf(arg, "%s %s", term, data)!=2 ) 
	{
		term = arg;
		data = "YES";
	}
 
	if( term && term!="" ) 
	{
		if( mapp(env) && undefinedp(env[term]) && sizeof(env) >= MAX_ENV_VARS )
			return notify_fail("你设的环境变数太多了，请先用 unset 删掉几个吧。\n");
		sscanf(data, "%d", data);
		
		if(!wizardp(me)
		 && (member_array(term, keys(Sets)) == -1))
			return notify_fail("你只能设定 help settings 中定义过的环境变数。\n");
        
        	if((wiz_level(me) == 0) && (member_array(term, wiz_only) != -1))
            		return notify_fail("只有巫师能用这个设定。\n");
		
		if( term == "wimpy" 
		 && intp(data) 
		 && (data<=0 || data>80) )  
		{
	   		return COMMAND_DIR"usr/wimpy"->help(me);
		}
		if( (term=="armor_ratio" || term=="weapon_ratio")
		 && intp(data) 
		 && (data<=1 || data>=100) )  
			return notify_fail("你只能设定 1-100 之间的数值。\n");
        
		if( member_array(term,({"armor_change","weapon_change","armor_ratio","weapon_ratio"}))!=-1 
		 && me->query_level()<50 )
			return notify_fail("此功能50级开放。\n");
        
        	me->set("env/" + term, data);
        	{
        		printf("设定环境变数：%s = %O\n", term, data);
        		/*
        		if( member_array(term, keys(Sets))==-1 )
				printf(HIR"\n【系统】设定环境变数：%s = %O\n"NOR, term, data);
			else	printf(HIR"\n【系统】你"+Sets[term]+"，如要更改请使用"HIG" unset "+term+HIR" 命令。\n"NOR,data);
			*/
		}
		return 1;
	}
	return help();
}
 
int help()
{
	write(@TEXT
指令格式：set <变数名> [<变数值>]
 
这个指令让你设定一些环境变数，不加参数时会显示你目前设定的环境变数，不指定
变数值，则内定值为 "YES"。
 
取消变数设定请用 unset 指令。
 
至于有哪些环境变数可以设定，请见 help settings。
TEXT
	);
	return 1;
}
