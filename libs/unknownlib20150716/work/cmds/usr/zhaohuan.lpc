#include <ansi.h>
#include <armor.h>
inherit F_CLEAN_UP;

mixed have_equip(object who, int v, string name) {
  object *inv;
  string *types;
  mapping pro;
  int i, k;
  if (!who || !living(who))
    return 1;
  inv = all_inventory(who);
  if (!inv || !arrayp(inv) || sizeof(inv) < 1)
    return 0;
  for (i = 0; i < sizeof(inv); i++) {
    if (!inv[i]->is_zhaohuan())
      continue;
    if (inv[i]->query("valid_time") == v
      && COLOR_D->clean_color(inv[i]->name()) == name)
      return 1;
    if (inv[i]->query("combination")
      && inv[i]->is_weapon()) {
      types = inv[i]->query("skill_types");
      for (k = 0; k < sizeof(types); k++) {
        pro = inv[i]->query("combination_dbase/" + types[k]);
        if (pro["valid_time"] == v && strsrch(name, pro["name"]) != -1)
          return inv[i]->name();
      }
    }
  }
  return 0;
}

int init_player_file(object who) {
  if (!who || !living(who))
    return 0;
  who->CreateMyEquip();
  if (!stringp(who->MyArmorFile())
    || !stringp(who->MyWeaponFile())
    || !stringp(who->MyFabaoFile())
    || !stringp(who->MyBagFile()))
    return 0;
  return 1;
}

mixed create_fabao(object who, string type) {
  mixed *ar, k;
  int e_time, i, f;
  string temp, file;
  string e_type, e_name, msg, yin;
  object obj;

  if (!who || !living(who) || !type)
    return 0;
  ar = who->query("fabao");
  if (!ar || !arrayp(ar) || sizeof(ar) < 1)
    return 0;
  //以名称召唤
  if (type != "fabao" && type != "Fabao") {
    f = 0;
    k = 0;
    reset_eval_cost();
    for (i = 0; i < sizeof(ar); i++) {
      temp = ar[i];
      if (sscanf(temp, "%s_%d_%s", e_type, e_time, e_name) != 3)
        continue;
      if (e_type != "fabao" && e_type != "Fabao")
        continue;
      if (type != e_name)
        continue;
      if (have_equip(who, e_time, e_name)) {
        k = e_name;
        continue;
      }
      obj = new(who->MyFabaoFile());
      switch (random(3)) {
        case 0: msg = HIW "一声" HIR "霹雳" HIW "，闪电划破长空，「$n" HIW "」从天而降，飞入$N" HIW "的手中！\n" NOR; break;
        case 1: msg = HIR "一道" HIY "长虹" HIR "扫过天空，只见「$n" HIR "」落入了$N" HIR "的掌中！\n" NOR; break;
        default: msg = HIM "只见「$n" HIM "」呤呤作响，大放异彩，挟云带雾，突现在$N" HIM "的掌中！\n" NOR; break;
      }
      obj->set("name", e_name);
      obj->set("owner_id", who->query("id"));
      obj->set("valid_time", e_time);
      if (!obj->move(who)) {
        tell_object(who, HIR "【系统】你的背包已满或负重不够。" NOR "\n");
        if (obj)
          destruct(obj);
        continue;
      }
      if (!obj->restore()) {
        destruct(obj);
        continue;
      }
      obj->set_name(obj->query("names"), obj->query("ids"));
      obj->setup();
      obj->set("no_give", 1);
      obj->set("no_get", 1);
      obj->set("no_put", 1);
      obj->set("no_save", 1);
      obj->set("no_store", 1);
      obj->delete("breaked");
      message_combatd(msg, who, obj);
      if (who->query("env/brief_message"))
        write("你召唤了" + obj->name() + "。\n");
      f++;
    }
    if (f == 0) {
      if (k)
        return notify_fail("你已经召唤了" + k + "。\n");
      else return 0;
    } else return 1;
  }
  reset_eval_cost();
  f = 0;
  k = 0;
  for (i = 0; i < sizeof(ar); i++) {
    temp = ar[i];
    if (sscanf(temp, "%s_%d_%s", e_type, e_time, e_name) != 3)
      continue;
    if (e_type != "fabao" && e_type != "Fabao")
      continue;
    if (type != e_type)
      continue;
    if (have_equip(who, e_time, e_name)) {
      k = e_name;
      continue;
    }
    obj = new(who->MyFabaoFile());
    switch (random(3)) {
      case 0: msg = HIW "一声" HIR "霹雳" HIW "，闪电划破长空，「$n" HIW "」从天而降，飞入$N" HIW "的手中！\n" NOR; break;
      case 1: msg = HIR "一道" HIY "长虹" HIR "扫过天空，只见「$n" HIR "」落入了$N" HIR "的掌中！\n" NOR; break;
      default: msg = HIM "只见「$n" HIM "」呤呤作响，大放异彩，挟云带雾，突现在$N" HIM "的掌中！\n" NOR; break;
    }
    obj->set("name", e_name);
    obj->set("owner_id", who->query("id"));
    obj->set("valid_time", e_time);
    if (!obj->move(who)) {
      tell_object(who, HIR "【系统】你的背包已满或负重不够。" NOR "\n");
      if (obj)
        destruct(obj);
      continue;
    }
    if (!obj->restore()) {
      destruct(obj);
      continue;
    }
    obj->set_name(obj->query("names"), obj->query("ids"));
    obj->setup();
    obj->set("no_give", 1);
    obj->set("no_get", 1);
    obj->set("no_put", 1);
    obj->set("no_save", 1);
    obj->set("no_store", 1);
    obj->delete("breaked");
    message_combatd(msg, who, obj);
    if (who->query("env/brief_message"))
      write("你召唤了" + obj->name() + "。\n");
    f++;
  }
  if (f == 0) {
    if (k)
      return notify_fail("你已经召唤了" + k + "。\n");
    else return 0;
  } else return 1;
}

mixed create_equip(object who, string type) {
  mixed *ar, k, foo;
  int e_time, i, f;
  string *armor, *weapon, temp;
  string e_type, e_name, msg, yin;
  object obj;

  if (!who || !living(who) || !type)
    return 0;
  ar = who->query("euqips");
  if (!ar || !arrayp(ar) || sizeof(ar) < 1) {
    notify_fail("你没有绑定过装备。\n");
    return create_fabao(who, type);
  }
  armor = ({
    "armor", "cloth", "hands", "kui", "neck", "pifeng", "ring", "shield", "shoes", "waist", "wrists",
    "finger", "boots", "head", "surcoat",
  });
  weapon = ({
    "axe", "blade", "fork", "hammer", "mace", "spear", "staff", "stick", "sword", "unarmed", "whip",
  });
  //以名称召唤
  if (member_array(
    type,
    armor
  ) == -1 && member_array(type, weapon) == -1 && type != "fabao" && type != "Fabao") {
    f = 0;
    k = 0;
    reset_eval_cost();
    for (i = 0; i < sizeof(ar); i++) {
      temp = ar[i];
      if (sscanf(temp, "%s_%d_%s", e_type, e_time, e_name) != 3)
        continue;
      if (member_array(e_type, armor) == -1
        && member_array(e_type, weapon) == -1)
        continue;
      if (type != "all") {
        if (type == "wuqi" && member_array(e_type, weapon) == -1)
          continue;
        else if (type == "kuijia" && member_array(e_type, armor) == -1)
          continue;
        else if (type != e_name)
          continue;
      }
      if (foo = have_equip(who, e_time, e_name)) {
        k = e_name;
        if (stringp(foo))
          k += "，目前为 " + foo + NOR " 之形态";
        continue;
      }
      if (member_array(e_type, armor) != -1) {
        obj = new(who->MyArmorFile());
        obj->set("armor_type", e_type);
        if (!who->query("class"))
          yin = "遁甲印";
        else if (who->query("class") == "yaomo")
          yin = "上古妖印";
        else if (who->query("class") == "bonze")
          yin = "佛印";
        else yin = "道印";
        switch (random(3)) {
          case 0: msg = HIY "$N" HIY "手结" + yin + "，「$n" HIY "」从虚空中显出了形状，落在$P手中！\n" NOR; break;
          case 1: msg = HIC "$N" HIC "口中喃喃念了几句咒语，只见霞光四射，「$n" HIC "」从天而降，落在了$P手中！\n" NOR; break;
          default: msg = HIG "只见「$n" HIG "」霞彩四溢，大放异彩，突现在$N" HIG "的掌中！\n" NOR; break;
        }
      } else {
        obj = new(who->MyWeaponFile());
        obj->set("skill_type", e_type);
        switch (random(3)) {
          case 0: msg = HIW "一声" HIR "霹雳" HIW "，闪电划破长空，「$n" HIW "」从天而降，飞入$N" HIW "的手中！\n" NOR; break;
          case 1: msg = HIR "一道" HIY "长虹" HIR "扫过天空，只见「$n" HIR "」落入了$N" HIR "的掌中！\n" NOR; break;
          default: msg = HIM "只见「$n" HIM "」呤呤作响，大放异彩，挟云带雾，突现在$N" HIM "的掌中！\n" NOR; break;
        }
      }
      obj->set("name", e_name);
      obj->set("owner_id", who->query("id"));
      obj->set("valid_time", e_time);
      if (!obj->move(who)) {
        tell_object(who, HIR "【系统】你的背包已满或负重不够。" NOR "\n");
        if (obj)
          destruct(obj);
        continue;
      }
      if (!obj->restore()) {
        destruct(obj);
        continue;
      }
      obj->set_name(obj->query("names"), obj->query("ids"));
      obj->setup();
      obj->set("no_give", 1);
      obj->set("no_get", 1);
      obj->set("no_put", 1);
      obj->set("no_save", 1);
      obj->set("no_store", 1);
      obj->delete("breaked");
      message_combatd(msg, who, obj);
      if (who->query("env/brief_message"))
        write("你召唤了" + obj->name() + "。\n");
      f++;
    }
    if (f == 0) {
      if (k)
        return notify_fail("你已经召唤了" + k + "。\n");
      else {
        notify_fail("你并没有绑定名为" HIC + type + NOR "的装备。\n");
        return create_fabao(who, type);
      }
    } else return 1;
  }
  reset_eval_cost();
  f = 0;
  k = 0;
  for (i = 0; i < sizeof(ar); i++) {
    temp = ar[i];
    if (sscanf(temp, "%s_%d_%s", e_type, e_time, e_name) != 3)
      continue;
    if (member_array(e_type, armor) == -1
      && member_array(e_type, weapon) == -1)
      continue;
    if (type != e_type)
      continue;
    if (foo = have_equip(who, e_time, e_name)) {
      k = e_name;
      if (stringp(foo))
        k += "，目前为 " + foo + NOR " 之形态";
      continue;
    }
    if (member_array(e_type, armor) != -1) {
      obj = new(who->MyArmorFile());
      obj->set("armor_type", e_type);
      if (!who->query("class"))
        yin = "遁甲印";
      else if (who->query("class") == "yaomo")
        yin = "上古妖印";
      else if (who->query("class") == "bonze")
        yin = "佛印";
      else yin = "道印";
      switch (random(3)) {
        case 0: msg = HIY "$N" HIY "手结" + yin + "，「$n" HIY "」从虚空中显出了形状，落在$P手中！\n" NOR; break;
        case 1: msg = HIC "$N" HIC "口中喃喃念了几句咒语，只见霞光四射，「$n" HIC "」从天而降，落在了$P手中！\n" NOR; break;
        default: msg = HIG "只见「$n" HIG "」霞彩四溢，大放异彩，突现在$N" HIG "的掌中！\n" NOR; break;
      }
    } else {
      obj = new(who->MyWeaponFile());
      obj->set("skill_type", e_type);
      switch (random(3)) {
        case 0: msg = HIW "一声" HIR "霹雳" HIW "，闪电划破长空，「$n" HIW "」从天而降，飞入$N" HIW "的手中！\n" NOR; break;
        case 1: msg = HIR "一道" HIY "长虹" HIR "扫过天空，只见「$n" HIR "」落入了$N" HIR "的掌中！\n" NOR; break;
        default: msg = HIM "只见「$n" HIM "」呤呤作响，大放异彩，挟云带雾，突现在$N" HIM "的掌中！\n" NOR; break;
      }
    }
    obj->set("name", e_name);
    obj->set("owner_id", who->query("id"));
    obj->set("valid_time", e_time);
    if (!obj->move(who)) {
      tell_object(who, HIR "【系统】你的背包已满或负重不够。" NOR "\n");
      if (obj)
        destruct(obj);
      continue;
    }
    if (!obj->restore()) {
      destruct(obj);
      continue;
    }
    obj->set_name(obj->query("names"), obj->query("ids"));
    obj->setup();
    obj->set("no_give", 1);
    obj->set("no_get", 1);
    obj->set("no_put", 1);
    obj->set("no_save", 1);
    obj->set("no_store", 1);
    obj->delete("breaked");
    message_combatd(msg, who, obj);
    if (who->query("env/brief_message"))
      write("你召唤了" + obj->name() + "。\n");
    f++;
  }
  if (f == 0) {
    if (k)
      return notify_fail("你已经召唤了" + k + "。\n");
    else {
      notify_fail("你并没有绑定名为" HIY + type + NOR "的装备。\n");
      return create_fabao(who, type);
    }
  } else return 1;
}

int create_bag(object me) {
  int lvl;
  object bag;
  string msg;
  if (me->query_level() < 50)
    return notify_fail("储物袋功能50级开放。\n");
  if (!intp(lvl = me->query("mark/bag"))
    || lvl < 1)
    return notify_fail("你还没有自己的储物袋。\n");
  if (objectp(bag = present("chuwu dai", me))
    && base_name(bag) == me->MyBagFile(1))
    return notify_fail("你已经召唤了储物袋了。\n");
  bag = new(me->MyBagFile());
  bag->set("level", lvl);
  bag->set("owner_id", me->query("id"));
  if (bag->move(me)) {
    switch (random(3)) {
      case 0: msg = HIW "一声" HIC "霞光" HIW "闪过，「" HIC "$n" HIW "」自虚空渐现，出现在$N" HIW "的手中！\n" NOR; break;
      case 1: msg = HIC "霞光" HIY "一闪，只见「" HIC "$n" HIY "」已出现在$N" HIY "的掌中！\n" NOR; break;
      default: msg = HIC "只见「" HIY "$n" HIC "」霞光闪烁，在半空中滴溜溜转了几转，落在了$N" HIC "的掌中！\n" NOR; break;
    }
    bag->restore();
    message_vision(msg, me, bag);
    write(HIC "你召唤了储物袋。\n" NOR);
    return 1;
  } else {
    if (bag) destruct(bag);
    return notify_fail("召唤储物袋失败。\n");
  }
}

int main(object me, string arg) {
  mixed *ar;
  string e_type, *names, e_name, type, *types, temp, arg1, *com_eqs;
  string *armor, *weapon, *Arm, *Wep, *Wep2, *FB;
  int e_time, i, f, k, j, err = 0, just = 0;

  if (me->is_busy())
    return notify_fail("你现在忙着呢。\n");
  if (!init_player_file(me))
    return notify_fail(HIY "\n玩家数据生成失败，请重新登录再试。如果重新登录后仍然存在该问题，请联系巫师。\n\n" NOR);
  if (arg && arg == "bag")
    return create_bag(me);

  if (!arrayp(FB = me->query("fabao"))
    || sizeof(FB) < 1)
    just = 1;

  if ((!arrayp(ar = me->query("euqips")) || sizeof(ar) < 1)
    && just == 1)
    return notify_fail("你没有绑定过装备。\n");

  if (!arrayp(com_eqs = me->query("combination_euqips"))
    || sizeof(com_eqs) < 1)
    com_eqs = ({});

  Arm = Wep = Wep2 = ({});

  armor = ({
    "armor", "cloth", "hands", "kui", "neck", "pifeng", "ring", "shield", "shoes", "waist", "wrists",
    "finger", "boots", "head", "surcoat",
  });
  weapon = ({
    "axe", "blade", "fork", "hammer", "mace", "spear", "staff", "stick", "sword", "unarmed", "whip",
  });
  if (!arg) {
    f = 0;
    for (i = 0; i < sizeof(ar); i++) {
      temp = ar[i];
      if (sscanf(temp, "%s_%d_%s", e_type, e_time, e_name) != 3)
        continue;
      if (file_size(sprintf(
        "/data/equip/%c/%s/%s",
        me->query("id")[0],
        me->query("id"),
        temp
      ) + __SAVE_EXTENSION__) < 1)
        continue;
      if (e_type == "finger")
        e_type = "ring";
      if (e_type == "boots")
        e_type = "shoes";
      if (member_array(e_type, weapon) != -1) {
        if (member_array(temp, com_eqs) != -1
          && member_array(temp, Wep2) == -1)
          Wep2 += ({ temp });
        else if (member_array(temp, Wep) == -1)
          Wep += ({ temp });
        else continue;
      } else if (member_array(e_type, armor) != -1) {
        if (member_array(temp, Arm) == -1)
          Arm += ({ temp });
        else continue;
      } else continue;
      f++;
    }
    if (f == 0)
      return notify_fail("你并没有绑定名为" + type + "的武器或防具。\n");

    arg = "你目前绑定的装备有：\n";
    arg1 = HIC " □" NOR HIY " 防  具 " NOR "\n";
    Arm = sort_array(Arm, (: strcmp :));
    for (i = 0; i < sizeof(Arm); i++) {
      temp = Arm[i];
      sscanf(temp, "%s_%d_%s", e_type, e_time, e_name);
      if (e_type == "finger") e_type = "ring";
      if (e_type == "boots") e_type = "shoes";
      if (i % 2 == 0)
        arg1 += sprintf("    " NOR WHT "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
      else arg1 += sprintf("    " NOR HIR BLK "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
    }
    if (arg1 != HIC " □" NOR HIY " 防  具 " NOR "\n")
      arg += arg1 + "\n";

    arg1 = HIC " □" NOR HIR " 武  器 " NOR "\n";
    Wep = sort_array(Wep, (: strcmp :));
    for (i = 0; i < sizeof(Wep); i++) {
      temp = Wep[i];
      sscanf(temp, "%s_%d_%s", e_type, e_time, e_name);
      if (i % 2 == 0)
        arg1 += sprintf("    " NOR WHT "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
      else arg1 += sprintf("    " NOR HIR BLK "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
    }
    if (arg1 != HIC " □" NOR HIR " 武  器 " NOR "\n")
      arg += arg1 + "\n";

    arg1 = HIC " □" NOR HIG "组合武器" NOR "\n";
    Wep2 = sort_array(Wep2, (: strcmp :));
    for (i = 0; i < sizeof(Wep2); i++) {
      temp = Wep2[i];
      sscanf(temp, "%s_%d_%s", e_type, e_time, e_name);
      if (i % 2 == 0)
        arg1 += sprintf("    " NOR WHT "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
      else arg1 += sprintf("    " NOR HIR BLK "%20s%10-s" NOR "\n", e_name, "(" + e_type + ")");
    }
    if (arg1 != HIC " □" NOR HIG "组合武器" NOR "\n")
      arg += arg1 + "\n";
    if (just != 1) {
      arg1 = HIC " □" NOR HIM " 法  宝 " NOR "\n";
      FB = sort_array(FB, (: strcmp :));
      for (i = 0; i < sizeof(FB); i++) {
        temp = FB[i];
        sscanf(temp, "%s_%d_%s", e_type, e_time, e_name);
        if (i % 2 == 0)
          arg1 += sprintf("    " NOR WHT "%20s%10-s" NOR "\n", e_name, "(Fabao)");
        else arg1 += sprintf("    " NOR HIR BLK "%20s%10-s" NOR "\n", e_name, "(Fabao)");
      }
      if (arg1 != HIC " □" NOR HIM " 法  宝 " NOR "\n")
        arg += arg1 + "\n";
    }
    me->start_more(arg);
    write("你可以使用" HIR " zhaohuan <装备类型> " NOR "来召唤绑定的装备，" HIG "示例：zhaohuan armor" NOR "。\n");
    write("还可以使用" HIR " zhaohuan <装备名称> " NOR "来召唤绑定的装备，" HIG "示例：zhaohuan 嫦娥之七劫" NOR "。\n");
    return 1;
  }
  if (environment(me)->query("killer") || environment(me)->query("no_zhaohuan"))
    return notify_fail("这个地方，你感觉有点难以召唤武器和防具。\n");
  notify_fail("召唤失败。\n");
  if (arg == "ring")
    arg = "finger";
  if (arg == "shoes")
    arg = "boots";
  if (arg == "kui")
    arg = "head";
  if (arg == "pifeng")
    arg = "surcoat";
  if (!create_equip(me, arg))
    return 0;
  write("ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： zhaohuan 	       - 查看你绑定的所有装备
	   zhaohuan [中文名]   - 召唤你绑定的名称为指定名的所有装备
	   zhaohuan [装备类型] - 召唤你绑定的类型为指定类型的所有装备
	   zhaohuan [all]      - 召唤你绑定的所有装备	

这个指令让你可以召唤回你专属的装备

HELP
  );
  return 1;
}
