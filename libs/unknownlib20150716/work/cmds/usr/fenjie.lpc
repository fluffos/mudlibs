//装备分解
#include <ansi.h>
inherit F_CLEAN_UP;

void check_suipian_amount(object who)
{
	int k;
	if( !who || !userp(who) || !living(who) )
		return;
	k = 0;	
	while( who->query("inventory/suipian")>=100 
	 && who->query("inventory/yingyu")>=3 )
	{
		who->add("inventory/suipian",-100);
		who->add("inventory/yingyu",-3);
		who->add("inventory/yingshi",1);
		k++;
	}
	if( k>0 )
		tell_object(who,HIG"【系统】你得到了"+chinese_number(k)+"块萤石。"NOR"\n");
}

void get_input(string arg, object me,object ob,int score,int succ)
{
	object yu,suipian;
	
	if( !me || !present(ob,me) || !living(me) )
		return;
        if( !arg || (arg[0..0]!="Y" && arg[0..0]!="y") )
		arg = "no";
	if( arg[0..0]=="n" || arg[0..0]=="N" )
	{
		tell_object(me,"你取消了洗练。\n");
		return;
	}	
	score = score/10;
	me->add("inventory/suipian",score);
	message_vision(HIC"\n$N"HIC"闭目凝神，口中喃喃念动了几句咒语，双手抵在"+ob->name(1)+HIC"上缓缓运转法力。\n"NOR,me);
	message_vision(HIC"霞光四溢中，只见"+ob->name(1)+HIC"渐渐虚化，瞬间化作了点点星光般的光华散落在空气之中。\n"NOR,me);	
	write(HIY"【系统】你得到了"+chinese_number(score)+"片"HIR"装备碎片"HIY"。\n"NOR);

	if( succ>0 )
	{
		score = random(score/10)+1;
		me->add("inventory/yingyu",score);
		write(HIY"【系统】你得到了"+chinese_number(score)+"块"NOR WHT"莹玉"NOR HIY"。\n"NOR);	
	}
	if( ob->is_zhaohuan() )
	{
		ob->do_dest(ob->query("id"));
	}
	else	me->add("potential",-300);
	me->set("mana",0);
	if( ob )  destruct(ob);
	check_suipian_amount(me);
	return;
}

int main(object me,string arg)
{
	int score,succ;
	string color;
	object yu,suipian,ob;

	if( me->query_level()<25 )
		return notify_fail("此功能25级开放。\n");	 	
	if( !arg )
		return notify_fail("你要分解什么装备？\n");
	ob = present(arg,me);
	if( !ob )
		return notify_fail("你身上没有"+arg+"。\n");
	if( !ob->is_armor() && !ob->is_weapon() )
		return notify_fail(ob->name(1)+"不能分解。\n");
	if( me->query("family/family_name") && ob->query("armor_title")==me->query("family/family_name") )
		return notify_fail("门派套装不能分解。\n");
	if( ob->query("no_fenjie") || ob->query("combination") )
		return notify_fail(ob->name(1)+"不能被分解。\n");		
	if( ob->query("equipped") )
		return notify_fail("你得先将"+ob->name(1)+"卸除。\n");
        if( me->query("mana")<me->query_maxmana() )
		return notify_fail("你的法力不够充裕。\n");
	if( me->is_busy() || me->is_fighting() )
		return notify_fail("你现在正忙着呢。\n");	
	if( (me->query("potential")-me->query("learned_points"))<800 )
		return notify_fail("你的潜能不够。\n");
	if( ob->is_armor() )
		color = ob->query("armor_color");
	else	color = ob->query("weapon_color");
	if( color )
	{
		if( color=="HIR" )
                        succ = random(10)>4;
		else if( color=="HIM" )
                        succ = random(10)>1;
		else	succ = 0;
	}
	else	return notify_fail(ob->name(1)+"品质太低，不能分解。\n");
		
	if( ob->is_armor() )
	{
		score = ("/cmds/usr/top.lpc")->get_score4(ob);
		switch(ob->query("armor_type"))
		{
			case "armor" : score=score*95/100;break;
			case "cloth" : score=score*90/100;break;
			case "hand"  : score=score*70/100;break;
			case "head"  :
			case "kui"   : score=score*80/100;break;
			case "neck"  : score=score*60/100;break;
			case "surcoat" :
			case "pifeng": score=score*80/100;break;
			case "finger":
			case "ring"  : score=score*60/100;break;
			case "shield": score=score*75/100;break;
			case "boots" :
			case "shoes" : score=score*70/100;break;
			case "waist" : score=score*65/100;break;
			case "hands" :
			case "wrists": score=score*55/100;break;
			case "fabao" :
			case "Fabao" : score=score*85/100;break;
			default : return notify_fail(ob->name(1)+"不能被分解。\n");	
		}
	}
	else
	{
		score = ("/cmds/usr/top.lpc")->get_score3(ob);
		score = score*99/100;
	}
	
	if( score<10 )
		return notify_fail(ob->name(1)+"评价过低，不能分解。\n");

        if( ob->is_zhaohuan() )   
        	write("\n"HIG+ob->name()+HIG"是绑定的装备。\n"NOR);
	write("\n"HIY"你确定要分解 "NOR+ob->name()+HIY" ？\n"HIR"请确认(yes 或 no)："NOR);
	input_to( (:get_input:), me,ob,score,succ);
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : fenjie [装备id]
  将装备分解，能得到装备碎片，并有几率获得萤玉
        装备碎片x100 + 莹玉x3 = 萤石x1
  萤石可以用来洗炼(xilian)装备或回炼(huilian)装备。
  洗炼：你可以指定保存一项或多项属性，同时随机化装备的其他属性。
  回炼：使洗炼过的装备回到上一次洗炼前的属性。
相关帮助 : help xilian
           help huilian  

HELP );
    return 1;
}

