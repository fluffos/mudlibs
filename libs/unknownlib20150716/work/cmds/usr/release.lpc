//Cracked by Roath
#include <ansi.h>

varargs void do_release(object me,object obj)
{
	int i;
	object *hufa;
	if( !me || !living(me) )
		return;
	if( !pointerp(hufa=me->query_temp("invocation")) 
         || sizeof(hufa)<=0 )
         	return;
	message_vision(HIY"\n$N"HIY"念动咒语，以法力沟通天地，掐法咒往虚空一指，“散”！\n\n"NOR,me);
	if( !obj )
	{
		for(i=0;i<sizeof(hufa);i++)
		{
			if( objectp(hufa[i]) )
			{
				if( environment(hufa[i]) )
				{
					all_inventory(environment(hufa[i]))->remove_killer(hufa[i]);
					hufa[i]->remove_all_killer();
				}
				hufa[i]->leave();
				me->add("mana",-30);				
			}
		}
		me->delete_temp("invocation");
		me->set_temp("last_invocation",time());
		tell_object(me,HIC"你释放了所有护法。\n"NOR);
	}
	else
	{
		if( environment(obj) )
		{
			all_inventory(environment(obj))->remove_killer(obj);
			obj->remove_all_killer();
		}
		obj->leave();
		me->add("mana",-30);
		hufa-= ({obj});
		hufa-= ({0});
		if( !pointerp(hufa) || sizeof(hufa)<1 )
			me->delete_temp("invocation");
		else	me->set_temp("invocation",hufa);
		me->set_temp("last_invocation",time());
		tell_object(me,HIC"你释放了一位护法。\n"NOR);	
	}
}

int main(object me,string arg)
{
	object npc,*hufa;
	
	if( environment(me)->query("no_release") )
		return notify_fail("当前场景无法释放护法。\n");
	
	if( !pointerp(hufa=me->query_temp("invocation")) 
         || sizeof(hufa)<=0 )
		return notify_fail("你并没有召唤护法。\n");
	
	if( time()<me->query("family/last_release")+15 )
		return notify_fail("你不能反复释放护法。\n");
	
	if( me->query("mana")<500 )
		return notify_fail("你法力不足。\n");
		
	if( !arg )
		do_release(me);
	else
	{
		if( !objectp(npc = present(arg,environment(me))) )
			return notify_fail("这里没有"+arg+"。\n");
		if( userp(npc) || member_array(npc,hufa)==-1 )
			return notify_fail(npc->name()+"不是你召唤的。\n");
		do_release(me,npc);
	}
	me->set("family/last_release",time());
	return 1;	
}

int help()
{
    write(@HELP
指令格式：release [ID]

将指定的自己召唤出的护法释放
当不指定时则释放所有护法

HELP );
    return 1;
}