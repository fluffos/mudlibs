#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int lvl,need;
	object who;
	
	if( !arg )
	{
		who = me;
		lvl = 1;
	}
	else
	{
		if( !wizardp(me) )
			return notify_fail("只有巫师才能查看他人信息。\n");
		who = find_player(arg);	
		if( !who )
			who = present(arg,environment(me));
		if( !who )
			return notify_fail("这里没有"+arg+"。\n");
	}
	lvl = who->query_level();
	need = who->query_max_exp();
	need-= who->query("combat_exp");
	write((me==who?"你":who->name(1))+"升级到"+(lvl+1)+"，还需要武学经验"+need+"点(突破除外)。\n");
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : level 
 
这个指令可以显示你升级所需的武学经验(突破任务除外)。
 
HELP
    );
    return 1;
}

