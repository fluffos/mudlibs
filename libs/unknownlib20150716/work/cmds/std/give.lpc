	if( !me || !living(me) || me->is_ghost() )
		return 0;
	if( !who || !present(me,environment(who)) 
	 || !living(who) || who->is_ghost() 
	 || !me->visible(who) )
	 	return notify_fail("你要给谁萤玉？\n");
