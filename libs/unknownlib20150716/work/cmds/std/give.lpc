//Cracked by Roath
// give.c
#include <ansi.h>
inherit F_CLEAN_UP;

int do_give(object me, object obj, object who);

void create() { seteuid(getuid()); }

varargs int do_give_money(object me,object who,string item,int amount)
{
	if( !me || !who || !item )
		return 0;
	if( amount<1 )
		return notify_fail("你给啥钱？！\n");
	switch(item) 
	{
		case "silver" 	: amount*= 100;break;
		case "gold"	: amount*= 10000;break;
	}
	if( amount<0 )
		return notify_fail("一次给太多了。。。。\n");
	if( !me->check_pay(amount) )
		return notify_fail("你没有这么多钱。\n");
	if( !userp(who) && !who->accept_money(me,amount) )
		return notify_fail("对方不要你的钱。\n");		
	message_vision("$N将"+MONEY_D->money_str(amount,1)+"递给$n。\n",me,who);
	me->money_add(-amount);
	if( userp(who) )
		who->money_add(amount);
	return 1;
}

int do_give_yingshi(object me,object who,int amount)
{
	if( !me || !living(me) || me->is_ghost() )
		return 0;
	if( !who || !present(me,environment(who)) 
	 || !living(who) || who->is_ghost() 
	 || !me->visible(who) )
	 	return notify_fail("你要给谁萤石？\n");
	if( me->query("inventory/yingshi")<amount )
		return notify_fail("你没有这么多萤石。\n");
	if( userp(me) && userp(who) && !me->query_temp("pending/give_yingshi") )
		return notify_fail("你目前不能将萤石交予玩家之手。\n");
	message_vision("$N掏出"+chinese_number(amount)+"块萤石，交到$n的手中。\n",me,who);
	me->delete_temp("pending/give_yingshi");
	if( userp(who) )
	{
		who->add("inventory/yingshi",amount);
		me->add("inventory/yingshi",-amount);
		return 1;
	}
	else
	{
		if( who->accept_yingshi(me,amount) )
		{
			me->add("inventory/yingshi",-amount);
			return 1;
		}
		message_vision("$N慌忙推让，说道："+RANK_D->query_self(who)+"无功不受禄，怎好要你的东西。\n",who);
		return 0;
	}
}

