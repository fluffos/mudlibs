inherit F_CLEAN_UP;
#include <ansi.h>
#include <dbase.h>

int main(object me, string arg)
{
	string str;
        object obj,*ob,toulu,corpse;
        object weapon;
        object *inv;
        mapping weapon_prop;

        string *killer, callname;
        int i,count;
        int value2;
        if( !arg )
                return notify_fail("你想要谁的头颅？\n");
	obj = present(arg, environment(me));
        if(!obj )
                return notify_fail("这里没有"+arg+"。\n");
        if(!obj->is_corpse() )
                return notify_fail("你必须先杀了这个人。\n");
        if(obj==me)
                return notify_fail("你想自刎？\n");
                
	str = obj->query("name");
	if( sscanf(str,"%s的尸体",str)!=1 )
                return notify_fail("这具尸体割不了头颅了。\n");
	
	if( !objectp(weapon=me->query_temp("weapon")) 
	 || ( weapon->query("skill_type")!="sword"
	   && weapon->query("skill_type")!="blade" ) )
		message_vision("\n"HIR"$N"HIR"上前拎住"+str+"的头颅，双手一使劲，嚓地一下，竟然将"+str+"的头整个扳了下来！溅了一身的鲜血。\n"NOR,me);
	else	message_vision("\n"HIR"$N"HIR"上前拎住"+str+"的头颅，挥起手中"+(weapon->query("skill_type")=="sword"?"长剑":"单刀")+"，手起头落，"+str+"三阳魁首跌落尘埃！溅了$N"HIR"一身的鲜血。\n"NOR,me);	

	me->add("bellicosity", 5);

        if( objectp(corpse = CHAR_D->make_wutoucorpse(obj)) )
        {
                message_vision("只看见鲜血还在不断地从"+str+"尸体的断脖流了出来。\n",me);
                corpse->move(environment(me));
        }
        else	
        {
        	if( corpse )
        		destruct(corpse);
        	return notify_fail("不能创建无头尸体，请告诉巫师。\n");
        }
        if( objectp(toulu = CHAR_D->make_toulu(obj) ))
	{ 
		if(obj->query("killer")) 
   			toulu->set("killer",obj->query("killer"));
                toulu->move(me);
	}
        else	write("不能创建头颅，请告诉巫师。\n");
	destruct(obj);
        return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : cut corpse

砍下某个死人的头颅。
HELP
    );
    return 1;
}
