#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me)
{
        me->powerup();
        me->set("force",me->query_maxforce()*2);
        me->set("mana",me->query_maxmana()*2);
        me->clear_condition();
        message_vision(REV HIM"$N"REV HIM"恢复成功了。"NOR"\n", me);
        return 1;
}

int help()
{
       write( @TEXT
指令格式：fullme
        信春哥，原地满血。
TEXT
       );
       return 1 ;
}
