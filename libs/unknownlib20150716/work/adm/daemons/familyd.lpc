		rank = ({	
			"沙弥","和尚","比丘","弘法大师","%s大师","持法长老","%s长老","%s长老","%s长老","护法金刚","%s金刚","法门罗汉","%s罗汉","智慧声闻","%s声闻","菩萨果","菩萨果","%s菩萨","%s菩萨","%s菩萨",
