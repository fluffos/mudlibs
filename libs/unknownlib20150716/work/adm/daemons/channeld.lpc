nosave mapping KillMsg = ([
  "slash": "斩", "slice": "砍", "chop": "劈", "hack": "劈",
  "thruse": "刺", "pierce": "刺", "wave": "鞭", "whip": "抽",
  "impale": "戳", "rake": "筑", "bash": "砸", "crush": "砸",
  "slam": "挫", "throw": "射", "shoot": "射",
]);

varargs void combat_channel(object me, object victim, int forall) {
  mixed prop;
  object weapon;
  string killmsg, rkmsg, attack_skill, mapp_skill, str;
  int msg_type = 0;
  if (!me || !victim || !me->is_fighting(victim))
    return;
  if (!stringp(killmsg = me->query_temp("kill_msg"))
    || strlen(killmsg) < 2)
    return;
  prop = 0;
  rkmsg = 0;
  if (!forall && !userp(victim)) {
    me->delete_temp("special_msg");
    me->delete_temp("kill_msg");
    return;
  }

  if (killmsg == "special_msg") {
    rkmsg = me->query_temp("special_msg");
    me->delete_temp("special_msg");
    msg_type = 1;
  } else {
    rkmsg = 0;
    if (!objectp(weapon = me->query_temp("weapon"))
      || !stringp(attack_skill = weapon->query("skill_type")))
      attack_skill = "unarmed";
    if (!stringp(mapp_skill = me->query_skill_mapped(attack_skill)))
      mapp_skill = attack_skill;
    //(!)
    if (!undefinedp(JueZhao[mapp_skill])) {
      prop = JueZhao[mapp_skill];
      if (mapp(prop)) {
        if (!undefinedp(prop[killmsg]))
          rkmsg = prop[killmsg];
      } else if (stringp(prop))
        rkmsg = prop;
    }
    if (!rkmsg) {
      if (!undefinedp(JueZhao[attack_skill]))
        prop = JueZhao[attack_skill];
      if (mapp(prop)) {
        if (!undefinedp(prop[killmsg]))
          rkmsg = prop[killmsg];
      } else if (stringp(prop))
        rkmsg = prop;
    }
    if (!rkmsg) {
      if (!undefinedp(JueZhao[killmsg]))
        prop = JueZhao[killmsg];
      if (stringp(prop))
        rkmsg = prop;
    }
    if (!rkmsg) {
      if (stringp(mapp_skill = me->query_skill_mapped("spells"))) {
        if (!undefinedp(JueZhao[mapp_skill]))
          prop = JueZhao[mapp_skill];
        if (mapp(prop)) {
          if (!undefinedp(prop[killmsg]))
            rkmsg = prop[killmsg];
        } else if (stringp(prop))
          rkmsg = prop;
      } else {
        if (!undefinedp(JueZhao["spells"]))
          prop = JueZhao["spells"];
        if (mapp(prop)) {
          if (!undefinedp(prop[killmsg]))
            rkmsg = prop[killmsg];
        } else if (stringp(prop))
          rkmsg = prop;
      }
    }
    if (!rkmsg) {
      if (stringp(mapp_skill = me->query_skill_mapped("force"))) {
        if (!undefinedp(JueZhao[mapp_skill]))
          prop = JueZhao[mapp_skill];
        if (mapp(prop)) {
          if (!undefinedp(prop[killmsg]))
            rkmsg = prop[killmsg];
        } else if (stringp(prop))
          rkmsg = prop;
      } else {
        if (!undefinedp(JueZhao["force"]))
          prop = JueZhao["force"];
        if (mapp(prop)) {
          if (!undefinedp(prop[killmsg]))
            rkmsg = prop[killmsg];
        } else if (stringp(prop))
          rkmsg = prop;
      }
    }
  }
  if (!rkmsg || !stringp(rkmsg) || strlen(rkmsg) < 2)
    msg_type = 3;

  if (msg_type == 3) {
    if (!undefinedp(KillMsg[attack_skill]))
      rkmsg = KillMsg[attack_skill];
    else rkmsg = "打";
  }

  str = victim->name(1) + HIM "在" + MISC_D->find_place(environment(me)) + HIM "被" + me->name(1);
  if (msg_type == 1)
    str += rkmsg;
  else {
    if (msg_type == 0) {
      str += "用一招" NOR HIY "「" + HIR + rkmsg + NOR HIY "」" NOR;
      if (userp(victim)) {
        if (victim->query_level() < 40)
          str += HIM "送去了" HIW "鬼门关" HIM "。" NOR;
        else str += HIM "打成了重伤。" NOR;
      } else if (victim->query_level() < 40)
        str += HIM "杀死了！" NOR;
      else str += HIM "打得重伤不起！" NOR;
    } else if (objectp(weapon = me->query_temp("weapon"))) {
      str += HIM "用" HIM + COLOR_D->clean_color(weapon->name(1)) + NOR + HIM + rkmsg + NOR;
      if (userp(victim)) {
        if (victim->query_level() < 40)
          str += HIR "死了" HIM "。" NOR;
        else str += HIM "得" NOR RED "重伤" NOR HIM "。" NOR;
      } else if (victim->query_level() < 40)
        str += HIM "杀死了！" NOR;
      else str += HIM "打得重伤不起！" NOR;
    } else {
      str += HIM + rkmsg + NOR;
      if (userp(victim)) {
        if (victim->query_level() < 40)
          str += RED "死了" NOR HIM "。" NOR;
        else str += HIM "得" NOR RED "重伤" NOR HIM "。" NOR;
      } else if (victim->query_level() < 40)
        str += HIM "杀死了！" NOR;
      else str += HIM "打得重伤不起！" NOR;
    }
  }
  me->delete_temp("special_msg");
  me->delete_temp("kill_msg");
  do_channel(this_object(), "rumor", str);
}
