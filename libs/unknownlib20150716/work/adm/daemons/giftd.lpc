#include <ansi.h>
#include <mudlib.h>
inherit F_DBASE;

nosave string item1;
nosave string item2;
nosave string item3;
nosave string item4;
nosave string item5;
nosave string item6;
nosave string item7;
nosave string item8;
nosave string item9;
nosave string item10;
nosave string item11;
nosave string item12;
nosave string item13;
nosave string item14;
nosave mapping DJ;
nosave int Set = 0;

mapping query_items() { return DJ; }

void create() {
  seteuid(getuid());
  set("channel_id", "礼物精灵");
}

varargs void Show(object who, string arg, string color) {
  string *msgs, str;
  int i;
  if (!who)
    return;
  if (!arg || !stringp(arg) || strlen(arg) < 2)
    return;
  if (!color || !stringp(color))
    color = HIY;
  arg = COLOR_D->clean_color(arg);
  arg = sort_string(arg, 68, 0);
  msgs = explode(arg, "\n");
  str = "";
  for (i = 0; i < sizeof(msgs); i++)
    str += "【系统】" + msgs[i] + "\n";
  tell_object(who, color + str + NOR);
}

void help_msg(object who) {
  string *msgs, msg;
  int i;
  if (!who || !living(who) || !userp(who))
    return;
  msgs = ({
    "Q：新人都有什么礼物？\nA：目前没什么礼物，要说礼物的话就在长安客栈n可以yao gold给你100gold的启动资金，别的就是一些过节什么的临时增加的。\n",
    "Q：我怎么听说有的门派开放没开放是什么意思？\nA：因为所有门派都重新写了，目前正在一步一步的写，所以有的门派还没开放，具体可以看help menpai。\n",
    "Q：新人学习老没精神，怎么恢复？\nA：10级之前可以在开封（从十字13个e）enter;fullme恢复，10级之后就不行了。也可以学一些内功，然后吸气学习。\n",
    "Q：我为什么不能飞呢？\nA：新人是不能飞的，当等级达到40级的时间可以用门忠跟师傅兑换飞行法宝，然后依靠ji fabao,然后就可以飞行。蜀山不依靠法宝使用perform fly后也可以飞行，因此蜀山可以兑换的法宝有飞行和攻击两种。\n",
    "Q：装备都去哪里搞啊。\nA：副本。一般来说30以下打副本打个武器随便凑合一下，因为很快就30了，30可以问门派师傅要门派套装（门忠兑换），30以上可以去秦陵1层打装备，这里已经会掉比较好的装备了，套装什么的。40以后就可以去秦陵2层。具体参见help fuben\n",
    "Q：我再打怪不升级了，怎么办？\nA：估计你到了9级、19级、29级。。。。这里每逢级个位数是9再升级就需要做突破任务，详见help tupo\n",
    "Q：我很多年没玩了，命令都忘记了怎么办？\nA：输入help cmds。\n",
    "Q：我在游戏里面喊了半天，都没人理我？\nA：大多数人都是上班，所以看qq群的人相对多一些。QQ群：4951331，也可以去15729502，82265333。\n",
    "Q：论坛地址是什么？\nA：http://www.pnwmud.com\n",
    "Q：哪里有挂机的机器？\nA：群共享。\n",
    "Q：nobusy打坐是什么意思？怎么计算？\nA：在这里打坐是可以没有busy的。也就是说你可以#10 打坐XXX,不过这个数值是有计算公式的，具体的为，你输入enable,显示你的内功的有效等级，然后(有效等级/40-1)*100算出来的数值就是你nobusy打坐的数值了。不过一般的机器里面都肯定已经有计算好的，直接用就可以。另外nobusy冥思计算同nobusy打坐。\n",
    "Q：怎么看功夫都有什么pfm？\nA：命令chkskill 技能，比如查看雪山想看冰谷凝血功有什么功能输入chkskill ningxie-force。\n",
    "Q：怎么看pfm的使用条件？\nA：输入help 技能_pfm来查看，比如 输入help siji-zhang_siji就会显示四季掌的pfm siji是使用条件。\n",
    "Q：天赋属性有没有上限？\nA：理论上来说是没有的，但是实际上受你的等级的影响，不同等级限制不同上限。\n",
    "Q：血河诀和屏风学哪个好？\nA：目前来说大多数人认为血河诀比屏风要好，因为血河诀的xuezong可以busy敌人而且本身不带busy。但是屏风可以划去敌人的内力法力，所以后期也有可能屏风更厉害。请根据自己的需要学习。\n",
    "Q：为什么我开始看自己挺漂亮，但是过了几天再看自己发现自己很丑？\nA：因为属性上限受到等级限制，比如同样的你容貌30，你10级的时间看你就很漂亮，等你40级你容貌还是30的花，距离上限就很远了，所以看起来就好像自己变“丑”了。\n",
    "Q：小神通是什么？怎么获得？\nA：参见 help tupo40。在39突破到40的时间选2，然后去相应的地方找到石头给师傅筑基成功可以获得，具体小神通的作用可以看help xiaoshen。自己目前小神通的作用可以看help spells_xiaoshen获知.\n",
  });
  msg = msgs[random(sizeof(msgs))];
  msgs = explode(msg, "\n");
  for (i = 0; i < sizeof(msgs); i++) {
    if (stringp(msg = msgs[i]) && strlen(msg) > 2) {
      if (i % 2 == 0)
        Show(who, msg, HBBLU + HIW);
      else Show(who, msg, HBBLU + HIY);
    }
  }
  Show(who, "\t\t\t\t\t以上FAQ由self整理。\n", HBBLU + HIG);
  msgs = ({
    "将装备碎片、萤玉、萤石数据化了，打到的实物需要找南城客栈里的两个炼器师转化。\n",
    "有性别等限制的装备可以找南城客栈的炼器师清除限制。\n",
    "召唤类护法如不在身边了，可以通过release命令来清除。\n",
    "非地府弟子去地府只要在身上携带一个幽冥丹再跳径水桥即可，幽冥丹长安药铺有售。\n",
    "套装、法宝、筑基等 在 ask NPC about all中不显示，满足相应的条件才触发。\n",
    "可以在长安长孙无忌处改名或给名字加颜色。\n",
  });
  msg = msgs[random(sizeof(msgs))];
  msgs -= ({ msg });
  msg += msgs[random(sizeof(msgs))];
  msg = "友情提示：\n" + msg;
  Show(who, msg, HBBLU + HIY);
}

int update_level(object who) {
  object gift;
  if (!who)
    return 0;
  if (who->query("env/no_help"))
    return 0;
  if (who->query_level() < 20 && !who->query("mark/newbie_gold")) {
    tell_object(
      who,
      "\n" HIY "【系统】" HIR "20" HIY "级之前，你可以在长安南城客栈的" HIC "新手准备室" HIY "找" HIG "小雨" HIY "要一次启动资金。" NOR "\n"
    );
    Show(who, "本泥潭内，人物的金钱、潜能不会因死亡而有任何损失的。", HIR);
  }
  help_msg(who);
  switch (who->query_level()) {
    case 1:
      ("/quest/gift/level/1.lpc")->update_level(who);
      break;
    case 2:
      ("/quest/gift/level/2.lpc")->update_level(who);
      break;
    case 3:
      ("/quest/gift/level/3.lpc")->update_level(who);
      break;
    case 4:
      ("/quest/gift/level/4.lpc")->update_level(who);
      break;
    case 5:
      ("/quest/gift/level/5.lpc")->update_level(who);
      break;
    case 9:
      ("/quest/gift/level/9.lpc")->update_level(who);
      break;
    case 10:
      ("/quest/gift/level/10.lpc")->update_level(who);
      break;
    case 11:
      ("/quest/gift/level/11.lpc")->update_level(who);
      break;
    case 19:
      ("/quest/gift/level/19.lpc")->update_level(who);
      break;
    case 20:
      ("/quest/gift/level/20.lpc")->update_level(who);
      break;
    case 25:
      ("/quest/gift/level/25.lpc")->update_level(who);
      break;
    case 29:
      ("/quest/gift/level/29.lpc")->update_level(who);
      break;
    case 30:
      ("/quest/gift/level/30.lpc")->update_level(who);
      break;
    case 39:
      ("/quest/gift/level/39.lpc")->update_level(who);
      break;
    case 49:
      ("/quest/gift/level/49.lpc")->update_level(who);
      break;
    case 50:
      ("/quest/gift/level/50.lpc")->update_level(who);
      break;
    case 90:
      ("/quest/gift/level/90.lpc")->update_level(who);
      break;
    default:
      break;
  }
}

int first_log(object who, string type, string msg) {
  mapping date;
  string t, file;
  if (!who || !userp(who))
    return 0;
  if (type != "System" && type != who->query("id"))
    return 0;
  if (type == "System") {
    file = "/log/system/sys";
    msg = sprintf("%s(%s)%s", who->query("name"), capitalize(who->query("id")), msg);
  } else file = sprintf("/log/user/%c/%s", who->query("id")[0], who->query("id"));
  date = XYJTIME_D->check_time(time());
  t = date["YEAR"] + date["MONTH"] + date["DAY"];
  msg = t + msg;
  seteuid(ROOT_UID);
  log_file(file, msg);
  seteuid(getuid());
  return 1;
}

mixed newbie_gift(object who, object npc, int level) {
  if (!who || !npc)
    return 0;
  if (who->query_level() != level)
    return 0;
  if (!living(npc))
    return notify_fail(npc->name() + "现在分身不暇。\n");
  switch (level) {
    case 2: return ("/quest/gift/level/2.lpc")->newbie_gift(who, npc);
    case 4: return ("/quest/gift/level/4.lpc")->newbie_gift(who, npc);
    case 5: return ("/quest/gift/level/5.lpc")->newbie_gift(who, npc);
  }
}

varargs void init_gift_inventory(object who) {
  item1 = item2 = item3 = item4 = item5 = item6 = item7 = item8 = item9 = item10 = item11 = item12 = item13 = item14 = 0;
  DJ = 0;
  Set = 0;
  if (who && who->query("gift_inventory"))
    who->delete("gift_inventory");
}

void jieri_gift(object who) {
  string *files, file;
  mixed *local;
  int mo, da, v;

  if (!who || !living(who))
    return;

  local = localtime(time());
  da = local[3];
  mo = local[4] + 1;
  //国庆
  if (mo != 10 || da < 1 || da > 8)
    //if( mo!=9 || da!=30 )
    return;

  if (time() < who->query_temp("guoqing_gift") + 10)
    return;
  who->set_temp("guoqing_gift", time());

  if (!Set) {
    Set = 1;

    item1 = HIY "精" NOR;
    item2 = HIR "忠" NOR;
    item3 = HIC "报" NOR;
    item4 = HIW "国" NOR;
    item5 = HIG "家" NOR;
    item6 = HIM "栋" NOR;
    item7 = HIY "梁" NOR;
    item8 = HIR "倾" NOR;
    item9 = HIB "城" NOR;
    item10 = HIY "金" NOR;
    item11 = HIW "闺" NOR;
    item12 = YEL "士" NOR;
    item13 = CYN "无" NOR;
    item14 = WHT "双" NOR;

    DJ = ([
      HIY "精" NOR: "item1",
      HIR "忠" NOR: "item2",
      HIC "报" NOR: "item3",
      HIW "国" NOR: "item4",
      HIG "家" NOR: "item5",
      HIM "栋" NOR: "item6",
      HIY "梁" NOR: "item7",
      HIR "倾" NOR: "item8",
      HIB "城" NOR: "item9",
      HIY "金" NOR: "item10",
      HIW "闺" NOR: "item11",
      YEL "士" NOR: "item12",
      CYN "无" NOR: "item13",
      WHT "双" NOR: "item14",
    ]);
    CHANNEL_D->do_channel(this_object(), "sys", "启动完毕");
  }
  return;
  files = ({
    item1, item2, item3, item4, item5, item6, item7, item8, item9, item10, item11, item12, item13, item14,
  });
  file = files[random(sizeof(files))];
  files -= ({ file });
  v = 2 + random(3);
  v *= 2;
  tell_object(
    who,
    HIG "【" HIR "国庆节" HIG "】" HIY "节日快乐！你得到了" + chinese_number(v) + "个『" + NOR + REV + file + NOR + HIY "』。" NOR "\n"
  );
  file = DJ[file];
  who->add("gift_inventory/" + file, v);

  file = files[random(sizeof(files))];
  files -= ({ file });
  v = 2 + random(3);
  v *= 2;
  tell_object(
    who,
    HIG "【" HIR "国庆节" HIG "】" HIY "节日快乐！你得到了" + chinese_number(v) + "个『" + NOR + REV + file + NOR + HIY "』。" NOR "\n"
  );
  file = DJ[file];
  who->add("gift_inventory/" + file, v);

  file = files[random(sizeof(files))];
  v = 2 + random(3);
  v *= 2;
  tell_object(
    who,
    HIG "【" HIR "国庆节" HIG "】" HIY "节日快乐！你得到了" + chinese_number(v) + "个『" + NOR + REV + file + NOR + HIY "』。" NOR "\n"
  );
  file = DJ[file];
  who->add("gift_inventory/" + file, v);

  if (random(who->query_kar()) > 10) {
    file = item8;
    v = 5 + random(10);
    tell_object(
      who,
      HIG "【" HIR "国庆节" HIG "】" HIY "节日快乐！你得到了" + chinese_number(v) + "个『" + NOR + REV + file + NOR + HIY "』。" NOR "\n"
    );
    file = DJ[file];
    who->add("gift_inventory/" + file, v);
  }
}

string gift_inventory(object who) {
  string str1, str2, *inv, data;
  mixed *local;
  int mo, da, i, v, j, k;
  if (!who || !Set)
    return 0;
  if (!DJ || !mapp(DJ)
    || sizeof(DJ) < 1)
    return 0;
  local = localtime(time());
  da = local[3];
  mo = local[4] + 1;
  //国庆
  if (mo != 10 || da < 1 || da > 8)  //if( mo!=9 || da!=30 )
  {
    init_gift_inventory(who);
    return 0;
  }

  inv = keys(DJ);
  str1 = str2 = "\t";
  j = k = 0;
  for (i = 0; i < sizeof(inv); i++) {
    data = DJ[inv[i]];
    sscanf(data, "item%d", v);
    if (v <= 9) {
      j++;
      str1 += inv[i] + NOR "x" + HIR + who->query("gift_inventory/" + data) + NOR "  ";
    } else {
      k++;
      str2 += inv[i] + NOR "x" + HIR + who->query("gift_inventory/" + data) + NOR "  ";
      if (k % 6 == 5)
        str2 += "\n\t";
    }
  }
  return str1 + "\n" + str2 + "\n";
}
