int atoi(string str)
{
        int v;
        if( !stringp(str) || !sscanf(str, "%d", v) ) 
                return 0;
        return v;
}

int last_num(int v)
{
        int i;
        string str;
        if( v<=0 )
                return 0;
        str = sprintf("%d",v);
        i = strlen(str);
        str = sprintf("%c",str[i-1]);
        sscanf(str,"%d",v);
        return v;
}

nomask varargs int Int_com(int ap,int dp,int v)
{
        return 1;
}

nomask mixed abs(mixed n)
{
	if(!floatp(n) && !intp(n))
		return 0;

	return (n<0)? -n : n;
}

nomask float BFB(int a,int max)
{
	int b;
	float aa;
	
	aa = to_float(a);
        if( a<10000000 )
        	aa = aa*100/(to_float(max));
        else	aa = aa/10000*100/((to_float(max))/10000);
	
	aa*= 100;
	b = to_int(aa);
        aa = to_float(b)/100;
        if( aa>100 ) aa = 100;	
	return aa;
}