// rewritten by xueshan on 09/11/2000
// Room: shidong

inherit ROOM;

void create ()
{
  set ("short", "石洞");
  set ("long", @LONG

洞门由两块大石板依山势修葺而成。看起来做的严严实实。

LONG);

  set("light_up", 1);
  set("outdoors", "firemount");
  set("exits", ([
        "westdown" : __DIR__"shanlu2",
      ]));

  setup();
}

void init()
{
	add_action("do_za", "za");
}

int do_za(string arg)
{
	object me = this_player();
  	object weapon = me->query_temp("weapon");
	
	if( !arg || (arg != "shimen" && arg != "door") )
		return err_msg("你想砸什么。\n");
	if( !weapon )
  	{
                return err_msg("你赤膊上阵捏着拳头往石门上一砸！\n乓地一声你只觉得骨头都震碎了！\n");
  	}
	message_vision("$N鼓足劲，轮起$n向大门砸去。\n",me,weapon);
	if( this_object()->query("exits/east") )
		return err_msg("乓地一声砸在已经打开的门上！\n");	
        if( me->query("force")<200 )
                return err_msg("乓地一声你只觉得骨头都震碎了！\n");
	message_vision ("乓地一声门开了！\n",me);
        me->add("force",-200);
	this_object()->set("exits/east", __DIR__"shandong");
    	remove_call_out ("close");
    	call_out ("close",60);
	return 1;
}

void close()
{
	this_object()->delete("exits/east",);
}
