// room.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set ("short", "聚义厅");
	set ("long", @LONG

这里便是清风寨的大堂－－－聚义厅。厅中一十六张虎皮软椅分
列两旁，正面一张香台(tai)，供着关公大帝(statue)。山寨里的头领要开会的
话，多半会选在这里举行。另外也是分赃宴会的地方。
LONG);

	set("exits", ([
		"southdown" : "/d/gao/shanlu",
		"east" : "/d/gao/neishi",
	]));
 	set("objects", ([ 
		"/d/gao/npc/head" : 1,
	]));
	set("item_desc",([
		"tai" : "一张红木作的大香台，上面供着关公大帝(statue)。\n",
		"statue" : "一尊关老爷的神像，乍一看和普通的关帝像差不多，不过仔细端详，你会发现神像的地座好似可以转动(turn)。\n",
	]));		
	
	create_door("east", "石门", "west", DOOR_CLOSED);
        set("no_clean_up", 0);
        setup();
}

int valid_leave(object me, string dir)
{
	object npc;
	if ( dir == "east" ) 
	{
		if( objectp(npc=present("xia pengzhan", environment(me)))
		 && living(npc) && !userp(npc) )
			return notify_fail("夏鹏展一个箭步闪到你前面，狞笑道：清风寨可是你想来便来，想走便溜的的地方！\n");
	}
	return ::valid_leave(me, dir);
}

void init()
{
	add_action("do_jump","jump");
	add_action("do_turn","turn");
}

int do_turn(string arg)
{
	object npc,me = this_player();
	
	if( me->query_temp("pending/shuizhu_statue_turned") )
		return notify_fail("神像已经被你转过了。\n");
	if( me->query("gin")<30 )
		return notify_fail("你的活力不够了。\n");
	if( time()<me->query("maze/lingzhu-feng")+1800 )
		return notify_fail("你属「耗子」的？这么喜欢钻洞？\n");			
	if( objectp(npc=present("xia pengzhan", environment(me)))
	 && living(npc) && !userp(npc) )
		return notify_fail("夏鹏展拿牛眼大的白眼朝你瞅了瞅。\n");
	if( !arg || arg!="statue" )
		return notify_fail("你要转什么？\n");
	me->set_temp("pending/shuizhu_statue_turned",1);	
	message_vision("$N走上前去，抡圆了膀子，抱着神像，转了几转。\n",me);
	write(HIC"”嘎嘣“一声，神像的底座内好似传来一阵机括之声。\n"NOR,me);
	message_vision("只能见香台下传来一阵”轰隆隆“的响声。\n",me);
	write(HIC"香台下面露出了一个漆黑的大洞，一眼看不清底。你可以试着跳(jump)下去。\n"NOR);
	return 1;
}
	
int do_jump(string arg)
{
	object me = this_player();
	
	if( (!arg || arg!="down") 
	 || !me->query_temp("pending/shuizhu_statue_turned") 
	 || me->query("gin")<30 
	 || time()<me->query("maze/lingzhu-feng")+1800 )
		return 0;
	 	
	message_vision("$N纵深跳入地洞之中。\n",me);	
	me->dismiss_team(); 
	me->delete_temp("maze"); 
	if( !MAZE_D->enter_maze(me, "lingzhu-feng") )
	{ 
		message("vision","\n脚步传来，"+me->name()+"头顶蜘蛛网从洞中跳了出来，露出悻悻的神色。\n\n",this_object(),me); 
		tell_object(me,HIC"你在洞内什么也没发现，倒是顶了一头的蜘蛛网。\n"NOR);
		return 1; 
	}
	me->set("maze/lingzhu-shui",time());
        tell_object(me,CYN"你跳入了地洞内，仔细观瞧。\n");
        me->add("gin",-30);
        return 1;
}