#include <ansi.h>
inherit HUFA;

varargs void setskills(int i) {
  if (!i || i < 60)
    i = 60;
  set("receive_damage", 0);
  set("long", "守护蜀山的护法。\n");
  create_family("蜀山派", 3, "红");
  set("looking", HIR "剑眉如峰，相貌古朴" NOR "。");
  set("rank_info/pos_msg", HIY "周身盘旋无数金色剑气" NOR "。\n");
  set("title", "蜀山守山护法");
  set("gender", "男性");
  set("age", 65);
  set("attitude", "peaceful");
  set("class", "taoist");

  set_skill("spells", i);
  set_skill("force", i);
  set_skill("dodge", i);
  set_skill("parry", i);
  set_skill("sword", i);
  set_skill("xianfeng-yunti", i);
  set_skill("zuixian-wangyue", i);
  set_skill("chuanyun-zhang", i);
  set_skill("literate", i);
  set_skill("unarmed", i);
  set_skill("yujianshu", i);
  set_skill("tianshi-fufa", i);
  map_skill("spells", "tianshi-fufa");
  map_skill("dodge", "zuixian-wangyue");
  map_skill("force", "xianfeng-yunti");
  map_skill("parry", "yujianshu");
  map_skill("sword", "yujianshu");
  map_skill("unarmed", "chuanyun-zhang");

  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "wanjian" :),
    (: exert_function, "recover" :),
    (: exert_function, "refresh" :),
  }));
  setup();
}

string name(int raw) {
  string str;
  if (this_object()->query_level() < 70)
    str = "";
  else if (this_object()->query_level() < 80)
    str = "金戈";
  else if (this_object()->query_level() < 90)
    str = "金庚";
  else if (this_object()->query_level() < 100)
    str = "庚乙";
  else str = "太乙";
  return str + "剑神";
}

string *parse_command_id_list() {
  if (this_object()->query_level() < 70)
    return ({ "jian shen", "jianshen", "hu fa", "hufa", });
  else if (this_object()->query_level() < 80)
    return ({ "jinge jianshen", "jian shen", "jianshen", "hufa", "hu fa", });
  else if (this_object()->query_level() < 90)
    return ({ "jingeng jianshen", "jianshen", "jian shen", "hufa", "hu fa", });
  else return ({ "taiyi jianshen", "jianshen", "jian shen", "hufa", "hu fa", });
}
