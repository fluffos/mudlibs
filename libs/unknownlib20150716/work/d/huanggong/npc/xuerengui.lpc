inherit NPC;
#include <ansi.h>
#include "greeting.h"

void choose_name(string arg, object me);

string about_qingling()
{
        object me = this_player();
        if( time()<me->query("maze/last_QLboss2")+3600 )
                      return "你不是刚刚除去了骷髅妖士？";
        if( time()<me->query("maze/last_QLboss3")+3600 )
                      return "感谢这位"+RANK_D->query_respect(me)+"解决了长安之危。";
        if( me->query_temp("maze/qingling_ask") )
                return "多说无益，你去看看吧。";
        if( time()<me->query("maze/qingling")+1800 )
                return "你还是下去歇歇再去吧。";
        if( me->query_level()>=50 && me->query("gin")<50 )
                return "你的活力不足也。";              
        me->set_temp("maze/qingling_ask",1);
        return "好，便依赖"+ RANK_D->query_respect(me)+"了。";  
}

mixed about_fuwen();

mixed about_taofan()
{
        object me = this_player();
        if( me->query_level()<40 )
                return err_msg(CYN+name()+CYN"说道："+RANK_D->query_respect(me)+"有心报国，无奈无力回天呐！\n"NOR);
        return ("/quest/taofan/kill.lpc")->query_yao(me); 
}

string about_cancel()
{
        return ("/quest/taofan/kill.lpc")->cancel_me(this_player());
}

void create()
{
        set_name("薛仁贵", ({ "xue rengui", "xue", "rengui" }) );
        set_level(39);
        set("gender", "男性");
        set("age", 35);
        set("long","薛仁贵是长安城九门提督，负责皇宫内外安全。\n");
        create_family("将军府",3,"元帅");
        set("title", HIR"征东大元帅"NOR);
        set("nickname", HIY"勇冠三军"NOR);
        set("attitude", "friendly");
        set("force_factor", 100);
        set("mana_factor", 100);
        
        set_skill("unarmed",390);
        set_skill("force",390);
        set_skill("dodge",390);
        set_skill("parry",390);
        set_skill("spear",390);
        set_skill("bawang-qiang",390);
        map_skill("spear","bawang-qiang");
        map_skill("parry","bawang-qiang");
        set_skill("lengquan-force",370);
        map_skill("force","lengquan-force");
        set_skill("yanxing-steps",370);
        map_skill("dodge","yanxing-steps");
        set("inquiry", ([
                "始皇陵" : (: about_qingling :),
                "符文"   : (: about_fuwen :),
                "逃犯"   : (: about_taofan :),
                "放弃"   : (: about_cancel :),
        ]));
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "spear", "ba" :),
                (: perform_action, "spear", "bugong" :),
                (: perform_action, "spear", "huima" :),                
                (: perform_action, "spear", "juanlian" :),                
        }) );
        set_temp("weapon_level",10+random(20));
        set_temp("armor_level",10+random(20));
        set("env/test","HIY");
        setup();
        carry_object(0,"armor",1)->wear();
        carry_object(0,"shoes",1)->wear();
        carry_object(0,"kui",1)->wear();
        carry_object(0,"pifeng",1)->wear();
        carry_object(0,"shield",1)->wear();
        carry_object(0,"cloth",1)->wear();
        carry_object(0,"spear",1)->wield();

}

void init ()
{
        greeting2(this_player());
}

int accept_fight(object me)
{
        command("say 我为殿前将军，岂能与你村野匹夫较艺！");
        return 0;
}

void unconcious()
{
        die();
}
void die ()
{
        powerup(0,1);
}

void show_choose(object me)
{
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        tell_object(me,HIC"你可以在此合成以下初级符文：\n"NOR);
        tell_object(me,HIY" 1. 一阶初级符文"NOR"\n");
        tell_object(me,HIY" 2. 二阶初级符文"NOR"\n");
        tell_object(me,HIY" 3. 三阶初级符文"NOR"\n");
        tell_object(me,HIY" 4. 高阶初级符文"NOR"\n");           
        tell_object(me,HIC"请选择(1~4)，按Q退出："NOR);
        input_to("choose_jie",me);
}

void show_name(object me)
{
        int lvl;
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        lvl =  me->query_temp("pending/fuwen/lvl");
        tell_object(me,HIC"你可以在此合成以下"+chinese_number(lvl)+"阶初级符文：\n"NOR);
        tell_object(me,HIY"1. 寒冰符"NOR"\n");
        tell_object(me,HIY"2. 飞轮符"NOR"\n");
        tell_object(me,HIY"3. 血石符"NOR"\n");
        tell_object(me,HIY"4. 清风符"NOR"\n");
        tell_object(me,HIY"5. 惊雷符"NOR"\n");
        tell_object(me,HIC"请选择(1~5)，按Q返回上一阶："NOR);
        input_to("choose_name",me);
}

object check_suipian(object me,string name,int lvl,int v)
{
        int i;
        string file;
        object *inv;
        if( !me || !living(me) 
         || !environment() || !name
         || !present(me,environment()) )
                return 0;
        inv = all_inventory(me);
        if( !pointerp(inv) || sizeof(inv)<1 )
                return 0;
        switch(name)
        {
                case "寒冰" : file = "/d/maze/qingling-3/obj/sp1";break;
                case "飞轮" : file = "/d/maze/qingling-3/obj/sp2";break;
                case "血石" : file = "/d/maze/qingling-3/obj/sp3";break;
                case "清风" : file = "/d/maze/qingling-3/obj/sp4";break;
                case "惊雷" : file = "/d/maze/qingling-3/obj/sp5";break;
                default: return 0;
        }       
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i]->query("owner_id")==me->query("id")
                 && base_name(inv[i])==file )
                        return inv[i];
        }
        return 0;       
}

void create_fuwen(object me)
{
        object fu,sp;
        string name,file;
        int lvl,v,have,ap,dp;
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        name = me->query_temp("pending/fuwen/name");
        lvl =  me->query_temp("pending/fuwen/lvl");     
        me->delete_temp("pending/fuwen");
        switch(name)
        {
                case "寒冰" : file = "/d/maze/qingling-3/obj/fu1";break;
                case "飞轮" : file = "/d/maze/qingling-3/obj/fu2";break;
                case "血石" : file = "/d/maze/qingling-3/obj/fu3";break;
                case "清风" : file = "/d/maze/qingling-3/obj/fu4";break;
                case "惊雷" : file = "/d/maze/qingling-3/obj/fu5";break;
                default: return;
        }       
        
        v = (2*lvl-1)*10;
        if( v>100 )
                v = 100;
        if( !objectp(sp=check_suipian(me,name,lvl,v)) )
        {
                tell_object(me,HIR"【系统】合成"+chinese_number(lvl)+"阶「"+name+"符」，需要消耗"+chinese_number(v)+"颗"+name+"魄，你身上没有。\n"NOR);
                return;
        }
        have = sp->query_amount();
        if( have<v )
        {
                tell_object(me,HIR"【系统】合成"+chinese_number(lvl)+"阶「"+name+"符」，需要消耗"+chinese_number(v)+"颗"+name+"魄，你身上只有"+chinese_number(have)+"颗。\n"NOR);
                return;
        }
        fu = new(file);
        fu->set("level",lvl);
        if( !fu->move(me) )
        {
                if( fu ) destruct(fu);
                tell_object(me,HIR"【系统】你的背包满了。\n"NOR);
                return;
        }
        if( have==v )
                destruct(sp);
        else    sp->add_amount(-v);
        
        ap = random(me->query_kar());
        dp = lvl*2;
        if( wizardp(me) )
                tell_object(me,sprintf("ap=%d,dp=%d\n",ap,dp));
        if( random(ap+dp)<dp )
        {
                if( fu ) 
                {
                        if( fu->query_amount()==1 )
                                destruct(fu);
                        else    fu->add_amount(-1);     
                }
                tell_object(me,HIR"【系统】合成失败！你平白损失了"+chinese_number(v)+"颗"+name+"魄。\n"NOR);
                return;
                
        }
        tell_object(me,HIG"【系统】合成成功！你得到了"+fu->name()+HIG"。"NOR"\n");
}

void choose_name(string arg, object me)
{
        int v;
        string name;
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        if( !arg )
        {
                show_name(me);
                return;
        }
        if( arg[0]=='q' || arg[0]=='Q' )
        {
                show_choose(me);
                return; 
        }
        sscanf(arg,"%d",v);
        if( v<1 || v>5 )
        {
                show_name(me);
                return;
        }
        switch(v)
        {
                case 1 : name = "寒冰";break;
                case 2 : name = "飞轮";break;
                case 3 : name = "血石";break;
                case 4 : name = "清风";break;
                default: name = "惊雷";break;
        }       
        me->set_temp("pending/fuwen/name",name);
        create_fuwen(me);
}

void choose_lvl(string arg, object me)
{
        int lvl;
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        if( !arg )
        {
                tell_object(me,HIC"请输入你要合成的初级符文阶数(4~10)，按Q返回上一阶："NOR);
                input_to("choose_lvl",me);
                return;
        }
        if( arg[0]=='q' || arg[0]=='Q' )
        {
                show_choose(me);
                return; 
        }
        sscanf(arg,"%d",lvl);
        if( lvl>10 || lvl<4 )
        {
                tell_object(me,HIC"请输入你要合成的初级符文阶数(4~10)，按Q返回上一阶："NOR);
                input_to("choose_lvl",me);
                return;
        }
        me->set_temp("pending/fuwen/lvl",lvl);
        show_name(me);
}

void choose_jie(string arg, object me)
{
        int lvl;
        if( !me || !living(me) 
         || !environment() 
         || !present(me,environment()) )
                return;
        if( !arg 
         || ( arg[0]!='1' && arg[0]!='2'
           && arg[0]!='3' && arg[0]!='4') )
        {
                if( arg[0]=='q' || arg[0]=='Q' )
                        return;
                show_choose(me);        
                return;
        }
        switch(arg[0])
        {
                case '1' : lvl = 1;break;
                case '2' : lvl = 2;break;
                case '3' : lvl = 3;break;
                default  : 
                        tell_object(me,HIC"请输入你要合成的初级符文阶数(4~10)，按Q返回上一阶："NOR);
                        input_to("choose_lvl",me);
                        return;
        }
        me->set_temp("pending/fuwen/lvl",lvl);
        show_name(me);
}               

mixed about_fuwen()
{
        object me = this_player();
        
        if( !userp(me) || !environment() )
                return 0;
        if( me->query_level()<20 )
                return "你还需要多练练。";
        me->delete_temp("pending/fuwen");               
        show_choose(me);
        return 1;
}       

int accept_object(object who,object ob)
{
        int exp_r,pot_r,dx_r,lvl,k;
        object obj;
        mapping reward;
        if( !userp(who) )
                return 0;
        if( !who->doing_job("逃犯任务") )
        {
                tell_object(who,CYN+name()+CYN"说道：本帅有给你任务吗？\n"NOR);
                return 0;
        }                       
        if( base_name(ob)!="/d/obj/misc/toulu" )
                return 0;
        if( ob->query("owner")!=who )
        {
                tell_object(who,CYN+name()+CYN"说道：你从哪里得来的头颅？！莫非你犯了事？！\n"NOR);
                return 0;
        }
        if( !mapp(reward=ob->query("taofan_reward"))
         || sizeof(reward)<1 )
        {
                tell_object(who,CYN+name()+CYN"说道：呵呵，虽没有功劳，倒也有苦劳。\n"NOR);
                return 1;
        }
        if( !undefinedp(reward["combat_exp"]) )
                exp_r = reward["combat_exp"];
        else    exp_r = 0;
        if( !undefinedp(reward["daoxing"]) )
                dx_r = reward["daoxing"];
        else    dx_r = 0;
        if( !undefinedp(reward["potential"]) )
                pot_r = reward["potential"];
        else    pot_r = 0;

        QUEST_D->job_reward_player(who,"combat_exp",exp_r,"逃犯任务");
        QUEST_D->job_reward_player(who,"daoxing",dx_r,"逃犯任务");
        QUEST_D->job_reward_player(who,"potential",pot_r,"逃犯任务");
        tell_object(who,HIY+who->finish_job("逃犯任务",({exp_r,dx_r,pot_r}))+NOR);
        lvl = who->query_job_level("逃犯任务");
        if( lvl>=10 )
        {
                tell_object(who,HIY"恭喜！你完成了一轮普通级别的官府任务。\n"NOR);                              
                who->money_add(10000);
                tell_object(who,"你得到了一两黄金的奖励。\n");
                if( random(3) )
                {
                        who->add("xyscore",3);
                        tell_object(who,HIY"你得到了"HIR"3点"HIY"江湖威望，"HIR"10点"HIY"江湖威望可以开启各挂机任务的"HIR"噩梦"HIY"模式。\n"NOR);
                }
                k = random(10)/2*2;
                if( k>1 )
                {
                        who->add("inventory/suipian",k);
			tell_object(who,HIY"你得到了"HIR+k+HIY"块装备碎片。"NOR"\n");
                }
                if( random(5)==3 )
                {
                        who->add("inventory/yingshi",1);
			tell_object(who,HIY"你得到了"HIR"1"HIY"块萤石。"NOR"\n");
                }
                else if( random(2) )
                {
                        k = random(5);
                        if( k>0 )
                        {
                                who->add("inventory/yingyu",k);
				tell_object(who,HIY"你得到了"HIR+k+HIY"块萤玉。"NOR"\n");
                        }               
                }
                ("/cmds/usr/fenjie.lpc")->check_suipian_amount(who);
        }
        return 1;
}
        
        
                        
