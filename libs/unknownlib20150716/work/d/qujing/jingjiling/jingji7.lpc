#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "荆棘岭");
  set("long", @LONG
岭上荆棘丫叉，薜箩牵绕。下面虽是有道路的痕迹，左右却都是
荆辞棘针，除是蛇虫伏地而游，方可过去。周围人烟稀少，空山
但闻鸟语猿啼不绝。
LONG);
  set("outdoors", 1);
  set("exits", ([
    "southeast": __DIR__ "jingji6",
  ]));
  setup();
}

void init() {
  add_action("do_clean", ({ "bo", "clean", "push", "pushaside" }));
}

string tribar_graph(int val, int max, string bcolor, string fcolor, string dcolor) {
  string ret;
  int i, n, max_n = 11;

  n = val * 100 / max / 10;
  if (n < 0) n = 0;
  if (n > max_n) n = max_n;

  ret = NOR + bcolor + fcolor;
  for (i = 0; i < max_n; i++) {
    if (i < n) ret += "━";
    else ret += HIW "━" NOR;
  }
  ret += fcolor + NOR;
  return ret;
}

void done() {
  if (query("exits/westup"))
    return;
  set("long", @LONG

岭上荆棘丫叉，薜箩牵绕。下面有一条道路的痕迹，左右的荆刺
棘针已被推到一旁，小心行过却是无碍。周围人烟稀少，空山但
闻鸟语猿啼不绝。
LONG);
  set("clean", 1);
  set("coe", 0);
  set("exits/westup", __DIR__ "jingji8");
}

int do_clean(string arg) {
  int i;
  object obj, ob = this_object(), me = this_player();
  string msg;
  if (!arg || arg != "jingji")
    return notify_fail("你要干什么？\n");

  if (query("clean"))
    return notify_fail("周围已经没有荆棘了。\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你太累了，歇歇吧！\n");

  if (!(obj = me->query_temp("weapon")))
    return notify_fail("你想用手去扯那荆棘，却扎了满手鲜血！\n");

  message_vision("$N挥舞手中$n，小心的去拨开那堆堆荆棘。\n", me, obj);
  me->receive_damage("kee", 90);
  i = (int)me->query_str() * 2 / 3;
  ob->add("coe", i);
  if (i < 30)
    tell_room(environment(me), "结果只拨开几枝小刺。\n");
  else if (i < 50)
    tell_room(environment(me), "结果拨倒一片荆棘。\n");
  else if (i < 100)
    tell_room(environment(me), "只见荆棘被推的不住后退。\n");
  else tell_room(environment(me), "只见荆棘如潮水般退后。\n");
  if ((int)ob->query("coe") >= 1800) {
    tell_room(environment(me), "\n" HIC "荆棘被推到两旁，闪出一条道路。" NOR "\n\n");
    done();
    return 1;
  }
  if (me->query("family/family_name") == "陷空山无底洞"
    && obj->query("skill_type") == "blade"
    && ((me->query_temp("wdd_diyu_5") && me->is_knowing("wdd_diyu") == 4) || wizardp(me))) {
    tell_object(me, HBBLU + HIR "刀影飞舞，你口中说道：" HIY "「" HIR "形方如肉柜  浑浑而行  所过处草木尽枯" HIY "」" NOR "\n");
    me->add_temp("pending/wdd_diyu", 1);
    if (me->query_temp("pending/wdd_diyu") >= 10) {
      if (random((me->query_kar() + me->query_int() + me->query_cor()) / 20) >= 8) {
        tell_object(
          me,
          HIY "恭喜！你在训练中领悟到了" HIR "「无边地狱」" HIY "中" HIR "「形方如肉柜  浑浑而行  所过处草木尽枯」" HIY "一式的奥妙。\n" NOR
        );
        me->set_knowing("wdd_diyu", 1);
        return 1;
      } else {
        me->delete_temp("pending/wdd_diyu");
        msg = HIR "你对" HIC "「无边地狱」" HIR "的领悟加深了，然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n" NOR;
        tell_object(me, msg);
      }
    }
    i = me->query_temp("pending/wdd_diyu");
    msg = tribar_graph(i, 10, NOR, HIR, HIW);
    write(HIY " 「无边地狱」熟练度：" NOR "\n\t" + msg + NOR "\n");
  }
  return 1;
}
