//Cracked by Roath
//huludi.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "西瓜地");
  set("long", @LONG

五庄观做事的多，吃饭的也不少，所以观内雇了附近的一些农家
来种蔬菜瓜果。这里是西瓜地。往北是有一道荆棘结成的篱笆，
篱笆上开了一道简陋的杏木门，门上挂着一把黄铜锁。
LONG);

  set("exits",
    ([  //sizeof() == 4
    "southeast": __DIR__ "baicaidi",
      "southwest": __DIR__ "huludi",
      "north": __DIR__ "renshenguo-yuan",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/d/obj/food/watermelon": 3,
    ]));

  create_door("north", "杏木门", "south", DOOR_CLOSED);
  set("outdoors", "wuzhuang");

  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me, key, nroom;

  me = this_player();

  if (!arg || (arg != "door" && arg != "杏木门"))
    return notify_fail("你要打开什么？\n");
  if (!objectp(key = present("huangtong key", me))
    || base_name(key) != "/d/qujing/wuzhuang/obj/huangtong-key")
    return err_msg("你没有开这道门的钥匙。\n");

  message_vision("$N把黄铜钥匙插在锁孔里拧了半天，终于把锁打开了,杏木门开了。\n", me);
  destruct(key);
  call_out("close_door", 600);
  return 0;
}

void close_door() {
  create_door("north", "杏木门", "south", DOOR_CLOSED);
}
