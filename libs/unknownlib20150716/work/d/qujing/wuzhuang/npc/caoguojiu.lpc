// caoguojiu.c...weiqi, 98.02.24.
#include <ansi.h>
inherit SUPER_NPC;

void create()
{
	object ob;
	set_name("曹国舅", ({"cao guojiu", "cao", "guojiu"}));
	set_level(89);
	set("gender", "男性" );
	create_family("五庄观", 3, "弟子");
	set("title","云阳子");
	set("age", 40);
	set("long", "一位神情严肃的中年人。曹国舅名景休，天资纯善，\n不喜富贵，酷慕清虚。其弟骄纵不法，后罔逃国宪。\n曹国舅深以为耻，遂隐迹山林，精思元理。后投入镇元门下。\n");
	set("class", "xian");
	set("attitude", "peaceful");

	set_skill("unarmed",890);
	set_skill("wuxing-quan",890);
	set_skill("dodge",890);
	set_skill("baguazhen",890);
	set_skill("parry",890);
	set_skill("hammer", 590);
	set_skill("kaishan-chui", 500);
	set_skill("force",890);   
	set_skill("zhenyuan-force",890);
	set_skill("literate",890);
	set_skill("spells",890);
	set_skill("taiyi",890);
	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("hammer", "kaishan-chui");
	map_skill("dodge", "baguazhen");
	map_skill("parry", "kaishan-chui");
	
	set("force_factor", 40);
	set("mana_factor", 40);
	set("env/test","HIR");
	setup();
	carry_object(0,"cloth",random(3))->wear();
	ob = carry_object(0,"hammer",1);
	ob->set_name("玉笏",({"yu hu","hu","hammer"}));
	ob->set("weapon_title","曹国舅");
	ob->wield();
	powerup(0,1);
}