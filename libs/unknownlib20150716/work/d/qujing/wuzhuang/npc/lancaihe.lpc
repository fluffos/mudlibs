// lancaihe.c...weiqi, 98.02.24.
#include <ansi.h>
inherit SUPER_NPC;

void create() {
  object ob;
  set_name("蓝采和", ({ "lan caihe", "lan", "caihe" }));
  set_level(81);
  create_family("五庄观", 3, "弟子");
  set("title", "");
  set("gender", "男性");
  set("age", 18);
  set("per", 20);
  set("long", "一位面腆和善的少年。\n");
  set("class", "xian");

  set("attitude", "peaceful");
  set_skill("unarmed", 600);
  set_skill("wuxing-quan", 600);
  set_skill("dodge", 580);
  set_skill("baguazhen", 580);
  set_skill("parry", 580);
  set_skill("blade", 590);
  set_skill("yange-blade", 600);
  set_skill("force", 570);
  set_skill("zhenyuan-force", 570);
  set_skill("literate", 580);
  set_skill("spells", 580);
  set_skill("taiyi", 580);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("blade", "yange-blade");
  map_skill("dodge", "baguazhen");

  set("force_factor", 40);
  set("mana_factor", 40);
  set("env/test", "HIR");
  setup();
  carry_object(0, "cloth", random(3))->wear();
  ob = carry_object(0, "blade", random(3));
  ob->set_name("云板", ({ "yun ban", "sword" }));
  ob->set("weapon_title", "蓝采和");
  ob->wield();
  powerup(0, 1);
}
