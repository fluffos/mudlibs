// hanxiangzi.c...weiqi, 98.02.24.
#include <ansi.h>
inherit SUPER_NPC;

void create()
{
	object ob;
	set_name("韩湘子", ({"han xiangzi", "han", "xiangzi"}));
      	set_level(85);
	set("gender", "男性" );
	create_family("五庄观", 3, "弟子");
	set("title", "苍梧子");
	set("age", 22);
	set("long", "好一位俊雅潇洒的相公。韩湘子本是名门之后，却不喜念书入仕。\n被其族中长者以轻狂不学斥出家门。\n");
	set("class", "xian");

	set("attitude", "peaceful");
	set_skill("unarmed", 600);
	set_skill("wuxing-quan", 600);
	set_skill("dodge", 580);
	set_skill("baguazhen", 580);
	set_skill("parry", 580);
	set_skill("sword", 590);
	set_skill("xiaofeng-sword", 600);
	set_skill("force", 570);   
	set_skill("zhenyuan-force", 570);
	set_skill("literate", 600);
	set_skill("spells", 580);
	set_skill("taiyi", 580);
	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("sword", "xiaofeng-sword");
	map_skill("parry", "xiaofeng-sword");
	map_skill("dodge", "baguazhen");

	set("force_factor", 40);
	set("mana_factor", 40);
	set("env/test","HIR");
	setup();
	carry_object(0,"cloth",random(3))->wear();
	ob = carry_object(0,"sword",random(3));
	ob->set_name("长笛",({"chang di","di","sword"}));
	ob->set("weapon_title","韩湘子");
	ob->wield();
	powerup(0,1);
}