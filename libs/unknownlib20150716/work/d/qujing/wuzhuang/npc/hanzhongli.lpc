// hanzhongli.c...weiqi, 98.02.24.
#include <ansi.h>
inherit SUPER_NPC;

void create()
{
	object ob;
	set_name("汉钟离", ({"han zhongli", "han", "zhongli"}));
      	set_level(87);
	create_family("五庄观", 3, "弟子");
	set("title", "正阳子");

	set("gender", "男性" );
	set("age", 50);
	set("per", 20);
	set("long", "一位大腹便便的胖老头。大概总是觉得太热，时不时地要扇几扇。\n据说他以前喜欢带兵打仗，却又实在不是当将军的料，每每大败而回。\n心灰意冷之下便出门学道访仙，后拜在了镇元门下。\n");
	set("class", "xian");

	set("attitude", "peaceful");

	set_skill("unarmed",870);
	set_skill("wuxing-quan",870);
	set_skill("dodge",870);
	set_skill("baguazhen",870);
	set_skill("parry",870);
	set_skill("blade",870);
	set_skill("yange-blade",870);
	set_skill("force",870);   
	set_skill("zhenyuan-force",870);
	set_skill("literate",870);
	set_skill("spells",870);
	set_skill("taiyi",870);
	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("blade", "yange-blade");
	map_skill("dodge", "baguazhen");
	map_skill("parry", "yange-blade");
	set_skill("jiefeng",870);
	set_skill("zhaoyun",870);
	set_skill("buzhen",870);
	
	set("force_factor", 240);
	set("mana_factor", 140);
	set("env/test","HIR");
	set("looking", HIC"大腹便便，喜笑颜开"NOR"。");
	setup();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"shoes",1)->wear();
	ob = carry_object(0,"blade",1);
	ob->set_name("蒲扇",({"pu shan","shan","blade"}));
	ob->set("weapon_title","汉钟离");
	ob->wield();
	powerup(0,1);
}

void init(){}

void attempt_apprentice(object ob)
{
	if( ob->query_level()>=90 )
	{
		EMOTE_D->do_emote(this_object(), "fear",geteuid(ob),CYN,0,0,0);
		return;	
	}
	EMOTE_D->do_emote(this_object(), "ok",geteuid(ob),CYN,0,0,0);
	tell_object(ob,CYN+name()+CYN"说道：好，希望" + RANK_D->query_respect(ob) +"多加努力，把我们道家发扬光大。\n"NOR);
        command("recruit " + geteuid(ob) );
        if( ob->query("family/family_name")!="五庄观" )
        	CHANNEL_D->do_channel(this_object(),"chat","万寿山五庄观又多了一个弟子  "+ob->name(1)+HIW"\n                                 五庄观的势力加强了。\n"NOR);
        return;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "xian");
}

int prevent_learn(object me, string skill)
{
	if( skill=="buzhen" && me->query_level()<60 )
	{
  		tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  		return 1;
  	}
  	if( skill=="zhaoyun" )
  	{
  		if( me->query_level()<80 )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  			return 1;
  		}
  		if( !me->is_knowing("wzg_bxgh") 
  		 && ( me->query_skill("jianshu",2)>0
  		   || me->query_skill("jizhang",2)>0
  		   || me->query_skill("banyun",2)>0 ) )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你与吾等同游东海后再教予你知。\n");
  			return 1;
  		}
  	}
	return 0;		
}