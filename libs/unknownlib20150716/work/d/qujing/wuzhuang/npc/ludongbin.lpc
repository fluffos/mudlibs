#include <ansi.h>
inherit SUPER_NPC;

string give_book();

void create()
{
	object ob;
	set_name("吕洞宾", ({"lu dongbin", "lu", "dongbin"}));
	set_level(89);
	set("gender", "男性" );
	set("age", 35);
	set("per", 130);
	create_family("五庄观", 3, "弟子");
	set("title", "纯阳子");
	set("long", "吕洞宾大概是镇元门下最出名的弟子了，文采风流，色胆包天。\n");
	set("class", "xian");

	set("attitude", "peaceful");
	
	set_skill("unarmed",890);
	set_skill("wuxing-quan",890);
	set_skill("dodge",890);
	set_skill("baguazhen",890);
	set_skill("parry",890);
	set_skill("sword",890);
	set_skill("xiaofeng-sword",890);
	set_skill("force",890);   
	set_skill("zhenyuan-force",890);
	set_skill("literate",890);
	set_skill("spells",890);
	set_skill("taiyi",890);
	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("sword", "xiaofeng-sword");
	map_skill("parry", "xiaofeng-sword");
	map_skill("dodge", "baguazhen");
	set_skill("jiefeng",870);
	set_skill("jianshu",870);
	set_skill("buzhen",870);
	
	set("force_factor", 240);
	set("mana_factor", 240);

	set("inquiry", ([
		"name" : "五庄观纯阳子是也。\n",
		"here" : "身在何处？心老普陀。\n",
		"心得" : (: give_book :),		 
		"纯阳心得" : (: give_book :),
	]) );
	set("looking", HIC"风流倜傥，风度翩翩"NOR"。");
	set("env/test","HIR");
	setup();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"shoes",1)->wear();
	ob = carry_object(0,"sword",1);
	ob->set_name("纯阳剑",({"chunyang jian","jian","sword"}));
	ob->set("weapon_title","吕洞宾");
	ob->wield();
	powerup(0,1);
}

string give_book()
{
	object me = this_player();

	if( time()<query("no_book")+1800 )
	{
		carry_object("/d/obj/book/chunyang");
		command("give xinde to " + me->query("id"));
		set("no_book",time());
		return "好！既然是有心人，那我就给你吧。\n";
	}
	else
	{
		return "太不巧了，我已经送人了。\n";
	}
}

void init(){}

void attempt_apprentice(object ob)
{
	if( ob->query_level()>=90 )
	{
		EMOTE_D->do_emote(this_object(), "fear",geteuid(ob),CYN,0,0,0);
		return;	
	}
	EMOTE_D->do_emote(this_object(), "ok",geteuid(ob),CYN,0,0,0);
	tell_object(ob,CYN+name()+CYN"说道：好，希望" + RANK_D->query_respect(ob) +"多加努力，把我们道家发扬光大。\n"NOR);
        command("recruit " + geteuid(ob) );
        if( ob->query("family/family_name")!="五庄观" )
        	CHANNEL_D->do_channel(this_object(),"chat","万寿山五庄观又多了一个弟子  "+ob->name(1)+HIW"\n                                 五庄观的势力加强了。\n"NOR);
        return;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "xian");
}

int prevent_learn(object me, string skill)
{
	if( skill=="buzhen" && me->query_level()<60 )
	{
  		tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  		return 1;
  	}
  	if( skill=="jianshu" )
  	{
  		if( me->query_level()<80 )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  			return 1;
  		}
  		if( !me->is_knowing("wzg_bxgh") 
  		 && ( me->query_skill("zhaoyun",2)>0
  		   || me->query_skill("jizhang",2)>0
  		   || me->query_skill("banyun",2)>0 ) )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你与吾等同游东海后再教予你知。\n");
  			return 1;
  		}
  	}
	return 0;		
}