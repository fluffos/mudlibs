// zhangguolao.c...weiqi, 98.02.24.
#include <ansi.h>
inherit SUPER_NPC;

void qi_maolu()
{
	object lu;
	if( !environment() || !living(this_object()) || this_object()->is_busy() )
		return;
	lu = query_temp("ridee");
	if( !lu || !present(lu,environment()) )
		lu = present("xiao maolu",environment());
	if( !lu || userp(lu) )	
	{	 	
       		lu = new(__DIR__"xiaomaolu.lpc");
       		lu->move( environment() );
		message_vision(HIC"$N"HIC"从怀中掏出一张纸驴，吹了一口气，顿时化作一头灵气十足的小毛驴。\n"NOR,this_object());
	}
	this_object()->command("mount "+lu->parse_command_id_list()[0]);
}

string ask_mieyao()
{
    	object who=this_player();
        if( who->query_level()<20 )
                return "师门任务 20 级才开放。";
    	if((string)who->query("family/family_name")=="五庄观") 
    	{
      		EMOTE_D->do_emote(this_object(), ({"addoil","touch","ok"})[random(3)],geteuid(who),CYN,0,0,0);
      		return "/quest/family/mieyao"->query_yao(who);
    	}
    	return ("非我门人,何故来此?\n");
}

string ask_cancel()
{
	if( this_player()->query("family/family_name")!="五庄观" )
		return 0;
	return "/quest/family/mieyao"->cancel_me(this_player());	
}

void create()
{
	object ob;
	set_name("张果老", ({"zhang guolao", "zhang", "guolao"}));
      	set_level(89);
	create_family("五庄观", 3, "弟子");      	
	set("title", "广宗道人");
	set("gender", "男性" );
	set("age", 50);
	set("per", 20);
	set("long", "一位笑嘻嘻的滑稽老头。\n");
	set("class", "xian");

	set("attitude", "peaceful");

	set_skill("unarmed",890);
	set_skill("wuxing-quan",890);
	set_skill("dodge",890);
	set_skill("baguazhen",890);
	set_skill("parry",890);
	set_skill("hammer",890);
	set_skill("kaishan-chui",890);
	set_skill("force",890);   
	set_skill("zhenyuan-force",890);
	set_skill("literate",890);
	set_skill("spells",890);
	set_skill("taiyi",890);
	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("hammer", "kaishan-chui");
	map_skill("dodge", "baguazhen");
	map_skill("parry", "kaishan-chui");
	set_skill("jiefeng",890);
	set_skill("banyun",890);
	set_skill("buzhen",890);
	
	set("force_factor", 140);
	set("mana_factor", 240);

	set("chat_chance",100);
	set("chat_msg",({
		(: qi_maolu :),
	}));
	set("inquiry", ([
	   	"kill": (: ask_mieyao :),
	   	"师门任务": (: ask_mieyao :),
	    	"cancel": (: ask_cancel :),
	])); 	
	set("env/test","HIR");
	set("looking", HIC"鹤发童颜，卓越不凡"NOR"。");
	setup();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"shoes",1)->wear();
	ob = carry_object(0,"hammer",1);
	ob->set_name("酒葫芦",({"jiu hulu","hulu","hammer"}));
	ob->set("weapon_title","张果老");
	ob->wield();
	powerup(0,1);
}

void init(){}

void attempt_apprentice(object ob)
{
	if( ob->query_level()>=90 )
	{
		EMOTE_D->do_emote(this_object(), "fear",geteuid(ob),CYN,0,0,0);
		return;	
	}
	EMOTE_D->do_emote(this_object(), "ok",geteuid(ob),CYN,0,0,0);
	tell_object(ob,CYN+name()+CYN"说道：好，希望" + RANK_D->query_respect(ob) +"多加努力，把我们道家发扬光大。\n"NOR);
        command("recruit " + geteuid(ob) );
        if( ob->query("family/family_name")!="五庄观" )
        	CHANNEL_D->do_channel(this_object(),"chat","万寿山五庄观又多了一个弟子  "+ob->name(1)+HIW"\n                                 五庄观的势力加强了。\n"NOR);
        return;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "xian");
}

int prevent_learn(object me, string skill)
{
	if( skill=="buzhen" && me->query_level()<60 )
	{
  		tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  		return 1;
  	}
  	if( skill=="banyun" )
  	{
  		if( me->query_level()<80 )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你修为精深了，我再教予你知。\n");
  			return 1;
  		}
  		if( !me->is_knowing("wzg_bxgh") 
  		 && ( me->query_skill("zhaoyun",2)>0
  		   || me->query_skill("jianshu",2)>0
  		   || me->query_skill("jizhang",2)>0 ) )
  		{
  			tell_object(me,CYN+name()+CYN"说道：待你与吾等同游东海后再教予你知。\n");
  			return 1;
  		}
  	}
	return 0;		
}

void kill_ob(object who)
{
	remove_killer(who);
	who->remove_killer(this_object());
	if( userp(who) )
		tell_object(who,HIC"张果老朝你一指：定！\n结果你顿时动弹不得！\n"NOR);
	if( !who->is_busy() )	
		who->start_busy(1);
}