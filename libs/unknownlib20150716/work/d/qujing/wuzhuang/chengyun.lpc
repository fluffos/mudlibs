#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "乘云阁");
  set("long", @LONG

乘云阁居观中的最高处，阁上画栋雕梁，丹楹刻柱，显是下了很
大的功夫、周围朱栏曲槛，凭栏四望，远处景致俱在眼前。山下
村房楼舍，山上奇石怪松历历在目。
LONG);

  set("exits",
    ([  //sizeof() == 4
    "down": __DIR__ "yanzhen",
    ]));

  set("objects",
    ([  //sizeof() == 1
    //__DIR__"npc/qingfeng" : 1,
    __DIR__ "npc/zhenyuan": 1,
    ]));


  set("outdoors", "wuzhuang");

  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv;
  int i;
  if (!query("jiangjing"))
    return 0;
  tell_room(this_object(), "\n" HIC "镇元大仙说道：道者，玄之又玄，唯有大毅力者方可得，诸生听我道来。\n" NOR);
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "五庄观")
      continue;
    tell_object(inv[i], "你在旁边听着，不禁深以为然，直点脑袋。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
