//Cracked by Roath
//renshenguo-yuan.c
inherit ROOM;
#include <room.h>

void create() {
  set("short", "人参果园");
  set("long", @LONG

好大的一遍人参果园！巨大的果树上吊着一枚枚令人垂涎欲滴的
人参果。只是不知道怎样才能弄将下来。据说这人参果娇贵无比，
要是乱摘一气什么都吃不上。
LONG);

  set("exits", ([
    "south": __DIR__ "xiguadi",
  ]));

  set("outdoors", "wuzhuang");
  create_door("south", "杏木门", "north", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me, key, nroom;

  me = this_player();

  if (!arg || (arg != "door" && arg != "杏木门"))
    return notify_fail("你要打开什么？\n");
  if (!objectp(key = present("huangtong key", me))
    || base_name(key) != "/d/qujing/wuzhuang/obj/huangtong-key")
    return err_msg("你没有开这道门的钥匙。\n");

  message_vision("$N把黄铜钥匙插在锁孔里拧了半天，终于把锁打开了,杏木门开了。\n", me);
  destruct(key);
  call_out("close_door", 600);
  return 0;
}

void close_door() {
  create_door("south", "杏木门", "north", DOOR_CLOSED);
}
