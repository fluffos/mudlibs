// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
// Room: /d/qujing/wudidong/inner-tang.c
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大殿");
  set("long", @LONG

大殿里无数小妖来回奔走，正在准备大开筵席。一个女子正中高坐，
云髻低垂，金钗半溜，正笑吟吟地指挥着众小妖，全不顾自己香汗淋
漓。你往人群中一混，一时倒也无人发觉。这个地方也是传授人肉
包子做法的地方。你只要来(hear)，就可以了。
LONG);

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/yushu": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "tang-gate",
  ]));

  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv, room = this_object();
  int i;
  if (!query("jiangjing"))
    return 0;
  if (random(2))
    tell_room(room, HIC "\n地涌夫人说道：这人肉包子的味道可实在是好啊。首先要心狠手辣，不能拖泥带水。\n" NOR);
  else tell_room(room, HIC "\n地涌夫人说道：人肉包子吃的就是新鲜，不能放置，砍下肉后，要立即做成包子。要点是：人的心脏附近的肉最为鲜美。\n" NOR);
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "陷空山无底洞")
      continue;
    tell_object(inv[i], "你在旁边听着，听着。不禁想起了人肉包子的美味。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
