#include <room.h>
inherit ROOM;

void create()
{
	set("short", "兵器库");
	set("long", @LONG
这里是傲来国的兵器库，里面各种兵器(bingqi)：刀、枪、
剑、戟、斧、钺、毛、镰、鞭、钯、挝、锏、弓、弩、叉、
矛，件件俱备。整整齐齐的堆放着，几个威武的武士在这
里保守着。
LONG );
	set("item_desc",([
		"bingqi" : "各种各样的兵器。\n",
	]));
	set("exits", ([
  		"north"   : __DIR__"fight_room",
	]));
	set("objects", ([
  		__DIR__"npc/pianjiang" : 4,
	]));
	set("no_magic", 1);
	setup();
}