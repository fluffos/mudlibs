//sgzl
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "傲来国演武场");
	set("long", @LONG
傲来国演武场，文官武将，各穿锦衣；帐下偏裨将校，都披银铠。
分两行。左右军士，皆全装惯带，持戈执戟而立。中间一行行兵
士威风凛凛的穿行于其中。
LONG );
	set("exits", ([
  		"north"   : __DIR__"aolaifighting",
  		"south"   : __DIR__"bingqiku",
	]));

	set("objects", ([
   		__DIR__"npc/wushi"   : 4,
	]));
	set("out_doors", "aolai");
	setup();
}

int valid_leave(object who,string dir)
{
	if( !userp(who) || dir!="south" )
		return ::valid_leave(who,dir);
	if( who->query("dntg/donghai")=="done"
	 || who->query("dntg/huaguo")!="done" 
	 || who->query("dntg/donghai")!="aolai" )
	 	return ::valid_leave(who,dir);
	if( time()<who->query("maze/dntg-aolai-bingqi")+1800 )
	{
		tell_object(who,HIC"你刚刚在兵器库中扫荡过，现在再来，有些做贼心虚，只得装作普通游客四处闲逛一番。\n"NOR);
		return ::valid_leave(who,dir);
	}
	who->dismiss_team();
	who->delete_temp("maze");
	if( MAZE_D->enter_maze(who, "dntg-aolai-bingqi") )
	{
		message_vision(HIC"\n$N"HIC"偷偷溜进了傲来国的兵器库，准备做一番大事业。。。。\n"NOR,who);
                return 2;
	}
	tell_object(who,HIC"你刚刚在兵器库中扫荡过，现在再来，有些做贼心虚，只得装作普通游客四处闲逛一番。\n"NOR);
	return ::valid_leave(who,dir);
}