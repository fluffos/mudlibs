inherit SUPER_NPC;
#include <ansi.h>
#include "sister.h"

nosave int last_say = 0;

mixed ran_msg()
{
	string *msg;
	if( !environment()
	 || this_object()->is_fighting()
	 || !living(this_object()) )
	 	return 0;
	if( time()<=last_say+10+random(60) )
		return 0; 	
	msg = ({
		"十八岁那年他说过会来娶我，我等了他三年....原来一切都是骗我的！\n",
        	"我遇上一个人，送给我一坛酒，他说那叫醉生梦死，喝了之后，可以叫你忘掉以做过的任何事。\n",
        	"那天我跟他在月亮下喝酒，他对我说，如果我有个妹妹，他一定娶她为妻。他明知我是女子，为什么要这样说！\n",
		"不知道是巧合还是其他原因，以前每次他来盘丝洞的时候，天都会下雨！\n",
		"他本来就不属于这个世界，他是一个逃下天界的神仙。听说逃下天界的神仙命运往往是不幸的，尤其是动了凡心的那种。神仙是不该有感情的，这可能也是命运！\n",
	});
	message_vision(CYN"$N"CYN"说道："+msg[random(sizeof(msg))]+NOR,this_object());
	last_say = time();
	return 1;
}

void create()
{
	set_name("白晶晶", ({"bai jingjing", "bai", "jingjing","master"}));
	set("long","盘丝大仙座下的二弟子，与其师姐春三十娘势成水火。\n");
	set_level(89);
	create_family("盘丝洞", 2, "弟子");
	set("title", HIW"白骨洞主"NOR);
	set("looking",HIC"如风拂玉树，雪裹琼苞，兼之生性清冷，实当得起"NOR WHT"“冷浸溶溶月”"NOR HIC"的形容"NOR"。");
	set("rank_info/pos_msg",NOR+HIC+BLK"周身泛起一层白色光华"NOR"。\n");
	set("gender", "女性");
	set("age", 22);
	set("class", "yaomo");
	set("attitude", "friendly");
	set("force_factor",290);
	set("mana_factor",290);
 	set("eff_dx", 200000);
 	set("nkgain", 350);

	set_skill("literate",890);
	set_skill("unarmed",890);
	set_skill("dodge",890);
	set_skill("force",890);
	set_skill("parry",890);
	set_skill("spells",890);
	set_skill("pansi-dafa",890);
	set_skill("lanhua-shou",890);
	set_skill("jiuyin-xinjing",890);
	set_skill("chixin-jian",890);
	set_skill("yueying-wubu",890);
	set_skill("whip",890);
	set_skill("yinsuo-jinling",890);
	map_skill("spells", "pansi-dafa");
	map_skill("unarmed", "lanhua-shou");
	map_skill("force", "jiuyin-xinjing");
	map_skill("sword", "chixin-jian");
	map_skill("parry", "chixin-jian");
	map_skill("whip", "yinsuo-jinling");
	map_skill("dodge", "yueying-wubu");
	set_skill("jiefeng",890);
	set_skill("zhushi",890);
	set("chat_chance",50);
	set("chat_msg", ({
        	(: ran_msg :),
        }));
	set("inquiry", ([
		"一笑泯恩仇" : (: about_chou :),
	]));	
	set("env/test","HIR");
        setup();
        carry_object(0,"cloth",1)->wear();
        carry_object(0,"shoes",1)->wear();
        carry_object(0,"neck",1)->wear();
        carry_object(0,"ring",1)->wear();
        carry_object(0,"kui",1)->wear();
        carry_object(0,"pifeng",1)->wear();
        carry_object(0,"sword",1)->wield();
        powerup(0,1);
}

void attempt_apprentice(object ob)
{
	if( ob->is_knowing("pansi_apprentice") 
	 && (string)ob->is_knowing("pansi_apprentice")=="niang" 
	 && !ob->query("family/pansi_JMTX") )
	{
		EMOTE_D->do_emote(this_object(), "pei",0,CYN,0,0,0);
        	tell_object(ob,CYN+name()+CYN"说道：是不是春三十娘那个贱人差你来探老娘口风的？！"NOR"\n");
        	return;
        }
        if( ob->query("class") && ob->query("class")!="yaomo" )
        {
       		EMOTE_D->do_emote(this_object(), "?",geteuid(ob),CYN,0,0,0);
		return ;
        }
        if( ob->query_level()<40 )
	{
		tell_object(ob,CYN+name()+CYN"说道："+RANK_D->query_respect(ob) +"的道行不够高深，有些绝学秘法恐怕难以领悟。"NOR"\n");
   		return;
   	}
   	if( ob->query_level()>=100 )
   	{
		tell_object(ob,CYN+name()+CYN"说道："+RANK_D->query_respect(ob) +"还是去找我的师傅吧。"NOR"\n");
   		return;
   	}
        EMOTE_D->do_emote(this_object(), "smile",geteuid(ob),CYN,0,0,0);
        tell_object(ob,CYN+name()+CYN"说道：好！" + RANK_D->query_respect(ob) + "投入我的门下，他日必有所成！\n"NOR);
	command("recruit " + ob->query("id") );
	return ;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
	{
	 	ob->set("class","yaomo");
	 	if( !ob->is_knowing("pansi_apprentice") ) 
	 		ob->set_knowing("pansi_apprentice","bai");
	}
}

void init()
{
	return;
}

int prevent_learn(object me, string skill)
{
	if( me->is_knowing("pansi_apprentice") 
	 && (string)me->is_knowing("pansi_apprentice")=="niang" 
	 && !me->query("family/pansi_JMTX") )
	{
		EMOTE_D->do_emote(this_object(), "pei",geteuid(me),CYN,0,0,0);
        	tell_object(me,CYN+name()+CYN"说道：你还是去找春三十娘那个贱人吧！"NOR"\n");
        	return 1;
	}
	return 0;
}

int accept_object(object who,object obj)
{
	///d/obj/knowledge/chuyi/drink/meng
	if( who->query_temp("JMTX/target")=="白晶晶" )
	{
		if( who->query_temp("JMTX/bai") )
		{
			EMOTE_D->do_emote(this_object(), "?",geteuid(who),CYN,0,0,0);
			tell_object(who,CYN+name()+CYN"说道：你不知弄巧成拙吗？！\n"NOR);
			return 0;
		}
		else if( base_name(obj)=="/d/obj/knowledge/chuyi/drink/meng" )
		{
			EMOTE_D->do_emote(this_object(), "wow",geteuid(who),CYN,0,0,0);
			EMOTE_D->do_emote(this_object(), "think",geteuid(this_object()),CYN,0,0,0);
			message_vision(HIR"$N"HIR"惨然一笑，说道：人有悲欢离合，月有阴晴圆缺，此事古难全。\n"NOR,this_object());
			message_vision(CYN"$N"CYN"朝$n"CYN"点了点头：好，我便信你这一次，醒了这场梦。。。。\n"NOR,this_object(),who);
			who->set_temp("JMTX/bai",1);
			message_vision(HIC"$N"HIC"从$n"HIC"手中接过了"+obj->query("name")+NOR HIC"。\n"NOR,this_object(),who);
			if( !who->query_temp("JMTX/niang") )
			{
				EMOTE_D->do_emote(this_object(),"hmm",geteuid(who),CYN,0,0,0);
				tell_object(who,HIC+name()+"说道：我那姐姐，只知常年修炼，怎知我的苦恼，天路漫漫，若无梦想，做人和一条咸鱼有甚区别？\n"NOR);
				tell_object(who,HIC+name()+"说道：喏，你去长安找那喜福会老板娘酿制一坛「醉生梦死」给她，让她明我心意。\n"NOR);
				who->set_temp("JMTX/target","春三十娘");
			}
			else
			{
				who->set("family/pansi_JMTX",1);
				EMOTE_D->do_emote(this_object(), "jump",geteuid(who),CYN,0,0,0);
				tell_object(who,HIC+name()+"媚眼如丝，朝你细细打量了一番，嘻嘻笑出了声来。\n"NOR);
				EMOTE_D->do_emote(this_object(), "thank",geteuid(who),CYN,0,0,0);
				message("channel:rumor",HIC"【谈天说地】金灵圣母(Jinling shengmu)：感谢"+who->query("name")+HIC"化解盘丝「同心恩怨」。\n"NOR,users());
				message("channel:rumor",HIM"【小道消息】某人不置可否地道：“难说！”\n"NOR,users());
				message("channel:rumor",HIC"【谈天说地】金灵圣母(Jinling shengmu)：呵呵，只望这段恩怨能彻底泯去。。。\n"NOR,users());
				message("channel:rumor",HIM"【小道消息】某人：呵呵，三世恩仇，不是你说消便消的。\n"NOR,users());
				message("channel:rumor",HIC"【谈天说地】金灵圣母的脸上露出疑惑的表情。\n"NOR,users());
				message("channel:rumor",HIC"【谈天说地】金灵圣母「嗯」的一声，一副欲言又止的样子。\n"NOR,users());
				message_vision("\n"HIC"半空中显出金灵圣母的身影。\n\n"NOR CYN"金灵圣母由衷地感谢$N"CYN"。"NOR"\n",who);
				who->add("faith",20000);
				who->delete_temp("JMTX");
				tell_object(who,HIG"【门派】你得到了"HIR+20000+HIG"点门派贡献。\n"NOR);
			}
			return 2;
		}
		else	return 0;
	}
	else	return 0;
}	