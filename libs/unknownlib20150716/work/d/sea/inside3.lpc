//modified by bear
inherit ROOM;
#include <ansi.h>

void create ()
{
	set ("short", "龙宫正殿");
	set ("long", @LONG

正殿之上悬一明珠，把诺大一殿照得通亮。两旁桌椅玉石打造而成，　　
当中还嵌着无数珠宝。两边墙上挂了两幅画，看起来相当的陈旧。　　　
南北是两座偏殿。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "westdown" : __DIR__"inside2.lpc",
  "east" : __DIR__"inside4",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/longwang" : 1,
]));
        set("water", 1);
	setup();
}

void paodian_end()
{
	remove_call_out("paodian");
}

void paodian()
{
	object *inv,room=this_object();
	int i;
 	if( !query("jiangjing") )
 		return 0;
	switch(random(3))
	{
		case 0 : tell_room(room,CYN"敖广说道：四海龙王乃玉帝遣于凡间，专管降雨。\n"NOR);break;
		case 1 : tell_room(room,CYN"敖广说道：四海龙王之下又有众多河龙王，井龙王，及各种水族。\n"NOR);break;
		case 2 : tell_room(room,CYN"敖广说道：我传的武功法术在水中占了极大的优势。\n"NOR);break;
		default: tell_room(room,CYN"敖广说道：龙宫的宝物对本门弟子的成长也是大有好处。\n"NOR);break;
	}
	inv = all_inventory();
	for(i=0;i<sizeof(inv);i++)
	{
		if( !userp(inv[i]) || !living(inv[i]) 
		 || inv[i]->query("family/family_name")!="东海龙宫" )
      			continue;
		tell_object(inv[i],"你在旁边听着，听着，不禁对本门的避水之术有所领悟。\n");
		inv[i]->add("combat_exp",5000);
		inv[i]->add("daoxing",800);
		inv[i]->add("potential",500);
		tell_object(inv[i],HIG"【门派泡点】你得到了"HIR"5000点"HIG"武学经验、"HIR+COMBAT_D->chinese_daoxing(800)+HIG"道行以及"HIR"500点"HIG"潜能修为。"NOR"\n");
	}
	remove_call_out("paodian");
	call_out("paodian",5);
}

int valid_leave()
{
    if(
       (present("dao kan dao", this_player()))
       || (present("jiu gu cha", this_player()))
       || (present("mei hua chui", this_player()))
       || (present("hua gan ji", this_player()))
      )
        return notify_fail("龙宫至宝不能随便带走！\n");
    return ::valid_leave();
}

