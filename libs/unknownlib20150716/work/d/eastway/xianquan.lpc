#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "仙泉");
  	set ("long", @LONG
一股热气腾腾的白雾将你团团围住，你已经来到了仙泉边。泉中
清水碧波荡漾，水面雾气缭绕，有许多人正在里面闭目坐浴(bath)，据说
泉中之水能治疗(cure)人的身心。
LONG);
	set("exits", ([
		"out"     : __DIR__"huaqing",
	]));
  	set("objects", ([
      		__DIR__"npc/girl" : 2,
      	]));
  	set("resource", ([
    		"spring" : 1,
      	]));
	set("outdoors", __DIR__);
	setup();
}

void init ()
{
	add_action ("do_bath","bath");
  	add_action ("do_cure","cure");
}

int do_bath (string arg)
{
	string *msgs = ({
    		"$N在泉中洗了起来。\n",
    		"$N用泉水洗了洗自己。\n",
    		"$N在泉中热气腾腾地洗了起来。\n",
    		"$N用热热的泉水洗了洗自己。\n",
  	});
  	string *actions = ({
    		"你感觉到泉水有一种说不出来的的神力。\n",
    		"你仿佛觉得泉水有一种神秘的法力慢慢渗进你的体内。\n",
    		"你似乎感觉到有一种神力渗进体内。\n",
    		"你恍惚觉得有一种神秘的法力将你笼罩。\n",
    		"似乎有一种神秘的法力渗进你的体内。\n",
  	});
  	object me = this_player();

  	if( me->query("kee")<10 || me->query("sen")<10 )
		return notify_fail(HIR"你太虚弱了，洗热水浴有危险！\n"NOR);

	if( me->is_busy() )
    		return notify_fail ("你正在热泉中忙着呢！\n");

	message_vision (msgs[random(sizeof(msgs))],me);
	me->receive_damage("kee",10);
	me->receive_damage("sen",10);
	me->improve_skill("spells",1+random(3),1);
	tell_object (me,actions[random(sizeof(actions))]);
	me->start_busy(1);
  	return 1;
}

int do_cure (string arg)
{
  	string *msgs = ({
    		"$N捧起泉水往身上慢慢地浇下来。\n",
    		"$N用热泉水往自己身上一浇。\n",
    		"$N舀起热热的泉水，往身上浇下来。\n",
    		"$N躺在热泉水中，泡着自己的身体。\n",
    		"$N坐进热气腾腾的泉水。\n",
    		"$N泡在热泉水中，慢慢地坐浴。\n",
  	});
  	object me = this_player();

  	if(me->is_busy())
    		return notify_fail ("你正在热泉中忙着呢！\n");
	if( me->query_maxkee()<me->query("max_kee") 
  	 || me->query_maxsen()<me->query("max_sen")
  	 || me->query_maxmana()<me->query("max_mana")
  	 || me->query_maxforce()<me->query("max_force") )
  		me->remove_errbuf();
  	message_vision (msgs[random(sizeof(msgs))],me);
  	me->start_busy(1);
  	me->add_temp("pending/cure_times",1);  
  			
  	if( (random(me->query_kar()/5)+me->query_temp("pending/cure_times")) > 20 )
  	{
  		if( me->query("eff_kee")<100 )
  			me->receive_curing("kee",100);
  		if( me->query("kee")<100 )	
  			me->receive_heal("kee",100);
  		if( me->query("eff_sen")<100 )
  			me->receive_curing("sen",100);
  		if( me->query("sen")<100 )	
  			me->receive_heal("sen",100);
    		if( !me->update_condition() )
      			return 1;
    		message_vision (HIG"\n$N"HIG"红光满面地站了起来，走到泉边。\n\n"NOR,me);
    		me->clear_condition();
    		me->unconcious();
    		me->receive_heal("kee",100);
    		me->receive_heal("sen",100);
  	}
  	return 1;
}