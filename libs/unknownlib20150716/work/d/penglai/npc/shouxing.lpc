inherit NPC;
void create()
{
        set_name("寿星", ({"shou xing", "xing"}));
	set("title", "蓬莱三老");
	set("gender", "男性");
	set("long", "霄汉中间一老人，手捧灵芝飞蔼绣。葫芦藏蓄万年丹，宝篆名书千纪寿。
洞里乾坤任自由，壶中日月随成就。遨游四海任清闲，散淡十洲容福胄。
曾赴蟠桃醉几遭，醒时名月还依旧。长头大耳短身躯，南极之方称老寿。\n");
        set("attitude", "peaceful");
        set("combat_exp", 800000);
	set("daoxing", 1500000);

	create_family("五庄观", 2, "弟子");
	set("age", 80);
	set("per", 100);
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);
	set("class", "xian");
	set("rank_info/respect", "老寿星");
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("force", 800);
	set("max_force", 800);
	set("force_factor", 50);
	set("max_mana", 800);
	set("mana", 800);
	set("mana_factor", 50);
	
	set_skill("spells", 120);
	set_skill("taiyi", 120);
	set_skill("force",120);
	set_skill("zhenyuan-force",120);
	set_skill("parry", 120);
	set_skill("dodge", 120);
	set_skill("baguazhen", 120);
	set_skill("unarmed", 120);
	set_skill("wuxing-quan", 120);
	set_skill("staff",110);
	set_skill("fumo-zhang",120);

	map_skill("spells", "taiyi");
	map_skill("force", "zhenyuan-force");
	map_skill("dodge", "baguazhen");
	map_skill("unarmed", "wuxing-quan");
	map_skill("staff", "fumo-zhang");
	map_skill("parry", "fumo-zhang");

        set("inquiry", ([
		"火枣"     : "我没那玩意，去问问老福星吧！\n",
		"交梨"     : "我没那玩意，去问问老禄星吧！\n",
                "name"     : "老夫寿星是也。\n",
                "here"     : "此乃蓬莱仙岛也。\n",
                "下棋"     : "你个臭棋篓子，谁要跟你下棋！\n",
                "围棋"     : "连围棋都不知道？\n",
                "碧藕"     : "没了没了，啥都没了。\n",
        ]));

