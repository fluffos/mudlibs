#include <ansi.h>
#include <armor.h>
inherit NPC;

mixed about_bag(object me);
mixed change_bag(object me);
mixed about_xilian(object me);

void main_input(string arg, object me)
{
	if( !me || !living(me) || !environment()
	 || !present(me,environment()) )
                return;
	if( !arg )
	{
		tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、领取芥子袋
		2、升级芥子袋
		3、将萤石数据化
LONG+NOR);
		tell_object(me,HIR"请选择(1-3)，按 Q 退出："NOR);
		input_to("main_input",me);
		return;
	}
	arg = sprintf("%c",arg[0]);
	switch(arg)
	{
		case "Q" :
		case "q" :
			return;
		case "1" :
			about_bag(me);
			break;
		case "2" :
			change_bag(me);
			break;
		case "3" :
			about_xilian(me);
			break;
		default :
			tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、领取芥子袋
		2、升级芥子袋
		3、将萤石数据化
LONG+NOR);
			tell_object(me,HIR"请选择(1-3)，按 Q 退出："NOR);
			input_to("main_input",me);
			break;
	}
	return;
}

mixed my_main()
{
	object me = this_player();
	if( !userp(me) )
		return 0;
	tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、领取芥子袋
		2、升级芥子袋
		3、将萤石数据化
LONG+NOR);
	tell_object(me,HIR"请选择(1-3)，按 Q 退出："NOR);
	input_to("main_input",me);
	return 1;
}

void create()
{
	set_name("往事如风",({"wangshi rufeng","wsrf","rufeng","naifeng"}));
	set_level(80);
	set("gender", "男性");
	set("age", 36);
	set("title",HIC"炼器师"NOR);
	set("long","炼器大宗派天机门的二代弟子，目前在东土行走。他的脾气有点不好。\n");
	set("env/test","HIM");
	set("inquiry",([
		"炼器" : (: my_main :),
		"武器突破"	: "你去一楼新手准备室找我小弟--小鱼儿吧。\n",
		"防具突破" 	: "你去一楼新手准备室找我小弟--小鱼儿吧。\n",
	]));		
	setup();
	carry_object(0,"armor",1)->wear();
	carry_object(0,"shoes",1)->wear();
	carry_object(0,"neck",1)->wear();
	carry_object(0,"ring",1)->wear();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"pifeng",1)->wear();
	carry_object(0,"kui",1)->wear();
	carry_object(0,"unarmed",1)->wield();
	powerup(1,1);
}

mixed about_xilian(object me)
{
	int amount;
	object obj;
	if( !me ) 
		return 0;
	if( objectp(obj=present("sui pian",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/suipian",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"片"HIY"装备碎片"HIG"。"NOR"\n");
	}
	if( objectp(obj=present("ying yu",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/yingyu",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"颗"HIY"萤玉"HIG"。"NOR"\n");
	}
	if( objectp(obj=present("ying shi",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/yingshi",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"块"HIY"萤石"HIG"。"NOR"\n");
	}
	("/cmds/usr/fenjie.lpc")->check_suipian_amount(me); 
	return 1;
}

int accept_fight(object who){return 0;}

void die()
{
	powerup(1,1);
	remove_all_killer();
	if( environment() )
		all_inventory(environment())->remove_killer(this_object());
	return;
}

void unconcious(){die();}

void kill_ob(object who)
{
	say(name()+"摇了摇头。\n");
	remove_all_killer();
	all_inventory(environment())->remove_killer(this_object());
	return;
}

int accept_suipian(object who,int v)
{
	int n;
	if( !userp(who) || v<1 )
		return 0;
	if( who->query("mark/bag") 
	 || who->query_temp("wsrf_quest/bag") )
	 {
	 	tell_object(who,CYN+name()+"说道：你需要吗？\n"NOR);
		return 0;
	}
	if( who->query_temp("wsrf_quest/bag_suipian")>=50 )
	{
		tell_object(who,CYN+name()+"说道：装备碎片你已经给完了。\n"NOR);
		return 0;
	}
	if( v>50 )
	{
		tell_object(who,CYN+name()+"说道：哥只要五十颗装备碎片。\n"NOR);
		return 0;
	}
	if( who->query_temp("wsrf_quest/bag_suipian")+v>50 )
	{
		n = 50-who->query_temp("wsrf_quest/bag_suipian");
		tell_object(who,CYN+name()+"说道：哥还要"+chinese_number(n)+"颗装备碎片，多了没用。\n"NOR);
		return 0;
	}
	who->add_temp("wsrf_quest/bag_suipian",v);
	if( who->query_temp("wsrf_quest/bag_suipian")>=50 )
	{
		if( who->query_temp("wsrf_quest/bag_xilian") )
		{
			EMOTE_D->do_emote(this_object(), "good",geteuid(who),CYN,0,0,0);
			who->delete_temp("wsrf_quest/bag_suipian");
			who->delete_temp("wsrf_quest/bag_xilian");
			who->set_temp("wsrf_quest/bag",1);
			tell_object(who,CYN+name()+"说道：不错不错，现在你可以想我询问「芥子袋」一事了。\n"NOR);
		}
		else	tell_object(who,CYN+name()+"说道：不错不错，还差一块萤石。\n"NOR);
		return 1;
	}
	tell_object(who,CYN+name()+"说道：不错不错，再给我"+chinese_number(50-who->query_temp("wsrf_quest/bag_suipian"))+"个装备碎片即可。\n"NOR);
	if( !who->query_temp("wsrf_quest/bag_xilian") )
		tell_object(who,CYN+name()+"说道：恩。。。。还有一块萤石。\n"NOR);
	return 1;	
}

int accept_yingshi(object who,int v)
{
	int n;
	if( !userp(who) || v<1 )
		return 0;
	if( who->query("mark/bag") 
	 || who->query_temp("wsrf_quest/bag") )
	 {
	 	tell_object(who,CYN+name()+"说道：你需要吗？\n"NOR);
		return 0;
	}
	if( who->query_temp("wsrf_quest/bag_xilian") )
	{
		tell_object(who,CYN+name()+"说道：萤石你已经给过了。\n"NOR);
		return 0;
	}
	if( v!=1 )
	{
		tell_object(who,CYN+name()+"说道：哥只要一块萤石。\n"NOR);
		return 0;
	}
	who->add_temp("wsrf_quest/bag_xilian",v);
	if( who->query_temp("wsrf_quest/bag_xilian") 
	 && who->query_temp("wsrf_quest/bag_suipian")>=50 ) 
	{
		EMOTE_D->do_emote(this_object(), "good",geteuid(who),CYN,0,0,0);
		who->delete_temp("wsrf_quest/bag_suipian");
		who->delete_temp("wsrf_quest/bag_xilian");
		who->set_temp("wsrf_quest/bag",1);
		tell_object(who,CYN+name()+"说道：不错不错，现在你可以想我询问「芥子袋」一事了。\n"NOR);
	}
	else	tell_object(who,CYN+name()+"说道：不错不错，再给我"+chinese_number(50-who->query_temp("wsrf_quest/bag_suipian"))+"个装备碎片即可。\n"NOR);
	return 1;
}

int accept_object(object who,object obj)
{
	string name,file,job,type;
	int v;
	if( who->query_level()<50 )
		return 0;
	if( stringp(type=obj->query("armor_type"))
	 && obj->is_armor()
	 && stringp(job=who->query_temp("wsrf_quest/armor/"+type+"_need"))
	 && sscanf(job,"%s_%s",name,file)==2 )
	{
		if( name!=obj->name() )
		{
			tell_object(who,CYN+name()+"说道：我要的是「"+name+NOR CYN"」，你却给我「"+obj->name()+NOR CYN"」。\n"NOR);
			return 0;
		}
		else if( base_name(obj)!=file )
		{
			tell_object(who,CYN+name()+"说道：看名字好似是这个，其实根本不是！\n"NOR);
			return 0;
		}
		else
		{
			EMOTE_D->do_emote(this_object(), "zeze",geteuid(who),CYN,0,0,0);
			who->set_temp("wsrf_quest/armor/"+type,1);
			who->delete_temp("wsrf_quest/armor/"+type+"_need");
			tell_object(who,CYN+name()+"说道：不错不错，我现在就可以帮你的装备进阶(shengjia "+type+")。\n"NOR);
			return 1;
		}
	}	 		
		
	if( stringp(type=obj->query("skill_type"))
	 && obj->is_weapon()
	 && stringp(job=who->query_temp("wsrf_quest/weapon/"+type+"_need"))
	 && sscanf(job,"%s_%s",name,file)==2 )
	{
		if( name!=obj->name() )
		{
			tell_object(who,CYN+name()+"说道：我要的是「"+name+NOR CYN"」，你却给我「"+obj->name()+NOR CYN"」。\n"NOR);
			return 0;
		}
		else if( base_name(obj)!=file )
		{
			tell_object(who,CYN+name()+"说道：看名字好似是这个，其实根本不是！\n"NOR);
			return 0;
		}
		else
		{
			EMOTE_D->do_emote(this_object(), "zeze",geteuid(who),CYN,0,0,0);
			who->set_temp("wsrf_quest/weapon/"+type,1);
			who->delete_temp("wsrf_quest/weapon/"+type+"_need");
			tell_object(who,CYN+name()+"说道：不错不错，我现在就可以帮你的装备进阶(shengwu "+type+")。\n"NOR);
			return 1;
		}
	}
	return 0;
}

mixed about_bag(object me)
{
	object bag;
	if( !me )
		return 0;
	if( me->query_level()<50 )
	{
		EMOTE_D->do_emote(this_object(), "qie",geteuid(me),CYN,0,0,0);
		tell_object(me,CYN+name()+"说道：凭你现在的修为，哥不放心把宝贝交给你！\n"NOR);
		return 1;
	}
	if( !("/cmds/usr/zhaohuan.lpc")->init_player_file(me) )
	{
		tell_object(me,CYN+name()+"说道：你需要重新登录。\n"NOR);
		return 1;
	}
	if( me->query("mark/bag") )
	{
		tell_object(me,CYN+name()+"说道：不是已经给你了吗？！\n"NOR);
		return 1;
	}
	
	if( !me->query_temp("wsrf_quest/bag") )
	{
		tell_object(me,CYN+name()+"说道：你需给我五十个装备碎片以及一块萤石。\n"NOR);
		return 1;
	}
	
	EMOTE_D->do_emote(this_object(), "ok",geteuid(me),CYN,0,0,0);
	me->set("mark/bag",1);
	me->save();
	message_vision("$N乐呵呵的从裤腰带里取出一个符文锦簇的布袋，朝着$n吹了口气，霞光一闪，那布袋顿时化作一道光华隐在了$n的身上。\n",this_object(),me);
	tell_object(me,CYN+name()+"说道：你且召唤(zhaohuan bag)了试试。\n"NOR);
	return 1;
}

mixed change_bag(object me)
{
	int cost,now,max;
	object bag;
	
	if( !me )
		return 0;
	if( !objectp(bag=present("chuwu dai",me)) 
	 || bag->query("owner_id")!=me->query("id") )
	{
		tell_object(me,CYN+name()+"说道：你身上可没有储物袋。\n"NOR);
		return 1;
	}
	max = bag->query("level")*5+25;
	max+= me->query("mark/bag");
	if( max>=100 )
	{
		tell_object(me,CYN+name()+"说道：你的储物袋容量已达顶点，不能再升级了。\n"NOR);
		return 1;
	}
	now = me->query("mark/bag");
	cost = 1+now*5;	
	if( me->query("inventory/yingyu")<cost )
	{
		tell_object(me,CYN+name()+"说道：你需要消耗"+cost+"个萤玉。\n"NOR);
		return 1;
	}
	if( (me->query("potential")-me->query("learned_points"))<10000 )
	{
		tell_object(me,CYN+name()+"说道：你需要消耗10000点潜能。\n"NOR);
		return 1;
	}
	if( me->is_busy() )
	{
		tell_object(me,CYN+name()+"说道：你现在忙得很。\n"NOR);
		return 1;
	}
	me->start_busy(1);
	bag->add("level",1);
	bag->save();
	me->add("inventory/yingyu",-cost);
	me->add("potential",-10000);
	me->save();
	tell_object(me,HIG"【系统】你的储物袋升级了。"NOR"\n");
	tell_object(me,HIR"【系统】你失去了"+cost+"个萤玉以及10000点潜能。"NOR"\n");
	tell_object(me,CYN+name()+"说道：好了，你看看吧。\n"NOR);
	return 1;
}
