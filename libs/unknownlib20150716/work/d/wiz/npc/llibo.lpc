#include <ansi.h>
inherit NPC;

mixed about_equip(object me);
mixed up_equip(object me);
mixed about_xilian(object me);
mixed wuqi_zuhe(object me);
mixed my_main();

void create()
{
        set_name("小鱼儿",({"xiaoyu er","xiaoyu","yu","llibo girl",}));
        set("long", "东土大唐「天机府」著名的炼器师。你可以向她打听关于「炼器」一事。\n");
        set("gender", "女性");
        set("age", 21);
        set("per", 100);
        set_level(50);
        set("title",HIC"炼器大师"NOR);
        set_skill("literate",500);
        set("inquiry", ([
        	"炼器" : (: my_main :),
        ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void main_input(string arg, object me)
{
	if( !me || !living(me) || !environment()
	 || !present(me,environment()) )
                return;
	if( !arg )
	{
		tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、消除装备性别限制
		2、升级绑定装备
		3、将萤石数据化
		4、武器组合
LONG+NOR);
		tell_object(me,HIR"请选择(1-4)，按 Q 退出："NOR);
		input_to("main_input",me);
		return;
	}
	arg = sprintf("%c",arg[0]);
	switch(arg)
	{
		case "Q" :
		case "q" :
			return;
		case "1" :
			about_equip(me);
			break;
		case "2" :
			up_equip(me);
			break;
		case "3" :
			about_xilian(me);
			break;
		case "4" :
			wuqi_zuhe(me);
			break;	
		default :
			tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、消除装备性别限制
		2、升级绑定装备
		3、将萤石数据化
		4、武器组合		
LONG+NOR);
			tell_object(me,HIR"请选择(1-4)，按 Q 退出："NOR);
			input_to("main_input",me);
			break;
	}
	return;
}

mixed my_main()
{
	object me = this_player();
	if( !userp(me) )
		return 0;
	tell_object(me,short()+"处提供以下服务：\n"+HIY+@LONG
		1、消除装备性别限制
		2、升级绑定装备
		3、将萤石数据化
		4、武器组合		
LONG+NOR);
	tell_object(me,HIR"请选择(1-4)，按 Q 退出："NOR);
	input_to("main_input",me);
	return 1;
}

//将萤石数据化
mixed about_xilian(object me)
{
	int amount;
	object obj;
	if( objectp(obj=present("sui pian",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/suipian",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"片"HIY"装备碎片"HIG"。"NOR"\n");
	}
	if( objectp(obj=present("ying yu",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/yingyu",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"颗"HIY"萤玉"HIG"。"NOR"\n");
	}
	if( objectp(obj=present("ying shi",me)) 
	 && obj->is_xilian() 
	 && intp(amount=obj->query_amount())
	 && amount>0
	 && (!obj->query("owner_id")||obj->query("owner_id")==me->query("id")) )
	{
		me->add("inventory/yingshi",amount);
		destruct(obj);
		tell_object(me,HBBLU"你转化了"HIY+chinese_number(amount)+HIG"块"HIY"萤石"HIG"。"NOR"\n");
	}
	("/cmds/usr/fenjie.lpc")->check_suipian_amount(me); 
	return 1;
}

int accept_money(object who,int v)
{
        if( v<50000 )
                return 0;
        EMOTE_D->do_emote(this_object(), "ok",geteuid(who),CYN,0,0,0);
        tell_object(who,CYN+name()+CYN"说道：你可以向我打听「炼器」一事，我可以将你装备上的性别限制炼去。\n"NOR);
        who->set_temp("pending/llibo_give",1);
        return 1;
}       

//消除装备性别限制
void get_input(string arg, object me)
{
        object shi,ob;
        if( !me || !living(me) || !present(me,environment()) )
                return;
        if( !arg )
        {
                tell_object(me,HIY"你要消除哪件装备的性别限制(输入ID)，按 Q 退出："NOR);
                input_to("get_input",me);
                return;
        }
        if( arg[0]=='q' || arg[0]=='Q' )
        	return;
        ob = present(arg,me);
        if( !ob || (!ob->is_armor()&&!ob->is_weapon()) )
        {
                tell_object(me,CYN+name()+CYN"说道：你身上可没有叫 "+arg+" 的装备。\n"NOR);
                me->command("id");
                tell_object(me,HIY"你要消除哪件装备的性别限制(输入ID)，按 Q 退出："NOR);
                input_to("get_input",me);
                return;
        }
        if( ob->query("equipped") )
        {
                tell_object(me,CYN+name()+CYN"说道：你得先将"+ob->name(1)+NOR CYN"卸除。\n"NOR);
                return;
        }
        if( !ob->query("female_only") )
        {
                EMOTE_D->do_emote(this_object(), "bite",0,CYN,0,0,0);
                tell_object(me,CYN+name()+CYN"说道："+ob->name(1)+NOR CYN"是老爷们用的！\n"NOR);
                return;
        }
        if( me->query("inventory/yingshi")<2 )
        {
                EMOTE_D->do_emote(this_object(), "shake",geteuid(me),CYN,0,0,0);
                tell_object(me,CYN+name()+CYN"说道：你身上可用的萤石不够二块，萤石可以通过装备分解(fenjie)获得。\n"NOR);
                tell_object(me,HIR"最近的一次相关更新，将萤石相关道具数据化了，如果你背包里有实物化的道具(如碎片、莹玉、萤石)，请在长安南城客栈的炼器大师处兑换一下。\n"NOR);
                return;
        }
        EMOTE_D->do_emote(this_object(), "ok",geteuid(me),CYN,0,0,0);
        message_vision(HIC"$N"HIC"手掐法咒，口中喷出一口霞光，将$n"HIC"手中的"+ob->name(1)+HIC"顿时淹没！"+ob->name(1)+HIC"沐浴在霞光之中，好似有些不同。\n"NOR,this_object(),me);
        ob->delete("female_only");
        if( ob->is_zhaohuan() )
                ob->save();
	me->add("inventory/yingshi",-2);
        tell_object(me,HIY"【系统】你的"+ob->name(1)+HIY"上的性别限制已被炼去。\n"NOR);         
        me->delete_temp("pending/llibo_give");
}       

mixed about_equip(object me)
{
        if( !("/cmds/usr/zhaohuan.lpc")->init_player_file(me) )
        {
        	tell_object(me,CYN+name()+"说道：你需要重新登录以更新最近的当机bug修正。\n"NOR);
        	return 1;
        }
        if( !me->query_temp("pending/llibo_give") )
        {
                EMOTE_D->do_emote(this_object(), "xixi",geteuid(me),CYN,0,0,0);
                tell_object(me,CYN+name()+CYN"说道：无论你做还是不做，都得先给我五两黄金，否则无可奉告。\n"NOR);
                return 1;
        }
	EMOTE_D->do_emote(this_object(), "ok",geteuid(me),CYN,0,0,0);
        me->command("id");
        tell_object(me,HIY"你要消除哪件装备的性别限制(输入ID)，按 Q 退出："NOR);
        input_to("get_input",me);
        return 1;
}

//升级绑定装备
void get_input2(string arg, object me)
{
        object shi,ob;
        int lvl,cost_ys,cost_gold;
        
        if( !me || !living(me) || !present(me,environment()) )
                return;
        if( !arg )
        {
                tell_object(me,HIY"你要升级哪件装备(输入ID)，按 Q 退出："NOR);
                input_to("get_input2",me);
                return;
        }
        if( (arg[0]=='q' || arg[0]=='Q') && strlen(arg)<2 ) 
        	return;
        if( !me->check_pay(100000) )
        {
        	tell_object(me,CYN+name()+CYN"说道：升级装备需要消耗十两黄金，你身上带的钱不够。\n"NOR);
        	return;
        }
        
        ob = present(arg,me);
        if( !ob || (base_name(ob)!=me->MyArmorFile(1) && base_name(ob)!=me->MyWeaponFile(1)) 
         || !ob->query("valid_time") )
        {
                tell_object(me,CYN+name()+CYN"说道："+arg+" 不是绑定的装备，无法升级。\n"NOR);
                return;
        }
        if( ob->query("equipped") )
        {
                tell_object(me,CYN+name()+CYN"说道：你得先将"+ob->name(1)+NOR CYN"卸除。\n"NOR);
                return;
        }
        if( !ob->query("combination") )
        {
        	if( ob->query("exp")<ob->query_max_exp() )
        	{
                	tell_object(me,CYN+name()+CYN"说道：你的"+ob->name(1)+NOR CYN"成长度不够，无法升级。\n"NOR);
                	return;
        	}
        }
        else
        {
        	if( ob->query("combination_dbase/"+ob->query("skill_type")+"/exp")<ob->query_max_exp() )
        	{
                	tell_object(me,CYN+name()+CYN"说道：你的"+ob->name(1)+NOR CYN"成长度不够，无法升级。\n"NOR);
                	return;
        	}
        }	
        if( !ob->query("combination") )
        	lvl = ob->query("level");
        else	lvl = ob->query("combination_dbase/"+ob->query("skill_type")+"/level");
        if( wizardp(me) )
        	tell_object(me,sprintf("%O lvl = %d\n",ob,lvl));
        		
	if( lvl>=90 )
        {
        	cost_ys = 10;
	        cost_gold = 1000000;
	}
        if( lvl>=80 )
	{
        	cost_ys = 6;
        	cost_gold = 800000;
	}
        if( lvl>=70 )
        {
        	cost_ys = 6;
        	cost_gold = 500000;
        }
        if( lvl>=60 )
        {
        	cost_ys = 5;
        	cost_gold = 300000;
        }
        else
        {
        	cost_ys = 5;
        	cost_gold = 100000;
        }
        
        if( me->query("inventory/yingshi")<cost_ys )
        {
                EMOTE_D->do_emote(this_object(), "shake",geteuid(me),CYN,0,0,0);
                tell_object(me,CYN+name()+CYN"说道：你身上可用的萤石不够"+chinese_number(cost_ys)+"块，萤石可以通过装备分解(fenjie)获得。\n"NOR);
                tell_object(me,HIR"最近的一次相关更新，将萤石相关道具数据化了，如果你背包里有实物化的道具(如碎片、莹玉、萤石)，请在长安南城客栈的炼器大师处兑换一下。\n"NOR);
                return;
        }
        EMOTE_D->do_emote(this_object(), "ok",geteuid(me),CYN,0,0,0);
        message_vision(HIC"$N"HIC"手掐法咒，口中喷出一口霞光，将$n"HIC"手中的"+ob->name(1)+HIC"顿时淹没！"+ob->name(1)+HIC"沐浴在霞光之中，好似有些不同。\n"NOR,this_object(),me);
        if( ob->level_up() )
        {
        	me->money_add(-cost_gold);
        	me->add("inventory/yingshi",-cost_ys);
        	tell_object(me,"\n"HIR"【系统】你失去了"+MONEY_D->money_str(cost_gold,1)+"。\n【系统】你失去了"+chinese_number(cost_ys)+"块萤石。"NOR"\n");
        }
	else
	{
		if( ob )
			destruct(ob);
		tell_object(me,CYN+name()+CYN"说道：我很负责的告诉你，升级失败了。\n"NOR);
	}        
}  

mixed up_equip(object me)
{
        if( !("/cmds/usr/zhaohuan.lpc")->init_player_file(me) )
        {
        	tell_object(me,CYN+name()+"说道：你需要重新登录以更新最近的当机bug修正。\n"NOR);
        	return 1;
        }
        	
        if( !me->check_pay(100000) )
        {
        	tell_object(me,CYN+name()+CYN"说道：升级装备需要消耗十两黄金，你身上带的钱不够。\n"NOR);
        	return 1;
        }
	EMOTE_D->do_emote(this_object(), "ok",geteuid(me),CYN,0,0,0);
        me->command("id");
        tell_object(me,HIY"你要升级哪件装备(输入ID)，按 Q 退出："NOR);
        input_to("get_input2",me);
        return 1;
}

int valid_zuhe(object w1,object w2)
{
	int i;
	string *types;
	if( w1->query("combination") )
	{
		if( !w2->query("combination") )
		{
			if( w1->query("combination_dbae/"+w2->query("skill_type")) )
				return 0;
		}
		else
		{
			types = keys(w2->query("combination_dbase"));
			for(i=0;i<sizeof(types);i++)
			{
				if( w1->query("combination_dbae/"+types[i]) )
					return 0;
			}
		}		
	}
	else
	{
		if( !w2->query("combination") )
		{
			if( w1->query("skill_type")==w2->query("skill_type") )
				return 0;
		}
		else
		{
			if( w2->query("combination_dbae/"+w1->query("skill_type")) )
				return 0;
		}
	}
	return 1;
}

int is_persent_pro(string p)
{
	mapping pro = ("/cmds/std/look.lpc")->query_euqip_look2();
	return !undefinedp(pro[p]);
}

int to_dest(object me,object weapon)
{
	mixed *ar;
	string type;

	if( !me || !weapon || !present(weapon,me) )
        	return 0;
	if( !weapon->query("skill_type") )
	{
		tell_object(me,"no skill\n");
		return 0;
	}
	if( weapon->query("equipped") )
	{
		tell_object(me,"equipped\n");
		return 0;
	}

	type = sprintf("%s_%d_%s",weapon->query("skill_type"),weapon->query("valid_time"),weapon->name());
	type = COLOR_D->clean_color(type);
	if( !arrayp(ar=me->query("euqips"))
	 || sizeof(ar)<1 
	 || member_array(type,ar)==-1 )
	{
		tell_object(me,"no bd\n");
		return 0;
	}

	if( weapon->query("owner_id")
  	 && me->query("id")!=weapon->query("owner_id") )
	{
		tell_object(me,"no owner\n");
		return 0;
	}

	if( (me->query("potential")-me->query("learned_points"))<500 )   
       	{
		tell_object(me,"no pot\n");
		return 0;
	}

        seteuid(getuid());
        if( !rm(weapon->query_save_file()+ __SAVE_EXTENSION__) )
	{
		tell_object(me,"no del\n");
		return 0;
	}
        
	ar-= ({type});
	ar-= ({0});	
	me->add("potential",-500);
	if( sizeof(ar)>0 )
		me->set("euqips",ar);
	else	me->delete("euqips");
	me->save();
	weapon->move("/obj/empty");
	REMOVE_D->add_obj(weapon,1);
	return 1;
}
//武器组合
void get_zuhe2(string arg, object me)
{
	object w1,w2;
	string *same_pro,*prop1,*prop2,*strs,*types,name,str;
	mapping base_dbase,pro_dbase,w1_base,w2_base,dbase1,dbase2,combination_dbase,temp,tmp;
	int i,k,need;
        if( !me || !living(me) || !present(me,environment()) )
                return;
	w1 = me->query_temp("pending/zh_weapon1");
	w2 = me->query_temp("pending/zh_weapon2");
	me->delete_temp("pending");
	if( !w1 || !present(w1,me) || !w2 || !present(w2,me) )
	{
		tell_object(me,"没了？！\n");
		return;
	}
        if( !arg )
        {
		tell_object(me,HIY"你想将 "NOR+w1->name()+HIY" 与 "NOR+w2->name()+HIY" 组合。\n"NOR);
        	tell_object(me,HIY"请再次确认(y/n)："NOR);
       		input_to("get_zuhe2",me,w1,w2);        
       		return;
	}
	arg = sprintf("%c",arg[0]);
        if( arg!="Y" && arg!="y" )
        	return;
	if( !valid_zuhe(w1,w2) )
	{
		tell_object(me,CYN+name()+CYN"说道："NOR+w1->name(1)+NOR CYN" 与 "NOR+w2->name(1)+CYN"属性相冲，不能组合。\n"NOR); 
		return;
	}
	
	need = 1;
	if( w1->query("combination") )
		need+= 1;
	if( w2->query("combination") )
		need+= 1;
	if( me->query("inventory/jgb")<need )
	{
		tell_object(me,CYN+name()+CYN"说道：你需要消耗"+need+"块如意宝。\n"NOR);
		return;
	}
	
	types = ({});
	base_dbase = ([]);
	pro_dbase = ([]);
	same_pro = ({});
	w1_base = w1->query("weapon_prop");
	w2_base = w2->query("weapon_prop");
	prop1 = keys(w1_base);
	prop2 = keys(w2_base);
	dbase1 = w1->query_entire_dbase();
	dbase2 = w2->query_entire_dbase();
	if( sizeof(prop1)>sizeof(prop2) )
	{
		for(i=0;i<sizeof(prop1);i++)
		{
			if( member_array(prop1[i],prop2)!=-1 )
			{
				if( member_array(prop1[i],same_pro)==-1 )
					same_pro+= ({prop1[i]});
			}
		}
	}
	else
	{
		for(i=0;i<sizeof(prop2);i++)
		{
			if( member_array(prop2[i],prop1)!=-1 )
			{
				if( member_array(prop2[i],same_pro)==-1 )
					same_pro+= ({prop2[i]});
			}
		}
	}

	for(i=0;i<sizeof(same_pro);i++)
	{
		prop1-= ({same_pro[i]});
		prop2-= ({same_pro[i]});
	}

	
	if( !w1->query("combination") )
	{
		if( !w2->query("combination") )
		{
			combination_dbase = ([]);
			types = ({w1->query("skill_type"),w2->query("skill_type")});
		}
		else
		{
			combination_dbase = w2->query("combination_dbase");
			types = w2->query("skill_types");
			types+= ({w1->query("skill_type")});
		}
		if( !undefinedp(combination_dbase[w2->query("skill_type")]) )
			map_delete(combination_dbase,w2->query("skill_type"));	
	}
	else
	{
		combination_dbase = w1->query("combination_dbase");
		types = w1->query("skill_types");
		if( !w2->query("combination") )
			types+= ({w2->query("skill_type")});
		else
		{
			strs = w2->query("skill_types");
			for(i=0;i<sizeof(strs);i++)
				types+= ({strs[i]});
			
			temp = w2->query("combination_dbase");
			strs = keys(temp);
			for(i=0;i<sizeof(strs);i++)
			{
				if( strs[i]==w2->query("skill_type") )
					continue;
				combination_dbase[strs[i]] = temp[strs[i]];	
			}	
		}		
		if( !undefinedp(combination_dbase[w1->query("skill_type")]) )
			map_delete(combination_dbase,w1->query("skill_type"));
	}
	arg = "";
	tmp = ([]);
	temp = ([]);
	strs = keys(dbase1);
	for(i=0;i<sizeof(strs);i++)
	{
		if( strs[i]=="weapon_prop" || strs[i]=="combination_dbase" 
		  || strs[i]=="equipped" )
			continue;
		temp[strs[i]] = w1->query(strs[i]);	
	}
	for(i=0;i<sizeof(same_pro);i++)
	{
/*		if( w1->query("weapon_prop/"+same_pro[i])==0 )
			continue;
*/
		if( is_persent_pro(same_pro[i]) )  //百分比的
		{
			if( random(3)>0 )
		 		k = 1;
		 	else	k = 0;
		}
		else if( same_pro[i]=="combat_damage" || same_pro[i]=="spells_damage" 
		      || same_pro[i]=="combat_def" || same_pro[i]=="spells_def" )
			k = 250+random(51);
		else if( same_pro[i]=="max_kee" || same_pro[i]=="max_sen" ) 
			k = 800+random(201);
		else if( same_pro[i]=="max_force" || same_pro[i]=="max_mana" )
			k = 500+random(301);
		else
		{
			if( random(3)>0 )
				k = 5+random(6);
			else	k = 0;	
		}
		if( k>0 )
			arg+= sprintf(HIY"%s"HIY"的"HIG"%s"HIY"增加了"HIR"%d"HIY"点。\n"NOR,COLOR_D->clean_color(w1->name()),("/cmds/std/look.lpc")->_look_equip_apply(same_pro[i]),k);
		tmp[same_pro[i]] = w1->query("weapon_prop/"+same_pro[i])+k;
	}
	temp["base_prop"] = tmp;
	
	tmp = ([]);
	for(i=0;i<sizeof(prop1);i++)
		tmp[prop1[i]] = w1->query("weapon_prop/"+prop1[i]);
	temp["weapon_pro"] = tmp;
	combination_dbase[w1->query("skill_type")] = temp;
		
	//
	tmp = ([]);
	temp = ([]);
	strs = keys(dbase2);
	for(i=0;i<sizeof(strs);i++)
	{
		if( strs[i]=="weapon_prop" || strs[i]=="combination_dbase"
		 || strs[i]=="equipped" )
			continue;
		temp[strs[i]] = w2->query(strs[i]);	
	}
	for(i=0;i<sizeof(same_pro);i++)
	{
		if( w2->query("weapon_prop/"+same_pro[i])==0 )
			continue;
		if( is_persent_pro(same_pro[i]) )  //百分比
		{
			if( random(3)>0 || wizardp(me) )
		 		k = 1;
		 	else	k = 0;
		}
		else if( same_pro[i]=="combat_damage" || same_pro[i]=="spells_damage" 
		      || same_pro[i]=="combat_def" || same_pro[i]=="spells_def" )
			k = 250+random(51);
		else if( same_pro[i]=="max_kee" || same_pro[i]=="max_sen" ) 
			k = 800+random(201);
		else if( same_pro[i]=="max_force" || same_pro[i]=="max_mana" )
			k = 500+random(301);
		else
		{
			if( random(3)>0 || wizardp(me) )
				k = 5+random(6);
			else	k = 0;	
		}
		if( k>0 )
			arg+= sprintf(HIY"%s"HIY"的"HIG"%s"HIY"增加了"HIR"%d"HIY"点。\n"NOR,COLOR_D->clean_color(w2->name()),("/cmds/std/look.lpc")->_look_equip_apply(same_pro[i]),k);	
		tmp[same_pro[i]] = w2->query("weapon_prop/"+same_pro[i])+k;
	}
	temp["base_prop"] = tmp;
	tmp = ([]);
	for(i=0;i<sizeof(prop2);i++)
		tmp[prop2[i]] = w2->query("weapon_prop/"+prop2[i]);
	temp["weapon_pro"] = tmp;
	combination_dbase[w2->query("skill_type")] = temp;
	//
	if( !arrayp(strs = me->query("combination_euqips"))
	 || sizeof(strs)<1 )
	 	strs = ({});
	str = COLOR_D->clean_color(w1->name());
	str = sprintf("%s_%d_%s", w1->query("skill_type"),w1->query("valid_time"),str);	 	
	strs+= ({str});
	
	name = w2->name();
	str = COLOR_D->clean_color(name);
	str = sprintf("%s_%d_%s", w2->query("skill_type"),w2->query("valid_time"),str);	 	
	strs+= ({str});
	
	str = name()+"念叨了几句咒语，";
	if( !to_dest(me,w2) )
	{
		str+= name()+"低头叹了口气。\n";
		tell_object(me,str);
		tell_object(me,CYN+name()+CYN"说道：融合失败了。\n"NOR);
		return;
	}
		
	w1->set("skill_types",types);
	w1->add("combination",1);
	w1->set("combination_dbase",combination_dbase);
	w1->update_combination();
		
	if( !w1->save() )
	{
		str+= name()+"脸色大变，只见"+w1->name()+NOR"也“轰”的一声炸成了渣渣！\n";
		w1->move("/obj/empty");
		REMOVE_D->add_obj(w1,5);
		tell_object(me,str);
		tell_object(me,CYN+name()+CYN"说道：融合失败了。\n"NOR);
		return;
	}
	str+= name+"化作星星点点，渐渐与"+w1->name()+"组合在了一起。\n";
	str = COLOR_D->replace_color( HIG+COLOR_D->clean_color(str)+NOR,1 );
	tell_object(me,str);
	if( arg!="" )
		tell_object(me,arg);
	me->check_equip_data();	
	CHANNEL_D->do_channel(this_object(),"rumor","听说"HIY+me->name()+HIM"成功将"+COLOR_D->replace_color(HIG+COLOR_D->clean_color(w1->name()),1)+HIM" 和 "+ COLOR_D->replace_color(HIG+COLOR_D->clean_color(name),1)+HIM" 组合了！"NOR);
	if( me->query("mark/jgb")<1 ) //*dntg2的bug，所以在第三关时加这个data
		me->delete("inventory/jgb");
	else	me->add("inventory/jgb",-need);	
	
	if( arrayp(strs) && sizeof(strs)>0 )
		me->set("combination_euqips",strs);
	me->save();

	return;        	
}

void get_zuhe(string arg, object me)
{
        object w1,w2;
        string id1,id2;
        if( !me || !living(me) || !present(me,environment()) )
                return;
        if( !arg )
        {
	        tell_object(me,HIY"你要组合哪两件武器(输入ID，用"HIR" , "HIY"隔开)，按 Q 退出："NOR);
        	input_to("get_zuhe",me);
                return;
        }
        if( arg[0]=='q' || arg[0]=='Q' )
        	return;
	if( sscanf(arg,"%s,%s",id1,id2)!=2 )
	{
	        tell_object(me,HIY"你要组合哪两件武器(输入ID，用"HIR" , "HIY"隔开)，按 Q 退出："NOR);
        	input_to("get_zuhe",me);
                return;
        }
        if( !objectp(w1=present(id1,me))
         || !w1->is_weapon() || !w1->is_zhaohuan() )
	{
		tell_object(me,CYN+name()+CYN"说道：你身上没有名为"+id1+"的绑定武器。\n"NOR);
		return;
	}
        if( !objectp(w2=present(id2,me))
         || !w2->is_weapon() || !w2->is_zhaohuan() )
	{
		tell_object(me,CYN+name()+CYN"说道：你身上没有名为"+id2+"的绑定武器。\n"NOR);
		return;
	}
        if( w1->query("level")<60 )
        {
		tell_object(me,CYN+name()+CYN"说道：你的"+id1+"等级不够60，无法组合。\n"NOR);
		return;
	}
	if( w2->query("level")<60 )
        {
		tell_object(me,CYN+name()+CYN"说道：你的"+id2+"等级不够60，无法组合。\n"NOR);
		return;
	}
        if( w1->query("equipped") )
        {
		tell_object(me,CYN+name()+CYN"说道：你得先卸除"+id1+"。\n"NOR);
		return;
	}
	if( w2->query("equipped") )
        {
		tell_object(me,CYN+name()+CYN"说道：你得先卸除"+id2+"。\n"NOR);
		return;
	}
	
	me->set_temp("pending/zh_weapon1",w1);
	me->set_temp("pending/zh_weapon2",w2);
        tell_object(me,HIY"你想将 "NOR+w1->name()+HIY" 与 "NOR+w2->name()+HIY" 组合。\n"NOR);
        tell_object(me,HIR"组合后的武器将不能分解、回炼、融合，目前也不提供组合武器的镶嵌。你确定你要组合？\n"NOR);
        tell_object(me,HIY"请再次确认(y/n)："NOR);
       	input_to("get_zuhe2",me);
	return;
}

mixed wuqi_zuhe(object me)
{
	if( me->query_level()<80
	 || me->query("dntg/donghai")!="done" )
	{
		tell_object(me,CYN+name()+CYN"说道：待你突破到80级后再来找我。\n"NOR);
		return 0;
	}
	if( me->query("inventory/jgb")<1 )
	{
		tell_object(me,CYN+name()+CYN"说道：你的如意宝不够。\n"NOR);
		return 0;
	}
	if( (me->query("potential")-me->query("learned_points"))<1000 )   
	{
		tell_object(me,CYN+name()+CYN"说道：你的潜能不足1000。\n"NOR);
		return 0;
	}
	me->command("id");
        tell_object(me,HIY"你要组合哪两件武器(输入ID，用"HIR" , "HIY"隔开)，按 Q 退出："NOR);
        input_to("get_zuhe",me);
        return 1;
}