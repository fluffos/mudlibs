#include <ansi.h>
inherit "/d/maze/tupo40-5/room.lpc";

void create() 
{ 
        set("short", "路口"); 
        set("long", @LONG 
LONG); 
        set("virtual_room", 1); 
        set("no_magic",1);
        set("no_fight",1);    
        set("alternative_die",1);    
        set("exits", ([
                "east" : __DIR__"maze/entry", 
                "out": "/d/changan/zhongnan",
        ])); 
        setup();
} 

void init()
{
      if( !userp(this_player()) )
    {
         this_player()->move("/obj/empty");
         REMOVE_D->add_obj(this_player(),0);
    }
    ::init();
}
