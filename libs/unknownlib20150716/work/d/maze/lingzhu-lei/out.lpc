#include <ansi.h>
inherit "/d/maze/lingzhu-lei/room.lpc";

void create()
{
        set("short","树林");
        set("channel_id","雷灵珠副本");
        set("long", @LONG
这是一片茂密的树林，好象被人设计了一种阵，一走进来，你仿佛迷失了方向。
LONG );
        set("alternative_die",1);
        set("virtual_room", 1); 
        set("no_magic",1);
        set("no_fight",1);    
        set("exits", ([
                "north" :__DIR__"maze/exit",
        ])); 
        setup();
}