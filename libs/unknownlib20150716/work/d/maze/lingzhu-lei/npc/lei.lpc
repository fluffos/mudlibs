inherit SUPER_NPC;
#include <ansi.h>
#include <armor.h>

string armor_type(object ob)
{
	if( !ob )
		return "";
	switch(ob->query("armor_type")) 
	{
		case TYPE_HEAD	: return "战盔";
		case TYPE_NECK	: return "护符";
		case TYPE_CLOTH	: return "战衣";
		case TYPE_ARMOR	: return "神甲";
		case TYPE_SURCOAT : return "披风";
		case TYPE_WAIST	: return "腰带";
		case TYPE_WRISTS : return "手镯";
		case TYPE_SHIELD : return "盾";
		case TYPE_FINGER : return "戒";
		case TYPE_HANDS  : return "护手";
		case TYPE_BOOTS : return "神靴";
		default		: return "";
	}	
}

void create()
{
	set_name("辛环",({"xin huan","xin","leishen", "shen","lei gong"}));
	set("long", @LONG
此乃凌霄天宫雷部二十四位天君正神之一的辛天君。	有诗赞：
    二翅空中响，头戴虎头冠。面如红枣色，顶上宝光寒。
    锤钻安天下，獠牙嘴上安。一怒无遮档，飞来势若鸾。 	
LONG);	
	set("looking", HIR"面如红枣色，獠牙嘴上安"NOR"。");
	set("rank_info/pos_msg", HIC"浑身笼罩着层层雷光"NOR"。\n");
	set_level(10);
	create_family("东海龙宫", 2, "蓝");
	set("title",HIC"雷公"NOR);
	set("gender", "男性");
	set("age", 30);
	set("attitude", "friendly");
	set("per", 30);
	set("force_factor", 180);
	set("mana_factor", 220);
 	set("class","dragon");
	setup();
	set_temp("no_return",1);
}

int information(object who)
{
	string name,*ar;
	object ob,*inv;
	int lvl,i,k;
	if( !who || !userp(who) )
		return 0;
	if( query("created") || query("created")==who )
		return 0;
	lvl = who->query_level();
	if( lvl<10 )
		lvl = 10;
	lvl = lvl+random(lvl/3);		
	set_level(lvl);
	set_skill("literate",lvl*10);
	set_skill("unarmed",lvl*10);
	set_skill("dodge",lvl*10);
	set_skill("parry",lvl*10);
	set_skill("dagger", lvl*10);
	set_skill("spells", lvl*10);
	set_skill("wulei",lvl*10);
	set_skill("dragonfight",lvl*10);
	set_skill("dragonforce",lvl*10);
	set_skill("force",lvl*10);
	set_skill("leigong-zhui",lvl*10);
	map_skill("spells", "wulei");
	map_skill("unarmed", "dragonfight");
	map_skill("force", "dragonforce");
	map_skill("dagger", "leigong-zhui");
	map_skill("parry", "leigong-zhui");
	map_skill("dodge", "leigong-zhui");		
	
	if( pointerp(inv = all_inventory()) 
	 && sizeof(inv)>0 )
	{
		for(i=0;i<sizeof(inv);i++)
		{
			inv[i]->unequip();
			if( !userp(inv[i]) )
				destruct(inv[i]);
		}	
	}

	setup();
	set("env/test","HIM");
	carry_object("/d/obj/baowu/leizhu",0,1);
	ar = ({
		"armor","cloth","pifeng","kui","hand",
		"wrists","waist",		
	});
	for(i=0;i<sizeof(ar);i++)
	{
		if( objectp(ob=carry_object(0,ar[i],1)) )
		{
			ob->set("armor_title","辛环");
			name = armor_type(ob);
			ob->set_name("雷公"+name,({"leigong "+ar[i],ar[i]}));
		}
	}

	if( objectp(ob=carry_object(0,"dagger",1)) )
	{
		ob->set_name("雷公椎",({"leigong zhui","zhui",}));
		ob->set("weapon_title","辛环");
	}	
	command("wear all");
	command("wield all");
	powerup(0,1);
	set("created",who);
	who->set_follow(0);
	return 1;
}

void leizhu()
{
	object zhu;
	remove_call_out("leizhu");
	if( !living(this_object()) )
		return;
	this_object()->start_busy(0);
	if( !objectp(zhu=present("lei lingzhu",this_object()))
	 || !zhu->query("equipped") )
	 	return;
	command("cast leiji");
	remove_call_out("leizhu");
	call_out("leizhu",5+random(3));	
}

void kill_ob (object ob)
{
	if( !userp(ob) )
	{
		remove_killer(ob);
		ob->remove_killer(this_object());
		message_vision("\n$N高举双手大喝：去死吧！从天上降下一道闪电将$n化作一堆灰烬。\n",this_object(),ob);
		destruct(ob);
		return;
	}
	if( !query("created") 
	 || query("created")!=ob )
	{
		remove_killer(ob);
		ob->killer_ob(this_object());
		tell_object(ob,HIC+name()+HIC"不想和你交手。\n"NOR);
		return;
	}
	::kill_ob(ob);
	command("cast leiji");
	remove_call_out("leizhu");
	call_out("leizhu",5);
}

int accept_fight (object ob)
{ 
	if( !ob->query_temp("maze/leigong") 
	 || !userp(ob) )
		return 0;
	if( query("created") && query("created")!=ob )
		return 0;		
	if( !environment()->query("virtual_room") )
		return 0;
	EMOTE_D->do_emote(this_object(), "nod",geteuid(ob),CYN,0,0,0);		
	if( !query("created") )
	{
		if( information(ob) )
		{
			EMOTE_D->do_emote(this_object(), "nod",geteuid(ob),CYN,0,0,0);
			kill_ob(ob);
			return 1;
		}
	}
	return 0;	
}

void unconcious()
{
	die();
}

void reward_ob(object who)
{
        object zhu;
	string file;
	int i;
        if( !who || !userp(who) || !present(who,environment()) 
         || !who->query_temp("maze/leigong")
         || !query("created") || query("created")!=who 
         || environment()->query("channel_id")!="雷灵珠副本" )
        {
        	message_vision(HIC"\n半空传来一声喝声：雷部点卯，辛天君速速就位！\n$N"HIC"大喝一声：我去也。\n"NOR,this_object());
                destruct(this_object());
                return;
        }
	powerup(0,1);
	stop_busy();
	start_hunluan(0,"");
	start_blind(0,"");
	start_no_move(0,"");
	reset_action();
	message_vision(HIG"\n$N"HIG"脸色微变，浑身电光闪烁。\n"NOR,this_object());
	message_vision("$N深深吸了几口气，脸色看起来好多了。\n$N略一凝神，吸了口气，精神看起来清醒多了。\n",this_object());
	add("combat_lost",1);
	if( random(query("combat_lost"))>3 )
	{
		remove_killer(who);
		who->remove_killer(this_object());
		EMOTE_D->do_emote(this_object(), "young",geteuid(who),CYN,0,0,0);
		message_vision(HIC"$N"HIC"说道：好了好了，不打了，不打了。也出了一身汗。\n"NOR,this_object());
		tell_object(who,CYN"辛环说道："+RANK_D->query_respect(who)+"不错，今天雷爷爷玩得很开心。\n"NOR);
		zhu = new("/d/obj/baowu/leizhu.lpc");
		if( zhu->move(who) )
		{
			message_vision("$N将"HIB"雷灵珠"NOR"递给了$n。\n",this_object(),who);
			CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+"得到了"HIB"雷灵珠"HIM"。"NOR);
		}
		else if( zhu )
			destruct(zhu);	
		message_vision("\n"HIC"辛环拉着$N"HIC"的手，往北泾水之滨离去。\n"NOR,who);	
        	who->set("maze/lingzhu-lei",time());
        	who->delete_temp("maze");
		file = "/d/changan/eside5";
       		who->move(file,2);
       		destruct(this_object());
		return;
	}
	else 
	{
		EMOTE_D->do_emote(this_object(), "zeze",geteuid(who),CYN,0,0,0);
		tell_object(who,CYN"辛环说道：不错不错，打的好是开心。\n"NOR);
		tell_object(who,HIC"辛环说道：继续继续，随我来！\n"NOR);
		if( query("combat_lost")==1 )
		{
			command("go south");
			command("go east");
		}
		else
		{
			reset_eval_cost();
			i = 1+random(5);
			while(i--)
				random_move();
		}
		return;
	}
	
}
