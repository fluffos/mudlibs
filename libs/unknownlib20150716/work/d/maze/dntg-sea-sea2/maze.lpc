#include <ansi.h>
inherit VRM_SERVER;

void create() {
  set_maze_map_color(HIG);
  set_inherit_room("/d/maze/dntg-sea-sea2/room");
  set_display_map(2);
  //迷宫的单边长
  set_maze_long(4);
  //每个房间的出口，默认是2
  set_maze_exit(4);
  //无出口的方向不显示，默认是显示
  set_maze_exittype(1);
  //入口方向(出口在对面)
  set_entry_dir("north");
  //入口与区域的连接方向
  set_link_entry_dir("south");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "enter");

  //出口与区域的连接方向
  set_link_exit_dir("west");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "out");

  //普通房间描述
  set_maze_room_short("海底迷宫");
  set_maze_room_desc(@LONG
这里水色变的浑浊起来，周围已看不大清楚了。偶有暗流袭来，卷
起阵阵的泥流。四处长着些高高的海草，密密麻麻把头上遮的一丝
光芒也没有了。
LONG);
  //入口房间短描述 
  set_entry_short(HIY "海底迷宫" NOR);
  //入口房间描述 
  set_entry_desc(@LONG
海水又变的清澈了，但你已经很难找到方向了。四周的景物好象都一样，要是没人引路的话看来
很难出去了。
LONG);
  //出口房间短描述 
  set_exit_short(HIG "海底迷宫" NOR);
  //出口房间描述 
  set_exit_desc(HIG + @LONG
海水又变的清澈了，但你已经很难找到方向了。四周的景物好象都一样，要是没人引路的话看来
很难出去了。
LONG + NOR);
  // 迷宫房间是否为户外房间？ 
  set_outdoors(0);

  //迷宫房间是否刷新且刷新时间设置
  set_maze_refresh(10800);
  //迷宫销毁时间
  set_remove_time(10800);
}
