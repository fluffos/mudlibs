#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "海藏");
	set("channel_id","龙王敖广(Ao guang)");
	set("long", @LONG
空荡荡的海藏中直立着一根铁柱子，金光闪闪照得人睁不开眼。
LONG );
	set("exits", ([
  		"up"   : "/d/changan/eastseashore",
	]));
	set("objects",([
		__DIR__"obj/ruyibao.lpc" : 1,
	]));	
	setup();
}

int valid_leave(object me, string dir)
{
	int i,a,max_a;
	if( userp(me) && me->query("dntg/donghai")=="haizang" 
         && ( wizardp(me) || me->query_level()==79 )
	 && dir=="up" 
	 && !present("ruyi bao",this_object()) )
	{
		if( me->level_up() )
		{
			tell_object(me,HIG"碧涛翻滚中，你福至心灵，感觉多日的瓶颈豁然开朗！\n"NOR);
			tell_object(me,HIG"【系统】你的等级提升了"HIR"1"HIG"级。\n"NOR);
			CHAR_D->setup_char( me );
			UPDATE_D->check_user(me,1);
			me->powerup();
			me->set_temp("login_data/time", time());
			me->set_temp("login_data/exp", 0);
			max_a = me->query("life/init_life_time");
			a = me->query("life/life_time");
			a = max_a - a;
			i = 80+random(50);
			if( i>a )
				i = a;
			if( i>0 )
			{				
				me->add("life/life_time",i);
				tell_object(me,HIY"【系统】你得到了"HIR+i+HIY"点寿元。"NOR"\n");	
			}
			CHANNEL_D->do_channel(this_object(),"chat",me->query("name")+"你竟敢拿走我龙宫的定海神针铁，看我不去玉帝面前告你！");
			me->set("dntg/number",2);
			me->set("dntg/donghai","done");
			me->set("inventory/jgb",1);
			i = 3000+random(2000);
			me->add("daoxing",i);
			tell_object(me,HIY"你赢得了"+COMBAT_D->chinese_daoxing(i)+"道行！\n"NOR);
			me->save();
		}
  	}
	message_vision(HIG"$N"HIG"向上一纵，一股巨浪随着$N"HIG"冲天而起。\n"NOR,this_player());	
  	return ::valid_leave(me, dir);
}

