#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short","海底迷宫");
        set("channel_id","水晶宫");
        set("no_huicheng",1);
        set("no_chuqiao",1);
        set("no_qiankun",1);
        set("long", @LONG
海水又变的清澈了，但你已经很难找到方向了。四周的景物好象都一样，要是没人引路的话看来
很难出去了。
LONG );
        setup();
}
                     
int do_drop(string arg)
{
	return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "recall","move","maphere","fight","find",
                "mazemap","map",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}

void jinyu(object who)
{
	string *exits,exit,str;
	mapping dir,ex;
	int x,y;
	remove_call_out("jinyu");
	if( who && living(who) && present(who,this_object())
	 && who->query_temp("maze/donghai_jinyu")<8 )
	{
		///data/maze/s/snowtu/dntg-sea-sea1/maze/3/3
		ex = query("exits");
		exits = keys(ex);
		str = exits[random(sizeof(exits))];
		exit = ex[str];
		dir = ("/cmds/std/look.lpc")->query_default_dirs();
		if( !undefinedp(dir[str]) )
			str = dir[str];
		exit = replace_string(exit,sprintf("/data/maze/%c/%s/dntg-sea-sea2/maze/",who->query("id")[0],who->query("id")),"");	
		sscanf(exit,"%d/%d",x,y);
		if( x>0 || y>0 )
		{
			who->set_temp("maze/succ_exit",x+"|"+y);
			message_vision(HIY"一只小金鱼往"+str+"方向游去。\n"NOR,who);
		}
	}
}

void init()
{
	string file;
	int x,y;
	object who = this_player();
	add_action("do_drop","drop");
	add_action("do_cmds","",1);
	file = file_name(this_object());
	file = replace_string(file,sprintf("/data/maze/%c/%s/dntg-sea-sea2/maze/",who->query("id")[0],who->query("id")),"");
	if( wizardp(this_player()) )
		tell_object(this_player(),"\tfilename="+file+"\n");
	sscanf(file,"%d/%d",x,y);
	if( wizardp(this_player()) )
		tell_object(this_player(),"\tx="+x+" y="+y+"\n");
	
	if( who->query_temp("maze/succ_exit")==x+"|"+y )
	{
		who->delete_temp("maze/succ_exit");
		who->add_temp("maze/donghai_jinyu",1);
		who->set_temp("maze/"+x+"|"+y,1);
	}
	if( userp(this_player()) 
	 && sizeof(query("exits"))>2 
	 && !this_player()->query_temp("maze/"+x+"|"+y) )
	{
		remove_call_out("jinyu");
		this_player()->start_busy(1);
		call_out("jinyu",1,this_player());
	}
}

int valid_leave(object who,string dir)
{
	object room;
	if( !userp(who) || !query("exits/"+dir) 
	 || who->query_temp("maze/donghai_jinyu")<8 )
		return ::valid_leave(who,dir);
	room = clone_object("/d/maze/dntg-sea-sea2/haizang");
	who->move(room);
	return 2;
}