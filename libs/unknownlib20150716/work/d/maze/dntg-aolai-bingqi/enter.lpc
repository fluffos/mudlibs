inherit "/d/maze/dntg-aolai-bingqi/room.lpc";

void create() 
{ 
        set("short", "傲来国演武场"); 
        set("channel_id","傲来国兵器库");
        set("long", @LONG
傲来国演武场，文官武将，各穿锦衣；帐下偏裨将校，都披银铠。分两行。左右军
士，皆全装惯带，持戈执戟而立。中间一行行兵士威风凛凛的穿行于其中。
LONG );
        set("virtual_room", 1); 
        set("no_magic",1);
        set("no_fight",1);    
        set("exits", ([
                "south" : __DIR__"maze/entry", 
        ]));
        setup();
} 