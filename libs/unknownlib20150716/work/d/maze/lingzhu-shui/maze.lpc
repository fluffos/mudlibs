#include <ansi.h>
inherit VRM_SERVER;

void create() {
  set_maze_map_color(HIW);
  set_inherit_room("/d/maze/lingzhu-shui/room");
  set_npcs_rate(90);
  set_display_map(2);
  //迷宫的单边长
  set_maze_long(5);
  //每个房间的出口，默认是2
  set_maze_exit(2);
  //无出口的方向不显示，默认是显示
  set_maze_exittype(1);
  //入口方向(出口在对面)
  set_entry_dir("north");
  //入口与区域的连接方向
  set_link_entry_dir("south");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "enter");

  //出口与区域的连接方向
  set_link_exit_dir("east");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "out");

  //普通房间描述
  set_maze_room_short(HIG "水下" NOR);
  set_maze_room_desc(@LONG
水底到处都是些水草，还有些小虾米，鱼儿穿来穿去，偶尔还能看到
几具骸骨。

LONG);
  //入口房间短描述 
  set_entry_short(HIC "水底" NOR);
  //入口房间描述 
  set_entry_desc(@LONG
水底到处都是些水草，还有些小虾米，鱼儿穿来穿去，偶尔还能看到
几具骸骨。

LONG);
  //出口房间短描述 
  set_exit_short("黑洞");
  //出口房间描述 
  set_exit_desc(@LONG
一个黑乎乎的泥洞，里面尽是些稀泥。还有些腐烂的草木。小虾米，鱼儿
穿来穿去，偶尔还能看到几具骸骨。

LONG);
  // 迷宫房间是否为户外房间？ 
  set_outdoors(0);

  //迷宫房间是否刷新且刷新时间设置
  set_maze_refresh(10800);
  //迷宫销毁时间
  set_remove_time(10800);
}
