inherit NPC;
#include <ansi.h>
#include <armor.h>

void create() {
  mapping name;
  string n;
  if (!mapp(name = NAME_D->random_name2(0, 0, 0, 0, 0))
    || name["name"] == "测试")
    set_name("虞河", ({ "yu he", "yu", "dawang" }));
  else set_name(name["name"], name["id"]);
  n = query("name");
  set_level(10);
  set("long", n + "是自称黄河大王，在这一带招兵买马，准备闯出一番事业。\n");
  create_family("东海龙宫", 3, "水族");
  set("gender", "男性");
  set("age", 36);
  set("title", "黄河大王");
  set("class", "dragon");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 20);
  set("force_factor", 120);
  set("mana_factor", 140);

  set_skill("literate", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("fork", 100);
  set_skill("spells", 100);
  set_skill("seashentong", 100);
  set_skill("dragonfight", 100);
  set_skill("dragonforce", 100);
  set_skill("fengbo-cha", 100);
  set_skill("dragonstep", 100);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  set_skill("zhidi-chenggang", 100);
  set_skill("danshan", 100);
  set_skill("qiyu", 100);
  set_skill("duanliu", 100);
  set_skill("jiefeng", 100);
  set_skill("huanyu-hufeng", 100);
  set("env/test", ({ "HIR", "HIM" })[random(2)]);
  setup();
  powerup(0, 1);
}

int accept_fight(object ob) { return 0; }

void unconcious() {
  die();
}

int infomation(object who) {
  string *str;
  object ob;
  int lvl, i;
  if (!who || !living(who) || query("created"))
    return 0;
  set("created", 1);
  lvl = who->query_level();
  if (lvl < this_object()->query_level())
    lvl = this_object()->query_level();
  set_level(lvl);
  set_skill("literate", lvl * 10);
  set_skill("unarmed", lvl * 10);
  set_skill("dodge", lvl * 10);
  set_skill("force", lvl * 10);
  set_skill("parry", lvl * 10);
  set_skill("fork", lvl * 10);
  set_skill("spells", lvl * 10);
  set_skill("seashentong", lvl * 10);
  set_skill("dragonfight", lvl * 10);
  set_skill("dragonforce", lvl * 10);
  set_skill("fengbo-cha", lvl * 10);
  set_skill("dragonstep", lvl * 10);
  set_skill("zhidi-chenggang", lvl * 10);
  set_skill("danshan", lvl * 10);
  set_skill("qiyu", lvl * 10);
  set_skill("duanliu", lvl * 10);
  set_skill("jiefeng", lvl * 10);
  set_skill("huanyu-hufeng", lvl * 10);
  setup();
  add_temp("apply/max_kee", this_object()->query_maxkee());
  add_temp("apply/max_sen", this_object()->query_maxsen());
  str = ({
    "armor", "cloth", "hand", "kui", "neck", "pifeng", "ring", "shield", "shoes",
    "waist", "wrists",
  });
  for (i = 0; i < sizeof(str); i++) {
    if (objectp(ob = carry_object(0, str[i], 1)))
      ob->set("armor_title", query("name"));
  }
  if (objectp(ob = carry_object(0, "fork", 1))) {
    ob->set("weapon_title", query("name"));
    set_temp("my_weapon1", ob);
  }
  if (objectp(ob = carry_object(0, "unarmed", 1))) {
    ob->set("weapon_title", query("name"));
    set_temp("my_weapon2", ob);
  }
  command("wear all");
  powerup(0, 1);
  return 1;
}

void hurting(object who) {
  object ob, weapon;
  remove_call_out("hurting");
  if (!who || !present(who, environment())
    || !this_object()->is_fighting(who)
    || !living(this_object()))
    return;
  if (this_object()->is_busy()
    || this_object()->is_hunluan()
    || this_object()->is_blind()) {
    call_out("hurting", 2, who);
    return;
  }
  exert_function("recover");
  exert_function("refresh");
  command("perform dodge.xiao");
  if (random(4) == 1)
    exert_function("jin");
  else exert_function("shield");
  switch (random(3)) {
    case 1: cast_spell("hufa"); break;
    case 0: cast_spell("freez"); break;
    default: cast_spell("water"); break;
  }

  if (objectp(ob = query_temp("my_weapon1"))
    && present(ob, this_object())) {
    if (objectp(weapon = query_temp("weapon"))
      && weapon != ob)
      command("unwield " + weapon->query("id"));
    command("wield " + ob->query("id"));
    perform_action("fork", "fengbo");
    if (random(4) == 1)
      perform_action("fork", "bibo");
    if (random(4) == 1)
      perform_action("fork", "dhwl");
  }
  if (objectp(ob = query_temp("my_weapon2"))
    && present(ob, this_object())) {
    if (objectp(weapon = query_temp("weapon"))
      && weapon != ob)
      command("unwield " + weapon->query("id"));
    command("wield " + ob->query("id"));
    perform_action("unarmed", "leidong");
    if (random(4) == 1)
      perform_action("unarmed", "sheshen");
    if (random(4) == 1)
      perform_action("unarmed", "shenglong");
  }
  call_out("hurting", 2 + random(4), who);
}

void kill_ob(object ob) {
  if (!userp(ob))
    powerup(0, 1);
  if (!infomation(ob)) {
    message_vision(HIC "$N" HIC "不屑的撇了$n" HIC "一眼。\n" NOR, this_object(), ob);
    this_object()->remove_killer(ob);
    ob->remove_killer(this_object());
    return;
  }
  if (this_object()->is_fighting()
    && !this_object()->is_fighting(ob)) {
    message_vision(CYN "$N" CYN "说道：你们以多欺少，劳资不服！\n" NOR, this_object());
    this_object()->remove_killer(ob);
    ob->remove_killer(this_object());
    return;
  }
  ::kill_ob(ob);
  remove_call_out("hurting");
  call_out("hurting", 1 + random(4), ob);
}

void reward_ob(object who) {
  object where, zhu;
  string file;
  int i, x, y;
  if (!who || !userp(who) || !present(who, environment())
    || environment()->query("channel_id") != "水灵珠副本") {
    message_vision(HIB "$N" HIB "变作一条草鱼，急急忙忙的游走了。\n" NOR, this_object());
    destruct(this_object());
    return;
  }
  where = environment();
  powerup(0, 1);
  message_vision("$N惨叫一声，化作一条草鱼游走了。\n" NOR, this_object());
  zhu = new("/d/obj/baowu/shuizhu.lpc");
  if (zhu->move(who)) {
    message_vision(HIC "$N" HIC "临走前口中吐出一颗白光闪闪的珠子。\n" NOR, this_object());
    tell_object(who, "你捡起一颗" HIW "水灵珠" NOR "。\n");
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      "听说" + who->name(1) + "得到了" HIW "水灵珠" HIM "。" NOR
    );
    who->add("combat_exp", 15000);
    who->add("potential", 3000);
    who->add("daoxing", 3000);
    tell_object(who, HIG "【系统】你得到了15000点武学经验、3000点潜能、三年道行。\n" NOR);
  } else if (zhu)
    destruct(zhu);
  destruct(this_object());
  return;
}
