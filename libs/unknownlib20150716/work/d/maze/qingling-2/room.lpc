#include <ansi.h>
inherit ROOM;
    
void create()
{
	mapping look;
        set("short","始皇陵二层副本");
        set("channel_id","始皇陵二层副本");
        set("alternative_die",1);
        look = ([
                "west" : "这里黑布隆冬的，你看不清楚。\n",
                "east" : "这里黑布隆冬的，你看不清楚。\n",
                "north" : "这里黑布隆冬的，你看不清楚。\n",
                "south" : "这里黑布隆冬的，你看不清楚。\n",
        ]);
        switch(random(5))
        {
        	case 0 :
        	case 1 : 
        		look["guan"] = "一个古旧的石棺(guan)，棺盖好似已经松烂不堪，一推(push)就能推开。\n";
        		set("guai",random(3)+1);
        		set("long2","    一旁散落着一具破烂不堪的石棺(guan)。\n");
        		break;
        	case 4 : 
        		look["corpse"] = "一具不知多少年的尸骸，安静的躺在那里，空洞的眼眶嘲讽般的朝着你。\n旁边散落着一个破旧的储物袋(bag)，不知道里面有没东西可以捡(get)。\n";
        		look["bag"] = "一个破旧的储物袋，看不清里面的东西。\n";
        		set("guai",random(3)+1);
        		set("long2","    一旁躺着一具不知是谁的尸骸(corpse)。\n");
			break;
        }
        set("item_desc",look); 
        set("no_team",1);
        setup();
}

mixed alternative_die(object who)
{
        int i,lost;
        object leader,target;
        string file,msg,id;
        if( !who )
                return 0;
        if( !userp(who) )
        {
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,this_object()) 
                 && target->query_temp("maze/qinling2") )
                        who->reward_ob(target);
                else 	message_vision (HIR"\n$N"HIR"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"枯骨"NOR HIR"。\n\n"NOR,who);
                if( who )  destruct(who);
                return 0;                         
        }
        //玩家死亡
        if( !who->query_temp("maze/qinling2") )
        	return 1;
        
        if( objectp(leader=who->query_leader()) )
        	id = leader->query("id");
        else	id = who->query("id");	
        
        who->powerup(0,1);
        if( random(2) )
                msg = COMBAT_D->status_msg((1+random(5))*10);
        else    msg = COMBAT_D->eff_status_msg((1+random(5))*10);
        message_vision(NOR"\n( $N"+msg+NOR")\n",who);
        message_vision("\n"HIC"$N"HIC"顿时脸色一白，慌忙将身祭起一道遁光仓皇逃离。\n"NOR,who);  
        
        lost = 8000;
        lost = lost*9/10+random(lost/10);
        if( who->query("combat_exp")<lost )
                who->set("combat_exp",0);
        else    who->add("combat_exp",-lost);
        tell_object(who,HIR"【副本】始皇陵二层：你临阵脱逃，损失了"HIY+lost+""HIR"点武学经验。"NOR"\n");
        
        lost = 2000;
        lost = lost*9/10+random(lost/10);
        if( who->query("daoxing")<lost )
                who->set("daoxing",0);
        else    who->add("daoxing",-lost);
        tell_object(who,HIR"【副本】始皇陵二层：你临阵脱逃，损失了"HIY+COMBAT_D->chinese_daoxing(lost)+""HIR"道行。"NOR"\n");
        
        lost = 1500;
        lost = lost*9/10+random(lost/10);
        if( who->query("potential")-who->query("learned_points")<lost )
                who->set("potential",who->query("learned_points"));
        else    who->add("potential",-lost);
        tell_object(who,HIR"【副本】始皇陵二层：你临阵脱逃，损失了"HIY+lost+""HIR"点修为潜能。"NOR"\n");
                
        who->set("kee",100);
        who->set("eff_kee",100);
        who->set("sen",100);
        who->set("eff_sen",100);
        who->set("force",0);
        who->set("mana",0);
        
        file = sprintf("/data/maze/%c/%s/qingling-2/enter.lpc",id[0],id);
        if( file_size(file)>0 )
        	who->move(file,2);
        else
        {	
        	who->dismiss();
        	who->move(sprintf("/d/eastway/guandao%d",1+random(3)));
        	who->delete_temp("maze");
        	who->set("maze/qingling",time());
        }
        message_vision("\n"HIC"霞光一闪，$N"HIC"脚下踉跄的从遁光中现出身形，脸色有点难看。\n\n"NOR,who);
        return 0;
}                       

void init()
{
        mapping long;
        if( userp(this_player()) && mapp(long=query("item_desc")) )
        {
                add_action("do_cmds","",1);
                add_action("do_drop","drop");
                if( !undefinedp(long["guan"]) )
                	add_action("do_push","push");
		if( !undefinedp(long["corpse"]) )
			add_action("do_get","get");
        }
}

int do_drop(string arg)
{
	return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_get(string arg)
{
	int k;
	object silver,guai;
	if( !arg )
		return 0;
	if( sscanf(arg,"all from %s",arg)!=1 )
		return 0;
	if( arg!="bag" )
		return 0;
	if( !query("guai") )
		return err_msg("你什么也没发现。\n");
	if( random(5)>2 )
	{
		guai = new("/d/maze/qingling-2/npc/guai");
		if( guai->move(this_object()) )
		{
			add("guai",-1);
			message_vision("\n"HIR"结果一团阴风刮过，从黑暗中窜出一具呲牙咧嘴的骷髅。\n"NOR,this_player());
			guai->kill_ob(this_player());
			this_player()->fight_ob(guai);
			return 1;
		}
		else
		{
			if( guai ) destruct(guai);
			return err_msg("你什么也没发现。\n");
		}
	}
	else
	{
		add("guai",-1);
		silver = new("/obj/money/silver");
		k = 20+random(100);
		silver->set_amount(k);
		if( !silver->move(this_player()) )
			silver->move(this_object());
		message_vision(HIC"$N"HIC"从储物袋中翻出了"+chinese_number(k)+"两白银。\n"NOR,this_player());
		return 1;	
	}
}

int do_push(string arg)
{
	int k,j,i=0;
	object guai;
	if( !arg || (arg!="guan"&&arg!="棺材") )
		return 0;
	if( !query("guai") )
		return err_msg("你推了推棺材，结果什么也没发现。\n");
	k = 1+random(2);		
	if( k>query("guai") )
		k = query("guai");
	j = k;	
	message_vision(HIC"$N"HIC"上前抵住棺材盖，使劲推了几推。\n"NOR,this_player());
	message_vision(HIR"棺材发出一阵”吱吱“让人牙酸的响声，被打开了。\n"NOR,this_player());
	while(k--)
	{
		guai = new("/d/maze/qingling-2/npc/guai");
		if( guai->move(this_object()) )
		{
			i++;
			add("guai",-1);
			guai->kill_ob(this_player());
			this_player()->fight_ob(guai);
		}
		else
		{
			if( guai ) destruct(guai);
		}
	}
	if( i==0 )
		message_vision("\n结果什么反应没有。\n",this_player());
	else	message_vision("\n"HIB"结果一团阴风刮过，从棺材里窜出"+chinese_number(j)+"具呲牙咧嘴的骷髅。\n"NOR,this_player());
	return 1;
}		

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "zhenshens","huhuan","recall","move","maphere","map",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}


int valid_leave(object who,string dir)
{
        if( !userp(who) )
                return ::valid_leave(who,dir);
        if( who->is_fighting() )
                return notify_fail("你现在正忙着呢。\n");
        if( query("guai")>0 )
        {
        	if( random(10)>2
        	 && ( query("item_desc/corpse")||query("item_desc/guan")) )
        		return notify_fail("深处好似传来一阵异响，你警惕的停住了脚步。\n");
        }
	return ::valid_leave(who,dir);
}
