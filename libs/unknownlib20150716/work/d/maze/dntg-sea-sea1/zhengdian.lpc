//modified by bear
inherit ROOM;
#include <ansi.h>

void release()
{
	int i;
        object *inv;
        remove_call_out("release");
	if( !clonep(this_object()) )
		return;
	inv = all_inventory();
        for(i=sizeof(inv)-1; i>=0; i--)
	{
        	if( userp(inv[i]) )
        	{
        		tell_object(inv[i],HIG"\n一道碧浪平地卷起，你脚下一个不稳，顺水连绵而去。。。。\n\n"NOR);
        		inv[i]->move(sprintf("/d/sea/maze%d",random(10)));
        		message_vision(HIR"\n$N"HIR"被波浪卷入了海底莽林！\n\n"NOR,inv[i]);
        	}
        	else
        	{
        		inv[i]->move(__DIR__"empty");
        		REMOVE_D->add_obj(inv[i],1);
        	}
        }
        destruct(this_object());
}

varargs void _release(int v)
{
	if( v<=0 )
		v = 5;
	remove_call_out("release");
	call_out("release",v);
}

void reset()
{
	int i;
        object *inv;
        if( !query("init_place") )
        {
        	set("init_place",1);
        	::reset();
        	return;
        }
        inv = all_inventory();
        for(i=sizeof(inv)-1; i>=0; i--)
	{
        	if(inv[i]->is_character()) 
        		continue;
		if(inv[i]->query("no_get")) 
			continue;
		if(inv[i]->is_corpse()) 
			continue;
        	destruct(inv[i]);
        }
}

void create ()
{
	set ("short", "龙宫正殿");
	set ("long", @LONG
正殿之上悬一明珠，把诺大一殿照得通亮。两旁桌椅玉石打造而成，　　
当中还嵌着无数珠宝。两边墙上挂了两幅画，看起来相当的陈旧。　　　
    如今大殿之内殿门紧闭，如临大敌。
LONG);
	set("objects", ([
  		__DIR__"npc/longwang" : 1,
	]));
	set("alternative_die",1);
	set("no_fight",1);
	set("no_magic",1);
        set("no_huicheng",1);
        set("no_chuqiao",1);   
        set("init_guai",1);
	set("no_bagua",1);
	set("no_qiankun",1);
	setup();
        remove_call_out("release");
        call_out("release",3600);
}
