// gate.c
#include <ansi.h>
inherit "/d/maze/dntg-sea-sea1/room.lpc";

void release() {
  int i;
  object *inv;
  remove_call_out("release");
  if (!clonep(this_object()))
    return;
  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (userp(inv[i])) {
      tell_object(inv[i], HIG "\n一道碧浪平地卷起，你脚下一个不稳，顺水连绵而去。。。。\n\n" NOR);
      inv[i]->move(sprintf("/d/sea/maze%d", random(10)));
      message_vision(HIR "\n$N" HIR "被波浪卷入了海底莽林！\n\n" NOR, inv[i]);
    } else {
      inv[i]->move(__DIR__ "empty");
      REMOVE_D->add_obj(inv[i], 1);
    }
  }
  destruct(this_object());
}

void reset() {
  int i;
  object *inv;
  if (!query("init_place")) {
    set("init_place", 1);
    ::reset();
    return;
  }
  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (inv[i]->is_character())
      continue;
    if (inv[i]->query("no_get"))
      continue;
    if (inv[i]->is_corpse())
      continue;
    destruct(inv[i]);
  }
}

void create() {
  set("short", "龙宫大门");
  set("long", @LONG
嵌在宫殿各处的珍宝发出的光芒耀得你连眼睛都睁不开了。依稀看　　　
到宫门上方挂这一幅方匾，上有＂东海龙宫＂四个大字。几名虾兵　　　
蟹将分列两旁，警惕的盯着来往的人。
LONG);
  set("alternative_die", 1);
  set("no_huicheng", 1);
  set("no_chuqiao", 1);
  set("init_guai", 1);
  set("no_bagua", 1);
  set("no_qiankun", 1);

  set("exits", ([
    "east": __FILE__,
  ]));
  set("objects", ([
    __DIR__ "npc/lishi": 2,
  ]));
  set("water", 1);
  set("item_desc", ([
    "east": @LONG
嵌在宫殿各处的珍宝发出的光芒耀得你连眼睛都睁不开了。依稀看　　　
到宫门上方挂这一幅方匾，上有＂东海龙宫＂四个大字。几名虾兵　　　
蟹将分列两旁，警惕的盯着来往的人。
LONG,
  ]));
  setup();
  remove_call_out("release");
  call_out("release", 3600);
}

int valid_leave(object who, string dir) {
  object room, ls;
  if (!userp(who) || dir != "east")
    return ::valid_leave(who, dir);
  if (objectp(ls = present("li shi", this_object()))
    && !userp(ls))
    return notify_fail("宫前护卫伸手挡住了你的去路。\n");
  if (who->query("dntg/donghai") == "done"
    || who->query("dntg/huaguo") != "done") {
    who->move("/d/sea/inside1");
    remove_call_out("release");
    call_out("release", 3);
    return 2;
  }
  room = clone_object(__DIR__ "zhengdian.lpc");
  if (who->move(room)) {
    remove_call_out("release");
    call_out("release", 3);
    return 2;
  } else return notify_fail("你身心疲惫，停住了脚步。\n");
}
