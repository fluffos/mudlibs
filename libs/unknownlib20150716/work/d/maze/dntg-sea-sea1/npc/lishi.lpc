#include <ansi.h>
inherit SUPER_NPC;

string *first_name = ({ "青鳝", "赤鲤", "黄鲳", "白鲨", "紫鲭", "金鳌",
"银蛎", "乌鳅"});

string *name_words = ({ "力士"});

void create()
{
	int i;
	object ob;
	string name,*files;
	name = first_name[random(sizeof(first_name))];
	name += name_words[random(sizeof(name_words))];

	set_name(name, ({"li shi", "shi"}));
       	set_level(79);
       	set("no_sleep",1);
       	set("gender", "男性");
       	create_family("东海龙宫",4,"");	
	set("title",HIY"宫前护卫"NOR);
	set("age", 20+random(5));
	set("per", 20);
       	set("attitude", "heroism");

       	set_skill("parry",790);
       	set_skill("dodge",790);
       	set_skill("fork",790);
       	set_skill("hammer",790);
       	set_skill("unarmed",790);
       	set_skill("dragonfight",790);
       	set_skill("force",790);
       	set_skill("spells",790);
       	set_skill("fengbo-cha",790);
	set_skill("dragonforce",790);
	set_skill("dragonstep",790);
	set_skill("seashentong",790);
	set_skill("huntian-hammer",790);
	map_skill("parry","fengbo-cha");
	map_skill("unarmed","dragonfight");
	map_skill("fork","fengbo-cha");
	map_skill("hammer","huntian-hammer");
	map_skill("force","dragonforce");
	map_skill("spells","seashentong");
	map_skill("dodge","dragonstep");
       	set("force_factor",250);
	set("mana_factor",300);
	set_temp("armor_level",79);
	set_temp("weapon_level",79);
	set("env/test","HIR");
	setup();
	files = ({
		"armor","cloth","kui","shoes","pifeng","shield","waist",
	});
	for(i=0;i<sizeof(files);i++)
	{
		if( objectp(ob=carry_object(0,files[i],1)) )
		{
			ob->set("armor_title","水晶宫");
			ob->wear();
		}
	}
	if( random(2) )
	{
		if( objectp(ob=carry_object(0,"fork",1)) )
		{
			map_skill("parry","fengbo-cha");
			ob->set("weapon_title","水晶宫");
			ob->wield();
		}
	}
	else if( random(2) )
	{
		if( objectp(ob=carry_object(0,"unarmed",1)) )
		{
			map_skill("parry","dragonfight");
			ob->set("weapon_title","水晶宫");
			ob->wield();
		}
	}
	else
	{
		if( objectp(ob=carry_object(0,"hammer",1)) )
		{
			map_skill("parry","huntian-hammer");
			ob->set("weapon_title","水晶宫");
			ob->wield();
		}
	}
	add_temp("apply/combat_damage",1500);
	add_temp("apply/combat_def",2000);
	powerup(0,1);
}
  	
void die()
{
	if( environment() )
	{
		message("vision",HIR"\n"+name()+HIR"脸色大变，大叫一声：妖贼休要猖狂，待俺禀告龙王！\n"NOR,environment());
		message("vision",HIG+name()+HIG"脚下波涛卷起，顿时化作一道巨浪飞快卷去。。。。\n\n"NOR,environment());
	}	
	destruct(this_object());
}

void unconcious(){die();}