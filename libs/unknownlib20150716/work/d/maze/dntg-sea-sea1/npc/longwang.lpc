#include <ansi.h>
inherit SUPER_NPC;

void _dntg(object who);

void create() {
  set_name("敖广", ({ "ao guang", "ao", "guang", "longwang", "wang" }));
  set_level(170);
  set("long", "敖广是东海的龙王，其兄弟分别掌管东，西，南，北四海。
由余其水族众多，声势浩大，俨然独霸一方。\n");
  create_family("东海龙宫", 1, "水族");
  set("gender", "男性");
  set("age", 66);
  set("title", HIY "东海龙王" NOR);
  set("class", "dragon");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("rank_info/respect", "陛下");
  set("per", 20);
  set("force_factor", 120);
  set("mana_factor", 140);

  set_skill("huntian-hammer", 1700);
  set_skill("hammer", 1700);
  set_skill("literate", 1700);
  set_skill("unarmed", 1700);
  set_skill("dodge", 1700);
  set_skill("force", 1700);
  set_skill("parry", 1700);
  set_skill("fork", 1700);
  set_skill("spells", 1700);
  set_skill("seashentong", 1700);
  set_skill("dragonfight", 1700);
  set_skill("dragonforce", 1700);
  set_skill("fengbo-cha", 1700);
  set_skill("dragonstep", 1700);
  map_skill("hammer", "huntian-hammer");
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  set_skill("zhidi-chenggang", 1700);
  set_skill("danshan", 1700);
  set_skill("qiyu", 1700);
  set_skill("duanliu", 1700);
  set_skill("jiefeng", 1700);
  set_skill("huanyu-hufeng", 1700);
  setup();
  carry_object("/d/sea/obj/longpao")->wear();
  powerup(0, 1);
}

void die() {
  object who = query_temp("last_damage_from");
  if (environment()) {
    command("chat* pei");
    if (who)
      CHANNEL_D->do_channel(this_object(), "chat", who->name() + "闹我东海，待老夫携状纸，告上天庭！");
    message("vision", "\n\n" + name() + "将身一摇，化作八丈五爪金龙，腾云驾雾直向南天门而去。\n\n", environment());
  }
  destruct(this_object());
}

void init() {
  if (userp(this_player())
    && environment()->query("init_place"))
    _dntg(this_player());
  add_action("do_nocmds", ({ "exert", "eat", }));
}

int do_nocmds(string arg) {
  if (!arg)
    return 0;
  write(HIC "\n老龙王说道：切磋之中，小动作不好吧。\n" NOR);
  return 1;
}

void clean_room() {
  object *inv;
  string name, name2;
  int i;

  name = name2 = "";
  inv = all_inventory(environment());
  for (i = 0; i < sizeof(inv); i++) {
    if (!inv[i]->is_character()) {
      if (name2 != "")
        name2 += "、";
      name2 += inv[i]->query("name");
      inv[i]->move("/d/maze/dntg-sea-sea1/empty");
      REMOVE_D->add_obj(inv[i], 1);
    } else if (inv[i] == this_object())
      continue;
    else if (userp(inv[i]))
      continue;
    else {
      if (name != "")
        name += "、";
      name += inv[i]->name();
      inv[i]->move("/d/maze/dntg-sea-sea1/empty");
      REMOVE_D->add_obj(inv[i], 1);
    }
  }
  if (name != "") {
    message_vision(HIR "\n$N" HIR "老脸一沉：无干人等，皆数回避！\n" NOR, this_object());
    if (name2 != "")
      name2 = CYN "将" + name2 + CYN "等一阵拾掇，" NOR;
    message_vision(CYN "堂下" + name + CYN "等" + name2 + CYN "划着水，游走了。。。。\n\n" NOR, this_object());
  }
}

void give_weapon1(object who) {
  object npc;
  remove_call_out("start_story");
  remove_call_out("give_weapon1");
  remove_call_out("give_weapon2");
  remove_call_out("give_weapon3");
  if (!environment() || !environment()->query("init_place"))
    return;
  if (!who || !living(who)
    || !present(who, environment())) {
    environment()->_release(1 + random(3));
    return;
  }
  clean_room();
  message_vision(HIC "\n老龙王朝下吩咐道：" HIR "鳜都司" HIC "，取那一千八百斤重的" HIY "寒铁大捍刀" HIC "来！\n" NOR, who);
  npc = new(__DIR__ "weapon1");
  if (!npc->information(who)) {
    message_vision(HIR "\n老龙王勃然大怒：岂有此理！\n\n" NOR, this_object());
    npc->move("/d/maze/dntg-sea-sea1/empty");
    REMOVE_D->add_obj(npc, 1);
    environment()->_release(1 + random(3));
    return;
  }
  message_vision(
    HIY "$N" HIY "哈哈一笑：这位" + RANK_D->query_respect(who) + "，请试试武器合不合手。\n" NOR,
    this_object()
  );
  npc->show_msg(who);
}

