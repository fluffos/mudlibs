void go_haizang3(object who) {
  remove_call_out("go_haizang3");
  if (!environment() || !environment()->query("init_place"))
    return;
  environment()->_release(10);
  if (!who || !living(who)
    || !present(who, environment()))
    return;
  who->delete_temp("maze");
  who->dismiss_team();
  if (MAZE_D->enter_maze(who, "dntg-sea-sea2")) {
    tell_object(who, HIR "你跟随老龙王来到了海底宝藏！\n" NOR);
    tell_object(who, HBBLU "龙婆(Long po)告诉你：妾身有言，只要找到迷宫出口，即能寻得宝藏。" NOR "\n");
    return;
  }
  message_vision(CYN "$N" CYN "说道：时候未到，时候未到。\n" NOR, this_object());
}

void go_haizang2(object who) {
  remove_call_out("start_story");
  remove_call_out("give_weapon1");
  remove_call_out("give_weapon2");
  remove_call_out("give_weapon3");
  remove_call_out("go_haizang");
  remove_call_out("go_haizang2");
  if (!environment() || !environment()->query("init_place"))
    return;
  if (!who || !living(who)
    || !present(who, environment())) {
    environment()->_release(1 + random(3));
    return;
  }
  message_vision(
    HIY "\n正说处，后面闪过龙婆、龙女道：大王，观看这位" + RANK_D->query_respect(who) + "，决非小可。我们这海藏中那一块天河定底的神珍铁，这几日霞光艳艳，瑞气腾腾，敢莫是该出现遇其也？\n" NOR,
    who
  );
  message_vision(CYN "$N" CYN "说道：那是大禹治水之时，定江海浅深的一个定子，是一块神铁，能中何用？\n" NOR, this_object());
  message_vision(CYN "龙婆说道：且送与这位" + RANK_D->query_respect(who) + "，凭之改造便了。\n" NOR, who);
  EMOTE_D->do_emote(this_object(), "think", 0, CYN, 0, 0, 0);
  EMOTE_D->do_emote(this_object(), "ok", geteuid(who), CYN, 0, 0, 0);
  message_vision(CYN "$N" CYN "说道：拿出来我看。\n" NOR, who);
  message_vision("龙王摇手道：“扛不动，抬不动！须亲去看看。来来来，且随我去也。\n", who);
  remove_call_out("go_haizang3");
  call_out("go_haizang3", 2 + random(4), who);
}

void go_haizang(object who) {
  remove_call_out("start_story");
  remove_call_out("give_weapon1");
  remove_call_out("give_weapon2");
  remove_call_out("give_weapon3");
  remove_call_out("go_haizang");
  if (!environment() || !environment()->query("init_place"))
    return;
  if (!who || !living(who)
    || !present(who, environment())) {
    environment()->_release(1 + random(3));
    return;
  }
  clean_room();
  message_vision(
    CYN "$N" CYN "说道：这位" + RANK_D->query_respect(who) + "，我宫中只有这根戟重，再没什么兵器了。\n" NOR,
    this_object()
  );
  message_vision("$N笑道：“古人云，愁海龙王没宝哩！你再去寻寻看。若有可意的，一一奉价。\n", who);
  EMOTE_D->do_emote(this_object(), "hmm", geteuid(who), CYN, 0, 0, 0);
  message_vision(CYN "$N" CYN "说道：委的再无。\n" NOR, this_object());
  remove_call_out("go_haizang2");
  call_out("go_haizang2", 2 + random(4), who);
}
/*
step : 1 hi
step : 2 why
step : 3 weapon1
step : 4 weapon2
step : 5 weapon3
step : 6 haizang
step : 7 jgb
*/
void start_story(object who, int step) {
  string arg;
  remove_call_out("start_story");
  remove_call_out("give_weapon1");
  remove_call_out("give_weapon2");
  remove_call_out("give_weapon3");
  if (!environment() || !environment()->query("init_place"))
    return;
  if (!who || !living(who)
    || !present(who, environment())
    || step < 1 || step > 7) {
    environment()->_release(1 + random(3));
    return;
  }
  switch (step) {
    case 1:
      EMOTE_D->do_emote(this_object(), "ah", geteuid(who), CYN, 0, 0, 0);
      message_vision(HIY "\n东海龙王敖广与龙子龙孙、虾兵蟹将即忙迎道：“上仙请进，请进！”\n\n" NOR, who);
      remove_call_out("start_story");
      call_out("start_story", 2 + random(3), who, step + 1);
      return;
    case 2:
      message_vision(CYN "\n$N" CYN "说道：来呀，上茶！\n" NOR, this_object());
      message_vision("宾主各自落座，$N问道：“上仙几时得道，授何仙术？”\n" NOR, this_object());
      if (!stringp(arg = who->query("family/family_name")))
        arg = "散修";
      else if (arg == "东海龙宫")
        arg = "宫内";
      else;
      message_vision(
        CYN "$N" CYN "说道：我自懂长生之道，便为" + arg + "修行，欲得一个无生无灭之体。近因教演儿孙，守护山洞，奈何没件兵器。久闻贤邻享乐瑶宫贝阙，必有多余神器，特来告求一件。\n" NOR,
        who
      );
      if (who->query("dntg/donghai") == "sea")
        who->set("dntg/donghai", "weapon1");
      remove_call_out("start_story");
      call_out("start_story", 2 + random(3), who, step + 1);
      return;
    case 3:
      EMOTE_D->do_emote(this_object(), "hmm", 0, CYN, 0, 0, 0);
      call_out("give_weapon1", 2 + random(5), who);
      return;
    case 4:
      EMOTE_D->do_emote(this_object(), "hmm", 0, CYN, 0, 0, 0);
      call_out("give_weapon2", 2 + random(5), who);
      return;
    case 5:
      EMOTE_D->do_emote(this_object(), "hmm", 0, CYN, 0, 0, 0);
      call_out("give_weapon3", 2 + random(5), who);
      return;
    case 6:
      EMOTE_D->do_emote(this_object(), "sweat", 0, CYN, 0, 0, 0);
      call_out("go_haizang", 2 + random(5), who);
      return;
    default:
      EMOTE_D->do_emote(this_object(), "wuwu", 0, CYN, 0, 0, 0);
      call_out("get_jgb", 2 + random(5), who);
      return;
  }
}

void _dntg(object who) {
  if (!who || !living(who)) {
    environment()->_release();
    return;
  }
  if (who->query("dntg/donghai") == "done") {
    EMOTE_D->do_emote(this_object(), "pei", geteuid(who), CYN, 0, 0, 0);
    message_vision(CYN "$N" CYN "说道：汝已拿走我定海神铁，为何今日又来扰我！！送客！！\n" NOR, this_object());
    environment()->_release(1 + random(3));
    return;
  }
  if (who->query("dntg/huaguo") != "done") {
    EMOTE_D->do_emote(this_object(), "pei", geteuid(who), CYN, 0, 0, 0);
    message_vision(CYN "$N" CYN "说道：大胆！东海水晶宫岂是你能来的？！\n" NOR, this_object());
    environment()->_release(1 + random(3));
    return;
  }
  switch (who->query("dntg/donghai")) {
    case "sea":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 1);
      return;
    case "weapon1":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 3);
      return;
    case "weapon2":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 4);
      return;
    case "weapon3":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 5);
      return;
    case "haizang":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 6);
      return;
    case "jgb":
      remove_call_out("start_story");
      call_out("start_story", 1, who, 7);
      return;
    default:
      EMOTE_D->do_emote(this_object(), "pei", geteuid(who), CYN, 0, 0, 0);
      message_vision(CYN "$N" CYN "说道：大胆！东海水晶宫岂是你能来的？！\n" NOR, this_object());
      environment()->_release(1 + random(3));
      return;
  }
}
