#include <ansi.h>
inherit "/d/maze/dntg-sea-sea1/room.lpc";

void create() 
{ 
	set("short", "海底"); 
        set("channel_id","水晶宫");
        set("long", @LONG
前方隐约现出一座宫殿，发出一道道五颜六色的光芒。这里的鱼儿
也特别多，还有许多奇形怪状的海怪。一行行，一列列，宛如臣子
拜见皇帝一般。
LONG );
        set("virtual_room", 1); 
        set("alternative_die",1);
        set("no_huicheng",1);
        set("no_chuqiao",1);   
        set("init_guai",1);
        set("exits", ([
                "up" : __FILE__,
        ]));
        set("item_desc",([
                "up" : @LONG
前方隐约现出一座宫殿，发出一道道五颜六色的光芒。这里的鱼儿
也特别多，还有许多奇形怪状的海怪。一行行，一列列，宛如臣子
拜见皇帝一般。
LONG,  
	]));    
        setup();
}

int valid_leave(object who,string dir)
{
	object room;
	if( !userp(who) || dir!="up" )
		return ::valid_leave(who,dir);
	if( who->query("gin")<25 )
		return notify_fail("你的活力不足25点。\n");		
	who->delete_temp("maze");
	who->dismiss_team();
	room = clone_object("/d/maze/dntg-sea-sea1/gate");
	who->move(room);
	return 2;
}