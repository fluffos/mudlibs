#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup() {}

int query_amount() { return amount; }

private void destruct_me() {
  remove_call_out("destruct_me");
  destruct(this_object());
}

void set_amount(int v) {
  object dest;

  if (v <= 0) {
    amount = 0;
    call_out("destruct_me", 1);
    return;
  } else {
    amount = v;
    this_object()->set_weight(v);
  }
}

void add_amount(int v) { set_amount(amount + v); }

string short() {
  string id;
  if (!stringp(id = query("owner_id")))
    id = "";
  else id = "[" + id + "]";
  return chinese_number(query_amount()) + query("base_unit") + ::short() + id;
}

varargs int move(mixed dest, int silent) {
  object env, *inv;
  int i, total, total0, result;
  string file;

  result = ::move(dest, silent);
  if (env = environment()) {
    file = base_name(this_object());
    inv = all_inventory(env);
    total = (int)query_amount();
    total0 = total;
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == this_object())
        continue;
      if (base_name(inv[i]) == file) {
        if (inv[i]->query("owner_id")
          && query("owner_id") != inv[i]->query("owner_id"))
          continue;
        set("owner_id", inv[i]->query("owner_id"));
        total += (int)inv[i]->query_amount();
        destruct(inv[i]);
      }
    }
    if (total != total0)
      set_amount(total);
  }
  return result;
}

void init() {
  if (!query("owner_id") && environment() && userp(environment()))
    set("owner_id", environment()->query("id"));
  add_action("do_eat", "eat");
}

void create() {
  set_name("步天丹", ({ "butian dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "粒");
    set("unit", "些");
    set(
      "long",
      HIG "秦始皇一统天下后，曾派方士遍寻四海，寻找\n长生不老的仙丹，这其间倒也找到些灵丹妙药。\n" HIM "当人物等级" HIY "59" HIM "且武学经验达到" HIY "529000000" HIM "时，服\n用此丹，将能触发60级突破副本【" HIC "再入仙山" HIM "】。" NOR "\n"
    );
    set("no_sell", "这么珍贵的灵丹你也舍得卖？！\n");
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  int k, i;
  mixed *rooms;
  object room, me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!present(this_object(), me))
    return notify_fail("这不是你的。\n");
  if (!wizardp(me)) {
    if (me->query_level() < 59
      || me->query("combat_exp") < 529000000)
      return err_msg("你现在吃这个没有用。\n");
  }
  if (environment(me)->query("virtual_room"))
    return err_msg("步天丹不能再副本中服用。\n");

  message_vision("$N吃下一粒$n。\n", me, this_object());
  if (!query("owner_id") || query("owner_id") != me->query("id")) {
    write("结果什么反应也没有。\n");
    if (query_amount() <= 1)
      destruct(this_object());
    else add_amount(-1);
    return 1;
  }
  if (pointerp(rooms = me->query_temp("now_bagua"))
    && sizeof(rooms) > 1)
    ("/d/maze/tupo60/room.lpc")->remove_all_rooms(rooms);
  me->delete_temp("now_bagua");

  if (objectp(room = me->query_temp("last_bagua_start")))
    ("/d/maze/tupo60/room.lpc")->remove_all_rooms(({ room }));
  me->delete_temp("last_bagua_start");

  room = new("/d/maze/tupo60/room");
  me->set_temp("last_bagua_start", room);
  me->set_temp("last_bagua_from", environment(me));

  message("vision", HIC "\n霞光一闪，" + me->name() + HIC "被一道祥云卷走了。\n\n" NOR, environment(me), me);
  write(HIC "霞光一闪，你眼前景色一变。\n" NOR);
  me->move(room, 2);

  if (query_amount() <= 1)
    destruct(this_object());
  else add_amount(-1);
  return 1;
}
