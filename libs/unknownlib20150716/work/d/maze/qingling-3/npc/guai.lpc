			set_skill("lunhui-zhang",i*10);
			map_skill("staff", "lunhui-zhang");
        		map_skill("parry", "lunhui-zhang");
		}
		else
		{
			weapon = "blade";
			set_skill("cibeidao",i*10);
			map_skill("blade", "cibeidao");
        		map_skill("parry", "cibeidao");
        	}	
        }
        else if( random(2) )
        {
        	create_family("蜀山派",3,"");
        	weapon = "sword";
		set_skill("xianfeng-yunti",i*10);
        	set_skill("zuixian-wangyue",i*10);
        	set_skill("chuanyun-zhang",i*10);
        	set_skill("yujianshu",i*10);
        	set_skill("tianshi-fufa",i*10);
        	map_skill("spells", "tianshi-fufa");
        	map_skill("dodge", "zuixian-wangyue");
        	map_skill("force", "xianfeng-yunti");
        	map_skill("parry", "yujianshu");
        	map_skill("sword", "yujianshu");
        	map_skill("unarmed", "chuanyun-zhang");
		if( random(10)==0 )
        		set_skill("tundao",i*5);
        	if( random(10)==0 )
        		set_skill("yufeng",i*5);
        	if( random(10)==0 )
        		set_skill("jiee",i*5);
        	if( random(10)==0 )
        		set_skill("fushui",i*5);	
        	if( random(10)==0 )
        		set_skill("jiameng",i*5);        	
        }
        else
        {
        	create_family("陷空山无底洞",3,"");
        	if( random(2) )
        	{
        		set_skill("kugu-blade",i*10);
        		map_skill("parry", "kugu-blade");
        		map_skill("blade", "kugu-blade");
