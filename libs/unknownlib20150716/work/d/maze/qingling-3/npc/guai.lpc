void reward_player(object who,object pl)
{
        string arg,file,*dir,*env,color;
        object ob,weapon;
        int i,succ,k;
        
        if( !pl || !living(pl) || !pl->query_temp("maze/qinling3")||!userp(pl) )
                return;
        if( pl->query_level()<50 )
        {
                if( random(100)>30 && !wizardp(pl) )
                        return;
        }               
        arg = "";
        succ = pl->query_kar();
        if( pl->query_level()<50 )
                succ = random(20)+1;            
        if( who==pl )
                succ = succ*2;
        if( !arrayp(env=pl->query_temp("maze/equip_color")) )
		env = 0;        
	if( random(succ/10)>5 )
	{                
         	dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",
        	});
        	file = dir[random(sizeof(dir))];
               	if( file )
               	{
                       	dir-=({file});
                        ob = new("/d/obj/narmor/"+file);
       	                if( random(100)>95 )
       	                	set("env/test",({"HIM","HIR"})[random(2)]);
       	                else	set("env/test",({"HIR","HIB","HIB","HIB","HIC","HIY",})[random(6)]);  
                       	ob->init_armor(this_object());
                       	if( stringp(color=ob->query("armor_color"))
                       	 && env && member_array(color,env)==-1 )
			{
                        	tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                                destruct(ob);
                       	}
                        else if( !ob->move(pl) )
       	                {
               	                destruct(ob);
                       	        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                       	}
                        else    
       	                {
               	                //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                       	        arg+= obj_name(ob);
                               	if( i!=0 && arg!="" )
                                       	arg+= "、";
                       	}
		}
        }
        
        succ = random(pl->query_kar())/10;
        if( succ>6 )
        {
        	dir = ({"axe","blade","blade","hammer","mace","spear","staff","stick","sword","unarmed","whip","fork","dagger",});
        	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/nweapon/"+file);
                if( random(100)>95 )
			set("env/test",({"HIM","HIR"})[random(2)]);
                else	set("env/test",({"HIR","HIB","HIB","HIB","HIC","HIY",})[random(6)]);  
                ob->init_weapon(this_object());
                if( stringp(color=ob->query("weapon_color"))
                 && env && member_array(color,env)==-1 )
		{
                	tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        destruct(ob);
                }        
                else if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                        	arg+= "、";
                        arg+= obj_name(ob);
                }
        }
        
	file = sprintf("/d/maze/qingling-3/obj/sp%d",1+random(5));
        ob = new(file);
        ob->set("owner_id",pl->query("id"));
        if( !ob->move(pl) )
        {
        	destruct(ob);
                tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
	}
        else    
        {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
        	if( arg!="" )
                	arg+= "、";
		arg+= obj_name(ob);
        }        
        
        succ = random(pl->query_kar());
        if( random(succ)>5 )
        {
                file = ("/d/maze/qingling-3/obj/life");
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                        	arg+= "、";
                        arg+= obj_name(ob);
                }
        }

        succ = random(pl->query_kar());
        if( succ>8 )
        {
                ob = new("/d/maze/qingling-3/obj/bangding.lpc");
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                //else    tell_object(pl,HIY"【副本】始皇陵三层：你得到了一块"HIG"绑定用的灵石"HIY"。\n"NOR);
        	if( arg!="" )
			arg+= "、";
                arg+= "一块绑定石";
        }
                
	k = 20000+random(30000);
	pl->add("combat_exp",k);
	if( arg!="" )
        	arg+= "、";
	arg+= k+"点武学经验";
	//tell_object(pl,HIY"【副本】始皇陵三层：你得到了"HIR+k+HIY"点武学经验。\n"NOR);
	pl->add_temp("maze/bing_kill",1);                
        if( objectp(pl->query_leader()) && arg!="" )
                pl->team_talk(pl->name(1)+"得到了"+arg+HIW"。"NOR);
	else	tell_object(pl,HIG"【系统】你得到了"+arg+HIG"。"NOR"\n");                
}

void reward_ob(object who)
{
        object leader,*t,*py;
        int i;
	string str;
	
        if( !who || !userp(who) || !present(who,environment()) 
         || !who->query_temp("maze/qinling3") )
        {
                message_vision (HIR"\n$N"HIR"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"碎土"NOR HIR"。\n\n"NOR,this_object());
                destruct(this_object());
                return;
        }
        message_vision (HIC"\n$N"HIC"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"碎土"NOR HIC"。\n\n"NOR,this_object());
	if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }        
        py = ({});
        if( !objectp(leader=who->query_leader()) )
        	py = ({who});
        else	
        {
        	if( !pointerp(t=leader->query_team()) )
        		py = ({who});
        	else
        	{
        		for(i=0;i<sizeof(t);i++)
        		{
        			if( t[i] && living(t[i]) && present(t[i],environment()) )
        				py+= ({t[i]});
        		}
        	}	
        }
        for(i=0;i<sizeof(py);i++)	
        	reward_player(who,py[i]);
        destruct(this_object());	
}