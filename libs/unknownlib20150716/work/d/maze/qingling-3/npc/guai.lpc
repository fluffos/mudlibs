#include <ansi.h> 
#include <combat.h> 
inherit SUPER_NPC;
#include "guai.h"

void create()
{
	object ob;
	string weapon,long,*ids,id,*names,name;
        int i;
        
        names = ({
		"破阵","pozhen","前军","qianjun","后军","houjun",
		"中军","zhongjun","箭兵","jianbing","骑兵","qibing",
		"重甲","zhongjia","轻甲","qingjia","发令","faling",
		"伺候","cihou","巡逻","xunluo","镇守","zhenshou",        	
        	"突击","tuji","夜守","yeshou","巡营","xunying",
        });
        i = random(sizeof(names))/2*2;
        set("names",names[i]);
        name = names[i]+"兵俑";
        id = names[i+1];
        ids = ({id+" bingyong","bing yong","yong",id});
        set_name(name,ids);

        set("gender","男性");
        set("age",(17+random(20))*10);
        set("per",1);
	set("attitude", "aggressive");
        set("bellicosity",500);
        long = "这是始皇陵中的兵俑。相传是秦始皇为保护自己肉身，遍遣天下方士，以极阴之地阴土配合活人士兵炼制的陶俑。\n";
        long = sort_string(long,76,0);
        set("long",HIM+long+NOR); 
        i = 50+random(10);
        set_level(i);
        set_skill("unarmed",i*10);
        set_skill("dodge",i*10);
        set_skill("parry",i*10);
        set_skill("stealing",i*10);
        set_skill("throwing",i*10);
        set_skill("spells",i*10);
        set_skill("force",i*10);
        set_skill("sword",i*10);
        set_skill("blade",i*10);
        set_skill("literate",i*10);
        set_skill("whip",i*10);
        set_skill("spear",i*10);
        set_skill("axe",i*10);
        set_skill("fork",i*10);
        set_skill("hammer",i*10);
        set_skill("staff",i*10);
        set_skill("stick",i*10);
        
        set("rank_info",([
		"self"    : "本将爷",
		"respect" : "兵爷",
		"rude"    : "你这泥糊的",
	]));
	
        if( random(2) )
        {
        	create_family("大雪山",3,"");
        	if( random(10)==0 )
        		set_skill("qisi-huisheng",i*5);	
        	if( random(10)==0 )
        		set_skill("qushen",i*5);	
        	if( random(10)==0 )
        		set_skill("jiuxi-fuqi",i*5);	
        	if( random(10)==0 )
        		set_skill("huitian-fanri",i*5);	
        		
        	if( random(2) )
        	{
        		set_skill("bingpo-blade",i*10);
			map_skill("blade", "bingpo-blade");
        		map_skill("parry", "bingpo-blade");
        		weapon = "blade";
        	}
        	else
