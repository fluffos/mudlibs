        	if( random(10)==0 )
        		set_skill("jingang-zhenshen",i*5);	
        	if( random(10)==0 )
        		set_skill("liuli-xindeng",i*5);	
        	if( random(10)==0 )
        		set_skill("longxiang-li",i*5);	
        	if( random(10)==0 )
