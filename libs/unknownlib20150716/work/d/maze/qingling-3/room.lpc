#include <ansi.h>
inherit ROOM;
    
void create()
{
        set("short","始皇陵三层副本");
        set("channel_id","始皇陵三层副本");
        set("alternative_die",1);
        set("item_desc",([
                "west" : "这里黑布隆冬的，你看不清楚。\n",
                "east" : "这里黑布隆冬的，你看不清楚。\n",
                "north" : "这里黑布隆冬的，你看不清楚。\n",
                "south" : "这里黑布隆冬的，你看不清楚。\n",
        ]));
        set("objects",([
        	"/d/maze/qingling-3/npc/boss2" : random(2),
        	"/d/maze/qingling-3/npc/guai"  : 1+random(3),
        ]));	
        set("no_team",1);
        setup();
}

mixed alternative_die(object who)
{
        int i,lost;
        object leader,target;
        string file,msg,id;
        if( !who )
                return 0;
        if( !userp(who) )
        {
        	if( !who->is_maze() )
        		return 1;
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,this_object()) )
                        who->reward_ob(target);
                if( who )  destruct(who);
                return 0;                         
        }
        //玩家死亡
        message_vision(NOR"\n($N"RED "受伤过重，已经有如风中残烛，随时都可能断气。"NOR")\n",who);	
        //复活道具
        if( who->query_temp("maze/qinling3_full")>0 )
        {
        	who->add_temp("maze/qinling3_full",-1);
        	message_vision(HIC"$N"HIC"浑身冒起一道霞光，冥冥之中传来一阵朗笑“不是不报，时候未到。”\n"NOR,who);
        	who->powerup(0,1);
		return 0;
	}
        if( objectp(leader=who->query_leader()) )
        	id = leader->query("id");
        else	id = who->query("id");	
        
        who->powerup(0,1);
        if( random(2) )
                msg = COMBAT_D->status_msg((1+random(5))*10);
        else    msg = COMBAT_D->eff_status_msg((1+random(5))*10);
        message_vision(NOR"\n( $N"+msg+NOR")\n",who);
        message_vision("\n"HIC"$N"HIC"顿时脸色一白，慌忙将身祭起一道遁光仓皇逃离。\n"NOR,who);  
        
        lost = 10000;
        lost = lost*9/10+random(lost/10);
        if( who->query("combat_exp")<lost )
                who->set("combat_exp",0);
        else    who->add("combat_exp",-lost);
        tell_object(who,HIR"【副本】始皇陵三层：你临阵脱逃，损失了"HIY+lost+""HIR"点武学经验。"NOR"\n");
        
        lost = 3000;
        lost = lost*9/10+random(lost/10);
        if( who->query("daoxing")<lost )
                who->set("daoxing",0);
        else    who->add("daoxing",-lost);
        tell_object(who,HIR"【副本】始皇陵三层：你临阵脱逃，损失了"HIY+COMBAT_D->chinese_daoxing(lost)+""HIR"道行。"NOR"\n");
        
        lost = 2000;
        lost = lost*9/10+random(lost/10);
        if( who->query("potential")-who->query("learned_points")<lost )
                who->set("potential",who->query("learned_points"));
        else    who->add("potential",-lost);
        tell_object(who,HIR"【副本】始皇陵三层：你临阵脱逃，损失了"HIY+lost+""HIR"点修为潜能。"NOR"\n");
                
        who->set("kee",100);
        who->set("eff_kee",100);
        who->set("sen",100);
        who->set("eff_sen",100);
        who->set("force",0);
        who->set("mana",0);
        
        file = sprintf("/data/maze/%c/%s/qingling-3/enter.lpc",id[0],id);
        if( file_size(file)>0 )
        	who->move(file,2);
        else
        {	
        	who->dismiss();
        	who->move(sprintf("/d/eastway/guandao%d",1+random(3)));
        	who->delete_temp("maze");
        	who->set("maze/qingling",time());
        }
        message_vision("\n"HIC"霞光一闪，$N"HIC"脚下踉跄的从遁光中现出身形，脸色有点难看。\n\n"NOR,who);
        return 0;
}                       

void init()
{
	mapping long = query("item_desc");
        if( userp(this_player()) )
        {
                add_action("do_cmds","",1);
                add_action("do_drop","drop");
        }
}

int do_drop(string arg)
{
	return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "zhenshens","huhuan","recall","move","maphere","map",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}

int valid_leave(object who,string dir)
{
	object *inv,boss,leader,*t,*plays;
	int i,damage,f=0;
	string *catch_hunt_msg,*str1,*str2,str;
	
        if( !userp(who) )
                return ::valid_leave(who,dir);
        if( who->is_fighting() )
                return notify_fail("你现在正忙着呢。\n");
	if( random(who->query_kar())<10 )
	{
		str1 = ({
			"“轰隆”一声巨响","“嘎嘣”一声机括响声","脚下传来一声“嘎嘣”之声",
		});
		str2 = ({
			"角落中闪出一队弓箭兵俑，扬手射出一丛箭雨",
			"石壁之上闪出一把巨斧，一道寒光闪过",
			"两边露出数支圆筒，从中冒出层层烈焰",
			"甬道深处滚出一个巨大的石球，一路碾压了过来",
			"顶壁之上忽然冒出一根根尖石柱，如春雨般纷纷落下",
		});
		str = ({"忽然之间","冷不丁","猛的","忽然"})[random(4)]+str1[random(sizeof(str1))]+"，"+str2[random(sizeof(str2))]+"！\n";
		str+= ({"$N闪避不及，给打了个正着！\n","$N避无可避，只得硬挨了这一下！\n","$N眼看无法躲过，只能吃了这一记！\n",})[random(3)];
		str = ({HIR,HIB,HIY,HIM,})[random(4)]+str+NOR;
		message_vision(str,who);
		damage = who->receive_wound("kee",400+random(500));
		if( damage>2 )
			 message_vision( "( $N" + COMBAT_D->eff_status_msg((int)who->query("eff_kee") * 100/(1+(int)who->query_maxkee()) ) + " )\n", who);
		return 2;
	}
	
	catch_hunt_msg = ({
    		"和你仇人相见份外眼红，立刻打了起来！\n\n" NOR,
    		"对着你大喝：「可恶，又是你！」\n\n" NOR,
    		"和你一碰面，二话不说就打了起来！\n\n" NOR,
    		"一眼瞥见你，「哼」的一声冲了过来！\n\n" NOR,
    		"一见到你，愣了一愣，大叫：「我宰了你！」\n\n" NOR,
    		"喝道：「呔！我们的帐还没算完，看招！」\n\n" NOR,
    		"喝道：「蠹子！看招！」\n\n" NOR,
	});
	inv = all_inventory();
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->is_maze()
		 && !inv[i]->is_fighting() )
		{
			inv[i]->kill_ob(who);
			return notify_fail("\n"HIW+inv[i]->name()+HIW+catch_hunt_msg[random(sizeof(catch_hunt_msg))]);
		}
	}
	return ::valid_leave(who,dir);
}
