#include <ansi.h> 
inherit NPC;

void create()
{
	object ob;
	set_name("白象尊者", ({"baixiang zunzhe", "baixiang", "zunzhe"}));
      	set_level(120);
	set("title", "明王护法");
	set("gender", "男性" );
	set("age", 43);
	set("per", 112);//no rongmao description.
	set("str", 50);
	set("long", "这位白象尊者是有名的大力士。狮驼山二大王，大雪山护法尊者。\n生平最怕的是老鼠，看到尖嘴猴腮的人就讨厌。\n");
	set("class", "yaomo");
	set("attitude", "peaceful");
   	create_family2("大雪山","象族",2, "明王护法");
	
	set_skill("unarmed",1200);
	set_skill("cuixin-zhang",1200);
	set_skill("dodge",1200);
	set_skill("xiaoyaoyou",1200);
	set_skill("parry",1200);
	set_skill("blade", 1200);
	set_skill("bingpo-blade",1200);
	set_skill("throwing",1200);
	set_skill("force",1200);
	set_skill("ningxie-force",1200);
	set_skill("literate",1200);
	set_skill("spells",1200);
	set_skill("dengxian-dafa",1200);
   	
   	map_skill("spells", "dengxian-dafa");
   	map_skill("force", "ningxie-force");
   	map_skill("parry", "cuixin-zhang");
   	map_skill("unarmed", "cuixin-zhang");
   	map_skill("blade", "bingpo-blade");
   	map_skill("dodge", "xiaoyaoyou");

	set_skill("huitian-fanri",1200);
	set_skill("qushen",1200);
	set("force_factor", 160);
	set("mana_factor", 125);

	set("env/test","HIB");
	set_temp("weapon_level",60+random(50));
	set_temp("armor_level",60+random(50));
	
	set("inquiry",([
        	"任务" : "我与那地涌夫人素来不和，此秘境之内，凡遇到无底洞弟子，尽与我杀之！可在我处兑换些(huan)门派称号(list)。\n",
        ]));	
        set("env/test","HIR");
	setup();
	
	ob = carry_object(0,"armor",1);
	("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
	ob->delete("armor_title");
	ob->wear();
	
	ob = carry_object(0,"cloth",1);
	("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
	ob->delete("armor_title");
	ob->wear();
	
	ob = carry_object(0,"shoes",1);
	("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
	ob->delete("armor_title");
	ob->wear();
	
	ob = carry_object(0,"pifeng",1);
	("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
	ob->delete("armor_title");
	ob->wear();
	
	ob = carry_object(0,"kui",1);
	("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
	ob->delete("armor_title");
	ob->wear();

        carry_object(0,"sword",1)->wield();
        powerup(0,1);
}

void die()
{
	if( environment() )
		message_vision(HIY"\n$N"HIY"大吼一声：明王救我！\n虚空之中伸出一只巨大的金纹鹏爪，一把抓起$N"HIY"，顿时扶摇九天之外！\n\n"NOR,this_object());
	destruct(this_object());
}

void unconcious()
{
	die();
}

void init()
{
	add_action("do_list","list");
	add_action("do_huan","huan");
}

int do_list()
{
	object me = this_player();
	string str;
	str = HIM"◇"HIC"称号兑换"NOR"\n";
	str+= HBBLU"	  称号      消耗杀生点    称号装备效果                                         "NOR"\n\n";
	str+= HIY"	五毒俱全       "HIR"300         "NOR CYN"物理攻击+30/法术攻击+30"NOR"\n\n";	
	str+= HIY"	扁毛麻雀       "HIR"500         "NOR CYN"基本轻功等级+10/法术闪避率+4%/基本轻功有效等级+8/"NOR"\n";
	str+= CYN"                                   逍遥游等级+10/攻击闪避率+2%/物理闪避率+4%"NOR"\n\n";
	str+= HIY"	青面獠牙       "HIR"800         "NOR CYN"物理攻击+50/法术攻击+50/攻击命中率+2%"NOR"\n";	
	str+= CYN"                                   物理命中率+4%/法术命中率+4%"NOR"\n\n";
	str+= HIY"	凤凰涅槃       "HIR"800         "NOR CYN"气血后限+8000/内力后限+3000/精神后限+5000/"NOR"\n";
	str+= CYN"				   法术防御+500/物理防御+300         "NOR"\n\n";
	str+= HBBLU"	                                                                               "NOR"\n\n"; 
	str+= HIM"◇"HIC"门忠兑换"NOR"\n\n";	
	str+= HIY"	一万门忠       "HIR"15         \n\n";
	str+= HBBLU"	                                                                               "NOR"\n"; 
	str+= sprintf("你目前有杀生点 "HIY"%d"NOR" 点。\n"NOR,me->query("family/xuehai_killed_wdd"));
	write(str);	
	return 1;
}

int do_huan(string arg)
{
	int need;
	object me = this_player();
	if( !arg )
		return notify_fail("你要兑换什么称号？输入称号中文。\n");
	if( me->is_titles(arg) )
		return notify_fail("你已经拥有这个称号了，输入title命令可以查看你目前拥有的称号。"HIR"\n另外你需要通过 title <称号> 命令来激活称号的附加属性。\n"NOR);
	
	switch(arg)
	{
		case "五毒俱全" : need = 300;break;
		case "扁毛麻雀" : need = 500;break;
		case "青面獠牙" : need = 800;break;
		case "凤凰涅槃" : need = 800;break;
		case "一万门忠" : need = 15;break;
		default : return notify_fail("这里换不了「"+arg+"」称号。\n");
	}
	if( me->query("family/xuehai_killed_wdd")<need )
		return notify_fail("你目前的杀生点不足"+need+"，还是多多灭杀秘境中的无底洞弟子吧。\n");
	if( arg=="一万门忠" )
	{
		if( me->query("faith")>=100000000 )
			return notify_fail("你现在不缺门忠。\n");
		me->add("family/xuehai_killed_wdd",-need);
		me->add("faith",10000);
		write(HIY"你消耗了 "+need+" 杀生点 换取了 一万点门派贡献。\n"NOR);
		return 1;
	}		
	if( me->set_titles(arg) )
	{
		CHANNEL_D->do_channel(this_object(),"rumor","听说"HIY+me->query("name")+HIM"获得了大雪山专属称号【"+HIY+arg+HIM"】！"NOR);
		me->add("family/xuehai_killed_wdd",-need);
		write(HIY"你消耗了 "+need+" 杀生点 换取了 大雪山专属称号【"+HIR+arg+HIY"】。"HIR"\n你需要通过 title "+arg+" 命令才能激活称号附加属性，详情参阅 help title 。"NOR"\n");
	}
	else	write(HIR"兑换失败！不过你没有损失。\n"NOR);
	return 1;	
}

int information(object who)
{
	if( !who || !environment(who) 
	 || !environment(who)->is_xsxh() )
		return 0;
	this_object()->move(environment(who));
	message_vision("$N走了过来。\n",this_object());
	who->set_temp("maze/quest_npc2",this_object());
	return 1;
}