//妖fc moon hell jjf shushan
#include <ansi.h>
#include <combat.h>
inherit NPC;

nosave string weapon_type = "blade";
nosave int Die = 0;
nosave int Num = 1;
nosave int Super = 0;
nosave int default_level = 390;

void init_skill()
{
	string *skills;
	object *inv;
	int i;
	mapping skill;
	skill = query_skills();
	if( !skill || !mapp(skill) )
		return;
	skills = keys(skill);
	if( skills && arrayp(skills) )
	{
		for(i=0;i<sizeof(skills);i++)
			delete_skill(skills[i]);
	}
	inv = all_inventory();
	if( intp(i=sizeof(inv)) && i>0 )
	{
		while(i--)
		{
			if( !userp(inv[i]) )
			{
				inv[i]->unequip();
				inv[i]->move("/obj/empty");
				REMOVE_D->add_obj(inv[i],1);
			}
			else	inv[i]->move("/obj/void");
		}	
	}
	reset_action();	
}

void init_family(int default_level)
{
	string weapon,fam,*files;
	object ob;
	int i;
	init_skill();
	delete("family");
	if( default_level<390 )
		default_level = 390;
	
	if( this_object()->query_level()>=40 )
		set("shentong/40",sprintf("%s_%s_%d",({"金","木","水","火","土",})[random(5)],({"阴","阳",})[random(2)],1+random(7)));
	
	fam = "陷空山无底洞";
	set_skill("unarmed",default_level);
  	set_skill("dodge", default_level);
  	set_skill("parry", default_level);
  	set_skill("spells", default_level); 
  	set_skill("yaofa", default_level);
  	set_skill("sword",default_level);
  	set_skill("qixiu-jian",default_level);
  	set_skill("blade", default_level);
  	set_skill("kugu-blade", default_level);
  	set_skill("lingfu-steps",default_level);
  	set_skill("yinfeng-zhua",default_level);
  	set_skill("force", default_level);   
  	set_skill("huntian-qigong", default_level);
	set_skill("literate",default_level);
  	map_skill("force", "huntian-qigong");
  	map_skill("spells", "yaofa");
  	map_skill("unarmed", "yinfeng-zhua");
  	map_skill("sword", "qixiu-jian");
  	map_skill("parry", "kugu-blade");
  	map_skill("blade", "kugu-blade");
  	map_skill("dodge", "lingfu-steps");
  	
  	set_skill("zhaoyun",default_level);
  	set_skill("feisha-zoushi",default_level);
  	set_skill("tuxing",default_level);
  	set_skill("zhihua",default_level);

	if( random(5)==3 )
		weapon = "sword";
	else	weapon = "blade";	
	create_family(fam,2+random(3),"");
	carry_object(0,weapon,1)->wield();
	files = ({
               "armor","cloth","hand","kui","neck","pifeng","ring","shield","shoes","waist","wrists",
    	});
    	for(i=0;i<sizeof(files);i++)
    		carry_object(0,files[i],1)->wear();
}

int query_max_hp(object who)
{
	int level,num;
	level = this_object()->query_level();
	if( !who ) 
	{
		if( level>=60 )
			return 3000+level*800;
		else	return 1000+level*500;
	}
	num = (who->query("family/xuehai_killed_wdd")+1)*300;
	if( num>20000 )
		num = 20000;
	if( level>=60 )
		return 5000+num;
	else	return 1000+num/2;		
}

int information(object who)
{
	object target;
	int kee,lvl;
	if( !who || !environment(who) 
	 || !environment(who)->is_xsxh() )
		return 0;
	if( objectp(target=who->query_temp("maze/wdd_dizi"))
	 && target!=this_object()
	 && environment(target)
	 && environment(target)->is_xsxh() )
	 	return 0;
		
	lvl = who->query_level()/10*10+9;
	if( lvl<39 )
		lvl = 39;
	set_level(lvl);
	kee = query_max_hp(who);
	default_level =lvl*10;
	init_family(default_level);
	set("max_kee",kee);
	set("max_sen",kee);
	set("max_force",default_level*15);
	set("max_mana",default_level*18);
	setup();
	powerup(0,1);
	set("force",this_object()->query_maxforce()*2);
	set("mana",this_object()->query_maxmana()*2);
	set("mana_factor",default_level*2);
	set("force_factor",default_level*2);
	set("daoxing",this_object()->query_max_daoxing());
	set("valid_time",time());
	
	this_object()->move(environment(who));
	message_vision("$N走了过来。\n",this_object());
	who->set_temp("maze/wdd_dizi",this_object());
	this_object()->set_temp("my_killer",who);
	return 1;
}

void create()
{
	string name;
	
	name = ({ "浩","叔","舒","殊","漱","黍","昊",})[random(7)];
	name+= ({ "大仓","小仓","黄胸","花仓","黄毛","田姬"})[random(6)];
	set_name(name,({"lao shu","shu","wudidong dizi","dizi"}));
	set("long",name+"，被地涌夫人偷偷送进秘境之中历练。\n");
	set("no_sleep",1);
	set("任务",1);
	set("env/test","HIM");
	set("env/brief_message",3);
	setup();
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void super_hit()
{
	object who;
	int num,t = 3+random(3);

	remove_call_out("super_hit");
	
	Super = 0;
	if( !objectp(who = query_temp("my_killer"))
	 || !this_object()->is_fighting(who) )
		return;	 
	
	num = who->query("family/xuehai_killed_wdd");
	if( num<3 || random(num)<2 )
		return;
					
	QUEST_D->addEffKee(this_object());
	QUEST_D->addKee(this_object());
	QUEST_D->addSen(this_object());
	QUEST_D->addEffSen(this_object());
	if( this_object() && this_object()->is_fighting()
	 && living(this_object()) )
	{	 
		this_object()->stop_busy();
		Super = 1;
		QUEST_D->randomPfm(this_object());
	}	
	call_out("super_hit",t);
}

void kill_ob(object who)
{
	if( !who || !present(who,environment()) )
	{
		this_object()->powerup(1);
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( Die==1 )
	{
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( this_object()->is_fighting(who) )
		return;
	remove_call_out("super_hit");
	if( Super==0 )
		super_hit();	
	::kill_ob(who);
	if( this_object()->query_level()>=40 )
		command("cast xiaoshen");		
}

int follow_me(object ob, string dir)
{
	if( !ob || !living(this_object()) || ob==this_object() ) 
		return 0;
	if( ob==follow
	||(query("pursuer") && this_object()->is_killing(ob->query("id")))) 
		return follow_path(dir);
	return 0;
}

void reward_ob(object who)
{
        object ob;
        int i,succ,num;
        mixed *env,*dir;
        string color,file,str,arg="";

	message_vision(HIR"\n$N"HIR"狠狠道：山水有相逢，你我后会有期。随机肉身崩为飞灰，一道元神从泥丸宫冲出，化作一道玄光往无底洞飞去。\n\n"NOR,this_object());
        if( who && userp(who) && present(who,environment()) )
        {
        	who->add("family/xuehai_killed_wdd",1);
        	num = who->query("family/xuehai_killed_wdd");
        
        	if( !arrayp(env=who->query_temp("maze/equip_color")) )
        		env = 0;   
        	
        	i = who->query_cor()/25;
        	i = random(i)+1;
        	if( i>3 )
        		i = 3;
        	while(i--)	
        	{
        		succ = who->query_kar(); 
			succ = random(who->query_kar())/5;
			succ+= random(num);
        		if( succ>4 )
			{                
         			dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",});
               			file = dir[random(sizeof(dir))];
				ob = new("/d/obj/narmor/"+file);
				if( random(100)>95 )
					set("env/test","HIM");
				else if( random(100)>75 )
					set("env/test",({"HIM","HIR",})[random(2)]);
				else if( random(100)>50 )	
					set("env/test",({"HIM","HIR","HIB"})[random(3)]);
				else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
	                	set_temp("armor_level",default_level-5+random(5));
        	        	ob->init_armor(this_object());
                		if( ("/d/maze/xs-xuehai/npc/equip.lpc")->change_equip(ob) )
                			str = "雪山秘藏"HIY+ob->query("name")+HIG;
                		else	str = obj_name(ob);
                		ob->set("no_give",1);
				if( stringp(color=ob->query("armor_color")) 
	                 	 && env && member_array(color,env)==-1 )
				{
					tell_object(who,HIY"【副本】雪海孤旅：你设置了装备过滤，"+str+HIY"被自动忽略。\n"NOR);
					ob->move("/obj/empty");
					REMOVE_D->add_obj(ob,1);
				}
	                	else if( !ob->move(who) )
       		        	{
               				ob->move("/obj/empty");
					REMOVE_D->add_obj(ob,1);
                       			tell_object(who,HIR"【副本】雪海孤旅：你的背包满了。\n"NOR);
				}
                		else    
                		{
                			if( arg!="" )
	                			arg+= "、";
					arg+= str;
				}
       			}	
        	}
        
        	succ = random(who->query_kar())/10;
        	if( succ>5 )
        	{
        		dir = ({"blade","blade","sword","sword","unarmed","unarmed"});
        		file = dir[random(sizeof(dir))];
			ob = new("/d/obj/nweapon/"+file);
                	if( random(100)>95 )
				set("env/test","HIM");
			else if( random(100)>75 )
				set("env/test",({"HIM","HIR",})[random(2)]);
			else if( random(100)>50 )	
				set("env/test",({"HIM","HIR","HIB"})[random(3)]);
			else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                	set_temp("weapon_level",default_level-5+random(5));
	                ob->init_weapon(this_object());
        	        ob->set("no_give",1);
                	if( stringp(color=ob->query("weapon_color"))
	                 && env && member_array(color,env)==-1 )
			{
                		tell_object(who,HIY"【副本】雪海孤旅：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        	ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
                	}        
                	else if( !ob->move(who) )
                	{
                        	ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
                        	tell_object(who,HIR"【副本】雪海孤旅：你的背包满了。\n"NOR);
                	}
                	else    
                	{
                		if( arg!="" )
	                		arg+= "、";
				arg+= obj_name(ob);
			}
        	}
	
       		if( arg!="" )
			tell_object(who,HIG"【副本】雪海孤旅：你得到了 "+arg+" 。"NOR"\n");	
	}
	this_object()->move("/obj/empty");
	REMOVE_D->add_obj(this_object(),1);
        return;
}

int accept_fight(object who){return 0;}

int is_xsxh(){return 1;}