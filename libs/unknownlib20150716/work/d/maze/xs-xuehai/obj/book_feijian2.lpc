#include <ansi.h>
inherit COMBINED_ITEM;

void setup(){}


void create()
{
	set_name("【飞鸟投林】研习残卷", ({"feijian book","yanxi book","book"}));
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
  	else {
    		set("unit", "叠");
    		set("base_unit", "张");
    		set("value", 1);
    		set("no_sell", 1);
    		set("long", "大雪山前辈们对【百鸟剑法之飞鸟投林】研习的心得，阅之(read)有几率得到领悟【投林】的造化。\n"HIM"效果：飞鸟投林伤害增加50点。"NOR"\n");
    		set("material", "paper");
	}
	setup();
	set_amount(1);
}

void init()
{
	add_action("do_read",({"read","du",}));
}

int do_read(string arg)
{
	string str;
	object me = this_player(),ob=this_object();
	
	if( !arg || !id(arg) )
		return 0;
	if( !present(ob,me) )
		return 0;
	if( me->query("family/family_name")!="大雪山" )
		return notify_fail("大雪山弟子方能研习。\n");

	if( !query("owner_id") || query("owner_id")!=me->query("id") )
		return notify_fail("你从哪里得来的秘笈？！\n");
					
	if( me->query_level()<10 )
        	return notify_fail("你的人物等级不够。\n");

	message_vision("$N拿起一张$n，仔细翻看。\n",me,ob);        	
       
        str = HIY"$N"HIY;
        str+= ({
		"沉浸在残卷绝妙的招数中，",
		"偶于残卷之中领悟一丝百鸟剑法的精髓，",
		"对书中所述颇有心得，",
	})[random(3)];
        str+= ({		
		"久久不能自拔。。。。\n",
		"不由深深沉迷其中。。。。\n",
		"不禁摇头晃脑一番。。。。\n",
	})[random(3)];	
	message_vision(str,me);
	
	if( random(5)!=1 )
		write(HIR"奈何造化不够，你虽有感悟，然而却又一时难以抓住那份机缘。"NOR"\n");
	else		
	{
		write(HIY"你猛然间福至心灵，灵台清灵间抓住了那丝感悟！\n"NOR);
                if( (int)me->is_knowing("xueshan_feijian")>50000 )     write(HIR"你飞鸟投林投掷伤害已达至高境界，不能再提高了。\n"NOR);
                else      me->set_knowing("xueshan_feijian",(int)me->is_knowing("xueshan_feijian")+50);
		write(HIR"你飞鸟投林投掷伤害增加了，目前为"HIY+(int)me->is_knowing("xueshan_feijian")+HIR"点。"NOR"\n");
	}
	message_vision("只见【飞鸟投林】研习残卷化成片片碎屑，从$N的手中飘落。\n",me);
	if( query_amount()>1 )
        	add_amount(-1);
        else	destruct(ob);
	return 1;
}
