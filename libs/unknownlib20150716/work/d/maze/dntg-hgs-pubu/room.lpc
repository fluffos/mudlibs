//dntg1 福地洞天称王，四海千山拱伏
#include <ansi.h>
#include <room.h>
inherit ROOM;

nosave string long;

void create()
{
        set("short","【副本】水帘洞");
        set("channel_id","【副本】水帘洞");
        set("alternative_die",1);
        set("no_huicheng",1);
        set("no_chuqiao",1);
        set("item_desc",([
                "west" : @LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG,                
                "east" : @LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG, 
                "north" : @LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG, 
                "south" : @LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG, 
	])); 
        setup();
}

int alternative_die(object who)
{
        object target;
        string file,msg;
        if( !who )
                return 1;
        if( !userp(who) && who->is_pubu() )
        {
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,this_object()) )
                        who->reward_ob(target);
                else    message_vision(HIY"$N"HIY"「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n"NOR,who);
                if( who )  destruct(who);
                return 0;                         
        }
        //玩家死亡
        /*
        if( !wizardp(who) )
        {
	        if( who->query_level()!=69 || who->query("combat_exp")<870000000
        	 || who->query("daoxing")<480000 )
			return 1;
	}	
        */	
        who->powerup(0,1);
        tell_object(who,NOR"              "REV HIR" "NOR HBWHT HIM"大闹天宫"NOR REV HIR" "NOR HBCYN HIY"福地洞天称王，四海千山拱伏 "NOR"\n");
        tell_object(who,HIR"本次大闹天宫失败了！\n"NOR);
        file = who->query_temp("mark/dntg-hgs-pubu");
        if( file_size(file+".lpc")>0 )
        	who->move(file,2);
	else
	{
		tell_object(who,"\n一阵时空的扭曲将你传送到另一个地方．．．\n");
		who->move("/obj/void");
	}
        who->set("maze/hgs-pubu",time());
        who->delete_temp("maze");
        who->delete_temp("mark/dntg-hgs-pubu");
        if( who->query("combat_exp")>10000 )
        	who->add("combat_exp",-10000);
        if( who->query("daoxing")>1000 )	
        	who->add("daoxing",-1000);
        tell_object(who,HIY"\n你慌慌张张地从瀑布中逃了出来。\n"HIR"你失去了一万点武学经验以及一年道行。"NOR"\n");
        return 0;
}                       

int do_drop(string arg)
{
	return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "recall","move","maphere","map","fight","find",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}

void init()
{
	if( !query("init_guai") )
	{
		set("guai",random(2)+random(2)+random(2));
		set("init_guai",1);
	}
        if( userp(this_player()) )
        {
                add_action("do_cmds","",1);
                add_action("do_drop","drop");
        }
}

void do_revive(object who)
{
	if( !who || living(who) )
		return;
	who->revive();	
}

int valid_leave(object who,string dir)
{
	int t;
	object guai;
	if( !userp(who) && who->is_pubu() 
	 || ( !query("exits") || sizeof(query("exits"))<2 ) 
         || dir=="out" )
		return ::valid_leave(who,dir);
	if( random(5)<2 && !query("pass") )
      	{
      		message_vision(HIR"$N"HIR"迷迷糊糊踏出一步，一不小心摔倒在地。\n"NOR,who);
      		if( who->query("kee")<=50 )
      		{
      			who->remove_all_enemy();
			who->remove_ride();
			message("system", HIR "\n你的眼前一黑，接着什么也不知道了．．．\n\n" NOR,who);
			who->disable_player(" <昏迷不醒>");
			who->set("kee", 0);
			who->set("sen", 0);
			who->set_temp("block_msg/all", 1);
			t = random(100 - who->query("con")) + 30;
			if( t<15 )
				t = 15;
			call_out("do_revive",t,who );
      		}
      		else	who->receive_damage("kee",50);
      		return 2;		
      	}
      	else if( random(8)<2 && !query("pass") )
      	{
      		message_vision(HIY"$N"HIY"迷迷糊糊踏出一步，一不小心摔倒在地。\n"NOR,who);
      		who->start_busy(1+random(2));
      		return 2;
      	}
      	else
      	{
      		if( !query("pass") )
      			set("pass",1);
      		if( query("init_guai") && query("guai")>0 )
      		{
      			guai = new("/d/maze/dntg-hgs-pubu/npc/guai");
      			guai->set_level(who->query_level()/10*10+9);
      			guai->set_owner(who);
      			if( guai->move(this_object()) )
      			{
      				add("guai",-1);
      				guai->init_guai();
      				guai->set_follow(who);
      				message_vision(HIB"\n妖风骤起，从瀑布深处窜出一道人影，朝$N"HIB"大喝道：哪里来的泼户？扰你家爷爷清修？！\n\n"NOR,who);
      				guai->kill_ob(who);
      				who->kill_ob(guai);
      				return 2;
      			}	
      			else
      			{
      				destruct(guai);
      				return notify_fail("你有些疑神疑鬼。。。。\n");
      			}	
      		}
      		else
      		{	
      			message_vision (HIY"$N"HIY"在瀑布中找到一丝细缝，挤了出去。\n"NOR,who);
      			return ::valid_leave(who,dir);
      		}
      	}
}
