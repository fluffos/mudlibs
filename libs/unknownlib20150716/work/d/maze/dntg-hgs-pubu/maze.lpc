#include <ansi.h>
inherit VRM_SERVER;

void create() {
  set_maze_map_color(HIW);
  set_inherit_room("/d/maze/dntg-hgs-pubu/room");
  set_npcs_rate(90);
  set_display_map(2);
  //迷宫的单边长
  set_maze_long(4);
  //每个房间的出口，默认是2
  set_maze_exit(2);
  //无出口的方向不显示，默认是显示
  set_maze_exittype(1);
  //入口方向(出口在对面)
  set_entry_dir("west");
  //入口与区域的连接方向
  set_link_entry_dir("west");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "enter");

  //出口与区域的连接方向
  set_link_exit_dir("east");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "out");

  //普通房间描述
  set_maze_room_short("瀑布中");
  set_maze_room_desc(@LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG);
  //入口房间短描述 
  set_entry_short(HIC "瀑布中" NOR);
  //入口房间描述 
  set_entry_desc(@LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG);
  //出口房间短描述 
  set_exit_short(HIR "瀑布中" NOR);
  //出口房间描述 
  set_exit_desc(@LONG
……你似乎什么也看不清楚，只觉得四周涧水奔流，难以
探到前方的出路……
LONG);
  // 迷宫房间是否为户外房间？ 
  set_outdoors(0);

  //迷宫房间是否刷新且刷新时间设置
  set_maze_refresh(10800);
  //迷宫销毁时间
  set_remove_time(10800);
}
