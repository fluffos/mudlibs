#include <ansi.h> 
inherit F_VENDOR_SALE;

mixed about_map();

void create()
{
        set_name("芭将军", ({"ba jiangjun","ba","monkey"}));
        set("title","花果山大将");
        set("gender", "男性" );
        set("age", 35);
        set("class","taoist");
        set("long", "一只成了精的通背猿。\n");
        set_level(69);

        set("attitude", "peaceful");
        set_skill("unarmed", 600);
        set_skill("dodge", 600);
        set_skill("parry", 600);
        set_skill("spells", 600);

        set("max_force", 6000);
        set("force", 6000);
        set("force_factor", 300);
	set("max_mana", 4000);
	set("mana", 4000);
	set("mana_factor", 200);
	set("任务",1);
	set("vendor_goods", ([
                "yao": "/d/obj/drug/jinchuang",
                "dan": "/d/obj/drug/hunyuandan",
		"force" : "/d/obj/drug/bihai-yinping",
		"yao3" : "/d/obj/drug/jinchuang3",
  		"dan3" : "/d/obj/drug/hunyuandan3",
  		"yao2" : "/d/obj/drug/jinchuang2",
  		"dan2" : "/d/obj/drug/hunyuandan2",
        ]) );	
	set("inquiry",([
        	"拣取" : "如果你对打到的装备有品质要求，可以在我这里记录(mark)一下。\n",
        	"地图" : (: about_map: ),
        ]));	
        set("env/test","HIB");
	setup();
        carry_object(0,"armor",1)->wear();
        carry_object(0,"stick",1)->wield();
        powerup(0,1);
}

void init()
{
	::init();
	add_action("do_mark","mark");
}

int do_mark(string arg)
{
	int i;
	string str,*tmp,*temp;
	mapping color = ([
		"HIM" : "紫",
		"HIR" : "红",
		"HIC" : "青",
		"HIB" : "蓝",
		"HIY" : "金",
	]);
	if( !arg )
		return notify_fail(name()+"问道：你想记录哪些颜色，多种颜色可以用"HIY" , "NOR"分开。\n示例：mark HIC,HIM");
	arg = replace_string(arg,"，",",");	
	if( strsrch(arg,",")==-1 )
	{
		if( undefinedp(color[arg]) )
			return notify_fail(name()+"说道："+arg+" 这样颜色可没有。\n");
		else	tmp = ({arg});
	}
	else
	{
		temp = explode(arg,",");
		tmp = ({});
		for(i=0;i<sizeof(temp);i++)
		{
			if( undefinedp(color[temp[i]]) )
				return notify_fail(name()+"说道："+temp[i]+" 这样颜色可没有。\n");
			tmp+= ({temp[i]});	
		}
	}
	str = "";
	for(i=0;i<sizeof(tmp);i++)
	{
		str+= color[tmp[i]]+"色";
		if( i<sizeof(tmp)-1 )
			str+= "、";
	}
	this_player()->set_temp("maze/equip_color",tmp);
	write(HIC+name()+HIC"吱吱乱叫，念了几句咒语朝你一指。\n"NOR);		
	write(CYN+name()+CYN"抓耳挠腮，说道：好了，除了"+str+"，其他品质的装备会自动清除。\n"NOR);
	return 1;
}

mixed about_map()
{
	int i,f=0;
	string arg,str,*strs,color;
	object env,xin,who=this_player();
	env = environment();
	if( this_object()->is_busy() )
		return "我现在正忙。";
	if( !who->check_pay(10000) )
		return "你需交纳一两黄金。";	
	if( objectp(xin=present("shuilian dong's map",who))
	 && base_name(xin)=="/d/maze/dntg-hgs-pubu/obj/map" )
		return "我不是已经给过你了。";	 
			
	command("go east");	
	str = MAZE_D->query_maze_mainobj(this_object())->display_common_map(environment());
	this_object()->move(env);
	if( !str )
		return "什么地图？在下不知。";
	strs = explode(str,"\n");
	str = "";
	color = ({HIR,HIG,HIY,HIC,HIM,HIB,HIW,RED,GRN,YEL,CYN,MAG,BLU,WHT,})[random(14)];
	for(i=0;i<sizeof(strs);i++)
	{
		arg = strs[i];
		arg = replace_string(arg,"★","◆");
		arg = replace_string(arg,HBRED"  ","◇");
		arg = replace_string(arg,BGRN"  ","※");
		arg = COLOR_D->clean_color(arg);
		if( strsrch(arg,"╭")!=-1 )
		{
			f = 1;
			str+= arg+"\n";
		}
		else if( f!=1 )
			continue;
		else
		{
			arg = replace_string(arg,GRN,"");
			arg = replace_string(arg,BGRN,"");
			arg = replace_string(arg,REV,"");
			str+= arg+"\n";	
		}	
	}
	str = replace_string(str,"╭","  ");
	str = replace_string(str,"─","  ");
	str = replace_string(str,"┬","  ");
	str = replace_string(str,"╮","  ");
	str = replace_string(str,"│","  ");
	str = replace_string(str,"╯","  ");
	str = replace_string(str,"╰","  ");
	str = replace_string(str,"├","  ");
	str = replace_string(str,"┤","  ");
	str = replace_string(str,"┤","  ");
	str = replace_string(str,"┼","  ");
	str = replace_string(str,"┴","  ");
	str = replace_string(str,"※",NOR+REV+color+"  "NOR);
	str = "【水帘洞地图】\n"+str+"*注：◆为入口(芭将军处#2 east)，◇为出口。\n";
	xin = new("/d/maze/dntg-hgs-pubu/obj/map");		
	xin->set("long",str);
	if( !xin->move(who) )
	{
		destruct(xin);
		tell_object(who,HIR"【系统】你的背包满了。\n"NOR);
	}
	else	
	{
		tell_object(who,HIG"【副本】大闹天宫：你得到了 「"HIY"水帘洞瀑布地图"HIG"」。\n"NOR);
		who->money_add(-10000);
		tell_object(who,HIR"【系统】要注意的是：退出副本后，地图将会重置。"NOR"\n");
	}
	return 1;
}