int query_max_hp()
{
	int level;
	level = this_object()->query_level();
	if( level<60 )
		return 50000+level*10000;
	else	return 30000+level*12000;
}

void init_guai()
{
	int kee;
	if( !owner || !environment() )
		return;
	kee = query_max_hp();
	default_level = this_object()->query_level()*10;
	init_family(default_level);
	set("max_kee",kee);
	set("max_sen",kee);
	set("max_force",default_level*15);
	set("max_mana",default_level*18);
	setup();
	powerup(0,1);
	set("force",this_object()->query_maxforce()*2);
	set("mana",this_object()->query_maxmana()*2);
	set("mana_factor",default_level*2);
	if( query("family/family_name")!="月宫" )
		set("force_factor",default_level);
	else	set("force_factor",0);		
	set("daoxing",this_object()->query_max_daoxing());
	set("valid_time",time());
}

void create()
{
	int i;
	mapping names;
	string name,*ids,name2;
	
	names = NAME_D->random_name("yaoguai");
	name = names["name"];
	ids = ({"yaoxiu","yao xiu","yao"});
	name2 = sprintf("%s",name[0..1]);
	name2+= ({"元","丹","真","悟","会",})[random(5)]+({"子","天","道","仙","真人","大仙","大王",})[random(7)];
	set_name(name2,ids);
	
	if( sscanf(name,"%*s精") || sscanf(name,"%*s怪") )
	{
		i = strlen(name);
		name = sprintf("%s",name[0..i-3]);
	}
	set("原形",name);
	
	set("long","东胜神州有一花果山，山灵水秀，其间多有开智禽兽，吸食日月精华，修炼有成。\n");
	set("fangcun/panlong_accept","done");
	set("no_sleep",1);
	set("任务",1);
	set("env/test","HIM");
	set("env/brief_message",3);
	setup();
}

string long()
{
	string str,long = HIG"东胜神州有一花果山，山灵水秀，其间多有开智禽兽，吸食日月精华，修炼有成。\n"NOR;
	if( stringp(query("原形")) )
		long+= HIY"这是一只修炼多年的"+query("原形")+"。\n"NOR;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
	 	return long;
	str = COLOR_D->clean_color(str);	
	switch(str)	
	{
		case "厚土" : long+= HIC"怪物特效：物理免疫。\n"NOR;break;
		case "驭法" : long+= HIC"怪物特效：法术免疫。\n"NOR;break;
		case "轻灵" : long+= HIC"怪物特效：busy状态下伤害降低。\n"NOR;break;
		case "彪悍" : long+= HIC"怪物特效：物理伤害提高100%。\n"NOR;break;
		case "通灵" : long+= HIC"怪物特效：法术伤害提高100%。\n"NOR;break;
		case "吸血" : long+= HIC"怪物特效：击中回复自己1%的气血值。\n"NOR;break;
		case "偷心" : long+= HIC"怪物特效：击中回复自己2%的法力值。\n"NOR;break;
		case "反戈" : long+= HIC"怪物特效：受到伤害的10%反弹给攻击者。\n"NOR;break;
		case "登峰" : long+= HIC"怪物特效：物理命中提高100%。\n"NOR;break;
		case "震古" : long+= HIC"怪物特效：法术命中提高100%。\n"NOR;break;
		case "死锋" : long+= HIC"怪物特效：死亡时释放物理伤害。\n"NOR;break;
		case "死毒" : long+= HIC"怪物特效：死亡时释放毒伤害。\n"NOR;break;
		case "死幻" : long+= HIC"怪物特效：死亡时释放混乱伤害。\n"NOR;break;
	}
	return long;	
}

string short()
{
        string str = ::short();
        if( !query("my_type") )
                return str;
        return str+NOR"["+query("my_type")+NOR"]";
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void hurt_env(string type)
{
	object *inv;
	int i,damage;
	if( !environment() )
		return;
	inv = all_inventory(environment());
	if( !inv || sizeof(inv)<1 )
		return;
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->is_maze() )
			continue;
		if( !inv[i]->is_character() )
			continue;
		switch(type)
		{
			case "combat" : 
				damage = this_object()->query_combat_damage();
				damage = inv[i]->receive_wound("kee",damage,this_object(),TYPE_PERFORM);
				if( damage>0 )
					message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"点物理伤害！\n"NOR,inv[i]);
				break;
			case "du" : 
				damage = 5+random(15);
				inv[i]->apply_condition("wuxing",(int)inv[i]->query_condition("wuxing")+damage);
				message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"秒五行奇毒伤害！\n"NOR,inv[i]);	
				break;
			case "hl" :
				damage = 3+random(5);
				inv[i]->start_hunluan((int)inv[i]->is_hunluan()+damage,"你只觉眼前金光闪闪，一时不知干啥好。\n");
				message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"秒混乱伤害！\n"NOR,inv[i]);	
				break;
		}			
	}	
}

void super_hit()
{
	int t = 3+random(3);
	Super = 0;
	exert_function("recover");
	exert_function("refresh");
	if( this_object() && this_object()->is_fighting()
	 && living(this_object()) )
	{	 
		this_object()->stop_busy();
		Super = 1;
		QUEST_D->randomPfm(this_object());
	}	
	remove_call_out("super_hit");
	call_out("super_hit",t);
}

void kill_ob(object who)
{
	if( !who || !present(who,environment()) )
	{
		this_object()->powerup(1);
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( Die==1 || !owner || who!=owner )
	{
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( this_object()->is_fighting(who) )
		return;
	remove_call_out("super_hit");
	if( Super==0 )
		super_hit();	
	::kill_ob(who);
	if( this_object()->query_level()>=40 )
		command("cast xiaoshen");		
}

void init()
{
	if( !this_object()->is_fighting() 
	&& query("vaile_time")>0 )
	{
		if( time()>query("valid_time")+120 )
		{
			this_object()->delete("valid_time");
			message_vision("$N急急忙的离开了。\n",this_object());
			set("vaile_time",time());
			this_object()->move("/obj/empty");
			REMOVE_D->add_obj(this_object(),5);
			return;
		}
		else if( userp(this_player()) )
		{
			this_object()->kill_ob(this_player());
			this_player()->fight_ob(this_object());
		}
	}
}

int follow_me(object ob, string dir)
{
	if( !ob || !living(this_object()) || ob==this_object() ) 
		return 0;
	if( ob==follow
	||(query("pursuer") && this_object()->is_killing(ob->query("id")))) 
		return follow_path(dir);
	return 0;
}

void reward_ob(object who)
{
        object ob,xin,weapon;
        int i,succ;
        mixed *env;
        string *dir,str,file,color,arg="";

        message_vision (HIB"\n$N"HIB"惨叫一声，浑身冒起一道蓝光，就地一滚，化作一只"+query("原形")+"急急忙忙的离开了。\n\n"NOR,this_object());
        if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }
        
        if( !who || !userp(who) || !present(who,environment()) )
        {
                destruct(this_object());
                return;
        }
        
        succ = who->query_kar(); 
        if( !query("my_type") )
        	succ = succ/5+random(succ/5);
        
        if( random(succ)>10 )
        {
                file = ("/d/maze/dntg-hgs-pubu/obj/bag");
                ob = new(file);
                ob->set("owner_id",who->query("id"));
                if( !ob->move(who) )
                {
                        destruct(ob);
                        tell_object(who,HIR"【副本】水帘洞：你的背包满了。\n"NOR);
                }
                else 	arg+= obj_name(ob);
        }
        
        if( random(succ)>20 )
	{
                file = ("/d/maze/dntg-hgs-pubu/obj/life");
                ob = new(file);
                ob->set("owner_id",who->query("id"));
                if( !ob->move(who) )
                {
                        destruct(ob);
                        tell_object(who,HIR"【副本】水帘洞：你的背包满了。\n"NOR);
                }
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
                }
	}

       	if( !arrayp(env=who->query_temp("maze/equip_color")) )
        	env = 0;                
	succ = random(who->query_kar())/10;
        if( succ>4 )
	{                
         	dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",
        	});
               	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/narmor/"+file);
		if( random(100)>55 )
			set("env/test",({"HIM","HIR","HIB"})[random(3)]);
		else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                if( !query("my_type") )
                	set_temp("armor_level",1+random(60));
		else	set_temp("armor_level",55+random(20));	
                ob->init_armor(this_object());
                if( stringp(color=ob->query("armor_color")) 
                 && env && member_array(color,env)==-1 )
		{
			tell_object(who,HIY"【副本】水帘洞：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
			destruct(ob);
		}
                else if( !ob->move(who) )
       	        {
               		destruct(ob);
                       	tell_object(who,HIR"【副本】水帘洞：你的背包满了。\n"NOR);
		}
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
		}
       	}	
        
        succ = random(who->query_kar())/10;
        if( succ>5 )
        {
        	dir = ({"axe","blade","blade","hammer","mace","spear","staff","stick","sword","unarmed","whip","fork","dagger",});
        	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/nweapon/"+file);
                if( random(100)>65 )
			set("env/test",({"HIM","HIR","HIB"})[random(3)]);
                else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]);  
                if( !query("my_type") )
                	set_temp("weapon_level",1+random(60));
		else	set_temp("weapon_level",55+random(20));	
                ob->init_weapon(this_object());
                if( stringp(color=ob->query("weapon_color"))
                 && env && member_array(color,env)==-1 )
		{
                	tell_object(who,HIY"【副本】水帘洞：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        destruct(ob);
                }        
                else if( !ob->move(who) )
                {
                        destruct(ob);
                        tell_object(who,HIR"【副本】水帘洞：你的背包满了。\n"NOR);
                }
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
		}
        }
	
        if( !query("my_type") )
	{       
		if( arg!="" )
			tell_object(who,HIG"【副本】水帘洞：你得到了 "+arg+" 。"NOR"\n");	
        	destruct(this_object());        
        	return;
        }
        
        succ = random(who->query_kar())/10;
        if( random(succ)>6 )
        {
		ob = new( sprintf("/d/maze/dntg-hgs-pubu/obj/sj%d",1+random(2)) );
        	ob->set("owner_id",who->query("id"));
	        if( !ob->move(who) )
                {
                        destruct(ob);
                        tell_object(who,HIR"【副本】水帘洞：你的背包满了。\n"NOR);
                }
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
		}
        }
        if( arg!="" )
        	tell_object(who,HIG"【副本】水帘洞：你得到了 "+arg+" 。"NOR"\n");
	destruct(this_object());        
        return;
}

int accept_fight(object who){return 0;}

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return ::receive_wound(type,damage,who,attack_type);
        if( who && who!=this_object() )
        {
        	str = COLOR_D->clean_color(str);
        	if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
        }               
        return ::receive_wound(type,damage,who,attack_type);
}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return ::receive_damage(type,damage,who,attack_type);
        if( who && who!=this_object() )
        {
        	str = COLOR_D->clean_color(str);
        	if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
        }               
        return ::receive_damage(type,damage,who,attack_type);
}

mixed hit_ob(object me, object who,int damage,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return 0;
	if( !living(me) || !who || !me->is_fighting(who) || damage<=0 )
		return 0;
	str = COLOR_D->clean_color(str);	
	switch(str)
	{
		case "彪悍" : //物理伤害提高100%
			if( attack_type==TYPE_COMBAT || attack_type==TYPE_PERFORM || attack_type==TYPE_QUICK )
				return damage;
			break;	
		case "通灵" : //法术伤害提高100%
			if( attack_type==TYPE_CAST || attack_type==TYPE_CAST_2 )
				return damage;
			break;		
		case "吸血" : //击中回复自己1%的气血值
			me->receive_heal("kee",me->query_maxkee()/100+1);
			me->receive_curing("kee",me->query_maxkee()/100+1);
			return RED"$N"RED"开始疯狂的吸血！\n"NOR;
		case "偷心" : //击中回复自己2%的法力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/50+1);
				return HIC"$N"HIC"只觉得自己的法力越来越充沛了。\n"NOR;
			}
			break;
	}
	return 0;		
}