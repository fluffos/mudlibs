#include <ansi.h>
inherit "/d/maze/dntg-hgs-pubu/room.lpc";

void create()
{
        set("short","瀑布中");
        set("channel_id","土灵珠副本");
        set("long", @LONG
正上方就是飞凤峰谷底，四面全是土，你不由地屏住呼吸。
LONG );
        set("alternative_die",1);
        set("virtual_room", 1); 
        set("no_magic",1);
        set("no_fight",1);    
        set("exits", ([
                "out" : "/d/dntg/hgs/tiebanqiao",
        ])); 
        setup();
}

int valid_leave(object who,string dir)
{
	if( userp(who) && dir=="out" )
	{
		if( who->query("dntg/huaguo")!="done" ) 
			who->set("dntg/huaguo","start");
		return ::valid_leave(who,dir);	 
	}
        return ::valid_leave(who,dir);   
}
