#include <ansi.h>
inherit __DIR__"wang.lpc";

string check_book();

nosave string *Txs = ({
	HIM"驭法"NOR,HIY"厚土"NOR,HIG"轻灵"NOR,HIR"彪悍"NOR,HIM"通灵"NOR,RED"吸血"NOR,HIB"偷心"NOR,HIC"培元"NOR,HIW"反戈"NOR,
});		

void create()
{
	string *tx,ss;
	int i;
	set_name("阎罗王", ({"yanluo wang","wang", "master", "yanluo"}));
	set_level(89);
	create_family("阎罗地府", 2, "你好");
	set("title", "最胜耀灵真君");
 	set("class", "youling");
	set("gender", "男性");
	set("age", 50);
	set("attitude", "peaceful");
	set_skill("jinghun-zhang",890);
 	set_skill("tonsillit",890);
 	set_skill("gouhunshu",890);
	set_skill("unarmed",890);
 	set_skill("sword",890);
 	set_skill("whip",890);
 	set_skill("hellfire-whip",890);
 	set_skill("zhuihun-sword",890);
	set_skill("dodge",890);
 	set_skill("ghost-steps",890);
	set_skill("parry",890);
 	set_skill("spells",890);
 	set_skill("force",890);
 	set_skill("literate",890);
        map_skill("sword", "zhuihun-sword");
        map_skill("parry", "hellfire-whip");
        map_skill("whip","hellfire-whip");
        map_skill("dodge", "ghost-steps");
        map_skill("unarmed", "jinghun-zhang");
        map_skill("force", "tonsillit");
        map_skill("spells", "gouhunshu");
	set_skill("jianshu",890);
	set_skill("mengtou",890);
	set_skill("dali",890);
	set_skill("jiefeng",890);
	set_skill("yanri",890);
	set("weapon_type","whip");
	set_temp("weapon_level",89);
	set_temp("armor_level",89);
	set("env/test",({"HIM","HIR"})[random(2)]);
	set("wang_pfm",5);
	set("wang_cast",5);
	setup();
	tx = ({});
	i = random(6)/2+1;
	if( i<2 )
		i = 2;
	while(i--)
	{
		ss = Txs[random(sizeof(Txs))];
		tx+= ({ss});
		Txs-= ({ss});
	}	
	set("my_type",tx);
	init_texing();
	set("max_kee",30000);
	set("max_sen",30000);
	powerup();
}