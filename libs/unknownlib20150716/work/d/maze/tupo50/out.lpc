#include <ansi.h>
inherit "/d/maze/tupo50/room.lpc";

void create()
{
        set("short","50级突破副本");
        set("channel_id","50级突破副本");
        set("alternative_die",1);
        set("virtual_room", 1); 
        set("no_magic",1);
        set("no_fight",1);    
        set("exits", ([
                "west" :__DIR__"maze/exit",
                "up" : __FILE__,
        ])); 
        set("item_desc",([
                "west" : "四面一片虚空。\n",
                "up" : "四面一片虚空。\n",
        ]));
        setup();
} 

int valid_leave(object who,string dir)
{
	string file;
	if( !userp(who) || dir!="up" )
		return ::valid_leave(who,dir);
	if( !wizardp(who) &&
	  ( who->query_level()!=49 || who->query("combat_exp")<36000000
          || who->query("daoxing")<240000) )
		return ::valid_leave(who,dir);
		
        file = who->query_temp("mark/tupo50");
        if( file_size(file+".lpc")<=0 )
        	file = "/obj/void";
	
	if( who->query("gin")<30 )
		who->set("gin",0);
	else	who->add("gin",-30);
	if( !who->query_temp("maze/50tupo_item_gived") )
		tell_object(who,HIY"你这次初探神识，结果是一无所得。\n"NOR);
	else
	{
		tell_object(who,HIY"你这次初探神识，感觉多日的瓶颈有松动的迹象。\n"NOR);
		tell_object(who,HIC"你福至心灵，对修行之道有了新的认识。\n"NOR);
		if( who->level_up() )
		{
			CHANNEL_D->do_channel(this_object(),"rumor","听说"HIY+who->name()+HIM"福至心灵，初悟神识奥妙，境界提升了！"NOR);
			tell_object(who,HIG"【系统】你的等级提升了"HIR"1"HIG"级。\n"NOR);
			CHAR_D->setup_char( who );
			UPDATE_D->check_user(who,1);
			who->powerup(0,1);
			who->set_temp("login_data/time", time());
			who->set_temp("login_data/exp", 0);
			who->save();
		}
	}	
	who->delete_override("unconcious");
	who->delete_override("die");
	who->delete_override("quit");
	who->clear_condition();
	tell_object(who,HIC"你缓缓退出神识之海，眼前的景象渐渐淡去。\n"NOR);
	who->move(file,2);
	message_vision(HIC"\n$N"HIC"冥想完毕，睁开眼睛定了定神，站了起来。\n"NOR,who);
	return 2;
}	