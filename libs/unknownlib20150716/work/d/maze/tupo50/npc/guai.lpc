#include <ansi.h> 
#include <combat.h> 
#include "guai.h"
inherit NPC;

void create()
{
        set_name("魔物",({"mo wu","mo"}));
        set("inquiry",([
        	"all"  : "呵呵，此时此刻，我不能告诉你什么。\n",
        	"套装" : "呵呵，此时此刻，我不能告诉你什么。\n",
        ]));
        set("env/no_look",1);	
        setup();
}

int is_pet(){ return 1;}

void leave()
{
	remove_call_out("job1");
	remove_call_out("check");
	remove_call_out("killing");
	remove_call_out("yuanxing3");
	remove_call_out("yuanxing2");
	remove_call_out("yuanxing1");
	message("vision",HIB"\n"+name()+HIB"嘿嘿一笑，将身一摇，化作一道黑风呼啸而去。。。。\n\n"NOR,environment(),this_object());
	destruct(this_object());
}

void killing()
{
	object *inv;
	int i;
	remove_call_out("killing");
	if( !query("yuanxing") )
		return;
	if( !environment() 
	 || !environment()->is_shenshi() )
	 	return;
	inv = all_inventory(environment());
	if( !inv || sizeof(inv)<2 )
		return;
	for(i=0;i<sizeof(inv);i++)
	{
		if( !userp(inv[i]) )
			continue;
		if( inv[i]->query_temp("maze/50tupo_dan_get") )
			continue;			
		if( random(3)==0 )
		{
			inv[i]->set_temp("maze/50tupo_dan_get",1);
			continue;
		}
		message_vision(HIR"\n\n黑芒一闪！两只通体乌紫的手臂闪电般从$N"HIR"身旁的虚空中探出，一把抓住$P，接着两只魔臂凶悍的左右一分。顿时$N"HIR"整个身躯竟直接被撕裂成了两片！\n\n"NOR,inv[i]);
		tell_object(inv[i],HIR"你只觉神识深处一阵刺入心脾的剧痛，不由惨叫连连！\n"NOR);
		inv[i]->delete_override("unconcious");
                inv[i]->delete_override("die");
                inv[i]->delete_override("quit");
                inv[i]->clear_condition();
		inv[i]->die();
	}
	leave();
}

void yuanxing3()
{
	remove_call_out("yuanxing3");
	if( query("yuanxing") )
		return;
	set("yuanxing",1);	
	message_vision(HIY"\n瞬间$N"HIY"便变成了一个头四臂巨大魔物。四只黑紫色妖目，毫无感情的盯向了你。\n"NOR,this_object());
	message_vision(HIR"魔物双目扫过之处，黑紫两色妖芒闪动不已，你顿时只觉一股阴寒从背上升起，竟有一种被天敌盯上得感觉，心中同时咯噔一下。\n"NOR,this_object());
	set_name("魔物",({"mo wu","mo"}));
	set("title","莫名");
	delete("inquiry");
	remove_call_out("killing");
	call_out("killing",5);
}	

void yuanxing2()
{
	remove_call_out("yuanxing2");
	if( query("yuanxing") )
		return;
	message_vision(HIY"转眼间，$N"HIY"体形涨大了倍许有余。\n"NOR,this_object());
	message_vision(HIR"$N"HIR"身上骨节发出一阵”嘎嘣嘎嘣“的怪响，身形一下拔高数尺，后颈和双肩处始变形凸鼓，仿佛有什么东西要从$P体内蹿出一样！\n"NOR,this_object());
        remove_call_out("yuanxing3");
        call_out("yuanxing3",3+random(3));
}	

void yuanxing()
{
	remove_call_out("yuanxing");
	if( query("yuanxing") || query("created")!=4 )
		return;
	EMOTE_D->do_emote(this_object(), "heng",0,CYN,0,0,0);	
	set("inquiry",([
        	"all" : "滚！！\n",
        ]));
        message_vision(CYN"$N"CYN"说道：给脸不要脸！那就别怪我不客气了！\n"NOR,this_object());
        message_vision(HIR"就在这刹那间的工夫，$N"HIR"瞳孔化为赤红之色，口中也发出了野兽般的吼声，随后身上散发出一股邪恶的不似人间的气息！\n"NOR,this_object());
        remove_call_out("yuanxing2");
        call_out("yuanxing2",2+random(3));
}

void check(object who)
{
	string str,arg,*msg,yy;
	int lvl,succ;
	remove_call_out("check");
	if( !who || !environment() || !present(who,environment()) )
	{
		leave();
		return;
	}
	if( query("created")!=2 || query("yuanxing") 
	 || who->query_temp("maze/50tupo_dan_get") )
		return;
	add_temp("check_player",1);
	if( query_temp("check_player")>0 )
	{
	 	if( query_temp("check_player")>=20 )
	 	{
	 		message_vision("$N勃然大怒。\n",this_object());
	 		message_vision(CYN"$N"CYN"说道：某见汝与吾有缘，方网开一面，赠汝灵丹。然竖子不识好歹！\n"NOR,this_object());
	 		set("created",4);
	 		message_vision(HIW"$N"HIW"对着$n"HIW"喝道：「"+RANK_D->query_rude(who)+HIW"！今日不是你死就是我活！」\n"NOR,this_object(),who);
	 		message_vision(HIR"\n看起来$N"HIR"想杀死你！\n"NOR,this_object());
	 		if( !stringp(str=who->query("shentong/40"))
	 		 || sscanf(str,"%s_%s_%d",str,yy,lvl)!=3 )
	 		{
	 			yuanxing();
	 			return;
	 		}
	 		else
	 		{
	 			switch(str)
	 			{
	 				case "金" : str = "白光";break;
	 				case "木" : str = "雷光";break;
	 				case "水" : str = "水气";break;
	 				case "火" : str = "红光";break;
	 				case "土" : str = "金光";break;
	 			}	
	 			if( lvl>=4 )
	 				succ = 1;
	 			else	succ = random(lvl+1);
	 			if( succ>0 )
	 			{
	 				message_vision("\n"HIC"$N"HIC"神识深处忽然冲出一道炫目的"+str+"，在$n"HIC"身上绕了几绕。\n"NOR,who,this_object());
	 				EMOTE_D->do_emote(this_object(), "qi",0,CYN,0,0,0);
	 				set("yuanxing",1);	
					message_vision(HIY"\n$N"HIY"周身冒起层层的浓郁魔气，瞬间便变成了一个头四臂巨大魔物。四只黑紫色妖目，毫无感情的盯向了你。\n"NOR,this_object());
					message_vision(HIR"魔物双目扫过之处，黑紫两色妖芒闪动不已，你顿时只觉一股阴寒从背上升起，竟有一种被天敌盯上得感觉，心中同时咯噔一下。\n"NOR,this_object());
					set_name("魔物",({"mo wu","mo"}));
					delete("inquiry");
					who->set_temp("maze/50tupo_dan_get",1);
					message_vision(CYN"$N"CYN"说道：真是晦气，功败垂成！\n"NOR,this_object());
					EMOTE_D->do_emote(this_object(), "hate",0,CYN,0,0,0);
					message_vision(CYN"$N"CYN"说道：你不要得意，待你渡劫之时，本魔还来取你性命！\n"NOR,this_object());
					CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+"在心神沉浸之时，识破"NOR HIR"魔物"HIM"对神识的侵蚀！"NOR);
					leave();
					return;
				}
				else
				{
					yuanxing();
					return;
				}
	 		}
	 	}
	 	else if( query_temp("check_player")%5==0 )
	 	{
	 		msg = ({
				CYN"$N"CYN"朝你皱了皱眉。\n"NOR,
				CYN"$N"CYN"看着你，一脸不开心的表情。\n"NOR,
				CYN"$N"CYN"说道：怎么？小友莫非对某不放心？！\n"NOR,
				CYN"$N"CYN"脸色变得有些阴沉。\n"NOR,
				CYN"$N"CYN"说道：何去何从，小友还是早下决定！\n"NOR,
			});
			message_vision(msg[random(sizeof(msg))],this_object());		 			
	 	}
	 	else if( query_temp("check_player")==18 )
	 	{
	 		message_vision(HIR"$N"HIR"阴沉着脸，看着你说道：还不下决定就别怪我不客气了！\n"NOR,this_object());
	 	} 
	}
	call_out("check",1+random(3),who);
}

void job1(object who)
{
	string arg;
	remove_call_out("job1");
	if( !who || !environment() || !present(who,environment()) )
	{
		leave();
		return;
	}
	EMOTE_D->do_emote(this_object(), "hehe",0,CYN,0,0,0);	
	if( who->query("family/family_name")==query("family/family_name") )
		message_vision(CYN"$N"CYN"说道：恩，这位门下弟子与我有缘。\n"NOR,this_object());
	else	message_vision(CYN"$N"CYN"说道：恩，这位小友与我有缘。\n"NOR,this_object());
	message_vision(CYN"$N"CYN"说道：我见你修炼已达瓶颈，特来助你一臂之力，这里有一粒"NOR HIC"照灵丹"NOR CYN"。\n"NOR,this_object());
	if( !who->query("class") )
		arg = "旋照";
	else
	{	
		switch(who->query("class"))
		{
			case "yaomo" : arg = "通智";break;
			case "tianmo": arg = "炼体";break;
			case "youling" : 
			case "ghost" : arg = "开灵";break;
			case "bonze" : arg = "脱凡";break;
			default : arg = "旋照";break;
		}
	}
	message_vision(CYN"$N"CYN"笑道：你在此食下，即刻便可进阶"NOR HIC+arg+"期"NOR CYN"，你可要？\n"NOR HIC"$N"HIC"在等你的答复呢，感觉答复吧。"HIY"(answer yes或no )\n"NOR,this_object());
	set("created",2);
	remove_call_out("check");
	call_out("check",0,who);	
}

void create_job(object who)
{
	if( !query("created") || query("created")!=1 )
		return;
	remove_call_out("job1");
	call_out("job1",1+random(3),who);
}	

int accept_fight(object who){return 0;}

void kill_ob(object who)
{
	if( !who )
		return;
	who->remove_killer(this_object());
	this_object()->remove_killer(who);
	if( query("created")==4 )
	{
		tell_object(who,HIC"加油加油。\n"NOR);
		return;
	}
	else
	{
		tell_object(who,HIC+name()+HIC"瞥眼朝你看了看，你只觉心惊肉跳，哪里下得去手。\n"NOR);
		return;
	}
}		

void init()
{
	add_action("do_answer","answer");
}

int do_answer(string arg)
{
	object dan;
	if( query("created")!=2 
	 || query("yuanxing") )
		return 0;
	if( this_player()->query_temp("maze/50tupo_dan_get") )
		return 0;		
	if( !arg )
		arg = "no";
	if( arg[0]=='y' || arg[0]=='Y' )
	{
		message_vision(CYN"$N"CYN"点了点头：我愿意接受您的馈赠。\n"NOR,this_player());
		EMOTE_D->do_emote(this_object(), "nod",geteuid(this_player()),CYN,0,0,0);
		dan = new("/d/maze/tupo50/obj/dan");
		dan->set("owner_id",this_player()->query("id"));
		if( dan->move(this_player()) )
			message_vision(CYN"$N"CYN"呵呵一笑：吾就等你的好消息。\n");
		else
		{
			if( dan ) destruct(dan);
			tell_object(this_player(),HIR"【系统】你的包裹满了。\n"NOR);
			return 1;
		}
		message_vision("$N递给你一颗"HIC"照灵丹"NOR"。\n",this_object());
		message_vision(CYN"\n$N"CYN"的身影渐渐淡去。\n"NOR,this_object());
		this_player()->set_temp("maze/50tupo_dan_get",1);
		destruct(this_object());
		return 1;	
	}
	message_vision(CYN"$N"CYN"摇了摇头：多谢您的好意，在下无功不敢受禄。\n"NOR,this_player());
	EMOTE_D->do_emote(this_object(), "hate",geteuid(this_player()),CYN,0,0,0);
	set("created",4);
	remove_call_out("yuanxing");
        call_out("yuanxing",3+random(3));
	return 1;
}

string no_leve_msg()
{
	return HIC+name()+HIC"朝你撇了一眼，口中哼了一声，你只得乖乖停下了脚步。\n"NOR;
}	

string query_check_msg()
{
	return HIC+name()+HIC"朝你一瞪眼，口中哼了一声，你吓得老实了许多。\n"NOR;
}	
			