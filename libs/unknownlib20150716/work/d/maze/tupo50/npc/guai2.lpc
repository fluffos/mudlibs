#include <ansi.h> 
#include <combat.h> 
inherit NPC;

nosave int lvl;
nosave string wx;

mixed about_ask()
{
	write("可惜"+name()+"时聚时散，宛然不似活物。\n");
	return 1;
}

void kill_ob(object who)
{
	message_vision("$N时聚时散，宛然不似活物。\n",this_object());
	remove_all_killer();
	if( environment() )
		all_inventory(environment())->remove_killer(this_object());
}

void create()
{
        set_name("星君",({"xing jun","xing"}));
        set("inquiry",([
        	"all"  : (:about_ask:),
        ]));
        set("env/no_look",1);	
        setup();
}

void leave()
{
	if( environment() )
	{
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		message("vision","\n"+name()+"”呼“的一声散开了，一时间顿时风轻云净。\n",environment());
	}
	destruct(this_object());
}

int information(object who)
{
	string str,wx,yy,name,*id;
	int lvl;
	if( !who || !living(who) || !present(who,environment()) )
	{
		leave();
		return 0;
	}
	if( query("created") )
		return 0;
	set("created",1);	
	if( !stringp(str = who->query("shentong/40"))
	 || sscanf(str,"%s_%s_%d",wx,yy,lvl)!=3 )
	{
		set_name("蜃楼",({"shen lou","lou",}));
		set("long","一团不停变幻颜色的雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的巨兽形状，爪须俱全，栩栩如生。\n");
		wx = ({"金","木","水","火","土",})[random(5)];
		set("type",wx);
		return 1;		
	}
	switch(wx)
	{
		case "金" : 
			set_name("白虎皎光",({"hu guang","guang"}));
			set("long","一团白色雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的白虎模样，爪须俱全，栩栩如生。\n");
			break;
		case "木" : 
			set_name("青龙绿光",({"long guang","guang"}));
			set("long","一团青色雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的青龙模样，鳞爪俱全，栩栩如生。\n");
			break;
		case "水" : 
			set_name("玄武玄光",({"xuanwu guang","guang"}));
			set("long","一团黑色雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的玄武模样，鳞背俱全，栩栩如生。\n");
			break;
		case "火" : 
			set_name("朱雀赤光",({"zhuque guang","guang"}));
			set("long","一团红色雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的朱雀模样，羽喙俱全，栩栩如生。\n");
			break;
		case "土" : 
			set_name("麒麟黎光",({"qilin guang","guang"}));
			set("long","一团黄色雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的麒麟模样，鳞须俱全，栩栩如生。\n");
			break;
		default :
			set_name("蜃楼",({"shen lou","lou",}));
			set("long","一团不停变幻颜色的雾气，时聚时散，蔓延方圆数丈，雾气中心俨然是一只巨大的巨兽形状，爪须俱全，栩栩如生。\n");
			wx = ({"金","木","水","火","土",})[random(5)];
			break;
	}
	set("type",wx);
	return 1;
}

void init()
{
	add_action("do_fight",({"fight","kill"}));
}

int do_fight(string arg)
{
	if( !arg || !id(arg) )
		return 0;
	return err_msg("看清楚一点，那并不是生物。\n");
}

string no_leve_msg()
{
	return "雾气遮住了你的视线，你一时辨不清东西南北。你试试填充(give)点"+chinese_number(lvl)+"级"+wx+"灵气给它看看。\n";
}

void create_job(object who)
{
	if( !who || !living(who) || !present(who,environment()) )
	{
		leave();
		return;
	}
	if( !query("type") )
	{
		leave();
		return;
	}
	if( stringp(wx=who->query_temp("maze/50tupo_wx"))
	 && intp(lvl=who->query_temp("maze/50tupo_wxlvl"))
	 && lvl>0 )
		;
	else
	{
		wx = query("type");
		lvl = 2+random(4);
		who->set_temp("maze/50tupo_wx",wx);
		who->set_temp("maze/50tupo_wxlvl",lvl);		
	}	
	tell_object(who,HIC"\n一团雾气挡住了去路，貌似犹如生命一般，你试试填充(give)点"+chinese_number(lvl)+"级"+wx+"灵气给它看看。\n"NOR);
}

int accept_object(object who,object obj)
{
	string wx;
	int lvl;
	
	message_vision(HIC"$N"HIC"将手中的"+obj->name()+HIC"投入$n"HIC"。\n"NOR,who,this_object());
	if( base_name(obj)!="/d/maze/tupo50/obj/qi" )
	{
		destruct(obj);
		return 2;
	}
	if( stringp(wx=who->query_temp("maze/50tupo_wx"))
	 && intp(lvl=who->query_temp("maze/50tupo_wxlvl"))
	 && lvl>0 )
	{
		if( lvl==obj->query("level") && wx==obj->query("type") )
		{
			message_vision(HIC"只见$N"HIC"不住的翻腾，宛若活物。片刻之后，$N"HIC"渐渐淡去，一时间顿时风轻云净。\n"NOR,this_object());
			who->delete_temp("maze/50tupo_wx");
			who->delete_temp("maze/50tupo_wxlvl");
			who->set_temp("maze/50tupo_item_gived",1);
			destruct(obj);
			destruct(this_object());
			return 2;		
		}	 	
	}
	destruct(obj);
	return 2;
}

int is_pet(){return 1;}