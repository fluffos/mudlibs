#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(HIC"照灵丹"NOR,({"zhaoling dan","dan",}));
	set_weight(100);
    	if(clonep())
        	set_default_object(__FILE__);
    	else 
    	{
        	set("unit","颗");
        	set("long","一颗金灿灿的丹药，上面霞光四溢，氤氲中又带着一丝黑纹，甚是诡异。\n");
        	set("value",0);
	}
        setup();
    	set("no_give","这么珍贵的东西怎能给人？\n");
    	set("no_drop","这么珍贵的东西怎能丢弃？\n");
    	set("no_get",1);
    	set("no_put",1);
}

void leave()
{
	remove_call_out("leave");
	if( environment() )
	{
		if( environment()->is_character() )
		{
			message("vision","\n\n”还我宝贝来！“半空忽然现出一只黑色巨手，抓起"+environment()->name()+"身上的"+name()+"，遁入虚空不见了。\n\n",environment(environment()),environment());
			tell_object(environment(),"\n”还我宝贝来！“半空忽然现出一只黑色巨手，一把将"+name()+"抓起，遁入虚空不见了！\n\n");
		}
		destruct(this_object());
	}
}

void init()
{
	if( environment() && environment()->is_character() 
	 && userp(environment()) )
	{
		if( query("owner_id") )
		{
			if( environment()->query("id")!=query("owner_id") )
			{
				remove_call_out("leave");
				call_out("leave",3);
				return;
			}
		}
		else	set("owner_id",environment()->query("id"));
	}	
	add_action("do_eat","eat");
}

int do_eat(string arg)
{
	object me = this_player();
	string file;
	
	if( !arg || !id(arg) )
		return 0;

	message_vision(HIC"$N"HIC"一仰脖，将$n"HIC"整个吞下。\n",me,this_object());
	if( ( !wizardp(me) && 
	      (me->query_level()!=49 || 
	       me->query("combat_exp")<36000000 || 
	       me->query("daoxing")<240000 ) ) 
         || !present(this_object(),me)
         || !query("owner_id")
         || query("owner_id")!=me->query("id") 
         || !environment(me)->is_shenshi() )
	{
		write(HIR"结果你感到一阵恶心，腹中翻江倒海一般，顿时上吐下泻！\n"NOR);
		message("vision",HIR+me->name()+HIR"腹中顿时传来咕噜噜一阵怪响，"+me->name()+HIR"放了一个奇臭无比的响屁。\n"+me->name()+HIR"脸色一会白来一会青，甚是精彩。\n"NOR,environment(me),me);
		me->unconcious();
		destruct(this_object());
		return 1;
	}
	message("vision",HIC+me->name()+HIC"盘膝跌坐，细细体味体中的变化。\n"NOR,environment(me),me);
	write(HIC"你感到全身被浓郁无比的灵气包裹住了。\n"NOR);
	write(HIM"你感到全身法力仿佛沸腾了一般，在体内开始乱窜！\n"NOR);
	write(HIR"你只觉体内法力瞬间一空，尚未反应过来，又被四周灵气填满，一张一弛之间，你只觉修为瓶颈似有突破的迹象。\n"NOR);
	if( random(100)==49 )
	{
		write(HIC"你一时间福至心灵，对天地灵气的领悟加深了。\n"NOR);
		switch(me->query("class"))
		{
			case "yaomo" : arg = "通智";break;
			case "tianmo": arg = "炼体";break;
			case "youling" : 
			case "ghost" : arg = "开灵";break;
			case "bonze" : arg = "脱凡";break;
			default : arg = "旋照";break;
		}
		if( me->level_up() )
			CHANNEL_D->do_channel(this_object(),"rumor",HIY+me->name(1)+HIM"于冥思之中顿悟，突破到「"+HIC+arg+HIM"」的境界！"NOR);
		destruct(this_object());	
		return 1;			
	}
	else
	{
		write(RED"忽然间你感到一丝阴冷的气息从体内迸发而出！\n"NOR);
		message("vision",HIR"忽然"+me->name()+HIR"身上显出一丝阴寒无比的气息，不似此界气息。\n"NOR,environment(me),me);
		write(HIR"你只觉识海中有一股强大的阴寒神识奔袭而来！\n"NOR);
		write("你耳边传来一声声邪恶无比的阴笑：嘿嘿，这次被本魔得手了！\n");
		write(HIR"你觉得对自己的控制好似被这股阴冷神识在渐渐蚕食！\n"NOR);
		me->delete_override("unconcious");
                me->delete_override("die");
                me->delete_override("quit");
                me->clear_condition();
                write(HIC"你慌忙从冥思中清醒了过来。\n"NOR);
		file = me->query_temp("mark/tupo50");
        	if( file_size(file+".lpc")<=0 )
        		file = sprintf("/d/city/baihu-w%d",1+random(3));
        	me->set("maze/tupo-50",time());
        	me->delete_temp("maze");
        	me->delete_temp("mark/tupo50");	
		me->move(file,2);
        	message("vision",HIC"\n"+me->name()+HIC"从冥思中清醒了过来，面带惶恐之色。\n"NOR,environment(me),me);
        	write(HIR"你觉得对肉体的控制好似被一股阴冷神识在渐渐蚕食！\n"NOR);
        	message("vision",HIR+me->name()+HIR"身体一阵颤抖，脸色露出一股凄厉之色。\n"NOR,environment(me),me);
        	write(HIR"你万般无奈下，只得施展门派秘法来逃脱夺舍之劫！\n"NOR);
        	me->add("combat_exp",-50000);
        	me->add("daoxing",-10000);
        	me->delete_temp("last_damage_from");
        	me->set_temp("death_msg","于冥思之中神识遭"HIR"莫知魔物"HIM"侵蚀！"NOR"\n");
        	me->die();
        	destruct(this_object());
		return 1;
	}
}		
