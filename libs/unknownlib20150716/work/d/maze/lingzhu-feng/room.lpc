#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "甬道");
  set("channel_id", "风灵珠副本");
  set("long", @LONG
四周黑漆漆一片，你只有运足眼力，方能看到一尺见方的景象。
你摸索的前行，冷不丁就被自己的喘气声吓了一跳。

LONG);
  set("alternative_die", 1);
  setup();
}

int alternative_die(object who) {
  object target;
  string file, msg;
  if (!who)
    return 1;
  if (!userp(who)) {
    target = who->query_temp("last_damage_from");
    who->clear_condition();
    if (target && present(target, environment(who))) {
      who->reward_ob(target);
      return 0;
    } else {
      message_vision(HIR "$N" HIR "脸色大变。\n" NOR, who);
      return 1;
    }
  }
  target = who->query_temp("last_damage_from");
  if (target)
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      who->name(1) + "在清风寨被" + HIR + target->name() + HIM "杀得落花流水。" NOR
    );
  message_vision(HIR "\n$N" HIR "见机不妙，顾不得许多，慌忙跌跌撞撞的从原路返回。\n\n" NOR, who);
  who->powerup(0, 1);
  file = "/d/gao/room";
  who->move(file, 2);
  who->set("maze/lingzhu-feng", time());
  who->delete_temp("maze");
  message_vision("\n" HIC "$N" HIC "狼狈不堪地从香台下的地洞中跳了出来。\n" NOR, who);
  MAZE_D->restore_status(who);
  return 0;
}

int do_drop(string arg) {
  return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg) {
  string *nocmds, verb = query_verb();
  nocmds = ({
    "recall", "move", "maphere", "map", "find",
    "follow", "gen",
  });
  if (member_array(verb, nocmds) == -1)
    return 0;
  write("ok\n");
  return 1;
}

void init() {
  if (userp(this_player())) {
    add_action("do_cmds", "", 1);
    add_action("do_drop", "drop");
  }
}

void valid_move(object who) {
  object env;
  if (!who || who->query_temp("pending/valid_move")
    || !environment(who))
    return;
  env = environment(who);
  if (env->query("virtual_room"))
    return;
  who->set_temp("pending/valid_move", 1);
  MAZE_D->restore_status(who);
}
