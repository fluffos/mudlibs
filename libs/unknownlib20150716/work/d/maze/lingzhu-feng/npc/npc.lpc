#include <ansi.h> 
inherit NPC;

void create()
{
        set_name("书生", ({"shu sheng","shusheng","sheng",}));
        set("age", 28);
        set_level(8);
        set("per",30);
        set("gender", "男性");
        set("long","一个在外游历的书生，不知为何被清风寨的匪徒撸来此地，难道是因为他长的比较俊俏？o(╯□╰)o\n");
        set("attitude", "friendly");
        set("shen_type", 1);
        set("inquiry",([
        	"记录" : "多谢义士搭救，小生笔墨丹青无所不精，您可以在我这里记录(mark)一下。\n",
        ]));	
	setup();
        carry_object(0,"cloth",1)->wear();
}

void init()
{
	add_action("do_mark","mark");
}

int do_mark(string arg)
{
	int i;
	string str,*tmp,*temp;
	mapping color = ([
		"HIM" : "紫",
		"HIR" : "红",
		"HIC" : "青",
		"HIB" : "蓝",
		"HIY" : "金",
	]);
	if( !arg )
		return notify_fail(name()+"问道：你想记录哪些颜色，多种颜色可以用"HIY" , "NOR"分开。\n示例：mark HIC,HIM");
	arg = replace_string(arg,"，",",");	
	if( strsrch(arg,",")==-1 )
	{
		if( undefinedp(color[arg]) )
			return notify_fail(name()+"说道："+arg+" 这样颜色可没有。\n");
		else	tmp = ({arg});
	}
	else
	{
		temp = explode(arg,",");
		tmp = ({});
		for(i=0;i<sizeof(temp);i++)
		{
			if( undefinedp(color[temp[i]]) )
				return notify_fail(name()+"说道："+temp[i]+" 这样颜色可没有。\n");
			tmp+= ({temp[i]});	
		}
	}
	str = "";
	for(i=0;i<sizeof(tmp);i++)
	{
		str+= color[tmp[i]]+"色";
		if( i<sizeof(tmp)-1 )
			str+= "、";
	}
	this_player()->set_temp("maze/equip_color",tmp);
	write(HIC+name()+HIC"朝你点了点头，拿起笔来，在舌尖蘸了蘸口水，信笔写了下来：今日，"+this_player()->name(1)+"除了"+str+"，其他品质的装备一概不要。\n"NOR);
	return 1;
}