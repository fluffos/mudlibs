string short()
{
        string str = ::short();
        if( !query("my_type") )
                return str;
        return str+NOR"["+query("my_type")+NOR"]";
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void reward_ob(object who)
{
	object zhu;
        
        message_vision (HIR"\n$N"HIR"惨叫一声，阴鸷的眼光死死盯着你，吐出一口精血，顿时脸色煞白。\n$N"HIR"浑身爆出团团血雾，整个人顿时萎靡了不小，不过却也瞬间风驰电掣而去，逃过了性命。\n"NOR,this_object());
        if( !who || !userp(who) || !present(who,environment()) )
        {
                destruct(this_object());
                return;
        }
        if( objectp(zhu=present("feng lingzhu",who))
	 && zhu->is_5zhu() )
	 {
		who->add("combat_exp",150000);
		tell_object(who,HIY"【副本】清风寨：你得到了 "HIR"150000"HIY"点武学经验。\n"NOR);
		destruct(this_object());
		return;
	}
        who->add("combat_exp",50000);
        tell_object(who,HIY"【副本】清风寨：你得到了 "HIR"50000"HIY"点武学经验。\n"NOR);
        zhu = new("/d/obj/baowu/fengzhu");
        if( zhu->move(who) )
	{
		message_vision(HIG"$N"HIG"临走前怀中掉出一颗青光闪闪的珠子。\n"NOR,this_object());
		tell_object(who,"你捡起一颗"HIG"风灵珠"NOR"。\n");
		CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+"得到了"HIG"风灵珠"HIM"。"NOR);
	}
        	
	destruct(this_object());	
}

int is_boss(){return 1;}

int information(object who)
{
	int i,k;
	object ob;
	mapping skill;
	string *skills,*str;
	if( !who || query("createdd") )
		return 0;
	if( !mapp(skill = query_skills())
	 || sizeof(skill)<1 )
	 	return 0;
	if( !pointerp(skills=keys(skill))
	 || sizeof(skills)<1 )
	 	return 0;
		
	set("createdd",1);
	i = who->query_level();
	if( i<this_object()->query_level() )
		i = this_object()->query_level();
	else	i = i/10*10;
	if( i>59 )
		i = 59;
	if( i<39 )
		i = 39;	
	set_level(i);	 
	for(k=0;k<sizeof(skills);k++)
		set_skill(skills[k],i*10);
	
	setup();
	if( query("family/family_name")=="蜀山派" )
		carry_object("/obj/paper_seal")->set_amount(1000);
	carry_object("/obj/money/silver")->set_amount(10+random(40));	
	carry_object("/d/obj/baowu/fengzhu",0,1)->wear();
        str = ({
		"armor","cloth","hand","kui","pifeng","ring","shield","shoes",
		"waist","wrists",
	});
	for(k=0;k<sizeof(str);k++)
	{
		if( objectp(ob=carry_object(0,str[k],1)) )
			ob->set("armor_title",query("name"));
	}
	if( !weapon )
		weapon = "unarmed";
	if( objectp(ob=carry_object(0,weapon,1)) )
		ob->set("weapon_title",query("name"));
	powerup(0,1);
	command("wield all");
	command("wear all");
        return 1;
}

int accept_fight(object who)
{
        tell_object(who,HIC+name()+HIC"对你置若罔闻。\n"NOR);
        return 0;
}

void hurting(object who)
{
	object zhu;
	remove_call_out("hurting");
	if( !who || !present(who,environment()) 
	 || !this_object()->is_fighting(who) 
	 || !living(this_object()) 
	 || query("force")<100 )
	 	return;
	message_vision(HIC"\n$N"HIC"怀中露出一丝霞光异彩，看来是得了一件异宝。\n\n"NOR,this_object());
	add("force",-80);
	stop_busy();
	start_hunluan(0,"");
	start_blind(0,"");
	start_no_move(0,"");
	reset_action();	 	
	exert_function("recover");
	exert_function("refresh");
	if( objectp(zhu=present("feng lingzhu",this_object()))
	 && zhu->is_5zhu() )
		command("cast fjcy");
	call_out("hurting",5,who);
}

void kill_ob(object who)
{
        if( !this_object()->is_fihgting() )
        {
                powerup(0,1);
        	start_busy(0);
        	reset_action();
        }
        if( !query("createdd")
         && !information(who) )
	{
		remove_killer(who);
		who->remove_killer(this_object());
		tell_object(who,HIC+name()+HIC"对你置若罔闻。\n"NOR);
		return;
	}	         
        this_object()->set_follow(who);
        ::kill_ob(who);
        remove_call_out("hurting");
        call_out("hurting",6,who);
}

int is_pet(){return 1;}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
	string str,id;
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	return ::receive_damage(type,damage,who,attack_type);			
}			

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	string id,str;
	if( !who || who==this_object() || !objectp(who) || damage<10 )
		return ::receive_wound(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_wound(type,damage,who,attack_type);	
	
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	
	return ::receive_wound(type,damage,who,attack_type);
}

string long()
{
	string str,long = ::long();
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
	 	return long;
		 	
	str = COLOR_D->clean_color(str);	
	switch(str)	
	{
		case "厚土" : long+= HIC"BOSS特效：物理免疫。\n"NOR;break;
		case "驭法" : long+= HIC"BOSS特效：法术免疫。\n"NOR;break;
		case "轻灵" : long+= HIC"BOSS特效：busy状态下伤害降低。\n"NOR;break;
		case "彪悍" : long+= HIC"BOSS特效：物理伤害提高100%。\n"NOR;break;
		case "通灵" : long+= HIC"BOSS特效：法术伤害提高100%。\n"NOR;break;
		case "吸血" : long+= HIC"BOSS特效：击中回复自己1.25%的气血值。\n"NOR;break;
		case "偷心" : long+= HIC"BOSS特效：击中回复自己3%的法力值。\n"NOR;break;
		case "反戈" : long+= HIC"BOSS特效：受到伤害的50%反弹给攻击者。\n"NOR;break;
		case "登峰" : long+= HIC"BOSS特效：物理命中提高100%。\n"NOR;break;
		case "震古" : long+= HIC"BOSS特效：法术命中提高100%。\n"NOR;break;
		case "死锋" : long+= HIC"BOSS特效：死亡时释放物理伤害。\n"NOR;break;
		case "死毒" : long+= HIC"BOSS特效：死亡时释放毒伤害。\n"NOR;break;
		case "死幻" : long+= HIC"BOSS特效：死亡时释放混乱伤害。\n"NOR;break;
		case "换日" : long+= HIC"BOSS特效：击中回复自己3%的内力值。\n"NOR;break;
	}
	return long;	
}

mixed hit_ob(object me, object who,int damage,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return 0;
	if( !living(me) || !who || !me->is_fighting(who) || damage<=0 )
		return 0;
	str = COLOR_D->clean_color(str);	
	switch(str)
	{
		case "彪悍" : //物理伤害提高100%
			if( attack_type==TYPE_COMBAT || attack_type==TYPE_PERFORM || attack_type==TYPE_QUICK )
				return damage;
			break;	
		case "通灵" : //法术伤害提高100%
			if( attack_type==TYPE_CAST || attack_type==TYPE_CAST_2 )
				return damage;
			break;	
		case "吸血" : //击中回复自己1%的气血值
			me->receive_heal("kee",me->query_maxkee()/80+1);
			me->receive_curing("kee",me->query_maxkee()/80+1);
			return RED"$N"RED"开始疯狂的吸血！\n"NOR;
		case "偷心" : //击中回复自己2%的法力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/30+1);
				return HIC"$N"HIC"只觉得自己的法力越来越充沛了。\n"NOR;
			}
			break;
		case "换日" : //击中回复自己2%的内力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/50+1);
				return HIC"$N"HIC"只觉得自己的内力越来越充沛了。\n"NOR;
			}
			break;
			
	}
	return 0;		
}

int is_maze(){return 1;}
