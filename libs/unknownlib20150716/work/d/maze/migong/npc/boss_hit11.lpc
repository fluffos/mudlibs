//朱厭 有一種野獸，身形象猿猴，白頭紅腳，名叫朱厭。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(10) == 5)
    return 1;
  if (random(2)) {
    if (time() < (target->query_temp("no_perform/start") + target->query_temp("no_perform/time")))
      return 1;
    msg = HIB "\n$N" HIB "狠命捶打自己的胸膛，仰面发出一声怒吼！\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("no_perform", ([
      "start": time(),
      "time": 15,
      "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的吼叫所扰，顿时章法全无，发不出招来。\n" NOR,
    ]));
  }
  return 1;
}
