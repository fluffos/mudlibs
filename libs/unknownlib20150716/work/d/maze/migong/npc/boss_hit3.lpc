//《當康》 又稱牙豚，是一種兆豐穰之瑞獸，樣子象豬而有牙，其叫聲有如呼喚自己的名字。 
#include <ansi.h>
#include <combat.h>

int hit(object me, object target)
{
	int damage;
	string msg; 
	if( !me || !target || !me->is_fighting(target)
	 || me->is_die() )
		return 0;	 
	if( random(5)==3 )
		return 0;
	damage = target->query("max_kee")/10;			
	msg = HIY"\n$N"HIY"哼哼直叫，四脚在原地蹬了蹬，";
	if( random(2) )
		msg+= HIY"顿时如离弦之箭一般，撅起口中獠牙冲向$n"HIY"！\n"NOR;
	else	msg+= HIY"顿时化作一块巨石，砸向$n"HIY"！\n"NOR;
	message_vision(msg,me,target);	
	msg = HIR"$n"HIR"闪避不及，给打了个正着，顿时血光飞溅！\n"NOR;
	message_combatd(msg,me,target);
	damage = target->receive_wound("kee",damage,me,TYPE_PERFORM);
	if( damage>0 )
	{
		COMBAT_D->report_status(target,1);
		if( COMBAT_D->query_message_type(me,target)>=2 )
			message_vision("结果对$N造成了"HIR+damage+NOR"点气血损失。\n",target);
	}
	return 1;
}
				