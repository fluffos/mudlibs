//狞兽
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  if (random(2)) {
    if (time() < (target->query_temp("no_perform/start") + target->query_temp("no_perform/time")))
      return 1;
    msg = HIB "\n$N" HIB "仰面发出一声嘶叫，顿时四周尽被$P发出的青光笼罩！\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("no_perform", ([
      "start": time(),
      "time": 5,
      "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的嘶叫所扰，顿时章法全无，发不出招来。\n" NOR,
    ]));
  }
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(20) == 15)
    return 1;
  if (random(2)) {
    msg = HIY "\n$N" HIY "将身一摇，五次尾巴依次对$n" HIY "发出暴风骤雨般的攻击！\n" NOR;
    msg += HIR "第一下直扫$n" HIR "的$l！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg);
    msg = HIR "第二下直扫$n" HIR "的$l！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg);
    msg = HIR "第三下直扫$n" HIR "的$l！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg);
    msg = HIR "第四下直扫$n" HIR "的$l！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg);
    msg = HIR "最后一下直扫$n" HIR "的$l！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg);
  }
  return 1;
}
