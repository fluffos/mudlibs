//屏蓬，生兩個頭，各在一端，意志處處相對，一個頭想走那邊，一個頭想走這邊，扯來扯去，移不動尺寸之地。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target)
{
	mixed b;
	string msg; 
	if( !me || !target || !me->is_fighting(target)
	 || me->is_die() )
		return 0;	 
	if( random(5)==3 )
		return 0;
	msg = HIB"\n$N"HIB"双头意志处处相对，半响之中移不动尺寸之地，";
	if( !me->query_temp("apply/powerup") )
	{
		msg+= HIB"$N"HIB"一头忽怒吼一声，另一头顿时萎靡不振，$N"HIB"趁势对$n"HIB"发起猛烈攻击！\n"NOR;
		me->set_temp("apply/powerup",1);
		me->stop_busy();
		me->add("max_kee",me->query_maxkee()/2);
		me->add("eff_kee",me->query_maxkee()/2);
		me->add("kee",me->query_maxkee()/2);
		me->add("max_sen",me->query_maxsen()/2);
		me->add("eff_sen",me->query_maxsen()/2);
		me->add("sen",me->query_maxsen()/2);
		me->add("max_force",me->query_maxforce()/2);
		me->add("force",me->query_maxforce()/2);
		me->add("max_mana",me->query_maxmana()/2);
		me->add("mana",me->query_maxmana()/2);
		me->add_temp("apply/combat_damage",me->query_temp("apply/combat_damage")/2);
		me->add_temp("apply/combat_def",me->query_temp("apply/combat_def")/2);
		me->add_temp("apply/spells_damage",me->query_temp("apply/spells_damage")/2);
		me->add_temp("apply/spells_def",me->query_temp("apply/spells_def")/2);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg);
		me->set_temp("action_flag",1);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
		me->set_temp("action_flag",0);
		return 1;
	}
	if( !target->is_busy() && random(3)==0 )
	{
		msg+= HIB"$N"HIB"双头仰天，齐齐怒吼，顿时间地动山摇！\n"NOR;
		msg+= HIY"$n"HIY"只觉脚下摇晃不定，难以站立，不由慌了手脚。\n"NOR;
		message_vision(msg,me,target);
		b =  target->query_busy();
		if( intp(b) && b>0 )
			target->start_busy(b+3);
		else	target->start_busy(3);	
		return 1;
	}
	return 0;
}
				