//相柳
#include <ansi.h>
#include <combat.h>

int hit(object me, object target)
{
	int damage;
	string msg,*types,*tmp,tt; 
	if( !me || !target || !me->is_fighting(target)
	 || me->is_die() )
		return 0;	 
	me->stop_busy();
	QUEST_D->randomPfm(me);
	msg = HIY"\n$N"HIY"将身一盘，凌空飞起，俯身吐出阵阵五颜六色的瘴气！\n"NOR;
	message_vision(msg,me,target);
	types = ({"busy","hurt","hurt2","no_cast","no_pfm",});
	tt = types[random(sizeof(types))];
	tmp = target->query_temp("xiangliu");
	if( !tmp || !arrayp(tmp) )
		tmp = ({});
	if( member_array(tt,tmp)==-1 )
		tmp+= ({tt});
	target->set_temp("xiangliu",tmp);	
	target->apply_contidion("xiangliu_hurt",(int)target->query_condition("xiangliu_hurt")+5);		
	return 1;
}
				