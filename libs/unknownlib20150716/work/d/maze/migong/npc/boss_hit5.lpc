//諸犍 古代神獸,人面豹身，牛耳一目，有長尾，能發巨聲。行走時銜著尾巴，休息時盤著尾巴。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(8) == 5)
    return 1;
  if (time() < (target->query_temp("no_perform/start") + target->query_temp("no_perform/time")))
    return 1;
  msg = HIY "\n$N" HIY "仰面发出一声巨吼，顿时四周尽被$P发出的金光笼罩！\n" NOR;
  message_vision(msg, me, target);
  target->set_temp("no_perform", ([
    "start": time(),
    "time": 5,
    "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的吼声所扰，顿时章法全无，发不出招来。\n" NOR,
  ]));
  return 1;
}
