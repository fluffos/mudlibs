//當扈 傳說中的鳥名 
#include <ansi.h>
#include <combat.h>

int hit(object me, object target)
{
	int damage;
	string msg; 
	if( !me || !target || !me->is_fighting(target)
	 || me->is_die() )
		return 0;	 
	me->stop_busy();
	QUEST_D->randomPfm(me);
	if( random(10)==5 )
		return 1;
	damage = target->query("max_kee")/5;	
	msg = HIC"\n$N"HIC"扇动双翅，凌空飞起，俯身发出一身长吟！";
	if( random(2) )
	{
		msg+= HIC"只见凭空忽现数道风刃，风驰电掣般朝$n"HIC"飞去！\n"NOR;
		msg+= HIR"$n"HIR"躲闪不及，被割得片体鳞伤，血肉模糊。\n"NOR;
		message_vision(msg,me,target);
		damage = target->receive_wound("kee",damage,me,TYPE_CAST);
		if( damage>0 )
		{
			COMBAT_D->report_status(target,1);
			if( COMBAT_D->query_message_type(me,target)>=2 )
				message_vision("结果对$N造成了"HIR+damage+NOR"点气血损伤。\n",target);
		}
	}
	else
	{
		msg+= HIC"顿时半空乌云密布，一道圆柱粗细的怒雷呼啸而已，直扑$n"HIC"！\n"NOR;
		msg+= HIR"$n"HIR"闪避不及，给打了个正着，顿时一身焦黑！\n"NOR;
		message_vision(msg,me,target);
		damage=target->receive_wound("sen",damage,me,TYPE_CAST);
		if( damage>0 )
		{
			COMBAT_D->report_sen_status(target,1);
			if( COMBAT_D->query_message_type(me,target)>=2 )
				message_vision("结果对$N造成了"HIR+damage+NOR"点精神损伤。\n",target);
		}
	}
	return 1;
}
				