//中國古代傳說中的旱魃之兆。據說肥遺是一種居住在太華山山麓的怪蛇，有一個頭、兩個身體、六條腿和四只翅膀。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target)
{
	int b,damage;
	string msg; 
	if( !me || !target || !me->is_fighting(target)
	 || me->is_die() )
		return 0;	 
	me->stop_busy();
	QUEST_D->randomPfm(me);
	if( random(10)==5 )
		return 1;
	if( random(2) )
	{
		if( time()<(target->query_temp("no_perform/start")+target->query_temp("no_perform/time")) )
			return 1;	
		msg = HIB"\n$N"HIB"仰面发出一声嘶叫，顿时四周尽被$P发出的青光笼罩！\n"NOR;
		message_vision(msg,me,target);	
		target->set_temp("no_perform",([
			"start" : time(),
			"time"  : 5,
			"msg"	: HIR"\n你刚想发招，却被"+me->name()+HIR"的嘶叫所扰，顿时章法全无，发不出招来。\n"NOR,
		]));
	}
	switch(random(10))
	{
		case 0 :
		case 9 :
			msg = HIC"\n$N"HIC"将巨翅一扇，顿时平地出现一股怪风，夹带着一股腥气直扑$n"HIC"！\n"NOR;
			msg+= HIR"$n"HIR"顿时忙中出错，招不成招。\n"NOR;
			message_vision(msg,me,target);
			b =  target->query_busy();
			if( intp(b) && b>0 )
				target->start_busy(b+1);
			else	target->start_busy(2);	
			break;
		case 1 :
		case 8 :
		case 2 :
		case 7 :
			msg = HIR"\n$N"HIR"将身一裹，顿时化作一团火球，夹带着浓烟热浪冲向$n"HIR"！\n"NOR;	
			msg+= HIB"$n"HIB"闪避不及，被烧得焦头烂额，浑身四处焦黑！\n"NOR;
			message_vision(msg,me,target);
			damage = target->query("max_kee")/10;
			damage = target->receive_damage("kee",damage,me,TYPE_CAST);
			if( damage>0 )
			{
				COMBAT_D->report_status(target);
				if( COMBAT_D->query_message_type(me,target)>=2 )
					message_vision("结果对$N造成了"HIR+damage+NOR"点气血减少。\n",target);
			}
			break;			
		default :
			if( time()>me->query_temp("PWUP/start")+me->query_temp("PWUP/time") )
			{
                                msg = HIB"\n$N"HIB"将身一盘，浑身卷作一团，顿时浑身上下毫无破绽！\n"NOR;
				message_vision(msg,me,target);
				me->start_busy(2);
				me->set_temp("PWUP",([
					"start" : time(),
					"time"  : 15,
				]));	
			}
			break;
	}			
	return 1;
}
				
