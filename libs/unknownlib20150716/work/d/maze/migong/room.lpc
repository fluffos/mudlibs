// room.c
#include <ansi.h>
inherit ROOM;

nosave object owner = 0;
nosave string Short = "长平尸坑%s层";
nosave int snowtu = 0;

void get_input(string arg, object me);
void get_input2(string arg, object me);
void player_fail(object who);

string _query_today()
{
	mixed *local;
	local = localtime(time());      
        return sprintf("%d年%d月%d日",local[5],local[4]+1,local[3]);
}		

void dest_self()
{
	destruct(this_object());
}		

void set_owner(object who)
{
	if( !who || !living(who) )
		return;
	if( owner && owner!=who )
		return;	
	owner = who;
}

void clear_room()
{
	owner = 0;
	remove_call_out("dest_self");
	call_out("dest_self",5);
	return;
}	
	
int valid_leave(object me, string dir)
{
	string msg;
	object room,evl;
	int i,v,flag=0;
	if( !userp(me) || !living(me) )
		return 0;
	if( !clonep(this_object()) )
		return 0;
	if( !owner || me!=owner )
		return 0;
	if( !intp(v=query("num"))
	 || v<1 )
		return 0;
	if( me->query("Migong/last_enter")==_query_today() )
		return notify_fail("你今天已经失败了。\n");			
	if( dir=="down" )
	{
		evl = query("guai");
		if( evl )
			flag = 1;
		if( flag>0 )
			return notify_fail("你尚未清除所有魔物，如何走得？！\n");
		if( me->query("Migong/clear_num")!=query("num") )
			return notify_fail("你尚未清除所有魔物，如何走得？！\n");
		
                if( v>90 && v%10==0 )
		{
			msg = HIY+me->query("name")+HIM"闯过了「"HIR"长平尸坑"HIM"」第"+chinese_number(v)+"层";
			if( v!=100 )
				msg+= "！"NOR;
			else	msg+= "，实在是功德无量！"NOR;	
			CHANNEL_D->do_channel(this_object(),"rumor",msg);
			player_fail(me);
			return 2;
		}
		snowtu = 0;
		v+= 1;		
		room = this_object();
		room->set_owner(me);
		room->set("num",v);
		if( !room->init_guai(me) )
		{
			destruct(room);
			return notify_fail("\n耳边忽地传来一阵令人心烦的哭声，你有点疑神疑鬼。。。。\n\n");
		}
		message_vision("\n\n"NOR HBRED HIY"你纵步而下跳入！"NOR"\n\n",me);
		me->command("look");
		if( room->query("guai") )
		{
			(room->query("guai"))->kill_ob(me);
			me->fight_ob(room->query("guai"));
		}
		return 2;	
	}		
	return ::valid_leave(me,dir);				
}

void create()
{
	set ("short","长平尸坑%s层");
        set ("long", HIR+@LONG
满眼望去，只见一片血色的红！你感到了莫名的悲伤。。。。
LONG+NOR);
        set("outdoors", "xuechi");
        set("exits",([
        	"down" : __FILE__,
        ]));
        set("item_desc",([
        	"down" : "\n满眼望去，只见一片血色的红！你感到了莫名的悲伤。。。。\n\n",
        ]));
        set("virtual_room",1);
        set("alternative_die",1);		
        setup();
}

void init_hp(object who)
{
	if( !who || !living(who) )
		return;
	who->remove_all_killer();
	all_inventory()->remove_killer(who);
	who->powerup();
	who->start_busy(1);
}	

void player_fail(object who)
{
	if( !who )
		return;
	who->delete("Migong/die");	
	who->delete("Migong/clear_num");
	who->delete("Migong/first");
	who->set("Migong/last_num",query("num"));
	who->set("Migong/last_enter",_query_today());
	tell_object(who,HIY"\n你离开了长平尸坑。\n\n"NOR);
	if( who->query("startroom") )
		who->move(who->query("startroom"));	
	else
		who->move("/d/city/kezhan");	
}

int alternative_die(object who)
{
	object guai,target;
	int i;
	if( !userp(who) || !owner || owner!=who )
		return 1;
	if( userp(who) )
	{
		if( who->query("Migong/last_enter")==_query_today() )
			return 1;
		init_hp(who);
		player_fail(who);
		return 0;
	}
}

int init_guai(object who)
{
	object guai;
	int v,i,l;
	if( !v=query("num") || !who || !living(who)
	 || !clonep(this_object()) )
		return 0;
	if( snowtu>0 )
		return 0;
	l = 15+v+random(2);
	if( v<30 )
	{
		if( v%10!=0 )
		{
			if( l<30 )
				l = 30;	
			i = v/10+random(2)+1;
			guai = new("/d/maze/migong/npc/guai");
			if( !guai->move(this_object()) )
			{
				destruct(guai);
				return 0;
			}
			guai->set_level(l);
			guai->set_num(i);
			guai->set_owner(who);
			guai->init_guai();
		}
		else
		{
			if( v==10 )
				l = 40;
			else if( v==20 )
				l = 49;
			guai = new("/d/maze/migong/npc/boss");
			if( !guai->move(this_object()) )
			{
				destruct(guai);
				tell_object(who,HIR"好似出问题了，请联系当值巫师。\n"NOR);
				return 0;
			}
			guai->set_level(l);
			guai->set_num(1);
			guai->set_owner(who);
			guai->init_guai();
			guai->add_temp("apply/def_combat",300+v*10);
			guai->add_temp("apply/def_spells",300+v*10);
		}
	}
	else
	{
		if( v%5!=0 )
		{
			i = v/10+random(3)+1;
			if( l<30 )
				l = 30;	
			guai = new("/d/maze/migong/npc/guai");
			if( !guai->move(this_object()) )
			{
				destruct(guai);
				return 0;
			}
			guai->set_level(l);
			guai->set_num(l);
			guai->set_owner(who);
			guai->init_guai();
		}
		else
		{
			l = v+15+random(5);				
			guai = new("/d/maze/migong/npc/boss");
			if( !guai->move(this_object()) )
			{
				destruct(guai);
				tell_object(who,HIR"好似出问题了，请联系当值巫师。\n"NOR);
				return 0;
			}
			guai->set_level(l);
			guai->set_num(1);
			guai->set_owner(who);
			guai->init_guai();
			guai->add_temp("apply/def_combat",300+v*10);
			guai->add_temp("apply/def_spells",300+v*10);
		}	
	}
	guai->set("room_num",v);
	if( guai->query("title")==HIR"荒神"NOR )
		guai->set("long","被战神白起以十万士兵之血镇压的远古荒神。\n");
	else	guai->set("long","被战神白起以十万士兵之血镇压的远古荒兽。\n");	
	guai->set("looking",guai->my_look());
	guai->set("rank_info/pos_msg",HIB"浑身魔气冲天，宛如实物。"NOR"\n");
	set("guai",guai);
	snowtu = 1;
	set("short",sprintf(Short,chinese_number(query("num"))));
	return 1;
}

int is_Migong(){return 1;}

void valid_move(object who)
{
	if( who && userp(who) && environment(who)
	 && !environment(who)->is_Migong() 
	 && clonep(this_object()) )
	 {
	 	if( who->query("Migong/last_num")<this_object()->query("num") )
	 		who->set("Migong/last_num",this_object()->query("num"));
	 }		
}

void init()
{
	add_action("do_list","list");
	add_action("do_buy","buy");
}

int do_list(string arg )
{
	string str;
	object me = this_player();
	str = "◎长平副本\n";
	str+= sprintf("\t上次进入日期：%s\n",(me->query("Migong/last_enter")?(me->query("Migong/last_enter")+""):"尚未失败") );
	str+= sprintf("\t上次到达层数：%s\n",chinese_number(me->query("Migong/last_num",query("num"))));
	str+= sprintf("\t目前有长平积分：%d\n",me->query("Migong/score"));
	str+= "◎副本兑换\n";	
	str+= "你可以兑换(buy)以下材料：\n";
	str+= @LONG
	  物品  	       兑换积分             描述
---------------------------------------------------------------------------------      	
	行军丹x1		 1		瞬间恢复人物各状态的50%
	护生云丹x1               3 		瞬间恢复人物各状态的100%
---------------------------------------------------------------------------------      		
	碧藕x1		         5		减少人物年龄	
	火枣x1			 6              减少人物年龄	
	交梨x1			 7	        减少人物年龄	
	寿元丹x1		 10		增加人物寿元
---------------------------------------------------------------------------------      		
	百川符x1		 20		可以使装备融合(ronghe)同类型装备
						的属性，融合值为被吸收装备的10%。
---------------------------------------------------------------------------------      
LONG;
	str = replace_string(str,"x1",HIY"x"HIR"1"NOR);
	me->start_more(str);
	return 1;      	
}

int do_buy(string arg)
{
	int v;
	string str,file;
	object ob,me = this_player();
	mapping goods = ([
		"行军丹"   : ({"xdan",1}),
		"护生云丹" : ({"yundan",3}),
		"碧藕"     : ({"biou",5}),
		"火枣"     : ({"huozao",6}),
		"交梨"     : ({"jiaoli",7}),
		"寿元丹"   : ({"life",10}),
		"百川符"   : ({"hebing",20}),				
	]);
	if( me->is_fighting() || me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
	if( !arg || undefinedp(goods[arg]) )
		return err_msg("\n你可以兑换下列物品：\n
	行军丹		需要1点长平积分		瞬间恢复人物各状态的50%
	护生云丹	需要3点长平积分		瞬间恢复人物各状态的100%
	碧藕		需要5点长平积分		降低人物年龄	
	火枣		需要6点长平积分		降低人物年龄	
	交梨		需要7点长平积分		降低人物年龄		
	寿元丹		需要10点长平积分	增加人物寿元1点
	百川符		需要20点长平积分	可以使装备融合(ronghe)同类型装备
						的属性，融合值为被吸收装备的10%。
						
");
	file = goods[arg][0];
	v = goods[arg][1];
	if( me->query("Migong/score")<v )
		return err_msg("兑换"HIC+arg+NOR"需要消耗"HIR+v+NOR"点副本积分，你的积分不够。\n");
	
	ob = new("/d/maze/migong/obj/"+file);
	if( !ob->move(me) )
	{
		destruct(ob);
		return err_msg("\n"HIR"【系统】你的包裹满了。\n"NOR);
	}
	
	write(HIG"【副本】长平尸坑：你得到了"HIC+arg+HIG"。\n"NOR);
	me->add("Migong/score",-v);
	str = sprintf("%s %s 兑换了 %s。\n",_query_today(),me->query("id"),arg);
	log_file("changping",str);
	return 1;
}

string long()
{
	int i,k;
	object *inv;
	string str,arg,*msgs;
	str = HIY"【"NOR+query("short")+HIY"】"NOR"\n\n";
	str+= query("long")+"\n";
	str = sort_string(str,76,0); 
	str+= "    这里唯一的出口是 "HIG"down"NOR" 。\n";
	if( stringp(arg = read_file("/log/changping"))
	 && strlen(arg)>2 )
	{
		msgs = explode(arg,"\n");
		i = 3;
		if( i>sizeof(msgs) )
			i = sizeof(msgs);
		if( i==0 )
			return str;
		arg = NOR HIY"┏────────────────────┓"NOR"\n";
		arg+= NOR HIY"│                                        │*"NOR"\n";
		for(k=0;k<i;k++)
			arg+= sprintf(NOR HIY"│"HIG"%40-s"HIY"│*"NOR"\n",msgs[k]);
		arg+= NOR HIY"│                                        │*"NOR"\n";			
		arg+= NOR HIY"┗────────────────────┛"NOR"\n";	
		str = ("/cmds/std/look.lpc")->mix_arg(COLOR_D->clean_color(str),COLOR_D->clean_color(arg),58);
		str = replace_string(str,"【",NOR+HIY"【"NOR);
		str = replace_string(str,"】",NOR+HIY"】"NOR);
		str = replace_string(str,"┏",NOR+HBBLU+HIY"┏");
		str = replace_string(str,"┓","┓"NOR);
		str = replace_string(str,"│",NOR HBBLU+HIY"│"HIG);
		str = replace_string(str,"*",NOR"");
		str = replace_string(str,"┗",NOR HBBLU+HIY"┗");
		str = replace_string(str,"┛","┛"NOR);
		str = replace_string(str,"down",HIG"down"NOR);
	}
	
	inv = all_inventory();
	i=sizeof(inv);
	while(i--) 
        {
        	if( !this_player()->visible(inv[i]) ) 
        		continue;
        	if( inv[i]==this_player() ) 
        		continue;
        	else    str+= "  " + inv[i]->short() + "\n";
        }
	
	return str;
}
