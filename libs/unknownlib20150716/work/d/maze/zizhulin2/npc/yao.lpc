			set_skill("pingtian-dafa",default_level);
			map_skill("spells","pingtian-dafa");
			set_skill("huomoforce",default_level);
			map_skill("force","huomoforce");
			set_skill("moyun-shou",default_level);
			map_skill("unarmed","moyun-shou");
			set_skill("moshenbu",default_level);
			map_skill("dodge","moshenbu");
			set_skill("wuyue-spear",default_level);
			set_skill("huoyun-qiang",default_level);
			set_skill("dali-bang",default_level);
			map_skill("stick","dali-bang");

