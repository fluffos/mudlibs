			map_skill("force","jiuyin-xinjing");
			set_skill("lanhua-shou",default_level);
			map_skill("unarmed","lanhua-shou");
			set_skill("yueying-wubu",default_level);
			map_skill("dodge","yueying-wubu");
			set_skill("yinsuo-jinling",default_level);
			map_skill("whip","yinsuo-jinling");
			set_skill("qingxia-jian",default_level);
