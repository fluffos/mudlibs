//seng putuo
#include <ansi.h>
#include <combat.h>
inherit NPC;

nosave string weapon_type = "unarmed";
nosave int Die = 0;
nosave int Num = 1;
nosave int Super = 0;
nosave int default_level = 390;

void init_skill()
{
	string *skills;
	object *inv;
	int i;
	mapping skill;
	skill = query_skills();
	if( !skill || !mapp(skill) )
		return;
	skills = keys(skill);
	if( skills && arrayp(skills) )
	{
		for(i=0;i<sizeof(skills);i++)
			delete_skill(skills[i]);
	}
	inv = all_inventory();
	if( intp(i=sizeof(inv)) && i>0 )
	{
		while(i--)
		{
			if( !userp(inv[i]) )
			{
				inv[i]->unequip();
				inv[i]->move("/obj/empty");
				REMOVE_D->add_obj(inv[i],1);
			}
			else	inv[i]->move("/obj/void");
		}	
	}
	reset_action();	
}

void init_family(int default_level)
{
	string weapon,fam,*files;
	object ob;
	int i;
	init_skill();
	delete("family");
	if( default_level<390 )
		default_level = 390;
	set_skill("force",default_level);
	set_skill("spells",default_level);
	set_skill("dodge",default_level);
	set_skill("parry",default_level);
	set_skill("literate",default_level);
	set_skill("unarmed",default_level);
	set_skill("axe",default_level);
	set_skill("blade",default_level);
	set_skill("dagger",default_level);
	set_skill("fork",default_level);
	set_skill("hammer",default_level);
	set_skill("mace",default_level);
	set_skill("rake",default_level);
	set_skill("spear",default_level);
	set_skill("staff",default_level);
	set_skill("stick",default_level);
	set_skill("sword",default_level);
	set_skill("throwing",default_level);
	set_skill("whip",default_level);
	if( this_object()->query_level()>=40 )
		set("shentong/40",sprintf("%s_%s_%d",({"金","木","水","火","土",})[random(5)],({"阴","阳",})[random(2)],1+random(7)));
	
	fam = "南海普陀山";
	set_skill("buddhism",default_level);
	map_skill("spells","buddhism");
	set_skill("lotusforce",default_level);
	map_skill("force","lotusforce");
	set_skill("jienan-zhi",default_level);
	map_skill("unarmed","jienan-zhi");
	set_skill("lotusmove",default_level);
	map_skill("dodge","lotusmove");
	set_skill("cibeidao",default_level);
	map_skill("blade","cibeidao");
	set_skill("lunhui-zhang",default_level);
	map_skill("staff","lunhui-zhang");

	if( random(2) )
	{
		map_skill("parry","cibeidao");
		weapon = "blade";
	}
	else
	{
		map_skill("parry","lunhui-zhang");
		weapon = "staff";
	}
	set_skill("jingang-sanmei",default_level);
	set_skill("jingang-zhenshen",default_level);
	set_skill("liuli-xindeng",default_level);
	set_skill("longxiang-li",default_level);
	set_skill("qu-yue",default_level);
	set_skill("tianlong-chanchang",default_level);	
	
	create_family(fam,3,"");
	set("title","");
	carry_object(0,weapon,1)->wield();
	files = ({
               "armor","cloth","hand","kui","neck","pifeng","ring","shield","shoes","waist","wrists",
    	});
    	for(i=0;i<sizeof(files);i++)
    	{
    		if( objectp(ob=carry_object(0,files[i],1)) )
    		{
    			("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
    			ob->wear();
    		}
	}
}

int query_max_hp(object who)
{
	int level,num;
	level = this_object()->query_level();
	if( !who ) 
	{
		if( level>=60 )
			return 7000+level*1000;
		else	return 4000+level*800;
	}
	num = (who->query_temp("maze/killed")+1)*550;
	if( num>25000 )
		num = 25000;
	if( level>=60 )
		return 10000+num;
	else	return 4000+num/2+800;		
}

int information(object who)
{
	int kee,lvl;
	if( !who || !environment(who) 
	 || !environment(who)->is_zzl() )
		return 0;
	
	lvl = who->query_level()/10*10+9;
	if( lvl<39 )
		lvl = 39;
	set_level(lvl);
	kee = query_max_hp(who);
	default_level =lvl*10;
	init_family(default_level);
	set("max_kee",kee);
	set("max_sen",kee);
	set("max_force",default_level*15);
	set("max_mana",default_level*18);
	setup();
	powerup(0,1);
	set("force",this_object()->query_maxforce()*2);
	set("mana",this_object()->query_maxmana()*2);
	set("mana_factor",default_level*2);
	set("force_factor",default_level*2);
	set("daoxing",this_object()->query_max_daoxing());
	set("valid_time",time());
	
	this_object()->move(environment(who));
	message_vision(HIB"\n一道狂风刮过，平地里多出一位奇形怪状的僧人。\n"NOR CYN"僧人用锐利的目光盯着$n"CYN"，口中「嘿嘿嘿．．．．」地奸笑着。\n"NOR HIR"那僧人忽的变了颜色，口中呢喃道：诚心念佛，奈何佛祖不偈，不然杀杀杀杀杀！\n"NOR,this_object(),who);
	this_object()->kill_ob(who);
	who->fight_ob(this_object());
	this_object()->set_follow(who);
	return 1;
}

void create()
{
	string name;
	
	name = ({"破戒","好色","嗔怒","入魔","贪吃",})[random(5)];
	name+= "的";
	name+= ({"僧人","和尚","头陀","沙弥","僧侣",})[random(5)];
	set_name(name,({"seng ren","he shang","seng"}));
	set("long",name+"，在紫竹林中就地思过。\n");
	set("no_sleep",1);
	set("任务",1);
	set("env/test","HIM");
	set("env/brief_message",3);
	setup();
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void super_hit()
{
	int t = 3+random(3);
	Super = 0;
	QUEST_D->addEffKee(this_object());
	QUEST_D->addKee(this_object());
	QUEST_D->addSen(this_object());
	QUEST_D->addEffSen(this_object());
	if( this_object() && this_object()->is_fighting()
	 && living(this_object()) )
	{	 
		this_object()->stop_busy();
		Super = 1;
		QUEST_D->randomPfm(this_object());
	}	
	remove_call_out("super_hit");
	call_out("super_hit",t);
}

void kill_ob(object who)
{
	if( !who || !present(who,environment()) )
	{
		this_object()->powerup(1);
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( Die==1 )
	{
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( this_object()->is_fighting(who) )
		return;
	remove_call_out("super_hit");
	if( Super==0 )
		super_hit();	
	::kill_ob(who);
	if( this_object()->query_level()>=40 )
		command("cast xiaoshen");		
}

int follow_me(object ob, string dir)
{
	if( !ob || !living(this_object()) || ob==this_object() ) 
		return 0;
	if( ob==follow
	||(query("pursuer") && this_object()->is_killing(ob->query("id")))) 
		return follow_path(dir);
	return 0;
}

void reward_ob(object who)
{
        object ob;
        int i,succ,num;
        mixed *env,*dir;
        string color,file,str,arg="";

        if( !who || !userp(who) || !present(who,environment()) )
        {
        	message_vision(HIB"\n$N"HIB"化作一道青烟随风散去。\n\n"NOR,this_object());
        	this_object()->move("/obj/empty");
        	REMOVE_D->add_obj(this_object(),1);
                return;
        }

	message_vision(HIC"\n$N"HIC"连声讨饶：莫打莫打！哎呦喂，"+(who->query("gender")=="女性"?"姑奶奶":"爷爷")+"呀，您下手也忒重了！小的诚心认错。。。。\n道罢，$N"HIC"将顶梁一甩，露出亮锃锃的脑袋来，口诵佛号，垂首合什而去。\n"NOR,this_object());
        who->add_temp("maze/killed",1);
        num = who->query_temp("maze/killed");
        
        if( !arrayp(env=who->query_temp("maze/equip_color")) )
        	env = 0;   
        	
        i = who->query_spi()/15;
        i = random(i)+1;
        if( i>3 )
        	i = 3;
        while(i--)	
        {
        	succ = who->query_kar(); 
		succ = random(who->query_kar())/5;
		succ+= random(num);
        	if( succ>4 )
		{                
         		dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",});
               		file = dir[random(sizeof(dir))];
			ob = new("/d/obj/narmor/"+file);
			if( random(100)>95 )
				set("env/test","HIM");
			else if( random(100)>75 )
				set("env/test",({"HIM","HIR",})[random(2)]);
			else if( random(100)>50 )	
				set("env/test",({"HIM","HIR","HIB"})[random(3)]);
			else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                	set_temp("armor_level",default_level-5+random(5));
                	ob->init_armor(this_object());
                	if( ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob) )
                		str = "佛门至宝"HIY+ob->query("name")+HIG;
                	else	str = obj_name(ob);
                	ob->set("no_give",1);
			if( stringp(color=ob->query("armor_color")) 
                 	 && env && member_array(color,env)==-1 )
			{
				tell_object(who,HIY"【副本】紫竹林：你设置了装备过滤，"+str+HIY"被自动忽略。\n"NOR);
				ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
			}
                	else if( !ob->move(who) )
       	        	{
               			ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
                       		tell_object(who,HIR"【副本】紫竹林：你的背包满了。\n"NOR);
			}
                	else    
                	{
                		if( arg!="" )
	                		arg+= "、";
				arg+= str;
			}
       		}	
        }
        
        succ = random(who->query_kar())/10;
        if( succ>5 )
        {
        	dir = ({"blade","blade","staff","staff","unarmed","unarmed"});
        	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/nweapon/"+file);
                if( random(100)>95 )
			set("env/test","HIM");
		else if( random(100)>75 )
			set("env/test",({"HIM","HIR",})[random(2)]);
		else if( random(100)>50 )	
			set("env/test",({"HIM","HIR","HIB"})[random(3)]);
		else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                set_temp("weapon_level",default_level-5+random(5));
                ob->init_weapon(this_object());
                ob->set("no_give",1);
                if( stringp(color=ob->query("weapon_color"))
                 && env && member_array(color,env)==-1 )
		{
                	tell_object(who,HIY"【副本】紫竹林：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        ob->move("/obj/empty");
			REMOVE_D->add_obj(ob,1);
                }        
                else if( !ob->move(who) )
                {
                        ob->move("/obj/empty");
			REMOVE_D->add_obj(ob,1);
                        tell_object(who,HIR"【副本】紫竹林：你的背包满了。\n"NOR);
                }
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
		}
        }
	
       if( arg!="" )
		tell_object(who,HIG"【副本】紫竹林：你得到了 "+arg+" 。"NOR"\n");	
	this_object()->move("/obj/empty");
	REMOVE_D->add_obj(this_object(),1);
        return;
}

int accept_fight(object who){return 0;}

int is_zzl(){return 1;}