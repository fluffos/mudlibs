int change_equip(object obj) {
  int lvl;
  string color, *names, *ids, name, title, id;
  if (!obj || !obj->is_armor()
    || !stringp(color = obj->query("armor_color"))
    || (color != "HIB" && color != "HIM" && color != "HIR"))
    return 0;
  lvl = obj->query("level") / 5;
  switch (obj->query("armor_type")) {
    case TYPE_CLOTH: names = cloths; id = "cloth"; break;
    case TYPE_HEAD: names = kuis; id = "head"; break;
    case TYPE_ARMOR: names = armors; id = "armor"; break;
    case TYPE_SURCOAT: names = pifengs; id = "pifeng"; break;
    case TYPE_WAIST: names = waists; id = "waist"; break;
    case TYPE_WRISTS: names = wrists; id = "wrists"; break;
    case TYPE_HANDS: names = hands; id = "hands"; break;
    case TYPE_BOOTS: names = shoes; id = "boots"; break;
    default: return 0;
  }
  lvl = lvl / 2 * 2;
  if (lvl > sizeof(names) / 2 * 2)
    lvl = sizeof(names) / 2 * 2;
  name = names[lvl];
  ids = ({ names[lvl + 1], id });
  obj->set_name(name, ids);
  if ((color == "HIM" || color == "HIR")
    && random(5) >= 3) {
    title = ({ "守山大神", "惠岸行者", "观世音" })[random(3)];
    obj->set("armor_title", title);
  }
  obj->delete("family_name");
  obj->set("class", "bonze");
  obj->delete("female_only");
  obj->set("no_give", 1);
  return 1;
}
