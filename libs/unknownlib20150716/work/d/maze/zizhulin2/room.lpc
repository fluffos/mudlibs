#include <ansi.h>
inherit ROOM;
    
void create()
{
        set("short","紫竹林副本");
        set("channel_id","紫竹林副本");
        set("alternative_die",1);
        set("item_desc",([
                "west" : "紫竹细疏，清风微拂。漫步于此，世事之纷扰顿时烟消云散。\n",
                "east" : "紫竹细疏，清风微拂。漫步于此，世事之纷扰顿时烟消云散。\n",
                "north" :"紫竹细疏，清风微拂。漫步于此，世事之纷扰顿时烟消云散。\n",
                "south" : "紫竹细疏，清风微拂。漫步于此，世事之纷扰顿时烟消云散。\n",
        ])); 
        set("guai",2+random(3));
        set("no_huicheng",1);
        set("no_chuqiao",1);
        set("virtual_room",1);
        setup();
}

int alternative_die(object who)
{
        int i,lost;
        object target;
        string id,file,msg;
        if( !who )
                return 1;
        if( !userp(who) )
        {
                target = who->query_temp("last_damage_from");
                who->powerup(0,1);
                all_inventory()->remove_killer(who);
                who->remove_all_killer();
                
                if( who->is_zzl() && target && present(target,this_object()) 
                 && target->query("family/family_name")=="南海普陀山" )
                        who->reward_ob(target);
                else
                {
                	message_vision(HIG"一道清风掠来，卷起$N"HIG"，直飞九霄之外....\n"NOR,who);
			who->move("/obj/empty");
			REMOVE_D->add_obj(who,1);
		}	
                return 0;                         
        }
        if( who->query("family/family_name")!="南海普陀山" )
        	return 1;
        
        //玩家死亡
        target = who->query_temp("last_damage_from");
        
        
        who->powerup(0,1);
        if( random(2) )
                msg = COMBAT_D->status_msg((1+random(5))*10);
        else    msg = COMBAT_D->eff_status_msg((1+random(5))*10);
        message_vision(NOR"\n( $N"+msg+NOR")\n",who);
        message_vision("\n"HIW"$N"HIW"跌跌撞撞的向外逃去。\n"NOR,who);  
        
        lost = 5000;
        lost = lost*9/10+random(lost/10);
        if( who->query("combat_exp")<lost )
                who->set("combat_exp",0);
        else    who->add("combat_exp",-lost);
        tell_object(who,HIR"【副本】紫竹林：你身负重伤，损失了"HIY+lost+""HIR"点武学经验。"NOR"\n");
        
        lost = 1000;
        lost = lost*9/10+random(lost/10);
        if( who->query("daoxing")<lost )
                who->set("daoxing",0);
        else    who->add("daoxing",-lost);
        tell_object(who,HIR"【副本】紫竹林：你身负重伤，损失了"HIY+COMBAT_D->chinese_daoxing(lost)+""HIR"道行。"NOR"\n");
        
        lost = 1000;
        lost = lost*9/10+random(lost/10);
        if( who->query("potential")-who->query("learned_points")<lost )
                who->set("potential",who->query("learned_points"));
        else    who->add("potential",-lost);
        tell_object(who,HIR"【副本】紫竹林：你身负重伤，损失了"HIY+lost+""HIR"点修为潜能。"NOR"\n");
                
        who->set("kee",100);
        who->set("eff_kee",100);
        who->set("sen",100);
        who->set("eff_sen",100);
        who->set("force",0);
        who->set("mana",0);
        
        id = who->query("id");
        file = sprintf("/data/maze/%c/%s/zizhulin2/enter",id[0],id);
        if( !who->move(file,2) )
        {
        	file = "/d/nanhai/road4";
        	who->move(file,2);
        }	
        message_vision("\n"HIW"$N"HIW"跌跌撞撞的从紫竹林中逃了出来。\n\n"NOR,who);
        who->delete_temp("maze");
        return 0;
}                       

void create_guai(object who)
{
	int i;
        object guai;
        if( !who || !living(who) 
         || !present(who,this_object()) )
                return;
	i = 1+random(2);
	while(i--)
	{                
        	switch(random(4))
        	{
                	case 1 : 
                        	if( query("guai")<=0 ) return;
				guai = new("/d/maze/zizhulin2/npc/yao");
				break;
                	case 2 :
                        	if( query("guai")<=0 ) return;
                        	guai = new("/d/maze/zizhulin2/npc/mo");
                        	break;  
                	default :
                        	if( query("guai")<=0 ) return;
                        	guai = new("/d/maze/zizhulin2/npc/seng");
                        	break;  
        	}
        	if( !guai )
                	return;
                //printf("111\n");	
        	if( !guai->information(who) )
        	{
                	guai->move("/obj/empty");
			REMOVE_D->add_obj(guai,1);
                	return;
        	}
        	//printf("222\n");
		add("guai",-1);
	}	
}

void init()
{
        if( userp(this_player()) )
        {
                add_action("do_map","map");
                remove_call_out("create_guai");
                call_out("create_guai",1+random(2),this_player());
        }
}

int do_map(string arg)
{
	object me = this_player();
	if( time()<me->query_temp("last_mazemap")+10 )
		return err_msg("你不能频繁查看地图。\n");
	me->set_temp("last_mazemap",time());
	arg = MAZE_D->query_maze_mainobj(me)->display_common_map(this_object());
	me->start_more(arg);		
        return 1;
}

int valid_leave(object who,string dir)
{
        object guai;
        if( !userp(who) )
                return ::valid_leave(who,dir);
        if( who->is_fighting() )
                return notify_fail("你现在正忙着呢。\n");
	return ::valid_leave(who,dir);
}

int is_zzl(){ return 1; }