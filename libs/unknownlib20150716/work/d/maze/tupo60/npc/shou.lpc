#include <ansi.h> 
#include <combat.h> 
inherit NPC;

object owner = 0;

void set_owner(object who)
{
	if( !owner )
		owner = who;
}
 
void create()
{
	set_name("英招",({"ying zhao","yingzhao","shen shou","shou"}));
	set("long","一只人头马身的奇兽，浑身虎纹斑驳，背后两扇巨大的羽翼。\n");
	set("title",HIY"守阵兽"NOR);
	set_level(1);
	set_skill("unarmed",10);
        set_skill("dodge",10);
        set_skill("parry",10);
        set("water", 200000);
        set("food", 200000);
        set("max_kee",200000);
        set("max_sen",200000);
              set("looking", HIW"人头马身，浑身虎纹，背后鸟翼"NOR"。"); 
              set("rank_info/pos_msg", HIW"浑身笼罩着阵阵霞光"NOR"。\n"); 
        setup();
        add_temp("apply/combat_def",1500);
        add_temp("apply/spells_def",1500);
}

void die()
{
	mixed *rooms;
	int i,max_a,a;
	object rom,who = query_temp("last_damage_from");
	message_vision (HIR"\n$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n"NOR,this_object());          
        if( !environment() || base_name(environment())!="/d/maze/tupo60/room"
         || environment()->query("num")!= 8 
         || !who || !present(who,environment()) || who!=owner 
         || (!wizardp(who) && (who->query_level()!=59||who->query("combat_exp")<529000000) ) )
	{
                destruct(this_object());
                return;
        }
	if( !pointerp(rooms=who->query_temp("now_bagua")) 
	 && sizeof(rooms)<1 )
	{
                destruct(this_object());
                return;
        }
	message_vision(HIC"\n$N"HIC"一个箭步上前，拾起地上的仙丹，一仰脖吃了下去！\n"NOR,who);
	if( who->level_up() )
	{
		CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+HIM"服用了「"HIY"炼心丹"HIM"」！"NOR);
		tell_object(who,HIY"【系统】你吃下「"HIR"炼心丹"HIY"」，对体内丹田内观更透彻了。\n"NOR);
		tell_object(who,HIG"【系统】你的等级提升了"HIR"1"HIG"级。\n"NOR);
		CHAR_D->setup_char( who );
		UPDATE_D->check_user(who,1);
		who->powerup(0,1);
		who->set_temp("login_data/time", time());
		who->set_temp("login_data/exp", 0);
		max_a = who->query("life/init_life_time");
		a = who->query("life/life_time");
		a = max_a - a;
		i = 50+random(50);
		if( i>a )
			i = a;
		if( i>0 )
		{			
			who->add("life/life_time",i);
			tell_object(who,HIY"【系统】你得到了"HIR+i+HIY"点寿元。"NOR"\n");	
		}
		who->save();
	}
	else	tell_object(who,"结果啥反应也没有！\n");
	if( !objectp(rom=who->query_temp("last_bagua_from")) )
		who->move("/d/city/kezhan");
	else	who->move(rom);
	tell_object(who,HIC"\n你眼前一花，四周景色已变，方才种种宛如梦中一般。\n"NOR);	
	("/d/maze/tupo60/room.lpc")->remove_all_rooms(rooms);
	return;
}

void unconcious()
{
        die();
}

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	return ::receive_wound(type,0,who,attack_type);
}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
        if( attack_type && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
                  damage = 0;
	if( damage>500 )
		damage = 500;
	return ::receive_damage(type,damage,who,attack_type);
}
