#include <ansi.h>
inherit "/d/maze/zuixing/room.lpc";

void create() {
  set("short", "廊间");
  set("long", @LONG 
四下里静寂无声，借着月光只见长廊延伸到黑暗之中。小廊上是木
板铺地，打扫的极为干净，走在上面发出吱吱的响声，在这黑夜尤为刺
耳。走廊两面的木格上雕着一些山水人物。

LONG
  );
  set("no_magic", 1);
  set("exits", ([
    "out": __DIR__ "maze/exit",
  ]));
  set("alternative_die", 1);
  setup();
}

void lijiancheng(object who) {
  object npc;
  remove_call_out("lijiancheng");
  if (!who || !living(who) || !present(who, this_object()))
    return;
  if (objectp(npc = present("li jiancheng", this_object()))
    && !userp(npc))
    return;
  npc = new("/d/maze/zuixing/npc/lijiancheng");
  npc->move(this_object());
  message_vision("\n一道阴风刮过，屋子里仿佛多了一个人。。。。\n\n", who);
  npc->set_temp("my_killer", who);
  npc->set_skills(who);
  who->set_temp("jjf/jiancheng", 1);
}

void liyuanji(object who) {
  object npc;
  remove_call_out("liyuanji");
  if (!who || !living(who) || !present(who, this_object()))
    return;
  if (objectp(npc = present("li yuanji", this_object()))
    && !userp(npc))
    return;
  npc = new("/d/maze/zuixing/npc/liyuanji");
  npc->move(this_object());
  message_vision("\n一道阴风刮过，屋子里仿佛多了一个人影。。。。\n\n", who);
  npc->set_temp("my_killer", who);
  npc->set_skills(who);
  who->set_temp("jjf/yuanji", 1);
}

void init() {
  object me = this_player();
  ::init();
  if (userp(me) && me->query_temp("jjf/醉星楼2")) {
    if (!me->query_temp("jjf/jiancheng")) {
      remove_call_out("lijiancheng");
      call_out("lijiancheng", 1 + random(3), me);
    }
    if (!me->query_temp("jjf/yuanji")) {
      remove_call_out("liyuanji");
      call_out("liyuanji", 1 + random(3), me);
    }
  }
}
