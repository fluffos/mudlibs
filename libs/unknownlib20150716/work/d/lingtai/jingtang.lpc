// Room: some place in 西牛贺洲
// inside2.c
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "讲经堂");
  set ("long", @LONG

这里是三星洞的讲经堂，平时道士们便在这里讲经说法。若是
有什么大事，也在这里集会商议。左右整整齐齐地放着四五十
个软垫，也坐了一二十个道士。
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"houlang1.lpc",
  "southdown" : __DIR__"inside1.lpc",
]));
  set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/xiao" : 1,
  __DIR__"npc/yunyang" : 1,
]));
  set("valid_startroom", 1);

  setup();
}

void paodian_end()
{
	remove_call_out("paodian");
}

void paodian()
{
	object *inv;
	int i;
 	if( !query("jiangjing") )
 		return 0;
	tell_room(this_object(),HIC"云阳真人端坐高台之上，开始讲起法来，一时间异象迭生。\n"NOR);
	inv = all_inventory();
	for(i=0;i<sizeof(inv);i++)
	{
		if( !userp(inv[i]) || !living(inv[i]) 
		 || inv[i]->query("family/family_name")!="方寸山三星洞" )
      			continue;
		tell_object(inv[i],"你在下面听着，不由得感悟颇多。\n");
		inv[i]->add("combat_exp",5000);
		inv[i]->add("daoxing",800);
		inv[i]->add("potential",500);
		tell_object(inv[i],HIG"【门派泡点】你得到了"HIR"5000点"HIG"武学经验、"HIR+COMBAT_D->chinese_daoxing(800)+HIG"道行以及"HIR"500点"HIG"潜能修为。"NOR"\n");
	}
	remove_call_out("paodian");
	call_out("paodian",5);
}

int valid_leave(object me, string dir)
{
        if(dir == "up" ) 
        {
        	if (objectp(present("master yunyang", environment(me)))) 
        	{
			if((string)me->query("family/family_name")=="方寸山三星洞"
			 || me->query_level()<40 )
				return ::valid_leave(me, dir);
			return notify_fail("云阳真人说道：祖师清修，少见外人，您还是请回吧！\n");
		}
	}
        return ::valid_leave(me, dir);
}

