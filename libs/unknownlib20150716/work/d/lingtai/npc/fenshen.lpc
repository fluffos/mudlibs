// heaven_soldier.c
#include <ansi.h>
inherit HUFA;

string check_equip_type(object obj)
{
	if( !obj )
		return 0;
	if( obj->is_weapon() )
		return obj->query("skill_type");
	switch(obj->query("armor_type"))
	{
		case "cloth" :
		case "skirt" : return "cloth";
		case "head"  : return "kui";
		case "neck"  : return "neck";
		case "armor" : return "armor";
		case "surcoat" : return "pifeng";
		case "waist" : return "waist";
		case "wrists": return "wrists";
		case "shield": return "shield";
		case "finger": return "ring";
		case "hands" : return "hands";
		case "boots" : return "shoes";
		default : return 0;
	}	
}

varargs void setskills(int i)
{
	int g,k;
	string title,*skills,msk,file;
	object who,weapon,armor,ob,*ars;
	mapping skill,arr;
	
	if( !objectp(who=this_object()->query_owner()) )
		return;
	if( query("jiashen") )
		return;
	
	set_name(who->name()+"的分身",({who->parse_command_id_list()[0]+"'s fenshen","fenshen","fen shen",}));
	set("jiashen",1);	
	set("gender",who->query("gender"));
	if( !intp(g=who->query("family/generation"))
	 || g<1 )
		g = 3;
	create_family("方寸山三星洞",g, "红");			 
	if( stringp(title=who->query_temp_title()) )
		set("title",title);
	else if( stringp(title=who->query("title")) )
		set("title",title);
	
	if( who->long() )
		set("long",who->long());
	else if( who->query("long") )
		set("long",who->query("long"));
	else	set("long",who->name()+"的分身。\n");	
	
	set("receive_damage",1);
	set("receive_wound",1);
	set("env/msg_mout","\n"HIB"$N"HIB"身子一晃，变成一股青烟散去了。"NOR"\n\n");
	set("env/msg_min","\n"HIC"只见"+who->name()+HIC"将身一晃，顿时眼前又出现一个"+who->name()+HIC"！"NOR"\n\n");
	
	skill = who->query_skills();
	skills = keys(skill);
	reset_eval_cost();
	for(k=0;k<sizeof(skills);k++)
		set_skill(skills[k],i);
	for(k=0;k<sizeof(skills);k++)
	{
		if( stringp(msk=who->query_skill_mapped(skills[k])) )
			map_skill(skills[k],msk);
	}

	set("max_force",query_skill("force")*10);
	set("max_mana",query_skill("spells")*10);
	if( this_object()->query_level()<70 )
	{
		add_temp("apply/max_kee",500);
		add_temp("apply/max_sen",500);
	}
	else if( this_object()->query_level()<90 )
	{
		add_temp("apply/max_kee",800);
		add_temp("apply/max_sen",800);
	}
	else
	{
		add_temp("apply/max_kee",1000);
		add_temp("apply/max_sen",1000);
	}
	
	if( objectp(weapon=who->query_temp("weapon")) )
		file = check_equip_type(weapon);
	else	file = "unarmed";	
	if( file )
	{
		ob = carry_object(0,file,1);
		if( weapon )
		{
			ob->set_name(weapon->query("name"),weapon->parse_command_id_list());
			if( weapon->query("weapon_color") )
				ob->set("weapon_color",weapon->query("weapon_color"));
			if( weapon->query("weapon_title") )
				ob->set("weapon_title",	weapon->query("weapon_title"));
		}
		ob->wield();
	}
	if( !mapp(arr=who->query_temp("armor"))
	 || sizeof(arr)<1 )
		return;
	reset_eval_cost();
	ars = values(arr);
	for(k=0;i<sizeof(ars);k++)
	{
		armor = ars[k];
		if( !stringp(file = check_equip_type(armor)) )
			continue;
		ob = carry_object(0,file,1);
		ob->set_name(armor->query("name"),armor->parse_command_id_list());
		if( armor->query("weapon_color") )
			ob->set("armor_color",armor->query("armor_color"));
		if( armor->query("armor_title") )
			ob->set("armor_title",	armor->query("armor_title"));
		ob->wear();	
	}
	powerup(0,1);		 
}

string name(int raw)
{
	object who;
	
	if( !objectp(who=this_object()->query_owner()) )
		return "分身木偶";
	return 	who->name();		
}

string *parse_command_id_list()
{
	string *ids;
	object who;
	if( !objectp(who=this_object()->query_owner()) )
		return ({"fenshen muou","muou","mu ou","fenshen","fen shen"});
	ids = who->parse_command_id_list();
	if( wizardp(who) )
		ids+= ({"fenshen","fen shen"});
	return ids;	
}

varargs string short(int raw)
{
	object who;
	if( !objectp(who=this_object()->query_owner()) )
		return "方寸山三星洞的分身木偶。\n";
	return who->short(1);	
}	

string query_hufa_msg()
{
	return HIY+this_object()->name()+HIC"吱吱乱叫，身形一动，已挡在了$N"HIC"身前，挡住了$n"HIC"的部分攻击。\n"NOR;
}

void die()
{
	if( environment() )
        	message("vision",HIB + this_object()->name() + HIB"身子一晃，变成一股青烟散去了。\n" NOR,environment(),this_object() );
        destruct(this_object());
}

void heart_beat()
{
        object me = this_object();
        string str;
        if( !environment() )  
                return;
        if( living(me) && !me->is_busy() )
	{
        	if( me->is_fighting() )
        	{
        		if( query("eff_kee") < this_object()->query_maxkee() )
		                QUEST_D->addEffKee(me);
		        if( query("kee") < query("eff_kee") )
                		QUEST_D->addKee(me);
		        if( query("sen") < query("eff_sen") )
                		QUEST_D->addSen(me);
		        if( query("eff_sen") < this_object()->query_maxsen() )
                		QUEST_D->addEffSen(me);
			if( objectp(query_temp("weapon")) )
                		str = query_temp("weapon")->query("skill_type");
        		else	str = "unarmed";
        		switch(random(10))
        		{
		                case 9 :
                		case 8 :        
		                case 1 :
                		case 0 : 
                        		break;
		                default: 
                		        QUEST_D->randomPfm(this_object(),str);
        		}       
        	}
	}
	::heart_beat();	
}