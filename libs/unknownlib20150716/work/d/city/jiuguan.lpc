#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "长安小酒馆");
  	set ("long", @LONG
这间酒馆开在龙蛇混杂的背阴巷，自然有它的手段。小二托着酒壶，穿梭
在桌椅之间。猜拳行令之声、笑骂声、叱喝声响成一片。也分不清那些是
良家百姓、哪些是响马强人。这里真说得上是龙蛇混杂。成为雇佣士兵的
好去处。
LONG);
	set("exits", ([
