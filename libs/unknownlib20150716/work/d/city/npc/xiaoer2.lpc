
inherit F_VENDOR_SALE;
int random_go(object me, string* dirs);

// #include <norumor.c>
void create()
{
       	set_name("店小二", ({"xiao er","xiaoer","xiao","waiter","er"}));
       	set("shop_id",({"waiter","xiaoer","xiao","er"}));
       	set("shop_title","店小二");
       	set("gender", "男性");
	set_level(3);
       	set("age", 26);
       	set("per", 14);
       	set("attitude", "friendly");
       	set("shen_type", 1);
       	set_skill("unarmed", 10);
       	set("max_price",20);
        set("vendor_goods", 
        ([
                "ciping": "/d/obj/knowledge/chuyi/item/cijiuping",
                "dami"  : "/d/obj/knowledge/chuyi/item/dami",
                "cha"   : "/d/obj/knowledge/chuyi/item/chaye",
                "yuzhan": "/d/obj/knowledge/chuyi/item/baiyuzhan",
                "cuntan": "/d/obj/knowledge/chuyi/item/tanzi",
                "danping":"/d/obj/knowledge/chuyi/item/danping",
                "niupidai":"/d/obj/knowledge/chuyi/item/niupidai",
                "jiuhu": "/d/obj/knowledge/chuyi/item/jiuhu",
                "haiwan": "/d/obj/knowledge/chuyi/item/haiwan",
                "xuebei": "/d/obj/knowledge/chuyi/item/snowglass",
                "chazhong": "/d/obj/knowledge/chuyi/item/chazhong",
                "zhutong": "/d/obj/knowledge/chuyi/item/qingzhutong",
        ]) );
	setup();
	carry_object(0,"cloth",random(2))->wear();
}

void init()
{
        add_action("do_vendor_list", "list");
}
