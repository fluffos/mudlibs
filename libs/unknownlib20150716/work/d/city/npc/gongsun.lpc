inherit SUPER_NPC;

void create()
{
	set_name("公孙大娘", ({"gongsun daniang", "gongsun", "daniang"}));
	set_level(39);
	set("age",42);
	set("gender", "女性");
	set("long", "长安城内稍有名望的，不知道公孙大娘的人恐怕没几个。特别是那些文人骚客，跟公孙大娘不熟简直就是没面子。\n");
	create_family("月宫", 3, "弟子");
	set("title", "剑圣");
	set("attitude", "friendly");

	set("force_factor", 200);
        set("mana_factor", 500);	
	
	set_skill("literate", 390);
	set_skill("unarmed", 390);
	set_skill("dodge", 390);
	set_skill("force",390);
	set_skill("parry",390);
	set_skill("sword",390);
	set_skill("spells",390);
 	set_skill("moonshentong",390);
 	set_skill("baihua-zhang",390);
 	set_skill("moonforce",390);
 	set_skill("snowsword",390);
 	set_skill("moondance", 390);
        map_skill("spells", "moonshentong");
        map_skill("unarmed", "baihua-zhang");
        map_skill("force", "moonforce");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
        map_skill("dodge", "moondance");

	set("max_kee",1000000);
	set("max_sen",1000000);
	set("max_force",100000);
	set("max_mana",0);
	
	set("env/test","HIR");
	
	setup();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"shoes",1)->wear();
	carry_object(0,"sword",1)->wield();
	set("max_mana",0);
	powerup(0,1);
}
