//Cracked by snowtu
inherit NPC;
#include <ansi.h>

string to_color() {
  int i;
  string *strs, str = "";
  object me = this_player();
  if (!me || !living(me))
    return 0;
  if (!me->query_temp("ask_name_color")) {
    str += "这个颜色功能只限于公共频道时你的说话内容，你可以设置以下颜色：\n" NOR;
    str += COLOR_D->color_msg(0, 1);
    me->set_temp("ask_name_color", 1);
    str += "\n" NOR HIC "要设置这些颜色，你需要消耗10000两黄金。\n" NOR;
    str += NOR CYN + name() + CYN "说道：如果考虑好了，你可以再来找我，询问关于 颜色 一事。\n";
    return str;
  }
  return "既然你已决定了，那就直接输入你想要的颜色吧，命令格式：namecolor <你想要的颜色>，例如 namecolor HIW\n";
}

void create() {
  set_name("长孙无忌", ({ "zhangsun wuji", "minister", "wuji", "zhangsun" }));
  set("long", "开国名臣，时任户部尚书，你如果有黄金万两，可以在他这里更改你的姓名(rename)。\n");
  set_level(23);
  set("gender", "男性");
  set("title", "户部尚书");
  set("age", 50);
  set("attitude", "friendly");
  set("per", 100);
  set("inquiry", ([
    "颜色": (: to_color :),
  ]));
  setup();
  carry_object("/d/gao/obj/changpao")->wear();
}

void init() {
  add_action("do_rename", "rename");
  add_action("do_ncolor", "namecolor");
  this_player()->delete_temp("wuji_rename");
}

int do_ncolor(string arg) {
  int i;
  object *inv, gold, me = this_player();
  if (!arg)
    return 0;
  if (!me->query_temp("ask_name_color"))
    return 0;
  if (!COLOR_D->color_msg(arg)) {
    me->delete_temp("ask_name_color");
    return err_msg("命令格式错误。\n");
  }
  if (arg == "NOR") {
    me->delete_temp("ask_name_color");
    me->delete("name_color");
    return err_msg("你取消了自己的名字颜色\n");
  }
  if (!me->check_pay(100000000))
    return err_msg("你的黄金不足10000两。\n");
  me->set("name_color", arg);
  me->money_add(-100000000);
  me->delete_temp("ask_name_color");
  me->save(1);
  write(CYN + name() + CYN "说道：好了，你将自己的名字颜色设为 " NOR + COLOR_D->color_msg(arg) + NOR CYN " 了。" NOR "\n");
  return 1;
}

int do_rename(string arg) {
  string cl_name;
  object me = this_player();

  if (!arg)
    return err_msg(CYN + name() + CYN "说道：你准备改成什么名字？" NOR "\n");
  if (arg == me->query("name"))
    return err_msg(CYN + name() + CYN "说道：你莫非是来消遣老夫的么？" NOR "\n");
  if (!me->check_pay(100000000))
    return err_msg(CYN + name() + CYN "说道：你的黄金不足10000两。" NOR "\n");
  if (stringp(cl_name = me->query("taoist/old_name"))
    || stringp(cl_name = me->query("bonze/old_name")))
    return err_msg(CYN + name() + CYN "说道：大师乃方外人士，不归我户部管。" NOR "\n");

  arg = CONVERT_D->input(arg, me);
  if (!LOGIN_D->check_legal_name(arg))
    return err_msg("你输入的名字不合法!请重新输入!\n");
  message_vision("$N朝$n点了点头，拿出一份卷宗写了几笔。\n", this_object(), me);
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    "听说" HIR + me->name(1) + HIM "将自己的名字在户部更改为了" HIR + arg + HIM "。"
  );
  me->money_add(-100000000);
  me->set("name", arg);
  me->save(1);
  write("你的名字更改完毕。\n");
  return 1;
}
