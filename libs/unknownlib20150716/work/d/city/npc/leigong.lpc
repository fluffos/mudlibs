inherit SUPER_NPC;
#include <ansi.h>
/*
           "五雷正法" : HIY"
雷神对你悄悄说道，五雷正法乃上古中记载咒法的五雷秘籍，似乎失
传了很久了。上一次伴随着古代灵禽雷鸟出现在蛾眉山顶舍身岩下，
如果你想寻找它，可以带上雷灵珠去看看。
           "NOR,

*/
mixed about_lei();

void create()
{
	object ob;
	set_name("辛环",({"xin huan","xin","leishen", "shen","lei gong"}));
	set("long", @LONG
此乃凌霄天宫雷部二十四位天君正神之一的辛天君。	有诗赞：
    二翅空中响，头戴虎头冠。面如红枣色，顶上宝光寒。
    锤钻安天下，獠牙嘴上安。一怒无遮档，飞来势若鸾。 	
LONG);	
	set("looking", HIR"面如红枣色，獠牙嘴上安"NOR"。");
	set("rank_info/pos_msg", HIC"浑身笼罩着层层雷光"NOR"。\n");
	set_level(90);
	create_family("东海龙宫", 2, "蓝");
	set("title",HIC"雷公"NOR);
	set("gender", "男性");
	set("age", 30);
	set("attitude", "friendly");
	set("per", 30);
	set("force_factor", 180);
	set("mana_factor", 220);

 	set("eff_dx", 250000);
 	set("nkgain", 400);
 	set("class","taoist");

	set_skill("literate",900);
	set_skill("unarmed",900);
	set_skill("dodge",900);
	set_skill("parry",900);
	set_skill("dagger", 900);
	set_skill("spells", 900);
	set_skill("wulei",900);
	set_skill("dragonfight",900);
	set_skill("dragonforce",900);
	set_skill("force",900);
	set_skill("leigong-zhui",900);
	map_skill("spells", "wulei");
	map_skill("unarmed", "dragonfight");
	map_skill("force", "dragonforce");
	map_skill("dagger", "leigong-zhui");
	map_skill("parry", "leigong-zhui");
	map_skill("dodge", "leigong-zhui");
	set("env/test","HIR");
 	set("inquiry", ([
		"雷灵珠" : (: about_lei :),
	]) );
	set_temp("weapon_level",50);
	setup();
	carry_object("/d/obj/baowu/leizhu",0,1)->wear();
	if( objectp(ob=carry_object(0,"cloth",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
	if( objectp(ob=carry_object(0,"shoes",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
	if( objectp(ob=carry_object(0,"pifeng",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
	if( objectp(ob=carry_object(0,"kui",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
	if( objectp(ob=carry_object(0,"hand",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
	if( objectp(ob=carry_object(0,"dagger",1)) )
	{
		ob->set("weapon_title","辛环");
		ob->wield();
	}
	if( objectp(ob=carry_object(0,"armor",1)) )
	{
		ob->set("armor_title","辛环");
		ob->wear();
	}
}

void kill_ob (object ob)
{
	::kill_ob(ob);
	command("cast leiji");	
}

mixed about_lei()
{
	object zhu,me = this_player();
	if( objectp(zhu=present("lei lingzhu",me))
	 && zhu->is_5zhu() )
		return "你家雷爷爷不是已经给你了吗？！";
	if( time()<me->query("maze/lingzhu-lei")+1800 )
		return "你不要老来烦你家雷爷爷！";
	if( me->query("gin")<30 )
		return "你这么点活力，不够赔雷爷爷玩的。";
	if( !me->query_temp("pending/leigong") )
	{		
		tell_object(me,CYN+name()+CYN"说道：好好好，你家雷爷爷正好闲得手痒，便与你切磋一番，你且准备准备。好了便来与俺切磋切磋(fight)。\n"NOR);
		tell_object(me,HIC+name()+HIC"说道：雷爷也不会占你的便宜，自然会压制住修为和你斗上一斗！\n"NOR);
		me->set_temp("pending/leigong",1);
		return 1;
	}
	else	return "准备好了吗？";
}

void init()
{
	add_action("do_fight","fight");
}

int accept_fight(object who){ return 0; }

int do_fight(string arg)
{
	object ob = this_player();
	if( !arg || !id(arg) || !living(this_object()) )
		return 0;
	if( !ob->query_temp("pending/leigong") 
	 || !userp(ob) )
		return 0;
	if( base_name(environment())!="/d/changan/eside5" )
	{
		tell_object(ob,CYN+name()+"说道：奇怪，这里是哪里？\n"NOR);
		return 0;
	}

	EMOTE_D->do_emote(this_object(), "shake",geteuid(ob),CYN,0,0,0);
	tell_object(ob,CYN+name()+"说道：这里人来人往的，打起来不舒畅。\n"NOR);
	
	if( !ob->query_follow() || ob->query_follow()!=this_object() )
	{
		message_vision(HIC"$N对$n"HIC"说道：来来来，你且随(follow)我来，雷爷爷寻个好去处。\n"NOR,this_object(),ob);
		return 1;
	}

	tell_object(ob,CYN+name()+"说道：来来来，随我去旁边的树林中玩个痛快。\n"NOR);
	ob->dismiss_team();
	ob->delete_temp("maze");
	message_vision(HIC"辛环往南小树林离开。\n"NOR,this_object());
	if( MAZE_D->enter_maze(ob, "lingzhu-lei") )
	{
		ob->set("maze/lingzhu-lei",time());
		ob->delete_temp("pending");
		ob->set_temp("maze/leigong",1);
                tell_object(ob,HIR"你跟随辛环来到小树林。\n"NOR);
		tell_object(ob,CYN"\n辛环说道：这里了无人迹，可以战(fight)个痛快。\n"NOR);
		ob->add("gin",-30);
                return 1;
	}
	return err_msg(CYN+name()+CYN"说道：算了，算了，我与刘道友有事谈，现在没空。\n"NOR);
}