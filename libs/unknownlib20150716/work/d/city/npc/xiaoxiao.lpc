#include <ansi.h>
inherit SELLER;

void create()
{
        set_name("萧萧", ({"xiao xiao", "xiao"}));
        set("title", "恶娘子");
        set_level(15);
        set("gender", "女性");
        set("age", 25);
        set("long", "老英雄萧振远的小女儿，兵器铺女老板。
由于凶蛮狠毒，江湖人称＂恶娘子＂。\n");

        set("combat_exp", 70000);
	set_skill("wuhu-blade", 130);
        set_skill("blade", 150);
        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("parry", 150);
	set_skill("moondance", 150);
	map_skill("dodge", "moondance");
	map_skill("blade", "wuhu-blade");
	map_skill("parry", "wuhu-blade");
	set("force_factor", 5);
        set("env/test","HIM");
        
        set("goods",([
        	"level" : 6,
        	"base_value" : 500,
        	"goods_dir" : "/d/obj/nweapon/",
        	"goods" : ({
				"axe","blade","fork","hammer","mace","sword",
				"spear","staff","stick","blade","unarmed","whip", 
		}),
		"type" : "weapon",
        ]));
        
        setup();
        carry_object(0,"cloth",1)->wear();
        carry_object(0,"blade",1)->wield();
}