inherit ROOM;
#include <ansi.h>

string *strs = ({
        " 混沌初分盘古先，太极两仪四象悬， \n",
        " 子天丑地人寅出，避除兽患有巢贤。 \n",
        " 燧人取火免鲜食，伏羲画卦阴阳前， \n",
        " 神农治世尝百草，轩辕礼乐婚姻联。 \n",
        " 少昊五帝民物阜，禹王治水洪波蠲,  \n",
        " 承平享国至四百，桀王无道乾坤颠。 \n",
        " 周室开基立帝图，分茅列土报功殊.  \n",
     });
     
void create()
{
	set ("short", "大唐书院");
  	set ("long", @LONG

这个地方就是大唐的书院了，很多新手的读书写字都是这里   
强化(dushu)的,远远看到个牌子,上书：大 唐 书 院
LONG);

  	set("exits", ([
		"west" : __DIR__"guozijian",
	]));
  	set("objects", ([ 
		__DIR__"npc/wuji" : 1,
		__DIR__"npc/xiucai4" : 1,
	]));
  	setup();
}

void paodian_end()
{
	remove_call_out("paodian");
}

void paodian()
{
	object *inv;
	int i;
 	if( !query("jiangjing") )
 		return 0;
	inv = all_inventory();
	for(i=0;i<sizeof(inv);i++)
	{
		if( !userp(inv[i]) || !living(inv[i]) )
      			continue;
		tell_object(inv[i],"你低眉垂目，口中微颂："+strs[random( sizeof(strs) )]); 
		inv[i]->add("combat_exp",4000);
		inv[i]->add("daoxing",600);
		inv[i]->add("potential",300);
		tell_object(inv[i],HIG"【泡点】你得到了"HIR"4000点"HIG"武学经验、"HIR+COMBAT_D->chinese_daoxing(600)+HIG"道行以及"HIR"300点"HIG"潜能修为。"NOR"\n");
	}
	remove_call_out("paodian");
	call_out("paodian",5);
}