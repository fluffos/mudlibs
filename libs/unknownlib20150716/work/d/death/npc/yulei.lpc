//puti.c
inherit SUPER_NPC;

void create()
{
	set_name("郁垒", ({"yu lei", "lei"}));
	create_family("阎罗地府",3, "你好");
	set("title", "祀户");
	set("gender", "男性");
	set("long", "一个红脸怒相的勇士，身高足有丈外，站在那里威风凛凛。\n");
	set("age", 30);
	set("class", "ghost");
	set("attitude", "peaceful");
	set_level(80);
	set("mana_factor", 40);

	set_skill("ghost-steps",800);
        set_skill("dodge",800);
        set_skill("unarmed",800);
	set_skill("parry",800);
	set_skill("spells",800);
	set_skill("gouhunshu",800);
	set_skill("jinghun-zhang",800);
	set_skill("force",800);
	set_skill("tonsillit",800);
	set_skill("literate",800);
	set_skill("sword", 800);
 	set_skill("force", 1000);
	set_skill("zhuihun-sword", 800);
	map_skill("unarmed", "jinghun-zhang");
	map_skill("dodge", "ghost-steps");
	map_skill("sword", "zhuihun-sword");
	map_skill("parry", "zhuihun-sword");
	map_skill("force", "tonsillit");
	map_skill("spells", "gouhunshu");
	set("env/test","HIB");
	setup();
        carry_object(0,"armor",random(100))->wear();
        carry_object(0,"cloth",random(100))->wear();
        carry_object(0,"pifeng",random(100))->wear();
        carry_object(0,"kui",random(100))->wear();
        carry_object(0,"shoes",random(100))->wear();
        carry_object(0,"sword",random(100))->wield();
        powerup(0,1);
}