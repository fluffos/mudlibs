//puti.c
inherit NPC;

void create()
{
	set_name("勾司人", ({"gousi ren", "ren"}));
       	set_level(15+random(15));
       	set("gender", "男性");
       	set("age", 30);
	set("long", "一些地府里的杂务人员．\n");
       	set("attitude", "peaceful");
       	set("shen_type", 1);
	set("bellicosity", 100);
	set_skill("unarmed", 135);
	set_skill("dodge", 135);
	set_skill("parry", 145);
	set("force_factor", 5);
	set("chat_chance", 8);
	set("chat_msg", ({
		(: random_move :)
	}) );
	setup();
        carry_object(0,"cloth",random(2))->wear();
        carry_object(0,"shoes",random(2))->wear();
        powerup(0,1);
}