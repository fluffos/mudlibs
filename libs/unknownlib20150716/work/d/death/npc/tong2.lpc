inherit NPC;

void create()
{
	int i = 15+random(15);
       	set_name("黄衣童子", ({"tongzi"}));
       	set_level(i);
       	set("gender", "男性");
       	set("age", 15);
       	set("attitude", "peaceful");
       	set("shen_type", 1);
	set_skill("unarmed", 140);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("jinghun-zhang", 150);
	map_skill("unarmed", "jinghun-zhang");
	set("force_factor", 15);
	setup();
	carry_object("/d/obj/cloth/huangyi")->wear();
	carry_object(0,"shoes",0)->wear();
	carry_object(0,"unarmed",0)->wear();
	powerup(0,1);
}