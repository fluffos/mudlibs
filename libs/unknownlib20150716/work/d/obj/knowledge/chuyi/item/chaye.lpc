inherit ITEM;

string *names = ({
	"西湖龙井",
	"武夷岩茶",
	"洞庭碧螺春",
	"黄山毛峰",
	"庐山云雾",
	"安溪铁观音",
	"君山银针",
	"六安片茶",
	"岳西翠兰",
	"信阳毛尖",
	"祁门红茶",
	"蒙顶甘露",
	"都匀雀舌",
	"闽南乌龙",
});

void create()
{
	set_name("各式茶叶", ({ "cha ye", "cha","tea" }) );
  	set_weight(100);
	set("value", 150);
	set("unit","包");
	set("long","一包香气扑鼻的茶叶。\n");
  	setup();
}

void init()
{
	string name;
	if( !query("names") )
	{
		name = names[random(sizeof(names))];
		set("names",name);
		set("name",name);
	}
}