inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("粗磁酒瓶", ({"jiuping", "skin"}));
  	set_weight(800);
  	if (clonep())
    		set_default_object(__FILE__);
  	else
  	{
     		set("long", "一个用来装酒的粗磁酒瓶，能装两，三斤白酒。\n");
     		set("unit", "个");
     		set("value", 0);
  	}
  	set("max_liquid",1000);		//最大量 
  	set("drink_msg","$N一仰脖喝下几口$l，砸吧砸吧了嘴。\n");
  	set("drink_pot",1);		//增加饮水量
  	set("drunk",5);			//醉酒秒
	set("liquid", ([
        	"type": "recover_mana",	
        	"name": "老白干",
        	"remaining": 1000,	//具有量
      	]));
      	set("recover",500);
}
