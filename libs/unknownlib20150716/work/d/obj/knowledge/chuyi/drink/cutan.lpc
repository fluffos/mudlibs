inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("醋坛子", ({"tanzi"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一个装醋的大坛子．\n");
                set("unit", "个");
		set("value", 0);
		set("max_liquid",50);
        }
        set("clear_drunk",5);
  	set("recover",300);
        set("liquid", ([
                "type": "凝神",
                "name": "香醋",
                "remaining": 50,
        ]) );
        setup();

}

