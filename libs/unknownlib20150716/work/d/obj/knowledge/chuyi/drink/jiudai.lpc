// jiudai.c  酒袋

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("牛皮酒袋", ({"jiudai", "wineskin", "skin"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个用来装米酒的大酒袋，大概装得八、九升的酒。\n");
		set("unit", "个");
		set("value", 0);
	}
	set("drunk",8);	
	set("max_liquid",1000);		//最大量 
  	set("drink_msg","$N拿起$n一仰脖，”咕嘟咕嘟“喝下了几口$l。\n");
  	set("drink_pot",1);		//增加饮水量
	set("liquid", ([
		"type": "recover_mana",
		"name": "米酒",
		"remaining": 1000,
	]));
	set("recover",550);
}

