inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>

void create() {
  set_name(HIG "梦醒时分" NOR, ({ "meng xing", "bottle" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "据说喝了它，可以让人醒酒。\n");
    set("unit", "瓶");
    set("value", 0);
    set("max_liquid", 1000);
  }
  set("clear_drunk", 100);
  set("liquid", ([
    "type": "吐纳",
    "name": HIG "梦醒时分" NOR,
    "remaining": 400,
  ]));
}
