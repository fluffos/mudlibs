//Cracked by Roath
inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("大海碗", ({"dahai wan","wan", "cha"}));
   	set_weight(700);
   	if (clonep())
     		set_default_object(__FILE__);
   	else 
   	{
     		set("long", "一大碗新泡的红茶。\n");
     		set("unit", "个");
     		set("value", 0);
   	}
   	set("clear_drunk",3);
  	set("max_liquid", 1000); 
	set("recover",300);
	set("liquid", ([
    		"type": "recover_sen",
     		"name": "红茶",
     		"remaining": 1000,
   	]));
}
