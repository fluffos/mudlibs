inherit ITEM;
inherit F_LIQUID;

void create()
{
  	set_name("雪饮杯", ({ "snowglass", "glass" }) );
  	set_weight(600);
  	if( clonep() )
    		set_default_object(__FILE__);
  	else 
  	{
    		set("long", "杯体碧绿通透，玲珑可爱．\n");
    		set("unit", "个");
    		set("value", 0);
  	}
  	set("max_liquid", 100); 
  	set("clear_drunk",5);
	set("recover",1500);
	set("liquid", ([
    		"type": "recover_force",
    		"name": "碧樨茶",
    		"remaining": 100,
  	]) );
  	setup();
}

