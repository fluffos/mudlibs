inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("楠木茶盅", ({"nanmu chazhong", "cha", "teapot", "tea"}));
  	set_weight(50);
  	if( clonep() )
    		set_default_object(__FILE__);
  	else 
  	{
    		set("long", "一个楠木茶盅，香气扑鼻。\n");
    		set("unit", "个");
	}
	set("clear_drunk",5);
	set("max_liquid", 50);
	set("recover",1000);
  	set("liquid", ([
		  "type": "recover_force",
		  "name": "云雾山香茶",
		  "remaining": 50,
	]) );
  	setup();
}

