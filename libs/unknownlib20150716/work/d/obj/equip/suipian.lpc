#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup(){}

int query_amount() { return amount; }

private void destruct_me() 
{ 
	remove_call_out("destruct_me");
	destruct(this_object()); 
}

void set_amount(int v)
{
    object dest;

	if( v<=0 )
	{
	   amount=0; 
	   call_out("destruct_me", 1);
	   return;
	}
	else 
	{
		amount = v;
		this_object()->set_weight(v);
	}
}

void add_amount(int v) { set_amount(amount+v); }

string short()
{
	string id;
	if( !stringp(id=query("owner_id")) )
		id = "";
	else	id = "["+id+"]";	
	return chinese_number(query_amount()) + query("base_unit")+ ::short()+id;
}

varargs int move(mixed dest, int silent)
{
	object env, *inv;
	int i, total, total0, result;
	string file;

	result= ::move(dest, silent);
	if(env = environment()) 
	{
		file = base_name(this_object());
		inv = all_inventory(env);
		total = (int)query_amount();
		total0=total;
		for(i=0; i<sizeof(inv); i++) 
		{
			if( inv[i]==this_object() ) 
				continue;
			if( base_name(inv[i])==file ) 
			{
				if( inv[i]->query("owner_id")
				 && query("owner_id")!=inv[i]->query("owner_id") )
				 	continue;
				set("owner_id",inv[i]->query("owner_id"));	
				total += (int)inv[i]->query_amount();
				destruct(inv[i]);
			}
		}
		if(total!=total0)
			set_amount(total);
	}
	return result;
}

void create()
{
	set_name(HIM"装备碎片"NOR,({"sui pian","pian",}));
	if(clonep()) 
		set_default_object(__FILE__); 
	set("base_unit", "片");
	set("unit","些");
	set("long","从一些装备上分解出来的碎片，宝气氤氲，尚未失去灵气。"HIC"
	装备碎片x100 + 莹玉x3 = 萤石x1"HIG"
萤石可以用来洗炼("HIR"xilian"HIG")装备或回炼("HIR"huilian"HIG")装备。"NOR"
洗炼：你可以指定保存一项或多项属性，同时随机化装备的其他属性。
回炼：使洗炼过的装备回到上一次洗炼前的属性。\n");    		
	set("value", 0);
    	set("no_put",1);
	set("no_get",1);
	set("changed",1);
    	setup();
    	set_amount(1);
}

int is_xilian(){return 1;}