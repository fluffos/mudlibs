//装备合并
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup() {}

int query_amount() { return amount; }

private void destruct_me() {
  remove_call_out("destruct_me");
  destruct(this_object());
}

void set_amount(int v) {
  object dest;

  if (v <= 0) {
    amount = 0;
    call_out("destruct_me", 1);
    return;
  } else {
    amount = v;
    this_object()->set_weight(v);
  }
}

void add_amount(int v) { set_amount(amount + v); }

string short() {
  string id;
  if (!stringp(id = query("owner_id")))
    id = "";
  else id = "[" + id + "]";
  return chinese_number(query_amount()) + query("base_unit") + ::short() + id;
}

varargs int move(mixed dest, int silent) {
  object env, *inv;
  int i, total, total0, result;
  string file;

  result = ::move(dest, silent);
  if (env = environment()) {
    file = base_name(this_object());
    inv = all_inventory(env);
    total = (int)query_amount();
    total0 = total;
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == this_object())
        continue;
      if (base_name(inv[i]) == file) {
        if (inv[i]->query("owner_id")
          && query("owner_id") != inv[i]->query("owner_id"))
          continue;
        set("owner_id", inv[i]->query("owner_id"));
        total += (int)inv[i]->query_amount();
        destruct(inv[i]);
      }
    }
    if (total != total0)
      set_amount(total);
  }
  return result;
}

void init() {
  if (userp(environment())) {
    if (!query("owner_id"))
      set("owner_id", environment()->query("id"));
  }
  add_action("do_ronghe", "ronghe");
}

void create() {
  set_name("百川符", ({ "baichuan fu", "fu", "fuwen", "fu wen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "张");
    set("unit", "叠");
    set(
      "long",
      HIG "\n海纳百川，有容乃大。有大能参悟天地一丝法则，制作了此灵符。\n" HIW "功效：可以使装备融合(ronghe)同类型装备的属性。\n" NOR HBBLU "注意：非绑定类装备可以被其他装备融合，但其本身不能融合其他装备。\n门派套装和法宝不能融合及被融合。                                \n" NOR HBBLU HIM "装备融合只能增加自身已有的属性的数值，即除了攻、防，被融合装备的\n属性，必须是对象装备已有属性，这样才能融合到对象装备中去。      " NOR "\n" HBRED + HIG "命令格式：ronghe <被融合装备名> to <对象装备名>                 \n" HIW "注意：融合后，对象装备将吞噬被融合装备相关属性最高10％的值增加到\n自身，同时被融合装备将消失。被融合装备品质越高，融合值越高。    \n" NOR
    );
    set("no_sell", "这么珍贵的灵符你也舍得卖？！\n");
  }
  set_amount(1);
  setup();
}

//属性附加条数
int query_apply_number(object obj) {
  mapping prop, prop2;
  string type;
  int j, k;
  if (!obj)
    return 0;
  if (obj->query("combination")) {
    if (!stringp(type = obj->query("skill_type")))
      return 0;
    if (!mapp(prop = obj->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(prop) < 1)
      return 0;
    if (!mapp(prop2 = obj->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(prop2) < 1)
      return 0;
    j = sizeof(prop);
    k = sizeof(prop2);
    return j + k;
  } else {
    if (obj->is_armor())
      prop = obj->query("armor_prop");
    else prop = obj->query("weapon_prop");
    return sizeof(prop);
  }
}

int check_equip(object ob, object target) {
  int p, ap, dp;
  if (!ob || !target)
    return 1;
  if (ob->is_weapon()) {
    ap = ("/cmds/usr/top.lpc")->get_score3(ob);
    dp = ("/cmds/usr/top.lpc")->get_score3(target);
  } else {
    ap = ("/cmds/usr/top.lpc")->get_score4(ob);
    dp = ("/cmds/usr/top.lpc")->get_score4(target);
  }
  p = dp * 100 / ap;
  if (p > 10)
    p = 10;
  if (p < 1)
    p = 1;
  return p;
}

int do_ronghe(string arg) {
  object ob, target, me = this_player();
  string id1, id2, *props, msg, *new_props, prop;
  int i, my_num, his_num, pp;
  mapping my_prop, his_prop, new_prop, base_apply, query_e, query_e2;

  if (!present(this_object(), me))
    return 0;
  if (!query("owner_id") || query("owner_id") != me->query("id"))
    return notify_fail(name() + "上霞光闪了几闪，却是什么反应也没有。\n");
  if (!arg || sscanf(arg, "%s to %s", id2, id1) != 2)
    return notify_fail("命令格式：ronghe <被融合装备名> to <对象装备名>\n" HIR "注意：融合后，对象装备将吞噬被融合装备各属性10%的值增加到自身，同时被融合装备将消失。\n" NOR);
  ob = present(id1, me);
  if (!ob || (!ob->is_armor() && !ob->is_weapon()))
    return notify_fail("你身上没有" + id1 + "，或者它不是一件装备。\n");
  if (!ob->query("valid_time"))
    return notify_fail(ob->name() + "不是绑定的装备，不能融合其他装备。\n");
  if (me->query("family/family_name") && ob->query("armor_title") == me->query("family/family_name"))
    return notify_fail("门派套装不能融合其他装备。\n");
  if (ob->query("equipped"))
    return notify_fail("你必须先将" + ob->name() + "卸除。\n");
  target = present(id2, me);
  if (!target || (!target->is_armor() && !target->is_weapon()))
    return notify_fail("你身上没有" + id2 + "，或者它不是一件装备。\n");
  if (target->query("valid_time") > 0)
    return notify_fail(target->name() + "(" + capitalize(target->query("id")) + ")已经被绑定了，不能被吞噬。\n");
  if (me->query("family/family_name") && target->query("armor_title") == me->query("family/family_name"))
    return notify_fail("门派套装不能被其他装备融合。\n");
  if (target->query("combination"))
    return notify_fail("组合过的武器不能融合到其他装备。\n");
  if (target->query("equipped"))
    return notify_fail("你必须先将" + target->name() + "卸除。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (check_equip(ob, target) < 1)
    return notify_fail(target->name() + "的品质太差了，对" + ob->name() + "没啥帮助。\n");

  me->start_busy(1);
  message_vision(
    HIC "\n$N" HIC "将手中" + name() + "一扬，顿时一道霞光将$P手中的「" + COLOR_D->clean_color(ob->name()) + HIC "」和「" + COLOR_D->clean_color(target->name()) + HIC "」淹没了。\n" NOR,
    me
  );
  write(HIY "【装备融合】" + HBBLU + COLOR_D->clean_color(ob->name()) + NOR HIY " 融合了" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY "。" NOR "\n");

  if (ob->query("combination")) {
    string type;

    if (!stringp(type = ob->query("skill_type")))
      return notify_fail("组合武器无类型。\n");
    if (!mapp(my_prop = ob->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(my_prop) < 1)
      return notify_fail("装备无属性。\n");
    if (!mapp(base_apply = ob->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(base_apply) < 1)
      return notify_fail("装备无基本属性。\n");
    if (target->query("skill_type") != type)
      return notify_fail(ob->name() + "(" + capitalize(ob->query("id")) + ")与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的武器。\n");

    his_prop = target->query("weapon_prop");

    my_num = query_apply_number(ob);
    his_num = query_apply_number(target);

    if (wizardp(me)) {
      write(ob->name() + " 属性条目：" + my_num + "\n");
      write(target->name() + " 属性条目：" + his_num + "\n");
    }

    query_e = ("/cmds/std/look.lpc")->query_euqip_look();
    query_e2 = ("/cmds/std/look.lpc")->query_euqip_look2();

    props = keys(his_prop);
    new_props = ({});

    for (i = 0; i < sizeof(props); i++) {
      prop = props[i];
      if (!undefinedp(my_prop[prop])) {
        new_props += ({ prop });
        props -= ({ prop });
      }
    }

    for (i = 0; i < sizeof(props); i++) {
      prop = props[i];
      if (!undefinedp(base_apply[prop])) {
        new_props += ({ prop });
        props -= ({ prop });
      }
    }

    for (i = 0; i < sizeof(new_props); i++) {
      prop = new_props[i];
      //pp = his_prop[prop]/10;
      pp = his_prop[prop] * check_equip(ob, target) / 100;
      if (pp < 2) {
        if (!undefinedp(query_e2[prop]))
          pp = 2;
        else pp = 2 + random(2);
      }
      if (!undefinedp(base_apply[prop]))
        base_apply[prop] += pp;
      else my_prop[prop] += pp;

      msg = HIY "【装备融合】" + HBBLU + COLOR_D->clean_color(ob->name()) + NOR HIY "的 ";
      msg += NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " 增加了";
      if (!undefinedp(query_e2[prop]))
        msg += NOR + HBBLU + HIR + pp + "%" NOR;
      else msg += NOR + HBBLU + HIR + pp + "点" NOR;
      msg += "\n";
      write(msg);
    }
    if (!ob->save()) {
      write(HIR "【系统】" + ob->name() + HIR "保存失败，融合中断。\n" NOR);
      destruct(ob);
      return 1;
    }
    write(HIG "【系统】" + COLOR_D->clean_color(ob->name()) + HIG "保存成功。" NOR "\n");
    if (ob->update_combination(type))
      write(HIG "【系统】" + ob->name() + HIG "数据更新完毕。\n" NOR);
    destruct(target);
    if (query_amount() <= 1)
      destruct(this_object());
    else add_amount(-1);
    return 1;
  } else {
    if (ob->is_armor()) {
      if (ob->query("armor_type") != target->query("armor_type"))
        return notify_fail(ob->name() + "(" + capitalize(ob->query("id")) + ")与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的装备。\n");
      if (!mapp(my_prop = ob->query("armor_prop"))
        || sizeof(my_prop) < 1)
        return notify_fail("装备无属性。\n");
      his_prop = target->query("armor_prop");
      base_apply = ("/d/obj/narmor/newcloth.lpc")->equip_base(ob);
    } else {
      if (ob->query("skill_type") != target->query("skill_type"))
        return notify_fail(ob->name() + "(" + capitalize(ob->query("id")) + ")与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的装备。\n");
      if (!mapp(my_prop = ob->query("weapon_prop"))
        || sizeof(my_prop) < 1)
        return notify_fail("装备无属性。\n");
      his_prop = target->query("weapon_prop");
      base_apply = ("/d/obj/nweapon/newweapon.lpc")->equip_base(ob);
    }
    my_num = query_apply_number(ob);
    his_num = query_apply_number(target);

    if (wizardp(me)) {
      write(ob->name() + " 属性条目：" + my_num + "\n");
      write(target->name() + " 属性条目：" + his_num + "\n");
    }
    query_e = ("/cmds/std/look.lpc")->query_euqip_look();
    query_e2 = ("/cmds/std/look.lpc")->query_euqip_look2();

    props = keys(his_prop);
    new_props = ({});

    for (i = 0; i < sizeof(props); i++) {
      prop = props[i];
      if (!undefinedp(my_prop[prop])) {
        new_props += ({ prop });
        props -= ({ prop });
      }
    }

    for (i = 0; i < sizeof(new_props); i++) {
      prop = new_props[i];
      //pp = his_prop[prop]/10;
      pp = his_prop[prop] * check_equip(ob, target) / 100;
      if (pp < 1)
        pp = 1;
      if (ob->is_armor())
        ob->add("armor_prop/" + prop, pp);
      else ob->add("weapon_prop/" + prop, pp);
      msg = HIY "【装备融合】" + HBBLU + COLOR_D->clean_color(ob->name()) + NOR HIY "的 ";
      msg += NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " 增加了";
      if (!undefinedp(query_e2[prop]))
        msg += NOR + HBBLU + HIR + pp + "%" NOR;
      else msg += NOR + HBBLU + HIR + pp + "点" NOR;
      msg += "\n";
      write(msg);
    }
    if (!ob->save()) {
      write(HIR "【系统】" + ob->name() + HIR "保存失败，融合中断。\n" NOR);
      destruct(ob);
      return 1;
    }
    write(HIG "【系统】" + COLOR_D->clean_color(ob->name()) + HIG "保存成功。" NOR "\n");
    destruct(target);
    if (query_amount() <= 1)
      destruct(this_object());
    else add_amount(-1);
    return 1;
  }
}
