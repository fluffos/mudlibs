//装备转移equip_transfer.c
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;
nosave string *Transfer_Props = ({});
nosave string *New_Props = ({});

void setup() {}

int query_amount() { return amount; }

private void destruct_me() {
  remove_call_out("destruct_me");
  destruct(this_object());
}

void set_amount(int v) {
  object dest;

  if (v <= 0) {
    amount = 0;
    call_out("destruct_me", 1);
    return;
  } else {
    amount = v;
    this_object()->set_weight(v);
  }
}

void add_amount(int v) { set_amount(amount + v); }

string short() {
  string id;
  if (!stringp(id = query("owner_id")))
    id = "";
  else id = "[" + id + "]";
  return chinese_number(query_amount()) + query("base_unit") + ::short() + id;
}

varargs int move(mixed dest, int silent) {
  object env, *inv;
  int i, total, total0, result;
  string file;

  result = ::move(dest, silent);
  if (env = environment()) {
    file = base_name(this_object());
    inv = all_inventory(env);
    total = (int)query_amount();
    total0 = total;
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == this_object())
        continue;
      if (base_name(inv[i]) == file) {
        if (inv[i]->query("owner_id")
          && query("owner_id") != inv[i]->query("owner_id"))
          continue;
        set("owner_id", inv[i]->query("owner_id"));
        total += (int)inv[i]->query_amount();
        destruct(inv[i]);
      }
    }
    if (total != total0)
      set_amount(total);
  }
  return result;
}

void init() {
  if (userp(environment())) {
    if (!query("owner_id"))
      set("owner_id", environment()->query("id"));
  }
  add_action("do_ronghe", "transfer");
}

int is_family_mod(object ob) {
  string name, *fms;
  if (ob->is_armor())
    name = ob->query("armor_title");
  else name = ob->query("weapon_title");
  if (!name || !stringp(name) || strlen(name) < 2)
    return 0;
  name = COLOR_D->clean_color(name);
  fms = ({
    "将军府", "东海龙宫", "火云洞", "大雪山", "南海普陀山",
    "月宫", "百花谷", "五庄观", "蜀山派", "陷空山无底洞",
    "盘丝洞", "方寸山三星洞", "阎罗地府"
  });
  if (member_array(name, fms) != -1)
    return 1;
  return 0;
}


void create() {
  set_name("饕餮符", ({ "taotie fu", "fu", "fuwen", "fu wen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "张");
    set("unit", "叠");
    set(
      "long",
      HIG "饕餮者，吞纳万物。有大能参悟其中一丝法则，制作了此灵符。\n" HIW "功效：可以将装备属性转移(transfer)到同类型装备中去。\n" NOR HBBLU "注意：非绑定类装备可以被其他装备吞噬，但其本身不能吞噬其他装备。\n组合武器以及85级以下的门派套装不能转移及被转移。                \n" HBRED + HIG "命令格式：transfer <被转移装备名> to <对象装备名>               \n" HIW "注意：转移过程中，如果目标装备有同样的属性，那转移的属性可能会有\n50%左右的损毁。                                                 \n" NOR
    );
    set("no_sell", "这么珍贵的灵符你也舍得卖？！\n");
  }
  set_amount(1);
  setup();
}

int check_equip(object ob, object target) {
  int p, ap, dp;
  if (!ob || !target)
    return 1;
  if (ob->is_weapon()) {
    ap = ("/cmds/usr/top.lpc")->get_score3(ob);
    dp = ("/cmds/usr/top.lpc")->get_score3(target);
  } else {
    ap = ("/cmds/usr/top.lpc")->get_score4(ob);
    dp = ("/cmds/usr/top.lpc")->get_score4(target);
  }
  if (!target->is_zhaohuan())
    dp /= 2;
  p = dp * 100 / ap;
  if (p > 10)
    p = 10;
  if (p < 1)
    p = 1;
  return p;
}

//属性附加条数
int query_apply_number(object obj) {
  mapping prop, prop2;
  string type;
  int j, k;
  if (!obj)
    return 0;
  if (obj->query("combination")) {
    if (!stringp(type = obj->query("skill_type")))
      return 0;
    if (!mapp(prop = obj->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(prop) < 1)
      return 0;
    if (!mapp(prop2 = obj->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(prop2) < 1)
      return 0;
    j = sizeof(prop);
    k = sizeof(prop2);
    return j + k;
  } else {
    if (obj->is_armor())
      prop = obj->query("armor_prop");
    else prop = obj->query("weapon_prop");
    return sizeof(prop);
  }
}

mixed transfer_fu(object ob, object target) {
  string msg, *his_fus, fu, tmp, *my_fus, type, name, *applys, *mapplys, f_name;
  mapping his_fu_apply, fu_apply, his_fu_lvl, my_fu_apply, temp;
  int i, k, lvl, mylvl;

  if (!environment(ob) || !environment()
    || !environment(target))
    return 0;
  if (!arrayp(his_fus = target->query("enchase"))
    || sizeof(his_fus) < 1)
    return 0;
  if (!mapp(his_fu_lvl = target->query("fu"))
    || sizeof(his_fu_lvl) < 1)
    return 0;
  if (!mapp(his_fu_apply = target->query("fu_apply"))
    || sizeof(his_fu_apply) < 1)
    return 0;

  msg = "";
  if (!ob->query("combination")) {
    if (!arrayp(my_fus = ob->query("enchase"))
      || sizeof(my_fus) < 1)
      my_fus = ({});
    name = ob->name();
  } else {
    if (!stringp(type = ob->query("skill_type")))
      return HIR "【装备转移】组合武器" + ob->name(1) + HIR "因无法获取类型而导致符文转移失败。" NOR "\n";
    if (!arrayp(my_fus = ob->query("combination_dbase/" + type + "/enchase"))
      || sizeof(my_fus) < 1)
      my_fus = ({});
    name = "组合武器" + ob->name() + "[" + ("/cmds/std/look.lpc")->weapon_type(type) + "形态]";
  }

  environment()->set_temp("transfer/my_fus", my_fus);
  environment()->set_temp("transfer/his_fus", his_fus);

  for (i = 0; i < sizeof(his_fus); i++) {
    f_name = his_fus[i];
    if (sscanf(f_name, "%s符", fu) != 1) {
      msg += HIR "【装备转移】" HIY + fu + HIR "因名称有误，转移失败。" NOR "\n";
      continue;
    }
    if (undefinedp(his_fu_lvl[fu])) {
      msg += HIR "【装备转移】" HIY + fu + HIR "因无法获取等级，转移失败。" NOR "\n";
      continue;
    }
    lvl = his_fu_lvl[fu];
    if (lvl < 0) {
      msg += HIR "【装备转移】" HIY + fu + HIR "因等级为负，转移失败。" NOR "\n";
      continue;
    }
    tmp = fu + "_" + lvl;
    if (undefinedp(his_fu_apply[tmp])) {
      msg += HIR "【装备转移】" HIY + tmp + HIR "因无法获取加成属性，转移失败。" NOR "\n";
      continue;
    }
    fu_apply = his_fu_apply[tmp];
    applys = keys(fu_apply);
    if (!ob->query("combination")) {
      msg += HIC "【装备转移】" + name + HIC "获得了" HIY + chinese_number(lvl) + "级" HIC "符文：「" + HIY + fu + "符" HIC "」。" NOR "\n";
      if (member_array(f_name, my_fus) == -1) {
        my_fus += ({ f_name });
        ob->set("enchase", my_fus);
        ob->set("fu/" + fu, lvl);
        for (k = 0; k < sizeof(applys); k++)
          ob->set("fu_apply/" + tmp, fu_apply[applys[k]]);
      } else {
        mylvl = ob->query("fu/" + fu);
        my_fu_apply = ob->query("fu_apply/" + fu + "_" + mylvl);
        lvl += mylvl;
        ob->set("fu/" + fu, lvl);
        msg += HIY "【装备转移】" + name + HIY "镶嵌的符文：「" + HIC + fu + "符" HIY "」升级为" HIR + lvl + HIY "。" NOR "\n";
        temp = ([]);
        for (k = 0; k < sizeof(applys); k++)
          temp[applys[k]] = (my_fu_apply[applys[k]] + fu_apply[applys[k]]);
        ob->delete("fu_apply/" + fu + "_" + mylvl);
        ob->set("fu_apply/" + fu + "_" + lvl, temp);
      }
      if (target->query("perform_name")) {
        if (ob->query("perform_name")) {
          if (ob->query("perform_name") != target->query("perform_name"))
            msg += HIR "【装备转移】" + name + HIR "因存在绝招「" + ob->query("perform_name") + HIR "」，而无法获得「" + target->query("perform_name") + HIR "」。" NOR "\n";
        } else {
          if (!target->query("perform_dir"))
            ;
          else {
            ob->set("perform_name", target->query("perform_name"));
            ob->set("perform_dir", target->query("perform_dir"));
            msg += HIM "【装备转移】" + name + HIM "获得绝招「" + ob->query("perform_name") + HIM "」。" NOR "\n";
          }
        }
      }
      if (target->query("max_enchase") > ob->query("max_enchase")) {
        ob->set("max_enchase", target->query("max_enchase"));
        msg += HIY "【装备转移】" + name + HIY "的镶嵌槽位增加到" HIR + ob->query("max_enchase") + HIY "个。" NOR "\n";
      }
    } else {
      if (member_array(f_name, my_fus) == -1) {
        msg += HIC "【装备转移】" + name + HIC "获得了" HIY + chinese_number(lvl) + "级" HIC "符文：「" + HIY + fu + "符" HIC "」。" NOR "\n";
        my_fus += ({ f_name });
        ob->set("combination_dbase/" + type + "/enchase", my_fus);
        ob->set("combination_dbase/" + type + "/fu/" + fu, lvl);
        ob->set("combination_dbase/" + type + "/fu_apply/" + tmp, fu_apply);
      } else {
        mylvl = ob->query("combination_dbase/" + type + "/fu/" + fu);
        my_fu_apply = ob->query("combination_dbase/" + type + "/fu_apply/" + fu + "_" + mylvl);
        lvl += mylvl;
        ob->set("combination_dbase/" + type + "/fu/" + fu, lvl);
        msg += HIY "【装备转移】" + name + HIY "镶嵌的符文：「" + HIC + fu + "符" HIY "」升级为" HIR + lvl + HIY "。" NOR "\n";
        temp = ([]);
        for (k = 0; k < sizeof(applys); k++)
          temp[applys[k]] = (my_fu_apply[applys[k]] + fu_apply[applys[k]]);
        ob->delete("combination_dbase/" + type + "/fu_apply/" + fu + "_" + mylvl);
        ob->set("combination_dbase/" + type + "/fu_apply/" + fu + "_" + lvl, temp);
      }
      if (target->query("perform_name")) {
        if (ob->query("combination_dbase/" + type + "/perform_name")) {
          if (ob->query("combination_dbase/" + type + "/perform_name") != target->query("perform_name"))
            msg += HIR "【装备转移】" + name + HIR "因存在绝招「" + ob->query("combination_dbase/" + type + "/perform_name") + HIR "」，而无法获得「" + target->query("perform_name") + HIR "」。" NOR "\n";
        } else {
          if (!target->query("perform_dir"))
            ;
          else {
            ob->set("combination_dbase/" + type + "/perform_name", target->query("perform_name"));
            ob->set("combination_dbase/" + type + "/perform_dir", target->query("perform_dir"));
            msg += HIM "【装备转移】" + name + HIM "获得绝招「" + ob->query("combination_dbase/" + type + "/perform_name") + HIM "」。" NOR "\n";
          }
        }
      }
      if (target->query("max_enchase") > ob->query("combination_dbase/" + type + "/max_enchase")) {
        ob->set("combination_dbase/" + type + "/max_enchase", target->query("max_enchase"));
        msg += HIY "【装备转移】" + name + HIY "的镶嵌槽位增加到" HIR + ob->query("combination_dbase/" + type + "/max_enchase") + HIY "个。" NOR "\n";
      }
    }
  }
  if (msg != "")
    return msg;
  return 0;
}

void to_transfer(object me, object ob, object target) {
  string *props, msg, type, prop, *tmps, name;
  int i, j, k, pp, max;
  mapping my_prop, his_prop, query_e, query_e2, base_prop;

  if (!me || !present(this_object(), me)
    || !living(me))
    return;
  me->delete_temp("pending/ransfer_ob");
  me->delete_temp("pending/ransfer_target");

  if (!ob || !present(ob, me)) {
    tell_object(me, HIR "吞噬装备不存在，转移中断。\n" NOR);
    return;
  }
  if (!target || !present(target, me)) {
    tell_object(me, HIR "吞噬装备不存在，转移中断。\n" NOR);
    return;
  }

  query_e = ("/cmds/std/look.lpc")->query_euqip_look();
  query_e2 = ("/cmds/std/look.lpc")->query_euqip_look2();
  max = (ob->query("level") - 85) / 5 + 1;

  if (ob->query("combination")) {
    if (!stringp(type = ob->query("skill_type"))) {
      tell_object(me, "组合武器无类型。\n");
      return;
    }
    name = "组合武器" + ob->name() + "[" + ("/cmds/std/look.lpc")->weapon_type(type) + "形态]";
    if (!mapp(my_prop = ob->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(my_prop) < 1) {
      tell_object(me, name + "无属性。\n");
      return;
    }
    if (!mapp(base_prop = ob->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(base_prop) < 1) {
      tell_object(me, name + "无基本属性。\n");
      return;
    }
    his_prop = target->query("weapon_prop");
  } else {
    name = ob->name();
    if (ob->is_armor()) {
      if (!mapp(my_prop = ob->query("armor_prop"))
        || sizeof(my_prop) < 1) {
        tell_object(me, name + "无属性。\n");
        return;
      }
      his_prop = target->query("armor_prop");
    } else {
      if (!mapp(my_prop = ob->query("weapon_prop"))
        || sizeof(my_prop) < 1) {
        tell_object(me, name + "无属性。\n");
        return;
      }
      his_prop = target->query("weapon_prop");
    }
  }
  if (!ob->query("combination")) {
    for (i = 0; i < sizeof(Transfer_Props); i++) {
      prop = Transfer_Props[i];
      pp = his_prop[prop];
      if (!undefinedp(my_prop[prop]))
        pp = pp / 3 + random(pp / 2);
      if (pp < 1) {
        write(HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY " 的 " HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR HIY " 在转移过程中因数值过低，消逝了。" NOR "\n");
        continue;
      }
      msg = HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(ob->name()) + NOR;

      if (!undefinedp(my_prop[prop])) {
        my_prop[prop] += pp;
        msg += HIY "的 " NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " 增加了 " HIR + pp;
      } else {
        my_prop[prop] = pp;
        msg += HIY "获得新属性 " NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + " " HIR + pp;
      }
      if (!undefinedp(query_e2[prop]))
        msg += "%" HIY " 。" NOR;
      else msg += "点" HIY " 。" NOR;
      msg += "\n";
      write(msg);
    }

    ob->add("transfer", 1);

    message_vision(
      HIY "\n$N" HIY "祭起手中的" + name() + HIY "，顿时金光夺目，将$P手中的「" + COLOR_D->clean_color(ob->name()) + HIY "」和「" + COLOR_D->clean_color(target->name()) + HIY "」淹没了。\n" NOR,
      me
    );
    write(HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY " 的属性转移至 " + HBBLU + COLOR_D->clean_color(ob->name()) + NOR HIY "。" NOR "\n");

    if (stringp(msg = transfer_fu(ob, target))
      && strlen(msg) > 2)
      write(msg);
    if (target->is_zhaohuan()
      || target->query("valid_time")) {
      if (!target->do_dest(target->query("id"))) {
        write(HIR "【系统】" + target->name() + HIR "注销失败，转移中断。\n" NOR);
        destruct(target);
        destruct(ob);
        return;
      }
    } else destruct(target);
    if (!ob->save()) {
      write(HIR "【系统】" + ob->name() + HIR "保存失败，转移中断。\n" NOR);
      destruct(ob);
      return;
    }
    write(HIG "【系统】" + COLOR_D->clean_color(ob->name()) + HIG "保存成功。" NOR "\n");
    write(HIY "【系统】" + COLOR_D->clean_color(ob->name()) + HIY "目前吞噬其他装备次数为 " HIR + (int)ob->query("transfer") + HIY "/" HIR + max + HIY " ，每5级提升一次吞噬次数。" NOR "\n");
    log_file("transfer", ctime(time()) + " " + me->query("id") + " use transfer\n");

    if (query_amount() <= 1)
      destruct(this_object());
    else add_amount(-1);
    return;
  } else {
    for (i = 0; i < sizeof(Transfer_Props); i++) {
      prop = Transfer_Props[i];
      pp = his_prop[prop];

      if (!undefinedp(base_prop[prop])) {
        pp = pp / 2 + random(pp / 2);
        if (pp < 1) {
          write(HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY " 的 " HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR HIY " 在转移过程中因数值过低，消逝了。" NOR "\n");
          continue;
        }
        msg = HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(name) + NOR;
        base_prop[prop] += pp;
        msg += HIY "基本属性中的 " NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " 增加了 " HIR + pp;
        if (!undefinedp(query_e2[prop]))
          msg += "%" HIY " 。" NOR;
        else msg += "点" HIY " 。" NOR;
        msg += "\n";
        write(msg);
      } else if (!undefinedp(my_prop[prop])) {
        pp = pp / 2 + random(pp / 2);
        if (pp < 1) {
          write(HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY " 的 " HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR HIY " 在转移过程中因数值过低，消逝了。" NOR "\n");
          continue;
        }
        msg = HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(name) + NOR;
        my_prop[prop] += pp;
        msg += HIY "附加属性中的 " NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " 增加了 " HIR + pp;
        if (!undefinedp(query_e2[prop]))
          msg += "%" HIY " 。" NOR;
        else msg += "点" HIY " 。" NOR;
        msg += "\n";
        write(msg);
      } else {
        if (pp < 1) {
          write(HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(target->name()) + NOR HIY " 的 " HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR HIY " 在转移过程中因数值过低，消逝了。" NOR "\n");
          continue;
        }
        msg = HIY "【装备转移】" + HBBLU + COLOR_D->clean_color(name) + NOR;
        my_prop[prop] = pp;
        msg += HIY "附加属性增加了 " NOR + HBBLU + HIR + ("/cmds/std/look.lpc")->_look_equip_apply(prop) + NOR + HIY " " HIR + pp;
        if (!undefinedp(query_e2[prop]))
          msg += "%" HIY " 。" NOR;
        else msg += "点" HIY " 。" NOR;
        msg += "\n";
        write(msg);
      }
    }
    ob->add("combination_dbase/" + type + "/transfer", 1);
    if (stringp(msg = transfer_fu(ob, target))
      && strlen(msg) > 2)
      write(msg);
    if (target->is_zhaohuan()
      || target->query("valid_time")) {
      if (!target->do_dest(target->query("id"))) {
        write(HIR "【系统】" + target->name() + HIR "注销失败，转移中断。\n" NOR);
        destruct(target);
        destruct(ob);
        return;
      }
    } else destruct(target);
    if (!ob->save()) {
      write(HIR "【系统】" + name + HIR "保存失败，转移中断。\n" NOR);
      destruct(ob);
      return;
    }
    write(HIG "【系统】" + COLOR_D->clean_color(name) + HIG "保存成功。" NOR "\n");
    if (ob->update_combination(type))
      write(HIG "【系统】" + ob->name() + HIG "数据更新完毕。\n" NOR);
    write(HIY "【系统】" + COLOR_D->clean_color(name) + HIY "目前吞噬其他装备次数为 " HIR + (int)ob->query("combination_dbase/" + type + "/transfer") + HIY "/" HIR + max + HIY " ，每5级提升一次吞噬次数。" NOR "\n");
    log_file("transfer", ctime(time()) + " " + me->query("id") + " use transfer\n");
    if (query_amount() <= 1)
      destruct(this_object());
    else add_amount(-1);
    return;
  }
}

void _transfer2(string arg, object me) {
  string str, *props;
  object ob, target;
  int i, j, k, max;
  if (!me || !present(this_object(), me)
    || !living(me))
    return;
  if (!objectp(ob = me->query_temp("pending/ransfer_ob"))
    || !present(ob, me)) {
    tell_object(me, HIR "吞噬装备不存在，转移中断。\n" NOR);
    return;
  }
  if (!objectp(target = me->query_temp("pending/ransfer_target"))
    || !present(target, me)) {
    tell_object(me, HIR "被吞噬装备不存在，转移中断。\n" NOR);
    return;
  }
  if (!arg) {
    tell_object(me, HIY "请输入需要吞噬属性的英文ID，不止1个的请用" HIW "," HIY "隔开：" NOR);
    input_to("_transfer2", me);
    return;
  }
  arg = replace_string(arg, "，", ",");
  if (strsrch(arg, ",") == -1)
    props = ({ arg });
  else props = explode(arg, ",");
  j = query_apply_number(ob);
  k = sizeof(props);
  max = (ob->query("level") - 85) / 9 + 12;
  if (j + k > max) {
    k = sizeof(New_Props);
    tell_object(
      me,
      sprintf(
        HIR "新增属性条目数为" HIY "%d" HIR "，现有属性条目数为" HIY "%d" HIR "，最大支持属性条目数" HIY "%d" HIR "。" NOR "\n",
        k,
        j,
        max
      )
    );
    return;
  }
  while (k--) {
    if (member_array(props[k], New_Props) == -1) {
      tell_object(me, HIR "增加属性中没有" + props[k] + "，转移中断。\n" NOR);
      return;
    }
    if (member_array(props[k], Transfer_Props) == -1) {
      tell_object(me, HIR "转移属性中没有" + props[k] + "，转移中断。\n" NOR);
      return;
    }
  }
  for (i = 0; i < sizeof(New_Props); i++) {
    if (member_array(New_Props[i], props) == -1) {
      if (member_array(New_Props[i], Transfer_Props) != -1)
        Transfer_Props -= ({ New_Props[i] });
    }
  }
  New_Props = props;
  to_transfer(me, ob, target);
  return;
}

void _transfer(string arg, object me) {
  string str;
  object ob, target;
  int j, k, max;
  if (!me || !present(this_object(), me)
    || !living(me))
    return;
  if (!objectp(ob = me->query_temp("pending/ransfer_ob"))
    || !present(ob, me)) {
    tell_object(me, HIR "吞噬装备不存在，转移中断。\n" NOR);
    return;
  }
  if (!objectp(target = me->query_temp("pending/ransfer_target"))
    || !present(target, me)) {
    tell_object(me, HIR "被吞噬装备不存在，转移中断。\n" NOR);
    return;
  }

  if (!arg) {
    tell_object(me, HIY "你是否确定进行属性转移？Y/N：" NOR);
    input_to("_transfer", me);
    return;
  }
  if (arg[0] != 'Y' && arg[0] != 'y') {
    tell_object(me, HIR "你取消了装备属性转移进程。\n" NOR);
    return;
  }
  j = query_apply_number(ob);
  k = sizeof(New_Props);
  max = (ob->query("level") - 85) / 9 + 12;
  if (j + k > max) {
    tell_object(
      me,
      sprintf(
        HIR "新增属性条目数为" HIY "%d" HIR "，现有属性条目数为" HIY "%d" HIR "，最大支持属性条目数" HIY "%d" HIR "。" NOR "\n",
        k,
        j,
        max
      )
    );
    tell_object(me, HIC "你可以从以下新增属性中手动选择要吞噬的属性(至多不能超过" + HIR + (max - j) + HIC "个)：\n" NOR);
    str = "";
    while (k--)
      str += sprintf(
        "\t%s (%s)\n",
        ("/cmds/std/look.lpc")->_look_equip_apply(New_Props[k]),
        New_Props[k]
      );
    str += HIY "请输入需要吞噬属性的英文ID，不止1个的请用" HIW "," HIY "隔开：" NOR;
    tell_object(me, str);
    input_to("_transfer2", me);
    return;
  } else to_transfer(me, ob, target);
  return;
}

int do_ronghe(string arg) {
  object ob, target, me = this_player();
  string id1, id2, *props, msg, type, prop, *tmps, name;
  int i, j, k, now, max, pp, max_num;
  mapping my_prop, his_prop, query_e, query_e2;

  if (!present(this_object(), me))
    return 0;
  if ((me->query("potential") - me->query("learned_points")) < 500)
    return notify_fail("你的潜能不足500。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (!query("owner_id") || query("owner_id") != me->query("id"))
    return notify_fail(name() + "上霞光闪了几闪，却是什么反应也没有。\n");
  if (!arg || sscanf(arg, "%s to %s", id2, id1) != 2)
    return notify_fail("命令格式：transfer <被转移装备名> to <目标装备名>\n" HIR "注意：转移过程中，如果目标装备有同样的属性，那转移的属性可能会有50%左右的损毁。\n转移成功后，转移属性的装备将消失。\n" NOR);
  ob = present(id1, me);
  if (!ob || (!ob->is_armor() && !ob->is_weapon()))
    return notify_fail("你身上没有" + id1 + "，或者它不是一件装备。\n");
  if (!ob->query("valid_time"))
    return notify_fail(ob->name() + "不是绑定的装备，不能转移其他装备。\n");
  if (ob->query("equipped"))
    return notify_fail("你必须先将" + ob->name() + "卸除。\n");
  if (ob->query("level") < 85)
    return notify_fail(ob->name() + "必需达到85级才能接受其他装备的属性转移。\n");
  max = (ob->query("level") - 85) / 5 + 1;
  if (ob->query("combination")) {
    if (!stringp(type = ob->query("skill_type")))
      return notify_fail("组合武器无类型。\n");
    name = "组合武器" + ob->name() + "[" + ("/cmds/std/look.lpc")->weapon_type(type) + "形态]";
    now = ob->query("combination_dbase/" + type + "/transfer");
  } else {
    now = ob->query("transfer");
    name = ob->name();
  }
  if (now >= max)
    return notify_fail(name + "目前为 " HIR + ob->query("level") + NOR " 级，吞噬次为 " HIR + now + NOR "/" HIR + max + NOR " ，如想再次吞噬，需提升至 " HIR + (int)(max * 5 + 85) + NOR " 。\n");

  max_num = (ob->query("level") - 85) / 9 + 12;
  if (query_apply_number(ob) >= max_num)
    return notify_fail("你的" + name + "目前为" HIR + ob->query("level") + NOR "级，属性条目数限制为" + HIR + query_apply_number(ob) + "/" + max_num + NOR "，要想继续增加属性条目，必须再提高" HIR + ((max_num - 11) * 9 + 85 - ob->query("level")) + NOR "级。\n");

  target = present(id2, me);
  if (!target || (!target->is_armor() && !target->is_weapon()))
    return notify_fail("你身上没有" + id2 + "，或者它不是一件装备。\n");
  if (target->query("combination"))
    return notify_fail("组合过的武器不能转移到其他装备。\n");
  if (target->query("equipped"))
    return notify_fail("你必须先将" + target->name() + "卸除。\n");
  if (is_family_mod(target) && target->query("level") < 85)
    return notify_fail("85级以下的门派套装不能转移到其他装备。\n");

  if (check_equip(ob, target) < 1)
    return notify_fail(target->name() + "的品质相对而言太差了，对" + name + "没啥帮助。\n");


  me->start_busy(1);

  if (!ob->query("combination")) {
    if (ob->is_armor()) {
      if (ob->query("armor_type") != target->query("armor_type"))
        return notify_fail(name + "与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的装备。\n");
      if (!mapp(my_prop = ob->query("armor_prop"))
        || sizeof(my_prop) < 1)
        return notify_fail(name + "无属性。\n");
      his_prop = target->query("armor_prop");
    } else {
      if (ob->query("skill_type") != target->query("skill_type"))
        return notify_fail(name + "与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的装备。\n");
      if (!mapp(my_prop = ob->query("weapon_prop"))
        || sizeof(my_prop) < 1)
        return notify_fail("装备无属性。\n");
      his_prop = target->query("weapon_prop");
    }
    if (!pointerp(props = keys(his_prop))
      || !intp(k = sizeof(props))
      || k < 1)
      return notify_fail(target->name() + "没什么属性。\n");

    Transfer_Props = ({});
    New_Props = ({});

    while (k--) {
      if (undefinedp(my_prop[props[k]])) {
        if (member_array(props[k], New_Props) != -1)
          return notify_fail(HIR "【系统】" + BLK + "出现未知错误：" NOR HIR + props[k] + NOR HIR BLK "在新增属性阵列发现重复值，请联系" NOR HIW "巫师" NOR HIR BLK "！" NOR "\n");
        New_Props += ({ props[k] });
      } else {
        if (member_array(props[k], Transfer_Props) != -1)
          return notify_fail(HIR "【系统】" + BLK + "出现未知错误：" NOR HIR + props[k] + NOR HIR BLK "在提升属性阵列发现重复值，请联系" NOR HIW "巫师" NOR HIR BLK "！" NOR "\n");
      }
      Transfer_Props += ({ props[k] });
    }

    msg = "【装备转移】" + name + " 吞噬 " + target->name() + "，将发生如下变化：\n";
    msg = COLOR_D->clean_color(msg);
    msg = COLOR_D->replace_color(HIY + msg + NOR, 1);
    msg += HIG "以下属性得到提升" NOR "\n";
    k = 0;
    for (i = 0; i < sizeof(Transfer_Props); i++) {
      if (member_array(Transfer_Props[i], New_Props) != -1)
        continue;
      k++;
      msg += "\t" HIC + ("/cmds/std/look.lpc")->_look_equip_apply(Transfer_Props[i]) + NOR;
      if (k % 3 == 2)
        msg += "\n";
      else msg += "、";
    }
    msg += HIG "\n获得以下新属性" NOR "\n";
    for (i = 0; i < sizeof(New_Props); i++) {
      msg += "\t" HIC + ("/cmds/std/look.lpc")->_look_equip_apply(New_Props[i]) + NOR;
      if (i % 3 == 2)
        msg += "\n";
      else msg += "、";
    }
    msg += "\n";
    msg += HIY "你是否确定进行属性转移？Y/N：" NOR;
    write(msg);
    me->set_temp("pending/ransfer_ob", ob);
    me->set_temp("pending/ransfer_target", target);
    input_to("_transfer", me);
    return 1;
  } else {
    mapping base_prop;
    if (target->query("skill_type") != type)
      return notify_fail(name + "与" + target->name() + "(" + capitalize(target->query("id")) + ")不是同一类型的装备。\n");
    if (!mapp(my_prop = ob->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(my_prop) < 1)
      return notify_fail("组合装备无属性。\n");
    if (!mapp(base_prop = ob->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(base_prop) < 1)
      return notify_fail("组合装备无属性。\n");

    his_prop = target->query("weapon_prop");
    if (!pointerp(props = keys(his_prop))
      || !intp(k = sizeof(props))
      || k < 1)
      return notify_fail(target->name() + "没什么属性。\n");

    Transfer_Props = ({});
    New_Props = ({});

    while (k--) {
      if (undefinedp(my_prop[props[k]])
        && undefinedp(base_prop[props[k]])) {
        if (member_array(props[k], New_Props) != -1)
          return notify_fail(HIR "【系统】" + BLK + "出现未知错误：" NOR HIR + props[k] + NOR HIR BLK "在新增属性阵列发现重复值，请联系" NOR HIW "巫师" NOR HIR BLK "！" NOR "\n");
        New_Props += ({ props[k] });
      } else {
        if (member_array(props[k], Transfer_Props) != -1)
          return notify_fail(HIR "【系统】" + BLK + "出现未知错误：" NOR HIR + props[k] + NOR HIR BLK "在提升属性阵列发现重复值，请联系" NOR HIW "巫师" NOR HIR BLK "！" NOR "\n");
      }
      Transfer_Props += ({ props[k] });
    }

    msg = "【装备转移】" + name + " 吞噬 " + target->name() + "，将发生如下变化：\n";
    msg = COLOR_D->clean_color(msg);
    msg = COLOR_D->replace_color(HIY + msg + NOR, 1);
    msg += HIG "以下属性得到提升" NOR "\n";
    k = 0;
    for (i = 0; i < sizeof(Transfer_Props); i++) {
      if (member_array(Transfer_Props[i], New_Props) != -1)
        continue;
      k++;
      msg += sprintf(
        "\t" HIC "%24-s" NOR,
        ("/cmds/std/look.lpc")->_look_equip_apply(Transfer_Props[i])
      );
      if (k % 3 == 2)
        msg += "\n";
      else msg += "、";
    }
    msg += HIG "\n获得以下新属性" NOR "\n";
    for (i = 0; i < sizeof(New_Props); i++) {
      msg += sprintf("\t" HIC "%24-s" NOR, ("/cmds/std/look.lpc")->_look_equip_apply(New_Props[i]));
      if (i % 3 == 2)
        msg += "\n";
      else msg += "、";
    }
    msg += "\n";
    msg += HIY "你是否确定进行属性转移？Y/N：" NOR;
    write(msg);
    me->set_temp("pending/ransfer_ob", ob);
    me->set_temp("pending/ransfer_target", target);
    input_to("_transfer", me);
    return 1;
  }
}
