	"寒冰": "hanbing",	"飞轮": "feilun",	"血石": "xieshi",
	"清风": "qingfeng",	"惊雷": "jinglei",	"万寒": "wanhan",
	"月轮": "yuelun",	"凝血": "ningxie",	"冰风": "bingfeng",
	"寒雷": "hanlei",	"万轮": "wanlun",	"血轮": "xielun",
	"风轮": "fenglun",	"雷爆": "leibao",	"戾血": "lixie",
	"腥风": "xingfeng",	"血雷": "xielei",	"飓风": "jufeng",
	"风雷": "fenglei",	"万雷": "wanlei",
]);

nosave mapping Enchanse_W = ([
	"寒冰": ([ "blade" : NOR HIW"寒潭飞花"HIG" perform feihua"NOR,
		   "dagger": NOR HIW"丝丝入扣"HIG" perform sisi"NOR,
		   "whip"  : NOR HIW"寒意连绵"HIG" perform hanyi"NOR, ]),
	"飞轮": ([ "fork"  : NOR HIY"七巧连环"HIG" perform qiqiao"NOR,
	           "hammer": NOR HIY"大地裂痕"HIG" perform liehen"NOR,
	           "staff" : NOR HIY"金刚佛轮"HIG" perform folun"NOR, ]),
	"血石": ([ "axe"   : NOR HIR"混世戾斩"HIG" perform hunshi"NOR,	
	           "stick" : NOR HIR"小儿夜啼"HIG" perform yeti"NOR,
	           "sword" : NOR HIR"血海红花"HIG" perform honghua"NOR, ]),
	"清风": ([ "mace"  : NOR HIC"缓中有急"HIG" perform huanji"NOR,
	          "unarmed": NOR HIC"翻云覆雨"HIG" perform yunyu"NOR,
	             "whip": NOR HIC"清风拂柳"HIG" perform fuliu"NOR, ]),
	"惊雷": ([   "rake": NOR HIM"天河惊雷"HIG" perform tianhe"NOR,
	            "spear": NOR HIM"雷炎飞虹"HIG" perform leihong"NOR, ]),
]);

nosave mapping Enchanse_W2 = ([
	"寒冰": 2,	"飞轮": 3,	"血石": 3,
	"清风": 2,	"惊雷": 3,
]);

nosave mapping Enchanse_A = ([
	"寒冰": 1,	"飞轮": 2,	"血石": 1,
	"清风": 3,	"惊雷": 1,
]);

void setup()
{
	string long;
	if( stringp(long=this_object()->query("f_name")) 
      	 && !undefinedp(Fnames[long]) )
		set_name(long+"符",({Fnames[long]+" fu","fu wen","fu"}));
}

int query_amount() { return amount; }

private void destruct_me() 
{ 
	remove_call_out("destruct_me");
	destruct(this_object()); 
}

void set_amount(int v)
{
    object dest;

	if( v<=0 )
	{
	   amount=0; 
	   call_out("destruct_me", 1);
	   return;
	}
	else 
	{
		amount = v;
		this_object()->set_weight(v);
	}
}

void add_amount(int v) { set_amount(amount+v); }

string short()
{
	string id;
	if( !stringp(id=query("owner_id")) )
		id = "";
	else	id = "["+id+"]";	
	return chinese_number(query_amount()) + query("base_unit")+ ::short()+id;
}

varargs int move(mixed dest, int silent)
{
	object env, *inv;
	int i, total, total0, result;
	string file;

	result= ::move(dest, silent);
	if(env = environment()) 
	{
		file = base_name(this_object());
		inv = all_inventory(env);
		total = (int)query_amount();
		total0=total;
		for(i=0; i<sizeof(inv); i++) 
		{
			if( inv[i]==this_object() ) 
				continue;
			if( base_name(inv[i])==file ) 
			{
				if( inv[i]->query("owner_id")
				 && query("owner_id")!=inv[i]->query("owner_id") )
				 	continue;
				if( inv[i]->query("level")!=query("level") )
					continue;
				set("owner_id",inv[i]->query("owner_id"));	
				total += (int)inv[i]->query_amount();
				destruct(inv[i]);
			}
		}
		if(total!=total0)
			set_amount(total);
	}
	return result;
}

void create() 
{
	string long;
	set_name("符文", ({ "fu wen","fu" }));
        set_weight(50);
        long = "绘纹师使用各种珍贵材料绘制的符文，将材料的精华浓缩在小小的法阵之内。将之镶嵌(enchase)到装备之上，会使装备的质地更进一步。\n";
        long = sort_string(long,64,0);
        set("long",long);
        set("changed",1);
       	set("unit", "些");
       	set("base_unit","张");
	set("value", 0);
      	setup();
      	set_amount(1);
}

mapping base_weapon(string type)
{
	if( !type )
		return 0;
	switch(type)
	{
		case "dagger" :
			return ([
				"combat_damage":10,
				"spells_damage":5,
			]);
		case "axe" :
			return ([
				"combat_damage":35,
				"spells_damage":15,
			]);
		case "blade" :
			return ([
				"combat_damage":30,
				"spells_damage":25,
			]);
		case "fork" : 
			return ([
				"combat_damage":25,
				"spells_damage":20,
			]);
		case "hammer"  :
			return ([
				"combat_damage":40,
				"spells_damage":10,
			]);
		case "mace" : 
			return ([
				"combat_damage":35,
				"spells_damage":20,
			]);
		case "sword" : 
			return ([
				"combat_damage":30,
				"spells_damage":30,
			]);
		case "staff" : 
			return ([
				"combat_damage":30,
				"spells_damage":40,
			]);
		case "stick" : 
			return ([
				"combat_damage":35,
				"spells_damage":25,
			]);
		case "whip" : 
			return ([
				"combat_damage":15,
				"spells_damage":25,
			]);
		case "spear" : 
			return ([
				"spells_damage":15,
				"combat_damage":30,
			]);
		case "unarmed" : 
			return ([
				"spells_damage":15,
				"combat_damage":15,
			]);
		case "rake" : 
			return ([
				"spells_damage":15,
				"combat_damage":35,
			]);	
		default : return 0;
	}
}

mapping base_armor(string type)
{
	if( !type )
		return 0;
	switch(type)
	{
		case TYPE_ARMOR : return (["combat_def":35]);
		case TYPE_CLOTH :
		case TYPE_SKIRT : return ([
				"combat_def":18,
				"spells_def":18,
			]);
		case TYPE_SURCOAT : return ([ "spells_def":24,]);
		case TYPE_HEAD : return ([
				"combat_def":6,
				"spells_def":6,
			]);
		case TYPE_SHIELD : return ([
				"combat_def":5,
				"spells_def":5,
				"combat_parry" : 2,
			]);
		case TYPE_BOOTS : return ([
				"combat_def":8,
				"spells_def":8,
				"spells_dodge" : 2,
				"combat_dodge" : 2,
			]);
		case TYPE_WAIST : return ([ "max_kee":50,]);
		case TYPE_NECK : return ([
				"spells_succ":1,
				"combat_succ":1,
				"spells_dodge" : 1,
				"spells_dodge" : 1,
			]);
		case TYPE_WRISTS : return ([ "max_sen":50,]);
		case TYPE_FINGER : return ([
				"spells_damage":7,
				"combat_damage":7,
			]);
		case TYPE_HANDS : return ([ "combat_parry" : 4,]);
		default : return 0;
	}
}

varargs string name(int v)
{
	int lvl;
	string str = ::name(v);
	if( !intp(lvl=query("level"))
	 || lvl<1 )
	 	return str;
	return chinese_number(lvl)+"阶"+str;
}

varargs string long(int v)
{
	int i,k,lvl,p,p1,p2,pp;
	mapping juezhao,euqip_look1,euqip_look2;
	string arg,name,str,*ws,*tmp,long = ::long(v);
	if( !stringp(name=query("f_name"))
	 || member_array(name,keys(Fnames))==-1 )
	 	return long;
	str = HIC"□"NOR"武器镶嵌效果：\n";
	lvl = this_object()->query("level");
	if( !undefinedp(Enchanse_W2[name]) )
	{
		p = Enchanse_W2[name];
		ws = ({"axe","blade","dagger","fork","hammer","mace","rake","spear","staff","stick","sword","unarmed","whip",});
		arg = "";
		for(i=0;i<sizeof(ws);i++)
		{
			if( !mapp(juezhao = base_weapon(ws[i])) )
				continue;
			p1 = juezhao["combat_damage"];
			p2 = juezhao["spells_damage"];
			p1+= lvl*p;
			p2+= lvl*p;
			arg+= sprintf("      "HIY"%4-s"NOR"类武器，物攻"HIR"+"HIY"%-3d"NOR" 法攻"HIR"+"HIY"%-3d"NOR,("/cmds/std/look.lpc")->weapon_type(ws[i]),p1,p2);
			if( !undefinedp(Enchanse_W[name]) )
			{
				juezhao = Enchanse_W[name];
				if( !undefinedp(juezhao[ws[i]]) )
					arg+= sprintf("，激活外功：%s",juezhao[ws[i]]);
			}
			arg+= "\n";
		}
	}
	str+= arg;
	
	str+= HIC"□"NOR"防具镶嵌效果：\n";
	if( !undefinedp(Enchanse_A[name]) )
	{
		euqip_look2 = ("/cmds/std/look.lpc")->query_euqip_look2();
		euqip_look1 = ("/cmds/std/look.lpc")->query_euqip_look1();
		p = Enchanse_A[name];
		ws = ({TYPE_ARMOR,TYPE_CLOTH,TYPE_SURCOAT,TYPE_HEAD,TYPE_SHIELD,TYPE_BOOTS,TYPE_WAIST,TYPE_NECK,TYPE_WRISTS,TYPE_FINGER,TYPE_HANDS});
		arg = "";
		for(i=0;i<sizeof(ws);i++)
		{
			if( !mapp(juezhao = base_armor(ws[i])) )
				continue;
			tmp = keys(juezhao);
			arg+= sprintf("      "HIY"%4-s"NOR"类防具，",("/cmds/std/look.lpc")->armor_type(ws[i]));
			for(k=0;k<sizeof(tmp);k++)
			{
				if( !undefinedp(euqip_look2[tmp[k]]) )
					pp = 1;
				else	pp = juezhao[tmp[k]]/2+lvl*p;
				if( !undefinedp(euqip_look2[tmp[k]]) )
					arg+= sprintf("%10-s"HIR"+"HIY"%3-s "NOR,euqip_look2[tmp[k]],pp+"%");
				else 	arg+= sprintf("%10-s"HIR"+"HIY"%3-s "NOR,euqip_look1[tmp[k]],pp+" ");	
			}
			arg+= "\n";
		}
	}
	str+= arg;
	
	long = COLOR_D->replace_color(HIY+name(1)+"("+capitalize(query("id"))+")")+NOR"\n"+long+str;
	return long;
}

void init() 
{
	if( !query("owner_id") && environment() && userp(environment()) )
                   set("owner_id",environment()->query("id"));
	add_action("do_bd",({"enchase","qian","xiangqian",}));
}

int enchase_armor(object me,object armor)
{
	mapping new_prop,euqip_look1,euqip_look2;
	string type,*ws,f_name,*old_ens;
	int p,pp,i,lvl;
	if( !me || !living(me) || !present(this_object(),me)
	 || !armor || !present(armor,me)
	 || armor->query("equipped") )
	 	return 0;
	if( !stringp(f_name=query("f_name")) 
	 || undefinedp(Enchanse_A[f_name]) )
		return 0;
	p = Enchanse_A[f_name];
	if( p<1 )
		return 0;	
	if( !stringp(type = armor->query("armor_type"))
	 || !mapp(new_prop=base_armor(type)) )
	 	return 0;
	euqip_look2 = ("/cmds/std/look.lpc")->query_euqip_look2();
	euqip_look1 = ("/cmds/std/look.lpc")->query_euqip_look1();
	ws = keys(new_prop);
	pp = 0;
	lvl = this_object()->query("level");
	old_ens = armor->query("enchase");
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	old_ens-=({0});
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	for(i=0;i<sizeof(ws);i++)
	{
		if( !undefinedp(euqip_look2[ws[i]]) ) //百分比
			pp = 1;
		else	pp = new_prop[ws[i]]/2+lvl*p;
		armor->add("armor_prop/"+ws[i],pp);
		armor->set("fu/"+f_name,lvl);
		armor->add("fu_apply/"+f_name+"_"+lvl+"/"+ws[i],pp);
		if( !undefinedp(euqip_look2[ws[i]]) )
			tell_object(me,HIG"【系统】"+armor->name(1)+HIG"的 "HIY+euqip_look2[ws[i]]+HIG" 增加了 "HIR+pp+"%  "HIG"。\n"NOR);
		else	tell_object(me,HIG"【系统】"+armor->name(1)+HIG"的 "HIY+euqip_look1[ws[i]]+HIG" 增加了 "HIR+pp+"点 "HIG"。\n"NOR);	
	}
	old_ens+= ({f_name+"符"});
	armor->set("enchase",old_ens);
	if( stringp(armor->query_save_file()) )
		return (int)armor->save();
	else	return 1;	
}

int enchase_weapon(object me,object weapon)
{
	mapping new_prop,euqip_look1,euqip_look2,temp;
	string type,*ws,f_name,*old_ens,pfm_name,id;
	int p,pp,i,lvl;
	if( !me || !living(me) || !present(this_object(),me)
	 || !weapon || !present(weapon,me)
	 || weapon->query("equipped") )
	 	return 0;
	if( !stringp(f_name=query("f_name")) 
	 || undefinedp(Enchanse_W2[f_name]) )
		return 0;
	p = Enchanse_W2[f_name];
	if( p<1 )
		return 0;	
	if( !stringp(type = weapon->query("skill_type"))
	 || !mapp(new_prop=base_weapon(type)) )
	 	return 0;
	id = Fnames[f_name];	 	
	euqip_look2 = ("/cmds/std/look.lpc")->query_euqip_look2();
	euqip_look1 = ("/cmds/std/look.lpc")->query_euqip_look1();
	ws = keys(new_prop);
	pp = 0;
	lvl = this_object()->query("level");
	old_ens = weapon->query("enchase");
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	old_ens-=({0});
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	for(i=0;i<sizeof(ws);i++)
	{
		if( !undefinedp(euqip_look2[ws[i]]) ) //百分比
			pp = 1;
		else	pp = new_prop[ws[i]]/2+lvl*p;
		weapon->add("weapon_prop/"+ws[i],pp);
		weapon->set("fu/"+f_name,lvl);
		weapon->add("fu_apply/"+f_name+"_"+lvl+"/"+ws[i],pp);
		if( !undefinedp(euqip_look2[ws[i]]) )
			tell_object(me,HIG"【系统】"+weapon->name(1)+HIG"的 "HIY+euqip_look2[ws[i]]+HIG" 增加了 "HIR+pp+"%  "HIG"。\n"NOR);
		else	tell_object(me,HIG"【系统】"+weapon->name(1)+HIG"的 "HIY+euqip_look1[ws[i]]+HIG" 增加了 "HIR+pp+"点 "HIG"。\n"NOR);	
	}
	old_ens+= ({f_name+"符"});
	weapon->set("enchase",old_ens);
	//激活外功
	if( !undefinedp(Enchanse_W[f_name]) )
	{
		temp = Enchanse_W[f_name];
		if( !undefinedp(temp[type]) )
		{
			pfm_name = temp[type];
			weapon->set("perform_name",pfm_name);
			weapon->set("perform_dir","enchase/"+type+"/"+id); 
			tell_object(me,HIG"【系统】"+weapon->name(1)+HIG"成功激活了绝招「"+pfm_name+HIG"」"NOR"\n");
		}
	}
	if( stringp(weapon->query_save_file()) )
		return (int)weapon->save();
	else	return 1;	
}
//组合武器
int enchase_weapon2(object me,object weapon)
{
	mapping new_prop,euqip_look1,euqip_look2,temp;
	string type,*ws,f_name,*old_ens,pfm_name,id,name;
	int p,pp,i,lvl;
	if( !me || !living(me) || !present(this_object(),me)
	 || !weapon || !present(weapon,me)
	 || weapon->query("equipped") )
	 	return 0;
	if( !stringp(f_name=query("f_name")) 
	 || undefinedp(Enchanse_W2[f_name]) )
		return 0;
	p = Enchanse_W2[f_name];
	if( p<1 )
		return 0;	
	if( !stringp(type = weapon->query("skill_type"))
	 || !mapp(new_prop=base_weapon(type)) )
	 	return 0;
	
	name = ("/cmds/std/look.lpc")->weapon_type(type);
	name = "组合武器"+weapon->name(1)+"之"+name+"形态"; 	
	id = Fnames[f_name];	 	
	euqip_look2 = ("/cmds/std/look.lpc")->query_euqip_look2();
	euqip_look1 = ("/cmds/std/look.lpc")->query_euqip_look1();
	ws = keys(new_prop);
	pp = 0;
	lvl = this_object()->query("combination_dbase/"+type+"/level");
	old_ens = weapon->query("combination_dbase/"+type+"/enchase");
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	old_ens-=({0});
	if( !old_ens || !pointerp(old_ens)
	 || sizeof(old_ens)<1 )
	 	old_ens = ({});
	for(i=0;i<sizeof(ws);i++)
	{
		if( !undefinedp(euqip_look2[ws[i]]) ) //百分比
			pp = 1;
		else	pp = new_prop[ws[i]]/2+lvl*p;
		
		if( weapon->query("combination_dbase/"+type+"/base_prop/"+ws[i])!=0 )
			weapon->add("combination_dbase/"+type+"/base_prop/"+ws[i],pp);
		else	weapon->add("combination_dbase/"+type+"/weapon_pro/"+ws[i],pp);
		
		weapon->set("combination_dbase/"+type+"/fu/"+f_name,lvl);
		weapon->add("combination_dbase/"+type+"/fu_apply/"+f_name+"_"+lvl+"/"+ws[i],pp);
		if( !undefinedp(euqip_look2[ws[i]]) )
			tell_object(me,HIG"【系统】"+name+HIG"的 "HIY+euqip_look2[ws[i]]+HIG" 增加了 "HIR+pp+"%  "HIG"。\n"NOR);
		else	tell_object(me,HIG"【系统】"+name+HIG"的 "HIY+euqip_look1[ws[i]]+HIG" 增加了 "HIR+pp+"点 "HIG"。\n"NOR);	
	}
	old_ens+= ({f_name+"符"});
	weapon->set("combination_dbase/"+type+"/enchase",old_ens);
	//激活外功
	if( !undefinedp(Enchanse_W[f_name]) )
	{
		temp = Enchanse_W[f_name];
		if( !undefinedp(temp[type]) )
		{
			pfm_name = temp[type];
			weapon->set("combination_dbase/"+type+"/perform_name",pfm_name);
			weapon->set("combination_dbase/"+type+"/perform_dir","enchase/"+type+"/"+id); 
			tell_object(me,HIG"【系统】"+name+HIG"成功激活了绝招「"+pfm_name+HIG"」"NOR"\n");
		}
	}
	if( weapon->save() )
	{
		tell_object(me,HIG"【系统】"+name+HIG"保存成功。"NOR"\n");
		if( weapon->update_combination(type) )
			tell_object(me,HIY"【系统】"+name+HIY"数据更新完毕。"NOR"\n");
	}		
	return 1;	
}

int do_bd(string arg)
{
	mapping my_fu,temp;
	string id,*prop,name,f_name,sk_type,type;
	int i,max,lvl,value;
	object obj,target,me = this_player();
	
	if( me->query_level()<20 )
		return notify_fail("此功能20级开放。\n");
	if( !stringp(f_name=query("f_name")) )
		return notify_fail("此符文无效。\n");
	if( !present(this_object(),me) )
		return notify_fail("你身上没有符文。\n");
	if( !arg )
		return err_msg("你要镶嵌什么？\n");
	if( sscanf(arg,"%s in %s",id,arg)!=2 )
		return err_msg("命令格式：enchase <符文ID> in <装备ID>\n");
	if( !id(id) )
		return notify_fail("你身上没有符文"+arg+"。\n");
	
	lvl = this_object()->query("level");
	if( !me->check_pay(500000) )
		return notify_fail("镶嵌符文需要消耗五十两黄金。\n");
				
	target = present(arg,me);
	if( !target )
		return err_msg("你身上没有"+arg+"。\n");
	if( !target->is_armor() && !target->is_weapon() )
		return err_msg("你只能在武器或防具上镶嵌。\n");
	if( target->query("equipped") )
		return err_msg("你得先将它卸除。\n");
	if( (me->query("potential")-me->query("learned_points"))<500 )  
		return err_msg("你需要消耗500点潜能。\n");
	if( me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
		
	if( target->query("owner_id") )
	{
		if( target->query("owner_id")!=me->query("id") )
			return err_msg("这不是你的装备。\n");
	}
	lvl = target->query_fu_level(f_name);
	if( lvl>0 )
		return err_msg(target->name(1)+"上已经镶嵌了「"+f_name+"」了，不能重复镶嵌。\n");
//组合武器
	if( target->query("combination") )
	{
		if( !undefinedp(Enchanse_W[f_name]) )
		{
			temp = Enchanse_W[f_name];
			if( !stringp(sk_type=target->query("skill_type")) )
				return err_msg("组合武器"+target->name(1)+"当前类型缺失。\n");
			type = ("/cmds/std/look.lpc")->weapon_type(sk_type);
			type = "组合武器"+target->name(1)+"之"+type+"形态";				
		 	if( !undefinedp(temp[sk_type]) 
		 	&& target->query("combination_dbase/"+sk_type+"/perform_dir")
	 	 	&& target->query("combination_dbase/"+sk_type+"/perform_name") )
	 	 		return err_msg(type+"已经激活了外功「"+target->query("combination_dbase/"+sk_type+"/perform_name")+"」，不能再镶嵌"+f_name+"符了。\n");
		}
		max = target->query("combination_dbase/"+sk_type+"/max_enchase");
		if( max<1 )
			return err_msg(type+"上没有可供镶嵌的槽位。\n");
		if( mapp(my_fu=target->query("combination_dbase/"+sk_type+"/fu"))
	 	&& sizeof(my_fu)>0 )
		{
			if( sizeof(my_fu)>=max )
				return err_msg(type+"上只有"+max+"个槽位，已经满了。\n");
		}
		if( enchase_weapon2(me,target) )
		{
			write(HIY"【系统】组合武器"+type+HIY"镶嵌「"+f_name+"」成功。\n"NOR);
			write(HIY"【系统】如果你想取下镶嵌的符文，需要去找长安城的薛仁贵。\n"NOR);
			me->money_add(-500000);
			write(HIR"【系统】你失去了五十两黄金。\n"NOR);
			me->start_busy(1);
		}
		else	write(HIR"【系统】镶嵌失败。\n"NOR);

		if( query_amount()<=1 )
			destruct(this_object());
		else	add_amount(-1);	
		return 1;
	}
//组合武器end		
	if( !undefinedp(Enchanse_W[f_name]) )
	{
		temp = Enchanse_W[f_name];
		if( stringp(sk_type=target->query("skill_type"))
		 && !undefinedp(temp[sk_type]) 
		 && target->query("perform_dir")
	 	 && target->query("perform_name") )
	 	 	return err_msg(target->name(1)+"已经激活了外功「"+target->query("perform_name")+"」，不能再镶嵌"+f_name+"符了。\n");
	}
	
	
	max = target->query("max_enchase");
	if( max<1 )
		return err_msg(target->name(1)+"上没有可供镶嵌的槽位。\n");
	if( mapp(my_fu=target->query("fu"))
	 && sizeof(my_fu)>0 )
	{
		if( sizeof(my_fu)>=max )
			return err_msg(target->name(1)+"上只有"+max+"个槽位，已经满了。\n");
	}
	
	if( target->is_armor() )
	{
		if( enchase_armor(me,target) )
		{
			write(HIY"【系统】"+target->name(1)+HIY"镶嵌「"+f_name+"」成功。\n"NOR);
			write(HIY"【系统】如果你想取下镶嵌的符文，需要去找长安城的薛仁贵。\n"NOR);
			me->money_add(-500000);
			write(HIR"【系统】你失去了五十两黄金。\n"NOR);
			me->start_busy(1);
		}
		else	write(HIR"【系统】镶嵌失败。\n"NOR);
	}
	else
	{
		if( enchase_weapon(me,target) )
		{
			write(HIY"【系统】"+target->name(1)+HIY"镶嵌「"+f_name+"」成功。\n"NOR);
			write(HIY"【系统】如果你想取下镶嵌的符文，需要去找长安城的薛仁贵。\n"NOR);
			me->money_add(-500000);
			write(HIR"【系统】你失去了五十两黄金。\n"NOR);
			me->start_busy(1);
		}
		else	write(HIR"【系统】镶嵌失败。\n"NOR);
	}
	if( !stringp(target->query_save_file()) )
		write(HIR"【系统】"+target->name(1)+HIR"不是绑定的装备，除了储物袋和仓库，其他保存方式可能会导致镶嵌数据丢失！"NOR"\n");
	if( query_amount()<=1 )
		destruct(this_object());
	else	add_amount(-1);	
	return 1;
}