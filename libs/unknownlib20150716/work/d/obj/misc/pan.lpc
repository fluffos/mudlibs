#include <ansi.h>
inherit ITEM;

void create() {
  set_name("罗盘", ({ "luo pan", "pan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "和看风水的罗盘差不多，只不过上面镶嵌了一颗灵石，看起来灵气逼人。\n");
    set("unit", "只");
    set("value", 500000);
    set("no_store", 1);
  }
  setup();
}

string *dirs = ({
  "/d/moon/ontop2", "/d/moon/yltw", "/d/moon/fabao-room", "/d/moon/neartop",
  "/d/moon/yunu5", "/d/moon/yunu4", "/d/moon/yunu3", "/d/moon/yunu2",
  "/d/moon/kunlun", "/d/xueshan/xueshan1", "/d/xueshan/xueshan3",
  "/d/lingtai/uphill4", "/d/lingtai/guanjin", "/d/lingtai/lantao2",
  "/d/shushan/feipu", "/d/changan/nanyue", "/d/meishan/zhaoyun",
  "/d/dntg/hgs/entrance", "/d/dntg/hgs/houshan3",
});

string long() {
  object room, me = this_player();
  string env, long, file, str2, str = ::long();
  int i;

  if (!stringp(file = me->query_temp("mark/xilian_room"))) {
    file = dirs[random(sizeof(dirs))];
    if (!objectp(room = find_object(file))) {
      long = (file + ".lpc")->query("long");
      env = (file + ".lpc")->query("short");
    } else {
      long = room->query("long");
      env = COLOR_D->clean_color(MISC_D->find_place(room));
    }
    str2 = "罗盘上闪了几闪，现出了一行小字：\n";  //HIM+COLOR_D->clean_color(MISC_D->find_place((file)->query("short"))+"处灵气逼人。\n\n"NOR;
    i = strlen(long);
    i = i / 2 + random(i / 2);
    long = sprintf("%s", long[0..i]);
    long += "\n... ... ... ...";
    str2 += HIC + env + "某处灵气逼人，该处\n" HBBLU HIY + long + NOR "\n";
    me->set_temp("mark/xilian_room", file);
    me->set_temp("mark/xilian_msg", str2);
  }
  str2 = me->query_temp("mark/xilian_msg");
  str = str + str2;
  return str;
}
