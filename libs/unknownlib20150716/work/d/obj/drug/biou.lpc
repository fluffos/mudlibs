//碧藕
#include <ansi.h>
inherit __DIR__"age.lpc";

void create()
{
	set_name(HIW "碧藕" NOR, ({"bi ou","ou"}));
  	set_weight(1);
  	if (clonep())
                set_default_object(__FILE__);
        else 
        {
		set("base_unit", "枚");
		set("unit","些");
    		set("long", "一枚采自海中仙山，浑然如玉的碧藕。\n");
    		set("value", 0);
		set("drug_type", "补品");
		set("eat_msg",HIG"$N"HIG"吃下一枚"HIC"碧藕"HIG"，脸色变的如同良玉一般雪白。\n"NOR);
                set("eat_pot",50000);
	}
	set("is_monitored",1);	
  	setup();
  	set_amount(1);
}
