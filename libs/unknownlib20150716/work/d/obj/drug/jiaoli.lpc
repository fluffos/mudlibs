#include <ansi.h>
inherit __DIR__"age.lpc";

void create()
{
	set_name(YEL "交梨" NOR, ({"jiao li","li"}));
  	set_weight(1);
  	if (clonep())
                set_default_object(__FILE__);
        else 
        {
		set("base_unit", "枚");
		set("unit","些");
    		set("long", "一枚采自海中仙山，香气扑鼻的交梨。\n");
    		set("value", 0);
		set("drug_type", "补品");
		set("eat_msg",HIW"$N"HIW"吃下一枚"HIC"交梨"HIW"，嚼也没嚼连核吞了下去。\n"NOR);
                set("eat_pot",86400);
	}
	set("is_monitored",1);	
  	setup();
  	set_amount(1);
}
