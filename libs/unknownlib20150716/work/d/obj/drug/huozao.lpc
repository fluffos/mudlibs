#include <ansi.h>
inherit __DIR__"age.lpc";

void create()
{
	set_name(HIR "火枣" NOR, ({"huo zao","zao"}));
  	set_weight(1);
  	if (clonep())
                set_default_object(__FILE__);
        else 
        {
		set("base_unit", "枚");
		set("unit","些");
	    	set("long", "一枚采自海中仙山，色红如火的香枣。\n");
    		set("value", 0);
		set("drug_type", "补品");
		set("eat_msg",HIR"$N"HIR"吃下一枚"HIC"火枣"HIR"，脸色突然转红，过了许久才淡了下去。\n"NOR);
                set("eat_pot",70000);
	}
	set("is_monitored",1);	
  	setup();
  	set_amount(1);
}
