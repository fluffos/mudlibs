#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup(){}

int query_amount() { return amount; }

private void destruct_me() 
{ 
        remove_call_out("destruct_me");
        destruct(this_object()); 
}

void set_amount(int v)
{
    object dest;

        if( v<=0 )
        {
           amount=0; 
           call_out("destruct_me", 1);
           return;
        }
        else 
        {
                amount = v;
                this_object()->set_weight(v);
        }
}

void add_amount(int v) { set_amount(amount+v); }

string short()
{
        string id;
        if( !stringp(id=query("owner_id")) )
                id = "";
        else    id = "["+id+"]";        
        return chinese_number(query_amount()) + query("base_unit")+ ::short()+id;
}

varargs int move(mixed dest, int silent)
{
        object env, *inv;
        int i, total, total0, result;
        string file;

        result= ::move(dest, silent);
        if(env = environment()) 
        {
                file = base_name(this_object());
                inv = all_inventory(env);
                total = (int)query_amount();
                total0=total;
                for(i=0; i<sizeof(inv); i++) 
                {
                        if( inv[i]==this_object() ) 
                                continue;
                        if( base_name(inv[i])==file ) 
                        {
                                if( inv[i]->query("owner_id")
                                 && query("owner_id")!=inv[i]->query("owner_id") )
                                        continue;
                                set("owner_id",inv[i]->query("owner_id"));      
                                total += (int)inv[i]->query_amount();
                                destruct(inv[i]);
                        }
                }
                if(total!=total0)
                        set_amount(total);
        }
        return result;
}

void init()
{
        if( userp(environment()) )
        {
                if( !query("owner_id") )
                        set("owner_id",environment()->query("id"));
        }
        add_action("do_eat", "eat");
}

void create()
{
        set_name("驻颜丹", ({"zhuyan dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else 
        {
                set("base_unit","粒");
                set("unit","些");
                set("long", "这是一粒充满灵气的丹药，上面灵光浮动充满了生机。据说吃了能使人变得年轻。\n");
                set("no_sell","这么珍贵的灵丹你也舍得卖？！\n");
                set("drug_type", "良药");
        }
        set("is_monitored",1);
        setup();
        set_amount(1);
}

int do_eat(string arg)
{
	string str;
        int k,howold;
        object me = this_player();
        if( !arg || !id(arg))
                return 0;
        if( !present(this_object(),me) )
                return 0;
	if( !query("owner_id") || query("owner_id")!=me->query("id") )
		return notify_fail("这不是你的。\n");
        if( environment(me)->query("no_time") )  return err_msg("在这里吃看不出效果。\n");
	howold = (int)me->query("mud_age") + (int)me->query("age_modify");
        if( howold<1382400 )
                return notify_fail("你现在吃了这个也是浪费。\n");
	if( !stringp(str=this_object()->query("eat_msg")) 
	 || strlen(str)<2 )
	 	str = "$N吃下一"+(this_object()->query("base_unit")?this_object()->query("base_unit"):"粒")+"$n。\n";
        message_vision(str,me,this_object());
        if( !intp(k=this_object()->query("eat_pot")) 
         || k<1 )
	{
        	k = 172800;
        	k = k/2+random(k/2);
        }	
        me->add("age_modify",-k);
        write(HIC"你只觉一股勃勃生机直接注入体内，感觉皱纹都少了不少。\n"NOR);
        me->update_age();
        if( me->query("age")<=me->query("last_birthday_ask") )
        	me->set("last_birthday_ask",me->query("age"));
        if( query_amount()<=1 )
                destruct(this_object());
        else    add_amount(-1); 
        return 1;       
}

