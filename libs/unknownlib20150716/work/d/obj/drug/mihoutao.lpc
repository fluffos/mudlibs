// mihoutao.c 猕猴桃
#include <ansi.h>
inherit COMBINED_ITEM;

void setup(){return;}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(YEL "猕猴桃" NOR, ({"mihou tao","mihoutao","tao"}));
  	if(clonep())
    		set_default_object(__FILE__);
  	else 
  	{
    		set("base_unit", "颗");
    		set("unit", "些");
    		set("long", "黄橙橙的猕猴桃，真叫人垂涎欲滴，吃了可以补充法力。\n");
    		set("value", 5000);
    		set("num",5000);
    		set("no_sell",1);
    		set("drug_type", "补品");
  	}
  	setup();
  	set_amount(1);
}

int do_eat(string arg)
{
	int max,n,v;
	object me = this_player();
  	if( !arg || !id(arg) )
    		return notify_fail("你要吃什么？\n");
  	if( !intp(v=query("num"))
  	 || v<1 )
  	 	return notify_fail("好似没什么用。\n");
	max = me->query_maxmana();
	n = max*2-me->query("mana");
	if( n<1 )
		return notify_fail("你现在法力充沛，没有这个必要。\n");
  	if( n>v )
  		n = v;
  	message_vision(HIG"$N"HIG"吃下一颗弥猴桃，忍不住抓耳挠腮，高兴得直想翻跟头！ \n" NOR, me);
  	me->add("mana",n);
  	add("num",-n);
  	if( query("num")<1 )
  	{
  		set("num",5000);
  		if( query_amount()<=1 )
  			destruct(this_object());
  		else	add_amount(-1);
  	}	
  	return 1;
}