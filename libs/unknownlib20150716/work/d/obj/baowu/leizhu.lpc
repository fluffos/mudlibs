#include <ansi.h>
inherit __DIR__"lingzhu.lpc";

void init_lingzhu()
{
        set_name(HIB "雷灵珠" NOR, ({"lei lingzhu", "leizhu"}) );
	set("long","传说中的五行宝珠之一，佩之可避雷击，并可发出雷击法术。\n");
	set("cast_dir","leilingzhu");
	set("wear_msg","$N戴上一颗$n，不禁精神一振。\n");
	set("unequip_msg","$N将$n轻轻地摘下来。\n");
	set("wx_type","木");
}
