#include <ansi.h>
inherit __DIR__"lingzhu.lpc";

void init_lingzhu()
{
        set_name(HIY "土灵珠" NOR, ({"tu lingzhu", "tuzhu"}) );
	set("long","传说中的五行宝珠之一，佩之可避石砸，并可发出土系法术。\n");
	set("cast_dir","tulingzhu");
	set("wear_msg","$N戴上一颗$n，黄色的宝珠在胸前一颤一颤的。\n");
	set("unequip_msg","$N将$n轻轻地摘下来。\n");
	set("wx_type","土");
}