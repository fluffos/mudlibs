#include <ansi.h>
inherit __DIR__ "lingzhu.lpc";

void init_lingzhu() {
  set_name(HIW "水灵珠" NOR, ({ "shui lingzhu", "shuizhu" }));
  set("long", "传说中的五行宝珠之一，佩之可避水淹，并可发出水系法术。\n");
  set("cast_dir", "shuilingzhu");
  set("wear_msg", "$N戴上一颗$n，$n发出耀眼的白光，好久才暗下来。。\n");
  set("unequip_msg", "$N将$n轻轻地摘下来。\n");
  set("wx_type", "水");
}
