#include <ansi.h>
inherit __DIR__"lingzhu.lpc";

void init_lingzhu()
{
        set_name(HIR "火灵珠" NOR, ({"huo lingzhu", "huozhu"}) );
	set("long","传说中的五行宝珠之一，佩之可避火烧，并可发出火系法术。\n");
	set("cast_dir","huolingzhu");
	set("wear_msg","$N戴上一颗$n，顿时浑身笼罩在一层红光之下。\n");
	set("unequip_msg","$N将$n轻轻地摘下来。\n");
	set("wx_type","火");
}