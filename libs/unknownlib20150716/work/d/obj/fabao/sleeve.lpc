// magic sleeve for holding stuffs.
// by mon. 1/11/98 
#include <ansi.h>
inherit ITEM;

int is_sleeve() {return 1;}

nosave object owner = 0;

void set_owner(object who)
{
	if( !who 
	|| (owner&&owner!=who) )
		return;
	owner = who;
	set_name(who->name()+"的衣袖",({who->query("id")+"'s sleeve","sleeve",}));	
}

object query_owner(){return owner;}

void create()
{
     set_name("衣袖中",({"in sleeve","sleeve"}));     
     set_max_encumbrance(300000);
     set_weight(100);
     set("short","衣袖中");
     set("long", @LONG
这里漆黑一片．．．
LONG
     );
     set("no_get",1);
     set("no_fight", 1);
     set("no_magic", 1);
     setup();
}

void init()
{
	add_action("do_quit", "quit");
}

int do_quit() {return 1;}

int clean_up()
{    
	if( owner && objectp(owner) )
		return 1;
	destruct(this_object());
	return 0;	
}