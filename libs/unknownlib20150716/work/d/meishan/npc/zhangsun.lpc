#include <ansi.h>
inherit NPC;

void create() {
  set_name("张顺", ({ "zhang shun", "zhang" }));
  set("long", "一位强壮的渔夫，愁眉苦脸，象是遇到了什么难事。\n");
  set("gender", "男性");
  set("age", 36);
  set("title", "渔夫");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set_skill("unarmed", 35);
  set_skill("dodge", 30);
  set_skill("parry", 35);

  setup();
  add_money("coin", 3 + random(5));
  carry_object("/obj/cloth")->wear();
}

int accept_money(object who, int val) {
  object m;

  if (val <= 0)
    return notify_fail("张顺难过的说：我只要钱！\n");
  else if (val >= 5000) {
    if (time() < query_temp("last_accept") + 10)
      return err_msg("张顺说到：多谢，多谢！\n");
    set_temp("last_accept", time());
    EMOTE_D->do_emote(this_object(), "jump", 0, CYN, 0, 0, 0);
    tell_object(who, CYN + name() + CYN "说道：" + RANK_D->query_respect(who) + "，这就把阿花牵走吧！\n" NOR);
    if (objectp(m = present("old pig", environment()))
      && base_name(m) == "/d/meishan/npc/pigg")
      EMOTE_D->do_emote(this_object(), "point", "old pig", CYN, 0, 0, 0);
    else {
      say("张顺跑到后院牵出头老母猪来。\n");
      m = new("/d/meishan/npc/pigg");
      m->move(environment(who));
    }
    return 1;
  }
  say("张顺说到：多谢，多谢！\n");
  return 1;

}

void init() {}

void kill_ob(object who) {
  if (!who)
    return;
  remove_killer(who);
  who->remove_killer(this_object());
  EMOTE_D->do_emote(this_object(), "poor", 0, CYN, 0, 0, 0);
  message_vision(HIC "$N" HIC "心一软，一时下不去手。\n" NOR, who);
  return;
}
