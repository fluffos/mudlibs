
inherit NPC;

void create()
{
        set_name("老母猪", ({ "old pig", "pig" }) );
        set("gender", "雌性");
        set_level(1);
        set("race","野兽");
        set("age", 10);
        set("long", "一只肥胖的老母猪，屁股上不知被谁用黑炭歪歪扭扭的写了“阿花”两字。\n");
        set("attitude", "friendly");
	set("looking", "肥肥胖胖，看起来足有二百来斤。");
        set("str", 20);
        set("con", 40);
	set("kee", 300);
	set("sen", 300);
        set("limbs", ({ "头部", "身体" ,"屁股","翅膀","脖子","左脚","右脚",}) );
        set("verbs", ({ "bite"}) );
        set_skill("dodge", 20);
        set_temp("apply/armor", 30);
        setup();
}

int heal_up()
{

        if( environment() && !is_fighting() ) {
                call_out("leave", 1);
                return 1;
        }
        return ::heal_up() + 1;
}

void leave()
{
	this_object()->add("time", 1);
	if ( (int)this_object()->query("time") > 3 ) {
        message("vision",
               name() + "哼哼叽叽地叫了几声，扭着屁股跑了。\n", environment(),
                this_object() );
        destruct(this_object());
	}
	return;
}

void hunmi(object who)
{
	remove_call_out("hunmi");
	if( !who || !who->is_fighting(this_object()) )
		return;
	remove_all_killer();
	all_inventory(environment())->remove_killer(this_object());
	this_object()->unconcious();	
}

void kill_ob(object who)
{
	if( userp(who) )
		call_out("hunmi",3,who);
	::kill_ob(who);
}	
		