//sgzl
#include <room.h>
#include <ansi.h>
inherit ROOM;

int getflag;

void create()
{
	set("short", "石房");
	set("long", @LONG
一座宽大的石房，房内有石窝、石灶、石碗、石盆、石床、
石凳，各种家当。好一座天造地设的安身之所。正中间插着
一杆大旗(flag)。
LONG );
	set("item_desc",([
		"flag":"一面迎风招展的三色大旗，在空旷之处迎风挥舞(wave)起来一定煞是好看，但似乎很难拔(ba)动。\n",
	]));
	set("exits", ([
		"west"   : __DIR__"tiebanqiao",
		"east"  : __DIR__"dongnei",
	]));
	create_door("west", "石门", "east", DOOR_CLOSED);
	setup();
}

void init()
{
   	object ob = this_player();
   	object houzi;
   	object where = this_object();

   	getflag=0;

      	if( this_player()->query("dntg/huaguo")=="allow" )
	{
        	message_vision(HIC"\n一群猴子跟着$N"HIC"蹦蹦跳跳的跑了过来。\n\n"NOR,this_player());
         	if( !objectp(houzi=present ("hou zi 3",where))
         	 || userp(houzi) )
		{
			houzi = new (__DIR__"npc/hou1");
            		houzi->move(where);
		}
	}
	add_action("do_ba", "ba");
}

int do_ba(string arg)
{
        object me;
        object qi;

        me = this_player();
        if( !arg || ( arg != "flag" ) ) 
		return notify_fail("你要拔什么？\n");
        if(me->query("dntg/huaguo")=="done")  
		return notify_fail("你手握大旗，不禁想起自己当年在此称王的快乐时光。\n");
	if( me->query("dntg/huaguo")!="start" )
        	return notify_fail("你拔不动。\n");
	if( objectp(qi=present("flag",me))
	 && qi->is_flag() )
	 	return notify_fail("你不是已经有旗子了吗？\n");
        if(getflag==1)  
        	return notify_fail("大旗已经被别人拔走了，这里只留下一截旗杆。\n");
		
	write(HIR"你开始拔旗。\n"NOR);	
	if(me->query("kee")>200)  
		me->receive_damage("kee",200);
	else
	{
		me->unconcious();
		return 1;
	}
	if( random(10) < 5 )
	{
        	message_vision(HIY"\n$N"HIY"使尽吃奶的力气也没将大旗拔出来。\n"NOR, me);
        	return 1;
	}

	qi = new (__DIR__"obj/flag");
        if( qi->move(me) )
        {
		message_vision(HIC"\n$N"HIC"大喝一声，将大旗拔了下来。\n\n"NOR, me);
		getflag=1;
	}
	else
	{
		destruct(qi);
		write(HIR"结果你包里放不下了。\n"NOR);
	}
	return 1;
}

int valid_leave(object me, string dir)
{
 	object ma;
	if( dir == "east" ) 
	{
		if( !userp(me) )
			return 0;
		if( me->query("dntg/huaguo")!="allow" )
			return notify_fail("几只小猴子跑过来冲你喊到：＂我们正在选猴王，没事别来捣乱。＂\n小猴子又急匆匆的走了。\n");
		if( !wizardp(me) || !me->query("env/test") )
		{			
			if( me->query_level()!=69 || me->query("combat_exp")<870000000
	        	 || me->query("daoxing")<480000 )
				return notify_fail("你感觉自己的修为难以继力，有些踌躇不前。\n");        	 
		}		
        }
	return ::valid_leave(me,dir);
}

