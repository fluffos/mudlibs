#include <ansi.h>
inherit ROOM;
//inherit "/d/dntg/lijing/starting_place.lpc";

mapping Rack = ([
	"sword":"袁公剑",
	"blade":"通臂刀",
	"mace" :"金丝锏",
	"spear":"赤尻枪",
	"hammer":"攀山锤",
	"axe"  :"通背斧",
	"fork":"摘果叉",
	"stick":"通明棍",
	"dagger":"尖嘴刃",
	"whip":"猴尾鞭",
	"staff":"斗战杖",
]);

mixed check_rack()
{
	object me = this_player();
	string str,*wps,str2,arg;
	int i,k;
	wps = ({
		"sword","blade","mace","spear","hammer","axe","fork","stick","dagger","whip","staff",
	});
	
	if( me->query("dntg/huaguo")!="done" 
	 || me->query("dntg/donghai")=="done" )
		return "兵器架上面十八般兵刃样样齐全。\n";
	if( me->query("dntg/donghai")=="aolai" )
		return "兵器架上摆了些木刀木棍。。。。\n";
	str = "兵器架上插着：\n\t";
	k = 0;
	for(i=0;i<sizeof(wps);i++)
	{
/*
                if( time()<query("rack/"+wps[i])+300 )
			continue;
*/
		if( undefinedp(Rack[wps[i]]) )
			continue;
		k++;	
		arg = Rack[wps[i]]+"("+wps[i]+")";
		str+= sprintf("%12-s",arg);
		if( i==sizeof(wps)-1 )
			str+= "。\n";
		else if( k%4==0 )
			str+= "、\n\t";
		else	str+= "、";
	}
	if( str=="兵器架上插着：\n\t" )
		str = "兵器架上空空荡荡。";
	else
	{
		if( me->query("dntg/donghai")=="wubingqi" )
			str+= "\n上面十八般兵刃样样齐全。让人看了忍不住想拿(get)起来舞一上舞(wave)。";
	}	
	str+= "\n";	
	return str;
}

void to_all()
{
	object *user;
	int i;
	remove_call_out("to_all");
	user = users();
	for(i=0;i<sizeof(user);i++)
	{
		if( !user[i] || !living(user[i])
		 || !environment(user[i])
                 || wizardp(user[i])
		 || user[i]->is_ghost() 
		 || user[i]->query("dntg/huaguo")!="done" 
		 || user[i]->query("dntg/donghai")=="done" )
		 	continue;
		tell_object(user[i],"\n"HIC"【谈天说地】「BEEP！」，崩将军好像要找"+user[i]->query("name")+"．．．\n"NOR);
		tell_object(user[i],HBBLU"崩将军(beng jiangjun)告诉你：我等在花果山恐作耍成真，或惊动人王，或有禽王、兽王认此犯头，说我们操兵造反，兴师来相杀，我等皆是竹竿木刀，如何对敌？须得锋利剑戟方可。如今奈何？\n"NOR);
		tell_object(user[i],"\n"HIY"还是去找崩将军详谈「兵器」一事。\n"NOR);
	}
	call_out("to_all",3000+random(600));
}
//，上面十八般兵刃样样齐全。让人看了忍不住想拿起来舞一上舞(wave)
void create()
{
	set("short", "花果山教军场");
	set("long", @LONG
一片开阔的草地，被猴子们当作他们的教军场，只见其中一个严肃的通背猿指挥着一列
列，一排派走过来的猴子兵。
    草地边摆着一个兵器架(rack)。
LONG );
	set("exits", ([
		"east"   : __DIR__"shanya",
	]));
	set("objects", ([
		__DIR__"npc/beng" : 1,
	]));
	set("item_desc", ([
  		"rack": (: check_rack :),
  	]));
	set("outdoors","hgs");
	setup();
	remove_call_out("to_all");
	call_out("to_all",15+random(30));
}

void init()
{
	add_action("do_wu","wave");
	add_action("do_get","get");	
}

int do_get(string arg)
{
	int lvl;
	string *ars,color,name;
	object ob,me = this_player();
	if( !arg || sscanf(arg,"%s from rack",arg)!=1 )
		return 0;
	if( undefinedp(Rack[arg]) )
		return err_msg("一次只能拿一样，你要拿什么？(look rack)\n");
	if( me->query("dntg/huaguo")!="done"
	 || me->query("dntg/donghai")=="done" )
		return err_msg("一旁的崩将军朝你喝道：大胆！\n");
	if( me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
/*
        if( time()<query("rack/"+arg)+300 )
		return err_msg("武器架上的"+Rack[arg]+"已经给人拿了。\n");		
*/
	lvl = 70+random(10);
					
	ob = new("/d/obj/nweapon/"+arg);
	if( !ob )
		return err_msg("奇怪，空的？！\n");
	color = ({"","HIY","HIY","HIC","HIC","HIB",})[random(6)];	
	name = Rack[arg];
	ob->init_weapon( ({lvl,color,name}) );

	if( ob->move(me) )
	{
		ob->set("dntg",1);
		ob->set("no_fenjie",1);
		me->start_busy(1);
		message_vision("$N从兵器架上拿起一"+ob->query("unit")+ob->name(1)+"。\n",me);
		set("rack/"+arg,time());
		return 1;
	}
	else
	{
		if( ob )
		{
			ob->move("/obj/empty");
			REMOVE_D->add_obj(ob,1);
		}
		return err_msg("你背包满了。\n");
	}			
}

void check_wu(object me,object weapon)
{
	if( !me || !living(me) || !present(me,this_object()) )
		return;
	if( !weapon || weapon!=me->query_temp("weapon") 
	 || me->query("dntg/huaguo")!="done"
	 || me->query("dntg/donghai")=="done" 
	 || me->query("dntg/donghai")!="wubingqi" )
	{
		tell_object(me,HIR"你放下手中的武器，擦了擦额头的汗。\n"NOR);
		me->delete_temp("pending/dntg2_wu");
		return;
	}
	if( random(3)==0 )
	{
		message_vision("\n"HIR"正舞得兴起，只见$N"HIR"双手一使劲，结果"+weapon->query("name")+HIR"嘎巴一声，断成了两截！\n\n"NOR,me);
		message_vision(CYN"$N"CYN"说道：真是扫兴！\n"NOR,me);
		weapon->unequip();
		weapon->move("/obj/empty");
		REMOVE_D->add_object(weapon,1);
		me->add_temp("dntg2/weapon_broken",1);
		me->delete_temp("pending/dntg2_wu");		
		if( random(me->query_temp("dntg2/weapon_broken"))>5 )
		{
			message_vision(HIC"\n一旁闪出一只通背猿，却原来是崩将军。\n\n"NOR,me);
			message_vision(CYN"崩将军说道：大王乃是仙圣，凡兵是不堪用。我们这铁板桥下(down)，水通东海龙宫。大王若肯下去(jump)，寻着老龙王，问他要件什么兵器，却不趁心？\n"NOR,me);
			me->set("dntg/donghai","sea");
		}
		else	
		{
			message_vision(HIC"\n一旁闪出一只通背猿，却原来是崩将军。\n\n"NOR,me);
			message_vision(CYN"崩将军说道：大圣爷爷，再在兵器架(rack)上取件称手的兵器试试。\n"NOR,me);
		}
	}
	else
	{
		if( random(2) )
			message_vision(HIY"$N"HIY"越舞越快，映得满堂雪光缭绕，惹得堂下一片喝彩。\n"NOR,me);
		else if( random(2) )
			message_vision(HIW"$N"HIW"越舞越快，间歇中不忘摆摆ＰＯＳＥ，惹得堂下一片喝彩。\n"NOR,me);	
		else	message_vision(HIC"$N"HIC"越舞越快，犹如滚地飞花，惹得堂下一片喝彩。\n"NOR,me);
		call_out("check_wu",3+random(5),me,weapon);
	}
}
		
int do_wu(string arg)
{
	object weapon,me=this_player();
	
	if( !arg )
		return err_msg("你要舞什么？旁边的兵器架(rack)上倒是有些兵器，你看看有没有称手的。\n");
	if( me->query("dntg/donghai")=="aolai" )
	{
		tell_object(me,CYN"崩将军说道：我们这山，向东去有二百里水面，那厢乃傲来国界。那国界中有一王位，满城中军民无数，必有金银铜铁等匠作。大王若去那里，或买或造些兵器，教演我等，守护山场，诚所谓保泰长久之机也。\n"NOR);
		return 1;
	}
	if( me->query("dntg/donghai")=="sea" )
	{
		tell_object(me,CYN"崩将军说道：大王乃是仙圣，凡兵是不堪用。我们这铁板桥下(down)，水通东海龙宫。大王若肯下去(jump)，寻着老龙王，问他要件什么兵器，却不趁心？\n"NOR);
		return 1;
	}
	if( me->query("dntg/donghai")=="done" )
	{
		tell_object(me,CYN"崩将军笑盈盈地说道：”"+sprintf("%s",me->query("name")[0..1])+"大圣神通广大。“，想了想又加上一句：“寿与天齐”。\n"NOR);
		return 1;
	}
	if( !objectp(weapon=present(arg,me)) 
	 || weapon!=me->query_temp("weapon") )
	 	return err_msg("旁边的兵器架(rack)上倒是有些兵器，你看看有没有称手的。\n");
	if( !weapon->query("dntg") 
	 || me->query("dntg/huaguo")!="done" )
		return err_msg("你将手中的"+weapon->query("name")+"舞动如风，累出了一身的汗。\n");
	if( me->query("dntg/donghai")=="done" )
		return err_msg("你将手中的"+weapon->query("name")+"舞动如风，说了一声：果然还是没龙宫的宝贝顺手。\n");
	if( me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
	if( me->query_temp("pending/dntg2_wu") )
		return err_msg("你舞动武器，好不兴奋。\n");	
		
	message_vision(HIC"$N"HIC"一时兴起，将手中"+weapon->query("name")+HIC"舞动起来，博得在场的猴子们阵阵喝彩。\n"NOR,me);		
	me->start_busy(1);
	me->set_temp("pending/dntg2_wu",1);
	call_out("check_wu",3+random(5),me,weapon);
	return 1;
}
