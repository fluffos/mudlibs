#include <ansi.h>
inherit ROOM;

void create ()
{
	set("short", "瀑布前");
  	set("long", @LONG
只见那股涧水奔流，真个似滚瓜涌溅。顺涧爬山，直至源流之处，
乃是一股瀑布飞泉。但见那：
LONG);
  	set("long2", @LONG
  	
　　一派白虹起，千寻雪浪飞；海风吹不断，江月照还依。
　　冷气分青嶂，馀流润翠微；潺□名瀑布，真似挂帘帷。

LONG);
	set("exits", ([
        	"west"   : __DIR__"shanya",
      	]));
  	set("outdoors", 1);
	setup();
}

void appearing (object who)
{
	object me =this_player();
  	object where = this_object();
  	object houzi;

	remove_call_out("appearing");
  	if( !who || environment(who) != where
  	 || !living(who) )
		return;
	if( !objectp(houzi=present ("hou zi 4", where))
	 || userp(houzi) )
	{
    		houzi = new (__DIR__"npc/hou");
    		houzi->move(where);
    		message_vision (HIC"\n树丛中蹿出一只$N"HIC"。\n\n"NOR,houzi);
  	}
}

void init ()
{
	object who = this_player();
      
  	add_action("do_jump", "jump");
  	add_action("do_wave", "wave");

  	if(who && interactive(who))
    		call_out ("appearing", 1, who);
}

int do_jump(string arg)
{
        object me;

        me = this_player();
        if( !arg || ( arg != "pubu" ) ) 
        	return  notify_fail("你往哪儿跳？\n");

	if( me->query("dntg/huaguo")=="allow" )
	{
		message_vision(HIC"\n$N"HIC"大喝一声：“我去瞧瞧！＂说罢飞身跃入瀑布。\n\n"NOR, me);
		me->move(__DIR__"pubu1",2);
		message_vision(HIC"\n$N"HIC"来到了瀑布之内。\n"NOR,me);
		return 1;
	}	

        if( random(10)+me->query_kar() < 65 
         || me->query("gin")<30 
         || time()<me->query("maze/hgs-pubu")+1800 )
	{ 
        	message_vision(HIR"\n$N"HIR"向下一纵，不小心撞在了一块石头上。\n\n"NOR, me);
        	if( me->query("eff_kee")<600 )
          		me->unconcious();
          	else
          	{
          		me->receive_wound("kee",600);
          		COMBAT_D->report_status(me,1);
          	}		
	}
	else
        {
        	message_vision(HIC"\n$N"HIC"大喝一声：“我去瞧瞧！＂说罢飞身跃入瀑布。\n\n"NOR, me);
		me->delete_temp("maze");
                me->dismiss_team();
                if( MAZE_D->enter_maze(me, "dntg-hgs-pubu") )
                {
                        me->set("maze/hgs-pubu",time());
                        me->delete("maze/dntg-hgs-pubu");
                        me->set_temp("mark/dntg-hgs-pubu",base_name(this_object()));
                        message_vision(HIC"\n$N"HIC"来到了瀑布之内。\n"NOR,me);
                        return 1;
                }
                else
                {
                	message_vision(HIR"\n$N"HIR"向下一纵，不小心撞在了一块石头上。\n\n"NOR, me);
          		if( me->query("eff_kee")<300 )
          			me->unconcious();
          		else
          		{
          			me->receive_wound("kee",300);
          			COMBAT_D->report_status(me,1);
          		}
                }
	}
        return 1;
}

void jumping()
{
	object houzi,where = this_object();
  	
  	remove_call_out("jumping");
  	if( objectp(houzi=present ("hou zi",where)) && !userp(houzi) )
  		destruct(houzi);
  	if( objectp(houzi=present ("hou zi",where)) && !userp(houzi) )
  		destruct(houzi);
  	if( objectp(houzi=present ("hou zi",where)) && !userp(houzi) )
  		destruct(houzi);
  	if( objectp(houzi=present ("hou zi",where)) && !userp(houzi) )
  		destruct(houzi);
  	tell_room(where,HIY"\n猴子们听罢争先恐后的跳下瀑布。\n\n"NOR);
}

int do_wave(string arg)
{
        object me,obj;
        object where = this_object();

        me = this_player();
        if ( !arg || ( arg != "flag" ) ) 
        	return  notify_fail("你想挥舞什么？\n");
	if( !objectp(obj=present(arg, me)) 
	 || !obj->is_flag() )
		return notify_fail("你身上没有这东西。\n");
    	message_vision(HIC"\n$N"HIC"挥舞着起旗子，大喝一声：“大造化！大造化！下面没水！原来是一座铁板桥。桥那边是一座天造地设的家当。兄弟们快去呀！”\n\n"NOR, me);
	call_out("jumping",2);
        if( me->query("dntg/huaguo")!="done" )  
        	me->set("dntg/huaguo", "allow");
	destruct(obj);
        return 1;
}

