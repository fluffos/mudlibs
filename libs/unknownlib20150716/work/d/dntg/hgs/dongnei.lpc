//sgzl

#include <room.h>
inherit ROOM;

int is_dntg() { return 1; }

void create() {
  set("short", "水帘洞内");
  set("no_chuqiao", 1);
  set("no_huicheng", 1);
  set("no_fly", 1);
  set("no_qiankun", 1);
  set("no_time", 1);
  set("long", @LONG
这里便是花果山水帘洞的内堂，四周锅碗瓢盆样样
俱全。正中一张虎皮椅子，正是供水帘洞主休息的。
LONG);
  set("exits", ([
    "west": __DIR__ "shifang",
  ]));
  setup();
}

void init() {
  object room, wang, me = this_player();
  if (userp(me) && me->query("dntg/huaguo") == "allow") {
    if (clonep(this_object())) {
      wang = new("/d/dntg/hgs/npc/mowang");
      if (wang->init_family(me)) {
        wang->move(this_object());
        wang->kill_ob(me);
        me->kill_ob(wang);
      } else destruct(wang);
    } else {
      room = clone_object(__FILE__);
      me->move(room);
      REMOVE_D->add_room(room, 1800);
    }
  }
}

int valid_leave(object me, string dir) {
  if (dir == "west" && userp(me)) {
    if (present("hunshi mowang", environment(me))
      || me->is_fighting())
      return notify_fail("混世魔王冲着你冷笑到：“想走？没那么容易吧！”\n");
    else {
      if (clonep(this_object()))
        REMOVE_D->add_room(this_object(), 5);
      return ::valid_leave(me, dir);
    }
  }
  return ::valid_leave(me, dir);
}
