//sgzl
#include <room.h>
#include <ansi.h>
inherit ROOM;
//inherit "/d/dntg/hell/hell_sleep.lpc";

void create() {
  string str;
  set("short", "铁板桥");
  set("long", @LONG
你欠身上桥头，再走再看，却似有人家住处一般，真个好所在。但见那：
LONG);
  set("long2", @LONG
　　翠藓堆蓝，白云浮玉，光摇片片烟霞。虚窗静室，滑凳板生花。乳窟
　　龙珠倚挂，萦回满地奇葩。又见那一竿两竿修竹，三点五点梅花。几
    树青松常带雨，浑然相个人家。
看罢多时，跳过桥中间，左右观看，只见正当中有一石碣(shi jie)。
LONG);
  str = @LONG

	　▃▃▃　　　　▃▃▃
	　▃水▃　　　　▃花▃　　　　
	　▃帘▃　　　　▃果▃　　　　　
	　▃洞▃　　　　▃山▃　　　　
	　▃洞▃　　　　▃福▃　　　　
	　▃天▃　　　　▃地▃　　　　
	　▃▃▃　　　　▃▃▃

LONG;
  str = replace_string(str, "▃", NOR REV HIY "▃" NOR HIY);
  set("item_desc", ([
    "shi jie": str,
  ]));
  set("exits", ([
    "east": __DIR__ "shifang",
  ]));
  create_door("east", "石门", "west", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object ridee, zhou, me;

  me = this_player();
  if (!arg)
    return notify_fail("你往哪儿跳？\n");
  switch (arg) {
    case "bridge":
      if (random(10) + me->query_kar() < 65) {
        message_vision(HIR "\n$N" HIR "奋力向上一跃，又从半空中摔了下来。\n\n" NOR, me);
        me->unconcious();
      } else {
        me->move(__DIR__ "pubu");
        message_vision(HIC "\n$N" HIC "从桥上飞身纵出瀑布。\n" NOR, me);
      }
      return 1;
    case "down":
      if ((!objectp(zhou = present("bishui zhou", me))
        || (string)zhou->query("unit") != "张")
        && (string)me->query("family/family_name") != "龙宫"
        && (string)me->query("family/family_name") != "东海龙宫")
        return notify_fail("你一个猛子扎到水里．．．\n" + "\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
      if (me->is_busy())
        return notify_fail("你一个猛子扎到水里．．．\n" + "\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
      if (time() < me->query("maze/dntg-sea-sea1") + 1800)
        return notify_fail("你想起刚才在东海被打得人仰马翻，不由有些踌躇。\n");
      if (me->query("dntg/huaguo") != "done"
        || (me->query("dntg/donghai") != "sea"
          && me->query("dntg/donghai") != "weapon1"
          && me->query("dntg/donghai") != "weapon2"
          && me->query("dntg/donghai") != "weapon3"
          && me->query("dntg/donghai") != "haizang"
          && me->query("dntg/donghai") != "jgb"))
        return notify_fail("桥下波涛涌急，你看了看，不由有些踌躇。\n");

      if (me->query("gin") < 50)
        return notify_fail("你的活力不足50点。\n");
      me->delete_temp("maze");
      me->dismiss_team();
      if (MAZE_D->enter_maze(me, "dntg-sea-sea1")) {
        me->add("gin", -25);
        ridee = me->ride();
        if (ridee && ridee->query("under_water")) {
          message(
            "vision",
            HIY "\n" + me->name() + HIY "一拍" + ridee->name() + HIY "的头，连人带坐骑跃入水中。\n\n" NOR,
            this_object(),
            ({ me })
          );
          ridee->move(environment(me));
          message_vision(HIY "$N" HIY "骑着$n" HIY "潜入了水中。\n" NOR, me, ridee);
        } else {
          message(
            "vision",
            HIY "\n" + me->name() + HIY "一个猛子扎到水中，然后不见了。\n\n" NOR,
            this_object(),
            ({ me })
          );
          message_vision(HIY "$N" HIY "潜了过来。\n" NOR, me);
        }
        return 1;
      } else return notify_fail("你看着翻滚的波涛，不由有些踌躇。\n");
    default: notify_fail("你往哪儿跳？\n");
  }
}
