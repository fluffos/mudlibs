	if( query("family/family_name")!="月宫" )
		set("force_factor",query_skill("force")/10*3);
	else	set("force_factor",0);		
	set("daoxing",this_object()->query_max_daoxing());
	return 1;
}

int accept_fight (object ob)
{
        kill_ob (ob);
        return 1;
}

void hurting (object ob)
{
	object obj,me=this_object();
        string *msgs = ({
                HIR"$N"HIC"手中的"+Wname+"一阵狂舞，劈头盖脸的朝着$n"HIR"招呼！\n"NOR,
                RED"$N"RED"手腕陡然猛颤，无数妖气从"+Wname+"中飞了出来！\n"NOR,
        });
        string *strs = ({
                HBRED"$N"HBRED"躲避不及，身上顿时被砍出十七八道血痕！"NOR"\n",
                HBRED"$N"HBRED"身中数招，痛苦不堪，神情逐渐委顿了下来……！"NOR"\n"NOR,
  	});
        int damage,busy;

        remove_call_out("hurting");
        
        if( !living(this_object()) )     
                return;
        if( !ob || !present(ob,environment()) || !me->is_fighting(ob) )
        {
                powerup(0,1);
                all_inventory(environment())->remove_killer(this_object());
                this_object()->remove_all_killer();
                return;
        }
        command("wield all");
        if( !objectp(obj=query_temp("weapon"))
         || obj->query("skill_type")!=weapon )
	{
		if( obj )
		{
			message_vision(HIY"$N"HIY"丢下一柄"+obj->name(1)+HIY"。\n"NOR,this_object());
			destruct(obj);
			reset_action();
		}	
                if( objectp(obj = carry_object(0,weapon,1)) )
		{
			obj->set("weapon_title","混世魔王");
			obj->wield();
			message_vision(HIY"$N"HIY"装备"+obj->query("name")+HIY"。\n"NOR,this_object());
		}
	}
        busy = (int)this_object()->query_busy();
        if( busy )
        {
                damage = (ob->query_maxkee()/(10+random(10)))+1;
		message_vision ("\n"+msgs[random(sizeof(msgs))],me,ob);
                message_vision ("\n"+strs[random(sizeof(strs))],ob);
                ob->receive_wound("kee",damage);
                ob->receive_damage("kee",damage);
                ob->delete_temp("last_damage_from");
                ob->set_temp("death_msg","被混世魔王一刀劈为两段！\n");
        }
        else	QUEST_D->randomPfm(this_object());
        call_out ("hurting",random(4)+3,ob);  
}

void kill_ob (object ob)
{
        object me = this_object();
        if( !ob || !present(ob,environment()) 
         || !clonep(environment())
         || !environment()->is_dntg() )
        {
        	powerup(0,1);
                all_inventory(environment())->remove_killer(this_object());
                this_object()->remove_all_killer();
                return;
        }
        remove_call_out("hurting");
        call_out("hurting",random(5)+5,ob);
        ::kill_ob(ob);
}

void die()
{
        object ob = query_temp("my_killer");
        object me = this_object();
        object ma;
	object panzi;
	int i,max_a,a;

	if( query("force")>800 )
	{
		if( random(20)>8 
		 || (!me->is_busy()&&!me->is_blind()&&!me->is_hunluan()) )
		{
			QUEST_D->addEffKee(me);
			QUEST_D->addKee(me);
			QUEST_D->addSen(me);
			QUEST_D->addEffSen(me);
			if( query("kee")>0 && query("eff_kee")>0
			 && query("sen")>0 && query("eff_sen")>0 )
			 	return;
		}
	}
	
	all_inventory(environment())->remove_killer(me);
	me->remove_all_killer();
	powerup(0,1);
	message_vision ("\n"HIY"$N"HIY"惨叫一声，被砍为两段。\n"NOR,me);
        if(ob && present(ob,environment()) 
         && clonep(environment()) )
        {
                
                ma = new (__DIR__"ma");
                message_vision ("\n"HIC"猴子头领马元帅领着几只猴子跑了过来，看到$N"HIC"被斩，高兴的跳了起来。\n\n"NOR,me);
                if(ob->query("dntg/huaguo")!="done" && userp(ob))  
                {
			ma->announce_success (ob);
                        panzi = new ("/d/dntg/hgs/obj/shipan");
                        panzi->move(ob);
                }
                message_vision ("\n"HIY"马元帅带着众猴子七手八脚的把$N"HIY"的尸体拖了出去。\n",me);
                destruct(ma);
                
                ob->add("faith",1000000);
                tell_object(ob,HIY"你得到了一百万门派贡献点。\n"NOR);
                
                if( wizardp(ob)
                 || ( ob->query_level()==69 && ob->query("combat_exp")>=870000000
        	      && ob->query("daoxing")>=480000 ) )
		{
			if( ob->level_up() )
			{
				tell_object(ob,HIG"【系统】你的等级提升了"HIR"1"HIG"级。\n"NOR);
				CHAR_D->setup_char( ob );
				UPDATE_D->check_user(ob,1);
				ob->powerup(0,1);
				ob->set_temp("login_data/time", time());
				ob->set_temp("login_data/exp", 0);
				max_a = ob->query("life/init_life_time");
				a = ob->query("life/life_time");
				a = max_a - a;
				i = 50+random(50);
				if( i>a )
					i = a;
				if( i>0 )
				{			
					ob->add("life/life_time",i);
					tell_object(ob,HIY"【系统】你得到了"HIR+i+HIY"点寿元。"NOR"\n");	
				}
				ob->save();
			}
		}
                REMOVE_D->add_room(environment(),1);
        }
        destruct(me);
}

void unconcious()
{
	die();
}

string short()
{
        string str = ::short();
        if( !query("my_type") )
                return str;
        return str+NOR"["+query("my_type")+NOR"]";
}