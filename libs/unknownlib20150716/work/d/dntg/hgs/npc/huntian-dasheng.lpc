  	set("attitude", "heroism");
	set_level(69);
  	create_family("大雪山",2, "蓝");
  	set("title", "混天大圣");
	set("class", "yaomo");

	set_skill("unarmed",690);
	set_skill("cuixin-zhang",690);
	set_skill("dodge",690);
	set_skill("xiaoyaoyou",690);
	set_skill("parry",690);
	set_skill("sword",690);
	set_skill("bainiao-jian",690);
	set_skill("blade",690);
	set_skill("bingpo-blade",690);
	set_skill("throwing",690);
	set_skill("force",690);   
	set_skill("ningxie-force",690);
	set_skill("literate",690);
	set_skill("spells",690);
	set_skill("dengxian-dafa",690);
	map_skill("spells", "dengxian-dafa");
	map_skill("force", "ningxie-force");
	map_skill("unarmed", "cuixin-zhang");
	map_skill("sword", "bainiao-jian");
	map_skill("blade", "bingpo-blade");
	map_skill("dodge", "xiaoyaoyou");

	set_skill("qisi-huisheng",690);
	set_skill("qushen",690);
	
	set("force_factor",query_skill("force")/5);
	set("mana_factor",query_skill("spells")/5);
	set_weapon_type(({"sword","blade"})[random(2)]);
}