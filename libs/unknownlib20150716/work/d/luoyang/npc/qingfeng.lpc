#include <ansi.h>
inherit SELLER;

void create()
{
    	set_name("小青锋", ({ "qingfeng" }) );
	set("gender", "男性" );
	set("age", 16);
	set("nickname", HIG "急风剑" NOR);
	set_level(25);
	set("long","洛阳金刀王家的武术教头，武功不错。\n");
	set_skill("wuhu-blade", 130);
        set_skill("blade", 150);
        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("parry", 150);
	set_skill("moondance", 150);
	map_skill("dodge", "moondance");
	map_skill("blade", "wuhu-blade");
	map_skill("parry", "wuhu-blade");
	set("force_factor", 5);
        set("env/test","HIM");
        set("goods",([
        	"level" : 16,
        	"base_value" : 500,
        	"goods_dir" : "/d/obj/nweapon/",
        	"goods" : ({
				"axe","blade","fork","hammer","mace","sword",
				"spear","staff","stick","blade","unarmed","whip", 
		}),
		"type" : "weapon",
        ]));	
        setup();
        carry_object(0,"cloth",1)->wear();
        carry_object(0,"blade",1)->wield();
}