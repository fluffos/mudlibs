inherit NPC;

void create()
{
	int i;
        set_name("女巫祝", ({ "wu zhu","wu nv","wu"}));
        set("age",30+random(10));
        set("gender", "女性");
        set("long",@LONG
黄河边的巫师，平时常常说些“河伯娶亲”的话，惹得当地百姓惶惶恐恐。
LONG);        
        set("attitude", "peaceful");
	i = 10+random(30);
	set_level(i);
        set_skill("unarmed", i*10);
        set_skill("dodge", i*10);
        set_skill("parry", i*10);
        set_skill("force", i*10);
        set("per",20);
        setup();
        carry_object(0,"cloth",random(2))->wear();
        carry_object(0,"shoes",random(2))->wear();
        add_temp("apply/max_kee",3000);
        add_temp("apply/max_sen",3000);
        powerup(0,1);
}

