//Cracked by Roath
// xingzhe.c i方行者?// By Dream Dec. 20, 1996
#include <ansi.h> 
inherit SUPER_NPC;

mixed putuo_maze();

void create()
{
	set_name("游方行者", ({ "xingzhe" }));
      	set_level(70);
      	create_family("南海普陀山", 3, "弟子");
	set("gender", "男性");
	set("title",HIG"副本大使"NOR);
	set("age", 40);
	set("attitude", "peaceful");
	set("class", "bonze");
	set("force_factor", 120);
	set("mana_factor", 110);

        set("eff_dx", 40000);
        set("nkgain", 250);

	set_skill("literate",700);
	set_skill("spells",700);
	set_skill("buddhism",700);
	set_skill("unarmed", 700);
	set_skill("jienan-zhi",700);
	set_skill("dodge",700);
	set_skill("lotusmove",700);
	set_skill("parry", 700);
	set_skill("force",700);
	set_skill("lotusforce",700);
	set_skill("staff", 700);
	set_skill("lunhui-zhang",700);
	set_skill("blade", 700);
	set_skill("cibeidao", 700);
	map_skill("blade", "cibeidao");
	map_skill("spells", "buddhism");
	map_skill("unarmed", "jienan-zhi");
	map_skill("dodge", "lotusmove");
	map_skill("force", "lotusforce");
	map_skill("parry", "lunhui-zhang");
	map_skill("staff", "lunhui-zhang");
        
        set("env/test","HIY");
	set_temp("armor_level",21+random(20));
	set_temp("weapon_level",21+random(20));
	set("inquiry", ([
		"紫竹林" : (: putuo_maze :),
	]));	
	setup();
	carry_object("/d/nanhai/obj/sengpao")->wear();
	carry_object(0,"shoes",1)->wear();
        carry_object(0,"pifeng",1)->wear();
        carry_object(0,"hand",1)->wear();
        carry_object(0,"wrists",1)->wear();
        carry_object(0,"waist",1)->wear();
        carry_object(0,"staff",1)->wield();
        powerup(0,1);
}

void die() { powerup(0,1); }

void unconcious() { powerup(0,1); }

void kill_ob(object who)
{
	message_vision(HIC"$N"HIC"朝$n"HIC"摇了摇头：阿弥陀佛，戒杀生！\n"NOR,this_object(),who);
	all_inventory(environment())->remove_killer(this_object());
	this_object()->remove_all_killer();
}

void init(){return;}

mixed putuo_maze()
{
	object me = this_player();
	
	if( me->query("family/family_name")!="南海普陀山" )
		return "阿弥陀佛，后山的紫竹林乃观音菩萨闲憩常到的所在，于林中静修，世事之纷扰顿时烟消云散。";
	if( time()<me->query("maze/zizhulin2")+1800 )
		return "你且下去静修身心，阿弥陀佛。";
	if( me->query_temp("maze/pt_zzl") )
		return "阿弥陀佛，事不宜迟，你现在便去林中历练一番。";
	if( me->query("faith")<10000 )
		return "你还是下去多为我佛做贡献。";
	me->add("faith",-10000);			
	EMOTE_D->do_emote(this_object(), "smile",geteuid(me),CYN,0,0,0);
	me->set_temp("maze/pt_zzl",1);
	message_vision(HIC"$N"HIC"对$n"HIC"说道：后山紫竹林中另有天地，为观音菩萨感化世间万恶所开辟的小洞天，于其中静修，世事之纷扰顿时烟消云散，久之便可荡涤胸中戾气。然其中亦有顽固不化者，须以佛门金刚怒嗔之。你且入内历练一番。\n"NOR,this_object(),me);
	return 1;
}