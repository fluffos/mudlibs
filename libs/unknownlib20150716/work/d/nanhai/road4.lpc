//Cracked by Roath
#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "小路");
  	set ("long", @LONG
这是一条通往后山的小路，道路至此越来越不好走，分叉也越来越
多了，就象迷宫一样，一不小心就会迷失方向，而且顺原路都走不回去。
你不禁踌躇起来，还要不要继续往前走呢？
LONG);
	set("outdoors", "/d/nanhai");
  	set("exits", ([
  		"north" : __FILE__,
  		"southeast" : __DIR__"road3",
  		"southwest" : __DIR__"road33",
	]));
	setup();
}

int valid_leave(object who,string dir)
{
	if( dir!="north" || !userp(who) )
		return ::valid_leave(who,dir);
	if( who->query("family/family_name")!="南海普陀山"
	 || !who->query_temp("maze/pt_zzl") 
	 || time()<who->query("maze/zizhulin2")+1800 )
	{
		who->delete_temp("maze");
		who->set_temp("maze/公共地图","putuo_zizhulin");
		if( MAZE_D->enter_maze(who, "zizhulin1") )
			return 2;
		else	return notify_fail("你不禁踌躇起来，还要不要继续往前走呢？\n");
	}
	else
	{
		who->delete_temp("maze");
                who->dismiss_team();
		if( MAZE_D->enter_maze(who, "zizhulin2") )
		{
			tell_object(who,CYN"\n游方行者从南边"NOR HIC"小路"NOR CYN"走了过来。\n"NOR HIC"游方行者说道：阿弥陀佛，林中虽无身陨危险，然仍需准备妥当，贫僧这里有些丹药，自然，如佛祖所言，需索要人事。\n"NOR);
			who->set("maze/zizhulin2",time());
			return 2;
		}
		else	return notify_fail("你不禁踌躇起来，还要不要继续往前走呢？\n");
	}
}	
