//Cracked by bear
// Room: /d/nanhai/chanfang
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "禅房");
  set("long", @LONG

这是普陀山门人弟子们练功打坐的地方。只见几个僧人正在
一边吆喝着舞拳弄脚，另外几个在练习兵器。屋角摆着几把
铁杖铁枪。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "zoulang",
  ]));
  set("no_clean_up", 1);
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/zhangchan": 1,
  ]));

  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv, room = this_object();
  int i;
  if (!query("jiangjing"))
    return 0;
  switch (random(3)) {
    case 0: tell_room(room, CYN "掌禅僧说道：万机歇罢结禅坛，无字拈来着力参。参到水穷山尽处，自然透得祖师关。\n" NOR); break;
    case 1: tell_room(room, CYN "掌禅僧说道：古德云，参禅要透祖师关，妙悟要穷心路绝。祖关不透，心路不绝，尽是依草附木精灵。\n" NOR); break;
    default: tell_room(room, CYN "掌禅僧说道：且道如何是祖师关？只这一个“无”字，便是一关，禅门目之为“无门关”。\n" NOR); break;
  }
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "南海普陀山")
      continue;
    tell_object(inv[i], "你在旁边听着，听着，禅心更加稳固了。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
