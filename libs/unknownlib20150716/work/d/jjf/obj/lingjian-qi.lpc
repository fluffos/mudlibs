inherit ITEM;

void create()
{
	set_name("令箭",({"ling jian", "ling", "jian", "lingjian"}));
	set_weight(100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long","一枝短短的小箭，上写一个「齐」字。\n");
		set("unit","枝");
		set("name_recognized", "齐府令箭");
		set("value", 0);
		set("material","bone");
	}
	setup();
}
