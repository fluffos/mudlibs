// Room: /d/jjf/front_yard2.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
空阔的场地上铺满了细细的黄土，正好适合演武。四面有几个
秦府家将正在练武。场地四边竖着几根木桩(logs)，还挖了若干个
大沙坑(pits)。西面是一间厢房，秦府的嘉宾可以去休息。场地东
边有个兵器架。
LONG);
  set("item_desc", ([
    "pits": "沙坑里有些家将在练习轻功，你也可以跳(tiao)下去试试。\n",
    "logs": "几根木桩上有不少兵器打过的痕迹(da)。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "keting.lpc",
    "west": __DIR__ "guest_bedroom",
    "north": __DIR__ "front_yard",
    "east": __DIR__ "jjf_bingqi",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 1,
  ]));
  set("out_doors", "jjf");
  setup();
}

void init() {
  add_action("do_da", "da");
  add_action("do_tiao", "tiao");
}

int do_da(string arg) {
  object me = this_player(), weapon;
  string skill;
  int sk;

  if ((!arg) || !((arg == "logs") || (arg == "木桩")))
    return notify_fail("你要打什么？\n");
  if (me->query("kee") < me->query("eff_kee") / 5
    || me->query("eff_kee") < me->query_maxkee() / 5)
    return notify_fail("你累得胳膊都抬不起来了，还是先休息一会儿吧！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || !stringp(skill = weapon->query("skill_type"))) {
    me->receive_wound("kee", me->query("eff_kee") / 10);
    return err_msg("你挥拳向木桩打去，结果把拳头打得鲜血淋漓。\n");
  }
  me->receive_damage("kee", 10);
  if (!((string)me->query("family/family_name") == "将军府"))
    return err_msg("你挥舞手中兵器在木桩周围乱练了一会儿。\n");

  sk = me->query_skill(skill, 2);
  tell_object(me, CYN "你以木桩做对手练了一路兵器。\n" NOR);

  if (sk >= me->query_level() * 10) {
    me->receive_damage("kee", (int)me->query("max_kee") / 10);
    return err_msg("你的实战经验太低，不能从打木桩中学到新知。\n");
  }
  if (random((me->query_con() + me->query_str()) / 20) < 3)
    return err_msg("你忙乎了半天，手都磨出茧了，还是什么都没学到。\n");

  me->improve_skill(skill, random((int)(me->query("con") + me->query("str")) * 5) + 1);
  tell_object(me, "你领悟出一些" HIC "+「" + to_chinese(skill) + HIC "」" NOR "的窍门。\n");
  return 1;
}

int do_tiao(string arg) {
  object me = this_player();
  int sk;

  if ((!arg) || !((arg == "pits") || (arg == "沙坑")))
    return notify_fail("你要往哪里跳？\n");
  if (me->query("kee") < (int)(me->query_maxkee() / 5))
    return notify_fail("再跳下去脚板都要磨破了！\n");
  if (!((string)me->query("family/family_name") == "将军府"))
    return err_msg("你纵身跳下沙坑，结果跳不回来了，只好慢慢爬回来。\n");

  write(CYN + "你纵身跳下沙坑，又奋力跳了回来。\n" NOR);
  me->receive_damage("kee", 10);
  sk = me->query_skill("dodge", 2);
  if (me->query_level() * 10 <= sk)
    return err_msg("你的实战经验太低，不能从跳沙坑中学到新知。\n");

  if (random((me->query_con() + me->query_str()) / 15) < 3)
    return err_msg("你跳上跃下，闹了个灰头土脸，可是什么也没有学到。\n");

  me->improve_skill("dodge", random((int)(me->query("str") + me->query("con")) * 3) + 1);
  tell_object(me, "你领悟出一些" HIC "「基本轻功」" NOR "方面的窍门。\n");

  return 1;
}
