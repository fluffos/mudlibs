// Room: /d/jjf/guest_cabinet2.c
#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "西厢二楼");
  	set ("long", @LONG
这间卧房颇为阔朗，窗口一张紫檀木大案，文房四宝齐备，又有一盆
小小盆景，绿意盎然。转过屏风，迎面只见一幅写意山水，笔势纵横。
旁边就是卧榻，垂着水红纱帐，绣了些花鸟。
LONG);
	set("objects", ([
  		__DIR__"npc/luocheng.lpc" : 1,
	]));
  	set("exits", ([ 
  		"north" : __DIR__"guest_shufang",
  		"down" : __DIR__"guest_cabinet",
	]));
  	set("if_bed", 1);
  	set("sleep_room", 1);
  	set("alternative_die",1);
	setup();
}

int alternative_die(object who)
{
	object target;
	if( !userp(who) )
	{
		if( base_name(who)!="/d/jjf/npc/luocheng" )
			return 1;
		who->powerup(0,1);
		all_inventory(this_object())->remove_killer(who);
		who->remove_all_killer();
		message_vision("\n"HIC"$N"HIC"脸色一变，慌忙就地盘坐压制旧伤伤势。\n\n"NOR,who);
		return 0;	
	}
	if( !objectp(target = who->query_temp("last_damage_from"))
	 || base_name(target)!="/d/jjf/npc/luocheng" )
	 	return 1;
	message_vision(HIY"$N"HIY"身子一歪，险些跌倒。\n"NOR,who);
	message_vision(HIC"$n"HIC"连忙上前扶住了$P。\n"NOR,who,target);	 	
	EMOTE_D->do_emote(target, "haha",0,CYN,0,0,0);
	tell_object(who,CYN+target->name()+CYN"说道："+RANK_D->query_respect(who) +"不必气馁，再接再厉！\n"NOR);
	all_inventory(this_object())->remove_killer(target);
	target->remove_all_killer();
	target->delete_temp("last_opponent");
	who->delete_temp("pending/jjf_apprentice_luocheng");
	who->set("mark/jjf_luocheng_fail",time());
	who->powerup(0,1);
	return 0;
} 
