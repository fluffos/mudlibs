#include <ansi.h>
inherit SUPER_NPC;

mixed about_lou();
mixed about_ling();

void create()
{
	set_name("尉迟恭", ({"yuchi gong", "yuchi", "gong", "yuchigong", "jingde", "yuchi jingde", "yuchijingde", "master", "shifu"}));
  	set_level(79);
  	set ("long", @LONG
尉迟恭，字敬德，乃是唐太宗手下猛将。排为隋唐时第
十二条好汉。起初他是反王刘武州殿前元帅，后因兵败
降唐。他惯使一条点钢枪，且喜使一对雌雄竹节钢鞭。
LONG);
	create_family2("将军府","尉迟鞭法",2);
 	set("title", HIY"鄂国公"NOR);
  	set("gender", "男性");
  	set("age", 43);
  	set("looking", HIB"钢须虬髯，宛如一尊杀神"NOR"。");
	set("rank_info/pos_msg", HIR"浑身上下煞气震天"NOR"。\n");
	set("rank_info/respect","将军");
  	set_skill("literate", 790);
	set_skill("force",790);
	set_skill("dodge",790);
	set_skill("parry",790);
	set_skill("mace",790);
	set_skill("jinglei-mace",790);
	set_skill("yanxing-steps",790);
	set_skill("lengquan-force",790);
	set_skill("unarmed",790);
	set_skill("changquan",790);
        set_skill("spells",500);
        set_skill("baguazhou",500);
        map_skill("spells","baguazhou");
	map_skill("mace", "jinglei-mace");
	map_skill("force", "lengquan-force");
	map_skill("unarmed", "changquan");
	map_skill("parry", "jinglei-mace");
	map_skill("dodge", "yanxing-steps");
	
	set_skill("jiefeng",790);
	set_skill("shengguang",790);
	set_skill("jiameng",790);
	set_skill("jinshui",790);
	
  	set("force_factor", 100);
	set("env/test","HIY");
	set("inquiry", ([
		"醉星楼" : (:about_lou:),
		"令箭"	 : (:about_ling:),
	]));	
  	setup();
  	carry_object(0,"mace",1)->wield();
	carry_object(0,"armor",1)->wear();
	carry_object(0,"kui",1)->wear();
	carry_object(0,"pifeng",1)->wear();
	carry_object(0,"ring",1)->wear();
	carry_object(0,"cloth",1)->wear();
	carry_object(0,"shoes",1)->wear();
	carry_object(0,"wrists",1)->wear();
	carry_object(0,"waist",1)->wear();
	carry_object(0,"hand",1)->wear();
  	powerup(0,1);
}
 
int accept_fight(object me)
{
	tell_object(me,CYN+name()+CYN"说道：老夫手重，若是伤人反而不美了。\n"NOR);
  	return 0;
}

mixed about_ling()
{
	object me = this_player();
	if( me->query("family/family_name")!="将军府" )
		return 0;
	if( me->is_knowing("jjf_zuixing") )
		return "哈哈，果真是大快人心！便不劳烦你了。";
	if( me->query_temp("jjf/know_ling") )
		return "不是已经和你说了吗？！";	
	if( !me->query_temp("jjf/need_ling") )
		return "什么令箭，某家不知！";
	me->set_temp("jjf/know_ling",1);	
	tell_object(me,CYN+name()+CYN"说道：听闻二贼手下见令箭如见其主，有了令箭便能打发走他们。当时抄家之时某却未见有，估计有余孽将令箭藏匿了。\n"NOR);
	tell_object(me,HIC+name()+HIC"对你说道："+me->name(1)+HIC"，你去醉星二楼探查探查，如能发现令箭，便可引走那些狗腿子！\n"NOR);
	return 1;
}

mixed about_lou()
{
	object me = this_player();
	if( me->is_knowing("jjf_zuixing") )
		return "哈哈，果真是大快人心！";
	if( me->query("family/family_name")!="将军府" )
		return "劳什子破楼，看了就心烦！";
	if( me->query_temp("jjf/go_break") )
		return "事不宜迟，你还不快去？！";	
	me->set_temp("jjf/go_break", 1);	
	EMOTE_D->do_emote(this_object(), "bite",0,CYN,0,0,0);
	tell_object(me,CYN+name()+CYN"说道：劳什子破楼，看了就心烦！\n"NOR);
	command("whisper "+geteuid(me)+" 老夫不方便出手，你去帮老夫砸了这楼，老夫感激不尽。偷偷前往，不要让人发现，骗过一楼的那些小喽啰，将二楼四根柱子砸(break)了，再来禀告予我。\n"NOR);
	return 1;
}

void attempt_apprentice(object me)
{
	string myname=RANK_D->query_rude(me);
  	int kar=me->query_kar();
  	int effstr=(int)(me->query("str")+me->query_skill("unarmed",1)/10-2);

	if( me->query("class")=="yaomo" || me->query("class")=="ghost" )
        {
		EMOTE_D->do_emote(this_object(), "pei",geteuid(me),CYN,0,0,0);
           	tell_object(me,CYN+name()+CYN"说道：妖魔鬼怪滚一边去！\n"NOR);
           	return;
        }
        if( me->query_level()>90 )
	{
		EMOTE_D->do_emote(this_object(), "wow",geteuid(me),CYN,0,0,0);
		tell_object(me,CYN+name()+CYN"说道：老夫可教不了你，还是学学老程当年，在梦中看看与那白发仙人是不是有缘。\n"NOR);
		return;
	}
        if( me->is_knowing("jjf_zuixing") )
        {
      		EMOTE_D->do_emote(this_object(), "nod",0,CYN,0,0,0);
      		tell_object(me,CYN+name()+CYN"说道："+myname+"果然有两下子，老夫就收下你吧！\n"NOR);
      		command ("recruit " + me->query("id") );
      		return;
        }
  	if ((random(effstr)< 25) || random((int)me->query_con())<20)
    	{
      		tell_object(me,CYN+name()+CYN"说道：这"+myname+"手无缚鸡之力，不配作我徒弟！\n"NOR);
		return;
	}
  	if ( random((int)me->query("cps")) < 20 && random((int)me->query_cor())<20 )
	{
      		tell_object(me,CYN+name()+CYN"说道：这"+myname+"胆子还不如只老鼠！\n"NOR);
      		return;
    	}
    	tell_object(me,CYN+name()+CYN"说道：要想拜我为师，倒也不难。只需将那醉星楼拆了就行！\n"NOR);
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class","fighter");
}

int prevent_learn(object me, string skill)
{
	if( skill=="shengguang" && me->query_level()<50 )
		return err_msg(CYN+name()+"说道：等你等级高了再教你。\n"NOR);
	if( skill=="jinshui" && me->query_level()<60 )
		return err_msg(CYN+name()+"说道：等你等级高了再教你。\n"NOR);
	if( skill=="jiameng" && me->query_level()<40 )
		return err_msg(CYN+name()+"说道：等你等级高了再教你。\n"NOR);
	return 0;
}
