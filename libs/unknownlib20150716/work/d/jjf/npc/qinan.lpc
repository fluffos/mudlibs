#include <ansi.h>
inherit NPC;

mixed try_me();

void create() {
  set_name("秦安", ({ "qin an", "qin" }));
  set_level(17);
  set("title", "将军府总管");
  set("gender", "男性");
  set("age", 45);
  set("inquiry", ([
    "俸银": (: try_me :),
  ]));
  set("combat_exp", 35000);
  set_skill("unarmed", 170);
  set("force", 200);
  set("force_factor", 10);
  set_skill("dodge", 170);
  set_skill("parry", 170);
  setup();
  carry_object(0, "cloth", random(10))->wear();
  add_money("silver", 10);
}

void init() {
  add_action("do_answer", "answer");
}

int do_answer(string arg) {
  if (!arg) return notify_fail("你说什么？\n");
  this_player()->set_temp("pending/jiangjun_answer", 0);
  message_vision("$N答道：" + arg + "\n", this_player());
  if (arg == "拜师") {
    command("haha");
    command("say 不是我吹，我家将军武功没人能比！\n");
    this_player()->set_temp("pending/jiangjun_answer", 1);
  } else {
    command("say 你胡说什么呀？一边玩去！\n");
  }
  return 1;
}

mixed try_me() {
  int k;
  object ob, me;
  me = this_player();
  if (me->query_level() >= 40 && !wizardp(me))
    return "您老是开玩笑吗？";
  if (me->query_level() < 5)
    return "你先去学点本事再说吧。";
  if (me->query("age") < 16)
    return ("先去学点本事吧，别光想着银子！\n");
  if ((string)me->query("family/family_name") != "将军府")
    return ("你非官家，何来俸银！");
  if (!(int)me->query("mark/jjf_money"))
    me->set("mark/jjf_money", 1);
  if ((int)me->query("mark/jjf_money") > (int)me->query_level())
    return ("先去好好学点本事吧，别就想着俸银！");
  k = ((int)me->query_level() - (int)me->query("mark/jjf_money") + 1) * 5;
  ob = new("/obj/money/gold");
  ob->set_amount(k);

  if (ob->move(me)) {
    message_vision("$N递给$n一些黄金。\n", this_object(), me);
    me->add("mark/jjf_money", 1);
    tell_object(me, CYN + name() + CYN "说道：是时候了，这是本月俸银。\n" NOR);
    return 1;
  }
  return "你包裹满了吧。";
}
