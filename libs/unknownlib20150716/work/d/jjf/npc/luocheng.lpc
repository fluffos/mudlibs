inherit SUPER_NPC;
#include <ansi.h>
#include <combat.h>

int handle_kill(object me);
int accept_fight(object me);
void player_win(object me);
void player_lose(object me);

nosave object *go_down;

void create() {
  set_name("罗成", ({ "luo cheng", "luo", "cheng", "luocheng", "master", "shifu" }));
  set_level(79);
  set("long", @LONG
罗成是秦琼的表弟，乃是隋唐第七条好汉。传说他早已
在保长安时被乱箭射死战死，但不知为何还在这里。听
说罗成年幼时曾受过异人传授，学得一身奇异的内功，
因此比武极少败过。
LONG);
  create_family2("将军府", "罗家枪法", 2);
  set("title", HIG "越国公" NOR);
  set("gender", "男性");
  set("age", 34);

  set("looking", HIW "银甲银枪，好一个白马美少年" NOR "。");
  set("rank_info/pos_msg", HIR "浑身上下煞气震天" NOR "。\n");
  set("rank_info/respect", "将军");
  set_skill("literate", 790);
  set_skill("force", 790);
  set_skill("lengquan-force", 790);
  set_skill("parry", 790);
  set_skill("dodge", 790);
  set_skill("yanxing-steps", 790);
  set_skill("unarmed", 790);
  set_skill("changquan", 790);
  set_skill("mace", 590);
  set_skill("wusi-mace", 590);
  set_skill("spear", 790);
  set_skill("bawang-qiang", 790);
  map_skill("mace", "wusi-mace");
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "yanxing-steps");
  set_skill("jiefeng", 790);
  set_skill("tuyan", 790);
  set_skill("jinshui", 790);
  set_skill("qisi-huisheng", 790);
  set("force_factor", 100);
  set("env/test", "HIR");

  set("inquiry", ([
    "生死": "少年轻狂，徒惹祸端。幸梦中得神仙指点，方逃得万箭穿身之祸。奈何\n生死簿上有点名，只得匿于表兄府中，奈何奈何。",
  ]));
  setup();
  carry_object(0, "spear", 1)->wield();
  carry_object(0, "armor", 1)->wear();
  carry_object(0, "kui", 1)->wear();
  carry_object(0, "pifeng", 1)->wear();
  carry_object(0, "ring", 1)->wear();
  carry_object(0, "cloth", 1)->wear();
  carry_object(0, "shoes", 1)->wear();
  carry_object(0, "wrists", 1)->wear();
  carry_object(0, "waist", 1)->wear();
  carry_object(0, "hand", 1)->wear();
  powerup(0, 1);
}

void song_ke() {
  int i;
  if (environment(this_object()) != find_object("/d/jjf/guest_cabinet2"))
    return;
  if (!go_down || !pointerp(go_down) || sizeof(go_down) < 1)
    return;
  message_vision("\n" HIC "$N" HIC "冷声说道：送客！\n\n" NOR, this_object());
  for (i = 0; i < sizeof(go_down); i++) {
    if (!present(go_down[i], environment()))
      continue;
    tell_object(go_down[i], CYN "你无奈之下，只得垂头丧气的下楼而去。\n" NOR);
    go_down[i]->move("/d/jjf/guest_cabinet");
    go_down -= ({ go_down[i] });
  }
}

void add_songke(object who) {
  if (!who)
    return;
  if (!go_down || !pointerp(go_down) || sizeof(go_down) < 1)
    go_down = ({ who });
  else if (member_array(who, go_down) == -1)
    go_down += ({ who });
  else return;
  go_down -= ({ 0 });
  remove_call_out("song_ke");
  call_out("song_ke", 0);
}

void init() {
  object ob;
  if (!environment()
    || base_name(environment()) != "/d/jjf/guest_cabinet2")
    return;
  if (interactive(ob = this_player()) && member_array(ob, query_enemy()) != -1) {
    if (is_fighting()) {
      message_vision(HIW "罗成对$N" HIW "喝道：“又是你！滚出去！”\n" NOR, ob);
      add_songke(ob);
      return;
    }
  }
  add_action("do_kill", "kill");
  add_action("do_surrender", "surrender");
}

int do_surrender() {
  if (!environment()
    || base_name(environment()) != "/d/jjf/guest_cabinet2")
    return 0;
  this_player()->delete_temp("pending/jjf_apprentice_luocheng");
  return 0;
}

int do_kill(string arg) {
  if (!arg || !id(arg))
    return 0;
  if (!environment()
    || base_name(environment()) != "/d/jjf/guest_cabinet2")
    return 0;
  if (this_object()->is_fighting()
    && !this_object()->is_fighting(this_player()))
    return err_msg(CYN "罗成说道：呵呵，想切磋武艺，还需等等。\n" NOR);
  if (time() < this_player()->query("mark/jjf_luocheng_fail") + 900) {
    EMOTE_D->do_emote(this_object(), "haha", geteuid(this_player()), CYN, 0, 0, 0);
    tell_object(
      this_player(),
      CYN + name() + CYN "说道：" + RANK_D->query_respect(this_player()) + "刚刚与吾比试，技差一筹，不必气馁。\n" NOR
    );
    return err_msg("罗成暂时不想与你比试。\n");
  }
  handle_kill(this_player());
  return 1;
}

int handle_kill(object me) {
  if (!me || !present(me, environment()))
    return 0;
  if (is_fighting() || !accept_fight(me)) {
    this_object()->remove_all_enemy();
    return err_msg(CYN "罗成抱拳道：" + me->name() + CYN "，想要切磋武技，还请稍候片刻。\n" NOR);
  }
  if (time() < me->query("mark/jjf_luocheng_fail") + 900) {
    EMOTE_D->do_emote(this_object(), "haha", geteuid(me), CYN, 0, 0, 0);
    tell_object(
      me,
      CYN + name() + CYN "说道：" + RANK_D->query_respect(me) + "刚刚与吾比试，技差一筹，不必气馁。\n" NOR
    );
    return err_msg("罗成暂时不想与你比试。\n");
  }
  message_vision(CYN "罗成说道：好，我们便切磋一下！\n" NOR, me);
  fight_ob(me);
  me->fight_ob(this_object());
  return 1;
}

int accept_fight(object me) {
  if (me->query_temp("pending/jjf_apprentice_luocheng")) {
    powerup(0, 1);
    return 1;
  }
  tell_object(me, CYN + name() + CYN "说道：难道你来这里就是想打架？我看还是算了吧。\n" NOR);
  tell_object(me, CYN + name() + CYN "对你面露厌恶之色。\n" NOR);
  add_songke(me);
  return 0;
}

void kill_ob(object me) {
  accept_fight(me);
}

void attempt_apprentice(object me) {
  string myname = RANK_D->query_respect(me);

  if (me->query("class") == "yaomo" || me->query("class") == "ghost") {
    EMOTE_D->do_emote(this_object(), "pei", geteuid(me), CYN, 0, 0, 0);
    tell_object(me, CYN + name() + CYN "说道：妖魔鬼怪休要猖狂！\n" NOR);
    return;
  }
  if (me->query_level() > 90) {
    tell_object(me, CYN + name() + CYN "说道：在下可教不了你，还是看看与那白发仙人是不是有缘。\n" NOR);
    return;
  }
  if (is_fighting()) {
    tell_object(me, CYN + name() + CYN "说道：现在在下正忙，" + myname + "请稍候。\n" NOR);
    return;
  }
  if (me->is_knowing("jjf_luocheng")) {
    tell_object(me, CYN + name() + CYN "说道：不错，不错。" + myname + "果然是可教之才！\n" NOR);
    tell_object(me, CYN + name() + CYN "说道：你我便切磋功夫罢了。\n" NOR);
    command("recruit " + me->query("id"));
    return;
  }
  if (time() < me->query("mark/jjf_luocheng_fail") + 900) {
    EMOTE_D->do_emote(this_object(), "haha", geteuid(me), CYN, 0, 0, 0);
    tell_object(me, CYN + name() + CYN "说道：" + myname + "刚刚与吾比试，技差一筹，不必气馁。\n" NOR);
    return;
  }
  EMOTE_D->do_emote(this_object(), "consider", 0, CYN, 0, 0, 0);
  tell_object(me, CYN + name() + CYN "说道：在下从不收徒，但阁下若能胜过我手中枪(fight)，你我不妨互相切磋功夫。\n" NOR);
  me->set_temp("pending/jjf_apprentice_luocheng", 1);
  return;
}

void combat_lose(object me) {
  powerup(0, 1);
  if (!environment()
    || base_name(environment()) != "/d/jjf/guest_cabinet2"
    || !me || !present(me, environment()))
    return;
  remove_killer(me);
  me->remove_killer(this_object());
  this_object()->delete_temp("last_opponent");
  if (me->query_temp("pending/jjf_apprentice_luocheng")) {
    me->set_knowing("jjf_luocheng", 1);
    me->delete_temp("pending/jjf_apprentice_luocheng");
    tell_object(me, CYN + name() + CYN "说道：不错，不错。" + RANK_D->query_respect(me) + "果然是可教之才！\n" NOR);
    tell_object(me, CYN + name() + CYN "说道：你我便切磋功夫罢了。\n" NOR);
    command("recruit " + me->query("id"));
  }
  return;
}

void combat_win(object me) {
  powerup(0, 1);
  if (!environment()
    || base_name(environment()) != "/d/jjf/guest_cabinet2"
    || !me || !present(me, environment()))
    return;
  remove_killer(me);
  me->remove_killer(this_object());
  this_object()->delete_temp("last_opponent");
  EMOTE_D->do_emote(this_object(), "haha", 0, CYN, 0, 0, 0);

  tell_object(me, CYN + name() + CYN "说道：" + RANK_D->query_respect(me) + "不必气馁，再接再厉！\n" NOR);
  command("look " + me->query("id"));
  if (random(me->query_per()) > 30 && me->query_temp("pending/jjf_apprentice_luocheng")) {
    if (me->query("gender") == "女性")
      tell_object(me, CYN + name() + CYN "说道：也罢，看你模样清丽，便收你为徒也无不可。\n" NOR);
    else tell_object(me, CYN + name() + CYN "说道：也罢，看你模样俊俏，便收你为徒也无不可。\n" NOR);
    me->set_knowing("jjf_luocheng", 1);
    me->delete_temp("pending/jjf_apprentice_luocheng");
    command("recruit " + me->query("id"));
    return;
  }
  me->set("mark/jjf_luocheng_fail", time());
  add_songke(me);
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "fighter");
    if (!ob->is_titles("横扫千军")) {
      if (ob->set_titles("横扫千军"))
        tell_object(ob, HIC "【系统】你获得了称号：「" HIR "横扫千军" NOR HIC "」。\n" NOR);
    }
  }
}

int prevent_learn(object me, string skill) {
  if ((skill == "jinshui" || skill == "tuyan") && me->query_level() < 50)
    return err_msg(CYN + name() + "说道：等你等级高了再教你。\n" NOR);
  if (skill == "qisi-huisheng" && me->query_level() < 80)
    return err_msg(CYN + name() + "说道：等你等级高了再教你。\n" NOR);
  return 0;
}
