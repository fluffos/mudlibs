// Room: /d/jjf/jjf_bingqi.c
inherit ROOM;

mapping Rack = ([
	"sword":"长剑",
	"blade":"单刀",
	"mace":"铜锏",
	"spear":"长枪",
	"hammer":"铁锤",
	"axe":"板斧",
	"fork":"钢叉",
	"stick":"铁棍",
	"dagger":"匕首",
	"whip":"皮鞭",
	"kui":"钢盔",
	"armor":"铁甲",
	"waist":"护心镜",
	"shoes":"战靴",
]);

mixed check_rack();

void create ()
{
	set ("short", "兵器架");
  	set ("long", @LONG
这里有一个兵器架(rack)，十八般兵刃样样齐全。架子旁边挂着数十
副闪闪发光的盔甲，腰带，和战靴等物。旁边一位将军正闭目养神，
看来可以跟他要一副衣甲和一件趁手的兵器。
LONG);
	set("outdoors", 1);
  	set("objects", ([ 
  		__DIR__"npc/qinping" : 1,
	]));
  	set("exits", ([ 
  		"west" : __DIR__"front_yard2",
	]));

  	set("item_desc", ([
  		"rack": (: check_rack :),
  	]));
  		
	setup();
}

mixed check_rack()
{
	string str,*ars,*wps,str2,arg;
	int i,k;
	
	ars = ({
		"kui","armor","waist","shoes",
	});
	wps = ({
		"sword","blade","mace","spear","hammer","axe","fork","stick","dagger","whip",
	});
	
	str = "兵器架上插着：\n\t";
	k = 0;
	for(i=0;i<sizeof(wps);i++)
	{
		if( time()<query("rack/"+wps[i])+1800 )
			continue;
		if( undefinedp(Rack[wps[i]]) )
			continue;
		k++;	
		arg = Rack[wps[i]]+"("+wps[i]+")";
		str+= sprintf("%12-s",arg);
		if( i==sizeof(wps)-1 )
			str+= "。\n";
		else if( k%4==0 )
			str+= "、\n\t";
		else	str+= "、";
	}
	if( str=="兵器架上插着：\n\t" )
		str = "兵器架上已经空了，";
	str2 = "一边挂着：\n\t";
	k = 0;
	for(i=0;i<sizeof(ars);i++)
	{
		if( time()<query("rack/"+ars[i])+1800 )
			continue;
		if( undefinedp(Rack[ars[i]]) )
			continue;
		k++;	
		arg = Rack[ars[i]]+"("+ars[i]+")";
		str2+= sprintf("%12-s",arg);		
		if( i==sizeof(ars)-1 )
			str2+="。\n";
		else if( k%4==0 )
			str2+= "、\n\t";
		else	str2+= "、";
	}
	if( str2=="一边挂着：\n\t" )
		str2 = "一旁的架子上也是空空荡荡。\n";
	str+= str2;
	str+= "看起来你可以从武器架(rack)上捡(get)能用的装备。\n";
	return str;
}

void init()
{
	add_action("do_get","get");
}

int do_get(string arg)
{
	int lvl;
	string *ars;
	object ob,me = this_player();
	if( !arg || sscanf(arg,"%s from rack",arg)!=1 )
		return 0;
	if( undefinedp(Rack[arg]) )
		return 0;
	if( me->query("family/family_name")!="将军府" )
		return err_msg("只有将军府的弟子才能拿。\n");
	if( me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
	if( time()<query("rack/"+arg)+1800 )
		return err_msg("武器架上的"+Rack[arg]+"已经给人拿了。\n");		
	lvl = me->query_level();
	if( lvl<10 )
		lvl = 10;
	if( lvl>20 )
		lvl = 20;
					
	ars = ({ "kui","armor","waist","shoes",});
	if( member_array(arg,ars)==-1 )
		ob = new("/d/obj/nweapon/"+arg);
	else	ob = new("/d/obj/narmor/"+arg);	
	if( !ob )
		return err_msg("奇怪，空的？！\n");
	
	if( member_array(arg,ars)==-1 )
		ob->init_weapon(lvl);
	else	ob->init_armor(lvl);
	
	if( ob->move(me) )
	{
		me->start_busy(1);
		message_vision("$N从兵器架上拿起一"+ob->query("unit")+ob->name(1)+"。\n",me);
		set("rack/"+arg,time());
		return 1;
	}
	else
	{
		if( ob )
			destruct(ob);
		return err_msg("你背包满了。\n");
	}			
}