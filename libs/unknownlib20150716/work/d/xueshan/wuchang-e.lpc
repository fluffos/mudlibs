// 神话世界·西游记·版本４．５０
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "东武场");
  set("long", @LONG
放眼望去，这座冰宫通体雪明，当真是巍峨壮观。但是此刻宫门
紧闭，一位身披银甲的壮汉和一位面目阴森的老者正神情紧张地
守在门前。
LONG);
  set("exits", ([
    "south": __DIR__ "wuchang-se",
    "north": __DIR__ "wuchang-ne",
    "west": __DIR__ "wuchang-c",
  ]));
  set("objects", ([
    __DIR__ "npc/tuying-zunzhe": 1,
    __DIR__ "npc/baixiang-zunzhe": 1,
  ]));
  set("outdoors", "xueshan");
  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv;
  int i;
  if (!query("jiangjing"))
    return 0;
  tell_room(this_object(), "\n" HIC "白象尊者说道：登仙大法可谓是明王创造出来的奇特的仙法。\n" NOR);
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "大雪山")
      continue;
    tell_object(inv[i], "你在旁闻听，若有所悟，不禁眉花眼笑。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
