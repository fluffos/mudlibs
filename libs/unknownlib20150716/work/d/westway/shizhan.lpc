inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石栈道");
  set("long", @LONG
这是一条极长的用大石块铺成的栈道，远处栈道伸进石坡，不
得不在有的地方凿石辟路架路。据说西面再远一点就是著名的
嘉峪关了，往东是去酒泉的方向。

LONG);

  set("exits", ([
    "east": __DIR__ "jiuquan",
    "west": __DIR__ "jiayu",
  ]));
  set("outdoors", __DIR__);
  setup();
  if (objectp(this_object())) {
    remove_call_out("greeting");
    call_out("greeting", 25);
  }
}

void greeting() {
  object *list, ob;
  int i;
  remove_call_out("greeting");
  list = all_inventory(this_object());
  i = sizeof(list);
  while (i--) {
    if (!list[i])
      continue;
    ob = list[i];
    if (!living(ob) || ob->is_fighting())
      continue;
    if (!ob->is_character())
      continue;
    tell_object(ob, "\n你忽然觉得脚下的石板松动了………\n");
    ob->move("/d/westway/tielong");
    message_vision("「咚」的一声，$N从机关掉到了铁笼中………\n", ob);
  }
  call_out("greeting", 25);
  return;
}
