// fabao.c
//塔(char) 
#include <ansi.h>
#include <armor.h>
#include <combat.h>
inherit FABAO;

mapping a_title() {
  return ([
    "程咬金": ({ "axe", "ad_axe", "ad_sanban-axe" }),
    "尉迟恭": ({ "mace", "ad_mace", "ad_jinglei_mace" }),
    "罗成": ({ "spear", "ad_separ", "ad_bawang-qiang" }),
    "秦琼": ({ "mace", "ad_mace", "ad_wusi-mace" }),
    "姜子牙": ({ "spells_succ", "spells_dodge", }),
    "申公豹": ({ "combat_succ", "combat_dodge", "combat_parry", }),
    "相柳": ({ "spells_damage", "combat_damage", }),
  ]);
}

void create() {
  set_name("将军令", ({ "jiangjun ling", "fabao", "ling" }));
  set("family_name", "将军府");
  set("long", "此乃%s炼制的飞行类法宝。此外，此法宝还具备存储(reserve)内法的功能。\n");
  set("armor_type", "Fabao");
  set("fabao_type", ({ "other" }));
  set("my_type", "fu");
  set("fabao/max_force", 12000);
  set("fabao/max_mana", 6000);
  set("unit", "面");
  set("飞行", 1);
  set("fabao/dest_msg", HIY "\n" HIY "只见$n" HIY "在半空几个翻滚，顿时隐入云际，沓然无踪。\n" NOR);
  set("fabao/back_msg", HIY "\n" HIY "只见$n" HIY "在半空几个翻滚，又跌回$N" HIY "手中。\n" NOR);
  set(
    "fabao/ji_msg",
    HIY "\n" HIY "$N" HIY "从怀中掏出$n" HIY "，喃喃念了几句咒语，一道金光从$n" HIY "上绽放开来，将$N" HIY "全身包裹住。\n" NOR
  );
  set("fabao/fly_msg", HIY "\n$n" HIY "闪出一道金光，包裹住$N" HIY "径直冲天而去！\n\n" NOR);
  set("fabao/fly_msg2", HIY "\n$n一团金光从天而降，$N" HIY "从中现出身影。\n\n" NOR);
  set("no_fabao", ([
    "self_damage": 1,
    "self_def": 1,
    "combat_damage": 1,
    "spells_damage": 1,
    "combat_def": 1,
    "spells_def": 1,
    "hit_ob": 1,
  ]));
  setup();
}

void init() {
  object me = this_player();
  if (environment() && me == environment()
    && !query("default_set"))
    this_object()->init_fabao(me);
  ::init();
}

//战斗中法宝auto攻击
mixed hit_ob(object attacker, object target, int attack_type) {
  return 0;
}

int init_fabao(object who) {
  if ( ::init_fabao(who)) {
    if (!query("fabao_title"))
      set("long", sprintf(query("long"), "将军府白发老人"));
    else set("long", sprintf(query("long"), query("fabao_title")));
    return 1;
  } else return 0;
}

int self_damage() { return 0; }
int self_def() { return 0; }
int query_combat_damage() { return 0; }
int query_spells_damage() { return 0; }
int query_combat_def() { return 0; }
int query_spells_def() { return 0; }
