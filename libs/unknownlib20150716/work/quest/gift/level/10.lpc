#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who, string arg, string color) {
  string *msgs, str;
  int i;
  if (!who)
    return;
  if (!arg || !stringp(arg) || strlen(arg) < 2)
    return;
  if (!color || !stringp(color))
    color = HIY;
  arg = COLOR_D->clean_color(arg);
  arg = sort_string(arg, 68, 0);
  msgs = explode(arg, "\n");
  str = "";
  for (i = 0; i < sizeof(msgs); i++)
    str += "【系统】" + msgs[i] + "\n";
  tell_object(who, color + str + NOR);
}

int update_level(object who) {
  object gift;
  if (!who || !living(who) || !userp(who)
    || who->query_level() != 10)
    return 0;

  Show(
    who,
    "恭喜！你现在10级了，算是「初入道途」了。接下来你可以去接长安城袁天罡的任务了。如果你西游记地图比较熟，也可以做南城客栈千里眼的手动送信任务。ask NPC about all会有提示的。\n",
    HIY
  );
  Show(who, "在40级之前，你还不能御器飞行，挂机时除了门派的回城技能外，你可以在南城客栈购买回城卷，ji seal即可自动返回长安十字街头。\n", HIG);
  Show(
    who,
    "提醒！泥巴中的挂机任务一般有两种模式：普通、噩梦。\n长安「天监台」袁天罡任务可通过 ask yuan about 噩梦，来切换普通、噩梦模式。使用ask yuan about kill 来领取任务，此任务每十个为一轮。噩梦完成一轮附加奖励一两黄金，40级后为二两黄金。普通模式奖励基数 40级前2000，40级后4500；噩梦模式奖励基数 40级前4500，40级后12000。\n",
    HIY
  );
  return 1;
}
