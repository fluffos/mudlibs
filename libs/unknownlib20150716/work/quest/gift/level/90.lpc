#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	string name;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=50 )
		return 0;
	if( who->query("giftmark/level_90") )
		return 0;
	who->set("giftmark/level_90",1);
	if( who->query("dntg/number")==2 )
		who->set("dntg/number",3);
	if( who->query("dntg/hell")!="done" )
		who->set("dntg/hell","done");
	if( !who->query("shentong/90") )
	{
		if( stringp(name=who->query("family/master_name")) )
			tell_object(who,NOR+HBBLU+name+HBBLU"告诉你：好徒儿，好一个造化。速速回来，为师再送你一个造化。"NOR"\n");
		tell_object(who,HIG"看来可以前去找你的师傅询问关于「"HIY"神通"HIG"」一事了。"NOR"\n");		
	}		
	return 1;
}
