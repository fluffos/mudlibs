#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who, string arg, string color) {
  string *msgs, str;
  int i;
  if (!who)
    return;
  if (!arg || !stringp(arg) || strlen(arg) < 2)
    return;
  if (!color || !stringp(color))
    color = HIY;
  arg = COLOR_D->clean_color(arg);
  arg = sort_string(arg, 68, 0);
  msgs = explode(arg, "\n");
  str = "";
  for (i = 0; i < sizeof(msgs); i++)
    str += "【系统】" + msgs[i] + "\n";
  tell_object(who, color + str + NOR);
}

int update_level(object who) {
  object gift;
  if (!who || !living(who) || !userp(who)
    || who->query_level() != 9)
    return 0;
  if (who->query("giftmark/level_9"))
    return 0;
  who->set("giftmark/level_9", 1);
  Show(
    who,
    "恭喜恭喜，你现在已经 9 级了，现阶段主要是通过和东方武馆的弟子(dizi)切磋(fight)，来获得经验和潜能。同时通过学习将所有技能平至90级，这里要提醒的是：为了方便10级后把技能平满100级，当你技能全部学满后，需要将潜能补满。\n",
    HIY
  );
  Show(
    who,
    "当人物等级9级并武学经验已难以增长时，从傲来国北城门出发，当进入花果山的过程中将自动触发并进入10级突破副本。杀死「山洞」内的兽王，将突破9级瓶颈。副本每隔30分钟可以触发。\n",
    HIR
  );
  Show(
    who,
    "这个时候，你能使用部分门派绝招了，绝招查询命令是 chkskill (技能名)，绝招信息查询命令是 help 技能名_绝招名。示例：chkskill baihua-zhang能显示月宫百花掌的所有绝招，help baihua-zhang_flower 则显示百花掌的perform flower的具体信息。\n",
    HIY
  );
  Show(who, "加油加油，你距离成功仅有一步之遥。\n", HIR);
  return 1;
}
