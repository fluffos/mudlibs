#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

void check_food(object who)
{
	if( !who || who->query_level()!=3 )
		return;	
	if( who->query("food")>=who->max_food_capacity() 
	 && who->query("water")>=who->max_water_capacity() )
	{
		Show(who,"当你饮食状态不满的情况下，需要食物和饮水了。你得到了 15000点武学经验 和 三两黄金 。\n",HIG);
		who->add("combat_exp",15000);
		who->money_add(30000);
		who->save();
	}
	else
	{
		seteuid(ROOT_UID);
		who->start_call_out( (: call_other, __FILE__, "check_food", who:),5);
		seteuid(getuid());
	}
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=3 )
		return 0;
	Show(who,"很好很好，继续努力！在没有学习「辟谷术」之前，游戏中人物的饮食掉的是很快的。\n虽然没有饥渴得昏迷的设定，但是当饮食很低的情况下，你的内力和法力会不掉的自动消耗的。现在去客栈中买点食物与饮料补充下你自己吧，相关命令 list、buy、eat、drink 。\n注意，喝酒会导致醉酒！安全第一，买了酒袋后，你可以在客栈使用 fill jiudai 命令来将里面的酒换成清水。\n",HIY);
	seteuid(ROOT_UID);
	who->start_call_out( (: call_other, __FILE__, "check_food", who:),5);
	seteuid(getuid());
	return 1;
}
