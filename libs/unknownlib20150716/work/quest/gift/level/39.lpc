#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=39 )
		return 0;
	if( who->query("giftmark/level_39") )
		return 0;
	who->set("giftmark/level_39",1);
	Show(who,"恭喜恭喜，你现在已经 39 级了，按照「逢九突破」说法，当你的武学经验难以增长时，就需要去完成「40级突破任务」了。\n",HIY);
	Show(who,"当人物等级39级并武学经验>=16100000，可以去询问师门长辈关于「筑基」一事，除了特殊NPC，一般都给你提示：\n筑基有两种途径，一是以各门派炼制的筑基丹来突破修炼瓶颈。\n第二种办法是以五行精华做筑基导引，通过吸取五行精华来突破修炼瓶颈。前者虽然成功率较高，但因靠药力所致，故突破后将不能领悟小神通。后者虽有失败可能，但对自身却也是一种修炼，并且第四次必成功。在突破的过程中，将会领悟五行中的精华而得到一门小神通(cast xiaoshen)。\n通过第一种方法突破，则没有小神通。小神通效果请参阅 help xiaoshen；突破任务请参阅 help tupo40。\n",HIR);
	return 1;
}
