#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=20 )
		return 0;

	Show(who,"恭喜！你现在20级了，接下来除了袁天罡任务，你还可以去接门派任务了。查看本门派的help即可知道发布门派任务的NPC。\n",HIY);
	Show(who,"门派任务可选择 普通、噩梦 两种模式，通过 ask 发布NPC about 噩梦 来切换模式。此任务每十个为一轮。完成一轮追加奖励100门忠。普通模式奖励基数 40级前3000，40级后5000；噩梦模式奖励基数 40级前7000，40级后10000。完成任务获得 武学、潜能、道行、师门贡献。\n",HIR);
	Show(who,"师门贡献用于兑换门派套装、门派法宝、门派突破。\n",HIR);
	Show(who,"另外还有1-39级的「始皇陵一层副本」了。向 薛仁贵 询问「始皇陵」后，在长安城南的始皇陵向东，即进入。副本中掉落丰富的装备、材料。\n绑定后的装备可以通过 zhaohuan 命令来重新得到，下线有效。绑定过的装备可以通过 zhuxiao <ID>或fenjie <ID>来取消绑定，详情请参阅help fenjie。\n",HIY);
	Show(who,"副本详情请参阅「help fuben」。\n",HIR);
	return 1;
}	