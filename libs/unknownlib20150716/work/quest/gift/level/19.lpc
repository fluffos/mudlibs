#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=19 )
		return 0;
	if( who->query("giftmark/level_19") )
		return 0;
	who->set("giftmark/level_19",1);
	Show(who,"恭喜恭喜，你现在已经 19 级了，按照「逢九突破」说法，当你的武学经验难以增长时，就需要去完成「20级突破任务」了。\n",HIY);
	Show(who,"进入方法：19级经验满之后，在室外xiudao，xiudao完成后会自动进入副本。详情请参阅「help tupo20」。\n",HIR);
	return 1;
}
