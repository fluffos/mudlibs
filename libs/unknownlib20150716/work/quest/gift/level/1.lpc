#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

void check_hp(object who)
{
	if( !who )
		return;
	if( who->query_level()!=1 )
		return;
	if( who->query("eff_kee")>=who->query_maxkee() 
	 && who->query("eff_sen")>=who->query_maxsen() )
	{
		Show(who,"当你气血精神状态值不满的情况，需要使用疗伤的丹药。(help statue)。\n你得到了 9000点武学经验 和 3000点潜能 、一两黄金 。\n",HIY);
		Show(who,"你可以去东方武馆和弟子(dizi)切磋(fight)来快速增加武学经验。\n",HIR);
		who->add("combat_exp",9000);
		who->add("potential",3000);
		who->money_add(10000);
		who->set("giftmark/level_1",1);
		who->save();
	}
	else	
	{
		seteuid(ROOT_UID);
		who->start_call_out( (: call_other, __FILE__, "check_hp", who:),5);			
		seteuid(getuid());
	}	
}

int update_level(object who)
{
	object gift,y;
	if( !who || !living(who) || !userp(who)
	 || who->query_level()!=1 )
		return 0;
	if( who->query("giftmark/level_1") )
		return 0;
	seteuid(ROOT_UID);
	who->start_call_out( (: call_other, __FILE__, "check_hp", who:),5);			
	seteuid(getuid());
	Show(who,"欢迎来到 "+MUDLIB_NAME+ " ，现在正式开站了。本站的武学经验类似于RPG中的EXP。如果支持这样的泥巴游戏，请在群(4951331)里给好的建议。\n",HIG);
	if( objectp(y=present("hunyuan dan",who))
	 && base_name(y)=="/d/city/obj/danping" )
		;
	else
	{		 
		gift = new("/d/city/obj/danping");
		gift->set("num",200);
		gift->set("value",0);
		gift->set("owner_id",who->query("id"));
		gift->set("no_give",1);
		gift->set("no_drop",1);
		gift->set("changed",1);
		gift->set("no_get",1);
		if( gift->move(who) )
			Show(who,"游戏快乐，你得到了 "+gift->query("name")+ " 。\n"NOR,HIG);
		else if( gift )  
			destruct(gift);
	}
	if( objectp(y=present("jinchuang yao",who))
	 && base_name(y)=="/d/city/obj/yaoping" )
		;
	else
	{	
		gift = new("/d/city/obj/yaoping");
		gift->set("num",200);
		gift->set("value",0);
		gift->set("no_give",1);
		gift->set("no_drop",1);
		gift->set("changed",1);
		gift->set("no_get",1);
		gift->set("owner_id",who->query("id"));
		if( gift->move(who) )
			Show(who,"游戏快乐，你得到了 "+gift->query("name")+ " 。\n",HIG);
		else if( gift )  
			destruct(gift);
	}
	who->receive_wound("kee",30);
	who->receive_wound("sen",30);
	Show(who,"下面你用"HIR"eat dan"HIY"和"HIR"eat yao"HIY"命令，来治疗下你的精神与气血，然后输入"HIR"hp"HIY"查看你的状态。\n",HIY);
	return 1;	
}
