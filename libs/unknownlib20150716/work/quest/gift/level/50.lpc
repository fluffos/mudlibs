#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=50 )
		return 0;
	if( who->query("giftmark/level_50") )
		return 0;
	who->set("giftmark/level_50",1);
	Show(who,"恭喜恭喜，你现在已经 50 级了，50级之后可以做更多的任务，获得更多的功能。\n",HIY);
	Show(who,"当人物等级50级之后，即开放装备成长系统。\n",HIR);
	Show(who,"你可以通过 set armor_change 和 set weapon_change 命令来设置需要成长的装备。\n",HIR);
	Show(who,"你可以通过 set armor_ratio  和 set weapon_ratio 命令来设置装备成长中每次分配你的经验的百分比。\n",HIR);
	Show(who,"默认情况下，当你50级后，装备着的所有绑定防具、武器会各分配你获得的武学经验的2%作为自身成长经验。\n",HIR);
	Show(who,"要注意的是：\n",HIY);
	Show(who," 1. 只有绑定的防具、武器在装备着的情况下才能获得成长分配经验。\n",HIY);
	Show(who," 2. 分配后剩余的武学经验才是你人物得到的最终经验。\n",HIY);
	Show(who," 3. 你可以通过 set armor_change none 来取消防具分配你的经验。\n",HIY);
	Show(who," 4. 你可以通过 set weapon_change none 来取消武器分配你的经验。\n",HIY);  
	Show(who," 5. 分配比例数值在 1-100 之间，当按照此百分比分配时，如你获得的武学经验不够分配，则将平均分配你获得的武学经验。\n",HIY);
	Show(who," 6. 你可以通过 set armor_change armor,cloth 来设置多个防具分配经验，用 , 隔开。\n",HIY);
	Show(who," 7. 防具、武器成长过程中会遵循「逢九突破」的原则，当防具、武器的等级个位为9时，需要通过完成炼器师的任务来升级。\n",HIY);
	Show(who," 8. 低级装备可以通过升级石来跳过「逢九突破」的限制。\n",HIY);
	Show(who,"另外50级将能使用「芥子袋」，在长安南城客栈的精灵楼，询问炼器师往事如风后，即可通过 zhaohuan bag 命令来获得你的储物袋。\n",HIR);
	return 1;
}
