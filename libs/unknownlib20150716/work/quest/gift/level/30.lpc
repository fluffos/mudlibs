#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=30 )
		return 0;

	Show(who,"恭喜！你现在30级了，接下来除了袁天罡任务和门派任务，你还可以去接杀手任务了。\n任务领取NPC为洛阳「花空烟水流」的 狄风後、或「神侯府书房」的 水舞寒。此任务每十个为一轮，完成一轮噩梦附加奖励一两黄金。普通模式奖励基数 40级前2500，40级后4000；噩梦模式奖励基数 40级前3500，40级后8000。\n完成杀手任务获得 武学、潜能、道行、金钱 奖励。以及公共技能(屏风四扇门、血河诀)学习点数。公共技能请参阅 help public。\n",HIY);
	Show(who,"另外你可以去「大雁塔副本」了，进入条件 人物等级30-39级，副本间隔 30分钟。领取NPC长安化生寺法明长老，副本中掉落 30-39级的普通、金色、蓝色、红色、紫色装备、绑定石以及公共技能(help public)。\n",HIR);
	Show(who,"副本详情请参阅「help fuben」。\n",HIY);
	Show(who,"你可以在师门传授技能的师傅那里领取门派套装了(无底洞请找碧鼠或玉鼠)。套装基本属性请参照 mod all，这里要提醒的是，套装的最终属性是根据装备的等级与套装基本属性而变动的。\n",HIR);
	Show(who,"ask 师傅 about 套装，消耗门忠来兑换套装，装备的个体属性是随机的。你也可以通过 ask 师傅 about 套装升级，来升级套装等级，需要消耗一定的门忠。\n",HIY);
	return 1;
}	