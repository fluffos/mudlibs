#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=49 )
		return 0;
	if( who->query("giftmark/level_49") )
		return 0;
	who->set("giftmark/level_49",1);
	Show(who,"恭喜恭喜，你现在已经 49 级了，按照「逢九突破」说法，当你的武学经验难以增长时，就需要去完成「50级突破任务」了。\n",HIY);
	Show(who,"当人物等级49级并武学经验>=36000000且道行240年，在冥思(meditate)之中被会触发50级突破任务：「初窥神识」了。\n",HIR);
	return 1;
}
