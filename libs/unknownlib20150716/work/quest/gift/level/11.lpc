#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who, string arg, string color) {
  string *msgs, str;
  int i;
  if (!who)
    return;
  if (!arg || !stringp(arg) || strlen(arg) < 2)
    return;
  if (!color || !stringp(color))
    color = HIY;
  arg = COLOR_D->clean_color(arg);
  arg = sort_string(arg, 68, 0);
  msgs = explode(arg, "\n");
  str = "";
  for (i = 0; i < sizeof(msgs); i++)
    str += "【系统】" + msgs[i] + "\n";
  tell_object(who, color + str + NOR);
}

int update_level(object who) {
  object gift;
  if (!who || !living(who) || !userp(who)
    || who->query_level() != 11)
    return 0;
  Show(
    who,
    "人物等级到达11级后，就可以去做「背阴巷副本」了。相关 NPC：长安城李玉娘(送饭)、袁天罡，副本每30分钟可以进一次，奖励武学经验、10-25级的普通、金色、蓝色装备、绑定石。\n绑定后的装备可以通过 zhaohuan 命令来重新得到，下线有效。绑定过的装备可以通过 zhuxiao <ID>或fenjie <ID>来取消绑定，详情请参阅help fenjie。\n",
    HIY
  );
  Show(who, "一般情况下副本地图不会真死，如果气血不满的情况下，你离开了副本，从而导致了死亡，那就算人祸了。\n", HIR);
  Show(who, "副本详情请参阅「help fuben」。\n", HIY);
  return 1;
}
