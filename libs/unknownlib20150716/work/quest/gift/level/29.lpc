#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=29 )
		return 0;
	if( who->query("giftmark/level_29") )
		return 0;
	who->set("giftmark/level_29",1);
	Show(who,"恭喜恭喜，你现在已经 29 级了，按照「逢九突破」说法，当你的武学经验难以增长时，就需要去完成「30级突破任务」了。\n",HIY);
	Show(who,"当人物等级29级并武学经验大于5651000，在【小雁塔副本】中杀死boss即会触发剧情，完成30级突破。详情请参阅「help tupo30」。\n",HIR);
	return 1;
}
