#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=5 )
		return 0;
	if( who->query("giftmark/level_5") )
	{
		Show(who,"现阶段，你除了长安南城客栈的千里眼「送信任务」，暂时还不能接其他任务。你可以继续通过和东方武馆的弟子(dizi)切磋(fight)来快速增加武学经验和潜能。\n",HIY);
		return 1;
	}
	Show(who,"加油加油，你现在已经 5 级了，现在你可以出傲来闯荡了。去找一个心仪的门派(help menpai)拜师吧。拜师之后，你可以通过学习(learn)技能来提高自己的各项技能。如果此期间，你的潜能不够了，你还可以通过和东方武馆的弟子(dizi)切磋(fight)来快速增加潜能，随着人物等级的提升，你的道行、潜能以及后天天赋、寿元的上限会得到提高的。另外，本游戏中，不需要通过打坐、冥思来提高自身的内力、法力上限，当你学会特殊内功、特殊法术，通过激发(enable)相应的技能，内力、法力即自动加满上限。当你的特殊内功、特殊法术升级后，你可以通过 enable force none,enable spells none 后重新激发，来提高内法的上限。\n当你将所有的门派技能学到50级后，可以去傲来武器店向老板打听打听「武器」的事。\n",HIG);
	Show(who,"出了傲来国，在「傲来国西海岸」通过 zuo mufa 命令，来激发海岸木筏，当「一只木筏从海上漂了过来。」后，输入 enter ，进入木筏内，然后当提示「木筏一震，搁浅了。显然是到陆地了，赶紧上去吧。」后，输入 out 命令，从木筏中出来。\n",HIR);
	Show(who,"10级以下，在开封城铁塔处 enter ，可以用fullme来恢复状态。\n",HIG);
	return 1;
}

mixed newbie_gift(object who,object npc)
{
	mapping skill;
	string *types,type,*skills,fam;
	object gift;
	int i;
	
	if( !who || !npc )
		return 0;
	if( who->query_level()!=5 )
		return 0;
	if( !living(npc) )
		return 1;
	if( who->query("giftmark/level_5") )
		return "不是已经给你了吗？";

	if( !mapp(skill = who->query_skills())
	 || sizeof(skill)<1 
	 || !stringp(fam=who->query("family/family_name")) )
	{
		EMOTE_D->do_emote(npc, "addoil",geteuid(who),CYN,0,0,0);
		return RANK_D->query_respect(who)+"，你还是先去拜师，学完技能再来。";
	} 
	type = "unarmed";
	EMOTE_D->do_emote(npc, "wow",geteuid(who),CYN,0,0,0);
	tell_object(who,CYN+npc->name()+CYN"说道：我就知道"+RANK_D->query_respect(who)+"终非池中之物。\n"NOR);
	tell_object(who,CYN+npc->name()+CYN"说道：来来来，我这里有把家传多年的兵刃，放在我这也是暴殄天物。\n"NOR);
	npc->set_temp("weapon_level",5);
	npc->set("env/test","HIB");	
	gift = new("/d/obj/nweapon/"+type);
	gift->init_weapon(npc);
	if( gift->move(who) )
	{
		who->set("giftmark/level_5",1);
		message_vision("$N递给$n一"+gift->query("unit")+gift->name(1)+"。\n",npc,who);
		who->add("combat_exp",20000);
		who->add("daoxing",5000);
		who->money_add(50000);
		Show(who,"你得到了20000点武学经验、五年道行以及五两黄金。\n",HIG);
		who->save();
		return "加油加油。";
	}
	else
	{
		if( gift ) destruct(gift);
		EMOTE_D->do_emote(npc, "sigh",geteuid(who),CYN,0,0,0);
		return RANK_D->query_respect(who)+"，你背包满了吧，试试drop掉一些没用的吧。";
	}
}