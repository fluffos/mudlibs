#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who,string arg,string color)
{
	string *msgs,str;
	int i;
	if( !who )
		return;
	if( !arg || !stringp(arg) || strlen(arg)<2 )
		return;
	if( !color || !stringp(color) )
		color = HIY;
	arg = COLOR_D->clean_color(arg);	
	arg = sort_string(arg,68,0); 
	msgs = explode(arg,"\n");
	str = "";
	for(i=0;i<sizeof(msgs);i++)
		str+= "【系统】"+msgs[i]+"\n";
	tell_object(who,color+str+NOR);	
}

int update_level(object who)
{
	object gift;
	if( !who || !living(who) || !userp(who) 
	 || who->query_level()!=4 )
		return 0;

	Show(who,"很好很好，继续努力！接下来我们了解下游戏的防具设定，毕竟保护好自己才是开心游戏的前提。你可以输入 help armor 命令，来查看防具相关的说明。\n现在去衣帽店向老板打听打听「盔甲」的事吧。\n",HIY);
	return 1;
}

mixed newbie_gift(object who,object npc)
{
	mapping skill;
	string *types,type,*skills,fam;
	object gift;
	int i;
	
	if( !who || !npc )
		return 0;
	if( who->query_level()!=4 )
		return 0;
	if( !living(npc) )
		return 1;
	if( who->query("giftmark/level_4") )
		return "不是已经给你了吗？";

	EMOTE_D->do_emote(npc, "xixi",geteuid(who),CYN,0,0,0);
	tell_object(who,CYN+npc->name()+CYN"说道：我看"+RANK_D->query_respect(who)+"长得一表人才，整天光着身子也不是个法子。\n"NOR);
	npc->set_temp("armor_level",4);
	npc->set("env/test","HIB");	
	gift = new("/d/obj/narmor/armor");
	gift->init_armor(npc);
	if( gift->move(who) )
	{
		who->set("giftmark/level_4",1);
		message_vision("$N递给$n一"+gift->query("unit")+gift->short()+"。\n",npc,who);
		who->add("combat_exp",20000);
		who->money_add(40000);
		Show(who,"你得到了 20000点武学经验 和 四两黄金 。\n",HIG);
		Show(who,"你可以通过 wear "+gift->query("id")+" 命令来装备防具。\n",HIR);
		who->save();
		return "加油加油。";
	}
	else
	{
		if( gift ) destruct(gift);
		EMOTE_D->do_emote(npc, "sigh",geteuid(who),CYN,0,0,0);
		return RANK_D->query_respect(who)+"，你背包满了吧，试试drop掉一些没用的吧。";
	}
}