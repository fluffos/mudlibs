#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

string query_Msg()
{
	string str = HIY+@STR	

	萤玉x1    = 白面粉x20 + 红豆沙x20 + 鸭蛋黄x20 + 白砂糖x20
	碎片x1    = 白面粉x20 + 红豆沙x20 + 白砂糖x20
	门忠x1000 = 白面粉x20 + 鸭蛋黄x20 + 白砂糖x20
	经验x5000 = 白面粉x20 + 白砂糖x20
	
STR+NOR;
	return str;
}

void create()
{
        set_name("白面粉",({"bai mianfen","mian fen"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("base_unit", "个");
                set("long", HIM"中秋活动道具，可以凭此在长安南城客栈找中秋礼物大使兑换称号。"NOR"\n"+query_Msg());
                set("value",0);
	}
     	set_amount(1);
        setup();
}

int is_jieri(){return 1;}