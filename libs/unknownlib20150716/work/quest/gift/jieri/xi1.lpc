#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

string query_Msg()
{
	string str = @STR	
	HIM秋NORxHIY100NOR + WHT幕NORxHIY100NOR + HIG夕NORxHIY100NOR + HIC月NORxHIY100NOR = HIG秋幕夕月NOR
	HIC月NORxHIY100NOR + HIR下NORxHIY100NOR + HIM踌NORxHIY100NOR + HIB躇NORxHIY100NOR = HIR月下踌躇NOR
	HIC月NORxHIY100NOR + HIR下NORxHIY100NOR + HIC捣NORxHIY100NOR + HIM药NORxHIY100NOR = HIC月下捣药NOR 
STR;
	str = COLOR_D->replace_color(str,1);
	return str;
}

void create()
{
        set_name(HIG"夕"NOR, ({"xi"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("base_unit", "个");
                set("long", HIM"中秋活动道具，可以凭此在长安南城客栈找中秋礼物大使兑换称号。"NOR"\n"+query_Msg());
                set("value",0);
		set("no_give",1);
	}
     	set_amount(1);
        setup();
}

int is_jieri(){return 1;}