#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

mapping query_Weapons(){
	return  ([
	"fork"   : "fengbo-cha",
	"unarmed": "dragonfight",
	"hammer" : "huntian-hammer",
	]);
}

void set_skills(int j)
{
	create_family("东海龙宫",3,"");
        set_skill("unarmed", j);
        set_skill("hammer", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
        set_skill("fork", j);
        set_skill("fengbo-cha", j);
        set_skill("dragonstep", j);
        set_skill("dragonfight", j);
        set_skill("dragonforce", j);
        set_skill("seashentong", j);
        set_skill("huntian-hammer", j);

        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("spells", "seashentong");
        map_skill("dodge", "dragonstep");
        map_skill("unarmed", "dragonfight");
        map_skill("hammer","huntian-hammer");
	set("class","dragon");
        set("Weapon","unarmed");
	set("title",HIR"四海"HIY"神君"NOR);
}        