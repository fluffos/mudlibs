#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

mapping query_Weapons() {
  return ([
    "sword": "snowsword",
    "whip": "jueqingbian",
    "unarmed": "NONE",
  ]);
}

void set_skills(int j) {
  create_family("月宫", 3, "");
  set("gender", "女性");
  set_skill("unarmed", j);
  set_skill("dodge", j);
  set_skill("parry", j);
  set_skill("force", j);
  set_skill("spells", j);
  set_skill("sword", j);
  set_skill("whip", j);
  set_skill("jueqingbian", j);
  map_skill("whip", "jueqingbian");
  set_skill("snowsword", j);
  set_skill("moondance", j);
  set_skill("moonshentong", j);
  set_skill("baihua-zhang", j);
  set_skill("moonforce", j);

  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");

  set("class", "xian");
  set("Weapon", "sword");
  set("title", HIW "西域女魔" NOR);
}
