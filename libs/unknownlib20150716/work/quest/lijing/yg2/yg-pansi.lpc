#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

mapping query_Weapons(){
	return  ([
	"sword"  : "qingxia-jian",
	"whip"   : "yinsuo-jinling",
	"unarmed": "NONE",
	]);
}

void set_skills(int j)
{
	create_family("盘丝洞",3,"");
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("sword", j);
        set_skill("qingxia-jian", j);
        map_skill("sword","qingxia-jian");
	set_skill("whip",j);
        set_skill("yinsuo-jinling",j);
        map_skill("whip","yinsuo-jinling");
        set_skill("yueying-wubu", j);
        set_skill("pansi-dafa", j);
        set_skill("lanhua-shou", j);
        set_skill("jiuyin-xinjing", j);

        map_skill("force", "jiuyin-xinjing");
        map_skill("spells", "pansi-dafa");
        map_skill("dodge", "yueying-wubu");
        map_skill("unarmed", "lanhua-shou");

	set("class","yaomo");
	set("title",HIR"碧游旧人"NOR);	
}
