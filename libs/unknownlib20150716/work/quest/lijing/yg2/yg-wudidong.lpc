#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

mapping query_Weapons(){
	return  ([
	"sword"  : "qixiu-jian",
	"blade"  : "kugu-blade",
	"unarmed": "NONE",
	]);
}

void set_skills(int j)
{
	create_family("陷空山无底洞",3,"");	
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("blade", j);
        set_skill("kugu-blade", j);
        map_skill("blade", "kugu-blade");
        set_skill("sword",j);
        set_skill("qixiu-jian",j);
        map_skill("sword", "qixiu-jian");
        set_skill("lingfu-steps", j);
        set_skill("yaofa", j);
        set_skill("huntian-qigong", j);
        set_skill("yinfeng-zhua", j);
        map_skill("force", "huntian-qigong");
        map_skill("spells", "yaofa");
        map_skill("dodge", "lingfu-steps");
        map_skill("unarmed", "yinfeng-zhua");
	set("class","yaomo");
	
	set("title",HIR"七煞魔君"NOR);	
}
