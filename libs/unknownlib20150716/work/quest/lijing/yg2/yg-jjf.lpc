#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

mapping query_Weapons(){
	return  ([
	"spear"  : "bawang-qiang", 
	"unarmed": "NONE",
	"axe"    : "sanban-axe",
	"mace"   : "jinglei-mace",
	]);
}

void set_skills(int j)
{
	create_family("将军府",3,"");
	set("family/master_id","lao ren");
				
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("spear", j);
	set_skill("mace", j);
	set_skill("jinglei-mace", j);
	map_skill("mace","jinglei-mace");
        set_skill("bawang-qiang", j);
        map_skill("spear","bawang-qiang");
	set_skill("axe",j);
        set_skill("sanban-axe",j);
        map_skill("axe","sanban-axe");
        set_skill("yanxing-steps", j);
        set_skill("changquan", j);
        set_skill("lengquan-force", j);
        set_skill("baguazhou", j);
        map_skill("force", "lengquan-force");
        map_skill("spells", "baguazhou");
        map_skill("dodge", "yanxing-steps");
        map_skill("unarmed", "changquan");
	set("class","fighter");
	set("title",HIR"塞外叛将"NOR);	
}
