#include <ansi.h>
inherit __DIR__"yaoguai.c";

static string *msg1 = ({
	"霹雳一声，",
	"一声巨响，",
});

static string *msg2 = ({
	"闪电划破长空，",
	"一道银蛇划破苍穹，",
	"一道长虹扫过天空，",
});

static string *msg3 = ({
	"从天而降，飞入",
	"大放异彩，落入了",
	"挟云带雾，突现在",
	"呜呜作响，出现在",
});

static string *msg4 = ({
	"的手中！\n",
	"的掌中！\n",
});

mixed change_enable()
{
	object dao,jian,weapon,me=this_object();
	string color,*msgs,str="";
	if( !environment() )
		return 0;

	if( !objectp(jian=query("Weapon1"))
	 || !present(jian,me) )
	{
		jian=carry_object(0,"sword",1);
		jian->set("weapon_title",query("name"));
		set("Weapon1",jian);
		color = ({HIR,HIM,HIG,HIW,HIC,HIR})[random(6)];
		str+= color+msg1[random(sizeof(msg1))]+msg2[random(sizeof(msg2))]+"「"+jian->query("name")+color+"」"+msg3[random(sizeof(msg3))]+msg4[random(sizeof(msg4))];
	}
	if( !objectp(dao=query("Weapon2"))
	 || !present(dao,me) )
	{
		dao=carry_object(0,"blade",1);
		dao->set("weapon_title",query("name"));
		set("Weapon2",dao);
		color = ({HIR,HIM,HIG,HIW,HIC,HIR})[random(6)];
		str+= color+msg1[random(sizeof(msg1))]+msg2[random(sizeof(msg2))]+"「"+dao->query("name")+color+"」"+msg3[random(sizeof(msg3))]+msg4[random(sizeof(msg4))];
	}
	
	if( !objectp(weapon=me->query_temp("weapon")) )
	{
		if( jian->wield() )
		{
			str+= me->name()+"装备"+jian->name()+"。\n";
			map_skill("parry", "bainiao-jian");
			reset_action();
			if( str!="" )
				message("vision",str,environment());
			return jian;
		}
		else if( dao->wield() )
		{
			str+= me->name()+"装备"+dao->name()+"。\n";
			map_skill("parry", "bingpo-blade");
			reset_action();
			if( str!="" )
				message("vision",str,environment());
			return dao;			
		}
		else	
		{
			if( str!="" )
				message("vision",str,environment());
			return 0;	
		}
	}
	else
	{
		if( weapon->unequip() )
		{
			str+= me->name()+"放下手中的"+weapon->name()+"。\n";
			if( weapon==jian )
			{
				if( dao->wield() )
				{
					str+= me->name()+"装备"+dao->name()+"。\n";
					map_skill("parry", "bingpo-blade");
					reset_action();
					if( str!="" )
						message("vision",str,environment());
					return dao;			
				}
				else	
				{
					if( str!="" )
						message("vision",str,environment());
					return 0;
				}	
			}
			else	
			{
				if( jian->wield() )
				{
					str+= me->name()+"装备"+jian->name()+"。\n";
					map_skill("parry", "bainiao-jian");
					reset_action();
					if( str!="" )
						message("vision",str,environment());
					return jian;			
				}
				else	
				{
					if( str!="" )
						message("vision",str,environment());
					return 0;
				}	
			}
		}
		else	
		{
			if( str!="" )
				message("vision",str,environment());
			return weapon;
		}
	}
}

void set_skills(int j)
{
	object ob;
	create_family("大雪山",3,"");
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("blade", j);
        set_skill("bingpo-blade", j);
        map_skill("blade", "bingpo-blade");
	set_skill("sword",j);
	set_skill("bainiao-jian",j);
	map_skill("sword", "bainiao-jian");
        
	map_skill("parry", "bainiao-jian");

        set_skill("xiaoyaoyou", j);
        set_skill("dengxian-dafa", j);
        set_skill("ningxie-force", j);
        set_skill("cuixin-zhang", j);
        map_skill("force", "ningxie-force");
        map_skill("spells", "dengxian-dafa");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("unarmed", "cuixin-zhang");
	set("class","yaomo");
	set("title",HIW"狮驼妖将"NOR);

	if( objectp(ob=carry_object(0,"sword",1)) )
	{
		ob->set("weapon_title",query("name"));
		ob->wield();
		set("Weapon1",ob);
	}
	if( objectp(ob=carry_object(0,"blade",1)) )
	{
		ob->set("weapon_title",query("name"));
		set("Weapon2",ob);
	}
}       