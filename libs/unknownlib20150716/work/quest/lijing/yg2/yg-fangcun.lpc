#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

mapping query_Weapons(){
	return  ([
	"unarmed"  : "NONE",
	"stick"    : "qianjun-bang",
	]);
}

void set_skills(int j)
{
	create_family("方寸山三星洞",3,"");
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("stick", j);
	//set_skill("sword", j);
	//set_skill("liangyi-sword", j);
        set_skill("qianjun-bang", j);
        map_skill("stick","qianjun-bang");
        //map_skill("sword","liangyi-sword");
        map_skill("parry", "qianjun-bang");
        set_skill("jindouyun", j);
        set_skill("wuxiangforce", j);
        set_skill("puti-zhi", j);
        set_skill("dao", j);
        map_skill("force", "wuxiangforce");
        map_skill("spells", "dao");
        map_skill("dodge", "jindouyun");
        map_skill("unarmed", "puti-zhi");
	set("class","taoist");
	set("Weapon","stick");
	set("title",HIR"三山大圣"NOR);
}