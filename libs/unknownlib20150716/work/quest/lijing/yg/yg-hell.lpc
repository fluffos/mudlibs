#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j)
{
	create_family("阎罗地府",3,"");
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("whip", j);
        set_skill("hellfire-whip", j);
        map_skill("whip", "hellfire-whip");
	set_skill("stick",j);
        set_skill("kusang-bang",j);
        map_skill("stick","kusang-bang");
	set_skill("sword",j);
	set_skill("zhuihun-sword",j);
	map_skill("sword","zhuihun-sword");

 	switch(random(4))
 	{
 		case 0 : 
 			map_skill("parry", "hellfire-whip");
 			set("Weapon","whip");
			break;
		case 1 :	
        		map_skill("parry","kusang-bang");
        		set("Weapon","stick");
			break;
		default :
        		map_skill("parry","zhuihun-sword");
        		set("Weapon","sword");
			break;
	}				
        set_skill("ghost-steps", j);
        set_skill("jinghun-zhang", j);
        set_skill("tonsillit", j);
        set_skill("gouhunshu", j);
        map_skill("force", "tonsillit");
        map_skill("spells", "gouhunshu");
        map_skill("dodge", "ghost-steps");
        map_skill("unarmed", "jinghun-zhang");
	set("class","ghost");
	set("title",HIR"荒野孤魂"NOR);
}