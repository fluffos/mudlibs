#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j)
{
	create_family("五庄观",3,"");
        set_skill("unarmed", j);
        set_skill("dodge", j);
        set_skill("parry", j);
        set_skill("force", j);
        set_skill("spells", j);
	set_skill("hammer", j);
        set_skill("kaishan-chui", j);
        map_skill("hammer","kaishan-chui");
	set_skill("sword",j);
        set_skill("sanqing-jian",j);
	set_skill("blade",j);
        set_skill("yange-blade",j);
        map_skill("blade","yange-blade");
	set_skill("xiaofeng-sword",j); 
	
 	switch(random(5))
 	{
 		case 0 :
        		map_skill("parry","kaishan-chui");
        		set("Weapon","hammer");
        		break;
        	case 1 :
        		map_skill("sword","sanqing-jian");        	
        		map_skill("parry","sanqing-jian");
        		set("Weapon","sword");
        		break;
        	case 2 :
        		map_skill("parry","yange-blade");
        		set("Weapon","blade");
        		break;
        	default :
        		map_skill("sword","xiaofeng-sword");
        		map_skill("parry","xiaofeng-sword");
        		set("Weapon","sword");
        		break;
        }				
        set_skill("baguazhen", j);
        set_skill("taiyi", j);
        set_skill("wuxing-quan", j);
        set_skill("zhenyuan-force", j);

        map_skill("force", "zhenyuan-force");
        map_skill("spells", "taiyi");
        map_skill("dodge", "baguazhen");
        map_skill("unarmed", "wuxing-quan");
	set("class","xian");
	set("title",HIC"地仙门下"NOR);
}
