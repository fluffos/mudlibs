string job_type(){ return "李靖任务";}

int random_place(object me, string* dirs);
varargs void leave(int);

void setname()
{
	mapping name = NAME_D->random_name("yaoguai");
	set_name(name["name"],name["id"]);
	set("gender",random(2)?"男性":"女性");
}

int cast_chance(int level) 
{
	return 5+level/3;
}

void create()
{
	setname();
	set_level(80);	
	set("chat_chance", 1+this_object()->query_level()/5);
	set("chat_msg", ({
        	(: random_move :)
	}) );
	set("chat_chance_combat",2+this_object()->query_level()/3);
	set("age", 20+random(80));
	set("attitude", "heroism");
	setup();
}

int random_move()
{
	if( this_object()->is_fighting() 
	 || time()<this_object()->query_temp("last_move")+5 )
		return 0;
	set_temp("last_move",time());	
	return ::random_move();	
}

void set_skills(int j){ }

//me=NPC ob=owner lv=job_level
int copy_status(object me,object ob, int lv)
{
	int i, lvl,k,level,v,max_skill;
	int base = 20;
	string file,*files;
	mapping skill;
	string *skills;
	object obj;
	
	lvl = lv+base-5;

	if( !ob || !living(ob) )
		return 0;
	level = ob->query_level();
	v = 9-last_num(level);
	if( v>1 )
		level+= random(v);
	me->set_level(level);
	max_skill = level*10;
	max_skill = max_skill*4/5; 
	max_skill = max_skill*lvl/base;
	set_skills(max_skill);	
	set("bellicosity",ob->query("bellicosity")/3*2+1);	
	setup();
	set("force",me->query_maxforce()*2);
	set("mana",me->query_maxmana()*2);
	set("force_factor",me->query_maxforce()/20+1);
	set("mana_factor",me->query_maxmana()/20+1);
	set("looking", HIC"一副道貌岸然的模样"NOR"。");
	set("rank_info/pos_msg", HIB"浑身隐约笼罩着一层斑驳玄气"NOR"。\n");
	v = 20-lvl;
	if( v<1 )
		v = random(3)+1;
	set("npc_pfm",v);
	set("npc_cast",v);
	if( lv>=9 )
		set("env/test","HIM");
	else if( lv>7 )
		set("env/test","HIR");
	else	set("env/test","HIB");
	files = ({
		"armor","cloth","hand","kui","pifeng","neck","ring",
		"shoes","wrists","waist",
	});
	for(i=0;i<sizeof(files);i++)
	{
		obj = carry_object(0,files[i],1);
		obj->set("armor_title",this_object()->query("name"));
		obj->wear();
	}
	if( !stringp(file = query("Weapon") ) )
		file = "unarmed";
	obj = carry_object(0,file,1);	
	obj->set("weapon_title",this_object()->query("name"));
	obj->wield();
	add_temp("apply/combat_damage",3000);
	add_temp("apply/spells_damage",2500);
	add_temp("apply/combat_def",3000);
	add_temp("apply/spells_def",2500);
	powerup();	
	return 1;
}

int random_place(object me, string* dirs)
{
	int i,j,k;
	object newob;
	mixed *file, exit;

	if( !sizeof(dirs) )
        	return 0;
	if( !me || !living(me) )  
		return 0;
	i = random(sizeof(dirs));    // pick up one directory
	file = get_dir( dirs[i]+"/*.lpc", -1 );
	if( !sizeof(file) )
        	return 0;
	reset_eval_cost();
	for(k=0;k<20;k++)  // try 20 times
        {
        	j = random(sizeof(file));
        	if( file[j][1]>0 ) 
                {
                	newob=load_object(dirs[i]+"/"+file[j][0]);
                	if( newob ) 
                        {  
                        	if( newob->query("no_fight") || newob->query("no_magic") 
	                          || newob->query("no_mieyao") || !(exit=newob->query("exits")) 
        	                  || sizeof(exit)<1 )
                	                continue;
                        	if( me && me->move(newob,1) ) 
				{
        	                        message_vision("$N走了过来。\n",me);
                	                return 1;
                        	}
			}
                }
        }
	return 0;
}

varargs void leave(int v)
{
	if( environment() && !v )
               	message("vision",HIB"\n" + name() + HIB"身子一晃，变成一股青烟散去了。\n" NOR,environment());
       	this_object()->move("/obj/empty");
       	REMOVE_D->add_obj(this_object(),1);
}

string invocation(object who, int level)
{
	object me = this_object();
	if( !who )  
		return 0;
	if( !copy_status(me,who, level) )
	{
		leave();
		return 0;
	}
	return _invocation(who, level);
}

string _invocation(object who, int level)
{       
	object me = this_object(), env;
	string *dirs,where,long; 
	int lv, i, p,lvl;
    
	dirs = dirs1;
	set("owner", who->query("id"));
	set("owner_ob", who);
	{
        	long = "一只"+query("name")[0..<3]+"，在"+({"深山中","密林中","野外","草原上","野林中","高山中","莽林中","莽原上","深谷中",})[random(9)];
        	long+= "汲取"+({"日月","天地","万物"})[random(3)]+"精华，颇有了些道行。\n";
        	set("long",long);
		lv = me->query_level();
		if( lv<95 )
			long = "百年";
		else if( lv<100 )
			long = CYN"百年"NOR;
		else if( lv<105 )
			long = HIC"百年"NOR;
		else if( lv<110 )
			long = HIY"百年"NOR;
		else if( lv<115 )
			long = HIW"百年"NOR;
		else if( lv<120 )
			long = HIM"千年"NOR;
		else if( lv<130 )
			long = HIM"万年"NOR;
		else if( lv<150 )
			long = HIR"万年"NOR;
		else	long = RED"万年"NOR;
		set("title",long+(query("title")?query("title"):""));
        }
	lvl = level;
	i = random(800);
	if( i<10 ) 
        	set("type","aggressive");
	else if( i<20 )
        	set("type","blocker");
	else if(i<220)
        	set("type","aggressive_on_owner");
	else if(i<320)
        	set("type","aggressive_on_owner1");
	else    set("type","normal");
	if( random(10)==0 ) 
        {
        	set("env/wimpy",50);
        	if( lvl<11 ) 
                	lvl=lvl+1; // as more difficult to kill.
        } 
	else    set("env/wimpy",10);

	if( !random_place(me, dirs) ) 
        {
        	leave();
        	return 0;
        }
        
        if( who->query_level()<95 || (wizardp(who) && who->query("env/test")) )
        	exp_reward = 15000;
        else	exp_reward = 18000;
	if( wizardp(who) )
		tell_object(who,sprintf(REV HIW"【李靖】当前为%d/10，经验基数%d"NOR"\n",level,exp_reward));        	
	exp_reward = exp_reward*(lvl+8)/10;
	exp_reward = exp_reward*9/10+random(exp_reward/10);
	pot_reward = exp_reward/(2+random(2))+1;

	env = environment(me);
	where=me->short(1);
	if( env )
        	where+="在"+MISC_D->find_place(env);
	if( wizardp(who) )
		tell_object(who,sprintf(REV HIW"【李靖】生成后经验基数%d,潜能基数%d"NOR"\n",exp_reward,pot_reward));        	
	return where;
}

int accept_money (object who, int v)
{
	object me;
	me = this_object();
	if( v<100000 )
        {
        	message_vision ("$N一瞪眼：就这点东西？不想活了？？？\n", me);
        	return 1;
        }
	who->set_temp("mieyao/allow_to_go", 1);
	message_vision ("$N嘿嘿嘿几声怪笑：算你走运，快滚！"+"可别让我再看见你！\n",me);
	return 1;
}

void init()
{
	object me=this_object(),who=this_player(),env=environment(me);
	string type;
	if( !userp(who) || !living(me) ) 
        	return;
	::init();   
	if( me->is_fihgting() )
		return;
	if( env->query("no_fight")
	 || env->query("no_magic") )
	{
		random_move();
	 	return;
	}
	type = query("type");
	switch (type) 
        {
        	case "aggressive": 
                {
                	object leader=query_leader();
                	if( leader && present(leader, environment(me)) ) 
                        {
                        	if( !is_fighting() )   
                        		kill_ob(leader);
                        	break;
                        }
                        if( COMBAT_D->check_level(me,who)==1 )
                        	break;
                	set_follow(who);
                	message_vision("$N盯着$n，馋得直流口水：嘿嘿．．．\n",this_object(), who);
                	kill_ob(who);
                	break;
                }
        	case "aggressive_on_owner1":
                	if( query("owner")==this_player()->query("id") ) 
                        {
                        	if( !announced ) 
                                {
                                	message_vision("$N看见$n，大叫一声：哈哈，送上门来的肉！\n",this_object(), who);
                                	announced=1;
                                }
                        	kill_ob(this_player());
                        	if( random(4)>0 )
                                	set_follow(who);
                        	else    set_follow(0);
                        	this_player()->kill_ob(this_object());
                        }
                	break;
        	case "aggressive_on_owner":
                	if( query("owner")==this_player()->query("id") ) 
                        {
                        	if( !announced ) 
                                {
	                                message_vision("$N看见$n，大叫一声：哈哈，送上门来的肉！\n",this_object(), who);
        	                        announced = 1;
                                }
                	        kill_ob(this_player());
                        	this_player()->kill_ob(this_object());
                        }
                	break;
        	case "blocker": 
                	{
                		add_action("do_block","",1);
                		break;
                	}
        }
}

int do_block(string arg)
{   
	object me=this_object(),who=this_player();
	string verb=query_verb();
	int t;
    
	if( wizardp(who) && !visible(who) ) 
        	return 0;
	if( me->is_fighting() ) 
        	return 0;
	if( verb!="go" && verb!="fly" && verb!="move"
  	&& !(environment() && environment()->query("exits/" + verb)) )
        	return 0;
	if( who->query_temp("mieyao/allow_to_go") ) 
        {
        	who->delete_temp("mieyao/allow_to_go");
        	who->delete_temp("mieyao/leave_time");
        	return 0;
        }
	t = who->query_temp("mieyao/leave_time");
	if(t>0 && time()>t) 
        {
        	who->delete_temp("mieyao/leave_time");
        	message_vision("$n乘$N一个不注意，急忙溜了过去。\n",me,who);
        	return 0;
        }
	if(t==0) 
        {
        	t=time()+30+random(90);
        	who->set_temp("mieyao/leave_time",t);
        	message_vision("$N猛地跳过来拦在$n面前，高声叫道：\n\t\t此山是我开，此树是我栽！\n\t\t要打此路过，留下买路财！\n\n",me,who);
        } 
	tell_object(who,me->name()+"一把抓住了你！\n");
	return 1;
}

void die()
{
	object weapon,owner_ob,me=this_object(),dropitem;
	string owner,skill,str,msg;
	int i,j,lv,exp_r, pot_r,dx_r;

	all_inventory(environment())->remove_killer(me);
	me->remove_all_killer();
	me->powerup();
	
	owner = query("owner");
	if( !owner || !stringp(owner) || !objectp(owner_ob=find_player(owner)) )
        {
        	msg = death_msg[random(sizeof(death_msg))];
        	msg = replace_string(msg,"$N","李靖");
        	msg = replace_string(msg,"$n","$N");
        	message_vision(msg,me);
        	leave(1);
        	return;
        }       
	if( environment(owner_ob)==environment() 
  	&& living(owner_ob) && owner_ob==query_temp("last_damage_from") )
        {
        	msg = death_msg[random(sizeof(death_msg))];
        	msg = replace_string(msg,"$n",me->name());
        	msg = COLOR_D->replace_color(HIB+COLOR_D->clean_color(msg),1);
		message_vision(msg,owner_ob,this_object());
                exp_r = exp_reward;
        	pot_r = pot_reward;
		dx_r = exp_reward*4/5+random(exp_reward/5);
        } 
	else    
	{
        	message_vision("$N死了。\n",this_object());
        	exp_r=0;
        	pot_r=0;
        	dx_r=0;
        }
//Debug
        delete("owner");
        lv = owner_ob->query_job_level(job_type());
	QUEST_D->job_reward_player(owner_ob,"combat_exp",exp_r,job_type());
	QUEST_D->job_reward_player(owner_ob,"daoxing",pot_r,job_type());
	QUEST_D->job_reward_player(owner_ob,"potential",dx_r,job_type());
	QUEST_D->job_reward_player(owner_ob,"money",20000,job_type());
	tell_object(owner_ob,HIY+owner_ob->finish_job(job_type(),({exp_r,dx_r,pot_r,20000}))+NOR);
	if( exp_r>0 
	 && ( lv==9 || (lv==10&&random(3)==1) ) )
        {
        	if( stringp(skill = give_reward(owner_ob))
        	 && skill!="none" )
                {
                	msg = "听说"+ owner_ob->query("name")+ HIM"的"HIC+ to_chinese(skill)+ HIM"又有所进境了！\n"NOR;
                	CHANNEL_D->do_channel(me,"rumor",msg);
                }
        }
        if( lv==10 && exp_r>0 ) 
        {
        	owner_ob->add_temp("mark/lijing_job",1);
        	tell_object(owner_ob,HIY"【系统】李靖任务：恭喜，你已经完成了 "HIR+chinese_number(owner_ob->query_temp("mark/lijing_job"))+" 轮任务。"NOR"\n");
        	owner_ob->add("inventory/suipian",20);
        	tell_object(owner_ob,HIG"【系统】你得到了 20块 装备碎片的附加奖励。"NOR"\n");
                owner_ob->money_add(30000);
                tell_object(owner_ob,"你得到了三两"HIY"黄金"NOR"的奖励。\n");
	}        	
	leave(1);
}

void heart_beat()
{
        object who,invoker,target,*enemy,me = this_object();
        string str;
        int k,i;
        if( !environment() )  
                return;
	if( !objectp(who=query("owner_ob")) || !living(who) )
	{
		all_inventory(environment())->remove_killer(me);
		me->remove_all_killer();
		command("chat* haha");
		leave();
	}
	clean_up_enemy();
	
	if( me->is_fighting() )
	{
		enemy = me->query_enemy();
		for(i=0;i<sizeof(enemy);i++)
		{
			invoker = 0;
			if( !userp(enemy[i]) 
			 && objectp(invoker = enemy[i]->query_temp("invoker")) 
			 && userp(invoker) )
			{
				if( !living(invoker) || !invoker->is_fihgting(me) )
				{
					enemy[i]->remove_killer(me);
					me->remove_killer(enemy[i]);
				}	
			}
		}		
	}                
                
        if( living(me) && (int)me->query_busy()>2 )
	{
        	if( !me->is_fighting() )
        	{
                	if( query("eff_kee") < this_object()->query_maxkee()
                         || query("kee") < query("eff_kee") 
                         || query("sen") < query("eff_sen") 
                         || query("eff_sen") < this_object()->query_maxsen() )
				this_object()->powerup(1,0);
        	}
        	else
        	{
        		if( time()>=(me->query_temp("no_exert/start")+me->query_temp("no_exert/time")) )
        		{
        			if( query("eff_kee") < this_object()->query_maxkee() )
		                	QUEST_D->addEffKee(me);
		        	if( query("eff_sen") < this_object()->query_maxsen() )
                			QUEST_D->addEffSen(me);
			}		                	
		        if( query("kee") < query("eff_kee") )
                		QUEST_D->addKee(me);
		        if( query("sen") < query("eff_sen") )
                		QUEST_D->addSen(me);
                }
        }
        if( living(me) && !me->is_busy() 
         && !me->is_blind()
         && !me->is_hunluan() 
         && me->is_fighting() )
	{
		if( random(5)==1 )
			command("cast xiaoshen");
		if( objectp(query_temp("weapon")) )
                	str = query_temp("weapon")->query("skill_type");
		else	str = "unarmed";
		if( intp(k=query("npc_pfm"))
		 && k>0 )
		{
			if( random(k)==0 )
        			QUEST_D->randomPfm(this_object(),str);
        	}
		if( intp(k=query("npc_cast"))
		 && k>0 )
		{
			if( random(k)==0 )
        			QUEST_D->randomCast(this_object());
        	}
	}
	::heart_beat();	
}

void kill_ob(object who)
{
	if( userp(who) && query("owner_ob")
	 && query("owner_ob")!=who )
	{
		message_vision("\n"HIR"$N"HIR"将眼一瞪，冲着$n"HIR"喝道：不想死的就滚！\n\n"NOR,this_object(),who);
		this_object()->remove_killer(who);
		who->remove_killer(this_object());
		return;
	}
	::kill_ob(who);
}
