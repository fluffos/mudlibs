#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j)
{
	create_family("南海普陀山",3,"");
	set_skill("unarmed", j);
	set_skill("dodge", j);
	set_skill("parry", j);
	set_skill("force", j);
	set_skill("spells", j);
	set_skill("staff", j);
	set_skill("lunhui-zhang", j);
	map_skill("staff", "lunhui-zhang");
	set_skill("blade", j);
	set_skill("cibeidao", j);
	map_skill("blade", "cibeidao");
	
	switch(random(3))
	{
		case 1 :  
        		map_skill("parry", "lunhui-zhang");
			set("Weapon","staff");
			break;
		default :
        		map_skill("parry", "cibeidao");
        		set("Weapon","blade");
			break;
	}				
	set_skill("lotusmove", j);
	set_skill("buddhism", j);
	set_skill("jienan-zhi", j);
	set_skill("lotusforce", j);
	map_skill("force", "lotusforce");
	map_skill("spells", "buddhism");
	map_skill("dodge", "lotusmove");
	map_skill("unarmed", "jienan-zhi");
	set("class","bonze");
	set("title",HIR"欢喜邪僧"NOR);
}
