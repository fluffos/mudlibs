#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j) {
  create_family("火云洞", 4, "");
  set_skill("unarmed", j);
  set_skill("dodge", j);
  set_skill("parry", j);
  set_skill("force", j);
  set_skill("spells", j);
  set_skill("moyun-shou", j);
  set_skill("moshenbu", j);
  set_skill("huomoforce", j);
  set_skill("pingtian-dafa", j);
  set_skill("dali-bang", j);
  set_skill("stick", j);
  map_skill("stick", "dali-bang");
  set_skill("spear", j);
  set_skill("wuyue-spear", j);
  map_skill("spear", "wuyue-spear");
  set_skill("huoyun-qiang", j);

  switch (random(3)) {
    case 0:
      map_skill("parry", "dali-bang");
      set("Weapon", "stick");
      break;
    case 1:
      map_skill("spear", "huoyun-qiang");
      map_skill("parry", "huoyun-qiang");
      set("Weapon", "spear");
      break;
    default:
      map_skill("parry", "wuyue-spear");
      set("Weapon", "spear");
      break;
  }
  map_skill("force", "huomoforce");
  map_skill("parry", "dali-bang");
  map_skill("spells", "pingtian-dafa");
  map_skill("dodge", "moshenbu");
  map_skill("unarmed", "moyun-shou");
  set("class", "yaomo");
  set("title", HIY "积雷洞主" NOR);
}
