inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  create_family("将军府", 4, "");
  set("title", "将军府叛将");
  set_skill("unarmed", j);
  set_skill("dodge", j);
  set_skill("parry", j);
  set_skill("force", j);
  set_skill("spells", j);
  set("chat_chance_combat", 1 + 2 * level);
  set_skill("axe", j);
  set_skill("spear", j);
  set_skill("mace", j);
  set_skill("jinglei-mace", j);
  set_skill("wusi-mace", j);
  set_skill("sanban-axe", j);
  set_skill("bawang-qiang", j);
  map_skill("spear", "bawang-qiang");
  map_skill("axe", "sanban-axe");
  switch (random(3)) {
    case 0:
      map_skill("parry", "bawang-qiang");
      carry_object(0, "spear", random(10))->wield();
      set("chat_msg_combat", ({
        (: perform_action, "spear", "bugong" :),
        (: perform_action, "spear", "huima" :),
        (: perform_action, "spear", "juming" :),
      }));
      break;
    case 1:
      map_skill("parry", "sanban-axe");
      carry_object(0, "axe", random(10))->wield();
      set("chat_msg_combat", ({
        (: perform_action, "axe", "kai" :),
        (: perform_action, "axe", "pidi" :),
        (: perform_action, "axe", "sanban" :),
        (: perform_action, "axe", "jiushi" :),
      }));
      break;
    default:
      map_skill("parry", "jinglei-mace");
      carry_object(0, "mace", random(10))->wield();
      set("chat_msg_combat", ({
        (: perform_action, "mace", "jinglei" :),
        (: perform_action, "mace", "tiancheng" :),
      }));
      break;
  }
  set_skill("yanxing-steps", j);
  set_skill("changquan", j);
  set_skill("lengquan-force", j);
  set_skill("baguazhou", j);

  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("dodge", "yanxing-steps");
  map_skill("unarmed", "changquan");
  setup();
  carry_object(0, "armor", random(10))->wear();
  carry_object(0, "cloth", random(10))->wear();
  carry_object(0, "pifeng", random(10))->wear();
  carry_object(0, "kui", random(10))->wear();
  carry_object(0, "shoes", random(10))->wear();
  set("env/wimpy", 0);
  set("class", "fighter");
  powerup(0, 1);
}
