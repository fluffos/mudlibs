//门派auto_pfm
#include <ansi.h>

void attack_action(object me, object victim, object weapon, int damage) {
  if (!me || !victim || !me->is_killing(victim->query("id")))
    return;
  if (me->query("force") < 80)
    return;
  if (!me->query_temp("pfm_action"))
    return;
  switch (me->query_temp("pfm_action")) {
    case "lg_dhwl": ("/daemon/class/dragon/fengbo-cha/dhwl.lpc")->dhwl(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "xs_ningxie": ("/daemon/class/xueshan/bingpo-blade/ningxie.lpc")->ningxie_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wdd_zxzx": ("/daemon/class/wdd/qixiu-jian/zxzx.lpc")->zxzx(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "hyd_fire": ("/daemon/class/kusong/huoyun-qiang/ji.lpc")->fire(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "psd_wang": ("/daemon/class/pansi/yinsuo-jinling/wang.lpc")->wang(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "puti_stlb": ("/daemon/class/fc/dao/stlb.lpc")->stlb(me, victim, weapon, damage); break;
    case "wzg_lpf": ("/daemon/class/zhenyuan/fumo-zhang/luan.lpc")->luanpifeng(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "putuo_fire": ("/daemon/class/putuo/lunhui-zhang/fire.lpc")->fire_attack(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_LGBD": ("/daemon/class/spells/40/木/阳/4.lpc")->thunder_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_JSH": ("/daemon/class/spells/40/土/阳/4.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_jianshiyu": ("/daemon/class/spells/40/土/阳/6.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_JSzhui": ("/daemon/class/spells/40/土/阴/4.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wzg_luanpifeng": ("/daemon/class/wzg/fumo-zhang/luan.lpc")->luanpifeng(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wzg_sanqing": ("/daemon/class/wzg/taiyi/sanqing.lpc")->sanqing(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wzg_baxian": ("/daemon/class/wzg/taiyi/baxian.lpc")->baxian(
      me,
      victim,
      weapon,
      damage
    ); break;
    default: return;
  }
}

void attack_cast_action(object me, object victim, object weapon, int damage) {
  if (!me || !victim || !me->is_killing(victim->query("id")))
    return;
  if (me->query("mana") < 100)
    return;
  if (!me->query_temp("cast_action"))
    return;
  switch (me->query_temp("cast_action")) {
    case "XST_LGBD": ("/daemon/class/spells/40/木/阳/4.lpc")->thunder_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_JSH": ("/daemon/class/spells/40/土/阳/4.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_jianshiyu": ("/daemon/class/spells/40/土/阳/6.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "XST_JSzhui": ("/daemon/class/spells/40/土/阴/4.lpc")->stone_result(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wzg_sanqing": ("/daemon/class/wzg/taiyi/sanqing.lpc")->sanqing(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "wzg_baxian": ("/daemon/class/wzg/taiyi/baxian.lpc")->baxian(
      me,
      victim,
      weapon,
      damage
    ); break;
    case "puti_stlb": ("/daemon/class/fc/dao/stlb.lpc")->stlb(me, victim, weapon, damage); break;
    default: return;
  }
}
