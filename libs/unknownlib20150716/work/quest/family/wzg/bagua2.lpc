#include <ansi.h>
inherit ITEM;

int step = 0;

void create()
{
        set_name("铁八卦", ({"tie bagua","bagua",}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("long","镇元大仙的信物，拿着他去东海龙宫向龙王敖广问个究竟。\n");
                set("material", "iron");
        }
        setup();
}

void dest_ob()
{
	object env = environment();
	remove_call_out("dest_ob");
	if( env )
	{
		if(env->is_character()) 
    		{ 
      			tell_object(env,"天上忽然传来一声断喝：还我"+this_object()->query("name")+"来！\n");
      			tell_object(env,"只见"+this_object()->query("name")+"凌空而去，霎时间不见了踪影。\n");  
    		} 
    		else 	tell_object(env,this_object()->query("name")+"钻进地里，霎时间不见了踪影。\n");	
    	}
    	destruct(this_object());	
}

void init()
{
	if( environment()
	 && this_object()!=this_player()->query_temp("pendding/wzg_askob2") )
	{
		call_out("dest_ob",3);
		return;
	}
	else	add_action("do_prepare","ask");
}

mixed *story = 
({
	HIC"你上前将八仙近日即将东游一声向老龙王讲了一遍。\n"NOR,
        CYN"敖广「唉」的一声叹了口气。\n"NOR,
        HIC"敖广说道：何苦来哉？！上次游我东海，就害得我四海不宁，如今又来？！\n"NOR,
        CYN"敖广哭丧着脸扳着手指脚趾数着：我今天倒霉极了，１、２、... ...，掉线了１００多次！\n"NOR,
	CYN"敖广说道：奈何他家祖师爷爷乃天地同寿的人物，本王也是惹不起。\n"NOR,
	CYN"你你对着敖广「嗯」的一声，似乎有什么话要说。\n"NOR,
	HIR"敖广满脸的不耐烦：别理我，烦着呢！\n"NOR,
        HIC"敖广挥手叫来一旁龟丞相，附耳说了一番。龟丞相点头向下离去。\n"NOR,
        CYN"敖广喃喃道：如今只有让我那龙子龙孙多思慎言了。\n"NOR,
        NOR"龟丞相领着龙太子、龙表弟从殿下走来。\n",
        CYN"敖广说道：近日五庄观八位弟子又将东游，尔等这些天慎言慎行，莫生事端！\n"NOR,
        NOR"龙太子、龙表弟虽有不忿之色，仍是恭恭敬敬行礼答应了下来。\n",
        CYN"敖广说道：尔等下去吧。\n"NOR,
        CYN"你弯下身鞠躬！\n"NOR,
        "两位太子急急忙忙的离开了。\n",
        CYN"敖广对你说道：届时东游烦请与他们同行，出了意外，倒也可以照应，免生祸端。\n"NOR,
        HIC"你对敖广痛快地说道：“好吧！”\n"NOR,
});

mixed query_story_message(int step)
{
	return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object me,object who)
{
	remove_call_out("start_smash");
	if( !me || !who) 
        	return;
	call_out("start_smash",1+random(2),me,who);
}

void start_smash(object me,object who)
{
	string str,data,msg;
	mixed line;
	string prompt;
	remove_call_out("start_smash");
	if( !me || !who || !query("asking") || !present(me,environment(who)) )
        	return;
        msg = "拜师镇元";		
	go_on_process(me,who);        
	line = query_story_message(step);
	if( !line )
	{
		remove_call_out("start_smash");
		delete("asking");	
		me->set_temp("pendding/fc_visite_seask",1);
		me->delete_temp("pendding/wzg_askob2");
		call_out("dest_ob",3);			
		tell_object(me,HIY"【"+msg+"】八仙过海：既然诸事都已商定，还是回去和镇元大仙禀告吧。\n"NOR);
		return;
	}
	step++;
	prompt = ""; 
	if( functionp(line) ) 
        	catch(line = evaluate(line));
	if( stringp(line) )
	{
		line = replace_string(line,"$N",who->name());
		tell_object(me,line);
        }
	if(intp(line) && !line)
        	go_on_process(me,who);
}

int do_prepare(string arg)
{
	string data,id,*files;
	object who,me = this_player();
	
	if( !arg || sscanf(arg,"%s about %s",id,arg)!=2 )
		return 0;
	who = present(id,environment(me));
	if( !who || userp(who) || who->is_fighting()
	 || !living(who) )
		return 0;
	id = base_name(who);
	files = ({
		"/d/sea/npc/longwang",
	});
	if( member_array(id,files)==-1 )
		return 0;

	if( me->query_temp("pendding/fc_visite_seask") )
	{
		write("你向"+who->name()+"打听最近可有烦恼之事。\n"CYN+who->name()+CYN"说道：这事就麻烦"+RANK_D->query_respect(me)+"作个照应了。\n"NOR);
		return 1;
	}			
	if( query("asking") )
		return 1;
	set("asking",1);		
	step = 0;
	start_smash(me,who);
	return 1;
}