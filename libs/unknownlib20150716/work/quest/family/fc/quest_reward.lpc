#include <ansi.h>

void dest_ob() {
  remove_call_out("dest_ob");
  destruct(this_object());
}

varargs void quest_reward(object who, int succ) {
  mapping prop;
  string fam, *my_data;

  if (!mapp(prop = this_object()->query("quest"))
    || sizeof(prop) < 1
    || undefinedp(prop["msg"]))
    return;

  if (!succ || succ < 1)
    tell_object(who, HIR "【任务】重悟盘龙：任务失败！\n" NOR);
  else {
    fam = prop["family"];
    if (arrayp(my_data = who->query("family/PLCW"))
      && sizeof(my_data) > 0)
      ;
    else my_data = ({});
    if (member_array(fam, my_data) == -1) {
      who->add("family/panlong_r_visit", 1);
      my_data += ({ fam });
      if (who->query("family/panlong_r_visit") >= 12) {
        tell_object(who, HIG "【任务】重悟盘龙：恭喜！你成功拜访所有仙贤，赶紧去找菩提老祖询问「盘龙八式」一事吧。" NOR "\n");
        message(
          "channel:chat",
          HIC "【谈天说地】菩提祖师(Puti)：呵呵，本派弟子" + who->query("name") + "诚心可嘉，贫道特给其重新领悟盘龙的机会，届时欢迎大家观礼。" NOR "\n",
          users()
        );
      } else tell_object(
        who,
        HIG "【任务】重悟盘龙：恭喜！你完成了一个拜贤任务，你还需完成" + (12 - who->query("family/panlong_r_visit")) + "个。" NOR "\n"
      );
    } else tell_object(who, HIG "【任务】重悟盘龙：你已经完成过此门派的拜贤任务了，本次任务不计入成功数中。\n" NOR);
  }
  remove_call_out("dest_ob");
  this_object()->move("/obj/empty");
  call_out("dest_ob", 5);
  return;
}
