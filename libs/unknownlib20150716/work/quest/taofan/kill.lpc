//负责存放妖。
#include <ansi.h>

void create()
{
    seteuid(getuid());
}

string cancel_me(object who)
{
	mixed foo;
	if( !who )
		return 0;
	foo = who->cancel_job("逃犯任务");
	if( !foo || !stringp(foo) )
		return "你有接任务吗？";
	return foo;	
}

string query_yao(object me)
{
	int lvl;
	string where,msg,name;
	object ghost;
	mixed foo;
	if( !me )
		return 0;
	foo = me->doing_job("逃犯任务");
	if( foo )
	{
		if( stringp(foo) )
			return foo;
		else	return "你不是已经接了吗？";	
	}
       
       	ghost = new(__DIR__"yg/yaoguai");
	if( !ghost )
		return "现在没有任务给你。";

	lvl = me->query_job_level("逃犯任务");
	if( lvl>=10 )
		lvl = 0;
	lvl+= 1;
	where = ghost->invocation(me,lvl);
	if( !where )
		return "你先下去歇歇。";
	where = COLOR_D->clean_color(where);
	me->set_job_level("逃犯任务",lvl);	
	if( ghost->query("gender")=="男性" )
		name = "他";
	else if( ghost->query("gender")=="女性" )
		name = "她";
	else	name = "它";	
	msg = CYN"据宫廷密报，有"+where+"附件一带流窜，你且去提"+name+"头颅前来见我！\n"NOR;
	return me->get_job("逃犯任务",({0,0,msg,ghost,lvl}));
}

string change_level(object me)
{
	if( !userp(me) || me->query("gin")<3 )
		return "你的活力不够了。";
	if( me->query("xyscore")<10 )
		return "你的【江湖威望】不足10点，无法开启噩梦模式。";		
	me->add("gin",-3);
	if( me->query_temp("taofan_level") )
	{
		me->delete_temp("taofan_level");
		me->set_job_level("逃犯任务",0);
		write("你变更逃犯任务为普通级别。\n");
		return "好的。";
	}
	me->add("xyscore",-10);
	if( time()>=me->query("last_rumor")+3600 )
	{
		me->set("last_rumor",time());
		CHANNEL_D->do_channel(this_object(),"rumor","听说"HIY+me->name()+HIM"将自己的逃犯任务难度提升为"NOR RED"噩梦"NOR HIM"级！"NOR);
	}
	me->set_temp("taofan_level",1);
	me->set_job_level("逃犯任务",0);
	write("你变更逃犯任务为噩梦级别。\n");
	return "好的。";	
}
