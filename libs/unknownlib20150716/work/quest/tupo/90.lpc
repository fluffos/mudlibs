//90突破,中神通
#include <ansi.h>

mixed ask_tupo(object me,object npc)
{
	string msg;
	if( me->query_temp("mark/tupo-90") )
		return "你且下去打坐冥思一番，再好好入睡，自有机缘。";
	msg = CYN"$N"CYN"朝$n"CYN"哈哈一笑："NOR;
	if( npc->query("id")==me->query("family/master_id")
	 && npc->query("name")==me->query("family/master_name") )
	 	msg+= CYN"好徒儿，"NOR;
	else	msg+= CYN"好个后生，"NOR;
	msg+= CYN+RANK_D->query_self(npc)+CYN"见你进展如此迅速，好是欣慰。"NOR"\n";
	if( npc->query("gender")=="女性" )
	{
		if( npc->query("age")<50 )
		{
			msg+= HIC"$N"HIC"明眸闪亮，掠了掠耳边的长发，笑嘻嘻地望着$n"NOR;
			if( me->query("age")<40 )
			{
				if( me->query("gender")=="女性" )
					msg+= HIC"，直看得$n"HIC"满面羞红，不知所措，心中一时七上八下。"NOR;
				else	msg+= HIC"，直看得$n"HIC"不由心中一荡，一阵心猿意马。"NOR;	
				msg+= HIR"$N"HIR"面色一红，娇斥一声：整天儿心中想着乱七八糟的事儿！"NOR"\n";
			}
		}
		else	msg+= HIC"$N"HIC"目光慈祥，笑呵呵地望着$n"HIC"。"NOR"\n";
	}
	else
	{
		if( npc->query("age")<40 )
		{
			msg+= HIC"$N"HIC"洒落一笑，乐呵呵地望着$n"NOR;
			if( me->query("age")<40 )
			{
				if( me->query("gender")=="女性" )
					msg+= HIC"，直看得$n"HIC"满面羞红，心中一阵心猿意马。"NOR;
				else	msg+= HIC"，直看得$n"HIC"不知所措，心中一时七上八下。"NOR;	
				msg+= HIR"$N"HIR"见状不由脸色一肃。"NOR"\n";
			}
		}
		else	msg+= HIC"$N"HIC"手捋长须，目光慈祥地望着$n"HIC"。"NOR"\n";
	}	
	msg+= CYN"$N"CYN"说道：自尔突破至"NOR;
	if( npc->query("family/family_name")=="阎罗地府" )
		msg+= HIB"灵噬期"NOR;
	else if( npc->query("family/family_name")=="火云洞"
	      || npc->query("family/family_name")=="盘丝洞"
	      || npc->query("family/family_name")=="东海龙宫"
	      || npc->query("family/family_name")=="大雪山"
	      || npc->query("family/family_name")=="陷空山无底洞" )
	      	msg+= HIR"妖丹期"NOR;
	else if( npc->query("family/family_name")=="南海普陀山" )
	      	msg+= HIY"明心期"NOR;
	else	msg+= HIC"结丹期"NOR;
	msg+= CYN"期以来也有了些时日。虽进步神速，然亦不可懈怠。步天之路，不进则退。"NOR"\n";
	msg+= HIC"$N"HIC"对$n"HIC"说道：当下紧要之事惟"NOR+HIC+BLINK;
	if( npc->query("family/family_name")=="阎罗地府" )
		msg+= "以灵养魂，固本还元"NOR;
	else if( npc->query("family/family_name")=="火云洞"
	      || npc->query("family/family_name")=="盘丝洞"
	      || npc->query("family/family_name")=="东海龙宫"
	      || npc->query("family/family_name")=="大雪山"
	      || npc->query("family/family_name")=="陷空山无底洞" )
		msg+= "温养妖丹，乃至化形"NOR;
	else if( npc->query("family/family_name")=="南海普陀山" )
		msg+= "以心明意，禅定静守"NOR;
	else	msg+= "以气养丹，终成元婴"NOR;
	msg+= NOR HIC"。"NOR"\n";
	msg+= CYN"$N"CYN"说道：为今之计，当先逃脱轮回，勘破生死。"NOR"\n";
	msg+= HIR"$N"HIR"嘱咐$n"HIR"：你且先去"NOR;
	if( npc->query("family/family_name")=="阎罗地府" )
		msg+= HIR"本门生死台走一遭。"NOR;
	else	msg+= HIR"那阎罗地府的生死台走一遭。"NOR;
	msg+= HIR"便如当年那猴子一般，销了生死簿去。"NOR"\n";
	message_vision(msg,npc,me);
	me->set_temp("mark/tupo-90",1);
	message_vision(HIC"\n$N"HIC"掐了个法咒，伸出右手中指往$n"HIC"眉心一指，不由哈哈大笑一声。\n\n"NOR,npc,me);
	return "你且下去打坐冥思一番，再好好入睡，自有机缘。";
}

mixed ask_shentong(object me,object npc)
{
        if( me->query("faith")<1000000 )
                return "哈哈哈，待你门派贡献到达一百万时再来找我。";
        me->add("faith",-1000000);      
	me->set("shentong/90",1);
	tell_object(me,CYN+npc->name()+CYN"说道：不错不错，境界有所提升，内丹愈加巩固，来来来，这里授你一门神通。\n"NOR);
	message_vision(HIC"\n$N"HIC"掐了个法咒，伸出右手中指往$n"HIC"眉心一指，不由哈哈大笑一声。\n\n"NOR,npc,me);
	me->set_skill("yijing",1);
	me->save(1);
	tell_object(me,HIY"恭喜！你习得了「"+HIR+to_chinese("yijing")+HIY"」，这乃地煞七十二神通中的一门，功效是"HIR"减免反弹伤害"NOR HIY"，与「"+HIR+to_chinese("pingfeng")+HIY"」搭配，效果更佳。"NOR"\n");
	tell_object(me,"\n"HIG"你可以通过 "HIR"practice yijing "HIG"命令来提升此神通的境界，境界愈高，减免愈大。"NOR"\n");
	tell_object(me,"\n"HIR"恭喜，你的小神通升级了！你可以通过 "HIY"help spells_xiaoshen "HIR"来查看你的小神通目前的效果。"NOR"\n\n");
	return "呵呵，你且下去好生参悟。";	
}
