//金色装备：有1条随机属性的装备
//蓝色装备：有3到10条随机属性的装备，属性越多，出现的概率越低		
//橙色装备：有2条随机属性的装备
//红色装备：有3条固定属性的装备，第四条属性随机，并有可能额外出现1到3条随机属性
//紫色装备：有4条固定属性的装备，第五条属性随机，并有可能额外出现1到3条随机属性				 
#include <ansi.h>
#include <weapon.h>
inherit __DIR__"newweapon.lpc";

mapping w_names()
{
	return ([
1	:	({"匕首",({"bi shou","dagger",}),}),
10	:	({"分水刺",({"fenshui ci","dagger","ci"}),}),
20	:	({"短铁爪",({"duantie zhua","dagger","zhua"}),}),
30	:	({"虎须爪",({"huxu zhua","dagger","zhua"}),}),
40	:	({"毒蛇信",({"dushe xin","dagger","zhua"}),}),
50	:	({"雷公椎",({"leigong zhui","dagger","zhua"}),}),
60	:	({"惊神刺",({"jingshen ci","dagger","zhua"}),}),
]);
}

void create()
{
	set_name("武器◆短兵刃",({"dagger"}));
	set("skill_type","dagger");
	set("unit","对");
	setup();
}

