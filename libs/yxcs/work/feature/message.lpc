void write_prompt()

{        	
	if( sizeof(msg_buffer) ) {
		receive(BOLD +"[输入时暂存讯息]\n" + NOR);
		for(int i=0; i<sizeof(msg_buffer); i++)
			receive(msg_buffer[i]);
		msg_buffer = ({});
	}
        write(HIM"☆"NOR);
}
*/
void write_prompt() {
  int env, b_size;
  string prompt, msg, path;
  object me;

  me = this_player(1);
  msg = "【暂存讯息】\n";
  msg = LANGUAGE_D->output(msg, this_object());

  if (b_size = sizeof(msg_buffer)) {
    receive(BOLD + HIG + msg + NOR);
    for (int i = 0; i < b_size; i++)
      receive(msg_buffer[i]);
    msg_buffer = ({});
  }

  if (intp(me->query("env/prompt")))  //提示符的形式
  {
    env = (int)me->query("env/prompt");
    switch (env) {
      case 1:
        env = (int)me->query("env/time_format");
        prompt = HIC + ctime(time())[11..18] + HIY "> " NOR "\n";
        break;
      case 2:
        if (!stringp(prompt = me->query_temp("reply")))
          prompt = HIY "℡『』" NOR "\n";
        else
          prompt = HIY "℡『" + HIW + prompt + HIY "』" NOR "\n";
        break;
      case 3:
        prompt = HIY "『" + HIW + "气：" + me->query("qi") + "|精：" + me->query("jing") + HIY "』" NOR "\n";
        break;
      case 4:
        prompt = HIY "『" + HIW + "气：" + me->query("qi") + "|精：" + me->query("jing") + "|经验：" + me->query("combat_exp") + "|潜能：" + ((int)me->query("potential") - (int)me->query("learned_points")) + HIY "』" NOR "\n";
        break;
      case 5:
        if (!wizardp(this_object()) || wiz_level(this_object()) < 3)
          break;
        if (!stringp(path = query("cwd"))) {
          path = "/";
          set("cwd", path);
        }
        prompt = HIC + path[0..<2] + HIY "/ " NOR "\n";
        break;
      default:
        prompt = HIM "☆" NOR;
    }
  } else
    prompt = HIC + me->query("env/prompt") + HIY "> " NOR "\n";
  //使玩家可自己设定提示符

  write(prompt);
  //write() - 对目前的玩家送出讯息.
  //本mud对此函数用simul_efun进行了一些处理(为了解决内码转换的问题)
}



