#include <room.h>

inherit ROOM;
void create()
{
	set("short", "兵器库");
	set("long", @LONG
这里是墨隐堂的兵器库，墨隐堂的杀手们可以在这里领(report)
到一些兵器。同时，墨隐堂的第二号人物司马琳也常在这里处理堂中
事务。

LONG );

	set("exits", ([
		"north"   : __DIR__"center",
		"west"   : __DIR__"hall",
		
	]));
	set("objects", ([
		__DIR__"npc/player" : 1,
		]));
	setup();
}
void init()
{
   	add_action("do_send"	,"report");
}
int do_send(string arg)
{
  object me,ob;
      me=this_player();
      ob=new(__DIR__"obj/sword");
      ob->move(me);
      if (!ob->move(me)) return notify_fail("太重了，送不过来．．\n");
      tell_object(me,"你领到一把剑。 \n");
      return 1;   	
}