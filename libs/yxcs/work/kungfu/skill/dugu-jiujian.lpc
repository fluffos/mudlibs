  ([ "action": "$N吐气开声，一招似是「[37m独劈华山[2;37;0m」，手中$w向下斩落，直劈向$n的$l！",
    "force": 250,
    "dodge": -40,
    "lvl": 49,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w越转越快，使的居然是衡山的「[1;31m百[2;37;0m[1;32m变[2;37;0m[33m千[2;37;0m[1;36m幻[2;37;0m[37m云[2;37;0m[35m雾[2;37;0m[1;34m十三式[2;37;0m」，剑式有如云\n卷雾涌，旁观者不由得目为之眩！",
    "force": 260,
    "dodge": -45,
    "lvl": 56,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N含笑抱剑，气势庄严，$w轻挥，尽融「达摩剑」为一式，闲舒地刺向$n！",
    "force": 270,
    "dodge": -50,
    "lvl": 63,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N举起$w运使「太极剑」剑意，划出大大小小无数个圆圈，无穷无尽源源不绝地\n缠向$n！",
    "force": 280,
    "dodge": -60,
    "lvl": 70,
    "damage_type": "刺伤"
