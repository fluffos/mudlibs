  ]),
  ([ "action": "$N抱剑旋身，转到$n身后，杂乱无章地向$n刺出一剑，不知使的是什么剑法！",
    "force": 380,
    "dodge": -95,
    "lvl": 112,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N突然一剑点向$n的$l，虽一剑却暗藏无数后着，$n手足无措，不知如何是好！",
