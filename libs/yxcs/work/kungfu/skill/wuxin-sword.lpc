inherit SKILL;

////////////////////////////////

mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "$N忽然消失不见，手握$w,一招「狼子野心」对准$n的眉间迅速刺出一剑。",
    "force": 50,
    "dodge": 20,
    "damage_type": "刺伤",
    "lvl": 0,
    "skill_name": "狼子野心"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N手握$W一式「没心没肺」突然从不可思议的角度遥遥刺出一剑，在$n的咽喉刺出一个大窟窿。",
    "force": 80,
    "dodge": 10,
    "damage_type": "刺伤",
    "lvl": 12,
    "skill_name": "没心没肺"
  ]),
});
// ZHAOSHI :2
int valid_learn(object me) {
  object weapon; if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword") return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练" + "无心剑" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("wuxin-sword", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon; if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") return notify_fail("你使用的武器不对。\n"); if ((int)me->query("qi") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("neili") < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -3);
  return 1;
}  //total 34 lines!
