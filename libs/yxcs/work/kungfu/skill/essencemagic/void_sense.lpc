#pragma save_binary
// void_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target) {
  int delta, skill;
  if (target) return notify_fail("空识神通只能对自己使用。\n");
  if (me->query("mana") < 100)
    return notify_fail("你的法力不够！\n");
  me->add("mana", -50);
  me->receive_damage("jing", 20);
  message_vision(HIY "$N盘膝而座，开始运用空识神通静思入定 ...\n" NOR, me);
  skill = (int)me->query_skill("essencemagic");
  if (skill > 80) skill = 80;
  if (random(me->query_skill("magic")) > (int)me->query_int() && !random(3)) {
    if (random(me->query("max_mana")) < (int)me->query("mana") / 2) {
      me->add("potential", 1);
      write(HIR "你觉得脑中一片混乱，你的潜能降低了！\n" NOR);
      return 1;
    }
    delta = random((int)me->query_spi() + skill) / 10;
    if (me->query("potential") > ((int)me->query_skill("essencemagic") * me->query_skill("essencemagic") * me->query_skill("essencemagic") / 4)) {
      delta = 1;
      me->receive_damage("jingli", 20);
    }
    if (delta > 0) {
      me->add("potential", delta);
      write(HIG "你的潜能提高了！\n" NOR);
      return 1;
    }
  }
  me->start_busy(1);
  write("可是你只觉得一无所获。\n");
  return 1;
}
