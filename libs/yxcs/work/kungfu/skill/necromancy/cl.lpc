// 雄霸天下II魔法技能标准范例。
// 参数说明
// set_temp("armor_vs_fire",50)
// armor_vs_fire // 对火系魔法的抵抗能力 +表示抵抗火系魔法 -表示抵抗水系魔法
// 两者不能共存。即无法同时抵抗水系魔法和火系魔法。如果生物可以抵抗水系魔法。
// 那么火系魔法将对他造成更大的伤害。
// armor_vs_lightning // 抵抗电系魔法的能力
// armor_vs_magic  // 抵抗魔法能力。对抗所以魔法 这个值不能设的太高。
// 通常这个值应该控制在 -100至+100 以内。以百分比来计算。负数表示此生物
// 惧怕此类魔法。正数反之。任何非特殊npc的抵抗系数不得超过-30至+30之间
// execration  表示正在念咒。
// 以后任何魔法都应此类为标准。不得再使用其他标记。以免混乱。
// fireball
// 1999.3.1 by rongg
// fireball.c

inherit MAGIC;
//继承文件，如果该魔法非常特殊，可以不用继承F_MAGIC,自己参照以前的魔法编写
void create() {
  set("magicname", "火舞云霄");
  set("matter", ({  //魔法内容,自动按照排列顺序显示
  "比黄昏更加昏暗,比鲜血更加鲜红",
    "时光虽然流逝,你力量常存",
    "籍住你的名字,我在黑暗中发誓",
    "阻碍在我面前所有愚蠢的物体",
    "凭住你我的力量,必至灭亡",
    "$N手中突然聚起一片金黄色的火焰朝$n铺天盖地的撒去",
    "结果$n立刻被火焰包围了",
    "结果$n大惊失色，拼命朝一旁躲去。竟然被$n躲开了",
  }));
  //内容设置是这样的.最后以句为目标躲开的显示,倒数第二句是目标被击中的显示





  set("damagetype", "kee");  //伤害类型,kee,gin,sen,all(kee,gin,sen都收到伤害),random
  set("odds", 90);  //最基本的命中率,但是会按照经验进行修正
  set("attribute", "fire");  //魔法属性fire,lightning,water,ice,magic,no(无属性)
  //如果没有这一项设置,默认为无属性,无属性的魔法最厉害
  set("attach", "necromancy");  //这个魔法是属于necromancy的.
  set("intonatetime", 1);  //每念一句咒语所需要的时间,如果没有这项设置,那么默认为1.
  //最大是3.(单位是秒)
  set("area", 1);  //攻击面积,没有或者默认设置是1.即只能攻击一个敌人.
  //如果是2,表示目标敌人周围的2个格子之内(一个以目标敌人为中心的
  //十字形格子),如果是3,表示目标敌人周围3个格子之内的所有敌人
  //图例:1        2:    -    3   - - -    
  //         -        - - -      - - -    
  //                    -        - - -  (-表示敌人)
  //最大范围是4,最小是1.
  set("intelligence", 1);  //智能的魔法,如果该魔法有这个设置,表示该魔法不会
  //伤害到自己人.如果没有这个设置,魔法会伤害任何人
  //即使该魔法波及到了你的队友,你的队友也不会对你下kill指令
  set("base_damage", 350);  //最基本的伤害力,350已经不小了
  //这个伤害值的设置应该遵循以下几点要求
  //1.如果咒语超过5句话,并且每句咒语是1秒.那么每增加一句话,基本伤害应该加50.
  //2.如果intonatetime超过1,那么(intonatetime*咒语条数-5)*50+300=基本伤害
  //3.玩家能够学到的魔法的基本伤害不能超过800,800这个数值已经非常巨大了
  //4.如果该魔法只是某些特殊npc使用的,基本伤害不能超过1200.
  //5.一般情况下,攻击魔法的咒语越长,基本伤害就应该越大.
  //set("need_two_hand",1);//设置为1表示念这个咒语必须双手空闲.就是手中不能拿着武器

}

int cast(object me, object target) {
  string msg;
  int skill;
  skill = me->query_skill("spells");
  if (!skill || skill < 160)
    return notify_fail("你没有领悟这项魔法！\n");
  if (!me->query_skill_mapped("force") || me->query_skill_mapped("force") != "gouyee")
    return notify_fail("火舞云霄需要谷衣心法的配合方可使用。\n");
  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展火舞云霄？\n");
  if (me->query_temp("execration"))
    return notify_fail("你正在念咒。\n");
  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  me->add("mana", -100);
  me->receive_damage("sen", 50);
  msg = "" + me->name() + "自言自语不知道在说些什麽。\n";
  message("vision", msg, environment(me), ({ me }));
  tell_object(me, "你双手向天空中伸展开去。开始默念咒语。\n");
  me->set_temp("execration", 1);
  //	skills_limit(me);
  call_out("do_exe", 1, me, target, skill);

  //tell_object(me,"你双手向天空中伸展开去。开始默念咒语。\n");
  return 1;
}

int do_exe(object me, object target, int skill) {
  do_execration(me, target, skill, 0);  //开始念咒了,0表示从第一句开始念起	
}
