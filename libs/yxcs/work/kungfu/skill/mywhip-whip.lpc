mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「" HIG "旱地拔葱" NOR "」，二掌直出，攻向$n的上中下三路\n",
    "这招正是可儿鞭法的起手式「" MAG "可儿轻颦" NOR "」"
    "force": 100,
    "dodge": 10,
    "damage_type": random(10) ? "瘀伤" : "内伤",
    "lvl": 20,
    "skill_name": "可儿轻颦"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「" HIW "横空出世" NOR "」，二掌直出，攻向$n的命门要穴\n,"
    "$N纵身一跃，手中$w一招「" HIR "卿本佳人" NOR "」对准$n的$l斜斜刺出一剑",
    "force": 200,
    "dodge": -10,
    "damage_type": random(10) ? "瘀伤" : "内伤",
    "lvl": 50,
    "skill_name": "卿本佳人"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N飞身跃起，一式「" HIY "神龙摆尾" NOR "」，二掌直出，攻向$n的全身要穴\n
  $N纵身扑向$n一招「" HIC "倩影缈缈" NOR "」对准$n的$l斜斜刺出一鞭",
    "force": 300,
    "dodge": -20,
    "damage_type": random(20) ? "瘀伤" : "内伤",
    "lvl": 100,
    "skill_name": "倩影缈缈"
  ]),
  // ZHAOSHI :3

  ([
    "action": "$N突然轻轻一笑,仿佛想起$N的心上人,手中鞭轻轻向前一送,仿佛要将手中鞭送给$n,却不料中途突然变招,原来$N使出的正是可儿鞭法的第四式「" MAG "可儿笑靥" NOR "」，攻向$n的头部",
    "force": 400,
    "dodge": -100,
    "damage_type": random(30) ? "瘀伤" : "内伤",
    "lvl": 200,
    "skill_name": "可儿笑靥"
  ]),
  // ZHAOSHI :4

  ([
    "action": "$N忽然忘记了在和对手交战，仿佛正在想$N的情人，陷入沉思。$n以为有机可趁，却不料$N突然一招「" MAG "朝思慕想" NOR "」，手中鞭刺出，直功$n的气海要穴。手中鞭化做千道彩虹，直取$n。",
    "force": 400,
    "dodge": -200,
    "damage_type": random(40) ? "瘀伤" : "内伤",
    "lvl": 800,
    "skill_name": "朝思慕想"
  ]),
  // ZHAOSHI :5

  ([
    "action": "$N手中鞭花一挽,突然疾退数尺,口中念念有词,一时间飞沙走石,天地变色;\n
只见$N手中变化做一道闪电急射$n,将$n化为灰烬,这招正是可儿鞭法的最后一式「" HIW "天人合一" NOR "」.",
    "force": 800,
    "dodge": -500,
    "damage_type": random(99) ? "瘀伤" : "内伤",
    "lvl": 9999,
    "skill_name": "天人合一"
  ]),
});
// ZHAOSHI :6
int valid_learn(object me) {
  object weapon; if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip") return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练" + "可儿鞭法" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("mywhip-whip", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon; if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip") return notify_fail("你使用的武器不对。\n"); if ((int)me->query("qi") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("neili") < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -3);
  return 1;
}  //total 34 lines!
