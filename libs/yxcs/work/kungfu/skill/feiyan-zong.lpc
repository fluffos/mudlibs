inherit SKILL;

mapping *action = ({
  ([ "action": "$n身形一晃，纤腰一扭，一招「燕子摆尾」，弹地而起。\n",
    "dodge": 10,
  ]),
  ([ "action": "$n漫不经心的向前一步，一招「燕子觅食」刚好避过$N的凌厉攻势。\n",
    "dodge": 20,
  ]),
  ([ "action": "可是$n恰巧往后一缩，一招「燕子归巢」躲过了$N这一招。\n",
    "dodge": 30,
  ]),
  ([ "action": "只见$n一招「燕子冲天」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "dodge": 40,
  ]),
  ([ "action": "$n一个「燕子翻身」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "dodge": 50,
  ]),
  ([ "action": "$n使出「燕子展翅」，向一旁飘然纵出，轻轻着地。\n",
    "dodge": 60,
  ]),
  ([ "action": "但是$n身形飘忽，一招「燕子回旋」轻轻一转，早已避开。\n",
    "dodge": 70,
  ]),
  ([ "action": "$n身随意转，一招「燕子分飞」倏地往一旁挪开了三尺，避过了这一招。\n",
    "dodge": 80,
  ]),
  ([ "action": "可是$n一式「燕子化风」，随风似风，顿时让$N这一招扑了个空。\n",
    "dodge": 90,
  ]),
  ([ "action": "却见$n足不点地，一招「燕子俯冲」往旁窜开数尺，躲了开去。\n",
    "dodge": 100,
  ]),
  ([ "action": "$n身形微晃，一招「燕子出巢」有惊无险地避开了$N这一招。\n",
    "dodge": 120,
  ])
});

mapping query_action(object me, object weapon) {
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level = (int)me->query_skill("feiyan-zong", 1);
  return action[random(zhaoshu)];
}

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;

  me = this_player();
  action = query_action(me, ob);

  return action["action"];

}

int practice_skill(object me) {
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，练不了燕子身法。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "feiyan-zong/" + action;
}
