// tie@fengyun

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("太极拳法之「圆转如意」只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")) && objectp(me->query_temp("secondary_weapon")))
    return notify_fail("你先放下手中的武器再说吧？！\n");

  if ((int)me->query_skill("taiji-quan", 1) < 150)
    return notify_fail("你的太极拳法不够娴熟，不能用「圆转如意」。\n");

  if ((int)me->query_skill("taiji-shengong", 1) < 150)
    return notify_fail("你的太极神功不够娴熟，不能使用「圆转如意」。\n");
  if (me->is_busy()) return notify_fail("你正忙着呢。\n");

  extra = me->query_skill("taiji-quan", 1) / 80;
  extra += me->query_skill("taiji-shengong", 1) / 80;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIR "$N运起［太极神功］，同时使出［太极拳法］中的「圆转如意」，心随意转，毫无挂碍，双拳微握上提，缓缓朝$n划起太极圆来！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  msg = HIW "$N划了一个圆圈！\n" NOR;
  message_vision(msg, me, target);
  if (extra > 40) extra = 40;
  for (i = 0; i < extra / 4; i++) {
    msg = HIY "$N上一个圈还没划完，却又是一个圈划了出来！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("neili", -1000);
  me->start_busy(3);
  return 1;
}
