#include <ansi.h>
inherit SKILL;
mapping *action = ({
  ([ "action": HIY "$N使出必杀剑唯一招" NOR "" HIR "「毁灭」" NOR "" HIY "，简简单单的给你$n一剑！" NOR,
    "force": 50,
    "dodge": 10,
    "damage": 50,
    "skill_name": "「毁灭」",
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": HIY "$N使出必杀剑最后招" NOR "" HIR "「天地毁灭」" NOR "" HIY ",随随便便的给了$n一剑。" NOR,
    "force": 50,
    "dodge": 30,
    "damage": 150,
    "skill_name": "「天地毁灭」",
    "lvl": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action": HIR "$N看似无招胜有招招招必杀攻向$n的全身要害！" NOR,
    "force": 50,
    "dodge": 20,
    "damage": 200,
    "lvl": 150,
    "damage_type": "刺伤"
  ]),
});
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int valid_learn(object ob) {
  if (ob->query("max_neili") < 500)
    return notify_fail("你的内力不够。\n");
  if (ob->query("per") < 25) {
    return notify_fail("由于你的天性不够，必杀剑你永远也学不会。\n");
  }
  if (ob->query("kar") < 25) {
    return notify_fail("由于你的天性不够，必杀剑你永远也学不会。\n");
  }
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("bisha-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练「必杀剑法」。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练「必杀剑法」。\n");
  me->receive_damage("qi", 40);
  me->add("neili", -15);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "bisha-jian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 50) return 0;
  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("qi", 100);
    return HIB "你听到「唰」一声轻响好似凉风吹过，忽然间$n血冒三丈，被剑气所伤！\n" NOR;
  }
}
