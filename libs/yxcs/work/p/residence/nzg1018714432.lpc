// a skeleton for user rooms
inherit ROOM;
void create() {
  set("short", "精英会总坛");
  set("long", @LONG
这就是精英会的总坛。正前方一把铺着虎皮的大红椅子，
帮主的威严立现，两侧各有九个坐位，帮中享有地位的坛主、
护法每逢初一、十五，都会齐聚于此，与帮主共商兴帮之计。
门边一个虎头斩，专门用来处罚帮中叛徒。

LONG
  );
  set("exits", ([
    "down": "/p/residence/nzg1018770796",
    "east": "/p/residence/nzg1018716755",
    "west": "/p/residence/nzg1018715515",
    "south": "/p/residence/nzg1018713090.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "【精英会】");
  set("banghui", "【精英会】");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "invite");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}

