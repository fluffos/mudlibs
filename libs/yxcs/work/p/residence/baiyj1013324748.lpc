// a skeleton for user rooms
inherit ROOM;
void create() {
  set("short", "「铁血谷」");
  set("long", @LONG
  终于走出了好象没有尽头的森林。你眼前豁然开朗，一个巨大的山谷出现
在你的面前。柔和的阳光宽厚的洒遍谷中每一个角落，这就是传说中的铁
血谷了。江湖中很少有人知道铁血谷的来历，因其行事多诡秘而视其为邪派。
其实铁血谷中的铁血大旗门弟子都是前朝忠良之后，出于不为人知的原因隐居
在此。谷中鸟语花香，阡陌相通。一片祥和气氛。

LONG
  );
  set("exits", ([
    "north": "/p/residence/twfx1013335763",
    "east": "/p/residence/baiyj1013324864",
    "west": "/p/residence/twfh1013318066.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "【铁血大旗门】");

  setup();
}

void init() {
  object ob = this_player();
  if ((string)ob->query("banghui") != environment(ob)->query("banghui")) {
    message(
      "vision",
      HIY "〖帮派总坛〗" NOR + ":" + HIY " " + ob->query("name") + "于今日" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被赶了出来!\n" NOR,
      users()
    );
    message_vision(HIR "门卫突然从里面冲了出来给$N一脚,$N惨叫一声,被踢了出来。" NOR, this_player());
    ob->move("/p/guangchang");
  } else return;
}
