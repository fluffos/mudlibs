// a skeleton for user rooms
inherit ROOM;
void create() {
  set("short", "护法住宿区");
  set("long", @LONG
这里是恨天阁护法住宿的区域，只有任护法职位的
弟子才可以在这里住宿，在这个区域里慕容飘雪说了算，
为什么呢，因为他可是星空阁主追的人哟，也是本阁唯一
的异性，正所谓物以希为贵，所以各位护法为了迁就慕容
飘雪，把整个住宿区都让给慕容飘雪了，他们自己去外面
租房子住了

LONG
  );
  set("exits", ([
    "down": "/p/residence/zjpker1014563691.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "〖恨天阁〗");
  set("banghui", "〖恨天阁〗");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "invite");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}

