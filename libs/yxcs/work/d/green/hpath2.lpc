  set("exits", ([ /*sizeof()==2*/
    "southdown": __DIR__ "hpath1",
    "northup": __DIR__ "hplat",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/luo": 2,
  ]));
  setup();
  //        replace_program(ROOM);
