// Room: /open/tony/jjf/jjf_2.c
inherit ROOM;

int i;
void create() {
  set("coor", ({ 100, 2940, -10 }));
  set("short", "第二层密室");
  set("long", @LONG
进来才发现这是,前朝的相府的地下密室,因为几乎没人知道这地方，
所以到处都是灰尘.这儿永远是没有出路的，没人救得了你了，哭吧，哈哈！
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
  ]));
  set("objects", ([ /* sizeof() == 0 */

    __DIR__ "jin_wei": 0,
  ]));
  set("no_clean_up", 0);
  set("no_magic", "1");


  setup();
}
void init() {
  add_action("do_find", "find");
  add_action("do_cry", "cry");
  add_action("do_pray", "pray");
}
int do_find() {
  object me;
  object map;
  me = this_player();
  message("vision", "你发现在墙角有张旧羊皮! \n", environment(me));
  map = new(__DIR__ "obj/map1.lpc");
  map->move(me);

  remove_action("do_find", "find");
  return 1;
}
int do_cry() {
  object me, ob, weapon;
  me = this_player();
  i = i + 1;
  if (i == 5) {
    i = 1;
    message("vision", "夜明珠一闪! \n", environment(me));
    set("exits/west", __DIR__ "secret_room");
    call_out("close_passage", 5);
    return 1;
  }
}


int do_pray(string arg) {
  object me;
  tell_object(me, "这里也不准使用宝物！呵呵...\n");
  return 1;
}
void close_passage() {
  object room;

  if (!query("exits/west")) return;
  message("vision",
    "夜明珠暗了下来。\n",
    this_object());
  delete("exits/west");
}
