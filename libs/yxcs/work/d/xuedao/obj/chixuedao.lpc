//chi-xuedao 赤血刀
#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(HIR "赤血刀" NOR, ({ "chi xuedao", "xuedao", "blade" }));
  set_weight(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "此刀有胜谛打造，是天下神兵。\n");
    set("material", "steel");
    set("no_put", "珍惜它吧。\n");
    set("value", 60);
    set("wield_msg", HIR "赤血刀跃出刀鞘 ，放射出璀璨的毫光，天地为之变色。\n" NOR);
    set("unwield_msg", CYN "$N手中刀光渐渐暗淡，天幕渐渐焕出光芒。\n" NOR);
  }
  init_blade(1000);
  setup();
}

int query_autoload() {
  return 1;
}
