// taolord.c

inherit NPC;
inherit F_MASTER;
//inherit F_QUEST;
void create() {
  set_name("林忌", ({ "lin ji", "lin" }));
  set("nickname", "六指真人");
  set("gender", "男性");
  set("age", 47);
  set("long",

    "林忌是一位道行十分高深的修道者，你发现他的眼珠一个是黑色的，一\n"
    "个是金色的，这正是「谷衣心法」修炼到极高境界的徵兆。\n");

  set("combat_exp", 1000000);

  set("class", "taoist");

  set("str", 20);
  set("appointed", "cloud");
  //表示林忌会用clou魔法自动攻击
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 2000);
  set("max_force", 1000);
  set("force_factor", 30);
  set("mana_factor", 60);
  set("atman_factor", 60);

  set("atman", 1400);
  set("max_atman", 1400);

  set("mana", 4000);
  set("max_mana", 2000);

  set("inquiry", ([
    "谷衣心法":
    "谷衣心法是我茅山派为对抗邪魔外道所创的内功心法。\n",
    "茅山派":
    "我茅山派自张天师开山立派至今，世世代代皆以降妖伏魔为己任。\n"
  ]));

  set("apprentice_available", 3);
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "magic_armor" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "marmor" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "invocation" :),
  }));

  create_family("茅山派", 5, "天师");

  set_skill("literate", 100);
  set_skill("magic", 120);
  set_skill("force", 100);
  set_skill("spells", 120);
  set_skill("scratching", 120);
  set_skill("unarmed", 60);
  set_skill("sword", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("gouyee", 120);

  set_skill("taoism", 120);
  set_skill("necromancy", 120);

  map_skill("spells", "necromancy");
  map_skill("magic", "necromancy");
  map_skill("force", "gouyee");

  set_temp("apply/dodge", 20);
  set_temp("apply/armor", 20);

  setup();

  add_money("gold", 50);
  carry_object("/d/temple/obj/sword")->wield();
  carry_object("/d/temple/obj/robe")->wear();
  carry_object("/d/temple/obj/hat")->wear();
  carry_object("/d/temple/obj/shoe")->wear();


}

void attempt_apprentice(object ob) {

  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 贫道今天已经收了三个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  if (ob->query("family")) {
    command("say 我派不收有来历的人!");
    return;
  }
  if (ob->query("combat_exp") >= 5000000) {
    {
      command("say 我派不收有来历的人!");
      return;
    }

  }


  /*
        if (ob->query("character")!="光明磊落")

        {
            command("say 以你的资质，不适合学法术!");
            return ;
         }
*/
  command("say 嗯... 想入我茅山派？也好....");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "taoist");
  add("apprentice_availavble", -1);
}


void init() {
  add_action("give_quest", "quest");
}
void questbonus(object ob) {
  if (random(3) < 1)
    ob->set("quest/fealty", 2);
  else ob->set("quest/fealty", 1);
}
