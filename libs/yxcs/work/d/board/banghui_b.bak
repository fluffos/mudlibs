// /clone/board/wiz_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("帮派留言板", ({ "board" }) );
      set("location", base_name(environment(this_object())));
      set("board_id", base_name(environment(this_object())->query("owner")));
        set("long", "这是一个供玩家帮派内部交换意见的留言板。\n" );
	setup();
        set("capacity", 2100000);
	replace_program(BULLETIN_BOARD);
}

