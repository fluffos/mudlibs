#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name("玩家意见留言板", ({ "board" }));
  set("location", "/u/liyan/jiedai");
  set("board_id", "liyan_b");
  set("long", @LONG
这是一个专供玩家提出建议使用的留言板。
留言版的使用方法请见 help board。
LONG
  );
  setup();
  set("capacity", 1000);
}
