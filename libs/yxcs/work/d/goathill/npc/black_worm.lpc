#pragma save_binary
// black_worm.c

inherit NPC;

void create() {
  set_name("黑色岩蛭", ({ "black rock leech", "leech" }));
  set("long",
    "一条色作乌黑，带著白色斑点的水蛭模样怪虫，口中露出六对白森森\n"
    "的牙齿，看起来恶心极了。\n");

  set("race", "野兽");
  set("unit", "条");
  set("age", 75);

  set("max_gin", 800);
  set("max_kee", 3000);
  set("max_sen", 800);

  set("str", 40);
  set("con", 60);
  set("cor", 80);
  set("cps", 50);
  set("spi", 10);
  set("int", 20);
  set("kar", 50);
  set("per", 5);

  set("limbs", ({ "头部", "躯干" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 75);
  set_temp("apply/damage", 45);
  set_temp("apply/dodge", 60);
  set_temp("apply/armor", 10);

  set("combat_exp", 150000);
  setup();
}
