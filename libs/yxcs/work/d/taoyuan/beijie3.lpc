// beijie.c 桃源北街
// 2001/12/06 by 若雨(ruoyu) email:ruoyu_st@163.com

#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "桃源北街");
  set("long", "你走在北大街上，踩着坚实的青石板地面。西边是一些商人和趟子手
们经常出入的“" HIC "龙门镖局" NOR "”。这所镖局在江湖上坡有名气，据说开办至尽
数十载，还没有失手过。东边是经常顾客盈门的妓院--" HIM "千金楼" NOR "。\n"
  );
  set("outdoors", "taoyuan");

  set("exits", ([
    "south": __DIR__ "beijie2",
    "north": __DIR__ "beijie4",
    "east": __DIR__ "yihongyu",
    "west": __DIR__ "chitang",
  ]));

  set("no_clean_up", 0);
  setup();
}
