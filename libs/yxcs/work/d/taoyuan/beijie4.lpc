// beijie.c 桃源北街
// 2001/12/06 by 若雨(ruoyu) email:ruoyu_st@163.com

#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "桃源北街");
  set("long", "你走在北大街上，踩着坚实的青石板地面，西边是桃源城里最出名的
一间澡堂--" HIC "华清池" NOR "，许多名门贵族和达官贵人，都经常到华清池来。大街
东面有一家武馆，不时从武馆传来一阵阵喝哈声。想必是武馆的弟子们在
练功吧！\n"
  );
  set("outdoors", "taoyuan");

  set("exits", ([
    "south": __DIR__ "beijie3",
    "east": __DIR__ "wuguan",
    "west": __DIR__ "zaotang",
    "north": __DIR__ "beijie5",
  ]));

  set("no_clean_up", 0);
  setup();
}
