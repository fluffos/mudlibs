#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "桃源东街");
  set("long", "你走在桃源之城的东大街上，踩着坚实的青石板地面。南边有一个英
雄山庄，天下英雄好汉聚集此处生儿欲女。玩家结过婚之后可以到此处买
一董属于自己的别墅，以便养家护口之用。\n"
  );
  set("no_clean_up", 0);
  set("outdoors", "taoyuan");
  set("exits", ([
    "east": __DIR__ "chengmen",
    "west": __DIR__ "dongjie3",
  ]));

  setup();
}
