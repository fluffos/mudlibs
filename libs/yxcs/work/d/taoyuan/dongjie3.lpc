#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "桃源东街");
  set("long", "你走在桃源之城的东大街上，踩着坚实的青石板地面。南边有一家打
铁铺，不时从打铁铺里传来阵阵“" HIW "叮当" NOR "”的声响。北面是一家百货，出售
一些生活用品。\n"
  );
  set("no_clean_up", 0);
  set("outdoors", "taoyuan");
  set("exits", ([
    "east": __DIR__ "dongjie4",
    "south": __DIR__ "datiepu",
    "north": __DIR__ "zahuopu",
    "west": __DIR__ "dongjie2",
  ]));

  setup();
}
