void create() {
  set_name("鸨母", ({ "mother" }));
  set("title", HIM "淫楼妈妈" NOR);
  set("gender", "女性");
  set("age", 53);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 100);
  set("max_jing", 100);
  set("max_neili", 100);
  set("neili", 100);
  set("combat_exp", 1000);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}
