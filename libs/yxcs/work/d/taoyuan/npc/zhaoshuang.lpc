// zhaoshuang.c
#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create() {
  set_name("赵爽", ({ "zhao shuang", "zhao", "shuang" }));
  set("title", HIC "美女军团" NOR);
  set("gender", "女性");
  set("age", 25);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 500);
  set("max_jing", 200);
  set("max_neili", 500);
  set("neili", 500);
  set("jiali", 50);
  set("combat_exp", 100000);

  set_skill("dodge", 100);
  set_skill("hand", 100);
  set_skill("strike", 100);
  set_skill("liuyang-zhang", 100);
  set_skill("zhemei-shou", 100);
  set_skill("unarmed", 100);
  set_skill("sword", 100);
  set_skill("tianyu-qijian", 100);
  set_skill("rouyun-steps", 100);
  map_skill("hand", "zhemei-shou");
  map_skill("dodge", "liuyang-zhang");
  map_skill("dodge", "lingxu-bu");
  map_skill("parry", "liuyang-zhang");
  map_skill("sword", "tianyu-qijian");
  map_skill("unarmed", "changquan");

  set_temp("is_riding", HIW "玉花马" NOR);
  setup();
  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  object obj;
  if (objectp(obj = present("li yan", environment(ob)))) {
    this_object()->set_leader(obj);
  }
}
