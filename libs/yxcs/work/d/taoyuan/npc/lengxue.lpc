// lengxue.c 冷老板 
#include <ansi.h>

inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create() {
  set_name("冷雪", ({ "leng xue", "leng" }));
  set("nickname", HIC "布庄老板" NOR);
  set("shen_type", 1);

  set("gender", "女性");
  set("age", 24);
  set("long",
    "冷老板是土生土长的桃源人，做了十几年的小买卖。\n");
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_temp("apply/damage", 150);

  set("combat_exp", 40000000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/hongbu",
    __DIR__ "obj/doupeng",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
