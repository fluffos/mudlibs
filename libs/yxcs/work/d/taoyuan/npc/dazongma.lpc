#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create() {
  set_name(HIM "大鬃马" NOR, ({ "dazong ma", "ma" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2 + random(3));
  set("long", "这是一匹千里宝马，日行千里，夜行八百。\n" +
    "玩家可以骑上它去指定的地方(ride)。\n");
  set("ridable", 50);
  set("int", 300);
  set("qi", 3000);
  set("max_qi", 3000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("shen_type", 0);
  set("combat_exp", 500000);
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "腹部", "尾巴", "后腿", "前腿" }));
  set("verbs", ({ "bite", "hoof" }));
  set_temp("apply/attack", 500);
  set_temp("apply/armor", 150);
  set_temp("apply/damage", 250);

  set("chat_chance", 1000000);
  set("value", 500000);

  setup();
}

void init() {
  add_action("do_ride", "ride");
  add_action("do_run", "run");
  add_action("do_unride", "unride");
}

int do_run(string arg) {
  string obj, msg, where;

  if (!arg) return notify_fail("它可以带你去你想去的地方，现在开通的线路有:
用法比如: fly gc 就到城中央广场了 
        
中央广场:       gc      逍遥派:         xy      明教:           mj 
北京:           bj      桃花岛:         th      少林:           sl
泉州:           qz      白驼山庄:       bt      古墓:           gm
新疆:           xj      黑木崖:         hm
华山派:         hs      武当山:         wd
泰山:           ts      星宿海:         xx
雪山寺:         xs      天龙寺:         tl\n");

  switch (arg) {
    case "yz":
      obj = "/d/city/guangchang";
      where = "扬州城";
      break;
    case "ty":
      obj = "/d/taoyuan/cheng";
      where = "桃源城";
      break;
    case "xj":
      obj = "/d/xingxiu/shanjiao";
      where = "新疆";
      break;
    case "bj":
      obj = "/d/city2/tian_anm";
      where = "北京城";
      break;
    case "qz":
      obj = "/d/quanzhou/zhongxin";
      where = "泉州城";
      break;
    case "xx":
      obj = "/d/xingxiu/beijiang";
      where = "星宿派";
      break;
    case "mj":
      obj = "/d/mingjiao/shanmen";
      where = "明教";
      break;
    case "sl":
      obj = "/d/shaolin/guangchang1";
      where = "少林寺";
      break;
    case "hz":
      obj = "/d/hangzhou/suti1";
      where = "杭州城";
      break;
    case "cyg":
      obj = "/d/quanzhen/damen";
      where = "重阳宫";
      break;
    case "xs":
      obj = "/d/xueshan/dadian";
      where = "雪山派";
      break;
    case "ts":
      obj = "/d/taishan/doumo";
      where = "泰山派";
      break;
    case "hs":
      obj = "/d/huashan/buwei1";
      where = "华山派";
      break;
    case "ca":
      obj = "/d/city4/center";
      where = "长安城";
      break;
    case "xy":
      obj = "/d/xiaoyao/qingcaop";
      where = "逍遥派";
      break;
    case "gm":
      obj = "/d/gumu/zhengting";
      where = "古墓派";
      break;
    case "hm":
      obj = "/d/heimuya/up1";
      where = "日月神教";
      break;
    case "wd":
      obj = "/d/wudang/sanqingdian";
      where = "武当派";
      break;
    case "th":
      obj = "/d/taohua/dating";
      where = "桃花岛";
      break;
    case "tl":
      obj = "/d/tianlongsi/damen";
      where = "天龙寺";
      break;
    case "bt":
      obj = "/d/baituo/dating";
      where = "白驼山庄";
      break;
    case "sld":
      obj = "/d/shenlong/road";
      where = "神龙岛";
      break;
    case "xkd":
      obj = "/d/xiakedao/dating";
      where = "侠客岛";
      break;
    case "em":
      obj = "/d/emei/fhs";
      where = "峨嵋山";
      break;
    case "fy":
      obj = "/d/xuedao/shanmen";
      where = "法元寺";
      break;
    case "hengs":
      obj = "/d/henshan/zhurongdian";
      where = "衡山派";
      break;
    case "yzw":
      obj = "/d/yanziwu/bozhou";
      where = "燕子坞";
      break;
    case "qzj":
      obj = "/d/quanzhen/damen";
      where = "全真教";
      break;
    default:
      return notify_fail("你不能到那里 !\n");
      return 1;
  }
  if (!environment(this_player())->query("outdoors"))
    return notify_fail("这里空间太小不能骑马！\n");

  if (stringp(msg = this_player()->query("env/msg_mout")))
    message_vision(msg + "\n", this_player());
  else {
    message_vision("$N骑着一匹「" HIM "大鬃马" NOR "」一路奔向目的地。\n" NOR, this_player());
    this_player()->move(obj);
  }

  if (arg == "run" && this_object()->query("ridable") < 4) {
    tell_object(this_player(), HIM "大鬃马" NOR "已经显得有些累了。\n");
    return 1;
  }

  else {
    message_vision("$N骑着一匹「" HIM "大鬃马" NOR "」突然出现在人群中。\n" NOR, this_player());
    this_object()->add("ridable", -2);
  }
  return 1;
}
