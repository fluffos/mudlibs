// seller.c
#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create()
{
        set_name("张万福", ({ "zhang wanfu", "zhang", "wanfu"}));
        set("title", "富豪大院总管");
        set("gender", "男性");
        set("age", 45);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);

        set("max_qi", 1500);
        set("max_jing", 1200);
        set("max_neili", 1500);
        set("neili", 1500);
        set("combat_exp", 30000+random(10000));
        set("attitude", "friendly");
        set("inquiry", ([
                "job" : (: ask_job :),
                "saoba" : (: ask_obj :),
                "finish" : (: ask_finish :),\n";
        ]));

        set_skill("dodge", 100);
        set_skill("hand", 100);
        set_skill("strike", 100);
        set_skill("unarmed", 100);
        set_skill("sword", 100);

        setup();
        carry_object("/clone/misc/cloth")->wear();
        add_money("silver", 20);
}

int do_gongzuo(){              object me;        me = this_player();             if (me->query("combat_exp")>=10000)    {                tell_object(me,"这点小事怎么敢劳您的大驾。\n");                return 1;    }      if( me->query_temp("gongzuo/xipanzi")>0)    {                tell_object(me,"快去洗盘子吧。\n");                return 1;    }      message_vision(CYN"张万福对$N说道：你去偏庭找我夫人要点盘子来洗吧。\n"NOR,me);         me->set_temp("gongzuo/xipanzi", 1);        return 1;   }int accept_object(object me, object ob){        object ob1;        if (me->query_temp("gongzuo/xipanzi")<1)        {         command("say 你没有找我要过工作吧。\n");        }        else if ( ob->query("name") != "盘子" )//        else if (strsrch(ob->query("name"), "盘子") < 0)         {            command("say 这是洗好的盘子？你不是开玩笑吧！\n");        }        else        {    message_vision(CYN"张万福对$N说道：辛苦了，这是你的工钱。\n"NOR,me);    message_vision(CYN"张万福递给$N一些银子。\n"NOR,me);                  me->delete_temp("gongzuo/xipanzi");                me->delete_temp("gongzuo/gepanzi");                if (me->query("combat_exp")>=10000)                {                  me->add("combat_exp",2);                  me->add("potential",1);                  ob1=new("/clone/money/silver");                  ob1->move(me);                   call_out("destroying", 1, this_object(), ob);                }                else if (me->query("combat_exp")< 10000)                {                me->add("combat_exp",50+random(50));                me->add("potential",50+random(50));                ob1=new("/clone/money/silver");                ob1->move(me);                 call_out("destroying", 1, this_object(), ob);                }            return 1;        }    return 0;}void destroying(object me, object obj){        return;}