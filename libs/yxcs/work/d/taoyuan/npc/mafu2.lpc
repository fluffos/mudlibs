// mafu2.c 马夫

inherit NPC;
inherit F_DEALER;

void create() {
  set_name("马夫", ({ "ma fu", "ma", "fu" }));
  set("gender", "男性");
  set("age", 42);
  set("long",
    "这位马夫正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n");
  set("combat_exp", 1000);
  set("attitude", "friendly");
  set("rank_info/respect", "马夫");
  set("vendor_goods", ({
    "/d/taoyuan/npc/ziliuma",
    "/d/taoyuan/npc/zaohongma",
    "/d/taoyuan/npc/huangbiaoma",
    "/d/taoyuan/npc/dazongma",
    "/d/taoyuan/npc/lierima",
    "/d/taoyuan/npc/zhuifengma",
    "/d/taoyuan/npc/qianlima",
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;
  mapping myfam;

  ob = this_player();

  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_buy", "buy");
  add_action("do_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say("马夫笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来买匹马吧。\n");
      break;
  }
}
