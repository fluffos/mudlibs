// cloth: wcloth.c
// Jay 3/17/96

#include <armor.h>
inherit CLOTH;

void create() {
  set_name("内裤胸罩", ({ "neiku xiongzhao", "neiku" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件色彩斑斓的内裤胸罩\n");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("value", 500);
  }
  setup();
}
