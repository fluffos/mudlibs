//hongbu.c
#include <ansi.h>
#include <armor.h>;
inherit HEAD;

void create() {
  set_name(HIR "红布" NOR, ({ "hong bu", "hongbu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long",
      "一卷红布，是红布中的上品。\n");
    set("value", 800);
    set("material", "plant");
    set_weight(10);
    set("armor_prop/armor", 0);
    set("armor_prop/personality", 3);
    set("wear_msg", "$N轻轻地把一卷$n卷在身上。\n");
    set("unequip_msg", "$N轻轻地把$n从身上拉了下来。\n");
  }
  setup();
}
