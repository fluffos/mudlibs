#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "桃源东街");
  set("long", "你走在桃源之城的东大街上，踩着坚实的青石板地面。南边是通往英
雄山庄的大门。北面是桃源城的官府，一个大皮鼓陈列的官府大门的旁边
，几个身着官服，手持钢刀的衙役正威武的站在门口把守着。一片威严之
势，让人不得不肃然起敬。\n"
  );
  set("no_clean_up", 0);
  set("outdoors", "taoyuan");
  set("exits", ([
    "east": __DIR__ "dongjie2",
    //                "south" : "/d/yinxiong/damen",
    "north": __DIR__ "yamen",
    "west": __DIR__ "dongjie",
  ]));

  setup();
  replace_program(ROOM);
}
