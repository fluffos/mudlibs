#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "不夜舫");
  set("long", "沿着小桥，你踏上不夜舫的船头，只见船头上铺设着一层红色的地毯
，显得十分尊贵。抬头仰望，不夜舫大门上挂着一块金字牌匾，上面龙飞
凤舞的写着「" HIY "不夜舫" NOR "」三个大字，两边还挂着粉红色的灯笼。站在这里，
不时可以听见不夜舫里传来阵阵嬉闹声。\n"
  );
  set("exits", ([
    "east": __DIR__ "ximen",
    "enter": __DIR__ "shangchuan",
  ]));
  set("no_clean_up", 0);
  setup();
}
