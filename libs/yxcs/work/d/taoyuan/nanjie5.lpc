#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "桃源南街");
  set("long", "你走在桃源南大街上，踩着坚实的青石板地面。大街的东面有一座庙
宇，庙宇上方写着「" HIY "城隍庙" NOR "」三个大字，据说城隍庙里的城隍老爷非常灵
验，吸引了不少善男信女前来烧香进贡。西面则是一家棺材店，棺材店里
光线昏暗，死气沉沉的，让人感到十分恐惧。\n"
  );
  set("outdoors", "taoyuan");
  set("no_clean_up", 0);
  set("exits", ([
    "south": __DIR__ "nanjie6",
    "north": __DIR__ "nanjie4",
    "west": __DIR__ "gumujiaohe",
    "east": __DIR__ "yaopu",
  ]));

  setup();
}
