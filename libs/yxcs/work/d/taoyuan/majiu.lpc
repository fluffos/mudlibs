inherit ROOM;

void create() {
  set("short", "车马店");
  set("long", @LONG
这是一个车马店，常年供应新鲜草料。桃源民风淳朴，马夫们会把
马牵到马店好生照看，将它们喂饱饮足，再洗刷得干乾净净，一直伺候到
客人上路。马店雨檐下的烂木柱上钉着一块破木牌(paizi)。
    马店中堆放著几堆草料，正中有一口泔槽。
LONG);
  set("outdoors", "taoyuan");
  set("no_beg", "1");
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/zaohongma": 1,
    __DIR__ "npc/huangbiaoma": 1,
    __DIR__ "npc/ziliuma": 1,
    __DIR__ "npc/qianlima": 1,
    __DIR__ "npc/mafu": 1,
  ]));
  set("item_desc", ([
    "paizi": @TEXT
客人们只要给马夫一些钱就可以买到一匹好马了。

TEXT ]));
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "beijie5",
  ]));
  setup();
  replace_program(ROOM);
}
