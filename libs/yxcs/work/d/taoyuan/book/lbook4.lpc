// literateb4.c 论语
inherit ITEM;
void create() {
  set_name("论语", ({ "literateb4" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本孔夫子的《论语》。\n");
    set("value", 9000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "jing_cost": 40,
      "difficulty": 25,
      "max_skill": 150,
      "min_skill": 120,
    ]));
  }
}
int query_autoload() {
  return 1;
}
