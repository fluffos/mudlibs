// lbook1.c
inherit ITEM;
void create() {
  set_name("三字经", ({ "literateb1" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "读书人必读的三字经。\n");
    set("value", 2000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "jing_cost": 10,
      "difficulty": 15,
      "max_skill": 50,
      "min_skill": 10,
    ]));
  }
}
