// lbook3.c
inherit ITEM;
void create() {
  set_name("千字文", ({ "literateb3" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "读书人必读的千字文。\n");
    set("value", 8000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "jing_cost": 30,
      "difficulty": 15,
      "max_skill": 120,
      "min_skill": 100,
    ]));
  }
}
int query_autoload() {
  return 1;
}
