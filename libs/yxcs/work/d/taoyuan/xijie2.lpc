#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "桃源西街");
  set("long", "你走在桃源城的西大街上，踩着坚实的青石板地面。南边有一家药店
，出售一些珍贵的中草药。北面是一家书院，站在这里，不时可以听见从
书院里传来阵阵朗朗的读书声。\n"
  );
  set("outdoors", "taoyuan");
  set("exits", ([
    "east": __DIR__ "xijie1",
    "north": __DIR__ "xiaoxue",
    "west": __DIR__ "xijie3",
    "south": __DIR__ "huichunt",
  ]));

  setup();
}
