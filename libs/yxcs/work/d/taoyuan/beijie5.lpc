// beijie.c 桃源北街
// 2001/12/06 by 若雨(ruoyu) email:ruoyu_st@163.com

#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "桃源北街");
  set("long", "这里是桃源城的北大街上，踩着坚实的青石板地面。东边是桃源城里
的一间车马店，专门出售一些良种的马匹。西边是桃源城环境最美最宁静
的大槐树园。站在这里，可以看见北面的一座庙宇，庙宇上方挂着一块牌
子，上面写着「" HIY "关帝庙" NOR "」三个大字。\n"
  );
  set("outdoors", "taoyuan");

  set("exits", ([
    "south": __DIR__ "beijie4",
    "east": __DIR__ "majiu",
    "west": __DIR__ "daguishulin",
    "north": __DIR__ "beijie6",
  ]));

  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
