#include <ansi.h>

inherit NPC;

void create() {
  object me = this_player();
  set_name("信息通告", ({ "news" }));
  set("long", "本 Mud 宣传部所属的宣传工作人员。\n");

  set("age", 20);
  set("gender", "男性");

  set("max_qi", 100000);
  set("combat_exp", 1999999999999999999200010000000);

  set("channel_id", "信息通告");

  setup();

  call_out("on_time", 10);

}

void on_time() {
  string msg;


  msg = "\n永恒天堂 (IP: yhtt.d2g.com Port: 5555)\n            1月8日全新开站，欢迎大家加入游戏！\n";


  CHANNEL_D->do_channel(this_object(), "es",
    "" + msg + "");
  call_out("on_time", 12);
}
