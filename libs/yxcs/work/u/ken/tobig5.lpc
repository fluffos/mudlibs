inherit F_CLEAN_UP;
#define CONVERT "/adm/daemons/languaged.lpc"
int help(object me);
int to_big5(string file);

int main(object me, string arg) {
  string file;
  if (!arg || arg == "")
    return help(me);

  seteuid(geteuid(this_player(1)));

  file = resolve_path(me->query("cwd"), file);

  if (file_size(file) > 0)
    to_big5(file);
  return 1;
}


int to_big5(string file) {
  string *text, *strings, line;
  int i, j;

  j = 0;

  if (file_size(file) < 1)
    return 0;
  text = explode(read_file(file), "\n");
  rm(file);

  for (i = 0; i < sizeof(text); i++) {
    text[i] = CONVERT->toBig5(text[i]);
    write_file(file, text[i] + "\n");
  }

  write(file + "己成功转换成BIG5码。\n");
  return 1;

}

int help(object me) {
  write(@HELP 
      指令格式: tobig5 <file> . 
       
      这个指令可以把一个GB码的文件转换成BIG5码，如果你在使用的过程中发现问题， 
      欢迎发信到 NETKEN@HONGKONG.COM 求助。 
      HELP 
      );       
      
      return 1; 
}

