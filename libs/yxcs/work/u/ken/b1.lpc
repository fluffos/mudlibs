inherit F_CLEAN_UP;
#define CONVERT "/adm/daemons/languaged.lpc"

int help(object me);
int to_big5(string file);

int main(object me, string arg) {
  string file;
  if (!arg || arg == "")
    return help();

  seteuid(geteuid(this_player(1)));

  file = resolve_path(me->query("cwd"), file);
  if (file_size(file) > 0)
    to_big5(file);
  return 1;
}


int to_big5(string file) {
  string *text, *strings, line;
  int i, j;

  j = 0;

  if (file_size(file) < 1)
    return 0;
  text = explode(read_file(file), "\n");
  rm(file);

  for (i = 0; i < sizeof(text); i++) {
    text[i] = CONVERT->toBig5(text[i]);
    write_file(file, text[i] + "\n");
  }

  write(file + "Θ锣传ΘBIG5絏\n");
  return 1;

}

int help(object me) {
  write(@TEXT 
      Α: tobig5 <file>. 
       
      硂рGB絏ゅン锣传ΘBIG5絏
      狦ㄏノ筁祘い祇瞷拜肈 
      舧祇獺 NETKEN@HONGKONG.COM ― 
      TEXT );       
      return 1; 
} 
