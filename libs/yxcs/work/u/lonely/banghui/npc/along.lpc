#include <ansi.h>
inherit BHNPC;

string query_save_file() { return DATA_DIR + "npc/阿普都拉"; }
void create() {
  set_name("阿普都拉", ({ "along" }));
  this_object()->init_bhnpc();
  set("area_name", "伊斯兰圣墓");
  set("area_file", "/d/quanzhou/zhongxin.lpc");
  set("ziyuan", "可兰经");
  set("kaifa", 20);
  set("jizhi", 25);
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
#include <die.h>
