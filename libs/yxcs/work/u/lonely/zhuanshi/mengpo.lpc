//modified by lonely@yxcs
#include <ansi.h>
inherit NPC;

void create() {
  set_name(RED "孟婆" NOR, ({ "meng po", "po" }));

  set("long",
    "一位慈祥的老太婆，喝了她的孟婆汤了却了前世的恩怨，就去投胎吧。\n");
  set("attitude", "peaceful");
  set("age", 1200);
  set("combat_exp", 10000000);
  set("max_jing", 100000);
  set("max_qi", 100000);
  set("max_neili", 100000);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_temp("apply/armor", 500);
  set_temp("apply/damage", 500);
  setup();
  carry_object("/clone/misc/cloth")->wear();
}


void init() {
  object me = this_player();

  if (me->query_temp("difu/huanhun")) {
    add_action("do_decide", "decide");
    call_out("greeting_ob", 2, me);
  }
}

int greeting_ob(object me) {
  object ob = this_object();

  message_vision("$N" + HIB "看了看$n，怜惜地说道：“"
    +RANK_D->query_respect(me) + "，事已至此，不必难过了，还是喝下这碗\n"
    + "孟婆茶，了却前世恩怨及早投胎去吧。”\n" NOR, ob, me);
  write(HIC "\n如果决定了就下决定(decide)吧。\n");
  return 1;
}

int do_decide() {
  object me = this_player();

  if (me->query_temp("difu/decide")) {
    write("这是做什么，你想投几次胎呀？\n");
    return 1;
  }
  me->set_temp("difu/decide", 1);
  message_vision(RED "$N接过孟婆茶，一咬牙，一口全灌了下去。\n" NOR, me);
  call_out("do_toutai", 10, me);
  return 1;
}

int do_toutai(object me) {
  int i, exp, level;
  /*
    mapping pmap; 
    string* sk;
*/
  string *skills;
  mapping all_skills;

  if (me->query("gender") == "无性")
    me->set("gender", random(2) ? "男性" : "女性");
  me->set("shen", 0);
  me->set("PKS", 0);
  me->set("MKS", 0);
  me->set("betrayer", 0);
  me->set("GUILT", 0);
  me->set("DIED", 0);
  me->set("age", 14);
  me->add("zhuanshi/times", 1);
  me->set("zhuanshi/jineng", 1);
  me->set("birthday", time());
  me->set("mud_age", 0);
  me->delete("family");
  me->delete("class");
  me->set("title", "普通百姓");
  me->set("combat_exp", me->query("combat_exp") / 100);
  me->set("learned_points", 0);
  me->set("potential", me->query("combat_exp") / 30);
  me->set("biwu", 0);
  me->set("max_neili", me->query("combat_exp") / 1000);
  me->set("max_qi", me->query("max_neili") / 2);
  me->set("max_jing", 2000);
  me->set("max_jingli", 5000);
  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("eff_qi"));
  me->set("eff_jing", 100);
  me->add("str", 5);
  me->add("dex", 5);
  me->add("con", 5);
  me->add("int", 5);
  me->add("per", 5);
  me->add("kar", 5);
  me->delete("chousha_quest");
  me->delete("guo_shoucheng");
  me->delete("kill_quest");
  me->delete("quest_yunbiao");
  me->delete("shan_quest");
  me->delete("degree");
  me->delete("score");
  me->delete("meili");
  me->delete("degree_ask");
  me->delete("degree_jungong");
  me->delete("gift");
  me->delete("couple");
  me->delete("married");
  me->delete("luohan_winner");
  me->delete("letter");
  me->delete("quest");
  me->delete("quest_factor");
  me->delete("quest_time");
  me->delete("weiwang");
  me->delete("money");
  me->delete("more_money");
  me->delete("lonely/duguqiubai");
  me->delete("pawn");
  me->delete("store_ob");

  /*
    pmap = me->query_skill_prepare();
    if (!pmap) pmap = ([]);

    if( mapp(pmap) && sizeof(pmap) > 0 )
    {
       sk = keys(pmap);
       for (i=0; i<
sizeof(sk); i++)
       me->prepare_skill(sk[i]); 
    }
    sk = keys(me->query_skills());       
    for(i = 0; i<sizeof(sk); i++)
    {
            me->map_skill(sk[i]);               
            map_delete(me->query_skills(), sk[i]);
            me->set_skill(skills[i],400);
    }
*/
  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++)
    this_player()->set_skill(skills[i], 400);
  message_vision(HIB "孟婆忽然一把将$N推下了投生河，$N不禁大叫一声，"
    + "然后就什么都不知道了.....\n" NOR, me);
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--破元大法(special yuan)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--越空提升(special sheng)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--神魔金身(special jin)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--朱蛤奇缘(special dispel)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--诡辩奇学(special bian)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--六阴鬼脉(Auto special)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--遁影擒踪(Auto special)！\n" NOR, users());
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "获得转世技能--阴阳九转十二天(jiuzhuan-12tian)！\n" NOR, users());

  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "转世投胎，再度为人了！\n" NOR, users());

  me->set_ghost(0);
  exp = me->query("combat_exp");
  level = ceil(pow(exp * 10.0, 0.333333));
  //    me->set_skill("force",level);
  me->set_skill("force", 1000);
  me->set_skill("literate", 2100);
  me->set("zhuanshi/exp", exp);
  me->set("special_skill/yuan", 1);
  me->set("special_skill/sheng", 1);
  me->set("special_skill/jin", 1);
  me->set("special_skill/bian", 1);
  me->set("special_skill/dispel", 1);
  me->set_skill("jiuzhuan-12tian", 400);
  me->set_skill("qimen-flee", 3000);

  me->set("lygm", 1);
  me->move("/d/city/wumiao");
  me->delete_temp("linji");
  me->delete_temp("difu");
  me->save();
  me->unconcious();
  me->reset_action();
  return 1;
}
