#include <ansi.h>

inherit F_CLEAN_UP;
#include "/banghui/npc_need.h"

int main(object me, string arg) {
  object ob, *target;
  string banghui, n1, n2;
  int money, i, flag;
  object lingpai;
  mapping data;
  string *what, stuffid, stuffname;
  string name;

  if (!(banghui = me->query("banghui/name")))
    return notify_fail("你没有参加任何帮会，无法邀请他人加入。\n");

  lingpai = new("/banghui/obj/lingpai");
  lingpai->create(banghui);
  if (lingpai->query("no_use")) {
    destruct(lingpai);
    return notify_fail("你的帮会文件有问题，快与巫师联系吧。\n");
  }

  flag = 0;
  if (lingpai->query("bangzhu_id") == me->query("id")
    || (stringp(me->query("banghui/rank")) &&
      (string)me->query("banghui/rank") == "副帮主"))
    flag = 1;
  destruct(lingpai);

  if (!arg)
    return notify_fail("你要邀请谁加入你的帮会？\n");

  if (me->query("id") == arg)
    return notify_fail("邀请自己？！\n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这儿有没这么个人。\n");
  if (!ob->is_character())
    return notify_fail("你只能邀请「人」加入你的帮会。\n");
  if (ob->query("banghui/name") == me->query("banghui/name"))
    return notify_fail(ob->query("name") + "已经是本帮弟兄了。\n");
  if (me->is_fighting() || me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (ob->is_fighting() || ob->is_busy())
    return notify_fail("对方正忙着呢。\n");
  if (!living(ob)) return notify_fail("你得先弄醒他再说。\n");
  if (userp(ob) && !flag)
    return notify_fail("你无权邀请玩家加入「" + banghui + "」！\n");

  message_vision("$N邀请$n参加帮会「" + banghui + "」。\n", me, ob);
  if (!userp(ob)) {
    if (!ob->query("zhengzhao"))
      return notify_fail("看样子" + ob->query("name") +
        "对你的帮会没有兴趣。\n");
    switch (ob->query("zhengzhao")) {
      case 1: if ((!(banghui = ob->query("banghui/name")) ||
        ob->query("zhongcheng") < me->query_per()) &&
        ob->query("qi") * 100 > ob->query("max_qi") * 80) {
        message_vision("$N对$n说道：“即是如此，你我不如切磋(qiecuo)一下武功如何？”\n", ob, me);
        ob->set_temp("zhengzhao/who", me);
        return 1;
      }
      message_vision("$N冲着$n笑道：“我可不敢高攀贵帮啊。”\n", ob, me);
      return 1;
      case 2: if (!(banghui = ob->query("banghui/name")) ||
        ob->query("zhongcheng") < me->query_per()) {
        money = ob->query("combat_exp") / 10000;
        if (money < 1) money = 1;
        message_vision("$N「嘿嘿」了几声，对$n道：“" +
          chinese_number(money) + "两黄金，少一个子也不行。　盶n", ob, me);
        ob->set_temp("zhengzhao/who", me);
        ob->set_temp("zhengzhao/money", money);
        return 1;
      }
      message_vision("$N冲着$n笑道：“我可不敢高攀贵帮啊。”\n", ob, me);
      return 1;
      case 3: if (!(banghui = ob->query("banghui/name")) ||
        ob->query("zhongcheng") < me->query_per()) {
        data = ob->query_temp("zhengzhao/who");
        if (!mapp(data)) data = ([]);
        target = keys(data);
        if (member_array(me->query("id"), target) != -1) {
          sscanf(data[me->query("id")], "%s:%s", stuffid, stuffname);
          message_vision("$N对$n大声道：我不是说过了吗？把" + stuffname + "(" + stuffid + ")给我找来！\n", ob, me);
          return 1;
        }
        if (sizeof(target) >= 4) {
          message_vision("$N笑道：承蒙大家看得起，" + RANK_D->query_respect(ob) + "不胜感激。\n", ob);
          return 1;
        }
        what = keys(npcneed);
        stuffid = what[random(sizeof(what))];
        stuffname = npcneed[stuffid];
        data[me->query("id")] = stuffid + ":" + stuffname;
        ob->set_temp("zhengzhao/who", data);
        message_vision("$N冲着$n道：只要你能在三分钟之内把" +
          stuffname + "(" + stuffid + ")" +
          "给我找来，一切好商量。\n", ob, me);
        call_out("delete_target", 180, ob, me->query("id"));
        return 1;
      }
      message_vision("$N冲着$n笑道：“我可不敢高攀贵帮啊。”\n", ob, me);
      return 1;
    }
  } else {
    tell_object(ob, "如果你愿意加入对方的帮会，请使用join " + me->query("id") + "。\n");
    ob->set_temp("zhengzhao/who", me);
    return 1;
  }
}

void delete_target(object npc, string name) {
  mapping data;
  if (!objectp(npc)) return;
  data = npc->query_temp("zhengzhao/who");
  if (!mapp(data)) return;
  map_delete(data, name);
  npc->set_temp("zhengzhao/who", data);
  return;
}

int help(object me) {
  write(@HELP
指令格式：yaoqing <某人>
这个指令用来邀请某人加入你的帮会。
某人可以是玩家或是可征招的NPC。
注意：邀请玩家加入帮会，你必须是帮
会的帮主，或由帮主任命(renming)的
副帮主。

HELP
  );
  return 1;
}
