inherit ITEM;
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name("礼物", ({ "liwu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗巫师为换钱发的礼物。\n");
  }
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("hq", 1))
    return notify_fail("你还想吃呀？当心我杀你的档。\n");
  me->add("balance", 200000000);
  me->set("hq", 1);
  message_vision("$N的银行存款增加了2万gold！\n", this_player());
  destruct(this_object());
  return 1;
}
