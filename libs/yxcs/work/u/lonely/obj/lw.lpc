inherit ITEM;
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name("礼物", ({ "liwu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗巫师发的礼物。\n");
  }
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->delete("title");
  me->set("title", HIY "「" + "云鹤山庄" + "」" + "庄主" + " " NOR);
  message_vision("$N吃下一颗礼物,感觉到自己又厉害多了。\n", this_player());
  destruct(this_object());
  return 1;
}
