#include <login.h>
#include <ansi.h>
inherit F_CLEAN_UP;

#define RENWU "/adm/etc/renwu"

int main(object me) {
  string *list, wiz, quest, w_class, class1, class2, class3, class4;
  mapping quests = ([]);
  mapping w_classes = ([]);
  object ob;
  int count, i, c1, c2, c3, c4;

  if (file_size(RENWU))
    foreach (string str in explode(read_file(RENWU), "\n")) {
      if (str[0] == '#' || sscanf(str, "%s %s %s", wiz, w_class, quest) == 3) {
        w_classes += ([ wiz: w_class ]);
        quests += ([ wiz: quest ]);
      } else if (str[0] == '#' || sscanf(str, "%s %s", wiz, w_class) == 2) {
        w_classes += ([ wiz: w_class ]);
        quests += ([ wiz: "nothing" ]);
      } else continue;
    }

  list = SECURITY_D->query_wizlist();

  class1 = ""; class2 = "";
  class3 = ""; class4 = "";

  c1 = 0; c2 = 0; c3 = 0; c4 = 0;
  count = 0;

  for (i = 7; i > 0; i--) {
    foreach (wiz in list) {
      if (wiz_level(wiz) == i) {
        switch (w_classes[wiz]) {
          case "TDD":
            c1++;
            count++;
            if (objectp(ob = find_player(wiz)))
              class1 += ((c1 - 1) % 2 ? "" : "\n") + "(" + HIG + wiz + NOR ")";
            else
              class1 += ((c1 - 1) % 2 ? "" : "\n") + "(" + wiz + ")";

            if (undefinedp(quests[wiz]) || quests[wiz] == "nothing")
              class1 += "(" HIW + "暂无任务" + NOR ")\t\t\t";
            else if (strlen(quests[wiz]) < 31)
              class1 += "(" YEL + quests[wiz] + NOR ")\t\t\t";
            else class1 += "(" YEL + quests[wiz] + NOR ")\t\t";
            break;

          case "CCD":
            c2++;
            count++;
            if (objectp(ob = find_player(wiz)) && me->visible(ob))
              class2 += ((c2 - 1) % 2 ? "" : "\n") + "(" + HIG + wiz + NOR ")";
            else
              class2 += ((c2 - 1) % 2 ? "" : "\n") + "(" + wiz + ")";

            if (undefinedp(quests[wiz]) || quests[wiz] == "nothing")
              class2 += "(" HIW + "暂无任务" + NOR ")\t\t\t" NOR;
            else if (strlen(quests[wiz]) < 31)
              class2 += "(" MAG + quests[wiz] + NOR ")\t\t\t";
            else class2 += "(" MAG + quests[wiz] + NOR ")\t\t";
            break;

          case "HP":
            c3++;
            count++;
            if (objectp(ob = find_player(wiz)) && me->visible(ob))
              class3 += ((c3 - 1) % 2 ? "" : "\n") + "(" + HIG + wiz + NOR ")";
            else
              class3 += ((c3 - 1) % 2 ? "" : "\n") + "(" + wiz + ")";

            if (undefinedp(quests[wiz]) || quests[wiz] == "nothing")
              class3 += "(" HIW + "暂无任务" + NOR ")\t\t\t" NOR;
            else if (strlen(quests[wiz]) < 31)
              class3 += "(" HIC + quests[wiz] + NOR ")\t\t\t";
            else class3 += "(" HIC + quests[wiz] + NOR ")\t\t";
            break;

          default:
            c4++;
            count++;
            if (objectp(ob = find_player(wiz)) && me->visible(ob))
              class4 += ((c4 - 1) % 2 ? "" : "\n") + "(" + HIG + wiz + NOR ")";
            else
              class4 += ((c4 - 1) % 2 ? "" : "\n") + "(" + wiz + ")";

            if (undefinedp(quests[wiz]) || quests[wiz] == "nothing")
              class4 += "(" HIW + "暂无任务" + NOR ")\t\t\t" NOR;
            else if (strlen(quests[wiz]) < 31)
              class4 += "(" HIG + quests[wiz] + HIG ")\t\t\t";
            else class4 += "(" HIG + quests[wiz] + HIG ")\t\t";
            break;
        }
      }
    }
  }

  write(HIR "〖" BBLU HIW "永恒天堂" NOR HIR "〗" NOR + "目前的开发组成员有：\n");

  if (strlen(class1) > 10) {
    write(HIY "\n" NOR "━━━━━━━━━━━━━〖" HBRED "技术开发部" NOR + "〗━━━━━━━━━━━━━━" HIY "\n" NOR);
    write(class1);
  }

  if (strlen(class2) > 10) {
    write(HIY "\n" NOR "━━━━━━━━━━━━━〖" HBCYN "行政管理部" NOR + "〗━━━━━━━━━━━━━━" HIY "\n" NOR);
    write(class2);
  }

  if (strlen(class3) > 10) {
    write(HIY "\n" NOR "━━━━━━━━━━━━━〖" HBMAG "荣誉玩家部" NOR + "〗━━━━━━━━━━━━━━" HIY "\n" NOR);
    write(class3);
  }

  if (strlen(class4) > 10) {
    write(HIY "\n" NOR "━━━━━━━━━━━━━〖" HBYEL "在野巫师部" NOR + "〗━━━━━━━━━━━━━━" HIY "\n" NOR);
    write(class4);
  }

  write(HIY "\n" NOR "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" HIY "\n" NOR);
  write("合共有: " HIR + chinese_number(count) + NOR " 位。");
  write("其中" HIG "亮绿色" NOR "的表示在线。\n");

  return 1;
}
