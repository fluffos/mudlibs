#include <armor.h>

inherit CLOTH;

void create() {
  set_name("天蝎圣衣", ({ "tianxie shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("no_zm", 1);
    set("12gong", 1);

    set("armor_prop/armor", 55);
  }
  setup();
}
