// by happ@YSZZ

inherit NPC;

void create() {
  set_name("可洛诺斯", ({ "kelowooz two" }));
  set("long", "传说中的作物之神，守护着摩羯座.\n");
  set("gender", "男性");
  set("title", "【作物之神】");
  set("age", 37);
  set("con", 45);
  set("per", 30);
  set("str", 63);
  set("int", 64);
  set("dex", 350);
  set("combat_exp", 5000000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "可洛诺斯说道：不知何时能再见到雅典娜！\n"
  }));
  set_skill("dodge", 5330);
  set_skill("force", 5330);
  set_skill("parry", 5330);
  set_skill("unarmed", 5330);
  set_skill("sword", 5330);
  set_skill("westsword", 5330);
  set_skill("boxing", 5330);
  set_skill("balei", 5330);
  set_skill("spells", 5330);
  set_skill("renma", 5330);
  map_skill("sword", "westsword");
  map_skill("unarmed", "boxing");
  map_skill("spells", "renma");
  map_skill("dodge", "balei");
  set("max_neili", 2500);
  set("neili", 13000);
  set("max_mana", 600000);
  set("mana", 12000000);
  set("mana_factor", 2300);
  set("force_factor", 2200);
  set("qi", 5000000);
  set("jing", 5000);
  set("max_jingli", 5000);
  set("jingli", 1200);
  set("jiali", 2000);

  setup();
  carry_object(__DIR__ "obj/mj_cloth")->wear();
  carry_object("/d/obj/weapon/sword/westsword")->wield();
}

void init() {
  remove_call_out("check_me");
  call_out("check_me", 12);
}
void check_me() {
  command("say 我先走一步了!\n");
  destruct(this_object());
}
