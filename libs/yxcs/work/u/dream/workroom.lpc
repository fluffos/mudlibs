#include <ansi.h>
inherit ROOM;
#include <room.h>
void lose(object me);
void create() {
  set("short", HIR "风雨小楼" NOR);
  set("long", @LONG

                           [41;1m[1;36m风  雨  小  楼[2;37;0m


        [41;1m[1;32m┌─┐[2;37;0m[31m。  ∴[2;37;0m[1;36m______[2;37;0m                              [41;1m[1;32m┌─┐[2;37;0m
        [41;1m[1;32m│九│[2;37;0m [5m[1;37m☆[2;37;0m      [1;36m（(_  ∴°[2;37;0m                       [41;1m[1;32m│一│[2;37;0m
        [41;1m[1;32m│霄│[2;37;0m  [5m[1;32m★[2;37;0m    [1;31m_.;@@)[2;37;0m   [33m  _[2;37;0m                      [41;1m[1;32m│腔│[2;37;0m
        [41;1m[1;32m│正│[2;37;0m[37m 。∴[2;37;0m [5m[1;37m☆[2;37;0m         [33m |_)[2;37;0m                     [41;1m[1;32m│豪│[2;37;0m
        [41;1m[1;32m│气│[2;37;0m                 [33m)|_)[2;37;0m                     [41;1m[1;32m│情│[2;37;0m
        [41;1m[1;32m│快│[2;37;0m                 [33m)|_)[2;37;0m                     [41;1m[1;32m│遍│[2;37;0m
        [41;1m[1;32m│意│[2;37;0m           [33m._i____|___-/~_~_~_~[2;37;0m           [41;1m[1;32m│洒│[2;37;0m
        [41;1m[1;32m│江│[2;37;0m        [36m\~~~~~~~~~ ~_~_~_~_~_~[2;37;0m            [41;1m[1;32m│天│[2;37;0m
        [41;1m[1;32m│湖│[2;37;0m         [36m ~ ~_~_~_~_~_~_~_ ~  [2;37;0m            [41;1m[1;32m│地│[2;37;0m
        [41;1m[1;32m└─┘[2;37;0m                                          [41;1m[1;32m└─┘[2;37;0m

                   [5m[1;34m流水潺潺锦鲤戏 花影无痕月难全[2;37;0m

LONG

  );
  set("chat_room", 1);
  set("valid_startroom", 1);
  setup();
  set("freeze", 1);
  setup();
}
void init() {
  add_action("do_open", "open");
  add_action("do_save", "save");
  add_action("do_confine", "confine");
  add_action("do_wake", "wake");
}

string do_open(string arg) {
  object obj;
  object me = this_player();
  if ((string)geteuid(me) != "dream") return "";
  if (!arg || arg == "") return "你想打开哪个方向的门。\n";
  if (arg == "gc") {

    message_vision("$N举手一指，你突然看见眼前出现了一条通向广场的路。\n", me);
    if (!query("exits/gc")) {
      set("exits/gc", "/d/city/guangchang");
      call_out("close_path", 60);
      remove_action("do_open", "open");
    }
    return "";
  } else return "你想打开哪个方向的门。\n";
}

void close_path() {
  if (!query("exits")) return;
  message("vision",
    "一眨眼间，所有的出路都不见了。\n",
    this_object());
  delete("exits");
  add_action("do_open", "open");
}

int do_save() {
  object obj;
  object me = this_player();
  if ((string)me->query("id") == "dream") {
    write("当你下次连线进来时，会从这里开始。\n");
    return 1;
  }
  me->move("/d/city/guangchang");
  return 1;
}

string do_confine(string arg) {
  object obj;
  object me = this_player();
  if ((string)geteuid(me) != "dream") {
    message_vision("$N突然觉得一阵天旋地转，晕了过去。\n", me);
    lose(me);
    return "";
  }
  if (!arg || arg == "") return "你想关谁的禁闭？。\n";
  if (!obj = present(arg, this_object())) {
    if (!obj = find_living(arg)) return "你想关谁的禁闭？。\n";
    obj->move(this_object());
  }
  message_vision("$N大手一煽，" + obj->name() + "突然觉得一阵天旋地转，晕了过去。\n", me);
  lose(obj);
  return "";
}

string do_wake(string arg) {
  object obj;
  object me = this_player();
  if ((string)geteuid(me) != "dream") {
    message_vision("$N突然觉得一阵天旋地转，晕了过去。\n", me);
    lose(me);
    return "";
  }
  if (!arg || arg == "") return "你想唤醒谁？。\n";
  if (!obj = present(arg, this_object())) return "你想唤醒谁？。\n";
  message_vision("$N大手一煽，" + obj->name() + "“哎”了一声，醒转过来。\n", me);
  obj->revive();
  return "";
}

void lose(object me) {
  me->set_temp("disable_command", 1);
  me->set_temp("block_msg/all", 1);
  COMBAT_D->announce(me, "unconcious");
}
