//b4-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create() {
  set_name(HIG "超级力量护腕" NOR, ({ "chaoji huwan", "huwan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "当你看着它时它发出翁翁的响声好象有什么东西要从里面爆发出来。\n");
    set("unit", "双");
    set("value", 9000);
    set("material", "wrists");
    set("armor_prop/armor", 20000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N戴上一双" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将手上的" + "$n" NOR + "取了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
