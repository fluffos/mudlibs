// 判官笔

#include <weapon.h>
// AGENTS.md #11: this file's own content (id "pen"/"panguanbi", long
// description "这是一柄普通的精钢剑" -- "an ordinary fine steel SWORD")
// disagrees with the original `inherit PEN;`/`init_pen()` -- PEN was never
// a defined macro anywhere in this lib (only PIN, a different weapon type
// meaning "针"/needle, exists) and init_pen() was never a real function
// either; a working sibling copy of this same item at
// /d/obj/weapon/sword/panguanbi.lpc correctly uses SWORD/init_sword(), so
// this is a copy-paste-and-half-rename artifact, fixed to match.
inherit SWORD;

void create() {
  set_name("判官笔", ({ "panguanbi", "pen" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "这是一柄普通的精钢剑，一般的剑客都配带此剑。\n");
    set("value", 1500);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一对$n握在手中。\n");
    //		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(25);
  setup();
}
