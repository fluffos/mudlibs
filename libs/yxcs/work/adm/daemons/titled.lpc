string test(string fam_name) {
  if (!fam_name || member_array(fam_name, family) == -1)
    return "没有这个门派";
  return "" + query("title/" + fam_name + "/100") + "";
}
string get_title(object player, string fam_name) {
  int exp;
  string my_title;
  exp = player->query("combat_exp");

  if (!fam_name || member_array(fam_name, family) == -1 || fam_name == "NO_FAMILY") {
    //                return "NO_FAMILY"; // 因为还没有想好名称。所以暂时不做改动。
    if (exp < 5000000)
      return CYN "江湖浪子" NOR;
    else return CYN "淡薄名利 无意功名的隐士" NOR;
  }

  else {
    if (exp < 1000000) {
      my_title = query("title/" + fam_name + "/10");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 5000000) {
      my_title = query("title/" + fam_name + "/50");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 10000000) {
      my_title = query("title/" + fam_name + "/100");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 20000000) {
      my_title = query("title/" + fam_name + "/150");
      //                printf("my_title is "+my_title+"\n");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 40000000) {
      my_title = query("title/" + fam_name + "/200");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 60000000) {
      my_title = query("title/" + fam_name + "/300");
      return HIC "" + my_title + "" NOR;
    }
    if (exp < 80000000) {
      my_title = query("title/" + fam_name + "/400");
      return HIC "" + my_title + "" NOR;
    }
    my_title = query("title/" + fam_name + "/500");
    return HIC "" + my_title + "" NOR;
  }

  return "NO_FAMILY";
}
