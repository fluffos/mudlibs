//modified by lonely@yxcs 2002.01.15
inherit F_CLEAN_UP;
int check_item(string item);

int main(object me, string arg) {
  object ob, lp;
  string name, item, zhiwei, id, n1, n2;
  string banghui;
  int rank_lv, flag;
  if (!(banghui = me->query("banghui")))
    return notify_fail("你没有参加任何帮会，无法任命别人职位。\n");

  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("no_use")) {
    destruct(lp);
    return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
  }
  flag = 0;
  if (lp->query("bangzhu_id") == me->query("id")
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s舵主%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s坛主%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s副帮主%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s堂主%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s长老%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s护法%s", n1, n2) == 2)
    || (stringp(me->query("bh_rank")) &&
      sscanf((string)me->query("bh_rank"), "%s香主%s", n1, n2) == 2))
    flag = 1;
  destruct(lp);
  if (!arg)
    return notify_fail("指令格式：renming <某人> <职务>或renming <某人> <部门> <职务>\n");
  if (!flag)
    return notify_fail("你无权任命别人职位！\n");
  if (sscanf(arg, "%s %s %s", id, item, zhiwei) == 3) {
    ob = present(id, environment(me));
    if (!ob) return notify_fail("这儿没有这么个人。\n");
    if (!ob->is_character())
      return notify_fail("看清楚，那并不是人！\n");
    if (!userp(ob)) return notify_fail("你只对本帮会的玩家使用这条命令！\n");
    if (banghui != (string)ob->query("banghui"))
      return notify_fail("你只对本帮会的玩家使用这条命令！\n");
    if (me->is_busy() || me->is_fighting())
      return notify_fail("你正忙着呢！\n");
    if (ob->is_busy() || ob->is_fighting())
      return notify_fail("对方正忙着呢！\n");
    if (!check_item(item))
      return notify_fail("您任命的职务必须是中文，且为二到八字！\n");
    if (zhiwei != "护法" && zhiwei != "舵主" && zhiwei != "坛主" && zhiwei != "堂主" && zhiwei != "香主" && zhiwei != "门人" && zhiwei != "帮众")
      return notify_fail("任命的职位至上而下为：护法,舵主,坛主,堂主,香主,门人,帮众。\n");
    if (sscanf((string)me->query("bh_rank"), "%s护法%s", n1, n2) == 2 &&
      zhiwei == "护法")
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s舵主%s", n1, n2) == 2 &&
      (zhiwei == "护法" || zhiwei == "舵主" || zhiwei == "坛主" || zhiwei == "堂主" || zhiwei == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s坛主%s", n1, n2) == 2 &&
      (zhiwei == "护法" || zhiwei == "舵主" || zhiwei == "坛主" || zhiwei == "堂主" || zhiwei == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s堂主%s", n1, n2) == 2 &&
      (zhiwei == "护法" || zhiwei == "舵主" || zhiwei == "坛主" || zhiwei == "堂主" || zhiwei == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s香主%s", n1, n2) == 2 &&
      (zhiwei == "护法" || zhiwei == "舵主" || zhiwei == "坛主" || zhiwei == "堂主" || zhiwei == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (zhiwei == "护法") {
      ob->set("bh/rank_lv", 4);
    }
    if (zhiwei == "舵主" || zhiwei == "坛主" || zhiwei == "堂主" || zhiwei == "香主") {
      ob->set("bh/rank_lv", 3);
    }
    if (zhiwei == "门人") {
      ob->set("bh/rank_lv", 2);
    }
    if (zhiwei == "帮众") {
      ob->set("bh/rank_lv", 1);
    }
    ob->set("bh_rank", item + zhiwei);
    message_vision("$N任命$n为「" + banghui + "」" + item + "" + zhiwei + "！\n", me, ob);
    return 1;
  }
  if (sscanf(arg, "%s %s", id, name) == 2) {
    ob = present(id, environment(me));
    if (!ob) return notify_fail("这儿没有这么个人。\n");
    if (!ob->is_character())
      return notify_fail("看清楚，那并不是人！\n");
    if (!userp(ob)) return notify_fail("你只对本帮会的玩家使用这条命令！\n");
    if (banghui != (string)ob->query("banghui"))
      return notify_fail("你只对本帮会的玩家使用这条命令！\n");
    if (me->is_busy() || me->is_fighting())
      return notify_fail("你正忙着呢！\n");
    if (ob->is_busy() || ob->is_fighting())
      return notify_fail("对方正忙着呢！\n");
    if (name != "副帮主" && name != "长老" && name != "护法" && name != "舵主" && name != "坛主" && name != "堂主" && name != "香主" && name != "门人" && name != "帮众")
      return notify_fail("任命的职位至上而下为：副帮主，长老, 护法, 舵主, 坛主, 堂主, 香主, 门人, 帮众 。\n");
    if (sscanf((string)me->query("bh_rank"), "%s副帮主%s", n1, n2) == 2 &&
      name == "副帮主")
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s长老%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s护法%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老" || name == "护法"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s舵主%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老" || name == "护法" || name == "舵主" || name == "坛主" || name == "堂主" || name == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s坛主%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老" || name == "护法" || name == "舵主" || name == "坛主" || name == "堂主" || name == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s堂主%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老" || name == "护法" || name == "舵主" || name == "坛主" || name == "堂主" || name == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (sscanf((string)me->query("bh_rank"), "%s香主%s", n1, n2) == 2 &&
      (name == "副帮主" || name == "长老" || name == "护法" || name == "舵主" || name == "坛主" || name == "堂主" || name == "香主"))
      return notify_fail("你无权任命别人这个职位！\n");
    if (name == "副帮主") {
      ob->set("bh/rank_lv", 6);
    }
    if (name == "长老") {
      ob->set("bh/rank_lv", 5);
    }
    if (name == "护法") {
      ob->set("bh/rank_lv", 4);
    }
    if (name == "舵主" || name == "坛主" || name == "堂主" || name == "香主") {
      ob->set("bh/rank_lv", 3);
    }
    if (name == "门人") {
      ob->set("bh/rank_lv", 2);
    }
    if (name == "帮众") {
      ob->set("bh/rank_lv", 1);
    }
    ob->set("bh_rank", name);
    message_vision("$N任命$n为「" + banghui + "」" + name + "！\n", me, ob);
    return 1;
  } else return notify_fail("指令格式：renming <某人> <职务>或renming <某人> <部门> <职务>\n");
}

int check_item(string item) {
  int i;

  i = strlen(item);

  if ((strlen(item) < 4) || (strlen(item) > 16)) {
    return 0;
  }
  while (i--) {
    if (item[i] <= ' ') {
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(item[i..<0])) {
      return 0;
    }
  }
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：renming <player's id> <职务名称>

这条指令是玩家帮会的帮主专用命令，可以为本帮会
的玩家帮众分配帮会职务。如坛主、堂主、护法、使
者等称谓。
注意：凡是任命为副帮主的玩家，可以代替帮主行使
邀请(yaoqing)的权力。
HELP
  );
  return 1;
}
