///cmds/adm/channel.c

inherit F_CLEAN_UP;
string *wizth = ({ "wiz", "sys", "debug", "gwiz", "admin", "snp", "es" });
int main() {
  int i, j, k, num;
  string *dir, *ppls, name, str, str2 = "\n";
  object ob;
  object me = this_player();
  mapping channel;

  dir = get_dir(DATA_DIR + "user/");
  str = "\n";
  num = 0;
  write("整理玩家档案中......请稍候......\n");
  for (i = 0; i < sizeof(dir); i++) {
    reset_eval_cost();
    ppls = get_dir(DATA_DIR + "user/" + dir[i] + "/");
    for (j = 0; j < sizeof(ppls); j++) {
      if (sscanf(ppls[j], "%s.o", name) == 1) {
        if ((string)SECURITY_D->get_status(name) != "(player)") {
          write("\t\t排除巫师" + name + "\n");
          continue;
        }
        ob = new(USER_OB);
        seteuid(name);
        export_uid(ob);
        seteuid(getuid());
        ob->restore();

        channel = ob->query("channels");
        for (k = 0; k < sizeof(channel); k++) {
          if (member_array(channel[k], wizth) != -1)
            str += sprintf(" %-25s上线【 %s 】天，拥有%s频道。\n",
              ob->name() + "(" + capitalize(name) + "),",
              chinese_number(ob->query("mud_age") / 86400),
              channel[k]);
          num++;
          str2 = sprintf("\n目前本游戏共有%d名作弊玩家。\n", num);
        }
        destruct(ob);
      }
    }
  }
  write(" 整理完毕!\n\n");
  me->start_more(str + str2);
  return 1;
}
