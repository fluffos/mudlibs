//openline.c
/*********************************************************************/
/* 今天发现有BAN这个指令, 是用来BAN IP 的, 但却没有开线的指          */
/* 令, 所以我写了个，呵呵~~                                          */
/* 和 ban 指令一样，调用BAN_D 里的 API 函数.                         */
/* 读入welcome这文件 void load_welcome();                            */
/* 增加一个welcome 用户(id) void add_welcome_user(string user_id);   */
/* 删除一个welcome 用户(id) void remove_welcome_user(string user_id);*/
/* welcome users列表  string list_welcome_users();                   */
/*********************************************************************/

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string user;
  BAN_D->load_welcome();
  if (!wizardp(me)) {
    log_file(
      "welcome",
      sprintf(
        "%s %s线上的%s(%s)企图禁止%s连线。\n",
        ctime(time()),
        query_ip_number(me),
        me->query("name"),
        me->query("id")
      )
    );
    return 0;
  }
  if (!arg)
    write(BAN_D->list_welcome_users());
  else if (sscanf(arg, "+ %s", user) == 1) {

    BAN_D->add_welcome_user(user);
  } else if (sscanf(arg, "- %s", user) == 1)
    BAN_D->remove_welcome_user(user);
  else write("指令格式：welcome [+|- user]\n");

  return 1;

}

int help(object me) {
  write(@HELP
指令格式：openline [+|- user]

这条命令是用来防止有人蓄意捣乱。
HELP
  );
  return 1;
}
