#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  if (find_player(arg))
    return notify_fail("这个玩家正在连线。\n");
  if (file_size("/backup/2002-1-15/login/" + arg[0..0] + "/" + arg + ".o") < 0
    || file_size("/backup/2002-1-15/user/" + arg[0..0] + "/" + arg + ".o") < 0)
    return notify_fail("没有他的档案。\n");
  cp("/backup/2002-1-15/login/" + arg[0..0] + "/" + arg + ".o",
    "/data/login/" + arg[0..0] + "/" + arg + ".o");
  cp("/backup/2002-1-15/user/" + arg[0..0] + "/" + arg + ".o",
    "/data/user/" + arg[0..0] + "/" + arg + ".o");
  "/cmds/arch/rehash"->main(this_player(), "/data/user/" + arg[0..0] + "/");
  "/cmds/arch/rehash"->main(this_player(), "/data/login/" + arg[0..0] + "/");
  tell_object(this_player(), arg + "的档案已经恢复。\n");
  return 1;
}
