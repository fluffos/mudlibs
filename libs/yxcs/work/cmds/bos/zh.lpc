// Modified by lonely@NT
// 为了配合/cmds/bos/hf.c所写，转换旧的id为新的id

#include <command.h>
inherit F_CLEAN_UP;
#define CMD_REPLACE          "/cmds/bos/replace" 
int main(object me, string arg)
{        
     string oldid,newid;
     string id1,id2;
     seteuid(getuid()); 

     if( !arg || arg=="" ) return notify_fail("指令格式：zh <旧id> <新id>\n");
     if(sscanf(arg,"%s %s",oldid,newid)!=2) 
        return notify_fail("指令格式：zh <旧id> <新id>\n");

     id1 = sprintf("%s",oldid);
     id2 = sprintf("%s",newid);

        if (file_size("/data/login/"+oldid[0..0]+"/"+oldid+".o") < 0
        || file_size("/data/user/"+oldid[0..0]+"/"+oldid+".o") < 0)
               return notify_fail("没有他的档案。\n");
        if (file_size("/data/login/"+newid[0..0]+"/"+newid+".o") != -1
        || file_size("/data/user/"+newid[0..0]+"/"+newid+".o") != -1)
               return notify_fail("已经有了这个新id的档案。\n");

        cp ("/data/login/"+oldid[0..0]+"/"+oldid+".o",
                "/data/login/"+newid[0..0]+"/"+newid+".o");
        cp ("/data/user/"+oldid[0..0]+"/"+oldid+".o",
                "/data/user/"+newid[0..0]+"/"+newid+".o");

        rm ("/data/user/"+oldid[0..0]+"/"+oldid+".o");
        rm ("/data/login/"+oldid[0..0]+"/"+oldid+".o");

        CMD_REPLACE->replace("/data/login/"+newid[0..0]+"/"+newid+".o",id1,id2);
        CMD_REPLACE->replace("/data/user/"+newid[0..0]+"/"+newid+".o",id1,id2);
        "/cmds/arch/rehash"->main(this_player(), "/data/user/"+newid[0..0]+"/");
        "/cmds/arch/rehash"->main(this_player(), "/data/login/"+newid[0..0]+"/");
        tell_object(this_player(), "玩家"+oldid+"的档案转换"+newid+"已经完毕。\n");
        return 1;
}

