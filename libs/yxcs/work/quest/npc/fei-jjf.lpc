// tomcat

inherit __DIR__ "fei.lpc";



void set_skills() {
  object me = this_object();
  object weapon;

  int j;
  j = 200 + random(150);
  create_family("全真教", 3, "弟子");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("sword", j + random(15));
  me->set_skill("quanzhen-jianfa", j + random(15));
  me->set_skill("zhutian-bu", j + random(15));
  me->set_skill("kongming-quan", j + random(15));
  me->set_skill("tiangang-zhengqi", j + random(15));

  me->map_skill("force", "tiangang-zhengqi");
  me->map_skill("sword", "quanzhen-jianfa");
  me->map_skill("parry", "quanzhen-jianfa");
  me->map_skill("unarmed", "kongming-quan");
  me->map_skill("dodge", "zhutian-bu");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword.qixing" :),
    (: exert_function, "recover" :),

  }));

  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
