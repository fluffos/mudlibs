// tomcat

inherit __DIR__ "fei.lpc";

void set_skills() {
  object me = this_object();
  object weapon;
  int j;
  j = 200 + random(150);
  create_family("移花宫", 3, "弟子");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("sword", j + random(15));
  me->set_skill("yifeng-jian", j + random(15));
  me->set_skill("mingyu-shengong", j + random(15));
  me->set_skill("jueqing-zhang", j + random(15));
  me->set_skill("yihua-jiemu", j + random(15));

  me->map_skill("force", "mingyu-shengong");
  me->map_skill("sword", "yifeng-jian");
  me->map_skill("dodge", "yihua-jiemu");
  me->map_skill("parry", "yifeng-jian");
  me->map_skill("unarmed", "jueqing-zhang");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "yifeng" :),
    (: exert_function, "powerup" :),
  }));


  /*
        if (random(2))
           weapon=new("/d/obj/weapon/hammer/jingua");
        else
           weapon=new("/d/obj/weapon/fork/gangcha");
        weapon->move(me);
        command("wield all");
*/
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
