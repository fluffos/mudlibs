// tomcat

inherit __DIR__ "fei.lpc";

void set_skills() {
  object me = this_object();
  object weapon;

  int j;
  j = 200 + random(150);
  create_family("灵鹫宫", 3, "弟子");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);

  me->set_skill("sword", j + random(15));
  me->set_skill("tianyu-qijian", j + random(15));
  me->set_skill("yueying-wubu", j + random(15));
  me->set_skill("liuyang-zhang", j + random(15));
  me->set_skill("bahuang-gong", j + random(15));

  me->map_skill("force", "bahuang-gong");
  me->map_skill("sword", "tianyu-qijian");
  me->map_skill("parry", "tianyu-qijian");
  me->map_skill("dodge", "yueying-wubu");
  me->map_skill("unarmed", "liuyang-zhang");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword.san" :),
  }));

  /*
        if (random(2))
           weapon=new("/d/obj/weapon/hammer/jingua");
        else
           weapon=new("/d/obj/weapon/sword/qingfeng");
        weapon->move(me);
        command("wield all");
*/
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
