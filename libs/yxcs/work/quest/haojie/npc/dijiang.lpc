//by mudgod@xssx
#include <ansi.h>
inherit NPC;
void create() {
  set_name("皇皇教堂主", ({ "tang zhu", "tang" }));
  set("long",
    "一个皇皇教的堂主，看上去有很深的工夫造指。\n");
  set("max_qi", 1500);
  set("max_jing", 800);
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("per", random(10));
  set("combat_exp", 700000 + random(400000));
  set("chat_chance", 10);
  set("chat_msg", ({
    "皇皇堂主喊道：杀。。一个不留!\n",
  }));
  set_skill("unarmed", 150 + random(50));
  set_skill("blade", 150 + random(50));
  set_skill("parry", 150 + random(50));
  set_skill("dodge", 150 + random(50));
  set_skill("dongyang-dao", 150 + random(50));
  map_skill("blade", "dongyang-dao");
  map_skill("parry", "dongyang-dao");
  setup();
  carry_object("/clone/weapon/gangdao")->wield();
}
void init() {
  remove_call_out("hunting");
  if (!environment()->query("no_fight"))
    call_out("hunting", 1);
}

void hunting() {
  int i;
  object *ob;
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!ob[i]->is_character() || ob[i] == this_object() || !living(ob[i])) continue;
    if (ob[i]->query("vendetta/authority")) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
}

void die() {
  object killer;
  object *inv, *pro_team;
  int values;
  int i;

  values = 0;
  killer = query_temp("last_damage_from");
  if (userp(killer)) {
    killer->add_temp("marks/杀堂", 1);
  }
  ::die();
}
