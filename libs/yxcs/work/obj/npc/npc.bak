inherit "/obj/npc/npcdata.c";
inherit NPC;

void create()
{
	int age,level,exp;
	string name,id,skill,weapon;
	int i;
	mapping npc;
	i=random(sizeof(npcdata));
	npc=npcdata[i];
	name=npc["name"];id=npc["id"];age=npc["age"];level=npc["level"];
	age += random(10);level += random(20);
	exp=(level*level*level*3)/10;

	set_name(name,({ id }));
	set("age",age);
	set("combat_exp",exp);
	set_skill("dodge",level);set_skill("parry",level);set_skill("force",level);
	set("max_force",level*10);set("force",level*10);
	set_skill("unarmed",level/2);
	if(!(skill=npc["skill"]))	skill="unarmed";
	set_skill(skill,level);
	if(npc["move"])	{
        set("chat_chance",40);
        set("chat_msg", ({
		(: random_move :),
	}));
	}
	if(npc["follow"])	set("pursure",1);
	if(npc["killer"])	set("attitude","aggressive");
	if(skill!="unarmed")	weapon=skill;
	setup();
	if(weapon)
		carry_object("/obj/weapon/"+weapon)->wield();
}
	
