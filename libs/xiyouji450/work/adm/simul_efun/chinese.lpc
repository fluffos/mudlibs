
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: this driver's strings are UTF-8 native -- str[i] is
	// a Unicode codepoint, not a GBK byte, and strlen() counts characters
	// not bytes. The original GBK lead-byte range check (str[0] > 160 &&
	// str[0] < 255) never matches real Chinese text under UTF-8. Replaced
	// with a CJK Unified Ideographs codepoint range check; the length
	// bound is halved (>=2 bytes = 1 GBK char -> >=1 character).
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
