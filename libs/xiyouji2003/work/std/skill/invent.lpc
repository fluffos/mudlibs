// invent.c
// 自创武功
#include <ansi.h>;

inherit F_DBASE;
inherit F_SAVE;
inherit SKILL;
inherit FORCE;

/* Two inherits define NewRandom, cast_spell, clean_up, conjure_magic, create, exert_function, level_description, perform_action, scribe_spell, skill_improved, sum, type, valid_effect(); the later one was already in effect: name it. */
int NewRandom(int n, int base, int d) { return force::NewRandom(n, base, d); }
int cast_spell(object me, string spell, object target) { return force::cast_spell(me, spell, target); }
int clean_up() { return force::clean_up(); }
int conjure_magic(object me, string spell, object target) { return force::conjure_magic(me, spell, target); }
void create() { force::create(); }
int exert_function(object me, string arg) { return force::exert_function(me, arg); }
string level_description(int level) { return force::level_description(level); }
int perform_action(object me, string arg) { return force::perform_action(me, arg); }
int scribe_spell(object me, object ob, string spell) { return force::scribe_spell(me, ob, spell); }
void skill_improved(object me) { force::skill_improved(me); }
int sum(int n, int base, int d) { return force::sum(n, base, d); }
string type() { return force::type(); }
int valid_effect(object me, object weapon, string action_name, int skill) { return force::valid_effect(me, weapon, action_name, skill); }

mapping actions;
string skill_name;

string query_save_file() {
  return DATA_DIR "skill/" + skill_name;
}

int create_skill(string skill) {
  skill_name = skill;
  if (!restore()) return 0;
  else return 1;
}

int save() {
  if (!stringp(skill_name) || skill_name == "")
    return 0;

  return ::save();
}

void set_skill_name(string skill) {
  skill_name = skill;
}

string query_skill_name() {
  return skill_name;
}


void set_actions(mapping action) {
  actions = action;
}

mapping query_actions() { return actions; }

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (member_array("force", query("usages")) == -1)
    return 0;
  return ::hit_ob(me, victim, damage_bonus, factor);
}


int valid_enable(string usage) {
  return member_array(usage, query("usages")) != -1;
}

int valid_learn(object me) {
  return 1;
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的状态太差了，不能练" + skill_name + "。\n");
  me->receive_damage("kee", 30);
  return 1;
}

mapping query_action() {
  return actions[random(sizeof(actions))];
}
