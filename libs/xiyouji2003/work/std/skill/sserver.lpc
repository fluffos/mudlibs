inherit F_CLEAN_UP;

private int same_room(object target, object me);

object offensive_target(object me)
{
        int sz, i;
        object *enemy, target;

        enemy = me->query_enemy();

        if( !me || !environment(me) ) return 0;
        if( !enemy || !arrayp(enemy) ) return 0;

        enemy = filter_array(enemy, (: same_room :), me);

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;
        if( sz > 0 ) return enemy[random(sz)];
        else return 0;

}
//ephq 剔除不在同一房间的对手
private int same_room(object target, object me) { return (target && (environment(target) == environment(me))); }
