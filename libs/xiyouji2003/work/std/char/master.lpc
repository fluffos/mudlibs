// Update by waiwai@2002/12/02
// 门派任务整合至此，可领任务的师傅需要注意四点设置：
// 1. 必须有 inherit F_MASTER;
// 2. 必须有的_chat设置为：
/*	set("chat_chance", 50);
	set("chat_msg", ({
		(: msg :),
	}));
*/
// 3.必须有门派标志，如：
//  create_family("月宫", 3, "弟子");
// 4.NPC身上另外的ask设置不要再有"任务"和"重来"

#include <dbase.h>
#include <login.h>
#include <ansi.h>
string ask_MPRW();
string ask_JC();
int msg();

int prevent_learn(object me, string skill)
{
	int purge;
       int i, j, level;
       mapping skill_status;
       string *skills;

       object ob=this_object();

	skill_status = me->query_skills();
	if(skill_status)
	skills  = keys(skill_status);
	j = sizeof(skill_status);

	// Added by waiwai@2002/12/02
	if(( purge = me->query("MP_killM") ) 
		&& !me->is_player_apprentice_of(ob)
		&& !me->query("Purgefamily") ) {
		if( purge >= 100 ) { // 门派罪孽度达100
		me->set("combat_exp", me->query("combat_exp")/3);
		me->set("daoxing", me->query("daoxing")/3);
		me->set("office_number", me->query("office_number")/3);
		me->set("shengwang", me->query("shengwang")/3);
		me->set("Pfamily", ob->query("family/family_name"));
		me->set("title", HIR+me->query("Pfamily")+"弃徒"NOR);
		me->add("Purgefamily", 1);
		me->set("bellicosity", 0);
		me->set("potential", 0);
		me->set("balance", 0);
		me->delete("family");
		me->delete("class");
		me->delete("family/family_faith");
		me->delete("firstB_ok");
		me->delete("firstB_time");
              for(i=0; i<j; i++) { // 全部废除
		me->delete_skill(skills[i]);
		}
		me->save();
		me->start_busy(10);
		message_vision(HIG"$N"HIG"万般无奈地对$n道：去吧。。。你罪孽深重，本门不能再容你了。。。。。\n"NOR,
				ob, me );
		command("say 唉。。。师父劝你今后好自为知吧。。。。\n");
		message("channel:rumor", 
		HIR"┋门派消息┋"HIG+log_id(me)+HIR"罪孽深重，今日被["+me->query("Pfamily")+ob->name()+"]清理门户，逐出师门。。。\n"NOR,users());
		message("channel:rumor", 
		HIR"┋门派消息┋"HIY+ob->name()+"："HIG+log_id(me)+HIY"为免你再祸害无辜，所有武功已被我尽数废除。。。
\t\t\t\t望你今后能够洗心革面做个平常百姓独自生活去罢。。。\n"NOR,users());
		log_file("player/purgefamily", sprintf("%s在%s%s被%s逐出师门 时间：[%s]\n",
		log_id(me), MISC_D->find_place(environment(me)),
		COLOR_D->clean_color(environment(me)->query("short")),
		ob->name(), log_time() ));

		return 1;
		}
	}


        if( !me->is_apprentice_of(ob) && !me->is_player_apprentice_of(ob)
        && ( (int)ob->query_skill(skill, 1) <= (int)me->query_skill(skill, 1) * 3 
        ||(int)me->query_skill(skill, 1)>= 80)) {
		command("consider");
		command("pat " + me->query("id"));
		command("say 虽然你是我门下的弟子，可是并非我的嫡传弟子 ....");
		command("say 我只能教你这些粗浅的本门功夫，其他的还是去找你师父学吧。");
		return 1;
	}

	return 0;
}

int msg()
{
	set("inquiry", ([
		"任务" : (:ask_MPRW:),
		"重来": (:ask_JC:),
	]));
	return 1;
}

string ask_MPRW()
{
	object me=this_player();
	object ob=this_object();
   
	if(me->query("family/family_name")!= ob->query("family/family_name"))
		return ("你不是本门中人，为何向我要任务？");

	if(me->query("family/family_faith")<100)
		return ("你门派忠诚度不足100，不能领取任务。");

	command("pat "+me->query("id"));
	command("say 有志气！");
	return "/d/obj/mieyao"->query_yao(me);
}

string ask_JC()
{
	object me=this_player();
	object ob=this_object();
	if(me->query("family/family_name")!= ob->query("family/family_name"))
		return ("你不是本门中人，为何向我交差？");

	if((int)me->query_temp("m_mieyao")) {
		me->add("daoxing",-2000);
		me->delete_temp("m_mieyao");
		me->delete("secmieyao");
		me->add("family/family_faith",-5);
		me->delete("secmieyao/type");
		me->delete("secmieyao/location");
		me->delete("secmieyao/place");
		me->delete("secmieyao/name");
		me->delete("secmieyao/id");
	return ("没用的东西！");
	} else 
     return ("你有任务吗？！");
}

