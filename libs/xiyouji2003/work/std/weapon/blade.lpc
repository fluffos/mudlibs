//Last modified by waiwai@2003/01/28 刀类
//slash 深砍 slice 轻砍  hack 劈伤  chop 劈裂 thrust 刺伤
//pierce 捅伤 wave 挥击伤 bash 狠砸 shoot 射伤
//whip 鞭伤  impale 深刺  rake 筑伤  strike 砸伤 
//crush 挫伤 slam 挫伤 throw 暗器 arrow 箭伤 

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

//刀具有的伤害 slice hack chop slash 
varargs void init_blade(int damage, int flag) {
  if (clonep(this_object())) return;

  set("weapon_prop/damage", damage);

  //设定最大破损默认值
  if (!query("max_weapon"))
    set("max_weapon", query("weapon_prop/damage"));

  //设定默认硬度值
  if (!query("rigidity"))
    set("rigidity", "/adm/daemons/weapond"->query_cz(query("material")));

  set("flag", (int)flag | EDGED);
  set("skill_type", "blade");
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "slash", "slice", "hack", "chop" }));
  }
}
