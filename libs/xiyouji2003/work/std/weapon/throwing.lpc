#include <weapon.h>

inherit COMBINED_ITEM;
inherit F_EQUIP;

varargs void init_throwing(int damage, int flag) {
  if (clonep(this_object())) return;

  set("weapon_prop/damage", damage);

  //设定最大破损默认值
  if (!query("max_weapon"))
    set("max_weapon", query("weapon_prop/damage"));

  //设定默认硬度值
  if (!query("rigidity"))
    set("rigidity", "/adm/daemons/weapond"->query_cz(query("material")));

  set("flag", flag);
}

void setup() {
  seteuid(getuid());

  if (clonep(this_object())) return;

  set("skill_type", "throwing");
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "throw" }));
  }
}
