//Created by waiwai@2003/01/25 杖类(武器类)

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

varargs void init_staff(int damage, int flag) {
  if (clonep(this_object())) return;

  set("weapon_prop/damage", damage);

  //设定最大破损默认值
  if (!query("max_weapon"))
    set("max_weapon", query("weapon_prop/damage"));

  //设定默认硬度值
  if (!query("rigidity"))
    set("rigidity", "/adm/daemons/weapond"->query_cz(query("material")));

  set("flag", (int)flag | LONG);
  set("skill_type", "staff");
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "bash", "crush", "slam", "pierce", "impale" }));
  }
}
