// create by ephq@yszz 02-9-29 4:29
// 闭关修炼
#include <ansi.h>
inherit ROOM;

#include <family_path.h>

string help = "──────────────────────────────\n"
  BBLU HIW "指令格式：zuanyan <技能>                                    \n" NOR
  "──────────────────────────────\n"
  "目前提供的技能种类有：\n"
  "攻击类：斧法" HIY "(axe)" NOR "       剑法" HIY "(sword)" NOR "       杖法" HIY "(staff)\n" NOR
  "        叉法" HIY "(fork)" NOR "      棍法" HIY "(stick)" NOR "       锤法" HIY "(hammer)\n" NOR
  "        鞭法" HIY "(whip)" NOR "      枪法" HIY "(spear)" NOR "       针法" HIY "(needle)\n" NOR
  "        锏法" HIY "(mace)" NOR "      刀法" HIY "(blade)" NOR "       弓箭" HIY "(archery)\n" NOR
  "        钯法" HIY "(rake)" NOR "      奏琴" HIY "(music)" NOR "       暗器" HIY "(throwing)\n" NOR
  "拳脚类：拳法" HIY "(unarmed)\n" NOR
  "内功类：内功心法" HIY "(force)\n" NOR
  "轻功类：轻功闪躲" HIY "(dodge)\n" NOR
  "──────────────────────────────\n"
  BBLU HIC "如果你已经自创了一门武功，请用" HIY "( zuanyan <武功名> )" NOR HIC BBLU "来继续修炼\n" NOR
  "──────────────────────────────\n"
  "自创武功是一个极为漫长而艰辛的历程，自创者必须携带很多的潜能\n"
  "来用于自创，而花费了无数的潜能和道行之后也不一定会创出自己理\n"
  "想的武功。而一旦自创出武功，对于玩家来说将是一个新的突破，新\n"
  "创的武功必将结合自己的所学和师门之长而将极为凌厉。          \n"
  "──────────────────────────────\n";

string *basic_skills = ({ "sword", "whip", "staff", "stick", "axe",
  "parry", "rake", "force", "unarmed",
  "spear", "mace", "dodge", "needle", "throwing",
  "music", "fork", "blade", "hammer", "archery"
});

void start_invent(object me, string arg);
void continue_invent(object me, string arg);

void setup() {
  string family, file = file_name(this_object());
  int idx;

  ::setup();
  idx = strsrch(file, "/", -1);

  if (idx == -1) return;

  file = file[0..idx - 1];

  if (undefinedp(family_path[file]))
    return;

  family = family_path[file];
  set("short", family + "修炼密室");
  set("family", family);

  if (!query("long")) {
    string msg;
    msg = "这里是" + family + "的弟子们闭关修炼的地方，也是" + family + "的密室，非本门弟子一般不允许入内。这里布置得非常简洁，只"
      "有地上零零散散的放着一些圃垫，看来是用来给本门弟子打坐练功"
      "之用，不少" + family + "弟子曾经在这里钻研" HIY "(zuanyan)"
      NOR "武功，但是有大成者却是极少。";
    set("long", sort_string(msg, 60, 60));
  }
  delete("outdoors");
}

void init() {
  string family;
  object me = this_player();

  if (!stringp(family = me->query("family/family_name"))
    || family != query("family")) {
    message_vision("$N刚一步跨了进来，突然一股劲风把$N吹了出去。\n", me);
    me->move("/d/city/center");
    return;
  }

  add_action("do_zuanyan", "zuanyan");
}

int do_zuanyan(string arg) {
  object me = this_player();

  if (!arg) return notify_fail(help);

  if (member_array(arg, basic_skills) != -1) {
    start_invent(me, arg);
    return 1;
  }

  if (file_size(SKILL_D(arg) + ".lpc") >= 0)
    return notify_fail("已经有" + to_chinese(arg) + "(" + arg + ")这门武功了。\n");
  else {
    object ob;
    if (!objectp(ob = find_object(SKILL_D(arg))))
      ob = load_object(SKILL_D(arg));

    if (!objectp(ob))
      return notify_fail(help);

    if (ob->query("owner") != getuid(me))
      return notify_fail("这门武功已经有人创过了。\n");

    continue_invent(me, arg);
  }
}

void start_invent(object me, string arg) {}

void continue_invent(object me, string arg) {}
