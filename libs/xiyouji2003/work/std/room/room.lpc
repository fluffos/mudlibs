// Update by waiwai@2001/04/17
// Last modified by waiwai@2003/01/19

#pragma save_binary
#include <dbase.h>
#include <room.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

nosave mapping doors;

int query_max_encumbrance() { return 100000000000; }

int query_max_items() { return 40; }

int is_room() { return 1; }

//private object make_inventory(string file)
object make_inventory(string file) {
  object ob;
  ob = new(file);
  ob->move(this_object());
  if (!ob->query("startroom") && !ob->query("lead_S"));
  ob->set("startroom", base_name(this_object()));
  return ob;
}

void reset() {
  mapping ob_list, ob;
  string *list;
  int i, j, be_dest;
  object *inv;

  // reset时如果房间没在线玩家就destruct非容器,
  // 以及无no_get,task_gave记号的物品
  inv = all_inventory();
  for (j = 0; j < sizeof(inv); j++)
    if (interactive(inv[j])) be_dest = 1;
  //       if (wizardp(this_player())) write("be_dest"+be_dest+"\n");
  if (!be_dest) {
    for (i = sizeof(inv) - 1; i >= 0; i--)
      if (!inv[i]->query("owner_id")
        && !inv[i]->query_max_encumbrance()
        && !inv[i]->query("task_give")
        && !inv[i]->query("lead_S")
        && !inv[i]->query("no_return")
        && !inv[i]->query("no_get"))
        destruct(inv[i]);
  }

  // Added by waiwai@2003/01/19 设置一个统一的默认值
  if (!query("no_clean_up")) set("no_clean_up", 0);

  ob_list = query("objects");
  if (!mapp(ob_list)) return;
  // Added by waiwai@2003/01/19
  //	if( query("no_reset") ) return;

  if (!mapp(ob = query_temp("objects")))
    ob = allocate_mapping(sizeof(ob_list));
  list = keys(ob_list);  // 把这个去掉看看 ：P

  for (i = 0; i < sizeof(list); i++) {
    if (undefinedp(ob[list[i]])
      && intp(ob_list[list[i]])
      && ob_list[list[i]] > 1)
      ob[list[i]] = allocate(ob_list[list[i]]);

    switch (ob_list[list[i]]) {
      case 1:
        if (!ob[list[i]]) ob[list[i]] = make_inventory(list[i]);

        if (environment(ob[list[i]]) != this_object()
          && ob[list[i]]->is_character()) {
          if (!ob[list[i]]->return_home(this_object()))
            add("no_clean_up", 1);
        }
        break;
      default:
        for (j = 0; j < ob_list[list[i]]; j++) {
          if (!objectp(ob[list[i]][j])) {
            ob[list[i]][j] = make_inventory(list[i]);
            ob[list[i]][j]->set("list_number", j + 1);
            continue;
          }
          if (environment(ob[list[i]][j]) != this_object()
            && ob[list[i]][j]->is_character()) {
            if (!ob[list[i]][j]->return_home(this_object()))
              add("no_clean_up", 1);
          }
        }
    }
  }
  set_temp("objects", ob);
}

string look_door(string dir) {
  if (!mapp(doors) || undefinedp(doors[dir]))
    return "你要看什么？\n";
  // Added by waiwai@2003/01/19
  if (doors[dir]["status"] == DOOR_LOCKED)
    return WHT "这个" + doors[dir]["name"] + WHT "是锁着的。\n" NOR;
  if (doors[dir]["status"] == DOOR_CLOSED)
    return WHT "这个 " HIY + doors[dir]["name"] + NOR " 是关着的。\n" NOR;
  else
    return WHT "这个 " HIY + doors[dir]["name"] + NOR " 是开着的。\n" NOR;
}

varargs int open_door(string dir, int from_other_side) {
  mapping exits;
  object ob;

  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail(HIC "这个方向没有门。\n" NOR);

  // Added by waiwai@2003/01/19
  if ((doors[dir]["status"] == DOOR_LOCKED))
    return notify_fail(doors[dir]["name"] + WHT "是锁着的, 你必须先将它打开。\n" NOR);

  if ((doors[dir]["status"] != DOOR_CLOSED))
    return notify_fail(doors[dir]["name"] + WHT "已经是开着的了。\n" NOR);

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: open_door: attempt to open a door with out an exit.\n");

  // Added by waiwai@2001/04/17 name and id.
  if (from_other_side)
    message("vision", this_player()->name() + "(" + this_player()->query("id") + ")从另一边将 " HIR +
      doors[dir]["name"] + NOR " 打开了。\n", this_object());

  else if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->open_door(doors[dir]["other_side_dir"], 1)) return 0;
  }

  // Added by waiwai@2003/01/19
  doors[dir]["status"] = 0;
  return 1;
}

// Added by waiwai@2003/01/19
varargs int unlock_door(string dir, int from_other_side) {
  mapping exits;
  object ob;

  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail(WHT "这个方向没有门。\n" NOR);

  if (!(doors[dir]["status"] & DOOR_LOCKED)) {
    write(doors[dir]["name"] + WHT "并没有锁着。\n" NOR);
    return 0;
  }

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: unlock_door: attempt to open a door with out an exit.\n");

  if (from_other_side)
    message("vision", WHT "喀的一声, 有人从另一边将" + doors[dir]["name"] + WHT "的锁打开了。\n" NOR, this_object());
  else if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->unlock_door(doors[dir]["other_side_dir"], 1))
      return 0;
  }

  doors[dir]["status"] &= (!DOOR_LOCKED);
  doors[dir]["status"] |= (DOOR_CLOSED);
  return 1;
}

varargs int close_door(string dir, int from_other_side) {
  mapping exits;
  object ob;

  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail(WHT "这个方向没有门。\n" WHT);

  // Added by waiwai@2003/01/19
  if ((doors[dir]["status"] & DOOR_LOCKED))
    return notify_fail(doors[dir]["name"] + WHT "已经是锁着的了。\n" NOR);
  else if ((doors[dir]["status"] & DOOR_CLOSED))
    return notify_fail(doors[dir]["name"] + WHT "已经是关着的了。\n" NOR);

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: close_door: attempt to open a door with out an exit.\n");

  // Added by waiwai@2001/04/17 name and id.
  if (from_other_side)
    message("vision", this_player()->name() + "(" + this_player()->query("id") + ")从另一边将 " HIR +
      doors[dir]["name"] + NOR " 关上了。\n", this_object());

  else if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->close_door(doors[dir]["other_side_dir"], 1)) return 0;
  }

  doors[dir]["status"] |= DOOR_CLOSED;
  return 1;
}

// Added by waiwai@2003/01/19
varargs int lock_door(string dir, int from_other_side) {
  mapping exits;
  object ob;

  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail(WHT "这个方向没有门。\n" NOR);

  if ((doors[dir]["status"] & DOOR_LOCKED)) {
    write(doors[dir]["name"] + WHT "已经是锁着的了。\n" NOR);
    return 0;
  } else if (!(doors[dir]["status"] & DOOR_CLOSED)) {
    write(doors[dir]["name"] + WHT "是开着的, 必须先将它关上。\n" NOR);
    return 0;
  }

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: lock_door: attempt to open a door with out an exit.\n");

  if (from_other_side)
    message("vision", WHT "喀的一声, 有人从另一边将" + doors[dir]["name"] + WHT "锁上了。\n" NOR, this_object());
  else if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->lock_door(doors[dir]["other_side_dir"], 1))
      return 0;
  }

  doors[dir]["status"] &= !DOOR_CLOSED;
  doors[dir]["status"] |= DOOR_LOCKED;

  return 1;
}

int check_door(string dir, mapping door) {
  if (!mapp(doors) || undefinedp(doors[dir])) return 1;

  door["status"] = doors[dir]["status"];
  return 1;
}

varargs void create_door(string dir, mixed data, string other_side_dir, int status) {
  mapping d, exits, item_desc;
  object ob;

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("创建门的对象错误: 不能创建没有出口的门.\n");

  if (stringp(data)) {
    d = allocate_mapping(4);
    d["name"] = data;
    d["id"] = ({ dir, data, "door" });
    d["other_side_dir"] = other_side_dir;
    d["status"] = status;
  } else if (mapp(data))
    d = data;
  else
    error("创建门失败: 数据非法, 需要是 string 或 mapping.\n");

  set("item_desc/" + dir, (: look_door, dir :));

  if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->check_door(other_side_dir, d))
      return;
  }

  if (!mapp(doors)) doors = ([ dir: d ]);
  else doors[dir] = d;
}

mapping query_doors() { return doors; }

mixed query_door(string dir, string prop) {
  if (!mapp(doors) || undefinedp(doors[dir])) return 0;
  else return doors[dir][prop];
}

int valid_leave(object me, string dir) {
  mapping block;
  object *body;
  int i;

  if (mapp(doors) && !undefinedp(doors[dir])) {
    // Added by waiwai@2003/01/19
    if (doors[dir]["status"] & DOOR_LOCKED)
      return notify_fail(WHT "你必须先把 " HIR + doors[dir]["name"] + NOR WHT " 的锁打开！\n" NOR);
    if (doors[dir]["status"] & DOOR_CLOSED) {
      if (!userp(me)) {  // allow npc to open doors.
        me->command("open " + doors[dir]["name"]);
        if (!(doors[dir]["status"] & DOOR_CLOSED)) return 1;  //
      }
      return notify_fail(WHT "你必须先把 " HIR + doors[dir]["name"] + NOR WHT " 打开！\n" NOR);
    }
  }

  // Added by waiwai@2001/04/21 帮会的地盘防御
  block = query("guarded");
  if (!mapp(block) || undefinedp(block[dir])) return 1;
  body = block[dir];
  if (arrayp(body)) {
    for (i = 0; i < sizeof(body); i++) {
      if (!objectp(body[i])) continue;
      if (living(body[i]) && (this_object() == environment(body[i]))) {
        if (me == body[i]) continue;
        if (body[i]->query("banghui") &&
          me->query("banghui") == body[i]->query("banghui")) return 1;
        if ((((random(me->query_skill("parry")) + me->query_skill("parry")) / 2
          < body[i]->query_skill("parry")) ||
          ((random(me->query_skill("dodge")) + me->query_skill("dodge")) / 2
            < body[i]->query_skill("dodge"))))
          return notify_fail("这个方向被" WHT + body[i]->query("name") + NOR "守住了！\n");
      }
    }
  }
  return 1;
}

void setup() {

  /*******************************************/
  // Addded by waiwai@2002/10/12
  if (query("chat_room")) set("no_fight", 1);
  if (query("no_fight")) {
    set("no_magic", 1);
    set("NONPC", 1);
    set("no_kill", 1);
    set("no_book", 1);
  }

  if (query("sleep_room")) {
    //		set("no_get_from",1);
    set("no_kill", 1);
    set("no_danei", 1);
    set("no_recall", 1);
    set("no_faight", 1);
  }

  if (query("no_kill")) {
    set("no_qmdj", 1);
    set("no_bian", 1);
    set("no_follow", 1);
    set("no_qiankun", 1);
    set("no_accept", 1);
    set("no_recall", 1);
    set("no_steal", 1);
    set("no_qimen", 1);
    set("freeze", 1);
    set("no_danei", 1);
  }

  if (query("zy_limit")) {
    set("no_chuqiao", 1);
    set("no_shuidun", 1);
    set("no_tudun", 1);
    set("no_huicheng", 1);
    set("no_escape", 1);
    set("no_bian", 1);
    set("no_danei", 1);
    set("no_recall", 1);
    set("no_qmdj", 1);
    set("limit_fight", 1);
    set("alternative_die", 1);
  }
  /*******************************************/
  // 这里禁止更改设置，不是室外便自动设为室内参数
  if (!query("outdoors")) set("indoors", 1);

  seteuid(getuid());
  this_object()->reset();
  //	this_object()->set_long();
}
