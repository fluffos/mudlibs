//Added By waiwai@2001/07/21
int do_apply(string arg)
{
	string tt;
	object me,qingdan,*ob;
	int s;
	me=this_player();

	if (!arg || arg!="bank") {
	    write("指令格式：apply bank\n");
	      return 1;
	}

	if( !wizardp(me) && userp(me) && !me->query("vip") ) {
	if((int)me->query("daoxing",1) < 500000 ) {
          write("你目前道行太低，没有资格申请保险库！！！\n");
          return 1;
          }
	if((int)me->query("combat_exp",1) < 500000 ) {
          write("你目前武学太低，没有资格申请保险库！！！\n");
          return 1;
         }

	if( uptime()-me->query_temp("last_bank_time")<30) {
          write("老板正忙,你需要等一会再来！！！\n");
          return 1;
         }

	me->set_temp("last_bank_time",uptime());
	}

	ob=all_inventory(me);
	s=sizeof(ob);
	while(s--) {
        if (!stringp(ob[s]->query("id"))) continue;
        if (ob[s]->query("id")=="baoxianku qingdan") {
                tell_object(me,WHT"你身上已经有一个保险库清单了！！！\n"NOR);
                return 1;
                }
        }
	qingdan=new("/obj/bank.lpc");
	qingdan->set("master_id",me->query("id"));
	qingdan->move(me);

	if(!qingdan->move(me)) {//这里的设置不应缺少.
		tell_object(me,"由于你身上物品太多了,申请失败。\n\n");
		return 1;
	}

	if (file_size(qingdan->query_save_file()+".o")>0) {
	qingdan->restore();
		tell_object(me,"恭喜！你重新领回了保险库清单！！！\n");
	} else
		tell_object(me,"恭喜！你成功的申请了一个保险库！！！\n");
		tell_object(me,"钱庄老板把一个保险库清单递给了你！！！\n");
		tell_room(this_object(),"钱庄老板把一个保险库清单递给了"+me->query("name")+".\n",me);
	return 1;
}

// Added by waiwai@2002/12/05
// 需要注意带有时间消失设置的物
// 品要加上no_putto
int do_put(string arg)
{
	object ob, me;
	string obj_file;
	int i, oldnum, full;
	string index, Putto;
	object *inv;

	me = this_player();

	if( me->is_busy() )
		return notify_fail("请等一下，掌柜的正忙着整理物品呢。\n");

	if((string)me->query("title") == "普通百姓" && !me->query("vip") )
           return notify_fail(WHT"掌柜的说：你是普通百姓,我不要你的东西！\n"NOR); 

	if( !arg || !(ob = present(arg, me)) )
		return notify_fail("掌柜的说：你要给什么物品？\n");

       if (ob->query_amount())
		return notify_fail("掌柜的说：这东西有点古怪，我们这里不敢收存。\n");

	if( ob->query("money_id") )
		return notify_fail("掌柜的说：你要给「钱」？我不是贪财之人的，你还是存到你的个人帐户吧！\n");

	if( !wizardp(me) && userp(me) ) {
	if( ob->query("no_putto") )
		return notify_fail("掌柜的说：这样物品我们这里不敢收存。\n");

	if( ob->query("no_break") )
		return notify_fail("掌柜的说：神器物品我们这里不敢收存。\n");

	if( ob->query("combine") )
		return notify_fail("掌柜的说：神器物品我们这里不敢收存。\n");

	if( ob->query("npc_only") )
		return notify_fail("掌柜的说：我们这里不收存这样东西。\n");

	if( ob->query("deadfly") )
		return notify_fail("掌柜的说：我们这里不收存这样东西。\n");

       if( ob->is_no_clone())
		return notify_fail("掌柜的说：我们这里不收存这样东西。\n");

       if (ob->query_max_encumbrance())
		return notify_fail("掌柜的说：我们这里不收存容器类东西。\n");

       if (ob->is_character()) 
		return notify_fail("掌柜的说：我们这里不贩卖人口。\n");

        if (ob->query("armor_prop/armor")!=ob->query("armor/max_armor"))
		return notify_fail("掌柜的说：这个物品已破损我们这里不收存。\n");

        if (ob->query("weapon_prop/damage")!=ob->query("max_weapon"))
		return notify_fail("掌柜的说：这个物品已破损我们这里不收存。\n");

	if( ob->query("no_sell") )
		return notify_fail("掌柜的说：这样东西是西游记商业行会禁止买卖的，这里不收存。\n");

	if( ob->query("material") == "ice" )
		return notify_fail("掌柜的说：冰的东西我们这里没法存放。\n");

	if( ob->query("material") == "water" )
		return notify_fail("掌柜的说：水的东西我们这里没法存放。\n");
	}
	write (WHT"掌柜的将你交给他的东西分门别类的收好了。\n"NOR);
	message_vision(HIY"$N将"+ob->query("name")+HIY"送给了老板。\n"NOR, me);

	index=ob->query("name")+"("+ob->query("id")+")";

	Putto=log_id(me);

	ob->set_temp("Putto",Putto);

	if(!findbox()->query_temp("goods/"+index) ){
           findbox()->set_temp("goods/"+index, ob);
	      findbox()->set_temp("numbers/"+index, 1);
	ob->move(findbox());
	} else {
	oldnum = findbox()->query_temp("numbers/"+index);
           findbox()->set_temp("numbers/"+index, oldnum+1);
	destruct(ob);
	}

	if( !wizardp(me) )
	me->start_busy(2);

	return 1;
}

// Added by waiwai@2002/12/05
