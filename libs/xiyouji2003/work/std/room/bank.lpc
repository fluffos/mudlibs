// Created By waiwai@2001/02/03 建立
// Update By waiwai@2001/07/21 加入玩家钱庄保险库设置
// Last modified by waiwai@2002/12/05
// 改变存款方式为add，设置可以all，一次性把身上所有的钱
// 存进银行。加入借款。
// 加入钱庄可以收取物品，玩家可以随意拿取这样的物品
// 禁止更改以下四个房间的short
// 相记钱庄，杨记钱庄，董记当铺，徐记当铺

#include <ansi.h>
inherit ROOM;
int query_max_items() { return 100; }

object shop_box;
string get_name(string str);

void init()
{
	add_action("do_convert", "convert");
	add_action("do_deposit", "deposit");
	add_action("do_check", "account");
       add_action("do_apply","apply");
	add_action("do_put","putto");
	add_action("do_get","take");
	add_action("do_list","list");
	add_action("do_loan","loan");

	set("no_clean_up", 1);
}

object findbox()
{
    if(shop_box && environment(shop_box)==this_object()) 
      return shop_box;

    shop_box=new(__DIR__"bankbox");
    shop_box->move(this_object());
    return shop_box;
}

int do_convert(string arg)
{
	string from, to;
	int amount, bv1, bv2;
	object from_ob, to_ob;
	object me;

	me = this_player();

	if( !arg || sscanf(arg, "%d %s to %s", amount, from, to)!=3 )
		return notify_fail("指令格式：convert <数量> <货币种类> to <货币种类>\n");

	if( me->is_busy() )
	    return notify_fail("你现在正忙着呢...。\n");

       if(me->query("title") == "普通百姓" && !me->query("vip") )
                return notify_fail(CYN"你是普通百姓,钱庄不做你的生意！\n"NOR); 

	from_ob = present(from + "_money", me);
	to_ob = present(to + "_money", me);
	if( !to_ob && file_size("/obj/money/" + to + ".lpc") < 0 )
		return notify_fail("你想兑换哪一种钱？\n");

	if( !from_ob )		return notify_fail("你身上没有这种货币。\n");
	if( amount < 1 )	return notify_fail("兑换货币一次至少要兑换一个。\n");
		
	if( (int)from_ob->query_amount() < amount )
		return notify_fail("你身上没有那么多" + from_ob->query("name") + "。\n");

	bv1 = from_ob->query("base_value");
	if( !bv1 ) return notify_fail("这种东西不值钱。\n");

	bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to, "query", "base_value" );

	if( bv1 < bv2 ) amount -= amount % (bv2 / bv1);
	if( amount==0 )	return notify_fail("这些" + from_ob->query("name") + "的价值太低了，换不起。\n");
	me->start_busy(1);

	if( !to_ob ) {
		to_ob = new("/obj/money/" + to);
		if(!(to_ob->move(me)))
			return notify_fail("你身上装不下这么多钱。\n");
		to_ob->set_amount(amount * bv1 / bv2);
	} else
		to_ob->add_amount(amount * bv1 / bv2);

	message_vision( sprintf("$N从身上拿出%s%s%s，换成%s%s%s。\n",
		chinese_number(amount), from_ob->query("base_unit"), from_ob->query("name"),
		chinese_number(amount * bv1 / bv2), to_ob->query("base_unit"), to_ob->query("name")),
		me );
        if( (int)from_ob->query_amount() == amount )
             destruct(from_ob);
        else
           from_ob->add_amount(-amount);

        me->save();

	return 1;
}

// Update by waiwai@2002/12/05 
// 加入全存
int do_deposit(string arg)
{
	string money;
	int amount;
	object money_ob, me,coin,silver,gold,cash,jinbi;

	if (!arg) return 0;
	me = this_player();

	if( me->is_busy() )
	    return notify_fail("你现在正忙着呢...。\n");

       if( me->query("title") == "普通百姓" && !me->query("vip") )
                return notify_fail(CYN"你是普通百姓,钱庄不做你的生意！\n"NOR); 

	if (arg=="all") {
		coin=present("coin_money",me);
		silver=present("silver_money",me);
		gold=present("gold_money",me);
		cash=present("thousand-cash_money",me);
		amount=0;
		if (coin){
			amount+=coin->value();
			destruct(coin);
		}
		if (silver){
			amount+=silver->value();
			destruct(silver);
		}
		if (gold){
			amount+=gold->value();
			destruct(gold);
		}
		if (cash){
			amount+=cash->value();
			destruct(cash);
		}

		me->add("balance",amount);
	       message_vision("$N把身上所有的钱都存进了钱庄。\n",me);
	}  else  {
		if (sscanf(arg,"%d %s",amount,money)!=2) {
			amount=-1;
			money=arg;
		}
		else if ( amount < 1 )
			return notify_fail("货币计量至少要一个单位。\n");
		money_ob=present(money+"_money",me);

		if (!money_ob) return notify_fail("你身上没有这种货币。\n");

		if (amount==-1) {
			amount=money_ob->query_amount();
			if (!amount)
				return notify_fail("你身上没有这种货币。\n");
		}
		else if( money_ob->query_amount() < amount )
			return notify_fail("你身上没有那多"+money_ob->query("name")+"。\n");
		money_ob->add_amount(-amount);
		me->add("balance",money_ob->query("base_value")*amount);
	       message_vision("$N拿出一些钱存进了钱庄。\n",me);

		if (!money_ob->query_amount()) destruct(money_ob);
	}
       me->save();
	write("OK.\n");

	return 1;
}

// Added by waiwai@2002/12/05
// 加入可以借款
int do_loan(string arg)
{
	int amount;
	string money;
	object money_ob, me;

	me = this_player();

        if( me->is_busy() ) return notify_fail("你正忙着呢！\n");

        if( !arg || sscanf(arg, "%d %s", amount, money) != 2 )
                return notify_fail("指令格式：loan <数量> <货币种类> \n");

        money_ob = present(money + "_money", this_player());
        if( !money_ob && file_size("/obj/money/" + money + ".lpc") < 0 )
                return notify_fail("没有这种货币。\n");

        if( !money_ob) money_ob = new("/obj/money/" + money);

        amount = ( amount * (int)money_ob->query("base_value") );

        if( amount < 1 ) return notify_fail("你要干吗？\n");

       if( me->query("title") == "普通百姓")
                return notify_fail(CYN"你是普通百姓,钱庄不做你的生意！\n"NOR); 

	if( !wizardp(me) ) {
        if( (int)me->query("balance") > 0 ) 
		return notify_fail("你还有存款，借的什么钱？\n");

        if( (int)me->query("combat_exp") < 1200000 ) 
		return notify_fail("你的武学太低，系统怀疑你是大米。\n");

	}

        // 每一点经验可以欠钱庄5文钱        
        if( (int)me->query("combat_exp") <   
                ( amount - me->query("balance") ) / 5 ) {
	write("您目前的借款信誉度为：" +MONEY_D->money_num((int)me->query("combat_exp")*5) + "\n");
	write("敝银庄个人最高借款额为：" +MONEY_D->money_num(20000000) + "。\n");
	return 1;
	}

	if( ( - (int)me->query("balance") ) > 19999999 || amount >20000000  ) {
	write("敝银庄个人最高借款额为：" +MONEY_D->money_num(20000000) + "。\n");
	return 1;
	}

        message_vision( sprintf("$N从钱庄借出%s。\n", MONEY_D->price_num( amount ) ), me );

	message("channel:sys", 
	HIG"\n┋钱庄精灵┋"+ log_id(me)+"在"+COLOR_D->clean_color(environment(me)->query("short"))+
	"借出"+MONEY_D->price_num( amount )+"。\n\n" NOR, users());

        log_file("player/bank_money2", sprintf("%s在%s借出%s 时间在：[%s]\n",
		log_id(me), COLOR_D->clean_color(environment(me)->query("short")),
		MONEY_D->price_num( amount ), log_time() ));

        me->add("balance", - amount );

        MONEY_D->pay_player(me, amount);
        me->save();
        me->start_busy(2);

        return 1;
}

int do_check()
{
        int value;
        
        value = (int) this_player()->query("balance");
        if(value == 0) return notify_fail("你目前没有存款。\n");
        if(value > 0) 
                tell_object(this_player(), "你现在共有存款：" );
        else {
                tell_object(this_player(), "你现在共有欠款：" );
                value = -value;
        }
        tell_object(this_player(), MONEY_D->price_num(value) + "\n" );

        return 1;
}

