            printf("%-30s感谢 南城客栈老板(nancheng boss) 独家赞助提供\n", "雨伞");
            break;
         case 3:
            printf("%-30s感谢 开封钱庄徐老板(bank boss) 独家赞助提供\n", "算盘");
            break;
         case 4:
            printf("%-30s感谢 钦法国货物集散地 独家赞助提供\n", "布料");
            break;
