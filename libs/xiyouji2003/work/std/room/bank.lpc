	list+="[序号] [首次提供者]    [自身价值]     [目前库存数量]   [物品名称]\n";
	list+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";

      i=sizeof(goods);
      while(i--) {
             if(!goods[name[i]]) {
          findbox()->delete_temp("numbers/"+name[i]);
          findbox()->delete_temp("goods/"+name[i]);
          continue;
          }

//        tlist = COLOR_D->replace_color(get_name(name[i]));
        tlist = goods[name[i]]->query_temp("Putto");
//	desc = goods[name[i]]->short();

        ++turn;
/*
	if( goods[name[i]]->query("base_unit") )
        list += sprintf(" [%-3d] %-16s %-10s → 目前有 %-3d%-6s %-15s \n",turn, tlist,
          MONEY_D->money_num(goods[name[i]]->query("value")), 
          findbox()->query_temp("numbers/"+name[i]),
          goods[name[i]]->query("unit"), name[i]);
	else
*/
        list += sprintf(" [%-3d] %-16s %-10s → 目前有 %-3d%-6s %-15s \n",turn, tlist,
          MONEY_D->money_num(goods[name[i]]->query("value")),
          findbox()->query_temp("numbers/"+name[i]),
          goods[name[i]]->query("unit"),name[i]);

	}
       me->start_more(list);
	}
