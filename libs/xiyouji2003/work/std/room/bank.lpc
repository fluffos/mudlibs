{
	mapping goods;
	string list, *name, desc;
	int i, j, turn=0;
	string tlist;
	object me=this_player();

	if( !mapp(goods = findbox()->query_temp("goods")) ) {
	switch( random( 6)) {
         case 0:
            printf("%-30s感谢 宝象国货物集散地 独家赞助提供\n", "锡器");
            break;
         case 1:
