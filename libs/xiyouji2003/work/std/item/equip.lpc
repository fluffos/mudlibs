// Created by waiwai@2002/12/05
// 计算防具或武器的价值 。价值跟随着eq的附加
// 能力值而改变。所以如果不想让一个武器装备
// 卖掉的话一定要另外加入no_sell因为即使不设
// value参数，系统也会根据实际的攻击防御力自
// 动算出来其价值的，当然可以去当铺了！

inherit ITEM;
inherit F_EQUIP;

void setup()
{
	int value, i, cnt, total;
	string *name, Mt, FMt;
	mapping in_data=([ ]);
	int fz;
	object weapon, armor;

	weapon=query("weapon_prop");
	armor=query("armor_type");

//       ITEM_D->equip_setup(this_object());

	if( !query("armor_prop/dodge") && (weight() >= 3000) )
		set("armor_prop/dodge", - weight() / 3000 );
	if( !query("weapon_prop/dodge") && (weight() >= 3000) )
		set("weapon_prop/dodge", - weight() / 3000 );

	if(weapon || armor) {
	Mt = query("material");
	FMt = query("Fmaterial");
	}

	// 材质所定义的默认价值(包括主材质和辅材质)
	if(Mt || FMt) {
	switch(Mt || FMt) {
	case "异类金属": 	 fz=300;  break;
	case "crimsonsteel": fz=250;  break;	/*丹金*/
	case "blacksteel":   fz=200;  break;	/*玄铁*/
	case "gem":          fz=150;  break;	/*宝石*/
	case "jade":          fz=130;  break;	/*玉石*/
	case "gold":         fz=100;  break;	/*金*/
	case "silver":       fz=90;   break;	/*银*/
	case "steel":        fz=80;   break;	/*钢*/
	case "brass":        fz=70;   break;	/*黄铜*/
	case "copper":       fz=65;   break;	/*铜*/
	case "iron":         fz=60;   break;	/*铁*/
	case "metal":         fz=60;   break;	/*一般金属*/
	case "wood":         fz=55;   break;	/*木(盾牌，藤甲等)*/
	case "bone":         fz=50;   break;	/*骨(骨甲)*/
	case "bamboo":       fz=45;   break;	/*竹子*/
	case "leather":      fz=40;   break;	/*皮革*/
	case "fur":          fz=35;   break;	/*毛皮*/
	case "silk":	       fz=30;   break;	/*丝绸*/
	case "cloth":        fz=25;   break;	/*布*/
	case "fiber":        fz=20;   break;	/*麻*/
	case "stone":        fz=15;   break;	/*石头*/
	case "flower":       fz=10;   break;	/*花*/
	default:             fz=1;    break;
	}
	}

	value=query("value");
	set("old_value",value);
	if(query("skill_type")){ // 武器默认价值
	if(query("weapon_prop/damage") && !query("no_break") ){
	// 这里不能太低，暂定需要高于40攻击力为最低
	// 以40的倍数生效，去除任何永不破损物件
        if(query("weapon_prop/damage")/40 > 0 ){
          if(!value) {
		value=1000;
	       value*=(query("weapon_prop/damage") / 40);
       	value*=fz*2;
	} else if(value) {
		value=query("value");
	       value+=fz*2;
	// 如果本身有设价值则是按照本身价值+材质值的2倍计算
	}
        }
      }
	name=keys(query("weapon_prop"));
	total=0;
	for(i=0;i<sizeof(name);i++){
        if(name[i]=="damage") continue;
        if(intp(query("weapon_prop/"+name[i]))){
          total+=query("weapon_prop/"+name[i]);
        }
      }
      if((int)(total) > 1 && !value) value=1000;
       if( total > 25) total=25;
      if(total >0)
       value+=(int)(value*total/25);
    } // 防具默认价值，去除任何永不破损物件
    else if(query("armor_type") && !query("no_break")){ 
      if(query("armor_prop/armor")){
        if(query("armor_prop/armor")/20 > 0){
          if(!value) { 
		value=1000;
	       value*=(query("armor_prop/armor")/20);
       	value*=fz*2;
	} else if(value) { 
		value=query("value");
	       value+=fz*2;
	}
        }
      }
      name=keys(query("armor_prop"));
      total=0;
      for(i=0;i<sizeof(name);i++){
        if(name[i]=="armor"){
          if(query("armor_prop/armor") <20)
            total+=query("armor_prop/armor");
        }
        else
        if(intp(query("armor_prop/"+name[i]))){
          total+=query("armor_prop/"+name[i]);
        }
      }
      if((int)(total) > 1 && !value) value=1000;
       if( total > 25) total=25;
      if(total >0)
      value+=(int)(value*total/25);
    }  
    set("value",value);
}

int query_autoload() { return query("autoload"); }
