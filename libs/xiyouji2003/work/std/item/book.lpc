#include <ansi.h>
inherit ITEM;

string *msg = ({"げ","あ","ぉ","ぎ","ぬ","ぱ","ぽ","ゆ","ょ","れ","ゑ","を"});

string long()
{
        int i, j, max_line=11;
        string *arg=({}), name, str="", ansi, color, old;
        object ob = this_object();

        if( !stringp( old = ob->query("long")) )
                old = "";
        name = ob->query("name");
        name = replace_string(name, "〗","");
        name = replace_string(name, "〖","");
        name = replace_string(name, "【","");
        name = replace_string(name, "】","");
        color = get_color(name);
        if( color == "" ) color = BLK;
        name = remove_ansi(name);
        ansi = ob->query("ansi");
        if( !ansi ) ansi = BYEL;

        for( i=0; i<strlen(name);i++) {
                if( i%2==0 )
                        arg +=({name[i..i+1]});
        }
        j = sizeof(arg);
        if( j > max_line ) max_line = j + 5;
        for( i = 0; i < max_line; i++) {
                str+="             "+ansi+WHT;
                if( i<1 || i>j+2 )
                        str  += sprintf(WHT"%-9s",(i==max_line-1)?"◣":"");
                else {
                        if( i == 1 ) str += sprintf(" %-8s","╔═╗");
                        else
                        if( i == j+2 ) str+= sprintf(" %-8s","╚═╝");
                        else {
                                str+=sprintf(" ║"+color+"%2s"+WHT+"║%2s",arg[i-2],"");
                        }
                }
                if( old != "" &&  i>4 && i<max_line-1 ) str += sprintf(color+" %-3s",msg[random(sizeof(msg))]);
                else str+= "    ";
                if( i%2 ) str += WHT"┣━\n"NOR;
                else str += WHT"┃  \n"NOR;
        }
        if( old!="" ) str+=WHT"\n上面还有些蝇头小字....\n"NOR+old;
        return str;
}
