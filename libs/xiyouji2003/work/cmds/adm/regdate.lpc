//CMDS CRD regdate.c
//Created by waiwai@2002/05/17

#include <login.h>;
inherit F_CLEAN_UP;
#include <mudlib.h>
#include <command.h>

int help(object me) {
  write(@HELP

指令格式：regdate <id> <date>

这个指令是用来给会员用户登记注册日期期限用的。
格式为：regdate xxx 20020514
说明这个ID的帐号使用期限截止到2002年5月14日
请注意月份和天数不足10的用0补位

有效使用期限数字必须与upvip中设置一致。
这个指令的有效设置将决定能否有效限制用户帐号
是否到期而无法登陆的问题。

此指令必须配合upvip共同设置。

相关指令：upvip，xvip

HELP
  );
  return 1;
}

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob, link_ob;
  string id, wiz_status, date;
  int len;
  date = BJTIME_CMD->chinese_time(10, (string)localtime(time()));

  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(admin)")
    return notify_fail("只有 (admin) 级别的巫师才能登记用户的注册时限日期！\n");

  if (!arg || sscanf(arg, "%s %s", id, date) != 2) return help(me);
  len = strlen(date);

  if (len < 8) return notify_fail(HIR "位数不足，请用正确格式设置！\n" NOR);
  if (len > 8) return notify_fail(HIR "位数溢出，请用正确格式设置！\n" NOR);

  ob = find_player(id);
  if (!ob) {
    ob = new(LOGIN_OB);
    ob->set("id", id);
    if (!ob->restore())
      return notify_fail("没有这个玩家。\n");
    else {

      if (ob->query("regover")) ob->delete("regover");

      ob->set("regplayer", date);

      tell_object(me, "你在用户" HIW + ob->query("name") + "(" + ob->query("id")
        + ")" NOR "离线状态将其用户帐号成功登记有效期为：" + date + " \n" NOR);

      log_file("wizcmds/regplayer", sprintf("[%s] %s在%s(%s)离线状态下设定其帐号有效期为：%s \n",
        log_time(), log_id(me), ob->query("name"), geteuid(ob), date));

      ob->save();
      destruct(ob);
      return 1;
    }
  }

  link_ob = ob->query_temp("link_ob");
  if (link_ob) {
    link_ob->set("regplayer", date);
    link_ob->save();
    tell_object(me, "你在用户" + log_id(ob) + "在线状态将其帐号成功登记有效期为：" HIR + date + NOR " \n");

    log_file("wizcmds/regplayer", sprintf("[%s] %s在%s在线状态下设定其帐号有效期为：%s \n",
      log_time(), log_id(me), log_id(ob), date));

    return 1;
  } else
    return notify_fail(HIR "对象数据错误或在断线状态,LOGIN_OB临时数据不存在，无法进行修改。\n" NOR);
  return 1;
}
