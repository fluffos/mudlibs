// CMDS /cmds/adm/xseach.c  临时登陆密码更改
// Created by waiwai@2001/06/05

#include <login.h>;
inherit F_CLEAN_UP;
#include <mudlib.h>
#include <command.h>

inherit F_CMD;

int main(object me, string arg)
{
	object ob,link_ob;
	string id, password, wiz_status;

	if (me!=this_player(1))	return 0;

	wiz_status = SECURITY_D->get_status(me);
          if( wiz_status != "(admin)" )
	        return notify_fail(HIG"只有 (admin) 级别的巫师有权修改别人的登陆密码！\n"NOR);

	if(!arg||sscanf(arg,"%s %s",id,password)!=2)
		return notify_fail("用法:xseach ID 新登陆密码\n此操作容易损害用户利益，你必须先调查清楚！\n");
	ob=find_player(id);
	if(!ob) {
        ob = new(LOGIN_OB);
        ob->set("id",id);
        if( !ob->restore() )
        	return notify_fail(INTERMUD_NAME+"没有这个用户。\n");
        else {                                    
           ob->set("Pseach",crypt(password,0));
           tell_object(me, "用户" + ob->query("id") + "("+ob->query("name")
                + ")的登陆密码已经更改为："HIG+password+" \n"NOR);

	if( wizardp(ob) ) {
	CHANNEL_D->do_channel(me, "adm",
	"在"+ob->query("name")+"("+ob->query("id")+")离线状态下更改其登陆密码为：****** \n"NOR);	
	log_file( "wizcmds/xseach", sprintf("%s在%s(%s)离线状态下修改了其登陆密码为：****** 时间在：[%s] \n",
             log_id(me), ob->query("name"), geteuid(ob), log_time() ));
	} else {
	CHANNEL_D->do_channel(me, "adm",
	"在"+ob->query("name")+"("+ob->query("id")+")离线状态下更改其登陆密码为："HIR+password+" \n"NOR);	
	log_file( "wizcmds/xseach", sprintf("%s在%s(%s)离线状态下修改其登陆密码为：%s 时间在：[%s] \n",
             log_id(me), ob->query("name"), geteuid(ob), password, log_time() ));
	}
           ob->save();
           destruct(ob);
           return 1;
		}
	}
	link_ob=ob->query_temp("link_ob");
	if(link_ob) {
		link_ob->set("Pseach",crypt(password,0));
		link_ob->save();
		tell_object(me, "用户"+ log_id(ob) +"的登陆密码已经成功更改为："HIR+password+NOR" \n");

	if( wizardp(ob) ) {
	CHANNEL_D->do_channel(me, "adm",
	"在"+ob->query("name")+"("+ob->query("id")+")在线状态下更改其登陆密码为：****** \n"NOR);	
	log_file( "wizcmds/xseach", sprintf("%s在%s在线状态下修改了其登陆密码为：****** 时间在：[%s] \n",
             log_id(me), log_id(ob), log_time() ));
	} else {
	CHANNEL_D->do_channel(me, "adm", "在"+log_id(ob)+"在线状态下更改其登陆密码为："HIR+password+" \n"NOR);	
	log_file( "wizcmds/xseach", sprintf("%s在%s在线状态下修改其登陆密码为：%s 时间在：[%s] \n",
             log_id(me), log_id(ob), password, log_time() ));
	}
		return 1;
	}
	else
		return notify_fail("对象数据错误或在断线状态,无法进行修改。\n");
	return 1;
}


int help(object me)
{
        write(@HELP

指令格式 : xeach ID 新登陆密码

这个指令可以修改用户的登陆密码，请谨慎使用。

相关指令：xpasswd，xpasswd2，xpasswd3，xpasswds

HELP
    );
    return 1;
}