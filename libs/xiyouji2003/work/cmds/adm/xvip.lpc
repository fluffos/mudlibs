// Created by waiwai@2002/11/22

#include <login.h>;

inherit F_CLEAN_UP;
#include <command.h>

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object ob, link_ob;
	string wiz_status;

	if( me!=this_player(1) ) return 0;
	wiz_status = SECURITY_D->get_status(me);
          if( wiz_status != "(admin)" )
	        return notify_fail("只有 (admin) 级别的巫师才能删除用户的会员身份！\n");

	if( !arg || sscanf(arg, "%s", arg)!=1 )
        return notify_fail("指令格式：xvip <使用者id> \n");

	if( !objectp(ob = present(arg, environment(me))) || !userp(ob) )
        return notify_fail(WHT"你只能在使用者在线的情况下近身改变其状态。\n"NOR);

	link_ob=ob->query_temp("link_ob");

	if(link_ob) {
		if( !link_ob->query("regplayer"))
			return notify_fail(WHT"使用者LOGIN_OB会员数据不存在。\n"NOR);
		else {
		link_ob->delete("regplayer");
		link_ob->save();
		}
	}

	ob->add("balance",-55000000); 
//	ob->add("combat_exp",200000); 
//	ob->add("daoxing",100000); 
	ob->add("potential",-50000); 
	ob->add("reason",-5); 
	ob->add("Freason",-5);

	ob->delete("regplayer");
	ob->delete("vip");
	ob->delete("regdate");
//	ob->setup();
	ob->save();
//	write_file("/data/vip", sprintf("%d"));

	tell_object(me, "用户" HIW+ ob->query("name") + "("+ob->query("id")
                + ")"NOR"的会员身份已经完全删除。\n"NOR);

	CHANNEL_D->do_channel(me, "adm",
	"用xvip指令将"+ob->query("name")+"("+ob->query("id")+")的系统状态由会员(vip)更改为普通玩家(player) \n"NOR);	

	log_file("wizcmds/xvip",
	sprintf("%s将%s(%s)的系统状态从会员(vip)更改为普通玩家(player) 时间在：[%s]\n",
             log_id(me), ob->name(1), geteuid(ob), log_time() ) );


	return 1;
}

int help(object me)
{
write(@HELP

指令格式 : xvip <id>

用来将删除玩家的会员身份。
要想彻底删除一个玩家的会员身份数据，还需使用regdate配合使用。
这个指令的作用重要是删除会员身份后的玩家无法再有效使用会员
特有系统指令。。。

相关指令：regdate，upvip

HELP
  );
  return 1;
}

