// CMDS /cmds/adm/xpass_w.c  巫师专用密码更改
// Created by waiwai@2001/07/29

#include <ansi.h>
#include <mudlib.h>
#include <command.h>
#include <login.h>;

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob,link_ob;
	string id,password_w;
       string wiz_status;

	wiz_status = SECURITY_D->get_status(me); 
	if( me != this_player(1) ) return 0;

	if( wiz_status != "(admin)" )
		return notify_fail(HIG"你没有权利修改别人的巫师专用密码。\n"NOR);

	if(!arg||sscanf(arg,"%s %s",id,password_w)!=2)
		return notify_fail(HIG"用法:xpass_ww ID 新的巫师专用密码。\n"NOR);
	ob=find_player(id);
	if(!ob) {
        ob = new(LOGIN_OB);
        ob->set("id",id);
        if( !ob->restore() )
        	return notify_fail(WHT+INTERMUD_NAME+"没有这个巫师。\n"NOR);
        else 	{                                    
           ob->set("password_w",crypt(password_w,0));
           tell_object(me,"巫师" + ob->query("id") + "("+ob->query("name")
                + ")的巫师专用密码已经更改为新的巫师专用密码为："HIG+password_w+NOR" \n");

	if( wizardp(ob) ) {
    CHANNEL_D->do_channel(me, "adm","在"+ob->query("name")+"("+ob->query("id")+")离线状态下更改其巫师专用密码为：****** \n"NOR);	
    log_file( "wizcmds/xpass_w", sprintf("%s(%s)在%s(%s)离线状态下修改其巫师专用密码为：****** 时间在：[%s] \n",
             me->query("name"), me->query("id"),ob->query("name"), ob->query("id"),
			log_time()));
	} else {
    CHANNEL_D->do_channel(me, "adm","在"+ob->query("name")+"("+ob->query("id")+")离线状态下更改其巫师专用密码为："HIR+password_w+" \n"NOR);	
    log_file( "wizcmds/xpass_w", sprintf("%s(%s)在%s(%s)离线状态下修改其巫师专用密码为：%s 时间在：[%s] \n",
             me->query("name"), me->query("id"),ob->query("name"), ob->query("id"),password_w,
			log_time() ));
	}

           ob->save();
           destruct(ob);
           return 1;
		}
	}
	link_ob=ob->query_temp("link_ob");
	if(link_ob) {
		link_ob->set("password_w",crypt(password_w,0));
		link_ob->save();
		tell_object(me, "巫师" + ob->query("id") + "("+ob->query("name")
			+ ")的巫师专用密码已经更改为："HIR+password_w+NOR" \n");

	if( wizardp(ob) ) {
	    CHANNEL_D->do_channel(me, "adm","在"+ob->query("name")+"("
+ob->query("id")+")在线状态下更改其巫师专用密码为：****** \n"NOR);
    log_file( "wizcmds/xpass_w", sprintf("%s(%s)在%s(%s)在线状态下修改其巫师专用密码为：****** 时间在：[%s] \n",
             me->query("name"), me->query("id"),ob->query("name"), ob->query("id"),
			log_time() ));

	} else {
	    CHANNEL_D->do_channel(me, "sys","在"+ob->query("name")+"("
+ob->query("id")+")在线状态下更改其巫师专用密码为："HIR+password_w+" \n"NOR);	
    log_file( "wizcmds/xpass_w", sprintf("%s(%s)在%s(%s)在线状态下修改其巫师专用密码为：%s 时间在：[%s] \n",
             me->query("name"), me->query("id"),ob->query("name"), ob->query("id"),password_w,
			log_time()  ));
	}
		return 1;
	} else return notify_fail(HIR"对象数据错误或在断线状态,无法进行修改。\n"NOR);

	return 1;
}


int help(object me)
{
        write(@HELP

指令格式 : xpassw_w ID 新巫师专用密码

这个指令可以修改巫师的巫师专用密码，请谨慎使用。

相关指令：xpass

HELP
    );
    return 1;
}
