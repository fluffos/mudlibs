inherit F_CLEAN_UP;
#include <ansi.h>;

int main(object me, string arg) {
  string owner;
  if (!arg || sscanf(arg, "%s %s", arg, owner) != 2)
    return notify_fail("指令格式：setowner <黑店名称> <黑店主人>\n");

  HEIDIAN_D->change_owner(me, arg, owner);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : setowner <黑店名称> <黑店主人>

其中黑店主人为玩家的ID。
设置指定黑店的店主。 

HELP);
  return 1;
}
