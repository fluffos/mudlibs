// CMDS  /cmds/adm/upvip.c
// Created by waiwai@2002/11/22

#include <login.h>;
#include <command.h>
inherit F_CLEAN_UP;
int vip = 0;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob, link_ob;
  string wiz_status, id, date;
  int len;

  date = BJTIME_CMD->chinese_time(10, (string)localtime(time()));

  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);

  if (wiz_status != "(admin)")
    return notify_fail("只有 (admin) 级别的巫师才能登记用户的会员身份！\n");

  if (!arg || sscanf(arg, "%s %s", arg, date) != 2)
    return notify_fail("指令格式：upvip <使用者id> <有效使用期限> \n");

  len = strlen(date);

  if (len < 8) return notify_fail(HIR "位数不足，请用正确格式设置！\n" NOR);
  if (len > 8) return notify_fail(HIR "位数溢出，请用正确格式设置！\n" NOR);

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail(WHT "请近身改变用户数据状态。\n" NOR);

  if (!userp(ob))
    return notify_fail(WHT "没有这个注册用户或已离线。。。\n" NOR);

  link_ob = ob->query_temp("link_ob");

  if (link_ob) {
    if (link_ob->query("regover"))
      return notify_fail(HIR "错误，请先用xvip指令删除用户会员LOGIN_OB禁止数据。\n" NOR);

    if (!link_ob->query("regplayer"))
      return notify_fail(HIR "错误，用户LOGIN_OB无会员数据标志，请先用regdate指令初始化用户数据。\n" NOR);
  }

  message_vision("$N将$n的系统状态从普通玩家(player)提升为高级会员(vip) \n", me, ob);
  CHANNEL_D->do_channel(me, "adm", "用upvip指令将" + log_id(ob) + "的系统状态更改为高级会员(vip) \n" NOR);
  log_file("wizcmds/upvip", sprintf("%s将%s的系统状态从更改为高级会员(vip) 时间在：[%s]\n",
    log_id(me), log_id(ob), log_time()));

  if (!ob->query("vip")) {

    if (ob->query("family/family_name")) {
      if ((string)ob->query("family/family_name") == "南海普陀山")
        ob->set("combine_staff1", 1);
      else if ((string)ob->query("family/family_name") == "方寸山三星洞")
        ob->set("combine_stick1", 1);
      else if ((string)ob->query("family/family_name") == "将军府")
        ob->set("combine_spear1", 1);
      else if ((string)ob->query("family/family_name") == "五庄观")
        ob->set("combine_blade1", 1);
      else if ((string)ob->query("family/family_name") == "天蓬府")
        ob->set("combine_rake1", 1);
      else if ((string)ob->query("family/family_name") == "阎罗地府")
        ob->set("combine_stick1", 1);
      else if ((string)ob->query("family/family_name") == "月宫")
        ob->set("combine_sword1", 1);
      else if ((string)ob->query("family/family_name") == "东海龙宫")
        ob->set("combine_fork1", 1);
      else if ((string)ob->query("family/family_name") == "大雪山")
        ob->set("combine_sword1", 1);
      else if ((string)ob->query("family/family_name") == "火云洞")
        ob->set("combine_spear1", 1);
      else if ((string)ob->query("family/family_name") == "陷空山无底洞")
        ob->set("combine_blade1", 1);
    }

    //	write_file("/data/vip", sprintf("%d", ++vip), 1);
    ob->set("combine_pants", 1);  // 带终极装备标志
    ob->add("balance", 55000000);
    //	ob->add("combat_exp",200000); 
    //	ob->add("daoxing",100000); 
    ob->add("potential", 50000);
    new("/d/obj/tattoo/vip")->move(ob);
    if (ob->query("reason")) {
      ob->set("reason", 5);
      ob->set("Freason", 5);
    } else {
      ob->add("reason", 5);
      ob->add("Freason", 5);
    }
  }

  ob->set("regdate", "V");  // who等指令显示需要
  ob->set("regplayer", date);  // hp显示需要
  ob->set("vip", 1);  // 指令限制识别标志
  //	if(ob->query("regdate"))
  //	ob->delete("regdate","V"); // who等指令显示需要


  //	ob->setup();
  ob->save();

  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : upvip <id> <有效使用期限>

有效使用期限格式样例：20030101
条件：用户在线状态

用来将普通玩家状态提升为会员身份。
这个指令设置是为了设置用户的USER_OB，只为了系统调用参数方便。
系统中的有效指令是否有效完全取决于这个指令所设置的参数有效。

注意：请先用regdate设置玩家，然后再用此指令。
	有效使用期限必须与regdate中设置一致。
不用regdate对用户进行设置将无法有效限制用户的限期登陆问题。

相关指令：regdate，xvip

HELP
  );
  return 1;
}
