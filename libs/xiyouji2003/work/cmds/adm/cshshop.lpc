inherit F_CLEAN_UP;
#include <ansi.h>;

int main(object me, string arg) {
  if (!arg)
    HEIDIAN_D->reset_all(me);
  else
    HEIDIAN_D->reset_heidian(me, arg);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : cshshop [黑店名称]

如果没有指定黑店名称，则是初始化所有黑店。

HELP);
  return 1;
}
