// Update by waiwai@2002/12/05

inherit F_CLEAN_UP;
#include <command.h>

int do_give(object me, object obj, object who);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item;
	object obj, who, *inv, obj2;
	int i, amount, rev_val;
	mixed no_give;

	me=this_player();

	if (me->is_busy() ||
	 me->query_temp("doing_xiudao") ||
	 me->query_temp("pending/exercising") ||
	 me->query_temp("pending/meditating"))
           return notify_fail("你现在正忙着呢。\n");
		 
	if(!arg) return notify_fail("你要给谁什么东西？\n");

        if (userp(me) && !wizardp(me)){
        if (uptime() - me->query_temp("last_give_time/give") < 2 )
            	  return notify_fail(WHT"慢点给，你急啥啊？\n"NOR);

	if( this_player()->is_ghost() )
       	return notify_fail("做了鬼了，就老实点吧！\n");

        if(me->query("no_give"))
	   	return notify_fail(HIG"你不能给人东西．．．\n");
         }

	if( sscanf(arg, "%s to %s", item, target)==2
	|| sscanf(arg, "%s %s", target, item)==2 );
	else return notify_fail("你要给谁什么东西？\n");

	if(!objectp(who = present(target, environment(me))) || !living(who))
		return notify_fail("这里没有这个人。\n");

       if (me == who) return notify_fail("脑子秀豆了？你自己给自己东西干吗？\n");

       if(wizardp(me) && userp(who)) {
           if( (string)SECURITY_D->get_status(me) != "(admin)" 
		&& who && !wizardp(who) )
              return notify_fail(WHT"你不能给玩家任何东西。\n"NOR);
	}

       if (! living(who))
                return notify_fail("你还是得等人家醒了再说吧。\n");

        if(who->query_temp("netdead"))
                return notify_fail("对方正处于断线中，你还是省省吧。\n");

	if(who->query_temp("sleeped")) 
		return notify_fail("人家正睡觉呢，你瞎忙活的什么？\n"NOR);

	if(sscanf(item, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )	
			return notify_fail("你身上没有这样东西。\n");
		if( no_give=obj->query("no_give") )
			return notify_fail( stringp(no_give) ? no_give : "这样东西不能随意丢弃。\n");
		if( !obj->query_amount() )	
			return notify_fail( obj->name() + "不能被分开给人。\n");
		if( amount < 1 )
			return notify_fail("东西的数量至少是一个。\n");
		if( amount > obj->query_amount() ) 
			return notify_fail("你没有那么多的" + obj->name() + "。\n");
		else if( amount == (int)obj->query_amount() )
			return do_give(me, obj, who);
		else {
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			rev_val = do_give(me, obj2, who);
			if( rev_val )
			   obj->set_amount( (int)obj->query_amount() - amount );
		    else
			   destruct(obj2);
			return rev_val; 
		}
	}

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			if (inv[i]->query("no_get")) continue;
			if (inv[i]->query("keep_this")) continue;
			do_give(me, inv[i], who);
		}
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(item, me)))
		return notify_fail(CYN"你身上没有这样东西。\n"NOR);

       if( (string)SECURITY_D->get_status(me) != "(admin)" ) {
	       if( no_give=obj->query("no_give") )
                return notify_fail( stringp(no_give) ? no_give : "这样东西不能随意给人。\n");
	}

	return do_give(me, obj, who);
}

int do_give(object me, object obj, object ob)
{
	int is_accept;
	object	*inv,env;
	mixed no_give;

	if(me->is_busy())
	   return notify_fail("你正忙着呢．．．\n");
    
	if(ob->is_busy())
	   return notify_fail("对方正忙着呢，没时间理你．．．\n");

      if(obj->query("has_player") && userp(ob))
		   return notify_fail("这样东西不能送给非玩家控制的人物．．．\n");

	if (!wizardp(me) && userp(ob)){
	      if(obj->query("task_give") )
		   return notify_fail("这样东西不能送人．．．\n");

	if( obj->query("keep_this") && !obj->query("keepto"))
		return notify_fail( WHT"你需要先把"+obj->name()+NOR WHT"上面的记号去掉才能送人 。\n"NOR);

	switch ((string)obj->query("equipped")) {
	case "worn":
		tell_object(me, WHT+obj->name() +NOR WHT "必须脱下来才能给别人。\n"NOR);
                return 1;

	case "wielded":
                tell_object(me, WHT+obj->name() +NOR WHT "必须解除装备才能给别人。\n"NOR);
                return 1;
	}
	}

	if (QUEST->quest_give (me, ob, obj)) {
		message_vision("$N给$n一"+obj->query("unit")+obj->name()+"。\n",me,ob);
		if(userp(ob)) {
		    if(ob->query("env/no_accept") ||
			    !obj->move(ob)) {
			message_vision("$N一不小心，$n掉到地上不见了。\n",
				ob, obj);
			destruct(obj);
		    } else {
		        message_vision("$N由衷地向$n道谢。\n",ob,me);
		    }
		} else {
		    message_vision("$N由衷地向$n道谢。\n",ob,me);
		    destruct(obj);
		}
		return 1;
	} 

       if( (string)SECURITY_D->get_status(me) != "(admin)" ) {
	if(userp(me) && ob->query("env/no_accept"))
           return notify_fail("对方好象不愿意收下你的东西。\n");
	}

	if( !interactive(ob)) {
		if( !(is_accept=ob->accept_object(me, obj)) )
			return notify_fail("对方不要你的东西。\n");
		if( is_accept == 2 )
			return 1;
	}

       me->set_temp("last_give_time/give",uptime());
	if( !userp(ob) && obj->value() ) { // give money to npc
		message_vision("$N拿出" + obj->short() + "给$n。\n", me, ob);
		destruct(obj);
		return 1;
	} else if( obj->move(ob) ) {
	       string unit;
		if(obj->query_temp("d_mana")>0)
		  unit=obj->query_temp("unit");
                else
		  unit=obj->query("unit");
                if(strlen(unit)<2) unit="个";
		printf("你给%s一%s%s。\n", ob->name(1), unit, obj->name());
		message("vision", sprintf("%s给你一%s%s。\n", log_id(me),
			unit, obj->name()), ob);
		message("vision", sprintf("%s给%s一%s%s。\n", log_id(me), ob->name(1),
			unit, obj->name()), environment(me), ({me, ob}) );

//       if( (string)SECURITY_D->get_status(me) != "(admin)" ) {
		if(!userp(ob) && !userp(obj)) destruct(obj); 
//	}
		env = environment(me);

	if( userp(ob) && !wizardp(me) && !wizardp(ob))
          log_file("cmds/give_log", sprintf("%s(%s) 给%s(%s) 一%s%s 时间 [%s]\n",
              me->name(1), geteuid(me), ob->name(1), geteuid(ob), unit, obj->name(),
		log_time() ));

        env=environment(me);

	//Added by waiwai@2001/02/18 监控设置禁止更改
	// 禁止任何人随意更改下面设置
	if (wizardp(me) && !wizardp(ob) && userp(ob) && !obj->value() ) {
       message("channel:adm", 
	HIW"┋天神┋"HIG+ log_id(me)+"在"+	
	MISC_D->find_place(env)+COLOR_D->clean_color(env->query("short"))+"("+file_name(env)+".c)处
	给"+log_id(ob)+"一"+obj->query("unit")+obj->query("name")+"("+base_name(obj)+".c)\n" NOR, users());
	//金钱log在move.c里面处理
	if( !obj->value() )
        log_file("wizcmds/wiz_give", sprintf("%s(%s)在%s(%O.c)给%s一%s%s(%s) 时间在：[%s]\n",
                 me->name(), geteuid(me), COLOR_D->clean_color(env->query("short")),env,
		log_id(ob), unit, COLOR_D->clean_color(obj->name()), obj->query("id"), log_time()  ));
	}


	if( (string)SECURITY_D->get_status(me) != "(admin)" ) {
        if( wizardp(me) && !wizardp(ob) && userp(ob) ){
            message("channel:rumor",HIR"┋公正法官┋听说"+me->query("name")+"("
+me->query("id")+")在"HIG+"["+MISC_D->find_place(env)+env->query("short")+"]"+
HIR"给了"+log_id(ob)+"一"+unit+obj->name()+"("+obj->query("id")+") \n"NOR,users());

	        }	
		}
		return 1;
	}
	else return 0;
}

int help(object me)
{
write(@HELP

指令格式 : give <物品名称> to <某人>
      或 : give <某人> <物品名称>
 
这个指令可以让你将某样物品给别人, 当然, 首先你要拥有这样物品.
注意在送出某物的同时必须保证该物没有做keep记号，并且没有装备
比如你本身穿着衣服不能直接不脱下来就可以给人吧？：P

不接受时 : set no_accept <任意非0值>
重新接受 : unset no_accept 或 set no_accept 0

相关指令：keep，unwield，remove/tuo

HELP
    );
    return 1;
}
