// Update by waiwai@2002/04/12

#include <ansi.h>

inherit F_CLEAN_UP;

int do_wear(object me, object ob);

int main(object me, string arg) {
  object ob, *inv;
  int i, count;

  if (!arg) return notify_fail("你要穿戴什么？\n");

  if (arg == "all") {
    inv = all_inventory(me);
    for (count = 0, i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped")) continue;
      // Added by waiwai@2003/01/19
      if (inv[i]->query("no_all")) continue;
      if (inv[i]->query("combine")) continue;
      if (inv[i]->query("area_name")) continue;
      if (inv[i]->query("need_family")) continue;
      if (inv[i]->query("vip_only")) continue;
      if (inv[i]->query("family_only")) continue;
      if (do_wear(me, inv[i])) count++;
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");

  if (ob->query("equipped"))
    return notify_fail("你已经装备着了。\n");

  return do_wear(me, ob);
}

int do_wear(object me, object ob) {
  string str;

  if (!wizardp(me)) {
    if (ob->query("owner_id") && ob->query("owner_id") != getuid(me)) {
      write(ob->query("name") + "破空而去，消失不见了……\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("combine") && ob->query("owner_id") != getuid(me)) {
      destruct(ob);
      return notify_fail("下次别乱偷别人的东西。\n");
    }

    if (ob->query("family_only") &&
      me->query("family/family_name") != ob->query("family_only")) {
      write(ob->query("family_only") + "门派专用装备你不能使用.\n");
      write(ob->name() + "冲天而去，消失不见了.\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("combine") && !me->query("vip")) {
      destruct(ob);
      return notify_fail("下次别乱拿会员的东西用。\n");
    }

    if (ob->query("No_Wear"))
      return notify_fail("这件衣服不能再穿了！\n");

    if (ob->query("has_player") && ob->query("has_player") != log_id(me))
      return notify_fail("这样东西是" + ob->query("has_player") + "的。\n");
  }

  if (!wizardp(me) && userp(me) && ob->query("wiz_only"))
    return notify_fail(HIC "你无权装备这件东西！\n" NOR);

  if (ob->wear()) {
    if (!stringp(str = ob->query("wear_msg")))
      switch (ob->query("armor_type")) {
        case "cloth":
        case "skirts":
        case "pants":
          str = HIY "$N穿上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "armor":
          str = HIY "$N穿上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "boots":
          str = HIY "$N蹬上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "surcoat":
          str = HIY "$N披上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "head":
          str = HIY "$N戴上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "neck":
          str = HIY "$N戴上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "wrists":
          str = HIY "$N扣上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "finger":
          str = HIY "$N戴上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "flower":
          str = HIY "$N别上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "hands":
          str = HIY "$N戴上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "waist":
          str = HIY "$N佩上一" + ob->query("unit") + ob->query("name") + " \n" NOR;
          break;
        case "leggings":
          str = HIY "$N绑上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "cape":
          str = HIY "$N别上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "shoulder":
          str = HIY "$N缠上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "armbands":
          str = HIY "$N缠上一" + ob->query("unit") + "$n \n" NOR;
          break;
        case "othors":
          str = HIY "$N佩上一" + ob->query("unit") + "$n \n" NOR;
          break;
        default:
          str = HIY "$N装备$n \n" NOR;
      }
    message_vision(str, me, ob);
    return 1;
  } else
    return 0;
}

int help(object me) {
  write(@HELP

指令格式：wear|chuan <装备名称>
 
这个指令让你装备某件防具。
 
HELP
  );
  return 1;
}
