// Update by waiwai@2003/04/20

#include <ansi.h>
inherit F_CLEAN_UP;
#include "/cmds/std/valid_kill.h"

int main(object me, string arg) {
  int my_idle, your_idle;
  object obj, ob, guard_ob;
  string callname, kname, tname;

  if (!me) return 0;

  if (!arg) return notify_fail("你想杀谁？\n");

  if (!objectp(obj = present(arg, environment(me))) || !me->visible(obj))
    return notify_fail("这里没有这个人。\n");

  if (userp(me) && userp(obj) && !wizardp(me)) {
    if (environment(me)->query("no_kill")
      || environment(me)->query("no_fight")
      || environment(me)->query("ownerroom")
      || environment(me)->query("no_magic"))
      return notify_fail(GRN "这里不准杀人\n" NOR);

    if (wizardp(obj))
      return notify_fail(obj->query("name") + "瞪了你一眼，你突然吓得两腿发抖，几乎跪了下来。\n");

    if ((int)me->query("combat_exp") <= 10000)
      return notify_fail(GRN "你的武学这么差也想杀人吗? \n" NOR);

    if (me->query("daoxing") <= 10000)
      return notify_fail(GRN "你的道行这么差也想杀人吗? \n" NOR);

  }
  if (me->is_ghost())
    return notify_fail("做了鬼了，就老实点吧！\n");

  if (obj->query("doing"))
    return notify_fail("对正在离线练功的玩家下手，似乎不是什么英雄好汉吧？\n");

  if (me->query("impurity") > 0)
    return notify_fail("你罪孽深重，还是省省吧你。\n");

  if (!obj->is_character() || obj->is_corpse() || obj->is_ghost())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail(GRN "用 " HIR "suicide -f" GRN " 指令会比较快些。\n" NOR);

  if (me->is_busy())
    return notify_fail("你现在正忙，没法杀人。\n");

  if (userp(me) && !wizardp(me)) {
    //    your_idle = obj->query_skill("idle-force",1);
    your_idle = obj->query_idle();
    //    my_idle = me->query_skill("idle-force",1);

    if (userp(obj) && (string)obj->query("id") != "seach"
      && (int)me->query("combat_exp") < (int)obj->query("combat_exp") / 2)
      return notify_fail("你不是" + obj->query("name") + "的对手，不要白白去送死了。\n");

    //    if(userp(obj)&&random(your_idle)>600 && random(your_idle)>random(my_idle)
    if (userp(obj) && your_idle > 600 && !obj->is_fighting()
      && !environment(obj)->query("fight_room")) {
      write("你想对" + obj->query("name") + "下杀手，但是看着他那呆若木鸡的样子，你始终狠不下心来。\n");
      tell_object(obj, "一种不详的感觉笼罩着你全身。。。\n");
      tell_object(obj, me->query("name") + "(" + me->query("id") + ")" + "想对你下毒手，还在考虑中，你还是快逃吧！\n");
      me->start_busy(5);
    }

    if (!userp(obj) && obj->query("no_kill"))
      return notify_fail(HIR "你不能攻击这个人！\n" NOR);

    if (uptime() - me->query_temp("last_kill_time") < 2)
      return notify_fail(GRN "为了系统负担请勿进行刷屏kill,你的kill指令时间必须大于2秒钟。\n" NOR);

    me->set_temp("last_kill_time", uptime());
  }

  if (!userp(obj) && obj->query("family/family_name")
    && obj->query("combat_exp") / 2 > me->query("combat_exp"))
    return notify_fail(HIR "对方比你强太多，懒得理你！\n" NOR);

  if (userp(obj) && obj->is_brother(me))
    return notify_fail(HIR "你要杀你的结义金兰？！\n" NOR);

  callname = RANK_D->query_rude(obj);
  //add by dragon@dhxy 2001.2.3        
  kname = me->query("id");
  tname = obj->query("id");
  if (!me->query_temp(tname + "/defence"))  //如果不是反击下kill命令的敌人
    obj->set_temp(kname + "/defence", "yes");

  /*
    if((int)obj->query("nokill")) { 
//	if( !wizardp(me) && !userp(obj) && userp(me) &&
	  if(  !userp(obj) && userp(me) ) {
		if( (int) me->query_skill("force",1)>550 ) {
		if( (int) obj->query_skill("force")+250 < (int) me->query_skill("force") )
		return notify_fail(GRN"你不能攻击这个人！\n"NOR);
	} else
		if( (int) obj->query_skill("force")+160 < (int) me->query_skill("force") )
		return notify_fail(GRN"你不能攻击这个人！\n"NOR);
              }
       }
*/
  // Added By waiwai@2001/05/06 杀妖的限制.
  if (!userp(obj) && userp(me)) {
    if (obj->query("waiwai_lead")) {
      if (obj->query("owner") != (string)me->query("id")
        && obj->query("id") != (string)me->query("mieyao/id")
        && obj->query("name") != (string)me->query("mieyao/name")
        && obj->query("limit_fight"))
        return notify_fail("你不能攻击这个人。\n");
      else
        obj->set("yao_kill", 1);
    }
  }

  if (!userp(obj) && !userp(me) && wizardp(me)) {
    obj->set("yao_kill", 1);
  }

  if (userp(obj) && userp(me)) {
    log_file("kill_log", sprintf("(%s)%s(%s) tried to kill %s(%s)\n",
      log_time(), me->query("name"), me->query("id"), obj->query("name"), obj->query("id")));

    if (time() - me->query("PK_LIMIT") < 86400) return notify_fail(HIR "你刚杀过人，不能出手杀人。\n" NOR);

    if (!me->query_temp("limit_time")) me->set_temp("limit_time", time());
    if ((int)me->query_temp("limit_time") < (int)obj->query_temp("limit_time"))
      me->set("limit_K", 1);  // 这里简单做主动杀人标记
  }

  message_vision("\n$N对著$n喝道：「" + callname + "！今日不是你死就是我活！」\n\n", me, obj);

  me->kill_ob(obj);
  obj->delete_temp("fighting");
  if (userp(obj)) {
    if (me->query("age") < 18)
      me->att_kill_ob(obj);
  }
  if (!userp(obj))
    obj->kill_ob(me);
  else {
    obj->fight_ob(me);
    tell_object(obj, HIR "如果你要和" + me->name()
      + "性命相搏，请你也对这个人下一次 kill 指令。\n" NOR);
  }

  if (!userp(me)) return 1;
  if (stringp(obj->query("married"))) {
    ob = present(obj->query("married"), environment(me));
    if (ob && userp(ob) && living(ob) && ob != me) {
      if (ob->query("gender") == "男性")
        message_vision(HIW "\n$N一声怒吼：" + me->name() + "！你竟敢欺负俺老婆，我跟你拼了！\n\n" NOR, ob);
      else
        message_vision(HIM "\n$N娇喝一声：" + me->name() + "！看来你不把咱夫妇放在眼里，看招！\n\n" NOR, ob);
      ob->kill_ob(me); me->fight_ob(ob);
    }
  }
  if (!stringp(callname = obj->query("family/family_name")))
    if (!stringp(callname = obj->query("friend")))
      return 1;
  ob = first_inventory(environment(me));
  while (ob) {
    if (ob != obj && ob->is_character() && !ob->is_corpse() && living(ob) && !ob->query("zhangmen")) {
      //保护互助
      if (obj->query_temp("protected")
        && objectp(guard_ob = present(obj->query_temp("protect_ob"), environment(obj)))
        && (string)guard_ob->query_temp("protect") == obj->query("id")
        && guard_ob != me) {
        message_vision(HIC "$N对着$n大声说：有我在此，不用担心！\n" NOR, guard_ob, obj);
        message_vision(HIC "$N冲上前去挡住了$n的攻击。\n" NOR, guard_ob, me);
        guard_ob->kill_ob(me);
        me->kill_ob(guard_ob);
      }

      //同门互助（玩家可不参与）
      if ((string)ob->query("family/family_name") == callname && !ob->is_killing(me) && !userp(ob)) {
        message_vision(CYN "\n$N大怒：" + me->name() + "！你竟敢谋害我的同门？看招！\n\n" NOR, ob);
        ob->kill_ob(me); me->kill_ob(ob);
      }

      //拜把的兄弟互助
      //            if ((string)ob->query("jiebai")==callname  || (string)ob->query("jiebai")==obj->query("id") ){
      if (ob->is_brother(obj) || obj->is_brother(ob)) {
        message_vision(CYN "\n$N冷冷一笑：" + me->name() + "！你要杀我拜把的兄弟，得先问问我！\n\n" NOR, ob);
        ob->kill_ob(me); me->fight_ob(ob);
      }
    }
    ob = next_inventory(ob);
  }

  if (obj && me && userp(obj) && userp(me)
    && (!living(obj) && me->query("mud_age") < (time() - me->query("birthday")) / 24
      || me->query("mud_age") / 6 > me->query("combat_exp"))) {
    message_vision("$N忽然想起自己是死大米，顿时万念俱灰。\n", me);
    me->set("kee", -1);
  }

  return 1;
}
int help(object me) {
  write(@HELP

指令格式 : kill <人物>
 
这个指令让你主动开始攻击一个人物，并且试图杀死对方，kill 和 fight 最大的
不同在於双方将会真刀实枪地打斗，也就是说，会真的受伤。由於 kill 只需单方
面一厢情愿就可以成立，因此你对任何人使用 kill 指令都会开始战斗，通常如果
对方是 NPC 的话，他们也会同样对你使用 kill。
当有人对你使用 kill 指令时会出现红色的字样警告你，对於一个玩家而言，如果
你没有对一名敌人使用过 kill 指令，就不会将对方真的打伤或杀死( 使用法术除
外)。
道行<10年,武学<10万不能主动攻击别人。

其他相关指令: fight
有关 fight 跟 kill 的区分请看 'help combat'.

HELP
  );
  return 1;
}
