//CMDS STD buy.c
//Last modified by waiwai@2001/05/01
//删除势力参数设置，加入出生地参数关联

//#define FAMILYD "/adm/daemons/familyd"
//#define SHILI_D "/adm/daemons/shili"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string banghui, reincarnate;
  int much;
  string item, targ;
  object ob, owner;
  int price, afford, time;
  string fname, opfaname, faname = me->query("family/family_name");
  string *slist;

  if (this_player()->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (!arg || sscanf(arg, "%s from %s", item, targ) != 2)
    return notify_fail("指令格式：buy <某物序号> from <某人>\n");

  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁买东西？\n");

  if (userp(owner)) {
    message_vision("$N想向$n购买「" + item + "」。\n", me, owner);
    notify_fail("对方好像不愿意跟你交易。\n");
    return 1;
  }

  //By waiwai@2001/05/01 added.
  if ((price = owner->buy_object(me, item)) < 1) return 0;
  //检测是否同帮之人,若是,则price减半.
  if (stringp(banghui = me->query("banghui")) &&
    banghui == (string)owner->query("banghui"))
    (int)price = (price * 2 / 3);
  if (price <= 0) price = 1;

  //By waiwai@2001/05/01 added.
  //根据投胎参数price变化.
  if (me->query("changed") == "神界" || me->query("changed") == "魔界") {
    if (me->query("changed") == "神界") {
      (int)price = (price / 3);  //原值的1/3
      message_vision("$n对$N说，这位" + me->query("changed") + "大神请了，就收您1/3的钱吧，多谢多谢！\n", me, owner);
      if (price <= 0) price = 1;
    }
    if (me->query("changed") == "魔界") {
      (int)price = (price / 2);  //原值的1/2
      message_vision("$n对$N说，这位" + me->query("changed") + "老大，就收您一半的钱吧，得罪得罪！\n", me, owner);
      if (price <= 0) price = 1;
    }
  } else if (stringp(reincarnate = me->query("changed")) && reincarnate == (string)owner->query("changed")) {
    (int)price = (price * 2 / 3);  //原值减1/3
    message_vision("$n对$N说，由于你是" + owner->query("changed") + "人士，就少收您1/3钱了！\n", me, owner);
    if (price <= 0) price = 1;
  } else {
    (int)price = (price + price / 3);  //原值加1/3
    if (owner->query("changed"))
      message_vision("$n对$N说，由于你不是" + owner->query("changed") + "人士，要加收您1/3的钱了！\n", me, owner);
    else
      message_vision(
        "$n对$N说，由于你不是" + MISC_D->find_place(environment(owner)) + "人士，要加收您1/3的钱了！\n",
        me,
        owner
      );

    if (price <= 0) price = 1;
  }

  //        if( (price = owner->buy_object(me, item)) == -1 ) return 1;
  //        if( price < 1 ) return 0;
  /*
        fname=file_name(environment(me));
        slist=explode(fname,"/");
        opfaname=SHILI_D->query_family(slist[sizeof(slist)-2]);
        if((opfaname!="")&&(opfaname==faname)){
                message_vision("$n对$N说，由于贵门多年照顾，就收您一半的钱了.\n",me,owner);
                price=price/2;
        }
        if((opfaname!="")&&faname&&(FAMILYD->family_relation(opfaname,faname)==-1)){
                message_vision("$n对$N说，"+SHILI_D->query_master(opfaname)+"说了，卖给贵门派弟子的东西，价格都要翻倍。\n",me,owner);
                price=price*2;
        }
*/
  if (afford = me->can_afford(price)) {
    if (afford == 2)
      return notify_fail("你没有足够的零钱，而银票又没人找得开。\n");

    if (owner->complete_trade(me, item)) {
      me->pay_money(price);
      //By waiwai@2001/05/01
      much = (int)(price / 10);
      if (much <= 0) much = 1;
      //		"/cmds/adm/ctom.lpc"->save_money(owner,much);
      owner->compelete_trade(me, item);
      me->start_busy();
      //
      return 1;
    } else {
      return 0;
    }
  } else
    return notify_fail("你的钱不够。\n");
}

int help(object me) {
  write(@HELP

指令格式: buy <某物> from <某人>

这一指令让你可以从某些人身上买到物品。

根据你先天的投胎地可以在相应的地区买商品得到优惠
是自己投胎地的买商品减收原值的1/3。不是的加收原值的1/3
转生后是神界的在任何地方买商品收取货值的1/3
转生后是魔界的在任何地方买商品收取货值的1/2

HELP
  );
  return 1;
}
