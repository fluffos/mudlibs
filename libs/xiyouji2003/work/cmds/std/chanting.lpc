// Update by waiwai@2003/04/25

#include <ansi.h>

string *msg = ({
  "多欲为苦，生死疲劳，从贪欲起；少欲无为，身心自在。",
  "懈怠坠落，常行精进，破烦恼恶，摧伏四魔，出阴界狱。",
  "愚痴生死，菩萨常念，广学多闻，增长智慧，成就辩才，教化一切，悉以大乐。",
  "贫苦多怨，横结恶缘，菩萨布施，等念怨亲，不念旧恶，不憎恶人。",
  "生死炽燃，苦恼无量，发大乘心，普济一切。",
  "愿代众生，受无量苦，令诸众生，毕竟大乐。",
  "愿以此功德，庄严佛净土，上报四重恩，下济三途苦。",
  "若有见闻者，悉发菩提心，常行菩萨道，广度诸有情。",
  "求经者，万缘都罢。",
  "了性者，诸法皆空。",
  "大智闲闲，澹泊在不生之内。",
  "真机默默，消遥于寂灭之中。",
  "三界空而百端治，六根净而千种穷。",
  "若乃坚诚知觉，须当识心。",
  "心净则孤明独照，心存则万境皆清。",
  "真容无欠亦无余，生前可见。",
  "幻相有形终有坏，分外何求。",
  "行功打坐，乃为入定之原。",
  "布惠施恩，诚是修行之本。",
  "大巧若拙，还知事事无为。",
  "善计非筹，必须头头放下。",
  "但使一心不动，万行自全。",
  "若云采阴补阳，诚为谬语，服饵长寿，实乃虚词。",
  "只要尘尘缘总弃，物物色皆空。",
  "素素纯纯寡爱欲，自然享寿永无穷。",
});

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  int times;

  if (me->query_skill("chanting", 1) < 20)
    return notify_fail("你的诵经修为太低，不能行功修炼！\n");

  if (me->is_busy() ||
    me->query_temp("no_move") ||
    me->query("doing") ||
    me->query_temp("pending/chanting"))
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("战斗中不能诵经。\n");

  if ((int)me->query("sen") * 100 / (int)me->query("max_sen") < 50)
    return notify_fail("你现在神智不清，再炼恐怕要走火入魔！\n");

  if ((int)me->query("kee") * 100 / (int)me->query("max_kee") < 50)
    return notify_fail("你现在体力不够，再练就要累死了！\n");

  if ((int)me->query("water") < 50)
    return notify_fail("你现在口干舌燥，还是歇歇吧。\n");

  if (!environment(me)->query("sleep_room") &&
    !environment(me)->query("jingzuo_room"))
    return notify_fail("你必须在一个安静的地方才能诵经。\n");

  times = me->query_skill("chanting", 1) / 2;
  times += 10 + random(20);
  if (times > 60) times = 60;
  if ((string)me->query("family/family_name") == "南海普陀山" &&
    me->query("bonze/class") == "bonze")
    times /= 2;
  me->set_temp("pending/chanting", 1);
  me->set_temp("doing_xiudao", 1);

  me->set_temp("chanting_cost", times);
  message_vision(HIY "$N席地而坐，双目微闭，口中轻声诵起了经文。\n" NOR, me);
  me->start_busy(bind((: call_other, __FILE__, "chanting" :), me));
  return 1;
}

int chanting(object me) {
  int gain, times, pot, max_pot;

  times = me->add_temp("chanting_cost", -1);
  if (times) {
    if (!(times % 3)) {
      if (me->query("water") < 50) {
        message_vision("$N觉得口干舌燥，只好先停止了诵经。\n", me);
        me->delete_temp("pending/chanting");
        me->delete_temp("chanting_cost");
        return 0;
      }
      if (me->query("sen") < 100) {
        message_vision("$N觉得精神不济，只好先停止了诵经。\n", me);
        me->delete_temp("pending/chanting");
        me->delete_temp("chanting_cost");
        return 0;
      }
      me->add("water", -5 - random(5));
      gain = 80 - me->query_spi();
      gain += random(gain);
      me->receive_damage("sen", gain);
      if (!(times % 6))
        message_vision(HIY "$N轻声念道：" + msg[random(sizeof(msg))] + "\n" NOR, me);
    }
    return 1;
  }
  gain = me->query_skill("chanting", 1) * 10;
  gain += me->query_spi() * 5;
  gain += random(gain);
  gain /= 10;
  if (gain > 200)
    gain = 200;
  me->add("daoxing", gain / 2);
  me->add("chanting_rewards", gain);
  pot = gain / 8;
  max_pot = me->query_skill("chanting", 1) * 20;
  if ((me->query("potential") - me->query("learned_points")) < max_pot)
    me->add("potential", pot);
  else pot = 0;
  me->add("bellicosity", -gain);
  if (me->query("bellicosity") < 0)
    me->set("bellicosity", 0);
  me->improve_skill("chanting", random(gain / 2) + 1, 1);

  me->delete_temp("doing_xiudao");

  message_vision(HIY "$N轻声念道：" + msg[random(sizeof(msg))] + "\n" NOR, me);
  message_vision(HIY "$N缓缓睁开眼睛，长舒一口气站了起来。\n" NOR, me);
  tell_object(me, sprintf("你的道行增加了%s，潜能增加了%s点。\n",
    COMBAT_D->chinese_daoxing(gain), chinese_number(pot)));

  if ((string)me->query("family/family_name") == "南海普陀山" &&
    me->query("bonze/class") == "bonze" &&
    environment(me)->query("jingzuo_room")) {
    me->improve_skill("buddhism", 2 * (gain + random(gain)), 1);
    tell_object(me, "你觉得对大乘佛法的领会又进了一层。\n");
  }
  me->delete_temp("pending/chanting");
  me->delete_temp("chanting_cost");

  return 0;
}

int help(object me) {
  write(@HELP
指令格式 : chanting

诵经修炼可以提高道行和潜能，并且化解怨恨（减杀气）。

HELP);
  return 1;
}
