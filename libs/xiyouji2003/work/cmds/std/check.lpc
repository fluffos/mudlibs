// Update by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;

mapping sx_name=([
	"jin" : HIY"金系"NOR,
	"mu"  : HIG"木系"NOR,
	"shui": HIC"水系"NOR,
	"huo" : HIR"火系"NOR,
	"tu"  : YEL"土系"NOR,
]);

int main(object me,string arg)
{
	object ob;
	int mana_cost;
	int sen_cost;
	string msg, mana_sx;

	if(!arg) 
		return notify_fail("你想打听谁的状态？\n");

	//Added By waiwai@2001/04/01
	if( !wizardp(me) && userp(me) ){
	if(environment(me)->query("no_fight") || environment(me)->query("no_magic") )
		return notify_fail("安全区内不能用地耳灵。\n");

       if (me->is_busy() || me->is_fighting() )
      		return notify_fail("你现在正忙着呢。\n");

       if( me->is_ghost() )
         return notify_fail(HIB"做了鬼了，就老实点吧！\n"NOR);

       if( me->query_temp("kill_created") )  
	return notify_fail(HIR"由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n"NOR);


	if((int)me->query("daoxing")<100000)
		return notify_fail("你的道行不够，用不了地耳灵。\n");
	         
        if((int)me->query("mana")<60) 
		return notify_fail("你的法力不够，用不了地耳灵。\n");

//	if((int)me->query("sen")<=60)
//		return notify_fail("你现在太累了，休息休息吧！\n");
	if( (int)me->query("sen") <= 60 || uptime()-me->query_temp("last_check_time")<30)
            return notify_fail(WHT"你的精神无法集中或是check间隔时间不足30秒。\n"NOR);

//	    if( uptime()-me->query_temp("last_check_time")<5)
//            return notify_fail(WHT"你正忙着。\n"NOR);

        me->set_temp("last_check_time",uptime());
	}

	mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
	mana_cost=mana_cost+10;
	if(mana_cost > -100) mana_cost=-100;
	me->add("mana", mana_cost);

	sen_cost=50;
	message_vision(WHT"$N口中念了几句咒文，眼中突然精光一闪，大喝一声"HIY"“顺风耳何在！”"NOR WHT"
只见一股烟雾过后，一个神色慌张的家伙不知从哪里钻了出来在$N耳边低声嘀咕了几句。\n"NOR, me);
	ob = find_player(arg);
//	me->start_busy(5);
	me->add("sen", -60);

       // Added By waiwai@2000/12/10 暂且如此.
       if( userp(me) && (wiz_level(me) < wiz_level(ob)) )
		return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");

       if( wizardp(me) && (wiz_level(me) < wiz_level(ob)) )
		return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");

        if( ob != me && ob ) {

        if( ob->query("limit_check") )
                return notify_fail("顺风耳告诉你：这个。。。小人不敢说。\n");

        if( !me->query("vip") && ob->query("vip") )
                return notify_fail("顺风耳告诉你：这个小人不敢说，那人是VIP会员。\n");

	// Added by waiwai@2003/04/25
        if (environment(ob)->query("no_find")) 
                return notify_fail("顺风耳告诉你：这个。。。小人不敢说。\n");

        if( ob->query("capapie_tattoo") ) {
                if( !wizardp(me) && ob->query("capapie_tattoo/feature/no_check") )
                return notify_fail("顺风耳告诉你：“" + ob->name() + "身上刺着"
                        + ob->query("capapie_tattoo/totem") + "，小的实在不敢泄露天机。”\n");
        } else {
                mapping tattoo;
                if( mapp( tattoo = ob->query("tattoo") ) ) {
                        string *limbs = keys(tattoo);

                        foreach(string limb in limbs)
                                if( !wizardp(me) && ob->query("tattoo/" + limb + "/feature/no_check") )
                                return notify_fail("顺风耳告诉你：“" + ob->name() + "身上刺着"
                                + ob->query("tattoo/" + limb + "/totem") + "，小的实在不敢泄露天机。”\n");
                }
        }
        }

	if(!ob) {
	    ob=present(arg,environment(this_player()));
	    if(ob && !living(ob)) ob=0;
	}
	if( !ob ) ob = find_living(arg);
	if(!ob || (ob->query("env/invisibility") && wizardp(ob) ))
		return notify_fail("顺风耳告诉你：奇怪，找不到这个人．．．\n");

	if( !wizardp(me) )
	if((int)ob->query("age") <= 16 && userp(ob) && ob!=me)
		return notify_fail("顺风耳告诉你：你竟要我去打听小孩子，有没有搞错！\n");
	
	write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIR"道行"+NOR"修行已达"+
RANK_D->describe_dx((int)ob->query("daoxing"))+"的境界。\n");	
	write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIY"武学"+NOR"修为已达"+
RANK_D->describe_exp((int)ob->query("combat_exp"))+"的境界。\n");
	write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIB"法力"+NOR"修为已达"+
RANK_D->describe_fali((int)ob->query("max_mana"))+"的境界。\n");	
	write("顺风耳告诉你："NOR+HIY+log_id(ob)+HIC"的"NOR+HIM"内力"+NOR"修为已有"+
RANK_D->describe_neili((int)ob->query("max_force"))+"的火候。\n");	

//	if( !wizardp(me) )
//	if( RANK_D->grade_dx( RANK_D->describe_dx( (int)me->query("daoxing") ) ) 
//	> RANK_D->grade_dx(HIB "渐入佳境" NOR) )	{
		if( !ob->query("ultimate") )
			write("顺风耳告诉你："+log_id(ob)+"好象并没有使用任何五行相生相克属性！\n");
//			write("顺风耳告诉你："+ob->query("name")+"好象并没有使用任何具有五行相生相克之理的法术！\n");
		else {
              if(ob->query("ultimate")=="甲木") mana_sx = HIM"森林之木";
              if(ob->query("ultimate")=="乙木")	mana_sx = HIM"花草之木";
              if(ob->query("ultimate")=="丙火")	mana_sx = HIR"太阳之火";
              if(ob->query("ultimate")=="丁火")	mana_sx = HIR"灯盏之火";
              if(ob->query("ultimate")=="戊土")	mana_sx = HIW"大地之土";
              if(ob->query("ultimate")=="已土")	mana_sx = HIW"田园之土";
              if(ob->query("ultimate")=="庚金")	mana_sx = HIY"斧钺之金";
              if(ob->query("ultimate")=="辛金")	mana_sx = HIY"首饰之金";
              if(ob->query("ultimate")=="壬水")	mana_sx = HIG"翰海之水";
              if(ob->query("ultimate")=="癸水")	mana_sx = HIG"雨露之水";
/*
			switch( ob->query_skill_mapped("spells") ) {
				case "buddhism":
					mana_sx = "tu";
					break;
				case "dao":
					mana_sx = "mu";
					break;
				case "moonshentong":
					mana_sx = "shui";
					break;
				case "seashentong":
					mana_sx = "shui";
					break;
				case "gouhunshu":
					mana_sx = "shui";
					break;
				case "yaofa":
					mana_sx = "tu";
					break;
				case "pingtian-dafa":
					mana_sx = "huo";
					break;
				case "dengxian-dafa":
					mana_sx = "mu";
					break;
				case "taiyi":
					mana_sx = "huo";
					break;
				case "taoism":
					mana_sx = "jin";
					break;
				case "baguazhou":
					mana_sx = "mu";
					break;
				case "pansi-dafa":
					mana_sx = "tu";
					break;
				case "feisheng-spells":
					mana_sx = "jin";
					break;
				case "fumozhou":
					mana_sx = "jin";
					break;
				case "yufeng-shu":
					mana_sx = "huo";
					break;
				case "xuanhu-shentong":
					mana_sx = "jin";
					break;
			}
*/
			write("顺风耳告诉你："HIY+log_id(ob)+HIC"的"HIG"五行"NOR"所属似乎是"+
				mana_sx+NOR"体系。\n");
//				sx_name[mana_sx]+NOR"体系。\n");
		}
//	}

       message_vision(WHT"$N忽然莫名其妙地哆嗦了一下。\n"NOR,ob); 
	msg=MAG"你急忙掐指一算，"NOR;

	if( wizardp(me) && !wizardp(ob) ) {
	msg+=MAG"心中却只是一片茫然。\n"NOR;
	} else
	if( ob->query("daoxing")>me->query("daoxing")/5 )
		msg+=MAG"原来是 "HIR+log_id(me)+NOR MAG" 正在打听你的道行。\n"NOR;
	else  
	msg+=MAG"心中却只是一片茫然。\n"NOR;
	tell_object(ob, msg);

	return 1;
}

int help(object me)
{
	write(@HELP

指令格式 : check|cha [<某人>]

地耳灵: 打听别人现在的道行,法力,武学以及内力级别。
要求道行大于100年

HELP
    );

	write("道行境界：\n\n");
	write(RANK_D->query_description(0));
	write("\n武学境界：\n\n");
	write(RANK_D->query_description(1));
	write("\n法力修为：\n\n");
	write(RANK_D->query_description(2));
	write("\n\n");	
		
    return 1;
}

