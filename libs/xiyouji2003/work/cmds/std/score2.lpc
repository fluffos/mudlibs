#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string transfer_string(string str, int length);

string display_faith(int faith);
void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my;
        string line, str, skill_type;
        object weapon;
        int attack_points, dodge_points, parry_points;
        int i, total;

        seteuid(getuid(me));

        if(!arg)
                ob = me;
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看谁的状态？\n");
        } else
                return notify_fail("只有巫师能察看别人的状态。\n");

        my = ob->query_entire_dbase();

	line=GRN"\n◎"NOR"＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝〖  个 人 档 案  〗＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝"GRN"◎\n"NOR;

	line+=sprintf("  【中文姓名】：%-23s【英文代号】：%s\n", 
			ob->name(1), capitalize(ob->query("id")));
	line+=sprintf("  【年    龄】：%-23s【性    别】：%s\n", 
			chinese_number(ob->query("age"))+"岁",
			ob->query("gender"));
		
//	line+=sprintf("  【族    别】：%-22s\n",ob->query("race"));

	line += sprintf("  【种    族】：%-22s", 
		ob->query("zhongzu")?ob->query("zhongzu"):"无"); 

        // Added By waiwai@2001/05/01
        if(ob->query("occupation")){
              if(ob->query("occupation")=="fighter")
                      line +=" 【职    业】：武  士\n";
              if(ob->query("occupation")=="stief")
                      line +=" 【职    业】：窃  贼\n";
              if(ob->query("occupation")=="smith")
                      line +=" 【职    业】：工  匠\n";
              if(ob->query("occupation")=="doctor")
                      line +=" 【职    业】：巫  医\n";
              if(ob->query("occupation")=="enchanter")
                      line +=" 【职    业】：术  士\n";
              if(ob->query("occupation")=="businessman")
                      line +=" 【职    业】：商  人\n";
              if(ob->query("occupation")=="farmer")
                      line +=" 【职    业】：农  夫\n";
        }else line+=" 【职    业】：无\n";

	line+=sprintf("  【星    座】："+ob->query("12_xz")+"               【生    肖】：%s\n", 
			ob->query("12_sx"));
	
	line+=sprintf("  【体    格】：%-23s【根    骨】：%s\n", 
			display_attr(my["str"], ob->query_str()),
                        display_attr(my["con"], ob->query_con()));
	line+=sprintf("  【悟    性】：%-23s【灵    性】：%s\n", 
                        display_attr(my["int"], ob->query_int()),
                        display_attr(my["spi"], ob->query_spi()));

	if((wizardp(me) && me->query("env/score")) ||
		RANK_D->grade_dx(RANK_D->describe_dx(ob->query("daoxing")))>=
		RANK_D->grade_dx(CYN"脱胎换骨"NOR)) {	
		line+=sprintf("  【胆    识】：%-23s【定    力】：%s\n", 
				display_attr(my["cor"], ob->query_cor()),
                        	display_attr(my["cps"], ob->query_cps()));
		line+=sprintf("  【容    貌】：%-23s【福    缘】：%s\n", 
        	                display_attr(my["per"], ob->query_per()),
                	        display_attr(my["kar"], ob->query_kar()));
	}


        //Added By waiwai@2003/04/20
	line += sprintf("  【天    性】：%-21s", 
		ob->query("national")?ob->query("national"):"不明"); 
	line += sprintf("  【祖    籍】：%s\n", 
		ob->query("changed")?ob->query("changed"):"不明"); 

	line+=sprintf("  【罪    孽】：%4d/%5d             【善    缘】：%3d/%4d\n", 
                ob->query("impurity"),ob->query("Fimpurity"),
      	        ob->query("reason"),ob->query("Freason") );

	total = (int)ob->query("qn_balance");
	if(!total || total < 0)  ob->set("qn_balance", 0);

	line+=sprintf("  【分配点数】：%4d/%5d             【潜能储存】：%7d\n", 
                ob->query("gift_points"), ob->query("used_gift_points"),  ob->query("qn_balance") );

	if(ob->query("gender")=="男性")
		line+=sprintf("  【结发妻子】：%-22s", 
			ob->query("married") ? 
			ob->query("couple/name") : "无");
	else line+=sprintf("  【结发丈夫】：%-22s", 
			ob->query("married") ? 
			ob->query("couple/name") : "无");
			

	line+=sprintf(" 【师    承】：%s\n",
			ob->query("family")?
			transfer_string(sprintf("%s%s", 
			ob->query("family/family_name")?ob->query("family/family_name"):"",
			ob->query("family/master_name")?CYN+ob->query("family/master_name")+NOR:""), 23)
			:"无");

	line += sprintf("  【门派罪孽】：%3d", ob->query("MP_killM")); 

	if(ob->query("family"))
                line+=sprintf("                    【门派忠诚】：%s%s\n",
                        display_faith(ob->query("family/family_faith")),
                     sprintf("(%d)",ob->query("family/family_faith")));
//                     wizardp(me)?sprintf("(%d)",ob->query("family/family_faith")):"");
	else line+="                    【门派忠诚】：碌碌无为\n";	

        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";

        attack_points = COMBAT_D->skill_power(ob, skill_type,
SKILL_USAGE_ATTACK);
        parry_points = COMBAT_D->skill_power(ob, skill_type,
SKILL_USAGE_DEFENSE);
        dodge_points = COMBAT_D->skill_power(ob, "dodge",
SKILL_USAGE_DEFENSE);
			
	if(wizardp(me) && me->query("env/score"))
		line+=sprintf("  【攻 击 力】：%-23d【防 御 力】：%d\n", 
	                attack_points/100+1,
                	(dodge_points + (weapon? parry_points:(parry_points/10)))/100 + 1);

	line+=sprintf("  【道行境界】：%-23s【武学境界】：%s\n", 
		transfer_string(RANK_D->describe_dx(ob->query("daoxing")), 23),
		RANK_D->describe_exp(ob->query("combat_exp")));
	line+=sprintf("  【法力修为】：%-23s【内力修为】：%s\n", 
		transfer_string(RANK_D->describe_fali(ob->query("max_mana")), 23),
		RANK_D->describe_neili(ob->query("max_force")));

	line+=sprintf("  【实力修为】：%-23s", 
			transfer_string(RANK_D->describe_touch(attack_points/100+1), 23));

        line += "【手下亡灵】：" 
                + sprintf( "玩家：%d/%d[%d]"NOR" 位,非玩家：%d 位\n",
		my["PKS"], my["PKS1"],my["DPKS"],my["MKS"]);

	//Added By waiwai@2001/05/01
	if( !ob->query("killtocity"))  ob->set("killtocity","不明区域");

        if( ob->query("killtoname") && ob->query("killtoid") )
	line+=sprintf("  【上次杀戮】：[%s] 将"YEL"%s(%s)"NOR"杀死在%s \n",
		ob->query("killtotime"), ob->query("killtoname"),
		ob->query("killtoid"), ob->query("killtocity"));
              else
        if( !ob->query("killtoname")) line+= "  【上次杀戮】：无\n";

	//Added By waiwai@2001/05/01
	if( !ob->query("killbycity"))  ob->set("killbycity","不明区域");

        if( ob->query("killbyname") && ob->query("killbytime") && ob->query("killbyname")!="死因不明"){
	line+=sprintf("  【上次死因】：[%s] 被"YEL"%s(%s)"RED"%s"NOR"而死在%s\n",
		ob->query("killbytime"), ob->query("killbyname"),ob->query("killbyid"),
		ob->query("killbyB")?ob->query("killbyB"):"", ob->query("killbycity"));
              } else
        if( ob->query("killbyname") && ob->query("killbyname")!="死因不明"){
                line+= "  【上次死因】：因"YEL+ob->query("killbyname")+"("+ob->query("killbyid")+")"RED+
(ob->query("killbyB")?ob->query("killbyB"):"")+NOR"而死在"+ob->query("killbycity")+" 时间不明 \n";
	  }
        if( ob->query("killbyname") && ob->query("killbytime") && ob->query("killbyname")=="死因不明"){
	line+=sprintf("  【上次死因】： [%s] 死因不明 而死在%s\n",ob->query("killbytime"),  ob->query("killbycity"));
//                 line+= "  【上次死因】："YEL"死因不明 "NOR"在"+ob->query("killbycity")+"["+ob->query("killbytime")+"] \n"NOR;
              } else
        if( ob->query("killbyname") && ob->query("killbyname")=="死因不明"){
                 line+= "  【上次死因】："YEL"死因不明 时间不明 "NOR"在"+ob->query("killbycity")+"\n"NOR;
	  } 

        if( !ob->query("killbyname")) line+= "  【上次死因】：不明\n";


	line+=GRN"◎"NOR"＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝〖   "HIR"西 游 记"NOR"   〗＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝"GRN"◎\n"NOR;
		
        write(line);
        return 1;
}

string display_attr(int gift, int value)
{
	string arrow;
	
	if(value>gift)
		arrow=HIW"→"NOR;
	else if( value < gift )
		arrow=HIB"→"NOR;
	if(strlen(arrow)>0)
		return sprintf("[%3d]%s[%3d]%11s", gift, arrow, value, " ");
	else return sprintf("[%3d]", gift);
	
}

string transfer_string(string str, int length)
{
	string str1, str2, tmp;
	int i;

	tmp=str;
	while(sscanf(str,"%s%*sm%s",str1,str2)==3)
		str=str1+str2;
	i=length-strlen(str);
	while(i>0)
	{
		tmp+=" ";
		i--;
	}
	return tmp;
}


string status_color(int current, int max)
{
        int percent;
        string clr;
 
        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) clr=HIC;
        else if( percent >= 90 ) clr=HIG;
        else if( percent >= 60 ) clr=HIY;
        else if( percent >= 30 ) clr=YEL;
        else if( percent >= 10 ) clr=HIR;
        else clr=RED;
        return clr+current+NOR;
}



nosave int sort_keys(int one, int two)
{
        return one-two;
}

string display_faith(int faith)
{
        string msg;
        int *lists, i;
        mapping desc=([
        -1000   :       HIR"大逆不道"NOR,
        -600    :       RED"倒行逆施"NOR,
        -300    :       HIB"胡做非为"NOR,
        -50     :       BLU"带罪之身"NOR,
        0      :       "碌碌无为",
        50      :       "无功无过",
        200     :       YEL"任劳任怨"NOR,
        500     :       HIY"忠心耿耿"NOR,
        1000    :       HIC"劳苦功高"NOR,
        2000    :       WHT"鞠躬尽瘁"NOR,
        5000    :       HIW"死而后已"NOR,
        ]);
        lists=keys(desc);
        lists=sort_array(lists, "sort_keys", this_object());
        for(i=0;i<sizeof(lists);i++)
        {
                msg=desc[lists[i]];
                if(faith<lists[i])
                        break;
        }
        
        return msg;
}

int help(object me)
{
        write(@HELP
指令格式 : score/sc
           score <对象名称>                   (巫师专用)

这个指令可以显示你或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

对于隐藏参数只有当你道行达到脱胎换骨时才
可以看到。。。

see also : hp
HELP
    );
    return 1;
}



