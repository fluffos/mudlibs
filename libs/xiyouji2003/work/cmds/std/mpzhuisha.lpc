// Created by waiwai@2001/04/19

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object lp;
	string family,msg;
	string str;
	object target,*name;
	int i,cnt;

	if(! (family=me->query("family/family_name")))
			return notify_fail("只有同门派的人使用这条命令才有效。\n");


	if(! arg)	{
		msg=HIR+me->query("family/family_name")+"追杀令黑名单(只显示在线玩家)：\n"NOR;
		msg+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
		name=users();
		cnt=0;
		for(i=0;i<sizeof(name);i++)	{
			if(name[i]->query("vendetta/"+family))	{
			msg+=sprintf("%-18s%s",name[i]->query("name")+"("+name[i]->query("id")+")",
			(cnt%4==3? "\n":""));
			cnt++;
			}
		}
		if(cnt==0||(cnt%4))	msg+="\n";
		msg+="━━━━━━━━━━━━━━━━━━━━━━━━━━━ [ "HIR"西游记"NOR" ] ━━━━\n";
		me->start_more(msg);
		return 1;
	}
	if(sscanf(arg,"-a %s",str)==1)	{

		if( !me->query("zhangmen/title") && !wizardp(me))
			return notify_fail(HIR"只有掌门才能使用追杀令。\n"NOR);

		target=find_player(str);

		if(! target)
			return notify_fail("你想追杀的玩家不在游戏中。\n");

              if (wiz_level(me) < wiz_level(target))
               return notify_fail("你想追杀的玩家不在游戏中。\n");

		if(target==me)
			return notify_fail("追杀自己？没问题吧。\n");

		if( !wizardp(me) && userp(me) && wizardp(target))
			return notify_fail("追杀巫师？你想灰飞湮灭吗？\n");

		if(target->query("vendetta/"+family))
			return notify_fail("此玩家已在黑名单中。\n");

		// Added By waiwai@2001/03/17
		if( !wizardp(me) && userp(me) ){
			if( time()-me->query_temp("last_zhuisha2_time")<1800)
		            return notify_fail(WHT"你下达的追杀指令时间间隔必须大于30分钟。\n"NOR);
		}
      		me->set_temp("last_zhuisha2_time",time());

		target->set("ZSmenpai",me->query("family/family_name"));
		target->apply_condition("mpzs",100);
		target->set("vendettaFT",time());
		target->set("vendetta/"+family,1);
		target->save();

		if(family==(string)target->query("family/family_name"))
		message("channel:rumor",
                  HIR"【门派追杀令】"HIR+log_id(me)+"：门派"HIW+family+HIR" 通告天下："HIR"

　　　　　　  我门内成员"+
		target->query("name")+"("+target->query("id")+")

　　　　　　  违我门规！杀戮同门！
　　　　　　  门派成员！如见此人！
　　　　　　  格杀无论！致死为止！\n\n"NOR,users());
		else
           message("channel:rumor",
                  HIR"【门派追杀令】"HIR+log_id(me)+"：门派 "HIW+family+HIR" 通告天下："HIR"

　　　　　　  大胆狂徒"+target->query("name")+"("+target->query("id")+")

　　　　　　  触我天条！辱我门威！
　　　　　　  门派成员！如见此人！
　　　　　　  格杀无论！不死不休！\n\n"NOR,users());
		return 1;
	}

	if(sscanf(arg,"-d %s",str)==1)	{
		if( !me->query("zhangmen/title") && !wizardp(me))
			return notify_fail(HIR"只有掌门才能使用追杀赦免令。\n"NOR);

		target=find_player(str);
		if(! target)	return notify_fail("此处没有这么个玩家。\n");
		if(! target->query("vendetta/"+family))
			return notify_fail("此玩家并不在追杀的黑名单中。\n");
		target->delete("ZSmenpai");
		target->clean_condition("mpzs");
		target->delete("vendettaFT");
		target->delete("vendetta/"+family);
		target->remove_all_killer();
		target->save();
		message("channel:rumor",
		HIR"【追杀赦免令】"+log_id(me)+"：门派"HIW"「"+family+"」"HIR" 现在决定停止追杀"+
target->query("name")+"("+target->query("id")+")\n"NOR,users());
		return 1;
	}
	return notify_fail("指令格式：zhuisha2 [-a][-d]<玩家ID>\n");
}

int help(object me)
{
        write(@HELP

指令格式：mpzhuisha [-a][-d] <对象ID>

本指令为掌门专用，不加参数显示目前在线被追杀的玩家。
-a 追杀某玩家，-d 取消追杀某玩家。当被追杀玩家死亡，
则自动停止追杀。每次追杀令下达间隔时间必须在30分钟
以上。每次追杀时效3个小时。

HELP
        );
        return 1;
}
