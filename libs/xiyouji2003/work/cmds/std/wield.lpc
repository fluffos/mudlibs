// Update by waiwai@2002/12/05
// 所有限制属性基本上在F_EQUIP里面设定

inherit F_CLEAN_UP;
#include <ansi.h>

int do_wield(object me, object ob);

int main(object me, string arg) {
  object ob, *inv;
  int i, count;

  if (!arg) return notify_fail("你要装备什么武器？\n");

  if (arg == "all") {
    inv = all_inventory(me);
    for (count = 0, i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped")) continue;
      // Added by waiwai@2003/01/19
      if (inv[i]->query("no_all")) continue;
      if (inv[i]->query("combine")) continue;
      if (inv[i]->query("area_name")) continue;
      if (inv[i]->query("need_family")) continue;
      if (inv[i]->query("vip_only")) continue;
      if (inv[i]->query("family_only")) continue;
      if (inv[i]->query("no_weapon")) continue;
      if (do_wield(me, inv[i])) count++;
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");

  if (ob->query("equipped"))
    return notify_fail("你已经装备着了。\n");

  return do_wield(me, ob);
}

int do_wield(object me, object ob) {
  string str;
  string banghui, family, family_W;
  object area;

  area = new("/obj/area");
  area->create(ob->query("area_name"));
  ob->set("banghui", (string)area->query("banghui"));
  destruct(area);
  banghui = (string)ob->query("banghui");
  family = (string)me->query("family/family_name");
  family_W = (string)ob->query("need_family");

  if (!wizardp(me) && userp(me)) {
    if (ob->query("owner_id") && ob->query("owner_id") != getuid(me)) {
      write("下次别乱偷别人的东西.\n");
      write(ob->name() + "冲天而去，消失不见了.\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("combine") && ob->query("owner_id") != getuid(me)) {
      write("下次别乱偷别人的东西.\n");
      write(ob->name() + "冲天而去，消失不见了.\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("family_only") &&
      me->query("family/family_name") != ob->query("family_only")) {
      write(ob->query("family_only") + "门派专用武器你不能装备.\n");
      write(ob->name() + "冲天而去，消失不见了.\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("vip_only") && !me->query("vip")) {
      write("VIP会员专用武器你不能装备.\n");
      write(ob->name() + "冲天而去，消失不见了.\n");
      destruct(ob);
      return 1;
    }

    if (ob->query("has_player") && ob->query("has_player") != log_id(me))
      return notify_fail("这样东西是" + ob->query("has_player") + "的。\n");


    // Added by waiwai@2002/12/05
    if (banghui && (string)me->query("banghui") != banghui)
      return notify_fail(HIC "这是" + ob->query("area_name") + "地盘所属物件，你不是" + banghui + "帮会的人不能装备。\n" NOR);

    // Added by waiwai@2002/12/05
    if (family_W && family_W != family)
      return notify_fail(HIC "这是" + family_W + "门派所属兵器，你不是" + family_W + "的人不能装备。\n" NOR);
  }

  if (me->query_temp("No_Wield"))
    return notify_fail("你原形已现，不可再持兵器！\n");

  if (ob->query("no_weapon"))
    return notify_fail("这件武器已经完全损毁，不能装备！\n");

  if (!wizardp(me) && userp(me) && ob->query("wiz_only"))
    return notify_fail(HIC "你无权装备这件东西！\n" NOR);

  //Added By waiwai@2002/12/25
  if (me->query_temp("kill_created"))
    return notify_fail(HIR "由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n" NOR);

  if (ob->wield()) {
    if (!stringp(str = ob->query("wield_msg")))
      str = "$N装备$n作武器。\n";
    message_vision(str, me, ob);
    return 1;
  } else
    return 0;
}

int help(object me) {
  write(@HELP

指令格式：wield|zhuangbei <装备名称>
 
这个指令让你装备某件物品作武器, 你必需要拥有这样物品。

HELP
  );
  return 1;
}
