// Update by waiwai@2002/12/05

#include <ansi.h>
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	object ob;
	string rep, str, banghui;
 
	seteuid(getuid(me));

	if(!arg)
		ob = me;
        else if ( arg == me->query("married") ) {
              ob = present(arg, environment(me));
		if(!ob || !ob->is_character())
		return notify_fail("这儿没有这么个人。\n");
              printf("你的伴侣状态如下:\n");
            }
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
	       if (!ob) return notify_fail("你要察看谁的基本生存技能状态？\n");
	}
	else if ( stringp(banghui=me->query("banghui"))) {
		ob =present(arg,environment(me));
		if(! ob)	return notify_fail("这儿没有这么个人。\n");
		if( ! ob->is_character())
			return notify_fail("你不能查看这样东西。\n");
		if( ob->query("banghui")!=me->query("banghui"))
			return notify_fail("你只能查看本帮会帮众的基本生存技能状态。\n");
		}
             else 	return notify_fail("只有巫师,伴侣或同帮会的人能察看别人的基本生存技能状态。\n");

	// Added by waiwai@2002/01/16
	if( wiz_level(me) < wiz_level(ob) )
		return notify_fail("你要察看谁的基本生存技能状态？\n");

	rep = "		 〓〓  "+ob->name(1)+" 基本生存技能表  〓〓\n";
	rep+= "┏━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━┓\n";
	rep+= sprintf("┃            基本生存技能名称                │  相应技能经验值  ┃\n");
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  1. 采矿之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/wakuang"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  2. 务农之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/farmer"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  3. 烹饪之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/cooking"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  4. 铸造之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/weapon"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  5. 镶嵌之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/combine"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  6. 捕鱼之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/fish"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  7. 狩猎之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/shoulie"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  8. 酿酒之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/niangjiu"));			
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃  9. 制药之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/medical"));	
	rep+= "┠──────────────────────┼─────────┨\n";
	rep+= sprintf("┃ 10. 战役之术                               │   "YEL"%-14d"NOR" ┃\n",ob->query("work/war"));	
	rep+= "┗━━━━━━━━━━━━━━━━━━━━━━┷━━━━━━━━━┛\n";

	write(rep);
	return 1;
}

int help(object me)
{
	write(@HELP

指令格式 : skills2/sk2
           skills2/sk2 <对象名称>   (伴侣，帮会，巫师专用)

这个指令用来查看你的基本生存技能列表 

相关讯息：sk

HELP
    );
    return 1;
}
