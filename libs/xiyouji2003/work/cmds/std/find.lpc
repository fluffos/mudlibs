// Update by waiwai@2002/12/05

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

void fail(object me);
void find_result(object me, object env, string target);

mapping maps = ([]);
void create() {
  string filename = __DIR__ "find.map";
  string buf, *buf1;
  string dir, name;
  int size, i;

  maps = ([]);

  buf = read_file(filename);
  if (!buf) return;  //no data available.

  buf1 = explode(buf, "\n");
  size = sizeof(buf1);
  if (!size) return;

  for (i = 0; i < size; i++) {
    if (sscanf(buf1[i], "%s %s", dir, name) == 2) {
      name = replace_string(name, " ", "");
      if (strlen(dir) > 2 && strlen(name) > 2) {
        maps += ([ dir: name ]);
      }
    }
  }
}

int main(object me, string target) {
  object env = environment(me);
  int mana_cost;

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");

  if (env->query("no_fight") || env->query("no_magic"))
    return notify_fail("安全区内不能用天眼通。\n");

  if (me->query_temp("kill_created"))
    return notify_fail(HIR "由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n" NOR);

  if (me->is_ghost())
    return notify_fail(HIB "做了鬼了，就老实点吧！\n" NOR);

  if (!target) return notify_fail("你想用天眼通查谁？\n");

  if ((int)me->query("daoxing") < 100000)
    return notify_fail("你的道行不够，用不了天眼通。\n");

  if ((int)me->query("sen") < 100 ||
    (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50)
    return notify_fail("你现在头晕脑胀，恐怕连自己在哪里都不清楚！\n");

  mana_cost = -160;

  if ((int)me->query("mana") + mana_cost <= 30)
    return notify_fail("你的法力不够，用不了天眼通。\n");

  me->add("mana", mana_cost);

  message_vision(
    "$N口中念了几句咒文，眼中突然精光一闪，大喝一声" + HIY "“千里眼何在！”\n"
    NOR, me);

  //Added By waiwai@2001/03/10
  if (!wizardp(me)) {
    if ((int)me->query("sen") < 60 || uptime() - me->query_temp("find_time") < 60)
      return notify_fail(WHT "你的精神无法集中或是find间隔时间不足1分钟。\n" NOR);

    me->set_temp("find_time", uptime());
    me->start_busy(5);
    me->add("sen", -60);
  }

  call_out("find_result", 2 + random(3), me, env, target);
  return 1;

}

void fail(object me) {
  tell_object(me, "千里眼告诉你：奇怪，找不到这个人．．．\n");
  return;
}

void find_result(object me, object env, string target) {
  object ob, where;
  string msg, answer;

  if (!me) return;
  if (environment(me) != env) return;

  message_vision(
    "只听几声奸笑过后，不知从哪里钻出来一个尖嘴猴腮的家伙，在$N耳边低声说了几句话。\n", me);

  ob = find_player(target);
  if (!ob) ob = find_living(target);

  // Added By waiwai@2000/12/10
  if (!ob || wizardp(ob)) return fail(me);

  if (ob != me && ob) {

    // Added By waiwai@2000/12/10
    if (!me->query("vip") && ob->query("vip")) {
      tell_object(me, "千里眼告诉你：“" + ob->name() + "是VIP会员，实在不敢泄露此人行踪。”\n");
      return;
    }

    if (ob->query("capapie_tattoo")) {
      if (ob->query("capapie_tattoo/feature/no_find")) {
        tell_object(me, "千里眼告诉你：“" + ob->name() + "身上刺着"
          +ob->query("capapie_tattoo/totem") + "，小的实在不敢泄露此人行踪。”\n");
        return;
      }
    } else {
      mapping tattoo;
      if (mapp(tattoo = ob->query("tattoo"))) {
        string *limbs = keys(tattoo);

        foreach (string limb in limbs)
          if (ob->query("tattoo/" + limb + "/feature/no_find")) {
            tell_object(me, "千里眼告诉你：“" + ob->name() + "身上刺着"
              +ob->query("tattoo/" + limb + "/totem") + "，小的实在不敢泄露此人行踪。”\n");
            return;
          }
      }
    }
  }

  where = environment(ob);
  if (!where) return fail(me);

  // Added by waiwai@2003/04/25
  if (where->query("no_find")) {
    tell_object(me, "千里眼告诉你：人是找到了，但是小的不敢说．．．\n");
    return;
  }

  if (ob->query("no_find") && !wizardp(me)) {
    tell_object(me, "千里眼告诉你：人是找到了，但是小的不敢说．．．\n");
    return;
  }

  if (present("jin gu bang", ob)) {
    tell_object(me,
      "千里眼告诉你：人是找到了，但是说不得，不能说．．．\n" +
      "那家伙带着猴子的" HIY "金箍棒 \n" NOR);
    return;
  }

  answer = MISC_D->find_place(where);
  if (!answer || sizeof(answer) < 2) return fail(me);

  tell_object(me, "千里眼告诉你：" + (string)ob->name() +
    "(" + (string)ob->query("id") + ")" +
    "在" + answer + "。\n");

  message_vision(MAG "$N“啊～～秋～～”一声打了个喷嚏，不由皱了皱眉。\n" NOR,
    ob);
  msg = MAG "你急忙掐指算去，" NOR;
  if (ob->query("daoxing") > me->query("daoxing") / 3)
    msg += MAG "似乎" + log_id(me) + "正在探听你的行踪。\n" NOR;
  else
    msg += MAG "心中却只是一片茫然。\n" NOR;
  tell_object(ob, msg);

  return;
}

int help(object me) {
  write(@HELP

指令格式 : find <某人>

天眼通：用来发现别人所在地。
要求道行100年,为了防止玩家之间flood
加入了时间间隔限制以及busy

HELP
  );
  return 1;
}
