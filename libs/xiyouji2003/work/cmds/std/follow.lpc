// CMDS STD follow.c
// By waiwai@2000/08/25 设置禁止
// Update by waiwai@2001/03/21 
// Last modified by waiwai@2003/01/19 
// 结合bian.c follow.c go.c
// 彻底解决先follow再bian为非活物而跟随的问题

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg ) return notify_fail("指令格式：follow <某人>|none。\n");

	if( arg=="none")
		if( me->query_leader() ) {
			me->set_leader(0);
			me->delete_temp("leader");
			message_vision(WHT"$N"WHT"放弃跟随行动。\n"NOR, me);
			return 1;
		} else {
			write("你现在并没有跟随任何人。\n");
			return 1;
		}

	if( !objectp(ob = present(arg, environment(me))) )
		return notify_fail("这里没有 " + arg + "。\n");


    if( !wizardp(me) && userp(me) ){//By waiwai@2001/03/21
    if( uptime()-me->query_temp("last_follow_time")<2)
            return notify_fail(WHT"歇会儿吧，喘口气。。。\n"NOR);

        me->set_temp("last_follow_time",uptime());
    }

      //Added By waiwai@2001/03/06
      if (userp(me) && !me->query("follow_ok")){
         if (wiz_level(me) < wiz_level(ob))
            return notify_fail(HIW"你不能跟随巫师。\n"NOR);
            }

      //Added By waiwai@2003/01/19
	if( me->query_temp("k_bian") )
		return notify_fail(HIC"你已变为非活物，还能跟随他人飞上天啊？\n"NOR);

       if( me->query_temp("kill_created") )  
		return notify_fail(HIR"由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n"NOR);

	if( !ob->is_character() )
		return notify_fail("什么？跟随...." + ob->name() + "。\n");

	if( ob==me )
		return notify_fail("跟随自己？\n");

	me->set_leader(ob);
	//Added by waiwai@2003/01/19 配合bian对应设置避免变为非活物follow
	me->set_temp("leader",1);

	if( !me->query("env/invisibility") )
	message_vision(YEL"$N"YEL"决定开始跟随$n"YEL"一起行动。\n"NOR, me, ob);
	else
	tell_object(me,WHT"你决定秘密地跟随"+ob->name(1)+WHT"("+ob->query("id")+WHT")一起行动。\n"NOR);

	return 1;
}

int help (object me)
{
        write(@HELP

指令格式 : follow [<生物>|none]
 
这个指令让你能跟随某人或生物。
如果输入 follow none 则停止跟随。
 
HELP
);
        return 1;
}
