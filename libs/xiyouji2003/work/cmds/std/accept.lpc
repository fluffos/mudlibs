//CMDS cmds/std/accept.c
// Update By Pkyou@DHXY


#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, env, *inv;
  int sizeinv;

  if (!wizardp(me) && userp(me)) {  //By pkyou@2002/08/30 增加禁止背人accept
    inv = all_inventory(me);
    sizeinv = sizeof(inv);

    while (sizeinv--) {
      if (inv[sizeinv]->is_character())
        return notify_fail("人家只邀请你，又没邀请你身上那个家伙！\n");
    }
  }

  if (!arg)
    return notify_fail("你要接受谁的公开邀请？\n");

  if (me->is_ghost())
    return notify_fail("做了鬼了，就老实点吧！\n");

  if (me->is_fighting())
    return notify_fail("战斗中不能接受公开邀请。\n");

  if (me->is_busy())
    return notify_fail("你很忙，不能接受公开邀请。\n");

  if (!wizardp(me) && environment(me)->query("no_accept"))
    return notify_fail("这里不能接受邀请。\n");

  obj = find_player(arg);
  if (!obj) obj = find_living(arg);
  if (!obj) obj = LOGIN_D->find_body(arg);
  if (!obj) return notify_fail("没有这个人。\n");

  if (wizardp(obj) && !wizardp(me)) return notify_fail("没有这个人。\n");

  if (obj->query_temp("invite") != "public")
    return notify_fail(obj->query("name") + "现在并没有公开邀请别人。\n");

  if (!wizardp(me) && userp(me))
    if (env = environment(me))
      if (!env->query("outdoors"))
        return notify_fail("你还是到外面去接受" + obj->query("name") + "的邀请吧！\n");

  if (!wizardp(me) && userp(me)) {

    me->set_temp("accept_time", uptime());
  }

  if (me->query_temp("accept") == obj->query("id"))
    return notify_fail("你已经接受" + obj->query("name") + "的公开邀请了。\n");

  if (!wizardp(me) && userp(me)) {
    if ((obj->query("id") == "zhenyuan_daxian") && me->query("life/live_forever"))
      return notify_fail("你已经不堕轮回了，还是把机会留给新人吧。\n");

    if ((obj->query("id") == "zhenyuan_daxian") && me->query("daoxing") >= 3456000)
      return notify_fail("你的道行太高了，大仙怕你给他砸了果树。\n");

    if ((obj->query("id") == "zhenyuan_daxian") && me->query("combat_exp") <= 100000)
      return notify_fail("你的本事还不够，镇元大仙不打算请你。\n");

    if ((obj->query("id") == "zhenyuan_daxian") && me->query("dntg/laojunlu") == "done")
      return notify_fail("镇元大仙得知你是五百年前大闹天宫的齐天大圣，不敢请你去了。\n");

    if (uptime() - me->query_temp("accept_time") < 10) {
      if ((obj->query("id") == "zhenyuan_daxian") && me->query_temp("ZY_kickout"))
        return notify_fail("镇元大仙懒得理你。\n");
    } else {
      me->delete_temp("ZY_kickout");
    }

    if ((obj->query("id") == "tai bai") && ((me->query("combat_exp") < 100000)))
      return notify_fail("太白金星对只武艺高强的人下了邀请函。\n" NOR);
  }
  tell_object(me, GRN "你接受" GRN + obj->query("name") + NOR GRN "的公开邀请。\n" NOR);
  tell_object(obj, me->query("name") + GRN "现在接受你的公开邀请。\n" NOR);

  me->set_temp("accept", obj->query("id"));
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : accept <某人>

这个指令告诉别人你接受他/她的公开邀请.
另外：1.不堕轮回,大闹天宫功德圆满以及武学小于十万，道行大于3456年
        的玩家不能accept镇元大仙.
      2.武学小于十万的玩家不能accept太白金星.
      3.禁止背负别人接受任何的邀请.

HELP
  );
  return 1;
}
