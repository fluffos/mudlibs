// Update by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object who;
	string *wives;
	mapping wiv;


	if (!arg) return notify_fail("你要向谁求婚？\n");

	if( me->is_ghost() )
		return notify_fail(HIB"做了鬼了，就老实点吧！\n"NOR);

       if(me->query("gender")=="女性")
                return notify_fail("只有男人才能向别人求婚！\n");

	if( !me->query("vip") && !wizardp(me) ) {
       if(me->query("title") == "普通百姓")
                return notify_fail(CYN"你是普通百姓,不能结婚！\n"NOR); 

	if(me->query("age") < 17)
		return notify_fail("大唐律历规定年满十七方可婚娶。\n");
	}

	if( (int)me->query("bx")>0 )
                return notify_fail(CYN"你是变性者,要结婚只有等转生了！\n"NOR); 

	if (!objectp(who=present(arg,environment(me))))
                return notify_fail("这里没有这个人。\n");

	if (!who->is_character())
                return notify_fail("想清楚！"+who->name()+"是什么呀！\n");

	if( who->is_ghost() )
		return notify_fail(HIG"向鬼求婚？勇气可佳，可惜人鬼殊途啊！\n"NOR);

	if (who==me)
                return notify_fail("开什么玩笑，发花痴啊你？\n");

	// Added by waiwai@2003/05/12 属相相冲禁止通婚
	if( !wizardp(me) ) {
       if( (me->query("12_sx")=="子鼠" && who->query("12_sx")=="午马") ||
		 (me->query("12_sx")=="丑牛" && who->query("12_sx")=="未羊") ||
		 (me->query("12_sx")=="寅虎" && who->query("12_sx")=="申猴") ||
		 (me->query("12_sx")=="卯兔" && who->query("12_sx")=="酉鸡") ||
		 (me->query("12_sx")=="辰龙" && who->query("12_sx")=="戌狗") ||
		 (me->query("12_sx")=="巳蛇" && who->query("12_sx")=="亥猪") ||
		 (me->query("12_sx")=="午马" && who->query("12_sx")=="子鼠") ||
		 (me->query("12_sx")=="未羊" && who->query("12_sx")=="丑牛") ||
		 (me->query("12_sx")=="申猴" && who->query("12_sx")=="寅虎") ||
		 (me->query("12_sx")=="酉鸡" && who->query("12_sx")=="卯兔") ||
		 (me->query("12_sx")=="戌狗" && who->query("12_sx")=="辰龙") ||
		 (me->query("12_sx")=="亥猪" && who->query("12_sx")=="巳蛇")  )
                return notify_fail("你的生肖属相"+me->query("12_sx")+"与"+who->name()+
			"的"+who->query("12_sx")+"相冲，不能成婚。\n");
	}

	if( (string)SECURITY_D->get_status(me) != "(admin)" ) {
       if ( userp(me) && userp(who) && (wizardp(me) != wizardp(who)) )
		return notify_fail(HIG"神仙与凡人是不能通婚的，做了神仙动了凡心的话结果很少会圆满的。\n"NOR);

       if ((int)me->query("married")>=2)
               return notify_fail("哈哈，不怕家里两个老婆揍你吗？\n");

	if( uptime()-me->query_temp("last_propose_time")<600)
            return notify_fail(WHT"你想玩结婚游戏吗?\n"NOR);
	}

        if (!living(who))
                return notify_fail("嗯...你还是先把"+who->name()+"弄醒吧。\n");

        if (who->query("gender")=="男性")
                return notify_fail("嗯？你想玩变态吗？！\n");

	if ( (string)me->query("family/family_name")=="南海普陀山" )
		return notify_fail("出家人四大皆空，婚嫁之事就免了吧。\n");

	if ( (string)who->query("family/family_name")=="南海普陀山" )
		return notify_fail("出家人四大皆空，婚嫁之事就免了吧。\n");

	if ((me->query("bonze/class")=="bonze")||(who->query("bonze/class")=="bonze"))
		return notify_fail("出家人四大皆空，婚嫁之事就免了吧。\n");

        if (who->query("married"))
                return notify_fail("还是算了吧，"+who->name()+"是有夫之妇啦！\n");
	
        message_vision(HIY"$N对着$n虔诚地说：嫁给我吧，无论富贵还是贫穷，健康还是疾病，我都会一生爱你疼你，直到死去！\n"NOR, me, who);
        message_vision(HIY"$N对着$n虔诚地说：亲爱的$n你愿意吗？\n"NOR, me, who);

        me->set("proposing",1);
        me->set("propose_target", getuid(who));
        who->set("proposed",1);
        who->set("propose_man", getuid(me));
        me->set_temp("last_propose_time",uptime());

        return 1;
}

int help(object me)
{
write(@HELP

指令格式 : propose <某人>
 
这个指令用来向人求婚，求婚者必须为男性，等女方答应后，双方到月老亭登记，
再完成一定的仪式，就算正式成婚了。求婚者必须年满十七方可。

相关指令请参阅：marry
相关程序请参阅：marriage

HELP);
    return 1;
}

