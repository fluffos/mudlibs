// Last modified by waiwai@2001/06/28 

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object danei;
  int strategy, guanzhi, exp, MAX_GUARD;

  strategy = (int)me->query_skill("force");
  guanzhi = (int)me->query("office_number");

  exp = (int)me->query("combat_exp");

  if (!me->is_fighting() && !wizardp(me))
    return notify_fail(HIC "好象没有人要杀你！\n" NOR);

  //	if( !wizardp(me) && userp(me) ) 
  //		return notify_fail(HIC"此指令目前不对玩家开放！\n"NOR);

  if (!wizardp(me) && userp(me)) {  //By waiwai@2001/06/28
    if ((int)me->query("sen") < 100)
      return notify_fail(WHT "你的精神太差了！\n" NOR);

    if (me->query("force") < 100)
      return notify_fail(WHT "你的内力不足。\n" NOR);

    if (me->query("mana") < 100)
      return notify_fail(WHT "你的法力不足。\n" NOR);

    if ((int)me->query("combat_exp") < 20)
      return notify_fail(WHT "你的武学太差。\n" NOR);

    if (environment(me)->query("no_danei")
      || environment(me)->query("zy_limit"))
      return notify_fail(HIR "这里大内高手听不到你的声音！\n" NOR);

    if (uptime() - me->query_temp("last_alert_time") < 6)
      return notify_fail(WHT "大内高手正在路上。\n" NOR);

    me->set_temp("last_alert_time", uptime());

    if (guanzhi < 600)
      return notify_fail(WHT "就凭你那卑微的职位也招的动大内高手?\n" NOR);
  }


  //        MAX_GUARD = guanzhi/800 + 1;

  if (userp(me)) {
    if (guanzhi > 600 && guanzhi < 1000) MAX_GUARD = 1;
    if (guanzhi >= 1000 && guanzhi < 2000) MAX_GUARD = 2;
    if (guanzhi >= 2000 && guanzhi < 3000) MAX_GUARD = 3;
    if (guanzhi >= 3000 && guanzhi < 4000) MAX_GUARD = 4;
    if (guanzhi >= 4000 && guanzhi < 5000) MAX_GUARD = 5;
    if (guanzhi >= 6000 && guanzhi < 7000) MAX_GUARD = 2;
    if (guanzhi >= 7000 && guanzhi < 8000) MAX_GUARD = 3;
    if (guanzhi >= 8000 && guanzhi < 9400) MAX_GUARD = 4;
    if (guanzhi >= 9400) MAX_GUARD = 5;
  } else MAX_GUARD = 6;

  // 这里不排除npc的alert是为了避免flood系统. 
  if (me->query_temp("max_guard") >= MAX_GUARD)
    return notify_fail(WHT "以你现在的官位，你已经受到足够的保护！\n" NOR);

  seteuid(getuid());

  if (!wizardp(me) && userp(me)) {  //By waiwai@2001/06/28
    me->receive_damage("sen", 100);
    me->add("force", -100);
    me->add("spells", -100);
    me->add("combat_exp", -20);
  }

  if (guanzhi < 6000) {
    danei = new("/obj/npc/danei");
    danei->move(environment(me));
    danei->invocation(me, (guanzhi + strategy));
    danei->set("possessed", me);
    me->add_temp("max_guard", 1);
    me->remove_all_killer();
    message_vision(HIW "\n$N" HIW "发出一声长啸求援！\n" NOR, me);
    message_vision(HIB "\n$N" HIW "应声而来！\n" NOR, danei);
  } else {
    danei = new("/obj/npc/danei2");
    danei->move(environment(me));
    danei->invocation(me, (guanzhi + strategy));
    danei->set("possessed", me);
    me->add_temp("max_guard", 1);
    me->remove_all_killer();
    message_vision(HIW "\n$N" HIW "发出一声长啸求援！\n" NOR, me);
    message_vision(HIB "\n$N" HIW "应声而来！\n" NOR, danei);
  }

  return 1;
}

int help(object me) {
  write(@HELP

指令格式：alert
 
这个指令让官员呼唤高手来保护自己。官职数大于600便
能招换大内高手。至于呼出高手的人数就要看你的官职的
大小了。并且每次召唤大内高手的代价将是减掉20点武学
100点内力法力以及掉100点的精神。
 
HELP
  );
  return 1;
}
