// [1;31m此文件禁止随意移动和更改[0m
// Created by waiwai@2000/08/20
// Update by waiwai@2003/02/05
// Last modified by waiwai@2003/02/27
// 对于对于巫师的动作记录任何人禁止删除和随意更改

inherit F_CLEAN_UP;
#include <command.h>

int do_drop(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj, *inv, obj2;
	int i, amount;
	string item;
	mixed no_drop;

	// Added By waiwai@2001/06/25
	if(!wizardp(me) && me->is_busy())
		return notify_fail(WHT"你正忙着呢．．．\n"NOR);

       if( userp(me) && me->query_temp("kill_created") )  
	return notify_fail(HIR"由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n"NOR);

	if(!arg) return notify_fail("你要丢弃什么东西？\n");

	if(sscanf(arg, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )
			return notify_fail("你身上没有这样东西。\n");

	if (obj->query("id")=="baoxianku qingdan") 
		return notify_fail( "这样东西不能随意丢弃。\n");

	if( !wizardp(me) && no_drop=obj->query("no_drop") )
		return notify_fail( stringp(no_drop) ? no_drop : "这样东西不能随意丢弃。\n");

	if( !obj->query_amount() )
		return notify_fail( obj->name() + "不能被分开丢弃。\n");

	if( amount < 1 )
		return notify_fail("东西的数量至少是一个。\n");

	if( amount > obj->query_amount() )
		return notify_fail("你没有那么多的" + obj->name() + "。\n");

	if( obj->query("weapon_prop") && me->is_exert() &&
		obj == me->query_temp("weapon"))
			return notify_fail("你正在使用"+me->query_exert()+"，无法丢下"+obj->name()+" \n");

	if( obj->query("weapon_prop") && me->is_perform() &&
		obj == me->query_temp("weapon"))
			return notify_fail("你正在使用"+me->query_perform()+"，无法丢下"+obj->name()+" \n");
		else if( amount == (int)obj->query_amount() )
			return do_drop(me, obj);
		else {
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			if(do_drop(me, obj2)) { // succeed to drop
			    obj->set_amount( (int)obj->query_amount()-amount );
			    return 1;
			}
			return 0;
		}
	}

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			if (inv[i]->query("no_drop")) continue;
			//Added By waiwai@2000/10/20 带记号的和装备的不能drop all
                     if( inv[i]->query("keep_this") ) continue;
                     if( inv[i]->query("equipped") ) continue;
			if(inv[i]->query("id")=="baoxianku qingdan") continue;
			do_drop(me, inv[i]);
		}
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(arg, me)))
		return notify_fail("你身上没有这样东西。\n");
	//Added By waiwai@2001/05/30
	if(!wizardp(me)) {
	if( no_drop=obj->query("no_drop") )
                return notify_fail( stringp(no_drop) ? 
			no_drop : "这样东西不能随意丢弃。\n");
	}

	//Added By waiwai@2003/02/05 加入限制带记号的和装备的不能直接drop 
	if( userp(me) && !wizardp(me) ) {
	if( obj->query("equipped") == "worn" )
		return notify_fail( WHT"你需要先卸掉"+obj->name()+NOR WHT"的装备状态才能仍掉。\n"NOR);
	if( obj->query("keep_this") && !obj->query("keepto"))
		return notify_fail( WHT"你需要先把"+obj->name()+NOR WHT"上面的记号去掉才能仍掉 。\n"NOR);
	}
	return do_drop(me, obj);
}

int do_drop(object me, object obj)
{
	mixed no_drop;
	object *inv;
	object env,env2;
	string drop_msg;

	// Added By waiwai@2001/06/25
	if(!wizardp(me) && me->is_busy())
           return notify_fail(WHT"你正忙着呢．．．\n"NOR);

	// Added By waiwai@2001/06/25
	if( no_drop = obj->query("no_drop") && !wizardp(me))
		return notify_fail( stringp(no_drop) ? no_drop : "这样东西不能随意丢弃。\n");

	if (obj->query("id")=="baoxianku qingdan") 
		return notify_fail( "这样东西不能随意丢弃。\n");

	// 加一限制，防止玩家频繁drop get金钱达到写入Log监控文件的条件而Flood log file
	if(userp(me) && obj->value() >= 500000 && me->add_temp("drop_moneyd") < 50 ) {
		me->add_temp("drop_moneyd",1);
		write(HIG"警告：频繁仍弃超过50两黄金的金钱将会遭到小鬼抢劫！！！\n"NOR);
	} else
	if(userp(me) && me->add_temp("drop_moneyd") >= 50) {
		me->delete_temp("drop_moneyd");
		write(HIG"一只绿色小鬼很快地跑出来，接住你丢下的金钱，然后消失不见了。。。\n"NOR);
		write(HIR"\n由于你频繁仍弃超过50两黄金的金钱，你的金钱被小鬼抢劫了。。。\n"NOR);
		destruct(obj); 
		return 1;
	}

	// Added By waiwai@2001/06/25
	inv = all_inventory(environment(me));  
	if(sizeof(inv)>30)
		return notify_fail(WHT"这里地上已经那么多东西了，你还是仍别处吧！\n"NOR);

	if( obj->move(environment(me)) ) {
	 if( (obj->query_temp("d_mana") ) > 0 ) {
	  if( obj->query_temp("is_living")==1 )
            message_vision("$N将$n从背上放了下来，搁在地上。\n", me, obj);
	  else {
		if( userp(me) ) { obj->set("user_drop", log_id(me)); }
		if( !obj->query("drop_to") )  
		message_vision( sprintf("$N丢下一%s$n \n"NOR,	
	      undefinedp(obj->query_temp("unit"))? "个":obj->query_temp("unit") ), me, obj );
	  }
        } else {
	  if( obj->is_character() )
            message_vision("$N将$n从背上放了下来，搁在地上。\n", me, obj);
	  else {
	// Added By waiwai@2000/08/20
	if( wizardp(me)) 	obj->set("wiz_drop", log_id(me));
	if( wizardp(me) && (string)SECURITY_D->get_status(me) != "(admin)" && 
	(string)SECURITY_D->get_status(me) != "(arch)" ) {
		write(HIG"一只绿色小鬼很快地跑出来，接住你丢下的东西，然后消失不见了！！！\n"NOR);
		destruct(obj); 
		return 1;
	    }

	env = COLOR_D->clean_color(MISC_D->find_place(environment(me)))+
	COLOR_D->clean_color(environment(me)->query("short"));

	// Added By waiwai@2000/08/20
       if( wizardp(me) && !obj->value() ) {
               log_file("wizcmds/wiz_drop", sprintf("%s在[%s (%O.c)]仍下一%s%s 时间在：[%s]\n",
                        log_id(me), env,environment(me),
		obj->query("unit"),COLOR_D->clean_color(obj->name()), log_time()));
	}

	// Added by waiwai@2003/02/27
	// 以下综合设置drop的某些特殊状况处理
	/****************************************************************************/
	// 对于有drop_msg的将优先输出物件的特定drop_msg信息
	// 消失类物件要想特殊drop_msg有效，必须设定有价值
	drop_msg = obj->query_temp("drop_msg");

	if(obj) {
	// 有des参数但没有drop_msg的
	if(!drop_msg && obj->query("des") )
	drop_msg = obj->name()+WHT" 消失在空气中不见了～～～"NOR;
	else
	// 没有des参数但有drop_msg的
	if(drop_msg && !obj->query("des") )
	drop_msg = drop_msg;
	else
	// 有des参数也有drop_msg的
	if(drop_msg && obj->query("des") )
	drop_msg = drop_msg;
	else
	// 没有des参数也没有drop_msg的
	drop_msg = "";
	} 

	// 只需在物件上设置set("drop_to",1) 那么这个物件在生物死后就会自动掉出来
	// 注意设置有drop_to参数的物件不能设置没有价值，如果禁止买卖请添加 no_sell
	// drop_to 的实现在 F_DAMAGE 里面已经设置
	if( !obj->query("des") ) { // drop_to的物件是在没有des参数情况下实现
		if( !obj->query("drop_to") ) { // 没有drop_to 的物件  
		message_vision( sprintf("$N丢下一%s$n \n"NOR, obj->query("unit")), me, obj );
		if( !obj->query("value") && !obj->value() ) {
		message( "sound", "因为这样东西并不值钱，所以人们并不会注意到它的存在。\n"NOR, environment(me) );
		destruct(obj);
		}
		} else
		if( obj->query("drop_to") ) 
		message( "sound", 
		"\n"+HIG+me->name()+HIG"身上好象掉下一"+obj->query("unit")+obj->query("name")+HIG"("+
		obj->query("id")+")。\n\n"NOR, environment(me) );
		} 
		else
	// 对于水类或者带消失参数的处理及信息反馈(水性标志物品可以不设置des参数一样会消失)
	if( (string)obj->query("material") == "water" || (int)obj->query("des"))  {
		tell_room(environment(me),drop_msg+"\n"NOR);
		destruct(obj); 
	} else { // 默认的没有附加参数的情况
		if( drop_msg )
		message( "sound", drop_msg, environment(me) );
		else 
		if( !obj->query("value") && !obj->value() ) {
		message( "sound", "因为这样东西并不值钱，所以人们并不会注意到它的存在。\n"NOR, environment(me) );
		destruct(obj);
		}
	}
	/****************************************************************************/
	}
	}
	// 去除记号,不要轻易改这个设置
	// 没有keepto参数的将被去掉记号
	if(!wizardp(me) && obj && !obj->query("keepto") ) { 
	obj->delete("keep_this");
	obj->delete("keep_id");
	}

#ifdef SAVE_USER
    me->save();
#endif 
       return 1;
       }
       return 0;
}

int help(object me)
{
	write(@HELP

指令格式 : drop <物品名称>
 
这个指令可以让你丢下你所携带的物品.
注意在仍掉某物的同时必须保证该物没有做 keep 记号
并且没有装备，比如你本身穿着衣服不先脱下来是不能
直接仍掉的吧？：P
 
相关指令：keep，keepto, unwield，remove/tuo

HELP
    );
    return 1;
}
