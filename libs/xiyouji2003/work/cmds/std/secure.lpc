// Update by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg) {
  object *ob, obj;
  int i, n;

#ifdef SAVEEQ
  int autoload;
#endif

  if (!arg) return help(me);

  ob = all_inventory(me);
  n = sizeof(ob);

  if (!me->query("vip"))
    return notify_fail(WHT "VIP专用指令，你不能使用。\n" NOR);

#ifdef SAVEEQ
  for (i = 0; i < n; i++)
    if (ob[i]->query_autoload()) autoload++;
  autoload = 0;
#endif

  if (arg == "all") {
    for (i = 0; i < n; i++) {
      ob[i]->set_temp("secured", 1);
#ifdef SAVEEQ
      if (ob[i]->query("equipped")
        && !ob[i]->query("deadfly")
        && !ob[i]->query("no_break")
        && !ob[i]->query("replace_file")) {
        if (autoload < 3 && !ob[i]->query_autoload()) {
          tell_object(me, HIW "你成功地将" + ob[i]->name() + HIW "做上保护标记。\n" NOR);
          ob[i]->set("autoload", 1);
          autoload++;
        } else {
          tell_object(me, HIR "标记" + ob[i]->name() + HIR "保护失败。\n" NOR);
          if (ob[i]->query("autoload"))
            ob[i]->delete("autoload");

          if (ob[i]->query_temp("secured"))
            ob[i]->delete_temp("secured");

          autoload--;

        }
      }
#endif
    }
  }

  else if (obj = present(arg, me)) {
#ifdef SAVEEQ
    if (autoload < 3
      && !obj->query("replace_file")
      && obj->query("equipped")
      && !obj->query("deadfly")
      && !obj->query("no_break")
      && !obj->query_temp("secured")) {
      obj->set("autoload", 1);
      tell_object(me, HIW "你成功地将" + obj->name() + HIW "做上保护标记。\n" NOR);
    } else {
      tell_object(me, HIR "标记" + obj->name() + HIR "保护失败。\n" NOR);
      if (obj->query("autoload"))
        obj->delete("autoload");

      if (obj->query_temp("secured"))
        obj->delete_temp("secured");

    }
#endif

    obj->set_temp("secured", 1);
  } else return notify_fail("没有这样物品。\n");
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : secure <物件ID>

范    例 : secure sword
           secure all

说    明 :

VIP专用指令。

可以让你标记三个保护物件，离线可以随身携带。
但是法宝类，未装备的，不破损的和死亡飞掉的
将不能标记保护。
被保护的物件看i的时候会以闪烁的形式表示。
如果标记错误可以卸除装备，然后再重新装备上
再进行标记。

HELP
  );
  return 1;
}
