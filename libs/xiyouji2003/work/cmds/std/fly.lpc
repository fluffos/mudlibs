// Update by waiwai@2002/12/05

#include <ansi.h>

int main(object me, string arg)
{
	string loc;
       int mana_cost;
	object ridee, map;
	string ridemsg;

        seteuid(getuid());
               
        if(!wizardp(me))  {
        if( me->is_fighting() )
                return notify_fail("你正在战斗，飞不开。\n");

        if( me->is_busy() || me->query_temp("pending/exercising"))
                return notify_fail("你正忙着呢，没工夫腾云驾雾。\n");

	if( !wizardp(me) && !environment(me)->query("outdoors") )
		return notify_fail("周围没有一片云，没办法腾云驾雾。\n");

	if( me->is_ghost() )
		return notify_fail("做了鬼了，就老实点吧！\n");

       if( !arg )
                return notify_fail("你要飞到哪里去？\n");

	if( me->query_temp("no_move") )
	    return notify_fail("你被定住了，哪里飞得起来！\n");

	if( RANK_D->grade_dx( RANK_D->describe_dx( (int)me->query("daoxing") ) ) 
		< RANK_D->grade_dx(BLU "初领妙道" NOR) ) {
		message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
		return notify_fail("你现在连初领妙道都谈不上，哪里飞得起来。\n");
	}

	if( RANK_D->grade_fali( RANK_D->describe_fali( (int)me->query("max_mana") ) ) 
		< RANK_D->grade_fali(HIB "腾云驾雾" NOR) ) {
		message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
		return notify_fail("看来以你的法力修为还不能腾云驾雾。\n");
	}

	if( (int)me->query("mana") < 200 ) {
		message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
		return notify_fail("你目前法力不够充盈。\n");
	}

        if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50 )
                return notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");

        if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 50 )
                return notify_fail("你想飞起来，可是体力似乎有点不支。\n");

        }
	// Added by waiwai@2002/12/05 加入频繁的飞掉精神。。。
	if( me->query_temp("last_flyto") == time() || me->query_temp("last_flyto") == time() - 1 ) {
   	  me->add_temp("flyto_count", 1);
   	  if( me->query_temp("flyto_count") <= 5 ) {  // fly 5 次以下，没有影响
   	  } else if( me->query_temp("flyto_count") <= 15 ) {
   	  	 if( me->query("sen") <= me->query_temp("flyto_count") - 5 ) // 避免 sen = 0
   	  	    return notify_fail(YEL"你精神不足，飞不动了。。。。\n"NOR);
   	  	 else me->add("sen", -me->query_temp("flyto_count"));
   	  } else return notify_fail(YEL"你飞得太快，精神跟不上来，先歇会吧。。。\n"NOR);
	} else {
   	  me->set_temp("flyto_count", 1);
   	  me->set_temp("last_flyto", time());
	}

        mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
        if(mana_cost > 0) mana_cost=0;

     if( (string)me->query("family/family_name") == "轩辕古墓") {
      message_vision(HIW"$N诡异地一笑，变做一只飞狐冲天而去…… \n\n"NOR, me);
       }

     if( (string)me->query("family/family_name") == "陷空山无底洞") {
      message_vision(HIW"只见平地里忽然刮起一阵阴风，将$N紧紧裹住，顷刻间$N随风而去，消失得无影无踪…… \n\n"NOR, me);
       }

      if( (string)me->query("family/family_name") == "将军府") {
      message_vision(HIY"$N用手轻轻一指，只见天上降下一朵五彩祥云，$N纵身跃上，乘祥云飘摇而去......\n\n"NOR, me);
       }

	if( (string)me->query("family/family_name") == "阎罗地府") {
		message_vision(CYN"$N往黑暗处一指，只见所指之处仿佛出现一扇门，$N大步走入，门也随之消失…… \n\n"NOR, me);
       }

	if( (string)me->query("family/family_name") == "方寸山三星洞") {
	message_vision(HIG"$N捻个口诀，口中念动真言，大叫一声：“筋斗云！”，只见天上降下一朵七色云彩，$N纵身跃上，飞驰而去......\n\n"NOR, me);
       }

        if( (string)me->query("family/family_name") == "月宫") {
     message_vision(HIM"$N嫣然一笑，忽地飘飘飞起，姿态婀娜,一阵微风过后，只留下淡淡的馨香。。。\n\n"NOR, me);
       }

        if( (string)me->query("family/family_name") == "五庄观") {
		message_vision(HIB"$N大袖一摆，只见风起云涌，人已借风云之势在空中大步迈去……\n\n"NOR, me);
        }

        if( (string)me->query("family/family_name") == "大雪山") {
		message_vision(HIW"$N随手一挥，只见一团雪雾裹住真身，旋转而去…… \n\n"NOR, me);
        }

        if( (string)me->query("family/family_name") == "南海普陀山") {
		message_vision(HIY"$N口中念着佛号，脚下升起祥云，缓缓离地飞去……  \n\n"NOR, me);
        }

        if( (string)me->query("family/family_name") == "天蓬府") {
     message_vision(HIC"天空中忽然一阵天雨落下来，$N哈哈大笑过后，一个惊天焦雷，$N的身影竟然消失在天雨中。。。\n\n"NOR, me);
         }

        if( (string)me->query("family/family_name") == "乱石山碧波潭") {
     message_vision(HIB"$N手一指，平地间一股妖风刮起，将$N裹了起来，再吹一声口哨，随之飘去不见了。。。\n\n"NOR, me);
         }

        if( (string)me->query("family/family_name") == "东海龙宫") {
		message_vision(HIC"$N口摇身一变，现出原形，正是一条神龙，随即穿云而去…… \n\n"NOR, me);
          }

        if( (string)me->query("family/family_name") == "火云洞") {
     message_vision(HIY"$N周身笼起一团火焰，火焰四处饶绕，一阵焦味过后，$N踩着一团"HIR"火"HIY"焰冲天而去。。。\n\n"NOR, me);
          }

         if( (string)me->query("family/family_name") == "蜀山剑派") {
             message_vision(HIC"$N口捻个口诀，扔出一把宝剑，$N飞驰而上，一招「御剑飞行」向远方飞去。。。。\n\n"NOR, me);
	    }

        if( (string)me->query("family/family_name") == "花果山盘丝洞") {
             message_vision(MAG"$N皓腕轻抖，但见一道彩虹落了下来,$N纤腰轻摆飘然而上,霞光一闪,彩虹消失的无影无踪。\n"NOR, me);
           }
 
        me->add("mana", mana_cost);

        if(arg=="stone") loc="/d/dntg/hgs/entrance";
        else if(arg=="kaifeng") loc="/d/kaifeng/tieta";
        else if(arg=="moon") loc="/d/moon/ontop2";
        else if(arg=="lingtai") loc="/d/lingtai/gate";
        else if(arg=="putuo") loc="/d/nanhai/gate";
        else if(arg=="changan") loc="/d/city/center";
        else if(arg=="sky") loc="/d/dntg/sky/nantian";
	 else if(arg=="wuzhuang") loc="/d/qujing/wuzhuang/gate";
	 else if(arg=="meishan") loc="/d/meishan/erlangwai";
//        else if(arg=="wudang") loc="/d/wudang/xuanyuegate";
        else if(arg=="gao") loc="/d/gao/gate";
//        else if(arg=="songshan") loc="/d/songshan/taishique";
//        else if(arg=="penglai") loc="/d/penglai/penglai";
        else if(arg=="huoyun") loc="/d/qujing/kusong/kusongjian";
//        else if(arg=="shushan") loc="/d/shushan/shanmen";
//        else if(arg=="xueshan") loc="/d/xueshan/binggu";
//	else if(arg=="yingchou") loc="/d/qujing/yingjian/lakeside1";
//	else if(arg=="heifeng") loc="/d/qujing/heifeng/shanmen3";
//	else if(arg=="liusha") loc="/d/qujing/liusha/kuangye2";
	else if(arg=="jiangzhou") loc="/d/jz/center";

        else if(arg=="miwudao") {//By waiwai@2001/03/29 added.
		if( !wizardp(me) && !(string)me->query("miwu/ok") ){
              message_vision(WHT"$N在天上转了半天也不知迷雾岛该往哪边飞。。。。\n"NOR, me);
                        message_vision(WHT"\n$N失望地从云上跳了下来！\n"NOR, me);
                        return 1;
                        }
             message_vision(WHT"$N驾着祥云向神秘的迷雾岛飞去。。。。\n\n"NOR, me);
		loc="/d/west/miwudao/guangchang";
	}
	else if(arg=="xueshan" ) {
	if( (string)me->query("family/family_name")!="大雪山" ) {
		if(!(map=present("xueshan map", me)) && !wizardp(me)) {
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		if( !wizardp(me)&&(string)map->query("unit")!="张" ){
                        write("你在天上转了半天也不知该往那边飞。。。\n");
                        message_vision("\n$N失望地从云上跳了下来！\n", me);
                        return 1;
                        }
		}
		loc="/d/xueshan/binggu";
	}
	else if(arg=="penglai") {
		if(!(map=present("eastsea map", me)) && !wizardp(me)) {
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		if( !wizardp(me)&&(string)map->query("unit")!="张" ){
			write("你在天上转了半天也不知该往那边飞。。。\n");
                        message_vision("\n$N失望地从云上跳了下来！\n", me);
                        return 1;
                        }
		loc="/d/penglai/penglai";
	}
	else if(arg=="baoxiang"){
		loc = "/d/qujing/baoxiang/bei1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
	}else if(arg=="pingding"){
		loc = "/d/qujing/pingding/ping1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
	}else if(arg=="yalong"){
		loc = "/d/qujing/pingding/yalong1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
	}else if(arg=="wuji"){
		loc = "/d/qujing/wuji/square.lpc";
		//loc[strlen(loc)-3] = '1'+random(9);
	}else if(arg=="chechi"){
		loc = "/d/qujing/chechi/jieshi1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
	}else if(arg=="tongtian"){
		loc = "/d/qujing/tongtian/hedong1.lpc";
		loc[strlen(loc)-3] = '1'+random(6);
	}else if(arg=="jindou"){
		loc = "/d/qujing/jindou/jindou1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
	}else if(arg=="nuerguo"){
		loc = "/d/qujing/nuerguo/towna1.lpc";
		/*
		if (me->query("obstacle/nuerguo")!="done" && !wizardp(me)){
			write("\n一阵风把你东倒西歪地吹了回来！\n");
			write("看样子飞不过去。\n");
			return 1;
			}
		*/
		loc[strlen(loc)-4] = 'a'+random(3);
		loc[strlen(loc)-3] = '1'+random(3);
	}else if(arg=="dudi"){
		loc = "/d/qujing/dudi/dudi1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
       }else if(arg=="firemount"){
         	loc = "/d/qujing/firemount/cuiyun1.lpc";
		loc[strlen(loc)-3] = '1'+random(5);
	}else if(arg=="jilei"){
		loc = "/d/qujing/jilei/jilei1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
	}else if(arg=="jisaiguo"){
		loc = "/d/qujing/jisaiguo/east1.lpc";
		loc[strlen(loc)-3] = '1'+random(4);
	}else if(arg=="jingjiling"){
		loc = "/d/qujing/jingjiling/jingji1.lpc";
	}else if(arg=="xiaoxitian"){
		loc = "/d/qujing/xiaoxitian/simen.lpc";
       }else if(arg=="zhuzi"){
         	loc = "/d/qujing/zhuzi/zhuzi1.lpc";
		loc[strlen(loc)-3] = '1'+random(5);
       }else if(arg=="qilin"){
         	loc = "/d/qujing/qilin/yutai.lpc";
       }else if(arg=="pansi"){
         	loc = "/d/qujing/pansi/ling1.lpc";
		loc[strlen(loc)-3] = '1'+random(6);
       }else if(arg=="biqiu"){
         	loc = "/d/qujing/biqiu/jie1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
       }else if(arg=="qinghua"){
         	loc = "/d/qujing/biqiu/zhuang.lpc";
	}else if(arg=="wudidong"){
		loc = "/d/qujing/wudidong/firemount-wudidong3.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
       } else if(arg=="qinfa"){
         	loc = "/d/qujing/qinfa/jiedao1.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
       }else if(arg=="yinwu"){
         	loc = "/d/qujing/yinwu/huangye1.lpc";
       }else if(arg=="fengxian"){
         	loc = "/d/qujing/fengxian/jiedao1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
       }else if(arg=="yuhua"){
         	loc = "/d/qujing/yuhua/xiaojie1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
       }else if(arg=="baotou"){
         	loc = "/d/qujing/baotou/shanlu1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
       }else if(arg=="zhujie"){
         	loc = "/d/qujing/zhujie/shanlu11.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
       }else if(arg=="jinping"){
         	loc = "/d/qujing/jinping/xiaojie1.lpc";
		loc[strlen(loc)-3] = '1'+random(7);
       }else if(arg=="qinglong"){
         	loc = "/d/qujing/qinglong/shanjian.lpc";
       }else if(arg=="tianzhu"){
         	loc = "/d/qujing/tianzhu/jiedao11.lpc";
		loc[strlen(loc)-3] = '1'+random(8);
       }else if(arg=="maoying"){
         	loc = "/d/qujing/maoying/shanpo1.lpc";
		loc[strlen(loc)-3] = '1'+random(9);
       }else if(arg=="lingshan"){
         	loc = "/d/qujing/lingshan/dalu1.lpc";
		loc[strlen(loc)-3] = '1'+random(3);
       }else{
                write("\n\n到了！你按下云头跳了下来。\n");
                write("咦？．．．怎么还在原来的地方？\n");
                return 1;
       }

	if (! loc) return 1;
		
	if(MISC_D->random_capture(me,0,1)) return 1;

	if (ridee = me->ride()) {
	  ridemsg = ridee->query("ride/msg")+"着"+ridee->name();
	  ridee->move(loc);
	} else ridemsg = "";
	                                            	
	me->move(loc);
       write("\n\n到了！你按下云头跳了下来。\n");

          if( (string)me->query("family/family_name") == "轩辕古墓") {
	message_vision(HIW"\n忽见天空中一只妖媚狐狸"+ridemsg+HIW"落下，一个飞旋变成人行竟然是$N……  \n"
	NOR, me);
	}

          if( (string)me->query("family/family_name") == "陷空山无底洞") {
	message_vision(HIW"\n忽然间刮起一阵阴风，风尽处，$N"+ridemsg+HIW"走了出来…… \n"
	NOR, me);
	}

           if( (string)me->query("family/family_name") == "将军府") {
	message_vision(HIY"\n只见空中飘落一朵五彩祥云，$N"+ridemsg+HIY"拨开云端走了出来…… \n"
	NOR, me);
	}

	if( (string)me->query("family/family_name")=="阎罗地府") {
	message_vision(CYN"\n阴影中吹起一阵冷风，伴随着冷森森的笑声，$N"+ridemsg+CYN"如魑魅般从黑暗中出现…… \n"
	NOR, me);
	}
       
        if( (string)me->query("family/family_name")=="方寸山三星洞") {
	message_vision(HIG"\n只听见天上传来一声：“俺来也！”，人随声到，$N"+
	ridemsg+HIG"从筋斗云中冉冉落下……。\n"NOR, me);
       }

        if( (string)me->query("family/family_name") == "乱石山碧波潭"){
       message_vision(HIB"\n只见一阵妖风过后,$N"+ridemsg+HIB"从云端落了下来。\n"NOR, me);
       }

      if( (string)me->query("family/family_name")=="月宫") {
	message_vision(HIM"\n只见一道月光洒在你面前，柔柔的，冷冷的，一阵馨香过后,$N"+
	ridemsg+HIM"从月光中飘然而至…… \n"NOR, me);
	}

      if( (string)me->query("family/family_name")=="五庄观") {
	message_vision(HIB"\n一阵清风吹来，$N"+ridemsg+HIB"从空中降落…… \n"NOR, me);
	}

       if( (string)me->query("family/family_name")=="大雪山") {
	message_vision(HIW"\n霎时间，大雪纷飞，$N"+ridemsg+HIW"亦如晶莹剔透的雪花随风飘下…… \n" NOR, me);
	}

       if( (string)me->query("family/family_name")=="南海普陀山") {
	message_vision(HIY"\n一声洪亮的“南无阿伲陀佛”，$N"+ridemsg+HIY"从佛光中，祥云里走出…… \n"NOR, me);
	}

       if( (string)me->query("family/family_name") == "天蓬府") {
         message_vision(HIC"\n一个惊雷过后,忽见$N"+ridemsg+HIC"从天雨里冲了出来。\n"NOR, me);
       }

       if( (string)me->query("family/family_name")=="东海龙宫") {
	message_vision(HIC"\n半空中仿佛冲出一条水柱，$N"+ridemsg+HIC"从水柱上稳稳跳落地下……  \n"NOR, me);
	}

       if( (string)me->query("family/family_name")=="火云洞") {
        message_vision(HIY"\n只见一阵狂风带着焦味吹过后,$N"+ridemsg+HIY"夹着一团"HIR"火"HIY"从空中撞了出来。\n"NOR, me);
	}

       if( (string)me->query("family/family_name")=="蜀山剑派") {
	message_vision(HIC"\n一道蓝光闪过,$N"+ridemsg+HIC"从剑上跳了下来。 \n"NOR, me);
	}

       if( (string)me->query("family/family_name") == "花果山盘丝洞") {
       message_vision(MAG"\n但见一道彩虹从天空划过，$N"+ridemsg+MAG"随彩虹飘然而至。 \n"NOR, me);
       }
                 return 1;
}

int help(object me)
{
        write(@HELP

指令格式 : fly|fei [目的地]

当你的道行和法力高强时，你可以腾云驾雾。

目前你可以飞到的地方：
changan         ->长安城                 kaifeng        ->开封城
stone           ->花果山仙石             sky            ->南天门
moon      	->昆仑山月宫             penglai        ->蓬莱仙岛
lingtai         ->灵台方寸山    	 putuo     	->南海普陀山
xueshan	        ->大雪山寒冰谷           meishan        ->梅山灌江口
wuzhuang        ->万寿山五庄观           gao            ->高老庄

baoxiang	->宝象国		 pingding  	->平顶山
yalong    	->压龙山 		 wuji           ->乌鸡国
chechi		->车迟国 		 tongtian	->通天河
jindou  	->金兜山 		 nuerguo	->女儿国
dudi   		->毒敌山 		 firemount	->火焰山
jilei    	->积雷山 		 jisaiguo	->祭赛国
jingjiling	->荆棘岭		 xiaoxitian	->小西天
