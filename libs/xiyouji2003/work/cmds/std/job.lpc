#include <ansi.h>

int main(object me, string str)
{   
     string output;    
     seteuid(getuid(me)); 

     me->add("sen",-20); 
     me->start_busy(3);

	output = HIG"※ "HIR"西游记使命任务榜 "HIG"※ \n"NOR; 
	output += WHT"───────────────────────────────\n"NOR;   
	output += TASK_D->dyn_quest_list(); 
	output += WHT"───────────────────────────────\n"NOR;   
	output += "目前西游记使命任务榜共有六十七项使命任务。\n\n"NOR; 

     me->start_more(output);   
     return 1;
}

int help(object me)
{  
      write(@HELP

指令格式: job
这个指令是用来得知目前的所有使命.
为了减轻系统负担，不能连续用job，而且每用一次要掉20的精神。

HELP); 
       return 1;
}
