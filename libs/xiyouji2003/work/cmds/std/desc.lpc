//ephq
//┌─┐│┬┴ └┘┼├┤

#include <ansi.h>

inherit F_CLEAN_UP;

mapping attr = ([
  "kar": "福缘",
  "per": "容貌",
  "int": "悟性",
  "spi": "灵性",
  "str": "臂力",
  "cor": "胆识",
  "cps": "定力",
  "con": "根骨"
]);

int main(object me, string arg) {
  mapping tattoo;
  string *totems;
  string msg;
  object ob;

  if (arg && !wizardp(me))
    return notify_fail("只有巫师才能看别人的纹身。\n");

  if (!arg) ob = me;
  else if (!objectp(ob = find_player(arg)))
    return notify_fail("没有这个人。\n");

  if (!ob->query("tattoo") && !ob->query("capapie_tattoo"))
    return notify_fail((ob == me ? "你" : ob->name()) + "目前没有任何纹身。\n");

  if (mapp(tattoo = ob->query("tattoo"))) {

    msg = CYN "┌────────┬────────┬────────┐\n"
      "│" HIR "    图    腾    " NOR CYN "│" HIR "    属    性    "
      NOR CYN "│" HIR "    部    位    " NOR CYN "│\n"
      "├────────┼────────┼────────┤\n";

    totems = keys(tattoo);

    foreach (string totem in totems) {
      int max, i, t_flag, a_flag, p_flag;
      mapping attribute;
      string *att, *place;

      attribute = tattoo[totem]["attribute"];
      place = tattoo[totem]["place"];
      att = keys(attribute);

      max = sizeof(att);
      if (sizeof(place) > max)
        max = sizeof(place);

      t_flag = max / 2;
      a_flag = (max - sizeof(att)) / 2;
      p_flag = (max - sizeof(place)) / 2;
      if (t_flag > 1) t_flag -= 1;
      if (a_flag > 1) a_flag -= 1;
      if (p_flag > 1) p_flag -= 1;
      for (i = 0; i < max; i++) {
        msg += CYN "│" WHT + sprintf(
          "%|16s",
          i == t_flag ? totem : " "
        ) + CYN "│" WHT + sprintf(
          "%|16s",
          (i < a_flag || i > sizeof(att) + a_flag - 1) ? " " : (attr[att[i - a_flag]] + "：" + attribute[att[i - a_flag]])
        ) + CYN "│" WHT + sprintf(
          "%|16s",
          (i < p_flag || i > sizeof(place) + p_flag - 1) ? " " : place[i]
        ) + CYN "│\n";
      }
      msg += "├────────┼────────┼────────┤\n";
    }
    msg = msg[0..strlen(msg) - 58];
    msg += "└────────┴────────┴────────┘\n" NOR;
    write(msg);
  }
  return 1;
}
