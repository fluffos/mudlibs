// Created by waiwai@2001/04/19
// 1.暂时没有帮会的巫师的频道只有巫师间可以看到
// 2.有帮会的巫师则遵守帮会频道规则讲话
// 3.巫师可以看到任何帮会频道的讲话

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

int main(object me, string arg)
{
	object *member;
	string bh;
	int i;

       if( me->query("chblk/forever") ) 
		return notify_fail(HIR"很遗憾，你的所有公共交谈频道被无限期永久地关闭了！ \n"NOR);

       if (time()-(int)me->query("chblk/all")<0)
		return notify_fail(HIG"你的所有公共交谈频道只能于"HIR+
		(-((time()-(int)me->query("chblk/all"))/60))+HIG"分钟后再次使用！\n"NOR);

	if( time()-(int)me->query("chblk/bh")<0 )
		return notify_fail("对不起！你的帮会频道(new)被关闭了，只能于"HIR+
		(-((time()-(int)me->query("chblk/bh"))/60))+NOR"分钟后再次使用！\n");


	bh=(string)me->query("banghui");
	if( !bh && !wizardp(me) )	return notify_fail("你没有入帮会，无法使用帮会频道。\n");
	if( !bh && wizardp(me) ) bh = HIR"帮会巡查"NOR;

	member=users();

	for(i=0;i<sizeof(member);i++)	{
		if( !objectp(member[i]))	member[i]=0;
		else if( !living(member[i]))	member[i]=0;
		else if( !wizardp(member[i]) && (string)member[i]->query("banghui")!=bh )	member[i]=0;
	}
	member-=({ 0 });

	if( !arg) arg = "。。。";

	message("banghui",
	HIW"┋"HIG+bh+HIW"┋"+me->query("name")+"("+me->query("id")+")："+arg+"\n"NOR,member);

	return 1;
}

int help(object me)
{
        write(@HELP

指令格式 : bh <内容>

本指令用于帮会成员的内部交流。

HELP
        );
        return 1;
}
