#include <ansi.h>
#include <command.h>
inherit F_DBASE;

int main(object me, string arg)
{
        int i;
        object *inv;
        object *ob,fb;
        object where = environment(me);
        seteuid(getuid());

        if( !where->query("fangbian_room") )
                return notify_fail(WHT"在这不能方便。\n"NOR);

        if ( me->is_busy() && me->query_temp("shit") )
                return notify_fail(WHT"你正在方便！\n"NOR);

        if( me->is_fighting() )
                return notify_fail("战斗中不能方便！\n");
//        if( me->query_condition("full") == 0 ) {
        if( !me->query_condition("full") ) {
         message_vision(HIY "$N没事方便什么？吃饱了饿的？\n" NOR,me);
          return 1;
          }

        inv = all_inventory(me);

        if( !sizeof(inv) ) 
         message_vision(HIY "$N根本就没有穿衣服，于是就地一蹲，开始方便起来了。\n\n" NOR,me);
        else
         message_vision(HIY "$N把衣服一捋，就地一蹲，开始方便起来了。\n" NOR,me);

         me->set_temp("shit",1); 
         me->start_busy(5); 

	if(random(3)) {
        me->clear_condition("full");
        fb=new("/d/obj/misc/faint");
        fb->move(where);
	}
        return 1;
}       

int help(object me)
{
  write(@HELP

指令格式 : fangbian
 
用来方便的指令。

HELP
    );
    return 1;
}


