// Update by waiwai@2002/12/05

#include <room.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping doors;
  string *dirs, dir, wiz_status;
  string key, *key_of_room;
  object ob, env;
  int i;

  wiz_status = SECURITY_D->get_status(me);
  if (me != this_player(1)) return 0;

  if (!arg) return notify_fail("你要锁什么？\n");
  arg = lower_case(arg);

  if (sscanf(arg, "%s with %s", arg, key) != 2)
    return notify_fail(WHT "你想用什么锁门啊。\n" NOR);
  if (!ob = present(key, me))
    return notify_fail(WHT "你身上并没有 " + key + " \n" NOR);

  //Added by waiwai@2003/01/19
  if (!wizardp(me) && userp(me))
    if (ob->query("no_use"))
      return notify_fail(HIG "你不能使用这把钥匙。\n" NOR);

  //Added by waiwai@2003/01/19
  if (ob->query("admin_use")) {
    if (wiz_status != "(admin)")
      return notify_fail(HIR "你没有被授权使用这把钥匙。\n" NOR);
  }

  env = environment(me);
  doors = env->query_doors();
  if (mapp(doors)) {
    dirs = keys(doors);
    if (member_array(arg, dirs) != -1) dir = arg;
    else for (i = 0; i < sizeof(dirs); i++)
      if (arg == doors[dirs[i]]["name"] || member_array(arg, doors[dirs[i]]["id"]) != -1) {
        dir = dirs[i];
        break;
      }
    if (!dir) return notify_fail(WHT "你要锁什么？\n" NOR);

    if ((string)env->query("need_key/" + dir) ||
      (string)env->query("need_key/door")) {
      key_of_room = ob->query("key_of_room");
      if (!sizeof(key_of_room) ||
        strsrch(implode(key_of_room, " "), file_name(env)) == -1) {
        return notify_fail(HIR "这把钥匙不能锁这个门。\n" NOR);
      }
    }

    if (env->lock_door(dir)) {
      message_vision(WHT "$N听到喀的一声, $N将" + doors[dir]["name"] + WHT "锁上。\n" NOR, me);
      return 1;
    }
  }

  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : lock [<door> 或 <方向>] with <key>
指令说明 : 
           这个指令可以让你锁上门.
其他参考 :
           unlock，open，close 

HELP
  );
  return 1;
}
