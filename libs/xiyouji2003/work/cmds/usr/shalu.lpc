// Update by waiwai@2002/12/05

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object lp;
  string banghui, msg;
  string str;
  object target, *name;
  int i, cnt;

  if (!(banghui = me->query("banghui")))
    return notify_fail("只有帮会的帮主才能使用这条命令。\n");

  if (!arg) {
    msg = HIR + me->query("banghui") + "杀戮本门仇敌黑名单(只显示在线玩家)：\n" NOR;
    msg += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    name = users();
    cnt = 0;
    for (i = 0; i < sizeof(name); i++) {
      if (wizardp(name[i])) continue;  //去除巫师显示
      if (name[i]->query("BHSL/" + banghui)) {
        msg += sprintf("%-18s%d%s",
          name[i]->query("name") + "(" + name[i]->query("id") + ")", (int)name[i]->query("BHSL/" + banghui),
          (cnt % 4 == 3 ? "\n" : ""));
        cnt++;
      }
    }
    if (cnt == 0 || (cnt % 4)) msg += "\n";
    msg += "━━━━━━━━━━━━━━━━━━━━━━━━━━━ [ 西游记 ] ━━━━\n";
    me->start_more(msg);
    return 1;
  }

  if (sscanf(arg, "-d %s", str) == 1) {
    lp = new("/obj/lingpai");
    lp->create(banghui);
    if ((string)lp->query("bangzhu_id") != me->query("id")) {
      destruct(lp);
      return notify_fail(HIR "只有帮主才能使用这条指令。\n" NOR);
    }
    destruct(lp);

    target = find_player(str);
    if (!target) return notify_fail("此处没有这么个玩家。\n");
    if (!target->query("BHSL/" + banghui))
      return notify_fail("此玩家并不在杀戮的黑名单中。\n");
    target->delete("BHSL/" + banghui);
    target->remove_all_killer();
    target->save();
    message("channel:rumor",
      HIR "【帮会赦免令】" + me->name() + "：帮会" HIW "「" + banghui + "」" HIR " 现在决定赦免" +
      target->query("name") + "(" + target->query("id") + ")的杀戮本门的行为！！！\n" NOR, users());
    return 1;
  }
  return notify_fail("指令格式：shalu [-d]<玩家ID>\n");
}

int help(object me) {
  write(@HELP

指令格式：shalu [-d] <对象ID>

本指令为帮主专用，不加参数显示目前在线杀戮过本门兄弟(包括NPC)的玩家。
-d 可以取消某个玩家与本门的敌对状态。与追杀指令不同，本指令只提供敌
人的信息名单和可以消除敌对状态之用。

名字后面数值表明杀戮过的本门帮众的人次，达到3个以上，系统会自动取消
杀戮状态而变成追杀。

HELP
  );
  return 1;
}
