// Created by waiwai@2000/11/20

#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);

int main(object me, string str) {
  object ob;
  int i, exp, MAX_GOD, MIN_GOD;

  exp = (int)me->query("combat_exp");
  MAX_GOD = (int)me->query("godlog");
  if (MAX_GOD <= 0) MAX_GOD = 0;
  MIN_GOD = 10 - MAX_GOD;
  if (MIN_GOD <= 0) MIN_GOD = 0;

  if (me->query_temp("kill_created"))
    return notify_fail(HIR "由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n" NOR);

  if (!wizardp(me)) {  //By waiwai@2001/06/28    
    if (exp <= 1999)
      return notify_fail(CYN "你的武学不足,你不能复活!!!\n" NOR);

    if (exp <= 4001)
      return notify_fail(CYN "你的武学太低, 不能使用这个命令!!!\n" NOR);

    // Added By waiwai@2001/07/08
    if (MAX_GOD > 10)
      return notify_fail(HIB "由于你复活次数过多，形神很难再次俱体了!!!\n" NOR);

    if (uptime() - me->query_temp("last_god_time") < 600)
      return notify_fail(HIB "你的魂魄尚在虚无缥缈间。\n" NOR);

    me->set_temp("last_god_time", uptime());
  }

  //Added By waiwai@2001/06/28
  if (!wizardp(me)) {
    if (!me->is_ghost())
      return notify_fail(HIC "你不是鬼魂，复活什么?！\n" NOR);
  }

  if (!str) ob = me;  //return notify_fail("<Syntax>: god <player id>\n");
  else ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail(HIW "< 此 人 不 在 这 个 时 空 >\n" NOR);
  message("system", HIW "\n\t\t\t< 忽 然 天 上 闪 过 一 道 光 芒 >\n\n\n" NOR, users());

  //Added By waiwai@2001/07/08
  CHANNEL_D->do_channel(me, "adm", WHT "使用复活指令(god)使自己成功复活一次！\n" NOR);
  if (!wizardp(me) && userp(me))
    log_file("player/god_log", sprintf("%s 用god指令复活一次 时间在: [%s] \n", log_id(me), log_time()));

  if (!wizardp(me)) {  //By waiwai@2001/06/28    
    tell_room(environment(me), HIW "< 你看到\许多小天使把" HIY +
      (string)me->query("name") + HIW "抓了起来，然后不见了 >\n" NOR, me);
  }
  tell_object(me, HIW "\t\t\t<一群 " HIY "小天使" HIW " 将你抓起，飞往空中 >\n" NOR);

  if (!wizardp(me)) {  //By waiwai@2001/06/28    
    me->add("combat_exp", -2000);
    me->move("/d/city/kezhan");
  }

  me->reincarnate();
  me->set("water", me->max_water_capacity());
  me->set("food", me->max_food_capacity());
  me->set("kee", me->query("max_kee"));
  me->set("sen", me->query("max_sen"));
  me->set("force", me->query("max_force"));
  me->set("mana", me->query("max_mana"));
  me->add("godlog", 1);  // By waiwai@2001/07/08

  tell_object(me, HIY "\t\t\t   < 你成功\的把自己复活了！！>\n" NOR);

  if (!wizardp(me)) {  //By waiwai@2001/06/28    
    tell_room(environment(me), HIG "< " + (string)me->query("name") + HIW "被几位小天使" +
      "慢慢的从空中放了下来 >\n" NOR, me);
    tell_object(me, HIW "\n\t\t\t      你还有 " HIR + chinese_number(MIN_GOD) + HIW " 次复活机会！\n" NOR);
  }
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 ： god

VIP会员专用指令。

这个命令可以让你在是鬼魂的状态时立刻复活还阳,但代价是掉
2000的武学,武学不足不能用这个命令.

两次复活之间的时间不能小于10分钟.每个人的一生只能复活10次

HELP
  );
  return 1;
}
