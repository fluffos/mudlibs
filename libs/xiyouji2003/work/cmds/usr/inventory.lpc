// Last modified by waiwai@2003/01/16

#include <ansi.h>

inherit F_CLEAN_UP;

string weight(int w) {
  int j, l, q;
  string str = "";

  if (w < 2) return str;
  w >>= 1;
  q = w & 15;
  w >>= 4;
  l = w & 15;
  j = w >> 4;
  if (j) str += j + "斤";
  if (l) str += l + "两";
  if (q) str += q + "钱";
  return str;
}

int main(object me, string arg) {
  object *inv, ob;
  int i;

  if (me->query_temp("kill_created"))
    return notify_fail(HIR "由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n" NOR);

  if (wizardp(me) && arg) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_living(arg);
    if (!ob) ob = find_player(arg);
  }

  if (!ob) ob = me;

  // Added by waiwai@2002/01/16
  if (wiz_level(me) < wiz_level(ob)) ob = me;

  inv = all_inventory(ob);
  if (!sizeof(inv)) {
    write((ob == me) ? "目前你身上没有任何东西。\n"
      : ob->name() + "身上没有携带任何东西。\n");
    return 1;
  }

  i = (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance();

  write(sprintf("%s身上带着下列[%d/" + ob->query_max_items() + "]样东西(负重%s 负重比%d%%)：
───────────────────────────\n%s\n",
    (ob == me) ? "你" : ob->name(), sizeof(inv),
    weight(ob->query_encumbrance() / 2), (i < 0) ? 0 : i,
    implode(map_array(inv, "inventory_desc", this_object()), "\n")));
  write("───────────────────────────\n");
  write("注：“Ψ”表示已装备的武器。“√”表示已装备的盔甲。\n");

  return 1;
}

string inventory_desc(object ob) {
  string desc = ob->short();
  string unit = ob->query("unit");
  string unit2 = ob->query("base_unit");

  int x;
  x = ob->query_amount();
  if (x = 0) x = 1;

  // 记号标志
  if (ob->query("keep_this")) desc += HIR " 〆" NOR;

  // Added by waiwai@2002/01/16
  // 为了工作方便具有wiz_look的set的2级以上的巫师可以在i直接看
  // 物件的具体路径。加set是为了平时不感觉乱眼，需要时打开即可
  if (this_player()->query("env/wiz_look")) {
    if (wiz_level(this_player()) > wiz_level("(arch)")) {
      if (ob->query("equipped") && !ob->query("armor_prop"))
        if (x) {
          if (ob->query("autoload"))
            desc = x + unit + BLINK HIW "  Ψ" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
          else
            desc = x + unit + HIW "  Ψ" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
        } else {
          if (ob->query("autoload"))
            desc = "1" + unit + BLINK HIW "  Ψ" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
          else
            desc = "1" + unit + HIW "  Ψ" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
        } else if (ob->query("equipped") && ob->query("armor_prop"))
          if (x) {
            if (ob->query("autoload"))
              desc = x + unit + BLINK HIR "  √" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
            else
              desc = x + unit + HIR "  √" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
          } else {
            if (ob->query("autoload"))
              desc = "1" + unit + BLINK HIR "  √" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
            else
              desc = "1" + unit + HIR "  √" NOR + desc + " " WHT + base_name(ob) + ".lpc" NOR;
          } else {
            if (x)
              desc = x + unit2 + "  " + desc + " " WHT + base_name(ob) + ".lpc" NOR;
            else
              desc = "1" + unit + "    " + desc + " " WHT + base_name(ob) + ".lpc" NOR;
          }
    }
  } else {
    if (ob->query("equipped") && !ob->query("armor_prop"))
      if (x) {
        if (ob->query("autoload"))
          desc = x + unit + BLINK HIW "  Ψ" NOR + desc;
        else
          desc = x + unit + HIW "  Ψ" NOR + desc;
      } else {
        if (ob->query("autoload"))
          desc = "1" + unit + BLINK HIW "  Ψ" NOR + desc;
        else
          desc = "1" + unit + HIW "  Ψ" NOR + desc;
      }

      else if (ob->query("equipped") && ob->query("armor_prop"))
        if (x) {
          if (ob->query("autoload"))
            desc = x + unit + BLINK HIR "  √" NOR + desc;
          else
            desc = x + unit + HIR "  √" NOR + desc;
        } else {
          if (ob->query("autoload"))
            desc = "1" + unit + BLINK HIR "  √" NOR + desc;
          else
            desc = "1" + unit + HIR "  √" NOR + desc;
        } else {
          if (x)
            desc = x + unit2 + "   " + desc;
          else
            desc = "1" + unit + "    " + desc;
        }
  }

  return desc;
}

int help(object me) {
  write(@HELP

指令格式：inventory
          inventory [人物]      （巫师专用）
 
列出目前身上所携带的所有物品的详细信息。

你身上带着下列[7/30]样东西(负重26斤4两5钱 负重比5%)
其中7是目前拥有的，30是你最大可带的物品数量
带有绿色 [1;32m〆[0m 符号的是被做了keepto记号的 
带有红色 [1;31m〆[0m 符号的是被做了keep记号的 

注 : 此指令可以 "i" 代替。

相关命令：keep，keepto

HELP
  );

  return 1;
}
