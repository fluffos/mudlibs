// CMDS /cmds/vip/unlead.c
// Created by waiwai@2000/11/01
// Last modified by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, env;
  string start_room, banghui;
  string familyM, familyO;
  object lp;
  mapping data;

  env = environment(me);
  start_room = file_name(env);

  banghui = (string)me->query("banghui");
  lp = new("/obj/lingpai");
  lp->create(banghui);
  data = lp->query("area");
  destruct(lp);
  if (!mapp(data)) data = ([]);

  if (!arg) return notify_fail("指令格式：unlead <某人ID> \n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");

  if (ob == me)
    return notify_fail("放弃带领自己？\n");

  if (!me->query("vip"))
    return notify_fail(HIR "VIP会员专用指令，你无权使用。\n" NOR);

  if (log_id(me) != ob->query("leader"))
    return notify_fail(WHT + ob->name(1) + WHT "有跟着你吗？\n" NOR);

  message_vision(
    "\n$N对着$n说道：好了，在" + MISC_D->find_place(env) + env->query("short") + "呆着别走开啊。。。。\n",
    me,
    ob
  );

  familyM = me->query("family/family_name");
  familyO = ob->query("family/family_name");

  if (userp(ob) && !wizardp(me)) {
    write(YEL "\n你必须等对方同意才能放弃领着对方走。\n" NOR);

    tell_object(ob, YEL + log_id(me) + "请你放弃跟随,请键入 follow none 命令。\n" NOR);
  } else if (userp(ob) && wizardp(me)) {
    message_vision("\n$N对着$n说道：好了，就这吧。。。\n", me, ob);
    me->delete_temp("leader_to");
    ob->delete("leader");
    ob->delete("leaderid");
    ob->set_leader(0);
    return 1;
  }

  if (!userp(ob) && !wizardp(me)) {  // 非玩家unlead.

    if (!ob->query("lead_to") && !ob->query("waiwai_lead")) {  // 没有标志.
      if (ob->query("race") == "人类") {
        message_vision("\n$N对着$n摇了摇头说道：你还是自己玩去吧。。。\n", ob, me);
        return 1;
      } else
        message_vision("\n$N疑惑地看着$n，似乎没有理会你的意思。。。\n", ob, me);
      return 1;
    }

    if (ob->query("leader") != log_id(me)) {
      if (ob->query("race") == "人类") {
        message_vision("\n$N对着$n疑惑地说道：我有跟随你吗？\n", ob, me);
        return 1;
      } else {
        message_vision("\n$N疑惑地看着$n，似乎根本听不懂你的意思。。。\n", ob, me);
        return 1;
      }
    }

    if (ob->query("waiwai_lead") && !ob->query("lead_to")) {
      if (ob->query("owner") != (string)me->query("id")
        && ob->query("id") != (string)me->query("mieyao/id")
        && ob->query("name") != (string)me->query("mieyao/name")
        && ob->query("waiwai_lead")) {
        if (ob->query("race") == "人类") {
          message_vision("\n$N对着$n摇了摇头说道：你还是自己玩去吧。。。\n", ob, me);
          return 1;
        } else
          message_vision("\n$N疑惑地看着$n，似乎没听懂你的意思。。。\n", ob, me);
        return 1;
      } else {
        if (ob->query("race") == "人类") {
          message_vision(HIW "\n$N对着$n喝道：臭贼，拿命来吧。。。\n" NOR, ob, me);
          ob->set("leader", log_id(me));
          ob->set("leaderid", me->query("id"));
          ob->set_leader(me);
          ob->kill_ob(me);
          me->kill_ob(ob);
          return 1;
        } else {
          message_vision(HIW "\n$N对着$n发起攻击。。。\n" NOR, ob, me);
          ob->set("leader", log_id(me));
          ob->set("leaderid", me->query("id"));
          ob->set_leader(me);
          ob->kill_ob(me);
          me->kill_ob(ob);
          return 1;
        }
      }
    }
  } else if (!userp(ob) && wizardp(me) && !ob->query("lead_to")) {
    if (ob->query("race") == "人类") {
      message_vision("\n$N对着$n点了点头说道：好吧，我听你的。。。\n", ob, me);
      me->delete_temp("leader_to");
      ob->delete("leader");
      ob->delete("leaderid");
      ob->set_leader(0);
      return 1;
    } else {
      message_vision("\n$n让$N留在了" + MISC_D->find_place(env) + env->query("short") + "。\n", ob, me);
      me->delete_temp("leader_to");
      ob->delete("leader");
      ob->delete("leaderid");
      ob->set_leader(0);
      return 1;
    }
  }

  if ((int)ob->query("lead_to") == 1 && !ob->query("waiwai_lead")) {  // 标志值为1
    if (ob->query("race") == "人类") {
      message_vision("\n$N对着$n点了点头说道：好吧，我听你的。。。\n", ob, me);
      me->delete_temp("leader_to");
      ob->delete("leader");
      ob->delete("leaderid");
      ob->set_leader(0);
      return 1;
    } else {
      message_vision("\n$n让$N留在了" + MISC_D->find_place(env) + env->query("short") + "。\n", ob, me);
      me->delete_temp("leader_to");
      ob->delete("leader");
      ob->delete("leaderid");
      ob->set_leader(0);
      return 1;
    }
  }

  if ((int)ob->query("lead_to") == 2 && !ob->query("waiwai_lead")) {  // 标志值为2，要求同门派
    if (familyO != familyM && !wizardp(me)) {
      message_vision("\n$N对着$n摇了摇头说道：你我陌路之人，你还是自己玩去吧。。。\n", ob, me);
      return 1;
    } else {
      if (ob->query("race") == "人类") {
        message_vision("\n$N对着$n点了点头说道：好吧，我听你的。。。\n", ob, me);
        me->delete_temp("leader_to");
        ob->delete("leader");
        ob->delete("leaderid");
        ob->set_leader(0);
        return 1;
      } else {
        message_vision(
          "\n$n让$N留在了" + MISC_D->find_place(env) + env->query("short") + "。\n",
          ob,
          me
        );
        me->delete_temp("leader_to");
        ob->delete("leader");
        ob->delete("leaderid");
        ob->set_leader(0);
        return 1;
      }
    }
  }


  if ((int)ob->query("lead_to") == 3 && !ob->query("waiwai_lead")) {
    if (data[env->query("area")]) {
      if (ob->query("race") == "人类") {
        message_vision("\n$N对着$n点了点头说道：好吧，我听你的。。。\n", ob, me);
        ob->set_leader(0);
        ob->delete("leader");
        ob->delete("leaderid");
        ob->delete_temp("leader");
        if (ob->query("lead_S")) {
          ob->set("startroom", start_room);
          ob->save();
        }
        if (me->query_temp("leader_to"))
          me->delete_temp("leader_to");
        return 1;
      } else
        message_vision(
          "\n$n让$N留在了" + MISC_D->find_place(env) + env->query("short") + "。\n",
          ob,
          me
        );
      ob->set_leader(0);
      ob->delete("leader");
      ob->delete("leaderid");
      ob->delete_temp("leader");
      if (ob->query("lead_S")) {
        ob->set("startroom", start_room);
        ob->save();
      }
      if (me->query_temp("leader_to"))
        me->delete_temp("leader_to");
      return 1;
    } else {
      message_vision("\n$N很疑惑地看着$n摇了摇头说道：这里是你的帮会地盘吗？\n", ob, me);
      return 1;
    }
  }


  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : unlead [<生物ID>]
 
这个指令让你要求某人或生物放弃跟你走。
对于玩家必须对方同意，并进行follow none操作才行。
对于Npc目前不能放弃随你走。

相关指令：lead

HELP
  );
  return 1;
}
