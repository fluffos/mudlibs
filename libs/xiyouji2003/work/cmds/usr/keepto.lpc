// CMDS /cmds/usr/keepto.c
// Created by waiwai@2002/12/20

#include <ansi.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob, item;

  me = this_player();

  if (!arg) return notify_fail("指令格式：keepto <身上物品> to <某人ID>\n");

  if (sscanf(arg, "%s to %s", item, arg) != 2)
    return notify_fail("指令格式：keepto <身上物品> to <某人ID>\n");

  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) ob = LOGIN_D->find_body(arg);
  if (!ob || !me->visible(ob)) return notify_fail(WHT "你只能对在线玩家使用这个指令。\n" NOR);

  item = present(item, me);
  if (!item) return notify_fail(WHT "你身上没有这样东西。\n" NOR);

  if (!wizardp(me)) {
    if (item->query("keepto") == log_id(me))
      return notify_fail(HIG "你不能把keepto记号做成自己的名字。\n" NOR);

    if (item->query("deadfly") || item->query("wiz_only"))
      return notify_fail(HIG "这样物品不能做keepto记号！\n" NOR);

    if (item->query("money_id"))
      return notify_fail(HIG "钱也要做keepto记号？疯子？财迷？\n" NOR);

    if (item->query("base_unit"))
      return notify_fail(HIG "这样物品不能做记号！\n" NOR);

  }
  if (item->query("keepto")) {
    write(item->name() + "上面已经做了给 " HIR + item->query("keepto") + NOR " 的记号。 \n" NOR);
    return 1;
  } else
    item->set("keepto", log_id(ob));
  item->set("keep_this", 1);
  item->set("keep_id", log_id(me));
  write("你在 " + item->name() + " 上面做了给 " HIR + log_id(ob) + NOR " 的记号。 \n" NOR);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：keepto <身上物品> to <某人ID>

例如：
keepto sword to test 则look时会显示这样的信息
[1;31m〆 被没头脑(waiwai)做了记号给测试(test)的。[0m

如果要去掉设定请用keep指令便可。

被记号上名字的物品只能是自己或者被记号的人可以捡(get)起来
其他人是不能捡起来的，当然巫师除外。但是注意如果你在一个
地方drop了一个带记号的物品，在系统更新时还是被系统清除掉
的。并且被记号的物品要去除记号也只有自己和被记号人可以操作
对于数量性物品和特殊物品以及金钱不能做keep记号。

相关指令：keep，i

HELP
  );
  return 1;
}
