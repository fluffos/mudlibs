#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob;
        string id,msg;
        int flag;

        if( me->is_busy() )
                return notify_fail("你上一个动作还没完成。\n");

        if( !arg || sscanf(arg,"%s %d",id,flag)!=2 )
                return notify_fail("Usage:请help respond。\n");

        if( id == me->query("id") )
                return notify_fail("干嘛拿自己开心啊。\n");

        if (! ob=find_player(id) )
                return notify_fail("没有这个玩家！\n");

        if(!ob->query_temp("apply_love") || 
            ob->query_temp("apply_love") != me->query("id") ) 
                return notify_fail("别自作多情了，人家并没有向你求爱！\n");

        ob->delete_temp("apply_love");
        
        switch(flag)
        {
                case 1:
                msg="好吧，那就先试试吧，成不成开你以后表现拉。";
                break;
                case 2:
                msg="对不起，我已经有了心上人，你来晚了。";
                break;
                case 3:
                msg="我看不上你拉，哪一点我都不满意，别自作多情了。";
                break;
                case 4:
                msg="那样不好吧，我们可以做好朋友啊，不一定非要是恋人啊。";
                break;
                case 5:
                msg="我现在不想谈恋爱，人家年龄太小了。";
                break;
                case 6:
                msg="我对你不放电了，没有感觉，我们无缘。";
                break;
        }
        if( flag == 1)
        {
        ob->set("lover/id",me->query("id"));
        ob->set("lover/fam",me->query("family/family_name"));
        ob->set("lover/num",100);
        ob->set("lover/name",me->name());
        me->set("lover/name",ob->name());
        me->set("lover/id",id);
        me->set("lover/fam",ob->query("family/familyname"));
        me->set("lover/num",100);
        }

        me->command_function("tell "+id+" "+msg);
        return 1;
}
int help (object me)
{
        write(@HELP
指令格式:

当有人向你求爱的时候，你可以使用本指令来回映对方。
如：repsond pkyou 1/2/3/4/5/6
                
               1 好吧，那就先试试吧，成不成开你以后表现拉。
               2 对不起，我已经有了心上人，你来晚了。
               3 我看不上你拉，哪一点我都不满意，别自作多情了。
               4 那样不好吧，我们可以做好朋友啊，不一定非要是恋人啊。
               5 我现在不想谈恋爱，人家年龄太小了。
               6 我对你不放电了，没有感觉，我们无缘。

   1  为答应建立恋爱关系，其它的均为拒绝。
HELP
);
        return 1;
}
