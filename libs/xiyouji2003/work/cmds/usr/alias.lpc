// Update by waiwai@2002/12/05
// 设定巫师可以查看用户的ALIAS设定情况
// alias -a <ID>
// 设定巫师可以删除用户的某个ALIAS设定
// alias -d <ID> <ALIAS>

#include <ansi.h>;

inherit F_CLEAN_UP;
#include <limit.h>;

int main(object me, string arg)
{
	int i, j;
	mapping alias;
	object who;
	string verb, replace, name, *vrbs;
	string str;

	if(wizardp(me) && arg && sscanf(arg,"-a %s",arg)==1) {
                who = find_player(arg);
                if (!who) who = LOGIN_D->find_body(arg);
                if (!who) return notify_fail("没有 "HIR+arg+NOR" 这个注册用户，或用户不在线。。。\n");
	alias = who->query_all_alias();
	if( !mapp(alias) || sizeof(alias)>0 ) {
		write(CYN+log_id(who) + 
			sprintf("目前定义的alias共有"+sizeof(alias)+"项："NOR"\n%O\n"NOR, alias));
		return 1;
		} else 
		write(log_id(who) + "目前没有定义任何的 alias \n");
		return 1;
	}
	else {
	if(wizardp(me) && arg && sscanf(arg,"-d %s %s",str, arg)==2)	{

	if(!wizardp(me) || wiz_level(me) < wiz_level(who)) return 0;

                who = find_player(str);
                if (!who) who = LOGIN_D->find_body(str);
                if (!who) return notify_fail("没有 "HIR+str+NOR" 这个注册用户，或用户不在线。。。\n");

	if( who == me ) return notify_fail("脑子秀豆？\n");
	alias = who->query_all_alias();

	if( !mapp(alias) || sizeof(alias)>0 ) {
		write("成功删除"+log_id(who)+"目前ALIAS设定中的 "HIR+ arg + " = "+alias[arg]+NOR" 设定。\n");
		who->set_alias(arg, 0);
		return 1;
		} else 
		write(log_id(who) + "目前没有设定这个ALIAS，请用 alias -a <ID> 查看其ALIAS设定状态！\n");
		return 1;
	}
	}

	alias = me->query_all_alias();
	if( !arg ) {
		if( !sizeof(alias) ) {
			write(CYN"你目前并没有设定任何 alias。\n"NOR);
			return 1;
		} else  {
			write("你目前设定的所有命令替代如下：\n");
			printf("──────────────────────────────\n");
			vrbs = keys(alias);
			for(i=0; i<sizeof(vrbs); i++)
				printf("%-15s = %s\n", vrbs[i], alias[vrbs[i]]);
			printf("──────────────────────────────\n");
			return 1;
		}
	}

	if (strlen(arg) > 40) //arg = arg[0..39];
		return notify_fail("你设定的alias长度超出系统限制了。\n");

	if( sscanf(arg, "%s %s", verb, replace)==2 ) {
	for(j=0;j<sizeof(bad_word);j++)
		if(strsrch(replace,bad_word[j])!=-1) {
		write("\n很抱歉，类似含有 "HIR BLINK+bad_word[j]+NOR" 这样的字符被系统禁止设定！\n\n"NOR);
		return 1;
	}

	} 

	if( sscanf(arg, "%s %s", verb, replace)!=2 )
	  if (stringp(alias[arg]))
		printf("你设定命令替换为：\n "HIR"%s = %s\n"NOR, arg, alias[arg]);
	  else if (alias[arg])
		printf("你设定命令替换有问题，请删除或重新设定。\n");
	  else
		printf("你没有设定 "HIR+arg+NOR" 这个命令替换。\n");
	else if(!wizardp(me) && ( verb=="alias" || verb == "go" || verb == "do" || verb == "u" 
		|| verb=="n" || verb == "s" || verb == "w" || verb=="e" || verb == "d" || verb == "chat*" 
		|| verb=="new" || verb == "chat" || verb == "rumor" || verb=="party" || verb == "bh" 
		|| verb=="sale" || verb == "music" || verb == "sldh" || verb=="xyj" || verb == "all" 
		|| verb=="o" || verb == "r" || verb == "forever" || verb == "waiwai" )) // 必须做禁止的 Alias
		return notify_fail("你不能将 "HIR+verb+NOR" 指令设定为其他用途。\n");
	else if (verb == "-d") {
		if(!alias[replace]) {
			write("你目前并没有 "HIR+replace+NOR" 这个ALIAS设定。\n");
		return 1;
		} else {
		printf("你成功删除了原有的命令替换："HIY"%s = %s\n"NOR, replace, alias[replace]);
		me->set_alias(replace, 0);
		}
	} else
	if( member_array(replace, bad_word)!=-1 ) 
		return notify_fail("对不起，这样的字符被系统禁止设定。\n");
	else if( verb=="" )
		return notify_fail(CYN"你要设什么 alias？\n"NOR);
	else {
		if (stringp(me->find_commands(verb))) return
		  notify_fail (WHT"你会取代掉现有的命令, 请换个命令再来。\n"NOR);
		if (strsrch(replace, "$*") == -1) replace += " $*";
		printf("你设定命令替换为：\n "HIG"%s = %s\n"NOR, verb, replace);
		return me->set_alias(verb, replace);
	}

	return 1;
}

int help (object me)
{
	write(@HELP

指令格式 : alias [-d] <欲设定之指令> <系统提供之指令>
	   alias [-a | -d] <ID> <巫师专用>

指令说明 :
        有时系统所提供之指令需要输入很长的字串, 在使用时
        (尤其是经常用到的) 或许会感觉不方便, 此时你可以
        用此一指令设定并替代原有之指令。 
范例:
	'alias ft fight' 会以 ft 取代 fight 指令。
	'alias' 后不加参数则列出你所有的替代指令。
	'alias ft' 会显示 ft 这个替代指令的结果。
	'alias -d sc' 会删除你原先对 sc 的设定
 
其中可以用 $1, $2, $3 .... 
来取代第一、第二、第三个参数，或是 $* 取代
所有的参数，如：
	'alias pb put $1 in $2'

则每当你输入：
	pb bandage bag

就会默认为：
	put bandage in bag
	
HELP
);
        return 1;
}
