// CMDS /cmds/vip/digmoney.c
// Update by waiwai@2002/10/08

#include <command.h>
inherit F_CLEAN_UP;
inherit F_DBASE;

int main(object me,string arg)
{
	object room,ob;
	mapping baobiao_path;
	int value,number;

	if(me->is_busy()) return notify_fail("你正忙着呢！\n");
	room=environment(me);
        message_vision(YEL"\n正所谓人为财死，鸟为食亡，$N开始疯狂的挖掘是否有人埋了钱财在路上！\n"NOR,me);
        me->receive_damage("kee",random(10)+5);

	if( !(baobiao_path=room->query("dig_money")) ) return 1;
	if( !mapp(baobiao_path) || random(6) ) return 1;

	if(!(value=baobiao_path["value"])) return 1;
	if(!(number=baobiao_path["number"])) return 1;
	room->delete("dig_money");	

	ob=new("/obj/money/gold");
	if(!ob) return 1;
	message_vision(WHT"\n突然，火星四射，被$N挖到了一罐财宝！仔细一看，竟然是"HIR+value+NOR WHT"两黄金！\n"NOR,me);

//       CHANNEL_D->do_channel( me, "sys", sprintf("在"HIR"%s(%O.c)"NOR WHT"挖到%d两黄金。 " NOR, 
//		room->query("short"),room, value  )  );

       message("channel:sys", 
	WHT"┋系统┋"+ log_id(me) +"在"+
	MISC_D->find_place(room)+COLOR_D->clean_color(room->query("short"))+"挖到"+value+"两黄金。\n" NOR, users());

       message("channel:rumor", WHT"┋"HIR"小道消息"NOR WHT"┋听说：某人在"+
	MISC_D->find_place(room)+COLOR_D->clean_color(room->query("short"))+"挖到"+value+"两黄金。\n" NOR, 
	users());

       log_file( "MONEY", sprintf("[%s] : %s在%s%s(%O.c)挖到%d两黄金。\n" NOR, 
		log_time(), log_id(me), MISC_D->find_place(room),
		room->query("short"), room, value) );

	ob->set_amount(value);
	"/adm/daemons/moneyd"->del_log(""+number);
	ob->set_temp("dig_money",log_id(me));
	ob->move(room);
	return 1;
}

int help(object me)
{
   write( @HELP

指令格式: digmoney

这个指令对于寻找钱财相当有用。

相关指令：wheremoney

HELP
   );
   return 1;
}
