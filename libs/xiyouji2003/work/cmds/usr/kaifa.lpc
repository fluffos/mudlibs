// Update by waiwai@2002/12/05

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *dir, *area, area_name;
  string msg;
  object dipan;
  string banghui;
  string *npc_bh = ({ "雪山帮",
    "三星洞",
    "火云堂",
    "阎王殿",
    "万寿山",
    "大唐会",
    "无底洞",
    "阎王会",
    "广寒宫",
    "普陀山",
    "野羊寨",
    "龙宫" });
  int kaifa, money, i;
  if (!stringp(banghui = me->query("banghui")))
    return notify_fail("你没有加入任何帮派，无法开发帮派所属领域。\n");
  if (member_array(banghui, npc_bh) != -1)
    return notify_fail("NPC帮派的玩家无权开发领域。\n");
  dir = get_dir("/data/area/", 0);
  if (!dir) dir = ({});
  area = ({});
  dipan = new("/obj/area");
  for (i = 0; i < sizeof(dir); i++) {
    sscanf(dir[i], "%s.o", area_name);
    dipan->create(area_name);
    if (!dipan->query("ziyuan")) continue;
    if (dipan->query("banghui") != banghui) continue;
    area += ({ area_name });
  }
  if (!arg || member_array(arg, area) == -1) {
    msg = GRN "\n" + dipan->query("banghui") + "帮会所辖可以开发的地盘：\n" NOR;
    msg += "─────────────────────────────────\n";
    msg += sprintf("%-16s%-10s%-10s%-10s  %-10s\n",
      "地盘名称", "所属帮会", "资源", "开发度", "基值");
    msg += "─────────────────────────────────\n";
    for (i = 0; i < sizeof(area); i++) {
      dipan->create(area[i]);
      msg += sprintf("%-16s%-10s%-10s%-10d %-10s\n",
        area[i], dipan->query("banghui"), dipan->query("ziyuan"), dipan->query("kaifa"),
        MONEY_D->money_num(dipan->query("jizhi") * 10));
    }
    destruct(dipan);
    msg += "─────────────────────── [西游记] ─────\n";
    me->start_more(msg);
    return 1;
  }
  dipan->create(arg);
  kaifa = dipan->query("kaifa");
  //	money=kaifa*100000;
  money = kaifa * 50000;
  if ((int)me->query("balance") < money) {
    destruct(dipan);
    return notify_fail("你的钱庄储蓄不够，开发" + arg + "至少要" +
      MONEY_D->money_num(money) + "！\n");
  }
  money = -money;
  me->add("balance", money);
  me->save();
  if (kaifa < 100) dipan->set("kaifa", kaifa + 1);
  else {
    destruct(dipan);
    return notify_fail(arg + "的开发度已达到最大，不需再开发。\n");
  }
  dipan->save();
  destruct(dipan);
  write("你花费了" + MONEY_D->money_num(-money) + "开发" + arg + "，");
  write("开发度上升了一点！\n");
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：kaifa [地盘名称]

用于开发组织所属领域，增加帮会收入。

HELP
  );
  return 1;
}
