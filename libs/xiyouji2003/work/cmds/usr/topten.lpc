#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string str, *astr;
  int i;
  seteuid(geteuid(me));
  write(TOPTEN_D->topten_query(arg));
  return 1;
  if (!arg || arg == "")
    return notify_fail("指令格式 : topten <类型>\n");
  if (arg == "bang") {
    "/adm/daemons/bang"->sort_bang();
    return 1;
  }
  str = "/adm/daemons/toptend.lpc"->topten_query(arg);
  write(str + "\n");
  return 1;
}

int help(object me) {
  write(HIW "指令格式 : topten <类型>\n" NOR + TOPTEN_D->query_type());
  return 1;
}
