#include <command.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string season, weather;
       season=XYJTIME_D->check_weather_season();
       weather=NATURE_D->check_weather();

	write("西游记国家时辰: " + NATURE_D->game_time() +" "+season+weather+ " \n"NOR);

	return 1;
}

int help(object me)
{
     write(@HELP

指令格式: time

这个指令让你知道西游记现在游戏中的国家时辰。

相关信息：uptime，bjtime

HELP
    );
    return 1;
}
