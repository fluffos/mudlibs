// CMDS /cmds/usr/set.c
// Update by waiwai@2001/07/10
// Last modified by waiwai@2002/12/05
 
#define MAX_ENV_VARS		20

#include <ansi.h>

inherit F_CLEAN_UP;

int help();
 
int main(object me, string arg)
{
    int i;
    string term, *terms, *wiz_only, *allowed;
    mixed data;
    mapping env;
    object where;
    string id, prompt, bh;

    where = environment(me);

    wiz_only = ({ "immortal", "msg_min", "msg_mout", "msg_home", "promptW",
               "msg_clone", "msg_dest", "msg_post", "wiz_eat", "wiz_edit", 
               "wiz_leave", "wiz_idle", "wiz_test"});

    allowed = ({ "block_tell", "brief", "brief_message", "quit_pass","msg_on", 
		"no_accept", "no_teach", "no_fight", "wimpy", "public", "pub_icq", "reply_msg",
		"fengbo-cha", "destination", "pub_webpage", "reply_msg", "makestart", "limit_toget",
              "auto_reply", "msg_post", "p_phone", "p_add", "block_board", "no_zs" });
 
	if( me != this_player(1) ) return 0;
	env = me->query("env");
 
	if( !arg || arg=="" ) {
		write("你目前设定的环境变数有：\n");
		if( !mapp(env) || !sizeof(env) )
			write("\t没有设定任何环境变数。\n");
		else {
			terms = keys(env);
			for(i=0; i<sizeof(terms); i++)
				printf("%-20s  %O\n", terms[i], env[terms[i]]);
		}
		return 1;
	}
 
	if( sscanf(arg, "%s %s", term, data)!=2 ) {
		term = arg;
		data = "YES";
	}

	if( term && term!="" ) {
		if( mapp(env) && undefinedp(env[term]) && sizeof(env) >= MAX_ENV_VARS )
			return notify_fail("你设的环境变数太多了，请先用 unset 删掉几个吧。\n");

	if(!wizardp(me)
	&& (member_array(term, allowed) == -1))
		return notify_fail("你只能设定 help settings 中定义过的环境变数。\n");

	// Added by waiwai@2002/12/02
	if( !userp(me) || (wizardp(me) && term=="invisibility") ) 
		return notify_fail(HIR"巫师隐身请参照 help yss\n"NOR);
	
	/*******************************************************************************/
	// Added by waiwai@2002/12/05
	// 以下为魂魄精灵留存 Set 限制
	// 相关文件：
	// hunpo.c logind.c quit.c damage.c 
	// combatd.c makestart.c score.c
	bh=(string)me->query("banghui");

	if( term=="makestart" && !wizardp(me) ) {

	if( !where->query("hunpo_ok") ) 
		return notify_fail(HIR"未在适宜地点，不能进行这个设置。\n"NOR);
/*
	if( (int)me->query("max_force") < 3000 )
		return notify_fail(HIR"你的内力过低，不能进行这个设置。\n"NOR);

	if( (int)me->query("max_mana") < 3000 )
		return notify_fail(HIR"你的内力过低，不能进行这个设置。\n"NOR);

	if( (int)me->query("mpzc") < 300 )
		return notify_fail(HIR"你的门派忠诚度过低，不能进行这个设置。\n"NOR);

	if( !me->query("family/family_name") )
		return notify_fail(HIR"你还是先加入一个门派再说吧。\n"NOR);

	if( !bh ) return notify_fail(HIR"你还是先加入一个帮会再说吧。\n"NOR);

	if( me->query_condition("killer") )
		return notify_fail(HIR"你正在被通缉中，不能进行这个设置。\n"NOR);

	if( me->is_ghost() )
		return notify_fail(HIR"做了鬼了，就老实点吧！\n"NOR);

	if( !me->query_skills() )
		return notify_fail(HIR"你一点武功不会，就老实点吧！\n"NOR);

	if( time() - me->query("nowstart")< 600 )
		return notify_fail(HIG"精灵转换需要间隔10分钟，现在刚过"HIR+
WKZTIME_D->query_time(me->query("nowstart"))+HIG"，呆会儿再说吧！\n"NOR);
*/
	if( me->query_temp("k_bian") )
		return notify_fail(HIR"你非真身，不能进行这个设置！\n"NOR);

//	if(me->query_temp("leader_to"))
//		return notify_fail("你正处于带领"+me->query_temp("leader_to")+"状态，先放弃了再说吧。\n");

	if( me->query("hunpo") )
		return notify_fail(HIR"你的魂魄精灵尚存在于游戏中，不能再次进行这个设置！\n"NOR);

	if (me->is_busy() || me->query_temp("pending/exercising")
		|| me->query_temp("doing_xiudao"))
		return notify_fail(HIR"你正忙着，不能进行这个设置！\n"NOR);
	}
	/*******************************************************************************/

       if((wiz_level(me) == 0) && (member_array(term, wiz_only) != -1))
            return notify_fail("只有巫师能用这个设定。\n");

      	if( (member_array(term, wiz_only) != -1 && data) ) {
			data = replace_string(data, "$RED$", RED);
			data = replace_string(data, "$GRN$", GRN);
			data = replace_string(data, "$YEL$", YEL);
			data = replace_string(data, "$BLU$", BLU);
			data = replace_string(data, "$MAG$", MAG);
			data = replace_string(data, "$CYN$", CYN);
			data = replace_string(data, "$WHT$", WHT);
			data = replace_string(data, "$HIR$", HIR);
			data = replace_string(data, "$HIG$", HIG);
			data = replace_string(data, "$HIY$", HIY);
			data = replace_string(data, "$HIB$", HIB);
			data = replace_string(data, "$HIM$", HIM);
			data = replace_string(data, "$HIC$", HIC);
			data = replace_string(data, "$HIW$", HIW);
			data = replace_string(data, "$NOR$", NOR);
		}
		data += NOR;
		sscanf(data, "%d", data);

	if(term == "wimpy" && (intp(data) < 0 || intp(data) > 80))  {
	   return COMMAND_DIR"usr/wimpy"->help(me);
	}


        me->set("env/" + term, data);
	  printf("设定环境变数：%s = %O\n", term, data);

	return 1;
	}
	return help();
}
 
int help()
{
	write(@TEXT

指令格式：set <变数名> [<变数值>]
 
这个指令让你设定一些环境变数，不加参数时会显示你目前设定的环境变数，
不指定变数值，则内定值为 "YES"。
 
取消变数设定请用 unset 指令。
 
至于有哪些环境变数可以设定，请见 help settings。

TEXT
	);
	return 1;
}
