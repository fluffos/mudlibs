#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
int top_list(object ob1,object ob2);
int get_score(object ob);
int main(object me, string arg)
{
        
        object *list,*ob;
        object who=this_player();
        int i,j;
        string msg;

      ob = filter_array(objects(), (: userp($1) && !wizardp($1) :));
        list = sort_array(ob, (: top_list :));
  msg =  "\n                   "GRN" ┏  "NOR""+GRN+"西游记中国站在线高手排行榜"NOR" "GRN" ┓\n"NOR;
      msg +=   ""GRN"┏━━━━━━━┯━┻━━━━━━━━━┯━━━━━┻━┯━━━━━┓\n"NOR;
        msg += ""GRN"┃   "NOR" "GRN""GRN"名次 "NOR"　"GRN"   │"NOR" "GRN""GRN"  在  线  高  手 "NOR" "GRN"   │"NOR"  "GRN""GRN" 所在门派 "NOR""GRN"  │ "NOR""GRN""GRN"目前评价"NOR" "GRN"┃\n"NOR;
        msg += ""GRN"┠───────┴───────────┴───────┴─────┨\n"NOR;
    for (i = 0 ;i < 15 ; i++) {
        if( i >= sizeof(list))     msg += ""GRN"┃"NOR"          "GRN"│　　　　        　　│　　          │    　  　┃\n"NOR;
                else {
                if( !list[i] ) continue;
if(list[i]->query("id")=="suannai") continue;
                if(list[i] == me) msg += GRN;
                  msg += sprintf(""GRN"┃    "GRN"%-9s"NOR""GRN" │"GRN"%-12s"NOR""GRN"%-10s"NOR""GRN"│"GRN""GRN"%-14s"NOR""GRN"│"GRN"%8d"NOR"  "GRN"┃\n"NOR,
//	chinese_number(i+1), list[i]->query("name"), "["+ capitalize(list[i]->query("id"))+"]", 
	chinese_number(i+1), list[i]->query("name"), "["+ geteuid(list[i])+"]", 
	list[i]->query("family")?  list[i]->query("family/family_name"):"普通百姓",
        get_score(list[i]));
                }
                       }
        msg += ""GRN"┠───────┴───────────┴───────┴─────┨\n"NOR;
        
     for( i = 0;i<sizeof(list);i++) 
         { 
            if(list[i] == me) break; 
          } 
             j = i+1;         
        
        msg += sprintf(""GRN"┃   "HIR"%-10s"NOR""GRN" │"HIR"%-12s"NOR""HIR"%-10s"NOR""GRN"│"HIR""HIR"%-14s"NOR""GRN"│"HIR"%8d"NOR"  "GRN"┃\n"NOR,chinese_number(j),who->query("name"),"["+
        who->query("id")+"]", who->query("family")?  who->query("family/family_name"):"普通百姓",
        get_score(me));
        msg += ""GRN"┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n"NOR;
     msg +=  "  "+GRN+"" + NOR GRN+ NATURE_D->game_time() + "记。"NOR GRN"\n\n"NOR;
        write(msg);
        return 1;

}

int top_list(object ob1, object ob2)
{
      int score1,score2;

        score1 = get_score(ob1);
        score2 = get_score(ob2);

      return score2 - score1;
}

int get_score(object ob)
{
        int tlvl,i,score;
        string *ski;
        mapping skills;

        reset_eval_cost();
        skills = ob->query_skills();
        if (!sizeof(skills)) return 1; 
        ski  = keys(skills);
        for(i = 0; i<sizeof(ski); i++) {
                        tlvl += skills[ski[i]];
                        }  // count total skill levels
        score = tlvl/(i+1);
        score += ob->query("max_force")/10;
        score += ob->query("max_mana")/10;
        score += ob->query("str") + ob->query("int") + ob->query("spi") + ob->query("con");
        score += (int)ob->query("combat_exp")/5000;
        score += (int)ob->query("daoxing")/5000;

        return score;
}

int help(object me)
{
write(@HELP
指令格式 : top 
 
这个指令可以让你知道在线十五大高手是哪些，别去惹他们。 
 
HELP
    );
    return 1;
}


