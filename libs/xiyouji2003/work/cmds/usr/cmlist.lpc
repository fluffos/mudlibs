#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob = this_object();
  string shwprice = "";
  mapping price;
  string *pricei;
  object obj, env;
  me = this_player();

  env = environment(me);

  if (!env->query("merchant_job"))
    return notify_fail("这里不是货物集散地。。。\n");

  if (!objectp(obj = present("check book", me)))
    return notify_fail(CYN "你身上没有支票簿，不能打听这里的货物价格。\n" NOR);

  message_vision("$N向店里老板打听" + env->query("short") + "的货物价格！\n", me);

  price = environment(me)->query("merchant_job");
  pricei = keys(price);
  for (int i = 0; i < sizeof(pricei); i++)
    shwprice += sprintf(WHT "%-6s" YEL "%10d" NOR "两帑金\n",
      pricei[i], environment(me)->query("merchant_job/" + pricei[i], 1));

  tell_object(me, "这里的货物价格如下（以100为数量单位）：\n" + shwprice);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式: cmlist
 
查看某个货物集散地的货物价格。。。
 
HELP);
  return 1;
}
