#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int gift_points;
  int used_gift_points;
  if (!arg) return notify_fail("你要分配到哪个参数上？\n");
  gift_points = me->query("gift_points");
  if (gift_points <= 0)
    return notify_fail("你现在没有参数点。\n");

  if (me->is_busy())
    return notify_fail("你上个动作还没完成。\n");
  switch (arg) {
    case "悟性":
    case "wuxing":
      if ((int)me->query("int") >= 99)
        return notify_fail("你的悟性已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("int", 1);
      me->add("gift_points", -1);
      break;
    case "根骨":
    case "gengu":
      if ((int)me->query("con") >= 40)
        return notify_fail("你的根骨已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("con", 1);
      me->add("gift_points", -1);
      break;
    case "灵性":
    case "lingxing":
      if ((int)me->query("spi") >= 40)
        return notify_fail("你的灵性已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("spi", 1);
      me->add("gift_points", -1);
      break;
    case "魅力":
    case "meili":
      if ((int)me->query("per") >= 40)
        return notify_fail("你的魅力已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("per", 1);
      me->add("gift_points", -1);
      break;
    case "胆识":
    case "danshi":
      if ((int)me->query("cor") >= 40)
        return notify_fail("你的胆识已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("cor", 1);
      me->add("gift_points", -1);
      break;
    case "体格":
    case "tige":
      if ((int)me->query("str") >= 40)
        return notify_fail("你的体格已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("str", 1);
      me->add("gift_points", -1);
      break;
    case "福缘":
    case "fuyuan":
      if ((int)me->query("kar") >= 40)
        return notify_fail("你的福缘已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("kar", 1);
      me->add("gift_points", -1);
      break;
    case "定力":
    case "dingli":
      if ((int)me->query("cps") >= 40)
        return notify_fail("你的定力已达到了上限，不可以用分配的方法再提高了。\n");
      me->add("used_gift_points", 1);
      me->add("cps", 1);
      me->add("gift_points", -1);
      break;
    default:
      return notify_fail("没有这个参数。\n");

  }
  write("Ok！成功分配完成！请用score指令查看！\n");
  me->save();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : distribute <个人参数>
这个指令可以让你将参数点分配到你指定的参数上。参数点
一但分配掉，将永远不可更改。

distribute 悟性 让你将一点参数点分配到悟性上。

如不可输入中文，可用拼音代替。
悟性 wuxing	体格 tige
灵性 lingxing	魅力 meili
胆识 danshi	福缘 fuyuan
根骨 gengu	定力 dingli

HELP
  );
  return 1;
}
