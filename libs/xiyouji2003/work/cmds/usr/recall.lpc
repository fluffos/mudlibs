// Update by waiwai@2002/12/05

#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob;
  string pet_id;
  string *id_list, *t_list;

  if (!wizardp(me)) {
    if (!me->query("vip"))
      return notify_fail(WHT "高级会员指令，普通用户无权使用。\n");

    if (me->query_temp("kill_created"))
      return notify_fail(HIR "由于你对创世大神的杀机行为，你现在正处于灰飞湮灭中。。。\n" NOR);

    if (!wizardp(me) && environment(me)->query("no_recall") &&
      environment(me)->query("day_shop") && environment(me)->query("no_bid"))
      return notify_fail(HIC "可惜在这里宠物听不到你的声音！！！\n" NOR);

    if (!environment(me)->query("outdoors"))
      return notify_fail(WHT "你还是到外面去召唤宠物吧。\n");

  }

  if (me->is_ghost())
    return notify_fail(HIB "做了鬼了，就老实点吧！\n" NOR);

  if (!wizardp(me)) {  //By waiwai@2001/05/11
    if (uptime() - me->query_temp("last_recall_time") < 300)
      return notify_fail(WHT "你召唤宠物坐骑时间间隔必须大于5分钟。\n" NOR);
  }

  if (me->is_fighting()) { return notify_fail(HIC "战斗中不能下" HIR "recall" HIC "指令 \n" NOR); }

  if (me->is_busy() || me->query_temp("doing_xiudao") || me->query_temp("pending/exercising")
    || me->query_temp("pending/meditating"))
    return notify_fail("你现在正忙着呢。\n");

  if (!me->query("pet/pet_id"))
    return notify_fail("你现在并没有养宠物。\n");

  if (environment(me)->query("short") == "擂台")
    return notify_fail("擂台上怎么能叫宠物帮忙。\n");

  pet_id = me->query("pet/pet_id");
  id_list = ({ pet_id });
  t_list = explode(pet_id, " ");
  if (sizeof(t_list) > 1) {
    id_list += t_list;
  }
  ob = find_player(pet_id);
  if (!ob) ob = find_living(pet_id);
  if (!ob) ob = LOGIN_D->find_body(pet_id);
  if (!ob) {
    ob = new("/d/city/npc/pet");
    ob->set("owner", getuid(me));
    if (!ob->restore()) {
      destruct(ob);
      return notify_fail("你的宠物出了问题，请和巫师联系!\n");
    }
    ob->set_name(ob->query("name"), id_list);
    ob->setup();
  } else if (ob->query("owner") != me->query("id"))
    return notify_fail("好象你的宠物不肯听你的话了，你还是自已去找找吧！\n");
  ob->move(environment(me));
  message_vision(WHT "$N一个唿哨，" HIG "$n" NOR WHT "兴奋地从远处向$N奔来。\n" NOR, me, ob);
  me->set_temp("last_recall_time", uptime());

  return 1;
}

int help(object me) {
  write(@HELP

指令格式： recall

这个指令让你可以召回你走失的宠物。

HELP
  );
  return 1;
}
