// Update by waiwai@2002/12/05

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
	string banghui,someone,something,skl;
	int money,level;
	object ob;
	
	if(! arg)	return notify_fail("请使用help tisheng，查看此命令。\n");
	if(sscanf(arg,"%s %s",something,someone)!=2)
		return notify_fail("请使用help tisheng，查看此命令。\n");
	if(something=="-skl")	{
		if(sscanf(someone,"%s %s",skl,someone)!=2)
			return notify_fail("请使用help tisheng，查看此命令。\n");
	}
	if(something!="-skl"&&something!="-exp"&&something!="-zc")
		return notify_fail("请使用help tisheng，查看此命令。\n");
	if(! ob=present(someone,environment(me)))
		return notify_fail("这里没有这个人。\n");
	if(! ob->is_character())
		return notify_fail("对方不是活物。\n");
	if( userp(ob))
		return notify_fail("你只能提升本帮会NPC成员的技能。\n");
	if( !living(ob))
		return notify_fail("你得先把"+ob->query("name")+"弄醒再说。\n");
	if(me->is_fighting()||me->is_busy())
		return notify_fail("你正忙着呢。\n");
	if(ob->is_fighting()||ob->is_busy())
		return notify_fail(ob->query("name")+"正忙着呢。\n");
	if(! stringp(banghui=me->query("banghui")))
		return notify_fail("你没有参加任何帮会，无法提升任何NPC的指数。\n");
	if( banghui!=(string)ob->query("banghui"))
		return notify_fail("你只能提升本帮会内的NPC成员。\n");
//	if(sizeof(children(base_name(ob)+".lpc"))>2)
//		return notify_fail(ob->query("name")+"似乎现在不接受你的提升命令。\n");
	if(! ob->query("zhengzhao"))
		return notify_fail("你无法提升"+ob->name()+"！\n");
	if(something=="-skl")		{
		level=(int)ob->query_skill(skl,1);
		if(! level)
			return notify_fail(ob->query("name")+"并不会这种技能。\n");
		if(level>=500)
			return notify_fail(ob->query("name")+"的该项技能已经达到最大数值300了。\n");
		money=level*level*200;//100
		if((int)me->query("balance")<money)	{
		return notify_fail("你的钱庄储蓄不够，"+ob->query("name")+
		"的该项技能提升一级，需要"+MONEY_D->money_str(money)+"！\n");
		}
		ob->set_skill(skl,level+1);
		me->add("balance",-money);
		me->save();
		ob->save();
		write("你花了"+MONEY_D->money_str(money)+"，把"+	ob->query("name")+"的"YEL+to_chinese(skl)+NOR"提升了一级！\n");
	}
	else if(something=="-exp")	{
		if((int)ob->query("combat_exp")>=6000000)
			return notify_fail(ob->query("name")+"的武学已经达到最大数值300万了。\n");
		money=1000000;
		if(me->query("balance")<1000000)
			return notify_fail("你的钱庄储蓄不够，"+ob->query("name")+"的武学提升5000点需要一百两黄金！\n");
		me->add("balance",-money);
		me->save();
		ob->add("combat_exp",5000);
		ob->save();
		write("你花了一百两黄金，将"WHT+ob->query("name")+NOR"的"YEL"武学"NOR"提升了五千点！\n");
	}
	else if(something=="-zc")	{
		money=2000000;
		if(me->query("balance")<2000000)
			return notify_fail("你的钱庄储蓄不够，"+ob->query("name")+
			"的忠诚度提升一点需要二百两黄金！\n");
		if((int)ob->query("zhongcheng")>=(int)ob->query("max_zhongcheng"))
			return notify_fail(ob->query("name")+"的忠诚度已经达到最大，不需要进行提升了。\n");
		me->add("balance",-money);
		me->save();
		if((int)ob->query("zhongcheng")>=(int)ob->query("max_zhongcheng"))
			ob->set("zhongcheng",(int)ob->query("max_zhongcheng"));
		else	ob->add("zhongcheng",1);
		ob->save();
		write("你花了二百两黄金，将"YEL+ob->query("name")+NOR"的忠诚度提升了一点！\n");
	}
	return 1;
}


int help(object me)
{
        write(@HELP

指令格式：tisheng [-skl] [武功名称] [npc id]
          tisheng [-zc]  [npc id]
          tisheng [-exp] [npc id]

用来提升所属帮会中NPC的技能等级 (skills)、武学(exp)
和忠诚度(zhongcheng)。当你征招了某个NPC后，为了提高
它的武学，技能以及忠诚度，需要经常花钱对其进行提升。

技能等级：将指定的技能提升一级(最大为500级)
          所需金钱与此NPC的当前武功等级有关。
武学：每次提升，武学相应长一千点(最大为600万)
          所需金钱为每5000点每次一百两黄金。
忠诚度：  每次提升，忠诚度长一点，直至达到最大忠诚
　　　　　度。所需金钱为每次二百两黄金。
相关指令：yaoqing, kaifa, mingling

HELP
        );
        return 1;
}
