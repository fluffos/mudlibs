inherit F_CLEAN_UP;

#include <command.h>
#include <obstacle.h>

int telling (object me, object who);
string check_daoxing(int gain);

string name;

int main(object me, string arg)
{
        object ob;

        if( !arg ) {
                ob = me;
                name = "你";
        } else if (wizardp (me)) {
                ob = find_player(arg);
                if(!ob) ob = find_living(arg);
        
                if(!ob) ob = LOGIN_D->find_body(arg);

                if(!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");

                name = ob->query("name");
        } else
           return 0;

        telling(me, ob);

        return 1;
}

int telling (object me, object who)
{
	mapping mapp;
	int dx;

	dx= 1000000-(who->query("daoxing")/2+who->query("combat_exp"));

	write (" "+log_id(who)+"灭妖状态综合统计。\n");
	write ("┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━→\n");

	if( !who->query("mieyao/time_start") )
	write ("┃  领取任务时间：尚未开始任务  "NOR);
	else
	write ("┃  领取任务时间："+BJTIME_CMD->chinese_time(7, ctime(who->query("mieyao/time_start")))+"  ");

	if( !who->query("mieyao/time_finish") ) 
	write ("┃    完成任务时间：尚未完成任务  \n"NOR);
	else 
	write ("    完成任务时间："+BJTIME_CMD->chinese_time(7, ctime(who->query("mieyao/time_finish")))+"\n"NOR);

	if( !who->query("mieyao/time_start") && who->query("mieyao/where") )
	who->delete("mieyao/where");

	if( !who->query("mieyao/where") )
	write ("┃  妖怪初始地点：尚未领取任务  \n"NOR);
	else
	write ("┃  妖怪初始地点："+COLOR_D->clean_color(who->query("mieyao/where"))+"\n"NOR);

	if( !who->query_temp("mieyao_A") )
	write ("┃  本次累计轮数：尚未完成轮数  \n"NOR);
	else
	write ("┃  本次累计轮数："+who->query_temp("mieyao_A")+"\n"NOR);

	if( who->query_temp("mieyao/level") ) 
	write ("┃  妖怪顺序等级："+who->query_temp("mieyao/level")+"级\n");
	 else
	write ("┃  妖怪顺序等级：尚未领取任务  \n"NOR);

	if( !who->query("yuan/killed") ) {
	write ("┃  妖怪等级状态：[地妖] \n");
	write ("┃  距离天妖尚差："+dx+"点[dx/2+exp] \n");
	}
	else
	write ("┃  妖怪等级状态：[天妖] \n");
	write ("┣━━━━━━━━━━━━━━━灭妖累计奖励统计━━━━━━━━━━━━━━→\n");
	write ("┃  累计领取任务(地/天)：["+who->query("mieyao/number1")+"/"+who->query("mieyao/number")+"] 次。");
	write ("  累计完成任务(地/天)：["+who->query("mieyao/number_fns1")+"/"+who->query("mieyao/number_fns")+"] 次。\n");
	write ("┃  累计获得任务奖励：\n"NOR);
//	write ("┃    官职："NOR+who->query("mieyao/reward/gz")+"点。 声望："NOR+who->query("mieyao/reward/sw")+"点。\n");
//	write ("┃    道行："NOR+check_daoxing(who->query("mieyao/reward/dx"))+"。\n");
	write ("┃  潜能："NOR+who->query("mieyao/reward/pot")+"点。\n");
	write ("┃  武学："NOR+who->query("mieyao/reward/exp")+"点。\n");
//	write ("┃    金钱："NOR+MONEY_D->money_num(who->query("mieyao/reward/balance"))+"。\n");
//	write ("┃    天丹："NOR+who->query("mieyao/reward/td")+"颗。 天珠："NOR+who->query("mieyao/reward/tz")+"颗。\n");
//	write ("┃    地丹："NOR+who->query("mieyao/reward/dd")+"颗。 地珠："NOR+who->query("mieyao/reward/dz")+"颗。\n");
	write ("┃  声望："NOR+who->query("mieyao/reward/sw")+"点。\n");
	write ("┃  技能："NOR+who->query("mieyao/reward/sk")+"级。\n");
	write ("┃  好东西："NOR+who->query("mieyao/reward/plll")+"颗。\n");
	write ("┃  人参果："NOR+who->query("mieyao/reward/guo")+"枚。\n");
	write ("┗━━━━━━━━━━━━━━━ [ 西游记 ] ━━━━━━━━━━━━━━━━→\n\n");
}

string check_daoxing(int gain)
{            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+(year)+"年";
             if(day) str=str+(day)+"天";
             if(hour) str=str+(hour)+"时辰";

             return str;
}

int help()
{
        write(@TEXT

指令格式：mieyao
	  mieyao [ID]   <巫师专用>

显示你的灭妖状态统计信息。。。。。 

TEXT
        );
        return 1;
}
