// CMDS /cmds/usr/keep.c
// Created by waiwai@2000/10/20

#include <ansi.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object ob, *all_ob;
	int i;
	me=this_player();

	if( !arg ) return notify_fail("指令格式：keep <身上物品>\n");

	if( arg=="all" ) {
       	 all_ob = all_inventory(me);
	        i = sizeof(all_ob);
       	 while( i-- ) {
	            if(all_ob[i]->query("keepto")) continue;
	            if(all_ob[i]->query("base_unit")) continue;
	            if(all_ob[i]->query("money_id")) continue;
	            if(all_ob[i]->query("deadfly")) continue;
	            all_ob[i]->set("keep_this", 1);
       	     all_ob[i]->set("keep_id", log_id(me));
			}
        write("你将身上东西能做小记号"HIR" 〆 "NOR" 的都做上了记号。\n"NOR);
        return 1;
	}

	if( arg=="none" ) {
        	all_ob = all_inventory(me);
	        i = sizeof(all_ob);
	        while( i-- ) {
/*
	            if(all_ob[i]->query("keepto")) continue;
	            if(all_ob[i]->query("base_unit")) continue;
	            if(all_ob[i]->query("money_id")) continue;
	            if(all_ob[i]->query("deadfly")) continue;
*/
	            all_ob[i]->delete("keep_this");
	            all_ob[i]->delete("keep_id");
	            all_ob[i]->delete("keepto");
		}
 	        write("你将身上东西能去掉小记号 "HIR"〆"NOR" 的去掉了。\n");
       	 return 1;
	}

	ob = present(arg, me);
	if( !ob ) return notify_fail("你身上没有这样东西。\n");
	if( !wizardp(me) && userp(me) ) {
	if( ob->query("base_unit") )
		return notify_fail(WHT"这样物品不能做keep记号！\n"NOR);

	if( ob->query("deadfly") )
		return notify_fail(WHT"这样物品不能做keep记号！\n"NOR);

	if( ob->query("money_id") )
		return notify_fail(WHT"钱也要做keep记号？疯子？财迷？！\n"NOR);
	}

	if( ob->query("keep_this") ) {
	if( !wizardp(me) && userp(me) ) {
		if( ob->query("keepto") != log_id(me)  && !( ob->query("keep_id") == log_id(me) )  ) {
	        write(ob->name()+"上面的记号是给"HIR+ob->query("keepto")+NOR"的，你不能去掉这个记号。\n");
		return 1;
		}
		} else {
       	 ob->delete("keep_this");
       	 ob->delete("keep_id");
       	 ob->delete("keepto");
	        write("你把 " + ob->name() + " 上面的小记号 "HIR"〆"NOR" 去掉了。\n");
		}
	} else {
	       ob->set("keep_this", 1);
		ob->set("keep_id", log_id(me));
        write("你在 " + ob->name() + " 上面做了个小记号 "HIR"〆 \n"NOR);
	}
	return 1;
}

int help(object me)
{
    write(@HELP

指令格式：keep <身上物品>|<all>|<none>

例如：
keep none     将所有物品的 keep 去掉
keep sword    单独去掉 sword 设定的 keep 记号或加上 keep

设定身上重要物品不会被不小心丢弃,做了记号的东西只有你指定
丢弃这个东西时才会被丢弃，并且其记号同时被解除。

被记号标记的物品一般是不会被偷的，另外在不解除记号之前也是
不能给人和仍掉的。还有在战斗中负重过高逃跑时也不会被随机仍
掉。所以把一个比较贵重的物品在带在身上之时做上记号还是比较
安全的。

注意带有keepto记号的物品是不能keep none所有的，只能keep具体
的物品才行，并且不是自己做keepto记号的物品或者keepto对象的ID
不是自己的话一般是不能使用的和去除记号的。有keep记号的物品不
能送人和仍掉，需要先去除记号，但有keepto的物品可以给人。
对于数量性物品和特殊物品以及金钱不能做keep记号。

相关指令：keepto

HELP
    );
    return 1;
}
