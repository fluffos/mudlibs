// Last modified by waiwai@2001/04/19

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob;
        string banghui;
        object lingpai;
        mapping player;

       if( (banghui=me->query("banghui")))
                return notify_fail("抱歉，你已经是帮会「"+me->query("banghui")+"」的人了，无法加入其他帮会。\n");

       if(me->is_fighting()||me->is_busy())
                return notify_fail("你正忙着呢。\n");

       if(! arg) return notify_fail("你要加入谁的帮会？\n");

       if( me->query("id")==arg)
                return notify_fail("你没法这么做！\n");

       if( (int)me->query("have_banghui")>3 )
                return notify_fail("你已经加入过帮会"+(int)me->query("have_banghui")+"次，不能再加入任何帮会了！\n");

       if(! objectp(ob=present(arg,environment(me))))
                return notify_fail("这儿没有这么个人。\n");

       if((object)me->query_temp("oldsix/target")!=ob)
                return notify_fail("抱歉，"+ob->query("name")+"并没有邀请你参加他的帮会。\n");

       if(! (banghui=ob->query("banghui")))
                return notify_fail("抱歉，"+ob->query("name")+"现在不属于任何帮会！\n");

	if( userp(this_player()) && !this_player()->query("vip") ) {
       if (this_player()->query("combat_exp") < 300000 )
                return notify_fail("你的武学太低了，再磨练磨练吧.\n");

       if (this_player()->query("daoxing") < 200000 )
                return notify_fail("你的道行太低了，再磨练磨练吧.\n");

       if (this_player()->query("shengwang") < 300 )
                return notify_fail("你的声望太低了，再磨练磨练吧.\n");
	}

        lingpai=new("/obj/lingpai");
        lingpai->create(banghui);
        if( ! lingpai->query("no_use")) {
        player=lingpai->query("player");
        if(! mapp(player))      player=([]);
        player[me->query("id")]=me->query("name");
        lingpai->set("player",player);
        lingpai->save();
        me->set("banghui",ob->query("banghui"));
        me->set("degree",ob->query("banghui"));
        me->set("have_banghui",(int)me->query("have_banghui")+1);
        me->delete_temp("oldsix/target");
        me->save();
        destruct(lingpai);
                message("channel:rumor", 
	WHT"┋帮会消息┋"NOR YEL+me->name(1)+"("+me->query("id")+
")决定加入了帮会「"RED+ob->query("banghui")+NOR YEL"」！\n"NOR,users());
                message("channel:rumor", 
	WHT"\n┋帮会势力┋"+ob->query("banghui")+"由于"+me->name(1)+"("+me->query("id")+
")的加入势力加强了！\n"NOR,users());

        return 1;
        }
        else    {
        destruct(lingpai);
        return notify_fail("对方帮会文件有问题，请与巫师联系。\n");
        }
}

int help(object me)
{
        write(@HELP

指令格式：jiaru <某人>

这个指令用来加入某人的帮会。
前提是某人必须邀请你和武学大于30万,道行大于200年,声望大于300点。
会员不限制。

请注意加入帮会数超过三次就不能再加入任何的帮会了，所以在帮之人
最好不要三心二意的，不然会很麻烦的。

对于纯NPC帮会(不能占领的)一般来说至多接受脱离过一次其他帮会的玩
家。某些NPC帮会则接受从未脱离过任何帮会的玩家。因此在加入任何帮
会(无论是NPC帮会还是玩家帮会)之前一定要慎重，不然是无法回头的。
因为往往要求苛刻的纯NPC帮会一般来说是有机会可以学到别人所学不到
的东西的。总体来说实质上加入玩家帮会其实并不能带来太多实质性的好
处的。

HELP
        );
        return 1;
}
