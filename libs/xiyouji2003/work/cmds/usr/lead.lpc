// CMDS /cmds/vip/lead.c
// Created by waiwai@2000/11/01
// Last modified by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, others, where;
  string familyM, familyO;
  string bhM, bhO;
  string target, name;

  if (!arg) return notify_fail("指令格式：lead <某人ID> \n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");

  name = ob->query("name") + "(" + ob->query("id") + ")";

  if (!ob->is_character())
    return notify_fail("什么？想带领...." + name + "？\n");

  if (ob->is_ghost())
    return notify_fail("什么？想领鬼？？？\n");

  if (ob->is_fighting())
    return notify_fail("对方正在战斗中，无暇分身！\n");

  if (me->is_ghost())
    return notify_fail("做了鬼了，你就老实点吧！\n");

  if (ob == me)
    return notify_fail("带领自己？\n");

  /*
	if( !wizardp(me) && userp(me) ) {
	if(me->query_temp("leader_to"))
		return notify_fail("你正处于带领"+me->query_temp("leader_to")+"状态，先放弃了再说吧。\n");
	}
*/
  if (me == ob->query_leader())
    return notify_fail(WHT + name + WHT "已经跟着你了。\n" NOR);

  // 作为玩家滥用指令预留的禁止参数
  if (me->query("no_lead"))
    return notify_fail(HIR "你已经无权执行这个指令了。\n" NOR);

  if (!me->query("vip"))
    return notify_fail(HIR "VIP会员专用指令，你无权使用。\n" NOR);

  message_vision("\n$N对着$n说道：跟着我走吧，我带你去个地方。。。\n", me, ob);
  if (userp(ob)) {
    write(YEL "\n你必须等对方同意才能领着对方走。\n" NOR);

    tell_object(ob, YEL "\n如果你愿意跟随" + log_id(me) + "一起行动,请键入 follow "
      +me->query("id") + " 命令。\n" NOR);
  }

  familyM = me->query("family/family_name");
  familyO = ob->query("family/family_name");
  bhM = (string)me->query("banghui");
  bhO = (string)ob->query("banghui");

  if (!ob->query("lead_to")) {
    if (!userp(ob) && !wizardp(me)) {
      if (ob->query("owner") != (string)me->query("id")
        && ob->query("id") != (string)me->query("mieyao/id")
        && ob->query("name") != (string)me->query("mieyao/name")
        && !ob->query("waiwai_lead")) {
        message_vision("\n$N疑惑地看着$n，似乎没有跟你走的意思。。。\n", ob, me);
        return 1;
      } else {
        message_vision(MAG "\n$N" MAG "决定开始跟随$n" MAG "一起行动。\n" NOR, ob, me);
        me->set_temp("leader_to", name);
        ob->set("leader", log_id(me));
        ob->set("leaderid", me->query("id"));
        ob->set_leader(me);
        ob->kill_ob(me);
        me->kill_ob(ob);
        return 1;
      }
    } else if (!userp(ob) && !userp(me) && wizardp(me)) {
      if (ob->query("race") == "人类") {
        message_vision(WHT "\n$N对着$n点了点头说道：好吧，权且就信你一回吧。。。\n" NOR, ob, me);
        message_vision(MAG "\n$N" MAG "决定开始跟随$n" MAG "一起行动。\n" NOR, ob, me);
        me->set_temp("leader_to", name);
        ob->set("leader", log_id(me));
        ob->set("leaderid", me->query("id"));
        ob->set_leader(me);
        return 1;
      } else {
        message_vision(MAG "\n$N" MAG "决定开始跟随$n" MAG "一起行动。\n" NOR, ob, me);
        me->set_temp("leader_to", name);
        ob->set("leader", log_id(me));
        ob->set("leaderid", me->query("id"));
        ob->set_leader(me);
        return 1;
      }
    }
  } else if (!ob->query("waiwai_lead")) {
    if (!ob->query("lead_to")) {  // 没有标志.
      if (ob->query("race") == "人类") {
        message_vision("\n$N对着$n摇了摇头说道：你还是自己玩去吧。。。\n", ob, me);
        return 1;
      } else
        message_vision("\n$N疑惑地看着$n，似乎没有跟你走的意思。。。\n", ob, me);
      return 1;
    } else

    if (ob->query("lead_to") && !ob->query("waiwai_lead")) {  // 有标志
      if (ob->query("leader")) {
        target = ob->query("leader");
        others = ob->query("leaderid");
        where = environment(me);

        if (others && where) {
          if (target != log_id(me) && !wizardp(me)) {
            if (ob->query("race") == "人类") {
              message_vision("\n$N对着$n摇了摇头说道：我现在正跟着" + target + "呢。。。\n", ob, me);
              return 1;
            } else {
              message_vision("\n$N疑惑地看着$n，似乎没有跟你走的意思。。。\n", ob, me);
              return 1;
            }
          }
        }
      }

      if ((int)ob->query("lead_to") == 1) {  // 标志值为1
        if (ob->query("race") == "人类") {
          message_vision("\n$N对着$n点了点头说道：好吧，权且就信你一回吧。。。\n", ob, me);
          message_vision(MAG "\n$N" MAG "决定开始跟随$n" MAG "一起行动。\n" NOR, ob, me);
          me->set_temp("leader_to", name);
          ob->set("leader", log_id(me));
          ob->set("leaderid", me->query("id"));
          ob->set_leader(me);
          return 1;
        } else {
          message_vision(MAG "\n$N" MAG "决定开始跟随$n" MAG "一起行动。\n" NOR, ob, me);
          me->set_temp("leader_to", name);
          ob->set("leader", log_id(me));
          ob->set("leaderid", me->query("id"));
          ob->set_leader(me);
          return 1;
        }
      }

      if ((int)ob->query("lead_to") == 2 && !wizardp(me)) {  // 标志值为2，要求同门派
        if (familyO != familyM && !wizardp(me)) {
          message_vision("\n$N对着$n摇了摇头说道：你我陌路之人，你还是自己玩去吧。。。\n", ob, me);
          return 1;
        } else {
          if (ob->query("race") == "人类") {
            message_vision("\n$N对着$n点了点头说道：好吧，权且就信你一回吧。。。\n", ob, me);
            me->set_temp("leader_to", name);
            ob->set("leader", log_id(me));
            ob->set("leaderid", me->query("id"));
            ob->set_leader(me);
            return 1;
          } else {
            me->set_temp("leader_to", name);
            ob->set("leader", log_id(me));
            ob->set("leaderid", me->query("id"));
            ob->set_leader(me);
            return 1;
          }
        }
      }

      if ((int)ob->query("lead_to") > 2) {  // 标志值为>2，要求同帮会
        if ((string)me->query("banghui") != (string)ob->query("banghui")
          || !(string)me->query("banghui") || !(string)ob->query("banghui")) {
          message_vision("\n$N对着$n摇了摇头说道：你我陌路之人，你还是自己玩去吧。。。\n", ob, me);
          return 1;
        } else {
          if (ob->query("race") == "人类") {
            message_vision(CYN "\n$N对着$n点了点头说道：好吧，权且就信你一回吧。。。\n" NOR, ob, me);
            me->set_temp("leader_to", name);
            ob->set("leader", log_id(me));
            ob->set("leaderid", me->query("id"));
            ob->set_leader(me);
            return 1;
          } else {
            me->set_temp("leader_to", name);
            ob->set("leader", log_id(me));
            ob->set("leaderid", me->query("id"));
            ob->set_leader(me);
            return 1;
          }
        }
      }
    }
  }

  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : lead [<生物ID>]
 
这个指令让你要求某人或生物跟你走。

对于玩家只有玩家同意并进行Follow指令操作才能跟随你走
对于Npc首先必须是可跟随的Npc，目前只设置了袁和李的任务所领的NPC
才能进行带领跟随。

这个指令目前主要作用为把某些在安全区而无法自己出来的妖怪引出来

注意：一般情况下，你如果对一个妖怪下了带领指令需要马上走出安全区
因为这个时候它会追杀杀你，并且你无法放弃让它跟随你。。。
-----------------------------------------------------------

对于Npc首先必须是可跟随的Npc，也就是有[1;32mτ[0m标志的才能进行
带领跟随。
对于有跟随标志的Npc目前除了没有特殊要求的可以随意带领之外，对于
有门派或者是帮会的往往需要你必须是其同门派或者帮会的才能进行跟随
操作而被带领到达某地。

这个指令主要作用为比如把某些在比较遥远的地方招募到的Npc带领到自己
的帮会区域以进行地盘防御和实现其他的作用。到达地点后可用unlead指令
进行撤消跟随，而使得Npc停留在某地点。

注意：一般情况下，可跟随的Npc如果正处在跟随状态，会在较短的时间内
自动跑掉回到上次的起始点，所以要把一个Npc带到某地点，最好计划好以
尽快的速度，或者走一段unlead一下也是很好的方法，但是目前鉴于为了避
免系统混乱，所以你所lead的Npc只能在你帮会所属的区域内进行unlead操
作。

相关指令：unlead

HELP
  );
  return 1;
}
