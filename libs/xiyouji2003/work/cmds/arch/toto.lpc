// CMDS /cmds/arch/toto.c
// Created by waiwai@2001/07/16

#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;

#define SYNTAX   "指令格式：toto <使用者ID> because <原因>\n"

int main(object me, string arg)
{
        object ob,env;
        string reason,startroom;
        startroom="/d/city/kezhan.lpc";

        if( !arg ) return notify_fail(SYNTAX);

        if( sscanf(arg, "%s because %s", arg,reason)!=2 ) return notify_fail(SYNTAX);

        ob = find_player(arg);
        if(!ob) ob = find_living(arg);
        if(!ob) ob = LOGIN_D->find_body(arg);
        if(!ob || !me->visible(ob)) return notify_fail(WHT"你只能对在线玩家使用这个指令。\n"NOR);

        if( wizhood(me) != "(admin)" && wiz_level(me) <= wiz_level(ob) )
                return notify_fail("你没有对" + ob->name(1) + "使用这个指令的权利。\n");

        env = environment(ob);
           while (env && env->is_character())
           env = environment(env);

        if( me==ob )  return notify_fail(SYNTAX);
        if (ob->query("punished")) return notify_fail(WHT"这个人已经被关在死牢了。\n"NOR);

            message("system",HIR"┋回返精灵┋"HIY+log_id(me)+"将"
                             +log_id(ob)+"从"+MISC_D->find_place(env)+env->query("short")+HIY"送到了「南城客栈」\n\n"NOR,users());    
            message_vision(HIY"\n忽见狂风四起，天空一道神光倏然而下！$N的身影瞬间消逝在"+
                             env->query("short")+" \n"NOR,ob);
            tell_room(startroom, HIY"空中一道神光倏然而下..."+log_id(ob)+"从里面走了出来！\n" NOR,({ob}));
            tell_object(ob,HIR"\n光芒渐渐消逝,你发现自己已经回到了客栈！\n\n"NOR);

            ob->move("/d/city/kezhan");
            ob->set("startroom",startroom);
            ob->clear_condition();
            ob->start_busy(5);

          CHANNEL_D->do_channel(this_player(), "sys",
                 "使用(toto)指令将"HIR+ob->name()+"("+ob->query("id")+")"NOR WHT"送回了客栈. \n"NOR);

          log_file("wizcmds/toto", sprintf("[%s] %s将%s从%s%s(%O.c)送回了客栈.\n原因：%s \n\n", 
		log_time(), log_id(me), log_id(ob), MISC_D->find_place(env),
		filter_color(env->query("short")), env, reason ));

		return 1;
}

int help()
{
        write(@HELP

指令格式：toto <id> because <原因>      

将在线玩家送到客栈

要求目标必须在线.请各位巫师认真填写好原因.

HELP
        );
        return 1;
}

