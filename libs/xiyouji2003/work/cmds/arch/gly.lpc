#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) {
    shout(HIR "\n┋通告天下┋" + log_id(me) + ": ......\n" NOR);
    write(HIR "\n┋通告天下┋" + log_id(me) + ": ......\n" NOR);
  } else if (arg) {
    shout(HIR "\n┋通告天下┋" + log_id(me) + ": " + arg + "\n" NOR);
    write(HIR "\n┋通告天下┋" + log_id(me) + ": " + arg + "\n" NOR);
  }
  return 1;
}
int help(object me) {
  write(@HELP

指令格式 : gly <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话,不受tune的任何限制,不支持emote.
 
HELP
  );
  return 1;
}
