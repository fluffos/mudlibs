#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me)
{
	object *user = users();

	if (me!=this_player(1))	return 0;

	for (int i=0;i<sizeof(user);i++) {
		"/adm/daemons/toptend"->topten_checkplayer(user[i]);
		reset_eval_cost();
		}
	write(WHT"人物排行版更新完毕!\n\n"NOR);

    //Added By waiwai@2001/07/09
    CHANNEL_D->do_channel(me, "adm","用topadd指令更新了人物排行榜！\n"NOR);
    log_file("wizcmds/topadd",sprintf("%s用topadd更新过人物排行榜 时间在: [%s] \n",
             log_id(me), log_time() )); 

    return 1;
 }
 
 
