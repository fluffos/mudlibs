//CMDS /cmds/wiz/more.c
//Created by waiwai@2001/03/05 重新建立
//Last modified by waiwai@2001/06/05

#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);
mixed query(string arg) {
  if (arg && arg == "channel_id")
    return WHT "查看精灵(more)";
  return 0;
}

int main(object me, string arg) {
  string file;
  object ob;

  string wiz_status;

  seteuid(geteuid(me));
  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && wiz_status != "(wizard)")
    return notify_fail(CYN "你没有权利使用这个指令！\n" NOR);

  if (!arg) return notify_fail("指令格式 : more <档名>|<物件名> \n");
  file = resolve_path(me->query("cwd"), arg);

  if (file_size(file) < 0) {
    ob = present(arg, me);
    if (!ob) ob = present(arg, environment(me));
    if (file == "here") ob = environment(me);
    if (!ob) return notify_fail("没有这个档案。\n");
    file = base_name(ob) + ".lpc";
  }

  if (!(int)SECURITY_D->valid_read(file, me)) return notify_fail("没有这个档案。\n");
  me->start_more_file(file);

  log_file("wizcmds/more", sprintf("%s(%s)用more指令查看过文件 %s 时间在: %s \n",
    me->name(1), geteuid(me), file, log_time()));
  CHANNEL_D->do_channel(this_object(), "adm", log_id(me) + "正在查看文件：" HIR + file + "\n" NOR);

  return 0;
}

int help(object me) {
  write(@HELP

指令格式 : more <档案>|<物件名>
 
分页显示档案内容。
 
more 模式下的指令:
q      : 离开 more.
b      : 显示前一页的内容.
[ENTER]: 显示下一页的内容.

HELP
  );
  return 1;
}
