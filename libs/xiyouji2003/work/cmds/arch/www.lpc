/// who.c
#include <ansi.h>
#include <net/dns.h>
inherit F_CLEAN_UP;
int sort_user(object,object);
int sort_bang(object,object);
void create() { seteuid(getuid()); }

mixed main(object me, string arg, int remote)
{
        string str, *option, fname = "";
        object *list, *ob;
        int i, ppl_cnt, cnt, count, wcnt = 0;
        int opt_long, opt_id, opt_wiz, opt_party,opt_bang;
        if( time() - (int)me->query_temp("last_cmd_who") < 12 )
                 return notify_fail("不要太频繁输入who命令。\n");
        if( arg ) {
                option = explode(arg, " ");
                i = sizeof(option);
                while( i-- )
                        switch(option[i]) {
                                case "-l": opt_long = 1; break;
                                case "-i": opt_id = 1; break;
                                case "-w": opt_wiz = 1; break;
                                case "-f":
                                case "-p": opt_party = 1; break;
                                case "-b": opt_bang = 1; break;
                                default:

                                        return notify_fail("指令格式：who [-l|-i|-w|-p]\n");
                        }
        }

        if( opt_long && !wizardp(me)) {
                if( (int)me->query("sen") < 50 )
                        return notify_fail("你的精神太差了，没有办法得知所有玩家的详细资料。\n");
                me->receive_damage("sen", 50);
        }

    str =GRN "◎ " + MUD_NAME + "2002\n"NOR;
        str += GRN"─────────────────────────────────────\n"NOR;
        ob = filter_array(children(USER_OB), (: clonep($1) && $1->query("id") && $1->query("name") :));

           if (opt_party)
                ob = filter_array(ob, (: $1->query("family/family_name") ==
                        $2->query("family/family_name") :), me);
                opt_bang?
                list = sort_array(ob, (: sort_bang :)):
                list = sort_array(ob, (: sort_user :));
                ppl_cnt = 0;
                cnt = 0;
                if( opt_long || opt_wiz || opt_bang) {
                        i = sizeof(list);
                        while( i-- ) {
                        //if (list[i]->query("id") == "axc" || //[K[1A
                        //list[i]->query("id")=="xhn")continue;//[K[1A
                                if( !environment(list[i]) ) continue;
                                if( !me->visible(list[i]) ) continue;
                                if( opt_wiz && !wiz_level(list[i]))  continue;
                                if( opt_bang && !list[i]->query("bang/bang_name") ) continue;
                                if (interactive(list[i])) ppl_cnt++;
                                else cnt++;
                                opt_bang?
                                str = sprintf("%s【 %s 】%s%s %s(%s)\n",
                                                str,
                                                list[i]->query("bang/bang_name"),
                                                " ",
                                                list[i]->query("bang/bang_nick"),
                                                list[i]->query("name"),
                                                list[i]->query("id") ):
                                                str = sprintf("%s%s%s%s\n",
                                                str,
                                                RANK_D->query_rank(list[i]),
                                                " ",
                                                list[i]->short(1)
                                                );
                        }
                } else {
                        i = sizeof(list);
                        while( i-- ) {
//if (list[i]->query("id") == "pkyou" || //[K[1A
//list[i]->query("id")=="sqs")continue;//[K[1A
                                if( !environment(list[i]) ) continue;
                                if( me && !me->visible(list[i]) ) continue;
                                if( remote && list[i]->query("env/invisibility"))
                                        continue;
                                str = sprintf("%s%s%-"+(12+color_len(list[i]->name(1)))+"s"+NOR+"[%-10s%s",
                                                str,
                                                interactive(list[i])?(query_idle(list[i]) > 120?GRN " ":" "):GRN " ",
                                                list[i]->name(1),
                                                capitalize(list[i]->query("id"))+"]",
                                                (ppl_cnt%3==2? "\n": "")
                                );
                                ppl_cnt++;
                        }
     if( ppl_cnt%3 ) str += "\n";

        }
        str += GRN"─────────────────────────────────────\n"NOR;
        str = sprintf("%s共有 %d 位使用者连线中，系统负担：%s\n"NOR, str, ppl_cnt,
     query_load_average() + "\n");

        if( me ) me->start_more(str);
        me->set_temp("last_cmd_who", time());
        return 1;
}

int sort_user(object ob1, object ob2)
{
        string name1, name2;;
        reset_eval_cost();
        if( wiz_level(ob1) != wiz_level(ob2) )
                return wiz_level(ob2)
                        - wiz_level(ob1);

        name1 = ob1->query("family/family_name");
        name2 = ob2->query("family/family_name");

        if (intp(name1)) name1 = "";
        if (intp(name2)) name2 = "";
        if (name1 > name2) return -1;
        if (name1 < name2) return 1;

        return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int sort_bang(object ob1, object ob2)
{
        string name1, name2;;
        reset_eval_cost();
        if( wiz_level(ob1) != wiz_level(ob2) )
                return wiz_level(ob2)
                        - wiz_level(ob1);

        name1 = ob1->query("bang/bang_name");
        name2 = ob2->query("bang/bang_name");

        if (intp(name1)) name1 = "";
        if (intp(name2)) name2 = "";
        if (name1 > name2) return -1;
        if (name1 < name2) return 1;

        return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me)
{
write(@HELP
指令格式 : who [-l|-i|-w|-p]

这个指令可以列出所有在线上的玩家及其等级。

-l 选项列出较长的讯息。
-i 只列出玩家的英文代号。
-p 只列出同门的玩家。
-w 只列出线上所有的巫师。
-b 以帮派形式列出

相关指令： finger
HELP
        );
        return 1;
}
