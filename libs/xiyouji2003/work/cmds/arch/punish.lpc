// CMDS /cmds/arch/punsh.c
// Update by waiwai@2001/06/05
// 重新改写格式

#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
inherit F_CMD;

//Added By waiwai@2001/06/05
#define SYNTAX   "指令格式：punsh <使用者ID> because <原因>\n"

int main(object me, string arg) {
  object ob;
  string reason;

  if (!arg) return notify_fail(SYNTAX);

  if (sscanf(arg, "-f %s because %s ", arg, reason)) {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = LOGIN_D->find_body(arg);
    if (!ob || !me->visible(ob)) return notify_fail(WHT "你只能对在线玩家使用这个指令。\n" NOR);
    if (ob->query("punished") != 0) {

      CHANNEL_D->do_channel(this_player(), "adm",
        "使用(punish -f)指令将" HIR + ob->name(1) + "(" + ob->query("id") + ")" HIW "从死牢释放了. \n" NOR);
      log_file("wizcmds/punish", sprintf("%s将%s从死牢释放了.原因：%s 时间在：[%s]\n",
        log_id(me), log_id(ob), reason, log_time()));
      tell_object(ob, HIG "你刑满被释放了！\n" NOR);
      message(
        "system",
        HIR "┋执法精灵┋" HIW + ob->name() + "(" + ob->query("id") + ")" HIR "刑满被释放了！！！\n" NOR,
        users()
      );
      ob->delete("punished");
      ob->move("/d/city/kezhan");
      ob->set("startroom", "/d/city/kezhan");
      ob->save();
    } else
      write(WHT "目标没有被打入死牢！\n" NOR);
    return 1;
  }

  if (sscanf(arg, "%s because %s", arg, reason) != 2) return notify_fail(SYNTAX);

  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) ob = LOGIN_D->find_body(arg);
  if (!ob || !me->visible(ob)) return notify_fail(WHT "你只能对在线玩家使用这个指令。\n" NOR);

  if (wizhood(me) != "(created)" && wiz_level(me) <= wiz_level(ob))
    return notify_fail("你没有惩罚" + ob->name(1) + "的权利。\n");

  if (me == ob) notify_fail(SYNTAX);
  if (ob->query("punished")) return notify_fail(WHT "这个人已经被关在死牢了。\n" NOR);
  message(
    "system",
    HIR "┋执法精灵┋" HIW + ob->name() + "(" + ob->query("id") + ")" HIR " 罪大恶极，被打入死牢！！！\n" NOR,
    users()
  );
  message_vision(HIB "忽然间狂风四起，天昏地暗！\n$N被一阵龙卷风刮走了！\n" NOR, ob);
  tell_object(ob, HIR "\n由于你的行为违反了这个游戏的规则(help rules)你被打入死牢！\n" NOR);
  tell_object(ob, HIR "请你认真对照游戏规则(help rules),反省自己的错误！\n\n" NOR);
  ob->set("punished", 1);
  ob->move("/d/wiz/punish");

  CHANNEL_D->do_channel(this_player(), "adm",
    "使用(punish)指令将" HIR + ob->name(1) + "(" + ob->query("id") + ")" HIW "送进了死牢. \n" NOR);
  log_file("wizcmds/punish", sprintf("%s将%s送进了死牢.原因：%s 时间在：[%s]\n",
    log_id(me), log_id(ob), reason, log_time()));

  return 1;
}

int help(object me) {
  write(@HELP

指令格式：punish <id> because <原因>      将在线玩家打入死牢
          punish -f <id> because <原因>   将在死牢玩家释放

要求目标必须在线.请各位巫师认真填写好原因.

HELP
  );
  return 1;
}
