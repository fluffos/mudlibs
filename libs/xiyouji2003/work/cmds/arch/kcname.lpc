// CMDS /cmds/arch/kcname.c
// Created by waiwai@2002/11/22

#include <command.h>

#define SYNTAX   "指令格式：kcname <使用者ID> because <原因>\n"
inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob, link_ob;
	string reason, id, wiz_status;

	if( me!=this_player(1) ) return 0;
	wiz_status = SECURITY_D->get_status(me);

	if( wiz_status != "(admin)" && wiz_level(me) <= wiz_level(ob) )
                return notify_fail("你没有对" + ob->name(1) + "使用这个指令的权利。\n");

	if(!arg) return notify_fail(SYNTAX);

	if( sscanf(arg, "%s because %s", arg, reason)!=2 )
		return notify_fail(SYNTAX);

	if( !objectp(ob = present(arg, environment(me))) || !userp(ob) )
	       return notify_fail(WHT"这里没有这个人。\n"NOR);

	message_vision("$N将$n的Post个人签名删除！！！ \n", me, ob);

	CHANNEL_D->do_channel(me, "adm","用kcname指令将"+ob->query("name")+
"("+ob->query("id")+")的Post个人曾用名删除掉了。\n"NOR);	
	link_ob=ob->query_temp("link_ob");

	log_file("wizcmds/kcname",sprintf("[%s] %s将%s(%s)的Post个人曾用名删除 原因：\n%s\n\n",
	log_time(), log_id(me), ob->name(1), geteuid(ob), reason) );

	if(link_ob) {
		if( ob->query("id") == "waiwai" ) {
		link_ob->set("cname/cname","[歪歪] ");
		} else {
		link_ob->delete("cname");
//		link_ob->delete("12sxt");
		link_ob->save();
		}
	}
//	ob->delete("signature");
	ob->save();
	if(ob=me) me->save();
	write(ob->name()+"个人曾用名资料成功删除。为了立刻生效请提示save。\n");

	return 1;
}

int help(object me)
{
write(@HELP

指令格式 : kcname <id>  because [原因]

用来删除玩家的个人曾用名资料以及Finger图谱资料。

HELP
  );
  return 1;
}

