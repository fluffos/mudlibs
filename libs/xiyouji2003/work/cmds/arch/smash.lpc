#include <ansi.h>

inherit F_CLEAN_UP;

mixed query(string arg)
{
    if (arg && arg=="channel_id")
        return  HIR"死亡精灵(smash)"NOR WHT;
    return 0;
}

int main(object me, string arg)
{
	object ob;
       int immortal;
       string msg;
	string wiz_status;
	if( me != this_player(1) ) return 0;
	
	wiz_status = SECURITY_D->get_status(me);

	if( wiz_status != "(admin)" 
		&& wiz_status != "(arch)" 
		&& wiz_status != "(wizard)" )
		return 0;

	if( !arg )
		return notify_fail("指令格式: smash <living>\n");

	ob = present(arg, environment(me));
	if( !ob || ! me->visible(ob) ) {
                ob = find_player(arg);
                if ( !ob || wiz_level(ob) < 1 || !me->visible(ob) )
                        ob = find_living(arg);

                if( !ob || ! me->visible(ob) )
                        ob = find_object(arg);

                if( !ob || ! ob->is_character() || ! me->visible(ob))
                        return notify_fail("找不到这个生物。\n");
        }

	if( wiz_status != "(admin)" ) {
		if( playerp(ob) && !wizardp(ob) )
			return notify_fail("你无权对用户施展法力。\n");

	if( ob->query("waiwai_lead") || ob->query("zombie") || 
		ob->query("limit_fight") || ob->query("tudi") )
                return notify_fail(HIR"系统禁止你对" + ob->name() + HIR"使用这个指令。\n"NOR);

        }

       if( environment(ob) != environment(me) ) {
                message("vision", 
		HIY "\n天空慢慢的暗了下来，忽然间天际一亮，一道闪电伴随滚滚雷声直落而下，正正劈中" +
                                  ob->name(1) + HIY "。\n\n" NOR, all_interactive());
                
        
	if( wiz_level(me) < wiz_level(ob) ) {
//		message_vision(HIM "\n$N" HIM "身上冒着缕缕青烟，"
//                                       "却没有半点事情。\n\n" NOR, ob);
		me=ob;
		return 1;
	}
        
	if( wizardp(ob) ) {
		immortal = (int)ob->query("env/immortal");
		ob->set("env/immortal", 0);
	}

	ob->set_temp("death_msg","被" + log_id(me) + "用雷劈死了。。。\n"NOR);

		ob->receive_damage("kee", 1, me);
		ob->set_temp("killbyname","炸雷");
		ob->set_temp("killbyid","thunder");
		ob->set_temp("killbyB","所炸");
		ob->delete("kill/last_killer");
		ob->set("diemsg", 2);

		ob->die();
		if( ob && wizardp(ob) )
			ob->set("env/immortal", immortal);
                return 1;
        }

        if( wiz_level(me) < wiz_level(ob) ) //{
//                message_vision(HIM "\n$N" HIM "身上冒着缕缕青烟，"
//                               "却没有半点事情。\n\n" NOR, ob);
		me=ob;
//		return 1;
//        }

        msg = HIC "\n$N" HIC "伸手一招，只见一道" HIY "闪电" HIC
              "从天而降，击中了$n" HIC "。。。。。。\n" NOR;

        if( me == ob ) {
                        return notify_fail("活得不耐烦了的话就自杀吧。。。\n");
//                msg = replace_string(msg, "$n", "$N");
//                message_vision(msg, me);
        } else
                message_vision(msg, me, ob);

        if( !ob->is_character() ) {
                message_vision(HIM + ob->name() + HIM "从这个世界上消失了...\n\n" NOR, me);
                destruct(ob);
                return 1;
        }

        if( wizardp(ob) ) {
                immortal = (int)ob->query("env/immortal");
                ob->set("env/immortal", 0);
        }

	ob->set_temp("die", HIR+ob->name()+"被雷劈死了。。。\n"NOR);

//	if( ob == me )
//		ob->set_temp("death_msg",HIW" 活得不耐烦，用雷把自己劈死了。。。\n"NOR);

	if( userp(ob) ) {
	ob->set_temp("killbyname","炸雷");
	ob->set_temp("killbyid","thunder");
	ob->set_temp("killbyB","所炸");
	ob->delete("kill/last_killer");
	}
	ob->set("diemsg", 2);

       ob->receive_damage("kee", 1, me);
	ob->die();
       if( ob && wizardp(ob) )
                ob->set("env/immortal", immortal);

	return 1;
}
 
int help(object me)
{
        write(@HELP

指令格式: smash <生物>
 
HELP );
        return 1;
}
