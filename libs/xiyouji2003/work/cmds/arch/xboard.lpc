// CMDS /cmds/arch/xboard.c
// Created by waiwai@2001/07/03

#include <login.h>;
#include <command.h>
inherit F_CLEAN_UP;
//inherit F_CMD;

int main(object me, string arg)
{
	object ob,link_ob;
	string id, reason, sum, wiz_status;

	if( me != this_player(1) ) return 0;

	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" && wiz_status != "(arch)" )
         return notify_fail(WHT"你没有权利使用这个指令！\n"NOR);

	if(!arg||sscanf(arg,"%s because %s",id,reason)!=2)
		return notify_fail("用法:noboard ID because 原因 \n");

	ob=find_player(id);
	if(!ob) {
        ob = new(USER_OB);
        ob->set("id",id);
        if( !ob->restore() )
        	return notify_fail("没有这个玩家。\n");
        else	{                                    
           ob->delete("no_board");
           tell_object(me, "你将玩家(离线)" HIW+ ob->query("id") + "("+ob->query("name")
                + ")"NOR"的留言权限设定为开放状态！ \n"NOR);

           log_file( "wizcmds/noboard", sprintf("[%s] %s在%s离线状态下设定其留言权限为开放状态\n原因： \n",
                log_time(), log_id(me), ob->query("name"), geteuid(ob), reason));

           ob->save();
           destruct(ob);
           return 1;
		}
	}

	link_ob=ob->query_temp("link_ob");
	if(link_ob) {
		ob->delete("no_board");
		ob->save();
                tell_object(me, "你将玩家(在线)" HIW+ ob->query("id") + "("+ob->query("name")
                + ")"NOR"的留言权限设定为开放状态！ \n"NOR);

           log_file( "wizcmds/noboard", sprintf("[%s] %s在%s在线状态下设定其留言权限为开放状态\n原因： \n",
                log_time(), log_id(me), ob->query("name"), geteuid(ob), reason));

		return 1;
	}

	else
		return notify_fail(HIR"错误。无法进行正确设定。\n"NOR);
	return 1;
}


int help(object me)
{
        write(@HELP

指令格式 : xboard ID because 原因

这个指令可以设定玩家留言权限为开放状态，请谨慎使用。
被设定的玩家将可以在游戏中的任何的一个留言板进行留言。

相关指令：noboard

HELP
    );
    return 1;
}