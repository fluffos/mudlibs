// CMDS /cmds/eld/passwd_w.c 设置巫师专用密码
// Created by waiwai@2001/07/21

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (me != this_player(1)) return 0;

  ob = me->query_temp("link_ob");
  if (!ob) return 0;
  while (ob && ob->is_character()) ob = ob->query_temp("link_ob");

  if (ob->query("password_w")) {
    write(CYN "为了安全起见，请先输入您原来的巫师专用密码：" NOR);
    input_to("get_old_pass", 1, ob);
    return 1;
  }
  write(WHT "请输入新的巫师专用密码：" NOR);
  input_to("get_new_pass", 1, ob);
  return 1;
}

private void get_old_pass(string pass, object ob) {
  string old_pass;

  write("\n");
  old_pass = ob->query("password_w");
  if (crypt(pass, old_pass) != old_pass) {
    write(HIR "密码错误！\n" NOR);
    return;
  }
  write(WHT "请输入新的巫师专用密码：" NOR);
  input_to("get_new_pass", 1, ob);
}

private void get_new_pass(string pass, object ob) {
  int i;
  int bigletter = 0;
  int smlletter = 0;

  string old_pass, old_pass2;
  write("\n");
  old_pass = ob->query("password");
  old_pass2 = ob->query("superpasswd");

  i = strlen(pass);

  if (i <= 5) {
    write(WHT "专用密码的长度至少要六个字元，请慎重设定您的巫师专用密码：" NOR);
    input_to("get_new_pass", 1, ob);
    return;
  }
  /*
   if(crypt(pass,old_pass2) ==old_pass2) {
           write(HIR"为了安全,您的巫师专用密码组合不能和您的身份标识相同！ \n"NOR);
               write(WHT"\n请重新慎重设定您的巫师专用密码："NOR);
           input_to("get_new_pass",1,ob);
           return;
        }
*/
  if (crypt(pass, old_pass) == old_pass) {
    write(HIR "为了安全,您的巫师专用密码组合不能和您的密码相同！ \n" NOR);
    write(WHT "\n请重新慎重设定您的巫师专用密码：" NOR);
    input_to("get_new_pass", 1, ob);
    return;
  }

  if (strsrch(pass, ob->query("id")) != -1) {
    write(HIR "为了安全,您的巫师专用密码组合不能英文名字相同！ \n" NOR);
    write(WHT "\n请重新慎重设定您的巫师专用密码：" NOR);
    input_to("get_new_pass", 1, ob);
    return;
  }

  if (strsrch(pass, ob->query("name")) != -1) {
    write(HIR "为了安全,您的巫师专用密码组合不能中文名字相同！ \n" NOR);
    write(WHT "\n请重新慎重设定您的巫师专用密码：" NOR);
    input_to("get_new_pass", 1, ob);
    return;
  }

  while (i--) {
    if (pass[i] <= 'Z' && pass[i] >= 'A') bigletter++;
    if (pass[i] <= 'z' && pass[i] >= 'a') smlletter++;

  }

  if (bigletter == 0 || smlletter == 0 || bigletter + smlletter == i) {
    write("您的巫师专用密码必须包含" HIR "大写" NOR "和" + HIR "小写英文字母" NOR
      "以及" HIR "其它字符" NOR "，例如：Mud-123。\n");
    write(WHT "\n请重新慎重设定您的巫师专用密码：" NOR);
    input_to("get_new_pass", 1, ob);
    return;
  }

  write(WHT "\n请再输入一次新的巫师专用密码：" NOR);
  input_to("confirm_new_pass", 1, ob, crypt(pass, 0));
}

private void confirm_new_pass(string pass, object ob, string new_pass) {
  write("\n");
  if (crypt(pass, new_pass) != new_pass) {
    write(HIW "对不起，您输入的密码并不相同，继续使用原来的密码。\n" NOR);
    return;
  }
  seteuid(getuid());
  if (!ob->set("password_w", new_pass)) {
    write(HIR "密码变更失败！\n" NOR);
    return;
  }

  ob->save();
  write(HIG "巫师专用密码变更成功 ！\n" NOR);
}

int help(object me) {
  write(@HELP

指令格式 : passwd_w
 
这个指令可以修改你的巫师专用密码。
 
HELP
  );
  return 1;
}
