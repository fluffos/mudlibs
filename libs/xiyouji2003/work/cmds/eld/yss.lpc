// CMDS /cmds/eld/yss.c 配合wizlist的隐身参数设置
// Created by waiwai@2001/07/11

inherit F_CLEAN_UP;

#include <ansi.h>
#include <command.h>
#include <login.h>
#include <mudlib.h>

int help(object me);

int main(object me, string arg) {
  int num;
  object link_ob;
  string wiz_status;
  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);

  link_ob = me->query_temp("link_ob");

  if (!arg) {
    write(WHT "你已经设定的隐身级别为：" HIR + (int)me->query("env/invisibility") + " \n" NOR);
    return 1;
  }

  if (wiz_status != "(admin)") {
    if (sscanf(arg, "%d", num) != 1 || num < 0 || num > 5)
      return help(me);
  } else if (sscanf(arg, "%d", num) != 1 || num < 0 || num > 10)
    return help(me);


  me->set("env/invisibility", num);
  me->set_temp("temp_time", time());
  link_ob->set("last_on", time());
  link_ob->save();
  me->save();

  write(WHT "你将自己的隐身参数成功设置为：" HIG + num + "\n" NOR);
  write(WHT "你可以用" HIY "set" NOR WHT "指令查看参数是否正确！\n" NOR);
  return 1;
}

int help(object me) {
  write(@HELP

指令格式： yss [1-10之间的数字或是0]

这个指令可以设定你的隐身参数.主管天神(admin)
以下级别巫师只能设置0-5之间的数字

HELP
  );
  return 1;
}
