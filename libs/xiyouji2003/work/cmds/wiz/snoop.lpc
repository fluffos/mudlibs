#include <command.h>

inherit F_CMD;

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;


  if (!arg) {
    if (objectp(ob = query_snooping(me)))
      write("你现在正在监听" + ob->query("name") + "所收到的讯息。\n");
    return 1;
  } else if (arg == "-none") {
    snoop(me);
    write("Ok.\n");
    return 1;
  } else if (query_snooping(me)) snoop(me);

  ob = find_player(arg);
  if (!ob) ob = find_living(arg);

  if (!ob) ob = LOGIN_D->find_body(arg);

  if (!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");

  if (ob->query("no_snoop") || wizhood(ob) == "(admin)")
    return notify_fail("没有这个人。\n");

  if (ob->query("env/invisibility") <= me->query("env/invisibility")) {
    if (wizhood(me) != "(admin)" && wiz_level(me) <= wiz_level(ob))
      return notify_fail("你没有监听" + ob->name() + "所收听讯息的权利。\n");

  } else return notify_fail("没有这个人。\n");

  if (me == ob) return notify_fail("请用 snoop -none 解除监听。\n");

  //	if( interactive(ob) ) return notify_fail("没有这个人。\n");

  snoop(me, ob);

  me->set_temp("snoop_encoding",
    (int)me->query_encoding() * 10 + ob->query_encoding());

  write("你现在开始监听" + ob->name(1) + "所收到的讯息。\n");

  if (userp(ob) && wizardp(ob) && wizhood(me) != "(admin)")
    log_file("wizcmds/snoop",
      sprintf("%s snoops %s 时间：[%s]\n", log_id(me), log_id(ob), log_time()));

  return 1;
}

void fail(object me) {
  tell_object(me, "奇怪，没这个人．．．\n");
  return;
}

int help() {
  write(@TEXT

指令格式：snoop <某人>|-none

监听其他使用者所收听的讯息，snoop -none 则取消监听。

TEXT
  );
  return 1;
}
