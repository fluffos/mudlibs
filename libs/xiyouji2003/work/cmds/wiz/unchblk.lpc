// [1;31m此文件禁止随意移动和更改[0m
// CMDS /cmds/wiz/unchblk.c 用户公用频道管理
// Created by waiwai@2001/03/21 

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

void create() {
  seteuid(getuid());
  set("channel_id", HIG "公用频道管理精灵(UNCHBLK)");
}

int main(object me, string arg) {
  object ob;
  string who, ch_name;
  string wiz_status;

  if (me != this_player(1)) return 0;
  wiz_status = SECURITY_D->get_status(me);

  if (!arg)
    return notify_fail("指令格式: unchblk <用户ID> <频道名称>\n");

  if (sscanf(arg, "%s %s", who, ch_name) != 2) {
    ch_name = "";
    if (sscanf(arg, "%s", who) != 1) {
      return notify_fail("指令格式: unchblk <用户ID> <频道名称>\n");
    }
  }

  if (who == "forever") {
    if (wiz_status != "(created)")
      return notify_fail("只有 (created) 级别的巫师才能进行这个设定！\n");

    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的公用频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的公用频道 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "rumor") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的谣言频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的谣言频道(rumor) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "chat") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的聊天频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的聊天频道(chat) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "party") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的门派频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的门派频道(party) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "xyj") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的潭际频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的潭际飞梭(xyj) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "new") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的新手频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的新手频道(new) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "sldh") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的水陆大会频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的水陆大会频道(sldh) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "music") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的天籁频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的天籁频道(music) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  if (who == "sale") {
    CHANNEL_D->set_block(who, 0);
    CHANNEL_D->do_channel(this_object(), "sys", "整个系统的摊贩叫卖频道被" + log_id(me) + "重新开启！！！");
    log_file("wizcmds/channeld", sprintf("%s开启了整个系统的摊贩叫卖(sale) 时间在：[%s]\n",
      log_id(me), log_time()));
    return 1;
  }

  ob = LOGIN_D->find_body(who);
  if (!ob) return notify_fail("这个人不在！\n");
  if (wizardp(ob) && ob->query("env/invisibility"))
    return notify_fail("这个人不在！\n");

  if (ch_name == "" || ch_name == " ") {
    if (ob->query("chblk/forever")) {
      tell_object(me, HIG + log_id(ob) +
        "的公用频道已经被设定为永久性关闭(forever)状态。。。\n" NOR);
      return 1;
    } else {
      if ((time() - ob->query("chblk/all") < 0) || (time() - ob->query("chblk/chat") < 0) ||
        (time() - ob->query("chblk/rumor") < 0) || (time() - ob->query("chblk/new") < 0) ||
        (time() - ob->query("chblk/party") < 0) || (time() - ob->query("chblk/sldh") < 0) ||
        (time() - ob->query("chblk/wkz") < 0) || (time() - ob->query("chblk/sale") < 0) ||
        (time() - ob->query("chblk/music") < 0) || (time() - ob->query("chblk/bh") < 0)) {
        tell_object(me, log_id(ob) + "被关闭的频道有(剩余开启时间)：\n");
        if (time() - ob->query("chblk/all") < 0)
          tell_object(me, "所有频道被关闭：" + (-(time() - (int)ob->query("chblk/all")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/chat") < 0)
          tell_object(me, "chat频道被关闭：" + (-(time() - (int)ob->query("chblk/chat")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/rumor") < 0)
          tell_object(
            me,
            "rumor频道被关闭：" + (-(time() - (int)ob->query("chblk/rumor")) / 60) + "分钟\n"
          );

        if (time() - ob->query("chblk/party") < 0)
          tell_object(
            me,
            "party频道(chblk all)被关闭：" + (-(time() - (int)ob->query("chblk/party")) / 60) + "分钟\n"
          );

        if (time() - ob->query("chblk/new") < 0)
          tell_object(me, "new频道被关闭：" + (-(time() - (int)ob->query("chblk/new")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/sldh") < 0)
          tell_object(me, "sldh频道被关闭：" + (-(time() - (int)ob->query("chblk/sldh")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/wkz") < 0)
          tell_object(me, "wkz频道被关闭：" + (-(time() - (int)ob->query("chblk/wkz")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/sale") < 0)
          tell_object(me, "sale频道被关闭：" + (-(time() - (int)ob->query("chblk/sale")) / 60) + "分钟\n");

        if (time() - ob->query("chblk/music") < 0)
          tell_object(
            me,
            "music频道被关闭：" + (-(time() - (int)ob->query("chblk/music")) / 60) + "分钟\n"
          );

        if (time() - ob->query("chblk/bh") < 0)
          tell_object(me, "bh频道被关闭：" + (-(time() - (int)ob->query("chblk/bh")) / 60) + "分钟\n");
        return 1;

      } else
        tell_object(me, log_id(ob) + "没有被关闭的频道。\n");
      return 1;

    }
  }

  if (ch_name != "all" && ch_name == "forever") {
    if ((int)ob->query("chblk/forever"))
      ob->delete("chblk/forever");
    tell_object(me, HIG + log_id(ob) + "的公用频道永久性关闭状态被清除了。。。\n" NOR);
    log_file("wizcmds/chblk_player", sprintf("%s将%s的公用频道永久性关闭(forever)状态清除 时间在：[%s]\n",
      log_id(me), log_id(ob), log_time()));
    return 1;
  } else

  if (ch_name == "all") {
    if ((int)ob->query("chblk/forever")) {
      tell_object(me, log_id(ob) + "尚有永久性关闭标志(forever)，不能开启其频道。。。\n");
      return 1;
    } else {
      if ((int)ob->query("chblk/rumor"))
        ob->delete("chblk/rumor");
      if ((int)ob->query("chblk/chat"))
        ob->delete("chblk/chat");
      if ((int)ob->query("chblk/party"))
        ob->delete("chblk/party");
      if ((int)ob->query("chblk/new"))
        ob->delete("chblk/new");
      if ((int)ob->query("chblk/sldh"))
        ob->delete("chblk/sldh");
      if ((int)ob->query("chblk/wkz"))
        ob->delete("chblk/wkz");
      if ((int)ob->query("chblk/all"))
        ob->delete("chblk/all");
      if ((int)ob->query("chblk/sale"))
        ob->delete("chblk/sale");
      if ((int)ob->query("chblk/music"))
        ob->delete("chblk/music");
      if ((int)ob->query("chblk/bh"))
        ob->delete("chblk/bh");

      tell_object(me, log_id(ob) + "的所有频道都被打开了。。。\n");
    }
  } else if (ch_name == "rumor") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/rumor");
    }

    if ((int)ob->query("chblk/rumor"))
      ob->delete("chblk/rumor");

    tell_object(me, log_id(ob) + "的谣言频道被打开了。\n");
  }

  else if (ch_name == "new") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/new");
    }

    if ((int)ob->query("chblk/new"))
      ob->delete("chblk/new");

    tell_object(me, log_id(ob) + "的新手频道被打开了。\n");
  }

  else if (ch_name == "chat") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/chat");
    }

    if ((int)ob->query("chblk/chat"))
      ob->delete("chblk/chat");

    tell_object(me, log_id(ob) + "的聊天频道被打开了。\n");
  } else if (ch_name == "music") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/music");
    }

    if ((int)ob->query("chblk/music"))
      ob->delete("chblk/music");

    tell_object(me, log_id(ob) + "的天籁频道被打开了。\n");
  } else if (ch_name == "party") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/parry");
    }

    if ((int)ob->query("chblk/party"))
      ob->delete("chblk/party");

    tell_object(me, log_id(ob) + "的门派频道被打开了。\n");
  } else if (ch_name == "wkz") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/wkz");
    }

    if ((int)ob->query("chblk/party"))
      ob->delete("chblk/party");

    tell_object(me, log_id(ob) + "的潭际频道被打开了。\n");
  } else if (ch_name == "sale") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/sale");
    }

    if ((int)ob->query("chblk/sale"))
      ob->delete("chblk/sale");

    tell_object(me, log_id(ob) + "的摊贩叫卖频道被打开了。\n");
  } else if (ch_name == "bh") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/bh");
    }

    if ((int)ob->query("chblk/bh"))
      ob->delete("chblk/bh");

    tell_object(me, log_id(ob) + "的帮会频道被打开了。\n");
  } else if (ch_name == "sldh") {
    if ((int)ob->query("chblk/all")) {
      ob->delete("chblk/all");
      ob->delete("chblk/sldh");
    }

    if ((int)ob->query("chblk/bh"))
      ob->delete("chblk/sldh");

    tell_object(me, log_id(ob) + "的水陆大会频道被打开了。\n");
  }

  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : unchblk <用户ID> <频道名称>
	   unchblk <频道名称>

此命令将打开某人的频道。如果没有频道名就打开所有合法频道。

<频道名称>：(10个常规类别)
rumor、chat、party、sale、wkz、music、sldh、new、bh或all。
如果不提供频道名，则显示某人当前的频道状态。 
注意：打开某个频道也将同时去除all属性，forever状态除外。
解除私聊频道限制请用block

相关指令：chblk，block

HELP
  );
  return 1;
}
