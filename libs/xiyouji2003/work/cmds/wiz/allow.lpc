//allow.c
//允许玩家开帮
//create by fall@xyj 9/18/2002

#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg)
{
        object ob;

        if( !arg) return help(me);      

        ob = find_player(arg);

        if(!ob) ob = find_living(arg);
        
        if(!ob) ob = LOGIN_D->find_body(arg);

        if(!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");

        if( wizhood(me) != "(wizard)"
        &&      wiz_level(me) <= wiz_level(ob) )
                return notify_fail("你没有允许" + ob->name() + "开帮的权利。\n");

        if( me==ob )  return help(me);
        if (ob->query("/bang/ready")) return notify_fail("这个人已经被允许开帮了。\n");
        message_vision(HIB"忽然间锣鼓声起，唢呐声来！\n$N被允许开创帮派了！\n"NOR,ob);
                tell_object(ob,"你被允许开创帮派了！\n");
                ob->set("/bang/ready",1);
        if( userp(ob) ) 
        log_file("ALLOW_PARTY",sprintf("%s(%s) allow %s on %s.\n", me->name(1),
                  geteuid(me), ob->name(1),ctime(time()) ) );

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：
   allow <id>     允许玩家创建帮派

HELP
        );

        return 1;
}
