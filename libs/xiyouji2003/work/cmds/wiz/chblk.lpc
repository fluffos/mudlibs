// [1;31m此文件禁止随意移动和更改[0m
// CMDS /cmds/wiz/chblk.c 用户公用频道管理
// Created by waiwai@2001/03/21 
// 在limit_id里面一定要将频道名设置为禁止注册
// 设定管理模式为灵活模式，可以单独添加累计禁止时间
// 以time()的形式的设定可以避免Quit重新连线无效的情况
// 私有频道管理为 block.c

#include <ansi.h>

inherit F_CLEAN_UP;
//inherit F_SAVE; 
inherit F_DBASE;

void create()
{
	seteuid(getuid());     
	set("channel_id", HIG"公用频道管理精灵(CHBLK)");
}

int main(object me, string arg)
{
	object ob;
	string who, ch_name;
	string wiz_status;

	if( me!=this_player(1) ) return 0;
	wiz_status = SECURITY_D->get_status(me);

	if (!arg)
		return notify_fail("指令格式: chblk <用户ID> <频道名称>\n");
    
	if (sscanf(arg, "%s %s", who, ch_name) != 2) {
		ch_name = "";
		if (sscanf(arg, "%s", who) != 1 ) {
			return  notify_fail("指令格式: chblk <用户ID> <频道名称>\n");
		}   
	}

	if (who == "forever") {
          if( wiz_status != "(created)" )
	        return notify_fail("只有 (created) 级别的巫师才能进行这个设定！\n");

		CHANNEL_D->set_block("forever", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的公用频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的公用频道(forever) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	if (who == "rumor")	{
		CHANNEL_D->set_block("rumor", time()+3600);
//		set("rumor",time()+3600);
//		save();
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的谣言频道60分钟。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的谣言频道(rumor) 60 分钟。 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
		}


		if (who == "sldh") {
		CHANNEL_D->set_block("sldh", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的水陆大会频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的水陆大会频道(sldh) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	if (who == "chat") {
		CHANNEL_D->set_block("chat", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的聊天频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的聊天频道(chat) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}
	
	if (who == "party") {
		CHANNEL_D->set_block("party", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的门派频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的门派频道(party) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}
	
	if (who == "new") {
		CHANNEL_D->set_block("new", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的新手频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的新手频道(new) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	if (who == "music") {
		CHANNEL_D->set_block("music", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的天籁频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的天籁频道(music) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	if (who == "xyj") {
		CHANNEL_D->set_block("xyj", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的潭际飞梭频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的潭际飞梭(xyj) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	if (who == "sale") {
		CHANNEL_D->set_block("sale", 1);
		CHANNEL_D->do_channel(this_object(), "sys", log_id(me)+"关闭了整个系统的摊贩叫卖频道。。。"NOR);
		log_file("wizcmds/channeld", sprintf("%s关闭了整个系统的摊贩叫卖(sale) 时间在：[%s]\n",
		log_id(me), log_time() ));
		return 1;
	}

	ob = LOGIN_D->find_body(who);

	if(!ob ) return notify_fail("没有这个人。。。\n");

	if(wizardp(ob) && (int)me->query("env/invisibility") < (int)ob->query("env/invisibility") ) 
		return notify_fail("没有这个人。。。\n");

	if(wizardp(ob) && wiz_level(me)<wiz_level(ob) ) 
		return notify_fail("你无权关闭"+log_id(ob)+"的频道。。。\n");

	if( ob == me) return notify_fail("关闭自己的频道？脑子秀豆了。。\n");

	/**************************************************************/
	if (ch_name == "" || ch_name == " ") {
		if ( ob->query("chblk/forever") ) {
		tell_object(me, HIG+log_id(ob)+
			"的公用频道已经被设定为永久性关闭(forever)状态。。。\n"NOR);
		return 1;
		} else {

	if(( time()-ob->query("chblk/all")<0 ) || ( time()-ob->query("chblk/chat")<0 ) ||
	( time()-ob->query("chblk/rumor")<0 ) || ( time()-ob->query("chblk/new")<0 ) ||
	( time()-ob->query("chblk/party")<0 ) || ( time()-ob->query("chblk/sldh")<0 ) ||
	( time()-ob->query("chblk/wkz")<0 ) || ( time()-ob->query("chblk/sale")<0 ) ||
	( time()-ob->query("chblk/music")<0 ) || ( time()-ob->query("chblk/bh")<0 ) ) {
	tell_object(me,log_id(ob)+"被关闭的频道有(剩余开启时间)：\n");

	if ( time()-ob->query("chblk/all")<0 ) 
	tell_object(me,"所有频道被关闭："+(-(time()-(int)ob->query("chblk/all"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/chat")<0 ) 
	tell_object(me,"chat频道被关闭："+(-(time()-(int)ob->query("chblk/chat"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/rumor")<0 ) 
	tell_object(me,"rumor频道被关闭："+(-(time()-(int)ob->query("chblk/rumor"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/party")<0 ) 
	tell_object(me,"party频道(chblk all)被关闭："+(-(time()-(int)ob->query("chblk/party"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/new")<0 ) 
	tell_object(me,"new频道被关闭："+(-(time()-(int)ob->query("chblk/new"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/sldh")<0 ) 
	tell_object(me,"sldh频道被关闭："+(-(time()-(int)ob->query("chblk/sldh"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/wkz")<0 ) 
	tell_object(me,"wkz频道被关闭："+(-(time()-(int)ob->query("chblk/wkz"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/sale")<0 ) 
	tell_object(me,"sale频道被关闭："+(-(time()-(int)ob->query("chblk/sale"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/music")<0 ) 
	tell_object(me,"music频道被关闭："+(-(time()-(int)ob->query("chblk/music"))/60)+"分钟\n");

	if ( time()-ob->query("chblk/bh")<0 ) 
	tell_object(me,"bh频道被关闭："+(-(time()-(int)ob->query("chblk/bh"))/60)+"分钟\n");
	return 1;

	}else
	tell_object(me,log_id(ob)+"没有被关闭的频道。\n");
	return 1;
	}
	}
	/**************************************************************/

		if (ch_name == "forever") {
		if ( ob->query("chblk/forever") ) {
			tell_object(me, log_id(ob)+"的所有公用频道已经是永久性关闭的了。\n");
		} else {
			ob->set("chblk/forever", 1);
			tell_object(me, log_id(ob)+"的所有公用频道被设定为永久性关闭。\n");
		log_file("wizcmds/chblk_player", sprintf("%s将%s公用频道设定为永久性关闭(forever)状态 时间在：[%s]\n",
		log_id(me), log_id(ob), log_time() ));
		}
		}
		else if (ch_name == "all") {
		// 设定可以灵活添加限制时间，每次添加10分钟
		if ( time()-ob->query("chblk/all")<0 ) {
			tell_object(me, log_id(ob)+"的所有频道曾经已经是关闭的了，还有"HIR+
			(-(time()-(int)ob->query("chblk/all"))/60)+NOR"分钟才能正常使用。。。\n");
			ob->add("chblk/all", 600);
			tell_object(me, log_id(ob)+"目前被设定关闭"HIR+(-(time()-(int)ob->query("chblk/all"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
			} else
			ob->set("chblk/all", time()+3600);
			tell_object(me, log_id(ob)+"的所有频道被设定关闭60分钟。\n");
		} 
		else if (ch_name == "rumor") {  // 谣言
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/rumor")<0 ) {
			tell_object(me, log_id(ob)+"的谣言频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/rumor"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/rumor", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/rumor"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/rumor", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的谣言频道被设定关闭10分钟。\n");
		}	
		}
 
		else if (ch_name == "sldh") {  // 水陆大会
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/sldh")<0 ) {
			tell_object(me, log_id(ob)+"的水陆大会频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/sldh"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/sldh", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/sldh"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/sldh", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的水陆大会频道被设定关闭10分钟。\n");
		}	
		}


		else if (ch_name == "chat") {  // 聊天
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/chat")<0 ) {
			tell_object(me, log_id(ob)+"的聊天频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/chat"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/chat", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/chat"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/chat", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的聊天频道被设定关闭10分钟。\n");
		}	
		}

		else if (ch_name == "party") {  // 门派
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/party")<0 ) {
			tell_object(me, log_id(ob)+"的门派频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/party"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/party", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/party"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/party", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的门派频道被设定关闭10分钟。\n");
		}	
		}


		else if (ch_name == "new") {  // 新手
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/new")<0 ) {
			tell_object(me, log_id(ob)+"的新手频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/new"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/new", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/new"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/new", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的新手频道被设定关闭10分钟。\n");
		}	
		}

		else if (ch_name == "bh") {  // 帮会
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/bh")<0 ) {
			tell_object(me, log_id(ob)+"的帮会频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/bh"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/bh", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/bh"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/bh", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的帮会频道被设定关闭10分钟。\n");
		}	
		}

		else if (ch_name == "wkz") {  // 潭际
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/wkz")<0 ) {
			tell_object(me, log_id(ob)+"的潭际频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/wkz"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/wkz", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/wkz"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/wkz", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的潭际频道被设定关闭10分钟。\n");
		}	
		}

		else if (ch_name == "sale") {  // 摊贩叫卖
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/sale")<0 ) {
			tell_object(me, log_id(ob)+"的摊贩频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/sale"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/wkz", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/sale"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/sale", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的摊贩频道被设定关闭10分钟。\n");
		}	
		}

		else if (ch_name == "music") {  // 天籁
		if ( !ob->query("chblk/all") && time()-ob->query("chblk/music")<0 ) {
			tell_object(me, log_id(ob)+"的天籁频道目前已经是关闭的了，还有"+
				(-((time()-(int)ob->query("chblk/music"))/60))+"分钟才能正常使用。\n");
			ob->add("chblk/music", 600); // 每次追加10分钟
			tell_object(me, log_id(ob)+"目前被追加关闭至"HIR+(-(time()-(int)ob->query("chblk/music"))/60)+
			NOR"分钟后才能正常使用。。。\n");
			return 1;
		} else
		if ( time()-ob->query("chblk/all")<0 ) { // 不能与ALL重复
			tell_object(me, log_id(ob)+"的所有频道目前已经是关闭的了，还有"HIR+
			(-((time()-(int)ob->query("chblk/all"))/60))+NOR"分钟才能正常使用，请先去除用户ALL状态。\n");
			return 1;
		} else {
			ob->set("chblk/music", time()+600); // 首次关闭
			tell_object(me, log_id(ob)+"的天籁频道被设定关闭10分钟。\n");
		}	
		}

	else {
		return notify_fail("指令格式: chblk <用户ID> <频道名称>\n");
	}
		
	return 1;
}
//string query_save_file() { return DATA_DIR + "channeld"; }

int help(object me)
{
write(@HELP

指令格式 : chblk <用户ID> <频道名称>
	   chblk <频道名称>

此命令将关闭某人的公用频道(包括私有频道)或关闭整个系统的某个频道。
<频道名称>：(10个常规类别)
rumor、chat、party、sale、wkz、music、sldh、new、bh或all。

如果不提供频道名，则显示某人当前的频道状态。
chblk all 将关闭一个人的所有公用频道。
注意：forever是比较严厉的惩罚，将关闭用户的所有公用和私聊频道
请谨慎使用。

chblk xyj 	将关闭整个系统的潭际频道。
chblk chat 	将关闭整个系统的聊天频道。
chblk music 	将关闭整个系统的天籁频道。
chblk party 	将关闭整个系统的门派频道。
chblk rumor 	将关闭整个系统的谣言频道。
chblk sldh 	将关闭整个系统的水陆大会频道。
chblk sale 	将关闭整个系统的摊贩叫卖频道。
chblk es 	将关闭整个系统的潭际飞梭频道。
chblk forever	将关闭整个系统的所有公用频道。

相关指令：unchblk，block

HELP
    );
    return 1;
}
