#include "city.h"

void create() {
  set("short", "金字镖局");
  set("long", "
一座建构宏伟的宅第之前，左右两座石坛中各竖一根两丈来高的
旗杆，旗杆顶飘扬青旗。右首旗上黄色丝线绣著一头张牙舞爪，
神态威猛的金龙，旗子随风招展，显得金龙更奕奕若生。左首旗
上绣著「" HIR "振远镖局" NOR "」四个黑字，银钩铁划，刚劲非凡。进门处两
排长凳，分坐著八名劲装结束的汉子，个个腰板笔挺，显出一股
英悍之气，真是好不威风。
");

  set("exits",
    ([
      "west": CITY "qinglong-e1",
      "east": CITY "biaoju2",
      "northwest": CITY "changan-bei",
      "southwest": CITY "qinglong-e2",
    ]));

  set("objects",
    ([
      CNPC "biaotou": 2,
    ]));


  set("outdoors", "CITY");
  set("no_clean_up", 0);
  setup();
}
