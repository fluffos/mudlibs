#include <allcity.h>
#include <room.h>

void create() {
  set("short", "茶窖");
  set("long",
    "\n你来到后堂的茶窖，茶窖里有几个大竹箩，里面装满了茶叶。这家\n"
    "茶坊它的历史已不下百年，因此茶楼的生意出奇的好。阵阵茶香使\n"
    "你不仅流连忘返。站在这里，你可以看到东侧的楼梯通往楼上的雅\n"
    "座，不时能听到上面传来丝竹之声和阵阵笑声...\n"
  );

  set("exits", ([
    "south": CITY_ROOM "chaguan",
    "eastup": CITY_ROOM "chaguan3",
  ]));

  set("objects", ([
    //          "/d/qujing/xuanyuan/npc/liuer" : 1,
  ]));

  create_door("south", "木雕门", "north", DOOR_CLOSED);

  set("no_kill", 1);
  set("indoors", "长安城");

  setup();
}
