#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "拱猪房");
  set("long", @LONG

这间房子是专门为了拱猪用而设的，整间屋子都是用不去皮的松树搭成。
一张石桌 (table)周围摆着四个石礅，桌面镶了一块大理石，摸上去极为
光滑。四壁挂着长明灯，把屋子照得有如白昼。墙角里烧了一炉不知名的
香，似乎颇有提神之效。香炉旁边挂着张告示(gaoshi)，上面写着这里的
规矩；桌上有张小纸条(note)，上面草草的记着拱猪成绩。
LONG);

  set("item_desc", ([ "note": "因为赌场亏本，无法继续营业，暂时关闭。\n" ]));

  set("exits", ([
    "south": __DIR__ "club3",
  ]));

  set("no_clean_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  set("objects", ([
    //	  __DIR__"obj/haiwan": 1,
  ]));

  setup();

}
