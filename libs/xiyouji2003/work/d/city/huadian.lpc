#include "city.h" 
void create()
{
        set("short", HIM"馨儿花店"NOR);
                set("long", "
                 "HIR"@"HIG">>->-"HIR"@"HIG">>->--"HIR"@"HIG">>"NOR"
                 "HIR"@"BRED""HIY"  鲜  花  店  "NOR""HIR"@"NOR"
                 "HIR"@"HIG">>->-"HIR"@"HIG">>->--"HIR"@"HIG">>"NOR"
"BRED""YEL"◎≡◎"NOR"                                        "BRED""YEL"◎≡◎"NOR"
"BRED""YEL"‖"HIY"馨"NOR""BRED""YEL"‖"NOR"这里是新近开张的一家鲜花店，店内百花齐放"BRED""YEL"‖"HIY"亲"NOR""BRED""YEL"‖"NOR"
"BRED""YEL"‖"HIY"儿"NOR""BRED""YEL"‖"NOR"清香满室。花儿虽非名种，却也朵朵娇艳欲滴"BRED""YEL"‖"HIY"亲"NOR""BRED""YEL"‖"NOR"
"BRED""YEL"‖"HIY"欢"NOR""BRED""YEL"‖"NOR"她们是期待、是问候、是默默的祝福、深深的"BRED""YEL"‖"HIY"鲜"NOR""BRED""YEL"‖"NOR"
"BRED""YEL"‖"HIY"迎"NOR""BRED""YEL"‖"NOR"思念，小姑娘馨儿手持花洒，在花间轻轻走动"BRED""YEL"‖"HIY"花"NOR""BRED""YEL"‖"NOR"
"BRED""YEL"‖"HIY"您"NOR""BRED""YEL"‖"NOR"精心照料着鲜花。门边有张的告示（gaoshi）"BRED""YEL"‖"HIY"店"NOR""BRED""YEL"‖"NOR"
"BRED""YEL"‖Ⅴ‖"NOR"                                        "BRED""YEL"‖Ⅴ‖"NOR"
        ");
        
        set("no_fight", 1);
        set("exits", ([
  "south"   : CITY"zhuque-w1",
                        ]));
             set("item_desc", ([
                        "gaoshi":
                    "┌──────────────"+HIG"购花须知"NOR+"─────────────────┐\n"
                        "│ 一：花店里花儿的价格用（list)查看，买花可直接向店主购买（buy)        │ \n"
                        "│ 二：本鲜花店提供送花，详情请向小馨儿查询(ask xin er about songhua)   │ \n"
                        "│ 三：请用(help flower)来查询花朵含义和资料。                          │ \n"
                        "│ 四：请勿在此使用任何带有挑衅攻击性的指令，否则后果自负。             │ \n"
                        "└───────────────────────────────────┘ \n\n"
                        ]) );
        set("objects", ([
   CNPC"hua_girl"   : 1, 
        ]));
            set("no_fight",1);
            set("no_sleep",1);
            setup();

}
void init()
{
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_perform","perform");
}
void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();

       message_vision("$N准备跟馨儿比划比划，结果被一群官兵上来麻利的把$N捆了个结实，押着就走。\n",who);
	who->move("/d/city/laofang");
     return 1;
}

int do_kill(string arg)
{
  object who = this_player();

message_vision("$N刚准备行刺馨儿，不料旁边闪出一群大内侍卫来。\n$N吓的胆都破了，连忙对着馨儿鞠了个躬，结果还是被押了下去。\n",who);
	who->move("/d/city/laofang");

    return 1;
}
int do_perform(string arg)
{
  object who = this_player();

message_vision("$N猪蹄又发痒了，结果被馨儿一个佛山无影脚踹到一边去了。\n",who);
	who->move("/d/city/center");

    return 1;
}
int do_cast(string arg)
{
  object who = this_player();

  message_vision("$N对着馨儿结结巴巴的念了几句咒语，馨儿立马给了$N一个大嘴巴。\n",who);

  return 1;
}
int do_steal(string arg)
{
  object who = this_player();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();

  message_vision("$N想祭法宝，前思后想，还是没敢。\n",who);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  message_vision("$N掏出暗器，看了看你老娘馨儿，信心不足，又把暗器收了起来。\n",who);

  return 1;
}
