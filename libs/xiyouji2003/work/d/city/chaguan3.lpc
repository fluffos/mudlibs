#include <allcity.h>

void create()
{
	set("short", "茶楼雅座");
	set("long",
"\n这是茶楼的二层，附近的文人墨客常喜欢在此品茗作赋。里首摆着个棋盘。\n"
);
        set("exits", ([
           "down"  : CITY_ROOM"chaguan2" 
	]) );

	set("objects", ([
                "/d/city/npc/chess_player" : 1,
	]) );

	set("indoors", "长安城");

	setup();
}


