inherit ITEM;
#include <ansi.h>

void create() {
  set_name(CYN "灰烬" NOR, ({ "ash" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "堆");
    set("no_get", 1);
    set("long", "一堆带着余火的灰烬。\n");
    set("value", 50);
  }
}
