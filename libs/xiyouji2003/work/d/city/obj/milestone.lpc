inherit ITEM;
#include <ansi.h>

int do_read(string arg);
void create() {


  set_name("‖封神榜‖" NOR, ({ "dhxy" }));

  set("unit", "本");
  set("long", "这是一块用来纪录大话西游成名人物的石碑，伴随着访仙求道的
风风雨雨，岁月的流逝，石碑依旧。而上的名字却换了
一代又一代。石碑上刻录着：

               1：大话西游十大富豪
               2：大话西游十大解迷高手
               3：大话西游十大P K 狂魔
               4：大话西游十大N K 高手
               5：大话西游十大武学高手
               6：大话西游十大道行高手
               7：大话西游十大内力高手
               8：大话西游十大美女
               9：大话西游十大老前辈
              10：大话西游十大TASK高手
                                           
你可以用(read 标号)来翻看记载。\n");

  set("material", "steel");
  set_weight(8888888);
  setup();
}

void init() {
  add_action("do_read", "read");
}

int do_read(string arg) {
  string str;
  if (!arg || arg == "")
    return notify_fail("你要阅读哪一项排行？\n");
  switch (arg) {
    case "1": arg = "rich"; break;
    case "2": arg = "quests"; break;
    case "3": arg = "pker"; break;
    case "4": arg = "nker"; break;
    case "5": arg = "exp"; break;
    case "6": arg = "dx"; break;
    case "7": arg = "force"; break;
    case "8": arg = "per"; break;
    case "9": arg = "age"; break;
    case "10": arg = "task"; break;
    default: arg = "none"; break;
  }
  str = "/adm/daemons/toptend"->topten_query(arg);
  write(str + "\n");

  return 1;
}
