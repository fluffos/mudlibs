#include "city.h" 
void create ()
{
        set ("short", "长安府公堂");
        set ("long", "

长安府大堂之上有一种威严之势，不由让你心惊胆颤。前方一张
红木大桌，上有一幅大匾，写着“"HIR"廉明清正"NOR"”后面坐着知府大人。
四个烫金大字。桌旁站立着一位老师爷。
");
        set("exits",
        ([ 
  "south"   : CITY"yamen",
        ]));
        set("objects",
        ([ 
   CNPC"yayi"   : 6,
   CNPC"laoye"   : 1,  
        ]));
   set("no_clean_up", 0);
        setup();
}
