#include "city.h" 
void create ()
{
        set ("short", "背阴巷");
        set ("long", @LONG

背阴巷位于长安城之西南，住户大多是些贫苦人家。由于官府很少管
这里，所以治安并不十分好。周围民居破落，路边杂草丛生，到处是
沉闷的灰色，不见一丝生机。来往的人大多是衣衫褴褛，满面愁色。
西边有家杂货铺，东边就到了朱雀大街。
LONG);
        set("exits", 
        ([ 
  "south"   : CITY"minju4",
  "southeast"   : CITY"changan-nankou",
  "northwest"   : CITY"beiyin4",
        ]));

        set("objects", 
        ([ 
   CNPC"luren"   : 1, 
        ]));


        set("outdoors", "CITY");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}


