#include "city.h"

void create() {
  set("short", "男茅厕");
  set("long",

    "\n公厕通风良好，干净清爽。几个带盖的白玉小马桶整齐地排列在墙边。\n" +
    "每个马桶上还有一个挂钩，好象是可以挂在扁担上的。墙上挂着一个\n" +
    "马鬃木刷还正在滴着水。在这里可以 " HIR "(fangbian) \n" NOR);

  set("no_fight", 1);
  set("no_magic", 1);
  set("freeze", 1);
  set("fangbian_room", 1);
  set("no_qmdj", 1);

  set("exits", ([
    "east": CITY "droproom",
  ]));

  set("objects", ([
    "/d/obj/misc/faint": 1,
    CNPC "fly": 2,
  ]));

  set("no_clean_up", 0);

  setup();

}
