inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "铁匠铺" NOR);
  set("long", @LONG

这里是一间打铁铺子，从火炉中冒出的火光将墙壁映得通红，屋子的
角落里堆满了象斧子、铁锤、长剑等各式铁器，叮叮当当的声音敲得
满屋子响。

LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "dongmen",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/work": 1,
    ]));

  set("no_get_from", 1);
  set("no_kill", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_clean_up", 0);
  set("no_magic", 1);

  setup();
  replace_program(ROOM);
}
