#include <allcity.h>

void create()
{
   set("short","长安南口");
   set("long",@LONG

朱雀大街的东尽头，一根三丈多高的旗杆之上，挑起了四盏斗大
的灯笼，每当暮色降临，这里灯火通明。南面是袁氏草堂，里面
隐隐传来一些前来求卦人的念叨声。北方通向青龙大街。
LONG);

	set("exits", ([
            "south" : CITY_ROOM"caotang",
            "north" : CITY_ROOM"qinglong4",
//            "northwest" : "/d/room/xiaoyuan",
            "southeast" : CAE_ROOM"wangnan5",
            "west" : CITY_ROOM"zhuque-e3",
            "east" : CITY_ROOM"minju7",
	]));

	set("objects", ([
	    CITY_NPC"youxia" : 1,
	]));

	set("outdoors", "长安城");
	setup();
	replace_program(ROOM);
}
