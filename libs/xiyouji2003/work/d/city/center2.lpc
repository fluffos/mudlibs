#include <allcity.h>

void create ()
{
        set ("short", "长安钟楼");
        set ("long", @LONG

一座巍峨高大的钟楼耸立于前，很是有些气势。每到清晨，响
亮的钟声便会伴着淡淡雾气传向长安城的大街小巷。路口车水
马龙，来往人潮不断。
LONG);

        set("exits", ([ 
		"west"   : CITY_ROOM"xuanwu-e3",
		"east"   : CITY_ROOM"xuanwu-e4",
		"north"   : CITY_ROOM"beichengmen",
		"south"   : CITY_ROOM"beian-dadao1",
	  "southwest"  : CITY_ROOM"misc/y8",
	  "southeast"  : CITY_ROOM"misc/y7",
	  "northwest"  : CITY_ROOM"misc/y6",
	  "northeast"  : CITY_ROOM"misc/y5",
        ]));

        set("objects", ([ 
		CITY_NPC"luren"   : 2,
		CITY_NPC"youke"   : 2, 
       	WAI_OBJ"weapontop":1,
        ]));

       set("outdoors", "长安城");
	set("no_clean_up", 0);
       setup();
	replace_program(ROOM);
}

