// Update by waiwai@2002/12/05

#include <allcity.h>

void create() {
  set("short", "董记货行");
  set("long", @LONG

这是一家生意兴隆的货行。董老板坐在柜台后面笑容可鞠地接待
着客人。活计们在一边忙忙碌碌地工作着。如果你身无分文，你
还可以在这里向丰老板打一些零工，以赚一些钱。粮店的墙上贴
着一张破旧的告示(gaoshi)。
LONG);

  set("item_desc", ([
    "gaoshi": "现在正紧缺人手，急需雇佣一批短工来干活。 work	开始工作。\n",
  ]));

  set("exits", ([
    "north": CITY_ROOM "changan-nankou",
  ]));

  set("objects", ([
    CITY_NPC "dong": 1,
  ]));

  set("no_magic", 1);
  set("no_fight", 1);
  set("NONPC", 1);

  set("no_clean_up", 0);
  setup();
}


void init() {
  add_action("do_work", "work");
}

int do_work(string arg) {
  object me;

  me = this_player();

  if (sizeof(filter_array(
    all_inventory(this_object()),
    (: userp :))) > 3) {
    message_vision("董老板笑眯眯地对$N说：" +
      "真对不住，人手已经够了。\n", me);
    return 1;
  }

  if (me->is_busy()) return notify_fail("你正在忙着呢。\n");

  if (!me->query_temp("working_in_huohang")) {
    message_vision("$N从车上卸下一包包货物，又垒在墙边，累的腰酸腿疼！\n", me);
    me->add("kee", -30);
    me->add("sen", -30);
    me->set_temp("working_in_huohang", 1);
    call_out("reset_work", 1 + random(10), me);
    me->start_busy(10);
  } else {
    message_vision("丰老板赶紧把$N扶起来：先歇一会儿。\n", me);
  }
  return 1;
}

void reset_work(object me) {
  object ob;

  if (!me) return;

  me->set_temp("working_in_huohang", 0);
  me->start_busy(1);
  ob = new("/obj/money/silver");
  ob->move(me);
  message_vision("董老板笑眯眯地对$N说：辛苦啦，这是你的工钱。\n", me);
}
