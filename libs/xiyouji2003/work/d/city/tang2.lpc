#include <allcity.h>

void create()
{
        set("short", "化尸堂");
        set("long", @LONG

三花堂已经买通官府，官府对三花堂的所作所为大都视而不见。
但三花堂仇家众多，为铲除异己而双手血腥。此处正是焚烧罪
状和尸体的大堂。两人高的青铜炉火焰正盛。一股焦尸的恶臭
弥漫了整个大厅[1;31m (burn)[0m
LONG
        );
        set("exits", ([ 
  	"north" : CITY_ROOM"sanhua",
	]));
	setup();
}

void init()
{
	add_action("do_burn","burn");
}

int do_burn(string arg)
{
	object me;
	object tar;
	int score, pot;
	me = this_player();
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
	if( !arg || arg == "") 
                return notify_fail(CYN"你要烧什么东西？\n"NOR);
	tar = present(arg, me);
	if( !tar) 
		return notify_fail(CYN"你身上没有这东西．\n"NOR);
	if( userp(tar))
		return notify_fail(CYN"你不可烧活的东西．\n");

	if( tar->query("owner"))
		return notify_fail(CYN"你不可烧订的东西．\n"NOR);

	if( tar->is_corpse()) {
		me->set("combat_exp", (int) score + 1);
		me->set("potential", (int) pot + 1);
	message_vision(HIR"$N将$n"HIR"投入了青铜炉，$n"HIR"转眼化为灰烬......\n", me, tar);
	me->start_busy(1+random(2));
	tar->move(environment(me));
	destruct(tar);

	} else return 0;


	return 1;
}
