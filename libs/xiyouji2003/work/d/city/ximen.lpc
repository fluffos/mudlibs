#include <allcity.h>

string look_gaoshi();
string long_desc();
void timepass();

void create() {
  set("short", HIY "长安城西门" NOR);
  set("long", (: long_desc :));

  set("item_desc", ([
    "告示": (: look_gaoshi :),
    "gaoshi": (: look_gaoshi :),
  ]));

  set("exits", ([
    "west": CAW_ROOM "west1",
    "east": CITY_ROOM "changan-xikou",
  ]));

  set("objects", ([
    CITY_NPC "wujiang": 1,
    CITY_NPC "bing": 3,
  ]));

  set("outdoors", "长安城");
  setup();
  timepass();
}

string look_gaoshi() {
  return "\n\t\t  告    示

 由于近日长安西野羊山野羊寨悍匪横行，皇上有旨：
 为保百姓平安，每晚关闭西门不得任何人进出！

\t\t\t\t     大唐长安府
\t西游记丙辰年十一月二十二日未时三刻 冬初\n";
}

void timepass() {
  string time;

  time = NATURE_D->outdoor_room_event();

  switch (time) {
    case "event_night":
    case "event_midnight":
      if (!query("close_door")) {
        message(
          "system",
          YEL "\n┋" RED "长安近卫" YEL "┋守城武将：唐皇有旨，由于长安西野羊山悍匪横行，每晚西门紧闭不得随意进出！\n" NOR,
          users()
        );
        tell_room(this_object(), "天黑了，守城官兵吱呀呀地把城门关上了。\n");
        set("close_door", 1);
      }
      break;

    case "event_dawn":
      if (query("close_door")) {
        message("system", YEL "\n┋" RED "长安近卫" YEL "┋守城武将：天光放亮，西门开启！！！\n" NOR, users());
        tell_room(this_object(), "天亮了，城门被守城官兵打开了。\n");
        delete("close_door");
      }
      break;
    default: break;
  }
  remove_call_out("timepass");
  call_out("timepass", 60);
}

string long_desc() {
  string msg;

  if (day_event() == "event_night" || day_event() == "event_midnight") {
    msg = BLU
      "\n                         s________________s          " HIW "●" NOR BLU "
                        /LLLLLLLLLLLLLLLLLL\\        
    []__[]             ^^||======||======||^^             []__[]
    []==[]_[]__[]__[]__[]||[]__[]||[]__[]||[]__[]__[]__[]_[]==[]
    []==[]|__|__|__|__|__|__|┏━━━┓_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_┃" YEL "长安城" BLU "┃__|__|__|__|__|__|_[]==[]
    []==[]|__|__|__|__|__|__|┗━━━┛_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|__/  |   \\__|__|__|__|__|__|__[]==[]
    []==[]|__|__|__|__|__|__||   |    |_|__|" RED "告示" BLU "_|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_| 。| 。 |__┌┐┌┐_|__|__|_[]==[]
    []==[]_|__|__|__|__|__|__|   |    |_|└┘└┘|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_| " CYN " 关闭" BLU "  |__|__|__|__|__|__|_[]==[]
    []==[]_|__|__|__|__|__|__|___|____|_|__|__|__|__|__|__[]==[]\n" NOR;

  } else

    msg = "\n                         s________________s         
                        /LLLLLLLLLLLLLLLLLL\\        
    []__[]             ^^||======||======||^^             []__[]
    []==[]_[]__[]__[]__[]||[]__[]||[]__[]||[]__[]__[]__[]_[]==[]
    []==[]|__|__|__|__|__|__|┏━━━┓_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_┃" HIC "长安城" NOR "┃__|__|__|__|__|__|_[]==[]
