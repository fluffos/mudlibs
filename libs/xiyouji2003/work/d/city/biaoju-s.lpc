#include "city.h"

void create() {
  set("short", "振远镖局内院");
  set("long", "

院子里面堆放着十几辆用草席盖着的空镖车，草席上积满了厚雪
东面的屋檐下，斜插着一面酱色镶金边的镖旗，被风吹得蜡蜡作
响，使人几乎分辨不出用金线绣在那上面的是老虎，还是狮子。
大院里不时镖师进出。
");

  set("exits",
    ([
      "north": CITY "biaoju2",
    ]));

  set("objects",
    ([
      CNPC "biaotou": 2,
    ]));


  set("outdoors", "CITY");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
