#include <allcity.h>

void create() {
  set("short", "吉祥杂货铺");
  set("long", @LONG

不知为什么西城虽大，却只有这一间杂货铺。所以每天人来人往
也挺热闹。这里无论是油盐酱醋，还是大米白面，样样齐全。屋
里打扫的也十分干净，魏老板在和几位客人说说笑笑。
LONG);


  set("exits", ([
    "south": CITY_ROOM "zhuque-e2",
  ]));

  set("objects", ([
    CITY_NPC "laowei": 1,
    CITY_NPC "laotou": 1,
    DXS_NPC "xunshi-out": 1,
  ]));

  set("area", "吉祥杂货铺");
  set("lead_S", 1);

  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
