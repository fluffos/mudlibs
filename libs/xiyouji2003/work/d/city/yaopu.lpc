int valid_leave(object me, string dir)
{
    object ridee;
    ridee=me->ride();

   if( wizardp(me)) return 1;

   if( dir=="west" && !userp(me))
	return 0;

   if (dir=="west") {
       if( me->query_temp("ridee") )
        return notify_fail(WHT"你还是先从坐骑上下来吧。\n"NOR);
            }

	me->set_temp("enter_time",time());

     return ::valid_leave(me, dir);
}

