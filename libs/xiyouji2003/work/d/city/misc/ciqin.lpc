  set("short", "刺青馆");
  set("long", @LONG

这里是天下第一刺青师慈易针在长安城开的刺青馆，门口高挂一副牌
匾（ｂｉａｎ），旁边还有两句诗句（ｐｏｅｍ），里面打扫得一尘
不染，旁边还有个架子上面放着一些瓶瓶罐罐。
LONG);

  set("item_desc", ([
    "bian": HIY "         《  天  下  第  一  》\n" NOR,
    "poem":
    "    ＊＊＊＊＊＊＊＊＊＊＊＊＊＊\n"
    "    ＊   文  身  老  及  幼   ＊\n"
    "    ＊   川  浴  女  同  男   ＊\n"
    "    ＊＊＊＊＊＊＊＊＊＊＊＊＊＊\n"
  ]));


  set("exits",
    ([  //sizeof() == 4
    "east": "/d/city/club",
    ]));

  set("no_bid", 1);
  set("NONPC", 1);
  set("no_bian", 1);
  set("no_magic", 1);
  set("objects",
    ([  //sizeof() == 1
    "/d/city/misc/npc/ci": 1,
    ]));

  setup();
  replace_program(ROOM);
}
