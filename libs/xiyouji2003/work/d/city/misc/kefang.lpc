inherit ROOM;

void create ()
{
  set ("short", "客房");
  set ("long", @LONG

这儿是春和楼的客房，是用来招待客人们休息的地方，奇怪的是这儿
对新手不收取休息费，往来的人们可以随意到这儿来睡觉。
LONG);

	set("exits", ([ 
	"down" : __DIR__"xfh",
	]));

       set("freeze",1);
//	set("no_get_foom",1);
	set("no_fight", 1);
	set("no_magic", 1);
	set("freeze",1);
	set("NONPC",1);
	set("no_clean_up",1);
	set("sleep_room",1);

