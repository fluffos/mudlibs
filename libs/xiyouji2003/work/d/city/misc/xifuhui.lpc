#include <allcity.h>

void create ()
{
        set ("short", HIR"春和楼大堂"NOR);
        set ("long", @LONG

这里正在举行一个喜宴，堂内张灯结彩，台上高点红烛，一些歌女舞
娘正随乐而舞，四五个小伙计麻利的上菜送酒。周围坐满了前来祝贺
的客人，热闹非凡。
LONG);

       set("exits", ([
		"north" : CITY_ROOM"misc/xfh",
		"down" : CITY_ROOM"misc/chufang",
       ]));

       set("objects", ([
		CITY_NPC"xiaom" : 1,
		CITY_NPC"guanshi" : 1,
       ]));

	set("no_fight", 1);
	set("no_magic", 1);
	set("freeze",1);

       setup();
	replace_program(ROOM);
}


