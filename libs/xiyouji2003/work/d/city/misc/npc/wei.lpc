// Update by waiwai@2003/04/25

#include <ansi.h>;
inherit NPC;
void create()
{
        set_name(HIM"韦春芳"NOR, ({ "wei chunfang", "chunfang", "wei" }) );
        set("gender", "女性" );
        set("title", HIG"丽春院老板娘"NOR);
        set("age", 42);
        set("long", "韦春芳是长安城唯一的妓院的老鸨子，虽是徐娘半老，但风韵犹存。\n");
        set("str", 25);
        
        set("con", 25);
        set("int", 25);
        set("shen_type", 1);

        set_skill("unarmed", 20);
        set_skill("force", 20);
        set_skill("dodge", 35);

        set("combat_exp", 25000);

        set("max_sen", 300);
        set("max_kee", 100);
        set("force", 500);
        set("max_force", 500);

        set("attitude", "friendly");
        set("inquiry", ([
            "name"   : "老娘我就是韦春芳。",
            "丽春院" : "我们丽春院可是长安城里头一份的找乐子去处。",
            "here"   : "我们丽春院可是长安城里头一份的找乐子去处。",
        ]) );

        setup();
        set("chat_chance", 5);
        set("chat_msg", ({
                "韦春芳得意地说道：当年老娘我标致得很，每天有好几个客人。\n",
                "韦春芳对你说道：你一双眼睛贼忒嘻嘻的，真像那个喇嘛！\n",
        }) );

        carry_object("/d/city/misc/npc/flower_shoe")->wear();
        carry_object("/d/city/misc/npc/pink_cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_sell", "sell");
}

void greeting(object me)
{
	command("look " + me->query("id"));

	if(wizardp(me)) return 0;

	if (me->query("age")<18) {
       command(CYN"say 你当老娘是那么没人性吗？辣块妈妈，老娘满汉蒙藏回都接，就是不伺侯小毛孩！\n"NOR);
       command("kick " + me->query("id"));
       message("vision", me->name() +CYN"被韦春芳一脚踢出门外。\n"NOR,
                environment(me), ({me}));
       me->move("/d/city/droproom");
	me->unconcious();

	CHANNEL_D->do_channel( this_object(), "xiaodao",
     sprintf("%s被人从"HIR"丽春院"NOR WHT"里踢了出来，栽倒在垃圾场的地上，磕掉两颗"HIW"门牙" NOR, me->name()+"("+capitalize(me->query("id")) + ")") );
   UPDATE_D->check_me(me);
	} else {
    if (me->query("class") =="bonze") {
       command("say 呦，" + RANK_D->query_respect(me)
                +"也来光顾我们丽春院啊。");
       command("say 想当年我接过一个西藏喇嘛，他上床前一定要念经，一面念经，
眼珠子就骨溜溜的瞧着我。");
    }
    if (me->query("gender")=="女性") {
       command("say 哎呀，这年月大姑娘也逛窑子，成何体同。");
       command("sigh");
       command("say 可惜我儿子不在，不然让他伺候你。");
    }
    command("say 楼上楼下的姑娘们，客人来了！");
    }
    return ;
}

int do_sell(string arg)
{
	object ob, myenv, who;
	int value;
	object *inv;
	
    string* name1s = ({
       "小", "春", "夏", "秋", "冬", "月" });
    string* name2s = ({
       "红", "兰", "月", "翠", "莲", "荷", "叶", "花", "蝶" });
    string* name3s = ({
       "姐姐", "妹妹", "姑娘" });
    string nick;

	if (!arg || !(ob = present(arg, this_player())))
	       return notify_fail("你要卖谁？\n");

	if (!ob->is_character())
		return notify_fail("这你得卖到当铺去。\n");

	if (!userp(ob))
	       return notify_fail("老娘只召玩家做妓女。\n");

	if (userp(ob) && ob->query("combat_exp")<1000000 )
		return notify_fail("依老娘看你所卖这人太水，不要不要。。。\n");

	if (userp(ob) && ob->query("gender") == "男性" )
		return notify_fail("你想找死啊，拿个破男人给我，老娘这有的是男人，一边玩去。。。\n");

	if (userp(ob) && ob->query("LC_sell") >2 )
		return notify_fail("这人已经被卖过好多次了，已经不值钱了，老娘不要。。。\n");

//	if( query_ip_number(this_player()) == query_ip_number(ob))
//		return notify_fail("自己卖自己？实在是发财有道了。\n");

	if (ob->query_condition("prostitute") > 1)
		return notify_fail("这人已经是老娘的人了。你还敢来骗钱？\n");

	ob->set("value", ob->query("per") * 5000);

	value = ob->query("value");

	if(ob->query("per")>35 && ob->query("age")<30) ob->set_temp("top_girl",1);

	message("channel:rumor",
	WHT"【"HIR"小道消息"NOR WHT"】听说："+log_id(ob)+"被"+log_id(this_player())+
	"拐卖到丽春院了，不多不少，正好" +MONEY_D->money_num(ob->query("value")) + "\n"NOR, users());

	message_vision("$N把" + ob->query("name") + "卖给韦春芳。\n", this_player());
	this_player()->set("sell_woman/" + ob->query("id"), 1);
//	MONEY_D->pay_player(this_player(), value * 70 / 100);

	MONEY_D->pay_player(this_player(), value);
	myenv = environment (this_player());

	tell_room(myenv,"韦春芳开心大笑：老娘要发财了。\n");
	nick = name1s[random(sizeof(name1s))] + name2s[random(sizeof(name2s))]
           + name3s[random(sizeof(name3s))];
	if (ob->query("age")<18)       
        ob->set("title",WHT"丽春院新人"NOR);
	else if (ob->query("age")<25)
        ob->set("title",HIG"丽春院头牌"NOR);
	else if (ob->query("age")<45)
        ob->set("title",HIM"丽春院皇后"NOR);
	else ob->set("title","丽春院教师");
	if( ob->query_temp("top_girl") ) {
	ob->set("title",HIR"丽春院花魁"NOR);
	ob->delete_temp("top_girl");
	}

	ob->set("nickname",nick);
	message("channel:rumor",
	HIR"【丽春院】"HIC"韦春芳(wei chunfang)：我们"HIR"丽春院"HIC"新来了「"+nick+ "」"HIM+log_id(ob)+HIC"，欢迎各位大爷光顾！\n"NOR, users());

	ob->move("/d/city/misc/lichunyuan2");
	ob->set("startroom","/d/city/misc/lichunyuan2");
	ob->apply_condition("prostitute", 600);
	ob->set_temp("selled");
	ob->add("LC_sell",1);
//	ob->set("class", "prostitute");
	ob->start_busy(50);
	return 1;
}

