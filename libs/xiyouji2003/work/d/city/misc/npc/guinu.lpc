int accept_object(object me, object obj) {
  if (obj->query("money_id")) {
    if (me->query_condition("prostitute") > 0) {

      if (obj->value() >= me->query("combat_exp") * 2) {
        //        if (obj->value()<= me->query("combat_exp"))  {  
        command("say 好吧，人各有志，你要从良我也不勉强，找个好人家嫁了吧。我们大家会想你的。");
        command("cry " + me->query("id"));
        me->set("title", me->query("family/family_name") + "第" +
          chinese_number(me->query("family/generation")) +
          "代弟子");
        command("bye " + me->query("id"));
        me->delete("hooker");
        me->clean_condition("prostitute");
        me->set("startroom", "/d/city/kezhan");

        return 1;
      }

      else {
        command("say 谢谢" + me->query("nickname") + "赏钱。");
        command("bow " + me->query("id"));
        return 1;
      }
    } else {
      command("say 谢谢赏钱。");
      command("bow " + me->query("id"));
      return 1;

    }

  } else return 0;
}

int ask_give(object ob) {
  object tear;
  object me = this_object();
  ob = this_player();

  if (ob->query_condition("prostitute") > 1 || wizardp(ob)) {
    message_vision(
      CYN "$N对$n说道：" + MONEY_D->money_num(ob->query("combat_exp") * 2) + "就放你走！\n" NOR,
      me,
      ob
    );
    command("heihei " + ob->query("id"));
    return 1;
  } else {
    message_vision(WHT "\n$N说道：一边玩去，瞎问的什么，又不是你被卖了。。。\n" NOR, me);
    command("slap");
    return 1;
  }
  return 1;
}
