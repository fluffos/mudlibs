#include <allcity.h>

void create ()
{
  set ("short", HIY"春和楼"NOR);
  set ("long", @LONG

这儿是长安城中最有名的春和楼，说是最有名但也不大，只有小小的几
个店面，一个和气的店小二站在店门口，他笑脸相迎每一个来往的客人。
因为这儿的人没有高低贵贱，人人都是靠自己的劳动过活。不劳动是可
耻的行为。店铺前旁边的墙上挂了一个小小的招牌[1;31m（paizi）[0m
LONG);

	set("item_desc", ([ 
	  "paizi" : HBBLU HIY" 本店急需工作人员，有意者请 ask er about work \n\n"NOR,
	]));

	set("objects", ([ 
		CITY_NPC"xfhxiaoer" : 1,
	]));

	set("exits", ([
	  "south" : CITY_ROOM"misc/xifuhui",
	  "north" : CITY_ROOM"xuanwu-e6",
	  "up" : CITY_ROOM"misc/kefang",
	]));

	set("no_fight", 1);
	set("no_magic", 1);
	set("no_ridee", 1);
	set("NONPC", 1);
	set("freeze",1);

	setup();
}

int valid_leave(object me, string dir)
{
	if( wizardp(me) ) return 1;

        if ( !me->query_temp("rent_paid") 
	&& dir == "up" && me->query("daoxing")>100000)
        return notify_fail(MAG"小二满脸堆笑地挡住了你：对不起，你道行过高，不能进去休息。\n"+NOR);

        return ::valid_leave(me, dir);
}
