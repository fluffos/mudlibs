inherit ROOM;
#include <ansi.h>
string look_pai();

void create()  
{
	set("short", "丽春院");
	set("long", @LONG

你一走进来，一眼就看到大厅的墙上挂着一幅幅春宫图，一下子就
明白了这是什么地方。厅内到处张灯结彩，香气扑鼻。几名打扮得
妖里妖气的女人分站两旁对你发出媚笑。主人韦春芳上上下下、前
前后后招呼着客人。从楼上传来了阵阵打情骂俏的声音。进门的墙
上挂着一幅铭牌(paizi)，标明着正在待侍客人的姑娘的名单。
[1;35m
		   春   色   无   边[2;37;0m
LONG 
	);
	set("item_desc" , ([
		"down": "那里黑咕隆咚，什么也看不清楚。\n",
	]));

	set("item_desc", ([
		"paizi" : (: look_pai :),
	]));

	set("objects", ([
                __DIR__"npc/wei" : 1,
                __DIR__"npc/xiang" : 1,
	]));
	set("no_clean_up", 1);

	set("exits", ([
		"north" : "/d/city/club",
             	"up" : __DIR__"lichunyuan2",
             	"down" : __DIR__"lichunyuan3",

	]));
	set("no_clean_up", 0);
        set("no_fight", "1");
        set("no_steal", "1");
        set("no_book", "1");
        set("no_magic", "1");
        set("NONPC", "1");

	setup();
}

int valid_leave(object me, string dir)
{
	if(wizardp(this_player())) return 1;

        if (dir == "north" && this_player()->query_temp("selled")>0) {
		tell_object(me,HIW"你接客期满自由了。。。\n"NOR);
	 me->set("title",me->query("family/family_name")+"第"+
                chinese_number(me->query("family/generation"))+
                "代弟子");
       me->delete("hooker");
       me->delete_temp("selled");
	me->clean_condition("prostitute");
	me->set("startroom","/d/city/kezhan");
       me->delete("nickname");
                return 1;
	}

        if (dir == "down" && this_player()->query("age")<2000)
                return notify_fail(CYN"那不是你该去的地方！\n"NOR);
        return ::valid_leave(me, dir);
}

string look_pai()
{
	return FINGER_D->get_seller() + "

\t"FRTOP+NATURE_D->game_time()+NOR"\n";
}
