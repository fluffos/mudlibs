#include "city.h"

void create() {
  set("short", "玄武街");
  set("long", @LONG

玄武街是长安城北一条东西向的大道，街面宽敞洁净，街上十分
热闹，人来人往川流不息。大街的两旁商家云集，大大小小的店
铺比邻而立。北边是一家钱庄，可以听到叮叮当当的金银声音。
南边是一家妓院，不时的传来阵阵笑声。
LONG);

  set("exits",
