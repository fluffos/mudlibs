#include <allcity.h>

void create() {
  set("short", "商贾大路");
  set("long", @LONG

这里是通往长安货物集散地的大路，不时能看到一些商贾买卖之人
往来于这条大路与各地集散地之间采购所需之物。
LONG);

  set("exits", ([
    "north": CITY_ROOM "bhlu2",
    "south": CITY_ROOM "beichengmen",
  ]));

  set("objects", ([
    CITY_NPC "captor": 2 + random(3),
    "/d/penglai/npc/laitou": 1,
  ]));

  set("outdoors", "长安城");
  //	set("limitgo", 1);

  setup();
}
