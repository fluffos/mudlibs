#include "city.h" 
void create()
{
    set("short", "长安大牢");
    set("long", @long

这里是一间黑黝黝的牢房，专门用来关押作奸犯科之徒。空气中充斥
着一股腐臭，高高的铁窗透进一丝阳光，几只大老鼠若无其事地在你
身边穿来穿去，你想起你的所作所为，不禁后悔万分。
long
    );
    set("valid_startroom", 1);
    set("no_fight", 1);
     set("exits", ([ 
  "out"   : CITY"xunpufang",

]));
    set("objects", ([
        "/d/city/obj/jitui" : 3,
        "/d/moon/obj/jiudai" : 1,
    ]));
    setup();
}
void init()
{
    object ob;
    ob = this_player();
    ob->set("startroom","/d/city/laofang");
        remove_call_out("kick_ob");
    call_out("kick_ob",30);
}
void kick_ob()
{
    object room,*obj;
        int i;
        
        obj=deep_inventory(this_object());
        if (!sizeof(obj))   return;
        for (i=0;i<sizeof(obj);i++){
		if( wizardp(obj[i]) ) continue;
		if( !userp(obj[i]) && obj[i]->is_character())  { 
              message_vision(HIR"哐当一声，一个狱卒打开牢门，还想在这里白吃白喝？说完一脚把$N踢到了九霄云外！\n"NOR,obj[i]);
		obj[i]->move("/d/city/center");
              return;
		}

                if (interactive(obj[i]) && (time()-obj[i]->query_temp("summon_time"))>300){
                        message_vision(YEL"哐当一声，一个狱卒打开牢门对$N说，“算你走运，皇帝天下大赦，赶快收拾东西滚！\n"+NOR,obj[i]);
                if (!room=find_object("/d/city/caishikou") )
                                room=load_object("/d/city/caishikou");
                        obj[i]->move(room);
                        message("vision",WHT+"一个蓬头秽面，样似乞丐的家伙踉踉跄跄的走了过来。\n"+NOR,room,({obj[i]}));
                obj[i]->set("kee",-1);
                        tell_object(obj[i],HIR"由于蹲大牢长时间不见阳光，你感觉到头晕目眩，顿时脚下一个不稳…\n"NOR);
            obj[i]->set("startroom","/d/city/caishikou");
                    call_out("kick_ob",30);
                        return;
                }
        }
    call_out("kick_ob",100);
}
int valid_leave(object me, string dir)
{
	if( wizardp(me) ) return 1;	
    if ( userp(me) && !me->query_temp("dalao_out") && dir == "out" )
        return notify_fail(HIR"一个狱卒跑了过来对你左右开弓就是几巴掌，煽的你眼冒金星…\n"NOR);
       
        return ::valid_leave(me, dir);
}