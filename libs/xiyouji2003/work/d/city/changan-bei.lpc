#include <allcity.h>

void create() {
  set("short", "长安北口");
  set("long", @LONG

玄武街的东尽头，一根三丈多高的旗杆之上，挑起了四盏斗大的
灯笼，每当暮色降临，这里灯火通明。路口有长安巡逻兵在不停
的来回巡视，南面是青龙大街，里面隐隐传来一些喧闹的吆喝声
北方是一个养马场，远远还能听到马儿撕叫的声音。
LONG);

  set("exits", ([
    "west": CITY_ROOM "xuanwu-e6",
    "east": CITY_ROOM "minju9",
    "north": CITY_ROOM "machang",
    "southeast": CITY_ROOM "biaoju",
    "south": CITY_ROOM "qinglong-e1",
    "southwest": CITY_ROOM "tianjiantai",
  ]));

  set("objects", ([
    CITY_NPC "bing": 2,
  ]));


  set("outdoors", "长安城");
  set("no_clean_up", 0);

  setup();
}
