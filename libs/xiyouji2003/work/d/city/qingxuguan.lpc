#include "city.h"

void create ()
{
        set ("short", "清虚观");
        set ("long", @LONG

清虚观是长安城里着名的一座道观。由于唐朝的皇帝和道教宗祖
老子同姓，因此道教被奉为唐朝的国教。但由于佛教的传入，道
教的状况已大大不如以前。道观中已没有几个人了，但观内原有
的气势还没有变。香案上供着元始天尊、太上老君和灵官道君的
神像。不时有些进香客在此虔诚的膜拜，烧香。
LONG);

        set("exits", 
        ([ 
                "east" : CITY"qinglong-e2",
        ]));

        set("objects", 
        ([ 
                CNPC"daozhang" : 1,
		"/d/lingtai/npc/xiao" : 2,
        ]));


       set("no_clean_up", 0);
       setup();
       replace_program(ROOM);
}

