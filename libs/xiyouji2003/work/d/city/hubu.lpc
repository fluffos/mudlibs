#include <allcity.h>

string look_sign(object me);

void create() {
  set("short", HBRED HIW " 长安府户部大堂 " NOR);
  set("long", @LONG

你现在正站在户部大堂里，这里是专门替人更改名字和称呼的地方，
全国各地的豪杰们若是嫌自己的名字和称呼不够威风，都是到这里
来交钱更改。墙上挂着一块小牌子 [1;31m(pai) [0m
LONG);
  set("item_desc", ([
    "pai": HBBLU HIG " 更改称呼请用 " HIW "apply" HIG " 看具体用法。\n\n" + NOR
    HBBLU HIY " 更改中文名字格式为: newname <新名字> \n\n" + NOR
    CYN "请勿使用不恰当的名字。不然名字被取消，五千两金\n" +
    "子就白白扔了。至于恰当与否，则由系统管理员决定。\n\n" NOR
  ]));

  set("exits", ([
    "west": CITY_ROOM "yamen",
  ]));

  set("objects", ([
    CITY_NPC "wuji": 1,
  ]));

  set("no_bian", 1);

  setup();
}
