#include <allcity.h>

string look_gaoshi();
string long_desc();

void create() {
  set("short", HIY "长安城东门" NOR);
  set("long", (: long_desc :));

  set("item_desc", ([
    "缉": (: look_gaoshi :),
    "ji": (: look_gaoshi :),
  ]));

  set("exits", ([
    //                "west" : CITY_ROOM"changan-dong",
    "west": CITY_ROOM "dongkou",
    "east": KAIFENG "east1",
    //                "south" : CITY_ROOM"hubu",  
  ]));

  set("objects", ([
    CITY_NPC "wujiang": 1,
    CITY_NPC "bing": 3,
  ]));


  set("outdoors", "长安城");
  setup();
}

string look_gaoshi() {
  return FINGER_D->get_killer() + "\n长安知府  蔡建德(Cai zhifu)\n";
}

string long_desc() {
  string msg;

  if (day_event() == "event_night" || day_event() == "event_midnight") {
    msg = BLU
      "\n                         s________________s          " HIW "●" NOR BLU "
                        /LLLLLLLLLLLLLLLLLL\\        
    []__[]             ^^||======||======||^^             []__[]
    []==[]_[]__[]__[]__[]||[]__[]||[]__[]||[]__[]__[]__[]_[]==[]
    []==[]|__|__|__|__|__|__|┏━━━┓_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_┃" YEL "长安城" BLU "┃__|__|__|__|__|__|_[]==[]
    []==[]|__|__|__|__|__|__|┗━━━┛_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|__/       \\__|__|__|__|__|__|_[]==[]
    []==[]|__|__|__|__|__|__||        |_|__|" RED "缉" BLU "|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_|        |__┌┐┌┐_|__|__|_[]==[]
    []==[]_|__|__|__|__|__|__|        |_|└┘└┘|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_|  " CYN "东门" BLU "  |__|__|__|__|__|__|_[]==[]
    []==[]_|__|__|__|__|__|__|        |_|__|__|__|__|__|__[]==[]\n" NOR;

  } else

    msg = "\n                         s________________s         
                        /LLLLLLLLLLLLLLLLLL\\        
    []__[]             ^^||======||======||^^             []__[]
    []==[]_[]__[]__[]__[]||[]__[]||[]__[]||[]__[]__[]__[]_[]==[]
    []==[]|__|__|__|__|__|__|┏━━━┓_|__|__|__|__|__|__[]==[]
    []==[]__|__|__|__|__|__|_┃" HIC "长安城" NOR "┃__|__|__|__|__|__|_[]==[]
    []==[]|__|__|__|__|__|__|┗━━━┛_|__|__|__|__|__|__[]==[]
