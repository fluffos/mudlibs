//ROOM  /d/city/sleep.c
//Created by waiwai@2002/12/05

#include <allcity.h>
string long_desc();

void create() {
  set("short", "客店睡房");
  set("long", (: long_desc :));

  set("exits", ([
    "north": CITY_ROOM "kezhan",
  ]));

  set("objects", ([
    WAI_OBJ "bed": 2,
  ]));

  set("chat_room", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("indoors", "长安城");
  set("no_book", 1);

  setup();
}

string long_desc() {
  string msg;
  string get_month;

  get_month = CHINESE_D->chinese_month(TIME_TICK1);

  if (day_event() == "event_night" || day_event() == "event_midnight") {
    switch (get_month) {
      case "三":
      case "四":
      case "五":
        msg = "
春夜的长安城四处静谧。只有南城客栈等少有的几家通宵营业的
店面生意兴隆。身处在这后堂的客栈睡房里面，你不由得想马上
沉迷酣甜地睡去。\n";
        break;
      case "六":
      case "七":
      case "八":
        msg = "
春夜的长安城长街上经常有许多纳凉的人在絮语谈心。而南城客
栈更是通宵的喧嚣热闹。但这后堂的客栈睡房却别有一份宁静与
清凉，你不由得想象孩童般沉睡，睡中带着甜蜜的笑意。\n";
        break;
      case "九":
      case "十":
      case "十一":
        msg = "
秋日的夜晚总是静谧的。酣睡的孩童在梦里都会开心的笑。带着美
好的思绪，在这样的一个秋风爽肤的夜晚，躺在舒适的客栈睡房里
你不由得渐渐入梦……\n";
        break;
      case "十二":
      case "一":
      case "二":
        msg = "
冬夜的大街铺满了积雪。每当下雪的夜晚，便会格外的静谧，只有
雪花在默默地飘落着，似乎在不停地诉说着一个关于冬季的不为人
知的故事。而客栈睡房却暖意融融，和煦的感觉使你不由得感到在
其它的季节无法感觉到的幸福--那就是每个人都需要有一个温暖的
家，哪怕再小再小……\n";
        break;

    }
  } else
    switch (get_month) {
      case "三":
      case "四":
      case "五":
        msg = "
春天的风里总会让人不禁有着许多的希望的骐骥和缅怀之情。冬天
的寒冷已经是昨天的梦。似乎没有半点痕迹了。长安的春日年复一
年的依旧是繁华和忙碌的。白天的睡房里面零星的几个客人却都已
进入了梦乡，打鼾声似乎就象一首睡眠之歌。\n";
        break;
      case "六":
      case "七":
      case "八":
        msg = "
夏日的长安，知了在路旁树杈上拼命地嚎叫着。夏乏的感觉不由得使
人昏昏欲睡。睡房里四敞的窗户透近丝丝沁凉的感觉，伴着知了的摇
篮曲在白天里睡上一觉也是舒畅的。\n";
        break;
      case "九":
      case "十":
      case "十一":
        msg = "
秋日似锦的时光,时常有落叶随秋风而起。每到傍晚的时候经常有雅
兴诗人踯躅而过。客栈睡房开敞的窗户不时有几片秋叶被微风吹飘而
进，打在酣睡的客人的脸上。\n";
        break;
      case "十二":
      case "一":
      case "二":
        msg = "
冬日里的长街上，人们大多行色匆匆而过。或者寻求店家投宿，或者
匆忙的买卖购物而过。家，在这个季节里面总是温暖的。身处温暖舒
适的客栈睡房里，给人的感觉就是马上钻进被窝沉睡而去。\n";
        break;
    }

  return msg;
}

void reset() {
  object *inv;
  object bed;
  ::reset();

  bed = present("bed", this_object());
  inv = all_inventory(bed);
  if (!sizeof(inv)) {
    new("/u/waiwai/npc/baby")->move(bed);
  }
}

int valid_leave(object me, string dir) {
  me->delete_temp("oldsix/can_leave");
  me->delete_temp("kezhan/qingcha");

  return ::valid_leave(me, dir);
}
