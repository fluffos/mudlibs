#include "city.h"

void create() {
  set("short", "长安乐坊");
  set("long", @LONG

这里是长安城一家有名的娱乐场所。当夜幕降临后，这里就格外
热闹。进进出出的客人有达官贵人，南来北往的商旅，浪迹天涯
的游子，三五成群的兵士，有时也能看见一些作俗客打扮的僧人
或道士前来碰碰运气，试试手气，真是好不热闹。
LONG);

  set("exits", ([
    "up": CITY "clubup",
    "north": CITY "xuanwu-e5",
    "south": __DIR__ "misc/lichunyuan",
    "west": __DIR__ "misc/ciqin",
  ]));

  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (wizardp(me)) return 1;

  if (dir == "south" && this_player()->query("LC_sell") > 0)
    return notify_fail(HIW "你还没被卖够？自己要进去卖身？！\n" NOR);

  if (dir == "south" && this_player()->query("age") < 18)
    return notify_fail(HIR "小毛孩子往里面瞎凑合什么?!\n" NOR);
  return ::valid_leave(me, dir);
}
