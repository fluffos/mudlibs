#include <allcity.h>

void create() {
  set("short", "长安浴室");
  set("long", @LONG

这里是长安城唯一的一处民用公众澡堂，里面是铺着松木地板
的地面。有不少大小的五颜六色的彩灯挂在窗口门前，长安城
里大多的平民百姓都会来这里洗去满身的疲惫，换取一个好心
情。澡堂的门口有一个牌子(paizi)。
LONG);

  set("exits", ([
    "north": CITY_ROOM "zhuque-e1",
  ]));

  set("objects", ([
    DOBJ "misc/tables": 1,
    DOBJ "misc/chairs": 2,
  ]));

  set("chat_room", 1);
  set("hotel", 1);
  set("indoors", "长安城");

  setup();
  replace_program(ROOM);
}
