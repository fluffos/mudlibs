inherit ROOM;
#include <ansi.h>

void create ()
{
        set ("short", HIY"成衣店"NOR);
        set ("long", 

"\n据说这里的盔甲是萧振远当年开镖局珍藏的各种名衣宝甲，交给长\n"+
"安城最大的兵器盔甲商丁老板打理，这个丁老板乃是萧振远的结拜\n"+
"兄弟。旁边墙上有块招牌 "+HIR"(pai) \n\n"

NOR);

	set("item_desc", ([
		"pai": HIC"请用 "+HIR"\"list\""+HIC" 列出货物清单，"+HIR"\"buy\""+HIC" 向老板购买 "+HBRED+HIW" (buy 某物 from 老板名字) \n"NOR,
	]));

        set("exits", 
        ([ //sizeof() == 4
         "west" : __DIR__"bingqipu",
          
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/ding" : 1,
        ]));
//        call_other("/obj/board/wiz_b", "???");


   set("no_clean_up", 0);
        setup();
   replace_program(ROOM);
}

