#include <allcity.h>
string long_desc();

void create() {
  set("short", "南城客栈");
  set("long", (: long_desc :));

  set("item_desc", ([
    "south": "店小二过来挡在你的面前：贼眉鼠眼的看什么？\n",
  ]));

  set("exits", ([
    "north": CITY_OB("city", "zhuque-w1"),
    "south": CITY_OB("city", "sleep"),
    "east": DOBJ "heidian/city_heidian",
    "west": CITY_OB("city", "proom"),
    "up": WIZ_ROOM "entrance",
    //		"southup"	: "/test/xiaodao",
    "down": WAI_ROOM "bobing",
  ]));

  set("objects", ([
    CITY_NPC "xiaoer": 1,
    //	      HOME_NPC"bigeye" : 1,
    "/obj/ballot": 1,
    "/obj/ban": 1,
  ]));

  set("no_fight", 1);

  set("resource", ([
    "water": 1,
  ]));

  //客满禁止标志
  set("limit_exits", ({ "south" }));

  set("valid_startroom", 1);
  set("indoors", "长安城");
  set("area", "长安城");
  set("no_ridee", 1);
  //	set("no_upgrade_age",1);
  set("NONPC", 1);

  setup();
  call_other("/obj/board/nancheng_b", "???");
}

int valid_leave(object me, string dir, string arg) {
  object ob;
  string banghui, season;
  object lp;
  mapping data, exit;
  object mbox, env;
  env = environment(me);

  if (wizardp(me)) return 1;

  season = NATURE_D->check_season();

  if (!userp(me)) return ::valid_leave(me, dir);

  if (!(ob = present("xiao er", environment(me))))
    return ::valid_leave(me, dir);

  if (!living(ob))
    return ::valid_leave(me, dir);

  banghui = (string)me->query("banghui");

  //是同帮会的下雨天出客栈主动给伞
  if (banghui && (string)ob->query("banghui") == banghui && (dir == "north")) {
    if (season == "Summer-Rain" || season == "Spring-Rain" || season == "Autumn-Rain") {
      if (!present("umbrella", me)) {
        new(WAI_OBJ "san")->move(me);
        message_vision("$N对$n说道：别急着走，外面下雨呢，带上这把雨伞吧！\n", ob, me);
        return notify_fail(ob->name() + "急忙拿出一把雨伞递给你。\n");
      }
    }
  }

  lp = new("/obj/lingpai");
  lp->create(banghui);
  data = lp->query("area");
  destruct(lp);
  if (!mapp(data)) data = ([]);
  if (data[query("area")]) {
    return ::valid_leave(me, dir);
  }

  if (me->query_temp("oldsix/can_leave") &&
    (dir == "north" || dir == "down" || dir == "west" || dir == "east")) {
    if (!me->query_temp("kezhan/qingcha"))
      me->set_temp("kezhan/qingcha", 1);
    message_vision("$N跑过来满脸堆笑地挡住了$n：这位「" + RANK_D->query_respect(me) +
      "」付了钱怎么不住店就要走啊？莫非闲小的照顾不周？\n", ob, me);
    return notify_fail("不然客官先请二楼雅座用茶如何？小的已经打过招呼了，免费请茶！「" +
      RANK_D->query_respect(me) + "」请了！\n");
  }


  if (mbox = me->query_temp("mbox_ob")) {
    tell_object(me, CYN "你将信箱交回给邮差。\n" NOR);
    destruct(mbox);
  }

  if (me->query_temp("oldsix/can_leave") && dir == "south") {
    me->delete_temp("oldsix/can_leave");
    return ::valid_leave(me, dir);
  } else if (!me->query_temp("oldsix/can_leave") && dir == "south") {
    message_vision("$N满脸堆笑地挡住了$n：这位「" + RANK_D->query_respect(me) + "」住店请付(pay) " +
      MONEY_D->money_str(ob->query("money_need")) + "。\n", ob, me);
    return notify_fail("\n");
  }

  return ::valid_leave(me, dir);
}
