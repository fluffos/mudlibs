#include <allcity.h>

void init();

void create() {
  set("short", "制药堂");
  set("long", @LONG

这里本来药铺掌柜 杨中顺制药的地方，后来杨中顺开了药铺以后
经常都是买些药的成品，所以这个地方也就很少用到了，杨老板也
是个很大方的人，就把这个地方腾了出来，让给朋友们制药。
LONG);

  set("exits", ([
    "east": CITY_ROOM "yaopu",
  ]));

  set("objects", ([
    CITY_OBJ "luzi": 1,
  ]));

  set("no_magic", 1);
  set("no_book", 1);
  set("no_qmdj", 1);
  set("freeze", 1);
  set("no_ridee", 1);
  set("NONPC", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  object who = this_player();

  if (!wizardp(who) && userp(who)) {
    if ((int)who->query_skill("medical", 1) > 200) {
      call_out("heal_up", 9, who);
    }
    remove_call_out("kick_ob");
    call_out("kick_ob", 30);
  }
  remove_call_out("sounding");
  call_out("sounding", random(10), this_object());
}

int sounding(object where) {
  string *msgs = ({
    MAG "药炉中飘出一阵紫烟。\n" NOR,
    RED "药炉中的灵光同时闪了几闪。\n" NOR,
    YEL "紫烟灵光混合后在大堂中轻舞飞扬。\n" NOR,
    WHT "飞舞的光烟化做一条神龙。\n" NOR,
  });
  tell_room(where, msgs[random(sizeof(msgs))]);
}

int heal_up(object who) {
  remove_call_out("heal_up");

  if (!who || environment(who) != this_object()) {
    return 1;
  }
  who->set("eff_kee", (int)who->query("max_kee"));
  who->set("eff_sen", (int)who->query("max_sen"));

  message_vision(YEL "阵阵紫烟飘向$N，$N深深吸了几口气。\n", who);
  write("你觉得自己的精神气血一下子都恢复了。\n" NOR);

  if ((int)who->query("food") < (int)who->max_food_capacity())
    who->set("food", (int)who->max_food_capacity());
  if ((int)who->query("water") < (int)who->max_water_capacity())
    who->set("water", (int)who->max_water_capacity());

  return 1;
}

void kick_ob() {
  object room, *obj;
  int i;

  obj = deep_inventory(this_object());
  if (!sizeof(obj)) return;
  for (i = 0; i < sizeof(obj); i++) {
    if (interactive(obj[i]) && (time() - obj[i]->query_temp("enter_time")) > 60) {
      message_vision(CYN "一阵清风吹来,清烟消散,$N也随着清烟散去！\n" NOR, obj[i]);
      if (!room = find_object("/d/city/kezhan"))
        room = load_object("/d/city/kezhan");
      obj[i]->move(room);
      message("vision", CYN "一个人影随着一阵清烟从制药堂飘了出来!\n" NOR, room, ({ obj[i] }));
      call_out("kick_ob", 30);
      return;
    }
  }
  call_out("kick_ob", 30);
}

//Added By waiwai@2001/06/05
int valid_leave(object me, string dir) {
  if (!wizardp(me) && userp(me)) {
    if (dir == "east")
      me->start_busy(10);
  }

  return ::valid_leave(me, dir);
}
