#include "city.h" 

void create ()
{
        set ("short", "化生寺门");
        set ("long", @LONG

化生寺是长安城里规模最大的一家丛林了。整日里香烟袅绕，颂经声
不绝于耳。来这里上香还愿的善男信女也特别多，若到了皇道吉日，
更是人山人海。
LONG);

        set("exits", 
        ([
  "southwest"   : CITY"changan-nankou",
  "north"   : CITY"huashengsi",
         ]));

        set("objects", 
        ([ 
   CNPC"sengren1"   : 2, 
   CNPC"sengren"   : 1, 
         ]));


        set("outdoors", "CITY");
	set("no_clean_up", 0);
        setup();
}


