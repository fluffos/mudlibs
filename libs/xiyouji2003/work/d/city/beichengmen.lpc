#include <allcity.h>

void create ()
{
  set ("short", "北城门");
  set ("long", @LONG

这里是长安城的北门。出了北门便是通往长安货物集散地的大路，由
于经常是商贾富豪采购货物所经之地，所以匪患不断，因此长安府便
派了不少捕快巡视于周围。往南走就可以进入长安城，远望人山人海，
往来行人车流不绝。城门下有一些执勤的兵士。时下虽已天下太平，
但一干兵将还是英姿勃勃，警惕的盯着往来人士。
LONG);

	set("exits", ([
		"north"   : CITY_ROOM"bhlu1",
		"south"   : CITY_ROOM"center2",
	]));

	set("objects", ([ 
		CITY_NPC"luren"   : 2, 
		CITY_NPC"bing"   : 2, 
	]));

	set("outdoors", "长安城");

	setup();
	replace_program(ROOM);
}


