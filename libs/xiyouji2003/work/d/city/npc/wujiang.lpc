//Last modified by waiwai@2001/04/17

inherit NPC;

#include <greeting.h>

void create()
{
        set_name("守城武将", ({ "wu jiang", "wu", "jiang", "wujiang" }));
        set("gender", "男性");
        set("age", random(10) + 30);
        set("str", 25);
        set("long", "他威风凛凛，杀气腾腾，虽然只是个守城门的小官，当年也是打过大仗的。\n");
        set("combat_exp", 2000000);
        set("attitude", "peaceful");

        set_skill("unarmed", 270);
        set_skill("force", 270);
        set_skill("sword", 270);
        set_skill("dodge", 270);
        set_skill("parry", 270);
	 set("max_kee", 3700);
	 set("max_sen", 3600);
        set("force", 3400); 
        set("max_force", 3400);
        set("force_factor", 100);
	 set("max_mana", 300);
	 set("mana", 300);
	 set("mana_factor", 100);

        setup();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
        carry_object("/d/obj/armor/tiejia")->wear();
}

void init()
{
        object ob;
        ::init();
        if (interactive(ob = this_player()) && 
                (int)ob->query_condition("killer")) {
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob);
        }
        greeting(this_player());
}

int accept_fight(object me)
{
        message_vision("守城武将对$N把眼一瞪，喝道：呔，大胆，还不退下！\n\n", me);
        return 0;
}

void kill_ob (object ob)
{
	if(ob->query_condition("killer"))
       message_vision(HIG"小兵对$N喝道：呔，大胆"HIR"逃犯"HIG"还不束手就擒！\n\n"NOR, ob);
	else
       message_vision(WHT"小兵对$N喝道：呔，大胆刁民，活得不耐烦了？\n\n"NOR, ob);

	::kill_ob(ob);
}
