#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

//inherit F_VENDOR_SALE;

void create()
{
//    reload("xiaoxiao");
        set_name(WHT"萧 萧"NOR, ({"xiao xiao", "xiao","boss"}));
        set("title", WHT"恶娘子"NOR);
        set("gender", "女性");
        set("age", 25);
        set("long", HIC"老英雄萧振远的小女儿，兵器铺女老板。
由于凶蛮狠毒，江湖人称＂恶娘子＂。\n"NOR);

        set("combat_exp", 70000);
        set_skill("sword", 300);
        set_skill("unarmed", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
	set_skill("moondance", 300);
      	set_skill("sword", 300);
        set_skill("bainiao-jian", 300);
	map_skill("sword", "bainiao-jian");
	map_skill("dodge", "moondance");
	map_skill("parry", "fonxansword");
	set("force", 2000);
	set("max_force", 4000);
	set("force_factor",100);
      	set("mana", 2000);
	set("max_mana", 4000);	
       set("mana_factor",100);

//      set("combat_exp", 2000000);
//        (: perform_action,"chaofeng":),


        set("vendor_goods", ([
//                "huangtong": "/d/obj/weapon1/staff/huangtong",
                      "tmc": "/d/obj/weapon1/staff/tmc",
                     "hammer": "/d/obj/weapon1/hammer/lfsh",                
//                 "qinghong": "/d/obj/weapon1/sword/qinghong",
                   "7sword": "/d/obj/weapon1/sword/7sword",
                    "qin": "/d/obj/weapon1/sword/fhqin",
//                 "hengbing": "/d/obj/weapon1/sword/hengbing",                 
                 "jinqiang": "/d/obj/weapon1/spear/jinqiang",                
                 "qingtian": "/d/obj/weapon1/fork/qingtian",
                      "lou": "/d/obj/weapon1/blade/lou",
                  "fengdao": "/d/obj/weapon1/blade/fengdao",
                   "hanhai": "/d/obj/weapon1/blade/hanhai1",
//                    "guyue": "/d/obj/weapon1/blade/guyue",
                     "wwwc": "/d/obj/weapon1/stick/wwwc",
              "jueqingwhip": "/d/obj/weapon1/whip/jueqingwhip",
                    "axe": "/d/obj/weapon1/axe/huafu",
                 "goldjian": "/d/obj/weapon1/mace/goldjian",
                 "jiuchipa": "/d/obj/weapon1/rake/jiuchipa",


        ]) );

        setup();
        carry_object("/d/obj/cloth/pink_cloth")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
		call_out("greeting",1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( name()+"瞟了一眼，又懒洋洋的削起指甲来。\n");
                        break;
        }
}

void die()
{
  if (environment())
    message("sound", HIR"\n\n哼,老娘地盘上也敢撒野 !\n\n"NOR, environment());

  set("eff_kee", 1000);
  set("eff_gin", 200);
  set("eff_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("mana", 2000);
}

void unconcious()
{
  die ();
}

