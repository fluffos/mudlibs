#include <ansi.h>

inherit NPC;

string *list = ({ "yg-putuo", "yg-moon", "yg-wzg",
  "yg-fangcun", "yg-hell", "yg-jjf",
  "yg-dragon", "yg-xueshan",
  "yg-wudidong", "yg-hyd",
});

int work_me();

void create() {
  set_name("袁天罡", ({ "yuan tiangang", "yuan" }));
  set("gender", "男性");
  set("age", 33);
  set("long", "袁天罡是天监台总管，听说他法术高深。他为人正直仗义，脸上总是一股忧国忧民的神情。\n");
  set("int", 30);
  set("per", 25);
  set("combat_exp", 9000000);
  set("daoxing", 800000);

  set("eff_dx", 1000);
  set("nkgain", 1);
  set("env/wimpy", 100);
  set("attitude", "friendly");
  set("title", "天监台正先生");
  set_skill("unarmed", 600);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("spells", 1000);
  set_skill("baguazhou", 1000);
  set_skill("literate", 500);
  set_skill("sword", 600);
  set_skill("changquan", 500);
  set_skill("baguazhen", 500);

  map_skill("spells", "baguazhou");
  map_skill("unarmed", "changquan");
  map_skill("parry", "changquan");
  map_skill("dodge", "baguazhen");
  set("per", 30);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("force", 9000);
  set("max_force", 9000);
  set("force_factor", 100);
  set("mana", 9000);
  set("max_mana", 9000);
  set("mana_factor", 100);
  set("food", 9000);
  set("water", 9000);
  set("office_number", 6000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    //		(: cast_spell, "renzhe" :),
    (: command("alert") :),
    (: command("alert") :),
    (: command("alert") :),
    (: command("alert") :),
  }));

  set("chat_chance", 5);
  set("chat_msg", ({
    name() + "叹道：生逢乱世，妖魔横行啊！\n",
    name() + "问道：可有谁愿去为大唐灭妖吗？\n",
  }));

  seteuid(getuid());

  set("no_kill", 1);
  set("tudi", 1);
  set_temp("die", WHT "突然周围升起一股烟雾～～～\n" NOR);
  set("no_blade", 1);  //不怕冰刀
  set("no_poison", 1);  //不怕用毒

  set("inquiry", ([
    "mieyao": (: work_me :),
    "kill": (: work_me :),
    "灭妖": (: work_me :),
    "妖魔": (: work_me :),
  ]));
  setup();

  carry_object("/d/obj/cloth/baguapao")->wear();
  carry_object("/d/obj/weapon/sword/taomujian")->wield();
}

int accept_fight(object me) {
  write("袁天罡凛然道：学武乃是为了强身，不是打打杀杀！\n");
  return 0;
}

int recognize_apprentice(object me) {
  if ((int)me->query("yuan-learn"))
    return 1;
  return notify_fail("袁天罡说道：您太客气了，这怎么敢当？\n");
}

int accept_object(object who, object ob) {
  if (ob->query("id") == "fan he") {
    if (((string)who->query("family/family_name") == "将军府")) {
      who->set("yuan-learn", 1);
      write("袁天罡笑道：将军看起来一表人才，以后定是人前出头之辈！
袁天罡略为沉思，又道：若将军有何问题，可随时和我商讨，天罡若是知晓，定会答复．\n");

      call_out("destroy", 1, ob);
      return 1;
    }

    if (((string)who->query("family/family_name") != "将军府")) {
      command("say 多谢多谢，我正饿着哪！");
      command("give 1 silver to " + who->query("id"));
      call_out("destroy", 1, ob);
      return 1;
    }
  } else return 0;
}

void destroy(object ob) {
  destruct(ob);
  return;
}

int work_me() {
  object ghost, me;
  int t, lvl, dx;
  me = this_player();


  //Added By waiwai@2003/04/09
  if (!wizardp(me)) {
    if ((int)me->query("yuan/killed") > 0) {
      command("shake");
      command("say 你只能协助天庭斩妖除魔了！！！\n");
      return 1;
    }
  }

  /*
	dx=(me->query("daoxing")+me->query("combat_exp"))/2;

	if(dx>50000) {
	  message_vision("$N对$n一拱手：这位"+
	    RANK_D->query_respect(me)+
	    "请速去天廷协助灭妖！\n",this_object(),me);
	  return 1;
	}	    	//for first time.	
*/

  /**************************************************************/
  // Added By waiwai@2003/04/09
  dx = (me->query("daoxing") / 2 + me->query("combat_exp"));
  if (dx > 1000000) {
    message_vision(HIY "$N" HIY "对$n一拱手：恭喜,恭喜,这位" + RANK_D->query_respect(me) +
      "请速去天廷协助" HIR "李天王" HIY "斩妖除魔！\n\n" NOR, this_object(), me);

    message("channel:rumor",
      HIG "┋" HIR "斩妖除魔" HIG "┋袁天罡(Yuan tiangang): 恭喜" + log_id(me) +
      HIG "从今天起将协助天庭斩妖除魔,希望不负众望！ \n\n" NOR, users());
    me->add("balance", 1000000);
    me->add("mieyao/reward/balance", 1000000);
    me->add("daoxing", 50000);
    me->add("mieyao/reward/dx", 50000);
    //         me->add("shengwang",100);
    //	me->add("mieyao/reward/sw",100);
    me->set("yuan/killed", 1);
    me->delete_temp("yuan/plll");
    me->delete_temp("mieyao/level");

    tell_object(me, HIR "恭喜！你得到了" + chinese_number(50) +
      "年道行及一百两黄金做为你曾为百姓造福的奖励！\n" NOR);
    //"年道行,一百两黄金以及一百点声望,做为你曾为百姓造福的奖励！\n"NOR); 

    return 1;
  }

  if (me->query_temp("asked/yuan")) return 1;
  /**************************************************************/

  if (!me->query("mieyao")) {
    me->set_temp("mieyao/level", 0);
    call_out("start_job", 1, me);
    return 1;
  }

  if ((t = (int)me->query("mieyao/time_start")) &&
    !me->query("mieyao/done1")) {
    if (t <= time() &&
      time() < t + 1200) {
      command("heng");
      command("say 你是武功太差还是被" + me->query("mieyao/name") + CYN "给吓回来了？一边玩去！！！\n" NOR);
      return 1;
    }

    lvl = me->query_temp("mieyao/level");
    if (lvl > 0) lvl--;
    me->set_temp("mieyao/level", lvl);

  } else {
    //	if(t<=time() && time()<t+300+(dx>20000?300:0)) {
    if (t <= time() && time() < t + 180 && !wizardp(me)) {

      command("wa " + me->query("id"));
      message_vision("$N" + MAG "兴高采烈地说道" + "：您太棒了,多谢" + RANK_D->query_respect(me)
        + ",妖魔已经暂时除尽了,您辛苦了。\n" NOR,
        this_object(), me);
      return 1;
    }

    lvl = me->query_temp("mieyao/level");
    if (lvl < 9) lvl++;
    else
      lvl = 1;
    me->set_temp("mieyao/level", lvl);

  }

  me->delete("mieyao/time_start");
  call_out("start_job", 1, me);
  return 1;
}

int start_job(object me) {
  string where;
  object ghost;
  int lvl;

  me->delete_temp("asked/yuan");

  //	if(environment(me)!=environment()) return 1;

  if (me->query("mieyao/time_start")) return 1;

  me->delete("mieyao/done1");

  lvl = me->query_temp("mieyao/level");

  ghost = new(__DIR__ + "yg/" + list[random(sizeof(list))]);
  where = ghost->invocation(me, lvl);

  message_vision("$N眉头紧皱,似有愁容地对$n说道：\n", this_object(), me);
  message_vision("近有" HIW + where + NOR "鱼肉乡里，不可一世，" + "请速去收服,为民造福！\n", this_object(), me);
  command("addoil " + me->query("id"));

  me->set("mieyao/time_start", time());
  me->set("mieyao/name", ghost->query("name"));
  me->set("mieyao/id", ghost->query("id"));
  me->add("mieyao/number1", 1);
  me->set("mieyao/where", where);
  me->start_busy(2);

  return 1;
}
