#include <ansi.h>

inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",HIB"蜀山剑魔"NOR);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("sword",j); 
         me->set("nokill", 1);

        me->set_skill("yujianshu", j);
	me->set_skill("mindsword", j);        
        me->set_skill("spells",j);
        me->set_skill("sevensteps",j);
        me->set_skill("taoism", j);
        me->set_skill("unarmed", j);        
        me->set_skill("hunyuan-zhang", j);
        me->set_skill("zixia-shengong", j); 

        me->map_skill("force", "zixia-shengong");
        me->map_skill("sword", "mindsword");        
        me->map_skill("parry", "mindsword");
        me->map_skill("spells", "taoism");
        me->map_skill("dodge", "sevensteps");
        me->map_skill("unarmed", "hunyuan-zhang");

	set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
//        (: exert_function, "recover" :),
        (: perform_action,"sword", "fenguang" :),
        (: cast_spell, "jianshen" :),
        }) );   
     
       set("limit_fight", 1);
       set("no_get", 1);

        carry_object("/u/weapon/sword")->wield();
        carry_object("/u/cloth/shoupiqun")->wear();
}
