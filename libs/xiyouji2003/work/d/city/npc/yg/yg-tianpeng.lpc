#include <ansi.h>

inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  me->set("title", HIC "天蓬府弃徒" NOR);
  me->set("wimpy", 40 + random(15));
  me->set("food", 500);
  me->set("water", 500);
  me->set("max_food", 1000);
  me->set("max_water", 1000);
  me->set("nokill", 1);

  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("rake", j);
  me->set_skill("skyriver-rake", j);
  me->set_skill("souguzhao", j);
  me->set_skill("chaos-steps", j);
  me->set_skill("wuneng-force", j);
  me->set_skill("fofa", j);

  me->map_skill("force", "wuneng-force");
  me->map_skill("rake", "skyriver-rake");
  me->map_skill("parry", "skyriver-rake");
  me->map_skill("spells", "fofa");
  me->map_skill("dodge", "chaos-steps");
  me->map_skill("unarmed", "souguzhao");
  me->map_skill("force", "wuneng-force");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    //          (: exert_function, "recover" :),
    //         (: cast_spell, "huti" :),
    (: exert_function, "liaoya" :),
  }));

  set("limit_fight", 1);
  set("no_get", 1);

  carry_object("/u/weapon/jiuchipa")->wield();
  carry_object("/u/cloth/shoupiqun")->wear();
}
