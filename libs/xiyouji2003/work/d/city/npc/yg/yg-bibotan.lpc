#include <ansi.h>

inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
	object weapon;

	set("title",HIB"碧波邪妖"NOR);
	me->set("wimpy",40+random(15));
       me->set("food", 500);
       me->set("water", 500);
       me->set("max_food", 1000);
       me->set("max_water", 1000);
       me->set("nokill", 1);

	me->set_skill("unarmed", j);
	me->set_skill("dodge", j);
	me->set_skill("parry", j);
	me->set_skill("force", j);
	me->set_skill("spells", j);
 
	me->set_skill("blade", j);
	me->set_skill("huaxue-blade", j);
	me->set_skill("fork", j);
	me->set_skill("yueya-chan", j);
	me->set_skill("liuquan-steps", j);
	me->set_skill("huaxue-dafa", j);
	me->set_skill("bibo-zhang", j);
	me->set_skill("huaxue-force", j);

	me->map_skill("force", "huaxue-force");
	me->map_skill("blade", "huaxue-blade");
	me->map_skill("fork", "yueya-chan");
        me->map_skill("parry", "huaxue-blade");
	me->map_skill("spells", "huaxue-dafa");
	me->map_skill("dodge", "liuquan-steps");
	me->map_skill("unarmed", "bibo-zhang");

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
//       (: exert_function, "recover" :),
//       (: exert_function, "refresh" :),
       (: perform_action,"unarmed", "duo" :),
	}) );

       set("limit_fight", 1);
       set("no_get", 1);

	carry_object("/u/cloth/shoupiqun")->wear();
	carry_object("/u/weapon/xuedao")->wield();
}
