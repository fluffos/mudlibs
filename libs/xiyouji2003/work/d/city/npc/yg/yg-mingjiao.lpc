#include <ansi.h>

inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  me->set("title", HIW "明教反贼" NOR);
  me->set("wimpy", 40 + random(15));
  me->set("food", 500);
  me->set("water", 500);
  me->set("max_food", 1000);
  me->set("max_water", 1000);
  me->set("nokill", 1);

  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("blade", j);
  me->set_skill("lieyan-dao", j);
  me->set_skill("sword", j);
  me->set_skill("liehuo-jian", j);
  me->set_skill("piaoyi-shenfa", j);
  me->set_skill("shenghuo-lingfa", j);
  me->set_skill("yingzhua-shou", j);
  me->set_skill("shenghuo-shengong", j);

  me->map_skill("force", "shenghuo-shengong");
  me->map_skill("blade", "lieyan-dao");
  me->map_skill("sword", "liehuo-jian");
  me->map_skill("parry", "liehuo-jian");
  me->map_skill("spells", "shenghuo-lingfa");
  me->map_skill("dodge", "piaoyi-shenfa");
  me->map_skill("unarmed", "yingzhua-shou");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),

  }));
  set("limit_fight", 1);
  set("no_get", 1);
  carry_object("/u/weapon/modao")->wield();
  carry_object("/u/cloth/red-cloth")->wear();
}
