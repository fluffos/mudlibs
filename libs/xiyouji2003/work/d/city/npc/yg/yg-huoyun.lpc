#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
	object weapon;

	set("title",HIR"火云健将"NOR);
	me->set("wimpy",40+random(15));
       me->set("food", 500);
       me->set("water", 500);
       me->set("max_food", 1000);
       me->set("max_water", 1000);
       me->set("nokill", 1);

	me->set_skill("unarmed", j);
	me->set_skill("dodge", j);
	me->set_skill("parry", j);
	me->set_skill("force", j);
	me->set_skill("spells", j);
 
	me->set_skill("spear", j);
	me->set_skill("huoyan-spear", j);
	me->set_skill("moshenbu", j);
	me->set_skill("pingtian-dafa", j);
	me->set_skill("moyun-shou", j);
	me->set_skill("huomoforce", j);

	me->map_skill("force", "huomoforce");
	me->map_skill("spear", "huoyan-spear");
        me->map_skill("parry", "huoyun-spear");
	me->map_skill("spells", "pingtian-dafa");
	me->map_skill("dodge", "moshenbu");
	me->map_skill("unarmed", "moyun-shou");

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
          (: exert_function, "recover" :),
          (: cast_spell, "saimei" :),
	}) );

       set("limit_fight", 1);
       set("no_get", 1);

       carry_object("/u/weapon/huoyun")->wield();
	carry_object("/u/cloth/shoupiqun")->wear();
}
