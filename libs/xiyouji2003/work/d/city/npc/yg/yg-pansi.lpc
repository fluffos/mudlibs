#include <ansi.h>

inherit __DIR__"yaoguai.lpc";


void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",WHT"盘丝洞弃徒"NOR);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("whip",j); 
	  me->set_skill("sword",j); 
         me->set("nokill", 1);

        me->set_skill("yinsuo-jinling", j);
	  me->set_skill("qingxia-jian", j);        
        me->set_skill("spells",j);
        me->set_skill("yueying-wubu",j);
        me->set_skill("pansi-dafa", j);
        me->set_skill("unarmed", j);        
        me->set_skill("lanhua-shou", j);
        me->set_skill("jiuyin-xinjing", j); 

        me->map_skill("force", "jiuyin-xinjing");
        me->map_skill("whip", "yinsuo-jinling");  
	  me->map_skill("sword", "qingxia-jian");
        me->map_skill("parry", "qingxia-jian");
        me->map_skill("spells", "pansi-dafa");
        me->map_skill("dodge", "yueying-wubu");
        me->map_skill("unarmed", "lahua-shou");

	set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
//        (: exert_function, "recover" :),
//        (: perform_action,"whip", "wang" :),
        (: cast_spell, "wuzhishan" :),
        }) );        

       set("limit_fight", 1);
       set("no_get", 1);

        carry_object("/u/weapon/mojian")->wield();
        carry_object("/u/cloth/shoupiqun")->wear();
}
