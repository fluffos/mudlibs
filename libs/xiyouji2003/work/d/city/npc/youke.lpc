// Created by waiwai@2002/12/05

inherit NPC;

void create()
{
	set_name("游客", ({ "youke", "traveller"}));
	if(random(10)<7)
	    set("gender", "男性" );
	else
	    set("gender", "女性" );

	set("age", 15+random(50));
	set("long", "这是一位来长安的外地游客，风尘仆仆。\n");
	set("chat_chance", 40);
        set("chat_msg", ({
		(: random_move :)
	}));

	set("combat_exp", 100000+random(400000));
	set("attitude", "friendly");
	set_skill("dodge", 100);
	set_skill("unarmed", 100);
	setup();
	carry_object("/obj/cloth")->wear();
}

