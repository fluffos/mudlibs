#include <ansi.h>

inherit NPC;
//inherit KNOWER;

void create()
{
	set_name("青年乞丐", ({ "dizi" }));
	set("gender", "男性");
	set("age", 19);
	set("long", "这是一个年轻的乞丐，脸上带着开朗的笑容。\n");
	set("per", 15);
	set("str", 99);

	set("force", 9000);
	set("max_force", 9000);
	set("mana", 9000);
	set("max_mana", 9000);	
	set("force_factor", 300);
	set("mana_factor", 300);

	set("combat_exp", 10000000);

	set("attitude", "peaceful");
       set("max_kee", 9000);
	set("max_sen", 9000);
	
	set_skill("unarmed", 999);
	set_skill("dodge", 999);
	set_skill("parry", 999);
	set_skill("handuzhang", 999);
	set_skill("xiaoyaoyou", 999);
	set_skill("ningxie-force", 999);
	set_skill("literate", 999);
	set_skill("spells", 999);
	set_skill("dengxian-dafa", 999);

	set_temp("apply/attack", 80);
	set_temp("apply/defense", 10);
	set_temp("apply/damage", 50);
	set_temp("spply/armor", 50);
	set_temp("apply/dodge", 50);

	map_skill("unarmed", "handuzhang");
	map_skill("parry", "handuzhang");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("spells", "dengxian-dafa");
	map_skill("force", "ningxie-force");

	set("inquiry", ([
//	       "消息" : (: accept_ask :),
	]) );

	set("chat_chance_combat", 100);
	set("chat_msg_combat", ({
//        (: perform_action,"sword","chaofeng":),
        (: cast_spell, "juanbi" :),
        (: cast_spell, "tuntian" :),
        (: cast_spell, "sjmdtmjtdf" :),
        (: cast_spell, "yilong" :),
	  }) );

	setup();	
}
