//Last modified by waiwai@2001/05/21

inherit NPC;
void consider();

void create() {
  set_name("林冠雨", ({ "lin guanyu", "lin" }));
  set("age", 42);
  set("gender", "男性");
  set("long", "古董店的老板，笑眯眯的看着你。但笑容的后面好象又有一丝．．．\n");
  set("title", "古董店老板");
  set("attitude", "friendly");

  set("combat_exp", 4000000);
  set("shen_type", 1);
  set("max_force", 6000);
  set("force", 6000);
  set("sen", 6000);
  set("max_sen", 6000);
  set("force_factor", 100);
  set_skill("unarmed", 400);
  set_skill("changquan", 400);
  set_skill("sword", 500);
  set_skill("fonxansword", 600);
  set_skill("dodge", 600);
  set_skill("parry", 400);

  map_skill("unarmed", "changquan");
  map_skill("sword", "fonxansword");
  map_skill("parry", "fonxansword");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: consider :)
  }));

  setup();
  carry_object("/obj/weapon/sword/changjian");
  carry_object("/d/city/obj/choupao")->wear();
}

int accept_object(object me, object obj) {
  object book;

  if ((string)obj->query("id") == "heshi-bi") {
    command("wa");
    message_vision("$N说道：这可是好东西呀。\n", this_object(), me);
    book = new("/clone/gift/obj/xqbook");
    if (book)
      book->move(me);
    message_vision("$N说道: 做为回赠，我把这本古书给给你。\n", this_object(), me);
    message_vision("$N拿出一本书递给$n。\n", this_object(), me);
    return 1;
  }

  if (!obj->value() && !obj->query("value")) return 0;
  command("haha");
  command("say 多谢这位" + RANK_D->query_respect(me) + "，头一次见到象您这么大方的！");
  return 1;
}

int accept_fight(object me) {
  command("say 别，别，我这里东西都是宝贝，碰坏了可不得了！\n");
  return 0;
}

void consider() {
  int i, flag = 0;
  object *enemy;

  enemy = query_enemy() - ({ 0 });
  for (i = 0; i < sizeof(enemy); i++) {
    if (!living(enemy[i])) continue;
    flag++;
    if (!query_temp("weapon")) {
      command("say 既然阁下逼人太甚，我也不再手下留情了！\n");
      command("wield sword");

      break;
    }
  }
}
