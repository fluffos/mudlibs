#include <ansi.h>

inherit ITEM;

void create() {
  set_name("花梗", ({ "hua geng", "geng" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根细细的" + this_object()->query("name") + " \n");
    set("unit", "根");
  }
  setup();
}
