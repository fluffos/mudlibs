inherit F_VENDOR;
inherit NPC;

void create() 
{
//	reload("xiaoxiao");
	set_name("萧萧", ({"xiao xiao", "xiao"}));
	set("title", "恶娘子");
	set("gender", "女性");
	set("age", 25);
	set("long", "老英雄萧振远的小女儿，兵器铺女老板。 由于凶蛮狠毒，江湖人称＂恶娘子＂。\n");
	 set("no_blade", 1);//不怕冰刀
	 set("no_poison", 1);//不怕用毒

       set("force", 6000);
       set("max_force", 3000);
       set("force_factor", 120);
       set("max_mana", 3000);
       set("mana", 6000);
       set("mana_factor", 120);
       set("combat_exp", 5600000);
       set("max_kee", 9000);
       set("max_gin", 3000);
       set("max_sen", 9000);

       set_skill("literate", 150);
       set_skill("unarmed", 150);
       set_skill("dodge", 150);
       set_skill("force", 150);
       set_skill("parry", 150);
       set_skill("sword", 150);
       set_skill("spells", 150);
        set_skill("moonshentong", 150);
        set_skill("baihua-zhang", 150);
        set_skill("moonforce", 150);
        set_skill("snowsword", 150);
        set_skill("moondance", 150);
        map_skill("spells", "moonshentong");
        map_skill("unarmed", "baihua-zhang");
        map_skill("force", "moonforce");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
        map_skill("dodge", "moondance");
        set("changed", "长安");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
//		(: cast_spell, "renzhe" :),
            (: command ("alert") :),
            (: command ("alert") :),
            (: command ("alert") :),
            (: command ("alert") :),
        }) );

       set("vendor_goods", ([
                 "1": "/obj/weapon/staff/tmc",
                 "2": "/obj/weapon/hammer/lfsh",                
                 "3": "/obj/weapon/sword/7sword",
                 "4": "/obj/weapon/sword/fenghuang",
                 "5": "/obj/weapon/spear/jinqiang",                
                 "6": "/obj/weapon/fork/qingtian",
                 "7": "/obj/weapon/blade/lou",
                 "8": "/obj/weapon/blade/fengdao",
                 "9": "/obj/weapon/blade/hanhai1",
                 "10": "/obj/weapon/stick/wwwc",
                 "11": "/obj/weapon/whip/jueqingwhip",
                 "12": "/obj/weapon/axe/huafu",
                 "13": "/obj/weapon/mace/goldjian",
                 "14": "/obj/weapon/rake/jiuchipa",
                 "15": "/obj/weapon/blade/zijinxiao",
                 "16": "/obj/weapon/needle/needle",
        ]) );

	setup();

         carry_object("/d/obj/cloth/pink_cloth")->wear();
         carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void init() 
{
         object ob;

          ::init();

         if( interactive(ob = this_player()) && !is_fighting() ) {
                 remove_call_out("greeting");
 		call_out("greeting",1, ob);
         }
         add_action("do_vendor_list", "list"); 
}  

void greeting(object ob) 
{
       if( !ob || !visible(ob) || environment(ob) != environment() ) return;

	// Added by waiwai@2003/04/10
	if( ob->query("env/invisibility") ) return;

         switch( random(3) ) {
                 case 0:
                         say( name()+"瞟了一眼，又懒洋洋的削起指甲来。\n");
                         break;
         } 
} 

int accept_fight(object me) 
{
         command("say 哼，老娘地盘上也敢撒野！\n");
         return 1; 
}
  