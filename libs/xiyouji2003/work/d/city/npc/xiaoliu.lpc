// Update by waiwai@2003/04/12

inherit F_VENDOR_SALE; 

void create() 
{     
	reload("yao_fugui");        
	set_name("姚富贵", ({"yao fugui", "yao"}));
       set("long", "姚老板是高家集人，后来挣了钱，开了家布店。\n");
       set("gender", "男性");         
	set("title", "布店老板");
	set("combat_exp", 10000);        
	set("age", 36);        
	set("attitude", "friendly");        
	set("shen_type", 1);        
	set_skill("unarmed", 35); 	
	set_skill("dodge", 30); 	
	set_skill("parry", 35); 
        set("changed", "长安");
     
       set("vendor_goods", ([
//                "1": "/obj/cloth/hat",
//                "2": "/obj/cloth/shoes",
//                "3": "/obj/cloth/magua",
//                "4": "/obj/cloth/piyi",
                "1": "/obj/cloth/shoe",
                "2": "/obj/cloth/sanhua",
                "3": "/obj/cloth/sppifeng",
                "4": "/obj/cloth/jinjia",
                "5": "/obj/cloth/tiekui",
                "6": "/obj/cloth/zhanpao",
                "7": "/obj/cloth/pants",
                "8": "/obj/cloth/beijia",
                "9": "/obj/cloth/huxi",
                "10": "/obj/cloth/hujian",
                "11": "/obj/cloth/huyao",
                "12": "/obj/cloth/huwan",
                "13": "/obj/cloth/hubi",
                "14": "/obj/weapon/shield",
       ]) );
     
	setup();        
	carry_object("/d/obj/cloth/choupao")->wear();  
} 

void init() 
{         
	object ob;          
	::init();         

	if( interactive(ob = this_player()) && !is_fighting() ) {
                 remove_call_out("greeting");
                 call_out("greeting", 1, ob);
         }
         add_action("do_vendor_list", "list"); 
}  

void greeting(object ob) 
{
	if( !ob || !visible(ob) || environment(ob) != environment() ) return;
       if( ob->query("env/invisibility") ) return;

	switch( random(1) ) {                 
	case 0:                         
	say(name()+ "笑眯眯的迎上来：这位" + RANK_D->query_respect(ob)
                                 + "，随便看看．\n");
                         break;         
		} 
}  
