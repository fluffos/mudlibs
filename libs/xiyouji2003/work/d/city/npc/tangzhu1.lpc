inherit NPC;

void create() {
  set_name("花忍", ({ "hua ren", "hua" }));
  set("age", 27);
  set("gender", "男性");
  set("long",
    "脸上一道长长的刀疤，可怕之极。\n");
  set("title", "二堂主");
  set("attitude", "peaceful");

  set("combat_exp", 800000);
  set("shen_type", 1);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 5);
  set_skill("unarmed", 140);
  set_skill("changquan", 140);
  set_skill("dodge", 160);
  set_skill("parry", 160);
  map_skill("unarmed", "changquan");

  set("no_give", 1);  //By waiwai@2001/06/22 task bug fix

  setup();
  carry_object("/obj/cloth/piyi")->wear();
}
