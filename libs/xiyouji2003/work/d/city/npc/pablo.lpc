// NPC  /d/city/npc/pablo.c
// Last Modified by waiwai@2003/01/18

inherit NPC;

void create()
{
	set_name("董朴升", ({"dong pusheng", "dong", "boss"}));
	set("title", "当铺掌柜");
	set("gender", "男性");
	set("age", 47);
	set("kee", 2500); 
	set("max_kee", 2500);
	set("sen", 2000);
	set("max_sen", 2000);	
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("rank_info/respect", "掌柜的");
	set("env/wimpy", 50);
	set("chat_chance", 10);
	set_skill("parry", 260);
	set_skill("unarmed", 260);
	set_skill("dodge", 260);
	set("area_name","长安城");
       set("dealer", 1); // 可收货商人标志

	setup();
       carry_object("/d/obj/cloth/choupao")->wear();
	carry_object("/d/city/obj/jiezhi")->wear();
}

void init()
{
        object area,ob;
        area=new("/obj/area");
        area->create(query("area_name"));
        set("banghui",(string)area->query("banghui"));
        destruct(area);

        ::init();
}
