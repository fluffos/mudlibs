#include <command.h>
inherit NPC;

int accept_object(object me, object ob);
string change(object me);
//int ask_upgrade();
#include <limit.h>

void create() {
  set_name(WHT "长孙无忌" NOR, ({ "zhangsun wuji", "wuji" }));
  set("gender", "男性");
  set("title", HIG "户部尚书" NOR);
  set("nickname", HIR "全靠一支笔" NOR);
  set("age", 55);
  set("str", 95);
  set("int", 30);
  set("per", 35);
  set("attitude", "friendly");
  set("combat_exp", 900000000);
  set("daoxing", 50000);

  set("attitude", "friendly");
  set("class", "scholar");
  set_skill("unarmed", 900);
  set_skill("dodge", 900);
  set_skill("literate", 900);
  set_skill("parry", 900);
  set_skill("force", 900);
  set_skill("spells", 900);

  set("max_force", 9000);
  set("force", 9000);
  set("max_mana", 9000);
  set("mana", 9000);
  set("max_kee", 9000);
  set("max_sen", 9000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: command("alert") :),
    (: command("alert") :),
    (: command("alert") :),
    (: command("alert") :),
  }));

  set("no_kill", 1);
  set("limit_fight", 1);

  set("no_blade", 1);  //不怕冰刀
  set("no_poison", 1);  //不怕用毒

  set("inquiry", ([
    //                "升级" : (: ask_upgrade :),
    //                "levelup" : (: ask_upgrade :),
    //                "upgrade" : (: ask_upgrade :),
    //            "婚姻": (: change :),
    "老婆": "老婆没了就找,只要有钱,什么不成,爱情...你相信吗?",
    "妻子": "妻子没了就找,只要有钱,什么不成,爱情...你相信吗?",
    "丈夫": "丈夫没了就找,只要有钱,什么不成,爱情...你相信吗?",
  ]));

  setup();
  carry_object("/d/city/obj/choupao")->wear();
}

void init() {
  object ob;

  ::init();
  add_action("do_apply", "apply");
  add_action("do_newname", "newname");
}

int do_apply(string args) {
  string respect_type, respect_str;
  object me = this_player();
  object mymoney;
  int dx, amount, i, j;

  i = strlen(respect_str);

  if (uptime() - me->query_temp("last_renamec_time") < 600)
    return notify_fail(WHT "长孙无忌正忙着,没空理你。\n" NOR);

  if (!args || sscanf(args, "%s to %s", respect_type, respect_str) != 2) {
    tell_object(me, HBBLU HIY " 格式为: apply respect to <称呼> \n\n" + NOR
      CYN "请勿使用不恰当的称谓。不然称呼被取消，五百两金\n" +
      "子就白白扔了。至于恰当与否，则由系统管理员决定。\n\n" +
      "要求:道行>1000年携带500两黄金。(小于4个汉字)。\n\n" NOR);
    return 1;
  } else {
    mymoney = present("gold_money", me);
    if (!mymoney) {
      command("heng");
      return notify_fail(CYN "长孙无忌说道:你没钱跑来凑什么热闹? \n" NOR);
    }
    switch (respect_type) {
      case "respect":
        {
          dx = 1000000;
          amount = 500;
          break;
        }
      default:
        return notify_fail(HIG "你要申请什么样的称呼? \n" NOR);
    }
    if (!wizardp(me) && me->query("daoxing") < dx)
      return notify_fail(HIG "你的道行不够！！！ \n" NOR);
    if (mymoney->query_amount() < amount)
      return notify_fail(HIG "你带的金子不够！！！ \n" NOR);

    if (respect_str) {
      if (!wizardp(me) && me->query("usr/renamec") >= 3) {
        write(HIY "\n很抱歉每个人的一生只能更改中文称呼三次。\n\n" NOR);
        return 1;
      }

      if ((strlen(respect_str) < 4) || (strlen(respect_str) > 8)) {
        write(HIY "\n很抱歉您的中文称呼必须是" HIR " 2" HIY " 到" HIR " 4" HIY " 个中文字。\n\n" NOR);
        return 1;
      }

      while (i--) {
        if (respect_str[i] <= ' ') {
          write(HIY "\n很抱歉您的中文称呼不能用控制字元,请使用中文输入。\n" NOR);
          return 1;
        }
        if (i % 2 == 0 && !CHINESE_D->is_chinese(respect_str[i..<0])) {
          write(HIY "\n很抱歉请您使用" HIR "「中文」" HIY "为自己取称呼。\n" NOR);
          return 1;
        }
      }

      for (j = 0; j < sizeof(bad_word); j++)
        if (strsrch(respect_str, bad_word[j]) != -1) {
          write(HIY "\n很抱歉，系统禁止使用含着 " HIR BLINK + bad_word[j] + NOR HIY " 这样的中文称呼！\n\n" NOR);
          return 1;
        }
    }

    if (mymoney->query_amount() == amount)
      destruct(mymoney);
    else
      mymoney->add_amount(-amount);

    me->set("rank_info/" + respect_type, respect_str);
    me->add("usr/renamec", 1);
    me->set_temp("last_renamec_time", uptime());

  }
  message_vision(CYN "长孙无忌点了点头, 提起笔在一个簿子上改了几笔～～～ \n\n" NOR, me);
  message("channel:rumor", HIR "【户部通告】" HIW "长孙无忌：" HIG +
    me->query("name") + "(" + me->query("id") + ") 经本部同意从现在起称呼设为：" HIY + respect_str + "\n\n" NOR, users());

  return 1;

}

int do_newname(string args) {
  string old_name;
  object me = this_player();
  object mymoney;
  int amount, i, j;
  old_name = me->query("name");

  i = strlen(args);

  if (uptime() - me->query_temp("last_rename_time") < 600 && !wizardp(me))
    return notify_fail(WHT "长孙无忌正忙着,没空理你。\n" NOR);

  if (!args) {
    tell_object(me, HIY "你要更改成什么样的名字？\n\n" NOR);
    return 1;
  }

  if ((string)me->query("bonze/class") == "bonze")
    return notify_fail(HIR "出家人清心寡欲,淡泊名利，改的什么名字撒！！！\n" NOR);

  if (args) {
    if (!wizardp(me) && me->query("usr/rename") >= 3) {
      write(HIY "\n很抱歉每个人的一生只能更改中文字三次。\n\n" NOR);
      return 1;
    }

    if (!wizardp(me)) {

      if ((strlen(args) < 4) || (strlen(args) > 8)) {  //如果改变这里的位数规定,请相应改变who.c格式
        write(HIY "\n很抱歉您的中文名字必须是" HIR " 2" HIY " 到" HIR " 4" HIY " 个中文字。\n\n" NOR);
        return 1;

        while (i--) {
          if (args[i] <= ' ') {
            write(YEL "\n很抱歉您的中文名字不能用控制字元,请使用中文输入。\n" NOR);
            return 1;
          }

          // Update By waiwai@2001/07/13
          if (i % 2 == 0 && !CHINESE_D->is_chinese(args[i..<0])) {
            write("\n很抱歉请您使用" YEL "「中文」" NOR "为自己取名字。\n");
            return 1;
          }
        }
      }

      for (j = 0; j < sizeof(bad_word); j++)
        if (strsrch(args, bad_word[j]) != -1) {
          write(HIY "\n很抱歉，系统禁止使用含着 " HIR BLINK + bad_word[j] + NOR HIY " 这样的中文名字！\n\n" NOR);
          return 1;
        }
    }

    if (member_array(args, family_name) != -1)
      return notify_fail("不能使用门派特有称号作为名字。\n");

    if (member_array(args, nature_name) != -1)
      return notify_fail("不能使用天气或频道以及系统特有名词作为名字。\n");

    if (!me->query("balance")) {
      command("heng");
      return notify_fail(CYN "长孙无忌说道:你没钱我可不能给你改名字的！！！！\n" NOR);
    }
    if ((int)me->query("balance") < 50000000 && !wizardp(me))
      return notify_fail(HIC "你钱庄存款不足！\n" NOR);

    me->add("balance", -50000000);
    me->set("name", args);
    me->add("usr/rename", 1);


    me->set_temp("last_rename_time", uptime());
  }
  message_vision(CYN "长孙无忌点了点头, 提起笔在一个簿子上改了几笔～～～ \n" NOR, me);
  message("channel:rumor", HIR "【户部通告】" HIW "长孙无忌: " HIG + old_name + "(" + me->query("id") + ") " HIC
    "从现在开始改中文名为：" BLINK HIR + args + NOR HIC " 大家以后别认错了人！！！\n\n" NOR, users());

  return 1;
}

