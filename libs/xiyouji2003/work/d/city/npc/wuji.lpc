int accept_object(object me, object ob)
{
    int i,p;
    i=(int)me->query("marks/couple_times");
    p=i*i;
    if (!me->query("couple/change_ask")) {
      command("?");
      return notify_fail(HIB"没理由给我钱干吗?嘿嘿！！\n"NOR);
    }
    if(ob->query("money_id") && ob->value() >= (p*1000000+1000000)) {
//    if(ob->query("money_id") && ob->value() >= (p*1)) {//test
        command("nod");
        command("say 好吧，"+me->query("name")+"你等等我来查查！\n"NOR);
      if ((string)me->query("gender") == "女性")         
            command("say 你原来的丈夫是"+me->query("couple/name")+",看来你决定结束这段姻缘了，唉！");
      else  command("say 你原来的妻子是"+me->query("couple/name")+",看来你决定结束这段姻缘了，唉！");
        me->delete("couple/change_ask");
        me->set("couple/change_test",1);
        remove_call_out("do_test");
        call_out("do_test", 5, me);
        return 1;
        } else {
        command("heng");
        command("say 嘿嘿，"+me->query("name")+"你倒大胆，来人给我打出去！\n");
        me->delete_temp("couple/change_ask");
        me->move("/d/city/center");
         message_vision(HIB"$N浑身伤痕地被从长安府户部大堂打了出来。\n"NOR,me);
        return 1;
        }
}

