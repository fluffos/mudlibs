#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;

void create() {
  set_name("周铁匠", ({ "zhou tiejiang", "zhou", "tiejiang", "smith" }));
  set("gender", "男性");
  set("title", WHT "铁匠铺老板" NOR);
  set("age", 42);
  set("long", "周铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
  set("combat_exp", 10000);
  set("attitude", "peaceful");

  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_skill("literate", 40);

  set("max_kee", 600);
  set("max_sen", 600);

  set("chat_chance", 5);
  set("chat_msg", ({
    "周铁匠拿着锤子对刚出炉的火热的生铁用力敲打着．\n",
    "周铁匠用铁钳抄起一块火红的坯子，伸进了水池，“哧”的一声轻烟四冒...\n",
    "周铁匠拿起几块生铁，在手里掂了掂．\n",
  }));
  /*
        set("vendor_goods", ([
                 "1": "/d/obj/weapon/dagger/dagger.lpc",
                "2": "/d/obj/weapon/axe/tiefu.lpc",
                "3": "/d/obj/weapon/hammer/hammer",
                "4": "/d/obj/weapon/fork/fork",
            	"5": "/d/obj/weapon/stick/bintiegun",
                "6":"/d/obj/weapon/whip/tielian",
                "7": "/d/obj/armor/niupi",
                "8": "/d/obj/weapon/sword/changjian2",
                "9": "/d/obj/weapon/blade/blade",
                "10": "/d/obj/weapon/spear/tieqiang",
                "11": "/d/obj/weapon/staff/chanzhang",
        ]) );
*/
  set("no_poison", 1);
  set("no_blade", 1);
  //        set("changed", "长安");

  setup();

  carry_object("/d/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/hammer/hammer")->wield();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
  }
  //        add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || !visible(ob) || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say(name() + "说道：这位" +
        RANK_D->query_respect(ob)
        + "，进来随便看看吧。\n");
      break;
    case 1:
      say(name() + "用脖子上的毛巾抹了抹手，说道：这位" +
        RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
    case 2:
      say(name() + "说道：这位" +
        RANK_D->query_respect(ob)
        + "，进来挑一件称手的兵器吧。\n");
      break;
  }
}

int accept_object(object me, object obj) {
  object xuantie;

  if ((string)obj->query("id") == "heshi-bi") {
    command("wa");
    message_vision("$N说道：这可是好东西呀。\n", this_object(), me);
    xuantie = new("/d/diablo/combine/obj/xuantie");
    if (xuantie)
      xuantie->move(me);
    message_vision("$N说道: 做为回赠，我把这块上古玄铁给你。\n", this_object(), me);
    message_vision("$N拿出一块伏羲玄铁给$n。\n", this_object(), me);
    return 1;
  }

  if (!obj->value() && !obj->query("value")) return 0;
  command("haha");
  command("say 多谢这位" + RANK_D->query_respect(me) + "，头一次见到象您这么大方的！");
  return 1;
}
