#include <allcity.h>

void create() {
  set("short", "童生考场");
  set("long", @LONG

这里是为求仕途之人开立的童生考场，想做官的首先要从考取
童生开始，然后才能有机会进得皇宫晋升官职。或许寒窗十年
你也未必可以考取的，也或许你道听途说就可以回答出来而赚
得童生之衔呢。考场的墙上贴着幅告示(gaoshi)。桌子上放着
一本蓝底金字封装的厚簿子，封面书着《历代童生名录》。据
说是记载历代所有考取过童生的人的档案(minglu)。
LONG);

  set("item_desc", ([
    "gaoshi": "
exam：  请考官出题
answer：回答问题

请注意如果每次回答错误只能在一天后再进
行第二次，时间为游戏中时间，请慎重！

" ]));

  set("exits", ([
    "out": CITY_ROOM "guozi",
  ]));

  set("objects", ([
    CITY_NPC "kaoguan": 1,
    DOBJ "misc/tables": 1,
    DOBJ "misc/chairs": 2,
  ]));

  set("chat_room", 1);

  setup();
}

void init() { add_action("look_book", "look"); }

int look_book(string arg) {
  if (!arg) return 0;
  if (arg != "minglu") return 0;

  write("
[37m                          ┏━━━━━━━━┓[2;37;0m
[37m                          ┃[44;1;33m  历代童生名录  [0;37m┃[2;37;0m  
[37m┏━━━━━━━━━━━━┗━━━━━━━━┛━━━━━━━━━━━━━┓[2;37;0m\n\n");

  if (file_size("/log/ts.rc") > 0)
    this_player()->start_more(read_file("/log/ts.rc"));
  write("
[37m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛[2;37;0m \n");
  return 1;
}
