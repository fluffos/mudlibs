#include <allcity.h>

string look_sign(object me);

void create() {
  set("short", "屠记肉铺");
  set("long",
    "\n你现在正站在屠记肉铺里，肉架上挂满了血淋淋的生肉，一股\n"
    "一股腥气扑面而来，不时有几只苍蝇在屋里飞来飞去。靠近门\n"
    "口的地方有一块牛骨雕成的招牌(sign)，上面写着些什么。\n"
  );

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "north": CITY_ROOM "zhuque-w3"
  ]));

  set("objects", ([
    CITY_NPC "butcher": 1,
    CITY_NPC "fly2": 2,
  ]));

  set("indoors", "长安城");

  setup();
}

string look_sign(object me) {
  return (@LONG
本店即将收购死狗。
LONG);
}
