  set("short", "二楼雅座");
  set("long", @LONG

这里摆设讲究，用的器具都是从景德镇运来。摆的桌椅都是红木的，
在光照之下反射出淡淡的光泽。推窗望去，长安城中心尽收眼底。
几位品茗的房客正在絮语谈心，呈现出一种雅静怡然的景象。
LONG);
  set("item_desc", ([
    "west": "房子里云雾缭绕，什么也看不清楚。\n",
  ]));

  set("exits", ([
    "down": CITY_ROOM "kezhan",
    "east": WIZ_ROOM "system",
    "west": WIZ_ROOM "ku",
    "south": WIZ_ROOM "shishe",
    "north": WIZ_ROOM "hanghui",
  ]));

  set("objects", ([
    //          WIZ_NPC"chatong" : 1,
    //          WIZ_OBJ"table" : 1,
    DOBJ "misc/chairs": 2,
  ]));
  set("chat_room", 1);
  set("area", "长安城");
  set("no_upgrade_age", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("freeze", 1);

  setup();
  call_other("/obj/board/query_bbs", "???");
}

void reset() {
  object *inv;
  object table;
  ::reset();

  table = present("table", this_object());
  inv = all_inventory(table);
  if (!sizeof(inv)) {
    new(__DIR__ "obj/kaixin")->move(table);
    new(__DIR__ "obj/kaixin")->move(table);
    new(__DIR__ "obj/kaixin")->move(table);
    new(__DIR__ "obj/kaixin")->move(table);
    new(__DIR__ "obj/kaixin")->move(table);
    new(__DIR__ "obj/kaixin")->move(table);
  }
}

int valid_leave(object me, string dir, string arg) {
  object ob;
  string banghui;
  object lp;
  mapping data, exit;
  object env;
  env = environment(me);

  if (wizardp(me)) return 1;

  if (!userp(me)) return ::valid_leave(me, dir);

  if (!(ob = present("xiao chuan", environment(me))))
    return ::valid_leave(me, dir);

  if (!living(ob))
    return ::valid_leave(me, dir);

  banghui = (string)me->query("banghui");
  lp = new("/obj/lingpai");
  lp->create(banghui);
  data = lp->query("area");
  destruct(lp);
  if (!mapp(data)) data = ([]);
  if (data[query("area")]) {
    return ::valid_leave(me, dir);
  }
  /*
	if(banghui != ob->query("banghui") && dir=="west")	{
	message_vision("$N满脸堆笑地挡住了$n：这位「"+RANK_D->query_respect(me)+"」住店请下楼，这里是贵宾卧房。\n",ob,me);
		return notify_fail("\n");
	}
*/
  if (me->query_temp("oldsix/can_leave") && dir == "west") {
    me->delete_temp("oldsix/can_leave");
    return ::valid_leave(me, dir);
  } else if (!me->query_temp("oldsix/can_leave") && dir == "west") {
    message_vision("$N满脸堆笑地挡住了$n：这位「" + RANK_D->query_respect(me) + "」进去存物请付(pay) " +
      MONEY_D->money_str(ob->query("money_need")) + "。\n", ob, me);
    return notify_fail("\n");
  }

  return ::valid_leave(me, dir);
}
