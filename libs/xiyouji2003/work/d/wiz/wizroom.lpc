#include <room.h>

inherit RECORD_ROOM;

#include <ansi.h>
#include <command.h>

int block_cmd();
int do_start();
int do_say(string msg);
int do_over();

private string filename;

void create ()
{
  set ("short","巫师会议厅");
  set ("long",
"\n这里是西游记巫师开会讨论和聊天的地方。如果巫师们要开会的话，\n"
"便会聚在这里围着圆桌坐下来举行。屋子中间的桌子上放着一个会\n"
"议便笺(pad)。正中央的墙上赫然的挂着一帘彩色幅字，特别的醒目\n\n"
"──────────────────────────────\n"
HIR" 自今日起在职开发巫师必须到工作进度简报室定期汇报工作计划。\n"
HIR" 无事可做的巫师每两周没有任何工作表现者降职直至开除。。。\n"
HIR" 严禁任何人在工作室及其他地方做指令之外的对文件操作功能。\n"NOR
"──────────────────────────────\n"
"				      [by waiwai@2003/05/11]\n"NOR);
        set("item_desc", ([
              "pad" : "\n会议室的使用方法：\n"
		"start  :       开始会议。\n"
		"over :         结束会议。\n\n"
        ]));

	 set("exits", ([
	      "west" : __DIR__"system",
//	      "east":__DIR__"msgdroom",
	      "north" : __DIR__"jobroom",
	      "south" : __DIR__"hall",
//	      "enter" : __DIR__"outjail",
	      "sleeve": __DIR__"sleeveroom",
	      "guest": __DIR__"guest",
	      "jail":__DIR__"punish",
	      "kz": "/d/city/kezhan",
	 ]));

	  //Addded by waiwai@2001/03/18
        set("wiz_board",1);
        set("valid_startroom", 1);
        set("no_kill", 1);
        set("no_time", 1);
        set("chat_room",1);
        set("wiz_only",1);
	seteuid ("ROOT");

	  setup();
	  call_other("/obj/board/wizard_b", "???");
}

void init()
{   
        if (!wizardp(this_player()))
          add_action("block_cmd","",1);
	else
          add_action("do_say", "say");
          add_action("do_say", "'");
          add_action("do_start", "start");
          add_action("do_over", "over");
//          add_action("do_record", "record");
}

int block_cmd()
{
       string verb = query_verb();

       if (verb=="say") return 0; //allow say
       if (verb=="chat") return 0;
       if (verb=="quit") return 0;
       if (verb=="look") return 0;

       return 1;
}

int do_start()
{
	string str, wiz_status;
       object* ob,me;
       int i;

       me = this_player();
	if( me!=this_player(1) ) return 0;

//        if(wiz_level(me) < wiz_level("(arch)"))
//          return notify_fail(HIR"只有大神(arch)以上级别的管理者才有权召开巫师会议。\n"NOR);

	//Added by waiwai@2002/11/25
	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" )
          return notify_fail(HIR"只有主管天神(admin)级别的管理者才有权召开全体巫师会议。\n"NOR);

        if ( (int)query("meeting_trigger") != 0 )
                return notify_fail(WHT"会议正在进行中。\n"NOR);

        set("meeting_trigger", 1);

        ob = users();
        for ( i=sizeof(ob); i>0; i-- ) {
                if( wiz_level(ob[i-1]) < 1) continue;
                if( ob[i-1]->query("id") == "waiwai") continue;

                tell_object(ob[i-1],
                sprintf(HIY"%s(%s)告诉你：巫师会议现在召开，请到巫师会议厅开会。\n"NOR, 
                        me->query("name"),me->query("id")) );
                ob[i-1]->move("/d/wiz/wizroom");
                message_vision(HIY"\n$N赶到会议厅参加会议。\n"NOR,ob[i-1]);
        }
        str = me->query("id");
        if( !str )
                return notify_fail("Put meeting record to where??\n");

        message_vision(HIW"\n$N大声宣布：“会议现在开始。\n"NOR, me);
        filename = "meeting/" + str;
        return 1;
}

int do_say(string msg)
{
        if( !msg ) return 0;
        else
        "/cmds/std/say.lpc"->main(this_player(), msg);
        if ((int)query("meeting_trigger") == 1)
        log_file(filename,sprintf("%s(%s)：" + msg + " ("+COLOR_D->clean_color(BJTIME_CMD->chinese_time(7,ctime(time())))+")"+"\n",
	this_player()->name(1),this_player()->query("id")));//Update by waiwai@2002/11/25 
        return 1;
}

int do_over()
{
        if( !wizardp(this_player()) )
                return notify_fail(HIR"你没有权力终止会议。\n"NOR);

        if ( (int)query("meeting_trigger") == 0 )
                return notify_fail(YEL"现在没有进行任何会议。\n"NOR);

        delete("meeting_trigger");
        message_vision(HIW"\n$N大声宣布：“会议现在结束，祝各位工作顺利。”\n"NOR, this_player());
        return 1;
}

