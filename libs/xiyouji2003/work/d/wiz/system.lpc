#include <allcity.h>
#define BABY        WAI_NPC"giftnpc"

void create() {
  set("short", "系统公告室");
  set("long", @LONG

这是一间看起来很普通的房间，房内贴着一些有关这个世界的历史咨讯。
以前从这里你可以了解到许多有关于这个世界的咨讯，而现在这里已经
冷清了许多，随着世界的发展，人们已经习惯于阅读新闻(news)，曾经
熙攘热闹的屋子里面如今却出奇的安静，只有偶而喝过孟婆汤投胎降生
到这个世界的人来这里取一份大神给予的福礼。
LONG
  );

  BABY->come_here();

  set("item_desc", ([
    "east": "房子里云雾缭绕，什么也看不清楚。\n",
  ]));

  set("exits", ([
    "east": "/d/wiz/wizroom",
    "west": "/d/wiz/entrance",
    "south": WIZ_ROOM "music",
    "north": WIZ_ROOM "bank",
  ]));

  set("objects", ([
    "/obj/total_mptop": 1,
    WAI_ROOM "gift/table": 1,
  ]));

  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("post_limit", 1);
  set("no_upgrade_age", 1);

  setup();
  call_other("/obj/board/system_b", "???");
}
