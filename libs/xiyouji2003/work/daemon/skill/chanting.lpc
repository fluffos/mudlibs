// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me) {
  return notify_fail("诵经只能通过修炼来提高。\n");
}

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "贫苦多怨" NOR,
    HIB "成就辩才" NOR,
    YEL "身心自在" NOR,
    HIY "万境皆清" NOR,
    HIC "诸法皆空" NOR,
    HIW "普济一切" NOR,
  });

  grade = level / 20;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
