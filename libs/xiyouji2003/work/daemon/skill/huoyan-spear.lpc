#include <ansi.h>
inherit SKILL;

mapping *action = ({

  ([ "action": "$N双手一别，尽力前伸，使出一招" + HIR "「钻木取火」" + NOR "，手中枪平平直出，刺向$n的$l",
    "dodge": 30,
    "damage": 90,
    "skill_name": "钻木取火",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w盘旋回转，风响阵阵，屈身下蹲，反手一招" + HIM "「祝融怀焰」" + NOR "自下向$n的$l刺去",
    "dodge": 20,
    "damage": 80,
    "skill_name": "祝融怀焰",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N举起$w，抖出一朵枪花，一招" + HIC "「风火无边」" + NOR "向$n分心扎去",
    "dodge": 10,
    "damage": 80,
    "skill_name": "风火无边",
    "damage_type": "刺伤"
  ]),

  ([ "action":
    "$N微一反身，己使出" + HIR "「天火燎原」" + NOR "，枪尖舞出万朵火花，只见红光闪闪，\n" +
    "$n被罩入一片红光之中",
    "damage": 80,
    "dodge": 15,
    "parry": 0,
    "skill_name": "天火燎原",

    "damage_type": "刺伤"
  ]),

  ([ "action": "$N使出一招" + HIB "「双龙吐焰」" + NOR "，枪掌并错，两道内力交叉攻向$n的$l",
    "skill_name": "双龙吐焰",
    "dodge": 40,
    "damage": 70,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一招" + HIY "「枪山火海」" + NOR "，枪身狂舞，顿时万千道内力从四面八方攻向$n",
    "skill_name": "枪山火海",
    "dodge": 20,
    "damage": 100,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一招" + HIG "「浴火凤凰」" + NOR "，左臂回收，右手枪引内力直刺$n的$l",
    "skill_name": "浴火凤凰",
    "dodge": 20,
    "damage": 80,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出一招" + HIW "「火内莲花」" + NOR "，枪尖前指，一道内劲如排山倒海般攻向$n",
    "skill_name": "火内莲花",
    "dodge": 10,
    "damage": 70,
    "damage_type": "刺伤",
  ]),
});


int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练火焰枪。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "spear")
    return notify_fail("你必须先找一柄枪才能练枪法。\n");

  return 1;
}

int valid_enable(string usage) {
  return (usage == "spear") || (usage == "parry");
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");

  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 5)
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  write("你按着所学练了一遍火焰枪。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("yaomo") + "/kusong/huoyan-spear/" + func;
}
