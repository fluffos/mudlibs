// lieyan-dao.c 烈焰刀
/*
黑龙现身 万水千山 横扫千里 左右开弓 
百丈飞瀑 直摧万马 怪蟒翻身 力劈华山
*/
inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action": "$N一招 " + HIG "「黑龙现身」 " + NOR "$w有如一条黑龙在$n的周身旋游，勿快勿慢，变化若神",
    "force": 80,
    "dodge": 10,
    "damage": 20,
    "skill_name": "黑龙现身",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招 " + HIG "「万水千山」 " + NOR "左右腿一前一后，$w乱披风势向$n的$l斩去",
    "force": 90,
    "dodge": 10,
    "damage": 30,
    "skill_name": "万水千山",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N纵身跃落，一招 " + HIG "「横扫千里」 " + NOR "$w带着疾风呼的一声便向$n横扫过去",
    "force": 110,
    "dodge": 20,
    "damage": 40,
    "skill_name": "横扫千里",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招 " + HIG "「左右开弓」 " + NOR "$w大开大阖，左右并进，左一刀，右一刀向$n的两肩砍落",
    "force": 100,
    "dodge": 20,
    "damage": 50,
    "skill_name": "左右开弓",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w自上而下，一招 " + HIG "「百丈飞瀑」 " + NOR "刀光流泻，如一片雪白瀑布砍向$n的头部",
    "force": 100,
    "dodge": 10,
    "damage": 60,
    "skill_name": "百丈飞瀑",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挥舞$w，使出一招 " + HIG "「直摧万马」 " + NOR "上劈下撩，左挡右开，如千军万马般罩向$n",
    "force": 100,
    "dodge": 20,
    "damage": 70,
    "skill_name": "直摧万马",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N带得刀风劲疾，一招 " + HIG "「怪蟒翻身」 " + NOR "一个猛转身，连刀带人往$n的$l的劈去",
    "force": 100,
    "dodge": 10,
    "damage": 80,
    "skill_name": "怪蟒翻身",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N向前一个弓步，一招 " + HIG "「力劈华山」 " + NOR "$w直直的劈出，一片流光般的刀影向$n的全身罩去",
    "force": 100,
    "dodge": 20,
    "damage": 90,
    "skill_name": "力劈华山",
    "damage_type": "割伤"
  ]),
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_foece") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 20)
    return notify_fail("你的圣火神功火候太浅。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;
  int lvl = me->query_skill("lieyan-dao", 1);
  int i = sizeof(action);
  while (i--) if (lvl == action[i]["lvl"]) return 0;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不够练烈焰刀。\n");
  me->receive_damage("sen", 25);
  return 1;
}
string perform_action_file(string func) {
  return CLASS_D("mingjiao") + "/lieyan-dao/" + func;
}
