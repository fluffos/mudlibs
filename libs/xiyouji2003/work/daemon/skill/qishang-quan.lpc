// qishang-quan.c -七伤拳
/*
金戈铁马 木已成舟 水中捞月 火海刀山 
土载万物 阴风惨惨 阳光普照 七者皆伤
*/
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N气凝如山，一式 " + HIW "「金戈铁马」 " + NOR "双拳蓄势而发，击向$n的$l",
    "force": 130,
    "dodge": 20,
    "parry": 20,
    "damage": 90,
    "skill_name": "金戈铁马",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形凝重，劲发腰背，一式 " + HIW "「木已成舟」 " + NOR "缓缓向$n推出",
    "force": 100,
    "dodge": 20,
    "parry": 20,
    "damage": 50,
    "skill_name": "木已成舟",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N步伐轻灵，两臂伸舒如鞭，一式 " + HIW "「水中捞月」 " + NOR "令$n无可躲闪",
    "force": 100,
    "dodge": 20,
    "parry": 20,
    "damage": 100,
    "skill_name": "水中捞月",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形跃起，一式 " + HIW "「火海刀山」 " + NOR "双拳当空击下，势不可挡",
    "force": 120,
    "dodge": 20,
    "parry": 20,
    "damage": 100,
    "skill_name": "火海刀山",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一矮，一式 " + HIW "「土载万物」 " + NOR "两拳自下而上，攻向$n",
    "force": 110,
    "dodge": 20,
    "parry": 20,
    "damage": 90,
    "skill_name": "土载万物",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一转，一式 " + HIW "「阴风惨惨」 " + NOR "攻向$n的身前身后",
    "force": 130,
    "dodge": 25,
    "parry": 20,
    "damage": 100,
    "skill_name": "阴风惨惨",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N移形换位，步到拳到，一式 " + HIW "「阳光普照」 " + NOR "四面八方都是拳影",
    "force": 100,
    "dodge": 10,
    "parry": 20,
    "damage": 90,
    "skill_name": "阳光普照",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N长啸一声，向前踏出一步，双拳中宫直进，一式 " + HIW "「七者皆伤」 " + NOR "骤然击向$n的前胸",
    "force": 120,
    "dodge": 20,
    "parry": 20,
    "damage": 90,
    "skill_name": "七者皆伤",
    "damage_type": "内伤"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练七伤拳必须空手。\n");
  if ((string)me->query("family/family_name") != "明教")
    return notify_fail("你并非明教弟子，不能学习七伤拳。\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力太弱，无法练七伤拳。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气血太低了。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练七伤拳。\n");
  me->add("force", -10);
  me->add("kee", -10);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (random(me->query_skill("qishang-quan", 1)) > 100)
    victim->apply_condition(
      "qishang_poison",
      random(me->query_skill(
        "qishang-quan",
        1
      ) / 15) + 1 + victim->query_condition("qishang_poison")
    );
}

string perform_action_file(string action) {
  return CLASS_D("mingjiao") + "/qishang-quan/" + action;
}
