//By waiwai@xyj-shxy 2000/07/23
/*
飞流直下  逶迤盘桓  一波三折  潭水潺潺  细水常流
深谷喷泉  水复山穷  流润翠微  覆水能收
*/
#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({
  "$n一招" + HIC "「飞流直下」" + NOR "身形一飘，有如飞瀑，直退出数丈之外。\n",
  "$n步法翩翩，身影左躲右闪，，一式" + HIY "「逶迤盘桓」" + NOR "避开$N的锋芒。\n",
  "$n腾空而起，身形在空中连换三个方向，一式" + HIG "「一波三折」" + NOR "，轻轻松松地闪过。\n",
  "$n步法连绵，身形连续晃动，一招" + HIM "「潭水潺潺」" + NOR "腾空而起，避了开去。\n",
  "$n身似流水，向旁跃出三尺，一招" + HIB "「细水常流」" + NOR "，身子轻轻飘了开去。\n",
  "$n腰身一矮，却突然腾空跃起，" + HIC "「深谷喷泉」" + NOR "轻轻闪过。\n",
  "但是$n一招" + HIR "「水复山穷」" + NOR "使出，早已绕到$N身後！\n",
  "但是$n身形飘忽，轻轻一纵，一招" + HIM "「流润翠微」" + NOR "，避开这一击。\n",
  "$n身形往上一拔，一招" + HIY "「覆水能收」" + NOR "，一个转折落在数尺之外。\n",

});

int valid_enable(string usage) {
  return (usage == "dodge");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练流泉步。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练流泉步。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("yaomo") + "/bibotan/liuquan-steps/" + func;
}
