// force.c

#include <ansi.h>

inherit SKILL;

int valid_learn(object me) { return 1; }

string exert_function_file(string func)
{
        return "/daemon/class/force/" + func;
}

string level_description(int level)
{
	int grade;
	string *level_desc = ({
		BLU "若有若无" NOR,
		BLU "初窥门径" NOR,
		BLU "略知一二" NOR,
		YEL "渐入佳境" NOR,
		YEL "初通任脉" NOR,
		YEL "气息悠长" NOR,
		HIY "初通督脉" NOR,
		HIY "生生不绝" NOR,
		HIY "英华内敛" NOR,
		CYN "通关在即" NOR,
		CYN "豁然贯通" NOR,
		CYN "贯通任督" NOR,
		HIC "举世无双" NOR,
		HIC "震古铄今" NOR,
		HIC "一代大师" NOR,
		HIW "深不可测" NOR
	});

	grade = level / 65;//24

	if( grade >= sizeof(level_desc) )
		grade = sizeof(level_desc)-1;
	return level_desc[grade];
}
