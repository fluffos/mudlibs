#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N单腿微曲，忽的向前扑出，一式「右直拳」，右拳直出，击向$n的脑袋！\n",
    "force": 100,
    "dodge": 5,
    "damage": 10,
    "damage_type": "拳伤",
    "lvl": 0,
    "skill_name": "右直拳"
  ]),
  ([ "action": "$N左手虚晃，一式「右勾拳」，右手直击，反击$n的左耳\n",
    "force": 100,
    "dodge": 10,
    "damage": 20,
    "lvl": 8,
    "skill_name": "右勾拳",
    "damage_type": "拳伤"
  ]),
  ([ "action": "$N左臂前伸，右臂后曲，一式「右摆拳」，攻向$n的面侧\n",
    "force": 230,
    "dodge": 10,
    "damage": 25,
    "lvl": 16,
    "skill_name": "右摆拳",
    "damage_type": "拳伤"
  ]),
  ([ "action": "$N忽然向后一纵，使一式「右勾拳」，右拳从下方一拳向$n的下巴击去\n",
    "force": 130,
    "dodge": 25,
    "damage": 20,
    "lvl": 24,
    "skill_name": "右勾拳",
    "damage_type": "拳伤"
  ]),
  ([ "action": "$N猛吸一口气，一弯腰右拳护住面部，使一式「左摆拳」，左拳带着风声击向$n的右面部\n",
    "force": 120,
    "dodge": 15,
    "damage": 10,
    "lvl": 32,
    "skill_name": "左摆拳",
    "damage_type": "拳伤"
  ]),
  ([ "action": "$N猛的向上高高跃起，一套「组合拳」使出，双拳如雨点般击向$n的头部\n",
    "force": 290,
    "dodge": 20,
    "damage": 50,
    "lvl": 40,
    "skill_name": "组合拳",
    "damage_type": "拳伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) { return notify_fail(WHT "NPC武功，不对玩家开放。\n" NOR); }

