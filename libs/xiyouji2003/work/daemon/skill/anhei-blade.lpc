inherit SKILL;
#include <ansi.h>

string *msgl = ({
  "$N一式 " HIM "「勾魂夺魄」 " NOR "忽地放手，$w的尾端向上弹起，以意想不到方位呼的向$n拍去",
  "$N平平一令击出，一式 " + HIM "「天罗地网」" + NOR " $w在半空古古怪怪的转了个弯，打向$n的$l",
  "$N突然一声清啸，双令一招 " HIM "「三虚七实」 " NOR "虚虚实实，是是而非的击向$n的$l",
  "$N忽然低头，一式 " + HIM "「厉鬼缠身」 " + NOR "一个头锤向$n撞去，手中$w却暗中的向$n的$l击去",
  "$N突然纵身而起，一式 " HIM "「翻江倒海」 " NOR "连翻三个空心筋斗，白光忽闪，一令向$n的$l砸去",
  "$N坐地锤胸，一式 " HIM "「瞒天过海」 " NOR "呼天抢地的哭号，突然间脚踢飞沙，抽出$w向$n疾刺",
  "$N默念口诀，$w一招 " HIM "「应左则后」 " NOR "明指前胸，突地一转弯，向$n的背心大穴砸去",
  "$N使出一式 " HIM "「须右仍前」 " NOR "凌空虚点$n右臂，$w却向对方胸前大穴刺去",
  "$N一招 " HIM "「无中生有」 " NOR "不知如何，手中已经多出一块$w，手腕一摆，快速无比的刺向$n的$l",
  "$N手中的$w划出一个个的圈子，这招 " HIM "「饿鬼拦路」 " + NOR "一出，顿时裹得$n眼花缭乱，不知所措"
});
string *msgc = ({
  "$N反守为攻，一招" HIM " 「风卷残云」 " NOR "身体斜飞，连环的向$n踢出四脚",
  "$N一式 " HIM "「坐地求全」 " + NOR "忽地在地上一坐，左手抱向$n的$l，右手击向“中都”穴",
  "$N突然间一式 " + HIM " 「以进为退」 " NOR "接着向前一个空心筋斗，凌空落下，双足向$n$l踢去",
  "$N呼的一声，一式 " HIM "「青面缭牙」 " NOR "纵身半空翻了几个空心筋斗，伸臂向$n的$l抓去",
  "$N一个筋斗，一式 " HIM "「群魔乱舞」 " NOR "身在半空，落下时右脚的膝盖在$n关顶一脆",
  "$N向前一坐，一式 " HIM "「鬼影幢幢」 " NOR "撞入$n的怀中，双肘向$n$l的穴道撞去",
  "$N坐地锤胸，一式 " HIM "「飞沙走石」 " NOR "呼天抢地的哭号，突然间脚踢飞沙，单手向$n疾点"
});

int valid_enable(string usage) {
  return usage == "blade" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if (!weapon)
    return ([
      "action": msgc[random(sizeof(msgc))],
      "damage": (random(3) + 1) * 40,
      "damage_type": "瘀伤",
      "dodge": random(50) - random(8),
      "force": random(50) + 50
    ]);
  if (weapon->query("id") == "blade")
    return ([
      "action": msgl[random(sizeof(msgl))],
      "damage": (random(3) + 1) * 45,
      "damage_type": random(2) ? "刺伤" : "割伤",
      "dodge": random(50) - random(10),
      "force": random(50) + 50,
      "post_action":
      (: call_other, WEAPON_D, "bash_weapon" :)
    ]);
  return ([
    "action": "$N挥舞$w对准$n$l一阵乱砍",
    "damage": 30,
    "damage_type": "割伤",
    "dodge": 30,
    "parry": 20,

  ]);
}

string perform_action_file(string func) {
  return CLASS_D("anhei") + "/anhei-blade/" + func;
}
