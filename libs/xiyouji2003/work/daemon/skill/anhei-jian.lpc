inherit SKILL;
#include <ansi.h>

mapping *action = ({
([      "action" : "$N一招 "HIY"「四海云飘」 "NOR"$w似幻出片片白云，四面八方的罩向$n",
        "force" : 70,
        "dodge" : 15,
        "damage" : 20,
        "skill_name" : "四海云飘",
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招 "HIY"「四通八达」 "NOR"剑锋乱指，攻向$n，$n根本不能分辩$w的来路",
        "force" : 90,
        "dodge" : 10,
        "damage" : 30,
        "skill_name" : "四通八达",
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出 "HIY"「在天一方」 "NOR"$w幻一条飞练，带着一股寒气划向$n的$l",
        "force" : 110,
        "dodge" : 10,
        "damage" : 40,
        "skill_name" : "在天一方",
        "damage_type" : "刺伤"
]),
([      "action" : "$N身子向上弹起，左手下指，一招 "HIY"「怪蟒翻身」 "NOR"右手$w带着一团剑花，逼向$n的$l",
        "force" : 130,
        "dodge" : 5,
        "damage" : 50,
        "skill_name" : "怪蟒翻身",
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招 "HIY"「飞瀑倒悬」 "NOR"左脚跃步落地，右手$w幻成一条雪白的瀑布，扫向$n的$l",
        "force" : 150,
        "dodge" : 5,
        "damage" : 60,
        "skill_name" : "飞瀑倒悬",
        "damage_type" : "刺伤"
]),
([      "action" : "$N右腿半屈般蹲，$w平指，一招 "HIY"「无声无色」 "NOR"剑尖无声无色的慢慢的刺向$n的$l",
        "force" : 170,
        "dodge" : 15,
        "damage" : 70,
        "skill_name" : "无声无色",
        "damage_type" : "刺伤"
]),
([  "action" : "$N一招 "HIY"「万川归海」 "NOR"$w在$n的周身飞舞，令$n眼花缭乱，剑身在半空中突然停住刺向$n的$l",
        "force" : 200,
        "dodge" : 5,
        "damage" : 80,
        "skill_name" : "万川归海",
        "damage_type" : "刺伤"
]),
});


int valid_enable(string usage)
{
	return usage=="sword"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

string perform_action_file(string func)
{
return CLASS_D("anhei") + "/anhei-jian/" + func;
}
