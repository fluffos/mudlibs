// 设置query_action在系统里面需要
// 改写attack的reset_action以及combatd.
// 一般的问题大多是reset_action设置不好以及
// 下面的perform_action_file问题.
// this sample's weapon it's no_break.
mapping query_action(object me, object weapon)
{ 
return ([
"action":weapon->query("no_break")?WHT+msg2[random(sizeof(msg2))]+NOR:msg[random(sizeof(msg))],
"damage":weapon->query("no_break")?(random(3)+2)*80:(random(4)+1)*20, 
"damage_type": random(5)?"刺伤":"割伤", 
"dodge": random(30)+10, 
"force": random(40)+60,
]);
}

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 50 )
		return notify_fail("你的内力修为不够深，无法学习百鸟剑法。\n");
	if (!(ob = me->query_temp("weapon"))
	   || (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一柄剑才能练习剑法。\n");
	return 1;
}

int practice_skill(object me)
{
	int dod=(int)me->query_skill("dodge");
	int skill=(int)me->query_skill("bainiao-jian");

	if (dod<skill/2)
		return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
	if ((int)me->query("kee") < 30)
		return notify_fail("你体质欠佳，强练百鸟剑法有害无益。\n");
	if ((int)me->query("force") < 10)
		return notify_fail("你内力不足，强练百鸟剑法有走火入魔的危险。\n");
	me->receive_damage("kee", 30);
	me->add("force", -10);
	message_vision("$N默默回忆了一会儿，然后练了一遍百鸟剑法。\n", me);
	return 1;
}

int valid_enable(string usage)
{
	return (usage=="sword") || (usage=="throwing") || (usage=="parry");
}
