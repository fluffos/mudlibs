// 这里最好改写老的weapond.使之能够更好地支持效果.
// 并加入weapon的no_break参数.使得"神器"类武器不会
// 被斩断.另外需要注意的是以前的老的break weapon里
// 面缺少ob->set("liquid", 0);的设置.
mixed hit_ob(object me, object victim, int damage_bonus)
{
    string name;
    int skill, damage;
    object weapon, weapon1;     
	 name = xue_name[random(sizeof(xue_name))];
    weapon = me->query_temp("weapon");
    weapon1 = victim->query_temp("weapon");
    skill = me->query_skill("bainiao-jian", 1);

    if( damage_bonus < 100 ) return 0;
    
     if( victim->query("force")>100 && skill > 100 &&
       me->query_skill_mapped("parry") == "bainiao-jian" &&
       me->query("force") > 400 && me->query("max_force") > 1200 &&
       skill > random(victim->query_skill("parry",1))) {
       if (random(20)>10){
	      switch(random(4)) {
            case 0 :
               message_vision(HIG"$N"+weapon->name()+HIG"连环刺出，绵绵而不绝。\n"NOR,me, victim);
               victim->start_busy(random(2));
			   if (!random(2))
			   message_vision(HIR"$n"HIR"抽身稍慢，被"+weapon->name()+HIR"在左肩部硬削了一剑，疼的咬牙切齿。\n"NOR,me, victim);             
               else
			   message_vision(HIR"$n"HIR"尚未落地，被"+weapon->name()+HIR"反剑一撩，$n"HIR"一歪身被剑身刺中。\n"NOR,me, victim);             
               break;
            case 1 :
                message_vision(WHT"$N"NOR WHT"使出「刺」字诀，挥舞起手中"+weapon->name()+NOR WHT"如狂风暴雨般的刺去！\n"NOR,me, victim);
                damage = damage_bonus/10 + random(damage_bonus)/5;
                victim->receive_danage("kee",damage/4);
				victim->receive_wound("kee", damage/4);
                me->add("force", -damage/8);
			    break;
			case 2 :
              message_vision( HIG"$N"HIG"使出「削」字诀，手中"+weapon->name()+HIG"忽左忽右，招招向$n"HIG"的全身削去！\n"NOR,me, victim);
                damage = damage_bonus/5 + random(damage_bonus)/10;
                victim->receive_wound("kee", damage/2);
                me->add("force", -damage/6);
              break;
            case 3 :
             message_vision( HIG"$N"HIG"剑法再变，使出了「转」字诀。但见"+weapon->name()+HIG"化成了一团剑影，猛然点向$n"HIG"的"HIB+name+" \n"NOR,me, victim);
			   if((!random(5))) {
				victim->start_busy(random(2));
				me->add("force",-40);
				victim->receive_damage("kee", me->query_skill("bainiao-jian",1)/5+damage_bonus/5);
				victim->receive_wound("kee", me->query_skill("bainiao-jian",1)/10+damage_bonus/5);       
				 message_vision(HIR"$n"HIR"被"+weapon->name()+HIR"点中"HIB+name+HIR"，只觉气息有些不畅！\n" NOR,me, victim);
       			}                 
               break;
            }
           } else if (weapon1 && random(20)<10) {
             switch(random(2)){
		case 0 :
		if (random(2)!=1){ 
		message_vision( HIB"$N"+weapon->name()+HIB"疾翻，搭在"+weapon1->name()+
				HIB"尺许之处，运起「引」字诀，顺势向外牵引! \n"NOR,me, victim);
		} else {
              message_vision( HIC"$N"+weapon->name()+HIC"缩回，使起「夺」字诀，搭住"+weapon1->name()+
				HIC"向上甩出，将$n"HIC"疾奔的力道传到"+weapon1->name()+HIC"上! \n"NOR,me, victim);
		}
		victim->start_busy(random(2));
		if (!random(4)){
		message_vision( HIR"$n"HIR"只感"+weapon1->name()+
				HIR"似欲脱手飞出，一个把握不住，手中兵器脱手而飞。\n"NOR, me, victim);            
               weapon1->unequip();
               weapon1->move(environment(victim));
		}
		break;
		case 1 :
              message_vision( HIG"$N"HIG"使个「粘」字诀,"+weapon1->name()+HIG"挥向左，"+weapon->name()+
				HIG"跟向左，"+weapon1->name()+HIG"打到右，\n"+weapon->name()+
				HIG"随到右，如影随形，借力制敌。。。\n"NOR, me,victim);
               damage = damage_bonus/10 + random(damage_bonus)/5;
			if ((int)victim->query("sen")<=damage) 
				 { victim->add("sen",-500); }
				 else { victim->receive_damage("sen", damage); }
                victim->start_busy(random(3));  
                me->add("foece", -damage/6);    
			   break;
			  }
		  }
           }
}

string perform_action_file(string action)
{
        return CLASS_D("yaomo") + "/xueshan/bainiao-jian/"+action;
}

int ob_hit(object ob, object me, int damage)
{ 
message_vision(HIY"眼看$N"HIY"这一招正要击中$n，却被莫名的力道一带，偏开了寸许！\n"NOR, ob,me); 
return -damage/2;  
}
