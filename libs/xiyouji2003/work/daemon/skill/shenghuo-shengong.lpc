int valid_learn(object me)
{
	int lvl = (int)me->query_skill("shenghuo-shengong", 1);

	if ((int)me->query_skill("force", 1) < 10)
		return notify_fail("你的基本内功火候还不够，还不能学习圣火神功。\n");
      if((int)me->query("PKS", 1) > 0) 
        return notify_fail("你杀过人，无法继续学习。\n");

	if (
	me->query_skill("pingtian-dafa",1)//火云
	|| me->query_skill("huomoforce",1)//火云
	|| me->query_skill("huaxue-dafa",1)//碧波潭
	|| me->query_skill("huaxue-force",1)//碧波潭
	|| me->query_skill("dengxian-dafa",1)//雪山
	|| me->query_skill("ningxie-force",1)//雪山
	|| me->query_skill("taiyi",1)//五庄观
	|| me->query_skill("zhenyuan-force",1)//五庄观
	|| me->query_skill("moonforce",1)//月宫
	|| me->query_skill("moonshentong",1)//月宫
	|| me->query_skill("tonsillit",1)//地府
	|| me->query_skill("gouhunshu",1)//地府
	|| me->query_skill("buddhism",1)//普陀
	|| me->query_skill("lotusforce",1)//普陀
	|| me->query_skill("fofa",1)//天蓬
	|| me->query_skill("wuneng-force",1)//天蓬
	|| me->query_skill("lengquan-force",1)//将军府
	|| me->query_skill("baguazhou",1)//将军府
	|| me->query_skill("huntian-qigong",1)//无底洞
	|| me->query_skill("yaofa",1)//无底洞
	|| me->query_skill("huntianqigong",1)//丐帮
	|| me->query_skill("jiuyang-shengong",1)//丐帮
	|| me->query_skill("seashentong",1)//龙宫
	|| me->query_skill("dragonforce",1)//龙宫
	|| me->query_skill("dao",1)//方寸
	|| me->query_skill("wuxiangforce",1) )//方寸

		return notify_fail("你不先散了别派内功，怎能学圣火神功？！\n");
	return 1;
}


int practice_skill(object me)
{
	return notify_fail("圣火神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("mingjiao") + "/shenghuo-shengong/" + func;
}


