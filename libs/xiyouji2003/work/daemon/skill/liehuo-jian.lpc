// liehuo-jian.c 烈火剑
/*
四海云飘 四通八达 在天一方 怪蟒翻身
飞瀑倒悬 无声无色 万川归海
*/

inherit SKILL;
#include <ansi.h>

mapping *action = ({
([      "action" : "$N一招 "+HIY"「四海云飘」 "+NOR"$w似幻出片片白云，四面八方的罩向$n",
        "force" : 70,
        "dodge" : 15,
        "damage" : 20,
        "skill_name" : "四海云飘",
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招 "+HIY"「四通八达」 "+NOR"剑锋乱指，攻向$n，$n根本不能分辩$w的来路",
        "force" : 90,
        "dodge" : 10,
        "damage" : 30,
        "skill_name" : "四通八达",
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出 "+HIY"「在天一方」 "+NOR"$w幻一条飞练，带着一股寒气划向$n的$l",
        "force" : 110,
        "dodge" : 10,
        "damage" : 40,
        "skill_name" : "在天一方",
        "damage_type" : "刺伤"
]),
([      "action" : "$N身子向上弹起，左手下指，一招 "+HIY"「怪蟒翻身」 "+NOR"右手$w带着一团剑花，逼向$n的$l",
        "force" : 130,
        "dodge" : 5,
        "damage" : 50,
        "skill_name" : "怪蟒翻身",
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招 "+HIY"「飞瀑倒悬」 "+NOR"左脚跃步落地，右手$w幻成一条雪白的瀑布，扫向$n的$l",
        "force" : 150,
        "dodge" : 5,
        "damage" : 60,
        "skill_name" : "飞瀑倒悬",
        "damage_type" : "刺伤"
]),
([      "action" : "$N右腿半屈般蹲，$w平指，一招 "+HIY"「无声无色」 "+NOR"剑尖无声无色的慢慢的刺向$n的$l",
        "force" : 170,
        "dodge" : 15,
        "damage" : 70,
        "skill_name" : "无声无色",
        "damage_type" : "刺伤"
]),
([  "action" : "$N一招 "+HIY"「万川归海」 "+NOR"$w在$n的周身飞舞，令$n眼花缭乱，剑身在半空中突然停住刺向$n的$l",
        "force" : 200,
        "dodge" : 5,
        "damage" : 80,
        "skill_name" : "万川归海",
        "damage_type" : "刺伤"
]),
});



int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 50 )
		return notify_fail("你的内力修为不够深，无法学习烈火剑。\n");
	if (!(ob = me->query_temp("weapon"))
	   || (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一柄剑才能练习剑法。\n");
	return 1;
}

int practice_skill(object me)
{
	int dod=(int)me->query_skill("dodge");
	int swo=(int)me->query_skill("liehuo-jian");

	if (dod<swo/2)
		return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
	if ((int)me->query("kee") < 30)
		return notify_fail("你体质欠佳，强练烈火剑法有害无益。\n");
	if ((int)me->query("force") < 5)
		return notify_fail("你内力不足，强练烈火剑法有走火入魔的危险。\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	message_vision("$N默默回忆了一会儿，然后练了一遍烈火剑法。\n", me);
	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
string perform_action_file(string func)
{
return CLASS_D("mingjiao") + "/liehuo-jian/" + func;
}
