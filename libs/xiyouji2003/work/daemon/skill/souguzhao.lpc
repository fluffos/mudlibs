#include <ansi.h>

inherit SKILL;

mapping *action = ({
([	"action" : "\n$N双臂一拢，左爪直攻$n下盘，右爪却挟风雷之势推向$n腰间，一虚一实，正是一招"HIY"「推爪式」"NOR,
	"force" : 100,
	"dodge" : 5,
	"damage_type" : "抓伤",
	"damage" : 35,
	"skill_name" : "推爪式"
]),
([	"action" : "\n$N身形陡起，如雄鹰击日般“倏”地从$n头顶越过，使一招"HIY"「盖爪式」"+NOR"双爪疾向$n脑后击下",
	"force" : 90,
	"dodge" : 5,
	"damage_type" : "抓伤",
	"damage" : 45,
	"skill_name" : "盖爪式"
]),
([	"action" : "\n$N就地一滚，突然到了$n身前，使一招"HIY"「掏爪式」"+NOR"，右爪直奔$n小腹",
	"force" : 85,
	"dodge" : 5,
	"damage_type" : "抓伤",
	"damage" : 55,
	"skill_name" : "掏爪式"
]),
([	"action" : "\n$N左爪护胸，右爪凝劲后发，一招"HIY"「托爪式」"+NOR"，缓缓托向$n的$l",
	"force" : 75,
	"dodge" : 5,
	"damage_type" : "抓伤",
	"damage" : 40 ,
	"skill_name" : "托爪式"
]),
([	"action" : "\n$N身形诡异，疾速前扑，使一招"HIY"「撩爪式」"+NOR"，直撩$n裆部",
	"force" : 80,
	"dodge" : 15,
	"damage_type" : "抓伤",
	"damage" : 25,
	"skill_name" : "撩爪式"
]),
([	"action" : "\n$N身形飘忽，陡然转到$n身后，一招"HIY"「锁爪式」"+NOR"，双爪直向$n咽喉插下",
	"force" : 60,
	"dodge" : 15,
	"damage_type" : "抓伤",
	"damage" : 35,
	"skill_name" : "锁爪式"
]),
([	"action" : "\n$N一声厉啸，身形拔起，使出"HIY"「千爪式」"+NOR"，由半空盘旋下击，$n顿觉漫天爪影，罩向全身死穴",
	"force" : 65,
	"dodge" : 20,
	"damage_type" : "抓伤",
	"damage" : 45,
	"skill_name" : "千爪式"
])
});

int valid_learn(object me)
{
	
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练搜骨爪法必须空手。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed"|| usage == "parry";
}

mapping query_action(object me, object weapon)
{
        int i;
        i=me->query_temp("souguzhao_per");
        if( !me->query_temp("souguzhao_per") ) {
        return action[random(6)];
        }else {
        return action[i];
        }
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习搜骨爪法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按着所学练了一遍搜骨爪法。\n");
        return 1;

}

string perform_action_file(string func)
{
return CLASS_D("tianpeng") + "/souguzhao/" + func;
}

