});

int valid_enable(string usage)
{
	return (usage=="unarmed") || (usage=="parry");
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练寒毒掌必须空手。\n");
	if ((int)me->query_skill("ningxie-force", 1) < 100)
		return notify_fail("你的冰谷凝血功火候不够，无法学寒毒掌。\n");
	if ((int)me->query_skill("dengxian-dafa", 1) < 100)
		return notify_fail("你的登仙大法火候不够，无法学寒毒掌。\n");
	if ((int)me->query_skill("xiaoyaoyou", 1) < 100)
		return notify_fail("你的逍遥游火候不够，无法学寒毒掌。\n");
	if((int)me->query("combat_exp", 1) < 1000000)
        	return notify_fail(HIC"你的武学不够，不能学寒毒掌！\n"NOR);

	if ((int)me->query("max_force") < 1500)
		return notify_fail("你的内力太弱，无法练寒毒掌。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("kee") < 100)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("force") < 200)
		return notify_fail("你的内力不够练寒毒掌。\n");
	me->receive_damage("kee", 100);
	me->add("force", -100);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        if( random(me->query_skill("handuzhang")) > 100 && victim->query("no_poison") ) {
                victim->apply_condition("hdice_poison", random(2) + 1 +
                        victim->query_condition("hdice_poison"));
        }
}


string perform_action_file(string func)
{
return CLASS_D("yaomo") + "/xueshan/handuzhang/" + func;
}
