// 碧波掌法
/*
月影蜻蜓空点水 黄昏伊人独自愁 枯松一带伤心碧 碧波雪落覆白萍 玉石俱焚潭水寒
妄自抽刀断水流 云破月来水弄影 花开堪折直须折 红颜未老恩先绝 虚妄笑红花自落
*/

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招" + HIW "「月影蜻蜓空点水」" + NOR "，双手横挥，抓向$n",
    "force": 130,
    "dodge": 20,
    "damage": 15,
    "lvl": 0,
    "skill_name": "月影蜻蜓空点水",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIW "「黄昏伊人独自愁」" + NOR "，身子跃然而起，抓向$n的头部",
    "force": 150,
    "dodge": 20,
    "damage": 20,
    "lvl": 10,
    "skill_name": "黄昏伊人独自愁",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIW "「枯松一带伤心碧」" + NOR "，双手纷飞，$n只觉眼花缭乱",
    "force": 150,
    "dodge": 30,
    "damage": 30,
    "lvl": 30,
    "skill_name": "枯松一带伤心碧",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIW "「碧波雪落覆白萍」" + NOR "，双手合击，$n只觉无处可避",
    "force": 150,
    "dodge": 30,
    "damage": 45,
    "lvl": 40,
    "skill_name": "碧波雪落覆白萍",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIW "「妄自抽刀断水流」" + NOR "，双手飘然抓向$n",
    "force": 250,
    "dodge": 30,
    "damage": 50,
    "lvl": 50,
    "skill_name": "妄自抽刀断水流",
    "damage_type": "瘀伤"
  ]),

  ([ "action": "$N双手平举，一招" + HIW "「云破月来水弄影」" + NOR "击向$n",
    "force": 300,
    "dodge": 35,
    "damage": 80,
    "lvl": 60,
    "skill_name": "云破月来水弄影",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIW "「花开堪折直须折」" + NOR "，拿向$n，似乎$n的全身都被笼罩",
    "force": 350,
    "dodge": 30,
    "damage": 100,
    "lvl": 70,
    "skill_name": "花开堪折直须折",
    "damage_type": "内伤"
  ]),

  ([ "action": "$N左手虚晃，右手一记" + HIW "「红颜未老恩先绝」" + NOR "击向$n的头部",
    "force": 350,
    "dodge": 30,
    "damage": 150,
    "lvl": 80,
    "skill_name": "红颜未老恩先绝",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N施出" + HIW "「虚妄笑红花自落」" + NOR "，右手横扫$n的$l，左手攻向$n的胸口",
    "force": 400,
    "dodge": -10,
    "damage": 150,
    "lvl": 90,
    "skill_name": "虚妄笑红花自落",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N施出" + HIW "「玉石俱焚潭水寒」" + NOR "，不顾一切扑向$n",
    "force": 450,
    "dodge": -20,
    "damage": 150,
    "lvl": 100,
    "skill_name": "玉石俱焚潭水寒",
    "damage_type": "瘀伤"
  ])
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练碧波掌法必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够练这门掌法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
int effective_level() { return 10; }

string *parry_msg = ({
  "$n冉冉腾空而起，早以一招" HIR "「花开堪折直须折」" NOR "令$N所有招式都落在空处。\n",

});

string *unarmed_parry_msg = ({
  "$n冉冉腾空而起，早以一招" HIR "「花开堪折直须折」" NOR "令$N所有招式都落在空处。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 320;
}

string perform_action_file(string action) {
  return CLASS_D("yaomo") + "/bibotan/bibo-zhang/" + action;
}
