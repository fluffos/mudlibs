//By dhxy
#include <ansi.h>

inherit SKILL;
mapping *action = ({
  ([ "action": "$N使出雁歌刀法中的起手式" + HIC "［山川萧条］" + NOR "手中的$w划出一溜光芒斩向$n的$l",
    "dodge": -10,
    "parry": -0,
    "damage": 20,
    "skill_name": "山川萧条",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手一抖，一招" + HIC "［孤城落日］" + NOR "手中的$w幻成一片刀花，散向$n的$l",
    "dodge": -10,
    "parry": -10,
    "damage": 20,
    "skill_name": "孤城落日",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N身影晃动，刀锋忽左忽右，一招" + HIC "［大漠穷秋］" + NOR "手中的$w，从中路突然砍至$n的$l",
    "dodge": -10,
    "parry": 10,
    "damage": 20,
    "skill_name": "大漠穷秋",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N的双脚点地，刀背贴身，一招" + HIC "［力尽关山］" + NOR "全身转出一团刀光滚向$n",
    "damage": 20,
    "dodge": -15,
    "parry": 0,
    "skill_name": "力尽关山",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N刀刃向上，一招" + HIC "［边风飘摇］" + NOR "从一个$n意想不到的角度撩向$n的$l",
    "skill_name": "边风飘摇",
    "dodge": -10,
    "parry": 0,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N你手中的$w左右横划，一招" + HIC "［绝域苍茫］" + NOR "来来回回地狂扫向$n的$l",
    "skill_name": "绝域苍茫",
    "dodge": -10,
    "parry": 10,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N使出雁歌刀法中的收手式" + HIC "［乾坤归宗］" + NOR "手中的$w迅捷无比地砍向$n的$l",
    "skill_name": "乾坤归宗",
    "dodge": -10,
    "parry": -10,
    "damage": 20,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 10)
    return notify_fail("你的内功心法火候不足，无法练雁歌刀法。\n");
  if ((int)me->query_skill("zhenyuan-force", 1) < 30)
    return notify_fail("你的镇元神功火候不足，无法练雁歌刀法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 20; }

string *parry_msg = ({
  "$n使出雁歌刀法中的" + HIR "［乾坤归宗］" + NOR "，手中的刀顿时化成" + HIW "九重刀幕" + NOR "护住全身。\n",
});

string *unarmed_parry_msg = ({
  "$n使出雁歌刀法中的" + HIR "［乾坤归宗］" + NOR "手中的刀顿时化成" + HIW "九重刀幕" + NOR "护住全身。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 20;
}

string perform_action_file(string action) {
  return CLASS_D("zhenyuan") + "/yange-blade/" + action;
}
