// 战役之术

#include <ansi.h>

inherit SKILL;

string level_description(int level)
{
	int grade;
	string *level_desc = ({
		BLU "初出茅庐" NOR,     
		HIB "略晓战术" NOR,
		HIB "精通攻防" NOR,     
		CYN "攻城略地" NOR,
		HIC "炉火纯青" NOR,     
		HIW "一代天骄" NOR,
	});

	grade = level / 30;

	if( grade >= sizeof(level_desc) )
		grade = sizeof(level_desc)-1;
	return level_desc[grade];
}

string type() { return "knowledge"; }
