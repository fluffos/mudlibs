#include <ansi.h>

inherit SKILL;


string cast_spell_file(string spell) {
  return "/daemon/class/spells/" + spell;
}

//this does not work yet. check later...cglaem.

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "初具法力" NOR,
    BLU "略知一二" NOR,
    BLU "略晓变化" NOR,
    HIB "渐入佳境" NOR,
    HIB "腾云驾雾" NOR,
    HIB "神出鬼没" NOR,
    YEL "预知祸福" NOR,
    YEL "妙领天机" NOR,
    YEL "呼风唤雨" NOR,
    CYN "负海担山" NOR,
    CYN "移星换斗" NOR,
    CYN "包罗万象" NOR,
    HIC "随心所欲" NOR,
    HIC "变换莫测" NOR,
    HIC "变换无常" NOR,
    HIW "法力无边" NOR
  });

  grade = level / 65;  //24

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}

string type() { return "magic"; }
