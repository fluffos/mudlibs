// Update by waiwai@2002/12/05

#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({
  YEL "可$N 随劲上跃，在空中右腿前伸缠住头顶，整个人倒挂双手成爪，卷向$n 头部。\n" NOR,
  YEL "$N 向前一翻，口中发出咕的怪笑，又如鬼魅般飘向$n ！\n" NOR,
  YEL "$n 急挥掌疾劈！但事已太迟，$N 身法诡异莫测，如游鱼般往下疾窜，双脚发力钳。\n锁在$n 的腰上\n" NOR,
  YEL "$N 熟练地用左手抓住$n 的右腿，右手掌一把抓住$n 的头部。手压头落，$n 被$N 捏颚\n猛力下砸！\n" NOR,
  YEL "$N 冲力千钧，膝顶$n 腰脊，左臂向其下身力压，来个拦腰折体！喀嚓的骨断声，不\n断于耳，听得\n人身发抖胆直寒，$n 己--头破！腰折！\n" NOR,
  YEL "$N 双手中食二指一并，暴露出百道指芒，如水银泻地，无孔不入般疾射$n 全身大小穴位。\n" NOR,
  YEL "$N 双臂猛挥，一排排光束又如雨般疾射而至$n 的面前。\n" NOR,
  YEL "$N 双手运成极强气涡挟带疾风，飞沙走石，向$n 兜头罩去。\n" NOR,
  YEL "$n 倾尽全身功力，凝聚双掌，陡然双掌胀大十倍，原本骨筋暴露的双掌，\n此时竟然幽光莹莹，阴森恐怖，掌力千钧。\n" NOR,
  YEL "$N 仿如观音临世，千手千脚，影象万千，眨眼间己攻出无数漩涡暗劲……\n" NOR,
  YEL "$n 闪身跃上半空。在空中翻身一挺，人如鹰袅扑向$N ，双腿如蟒蛇一般缠住$N 双臂，\n劲力凝聚十指，仿如铁爪狠狠向$N 头部抓下。\n" NOR,
  YEL "$n 五指敦张，聚力成形，劲气急涌，两掌之间电光暴长，随着一声怒吼，一股似刀的劲气直劈$N \n" NOR,
  YEL "$n 一声暴喝，‘紫极劲”所发的“翔龙破体”挟带厉厉萧气，泣鬼惊天，照定$N 腹部狠命击去……\n" NOR,
  YEL "只听$N 发出“呵--”的一声，倏地击出一式“极劲如刚”，\n只见气劲如无数条窜动着的\n火蛇，向$n 周身箭射而去。\n" NOR,
  YEL "$N 身体反旋，凌空一脚，再次猛踢$n $l，只听“轰！”的一声爆响，石破天惊，六条劲气番数攻进$n $l。\n" NOR,
  YEL "$n $l 劲如尖锥疾转，把$N 护身罡劲尽数瓦解，余势直钻向$N 的$l ，\n钻劲把$N 全身筋脉\n冲击的逆转，肌肉绞旋移位，$N 心内一震，忖道：“好残忍的杀人方式！”\n" NOR,
  YEL "$N 己如“魔神横空”横跃而起，“雷神疾电”以迅疾无比的威势凌空疾踢，浑宏无匹的劲气有如沉雷轰向$n \n" NOR,
  YEL "$N 于闪避中迅速进入反击，并抓住稍纵即逝的战机，祭起“菩萨灭”\n十成功力催运至双腿。“菩萨灭顶”以万勇无阻力，用双腿牢牢锁住$n 的$l，吐力狂扭……\n" NOR,
  YEL "只听$N “啊一一一”地一声长啸，手结佛结，祭起全身的劲气化成烈劲，\n纵身跃起丈余，人如火球向$n 凌空压下，“菩萨灭道”千钓劲气形成一条巨大的火龙挟带烈火疾扑$n 。\n" NOR,
  YEL "情急之下，$N 捏准时机，右脚猛力一沉，稳住身形，左脚反蹬，\n朝天脚顺势攻出，$n 淬不及防，$l 被$N 踢个正着。\n" NOR,
  YEL "$N 处乱不惊，$l 一振，“轰天拳”出手，震飞$n 攻向$N 的$l ，堪堪化解危机。\n" NOR,
  YEL "$N 沉身疾吐，劲道陡然暴发，只痛不伤，直把$n 震个人仰马翻。\n" NOR,
  YEL "只见$N 左手挺掌一举，已格开来爪，劲力疾吐“喀--”一声骨响，$n 攻来的五指指缝己被$N 震得崩碎肉裂，惨嚎而退。\n" NOR,
  YEL "$N 劲气急提，纵身一跃，人己在半空，仿如流星，向$n 疾急攻击，\n" NOR,
  YEL "$N 祭起“翔龙破”向$n 发动攻势，人在空中御风而行如神龙翻腾飞舞，张牙舞爪，咄咄气势，先声夺人。\n" NOR,
  YEL "“伏龙噬”甫一出手挟带着排山倒海之势，刹那问只见$N 身影穿棱，拳影迷高，\n威猛铁拳如山洪暴发，势不可阻挡，围定$n 一阵狂轰乱炸，直轰的$n 仿如皮球，滴溜乱转，节节后退。\n" NOR,
  YEL "$n 身体纵地暴弹，一双庞然硕大的巨拳，赫然穿破$N 密集的拳影，向$N 当头击来，\n$N 正全力应付之际，骤见一团黑影盖顶而下，劲气压体生痛，心里暗叫不妙！\n" NOR,
  YEL "$N 对$n 极为反感，出手倍加凌厉，$n 被轰至夫去重心，硕大身躯轰然倒地，\n仿若泰山崩毁，直撞的地面震撼摇动，塌陷碎裂成深深的大坑。\n" NOR,
  YEL "$N 不慌不忙，以“乾坤无定”身法横空反弹，左掌翻飞荡开$n 来爪，顺势直落，右掌急吐，\n一记“乾坤无量”挟带无形罡气重重拍中$n 的天灵盖，砰然响动，清脆玲珑。\n" NOR,
  YEL "$n 临危不乱，双掌合什，催动劲气，反身铁扳倒转，用“逆转乾坤”八成功力猛插$N 脑后死穴。\n" NOR,
  YEL "$N 见$n 嚎叫着攻上来，不等近身，摹地飞身弹上半空，祭起猛烈的罡气，施展出“天火燎原”，\n霎时$N 周身被一个强大的气团所笼罩，强大凛冽的炽热气劲，铺天盖地压向$n 。\n" NOR,
  YEL "$N 疾将劲催运至双腿，攻出“金钟锥”右脚照定$n $l 鼓力狂踢，这雷霆万均的一脚，踢得$n 身形失控，踉跄撼撞地上。\n" NOR,
  YEL "$N 顺势跟进，双臂中途变招，出掌“天火燎原”将攻向$n $l 的双掌转而攻向$l ，$n 胸中一闷，实实吃了两掌。\n" NOR,
  YEL "$n 双臂疾出，一式“驱狗擒鹰”，两手倏忽抠住$N 攻来的$l ，十指抓破皮肤，深抠肉里，将$N 的身躯硬生生扯倒在地。\n" NOR,
});

string query_dodge_msg() {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "笨手笨脚" NOR,
    BLU "笨鸟试飞" NOR,
    BLU "步伐轻盈" NOR,
    HIB "身形灵动" NOR,
    HIB "身轻如燕" NOR,
    HIB "大鹏展翅" NOR,
    YEL "疾若飞鸿" NOR,
    YEL "蜻蜓点水" NOR,
    YEL "踏雪无痕" NOR,
    HIM "登萍渡水" NOR,
    HIM "来去如风" NOR,
    HIM "一泻千里" NOR,
    HIC "移形换影" NOR,
    HIC "如梦似幻" NOR,
    HIC "渡空无物" NOR,
    //		HIR "无我无形" NOR,
    HIW "凌空渡虚" NOR,


  });

  grade = level / 65;  //24

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
