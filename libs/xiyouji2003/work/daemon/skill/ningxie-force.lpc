#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  int lvl = (int)me->query_skill("ningxie-force", 1);

  if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的内功修为还不够高深，无法学习冰谷凝血功。\n");
  if ((int)me->query("PKS", 1) > 0)
    return notify_fail("你杀过人，无法继续学习。\n");

  if (
    me->query_skill("pingtian-dafa", 1)  //火云
    || me->query_skill("huomoforce", 1)  //火云
    || me->query_skill("shenghuo-shengong", 1)  //明教
    || me->query_skill("shenghuo-longfa", 1)  //明教
    || me->query_skill("huaxue-dafa", 1)  //碧波潭
    || me->query_skill("huoxue-force", 1)  //碧波潭
    //	|| me->query_skill("dengxian-dafa",1)//雪山
    //	|| me->query_skill("ningxie-force",1)//雪山
    || me->query_skill("moonforce", 1)  //月宫
    || me->query_skill("moonshentong", 1)  //月宫
    || me->query_skill("moondance", 1)  //月宫
    || me->query_skill("tonsillit", 1)  //地府
    || me->query_skill("gouhunshu", 1)  //地府
    || me->query_skill("buddhism", 1)  //普陀
    || me->query_skill("lotusforce", 1)  //普陀
    || me->query_skill("fofa", 1)  //天蓬
    || me->query_skill("wuneng-force", 1)  //天蓬
    || me->query_skill("lengquan-force", 1)  //将军府
    || me->query_skill("baguazhou", 1)  //将军府
    || me->query_skill("huntian-qigong", 1)  //无底洞
    || me->query_skill("yaofa", 1)  //无底洞
    || me->query_skill("huntianqigong", 1)  //丐帮
    || me->query_skill("jiuyang-shengong", 1)  //丐帮
    || me->query_skill("seashentong", 1)  //龙宫
    || me->query_skill("dragonforce", 1)  //龙宫
    || me->query_skill("taoism", 1)  //蜀山剑派
    || me->query_skill("zixia-shengong", 1)  //蜀山剑派
    || me->query_skill("pansi-dafa", 1)  //花果山盘丝洞
    || me->query_skill("jiuyin-xinjing", 1)  //花果山盘丝洞
    || me->query_skill("taiyi", 1)  //五庄
    || me->query_skill("zhenyuan-force", 1)  //五庄
    || me->query_skill("xuanhu-shentong", 1)  //轩辕古墓
    || me->query_skill("xuanhu-xinfa", 1)  //轩辕古墓
    || me->query_skill("duoqing-force", 1)  //绝情谷
    || me->query_skill("zhiqing-spells", 1)  //绝情谷
    || me->query_skill("dao", 1)  //方寸
    || me->query_skill("wuxiangforce", 1))  //方寸

    return notify_fail("你不先散了别派武功，怎能学冰谷凝血功？！\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("冰谷凝血功只能向师父学，或是从运用(exert)中增加熟练度。\n");
}
string exert_function_file(string func) {
  return CLASS_D("yaomo") + "/xueshan/ningxie-force/" + func;
}

int stage(int level) {
  if (level < 40) return 1;
  else if (level < 80) return 2;
  else if (level < 120) return 3;
  else if (level < 160) return 4;
  else if (level < 200) return 5;
  else if (level < 280) return 6;
  else if (level < 360) return 7;
  else if (level < 420) return 8;
  else if (level < 500) return 9;
  else if (level < 580) return 10;
  else if (level < 660) return 11;
  else if (level < 750) return 12;
  else if (level < 850) return 13;
  else if (level < 950) return 14;
  else return 15;
}

string level_description(int level) {
  if (stage(level) < 3)
    return BLU "第" + chinese_number(stage(level)) + "重  " NOR;
  else if (stage(level) < 5)
    return HIB "第" + chinese_number(stage(level)) + "重  " NOR;
  else if (stage(level) < 8)
    return HIY "第" + chinese_number(stage(level)) + "重  " NOR;
  else if (stage(level) < 11)
    return HIM "第" + chinese_number(stage(level)) + "重  " NOR;
  else if (stage(level) < 15)
    return HIM "第" + chinese_number(stage(level)) + "重" NOR;
  else
    return HIW "第" + chinese_number(stage(level)) + "重" NOR;
}

void skill_improved(object me) {
  //if stage increased, give bonus...?
  int level = (int)me->query_skill("ningxie-force", 1);
  if (stage(level) == stage(level - 1) + 1) {
    //this is to prevent ppls from abondoning skill to get bonus.
    if ((int)me->query("nx-force_bonus") < stage(level)) {
      me->set("nx-force_bonus", stage(level));
      me->set("max_force", (int)me->query("max_force") + stage(level) * 50);
      me->set("maximum_force",
        (int)me->query("maximum_force")
        +stage(level) * 50);
      me->save();
      log_file("ningxie-force-bonus", ctime(time()) + ": "
        +me->query("name") + "(" + me->query("id") + ")"
        + " got neili " + (stage(level) * 50) + ".\n");
      message_vision(HIW "$N突然觉得真气冲顶，飘然欲飞。原来是$N的冰谷凝血功进入了第" HIR +
        chinese_number(stage(level)) + HIW "重境界！\n" NOR, me);
    }
  }
}
