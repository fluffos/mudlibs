// by happ@YS

inherit SKILL;
#include <ansi.h>

void skill_improved(object me) {
  int i = me->query_skill("bingfa", 1);
  if (i > 150 && i % 10 == 0) {
    switch (random(10)) {
      case 0:
        tell_object(me, HIC "你的水淹之计进步了!\n" NOR);
        me->set("bingfa/shuiyan", 1);
        break;

      case 1:
        tell_object(me, HIC "你的强攻之计进步了!\n" NOR);
        me->set("bingfa/qianggong", 1);
        break;

      case 2:
        tell_object(me, HIC "你的迷惑之计进步了!\n" NOR);
        me->set("bingfa/mihuo", 1);
        break;

      case 3:
        tell_object(me, HIC "你的谣言之计进步了!\n" NOR);
        me->set("bingfa/yaoyan", 1);
        break;

      case 4:
        tell_object(me, HIC "你的诱降之计进步了!\n" NOR);
        me->set("bingfa/youxiang", 1);
        break;

      case 5:
        tell_object(me, HIC "你的纵火之计进步了!\n" NOR);
        me->set("bingfa/zonghuo", 1);
        break;
    }
    return;
  }
  return;
}
