// Update by waiwai@2003/04/25

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	if( duration < 1 || me->query("no_poison")>0 ) return 0;

	if( !userp(me) || wizardp(me)) return 0;

	if (file_name(environment(me))!="/d/city/misc/dalao") {
	   tell_object(me,HIY"一名衙门巡捕突然出现在你身边：大胆逃犯你能跑哪里去！\n"NOR);
		message_vision(CYN"一名衙门巡捕突然出现，不由分说，在$N脖子上套上锁链拉了$N就走。\n"NOR,me);
		me->move("/d/city/misc/dalao");
		me->set("summon_time",time()+600);
	}

	me->apply_condition("killer", duration - 1);

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
