// iceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	// Update By waiwai@2001/06/15 让某些Npc不怕用毒
	if( duration < 1 || me->query("no_poison")>0 ) return 0;

	me->apply_condition("mouth_shut", duration - 1);

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
