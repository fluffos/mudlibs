// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  int i, j, damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("此招只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用此招！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

  if ((int)me->query_skill("dragonfight", 1) < 150)
    return notify_fail("你的拳还不够娴熟，还没有办法拳出七斩。\n");

  if ((int)me->query("force", 1) < 800)
    return notify_fail("以你的目前的内力没有办法发出这一招。\n");

  i = random((int)(me->query_skill("dragonfight", 1) / 40));  //30
  if (i < 1) i = 1;
  if (i > 7) i = 7;
  msg = "$N" + HIC "凝神运功，使出“龙星斩”最后的绝招， " HIR + chinese_number(i) + HIC " 股无比强劲的热气呼啸的扑向$n" HIC "身上各大要穴。\n$n" + HIC "急提丹田之气与体内来回撞击的 " HIR + chinese_number(i) + HIC " 股劲气相扩。\n" NOR;

  if (!(me->query("force") < 0)) me->add("force", -i * 10);  //30

  if ((random(me->query_skill("force")) > target->query_skill("force") / 2)) {
    me->start_busy(2);
    target->start_busy(i);
    me->add("force", -200);

    damage = (int)me->query_skill("qishang-quan", 1);

    damage = damage / 2 + random(damage);

    target->receive_damage("kee", (int)((i * (2 * damage)) / 1));
    target->receive_wound("kee", (int)((i * damage) / 1));
    if (!(target->query("force") < 0)) target->add("force", -i * 10);  //20

    msg += HIY "结果" + NOR "$n" + HIY "抵受不住$N的 " HIR + chinese_number(i) + HIY " 种劲气在体内来回的撞击。\n" NOR;

  } else {
    me->start_busy(3);
    msg += CYN "可是" + NOR "$p" + CYN "忙运内力与" + NOR "$P" + CYN "的 " HIR + chinese_number(i) + CYN " 种劲气相撞，把之在体内化之无形。\n" NOR;
    if (!(target->query("force") < 0)) target->add("force", -i * 20);  //50
  }
  message_vision(msg, me, target);
  return 1;
}
