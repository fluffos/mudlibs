// Last modified by waiwai@2001/06/12

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("神龙摆尾只能对战斗中的对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须先放下手中的武器！\n");

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

        if( (int)me->query_skill("dragonfight", 1) < 50 )
                return notify_fail("你的龙形搏击级别不够，不会使用神龙摆尾。\n");

        if( (int)me->query_skill("dragonforce", 1) < 50 )
                return notify_fail("你的龙神心法还未娴熟，不能利用神龙伤敌。\n");

        if( (int)me->query("force", 1) < 150 )
                return notify_fail("你现在内力不足，不能使用神龙摆尾。\n");

        msg = HIW "$N突然身形陡长，顿时化做一条神龙，乍现在雾中，随之一式"BLINK+HIR"「神龙摆尾」"NOR+HIW"猛然而出\n"NOR;

        //if( !target->is_killing(me) ) target->kill_ob(me);

        if (random(me->query_skill("force")) > target->query_skill("force")/3 ) {
                me->start_busy(random(3));

                damage = (int)me->query_skill("dragonforce", 1) + (int)me->query_skill("dragonfight",1);

                damage = damage + random(damage/2) + random(damage/4);

		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
                target->receive_damage("kee", damage/2,me);
                target->receive_wound("kee", damage/4,me);
		} else {
                target->receive_damage("kee", damage,me);
                target->receive_wound("kee", damage/2,me);
		}
                me->add("force", -100);

                if( damage < 30 )
                        msg += HIY"结果"+NOR"$n"HIY"被龙尾的劲气一扫，闷哼一声。\n"NOR;
                else if( damage < 55 )
                        msg += HIY"结果"+NOR"$n"HIY"被龙尾的劲气一扫，「腾腾」地退出几步。\n"NOR;
                else if( damage < 80 )
                        msg += HIR"结果"+NOR"$n"HIR"被龙尾的劲气一扫，胸口有如受到一记重锤，气血为之一窒！\n"NOR;
                else
                        msg += HIR"结果"+NOR"$n"HIR"被龙尾的劲气一扫，眼前一黑，浑身气血翻腾，竟如身入洪炉一般！\n"NOR;

        } else {
                me->add("force", -150);
                me->start_busy(1+random(3));
                msg += HIC"可是$p看破了$P的企图，依然稳如泰山，抬手一架格开。\n"NOR;
        }
        message_vision(msg, me, target);

        return 1;
}
