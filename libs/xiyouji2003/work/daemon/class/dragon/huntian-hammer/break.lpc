//Last modified by waiwai@2001/06/20
//全面设置no_break参数

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	object *inv, obj,weapon,armor;
	int i, equip;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

        if(!me->is_fighting())
                return notify_fail("「混元一破」只能在战斗中使用！\n");

	if((int)me->query("force") < 300 )
		return notify_fail("你的内力不足！\n");

       if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

       if((int)me->query_skill("huntian-hammer", 1) < 30)
                return notify_fail("你的混天锤级别还不够，使用这一招会有困难！\n");

       message_vision(HIC"\n$N"HIC"运足精神，大喝一声，对着$n"HIC"发出了"HIR"「混元一破」"HIC"的绝技！\n"NOR, me, target);
       me->start_busy(2+random(2));
       me->add("force",-200);

    if( random(me->query("combat_exp")) >  (int)target->query("combat_exp")/3 ) {
		inv = all_inventory(target);
		i = sizeof(inv);

		if ( i < 1 ) {
		message_vision(HIR"结果$N"HIR"躲闪不及，被打个正着！\n"NOR, target);
		target->receive_damage("kee",
                     random((int)me->query("max_force")/10+(int)me->query("force_factor")),me);
//			COMBAT_D->report_status(target);
		} else {
			if(target->query_temp("armor")||target->query_temp("weapon")) {
				if( target->query_temp("armor") ) {
 				        for (i=1; i < sizeof(inv); i++ ) {
						obj = inv[i];
						if( obj->query("equipped") != "worn" ) continue;
	                                  if( obj->query("no_break") == 1 ) 
                                         return notify_fail(WHT+target->name()+NOR WHT"装备的"HIG+obj->name()+NOR WHT"不能被震碎。\n"NOR);
						if( obj->query("equipped") != "no_break" ) continue;
						obj->reset_action();
						obj->delete("equipped");
						obj->set("value", 0);
						obj->set("No_Wear", 1);
	                		       obj->set("armor_prop", 0);
						message_vision(HIY"$N"HIY"身上的"HIR BLINK"$n"NOR HIY"被打的粉碎！\n"NOR, target,obj);
						obj->set("name", "破碎的"+obj->query("name"));
						obj->set("long", "一堆破碎的"+obj->query("name")+"碎片。\n"NOR);
						call_out("remove_broken_cloth",random(300)+60,obj);
						obj->move(environment(target));
					}
					target->delete_temp("armor");
					target->delete_temp("apply/armor");
				}

				if (target->query_temp("weapon")) {
					obj=target->query_temp("weapon");
	                           if( obj->query("no_break") == 1 ) 
                                  return notify_fail(WHT+target->name()+NOR WHT"手中的"HIG+obj->name()+NOR WHT"不能被震碎。\n"NOR);
					obj->unequip();
					obj->set("value", 0);
					message_vision(HIW "只听见「啪」地一声，$N"HIW"手中的"BLINK HIG+ obj->name()+NOR HIW"已经断为两截！\n" NOR, target);
					obj->set("name", "断掉的" + obj->query("name"));
					obj->set("long", HIC"一堆破碎的" + obj->query("name")+HIC"碎片。\n"NOR);
					obj->set("weapon_prop", 0);
					obj->set("liquid", 0);
					obj->move(environment(target));
					target->reset_action();
					call_out("remove_broken_cloth",random(60)+60,obj);
				}
			} else {
				message_vision(HIR"结果$N"HIR"躲闪不及，被打个正着！\n"NOR, target);
                           me->add("force", -250);
                           me->start_busy(2+random(2));

                           target->receive_damage("kee",random((int)me->query("max_force")/10+
                                                        (int)me->query("force_factor")),me);
//                       	COMBAT_D->report_status(target); 
			}
                   }
	} else {
	message_vision(HIC"但却被$N"HIC"躲开了！\n"NOR, target);
       me->add("force", -250);
       me->start_busy(3);
	me->receive_damage("sen", 50);
	}

          if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
         }

       return 1;

//       return 1+random(5);
}

void remove_broken_cloth(object obj)
{
  if(obj && environment(obj)) {
    tell_object(environment(obj),
      "一阵微风吹过，"+obj->name()+"化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}
