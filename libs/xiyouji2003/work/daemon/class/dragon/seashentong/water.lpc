// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type)
{
        int success_adj, damage_adj;

        success_adj = 80;
        damage_adj  = 160;

        SPELL2_D->attacking_cast(
                        me,
                        target,
                        success_adj,
                        damage_adj,
                        "kee",
                        HIM"\n$N后退几步，口中念了几句咒文，大叫一声：“神龙何在？“"
                        "半空中呼地现出两条气势威猛的银角背苍龙，纵身一吐，两股奇寒无比的水柱喷向$n\n"NOR,
                        HIR"\n结果$n躲避不及，被水柱激个正着！\n"NOR,
                        HIC"\n结果被$n躲开了。\n"NOR,
                        HIR"但水势被$n以法力反激，反向$N射去！\n" NOR,
                        HIR"\n结果$n躲避不及，被水柱激个正着！\n"NOR,
                        type);
}
int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( !target
        ||  !target->is_character()
        ||  target->is_corpse()
        ||  target==me)
                return notify_fail("你要引龙神袭击谁？\n");

        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 50 ) {
                message_vision(HIM"$N口中念念有词。。。但什么也没有发生！\n"NOR,me);
                return 1;
        }

        do_cast(me, target);

        me->start_busy(3+random(2));
        return 3+random(5);
}
