// Last modified by waiwai@2001/07/06 重写所有格式

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg, msg1, msg2, msg3;
  int extra, damage;
  object weapon;
  extra = me->query_skill("fengbo-cha", 1);
  if (extra < 200) return notify_fail(HIC "你的[风波叉法]还不够纯熟！\n" NOR);

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIC "［蛟龙出海］只能对战斗中的对手使用。\n" NOR);

  weapon = me->query_temp("weapon");

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("combat_exp", 1) < 2000000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if ((int)me->query_skill("dragonforce", 1) < 200)
    return notify_fail("你的龙神心法不够，不能使用这一招！\n");

  msg = WHT "\n无数条蛟龙消失在云端，$N" NOR WHT "手中的" + weapon->name() + NOR WHT "仍在发出鬼神莫测的颤音！\n" NOR;


  message_vision(
    HIB "\n$N" HIB "凝聚起海神召唤蛟龙的无边力量，一式" HIW "－" BLINK HIR "蛟" NOR HIW "－" BLINK HIR "龙" NOR HIW "－" BLINK HIR "出" NOR HIW "－" BLINK HIR "海" NOR HIW " －" HIB "如急电般攻向$n\n" NOR,
    me,
    target
  );

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {

    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);

    damage = me->query_skill("dragonforce") / 2 + me->query_skill("fork") / 2 + me->query_skill("fengbo-cha") / 2 + me->query("max_force");

    if (damage > 0) {
      // Added by waiwai@2002/05/27
      if (!me->query("vip") && target->query("vip")) {
        target->receive_damage("kee", damage / 4, me);
        target->receive_wound("kee", damage / 4, me);
      } else {
        target->receive_damage("kee", damage / 2, me);
        target->receive_wound("kee", damage / 2, me);
      }

      COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
      COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
      message_vision(HIR "\n只见无数条蛟龙呈现在云端,$n" HIR "面对群龙的攻击束手无策,勉强支撑着不至于倒下！！！\n" NOR, me, target);

      me->add_temp("apply/attack", -extra);
      me->add_temp("apply/damage", -extra);
      me->add("force", -200);

      me->start_busy(2 + random(2));
      message_vision(msg, me, target);
    }
  } else {
    me->add("force", -300);

    message_vision(HIC "但$p竟然躲过了$P" HIC "的这一式攻击。\n" NOR, me, target);
    me->start_busy(2);
  }


  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
