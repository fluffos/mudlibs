#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  if (me->query("family/family_name") != "陷空山无底洞") {
    success_adj = 50;
    damage_adj = 100;
  } else {
    success_adj = 70;
    damage_adj = 140;
  }

  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "both",
    HIC "\n$N" HIG "口中念念有词，忽见地下钻出千百只" HIR "嗜血老鼠 " HIG "疯狂地扑向$n！\n" NOR,
    HIR "\n结果$n" HIR "被噬咬的体无完肤！！！\n" NOR,
    HIC "结果$n" HIC "轻轻一纵，竟然躲了过去，鼠群顿时失去了方向，四散而去 !\n" NOR,
    HIG "但是群鼠被$n" HIG "以法力逼回，竟然反向$N" HIG "扑去！\n" NOR,
    HIR "\n结果$n" HIR "被噬咬的体无完肤,自食其果！！！\n" NOR,
    type);
}

int cast(object me, object target) {
  int success_adj, damage_adj;


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要群鼠袭击谁？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力，别伤到自己了！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50)
    return notify_fail("这次你没能召唤出一只老鼠来！\n");

  do_cast(me, target);

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
