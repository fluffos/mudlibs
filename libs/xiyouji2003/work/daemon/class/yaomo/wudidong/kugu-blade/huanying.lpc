// huanying.c 无形幻影

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;
    int extra;

    extra = me->query_skill("kugu-blade",1);

    if (!target ) target = offensive_target(me);
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
        return notify_fail(RED"开什么玩笑，没装备刀怎么使「无形幻影」？\n"NOR);

    if (!target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail(HIC"「无形幻影」只能对战斗中的对手使用。\n"NOR);

//	if( userp(me)) return notify_fail("什么？\n");

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

	if( userp(me)) {

	if((int)me->query("combat_exp", 1) < 1200000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");

	if((int)me->query_skill("literate", 1) < 150)
        	return notify_fail("你的读书识字不够，不能使用这一招！\n");
      if (me->query_skill_mapped("force")!="huntian-qigong")
                return notify_fail("无形幻影必须配合混天气功才能使用。\n");

      if (me->query_skill_mapped("spells")!="yaofa")
                return notify_fail("无形幻影必须配合妖法才能使用。\n");

    if ((int)me->query_skill("kugu-blade", 1) < 150 )
        return notify_fail(WHT"你枯骨刀法不够娴熟，使不出「无形幻影」。\n"NOR);
    if ((int)me->query_skill("huntian-qigong", 1) < 150 )
        return notify_fail(RED"你的混天气功火候不够，使不出「无形幻影」。\n"NOR);

    if ((int)me->query("max_force")<300)
        return notify_fail(RED"你的内力修为不足，无法运足「无形幻影」的内力。\n"NOR);

    if ((int)me->query("force")<300)
        return notify_fail(HIC"你现在内力不够，无法继续使出「无形幻影」！\n"NOR);
    }

	weapon = me->query_temp("weapon");
	damage=me->query_skill("huntian-qigong") + me->query_skill("blade") + me->query_skill("kugu-blade") + me->query("max_force");

    message_vision(HIG"$N大喝一声，全场四处游动，$n"HIG"只看到$N化做数团身影，漫天刀光席卷向$n\n"NOR,me,target);

    msg = HIY"\n$n"HIY"奋力一架，但$N刀分数路，$n"HIY"只架住一刀！\n"NOR;

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {

    me->add_temp("apply/attack",extra);
    me->add_temp("apply/damage",extra);

    me->clean_up_enemy();
    target = me->select_opponent();

    COMBAT_D->do_attack(me,target, weapon, 0);
    COMBAT_D->do_attack(me,target, weapon, 0);
    COMBAT_D->do_attack(me,target, weapon, 0);

	target->receive_damage("kee",damage/3,me);
	target->receive_wound("kee",damage/4,me);

    me->add_temp("apply/attack",-extra);
    me->add_temp("apply/damage",-extra);

    me->set("force_factor",150);
    me->add("force", -200);
    me->start_busy(2+random(2));
        message_vision(msg, me, target);

	} else {
	message_vision(HIW"\n但是竟然被$n"HIW"完全的避开了。\n"NOR,me,target);
	me->start_busy(2+random(1));
	}

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

    return 1;
}
