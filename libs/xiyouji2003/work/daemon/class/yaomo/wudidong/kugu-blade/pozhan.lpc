//Last modified by waiwai@2001/05/05

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int delay, myblade;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIC "不在战斗中，露什么破绽？\n" NOR);

  myblade = (int)me->query_skill("kugu-blade", 1);
  if (myblade > 160) myblade = 160;
  if (myblade < 50)
    return notify_fail(HIC "你的修为不够深，露破绽给人太危险了。\n" NOR);

  if (target->is_busy())
    return notify_fail(target->name() + WHT "目前正自顾不暇，放胆攻击吧！\n" NOR);

  msg = CYN "$N的招式突然一变，变得全无章法，浑身上下破绽百出，\n";

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    msg += "$n" + CYN "想攻，却不知道哪个破绽是真，哪个是假。\n";
    msg += "结果" + NOR "$p" + CYN "被$P攻了个措手不及！\n" NOR;
    delay = (int)me->query_skill("kugu-blade", 1) / 5;
    if (delay > 7) delay = 7;
    if (delay < 3) delay = 3;

    target->start_busy(delay);
    me->start_busy(random(2));
  } else {
    msg += HIC "可是$p" + HIC "看破了$P的企图，并没有上当。\n" NOR;

    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
