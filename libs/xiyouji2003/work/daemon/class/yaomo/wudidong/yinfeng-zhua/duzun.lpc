#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
      int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIC"「唯我独尊」只能对战斗中的对手使用。\n"NOR);

    if( (int)me->query_skill("yinfeng-zhua", 1) < 600 )
        return notify_fail(WHT"你的阴风爪不够娴熟，还使不出「唯我独尊」。\n"NOR);

       if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

    if ((int)me->query("force")<1000) {
        return notify_fail(HIC"你现在内力不够，无法继续使出「唯我独尊」！\n"NOR);
    }


	msg = HIR "$N"HIR"双目尽赤，祭出阴风爪最后一式"HIY" 「唯我独尊」 \n";
	damage=me->query_skill("yaofa") + me->query_skill("unarmed") + 
	me->query_skill("yinfeng-zhua") + me->query("max_force");

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 ) {
		msg += HIR"结果$p"HIR"被$P攻了个措手不及！\n" NOR;
       target->receive_damage("kee", damage,me);
       target->receive_wound("kee", damage,me);
       target->receive_damage("sen", damage,me);
       target->receive_wound("sen", damage,me);

	} else {
		msg += HIC"可是$p"HIC"还是躲过了$P的最后一击！！\n" NOR;
	}
	message_vision(msg, me, target);
       me->add("force", -500);
       me->start_busy(2+random(3));
	return 1;
}
