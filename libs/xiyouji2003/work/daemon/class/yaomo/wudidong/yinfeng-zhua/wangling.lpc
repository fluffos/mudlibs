//By waiwai@xyj-shxy 2000/07/20
// zhua.c  九阴白骨爪「亡魂一击」

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIB "「亡魂一击」只能对战斗中的对手使用。\n" NOR);

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if (me->query_skill_mapped("force") != "huntian-qigong")
    return notify_fail("亡魂一击必须配合混天气功才能使用。\n");

  if (me->query_skill_mapped("spells") != "yaofa")
    return notify_fail("亡魂一击必须配合妖法才能使用。\n");

  if ((int)me->query_skill("yinfeng-zhua", 1) < 80)
    return notify_fail(WHT "你的阴风爪不够娴熟，还使不出「亡魂一击」。\n" NOR);
  if ((int)me->query("force") < 300) {
    return notify_fail(HIC "你现在内力不够，无法继续使出「亡魂一击」！\n" NOR);
  }

  if ((int)me->query_skill("huntian-qigong", 1) < 80)
    return notify_fail(RED "你的混天气功火候不够，使用「亡魂一击」会震伤自己的。\n" NOR);

  msg = HIC "$N突然将双掌变爪合于胸前，然后象风车般急转数圈，而后施展出" BLINK HIB "「亡魂一击」" NOR HIC "，双爪向外一翻，随后绕着" + NOR "$n" + HIC "疾转数圈，又回到原地。\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->start_busy(2);
    target->start_busy(random(3));

    damage = (int)me->query_skill("yinfeng-zhua", 1);

    damage = damage + random(damage);

    target->receive_damage("kee", damage / 3, me);
    target->receive_wound("kee", damage / 3, me);
    target->receive_damage("sen", damage / 3, me);
    target->receive_wound("sen", damage / 3, me);
    me->add("force", -300);
    msg += HIR "原来$N已在$n" HIR "头顶留下了五个整整齐齐的指洞！$n" HIR "只觉得头顶一阵麻痒，鲜血汩汩而出！！！\n" NOR;
  } else {
    me->start_busy(3);
    msg += HIB "可是$p看破了$P的企图，闪身护头躲在了一边。\n" NOR;
  }
  message_vision(msg, me, target);

  if (userp(target)) target->fight_ob(me);
  else if (!target->is_killing(me->query("id"))) target->kill_ob(me);
  return 1;
}
