//Last modified by waiwai@2001/04/16
//ningxie-force凝血大法

#include <ansi.h>
inherit SSERVER;

int exert(object me, object target) {
  if (!me->is_fighting())
    return notify_fail(HIC "你只可以在战斗中施展！\n" NOR);

  if (!target) target = offensive_target(me);
  if (target == me) target = offensive_target(me);

  if ((int)me->query_skill("ningxie-force", 1) < 100)
    return notify_fail(HIC "你的冰谷凝血功修为还不够。\n" NOR);


  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够。\n");

  message_vision(HIW "$N脸色一寒，浑身发出冰雪般的寒气。\n" NOR, me);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    message_vision(HIW "$N" HIW "躲闪不及，被$n发出的寒气裹个正着！\n$N" HIW "的全身都冻僵了！\n" NOR, target, me);
    target->receive_damage("kee", target->query("kee") / 4);
    target->receive_wound("kee", target->query("kee") / 4);
    target->set_temp("last_damage_from", me);
    //target->start_busy(lvl/(lvl2+1)+2);
    target->start_busy(2 + random(2));
  } else {
    message_vision(
      HIG "$N" HIG "觉出危险，身行急退，躲开了此式！\n" NOR, target);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->add("force", -300);
  me->start_busy(1 + random(2));
  return 1;
}
