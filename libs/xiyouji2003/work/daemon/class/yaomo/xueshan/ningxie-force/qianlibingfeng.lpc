#include <ansi.h>
inherit SSERVER;

int exert(object me, object target)
{
	string msg;
	int howlong;

	if(!me->is_fighting()) return notify_fail(HIC"千里冰封只可以在战斗中施展！\n"NOR);

       if(!target) return 0;
       if(target==me) target = offensive_target(me);

	if ((int)me->query_skill("ningxie-force", 1) < 80)
		return notify_fail(HIC"你的冰谷凝血功修为还不够。\n"NOR);

	if((int)me->query("force") < 300 )
		return notify_fail(HIC"你的内力不够！\n"NOR);

	if((int)me->query("sen") < 150 )
		return notify_fail(HIC"你的精神没有办法有效集中！\n"NOR);

	me->receive_damage("sen", 50);

	if( random(me->query("max_force")) < 1000 ) {
		write(HIC"你失败了！\n"NOR);
		return 1;
	}

	msg = HIW"$N双手一聚，形成一团奇冷的寒气，射向$n \n\n"NOR;

    if( random(me->query("combat_exp")) >  (int)target->query("combat_exp")/3 ) {
	msg +=HIW"奇冷的寒气包围了$n"HIW"的全身，将$n"HIW"凝聚成冰块！\n";
//		target->set_temp("disable_inputs",1);
              howlong = random((me->query_skill("spells") -100))+1;
		if(howlong>10) howlong=10;
//		call_out("frozen", howlong, target);
//		target->set_temp("is_unconcious",1);
          	target->start_busy(howlong);
//        	seteuid(ROOT_UID);
//		target->start_call_out( (: call_other, __FILE__, "remove_frozen",target :),
//		random((int)me->query_skill("force")/3)+((int)me->query_skill("ningxie-force")/3));
		me->add("force", -100);
		me->start_busy(1);
	} else {
		me->add("force", -200);
		me->start_busy(2);
		msg += HIC"但是只见$n"HIC"发出一声怒吼,双臂一振，将袭来的寒气尽数散去。\n"NOR;
		}

	message_vision(msg, me, target);
	target->kill_ob(me);
	return 1;
}
