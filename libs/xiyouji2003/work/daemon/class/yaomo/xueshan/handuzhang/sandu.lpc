#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

       if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIC"你只能对战斗中的对手使用。\n"NOR);

//	if( !userp(target) && wizardp(target) )
//		return notify_fail("散毒只能对玩家使用。\n");

	if( (int)me->query_skill("dengxian-dafa", 1) < 150 )
		return notify_fail("你的登仙大法不够娴熟，不能散毒。\n");

	if( (int)me->query_skill("handuzhang", 1) < 150 )
		return notify_fail("你的寒毒掌不够娴熟，不能散毒。\n");
	if( (int)me->query("force") < 400 )
		return notify_fail("你的内力不够了！\n");

	msg = HIG "只听得$N的骨节格格作响，$N的手猛地长了半尺，居然一把抓住$n手
腕，将寒毒运于手心，源源不断传入$n体内。\n"NOR;
	me->add("force", -200);
	me->start_busy(1+random(2));

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
		msg += HIR " 结果$p无力挣扎，$P的本身寒毒不断散入$n体内！\n" NOR;
            target->receive_damage("kee",100);
            target->receive_wound("kee",15 + random(10));
            target->apply_condition("double_ice_poison", 1000);
//            me->clear_condition();
            target->start_busy(1 + random(2));
	} else {
		msg += HIC"可是$p急提内力奋力一震，将$N的手震了开去。\n" NOR;
		me->start_busy(3);
	}
	message_vision(msg, me, target);
	if( !target->is_killing(me) ) target->kill_ob(me);
	return 1;
}
