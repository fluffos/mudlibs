// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type)
{
        int success_adj, damage_adj;

        success_adj = 80;
        damage_adj = 160;

        SPELL2_D->attacking_cast(
                        me,
                        target,
                        success_adj,
                        damage_adj,
                        "kee",
		HIW"\n$N口中念了句咒文，半空闪出一只"HIB"青面獠牙的"HIR"狮子，"HIW"张开血盆大口向$n"HIW"咬去！\n" NOR,
		HIR "\n结果$n"HIR"被咬了个正着！\n" NOR, 
		HIC"\n$n"HIC"连忙一侧身闪在一旁。\n" NOR, 
		HIC"只见$n"HIC"一声怒吼，青面狮子吓得辨不青方向，反而咬中了$N！\n" NOR, 
		HIR "结果$n"HIR"被咬了个正着！\n" NOR,
                        type);
}

int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( !target
        ||  !target->is_character()
        ||  target->is_corpse()
        ||  target==me)
                return notify_fail("你要对谁施展魔兽吞天？\n");

        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 50 ) {
                write("坏了，青面狮子不知跑哪去了！\n");
                return 1;
        }

        do_cast(me, target);

        me->start_busy(1+random(2));
        return 3+random(5);
}
