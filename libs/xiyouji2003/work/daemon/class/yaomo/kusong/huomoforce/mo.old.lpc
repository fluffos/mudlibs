// roar.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  object *ob, where;
  int i, skill, force, damage;
  //	if ( !wizardp(me)) return 0 ;

  where = environment(me);
  if (where->query("no_faint") || where->query("no_kill"))
    return notify_fail("安全区内不能乱用魔神！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够了。\n");

  if (!me->is_fighting())
    return notify_fail("魔神只能在战斗中使用。\n");

  skill = me->query_skill("force");
  message_vision(
    HIY "$N气凝丹田，运集全身内力施出一式" + HIR "「魔神」！\n" NOR, me);
  target->start_busy(2);
  me->add("force", -200);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("con") * 2) continue;

    damage = skill - ((int)ob[i]->query("max_force") / 10);
    if (damage > 0) {
      ob[i]->receive_damage("sen", damage * 4);
      if ((int)ob[i]->query("force") < skill * 2)
        ob[i]->receive_wound("sen", damage);
      tell_object(ob[i], "你只觉得眼前一片模糊，朦胧中......\n");
    }
    if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);
    if (!me->is_killing(ob[i]->query("id"))) me->fight_ob(ob[i]);

  }

  return 1;
}
