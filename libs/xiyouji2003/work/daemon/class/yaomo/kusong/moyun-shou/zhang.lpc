#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(HIW "你只能在战斗中使用。\n" NOR);

  if (!me->is_fighting())
    return notify_fail(HIC "掌心雷只能在战斗中使用！\n" NOR);
  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("combat_exp", 1) < 100000)
    return notify_fail(HIC "你的武学不够，不能使用这一招！\n" NOR);

  if (me->query_skill_mapped("force") != "huomoforce")
    return notify_fail("掌心雷必须配合火魔心法才能使用。\n");

  if (me->query_skill_mapped("spells") != "pingtian-dafa")
    return notify_fail("掌心雷必须配合平天大法才能使用。\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query("force") < 300)
    return notify_fail(HIC "你的内力不足了！\n" NOR);

  if ((int)me->query_skill("moyun-shou", 1) < 60)
    return notify_fail("你的摩云手级别还不够，使用这一招会有困难！\n");

  me->delete("env/brief_message");

  message_vision(HIC "\n$N大喝一声 " BLINK + HIR "“掌心雷” \n" NOR, me);
  target->start_busy(random(3));


  me->set_temp("moyunshou_per", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("moyunshou_per");

  me->receive_damage("kee", 50);
  me->add("force", -150);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(1 + random(2));
  return 1;
}
