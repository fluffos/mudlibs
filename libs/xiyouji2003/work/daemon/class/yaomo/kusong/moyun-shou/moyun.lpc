// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  int i, j, damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("摩云劲气只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用摩云劲气！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

  if ((int)me->query_skill("moyun-shou", 1) < 350)
    return notify_fail("你的摩云手还不够娴熟，还没有办法拳出七伤。\n");

  if ((int)me->query("force", 1) < 800)
    return notify_fail("以你的目前的内力没有办法发出这一招。\n");

  i = random((int)(me->query_skill("moyun-shou", 1) / 30));

  if (i < 1) i = 1;
  if (i > 10) i = 10;

  msg = HIC "$N" HIC "凝神运功，使出摩云手最后的绝招[摩云劲气] " HIR + chinese_number(i) + HIC " 股无比强劲的热气呼啸的扑向$n" HIC "
身上各大要穴。$n" HIC "急提丹田之气与体内来回撞击的 " HIR + chinese_number(i) + HIC " 股劲气相扩。\n" NOR;

  if (!(me->query("force") < 0)) me->add("force", -i * 10);
  if (me->query("force") < 0) me->set("force", 0);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->start_busy(i / 2);
    target->start_busy(i);
    me->add("force", -150);

    damage = (int)me->query_skill("moyun-shou", 1);

    damage = damage / 2 + random(damage);

    target->receive_damage("kee", (int)((i * (2 * damage)) / 1));
    target->receive_wound("kee", (int)((i * damage) / 1));
    if (!(target->query("force") < 0)) target->add("force", -i * 20);
    if (target->query("force") < 0) target->set("force", 0);

    msg += HIY "结果$n" HIY "抵受不住$N" HIY "的 " HIR + chinese_number(i) + HIY " 种劲气在体内来回的撞击。\n" NOR;

  } else {
    me->start_busy(3);
    msg += HIG "可是$p" HIG "忙运内力与$P" HIG "的 " HIR + chinese_number(i) + HIG " 种劲气相撞，把之在体内化之无形。\n" NOR;
    if (!(target->query("force") < 0)) target->add("force", -i * 20);
    if (target->query("force") < 0) target->set("force", 0);
  }
  message_vision(msg, me, target);
  return 1;
}
