// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int i, j, k, u, damage, skill;
  weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("枪花万朵只能对战斗中的对手使用。\n");

  if (!me->is_fighting())
    return notify_fail("你们没有在打架！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query_skill("huomoforce", 1) < 300)
    return notify_fail("你的火魔心法等级不够，不能使用枪花万朵！\n");

  if ((int)me->query_skill("huoyan-spear", 1) < 300)
    return notify_fail("你的火焰枪等级不够，不能使用枪花万朵！\n");

  skill = (int)me->query_skill("huoyan-spear");

  k = (int)me->query_skill("spear");
  j = (int)target->query_skill("dodge");

  if (k < 200)
    return notify_fail("你的基本剑法级别还不够，使用这一招会有困难！\n");

  //	u=1+k/50;

  if (k >= 300 && k < 400) u = 3;
  if (k >= 400 && k < 500) u = 4;
  if (k >= 500 && k < 600) u = 5;
  if (k >= 600) u = 6;

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_vision(HIB "\n$N" HIB "仰天大喝了一声：" HIW "枪花万朵" NOR, me, target);
  message_vision(HIB "一刹那间千万道枪花破空而下，劈面罩向$n " HIB "------\n" NOR, me, target);


  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {

    for (i = 0; i <= u; i++) {
      if (random(k + j) > j) {
        me->start_busy(1 + random(2));
        me->add("force", -100);
        message_vision(HIY "$n" HIY "一个不慎，中了一枪。。。 \n" NOR, me, target);
        damage = u * k + random(k);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage / 2, me);
        COMBAT_D->report_status(target);
      }
    }
  } else {
    message_vision(HIY "$n" HIY "左跳右闪，好不容易避开了一轮漫天枪雨。\n\n" NOR, me, target);
    me->start_busy(3);
    me->add("force", -200);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
