#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
    int damage;
    string msg;
    object weapon;
    int skill;

    if (!target ) target = offensive_target(me);
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "spear")
        return notify_fail(RED"装备枪才能使用「祭枪」\n"NOR);

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

    if ((int)me->query_skill("huoyan-spear", 1) < 60 )
        return notify_fail(WHT"你火焰枪法不够娴熟，使不出「祭枪」。\n"NOR);

    if ((int)me->query_skill("spear", 1) < 60 )
        return notify_fail(WHT"你基本枪法不够娴熟，使不出「祭枪」。\n"NOR);

    if ((int)me->query_skill("huomoforce", 1) < 60 )
        return notify_fail(WHT"你火魔心法过低，使不出「祭枪」。\n"NOR);

      if (me->query_skill_mapped("force")!="huomoforce")
                return notify_fail(HIC"这一招式必须配合火魔心法才能使用。\n"NOR);
	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

      if (me->query_skill_mapped("spells")!="pingtian-dafa")
                return notify_fail(HIC"这一招式必须配合平天大法才能使用。\n"NOR);

    if ((int)me->query_skill("huomoforce", 1) < 60 )
        return notify_fail(RED"你的火魔心法火候不够，使不出「祭枪」。\n"NOR);

    if ((int)me->query("max_force") < 600)
        return notify_fail(RED"你内力修为不足，无法运足内力。\n"NOR);

    if ((int)me->query("force") < 600) {
        return notify_fail(HIC"你现在内力不足，不能继续使用「祭枪」！\n"NOR);
    }

       skill = me->query_skill("huoyan-spear",1);

	message_vision(HIW"\n$N猛然大喝一声: "BLINK+HIR"「祭枪」 \n"NOR,me,target);

    msg = HIC "$N右手持枪,枪尖向左肩一划，一阵血珠溅满枪头，紧接着枪随右臂刺出，一片血光
裹住漫天血光枪影向$n"HIC"狂风般呼啸刺去，\n"NOR;

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
           damage = skill*2 + ((int)target->query("max_force")/10);
           if( damage > 0 ) {
	msg += HIW"$n"HIR"疾忙侧身避让，但血枪之光疾闪，只觉眼前一阵血红，枪尖劈面而下，鲜血飞溅，惨声大嚎！\n"NOR;
          me->add("force", -150);
          me->start_busy(2+random(2));

          target->receive_wound("kee", damage,me);
              }
        }
	else
	msg += HIY"可是$n"HIY"侧身避让，不慌不忙，躲过了$N的血枪。\n"NOR;
       me->start_busy(2);
  
      message_vision(msg, me, target);

       if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        return 1;
}

