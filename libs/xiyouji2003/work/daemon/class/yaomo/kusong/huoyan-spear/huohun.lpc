#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int remove_ansi(object target,object me,int damage,int enhance);

int perform(object me, object target)
{       
        int damage,howlong,enhance;
        object weapon=me->query_temp("weapon");
        mapping action;        
    string msg;
        
      if( !target ) target = offensive_target(me);
      if( !target || !target->is_character()||target->is_corpse()||target==me)
          return notify_fail("你要攻击谁？\n");
      if (!target->is_fighting(me))
             return notify_fail("只有在战斗中才可以使用「火魂」！\n");

      if (me->query_skill("huomoforce",1)<100)
         return notify_fail("你火魔心法火候不够。\n");

      if (me->query_skill("spear",1)<100) 
          return notify_fail("你的枪法还欠火候。\n");

      if (me->query_skill("huoyan-spear",1)<100) 
          return notify_fail("你的火焰枪法还欠火候。\n");

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

      if (me->query("force")<500)
           return notify_fail("你内力不继，难以出招。\n");
     
//      if (me->query_temp("pfm_huohun")) return notify_fail(HIC"你已经七窍生烟了。\n"NOR);
        me->add("force",-400);
        message_vision(HIR"\n$N突然用手在自家鼻子上锤了两拳，口中喷出火来，手中"NOR+weapon->name()+
        HIR"顿时间红光上涌\n焚天炙地，神龙吐信般飞速向$n"HIR"舞出……\n"NOR,me,target);
        me->add("sen",-100);
        
        howlong=me->query_skill("spear")/10;
  
//        me->set_temp("pfm_huohun",1);
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
        enhance=me->query_skill("huomoforce",1)/10;
        me->add_temp("apply/attack", enhance);  
        damage=me->query_skill("huoyan-spear",1)/10;
        if (damage>4000) damage=4000;
        action=copy(me->query("actions"));
        damage=action["damage"]*damage/30;
           if( damage > 0 ) {
	message_vision(HIR"\n只见$n"HIR"鲜血飞溅，惨声大嚎！\n"NOR,me,target);
	}
        me->add_temp("apply/damage",damage);
        me->set("actions",action);
        COMBAT_D->do_attack(me, target, weapon);
        me->reset_action();
        me->start_busy(1+random(2));
        call_out("remove_ansi",howlong,target,me,damage,enhance);
        }
	else {
        me->start_busy(2);
	message_vision(HIW"\n可是$n"HIW"侧身避让，不慌不忙，躲了过去。\n"NOR,me,target);
	} 

       if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        return 1;
}


int remove_ansi(object target,object me,int damage,int enhance)
{       object here;
        string arg;
        if (!me) return 1;
        here=environment(me);
//        me->delete_temp("pfm_huohun");
        me->add_temp("apply/attack",-enhance);
        me->add_temp("apply/damage",-damage);
//        arg=HIW"$N的脸色渐渐的恢复了正常"NOR;
//        if(me->is_fighting(target)) arg+="，"HIG"攻势也缓和了许多"NOR;
//        message_vision(arg+"！\n",me);
        return 1;       
}

