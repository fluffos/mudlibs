#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  if (me->query("family/family_name") != "火云洞") {
    success_adj = 60;
    damage_adj = 120;
  } else {
    success_adj = 80;
    damage_adj = 170;
  }

  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "both",
    HIC "$N伸手在鼻子上砸了两，顿时鲜血直冒，突然红橙黄三道火焰呼！地一声向$n" HIC "卷去！\n" NOR,
    //initial message
    HIC "结果$n被烧得焦头烂额！\n" NOR,
    //success message
    HIC "\n结果被$n" HIC "躲开了。\n" NOR,
    //fail message
    HIC "结果火焰被$n以法力一逼，反向$N回卷而去！\n" NOR,
    //backfire initial message
    HIR "\n结果$n" + HIR "躲避不及，被烧得焦头烂额！\n" NOR,
    type);
}

int cast(object me, object target) {
  int success_adj, damage_adj;


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要用三昧真火袭击谁？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力，别伤到自己了！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50)
    return notify_fail("这次好象火力不足！\n");

  do_cast(me, target);

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
