// Created by waiwai@2001/04/16
// [终极技] 之 顶天立地

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg,str;
        int damage,skill,skill1,skill2,skill3;

       skill = me->query_skill("pingtian-dafa",1);
       skill1 = me->query_skill("huomoforce",1);
       skill2 = me->query_skill("dodge",1);
       skill3 = me->query_skill("parry",1);

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

        if( skill1 < skill )
                return notify_fail("你的火魔心不够，哪里施展的出！\n");

        if( skill2 < skill )
                return notify_fail("你的基本轻功不够，哪里施展的出！\n");

        if( skill3 < skill )
                return notify_fail("你的基本招架不够，哪里施展的出！\n");

        if(!me->query("huoyun_dingtian") )
                return notify_fail("你还没有获得终极技之密！\n");

        if((int)me->query_skill("pingtian-dafa", 1) < 600 )
                return notify_fail("你的平天大法火候不够，哪里施展的出！\n");

        if((int)me->query("mana") < 25+(int)me->query("mana_factor") )
                return notify_fail("你的法力不够，恐怕没有什么用！\n");

         if (me->query_skill_mapped("spells")!="pingtian-dafa")
                return notify_fail("这一招式必须配合平天大法才能使用。\n");

        if((int)me->query("mana") < 1000 )
                return notify_fail("你的法力不够。\n");

        if((int)me->query("mana") < 50+(int)me->query("mana_factor") )

                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 30 )
                return notify_fail("你无法集中精力，别撞中了石头！\n");

        me->receive_damage("sen", 40);
        me->add("mana", -1000);

        if( random(me->query("max_mana")) <150 ) {
                write(HIG"你失败了！\n"NOR);
                return 1;
        }

   msg = HIW
"\n$N摇身一晃,现了真身,原来是一只高八百丈,宽千余丈的大白牛,当真是顶天立地。。。\n"
"只听白牛一声怒吼,犄起两角,就向$n"HIW"拼命撞去。。。\n\n";

if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
     damage = random((int)me->query("max_mana")/2) + (int)me->query("eff_sen") /2;
     damage+=(int)me->query("mana_factor")-random((int)target->query("mana_factor"));
                if( damage > 0 ) {
     msg += HIR "结果撞了个正着，两只牛角几乎把$n"HIR"的肚皮给戳透！\n" NOR;
     damage +=random((damage*(int)me->query_skill("spells"))/60);
                        target->receive_damage("sen", damage/2, me);
                        target->receive_wound("sen", damage/2, me);
                        target->receive_damage("kee", damage/2, me);
                        target->receive_wound("kee", damage/2, me);
                        me->improve_skill("pingtian-dafa", 1, 1);

      if (userp(target)){ // By waiwai@2001/05/12 避免杀死npc刷屏
               if (target->query("eff_kee")<0 || !living(target))  
      {str=target->name()+HIW"被"HIY+me->name()+HIW"用平天大法绝技「神牛」撞中而死，听说肠子下水流了一地！！！";
	        message("channel:rumor",HIR"┋顶天立地┋"HIG+str+"\n"NOR,users());
           }
         }
       } else {
     msg += HIG "结果$n"HIG"却闪在一边,$N收势不及,撞在旁边的山石上,牛角差点没撞断了！\n" NOR;
     damage -= (int)target->query("mana_factor");
     damage -=random((-damage*(int)target->query_skill("spells"))/80);
                        me->receive_damage("sen", -damage/3, target);
                        me->receive_wound("sen", -damage/3, target);
                        me->receive_damage("kee", -damage/3, target);
                        me->receive_wound("kee", -damage/3, target);
                        me->improve_skill("pingtian-dafa", 1, 1);
       }
     } else
                msg += HIY"但是被$n"HIY"躲开了。\n"NOR;

        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);
        else if( damage < 0 ) COMBAT_D->report_status(me);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else
		target->kill_ob(me);
                }
                me->fight_ob(target);
        }

        me->start_busy(3+random(2));
        return 3+random(5);
}

