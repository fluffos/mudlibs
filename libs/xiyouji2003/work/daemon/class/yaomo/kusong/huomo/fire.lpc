#include <ansi.h>

inherit F_CLEAN_UP;
string *fire_msg=({
	"火海中突然掀起一股热浪来势汹汹卷向众人。\n",
	"。。。「啪」地一团巨焰闪过。\n",
	"烈火照的天空通红，一道一道的火舌舔向众人。\n",
	"烈火之中一天火龙腾空而起，以迅雷不及掩耳之势向众人扑去！。\n",
	"隐约中红光闪现，热浪一次又一次袭来。\n",
	});

int exert(object me, object target)
{
        object *ob;
        int i, skill, damage, force,time;


        if( !me->is_fighting() )
                return notify_fail("三味真火只能在战斗中使用。\n");
                
        skill = me->query_skill("force");
        if( (int)me->query("force") < (250+skill) )
                return notify_fail("你的内力不够。\n");
	if( (int)me->query("kee") < skill*2)
		return notify_fail("你的力气不够了。\n");

        
        
        if (skill>400) skill=400;     
	force = me->query("max_force");
        me->add("force", -(200+skill));
       
	
        if ( random(skill) <30)
           {
             message_vision(HIR "\n$N退后两步，拳头在鼻子上砸了两下，顿时鲜血直冒！\n"NOR,me);
             message_vision(HIR "\n结果什么都没发生.\n"NOR,me);
             me->receive_wound("kee",skill);
             return 1;
           } 
        me->set("fire_room",environment(me));   
        me->receive_wound("kee", skill+15+random(4));
//        me->receive_damage("kee",skill);
        me->start_busy(1+random(2)+random( ((300-skill)?(300-skill):0) /40) );
	message_vision(HIR "\n$N退后两步，拳头在鼻子上砸了两下，顿时鲜血直冒！\n
忽然从$N口中冲出红橙黄三道火焰烧向所有的人！熊熊烈火四处燃烧起来！\n\n"NOR, me);
        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me ) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;

                damage = skill + force/10 - ((int)ob[i]->query("max_force") / 10);
                if( damage > 0 ) {
                        
                        if( (int)ob[i]->query("force") < skill * 20 )
                                ob[i]->receive_wound("kee", damage*2/3);
                        tell_object(ob[i], HIR"结果你被烧得焦头烂额！\n"NOR);
                        ob[i]->receive_damage("kee", damage/2);
                }
		COMBAT_D->report_status(ob[i]);		
                if( userp(ob[i]) ) ob[i]->fight_ob(me);
                else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);

        }
        time = 2 + (int)me->query_skill("huomoforce",1) / 50;
        if (time>6) time=6;
        remove_call_out("continue_fire");
        call_out("continue_fire",8,me,time);
        
        return 1;
}

int continue_fire(object me,int time)

{
        object *ob,env=environment(me);
        int i, skill, damage, force,t;
        string fire;
        if (time<1)
         {
          message_vision(HIR"$N鼻中鲜血慢慢止住．\n"NOR,me);
          message_vision(HIR"只见$N嘴唇微动，周围熊熊烈火瞬间化作一道红光，被$N收入口中．\n"NOR,me);	 
          message_vision(HIG"大火终于熄灭了．\n"NOR,me);
          return 1;
         } 
        if (!interactive(me) || !living(me) ) return 1;
        if (env!=(object)me->query("fire_room") ) return 1;
        skill=me->query_skill("force");
        ob = all_inventory(environment(me));
        if (sizeof(ob)<1) return 1;
//        me->receive_wound("kee", (skill+15+random(4))/5);
        me->receive_damage("kee",random(70));
        time--;
        t=sizeof(fire_msg);
        fire=fire_msg[(random(t))];
        message_vision(HIR+fire+NOR,me);
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me ) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;

                damage = skill + force/10 - ((int)ob[i]->query("max_force") / 10);
                if( damage > 0 ) {
                       
                        if( (int)ob[i]->query("force") < skill * (10+random(25)) )
                                ob[i]->receive_wound("kee", damage/3);
                        tell_object(ob[i], HIR"结果你被烧得焦头烂额！\n"NOR);
                         ob[i]->receive_damage("kee", damage/2);
                }
		COMBAT_D->report_status(ob[i]);		
//                if( userp(ob[i]) ) ob[i]->fight_ob(me);
//                else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);

        }        
        remove_call_out("continue_fire");
        call_out("continue_fire",8,me,time);
        return 1;
}        
