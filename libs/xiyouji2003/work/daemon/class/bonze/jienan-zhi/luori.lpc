#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;

	extra = me->query_skill("jienan-zhi");

	if(me->is_busy())
		return notify_fail(HIC"你现在正忙着呢！！\n"NOR);

	if((int)me->query_skill("jienan-zhi", 1) < 600)
        	return notify_fail("你的劫难指等级不够，不能使用这一招！\n");

	if((int)me->query_skill("unarmed", 1) <extra)
           return notify_fail(WHT"你的基本扑击格斗小于劫难指级别，无法使出落日。\n"NOR);

	if( !wizardp(me) && userp(me) ) {
	if((int)me->query_skill("lotusforce", 1) < 600)
        	return notify_fail("你的莲台心法不够，不能使用这一招！\n");

	if(!me->query("vip"))
        	return notify_fail("你非VIP会员，不能使用这一招！\n");

	if((int)me->query_skill("literate", 1) < 300)
        	return notify_fail("你的读书识字不够，不能使用这一招！\n");

	if((int)me->query("combat_exp", 1) < 7000000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");
        }

	if((int)me->query("force") < 500)
		return notify_fail(HIC"你内力现在不够, 不能继续使用落日! \n"NOR);

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIG"［落日］只能对战斗中的对手使用。\n"NOR);
	weapon = me->query_temp("weapon");

	message_vision(HIR"\n$N仰天发出一声长笑，使出劫难指中的"BLINK HIY"［落日］ \n"NOR,me,target);
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
	me->add_temp("apply/attack",extra*3);me->add_temp("apply/damage",extra*3);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIG"\t\t长\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIG"\t\t\t河\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIG"\t\t\t\t落\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIG"\t\t\t\t\t日\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIG"\t\t\t\t\t\t圆\n"NOR,me,target);
        me->add_temp("apply/attack",-extra*3);me->add_temp("apply/damage",-extra*3);

	message_vision(HIR"这落日似灿烂无比的夕阳，顿时间天地亦为之变色！\n\n"NOR,me,target);
//        me->set("force_factor",150);
        me->add("force", -500);
        me->start_busy(2);
	} else {
	message_vision(HIC"可是$p"HIC"竟然在狼狈不堪中避开了$P的这致命一击。\n"NOR,me,target);
       me->add("force", -300);
	me->start_busy(3);
	}

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

	return 1;
}
