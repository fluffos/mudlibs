// Created by waiwai@2000/07/21

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);
	if( !me->is_fighting() )
		return notify_fail(HIC"佛手拂穴只能在战斗中使用。\n"NOR);

	if((int)me->query_str() < 25)
		return notify_fail("你臂力不够,不能使用这一绝技!\n");

	if((int)me->query_skill("buddhism",1) < 140)
		return notify_fail("你大乘佛法的功力不够不能使用佛手拂穴!\n");

		if((int)me->query("combat_exp", 1) < 1300000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");

       if((int)me->query_skill("lotusforce",1) < 140)
		return notify_fail("你莲台心法的功力不够不能使用佛手拂穴!\n");

	if((int)me->query("force") < 300)
		return notify_fail("你内力现在不够, 不能使用佛手拂穴! \n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

	msg = HIY "$N使出劫难指绝技"BLINK HIR" 「佛手拂穴」 "NOR+HIY"，罩住了$n"HIY"的全身要穴, 使$n"HIY"动弹不得。\n"NOR;

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3 ) {
		msg +=  HIG "结果$p被$P攻了个措手不及! \n" NOR;

		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") )
		target->start_busy( (int)me->query_skill("jienan-zhi",1) / 40 + 2);
		else
		target->start_busy( (int)me->query_skill("jienan-zhi",1) / 20 + 2);

		me->add("force", -300);
	} else {
		msg += HIM "可是$p看破了$P的企图，并没有上当。\n" NOR;
		me->start_busy(3);
	}
	message_vision(msg, me, target);

	return 1;
}
