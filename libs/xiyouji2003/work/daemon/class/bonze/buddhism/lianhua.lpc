// Update by waiwai@2002/12/05

#include <ansi.h>

void remove_effect(object me, int amount);

int cast(object me, object target) {
  int skill;

  if ((int)me->query("mana") < 2 * (int)me->query_skill("buddhism"))
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query_temp("anti_magic"))
    return notify_fail("你已经在运功中了。\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的气血过低！\n");

  skill = (int)me->query_skill("buddhism", 1);

  if (skill < 50) return notify_fail("你的大乘佛法等级不够。\n");

  skill = random(skill) + skill / 2;

  me->add("mana", -100);
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);

  message_vision(HIC "\n$N微一凝神，背后幻出一朵白莲，五色毫光闪现。\n" NOR, me);

  me->set_temp("anti_magic", skill);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill / 3);

  if (me->is_fighting()) me->start_busy(2);
  return 1;
}

void remove_effect(object me, int amount) {
  me->delete_temp("anti_magic");
  tell_object(me, HIB "你身后的白莲渐渐隐去了......\n" NOR);
  return;
}
