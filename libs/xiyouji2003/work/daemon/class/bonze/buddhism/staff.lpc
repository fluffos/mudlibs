#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int skill;

  skill = me->query_skill("lunhui-zhang", 1);

  if (userp(me) && !wizardp(me)) {

    if (!skill || skill < 50)
      return notify_fail("你的轮回杖法太低！\n");

    if (me->query_temp("execration"))
      return notify_fail("你正在念咒。\n");

    if (me->query_temp("weapon"))
      return notify_fail("你手上已经有武器了。\n");

    //if( (string)me->query("occupation") != "fighter" || (string)me->query("zhongzu") != "man" )
    //      return notify_fail("你并非人族武士，无法使用这把刀。\n");

    if (userp(me) && !me->query("vip"))
      return notify_fail(HIW "VIP会员专用，你无权使用！\n" NOR);

    if ((int)me->query("family/family_faith") < 100)
      return notify_fail("你的门忠不够！\n");

    if ((int)me->query_skill("buddhism", 1) < 50)
      return notify_fail("你的大乘佛法不够！\n");
  }

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");

  me->start_busy(2);
  me->add("mana", -100);
  me->receive_damage("sen", 50);
  msg = HIG "$N" HIG "念念有词：籍着佛祖的力量。\n" NOR;
  message_vision(msg, me);
  me->set_temp("execration", 1);
  call_out("do_execration", 2, me, skill);
  return 1;
}

int do_execration(object me, int skill) {
  string msg;
  object staff;

  me->delete_temp("execration");

  if (me->query_temp("weapon")) {
    tell_object(me, "你已经有武器了。终止施法\n");
    return 1;
  }

  staff = new("/daemon/class/obj/magicstaff");

  if (!staff) {
    tell_object(me, "/daemon/class/obj/magicstaff.c文件出错。\n");
    return 1;
  }

  msg = HIW "只见一道金光延伸过来，集结在$N" HIW "的手上，竟形成了一根杖状物体----" HIY "佛光之杖 \n" NOR;
  message_vision(msg, me);
  staff->move(me);
  staff->wield();
  staff->do_dest(me, skill * 2);
  if (skill >= 500) skill = 500;
  staff->set("weapon_prop/damage", skill / 3);
  me->set_temp("apply/damage", skill / 3);
  return 1;
}
