// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  if (me->query("family/family_name") != "南海普陀山") {
    success_adj = 60;
    damage_adj = 120;
  } else {
    success_adj = 90;
    damage_adj = 180;
  }

  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "both",
    HIC "$N" HIC "口中念了几句咒文，半空中现出阿傩，迦叶二尊者，各人手执\n一根巨大无比的降魔杵，"
    "呼！地一声向$n" HIC "当头砸下！\n" NOR,
    HIC "结果砸个正着，差点没把$n" HIC "砸扁！\n" NOR,
    HIC "但是$n" HIC "在千钧一发之际躲了开来。\n" NOR,
    HIC "但是降魔杵被$n" HIC "以法力一引，反而砸到了$N的顶门！\n" NOR,
    HIC "结果砸个正着，差点没把$n" HIC "砸扁！\n" NOR,
    type);
}

int cast(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要用大力降魔杵打谁？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力，别砸中自己了！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50)
    return notify_fail("好象没反应，再来一次吧！\n");

  do_cast(me, target);

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
