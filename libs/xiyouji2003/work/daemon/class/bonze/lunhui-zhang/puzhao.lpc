// Last modified by waiwai@2001/05/13

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object *inv, obj;
  object weapon;

  weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(CYN "「佛光谱照」只能在战斗中使用。\n" NOR);

  //        if((string)me->query("family/family_name") != "南海普陀山" )
  //                return notify_fail("你还没有四大皆空、超脱世俗怎能佛光普照？\n");
  if (!me->query("vip"))
    return notify_fail("你非VIP会员，不能使用这一招！\n");

  if (me->query("putuo/puzhao_perform") != 1)
    return notify_fail("你还没领会「佛光谱照」！\n");

  if ((int)me->query("force") < 500)
    return notify_fail(CYN "你的内力不足了！\n" NOR);

  if ((int)me->query("sen") < 500)
    return notify_fail(CYN "你的精神不足，没法子施用外功！\n" NOR);

  if ((int)me->query("combat_exp") < 5000000)
    return notify_fail(CYN "你的武学太差。\n" NOR);

  if ((int)me->query_skill("lunhui-zhang", 1) < 600)
    return notify_fail(CYN "你的轮回杖级别还不够，使用这一招会有困难！\n" NOR);

  message_vision(HIY "\n$N口中念动《金刚般若波罗蜜经》：\n" NOR, me, target);
  message_vision(HIY "\n生死炽燃，苦恼无量，发大乘心，普济一切。\n" NOR, me, target);
  message_vision(HIY "\n愿代众生，受无量苦，令诸众生，毕竟大乐。\n" NOR, me, target);
  message_vision(HIY "\n凡所有相，皆是虚妄，诸相非相，即见如来。\n" NOR, me, target);
  message_vision(HIY "\n降伏其心，愿乐欲闻，即见如来，未为胜也。\n" NOR, me, target);
  message_vision(HIY "\n知我说法，如筏喻者，法尚应舍，何况非法。\n" NOR, me, target);
  message_vision(HIY "\n放下屠刀，立地成佛，佛说非身，是名大身!\n" NOR, me, target);
  message_vision(
    HIY "\n只见$N手中的" + weapon->query("name") + HIY "发出阵阵霞光，只见几道金光射向$n……\n" NOR,
    me,
    target
  );
  me->add("force", -400);
  me->start_busy(2 + random(3));

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    message_vision(HIW "\n\n$N" HIW "两眼痴痴看着远方，意识好象受到了佛的召唤,似乎杀意全无，楞然矗立顾不及躲闪...\n\n" NOR, target);
    target->receive_damage(
      "kee",
      200 + random((int)me->query("max_force") + (int)me->query("force_factor")),
      me
    );
    target->receive_damage(
      "sen",
      200 + random((int)me->query("max_mana") + (int)me->query("mana_factor")),
      me
    );
    target->receive_wound(
      "kee",
      100 + random((int)me->query("max_force") + (int)me->query("force_factor")),
      me
    );
    target->receive_wound(
      "sen",
      100 + random((int)me->query("max_mana") + (int)me->query("mana_factor")),
      me
    );

    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);

    if (target->query_temp("weapon")) {
      obj = target->query_temp("weapon");
      if (obj->query("no_break") == 1)
        return notify_fail("" WHT + target->name() + NOR WHT "手中的" + obj->name() + NOR WHT "不能被震碎。\n" NOR);
      obj->unequip();
      obj->set("value", 0);
      message_vision(HIR "只听见「啪」地一声，$N手中的" + obj->name() + HIR "自爆粉碎！\n" NOR, target);
      obj->set("name", "碎裂的" + obj->query("name"));
      obj->set("weapon_prop", 0);
      obj->set("armor_prop", 0);
      obj->set("liquid", 0);  //这里是以前所忽略的.
      obj->move(environment(target));
      call_out("remove_broken_cloth", random(60) + 60, obj);
    }
  } else {
    message_vision(HIG "谁知$N" HIG "竟然全无感觉，脸上杀气却越来越浓！\n" NOR, target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  return 1;
}

void remove_broken_cloth(object obj) {
  if (obj && environment(obj)) {
    tell_object(environment(obj),
      "一阵微风吹过，" + obj->name() + "化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}
