// Created by waiwai@2000/12/02

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon,ob;
        int i,j,damage;

       string *list, s_room;
       object other, env;
       mapping exit;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

        if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");

        if((int)me->query("max_force") < 800 )
                return notify_fail("你的内功太差。\n");

        if((int)me->query("force") < 200 )
                return notify_fail("你的内力不足！\n");

	if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "staff")
                return notify_fail("你所使用的外功中没有这种功能。\n");

        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

	if((int)me->query_skill("lotusforce", 1) < 60)
        	return notify_fail("你的莲台心法不够，不能使用这一招！\n");


	if((int)me->query_skill("buddhism", 1) < 60)
        	return notify_fail("你的大成佛法等级不够，不能使用这一招！\n");

	i=(int)me->query_skill("lunhui-zhang",1)+me->query_skill("staff",1)/2;
	j=(int)me->query_skill("lunhui-zhang",1);
        if(i<60 || j<1)        
                return notify_fail("你的轮回杖级别还不够，使用这一招会有困难！\n");
	
        me->delete("env/brief_message");
	target->delete("env/brief_message");

message_vision(HIY"\n$N"HIY"口诵佛号，将全身功力注入手中"+weapon->name()+NOR HIY"顿时间霞光四射，照得$n"HIY
"睁不开眼！\n\n"NOR,me,target);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
	damage=me->query_skill("buddhism")/2 + me->query_skill("staff")/2 + me->query_skill("lunhui-zhang")/2;
           if( damage > 0 ) {
	message_vision(HIR"$n"HIR"疾忙狼狈避让，但只觉浑身一阵剧痛，鲜血飞溅，几近晕倒！！！\n"NOR,me,target);
/**************************************************************/
	// Added by waiwai@2002/12/05
	// 以下综合增加特殊武功对于环境的影响
	env=environment(me);

	exit=env->query("exits");

	if( exit ) {
	list=keys(exit);

	for(i=0;i<sizeof(list);i++) {
		s_room=env->query("exits/"+list[i]);
		if(!other=find_object(s_room))  other=load_object(s_room);
	tell_object(other,WHT"附近突然传来阵阵的撕杀声，似乎一股普陀派的我入地狱的唳气直逼你而来。。。\n"NOR);
	}
	}
	// 加入武功对于房间描述的影响
	// 这个影响在一般的情况下只能是暂时的
	env->add("breakroom/putuo_diyu",1);
	// 这个参数将在特殊房间里面扩展应用时用到
	env->add("break_room",1);

	// 必须做判断限定，不然short将不断重复
	if(env->query("breakroom/putuo_diyu")==20 && 
	!env->query("Pdiyu_break") && !env->query("break_room") ) {
	env->set("short",YEL"伤痕累累的"NOR+env->query("short"));
	env->set("Pdiyu_break",1);
	}

	if(env->query("breakroom/putuo_diyu")>=20) {

	env->set ("long", @LONG

被普陀派的我入地狱震荡过的房间，已经看不出来原来究竟是什么模样了
四处到处散落着破碎的物件。。。
LONG);
	// 只清除该武功的影响标记次数
	env->delete("breakroom/putuo_diyu"); 
	}
/**************************************************************/

		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/6,me);
		target->receive_damage("sen",damage/6,me);
		} else {
		target->receive_damage("kee",damage/3,me);
		target->receive_damage("sen",damage/3,me);
		}

       me->start_busy(random(2));
       me->add("force", -200);
       COMBAT_D->report_status(target);
       COMBAT_D->report_status(me);
	}
	} else {
	message_vision(HIC"可是$p"HIC"竟然飞身纵越，狼狈不堪地躲过了$P的致命一击。\n"NOR,me,target);
       me->add("force", -200);
	me->start_busy(2);
}
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        return 1;
}

