// Created by waiwai@2000/12/02

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	int extra,damage;
	object weapon;
       string msg;

       string *list, s_room;
       object other, env;
       mapping exit;
	int i;

       if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIC"［金磷飞龙］只能对战斗中的对手使用。\n"NOR);

	if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "staff")
                return notify_fail("你所使用的外功中没有这种功能。\n");

       if (me->query("force")<200)
           return notify_fail(HIC"你内力不足，难以御仗飞龙。\n"NOR);

        if( !wizardp(me) && userp(me) ) {
        if((int)me->query("combat_exp") < 1200000 )
                return notify_fail(CYN"你的武学太差。\n"NOR);

	if((int)me->query_skill("lunhui-zhang", 1) <150)
		return notify_fail(HIC"你的轮回杖级别还不够！\n"NOR);

	if((int)me->query_skill("lotusforce", 1) < 150)
        	return notify_fail(HIC"你的莲台心法不够，不能使用这一招！\n"NOR);

	if((int)me->query_skill("literate", 1) < 150)
        	return notify_fail(HIC"你的读书识字不够，不能使用这一招！\n"NOR);

	if((int)me->query_skill("buddhism", 1) < 150)
        	return notify_fail(HIC"你的大成佛法等级不够，不能使用这一招！\n"NOR);
             }

        me->delete("env/brief_message");
        target->delete("env/brief_message");
message_vision(HIW"\n只见$N内力聚于双臂，手中的"NOR+ weapon->name() +HIW"幻出一条"BLINK HIY"金磷飞龙"NOR HIW
" 闪电般的扑向$n！！\n\n"NOR,me,target);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
damage=me->query_skill("buddhism") + me->query_skill("staff") + me->query_skill("lunhui-zhang") + 
me->query("max_force");
           if( damage > 0 ) {
	message_vision(HIR"$n"HIR"大叫一声：不好！顿时鲜血飞溅出丈外！！！\n"NOR,me,target);

/**************************************************************/
	// Added by waiwai@2002/12/05
	// 以下综合增加特殊武功对于环境的影响
	env=environment(me);

	exit=env->query("exits");

	if( exit ) {
	list=keys(exit);

	for(i=0;i<sizeof(list);i++) {
		s_room=env->query("exits/"+list[i]);
		if(!other=find_object(s_room))  other=load_object(s_room);
	tell_object(other,WHT"附近突然传来阵阵的撕杀声，似乎一条金磷飞龙直逼你而来。。。\n"NOR);
	}
	}

	// 加入武功对于房间描述的影响
	// 这个影响在一般的情况下只能是暂时的
	env->add("breakroom/putuo_feilong",1);
	// 这个参数将在特殊房间里面扩展应用时用到
	env->add("break_room",1);

	// 必须做判断限定，不然short将不断重复
	if(env->query("breakroom/putuo_feilong")==20 && 
	!env->query("feilong_break") && !env->query("break_room") ) {
	env->set("short",YEL"伤痕累累的"NOR+env->query("short"));
	env->set("feilong_break",1);
	}

	if(env->query("breakroom/putuo_feilong")>=20) {

	env->set ("long", @LONG

被普陀派的金磷飞龙震荡过的房间，已经看不出来原来究竟是什么模样了
四处到处散落着破碎的物件。。。
LONG);
	// 只清除该武功的影响标记次数
	env->delete("breakroom/putuo_feilong"); 
	}
/**************************************************************/

		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/2,me);
		target->receive_damage("sen",damage/4,me);
		} else {
		target->receive_damage("kee",damage,me);
		target->receive_damage("sen",damage/2,me);
	       target->start_busy(random(2));
		}

	me->receive_damage("sen", 50);
       me->add("force", -300);

       COMBAT_D->report_status(target);
       COMBAT_D->report_status(me);
	me->start_busy(1+random(2));
	}
	} else {
	message_vision(HIC"可是$p"HIC"竟然在狼狈不堪中避开了$P的这致命一击。\n"NOR,me,target);
       me->add("force", -300);
	me->start_busy(2);
	}

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

	return 1;
}
