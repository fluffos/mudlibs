#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");
  extra = me->query_skill("souguzhao", 1);
  if ((int)me->query_skill("souguzhao", 1) < 150)
    return notify_fail("你的搜骨爪级别还不够！\n");

  if (me->query("force") < 700)
    return notify_fail("你内力不足，无法继续使出漫天爪影。\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query_skill("wuneng-force", 1) < 150)
    return notify_fail("你的悟能心法级别还不够！\n");

  if ((int)me->query("combat_exp", 1) < 1500000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if (me->query_skill_mapped("force") != "wuneng-force")
    return notify_fail("漫天爪影必须配合悟能心法才能使用。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［漫天爪影］只能对战斗中的对手使用。\n");

  weapon = me->query_temp("weapon");
  msg = HIY "$N使出搜骨爪中的 " BLINK HIR "［漫天爪影］ " NOR HIY "，仿佛漫天爪影攻向 $n！\n";

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->add_temp("apply/attack", extra); me->add_temp("apply/damage", extra * 2);
    target->receive_damage("kee", extra, me);
    target->receive_wound("kee", extra, me);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t上一爪\n" NOR, me, target);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t下一爪\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t左一爪\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t右一爪\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t前一爪\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t后一爪\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t最后再一爪……\n" NOR, me, target);
    me->add_temp("apply/attack", -extra); me->add_temp("apply/damage", -extra * 2);

    me->add("force", -700);
    me->start_busy(3 + random(1));
  } else {
    message_vision(HIC "可是却被$p" HIC "躲了开去……\n" NOR, me, target);
    me->add("force", -300);
    me->start_busy(3);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
