#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void remove_effect(object me, int amount);
int cast(object me, object target) {
  int skill;
  // if( target != me ) return 
  //  notify_fail("你只能将［护体］用在自己的身上。\n");
  if ((int)me->query("mana") < 2 * (int)me->query_skill("fofa"))
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query_temp("daoqian"))
    return notify_fail("你已经在运功中了。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中！\n");
  skill = (int)me->query_skill("fofa", 1);
  if (skill < 50) return notify_fail("你的小乘佛法等级不够。\n");
  skill = random(skill / 3) + skill / 3;
  me->add("mana", -100);
  message_vision(HIW "\n$N" HIW "微一凝神，运起了小乘佛法,顿时佛光闪现。\n" NOR, me);
  me->add_temp("apply/armor", skill);

  me->set_temp("daoqian", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill / 5);
  if (me->is_fighting()) me->start_busy(1);
  return 1;
}

void remove_effect(object me, int amount) {

  me->add_temp("apply/armor", -amount);

  me->delete_temp("daoqian");
  tell_object(me, HIB "你身后的佛光渐渐隐去了......\n" NOR);
}
