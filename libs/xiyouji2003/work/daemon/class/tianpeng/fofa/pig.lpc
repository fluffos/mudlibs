#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type)
{
        int success_adj, damage_adj;

        if(me->query("family/family_name") != "天蓬府") {
                success_adj = 60;
                damage_adj = 120;
        } else {
                 success_adj = 80;
                 damage_adj = 170;
        }

        SPELL2_D->attacking_cast(
                        me,
                        target,
                        success_adj,
                        damage_adj,
                        "both",
		HIG "$N"HIG"看着$n"HIG"邪恶地一笑，突然面部扭曲，鼻息翕动,猛然向$n"HIG"拱去......\n" NOR,
			//initial message
		HIR "结果$n"HIR"错不及防,被$N"HIR"拱得倒飞出去......\n" NOR, 
			//success message
		HIC "但是$n"HIC"侧身一闪，躲了开去。\n" NOR, 
			//fail message
		HIY "但是$N"HIY"被$n"HIY"的法力一引,竟然失去了方向......\n" NOR, 
			//backfire initial message
		HIR "结果$n"HIR"径直撞到了一面墙上,顿时满脸鲜血!!!\n" NOR,
                        type);
}

int cast(object me, object target)
{
        int success_adj, damage_adj;


        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要现猪形袭击谁？\n");

        if((int)me->query("mana") < 25+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 20 )
                return notify_fail("你无法集中精力，别伤到自己了！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 10);

        if( random(me->query("max_mana")) < 50 )
                return notify_fail("这次好象现不出猪形来了！\n");

        do_cast(me, target);

        me->start_busy(1+random(2));
        return 3+random(5);
}
