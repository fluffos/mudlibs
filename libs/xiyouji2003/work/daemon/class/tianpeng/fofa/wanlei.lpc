#include <ansi.h>

inherit SSERVER;

int thunderspell(object me, object obj) {
  int spi, kar, kee, damage, spell;

  message_vision(HIW "\n\t\t\t～～～～～一个闪电在$N的头上砸下～～～～～\n" NOR, obj);
  obj->receive_damage("sen", 0, me);
  spell = me->query_skill("fofa");
  if (obj->is_ghost() == 1) {
    message_vision(HIR "\n$N惨叫了一声，化为了灰烬！\n" NOR, obj);
    obj->die();
    return 1;
  }
  if (obj->is_zombie() == 1) {
    message_vision(HIR "\n$N惨叫了一声，化为了一滩血水！\n" NOR, obj);
    obj->die();
    return 1;
  }
  if (obj->query("race") == "野兽") {
    kar = obj->query("kar");
    spi = obj->query("spi");
    damage = (31 - spi) * (spell) * (random(31 - kar) + 1) + 100;
    if (damage <= 200) damage = 200;
    if (damage > 5000) damage = 5000;
    if (damage != 0) {
      message_vision(HIR "\n正打在了$N的头上！\n" NOR, obj);
      obj->receive_wound("sen", damage, me);
      COMBAT_D->report_status(obj);
      if (!obj->is_fighting(me)) {
        if (living(obj)) {
          if (userp(obj))
            obj->fight_ob(me);
          else
            obj->kill_ob(me);
        }
        me->kill_ob(obj);
      }
    } else
      message_vision(HIC "\n但被$N躲过了！\n" NOR, obj);
    return 1;
  }
  kar = obj->query("kar");
  spi = obj->query("spi");
  damage = spi * spell * (random(kar) + 1);
  damage += spell * 2 + random(spell);

  if (damage < 500) damage = 500;
  if (damage > 6000) damage = 6000;
  if (random(me->query("combat_exp")) > (int)obj->query("combat_exp") / 3) {
    //        if(damage != 0 && random(kar) < 20) {
    //        if(damage ) {
    message_vision(HIR "\n正打在了$N的头上！\n" NOR, obj);
    obj->receive_damage("sen", damage, me);
    obj->receive_wound("sen", damage / 2, me);
    COMBAT_D->report_status(obj);
    if (!obj->is_fighting(me)) {
      if (living(obj)) {
        if (userp(obj))
          obj->kill_ob(me);
        else
          obj->kill_ob(me);
      }
      me->kill_ob(obj);
    }
    //            }
  } else
    message_vision(HIC "但却被$N躲过了过去……\n" NOR, obj);
  return 1;

}

int cast(object me) {
  string msg;
  object env, target;
  object *inv;
  int i;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(HIW "「万雷咒」只能在战斗中使用。\n" NOR);

  if (!me->is_fighting())
    return notify_fail("「万雷咒」只能在战斗中使用。\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query_skill("spells") < 380)
    return notify_fail("你的法术不够高！\n");

  if ((int)me->query_skill("fofa", 1) < 380)
    return notify_fail("你的小乘佛法修为不够，使不出「万雷咒」！\n");

  if ((int)me->query("mana") < 900)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你的体力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神没有办法有效集中！\n");

  me->add("mana", -900);
  me->receive_damage("sen", 90);

  msg = HIY "\n$N脚踩倒乱七星步，双手握成伏魔印，口中喃喃地念著咒文……\n" NOR;
  msg = msg + HIY "猛地双手一挥，大喝一声" HIG "「万雷咒」" HIY "顿时天上打下无数闪电～～～～～\n\n" NOR;
  message_vision(msg, me);
  env = environment(me);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (!inv[i]->is_character() || inv[i]->is_corpse()) continue;
    thunderspell(me, inv[i]);
  }
  me->start_busy(3 + random(1));
  return 1;
}
