#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 130;
  damage_adj = 140;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(HIW "你只能在战斗中使用。\n" NOR);

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail(HIC "你的法力不够了！\n" NOR);

  if ((int)me->query("sen") < 100)
    return notify_fail(HIC "你现在精神不足！\n" NOR);

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 100) {
    write(HIC "这次好象现不出猪形来了！\n" NOR);
    return 1;
  }

  SPELL2_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIG "$N" HIG "看着$n" HIG "邪恶地一笑，突然面部扭曲，鼻息翕动,猛然向$n" HIG "拱去......\n" NOR,
    //initial message
    HIR "结果$n" HIR "错不及防,被$N" HIR "拱得倒飞出去......\n" NOR,
    //success message
    HIC "但是$n" HIC "侧身一闪，躲了开去。\n" NOR,
    //fail message
    HIY "但是$N" HIY "被$n" HIY "的法力一引,竟然失去了方向......\n" NOR,
    //backfire initial message
    HIR "结果$n" HIR "径直撞到了一面墙上,顿时满脸鲜血!!!\n" NOR
    //backfire hit message. note here $N and $n!!!

  );

  me->start_busy(1 + random(2));
  return 3 + random(5);

}
