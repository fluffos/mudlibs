#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;

	extra = me->query_skill("chaos-steps",1);
	if ( extra < 50) return notify_fail(HIC"你的［倒乱七星步法］还不够纯熟！\n"NOR);

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIC"［幻影千重］只能对战斗中的对手使用。\n"NOR);

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

      if (me->query_skill_mapped("force")!="wuneng-force")
                return notify_fail("幻影千重必须配合悟能心法才能使用。\n");

        if( (int)me->query("force") < 200 )
                return notify_fail("你的内力不够了。\n");

      if (me->query_skill_mapped("spells")!="fofa")
                return notify_fail("幻影千重必须配合小乘佛法才能使用。\n");

	if(target->is_busy())
		return notify_fail(target->name()+"已经手忙脚乱了！\n");

	message_vision( HIR "$N的身影突然一变十、十变百、百变千，$n"HIR"早被$N的千重幻影围住！\n" NOR ,me,target);
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 ) 	{
	message_vision(HIW "结果$N"HIW"面前仿佛出现了无数个幻影,顿时目眩神弛，心惊肉跳！\n"NOR,target);
       target->start_busy(extra/30);//40

       me->start_busy(1);
	me->add("force", -100);
//	target->start_busy(2+random(2));
	}
	else{
	message_vision("结果$N并不慌张！\n",target);
	me->start_busy(2);
	me->add("force", -100);
	}
	return 1;
}

