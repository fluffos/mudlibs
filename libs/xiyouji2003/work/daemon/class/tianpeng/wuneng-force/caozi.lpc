#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);
int exert(object me, object target, int amount)
{
        int skill;

       if( target != me ) return 
	notify_fail(HIC"你只能提升自己的饮水食物。\n"NOR);

       if( (int)me->query("force") < 200 )
          return notify_fail(HIC"你的内力不足了。\n"NOR);

        if( (int)me->query("sen") < 200 )
          return notify_fail(HIC"你的精神不足了。\n"NOR);

	if( me->query("water") >= 500 ||  me->query("food") >= 500)
		return notify_fail(WHT"你的饮水食物量不能再提升了.....\n"NOR);

      skill = me->query_skill("wuneng-force",1);
	if(skill < 50) return notify_fail(HIC"你的悟能心法太差了！\n"NOR);

      me->add("sen", -100);
      me->add("force", -200);
      message_vision(WHT"$N暗暗地聚气凝神，大喊一声:老猪的槽子谁可及！\n" NOR, me);
      me->add("food", 200);
      me->add("water", 200);
      if( me->is_fighting() ) me->start_busy(2);

      return 1;
}

