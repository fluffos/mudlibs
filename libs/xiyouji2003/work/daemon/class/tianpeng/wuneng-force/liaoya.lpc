#include <ansi.h>

#include <combat.h>

inherit SSERVER;

int exert(object me, object target) {
  string msg;
  int skill, damage;

  target = offensive_target(me);
  if (!me->is_fighting())
    return notify_fail(HIC "獠牙之齿只能在战斗中使用！\n" NOR);
  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你的内力不够。\n");

  skill = me->query_skill("wuneng-force", 1);

  if (skill < 60)
    return notify_fail("你的「悟能心法」等级不够, 不能使用「獠牙之齿」！\n");
  //   	me->add_temp("apply/attack",skill);me->add_temp("apply/damage",skill);

  msg = HIC "\n$N" HIC "突然脸色一变，现出一个" BLINK HIR " 「猪 形」" NOR HIC "，又尖又长的利齿向$n的颈部刺去！\n" NOR;
  me->start_busy(3);

  me->receive_damage("kee", 50);
  me->add("force", -200);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    damage = skill * 2 + random(skill);
    if (damage > 0) {
      msg += HIR "\n只见一片血肉飞扬，$n" HIR "的颈部被咬出一个血洞！\n\n" NOR;
      target->receive_wound("kee", damage, me);
      target->receive_wound("sen", damage / 2, me);
    } else msg += HIG "结果连皮都没划破！\n" NOR;
  } else msg += HIC "结果被$n" HIC "躲开了！\n" NOR;

  message_vision(msg, me, target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
