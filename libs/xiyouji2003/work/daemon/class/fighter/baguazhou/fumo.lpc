// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;

varargs void do_cast(object me, object target, int type)
{
        int success_adj, damage_adj;

        success_adj = 80;
        damage_adj  = 160;

        SPELL2_D->attacking_cast(
                        me,
                        target,
                        success_adj,
                        damage_adj,
                        "both",
                        HIY "$N口中念念有词，突然大喝一声“伏魔”，$n上空一道金光直向$n射来！\n" NOR,
                        HIY "结果$n被金光透体而过，$n浑身灼热不堪！\n" NOR,
                        HIY "但是$n在千钧一发之际躲了开来。\n" NOR,
                        HIY "但是金光$n以法力一引，反而射向$N！\n" NOR,
                        HIY "结果$n被金光透体而过，$n浑身灼热不堪！\n" NOR,
                        type);
}

int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( !target
           || !target->is_character()
           || target->is_corpse()
           || target==me)
        return notify_fail("你要对谁用“伏魔”？\n");

        if((int)me->query("mana") < 25+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 20 )
                return notify_fail("你无法集中精力，别砸中自己了！\n");

        me->add("mana", -(int)me->query("mana_factor"));
        me->receive_damage("sen", 10);

        if( random(me->query("max_mana")) < 50 ) {
                write("好象没反应，再来一次吧！\n");
                return 1;
        }

        do_cast(me, target);

        me->start_busy(1+random(2));
        return 3+random(5);
}