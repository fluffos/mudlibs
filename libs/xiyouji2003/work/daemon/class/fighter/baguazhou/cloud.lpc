// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;
void skills_limit(object me);

int cast(object me, object target) {
  string msg;
  int skill;

  skill = me->query_skill("baguazhou");

  if (!skill || skill < 160)
    return notify_fail("你的八卦咒法级别过低！\n");

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展火舞云霄？\n");

  if (me->query_temp("execration"))
    return notify_fail("你正在念咒。\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  me->add("mana", -100);
  me->receive_damage("sen", 50);
  msg = "" + me->name() + "自言自语不知道在说些什麽。\n";
  message("vision", msg, environment(me), ({ me }));
  tell_object(me, "你双手向天空中伸展开去。开始默念咒语。\n");
  me->set_temp("execration", 1);
  skills_limit(me);
  call_out("do_execration", 2, me, target, 1);
  return 1;
}

int do_execration(object me, object target, int i) {
  string msg;
  int skill;
  switch (i) {
    case 1:
      msg = CYN "比黄昏更加昏暗,比鲜血更加鲜红\n" NOR;
      break;
    case 2:
      msg = CYN "时光虽然流逝,你力量常存\n" NOR;
      break;
    case 3:
      msg = CYN "籍住你地的名字,我在黑暗中发誓\n" NOR;
      break;
    case 4:
      msg = CYN " 阻碍在我面前所有愚蠢的物体,\n" NOR;
      break;
    case 5:
      msg = CYN "凭住你我的力量,必至灭亡\n" NOR;
      break;
    case 6:
      msg = HIR "\n\t火\t舞\t云\t霄\n" NOR;
    default: break;
  }
  if (i != 6)
    tell_object(me, msg);
  else message_vision("$N忽然大喝一声：\n" + msg, me, target);

  i++;
  if (i < 7 && i >= 0)
    call_out("do_execration", 1, me, target, i);
  else {
    skill = me->query_skill("necromancy", 1);
    if (!skill) return 1;
    call_out("do_hit", 0, me, target, skill);
    return 1;
  }
  return 1;
}

int do_hit(object me, object target, int skill) {

  string msg;
  int i, my_exp, your_exp, damage, vs_fire, vs_magic, additional;  //附加伤害
  me->delete_temp("execration");
  skills_limit(me);
  if (!target || !environment(target) || environment(me) != environment(target)) {
    tell_object(me, "目标已经离开了。你停止的念咒，取消了火舞云霄。\n");
    return 1;
  } else if (environment(target)->query("no_fight")) {
    tell_object(me, "目标.现在处于禁止使用魔法的地区,你只好停止念咒，取消了火舞云霄。\n");
    return 1;
  }

  else {
    msg = YEL "$N手中突然聚起一片金黄色的火焰朝$n铺天盖地的撒去。\n" NOR;
    message_vision(msg, me, target);
    my_exp = me->query("combat_exp");
    your_exp = target->query("combat_exp");
    i = 90 - (your_exp - my_exp) / 200000;
    if (i > 100) i = 100;
    if (i < 0) i = 0;
    if (random(100) <= i) {
      msg = YEL "$n立刻被一片火海包围了。\n" NOR;
      message_vision(msg, me, target);
      if (skill >= 200) skill = 200;
      damage = 350 + skill * 5;  // 火球造成的伤害的最大值为200。
      damage = damage * (1 + (my_exp / (your_exp + 1)) * 10 / 100);  // 这个是经验修正。
      if (damage > 2000) damage = 2000;
      vs_fire = target->query_temp("apply/armor_vs_fire");
      if (vs_fire > 100) vs_fire = 100;
      if (vs_fire < -100) vs_fire = -100;
      damage = damage * (100 - vs_fire) / 100;  // 抵抗火系魔法修正
      vs_magic = target->query_temp("apply/armor_vs_magic");
      if (vs_magic > 100) vs_magic = 100;
      if (vs_magic < 0) vs_magic = 0;
      damage = damage * (100 - vs_magic) / 100;  // 抵抗魔法修正	    
      additional = me->query_spi();
      additional = to_int(pow(additional * additional * additional, 0.45));
      if (additional > 1000) additional = 1000;
      //   tell_object(me,"additional is "+additional+"\n");
      damage += additional;
      //   tell_object(me,"damage is "+damage+"\n");
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage / 2, me);
      COMBAT_D->report_status(target);
    } else {
      msg = YEL "结果$n大惊失色，拼命朝一旁躲去。竟然被$n躲开了\n" NOR;
      message_vision(msg, me, target);
    }
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }

  return 1;
}

void skills_limit(object me) {
  string dodge;
  dodge = me->query_skill_mapped("dodge");
  if (stringp(dodge)) {
    me->map_skill("dodge");
    me->delete_skill(dodge);
  }
}
