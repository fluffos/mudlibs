// 大唐将军府回马枪。
// Created By Pkyou@DHXYII 2002/5/7
// Update by waiwai@2003/04/25

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

nosave object *enemy = ({});

int perform(object me, object target)
{                             
       int extra;
       int rir, damage;
       mapping map;
       object weapon;
	object ridee;
	ridee=me->ride();

       if( !me->query_temp("ridee") )
        return notify_fail("你现在并没有坐骑，怎么用回马枪？\n");

	if(me->is_busy())
        return notify_fail("你正忙着呢！\n");

        extra = me->query_skill("bawang-qiang",1);

        if ( extra < 100) return notify_fail("你的枪法太差，还是省省吧！\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("你要使用回马枪戳自己吗？\n");

        if (me->query("force")<=500) return notify_fail("你内力不济，手脚发软，连枪都拿不稳。\n");

        if (me->query("sen")<=200) return notify_fail("你精神不集中，小心从马上摔下来！\n");

        map = me->query_skill_map();


        if( undefinedp(map["spear"]) ) 
                return notify_fail("你没有使用枪法。\n");

        if( map["spear"] != "bawang-qiang" )
                 return notify_fail("你并没有使用枪法\n");

        weapon = me->query_temp("weapon");      

        if( !objectp(weapon) || weapon->query("skill_type")!= "spear" )
                return notify_fail("你并没有使用枪法\n");

//        rir = target->query_skill("dodge",1);

	damage=me->query_skill("bawang-qiang") + me->query_skill("dodge") + me->query_skill("yanxing-steps");

        me->add("force",-300);
        me->add("sen",-100);
        message_vision(HIG"$N突然双腿猛的一夹马肚，俯身虚晃一枪，大喝：“今日休战”说完掉头便走。\n"NOR,me);
        me->start_busy(2);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
//        if (random(me->query("combat_exp")*(extra/15+1))>target->query("combat_exp")*(rir/30+1)) {
          weapon = me->query_temp("weapon");
             message_vision(HIG "$n浑然不知其中诡秘，果真迎头追了上去，只见$N突然勒马一个回身急转！
只见$N手中长枪连抖数下，犹如蛟龙闹海般自上而下刺向$n要害之处！\n" NOR,me,target);
         if ( extra > 300) {
		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/4,me);
		target->receive_damage("sen",damage/4,me);
		target->receive_wound("kee",damage/6,me);
		target->receive_wound("sen",damage/6,me);
		} else {
		target->receive_damage("kee",damage/2,me);
		target->receive_damage("sen",damage/2,me);
		target->receive_wound("kee",damage/4,me);
		target->receive_wound("sen",damage/4,me);
		}

          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          message_vision(HIC "$N以迅雷不及掩耳之势连抖五枪,$n没看清来势，躲避已经不及！\n" NOR,me,target);
	} else if ( extra > 250) {
		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/6,me);
		target->receive_damage("sen",damage/6,me);
		} else {
		target->receive_damage("kee",damage/3,me);
		target->receive_damage("sen",damage/3,me);
		}
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          message_vision(HIC "$N以迅雷不及掩耳之势连抖四枪,$n没看清来势，躲避已经不及！\n" NOR,me,target);
	} else if ( extra > 150) {
		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/8,me);
		target->receive_damage("sen",damage/8,me);
		} else {
		target->receive_damage("kee",damage/4,me);
		target->receive_damage("sen",damage/4,me);
		}
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          message_vision(HIC "$N以迅雷不及掩耳之势连抖三枪,$n没看清来势，躲避已经不及！\n" NOR,me,target);
	} else {
		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/10,me);
		target->receive_damage("sen",damage/10,me);
		} else {
		target->receive_damage("kee",damage/5,me);
		target->receive_damage("sen",damage/5,me);
		}
          COMBAT_D->do_attack(me,target, weapon);  
          COMBAT_D->do_attack(me,target, weapon);  
          message_vision(HIC "$N以迅雷不及掩耳之势连抖二枪,$n没看清来势，躲避已经不及！\n" NOR,me,target);
	}
          target->receive_damage("kee",0,me);
          target->start_busy(2);
	} else {
          message_vision(HIM"但$n轻松看破$N的诡计，并不上$N的当，反而一个翻身档在了$N的面前。\n"NOR,me,target);
          weapon = target->query_temp("weapon");
          COMBAT_D->do_attack(target,me,weapon);
	}
	return 1;
}
