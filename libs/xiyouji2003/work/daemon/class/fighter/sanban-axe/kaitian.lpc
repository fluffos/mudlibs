//Last Created By pkyou@xyj 2002/05/08
//大唐将军府无敌三板斧之开天劈地。

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int mypot, tapot, time;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「开天劈地」只能在战斗中使用！\n");

  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功，也想用开天劈地?\n");

  if ((int)me->query_skill("sanban-axe", 1) < 300)
    return notify_fail("你的三板斧欠缺火候，不能使用「开天劈地」！\n");

  if (me->query("force") < 500)
    return notify_fail("你的内力不足。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "正在慌乱之中，尽管攻击吧。\n");

  if (me->query_skill_mapped("force") != "lengquan-force")
    return notify_fail("「开天劈地」必须配合冷泉神功才能使用。\n");

  message_vision(HIG "\n$N" HIG "突然纵身后跃，将大斧高高举起，猛然劈向脚下土地。
刹时，大地震动，裂开的裂缝如千军万马般象$n涌去。
周围已山崩地裂，沙土飞扬，发出砰砰巨响，好不壮观！\n\n" NOR, me, target);

  mypot = (int)me->query_skill("axe");
  mypot = mypot * mypot * mypot / 10 + random((int)me->query("combat_exp"));

  tapot = (int)target->query_skill("parry");
  tapot = tapot * tapot * tapot / 10 + random((int)target->query("combat_exp"));

  time = (int)me->query_skill("sanban-axe", 1) / 5;
  if (time > 15) time = 15;
  if (time < 5) time = 5;

  if (random(mypot + tapot) > tapot) {
    message_vision(YEL "$N" YEL "被惊的面如黄蜡，不知所措，只觉脚下不稳，慌乱之中竟感无立足之地！\n" NOR,
      target);
    target->start_busy(time);
  } else {
    message_vision(HIG "$N" HIG "并不慌张，轻轻纵身一跃，双足落地，连忙提起真气稳住步伐，浑然没被地裂所惊！\n" NOR,
      target, me);
    me->start_busy(2);
  }
  me->add("force", -20 * random(time));

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  return 1;
}
