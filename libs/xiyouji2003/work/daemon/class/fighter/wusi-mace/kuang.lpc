//Last modified by waiwai@2001/05/10

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
	int extra,damage;
                
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

   if((int)me->query("force") < 500 )
     return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("wusi-mace", 1) < 120)
                return notify_fail("你的无私锏法级别还不够，使用这一招会有困难！\n");

       me->delete("env/brief_message");
	target->delete("env/brief_message");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("mace") / 3;
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);

	message_vision(HIG"\n$N"HIG"深深吸了一口真气，足尖轻轻点地，身形腾空而起，凌空向$n"HIG"使出了"BLINK HIR"［狂锏］\n"NOR,me,target);
	damage=me->query_skill("lengquan-force")/2 + me->query_skill("mace") + me->query_skill("wusi-mace");

		// Added by waiwai@2002/05/27
		if( !me->query("vip") && target->query("vip") ) {
		target->receive_damage("kee",damage/6,me);
		target->receive_wound("kee",damage/6,me);
		} else {
		target->receive_damage("kee",damage/3,me);
		target->receive_wound("kee",damage/3,me);
		}

        me->set_temp("WSJ_perform", 4);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("WSJ_perform", 2);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("WSJ_perform", 5);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("WSJ_perform", 6);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        
        me->delete_temp("WSJ_perform");
	me->add_temp("apply/attack", -extra);	
	me->add_temp("apply/damage", -extra);

        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(2);
        return 1;
}

