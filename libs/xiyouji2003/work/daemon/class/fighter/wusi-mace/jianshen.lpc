// Created by waiwai@2000/12/02

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int extra, damage;
  object weapon;
  if (!target) target = offensive_target(me);

  weapon = me->query_temp("weapon");

  if (!me->query("jjf_jianshen"))
    return notify_fail("你还没有获得终极技之密！\n");

  if (me->query("force") < 200)
    return notify_fail(HIC "你内力不足，难以使出锏神。\n" NOR);

  if ((int)me->query("max_force") < 1000)
    return notify_fail(HIC "你的内功太差。\n" NOR);

  if ((int)me->query_skill("wusi-mace", 1) < 500)
    return notify_fail(HIC "你的无私锏法级别还不够！\n" NOR);

  if ((int)me->query_skill("lengquan-force", 1) < 500)
    return notify_fail(HIC "你的冷泉神功级别不够，不能使用这一招！\n" NOR);

  if ((int)me->query_skill("literate", 1) < 500)
    return notify_fail(HIC "你的读书识字不够，不能使用这一招！\n" NOR);

  if ((int)me->query_skill("baguazhou", 1) < 500)
    return notify_fail(HIC "你的八卦咒法等级不够，不能使用这一招！\n" NOR);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIC "［锏神］只能对战斗中的对手使用。\n" NOR);

  weapon = me->query_temp("weapon");
  extra = me->query_skill("mace");

  msg = HIW "\n$N" HIW "一招［锏神］使毕冷哼一声，收势站立！\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    message_vision(HIW "$N" HIW "清啸一声，使出了" BLINK HIR "「锏神」" NOR HIW "的绝技，闪电般的扑向$n！\n\n" NOR,
      me, target);

    damage = me->query_skill("lengquan-force") + me->query_skill("mace") + me->query_skill("wusi-mace") + me->query("max_force");
    if (damage > 0) {
      message_vision(HIR "$n" HIR "惨叫一声一道" HIW "白光" HIR "贯穿身体！！！\n" NOR, me, target);

      // Added by waiwai@2002/05/27
      if (!me->query("vip") && target->query("vip")) {
        target->receive_damage("kee", damage / 2, me);
        target->receive_wound("kee", damage / 4, me);
      } else {
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage / 2, me);
      }
      me->start_busy(2 + random(2));
      me->add("force", -200);

      COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
      me->add_temp("apply/attack", -extra);
      me->add_temp("apply/damage", -extra);
      message_vision(msg, me, target);
    }
  } else {
    message_vision(HIC "但是竟然被$p" HIC "避开了$P的这一击绝杀。\n" NOR, me, target);
    me->add("force", -300);
    me->start_busy(2);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
