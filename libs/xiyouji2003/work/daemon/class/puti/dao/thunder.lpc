// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  success_adj = 80;
  damage_adj = 160;

  if (objectp(previous_object())
    && base_name(previous_object()) == __DIR__ "taijitu")
    damage_adj = 100;

  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "shen",
    HIC "\n$N口中念了句咒文，半空走出位尖头鹰鼻的雷公，左手执斧，右手提锥。\n斧锥"
    "相击，在$n" HIC "的头顶炸起一片响雷！\n" NOR,
    HIR "\n结果$n" HIR "被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR,
    HIY "\n谁知$n" HIY "毫无反应，就象聋子似的。\n" NOR,
    HIG "但是雷公被$n" HIG "以法力一激，一个失神之下响雷都炸在了$N" HIG "的头顶！\n" NOR,
    HIR "结果$n" HIR "被雷声震得眼冒金星，心神不定，差点跌倒在地！\n" NOR,
    type);
}

int cast(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展五雷咒？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("糟糕，雷公今天不当差！\n");
    return 1;
  }

  do_cast(me, target);
  me->start_busy(1 + random(2));
  return 3 + random(5);
}
