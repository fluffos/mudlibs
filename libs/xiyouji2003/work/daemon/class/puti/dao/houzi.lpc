#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        int invocation_time;
        object soldier,ob;

        if( !me->is_fighting() )
                return notify_fail(HIC"只有战斗中才能召唤孙悟空护法。\n"NOR);

        invocation_time=60+(200-(int)me->query_skill("spells"));
        if(invocation_time<40) invocation_time=40;
        if((time()-me->query("last_invocation"))<invocation_time)
            return notify_fail(HIC"你刚叫过孙悟空护法，猴子都被你叫烦了！\n"NOR);

//	if((string)me->query("family/family_name") != "方寸山三星洞" )
//		return notify_fail(HIC"只有方寸山三星洞弟子，才能召唤孙悟空护法。\n"NOR);

	if((int)me->query_skill("dao", 1) < 250 )
                return notify_fail(HIC"你的道家仙法太低了,无法召唤孙悟空护法！\n"NOR);

        if( (int)me->query("mana") < 150 )
                return notify_fail(HIC"你的法力不够了！\n"NOR);

        if( (int)me->query("sen") < 80 )
                return notify_fail(HIC"你的精神无法集中！\n"NOR);

        message_vision(HIC"$N喃喃地念了几句咒语。\n"NOR, me);

        me->add("mana", -150);
        me->receive_damage("sen", 80);

        if( random(me->query("max_mana")) < 250 ) {
                message("vision", HIC"孙悟空正在忙着，没时间理你。\n"NOR,environment(me));
                return 1;
        }

        seteuid(getuid());
        soldier = new("/obj/npc/houzi");
        soldier->move(environment(me));
        soldier->invocation(me);
        soldier->set_leader(ob);
	//By waiwai@2001/02/14
	//设定跟随敌人,避免以往的跟随自己走开回来不在战斗的问题和隐身无法跟随的问题
        soldier->set_temp("invoker",me);
        me->set("last_invocation",time());
        me->start_busy(2);

        return 8+random(5);
}

