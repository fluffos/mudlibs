// Update by waiwai@2003/04/25

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	string msg;
	string msg1;
	string msg2;
	string msg3;
	string msg4;
	int damage, i;
	i=random(3);

	if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(WHT"你只能在战斗中使用。\n"NOR);

	if((int)me->query_skill("dao", 1) < 200 )
                return notify_fail(WHT"你的道家仙法太低了！\n"NOR);

	if (i==0){
	msg1=HIW"\n$N左手捻个法诀，右手向天一指，大喝道："HIB"“般若波罗密，风火雷电击。。打！！”"HIW"\n
突然间，风起云涌，浓云密布，一道闪电向$n劈去。。\n"NOR;

	msg2=HIR"\n“轰”的一声正中目标，"+target->query("name")+NOR HIR"被电的象碳棍一样。\n"NOR;

	msg3=HIR"你只觉的全身一震，眼前金星乱冒。。。。\n"NOR;
	msg4="sen";
	}
	if(i==1){
	msg1=HIW"\n$N身形一转散作七处同时口中念道：\n"HIW"
“天地无相，万朝归宗，浩天正气，菩提伏魔！！”"HIR"\n
只见空中出现万点"HIY"金光"HIW"向$n"HIW"射去。。。\n"NOR;

	msg2=HIR"\n只听“嗤嗤”声响，金光射入"+target->query("name")+NOR HIR"身体。"+
	target->query("name")+NOR HIR"变成了千窗百孔的大筛子。\n"NOR;

	msg3=HIR"\n你只觉的遍体生风，浑身剧痛。\n"NOR;
	msg4="sen";
	}
	if (i==2){
	msg1=HIW"\n$N双手环抱胸前，口中喃喃念道：“天地无极，乾坤借法！！”\n
突然大喝一声：“般若波罗密！！”双掌并力将一巨大的七彩光球推向$n\n"NOR;

	msg2=HIR"\n“砰”。。"+target->query("name")+"身子向后一仰，连退了几步...。。。\n"NOR;

	msg3=HIR"\n“砰”。。你胸口如遭锤击，两眼一黑，险些昏了过去！\n"NOR;
	msg4="kee";
	}


	if((int)me->query("mana") < 25 )
		return notify_fail("你的法力不够！\n");

	if((int)me->query("sen") < 10 )
		return notify_fail("你的精神没有办法有效集中！\n");

	me->add("mana", -25);

	if( random(me->query("max_mana")) < 50 ) {
		write(HIC"你失败了。\n"NOR);
		return 1;
	}
	msg="\n";
	message_vision(msg1, me, target);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
		damage = (int)me->query("max_mana") + random((int)me->query("max_sen") );
		if(target->is_ghost()||target->is_zombie()) damage=damage*10;
		if( damage > 0 ) {
			target->receive_damage(msg4, damage, me);
			target->receive_wound(msg4, damage/3, me);
			tell_room(environment(me),msg2,target);
			tell_object(target,msg3);
			me->improve_skill("dao", 1, 1);
		} else	{
			msg = HIC"$N的法术好象没有造成任何伤害！\n"NOR;
			me->receive_damage("sen", 10);
			}
	} else
		msg = HIC"但是被$n躲开了。\n"NOR;
	message_vision(msg, me, target);

	if( damage > 0 ) COMBAT_D->report_status(target);

	if( !target->is_fighting(me) ) {
		if( living(target) ) {
			if( userp(target) ) target->fight_ob(me);
			else 				target->kill_ob(me);
		}
		me->kill_ob(target);
	}

	me->start_busy(2+random(2));
	return 1;
}
