//By waiwai@2000/11/27
//这个文件没做复杂的禁止项目
//最主要的是加了系统里玩家无法学到的archery做为了简单的
//限制，而使fangcun玩家有dao也无法使出来。
//如果开放给玩家,可以考虑设置200级dao能够叫哮天犬,300级
//以上的dao叫猴子

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int invocation_time;
  object soldier, ob;

  if (!me->is_fighting())
    return notify_fail(HIC "只有战斗中才能召唤哮天犬。\n" NOR);

  invocation_time = 60 + (200 - (int)me->query_skill("spells"));
  if (invocation_time < 30) invocation_time = 30;
  if ((time() - me->query("last_invocation")) < invocation_time)
    return notify_fail(HIC "你刚叫过哮天犬！\n" NOR);

  //	if((int)me->query_skill("archery", 1) < 200 )
  //                return notify_fail(HIC"你的基本弓箭太低了！\n"NOR);

  if ((int)me->query_skill("dao", 1) < 200)
    return notify_fail(HIC "你的道家仙法太低了！\n" NOR);

  if ((int)me->query("mana") < 60)
    return notify_fail(HIC "你的法力不够了！\n" NOR);

  if ((int)me->query("sen") < 80)
    return notify_fail(HIC "你的精神无法集中！\n" NOR);

  message_vision(HIC "$N喃喃地念了几句咒语。\n" NOR, me);

  me->add("mana", -50);

  if (random(me->query("max_mana")) < 60) {
    message("vision", HIC "哮天犬不知道跑到哪里去了。\n" NOR, environment(me));
    return 1;
  }

  seteuid(getuid());
  soldier = new("/obj/npc/xiaotian-quan");
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->set_leader(ob);
  //By waiwai@2001/02/14
  //设定跟随敌人,避免以往的跟随自己走开回来不在战斗的问题和隐身无法跟随的问题
  soldier->set_temp("invoker", me);
  me->set("last_invocation", time());
  me->start_busy(2);

  return 5 + random(5);
}
