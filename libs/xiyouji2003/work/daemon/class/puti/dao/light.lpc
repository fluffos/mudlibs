// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  success_adj = 70;
  damage_adj = 150;

  if (objectp(previous_object())
    && base_name(previous_object()) == __DIR__ "taijitu") {
    tell_object(me, "？？？\n");
    damage_adj = 100;
  }


  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "kee",
    HIC "\n$N" HIC "口中念了句咒文，半空走出一位容貌秀雅的电母，双手各持一枚铜镜。\n铜镜"
    "相转，忽的闪出一道金光射向$n" HIC "！\n" NOR,
    HIR "\n结果「嗤」地一声，金光从$n" HIR "身上透体而过，\n拖出一条长长的血箭，直射到"
    "两三丈外的地下！\n" NOR,
    HIY "结果嗤！地一声$n" HIY "闻到了一股焦味。还好只烧掉了几根头发。\n" NOR,
    HIG "但是金光被$n" HIG "以法力反激，反向$N" HIG "射去！\n" NOR,
    HIR "结果金光从$n" HIR "身上透体而过，拖出一条长长的血箭，直射到两三丈外的地下！\n" NOR,
    type);
}

int cast(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展苍灵箭？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("看来电母今天没空。\n");
    return 1;
  }

  do_cast(me, target);

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
