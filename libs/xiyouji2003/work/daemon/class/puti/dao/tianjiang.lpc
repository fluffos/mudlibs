// invocation.c

inherit SSERVER;
#include <ansi.h>

int cast(object me, object target) {
  int invocation_time;
  object soldier;

  if (!me->is_fighting())
    return notify_fail(HIC "只有战斗中才能召唤天将！\n" NOR);

  invocation_time = 60 + (200 - (int)me->query_skill("spells"));
  if (invocation_time < 25) invocation_time = 25;
  if ((time() - me->query("last_invocation")) < invocation_time)
    return notify_fail(HIC "你刚叫过天将，他们都被你叫烦了！\n" NOR);

  if ((int)me->query("mana") < 150)
    return notify_fail(HIC "你的法力不够了！\n" NOR);

  if ((int)me->query("sen") < 80)
    return notify_fail(HIC "你的精神无法集中！\n" NOR);

  message_vision(HIC "$N喃喃地念了几句咒语。\n" NOR, me);

  me->add("mana", -150);
  me->receive_damage("sen", 80);

  if (random(me->query("max_mana")) < 250) {
    message("vision", HIC "但是什么也没有发生。\n" NOR,
      environment(me));
    return 1;
  }

  seteuid(getuid());
  soldier = new("/obj/npc/heaven_soldier");
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->set_temp("invoker", me);
  me->set("last_invocation", time());
  me->start_busy(1);

  return 8 + random(5);
}
