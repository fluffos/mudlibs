#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	int orforce;
	object weapon;
	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

	extra = me->query_skill("puti-zhi",1);

	if( userp(me) ) {
	if((int)me->query_skill("puti-zhi", 1) <600)
		return notify_fail("你的菩提指级别还不够！\n");

	if(!me->query("vip"))
        	return notify_fail("你非VIP会员，不能使用这一招！\n");

       if (me->query("force")<500)
           return notify_fail(WHT"你内力不足，无法继续使出连环菩提指。\n"NOR);

	if((int)me->query_skill("wuxiangforce", 1) <600)
		return notify_fail("你的小无相功级别还不够！\n");

	if((int)me->query_skill("unarmed", 1) <extra)
           return notify_fail(WHT"你的基本扑击格斗小于菩提指级别，无法使出连环菩提指。\n"NOR);

	if((int)me->query("combat_exp", 1) < 5000000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");

      if (me->query_skill_mapped("force")!="wuxiangforce")
                return notify_fail("连环菩提指必须配合小无相功才能使用。\n");
	}

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［连环菩提指］只能对战斗中的对手使用。\n");

	weapon = me->query_temp("weapon");

	message_vision(HIY"\n$N使出菩提指中的 "BLINK HIR"［连环菩提指］ "NOR HIY" 一招连环向"HIW"$n"HIY"攻出！\n"NOR,me,target);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
	me->add_temp("apply/attack",extra*3);me->add_temp("apply/damage",extra*3);

        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t上一指！\n"NOR,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t下一指！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t左一指！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t右一指！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t前一指！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t后一指！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        message_vision(HIY"\t\t最后再一指！\n"NOR,me,target);
        me->add_temp("apply/attack",-extra*3);me->add_temp("apply/damage",-extra*3);

//	 me->set("force_factor",200);
        me->add("force", -200);
        me->start_busy(4);
	} else {
	message_vision(HIC"可是$p"HIC"竟然在狼狈不堪中避开了$P的这漫天的指影。\n"NOR,me,target);
       me->add("force", -300);
	me->start_busy(3);
	}
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

	return 1;
}
