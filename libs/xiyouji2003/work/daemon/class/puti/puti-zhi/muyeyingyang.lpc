// muyeyingyang.c 牧野鹰扬

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIW "牧野鹰扬只能对战斗中的对手使用。\n" NOR);

  if ((int)me->query_str() < 28)
    return notify_fail(HIW "你臂力不够,不能使用牧野鹰扬！\n" NOR);

  if ((int)me->query("combat_exp", 1) < 1300000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if ((int)me->query_skill("puti-zhi", 1) < 140)
    return notify_fail("你的菩提指修为不够,目前还不能使用牧野鹰扬！\n");

  if (me->query_skill_mapped("spells") != "dao")
    return notify_fail("牧野鹰扬必须配合道家仙法才能使用。\n");

  if (me->query_skill_mapped("force") != "wuxiangforce")
    return notify_fail("牧野鹰扬必须配合小无相功才能使用。\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你内力现在不够, 不能使用牧野鹰扬！\n");

  if (target->is_busy())
    return notify_fail(target->name() + HIW "目前正自顾不暇，放胆攻击吧！\n" NOR);

  msg = HIY "$N使出菩提指绝技" BLINK HIR "「牧野鹰扬」" NOR HIY "，单指幻影般蓦地点向$n" HIY "的全身要穴。\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    msg += HIR "结果$p被$P点中要穴，立时动弹不得！\n" NOR;
    // Added by waiwai@2002/05/27
    if (!me->query("vip") && target->query("vip"))
      target->start_busy(3);
    else
      target->start_busy((int)me->query_skill("puti-zhi", 1) / 10 + 2);

    me->add("force", -100);
  } else {
    me->add("force", -150);
    msg += HIG "可是$p看破了$P的企图，并没有上当。\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);

  return 1;
}
