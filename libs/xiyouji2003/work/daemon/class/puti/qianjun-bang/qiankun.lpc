//Last modified by waiwai@2001/06/13

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int i,extra,damage;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

        if(!me->is_fighting())
                return notify_fail("「乾坤一棒」只能在战斗中使用！\n");

      if (me->query_skill_mapped("force")!="wuxiangforce")
                return notify_fail("乾坤一棒必须配合小无相功才能使用。\n");

      if (me->query_skill_mapped("spells")!="dao")
                return notify_fail("乾坤一棒必须配合道家仙法才能使用。\n");

        if((int)me->query("max_force") < 900 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 250 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

//	i=(int)me->query_skill("qianjun-bang",1)+(int)me->query_kar();
	i=me->query_skill("qianjun-bang",1);

        if( i < 60)
                return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");

	message_vision(HIW"\n$N运足精神，一个高跳在空，使出了「乾坤一棒」的绝技！\n"NOR,me);
	me->delete("env/brief_message");
	target->delete("env/brief_message");
	extra = me->query_skill("qianjun-bang");

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3) {
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
	damage=me->query_skill("qianjun-bang") + me->query_skill("stick") + me->query_skill("dao");
           if( damage > 0 ) {
            message_vision(HIR"\n$n"HIR"惨叫一声顿时被砸的血肉模糊！！！\n"NOR,me,target);

	target->receive_damage("kee",damage/2,me);
	target->receive_wound("kee",damage/3,me);

        me->set_temp("QJB_perform", 7);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->delete_temp("QJB_perform");

        me->receive_damage("sen", 100+random(100));
        me->add("force", -200);
        me->start_busy(2+random(2));
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
          }
	} else {
          message_vision(HIC"但是竟然被$p"HIC"避开了$P的这千钧一击。\n"NOR,me,target);

		me->start_busy(2);
        }

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        return 1;
}

