//Last modified by waiwai@2001/06/13

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int damage;
   
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail(HIW"你只能在战斗中使用。\n"NOR);

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

        if(!me->is_fighting())
                return notify_fail("「霹雳三打」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("qianjun-bang", 1) < 300)
                return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");

       me->delete("env/brief_message");
	target->delete("env/brief_message");
	damage=me->query_skill("qianjun-bang") + me->query_skill("stick") + me->query("max_force");

       message_vision(HIW"\n$N运足精神，身形一转，霹雳间连续向$n"HIW"攻出了三招！\n"NOR,me,target);

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/2) {
	me->add_temp("apply/attack", damage/2);	
	me->add_temp("apply/damage", damage/2);

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	 target->receive_damage("kee",damage/3,me);
        message_vision(HIG"\t\t第一棒。。。\n"NOR,me,target);

        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
	 target->receive_damage("kee",damage/3,me);
        message_vision(HIG"\t\t\t第二棒。。。\n"NOR,me,target);

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	 target->receive_damage("kee",damage/3,me);
        message_vision(HIG"\t\t\t\t第三棒。。。\n"NOR,me,target);

	 target->receive_wound("kee",damage/3,me);

	 me->add_temp("apply/attack",-damage/2);
	 me->add_temp("apply/damage",-damage/2);

        me->receive_damage("sen", 100);
        me->add("force", -100);
        me->start_busy(2+random(2));
	} else {
             message_vision(HIC"但是竟然被$p"HIC"躲开了。\n"NOR,me,target);
		me->start_busy(3);
        }

              target->kill_ob(me);

        return 1;
}

