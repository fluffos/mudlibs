//Creat by waiwai@2001/05/03
//追魂夺魄

#include <ansi.h>

inherit SSERVER;

#include "/daemon/skill/eff_msg.h";

string *xue_name = ({
  "中府穴", "商阳穴", "承泣穴", "胸乡穴",
  "尺泽穴", "合谷穴", "下关穴", "服哀穴",
  "云门穴", "迎香穴", "梁门穴", "血海穴",
  "列缺穴", "天鼎穴", "梁丘穴", "三阴交穴",
  "太渊穴", "曲池穴", "足三里穴", "阴陵泉穴",
  "通里穴", "天宗穴", "睛明穴", "涌泉穴",
  "神门穴", "听宫穴", "攒竹穴", "复溜穴",
  "青灵穴", "肩贞穴", "天柱穴", "然谷穴",
  "极泉穴", "肩中俞穴", "膏肓穴", "陰谷穴",
  "灵海穴", "肩外俞穴", "承山穴", "太溪穴",
  "曲泽穴", "外关穴", "听会穴", "期门穴",
  "中冲穴", "支沟穴", "阳白穴", "大敦穴",
  "劳宫穴", "耳门穴", "风池穴", "行间穴",
  "内关穴", "翳风穴", "肩井穴", "太冲穴",
  "间使穴", "丝竹空穴", "风市穴", "中封穴",
  "会阴穴", "五枢穴", "筑宾穴", "金门穴",
  "阴交穴", "维道穴", "府舍穴", "阳交穴",
  "气冲穴", "大横穴", "正营穴", "中注穴",
  "天突穴", "承灵穴", "幽门穴", "天寥穴",
  "商曲穴", "百会穴", "照海穴", "跗阳穴",
  "长强穴", "檀中穴", "交信穴", "审脉穴",
  "命门穴", "中极穴", "仆参穴", "至阳穴",
  "关元穴", "巨骨穴", "神柱穴", "气海穴",
  "地仓穴", "大椎穴", "神阙穴" "中脘穴",
  "风府穴", "天突穴", "腰阳关穴" });

int perform(object me, object target) {
  string msg;
  int damage, p, time, skill, skill2;
  object weapon;

  weapon = me->query_temp("weapon");

  skill = (int)me->query_skill("kusang-bang", 1);
  skill2 = (int)me->query_skill("stick", 1);

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(WHT "「追魂夺魄」只能在战斗中使用。\n" NOR);

  if (skill < 200 || skill2 < 200)
    return notify_fail(WHT "你的棒法还不够娴熟，不能使出「追魂夺魄」。\n" NOR);

  if ((int)me->query("combat_exp", 1) < 3000000)
    return notify_fail(WHT "你的武学不够，不能使用这一招！\n" NOR);

  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail(WHT "以你现在的内功修为还使不出「追魂夺魄」。\n" NOR);

  if ((int)me->query("max_force") < 3000)
    return notify_fail(WHT "以你现在的内力修为还使不出「追魂夺魄」。\n" NOR);

  if ((int)me->query("force") < 600)
    return notify_fail(WHT "你的内力不足了！\n" NOR);

  if (me->query_temp("zhuihun_busy"))
    return notify_fail(WHT "你已经在使用[追魂夺魄]了。\n" NOR);

  if (me->query("combat_exp") > target->query("combat_exp") / 3) {
    message_vision(
      HIB "$N一抖手中的" + weapon->name() + HIB ",一式[追魂夺魄]使出,身行如同鬼魅般地直逼$n " NOR,
      me,
      target
    );
    me->set_temp("zhuihun_busy", 1);
    remove_call_out("remove_zhuihun");
    call_out("remove_zhuihun", 6 + random(3), me);
    target->start_busy(1);
    damage = skill + random(skill2 / 2);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -(damage / 4));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg = damage_msg(damage, "砸伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    if (skill > 250)
      target->set_temp("last_damage_from", me);
    remove_call_out("perform2");
    call_out("perform2", 1, me, target);
  } else {
    me->start_busy(3);
    me->add("force", -200);
    message_vision(HIC "可是却被$p" HIC "腾身一越躲开了。\n" NOR, me, target);
  }
  message_vision(msg, me, target);
  return 1;
}

// 第二击 skill>250
int perform2(object me, object target) {
  int damage, p, skill, skill2;
  string msg, weapon;
  object gui;

  weapon = me->query_temp("weapon");
  skill = (int)me->query_skill("kusang-bang", 1);
  skill2 = (int)me->query_skill("stick", 1);

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target->is_ghost()
    || target == me)
    return notify_fail(WHT "你如鬼魅般地一声冷笑,缓缓收势而立！\n" NOR);

  if (!living(target))
    return notify_fail(WHT "对手已经不能再战斗了。\n" NOR);

  if ((int)me->query("force", 1) < 300)
    return notify_fail(WHT "你欲再度攻击，却发现自己的内力不够了！\n");
  msg = HIB "\n只见$N突然一顺" + weapon->name() + HIB ",一阵蓝色的烟雾升起，烟雾中几个骷髅小鬼出现在$n" HIB "面前 \n" NOR;
  message_vision(msg, me, target);
  if (me->query("combat_exp") > target->query("combat_exp") / 3) {
    msg = HIB "\n$N左手一招,骷髅小鬼发疯般地攻向$n\n\n" NOR;
    gui = new("/obj/npc/hell_gui");
    gui->move(environment(me));
    gui->invocation(me);
    gui->set_temp("invoker", me);
    me->start_busy(1);
    target->start_busy(1);
    damage = skill + skill2;
    damage = damage + (int)me->query_skill("force", 1);
    damage = damage + random(damage * 3 / 2);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -(damage / 4));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "刺伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    target->set_temp("last_damage_from", me);
    if (skill > 300)
      remove_call_out("perform3");
    call_out("perform3", 1, me, target);
  } else {
    me->start_busy(3);
    me->add("force", -300);
    msg += HIC "\n可是$p" HIC "运气反击,$N" HIC "被众小鬼后退的步伐搞了个手忙脚乱！\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}

//第三击 skill>300
int perform3(object me, object target) {
  string msg, weapon;
  int p, skill, skill2, j;
  j = 2 + random(3);
  skill = (int)me->query_skill("kusang-bang", 1);
  skill2 = (int)me->query_skill("stick", 1);
  weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target->is_ghost()
    || target == me)
    return notify_fail(WHT "你如鬼魅般地一声冷笑,缓缓收势而立！\n" NOR);

  if (!living(target))
    return notify_fail(WHT "对手已经不能再战斗了。\n" NOR);

  if ((int)me->query("force", 1) < 300)
    return notify_fail(WHT "你欲三度进击，却发现自己的内力不够了！\n");

  msg = HIB "\n$N" HIB "一声唳啸，身随点点，$n" HIB "感觉$N" HIB "的身影无处不在,茫然不知如何应付！\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", skill);
  me->add_temp("apply/dodge", skill);
  me->add_temp("apply/parry", skill);
  for (p = 1; p < 2 + random(2); p++)
    COMBAT_D->do_attack(me, target, weapon);
  if (!target->is_fighting(me))
    if (living(target))
      if (userp(target)) target->fight_ob(me);
  msg = HIB "\n\n$N" HIB "如鬼魅般地一声冷笑,缓缓收势而立！！\n" NOR;
  message_vision(msg, me, target);
  msg = HIB "\n$N激战中突然撤身而回,$n" HIB "顿时一轻,倒吸了口冷气！！\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/parry", -skill);
  me->add_temp("apply/dodge", -skill);
  me->add_temp("apply/attack", -skill);
  me->start_busy(1 + random(1));
  if (random(me->query("combat_exp")) > random(target->query("combat_exp") / 3)) {
    if (skill > 350)
      remove_call_out("perform4");
    call_out("perform4", 1, me, target);
  }
  return 1;
}

//第四击 skill>350
int perform4(object me, object target) {
  int damage, p, skill, skill2;
  string msg, weapon, name;
  name = xue_name[random(sizeof(xue_name))];
  weapon = me->query_temp("weapon");
  skill = (int)me->query_skill("kusang-bang", 1);
  skill2 = (int)me->query_skill("stick", 1);

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target->is_ghost()
    || target == me)
    return notify_fail(WHT "你如鬼魅般地一声冷笑,缓缓收势而立！\n" NOR);

  if (!living(target))
    return notify_fail(WHT "对手已经不能再战斗了。\n" NOR);

  if ((int)me->query("force", 1) < 1000)
    return notify_fail(WHT "你欲四展翅翼之际，却发现自己的内力不足以支撑进攻了！\n" NOR);

  msg = HIB "\n哪知$N" HIB "的" + weapon->name() + HIB "竟然不知从何处刺向$n \n" NOR;
  message_vision(msg, me, target);
  if (random(me->query("combat_exp")) > random(target->query("combat_exp") / 3)) {
    msg = HIR "\n$n" HIR "慌乱中已经躲闪不及,被" + weapon->name() + HIR "刺中" + name + "！！\n\n" NOR;
    me->start_busy(2);
    target->start_busy(1);
    damage = skill + skill2;
    damage = damage + (int)me->query_skill("force", 1);
    damage = damage + random(damage * 3 / 2);
    target->receive_damage("kee", damage * 2, me);
    target->receive_wound("kee", damage, me);
    me->add("force", -(damage / 4));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "点穴伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    target->set_temp("last_damage_from", me);
    message_vision(msg, me, target);
  } else {
    me->start_busy(3);
    me->add("force", -400);
    msg += HIC "\n可是$p" HIC "竟然一个釜底抽薪,反手一式,$N" HIC "反而搞了个手忙脚乱！\n" NOR;
    message_vision(msg, me, target);
  }
  return 1;
}

void remove_zhuihun(object me) {
  if (!me) return;
  me->delete_temp("zhuihun_busy");
}
