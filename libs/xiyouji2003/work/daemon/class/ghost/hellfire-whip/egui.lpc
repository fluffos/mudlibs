//Creat by waiwai@2000/09/08

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIC "牵制攻击只能对战斗中的对手使用。\n" NOR);
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail(HIC "你使用的武器不对。\n" NOR);
  if ((int)me->query_skill("hellfire-whip", 1) < 100)
    return notify_fail(HIC "你的烈火鞭还没学到家，用不了「恶鬼缠身」。\n" NOR);
  if (target->is_busy())
    return notify_fail(target->name() + HIC "目前正自顾不暇，放胆攻击吧。\n" NOR);

  msg = HIY "$N使出鬼索之「恶鬼缠身」，手中长索忽上忽下，忽左忽右，编织成一张鞭网罩向$n。\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    msg += HIR "结果$p" + HIR "被$P缠了个结实。\n" NOR;
    me->start_busy(1);
    target->start_busy((int)me->query_skill("hellfire-whip") / 20);
  } else {
    msg += HIW "可是$p" + HIW "竟然纵身避过了鞭网。\n" NOR;
    me->start_busy(2);

  }
  message_vision(msg, me, target);

  return 1;
}
