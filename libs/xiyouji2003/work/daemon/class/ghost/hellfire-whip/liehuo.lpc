// Created by waiwai@2000/09/08

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, lmt, damage;
  object weapon;
  extra = me->query_skill("hellfire-whip");

  if ((int)me->query_skill("hellfire-whip", 1) < 150)
    return notify_fail("你的烈火鞭级别还不够，使用这一招会有困难！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够了！\n");
  if ((int)me->query("combat_exp", 1) < 1500000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if (!wizardp(me) && userp(me)) {
    if ((int)me->query_skill("literate", 1) < 150)
      return notify_fail("你的读书识字不够，不能使用这一招！\n");
    if ((int)me->query_skill("tonsillit", 1) < 150)
      return notify_fail("你的摄气诀级别不够，不能使用这一招！\n");
    if ((int)me->query_skill("gouhunshu", 1) < 150)
      return notify_fail("你的勾魂术级别不够，不能使用这一招！\n");
  }

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［烈火］只能对战斗中的对手使用。\n");

  weapon = me->query_temp("weapon");
  damage = extra * 2 + random(extra);

  message_vision(HIW "\n$N" HIW "凶性大发，大喊一声" BLINK HIR " ［烈火］" NOR HIW " 手中的" +
    weapon->name() + HIW "狂风暴雨般地向$n" HIW "卷去！\n\n" NOR, me, target);
  if (me->query("combat_exp") > target->query("combat_exp") / 3) {
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage, me);

    lmt = random(9) + 3;
    for (i = 1; i <= lmt; i++) {
      message_vision(HIR "\t\t\t\t第" HIG + chinese_number(i) + HIR "鞭 \n " NOR, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    }
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
  } else message_vision(HIC "\n结果一鞭未碰到$n！\n" NOR, me, target);

  me->start_busy(3);
  me->add("force", -300);

  return 1;
}
