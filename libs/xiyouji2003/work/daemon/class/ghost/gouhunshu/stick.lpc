#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	string msg;
	int  skill;

	skill=me->query_skill("kusang-bang",1);

       if(userp(me) && !wizardp(me) ) {

	if( !skill || skill < 50 )
		return notify_fail("你的哭丧棒法太低！\n");

	if(me->query_temp("execration"))
		return notify_fail("你正在念咒。\n");

	if(me->query_temp("weapon"))
		return notify_fail("你手上已经有武器了。\n");

//if( (string)me->query("occupation") != "fighter" || (string)me->query("zhongzu") != "man" )
//      return notify_fail("你并非人族武士，无法使用这把刀。\n");

       if (userp(me) && !me->query("vip") )
          return notify_fail(HIW"VIP会员专用，你无权使用！\n"NOR);

	if((int)me->query("family/family_faith") < 100 )
		return notify_fail("你的门忠不够！\n");

	if((int)me->query_skill("gouhunshu", 1) < 50)
        	return notify_fail("你的勾魂术级别不够！\n");
	}

	if((int)me->query("mana") < 100 )
		return notify_fail("你的法力不够！\n");

	if((int)me->query("sen") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");

       me->start_busy(2);
       me->add("mana", -100);
	me->receive_damage("sen", 50);
	msg=HIW"$N"HIW"念念有词：籍着黑暗的力量～～～\n"NOR;
	message_vision(msg,me);
	me->set_temp("execration",1);
	call_out("do_execration",2,me,skill);
	return 1;
}

int do_execration(object me,int skill)
{
	string msg;
	object stick;

	me->delete_temp("execration");

	if(me->query_temp("weapon")) {
	    tell_object(me,"你已经有武器了。终止施法\n");
	    return 1;
	}

	stick=new("/daemon/class/obj/magicstick");

	if(!stick) {
	    tell_object(me,"/daemon/class/obj/magicstick.c文件出错。\n");
	    return 1;
	}

       msg=HIY"只见一道金光延伸过来，集结在$N"HIY"的手上，竟形成了一根棒状物体----"HIW"光之棒 \n"NOR;
	message_vision(msg,me);
	stick->move(me);
	stick->wield();
	stick->do_dest(me,skill*2);
	if(skill>=500) skill=500;
       stick->set("weapon_prop/damage",skill/3);
	me->set_temp("apply/damage",skill/3);
	return 1;
}

