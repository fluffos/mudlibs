// Created by waiwai@2000/05/01

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string dodskill,msg,str;
	int extra;
	object weapon;
	extra = me->query_skill("yange-blade",1);
	if ( extra < 150) return notify_fail("你的［雁歌刀法］还不够纯熟！\n");
	dodskill = (string) me->query_skill_mapped("dodge");
	if ( dodskill != "baguazhen")
			return notify_fail("［雁歌刀法］需要八卦阵法的配和！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIR"［大漠雁歌］ "NOR"只能对战斗中的对手使用。\n");

        if((int)me->query("max_force") < 2000 )
                return notify_fail("你的内力不够！\n");

	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

       if (userp(me) && !wizardp(me) )
          return notify_fail(HIW"这个指令已被禁止玩家使用！\n"NOR);

	if( userp(me) && !wizardp(me) ) {
	if((int)me->query("combat_exp", 1) < 3500000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");

	if((int)me->query_skill("taiyi", 1) <400)
		return notify_fail("你的太乙仙法级别还不够！\n");

	if((int)me->query_skill("literate", 1) < 400)
        	return notify_fail("你的读书识字不够，不能使用这一招！\n");


        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
	}
	if((int)me->query("force") < 200 )
		return notify_fail("你的内力不足！\n");

	weapon = me->query_temp("weapon");
        me->add_temp("apply/damage",extra*2);
        me->add_temp("apply/attack",extra*2);

	message_vision("\n$N神气贯通，将"BLINK HIR"大漠雁歌"NOR"七式一气呵成！\n"NOR,me,target);

        msg = HIY  "孤城落日！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "大漠穷秋！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "力尽关山！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "边风飘摇！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "山川萧条！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "绝域苍茫！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = HIY  "乾坤归宗！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	 target->receive_damage("kee",extra/3,me);

        me->add_temp("apply/damage",-extra*2);
        me->add_temp("apply/attack",-extra*2);

      if (userp(target)){//By waiwai@2001/05/12 避免杀死npc刷屏
               if (target->query("eff_kee")<0 || !living(target))  
      {str=target->name()+HIW"被"HIY+me->name()+HIW"用雁歌刀法绝招「大漠雁歌」狂斩而死！！！";
	        message("channel:rumor",HIR"┋大漠雁歌┋"HIW"据说"HIG+str+"\n"NOR,users());
           }
             }

       me->add("force", -200);
	me->start_busy(5);
	return 3+random(5);
//	me->set("force_factor",100);

	return 1;
}
