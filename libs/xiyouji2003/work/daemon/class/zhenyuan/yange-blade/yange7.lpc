//Last modified by waiwai@2001/05/12
//雁歌七式

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string str;
  int yangeblade, zhenyuanforce, baguazhen, ini_damage_apply, times, damage;

  string desc_msg = "";
  int blade_level;

  yangeblade = (int)me->query_skill("yange-blade", 1);
  zhenyuanforce = (int)me->query_skill("zhenyuan-force", 1);
  baguazhen = (int)me->query_skill("baguazhen", 1);

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「雁歌七式」？\n");

  if (!me->is_fighting())
    return notify_fail("「雁歌七式」只能在战斗中使用！\n");


  blade_level = (int)(yangeblade / 50);
  if (yangeblade < 100)
    return notify_fail("你的雁歌刀法级别还不够，使用这一招会有困难！\n");

  if (me->query("family/family_name") != "五庄观")
    return notify_fail("[雁歌七式]是五庄观独门绝学！\n");

  if (zhenyuanforce < 100)
    return notify_fail("你的镇元神功修为不够，使用这一招会有困难！\n");

  if (baguazhen < 100)
    return notify_fail("你的八卦阵法级别还不够，使用这一招会有困难！\n");

  if (me->query("force_factor") > 0)
    return notify_fail("「雁歌七式」绝技重招不重力。加力出招怎能刀走轻灵？\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你的内力不足。\n");

  if (time() - (int)me->query_temp("yg_end") < 10)
    return notify_fail("绝招用多就不灵了！\n");
  if (blade_level <= 1) desc_msg = ""; else
    desc_msg = chinese_number(blade_level);
  if (blade_level > 9) desc_msg = "百";
  ini_damage_apply = me->query_temp("apply/damage");

  message_vision(HIW "\n$N暗运真气，脚尖一点，身体急速上旋，在半空中一个折腰。
同时手腕轻抖，刀光闪动幻作漫天刀影卷向$n。\n" NOR, me, target);
  damage = 1;
  //前三式
  message_vision(HIR "\n$N同时使出雁歌七式的前三式，在半空中斩向$n。\n" NOR, me, target);

  if (me->query("combat_exp") > target->query("combat_exp") / 3) {
    target->receive_damage("kee", yangeblade / 5, me);
    target->receive_wound("kee", yangeblade / 5, me);
  }

  me->set_temp("YG_perform", 5);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (damage < 1) me->add_temp("apply/damage", 100);
  me->set_temp("YG_perform", 0);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (damage < 1) { me->add_temp("apply/damage", 100); } else {
    me->set_temp("apply/damage", ini_damage_apply);
  }
  me->set_temp("YG_perform", 6);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add("force", -300);

  //再两式
  if (yangeblade > 199 && zhenyuanforce > 199 && baguazhen > 199) {
    message_vision(HIW "\n$N身体斜斜向上飘出，也不回头，反手就又劈出了两刀。\n" NOR, me);

    if (me->query("combat_exp") > target->query("combat_exp") / 3) {
      target->receive_damage("kee", yangeblade / 3, me);
      target->receive_wound("kee", yangeblade / 3, me);
    }

    if (damage < 1) { me->add_temp("apply/damage", 100); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("YG_perform", 7);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    if (damage < 1) { me->add_temp("apply/damage", 100); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("YG_perform", 8);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -200);

  }

  //后两式
  if (yangeblade > 299 && zhenyuanforce > 299 && baguazhen > 299) {
    message_vision(HIG "\n$N斜斜一再个翻身，刀花幻作千百支气箭，夹着一股寒风扑向$n。\n" NOR, me, target);

    if (me->query("combat_exp") > target->query("combat_exp") / 3) {
      target->receive_damage("kee", yangeblade / 2, me);
      target->receive_wound("kee", yangeblade / 2, me);
    }
    if (damage < 1) { me->add_temp("apply/damage", 100); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("YG_perform", 9);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    if (damage < 1) { me->add_temp("apply/damage", 300); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("YG_perform", 10);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -100);

    if (userp(target)) {  //By waiwai@2001/05/12 避免杀死npc刷屏
      if (target->query("eff_kee") < 0 || !living(target)) {
        str = target->name() + HIW "被" HIY + me->name() + HIW "用雁歌刀法绝招「雁歌七式」狂斩" HIR + desc_msg + "十" HIW "多刀而死！！！";
        message("channel:rumor", HIR "┋雁歌七式┋" HIW "据说" HIG + str + "\n" NOR, users());
      }
    }
  }
  me->delete_temp("YG_perform");
  me->set_temp("apply/damage", ini_damage_apply);


  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->set_temp("yg_end", time());
  return 1;
}
