// Created by waiwai@2000/05/01

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string dodskill, msg, str;
  int extra;
  object weapon;
  extra = me->query_skill("yange-blade", 1);
  if (extra < 60) return notify_fail("你的［雁歌刀法］还不够纯熟！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "baguazhen")
    return notify_fail("［雁歌刀法］需要八卦阵法的配和！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR "［大漠落日］ " NOR "只能对战斗中的对手使用。\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query_skill("taiyi", 1) < 60)
    return notify_fail("你的太乙仙法级别还不够！\n");

  if ((int)me->query("force") < 250)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  weapon = me->query_temp("weapon");

  message_vision("\n$N神气贯通，将" BLINK + HIR "大漠落日" NOR "三式一气呵成！\n" NOR, me, target);
  if (me->query("combat_exp") > target->query("combat_exp") / 3) {
    me->add("force", -150);
    me->start_busy(2 + random(1));
    me->add_temp("apply/damage", extra);
    me->add_temp("apply/attack", extra);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t孤城落日！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t边风飘摇！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    message_vision(HIY "\t\t\t\t山川萧条！\n" NOR, me, target);
    me->add_temp("apply/damage", -extra);
    me->add_temp("apply/attack", -extra);
  } else {

    me->start_busy(2 + random(2));
    me->add("force", -200);
    message_vision(HIC "可是却被$p" HIC "轻巧地躲开了，毫发无伤。\n" NOR, me, target);
  }


  if (userp(target)) {  //By waiwai@2001/05/12 避免杀死npc刷屏
    if (target->query("eff_kee") < 0 || !living(target)) {
      str = target->name() + HIW "被" HIY + me->name() + HIW "用雁歌刀法绝招「大漠落日三式」狂斩而死！！！";
      message("channel:rumor", HIR "【谣言】" HIW "据说" HIG + str + "\n" NOR, users());
    }
  }
  return 1;
}
