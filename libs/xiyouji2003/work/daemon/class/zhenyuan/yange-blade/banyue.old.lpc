//半月弯刀　by jack 06/25/2002

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon = me->query_temp("weapon");
  int hita, hitb, hitc;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用半月弯刀？\n");

  if ((int)me->query_skill("taiyi", 1) < 120)
    return notify_fail("你的太乙仙法修为太浅，无法使用半月弯刀。\n");

  if ((int)me->query_skill("yange-blade", 1) < 120)
    return notify_fail("你的雁歌刀修为太浅，无法使用半月弯刀。\n");

  if ((int)me->query("mana") < (int)me->query("mana_factor") + (int)me->query("force_factor"))
    return notify_fail("你的法力不够，没办法使用半月弯刀。\n");
  if ((int)me->query("force") < (int)me->query("mana_factor") + (int)me->query("force_factor"))
    return notify_fail("你的内力不够，没办法使用半月弯刀。\n");

  if (!target->is_fighting(me))
    return notify_fail("只有在战斗中才能使用半月弯刀！\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你现在精神不振，使用半月刀法必须精神集中！\n");

  me->add("mana", -25);
  me->add("force", -25);
  me->receive_damage("sen", 10);

  msg = HIR "只见$N内力突发，手中的" + weapon->name() + HIR "也红光闪闪\n\n" NOR;
  msg += HIR "忽然一刀向$n劈去。\n\n" NOR;
  message_vision(msg, me, target);

  if (me->query_temp("banyue_wandao"))
    return notify_fail(HIR "你忽然觉得刀气不足，猛然收住攻势！\n" NOR);

  hitc = random(me->query_skill("yange-blade") / 2) + random(me->query_skill("blade") / 2) + random(me->query_skill("force") / 2) + me->query_skill("zhenyuan-force") / 2 + random(me->query("force_factor"));
  hitb = random(target->query_skill("dodge")) + random(target->query_skill("dodge")) + random(target->query_skill("force"));
  hita = hitc - hitb;
  if (hita > 0) {
    msg = HIR "刀至之处，草木皆毁，形如弯月，锋利无比。\n\n" NOR;
    me->start_busy(1 + random(2));

    me->add("mana", -(int)me->query("mana_factor"));
    me->add("force", -(int)me->query("force_factor"));
    me->receive_damage("sen", 100);

    message_vision(msg, me, target);
    target->receive_damage("kee", hita, me);
    target->receive_damage("sen", hita, me);
    target->receive_wound("kee", hita / 6, me);
    target->receive_wound("sen", hita / 6, me);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
    me->set_temp("banyue_wandao", 1);
    call_out("wandao_busy", 7, me, target);
  } else {
    msg = HIR "结果一招落空，招招失败，$N不得不连忙收手。\n\n" NOR;
    me->start_busy(2 + random(2));
    message_vision(msg, me, target);
    return 1;
  }
  if (hita >= 0 && hita < 50) call_out("hit_1", 1, me, target);
  if (hita >= 50 && hita < 100) call_out("hit_2", 2, me, target);
  if (hita >= 100 && hita < 180) call_out("hit_3", 3, me, target);
  if (hita >= 180 && hita < 260) call_out("hit_4", 3, me, target);
  if (hita >= 260 && hita < 350) call_out("hit_5", 4, me, target);
  if (hita >= 350 && hita < 460) call_out("hit_6", 4, me, target);
  if (hita >= 460) call_out("hit_11", 5, me, target);

  return 1;
}
void hit_1(object invoker, object target) {
  string msg;

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$n被这刀光吓呆了，以至于忘记了自己在战斗中了。\n\n" NOR;
  invoker->add("mana", -50);
  message_vision(msg, invoker, target);
  target->start_busy(3 + random(3));
}
void hit_2(object invoker, object target) {
  string msg;

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$N趁着刀光闪烁，试图找出$n的破绽。\n\n" NOR;
  invoker->add("mana", -50);
  message_vision(msg, invoker, target);
  target->start_busy(1);
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
}
void hit_3(object invoker, object target) {
  string msg;

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$n被这刀光吓呆了，以至于忘记了自己在战斗中了。\n" NOR;
  msg += HIC "$N趁着刀光闪烁，找出了$n的破绽。\n\n" NOR;
  message_vision(msg, invoker, target);
  target->start_busy(3 + random(3));
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
}
void hit_4(object invoker, object target) {
  string msg;
  int damage;
  damage = random(invoker->query("force_factor"));

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$N的刀光直接攻击到了$n，结果$n被打得伤势不轻。\n\n" NOR;
  message_vision(msg, invoker, target);
  invoker->add("force", -50);
  target->receive_damage("kee", damage * 2 / 3, invoker);
  target->receive_wound("kee", damage / 4, invoker);
  COMBAT_D->report_status(target);
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
}
void hit_5(object invoker, object target) {
  string msg;
  int damage;
  damage = random(invoker->query("force_factor"));

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$N的刀光直接攻击到了$n，结果$n被打得伤势不轻。\n" NOR;
  msg += HIC "显然有些站不住了。\n\n" NOR;
  message_vision(msg, invoker, target);
  invoker->add("force", -50);
  target->start_busy(2 + random(2));
  target->receive_damage("kee", damage * 2 / 3, invoker);
  target->receive_wound("kee", damage / 4, invoker);
  COMBAT_D->report_status(target);
}
void hit_6(object invoker, object target) {
  string msg;
  int damage;
  damage = random(invoker->query("force_factor"));

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$N的刀光直接攻击到了$n，结果$n被打得伤势不轻。\n" NOR;
  msg += HIC "接着倒在地上了。\n\n" NOR;
  invoker->add("mana", -50);
  invoker->add("force", -80);
  message_vision(msg, invoker, target);
  target->start_busy(3 + random(3));
  target->receive_damage("kee", damage * 2 / 3, invoker);
  target->receive_wound("kee", damage / 4, invoker);
  COMBAT_D->report_status(target);
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
}
void hit_7(object invoker, object target) {
  string msg;
  int hitorno = 7;

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIC "$N的刀光绕了个大圈，把$n包围起来了。\n" NOR;
  msg += HIC "$n是动也动不得，逃也逃不开，甚是难受。\n" NOR;
  invoker->add("mana", -100);
  message_vision(msg, invoker, target);
  target->start_busy(5 + random(3));
  COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));

  if ((int)invoker->query_skill("yange-blade", 1) > 350
    && random(hitorno) > 5) {
    msg += HIC "就在这个时候$N手持武器直插向$n的要害。\n\n" NOR;
    invoker->add("mana", -50);
    invoker->add("force", -50);
    message_vision(msg, invoker, target);
    call_out("add_hit", 3, invoker, target);
  }
}
void add_hit(object invoker, object target) {
  string msg;
  int mexp, texp, damage;

  if (!invoker || !target) return;

  if (!target->is_fighting(invoker)) return;

  if (environment(invoker) != environment(target)) return;

  mexp = (int)invoker->query("combat_exp");
  texp = (int)target->query("combat_exp");
  damage = random(invoker->query("force_factor") * 2);
  if (random(mexp) > random(texp)) {
    msg = HIC "$n尝试跳出半月刀锋来躲闪这可怕的攻击，可是怎么也没找出破绽。\n" NOR;
    invoker->add("mana", -80);
    invoker->add("force", -100);
    message_vision(msg, invoker, target);
    target->receive_damage("kee", damage, invoker);
    target->receive_damage("sen", damage, invoker);
    target->receive_wound("kee", damage / 4, invoker);
    target->receive_wound("sen", damage / 4, invoker);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
    COMBAT_D->do_attack(invoker, target, invoker->query_temp("weapon"));
  } else {
    msg = HIC "$n眼看不敌，猛然转身，竟然把刀弹开了。\n" NOR;
    message_vision(msg, invoker, target);
  }
}
void wandao_busy(object me) {
  if (!me) return;
  me->delete_temp("banyue_wandao");
}
