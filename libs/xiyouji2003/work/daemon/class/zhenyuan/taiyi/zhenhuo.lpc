// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type)
{
        int success_adj, damage_adj;

        success_adj = 160;
        damage_adj = 80;

        SPELL2_D->attacking_cast(
                        me,
                        target,
                        success_adj,
                        damage_adj,
                        "both",
                        HIC "$N"HIC"几个指头迅速捻动，突然张嘴一喷！红橙黄三道火焰呼！地一声向$n"HIC"卷去！\n"NOR,
                        HIR "结果$n"HIR"被烧得焦头烂额！\n" NOR,
                        HIY "但是$n"HIY"轻轻一跳就躲了开来。\n" NOR,
                        HIG "但是火焰被$n"HIG"以法力一逼，反向$N"HIG"回卷而去！\n" NOR,
                        HIR "结果太乙真火反噬，$n"HIR"被烧得焦头烂额！\n" NOR,
                        type);
}

int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( !target
        ||  !target->is_character()
        ||  target->is_corpse()
        ||  target==me)
                return notify_fail("你要对谁喷太乙真火？\n");

        if((int)me->query_skill("taiyi", 1) < 50 )
                return notify_fail("你的太乙仙法火候不够，哪里喷得出真火！\n");

        if((int)me->query("mana") < 25+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够，喷出的真火恐怕没有什么用！\n");

        if((int)me->query("force") < 100 )
                return notify_fail("你的内力不够，无法将真火喷出。\n");

        if((int)me->query("sen") < 10 )
                return notify_fail("你现在神智不清，别把自己烧伤了！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->add("force", -100);
        me->receive_damage("sen", 10);

        if( random(me->query("max_mana")) < 50 ) {
                write("这一次好像不灵。\n");
                return 1;
        }

        do_cast(me, target);

        me->start_busy(1+random(2));
        return 3+random(5);
}
