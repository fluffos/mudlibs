//三星下凡　by jack 06/25/2002

#include <ansi.h>

inherit SSERVER;
void say_1(object invoker, object target, string npc, object where);
void say_2(object invoker, object target, string npc, object where);
void level_1(object invoker, object target, string npc, object where);
void level_2(object invoker, object target, string npc, object where);
void level_3(object invoker, object target, string npc, object where);
void fu_attack(object invoker, object target, string npc, object where);
void lu_attack(object invoker, object target, string npc, object where);
void shou_attack(object invoker, object target, string npc, object where);

int cast(object me, object target) {
  string msg;
  object where;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想化成三星打谁？\n");

  if ((int)me->query_skill("taiyi", 1) < 180)
    return notify_fail("你的太乙仙法修为不深，化成三个人比较困难。\n");

  if ((int)me->query_skill("sanqing-jian", 1) < 180)
    return notify_fail("你的三清剑修为不深，化成三个人比较困难。\n");

  if ((int)me->query_skill("xiaofeng-sword", 1) < 180)
    return notify_fail("你的晓风残月剑修为不深，化成三个人比较困难。\n");

  if ((int)me->query_skill("yange-blade", 1) < 180)
    return notify_fail("你的雁歌刀修为不深，化成三个人比较困难。\n");

  if ((int)me->query("mana") < (int)me->query_skill(
    "taiyi",
    1
  ) + (int)me->query("mana_factor") + (int)me->query("force_factor"))
    return notify_fail("你的法力不够，没办法变化三星。\n");

  if (!target->is_fighting(me))
    return notify_fail("只有在战斗中才能变化三星！\n");
  if ((int)me->query("sen") < 10)
    return notify_fail("你现在精神不振，知道自己是谁就不错了！\n");

  me->add(
    "mana",
    -(int)me->query_skill(
      "taiyi",
      1
    ) - (int)me->query("mana_factor") - (int)me->query("force_factor")
  );
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("咦？这一次好像不灵。\n");
    return 1;
  }
  msg = HIC "$N喃喃几句道：海上三星，快快分身下凡！\n" NOR;
  where = environment(target);
  message_vision(msg, me, target);
  if ((int)me->query_skill("taiyi", 1) >= 180
    || (int)me->query_skill("taiyi", 1) < 300) {
    call_out("say_1", 1 + random(3), me, target, where);
  } else if ((int)me->query_skill("taiyi", 1) >= 300
    || (int)me->query_skill("taiyi", 1) < 400) {
    call_out("say_1", 1 + random(2), me, target, where);
  } else if ((int)me->query_skill("taiyi", 1) >= 400) {
    call_out("say_1", 1, me, target, where);
  } else {
    call_out("say_1", 4, me, target, where);
  }

  if ((int)me->query_skill("taiyi", 1) >= 180
    || (int)me->query_skill("taiyi", 1) < 300) {
    me->start_busy(1 + random(2));
  } else if ((int)me->query_skill("taiyi", 1) >= 300
    || (int)me->query_skill("taiyi", 1) < 400) {
    me->start_busy(2 + random(2));
  } else if ((int)me->query_skill("taiyi", 1) >= 400) {
    me->start_busy(2 + random(3));
  } else {
    me->start_busy(random(2));
  }
  return 13 + random(3);
}
void say_1(object invoker, object target, string npc, object where) {
  string msg;

  if (!invoker || !target) return;

  if (environment(invoker) != environment(target)) return;

  msg = HIY "恍惚之间，$N身后闪过几道金光！只听四周一阵鹤鸣却不见任何人。\n\n" NOR;
  msg += HIC "$n大笑道：无耻小儿，敢吓唬我！看我怎么教训你！\n\n" NOR;
  message_vision(msg, invoker, target);
  if ((int)invoker->query_skill("taiyi", 1) >= 180
    && (int)invoker->query_skill("taiyi", 1) < 230) {
    call_out("level_1", 3 + random(3), invoker, target, where);
  } else if ((int)invoker->query_skill("taiyi", 1) >= 230
    && (int)invoker->query_skill("taiyi", 1) < 280) {
    call_out("level_1", 3 + random(2), invoker, target, where);
  } else if ((int)invoker->query_skill("taiyi", 1) >= 280
    && (int)invoker->query_skill("taiyi", 1) < 330) {
    call_out("level_2", 2 + random(2), invoker, target, where);
  } else if ((int)invoker->query_skill("taiyi", 1) >= 330
    && (int)invoker->query_skill("taiyi", 1) < 380) {
    call_out("level_2", 1 + random(2), invoker, target, where);
  } else if ((int)invoker->query_skill("taiyi", 1) >= 380) {
    call_out("level_3", random(2), invoker, target, where);
  } else {
    call_out("say_2", 0, invoker, target, where);
  }


}
void say_2(object invoker, object target, string npc, object where) {
  write(HIW "你的发出的金光出去以后就再也没回来，看样子没变化成三星的样子。\n" NOR);

}

void level_1(object invoker, object target, string npc, object where) {
  string msg;
  string npc_dir = "/d/penglai/npc/";
  int sb;

  msg = HIC "正在这时，$N身后的半空闪现一道金光！\n\n" NOR;
  message_vision(msg, invoker, target);

  target->kill_ob(invoker);
  where = environment(target);
  sb = random(3);
  if (sb == 0) {
    call_out("fu_attack", 3, invoker, target, npc_dir + "fuxing", where);
  } else if (sb == 1) {
    call_out("lu_attack", 3, invoker, target, npc_dir + "luxing", where);
  } else if (sb == 2) {
    call_out("shou_attack", 3, invoker, target, npc_dir + "shouxing", where);
  }


}

void level_2(object invoker, object target, string npc, object where) {
  string msg;
  string npc_dir = "/d/penglai/npc/";
  int sb;

  msg = HIC "正在这时，$N身后的半空闪现两道金光！\n\n" NOR;
  message_vision(msg, invoker, target);

  target->kill_ob(invoker);

  where = environment(target);
  sb = random(3);
  if (sb == 0) {
    call_out("fu_attack", 2, invoker, target, npc_dir + "fuxing", where);
    call_out("lu_attack", 4, invoker, target, npc_dir + "luxing", where);
  } else if (sb == 1) {
    call_out("lu_attack", 2, invoker, target, npc_dir + "luxing", where);
    call_out("shou_attack", 4, invoker, target, npc_dir + "shouxing", where);
  } else if (sb == 2) {
    call_out("fu_attack", 2, invoker, target, npc_dir + "fuxing", where);
    call_out("shou_attack", 4, invoker, target, npc_dir + "shouxing", where);
  }

}
void level_3(object invoker, object target, string npc, object where) {
  string msg;
  string npc_dir = "/d/penglai/npc/";
  int sb;
  msg = HIY "		～正在这时，$N身后的半空三道金光齐闪！～\n\n" NOR;
  message_vision(msg, invoker, target);

  target->kill_ob(invoker);

  where = environment(target);
  sb = random(6);
  if (sb == 0) {
    call_out("fu_attack", 2, invoker, target, npc_dir + "fuxing", where);
    call_out("lu_attack", 4, invoker, target, npc_dir + "luxing", where);
    call_out("shou_attack", 6, invoker, target, npc_dir + "shouxing", where);
  } else if (sb == 1) {
    call_out("fu_attack", 2, invoker, target, npc_dir + "fuxing", where);
    call_out("shou_attack", 4, invoker, target, npc_dir + "shouxing", where);
    call_out("lu_attack", 6, invoker, target, npc_dir + "luxing", where);
  } else if (sb == 2) {
    call_out("lu_attack", 2, invoker, target, npc_dir + "luxing", where);
    call_out("shou_attack", 4, invoker, target, npc_dir + "shouxing", where);
    call_out("fu_attack", 6, invoker, target, npc_dir + "fuxing", where);
  } else if (sb == 3) {
    call_out("lu_attack", 2, invoker, target, npc_dir + "luxing", where);
    call_out("fu_attack", 4, invoker, target, npc_dir + "fuxing", where);
    call_out("shou_attack", 6, invoker, target, npc_dir + "shouxing", where);
  } else if (sb == 4) {
    call_out("shou_attack", 2, invoker, target, npc_dir + "shouxing", where);
    call_out("fu_attack", 4, invoker, target, npc_dir + "fuxing", where);
    call_out("lu_attack", 6, invoker, target, npc_dir + "luxing", where);
  } else if (sb == 5) {
    call_out("shou_attack", 2, invoker, target, npc_dir + "shouxing", where);
    call_out("lu_attack", 4, invoker, target, npc_dir + "luxing", where);
    call_out("fu_attack", 6, invoker, target, npc_dir + "fuxing", where);
  }

}

void fu_attack(object invoker, object target, string npc, object where) {
  object attacker;
  int rd;
  string tid;

  if (!invoker || !target) return;

  if (environment(invoker) != environment(target)) return;
  if (environment(target) != where) return;

  seteuid(getuid());
  attacker = new(npc);
  attacker->move(environment(invoker));
  attacker->invocation(invoker);
  tid = (string)target->query("id");
  rd = random(2);
  if (rd == 0) {
    attacker->command_function("perform damoyange on " + tid);
  } else {
    attacker->command_function("cast zhenhuo on " + tid);
  }

  destruct(attacker);
}
void lu_attack(object invoker, object target, string npc, object where) {
  object attacker;
  int rd;
  string tid;

  if (!invoker || !target) return;

  if (environment(invoker) != environment(target)) return;
  if (environment(target) != where) return;

  seteuid(getuid());
  attacker = new(npc);
  attacker->move(environment(invoker));
  attacker->invocation(invoker);
  tid = (string)target->query("id");
  rd = random(2);
  if (rd == 0) {
    attacker->command_function("perform tiandi on " + tid);
  } else {
    attacker->command_function("cast zhenhuo on " + tid);
  }

  destruct(attacker);
}
void shou_attack(object invoker, object target, string npc, object where) {
  object attacker;
  int rd;
  string tid;

  if (!invoker || !target) return;

  if (environment(invoker) != environment(target)) return;
  if (environment(target) != where) return;

  seteuid(getuid());
  attacker = new(npc);
  attacker->move(environment(invoker));
  attacker->invocation(invoker);
  tid = (string)target->query("id");
  rd = random(2);
  if (rd == 0) {
    attacker->command_function("perform tongshou on " + tid);
  } else {
    attacker->command_function("cast zhenhuo on " + tid);
  }

  destruct(attacker);
}
