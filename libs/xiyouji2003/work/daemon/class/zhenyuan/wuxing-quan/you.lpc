//Last modified by waiwai@2001/04/01

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int skl_me, skl_you, extra_me, extra_you,i;
	int FLAG=0;
	object you,ob,*obs;

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［乾坤柔虹］只能对战斗中的对手使用。\n");

	if((int)me->query("combat_exp", 1) < 500000)
        	return notify_fail(HIC"你的武学不够，不能使用这一招！\n"NOR);

        if((int)me->query("force") < 400 )
                return notify_fail(HIC"你的内力不够！\n"NOR);

      if (me->query_skill_mapped("force")!="zhenyuan-force")
                return notify_fail(HIC"五行锤必须配合镇元神功才能使用。\n"NOR);

      if (me->query_skill_mapped("spells")!="taiyi")
                return notify_fail(HIC"五行锤必须配合太乙仙法才能使用。\n"NOR);

	if(pointerp(obs=me->query_team()) )
	{
	FLAG=1;
	for(i=0;i<sizeof(obs);i++)
	{
	if(obs[i] == me) continue;
	if(!obs[i]) {FLAG=0;continue;}
	if(environment(obs[i]) != environment(me)) {FLAG=0;continue;}
	if(!obs[i]->query_skill("wuxing-quan")) {FLAG=0;continue;}
	if(objectp(ob=obs[i]->query_temp("weapon"))) {FLAG=0;continue;}
	if(obs[i]->query_skill_mapped("unarmed") != "wuxing-quan") {FLAG=0;continue;}
	}	
	if(sizeof(obs) !=2) FLAG=0;
	}
	skl_me=(int)me->query_skill("unarmed");
	extra_me=(int)me->query_temp("apply/damage")+(int)me->query_str()*(int)me->query_str()/10;
	if(FLAG)
	{
		if(obs[0]==me) me=obs[1]; else me=obs[0];
	skl_you=(int)me->query_skill("unarmed");
	extra_you=(int)me->query_temp("apply/damage")+(int)me->query_str()*(int)me->query_str();
	msg = HIG"$N施展出五行拳神技 "HIR"［乾坤柔虹］"HIG" 无数身影夹杂着炽热的拳影，击向$n"HIG"的全身！\n\n"NOR;
	me->add_temp("apply/attack",(skl_you+skl_me)/5);
	me->add_temp("apply/damage",(extra_you+extra_me));
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	me->add_temp("apply/attack",-(skl_you+skl_me)/5);
        me->add_temp("apply/damage",-(extra_you+extra_me));
	me->kill_ob(target);
	}
	else
	{
	msg = HIG"$N施展出无行拳神技 "HIR"［乾坤柔虹］"HIG" 无数身影夹杂着炽热的拳影，击向$n"HIG"的全身！\n\n"NOR;
        me->add_temp("apply/attack",skl_me/10);
        me->add_temp("apply/damage",extra_me/3);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        me->add_temp("apply/attack",-skl_me/10);
        me->add_temp("apply/damage",-extra_me/3);
	}	
	me->start_busy(3);
	return 1;
}
