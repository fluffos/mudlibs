#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(HIW "你只能在战斗中使用。\n" NOR);

  if (me->is_busy())
    return notify_fail(HIC "你现在正忙着！！\n" NOR);

  if ((int)me->query("combat_exp", 1) < 500000)
    return notify_fail(HIC "你的武学不够，不能使用这一招！\n" NOR);

  if ((int)me->query("force") < 400)
    return notify_fail(HIC "你的内力不够！\n" NOR);

  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail(HIC "五行锤必须配合镇元神功才能使用。\n" NOR);

  if (me->query_skill_mapped("spells") != "taiyi")
    return notify_fail(HIC "五行锤必须配合太乙仙法才能使用。\n" NOR);

  if ((int)me->query("kee") < 300)
    return notify_fail(HIC "你的气血不足，没法子施用外功！\n" NOR);

  if ((int)me->query_skill("wuxing-quan", 1) < 100)
    return notify_fail(HIC "你的五行拳级别不够！\n" NOR);

  me->delete("env/brief_message");

  message_vision(HIY "\n$N一声怒吼双拳犹如两把大锤，凭空砸出！！！ \n" NOR, me);
  target->start_busy(random(2));


  me->set_temp("chui_per", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set_temp("chui_per", 8);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("chui_per");

  //	me->receive_damage("kee", 50);
  me->add("force", -100);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(2 + random(2));
  return 1;
}
