// 「天地同寿」之「同寿」
// by jack 06/25/2002
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  if (!target) target = offensive_target(me);


  if (userp(me)) return notify_fail("你所使用的外功中没有这种功能。\n");


  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「天地同寿」？\n");

  if ((int)me->query("force") < 25 + (int)me->query("force_factor"))
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query_skill("xiaofeng-sword", 1) < 100)
    return notify_fail("你的晓风残月剑法级别还不够！\n");


  me->add("force", -25 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);

  if (random(me->query("max_force")) < 50) {
    write("你忽然觉得一阵隐忧，结果没有使出「天地同寿」！\n");
    return 1;
  }


  COMBAT_D->attacking_perform(
    me,
    //attacker 
    target,
    //target
    (int)me->query_skill("xiaofeng-sword", 1),
    //level of skill used
    100,
    //success adjustment
    100,
    //damage adjustment
    "qi",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIW "\n$N清啸一声：使出了一招「天地同寿」之「同寿」！\n\n" NOR
    HIC "$N手中的青虹剑中宫直进，剑尖不住颤动，\n
剑到中途，忽然转而向上，乃是「天地同寿」的第二招「同寿」!\n
是若有若无，变幻无方。\n\n" NOR,
    //initial message
    HIC "结果剑气由下而上贯穿于$N全身冲向$n，对着$n当胸刺入，顿时鲜血喷涌！\n" NOR,
    //success message
    HIC "但是$n高高跃起躲开了$N的攻势。\n" NOR,
    //fail message
    HIC "但是被$n看破顶住剑尖，用内力反弹，剑气折回打了$N一个措手不及！\n\n" NOR,
    //backfire initial message
    HIC "结果轰的一声巨响！由于内功反嗜$n反而受了不轻的内伤！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(3);
  return 5;
}
