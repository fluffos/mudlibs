// Update by waiwai@2003/04/25

#include <ansi.h>
inherit SSERVER;

varargs void do_cast(object me, object target, int type) {
  int success_adj, damage_adj;

  success_adj = 80;
  damage_adj = 160;

  SPELL2_D->attacking_cast(
    me,
    target,
    success_adj,
    damage_adj,
    "both",
    HIC "$N口中念了几句咒文，随着一声“后羿在此！”半空中现出一位身披虎皮的大汉"
    "。\n只见他张弓搭箭，“嗖”的一声，一只蓝汪汪的长箭向$n" HIC "激射而下！\n" NOR,
    HIR "结果长箭从$n" HIR "身上透体而过，顿时血花飞溅！\n" NOR,
    HIC "只见$n" HIC "轻轻一跳，长箭正好插在$n" HIC "脚边，兀自颤动不休！\n" NOR,
    HIG "但是$n" HIG "以法力一拨，长箭“嗖”的一声折向$N" HIG "！\n" NOR,
    HIR "结果长箭从$n" HIR "身上透体而过，顿时血花飞溅！\n" NOR,
    type);
}

int cast(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展落日神箭？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你无法集中精力瞄准！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("后羿正跟老婆赌气，来不了了！\n");
    return 1;
  }

  do_cast(me, target);
  me->start_busy(1 + random(2));

  return 3 + random(5);
}
