// Created by waiwai@2001/02/20
// 守护精灵.该精灵会一直保护玩家,直到玩家死亡或者离线.

#include <ansi.h>

inherit SSERVER;
int do_execration(object me,object target,int i);
int do_hit(object me,object target,int skill);
int set_elf_skill(object me,object elf,int skill);

int cast(object me, object target)
{

	int  skill,skill2;
	string msg;
	skill=me->query_skill("divinemagic",1);
	skill2=me->query_skill("magic",1);

//	if(!wizardp(me) && userp(me)) {
	if( me->query("id") != "xiaom" && !wizardp(me)) { // 临时测试
	if(skill>=200)
		return notify_fail("你强大的魔法力量足以保护自己的生命,不再需要精灵们守护了.\n");

	if(skill2<=150)
		return notify_fail("你的基本魔法太低了,不能召唤守护精灵.\n");

         if( uptime()-me->query_temp("last_elf_time")<1800)
            return notify_fail(WHT"你召唤精灵的时间间隔必须大于30分钟。\n"NOR);

        me->set_temp("last_elf_time",uptime());

	if((int)me->query("mana") < 100 )
		return notify_fail("你的法力不够！\n");

	if((int)me->query("sen") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");

	me->add("mana", -100);
	me->receive_damage("sen", 50);
       }

	if(me->query_temp("execration"))
		return notify_fail("你正在念咒。\n");

	if(objectp(me->query_temp("cast_elf"))) return notify_fail(WHT"迷雾岛的精灵已经被你召唤出来了\n"NOR);

	msg = ""+me->name()+"自言自语不知道在说些什麽。\n";
        message("vision",msg, environment(me), ({me}));
//	tell_object(me,WHT"\n你在脑海回忆起守护圣灵的魔法咒语,低声吟诵着......\n\n"NOR);
	message_vision(WHT"\n$N在脑海回忆起守护圣灵的魔法咒语,低声吟诵着......\n\n"NOR,me);

	me->set_temp("execration",1);
	call_out("do_execration",1,me,target,1);
	return 1;
}


int do_execration(object me,object target,int i)
{
	string msg;
	int skill;
	switch(i) {
		case 1:
	   	 	msg=HIB"\t\t迷雾岛的精灵\n"NOR;
	    		break;
		case 2:
	    		msg=HIB"\t\t聆听我的请求\n"NOR;
	    		break;
        	case 3:
            		msg=HIB"\t\t请您遵守远古的盟约\n"NOR;
            		break;
		case 4:
			msg=HIB"\t\t守护你的主人\n\n"NOR;
		default: 
			break;
	}
//	tell_object(me,msg);
	message_vision(msg,me);

        i++;
    	if(i<5 &&i >=0) call_out("do_execration",1,me,target,i);
	else  {
  	    	skill=me->query_skill("divinemagic",1);
        	if(!skill) return 1;
            	call_out("do_hit",1,me,target,skill);
	    	return 1;
    	}
	return 1;
}

int do_hit(object me,object target,int skill)
{
	string msg;
	object elf,room;
	if(!objectp(me)) return 1;
	me->delete_temp("execration");
	
	if(random(100)<1) {
		msg=HIR"$N"HIR"的守护圣灵失败了...\n"NOR;	
		message_vision(msg,me);
		return 1;
	} else {
		msg=HIG"$N"HIG"将守护圣灵咒语吟诵完毕,一只生物出现在$N"HIG"身边......\n"NOR;
		message_vision(msg,me);
		if(me->is_fighting())
			me->start_busy(me->query_busy()+3);
		elf=new("/u/waiwai/npc/elf");
		if(!elf) {
			tell_object(me,WHT"精灵文件不存在,请通知巫师!!!\n"NOR);
			return 1;
		}
		if( me ) {
		elf->set("owner",me);
		elf->set_temp("protect", me->query("id"));
		me->set_temp("cast_elf",elf);
		me->delete_temp("execration");
		room=environment(me);
		elf->move(room);
		elf->set_leader(me);
//		elf->set("owner", me->query("id"));
		elf->invocation(me);
		set_elf_skill(me,elf,skill);
		}
	}
	return 1;
}

int set_elf_skill(object me,object elf,int skill)
{
	elf->set_skill("unarmed",skill);
	elf->set_skill("parry",skill);
	elf->set_skill("dodge",skill);
	//By waiwai@2001/07/20 added.
	if( me) {
	elf->set("max_force",me->query("max_force"));
	elf->set("force",me->query("force"));
	elf->set("max_mana",me->query("max_mana"));
	elf->set("mana",me->query("mana"));
	}
	elf->set("food",1000);
	elf->set("water",1000);

	elf->set_temp("apply/armor",60+random(40));
	elf->set_temp("apply/damage",30+random(70));
	elf->set("combat_exp",skill*10000>1000000?skill*10000:1000000);
}
