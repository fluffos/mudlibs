//Created by waiwai@2001/05/14
//职业系统之武士专用

#include <ansi.h>

inherit SSERVER;

void end_cast(object me,object target);

void cast_person(object me,object target);

int cast(object me, object target)
{
        string msg;
        int howlong;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展忍者武士？\n");

       if (userp(me) && !wizardp(me) ) {
       if( (string)me->query("occupation") != "fighter" )
              return notify_fail("只有武士才能使用这个功能。\n");

	if( me->query_temp("cast_renzhe"))
	        return notify_fail("你已经在使用忍者武士！\n");     
	if((int)me->query_skill("force", 1) < 450)
            	return notify_fail("内力过低你无法使用这项功能！\n");

        if((int)me->query("force") < 1500 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("mana") < 1500 )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("kee") < 500 )
                return notify_fail("你的气血不足了！\n");
        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足了！\n");

        me->add("force", -1500);
        me->add("mana", -1500);
        me->receive_damage("kee", 100);
        me->receive_damage("sen", 100);
          }

        if( random(me->query("max_force")) < 500 ) {
                write("你失败了！\n");
                return 1;
        }
        
	msg = HIW
	"\n$N口中念着咒文："NOR WHT"\n
\t\t比黄昏更加昏暗,比鲜血更加鲜红
\t\t时光虽然流逝,忍者的精神犹存
\t\t记住你的名字,我在黑暗中发誓
\t\t阻碍在我面前所有愚蠢的物体
\t\t凭着我武士的力量,必至灭亡\n
"HIG"籍着忍者的精神和武士的力量 ～～～～～\n\n"HIB"只见空中金云陡起，并迅速弥漫开来，将$N的身形隐去。\n"
	NOR;
	message_vision(msg,me,target);
	me->set("env/invisibility", 1);
	howlong=me->query_skill("force")/2;
	if(howlong>60)howlong=60;
	me->set_temp("cast_renzhe",1);
         cast_person(me,target);
	call_out("end_cast",howlong,me,target);
//    environment(me)->set("oldlong",environment(me)->query("long"));
//  environment(me)->set("long", environment(me)->query("oldlong")+"\n半空中弥漫着一团云雾，一切景色都很模糊。\n\n");
	
       if( !target->is_fighting(me) ) {
       if( living(target) ) {
             if( userp(target) ) target->fight_ob(me);
             else
		target->kill_ob(me);
             }
                me->kill_ob(target);
        }

	
        me->start_busy(2+random(1));
        return 3+random(5);
}

void cast_person(object me,object target)
{
  int ap,dp,damage;
  string msg,str;

  if(!target||environment(target) != environment(me)||!me->is_fighting(target)){
  	remove_call_out("cast_person");
  	remove_call_out("end_cast");
  	end_cast(me,target);
  	return;
  }
if (target)     target->delete_temp("no_move");
  if(random(2)){
    msg = HIB
         "\n朦胧中只见无数身影在$n"HIB"的周围,无形中忽幻忽灭地攻向$n"HIB"～～～～～\n"NOR;
/*
    ap = me->query_skill("force");
    ap = ( ap * ap * ap / (2 * 400) ) * (int)me->query("kee");
    ap += (int)me->query("combat_exp");
    dp = target->query("combat_exp");
    if( random(ap + dp) > dp ) {
*/
    if( random(me->query("combat_exp")) >  (int)target->query("combat_exp")/3 ) {

       damage = (int)me->query("max_force") / 2 +
           random((int)me->query("eff_kee") / 5);
       damage -= (int)target->query("max_force") / 3 +
           random((int)target->query("eff_kee") / 5);                   
       damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
//here we can see if 2 players are at same status, the attacker has higher chance.
       if( damage > 0 ) {
           msg +=  HIR "\n$n"HIR"被无形的对手扰的气血翻涌，差点跌倒在地！\n" NOR;
          target->set_temp("no_move",1);
          //finally damage also depends on enabled spells level.
           damage +=random((damage*(int)me->query_skill("force"))/40);
                        target->receive_damage("kee", damage/3, me);
                        target->receive_wound("kee", damage/3, me);
         }else msg += HIC"\n谁知$n"HIC"识破了$N的身行，$N遁形失败。\n"NOR;
    }else msg += HIC"\n谁知$n"HIC"识破了$N的身行，$N遁形失败。\n"NOR;     
    message_vision(msg, me, target);
  }else {
     msg = HIY
     "\n迷雾中刀光剑影,忽的闪出一道金光射向$n \n" NOR;
/*
     ap = me->query_skill("force");
     ap = ( ap * ap * ap / (2 * 400) ) * (int)me->query("kee");
     ap += (int)me->query("combat_exp");
     dp = target->query("combat_exp");
     if( random(ap + dp) > dp ) {
*/
    if( random(me->query("combat_exp")) >  (int)target->query("combat_exp")/3 ) {
         damage = (int)me->query("max_force") / 2 +
            random((int)me->query("eff_kee") / 5);
         damage -= (int)target->query("max_force") / 3 +
	    random((int)target->query("eff_kee") / 5);                   
         damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
         //here we can see if 2 players are at same status, the attacker has higher chance.
         if( damage > 0 ) {
            msg +=  HIR "\n结果「嗤」地一声，金光从$n身上透体而过，鲜血直射到两三丈外的地下！\n" NOR;
             target->set_temp("no_move",1);
            //finally damage also depends on enabled spells level.
            damage +=random((damage*(int)me->query_skill("force"))/30);
            target->receive_damage("kee", damage/2, me);
            target->receive_wound("kee", damage/2, me);
          }else msg += HIC"\n但是被$n"HIC"躲开了。\n"NOR;
      }
      else msg += HIC"\n但是被$n"HIC"躲开了。\n"NOR;
      message_vision(msg, me, target);
  }
  call_out("cast_person",5,me,target);    

      if (userp(target)){//By waiwai@2001/05/12 避免杀死npc刷屏
          if (target->query("eff_kee")<0 || !living(target))  {
          str=target->name()+HIW"被"HIY+me->name()+HIW"用一式"HIB"「忍者武士」"HIW"射穿经脉，暴毙而死！！！";
	        message("channel:rumor",HIR"【市井传言】"HIW"据说"HIG+str+"\n"NOR,users());
        }
      }
}

void end_cast(object me,object target)
{
    string msg;
    	
    msg = HIC"\n朦胧的云雾渐渐消散了，露出了$N的身影。\n" NOR;
    message_vision(msg,me);
    me->set("env/invisibility", 0);
if (target)     target->delete_temp("no_move");
//    if(environment(me)->query("oldlong"))
//       environment(me)->set("long",environment(me)->query("oldlong"));
    me->delete_temp("cast_renzhe");
    remove_call_out("cast_person");	
}
