// self.c 小周天运转
// Update by waiwai@2003/04/12

#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIC "小周天运转" NOR; }

int perform(object me, string skill)
{
        int count;

        if (me->query("sen") < 80)
                return notify_fail("你的精气不够，现在还不能施展小周天运转。\n");

        if (me->is_fighting())
                return notify_fail("你正在打架，无法使用小周天运转。\n");

        if (me->query("kee") >= me->query("eff_kee"))
                return notify_fail("你的体力很好，没有必要使用小周天运转。\n");

	if( !wizardp(me) && userp(me) ){
	if( uptime()-me->query_temp("last_self_helf")<30)
            return notify_fail(WHT"频繁使用小周天运转会使气血淤积的。\n"NOR);

	}

        message_vision(HIC "$N" HIC "双手平举，深深吐出了一"
                       "口气，脸色变得圆润多了。\n" NOR, me);
        tell_object(me, HIG "你感觉到你的气力恢复了。\n" NOR);
        switch (me->query("national"))
        {
        case "毒辣":
        case "暴躁":
        case "阴险":
        case "狡诈":
        case "蛮横":
        count = me->query_con() * 4;
                break;

        case "多疑":
        case "呆滞":
        case "怯弱":
        case "孤僻":
        case "龌龊":
        case "邋遢":
        case "迟钝":
        case "懦弱":
        case "柔顺":
        count = me->query_con() * 5;
                break;

        case "爽朗":
        case "开朗":
        count = me->query_con() * 8;
                break;

        case "聪颖":
        case "活泼":
        case "伶俐":
        case "机灵":
        case "聪慧":
        count = me->query_con() * 10;
                break;

        case "刚烈":
        case "疯癫":
        case "倔强":
        count = me->query_con() * 6;
                break;
        }

        me->set_temp("last_self_helf",uptime());
        me->receive_damage("sen", 60 + random(20));
        me->receive_heal("kee", count);
        me->start_busy(1 + random(5));
        return 1;
}
