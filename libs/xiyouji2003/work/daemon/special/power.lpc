#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIY "天神降世" NOR; }

int perform(object me, string skill)
{
        int count;

        if (me->query("kee") < 80)
                return notify_fail("你的体力不支，无法迅猛提升自己的战斗力。\n");

        if (me->query_temp("special_skill/power", 1))
                return notify_fail("你已经尽力提升自己的战斗力了。\n");
	else
        message_vision(HIY "$N" HIY "双臂一伸一缩，膝部微弯，"
                       "作势欲扑。\n" NOR, me);

        switch (me->query("national"))
        {
        case "毒辣":
        case "暴躁":
        case "阴险":
        case "狡诈":
        case "蛮横":
                count = 35;
                break;

        case "多疑":
        case "呆滞":
        case "怯弱":
        case "孤僻":
        case "龌龊":
        case "邋遢":
        case "迟钝":
        case "懦弱":
        case "柔顺":
                count = 30;
                break;

        case "爽朗":
        case "开朗":
                count = 40;
                break;

        case "聪颖":
        case "活泼":
        case "伶俐":
        case "机灵":
        case "聪慧":
                count = 50;
                break;

        case "刚烈":
        case "疯癫":
        case "倔强":
                count = 45;
                break;
        }

        count += me->query_str();

        me->receive_damage("kee", 40 + random(40));
        me->set_temp("special_skill/power", 1);
        me->add_temp("apply/attack", count);
   	me->start_call_out((: call_other, __FILE__, "remove_effect", me,
			      count :), 60 + random(30));

        return 1;
}

void remove_effect(object me, int count)
{
        me->delete_temp("special_skill/power", 1);
        me->add_temp("apply/attack", -count);
        tell_object(me, HIG"你施展完天神降世，松了一口气。。。\n"NOR);
}
