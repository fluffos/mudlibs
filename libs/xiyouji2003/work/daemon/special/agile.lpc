// agile.c 如鬼似魅
// Created by Doing Lu 10/7/2K
// Update by waiwai@2002/12/05

#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIC "如鬼似魅" NOR; }

int perform(object me, string skill) {
  int count;

  if (me->query("kee") < 80)
    return notify_fail("你的体力不支，无法竭力提升自己的速度。\n");

  if (me->query_temp("special_skill/agile", 1))
    return notify_fail("你已经竭力提升你自己的速度了。\n");
  else
    message_vision(HIC "$N" HIC "脚尖一点，踢起一些尘"
      "土，整个人顿时如同纸鹞一般飘飘忽忽。\n" NOR, me);

  // Added by waiwai@2002/12/05
  switch (me->query("national")) {
    case "毒辣":
    case "暴躁":
    case "阴险":
    case "狡诈":
    case "蛮横":
      count = 42;
      break;

    case "多疑":
    case "呆滞":
    case "怯弱":
    case "孤僻":
    case "龌龊":
    case "邋遢":
    case "迟钝":
    case "懦弱":
    case "柔顺":
      count = 30;
      break;

    case "爽朗":
    case "开朗":
      count = 38;
      break;

    case "聪颖":
    case "活泼":
    case "伶俐":
    case "机灵":
    case "聪慧":
      count = 48;
      break;

    case "刚烈":
    case "疯癫":
    case "倔强":
      count = 40;
      break;
  }

  count += me->query_spi();


  me->receive_damage("kee", 40 + random(40));
  me->set_temp("special_skill/agile", 1);
  me->add_temp("apply/dodge", count);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    count :), 60 + random(30));

  return 1;
}

void remove_effect(object me, int count) {
  me->delete_temp("special_skill/agile");
  me->add_temp("apply/dodge", -count);
  tell_object(me, HIG "你的如鬼似魅施展完毕，身形一顿，杀气均数卸除。。。\n" NOR);
}
