#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIR "杀气腾腾" NOR; }

int perform(object me, string skill)
{
        int count;

        if (me->query("kee") < 80)
                return notify_fail("你的体力不支，无法蓄势提升自己的伤害力。\n");

        if (me->query_temp("special_skill/hatred", 1))
                return notify_fail("你现在已经是杀气腾腾了。\n");
	else
        message_vision(HIR "$N" HIR "眼中精光闪过，冷冷的扫过"
                       "四周，一股寒意凛然而起。\n" NOR, me);

        switch (me->query("national"))
        {
        case "毒辣":
        case "暴躁":
        case "阴险":
        case "狡诈":
        case "蛮横":
                count = 48;
                break;

        case "多疑":
        case "呆滞":
        case "怯弱":
        case "孤僻":
        case "龌龊":
        case "邋遢":
        case "迟钝":
        case "懦弱":
        case "柔顺":
                count = 30;
                break;

        case "爽朗":
        case "开朗":
                count = 38;
                break;

        case "聪颖":
        case "活泼":
        case "伶俐":
        case "机灵":
        case "聪慧":
                count = 45;
                break;

        case "刚烈":
        case "疯癫":
        case "倔强":
                count = 40;
                break;
        }
        count += me->query_cps();

        me->set_temp("special_skill/hatred", 1);
        me->receive_damage("kee", 40 + random(40));
        me->add_temp("apply/damage", count);
        me->add_temp("apply/unarmed_damage", count);
   	me->start_call_out((: call_other, __FILE__, "remove_effect", me,
			      count :), 60 + random(30));

        return 1;
}

void remove_effect(object me, int count)
{
        me->delete_temp("special_skill/hatred");
        me->add_temp("apply/damage", -count);
        me->add_temp("apply/unarmed_damage", -count);
        tell_object(me, HIG"你精神一松懈，杀气荡然无存。。。\n"NOR);
}
