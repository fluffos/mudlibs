inherit NPC;

void create()
{
	set_name("红嘴相思雀", ({ "miss bird" }) );
	set("race", "妖魔" );
	set("age", 1);
	set("long", "咭咭喳喳的一只小相思雀。\n");
	set("per", 30);
	set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("chat_chance", 3);
	set("chat_msg", ({
//		(: random_move :),
		"咭咭...\n",
		"喳喳...\n",
	}));
	set("arrive_msg","蹦蹦跳跳地蹦了过来");
	set("leave_msg","蹦蹦跳跳地跑开了");
	set_temp("apply/dodge", 100);
	set_temp("apply/attack", 10);
	set_temp("apply/armor", 3);
	set_temp("no_return", 1);

	setup();
}
