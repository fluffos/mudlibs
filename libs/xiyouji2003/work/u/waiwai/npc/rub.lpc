#include <allnpc.h>

int hanyan();

void create()
{
        set_name("老人",({"rubbish_man","man"}));
        set("str",100);
        set("combat_exp",500000);
        set("per",30);
        set("age",73);
        set("long",CYN"
这位老人坐在夕阳之下的小院里，眯着眼睛，沉重而迷恋地回想着
他的一生就象那条流淌着的河流，当生命之水即将流到尽头的时候
一切的一切都成为过眼烟云......\n\n"NOR);

        set("chat_chance", 3);
        set("chat_msg", ({
		(: hanyan  :),
        }) );

	set("zombie",1);
	set("no_blade", 1); // 不怕冰刀
	set("no_poison", 1); // 不怕用毒

	setup();               
       carry_object(WAI_NPC"obj/duangua2")->wear();
       carry_object(WAI_NPC"obj/hanyan");
}

int hanyan()
{
	command("wield hanyan qiang");
	command("dosmoke hanyan");
	command("unwield qiang");
	return 1;
} 

int accept_fight (object ob) { return 0; } 

void unconcious() { die(); }
