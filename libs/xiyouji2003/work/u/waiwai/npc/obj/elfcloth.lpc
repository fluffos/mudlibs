#include <armor.h>

inherit CLOTH;

void create() {
  set_name("绿色小布衣", ({ "cloth" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("value", 300);
    set("no_sell", 1);
    set("no_break", 1);
    set("no_give", 1);
    set("npc_only", 1);
  }
  setup();
}
