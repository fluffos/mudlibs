#include <armor.h>

inherit CLOTH;

void create() {
  set_name(CYN "褴褛的短褂" NOR, ({ "poor cloth", "poor", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件穿在路人身上的短褂，可惜被闪电击中后变的褴褛不堪。\n");
    set("unit", "件");
    set("value", 100000);
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 1);
    set("armor/max_armor", 1);
  }
  set("is_monitored", 1);

  setup();
}
