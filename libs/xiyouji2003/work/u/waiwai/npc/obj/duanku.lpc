#include <armor.h>

inherit PANTS;

void create()
{
        set_name(CYN"褴褛的短裤"NOR, ({ "poor pants", "pants", "poor" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一件穿在路人身上的短裤，可惜被闪电击中后变的褴褛不堪。\n");
              set("unit", "条");
              set("value", 1);
              set("material", "cloth");
              set("Fmaterial", "silk");
              set("armor_prop/armor", 1);
              set("armor/max_armor", 1);
              set("drop_to", 1); // 死亡时自动掉出标志
        }
	set("is_monitored",1);
       setup();
}

