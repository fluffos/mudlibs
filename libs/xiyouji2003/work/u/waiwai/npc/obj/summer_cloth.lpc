#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(WHT"短袖凉衫"NOR, ({ "summer cloth", "summer", "cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一件一般穿在夏季的短袖凉衫，薄布制的上面勾着丝边。\n");
		set("unit", "件");
		set("value", 1000);
		set("npc_only", 1);
		set("material", "cloth");
		set("Fmaterial", "silk");
		set("armor_prop/armor", 1);
		set("armor/max_armor", 1);
        }
	set("is_monitored",1);

	setup();
}

