#include <weapon.h>
inherit STICK;

string *names = ({
	WHT"神鼠蒲扇"NOR,
	WHT"蛮牛蒲扇"NOR,
	WHT"雷虎蒲扇"NOR,
	WHT"玉兔蒲扇"NOR,
	WHT"青龙蒲扇"NOR,
	WHT"蟒蛇蒲扇"NOR,
	WHT"骏马蒲扇"NOR,
	WHT"火羊蒲扇"NOR,
	WHT"石猴蒲扇"NOR,
	WHT"金鸡蒲扇"NOR,
	WHT"天狗蒲扇"NOR,
	WHT"花猪蒲扇"NOR,
});

string *ids = ({
	"rat pushan",
	"ox pushan",
	"tiger pushan",
	"rabbit pushan",
	"dragon pushan",
	"snake pushan",
	"house pushan",
	"sheep pushan",
	"monkey pushan",
	"cock pushan",
	"dog pushan",
	"pig pushan"
});

void create()
{
	int i = random(sizeof(names));
	set_name(names[i], ({ ids[i], "pushan", "shan"}));
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一把画着十二生肖图案的竹制蒲扇，还有着很好看的丝绸裙边。\n");
		set("material", "bamboo");
		set("Fmaterial", "silk");
		set("unit", "把");
              set("value", 1000);
              set("npc_only", 1);
	}
	init_stick(2);

	set("wield_msg", "$N拿起蒲扇扇了两下。。。。\n");
	set("unwield_msg", "$N把手中的蒲扇轻轻地放下了。。。。\n");
	set("is_monitored",1);

	setup();
}

