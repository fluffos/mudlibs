//#define SEACH_D		"/adm/daemons/seachd.lpc"
#define LOCATION_D		"/adm/daemons/locationd.lpc"

#include <ansi.h>
#include <command.h>
inherit NPC;
int give_quest();

void create()
{
        set_name("钟馗", ({"zhong kui", "zhongkui", "kui"}));
        set("title", WHT"鬼见愁"NOR);
        set("gender", "男性" );
        set("age", 30);
        set("str", 999);
        set("per", 112); 
        set("long", "无人不知的抓鬼大仙，你碰上他准是你干了什么坏事。\n");
        set("class", "taoist");
        set("combat_exp", 9000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 999);
        set_skill("dodge", 999);
        set_skill("parry", 999);
        set_skill("blade", 999);
        set_skill("force", 250);   
        set_skill("literate", 999);
        set_skill("spells", 999);
        set("max_kee", 10000);
        set("max_sen", 10000);
        set("force", 10000);
        set("max_force", 10000);
        set("mana", 10000);
        set("max_mana", 10000);   
        set("force_factor", 500);
        set("mana_factor", 500);
        set("inquiry", ([
		"抓鬼"	:	(: give_quest :),
	]));  
      
	 // Added By waiwai@2001/06/28
        set("no_give", 1);
        set("no_kill", 1);
	set("no_blade", 1);//不怕冰刀
	set("no_poison", 1);//不怕用毒

        setup();
        carry_object("/d/lingtai/obj/xiangpao")->wear();

}

int give_quest()
{
	object who, seal;
	mapping room;
	
	who=this_player();

    if ( !wizardp(who) ) {
	if((time()-who->query("catch_ghost/last_time"))<600) {
//		command("say 现在还算比较太平，你先去歇了吧。");
		message_vision("$N对$n说道：现在还算比较太平，你先去歇了吧。\n",this_object(), who);
		return 1;
	}
      }

	seal=new("/obj/seal");

	if( !seal->move(who)) {
		command("say 你身上的东西过多，装不下东西了。");
		return 1;
        }

	seal->set("master", who);
	reset_eval_cost();

       do{ room=LOCATION_D->random_location(); } while(!strlen(room["long"]));
	seal->set("file_name", room["file"]);
	seal->set("desc", room["long"]);
	seal->move(who);
	who->set("catch_ghost/last_time", time());
	command("nod");
	message_vision("$N对$n说道：这张符给你，你看看符上写的符号去抓鬼吧。\n",this_object(), who);
       CHANNEL_D->do_channel(who, "sys","得到了抓鬼符(/obj/seal.c). \n"NOR);	
	if( !wizardp(who) )	who->start_busy(2);

	return 1;
}

//Modified By waiwai@2001/06/28
int accept_object(object who, object ob)
{
	int reward, times;
	string msg;
	object sj;
	
	if(!ob->query("finished") || who!=ob->query("master")) return 0;
	command("nod");
	message_vision("$N对$n说道：很好！\n", this_object(), who);
	times=who->query_temp("catch_ghost");
	reward=2000+random(500)*times+500*times;
	msg="被奖励了";
	switch(random(10)) {
		case 0:
			who->add("combat_exp", reward/2);
			who->add("catch_ghost/cache/wuxue", reward/2);
			msg+=chinese_number(reward/2)+"点武学。\n";
			break;
		case 1:
			who->add("office_number", 1);
			msg+="一点官职。\n";
			break;
		case 2:
			who->add("office_number", 2);
			msg+="两点官职。\n";
			break;
		case 3:
			who->add("office_number", 3);
			msg+="三点官职。\n";
			break;
		case 4:
			who->add("office_number", 4);
			msg+="四点官职。\n";
			break;
		case 5:
			who->add("office_number", 5);
			msg+="五点官职。\n";
			break;
		case 6:
			who->add("office_number", 6);
			msg+="六点官职。\n";
			break;
		case 7:
			who->add("office_number", 8);
			msg+="八点官职。\n";
			break;
		case 8:
			who->add("office_number", 10);
			msg+="十点官职。\n";
			break;
		default:
			who->add("potential", reward/4);
			who->add("catch_ghost/cache/pot", reward/4);
			msg+=chinese_number(reward/4)+"点潜能。\n";
	}

	who->add_temp("catch_ghost", 1);
	if(who->query_temp("catch_ghost")>9)
	who->set_temp("catch_ghost", 0);

	who->add_temp("ghostgift", 1);

//        MONITOR_D->report_system_object_msg(who, "[抓鬼]"+msg);
       tell_object(who, "你"+msg);
	message("system",WHT"┋符伐恶鬼┋ "+log_id(who)+"[抓鬼]"+msg+" \n"NOR,users()); 

        log_file("player/zhuagui_log","["+log_time()+"] "+log_id(who)+"抓鬼"+msg);

	if(who->query_temp("ghostgift")>10+random(10)) {
	who->set_temp("ghostgift", 0);
	sj = new("/d/tianpeng/dong/obj/lanshuijing");
	sj->move(who);
	message("system",WHT"┋符伐恶鬼┋ "+log_id(who)+"[抓鬼]被额外奖励了一枚"HIB"蓝水晶\n"NOR,users());    
	}

        return 1;
}
