#include <ansi.h>
inherit NPC;

void create() {
  set_name("小女孩", ({ "rain kidgirl", "kidgirl", "wantong", "girl" }));
  set("gender", "女性");
  set("age", 8);
  set("per", 20 + random(5));
  set("title", "雨中嬉戏");
  set("nickname", "顽童");
  set("long", "一个喜欢在雨中与小伙伴嬉戏玩耍的小顽童。\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "小女孩快乐地嬉戏着，追逐着～～～\n",
    "小女孩高声喊着：喂：别跑～～～\n",
    "小女孩愉快地追逐着，我会抓住你的～～～\n",
    (: random_move :)
  }));
  set("arrive_msg", "追逐着跑了过来。。。");
  set("leave_msg", "追逐着跑开不见了。。。");
  set("no_blade", 1);  //不怕冰刀
  set("no_poison", 1);  //不怕用毒

  setup();
  carry_object("/obj/self/yuhua-stone");
  carry_object("/obj/self/summer-rain");
  carry_object("/d/city/obj/xiuhuaxie")->wear();
  carry_object("/d/obj/cloth/pink_cloth")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    if (!ob->query_temp("leader"))
      command("follow rain kid");
  }
}

int heal_up() {
  if (environment() && !is_fighting()) {
    remove_call_out("leave");
    call_out("leave", 300);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    name() + "说道：妈妈喊我了，回家吃饭罗～～～ \n" NOR, environment(), this_object());
  destruct(this_object());
}
