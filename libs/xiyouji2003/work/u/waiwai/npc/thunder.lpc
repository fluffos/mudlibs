// Created by waiwai@2001/03/23

#include <allnpc.h>
int give_tear(object ob);
int ask_give(object ob);

void create() {
  set_name("路人", ({ "thunder man", "man", "thunder" }));
  set("gender", "男性");
  set("age", 28);
  set("per", 10 + random(5));
  set("title", "被闪电击中的");
  set("long", "一位不幸被闪电击中了的路人。\n");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "被闪电击中的路人晕晕忽忽地晃了下脑袋。\n",
    "被闪电击中的路人有点不知东南西北了。\n",
    (: random_move :)
  }));

  set("inquiry", ([
    "闪电": (: give_tear :),
    "shandian": (: give_tear :),
    "短褂": (: ask_give :),
  ]));

  set("arrive_msg", "摇摇晃晃地走了过来。。。");
  set("leave_msg", "摇摇晃晃地走开了。。。");

  // 带有这个标志表明死亡时直接变为血水
  // 配合duanku的drop_to属性使玩家不能
  // 杀了其拿到短褂，杀了只能得到短裤
  set("zombie", 1);
  set("money_need", 30);
  set("no_blade", 1);  //不怕冰刀
  set("no_poison", 1);  //不怕用毒

  setup();
  carry_object(WAI_ROOM "npc/obj/duangua")->wear();
  carry_object(WAI_ROOM "npc/obj/duanku")->wear();
}

int give_tear(object ob) {
  object tear;
  object me = this_object();
  ob = this_player();

  tear = new("/obj/self/tear-rain");

  if (present("tear rain", ob)) {
    command("heng " + ob->query("id"));
    message_vision(CYN "$N对$n说道：上次取笑我还不够吗？真乃落井下石之人。\n" NOR, me, ob);
    command("slap " + ob->query("id"));
    message_vision(WHT "\n$N头也不回地跑了。。。\n" NOR, me);
    destruct(me);
    return 1;
  } else
    message_vision(CYN "$N听到此言不禁伤心的哭了起来。。。\n", me, ob);
  message_vision("泪水从$N被闪电击过的焦黑的脸上流了下来。。。\n", me, ob);
  message_vision(CYN "\n$N顺势一伸手竟然接住了一滴" + tear->name() + CYN "。\n" NOR, ob);
  tear->move(ob);
  command("sigh");
  message_vision(WHT "\n$N踉跄地跑开不见了。。。\n" NOR, me);
  destruct(me);

  return 1;
}

int ask_give(object ob) {
  object tear;
  object me = this_object();
  ob = this_player();

  if (me->query_temp("give_cloth") > 0) {  //只给一次
    message_vision(CYN "$N对$n说道：很抱歉我已经卖掉了！那买家可是个好人啊！\n" NOR, me, ob);
    command("hehe " + ob->query("id"));
    return 1;
  } else
    command("grin");
  message_vision(WHT "\n$N说道：哈哈，给 " HIR + query("money_need") + NOR WHT " 两黄金就成交。。。\n" NOR, me);

  return 1;
}

int accept_object(object me, object obj) {
  object ob;
  ob = this_object();

  if (present("poor cloth", me)) {  // 如果身上有就不再给
    message_vision(CYN "$N对$n说道：不是给过你了吗？难道还要在下把短裤也脱掉给你不成？\n" NOR, ob, me);
    command("heng " + me->query("id"));
    return 0;
  }

  if ((int)obj->value() >= 300000) {
    command("smile");
    command("remove poor cloth");
    message_vision("$N将褴褛的短褂递给了$n。\n", this_object(), me);
    command("thank " + me->query("id"));
    new(WAI_ROOM "npc/obj/duangua")->move(me);
    this_object()->add_temp("give_cloth", 1);
    return 1;
  }

  if (!obj->value() && !obj->query("value")) return 0;

  command("smile");

  message_vision("$N向$n哈哈大笑道：头一次见到象您这么大方的！\n", this_object(), me);
  command("grin");
  return 1;
}
void unconcious() { die(); }
