#include <ansi.h>
#include <dbase.h>
#include <login.h>

//#define ELF_DIR DATA_DIR+"npc/elf/"
inherit NPC;
inherit F_SAVE;
//inherit NPC_SAVE;
string query_save_file();
void copy_status(object me, object ob);

string *dir = ({
  "north",
  "south",
  "west",
  "east",
});

mapping sx_name = ([
  "jin": HIY "金精灵" NOR,
  "mu": HIG "木精灵" NOR,
  "shui": HIC "水精灵" NOR,
  "huo": HIR "火精灵" NOR,
  "tu": YEL "土精灵" NOR,
]);

void create() {
  set_name("魂魄精灵", ({ "hunpo elf", "elf" }));
  set("gender", "男性");
  set("age", 30);
  set("str", 30);
  set("per", 20);
  set("combat_exp", 1000);
  set("daoxing", 1000);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set_skill("moshenbu", 10);
  map_skill("dodge", "moshenbu");

  setup();
}

// 复制真身所有参数
void copy_status(object me, object ob) {
  object *inv;
  mapping skill_status, map_status;
  string *sname, *mname, owner_save;
  int i;
  string mana_sx;

  /*****************************************************************************************/
  switch (ob->query_skill_mapped("spells")) {
    case "buddhism":
      mana_sx = "tu";
      break;
    case "dao":
      mana_sx = "mu";
      break;
    case "moonshentong":
      mana_sx = "shui";
      break;
    case "seashentong":
      mana_sx = "shui";
      break;
    case "gouhunshu":
      mana_sx = "shui";
      break;
    case "yaofa":
      mana_sx = "tu";
      break;
    case "pingtian-dafa":
      mana_sx = "huo";
      break;
    case "dengxian-dafa":
      mana_sx = "mu";
      break;
    case "taiyi":
      mana_sx = "huo";
      break;
    case "taoism":
      mana_sx = "jin";
      break;
    case "baguazhou":
      mana_sx = "mu";
      break;
    case "pansi-dafa":
      mana_sx = "tu";
      break;
    case "feisheng-spells":
      mana_sx = "jin";
      break;
    case "fumozhou":
      mana_sx = "jin";
      break;
    case "yufeng-shu":
      mana_sx = "huo";
      break;
    case "xuanhu-shentong":
      mana_sx = "jin";
      break;
  }
  /*****************************************************************************************/
  set_name(ob->query("name") + "的精灵", ({ ob->query("id") + "'s elf", "elf" }));
  me->set("title", ob->query("title"));
  me->set("family/family_name", ob->query("family/family_name"));
  me->set("12_sx", ob->query("12_sx"));
  me->set("12_xz", ob->query("12_xz"));
  me->set("national", ob->query("national"));
  me->set("changed", ob->query("changed"));
  me->set("occupation", ob->query("occupation"));
  me->set("zhongzu", ob->query("zhongzu"));
  me->set("impurity", ob->query("impurity"));
  me->set("birthday", ob->query("birthday"));
  me->set("couple/name", ob->query("couple/name"));
  me->set("married", ob->query("married"));
  me->set("balance", ob->query("balance"));
  me->set("age", ob->query("age"));
  me->set("gender", ob->query("gender"));
  me->set("office_number", ob->query("office_number"));
  me->set("degree", ob->query("degree"));
  me->set("soilder", ob->query("soilder"));
  me->set("max_zhongcheng", ob->query("max_zhongcheng"));
  me->set("zhongcheng", ob->query("zhongcheng"));
  me->set("BHPJ", ob->query("BHPJ"));
  me->set("killbyname", ob->query("killbyname"));
  me->set("killbycity", ob->query("killbycity"));
  me->set("killbytime", ob->query("killbytime"));
  me->set("killbyid", ob->query("killbyid"));
  me->set("kill/nkgain", ob->query("kill/nkgain"));
  me->set("mpzc", ob->query("mpzc"));
  me->set("MP_killM", ob->query("MP_killM"));
  me->set("ZY", ob->query("ZY"));
  me->set("mpzc", ob->query("mpzc"));
  me->set("shengwang", ob->query("shengwang"));
  me->set("max_douzhi", ob->query("max_douzhi"));
  me->set("douzhi", ob->query("douzhi"));
  me->set("dietimes", ob->query("dietimes"));
  me->set("normal_die", ob->query("normal_die"));
  me->set("PKS", ob->query("PKS"));
  me->set("PKS1", ob->query("PKS1"));
  me->set("MKS", ob->query("MKS"));
  me->set("mud_age", ob->query("mud_age"));
  me->set("special_skill", ob->query("special_skill"));

  //	if( (string)ob->query("banghui") ) {
  me->set("banghui", (string)ob->query("banghui"));

  //	if( (string)ob->query("bh_rank") )
  me->set("bh_rank", (string)ob->query("bh_rank"));
  //	else
  //	me->set("bh_rank","帮众");
  //	}
  if (mana_sx)
    me->set("nickname", sx_name[mana_sx]);
  else
    me->set("nickname", ob->query("12_xz"));
  /*****************************************************************************************/

  skill_status = me->query_skills();
  sname = keys(skill_status);
  for (i = 0; i < sizeof(skill_status); i++) {
    me->delete_skill(sname[i]);
  }
  skill_status = ob->query_skills();
  if (skill_status) {  // 不判断是不行的
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      me->set_skill(sname[i], skill_status[sname[i]]);
    }
    if (mapp(map_status = me->query_skill_map())) {
      mname = keys(map_status);

      for (i = 0; i < sizeof(map_status); i++) {
        me->map_skill(mname[i]);
      }
    }

    map_status = ob->query_skill_map();
    if (map_status) {  // 不判断是不行的
      mname = keys(map_status);

      for (i = 0; i < sizeof(map_status); i++) {
        me->map_skill(mname[i], map_status[mname[i]]);
      }
    }
  }
  inv = all_inventory(ob);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("weapon_prop")
      && inv[i]->query("equipped")) {
      carry_object(base_name(inv[i]))->wield();
      me->set("weapon", base_name(inv[i]));
    } else if (inv[i]->query("armor_prop")
      && inv[i]->query("equipped")) {
      carry_object(base_name(inv[i]))->wear();
      me->set("armor", base_name(inv[i]));
    }
  }

  /*****************************************************************************************/
  me->set("str", ob->query("str"));
  me->set("int", ob->query("int"));
  me->set("con", ob->query("con"));
  me->set("per", ob->query("per"));
  me->set("cor", ob->query("cor"));
  me->set("spi", ob->query("spi"));
  me->set("cps", ob->query("cps"));
  me->set("kar", ob->query("kar"));

  me->set("max_kee", ob->query("max_kee"));
  me->set("eff_kee", ob->query("eff_kee"));
  me->set("kee", ob->query("kee"));

  me->set("max_gin", ob->query("max_gin"));
  me->set("eff_gin", ob->query("eff_gin"));
  me->set("gin", ob->query("gin"));

  me->set("max_sen", ob->query("max_sen"));
  me->set("eff_sen", ob->query("eff_sen"));
  me->set("sen", ob->query("sen"));

  me->set("max_force", ob->query("max_force"));
  me->set("force", ob->query("force"));
  me->set("force_factor", ob->query("force_factor"));

  me->set("max_mana", ob->query("max_mana"));
  me->set("mana", ob->query("mana"));
  me->set("mana_factor", ob->query("mana_factor"));

  me->set("combat_exp", ob->query("combat_exp"));
  me->set("daoxing", ob->query("daoxing"));
  me->set("food", me->max_food_capacity() * 2);
  me->set("water", me->max_water_capacity() * 2);
  me->set("owner", (string)ob->query("id"));

  me->set("no_blade", 1);  // 不怕冰刀
  me->set("no_poison", 1);  // 不怕用毒
  //	me->set("no_clean_up", 1); // 不会被reset掉
  me->set("allow_heal_up", 1);
  //	me->set("zombie",1); // 也许多余
  //	me->set("no_return",1); // reset时不能return_home
  me->set("no_get", 1);  // 做这个标记吧
  me->set("lead_to", 3);  // 可跟随带领
  me->set("startroom", base_name(environment(me)));  // 可跟随带领

  owner_save = query("owner");

  me->set("owner_save", owner_save);

  save();
}

void init() {
  object owner_ob, ob, area;
  string owner, banghui;
  area = new("/obj/area");
  area->create(query("area_name"));
  set("banghui", (string)area->query("banghui"));
  destruct(area);

  ::init();
  owner = query("owner");

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
    //                remove_call_out("leave");
    //                call_out("leave", 1, ob);
  }
}

// 不是同帮会的就Kill
void greeting(object ob) {
  string banghui, owner;
  object lp, owner_ob, where;
  owner = query("owner");
  where = environment(this_object());

  if (!ob || environment(ob) != environment()) return;
  if (ob->query("env/invisibility")) return;
  if (objectp(owner_ob = find_player(owner))) {
    owner_ob->clear_condition("makestart");
    owner_ob->delete("hunpo");
    //	owner_ob->delete("Sroom");
    owner_ob->set("startroom", "/d/city/kezhan");
    owner_ob->add("hunpo_ELF", 1);
    owner_ob->save();
    owner_ob->start_busy(2);

    message("vision",
      "\n" + WHT + name() + "(" + query("id") + ") 的身子一晃，变成一股青烟不见了。。。\n" NOR,
      environment(), this_object());
    tell_object(owner_ob, HIW "\n尚驻留在这个世界的你的魂魄精灵已经与你的真身合二为一了。。。\n" NOR);
    message("channel:sys",
      HIG "┋魂魄精灵┋" + name() + "(" + query("id") + ")与其" HIR "真身" NOR HIG "在" +
      MISC_D->find_place(where) + COLOR_D->clean_color(where->query("short")) + "(" + file_name(where) + ".c)合体了。。。\n" NOR, users());

    destruct(this_object());
  }
  /*
	banghui=(string)ob->query("banghui");
	lp=new("/obj/lingpai");
	lp->create(banghui);
       set("banghui",(string)lp->query("banghui"));
	destruct(lp);

	if( (!banghui || query("banghui")!=banghui) && ob->query("id") != owner) {
		command("say 竟敢私闯私属帮会地盘，我看你是不想活了！\n");
		command("guard "+dir[random(sizeof(dir))]); // 随机把守封死出口
		kill_ob(ob);
		ob->fight_ob(this_object());
		return;
	}
*/
}

// 死亡
void die() {
  string owner;
  object owner_ob;
  owner = query("owner");
  if (objectp(owner_ob = find_player(owner))) {
    tell_object(owner_ob, "你的魂魄精灵被人杀死了，你觉得一阵天旋地转....\n");
    owner_ob->move("/obj/void");
    owner_ob->unconcious();
  }
  message("vision",
    "\n" + WHT + name() + "身子一晃，变成一股青烟散去了。\n" NOR, environment(), this_object());
  destruct(this_object());
}

// 搜寻真身
int heal_up() {
  string owner;
  object owner_ob;
  object me = this_object();
  owner = query("owner");

  if (objectp(owner_ob = find_player(owner)))
    remove_call_out("leave");
  call_out("leave", 1, owner_ob);
  return ::heal_up();
}

// 合体
void leave() {
  string owner;
  object owner_ob, where;
  object me = this_object();
  owner = query("owner");
  where = environment(me);

  if (me) {
    if (objectp(owner_ob = find_player(owner))) {
      owner_ob->clear_condition("makestart");
      owner_ob->delete("hunpo");
      //	owner_ob->delete("Sroom");
      owner_ob->set("startroom", "/d/city/kezhan");
      owner_ob->add("hunpo_ELF", 1);
      owner_ob->save();
      owner_ob->start_busy(2);

      message("vision",
        "\n" + WHT + name() + "(" + query("id") + ") 的身子一晃，变成一股青烟不见了。。。\n" NOR,
        environment(), me);
      tell_object(owner_ob, HIW "\n尚驻留在这个世界的你的魂魄精灵已经与你的真身合二为一了。。。\n" NOR);
      message("channel:sys",
        HIG "┋魂魄精灵┋" + name() + "(" + query("id") + ")与其" HIR "真身" NOR HIG "在" +
        MISC_D->find_place(where) + COLOR_D->clean_color(where->query("short")) + "(" + file_name(where) + ".c)合体了。。。\n" NOR, users());

      destruct(this_object());
    }
  }
  return;
}

// 设置真身识别
void invocation(object who) {
  object me = this_object();
  copy_status(me, who);
  set("owner", who->query("id"));
  set("owner_ob", who);
}

// 不接受比划
int accept_fight(object ob) { return 0; }

// 如果杀就有一定机率中精灵之舞
void kill_ob(object ob) {
  object me = this_object();

  if (random(20) == 1)
    ob->apply_condition("hart", 100);

  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

// 直接死亡，不然麻烦太多
void unconcious() { die(); }
