// Last modified by waiwai@2001/04/24

#include <allnpc.h>

void create() {
  set_name(HIR "碧儿" NOR, ({ "daphne" }));
  set("nickname", HIW "冰清玉洁" NOR);
  set("title", HIW "水晶女神" NOR);
  set("gender", "女性");
  set("age", 23);
  set("per", 40);
  set("long", CYN "\n
一个带着面纱看不清面貌的神秘女子,传说她已经活了数千年的岁月,
而且从没有人见过她的真面目,在面纱之下的面孔究竟是如何呢？这
是许多人所好奇的,是天使？还是魔鬼？不知何故,在多年前她来到
这里,并就此定居了下来,她的善心是全城的人所共知的,不论你有什
么病痛,只要来找她" HIR "(saveme)" NOR CYN "她就会帮你医治,要记得多多利用喔！！\n\n" NOR);

  set("chat_chance", 4);
  set("chat_msg", ({
    GRN "水晶女神--碧儿闭上眼睛冥思．\n" NOR,
    GRN "水晶女神--碧儿说道:沉睡在时空中的神秘力量....\n" NOR,
    GRN "水晶女神--碧儿说道:现在藉着最美丽的水晶女神的能力....\n" NOR,
    GRN "水晶女神--碧儿说道:给予所有黑暗,愚蠢的一切...平等地毁灭吧...\n" NOR,
  }));
  set("no_blade", 1);  //不怕冰刀
  set("no_poison", 1);  //不怕用毒
  set("no_kill", 1);
  set("limit_fight", 1);

  setup();
  carry_object(WAI_NPC "obj/ring")->wear();
  carry_object("/obj/self/gift/kelsang")->wear();
}

void init() { add_action("do_save_me", "saveme"); }

// Update By waiwai@2001/04/24
int do_save_me(object ob, object lei, string arg) {
  ob = this_player();
  lei = new(DOBJ "misc/leizhu");

  if (!wizardp(ob)) {
    if (uptime() - ob->query_temp("last_jd_time") < 300)
      return notify_fail(WHT "你恢复的间隔时间必须大于5分钟。\n" NOR);

    if (!ob->query_condition())
      return notify_fail(WHT "你没事瞎恢复的什么？小心受惩罚！！！\n" NOR);

    ob->set_temp("last_jd_time", uptime());
  } else if (wizardp(ob)) {
    ob->clear_condition("no_pk_time");
    ob->clear_condition("killer");
    ob->clear_condition("ghost");
  }

  if (ob->query("age") > 16 && !wizardp(ob)) {
    if (ob->query("balance") < 50000)
      return notify_fail(HIC "你钱庄存款不足 6 GOLD,不能得到恢复。 \n" NOR);
    //          ob->add("office_number",-3);
    //          ob->add("shengwang",-3);
    ob->add("balance", -50000);
  } else if (ob->query("age") > 20 && !wizardp(ob)) {
    if (ob->query("balance") < 80000)
      return notify_fail(HIC "你钱庄存款不足 8 GOLD,不能得到恢复。 \n" NOR);
    if (ob->query("office_number") < 10)
      return notify_fail(HIC "你的官职数不足10点，不能得到恢复。 \n" NOR);
    //          ob->add("shengwang",-10);
    ob->add("office_number", -10);
    ob->add("balance", -80000);
  } else if (ob->query("age") > 30 && !wizardp(ob)) {
    if (ob->query("balance") < 120000)
      return notify_fail(HIC "你钱庄存款不足 12 GOLD,不能得到恢复。 \n" NOR);
    if (ob->query("office_number") < 20)
      return notify_fail(HIC "你的官职数不足20点，不能得到恢复。 \n" NOR);
    ob->add("office_number", -20);
    ob->add("balance", -120000);
  }

  if (ob->query_condition("ghost") && !wizardp(ob))
    return notify_fail(HIR "你作恶多端遭厉鬼报复，不能得到恢复！！！\n" NOR);

  if (ob->query_condition("killer") && !wizardp(ob))
    return notify_fail(HIR "你作恶多端正遭通缉，不能得到恢复！！！\n" NOR);

  ob->set("sen", ob->query("max_sen"));
  ob->set("kee", ob->query("max_kee"));
  ob->set("eff_kee", ob->query("max_kee"));
  ob->set("eff_sen", ob->query("max_sen"));
  ob->set("food", (int)ob->max_food_capacity());
  ob->set("water", (int)ob->max_water_capacity());
  ob->clear_condition();
  if (!wizardp(ob)) ob->start_busy(10 + random(10));
  if (ob->query("hunpo")) ob->apply_condition("makestart");

  write(HIR "碧儿" HIY "喃喃自语念道: 藉着水晶女神的力量...让这个受了伤的人回复吧！！！
" HIR "碧儿" HIY "抬起手，手上的水晶戒指发出耀眼的光芒～～～～～\n" NOR);

  tell_object(ob, WHT "\n你突然被一道光射中，顿时觉的全身充满活力。\n\n" NOR);
  tell_room(environment(),
    WHT + ob->name() + "突然被一道光射中，顿时觉的全身充满活力。\n\n" NOR, ({ ob, ob }));

  lei->move(WAI_ROOM "lottery_room");

  message("vision", HIR "碧儿" HIM "忽然一阵心痛，眼中一滴晶莹的泪珠滑落在地上……\n\n" NOR,
    environment(), this_object());

  return 1;
}
