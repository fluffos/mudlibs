#include <allnpc.h>
void do_drink();

void create()
{
	set_name("夏日纳凉人", ({ "summer man", "man", "summer"}) );
	set("gender", "男性");
	set("age", 28);
	set("per", 20+random(5));
	set("title", "谈古论今");
	set("long","一位夏日街头纳凉的人。\n");
	set("combat_exp", 5000);
	set("attitude", "friendly");
       set("chat_chance", 10);
       set("chat_msg", ({
		"纳凉人说道：今儿夏天可算是个少有的舒服季节呢。\n",
		(: do_drink :),
		"纳凉人说道：听说许多人去过暗黑城都没有回来呢。\n",
		(: do_drink :),
		"纳凉人愉快地笑着。\n",
		(: do_drink :),
		"纳凉人说道：很多人都想去金银岛淘金呢。\n",
		(: do_drink :),
		"纳凉人说道：西边野羊寨的抢匪这阵闹的可凶呢。\n",
		(: random_move :)
        }) );

	set("arrive_msg","摇着蒲扇走了过来。。。");
	set("leave_msg","摇着蒲扇走开了。。。");
	set("zombie",1);
	set("no_blade", 1);//不怕冰刀
	set("no_poison", 1);//不怕用毒

	setup();
	carry_object(WAI_NPC"obj/beer");
	carry_object(WAI_NPC"obj/pushan")->wield();
	carry_object(WAI_NPC"obj/summer_cloth")->wear();
}

void do_drink()
{
    object *list, ob;
    int i, can_drink;
    if ((int)this_object()->query("water") >= 380) return;
    list = all_inventory(this_object());
    i = sizeof(list);
    can_drink = 0;
    while (i--) {
        if ((string)list[i]->query("liquid/type") == "alcohol") {
            ob = list[i];
            can_drink = 1;
        }
    }
    if (can_drink) {
        command("drink "+(string)ob->query("id"));
        if ((int)ob->query("liquid/remaining") == 0)
            command("drop "+(string)ob->query("id"));
    } else {
        command("hehe");
        command("say 酒．．．好酒．．．");
    }
    return;
}

int heal_up()
{
        if( environment() && !is_fighting() ) {
                remove_call_out("leave");
                call_out("leave", 300);
                return 1;
        }
        return ::heal_up() + 1;
}

void leave()
{
        message("vision",
                name() +"说道：该回家了，今天聊的过瘾呢～～～ \n"NOR,environment(),  this_object() );
        destruct(this_object());
}
void unconcious() { die(); }
