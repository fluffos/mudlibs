#include <ansi.h>

inherit ROOM;

string *ids = ({});
int get_setup(object me);
void checking(object me);

void create() {
  set("short", HBBLU HIG " 往事居 " NOR);
  set("long", @LONG

这就是歪歪的往事居,满目的清新的花草充满了整个的房间。
电脑桌上的那台电脑屏幕上竟然来回回荡着一行字：

   [45;1m[1;33m Let love grow in my garden always ！！！[0m
      *      .         .                   .
    .                                      *         .         
                      *            *            .-.
        *        *         .                   (   )       
                    .                   *       '-'
  ,\//,.\//\/.         ,\/,   ,\/.//,                       
  //o\\/o//o\\ ,.,.,   //o\   /o\\o\\         *     .      
    |   |  |  /###/#\    |     |  |      .                 
    |   |  |  |' '|:|    |`=.='|  |                      
   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
       让 爱 心 在 我 的 花 园 里 永 不 凋 谢！
LONG);

  set("exits", ([
    "east": "/d/wiz/wizroom",
    "kz": "/d/city/kezhan",
  ]));

  set("objects", ([
    "/u/waiwai/obj/xiangyan": 1,
    "/u/waiwai/obj/waiwai": 1,
    "/u/waiwai/obj/yjxflower": 1,
    "/u/waiwai/obj/mianbao": 1,
    "/u/waiwai/obj/kele": 1,
  ]));

  set("fangbian_room", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("no_death", 1);
  set("no_kill", 1);
  set("no_qmdj", 1);
  set("no_book", 1);
  set("no_time", 1);
  set("chat_room", 1);
  set("wiz_only", 1);
  set("valid_startroom", 1);

  setup();
  call_other("/obj/board/waiwai_b", "???");

}

void init() {
  string wiz_status;
  object me;

  me = this_player();
  wiz_status = SECURITY_D->get_status(me);

  if (me->query("title"))
    tell_room(environment(me), HIR "主控电脑说道：请注意，" NOR + me->query("title") + HIR " "
      +me->query("name") + HIR "(" + me->query("id") + ")" + " 来了！\n" NOR);
  else
    tell_room(environment(me), HIR "主控电脑说道：请注意，"
      +me->query("name") + HIR "(" + me->query("id") + ")" + " 来了！\n" NOR);

  add_action("do_bed", "bed");

  if (wiz_status != "(admin)" && !get_setup(me)) {
    message_vision(HIC "\n$N偷偷溜了过来，忽然一股神力将$P传送到了时空的另一处。\n\n" NOR, me);
    me->move("/d/city/menwc");
  } else checking(me);

  if (wiz_status == "(admin)") {
    add_action("do_setup", "setup");
    add_action("move_setup", "move");
  }
}

int do_bed() {
  object me;
  me = this_player();

  message_vision(HIY "$N掀开纱帐，准备上床迷糊了。\n\n" NOR, me);
  me->move(__DIR__ "bed");
  message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}

void checking(object me) {
  object snooper;
  string wiz_status = SECURITY_D->get_status(me);

  if (!me || environment(me) != this_object()) return;
  else if (wiz_status != "(admin)" && !get_setup(me)) {
    message_vision(HIC "\n忽然一股神力将$N传送到了时空的另一处。\n\n" NOR, me);
    me->move("/d/city/menwc");
  } else if (objectp(snooper = query_snoop(me))) {
    message_vision(HIW "\n$N突然大叫了一声：我被$n监听了，就被传送到了时空的另一处。！\n\n" NOR, me, snooper);
    me->move("/d/city/manwc");
  } else call_out("checking", 1, me);
}

int move_setup(string arg) {
  object me, ob;
  int i;
  me = this_player();
  if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail(WHT "嘿嘿，你准备删除谁进入这里的权限？\n" NOR);
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail(WHT "你准备删除谁进入这里的权限？\n" NOR);
  if (ob == me)
    return notify_fail(WHT "你是在开玩笑吧？\n" NOR);
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == ob->query("id"))
      ids = ids - ({ ob->query("id") });

  write(WHT "你删除了" + ob->name() + "(" + ob->query("id") + ")进入这里的权限。\n" NOR);

  return 1;
}

int do_setup(string arg) {
  object me, ob;
  int i;
  me = this_player();
  if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail(WHT "嘿嘿，你准备给谁进入这里的权限？\n" NOR);
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail(WHT "你准备给谁进入这里的权限？\n" NOR);
  if (ob == me)
    return notify_fail(WHT "你是在开玩笑吧？\n" NOR);
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == ob->query("id"))
      return notify_fail(HIW "此人已经有了进入这里的权限。\n" NOR);

  ids = ids + ({ ob->query("id") });
  write(WHT "你给予了" + ob->name() + "(" + ob->query("id") + ")进入这里的权限。\n" NOR);
  tell_object(me, ob, me->name() + "(" + me->query("id") + ")给予了你进入他的工作室的权限。\n");

  return 1;
}

int get_setup(object me) {
  int i;
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == me->query("id"))
      return 1;

  return 0;
}
