// 互身符

inherit ITEM;
inherit __DIR__ "diablo";

void create() {
  set_name("护身符", ({ "amulet", "diablo amulet" }));
  set("no_give", 1);
  set("value", 100);
}

void init() {
  object me = environment(), ob;

  printf("\nenv: %O\n", me);
  printf("onwer: %O\n", query_temp("owner"));

  if (objectp(ob = query_temp("owner"))) {
    if (ob == me) return;
    disable(ob);
    delete_temp("owner");
  }

  if (!objectp(me) || !me->is_character()) return;

  if (!valid_equip(me)) return;

  set_temp("owner", me);

  enable(me);
}

void remove() {
  object ob;

  if (objectp(ob = query_temp("owner")) && environment() == ob)
    disable(ob);
}
