#include <ansi.h>
#include <diablo.h>

inherit EQUIP;
inherit __DIR__"diablo";

nosave mapping weapon_type = ([
        "axe"    : ({ "chop", "slice", "hack" }),
        "blade"  : ({ "slash", "slice", "hack", "chop" }),
        "dagger" : ({ "pierce", "thrust" }),
        "fork"   : ({ "thrust", "pierce" }),
        "hammer" : ({ "bash", "crush", "slam" }),
        "mace"   : ({ "impale", "bash", "crush", "slam" }),
        "sword"  : ({ "slash", "slice", "thrust", "pierce" }),
        "staff"  : ({ "bash", "crush", "slam", "pierce", "impale" }),
        "stick"  : ({ "bash", "crush", "slam" }),
        "whip"   : ({ "whip","wave" }),
        "spear"  : ({ "thrust", "impale", "pierce" }),
        "needle" : ({ "thrust", "pierce" }),
        "music"  : ({ "impale", "wave", "crush", "bash" })
        ]);


void create()
{
        seteuid(0);
        set_name("暗黑装备", ({ "diablo" }));
//        set("no_give", 1);
}

string long()
{
        string msg = ::long();

        if( !query("identification") ) return msg + RED "这样东西还没有鉴定。\n"NOR;

        return msg + query_desc();
}

void setup()
{
        if( query("skill_type") ) {
                set("actions", (: call_other, WEAPON_D, "query_action" :) );
                if( !undefinedp(weapon_type[query("skill_type")]) )
                        set("verbs", weapon_type[query("skill_type")]);
        }

        set_name(query("name"), ({ query("id") }) );
}

// 镶嵌
int encrust(object ob)
{
        mapping flute = ([]), diablo, fl, *flutes;

        if( !ob->can_encrust() ) return 0;

        if( (int)query("flute_number") <= sizeof(query("flute")) )
                return 0;

        flute["name"] = ob->query("name");
        flute["id"]   = ob->query("id");
        flute["diablo"] = copy(ob->query("diablo"));

        if( sizeof(query("flute")) < 1 )
                flutes = ({ flute });
        else {
                flutes = query("flute");
                flutes += ({ flute });
        }
        set("flute", flutes);

        if( mapp( diablo = query("diablo") ) && mapp( fl = ob->query("diablo") ) ) {
                string *k = keys(fl);

                foreach(string f in k) {
                        switch ( f ) {
                                case ADD_SKILL      :
                                case DEFENSE_MAGIC  :
                                case ATTACK_MAGIC   :
                                case MAGIC_ATTACK   :
                                case ADD_ATTRIBUTE  :
                                {
                                        mapping it;       

                                        if( mapp( it = fl[f] ) ) {
                                                string *its = keys(it);

                                                foreach(string itr in its)
                                                        add("diablo/" + f + "/" + itr, it[itr]);
                                        }
                                }
                                default :
                                        add("diablo/" + f, fl[f]);
                        }
                }
        }

        destruct(ob);

        return 1;
}

int wield()
{
        object me = environment();

        if( !objectp( me ) ) return 0;

        if( !valid_equip(me) )
                return notify_fail("你目前无法装备这样东西。\n");

        if( !::wield() ) return 0;

        enable(me);
        return 1;
}

int wear()
{
        object me = environment();

        if( !objectp( me ) ) return 0;

        if( !valid_equip(me) )
                return notify_fail("你目前无法装备这样东西。\n");

        if( !::wear() ) return 0;

        enable(me);
        return 1;
}

int unequip()
{
        object me = environment();

        if( !::unequip() ) return 0;

        disable(me);
        return 1;
}
