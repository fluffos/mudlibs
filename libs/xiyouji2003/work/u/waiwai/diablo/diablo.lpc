#include <ansi.h>
#include <dbase.h>
#include "diablo.h"

nosave mapping valid = ([
        "str"        : "膂力",
        "cor"        : "胆识",
        "int"        : "悟性",
        "spi"        : "灵性",
        "cps"        : "定力",
        "con"        : "根骨",
        "per"        : "容貌",
        "kar"        : "福缘",
        "combat_exp" : "道行",
        "max_mana"   : "法力",
        "max_force"  : "内力",
        "max_kee"    : "气血",
        "max_sen"    : "精神"
        ]);

void init()
{
        object ob = environment();

        if( !objectp(ob) ) return;

        if( !query_temp("owner") ) {
                if( playerp(ob) ) {
                        object box;

                        set_temp("owner", ob);
                        if( objectp( box = ob->query_temp("diablo_box") ) )
                                box->add_diablo(this_object());
                } else return;
        } else {
                object owner;

                if( !objectp(owner = query_temp("owner") ) ) return;

                if( ob != owner ) {
                        object box1, box2;

                        if( objectp( box1 = owner->query_temp("diablo_box") ) )
                                box1->delete_diablo(this_object());

                        if( objectp( box2 = ob->query_temp("diablo_box") ) )
                                box2->add_diablo(this_object());
                }
        }
}

void remove(string euid)
{
        object owner;

        if( !clonep() ) return;

        if( objectp( owner = this_object()->query_temp("owner") ) ) {
                object box;

                if( objectp( box = owner->query_temp("diablo_box") ) )
                        box->delete_diablo(this_object());
        }
}

int is_diablo() { return 1; }

int valid_equip(object me)
{
        mapping valids;

        if( !objectp(me) ) return 0;

        if( !query("identification") )
                return 0;

        if( mapp( valids = query("valid") ) ) {
                string *val;

                foreach(string v in val)
                        if( !undefinedp(valid[v]) && me->query(v) < valids[v] )
                                return 0;
        }

        return 1;
}

void enable(object me)
{
        mapping diablo;
        string  *type;

        if( !mapp( diablo = query("diablo") ) || sizeof(diablo) < 1 )
                return;

        type = keys(diablo);

        foreach(string t in type) {
                switch( t ) {
                        case ADD_SKILL :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *skill = keys(diablo[t]);

                                        foreach(string sk in skill)
                                                me->add_temp_skill(sk, diablo[t][sk]);
                                }
                                break;

                        case ADD_ALL_SKILL :
                                me->add_all_temp_skills(diablo[t]);
                                break;

                        case ADD_MANA :
                                me->add_temp_mana(diablo[t]);
                                break;

                        case ADD_FORCE :
                                me->add_temp_force(diablo[t]);
                                break;

                        case ADD_KEE :
                                me->add("max_kee", diablo[t]);
                                break;

                        case ADD_SEN :
                                me->add("max_sen", diablo[t]);
                                break;

                        case DEFENSE_MAGIC     :
                        case ATTACK_MAGIC      :
                        case MAGIC_ATTACK      :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *spells;

                                        spells = keys(diablo[t]);

                                        foreach(string s in spells) {
                                                me->add_temp("diablo/" + t + "/" + s + "/per", diablo[t][s]);
                                                if( !me->query_temp("diablo/" + t + "/" + s + "/obj") )
                                                        me->set_temp("diablo/" + t + "/" + s + "/obj", ({ this_object() }));
                                                else {
                                                        object *obj = me->query_temp("diablo/" + t + "/" + s + "/obj");

                                                        if( pointerp(obj) && sizeof(obj) > 0 ) {
                                                                obj += ({ this_object() });
                                                                me->set_temp("diablo/" + t + "/" + s + "/obj", obj);
                                                        } else me->set_temp("diablo/" + t + "/" + s + "/obj", ({ this_object() }) );
                                                }
                                        }
                                }
                                break;

                        case ADD_ATTRIBUTE :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *attr = keys(diablo[t]);

                                        foreach(string a in attr)
                                                me->add_temp("apply/" + a, diablo[t][a]);
                                }
                                break;

                        default :
                                me->add_temp("diablo/" + t, diablo[t]);
                                break;
                }
        }
}

void disable(object me)
{
        mapping diablo;
        string  *type;

        if( !mapp( diablo = query("diablo") ) || sizeof(diablo) < 1 )
                return;

        type = keys(diablo);

        foreach(string t in type) {
                switch( t ) {
                        case ADD_SKILL :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *skill = keys(diablo[t]);

                                        foreach(string sk in skill)
                                                me->add_temp_skill(sk, -diablo[t][sk]);
                                }
                                break;

                        case ADD_ALL_SKILL :
                                me->add_all_temp_skills(-diablo[t]);
                                break;

                        case ADD_MANA :
                                me->add_temp_mana(-diablo[t]);
                                break;

                        case ADD_FORCE :
                                me->add_temp_force(-diablo[t]);
                                break;

                        case ADD_KEE :
                                me->add("max_kee", -diablo[t]);
                                break;

                        case ADD_SEN :
                                me->add("max_sen", -diablo[t]);
                                break;

                        case DEFENSE_MAGIC     :
                        case ATTACK_MAGIC      :
                        case MAGIC_ATTACK      :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *spells;

                                        spells = keys(diablo[t]);

                                        foreach(string s in spells) {
                                                object *obj;

                                                me->add_temp("diablo/" + t + "/" + s + "/per", -diablo[t][s]);
                                                if( pointerp( obj = me->query_temp("diablo/" + t + "/" + s + "/obj") ) ) {
                                                        obj -= ({ this_object() });
                                                        if( sizeof(obj) < 1 ) me->delete_temp("diablo/" + t + "/" + s + "/obj");
                                                        else me->set_temp("diablo/" + t + "/" + s + "/obj", obj);
                                                }
                                        }
                                }
                                break;

                        case ADD_ATTRIBUTE :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *attr = keys(diablo[t]);

                                        foreach(string a in attr)
                                                me->add_temp("apply/" + a, -diablo[t][a]);
                                }
                                break;
                        default :
                                me->add_temp("diablo/" + t, -diablo[t]);
                                break;
                }
        }
}

string query_desc()
{
        object me = this_player();
        mapping diablo;
        string  *type, msg = "";

        if( mapp( diablo = query("valid") ) && sizeof(diablo) > 0 ) {
                string *valids = keys(diablo);

                msg += HIC "≡" HIY "──────────────────────" HIC "≡\n"
                       HIW "                    装备要求\n"
                       HIC "≡" HIY "──────────────────────" HIC "≡\n" NOR WHT;
                foreach(string v in valids) {
                        if( !undefinedp(valid[v]) ) {
                                if( me->query(v) < diablo[v] )
                                        msg += RED + "                    " + valid[v] + " " + diablo[v] +"\n";
                                else msg += HIG "                    " + valid[v] + HIG " " + diablo[v] +"\n"NOR;
                        }
                }
        }

        if( !mapp( diablo = query("diablo") ) || sizeof(diablo) < 1 ) {
                if( strlen(msg) )
                        return msg + HIC "≡" HIY "──────────────────────" HIC "≡\n" NOR;
                else return "";
        }

        msg += HIC "\n≡" HIY "──────────────────────" HIC "≡\n"
               HIW "                    物品属性\n"
               HIC "≡" HIY "──────────────────────" HIC "≡\n" NOR WHT;

        type = sort_array(keys(diablo), (: strcmp :) );

        foreach(string t in type) {
                switch( t ) {
                        case ADD_SKILL       :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *skill = keys(diablo[t]);

                                        foreach(string sk in skill)
                                                msg += "加" HIG + chinese_number(diablo[t][sk])
                                                        + NOR WHT "级" HIR +  to_chinese(sk) + "\n"NOR WHT;
                                }
                                break;

                        case ADD_ALL_SKILL   :
                                msg += "加" HIG + chinese_number(diablo[t]) + NOR WHT "全部技能\n";
                                break;

                        case ADD_MANA        :
                                msg += "加" HIG + chinese_number(diablo[t]) + NOR WHT "点最大法力\n";
                                break;

                        case ADD_FORCE       :
                                msg += "加" HIG + chinese_number(diablo[t]) + NOR WHT "点最大内力\n";
                                break;

                        case ADD_KEE         :
                                msg += "加" HIG + chinese_number(diablo[t]) + NOR WHT "点最大气血\n";
                                break;

                        case ADD_SEN         :
                                msg += "加" HIG + chinese_number(diablo[t]) + NOR WHT "点最大精神\n";
                                break;

                        case KEE_SUB_FORCE   :
                                msg += HIG + diablo[t] + "%" NOR WHT "气血伤害转化为内力的减少\n";
                                break;
                        case KEE_SUB_MANA    :
                                msg += HIG + diablo[t] + "%" NOR WHT "气血的伤害转化为法力的减少\n";
                                break;

                        case SEN_SUB_FORCE   :
                                msg += HIG + diablo[t] + "%" NOR WHT "精神的伤害转化为内力的减少\n";
                                break;

                        case SEN_SUB_MANA    :
                                msg += HIG + diablo[t] + "%" NOR WHT "精神的伤害转化为法力的减少\n";
                                break;

                        case KEE_ADD_FORCE   :
                                msg += HIG + diablo[t] + "%" NOR WHT "气血的伤害转化为内力的增加\n";
                                break;

                        case KEE_ADD_MANA    :
                                msg += HIG + diablo[t] + "%" NOR WHT "气血的伤害转化为法力的增加\n";
                                break;

                        case SEN_ADD_FORCE   :
                                msg += HIG + diablo[t] + "%" NOR WHT "精神的伤害转化为内力的增加\n";
                                break;

                        case SEN_ADD_MANA    :
                                msg += HIG + diablo[t] + "%" NOR WHT "精神的伤害转化为法力的增加\n";
                                break;

                        case DAMAGE_ADD_KEE      :
                                msg += HIG + diablo[t] + "%" NOR WHT "给对方的伤害转化为气血的增加\n";
                                break;

                        case DAMAGE_ADD_SEN      :
                                msg += HIG + diablo[t] + "%" NOR WHT "给对方的伤害转化为精神的增加\n";
                                break;

                        case DAMAGE_ADD_FORCE    :
                                msg += HIG + diablo[t] + "%" NOR WHT "给对方的伤害转化为内力的增加\n";
                                break;

                        case DAMAGE_ADD_MANA     :
                                msg += HIG + diablo[t] + "%" NOR WHT "给对方的伤害转化为法力的增加\n";
                                break;

                        case DEFENSE_MAGIC     :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) >0 ) {
                                        string *spells = keys(diablo[t]);

                                        foreach(string s in spells)
                                                msg += "增加" HIG + diablo[t][s] + "%" NOR WHT "对"
                                                        + ((s=="all")?"所有":SPELL_D->query_shuxing_chinese(s))
                                                        + "系法术的防御\n";
                                }
                                break;

                        case ATTACK_MAGIC      :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *spells = keys(diablo[t]);

                                        foreach(string s in spells)
                                                msg += "增加" HIG + diablo[t][s] + "%" NOR WHT
                                                        + ((s=="all")?"所有":SPELL_D->query_shuxing_chinese(s))
                                                        + "法术的伤害\n";
                                }
                                break;

                        case MAGIC_ATTACK      :
                                if( mapp( diablo[t] ) && sizeof(diablo[t]) > 0 ) {
                                        string *spells = keys(diablo[t]);

                                        foreach(string s in spells) {
                                                string name;

                                                if( stringp( name = SPELL_D->attack_spell_name(s) ) )
                                                        msg += "战斗中有" HIG + diablo[t][s] + "%" NOR WHT "的机会出" HIG + name + "\n"NOR WHT;
                                        }
                                }
                                break;

                        case ADD_ATTRIBUTE   :
                                if( mapp( diablo[t] ) ) {
                                        string *attr = keys(diablo[t]);

                                        foreach(string a in attr) {
                                                msg += "增加" HIG + diablo[t][a] + NOR WHT "点";

                                                switch( a ) {
                                                        case "strength"      :
                                                                msg += HIG "膂力\n" NOR WHT;
                                                                break;
                                                        case "courage"       :
                                                                msg += HIG "胆识\n" NOR WHT;
                                                                break;
                                                        case "intelligence"  :
                                                                msg += HIG "悟性\n" NOR WHT;
                                                                break;
                                                        case "spirituality"  :
                                                                msg += HIG "灵性\n" NOR WHT;
                                                                break;
                                                        case "composure"     :
                                                                msg += HIG "定力\n" NOR WHT;
                                                                break;
                                                        case "constitution"  :
                                                                msg += HIG "根骨\n" NOR WHT;
                                                                break;
                                                        case "personality"   :
                                                                msg += HIG "容貌\n" NOR WHT;
                                                                break;
                                                        case "karma"         :
                                                                msg += HIG "福缘\n" NOR WHT;
                                                                break;
                                                        case "all"           :
                                                                msg += HIG "所有天赋属性\n" NOR WHT;
                                                                break;
                                                        default : break;
                                                }
                                        }
                                }
                                break;

                        case MAGIC_FIND      :
                                msg += "增加" HIG + diablo[t] + NOR WHT "的得到更佳宝物的机会\n";
                                break;

                        case ATTACK_BUSY     :
                                msg += "被击中有" HIG + diablo[t] + "%" NOR WHT "的机会眩晕对手\n";
                                break;

                        case ADD_DAMAGE   :
                                msg += "击中对手追加" HIG + diablo[t] + "%" NOR WHT "的伤害\n";
                                break;
                        default : break;
                }
        }

        msg += HIC "≡" HIY "──────────────────────" HIC "≡\n" NOR;
        return msg;
}