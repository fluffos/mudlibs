// 储存箱
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("储存箱", ({ "box"}));
        set_weight(9999999);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("material", "wood");
                set("value", 99);
                set("no_get", 1);
        }
        setup();
}

void init()
{
        add_action("do_pick", "pick");
        add_action("do_put",  "put");
}

string short()
{
        return YEL + this_player()->name(1) + YEL "的储存箱" NOR "(Box)";
}


string long()
{
        object  me, box, *diablo_obs;
        mapping *diablo;
        string  msg;
        int     i;

        me = this_player();

        if( !objectp( box = me->query_temp("diablo_box") ) 
        || !arrayp( diablo = box->query_diablo() )
        || sizeof(diablo) < 1 )
                return short() + "\n里面什么也没有。\n";

        diablo_obs = box->query_diablo_obs();
        if( sizeof(diablo_obs) != sizeof(diablo) ) {
                destruct(box);
                return short() + HIR "\n你的储存箱坏了，请和巫师联系。\n" NOR;
        }

        msg = short() + "\n里面有：\n"
              HIG "───────────────────────────\n" NOR;

        for(i = 0; i < sizeof(diablo); i++) {
                if( objectp(diablo_obs[i]) )
                        continue;

                if( !mapp(diablo[i]) ) continue;

                msg = sprintf("%s" HIG "%3d、" NOR "%s\n",
                                msg,
                                i+1,
                                diablo[i]["name"] + "(" + diablo[i]["id"] + ")");
        }
        msg += HIG "───────────────────────────\n"NOR
               WHT "取出物品：pick 序号； 放入物品：put 物品。\n"NOR;
        return msg;
}

int do_pick(string arg)
{
        object  me, box, ob;
        int     index;

        me = this_player();

        if( !( index = atoi(arg) ) ) return notify_fail("你要取第几件物品？\n");

        if( !objectp( box = me->query_temp("diablo_box") ) )
                return notify_fail("你的储存箱里什么也没有。\n");

        if( !objectp( ob = box->create_diablo(index) ) )
                return notify_fail("无法取得这件物品。\n");

        ob->set_temp("owner", me);

        if( ob->move(me) ) {
                message_vision("$N从储存箱里取出一" + ob->query("unit") + ob->name() + "。\n", me);
                return 1;
        } else {
                destruct(ob);
                return notify_fail("取得物品失败。\n");
        }
}

int do_put(string arg)
{
        object  me, box, ob, *diablo_obs;
        int     index;

        me = this_player();

        if( !objectp(ob = present(arg, me) ) )
                return notify_fail("你要把什么东西放进储存箱？\n");

        if( !objectp( box = me->query_temp("diablo_box") ) )
                return notify_fail("你的储存箱坏了。\n");

        if( !ob->is_diablo() )
                return notify_fail("这样东西不能放进储存箱。\n");

        diablo_obs = box->query_diablo_obs();

        if( sizeof(diablo_obs) < 1 )
                return notify_fail("你的储存箱坏了。\n");

        if( member_array(ob, diablo_obs) == -1 )
                return notify_fail("这样东西是你的吗？\n");

        ob->delete_temp("owner");
        message_vision("$N把$n放进了储存箱。\n", me, ob);
        destruct(ob);
        return 1;
}