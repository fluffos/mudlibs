//带锁房间所用钥匙范例

inherit ITEM;

void create() {
  set_name("新闻室钥匙", ({ "news key", "key" }));
  set("unit", "把");
  set("long", "一把专门用打开新闻中心大门锁的钥匙。\n");
  set("no_get", 1);
  set("no_use", 1);  //玩家不能用
  //       set("admin_use", 1);//Admin以下巫师不能用
  set("key_of_room", ({ "/d/wiz/hall", "/d/wiz/newsroom" }));
  setup();
}
