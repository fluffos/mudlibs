//Added By waiwai@2001/04/29
int valid_leave(object me, string dir)
{
	object *inv;
	int sizeinv;

	if( wizardp(me)) return 1;

	if(dir=="east") {

        if( (int)me->query_condition("no_pk_time",1)>0 )
     		      return notify_fail(HIY"你杀过人,不可进入！！！\n"NOR);

        if( (int)me->query_condition("killer",1) >0 )
     		      return notify_fail(HIR"你杀过人,不可进入！！！\n"NOR);

		inv=all_inventory(me);
		sizeinv=sizeof(inv);
	
		while (sizeinv--) {
       	if (inv[sizeinv]->is_character())  
     		      return notify_fail(HIW"那里禁止背负别人进入！！！\n"NOR);	
		}

            }

     return ::valid_leave(me, dir);
}

