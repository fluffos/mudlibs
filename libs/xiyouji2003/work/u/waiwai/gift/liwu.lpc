//OBJ /u/waiwai/gift/liwu.c
//Last modified by waiwai@2001/02/18

#include <ansi.h>

inherit ITEM;
string *names = ({ "棒棒冰","蹦蹦糖","开心果","麦当劳","肯德基" });
string *msg_eat=({HIR"$N吃着棒棒冰，诡异地说道:这破冰糕还行来……\n",
                  HIC"$N把蹦蹦糖放都嘴里，嘴里噼里啪啦一顿乱响,心情无比舒畅……\n",
                  HIM"$N一边吃着开心果,一边想着自己将要在这个世界中经历成长,不禁激动不以……\n",
                  HIY"$N吃着麦当劳里的薯条和鸡翅，感动的口水直流……\n",
                  HIG"$N吃着里肯德基的薯条和鸡块，一副心满意足的样子……\n",                  
                  });
                        
int do_eat(string arg);

void create()
{
	int num;
	num=random(sizeof(names));
	set_name(names[num],({"gift"}));
  
	set("unit","个");
	set("value", 0);
	set("long","你可以(eat gift) 祝你快乐！");
	setup();
}

void init()
{
	if (!wizardp(this_player())) {
	    set("no_get","这个东西象粘在地上，怎么也拿不起来。\n");
	    set("no_give","你疯了？礼物还送人?\n");
	    set("no_put",1);
	    set("no_putin",1);
	    set("no_putto",1);
	    set("task_give",1);
	    set("combine",1);
	    set("deadfly",1);
	    set("no_stock",1);
	    set("no_drop","这么珍贵的礼物，扔了多可惜呀！\n");
	    set("no_sell","这东西不能卖。\n");
	   }
	if(this_player()==environment())
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	string msg,msg2;
	object me=this_player();  
	int get_qn,get_wx,get_dx;
	int my_exp,my_dx,my_kar;

	if (!arg && arg!="gift")
	    return notify_fail("你要吃什么?\n");  

	if( !wizardp(me) ) {
	if (this_object()->query("owner")!= me->query("id"))
	    return notify_fail(WHT"你突然觉得反胃，吃的东西都吐了出来!\n"NOR);  
	    
	if (me->query("always_gift")) {
	    tell_object(me,HIG"你突然觉得反胃，吃的东西都吐了出来!\n"NOR);  

	destruct(this_object());}
	}

	if (this_object()->query("name")=="棒棒冰")
	  msg=msg_eat[0]; 
	if (this_object()->query("name")=="蹦蹦糖")
	  msg=msg_eat[1];  
	if (this_object()->query("name")=="开心果")
	  msg=msg_eat[2];  
	if (this_object()->query("name")=="麦当劳")
	  msg=msg_eat[3];  
	if (this_object()->query("name")=="肯德基")
	  msg=msg_eat[4];  

	message_vision(msg+"\n"NOR, me );  
  
	my_exp=me->query("combat_exp");
	my_dx=me->query("daoxing");
	my_kar=me->query("kar");

	get_qn=(random(10000)+2000)*my_kar;// /39
	get_wx=(random(10000)+1000)*my_kar;
	get_dx=(random(10000)+2000)*my_kar;

	if (random(2)*random(2)*random(2)*random(2)*random(2)*random(2)) {
	get_qn=get_qn*2;
	get_wx=get_wx*1.5;
	get_dx=get_dx*2;
	}

	if( my_exp < 1500000) {
	get_qn=get_qn/2;
	get_wx=get_wx/2;
	get_dx=get_dx/2;
	if(get_qn >50000) get_qn=50000;
	if(get_wx >100000) get_wx=100000;
	if(get_dx >80000) get_dx=80000;
	} else {
	me->add("gift_points",1+random(2));  
	if(get_qn >500000) get_qn=500000;
	if(get_wx >500000) get_wx=500000;
	if(get_dx >5000000) get_dx=5000000;
	}

	me->add("potential",get_qn);  
	me->add("combat_exp",get_wx);
	me->add("daoxing",get_dx);
	me->set("always_gift", 1);

	msg2= get_wx+"点武学"+XYJTIME_D->check_daoxing(get_dx)+"道行"+get_qn+"点潜能\n";

	MONITOR_D->report_system_object_msg(me, "得到来自[礼物]的奖励为：\n"+ msg2);
        log_file("player/liwu", sprintf("[%s] %s拿取了一份礼物，奖励为%s \n",
		log_time(), log_id(me), msg2 ));

	tell_object(me,HIW"你的奖励是："+get_wx + "点武学，"+XYJTIME_D->check_daoxing(get_dx) +
	 "道行"+get_qn + "点潜能\n" NOR);
    
	destruct(this_object());
	return 1;
}

