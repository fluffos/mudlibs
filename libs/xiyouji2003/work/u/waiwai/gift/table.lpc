//Last modified by waiwai@2001/04/07

#include <ansi.h>

#define CHEER1 __DIR__"cheer1" 
#define CHEER2 __DIR__"cheer2"
#define CHEER3 __DIR__"cheer3"
#define CHEER4 __DIR__"cheer4"
#define CHEER5 __DIR__"cheer5"
#define CHEER6 __DIR__"cheer6"
#define CHEER7 __DIR__"cheer7"


inherit ITEM;
int get_gift(string arg);

void create()
{
	set_name(YEL"西游记礼物台" NOR ,({"gift table","table"}));
	set("long","这是西游记里面唯一的礼物台，玩家可以在这里拿(take)礼物(gift)。");
	set("unit", "个");
	set("value", 1000000000);
}

void init()
{
	if (!wizardp(this_player())) 
	set("no_get","连礼物台都想拿走？太贪心了吧!\n");
	add_action("get_gift","take");
}

int get_gift(string arg)
{
	object me = this_player();
	object lw;
  
	if (!userp(me))
	      return notify_fail("你什么也没拿到。\n");

	if (arg!="gift")  
	      return notify_fail("你要拿什么?\n");
 
	//Added By waiwai@2001/02/16
	if(me->query("title") == "普通百姓")
	      return notify_fail(CYN"你是普通百姓,不能得到礼物！\n"NOR); 

	if((int)me->query("combat_exp") >5000000)
		return notify_fail(CYN"你的武学过高,失去了得到礼物的机会了。\n"NOR);
     
	if((int)me->query("age") <16)
		return notify_fail(CYN"你的岁数太小,系统怀疑你是大米，不能得到礼物。\n"NOR);

	if( !wizardp(me) && me->query("always/gift")) 
	   return notify_fail(YEL"没头脑突然出现在一团烟雾中,狠很地踹了你一脚：拿过了还要？\n"NOR);

	lw=new(__DIR__"liwu.lpc"); 
 
  
  //清屏
  write(REF);
  
  //增加场景,随机显示两个图片.
  switch(random(7)) {
	  	case 0:
	  	cat(CHEER1);
	  	break;
	  	case 1:
	  	cat(CHEER2);
	  	break;
	  	case 2:
	  	cat(CHEER3);
	  	break;
	  	case 3:
	  	cat(CHEER4);
	  	break;
	  	case 4:
	  	cat(CHEER5);
	  	break;  	
	  	case 5:
	  	cat(CHEER6);
	  	break;  	
	  	case 6:
	  	cat(CHEER7);
	  	break;  	
  	}
  //礼物送到玩家身上.
  message_vision("$N从"HIY"礼物台"NOR"上取下一个礼物。\n"NOR, me ); 
  lw->move(me);  
  lw->set("owner",me->query("id"));
  //玩家设置属性.
  me->set("always/gift",1);//Modified By waiwai@2001/02/16

  return 1;
}

