
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIY"一盘鸡屁股"NOR, ({"huoji"}));
        set_weight(1);
        set("unit", "个");
        set("long", "一盘鸡屁股,你可以分(fen)给大家一块吃。\n");
        set("value",1);
        set("no_sell",1);
        set("no_drop","这么好吃的鸡屁股，可不能随便扔！ \n");
        setup();
}

void init()
{
    
        add_action("do_eat","eat");
        add_action("do_fen","fen");
          
}

int do_eat(string arg)
{
        object me = this_player();
 
        if (!id(arg))
           return notify_fail("你要吃什么？\n");
        write(HIW
"想一个人吃这么一大盘鸡屁股吗？就算吝啬也该分给(fen)大家一块吃吧。\n"NOR,me);

        return 1;
}

int do_fen(string arg)
{
        object *alluser,obj,cakepiece;
        int s;
        object me = this_player();
        object room=environment(this_player());
        
        if (!arg || arg!="huoji")
           return notify_fail("你要切什么？\n");
        
        alluser=users();        
        s=sizeof(alluser);
        message_vision(HIW"$N拿起一大盘鸡屁股给大家一人分了一个。\n"NOR,me);

        
        for (int i=0;i<s;i++) {
            obj=alluser[i];
            cakepiece=new("/u/waiwai/gift/jipi/ji");
            cakepiece->move(obj);
            if (obj!=me)
              message("vision",me->query("name")+"分给你一个 "+HIR"鸡屁股 \n"NOR,obj);
        }

        destruct(this_object());
        return 1;
}



