

#include <weapon.h>
#include <ansi.h>

inherit HAMMER;
inherit F_FOOD;
int do_eat(string);

void create()
{
	set_name(HIR "鸡屁股" NOR, ({ "jipi gu", "jipi", "gu"}) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个烤得香喷喷的鸡屁股。\n");
		set("unit", "个");
		set("value", 0);
		set("food_remaining", 4);
		set("food_supply", 15);
		set("wield_msg", "$N抓起一个$n，握在手中当武器。\n");
		
	}
	init_hammer(1);
	setup();
}

int do_eat(string arg)
{
  object me = this_player();
  
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  
  me->set("food", (int)me->max_food_capacity());
  me->add_maximum_force(5);
  me->add_maximum_mana(5);
  message_vision(HIM "$N拿起一个 "HIR"烤得香喷喷的鸡屁股 "HIM"放进嘴里，嘻嘻地笑着说：“鸡屁股好吃，我还要！”  \n" NOR, me);
  
  destruct(this_object());
  return 1;
}
