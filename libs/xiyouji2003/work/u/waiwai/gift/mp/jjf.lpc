// Created by wiwai@2003/06/05
// VIP 补偿金丹(将军府)

#include <ansi.h>

inherit ITEM;

int do_eat(string);

void init();

void init() {
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "VIP补偿金丹(" HIR "将军府" HIY ")" NOR, ({ "vip dan", "dan" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "一枚金光闪闪的金丹，。\n");
    set("value", 10000000);
    set("drug_type", "补品");
  }
  set("no_putin", 1);
  set("no_putto", 1);
  set("no_put", 1);
  set("no_stock", 1);
  set("no_get", 1);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
  set("vip_only", 1);
  set("family_only", "将军府");

  setup();
}

int do_eat(string arg) {
  object vip;
  object me = this_player();
  vip = this_object();

  if (arg != "dan" && arg != "vip dan") return 0;

  if (!me->query("vip")) {
    write("下次别偷别人的东西吃.\n");
    write(vip->name() + "掉在地上不见了.\n");
    destruct(vip);
    return 1;
  }

  if (me->query("family/family_name") != "将军府") {
    write("下次别偷别人的东西吃.\n");
    write(vip->name() + "掉在地上不见了.\n");
    destruct(vip);
    return 1;
  }

  if (me->query_skill("baguazhou", 1))
    me->set_skill("baguazhou", me->query_skill("baguazhou", 1) + 2);

  if (me->query_skill("bawang-qiang", 1))
    me->set_skill("bawang-qiang", me->query_skill("bawang-qiang", 1) + 2);

  if (me->query_skill("changquan", 1))
    me->set_skill("changquan", me->query_skill("changquan", 1) + 2);

  if (me->query_skill("lengquan-force", 1))
    me->set_skill("lengquan-force", me->query_skill("lengquan-force", 1) + 2);

  if (me->query_skill("wusi-mace", 1))
    me->set_skill("wusi-mace", me->query_skill("wusi-mace", 1) + 2);

  if (me->query_skill("yanxing-steps", 1))
    me->set_skill("yanxing-steps", me->query_skill("yanxing-steps", 1) + 2);

  if (me->query_skill("spear", 1))
    me->set_skill("spear", me->query_skill("spear", 1) + 2);

  if (me->query_skill("dodge", 1))
    me->set_skill("dodge", me->query_skill("dodge", 1) + 2);

  if (me->query_skill("force", 1))
    me->set_skill("force", me->query_skill("force", 1) + 2);

  if (me->query_skill("parry", 1))
    me->set_skill("parry", me->query_skill("parry", 1) + 2);

  if (me->query_skill("spells", 1))
    me->set_skill("spells", me->query_skill("spells", 1) + 2);

  if (me->query_skill("mace", 1))
    me->set_skill("mace", me->query_skill("mace", 1) + 2);

  if (me->query_skill("unarmed", 1))
    me->set_skill("unarmed", me->query_skill("unarmed", 1) + 2);

  if (me->query_skill("literate", 1))
    me->set_skill("literate", me->query_skill("literate", 1) + 2);


  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));

  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));

  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));

  me->set("mana", (int)me->query("max_mana"));
  me->set("force", (int)me->query("max_force"));

  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());

  message_vision(HIY "$N将金丹慢慢送入嘴中，只见$N脸上慢慢泛出红晕～～～\n" NOR, me);
  message_vision(HIG "$N的所有技能增加了两级。\n" NOR, me);

  log_file("player/vip_dan", sprintf("%s在%s%s吃下一枚%s，所有技能增加2级 时间在：[%s]\n",
    log_id(me), MISC_D->find_place(environment(me)),
    filter_color(environment(me)->query("short")),
    filter_color(vip->name()), log_time()));

  destruct(vip);
  return 1;
}
