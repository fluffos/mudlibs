
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIY"一盘人参果"NOR, ({"guo"}));
        set_weight(1);
        set("unit", "盘");
        set("long", "一盘人参果,你可以分(fen)给大家一块吃。\n");
        set("value",1);
        set("no_sell",1);
        set("no_drop","这么好吃的人参果，可不能随便扔！ \n");
        setup();
}

void init() { add_action("do_fen","fen"); }

int do_eat(string arg)
{
        object me = this_player();
 
        if (!id(arg))
           return notify_fail("你要吃什么？\n");
        write(HIW"想一个人吃这么一大盘人参果吗？就算吝啬也该分给(fen)大家一块吃吧。\n"NOR,me);

        return 1;
}

int do_fen(string arg)
{
        object *alluser,obj,guo;
        int s;
        object me = this_player();
        object room=environment(this_player());
        
        if (!arg || arg!="guo")
           return notify_fail("你要分什么？\n");
        
        alluser=users();        
        s=sizeof(alluser);
        message_vision(HIW"$N拿起一大盘人参果给大家一人分了一个。\n"NOR,me);

        
        for (int i=0;i<s;i++) {
            obj=alluser[i];
		if(wizardp(obj)) continue;
		if(obj->query("title") == "普通百姓") continue;
		if((int)obj->query("combat_exp") <100000) continue;

	if(obj->query("vip")) {
            guo=new("/u/waiwai/gift/guo/vipguo");
            guo->move(obj);
		} else {
            guo=new("/u/waiwai/gift/guo/guo");
            guo->move(obj);
		}

            if (obj!=me)
              message("vision",me->query("name")+"分给你一个 "HIW"人参果 \n"NOR,obj);
        }

        destruct(this_object());
        return 1;
}



