// Update by waiwai@2003/04/25

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  // Added by waiwai@2003/05/20
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "人参果" NOR, ({ "renshen guo", "renshenguo", "guo" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "白白胖胖的一枚人参果。三千年一开花，三千年一结果，再三千年才得熟，实是天地间的灵宝。\n");
    set("value", 500000);
    set("no_give", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_putin", 1);
    set("no_putto", 1);
    set("no_put", 1);
    set("no_stock", 1);
    set("drug_type", "补品");
  }

  setup();
}

int do_eat(string arg) {
  int howmany;

  object me = this_player();

  if (!id(arg)) return notify_fail("你要吃什么？\n");

  if (environment(me)->query("alternative_die"))
    return notify_fail("你不能在这儿吃" + name() + "。\n");

  if (!me->query("vip")) {
    write("下次别偷别人的东西吃.\n");
    write(this_object()->name() + "掉在地上不见了.\n");
    destruct(this_object());
    return 1;
  }

  message_vision(HIW "$N把人参果往嘴里一塞，忍不住大叫一声：人参果啊人参果，不愧是人参果！ \n说罢兴奋得都快晕了过去。\n" NOR, me);

  me->set("food", (int)me->max_food_capacity());

  if (howmany <= 100) me->add_maximum_force(40);
  if (howmany <= 100) me->add_maximum_mana(40);

  howmany = (int)me->query("rsg_eaten");
  me->set("rsg_eaten", howmany + 2);

  if (me->query("rsg_eaten") >= 49) {
    me->announce_live_forever(me->query("name") +
      "坚持不懈地吃人参果，终于修成了不堕轮回，从此跳出三界外，不在五行中，永无生死大限了！");
  }

  destruct(this_object());

  return 1;
}
