#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIR"一叠红包"NOR, ({"red bag","bag"}));
        set_weight(1);
        set("unit", "叠");
        set("long", "一叠红包。(可分50gold)\n");
        set("value",100000);
        set("no_give",1);
        set("no_drop",1);
        setup();
}

void init()
{
        add_action("do_fen","fen");
}

int do_fen(string arg)
{
        object *alluser,obj,bag;
        int s;
        object me = this_player();
        object room=environment(this_player());
        
        if (!arg || arg!="bag")
           return notify_fail("你要分什么？\n");
        
        alluser=users();        
        s=sizeof(alluser);
        message_vision(HIW"$N给大家一人一个红包。\n"NOR,me);

        
        for (int i=0;i<s;i++) {
            obj=alluser[i];
            bag=new("/u/waiwai/gift/redbag/hb2");
            bag->move(obj);
            if (obj!=me)
            message("vision",me->query("name")+"给你一个 "HIR"红包 \n"NOR,obj);
        }

        destruct(this_object());
        return 1;
}

