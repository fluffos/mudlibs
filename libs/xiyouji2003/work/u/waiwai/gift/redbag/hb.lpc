#include <ansi.h>

inherit ITEM;

void create()
{
	int i;
       object a;

        set_name(HIR "红包" NOR, ({ "redbag", "bag" }) );
        set_weight(500);
        set_max_encumbrance(8000);
        if( clonep() ) {
         seteuid(getuid());
	  for (i=1;i<=10;i++) {
            a=new("/obj/money/thousand-cash");
            a->move(this_object());
            }
          set_default_object(__FILE__);
          } else {
          set("unit", "个");
          set("long", "这是一个不寻常的红包，得到的人会有好运的。\n");
          set("no_give", 1);
          set("no_sell", 1);
          }
}

int is_container() { return 1; }


