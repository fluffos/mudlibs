#include <ansi.h>

inherit ITEM;

void init()
{
        add_action("do_fen","fen");
}

void create()
{
        set_name(HIR"Ｍ"HIY"＆"HIB"Ｍ"HIW"'"HIG"ｓ"NOR, ({"mms"}));
	set_weight(20);
	if (clonep())
	    set_default_object(__FILE__);
	else {
	set("unit", "颗");
	set("long", "一捧五颜六色的"+this_object()->name()+"巧克力豆，●○●○●○●○～～ 只溶在口不熔在手。\n");
	set("value", 1000000);
	set("drug_type", "补品");
	}

	setup();
}

int do_fen(string arg)
{
        object *alluser,obj,cakepiece;
        int s;
        object me = this_player();
        object room=environment(this_player());
        
        if (!arg || arg!="mms")
           return notify_fail("你要分什么？\n");
        
//	if( !wizardp(me) ) return notify_fail("你不能分！\n");

        alluser=users();        
        s=sizeof(alluser);
	message_vision(HIW"$N给大家一人分了一个MMS豆。\n"NOR,me);

        
        for (int i=0;i<s;i++) {
            obj=alluser[i];
            cakepiece=new("/u/waiwai/obj/give/mms");
            cakepiece->move(obj);
            if (obj!=me)
              message("vision",HIW+log_id(me)+"分给你一个"+cakepiece->query("name")+" \n"NOR,obj);
        }

        destruct(this_object());
        return 1;
}

