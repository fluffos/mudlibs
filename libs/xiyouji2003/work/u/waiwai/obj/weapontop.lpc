#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(WHT"西游记江湖武功排行榜"NOR, ({"weapon"}));
       set("long", "西游记的各种武功排名，可以用 "HIR"list "NOR"来查看。\n");
       set("no_get", "你拿不起来这样东西。\n");
}

void init()
{
  add_action("do_list","list");
}

int do_list(string type)
{
 write("/adm/daemons/weapontopd"->topten_query(type));
 return 1;
}
