#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create() {
  set_name(HIB "伯" HIR "爵" HIW "表" NOR, ({ "piaget", "watch" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "瑞士名表 － 伯爵表，表的式样并不花哨，但却高贵得体。\n");
    set("value", 60000);
    set("no_sell", 1);
    set("deadfly", 1);
    set("no_break", 1);
    set("material", "gold");
    set("material", "gem");
    set("armor_prop/armor", 20);
  }
  setup();
}
