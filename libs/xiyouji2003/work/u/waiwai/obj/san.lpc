// Created by waiwai@2002/12/12
// 雨伞的作用是雨天避免雷击

#include <armor.h>

inherit OTHERS;

void create()
{
	set_name( WHT"雨伞"NOR, ({ "umbrella", "yusan", "san" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","一把雨伞，在雨天里可以安全些。\n");
		set("unit", "把");
		set("value", 100);
		set("material", "bamboo");
		set("Fmaterial", "paper");
		set("no_sell",1);
		set("no_drop",1);
		set("no_give",1);
		set("armor_prop/armor",1);
	}
	setup();
}

int init ()
{
  add_action ("do_wear", "wear");
  add_action ("do_remove", "remove");
  return 1;
}

int do_wear (string arg)
{
	object me = this_player();
	object umbrella = this_object();
	string name = umbrella->query("name");
	string msg;

	if (arg != "umbrella" &&  arg != "san" ) return 0;

	msg = "$N将一把"+name+"撑起来打在头顶上。\n"; 
	umbrella->set("wear_msg",msg);
	me->set_temp("thunder",random(100));

	return 0;
}

int do_remove (string arg)
{
	object me = this_player();
	object umbrella = this_object();
	string name = umbrella->query("name");
	string msg;

	if (arg != "umbrella" && arg != "san") return 0;

	msg = "$N将"+name+"轻轻收了起来。\n"; 
	umbrella->set("unequip_msg",msg);
	me->delete_temp("thunder");

	return 0;
}

