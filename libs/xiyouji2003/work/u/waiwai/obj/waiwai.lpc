#include <ansi.h>
inherit ITEM;

void create()
{
set_name(HIR"歪歪的雕像"NOR, ({"waiwai's"}));
set("long", @LONG

真实姓名：不详
真实性别：男
真实星座：天秤
真实住址：青岛
真实属相：酉鸡
真实生日：重阳节
真实品格: 善良正直
真实性格: 有事明说，不捣鼓猫腻
真实爱好: 实在地活着，实在地做事
真实生活: 每多活一天便是最幸运的事 
真实感受: 当我出生的时候，周围的人在笑，而我却在哭！
          当我死去的时候，周围的人在哭，而我已解脱！
真实观点: 没有真正朋友的人活着等同于死去！
          有钱人并不拥有最多，而是需要最少！
          许多人对未来充满忧虑，却忽视现在！
          金钱或许可以买到一切，却买不到真情！
          对于我来说，当遭遇坎坷，只能给自己一个字：熬！
          身在泥潭的许多年使我最深的懂得：我不可能取悦所有的人！
          许多人活着的时候好象永远不会死去，但死去以后又好象从未活过！
LONG);
set("no_get", 1);
set_weight(1000);
}
