// Update by waiwai@2002/12/05

#include <ansi.h>

inherit ITEM;

void init() { add_action("do_ce", "zhaoyao"); }

void create()
{
	set_name( RED"照妖镜"NOR, ({ "monster detector", "detector", "jing" }));
	set_weight(2000);
	if (clonep())set_default_object(__FILE__);
	else {
		set("long","其实妖怪常常就在你身边，用照妖镜照照(zhaoyao)吧。\n");
		set("value", 200000);
		set("unit", "面");
	}
	setup();
}

int do_ce(string target)
{
	string *monster=({ "千年", "万年", "百年", "小小", "九头雉鸡" });

	string *mr=({ "仙", "精", "妖", "怪", "鬼" });
	object obj,*ob,me=this_player();
	int i; 
	string mname;
	
	if(!target) {
		message_vision(HIB"$N拿出照妖镜转了一圈，原来：\n",me);
		ob = all_inventory(environment(me));
		for(i=0; i<sizeof(ob); i++) {
			if( !userp(ob[i]) || wizardp(ob[i]) ||
			 ob[i]==me || ob[i]->query_temp("mark/ifzhao")) continue;
			mname = monster[random(sizeof(monster))];
			mname += ob[i]->query("12_sx");
			mname += mr[random(sizeof(mr))];
			message_vision("$N是个"HIR +mname+ "\n"NOR,ob[i]);
			ob[i]->set_temp("mark/ifzhao",1);
			ob[i]->set_temp("oname",ob[i]->query("name"));
			ob[i]->set("name",mname);
			ob[i]->apply_condition("monster",random(2)+ 2);
		}
		return 1;
	}

	if(!objectp(obj = present(target, environment(me))))
		return notify_fail("这里没有这个人。\n");

	if(obj->query_temp("mark/ifzhao")) return notify_fail("此人已经原形毕露啦！\n");
	
	if(wizardp(obj)) return notify_fail("要照巫师？回去再修炼八辈子吧！\n");

	if(!userp(obj)) return notify_fail("自己回家偷着照比较好！\n");

	obj->set_temp("oname",obj->query("name"));
	mname = monster[random(sizeof(monster))];
	mname += obj->query("12_sx");
	mname += mr[random(sizeof(mr))];
	
	if(obj==me)
		message_vision(HIB"$N一不小心把原形毕露仪对准了自己，结果自己是个"HIR+	mname+"。\n"NOR,me);
	else {
		message_vision(HIB"$N拿出原形毕露仪一测，原来$n是个"HIR +mname+ "。\n"NOR,me,obj);
	}
	obj->set_temp("mark/ifzhao",1);
	obj->set("name",mname);
	obj->apply_condition("monster",random(2)+ 2);
	return 1;
}
