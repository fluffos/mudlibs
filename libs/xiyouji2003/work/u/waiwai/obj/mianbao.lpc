#include <ansi.h>

inherit ITEM;
void init() {
  if (this_player() == environment())
    add_action("do_fen", "fen");
}

void create() {
  set_name("面包", ({ "mianbao", "bao" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个新鲜的三文治面包，据说是没头脑自己烤制的。\n");
    set("unit", "个");
    set("value", 80);
  }
}

int do_fen(string arg) {
  object *alluser, obj, cakepiece;
  int s;
  object me = this_player();
  object room = environment(this_player());

  if (!arg || arg != "mianbao")
    return notify_fail("你要分什么？\n");

  if (!wizardp(me) && !me->query("vip")) return notify_fail("你不能分！\n");

  alluser = users();
  s = sizeof(alluser);
  message_vision(HIW "$N给大家一人分了一个面包。\n" NOR, me);


  for (int i = 0; i < s; i++) {
    obj = alluser[i];
    cakepiece = new("/u/waiwai/obj/mb");
    cakepiece->move(obj);
    if (obj != me)
      message("vision", HIW + log_id(me) + "分给你一个" + cakepiece->query("name") + " \n" NOR, obj);
  }

  destruct(this_object());
  return 1;
}
