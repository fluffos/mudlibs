// Update by waiwai@2002/12/05

inherit ITEM;
#include <ansi.h>

void init()
{
	if( this_player()==environment() ) {
        add_action("do_smoke", "xiyan");
        add_action("do_fen","fen");
	}
}

void create()
{
        string *order = ({HIC"中华"NOR, HIC"大前门"NOR, WHT"特醇将军"NOR, HIY"黄鹤楼"NOR,
HIR"柔和"HIW"七星"NOR, HIM"红塔山"NOR, HIM"万宝路"NOR, HIB"希尔顿"NOR, HIR"香格里拉"NOR, 
HIW"极品云烟"NOR, HIY"圣罗兰"NOR, HIY"骆驼"NOR, HIG"精品三五"NOR, HIG"玉溪"NOR, HIR"骄子"NOR,
HIM"红山茶"NOR, HIB"精品红河"NOR, HIR"红双喜"NOR });

        set_name( (order[random(sizeof(order))]), ({ "xiang yan", "yan" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一盒香烟，可以 "HIR"(xiyan) \n"NOR);
                set("unit", "盒");
                set("count",8);
                set("value", 50000);
        }
}

int do_smoke()
{
        object me = this_player();
        object obj = this_object();

//        if(environment(me)->query("sleep_room"))
//                return notify_fail("睡房里不准抽烟！\n");

        if(environment(me)->query("no_smoke"))
                return notify_fail(HIR"这里不准抽烟！\n"NOR);
        if( me->is_busy() )
                return notify_fail(HIG"你正忙着呢，没空抽烟！\n"NOR);

        if(environment(obj) != me)
                return notify_fail("你是在看烟吧？\n");
        if(query("master") && query("master") != me->query("id"))
                return notify_fail("这烟已经点燃了，而且不是你的烟。\n");
        add("count",-1);
        me->start_busy(1);
        me->add("sen", 50);
        switch(query("count")) {
                case 1: message_vision("$N猛吸了一口剩下的"YEL"烟屁股"+NOR"，两根手指夹住一弹，扔掉了烟头。\n", me);
                        break; 
                case 2: message_vision("$N吐出一串"HIC"烟圈"+NOR"，看着它悠闲地散开。\n", me);
                        break;
                case 3: message_vision("$N闭上眼睛，深深地吸了一口$n，又从鼻孔中喷出来：“爽啊！爽啊！”\n", me, obj);
                        break;
                case 4: message_vision("$N狠狠的吸了一口$n，大概是吸得太猛了，一张脸涨的通红。\n", me, obj);
                        break;
                case 5: message_vision("$N吸了一口$n，摇头晃脑地说道：“饭后一支烟，赛过"HIM"活神仙。”\n"NOR, me, obj );
                        break;
                case 6: message_vision("$N翘起二郎腿，眯上眼睛，猛吸了一口$n，自言自语道：“这东西害人又害己，为啥我还那么喜欢？”\n", me, obj);
                        break;
                case 7: set("master", me->query("id"));
                        message_vision("$N抽出一支$n，点着了"BLINK HIR"火"NOR" 美滋滋地吸了起来。\n", me, obj);
                        break;
                default:
                        break;
        }        
        if(query("count") > 1) call_out("do_smoke", 10);
        else destruct(obj); remove_call_out("do_smoke");

        return 1;
}

int do_fen(string arg)
{
        object *alluser,obj,cakepiece;
        int s;
        object me = this_player();
        object room=environment(this_player());
        
        if (!arg || arg!="yan")
           return notify_fail("你要分什么？\n");
        
	if( !wizardp(me) ) return notify_fail("你不能分！\n");

        alluser=users();        
        s=sizeof(alluser);
        message_vision(HIW"$N给大家一人分了一盒烟。\n"NOR,me);

        
        for (int i=0;i<s;i++) {
            obj=alluser[i];
            cakepiece=new("/u/waiwai/obj/yan");
            cakepiece->move(obj);
            if (obj!=me)
              message("vision",HIW+log_id(me)+"分给你一盒"+cakepiece->query("name")+" \n"NOR,obj);
        }

        destruct(this_object());
        return 1;
}

