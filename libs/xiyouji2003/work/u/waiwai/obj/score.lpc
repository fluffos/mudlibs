#include <ansi.h>

inherit ITEM;

void create() {
  set_name(WHT "西游记江湖人物排行榜" NOR, ({ "score" }));
  set("long", "西游记的各种人物排名，可以用 " HIR "topten " NOR "来查看。\n");
  set("no_get", "你拿不起来这样东西。\n");
}
