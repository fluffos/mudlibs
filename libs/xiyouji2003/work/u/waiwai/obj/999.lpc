#include <armor.h>

inherit OTHERS;

void create ()
{
	set_name(HIR "九百九十九朵玫瑰" NOR, ({ "999 flower", "999", "flower" }));
	set_weight(100);
	set("long","色彩艳丽的"+query("name")+"。\n");
	set("unit", "扎");
	set("base_unit", "把");
	set("value", 1);
	set("no_sell", 1);
	set("no_drop", 1);
	set("no_give", 1);
	set("no_get", 1);
	set("armor_prop/armor", 10);
	set("armor_prop/personality", 10);
	set("unequip_msg","$N将"+query("name")+"轻轻地摘下来……。\n");
	set("wear_msg", "$N戴上"+query("name")+"，不禁想起年少时曾经的梦中人。\n" );
	setup();
}


