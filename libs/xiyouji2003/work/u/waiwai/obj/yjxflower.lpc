#include <ansi.h>
#include <armor.h>
#include <message.h>
void always_flower();

inherit HEAD;

void create() {
  set_name(HIY "郁金香" NOR, ({ "tulip", "flower" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "\n" NOR);
    set("unit", "朵");
    set("value", 100000);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("material", "plant");
    set("armor_prop/armor", 3);
    set("armor_prop/personality", 3);
    set("wear_msg", "$N轻轻地把一朵$n戴在头上,禁不住想起了那些难以忘怀不可磨灭的时光。\n");
    set("unequip_msg", "$N轻轻地把$n从头上除了下来,你的身影似乎已经凝固在这花心里了。\n");
  }
  setup();
}

void init() {
  remove_call_out("always_tree");
  call_out("always_flower", 1, this_object());
}

void always_flower() {
  int i;
  object *list, ob;
  string msg;
  list = users();
  i = sizeof(list);

  if (i < 1) {
    remove_call_out("always_flower");
    return;
  }
  //	else
  //	  call_out("always_flower",60);

  switch (random(3)) {
    case 0:
      {
        message_vision(HIB "郁金香在风中与风共舞。\n" NOR, this_object());
        remove_call_out("always_flower");
        call_out("always_flower", 60);
        break;
      }
    case 1:
      {
        message_vision(HIW "郁金香含苞待放,快要开花了。\n" NOR, this_object());
        remove_call_out("always_flower");
        call_out("always_flower", 80);
        break;
      }
    case 2:
      {
        message_vision(HIY "郁金香微笑着。\n" NOR, this_object(), ob);
        remove_call_out("always_flower");
        call_out("always_flower", 100);

        break;
      }
  }
}
