
inherit ITEM;
inherit F_FOOD;

void create()
{
       set_name("面包", ({"mianbao", "bao"}));
	set_weight(40);
	if (clonep())
		set_default_object(__FILE__);
	else {
              set("long", "一个新鲜的三文治面包，据说是没头脑自己烤制的。\n");
              set("unit", "个");
		set("value", 80);
		set("food_remaining", 300000);
		set("food_supply", 500);
	}
}
