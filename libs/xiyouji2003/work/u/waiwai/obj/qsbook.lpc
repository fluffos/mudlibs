// Created By waiwai@2002/02/18

inherit ITEM;

#include <ansi.h>

int do_kan(string arg);

void create() {
  set_name("《前世今生的缘》", ({ "lover story", "lover", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 1000);
    set("no_sell", 1);
    set("long", " 《前世今生的缘》 请用 yuedu 阅读(1-4)。\n");
    set("material", "paper");  // 主物质：纸
    set("Fmaterial", "thread");  // 辅物质：线
  }
}

void init() { add_action("do_kan", "yuedu"); }

int do_kan(string arg) {
  object me = this_player();
  object ob = this_object();
  int size = 100;
  int nb = 0;

  ob->set("value", 1000);

  if (arg == "new") return 0;

  if (!arg || sscanf(arg, "%d", nb) != 1) {
    write("\n");
    me->start_more(read_file("/doc/help/wkz/qianshi"));
    write("\n");
    write("请用 yuedu <number> 参阅有关章节(1-4)。\n");
    return 1;
  }

  if (nb <= 0 || nb > size)
    return notify_fail("你要读哪一章？\n");
  else {
    write("\n");
    if (nb < 10 && file_size("/doc/help/wkz/qianshi" + nb) >= 0)
      me->start_more(read_file("/doc/help/wkz/qianshi" + nb));
    else if (file_size("/doc/help/wkz/qianshi" + nb) >= 0)
      me->start_more(read_file("/doc/help/wkz/qianshi" + nb));
    else write(WHT "总共4回，请正确输入号码。" NOR);
    write("\n");
    return 1;
  }
}
