// Created by waiwai@2000/08/20

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(HIB "一箱深蓝色的可口可乐" NOR, ({ "cocacola" }));
  set("long", "这是一瓶只有在Void 才见的到的奖品，口渴使你忍不住想喝他一口。\n");
  set("unit", "箱");
  set("base_weight", 200);
}

void init() {
  if (this_player() == environment())
    add_action("do_fen", "fen");
}

int do_fen(string arg) {
  object *alluser, obj, cakepiece;
  int s;
  object me = this_player();
  object room = environment(this_player());

  if (!arg || arg != "cocacola")
    return notify_fail("你要分什么？\n");

  if (!wizardp(me) && !me->query("vip")) return notify_fail("你不能分！\n");

  alluser = users();
  s = sizeof(alluser);
  message_vision(HIW "$N给大家一人分了一瓶可口可乐。\n" NOR, me);


  for (int i = 0; i < s; i++) {
    obj = alluser[i];
    cakepiece = new("/u/waiwai/obj/cocacola");
    cakepiece->move(obj);
    if (obj != me)
      message("vision", HIW + log_id(me) + "分给你一瓶" + cakepiece->query("name") + " \n" NOR, obj);
  }

  destruct(this_object());
  return 1;
}
