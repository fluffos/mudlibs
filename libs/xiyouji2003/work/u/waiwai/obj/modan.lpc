#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "你手里一松" + this_object()->query("name") + "魔丹从指间滑落！\n");
    set("no_give", "这么珍贵的魔丹，哪能随便给人？\n");
    set("no_drop", "这么宝贵的魔丹，扔了多可惜呀！\n");
    set("no_put", "这么宝贵的魔丹，还想攥着呀，快吃吧，别坏了！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
  call_out("self_dest", 600 + random(60), this_object());

}

void create() {
  set_name(HIR "魔丹" NOR, ({ "mo dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗用魔法师心血炼制的仙丹。\n");
    set("eat_msg", "$N拿起一颗" HIR "魔丹" NOR "放进嘴里，只觉得筋脉欲爆！ \n");
    set("value", 500000);
    set("drug_type", "补品");
  }
  set("is_monitored", 1);

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->add_maximum_force(100);
  me->add_maximum_mana(100);

  message_vision(HIY "$N拿起一颗" HIR "魔丹" HIY "放进嘴里，只觉得筋脉欲爆！！！\n" NOR, me);

  destruct(this_object());
  return 1;
}

void self_dest(object me) {
  if (!me) return;
  if (!environment(me)) return;
  tell_object(environment(me), name() +
    "突然落在地上，不见了。\n");
  destruct(me);
}
