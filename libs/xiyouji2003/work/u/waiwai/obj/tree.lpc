/*
樱花(sweet osmanthus) 学名(Prunus serrulata)
双子叶植物，蔷薇科。落叶乔木，高10～25米。树皮褐色，有皮孔。
叶卵圆形，叶缘有锯齿。由3～5朵花组成伞房花序或总状花序，花瓣
白色或粉红色，4～5月开放。7月果熟，核果球形，黑色。
原产中国，日本，朝鲜。喜排水良好的肥沃土壤和湿润环境，不耐盐
碱。野外多生在山沟溪旁，杂树林中。一般用嫁接繁殖，栽培品种有
几百种。樱花是春季重要观花乔木，园林中常种植在道路两旁，或山
坡上。叶和核仁可入药，木材是雕刻工艺的好材料。
此外，在园林中常见的其他樱花有：日本樱花(Prunus ye-doensis)，
又称东京樱花，高达16米，树皮带银灰色，花梗，萼筒有毛，花期较
短，但花很茂盛。日本晚樱(Prunus lannesiana)，花期较晚，花大，
重瓣，粉红色，有香气。
*/

#include <allobj.h>
#include <message.h>

inherit ITEM;
void lowtree();
void power_lowtree();

void create()
{
	set_name(HIW"千年樱花树"NOR, ({ "oriental cherry", "tree" }) );
	set_weight(999999);
	set_max_encumbrance(80000);
	set("no_get", 1);
	set("no_sell", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "株");
		set("long", 
HIM"一株千年樱花树，清风一吹，片片花瓣随风飘落。"NOR"

樱花(sweet osmanthus) 学名(Prunus serrulata)
双子叶植物，蔷薇科。落叶乔木，高10～25米。树皮褐色，有皮孔。
叶卵圆形，叶缘有锯齿。由3～5朵花组成伞房花序或总状花序，花瓣
白色或粉红色，4～5月开放。7月果熟，核果球形，黑色。
原产中国，日本，朝鲜。喜排水良好的肥沃土壤和湿润环境，不耐盐
碱。野外多生在山沟溪旁，杂树林中。一般用嫁接繁殖，栽培品种有
几百种。樱花是春季重要观花乔木，园林中常种植在道路两旁，或山
坡上。叶和核仁可入药，木材是雕刻工艺的好材料。
此外，在园林中常见的其他樱花有：日本樱花(Prunus ye-doensis)，
又称东京樱花，高达16米，树皮带银灰色，花梗，萼筒有毛，花期较
短，但花很茂盛。日本晚樱(Prunus lannesiana)，花期较晚，花大，
重瓣，粉红色，有香气。\n"NOR);
		set("value", 100000000);
	}
	setup();
}

// 用最简单的方式，尽量不用call_out()
void init()
{
	string season;
	season = NATURE_D->check_season();

	// 首先排除季节，冬季是不可能开花的
	if( season != "Winter-Sun" || season != "Winter-Snow" || season != "Winter-Wind" ) {
//       if( !random(30) ) { // 落花的随机性不能太小了
//	power_lowtree();
//       return;
//	} else 
	if(!random(10))
	message_vision(HIG"\n千年樱花树已经开花了。。。。\n"NOR,this_object());
	}
}

void power_lowtree()
{
	string season;
	int i;

	season = NATURE_D->check_season();

//	if( season != "Winter-Sun" || season != "Winter-Snow" || season != "Winter-Wind" ) {

	for (i=1;i<=40;i++) {
	new(CITY_OBJ"huaban")->move(CITY_ROOM"zhuque-w1");
	new(CITY_OBJ"huaban")->move(CITY_ROOM"zhuque-e1");
	new(CITY_OBJ"huaban")->move(CITY_ROOM"nanan-xiaodao1");
	new(CITY_OBJ"huaban")->move(CITY_ROOM"nanan-dadao1");
	new(CITY_OBJ"huaban")->move(CITY_ROOM"center");
	}	
//	}
}
