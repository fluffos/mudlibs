#include <login.h>
inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>

void create()
{
	set_name(WHT"大海碗"NOR, ({ "haiwan", "wan", "tang" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只青瓷大海碗\n");
		set("unit", "只");
		set("value", 0);
		set("no_get", 1);
		set("no_give", 1);
		set("no_put", 1);
		set("deadfly", 1);
//		set("no_drop", 1);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": HIY"还魂汤"NOR,
		"remaining": 5,
		"drunk_apply": 1,
	]) );
}

int do_drink(string arg)
{
   int foo;
   foo=::do_drink(arg);
   if (!foo) return foo;

   if(this_player()->is_ghost()) {
	if(!present(this_player())) {
	    message_vision(HIB"冥冥之中刮起一股阴风，将$N的鬼魂卷住不见了。\n"NOR,this_player());
	    this_player()->move(environment(this_object()),2);
	    this_player()->start_busy(3);
    } 
 
	this_player()->reincarnate();
//	this_player()->unconcious();
	this_player()->set("gin", (int)this_player()->query("max_gin"));
	this_player()->set("kee", (int)this_player()->query("max_kee")/4);
	this_player()->set("sen", (int)this_player()->query("max_sen")/4);
//	this_player()->move(REVIVE_ROOM);
	this_player()->move("/d/ourhome/kedian");

//	this_player()->set("startroom", base_name(environment(this_player())));
        tell_room(environment(this_player()), 
                HIB"眼前一股青气飘荡，满满地聚成了一个人的样子。\n"NOR, environment(this_player()), this_player());
          destruct(this_object());
   }	
  return 1;
}
