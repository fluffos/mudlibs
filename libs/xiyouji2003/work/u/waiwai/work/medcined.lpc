// medicind.c

#include <ansi.h>

#define  RECOVER             1               // 恢复气血
#define  REFRESH             2               // 恢复精神
#define  FORCE_              3               // 恢复内力
#define  MANA                4               // 恢复法力
#define  ATTR_TEMP           5               // 后天属性
#define  DETOXICATION        6               // 解某种毒
#define  MAX_KEE             7               // 最大气血
#define  MAX_SEN             8               // 最大精神
#define  MAX_FORCE           9               // 最大内力
#define  MAX_MANA           10               // 最大法力
#define  COMBAT_EXP         11               // 增加武学
#define  DAOXING            12               // 增加道行
#define  POTENTIAL          13               // 增加潜能
#define  LEARN_POINT        14               // 增加武功熟练度
#define  DETOX_ALL          15               // 解百毒
#define  INVISIBILITY       16               // 隐身
#define  ATTRIBUTE          17               // 先天属性


inherit F_DBASE;
inherit F_SAVE;

mapping ingredient;                      // 原料
mapping production;                      // 成品
mapping prescription;                    // 处方

nosave string *attr = ({ "寒", "热", "温", "凉" });

nosave mapping attr_level = ([
                                RECOVER      : 1,
                                REFRESH      : 1,
                                FORCE        : 2,
                                MANA         : 2,
                                ATTR_TEMP    : 3,
                                DETOXICATION : 3,
                                MAX_KEE      : 4,
                                MAX_SEN      : 4,
                                MAX_FORCE    : 5,
                                MAX_MANA     : 5,
                                COMBAT_EXP   : 6,
                                DAOXING      : 6,
                                POTENTIAL    : 7,
                                LEARN_POINT  : 7,
                                DETOX_ALL    : 8,
                                INVISIBILITY : 8,
                                ATTRIBUTE    : 9
                            ]);

varargs void finish_add_production(object me, string idx, string name, string desc, string unit, int decay,
                              int value, int select, int min, int max, mixed item);

string query_save_file() { return DATA_DIR "medicined"; }

void create()
{
        seteuid(ROOT_UID);

        set("channel_id", "李时珍");
        CHANNEL_D->do_channel( this_object(), "sys", "李时珍制药系统已经启动。");

        if( !restore() ) {
                ingredient   = ([]);
                production   = ([]);
                prescription = ([]);
        }
}

/*******************************************************************************
                                  增加成品
********************************************************************************/

void add_ingredient(object me, string idx)
{
        if( !undefinedp(ingredient[idx]) ) {
                tell_object(me, "已经有" + idx + "这种原料存在了。\n");
                return;
        }

        if( !undefinedp(prescription[idx]) ) {
                tell_object(me, "已经有" + idx + "这种成品存在了。\n");
                return;
        }

        tell_object(me, "请输入" + idx + "这种原料的中文名（可加颜色）：");
        input_to("add_ingredient_step2", me, idx);
}

void add_ingredient_step2(string name, object me, string idx)
{
        name = trans_color(name, 1);

        tell_object(me, "请输入" + name + "这种原料的等级（１～９）：");
        input_to("add_ingredient_step3", me, idx, name);
}

void add_ingredient_step3(string lvl, object me, string idx, string name)
{
        int level;

        if( !( level = atoi(lvl) ) 
        ||  level > 9 || level < 1 ) {
                tell_object(me, HIR "等级只能在１～９之间。\n" NOR 
                                "请输入" + name + "这种原料的等级（１～９）：");
                input_to("add_ingredient_step3", me, idx, name);
                return;
        }

        tell_object(me, name + "是否会腐烂？（Y / N）");
        input_to("add_ingredient_step4", me, idx, name, level);
}

void add_ingredient_step4(string arg, object me, string idx, string name, int lvl)
{
        int decay = 0;
        
        arg = upper_case(arg);

        if( arg != "Y" && arg != "N" ) {
                tell_object(me, name + "是否会腐烂？（Y / N）");
                input_to("add_ingredient_step4", me, idx, name, lvl);
                return;
        }

        if( arg == "Y" ) decay = 1;

        tell_object(me, "请输入" + name + "的价格（单位：coin）：");
        input_to("add_ingredient_step5", me, idx, name, lvl, decay);
}

void add_ingredient_step5(string arg, object me, string idx, string name, int lvl, int decay)
{
        int value;

        if( !( value = atoi(arg) ) || value < 0 ) {
                tell_object(me, "请输入" + name + "的价格（单位：coin）：");
                input_to("add_ingredient_step5", me, idx, name, lvl, decay);
                return;
        }

        tell_object(me, "请为" + name + "制定描述：");
        input_to("add_ingredient_step6", me, idx, name, lvl, decay, value);

}

void add_ingredient_step6(string arg, object me, string idx, string name, int lvl,
                          int decay, int value)
{
        if( strlen(arg) < 10 ) {
                tell_object(me, "描述太短了。\n请为" + name + "制定描述：");
                input_to("add_ingredient_step6", me, idx, name, lvl, decay, value);
                return;
        }

        if( arg[strlen(arg)-2..strlen(arg)-1] != "。" )
                arg += "。\n";
        else arg += "\n";

        tell_object(me, "请设定" + name + "的单位量词（如：个，块...）：");
        input_to("add_ingredient_step7", me, idx, name, lvl, decay, value, arg);
}

void add_ingredient_step7(string arg, object me, string idx, string name, int lvl,
                          int decay, int value, string desc)
{
        if( !is_chinese(arg) || strlen(arg) != 2 ) {
                tell_object(me, "量词必须是一个字的中文。\n请设定" + name 
                                + "的单位量词（如：个，块...）：");
                input_to("add_ingredient_step7", me, idx, name, lvl, decay, value, desc);
                return;
        }

        tell_object(me, "请设定" + name + "的属性：\n"
                        "１．寒\n"
                        "２．热\n"
                        "３．温\n"
                        "４．凉\n"
                        "请输入选项（１～４）：");
        input_to("add_ingredient_step8", me, idx, name, lvl, decay, value, desc, arg);
}

void add_ingredient_step8(string arg, object me, string idx, string name, int lvl,
                          int decay, int value, string desc, string unit)
{
        int n;

        if( !( n = atoi(arg) ) || n < 1 || n > 4 ) {
                tell_object(me, "请输入选项（１～４）：");
                input_to("add_ingredient_step8", me, idx, name, lvl, decay, value, desc, unit);
                return;
        }

        arg = attr[n-1];
        ingredient[idx] = ([]);
        ingredient[idx]["name"]  = name;
        ingredient[idx]["level"] = lvl;
        ingredient[idx]["decay"] = decay;
        ingredient[idx]["value"] = value;
        ingredient[idx]["desc"]  = desc;
        ingredient[idx]["unit"]  = unit;
        ingredient[idx]["attribute"]  = arg;

        if( save() )
                tell_object(me, "新的原料储存完毕。\n");
        else tell_object(me, "新的原料储存失败。\n");
}

/*******************************************************************************
                                  增加成品
********************************************************************************/

void add_production(object me, string idx)
{
        if( !undefinedp(ingredient[idx]) ) {
                tell_object(me, "已经有" + idx + "这种原料存在了。\n");
                return;
        }

        if( !undefinedp(production[idx]) ) {
                tell_object(me, "已经有" + idx + "这种成品存在了。\n");
                return;
        }

        tell_object(me, "请输入" + idx + "这种成品的中文名（可加颜色）：");
        input_to("add_production_step2", me, idx);
}

void add_production_step2(string name, object me, string idx)
{
        name = trans_color(name, 1);

        tell_object(me, "请输入" + name + "这种成品的描述：");
        input_to("add_production_step3", me, idx, name);
}

void add_production_step3(string desc, object me, string idx, string name)
{
        if( strlen(desc) < 10 ) {
                tell_object(me, "描述太短了。\n请为" + name + "制定描述：");
                input_to("add_production_step3", me, idx, name);
                return;
        }

        if( desc[strlen(desc)-2..strlen(desc)-1] != "。" )
                desc += "。\n";
        else desc += "\n";

        tell_object(me, "请设定" + name + "的单位量词（如：个，块...）：");
        input_to("add_production_step4", me, idx, name, desc);
}

void add_production_step4(string unit, object me, string idx, string name, string desc)
{
        if( !is_chinese(unit) || strlen(unit) != 2 ) {
                tell_object(me, "量词必须是一个字的中文。\n请设定" + name 
                                + "的单位量词（如：个，块...）：");
                input_to("add_production_step4", me, idx, name, desc);
                return;
        }

        tell_object(me, name + "是否会腐烂？（Y / N）");
        input_to("add_production_step5", me, idx, name, desc, unit);
}

void add_production_step5(string arg, object me, string idx, string name, string desc,
                          string unit)
{
        int decay = 0;

        arg = upper_case(arg);

        if( arg != "Y" && arg != "N" ) {
                tell_object(me, name + "是否会腐烂？（Y / N）");
                input_to("add_production_step4", me, idx, name, desc, unit);
                return;
        }

        if( arg == "Y" ) decay = 1;

        tell_object(me, "请输入" + name + "的价格（单位：coin）：");
        input_to("add_production_step6", me, idx, name, desc, unit, decay);
}

void add_production_step6(string arg, object me, string idx, string name, string desc,
                          string unit, int decay)
{
        int value;

        if( !( value = atoi(arg) ) || value < 0 ) {
                tell_object(me, "请输入" + name + "的价格（单位：coin）：");
                input_to("add_production_step6", me, idx, name, desc, unit, decay);
                return;
        }

        tell_object(me, "请输入" + name + "的属性：\n"
                        "1. 恢复气血\n"
                        "2. 恢复精神\n"
                        "3. 恢复内力\n"
                        "4. 恢复法力\n"
                        "5. 后天属性\n"
                        "6. 解某种毒\n"
                        "7. 最大气血\n"
                        "8. 最大精神\n"
                        "9. 最大内力\n"
                        "10.最大法力\n"
                        "11.增加武学\n"
                        "12.增加道行\n"
                        "13.增加潜能\n"
                        "14.增加武功熟练度\n"
                        "15.解百毒\n"
                        "16.隐身\n"
                        "17.先天属性\n"
                        "请输入（1～17）：");
         input_to("add_production_step7", me, idx, name, desc, unit, decay, value);
}

void add_production_step7(string arg, object me, string idx, string name, string desc,
                          string unit, int decay, int value)
{
        int select;

        if( !( select = atoi(arg) )
        ||  select < 1 ||  select > 17  ) {
                tell_object("请输入（1～17）");
                input_to("add_production_step7", me, idx, name, desc, unit, decay, value);
                return;
        }

        switch( select ) {
                case RECOVER      :
                case REFRESH      :
                case FORCE_       :
                case MANA         :
                case MAX_KEE      :
                case MAX_SEN      :
                case MAX_FORCE    :
                case MAX_MANA     :
                case COMBAT_EXP   :
                case DAOXING      :
                case POTENTIAL    : tell_object(me, "请为输入要增加的数值设置一个范围（如：10 100）");
                                    input_to("add_production_number", me, idx, name, desc, unit,
                                                                       decay, value, select, 0);
                                    break;

                case ATTR_TEMP    :
                case ATTRIBUTE    : tell_object(me, "你要想增加哪项属性？\n"
                                                 "1.kar 福缘\n"
                                                 "2.per 容貌\n"
                                                 "3.int 悟性\n"
                                                 "4.spi 灵性\n"
                                                 "5.str 臂力\n"
                                                 "6.cor 胆识\n"
                                                 "7.cps 定力\n"
                                                 "8.con 根骨\n"
                                                 "9.随机\n"
                                                 "请输入（1～9）：");
                                    input_to("add_production_attr", me, idx, name, desc, unit,
                                                                     decay, value, select);
                                    break;

                case DETOXICATION : tell_object(me, name + "能解哪种毒？");
                                    input_to("add_production_detox", me, idx, name, desc, unit,
                                                                      decay, value, select);
                                    break;

                case LEARN_POINT  : tell_object(me, name + "能增加哪项技能？");
                                    input_to("add_production_skill", me, idx, name, desc, unit,
                                                                      decay, value, select);
                                    break;

                case DETOX_ALL    :
                case INVISIBILITY : 
                                    finish_add_production(me, idx, name, desc, unit, decay, value, select);
                default           : break;
        }
}

void add_production_attr(string arg, object me, string idx, string name, string desc,
                         string unit, int decay, int value, int select)
{
        string attr, *atts = ({ "kar", "per", "int", "spi", "str", "cor", "cps", "con" });
        int    att;

        if( !( att = atoi(arg) ) || att < 1 || att > 9 ) {
                tell_object(me, "请输入（1～9）：");
                input_to("add_production_attr", me, idx, name, desc, unit,
                                                decay, value, select);
                return;
        }

        if( att != 9 ) attr = atts[att - 1];
        else attr = "random";
        tell_object(me, "请为输入要增加的数值设置一个范围（如：10 100）");
        input_to("add_production_number", me, idx, name, desc, unit, decay, value, select, attr);
}

void add_production_detox(string arg, object me, string idx, string name, string desc,
                           string unit, int decay, int value, int select)
{
        if( file_size(CONDITION_D(arg) + ".lpc") <= 0 ) {
                tell_object(me, "没有这种毒。\n请重新输入：");
                input_to("add_production_detox", me, idx, name, desc, unit, decay, value, select);
                return;
        }

        finish_add_production(me, idx, name, desc, unit, decay, value, select, 0, 0, arg);
}

void add_production_skill(string skill, object me, string idx, string name, string desc,
                           string unit, int decay, int value, int select)
{
        if( !find_object(SKILL_D(skill)) && !load_object(SKILL_D(skill)) ) {
                tell_object(me, "没有这项武功。\n请重新输入：");
                input_to("add_production_skill", me, idx, name, desc, unit, decay, value, select);
                return;
        }

        tell_object(me, "请为输入要增加的数值设置一个范围（如：10 100）");
        input_to("add_production_number", me, idx, name, desc, unit, decay, value, select, skill);
}

void add_production_number(string arg, object me, string idx, string name, string desc,
                           string unit, int decay, int value, int select, mixed item)
{
        int min, max;

        if( sscanf(arg, "%d %d", min, max) != 2  ) {
                tell_object(me, "请为输入要增加的数值设置一个范围（如：10 100）");
                input_to("add_production_number", me, idx, name, desc, unit, decay, value, select, item);
                return;
        }

        finish_add_production(me, idx, name, desc, unit, decay, value, select, min, max, item);
}

varargs void finish_add_production(object me, string idx, string name, string desc, string unit, int decay,
                              int value, int select, int min, int max, mixed item)
{
        production[idx] = ([]);
        production[idx]["name"]  = name;
        production[idx]["desc"]  = desc;
        production[idx]["unit"]  = unit;
        production[idx]["decay"] = decay;
        production[idx]["value"] = value;
        production[idx]["attr"]  = select;

        switch( select ) {
                case ATTR_TEMP    :
                case ATTRIBUTE    :
                                    production[idx]["min"]  = min;
                                    production[idx]["max"]  = max;
                case DETOXICATION :
                case LEARN_POINT  :
                                    production[idx]["item"] = item;
                case DETOX_ALL    :
                case INVISIBILITY :
                                    break;
                default           : 
                                    production[idx]["min"]  = min;
                                    production[idx]["max"]  = max;                                    
                                    break;
        }

        if( save() )
                tell_object(me, "新的成品储存完毕。\n");
        else tell_object(me, "新的成品储存失败。\n");
}
/*******************************************************************************
                                  增加处方
********************************************************************************/

void add_prescription(object me, string idx)
{
        string *ingredients, msg;
        int    i;

        if( !undefinedp(ingredient[idx]) ) {
                tell_object(me, "已经有" + idx + "这种原料存在了。\n");
                return;
        }

        if( !undefinedp(prescription[idx]) ) {
                tell_object(me, "已经有这种处方了，请先删除再编辑。\n");
                return;
        }

        if( undefinedp(production[idx]) ) {
                tell_object(me, "还没这种成品存在，请先编辑此成品。\n");
                return;
        }

        if( sizeof(production) < 2 ) {
                tell_object(me, "目前原料太少，请先增加原料。\n");
                return;
        }

        ingredients = keys(ingredient);

        msg = "目前有如下原料：\n";

        for( i = 0; i < sizeof(ingredients); i ++ )
                msg += sprintf("%4d：%-" + (40 + color_len(ingredient[ingredients[i]]["name"])) + "s 属性：%2s  等级： %d\n",
                                i + 1,
                                ingredient[ingredients[i]]["name"] + "(" + ingredients[i] + ")",
                                ingredient[ingredients[i]]["attribute"],
                                ingredient[ingredients[i]]["level"]);

        tell_object(me, msg + "请输入你的组合（数字以空格间开）：");
        input_to("finish_prescription", me, idx, ingredients);
}

void finish_prescription(string arg, object me, string idx, string *ingredients)
{
        string *select;

        select = explode(arg, " ");

        if( sizeof(select) < 2 ) {
                tell_object(me, "组合不能少于2个。\n请重新输入：");
                input_to("finish_prescription", me, idx, ingredients);
                return;
        }

        prescription[idx] = ({});

        foreach(string s in select) {
                int i;
                if( !( i = atoi(s) ) || i < 0 || i > sizeof(ingredients) ) {
                        tell_object(me, "输入必须是数字（以空格间隔开）。\n请重新输入：");
                        input_to("finish_prescription", me, idx, ingredients);
                        map_delete(prescription, idx);
                        return;
                }
                if( member_array(ingredients[i-1], prescription[idx]) == -1 )
                        prescription[idx] += ({ ingredients[i-1] });
        }

        if( save() )
                tell_object(me, "新的处方储存完毕。\n");
        else tell_object(me, "新的处方储存失败。\n");
}

/*******************************************************************************
                                  删除药物
********************************************************************************/

void delete_item(object me, string idx, int i)
{
        switch( i ) {
                case 1 :
                         if( undefinedp(ingredient[idx]) ) {
                                tell_object(me, "没有这种原料。\n");
                                break;
                         }

                         map_delete(ingredient, idx);
                         if( save() )
                                tell_object(me, "删除原料 " + idx + " 完毕。\n");
                         else tell_object(me, "删除原料 " + idx + " 失败。\n");
                         break;
                case 2 :
                         if( undefinedp(production[idx]) ) {
                                tell_object(me, "没有这种成品。\n");
                                break;
                         }

                         map_delete(production, idx);
                         if( save() )
                                tell_object(me, "删除成品 " + idx + " 完毕。\n");
                         else tell_object(me, "删除成品 " + idx + " 失败。\n");
                         break;
                case 3 :
                         if( undefinedp(prescription[idx]) ) {
                                tell_object(me, "没有这种成品。\n");
                                break;
                         }

                         map_delete(prescription, idx);
                         if( save() )
                                tell_object(me, "删除处方 " + idx + " 完毕。\n");
                         else tell_object(me, "删除处方 " + idx + " 失败。\n");
                         break;
                default : tell_object(me, "参数错误。\n");
                          break;
        }
}
