inherit ITEM;
#define MEDICINE_D         __DIR__"medicined"
int help();

void create() {
  set_name("药品编辑器", ({ "medicine edit", "edit" }));
  set("unit", "个");
  setup();
}

void init() {
  add_action("do_add", "add");
  add_action("do_del", "del");
}

string long() { help(); return ::long() + ""; }

int do_add(string arg) {
  object me = this_player();

  if (!arg)
    return help();

  if (sscanf(arg, "-i %s", arg) == 1) {
    MEDICINE_D->add_ingredient(me, arg);
    return 1;
  }

  if (sscanf(arg, "-p %s", arg) == 1) {
    MEDICINE_D->add_production(me, arg);
    return 1;
  }

  if (sscanf(arg, "-f %s", arg) == 1) {
    MEDICINE_D->add_prescription(me, arg);
    return 1;
  }

  return help();
}

int do_del(string arg) {
  object me = this_player();

  if (!arg)
    return help();

  if (sscanf(arg, "-i %s", arg) == 1) {
    MEDICINE_D->delete_item(me, arg, 1);
    return 1;
  }

  if (sscanf(arg, "-p %s", arg) == 1) {
    MEDICINE_D->delete_item(me, arg, 2);
    return 1;
  }

  if (sscanf(arg, "-f %s", arg) == 1) {
    MEDICINE_D->delete_item(me, arg, 3);
    return 1;
  }

  return help();
}


int help() {
  write(@HELP
1. add -i <英文名>   → 增加原料
2. add -p <英文名>   → 增加成品
3. add -f <英文名>   → 增加处方
4. del -i <英文名>   → 删除处方
5. del -p <英文名>   → 删除处方
6. del -f <英文名>   → 删除处方
HELP);
  return 1;
}
