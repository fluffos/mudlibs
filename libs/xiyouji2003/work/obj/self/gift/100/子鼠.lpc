#include <armor.h>
inherit OTHERS;

void create()
{
	set_name(YEL"神鼠铭牌"NOR, ({ "rat gift","shu", "gift", "rat"}));
	set_weight(3000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long",
WHT"
 ◢"NOR BWHT WHT"▁"NOR"    "BWHT WHT"▁"NOR WHT"◣"WHT"
 █"BBLU BLK"▁"NOR BWHT CYN"▏"NOR BWHT BLK" ."NOR BBLU HIW"◣"NOR BWHT BLK"▁"NOR" 
    "BWHT"▁▁▁"HIR"="NOR HIR"@="HIW" 
| ◢"BBLU"◤  ◥"NOR HIW"◣
 \\ "NOR BYEL" "NOR BBLU WHT"  ×  "NOR BYEL" "NOR"
 "BWHT BLK"◢"NOR BLK BWHT"█▃▃█◣"NOR"    [一块刻有子鼠生肖图案的寿辰铭牌]
\n");
	set("unit", "块");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("need_sx", "子鼠"); //不同属相不能装备标志
	set("material", "gold");
	set("Fmaterial", "gem");
	set("armor_prop/armor", 2);
	set("armor_prop/personality",1);
	set("armor_prop/dodge", 3);
	}
	setup();
}
