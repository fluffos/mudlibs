// 储存箱
#define DIABLO_OB "/u/waiwai/diablo/diablo_ob"
inherit F_SAVE;

mapping *diablo;

nosave object *diablo_obs;

nosave object owner;

object *query_diablo_obs() {return diablo_obs;}
mapping *query_diablo() {return diablo;}

string query_save_file()
{
        string id;

        if( !objectp( owner ) || !playerp(owner) || !stringp( id = getuid(owner) ) ) return 0;

        return sprintf(DATA_DIR "diablo/%c/%s", id[0], id);
}

void set_owner(object ob)
{
        owner = ob;
}

object query_owner() { return owner; }

object create_diablo(int i)
{
        object ob;

        if( sizeof(diablo_obs) != sizeof(diablo) ) {
                destruct(this_object());
                return 0;
        }

        if( i > sizeof(diablo) || i < 0 || !mapp(diablo[i-1]) ) return 0;

        i --;

        if( objectp(diablo_obs[i]) ) return 0;

        ob = new(DIABLO_OB);

        ob->set_entire_dbase(diablo[i]);
        ob->setup();
        diablo_obs[i] = ob;
        return ob;
}

int add_diablo(object ob)
{
        if( sizeof(diablo_obs) != sizeof(diablo) ) {
                destruct(this_object());
                return 0;
        }

        if( !ob->is_diablo() ) return 0;

        if( arrayp(diablo_obs) && sizeof(diablo_obs) > 0 && member_array(ob, diablo_obs) != -1 ) return 0;

        diablo_obs += ({ ob });
        diablo += ({ ob->query_entire_dbase() });
        return save();
}

int delete_diablo(object ob)
{
        int i;

        if( sizeof(diablo_obs) != sizeof(diablo) ) {
                destruct(this_object());
                return 0;
        }

        if( !ob->is_diablo() ) return 0;

        if( ( i = member_array(ob, diablo_obs) ) == -1 ) return 0;

        if( i == 0 ) {

                if( sizeof(diablo_obs) == 1 ) diablo_obs = ({});
                else diablo_obs = diablo_obs[1..sizeof(diablo_obs)-1];

                if( sizeof(diablo) == 1 ) diablo = ({});
                else diablo = diablo[1..sizeof(diablo)-1];

        } else if( i == sizeof(diablo_obs) - 1 ) {

                diablo_obs = diablo_obs[0..sizeof(diablo_obs)-2];

                diablo = diablo[0..sizeof(diablo)-2];
        } else {
                diablo_obs = diablo_obs[0..i-1] + diablo_obs[i+1..sizeof(diablo_obs)-1];
                diablo = diablo[0..i-1] + diablo[i+1..sizeof(diablo)-1];
        }

        return save();
}

void setup()
{
        if( restore() ) {
                int i;

                diablo -= ({ 0 });

                diablo_obs = ({});
                for(i = 0; i< sizeof(diablo); i++ )
                        diablo_obs += ({ 0 });
        } else {
                diablo_obs = ({});
                diablo = ({});
        }
}