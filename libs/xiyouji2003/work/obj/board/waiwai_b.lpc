#include <ansi.h>

inherit BULLETIN_BOARD;

void create()
{
	set_name(HIR"让往事飞"NOR, ({ "board" }) );
	set("location", "/u/waiwai/workroom");
	set("board_id", "waiwai_b");
	set("long",WHT"这是一块歪歪的杂记板，上面密密麻麻写满了一些难懂的词语。\n"NOR);
	setup();
	set("capacity", 500);
	replace_program(BULLETIN_BOARD);
}
