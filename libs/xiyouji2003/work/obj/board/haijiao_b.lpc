#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(WHT "天涯海角" NOR, ({ "board" }));
  set("location", "/d/tianpeng/tianya/eastwest.lpc");
  set("board_id", "haijiao_b");
  set("long", "这是一个矗立在天涯海角岸边的大牌子，上面记录着曾经到过这里的人的心事留言。\n");
  setup();
  set("capacity", 900);
}
