#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIR "天" HIY "若" HIB "有" HIW "情" HIC "天亦老" NOR, ({ "board" }));
  set("location", "/d/moon/ql");
  set("board_id", "yuelao_b");
  set("long", "这是一个供天下有情人交心的留言簿。\n");
  setup();
  set("capacity", 900);
}
