#include <ansi.h>
#include <armor.h>

inherit OTHERS;

void create()
{
  set_name(HBBLU HIY" 圣火徽章 "NOR, ({ "shenghuo huizhang", "huizhang","shenghuo" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
		set("no_give","拥有 "HBBLU HIG" 圣火徽章 "NOR" 代表了至高的荣誉，希望你要珍惜它！\n");
		set("no_put", HBBLU HIG" 圣火徽章 "NOR" 需要佩带，而不是私藏！\n");
		set("no_sell",HBBLU HIG" 圣火徽章 "NOR" 不允许做交易!\n");
		set("no_drop", "丢掉了 "HBBLU HIG" 圣火徽章 "NOR" 等于丢弃了荣誉！\n");
		set("no_break", 1);
		set("no_get", 1);
		set("combine", 1);
		set("value", 60000000);
              set("material", "crimsonsteel");
		set("armor_prop/armor", 3);
		set("armor_prop/parry", 10);
		set("long",HIC"一枚凝结着荣誉，友情，勇气，汗水，魄力，意志的 "HBBLU HIG" 圣火"HIY"徽章 \n"NOR);
              set("wear_msg","$N戴上一枚 "+this_object()->name()+" 不禁想起曾经浴血奋战的好兄弟！\n");
              set("remove_msg","$N将 "+this_object()->name()+" 轻轻地摘下来，又惦记起了那些好兄弟……\n");
  }
  setup();
}       
