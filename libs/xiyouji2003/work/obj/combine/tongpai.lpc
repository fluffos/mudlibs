//Created by waiwai@2002/01/31

#include <ansi.h>
#include <armor.h>

inherit OTHERS;

void create() {
  set_name(GRNWHI " 荣誉铜牌 " NOR, ({ "rongyu tongpai", "tongpai" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("no_give", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_break", 1);
    set("no_get", 1);
    set("combine", 1);
    set("value", 60000000);
    set("material", "copper");
    set("armor/max_armor", 10);
    set("armor_prop/armor", 10);
    set("armor_prop/parry", 10);
    set("long", HIC "一枚2001年度比武第三的 " GRNWHI " 荣誉铜牌 \n" NOR);
    set("wear_msg", "$N戴上一枚 " + this_object()->name() + " \n");
    set("remove_msg", "$N慎惜地将 " + this_object()->name() + " 轻轻摘了下来……\n");
  }
  setup();
}

int init() {
  add_action("do_wear", "wear");
  return 1;
}

int do_wear(string arg) {
  object me = this_player();
  object tong = this_object();
  string name = tong->query("name");
  string msg;

  if (arg != "rongyu tongpai")
    return notify_fail(WHT "你要配饰什么？\n" NOR);

  if (me->query("id") != "jms") destruct(tong);

  msg = "$N拿出一枚 " + name + " 小心地别在胸前.\n";
  tong->set("wear_msg", msg);

  if (me->query("id") == "jms") {
    if (!me->query("combine_tongpai")) me->set("combine_tongpai", 1);
  }

  return 0;
}
