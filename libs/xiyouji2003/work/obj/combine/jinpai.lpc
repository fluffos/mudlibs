#include <ansi.h>
#include <armor.h>

inherit OTHERS;

void create()
{
  set_name(YELRED" 荣誉金牌 "NOR, ({ "rongyu jinpai", "jinpai" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
		set("no_give",1);
		set("no_put", 1);
		set("no_sell",1);
		set("no_drop",1);
		set("no_break", 1);
		set("no_get", 1);
		set("combine", 1);
		set("value", 60000000);
              set("material", "gold");
		set("armor/max_armor", 30);
		set("armor_prop/armor", 30);
		set("armor_prop/parry", 30);
		set("long",HIC"一枚2001年度比武第一的 "YELRED" 荣誉金牌 \n"NOR);
              set("wear_msg","$N戴上一枚 "+this_object()->name()+" \n");
              set("remove_msg","$N慎惜地将 "+this_object()->name()+" 轻轻摘了下来……\n");
  }
  setup();
}       

int init()
{
        add_action("do_wear","wear");
        return 1;
}

int do_wear(string arg)
{
  object me = this_player();
  object jin = this_object();
  string name = jin->query("name");
  string msg;

   if( arg != "rongyu jinpai")
    return notify_fail(WHT"你要配饰什么？\n"NOR);

   if( me->query("id") != "cool") destruct(jin);

  msg = "$N拿出一枚 "+name+" 小心地别在胸前.\n"; 
  jin->set("wear_msg",msg);

  if( me->query("id") == "cool") {
  if( !me->query("combine_jinpai"))  me->set("combine_jinpai",1);}

  return 0;
}
