/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 披风
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+2，内力+50, 防御+60
**[/obj/user.c]
**    if(query("combine_armor/surcoat") ) {
**         armor = new("/obj/combine/surcoat");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
  set_name( HBMAG HIY " 紫罗袈裟 "NOR, ({ "ziluo-jiasha", "jiasha", "surcoat" }));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",MAG"一袭紫色的披风。\n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","袭");
  set("material", "silk");
  set("Fmaterial", "gem");
  set("armor/max_armor", 60);
  set("armor_prop/armor", 60);
  set("armor_prop/personality", 1);
  set("armor_prop/courage", 2);
  set("armor_prop/force", 50);
  set("wear_msg", "$N展开一袭 "HBMAG HIY" 紫罗袈裟 "NOR" 披在身上......\n");
  set("unequip_msg", "$N将一袭 "HBMAG HIY" 紫罗袈裟 "NOR" 从身上脱了下来，小心地折好。\n");
  }
  setup();
}


