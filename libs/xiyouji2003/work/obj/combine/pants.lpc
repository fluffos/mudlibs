/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 裤子
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+2，招架+30,  防御+30
**[/obj/user.c]
**    if(query("combine_armor/pants") ) {
**         armor = new("/obj/combine/pants");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit PANTS;

void create() {
  set_name(HBGRN HIB " 胡狼之吻 " NOR, ({ "hulang-kiss", "kiss", "pants" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIC "一条绣着一个胡狼图案的长裤，据说拥有的人都是无比的英勇。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_stock", 1);
    set("no_put", 1);
    set("no_putin", 1);
    set("no_putto", 1);
    set("deadfly", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "条");
    set("material", "fur");
    set("Fmaterial", "gem");
    set("armor/max_armor", 30);
    set("armor_prop/armor", 30);
    set("armor_prop/personality", 1);
    set("armor_prop/courage", 2);
    set("armor_prop/parry", 30);
    set("wear_msg", "$N穿上一条 " HBGRN HIB " 胡狼之吻 " NOR " 胡狼的啸声似乎在耳边响起......\n");
    set("unequip_msg", "$N将 " HBGRN HIB " 胡狼之吻 " NOR " 脱了下来。\n");
  }
  setup();
}
