/*Creat by waiwai@2000/11/28
**〖武器装备组合系统〗-- 战袍
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+2，招架+50, 防御+70
**[/obj/user.c]
**    if(query("combine_armor/cloth") ) {
**         armor = new("/obj/combine/cloth");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HBGRN HIR " 天使之翼 " NOR, ({ "tianshi-zhiyi", "tianshi", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIR "传说中的天使才能够拥有的衣服。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "件");
    set("material", "silk");
    set("armor/max_armor", 70);
    set("armor_prop/armor", 70);
    set("armor_prop/personality", 1);
    set("armor_prop/courage", 2);
    set("armor_prop/parry", 50);
    set("wear_msg", "$N穿上一件传说中的 " HBGRN HIR " 天使之翼 \n" NOR);
    set("unequip_msg", "$N将 " HBGRN HIR " 天使之翼 " NOR " 小心地脱了下来。\n");
  }
  setup();
}
