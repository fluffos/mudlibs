/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 戒指
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+1，法术+20, 防御+20
**[/obj/user.c]
**    if(query("combine_armor/finger") ) {
**         armor = new("/obj/combine/finger");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit FLOWER;

void create()
{
  set_name( HBYEL HIR" 来世今生 "NOR, ({ "world-ring", "finger", "ring" }));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",HIR"既不回头.何必不忘.既是无缘.何必誓言.今日种种.似水无痕.明夕何夕.卿已陌路. \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","枚");
  set("material", "gem");
  set("armor/max_armor", 20);
  set("armor_prop/armor", 20);
  set("armor_prop/personality", 1);
  set("armor_prop/courage", 1);
  set("armor_prop/spells", 20);
  set("wear_msg", "$N戴上了一枚 "HBYEL HIR" 来世今生 \n"NOR);
  set("unequip_msg", "$N将 "HBYEL HIR" 来世今生 "NOR" 小心地摘了下来。\n");
  }
  setup();
}


