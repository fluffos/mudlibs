#include <ansi.h>
#include <armor.h>

inherit OTHERS;

void create()
{
  set_name(HBRED HIW" 明薇金花 " NOR, ({ "mingwei flower", "flower", "mingwei","jinhua"}));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
  set("no_give",HBRED HIW" 明薇金花 "NOR" 需要你的珍惜！\n");
  set("no_put", HBRED HIW" 明薇金花 "NOR" 需要佩带，而不是私藏！\n");
  set("no_sell",HBRED HIW" 明薇金花 "NOR" 不允许做交易!\n");
  set("no_drop", "丢掉了 "HBRED HIW" 明薇金花 "NOR" 会象风儿没了方向！\n");
  set("no_break", 1);
  set("no_get", 1);
  set("combine", 1);
  set("value", 1);
   set("material", "flower");
  set("armor_prop/armor", 2);
  set("armor_prop/parry", 5);
  set("long",HIC"一朵娇艳的 "HBRED HIW"明薇金花"NOR HIC" 散发着一丝丝甜香。\n"NOR);
  set("wear_msg","$N戴上一朵 "+this_object()->name()+" 不禁想起曾经浴血奋战的好兄弟！\n");
  set("remove_msg","$N将 "+this_object()->name()+" 轻轻地摘下来，又惦记起了那些好兄弟……\n");
  }
  setup();
}       
