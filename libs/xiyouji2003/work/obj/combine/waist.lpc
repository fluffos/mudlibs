/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 腰带
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+2，力量+2, 防御+10
**[/obj/user.c]
**    if(query("combine_armor/waist") ) {
**         armor = new("/obj/combine/waist");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create() {
  set_name(HBBLU HIG " 一帘风月 " NOR, ({ "yilian-fengyue", "fengyue", "waist" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIB "一条带着晚月微风气息的腰带。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "条");
    set("material", "leather");
    set("Fmaterial", "gem");
    set("armor/max_armor", 10);
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 1);
    set("armor_prop/strength", 2);
    set("armor_prop/courage", 2);
    set("wear_msg", "$N将 " HBBLU HIG " 一帘风月 " NOR " 系在腰间......\n");
    set("unequip_msg", "$N摘下一条 " HBBLU HIG " 一帘风月 \n" NOR);
  }
  setup();
}
