/*Creat by waiwai@2000/11/28
**〖武器装备组合系统〗-- 头饰
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+5，勇气+1，法术+10, 防御+20
**[/obj/user.c]
**    if(query("combine_armor/flower") ) {
**         armor = new("/obj/combine/flower");
**         armor ->move(this_object());
**      }
*/

#include <ansi.h>
#include <armor.h>

inherit OTHERS;

void create() {
  set_name(HBRED HIG " 玛雅圣灵 " NOR, ({ "maya-shengling", "shengling", "flower" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "一朵娇艳的玛雅之花,传说是古玛雅人时代最漂亮的公主之物。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "朵");
    set("material", "stone");
    set("Fmaterial", "flower");
    set("armor/max_armor", 20);
    set("armor_prop/armor", 20);
    set("armor_prop/personality", 5);
    set("armor_prop/courage", 1);
    set("armor_prop/spells", 10);
    set("wear_msg", "$N戴上一朵娇艳的 " HBRED HIG " 玛雅圣灵 \n" NOR);
    set("unequip_msg", "$N将娇艳的 " HBRED HIG " 玛雅圣灵 " NOR " 从头上摘了下来,不禁陷入了远古的沉思。\n");
  }
  setup();
}
