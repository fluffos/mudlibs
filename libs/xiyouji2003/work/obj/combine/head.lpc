/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 头盔
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+1，法术+10, 防御+40
**[/obj/user.c]
**    if(query("combine_armor/head") ) {
**         armor = new("/obj/combine/head");
**         armor ->move(this_object());
**      }
*/

#include <ansi.h>
#include <armor.h>
inherit HEAD;

void create()
{
  set_name(HBCYN HIR" 绚烂晚霞 "NOR, ({ "xuanlan-wanxia", "head", "wanxia" }));
  set("weight", 200);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("long",HIR"一顶有着绚丽灿烂晚霞辉映的头盔。 \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","顶");
  set("material", "异类金属");
  set("armor/max_armor", 40);
  set("armor_prop/armor", 40);
  set("armor_prop/personality", 1);
  set("armor_prop/courage", 1);
  set("armor_prop/spells", 10);
  set("wear_msg", "$N戴上 "HBCYN HIR" 绚烂晚霞 "NOR
" 顿时如同晚霞一般绚丽灿烂的光辉辉映在$N的头顶......\n");
  set("unequip_msg", "$N将心爱的 "HBCYN HIR" 绚烂晚霞 "NOR" 小心摘了下来。\n");
  }
  setup();
}       
