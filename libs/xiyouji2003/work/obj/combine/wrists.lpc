/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 护腕
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1, 勇气+1, 招架+10, 力量+2,  防御+20
**[/obj/user.c]
**    if(query("combine_armor/wrists") ) {
**         armor = new("/obj/combine/wrists");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
  set_name( HBMAG HIG " 魔之妩媚 "NOR, ({ "mo-beauty", "wrists", "beauty", "wumei" }));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",HIB"一副神秘的护腕。 \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","副");
  set("material", "异类金属");
  set("Fmaterial", "gem");
  set("armor/max_armor", 20);
  set("armor_prop/armor", 20);
  set("armor_prop/personality", 1);
  set("armor_prop/strength", 2);
  set("armor_prop/courage", 1);
  set("armor_prop/parry", 10);
  set("wear_msg", "$N拿出一副 "HBMAG HIG" 魔之妩媚 "NOR
" 戴在了双腕上......\n"NOR);
  set("unequip_msg", "$N将 "HBMAG HIG" 魔之妩媚 "NOR" 从手腕上摘了下来。\n");
  }
  setup();
}


