/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 鞋子
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+1，轻功+100, 灵性+2, 防御+30
**[/obj/user.c]
**    if(query("combine_armor/boots") ) {
**         armor = new("/obj/combine/boots");
**         armor ->move(this_object());
**      }
*/

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HBBLU HIW " 飞天雪履 " NOR, ({ "sky-boots", "xuelu", "boots" }));
  set("weight", 300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "一双传说中的鞋子,轻如鸿毛，软如丝绵。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "双");
    set("material", "fur");
    set("armor/max_armor", 30);
    set("armor_prop/armor", 30);
    set("armor_prop/personality", 1);
    set("armor_prop/spirituality", 2);
    set("armor_prop/courage", 1);
    set("armor_prop/dodge", 100);
    set("wear_msg", "$N登上一双 " HBBLU HIW " 飞天雪履 " NOR " 顿时一股神秘的力量直冲云霄......\n");
    set("unequip_msg", "$N将 " HBBLU HIW " 流星之光 " NOR " 小心脱了下来。\n");
  }
  setup();
}
