//Created by waiwai@2002/01/31

#include <ansi.h>
#include <armor.h>

inherit NECK;

void create() {
  set_name(REDWHI " 荣誉银牌 " NOR, ({ "rongyu yinpai", "yinpai" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("no_give", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_break", 1);
    set("no_get", 1);
    set("combine", 1);
    set("value", 60000000);
    set("material", "silver");
    set("armor/max_armor", 20);
    set("armor_prop/armor", 20);
    set("armor_prop/parry", 20);
    set("long", HIC "一枚2001年度比武第二的 " REDWHI " 荣誉银牌 \n" NOR);
    set("wear_msg", "$N戴上一枚 " + this_object()->name() + " \n");
    set("remove_msg", "$N慎惜地将 " + this_object()->name() + " 轻轻摘了下来……\n");
  }
  setup();
}

int init() {
  add_action("do_wear", "wear");
  return 1;
}

int do_wear(string arg) {
  object me = this_player();
  object yin = this_object();
  string name = yin->query("name");
  string msg;

  if (arg != "rongyu yinpai")
    return notify_fail(WHT "你要配饰什么？\n" NOR);

  if (me->query("id") != "fxpl") destruct(yin);

  msg = "$N拿出一枚 " + name + " 小心地别在胸前.\n";
  yin->set("wear_msg", msg);

  if (me->query("id") == "fxpl") {
    if (!me->query("combine_yinpai")) me->set("combine_yinpai", 1);
  }

  return 0;
}
