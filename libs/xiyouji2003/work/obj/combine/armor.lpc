/*Created by waiwai@2000/11/28
**〖武器装备组合系统〗-- 甲衣
**力量(strength-str),勇气(courage-cor),悟性(intelligence-int),灵性(spirituality-spi)
**定力(composure-cps),魅力(personality-per),根骨(constitution-con),福缘(karma-kar)
**魅力+1，勇气+2，招架+50, 根骨+2, 防御+90
**[/obj/user.c]
**    if(query("combine_armor/armor") ) {
**         armor = new("/obj/combine/armor");
**         armor ->move(this_object());
**      }
*/

#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create() {
  set_name(HBRED HIG " 日月之铠 " NOR, ({ "riyue-armor", "armor" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "一套金制的铠甲,上面镶嵌着五彩的宝石,烁烁生辉。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 1);
    set("unit", "套");
    set("material", "异类金属");
    set("armor/max_armor", 90);
    set("armor_prop/armor", 90);
    set("armor_prop/personality", 1);
    set("armor_prop/constitution", 2);
    set("armor_prop/courage", 2);
    set("armor_prop/parry", 50);
    set("wear_msg", "$N穿上一套 " HBRED HIG " 日月之铠 " NOR " 其四射的芒光足以与日月争辉......\n");
    set("unequip_msg", "$N脱下了 " HBRED HIG " 日月之铠 \n" NOR);
  }
  setup();
}
