// Created by waiwai@2000/11/28
//〖武器装备组合系统〗

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name(HIB "亡命天涯" NOR, ({ "good blade", "blade" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("rigidity", 50);
    set("sharp", 200);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_break", 1);
    set("combine", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("des", 1);
    set("hide", 1);
    set("value", 500000);
    set("unit", "把");
    set("material", "blacksteel");
    set("Fmaterial", "crystal");
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 10);
    set("long", "一把由" CYN "伏羲玄铁" HIB "蓝水晶" NOR YEL "崆峒枯木" NOR "合成的神刀,只有靠自己的勇气才能得到 ----
也许能合并 " HIR "(combine) " NOR "成一把更好的宝刀！\n" NOR);
    set("wield_msg", HIW "$N刷地抽出了一把$n" HIW "，一道霞光过后，$N狂叫道：亡命天涯一出,谁与争锋！\n" NOR);
    set("unwield_msg", WHT "$N收起了$n" WHT "，欢声叫道：亡命天涯所向披靡！\n" NOR);
  }
  init_blade(100, TWO_HANDED);
  setup();
}

void init() {
  if (this_player() == environment()) {
    add_action("hide_anywhere", "hide");
    add_action("do_combine", "combine");
  }
}

int hide_anywhere(object me, object item) {
  me = this_player();
  item = this_object();

  if (!wizardp(me))
    if (item->query("owner_id") != me->query("id"))
      return 0;

  if (me->query("mana") < 100) {
    tell_object(me, "你试图令" + item->name() +
      "遁去，可是法力不济，难以发挥它的能力。\n");
    return 0;
  }
  me->add("mana", -100);

  message_vision(HIM "$N" HIM "轻轻一旋" + item->name() +
    HIM "，已然了无踪迹。\n" NOR, me);
  destruct(item);
  return 1;
}

int do_combine() {
  object me, a, b, c, d, blade;
  me = this_player();
  a = this_object();

  if (!wizardp(me) && userp(me)) {
    if (a->query("equipped"))
      return notify_fail("你必须放下武器才行。\n");

    if (!environment(me)->query("cold"))
      return notify_fail("此地灵气不够，无法合并物品。\n");

    if ((int)me->query("force") < (int)me->query("max_force"))
      return notify_fail("你的内力不足，很难将物品合并。\n");

    if ((int)me->query("mana") < (int)me->query("max_mana"))
      return notify_fail("你的法力不足以支持合并物品。\n");
  }

  if (!(b = present("liuyun-fuyin", me)))
    return notify_fail(CYN "你将手中 " HIB "亡命天涯 " NOR CYN "摆弄了几下，却一点反应也没有。\n" NOR);

  if (!(c = present("qicai-xiapei", me)))
    return notify_fail(CYN "你将手中 " HIB "亡命天涯 " NOR CYN "摆弄了几下，却一点反应也没有。\n" NOR);

  if (!(d = present("hunyuan-jindou", me)))
    return notify_fail(CYN "你将手中 " HIB "亡命天涯 " NOR CYN "摆弄了几下，却一点反应也没有。\n" NOR);

  if (blade = new("/obj/combine/weapon/blade/blade-2")) {
    if (me->query_encumbrance() + blade->query_weight()
      > me->query_max_encumbrance())
      return notify_fail("你的负重过高不能合并物品。\n");
    destruct(b);
    destruct(c);
    destruct(d);
    blade->move(me);
    me->set("combine_blade2", 1);
    me->delete("combine_blade1");
    me->save();
    me->start_busy(3);
    message_vision(
      WHT "$N将手中的" HIG "流云符印" HIR "七彩霞配" HIY "混元金斗" NOR WHT "轻轻的摆在" HIG "亡命天涯" NOR WHT "周围,
只见几道耀眼霞光掠过,手中" HIG "亡命天涯" NOR WHT "颤动不以...... \n" NOR,
      me
    );

    destruct(a);
  }
  return 1;
}
