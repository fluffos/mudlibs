//Created by waiwai@2000/11/28
//〖武器装备组合系统〗

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

object offensive_target(object me);

void create()
{
  set_name(HIW"亡命天涯"NOR, ({"good blade", "blade"}));
  set_weight(1000);
  if( clonep() )
                set_default_object(__FILE__);
   else {
		set("rigidity",300);
		set("sharp",500);
		set("no_drop",1);
		set("no_put",1);
		set("no_break",1);
		set("combine",1);
		set("no_give",1);
		set("no_sell",1);
		set("no_steal",1);
		set("value",500000);
		set("unit","把");
              set("material", "blacksteel");
              set("Fmaterial", "crystal");
              set("weapon_prop/parry",50);
              set("weapon_prop/blade",50);
		set("long", "一把由"HIR"亡命天涯"NOR"加涂"HIR"恶龙之血"NOR"的绝世好刀,只有靠自己的勇气才能得到！！！\n"NOR);
     }
  init_blade(300,TWO_HANDED);
  setup();
}

int init()
{
        add_action("do_wield","wield");
        add_action("do_unwield", "unwield");
        return 1;
}

object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_wield(string arg)
{
  object me = this_player();
  object blade = this_object();
  string name = blade ->query("name");
  string msg;

   if( arg != "blade" && arg != "good blade")
    return notify_fail("你要装备什么武器？\n");

  msg = HIY"$N抽出了$n "HIY"一道霞光过后，$N狂叫道：亡命天涯一出,谁与争锋 ----\n"NOR; 
  blade->set("wield_msg",msg);
  remove_call_out("blade");
  call_out("blade",1,me,blade);
  return 0;
}

int do_unwield(string arg)
{
  object me = this_player();
  object blade = this_object();
  string name = blade ->query("name");
  string msg;

  if( arg != "blade" && arg != "good blade")
    return notify_fail("你要卸掉什么武器？\n");

  msg = "$N收起了 "+name+" 欢声叫道：亡命天涯所向披靡……\n"; 
  blade->set("unwield_msg",msg);
  remove_call_out("blade");
  return 0;
}

void sword(object who,object ob)
{
     object target,weapon;
     int damage,skill;
     string msg;

     skill = who->query_skill("blade",1);

  if (!objectp(weapon = who->query_temp("weapon")) ) return;

  if( who->is_fighting())
     {
        target = offensive_target(who);
        if( ! target ) return ;

  if( ! present( target,environment(who)) ) return ; 
   
        msg = HIW"\n"+weapon->name()+HIY"冉冉升起一道无形的白光，在$n"HIY"的头上如同贯日般的直劈而下！\n"NOR;

	if( random(who->query("combat_exp")) > (int)target->query("combat_exp")/3) {
             damage = skill*2+random(skill*2);
             damage -= random((int)target->query_skill("force"));
             if( damage > 0 ) {
                  msg += HIR"\n结果$n"HIR"躲避不及，被"+weapon->name()+HIR"的贯日之光射穿！\n\n"NOR;
                       target->receive_damage("kee", damage);
                       target->receive_wound("kee", damage/2);
                  } 
            else
                msg += HIC"\n谁知却被$n"HIC"躲开了。\n" NOR;   
                }
                else
                        msg += HIC"\n但是却被$n"HIC"躲开了。\n"NOR;

                message_vision(msg, who, target); 
        }
remove_call_out("blade");
call_out("blade",7,who,ob);
}
