//Created by waiwai@2000/11/28
//〖武器装备组合系统〗

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
  set_name(HIG"亡命天涯"NOR, ({"good blade", "blade"}));
  set_weight(1000);
  if( clonep() )
                set_default_object(__FILE__);
   else {
		set("rigidity",100);
		set("sharp",250);
		set("no_drop",1);
		set("no_put",1);
		set("no_break",1);
		set("combine",1);
		set("no_give",1);
		set("no_sell",1);
		set("no_steal",1);
		set("value",500000);
		set("unit","把");
              set("material", "blacksteel");
              set("Fmaterial", "crystal");
              set("weapon_prop/parry",20);
              set("weapon_prop/blade",20);
		set("long", "一把由"HIG"流云符印"HIR"七彩霞配"HIY"混元金斗"NOR"合成的神刀,只有靠自己的勇气才能得到 ----
也许能合并 "HIR"(combine) "NOR"成一把更好的宝刀！\n"NOR);
              set("wield_msg", "$N抽出了$n，一道霞光过后，$N狂叫道：亡命天涯一出,谁与争锋！\n");
              set("unwield_msg", "$N收起了$n，欢声叫道：亡命天涯所向披靡！\n");
     }
  init_blade(150,TWO_HANDED);
  setup();
}

void init() {	add_action("do_combine","combine"); }

int do_combine()
{
	object me,a,b,c,blade;
	me=this_player();
	a=this_object();

	if( !wizardp(me) && userp(me) ) {
       if( a->query("equipped") )
             return notify_fail("你必须放下武器才行。\n");

       if(!environment(me)->query("cold"))
             return notify_fail("此地灵气不够，无法合并物品。\n");

	if( (int)me->query("force") < (int)me->query("max_force") )
		return notify_fail("你的内力不足，很难将物品合并。\n");

	if( (int)me->query("mana") < (int)me->query("max_mana") )
		return notify_fail("你的法力不足以支持合并物品。\n");
       }

       if ( !(b=present("red&blue-ice",me)))
                return notify_fail(CYN"你将手中 "HIG"亡命天涯 "NOR CYN"摆弄了几下，却一点反应也没有。\n"NOR);

       if ( !(c=present("fire-ling",me)))
                return notify_fail(CYN"你将手中 "HIG"亡命天涯 "NOR CYN"摆弄了几下，却一点反应也没有。\n"NOR);

	if( blade=new("/d/diablo/combine/blade/blade-3")){
		if( me->query_encumbrance() + blade->query_weight()
			> me->query_max_encumbrance())
		return notify_fail("你的负重过高不能合并物品。\n");
		destruct(b);
		destruct(c);
	blade->move(me);
	me->set("combine_blade3",1);
	me->delete("combine_blade2");
	me->save();
	me->start_busy(3);
	message_vision(WHT"$N将手中的"HIR"双"HIB"色"HIW"玄冰"HIR"火之灵"NOR WHT"轻轻的放在"HIR"亡命天涯"NOR WHT"之上,
一阵轻烟掠过,手中"HIR"亡命天涯"NOR WHT"颤动不以...... \n"NOR,me);

	destruct(a);
	}
	return 1;
}
