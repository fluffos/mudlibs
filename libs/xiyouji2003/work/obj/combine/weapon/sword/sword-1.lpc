//〖武器装备组合系统〗

#include <weapon.h>
#include <ansi.h>
inherit F_NOCLONE;

inherit SWORD;

void create() {
  set_name(HIB "长虹贯日" NOR, ({ "good sword", "sword" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("rigidity", 50);
    set("sharp", 200);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_break", 1);
    set("combine", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("des", 1);
    set("hide", 1);
    set("value", 500000);
    set("unit", "把");
    set("material", "blacksteel");
    set("Fmaterial", "crystal");
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 10);
    set("long", "一把由" CYN "伏羲玄铁" HIM "女娲石" NOR YEL "崆峒枯木" NOR "合成的神剑,只有靠自己的勇气才能得到 ----
" WHT "
                            【　　　　
　　             　" HIM "◎" NOR YEL "■■■■" NOR WHT "】" NOR CYN "〓〓〓〓〓〓〓〓〓〓〓〓〓〓>" NOR RED "
                  #         " NOR WHT "【" NOR RED "　
                 #
　       　　   #　　　　　　　

" NOR "也许能合并" HIR "(combine)" NOR "成一把更好的宝剑！！！\n" NOR);

    set("wield_msg", HIY "$N手一挥一道霞光过后，$N狂叫道：长虹贯日出 ----
" NOR WHT "
                            【　　　　
　　             　" HIM "◎" NOR YEL "■■■■" NOR WHT "】" NOR CYN "〓〓〓〓〓〓〓〓〓〓〓〓〓〓>" NOR RED "
                  #         " NOR WHT "【" NOR RED "　
                 #
　       　　   #　　　　　　　
\n" NOR);
    set("unwield_msg", WHT "$N缓缓放下了手中的$n" WHT "，欢声叫道：长虹贯日所向披靡～～～\n" NOR);
  }
  init_sword(100, TWO_HANDED);
  setup();
}

void init() {
  if (this_player() == environment()) {
    add_action("hide_anywhere", "hide");
    add_action("do_combine", "combine");
  }
}

int hide_anywhere(object me, object item) {
  me = this_player();
  item = this_object();

  if (!wizardp(me))
    if (item->query("owner_id") != me->query("id"))
      return 0;

  if (me->query("mana") < 100) {
    tell_object(me, "你试图令" + item->name() +
      "遁去，可是法力不济，难以发挥它的能力。\n");
    return 0;
  }
  me->add("mana", -100);

  message_vision(HIM "$N" HIM "轻轻一旋" + item->name() +
    HIM "，已然了无踪迹。\n" NOR, me);
  destruct(item);
  return 1;
}

