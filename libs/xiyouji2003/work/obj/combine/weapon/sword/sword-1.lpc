int do_combine() {
  object me, a, b, sword;
  me = this_player();
  a = this_object();

  if (!wizardp(me) && userp(me)) {
    if (a->query("equipped"))
      return notify_fail("你必须放下武器才行。\n");

    if (!environment(me)->query("cold"))
      return notify_fail("此地灵气不够，无法合并物品。\n");

    if ((int)me->query("force") < (int)me->query("max_force"))
      return notify_fail("你的内力不足，很难将物品合并。\n");

    if ((int)me->query("mana") < (int)me->query("max_mana"))
      return notify_fail("你的法力不足以支持合并物品。\n");
  }

  if (!(b = present("five-xing", me)))
    return notify_fail(CYN "你将手中 " HIB "长虹贯日 " NOR CYN "摆弄了几下，却一点反应也没有。\n" NOR);

  if (sword = new("/obj/combine/weapon/sword/sword-2")) {
    if (me->query_encumbrance() + sword->query_weight()
      > me->query_max_encumbrance())
      return notify_fail("你的负重过高不能合并物品。\n");
    destruct(b);
    sword->move(me);
    me->set("combine_sword2", 1);
    me->delete("combine_sword1");
    me->save();
    me->start_busy(3);
    message_vision(WHT "$N将手中的" HIG "五" HIY "行" HIR "之" HIB "星" NOR WHT "轻轻的往" HIB "长虹贯日" NOR WHT "上镶去
只见几道耀眼霞光掠过,手中" HIG "长虹贯日" NOR WHT "颤动不以 ----

                            " WHT "【　　　　
　　             　" HIM "◎" NOR YEL "■■■■" NOR WHT "】" HIB "〓" HIG "〓" HIB "〓" HIG "〓" HIB "〓" HIG "〓" HIB
      "〓" HIG "〓" HIB "〓" HIG "〓" HIB "〓〓〓〓>" NOR RED "
                  #         " NOR WHT "【" NOR RED "　
                 #
　       　　   #　　　　　　　
\n" NOR, me);
    destruct(a);
  }
  return 1;
}
