//〖武器装备组合系统〗

#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create()
{
	set_name(HIB "盘龙神棍" NOR, ({"good stick", "stick"}));
	set_weight(12000);
	if( clonep() )
       set_default_object(__FILE__);
             else {
		set("rigidity",50);
		set("sharp",200);
		set("no_drop",1);
		set("no_put",1);
		set("no_break",1);
		set("combine",1);
		set("no_give",1);
		set("no_sell",1);
		set("des",1);
		set("hide",1);
		set("value",500000);
		set("unit","根");
              set("material", "blacksteel");
              set("Fmaterial", "crystal");
              set("weapon_prop/dodge",10);
              set("weapon_prop/parry",10);
		set("long", "一根由"CYN"伏羲玄铁"HIC"青水晶"NOR YEL"崆峒枯木"NOR"合成的闪耀着光芒的盘龙神棍,只有靠自己的勇气才能得到 ----
也许能合并 "HIR"(combine) "NOR"成一把更好的神棍！\n"NOR);
              set("wield_msg", HIG"突然周围闪出一道耀眼的"HIY"金光"HIG"，$N从背后抽出了一根$n \n"NOR);
              set("unwield_msg", HIG"$N长舒一口气，缓缓收起了$n"HIG"，"HIY"金光"HIG"绕体流转不停！\n"NOR);
     		}
		init_stick(100,TWO_HANDED);
		setup();
}

void init() 
{	
	if( this_player()==environment() ) {
	add_action("hide_anywhere","hide"); 
	add_action("do_combine","combine");
	} 
}

int hide_anywhere(object me, object item)
{
	me=this_player();
	item=this_object();

	if( !wizardp(me) )
        if (item->query("owner_id") != me->query("id"))
                return 0;

        if (me->query("mana") < 100) {
                tell_object(me, "你试图令" + item->name() +
                            "遁去，可是法力不济，难以发挥它的能力。\n");
                return 0;
        }
        me->add("mana", -100);

        message_vision(HIM "$N" HIM "轻轻一旋" + item->name() +
                       HIM "，已然了无踪迹。\n"NOR, me);
        destruct(item);
        return 1;
}

int do_combine()
{
	object me,a,b,c,d,staff;
	me=this_player();
	a=this_object();

	if( !wizardp(me) && userp(me) ) {
       if( a->query("equipped") )
             return notify_fail("你必须放下武器才行。\n");

       if(!environment(me)->query("cold"))
             return notify_fail("此地灵气不够，无法合并物品。\n");

	if( (int)me->query("force") < (int)me->query("max_force") )
		return notify_fail("你的内力不足，很难将物品合并。\n");

	if( (int)me->query("mana") < (int)me->query("max_mana") )
		return notify_fail("你的法力不足以支持合并物品。\n");
       }

       if ( !(b=present("liuyun-fuyin",me)))
                return notify_fail(CYN"你将手中 "HIB"盘龙神棍 "NOR CYN"摆弄了几下，却一点反应也没有。\n"NOR);

       if ( !(c=present("qicai-xiapei",me)))
                return notify_fail(CYN"你将手中 "HIB"盘龙神棍 "NOR CYN"摆弄了几下，却一点反应也没有。\n"NOR);

       if ( !(d=present("hunyuan-jindou",me)))
                return notify_fail(CYN"你将手中 "HIB"盘龙神棍 "NOR CYN"摆弄了几下，却一点反应也没有。\n"NOR);

	if( staff=new("/obj/combine/weapon/stick/stick-2")){
		if( me->query_encumbrance() + staff->query_weight()
			> me->query_max_encumbrance())
		return notify_fail("你的负重过高不能合并物品。\n");
		destruct(b);
		destruct(c);
		destruct(d);
	staff->move(me);
	me->set("combine_stick2",1);
	me->delete("combine_stick1");
	me->save();
	me->start_busy(3);
	message_vision(WHT"$N将手中的"HIG"流云符印"HIR"七彩霞配"HIY"混元金斗"NOR WHT"轻轻的摆在"HIB"金刚降魔"NOR WHT"周围,
只见几道耀眼霞光掠过,手中"HIG"金刚降魔"NOR WHT"金光流转不停...... \n"NOR,me);

	destruct(a);
	}
	return 1;
}

