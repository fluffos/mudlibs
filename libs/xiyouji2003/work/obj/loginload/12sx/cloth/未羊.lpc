#include <armor.h>
inherit CLOTH;

void create()
{
	set_name("火羊外衣", ({ "sheep cloth", "yang", "sheep", "cloth"}));
	set_weight(3000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long",
CYN"
   ◢◢"HIW"     
 ◢"BWHT BLK" . "NOR HIW"◣"NOR"     
 "BWHT RED"〞    "NOR HIW"         
  ◢"NOR BWHT BLK"╱    "NOR HIW"◣/"NOR"
  "BWHT BLK"▕  ▁"NOR HIW"     
  ◤◤ ◥ ◥"NOR"    [一件绣有未羊生肖图案的外衣]
\n");
	set("unit", "件");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("need_sx", "未羊"); //不同属相不能装备标志
	set("material", "cloth");
	set("Fmaterial", "silk");
	set("armor_prop/armor", 5);
	set("armor_prop/personality",1);
	}
	setup();
}
