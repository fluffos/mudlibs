//十二生肖装备之新人靴子

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

string *names = ({
  CYN"神鼠长靴"NOR,
  CYN"蛮牛长靴"NOR,
  CYN"雷虎长靴"NOR,
  CYN"玉兔长靴"NOR,
  CYN"青龙长靴"NOR,
  CYN"蟒蛇长靴"NOR,
  CYN"骏马长靴"NOR,
  CYN"火羊长靴"NOR,
  CYN"石猴长靴"NOR,
  CYN"金鸡长靴"NOR,
  CYN"天狗长靴"NOR,
  CYN"花猪长靴"NOR,
});

string *ids = ({
	"rat boots",
	"ox boots",
	"tiger boots",
	"rabbit boots",
	"dragon boots",
	"snake boots",
	"house boots",
	"sheep boots",
	"monkey boots",
	"cock boots",
	"dog boots",
	"pig boots"
});

void create()
{
	int i = random(sizeof(names));
	set_name(names[i], ({ids[i],  "boots"}));
	set_weight(5000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long","一件绣有十二生肖图案的长靴。\n");
	set("unit", "件");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_putto", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("material", "cloth");
	set("Fmaterial", "silk");
	set("armor_prop/armor", 5);
	set("armor_prop/personality",1);
	}
	setup();
}

