// 十二生肖装备之石猴长裤

#include <armor.h>
inherit PANTS;

void create() {
  set_name("石猴长裤", ({ "monkey pants", "hou", "monkey", "pants" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "
   ◢" BYEL HIW "▄▄" NOR HIY "◣" NOR "   
  " HIW "(" NOR BWHT BLK "  .  .  " NOR HIW ")" NOR "  
  " BYEL BLK "▔" NOR BWHT BLK " /..\\ " BYEL "▔" NOR "  
  " HIY "◥" NOR BWHT HIR " (＝) " NOR HIY "◤" NOR "  
  " HIY "█" NOR BWHT BLK "▏  ▕" NOR HIY "█" NOR "  
  " HIY "◥" NOR BWHT HIY "◣" BLK "×" HIY "◢" NOR HIY "◤" HIR "~~~" NOR "    [一件绣有申猴生肖图案的长裤]
\n");
    set("unit", "件");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "申猴");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 1);
  }
  setup();
}
