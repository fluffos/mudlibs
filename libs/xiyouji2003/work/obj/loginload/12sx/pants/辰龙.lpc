// 十二生肖装备之青龙长裤

#include <armor.h>
inherit PANTS;

void create() {
  set_name("青龙长裤", ({ "dragon pants", "long", "dragon", "pants" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "
   ◢    ◣  
   ◥◣◢◤   
  ◥" NOR BYEL " " NOR BWHT BLK ".\\/." NOR BYEL " " NOR HIY "◤  
 " HIR "__" HIY "◥" NOR BWHT BLK " ≡ " NOR HIY "◤" HIR "__ 
" HIC "◢" BCYN "◣" NOR HIY "◥" NOR BWHT ".." NOR HIY "◤" NOR HIC BCYN "◢" NOR HIC "◣
" HIW "▼▼" HIY "﹋  ﹋" HIW "▼▼" NOR "    [一件绣有辰龙生肖图案的长裤]
\n");
    set("unit", "件");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "辰龙");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 1);
  }
  setup();
}
