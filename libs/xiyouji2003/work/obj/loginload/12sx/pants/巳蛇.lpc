// 十二生肖装备之蟒蛇长裤

#include <armor.h>
inherit PANTS;

void create() {
  set_name("蟒蛇长裤", ({ "snake pants", "she", "snake", "pants" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIR "
  ∩           
" HIW "◢" NOR BWHT "   " NOR HIW "◣" NOR RED "  ╲    
" HIR "` /" NOR WHT "◤" RED "◥" BWHT "╲" NOR WHT "◣" NOR RED "╲  
       ◥" NOR BWHT "╲" NOR RED "  ▎
 ◢" NOR BGRN RED "◥" NOR GRN "◣" NOR WHT "◢" RED "◤  ▌
 " HIW "◥" NOR BWHT RED "◣◣" NOR BGRN RED "◤ ◣" RED "◤" NOR "     [一件绣有巳蛇生肖图案的长裤]
\n");
    set("unit", "件");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "巳蛇");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 1);
  }
  setup();
}
