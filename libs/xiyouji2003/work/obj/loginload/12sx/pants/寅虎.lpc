// 十二生肖装备之雷虎长裤

#include <armor.h>
inherit PANTS;

void create() {
  set_name("雷虎长裤", ({ "tiger pants", "hu", "tiger", "pants" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      YEL "
   ◣  ◢   
 ◢" BYEL BLK " .~~. " NOR YEL "◣ 
◢" NOR BYEL BLK "≡" BWHT RED "◥◤" BYEL BLK "≡" NOR YEL "◣" HIY "
 ◥" BWHT HIY "◣" BLK "∣" BWHT HIY "◢" NOR HIY "◤" HIW " 
 ◢" HIY "▆" BYEL "  " NOR HIY "▆" HIW "◣ 
 ``" NOR BYEL YEL "▆" BLK BYEL "×" NOR BYEL YEL "▆" NOR HIW "''" NOR "    [一件绣有寅虎生肖图案的长裤]
\n");
    set("unit", "件");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "寅虎");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 1);
  }
  setup();
}
