// 十二生肖装备之神鼠长裤

#include <armor.h>
inherit PANTS;

void create() {
  set_name("神鼠长裤", ({ "rat pants", "shu", "rat", "pants" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      WHT "
 ◢" NOR BWHT WHT "▁" NOR "    " BWHT WHT "▁" NOR WHT "◣" WHT "
 █" BBLU BLK "▁" NOR BWHT CYN "▏" NOR BWHT BLK " ." NOR BBLU HIW "◣" NOR BWHT BLK "▁" NOR " 
    " BWHT "▁▁▁" HIR "=" NOR HIR "@=" HIW " 
| ◢" BBLU "◤  ◥" NOR HIW "◣
 \\ " NOR BYEL " " NOR BBLU WHT "  ×  " NOR BYEL " " NOR "
 " BWHT BLK "◢" NOR BLK BWHT "█▃▃█◣" NOR "    [一件绣有子鼠生肖图案的长裤]
\n");
    set("unit", "件");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "子鼠");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "silk");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 1);
  }
  setup();
}
