// 十二生肖装备之青龙之靴

#include <armor.h>
inherit BOOTS;

void create() {
  set_name("青龙之靴", ({ "dragon boots", "long", "xue", "boots" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "
   ◢    ◣  
   ◥◣◢◤   
  ◥" NOR BYEL " " NOR BWHT BLK ".\\/." NOR BYEL " " NOR HIY "◤  
 " HIR "__" HIY "◥" NOR BWHT BLK " ≡ " NOR HIY "◤" HIR "__ 
" HIC "◢" BCYN "◣" NOR HIY "◥" NOR BWHT ".." NOR HIY "◤" NOR HIC BCYN "◢" NOR HIC "◣
" HIW "▼▼" HIY "﹋  ﹋" HIW "▼▼" NOR "    [一双绣有辰龙生肖图案的靴子]
\n");
    set("unit", "双");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "辰龙");  //不同属相不能装备标志
    set("material", "cloth");
    set("Fmaterial", "fur");
    set("armor_prop/armor", 2);
    set("armor_prop/personality", 1);
    set("armor_prop/dodge", 3);
  }
  setup();
}
