// 十二生肖装备之火羊之靴

#include <armor.h>
inherit BOOTS;

void create() {
  set_name("火羊之靴", ({ "sheep boots", "xue", "sheep", "boots" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      CYN "
   ◢◢" HIW "     
 ◢" BWHT BLK " . " NOR HIW "◣" NOR "     
 " BWHT RED "〞    " NOR HIW "         
  ◢" NOR BWHT BLK "╱    " NOR HIW "◣/" NOR "
  " BWHT BLK "▕  ▁" NOR HIW "     
  ◤◤ ◥ ◥" NOR "    [一双绣有未羊生肖图案的靴子]
\n");
    set("unit", "双");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "未羊");  //不同属相不能装备标志
    set("material", "gold");
    set("Fmaterial", "gem");
    set("armor_prop/armor", 2);
    set("armor_prop/personality", 1);
    set("armor_prop/dodge", 3);
  }
  setup();
}
