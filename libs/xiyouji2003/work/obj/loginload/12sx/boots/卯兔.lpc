// 十二生肖装备之玉兔之靴

#include <armor.h>
inherit BOOTS;

void create() {
  set_name("玉兔之靴", ({ "rabbit boots", "xue", "rabbit", "boots" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIW "
  ◢█  █◣" NOR "
    " BWHT RED "▌" NOR "  " BRED WHT "▌" NOR HIW " 
  ◢" NOR BWHT YEL "▔" HIR ".." NOR BWHT YEL "▔" NOR HIW "◣
  ◢" NOR BWHT HIR "≡●≡" NOR HIW "◣
   (" NOR BMAG YEL "▕" NOR BWHT YEL "∣" NOR BMAG YEL "▏" NOR HIW ")  
◢" NOR BWHT YEL "▕" NOR BMAG HIW ",," NOR "  " BMAG HIW ",," NOR BWHT YEL "▏" NOR HIW "◣" NOR "    [一双绣有卯兔生肖图案的靴子]
\n");
    set("unit", "双");
    set("value", 500);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_putin", 1);
    set("no_stock", 1);  //不能放到黑店
    set("deadfly", 1);  //死亡时自动飞掉(destruct)标志
    set("need_sx", "卯兔");  //不同属相不能装备标志
    set("material", "gold");
    set("Fmaterial", "gem");
    set("armor_prop/armor", 2);
    set("armor_prop/personality", 1);
    set("armor_prop/dodge", 3);
  }
  setup();
}
