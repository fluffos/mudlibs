#include <weapon.h>
inherit BLADE;

string *names = ({
  CYN "神鼠之刃" NOR,
  CYN "蛮牛之刃" NOR,
  CYN "雷虎之刃" NOR,
  CYN "玉兔之刃" NOR,
  CYN "青龙之刃" NOR,
  CYN "蟒蛇之刃" NOR,
  CYN "骏马之刃" NOR,
  CYN "火羊之刃" NOR,
  CYN "石猴之刃" NOR,
  CYN "金鸡之刃" NOR,
  CYN "天狗之刃" NOR,
  CYN "花猪之刃" NOR,
});

string *ids = ({
  "rat blade",
  "ox blade",
  "tiger blade",
  "rabbit blade",
  "dragon blade",
  "snake blade",
  "house blade",
  "sheep blade",
  "monkey blade",
  "cock blade",
  "dog blade",
  "pig blade"
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i], "blade", "dao" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一把看起相当诡异的刀，上面刻有十二生肖图象。\n");
    set("material", "steel");
    set("Fmaterial", "wood");
    set("unit", "把");
    set("no_give", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_putto", 1);
    set("deadfly", 1);
    set("no_drop", 1);
    set("sharp", 10);
  }
  init_blade(20);

  set("wield_msg", "$N " HIB "「唰」 " NOR "地一声抽出一把$n顿时芒光四射......\n");
  set("unwield_msg", "$N从容地将手中的$n插入腰间的刀鞘,脸上露出了诡异的笑。\n");

  setup();
}
