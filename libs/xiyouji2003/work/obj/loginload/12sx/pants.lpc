//十二生肖装备之新人长裤

#include <ansi.h>
#include <armor.h>

inherit PANTS;

string *names = ({
  CYN"神鼠长裤"NOR,
  CYN"蛮牛长裤"NOR,
  CYN"雷虎长裤"NOR,
  CYN"玉兔长裤"NOR,
  CYN"青龙长裤"NOR,
  CYN"蟒蛇长裤"NOR,
  CYN"骏马长裤"NOR,
  CYN"火羊长裤"NOR,
  CYN"石猴长裤"NOR,
  CYN"金鸡长裤"NOR,
  CYN"天狗长裤"NOR,
  CYN"花猪长裤"NOR,
});

string *ids = ({
	"rat pants",
	"ox pants",
	"tiger pants",
	"rabbit pants",
	"dragon pants",
	"snake pants",
	"house pants",
	"sheep pants",
	"monkey pants",
	"cock pants",
	"dog pants",
	"pig pants"
});

void create()
{
	int i = random(sizeof(names));
	set_name(names[i], ({ids[i],  "pants"}));
	set_weight(5000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long","一件绣有十二生肖图案的长裤。\n");
	set("unit", "件");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_putto", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("material", "cloth");
	set("Fmaterial", "silk");
	set("armor_prop/armor", 5);
	set("armor_prop/personality",1);
	}
	setup();
}

