//十二生肖装备之新人衣服

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

string *names = ({
  CYN"神鼠外衣"NOR,
  CYN"蛮牛外衣"NOR,
  CYN"雷虎外衣"NOR,
  CYN"玉兔外衣"NOR,
  CYN"青龙外衣"NOR,
  CYN"蟒蛇外衣"NOR,
  CYN"骏马外衣"NOR,
  CYN"火羊外衣"NOR,
  CYN"石猴外衣"NOR,
  CYN"金鸡外衣"NOR,
  CYN"天狗外衣"NOR,
  CYN"花猪外衣"NOR,
});

string *ids = ({
  "rat cloth",
  "ox cloth",
  "tiger cloth",
  "rabbit cloth",
  "dragon cloth",
  "snake cloth",
  "house cloth",
  "sheep cloth",
  "monkey cloth",
  "cock cloth",
  "dog cloth",
  "pig cloth"
});

void create()
{
	int i = random(sizeof(names));
	set_name(names[i], ({ids[i],  "cloth"}));
	set_weight(5000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("long","一件绣有十二生肖图案的外衣。\n");
	set("unit", "件");
	set("value", 500);
	set("no_sell", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_putin", 1);
	set("no_putto", 1);
	set("no_stock", 1); //不能放到黑店
	set("deadfly", 1); //死亡时自动飞掉(destruct)标志
	set("material", "cloth");
	set("Fmaterial", "silk");
	set("armor_prop/armor", 5);
	set("armor_prop/personality",1);
	}
	setup();
}
