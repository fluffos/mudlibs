#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIG "蝉翼纱衣" NOR, ({ "chanyi cloth", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条朦朦胧胧的蝉翼纱衣，闻起来还有一股淡香。\n");
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 3);
    set("female_only", 1);
  }
  setup();
}
