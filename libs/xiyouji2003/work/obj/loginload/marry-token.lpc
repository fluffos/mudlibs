#include <armor.h>

inherit OTHERS;

void create()
{
	set_name(HIM "香囊" NOR, ({ "xiang nang", "nang" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("material", "silk");
		set("armor_type", "married");
		set("armor_prop/armor",1);
		set("deadfly",1);
		set("no_get",1);
		set("no_give",1);
		set("no_stock",1);
		set("no_putin",1);
		set("no_putto",1);
	}
	setup();
}
/*
int query_autoload() { return 1; }
*/
void init()
{
	object ob = this_player();

	if (environment() == ob) {
		if (ob->query("gender") == "女性") {
			set_name(HIC "玉佩" NOR, ({ "yu pei", "yupei", "yu", "pei" }) );
			set("unit", "块");
			set("material", "jade");
		}
		if (!ob->query("marry/id") || !ob->query("marry/name")) {
			ob->delete("marry");
			call_out("lost", 1);
			return;
		}
		set("long", "这是你"
			+ (ob->query("gender") == "女性"?"相公":"娘子")
			+ "送给你的定情信物，上面"
			+ (ob->query("gender") == "女性"?"刻":"绣")
			+ "着一行小字：「"
			+ (ob->query("gender") == "女性"?"愿意为你而死的 ":"永远深爱着你的 ")
			+ ob->query("marry/name") + "」。\n");
		wear();
	}
}

void lost()
{
	object ob = environment();

	if (userp(ob))
		tell_object(ob, HIM "\n你好象失去了什么，这种滋味并不好受……\n\n" NOR);
	destruct(this_object());
}
