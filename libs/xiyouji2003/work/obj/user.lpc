// Update by waiwai@2003/04/25

#include <origin.h>
#include <user.h>
#include <command.h>
#include <ansi.h>

inherit CHARACTER;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
inherit F_ENCODING;

nosave int user_say = 0;                // 一定时间以内玩家做的say-action
nosave int user_command = 0;            // 一定时间以内玩家发送的命令
nosave int attach_flag = 0;             // 是否正在和系统联络

nosave int user_cracked = 0;    
nosave int net_dead;           
nosave int last_age_set = 0;  
int     time_to_leave = 0;
int	is_stay_in_room()	{ return 1; }
int     query_time_to_leave()   { return time_to_leave; }
int is_player()		{ return clonep(); }
int is_net_dead()           { return net_dead || ! interactive(this_object()); }
varargs string calc_sec_id(int raw);

#define MAX_COMMAND_ONE_SECTION         40
#define MAX_SAY_ONE_SECTION             4
#define BAN_SAY_PERIOD                  60

int is_user() { return 1; }
void create()
{
	::create();
	set_name("使用者物件", ({ "user object", "user", "object" }) );
}

void terminal_type(string term_type)
{
	set_temp("terminal_type", term_type);
	message("system", "终端机型态设定为 " + term_type + "。\n", this_object());
}

void reset()
{
	if( (int)query("potential") - (int)query("learned_points") < 100 )
		add("potential", 1);
	if( (int)query("thief") > 0 )
		add("thief", -1 );
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file()
{
	string id;

	id = query("id", 1);
	if( !id ) id = geteuid();
	if( !id ) id = getuid();
	if( !stringp(id) ) return 0;
	return sprintf(DATA_DIR "user/%c/%s", id[0], id);
}

int save(int raw)
{
	int res;

	if(!raw) save_autoload();
	res = ::save();
	if(!raw) clean_up_autoload();		// To save memory
	return res;
}

int backup()
{
	int res;

	save_autoload();
	res = ::backup();
	clean_up_autoload();		// To save memory
	return res;
}

void update_age()
{
        int age, newtime;
	object env;

	// Update the time we spend on mudding, using method from TMI-2 mudlib.
	if( !last_age_set ) last_age_set = time();
	
	newtime=time() - last_age_set;
	last_age_set = time();

	if(newtime<=0 || newtime>3600) { // something wrong with system
	                                // clock must happened.
	    newtime=0;
	}
	
	env=environment(this_object());
	// won't getting older in some places.
	if(!env || !env->query("no_upgrade_age")) {
	    add("mud_age", newtime);
	    delete_temp("no_heal_up/no_upgrade_age");
	} else { // no getting older, no heal up.
	    set_temp("no_heal_up/no_upgrade_age",1);
	}

	age=14 + (int)query("age_modify")/86400 + 
		(int)query("mud_age")/ 86400 +
		(int)query_temp("age_modify")/86400; // xlb && mon, 6/13/99
	if(age<1) age=1;
	set("age", age);
}

