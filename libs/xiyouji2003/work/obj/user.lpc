//Modified By waiwai@2001/07/07
void user_dump(int type)
{
	object me, where;
	me = this_object();
	where = environment(me);

	switch(type) {

	case DUMP_NET_DEAD:
	if( !wizardp(me) && environment() ) {
			tell_room(environment(), query("name") + "断线超过 " +
			          NET_DEAD_TIMEOUT / 60 + " 分钟，自动退出了西游记的世界。\n");
                }

     if( wizardp(me) ) {
      message("channel:adm",HIW "┋天神┋连线精灵："+ log_id(me) +"因"HIR"断线"HIW"在"+
	MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
	"("+file_name(where)+".c)退出系统。\n"NOR, filter_array(users(), (: wizardp :)));

		me->add("wkzD_quit", 1); // 异常退出计数标记
       log_file("wizcmds/wizlogin", sprintf("%s因为断线而退出系统. 时间在：[%s]\n",
                  log_id(me), log_time() ) );
			QUIT_CMD->force_quit(me);
         } else {
      message("channel:sys", WHT "┋系统┋连线精灵："+ log_id(me) +"因"HIR"断线超时"NOR WHT"在"+
	MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
	"("+file_name(where)+".c)退出系统。\n"NOR, filter_array(users(), (: wizardp :)));

		me->add("wkzD_quit", 1); // 异常退出计数标记
		me->set("quitY", 3); // 异常退出原因标记
 		me->set("quit_from",MISC_D->find_place(environment(me)) ); // 异常退出地点标记
 		me->set("quit_from2",COLOR_D->clean_color(environment(me)->query("short")) ); // 异常退出地点标记
		catch(command("quit"));
                if (this_object() && ! query("doing")) {
			QUIT_CMD->force_quit(me);
                }
		}
		break;

	case DUMP_IDLE:
	// Added by waiwai@2002/12/05
	if( !wizardp(me) && environment() && in_input() ) {
			tell_object( this_object(), "对不起，您已经发呆超过 " 
				+ IDLE_TIMEOUT/60 + " 分钟了，请下次再来。\n");
			tell_room( environment(), "一阵风吹来，将发呆中的" + query("name")
				+ "化为一堆飞灰，消失了。\n", ({this_object()}));

      message("channel:sys", WHT "┋系统┋连线精灵："+log_id(me)+"因"HIM"输入文字发呆超时"NOR WHT"在"+
	MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
	"("+file_name(where)+".c)退出系统。\n"NOR, filter_array(users(), (: wizardp :)));

		    command("quit");
                if( this_object() && ! query("doing") ) {
			QUIT_CMD->force_quit(me);
                }
                return;
                }

       if(!me->query("env/invisibility") 	&& !environment(me)->query("chat_room") ){
			tell_object( this_object(), "对不起，您已经发呆超过 " 
				+ IDLE_TIMEOUT/60 + " 分钟了，请下次再来。\n");
			tell_room( environment(), "一阵风吹来，将发呆中的" + query("name")
				+ "化为一堆飞灰，消失了。\n", ({this_object()}));

      message("channel:sys", WHT "┋系统┋连线精灵："+log_id(me)+"因"HIM"发呆超时"NOR WHT"在"+
	MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
	"("+file_name(where)+".c)退出系统。\n"NOR, filter_array(users(), (: wizardp :)));

		me->add("wkzF_quit", 1); // 异常退出计数标记
		me->set("quitY", 2); // 异常退出原因标记
 		me->set("quit_from",MISC_D->find_place(environment(me)) ); // 异常退出地点标记
 		me->set("quit_from2",COLOR_D->clean_color(environment(me)->query("short")) ); // 异常退出地点标记
		    command("quit");
                if( this_object() && ! query("doing") ) {
			QUIT_CMD->force_quit(me);
                }
		}
	              break;
	default:
                return;
	}
}

private void net_dead()
{
	object link_ob, me, where;
	me = this_object();

        this_object()->remove_interactive();
	me->remove_all_enemy();
	where = environment(me);

	if (! query("doing"))
		set_heart_beat(0);

	if (objectp(link_ob = query_temp("link_ob"))) {
		if (link_ob->query_temp("ip_number")) {
			link_ob->set("last_on", time());
			link_ob->set("last_from",
			link_ob->query_temp("ip_number"));
			link_ob->save();
		}
		destruct(link_ob);
	}
	net_dead = 1;
       // Added by waiwai@2001/07/07
	// 巫师断线将在10秒后退出( NET_DEAD_WIZOUT = 10 )
	if (userp(me) && ! query("doing")) {
	if( wizardp(me) ) { 
	call_out("user_dump", NET_DEAD_WIZOUT, DUMP_NET_DEAD);
       message("channel:adm", 
	HIW "┋天神┋连线精灵："+ log_id(me)+"在"+MISC_D->find_place(where)+
	COLOR_D->clean_color(where->query("short"))+"("+file_name(where)+".c)断线了。\n" NOR,
		filter_array(users(), (: wizardp :)));
	set_temp("netdead_ip", query_ip_number(me));
	set_temp("nettimes", time());
	set_temp("netdead",1);
       } else {
	call_out("user_dump", NET_DEAD_TIMEOUT, DUMP_NET_DEAD);
       message("channel:sys", 
	WHT "┋系统┋连线精灵："+ log_id(me)+"在"+MISC_D->find_place(where)+
	COLOR_D->clean_color(where->query("short"))+"("+file_name(where)+".c)断线了。\n" NOR,
		filter_array(users(), (: wizardp :)));
	set_temp("netdead_ip", query_ip_number(me));
	set_temp("nettimes", time());
	set_temp("netdead",1);
	}
	} else {
	if (environment())
	message("vision", HIW+name() + "异常断线退出了。\n"NOR,environment(), ({ me }));
	}

}

// reconnect: called by the LOGIN_D when a netdead player reconnects.
void reconnect()
{
	set_heart_beat(1);
	set_temp("netdead",0);
	remove_netdead_enemy();
	remove_call_out("user_dump");
	remove_call_out("do_net_dead");
	tell_object(this_object(), "重新连线完毕。\n");
}

int restore_temp()
{
        string file;
        file = this_object()->save_file();
        return restore_object(file);

}

// Added by waiwai@2003/04/25
// 是否是结拜兄弟？
int is_brother(mixed ob)
{
        string id;

        if (stringp(ob))
                id = ob;
        else
        if (objectp(ob))
                id = ob->query("id");
        else
                return 0;

        // 是否是普通结拜兄弟
        if (query("brothers/" + id))
                return 1;

        // 是否是结盟的兄弟
        return 0;
}

int is_attach_system()
{
        return attach_flag;
}

// start attaching
int attach_system()
{
        attach_flag = 1;
}

// stop, deatched
int detach_system()
{
        attach_flag = 0;
}
