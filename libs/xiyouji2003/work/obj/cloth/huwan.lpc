#include <armor.h>

inherit WRISTS;

void create() {
  set_name(HIC "麒麟金护腕" NOR, ({ "qilin wrists", "wrists", "huwan" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gold");
    set("Fmaterial", "cloth");
    set("unit", "件");
    set("value", 10000);
    set("armor_prop/armor", 5);
    set("armor/max_armor", 5);
  }
  setup();
}
