#include <armor.h>
inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(HIR "金红散花衣" NOR, ({ "sanhua" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 15000);
    set("long", "一件金边淡红缀满蓝花的衣服\n");
    set("material", "cloth");
    set("armor_prop/armor", 10);
    set("armor/max_armor", 10);  //By waiwai@2001/07/29 added.
    set("armor_prop/dodge", 2);
  }
  setup();
}
