 
#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create()
{
        set_name(WHT "灰顶小毡帽" NOR, ({ "hat" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("material", "cloth");
                set("value", 2000);
                set("armor_prop/armor", 4);
                set("armor/max_armor", 4);//By waiwai@2001/07/29 added.
        }
        setup();
}

