#include <armor.h>

inherit ARMBANDS;

void create() {
  set_name(WHT "麒麟铁护臂" NOR, ({ "qilin armbands", "armbands", "hubi" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "一件绣有麒麟图案的护臂．\n" NOR);
    set("material", "steel");
    set("Fmaterial", "silk");
    set("value", 10000);
    set("armor_prop/armor", 5);
    set("armor/max_armor", 5);
  }
  setup();
}
