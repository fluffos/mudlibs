#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIW "贴身小马褂" NOR, ({ "magua" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 8);
    set("armor/max_armor", 8);  //By waiwai@2001/07/29 added.
  }
  setup();
}
