#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(CYN "灰色罗皮袍" NOR, ({ "pipao" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 3000);
    set("material", "cloth");
    set("armor_prop/armor", 12);
    set("armor/max_armor", 12);  //By waiwai@2001/07/29 added.
  }
  setup();
}
