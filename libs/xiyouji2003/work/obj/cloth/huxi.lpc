#include <armor.h>

inherit LEGGINGS;

void create() {
  set_name(WHT "麒麟短护膝" NOR, ({ "leggings cloth", "leggings", "huxi", "cloth" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "一件绣有麒麟图案的护膝．\n" NOR);
    set("material", "steel");
    set("Fmaterial", "cloth");
    set("value", 12000);
    set("armor_prop/armor", 10);
    set("armor/max_armor", 10);
  }
  setup();
}
