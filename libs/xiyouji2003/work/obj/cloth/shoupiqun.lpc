#include <armor.h>

inherit SKIRTS;

void create() {
  set_name(HIR "虎" HIB "纹" HIY "兽皮裙" NOR, ({ "shoupi qun", "cloth", "qun" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条兽皮裙。\n");
    set("Fmaterial", "silk");
    set("material", "cloth");
    set("unit", "条");
    set("npc_only", 1);
    set("armor_prop/armor", 15);
  }
  setup();
}
