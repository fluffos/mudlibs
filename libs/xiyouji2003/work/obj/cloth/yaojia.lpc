#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create()
{
        set_name( HIY "天妖战甲" NOR, ({"zombie armor","zombie", "jia", "armor"}));
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
     		set("long", HIC"一件透射着妖气的暗金战甲。\n"NOR);
                set("material", "gold");
                set("Fmaterial", "silk");
                set("npc_only", 1);
                set("armor_prop/armor", 10);
                set("armor_prop/dodge", 20);
        }
        setup();
}


