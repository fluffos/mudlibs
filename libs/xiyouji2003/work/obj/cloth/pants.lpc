#include <armor.h>

inherit PANTS;

void create()
{
	set_name(MAG"紫青色长裤"NOR, ({ "mag pants", "pants", "ku" }));
	set_weight(3000);
	if ( clonep() )
	     set_default_object(__FILE__);
	else {
	set("unit", "条");
	set("value", 5000);
	set("material", "cloth");
	set("Fmaterial", "silk");
	set("armor_prop/armor", 5);
	set("armor_prop/personality",1);
	}
	setup();
}
