#include <armor.h>

inherit WAIST;

void create()
{
	set_name( HIC "麒麟丝腰带" NOR, ({ "qilin waist", "waist", "qilin" }));
	set_weight(4000);
	if( clonep() )
	    set_default_object(__FILE__);
	else {
	set("material", "silk");
	set("Fmaterial", "cloth");
	set("unit", "条");
	set("value", 10000);
	set("armor_prop/armor", 11);
	set("armor/max_armor", 11);
	}
	setup();
}

