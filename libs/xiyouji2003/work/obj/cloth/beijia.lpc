#include <armor.h>

inherit CAPE;

void create() {
  set_name(HIG "麒麟护背甲" NOR, ({ "cape armor", "beijia", "jia", "cape", "armor" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "一件绣有麒麟图案的护背宝甲．\n" NOR);
    set("material", "steel");
    set("Fmaterial", "cloth");
    set("value", 20000);
    set("armor_prop/armor", 30);
    set("armor/max_armor", 30);
    set("armor_prop/dodge", -2);
  }
  setup();
}
