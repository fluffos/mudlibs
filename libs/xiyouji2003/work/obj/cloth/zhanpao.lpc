#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIC "青莽龙战袍" NOR, ({ "zhan pao", "cloth" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件战袍。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 10000);
    set("armor_prop/armor", 30);
    set("armor/max_armor", 30);  //By waiwai@2001/07/29 added.
  }
  setup();
}
