 
#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create()
{
        set_name(BLU "蓝圆口布鞋" NOR, ({"shoes"}));
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
		set("value", 1000);
                set("material", "cloth");
                set("armor_prop/armor", 5);
                set("armor/max_armor", 5);//By waiwai@2001/07/29 added.
        }
        setup();
}

