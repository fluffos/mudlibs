#include <armor.h>

inherit SHOULDER;

void create() {
  set_name(WHT "麒麟丝护肩" NOR, ({ "qilin shoulder", "shoulder", "hujian" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "一件绣有麒麟图案的护肩．\n" NOR);
    set("material", "steel");
    set("Fmaterial", "silk");
    set("value", 12000);
    set("armor_prop/armor", 10);
    set("armor/max_armor", 10);
  }
  setup();
}
