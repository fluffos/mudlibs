#include <armor.h>
#include <ansi.h>

inherit SURCOAT;

void create()
{
  set_name( CYN "兽皮软披风" NOR, ({"pifeng"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件兽皮披风。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 10000);
    set("armor_prop/armor", 35);
    set("armor/max_armor", 35);//By waiwai@2001/07/29 added.
  }
  setup();
}


