#include <ansi.h>
#define UPDATE_TIME 900
//十五分钟刷新
inherit ITEM;

nosave string menpai;
nosave string arg = "";

void create()
{
        string file, *path;
        object ob = this_object();

        seteuid(getuid());
        file = base_name(ob);
        path = explode(file, "/") - ({ 0 });

        switch(path[1]) {
                case "xueshan":
                                menpai = "大雪山";
                                break;
                case "moon"   :
                                menpai = "月宫";
                                break;
                case "sea":
                                menpai = "东海龙宫";
                                break;
                case "nanhai":
                                menpai = "南海普陀山";
                                break;
                case "lingtai":
                                menpai = "方寸山三星洞";
                                break;
                case "death":
                                menpai = "阎罗地府";
                                break;
                case "jjf":
                                menpai = "将军府";
                                break;
                case "qujing":
                                switch(path[2]) {

                                        case "wuzhuang":
                                                menpai = "五庄观";
                                                break;
                                        case "wudidong":
                                                menpai = "陷空山无底洞";
                                                break;
                                        case "kusong":
                                                menpai = "火云洞";
                                                break;
                                        default:
                                                menpai = "无门派";
                                                break;
                                }
                                break;
                default:
                        menpai = "无门派";
                        break;
        }
        set_name(HIY+menpai+"排行榜"NOR, ({ menpai + " paihang bang", "bang" }) );
        set("long", "这是"+menpai+"的排行榜。");
        set("no_get", 1);
        setup();
}

string long()
{
        string msg = "", name = query("name");
        int time, f, m;
        object me = this_player();

        time = time() - query("last_time");
        time = UPDATE_TIME - time;
        f = time/60;
        m = time-f*60;

        if( time <= 0 ) msg += name + "将在 " + UPDATE_TIME/60 + " 分钟后刷新\n";
        else msg += name + "将在 " + f +" 分钟 " + m + " 秒后刷新。\n";

        if( time > 0 && arg != "" ) return arg+msg;
        write(name + "刷新.........\n");
        arg  = MPTOP_D->query_mptop(menpai, me);;
        set("last_time", time());
        return arg+msg;
}
