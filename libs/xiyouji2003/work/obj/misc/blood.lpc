#include <ansi.h>
inherit ITEM;

int decayed;

void create()
{
	set_name("一滩血水", ({ "blood" }) );
	set("long", "一滩血水，不知道是哪个冤魂死去所化成的。\n");
	set("unit", "滩" );
	set("per", 101);
	decayed = 0;
	if( clonep(this_object()) ) call_out("decay", 60, 1);
}

int is_blood() { return decayed < 2; }
int is_character() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase)
{
	decayed = phase;
	switch(phase) {
		case 1:
			say( query("name") + "开始渐渐的风化了。\n" );
			set_name("风化的血水", ({ "wind blood", "血水" }) );
			set("long", "这具一滩已经开始风化的血水，正在慢慢的消失。\n");
			call_out("decay", 60, phase + 1);
			break;
		case 2:
			say( query("name") + "被风吹干了，变成一滴半干的血滴。\n" );
			set_name("一滴半干的血滴", ({ "gan blood", "干血滴" }) );
			set("long", "这是一滴半干的血滴。\n");
			set("unit", "块" );
			set("is_blood",1);
			call_out("decay", 30, phase + 1);
			break;
		case 3:
			say( "一阵风吹过，把" + query("name") + "化为了虚无。\n" );
			if( environment() ) {
				object *inv;
				int i;
				
				inv = all_inventory(this_object());
				for(i=0; i<sizeof(inv); i++) {
				    inv[i]->move(environment());
				}
			}
			destruct(this_object());
			break;
	}
}
