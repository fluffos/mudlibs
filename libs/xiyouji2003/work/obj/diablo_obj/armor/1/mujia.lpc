// lightarmor.c
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("木甲", ({"mu jia","mujia","jia","armor"}));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
	    set("long", "一件木甲。\n");
                set("value", 200);
                set("material", "bone");
                set("armor_prop/armor", 30);
             }
			 setup();
}
