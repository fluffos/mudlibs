// tiejia.c
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("精钢甲", ({"iron armor","gangjia","jia","armor"}));
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
	    set("long", "一件沉甸甸的盔甲。\n");
                set("value", 300);
                set("material", "steel");
                set("armor_prop/armor", 50);
		set("armor_prop/dodge", -10);
             }
			 setup();
}
