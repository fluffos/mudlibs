#include <ansi.h>
 
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name(HIB"索魂玄铁链"NOR, ({"tie lian", "lian", "whip"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",HIC"一条长长的铁链，上面沾满了"HIR"血\n"NOR);
                set("unit", "条");
                set("npc_only", 1);
                set("no_put", 1);
        }
        init_whip(100);
        setup();
}

