#include <weapon.h>

inherit SPEAR;

void create() {
  set_name("红缨枪", ({ "hongying qiang", "qiang", "spear" }));
  init_spear(35);
  set("unit", "根");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("npc_only", 1);
    set("material", "iron");
  }
  init_spear(100);

  setup();
}
