#include <weapon.h>
#include <ansi.h>

inherit HAMMER;

void create()
{
        set_name(HIB"侍卫"HIY"金瓜锤"NOR, ({ "golden hammer", "gua", "hammer" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把沉重的金瓜，是"HIB"皇城卫士"NOR"的专用武器。\n");
                set("value", 0);
                set("npc_only", 1);
                set("no_put", 1);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n，试了试重量，然后握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(100);
        setup();
}

