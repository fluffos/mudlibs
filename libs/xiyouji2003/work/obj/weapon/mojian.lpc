#include <ansi.h>

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name(HIR"嗜血魔剑"NOR, ({ "sword" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
              set("npc_only", 1);
              set("no_put", 1);
		set("long", "这是一把看起相当诡异的剑，但它的用途往往却出人意料\n");
		set("material", "steel");
	}
	init_blade(100);

	set("wield_msg", "$N "HIB"「唰」 "NOR"地一声抽出一把$n,顿时芒光四射......\n");
	set("unwield_msg", "$N从容地将手中的$n插入腰间的剑鞘,脸上露出了诡异的笑\n");

	setup();
}

