 
#include <ansi.h>
#include <weapon.h>

inherit AXE;

void create()
{
        set_name( HIW "无敌宣花斧" NOR, ({"xuanhua fu", "fu", "axe"}));
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
"这是把沉重的大斧，有八尺多长，锋利无比．\n");
                set("value", 20000);
                set("material", "iron");
                set("wield_msg",
"$N拿出一把$n握在手中，眼前闪过一道寒光．\n");
                set("unwield_msg", "$N放下手中的$n。\n");
                set("weapon_prop/agility", 5); 

        }

        init_axe(80);
        setup();
}

