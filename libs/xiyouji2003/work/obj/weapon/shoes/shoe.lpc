#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create()
{
        set_name( RED "凤飞踏云靴" NOR, ({ "cloudy shoes", "shoes" }) );
        set_weight(1700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("value", 10000);
                set("material", "cloth");
                set("armor_prop/armor", 10);
                set("armor_prop/dodge", 20);
                set("wield_msg", "$N「噌」地一下把$n登在脚上,顿觉身轻如燕,直冲云霄。\n");


        }
        setup();
}

