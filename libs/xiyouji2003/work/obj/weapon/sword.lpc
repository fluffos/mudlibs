#include <weapon.h>
inherit SWORD;

void create()
{
	set_name(HIW"雪色神剑"NOR, ({ "sword" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把看起相当普通的长剑，但它的用途往往却出人意料\n");
		set("material", "steel");
              set("npc_only", 1);
              set("no_put", 1);
	}
	init_sword(10);

	set("wield_msg", "$N "HIB"「唰」 "NOR"地一声抽出一把$n,顿时芒光四射\n");
	set("unwield_msg", "$N从容地将手中的$n插入腰间的剑鞘,嘴里深吸了一口气\n");

	setup();
}

void owner_is_killed(object killer)
{
	message_vision(HIW"\n \n 雪色神剑 "NOR"落在地上，又弹入$N的怀中！\n\n",killer);
	this_object()->move(killer);
}
