#include <ansi.h>

#include <weapon.h>

inherit RAKE;

void create()
{
  set_name(HIR"九齿"HIW"天蓬钯"NOR, ({ "ding pa", "pa","rake" }) );
  set_weight(15000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("npc_only", 1);
    set("no_put", 1);

    set("material", "iron");
    set("long", "一柄长长的九齿钢钯。\n");
    set("wield_msg", "$N抡起一柄$n，呼地一声举过头顶。\n");
  }
  init_rake(10);
  setup();
}


