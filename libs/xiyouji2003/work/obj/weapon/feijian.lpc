#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIG "月宫" HIM "楚妃" HIW "剑" NOR, ({ "chufei sword", "sword" }));
  set_weight(24000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把淡绿色的细剑，看起来非常的华丽．\n");
    set("no_put", 1);
    set("npc_only", 1);
    set("material", "crimsonsteel");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中．\n");
    set("unwield_msg", "$N将手中的$n插入腰间，嘴角露出一丝笑意．\n");
  }
  init_sword(10);
  setup();
}
