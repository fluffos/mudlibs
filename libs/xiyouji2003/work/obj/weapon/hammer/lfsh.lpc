// hammer.c

#include <weapon.h>

inherit HAMMER;
#include <ansi.h>
void create() {
  set_name(HIR "龙" + HIY "凤" NOR + HIG "双环锤" NOR, ({ "longfeng hammer", "hammer" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一套龙凤双环，上官的成名兵器\n");
    set("value", 20000);
    set("material", "iron");
    set("wield_msg", "$N双手一分，拿出一双$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(80);
  setup();
}
