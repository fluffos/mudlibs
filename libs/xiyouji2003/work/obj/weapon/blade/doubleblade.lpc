//By waiwai@2001/05/04

#include <weapon.h>

inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HBRED "紫青双刀" NOR, ({ "doubleblade", "blade", "dao" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long",
      "一对古刀,刀柄上分别刻有" + MAG "「紫郢」" NOR + "，" + HIG "「青索」" NOR + "两字.\n"
      "刀身隐有紫青两色霞光流动,看起来是一对神兵利器.\n");
    set("no_drop", "这么好的宝物，你去扔 ! 原来吃饱了没事干呀 !!!\n");
    set("no_give", "这么好的宝物，给别人? 你入党了没有? \n");
    set("no_sell", 1);
    set("value", 9000);
    set("material", "blacksteel");
    set("wield_msg", HIB "\n两道眩目的" HIM " 紫 " HIC "青 " HIB "刀光闪过,双剑和体,你一握在手,不由豪气顿生.\n\n" NOR);

    set("unwield_msg", HIC "\n$N一声长啸,双刀瞬然不见.\n\n" NOR);
  }
  init_blade(150);
  setup();
}
