#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create()
{
        set_name( MAG "瀚海云烟刀" NOR, ({ "windblade", "blade", "dao" }) );
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
   set("long", HIC"这是一把银光雪亮的长刀，刀刃间隐隐有血光流动，锋利无匹，映面生寒。\n"NOR);

                set("value", 30000);
                set("material", "steel");
set("wield_msg", HIY"只听「铮」的一声，"+NOR"$n"+HIY"脱鞘飞出，自行跃入$N
掌中。瞬时天际间风云变色，电闪雷鸣，弥漫着一片无边杀意。\n"NOR);
set("unwield_msg", MAG"瀚海云烟"+HIY"自$N掌中飞起，在半空中一转，「唰」地跃入刀鞘。\n" NOR);
	}


        init_blade(130);
        setup();

}
