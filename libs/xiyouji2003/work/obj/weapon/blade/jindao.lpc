//jindao.c
#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(HIY "金色" + HIC "白玉" + HIW "刀" NOR, ({ "jin dao", "dao" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把" + HIY "金光" + NOR "闪闪的圆头长刀，刀把上镶嵌有" + HIW "白玉。\n" NOR);
    set("value", 0);
    set("material", "gold");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中，金光闪闪！\n");
    set("unwield_msg", "$N将手中的$n插入金色刀鞘。\n");
    set("weapon_prop/courage", 15);

  }
  init_blade(50);
  setup();
}
