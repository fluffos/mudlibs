 
// blade.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create()
{
   set_name(HIY"枯骨刀"NOR, ({"kugu dao", "kugudao", "kugu", "dao", "blade", }) );
   set_weight(1000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("value", 100000);
     set("no_sell", 1);
     set("no_give", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("rigidity", 9);
     set("sharpness", 9);
     set("weapon_prop/dodge", 30);
     set("weapon_prop/parry", 30);
     set("replace_file", "/d/obj/weapon/blade/hanhai");

     set("material", "bone");
     set("name_recognized", "枯骨刀");
     set("long", HIY"这是一柄暗黄色的单刀，份量很轻。\n"NOR);
     set("wield_msg", YEL"$N的脸上突然掠过一抹暗红色，再看时，手中多了一柄"+NOR"$n。\n");
     set("unequip_msg", CYN"$N反手将"+NOR"$n"+CYN"插会鞘中，脸色也随之一亮。\n");
   }
   init_blade(80);
   set("is_monitored", 1);

   setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	pro = (int) victim->query_temp("apply/armor_vs_fire");
	dam = (int) me->query("force");
	if(dam > pro)
	{
	victim->receive_wound("kee",10);
	return HIY "枯骨刀"+HIW"泛出一股白骨的杀气，直逼$n"+HIW"的全身！！！ \n" NOR;
	}
} 

void self_dest(object me)
{
    if(!me) return;
    if(!environment(me)) return;
    tell_object(environment(me),name()+
	    "突然落在地上，不见了。\n");
    destruct(me);
}
void init()
{
    call_out("self_dest",10800+random(600),this_object());
    remove_call_out("announce");
    call_out("announce",random(10),this_player());
}
