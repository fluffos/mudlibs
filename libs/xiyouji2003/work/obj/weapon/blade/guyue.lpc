// blade.c

#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIW "天缺古月寒" NOR, ({ "guyue", "dao", "blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把刃上有一个缺口的利器！");
    set("wield_msg", "$N「刷」地一声抽出一柄闪著寒光的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");

    set("value", 10000);
    set("rigidity", 50000);
    set("material", "steel");
  }
  init_blade(80);
  setup();
}
