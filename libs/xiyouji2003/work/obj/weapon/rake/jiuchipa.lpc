// rake.c
#include <ansi.h>

#include <weapon.h>

inherit RAKE;

void create()
{
  set_name(HIW"七齿天蓬钯"NOR, ({ "qichi pa", "pa","rake" }) );
  set_weight(15000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 20000);
    set("material", "iron");
    set("long", "一柄长长的七齿钢钯。\n");
    set("wield_msg", "$N抡起一柄$n，呼地一声举过头顶。\n");
  }
  init_rake(80);
  setup();
}


