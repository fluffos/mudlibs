// sword.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(MAG "青虹花雨剑" NOR, ({ "qinghong sword", "sword", "jian",
    "qinghong" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把镇妖降魔的宝剑。\n");
    set("unit", "把");
    set("material", "gold");
    set("wield_msg",
      "$n「唰」地从剑鞘中弹出，落入$N的手中，寒光砟现,剑尖还兀自闪个不停。\n");
    set("unwield_msg",
      "$N将手中的$n慢慢插回剑鞘，脸色露出鬼异的微笑！\n");
    set("value", 10000);
    set("weapon_prop/courage", 5);
  }
  init_sword(80);
  setup();
}
