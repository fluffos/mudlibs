#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIW "銮鱼衡冰剑" NOR, ({ "sword" }));
  set_weight(70000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", HIC "这是一把银白色的的长剑，剑锋间隐隐有血光流动，锋利无匹，映面生寒。\n" NOR);

    set("value", 30000);
    set("material", "crimsonsteel");
    set("wield_msg", HIY "只听「铮」的一声，" + NOR "$n" + HIY "脱鞘飞出，自行跃入$N
掌中。瞬时天际间风云变色，电闪雷鸣，弥漫着一片无边杀意。\n" NOR);
    set("unwield_msg", HIW "銮鱼衡冰剑" + HIY "自$N掌中飞起，在半空中一转，「唰」地跃入剑鞘。\n" NOR);
  }
  init_sword(130);
  setup();
}
