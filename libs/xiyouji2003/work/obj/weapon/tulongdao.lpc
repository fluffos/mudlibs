#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {

  set_name(HIM "屠龙刀" NOR, ({ "tulong dao", "tulong", "dao", "blade" }));
  set_weight(25000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("rigidity", 9);
    set("sharpness", 9);
    set("long", "这是一把浑身发黑的屠龙刀，刀刃间隐隐有血光流动，锋利无匹，
当年江湖中人为此刀，拼得你死我活，是刀中之宝。\n");
    set("npc_only", 1);
    set("unique", 1);
    set("weapon_prop/dodge", 50);
    set("weapon_prop/parry", 50);
    set("material", "steel");
    set("no_sell", "卖掉？有人敢要吗？\n");
    set("no_drop", "如此宝贵的武器再世难求啊。\n");
    set("no_get", "想杀人越货？你想的倒美！\n");
    set("no_put", "珍惜它吧。\n");
    set("wield_msg", HIM "只见黑光一闪，$N手中已提着一把黑沉沉的大刀，正是号称“武林至尊”的宝刀屠龙！\n" NOR);
    set("unwield_msg", HIB "黑光忽灭，$n跃入$N怀中。\n" NOR);
    set("treasure", 1);
  }
  init_blade(100);

  set("is_monitored", 1);

  setup();
}
