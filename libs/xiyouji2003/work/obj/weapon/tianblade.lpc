#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name(HIB"天杀灭门刀"NOR, ({ "blade" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("material", "iron");
                set("npc_only", 1);
                set("long", "这种厚重的大刀，天杀门专用武器，份量大约十斤重。\n");
                set("wield_msg", "$N抽出一把表面斑驳的$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插回腰间。\n");
        }
        init_blade(100);
        setup();
}
