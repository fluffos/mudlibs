#include <ansi.h>

#include <weapon.h>

inherit FORK;

void create() {
  set_name(HIB "水族" + HIW "钢柄叉" NOR, ({ "gang cha", "cha", "fork" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("npc_only", 1);
    set("no_put", 1);
    set("material", "iron");
    set("long", "一柄锋利的钢叉。\n");
    set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
  }
  init_fork(100);
  setup();
}
