#include <ansi.h>

#include <armor.h>
inherit ARMOR;

void create()
{
        set_name(HIW"亮银甲"NOR, ({"silver armor", "jia", "armor"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
	        set("long", "一件银光灿灿的盔甲．\n");
                set("npc_only", 1);
                set("material", "iron");
                set("armor_prop/armor", 300);
		  set("armor_prop/dodge", 300);
             }
        setup();
}

