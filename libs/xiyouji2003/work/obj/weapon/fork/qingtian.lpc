#include <weapon.h>
#include <ansi.h>

inherit FORK;

void create() {
  set_name(HIB "碧海" HIR "晴天" HIW "叉" NOR, ({ "12fork", "fork" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 20000);
    set("material", "silver");
    set("long", "此叉以纯银为头铜为杆。\n");
    set("wield_msg", "$N「呼」地一声抽出一柄$n握在手中。\n");
  }
  init_fork(80);
  setup();
}
