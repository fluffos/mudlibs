// huangtong.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(HIY "黄铜伏魔杖" NOR, ({ "huangtong", "staff" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一条又粗又长，非常沉重的黄铜伏杖，上面镶著六个铜环。\n");
    set("value", 10000);
    set("material", "brass");
    set("wield_msg", "$N「呼」地一声抽出一根金光闪闪的$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");

  }

  init_staff(80);
  setup();
}
