
#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
   set_name( HIR "散血天魔杵" NOR, ({ "demon staff", "staff" }) );
   set_weight(20000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "把");
     set("long", "一把暗红色、两丈多长的巨杵。\n");
     set("value", 20000);
     set("material", "crimson gold");
//	set("no_break", 1);//test it
     set("wield_msg", "$N「呼」地一声抽出一根金光闪闪的$n握在手中。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
   }
   init_staff(80);

   setup();
}
