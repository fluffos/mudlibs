#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIR "碧波血刀" NOR, ({ "xue blade", "blade", "xue", "dao" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "碧波血刀，是碧波邪妖惯用的武器。\n");
    set("material", "sapphire");
    set("rigidity", 30000);
    set("npc_only", 1);
    set("no_put", 1);
    set("wield_msg", "$N「刷」地一声抽出一柄闪著寒光的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
    set("weapon_prop/agility", 5);
  }

  init_blade(25);
  setup();
}
