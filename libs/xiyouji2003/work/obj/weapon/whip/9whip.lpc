// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <weapon.h>
#include <ansi.h>

inherit WHIP;
void create() {
  set_name(HIW "九截锡环鞭" NOR, ({ "9whip" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("value", 5000);
    set("material", "skin");
  }
  init_whip(65);

  set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n束在腰间。\n");

  setup();
}
