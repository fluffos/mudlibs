#include <weapon.h>
#include <ansi.h>

inherit WHIP;

void create() {
  set_name(HIB "情丝夺命鞭" NOR, ({ "silk whip", "whip" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 20000);
    set("material", "gold");
    set("long", HIC "一条蓝色的长带，细看由无数细如毛发的长丝聚成，虽轻若无物，却无孔不入。\n" NOR);

    set("wield_msg", "$N左手轻扬，一条" + HIB "蓝色绸带" + NOR "忽地甩了出来\n");
    set("weapon_prop/agility", 5);
  }
  init_whip(80);
  setup();
}
