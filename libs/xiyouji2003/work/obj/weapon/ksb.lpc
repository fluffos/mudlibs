#include <ansi.h>
 
#include <weapon.h>

inherit STICK;

void create()
{
   set_name(HIB"哭丧棒"NOR, ({"kusang-stick", "stick", "bang"}) );
   set_weight(14000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("no_give", 1);
     set("npc_only", 1);
     set("material", "iron");
     set("long", "这是一根阴间鬼蜮专用的兵器。\n");
     set("wield_msg", "$N抽出一根$n握在手中。\n");
     set("unequip_msg", "$N将手中的$n放了下来。\n");
   }
   init_stick(200);
   setup();
}
