#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        set_name(WHT"天杀灭门剑"NOR, ({ "sword" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("material", "iron");
                set("npc_only", 1);
                set("long", "一把诡异的剑，天杀门专用武器。\n");
                set("wield_msg", "$N抽出一把表面斑驳的$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插回腰间。\n");
        }
        init_sword(100);
        setup();
}
