
#include <weapon.h>
#include <ansi.h>

inherit ARCHERY;

void create()
{
  set_name(HIW "李氏震天箭" NOR, ({ "zhentian jian", "arrow", "jian", "zhentian", "zhentian jian", }) );
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long",
"震天箭乃是陈唐关总兵李靖的镇关之宝。后因李靖结交\n虬髯客被疑而调入京城，也被李靖带来了。\n");
//    set("unit", "壶");
    set("base_unit", "枝");
    set("unit", "枝");
    set("weight", 40);
    set("value", 5000);
  }
  set_amount(1);
  init_archery(100);
  setup();
}

