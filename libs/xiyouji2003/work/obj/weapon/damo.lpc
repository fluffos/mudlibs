#include <ansi.h>
 
#include <weapon.h>

inherit BLADE;

void create()
{
   set_name(HIY"大漠雁歌刀"NOR, ({"damo blade", "blade", "dao"}) );
   set_weight(8000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
   set("no_put", 1);
   set("npc_only", 1);

     set("material", "iron");
     set("long", "一把看似很平常的单刀,刀中隐隐寒光流转。\n");
     set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
     set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
   }
   init_blade(10);
   setup();
}
