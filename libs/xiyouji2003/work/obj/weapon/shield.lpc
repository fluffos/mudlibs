#include <armor.h>
#include <ansi.h>

inherit SHIELD;

string *names = ({
  HIG "青萝紫藤盾" NOR,
  MAG "紫萝青藤盾" NOR,
});

string *ids = ({
  "qingluo dun",
  "ziluo dun",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i], "dun", "shield" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 5000);
    set("material", "wood");
    set("armor_prop/armor", 30);
    set("armor_prop/dodge", -2);
  }
  set("no_sell", 0);
  setup();
}
