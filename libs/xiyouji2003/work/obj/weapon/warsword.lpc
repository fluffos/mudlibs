#include <weapon.h>
inherit SWORD;
#include <ansi.h>

void create()
{
   set_name(WHT"异行战剑"NOR, ({"war sword", "sword"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "这是一柄长长的精钢剑，剑口锋利。\n");
     set("no_put", 1);
     set("npc_only", 1);
     set("material", "steel");
     set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
     set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
   }
   init_sword(100);
   setup();
  
}
