#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create()
{
  set_name( HIR "勾魂无常棒" NOR, ({ "ghost stick", "stick" }));
  set_weight(20000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 30000);
    set("material", "gold");
    set("weapon_prop/dodge", 20);
    set("weapon_prop/parry", 20);
    set("long", "此棒以黄金为头铜为杆。\n");
    set("wield_msg", "$N「呼」地一声抽出一把$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n别入腰间。\n");
                
  }
  init_stick(80);
  setup();
}
