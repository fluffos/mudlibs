#include <weapon.h>
#include <ansi.h>

inherit SPEAR;

void create() {
  set_name(HIG "流" HIY "彩" HIR "火云枪" NOR, ({ "huoyun spear", "huoyun", "spear" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("value", 0);
    set("npc_only", 1);
    set("no_put", 1);
    set("material", "gold");
    set("long", "此枪是火云洞的独门兵器，凌厉无比。\n");
    set("wield_msg", "$N拿出一把$n握在手中，眼前闪过一道" HIR "火光．\n" NOR);
  }
  init_spear(100);
  setup();
}
