#include <weapon.h>
inherit NEEDLE;
#include <ansi.h>

void create()
{
        set_name(WHT"无影神针"NOR, ({"wuying shenzhen", "needle", "zhen"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根细小的无影神针，好像带着剧毒。\n");
                set("base_weight", 5);
                set("npc_only",1);
		set("material", "iron");
		set("wield_msg", "$N拿起一根$n，脸上露出了诡异的笑容。\n");
		set("unequip_msg", "$N小心地把$n揣进了怀里。\n");

        }
        init_needle(100);
        setup();
}
