#include <weapon.h>
#include <ansi.h>

inherit HAMMER;
inherit F_FOOD;

void create()
{
        set_name(HIR"炸"HIY"鸡"HIC"腿"NOR, ({ "jitui", "tui" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一枝炸得香喷喷的鸡腿。\n");
		set("unit", "根");
		set("no_give", 1);
		set("no_sell", 1);
		set("no_get", 1);
		set("food_remaining", 400);
		set("food_supply", 15);
		set("wield_msg", "$N抓起一根$n，握在手中当武器。\n");
		set("material", "bone");
	}
	init_hammer(1);
	setup();
}

