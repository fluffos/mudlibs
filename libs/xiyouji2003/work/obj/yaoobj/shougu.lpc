#include <ansi.h>

#include <armor.h>

inherit CLOTH;

void create() {
  set_name(YEL "异形兽骨甲" NOR, ({ "shougu jia", "arrmor", "jia" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件兽骨甲。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 0);
    set("npc_only", 1);
    set("no_sell", 1);
    set("armor_prop/armor", 500);
  }
  setup();
}
