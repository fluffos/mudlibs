#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name(HIM"印花"HIG"水袋"NOR, ({"shuidai", "yinhua"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", CYN"一个用来装饮水的大水袋，大概装得八、九升的纯水。\n"NOR);
		set("unit", "个");
		set("no_give", 1);
		set("no_sell", 1);
		set("no_get", 1);

		set("max_liquid", 800);
	}

	set("liquid", ([
		"type": "weater",
		"name": "纯水",
		"remaining": 45,
		"drunk_apply": 15,
	]));
}
