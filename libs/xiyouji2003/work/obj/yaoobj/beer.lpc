inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>

void create() {
  set_name(HIG "青岛啤酒" NOR, ({ "beer" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIC "一瓶用崂山矿泉酿制的甘甜的啤酒。\n" NOR);
    set("unit", "瓶");
    set("no_give", 1);
    set("no_sell", 1);
    set("npc_only", 1);
    set("max_liquid", 400);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": NOR YEL "啤酒" NOR,
    "remaining": 400,
    "drunk_apply": 20,
  ]));
}
