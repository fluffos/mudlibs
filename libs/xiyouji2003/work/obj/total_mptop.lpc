#include <ansi.h>
#define UPDATE_TIME 900
//十五分钟刷新
inherit ITEM;

string arg = "";

void create()
{
        set_name("门派总评榜", ({ "xyj top" , "top"}) ); 
        set("no_get", 1);
        setup();
}

string long()
{
        string msg = "";
        int time, f, m;
        time = time() - query("last_time");
        time = UPDATE_TIME - time;
        f = time/60;
        m = time-f*60;

        if( time <= 0 ) msg += "总评榜将在 " + UPDATE_TIME/60 + " 分钟后刷新\n";
        else msg += "总评榜将在 " + f +" 分钟 " + m + " 秒后刷新。\n";

        if( time > 0 && arg != "" ) return arg+msg;
        write("总评榜刷新.........\n");
        arg  = MPTOP_D->total_paiming();
        set("last_time", time());
        return arg+msg;
}
