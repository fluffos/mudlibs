#include <ansi.h>

inherit NPC;
void backattack();

void create()
{

	set_name(HIR"御封金牌大内护卫"NOR, ({ "guard", "body guard" }) );
	set("long", "这是一位大内护卫，由于武功高强，被御封金牌护卫。\n"NOR);
	set("attitude", "friendly");
	set("max_force", 3000);
	set("force", 3000);
	set("max_mana", 3000);
	set("mana", 3000);
	set("str", 50);
	set("cor", 30);
	set("cps", 25);
	set("combat_exp", 1000000+random(1000000));
	set_skill("sword", 250);
	set_skill("parry", 250);
	set_skill("dodge", 300);
	set_skill("unarmed", 250);
	set_skill("blade", 250);

	set("zombie", 1);
	set("no_blade", 1); //不怕冰刀
	set("no_poison", 1); //不怕用毒
	set("limit_fight", 1);

	setup();

	carry_object("/d/obj/armor/jinjia")->wear();
	carry_object("/d/obj/weapon/sword/changjian")->wield();
}

int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	object owner;
	message("vision",
		 name() + HIC"说道：如再有变化，发哨为警！\n\n"NOR
		+ name() +HIB "闪了闪就消失不见了。\n" NOR, environment(),
		this_object() );
        if(objectp(owner=this_object()->query("possessed")))
		owner->add_temp("max_guard",-1);
	destruct(this_object());
}

void invocation(object who, int level)
{
	int i;
	object *enemy;

	set_skill("blade", 250 + random(level/2));
	set_skill("sword", 250 + random(level/2));
	set_skill("parry", 250 + random(level/2));
	set_skill("dodge", 300 + random(level/2));
	set_skill("unarmed", 250 + random(level/2));
	set("combat_exp", 1000000 + random(level/4*level*level));
	message("vision",
		 name() + HIR"喝道：大胆！竟敢刺杀朝廷命官！\n" NOR,
		environment(), this_object() );

	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
	set_leader(who);
	set("possessed",who);
}

void backattack()
{
	int i;
	object owner, *enemy;
	if(objectp(owner=this_object()->query("possessed"))) {
		enemy = this_object()->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        owner->kill_ob(enemy[i]);
                        enemy[i]->kill_ob(owner);
                }
        }

	}

}

void die()
{
	object owner;
        if(objectp(owner=this_object()->query("possessed")))
                owner->add_temp("max_guard",-1);
	backattack();
	::die();
}
