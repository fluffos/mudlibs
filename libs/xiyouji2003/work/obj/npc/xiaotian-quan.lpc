#include <ansi.h>

inherit NPC;

void create() {
  object ob1, ob2;
  set_name(HIR "哮" HIY "天" HIW "犬" NOR, ({ "xiaotian quan", "quan", "dog" }));
  set("race", "野兽");
  set("age", 20);
  set("long", HIC "一只极有杀气的犬。\n" NOR);
  set("str", 40);
  set("cor", 30);
  set("con", 30);
  set("cps", 30);
  set("spi", 30);
  set("int", 30);
  set_temp("apply/damage", 25);
  set_temp("apply/armor", 50);
  set_weight(500000);

  set("max_kee", 2000);
  set("max_sen", 2000);
  set("kee", 4000);
  set("sen", 4000);

  set("combat_exp", 1000000);
  set("daoxing", 1000000);

  set("limbs", ({ "头部", "身体", "前爪", "尾巴", "肚皮", "后爪" }));
  set("verbs", ({ "bite", "claw" }));

  set("max_kee", 3000);
  set("max_sen", 3000);
  set("force", 4000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 100);

  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set("bellicosity", 300);

  set_temp("apply/attack", 200);
  set_temp("apply/armor", 200);
  set_temp("apply/unarmed", 200);
  set_temp("apply/damage", 200);
  set_temp("apply/dodge", 200);

  setup();

}

void copy_status(object me, object who) {
  me->set_skill("force", (int)who->query_skill("force", 1) + 50);
  me->set_skill("spells", (int)who->query_skill("spells", 1) + 50);
  me->set_skill("parry", (int)who->query_skill("parry", 1) + 50);
  me->set_skill("dodge", (int)who->query_skill("dodge", 1) + 50);
  me->set_skill("unarmed", (int)who->query_skill("unarmed", 1) + 50);
  me->set("combat_exp", who->query("combat_exp") + 50000);
  me->set("daoxing", who->query("daoxing") + 50000);
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIB + name() + HIB "又化为一道黑气回到豹皮锦囊中。\n"
    NOR, environment(), this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i;
  object *enemy;
  object me = this_object();
  copy_status(me, who);
  me->move(environment(who));
  message(
    "vision",
    "" HIG + who->name() + HIM "伸手一指，随身的豹皮锦囊中突然窜出一只 " + name() + HIM " 来！\n\n" NOR,
    environment(),
    this_object()
  );
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i]))
        enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}
