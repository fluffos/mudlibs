#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>
inherit F_DBASE;

#include <obstacle.h>

#define FILE "/d/obj/npc/emery.lpc"
#define TANG "/d/huanggong/npc/emperor.lpc"

int LAST_HARD_DIS= 0;
void init_cron();
void autosave();
void dianmao();
void emery();
void fenglu();

void create()
{
	seteuid( ROOT_UID );
	set("channel_id", HIR"TASK精灵");
	CHANNEL_D->do_channel( this_object(), "sys", "TASK综合事件系统已经启动。\n"NOR);
	init_cron();
}

int query_last_hard_dis()
{
        return LAST_HARD_DIS;
}

int set_last_hard_dis()
{
        LAST_HARD_DIS = time();
        return time();
}

void init_cron()
{
       mixed *local;
       local = localtime(time());

       if ( !((local[1])%35)) autosave();
//       if ( !((local[1])%60)) fenglu();
       if ( !((local[1])%60) && random(3) == 1) fenglu();

//       if ( !((local[1])%40)) dianmao();
//       if ( !((local[1])%50) ) emery();
//       if ( !((local[1])%50) && random(3) == 1) emery();
        call_out("init_cron", 60);
}

void autosave()
{
	object *user ;
	int i;
       user = users();

	reset_eval_cost();

       if (random(3))TASK_D->init_dynamic_quest();
        else TASK_D->init_dynamic_quest(1);

	message("system",HIR "\n\t\t西游记重新分布所有使命......"HIB"......所有使命分布完毕\n"NOR, user ); 
	log_file("taskFB_log","["+log_time()+"] 系统自动分布使命(TASK)。\n");

       for(i=0; i<sizeof(user); i++) 
       user[i]->save();
	message("system",HIW "\t\t    西游记下次重新分布所有使命将在 30 分钟后\n\n"NOR, user ); 
}

void dianmao()
{
	object *user;
	int i;
	object tang=find_living("tang taizong");

	user = users();
	if(tang) {
	message("system",
	HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIR"徐茂功(Xu maogong)：老夫夜观天象，将有祸事危及我唐王！\n"NOR, user );
	message("system",
	HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIW"徐茂功(Xu maogong)：望有志之士速到大殿点卯备战，以保我大唐基业！\n"NOR, user );
	}
/*
        for(i=0; i<sizeof(user); i++) {
           if ( user[i]->query("obstacle/number") >1 ) {
           user[i]->set("dianmao",1);
           }
        }
*/
}         

void emery()
{
        object me,emery,*user;
        object xu=load_object("/d/huanggong/npc/dachen2");

        int i,x,m,n;
        string *dirs;
//        dirs = ({"/d/gao/","/d/jz/","/d/eastway/","/d/lingtai/",
//                "/d/sea/","/d/moon/","/d/city/","/d/qujing/wuzhuang/",});

        dirs = ({"/d/gao/","/d/jz/", "/d/changan/","/d/eastway/","/d/city/",
                });

         user= users();
         i = random(sizeof(dirs));

        n = (int)(sizeof(users())/7+random(sizeof(users())/7)+1);
         message("system",HIB"\n【异常天色】忽然迷雾遮天闭日，似乎有千万只鬼怪降世！\n\n"NOR, user );
        for(x=0;x<n;x++) {
        emery=new("/d/obj/npc/emery.lpc");
        emery->random_go(me,dirs,i);
        }
	message("system",HIG"徐茂公掐指一算：目前共有"HIR+n+HIG
"个怪兽正在"+TASK_D->query_city(environment(find_living("guai shou")))+"作乱！\n"NOR,user );
        xu->set("mark",time());
	remove_call_out("check_guaiwu");
        call_out("check_guaishou",10,xu);
}
       
void check_guaishou(object xu)
{
	object *ob_list;
	int i;

       if( time() - xu->query("mark") > 10*60 ) {
		remove_call_out("end");
		call_out("end",3);
		return;     
        }

      if(sizeof(filter_array(children(FILE),(:clonep:))) > 1) {      
		message("system",CYN"徐茂公喊道：大家加油啊，还有怪兽没有杀完呢！\n"NOR,users());
		remove_call_out("check_guaishou");
		call_out("check_guaishou",60,xu);
		return;
        } else {
	ob_list = children(FILE);
              for( i=0; i<sizeof(ob_list); i++) 
		if(environment(ob_list[i]))	{
                CHANNEL_D->do_channel(this_object(), "sys", "怪兽被系统清除\n"NOR);
			destruct(ob_list[i]);
                }

	message("system",HIR"徐茂公一报拳：恭喜各位杀死所有的怪兽，待我秉报唐王，大家等赏吧！！\n"NOR,users());
		remove_call_out("reward");
		call_out("reward",3);
		return;
       }
}

// 如果唐蒙难，需要配合大殿设置不能更新
// 如果救回唐，则继续获得该得的奖励
void end()
{
	object *user;
	object *ob_list;
	int i, j;
	object tang=find_living("tang taizong");

	user=users();

	if(sizeof(filter_array(children(FILE),(:clonep:)))>=1) {
/*
		ob_list = children(TANG);
		for( j=0; j<sizeof(ob_list); j++) 
		if(environment(ob_list[j]))	{
		CHANNEL_D->do_channel(this_object(), "sys", 
		sprintf("唐太宗 %d 个被系统清除"NOR, sizeof(filter_array(children(TANG),(:clonep:))) ));
		message("system",HIR"【小道消息】听说"HIY"唐王"HIR"被怪兽掠走了，不知真假啊？！\n"NOR, user);
		destruct(ob_list[j]);
		}
*/
		if( tang ) {
		destruct(tang);
		CHANNEL_D->do_channel(this_object(), "sys", "唐太宗被系统清除\n"NOR);
		message("system",HIR"┋小道消息┋听说"HIY"唐王"HIR"被怪兽掠走了，不知真假啊？！\n"NOR, user);
		}
	remove_call_out("t_mennan");
	call_out("t_mennan", 3);

        for(i=0;i<sizeof(user);i++) {
          user[i]->delete("dianmao");
          if( user[i]->query("kill_guaishou") ) {
		//做个特殊标记，作为救回唐可以恢复损失的
		user[i]->set_temp("guaishou_n",(int)user[i]->query_temp("guaishou_number"));
		user[i]->delete("kill_guaishou");
		user[i]->add("office_number",-5);
		user[i]->add("shengwang",-100);
		user[i]->apply_condition("tang",100); // 蒙难标志
		user[i]->delete_temp("guaishou_number");
		user[i]->start_busy(1);
		user[i]->save();
       tell_object(user[i],HIR"由于你的护卫不利，唐王受难。你被减掉五点官职及一百点声望！\n"NOR);
       message("system",
	HIR"〖"HIY"大内传报"HIR"〗由于护卫不利，唐王受难。所有大内侍卫听令：全力追缉有罪之人！\n"NOR, user);
	new("/u/waiwai/npc/killer")->move("/d/city/ximen");
	new("/u/waiwai/npc/killer")->move("/d/city/dongmen");
	new("/u/waiwai/npc/killer")->move("/d/changan/nanchengkou");
	new("/u/waiwai/npc/killer1")->move("/d/huanggong/damen-south");
		}
	}
	}
}

void reward()
{
        object tang, *user;
        int i,number;
        user=users();

        tang=find_living("tang taizong");
        if( tang ) { // 无论什么情况，只要没有唐就不能得到奖励，不要只是说句话
         message("channel:system",HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIR"唐太宗(Tang taizong)："HIY
        "感谢各位保我大唐，寡人深感厚恩定不亏待各位！！！\n"NOR,users());

          for(i=0;i<sizeof(user);i++) {
          user[i]->delete_temp("tang");
	if( user[i]->query("kill_guaishou") ) {
        user[i]->delete("kill_guaishou");
        user[i]->add("shengwang",200);
        user[i]->add("MP_killM", -1);
        user[i]->add("office_number",(int)user[i]->query_temp("guaishou_number")/5+1 ); 
          tell_object (user[i],HIR"你得到了唐王额外奖赏"+(
        (int)user[i]->query_temp("guaishou_number")/5+1)+"点官职及200点声望！\n"NOR);
             user[i]->delete_temp("guaishou_number");
             user[i]->start_busy(1);
             user[i]->save();
            }
         }
         }
}

void t_mengnan()
{
	object *user;
	int i;
	object tang=find_living("tang taizong");

	user = users();
	if(!tang) {
	message("system",
	HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIW"徐茂功(Xu maogong)：唐王蒙难，带罪之人在三十分钟内可救回唐王便可挽回损失！\n"NOR, user );
        remove_call_out("tang_back");
        call_out("tang_back", 1800);

        for(i=0; i<sizeof(user); i++) {
           if ( user[i]->query_condition("tang") >1 ) 
           user[i]->set_temp("mengnan",1);
        }
	}
}
       
void tang_back()
{
        object tang, *user;
        int i,number;
        user=users();

        tang=find_living("tang taizong");
        if( tang ) { 
         message("channel:system",HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIR"唐太宗(Tang taizong)："HIY
        "感谢各位救我还朝，天意天不绝我大唐，寡人不再追究所有带罪之人之责！！！\n"NOR,users());

          for(i=0;i<sizeof(user);i++) {
		user[i]->clean_condition("tang"); // 蒙难标志只能在这里去除
		if( user[i]->query_temp("mengnan") ) {
			user[i]->delete_temp("tang");
			user[i]->add("shengwang",200);
			user[i]->add("MP_killM", -1);
			user[i]->add("office_number",(int)user[i]->query_temp("guaishou_n")/5+1 ); 
	tell_object (user[i],HIR"你挽回了损失"+(
        (int)user[i]->query_temp("guaishou_n")/5+1)+"点官职及200点声望！\n"NOR);
			user[i]->delete_temp("guaishou_n");
			user[i]->start_busy(1);
			user[i]->save();
            }
         }
         }
}


// Added By waiwai@2001/04/10
void fenglu()
{
 	object *user;
	int i;
	user = users();

	message("system",
	HIY"\n┋大唐皇宫┋徐茂功(Xu maogong)：各位朝廷官员速到大殿领取俸禄，过时不候！\n"NOR,user );

        for(i=0; i<sizeof(user); i++) {
//           if ( user[i]->query("obstacle/number") >1 ) {
        if ( user[i]->query("office_number") >1 ) {
		log_file("fenglu_log","["+log_time()+"] 系统通知领取俸禄.\n");

           user[i]->set("fenglu/give",1);
           user[i]->delete("fenglu_give_end");
           }
        }
}
