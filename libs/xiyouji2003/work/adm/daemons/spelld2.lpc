string attack_spell_name(string arg) {
  if (undefinedp(attack_name[arg])) return 0;

  return attack_name[arg]["name"];
}



string query_shuxing_chinese(string name) {
  if (undefinedp(sx_name[name])) return "未知";
  return sx_name[name];
}

/* determine whether two players' 法术 are 相克制
   only effective between two players,
   or a NPC against a player,
   can't a player take advantage of a npc.
   if obj1 克制 obj2, then return = 1.
   if obj2 克制 obj1, then return = -1.
   otherwise, return 0.
*/

int check_xiangke(string s1, string s2) {
  int result;

  if (!stringp(s1) || !stringp(s2)) return 0;

  if (t_ke[s1] == s2)
    // spell1 can 克制 spell2.
    result = 1;
  else if (t_sheng[s1] == s2)
    result = -1;
  else result = 0;

  return result;
}

int attacking_cast_success(object attacker, object target, int success_adj, string s1, string s2) {
  int ap, dp, success, xk, per;

  ap = attacker->query_skill("spells");

  if (ap > 600) {
    ap = (ap * ap) / 50000 * ap * attacker->query("sen");
    ap += (int)attacker->query("combat_exp") / 32;
    dp = target->query("combat_exp") / 32;
  } else {
    ap = (ap * ap * ap) / 1600 * attacker->query("sen");
    ap += (int)attacker->query("combat_exp");
    dp = target->query("combat_exp");
  }
  //note here, combat_exp is also useful in avoiding been casted.
  success = 0;

  if (success_adj < 20) success_adj = 20;
  else if (success_adj > 500) success_adj = 500;

  ap = ap / 100 * success_adj;

  xk = check_xiangke(s1, s2);

  if (xk == 1) dp /= 2;
  else if (xk == -1) ap /= 2;

  per = attacker->query_temp("diablo/" ATTACK_MAGIC "/" + s1) + attacker->query_temp("diablo/" ATTACK_MAGIC "/all");

  if (stringp(s1) && per > 0) {
    if (per > 800) per = 800;
    if (per < 0) per = 0;
    ap += ap / 100 * per;
  }

  per = target->query_temp("diablo/" DEFENSE_MAGIC "/" + s2) + target->query_temp("diablo/" DEFENSE_MAGIC "/all");

  if (stringp(s2) && per > 0) {
    if (per > 100) per = 100;
    if (per < 0) per = 0;
    dp += dp / 100 * per;
  }

  if (random(200) > dp * 100 / (ap + dp)) success = 1;  // purple test 4.5

  return success;
}

int attacking_cast_damage(object attacker, object target, int damage_adj, string s1, string s2) {
  int a_fali, d_fali, damage;
  int xk;

  if (damage_adj < 50) damage_adj = 50;
  else if (damage_adj > 500) damage_adj = 500;

  a_fali = attacker->query("mana");

  if (a_fali > 2 * attacker->query("max_mana"))

    a_fali = 2 * attacker->query("max_mana");
  d_fali = target->query("mana");

  if (d_fali > 2 * target->query("max_mana"))
    d_fali = 2 * target->query("max_mana");

  a_fali = a_fali / 20 + random(attacker->query("eff_sen") / 20);
  d_fali = d_fali / 20 + random(target->query("eff_sen") / 20);
  a_fali = a_fali + attacker->query("mana_factor") * damage_adj / 100;
  d_fali = d_fali + random(target->query("mana_factor")) * damage_adj / 100;

  xk = check_xiangke(s1, s2);

  if (xk == 1)
    d_fali /= 2;
  else if (xk == -1)
    a_fali /= 2;

  damage = a_fali - d_fali;
  //for backfire, we need let it be serious...

  if (damage < 0) damage = damage - target->query("mana_factor");
  //here increase the damage, since previously it's included in random()
  damage = damage * damage_adj / 100;  //last damage scaled again.
  //finally, we need let the spell level useful...
  //the setting is, at enabled level 200, the damage will double.
  if (damage > 0) {
    damage += (damage * (int)attacker->query_skill("spells")) / 300;
  } else if (damage < 0) {
    damage += (damage * (int)target->query_skill("spells")) / 300;
  }

  return damage;
}
//the victim use defense.
void apply_damage(
  object winner,
  object victim,
  int damage,
  string damage_type,
  string msg_hit,
  string s1,
  string s2
) {
  int type, damage_apply, damage_temp, per;
  string shuxing;

  if (damage <= 0) return;

  if (damage_type == "kee")
    type = 0;
  else if (damage_type == "sen")
    type = 1;
  else type = 2;

  damage_apply = damage;
  shuxing = winner->query_skill_mapped("spells");

  if (stringp(shuxing = winner->query_skill_mapped("spells")))
    shuxing = SKILL_D(shuxing)->query_shuxing();

  if (damage_apply <= 0) {
    message_vision("结果$N的攻击完全被挡住！\n", winner, victim);
    return;
  }

  per = winner->query_temp("diablo/" ATTACK_MAGIC "/" + s1) + winner->query_temp("diablo/" ATTACK_MAGIC "/all");

  if (stringp(s1) && per > 0) {
    if (per > 500) per = 500;
    if (per < 0) per = 0;
    damage_apply += damage_apply * per / 100;
  }

  per = victim->query_temp("diablo/" DEFENSE_MAGIC "/" + s2) + victim->query_temp("diablo/" DEFENSE_MAGIC "/all");

  if (stringp(s2) && per > 0) {
    if (per > 100) per = 100;
    if (per < 0) per = 0;
    damage_apply -= damage_apply * per / 100;
  }

  message_vision(msg_hit, winner, victim);
  if (type == 0 || type == 2) {
    victim->receive_damage("kee", damage_apply, winner);
    victim->receive_wound("kee", damage_apply / 2, winner);
    COMBAT_D->report_status(victim);
  }

  if (type == 1 || type == 2) {
    victim->receive_damage("sen", damage_apply, winner);
    victim->receive_wound("sen", damage_apply / 2, winner);
    COMBAT_D->report_sen_status(victim);
  }

  return;
}

varargs void attacking_cast(object attacker, object target, int success_adj,
  int damage_adj,  //default value is 100 for this 2 parameters.
  string damage_type,  //must be "shen"/"sen", "qi"/"kee" or "both"(default)
  string msg_init,
  string msg_success,
  string msg_fail,
  string msg_backfire_init,
  string msg_backfire_success,
  int type) {
  int damage;
  object ob;
  string file, *files, target_shuxing;

  if (!objectp(ob = previous_object()))
    return;

  file = base_name(ob);

  files = explode(file, "/");
  if (sizeof(files) < 2) return;

  file = files[sizeof(files) - 2];

  if (!stringp(file = SKILL_D(file)->query_shuxing()))
    return; ;

  if (!stringp(target_shuxing = target->query_skill_mapped("spells")))
    target_shuxing = 0;
  else target_shuxing = SKILL_D(target_shuxing)->query_shuxing();

  message_vision(msg_init, attacker, target);

  if (attacking_cast_success(attacker, target, success_adj, file, target_shuxing) == 0) {
    message_vision(msg_fail, attacker, target);
    target->kill_ob(attacker);
    return;
  }

  damage = attacking_cast_damage(attacker, target, damage_adj, file, target_shuxing);
  damage = damage * 2 / 3;

  if (damage > 0) {
    apply_damage(attacker, target, damage, damage_type, msg_success, file, target_shuxing);
  } else if (damage < 0 && !type) {
    message_vision(msg_backfire_init, attacker, target);
    apply_damage(
      target,
      attacker,
      -damage,
      damage_type,
      msg_backfire_success,
      target_shuxing,
      file
    );
  } else message_vision(HIB "结果正好被$N以法力逼住，谁也没有吃亏。\n" NOR, target);

  target->kill_ob(attacker);
  return;
}

void diablo_attack(object me, object target) {
  mapping spells = me->query_temp("diablo/" MAGIC_ATTACK);
  string *type = keys(spells), t, *temp = ({});
  object *obj;

  foreach (string tp in type) {
    if (spells[tp]["per"] > random(100) && !undefinedp(attack_name[tp]))
      temp += ({ tp });
  }

  if (sizeof(temp) > 0) {

    t = temp[random(sizeof(temp))];

    obj = spells[t]["obj"];

    if (sizeof(obj) > 0) {
      object ob = obj[random(sizeof(obj))];
      string msg;

      if (!stringp(msg = ob->attack_spell_desc(me, target)))
        msg = HIW "\n$n" HIW "发出异样的光芒，$N" HIW "心领神会，使出"
          HIR + to_chinese(attack_name[t]["spell"]) + HIW "的绝招" HIG + attack_name[t]["name"] + HIW "。\n" NOR;
      message_vision(msg, me, ob);
      call_other(spell_path[attack_name[t]["spell"]] + t, "do_cast", me, target, 1);
    }
  }
}
