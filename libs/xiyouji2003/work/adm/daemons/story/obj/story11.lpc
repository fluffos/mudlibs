// story:lighting 电击

#include <ansi.h>

mixed random_gift();

mixed *story = ({
        "公主：救命啊！",
        "魔王：你尽管叫破喉咙吧，没有人会来救你的！",
        "公主：破喉咙，破喉咙啊",
        "没有人：公主！我来救你了！ ",
        "魔王：说曹操曹操到！",
        "曹操：魔王，你叫我干嘛？",
        "魔王：哇勒！看到鬼了！！",
       "鬼：牛！真是牛，这样也被发现了！",
       "牛：胡说，谁发现我了！",
       "谁：关我屁事！",
           "魔王：oh~myGod！", 
       "上帝：谁叫我？！ ",
       "谁：没有人叫你阿！ ",
       "没有人：我什么时候叫他来？ ",
        (: random_gift :),
});

void create()
{
        seteuid(getuid());
}

string prompt() { return HIR "【西游记】" NOR; }

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

mixed random_gift()
{
        object *obs;
        object ob;
        string msg;

        obs = filter_array(users(), (: ! wizardp($1) &&
                                                 environment($1) &&
                                                 environment($1)->query("outdoors") &&
                                                 ! $1->query("doing") :));
        if (! sizeof(obs))
                return 0;

        ob = obs[random(sizeof(obs))];
        
        if (ob->query("gift/story11") || random(5))
        {
                msg = HIR "据说" + ob->name(1) + "精神突然崩溃，不醒人事。 " NOR;
                if (ob->query("combat_exp") < 1000000 ||
                    ob->query("kee") < 1000)
                        ob->unconcious();
                else
                {
                        ob->set("kee", 10);
                        ob->set("eff_kee", 10);
                        ob->set("sen", 1);
                        ob->set("eff_sen", 1);
                }
        } else
        {
                msg = HIY "传说" + ob->name(1) + "救出了被魔王囚禁的公主，胆量倍增。" NOR;
                ob->add("cor", 1);
                ob->add("gift/story11", 1);
        }
        return msg;
}


