// Update by waiwai@2003/06/01

#include <ansi.h>
#include <mudlib.h>

#define FORMAT  ([ "id"  : getuid(player), "title" : player->short(1),  "total" : player->query(var)   ])
#define TOPTEN_PATH       DATA_DIR "topten/"

inherit F_DBASE;
inherit F_SAVE;

mapping *topten_save;

nosave mapping dbase;
nosave mapping type = ([ "道行": "daoxing",
  "武学": "combat_exp",
  "内力": "max_force",
  "法力": "max_mana",
  "魔头": "PKS1",
  "寿星": "mud_age",
  "富豪": "balance",
  "使命": "task_job",
  "声望": "shengwang",
  "高官": "office_number",
  "俊男": "per",
  "靓女": "per",
  "悲情": "dietimes"
]);

nosave mapping topten = ([]);
nosave string type_name;
nosave int change = 0;

void checkplayers(object player);
void sort_player(object player, string name, string var);

void create() {
  int i;
  string *types;

  seteuid(getuid());
  message("channel:sys", WHT "┋系统┋高手排名精灵启动。\n" NOR, users());

  types = keys(type);
  for (i = 0; i < sizeof(types); i++) {
    type_name = types[i];
    topten_save = topten[types[i]];
    restore();
    topten[types[i]] = topten_save;
  }
}

string query_save_file() { return TOPTEN_PATH + type_name; }

void checkplayers(object player) {
  int i, j;
  string *types;

  if (wizardp(player)) return;

  types = keys(type);
  for (i = 0; i < sizeof(types); i++) {
    change = 0;
    if (types[i] == "俊男" && player->query("gender") != "男性")
      continue;
    if (types[i] == "靓女" && player->query("gender") != "女性")
      continue;
    sort_player(player, types[i], type[types[i]]);
    if (change == 0) continue;
    type_name = types[i];
    topten_save = topten[types[i]];
    save();
    if (!save())
      message("channel:sys",
        HIR BLINK "┋系统┋高手排名精灵：保存" + types[i] + "数据失败。\n" NOR, users());
  }

}

void sort_player(object player, string name, string var) {
  int i;

  change = 1;
  if (sizeof(topten[name]) < 1) {
    topten[name] = ({ FORMAT });
    return;
  }

  for (i = 0; i < sizeof(topten[name]); i++) {
    if (topten[name][i]["id"] == getuid(player)) {
      topten[name] = sort_array(topten[name], (: $2["total"] - $1["total"] :));
      return;
    }
  }

  if (sizeof(topten[name]) < 10) {
    topten[name] += ({ FORMAT });
    topten[name] = sort_array(topten[name], (: $2["total"] - $1["total"] :));
    return;
  }

  if (topten[name][9]["total"] < player->query(var)) {
    topten[name] += ({ FORMAT });
    topten[name] = sort_array(topten[name], (: $2["total"] - $1["total"] :));
    topten[name] = topten[name][0..9];
    return;
  }
  change = 0;
}

string topten_query(string arg) {
  int i;
  string msg;

  if (!arg) {
    string *types;

    types = keys(type);
    msg = HIY "┋ " + HIR U INTERMUD_NAME "目前江湖排名榜" NOR HIY " ┋\n" NOR HIW;
    for (i = 0; i < sizeof(types); i++)
      msg += "topten " + types[i] + "\n";
    return msg + NOR;
  }

  if (undefinedp(type[arg])) return "目前没有这个排名。\n";

  msg = HIG "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    BBLU HIY "                     " INTERMUD_NAME + "十大" HIR + arg + HIY "排行榜                     \n" NOR
    HIG "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" NOR;

  for (i = 0; i < sizeof(topten[arg]); i++)
    msg += HIC "第" + (i + 1) + "名：" NOR + topten[arg][i]["title"] + "\n" NOR;

  msg += HIG "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" NOR;
  return msg;
}

int refresh() {
  int i;
  object *usrs;

  usrs = users();
  for (i = 0; i < sizeof(usrs); i++) {
    checkplayers(usrs[i]);
  }
  return i;
}
void checkplayer(string arg) {
  checkplayers(find_player(arg));
}
