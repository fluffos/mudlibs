// Update by waiwai@2001/05/21
// Last modified by waiwai@2003/02/02
// 门派恩怨主体文件，控制整个系统门派间的杀戮
// 追杀的概念是所有的玩家和所属门派的Npc

#include <ansi.h>

inherit F_SAVE;
inherit F_DBASE;

#define FAMILY_ENEMY    2
#define FAMILY_FRIEND   1

mapping ALL_FAMILYS=(["方寸山三星洞":1,
                 "南海普陀山":1,
                 "将军府":1,
                 "五庄观":1,
                 "阎罗地府":-1,
                 "火云洞":-1,
                 "月宫":1,
                 "东海龙宫":1,
                 "大雪山":-1,
                 "陷空山无底洞":-1,
]);

mapping MASTERS=(["方寸山三星洞":"菩提祖师",
                 "南海普陀山":"观音菩萨",
                 "将军府":"白发老人",
                 "五庄观":"镇元大仙",
                 "阎罗地府":"阎罗王",
                 "火云洞":"红孩儿",
                 "月宫":"嫦娥",
                 "东海龙宫":"敖广",
                 "大雪山":"大鹏明王",
                 "陷空山无底洞":"玉鼠精",
]);

mapping family;

void create()
{
	seteuid(getuid());
	if( !restore() && !mapp(family) ){
	family = ([]);
	}
}

int remove()
{
	save();
	return 1;
}

public void mud_shutdown() { save(); }

int family_relation(string your_fam,string my_fam )
{
	return ALL_FAMILYS[your_fam]*ALL_FAMILYS[my_fam];
}

int set_relation(string my_fam, mapping relation)
{
	family[my_fam] = relation;
	save();
	return 1;
}

int add_family_enemy( string my_fam, string name, int score )
{
	if( undefinedp( family[my_fam] ) )
		family[my_fam] = ([ name : score ]);
	if( !undefinedp(family[my_fam][name] ) )
		family[my_fam][name] += score;
	else family[my_fam] += ([ name : score ]);
	save();
	return 1;
}

int remove_family_enemy( string my_fam, string name )
{
	if( undefinedp( family[my_fam] ) ) return 0;
	else if( !undefinedp( family[my_fam][name] ) ) {
		map_delete(family[my_fam] , name);
		save();
		return 1;
	}
	else return 0;
}

int is_family_enemy( string my_fam, string name )
{
	if( undefinedp( family[my_fam] )) return 0;
	else if( !undefinedp( family[my_fam][name])&&family[my_fam][name]>100)
		return 1;
	else return 0;
}

int query_enemy_quantity( string my_fam, string name )
{
	if( undefinedp( family[my_fam] )) return 0;
	else if( !undefinedp( family[my_fam][name] ) )
		return family[my_fam][name];
	else return 0;
}
        
mapping query_relation(string my_fam)
{
	if ( !undefinedp(family[my_fam]) )
		return family[my_fam];
	else
	return ([]);
}

int deal_family_relation( object victim, object killer )
{
	mapping my_family, your_family;
   
	int c_score, y_relation, m_relation; 
	string my_fam, your_fam, my_id, your_id, declare;

	string* sname;
	int i;

	if( wizardp(killer) ) return 0;

	// 这里做个预留，预留扩展是必要的
	if( victim->query("no_zuinie") || victim->query_condition("killer") ) 
		return 0;

       c_score = victim->query("family/family_faith");

	your_id = killer->query("id");
	if( your_family = killer->query("family") ) { // 异门仇杀
        your_fam = your_family["family_name"];
        my_id = victim->query("id");    
        if( !undefinedp(family[your_fam]) && !undefinedp(family[your_fam][my_id]) ) {
            killer->add("daoxing" , (victim->query("daoxing")/100) );
                killer->add("MP_killM", -1); // 杀戮异门仇敌，减门派罪孽度
            {
                declare = sprintf("：%s(%s)"HIY"杀死本门仇敌%s"HIY"(%s)，真乃大快人心。\n",
                          killer->query("name"),killer->query("id"), victim->name(1), victim->query("id") );
		                killer->add("family/family_faith", 10);//Added By waiwai@2001/05/30
                message("channel:rumor",HIY"『门派杀戮』"+MASTERS[your_fam]+declare+NOR,users());
		tell_object(killer,"\n"+HIY+log_id(killer)+"你杀死本门仇敌"+victim->name()+"("+victim->query("id")+")
得到"+XYJTIME_D->check_daoxing(victim->query("daoxing")/100)+"的道行及10点门派忠诚度！！！\n"NOR);

            }
            map_delete(family[your_fam] , my_id );
            return 1;
        }

        if( my_family = victim->query("family") ) { // 同门杀戮
            my_fam = my_family["family_name"];
            if( my_fam == your_fam ) {
                killer->add("MP_killM", 2); // 杀戮同门，加门派罪孽度
                killer->add("daoxing", -(victim->query("daoxing")/100));

                if(c_score > 30 ) {
	             killer->add("family/family_faith", -30);//Added By waiwai@2001/05/30
                    declare = sprintf("：%s"HIR"不可再屠戮本门师兄弟，切不可窝里反！\n", log_id(killer) );
                    message("channel:rumor",HIR"『门派杀戮』"+MASTERS[your_fam]+declare+NOR,users());
		tell_object(killer,"\n"+HIY+log_id(killer)+"由于你杀戮同门，被减掉"+
XYJTIME_D->check_daoxing(victim->query("daoxing")/100)+"道行和30点门派忠诚度！！！\n"NOR);
                }
		if( killer->query("MP_killM") > 30 ) { // 杀戮过多，遭同门全线追杀
		killer->set("vendetta/"+victim->query("family/family_name"),1);
		killer->apply_condition("mpzs",50);
		killer->set("ZSmenpai",killer->query("family/family_name"));

		killer->save();
		message("channel:rumor",
              HIR"【门派追杀令】"HIR+MASTERS[your_fam]+"：门派 "HIW+victim->query("family/family_name")+HIR" 通告天下："HIR"

　　　　　　  我门内成员"+
		killer->query("name")+"("+killer->query("id")+")

　　　　　　  违我门规！杀戮同门！
　　　　　　  门派成员！如见此人！
　　　　　　  格杀无论！致死为止！\n\n"NOR,users());
		}
                return 1;                                             
            } else {    
                if( userp( killer ) )//杀人者是玩家
                add_family_enemy( my_fam, your_id, c_score );
                if( y_relation = family_relation( your_fam, my_fam ) ) {                                           
                    if( y_relation == FAMILY_ENEMY ) {
                        killer->add("daoxing" , (victim->query("daoxing")/100) );
                        killer->add("relation/"+my_fam,c_score/100);
	                killer->add("MP_killM", -1); // 杀戮异门仇敌，减门派罪孽度
                        sname=keys(ALL_FAMILYS);
                        if(c_score > 30 ) {
                            declare = sprintf("：%s"HIY"杀死了本门对头%s的%s"HIY"(%s)，功德无量也！\n",
                            log_id(killer),my_fam, victim->name(1),victim->query("id") );
                            message("channel:rumor",HIY"『门派杀戮』"+MASTERS[your_fam]+declare+NOR,users());                            
                        }
		tell_object(killer,"\n"HIY+log_id(killer)+"你杀死本门对头"+my_fam+"的"+victim->name(1)+"("+victim->query("id")+")
得到"+XYJTIME_D->check_daoxing(victim->query("daoxing")/100)+"的道行！！！\n"NOR);
                    } else if( y_relation == FAMILY_FRIEND ) {
                        killer->add("daoxing" , -(victim->query("daoxing")/100) );
                        killer->add("relation/"+my_fam,-c_score/100); 
//                        killer->add("shengwang" , -50 ); 
                        killer->add("family/family_faith" , -20 ); 
	                 killer->add("MP_killM", 1); // 杀戮异门盟友，加门派罪孽度    
                        if(c_score > 30 ) {
                            declare = sprintf("：本门弟子应该与%s的弟子和睦相处，不应互相杀戮。\n",my_fam );
                            message("channel:rumor",HIG+"『门派杀戮』"+MASTERS[your_fam]+declare+NOR,users());
                        }
		tell_object(killer,"\n"+HIY+log_id(killer)+"你杀死本门盟友"+my_fam+"的"+victim->name(1)+"("+victim->query("id")+")
被减掉"+XYJTIME_D->check_daoxing(victim->query("daoxing")/100)+"的道行和20点门忠诚度！！！\n"NOR);
                    }
                }
                if( m_relation = family_relation( my_fam, your_fam )) {
                    if( m_relation == FAMILY_ENEMY || killer->query("MP_killM") > 60 ) {
                    declare = sprintf("：本门与%s势不两立，弟子们要切记仇恨啊！\n", your_fam );
			// 进行追杀
			killer->set("vendetta/"+victim->query("family/family_name"),1);
			killer->apply_condition("mpzs",50);
			killer->set("ZSmenpai",victim->query("family/family_name"));

			killer->save();

           message("channel:rumor",
                  HIR"【门派追杀令】"HIR+MASTERS[my_fam]+"：门派 "HIW+victim->query("family/family_name")+HIR" 通告天下："HIR"

　　　　　　  大胆狂徒"+killer->query("name")+"("+killer->query("id")+")

　　　　　　  触我天条！辱我门威！
　　　　　　  门派成员！如见此人！
　　　　　　  格杀无论！不死不休！\n\n"NOR,users());			
			}
                    else {
                    declare = sprintf("：本门%s"HIR"(%s)"HIR"被%s的%s"HIR"(%s)杀死了，同门弟子皆应以报仇为己任！\n",
                              victim->name(1), victim->query("id"), your_fam, killer->name(1),killer->query("id"));
			          killer->add("shengwang", -3); 
				killer->add("relation/"+my_fam,c_score/100);
                        message("channel:rumor",HIR"『门派杀戮』"+MASTERS[my_fam]+declare+NOR,users());
		tell_object(killer,"\n"HIY+log_id(killer)+"由于你杀戮江湖，被减掉3点声望！！！\n"NOR);
			}
                }
                return 1;                                              
            }             
        } else return 0;
    } else if( my_family = victim->query("family") ) {
        my_fam = my_family["family_name"];
        c_score = victim->query("family/family_faith");
        if( userp(killer) ) //杀人者是玩家
            add_family_enemy( my_fam, your_id, c_score );
       killer->add("relation/"+my_fam,c_score/100);
        {
            killer->add("shengwang", -2);//Added By waiwai@2001/05/30
            declare = sprintf("：本门弟子%s"HIC"(%s)被可恶的%s"HIC"(%s)杀死了。\n", 
		victim->name(1), victim->query("id"), killer->name(1),killer->query("id"));
            message("channel:rumor",HIC"『门派杀戮』"+MASTERS[my_fam]+declare+NOR,users());
		tell_object(killer,"\n"HIY+log_id(killer)+"由于你杀戮江湖，被减掉2点声望！！！\n"NOR);

        }
        return 1;
    } else return 0;
}

void clear_all_family_relation( string id )
{
    int i;
    string *familys = keys(ALL_FAMILYS);
    for( i = 0; i<sizeof(familys); i++ ) {
        if( undefinedp( family[familys[i]] ) ||
            undefinedp( family[familys[i]][id] ) )
        continue;
        map_delete( family[familys[i]], id );
    }
}
 
string query_save_file() { return DATA_DIR + "familyd"; }

