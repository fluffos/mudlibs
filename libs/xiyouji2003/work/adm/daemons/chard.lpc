// 设置corpse反馈信息
// Update by waiwai@2001/07/13 
// 改变corpse构造过程

#pragma optimize
#pragma save_binary

#include <race.h>
#include <ansi.h>

void create() { seteuid(getuid()); }

void setup_char(object ob) {
  string race;
  mapping my;

  if (!stringp(race = ob->query("race"))) {
    race = "人类";
    ob->set("race", "人类");
  }

  switch (race) {
    case "赛亚人":
    case "妖魔":
    case "人类":
      HUMAN_RACE->setup_human(ob);
      break;
    case "怪兽":
      MONSTER_RACE->setup_monster(ob);
      break;
    case "野兽":
      BEAST_RACE->setup_beast(ob);
      break;
    default:
      error("Chard: 没有 " + race + " 这个人种设置。\n");
  }

  my = ob->query_entire_dbase();

  if (undefinedp(my["kee"])) my["kee"] = my["max_kee"];
  if (undefinedp(my["sen"])) my["sen"] = my["max_sen"];
  if (undefinedp(my["gin"])) my["gin"] = my["max_gin"];

  if (undefinedp(my["eff_kee"])) my["eff_kee"] = my["max_kee"];
  if (undefinedp(my["eff_sen"])) my["eff_sen"] = my["max_sen"];
  if (undefinedp(my["eff_gin"])) my["eff_gin"] = my["max_gin"];

  if (!ob->query_max_encumbrance())
    ob->set_max_encumbrance(my["str"] * 5000);

  ob->reset_action();
  ob->update_killer();
}

varargs object make_corpse(object victim, object killer) {
  int i;
  object corpse, *inv;

  if (victim->is_ghost()) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) inv[i]->move(environment(victim));
    return 0;
  }

  if (victim->query("zombie")) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) destruct(inv[i]);
    say(CYN + victim->name() + NOR CYN "缓缓地倒了下来，化为一滩血水……\n" NOR);
    if (objectp(playerp(killer)) && environment(killer) == environment(victim))
      new("/obj/misc/blood.lpc")->move(environment(killer));

    return 0;
  }

  if (victim->query("tudi")) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) destruct(inv[i]);
    say(HIW + victim->name() + NOR HIW "化做一缕白烟钻入地中不见了……\n" NOR);

    return 0;
  }

  corpse = new(CORPSE_OB);
  //       corpse->set("gender", victim->query("gender"));

  corpse->make_corpse(victim, killer);

  return corpse;
}

varargs object make_toulu(object corpse) {
  object toulu;
  toulu = new("/obj/misc/toulu");
  toulu->set("name", (string)corpse->query("oldname") + "的头颅");
  toulu->set("gender", corpse->query("gender"));
  toulu->set("age", corpse->query("age"));
  return toulu;
}

varargs object make_wutoucorpse(object corpse) {
  string name, oldname;
  sscanf(corpse->query("name"), "%s的尸体%*s", oldname);
  corpse->set("oldname", oldname);
  switch (corpse->query("gender")) {
    case "男性":
      name = "无头男尸";
      break;
    case "女性":
      name = "无头女尸";
      break;
    default:
      name = "性别不明的尸体";
      break;
  }

  corpse->set("name", name);
  corpse->set("id", ({ "wutou corpse" }));
  return corpse;
}
