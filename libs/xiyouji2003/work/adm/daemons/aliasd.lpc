mapping global_alias = ([
  "l": "look",
  "n": "go north",
  "e": "go east",
  "w": "go west",
  "s": "go south",
  "nu": "go northup",
  "eu": "go eastup",
  "wu": "go westup",
  "su": "go southup",
  "nd": "go northdown",
  "ed": "go eastdown",
  "wd": "go westdown",
  "sd": "go southdown",
  "ne": "go northeast",
  "se": "go southeast",
  "nw": "go northwest",
  "sw": "go southwest",
  "u": "go up",
  "d": "go down",
  "i": "inventory",
  "tt": "team talk",
  "tt*": "team talk*",
  "bai": "apprentice",
  "cha": "check",
  "chuan": "wear",
  "cun": "save",
  "dazuo": "exercise",
  "du": "study",
  "fangqi": "abandon",
  "fangxia": "unwield",
  "fei": "fly",
  "gen": "follow",
  "guan": "close",
  "huida": "reply",
  "jiali": "enforce",
  "jianju": "accuse",
  "jifa": "enable",
  "jifa2": "enable2",
  "jineng": "skills",
  "kai": "open",
  "kaichu": "expell",
  "lian": "practice",
  "miaoshu": "describe",
  "mingsi": "meditate",
  "qiuhun": "propose",
  "sha": "kill",
  "sk2": "skills2",
  "shuo": "say",
  "tou": "steal",
  "touxian": "title",
  "touxiang": "surrender",
  "tuo": "remove",
  "xue": "learn",
  "yaoqing": "invite",
  "zhuangbei": "wield",
  "sc": "score",
  "sk": "skills",
  "qq": "whisper",
]);

string process_global_alias(string arg) {
  string *word;

  if (arg[0] == '\'') return "say " + arg[1..strlen(arg) - 1];

  word = explode(arg, " ");
  if (sizeof(word) && !undefinedp(global_alias[word[0]])) {
    word[0] = global_alias[word[0]];
    return implode(word, " ");
  }

  return arg;
}
