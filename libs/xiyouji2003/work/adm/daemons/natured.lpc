// 每天的正午.
// 事件：生病的产生，风霜雨雪的分布
void event_noon()
{
       object *ob, tang;
       int i, skill, con, con1, con2, con3;
       string get_month, ill;
	mixed *local;
       mixed *file;
       object obj, obj1, obj2;
       string dir, filename, msg;
       int l, m, n;
	tang=find_living("tang taizong");

	local = localtime(TIME_TICK1);
	get_month = CHINESE_D->chinese_number(local[4]);
       switch(get_month) {
                case "三": case "四": case "五":
                     ill = "ill_kesou";
                     msg = HIG"忽然喉头一阵痕痒，你感觉似乎要咳嗽了。\n"NOR;
                     break;
                case "六": case "七": case "八":
                     ill = "ill_zhongshu";
                     msg = HIG"突然你胸臆之间一阵翻腾，你中暑了。\n"NOR;
                     break;
                case "九": case "十": case "十一":
                     ill = "ill_shanghan";
                     msg = HIG"陡的你打了个冷战，头昏沉沉的，你得伤寒病了。\n"NOR;
                     break;
                case "十二": case "零": case "一": case "二":
                     ill = "ill_dongshang";
                     msg = HIG"你肢体末端一阵僵直，看来你被冻伤了。\n"NOR;
                     break;
        }
        if(random(5)) {
                ill = "ill_fashao";msg = HIG"你偶感风寒，竟而发起烧来。\n"NOR;
        }
        ob = users();
        for(i=0; i<sizeof(ob); i++) {
                if( !environment(ob[i]) ) continue;
                if( !environment(ob[i])->query("outdoors") ) continue;
                if( ob[i]->query("age")==14 ) continue;
                if( !wizardp(ob[i]) ) continue; // Added By waiwai@2001/03/23

		if( !ob[i]->query("mana") ) continue;
		if( !(skill = ob[i]->query_skill("spells", 1) )) {
			tell_object(ob[i], WHT"你觉得一阵晕眩，好像有一股能量从身上被人吸走了。\n"NOR);
			ob[i]->set("mana", 0);
			ob[i]->receive_damage("sen", 0);
		} else if( skill < 25 ) {
			tell_object(ob[i], WHT"随着太阳升到天空的正中央，你觉得你的法力开始消失了。\n"NOR);
			ob[i]->set("mana", (int)ob[i]->query("mana") * skill / 25 );
		}

                con1 = ob[i]->query("kee");
                con2 = ob[i]->query("max_kee");
                (int)con = con1/con2*50; // 形成第一个生病判断条件
                con3 = ob[i]->query("force");
                con2 = ob[i]->query("max_force");
		if( con2 == 0) con2 = 1;
                (int)con1 = con3/con2*50; // 形成第二个生病判断条件
		if( !wizardp(ob[i]) && userp(ob[i]) ) { // Added By waiwai@2001/03/23
                if(random(con)+random(5)+random(con1)<25) {
                        ob[i]->apply_condition(ill, 10);
                        tell_object(ob[i], msg);
			}
		}
        }

        if( random( 2 ) == 0 ) {
                m = random( sizeof(path) );
                dir = path[m];

                file = get_dir(dir, -1);
                if( !sizeof(file) ) {
                        if (file_size(dir) == -2) return;
                        else return;
                }

                n = random( sizeof(file) );
                filename = file[n][0];

                l = strlen(filename);
                if( file[n][1] == -2 ) return;
                if( l < 3 ) return;
                if( sprintf("%c", filename[l-2]) == "." && sprintf("%c", filename[l-1] ) == "c" ) {
		// 春季之春之喜雨(除了春末)
		if( check_seasonF()== "SpringA-Rain" || check_seasonF()== "SpringB-Rain" ) {
                        obj = new(SOBJ"spring-rain");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降春雨！！！\n" NOR;
		message("system", WHT"\n┋春之喜雨┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/spring_rain", sprintf("[%s] [%s]: \n春之喜雨(正午)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 春季之春之甘霖(只在春末)
		if( check_seasonF()== "SpringC-Rain" ) {
                        obj = new(SOBJ"springC-rain");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降甘霖！！！\n" NOR;
		message("system", WHT"\n┋春之甘霖┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/springC_rain", sprintf("[%s] [%s]: \n春之甘霖(正午)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 夏季的夏之甘霖(只在初夏)
		if( check_seasonF()== "SummerA-Rain" ) {
                        obj = new(SOBJ"summerA-rain");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降甘霖！！！\n" NOR;
		message("system", WHT"\n┋夏之甘霖┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/summerA_rain", sprintf("[%s][%s]: \n夏之甘霖(正午)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 夏季的夏之暴雨(盛夏和夏末)
		if( check_seasonF()== "SummerB-Rain" || check_seasonF()== "SummerC-Rain") {
                        obj = new(SOBJ"summer-rain");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降暴雨！！！\n" NOR;
