	if( !undefinedp(day_phase[current_day_phase]["event_fun"]) )
            call_other(this_object(), day_phase[current_day_phase]["event_fun"]);

	if(i==0)
       call_out("update_day_phase", day_phase[current_day_phase]["length"]);
}

void auto_save(object *user, int size, int i)
{
	int j;
    
	for(j=i;j<i+5;j++) {
		if(j>=size) return;
		if(!user[j]) continue;
		if(!environment(user[j])) continue;
		if(user[j]->save())
		tell_object(user[j], "系统自动存储完毕。。。\n");
	}
    
    call_out("auto_save", 10, user, size, i+5);
}

/**************************************************************************************************/

// 每天的清晨,黎明.
// 事件：横财的收放，收回尚存在的纳凉人
//      秋霜及晨曦雨的分布
void event_dawn()
{
       mixed *file;
       object ob, ob1, ob2;
       string dir, filename, msg;
       int l, m, n, i;
	object *ob_list;

       if( random( 2 ) ) {
                m = random( sizeof(path) );
                dir = path[m];

                file = get_dir(dir, -1);
                if( !sizeof(file) ) {
                        if (file_size(dir) == -2) return;       // notify_fail("目录是空的。\n");
                        else return;                            // notify_fail("没有这个目录。\n");
                }

                n = random( sizeof(file) );
                filename = file[n][0];

                l = strlen(filename);
                if( file[n][1] == -2 ) return;                  // notify_fail("这是一个目录。\n");
                if( l < 3 ) return;                             // notify_fail("这不是我们要找的文件。\n");
             if( sprintf("%c", filename[l-2]) == "." && sprintf("%c", filename[l-1] ) == "c" ) {
		// 雨季的晨曦细雨(只在春末的凌晨出现)
		if( check_seasonF()== "SpringC-Rain" ) {
                        ob = new(SOBJ"morning-rain");
                        ob->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降细雨！！！\n" NOR;
		message("system", WHT"\n┋晨曦细雨┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/morning_rain", sprintf("[%s] [%s]: \n晨曦细雨(凌晨)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 秋季的枯枝落叶(只在秋天)
		if( check_seasonF()== "AutumnA-Wind" || check_seasonF()== "AutumnB-Wind" ||
		check_seasonF()== "AutumnC-Wind" ) {
		if(!random(10)) {
		TREE->power_lowtree();
		message("system", HIR"\nㄖ缤纷樱花ㄖ听说大唐长安的樱花树落花了。。。\n\n" NOR, users() );
		}
//		CHANNEL_D->do_channel( this_object(), "sys", "樱花树落花了。\n"NOR );

                        ob1 = new(SOBJ"branch");
                        ob1->move(dir + filename);
                        ob2 = new(SOBJ"windleaf");
                        ob2->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s%s "HIG"落于 [%s]"NOR, 
			ob1->query("name"), ob2->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]遭飓风袭击，枯枝落叶遍地！！！\n" NOR;
		message("system", WHT"\n┋秋季飓风┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/leaf", sprintf("[%s] [%s]: \n秋季飓风(凌晨)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 深秋的霜华(只在深秋晴朗的凌晨出现)
		if( check_seasonF()== "AutumnC-Sun" ) {
                        ob = new(SOBJ"autumn-frost");
                        ob->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, ob->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]普降秋霜！！！\n" NOR;
		message("system", WHT"\n┋秋之霜华┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/morning_frost", sprintf("[%s] [%s]: \n秋之霜华(凌晨)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}
		}
	}

	// 收回夜晚的夏日乘凉人
	ob_list = children(WAI_NPC"summerman");
              for( i=0; i<sizeof(ob_list); i++) 
		if(environment(ob_list[i]))	{
			message_vision(WHT"$N"NOR"说道：天亮了，该回家睡觉罗～～～\n"NOR,ob_list[i]);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%d 个纳凉人被系统清除"NOR, sizeof(filter_array(ob_list,(:clonep:)))  ));
			destruct(ob_list[i]);
	}

	if( !random(16+random(8)) ) { // 不要泛滥
	if (file_size ("/log/dig/money") <= 0) 
	MONEY_D->move_money(random(30));
	} else 
	if (file_size ("/log/dig/money") > 0) { 
	rm("/log/dig/money");
       message("rumor",WHT"\n┋天外横财┋财神爷突然降临人间，把地上的黄金全收走了……\n"NOR,users());
       log_file( "MONEY", sprintf("[%s] : 金钱文件被系统删除。 \n", log_time() ) );
	}

}
