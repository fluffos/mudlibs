		msg = "听说["+ nameW[m] +NOR WHT "]普降瑞雪！！！\n" NOR;
		message("system", WHT"\n┋瑞雪丰年┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/winter_snow", sprintf("[%s] [%s]: \n瑞雪丰年(正午)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}

		// 冬季的雪雨(除了隆冬)
		if( check_seasonF()== "WinterA-Snow" || check_seasonF()== "WinterC-Snow") {
                        obj = new(SOBJ"winter-rain");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
