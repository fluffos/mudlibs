				game_time(), log_time(), filter_color(msg) ) );
		}

		// 夏季的夏末季风(只在夏末)
		if( check_seasonF()== "SummerC-Wind" ) {
		if(!random(10)) {
		TREE->power_lowtree();
		message("system", HIR"\nㄖ缤纷樱花ㄖ听说大唐长安的樱花树落花了。。。\n\n" NOR, users() );
		}
//		CHANNEL_D->do_channel( this_object(), "sys", "樱花树落花了。\n"NOR );

                        obj = new(SOBJ"summerC-wind");
                        obj->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		msg = "听说["+ nameW[m] +NOR WHT "]遭遇季风袭击，损失惨重！！！\n" NOR;
		message("system", WHT"\n┋夏末季风┋ "+ msg + "\n" NOR, users() );
