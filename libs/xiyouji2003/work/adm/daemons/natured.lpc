		msg = "听说["+ nameW[m] +NOR WHT "]普降雪雨！！！\n" NOR;
		message("system", WHT"\n┋冬之雪雨┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/winter_rain", sprintf("[%s][%s]: \n冬之雪雨(正午)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}
		}
	}
/*
	if( tang )
	message("channel:system", 
	HIY"\n∩"U"皇宫大内"NOR HIY"∩"HIG"值守太监：时至午正，皇上退朝，文武百官下殿！\n"NOR, users());
