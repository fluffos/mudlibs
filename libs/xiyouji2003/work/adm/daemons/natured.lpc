#include <allobj.h>
#include <localtime.h>
#define FILE		"/d/huanggong/npc/emperor.lpc"
#define TREE		WAI_OBJ"tree.lpc"
#define TREE2		WAI_OBJ"tree2.lpc"
#define T_S		"/job/qujing/ts.lpc"
#define N_S		"/adm/etc/nature/"
#define GAME_TIME(t)            (t - 971000000)

inherit F_DBASE;

mapping *day_phase;
int current_month;
nosave int current_day_phase;

int query_current_day_phase() { return current_day_phase; }

mapping *read_table(string file);
void init_day_phase();

#include <nature.h>

mixed query(string arg)
{
    if( arg && arg == "channel_id" )
      return  WHT"季节精灵";

    return 0;
}

mixed *query_localtime(int t)
{
        mixed *lt;

        t = GAME_TIME(t);
        if (t < 1) t = 1;
        lt = localtime((t % 86400) * 365);
        lt[LT_MON];
        lt[LT_YEAR] = t / 86400;
        return lt;
}

/**************************************************************************************************/
void create()
{
	string get_month, get_day;
	mixed *local;
	local = localtime(TIME_TICK1);

	get_month = CHINESE_D->chinese_number(local[4]);
       get_day = CHINESE_D->chinese_number(local[3]);

	// Update By waiwai@2002/12/05
	switch(get_month) {
		// Spring season(初春)
		case "三":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"springA_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"springA_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"springA_wind");
			   break;
		     }
		     break;
		// Spring season(春季)
		case "四":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"spring_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"spring_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"spring_wind");
			   break;
		     }
		     break;
		// Spring season(春末)
		case "五":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"springC_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"springC_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"springC_wind");
			   break;
		     }
		     break;
		// Summer season(初夏)
		case "六":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"summerA_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"summerA_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"summerA_wind");
			   break;
		     }
		     break;
		// Summer season(盛夏)
		case "七":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"summer_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"summer_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"summer_wind");
			   break;
		     }
		     break;
		// Summer season(夏末)
		case "八":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"summerC_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"summerC_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"summerC_wind");
			   break;
		     }
		     break;
		// Autumn season(初秋)
		case "九":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"autumnA_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"autumnA_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"autumnA_wind");
			   break;
		     }
		     break;
		// Autumn season(秋季)
		case "十":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"autumn_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"autumn_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"autumn_wind");
			   break;
		     }
		     break;
		// Autumn season(深秋)
		case "十一":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"autumnC_rain");
			   break;
			case 1:
			   day_phase = read_table(N_S"autumnC_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"autumnC_wind");
			   break;
		     }
		     break;
		// Winter season(初冬)
              case "零":
		case "十二":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"winterA_snow");
			   break;
			case 1:
			   day_phase = read_table(N_S"winterA_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"winterA_wind");
			   break;
		     }
		     break;
		// Winter season(隆冬)
		case "一":
		      if(get_day=="一") {
			day_phase = read_table(N_S"spring");break;
			} else switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"winter_snow");
			   break;
			case 1:		
			   day_phase = read_table(N_S"winter_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"winter_wind");
			   break;
		     }
		     break;
		// Winter season(冬末)
		case "二":
		     switch(random(3)) {
			case 0:
			   day_phase = read_table(N_S"winterC_snow");
			   break;
			case 1:
			   day_phase = read_table(N_S"winterC_sun");
			   break;
			case 2:
			   day_phase = read_table(N_S"winterC_wind");
			   break;
		     }
		     break;

		default:
		     day_phase = read_table(N_S"day_phase");
	}
	init_day_phase();
}
/**************************************************************************************************/

// 时间校正
void init_day_phase()
{
        mixed *local;
        int i, t;

        local = localtime(TIME_TICK1);

	t=time()%1440;

        for( i=0; i < sizeof(day_phase); i++)
                if( t >= day_phase[i]["length"] )
                        t -= (int)day_phase[i]["length"];
                else
                        break;

       current_day_phase = (i==0? sizeof(day_phase)-1: i - 1);
	current_month = local[4];

	remove_call_out("init_day_phase");
	call_out("init_day_phase", 3600);

	remove_call_out("update_day_phase");	
       call_out("update_day_phase",
      (int)day_phase[(current_day_phase+1) % sizeof(day_phase)]["length"] - t);
}

// 天气(season)[模糊方式]
string check_season() { return day_phase[current_day_phase]["season_msg"]; } 

// 天气(seasonF)[精确方式] 用于模糊方式之外更加准确的调用之处 
string check_seasonF() { return day_phase[current_day_phase]["seasonF_msg"]; } 

string outdoor_room_event() { return day_phase[current_day_phase]["event_fun"]; }

// 游戏中的时辰
string game_time() { return CHINESE_D->chinese_date(TIME_TICK1); }
/**************************************************************************************************/

