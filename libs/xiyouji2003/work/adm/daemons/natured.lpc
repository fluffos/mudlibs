			msg = HIR"西游记的又一个仲秋佳节来临了，在那月色美丽的夜晚，你是否也同样怀有一颗驿动的心？\n" NOR;
			message("system", HIR"┋"HIY"仲秋佳节"HIR"┋"+ msg + "\n" NOR, users() );
