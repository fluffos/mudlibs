		msg = "听说大唐长安城连绵夜雨不断！！！\n" NOR;
		message("system", WHT"\n┋风霜雨雪┋ "+ msg + "\n" NOR, users() );
			log_file( "nature/night_rain", sprintf("[%s][%s]: \n连绵夜雨(深夜)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}
	}
