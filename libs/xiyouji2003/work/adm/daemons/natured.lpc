// Added by waiwai@2003/01/06
// 雨天闪电的结果
void kill_badman()
{
	object bad, *ob;
	int i, b, m, r, kee, sen;
       mixed *file;
       object obj;
       string dir, filename;
       int l, M, n;

	m = 0;
	// 打雷出现的机率
	r = random(3);
	ob = users();
	if (r == 0) {
	    for(i=0; i<sizeof(ob); i++) {
	      if( !environment(ob[i]) ) continue;
	      if( !environment(ob[i])->query("outdoors") ) continue; // 去除室内
	      if( !environment(ob[i])->query("env/invisibility") ) continue; // 去除隐身

//	b = ob[i]->query("shengwang");
	b = ob[i]->query("bellicosity");

	if (b > m) { m = b; bad = ob[i]; }
	}

	if (m != 0 && bad) {
	// bad->query_temp("thunder") 是避雷效果，配合雨伞避雷做用
	// 从 0% - 100 %
	m = bad->query_temp("thunder");
	r = bad->query("kee");
	if (m < 0) m = 0;
	if (m > 100) m = 100;

	if( b > 500 && random(3)==0 ) {
//	if( b <= 0 && m <random(100) ) {
	if( !bad->is_fighting() && !bad->is_killing() ) {
	message("system", "\n\t\t霹雳的一声，跟着传来一道惊人的呼救声，看来是有人被雷击中了……\n\n", users());
	tell_object (bad,HIR
        "一道闪电从不远的天上直直的命中你，你身上到处都是闪电过后留下的焦痕。\n"NOR);
	log_file( "thunder", sprintf(HIR "[%s]: 闪电击中 %s\n" NOR, log_time(), log_id(bad)  ));
                CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf(HIG"闪电击中 %s"NOR, log_id(bad)) );

//       bad->add("shengwang", -bad->query("bellicosity")*5/10);
       bad->set("bellicosity", bad->query("bellicosity")*5/10);
       kee = bad->query("max_kee") * (100-m)/200;
       bad->receive_damage("kee", kee);
       sen = bad->query("max_kee") * (100-m)/100;
       bad->receive_damage("sen", sen);
	}
      }
    }
  } 

        if( random( 2 ) == 0 ) {
                M = random( sizeof(path) );
                dir = path[M];

                file = get_dir(dir, -1);
                if( !sizeof(file) ) {
                        if (file_size(dir) == -2) return;
                        else return;
                }

                n = random( sizeof(file) );
                filename = file[n][0];

                l = strlen(filename);
                if( file[n][1] == -2 ) return;
                if( l < 3 ) return;
                if( sprintf("%c", filename[l-2]) == "." && sprintf("%c", filename[l-1] ) == "c" ) {
			// 闪电过后分布的被雷击的NPC
			obj = new(WAI_NPC"thunder");
			obj -> move(dir + filename);
                CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"目前在 [%s]"NOR, obj->query("name"), dir + filename ) );
                message("system", 
			WHT"┋"HIR"小道消息"NOR WHT"┋听说：在["+ name[M] +NOR WHT"]有一路人不幸被闪电击中！ \n" NOR, users() );
                }
        } else 
	message("system", "\n\t\t\t\t轰隆隆的雷声似乎渐渐远去……\n\n", users());

	remove_call_out ("kill_badman");
}
