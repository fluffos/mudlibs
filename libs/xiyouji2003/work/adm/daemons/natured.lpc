				game_time(), log_time(), filter_color(msg) ) );
		}

		// 秋季的秋之瑟雨(只在深秋)
		if( check_seasonF()== "AutumnC-Rain" ) {
                        obj = new(SOBJ"autumn-rain");
                        obj->move(dir + filename);
                        obj1 = new(SOBJ"branch");
                        obj1->move(dir + filename);
                        obj2 = new(SOBJ"windleaf");
                        obj2->move(dir + filename);
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 [%s]"NOR, obj->query("name"), dir + filename ) );
		CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s%s "HIG"落于 [%s]"NOR, 
			obj1->query("name"), obj2->query("name"), dir + filename ) );
