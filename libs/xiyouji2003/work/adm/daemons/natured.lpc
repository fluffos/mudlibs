		if(get_day=="五") { // 农历的端午
			msg = HIR"西游记的端午节到了，唐皇御赐各家百姓金字端午粽子！！！\n" NOR;
			message("system", HIR"┋"HIY"端午佳节"HIR"┋"+ msg + "\n" NOR, users() );
