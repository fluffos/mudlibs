/**************************************************************************************************/

// 每天的傍晚.
// 事件：帮会地盘灾害及收入
void event_evening()
{
	object area, lp;
	mixed *dir;
	int count, j;
	string *item, bad_area;
	int bad_money;
	int i=1;
	mapping data=([]);
	int kaifa, jizhi, area_money, npc_money;
	object *users;
	string file, str, bh;
	int money;
	string *npc_banghui=({
	"魔龙教",
	"迷雾岛",
	"暗黑族",
	"金银帮",
	"圣火旗",
	"野羊寨",
	});

	dir=get_dir("/data/area/",0);
	if(! dir) dir=({});
	// 搜索有效地盘，这里设置只要大于等于五个地盘，灾害就生效
	if( sizeof(dir)>=5)	bad_area=dir[random(sizeof(dir))];
	else bad_area="";
	if(sscanf(bad_area,"%s.o",bad_area)!=1)	bad_area="";
	area=new("/obj/area");
       for(i=0;i<sizeof(dir);i++) {
                if(sscanf(dir[i],"%s.o",file)==1) {
		area->create(file);
		area_money=area->query("money");
		if(! intp(area_money)) area_money=0;
		kaifa=area->query("kaifa");
		if(!intp(kaifa)) kaifa=0;
		jizhi=area->query("jizhi");
		bh=area->query("banghui");
		if(!intp(jizhi)) jizhi=0;
		if(file==bad_area) {
			if(jizhi && kaifa>0) { // 开发度降到0不再出现灾害
				bad_area=file;
				bad_money=(kaifa+1)*jizhi*10;
				area_money-=bad_money;
				area->add("kaifa",-1); // 每次灾难损失一点开发值
			} else {
				bad_area="";
				area_money+=(kaifa/2+random(kaifa/2)+1)*jizhi*10;
			}
		}
		else
		area_money+=(kaifa/2+random(kaifa/2)+1)*jizhi*10;

		data[area->query("banghui")]+=area_money;
		area->set("money",0);
		area->set("last_money",area_money);
		area->save();
		}
	}

	destruct(area);

	dir=get_dir("/data/guild/",0);
	if(! dir) dir=({});
	lp=new("/obj/lingpai");
	for(i=0;i<sizeof(dir);i++) {
	       if(sscanf(dir[i],"%s.o",file)==1) {
		lp->create(file);
		npc_money=lp->query("npc_money");
		lp->set("npc_money_last",npc_money);
		lp->set("area_money_last",data[file]);
		lp->set("npc_money",0);
		data[file]+=npc_money;
		if(data[file]<0)	data[file]=0;
		data[file]/=2;
		lp->set("money",data[file]);
		lp->set("bangzhu_money",data[file]);
		lp->save();
		}
	}
	destruct(lp);

	users=users();
	if(arrayp(users)) {
	item=keys(data);
	for(i=0;i<sizeof(item);i++)	{
		count=0;
		for(j=0;j<sizeof(users);j++) {
			if(! users[j]->query("banghui") ||
			users[j]->query("banghui")!=item[i])
				continue;
			count++;
		}
		if(count==0)	count=1;
		data[item[i]]/=count;
	}
	for(i=0;i<sizeof(users);i++) {
		if(! objectp(users[i])) continue;
		if(! users[i]->query("banghui"))	continue;
		if(member_array((string)users[i]->query("banghui"),npc_banghui)!=-1)	{
		money=(int)users[i]->query("shengwang");
		if(money<50)	money=50;
		else if(money<1000)	money=1000;
		if(money>200000)	money=200000;
		data[users[i]->query("banghui")]=money;
	}
              if(! data[users[i]->query("banghui")])  continue;
		tell_object(users[i],HIG"\nН"HIY+users[i]->query("banghui")+HIG"Н"NOR WHT+
		" 帮会发饷，你的帐上增加了 "+MONEY_D->money_num(data[users[i]->query("banghui")])+" \n"NOR);
		users[i]->add("balance",data[users[i]->query("banghui")]);
	}

	if(bad_area=="") {
		message("channel:system",WHT"\n┋帮会消息┋各帮会地盘收入良好，分派晌银。\n"NOR,users());
	} else {
		str=HIG+bh+"帮会"NOR WHT+bad_weather[random(sizeof(bad_weather))];
		str=replace_string(str,"$N",bad_area);
		message("channel:rumor",WHT"┋帮会消息┋"+
		str+" "HIR+MONEY_D->money_num(bad_money)+"\n\t\t\t"NOR WHT+bad_area+"的开发度下降了。。。\n"NOR,users());
	}

	// 在Login及客栈NPC身上取消财神，减少call_out
	// 在这里做简单的控制也未尝不可
	for(i=0;i<sizeof(users);i++) {
	if( users[i]->query("vip") ) {	
	if((int)users[i]->query("balance")>500000000) {
		if( !wizardp(users[i]) ) { // 排除WIZ是必须的，省得那么麻烦
		users[i]->set("balance",500000000);
		tell_object(users[i],HIR"你在钱庄的钱已达到一万两黄金，快点花吧！\n"NOR);
		}
		}
	} else {
	if((int)users[i]->query("balance")>100000000) {
		if( !wizardp(users[i]) ) { // 排除WIZ是必须的，省得那么麻烦
		users[i]->set("balance",100000000);
		tell_object(users[i],HIR"你在钱庄的钱已达到一万两黄金，快点花吧！\n"NOR);
		}
		}
	}
	}

	}

}
/**************************************************************************************************/

// 每天的夜晚.
// 事件：天降奇缘，连绵夜雨的分布
//      事件NPC分布
void event_night()
{
       mixed *file;
       object ob;
       string dir, filename, msg;
       int l, m, n;
	object summer;
	object room;

	// 雨季的连绵夜雨
       if( random( 8 ) == 0) {
	if( check_season()== "Summer-Rain" 
	|| check_season()== "Spring-Rain" 
	|| check_season()== "Autumn-Rain" ) {	
		new(SOBJ"night-rain")->move(CITY_ROOM"zhuque-w1");
		new(SOBJ"night-rain")->move(CITY_ROOM"center");
		new(SOBJ"night-rain")->move(CITY_ROOM"center2");
		new(SOBJ"night-rain")->move(CITY_ROOM"ximen");
		new(SOBJ"night-rain")->move(CITY_ROOM"dongmen");
		msg = "听说大唐长安城连绵夜雨不断！！！\n" NOR;
		message("system", WHT"\n┋风霜雨雪┋ "+ msg + "\n" NOR, users() );
		log_file( "nature/night_rain", sprintf("[%s][%s]: \n连绵夜雨(初夜)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}
	}

	// 只在盛夏夜晚出现的纳凉人
       if( random( 4 ) == 0) {
	if( check_seasonF() == "SummerB-Sun" ) {
		new(WAI_NPC"summerman")->move(CITY_ROOM"zhuque-w1");
		new(WAI_NPC"summerman")->move(CITY_ROOM"zhuque-w1");
		new(WAI_NPC"summerman2")->move(CITY_ROOM"center");
		new(WAI_NPC"summerman2")->move(CITY_ROOM"center2");
                CHANNEL_D->do_channel( this_object(), "sys", sprintf("纳凉人出现 [%s]"NOR, log_time() ) );
		log_file( "nature/summerman", sprintf("[%s][%s]: 夏夜纳凉人(初夜)", game_time(), log_time() ) );
	}
	}

        if( random( 3 ) == 0 ) {
                m = random( sizeof(path) );
                dir = path[m];

                file = get_dir(dir, -1);
                if( !sizeof(file) ) {
                        if (file_size(dir) == -2) return;
                        else return;
                }

                n = random( sizeof(file) );
                filename = file[n][0];

                l = strlen(filename);
                if( file[n][1] == -2 ) return;
                if( l < 3 ) return;
                if( sprintf("%c", filename[l-2]) == "." && sprintf("%c", filename[l-1] ) == "c" ) {
                        ob = new( stone[ random(sizeof(stone)) ] );
                        ob->move(dir + filename);
                CHANNEL_D->do_channel( this_object(), 
			"sys", sprintf("%s "HIG"落于 "HIG"[%s]"NOR, ob->query("name"), dir + filename ) );

                message("system", HIR"\nω"HIW"天降奇缘"HIR"ω"HIW"占星家(Observer)：天降奇缘，有神光降于 ["
                        + name[m] +HIW "] \n" NOR, users() );

                log_file( "nature/STONES", sprintf("[%s]: %s  落于 %s\n", log_time(), 
                        	filter_color(ob->query("name")), dir + filename) );
                }
        }
//T_S->choose_npc();
}
