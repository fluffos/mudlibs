// 室外天气季节的描述
string outdoor_room_description()
{
	string month_desc;
	month_desc =XYJTIME_D->check_month_desc();

	return " " + sprintf( day_phase[current_day_phase]["desc_msg"],
		month_desc )+"";

}

string room_event_fun() { return day_phase[current_day_phase]["event_fun"]; }

// 季节(weather)
string check_weather() { return day_phase[current_day_phase]["weather_msg"]; } 
/**************************************************************************************************/

mapping *read_table(string file)
{
        string *line, *field, *format;
        mapping *data;
        int i, rn, fn;

        line = explode(read_file(file), "\n");
        data = ({});
        for(i=0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !pointerp(field) ) {
                        field = explode( line[i], ":" );
                        continue;
                }
                if( !pointerp(format) ) {
                        format = explode( line[i], ":" );
                        continue;
                }
                break;
        }

        for( rn = 0, fn = 0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !fn ) data += ({ allocate_mapping(sizeof(field)) });
                sscanf( line[i], format[fn], data[rn][field[fn]] );
                fn = (++fn) % sizeof(field);
                if( !fn ) ++rn;
        }
        return data;
}

mapping *query_day_phase() { return day_phase; }
