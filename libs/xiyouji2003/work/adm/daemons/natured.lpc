		call_out ("kill_badman", 3);
		break;
		case 1:
		day_phase = read_table(N_S"autumnC_sun"); break;
		case 2:
		day_phase = read_table(N_S"autumnC_wind"); break;
		}
		break;

	/**********************************************************************************/
		// 初冬(winterA-？)
		case "零": 
		case "十二": 
		if(get_day=="二十二") { 
			msg = HIW "来自北方的寒流扫过大地，万物又开始了寂静的休眠。而西游记世界的冬天却是温情的！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"winterA_sun"); break;
			} else
		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"winterA_snow"); break;
		case 1:
		day_phase = read_table(N_S"winterA_sun"); break;
		case 2:
		day_phase = read_table(N_S"winterA_wind"); break;
		}
		break;

		// 隆冬(winter-？)
		case "一":
		if(get_day=="一") { // 阳历新年
			msg = HIR"西游记的元旦佳节来临了。快到年关了，春天也不远了！！！\n" NOR;
			message("system", HIR"┋"HIY"元旦佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n元旦佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"spring"); break;
			}
			else switch(random(3)) {
			case 0:
			day_phase = read_table(N_S"winter_snow"); break;
			case 1:		
			day_phase = read_table(N_S"winter_sun"); break;
			case 2:
			day_phase = read_table(N_S"winter_wind"); break;
			}
		break;

		// 冬末(winterC-？)
		case "二":
		if(get_day=="二") { // 农历的龙抬头
			msg = HIR"西游记的龙头节日来临了，这是一个展望未来，寓意吉祥的日子！！！\n" NOR;
			message("system", HIR"┋"HIY"龙头佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n龙头佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"winterC_sun"); break;
			}
			else switch(random(3)) {
			case 0:
			day_phase = read_table(N_S"winterC_snow"); break;
			case 1:		
			day_phase = read_table(N_S"winterC_sun"); break;
			case 2:
			day_phase = read_table(N_S"winterC_wind"); break;
			}
			break;
			default:
			day_phase = read_table(N_S"day_phase");
		}
/**************************************************************************************************/
	// 雨季的连绵夜雨
	if( random( 8 ) == 0 ) {
	if( check_season()== "Summer-Rain" 
	|| check_season()== "Spring-Rain" 
	|| check_season()== "Autumn-Rain" ) {
		new(SOBJ"night-rain")->move(CITY_ROOM"nankou");
		new(SOBJ"night-rain")->move(CITY_ROOM"ximen");
