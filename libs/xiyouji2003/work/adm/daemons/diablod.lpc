#include <ansi.h>
#include <weapon.h>
#include <armor.h>
#include <diablo.h>

#define  DIABLO_OB __DIR__"diablo_ob"

inherit F_SAVE;
inherit F_DBASE;

nosave  mapping dbase;
mapping diablo = ([]);

string show_diablo(mapping new_diablo);

string query_save_file()
{
        return DATA_DIR "diablod";
}

void create()
{
        seteuid(getuid());
        set("channel_id", "暗黑精灵");
        set("id", "diablo");
        CHANNEL_D->do_channel(this_object(), "sys", HIG "暗黑精灵已经启动。\n"NOR);
        restore();
}

object create_diablo(string arg)
{
        object ob;
        mapping diablo_dbase;

        if( undefinedp(diablo[arg]) ) return 0;

        diablo_dbase = copy(diablo[arg]);

        if( !undefinedp(diablo_dbase["diablo"]) && mapp(diablo_dbase["diablo"]) ) {
                string *va = keys(diablo_dbase["diablo"]);

                foreach( string v in va ) {
                        switch( v ) {
                                case ADD_SKILL      :
                                case DEFENSE_MAGIC  :
                                case ATTACK_MAGIC   :
                                case MAGIC_ATTACK   :
                                case ADD_ATTRIBUTE  :
                                {
                                        mapping it;

                                        if( mapp( it = diablo_dbase["diablo"][v] ) ) {
                                                string *its = keys(it);
                                                int    max, min;

                                                foreach(string itr in its) {
                                                        if( arrayp(diablo_dbase["diablo"][v][itr])
                                                        && intp(min = diablo_dbase["diablo"][v][itr][0])
                                                        && intp(max = diablo_dbase["diablo"][v][itr][1])
                                                        && max > min )
                                                                diablo_dbase["diablo"][v][itr] = min + random(max + 1);
                                                }
                                        }
                                }
                                default :
                                {
                                        int max, min;

                                        if( arrayp(diablo_dbase["diablo"][v])
                                         && intp(min = diablo_dbase["diablo"][v][0])
                                         && intp(max = diablo_dbase["diablo"][v][1])
                                         && max > min )
                                                diablo_dbase["diablo"][v] = min + random(max + 1);
                                }

                        }

                }
        }

        if( !undefinedp(diablo_dbase["damage"]) ) {
                if( arrayp(diablo_dbase["damage"]) ) {
                        int max, min;

                        if(intp(min = diablo_dbase["damage"][0])
                        && intp(max = diablo_dbase["damage"][1]) )
                                diablo_dbase["weapon_prop"] = ([ "damage" : min + random(max + 1) ]);
                }

                map_delete(diablo_dbase,"damage");
        }
        if( !undefinedp(diablo_dbase["armor"]) ) {
                if( arrayp(diablo_dbase["armor"]) ) {
                        int max, min;

                        if(intp(min = diablo_dbase["armor"][0])
                        && intp(max = diablo_dbase["armor"][1]) )
                                diablo_dbase["armor_prop"] = ([ "armor" : min + random(max + 1) ]);
                }
                map_delete(diablo_dbase,"armor");
        }

        ob = new(DIABLO_OB);
        ob->set_entire_dbase(diablo_dbase);
        ob->setup();
        return ob;
}

void add_diablo(object me, string arg)
{
        if( this_player(1) != me ) {
                tell_object(me, "你不能编辑。\n");
                return;
        }

        if( !wizardp(me) ) {
                tell_object(me, "只有巫师才能编辑物品。\n");
                return;
        }

        if( !arg || arg == "" ) {
                tell_object(me, "你要编辑什么物品？\n");
                return;
        }

        if( !undefinedp(diablo[arg]) ) {
                tell_object(me, "已经有了这种物品，请先删除。\n");
                return;
        }

        tell_object(me, "请输入这种物品的中文名：");
        input_to( "get_name", me, arg );
}

void get_name(string arg, object me, string id)
{
        mapping new_diablo = ([]);

        arg = trans_color(arg,2);
        if( COLOR_D->get_color(arg) != "" ) arg += NOR;

        new_diablo["name"] = arg;
        new_diablo["id"]   = id;

        tell_object(me, "请设定这样物品的量词：");
        input_to( "get_unit", me, new_diablo);
}

void get_unit(string arg, object me, mapping new_diablo)
{
        new_diablo["unit"] = arg;

        tell_object(me, "请输入这种物品的种类：\n"
                        "1. 武器\n"
                        "2. 防具\n"
                        "请输入：");
        input_to( "get_type", me, new_diablo);
}

void get_type(string arg, object me, mapping new_diablo)
{
        if( arg == "1" ) {
                tell_object(me, "请输入这种武器的种类\n"
                            "斧(axe)\n"
                            "刀(blade)\n"
                            "匕首(dagger)\n"
                            "叉(fork)\n"
                            "锤(hammer)\n"
                            "锏(mace)\n"
                            "剑(sword)\n"
                            "杖(staff)\n"
                            "棍(stick)\n"
                            "鞭(whip)\n"
                            "枪(spear)\n"
                            "针(needle)\n"
                            "琴(music)\n\n"
                            "请选择：");
                input_to("get_weapon_type", me, new_diablo);
                return;
        }

        if( arg == "2" ) {

                tell_object(me, "请输入这种防具的种类\n"
                            "头盔(head)\n"
                            "脖套(neck)\n"
                            "衣服(cloth)\n"
                            "盔甲(armor)\n"
                            "披风(surcoat)\n"
                            "腰带(waist)\n"
                            "护腕(wrists)\n"
                            "盾牌(shield)\n"
                            "指套(finger)\n"
                            "手套(hands)\n"
                            "鞋(boots)\n"
                            "请选择：");
                input_to("get_armor_type", me, new_diablo);
                return;
        }

        tell_object(me, "请输入这种物品的种类：\n"
                        "1. 武器\n"
                        "2. 防具\n"
                        "3. 镶嵌物品\n\n"
                        "请输入：");
        input_to( "get_type", me, new_diablo);
}

void get_weapon_type(string arg, object me, mapping new_diablo)
{
        string *weapons = ({ "axe", "blade", "dagger", "fork", "hammer", "mace",
                             "sword", "staff", "stick", "whip", "spear", "needle",
                             "music" });

        if( member_array(arg, weapons) == -1 ) {
                tell_object(me, "请选择：");
                input_to("get_weapon_type", me, new_diablo);
                return;
        }

        new_diablo["skill_type"] = arg;

        tell_object(me, "请设定该武器的杀伤力[范围，如：10-100]");
        input_to("get_weapon_damage", me, new_diablo);
}

void get_armor_type(string arg, object me, mapping new_diablo)
{
        string *armors = ({ "head", "neck", "cloth", "armor", "surcoat",
                            "waist", "wrists", "shield", "finger",
                            "hands", "boots" });

        if( member_array(arg, armors) == -1 ) {
                tell_object(me, "请选择：");
                input_to("get_armor_type", me, new_diablo);
                return;
        }

        new_diablo["armor_type"] = arg;

        tell_object(me, "请设定该防具的防御力[范围，如：10-100]");
        input_to("get_armor_defense", me, new_diablo);
}

void get_weapon_damage(string arg, object me, mapping new_diablo)
{
        int min, max;
        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请设定该武器的杀伤力[范围，如：10-100]");
                input_to("get_weapon_damage", me, new_diablo);
                return;
        }

        new_diablo["damage"] = ({ min, max });

        tell_object(me, "请设定该武器装备时的描述 [回车取消]");
        input_to("get_wield_msg", me, new_diablo);
}

void get_wield_msg(string arg, object me, mapping new_diablo)
{
        if( stringp(arg) && strlen(arg) > 2 )
                new_diablo["wield_msg"] = arg + "\n";

        tell_object(me, "请设定卸下该武器时的描述 [回车取消]");
        input_to("get_unwield_msg", me, new_diablo);
}

void get_unwield_msg(string arg, object me, mapping new_diablo)
{
        if( stringp(arg) && strlen(arg) > 2 )
                new_diablo["unwield_msg"] = arg + "\n";

        tell_object(me, "请设定该物品的长描述：");
        input_to("get_long_desc", me, new_diablo);
}


void get_armor_defense(string arg, object me, mapping new_diablo)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请设定该防具的防御力[范围，如：10-100]");
                input_to("get_armor_defense", me, new_diablo);
                return;
        }

        new_diablo["armor"] = ({ min, max });

        tell_object(me, "请设定该防具装备时的描述 [回车取消]");
        input_to("get_wear_msg", me, new_diablo);
}

void get_wear_msg(string arg, object me, mapping new_diablo)
{
        if( stringp(arg) && strlen(arg) > 2 )
                new_diablo["wear_msg"] = arg + "\n";

        tell_object(me, "请设定卸下该防具时的描述 [回车取消]");
        input_to("get_unequip_msg", me, new_diablo);
}

void get_unequip_msg(string arg, object me, mapping new_diablo)
{
        if( stringp(arg) && strlen(arg) > 2 )
                new_diablo["unequip_msg"] = arg + "\n";

        tell_object(me, "请设定该物品的长描述：");
        input_to("get_long_desc", me, new_diablo);
}

void set_stat(object me, mapping new_diablo)
{
        if( undefinedp(new_diablo["diablo"]) )
                new_diablo["diablo"] = ([]);

        tell_object(me, "请为这样物品设定属性：\n"
                        ADD_SKILL         ". 增加武功 [单项] \n"
                        ADD_ALL_SKILL     ". 增加武功 [全部] \n"
                        ADD_MANA          ". 增加法力最大值 [数值] \n"
                        ADD_FORCE         ". 增加内力最大值 [数值] \n"
                        ADD_KEE           ". 增加气血最大值 [数值] \n"
                        ADD_SEN           ". 增加精神最大值 [数值] \n"
                        KEE_SUB_FORCE     ". 气血的伤害转化为内力的减少 [百分比] \n"
                        KEE_SUB_MANA      ". 气血的伤害转化为法力的减少 [百分比] \n"
                        SEN_SUB_FORCE     ". 精神的伤害转化为内力的减少 [百分比] \n"
                        SEN_SUB_MANA      ". 精神的伤害转化为法力的减少 [百分比] \n"
                        KEE_ADD_FORCE     ". 气血的伤害转化为内力的增加 [百分比] \n"
                        KEE_ADD_MANA      ". 气血的伤害转化为法力的增加 [百分比] \n"
                        SEN_ADD_FORCE     ". 精神的伤害转化为内力的增加 [百分比] \n"
                        SEN_ADD_MANA      ". 精神的伤害转化为法力的增加 [百分比] \n"
                        DAMAGE_ADD_KEE    ". 给对方的伤害转化为气血的增加 [百分比] \n"
                        DAMAGE_ADD_SEN    ". 给对方的伤害转化为精神的增加 [百分比] \n"
                        DAMAGE_ADD_FORCE  ". 给对方的伤害转化为内力的增加 [百分比] \n"
                        DAMAGE_ADD_MANA   ". 给对方的伤害转化为法力的增加 [百分比] \n"
                        DEFENSE_MAGIC     ". 增加法术的抵抗 \n"
                        ATTACK_MAGIC      ". 增加法术的威力 \n"
                        MAGIC_ATTACK      ". 战斗中出攻击性法术 \n"
                        ADD_ATTRIBUTE     ". 提高临时天赋属性 \n"
                        MAGIC_FIND        ". MF值 [数值] \n"
                        ATTACK_BUSY       ". busy攻击者 [百分比] \n"
                        ADD_DAMAGE        ". 加强伤害 [百分比] \n"
                        "你的选择是(decide确认)：");
        input_to("get_stat", me, new_diablo);
}


void get_long_desc(string arg, object me, mapping new_diablo)
{
        if( stringp(arg) && strlen(arg) > 2 )
                new_diablo["long"] = arg + "\n";

        tell_object(me, "请设定该物品的等级(1-5)：");
        input_to("get_level", me, new_diablo);
}

void get_level(string arg, object me, mapping new_diablo)
{
        if( !atoi(arg) ) {
                tell_object(me, "请设定该物品的等级(1-5)：");
                input_to("get_level", me, new_diablo);
                return;
        }

        new_diablo["lvl"] = atoi(arg);

        tell_object(me, "你需要为这样法宝设定属性吗？(y/n)[选n属性随机]");
        input_to("decide_stat", me, new_diablo);
}

void decide_stat(string arg, object me, mapping new_diablo)
{
        if( arg == "y" ) {
                       set_stat(me, new_diablo);
        } else if( arg == "n" ) {
                new_diablo["diablo"] = 0;
                tell_object(me, "请输入这种物品的出现几率(万分之)：");
                input_to("get_appear_chance", me, new_diablo);
        } else {
                tell_object(me, "你需要为这样法宝设定属性吗？(y/n)[选n属性随机]");
                input_to("decide_stat", me, new_diablo);
        }
}

void get_stat(string arg, object me, mapping new_diablo)
{
        switch( arg ) {
                case "decide"  :
                        tell_object(me, "请输入这种物品的出现几率(万分之)[可不设]：");
                        input_to("get_appear_chance", me, new_diablo);
                        break;
                case ADD_SKILL :
                        tell_object(me, "清输入这种武功的名称(随机请输入\"r\")：");
                        input_to("get_skill", me, new_diablo);
                        break;
                case DEFENSE_MAGIC :
                case ATTACK_MAGIC  :
                        tell_object(me, "请输入法术的属性：\n"
                                        "金(jin)\n"
                                        "木(mu)\n"
                                        "水(shui)\n"
                                        "火(huo)\n"
                                        "土(tu)\n"
                                        "所有(all)\n"
                                        "随机(r)\n\n"
                                        "请输入：");
                        input_to("get_spell", me, new_diablo, arg);
                        break;
                case MAGIC_ATTACK  :
                        tell_object(me, "请输入攻击性法术的名称[如：bighammer, zhenhuo等](随机请输入\"r\")");
                        input_to("get_attack_spell_name", me, new_diablo);
                        break;
                case ADD_ATTRIBUTE :
                        tell_object(me, "请输入天赋属性\n"
                                        "膂力(str)\n"
                                        "胆识(cor)\n"
                                        "悟性(int)\n"
                                        "灵性(spi)\n"
                                        "定力(cps)\n"
                                        "根骨(con)\n"
                                        "容貌(per)\n"
                                        "福缘(kar)\n"
                                        "随机(r)\n\n"
                                        "请输入：");
                        input_to("get_attribute", me, new_diablo);
                        break;
                default :
                        tell_object(me, "请为这项属性指定一个范围 [如：10-20]");
                        input_to("get_ambit", me, new_diablo, arg);
                        break;
        }
}

void get_ambit(string arg, object me, mapping new_diablo, string type)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请为这项属性指定一个范围 [如：10-20]");
                input_to("get_ambit", me, new_diablo, type);
                return;
        }

        new_diablo["diablo"][type] = ({ min, max });
        set_stat(me, new_diablo);
}

void get_skill(string arg, object me, mapping new_diablo)
{
        if( !get_object(SKILL_D(arg)) && arg != "r" ) {
                tell_object(me, "没有这种武功。\n清输入这种武功的名称：");
                input_to("get_skill", me, new_diablo);
                return;
        }

        new_diablo["diablo"][ADD_SKILL] = ([]);
        new_diablo["diablo"][ADD_SKILL][arg] = ([]);
        tell_object(me, "请为这项武功输入一个范围 [如：10-20]");
        input_to("get_skill_level", me, new_diablo, arg);
}

void get_skill_level(string arg, object me, mapping new_diablo, string skill)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请为这项武功输入一个范围 [如：10-20]");
                input_to("get_skill_level", me, new_diablo, skill);
                return;
        }

        new_diablo["diablo"][ADD_SKILL][skill] = ({ min, max });

        set_stat(me, new_diablo);
}

void get_spell(string arg, object me, mapping new_diablo, string type)
{
        tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
        input_to("get_spell_ambit", me, new_diablo, type, arg);
}

void get_spell_ambit(string arg, object me, mapping new_diablo, string type, string type2)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
                input_to("get_spell_ambit", me, new_diablo, type, type2);
                return;
        }

        if( undefinedp(new_diablo["diablo"][type]) )
                new_diablo["diablo"][type] = ([]);

        new_diablo["diablo"][type][type2] = ({ min, max });

        set_stat(me, new_diablo);
}

void get_attack_spell_name(string arg, object me, mapping new_diablo)
{
        tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
        input_to("get_attack_spell_ambit", me, new_diablo, arg);
}

void get_attack_spell_ambit(string arg, object me, mapping new_diablo, string type)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
                input_to("get_attack_spell_ambit", me, new_diablo, type);
                return;
        }

        if( undefinedp(new_diablo["diablo"][MAGIC_ATTACK]) )
                new_diablo["diablo"][MAGIC_ATTACK] = ([]);

        new_diablo["diablo"][MAGIC_ATTACK][type] = ({ min, max });

        set_stat(me, new_diablo);
}

void get_attribute(string arg, object me, mapping new_diablo)
{
        tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
        input_to("get_attribute_ambit", me, new_diablo, arg);
}

void get_attribute_ambit(string arg, object me, mapping new_diablo, string type)
{
        int min, max;

        if( sscanf(arg, "%d-%d", min, max) != 2
        ||  min > max ) {
                tell_object(me, "请为这项属性输入一个范围 [如：10-20]");
                input_to("get_attribute_ambit", me, new_diablo, type);
                return;
        }

        if( undefinedp(new_diablo["diablo"][ADD_ATTRIBUTE]) )
                new_diablo["diablo"][ADD_ATTRIBUTE] = ([]);

        new_diablo["diablo"][ADD_ATTRIBUTE][type] = ({ min, max });

        set_stat(me, new_diablo);
}

void get_appear_chance(string arg, object me, mapping new_diablo)
{
        int chance;

        if( !arg || arg == "" ) chance = 0;
        else {
                if( !( chance = atoi(arg) ) || chance < 0 ) {
                        tell_object(me, "请输入这种物品的出现几率(万分之)：");
                        input_to("get_appear_chance", me, new_diablo);
                        return;
                }
        }

        new_diablo["chance"] = chance;

        tell_object(me, show_diablo(new_diablo));
        tell_object(me, "你确定吗？(y/n)");
        input_to("decide_diablo", me, new_diablo);
}

void decide_diablo(string arg, object me, mapping new_diablo)
{
        if( arg == "y" ) {
                diablo[new_diablo["id"]] = new_diablo;
                if( save() ) tell_object(me, "物品储存完毕。\n");
                else tell_object(me, "物品储存失败。\n");
        } else tell_object(me, "取消....\n");
}

string show_diablo(mapping new_diablo)
{
        string *type, msg;
        mapping diablo_type = ([
                        ADD_SKILL         : "增加武功 [单项]",
                        ADD_ALL_SKILL     : "增加武功 [全部]",
                        ADD_MANA          : "增加法力最大值 [数值]",
                        ADD_FORCE         : "增加内力最大值 [数值]",
                        ADD_KEE           : "增加气血最大值 [数值]",
                        ADD_SEN           : "增加精神最大值 [数值]",
                        KEE_SUB_FORCE     : "气血的伤害转化为内力的减少 [百分比]",
                        KEE_SUB_MANA      : "气血的伤害转化为法力的减少 [百分比]",
                        SEN_SUB_FORCE     : "精神的伤害转化为内力的减少 [百分比]",
                        SEN_SUB_MANA      : "精神的伤害转化为法力的减少 [百分比]",
                        KEE_ADD_FORCE     : "气血的伤害转化为内力的增加 [百分比]",
                        KEE_ADD_MANA      : "气血的伤害转化为法力的增加 [百分比]",
                        SEN_ADD_FORCE     : "精神的伤害转化为内力的增加 [百分比]",
                        SEN_ADD_MANA      : "精神的伤害转化为法力的增加 [百分比]",
                        DAMAGE_ADD_KEE    : "给对方的伤害转化为气血的增加 [百分比]",
                        DAMAGE_ADD_SEN    : "给对方的伤害转化为精神的增加 [百分比]",
                        DAMAGE_ADD_FORCE  : "给对方的伤害转化为内力的增加 [百分比]",
                        DAMAGE_ADD_MANA   : "给对方的伤害转化为法力的增加 [百分比]",
                        DEFENSE_MAGIC     : "增加法术的抵抗",
                        ATTACK_MAGIC      : "增加法术的威力",
                        MAGIC_ATTACK      : "战斗中出攻击性法术",
                        ADD_ATTRIBUTE     : "提高临时天赋属性",
                        MAGIC_FIND        : "MF值 [数值]",
                        ATTACK_BUSY       : "busy攻击者 [百分比]",
                        ADD_DAMAGE        : "加强伤害 [百分比]",
                ]);


        msg  = new_diablo["name"] + "(" + new_diablo["id"] + ")\n";

        if( new_diablo["damage"] )
                msg = sprintf("%s武器种类：%s\n"
                              "武器伤害：%d～%d\n"
                              "武器描述：%s\n"
                              "装备描述：%s\n"
                              "卸下描述：%s\n",
                              msg,
                              new_diablo["skill_type"],
                              new_diablo["damage"][0],
                              new_diablo["damage"][1],
                              undefinedp(new_diablo["long"])?"无":new_diablo["long"],
                              undefinedp(new_diablo["wield_msg"])?"无":new_diablo["wield_msg"],
                              undefinedp(new_diablo["unwield_msg"])?"无":new_diablo["unwield_msg"]);
        else if( new_diablo["armor"] )
                msg = sprintf("%s盔甲种类：%s\n"
                              "盔甲防御：%d～%d\n"
                              "盔甲描述：%s\n"
                              "装备描述：%s\n"
                              "卸下描述：%s\n",
                              msg,
                              new_diablo["armor_type"],
                              new_diablo["armor"][0],
                              new_diablo["armor"][1],
                              undefinedp(new_diablo["long"])?"无":new_diablo["long"],
                              undefinedp(new_diablo["wear_msg"])?"无":new_diablo["wear_msg"],
                              undefinedp(new_diablo["unequip_msg"])?"无":new_diablo["unequip_msg"]);


        if( !new_diablo["diablo"] ) return msg;

        type = keys(new_diablo["diablo"]);

        foreach( string t in type)
                msg = sprintf("%s%s ： %O\n", msg, diablo_type[t], new_diablo["diablo"][t]);

        return msg;
}

string show_all()
{
        string msg = "", *names;

        if( !mapp(diablo) || sizeof(diablo) < 1 )
                return "目前还没有物品。\n";

        names = keys(diablo);

        foreach(string name in names) {
                if( !mapp(diablo[name]) || undefinedp(diablo[name]["name"]) )
                        continue;
                msg = sprintf("%s%s(%s) -- %s\n", msg, diablo[name]["name"],
                diablo[name]["id"], name);
        }

        return msg;
}


void show(object me, string arg)
{
        if( undefinedp(diablo[arg]) || !mapp(diablo[arg]) )
                tell_object(me, "没有这样物品。\n");
        else tell_object(me, show_diablo(diablo[arg]));
}

void delete_diablo(object me, string arg)
{
        if( undefinedp(diablo[arg]) || !mapp(diablo[arg]) )
                tell_object(me, "没有这样物品。\n");
        else {
                map_delete(diablo, arg);
                if( save() )
                        tell_object(me, "物品删除完毕。\n");
                else tell_object(me, "物品删除失败。\n");
        }
}