    }


    //考虑到各方面原因，暂时把死亡的道行改为只有死亡者折损道行 by waiwai@2002/07/13
    if (userp(killer)) {  // killer is user.
      //	     killer->apply_condition("no_pk_time",240+no_pk);
      //	     killer->add("shengwang",-300);//added by waiwai@2002/07/13
      //	     killer->add("impurity",300);//added by waiwai@2002/07/13

      //limit on how many one can pk in a row.
      lose = victim_lose(killer, victim, killerid);
      gain = lose * 8 / 10;
      if (gain < 0) gain = 0;
      // 如果被杀者不是通缉犯，则杀人者被通缉
      // 反之杀人者不受任何惩罚。。。
      if (!victim->query_condition("killer")) {
        victim->delete_temp("last_fainted_from");
        //		killer->apply_condition("no_pk_time",3600+no_pk);
        //		killer->apply_condition("killer", 200);
        //		killer->apply_condition("ghost", 100);
        //Added by waiwai@2002/01/01 
        // Pk者每次减300声望，减善缘1点，加300点罪孽值
        //		killer->add("shengwang",-300);
        //		killer->add("impurity",300);
        //		killer->add("Fimpurity",300);
        if (killer->query("reason") > 0)
          killer->add("reason", -1);
        // 限制 PK(24小时内3人)
        if (killer->query("limit_K") > 0) {
          killer->add("K_user", 1);
          if (killer->query("K_user") >= 3) {
            killer->delete("limit_K");
            killer->delete("K_user");
            killer->set("kill/last_time", time());
          }
        }
      }

      if (lose > 100)
        killer->delete("kill/last_killer");
      victim->set("kill/last_killer", killerid);
      victim->add("kill/pklose", lose);
      victim->add("daoxing", -lose);

      victim_penalty(victim);
      victim->set("killbyB", "所杀");
      killer->add("shengwang", -300);
      killer->add("impurity", 300);
      killer->add("Fimpurity", 300);

      str = chinese_daoxing(lose);
      if (strlen(str) > 1) {
        str = log_id(victim) + "折损" HIR + str + NOR WHT "道行！" NOR;
      }

      //add by dragon for PK rumor
      //added query("short") by waiwai@2002/07/13
      weapon = killer->query_temp("kill_weapon");
      if (weapon && rkmsg) {
        str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + filter_color(killer->name(1)) + "用" WHT + weapon->name() + NOR WHT + rkmsg + "击毙了。" + str + NOR;
        CHANNEL_D->do_channel(this_object(), "xiaodao", str);
      } else {
        if (rkmsg && !weapon) {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + filter_color(killer->name(1)) + "用一招“" HIR + filter_color(rkmsg) + NOR "”" + NOR WHT "打的七窍流血，经脉爆裂而死。" + str + NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        } else if (weapon && !rkmsg) {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + filter_color(killer->name(1)) + "用" HIR + filter_color(weapon->name()) + NOR WHT "打的七窍流血，经脉爆裂而死。" + str + NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        } else {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + filter_color(killer->name(1)) + "杀死了。" + str + NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        }
        bls = 10;
        killer->delete_temp("kill_weapon");
        killer->delete_temp("kill_msg");
      }
    } else {    // killer is not user or killer didn't init the kill.

      last_faint = victim->query_temp("last_fainted_from");
      if (last_faint) {
        fainter = find_player(last_faint);
        if (fainter && userp(fainter)) {
          if (!my_killer_list) init_killer = -1;
          else init_killer = member_array(last_faint, my_killer_list);

          if (init_killer != -1) {
            fainter->apply_condition("ghost", 100);
            fainter->add("shengwang", -300);
            fainter->add("impurity", 300);
            fainter->add("Fimpurity", 300);
            fainter->set("PK_LIMIT", time());
            fainter->apply_condition("killer", 200);
            fainter->apply_condition("no_pk_time", 240 +
              fainter->query_condition("no_pk_time"));

            str = sprintf("%s自卫反击%s,将%s杀死了。",
              victim->name(), fainter->name(), killer->name());
            CHANNEL_D->do_channel(this_object(), "xiaodao", str);
            log_file("death", "[" + log_time() + "] " +
              victim->query("id") + " 自卫反击 " +
              fainter->query("id") + " 被 " +
              killer->query("id") + "杀死.\n");
            victim->set("killbyname", killer->name(1));
            victim->set("killbyid", killerid);
            victim->set("killbytime", tt);
            victim->set("killbycity", kcity);
            if (victim->query("env/makestart")) victim->delete("env/makestart");
            victim->set("killbyB", "所杀");
          }
        }
      }

      victim_penalty(victim);

      bls = 10;
      /////////////////for NK rumor		
      weapon = killer->query_temp("kill_weapon");
      if (weapon && rkmsg) {
        str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + killer->name(1) + NOR WHT "用" WHT + weapon->name() + NOR WHT + rkmsg + "击毙了。" NOR;
        CHANNEL_D->do_channel(this_object(), "xiaodao", str);
      } else {
        if (rkmsg && !weapon) {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + killer->name(1) + NOR WHT "用一招“" HIG + filter_color(rkmsg) + NOR "”" + NOR WHT "打的七窍流血，经脉爆裂而死。" NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        } else if (weapon && !rkmsg) {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + killer->name(1) + NOR WHT "用" WHT + filter_color(weapon->name()) + NOR WHT "打的七窍流血，经脉爆裂而死。" NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        } else {
          str = victim->name(1) + "在" + kcity + filter_color(environment(killer)->query("short")) + "被" + killer->name(1) + NOR WHT "杀死了。" NOR;
          CHANNEL_D->do_channel(this_object(), "xiaodao", str);
        }
      }
    }
  } else {  //NPC is the victim.
    if (userp(killer)) {
      int reward;

      reward = nk_gain(killer, victim);

      if ((int)victim->nk_reward(killer, reward) > 0) {
        // this NPC has its own reward.
      } else if (reward > 0) {
        string msg;
        killer->add("kill/nkgain", reward);
        killer->add("daoxing", reward);
        str = chinese_daoxing(reward);
        tell_object(killer, "\n你得到了" + str + "道行。\n");
        msg = sprintf("%s(%s)<%d)>在" + kcity + NOR WHT "杀死了%s" NOR WHT "(%s)<%d>，得到%s道行。",
          killer->query("name"), killer->query("id"), (killer->query("daoxing") +
            killer->query("combat_exp")) / 2,
          victim->query("name"), victim->query("id"), (victim->query("daoxing") +
            victim->query("combat_exp")) / 2, chinese_daoxing(reward));
        log_file("npc_dxnk", "[" + tt + "] " + msg + "\n");
        CHANNEL_D->do_channel(this_object(), "sys", msg);
      }
    }
    killer->add("MKS", 1);
    bls = 1;
  }

  if (!userp(killer) &&
    ((killer->query("daoxing") + killer->query("combat_exp")) / 10 >
      (victim->query("daoxing") + victim->query("combat_exp")))) bls = 0;

  // NPC got 10 times of bellicosity than user.
  killer->add("bellicosity", bls * (userp(killer) ? 1 : 10));

  if (stringp(vmark = victim->query("vendetta_mark")))
    killer->add("vendetta/" + vmark, 1);


  banghui = (string)victim->query("banghui");

  //Added by waiwai@2003/02/06 
  //添加帮会成员被杀的情况
  if (!wizardp(killer) && userp(killer) && !victim->query_condition("killer")) {
    if (banghui) {
      if (banghui == killer->query("banghui")) {  //同帮间杀戮

        msg2 = banghui + "的" + victim->name(1) + "(" + victim->query("id") + ")在[" + kcity + "]被同帮的" + log_id(killer) + "杀死了。\n\n" NOR;
        message("system", HIY "\n※" HIR "同帮相残" HIY "※" HIG + msg2, users());

        if (userp(victim)) {
          if (killer->query("zhongcheng") && killer->query("BHPJ")) {
            victim->add("zhongcheng", -1);
            killer->add("BHPJ", -1);
            if ((int)killer->query("zhongcheng") >= 10) {
              killer->add("zhongcheng", -10);
              tell_object(killer, HIR "由于屠杀同帮兄弟你被减掉十点帮会忠诚度和一点帮会评价值！！！\n" NOR);
            } else {  //不足10点的有多少减多少，直到0
              killer->add("zhongcheng", -(killer->query("zhongcheng")));
              tell_object(
                killer,
                HIR "由于屠杀同帮兄弟你被减掉" + killer->query("zhongcheng") + "点帮会忠诚度和一点帮会评价值！！！\n" NOR
              );
            }
          } else {  //没有评价和忠诚的就继减声望，因为声望可以为负
            killer->add("shengwang", -50);
            tell_object(killer, HIR "由于屠杀同帮兄弟你被减掉五十点声望！！！\n" NOR);
          }
        } else {  //非玩家减的少些罢
          killer->add("shengwang", -5);
          tell_object(killer, HIR "由于屠杀同帮兄弟你被减掉五点声望！！！\n" NOR);
        }

        //累计在线杀戮的情况的惩罚
        if (userp(victim)) {  //只是杀害玩家加罚
          killer->add_temp("TBSL/" + banghui, 1);

          if ((int)killer->query_temp("TBSL/" + banghui) >= 2) {
            killer->add("shengwang", -100);
            tell_object(killer, HIR "由于连续屠杀同帮兄弟你被加罚减掉一百点声望！！！\n" NOR);
          } else if ((int)killer->query_temp("TBSL/" + banghui) >= 3) {
            killer->add("shengwang", -150);
            tell_object(killer, HIR "由于连续屠杀同帮兄弟你被加罚减掉一百五点声望！！！\n" NOR);
          } else if ((int)killer->query_temp("TBSL/" + banghui) >= 4) {
            killer->add("shengwang", -200);
            tell_object(killer, HIR "由于连续屠杀同帮兄弟你被加罚减掉二百点声望！！！\n" NOR);
          }
        }

        {
          lp = new("/obj/lingpai");
          lp->create(banghui);
          if ((string)lp->query("bangzhu_id") == victim->query("id")) {
            destruct(lp);
            if (userp(victim)) {  //帮主是玩家
              killer->add("shengwang", -1000);
              killer->add("impurity", 1000);
              killer->set("zhongcheng", 0);
              killer->set("BHPJ", 0);
              tell_object(killer, HIR "由于连续残害同帮帮主你被加罚减掉一千点声望和所有帮会值降为0！\n" NOR);
              tell_object(killer, HIR "你的帮会评价和帮会忠诚度全部清零！\n" NOR);
              tell_object(killer, HIR "你的罪孽增加了一千点！\n" NOR);
            }
          }
          destruct(lp);
        }
        killer->save();

      } else {  //异帮间杀戮
        lp = new("/obj/lingpai");
        lp->create(banghui);
        if ((string)lp->query("bangzhu_id") == victim->query("id")) {
          destruct(lp);
          if (userp(victim)) {  //帮主是玩家
            killer->add("shengwang", -500);
            killer->add("impurity", 500);
            killer->set("vendetta/" + banghui, 1);  //直接追杀
            killer->set("ZSbanghui", victim->query("banghui"));
            killer->apply_condition("bhzs", 100);
            killer->set("vendettaBT", time());
            message("channel:rumor",
              HIR "┋帮会追杀令┋" HIR + victim->name() + "：帮会 " HIW + banghui + HIR " 通告天下：" HIR "

			大胆狂徒" + killer->name(1) + "(" + killer->query("id") + ")

			杀我帮主！辱帮门威！
			帮内成员！如见此人！
			格杀无论！不死不休！\n\n" NOR, users());

            tell_object(killer, HIR "由于残害异帮帮主你被减掉五百点声望！\n" NOR);
            tell_object(killer, HIR "你的罪孽增加了五百点！\n" NOR);
          }
          destruct(lp);
          killer->save();

        } else {
          //下面的Add不能简单设定，避免杀不同帮会的而判断混淆
          //这里采用了具体帮会具体累计的算法，有待检验是否有问题
          if ((int)killer->query("BHSL/" + banghui) < 2) {
            killer->add("BHSL/" + banghui, 1);
            killer->add("shengwang", -1);
            killer->add("impurity", 1);

            msg2 = banghui + "的" + log_id(victim) + "在[" + kcity + "]被" + killer->query("banghui") + "的" + log_id(killer) + "杀死了。\n\n" NOR;
            message("system", HIY "※" HIR "帮会杀戮" HIY "※" HIG + msg2, users());
            tell_object(killer, HIW + killer->name() + "你的江湖声望下降了一点！！！\n\n" NOR);
            tell_object(killer, HIR "你的罪孽增加了一点！\n" NOR);

          } else {  //大于等于三次就会被系统下追杀令
            victim->add("zhongcheng", -1);
            killer->set("ZSbanghui", victim->query("banghui"));
            killer->apply_condition("bhzs", 100);
            killer->set("vendettaBT", time());
            killer->set("vendetta/" + banghui, 1);
            killer->add_temp("hatred/" + banghui, 1);
            if (killer->query("BHSL/" + banghui)) { killer->delete("BHSL/" + banghui); }
            msg2 = banghui + "的" + log_id(victim) + "在[" + kcity + "]被"
              +killer->query("banghui") + "的" + log_id(killer) + "杀死了。\n\n" NOR;
            message("system", HIY "※" HIR "帮会杀戮" HIY "※" HIG + msg2, users());

            message("channel:rumor",
              HIR "┋帮会追杀令┋" HIR + victim->name() + "：帮会 " HIW + banghui + HIR " 通告天下：" HIR "

　　　　　　  大胆狂徒" + killer->name(1) + "(" + killer->query("id") + ")

　　　　　　  杀我兄弟！辱帮门威！
　　　　　　  帮内成员！如见此人！
　　　　　　  格杀无论！不死不休！\n\n" NOR, users());

            //累计在线杀戮的情况的惩罚 
            //这里暂定为杀害玩家加罚，排除被杀者是通缉犯的情况
            if (userp(victim) && userp(killer) && !victim->query_condition("killer")) {
              if ((int)killer->query_temp("hatred/" + banghui) >= 1) {  //这里等于连续杀人3个
                killer->add("shengwang", -30);
                killer->add("impurity", 5);
                tell_object(killer, HIW + killer->name() + "由于你杀戮江湖，声望下降三十点！！！\n\n" NOR);
                tell_object(killer, HIR "你的罪孽增加了五点！\n" NOR);
              } else if ((int)killer->query_temp("hatred/" + banghui) >= 2) {  //这里等于连续杀人6个
                killer->add("shengwang", -60);
                killer->add("impurity", 5);
                tell_object(killer, HIW + killer->name() + "由于你连续杀戮江湖，声望下降六十点！！！\n\n" NOR);
                tell_object(killer, HIR "你的罪孽增加了五点！\n" NOR);
              } else if ((int)killer->query_temp("hatred/" + banghui) >= 3) {  //这里等于连续杀人9个
                killer->add("shengwang", -100);
                killer->add("impurity", 5);
                tell_object(killer, HIW + killer->name() + "由于你连续杀戮江湖，声望下降一百点！！！\n\n" NOR);
                tell_object(killer, HIR "你的罪孽增加了五点！\n" NOR);
              } else if ((int)killer->query_temp("hatred/" + banghui) >= 4) {  //这里等于连续杀人12个
                killer->add("shengwang", -200);
                killer->add("impurity", 5);
                tell_object(killer, HIW + killer->name() + "由于你连续杀戮江湖，声望下降二百点！！！\n\n" NOR);
                tell_object(killer, HIR "你的罪孽增加了五点！\n" NOR);
              } else if ((int)killer->query_temp("hatred/" + banghui) >= 5) {  //这里等于连续杀人15个
                killer->add("shengwang", -300);
                killer->add("impurity", 5);
                tell_object(killer, HIW + killer->name() + "由于你连续杀戮江湖，声望下降三百点！！！\n\n" NOR);
                tell_object(killer, HIR "你的罪孽增加了五点！\n" NOR);
              }
            }


          }

        }
      }
    }
  }

  /*
	//added by waiwai@2002/07/13 这里作为扩展应用，暂时放这，将来需要根据应用再加以改进.
	if( victim->query("longku") )
		if ( objectp(killer)&&interactive(killer) ) {
			level = victim->query("family/generation");
			pot = 800 - level*2;
			exp = 2300 - level*100;
			killer->add("combat_exp",exp);
			killer->add("potential",pot);
			killer->add("daoxing",800);
			tell_object(killer,HIW"你英勇杀敌有功，得到如下奖励：\n");
			tell_object(killer,chinese_number(exp) +"点武学经验\n" +
				chinese_number(pot) + "点潜能和二百天道行。\n"NOR);

        CHANNEL_D->do_channel( this_object(), "sys",
        sprintf("龙窟中"HIR"%s(%s)"NOR WHT"得到%s点武学和%s点潜能以及200天道行。", 
killer->name(),killer->query("id"), chinese_number(exp),chinese_number(pot)));
	  log_file("hj_kill","["+ctime(time())+"] 龙窟中"+killer->name()+"("+
killer->query("id")+")得到"+chinese_number(exp)+"点武学和"+chinese_number(pot)+"点潜能以及200天道行！\n");

			killer->add_temp("hj_killer",1);
		}
*/


  //added by waiwai@2002/07/13 添加追辑时捕头被杀时给玩家的惩罚
  if (victim->query("butou"))
    if (objectp(killer) && interactive(killer)) {
      killer->add("office_number", -50);
      killer->add("shengwang", -100);
      killer->add("impurity", 300);
      killer->add("Fimpurity", 300);
      message("system", HIW "┋官府通报┋由于 " HIY + killer->name() +
        HIW " 草菅人命杀死朝廷捕头，折损官职五十点，声望一百点，罪孽增加三百点！！！\n" NOR, users());
      tell_object(killer, HIR "你折损掉五十点官职一百点声望，罪孽增加三百点！！！\n");
    }

  // Added by waiwai@2001/05/11 添加宠物坐骑被杀时给玩家的惩罚
  if (victim->query("is_pet") && userp(killer))
    if (objectp(killer) && interactive(killer)) {
      log_file("player/petkill_log", "[" + log_time() + "] " + victim->name(1) +
        "在" + COLOR_D->clean_color(MISC_D->find_place(environment(killer))) + " 被 " + log_id(killer) + " 杀死了！\n");
      killer->add("office_number", -10);
      killer->add("shengwang", -5);
      killer->add("impurity", 10);
      killer->add("limit_pet", 1);
      message("system",
        HIW "┋官府通报┋" HIY + log_id(killer) + HIW "草菅生灵杀死宠物坐骑" + victim->name() + HIW "，加罪孽十点并减罚十点官职五点声望！！！\n" NOR, users());
      tell_object(killer, HIR "你被减掉十点官职五点声望，罪孽长了十点！！！\n" NOR);
    }

  if (userp(killer)) killer->save();
  if (userp(victim)) victim->save();
}
/**********************************************************************************/

void victim_penalty(object victim) {
  int i;

  //By waiwai@2002/07/13 损失由*/40 改为 */80
  int combat_exp_loss = (int)victim->query("combat_exp") / 80;
  int dx_loss = (int)victim->query("daoxing") / 80;

  victim->clear_condition();
  victim->set("bellicosity", 0);
  victim->add("office_number", -10);  //added by waiwai@2002/07/13  
  victim->add("death/office", 10);  //

  i = victim->query_condition("no_pk_time");
  if (i > 240) victim->apply_condition("no_pk_time", i - 80);

  victim->set("death/mud_age", victim->query("mud_age"));
  victim->set("death/combat_exp_loss", combat_exp_loss);
  victim->add("death/comloss", combat_exp_loss);  //

  victim->set("death/dx_loss", dx_loss);
  victim->add("death/dxloss", dx_loss);  //

  log_file("death", log_id(victim) +
    " 损失武学 " + combat_exp_loss + " 点， 损失道行" + dx_loss + "点.时间在：[" + log_time() + "]\n");

  victim->add("combat_exp", -combat_exp_loss);
  victim->add("daoxing", -dx_loss);
  //added by waiwai@2002/07/13
  //被杀者虽然有些无辜，但是也属于学艺不精或者不能很好地适应江湖.
  victim->add("shengwang", -100);
  victim->add("death/shengwang", 100);  //

  victim->add_temp("DIE", 1);

  victim->delete("vendetta");
  if (victim->query("thief"))
    victim->set("thief", (int)victim->query("thief") / 2);
  if ((int)victim->query("potential") > (int)victim->query("learned_points"))

    //By waiwai@2002/07/13 potential lost */2 changed */3
    victim->add("potential",
      ((int)victim->query("learned_points") - (int)victim->query("potential")) / 3);

  victim->add("death/qianneng", -
    (((int)victim->query("learned_points") - (int)victim->query("potential")) / 3));  //

  //        if(random(100)>(int)victim->query("kar")) {
  //changed by waiwai@2002/07/13 由先天福缘决定一切？似乎不适合点
  //这里改变为20岁以前不损失，20岁以后由后天罪孽参数决定skills的损失
  if ((int)victim->query("age") > 20) {
    if ((int)victim->query("impurity") > 200 + random(100)) {
      victim->set("death/skill_loss", 1);
      victim->skill_death_penalty();
      tell_object(victim, HIR "你所有的武功损失一级！！！\n");
    } else
      victim->set("death/skill_loss", 0);
  }
  victim->save();
}
/**********************************************************************************/

int nk_gain(object killer, object victim) {
  string fam, fam1;
  int cla, eff_dx, eff1, eff2, dx, reward, nkgain;

  if (victim->query("no_nk_reward")) return 0;

  //added by waiwai@2002/07/13
  //战斗结束，怒气消失
  killer->set("anger", 0);
  victim->delete_temp("anger_attack");
  victim->set("anger", 0);
  killer->delete_temp("anger_attack");
  //end

  if (victim->query_temp("last_fainted_from")
    && victim->query_temp("last_fainted_from") !=
    killer->query("id")) return 0;

  fam = killer->query("family/family_name");

  if (fam && !undefinedp(family[fam])) {  //player must have a
    //family.
    cla = family[fam];
    eff_dx = victim->query("eff_dx");
    nkgain = victim->query("nkgain");

    fam1 = victim->query("family/family_name");
    if (fam1 && fam == fam1)
      return 0;

    if (eff_dx != 0 && cla * eff_dx > 0)
      return 0;
    if (!eff_dx) {

      int dxn = 0;

      eff_dx = (victim->query("daoxing") +
        victim->query("combat_exp")) / 2;
      if (eff_dx > 20000)
        dxn = eff_dx / 3;
      else if (eff_dx > 5000)
        dxn = eff_dx / 2;
      else
        dxn = eff_dx;
      //make it easier for newbie.
      eff_dx = dxn;
    }

    if (!nkgain) {
      int effdx = eff_dx;

      if (effdx < 0) effdx = -effdx;

      if (effdx > 667000)
        nkgain = 600;
      else if (effdx > 333000)
        nkgain = 500;
      else if (effdx > 100000)
        nkgain = 400;
      else if (effdx > 33000)
        nkgain = 300;
      else if (effdx > 17000)
        nkgain = 200;
      else if (effdx > 5000)
        nkgain = 150;
      else if (effdx > 2000)
        nkgain = 100;
      else if (effdx > 500)
        nkgain = 50;
      else nkgain = 25;

      nkgain = nkgain + 20;
    }

    if (eff_dx < 0) eff_dx = -eff_dx;
    eff1 = eff_dx / 8;
    eff2 = eff_dx / 4;
    dx = (killer->query("daoxing") +
      killer->query("combat_exp")) / 2;
    if (dx > eff_dx) reward = 0;
    else if (dx > eff2) reward = nkgain;
    else if (dx > eff1) reward = 10 * (dx - eff1) / (eff2 - eff1) * nkgain / 10;
    else reward = 0;

    if (cla == 0 || (cla != 0 && !fam1)) reward = reward * 2 / 3;
    //cla==0: people not xian and not yao. e.g. longgong, moon.
    //cla!=0: people either xian or yao. if they kill
    //        no family NPC, dx reward reduse.

    return reward;

  }
  return 0;
}
/**********************************************************************************/

int victim_lose(object killer, object victim, string killerid) {
  int lose, exp_k, exp_v;
  int lose1;

  if ((wizardp(victim) && !wizardp(killer))
    || (!wizardp(victim) && wizardp(killer)))
    return 0;

  if (victim->query_temp("last_fainted_from")
    && victim->query_temp("last_fainted_from") !=
    killerid) {
    lose = 0;
  } else {
    exp_k = killer->query("daoxing");
    exp_v = victim->query("daoxing");
    if (exp_k > exp_v) {
      lose = 10 * exp_v / (exp_k + 1) * (4000 + exp_v) / 500;
      // a exp_v/exp_k pre-factor.
      if (exp_k > exp_v * 4) lose = 0;
      // if less then 1/4 dx, then no damage.
    } else {
      lose = (4000 + exp_v) / 50;  // about 2% lose for victim.
    }
    if (lose < 0) lose = 0;
    if (lose > exp_v) lose = exp_v;
  }

  // this is the maximum lose.
  lose1 = (int)victim->query("daoxing") / 40;
  if (lose > lose1) lose = lose1;

  return lose;
}

string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) str = str + chinese_number(year) + "年";
  if (day) str = str + chinese_number(day) + "天";
  if (hour) str = str + chinese_number(hour) + "时辰";

  return str;
}

int check_family(string fam) {
  if (fam && !undefinedp(family[fam]))
    return family[fam];
  else
    return 0;
}


//the following functions are for performs...weiqi
//copy and modified from spelld.c
int attacking_perform_success(object attacker, object target, int skill_level, int success_adj) {
  int ap, dp, success;

  ap = (skill_level * skill_level * skill_level / 10);  //this is from skill.
  //at high exp, the skill level can not follow, so need adjustment here.
  ap = ap * (1 + attacker->query("combat_exp") / 500000);
  ap = ap + attacker->query("combat_exp");
  dp = target->query("combat_exp");

  success = 0;

  if (success_adj < 20) success_adj = 20;
  else if (success_adj > 500) success_adj = 500;

  ap = ap * success_adj / 100;

  if (random(100) > dp * 100 / (ap + dp)) success = 1;

  return success;
}

int attacking_perform_damage(object attacker, object target, int damage_adj) {
  int a_neili, d_neili, damage;

  if (damage_adj < 50) damage_adj = 50;
  else if (damage_adj > 200) damage_adj = 200;

  //will use current neili...but do not allow it exceeds 2 time of the max.
  a_neili = attacker->query("force");
  if (a_neili > 2 * attacker->query("max_force")) a_neili = 2 * attacker->query("max_force");
  d_neili = target->query("force");
  if (d_neili > 2 * target->query("max_force")) d_neili = 2 * target->query("max_force");


  //neili and qi. weaker than cast here...
  damage = (a_neili - d_neili) / 30 + random(attacker->query("eff_kee") / 30) - random(target->query("eff_kee") / 30);

  //mana_factor, here the attacker has some advantage.
  //the damage_adj higher, the better for attacker.
  damage += (3 * damage_adj / 200)  //weaker than cast here...
  * (attacker->query("force_factor") - random(target->query("force_factor")));

  //for backfire, we need let it be serious...
  if (damage < 0) damage = damage - target->query("force_factor");
  //here increase the damage, since previously it's included in random()

  damage = damage * damage_adj / 100;  //last damage scaled again.

  //finally, we need let the force level useful...
  //the setting is, at enabled level 200, the damage will double.
  if (damage > 0) {
    damage += (damage * (int)attacker->query_skill("force")) / 200;
  } else if (damage < 0) {
    damage += (damage * (int)target->query_skill("force")) / 200;
  }


  return damage;
}

void attacking_perform(
  object attacker,
  object target,
  int skill_level,  //the level of skill used to attack.
  int success_adj,
  int damage_adj,  //default value is 100 for this 2 parameters.
  string damage_type,  //must be "shen"/"sen", "qi"/"kee" or "both"(default)
  string msg_init,
  string msg_success,
  string msg_fail,
  string msg_backfire_init,
  string msg_backfire_success) {
  int damage;

  //first, show the initial message...
  message_vision(msg_init, attacker, target);

  //calculate if the casting can happen...
  if (attacking_perform_success(attacker, target, skill_level, success_adj) == 0) {
    message_vision(msg_fail, attacker, target);
    //let the target kill attacker.
    target->kill_ob(attacker);
    return;
  }

  damage = attacking_perform_damage(attacker, target, damage_adj);

  if (damage > 0)  //attacker hit target
    SPELL_D->apply_damage(attacker, target, damage, damage_type, msg_success);

  else if (damage < 0)  //backfire
  {
    message_vision(msg_backfire_init, attacker, target);
    SPELL_D->apply_damage(target, attacker, -damage, damage_type, msg_backfire_success);
  }

  else  //damge=0
    message_vision(HIB "结果正好被$N以内力逼住，谁也没有吃亏。\n" NOR, target);

  //let the target kill attacker.
  target->kill_ob(attacker);

  return;
}
/**********************************************************************************/
//added by waiwai@2002/07/13 这里暂留系统扩展应用
//调动此函数，相当于直接打中敌人，敌人一样会受到伤害
int do_attack_damage(object me, object victim, object weapon) {
  mapping my, your, action;
  string result;
  string attack_skill, force_skill, martial_skill;
  mixed foo;
  int damage, damage_bonus, defense_factor;

  my = me->query_entire_dbase();
  your = victim->query_entire_dbase();
  action = me->query("actions");
  damage = me->query_temp("apply/damage");
  damage = (damage + random(damage)) / 2;
  if (action["damage"])
    damage += action["damage"] * damage / 100;

  damage_bonus = me->query_str();

  // Let force skill take effect.
  if (my["force_factor"] && (my["force"] > my["force_factor"])) {
    if (force_skill = me->query_skill_mapped("force")) {
      foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
      if (stringp(foo)) result += foo;
      else if (intp(foo)) damage_bonus += foo;
    }
  }

  if (action["force"])
    damage_bonus += action["force"] * damage_bonus / 100;

  if (martial_skill = me->query_skill_mapped(attack_skill)) {
    foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) result += foo;
    else if (intp(foo)) damage_bonus += foo;
  }

  // Let weapon or monster have their special damage.
  if (weapon) {
    foo = weapon->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) result += foo;
    else if (intp(foo)) damage_bonus += foo;
  } else {
    foo = me->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) result += foo;
    else if (intp(foo)) damage_bonus += foo * 3 / 4;
  }

  if (damage_bonus > 0)
    damage += (damage_bonus + random(damage_bonus)) / 2;
  if (damage < 0) damage = 0;

  // Let combat exp take effect
  defense_factor = your["combat_exp"];
  while (random(defense_factor) > my["combat_exp"]) {
    damage -= damage / 3;
  }

  damage = victim->receive_damage("kee", damage, me);

  if ((me->is_killing(victim) || weapon)
    && random(damage) > (int)victim->query_temp("apply/armor")) {
    // We are sure that damage is greater than victim's armor here.
    victim->receive_wound("kee",
      damage - (int)victim->query_temp("apply/armor"), me);
    //wounded = 1;
  }
  return damage;
}
/**********************************************************************************/

void rulaitaskdie(object victim, object killer) {
  string str, kind;

  kind = victim->query("rulaitask/kind");

  if (!victim || !killer)
    return;

  tell_object(victim, HIY "\n\n奄奄一息之际，你忽觉西方射来一道金光，接着就什么都不知道了……\n\n" NOR);
  victim->unconcious();

  switch (kind) {
    case "杀":
      str = victim->query("name") + YEL "杀" + killer->name() + "不成，反而断送了性命！";
      break;
    case "擒":
      str = "如来请" + victim->query("name") + YEL "捉拿" + killer->name() + "，却死丧九泉！";
      break;
    case "劝":
      str = victim->query("name") + YEL "想劝" + killer->name() + "归依我佛，不料惨遭毒手！";
      break;
    case "降":
      str = victim->query("name") + YEL "妄想教训" + killer->name() + "一顿，结果弄巧成拙，反而断送自己性命。";
      break;
    default:
      str = victim->query("name") + YEL "被" + killer->name() + "逼入绝路，多亏如来出手相救，才幸免一死。";
  }

  message("system", YEL "「" WHT "灵山传音" YEL "」：" + str + NOR + "\n", users());

  if (!userp(killer)) destruct(killer);
  victim->add("combat_exp", -3000);
  victim->add("daoxing", -3000);
  victim->delete("rulaitask/get");
  victim->set("rulaitask/fail", 1);
  victim->set("kee", 100);
  victim->set("eff_kee", this_object()->query("max_kee") / 2);
  victim->set("eff_sen", this_object()->query("max_sen") / 2);
  victim->set("sen", 100);
  victim->add("rulaitask_log/die", 1);
}
