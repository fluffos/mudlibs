// [1;31m此文件禁止随意更改任何设置[0m
// Created by waiwai@2000/10/06
// Update by waiwai@2001/03/10
// 可单独关闭系统的某个频道，关闭后任何人无法使用
// 该频道，避免类似潭际频道的混乱而无法制止的问题
// 也可全部关闭系统的所有的公用频道( chblk forever)
// 比如 chblk chat 则整个系统的聊天频道被关闭掉而
// 无法使用了，巫师不在限制之列
// Update by xigua@2002/05/23
// 定义时间，如果xxx为forever, 则永远关闭
// Last modified by waiwai@2003/01/15
// 频道管理设置请阅读 chblk.c unchblk.c vote.c 等
// 文件。频道目前采用硬性设置，在 Login.c 和 Quit.c 
// 里面配合设置，根据系统级别自动设定用户可收听的频
// 道种类。Tune.c 指令目前可查看用户的频道收听情况，
// 并可单独关闭某用户的某个频道。。。

#pragma save_binary

#include <mudlib.h>
#include <command.h>
#include <net/dns.h>
#include <net/macros.h>
#include <localtime.h>
inherit F_SAVE;

inherit F_DBASE;
string remove_addresses(string, int all);
#define ALLOW_LIST ({ })
#define SPECIAL_NPC     ({ "/adm/npc/youxun" })

#define RRUM 20
string record;

