// Added by waiwai@2003/04/12
int howmany_wiz() {
  string *wizlist = explode(read_file("/adm/etc/wizlist"), "\n");
  return sizeof(wizlist);
}

// Added by waiwai@2003/04/12
int howmany_user() {
  int i, ppl_cnt;
  string *dir, *ppls;
  seteuid(getuid());
  ppl_cnt = 0;
  dir = get_dir(DATA_DIR + "login/");
  for (i = 0; i < sizeof(dir); i++) {
    reset_eval_cost();
    ppls = get_dir(DATA_DIR + "login/" + dir[i] + "/");
    ppl_cnt += sizeof(ppls);
  }
  return ppl_cnt;
}

void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
  set("id", "logind");

  // Added by waiwai@2003/04/12
  if (file_size("/log/ppls") > 0) sscanf(read_file("/log/ppls"), "%d", ppls);

  legalid = explode(read_file(BANNED_ID), "\n");

  if (!MISC_D->check_date()) { shutdown(-1); return; }
}

// mon 11/7/98
void logind_user_log() {
  int user = sizeof(users());
  int total;

  remove_call_out("logind_user_log");
  rm("/log/user_count"); log_file("user_count", "" +
    ((total = total_count) ? total : user) + "\n" +
    user + "\n" +
    UPTIME_CMD->report_str() + "\n" +
    "西游记\n");
  call_out("logind_user_log", 600);
}

int total_players() {
  mapping mud_list;
  mixed *muds;
  string output;
  int loop, size, nb, total = 0;

  if (!find_object(DNS_MASTER))
    return 0;

  mud_list = (mapping)DNS_MASTER->query_muds();
  if (!mud_list)
    return 0;

  muds = keys(mud_list) - ({ "DEFAULT" });
  for (loop = 0, size = sizeof(muds); loop < size; loop++) {
    if (mud_list[muds[loop]]["MUDLIB"] == "A Journey to the West" &&
      !undefinedp(mud_list[muds[loop]]["USERS"])) {
      sscanf(mud_list[muds[loop]]["USERS"], "%d", nb);
      total += nb;
    }
  }

  total_count = total;
  return total;
}

void logon(object ob) {
  // Added By pkyou@xyj 2002/08/30
  // Fix logind use reconnet
  object *online_user;
  object hacker;
  int logon_cnt;
  int i;

  online_user = filter_array(children(LOGIN_OB), (: interactive :));
  i = sizeof(online_user);
  logon_cnt = 0;
  while (i--) {
    if (query_ip_number(online_user[i]) == query_ip_number(ob))
      logon_cnt = logon_cnt + 1;
  }

  // WASM/loopback exempt from the concurrent-connection cap (§1.3e).
  if (logon_cnt > 8 && !"/adm/daemons/band"->is_local_ip(query_ip_number(ob))) {

    write("您的地址同时有太多玩家连线，请稍候再尝试。\n");
    destruct(ob);
    return;
  }
#ifdef GB_AND_BIG5
  cat(BANNER);
  write("            西游记欢迎您来访！使用国标码的玩家请键入：gb\n");
  write("           ﹁村癘舧眤ㄓ砐ㄏノき絏產叫龄big5\n\n");
  write("    [If there is no response after ENTER, please try Ctrl-ENTER]\n");
  write("        [提示：如果按ENTER键后系统没有响应，请试 Ctrl-ENTER]\n\n\n");
  write("         Welcome to Xi You Ji! Select GB or BIG5 (gb/big5):");
  input_to((: encoding :), ob);
#else
  encoding("gb", ob);
#endif

}

private void encoding(string arg, object ob) {
  object *usr;
  int i, ttl_cnt, wiz_cnt, ppl_cnt, login_cnt, inv_wiz_cnt, ip_cnt;
  string ip_name, ip_number, vip;
  int ii;
  mixed info;
  int encode;
  int user_num, X;

  if (!arg || arg == "") {
    write("\nSelect 国标码 GB or き絏 BIG5 (gb/big5):");
    input_to((: encoding :), ob);
    return;
  } else if (arg[0..0] == "g" || arg[0..0] == "G")
    encode = 0;
  else if (arg[0..0] == "b" || arg[0..0] == "B")
    encode = 1;
  else {
    write("\nSelect 国标码 GB or き絏 BIG5 (gb/big5):");
    input_to((: encoding :), ob);
    return;
  }

  // Added by waiwai@2003/04/12
  if (encode == 0)
    write(NOR MAG "\n\t\t您选择了使用GB简体中文编码格式进入西游记\n" NOR);
  else
    write(NOR MAG "\n\t\t\tUse BIG5 encoded Chinese Login XYJ.\n" NOR);

  ob->set_encoding(encode);

  ip_name = query_ip_name(ob);
  ip_number = query_ip_number(ob);
  //	vip = read_file("/data/vip",1);
  vip = read_file("/log/vip", 1);

  if (new_start == 0) {  //only check for once.
    // AGENTS.md §15ab/§15p/§15u: originally `!find_object(DNS_MASTER)
    // || !check_ip_(...)` -- with DNS_MASTER excluded from preload
    // (this driver has no working intermud DNS resolution), the
    // ORIGINAL condition unconditionally evaluated true on the very
    // first connection (find_object(DNS_MASTER) always null),
    // calling shutdown(1) and taking down the whole server before
    // any player ever reached a prompt. Since check_ip_() itself is
    // already a hardcoded `return 1;` stub (see adm/daemons/band.lpc),
    // this whole gate only ever existed to punish a missing/
    // unreachable intermud daemon -- now requires DNS_MASTER to
    // actually be loaded before it can fire at all.
    if (find_object(DNS_MASTER) && !"/adm/daemons/band"->check_ip_(
      DNS_MASTER->get_host_name(mud_nname()))) {
      log_file("shutdown", "Shutdown IP " +
        DNS_MASTER->get_host_name(mud_nname()) +
        " " + ctime(time()) + "\n");
      shutdown(1);
      return;
    }
    new_start++;
  }

  //log all connections.
  log_file("ALLCONT", sprintf("IP_name--number  %s--%s (%s)\n", ip_name,
    ip_number, ctime(time())));

  if ("/adm/daemons/band"->is_strict_banned(query_ip_number(ob)) == 1) {
    write(HIR "由于您的地址存在游戏者违反游戏规则的行为存在。目前您的地\n" NOR);
    write(HIR "址已被禁止连线这个游戏。如要申诉请发往:wkzstory@21cn.com\n" NOR);
    destruct(ob);
    log_file("limitlogin", sprintf("kicked out, strict_banned\n"));
    return;
  }

  if (!ip_name) {
    destruct(ob);
    log_file("ALLCONT", sprintf("kicked out, No IP\n"));
    return;
  }

  for (ii = 0; ii < sizeof(ip_number); ii++) {
    if ((ip_number[ii] != '.') && (ip_number[ii] > '9')) {
      destruct(ob);
      log_file("ALLCONT", sprintf("kicked out, Non_number\n"));
      return;
    }
  }

  // Added by waiwai@2003/04/12
  write("\n");
  printf("%s『" BBLU " %s " NOR "』主页网络地址：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, MUD_WEB);
  printf("%s『" BBLU " %s " NOR "』目前使用版本：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, MUDLIB_VERSION_NUMBER);
  printf("%s『" BBLU " %s " NOR "』系统核心驱动：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, MUDLIB_VERSION_MUDOS);
  printf("%s『" BBLU " %s " NOR "』档案保留时限：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, PURGE_TIMES);
  printf("%s『" BBLU " %s " NOR "』连线总额上限：" YEL "%d" NOR "\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, (MAX_USERS));
  printf(
    "%s『" BBLU " %s " NOR "』站点创建时间：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME,
    INTERMUD_NAME,
    MUD_BIND
  );

  user_num = howmany_user();
  X = user_num / 24;
  //	if( X<365 ) X=user_num/24;

  printf("%s『" BBLU " %s " NOR "』平均每日注册：" YEL "%d" NOR "人\n", CHINESE_MUD_NAME, INTERMUD_NAME, X);

  if (user_num != 0) {
    printf("%s『" BBLU " %s " NOR "』档案注册状态：" YEL "%d" NOR "位管理人员，" YEL "%s" NOR "位会员用户，" YEL "%d" NOR "位普通用户\n",
      CHINESE_MUD_NAME, INTERMUD_NAME, (howmany_wiz()), vip, (howmany_user() - howmany_wiz()));

  }
  printf("%s『" BBLU " %s " NOR "』累计访问统计：" YEL "%d" NOR "人次\n",
    CHINESE_MUD_NAME, INTERMUD_NAME, (ppls));
  printf(
    "%s『" BBLU " %s " NOR "』游戏连线地址：" YEL "%s" NOR "\n",
    CHINESE_MUD_NAME,
    INTERMUD_NAME,
    MUD_IP
  );

  PORT_CMD->main();
  UPTIME_CMD->main();
  XYJTIME_CMD->main();
  TIME_CMD->main();

  // children will show both netdead and interactive users.
  usr = children(USER_OB);
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  inv_wiz_cnt = 0;
  ip_cnt = 0;

  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i]) && usr[i]->query("env/invisibility")) inv_wiz_cnt++;
    else if (wizardp(usr[i]) && !usr[i]->query("env/invisibility")) wiz_cnt++;
    else {
      if (query_ip_name(ob) == query_ip_name(usr[i])) ip_cnt++;
      ppl_cnt++;
    }
  }
  if ((ppl_cnt - inv_wiz_cnt) < 0) ppl_cnt - inv_wiz_cnt = 0;

  printf(GRN "────────────────────────────────────────────\n" NOR);
  ttl_cnt = total_players();
  if (ttl_cnt == 0)
    printf("目前");  // info not available
    else
      printf("系列站点目前共有%d位玩家在线上。本站", ttl_cnt);

  printf("共有%d位巫师、%d位玩家，以及%d位在尝试连线。\n\n",
    wiz_cnt, ppl_cnt - inv_wiz_cnt, login_cnt);

  // mon 11/7/98
  //check whether user_log still running.
  info = filter_array(call_out_info(), (: $1[1] == "logind_user_log" :));
  if (!sizeof(info)) logind_user_log();

  if (ob) ob->set_temp("id_count", 0);

#ifndef GB_AND_BIG5
  write("[提示：如果按ENTER键后系统没有响应，请试 Ctrl-ENTER]\n\n");
#endif

  // Added by waiwai@2003/04/20
  if (REBOOT_CMD->is_rebooting())
    write(HIY "现在本站正处于重新启动倒计时中，如果您不是巫师，请稍候再连线您的人物。。。\n\n" NOR);

  write("西游记提醒您：网络游戏只适用于业余消遣，沉迷网络游戏有害身心健康。\n");
  write("请您做出选择：① 进入(Enter)  ② 离开(Exit)");
  input_to((: if_young :), ob);
}

private void if_young(string arg, object ob) {
  int id_count;

  id_count = ob->query_temp("id_count");
  id_count++;
  ob->set_temp("id_count", id_count);
  if (id_count > 3) {
    destruct(ob);
    log_file("ALLCONT", sprintf("kicked out, illegal ID.\n"));
    return;
  }

  if (arg == "\1" || arg == "") {
    write("①进入(Enter) ②离开(Exit)");
    input_to((: if_young :), ob);
    return;
  }

  if (arg[0..0] == "2" || arg[0..0] == "2") {
    write("\n很高兴您能认识到网络游戏的危害，再见。\n");
    destruct(ob);
  }

  if (arg[0..0] != "1" && arg[0..0] != "1") {
    write("①进入(Enter) ②离开(Exit)");
    input_to((: if_young :), ob);
    return;
  }

  cat(XYJ_SITES);
  write("\n您的英文名字：（新玩家请键入 new 注册）");
  input_to((: get_id :), ob);
}

private void get_id(string arg, object ob) {
  object ppl, *usr = children(USER_OB);
  int id_count;

  //edw 6/2/98
  int NowLogin, MaxLimit, login_site, i;
  string my_ip, new_ip;
  //end edw

  if (!ob) return;

  id_count = ob->query_temp("id_count");
  id_count++;
  ob->set_temp("id_count", id_count);
  if (id_count > 6) {
    destruct(ob);
    log_file("ALLCONT", sprintf("kicked out, illegal ID.\n"));
    return;
  }

  arg = lower_case(arg);
  /*	
	if( !check_legal_id(arg, 0)) {
		write("您的英文名字：");
		input_to("get_id", ob);
		return;
	}
*/
  if (strsrch(arg, "_") > 0) {
    write("转站玩家因为档案存在冲突，不能再使用。\n");
    destruct(ob);
    return;
  }
  ppl = find_body(arg);

#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && sizeof(users()) >= MAX_USERS) {
    //if( !ppl || !interactive(ppl) ) 
    if (!ppl) {
      write(WHT "\n                           ┏━━━━━━━━━┓
                           ┃ 连 线 上 限 提 示┃
 ┏━━━━━━━━━━━━┗━━━━━━━━━┛━━━━━━━━━━━━┓
 ┃   很抱歉" HIR " 西 游 记" NOR WHT " 的在线用户目前已经达到了系统总额上限。为了保证系   ┃
 ┃   统的正常运行我们做了这个规定，为此而给您所带来的不便我们深表歉意。 ┃
 ┃   请您稍后再尝试连线。			                         ┃
 ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
      destruct(ob);
      return;
    }
  }
#endif

  // Added by waiwai@2003/04/20
  if ((string)SECURITY_D->get_status(ob->query("id")) == "(player)") {
    if (REBOOT_CMD->is_rebooting() && !find_player(arg)) {
      write(HIR "\n" + MUD_NAME + "现在正处于重新启动倒计时中，暂时不能进入，请稍候再尝试连线。。。。\n\n" NOR);
      destruct(ob);
      return;
    }
  }

  if (wiz_level(arg) < wiz_lock_level) {
    write(BLINK HIW "\n很抱歉，" HIR + MUD_NAME + HIW "目前正在进行数据维护，请稍后尝试连线。。。\n" NOR);
    destruct(ob);
    return;
  }

  //edw@zju.mirror.xyj 6/2/98 (limit multi-login)
  // MAX_LOGIN and LOGIN_SITE should be defined in login.h
#ifdef MAX_LOGIN

  // WASM/loopback: local connections (every browser tab) are exempt from
  // the per-IP multi-login cap (AGENTS.md §1.3e).
  if (!ppl && !"/adm/daemons/band"->is_local_ip(query_ip_number(ob))) {
    // only check this for new login.
    // allow existing players to reconnect.
    my_ip = query_ip_number(ob);

    MaxLimit = "/adm/daemons/band"->allow_multi_login(my_ip);
    if (!MaxLimit) MaxLimit = MAX_LOGIN;
#ifdef LOGIN_SITE
    login_site = LOGIN_SITE;
#else
    login_site = 0;
#endif
    if (my_ip && login_site == 0)  // ignore the last field of the IP
      my_ip = my_ip[0..strsrch(my_ip, ".", -1)];

    NowLogin = 0;

    for (i = 0; i < sizeof(usr); i++)
      if (ob != usr[i]) {
        new_ip = query_ip_number(usr[i]);

        // for net_dead players.
        if (!new_ip && !interactive(usr[i]))
          new_ip = usr[i]->query_temp("netdead_ip");

        if (new_ip && login_site == 0)
          new_ip = new_ip[0..strsrch(new_ip, ".", -1)];

        if (my_ip == new_ip) {
          NowLogin++;
        }

      }

    if (NowLogin >= MaxLimit) {
      write(sprintf("对不起，从你的IP地址不能同时登录%s位人物。\n",
        chinese_number(MaxLimit + 1)));
      destruct(ob);
      return;
    }
  }
#endif

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  if (arg == "guest") {} else if (arg == "new") {  // new player login
    write(WHT "\n                           ┏━━━━━━━━━┓
                           ┃ 人 物 注 册 提 示┃
 ┏━━━━━━━━━━━━┗━━━━━━━━━┛━━━━━━━━━━━━┓
 ┃ 注册人物全过程中请勿使用" HIR "重新连线" NOR WHT "以免不能正确创造您想使用的这个人物ID ┃
 ┃ 请注意：连续 " HIR "90天" NOR WHT " 未登陆游戏的" YEL "非会员(vip)帐号" NOR WHT "将被自动清除档案        ┃
 ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);

    write("\n请您给自己取一个英文名字：");
    input_to("get_new_id", ob);
    return;
  } else if (file_size(ob->query_save_file()
    +__SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {

      if ((string)SECURITY_D->get_status(ob->query("id")) != "(player)") {
        write("\n此帐号目前为系统巫师帐号，如果您不是该帐号的所有者请不要尝试连线。\n" NOR);
        write("您的一切行为系统都将做详细记录，并根据您的具体行为做出自动处理。\n\n" NOR);
        write("现在请输入此帐号的一般识别密码：");
        input_to("get_passwd", 1, ob);
        return;
      } else {
        if (ob->query("regover")) {
          write(HIR "\n                           ┏━━━━━━━━━┓
                           ┃ 会 员 注 册 提 示┃
 ┏━━━━━━━━━━━━┗━━━━━━━━━┛━━━━━━━━━━━━┓
 ┃ " HIG "      很抱歉，您在西游记所注册的会员(Vip)帐号已到期被系统锁定。      " HIR "┃
 ┃ " HIG "      只能续期后才能继续使用，如有疑问请联络西游记大神，请见谅。     " HIR "┃
 ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
          destruct(ob);
          return;
        } else {
          if (ob->query("regplayer"))
            write(YEL "\n此帐号目前为有效注册帐号，系统身份为高级VIP会员。\n" NOR);
          else
            write("\n此帐号目前为有效注册帐号，系统身份为普通用户。\n" NOR);

          write("\n请输入此帐号的一般识别密码：");
          input_to("get_passwd", 1, ob);
          return;
        }
      }
    }
    write("您的人物储存档出了一些问题，请利用 guest 人物通知巫师处理。\n");
    destruct(ob);
    return;
  }


  write("没有这个玩家．．．\n");
  write("您的英文名字：（新玩家请键入 new 注册）");
  input_to("get_id", ob);
  return;
}

private void get_new_id(string arg, object ob) {
  object ppl, *usr;
  int id_count, i;

  if (!ob) return;

  id_count = ob->query_temp("id_count");
  id_count++;
  ob->set_temp("id_count", id_count);
  if (id_count > 6) {
    destruct(ob);
    log_file("ALLCONT", sprintf("kicked out, illegal ID.\n"));
    return;
  }

  if (!arg) {
    write("\n请您给自己取一个英文名字：");
    input_to("get_new_id", ob);
    return;
  }

  arg = lower_case(arg);
  if (!check_legal_id(arg, 1)) {
    write("\n请您给自己取一个英文名字：");
    input_to("get_new_id", ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  ppl = find_body(arg);
  if (ppl || arg == "guest" || arg == "new") {

    write("这个名字已经被别的玩家使用了．．．");
    write("\n请您给自己取一个英文名字：");
    input_to("get_new_id", ob);
    return;
  }

  if (file_size(ob->query_save_file()
    +__SAVE_EXTENSION__) >= 0) {

    write(WHT "这个名字已经被别的玩家使用了．．．" NOR);
    write("\n请您给自己取一个英文名字：");
    input_to("get_new_id", ob);
    return;
  }
  //By PKYOU 2002/08/22 限制同id多重登陆BUG
  usr = filter_array(children(LOGIN_OB), (: interactive :));
  i = sizeof(usr);
  while (i--) if (usr[i] != ob && usr[i]->query("id") == arg) break;
  if (i >= 0) {
    write("对不起，有其他玩家正在使用这个ID，请重新输入。\n");
    write("请您重新给自己取一个英文名字：");
    ob->add_temp("input", 1);
    if (ob->query_temp("input") > 3) {
      write("\n很抱歉,由于操作超时,请重新输入！\n");
      destruct(ob);
    }
    input_to("get_new_id", ob);
    return;
  }
  confirm_id("Yes", ob);
  return;
}

private void get_passwd(string pass, object ob) {
  string my_pass, id;
  object user;
  int freeze_time;
  freeze_time = ob->query("freeze_time");

  // Added by waiwai@2003/04/17
  if (time() < freeze_time) {
    write(HIW "很抱歉，这个账号已经被冻结,还有 " HIR + (freeze_time + 3600 - time()) / 3600 + HIW " 小时才能使用。\n" NOR);
    destruct(ob);
    return;
  }

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass ||
    !SECURITY_D->match_wiz_site(ob, query_ip_number(ob))) {
    write("密码错误！");
    write("请重新连线，键入正确的密码或另取一个新的英文名字。\n");
    if ((id = ob->query("id")) && member_array(id,
      SECURITY_D->get_wizlist()) != -1) {
      CHANNEL_D->do_channel(this_object(), "adm",
        sprintf(HIR "警告：%s的帐号目前从[%s]尝试登陆巫师帐号，一般密码输入失败。" NOR, id, query_ip_number()));
      log_file("wizcmds/wizloginR", log_time() + " " + id +
        " failed login from " + query_ip_number(ob) + "\n");
    } else
      log_file("wizcmds/login", log_time() + " " + id +
        " failed login from " + query_ip_number(ob) + "\n");
    destruct(ob);
    return;
  }

  if ((string)SECURITY_D->get_status(ob->query("id")) != "(player)") {
    if (!ob->query("password_w")) {
      write(HIR "\n您没有设置巫师专用密码！请马上慎重设置输入：\n" NOR);
      input_to("new_passwd_w", 1, ob);
      return;
    } else
      write(WHT "请输入巫师专用密码：" NOR);
    if (ob->query("password_w")) {
      input_to("get_passwd_wiz", 1, ob);
      return;
    }
  } else  // Added by waiwai@2003/04/12
  // 首先需要确定有的才进行检测
  if (ob->query("Pseach")) {
    write(HIW "\n请正确输入临时登陆验证码：" NOR);
    input_to("seach_pass", 1, ob);
    return;
  }
  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {

    if (!interactive(user)) {
      reconnect(ob, user);
      return;
    }
    // Added by waiwai@2003/02/13
    // des ob可以避免在连线过程中被猜出密码而连线
    // 巫师只要断线，5秒后即会立刻被des
    if ((string)SECURITY_D->get_status(ob->query("id")) != "(player)") {
      log_file("wizcmds/K_rlogin", sprintf("%s(%s) 由 %s 重新连线被禁止.时间在: [%s]\n",
        user->query("name"), user->query("id"), query_ip_number(ob), log_time()));
      write(BLINK HIR "\n\t\t   为了系统安全，所有巫师禁止重新连线系统。\n" NOR);
      destruct(ob);
    } else
      write(HIY "\n您要将另一个连线中的相同人物赶出去，取而代之吗？" HIG "(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s(%s) 由 %s 连线进入.时间在: [%s]\n", user->query("name"),
        user->query("id"), query_ip_number(ob), log_time()));
      if ((string)SECURITY_D->get_status(ob->query("id")) == "(player)") {

        if (time() - (int)user->query("kickout_time") < 86400) {
          write(HIR "您现在已经没有进入西游记的权利，请 24 小时后再连线。\n" NOR);
          write(HIR "目前时间已逝去 " + XYJTIME_D->query_time((int)user->query("kickout_time")) + "。。。。\n" NOR);
          destruct(user);
          destruct(ob);
          return;
        }

        if (time() - (int)user->query("quit_time") < 10) {
          write(HIR "\n您刚退出游戏，为了减轻系统负担请再过 " HIG + (10 - (time() - (int)user->query("quit_time"))) + HIR " 秒后连入，谢谢合作。^0^\n\n" NOR);
          destruct(ob);
          destruct(user);
          return;
        }
      }
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }

  if (ob) destruct(ob);
  return;

  //	write("请您重新创造这个人物。\n");
  //	confirm_id("y", ob);
}

// Added by waiwai@2001/07/02 巫师专用密码识别
private void get_passwd_wiz(string pass, object ob) {
  string my_pass, id, *wrong_pass2;
  int err_num2;
  int freeze_time;
  freeze_time = ob->query("freeze_time");

  write("\n");
  id = ob->query("id");
  my_pass = ob->query("password_w");

  if (crypt(pass, my_pass) != my_pass) {
    err_num2 = ob->query_temp("error_login2");
    wrong_pass2 = ob->query("error_login2");
    err_num2++;
    ob->set_temp("error_login2", err_num2);
    if (!wrong_pass2) wrong_pass2 = ({});
    wrong_pass2 += ({ query_ip_number(ob) });
    ob->set("wrong_pass2", wrong_pass2);
    ob->save();

    if (err_num2 < 2) {
      write(HIR "警告:您的行为已经记录在案,如果您不是此帐号的所有人,请反思自己的行为！\n\n" NOR);
      write(WHT "您还有" HIR + chinese_number(2 - err_num2) + NOR WHT "次机会，请输入正确密码：\n" NOR);
      input_to("get_passwd_wiz", 1, ob);
    } else {
      CHANNEL_D->do_channel(this_object(), "adm",
        sprintf(
          HIR "警告：%s的帐号目前从[%s](" + query_ip_port() + ")尝试登陆巫师帐号，失败输入两次。" NOR,
          id,
          query_ip_number()
        ));
      //		 ob->set("wrongtime", time());
      //		 ob->save();
      write(HIR "\n警告:系统怀疑您试图盗用巫师帐号,将根据您的行为做出自动处理！\n\n" NOR);
      log_file("wizcmds/wizpassR",
        sprintf("有人试图从(%s)连接巫师(%s)的帐号,尝试密码两次失败. 时间在：[%s]\n",
          query_ip_number(ob), id, log_time()));
      destruct(ob);
    }
    return;
  }

  /*	if ( time() < freeze_time ) {
	write (HIW"很抱歉，这个账号超过30天未登陆。已经被设定冻结,还有 "
HIR+((freeze_time+3600-time())/3600)/24 +HIW" 天才能使用。\n"NOR);
	write (HIW"如果您想登陆系统，请与主管巫师联系取得授权密码。\n\n"NOR);
	write (HIR"警告：如果您没有把握能够正确输入，请退出，不然帐号将被永久锁定无法登陆。\n\n"NOR);
	write(HIR"请输入巫师帐号冻结授权密码："NOR);
		input_to("get_passwd_frz", 1, ob);
		return;
		} */ else if (ob->query("Pseach")) {  // 巫师的检测需要在这里设置
    write(HIW "\n请正确输入临时登陆验证码：" NOR);
    input_to("seach_pass", 1, ob);
    return;
  } else confirm_login(ob);
}

// Added by waiwai@2001/07/02
private void new_passwd_w(string pass_w, object ob) {
  string old_pass;
  int i;
  int bigletter = 0;
  int smlletter = 0;

  write("\n");
  old_pass = ob->query("password");
  i = strlen(pass_w);

  if (i <= 5) {
    write(HIW "巫师专用密码的长度至少要六个字元，请重设您的巫师专用密码：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  if (strsrch(pass_w, ob->query("id")) != -1) {
    write(HIR "为了安全,您的巫师专用密码组合不能和英文名字相同！ \n" NOR);
    write(HIW "\n请重新设定您的巫师专用密码：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  if (strsrch(pass_w, ob->query("name")) != -1) {
    write(HIR "为了安全,您的巫师专用密码组合不能和中文名字相同！ \n" NOR);
    write(HIW "\n请重新设定您的身份标识：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  if (crypt(pass_w, old_pass) == old_pass) {
    write(HIR "为了安全,您的巫师专用密码组合不能和您的密码相同！ \n" NOR);
    write(HIW "\n请重新设定您的巫师专用密码：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  while (i--) {
    if (pass_w[i] <= 'Z' && pass_w[i] >= 'A') bigletter++;
    if (pass_w[i] <= 'z' && pass_w[i] >= 'a') smlletter++;
  }

  if (bigletter == 0 || smlletter == 0 || bigletter + smlletter == i) {
    write("您的巫师专用密码必须包含" HIR "大写" NOR "和" + HIR "小写英文字母" NOR
      "以及" HIR "其它字符" NOR "，例如：Mud-123。\n");
    write(HIW "\n请重新设定您的巫师专用密码：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  ob->set("password_w", crypt(pass_w, 0));
  write(HIW "请再输入一次您的巫师专用密码，以确认您没记错：" NOR);
  ob->add_temp("input", 1);

  input_to("confirm_pass_w", 1, ob);
}

private void confirm_pass_w(string pass_w, object ob) {
  string old_pass_w;
  object user;

  write("\n");
  old_pass_w = ob->query("password_w");
  if (crypt(pass_w, old_pass_w) != old_pass_w) {
    write(HIR "\n您两次输入的巫师专用密码并不一样，请重新输入一次：" NOR);
    ob->add_temp("input", 1);
    input_to("new_passwd_w", 1, ob);
    return;
  }

  ob->add_temp("input", 1);
  confirm_login(ob);
}

// Added by waiwai@2003/01/19
// 临时登陆密码检测
void seach_pass(string pass, object ob) {
  string Ppass;
  Ppass = ob->query("Pseach");

  if (crypt(pass, Ppass) != Ppass) {
    ob->add_temp("get_seach", 1);
    if (ob->query_temp("get_seach")) {
      if (ob->query_temp("get_seach") >= 1 && ob->query_temp("get_seach") < 2)
        write(CYN "\n您还有" HIR "两" NOR CYN "次正确输入机会：\n" NOR);
      else if (ob->query_temp("get_seach") >= 2 && ob->query_temp("get_seach") < 3)
        write(CYN "\n您还有" HIR "一" NOR CYN "次正确输入机会：\n" NOR);
      else if (ob->query_temp("get_seach") >= 3) {
        write(HIR "\n您输入临时登陆验证码三次错误，再见！！！\n" NOR);
        destruct(ob);
        return;
      }
    }
    input_to("seach_pass", 1, ob);
    return;
  }
  write(HIW "\n临时登陆验证码输入正确，检测通过。。。。。。\n" NOR);

  confirm_login(ob);
}

private void confirm_login(object ob) {
  object user;

  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    /*
		// Added by waiwai@2003/02/13
		// des ob可以避免在连线过程中被猜出密码而连线
		// 巫师只要断线，5秒后即会立刻被des
		if ((string)SECURITY_D->get_status(ob->query("id")) != "(player)") {
		log_file( "wizcmds/K_rlogin", sprintf("%s(%s) 由 %s 重新连线被禁止.时间在: [%s]\n",
                 user->query("name"), user->query("id"), query_ip_number(ob), log_time()));
		write(BLINK HIR"\n\t\t   为了系统安全，所有巫师禁止重新连线系统。\n"NOR);
               destruct(ob); 
		} else 
*/
    write(HIY "\n您要将另一个连线中的相同人物赶出去，取而代之吗？" HIG "(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("r_login", sprintf("%s(%s) 由 %s 重新连线进入.时间在: [%s]\n",
        user->query("name"), user->query("id"), query_ip_number(ob), log_time()));
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write(HIG "请您重新创造这个人物。\n" NOR);
  confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if ((yn[0] != 'y' && yn[0] != 'Y') || !user) {
    write("好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " + query_ip_number(ob)
      + " )连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s(%s) replaced by %s (%s)\n",
      user->query("name"), user->query("id"),
      query_ip_number(ob), ctime(time())));
  }

  // Kick out tho old player.
  old_link = user->query_temp("link_ob");

  if (old_link && interactive(user)) {
    user->set_encoding(ob->query_encoding());
    exec(old_link, user);
  }
  if (old_link)
    destruct(old_link);

  reconnect(ob, user);
}

private void confirm_id(string yn, object ob) {


  write(WHT "\n                         ┏━━━━━━━━━┓
                         ┃ 中 文 名 字 注 册┃
 ┏━━━━━━━━━━━┗━━━━━━━━━┛━━━━━━━━━━━━┓
 ┃ 请您给自己想一个符合" HIY "『" HIR " 西 游 记" HIY " 』" NOR WHT "神话世界的中文名字。不要取一些不 ┃
 ┃ 雅或是容易造成他人困扰的名字。这个名字将代表您在这个世界的形象，而 ┃
 ┃ 且往后很少能再更改，请务必慎重。( 您的名字如果取的不妥，网络巫师将 ┃
 ┃ 有权给予更改，所以郑重建议您取一个比较有个性且比较文明的带有一定浓 ┃
 ┃ 郁色彩中文名字 )。如果您不能正确输入中文名字,请按几下回车键(ENTER) ┃
 ┃ 系统将随机给您筛选出一个中文名字。名字长短在二到四个之间。	       ┃
 ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
  write("\n请输入您要取的中文名字(二到四个中文字)：");
  ob->set_temp("get_name", 0);
  input_to("get_name", ob);
}

// Added by waiwai@2001/07/02
private void get_resp(string arg, object ob) {
  string Rname;

  if (arg == "") {
    write("您是否满意这个中文名字" + ob->query_temp("name") + "(" HIR "y" NOR "/" YEL "n" NOR ")？");
    input_to("get_resp", ob);
    return;
  }

  if (arg[0] == 'y' || arg[0] == 'Y') {
    ob->set("name", ob->query_temp("name"));
    write("您的名字被设定为：" CYN + ob->query_temp("name"));
    write(WHT "\n现在请设定您的密码：");
    input_to("new_password", 1, ob);
    return;
  } else if (arg[0] == 'n' || arg[0] == 'N') {

    Rname = default_prefix[random(sizeof(default_prefix))] + default_name[random(sizeof(default_name))];

    if (ob->query_temp("get_name") < 10) {
      ob->add_temp("get_name", 1);
      write("您是否满意这个中文名字(" HIR "y" NOR "/" HIY "n" NOR ")？");
      printf(HIW " →" HIR "%s" NOR "：", Rname);
      printf("您还有" HIR "%d" NOR "次选择机会\n", 11 - ob->query_temp("get_name"));
      ob->set_temp("name", Rname);
      input_to("get_resp", ob);
      return;
    } else if (ob->query_temp("get_name") >= 10) {
      ob->set("name", ob->query_temp("name"));
      write("您的名字被设定为：" CYN + ob->query_temp("name"));
      write(WHT "\n现在请设定您的密码：" NOR);
      input_to("new_password", 1, ob);
      return;
    }

  } else {
    write("对不起，您只能选择满意(" HIR "y" NOR ")不满意(" HIY "n" NOR ")： ");
    input_to("get_resp", ob);
    return;
  }
}

private void get_name(string arg, object ob) {
  string result;
  arg = CONVERT_D->input(arg, ob);

  if (arg == "") {
    arg = default_prefix[random(sizeof(default_prefix))] + default_name[random(sizeof(default_name))];
    ob->add_temp("get_name", 1);

    write("看来您要个随机产生的中文名字，您有10次选择机会。。。\n");
    write("请问您是否满意这个中文名字(" HIR "y" NOR "/" HIY "n" NOR ")");
    printf(HIW " →" HIY "%s" NOR "？", arg);
    ob->set_temp("name", arg);
    input_to("get_resp", ob);
  } else if (stringp(result = NAME_D->invalid_new_name(arg))) {
    write("对不起，" + result);
    write("\n请重新输入您的中文名字：");
    input_to("get_name", ob);
    return;
  } else {
    if (!check_legal_name(arg)) {
      write("请再次输入您的中文名字：");
      input_to("get_name", ob);
      return;
    }
    ob->set("name", arg);
    write("您的名字被设定为：" CYN + ob->query("name"));
    write(WHT "\n现在请设定您的密码：" NOR);
    input_to("new_password", 1, ob);
    ob->add_temp("input", 1);
    if (ob->query_temp("input") > 10) {
      write(HIR "\n很抱歉,由于操作超时,请重新输入！！！\n" NOR);
      destruct(ob);
    }
  }
}

private void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write("密码至少要由五个字符组成，请重设您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob) {
  string old_pass;
  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码并不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }
  write(WHT "\n                           ┏━━━━━━━━━┓
                           ┃ 邮 件 地 址 注 册┃
 ┏━━━━━━━━━━━━┗━━━━━━━━━┛━━━━━━━━━━━━┓
 ┃ 为了避免您的人物遭人盗用" HIR "『西游记』" NOR WHT "将采用有效信箱认证方式保护您的人物 ┃
 ┃ 所有权。所以请您输入一个正确的可供网络有效接受认证用的个人电子邮件地 ┃
 ┃ 址这个电子邮件地址除了系统巫师以外(用户个人使用命令有意公开除外)不会 ┃
 ┃ 被其他的使用者看到。" HIR "郑重声明：" NOR HIG "如果您没有正确输入这个地址，在您的密码" NOR WHT " ┃
 ┃" HIG " 遗失后将不能得到网络巫师的帮助而找回。            " NOR WHT "                   ┃
 ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n\n" NOR);

  write("您的电子邮件地址：");
  input_to("get_email", ob);
}

private void get_email(string email, object ob, mapping my) {
  object user;
  string id, address;
  write("\n");

  // Added by waiwai@2003/04/10
  if (email == "" || strsrch(email, "@") == -1 ||
    sscanf(email, "%s@%s", id, address) != 2 || strsrch(address, ".") == -1) {
    write(YEL "电子邮件地址需要是" HIR " xxx@address " NOR YEL "的格式。\n" NOR);
    write(YEL "请输入有效的地址格式,比如：xyj@21cn.com \n\n" NOR);
    write("您的有效电子邮件地址是：");
    ob->add_temp("input", 1);
    if (ob->query_temp("input") > 5) {
      write(HIR "\n很抱歉,由于操作超时,请重新输入！！！\n" NOR);
      destruct(ob);
    }
    input_to("get_email", ob, my);
    return;
  }

  ob->set("email", email);

  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob))) {
    if (ob) destruct(ob);
    return;
  }

  write("您要扮演男性(m)的角色或女性(f)的角色？");
  input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user) {
  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("对不起，您只能选择男性(m)或女性(f)的角色：");
    input_to("get_gender", ob, user);
    return;
  }

  confirm_gift("n", ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  if (!ob->query("body")) {
    return 0;
  }
  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改玩家物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

private void confirm_gift(string yn, object ob, object user) {
  int n, a, b;

  if (!ob || !user) {
    if (user) {
      destruct(user);
      return;
    }
    if (ob) destruct(ob);
    return;
  }

  user->set("kar", 20);
  user->set("str", 20);
  user->set("cps", 20);
  user->set("int", 25);
  user->set("cor", 20);
  user->set("con", 20);
  user->set("spi", 25);
  user->set("per", 20);

  // mon 3/21/99 allow players to choose gift after login.
  user->set("no_gift", 1);

  CHAR_D->setup_char(user);
  user->set("title", "普通百姓");
  user->set("birthday", time());
  user->set("potential", 99);
  user->set("food", user->max_food_capacity());
  user->set("water", user->max_water_capacity());
  user->set("channels", ({ "chat", "rumor", "xyj", "sldh" }));
  user->update_age();  //7/3/99 mon
  // Added by waiwai@2003/04/10
  // 12生肖的设定
  user->set("12_sx", shengxiao[random(sizeof(shengxiao))]);
  // 12星座的设定
  user->set("12_xz", xingzuo[random(sizeof(xingzuo))]);
  // 投胎地点的设定
  user->set("changed", changed[random(sizeof(changed))]);
  // 五行的设定
  user->set("ultimate", ultimate[random(sizeof(ultimate))]);

  // 天性的设定
  if (user->query("gender") == "女性")
    user->set("national", tianxingg[random(sizeof(tianxingg))]);
  else
    user->set("national", tianxingm[random(sizeof(tianxingm))]);
  // 记录名字，避免重名
  NAME_D->map_name(user->query("name"), user->query("id"));

  //	    log_file( "USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
  //		query_ip_number(ob), ctime(time()) ) );

  ob->set("last_from", query_ip_number(ob));
  ob->set("last_on", time());

  return enter_world(ob, user);
}

string dis_attr(int value) {
  int gift = 20;
  if (value > gift) return sprintf(HIY "%3d" NOR, value);
  else if (value < gift) return sprintf(CYN "%3d" NOR, value);
  else return sprintf("%3d", value);
}

varargs void enter_world(object ob, object user, int silent) {
  object cloth, room, mbx, coup, where, lp;
  string cname, playersx, id, wiz_lvl, startroom = "";
  int num, user_count;
  string ip_from;
  mapping my;

  reset_eval_cost();

  // Added by waiwai@2003/04/12
  user->set_temp("temp_time", time());

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);

  user->set_encoding(ob->query_encoding());

  exec(user, ob);
  //	user->set("env/prompt", "time");

  user->setup();

  // Added by waiwai@2002/12/05
  if (!wizhood(user) && ob->query("name") != user->query("name")) {
    // 曾用名记录，目前用于Fingerd.c
    ob->add("cname/cname", "[" + ob->query("name") + "] ");
    // 统一LOGIN_OB和USER_OB的name
    ob->set("name", user->query("name"));
  }

  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();

  /*******************************************************************************/
  // Added by waiwai@2001/02/20
  // 这里配合quit为了避免巫师而因特殊原因而保留某些不该保留的巫师频道
  // 而泄密。设置在quit里面每次清空所有频道，这里重新设定一次
  switch (wizhood(user)) {
    case "(admin)":
      wiz_lvl = YEL " 主管天神(admin)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "adm", "wiz", "err", "debug",
          "imud", "sys", "party", "xyj", "xiaodao", "rultra", "ultra", "ct" }));
      break;
    case "(arch)":
      wiz_lvl = YEL " 天界大神(arch)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "wiz", "imud", "sys", "party",
          "xyj", "xiaodao", "rultra", "ultra" }));
      break;
    case "(wizard)":
      wiz_lvl = YEL " 天界仙人(wizard)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "wiz", "sys", "party", "xyj",
          "xiaodao", "rultra", "ultra" }));
      break;
    case "(apprentice)":
      wiz_lvl = YEL " 天界散仙(apprentice)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "wiz", "sys", "party", "xyj",
          "xiaodao", "rultra", "ultra" }));
      break;
    case "(immortal)":
      wiz_lvl = YEL " 天界灵官(immortal)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "wiz", "sys", "party", "xyj",
          "xiaodao", "rultra", "ultra" }));
      break;
    case "(elder)":
      wiz_lvl = YEL " 荣誉巫师(elder)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "wiz", "sys", "party", "xyj",
          "xiaodao", "rultra", "ultra" }));
      break;
    case "(player)":
      wiz_lvl = YEL " 普通用户(player)" NOR;
      user->set("channels",
        ({ "chat", "rumor", "music", "sldh", "xyj", "xiaodao", "party", "rultra", "ultra", "ct" }));
      break;
    default:
      error("wiz_lvl: undefined lvl " + wizhood(user) + ".\n");
  }
  write("目前权限：" + wiz_lvl + "\n");

  /*******************************************************************************/

  if (!silent) {
    //	     if(file_size(MOTD)>0)
    //             user->start_more(read_file(MOTD));

    if (user->query("no_gift")) {
      // AGENTS.md §13/§15e: /d/wiz/init (the "choose your gift"
      // staging room every brand-new character was unconditionally
      // sent to) does not exist anywhere in this archive -- a
      // genuine content gap, not fabricated here. Without this
      // guard, move() silently left every new character with NO
      // environment at all, which then crashed command_hook()'s
      // environment(me)->query(...) on every single post-login
      // command (look/score/quit all failed identically). Fall
      // back to the normal START_ROOM the same way the startroom
      // logic a few lines below already does for a missing
      // startroom.
      if (load_object("/d/wiz/init"))
        user->move("/d/wiz/init", 1);
      else
        user->move(START_ROOM);
    } else {
      int approved;

      if (user->is_ghost())
        startroom = DEATH_ROOM;
      else if (strlen(startroom = user->query("startroom")) < 2)
        startroom = START_ROOM;

      if (!wizardp(user) && startroom[0..2] == "/u/") {
        startroom = START_ROOM;
        user->set("startroom", startroom);
      } else  // Update by waiwai@2003/04/13
      if (wizardp(user) && user->query("startroom") != "/d/wiz/wizroom") {
        startroom = "/d/wiz/wizroom";
        user->set("startroom", startroom);
      }
      /*   
		// Added by waiwai@2003/04/13
		// 避免曾经是巫师的降职为用户再次连线还在巫师会议厅或工作室
		if ( !wizardp(user) && user->query("startroom") == "/d/wiz/wizroom" ) {
		startroom="/d/city/kezhan";
		user->set("startroom",startroom);
		user->set("env/invisibility",0);
		}
*/
      if (startroom == "/d/wiz/punish") {
        user->move(startroom);
      } else if (("/adm/daemons/band"
        ->create_char_banned(query_ip_number(user)) == 1 ||
        "/adm/daemons/band"->is_banned(query_ip_number(user))
        == 1 || ((approved = user->query("banned_approved")) != 0
          && approved != 1)) && !wizardp(user)) {
        user->move("/d/wiz/guest");
        log_file("ALLCONT", sprintf(
          "from banned site or is being banned.\n"));
      } else if (load_object(startroom))
        user->move(startroom);
      else {
        user->move(START_ROOM);
        startroom = START_ROOM;
        user->set("startroom", START_ROOM);
      }
      where = environment(user);
      /*******************************************************************************/

      // Added by waiwai@2003/04/13
      if (!user->query("env/limit_toget")) user->set("env/limit_toget", 1);

      if (!user->query("12_sx"))
        user->set("12_sx", shengxiao[random(sizeof(shengxiao))]);

      if (!user->query("12_xz"))
        user->set("12_xz", xingzuo[random(sizeof(xingzuo))]);

      if (!user->query("ultimate"))
        user->set("ultimate", ultimate[random(sizeof(ultimate))]);

      if (user->query_condition("hope"))
        user->clear_condition("hope");

      if (user->query("schedule")) user->delete("schedule");

      if (user->query("doing")) user->delete("doing");

      if (!user->query("vip") && user->query("waiwai_giftto2"))
        user->delete("waiwai_giftto2");

      if (user->query("fenglu/give"))
        user->delete("fenglu/give");

      // 投胎地点的设定
      if (!user->query("changed"))
        user->set("changed", changed[random(sizeof(changed))]);

      // 天性的设定
      if (!user->query("national")) {
        if (user->query("gender") == "女性")
          user->set("national", tianxingg[random(sizeof(tianxingg))]);
        else
          user->set("national", tianxingm[random(sizeof(tianxingm))]);
      }
      /*******************************************************************************/

      my = user->query_entire_dbase();

      if (!user->query("waiwai_giftto2")
        && my["per"] > 40 && user->query("vip")) {
        if (user->query("gender") == "女性") {
          new("/obj/self/gift/flower")->move(user);
          user->set("waiwai_giftto2", 1);
          write(HIR BLINK "\n\t\t恭喜恭喜！您由于容貌出众得到了小护身符樱花香囊。\n\n" NOR);
        } else {
          user->set("waiwai_giftto2", 1);
          new("/obj/self/gift/flower2")->move(user);
          write(HIR BLINK "\n\t\t恭喜恭喜！您由于容貌出众得到了小护身符樱花玉配。\n\n" NOR);
        }
      }

      // 检测转档案玩家
      if (strsrch(ob->query("id"), "_") > 0 &&
        !ob->query("convert_allowed"))
        user->move("/d/wiz/applyroom");

      if (!wizardp(user) || !user->query("env/invisibility"))
        tell_room(startroom, user->query("name") + "连线进入这个世界。\n",
          ({ user }));
    }

    /*******************************************************************************/

    write(YEL "\n\t\t欢迎您连线进入" HIR + VERSION_NAME + NOR YEL "的精彩世界,祝您在此能够玩的愉快！\n\n" NOR);

    // 个人连线计数
    user_count = user->query("login_count");
    if (user_count < 1) user_count = 1;
    write(RED "  → " NOR "这是您第 " YEL + user_count + NOR " 次正常连线进入西游记的世界！！！\n" NOR);
    user_count++;
    user->set("login_count", user_count);
    if (!wizardp(user) && user->query("vip")) {  // 会员识别显示
      write(RED "  → " NOR "您的系统权限目前是：" YEL " 高级会员(vip) \n" NOR);
    } else write(RED "  → " NOR "您的系统权限目前是：" YEL + wiz_lvl + "\n" NOR);
    write(RED "  → " NOR "您目前连线的地址是： " YEL + query_ip_number(user) + "(" + query_ip_port(user) + ")\n" NOR);
    // 如果是第一次连线则不显示下面设置
    if (ob->query("last_on")) {
      write(RED "  → " NOR "您上次退线的地址是： " YEL + ob->query("last_from") + "(" + ob->query("last_port") + ")\n" NOR);
      write(RED "  → " NOR "您上次离线的时间是： " YEL + COLOR_D->clean_color(
        BJTIME_CMD->chinese_time(1, ctime(ob->query("last_on")))) + "\n" NOR);
    }
    /*******************************************************************************/
    // Added by waiwai@2002/11/27 增加个人百岁礼物
    playersx = user->query("12_sx");
    if (!user->query("gift_100") && user->query("vip")) {
      if ((int)user->query("age") > 100) {
        lp = new("/obj/self/gift/100/" + playersx);
        lp->set("owner_id", getuid(user));  // 避免同属相者作弊
        lp->move(user);
        write(HIR BLINK "\n\t\t恭喜恭喜！您得到了西游记的百岁寿辰礼物。\n\n" NOR);
        user->set("gift_100", 1);
        user->apply_condition("hope", time() + 600);
        log_file("player/100", sprintf("%s得到百岁铭牌 时间在：[%s]\n",
          log_id(user), log_time()));

        user->save();
      }
    }
    /*******************************************************************************/

    if (!wizardp(user)) {
      if (user->query("family/family_name") != "月宫" && user->query_skill("moondance")) {
        user->delete_skill("moondance");
        tell_object(user,
          BLINK HIR "\n由于您不是月宫弟子，非法所得" HIG "冷月凝香舞(moondance)" HIR "被系统自动删除了！\n\n" NOR);
      }

      if (user->query("family/family_name") != "南海普陀山" && user->query_skill("buddhism")) {
        user->delete_skill("buddhism");
        tell_object(user,
          BLINK HIR "\n由于您不是南海普陀山弟子，非法所得" HIG "大乘佛法(buddhism)" HIR "被系统自动删除了！\n\n" NOR);
      }

      if (user->query("family/family_name") != "方寸山三星洞" && user->query_skill("qianjun-bang")) {
        user->delete_skill("qianjun-bang");
        tell_object(user,
          BLINK HIR "\n由于您不是方寸山三星洞弟子，非法所得" HIG "千钧棒法(qianjun-bang)" HIR "被系统自动删除了！\n\n" NOR);
      }

    }
    // IP识别
    ip_from = "/adm/daemons/ipd"->seek_ip_address(query_ip_number(user));

    /*******************************************************************************/

    mbx = ob->query_temp("mbox_ob");
    if (!mbx) {
      mbx = new(MAILBOX_OB);
      mbx->set_owner(ob->query("id"));
    }
    num = mbx->query_new_mail();
    if (num > 0) {
      write(HIG "\n千里眼告诉你：有您" HIR + chinese_number(num) + HIG
        "封信！请到南城客栈来一趟．．．\n\n" NOR);
    }
    destruct(mbx);
    //		NEWS_D->show_news(user, 1);

    // Added by waiwai@2003/04/13
    //		if( user->query("mud_age")!=0) {
    if (wizardp(user))
      CHANNEL_D->do_channel(this_object(), "adm",
        sprintf(HIR "%s由(%s)连线进入，IP来自：%s" NOR,
          log_id(user), query_ip_number(user), ip_from));
    else
      CHANNEL_D->do_channel(this_object(), "sys",
        sprintf("%s由(%s)连线进入，IP来自：%s" NOR,
          log_id(user), query_ip_number(user), ip_from));
  }
  /*
		else	
		CHANNEL_D->do_channel( this_object(), "sys",
			sprintf(HIM"新用户%s由(%s)连线进入，IP来自：%s"NOR, 
			log_id(user), query_ip_number(user), ip_from ) );

	
		}
*/
  // Added by waiwai@2001/03/06
  // 可以保留三次的wargod称号标志
  if (user->query("last_quit") > 3) {
    if (user->query("wargod") == HIR "新娘子" NOR) user->delete("wargod");
    if (user->query("wargod") == HIR "新郎倌" NOR) user->delete("wargod");
    if (user->query("wargod") == HIR "齐天大圣" NOR) user->delete("wargod");
    if (user->query("wargod") == HIW "弼马温" NOR) user->delete("wargod");
    user->delete("last_quit");
  }

  /*******************************************************************************/
  // Added by waiwai@2003/01/20 设置自动辨别清除婚姻参数
  if (stringp(cname = user->query("couple/id"))) {
    coup = find_player(cname);
    if (!coup) {
      coup = new(LOGIN_OB);
      coup->set("id", id);

      if ((time() - (int)coup->query("last_on")) < 86400 * 30) {

        if (user->query("gender") == "男性") {
          tell_object(user, HIR "\n\t\t由于你老婆失踪了, 就放您自由飞翔吧.\n" NOR);
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);
          user->delete("marry/id");
          user->delete("marry/name");
          user->delete("married");
          user->delete("couple");
          user->delete("wife");
        } else {
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);

          tell_object(user, HIR "\n\t\t由于您丈夫失踪了, 就放您自由飞翔吧.\n" NOR);
          user->delete("marry/id");
          user->delete("marry/name");
          user->delete("married");
          user->delete("couple");
          user->delete("husband");
        }
        destruct(coup);
      }
      if (file_size(sprintf("/data/login/%s/%s.o", cname[0..0], cname)) <= 0) {
        if (user->query("gender") == "男性") {
          tell_object(user, HIR "\n\t\t惨了, 您老婆没了, 就放您自由飞翔吧.\n" NOR);
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);
          user->delete("marry/id");
          user->delete("marry/name");

          user->delete("married");
          user->delete("couple");
          user->delete("wife");
        } else {
          tell_object(user, HIR "\n\t\t惨了, 您丈夫没了, 就放您自由飞翔吧.\n" NOR);
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);
          user->delete("marry/id");
          user->delete("marry/name");

          user->delete("married");
          user->delete("couple");
          user->delete("husband");
        }
      } else {
        new("/obj/loginload/marry-token")->move(user);
        tell_object(user, HIR "\n\t\t唉..另一半没上线, 放您孤单一个人在这儿.\n" NOR);
      }
    } else if (coup) {

      tell_object(user,
        "\n\t\t" + HIR + user->name() + "您的爱人" + coup->name() + "(" + coup->query("id") + ")已经在西游记的世界了！！！\n" NOR);
      tell_object(coup,
        "\n\t\t" + HIR + coup->name() + "您的爱人" + user->name() + "(" + user->query("id") + ")进入西游记的世界了！！！\n" NOR);
      new("/obj/loginload/marry-token")->move(user);

      if (user->query("id") != coup->query("couple/id")) {

        if (user->query("gender") == "男性") {
          tell_object(user, HIR "\n\t\t由于你老婆变心了, 就放您自由飞翔吧.\n" NOR);
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);
          user->delete("marry/id");
          user->delete("marry/name");
          user->delete("married");
          user->delete("couple");
          user->delete("wife");
        } else {
          if (present("yu pei", user)) present("yu pei", user)->lost(user);
          if (present("xiang nang", user)) present("xiang nang", user)->lost(user);

          tell_object(user, HIR "\n\t\t由于您丈夫变心了, 就放您自由飞翔吧.\n" NOR);
          user->delete("marry/id");
          user->delete("marry/name");
          user->delete("married");
          user->delete("couple");
          user->delete("husband");
        }
      }

    }
  }
  /*******************************************************************************/

  if (!user->query("no_gift"))
    //	TOPTEN_D->topten_checkplayer(user);
    WEAPONTOP_D->topten_checkplayer(user);

  if (!user->query("special_skill") && !user->query("no_gift")) {
    UPDATE_D->born_player(user);
  }

  UPDATE_D->check_user(user, 0);
  MPTOP_D->check_mp_player(user);
  TOPTEN_D->checkplayers(user);
  NEWS_D->prompt_user(user);

  //    if ("/cmds/usr/pkgame"->query_pk() )
  //		"/cmds/usr/pkgame"->main(user);
}

varargs void reconnect(object ob, object user, int silent) {
  object old_link;

  old_link = user->query_temp("link_ob");
  if (old_link && old_link != ob)
    destruct(old_link);

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);

  user->set_encoding(ob->query_encoding());

  exec(user, ob);

  user->reconnect();
  if (!silent && !user->query("env/invisibility")) {
    tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
      ({ user }));
    CHANNEL_D->do_channel(this_object(), "sys",
      sprintf(
        "%s由%s重新连线进入。",
        user->query("name") + "(" + capitalize(user->query("id")) + ")",
        query_ip_name(user)
      ));
  }
  UPDATE_D->check_user(user, 1);  // this is for reconnect.
}

int check_legal_id(string id, int insaneid) {
  int i, j;
  string *banned_id = explode(read_file(BANNED_ID), "\n");

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 8)) {
    write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母。\n");
      return 0;
    }

  for (j = 0; j < sizeof(limit_id); j++)
    if (strsrch(id, limit_id[j]) != -1) {
      write("\n很抱歉，类似含有 " HIR BLINK + limit_id[j] + NOR " 这样的英文字符被系统禁止注册！\n\n" NOR);
      return 0;
    }

  if (member_array(id, banned_id) != -1) {
    write(YEL "\n很抱歉，这个名字被系统禁止注册。\n\n" NOR);
    return 0;
  }

  // only check when creating new ids.
  if (insaneid) {
    for (i = 0; i < sizeof(legalid); i++) {
      if (legalid[i][0..0] == "*") {  // wildcard match
        if (strsrch(id, legalid[i][1..]) != -1) {
          write("对不起，这种名字会造成其他人的困扰。\n");
          return 0;
        }
      } else {
        if (id == legalid[i]) {  // exact match
          write("对不起，这种名字会造成其他人的困扰。\n");
          return 0;
        }
      }
    }
  }

  // Added by waiwai@2003/04/13
  // 禁止使用相同字母组合>3的ID，比如 dddd ddddd
  // 至少可以从一定程度上避免些垃圾ID吧。。。
  // 首先需要排除老注册用户，不然此类用户将无法登陆
  if (file_size(DATA_DIR + "login/" + sprintf("%c", id[0]) + "/" + id + __SAVE_EXTENSION__) < 0
    && file_size(DATA_DIR + "user/" + sprintf("%c", id[0]) + "/" + id + __SAVE_EXTENSION__) < 0) {
    if (strlen(id) > 3)
      for (i = 0; i < strlen(id) - 3; i++)
        if (id[i] == id[i + 1] && id[i] == id[i + 2] && id[i] == id[i + 3]) {
          write("\n对不起，请不要使用重复三个字母以上的字符做名字。。。\n");
          return 0;
        }
  }

  return 1;
}

int check_legal_name(string name) {
  int i, j;

  i = strlen(name);

  if ((strlen(name) < 2) || (strlen(name) > 4)) {
    write("对不起，你的中文名字必须是二到四个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字符。\n");
      return 0;
    }
    // Update By waiwai@2003/04/13
    // Fixed for UTF-8 native strings (AGENTS.md §15h): every index is
    // already one full character, not a GBK byte-pair lead position.
    if (!CHINESE_D->is_chinese(name[i..i])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  for (j = 0; j < sizeof(bad_word); j++)
    if (strsrch(name, bad_word[j]) != -1) {
      write("\n很抱歉，类似含有 " HIR BLINK + bad_word[j] + NOR " 这样的中文字符被系统禁止注册！\n\n" NOR);
      return 0;
    }

  if (member_array(name, bad_word) != -1) {
    write("对不起，这样的中文字符被系统禁止注册。\n");
    return 0;
  }

  if (member_array(name, msg_d) != -1) {
    write("对不起，这样的中文字符被系统禁止注册。\n");
    return 0;
  }

  if (member_array(name, family_name) != -1) {
    write("不能使用门派特有称号作为名字。\n");
    return 0;
  }

  if (member_array(name, nature_name) != -1) {
    write("不能使用天气或频道以及系统特有名词作为名字。\n");
    return 0;
  }

  return 1;
}

object find_body(string name) {
  object ob, *body;

  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++) {
    ob = body[i];
    if (clonep(ob) && getuid(ob) == name
      && ob->query("max_gin") > 0) return ob;
    //check max_gin to avoid damaged user object.
  }

  return 0;
}
