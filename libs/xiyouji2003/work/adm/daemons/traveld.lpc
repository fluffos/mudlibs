// backupd.c

#include <ansi.h>
#include <localtime.h>
#include <command.h>
#include <net/socket.h>
#include <socket_err.h>

inherit F_DBASE;

#define MAX_SOCKET_NUM 10
#define TRAVEL_PORT 6789
int conn;

protected void init_travel(int port);
protected void sys_info(string msg);
void lose_user(int s);
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "漫游精灵");
  sys_info("漫游系统启动。");
  conn = 0;
  call_out("init_travel", 2, TRAVEL_PORT);

}

protected void sys_info(string msg) {
  CHANNEL_D->do_channel(this_object(), "sys", msg);
  //        log_file("travel", ctime(time()) + ": " + msg + "\n");
}

protected void init_travel(int port) {
  int s;
  int error;

  s = socket_create(STREAM, "read_callback", "close_callback");  //create socket	关闭触发 close_callback

  if (s < 0) {
    sys_info("初始化漫游系统失败：socket_error(s)");
    return;
  }

  error = socket_bind(s, port);  //绑定端口
  if (error != EESUCCESS)  //如果不成功
  {
    sys_info("初始化漫游系统失败：绑定端口不成功");
    socket_close(s);
    return;
  }


  error = socket_listen(s, "listen_callback");  //监听端口	调用listen_callback()函数

  if (error != EESUCCESS)  //失败打印错误信息
  {
    sys_info("初始化漫游系统失败：监听端口失败 " + socket_error(s));
    socket_close(s);
    return;
  }

  sys_info("初始化漫游系统成功。");
}

void read_callback(int s, string msg) {

  sys_info("漫游系统接收到信息：" + msg);
  if (msg == "start")
    sys_info("漫游系统开始记录档案数据。");
  if (msg == "stop") {
    sys_info("漫游系统记录档案数据完成。");
    socket_close(s);
  }
}

void close_callback(int s)  //socket 关闭触发
{
  lose_user(s);
  sys_info("漫游系统关闭会话。");
}

void listen_callback(int s)  //监听 触发
{
  int ns;
  int error;
  string address;
  ns = socket_accept(s, "read_callback", "write_callback");
  if (ns < 0 && ns != EENOSOCKS) {
    sys_info("漫游系统启动对话连接失败：" + socket_error(error));
    return;
  }
  if (ns > 10 * MAX_SOCKET_NUM) {
    sys_info("漫游系统频道均已占用，新的连接关闭。");
    socket_close(ns);
    return;
  }

  address = socket_address(ns);
  sscanf(address, "%s %*s", address);  //获得客户端IP
  sys_info("来自" + address + "的漫游请求连接成功。");
  conn++;

  sys_info("漫游系统获得新的连接开始运作。这是第" + conn + "个连接。");
  socket_write(ns, "welcome player travel system\n");
}

void lose_user(int s) {
  socket_close(s);
  conn--;
}

void write_callback(int s) {
  int res;
  string address;  //client
  if (conn > MAX_SOCKET_NUM) {
    res = socket_write(s, "530\n");  //用户太多	s from listen
    if (res != EECALLBACK)
      lose_user(s);
    return;
  }

  res = socket_write(s, "220\n");  //连接ok

  if (res == EESUCCESS || res == EECALLBACK) {
    address = socket_address(s);
    //		sscanf( address, "%s %*s", address );	//获得客户端IP
    sys_info("来自" + address + "的漫游请求连接成功。");
  } else if (res == EEWOULDBLOCK) {
    call_out("write_callback", 2, s);
  } else {
    lose_user(s);
  }
}
