#include <ansi.h>

inherit F_SAVE;
int get_num(string bangname);
int top_list(string a, string b);

mapping bang = ([ "巫师派": ([ "xyj-wiz": 100, "num": 1, ]), ]);

void create() {
  seteuid(getuid());
  if (!restore() && !mapp(bang))
    bang = ([]);
}

int remove() {
  save();
  return 1;
}

string query_save_file() { return DATA_DIR + "bang"; }

void check_player(object ob) {
  string bangname, id;
  int score;

  if (!ob) return 0;
  if (!mapp(ob->query("bang"))) return;
  bangname = ob->query("bang/bang_name");
  score = "/cmds/usr/top.lpc"->get_score(ob);
  id = ob->query("id");

  if (!mapp(bang[bangname]))
    bang += ([ bangname: ([ id: score, "num": 1, ]), ]);

  if (undefinedp(bang[bangname][id]))
    bang[bangname] += ([ id: score, "num": get_num(bangname) + 1, ]);

  map_delete(bang, id);
  bang[bangname] += ([ id: score, "num": get_num(bangname), ]);
  save();
}

int get_num(string bangname) {
  if (undefinedp(bang[bangname])) return 0;
  return bang[bangname]["num"];
}

void del_user(string bangname, string id) {
  if (undefinedp(bang[bangname]) || undefinedp(bang[bangname][id]))
    return;

  map_delete(bang[bangname], id);
  save();
}

int get_total_score(string bangname) {
  int score = 0, i;
  string *ids;
  if (!mapp(bang)) return 0;
  if (undefinedp(bang[bangname])) return 0;
  ids = keys(bang[bangname]);

  for (i = 0; i < sizeof(bang[bangname]); i++) {
    if (ids[i] == "num") continue;
    score += bang[bangname][ids[i]];
  }

  return score;
}

void sort_bang() {
  string str, *bangs, *list;
  int total, num, i, x;

  if (!mapp(bang)) return;

  bangs = keys(bang);
  list = sort_array(bangs, (: top_list :));
  str = "[1;32m【西游快讯】★★★西游人气排行榜★★★             [m \n";
  str += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  str += "排行      帮派名称      帮派总人数      帮派总评价      综合评价\n";
  str += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  sizeof(bangs) > 10 ? x = 10 : x = sizeof(bangs);
  for (i = 0; i < x; i++) {
    str += sprintf("排行第%s：%-20s%-3d\t%-6d\t\t%-6d\n", chinese_number(i + 1), (list[i]), get_num(list[i]),
      get_total_score(list[i]), get_total_score(list[i]) / get_num(list[i]));
  }
  str += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" NOR;


  write(str);

}

int top_list(string a, string b) {
  int m, n;
  m = get_total_score(a) / get_num(a);
  n = get_total_score(b) / get_num(b);
  return n - m;
}
