// Added by waiwai@2001/10/01
void wear_off(object me, object victim, object weapon, int damage) {
  object ob, weapon1;
  int wap, wdp, i, poison1;
  object *inv;
  string poison;

  ob = victim->query_temp("weapon");
  weapon = me->query_temp("weapon");

  if (!weapon || !ob) return;

  if (damage == RESULT_DODGE) return;
  if (objectp(weapon) && damage == RESULT_PARRY && objectp(ob)) {

    wap = (int)weapon->weight() / 500 + query_cz((int)weapon->query("material")) + (int)weapon->query("rigidity") + query_cz((int)weapon->query("Fmaterial")) + (int)me->query("str") + (int)weapon->query("sharp");

    wdp = (int)ob->weight() / 500 + query_cz((int)ob->query("material")) + (int)ob->query("rigidity") + query_cz((int)ob->query("Fmaterial")) + (int)victim->query("str") + (int)ob->query("sharp");

    if (random(wap) < random(wdp)) {
      if (!ob->query("no_break")) {
        message_vision(HIG "$N" HIG "手中的" + ob->name() + HIG "被磕出一个缺口！\n" NOR, victim);
        ob->add("weapon_prop/damage", -1);
        ob->add("lost_prop", 1);
        if (ob->query("keep_this"))
          ob->delete("keep_this");
        if (ob->query("keepto"))
          ob->delete("keepto");
        if ((int)ob->query("weapon_prop/damage") <= 0)
          ob->set("weapon_prop/damage", 0);
        else victim->add_temp("apply/damage", -1);
        if (ob->query("owner"))
          ob->save();
      }
    }
  }
  if (ob->query("weapon_prop/damage") <= 0) {
    message_vision(BLINK HIW "只见「啪」地一声，$N手中的" + ob->name()
      +BLINK HIW "已经完全断裂！\n" NOR, victim);
    ob->unequip();
    ob->set("name", HIR "完全损毁的" + ob->query("name") + NOR);
    ob->set("value", 0);
    ob->set("weapon_prop", 0);
    ob->set("liquid", 0);
    ob->set("no_weapon", 1);

    if (ob->query("keep_this"))
      ob->delete("keep_this");
    if (ob->query("keepto"))
      ob->delete("keepto");

    ob->move(environment(victim));
    victim->set_temp("apply/damage", 0);
    victim->reset_action();
    remove_call_out("remove_broken");
    call_out("remove_broken", random(60) + 30, ob);
  }

  if (stringp(poison = weapon->query("poisoned")) &&
    ((int)victim->query("eff_kee") < (int)victim->query("max_kee")))
    if (intp(poison1 = weapon->query("poison_number")) && random(10) > 5
      && poison1 > 1 && victim->query_condition(poison) < 50) {
      if (poison1 == 2)
        weapon->set_temp("apply/long", ({ weapon->query("long") + "好象是被喂过剧毒，不过效果已经不明显了。\n" }));
      weapon->add("poison_number", -1);
      victim->apply_condition(poison, victim->query_condition(poison) + random(10));
      message_vision(HIR "$n" HIR "只觉得伤口上一麻，大叫一声：不好,有毒！\n" NOR, me, victim);
      if (!victim->is_killing(me->query("id"))) victim->kill_ob(me);
    }

  if (damage && random(5)) {
    inv = all_inventory(victim);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped") == "worn") {
        if (!inv[i]->query("no_break")) {
          message_vision(
            HIR "$N" NOR HIR "身上的" + inv[i]->name() + NOR HIR "被弄坏了一点儿！\n" NOR,
            victim
          );
          inv[i]->add("armor_prop/armor", -1);

          if (inv[i]->query("armor_prop/intelligence")) {
            inv[i]->set("armor_prop/intelligence", 0);
            victim->add_temp("apply/intelligence", -1);
          }

          if ((int)inv[i]->query("armor_prop/armor") <= 0) {
            inv[i]->unequip();
            victim->add_temp("apply/armor", -1);
            if (inv[i]->query("armor_prop/intelligence")) {
              inv[i]->set("armor_prop/intelligence", 0);
              victim->set_temp("apply/intelligence", 0);
            }

            victim->reset_action();
            inv[i]->set("armor_prop", 0);
            inv[i]->set("value", 0);
            inv[i]->delete("equipped");
            if (inv[i]->query("keep_this"))
              inv[i]->delete("keep_this");
            if (inv[i]->query("keepto"))
              inv[i]->delete("keepto");
            message_vision(
              HIG "$N" NOR HIG "身上的" BLINK HIR + inv[i]->name() + NOR HIG "被彻底损毁了！\n" NOR,
              victim
            );
            inv[i]->set("name", inv[i]->query("name") + "的碎片");
            inv[i]->set("long", "一堆" + inv[i]->query("name"));
            inv[i]->move(environment(victim));

            remove_call_out("remove_broken");
            call_out("remove_broken", random(60), inv[i]);
          } else victim->add_temp("apply/armor", -1);
          inv[i]->save();
        }
      }
    }
  }

}

void remove_broken(object ob) {
  if (ob && environment(ob)) {
    tell_object(environment(ob), "一阵微风吹过，" + ob->name() + "化为片片尘土，消失不见了。\n");
    destruct(ob);
  }
}
