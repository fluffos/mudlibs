#include <ansi.h>
#include <combat.h>

void remove_broken(object ob);

// 这里定义的值主要是与破损力有关 by waiwai@2002/12/22
mapping material = ([
  "异类金属": 300,
  "crimsonsteel": 250, /*丹金*/
  "blacksteel": 200, /*玄铁*/
  "gem": 150, /*宝石*/
  "gold": 100, /*金*/
  "silver": 90, /*银*/
  "steel": 80, /*钢*/
  "brass": 70, /*黄铜*/
  "copper": 65, /*铜*/
  "iron": 60, /*铁*/
  "stone": 55, /*石*/
  "wood": 50, /*木*/
  "bone": 45, /*骨*/
  "bamboo": 40, /*竹子*/
  "leather": 35, /*皮革*/
  "fur": 30, /*毛皮*/
  "fiber": 25, /*麻*/
  "silk": 20, /*丝绸*/
  "cloth": 15, /*布*/
  "flower": 5, /*花*/
]);

mapping weapon_actions = ([
  "hit": ([
    "damage_type": "撞伤",
    "action": "$N挥动$w，撞向$n的$l",
    "parry": 20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "slash": ([
    "damage_type": "割伤",
    "action": "$N挥动$w，斩向$n的$l",
    "parry": 20,
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "slice": ([
    "damage_type": "劈伤",
    "action": "$N用$w往$n的$l砍去",
    "dodge": 20,
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "chop": ([
    "damage_type": "劈伤",
    "action": "$N的$w朝著$n的$l劈将过去",
    "parry": -20,
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "hack": ([
    "action": "$N挥舞$w，对准$n的$l一阵乱砍",
    "damage_type": "劈伤",
    //		"damage":		30,
    "dodge": 30,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "thrust": ([
    "damage_type": "刺伤",
    "action": "$N用$w往$n的$l刺去",
    "dodge": 15,
    //		"damage":		20,
    "parry": -15,
    "post_action": (: call_other, __FILE__, "wear_off" :),
    //		"post_action":	(: call_other, __FILE__, "damage_weapon" :),
  ]),
  "pierce": ([
    "action": "$N的$w往$n的$l狠狠地一捅",
    "damage_type": "刺伤",
    "dodge": -30,
    //		"damage":		20,
    "parry": -30,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "wave": ([
    "action": "$N一扬$w，朝$n的$l一挥",
    "damage_type": "鞭伤",
    "dodge": -20,
    "parry": 30,
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "whip": ([
    "action": "$N将$w一扬，往$n的$l抽去",
    "damage_type": "鞭伤",
    "dodge": -20,
    //		"damage":		20,
    "parry": 30,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "impale": ([
    "action": "$N用$w往$n的$l直戳过去",
    "damage_type": "刺伤",
    "dodge": -10,
    //		"damage":		10,
    "parry": -10,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "rake": ([
    "action": "$N高举$w，往$n的$l死命一筑",
    "damage_type": "筑伤",
    "dodge": -15,
    //		"damage":		20,
    "parry": 15,
    "post_action": (: call_other, __FILE__, "wear_off" :),
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "strike": ([
    "action": "$N一个大舒臂抡起$w，对着$n的$l往下一砸",
    "damage_type": "筑伤",
    "dodge": -10,
    //		"damage":		20,
    "parry": -10,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "bash": ([
    "action": "$N挥舞$w，往$n的$l用力一砸",
    "damage_type": "挫伤",
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "crush": ([
    "action": "$N高高举起$w，往$n的$l当头砸下",
    "damage_type": "挫伤",
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "slam": ([
    "action": "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去",
    "damage_type": "挫伤",
    //		"damage":		20,
    "post_action": (: call_other, __FILE__, "wear_off" :),
  ]),
  "throw": ([
    "action": "$N将$w对准$n的$l射了过去",
    "damage_type": "射伤",
    "post_action": (: call_other, __FILE__, "throw_weapon" :),
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "shoot": ([
    "action": "$N弯弓搭箭，只听「嗖」的一声，$w已到$n的$l",
    "damage_type": "射伤",
    "damage": 10,
    "post_action": (: call_other, __FILE__, "throw_weapon" :),
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
  "arrow": ([
    "action": "$N将$w瞄准$n的$l射了过去",
    "damage_type": "射伤",
    "damage": 10,
    "post_action": (: call_other, __FILE__, "throw_weapon" :),
    "post_action": (: call_other, __FILE__, "damage_weapon" :),
  ]),
]);

// Added by waiwai@2002/12/22
// 这里取值
int query_cz(int cz) {
  if (material[cz]) return material[cz];
  return 0;
}

varargs mapping query_action() {
  string verb, *verbs;
  object me, wp1, wp2;
  object waiwai;
  waiwai = find_player("waiwai");
  me = this_player();
  verbs = previous_object()->query("verbs");

  if (!pointerp(verbs)) return weapon_actions["hit"];
  else {
    verb = verbs[random(sizeof(verbs))];
    //		if(waiwai)
    //		tell_object(waiwai,HIR+verb+NOR);
    //		tell_object(me,HIY+verb+NOR);
    if (verb && me->query_temp("weapon")) {
      me->set_temp("kill_weapon", me->query_temp("weapon"));
      me->set_temp("kill_msg", verb);
    }
    if (!undefinedp(weapon_actions[verb])) return weapon_actions[verb];
    else return weapon_actions["hit"];
  }
}

varargs mapping query_apply_action() {
  string verb, *verbs;
  object me, wp1, wp2;
  verbs = previous_object()->query("apply/verbs");

  if (!pointerp(verbs)) return weapon_actions["hit"];
  else {
    verb = verbs[random(sizeof(verbs))];
    if (!undefinedp(weapon_actions[verb])) return weapon_actions[verb];
    else return weapon_actions["hit"];
  }
}

void throw_weapon(object me, object victim, object weapon, int damage) {
  if (objectp(weapon)) {
    if ((int)weapon->query_amount() == 1) {
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
    }
    weapon->add_amount(-1);
  }
}
