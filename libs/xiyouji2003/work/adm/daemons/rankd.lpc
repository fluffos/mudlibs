              else if (avg < 3000000)
                return RED "【" + at + "真龙】" NOR;
              else
                return RED "【" + at + "龙王】" NOR;
              break;
            case "scholar":
              if ((string)at == "无名") {
                if ((int)ob->query_skill("literate", 1) < 40)
                  return RED "【 童  生 】" NOR;
                else if ((int)ob->query_skill("literate", 1) < 200)
                  return RED "【 秀  才 】" NOR;
                else
                  return RED "【 大学士 】" NOR;
              } else {
