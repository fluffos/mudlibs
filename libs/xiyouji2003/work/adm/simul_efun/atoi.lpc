int atoi(string str)
{
int v;

if( !stringp(str) 
	|| !sscanf(str, "%d", v) ) 
    return 0;
return v;
}

int str_to_int(string str)
{
        int n;

        if( !stringp(str) || !sscanf(str, "%d", n) ) return 0;

        return n;
}

string int_to_str(int n)
{
        if( !intp(n) ) return 0;

        return sprintf("%d", n);
}
