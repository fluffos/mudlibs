#include <ansi.h>
#include <dbase.h>
#include <user.h>
#include <condition.h>
#include <mudlib.h>
#include <command.h>

nosave string *my_id;

string *query_my_id() { return my_id; }

void set_name(string name, string *id)
{
	set("name", name);
	set("id", id[0]);
	my_id = id;
}

void set_color(string color)
{
	string colorname;

	colorname = color + query("name");

	colorname = replace_string(colorname, "$BLK$", BLK);
	colorname = replace_string(colorname, "$RED$", RED);
	colorname = replace_string(colorname, "$GRN$", GRN);
	colorname = replace_string(colorname, "$YEL$", YEL);
	colorname = replace_string(colorname, "$BLU$", BLU);
	colorname = replace_string(colorname, "$MAG$", MAG);
	colorname = replace_string(colorname, "$CYN$", CYN);
	colorname = replace_string(colorname, "$WHT$", WHT);
	colorname = replace_string(colorname, "$HIR$", HIR);
	colorname = replace_string(colorname, "$HIG$", HIG);
	colorname = replace_string(colorname, "$HIY$", HIY);
	colorname = replace_string(colorname, "$HIB$", HIB);
	colorname = replace_string(colorname, "$HIM$", HIM);
	colorname = replace_string(colorname, "$HIC$", HIC);
	colorname = replace_string(colorname, "$HIW$", HIW);
	colorname = replace_string(colorname, "$NOR$", NOR);

	set("colorname", colorname + NOR);
}

int id(string str)
{
	string *applied_id;

	if( this_player() && !this_player()->visible(this_object()) ) return 0;

	if( pointerp(applied_id = query_temp("apply/id")) && sizeof(applied_id) ) 
	   if( member_array(str, applied_id)!=-1 )
	    return 1;
	   else
	    return 0;
    
	if( pointerp(my_id) && member_array(str, my_id)!=-1 )
	   return 1;
	  else
	  return 0;
}

string *parse_command_id_list()
{
	string *applied_id;

	if( pointerp(applied_id = query_temp("apply/id")) &&  sizeof(applied_id) )
	   return applied_id;
	  else
	   return my_id;
}

// Modified by waiwai@2001/07/19
varargs string name(int raw)
{
	object me = this_object();
	string str, *mask;

	if (!raw && wizardp(me)
		&& intp(query("env/invisibility"))
		&& query("env/invisibility") > 8) return "某人";
	
	if( !raw && sizeof(mask = query_temp("apply/name")) )
		return mask[sizeof(mask)-1];
       else {
	if( stringp(str = query("name")) )
		return str;
	return file_name(me);
       }
}

varargs string intermud_name(int raw)
{
	return sprintf("%s(%s@%s)", name(raw), 
			capitalize(this_object()->query("id")),
			INTERMUD_NAME);
}

varargs string short(int raw,object killer)
{
  string job_title, party_title, title, degree, farm;
  string force, nick, wargod, str, *mask, regdate, banghui;
  object me = this_object();
  mapping msg;
  int inv, wtime;

  if( !stringp(str = query("short")) )
	// Added by waiwai@2001/06/09
        if (query("color"))
            	str = query("color") + name(raw) + NOR "(" + capitalize(query("id")) + ")";
        else
            	str = name(raw) + "(" + capitalize(query("id")) + ")";

  if( !me->is_character() ) return str;

  if( !raw && sizeof(mask = query_temp("apply/short")) )
  str = (string)mask[sizeof(mask)-1];
  else {
   if( stringp(nick = query("nickname")) )
    str = sprintf("『%s』%s", nick, str);

	if(userp(me)) {
	// Added by waiwai@2001/06/09
	if ( stringp(wargod = query("wargod")) )
	     str = sprintf("%s%s%s%s%s%s",wargod,(degree?"":""),
			(party_title?"":""),(title?"":" "),(nick?"":""), str);

	// Added by waiwai@2001/06/09
	if ( stringp(degree = query("degree")) )
	     str = sprintf("%s%s%s%s%s %s",(wargod?"":""), 
			degree,(party_title?"":""),(title?"":" "),(nick?"":""), str);

/*
	//Added by waiwai@2002/11/25
	if ( stringp(regdate = query("regdate")) ) 
	     str = sprintf("%s%s%s%s%s%s"HIY" %s"NOR,(wargod?"":""), (degree?"":""),
			(party_title?"":""),(title?"":" "),(nick?"":""), str,regdate);
*/
	if( stringp(job_title = query("job_title")) )
	     str = sprintf("%s %s",job_title, str); 

	if( !raw && sizeof(mask = query_temp("apply/title")) )
	     title = (string)mask[sizeof(mask)-1];
	        else
	          title = query("title");

	if( stringp(title) )
	    str = sprintf("%s%s%s", title,(nick?"":" "), str);

	// Added by waiwai@2000/12/03
	if( stringp(banghui=query("banghui")) ) {
		str=sprintf(HIG"%s%s"NOR"%s%s", banghui,
		(string)query("bh_rank")? query("bh_rank"):"帮众"," ",str);
		}
	} else 
	if(!userp(me)) {
	if( !raw && sizeof(mask = query_temp("apply/title")) )
	     title = (string)mask[sizeof(mask)-1];
	        else
	          title = query("title");

	if( stringp(title) )
	    str = sprintf("%s%s%s", title,(nick?"":" "), str);

	if( stringp(banghui=query("banghui")) ) {
		str=sprintf(HIG"%s%s"NOR"%s%s", banghui,
		(string)query("bh_rank")? query("bh_rank"):"帮众"," ",str);
		}
	if( stringp(farm=query("farm")) ) {
		str=sprintf(HIG"%s%s"NOR"%s%s", farm,
		(string)query("nc_rank")? query("nc_rank"):"农众"," ",str);
		}
  	}
	}
	/**************************************************************/
	// Modified by waiwai@2000/12/03
	if (!raw) {
        if ((int)query_temp("pending/exercising")) {
          force = me->query_skill_mapped("force");
          if (force) msg = SKILL_D(force)->exercise_msg(me);
          if (!msg || undefinedp(msg["status_msg"]))
            str = name() + "正在修炼内力"NOR;
          else
            str = msg["status_msg"];
        } else if ((int)query_temp("pending/meditating"))
            str = name() + "正在修炼法力"NOR;
//	}

	// Added by waiwai@2000/10/30
//	if( !raw ) {
	if ( wizardp(me) ) {
		if( me->query("env/wiz_eat") ) str += HIY " <吃饭中>" NOR;
		if( me->query("env/wiz_edit") ) str += HIY " <修改程序中>" NOR;
		if( me->query("env/wiz_leave") ) str += HIY " <暂时离开>" NOR;
		if( me->query("env/wiz_idle") ) str += HIM " <发呆中>" NOR;
		if( me->query("env/wiz_test") ) str += HIG " <系统测试中>" NOR;
		if( in_edit() ) str += HIR " <编辑档案中>" NOR;
		if( me->query("thief") ) str += HIG " <神探鬼手>" NOR;
		if( query_temp("doing_xiudao") ) str += YEL " <升仙中>"NOR;
		if( me->is_ghost() ) str = HIB "(阎罗鬼判) " NOR + str;
	} else 
	if (userp(me)){ // Added by waiwai@2001/02/17 避免npc带类似通缉犯状态
		if( query_temp("shit") ) str += YEL " <方便中>"NOR;
		if( query_temp("doing_xiudao") ) str += YEL " <修道中>"NOR;
		if( query_temp("kill_created") ) str += BLINK HIR " <灰飞湮灭中>"NOR;
		if( me->query_condition("killer") ) str = HIR "(通缉犯) " NOR + str;
		if( me->query("system/test") ) str += HIY " <系统测试>" NOR;
		if(me->query_condition("ghost") ) str += HIB " <厉鬼缠身中>"NOR;
		if( me->is_ghost() ) str = HIB "(鬼气) " NOR + str;

	// 职业类标志(目前仅设置标注玩家)
	if(me->query("occupation") ){
              if(me->query("occupation")=="fighter")
			str = HIW "Ψ " NOR + str;   // 武  士
              if(me->query("occupation")=="stief")
			str = HIB "∮ " NOR + str; // 窃  贼
              if(me->query("occupation")=="smith")
			str = HIM "Ъ " NOR + str; // 工  匠
              if(me->query("occupation")=="doctor")
			str = HIG "ㄖ " NOR + str; // 巫  医
              if(me->query("occupation")=="enchanter")
			str = HIC "ζ " NOR + str; // 术  士
              if(me->query("occupation")=="businessman")
			str = HIY "㊣ " NOR + str; // 商  人
        }

  	}

	// 以下为共有或非共有标志( WIZ or PLAYER or NPC)
	/**************************************************************/
	// 商人摆摊经营时的标志
//	if( me->query_temp("on_baitan") ) str += WHT " <摆摊中>" NOR;
	if( me->query("vip") ) str += HIY " ≮会员≯" NOR;

	inv = (int)me->query("env/invisibility");
	if(inv) str += HIW " <隐身中--"+inv+">"NOR;

	// 特殊Npc标志显示信息
	/**************************************************************/
	if( !userp(me) && !me->query("doing") ) {
	// NPC带地域标志商人的标志
	if(me->query("changed") && !me->query("makestart")) str += YEL " ㊣" NOR;

	// NPC带地域标志商人的标志
	if( (string)me->query("family/family_name") == "大雪山" ||
		(string)me->query("family/family_name") == "方寸山三星洞" ||
		(string)me->query("family/family_name") == "南海普陀山" ||
		(string)me->query("family/family_name") == "将军府" ||
		(string)me->query("family/family_name") == "五庄观" ||
		(string)me->query("family/family_name") == "天蓬府" ||
		(string)me->query("family/family_name") == "阎罗地府" ||
		(string)me->query("family/family_name") == "月宫" ||
		(string)me->query("family/family_name") == "东海龙宫" ||
		(string)me->query("family/family_name") == "火云洞" ||
		(string)me->query("family/family_name") == "天蓬府"  ) str += WHT" ╬" NOR;

	// 职业的原因
	if( me->query("thief") ) str += HIG " <窃贼>" NOR;

	// 可征召Npc且没加入帮会的标志
	if(!me->query("banghui") && me->query("zhengzhao")) str += HIG " @"NOR;
	
	// 可收货商人标志
	if(me->query("dealer")) str += HIY " ξ "NOR;

	// 魂魄精灵时间标志
	if( me->query("nettimes") ) {
	if( time()-me->query("nettimes") > 60 ) 
		str += HIB " [真身已离去"+ XYJTIME_D->query_time(me->query("nettimes")) +"]" NOR;
		else
		str += HIB " [真身已离去。。。]" NOR;
	}

	// 可跟随Npc标志
	if( me->query("lead_to") && !me->query("lead_S")) {
	if( me->query("leader") ) 
	str += HIR " τ"NOR;
	else
	str += HIG " τ"NOR;
	} else
	if( me->query("lead_to") && me->query("lead_S")) {
	if( me->query("leader") ) 
	str += HIR " τ"HIY"ω"NOR;
	else
	str += HIG " τ"HIY"ω"NOR;
	}

	}
	/**************************************************************/

	if( interactive(me) && query_idle(me) > 180 ) {
		str += HIM " <已发呆"+(query_idle(me)-60)/60+"分钟>" NOR;
	}

	if( in_input() ) str += HIC " <输入文字中>" NOR;

//	if( me->query_temp("netdead")>0 ) str += HIB " <断线中。。。>" NOR;


	if(query("doing")) {
	if( query("doing_time")<time())
	str+=WHT" <已进行计划"HIR+XYJTIME_D->query_time(me->query("doing_time")) +NOR WHT">"NOR;
	else
	str+=WHT" <计划中>"NOR;
	}
	else
	if (me->query_temp("netdead")>0) {
	if( time()-me->query_temp("nettimes") > 60  ) {
 		if( me->query_condition("killer") ) 
             	    str += HIB " <被追杀已断线"+ XYJTIME_D->query_time(me->query_temp("nettimes")) +">" NOR;
			else
             	    str += HIB " <已断线"+ XYJTIME_D->query_time(me->query_temp("nettimes")) +">" NOR;
		} else
             	    str += HIB " <断线中。。。>" NOR;
	}

	if ( me->is_fighting() ) str += WHT " <战斗中>" NOR;
	if( !living(me) ) str += HIR + query("disable_type") + NOR;
	}

	return str;
}

varargs string long(int raw)
{
	string str, extra, *mask;
  
	if( !raw && sizeof(mask = query_temp("apply/long")) )
	   str = mask[sizeof(mask)-1];
		  else if( !stringp(str = query("long")) )
	   str = short(raw) + "\n";

	if( stringp(extra = this_object()->extra_long()) )
	   str += extra;

	return str;
}

