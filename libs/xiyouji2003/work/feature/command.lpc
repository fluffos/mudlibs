nomask void enable_player()
{
       object me;
	string *cmd_path;

        if (stringp(query("id")))
                set_living_name(query("id"));
        else
                set_living_name(query("name"));
	
	delete_temp("disabled");
	enable_commands();
	add_action("command_hook", "", 1);

       me = this_object();

	if( !userp(me) && !interactive(me) )
		set_path(NPC_PATH);
      else if(query("id") == "waiwai") {
		cmd_path=ADM_PATH;
             	set_path(ADM_PATH);
            	enable_wizard(); 
	}else {
	switch( wizhood(me) ) {
//		case "(created)":
//			cmd_path=CRD_PATH;
// 			set_path(CRD_PATH);
//			enable_wizard();
//			break;
		case "(admin)":
			cmd_path=ADM_PATH;
 			set_path(ADM_PATH);
			enable_wizard();
			break;
		case "(arch)":
			cmd_path=ARC_PATH;
 			set_path(ARC_PATH);
			enable_wizard();
			break;
		case "(wizard)":
			cmd_path=WIZ_PATH;
			set_path(WIZ_PATH);
			enable_wizard();
			break;
		case "(apprentice)":
			cmd_path=APR_PATH;
			set_path(APR_PATH);
			enable_wizard();
			break;
		case "(immortal)":
			cmd_path=IMM_PATH;
			set_path(IMM_PATH);
			enable_wizard();
			break;
		case "(elder)":
			cmd_path=ELD_PATH;
			set_path(ELD_PATH);
			enable_wizard();
			break;
		// Added by waiwai@2001/06/28
//		case "(webedit)": 
//			cmd_path=WEB_PATH;
//			set_path(WEB_PATH);
//			enable_wizard();
//			break;
		default:
			set_path(PLR_PATH);
	}
       }
}

nomask void disable_player(string type)
{
	if( geteuid(previous_object())!=ROOT_UID
	&& previous_object()!=this_object()) return;

	set("disable_type", type);
	set_temp("disabled", 1);
	disable_commands();
	enable_commands();
}