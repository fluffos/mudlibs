void reset_apply_action() {
  object ob;
  string type, skill;

  if (ob = query_temp("weapon"))
    type = ob->query("apply/skill_type");
  else
    type = "unarmed";

  if (stringp(skill = query_skill_mapped(type))) {
    // If using a mapped skill, call the skill daemon.
    set("actions", (: call_other, SKILL_D(skill), "query_action" :));
  } else {
    // Else, let weapon handle it.
    if (ob) set("actions", ob->query("apply/actions", 1));
    else set("actions", query("default_actions", 1));
  }
}

// This is called in heart_beat() to perform attack action.
//private int attack()
int attack() {
  object opponent;

  clean_up_enemy();

  opponent = select_opponent();
  if (objectp(opponent)) {
    set_temp("last_opponent", opponent);
    COMBAT_D->fight(this_object(), opponent);
    return 1;
  } else
    return 0;
}

//
// init() - called by MudOS when another object is moved to us.
//
void init() {
  object ob, env = environment();
  string vendetta_mark;

  if (this_object()->query("race") != "妖魔" || !this_object()->query("openkill"))
    if (env && (env->query("no_fight") || env->query("no_magic"))) return;

  if (is_fighting()
    || !living(this_object())
    || !(ob = this_player())
    || environment(ob) != env
    || !living(ob)
    || ob->query("linkdead"))
    return;

  // Added By waiwai@2001/03/03
  if (stringp(query("banghui")) && query("banghui") == (string)ob->query("banghui")
    && !userp(this_object()) && userp(ob)) {
    if (!ob->is_killing(query("id")))
      remove_killer(ob);
    call_out("canjian", 0, this_object(), ob);
  }

  // Added By waiwai@2001/03/03
  if (stringp(query("family/family_name"))
    && query("family/family_name") == (string)ob->query("family/family_name")
    && !userp(this_object()) && userp(ob)) {
    if (!ob->is_killing(query("id")))
      remove_killer(ob);
    call_out("family_K", 0, this_object(), ob);
  }

  if (!valid_kill(this_object(), ob, 1)) return;

  if (userp(ob) && is_killing(ob->query("id"))) {
    COMBAT_D->auto_fight(this_object(), ob, "hatred");
    return;
  } else if (stringp(vendetta_mark = query("banghui"))
    && ob->query("vendetta/" + vendetta_mark)) {
    COMBAT_D->auto_fight(this_object(), ob, "vendetta");
    return;
  } else if (stringp(vendetta_mark = query("family/family_name"))
    && ob->query("vendetta/" + vendetta_mark)) {
    COMBAT_D->auto_fight(this_object(), ob, "vendetta");
    return;
  } else if (userp(ob) && (string)query("attitude") == "aggressive") {
    COMBAT_D->auto_fight(this_object(), ob, "aggressive");
    return;
  } else if (random((int)query("bellicosity") / 30) > (int)query("cps")) {
    // mark my_killer_list in combatd/auto_fight.
    COMBAT_D->auto_fight(this_object(), ob, "berserk");
    return;
  }
}

// Added By waiwai@2001/03/03
// 门派追杀
void family_K(object ob, object me) {
  if (!me || environment(me) != environment(ob)) return;
  if (me->query("env/invisibility")) return;

  if (ob->query("env/no_zs")) return;

  if (me->query("hatred/" + ob->query("family/family_name")))
    message_vision(HIY "\n$N对着$n道：" + RANK_D->query_self(ob) +
      "奉门派之命行事，要你这" + RANK_D->query_rude(me) + "给个公道。\n" NOR, ob, me);

  if (is_killing(me->query("id")))
    message_vision(HIR "\n$N大喝一声：$n，今天" +
      RANK_D->query_self_rude(ob) + "要讨个公道！\n" NOR, ob, me);
  else if (me->query("vendetta/" + ob->query("family/family_name")))
    message_vision(HIY "\n$N对着$n道：" + RANK_D->query_self(ob) +
      "奉门派追杀之命行事，还请" + RANK_D->query_respect(me) + "多多担待。\n" NOR, ob, me);
  else {
    // 叩见师傅
    if (!ob->query("leader") && !wizardp(me)) {  // 有跟随的不显示，以免过乱
      if (me->is_apprentice_of(ob))
        message_vision(WHT "\n$N" NOR WHT "躬身对$n" NOR WHT "道：弟子叩见师傅。。。\n" NOR, me, ob);
    } else  // 叩见掌门
    if (!stringp(ob->query("zhangmen/title"))) {  // 对方不是掌门
      if (!ob->query("leader")) {  // 有跟随的不显示，以免过乱
        if (stringp(me->query("zhangmen/title")))
          message_vision(
            WHT "\n$N躬身对$n道：属下叩见 " + me->query("zhangmen/title") + WHT " 掌门。\n" NOR,
            ob,
            me
          );
      }
    }

  }
}

// Added By waiwai@2001/03/03
// 帮会追杀
void canjian(object ob, object me) {
  string banghui;
  object lp;

  if (ob->query("env/no_zs")) return;

  if (!me || environment(me) != environment(ob)) return;
  if (me->query("env/invisibility")) return;
  banghui = (string)ob->query("banghui");

  if (me->query("hatred/" + ob->query("banghui")))
    message_vision(HIG "\n$N对着$n道：" + RANK_D->query_self(ob) +
      "奉帮会之命行事，要你这" + RANK_D->query_rude(me) + "给个公道。\n" NOR, ob, me);
  /*
	if(me->query("BHSL/" +ob->query("banghui")))
	message_vision(HIR"\n$N对着$n道："+RANK_D->query_self(ob)+
	"奉帮会之命行事，要你这"+RANK_D->query_rude(me)+"给个公道。\n"NOR,ob,me);
*/
  if (is_killing(me->query("id")))
    message_vision(HIR "\n$N大喝一声：$n，今天" +
      RANK_D->query_self_rude(ob) + "要讨个公道！\n" NOR, ob, me);
  else if (me->query("vendetta/" + ob->query("banghui")))
    message_vision(HIG "\n$N对着$n道：" + RANK_D->query_self(ob) +
      "奉帮会追杀之命行事，还请" + RANK_D->query_respect(me) + "多多担待。\n" NOR, ob, me);
  else {
    lp = new("/obj/lingpai");
    lp->create(banghui);
    // 参见帮主，对帮主的特殊问候信息
    if (banghui && me->query("banghui") == banghui) {
      if ((string)lp->query("bangzhu_id") == me->query("id") && userp(me)) {
        message_vision(WHT "\n$N躬身对$n道：属下参见" + me->query("name") + WHT "帮主。\n" NOR, ob, me);
        destruct(lp);
      } else if (!stringp(ob->query("bh_rank"))) {
        if (!ob->query("leader")) {
          if (stringp(me->query("bh_rank")))
            message_vision(WHT "\n$N躬身对$n道：属下参见" + me->query("bh_rank") + "。\n" NOR, ob, me);
        }
      }
    }
  }
}
