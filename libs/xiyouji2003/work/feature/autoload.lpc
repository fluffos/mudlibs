// Update by waiwai@2003/04/25

string *autoload;

void clean_up_autoload() { autoload = 0; }

void save_autoload() {
  object *inv;
  int i, j;
  mixed param;

  inv = all_inventory();
  autoload = allocate(sizeof(inv));
  for (i = 0, j = 0; i < sizeof(inv); i++) {
    if (!(param = inv[i]->query_autoload())) continue;
    autoload[j] = base_name(inv[i]);
    if (stringp(param)) autoload[j] += ":" + param;
    j++;
  }
  autoload = autoload[0..j - 1];
}

void restore_autoload() {
  int i, count;
  object ob, pai, sx, gift, item;
  string file, playersx, param, err;
  object user, cloth, boots, blade;

  if (!pointerp(autoload)) return;

  for (i = 0; i < sizeof(autoload); i++) {
    if (sscanf(autoload[i], "%s:%s", file, param) != 2) {
      file = autoload[i];
      param = 0;
    }
    err = catch(ob = new(file));
    if (err || !ob ||
      (file[0..2] == "/u/" && !wizardp(this_object()))) {
      //mon 1/20/98
      write("你觉得似乎失落了什么重要的东西，最好通知一下巫师。\n");
      log_file("AUTOLOAD", sprintf(
        "Fail to autoload %s of %s, error %s on %s\n",
        file, this_object()->query("id"), err, ctime(time())));
      continue;
    }
    export_uid(ob);
    ob->move(this_object());
    count += ob->wear();
    ob->autoload(param);
  }
  // Not sure how count works, it isn't initialized (to be 0?) Dream 8/24/97
  //        if (count==0)
  {
    user = this_object();

    /**************************************************************/
    // Added by waiwai@2003/04/15
    // 以下统一增加类别性质装备
    playersx = user->query("12_sx");

    if (user->query("gift_100")) {
      pai = new("/u/waiwai/gift/100/" + playersx);
      pai->set("owner_id", getuid(user));  // 避免同属相者作弊
      pai->move(user);
    }

    if (user->query("combine_pidu-zhu")) {
      item = new("/obj/self/item/pidu-zhu");
      item->set("owner_id", getuid(user));  // 避免作弊
      item->move(user);
    }

    if (user->query("waiwai_giftto")) {
      gift = new("/obj/self/gift/kelsang");
      gift->set("owner_id", getuid(user));
      gift->set("has_player", log_id(user));
      gift->move(user);
    }

    if (user->query("waiwai_gifttoR")) {
      gift = new("/obj/self/gift/rain");
      gift->set("owner_id", getuid(user));
      gift->set("has_player", log_id(user));
      gift->move(user);
    }

    if (user->query("waiwai_giftto2")) {
      if (user->query("gender") == "女性") {
        gift = new("/obj/self/gift/flower");
        gift->set("owner_id", getuid(user));
        gift->set("has_player", log_id(user));
        gift->move(user);
      } else {
        gift = new("/obj/self/gift/flower2");
        gift->set("owner_id", getuid(user));
        gift->set("has_player", log_id(user));
        gift->move(user);
      }
    }

    //  以下排除组合有的，三件必须的足以，多了也没必要
    if (user->query("12_sx")) {
      if (!user->query("combine_boots")) {
        sx = new("/obj/loginload/12sx/boots/" + playersx);
        sx->set("owner_id", getuid(user));  // 避免同属相者作弊
        sx->move(user);
        sx->wear();
      }

      //裤子
      if (!user->query("combine_pants")) {
        sx = new("/obj/loginload/12sx/pants/" + playersx);
        sx->set("owner_id", getuid(user));  // 避免同属相者作弊
        sx->move(user);
        sx->wear();
      }

      //衣服(上衣)
      if (!user->query("combine_cloth")) {
        sx = new("/obj/loginload/12sx/cloth/" + playersx);
        sx->set("owner_id", getuid(user));  // 避免同属相者作弊
        sx->move(user);
        sx->wear();
      }
    } else {
      cloth = new("/obj/loginload/12sx/pants.lpc");
      cloth->move(user);
      cloth->wear();
      cloth = new("/obj/loginload/12sx/cloth.lpc");
      cloth->move(user);
      cloth->wear();
      boots = new("/obj/loginload/12sx/boots.lpc");
      boots->move(user);
      boots->wear();
      blade = new("/obj/loginload/12sx/blade.lpc");
      blade->move(user);
      blade->wield();
    }
    /**************************************************************/
  }

  clean_up_autoload();  // To save memory.
}
