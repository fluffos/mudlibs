#include <ansi.h>
#include <dbase.h>
#include <user.h>

static string *my_id;

string *query_my_id()
{
    return my_id;
}

void set_name(string name, string *id)
{
        set("name", name);
        set("id", id[0]);
        my_id = id;
}

int id(string str)
{
        string *applied_id;

        if( this_player() && !this_player()->visible(this_object()) ) return 0;

        if( pointerp(applied_id = query_temp("apply/id")) 
        &&      sizeof(applied_id) ) 
                if( member_array(str, applied_id)!=-1 )
                        return 1;
                else
                        return 0;
                        
        // If apply/id exists, this object is "pretending" something, don't
        // recognize original id to prevent breaking the pretending with "id"
        // command.

        if( pointerp(my_id) && member_array(str, my_id)!=-1 )
                return 1;
        else
                return 0;
}

string *parse_command_id_list()
{
        string *applied_id;
        if( pointerp(applied_id = query_temp("apply/id")) 
        &&      sizeof(applied_id) )
                return applied_id;
        else
                return my_id;
}

varargs string name(int raw)
{
        string str, *mask;
        
        if( !raw && sizeof(mask = query_temp("apply/name")) )
                return mask[sizeof(mask)-1];
        else {
                if( stringp(str = query("name")) )
                        return str;
                else
                        return file_name(this_object());
        }
}

varargs string short(int raw)
{
        string title, nick, str, *mask,degree,bang_name,bang_nick,bang_leader,disable_type;
	int inv;
	object me;
	me = this_object();


        if( !stringp(str = query("short")) )
                str = name(raw) + "(" + capitalize(query("id")) + ")";

        if( !this_object()->is_character() ) return str;

        if( !raw && sizeof(mask = query_temp("apply/short")) )
                str = (string)mask[sizeof(mask)-1];
        else 
        {
                if( stringp(nick = query("nickname")) )
                        str = sprintf("「%s」%s", nick, str);

                if( !raw && sizeof(mask = query_temp("apply/title")) )
                        title = (string)mask[sizeof(mask)-1];
                else    title = query("title");
                if( stringp(title) )
                str = sprintf("%s%s%s",title,(nick?"":" "), str);

                if( stringp( degree = query("degree") ) )

                        str = "『" + degree + "』 " +  str;

                if( stringp(bang_nick = query("bang/bang_nick")))
                        str = bang_nick + " " +  str;
                if( stringp(bang_leader = query("bang/bang_leader")))
                        str = bang_leader + " " +  str;
                if( stringp(bang_name = query("bang/bang_name")))
                        str = bang_name + " " +  str;
                str = str + "  ";
//                if( stringp(bang_name = query("bang/bang_name"))
//                &&  stringp(bang_nick = query("bang/bang_nick")) )
//                        str = bang_name + " " + bang_nick +  str;
//modify by fall@xyj for 帮派 9/18/2002
        }

        if( !raw ) {
                if( this_object()->is_ghost() ) str = HIB "(鬼气) " NOR + str;
//                if( query_temp("netdead") ) str += HIG " <断线中>" NOR;
                if( in_input() ) str += HIC " <输入文字中>" NOR;
                if( in_edit() ) str += HIY " <编辑档案中>" NOR;
                if( interactive(this_object())
        &&  query_idle( this_object() ) > 240 ) 
		str += HIM " <已发呆"+(query_idle(me)-60)/60+"分钟>" NOR;

                if( !living(this_object()) ) str += HIR + query("disable_type") + NOR;
	// Added by waiwai@2003/04/13
	if( !interactive(me) && !me->query("doing"))
	if (me->is_net_dead()) str += HIR " <断线中>" NOR;

                if(query("doing")) str+=WHT" <计划中>"NOR;

        if(query_temp("on_bantan")) str+=HIY" <摆摊中>"NOR;
                if(query("env/invisibility")) str+=HIW" <隐身中>"NOR;
/*
	//Added by waiwai@2002/12/19
	inv=me->query("env/invisibility");
	if(inv && wizardp(me) && interactive(me) ) {
	   if( inv>=1 && inv<2 ) str += HIW " <隐身中--1>"NOR;
	    else
	   if( inv>=2 && inv<3 ) str += HIW " <隐身中--2>"NOR;
	    else
	   if( inv>=3 && inv<4 ) str += HIW " <隐身中--3>"NOR;
	    else
	   if( inv>=4 && inv<5 ) str += HIW " <隐身中--4>"NOR;
	    else
	   if( inv>=5 && inv<6 ) str += HIW " <隐身中--5>"NOR;
	    else
	   if( inv>=6 && inv<7 ) str += HIW " <隐身中--6>"NOR;
	    else
	   if( inv>=7 && inv<8 ) str += HIW " <隐身中--7>"NOR;
	    else
	   if( inv>=8 && inv<9 ) str += HIW " <隐身中--8>"NOR;
	    else
	   if( inv>=9 && inv<10 ) str += HIW " <隐身中--9>"NOR;
	    else
	   if( inv>=10 ) str += HIW " <隐身中--10>"NOR;
	}
*/
        }

        return str;
}

varargs string long(int raw)
{
        string str, extra, *mask;
        
        if( !raw && sizeof(mask = query_temp("apply/long")) )
                str = mask[sizeof(mask)-1];
        else if( !stringp(str = query("long")) )
                str = short(raw) + "。\n";

        if( stringp(extra = this_object()->extra_long()) )
                str += extra;

        return str;
}
