//Last Modified by waiwai@2003/01/23

#include <ansi.h>
#include <dbase.h>
#include <weapon.h>

int wear()
{
	object owner;
	mapping armor_prop, applied_prop;
	string *apply, type;
	int level;

	if( !(owner = environment())) return 0;
	if( !owner->is_character() ) return 0;

	if( query("equipped") ) return 1;

	if( !mapp(armor_prop = query("armor_prop")) || query("weapon_prop/damage") > 0 )
		return notify_fail(HIC"你只能穿戴可当作护具的东西。\n"NOR);

	type = query("armor_type");

	//Modified by waiwai@2003/01/12 排除othesr另类类型的防具
	if( owner->query_temp("armor/" + type) && type != "others"  )
		return notify_fail(WHT"你已经穿戴了同类型的护具了。\n"NOR);

	//Added By waiwai@2001/05/25
	if( query("npc_only") && userp (owner) && !wizardp(owner) )
		return notify_fail(HIC"玩家不能穿戴这样东西。 \n"NOR);

	if(userp (owner) && !wizardp(owner) ) {
	//Added by waiwai@2003/01/12
	if( query("female_only") && (string)owner->query("gender") != "女性" )
		return notify_fail(HIG"这是女人的东西，你一个大男人也想用?羞也不羞？\n"NOR);

	//Added by waiwai@2003/01/12
	if( (string)owner->query("gender") != "女性"  && type == "skirts"  )
		return notify_fail(HIG"这是女人的东西，你一个大男人也想用?羞也不羞？\n"NOR);

	//Added by waiwai@2003/01/12
	if(query("need_sx")) {
	if( (string)owner->query("12_sx") != query("need_sx")  )
		return notify_fail(HIG"你的生肖属性与此装备不符，不能使用。\n"NOR);
	}
	if(query("keepto")) {
	if( query("keepto") != log_id(owner)  && !( query("keep_id") == log_id(owner) )  ) 
		return notify_fail(HIG"这是被记号为"+query("keepto")+"的物品，你不能使用。\n"NOR);
	}

	if(query("family_only")) {
	if( query("family_only") != owner->query("family/family_name") ) 
		return notify_fail(HIG+query("family_only")+"专用装备，你不能使用。\n"NOR);
	}

	if( query("vip_only") && !owner->query("vip") ) 
		return notify_fail(HIG"VIP专用装备，你不能使用。\n"NOR);

	//Added by waiwai@2003/01/12
	level= (int)query("need_level");
	if( (int)owner->query("level") < level)
	    return notify_fail("你的经验等级不足以装备此防具。\n");
	}

	//Added by waiwai@2003/01/12
	if (query("need_class") && userp (owner) && !wizardp(owner) ) {
	  if (owner->query("occupation")!=query("need_class"))
	    return notify_fail("你的职业无法穿戴此防具。\n");
	}

	//Added by waiwai@2003/01/12
	if (query("need_zhongzu") && userp (owner) && !wizardp(owner) ) {
	  if (owner->query("zhongzu")!=query("need_zhongzu"))
	    return notify_fail("你的种族无法穿戴此防具。\n");
	}

	//Added by waiwai@2003/01/12
	if (query("thunder") && userp (owner) && !wizardp(owner) )
	  if (!owner->query_temp("thunder"))
	  owner->set_temp("thunder",query("thunder"));
	  else return notify_fail ("你只能穿戴一件散雷器。\n");

	owner->set_temp("armor/" + type, this_object());
	apply = keys(armor_prop);
	applied_prop = owner->query_temp("apply");
	if( !mapp(applied_prop) ) applied_prop = ([]);
	for(int i = 0; i<sizeof(apply); i++)
		if( undefinedp(applied_prop[apply[i]]) )
			applied_prop[apply[i]] = armor_prop[apply[i]];
		else
			applied_prop[apply[i]] += armor_prop[apply[i]];
	owner->set_temp("apply", applied_prop);

	set("equipped", "worn");
	return 1;
}

int wield()
{
	object owner, old_weapon;
	mapping weapon_prop;
	string *apply, type;
	int flag,level;

	// Only character object can wear armors.
	if( !(owner = environment()) || !owner->is_character() ) return 0;

	// If already wielded, just recognize it.
	if( query("equipped") ) return 1;

	// Check if we have "weapon_prop" defined.
	if( !mapp(weapon_prop = query("weapon_prop")) )
		return notify_fail(WHT"你只能装备可当作武器的东西。\n"NOR);

	// Added By waiwai@2001/05/25
	if( query("npc_only") && userp (owner) && !wizardp(owner) )
		return notify_fail("玩家不能装备这件武器。 \n");

	if(userp (owner) && !wizardp(owner)) { 
	// Added by waiwai@2003/01/12
	level= (int)query("need_level");
	if( (int)owner->query("level") < level )
	    return notify_fail("你的经验等级不足以装备此武器。\n");

	if( query("vip_only") && !owner->query("vip") ) 
		return notify_fail(HIG"VIP专用武器，你不能使用。\n"NOR);

	//Added by waiwai@2003/01/12
	if(query("need_sx")) {
	if( (string)owner->query("12_sx") != query("need_sx")  )
		return notify_fail(HIG"你的生肖属性与此装备不符，不能使用。\n"NOR);
	}

	if(query("family_only")) {
	if( query("family_only") != owner->query("family/family_name") ) 
		return notify_fail(HIG+query("family_only")+"专用武器，你不能使用。\n"NOR);
	}

	if(query("keepto")) {
	if( query("keepto") != log_id(owner)  && !( query("keep_id") == log_id(owner) )  ) 
		return notify_fail(HIG"这是被记号为"+query("keepto")+"的物品，你不能使用。\n"NOR);
	}
	}

	// Added by waiwai@2003/01/12
	if(query("need_force") && userp (owner) && !wizardp(owner) ) {
	  if( (int)owner->query("max_force") < query("need_force") )
	    return notify_fail("你感觉全身气息翻腾，原来你内力不够无法装备这样武器。\n");
	}

	// Added by waiwai@2003/01/12
	if( query("need_mana") && userp (owner) && !wizardp(owner) ) {
	  if( (int)owner->query("max_mana") < query("need_mana") )
	    return notify_fail("你感觉全身气息翻腾，原来你法力不够无法装备这样武器。\n");
	}

	// Added by waiwai@2003/01/12
	if(query("need_str") && userp (owner) && !wizardp(owner) ) {
	  if( (int)owner->query_str() < query("need_str") )
	    return notify_fail("你想举起这件武器，怎奈力量不够，只好作罢武器。\n");
	}

	//Added by waiwai@2003/01/12
	if (query("need_class") && userp (owner) && !wizardp(owner) ) {
	  if (owner->query("occupation")!=query("need_class"))
	    return notify_fail("你的职业无法装备此武器。\n");
	}


	//Added by waiwai@2003/01/12
	if (query("need_zhongzu") && userp (owner) && !wizardp(owner) ) {
	  if (owner->query("zhongzu")!=query("need_zhongzu"))
	    return notify_fail("你的种族无法装备此武器。\n");
	}

	flag = query("flag");

	if( flag & TWO_HANDED ) {
		if( owner->query_temp("weapon")
		||	owner->query_temp("secondary_weapon")
		||	owner->query_temp("armor/shield") )
			return notify_fail(HIC"你必须空出双手才能装备双手武器。\n"NOR);
		owner->set_temp("weapon", this_object());
	} else {

		// If we are are using any weapon?
		if( !(old_weapon = owner->query_temp("weapon")) )
		    owner->set_temp("weapon", this_object());

		else // If we still have a free hand? 
		if( !owner->query_temp("secondary_weapon")
		&&	!owner->query_temp("armor/shield") ) {

			// If we can wield this as secondary weapon?
			if(flag & SECONDARY) {
				owner->set_temp("secondary_weapon", this_object());
				if(old_weapon->query("apply/skill_type") &&
				   old_weapon->query("apply/skill_type") ==
				   this_object()->query("apply/skill_type") &&
				   old_weapon->query("skill_type") != 
				   this_object()->query("skill_type") )  {
				       owner->set_temp("use_apply_action", 1);
					   old_weapon->set_temp("use_apply_skill", 1);
                }

			// If we can switch our old weapon to secondary weapon ?
			} else if( (int)old_weapon->query("flag") & SECONDARY ) {
				old_weapon->unequip();
				owner->set_temp("weapon", this_object());
				old_weapon->wield();

			// We need unwield our old weapon before we can use this one.
			} else
				return notify_fail(HIC"你必须先放下你目前装备的武器。\n"NOR);

		// We have both hands wearing something.
		} else
			return notify_fail(HIC"你必须空出一只手来使用武器。\n"NOR);
	}

	apply = keys(weapon_prop);
	for(int i = 0; i<sizeof(apply); i++)
		owner->add_temp("apply/" + apply[i], weapon_prop[apply[i]]);

	if(owner->query_temp("use_apply_action") == 1) {
	   owner->reset_apply_action();
	}
    else	
	   owner->reset_action();

	//Added by waiwai@2003/01/12
	if( !owner->query("max_weapon") ) {owner->set("max_weapon", owner->query("weapon_prop/damage"));}

	set("equipped", "wielded");
	return 1;
}

int unequip()
{
	object owner, weapon;
	mapping prop, applied_prop;
	string *apply, equipped;

	if( !(owner = environment())->is_character() ) return 0;

	if( !stringp(equipped = query("equipped")) )
		return notify_fail(HIC"你目前并没有装备这样东西。\n"NOR);

	if( equipped=="wielded" ) {
		if( (weapon=(object)owner->query_temp("weapon")) == this_object() )
			owner->delete_temp("weapon");
		else if( (object)owner->query_temp("secondary_weapon") == this_object() )
			owner->delete_temp("secondary_weapon");
		owner->delete_temp("use_apply_action");
		// added by snowcat 6/21 (ling jian)
		if (weapon)
			weapon->delete_temp("use_apply_skill");
		prop = query("weapon_prop");
		owner->delete_temp("perf_quick");
		owner->reset_action();
	} else if( equipped=="worn" ) {
		owner->delete_temp("armor/" + query("armor_type") );
		prop = query("armor_prop");
	}

	apply = keys(prop);
	applied_prop = owner->query_temp("apply");
	for(int i = 0; i<sizeof(apply); i++)
		// To support array apply, we cannot add_temp() here.
		applied_prop[apply[i]] -= prop[apply[i]];

	delete("equipped");
	weapon=(object)owner->query_temp("secondary_weapon");
	if(weapon) {
		weapon->unequip();
		weapon->wield();
	}
	return 1;
}

int do_embed(object me)
{
    	object ob;
    	ob = this_object();
  
    	if( !ob->query("embedded") || !me) return 0;
    
    	if(environment(ob) != me 
       	|| me->is_ghost() 
       	|| !me->query_temp("embed")){
	    	delete("embedded");
	      	return 0;
	}
	
    	me->receive_wound("kee", ob->query("damage")*2, "身中"+ob->name()+"而");
	me->receive_damage("kee", ob->query("damage")*4, "身中"+ob->name()+"而");
	tell_object(me, HIR "鲜血正顺着你身上的"+ob->name()+HIR"嘀嗒嘀嗒地直往下流！\n" NOR );
	tell_room(environment(me), HIR + "鲜血顺着"+me->name()+HIR"身上的"+ob->name()+HIR"直往下流！\n" NOR, ({ me }));  
	call_out("do_embed", 15+random(10), me);
	
    	return 1;
}

