//Created by waiwai@2003/02/05
//加入白龙马变小白龙护唐

inherit NPC;
#include <ansi.h>

void create()
{
       set_name(HIW"白龙马"NOR, ({ "bailong ma","bailong","house", "ma" }) );
       set("gender", "雄性");
       set("long", "它本是西海龙王敖闰之子，因犯了逆仵之罪，被贬下人间。\n"NOR);
	set("age", 10);
	set("combat_exp", 100000);
	set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }) );
	set("verbs", ({ "bite"}));

	set("npc_only", 1);
	set("ride/msg", "潇洒地骑");
	set("ride/dodge", 400);
	set_temp("apply/attack", 200);
	set_temp("apply/armor", 200);
	set_temp("apply/dodge", 200);

	setup();
}

void init()
{
  ::init();
	add_action("do_no", "fight");
	add_action("do_no", "kill");
	add_action("do_no", "steal");
	add_action("do_no", "cast");
	add_action("do_no","ji");
	add_action("do_no","throw");
	add_action("do_no","alert");
	add_action("do_no","apply");
	add_action("do_no","ti");
	add_action("do_no","sum");

	call_out("leave",5);  
}

void leave()
{
	object me = this_object(); 
	object where = environment (me);
	object ts = present ("tang sanzang", where);
	object ts2 = find_living("tang sanzang");
        
      if (!ts2) {   
        message("vision",WHT + name() + NOR WHT"一溜烟的跑了。\n" NOR,environment());
        remove_call_out("leave");
        destruct(this_object());
        return ;
       }else{      
        if(!ts) {
         message("vision",CYN + name() + NOR WHT"一溜烟的跑了。\n" NOR,environment());
            if (environment(ts2)) { 
                   me->move(environment(ts2));
               }else{
                   remove_call_out("leave");
                   destruct(this_object());
                   return ;
                } 
          }  
        }
       
   remove_call_out("leave");
   call_out("leave",20); 
   return;
}

int do_no(string arg)
{
	object who = this_player();
	object me = this_object();

	if(arg != "tang sanzang" && who->query_temp("qujing_kill") !=1 ) {
        message_vision(CYN"$N鬼鬼遂遂不知想干什么，$n"NOR CYN"警惕的盯着$N。\n"NOR,who,me);
        return 1;
     }  
	return 0;
}

void die ()
{
	object me = this_object();
	object long;
       long = new("/job/qujing/long");
       long->move( environment(this_object()) );
	message_vision (BLINK HIW"\n只见白龙马嘶叫一声，冲天而起，原来是条真龙。\n"NOR,me);
	destruct (me); 
}

void unconcious() { die (); }
