#include <command.h>

inherit ITEM;

int do_eat(string);

void init()
{
    add_action("do_eat", "eat");
//    remove_call_out("self_dest");
//    call_out("self_dest",600+random(600),this_object());
}

void create()
{
	set_name(YEL "唐僧肉" NOR, ({ "tangseng rou", "rou" }));
	set_weight(100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "块");
		set("long", WHT"这是一块妖魔鬼怪梦寐以求的 "YEL"唐僧肉 "WHT"据说吃了可以长生不老。 \n"NOR);
		set("value", 500000);
              set("no_sell",1);
		set("no_drop", 1);
		set("no_put", 1);
		set("drop_to", 1);
		set("drug_type", "补品");
	}
  
	set("is_monitored",1);
	setup();
}

int do_eat(string arg)
{
	int howmany;

	object me = this_player();
  
	if (!id(arg)) return notify_fail("你要吃什么？\n");

	howmany = (int)me->query("rou_eaten");
  
	me->set("food", (int)me->max_food_capacity());

	if( howmany <= 100 ) me->add_maximum_force(10);
	if( howmany <= 100 ) me->add_maximum_mana(10);

	me->set("rou_eaten", howmany+1);
	if( !wizardp(me) && userp(me) ) {
	me->add("shengwang", -10);
	me->apply_condition("full", ((int)me->query_skill("spells")/5));
	me->apply_condition("ill_liji", ((int)me->query_skill("spells")/5));
	}
	message_vision(HIR "$N把一块"HIY"唐僧肉"HIR"放进嘴里，贪婪地咀嚼着，直吃的满嘴鲜血...... \n" NOR, me);  
       message("system",YEL"『"WHT"謠言惑众"NOR YEL"』顺风耳：听说"+me->name(1)+"("+me->query("id")+
")已经吃得"+me->query("rou_eaten")+"块唐僧肉。\n"NOR,users());
        log_file( "player/renrou", sprintf("[%s]  %s(%s)已经吃了 %d 块唐僧肉。\n",
				log_time(), me->name(1),getuid(me),me->query("rou_eaten")  ) );

       if( me->query("rou_eaten") >= 81 ) {
       me->announce_live_forever( me->query("name")+HIY "吃得了"HIR" 81"HIY" 块取经人肉"HIY"从此终于得以长生不老了！"NOR );
       }

	destruct(this_object());

	return 1;
}
