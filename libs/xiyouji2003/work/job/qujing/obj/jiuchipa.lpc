#include <weapon.h>
inherit RAKE;

void create()
{
  set_name(HIR"九齿"HIW"天蓬钯"NOR, ({ "jiuchi pa", "pa","rake" }) );
  set_weight(18000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
//     set("value", 100000);
     set("no_sell", 1);
     set("no_give", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("npc_only", 1);
     set("rigidity", 9);
     set("sharp", 9);
     set("weapon_prop/dodge", 20);
     set("weapon_prop/parry", 20);
     set("weapon_prop/rake", 20);

    set("replace_file", "/d/obj/weapon/rake/rake");
    set("material", "iron");
    set("long", "一柄长长的九齿天蓬钯。\n");
    set("wield_msg", "$N抡起一柄$n，呼地一声举过头顶。\n");
  }

  init_rake(180);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	pro = (int) victim->query_temp("apply/armor_vs_fire");
	dam = (int) me->query("force");
	if(dam > pro)	{
	victim->receive_wound("kee",10);
	return HIR "九齿"HIW"天蓬钯"HIR"泛出一股红光，直逼$n"HIR"的全身！！！ \n" NOR;
	}
} 

