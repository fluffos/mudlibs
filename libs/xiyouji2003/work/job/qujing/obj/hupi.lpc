#include <armor.h>

inherit WAIST;

void create()
{
       set_name(YEL"虎皮裙"NOR, ({ "hupi qun", "hupi", "skirt" }));
	set("long", "一件孙悟空取经所穿的虎皮纹的短裙。\n");
	set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "件");
                set("value", 100);
                set("no_sell", 1);
                set("npc_only", 1);
		    set("no_break", 1);
		    set("armor_prop/armor", 250);
		    set("armor_prop/spells", 300);
		    set("armor_prop/dodge", 300);
        }
        setup();
}

