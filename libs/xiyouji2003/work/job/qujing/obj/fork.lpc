#include <weapon.h>
#include <ansi.h>

inherit FORK;

void create()
{
	set_name( HIB"碧海"HIR"晴天"HIW"叉" NOR, ({ "12fork", "fork" }));
	set_weight(14000);
	if( clonep() )
	    set_default_object(__FILE__);
	  else {
		set("unit", "柄");
		set("value", 20000);
		set("npc_only", 1);
		set("no_put", 1);
		set("no_break", 1);
		set("no_give", 1);
		set("task_give", 1);
		set("rigidity", 280);
		set("sharp", 10);
		set("is_monitored",1);

		set("material", "silver");
		set("long", "此叉以纯银为头铜为杆。\n");
		set("wield_msg", "$N「呼」地一声抽出一柄$n握在手中。\n");
  		}
		init_fork(80);
		setup();
}

void owner_is_killed(object killer)
{
	message_vision(HIB"\n\n碧海"HIR"晴天"HIW"叉"NOR WHT"落在地上，又弹入$N的手中！\n\n"NOR,killer);
	this_object()->move(killer);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	pro = (int) victim->query_temp("apply/armor_vs_fire");
	dam = (int) me->query("force");
	if(dam > pro)	{
	victim->receive_wound("sen",150);
	me->add("bellicosity",10+random(50));
       return HIB "\n$N被碧海晴天叉呼啸的风声扰的心神不宁……\n" NOR;
       }
}

