#include <armor.h>
inherit SURCOAT;

void create()
{
	set_name(WHT"西行袈裟"NOR, ({ "xixing jiasha", "jiasha" }) );
	set("long", "一件取经人袈裟。\n");
	set_weight(2000);
	  if( clonep() )
	    set_default_object(__FILE__);
	  else {
	set("unit", "件");
	set("material", "cloth");
	set("no_break", 1);
	set("npc_only", 1);
	set("no_sell", 1);
	set("value", 100000);
	set("armor/max_armor", 150);
	set("armor_prop/spells", 100);
	set("armor_prop/dodge", 100);
	}
	setup();
}

