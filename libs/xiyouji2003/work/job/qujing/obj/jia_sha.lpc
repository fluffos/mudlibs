#include <armor.h>
inherit SURCOAT;

void create()
{
	set_name(HIY"锦阑袈裟"NOR, ({ "jia sha", "sha" }) );
	set("long", "一件光彩照人的袈裟。\n");
	set_weight(2000);
	  if( clonep() )
	    set_default_object(__FILE__);
	  else {
	set("unit", "件");
	set("material", "cloth");
	set("no_break", 1);
	set("npc_only", 1);
	set("no_sell", 1);
	set("value", 100000);
	set("armor/max_armor", 350);
	set("armor_prop/spells", 300);
	set("armor_prop/dodge", 300);
	set("is_monitored",1);
	}
	setup();
}

