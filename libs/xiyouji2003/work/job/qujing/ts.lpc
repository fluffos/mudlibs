// 猴子使用方寸武功，突出召唤，分身等特色
// 八戒使用天蓬武功，突出门派特色
// 白龙马变身小白龙后使用龙宫武功
// 胜利得参数是其次，关键是得奇缘宝物

#include <ansi.h>
#include <command.h>

inherit NPC;

string *dirs = ({
"/d/qujing/wuji",
"/d/qujing/baoxiang",
"/d/qujing/tianzhu",
"/d/qujing/nuerguo",
"/d/qujing/yuhua",
"/d/qujing/jinping",
"/d/qujing/wuzhuang",
"/d/qujing/jisaiguo",
"/d/qujing/qinfa",
"/d/qujing/biqiu",
"/d/qujing/zhuzi",
"/d/qujing/chechi",
"/d/qujing/fengxian",
"/d/jz",
"/d/gao",
"/d/xueshan",
"/d/lingtai",
"/d/nanhai",
"/d/sea",
"/d/penglai",
"/d/moon",
"/d/death",
"/d/qujing/wudidong",
"/d/qujing/jilei",
"/d/jjf",
});

int random_place(object me, string dirs);
void tudi();
void _leave();
void leave();

void create()
{
        set_name("唐僧",({"tang sanzang","sanzang", "tangseng"}));
        set("gender","男性");
        set("age",40);
        set("per", 90);
        set("int", 90);
        set("kar", 90);
        set("str", 20);
        set("cor", 25);
        set("cps", 99);
        set("long", @LONG
他就是西天取经的唐僧了，佛法修为深不可测，西天取经造就无数生灵。
LONG);
        set("daoxing",1000000);
        set("combat_exp", 123456);
        set("max_force", 5000);
        set("class","bonze");
        set("eff_kee", 5000);
        set("eff_sen", 5000);
        set("kee", 5000);
        set("gin", 5000);
        set("sen", 5000);
        set("force", 5000);
        set("mana", 5000);
        set_skill("buddhism", 900);
        set_skill("spells", 200);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("force", 100);
        set_skill("unarmed", 100);
        set("stay_time",time()+600+random(300));        
        set("title", "取经人");
        set("nickname", HIY"大唐高僧"NOR);
        set("attitude", "friendly");
        set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :)
        }));
	set("no_blade", 1);
	set("no_poison", 1);

	 set("pet", 0);

        setup();
        carry_object("/job/qujing/obj/jia_sha")->wear();
        carry_object("/job/qujing/obj/yao")->set_amount(60);
        carry_object("/job/qujing/obj/rou")->set_amount(2);

        call_out("choose_npc",3);      
}

void choose_npc()
{
        int k;

        k = random(sizeof(dirs));        
        this_object()->set("target",dirs[k]);
        this_object()->invocation(k);
        reset_eval_cost();
        remove_call_out("choose_npc");
//        call_out("choose_npc",1800);
}

void init()
{
    object who=this_player();
    
    int t=query("stay_time");
    ::init();
    add_action("do_no","ji");    
    add_action("do_qk","cast");
    add_action("do_no","alert");
    add_action("do_no","throw");
    add_action("do_no","steal");
    add_action("do_no","sum");
    add_action("do_no","apply");
    add_action("do_no","duandao");
    add_action("do_no","ti");
    add_action("do_block","",1);    
    if(t && time()>(t+900)) {
        remove_call_out("leave");
        call_out("leave",1);
        return;
    }

	if( query("pet") == 0 ) {
		call_out("qi_pet", 1);
		set("pet", 1);
	}

    if(t && time()>t) {
        remove_call_out("_leave");
        call_out("_leave",900);
    }
    if(!living(this_object())) return;
    if(!living(who)) return;
    remove_call_out("check_room");
    call_out("check_room",2);
}

void qi_pet()
{
	object pet;

       pet = new("/job/qujing/blm");
       pet->move( environment(this_object()) );
	command("mount bailong ma");
	pet->set_leader(this_object());
	return;	
}

int do_qk(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
	if (sscanf(arg, "%s", cast_id) == 1)
     
      if(cast_id=="qiankun" || arg=="qiankun")
     
       tell_object(who,CYN"你隐隐的听到镇元大仙的声音：你这逆徒！"
                +"竟然想吃唐僧肉，休要用我观中法术，以免牵带我全观弟子！\n"NOR);
      return 1;   
}

int do_no(string arg)
{
        object who = this_player();
        object me = this_object();
        message_vision(CYN"$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n"NOR,who,me);
        return 1;
}

void kill_ob (object ob)
{
  object me = this_object();
  object where = environment (me);

  object swk = present ("sun xingzhe", where);
  object zbj = present ("zhu bajie", where);
  object shs = present ("sha heshang", where);
  object xbl = present ("xiao bailong", where);
//  object blm = present ("bailong ma", where);

  message_vision (HIR"\n$N大声急呼: 徒儿救我……\n"NOR,me);
  set_temp("my_killer",ob);
  ob->set_temp("qujing_kill",1);

  if (present("xiao bailong",where)) xbl->kill_ob(ob);
  if (present("sun xingzhe",where)) swk->kill_ob(ob);
  if (present("zhu bajie",where)) zbj->kill_ob(ob);
  if (present("sha heshang",where)) shs->kill_ob(ob);
 // if (present("bailong ma",where)) blm->kill_ob(ob);

  ::kill_ob(ob);
}

void die ()
{
  object ob = query_temp("last_damage_from");
  object me = this_object();
  object where = environment (me);
   
     if( present("sun xingzhe",where) || present("zhu bajie",where) || present("xiao bailong",where)
        ||  present("sha heshang",where) ||  present("bailong ma",where) ) {
           message_vision (HIR"\n$N大呼: 徒儿救我......\n"NOR,me);
           set("eff_kee", 9000);
           set("eff_sen", 9000);
           set("kee", 9000);
           set("sen", 9000);
           set("force", 8000);
           set("mana", 8000);           
        } else {         
           if (!ob) {
                leave();
                return; 
        }      
        
        message_vision(HIR"$N张开血盆大口，一口将唐僧吞下肚了。\n\n"NOR,ob);
        message("system",HIY"┋"HIR"西域灵山"HIY"┋"HIG"如来佛祖：劫数…真是劫数！唐三藏在"HIW+
MISC_D->find_place(environment(me))+HIG"被"+ob->query("name")+"("+ob->query("id")+")吃掉了。\n"NOR,users());

        log_file( "qujing_ts", sprintf("[%s]唐僧在[%s%s](%O.c)被 %s(%s) 吃掉了\n",
				log_time(), MISC_D->find_place(environment(me)),
				COLOR_D->clean_color(environment(ob)->query("short")),
				environment(ob),ob->name(1),getuid(ob)  ) );

        ob->add("max_force",100);
        ob->add("max_mana",100);
        ob->add("maximum_force",100);
        ob->add("maximum_mana",100);
        ob->add("mud_age", -12000);
        ob->add("age_modify", -12000);
        ob->add("age_modify_time", 1);       
        ob->add("daoxing",10000);
        ob->add("potential",2000);
        ob->delete_temp("qujing_kill");        
        ob->save();
        tell_object(ob,CYN"\n你得到了"+COMBAT_D->chinese_daoxing(10000)+"道行和"
                + "2000点潜能,100点内力和法力,而且又年轻了许多。\n"NOR);
        load_object("/obj/empty");
        me->move("/obj/empty");
        destruct (me);
}
}

void destruct_me (object me) { destruct (me); }

void unconcious() { die(); }

void _leave()
{
        object me=this_object();
        if(me->is_fighting() || me->is_busy())
        return;
        leave();
}

void leave()
{
      object me = this_object(); 
      object where = environment (me);
      object swk = present ("sun xingzhe", where);
      object zbj = present ("zhu bajie", where);
      object shs = present ("sha heshang", where);
      object blm = present ("bailong ma", where);
      
	if(this_object()) {
        if(environment(me)) {
	      command("say 徒弟们，看来我们得加紧赶路了。。。");
	      message("vision",HIY + name() + 
                  "带着众徒弟，朝着西天的方向走去。\n" NOR,environment());
	     }
  
	if (present("sun xingzhe",where)) destruct(swk);
	if (present("zhu bajie",where)) destruct(zbj);
	if (present("sha heshang",where)) destruct(shs);
	if (present("bailong ma",where)) destruct(blm);
  
	destruct(this_object());
	}  
      return;
}

int invocation(int i)
{
        object me=this_object();
        if(!random_place(me, dirs[i])) return 0;
        return 1;
}

int random_place(object me, string dirs)
{
        int  j, k;
        object  newob;
        mixed*  file, exit;
        file = get_dir( dirs+"/*.lpc", -1 );

        if( !sizeof(file) ) return 1;

        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirs+"/"+file[j][0]);
             if (newob) {  
               if(newob->query("no_fight") ||
                       newob->query("no_magic") ||
                       !(exit=newob->query("exits")) ||
                       sizeof(exit)<1)
                   continue;

               if(me->move(newob)) {
		//Added by waiwai@2002/12/20
	        CHANNEL_D->do_channel( this_object(),
			"sys", sprintf("在%s%s(%O.lpc" NOR WHT ") [%s]\n",
                     MISC_D->find_place(environment(this_object())), 
			COLOR_D->clean_color(environment(this_object())->query("short")), 
			environment(this_object()),log_time() ));

        message("system",YEL"┋"WHT"謠言惑众"NOR YEL"┋顺风耳：听说自东土大唐去西天取经的"WHT
"唐三藏师徒"YEL"已经到"CYN+MISC_D->find_place(environment(this_object()))+YEL"了。\n"NOR,users());

                   message("system",YEL"┋"WHT"謠言惑众"NOR YEL"┋听说唐僧师徒今晚可能要在"
WHT+environment(this_object())->query("short")+NOR YEL"过夜！\n"NOR,users());
                   message_vision(CYN"$N走了过来。\n"NOR,me);
        		log_file( "qujing_ts", sprintf("[%s]唐僧到了[%s%s](%O.c)\n",
				log_time(), MISC_D->find_place(environment(this_object())),
				COLOR_D->clean_color(environment(this_object())->query("short")),
				environment(this_object())  ) );

                   tudi();
                   return 1;
               }
             }
           }
        }

        return 0;
}

void tudi()
{
   object swk,zbj,shs;
   
   object me=this_object();
   object newob = environment (me);
   swk= new(__DIR__"swk");
   zbj= new(__DIR__"zbj");
   shs= new(__DIR__"shs");
   
   swk->move(newob);
   zbj->move(newob);
   shs->move(newob);
   swk->set_leader(me); 
   zbj->set_leader(me);
   shs->set_leader(me);
}

void check_room()
{
    object me=this_object();
    object env=environment(me);
    if(!living(me)) return;
    if(env && (env->query("no_fight") ||
                env->query("no_magic"))) {
        random_move();
    }
}

void heart_beat()
{
        if (!query_temp("weapon") && !query_temp("added")) {
        set_temp("added", 1);
        set("force_factor",200);
        set("force",9000);
        }
        if (query("eff_kee")<query("max_kee")) {
        if (random(2)) {
        command("eat jinchuang");
        command("eat jinchuang");
        command("eat jinchuang");
        command("eat jinchuang");
        command("surrender");
        call_out("exertheal",1,this_object());
        } else {
	        command("eat jinchuang");
       	 command("eat jinchuang");
               command("surrender");
               call_out("exertheal",1,this_object());
        }
        }
        ::heart_beat();
}

varargs int receive_damage(string type, int damage, object who)
{
  object me=this_object();
  call_out("exertheal",1,me);
  return ::receive_damage(type,damage,who);
}

void exertheal(object me) { me->command("exert recover"); }

int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();
    int t;
       
    if(!userp(who)) return 0;
  
    if(who->query_temp("qujing_kill")==0) return 0;
       
    if(verb!="go" &&
            verb!="fly" &&
            !(environment() && environment()->query("exits/" + verb)))
        return 0;
    
    t= random(3);
   
    if (t==1) {        
        message_vision(WHT"$n乘$N一个不注意，急忙溜了过去。\n"NOR,me,who);
        return 0;
    }
   
        message_vision(HIR"$N一伸手拦在$n面前，高声叫道：\n"+
                " 死妖怪，现在想跑来不急了,拿命来吧！\n\n"NOR,me,who);
        tell_object(who,HIR+me->name()+"一把拦住了你！\n"NOR);
        return 1;
}

