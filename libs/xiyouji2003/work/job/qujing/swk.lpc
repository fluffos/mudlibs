//Last modified by waiwai@2002/12/05
//猴子使用方寸武功，突出召唤，分身等特色

#include <ansi.h>
inherit NPC;

void create()
{
	set_name(  "孙悟空" , ({ "sun xingzhe","swk","sun","xinzhe", "wukong" }) );
	set("long","一个身不足五尺，瘦瘦干干，满身黄毛的猢狲。\n");
	set("age", 30);
       set("title", "大徒弟");
       set("nickname", HIR"齐天大圣"NOR);
	set("attitude", "friendly");
	set("shen_type", 1);
	set("class", "taoist");
       set("str", 90);
       set("cor", 40);
       set("cps", 40);
       set("spi", 90);
       set("int", 90);
       set("con", 40);
       set("kar", 60);
       set("per", 101);

       set("max_kee", 9000);
       set("max_sen", 9000);
       set("max_force", 10000);
       set("force", 10000);
       set("max_mana", 10000);
       set("mana", 10000);
       set("force_factor",300);        
       set("mana_factor",300);
       set("bellicosity",300);
       set("nk_gain", 100+random(50));
       set("nk_factor", 12);

       set("combat_exp", 13500000);
       set("daoxing", 2000000);

       set_skill("unarmed", 999);
       set_skill("dodge", 999);
       set_skill("parry", 999);
	set_skill("stick", 999);
	set_skill("sword", 999);
	set_skill("liangyi-sword", 999);
	set_skill("spells", 999);
	set_skill("dao", 999);
	set_skill("puti-zhi", 999);
	set_skill("wuxiangforce", 999);
	set_skill("force", 999);
	set_skill("qianjun-bang", 999);
	set_skill("jindouyun", 999);
	map_skill("spells", "dao");
	map_skill("unarmed", "puti-zhi");
	map_skill("force", "wuxiangforce");
	map_skill("stick", "qianjun-bang");
	map_skill("parry", "qianjun-bang");
	map_skill("dodge", "jindouyun");
	map_skill("sword", "liangyi-sword");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
	         (: exert_function, "recover" :),
	         (: perform_action,"stick", "pili" :),
                (: cast_spell, "light" :),
                (: cast_spell, "xiaotianquan" :),
                (: cast_spell, "thunder" :),
                (: cast_spell, "boruo" :),
	         (: perform_action,"unarmed", "lianhuan" :),
        }) );

       set_temp("apply/attack", 200);
       set_temp("apply/defense", 200);
       set_temp("apply/armor", 250);
       set_temp("apply/damage", 250);
	set("no_blade", 1);
	set("no_poison", 1);

        setup();

        carry_object("/job/qujing/obj/jingubang")->wield();
        carry_object("/job/qujing/obj/hupi")->wear();
        carry_object("/d/lingtai/obj/shoe")->wear();
        carry_object("/job/qujing/obj/yao")->set_amount(30);
}

void init()
{
  ::init();
	add_action("do_no", "fight");
	add_action("do_no", "kill");
	add_action("do_no", "steal");
	add_action("do_no", "cast");
	add_action("do_no","ji");
	add_action("do_no","throw");
	add_action("do_no","alert");
	add_action("do_no","apply");
	add_action("do_no","ti");
	add_action("do_no","sum");
	add_action("do_no","duandao");

	add_action("do_block","",1);
	call_out("leave",20);   
}

void leave()
{
      object me = this_object(); 
      object where = environment (me);
      object ts = present ("tang sanzang", where);
      object ts2 = find_living("tang sanzang");
  
      if (!ts2) {   
        command("say 师傅都没了，我还是回花果山去了……");
        message("vision",WHT + name() + "一溜烟的跑了。\n" NOR,environment());
        remove_call_out("leave");
        destruct(this_object());
        return ;
       }else{
        if(!ts) {
	  command("say 我得找我师傅去了。。。");
            message("vision",WHT + name() + "一溜烟的跑了。\n" NOR,environment());
            if (environment(ts2)) { 
                   me->move(environment(ts2));
               }else{
                   remove_call_out("leave");
                   destruct(this_object());
                   return ;
                }       
          }    
        }
       
   remove_call_out("leave");
   call_out("leave",5); 
   return;
}

int do_no(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg!="tang sanzang" && who->query_temp("qujing_kill")!=1) {
      message_vision(CYN"$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n"NOR,who,me);
     return 1;
  }

  return 0;
}

void die ()
{
        object me = this_object();
        message_vision (WHT"\n$N掉头就走,边跑边喊:  我先回花果山去了……\n"NOR,me);
        load_object("/obj/empty");
        me->move("/obj/empty");
        call_out ("destruct_me",3,me);  
}

void destruct_me (object me) { destruct (me); }

void unconcious() { die(); }

int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();
    int t;
   
    if(!userp(who)) return 0;       
      
    if(who->query_temp("qujing_kill")==0) return 0;
       
    if(verb!="go" &&
            verb!="fly" &&
            !(environment() && environment()->query("exits/" + verb)))
        return 0;
    
    t= random(2);
   
    if (t==1) {
        message_vision(WHT"$n乘$N一个不注意，急忙溜了过去。\n"NOR,me,who);
        return 0;
    }
        message_vision(HIY"$N金箍棒一伸拦在$n面前，高声叫道：\n"+
                " 死妖怪，现在想跑来不急了,拿命来吧！\n\n"NOR,me,who);
        tell_object(who,HIR+me->name()+"一把拦住了你！\n"NOR);
         return 1;
}

void kill_ob (object ob)
{
  ob->set_temp("qujing_kill",1);
  ::kill_ob(ob);
}

void heart_beat()
{
        if (!query_temp("weapon") && !query_temp("added")) {
        set_temp("added", 1);
        set("force_factor",300);
        set("force",9000);
        }
        if (query("eff_kee")<query("max_kee")) {
        if (random(2))
        command("eat jinchuang");
        else {
                command("surrender");
                call_out("exertheal",1,this_object());
        }
        }
        ::heart_beat();
}

varargs int receive_damage(string type, int damage, object who)
{
  object me=this_object();
  call_out("exertheal",1,me);
  return ::receive_damage(type,damage,who);
}

void exertheal(object me) { me->command("exert recover"); }

