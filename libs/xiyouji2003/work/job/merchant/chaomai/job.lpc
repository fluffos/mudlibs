  "开封城货物集散地",  //兵器
  "凤仙郡货物集散地",  //瓷器
  "钦法国货物集散地",  //布料
  "祭赛国货物集散地",  //银器
  "长安城货物集散地",  //荔枝
  "金平府货物集散地",  //酥油
  "比丘国货物集散地",  //牛油
  "玉华县货物集散地",  //烤羊
  "宝象国货物集散地",  //锡器
  "乌鸡国货物集散地",  //哈密瓜
  "车迟国货物集散地",  //妓女
  "陈家庄货物集散地",  //鲜鱼
  "女儿国货物集散地",  //葡萄
  "朱紫国货物集散地",  //熊掌
  "天竺国货物集散地",  //臭干子
});

mapping *goods = ({
  ([
    "name": "兵器",
    "price": 1000
  ]),
  ([
    "name": "瓷器",
    "price": 1100
  ]),
  ([
    "name": "布料",
    "price": 800
  ]),
  ([
    "name": "银器",
    "price": 1200
  ]),
  ([
    "name": "荔枝",
    "price": 500
  ]),
  ([
    "name": "酥油",
    "price": 700
  ]),
  ([
    "name": "牛油",
    "price": 300
  ]),
  ([
    "name": "烤羊",
    "price": 600
  ]),
  ([
    "name": "锡器",
    "price": 900
  ]),
  ([
    "name": "哈密瓜",
    "price": 400
  ]),
  ([
    "name": "妓女",
    "price": 700
  ]),
  ([
    "name": "鲜鱼",
    "price": 1300
  ]),
  ([
    "name": "葡萄",
