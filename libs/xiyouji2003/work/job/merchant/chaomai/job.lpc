  ]),

});

mixed query(string arg) {
  if (arg && arg == "channel_id")
    return "炒卖精灵(chaomai)";
  return 0;
}

string ask_job(object npc, object ob) {
  mapping job_sets;
  object given;

  if (ob->query("combat_exp") < 1000000)
    return ("这位" + RANK_D->query_respect(ob) + "，你的经验这么低，我怎么敢把这么大数目的钱款交给你？\n");

  if (ob->query_temp("merchant/chaomai/given"))
    return ("这次炒卖了几次？把支票薄给我看看！\n");

  job_sets = goods[random(sizeof(goods))];

  given = new(__DIR__ "npc/obj/check");
  given->move(ob);

  message_vision(npc->query("name") + "阴阴的笑着说：“最近" HIW +
    job_sets["name"] + NOR "的生意挺好做，我的库存没有了，你帮我去进点货。", npc);
  message_vision("\n我给你一万两帑金，你去尽量帮我买多点回来。买得多，赚得多。记得30分钟后可要拿回来哦。\n", ob);
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s在商行领了一个炒卖%s的任务。\n" NOR,
      log_id(ob), job_sets["name"]));

  ob->set_temp("merchant/chaomai", job_sets);
  ob->set_temp("merchant/chaomai/given", 1);
  ob->set_temp("merchant/chaomai/now_money", 10000);
  ob->set_temp("merchant/chaomai/base_money", 10000);
  ob->set_temp("merchant/chaomai/starttime", time());
  ob->set_temp("job/fulltime", 1);
  ob->apply_condition("job_chaomai", 250);
  return "\n";
}

string give_gifts(object ob) {
  int win_money;

  win_money = ob->query_temp("merchant/chaomai/now_money") - ob->query_temp("merchant/chaomai/base_money");
  if (win_money > 4000000) win_money = 100 * ob->query("Chaomai_money") + win_money / 100;
  else
    win_money = 100 * ob->query("Chaomai_money") + win_money / 1000;

  ob->delete("Chaomai_money");
  ob->add("balance", win_money);
  ob->delete_temp("merchant/chaomai");
  ob->delete_temp("job");
  //Added by waiwai@2002/12/20
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s炒卖赚得了%s  [%s]\n" NOR, log_id(ob), MONEY_D->money_num(win_money), log_time()));
  log_file("player/chaomai", sprintf("[%s] %s炒卖赚得%s \n",
    log_time(), log_id(ob), MONEY_D->money_num(win_money)));

  ob->clear_condition("job_chaomai");
  return HIC "你帮晕罐(Emoc)成功炒卖了一次货物，得到了：" + MONEY_D->money_num(win_money) + "数目的金钱
晕罐(Emoc)已经把钱存入你的银行了。\n" NOR;

}

int set_price(object me) {
  object env = environment(me);
  int i, price;

  for (i = 0; i < sizeof(places); i++) {
    price = goods[i]["price"];
    if (env->query("short") == places[i])
      price /= 2;
    env->set("merchant_job/" + goods[i]["name"], random(price / 2) + price / 2);
  }

  env->set("no_set_price", 0);
  return 1;
}
