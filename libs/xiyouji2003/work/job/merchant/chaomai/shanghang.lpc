#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "长安商行" NOR);
  set("long", @LONG  
     
这里是晕罐和忽悠在西游记中合开的一间商行，做的都是大生
意。晕罐是老板，而忽悠则是老板娘，这间商行负责将各地的
特产汇总，然后再高价炒出去。
LONG);

  set("exits", ([
    "south": CITY_OB("city", "xuanwu-e1"),
  ]));

  set("objects", ([
    __DIR__ "npc/ji": 1,
    __DIR__ "npc/budian": 1,
    __DIR__ "npc/huyou": 1,
  ]));


  setup();
}
