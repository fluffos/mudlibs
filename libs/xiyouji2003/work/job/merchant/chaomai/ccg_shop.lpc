// Created By waiwai@2001/02/08
// 车迟国 [妓女]

inherit ROOM;

void create()
{
	set("short", "车迟国货物集散地");
	set("long", @LONG  
     
这里是车迟国货物集散地，房子旁边的广场上放的都是这里的货
物，货物真是什么都有。当然也少不了这里的特产。
LONG);

	set("exits", ([
		"west" : QJ_OB("chechi","shatan1"),
	]));

       set("outdoors", "车迟国");
	set("merchant_job",1);
	set("no_set_price",1);
	set("NONPC",1);

	setup();
}

void init()
{
	object me=this_player();
	mapping now_place;
	string *place;

	now_place = me->query_temp("chaomai_buy");
	if ( now_place )
		place = keys(now_place);

	if ( me->query_temp("merchant/chaomai/given") )	{	
		for (int i=0;i<sizeof(place);i++ )
			if ( environment(me)->query("short")!=place[i] )
				me->delete_temp("chaomai_buy/"+place[i]);
	}

}
