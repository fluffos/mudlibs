// Created By waiwai@2001/02/08

#include <ansi.h>
inherit ITEM;

void create()
{
	set_name("支票簿", ({"check book"}));
       set("channel_id", "炒卖精灵");
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本支票簿。晕罐(Emoc)开的商行与各地特产专卖店通用的支票簿。在其他地方是用不了的。\n");
		set("no_get", 1);
		set("no_steal", 1);
		set("no_putin", 1);
		set("no_drop", 1);
		set("no_put", 1);
	}
	setup();
}

void init()
{
	add_action("do_jinhuo", "jinhuo");
	add_action("do_chuhuo", "chuhuo");
	add_action("do_chakan", "chakan");
	add_action("check_job_place", "");
}

int do_jinhuo(string arg)
{
	object me=this_player();
	object ob=this_object();
	string show="";
	int price,money,used_money,buy_num,remain_money,price_up;
	mapping now_price;
	string *pricei;

	if (!environment(me)->query("merchant_job")) return 0;
	
	price=environment(me)->query("merchant_job/"+me->query_temp("merchant/chaomai/name"),1);
	money=me->query_temp("merchant/chaomai/now_money");

	if ( !arg )
		return notify_fail("你要进货，进多少呀。\n格式：jinhuo [all/一个数字]\n");
	else if ( arg=="all" )
		buy_num=money/price;
	else if ( !sscanf(arg, "%d", buy_num))
		return notify_fail("你要进货，进多少呀。\n格式：jinhuo [all/一个数字]\n");

	used_money=buy_num*price;
	remain_money=money-used_money;

	if ( arg=="all" && used_money<0 ) used_money==0;

	if ( remain_money<0 || (arg=="all" && used_money==0 ))
		return notify_fail("你身上的帑钱不足够进货。\n");
	
	if ( (money>5000000 && arg=="all") || money>5000000 )
		return notify_fail("你身上的帑钱够多了，不能再进货了。\n");

	if ( (price<50 && arg=="all") || price<50)
		return notify_fail("这样东西不能再进货了。。。\n");

	if ( (price>5000 && arg=="all") || price>5000)
		return notify_fail("这样东西不能再进货了。。。\n");

	show+="这里"HIW+me->query_temp("merchant/chaomai/name")+NOR"的价格为："CYN+price+WHT"两帑金/一百个。\n"NOR;

	if ( arg=="all" )
		show+="你身上有"YEL+money+NOR"两帑金。你一共可以买"YEL+buy_num+NOR"个"+me->query_temp("merchant/chaomai/name")+"。\n";
	else 
		show+="你身上有"YEL+money+NOR"两帑金。你一共要买"YEL+buy_num+NOR"个"+me->query_temp("merchant/chaomai/name")+"。\n";

	show+="一共用去"YEL+used_money+NOR"两帑金。你身上还剩下有"YEL+remain_money+NOR"两帑金。\n";
	show+="你得到了一张取货凭据。\n";

	tell_object(me, show);

	price_up=used_money/3000;
	if( price_up >50) price_up=50;	
	if( price_up<1) price_up=1;	

        CHANNEL_D->do_channel(this_object(),"imud",
	sprintf("%s在%s买进了%d单位的%s\n%s物价指数上升了%d\n" NOR, 
	log_id(me), environment(me)->query("short"), buy_num, me->query_temp("merchant/chaomai/name"), 
	environment(me)->query("short"),price_up));

	message_vision("$N向店里老板购买了 "+buy_num+" 个单位的"HIW+me->query_temp("merchant/chaomai/name")+NOR"\n", me);
	if( price_up>0) 	
	message_vision("这里的物价指数上升了 "BLINK HIC+price_up+NOR" \n", me);

	now_price = environment(me)->query("merchant_job");
	pricei = keys(now_price);
	for (int i=0;i<sizeof(pricei);i++ )
		environment(me)->add("merchant_job/"+pricei[i],price_up);

	if( !objectp(present("good check", me)) )	{
		ob=new(__DIR__"pingju");
		ob->move(me);
	}
	me->add_temp("merchant/chaomai/now_money",(-1)*used_money);
	me->add_temp("merchant/chaomai/now_goods",buy_num);
	me->set_temp("chaomai_buy/"+environment(me)->query("short"),1);

	return 1;
}

int do_chuhuo(string arg)
{
	object me=this_player();
	object ob=this_object();
	string show="";
	int price,goods_num,money,get_money,now_money,sell_num,price_down;
	mapping now_price, now_place;
	string *pricei, *place;

	if (!environment(me)->query("merchant_job"))
		return 0;
	
	now_price = me->query_temp("merchant/chaomai");
	pricei = keys(now_price);

	now_place = me->query_temp("chaomai_buy");
	place = keys(now_place);

	price=environment(me)->query("merchant_job/"+me->query_temp("merchant/chaomai/name"),1);
	goods_num=me->query_temp("merchant/chaomai/now_goods");
	money=me->query_temp("merchant/chaomai/now_money");

	if ( !arg )
		return notify_fail("你要出多少货？\n格式：chuhuo [all/一个数字]\n");
	else if ( arg=="all" )
		sell_num=goods_num;
	else if ( !sscanf(arg, "%d", sell_num))
		return notify_fail("你要出多少货？\n格式：chuhuo [all/一个数字]\n");

	if ( sell_num>goods_num )
		return notify_fail("你没有这么多货，怎么出？\n");

	if ( arg=="all" && goods_num==0 )
		return notify_fail("你身上没有货物了，怎么出货。\n");

	for (int i=0;i<sizeof(place);i++ )
		if ( environment(me)->query("short")==place[i] ){
			show+="由于你刚刚在这里买过货物，所以价钱减半。\n";
			price/=2;
		}

	get_money=sell_num*price;
	now_money=money+get_money;

	show+="这里"HIW+me->query_temp("merchant/chaomai/name")+NOR"的价格为："CYN+price+WHT"两帑金/一百个。\n"NOR;

	if ( arg=="all" )
		show+="你身上有"YEL+goods_num+NOR"个这种货物。\n";
	else 
		show+="你身上有"YEL+goods_num+NOR"两帑金。你一共要卖"YEL+sell_num+NOR"个"+me->query_temp("merchant/chaomai/name")+"。\n";

	show+="一共得到了"YEL+get_money+NOR"两帑金。你身上现在有"YEL+now_money+NOR"两帑金。\n";

	tell_object(me, show);

	price_down=get_money/5000;
	if( price_down >20) price_down=20;	
	if( price_down<1) price_down=1;	

        CHANNEL_D->do_channel(this_object(),"imud",
	sprintf("%s在%s卖出了%d单位的%s\n%s物价指数下降了%d\n" NOR, 
	log_id(me), environment(me)->query("short"), sell_num, me->query_temp("merchant/chaomai/name"), 
	environment(me)->query("short"), price_down));

	message_vision("$N向店里老板卖出了 "+sell_num+" 个单位的"HIW+me->query_temp("merchant/chaomai/name")+NOR" \n", me);
	if( price_down >0 )
	message_vision("这里的物价指数下降了 "BLINK HIC+price_down+NOR" \n", me);

	now_price = environment(me)->query("merchant_job");
	pricei = keys(now_price);

	for (int i=0;i<sizeof(pricei);i++ )
		if ( environment(me)->query("merchant_job/"+pricei[i],1)- price_down <= 0 )
			environment(me)->set("merchant_job/"+pricei[i],1);
		else
			environment(me)->add("merchant_job/"+pricei[i],(-1)*price_down);

	me->add("Chaomai_money",1);
	me->add_temp("merchant/chaomai/now_money",get_money);
	me->add_temp("merchant/chaomai/now_goods",(-1)*sell_num);

	return 1;
}

int do_chakan(string arg)
{
	object me=this_player();
	object ob=this_object();

	if ( arg=="check book" ) {
		if ( !me->query_temp("merchant/chaomai/given") )
			return notify_fail("你没有向不点要任务，你怎么会有这本支票簿。\n");
		message_vision("$N翻开支票簿，开始认真查看支票簿。\n", me);
		tell_object(me, "支票簿中记录着你现在有"WHT+me->query_temp("merchant/chaomai/now_money")+NOR"两帑金。\n");
	}
	return 1;
}

int check_job_place()
{
	object env=environment(this_player());

	if ( env->query("merchant_job") && env->query("no_set_price"))
		JOB_OB2("merchant/chaomai")->set_price(this_player());
}
