});

varargs void drool(string msg, string who);

void create() {
  string name, id;

  set_name("搞笑", ({ "gaoxiao" }));
  set("title", HIM "商行的小活计" NOR);
  set("gender", "男性");
  set("age", 19);
  set("per", 28);
  set("rank_info/respect", "小帅哥");
  set("attitude", "friendly");
  set("combat_exp", 1000000);
  set("env/wimpy", 100);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: drool :),
    (: drool :),
    (: drool :),
    (: drool :),
    (: drool :),
    (: command("say " + rnd_say[random(sizeof(rnd_say))]) :),
    (: command("say " + rnd_say[random(sizeof(rnd_say))]) :),
    (: command("say " + rnd_say[random(sizeof(rnd_say))]) :),
    (: command("say " + rnd_say[random(sizeof(rnd_say))]) :),
    (: command("pani gaoxiao") :),
    (: command("yawn") :),
    (: command("win") :),
    (: command("zzz") :),
    (: command("slogan") :),
    (: command("lag") :),
    (: command("shajiabang huyou") :),
    (: command("yanshu budian") :),
  }));
  setup();
  /*
        carry_object(__DIR__"obj/sneaker")->wear();
        carry_object(__DIR__"obj/jean")->wear();
        carry_object(__DIR__"obj/shirt")->wear();
        carry_object(__DIR__"obj/coat")->wear();
*/
  if (clonep())
    CHANNEL_D->register_relay_channel("wiz");

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("env/invisibility")) return;
  command("kick " + ob->query("id"));
  command("say " + RANK_D->query_rude(ob) + "，谁让你进来的？ 没看见我们收工了吗？");

}

int add_phrase(string who, string msg) {
  msg = replace_string(msg, "呀", "");
  msg = replace_string(msg, "嘛", "");
  msg = replace_string(msg, "？", "");
  msg = replace_string(msg, "喔", "");
  msg = replace_string(msg, "！", "");
  msg = replace_string(msg, "啊", "");
  msg = replace_string(msg, "吗", "");
  msg = replace_string(msg, "耶", "");
  msg = replace_string(msg, "吧", "");

  if (msg != "") {
    add("memory/" + who, ({ msg }));
    return 1;
  } else return 0;
}

string make_reply() {}

void relay_channel(object ob, string channel, string msg) {
  string who, phrase;

  //        if( !userp(ob) || (channel != "wiz") ) return;
  who = ob->query("name");

  // Don't process our own speech.
  if (ob == this_object()) return;

  if (add_phrase(who, msg) && random(10) > 4)
    drool(msg, ob->query("name"));
}

void relay_say(object ob, string msg) {
  string who, phrase;

  if (!userp(ob)) return;
  who = ob->query("name");

  // Don't process our own speech
  if (ob == this_object()) return;

  if (add_phrase(who, msg) && random(10) > 4)
    drool(msg, ob->query("name"));
}

void relay_emote(object ob, string verb) {
  if (!userp(ob)) return;

  switch (verb) {

    case "kick": command("say 再踢？再踢小心我废了你！"); break;
    case "idle": command("heng"); break;
    case "kiss2": command("puke"); break;
    case "kiss1": command("puke"); break;
    case "kiss": command("puke"); break;
    default:
      if (random(10) < 7)
        command(verb + " kittt");
      else
        drool();
  }
}

varargs void drool(string msg, string who) {
  mapping mem;
  string *ob;

  mem = query("memory");
  if (!mapp(mem)) return;

  if (!msg || !who) {
    ob = keys(mem);
    who = ob[random(sizeof(ob))];
    msg = mem[who][random(sizeof(mem[who]))];
  }

  if ((strsrch(msg, "为什麽") >= 0)) {
    if (sscanf(msg, "%*s为什麽%s", msg) == 2) msg = "为什麽" + msg;
    switch (random(5)) {
      case 0: command("say " + who + "，You are asking me？"); break;
      case 1: command("say 关於" + msg + " 这个...这个... "); break;
      case 2: command("say 嗯 ... 我要想想。"); drool(); break;
      case 3: command("say " + who + "你能不能用英文再重复一遍？"); break;
      case 4: command("say " + who + "，我听不懂你问的什麽。"); break;
    }
  } else if ((strsrch(msg, "你") >= 0)
    || (strsrch(msg, "□") >= 0)
    || (strsrch(msg, "drooler") >= 0)
    || (strsrch(msg, "Drooler") >= 0)) {
    if (sscanf(msg, "%*s你%s", msg) == 2) msg = "你" + msg;
    msg = replace_string(msg, "你", "我");
    msg = replace_string(msg, "□", "我");
    switch (random(6)) {
      case 0: command("say " + who + "，are you saying" + msg + "？"); break;
      case 1: command("say 鬼才相信" + msg); break;
      case 2: command("say " + msg + " 管你屁事？"); break;
      case 3: command("say Who care " + msg + "？"); break;
      case 4: command("say 嘿嘿。"); break;
      case 5: command("say 呸呸呸！！"); break;
    }
  } else if ((strsrch(msg, "我") >= 0)) {
    if (sscanf(msg, "%*s我%s", msg) == 2) msg = "我" + msg;
    msg = replace_string(msg, "我", "你");
    msg = replace_string(msg, "?", "");
    switch (random(5)) {
      case 0: command("say Are you saying " + msg + "？"); break;
      case 1: command("say 真的？" + msg + "？"); break;
      case 2: command("consider"); break;
      case 3: command("say 我有同感耶。"); break;
      case 4: command("say I don't wanna talk about「" + msg + "」这个话题了"); ;
    }
  } else {
    switch (random(20)) {
      case 0: command("say what?? " + msg + "?"); break;
      case 1: command("say 「" + msg + "」在英文里是什麽意思？"); break;
      case 2: command("say " + msg + "？"); break;
      case 3: command("say How can i know “" + msg + "” ?"); break;
      case 4: command("say I just don't know what they are talking about."); break;
      case 5: command("say Shit!!"); break;
      case 6: command("say 就算你说 " + msg + "，又怎样？"); break;
      case 7: command("say what is the wkz??"); break;
      case 8: command("say *_^ "); break;
      case 9: command("say so？"); break;
      case 10: command("say Fuck up."); break;
      default:
        command("say " + rnd_say[random(sizeof(rnd_say))]);
        break;
    }
  }
}

void reset() { delete("memory"); }
