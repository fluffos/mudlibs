#include <ansi.h>

inherit NPC;

void create()
{
	set_name("忽悠", ({ "come"}) );
	set("title", HIG"商行老板娘"NOR);
	set("gender", "女性" );
	set("age", 20);
	set("per", 40);
	set("long","这个当然是晕罐的至爱啦，可以算是晕罐的好老婆吧。\n");
	set("attitude", "friendly");
	set("rank_info/respect", "晕罐的好老婆");
	setup();
}

void relay_emote(object me,string arg)
{
	command(arg+" "+me->query("id"));
}
