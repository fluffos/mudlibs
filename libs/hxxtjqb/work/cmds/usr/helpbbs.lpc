}

private void confirm_a_choice(string arg)
{
    this_player()->set_temp("help_a",1);
   if(arg=="") {
 a_display();
 write(YEL "\r请从新输入您得选择:"NOR);
 input_to((:confirm_a_choice:),this_player());
 return ; }
 switch(arg){
    case "1":
              start_help(read_file("/doc/help/about"));
              return ;
    case "2":
             start_help(read_file("/doc/help/concepts/cmds"));
             return ;
    case "3":
             start_help(read_file("/doc/help/specials/newbie"));
             return ;
    case "4":
             start_help(read_file("/doc/help/specials/rules"));
             return ;
    case "5":
             start_help(read_file("/doc/help/specials/tiantiao"));
             return ;
    case "6": 
             start_help(read_file("/doc/help/concepts/settings"));
             return ;
    case "7":
             start_help(read_file("/doc/help/specials/wizrules"));
             return ;
    case "8":
             start_help(read_file("/doc/help/specials/neima"));
             return ;
    case "b":
             this_player()->delete_temp("help_a");
             m_display();
             write(YEL "\r请输入您得选择:"NOR);
             input_to((:confirm_main_choice:),this_player());
             return ;
    default:
           a_display();
           write(YEL"\r请输入您的选择:"NOR);
           input_to((:confirm_a_choice:),this_player());
           return ;
        }
  return;
}
