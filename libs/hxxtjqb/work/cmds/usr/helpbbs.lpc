void u_display()
{
      view_main();
      write("                       "HIC"(Ｉ)"NOR"nfo        个人资料\n");
      write("                       "HIC"(Ｋ)"NOR"ill        完全自杀手册\n");
      if (wizardp(this_player()))
      write("                       "HIC"(Ｃ)"NOR"loak       隐身术\n");
      write("                       "HIC"(Ｌ)"NOR"ockScreen  锁定萤幕\n");
      write("                       "HIC"(Ｒ)"NOR"egister    填写《注册申请单》\n");
      write("                       "HIC"(Ｔ)"NOR"ager       切换呼叫器\n");
      write("                       "HIC"(Ｇ)"NOR"return     返回主菜单\n");
      view_main_1();
}
int pager()
{
    object me;
    me = this_player();
    if(me->query("env/block_tell")) {
    write("打开 Tell 频道\n");
    me->delete("env/block_tell");
    }
   else{
   write("关闭 Tell 频道\n");
   me->set("env/block_tell","YES");
   }
  return 1;
}

void auto_load()
{
   if( random(20) >  10)
    message(); 
    else 
    message1();
}
int message1()
{
       object me;
      int i;
      me = this_player();
      i = me->query("MKS")+me->query("PKS");
      write(HIC"\n      "+HIW+me->name()+NOR HIY"大侠"+HIG": 你行走江湖已经 "+BBLU MAG+age_string((int)me->query("mud_age"))+NOR+HIG" 之久!!\n");
      write(HIG"                在你江湖生涯的日日夜夜里, 你已经累积了 "+BYEL HIR+me->query("combat_exp")+NOR" \n");
      write(HIG"                点经验, 共击倒 "+BCYN HIM+chinese_number(i)+HIG" 个对手,前途不可限量!\n");
    
}
string age_string(int time)
{
        int month, day, hour, min, sec;

        sec = time % 60;
        time /= 60;
        min = time % 60;
        time /= 60;
        hour = time % 24;
        time /= 24;
        day = time % 30;
        month = time / 30;
        return (month?month + "月":"") + (day?day + "天":"") +
        (hour?hour + "小时":"") + min + "分";
}
