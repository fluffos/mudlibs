     write("                        "HIR"(m)"NOR"ap    　〖  "BCYN HIW"地形指南"NOR"  〗\n");
     write("                        "HIR"(u)"NOR"ser     〖 "BBLU HIW"个人设定区"NOR" 〗\n");
