#include <ansi.h>

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
  set("channel_id", "机器人法官(chengfa)");
}

int main(object me, string arg) {
  int i;
  object ob, room;
  object *inv, link_ob;

  if (!arg) return 0;
  ob = find_player(arg);
  if (!ob) return notify_fail("没有这个人\n");
  if (wiz_level(me) <= wiz_level(ob))
    return notify_fail("你没有这个权力。\n");
  CHANNEL_D->do_channel(this_object(), "sys",
    me->name() + "把" + ob->name() + "(" + ob->query("id") + ")送进了审问机器人的法院！");
  CHANNEL_D->do_channel(this_object(), "rumor",
    ob->name() + "被送进了昨日西游 " + HIY "审问机器人的法院" NOR);
  if (!room = find_object("/d/wiz/courthouse"))
    room = load_object("/d/wiz/courthouse");
  ob->move(room);
  ob->save();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : robot <ID>

这个指令会将MUD中具有使用机器人嫌疑的玩家关进机器人法院.

HELP
  );
  return 1;
}
