#include <ansi.h>
#include <combat.h>
#include <condition.h>
inherit SSERVER;

int perform(object me, object target)
{       
        string msg="";
        int damage,wound;
        object weapon=me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「相思三剑」？\n");

        if(!me->is_fighting())
                return notify_fail("「相思三剑」只能在战斗中使用！\n");
        
        if(me->query("family/family_name")!="月宫")
                return notify_fail("非月宫不能用「相思三剑」！\n");
        
        if (me->query_skill_mapped("force")!="moonforce")
                return notify_fail("「相思三剑」必须以圆月心法做底子！\n");
                
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力上限不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("moonforce", 1) < 120)
                return notify_fail("你的圆月心法修为还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("snowsword", 1) < 130)
                return notify_fail("你的风回雪舞剑法修为还不够，使用这一招会有困难！\n");
        message_vision(HIC"$N集思凝神，猛地施出风回雪舞剑法的绝招「相思三剑」，向$n连续发动进攻！\n"NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        switch (random(4))
        {
         case 0:
              {
               message_vision(HIY"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
               break;
               }
         case 1:
              {
               message_vision(HIY"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
               break;
              } 
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);  
               break;
              }
         case 3:
              {
               break;
              }
        }
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        switch (random(4))
        {
         case 0:
              {
               message_vision(HIY"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
               break;
              }
         case 1:
              {
               message_vision(HIY"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
               break;
              }
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);
               break;
              }
         case 3:
              {
         break;
              }
        }
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        switch (random(4))
        {
         case 0:
              {
               message_vision(HIY"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
               break;
              }
         case 1:
              {
               message_vision(HIY"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
               break;
              }
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);  
               break;
              }
         case 3:
              {
               break;
               }
        }
        me->start_busy(2+random(3));
        message_vision(HIC"$N的「相思三剑」用功完毕，气回丹田,缓缓收功.\n"NOR,me,target);
        message_vision(msg,me,target);
        me->add("kee", -100);
        me->add("force", -200);
        me->add("sen",-100);
        return 1;
}

