#include <ansi.h>
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
   mapping *action = ({
        ([      "name":                 "",
                "action":
"$N接连几个起落，作势欲走，$n忙疾追不迭。正在这时，$N于空中突然回身，一式「黄鹤一去不复返」$w直指$n的$l",
                "dodge":                0,
		        "parry":		-20,
                "damage":               35,
                "damage_type":  "刺伤"
        ]),
        ([      "name":                 "",
                "action":
"$N手中$w一颤，用一招「晴川沥沥汉阳树」，迅捷无比地在$n上下左右各刺一叉！",
                "dodge":                -10,
		        "parry":	        	0,
                "damage":               40,
                "damage_type":  "刺伤"
        ]),
        ([      "name":                 "",
                "action":
"$N似乎在寻找些什么，手中$w在身前试探了数叉。叉尖所指之处，正是$n的$l，原来是「昔人已乘黄鹤去」！",
                "dodge":                5,
		"parry":		-15,
                "damage":               30,
                "damage_type":  "戳伤"
        ]),
        ([      "name":                 "",
                "action":
"$N怒叱一声，手中$w齐快无比地在$n身前来来回回连划七划。这招「江上往来人」变幻无方，$n实在不知哪招是虚，哪招是实！",
                "dodge":                5,
		        "parry":	-5,
                "damage":               40,
                "damage_type":  "戳伤"
        ]),   
});
        object weapon;
        int i;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「后四路」？\n");
        if(!me->is_fighting())
                return notify_fail("「后四路」只能在战斗中使用！\n");
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

	    i=(int)me->query_skill("fengbo-cha",1)+(int)me->query_kar();
		if( i < 150)
                return notify_fail("你还没有学会后四路呢！\n");

	  weapon=me->query_temp("weapon");
      message_vision(HIC"\n$N突然悟出风波叉的［后四路］，招式一变，手中的"+weapon->query("name")+HIC"惊涛骇浪般奔向"+target->query("name")+HIC"攻出！\n"NOR,me);  
      me->add("force", -100);
      for(i=0;i<4;i++)
	  {
	  me->set("actions",action[i]);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      }
      me->receive_damage("sen", 50+random(50));
	  me->reset_action();
	   me->start_busy(2);
      return 1;
}
