#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  mapping *action = ({
    ([ "name": "",
      "action":
      HIW "$N接连几个起落，作势欲走，$n忙疾追不迭。正在这时，$N于空中突然回身，一式「黄鹤一去不复返」$w直指$n的$l",
      "dodge": 0,
      "parry": -20,
      "damage": 50,
      "damage_type": "戳伤"
    ]),
    ([ "name": "",
      "action":
      HIW "$N手中$w一颤，用一招「晴川沥沥汉阳树」，迅捷无比地在$n上下左右各刺一叉！",

      "dodge": -10,
      "parry": 0,
      "damage": 40,
      "damage_type": "刺伤"
    ]),
    ([ "name": "",
      "action":
      HIW "$N似乎在寻找些什么，手中$w在身前试探了数叉。叉尖所指之处，正是$n的$l，原来是「昔人已乘黄鹤去」！",
      "dodge": 5,
      "parry": -15,
      "damage": 30,
      "damage_type": "戳伤"
    ]),
    ([ "name": "",
      "action":
      HIW "$N身形不动，手中$w用一招「此地空余黄鹤楼」,拍向$n的$l。这招似乎颇为窒滞生硬，但毫不拖泥带水，攻势甚是凌厉",
      "dodge": 5,
      "parry": -5,
      "damage": 40,
      "damage_type": "戳伤"
    ]),
    ([ "name": "",
      "action":
      HIW "$N接连几个起落，作势欲走，$n忙疾追不迭。正在这时，于空中突然回身，一式「黄鹤一去不复返」直指$n的$l",
      "dodge": -10,
      "parry": -10,
      "damage": 20,
      "damage_type": "内伤"
    ]),
    ([ "name": "",
      "action":
      HIW "$N一声清啸，但见漫天叉影，化作朵朵白云，扰得$n眼花缭乱,这招「白云千载空悠悠」颇为传神，果然有一番前不见古人，后不见来者的气概",
      "dodge": -10,
      "parry": -10,
      "damage": 20,
      "damage_type": "内伤",
    ]),
    ([ "name": "",
      "action":
      HIW "$N手中$w一颤，用一招「晴川沥沥汉阳树」，迅捷无比地在$n上下左右各刺一叉",

      "dodge": 0,
      "parry": -10,
      "damage": 40,
      "damage_type": "内伤",
      "parry_msg":
      "$n以手中$W画了个圆弧，将周身破绽都封死了。\n",
    ]),
    ([ "name": "",
      "action":
      HIW "$N施出一招「芳草凄凄鹦鹉洲」，只见$w若有若无地一探，看去势似乎刺向$n左侧数寸处，但不知怎的，转瞬间叉尖已到了$l",
      "dodge": 0,
      "parry": -10,
      "damage": 40,
      "damage_type": "内伤",
    ]),
    ([ "name": "",
      "action":
      HIW "$N朗笑一声，手中$w泛出重重暗影，好似一阵阵浓雾，推向$n,$n看不透这招「日暮乡关何处去」的来路，实在不知如何招架",
      "dodge": 0,
      "parry": -10,
      "damage": 140,
      "damage_type": "刺伤",
    ]),
    ([ "name": "",







      "action":
      HIW "$n刚喘得一喘，却见$N身形一闪，已经踪影全无。$n还未来得及转身，$N的$w已到背后了。这招「烟波江上使人愁」果然令人不胜防",
      "dodge": -10,
      "parry": -10,
      "damage": 30,
      "damage_type": "刺伤",
    ]),
    ([ "name": "",
      "action":
      HIW "$N怒叱一声，手中$w齐快无比地在$n身前来来回回连划七划。这招「江上往来人」变幻无方，$n实在不知哪招是虚，哪招是实",
      "dodge": 0,
      "parry": -15,
      "damage": -15,
      "damage_type": "刺伤",
    ]),
    ([ "name": "",
      "action":
      HIW "$N手中$w缓缓画了个圆圈，用一招「但爱鲈鱼美」慢慢向$n的$l套去",
      "dodge": -10,
      "parry": -5,
      "damage": -30,
      "damage_type": "刺伤",
    ]),
    ([ "name": "",
      "action":
      HIW "$N身形一旋，冲天而起。手中$w借着下冲之势，一招「君看一叶舟」直插$n的$l",
      "dodge": 10,
      "parry": -10,
      "damage": -30,
      "damage_type": "内伤",
      "parry_msg":
      "$n看准来势，以$W向$N的兵刃猛点。只听「当」的一声巨响，果然将$N的兵刃荡了开去。\n",
    ]),
    ([ "name": "",
      "action":
      HIW "$N突然脸上青气一显，叉上嗡嗡之声大做，正当$n惊诧时，狂风骤雨般连攻五叉。这招「出没风波里」是整套叉法的精髓,施将出来，不但变幻莫测，且声势惊人，$n顿时不知所措",
      "dodge": -5,
      "parry": -5,
      "damage": -100,
      "damage_type": "内伤",
    ]),
  });
  object weapon;
  int i;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「大海无量」？\n");
  if (!me->is_fighting())
    return notify_fail("「大海无量」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  i = (int)me->query_skill("fengbo-cha", 1) + (int)me->query_kar();
  if (i < 180)
    return notify_fail("你还施展不出【大海无量】！\n");

  weapon = me->query_temp("weapon");

  message_vision(
    HIC "\n$N运起龙神心法，内力尽化于" HIW + weapon->query("name") + "之中,顿时一股激荡澎湃的内力海啸般向" + target->query("name") + "袭去!\n" NOR,
    me
  );
  me->add("force", -100);



  for (i = 0; i < 12; i++) {
    me->set("actions", action[i]);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }


  me->receive_damage("sen", 200 + random(50));
  me->reset_action();
  me->start_busy(5);
  return 1;
}
