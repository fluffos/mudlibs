// Creat by Repoo 2/9/2001

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create() {
  set_name(CYN "天龙刀" NOR, ({ "tianlong dao", "tianlongdao", "tianlong", "dao", "blade", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("is_monitored", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "bone");
    set("name_recognized", "枯骨刀");
    set("long", "这是一柄想扇子一样的单刀，份量很轻。\n");
    set("wield_msg", "一道刺眼的光芒从$N手中放出，唰，一把形如扇子的刀展示在众人眼前。\n");
    set("unequip_msg", "$N反手将$n折叠起来，轻嘘一口气。\n");
  }
  init_blade(200);
  set("is_monitored", 1);
  setup();
}
