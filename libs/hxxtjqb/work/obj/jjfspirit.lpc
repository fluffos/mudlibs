//Creat by Repoo 29/8/2001
#include <ansi.h>

inherit ITEM;
string chinese_daoxing(int);

void create() {
  set_name(HIM "将军府精神" NOR, ({ "jjf spirit", "spirit" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "此乃将军府的士气所幻化成。\n");
    set("value", 800000);
    set("no_sell", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init() {
  add_action("do_xishi", "xishi");
  add_action("do_xuanze", "xuanze");
}
string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) str = str + chinese_number(year) + "年";
  if (day) str = str + chinese_number(day) + "天";
  if (hour) str = str + chinese_number(hour) + "时辰";
  return str;
}
int do_xishi(string arg) {
  object me = this_player();
  if (!arg) return notify_fail("你想吸食什么？\n");
  if (me->query("daoxing") > 100000000 || me->query("combat_exp") > 150000000) {
    message_vision(HIG "你的武学已经很高了！ \n" NOR, me);
    return 1;
  }

  if ((arg == "jjf spirit" || arg == "spirit")) {
    tell_object(me, "你想把将军府精神转化成什么力量(xuanze dx,wx,qn)?\n");
  }
  return 1;
}
int do_xuanze(string arg) {
  object me = this_player();
  object ob = this_object();
  int exp, exp_reward, pot_reward;
  exp = (me->query("combat_exp") + me->query("daoxing")) / 3;
  if (exp < 30000) {
    exp_reward = 500 + exp / 60;
    pot_reward = 200 + exp / 300;
  } else if (exp < 1000000) {
    exp_reward = 1000 + exp / 600;
    pot_reward = 400 + exp / 6000;
  } else if (exp < 5000000) {
    exp_reward = 2500 + exp / 6000;
    pot_reward = 1000 + exp / 20000;
  } else {
    exp_reward = 5000;
    pot_reward = 1500;
  }
  pot_reward = pot_reward * (12) / 4;
  exp_reward = exp_reward * (12) / 10;
  if (ob->query("owner") != me->query("id")) return notify_fail("拿别人东西,这习惯不好!\n");
  if (me->query("daoxing") > 50000000 || me->query("combat_exp") > 50000000) {
    message_vision(HIG "你的武学已经很高了！ \n" NOR, me);
    return 1;
  }

  if (!arg) return notify_fail("你选择什么？\n");
  message_vision("$N选择为：" + arg + "\n", this_player());
  if (arg == "dx") {
    me->add("daoxing", exp_reward);
    tell_object(me, "你得到了 " + HIR "" + chinese_daoxing(exp_reward)
      + "" NOR + " 点道行！\n");
    destruct(this_object());
    return 1;
  } else {
    if (arg == "wx") {
      me->add("combat_exp", exp_reward);
      tell_object(me, "你得到了 " + HIY "" + chinese_number(exp_reward)
        + "" NOR + " 点武学经验！\n");
      destruct(this_object());
      return 1;
    } else {
      if (arg == "qn") {
        me->add("potential", pot_reward);
        tell_object(me, "你得到了 " + HIW "" + chinese_number(pot_reward)
          + "" NOR + " 点潜能！\n");
        destruct(this_object());
        return 1;
      } else { return notify_fail("你要选择什么(wx dx qn)？\n"); };
    }
  }
}
