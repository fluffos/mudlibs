// Creat by Repoo 2/9/2001

#include <weapon.h>
#include <ansi.h>
void init();
inherit BLADE;
inherit F_UNIQUE;

void create() {
  set_name(CYN "天龙斩" NOR, ({ "tianlong zhan", "zhan", "dao", "blade", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 1000000);
    set("is_monitored", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "bone");
    set("name_recognized", "天龙斩");
    set("long", "一把细窄的弯刀，刀身上刻满龙文，而且刀刃在内侧。\n");
    set("wield_msg", "$N唰的一声拔出一把很窄的薄如蝉翼的的反刃刀，刀身还在不停的晃动。\n");
    set("unequip_msg", "$N反手将$n折叠起来，轻嘘一口气。\n");
  }
  init_blade(250);
  set("is_monitored", 1);
  setup();
}
int init() {
  add_action("do_read", "read");
}
int do_read(string arg) {
  object me = this_player(), blade = this_object();
  int sen_cost, gain, bladelev, exp;

  if (!blade->id(arg)) return notify_fail("你要读什么？\n");
  if (environment(blade) != me) return notify_fail("刀要拿起来才能研究。\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if (me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
  if ((int)me->query_skill("blade", 1) < 100)
    return notify_fail("你拿起刀看了半天，但怎么也看不懂。\n");
  if ((int)me->query_skill("blade", 1) > 250)
    return notify_fail("你在这方面已经很有造诣，这把刀不会让你长进多少。\n");
  exp = (int)me->query("combat_exp");
  bladelev = (int)me->query_skill("blade", 1);
  if (exp * 10 < bladelev * bladelev * bladelev)
    return notify_fail("你的武学修为不够，再怎么研究也没用。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 5;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("force", gain);

  message_vision("$N正专心地研究" + blade->query("name") + "。\n", me);
  tell_object(me, "你钻研有关基本刀法的技巧，似乎有点心得。\n");

  return 1;
}
