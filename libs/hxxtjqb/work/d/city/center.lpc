//changan city

inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "十字街头");
  set("long", @LONG

这里便是长安城的中心，四条大街交汇于此。一座巍峨高大的钟楼耸
立于前，很是有些气势。每到清晨，响亮的钟声便会伴着淡淡雾气传
向长安城的大街小巷。路口车水马龙，来往人潮不断。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": "/d/city/zhuque-s1",
      "north": "/d/city/xuanwu-n0",
      "west": "/d/city/baihu-w1",
      "east": "/d/city/qinglong-e1",
      "down": "/d/city/droproom",
    ]));
  set("objects",
    ([  //sizeof() == 1
    "/d/city/npc/libai": 1,
      "/d/qujing/wuzhuang/npc/zhangguolao": 1,
    ]));

  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
