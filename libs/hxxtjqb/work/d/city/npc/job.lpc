inherit NPC;
#include <ansi.h>

    int give_dan();
int answer_me();

}
void create()
{
         set_name(HIY"礼物仙使"NOR, ({"guan jia","guanjia"}));
   set ("long", @LONG
    她是在这里负责给大家发礼物(gift)哦，
    她身上还有天师法冠(bonnet)呢!
    不信你就去问问(ask)她。记得，天师法冠用完了要还哦！
LONG);
           set("gender", "女性");
              set("title",HIG"仙子"NOR);
                 set("age", 20);
        set("per", 40);
       set("attitude", "peaceful");
       set("shen_type", 1);


       set("inquiry", ([
          
          "gift":(:give_dan:),
            "礼物":(:give_dan:),
           
        ]));
        setup();
}


int answer_me()
{
command("say 我是礼物仙使，欢迎大家来本站，我负责在这里
发放天师法冠和送礼物给大家的。\n");
return 1;
}

         object m;
        ob = this_player();
        if ((string)this_player()->query("family/family_name")=="方寸山三星洞") {
         if (this_player()->query("yudian/gift")=="got")
{
          message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
       command("say 礼物只有一份！领过就不给了！");
  return 1;


who->set_skill("force",200);
}

message_vision("$N念动咒语：哈库那玛他他!\n$N手一指，$n只觉得周身气血翻腾，似乎武学、道行都有所进境。\n",this_object(),this_player());
     who->set("yudian/gift","got");
return 1;
}
 
void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
say(name()+"神秘地说：“想要礼物吗？找我啊！不过，你只有一次机会哦！哈哈！”\n"NOR);

