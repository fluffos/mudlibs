// Room: /d/wiz/wizroom.c

#include <ansi.h>
inherit ROOM;

int block_cmd();

void create() {
  set("short", HIY "昨日西游新闻发布中心" NOR);
  set("long", @LONG

这里是昨日西游(YC站)的新闻发布中心，是更新新闻发布的地方，这里只有
巫师才能进来。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "down": __DIR__ "wizroom",

    set("objects", ([
      __DIR__ "npc/guest": 1,

    ]));
    setup();
  } void init() {
    if (!wizardp(this_player()))
      add_action("block_cmd", "", 1);
  }

  int block_cmd() {
    string verb = query_verb();

    if (verb == "say") return 0;  //allow say
    if (verb == "chat") return 0;
    if (verb == "quit") return 0;
    if (verb == "look") return 0;
    return 1;
  }
