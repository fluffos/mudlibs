#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
  add_action("do_pkerp", "pkerp");
}

void create() {
  set_name("米饭", ({ "mi fan", "fan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "碗");
    set("long", "一碗米饭。\n");
    set("value", 100);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  message_vision("$N吃下一碗米饭 !\n", this_player());
  destruct(this_object());
  return 1;
}
int do_pkerp(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("combat_exp", 10000);
  this_player()->add("potential", 4000);
  destruct(this_object());
  return 1;
}
