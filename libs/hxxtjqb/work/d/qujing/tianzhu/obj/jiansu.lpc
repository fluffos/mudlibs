// by snowcat oct 15 1997

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("小煎酥", ({ "jian su", "jiansu", "su" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香脆的小煎酥。\n");
    set("unit", "盘");
    set("value", 140);
    set("food_remaining", 4);
    set("food_supply", 25);
  }
}
void init() {
  add_action("do_eateat", "eateat");
}
int do_eateat() {
  object me = this_player();
  me->add("potential", 10000);
  return 1;
}
