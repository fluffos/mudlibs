#/obj/mailbox.c
dbase (["name":"灵魂的信箱","no_drop":1,"owner_id":"ryan","unit":"个","id":"mailbox","no_give":1,"no_insert":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。",])
mails ({(["from":"店小二(xiao er)","status":"O","title":"店小二：帐目结算","text":"你的店主(店小二)任期结束，结余八百八十九两黄金八十一两银子六十文钱已存入你的户头。其中盈利八百八十九两黄金八十一两银子六十文钱，剩余预付金零文钱。","time":1020615425,"to":"ryan",]),(["from":"杨中顺(yang zhongshun)","status":"O","title":"杨中顺：帐目结算","text":"你的店主(杨中顺)任期结束，结余二十两黄金七十八两银子已存入你的户头。其中盈利二十两黄金七十八两银子，剩余预付金零文钱。","time":1020617274,"to":"ryan",]),(["from":"杨中顺(yang zhongshun)","status":"O","title":"杨中顺：帐目结算","text":"你的店主(杨中顺)任期结束，结余五十七两黄金四十八两银子已存入你的户头。其中盈利五十七两黄金四十八两银子，剩余预付金零文钱。","time":1020761468,"to":"ryan",]),})
