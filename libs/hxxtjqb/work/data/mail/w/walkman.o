#/obj/mailbox.c
dbase (["owner_id":"walkman","name":"行者的信箱","no_drop":1,"no_insert":1,"unit":"个","id":"mailbox","no_give":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。",])
mails ({(["from":"痴人梦话(win)","title":"pozhan","status":"O","time":1020693459,"text":"qQ","to":"walkman",]),(["from":"痴人梦话(win)","title":"q","time":1020693509,"status":"O","text":"","to":"walkman",]),(["from":"痴人梦话(win)","title":"pozhan","time":1020693528,"status":"O","text":"//Cracked by Roath// pozhan.c             破绽百出inherit SSERVERint perform(object me, object target){        string msg        int delay, myblade        if( !target ) target = offensive_target(me)        if( !target        ||      !target->is_character()        ||      !me->is_fighting(target) )                return notify_fail(不在战斗中，露什么破绽？\\n)        if(me->query(family/family_name)!=陷空山无底洞) return notify_fail(“破绽”只有无底洞门人才可以用！\\n)        if(myblade>160) myblade=160// mon 12/7/98        if(myblade<50)                 return notify_fail(你的修为不够深，露破绽给人太危险了。\\n)        if( target->is_busy() )                return notify_fail(target->name() + 目前正自顾不暇，放胆攻击吧！        //change totoal random to half random half ur own value to make the suce        if( ((random(me->query(combat_exp))*3/4 + (me->query(combat_exp)/4) > (i                msg += $n想攻，却不知道哪个破绽是真，哪个是假。\\n                msg += 结果$p被$P攻了个措手不及！\\n NOR                target->start_busy(delay)                me->start_busy(random(2))        } else {                msg += 可是$p看破了$P的企图，并没有上当。\\n NOR                me->start_busy(2+random(3))        }        message_vision(msg, me, target)        if( !target->is_fighting(me) ) {                if( living(target) ) {                        if( userp(target) ) target->fight_ob(me)                        else target->kill_ob(me)                }                me->kill_ob(target)        }        return 1}","to":"walkman",]),})
