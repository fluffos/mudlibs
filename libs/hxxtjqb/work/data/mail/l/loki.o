dbase (["no_drop":1,"unit":"个","owner_id":"loki","no_give":1,"id":"mailbox","no_insert":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","name":"信箱",])
mails ({(["from":"萧萧(xiao xiao)","to":"loki","title":"萧萧：帐目结算","text":"你的店主(萧萧)任期结束，结余十五两黄金二十九两银子九十文钱已存入你的户头。其中盈利十五两黄金二十九两银子九十文钱，剩余预付金零文钱。","time":1019268460,"status":"N",]),})
