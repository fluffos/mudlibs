#/obj/mailbox.c
dbase (["owner_id":"lpc","name":"信箱","no_drop":1,"no_insert":1,"unit":"个","id":"mailbox","no_give":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。",])
mails ({(["from":"侯郎中(hou langzhong)","title":"侯郎中：帐目结算","status":"N","time":1020622195,"text":"你的店主(侯郎中)任期结束，结余二十四两银子已存入你的户头。其中盈利二十四两银子，剩余预付金零文钱。","to":"lpc",]),})
