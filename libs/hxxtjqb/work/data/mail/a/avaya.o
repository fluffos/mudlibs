#/obj/mailbox.c
dbase (["owner_id":"avaya","name":"无花的信箱","no_drop":1,"id":"mailbox","unit":"个","no_insert":1,"no_give":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。",])
mails ({(["from":"孔方兄(kong fang)","title":"孔方兄：帐目结算","time":1020619741,"status":"O","text":"你的店主(孔方兄)任期结束，结余一百五十两黄金五两银子已存入你的户头。其中盈利一百五十两黄金五两银子，剩余预付金零文钱。","to":"avaya",]),})
