#/obj/mailbox.c
dbase (["no_drop":1,"unit":"个","owner_id":"kylin","no_insert":1,"no_give":1,"id":"mailbox","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","name":"风萧萧的信箱",])
mails ({(["from":"风萧萧(kylin)","to":"to good","title":"hi","text":"明天，后天我这里沙尘暴，又不上班，我可能不上线了，有事mail to me。","time":1019232513,"status":"N",]),})
