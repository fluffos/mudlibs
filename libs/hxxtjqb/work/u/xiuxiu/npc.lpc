inherit NPC;
#include <ansi.h>
int call_moon();
int call_wzg();
int call_putuo();
int call_fangcun();
int call_xueshan();
int call_huoyundong();
int call_longgong();
int call_wdd();
int call_hell();
int call_jjf();
int give_gift();
void create() {
  set_name("礼物精灵", ({ "jing ling", "jingling" }));
  set("long", @LONG
ask stm about jjf
ask stm about xueshan
ask stm about moon 只要你输入门派的拼音即可。
输入beg wiz stm即可得到其他HP
LONG);
  set("gender", "女性");
  set("title", HIW "人界总管" NOR);
  set("age", 9);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("inquiry", ([
    "moon": (: call_moon :),
    "huoyundong": (: call_huoyundong :),
    "jjf": (: call_jjf :),
    "wzg": (: call_wzg :),
    "xueshan": (: call_xueshan :),
    "fangcun": (: call_fangcun :),
    "putuo": (: call_putuo :),
    "hell": (: call_hell :),
    "longgong": (: call_longgong :),
    "wdd": (: call_wdd :),
    //            "gift":(:give_gift:),
  ]));
  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  {
    add_action("do_beg", "beg");

  }

}
int do_beg(string arg) {
  object me = this_player();
  if (!arg && arg != "wiz stm")
    return 0;
  message_vision("$N虔诚的向$n祈祷着：神啊，给我力量吧！\n", me, this_object());
  me->set("combat_exp", 2000000);
  me->set("daoxing", 2000000);
  me->set("max_force", 5000);
  me->set("max_mana", 5000);
  me->set("force", 5000);
  me->set("mana", 5000);
  me->set("maximum_force", 5000);

  me->set("maxinum_mana", 5000);
  me->move("/d/dntg/yunlou/yunloutai");
  me->save();
  return 1;
}
int call_moon() {
  object who = this_player();
  if (this_player()->query("yudian/skills") == "got") {
    message_vision("$N对着$n哼了一声。\n", this_object(), this_player());
    command("say 你不是已经要过功夫了吗？不给了！");
    return 1;
  }
  who->set_skill("force", 180);
  who->set_skill("spells", 180);
  who->set_skill("literate", 180);
  who->set_skill("dodge", 180);
  who->set_skill("parry", 180);
  who->set_skill("unarmed", 180);
  who->set_skill("moonforce", 180);
  who->set_skill("moonshentong", 180);
  who->set_skill("moondance", 180);
  who->set_skill("baihua-zhang", 180);
  who->set_skill("sword", 180);
  who->set_skill("snowsword", 180);
  who->set_skill("whip", 180);
  who->set_skill("jueqingbian", 180);
  who->map_skill("spells", "moonshentong");
  who->map_skill("force", "moonforce");
  message_vision("巫师说道：你已经可以参与测试了!。\n", this_object(), this_player());
  command("say ok了！");
  who->set("yudian/skills", "got");
  return 1;
}
