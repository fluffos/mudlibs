// linen.c
#include <armor.h>

#include <ansi.h>
inherit CLOTH;

void create()
{
set_name(HIW"白大褂", ({ "cloth","baida gua" }) );
set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "cloth");
		set("unit", "件");
  set("value", 500);
set("armor_prop/armor", 1);

	}
	setup();
}
