#include <ansi.h>
#define TASK_TIME 1800            //任务重新分配间隔时间，30min
#define MAX_TASK  35
#define F_TASKOBJ "/task/task_obj.h"
#define F_TASKNPC "/task/task_npc.h"
#define F_TASKLOC "/task/task_loc.h"

int tasked=0;
string *task_obj;
string *task_npc;
string *task_loc;
mapping *tasks=({});
void init_task();
void spread_task(object item,object owner,int arg);
void del_item(string str);

void create()
{
        string file;
        file=read_file(F_TASKOBJ);


        if(sizeof(file))
                task_obj=explode(file,"\n");
                else return;
        file=read_file(F_TASKNPC);
        if(sizeof(file))
                task_npc=explode(file,"\n");
                else return;
        file=read_file(F_TASKLOC);
        if(sizeof(file))
                task_loc=explode(file,"\n");
                else return;
        init_task();

}
void init_task()
{
        int i;
        object *user,item,owner;
        string cur_npc;
         user = users();
        
        message("system", HIR "\n 重新分布宝物．．．", users());
        for (i=0;i<sizeof(task_obj);i++)

        {
                del_item(task_obj[i]);
                item=new(task_obj[i]);
                if(!item)
                        continue;
                cur_npc=task_npc[i];
//              cur_npc=task_npc[random(sizeof(task_npc))];
                owner=find_object(cur_npc);
                if(!owner)
                        owner=load_object(cur_npc);
                if(!owner)
                        continue;
                spread_task(item,owner,i);
        }
        message("system", HIG "．．．宝物分布完毕 \n" NOR, users()); 
        tasked=1;
        call_out("init_task",TASK_TIME);

}

void spread_task(object item,object owner,int arg)
{
        int i,is_over;

        string location;
        object obj0,obj1;
        object *inv;
        object *target=({});
        location=task_loc[random(sizeof(task_loc))];
        obj0=find_object(location);
        if(obj0)
        obj0->reset();
        else
        obj0=load_object(location);
        if(obj0)
        {
                inv = all_inventory(obj0);
                for(i=0; i<sizeof(inv); i++)
                 {
                        if(inv[i]->is_character() && !userp(inv[i]))
                        target += ({ inv[i] });
                        if(inv[i]->is_container()) target += ({ inv[i] });
                  }
                if(sizeof(target)) 
                {
                obj0 = target[random(sizeof(target))];
                location=obj0->query("name")+"("+obj0->query("id")+")";

                }
                item->set("no_give","好不容易到手的东西，就这么随便给别人吗？\n");
                item->set("value",0);
                item->set("is_monitored",1);
                item->set_temp("task/item",1);
                item->set_temp("task/owner",owner->query("id"));
                item->set_temp("task/index",arg);
                item->move(obj0);
                is_over=0;
        }
        else{
                location="（未分布）";
                is_over=1;
                }       
                if(tasked)
                {
                tasks[arg]["taskobj_id"]=item->query("id");
                tasks[arg]["taskobj_name"]=item->query("name");
                tasks[arg]["tasknpc_id"]=owner->query("id");
                tasks[arg]["tasknpc_name"]=owner->query("name");
                tasks[arg]["taskloc_name"]=location;
                tasks[arg]["task_over"]=is_over;
                }

                else
                        tasks+=({([     "taskobj_id"   : item->query("id"),
                                        "taskobj_name" : item->query("name"),
                                        "tasknpc_id"   : owner->query("id"),
                                        "tasknpc_name" : owner->query("name"),
                                        "taskloc_name" : location,
                                        "task_over"    : is_over,
                                ])});

}       

string list_task()
{
        int i;
        string output="";
        for (i=0;i<sizeof(tasks);i++)
        {
                if(wizardp(this_player()))
                {
                        if(tasks[i]["task_over"]==0)
                        output+=sprintf("%s在%s处\n",
                                        tasks[i]["tasknpc_name"]+
//                                      "("+tasks[i]["tasknpc_id"]+")"+

                                        "的"+tasks[i]["taskobj_name"]+
                                        "("+tasks[i]["taskobj_id"]+")",
                                        tasks[i]["taskloc_name"]);
                        else
                        output+=sprintf("%s的%s(%s) %s   （已完成）\n",
                                        tasks[i]["tasknpc_name"],
//                                      tasks[i]["tasknpc_id"],
                                        tasks[i]["taskobj_name"],
                                        tasks[i]["taskobj_id"],
                                        tasks[i]["taskloc_name"]);
                }
                else
                {
                        if(tasks[i]["task_over"]==0){
                        if(random(2))
                        output+=sprintf("%s的%s(%s)\n",
                                        tasks[i]["tasknpc_name"],
//                                      tasks[i]["tasknpc_id"],
                                        tasks[i]["taskobj_name"],
                                        tasks[i]["taskobj_id"]);
                        else output=sprintf("%s的%s(%s)\n",
                                        tasks[i]["tasknpc_name"],
//                                      tasks[i]["tasknpc_id"],


                                        tasks[i]["taskobj_name"],
                                        tasks[i]["taskobj_id"])+output;
                        }
                        else
                        
                        if(random(2))
                        output+=sprintf("%s的%s(%s)   （已完成）\n",
                                        tasks[i]["tasknpc_name"],
//                                      tasks[i]["tasknpc_id"],
                                        tasks[i]["taskobj_name"],
                                        tasks[i]["taskobj_id"]);
                        else
                        output=sprintf("%s的%s(%s)   （已完成）\n",
                                        tasks[i]["tasknpc_name"],
//                                      tasks[i]["tasknpc_id"],
                                        tasks[i]["taskobj_name"],
                                        tasks[i]["taskobj_id"])+output;
                                
                }
                
        }
//      output+="\n 目前共有"+chinese_number(sizeof(tasks))+"个任务。\n";
        return output;
}

void reward_task(object me,object who,object obj)
{
        int wuxue,exp,pot;

        wuxue=250+random(200);
        pot=200+random(150);
        exp=1000+random(500);


        me->add("combat_exp",wuxue);
        me->add("potential",pot);
        me->add("daoxing",exp);

        who->command("ah");
        who->command("say “这位"+RANK_D->query_respect(me)+"，你是在哪里找到这东西的？我正到处找它呢！”");
        who->command("thank "+me->query("id"));
        tell_object(me,HIW+"你又完成了一项任务！\n"+
                        "获得潜能"+chinese_number(pot)+"点。\n"+
                        "武学增加"+chinese_number(wuxue)+"点。\n"+
                        "道行增加"+chinese_number(exp/4)+"天。\n"+NOR);
== 未完继续 85% == (ENTER 继续下一页，q 离开，b 前一页)
        me->add("task/num",1);
        tasks[obj->query_temp("task/index")]["task_over"]=1;
}

void del_item(string str)
{
        object *ob_list;
        int i;
        if(!str) return;
        ob_list = children(str);
        for(i=0; i<sizeof(ob_list); i++)
                destruct(ob_list[i]);
}

object find_taskobj(string str)
{
        int i;
        object env;
        object *ob_list;
        for(i=0;i<sizeof(tasks);i++)
        {
                if(tasks[i]["taskobj_id"]==str)
                {
                ob_list=children(task_obj[i]);
                if(sizeof(ob_list))
                {
                        env=ob_list[random(sizeof(ob_list))];
                     return env;
       }
       }
   }
                
                
        
        return env;
}
