#include <ansi.h>

int main(object me, string str)
{
        string output;
        me->add("sen",-5);
        output = HIR"◎  西游记寻物\n" NOR;
        output += "———————————————————————————\n";
        output +="/adm/daemons/taskd"->list_task();
        output += "———————————————————————————\n";
        write(output);
   if(!me->query("task/num"))
           write("到目前为止你还没有完成任何任务。\n\n");
       else
       write("到目前为止你一共完成了"+chinese_number(me->query("task/num"))+"个任务。\n\n");
        return 1;
}


int help(object me)
{
        write(@HELP
指令格式: tasks

这个指令是用来得知目前的所有使命.
    如果你想找某样物品，可以通过天眼通(find id)来查找物品的
大概所在之处。有时候可能会查不到，但多查几次就会出结果。一般
来说物品都随机分布在各个地方，有可能在某个场景里，有可能在某
个NPC身上，或者在其他什么地方。当你拿到task中的一样东西之后，
就可以送还给物品的主人，你就可以得到一定奖励。寻物系统每隔一
段时间会自动刷新，重新分配到各个地方，即使你带着某样物品也会
消失掉。

HELP
        );
        return 1;
}
