// Room: /d/changan/fendui.c
inherit ROOM;
void create() {
  set("short", "新手圣堂");
  set("long", @LONG
这里是长安城中为新手成长而修建的,你可以用来恢复身体上的各项属性
  就试试这个指令吧(kao)
LONG);
  set("mai_corpse_able", 1);
  set("outdoors", __DIR__ "");
  set("exits", ([ /* sizeof() == 1 */
    "down": "/d/city/center",
  ]));
  setup();
}
void init() {
  add_action("do_kao", "kao");
}
int do_kao(string arg) {
  object me = this_player();
  int force, mana;
  int jin, qi, neili, fali, shiwu, yinshui;
  // if(me->query("age")=>15) {
  // return notify_fail("这么大的人啦,还是新手吗?\n");}
  force = (int)me->query("max_force");
  mana = (int)me->query("max_mana");
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("eff_gin", me->query("max_gin"));
  me->set("gin", me->query("max_gin"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("max_sen"));
  me->set("force", force * 2);
  me->set("mana", mana * 2);
  me->set("food", me->max_water_capacity());
  me->set("water", me->max_food_capacity());
  me->add("potential", random(50));
  me->improve_skill("sword", 200);
  me->improve_skill("force", 200);
  me->improve_skill("spells", 200);
  me->improve_skill("whip", 200);
  me->improve_skill("unarmed", 200);
  me->improve_skill("parry", 200);
  //  me->improve_skill("dodge", 200);
  //  me->improve_skill("force", 200);
  //  me->improve_skill("spells", 200);
  //  me->improve_skill("whip", 200);
  //  me->improve_skill("unarmed", 200);
  //  me->improve_skill("parry", 200);
  // me->add("combat_exp",150);
  me->add("daoxing", 150);
  return 1;
}
