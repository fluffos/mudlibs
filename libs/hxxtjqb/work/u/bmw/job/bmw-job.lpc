//  inherit NPC;
#include <ansi.h>
#define FILE "/u/bmw/npc/pker.lpc"

int query_children(string arg);
int deal_pker(string arg);

void create() {
  set_name("黑暗宝马", ({ "drak bmw" }));
  set("gender", "男性");
  set("age", 21);
  set("long", "遁入黑暗!\n");
  set("combat_exp", 20);
  set("attitude", "friendly");
  set("per", 40);
  set("max_kee", 1500000);
  set("kee", 1500000);
  set("sen", 1500000);
  set("max_sen", 1500000);
  setup();
  remove_call_out("give_haojie");
  call_out("give_haojie", 60);
}

void give_haojie() {
  int i;
  object ob;
  string type;
  string *level = ({
    HIW "白衣杀手",
    BLK "黑衣杀手",
    WHT "灰衣杀手",
    YEL "黄衣杀手",
    HIR "红衣杀手",
    HIB "蓝衣杀手",
    HIM "紫衣杀手",
    HIY "金衣杀手",
    HIY "黑暗" HIR "之神",
  });
  this_object()->set("start_time", time());
  message("channel:chat", HIY + "【黑暗宝马】:" + HIG + "杀手们听令！血洗那个所谓宝马真身所创造的幻想世界！\n" NOR, users());
  message(
    "channel:chat",
    HIY + "【宝马真身】:" + HIG + "作孽呀，作孽呀，本人的黑暗分身竟然想毁掉我亲手创造的世界，各位大虾们帮帮我，拯救这个世界!\n" NOR,
    users()
  );
  for (i = 0; i < 15; i++) {
    ob = new("/u/bmw/npc/pker");
    // type="xian";
    // if ( random(2) ) type="mo";
    // ob->init_skill(500000+(i+1)*500000,100+(i+1)*30,
    // 2000+200*(i+1),2000+500*(i+1),
    // 2000+200*(i+1),2000+500*(i+1),type);

    ob->random_place();
  }
  remove_call_out("check_haojie");
  call_out("check_haojie", 10);
  remove_call_out("give_haojie");
  call_out("give_haojie", 1500 + random(500));

}

void check_haojie() {
  object ob;
  int num;
  ob = this_object();
  num = sizeof(filter_array(children(FILE), (: clonep :)));
  if ((time() - ob->query("start_time") < 360) && num) {
    message(
      "channel:chat",
      HIY + "【宝马真身】:" + HIG + "现在还有" + chinese_number(num) + "名杀手正在血洗我的世界，众大虾努力呀!\n" NOR,
      users()
    );
    remove_call_out("check_haojie");
    call_out("check_haojie", 30);
    return;
  }

  if ((time() - ob->query("start_time") < 480) && num <= 0) {
    message("channel:chat", HIY + "【宝马真身】:" + HIG + "感谢各位大虾消灭杀手!\n" NOR, users());
    message(
      "channel:chat",
      HIY + "【黑暗宝马】:" + HIG + "不！不！我的杀手竟然全部牺牲了！好，好，你们等着，我会回来的!\n" NOR,
      users()
    );
    return;
  }

  if ((time() - ob->query("start_time") > 480) && num > 0) {
    message("channel:chat", HIY + "【黑暗宝马】:" + HIG + "没有想到血洗幻想世界如此容易，今天得手了!\n" NOR, users());
    remove_call_out("reward");
    call_out("reward", 1);
    return;
  }

}

void reward() {
  object *user;
  int i, number;
  user = users();
  for (i = 0; i < sizeof(user); i++)
    if (user[i]->query("combat_exp") > 1000000) {
      user[i]->add("weiwang", -3);
      user[i]->query("balance") ? user[i]->add("balance", -100000) : user[i]->add("balance", 0);
    }
  remove_call_out("deal_pker");
  call_out("deal_pker", 1);
}

int query_children(string arg) {
  object *ch;
  int i, sum = 0;

  ch = children(arg);
  for (i = 0; i < sizeof(ch); i++)
    if (environment(ch[i])) sum++;
  return sum;
}

int deal_pker(string arg) {
  object *ch;
  int i;

  ch = children(FILE);
  for (i = 0; i < sizeof(ch); i++)
    destruct(ch[i]);
  return 1;
}
