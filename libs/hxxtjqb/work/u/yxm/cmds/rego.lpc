#include <ansi.h>
#include <skill.h>

inherit F_CLEAN_UP;

int main(object me)
{
            object target;

   if( me->is_ghost() )
     return notify_fail(HIB"做了鬼了，就老实点吧！\n"NOR);

   if (me->is_busy() || me->query_temp("doing_xiudao"))
		return notify_fail("你现在正忙着呢。\n");

   if( me->query("mana") < 200 )
		return notify_fail(HIY"你的法力不够，无法获得穿梭时空的力量！\n"NOR);

   if(me->is_fighting())
   {return notify_fail(HIC"战斗中不能下"+HIR"recall"+HIC"指令 \n"NOR);  }
   else{
	write(HIY"你向万能的大神祈祷："HIR"大神呀，给我穿梭时空的力量吧～～～～\n\n"NOR);

	if( environment(me)->query("no_recall") )
		{return notify_fail(HIC"可惜在这里大神听不到你的声音！！！\n"NOR);  }
        else {
	this_player()->add("mana",-100);

	this_player()->move(this_player()->query("startroom"));
	write(HIR"\n咻的一声～～～～"HIY"你获得了穿梭时空的力量，回到了起点。\n"NOR);
	return 1;}
       }
}

int help(object me)
{
write(@HELP

这个指令可以让你迅速会到上次存盘开始的地点。
但在战斗中以及禁止recall的地点这个指令无效。
每次耗费100点法力值，法力低于200将不能recall

HELP
	);
	return 1;
}
