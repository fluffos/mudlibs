#include <ansi.h>

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("剑", ({ "sword" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_drop", 1);
    set("no_put", 1);
    //                set("no_give",1);
    set("unit", "把");
    set("value", 1000);
    set("material", "iron");
    set("long", "一把剑。\n");
    set("wield_msg", "$N抄起一把$n。\n");
  }
  init_sword(120);
  setup();

}
