#include <ansi.h>
inherit NPC;

int give_gift(object who);

void create()
{
        set_name(HIC"痴人梦话"NOR, ({ "npc win","win"}) );
        set("long", "没见过吧，那当然喽! 只有你提供了BUG才可以见到我的哟~~。\n");
	set("attitude", "friendly");
	set("age", 30);
	set("max_gin", 2000);
	set("max_kee", 5000);
	set("max_sen", 3000);
	set("max_mana", 3000);
	set("max_force", 5000);
	
	set("str", 30);
	set("per", 20+random(15));

	set("combat_exp", 100000);
	set("daoxing", 3000000);
	set_skill("parry", 300);
	set_skill("dodge", 300);
	set_skill("unarmed", 300);
	set_skill("changquan", 300);
	set_skill("force", 300);
	set_skill("spells", 300);
	set_skill("dao", 300);
	map_skill("unarmed", "changquan");
	map_skill("spells", "dao");

	setup();

	carry_object("/d/obj/cloth/linen")->wear();
}

void init()
{       
	object ob;
        if(!clonep()) return;

	::init();

        set("chat_chance", 5);
        set("inquiry", ([
                "name" : "我是专门为提供bug发奖励的。\n",
                "here" : "这地方我可是头回来哦。\n", 
            "劳动节" :  (: give_gift :),
            "礼物" : (: give_gift :),
            "gift" : (: give_gift :),
         ]) );

        set("chat_msg", ({
                "只见你荣光焕发的走上了领奖台...\n",
                "一位仙女正朝向你走来...\n",
                "台下了掌声连绵不绝...\n",
                "痴人梦话拍了拍你的肩：真有你的!!加油!!加油!!\n",
        }) );

}

int give_gift(object who)
{
       object ob;
       object me=this_object();
       who=this_player();
	if (!userp(who))
	{
		command("maoli "+who->query("id"));
                command("say 小东西！加油干啊！");
		return 1; 
	}
	if (who->query("mounse/gift")==1)
	{
                command("say 可不要贪心啊! ？小心掉到十八层地狱...");
              command("heng "+who->query("id"));
		return 1;
	}
	command("ppp "+who->query("id"));
        command("say 恭喜你!");
       message_vision("$N给了$n一份"HIG"BUG奖励餐。\n"NOR,me,who );
       who->set("mounse/gift",1);
       ob=new("/u/win/obj/jiangli/gift.lpc");
       ob->move(who);
       ob->set("owner",who);
	return 1;
}

