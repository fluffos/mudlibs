void init()
{
  if (!wizardp(this_player())) {
    set("no_get","掉在地上了不能吃了吧。\n");
    set("no_give","大胆狂徒，竟然连WIZ的东西都敢乱给人!\n");
    set("no_drop","真的不要啊,还是吃了吧,倒掉多可惜啊!\n");
    set("no_sell","都凉了还有谁会要啊。\n");
    set("no_put","放久了要变质的噢！");
  }
    if(this_player()==environment()) {
  add_action("do_eat", "eat");
  add_action("do_wish","wish");
  }
}

void create()
{
                  set_name( HIG"劳动快餐"NOR, ({ "snack"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("unit", "份");
       set("long", "一份热气腾腾的劳动节快餐!\n吃(eat)前还可以先许个愿。(wish wx/dx/qn/force&mana):D\n");
      set("value", 100);
    set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}

 int do_eat(string arg)
{
  object me = this_player();
  int nfl,score,rd;
 
    if (!arg && arg!="snack")
      return notify_fail("你要吃什么?\n");
    if (this_object()->query("owner")!=me) 
      {
       tell_object(me,"你怎么弄来的?\n");
       return 1;
       }

 seteuid(getuid());
rd=random(4);

if (me->query_temp("yuanxiao/want")=="wx") rd=0;  
if (me->query_temp("yuanxiao/want")=="dx") rd=1;
if (me->query_temp("yuanxiao/want")=="qn") rd=2;
if (me->query_temp("yuanxiao/want")=="force&mana") rd=3;
 score=get_score(me);
nfl=15;
if (score>2000) nfl=20;
if (score>5000) nfl=30;
if (score>10000) nfl=40;
if (score>15000) nfl=50;
if (score>25000) nfl=60;
score=score*2/25*100;
if (score<20000) score=score*2;
else if (score<100000) score=40000+score-20000;
else if (score<300000) score=120000+(score-100000)/2;
else score=220000+(score-300000)/5;
message_vision (says[random(sizeof(says))],me);
message_vision ("$N"+hows[random(sizeof(hows))]+manners[random(sizeof(manners))]
        +actions[random(sizeof(actions))]+"。\n",this_player(),this_object());

if (rd==0)
{
     me->add("combat_exp",50000+score);
                 tell_object(me,HIW"你得到了：" +
  chinese_number(50000+score) + "点武学。\n\n" NOR);         
}
if (rd==1)
{
       me->add("daoxing",50000+score);
                   tell_object(me,HIW"你得到了：" +
  chinese_number(50000+score) + "点道行。\n\n" NOR);         

}
if (rd==2)
{
        score=score*4/5;
        me->add("potential",30000+score);
                    tell_object(me,HIW"你得到了：" +
  chinese_number(30000+score) + "点潜能。\n\n" NOR);         
}
if (rd==3)
{
        me->add("max_mana",nfl);
        me->add("max_force",nfl);
                      tell_object(me,HIW"你得到了：" +
  chinese_number(nfl) + "点内法力。\n\n" NOR);         
}

tell_object(me,HIM"                幻想" HIG "西天" HIY 
"华中站全体巫师祝您节日快乐,万事如意!\n" NOR);
me->delete_temp("yuanxiao/want");
  destruct(this_object());
  
  return 1;
}

int get_score(object ob)
{
    int tlvl,i,score;
    string *ski;
    mapping skills;

    reset_eval_cost();
    skills = ob->query_skills();
    if (!sizeof(skills)) return 1; 
    ski  = keys(skills);
    for(i = 0; i<sizeof(ski); i++) {
        tlvl += skills[ski[i]];
    }  // count total skill levels
     score = tlvl/10;
    score += ob->query("max_force")/10;
    score += ob->query("max_mana")/10;
    score += ob->query_str() + ob->query_int() + ob->query_spi() + ob->query_con();
    score += (int)ob->query("combat_exp")/2500;
    score += (int)ob->query("daoxing")/2500;

    return score;
}

int do_wish(string arg)
{
object me=this_player();
if (!arg||(arg!="wx"&&arg!="dx"&&arg!="qn"&&arg!="force&mana")) 
   return notify_fail("你要许什么愿?\n");
if (me->query_temp("yuanxiao/want"))
{
 if (me->query_temp("yuanxiao/want")==arg) return notify_fail("你已经许了这个愿了。\n");
 if (me->query_temp("yuanxiao/want")=="wx") 
     tell_object(me,"你歪着脑袋想了想，决定还是不要武艺超群了。\n");
 if (me->query_temp("yuanxiao/want")=="dx") 
     tell_object(me,"你歪着脑袋想了想，决定还是不要道行高深了。\n");
 if (me->query_temp("yuanxiao/want")=="qn") 
     tell_object(me,"你歪着脑袋想了想，决定还是不要潜力充沛了。\n");
 if (me->query_temp("yuanxiao/want")=="force&mana") 
     tell_object(me,"你歪着脑袋想了想，决定还是不要内息深厚，法力无边了。\n");
}
tell_object (me,"\n你默默地闭上眼睛，暗暗道：\n");
if (arg=="wx") tell_object(me,"我希望自己能够武艺超群。\n");
if (arg=="dx") tell_object(me,"我希望自己能够道行高深。\n");
if (arg=="qn") tell_object(me,"我希望自己能够潜力充沛。\n");
if (arg=="force&mana") tell_object(me,"我希望自己能够内息深厚，法力无边。\n");
me->set_temp("yuanxiao/want",arg);
return 1;
}

