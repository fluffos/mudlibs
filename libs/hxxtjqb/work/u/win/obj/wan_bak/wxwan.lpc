//wan.c
//updated by piao

#include <ansi.h>

inherit ITEM;
int do_eat(string);
void init();
void init()
{
        if (!wizardp(this_player())) {
                set("no_get", "嘿嘿，做梦吧! \n");
                set("no_sell", "嘿嘿，做梦吧! \n");
                set("no_give", "嘿嘿，做梦吧! \n");
                set("no_drop","这么珍贵的机会，哪能舍弃？! \n");
        }
        add_action("do_set","set");
        add_action("do_eat", "eat");
}

void create()
{
   set_name(HIM "痴人梦话的武学奖励丸" NOR, ({"wxjiangli wan","wxwan",}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
   else {
     set("unit", "颗");
     set("long", "给发现在BUG的给予一定的奖励的奖励丸。上面刻有：“好同志，好同志”六个字。\n");
     set("drug_type", "补品");
        }
  set("is_monitored",1); //监控精灵
  setup();
}


int do_set(string arg)
{
 int i;
 object who=this_player();
 object me=this_object();
 
 if (! wizardp (who)) {
    tell_object(who,"你不是wiz。\n");
    return 1;
  }

 if( !arg||!sscanf(arg, "%d", i) )
         return notify_fail("你要设多少?\n");
 me->set("set_num",i);
tell_object(who,"设置完毕。\n");
return 1;
}
int do_eat(string arg)
{
        object ob;
        int i;
        i=50000;
        if (this_object()->query("set_num")) i=this_object()->query("set_num");
        if( !id(arg) ) return notify_fail("你要吃什麽？\n");
          if( living( this_player())==0) return 0;
        ob=this_player(); 
           ob->set("food", (int)ob->max_food_capacity());
           ob->add("combat_exp",i);
           message_vision(HIC "$N吃下一颗奖励丸。\n你得到了"+i+"经验。\n \n \n看来自己的贡献没有白费啊，以后还要多努力！ \n" NOR, ob);
           destruct(this_object()); //毁灭这个物品
           return 1;
}
