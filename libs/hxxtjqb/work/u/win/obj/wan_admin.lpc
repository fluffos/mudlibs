//updated by piao
//modified by admin

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();
void init() {
  if (!wizardp(this_player())) {
    set("no_get", "嘿嘿，做梦吧! \n");
    set("no_sell", "嘿嘿，做梦吧! \n");
    set("no_give", "嘿嘿，做梦吧! \n");
    set("no_drop", "这么珍贵的机会，哪能舍弃？! \n");
  }
  add_action("do_set", "setme");
  add_action("do_eat", "eat");
}

void create() {
  set_name(this_player()->query("name") + "的奖励丸", ({ "jiangli wan", "wan", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "给发现在BUG的给予一定的奖励的奖励丸。上面刻有：“好同志，好同志”六个字。\n");
    set("drug_type", "补品");
  }
  set("is_monitored", 1);  //监控精灵
  setup();
}


int do_set(string arg) {
  int i;
  string *jiangli = ({ "daoxing", "combat_exp", "potential", "mud_age", "per", "kar" }), one;
  object who = this_player();
  object me = this_object();

  if (!wizardp(who)) {
    tell_object(who, "你不是wiz。\n");
    return 1;
  }

  if (!arg || !sscanf(arg, "%s %d", one, i))
    return notify_fail("格式为set 奖励参数 数值 （奖励参数可以是daoxing,combat_exp,potential,mud_age,per,kar之一）\n");
  if (member_array(
    one,
    jiangli
  ) == -1) return notify_fail("你只能选择daoxing,combat_exp,potential,mud_age,per,kar之一\n");
  me->set("set_num", i);
  me->set("jiangli", one);
  tell_object(who, "设置完毕。\n");
  return 1;
}
int do_eat(string arg) {
  object ob;
  string jiangli;
  int i;
  i = 50000;
  ob = this_player();
  jiangli = this_object()->query("jiangli");
  i = this_object()->query("set_num");
  if (!id(arg)) return notify_fail("你要吃什麽？\n");
  if (living(this_player()) == 0) return 0;

  if (!jiangli || !i) { write("你吃下一颗药丸，好像什么反应也没有。\n"); destruct(this_object()); return 1; }
  ob->set("food", (int)ob->max_food_capacity());
  ob->add(jiangli, i);
  if (jiangli == "combat_exp") jiangli = "战斗经验";
  if (jiangli == "daoxing") jiangli = "道行";
  if (jiangli == "potential") jiangli = "潜能";
  if (jiangli == "mud_age") jiangli = "年龄";
  if (jiangli == "kar") jiangli = "福缘";
  if (jiangli == "per") jiangli = "容貌";
  message_vision(
    HIC "$N吃下一颗奖励丸。\n你的" + jiangli + "增加了" + i + "点。\n \n \n看来自己的贡献没有白费啊，以后还要多努力！ \n" NOR,
    ob
  );
  log_file(
    "bug_reward",
    ob->query("name") + "吃了" + query("name") + ", " + jiangli + "增加了" + i + "点。\n"
  );
  destruct(this_object());  //毁灭这个物品
  return 1;
}
