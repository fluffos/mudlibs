inherit ROOM;

void create() {
  set("short", "痴人梦话之居");
  set("long", @LONG

LONG);
  set("exits",
    ([  //sizeof() == 2
    "wiz": "/d/wiz/wizroom",
      "kz": "/d/city/kezhan",
      "qiushi": "/d/wiz/qiushi",
    ]));
  set("objects",
    ([
      "/obj/wiz/rack": 1,
    ]));

  set("outdoors", "changan");
  set("no_fly", 1);
  set("no_time", 1);
  set("if_bed", 1);
  set("sleep_room", 1);
  set("no_upgrade_age", 1);
  set("valid_startroom", 1);
  replace_program(ROOM);
  setup();
}
