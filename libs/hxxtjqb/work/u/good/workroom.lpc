#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()

{
  set("short", HIC "休息间 " NOR);
  set("long", HIC "休息的地方，这里有一些桌椅，桌子上放了一台大彩电，在这里休息很舒服。没有工作的烦恼真痛快。\n\n" NOR);
  set("objects", ([
    "/d/qujing/baoxiang/obj/cspitan": 1,
    "/d/qujing/baoxiang/obj/yizi": 2,
    "/d/qujing/baoxiang/obj/zhuozi": 1,
    __DIR__ "tv": 1,
    "/obj/toy/camera": 1,
  ])); ;
  set("valid_startroom", 1); ;
  set("no_clean_up", 0);
  set("sleep_room", 1);
  set("if_bed", 1);
  setup();
}

void init() {
  add_action("do_stand", "stand");
  add_action("do_sit", "sit");
  add_action("do_leave", "leave");
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed");
  add_action("do_bed", "bed");
  add_action("do_out", "out");
}

int do_sit(string arg) {
  object me;
  me = this_player();
  if (!arg || ((arg != "seat") && (arg != "table"))) return notify_fail("你要坐在什么上面？\n");

  if (this_player()->query_temp("marks/sit")) return notify_fail("你已经坐下了。\n");

  if (arg != "seat") return notify_fail("你坐在哪里?坐桌子上吗？太不雅观了吧。\n");

  this_player()->set_temp("marks/sit", 1);
  message_vision("$N舒舒服服地在石凳上坐下来，翘起了二郎腿。\n", me);
  return 1;
}

int do_stand(string arg) {
  object me;
  me = this_player();
  if (!this_player()->query_temp("marks/sit")) return notify_fail("你本来就站着。\n");

  this_player()->set_temp("marks/sit", 0);
  message_vision("$N伸了个懒腰，站了起来。\n", me);
  return 1;
}
int do_leave(object ob) {
  ob = this_player();
  write(HIC "你招来一朵祥云坐了上去...\n" NOR);
  message(
    "vision",
    sprintf(HIC + "%s招来祥云坐了上去...\n一眨眼的功夫%s就不见了。\n" + NOR, ob->name(), ob->name()),
    environment(ob),
    ({ ob })
  );
  ob->move("/d/city/center");
  write(HIC "\n你从一朵祥云里走了出来。\n\n" NOR);
  message(
    "vision",
    sprintf(HIC + "只见一朵祥云飘来，%s从里面走了出来！\n" NOR, ob->name()),
    environment(ob),
    ({ ob })
  );
  return 1;
}
int do_bed() {
  object me;
  me = this_player();
  message_vision(HIC "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  message_vision(HIC "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}

int do_out() {
  object me;
  me = this_player();
  message_vision(HIC "$N掀开纱帐，准备起床了。\n\n" NOR, me);
  message_vision(HIC "\n沙帐轻轻一动，$N钻了出来。\n" NOR, me);
  return 1;
}
