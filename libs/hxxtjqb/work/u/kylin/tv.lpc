#include <ansi.h>
inherit ITEM;
string *mesg = ({
  "唱道：怎么会迷上你，我在问自己。。。",
  "唱道：何处是归程，长亭连短亭。声音凄凉，催人泪下。",
  "东坡叹道：纵使相见应不识，尘满面，鬓如霜...料得年年肠断处，明月夜，短松冈。",
  "帝曰：若得阿娇为妇，当以金屋贮之。",
  "罗成误走小商河，被乱箭射的如同刺猬一般。",
  "佛曰：只要尘尘缘总弃，物物色皆空。",
  "风漂萍叹道：曲终人不见，江上数峰青。",
  "霸王曰：战不利，非用兵之过也。遂自刎乌江。",
  "李清照叹到：这次第，怎一个愁字了得。",
  "勃曰：天若有情天亦老，月若无恨月常圆。",
  "某人叹曰：东西当铺当东西，大小赌徒赌大小，妙对！妙对！",
});

void init();
int do_power(string arg);
int do_break(string arg);
int do_tune(string arg);

void create() {
  set_name(HIC "大屏幕" HIR "彩" HIG "电" NOR, ({ "tv", "tvset" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "台");
    set("value", 100000);
    set("material", "crimsonsteel");
    set("long",
      HIW "一台大彩电，图象清晰，你可以开关(power)和使用遥控器调台(switch).\n" NOR);
  }
  setup();
}
void init() {
  add_action("do_power", "power");
  add_action("do_break", "break");
  add_action("do_tune", "switch");
  call_out("tv_show", random(3) + 3);
}

int do_power(string arg) {
  object me = this_object();
  object who = this_player();
  object where = environment(me);
  if (!where->query("poweron")) {
    message_vision(HIG "$N啪的一声打开电源,屏幕上出现了栩栩如生的画面。\n" NOR, who);
    where->set("poweron", 1);
    return 1;
  }
  message_vision(HIM "$N啪的一声关上电源,屏幕顿时一片漆黑。\n" NOR, who);
  where->set("poweron", 0);
  return 1;
}

int do_break(string arg) {
  object who = this_player();
  message_vision(HIR "$N运功一震，好好的一台大屏幕彩电被$N这个败家子震的稀烂。\n" NOR, who);
  destruct(this_object());
  return 1;
}

int do_tune(string arg) {
  object me = this_object();
  object who = this_player();
  object where = environment(me);
  if (!where->query("poweron"))
    return notify_fail("电源没打开，调台也没用。\n");
  message_vision(HIG "$N拿起遥控板，换了一个新台。\n" NOR, who);
  return 1;
}

int tv_show() {
  object me = this_object();
  object where = environment(me);
  remove_call_out("tv_show");
  call_out("tv_show", random(10) + 20);
  if (!where->query("poweron"))
    return 1;
  message("vision", HIG "(电视里)" + mesg[random(sizeof(mesg))] + "\n" NOR, environment(me), ({ me }));
  return 1;
}
