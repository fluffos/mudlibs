// kaoya.c 烤鸭

inherit ITEM;
inherit F_FOOD;

void create()
{
       set_name("松鼠鳜鱼", ({"gui yu", "guiyu", "yu"}));
	set_weight(200);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一盘香喷喷的红烧松鼠鳜鱼。\n");
          set("unit", "盘");
           set("value", 1000);
           set("food_remaining", 10);
         set("food_supply", 100);
	}
}
