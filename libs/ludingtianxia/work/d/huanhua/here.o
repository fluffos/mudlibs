inherit ROOM;

#include <ansi.h>
string look_sign(object me);

void create()
{
        set("short", HIC"李逍遥的工作室"NOR);
        set("long", HIY"
    这里是李逍遥的办公室，屋子里没有你所想象的熬
着希奇古怪令人呕吐的东西的大汤锅，也没有大大小小
试管烧杯，只有桌子上放着一个水晶球（shuijingqiu)。
    你感到茫然，这里住的真是巫师吗？    
"NOR
        );
        set("valid_startroom", 1);
        set("item_desc", ([
                "shuijingqiu": (: look_sign :),
        ]) );

        set("exits", ([ /* sizeof() == 4 */
  "down" : "/d/city/guangchang",
"north" : "/d/city/lao",
"east":"/u/mouse/workroom",
"west":"/u/cangyue/workroom"
]));



        setup(); 
}

string look_sign(object me)
{
        if( wizardp(me) )
                return HIB"                  ※※※※※※※※  天地依旧  ※※※※※※※※
\n"NOR;
        else
                return HIY"依稀里面有三四个人影，难道是...赵灵儿，林月如和阿奴吗？\n"NOR;
}



