#include <lib.h>
#include <dirs.h>


inherit LIB_DAEMON;

int
cmd(string arg)
{
    if(!archp(previous_object())) return 0;
    write("The opcprof efun was removed from the FluffOS driver, so there is no profile to dump.");

    return 1;
}

int help()
{
    write( @EndText
Syntax: opcprof
Effect: Reports that there is no operator profile to dump: the opcprof efun was
removed from the FluffOS driver.
See man: opcprof
See also: fdinfo, netstat, mstatus, cache, callouts, dumpallobj,
EndText
    );
    return 1;
}
