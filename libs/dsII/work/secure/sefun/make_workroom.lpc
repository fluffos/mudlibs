string nom;

int make_workroom(mixed dude) {
    string cdir, tdir, dir_line;

    if(!dude) return 0;

    if(objectp(dude) && !nom = dude->GetKeyName()) return 3;
    if(stringp(dude) && !nom = lower_case(dude)) return 2;

    if(unguarded( (: file_size("/realms/template/") :) ) == -1) return 4;

    if(unguarded( (: file_size("/realms/"+nom) :) ) == -1){
	cdir = "/realms/"+nom;
	tdir = "/realms/template/";
	dir_line = "#define MY_DIR          \"/realms/"+nom+"\"";
	mkdir(cdir);
	mkdir(cdir+"/cmds");
	mkdir(cdir+"/log");
	mkdir(cdir+"/bak");
	mkdir(cdir+"/tmp");
	mkdir(cdir+"/area");
	mkdir(cdir+"/area/room");
	mkdir(cdir+"/area/weap");
	mkdir(cdir+"/area/obj");
	mkdir(cdir+"/area/npc");
	mkdir(cdir+"/area/armor");
	mkdir(cdir+"/area/etc");
	mkdir(cdir+"/area/doors");
	mkdir(cdir+"/area/meals");
	cp(tdir+"workroom.lpc", cdir+"/workroom.lpc");
	cp(tdir+"workroom.bak", cdir+"/workroom.bak");
	cp(tdir+"bak/workroom.orig", cdir+"/bak/workroom.orig");
	cp(tdir+"bak/bk.db", cdir+"/bak/bk.db");
	cp(tdir+"plan", cdir+"/.plan");
	cp(tdir+"profile", cdir+"/.profile");
	cp(tdir+"cmds/custom.lpc", cdir+"/cmds/custom.lpc");
	cp(tdir+"customdefs.part1", cdir+"/customdefs.h");
	write_file(cdir+"/customdefs.h","\n"+dir_line+"\n");
	write_file(cdir+"/customdefs.h",read_file(tdir+"customdefs.part2"));
	cp(tdir+"area/room/sample_room.lpc", cdir+"/area/room/sample_room.lpc");
	cp(tdir+"area/room/sample_two.lpc", cdir+"/area/room/sample_two.lpc");
	cp(tdir+"area/weap/sword.lpc", cdir+"/area/weap/sword.lpc");
	cp(tdir+"area/obj/table.lpc", cdir+"/area/obj/table.lpc");
	cp(tdir+"area/obj/key.lpc", cdir+"/area/obj/key.lpc");
	cp(tdir+"area/obj/case.lpc", cdir+"/area/obj/case.lpc");
	cp(tdir+"area/obj/watch.lpc", cdir+"/area/obj/watch.lpc");
	cp(tdir+"area/npc/fighter.lpc", cdir+"/area/npc/fighter.lpc");
	cp(tdir+"area/armor/chainmail.lpc", cdir+"/area/armor/chainmail.lpc");
	cp(tdir+"area/armor/leather_boot_r.lpc", cdir+"/area/armor/leather_boot_r.lpc");
	cp(tdir+"area/armor/leather_boot_l.lpc", cdir+"/area/armor/leather_boot_l.lpc");
	return 1;
    }

    else {
	//write("That person already has a homedir.");
	return 5;
    }
}
