/* secure/sefun/ed_compat.lpc
 *
 * FluffOS PORT NOTE: this codebase's /lib/editor.lpc and
 * /secure/cmds/creators/lsed.lpc were written against FluffOS's "new"
 * ed API (ed_start()/ed_cmd()/query_ed_mode(), declared in
 * packages/core/core.spec's #else branch). This project's compiled
 * driver binary was built with OLD_ED defined instead (`#define
 * OLD_ED` in src/local_options), meaning only the older single-efun
 * ed(fname, exitfn, restricted) form is actually callable from LPC.
 * Same gap/fix as libs/dsI/work/secure/sefun/ed_compat.lpc (and
 * libs/foundation2/work/secure/sefun/ed_compat.lpc before it).
 *
 * query_ed_mode() is approximated here via in_edit(), which IS
 * available under OLD_ED: returns 0 while genuinely editing (matches
 * every caller's `!= -1` / `== -1` gate for "an edit session is
 * active"), -1 otherwise. The old ed() driver doesn't expose the
 * newer API's finer sub-states (help-mode -2, per-line prompts) --
 * every real caller in this codebase only branches on -1 vs not, so
 * this is lossless for the load-bearing behavior.
 */
int query_ed_mode() {
    return in_edit(this_object()) ? 0 : -1;
}
