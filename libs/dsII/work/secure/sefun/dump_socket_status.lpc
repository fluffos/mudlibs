// socket_status() is unavailable on this driver build (no `sockets`
// package -- e.g. the WASM build, where real network sockets don't
// make sense in a browser sandbox), so it's not just absent at runtime
// but undefined at COMPILE time -- any reference to it fails the whole
// file's (and therefore this whole simul_efun object's, since this
// file is #include'd into secure/sefun/sefun.lpc) compile. This is a
// diagnostic/admin-tool utility only, not part of the boot/login path,
// so it's neutered to a no-op on builds without the sockets package
// (same fix shape as this project's ds386/lima entries).
string dump_socket_status() {
#ifdef __PACKAGE_SOCKETS__
    string ret = @END
Fd    State      Mode       Local Address          Remote Address
--  ---------  --------  ---------------------  ---------------------
END;

    foreach (mixed *item in socket_status()) {
	ret += sprintf("%2d  %|9s  %|8s  %-21s  %-21s\n", item[0], item[1], item[2], item[3], item[4]);
    }

    return ret;
#else
    return "";
#endif
}
