/*    /lib/comp/seal.c
 *    from the Dead Souls Object Library
 *    Composite component of a closeable and lockable thing
 *    Created by Descartes of Borg 961221
 *    Version: @(#) seal.c 1.2@(#)
 *    Last modified: 96/12/23
 */

#include <lib.h>

inherit LIB_CLOSE;
inherit LIB_LOCK;

varargs nosave mixed AddSave(mixed args...) {
    return ({});
}

mixed CanLock(object who, string id) {
    mixed tmp = lock::CanLock(who);

    if( tmp != 1 ) {
	return tmp;
    }
    if( !GetClosed() ) {
	return "You cannot lock it while it is open.";
    }
    return 1;
}

mixed CanOpen(object who) {
    if( GetLocked() ) {
	return "It is locked!";
    }
    else return close::CanOpen(who);
}

varargs mixed eventOpen(object who, object tool) {
    if( tool && GetLocked() ) {
	/* FluffOS PORT NOTE: eventPick() is declared varargs mixed
	 * eventPick(object who, string id, object tool) (lib/events/
	 * lock.lpc) -- the 2nd positional argument is always the lock
	 * id (a string), with `tool` 3rd and optional. This call passed
	 * `tool` positionally as `id` instead, a genuine original-
	 * archive bug (an object where a string was expected, caught by
	 * this driver's stricter argument type-checking; the single
	 * highest-impact compile failure in this port, transitively
	 * breaking every LIB_CLOSE+LIB_LOCK "seal" composite object --
	 * containers, doors, chests, etc, ~195 files). Fixed by passing
	 * an explicit unset `id` (0) and moving `tool` to its real
	 * (3rd) position, matching every other real caller (e.g.
	 * verbs/items/pick.lpc's `ob->eventPick(this_player(), wrd,
	 * tool)`).
	 */
	mixed tmp =  eventPick(who, 0, tool);

	if( tmp != 1 || GetLocked() ) {
	    return tmp;
	}
    }
    if( GetLocked() ) {
	send_messages(({ "attempt", "find" }), "$agent_name $agent_verb to "
	  "open $target_name, but $agent_nominative $agent_verb "
	  "it locked.", who, this_object(), environment(who));
	return 1;
    }
    return close::eventOpen(who, tool);
}

void create() {
    string *c_save, *l_save, *a_save;

    c_save = close::GetSave();
    l_save = lock::GetSave();
    a_save = c_save + l_save;

    AddSave( a_save );

}
