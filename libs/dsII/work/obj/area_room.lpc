#include <lib.h>
#include <rooms.h>

/* FluffOS PORT NOTE: this file is a copy-source template that
 * secure/modules/room.lpc's room-building tool cp()'s to a
 * user-chosen destination (unlike its sibling
 * realms/template/area/room/sample_room.lpc, whose "../../
 * customdefs.h" is correct relative to ITS OWN fixed location) --
 * "../../customdefs.h" from this file's own location (/obj/) never
 * resolves to anything real, and the compile error blocked this
 * template (and therefore every room the tool copies it into) from
 * loading at all. Dropped rather than repointed: unlike
 * sample_room.lpc, this file's body never actually references any of
 * customdefs.h's MY_* macros, so the include was simply dead weight
 * here, not a real dependency.
 */
inherit LIB_ROOM;

void create() {
    room::create();
    SetAmbientLight(30);
    SetShort("a blank room");
    SetLong("A featureless area.");
}

void init(){
    ::init();
}

