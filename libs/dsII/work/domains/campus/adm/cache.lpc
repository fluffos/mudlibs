#include <lib.h>
/* FluffOS PORT NOTE: this codebase's lib/include/room.h lives
 * outside the configured include path (secure/include:/include)
 * and outside this file's own directory, so a bare `#include
 * <room.h>` never resolves on this driver -- "Cannot #include
 * room.h". That header is only forward declarations for LIB_ROOM's
 * methods (SetShort/SetLong/etc.), already fully provided by the
 * real `inherit LIB_ROOM;` below with no forward declare needed,
 * so the broken include is simply dropped rather than repointed. */
#include <rooms.h>

inherit LIB_ROOM;

void create() {
    room::create();
    SetShort( "The cache");
    SetLong( "Things are hidden here.");
    SetProperties( ([ "storage room" : 1, "logout" : ROOM_START ]) );
}
