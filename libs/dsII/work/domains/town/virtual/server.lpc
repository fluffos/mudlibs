
/* FluffOS PORT NOTE: this driver build natively predefines __DIR__
 * (the directory of the current file, with trailing slash -- same
 * value this line used to hardcode) as a compiler builtin, so
 * user code is no longer allowed to #define it -- "Illegal to
 * redefine a predefined value." The hand-written value below was
 * already exactly what the native builtin produces, so the
 * #define is simply redundant now; removed. */

mixed compile_object(string file) {
    string *path;
    object ob;
    int x, y;

    //if( previous_object() != master() ) return 0;
    path = explode(file, "/");
    //if( sizeof(path) != 5 ) return "Wrong size path";
    if( file_size(__DIR__ + path[3] + ".lpc") < 1 ) return "bad file";
    if( sscanf(path[4], "%d,%d", x, y) != 2 ) return "missing comma";    
    if( !(ob = new(__DIR__ + path[3], x, y)) ) return "failed to compile";
    return ob;
}
