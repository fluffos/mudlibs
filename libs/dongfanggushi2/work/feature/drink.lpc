// drink.c

#include <dbase.h>
#include <name.h>

// Any drink should either inherit LIQUID or define these functions.
int query_volume();
void add_volume(int);

int drink_ob(object me) {
  int stuff, heal;

  stuff = me->query_stat_maximum("water") / 3;
  if (stuff + me->query_stat("water") > me->query_stat_maximum("water"))
    stuff = me->query_stat_maximum("water") - me->query_stat("water");
  if (!stuff) return notify_fail("你已经涨得喝不下一滴水了　\n");

  if (stuff > query_volume() / 10)
    stuff = query_volume() / 10;

  if (!stuff) return 0;

  me->supplement_stat("water", stuff);
  message_vision("$N从" + environment()->name() + "喝了几口" + name() + "　\n", me);

  if (heal = query("heal_gin")
    && me->supplement_stat("gin", heal))
    write("你喝了" + name() + "之後，觉得恢复了一些精力　\n");

  if (heal = query("heal_kee")
    && me->supplement_stat("kee", heal))
    write("你喝了" + name() + "之後，觉得气力恢复了一些　\n");

  if (heal = query("heal_sen")
    && me->supplement_stat("sen", heal))
    write("你喝了" + name() + "之後觉得清醒多了　\n");

  add_volume(-stuff * 10);

  return 1;
}
