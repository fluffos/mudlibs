// logind.c

#pragma save_binary

#include <ansi.h>
#include <command.h>
#include <login.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;

string *user_race = ({ "human", "yenhold", "woochan", "jiaojao" });

string *banned_name = ({
  "你", "你", "我", "他", "她", "　", "它",
  "安尼席雷特",
  "孙老爷",
});

string *banned_site = ({
  "202.96.134.135",
  "202.102.111.2",
});

// This is a option to give penalty to those create character again and
// again to get 'good' attributes.
#ifdef ANTI_BUZZER
mapping buzzer_player = ([]);
mapping buzzer_ip = ([]);
string *penalty_attr = ({ "str", "int", "dex", "con", "spi", "cps", "wis", "cor" });
#endif

private void get_id(string arg, object ob);
private void confirm_id(string yn, object ob);
private void get_email(string email, object ob);
object make_body(object ob);
private void init_new_body(object link, object user);
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);
private int list_user_race(object link);

void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
}

void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt;

#ifdef ANTI_BUZZER
  // WASM/local play: loopback exempt from the per-IP character-creation
  // flood throttle -- every browser tab is a loopback connection.
  // Fail-closed: only an exact loopback match is exempt; a malformed/
  // unparseable address is treated as remote, not exempt.
  {
    string _lip = query_ip_number(ob);
    if (!(stringp(_lip) && (_lip == "127.0.0.1" || _lip[0..3] == "127."))
        && buzzer_ip[_lip] >= 10) {
      write("从您的主机创造的人物太多了，您的主机将被拒绝往来一段时间　\n");
      destruct(ob);
      return;
    }
  }
#endif

  write(read_file(WELCOME));
  UPTIME_CMD->main();

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i])) wiz_cnt++;
    else ppl_cnt++;
  }
  printf("目前共有 %d 位巫师　%d 位玩家在线上，以及 %d 位使用者尝试连线中　\n\n",
    wiz_cnt, ppl_cnt, login_cnt);

  write("您的英文名字：");
  input_to((: get_id :), ob);
}

private void get_id(string arg, object ob) {
  object ppl;

  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("您的英文名字：");
    input_to("get_id", ob);
    return;
  }
  ob->set("id", arg);
  seteuid(arg);
  export_uid(ob);
  seteuid(getuid());

#ifdef MAX_USERS
  if (wizhood(arg) == "(player)" && sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);
    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl)) {
      write("对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来　\n");
      destruct(ob);
      return;
    }
  }
#endif

#ifdef ENABLE_BAN_SITE
  if (wizhood(arg) == "(player)") {
    int i;
    string ip;

    ip = query_ip_number(ob);
    for (i = 0; i < sizeof(banned_site); i++)
      if ((ip == banned_site[i])
        || sscanf(ip, banned_site[i])) {
        write("对不起，您的 IP Address 目前被列为拒绝连线地区　\n");
        destruct(ob);
        return;
      }
  }
#endif

  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起，" + MUD_NAME + "目前限制巫师等级 " + WIZ_LOCK_LEVEL
      + " 以上的人才能连线　\n");
    destruct(ob);
    return;
  }

  if (arg == "guest") {
    // If guest, let them create the character.
    get_email("guest@" + query_ip_name(ob), ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("请输入密码：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("对不起，您的人物储存挡出了一些问题，请利用 guest 人物通知巫师处理　\n");
    destruct(ob);
    return;
  }

  write("使用 " + (string)ob->query("id") + " 这个名字将会创造一个新的人物，您确定吗(y/n)？");
  input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob) {
  string my_pass;
  object user;

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密码错误！\n");
    destruct(ob);
    return;
  }

  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (!user->link()) {
      reconnect(ob, user);
      return;
    }
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("[%s] %12s login from %s\n",
        ctime(time()), (string)user->query("id"),
        query_ip_name(ob)));
      enter_world(ob, user);
      return;
    } else
      destruct(user);
  }
  write("请您重新创造这个人物　\n");
  get_email(ob->query("email"), ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，欢迎下次再来　\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " + query_ip_number(ob)
      + " )连线取代你所控制的人物　\n");
    log_file("USAGE", sprintf("%s is replaced by %s (%s)\n", (string)user->query("id"),
      query_ip_name(ob), ctime(time())));
  }

  // Kick out tho old player.
  old_link = user->link();
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

private void confirm_id(string yn, object ob) {
  if (yn == "") {
    write("使用这个名字将会创造一个新的人物，您确定吗(y/n)？");
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那麽请重新输入您的英文名字：");
    input_to("get_id", ob);
    return;
  }

#ifdef ANTI_BUZZER
  if (buzzer_player[ob->query("id")]) buzzer_player[ob->query("id")]++;
  else buzzer_player[ob->query("id")] = 1;
  if (buzzer_ip[query_ip_number(ob)]) buzzer_ip[query_ip_number(ob)]++;
  else buzzer_ip[query_ip_number(ob)] = 1;
#endif
  write("请设定您的密码：");
  input_to("new_password", 1, ob);
}

private void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write("密码的长度至少要五个字元，请重设您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob) {
  string old_pass;

  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码　不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }

  write("您的电子邮件地址：");
  input_to("get_email", ob);
}

private void get_email(string email, object ob) {
  ob->set("email", email);

  // Complete non-body-specific initialization of new user here.
  ob->set("karma", 20);

  list_user_race(ob);
  input_to("get_race", ob);
}

private void get_race(string race, object ob) {
  int kar;

  if (member_array(race, user_race) == -1) {
    write("没有这种种族，请你重新选择：");
    input_to("get_race", ob);
    return;
  }

  kar = (int)RACE_D(race)->query("karma");
  if (wizhood(ob) == "(player)" && (int)ob->query("karma") < kar) {
    write("你的业力不够，请你重新选择：");
    input_to("get_race", ob);
    return;
  }
  ob->add("karma", -kar);

  write("您要扮演男性(m)的角色或女性(f)的角色？");
  input_to("get_gender", ob, race);
}

private void get_gender(string gender, object ob, string race) {
  object body;
  string body_file;

  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, body);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M') gender = "male";
  else if (gender[0] == 'f' || gender[0] == 'F') gender = "female";
  else {
    write("对不起，您只能选择男性(m)或女性(f)的角色：");
    input_to("get_gender", ob, body);
    return;
  }

  if (!stringp(body_file = RACE_D(race)->query("default_body")))
    body_file = USER_OB;
  ob->set("body", body_file);
  if (!(body = make_body(ob))) {
    destruct(ob);
    return;
  }

  body->set("gender", gender);
  body->set_race(race);
  init_new_body(ob, body);
  // Remember it so we can dest it if we go linkdead before finishing
  // chraracter creation.
  ob->set_temp("temp_body", body);

  write("您的中文名字：");
  input_to("get_name", ob, body);
}

private void get_name(string arg, object ob, object user) {
  if (!check_legal_name(arg)) {
    write("您的中文名字：");
    input_to("get_name", ob, user);
    return;
  }

  ob->set("name", arg);
  user->set("name", arg);
  if (!ob->query("creation_time")) {
    log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
      query_ip_name(ob), ctime(time())));
    ob->set("creation_time", time());
  }
  enter_world(ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者物件的程式，无法进行复制　\n");
    write(err + "\n");
    return 0;
  }

  // When new connection is built, the login object is cloned with
  // uid = Root and euid = 0;
  seteuid(getuid(ob));
  export_uid(user);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));

  return user;
}

private void init_new_body(object link, object user) {
#ifdef ANTI_BUZZER
  int penalty;
  string a;
#endif

  user->set("birthday", time());
  user->set_class("commoner");
  user->set_level(1);
#ifdef ANTI_BUZZER
  penalty = buzzer_player[user->query("id")] - 1;
  if (penalty < buzzer_ip[query_ip_number(link)])
    penalty = buzzer_ip[query_ip_number(link)];
  while (penalty-- > 0) {
    a = penalty_attr[random(sizeof(penalty_attr))];
    user->set_attr(a, user->query_attr(a) - 1);
  }
#endif
  CHAR_D->setup_char(user);
}

varargs void enter_world(object ob, object user, int silent) {
  object cloth, room;
  string startroom;

  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  if (!silent) write("目前权限：" + wizhood(user) + "\n");
  seteuid(getuid(user));
  user->setup();
  seteuid(getuid());

  // In case of new player, we save them here right aftre setup 
  // compeleted.
#ifdef SAVE_USER
  user->save();
#endif

  /*
	cloth = new("/obj/cloth");
	cloth->move(user);
	cloth->wear();
*/

  if (!silent) {
    cat(MOTD);
    if (ob->query("new_mail")) {
      write(GRN + "\n杜宽告诉你：有您的信！请到驿站来一趟...\n\n" + NOR);
      ob->set("new_mail", 0);
    }
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom")))
      startroom = START_ROOM;

    if (find_object(startroom) || !catch(startroom->foo()))
      user->move(startroom);
    else {
      user->move(START_ROOM);
      startroom = START_ROOM;
      user->set("startroom", START_ROOM);
    }
    tell_room(startroom, user->query("name") + "连线进入这个世界　\n",
      ({ user }));
    CHANNEL_D->do_channel(this_object(), "sys",
      sprintf("%s(%s)由%s连线进入　",
        user->name(),
        user->query("id"),
        query_ip_name(user)));
  }
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") + "重新连线回到这个世界　\n",
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf(
      "%s(%s)由%s重新连线进入　",
      user->query("name"),
      (string)user->query("id"),
      query_ip_name(user)
    ));
}

void net_dead(object ob) {
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)断线了　", ob->name(), geteuid(ob)));
}

int check_legal_id(string id) {
  int i;

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 12)) {
    write("对不起，你的英文名字必须是 3 到 12 个英文字母　\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母　\n");
      return 0;
    }

  return 1;
}

int check_legal_name(string name) {
  int i;

  // UTF8 FIX: strlen()/str[i] now count/return Unicode characters, not GBK
  // bytes -- the length bounds here used to be byte counts (2 bytes per
  // Chinese char), the "i%2==0" gating only checked every OTHER
  // (even-byte-offset) position to land on each char's lead byte, and the
  // "name[i..i+1]" fullwidth-space check was a 2-byte sliding window (now
  // a meaningless 2-CHARACTER window that can never equal the 1-character
  // "　"). All three are fixed for character-width strings below.
  i = strlen(name);

  if ((strlen(name) < 1) || (strlen(name) > 6)) {
    write("对不起，你的中文名字必须是 1 到 6 个中文字　\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字元　\n");
      return 0;
    }
    if (!is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字　\n");
      return 0;
    }
    if (name[i..i] == "　") {
      write("对不起，请不要用空白字元取名字　\n");
      return 0;
    }
  }
  if (member_array(name, banned_name) != -1) {
    write("对不起，这种名字会造成其他人的困扰　\n");
    return 0;
  }

  return 1;
}

object find_body(string name) {
  object ob, *body;

  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i])
      && userp(body[i])   // the body should be once inhabited.
      && body[i]->is_character()  // or we might find the body in init phase.
      && getuid(body[i]) == name) return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}

private int list_user_race(object link) {
  string list;
  int race_cnt = 0;

  list = "你现在共有 " + link->query("karma") + " 点业力，可以选择以下种族：\n\n";
  for (int i = sizeof(user_race) - 1; i >= 0; i--)
    if (RACE_D(user_race[i])->query("karma") <= (int)link->query("karma")) {
      list += sprintf("%-25s %d 点业力\n",
        to_chinese(user_race[i]) + "(" + user_race[i] + ")",
        RACE_D(user_race[i])->query("karma")
      );
      race_cnt++;
    }

  list += "\n你的选择：";
  if (!race_cnt && (wizhood(link) == "(player)")) {
    write("你的业力以经不够投胎转世成任何一种种族了，下次请多多努力吧　\n");
    return 0;
  }
  write(list);
  return 1;
}

void reincarnate(object ob) {
  object link;

  seteuid(getuid());

  // If the user is linkdead, we'll wait until he reconnect or next time login.
  if (!(link = ob->link())) {
    ob->save();
    destruct(ob);
    return;
  }

  link->add("karma", ob->query_level());
  link->save();
  exec(link, ob);
  rm(ob->query_save_file() + __SAVE_EXTENSION__);
  destruct(ob);

  // The final death.
  if (!list_user_race(link)) {
    write("你的业力已经不够投胎了，所以你沦落现实世界的地狱继续受苦　\n");
    write("\n\n\n── ＧＡＭＥ　ＯＶＥＲ ───\n\n\n");
    rm(link->query_save_file() + __SAVE_EXTENSION__);
    destruct(link);
    return;
  }

  input_to("get_race", link);
}

void reset() {
#ifdef ANTI_BUZZER
  buzzer_player = ([]);
  buzzer_ip = ([]);
#endif
}
