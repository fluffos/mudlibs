// magic.c

inherit SKILL;

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("magic");
}

void skill_improved(object me)
{
	int skill, learn;

	skill = me->query_skill("magic", 1);
	learn = me->query_learn("magic", 1);

	if( (skill+1) * (skill+1) * 100 < learn ) {
		me->advance_skill("magic", 1);
		me->gain_score("magic mastery", (skill+1) * 10);
	}
}
