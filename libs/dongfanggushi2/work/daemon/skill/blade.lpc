// blade.c

#include <ansi.h>

inherit SKILL;

mapping *actions = ({
    ([  "action":		"$N手腕一翻，$w往$n$l砍了过去",
        "damage_type":  "　伤",
	]),
    ([  "action":		"$N寻著空隙，一个箭步上前手中$w便往$n$l砍落",
		"damage_type":	"刺伤",
	]),
    ([  "action":       "$N手中$w一扬，一刀斩向$n$l",
		"damage_type":	"　伤",
	]),
    ([  "action":       "$N对准$n$l一刀挥了过去",
        "damage_type":  "割伤",
	]),
    ([  "action":       "$N横过手中$w，「唰」地一声往$n$l削去",
        "damage_type":  "割伤",
	]),
});

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("blade");
	DAEMON_D->register_skill_daemon("secondhand blade");
	DAEMON_D->register_skill_daemon("twohanded blade");
	setup();
}

void attack_using(object me, object opponent, object weapon)
{
	int damage;
	string skill;

	if( !sscanf(weapon->query("equipped"), "weapon/%s", skill) ) return;

	if( !opponent ) {
		if( me->query_temp("last_attacked_target")) 
			message_vision(CYN "$N伺机而动 ...　\n" NOR, me);
		return;
	}

	damage = COMBAT_D->fight(me, opponent, skill, actions[random(sizeof(actions))], weapon);
	if( damage > 0 ) me->improve_skill(skill, 1 + random(me->query_attr("int")));
}

void skill_improved(object me, string sk)
{
	int skill, learn;

	if( !sk ) sk = "blade";

	skill = me->query_skill(sk, 1);
	learn = me->query_learn(sk, 1);

	if( (skill<80) &&
		(skill+1) * (skill+1) * (skill+60) < learn ) {
		me->advance_skill(sk, 1);
		me->gain_score("martial art", (skill+1) * 10 );
	}
}
