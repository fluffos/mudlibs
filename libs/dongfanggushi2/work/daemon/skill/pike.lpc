// pike.c

#include <ansi.h>

inherit SKILL;

mapping *actions = ({
	([  "action":		"$N将$w往前一送，直刺$n$l",
		"damage_type":	"刺伤",
	]),
	([  "action":		"$N挥舞$w，对准$n$l刺去",
		"damage_type":	"刺伤",
	]),
	([  "action":		"$N高举手中$w，往$n$l挥了过去",
		"damage_type":	"　伤",
	]),
	([	"action":		"$N将$w一挥，往$n$l用力刺落",
		"damage_type":	"刺伤",
	]),
	([  "action":		"$N寻著空隙，手中$w对准$n$l挥了过去",
		"damage_type":	"割伤",
	]),
});

string *interattack = ({
	"$N紧握著手中的$n，伺机而动　\n",
	"$N用$n指著对手，一边缓缓移动脚步寻找机会出手　\n",
});

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("pike");
	DAEMON_D->register_skill_daemon("secondhand pike");
	setup();
}

void attack_using(object me, object opponent, object weapon)
{
	int damage;
	string skill;

	if( !sscanf(weapon->query("equipped"), "weapon/%s", skill) )
		return;

	if( !opponent ) {
		if( me->query_temp("last_attacked_target"))
			message_vision(CYN + interattack[random(sizeof(interattack))] + NOR,
				me, weapon);
		return;
	}
	damage = COMBAT_D->fight(me, opponent, skill,
		actions[random(sizeof(actions))], weapon);

	if( damage > 0 ) me->improve_skill(skill, 1 + random(me->query_attr("int")));
}

void skill_improved(object me, string sk)
{
	int skill, learn;

	if( !sk ) sk = "pike";

	skill = me->query_skill(sk, 1);
	learn = me->query_learn(sk, 1);

	if( (skill<100) && (skill+1) * (skill+1) * 100 < learn ) {
		me->advance_skill(sk, 1);
		me->gain_score("martial art", (skill+1) * 10 );
	}
}
