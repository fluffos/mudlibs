// dodge.c

inherit SKILL;

string *dodge_msg = ({
	"但是和$p$l偏了几寸　\n",
	"但是被$p机灵地躲开了　\n",
	"但是$n身子一侧，闪了开去　\n",
	"但是被$p及时避开　\n",
	"但是$n已有准备，不慌不忙的躲开　\n",
});

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("dodge");
	setup();
}

string dodge_using(object me, object target)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

void skill_improved(object me)
{
        int skill, learn;

        skill = me->query_skill("dodge", 1);
        learn = me->query_learn("dodge", 1);

        if( (skill<70) && (skill+1) * (skill+1) * 100 < learn ) {
                me->advance_skill("dodge", 1);
                me->gain_score("martial art", (skill+1) * 10 );
        }
}
