// staff.c

#include <ansi.h>

inherit SKILL;

mapping *actions = ({
    ([  "action": 		"$N将手中$w往$n$l挥了过去",
        "damage_type":  "瘀伤",
	]),
    ([  "action": 		"$N将$w一扬，「呼」地一声便往$n$ll敲下",
        "damage_type":  "瘀伤",
	]),
    ([  "action": 		"$N横过$w，用杖头击向$n$l",
        "damage_type":  "瘀伤",
	]),
});

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("staff");
	setup();
}
void attack_using(object me, object opponent, object weapon)
{
	int damage;

	if( !opponent ) {
		if( me->query_temp("last_attacked_target")) 
			message_vision(CYN "$N伺机而动 ...　\n" NOR, me);
		return;
	}

	damage = COMBAT_D->fight(me, opponent, "staff", actions[random(sizeof(actions))],weapon);
	if( damage > 0 ) me->improve_skill("staff", 1 + random(me->query_attr("int")));
}

void skill_improved(object me)
{
	int skill, learn;

	skill = me->query_skill("staff", 1);
	learn = me->query_learn("staff", 1);

	if( (skill<70) && (skill+1) * (skill+1) * 100 < learn ) {
		me->advance_skill("staff", 1);
		me->gain_score("martial art", (skill+1) * 10 );
	}
}
