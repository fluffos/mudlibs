// axe.c

#include <ansi.h>

inherit SKILL;

mapping *actions = ({
	([  "action":		"$N$w一挥，使劲往$n$l劈了过去",
		"damage_type":	"　伤",
	]),
	([  "action":		"$N挥舞手中的$w，顺势往$n$l砍落",
		"damage_type":	"　伤",
	]),
	([  "action":		"$N将手中$w一横，对准$n$l「呼」地一声扫了过去",
		"damage_type":	"　伤",
	]),
	([  "action":		"$N扬起$w，往$n$l奋力一斩",
		"damage_type":	"割伤",
	]),
	([  "action":		"$N挥动$w，对准$n$l一斧劈了过去",
		"damage_type":	"　伤",
	]),
});

string *interattack = ({
        "$N紧握著手中的$n，伺机而动　\n",
});

void create()
{
	seteuid(getuid());
	DAEMON_D->register_skill_daemon("axe");
	DAEMON_D->register_skill_daemon("secondhand axe");
	DAEMON_D->register_skill_daemon("twohanded axe");
	setup();
}

void attack_using(object me, object opponent, object weapon)
{
	int damage;
	string skill;

	if( !sscanf(weapon->query("equipped"), "weapon/%s", skill) )
		return;

	if( !opponent ) {
		if( me->query_temp("last_attacked_target"))
			message_vision(CYN + interattack[random(sizeof(interattack))] + NOR,
				me, weapon);
		return;
	}
	damage = COMBAT_D->fight(me, opponent, skill,
		actions[random(sizeof(actions))], weapon);
	
	if( damage > 0 ) me->improve_skill(skill, 1 + random(me->query_attr("int")));
}

void skill_improved(object me, string sk)
{
	int skill, learn;

	if( !sk ) sk = "axe";

	skill = me->query_skill(sk, 1);
	learn = me->query_learn(sk, 1);

	if( (skill<80) && (skill+1) * (skill+1) * 100 < learn ) {
		me->advance_skill(sk, 1);
		me->gain_score("martial art", (skill+1) * 10 );
	}
}
