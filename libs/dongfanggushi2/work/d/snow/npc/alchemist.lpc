// alchemist.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("陈维侠", ({ "chen weisha", "weisha", "chen" }));
	set("nickname", "牙山居士");
	set_attr("dex", 18);
	set_attr("int", 24);
	set_attr("wis", 25);
	set_attr("spi", 22);
	set_attr("cps", 19);
	set_attr("con", 20);
	set_race("human");
	set_level(25);
	set_class("alchemist");
	set_skill("unarmed", 60);
	set_skill("sword", 60);
	set_skill("parry", 80);
	set_skill("dodge", 70);
	set_skill("alchemy-medication", 140);
	set_skill("alchemy-wealth", 40);
	set_skill("alchemy-magic", 80);
	set_skill("alchemy-immortality", 30);
	set("age", 55);
	set("long",
		"陈维侠是个著名的方士，经常来往於天邪国与乔阴县之间采药及寻觅\n"
		"珍奇矿物，他和雪亭镇的王员外是旧日同窗，这几日原本要往野羊山\n"
		"采药，但是因为盗贼肆虐所以暂时在王员外家盘桓数日　\n"
		"陈维侠本名陈度，维侠是他的学生们送给他的称号，意思是说他相当\n"
		"有侠气，喜欢打抱不平，若不是给王员外的独子缠住了讲养生之术，\n"
		"只怕早几日前就上野羊山铲除盗匪去了　\n");
	setup();
	carry_object(__DIR__"obj/silversword")->wield();
	carry_object("/obj/cloth")->wear();
}

void set_flag(object me)
{
	if( present(me, environment()) ) {
		if( me->query_class() != "commoner" ) return;
		me->set_temp("pending/alchemist", 1);
	}
	else
		do_chat("陈维侠说道：嘿 ... 人都走了，我这老头还在自言自语 ...　\n");
}

int accept_apprentice(object me)
{
	if( is_chatting() ) return 0;
	if( me->query_temp("pending/alchemist") ) return 1;
	do_chat(({
		"陈维侠说道：拜我为师？呵呵 ... 我可不是什麽武林高手呀　\n",
		"陈维侠望著屋外出了会神，说道：我只是个喜欢炼丹采药　打抱不平的老头儿　\n",
		"陈维侠忽然笑了起来，说道：「炼丹采药　打抱不平」... 哈哈哈...　\n",
		"陈维侠说道：我看你这年轻人倒还顺眼，如果你不怕做些烧火采药的粗活 ...\n",
		"陈维侠说道：老夫门徒不下千人，便多你一个也不妨　\n",
		(: set_flag, me :)
	}));
	return 0;
}

int init_apprentice(object me)
{
	if( ::init_apprentice(me) ) {
		me->set_class("alchemist");
		do_chat(({
			"陈维侠点了点头，说道：你虽然入我门下，但是得先烧火采药十年　\n",
			"陈维侠说道：十年之後，如果为师看你还堪造就，这才传你丹术　\n",
			"陈维侠摆\了摆\手，说道：好了，你先下去吧　\n"
		}));
	}
}

int acquire_skill(object ob, string skill)
{
	switch(skill) {
	case "alchemy-medication":
	case "alchemy-wealth":
	case "alchemy-magic":
	case "alchemy-immortality":
	default:
	}
	return 0;
}
