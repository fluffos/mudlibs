// innkeeper.c

#include <localtime.h>
#include <npc.h>

inherit F_VILLAGER;

void open_inn();
void close_inn();

int on_business = 0;

void create()
{
	mapping gt;

	set_name("掌柜", ({ "innkeeper", "keeper" }) );
	set_race("human");
	set_level(4);

	set("age", 52);
	set("long", "这位便是这家客栈的掌柜，看起来福福泰泰像是个老好人　\n");
	set("schedule", ([
		700: (: open_inn :),
		2200: (: close_inn :),
	]));
	setup();
	carry_money("coin", 160);

	gt = NATURE_D->game_time(1);
	if( gt[LT_HOUR] < 7 || gt[LT_HOUR] > 22 ) on_business = 0;
	else on_business = 1;
}

void init()
{
	::init();
	if( !is_fighting() )
		do_chat( (: command, "say 欢迎！欢迎！请里面坐！" :) );
}

void relay_emote(object from_ob, string verb)
{
	command("smile");
}

int accept_fight(object player)
{
	do_chat((: command, "say 这位" + player->rank("respectful")
	 + "真爱开玩笑，小老儿还要做生意呢　\n":));
	return 0;
}

void accept_kill(object player)
{
	object ob;

	if( is_fighting() ) return;

	command("emote 大叫：杀人哪，救命哪！");
	ob = present("garrison");
	if( !ob ) {
		ob = new(__DIR__"patrol");
		ob->move(environment());
		tell_room(environment(), "巡逻官兵听到叫声，跑了过来　\n");
	}

	ob->protect(this_object());
	ob->kill_ob(player);
}

void open_inn()
{
	command("emote 打了个呵欠，说道：睡的真好，开店做生意吧　");
	environment()->open_door("east");
	environment()->open_door("west");
	environment()->set("no_fight", 1);
}

void close_inn()
{
	object ob;

	command("say 嗯.. 二更了，打烊吧，各位客倌明日请早　");
	command("emote 将你送出客栈　");
	environment()->close_door("east");
	environment()->close_door("west");
	environment()->set("no_fight", 0);
	foreach(ob in all_inventory(environment()) ) {
		if( ob==this_object()
		||	!ob->is_character()
		||	ob->id("snow_inn_waiter") ) continue;
		ob->move(environment()->query("exits/east"));
	}
}
