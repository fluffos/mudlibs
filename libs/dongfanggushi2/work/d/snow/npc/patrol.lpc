// patrol_garrison.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("巡逻官兵", ({ "patrol garrison", "patrol", "garrison" }) );
	set_race("human");
	set_class("fighter");
	set_level(15);
	set_skill("sword", 60);
	set_skill("parry", 60);
	set_stat_maximum("gin", 150);
	set_stat_maximum("kee", 150);

	set("pursuer", 1);
	set("long",
		"一位负责维护地方治安的官兵，他们受过相当的训练，有时候\n"
		"也加入军队作战　\n");
	set("vendetta_mark", "authority");
	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	// Wiled the sword when protecting someone. (Just for cool :P)
	carry_object(__DIR__"obj/broadsword");
}


int accept_fight(object ob)
{
	do_chat((: command, "emote 瞪了瞪眼，说道：滚开滚开！少在这里罗唆！":));
	return 0;
}

void protect(object ob)
{
	command("emote 大喝：反了反了！光天化日之下竟敢杀人逞凶？纳命来！");
	command("wield sword");
	guard_ob(ob);
}
