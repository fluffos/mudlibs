// herbalist.c

#include <npc.h>

inherit F_VILLAGER;
inherit F_VENDOR;

void create()
{
	set_name("药铺掌柜", ({"herbalist"}));
	set_race("human");
	set_class("alchemist");
	set_level(3);
	set_skill("unarmed", 5);
	set_skill("parry", 5);
	set_skill("dodge", 5);
	set_skill("dagger", 5);

	set("age", 44);
	set("long",
		"药铺掌柜的是位胖胖的中年男子，虽然年纪有四五十岁了，不过看起\n"
		"来依然红光满面　精神焕发，你可以用 list 问他店里有哪些药　\n");

	set("merchandise", ([
		"/obj/drug/black_pill": 50,
		"/obj/drug/boar_berry": 40,
		"/obj/drug/wild_ginseng": 30,
		"/obj/drug/dragon_saliva": 20,
	]));

	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/fur_hat")->wear();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
}
