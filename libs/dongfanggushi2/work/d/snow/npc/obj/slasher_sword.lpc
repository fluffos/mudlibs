// slasher_sword.c

#include <weapon.h>

inherit F_SWORD;

void create() {
  set_name("绕指柔剑", ({ "slasher sword", "sword" }));
  set_weight(3000);
  setup_sword(1, 23, 20, 6);

  if (!clonep()) {
    set("wield_as", "sword");
    set("unit", "把");
    set("value", 26000);
    set("long",
      "一把又细又长的剑，拿在手上剑刃就不断抖动，看来要使用这把剑得要\n"
      "相当敏捷的身手才不会误伤自己　\n");
    set("rigidity", 70);
    set("apply_weapon/sword", ([
      "dex": 2,
      "parry": 5
    ]));
  }
  setup();
}
