// broadsword.c

#include <weapon.h>

inherit F_SWORD;
inherit F_BLADE;

void create()
{
	set_name("双股剑", ({ "broadsword", "sword" }) );
	set_weight(7000);
	setup_sword(3, 8, 60, 0);
	setup_blade(2, 13, 80, 0);

	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("wield_as", ({ "twohanded sword", "twohanded blade" }));
		set("unit", "把");
		set("value", 4000);
		set("rigidity", 25);
		set("long", "一把精钢铸成的双股铁剑，这是官府军士常用的武器　\n");
	}
	setup();
}
