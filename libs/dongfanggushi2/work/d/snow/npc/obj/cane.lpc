// cane.c

#include <weapon.h>

inherit F_STAFF;

void create()
{
	set_name("拐杖", ({ "cane" }) );
	set_weight(2400);
	setup_staff(4, 4, 70, 3);

	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("wield_as", "staff");
		set("unit", "根");
		set("value", 600);
		set("rigidity", 12);
		set("long",
			"一根硬木拐杖，因为经年使用而显得光滑　\n");
	}
	setup();
}
