// smock.c

#include <armor.h>

inherit F_ARMOR;

void create()
{
	set_name("打铁褂子", ({ "work smock", "smock" }) );
	set_weight(5500);
	setup_armor();

	if( !clonep() ) {
		set("unit", "件");
		set("value", 720);
		set("long", "这是一件铁匠工作时用来遮挡火星飞溅的工作服　\n");
		set("wear_as", "armor");
		set("apply_armor/armor", ([
			"armor": 2,
			"armor_vs_fire": 5,
		]));
	}

	setup();
}
