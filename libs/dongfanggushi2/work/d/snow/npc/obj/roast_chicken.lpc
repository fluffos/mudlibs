// roast_chicken.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("红烧鸡", ({ "roast chicken", "chicken" }) );
	set_weight(1500);
	if( !clonep() ) {
		set("unit", "只");
		set("value", 800);
		set("food_stuff", 190);
		set("heal_kee", 30);
		set("long", "一只香喷喷的红烧鸡，哇，你的口水都快流出来了　\n");
	}
	setup();
}

