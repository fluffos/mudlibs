// syndicator.c

#include <weapon.h>

inherit F_DAGGER;

void create()
{
	set_name("「尺娘」", ({ "syndicator" }));
	set_weight(3000);
	setup_dagger(1, 20, 30, 5);

	if( !clonep() ) {
		set("wield_as", ({ "dagger", "secondhand dagger" }));
		set("unit", "把");
		set("value", 500);
		set("rigidity", 40);
		set("long",
			"这是一把长约四寸的匕首，刃上用精细的雕工镂空出一个美貌\n"
			"女子的脸，奇特的是这女子的表情像是伸出舌头在舔嘴边的血\n"
			"迹，匕首的柄奇短，只能用两只手指捏住　\n");
		set("apply_weapon/dagger", ([
			"str" : 1,
			"cor" : 1,
			"attack" : 10,
		]));
		set("apply_weapon/secondhand dagger", ([
			"str" : 1,
			"cor" : 1,
			"attack" : 10,
		]));
	}
	setup();
}

