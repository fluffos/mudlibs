// wagon.c

inherit ITEM;

void create()
{
	set_name("运货驴车", ({ "wagon" }));
	set_max_encumbrance(1000000);
	set("no_get", 1);
	set("long", "一辆运货的四轮驴车，停在这里等著载货(load)　\n");
}

void init()
{
	add_action("do_load", "load");
}

int do_load(string arg)
{
	object ob;

	if( !arg ) return 0;

	if( !sscanf(arg, "wagon with %s", arg)
	&&	!sscanf(arg, "%s into wagon", arg) )
		return 0;

	ob = present(arg, this_player());
	if( !ob ) return notify_fail("你要把什麽装上货车？\n");

	message_vision("$N把$n装上运货驴车　\n", this_player(), ob);
	ob->move(this_object());
	this_player()->add_temp("wage_deserved", ob->query("wage"));

	if( sizeof(all_inventory()) >= 20 ) {
		say("赶驴车的车夫鞭子一扬，赶著驴车送货去了　\n");
		destruct(this_object());
	}

	return 1;
}

// To prevent player from getting things in wagon.
int hold_object(object ob)
{
	notify_fail("什麽？\n");
	return 1;
}
