// leather_armor.c

#include <armor.h>

inherit F_ARMOR;

void create() {
  set_name("硬皮甲胄", ({ "leather armor", "armor" }));
  set_weight(10000);
  setup_armor();

  if (!clonep()) {
    set("unit", "件");
    set("long",
      "一件用牛皮浆硬缝合，用来保护身体的甲胄，虽然防护效果比不上\n"
      "金属制成的铠甲，但是轻便便宜也是这类皮制甲胄的优点　\n");
    set("value", 1400);
    set("wear_as", "armor");
    set("apply_armor/armor", ([
      "armor": 6
    ]));
  }
  setup();
}
