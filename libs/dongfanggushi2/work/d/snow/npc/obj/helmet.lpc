// helmet.c

#include <armor.h>

inherit F_HEAD_EQ;

void create() {
  set_name("铜盔", ({ "brass helmet", "helmet" }));
  set_weight(4000);
  setup_head_eq();

  if (!clonep()) {
    set("unit", "顶");
    set("long", "这是一顶铜制的头盔，属於军队中的低级武官顶戴　\n");
    set("value", 900);
    set("wear_as", "head_eq");
    set("apply_armor/head_eq", ([
      "armor": 3,
      "dodge": -3,
    ]));
  }
  setup();
}
