// Room: /d/snow/square.c

inherit ROOM;

void create() {
  set("short", "广场中央");
  set("long", @LONG
这里是雪亭镇广场的中央，一株巨大的老榕树盘根错结地站在中央
，一些孩童常常爬上这株老榕嬉戏，榕树下七横八竖地放著几张长凳供
人歇息聊天，树旁还有一个水缸供路人取水解渴　
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/pot": 1,
    __DIR__ "npc/gammer": 1,
    __DIR__ "npc/junkman": 1,
  ]));
  set("detail", ([ /* sizeof() == 2 */
    "榕树": "这株榕树少说也有两三百岁了，一条条长长的须根几乎垂到地面，
树干因为经常被人抚摸而显得光滑　
",
    "长凳": "十分普通常见的长凳，如果你累了，不必客气，尽管做下来休息　
",
  ]));
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "square_e",
    "north": __DIR__ "square_n",
    "west": __DIR__ "square_w",
    "south": __DIR__ "square_s",
  ]));

  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg != "榕树") return 0;

  message_vision("$N攀著榕树的树干爬了上去　\n", this_player());
  if (this_player()->move(__DIR__ "tree"))
    message("vision", this_player()->name() + "从树下爬了上来　\n",
      environment(this_player()), this_player());
  return 1;
}
