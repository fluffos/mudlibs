// brigand.c

#include <npc.h>

inherit F_BANDIT;

void create() {
  set_name("野羊山盗匪", ({ "brigand" }));
  set_race("human");
  set_class("fighter");
  set_level(14);
  set_skill("blade", 50);
  set_skill("dodge", 35);
  set_skill("parry", 30);
  set("age", 31);
  set("long",
    "看这个人的模样，八成就是恶名昭彰的野羊山盗匪了，你最好小心\n"
    "一点　\n");
  setup();
  carry_object(__DIR__ "obj/blade")->wield();
  carry_object(__DIR__ "obj/fur_vest")->wear();
  carry_object(__DIR__ "obj/fur_boot")->wear();
  carry_object(__DIR__ "obj/girth")->wear();
  carry_money("silver", 3);
}
