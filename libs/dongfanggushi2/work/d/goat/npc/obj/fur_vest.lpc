// fur_vest.c

#include <armor.h>

inherit F_CLOTH;
inherit F_ARMOR;

void create()
{
	set_name("羊皮背心", ({ "fur vest", "vest" }));
	set_weight(2500);
	setup_cloth();
	setup_armor();
	if( !clonep() ) {
		set("unit", "件");
		set("long", "一件山羊皮背心，用几条牛皮细绳缝制而成　\n");
		set("value", 400);
		set("wear_as", ({ "cloth", "armor" }));
		set("apply_armor/cloth/armor", 1);
		set("apply_armor/armor/armor", 1);
	}
	setup();
}
