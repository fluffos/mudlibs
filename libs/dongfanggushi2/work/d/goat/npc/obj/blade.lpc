// blade.c

#include <weapon.h>

inherit F_BLADE;

void create()
{
	set_name("单刀", ({ "blade" }) );
	set_weight(6000);
	setup_blade(1, 21, 60, 0);

	if( !clonep() ) {
		set("wield_as", "blade");
		set("unit", "把");
		set("value",900);
		set("long", "一把常见的单刀，是刀类武器中最普通的一种　\n");
		set("rigidity", 17);
	}
	setup();
}
