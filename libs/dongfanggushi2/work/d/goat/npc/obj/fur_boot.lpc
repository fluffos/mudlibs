// fur_boot.c

#include <armor.h>

inherit F_FEET_EQ;

void create()
{
	set_name("羊皮靴", ({ "fur boots", "boots" }));
	set_weight(1000);
	setup_feet_eq();

	if( !clonep() ) {
		set("unit", "双");
		set("long", "一双羊皮缝制的靴子，手工颇为粗陋　\n");
		set("value", 1000);
		set("wear_as", "feet_eq");
		set("apply_armor/feet_eq/armor", 1);
	}
	setup();	
}