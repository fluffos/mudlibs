// Room: /d/hell/death_start.c

#include <statistic.h>

inherit ROOM;

void create()
{
	set("short", "黄泉路");
	set("long", @LONG
这里就是人死之後魂归地府必经的黄泉之路，放眼四周都是不见尽
头的浓雾，只有你的脚下( 咦？你看不到自己的脚！ )一条缓缓流动的
黄沙河，看来如果你不沿著这条黄泉前进的话一定会迷失在雾中的　
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"downstream" : this_object(),
		"upstream" : this_object(),
	]));
	set("valid_startroom", 1);
	setup();
}

void init()
{
	if( this_player()->query("life_form") == "ghost" ) {
		seteuid(geteuid(this_player()));
		// Welcome to the hell, let ghost take a break.
		this_player()->set_stat_regenerate("gin", TYPE_HEALTH);
		this_player()->set_stat_regenerate("sen", TYPE_HEALTH);
		call_out("deliver_ghost", 20, this_player());
	}
}

void deliver_ghost(object ob)
{
	if( !ob || environment(ob) != this_object() ) return;
	tell_object(ob, "不知道什麽时候你的面前出现了一座桥，而脚下的黄沙河也消失了　\n");
	ob->move(__DIR__"ninh1");
}

