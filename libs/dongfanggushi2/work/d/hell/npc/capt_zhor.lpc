// capt_zhor.c

#include <npc.h>

void create() {
  set_name("左国益", ({ "captain zhor", "zhor", "captain" }));
  set("title", "地气塔守将");
  set_race("human");
  set_class("fighter");
  set_attr("str", 22);
  set_attr("con", 21);
  set_attr("dex", 22);
  set_level(44);
  set_skill("twohanded axe", 100);
  set_skill("parry", 90);
  set_skill("dodge", 90);
  set("long",
    "左国益是地气塔塔顶的守卫主将，他身长九尺，站在你面前有如铁塔\n"
    "一般，让人望而生畏，即使是已经死了的人也不敢轻易惹他　\n");
  setup();
  carry_object(__DIR__ "obj/grandaxe")->wield();
  carry_object(__DIR__ "obj/irontorso")->wear();
  carry_object(__DIR__ "obj/ironhelm")->wear();
  carry_object(__DIR__ "obj/bloodcloth")->wear();
}
