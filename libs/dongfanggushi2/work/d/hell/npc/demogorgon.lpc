// demogorgon.c

#include <npc.h>

void create()
{
	set_name("黑袍怪人", ({"black figure", "figure"}));
	set_race("human");
	set_class("fighter");
	set_attr("str", 32);
	set_attr("dex", 30);
	set_attr("cor", 33);
	set_attr("cps", 39);
	set_attr("int", 35);
	set_attr("spi", 48);
	set_attr("wis", 39);
	set_attr("con", 28);
	set_level(90);
	advance_stat("gin", 300);
	advance_stat("kee", 200);
	advance_stat("sen", 500);
	set_skill("unarmed", 190);
	set_skill("blade", 200);
	set_skill("dodge", 120);
	set_skill("parry", 150);
	set("long",
		"一个身穿黑袍的怪人　只露出像是木雕面具的半张脸　看不出喜怒哀乐\n"
		"　站在他的面前你有一种说不出的紧张　似乎这个人能够洞悉你的一切\n"
		"　但是你永远连他的真面目也看不到　\n");
	setup();
	carry_object(__DIR__"obj/black_spark")->wield();
}

void enable_trade(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	ob->set_temp("pending/trade_karma", 1);
}

void init()
{
	if( !this_player() || is_fighting() || is_chatting() ) return;
	if( !this_player()->link() ) return;
	if( this_player()->link()->query("karma") < 10 ) return;
	do_chat(({
		"黑袍怪人轻轻地「咳」了一声　\n\n", 1, 1, 1,
		"黑袍怪人说道　又是一个可怜的家伙 ... 你赶著去投胎吗　\n\n", 1, 
		"黑袍怪人的声音空空洞洞的　自顾自地说下去　\n\n",
		"黑袍怪人说道　生　老　病　死 ...  嘿嘿嘿嘿 ... 真痛苦啊　\n\n", 1, 1, 1,
		"黑袍怪人轻轻地叹了口气　说道　跟十几万年的黑暗比起来 ... 哈哈哈哈哈哈哈　\n\n",
		"黑袍怪人乾笑了几声　忽然转过身来　你虽然看不到他的眼睛　但是你知道\n"
		"他正盯著你看　\n\n", 1, 1, 1, 1,
		"黑袍怪人说道　好吧　我有你想要的　你有我想要的　来个交易如何　\n\n",
		(: enable_trade, this_player() :)
	}));
}

void trade_karma(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if( !ob->link() ) return;
	seteuid(geteuid(ob));
	ob->link()->add("karma", -10);
	ob->set("life_preservation", 3);
	seteuid(getuid());
}

void relay_say(object ob, string msg)
{
	if( !ob->query_temp("pending/trade_karma") ) return;
	if( strsrch(msg, "交易") >= 0) {
		command("hmm");
		command("say 我只要你一句话　「好」还是「不好」　");
		return;
	}
	else if( strsrch(msg, "黑暗") >= 0 ) {
		command("say ... 有些事情你还是不知道比较好 ...");
		return;		
	}
	else if( strsrch(msg, "不") >= 0 ) {
		command("nod");
		command("say 那也由得你 ...");
		ob->delete_temp("pending/trade_karma");
		return;
	}
	else if( strsrch(msg, "好") >= 0 ) {
		command("nod");
		command("say 看来你很了解你的处境　反正你也没什麽可以损失，除了 ... 嘿嘿　\n\n");
		ob->delete_temp("pending/trade_karma");
		do_chat(({
			"黑袍怪人顿了一顿　缓缓地摘下他的面具 ...\n\n",
			"你看到黑袍怪人的面具後面 .... 竟然空无一物！难道他是隐形的？\n\n", 1, 1,
			"黑袍怪人又乾笑了起来　虽然你看不到他的脸　但是这次的笑声似乎清楚\n"
			"多了 ....\n\n", 1, 1, 1,
			"黑袍怪人举起手来　发出一阵短促的奇怪音节　但是什麽事也没有发生 ...\n\n",
			(: trade_karma, ob :),
			"黑袍怪人点了点头　又将面具戴了回去 ...\n\n",
			"黑袍怪人说道　很好　就像这样　你可以走了 ...\n\n",
			"(看样子黑袍怪人已经完成了他所说的「交易」　但是你　没有觉得什麽变化)\n\n"
		}));
		return;
	}
}

int accept_fight(object ob)
{
	command("say 我不想打架　就算打架也不会找你当对手　");
	return 0;
}

void real_fight(object ob)
{
	if( !ob ) return;
	if( environment(ob)==environment() ) {
		command("grin");
		map_skill("unarmed", "unarmed");
		command("charge " + ob->query("id"));
	}
}

void accept_kill(object ob)
{
	map_skill("unarmed", "none");
	do_chat(({
		"黑袍怪人说道　.... 真是愚蠢的家伙　\n",
		"黑袍怪人说道　这样吧　我数到三让你逃跑 ...\n",
		"黑袍怪人说道　一 ...\n",
		"黑袍怪人说道　二 ...\n",
		"黑袍怪人说道　三　\n",
		(: real_fight, ob :)
	}));
}
