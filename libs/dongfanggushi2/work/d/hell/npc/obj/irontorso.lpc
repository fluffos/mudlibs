// irontorso.c

#include <armor.h>

inherit F_ARMOR;

void create()
{
	set_name("镔铁胸铠", ({ "iron torso", "torso" }));
	set_weight(25500);
	setup_armor();

	if( !clonep() ) {
		set("unit", "件");
		set("value", 20000);
		set("long", "这件胸铠上面缀了许\多镔铁锁片，从胸至腰　\n");
		set("wear_as", "armor");
		set("apply_armor/armor", ([
			"armor": 12,
			"armor_vs_fire": 5,
			"dodge": -20,
		]));
	}

	setup();
}
