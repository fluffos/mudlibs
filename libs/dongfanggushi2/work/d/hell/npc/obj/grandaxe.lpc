// grandaxe.c

#include <weapon.h>

inherit F_AXE;

void create()
{
	set_name("十石大斧", ({ "grandaxe", "axe" }));
	set_weight(27000);
	setup_axe(4, 8, 90, 4);

	if( !clonep() ) {
		set("wield_as", ({ "twohanded axe" }));
		set("unit", "柄");
		set("value", 30000);
		set("rigidity", 24);
		set("long", "这是一种非常沈重的战斧，斧刃中间还装有尖刺　\n");
	}
	setup();
}
