// ironfork.c

#include <weapon.h>

inherit F_PIKE;

void create()
{
	set_name("镔铁叉", ({ "iron fork", "fork" }) );
	set_weight(12000);
	setup_pike(2, 14, 70, 0);

	if( !clonep() ) {
		set("wield_as", ({ "pike" }));
		set("unit", "把");
		set("value", 10700);
		set("rigidity", 26);
		set("long", "一把又长又重的镔铁叉，尖刺约有二尺来长　\n");
	}
	setup();
}
