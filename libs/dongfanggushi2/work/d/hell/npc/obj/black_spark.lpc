// black_spark.c

#include <weapon.h>

inherit F_BLADE;
inherit F_UNIQUE;

void create()
{
	set_name("离·玄·光·炽", ({ "black spark", "spark" }));
	set_weight(5000);
	setup_blade(3, 16, 0, 8);

	if( !clonep() ) {
		set("wield_as", "blade" );
		set("unit", "把");
		set("value", 4000);
		set("rigidity", 99);
		set("long", "一把纯白的长刀　发著柔和的微光　\n");
		set("apply_weapon/blade", ([
			"attack" : 50,
			"defense" : 50,
		]));
	}
	setup();
}
