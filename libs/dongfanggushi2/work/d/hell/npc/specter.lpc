// specter.c

#include <npc.h>

void create() {
  set_name("宣鬼婆", ({ "specter crone", "specter", "crone" }));
  set_race("human");
  set_class("taoist");
  set_attr("str", 17);
  set_attr("con", 21);
  set_attr("dex", 18);
  set_attr("wis", 20);
  set_level(25);
  set_skill("parry", 55);
  set_skill("dodge", 55);
  set_skill("unarmed", 70);
  set_skill("taoism-fire", 65);
  set_skill("spells", 60);
  set("life_form", "ghost");
  set("gender", "female");
  set("age", 99);
  set("long",
    "一个满脸皱纹的老太婆，一双眼睛却又红又肿　\n");
  set("chat_chance", 10);
  set("chat_msg", ({
    "宣鬼婆说道：快 ... 快进去 ... 呼 .. 呵呵 ... 快进去吧 ...\n",
    "宣鬼婆说道：真好 ... 哈 .. 嗯 ... 真是 ... 好呀 ...\n",
    "宣鬼婆对著你比手画脚，口中念念有词　\n",
  }));
  setup();
}
