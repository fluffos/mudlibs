// bonze.c

#include <npc.h>

void create()
{
	set_name("普华上人", ({ "puhwa bonze", "puhwa", "bonze" }));
	set_race("human");
	set_level(5);
	set("life_form", "ghost");
	set("age", 62);
	set("long",
		"一个年约六十几岁的老僧，笑容可鞠地看著你　\n");
	setup();
}

void init()
{
	if( this_player()->query("life_form") != "ghost" ) return;
	if( this_player()->query("life_preservation") )
		do_chat(({
			"普华上人「咦」地一声　说道　你看起来不像是寿终之人　怎麽能进鬼门关　\n",
			"普华上人说道　快回阳间吧　别让人把你的　骨给埋了　不然你就得在枉死城待好一阵子　\n"
		}));
}

void relay_say(object ob, string msg)
{
	if( strsrch(msg, "阳间") >= 0 ) {
		command("say 往阳间的路 ... 地气塔往北直走　对了　千万不可回头 ...");
		return;
	}
	else if( strsrch(msg, "枉死城") >= 0 ) {
		command("sigh");
		command("say 枉死城比起地狱也差不了多少 ... 能不去就别去吧　");
		return;
	}
}