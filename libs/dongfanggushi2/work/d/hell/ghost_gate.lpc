// Room: /d/hell/ghost_gate.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "鬼门关");
	set("long", @LONG
这里就是鬼门关了，高大坚实的城楼像鬼魅一般矗立在你面前，後
面是阴暗无云的天空，给你一种绝望的感觉，六　七丈高的城门紧紧地
关闭著，只有每年的七月才会开放一个月，平时是只准进不准出的　你
的南边一条飘著血腥恶臭的大河围绕著鬼城，河上一座石桥，桥边的石
碑上写著奈何桥　
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"north" : __DIR__"city1",
		"south" : __DIR__"ninh1",
	]));
	set("objects", ([
		__DIR__"npc/hell_guard": 2,
		__DIR__"npc/specter": 1,
	]));

	setup();
	create_door("north", "城门", "south", DOOR_CLOSED|DOOR_LOCKED);
}

void init()
{
	add_action("do_go", "go");
}

int do_go(string arg)
{
	if( arg != "north" || this_player()->query("life_form") != "ghost")
		return 0;
	message_vision("$N往北走去，直接穿透厚重的城门进入了鬼城　\n",
		this_player());
	this_player()->move(__DIR__"city1");
	return 1;
}
