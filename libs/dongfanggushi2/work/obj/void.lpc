// void.c

#include <login.h>

inherit ROOM;

string out_path() {
  string from;

  if (this_player()
    && stringp(from = this_player()->query_temp("last_location")))
    return from;

  return START_ROOM;
}

void create() {
  set("short", "最後乐园");
  set("long",
    "恭喜您来到这个世界的第一个房间！这里也是在您或某人搞砸了\n"
    "某样东西之後，用来当作避难所的地方　如果您是正在　试架设一个\n"
    "使用 es2 mudlib 为基础的 MUD，请参考 /doc/admin/README，如果\n"
    "您是无辜的玩家，请打 'out' 离开　\n");
  set("exits", ([
    "out": (: out_path :)
  ]));
  seteuid(getuid());
  catch(load_object("/daemon/board/bugs"));
}
