// dust.c

inherit COMBINED_ITEM;

void create()
{
	set_name("化　粉", ({"dust"}));
	set("long",
		"这是一包用来毁　灭迹的化　粉，只要洒一丁点就可以\n"
		"化去(dissolve)一具　体！\n");
	set("unit", "包");
	set("base_unit", "份");
	set("base_weight", 1);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_dissolve", "dissolve");
}

int do_dissolve(string arg)
{
	object ob;

	if( !arg ) return notify_fail("你要用化　粉溶解什麽东西？\n");
	if( !objectp(ob = present(arg, environment(this_player()))) )
		return notify_fail("这里没有这样东西　\n");
	if( living(ob) || !ob->id("corpse") )
		return notify_fail("化　粉只能用来溶解　体　\n");
	message_vision(
		"$N用指甲挑了一点化　粉在$n上，只听见一阵「嗤嗤」声响带著\n"
		"一股可怕的恶臭，$n只剩下一滩黄水　\n", this_player(), ob);
	destruct(ob);
	add_amount(-1);
	return 1;
}

