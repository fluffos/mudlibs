inherit ROOM;

void create()
{
	set("short","绿岛");
	set("long",@LONG
这里是 ES2 的「离岛」管训所, 如果你被送到这里, 表示:
你违反了游戏规则, 请好好的反省一下你的所作所为, 想离
开的话只要断线超过 15 分钟即可 :-) 
LONG
	);
	setup();
}

void init()
{
	if (!wizardp(this_player()) ) 
	add_action("block_cmd","",1);
	call_out("green", 2, this_player());
}

int block_cmd()
{
	if((string)query_verb() == "look") return 0;
	if((string)query_verb() == "help") return 0;
	return 1;
}

void green()
{
	tell_room(environment(this_player()),"你听到耳边传来绿岛小夜曲的歌声: \n\n"+
		"这绿岛像一只船  在月夜里摇啊摇\n"+
		"姑娘呀你也在我的心海里飘啊飘\n"+
		"让我的歌声随那微风  吹开了你的窗帘\n"+
		"让我的衷情随那流水  不断地向你倾诉\n"+
		"椰子树的长影掩不住我的情意\n"+
		"明媚的月光更照亮了我的心\n"+
		"这绿岛的夜已经这样沉静\n"+
		"姑娘呦～你为什麽还是默默无语\n\n");
	return;
}
