// wild_ginseng.c

inherit COMBINED_ITEM;

void create()
{
	set_name("野山　", ({"wild ginseng", "ginseng"}));
	if( !clonep() ) {
		set("unit", "些");
		set("long",
			"野山　是一种广为人知的补品，对人的精气神都颇有助益，而且\n"
			"没有什麽明显的副作用，通常作为疗伤药的药材，不过偶尔也有\n"
			"人直接服用，但是效果较不显著　\n");
		set("base_unit", "根");
		set("base_value", 1500);
		set("base_weight", 400);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 50 )
		return notify_fail("你的肚子已经撑得什麽东西也吞不下去了　\n");
	message_vision("$N拿出一株野山　放入口中嚼了嚼吞了下去　\n", me);
	me->supplement_stat("food", 50);
	me->heal_stat("gin", 5);
	me->heal_stat("kee", 5);
	me->heal_stat("sen", 5);
	add_amount(-1);

	return 1;
}
