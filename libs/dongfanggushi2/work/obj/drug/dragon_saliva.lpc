// dragon_saliva.c

inherit COMBINED_ITEM;

void create() {
  set_name("龙涎草", ({ "dragon-saliva herb", "dragon-saliva", "herb" }));
  if (!clonep()) {
    set("unit", "些");
    set("long",
      "龙涎草是一种相当名贵的疗伤药，一般人是不太买得起这种药材的，\n"
      "龙涎草经常被方士们用於炼制一些珍贵的丹药，但是直接服食这种草\n"
      "药也有些许\的疗伤效果，只不过有些浪费罢了　\n");
    set("base_unit", "株");
    set("base_value", 5000);
    set("base_weight", 7);
  }
  set_amount(1);
  setup();
}

int stuff_ob(object me) {
  if (me->query_stat_maximum("food") - me->query_stat("food") < 10)
    return notify_fail("你的肚子已经撑得什麽东西也吞不下去了　\n");
  message_vision("$N拿出一株龙涎草放入口中嚼了嚼吞了下去　\n", me);
  me->consume_stat("water", 10);
  me->supplement_stat("food", 10);
  me->damage_stat("sen", 1);
  me->heal_stat("kee", 30);
  add_amount(-1);

  return 1;
}
