// black_pill.c

inherit COMBINED_ITEM;

void create()
{
	set_name("乌心丹", ({"black pill", "pill"}));
	if( !clonep() ) {
		set("unit", "些");
		set("long",
			"乌心丹是一种民间很普遍的药方，用来恢复因操练　工作所耗的体力\n"
			"有不错的效果，缺点是吃了以後会昏昏沈沈想睡觉，且容易口渴　\n");
		set("base_unit", "粒");
		set("base_value", 80);
		set("base_weight", 5);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 5 )
		return notify_fail("你的肚子已经撑得连这粒药丸也吞不下去了　\n");
	message_vision("$N吞下一粒黑黑的药丸　\n", me);
	me->consume_stat("water", 30);
	me->supplement_stat("food", 5);
	me->damage_stat("sen", 5);
	me->supplement_stat("gin", 15);
	me->supplement_stat("kee", 15);
	add_amount(-1);

	return 1;
}
