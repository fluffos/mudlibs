// furnace.c

inherit ITEM;

void create() {
  set_name("青铜丹炉", ({ "bronze alchemy furnace", "furnace" }));
  set_weight(20000);  // 20kg weight
  set_max_encumbrance(30000);
  if (!clonep()) {
    set("unit", "个");
    set("long",
      "这是一个青铜所铸成的丹炉　是一般方士炼制单药的器皿　\n");
    set("value", 1000);
  }
  setup();
}

int accept_object(object player, object item) {
  return 1;
}

void init() {
  add_action("do_open", "open");
  add_action("do_close", "close");
}

int do_open(string arg) {}

int do_close(string arg) {}
