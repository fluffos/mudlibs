inherit F_CLEAN_UP;

static mixed *hold;
static int matches;

static int grep_file(string pattern, string file);

int main(object me, string str)
{
	string *files, pattern, list;
	int i;
	
	notify_fail("语法: \n");
	if(sscanf(str, "%s %s", pattern, list) !=2) return 0;
	seteuid(geteuid(this_player(1)));
	hold = ({});
	matches = 0;
	list = resolve_path(me->query("cwd"), list);
	printf(list+"\n");
	files = get_dir(list);	
	
	if(!files || !sizeof(files)) 
		return notify_fail("没有这样的档案.... \n");
	i=sizeof(files);
	while(i--) {
		write(resolve_path(me->query("cwd"),files[i])+"\n");
		grep_file(pattern, files[i]);
	}

	//if(!hold || !sizeof(hold) || hold == ({})) 
	//	write("No Pattern matches found.\n");
	//else printf(hold);
	
	write((string)sizeof(files)+"\n");
	return 1; 
}

static int grep_file(string pattern, string file)
{

	string *lines, *tmp, *diff, dump;
	int j;

	if(file=="." || file=="..") return 1;
	
	dump = read_file(file);

	if(!dump) {
		return notify_fail("找不到: "+file+"\n");
	} 
	
	lines = explode(dump, "\n");
	j = sizeof(lines);
	write("file: "+file+" -line: "+(string)j+"\n");
	while(j--) {
		if(sizeof(regexp( ({lines[j]}), pattern))) {
		printf(lines[j]+"\n");
		}
	}
	return 1;
}
