// replete.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int age;

  if (me->is_fighting())
    return notify_fail("你正在战斗！\n");

  if (me->query_stat("sen") < 20)
    return notify_fail("你的精神太差了　\n");

  message_vision(HIC "$N全身上下发出一阵青气，使得身上的伤口渐渐　合了　\n" NOR, me);
  me->consume_stat("sen", 20);
  age = me->query("age");
  me->heal_stat("gin", random(age) + 1);
  me->heal_stat("kee", random(age) + 1);
  me->heal_stat("sen", random(age) + 1);

  return 1;
}

int help() {
  write(@TEXT
指令格式：replete

无肠之民不食烟火，但是能使唤氤氲让肉体附生，附生的效果受年龄影响　
TEXT
  );
  return 1;
}
