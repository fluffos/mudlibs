// uptime.c

inherit F_CLEAN_UP;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main() {
  seteuid(getuid());
  write("东方故事Ⅱ已经执行了" + CHINESE_D->chinese_period(uptime()) + "　\n");
  printf("现在时间 " + ctime(time()) + "\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : uptime
 
这个指令告诉你东方故事 II 已经连续执行了多久　
及这台机器目前的时间　
 
HELP
  );
  return 1;
}
