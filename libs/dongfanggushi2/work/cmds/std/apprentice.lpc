// apprentice.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (!arg) return notify_fail("你要拜谁为师？\n");

  ob = present(arg, environment(me));
  if (!ob || !ob->is_character()) return notify_fail("这里没有这个人　\n");

  if (ob == me) return notify_fail("拜你自己为师？\n");

  if (me->is_apprentice_of(ob))
    return notify_fail("你已经是" + ob->name() + "的弟子了　\n");

  if (!living(ob))
    return notify_fail(ob->name() + "现在没有办法回答你　\n");

  notify_fail(ob->name() + "似乎没有收你为徒的打算　\n");
  if (!ob->accept_apprentice(me))
    return 0;

  message_vision(CYN "\n$N跪下来恭恭敬敬地向$n磕了四个响头，叫道：师父！\n\n" NOR,
    me, ob);
  ob->init_apprentice(me);

  return 1;
}

int help(object me) {
  write(@Help
指令格式: apprentice <某人>

拜某人当师父, 如果某人已是你(你)师父, 则是向师父请安　
Help
  );
  return 1;
}
