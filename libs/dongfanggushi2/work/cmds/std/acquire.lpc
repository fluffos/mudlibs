// acquire.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string skill, who;
	object ob;

	if( !arg || sscanf(arg, "%s from %s", skill, who)!= 2)
		return notify_fail("指令格式：acquire <技能名称> from <人物>\n");
	if( !objectp(ob = present(who, environment(me))) )
		return notify_fail("这里没有这个人　\n");
	if( !ob->query_skill(skill, 1) )
		return notify_fail(ob->name() + "　不会这种技能　\n");

	// Produce proper message according to relation between player and teacher.
	if( me->is_apprentice_of(ob) )
		message_vision("$N向$n磕头行礼，恭恭敬敬地说道：师父在上，求您传授徒儿"
			+ "「" + to_chinese(skill) + "」！\n",
			me, ob);
	else if( ob->query("age") > me->query("age") )
		message_vision("$N向$n屈膝下拜，说道：晚辈" + me->name() + "，望前辈指点"
			+ me->rank("self") + "「" + to_chinese(skill) + "」！\n",
			me, ob);
	else
		message_vision("$N向$n拱手行礼，说道：请这位" + ob->rank("respectful") 
			+ "指点" + me->rank("self") + "「" + to_chinese(skill) + "」！\n",
			me, ob);

	notify_fail("看起来" + ob->name() + "不想教你这项技能　\n");
	return ob->acquire_skill(me, skill);
}

int help()
{
	write(@TEXT
指令格式：acquire <技能名称> from <人物>

这个指令可以让你向某人「求教」某种技能，不过对方愿不愿意教你，　不是你自己
可以决定的，通常武林人士不会轻易地教你武功，而且有时候即使教你，也不见得会
倾囊相授　
TEXT
	);
	return 1;
}
