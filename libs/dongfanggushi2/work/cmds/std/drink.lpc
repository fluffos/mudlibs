// drink.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (me->is_busy()) return 0;

  notify_fail("你要喝什麽？\n");
  if (!arg || arg == "") return 0;

  if (!me->query_stat_maximum("kee"))
    return notify_fail("你没有形体，无法喝水　\n");

  // Drink from liquid containers.
  if (sscanf(arg, "from %s", arg)) {
    object liq;

    ob = present(arg, me);
    if (!ob) ob = present(arg, environment(me));
    if (!ob) return notify_fail("这里没有这样东西 ...　\n");
    if (!ob->query("liquid_container"))
      return notify_fail(ob->name() + "　不是装水的容器　\n");
    foreach (liq in all_inventory(ob))
      if (liq->query_volume())
        return liq->drink_ob(me);
    return notify_fail(ob->name() + "里没有任何能喝的东西　\n");
  }

  return environment(me)->do_drink(arg);
}
