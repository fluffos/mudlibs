// eat.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( me->is_busy() ) return 0;

	if( !arg || arg=="" ) return notify_fail("你要吃什麽？\n");

	if( !me->query_stat_maximum("kee") )
		return notify_fail("你没有形体，无法进食　\n");

	ob = present(arg, me);
	if( !ob ) ob = present(arg, environment(me));
	if( !ob ) return notify_fail("这里没有这样东西 ...　\n");
	if( inherits(COMBINED_ITEM, ob) && !ob->query_amount() )
		return notify_fail("你得先把口中的食物吞下去　\n");

	notify_fail("这样东西不能吃　\n");
	if( ob->stuff_ob(me) ) {
		me->start_busy(1);
		return 1;
	}
	return 0;
}

int help()
{
	write(@TEXT
指令格式　eat <物品>

这个指令用来让你的人物进食或服用药物　es2 虽然设定了食物　但是通常你不必像
真实生活一样一天吃三餐　只要肚子饿时再吃就可以了　

战斗中吃食物会失去一次攻击机会　
TEXT
	);
	return 1;
}
