// wimpy.c

inherit F_CLEAN_UP;

void create() {seteuid(getuid());}

int main(object me, string arg)
{
	string stat;
	int ratio;

	if( !arg ) {
		mapping notification = me->query("statistic/notify");
		string msg = "你的各项指数在低於下列比例时会自动逃命：\n";
		if( mapp(notification) )
			foreach(stat, ratio in notification)
				msg += sprintf("%s\t\t%d\n", to_chinese(stat), ratio);
		else
			msg += "没有设定　\n";
		write(msg);
		return 1;
	}

	if( sscanf(arg, "%s at %d", stat, ratio) != 2 )
		return notify_fail("指令格式：wimpy <指数项目> at <比例>\n");

	if( !me->query_stat_maximum(stat) )
		return notify_fail("你没有这项指数项目　\n");

	if( (ratio < 0) || (ratio > 80) )
		return notify_fail("比例必须在 0 到 80 之间　\n");

	me->set_stat_notify(stat, ratio);
	write("Ok　\n");

	return 1;
}

int help()
{
	write(@TEXT
指令格式：wimpy <指数项目> at <百分比>

这个指令让你设定在人物的某项指数低於一个百分比的时候，自动逃跑　
(每个指数项目都可以设，只要其中一个低於你设的百分比，就会逃跑)

可以设定的指数项目包括：

gin       精
kee       气
sen       神
food      食物
water     饮水
TEXT
	);
	return 1;
}
