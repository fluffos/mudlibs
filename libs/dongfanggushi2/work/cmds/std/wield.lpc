// wield.c

inherit F_CLEAN_UP;

varargs int do_wield(object me, object ob);

int main(object me, string arg)
{
	string skill;
	object ob, *inv;
	int i, count;

	if( me->is_busy() ) return notify_fail("你现在没有空！\n");

	if( !arg ) return notify_fail("你要装备什麽武器？\n");

	if(arg=="all") {
		inv = all_inventory(me);
		for(count=0, i=0; i<sizeof(inv); i++) {
			if( inv[i]->query("equipped") ) continue;
			if(do_wield(me, inv[i]) ) count ++;
		}
		write("Ok.\n");
		return 1;
	}

	// Get skill type if specified.
	sscanf(arg, "%s as %s", arg, skill);

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("你身上没有这样东西　\n");

	return do_wield(me, ob, skill);
}

varargs int do_wield(object me, object ob, string skill)
{
	string str;

	if( ob->wield(skill) ) {
		if( !stringp(str = ob->query("wield_msg")) )
			str = "$N装备$n作武器　\n";
		message_vision(str, me, ob);
		return 1;
	} else
		return 0;
}

int help(object me)
{
	write(@HELP
指令格式：wield <装备名称> [as <武器技能>]
 
这个指令让你装备某件物品作武器，你必需要拥有这样物品　

有些武器可以当成许多种兵器使用，例如一把阔剑可以当剑使，也可以当刀耍，你可
以用

wield broadsword as sword

或

wield broadsword as blade

来指定　
 
HELP
    );
    return 1;
}
