// say.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *ob;
  if (!arg) return notify_fail("你要说什麽？\n");

  write(CYN "你说道：" + arg + "\n" NOR);
  message("sound", CYN + me->name() + "说道：" + arg + "\n" NOR,
    environment(me), me);

  // The mudlib interface of say
  ob = all_inventory(environment(me)) - ({ me });
  ob->relay_say(me, arg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: say <讯息>
 
说话，所有跟你在同一个房间的人都会听到你说的话　
 
　: 本指令可用 ' 取代.
 
HELP
  );
  return 1;
}
