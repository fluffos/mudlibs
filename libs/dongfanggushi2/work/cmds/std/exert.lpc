// exercise.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int ratio;
	string f, dest;
	object target;

    seteuid(geteuid(me));

	if( !(f = me->skill_mapped("force")) )
		return notify_fail("你现在　没有使用任何内功\　\n");
	if( f=="force" )
		return notify_fail("你必须先 enable 一种内功\　\n");

	if( !arg ) {
		ratio = me->query("force_ratio");
		if( !ratio ) ratio = 75;
		printf("你在作战时将使出%s成%s的功\力　\n",
			chinese_number(ratio/10), (ratio%10==0 ? "" : chinese_number(ratio%10)));
		return 1;
	}

	if( sscanf(arg, "%d", ratio)==1 ) {
		if( ratio < 10 || ratio > 100 )
			return notify_fail("你能控制的范围是在一成到十成功\力之间　\n");
		me->set("force_ratio", ratio);
		write("Ok.\n");
		return 1;
	}

	if( me->is_busy() )
		return notify_fail("你必须先用 halt 停止你正在做的事！\n");

	if( sscanf(arg, "%s on %s", arg, dest)==2 ) {
		target = present(dest, environment(me));
		if( !target || !target->is_target() )
			return notify_fail("这里没有这个人　\n");
	}
	notify_fail("你所使用的内功\没有这种功\能　\n");
	return SKILL_D(me->skill_mapped("force"))->exert_function(me, arg, target);
}

int help(object me)
{
	write(@TEXT
指令格式：exert [<功能> [on <目标>]]
          exert <功力百分比(10-100)>
          exert

使用内功的某些功能，或设定在战斗中要使出几成功力，exert 100 表示你将使出全力
战斗，当你技能不高的时候你对功力的控制将比较不能收发自如，使出全力战斗将使你
运用内功提　战斗时的攻击命中率　破坏力　与防御力，但是相对的力气的消耗也相当
大，面对较弱的敌人时你可以选择使用五　六成功力以节省体力　

不加任何参数时会显示你现在的设定　

使用内功技能时所用的功能随你学习的内功而异，通常你可以用 exert <内功名称> 来
修炼内功，不过有些特殊内功的修炼方法可能会有不同　

TEXT
	);
	return 1;
}
