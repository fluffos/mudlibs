#include <weapon.h>

inherit STAFF;

void create()
{
        set_name("竹节鞭", ({"bamboo mace", "mace"}));
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 500);
                set("material", "wood");
        }

        init_staff(15);
        setup();
}

