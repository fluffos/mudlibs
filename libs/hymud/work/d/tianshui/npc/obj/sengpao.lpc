// sengpao.c

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("破旧僧袍", ({ "cloth" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 6);
        }
        setup();
}