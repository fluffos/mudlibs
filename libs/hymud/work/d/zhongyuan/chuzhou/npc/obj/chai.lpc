inherit ITEM;
void create()
{
        set_name("烧柴",({"shao chai","chai"}));
        set("weight",2000);
    if (clonep())
        set_default_object(__FILE__);
    else 
   {
        set("unit","捆");
            set("value", 30 + random(30) );
            set("long","一大捆烧柴。\n");
    }       
}
