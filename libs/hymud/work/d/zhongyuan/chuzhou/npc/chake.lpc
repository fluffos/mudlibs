// 茶客/d/city/chuzhou/npc/chake.c
// by lala, 1997-12-14

inherit NPC;

string *name = ({
"周延儒", "钱象坤", "温体仁", 
     });
void create()
{
    set_name( name[random(sizeof(name))], ({ "cha ke", "chake", }) );
    set( "gender", "男性" );
    set( "age", 45 );
    set( "long", @LONG
这是本城的一位闲居的乡绅，以前做过些小官，现在家无事，每日来泡茶馆。他
们这些人的消息最是灵通。
LONG
    );
    set("combat_exp", 5000);
    set("social_exp", 15000);
    set("positive_score", 500);
    set("negative_score", 100);
    set("qi",400);
    set("max_qi",400);
    set("eff_kee",400);
    set("sen",400);
    set("max_sen",400);
    set("eff_sen",400);

    setup();
          
    carry_object( "/clone/misc/cloth")->wear();
    add_money( "coin", 100 + random(50) );
}          

void init()
{
   object me = this_player();
   object ob = this_object();
   int relative;

   if ( userp( me )
     && relative = me->query_marks( "marks/chuzhou/" + ob->query("name") ) 
        > 0 )
        call_out( "greeting", 2, me, ob, relative );
}

void greeting( object me, object ob, int relative )
{
    string str;

    switch( random( relative/10 ) )
    {
        case 0:
            str = "$N一转头，看见$n走进来，点点头，算是打招呼了。\n";
            break;
        case 1:
            str = "$N正埋头喝茶，一抬头，看见$n站在他面前，笑了一笑。\n";
            break;
        case 2:
            str = "$n一走进茶肆，就看见$N正在对自己打招呼：“好久不见啊”\n";
            break;
        case 3:
            str = "$N看见$n走进来，赶忙站起来说：“今日相逢，幸会幸会！”\n";
            break;
        case 4:
            str = "$N一看见$n，就上前行礼：“哎呀，怎么今天您有空来啊！”\n";
            break;
        default:
            str = "$N一把抓住$n的袖子，大声的说：“呀，这是什么风把你吹来啦？！”\n";         
            break;
    }
    message_vision( str, ob, me );
}
