//jiu1.c.葡萄酒
//date:1997.8.27
//by dan     

#include <ansi.h>
inherit ITEM;
inherit F_LIQUID; 

void create()
{
        set_name(MAG"葡萄酒"NOR, ({"putao jiu", "jiu"}));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个专门用来装葡萄酒的瓷瓶。\n");
                set("unit", "瓶");
                set("value", 1000);
                set("max_liquid", 100);
        }
        // because a container can contain different liquid
        // we set it to contain wine at the beginning
        set("liquid", ([
                "type": "alcohol",
                "name": "葡萄酒",
                "remaining": 30,
                "drunk_apply": 40,
        ]));
}  

void init()
{
        this_object()->delete("value");
        add_action("do_drink","drink");
}

