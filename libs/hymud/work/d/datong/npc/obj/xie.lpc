// xie.c

#include <armor.h>

inherit BOOTS;

protected string master;

void set_master(string m)
{
	if(!stringp(m) || (m == "") || master)
		return;

	else
		master = m;
}

string query_master() { return master; }

string q_long()
{
	return sprintf( "这是一双用呼啦草编的草鞋。\n%s",
		master?sprintf("鞋底绣着 %s 敬制\n",capitalize(master)):"");
}

void create()
{
	set_name("草鞋", ({ "cao xie" }) );
	set_weight(500);

	set("unit","双");
	set("material", "grass");
	set("armor_prop/armor", 5);
	set("long", (: q_long :));
	setup();
}

int check_quest_giver(object who)
{
	if(!objectp(who)
	|| !master
	|| (who->query("id") != master))
		return 0;

	return 1;
}
