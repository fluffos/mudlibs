
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §8.1: this driver's str[i] is a Unicode codepoint, not a
	// raw GBK byte -- the old GBK lead-byte range test is never true.
	// Rewritten against the CJK Unified Ideographs block; length floor
	// relaxed from 2 to 1 since sliding-window callers (check_legal_name)
	// call this with genuine 1-character suffixes at the last position.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
