void auto_save();

void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "任务精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "随机任务系统已经开始。\n");
        call_out("auto_save", 8);
}

void auto_save()
{
        int i,mem,j;
