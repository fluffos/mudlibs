#include <mudlib.h>
#include <ansi.h>
#include <combat.h>

nosave mapping score_list = ([]);

int sort_score(string str1, string str2) {
  return score_list[str2] - score_list[str1];
}

void score(object player) {
  int attack_points, parry_points, dodge_points, force_points, score_points, age, i;
  string short, *sc_list, str, id;
  object link_ob;

  if (!player) return;
  if (wiz_level(player) > 0) return;
  link_ob = player->query_temp("link_ob");
  if (!link_ob) return;
  age = player->query("mud_age") / 8640;
  if (age == 0) return;
  short = sprintf("%s(%s)", link_ob->query("name"), geteuid(player));
  attack_points = COMBAT_D->skill_power(player, "unarmed", SKILL_USAGE_ATTACK) / 10;
  parry_points = COMBAT_D->skill_power(player, "parry", SKILL_USAGE_DEFENSE) / 10;
  dodge_points = COMBAT_D->skill_power(player, "dodge", SKILL_USAGE_DEFENSE) / 10;
  force_points = player->query("max_neili") * 26 + player->query("max_jinli") * 333;
  score_points = attack_points + parry_points + dodge_points + force_points;
  if (score_points < 0) {
    log_file("/score_error", short + "\n");
    return;
  }
  score_points /= age;
  if (sizeof(score_list))
    map_delete(score_list, short);
  score_list += ([ short: score_points ]);
  sc_list = keys(score_list);
  sc_list = sort_array(sc_list, "sort_score");
  if (sizeof(score_list) > 20) {
    map_delete(score_list, sc_list[20]);
    sc_list -= ({ score_list[20] });
  }
  link_ob->set("score", score_points);
  str = "";
  for (i = 0; i < sizeof(sc_list) - 1; i++) {
    sscanf(sc_list[i], "%s(%s)", short, id);
    str += sprintf("%2d %s %d\n", i + 1, sc_list[i], score_list[sc_list[i]]);
  }
  write_file("/topten/score.txt", str, 1);
  str = "";
  for (i = 0; i < sizeof(sc_list) - 1; i++)
    str += sprintf("%s %d\n", sc_list[i], score_list[sc_list[i]]);
  write_file("/topten/score", str, 1);
}
void create() {
  string *sc_list, ply_name, file;
  int score_points;

  seteuid(getuid());
  if (file_size("/topten/score") < 1) return;
  file = read_file("/topten/score");
  if (!file) return;
  sc_list = explode(file, "\n");
  score_list = allocate_mapping(sizeof(sc_list));
  foreach (string str in sc_list) {
    if (str[0] == '#' || sscanf(str, "%s %d", ply_name, score_points) != 2) continue;
    score_list[ply_name] = score_points;
  }
}
