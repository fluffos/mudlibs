// By Xiang@XKX (12/17/95)
//ADD breakup-HALT BY lucas
#include <ansi.h>
int main(object me, string arg) {
  if (me->is_fighting()) {
    me->remove_all_enemy();
    message_vision("$N身行向后一跃，跳出战圈不打了。\n", me);
  }

  else if ((int)me->query_temp("pending/breakup") != 0) {
    me->add("potential", -(me->query("breakpot") / 2));
    me->delete_temp("pending/breakup");
    me->delete("breakpot");
    me->delete("potcost");
    me->apply_condition("breakup", 0);
    //      me->start_busy(-1000000);
    message_vision(HIY "$N把把正在冲击任督二脉的真气收回丹田，站了起来。\n" NOR, me);
  }

  else if (!me->is_busy())
    return notify_fail("你现在不忙。\n");

  else if ((int)me->query_temp("pending/exercise") != 0) {
    message_vision(HIC "$N把正在运行的真气强行压回丹田，站了起来。\n" NOR, me);
    me->interrupt_me();
  }

  else if ((int)me->query_temp("pending/respirate") != 0)
    message_vision(HIG "$N把正在运行的精气强行压回丹田，站了起来。\n" NOR, me);
  me->interrupt_me();

  me->interrupt_me();

  return 1;
}
