// zui-gun.c -少林醉棍
inherit SKILL;
mapping *action = ({
  ([ "action": "「" + MAG + "蓝采和" + CYN + "，提篮劝酒醉朦胧" + NOR + "」，$N手中$w半提，缓缓划向$n的$l",
    "force": 180,
    "lvl": 0,
    "skill_name": MAG " 蓝采和，提篮劝酒醉朦胧" NOR,
    "damage_type": "淤伤"
  ]),
  ([ "action": "「" + HIC + "何仙姑，拦腰敬酒醉仙步" + NOR + "」，$N左掌护胸，右臂挟棍猛地扫向$n的腰间",
    "force": 200,
    "lvl": 20,
    "skill_name": HIC "何仙姑，拦腰敬酒醉仙步" NOR,
    "damage_type": "淤伤"
  ]),
  ([ "action": "「" + WHT + " 曹国舅，千杯不醉倒金盅" + NOR + " 」，$N倒竖$w，指天打地，向$n的$l劈去",
    "force": 230,
    "lvl": 30,
    "skill_name": WHT "曹国舅，千杯不醉倒金盅" NOR,
    "damage_type": "内伤"
  ]),
  ([ "action": "「" + RED + "韩湘子，铁棍提胸醉拔萧" + NOR + "」，$N横提$w，棍端划了个半圈，击向$n的$l",
    "force": 270,
    "lvl": 40,
    "skill_name": RED "韩湘子，铁棍提胸醉拔萧" NOR,
    "damage_type": "刺伤"
  ]),
  ([ "action": " 「" + YEL + "汉钟离，跌步翻身醉盘龙" + NOR + "」，$N手中棍花团团，疾风般向卷向$n",
    "force": 320,
    "lvl": 50,
    "skill_name": YEL "汉钟离，跌步翻身醉盘龙" NOR,
    "damage_type": "淤伤"
  ]),
  ([ "action": "「" + HIW + "铁拐李，踢倒金山醉玉池" + NOR + "」，$N单腿支地，一腿一棍齐齐击向$n的$l",
    "force": 380,
    "lvl": 55,
    "skill_name": HIW "铁拐李，踢倒金山醉玉池" NOR,
    "damage_type": "淤伤"
  ]),
  ([ "action": "「" + HIR + "张果老，醉酒抛杯倒骑驴" + NOR + "」，$N扭身反背，$w从胯底钻出，戳向$n的胸口",
    "force": 450,
    "lvl": 60,
    "skill_name": HIR "张果老，醉酒抛杯倒骑驴" NOR,
    "damage_type": "挫伤"
  ]),
  ([ "action": "「" + BLU + "吕洞宾，酒醉提壶力千钧" + NOR + "」，$N腾空而起，如山棍影，疾疾压向$n",
    "force": 530,
    "lvl": 64,
    "skill_name": BLU "吕洞宾，酒醉提壶力千钧" NOR,
    "damage_type": "挫伤"
  ]),
});
int valid_enable(string usage) { return (usage == "club") || (usage == "parry"); }
int practice_level() { return 64; }
int valid_learn(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("hunyuan-yiqi", 1) < 20)
    return notify_fail("你的混元一气功火候太浅。\n");
  if (me->query_skill("club", 1) <= me->query_skill("zui-gun", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("zui-gun", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  a_action["dodge"] = 0 - level;
  a_action["attack"] = level / 2;
  a_action["damage"] = level;
  return a_action;
}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练少林醉棍。\n");
  me->receive_damage("qi", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "zui-gun/" + action;
}
