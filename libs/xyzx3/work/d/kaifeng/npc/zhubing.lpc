// Npc /u/lots/kaifeng/npc/zhubing.c
inherit NPC;

void create() {
  set_name("猪兵", ({ "zhu bing", "zhu", "bing" }));
  set("age", 28);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("str", 40);
  set("combat_exp", 50000);
  set("max_kee", 500);
  set("max_sen", 500);
  set("max_force", 500);
  set("force", 500);
  set("xiuluo-dao", 50);
  set("blade", 50);
  set("force_factor", 50);
  set("mana_factor", 50);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("force", 30);
  set_skill("shaolin-shenfa", 80);
  map_skill("blade", "xiuluo-dao");
  map_skill("dodge", "shaolin-shenfa");
  setup();
  carry_object("/d/kaifeng/obj/cloth")->wear();
}

void inint() {
  call_out("looking", 1, this_player());
}

void looking(object who) {
  command("look " + who->query("id"));
}
