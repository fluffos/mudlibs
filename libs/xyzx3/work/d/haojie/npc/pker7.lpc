#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name("蓝衣杀手", ({ "sha shou", "sha", "shou" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "他是七杀门的杀手。\n");
  set("per", 10);
  set("attitude", "peaceful");
  set("no_die", 1);
  set("str", 15);
  set("int", 35);
  set("con", 35);
  set("dex", 35);

  set("qi", 5500);
  set("max_qi", 5500);
  set("jing", 2000);
  set("max_jing", 2000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 40);

  set("combat_exp", 10000000);
  set("score", 0);
  set("shen_type", -20000);

  set_skill("force", 600);
  set_skill("taiji-shengong", 600);
  set_skill("unarmed", 600);
  set_skill("taiji-quan", 600);
  set_skill("dodge", 600);
  set_skill("taiji-jian", 600);
  set_skill("sword", 600);
  set_skill("tiyunzong", 600);
  set_skill("parry", 600);
  map_skill("force", "taiji-shengong");
  map_skill("unarmed", "taiji-quan");
  map_skill("dodge", "tiyunzong");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");
  create_family("七杀门", 3, "杀手");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: perform_action, "sword.lian" :),
    (: perform_action, "zhen" :),
  }));

  set("chat_chance", 30);
  set("chat_msg", ({
    (: call_out, "random_move", 0 :),
  }));

  setup();
  set("haojie", 1);
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  if (interactive(ob = this_player())) {
    remove_call_out("killing");
    call_out("killing", 0, ob);
  }
}

void killing(object ob) {
  if (environment(this_object()) != environment(ob)) return;
  if (base_name(environment(ob)) == "/d/city/wumiao") return;
  message_vision("$N对著$n喝道：「" + RANK_D->query_rude(ob) + "！今天不是你死就是我亡！」\n", this_object(), ob);
  this_object()->kill_ob(ob);
  return;
}

int random_move() {
  mapping exits;
  string *dirs, dir, dest;

  if (!mapp(exits = environment()->query("exits"))) return 0;
  dirs = keys(exits);
  dir = dirs[random(sizeof(dirs))];
  dest = exits[dir];
  if (domain_file(dest) != query("domain")) return 0;
  if (this_object()->is_fighting()) return 0;
  command("go " + dir);
  return 1;
}
