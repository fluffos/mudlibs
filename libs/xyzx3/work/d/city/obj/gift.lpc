#include <ansi.h>
#define LAST_PAR "sorry"
#define THIS_PAR "sorrysf"
#define GIFT_NAME "谅解万岁"
inherit ITEM;
void create() {
  set_name(HIR + GIFT_NAME + NOR, ({ "gift", "liwu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", @LONG
                ┌──────────────────────┐
                │                                            │ 
                │  夕阳再现，所有巫师。                      │ 
                │                                            │ 
                │       向所有的完家道歉，SORRY ALL          │ 
                │                                            │ 
                │            希望你们能够谅解意!             │ 
                │                                            │ 
                │                                            │ 
                │                        sigh, addoil!       │ 
                │                                            │ 
                └──────────────────────┘
JHFY 巫师的一点小心意，请打开(chai)来看看是什么？
LONG
    );
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("no_drop", 1);
  }
  setup();
}
void init() {
  add_action("do_chai", "chai");
}
int do_chai(string arg) {
  object me = this_player();
  int jp = me->query("mud_age") / 86400;
  object ob = new("/clone/money/thousand-gold");

  if (!id(arg)) return notify_fail("你要拆什么？\n");

  if (!me->query(THIS_PAR + "_chai")) {

    if (jp >= 10) {
      ob->set_amount(20);
      ob->move(me);
      me->add("max_neili", 200);
      me->add("max_jingli", 200);
      me->add("potential", 20000);
      me->add("combat_exp", 200000);
    }

    if (jp < 10 && jp >= 3) {
      ob->set_amount(10);
      ob->move(me);
      me->add("max_neili", 200);
      me->add("max_jingli", 200);
      me->add("potential", 20000);
      me->add("combat_exp", 200000);
    }
    if (jp < 3) {
      destruct(ob);
      me->add("max_neili", 200);
      me->add("max_jingli", 200);
      me->add("potential", 30000);
      me->add("combat_exp", 100000);
      if (me->query_skill(
        "literate",
        1
      ) < 100) me->set_skill("literate", me->query_skill("literate", 1) + 200);
      else me->set_skill("literate", me->query_skill("literate", 1) + 100);
      me->set_skill("force", me->query_skill("literate", 1) + 100);
    }


    message_vision(HIC "$N小心翼翼的拆开礼物包，只见一阵烟雾过后，$N顿时隐隐约约感到自己身体有了一些变化。\n" NOR);
    tell_object(me, HIG "财神爷在你的耳边悄声说道：恭喜发财！\n");
    //删除上次派礼物生成的参数，增加本次参数，确保每位玩家只能用一次。
    me->delete(LAST_PAR + "_chai");
    me->set(THIS_PAR + "_chai", 1);
  } else {
    tell_object(me, HIC "你小心翼翼的拆开礼物包，只见一阵烟雾过后，你顿时隐隐约约感到自己身体有了一些变化。\n" NOR);
  }
  destruct(this_object());
  return 1;
}
void owner_is_killed() { destruct(this_object()); }
