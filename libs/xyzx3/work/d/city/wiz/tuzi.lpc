#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIW "兔子" NOR, ({ "tuzi npc" }));

  set("gender", "男性");
  set("age", 19);
  set("long",
    "兔子？呵呵~身份来历不明,是夕阳再现III之风云再起\n"
    "的全年被最容易被eat,pk的人物最之一,也是江湖风\n"
    "云2的主要的wiz之一，大家多多关照啊.我无论你们\n"
    "如何威逼拷打也不会服从的，我是兔子我怕谁啊!~~\n"
    "我先逃了~所有事情找snow解决，我去wc方便一下..\n");
  set("attitude", "peaceful");
  set("title", HIW "所有的事不是我的错啊" NOR);
  set("chat_chance", 3);
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
