// mihan.c


inherit ITEM;

void create() {
  set_name("锦盒", ({ "jin he", "jin", "he" }));
  set_weight(2000 + random(3000));
  set("no_put", 1);                       // 这样东西不能放入容量
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "天地会托付给你的锦盒。\n");
  }
}

void init() {
  add_action("do_give", "give");
  add_action("do_baned", "trans");

  remove_call_out("attract_robber");
  call_out("attract_robber", 1);

  if (query("target")) {
    remove_call_out("set_target");
    call_out("set_target", 4, query("target"));
    delete("target");               // add 4 seconds' delay, can't be so fast
  }
}

void set_target(string target) {
  set("target", target);
}

int do_baned() {
  write("你干什么呀，不要乱来。\n");
  return 1;
}
int do_give(string arg) {
  object me, ob, home;
  string obj, target;
  int i;
  if (!arg || arg == " ")
    return 0;
  if (sscanf(arg, "%s to %s", obj, target) != 2)
    if (sscanf(arg, "%s %s", target, obj) != 2)
      return 0;

  if (!id(obj)) return 0;

  me = this_player();

  if (!ob = present(target, environment(me))) {
    tell_object(me, "你想要把锦盒交给谁？\n");
    return 1;
  }
  if (!ob->id(query("target")) || userp(ob)) {
    tell_object(me, "你不能把这样东西给这个人。\n");
    return 1;
  }
  if (!living(ob)) {
    tell_object(me, ob->query("name") + "已经无法收下这样东西了。\n");
    return 1;
  }

  if (!home = find_object(ob->query("startroom")))
    home = load_object(ob->query("startroom"));
  if (environment(ob) != home) {
    message_vision(CYN + "$N说道：我现在正忙着呢！等我回去再说吧！" + NOR, ob);
    return 1;
  }
  message_vision("$N拿出一箱锦盒交给了" + ob->query("name") + "。\n", me);
  if ((time() - me->query("jinhe_start")) > me->query("jinhe_time")) {
    message_vision(CYN + "$N很生气地对$n说道：这么点儿事都办不好，真没用！\n" + NOR, ob, me);
    tell_object(me, "你没有及时把锦盒送到" + ob->query("name") + "的手中，你的任务失败了！\n");
    me->set("jinhe_failed", 1);
  } else {
    message_vision(CYN + "$N对$n笑道：很好！！\n" + NOR, ob, me);
    tell_object(me, "你成功地将锦盒送到了" + ob->query("name") + "的手中。\n");
    i = 600 + random(me->query("jinhe_time") - time() + me->query("jinhe_start")) / 2;
    tell_object(me, sprintf(WHT "你获得了%s点战斗经验！\n" NOR, chinese_number(i)));
    me->add("combat_exp", i);
    me->add("potential", i / 2);
    me->add("money", 10000);
    tell_object(this_player(), HIW "你得到1两黄金，已经存入你的银行帐户！\n" NOR);
    tell_object(me, sprintf(WHT "%s点潜能\n" NOR, chinese_number(i / 20 + 1)));
    ob = new(SILVER_OB);
    if (!ob->move(me))
      ob->move(environment(me));
    ob->add_amount(random(50) + 30);
    me->delete("jinhe_start");
    me->delete("jinhe_time");
  }

  me->receive_damage("qi", 30);
  me->receive_damage("jing", 30);

  destruct(this_object());

  return 1;
}

// 设置锦衣卫
void attract_robber() {
  object ob, robber, room;

  if (!userp(ob = environment(this_object()))) return;
  if (time() - ob->query("jinhe_start") > ob->query("jinhe_time") + 300) {
    destruct(this_object());
    return;
  }
  room = environment(ob);

  if (room->query("outdoors") && !present("shi wei", room)) {
    robber = new("/d/city2/npc/robber");
    robber->move(room);
    message_vision("$N走了过来。\n", robber);
  }

  remove_call_out("attract_robber");
  call_out("attract_robber", 1);
}
void owner_is_killed() { destruct(this_object()); }
