#include <ansi.h>
inherit SUPER_NPC;

nosave object Owner;

string *dirs = ({
  //门派路径
  "/d/baihuagu", "/d/jjf", "/d/lingtai", "/d/moon", "/d/nanhai", "/d/pansi", "/d/sea",
  "/d/shushan", "/d/xueshan", "/d/qujing/wuzhuang", "/d/qujing/wudidong", "/d/qujing/kusong",
  //城市
  "/d/ourhome/honglou", "/d/aolai", "/d/changan", "/d/city", "/d/eastway", "/d/gao",
  "/d/jz", "/d/kaifeng", "/d/luoyang", "/d/meishan", "/d/penglai", "/d/westway",
  //取经路
  "/d/qujing/baotou", "/d/qujing/baoxiang", "/d/qujing/bibotan",
  "/d/qujing/biqiu", "/d/qujing/chechi", "/d/qujing/dudi", "/d/qujing/fengxian",
  "/d/qujing/jilei", "/d/qujing/jindou", "/d/qujing/jingjiling", "/d/qujing/jinping",
  "/d/qujing/jisaiguo", "/d/qujing/kusong", "/d/qujing/maoying", "/d/qujing/nuerguo",
  "/d/qujing/pansi", "/d/qujing/pingding", "/d/qujing/qilin", "/d/qujing/qinfa", "/d/qujing/qinglong",
  "/d/qujing/tianzhu", "/d/qujing/tongtian", "/d/qujing/wudidong",
  "/d/qujing/wuji", "/d/qujing/wuzhuang", "/d/qujing/xiaoxitian", "/d/qujing/yinwu", "/d/qujing/yuhua",
  "/d/qujing/zhujie", "/d/qujing/zhuzi",
});

void set_owner(object who) {
  Owner = who;
}

object query_owner() { return Owner; }

void create() {
  set_name("木须子", ({ "mu xuzi", "mushu", "shu" }));
  set_level(39);
  set("gender", "男性");
  set("age", 33);
  set("long", "他本是长安城一穷汉，后投靠蝙蝠精，便成了无底洞的一员。\n");
  create_family("陷空山无底洞", 3, "弟子");
  set("title", HIR "如意人魔" NOR);
  set("attitude", "heroic");
  setup();
}

void dest_ob() {
  destruct(this_object());
}

int random_place() {
  int i, j, k;
  object me, newob;
  mixed *file, exit;

  me = this_object();
  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 0;
  reset_eval_cost();
  for (k = 0; k < 20; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") || newob->query("no_magic")
          || newob->query("no_mieyao") || !(exit = newob->query("exits"))
          || sizeof(exit) < 1)
          continue;
        if (me && me->move(newob, 1)) {
          message("vision", YEL + me->name() + YEL "突然从地下钻了出来。\n" NOR, environment(me), me);
          return 1;
        } else if (me) {
          remove_call_out("dest_ob");
          call_out("dest_ob", 1);
          return 0;
        }
      }
    }
  }
  remove_call_out("dest_ob");
  call_out("dest_ob", 1);
  return 0;
}

int infomation(object who) {
  int level;
  if (!who) {
    remove_call_out("dest_ob");
    call_out("dest_ob", 1);
    return 0;
  }
  level = who->query_level();
  if (level < 40) {
    remove_call_out("dest_ob");
    call_out("dest_ob", 1);
    return 0;
  }
  set_owner(who);
  level = level / 10 * 10 + 9;
  this_object()->set_level(level);
  set_skill("unarmed", level * 10);
  set_skill("dodge", level * 10);
  set_skill("parry", level * 10);
  set_skill("spells", level * 10);
  set_skill("yaofa", level * 10);
  set_skill("sword", level * 10);
  set_skill("qixiu-jian", level * 10);
  set_skill("blade", level * 10);
  set_skill("kugu-blade", level * 10);
  set_skill("lingfu-steps", level * 10);
  set_skill("yinfeng-zhua", level * 10);
  set_skill("force", level * 10);
  set_skill("huntian-qigong", level * 10);
  set_skill("literate", level * 10);
  map_skill("force", "huntian-qigong");
  map_skill("spells", "yaofa");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("sword", "qixiu-jian");
  map_skill("parry", "kugu-blade");
  map_skill("blade", "kugu-blade");
  map_skill("dodge", "lingfu-steps");

  set_skill("zhaoyun", level * 10);
  set_skill("feisha-zoushi", level * 10);
  set_skill("tuxing", level * 10);
  set_skill("zhihua", level * 10);

  set("force_factor", 350);
  set("mana_factor", 250);
  set("env/test", "HIR");
  setup();
  carry_object(0, "blade", 1)->wield();
  carry_object(0, "cloth", 1)->wear();
  carry_object(0, "shoes", 1)->wear();
  carry_object(0, "neck", 1)->wear();
  carry_object(0, "ring", 1)->wear();
  carry_object(0, "kui", 1)->wear();
  carry_object(0, "pifeng", 1)->wear();
  powerup(0, 1);
  if (random_place())
    return 1;
  return 0;
}

string _infomation(object who) {
  string str;
  if (!who || !userp(who))
    return 0;
  if (!infomation(who))
    return "不放心交给你去办。";
  str = CYN "那破落户左右逢源，倒也闯下了" NOR HIR "「如意人魔」" NOR CYN "的名头，你去与之切磋一番，自然能悟得" NOR HIC "「如意人魔」" NOR CYN "的奥妙。\n" NOR;
  str += HIC "地涌夫人掐指一算。\n" NOR;
  str += CYN "玉鼠精说道：这货现在好似在" + MISC_D->find_place(environment(this_object())) + NOR + CYN "一带，你去寻个造化吧。" NOR;
  return str;
}

void check_drug() {
  int i;
  remove_call_out("check_drug");
  reset_eval_cost();
  for (i = 0; i < 5; i++) {
    if (present("jinchuang yao")
      && query("eff_kee") < this_object()->query_maxkee()) {
      if (command("eat yao"))
        add_temp("be_cured", 1);
    }
  }
  for (i = 0; i < 5; i++) {
    if (present("hunyuan dan")
      && query("eff_sen") < this_object()->query_maxsen()) {
      if (command("eat dan"))
        add_temp("be_cured", 1);
    }
  }
  if (query("eff_kee") >= this_object()->query_maxkee()
    && query("eff_sen") >= this_object()->query_maxsen()) {
    message_vision(CYN "$N" CYN "说道：好了，可敢与老夫一战？！\n" NOR, this_object());
    return;
  }
  if (query("eff_kee") < this_object()->query_maxkee()
    && !present("jinchuang yao")) {
    message_vision(CYN "$N" CYN "说道：老夫觉得吧，我还可以再抢救一下。\n" NOR, this_object());
    return;
  }
  if (query("eff_sen") < this_object()->query_maxsen()
    && !present("hunyuan dan")) {
    message_vision(CYN "$N" CYN "说道：老夫觉得吧，我还可以再抢救一下。\n" NOR, this_object());
    return;
  }
  call_out("check_drug", 2);
}

int accept_object(object who, object obj) {
  int v;
  if (who != Owner)
    return 0;
  if ((obj->query("name") != "混元丹" && obj->query("name") != "金创药")
    || obj->is_character())
    return 0;
  v = obj->query_amount();
  if (obj->query("name") == "混元丹")
    carry_object("/d/obj/drug/hunyuandan")->set_amount(v);
  else carry_object("/d/obj/drug/jinchuang")->set_amount(v);
  EMOTE_D->do_emote(this_object(), "thank", geteuid(who), CYN, 0, 0, 0);
  remove_call_out("check_drug");
  call_out("check_drug", 2);
  return 2;
}

void kill_ob(object who) {
  if (!Owner || who != Owner) {
    remove_killer(who);
    who->remove_killer(this_object());
    message(
      "vision",
      name() + "不想和" + who->name() + "交手。\n",
      environment(),
      ({ this_object(), who })
    );
    if (userp(who))
      tell_object(who, name() + "不想与你动手。\n");
    return;
  }
  if (query("eff_kee") < this_object()->query_maxkee()) {
    remove_killer(who);
    who->remove_killer(this_object());
    message_vision(CYN "$N" CYN "说道：不行，我受伤了，你这样胜之不武。\n" NOR, this_object());
    return;
  }
  if (query("eff_sen") < this_object()->query_maxsen()) {
    remove_killer(who);
    who->remove_killer(this_object());
    message_vision(CYN "$N" CYN "说道：不行，我心神不宁，你这样胜之不武。\n" NOR, this_object());
    return;
  }
  ::kill_ob(who);
}

void die() {
  object book, who, me = this_object();

  who = query_temp("last_damage_from");


  if (!who || !environment() || !present(who, environment())
    || !Owner || who != Owner
    || who->query("family/family_name") != "陷空山无底洞"
    || who->is_knowing("wdd_diyu") != 2) {
    message_vision(HIB "\n$N" HIB "脸色一变：“不妥，老夫近日猫吃多了，有些内急，告辞告辞，日后再战！”，说罢一溜烟跑远了。\n\n" NOR, me);
    destruct(this_object());
    return;
  }
  if (random(query_temp("be_cured")) < 30) {
    if (query("eff_kee") < this_object()->query_maxkee()) {
      message_vision(HIW "\n$N" HIW "说道：「不打了，不打了，我投降....。」\n\n" NOR, this_object());
      all_inventory(environment())->remove_killer(this_object());
      this_object()->remove_all_killer();
      message_vision(CYN "$N" CYN "说道：不行，我受伤了，你这样胜之不武。\n" NOR, this_object());
      me->receive_curing("kee", me->query_maxkee() / 2);
      me->receive_curing("sen", me->query_maxsen() / 2);
      me->receive_heal("kee", me->query_maxkee() / 2);
      me->receive_heal("sen", me->query_maxsen() / 2);
      return;
    }
    if (query("eff_sen") < this_object()->query_maxsen()) {
      message_vision(HIW "\n$N" HIW "说道：「不打了，不打了，我投降....。」\n\n" NOR, this_object());
      all_inventory(environment())->remove_killer(this_object());
      this_object()->remove_all_killer();
      message_vision(CYN "$N" CYN "说道：不行，我心神不宁，你这样胜之不武。\n" NOR, this_object());
      me->receive_curing("kee", me->query_maxkee() / 2);
      me->receive_curing("sen", me->query_maxsen() / 2);
      me->receive_heal("kee", me->query_maxkee() / 2);
      me->receive_heal("sen", me->query_maxsen() / 2);
      return;
    }
  }
  message_vision(HIB "\n$N" HIB "脸色一变：“不妥，老夫近日猫吃多了，有些内急，告辞告辞！日后再站”，说罢一溜烟跑远了。\n\n" NOR, me);
  who->set_knowing("wdd_diyu", 1);
  tell_object(who, HIY "恭喜！你在战斗中领悟到了" HIR "「无边地狱」" HIY "中" HIR "「如意人魔」" HIY "一式的奥秘。\n" NOR);
  destruct(this_object());
}

void unconcious() {
  die();
}
