// fabao.c
//塔(char) 
#include <ansi.h>
#include <armor.h>
#include <combat.h>
inherit FABAO;

mapping a_title() {
  return ([
    "甄洛": ({ "personality", "intelligence", "spells_succ", "spells_dodge", }),
    "湘君": ({ "personality", "intelligence", "receive_heal_kee", "receive_heal_sen", }),
    "娥皇": ({ "personality", "intelligence", "receive_heal_sen", "receive_curing_kee", }),
    "女英": ({ "personality", "intelligence", "receive_curing_kee", "receive_curing_sen", }),
    "紫霞仙子": ({ "personality", "ad_yinsuo-jinling", "ad_whip", "ad_sword", "ad_chixin-jian" }),
    "青霞仙子": ({ "personality", "ad_yinsuo-jinling", "ad_whip", "ad_sword", "ad_qingxia-jian" }),
  ]);
}

void create() {
  set_name("月光宝镜", ({ "yueguang baojing", "fabao", "jing" }));
  set("family_name", "盘丝洞");
  set("long", "此乃%s炼制的飞行类法宝。此外，此法宝还具备存储(reserve)内法的功能。\n");
  set("armor_type", "Fabao");
  set("fabao_type", ({ "other" }));
  set("my_type", "jing");
  set("fabao/max_force", 10000);
  set("fabao/max_mana", 18000);
  set("unit", "面");
  set("飞行", 1);
  set("fabao/dest_msg", HIC "\n" HIC "只见$n" HIC "在半空几个翻滚，顿时隐入云际，沓然无踪。\n" NOR);
  set("fabao/back_msg", HIC "\n" HIC "只见$n" HIC "在半空几个翻滚，又跌回$N" HIC "手中。\n" NOR);
  set(
    "fabao/ji_msg",
    HIC "\n" HIC "$N" HIC "喃喃念了几句咒语，手中$n" HIC "「呼」地一下飞到半空，道道霞光从上而下罩住了$N" HIC "全身。\n" NOR
  );
  set("fabao/fly_msg", HIC "\n$n" HIC "在$N" HIC "头顶绽放光华，化作一道霞光包裹住$N" HIC "径直冲天而去！\n\n" NOR);
  set("fabao/fly_msg2", HIC "\n一阵霞光从天而降，$N" HIC "从中顿时显出了身形。\n\n" NOR);
  set("no_fabao", ([
    "self_damage": 1,
    "self_def": 1,
    "combat_damage": 1,
    "spells_damage": 1,
    "combat_def": 1,
    "spells_def": 1,
    "hit_ob": 1,
  ]));
  setup();
}

void init() {
  object me = this_player();
  if (environment() && me == environment()
    && !query("default_set"))
    this_object()->init_fabao(me);
  ::init();
}

int init_fabao(object who) {
  if ( ::init_fabao(who)) {
    if (!query("fabao_title"))
      set("long", sprintf(query("long"), "盘丝洞紫青仙子"));
    else set("long", sprintf(query("long"), query("fabao_title")));
    return 1;
  } else return 0;
}
