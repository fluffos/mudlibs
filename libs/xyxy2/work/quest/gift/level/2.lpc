#include <ansi.h>
#include <mudlib.h>

varargs void Show(object who, string arg, string color) {
  string *msgs, str;
  int i;
  if (!who)
    return;
  if (!arg || !stringp(arg) || strlen(arg) < 2)
    return;
  if (!color || !stringp(color))
    color = HIY;
  arg = COLOR_D->clean_color(arg);
  arg = sort_string(arg, 68, 0);
  msgs = explode(arg, "\n");
  str = "";
  for (i = 0; i < sizeof(msgs); i++)
    str += "【系统】" + msgs[i] + "\n";
  tell_object(who, color + str + NOR);
}

int update_level(object who) {
  object gift;
  if (!who || !living(who) || !userp(who)
    || who->query_level() != 2)
    return 0;

  Show(
    who,
    "恭喜！你现在算是「新手上路」了。所谓「工欲善其事，必先利其器」，你可以输入 help weapon 命令，来查看武器相关的说明。\n现在去武器店向老板打听打听「武器」的事吧，输入 map here 命令可以查看地图。\n" NOR
  );
  Show(who, "除了一些特殊内容，你可以使用 ask <NPC的id> about all 来得到能询问NPC的内容。\n", HIR);
  return 1;
}

mixed newbie_gift(object who, object npc) {
  mapping skill;
  string *types, type, *skills, fam;
  object gift;
  int i;

  if (!who || !npc)
    return 0;
  if (who->query_level() != 2)
    return 0;
  if (!living(npc))
    return 1;

  if (who->query("giftmark/level_2"))
    return "不是已经给你了吗？";

  EMOTE_D->do_emote(npc, "wow", geteuid(who), CYN, 0, 0, 0);
  tell_object(
    who,
    CYN + npc->name() + CYN "说道：这几日多有异象，看" + RANK_D->query_respect(who) + "仪表堂堂，看来终非池中之物。\n" NOR
  );
  tell_object(who, CYN + npc->name() + CYN "说道：来来来，我这里有把家传多年的兵刃，放在我这也是暴殄天物。\n" NOR);
  types = ({
    "axe", "blade", "fork", "hammer", "mace", "spear", "staff", "stick", "sword", "unarmed", "whip",
  });
  type = types[random(sizeof(types))];
  npc->set_temp("weapon_level", 1 + random(2));
  npc->set("env/test", "HIB");
  gift = new("/d/obj/nweapon/" + type);
  gift->init_weapon(npc);
  if (gift->move(who)) {
    who->set("giftmark/level_2", 1);
    message_vision("$N递给$n一" + gift->query("unit") + gift->name(1) + "。\n", npc, who);
    who->add("combat_exp", 10000);
    who->add("daoxing", 5000);
    who->money_add(20000);
    Show(who, "你得到了10000点武学经验、五年道行以及二两黄金。\n", HIY);
    Show(who, "你可以通过 wield " + gift->query("id") + " 命令来装备武器。\n", HIR);
    who->save();
    return "呵呵。";
  } else {
    if (gift) destruct(gift);
    EMOTE_D->do_emote(npc, "sigh", geteuid(who), CYN, 0, 0, 0);
    return RANK_D->query_respect(who) + "，你背包满了吧，试试drop掉一些没用的吧。";
  }
}
