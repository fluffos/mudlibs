//负责存放妖。
#include <ansi.h>

string *ygs = ({
  "baihuagu", "dragon", "fangcun", "hell", "hyd",
  "jjf", "moon", "pansi", "putuo", "shushan", "wudidong",
  "wzg", "xueshan",
});

void create() {
  seteuid(getuid());
}

string cancel_me(object who) {
  mixed foo;
  if (!who)
    return 0;
  foo = who->cancel_job("李靖任务");
  if (!foo || !stringp(foo))
    return "你有接任务吗？";
  return foo;
}

string query_yao(object me) {
  int lvl;
  string where, msg, name;
  object ghost;
  mixed foo;
  if (!me)
    return 0;
  if (me->query_level() < 90)
    return RANK_D->query_respect(me) + "勇气可嘉。不过现在去，本王以为是送死的赶脚。";
  foo = me->doing_job("李靖任务");
  if (foo) {
    if (stringp(foo))
      return foo;
    else return "你不是已经接了吗？";
  }
  if (time() < me->query_temp("last_lijing_job") + 45) {
    message_vision(
      "\n" HIG "李天王对手中照妖镜一看，说" + "：这位" + RANK_D->query_respect(me) + ",妖魔已除尽,不妨先去歇息。" NOR "\n\n",
      me
    );
    return "呵呵。";
  }
  if (!me->query_temp("lijing_level"))
    ghost = new(sprintf("/quest/lijing/yg/yg-%s", ygs[random(sizeof(ygs))]));
  else ghost = new(sprintf("/quest/lijing/yg2/yg-%s", ygs[random(sizeof(ygs))]));
  if (!ghost)
    return RANK_D->query_respect(me) + "为天庭降妖除魔，劳苦功高，先下去歇歇。";

  lvl = me->query_job_level("李靖任务");
  if (lvl >= 10)
    lvl = 0;
  lvl += 1;
  where = ghost->invocation(me, lvl);
  if (!where) {
    ghost->move("/obj/empty");
    REMOVE_D->add_obj(ghost, 1);
    return RANK_D->query_respect(me) + "为天庭降妖除魔，劳苦功高，先下去歇歇吧。";
  }
  where = COLOR_D->clean_color(where);
  me->set_job_level("李靖任务", lvl);
  if (ghost->query("gender") == "男性")
    name = "他";
  else if (ghost->query("gender") == "女性")
    name = "她";
  else name = "它";
  msg = CYN "近有" + where + "为非作歹，速去将其降服！\n" NOR;
  tell_object(me, "\n" HIY "李靖将手中照妖镜朝下界一晃！" NOR "\n");
  me->set_temp("last_lijing_job", time());
  return me->get_job("李靖任务", ({ 0, 0, msg, ghost, lvl }));
}

string change_level(object me) {
  if (!userp(me) || me->query("gin") < 5)
    return "你的活力不够了。";
  me->add("gin", -5);
  if (me->query_temp("lijing_level")) {
    me->delete_temp("lijing_level");
    me->set_job_level("李靖任务", 0);
    write("你变更李靖任务为普通级别。\n");
    return "好的。";
  }
  if (time() >= me->query("last_rumor") + 3600) {
    me->set("last_rumor", time());
    CHANNEL_D->do_channel(
      environment(me),
      "rumor",
      "听说" HIY + me->name() + HIM "将自己的李靖任务难度提升为" NOR RED "噩梦" NOR HIM "级！" NOR
    );
  }
  me->set_temp("lijing_level", 1);
  me->set_job_level("李靖任务", 0);
  write("你变更李靖任务为噩梦级别。\n");
  return "好的。";
}
