#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j) {
  create_family("盘丝洞", 3, "");
  set_skill("unarmed", j);
  set_skill("dodge", j);
  set_skill("parry", j);
  set_skill("force", j);
  set_skill("spells", j);
  set_skill("sword", j);
  set_skill("chixin-jian", j);
  map_skill("sword", "chixin-jian");
  set_skill("whip", j);
  set_skill("yinsuo-jinling", j);
  map_skill("whip", "yinsuo-jinling");

  switch (random(2)) {
    case 0:
      map_skill("parry", "chixin-jian");
      set("Weapon", "sword");
      break;
    default:
      map_skill("parry", "yinsuo-jinling");
      set("Weapon", "whip");
      break;
  }
  set_skill("yueying-wubu", j);
  set_skill("pansi-dafa", j);
  set_skill("lanhua-shou", j);
  set_skill("jiuyin-xinjing", j);

  map_skill("force", "jiuyin-xinjing");
  map_skill("spells", "pansi-dafa");
  map_skill("dodge", "yueying-wubu");
  map_skill("unarmed", "lanhua-shou");

  set("class", "yaomo");
  set("title", HIR "海外妖修" NOR);
}
