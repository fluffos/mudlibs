  object owner_ob, corpse, me = this_object();
  string str;
  object silver;
  int lvl, max_kee, max_sen, ratio, exp_r, pot_r, dx_r;

  if (query("force") > 500 && random(5) == 3) {
    QUEST_D->addEffKee(me);
    QUEST_D->addKee(me);
    QUEST_D->addSen(me);
    QUEST_D->addEffSen(me);
    return;
