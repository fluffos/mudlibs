        "jinglei-mace": ({ "jinglei", "tiancheng", "jue" }),
      ]);
      break;
    case "五庄观":
      set_skill("taiyi", sk_lvl);
      map_skill("spells", "taiyi");
      set_skill("zhenyuan-force", sk_lvl);
      map_skill("force", "zhenyuan-force");
      set_skill("wuxing-quan", sk_lvl);
      map_skill("unarmed", "wuxing-quan");
      set_skill("baguazhen", sk_lvl);
      map_skill("dodge", "baguazhen");
      set_skill("fumo-zhang", sk_lvl);
      map_skill("staff", "fumo-zhang");
      set_skill("kaishan-chui", sk_lvl);
      map_skill("hammer", "kaishan-chui");
      set_skill("yange-blade", sk_lvl);
      map_skill("blade", "yange-blade");
      set_skill("sanqing-jian", sk_lvl);
      set_skill("xiaofeng-sword", sk_lvl);

      if (random(2)) {
        map_skill("sword", "sanqing-jian");
        map_skill("parry", "sanqing-jian");
        carry_object(0, "sword", 1)->wield();
      } else if (random(2)) {
        map_skill("sword", "xiaofeng-sword");
        map_skill("parry", "xiaofeng-sword");
        carry_object(0, "sword", 1)->wield();
      } else {
        map_skill("sword", "sanqing-jian");
        if (random(2)) {
          map_skill("parry", "fumo-zhang");
          carry_object(0, "staff", 1)->wield();
        } else if (random(2)) {
          map_skill("parry", "kaishan-chui");
          carry_object(0, "hammer", 1)->wield();
        } else {
          map_skill("parry", "yange-blade");
          carry_object(0, "blade", 1)->wield();
        }
      }
      set_skill("banyun", sk_lvl);
      set_skill("buzhen", sk_lvl);
      set_skill("jianshu", sk_lvl);
      set_skill("jizhang", sk_lvl);
      set_skill("zhanyao", sk_lvl);
      set_skill("zhaoyun", sk_lvl);

      Pfm_Action = ([
        "wuxing-quan": ({ "wuxing" }),
        "fumo-zhang": ({ "fuhu", "luan" }),
        "kaishan-chui": ({ "jin", "poyuan" }),
        "baguazhen": ({ "shengui", }),
        "yange-blade": ({ "bafang", "renji", "yange" }),
        "sanqing-jian": ({ "jianmang", "jianzhang", "juejian", "xing" }),
        "xiaofeng-sword": ({ "huichang", "tiandi", "zouxiao", "staff", "hammer" }),
      ]);
      break;
    default: return 0;
  }
  add_temp("apply/max_kee", 2500 * (level + 1));
  add_temp("apply/max_sen", 2500 * (level + 1));
  add_temp("apply/max_force", 500 * (level + 1));
  add_temp("apply/max_mana", 500 * (level + 1));
  setup();
  files = ({
    "armor", "cloth", "hand", "kui", "pifeng", "neck", "ring",
    "shoes", "wrists", "waist",
  });
  for (i = 0; i < sizeof(files); i++) {
    ob = carry_object(0, files[i], 1);
    ob->set("armor_title", this_object()->query("name"));
    ob->wear();
  }
  powerup(0, 1);
}

//me=NPC ob=owner lv=job_level
int copy_status(object me, object ob, int lv) {
  int i, lvl, k, level, v, dx, max_skill;
  int base = 10;
  mapping skill, kfam;
  string *skills, my_fam, his_fam;
  lvl = lv + base - 8;

  if (!ob || !living(ob))
    return 0;
  level = ob->query_level();
  if (level < 40)
    return 0;
  v = 9 - last_num(level);
  if (v > 1)
    level += random(v) - random(5);
  me->set_level(level);
  dx = me->query_max_daoxing();
  dx = dx / 2 + random(dx / 2);
  max_skill = QUEST_D->maxSkill(ob);
  if (max_skill <= 0)
    return 0;
  max_skill = max_skill * lvl / base;
  if (max_skill > level * 10)
    max_skill = level * 10;

  if (!stringp(my_fam = me->query("family/family_name")))
    his_fam = ({
      "将军府", "东海龙宫", "火云洞", "大雪山",
      "南海普陀山", "月宫", "百花谷", "五庄观",
      "蜀山派", "陷空山无底洞", "盘丝洞",
      "阎罗地府",
      //"方寸山三星洞",
    })[random(12)];
  else {
    kfam = ([
      "东海龙宫": "将军府",
      "火云洞": "东海龙宫",
      "大雪山": "火云洞",
      "南海普陀山": "大雪山",
      "月宫": "南海普陀山",
      "百花谷": "月宫",
      "五庄观": "百花谷",
      "蜀山派": "五庄观",
      "陷空山无底洞": "蜀山派 ",
      "盘丝洞": "陷空山无底洞",
      //"方寸山三星洞" : "盘丝洞",
      //"阎罗地府" : "方寸山三星洞",
      "将军府": "阎罗地府",
    ]);
    if (undefinedp(kfam[my_fam]))
      his_fam = ({
        "将军府", "东海龙宫", "火云洞", "大雪山",
        "南海普陀山", "月宫", "百花谷", "五庄观",
        "蜀山派", "陷空山无底洞", "盘丝洞",
        "阎罗地府",
        //"方寸山三星洞",
      })[random(12)];
    else his_fam = kfam[my_fam];
  }

  set_skills(max_skill, lv, his_fam);
  skill = me->query_skills();
  if (!skill || !mapp(skill))
    return 0;
  skills = keys(skill);
  if (!skills || !arrayp(skills) || sizeof(skills) < 1)
    return 0;
  for (i = 0; i < sizeof(skills); i++)
    me->set_skill(skills[i], max_skill);
  set("bellicosity", ob->query("bellicosity") / 3 * 2 + 1);
  setup();
  add_temp("apply/combat_def", (level + 1) * 50);
  add_temp("apply/spells_def", (level + 1) * 50);
  add_temp("apply/combat_damage", (level + 1) * 60);
  add_temp("apply/spells_damage", (level + 1) * 60);
  powerup(0, 1);
  if (query("family/family_name") != "月宫")
    set("force_factor", me->query_maxforce() / 35 + 1);
  set("mana_factor", me->query_maxmana() / 35 + 1);
  set("force", me->query_maxforce() * 2);
  set("mana", me->query_maxmana() * 2);
  return 1;
}

string _invocation(object who, int level) {
  object me = this_object(), env;
  string where, long;
  int exp, i, p, lvl;

  set("owner", who->query("id"));
  set("owner_ob", who);
  set("gender", ({ "男性", "女性" })[random(2)]);
  if (me->query("class") == "yaomo")
    long = "一位修魔的散人，修练了有" + chinese_number((query("daoxing") / 1000 / 10) * 10) + "多年道行，";
  else long = "一位修仙的散人，虽也在名家仙山修练了有" + chinese_number((query("daoxing") / 1000 / 10) * 10) + "多年道行，";

  lvl = level;
  if (lvl < 1) lvl = 1;
  i = random(1000);
  if (i < 10)
    set("type", "aggressive");
  else if (i < 20)
    set("type", "blocker");
  else if (i < 220)
    set("type", "aggressive_on_owner");
  else if (i < 320)
    set("type", "aggressive_on_owner1");
  else set("type", "normal");
  if (random(10) == 0) {
    if (lvl < 11)
      lvl = lvl + 1;  // as more difficult to kill.
  }
  exp_reward = 15000;
  exp_reward = exp_reward * (lvl + 8) / 10;
  exp_reward = exp_reward * 9 / 10 + random(exp_reward / 10);
  pot_reward = exp_reward / (2 + random(2)) + 1;
  me->set("stay_time", time());
  if (!random_place()) {
    leave();
    return 0;
  }
  env = environment(me);
  where = me->query("name") + "(" + capitalize(me->query("id")) + ")犯下滔天罪行，现藏匿";
  me->set("title", sprintf("%s(%s)追捕的", who->query("name"), capitalize(who->query("id"))));
  long += "犯下滔天罪行";
  if (env) {
    where += "在" + MISC_D->find_place(env);
    long += "，现藏匿在" + MISC_D->find_place(env);
  }
  long += "。\n";
  set("long", long);
  return where;
}

string invocation(object who, int level) {
  object me = this_object();
  if (!who)
    return 0;
  if (!copy_status(me, who, level)) {
    leave();
    return 0;
  }
  this_object()->set("force", this_object()->query_maxforce() * 2);
  this_object()->set("mana", this_object()->query_maxmana() * 2);
  this_object()->add_temp("apply/max_kee", 300 * (level + 1));
  this_object()->add_temp("apply/max_sen", 300 * (level + 1));
  this_object()->powerup(0, 1);
  return _invocation(who, level);
}

int accept_object(object who, object ob) { return 1; }

