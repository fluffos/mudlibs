nosave int exp_reward = 0, pot_reward = 0;
//SKILL_D(skill)->perform_action(me, arg)
nosave mapping Pfm_Action = 0;

void create() {
  int i;
  string name, id, *ids, *guainame, *prename;
  guainame = ({
    "土匪", "dacoit",
    "强盗", "robber",
    "杀人犯", "killer",
    "盗墓者", "resurrecter",
    "通奸犯", "misconducter",
    "纵火犯", "incendiariser",
    "恶霸", "bully",
    "抢劫犯", "robber",
    "采花贼", "rascal",
    "疯狂ＰＫ者", "crazy PKER",
  });
  prename = ({
    "罪大恶极 ",
    "十恶不赦 ",
    "罪该万死 ",
    "官府通缉 ",
    "死有余辜 ",
  });
  i = random(sizeof(guainame) / 2) * 2;
  name = guainame[i];
  id = guainame[i + 1];
  ids = ({ id, "tao fan", "fan" });
  set_name(prename[random(sizeof(prename))] + name, ids);
  set("age", 18 + random(30));
  set("attitude", "heroism");
  set("env/test", ({ "HIB", "HIM", "HIR", })[random(3)]);
  setup();
}

void leave() {
  if (this_object()) {
    if (environment())
      message(
        "vision",
        CYN + name() + CYN "鬼鬼祟祟的朝四周看了看。" NOR "\n" HIR "$N" HIR "嘿嘿一笑，窜了几窜就不见了。\n" NOR,
        environment()
      );
    destruct(this_object());
  }
}

int random_place() {
  int i, j, k;
  object me, newob;
  mixed *file, exit;

  if (!sizeof(dirs))
    return 0;
  me = this_object();
  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file))
    return 0;
  for (k = 0; k < 60; k++)  // try 20 times
  {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") || newob->query("no_magic")
          || newob->query("no_mieyao") || !(exit = newob->query("exits"))
          || sizeof(exit) < 1)
          continue;
        if (me && me->move(newob, 1)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }
  return 0;
}

