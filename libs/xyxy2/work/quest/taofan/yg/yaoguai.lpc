      exp_r = exp_reward;
      pot_r = pot_reward;
      dx_r = exp_reward * 4 / 5 + random(exp_reward / 5);
      corpse->set("oldname", query("name"));
      corpse->set("owner", owner_ob);
      corpse->set("taofan_reward", ([
        "combat_exp": exp_r,
        "daoxing": dx_r,
        "potential": pot_r,
      ]));
