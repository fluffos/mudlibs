void init() {
  object ob = this_object();
  if (ob->is_fighting())
    return;
  if (time() > query("stay_time") + 900) {
    leave();
    return;
  }
  if (environment()->query("no_fight")
    || environment()->query("no_magic")) {
    random_move();
    return;
  }
  ::init();
}

void kill_ob(object who) {
  if (userp(who) && who != query("owner_ob")) {
    tell_object(who, HIB "\n" + query("name") + HIB "将眼一瞪：小子，找死啊？！\n" NOR);
    remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  ::kill_ob(who);
}

void heart_beat() {
  object weapon, me = this_object();
  string base_skill, skill, *pfms, pfm;

  if (query("force") > 50 && me->is_fighting()
    && living(me)) {
    if (random((int)me->query_busy()) > 3) {
      me->stop_busy();
      me->reset_action();
    }
    if (!me->is_busy()
      && !me->is_hunluan()) {
      me->exert_function("recover");
      me->exert_function("refresh");
      if (query("eff_kee") < me->query_maxkee())
        QUEST_D->addEffKee(me);
      if (query("kee") < query("eff_kee"))
        QUEST_D->addKee(me);
      if (query("sen") < query("eff_sen"))
        QUEST_D->addSen(me);
      if (query("eff_sen") < this_object()->query_maxsen())
        QUEST_D->addEffSen(me);
      cast_spell("xiaoshen");
      if (!objectp(weapon = me->query_temp("weapon")))
        base_skill = "unarmed";
      else if (stringp(base_skill = weapon->query("use_apply_skill")))
        ;
      else base_skill = weapon->query("skill_type");
      if (stringp(skill = me->query_skill_mapped(base_skill))
        && Pfm_Action && sizeof(Pfm_Action) > 0
        && !undefinedp(Pfm_Action[skill])) {
        pfms = Pfm_Action[skill];
        pfm = pfms[random(sizeof(pfms))];
        SKILL_D(skill)->perform_action(me, pfm);
      }
      if (weapon && random(4) == 0) {
        if (weapon->uneuip()) {
          me->reset_action();
          base_skill = "unarmed";
          if (stringp(skill = me->query_skill_mapped(base_skill))
            && Pfm_Action && sizeof(Pfm_Action) > 0
            && !undefinedp(Pfm_Action[skill])) {
            pfms = Pfm_Action[skill];
            pfm = pfms[random(sizeof(pfms))];
            SKILL_D(skill)->perform_action(me, pfm);
          }
        }
        weapon->wield();
      }
      if (random(3) == 0) {
        base_skill = "dodge";
        if (stringp(skill = me->query_skill_mapped(base_skill))
          && Pfm_Action && sizeof(Pfm_Action) > 0
          && !undefinedp(Pfm_Action[skill])) {
          pfms = Pfm_Action[skill];
          pfm = pfms[random(sizeof(pfms))];
          SKILL_D(skill)->perform_action(me, pfm);
        }
      }
    }
  }
  ::heart_beat();
}

void unconcious() {
  die();
}
