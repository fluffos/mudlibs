#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "初通厨理" NOR,
    BLU "略知一二" NOR,
    HIB "小磨工夫" NOR,
    HIB "手艺精巧" NOR,
    YEL "有口皆碑" NOR,
    YEL "登堂入室" NOR,
    CYN "登峰造极" NOR,
    HIW "目无全牛" NOR
    HIW "庖丁之艺" NOR
  });

  grade = level / 36;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}

string art_knowledge_file(string action) {
  return CLASS_D("knowledge") + "/chuyi/" + action;
}

void skill_improved(object me) {
  int num, v;
  if (!me)
    return;
  num = me->query("mark/chuyi");
  v = me->query_skill("chuyi", 1) / 15 + 1;
  if (v > num) {
    me->set("mark/chuyi", v);
    tell_object(me, HIC "恭喜！你的「厨艺」大进，领悟了新的制作方法。\n" NOR);
  }
}
