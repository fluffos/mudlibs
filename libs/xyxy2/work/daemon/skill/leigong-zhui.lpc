//雷公椎
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([
    "action": "$N身形一转，手中的$w发出一道雷光从左肋下向$n的$l戳了过去。\n",
    "dodge": -20,
    "parry": -20,
    "damage": 40,
    "weapon": "雷光",
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N手中$w雷光暴长，如千年蛇蝎往$n$l咬去！\n",
    "dodge": -30,
    "parry": -20,
    "damage": 80,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中的$w带着丝丝雷光，脱手而出，以无法形容的速度直射$n的$l，一击之下即刻飞回。\n",
    "dodge": -20,
    "parry": -30,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query_maxforce() < 200)
    return notify_fail("你的内力不够，没有办法练「雷公椎」。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "dagger")
    return notify_fail("你必须先找一把短兵器才能练「雷公椎」。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "dagger" || usage == "parry" || usage == "dodge";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

varargs int practice_skill(object me, int flag) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习「雷公椎」。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  if (flag) write("你按著所学练了一遍「雷公椎」。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("public") + "/leigong-zhui/" + func;
}

string query_parry_msg(object weapon) {
  string *str1, *str2, *str3;
  str1 = ({
    "$n手中$w", "$n身形一转", "$n周转腾挪",
  });
  str2 = ({
    "冒出一道雷光", "雷光闪烁", "闪出丝丝雷光", "冒出道道电光",
  });
  str3 = ({
    "「啪」的一声将之挡开了。\n",
    "「啪」的一声将之格开了。\n",
    "逼得$N慌忙撤招。\n",
    "$N不得不换招撤式。\n",
  });
  return str1[random(sizeof(str1))] + "，" + str2[random(sizeof(str2))] + "，" + str3[random(sizeof(str3))];
}

string query_dodge_msg(string limb) {
  string *str1, *str2, *str3;
  str1 = ({
    "$n手中$w", "$n身形一转", "$n周转腾挪",
  });
  str2 = ({
    "冒出一道雷光", "雷光闪烁", "闪出丝丝雷光", "冒出道道电光",
  });
  str3 = ({
    "「啪」的一声已经攻势之外。\n",
    "瞬间已闪了开去。\n",
    "闪开了$N的攻击。\n",
    "眨眼间就躲开了$N的攻击。\n",
  });
  return str1[random(sizeof(str1))] + "，" + str2[random(sizeof(str2))] + "，" + str3[random(sizeof(str3))];
}
