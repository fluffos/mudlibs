#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 450)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_xltw") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「旋龙天舞」只能对战斗中的对手使用。\n");

  if (target->query("family/family_name") == "南海普陀山"
    || target->query("family/family_name") == "月宫"
    || target->query("family/family_name") == "百花谷")
    return notify_fail("这招对对方无效。\n");

  damage = 1000;
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 3600;
  me->add("mana", -450);
  me->set_temp("XST_xltw", time());
  me->add_temp("apply/attack", 90);
  me->set_temp("pfm_msg", 1);

  msg = HIC "$N" HIC "将手一招，顿时风云变色，四周" HIG "花木之气" HIC "疯狂席卷而来，在$P手中聚成一道霞光四射的" HIG "青" HIC "色光团。\n" NOR;
  message_combatd(msg, me, target);

  msg = HIG "青光一闪，一条十丈余长的青色巨龙从光团中现出虚像，巨大的龙爪探出，撕云裂风，带着轰鸣声径直抓向$n" HIG "$l！\n" NOR;
  succ_msg = ({
    HIB "结果$p$l的衣襟给抓得片片飞散，隐约可见悚然的血印！\n",
    HIB "结果$p$l处的衣襟给抓出一道长长的口子，鲜血止不住的向外直淌！\n",
    HIB "结果从$n" HIB "$l破碎的衣襟可见一条又长又深的伤口向外淌着鲜血！\n",
    HIB "结果只见$n" HIB "闷哼一声，连连后退，$l衣襟破碎，血肉模糊，！\n",
  })[random(4)];
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_QUICK,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );
  if (damage < 1)
    message_vision(HIC "$N" HIC "脚下轻轻一闪，躲过了这一击。\n" NOR, target);
  else {
    message_combatd(HIC "结果$N" HIC "脸色青气隐现，一闪而没。\n" NOR, me);
    me->receive_curing("kee", damage / 3);
    me->receive_heal("kee", damage / 2);
  }
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -90);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：旋龙天舞	
	神通效果：对敌物理攻击 固定伤害3600
		  附带吸血效果	
		  冷却6秒
		  对普陀山、月宫、百花谷弟子无效
HELP);
  else write(@HELP
	神通名称：旋龙天舞	
	神通效果：对敌物理攻击 固定伤害1000
		  附带吸血效果	
		  冷却6秒
		  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
