#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_lgzs") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「雷光振杀」只能对战斗中的对手使用。\n");

  if (target->query("family/family_name") == "南海普陀山"
    || target->query("family/family_name") == "月宫"
    || target->query("family/family_name") == "百花谷")
    return notify_fail("这招对对方无效。\n");

  damage = 800;
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 2400;
  me->add("mana", -400);
  me->set_temp("XST_lgzs", time());
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  msg = HIG "$N" HIG "右手五指间电光闪烁，顺势一翻，一道拳头粗细的雷光蜿蜒而出，似龙非龙，径直冲向$n" HIG "$l！\n" NOR;
  succ_msg = HIR "结果$n" HIR "$l青光一闪，$p脸色顿时有些发白。\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );
  if (damage < 1)
    message_vision(HIC "$N" HIC "脚下轻轻一闪，躲过了这一击。\n" NOR, target);
  else {
    message_combatd(HIC "结果$N" HIC "脸色青气隐现，一闪而没。\n" NOR, me);
    me->receive_curing("kee", damage / 3);
    me->receive_heal("kee", damage / 2);
  }
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：雷光振杀	
	神通效果：对敌法术攻击 固定伤害2400
		  附带吸血效果	
		  冷却7秒
		  对普陀山、月宫、百花谷弟子无效
HELP);
  else write(@HELP
	神通名称：雷光振杀	
	神通效果：对敌法术攻击 固定伤害800
		  附带吸血效果	
		  冷却7秒
		  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
