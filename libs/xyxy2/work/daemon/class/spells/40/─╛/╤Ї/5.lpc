#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage, i;
  string msg, succ_msg;
  object *enemy;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_lgjy") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");

  me->clean_up_enemy();
  if (!me->is_fighting())
    return notify_fail("「雷光焦狱」只能战斗中使用。\n");
  enemy = me->query_enemy();
  if (!intp(i = sizeof(enemy))
    || i < 1)
    return notify_fail("「雷光焦狱」只能战斗中使用。\n");

  damage = random(me->query("mana_factor") / 5);
  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    if (damage < 2000)
      damage = 2000;
    if (damage > 8000)
      damage = 8000;
  } else {
    if (damage < 800)
      damage = 800;
    if (damage > 1000)
      damage = 1000;
  }
  if (COMBAT_D->query_message_type(me, target) < 2)
    message_vision(
      HIG "$N" HIG "张口吐出一团青气，惊天动地的炸鸣声在空中响起。整个天空全被映成了青色，一团直径十余丈地雷云突然在半空，青色雷电在云中狂闪乱劈起来，轰鸣声、呼啸声，刺目的雷光，瞬间交织在一起，仿若天罚降临，雷神降世般恐怖。\n" NOR,
      me
    );
  else message_vision(HIG "$N" HIG "施展了「" HIR "雷光焦狱" HIG "」。\n" NOR, me);
  me->add("mana", -350);
  me->set_temp("XST_lgjy", time());
  msg = HIG "电光一闪，一道霹雳从天而降，径直劈向$n" HIG "$l！\n" NOR;
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  while (i--) {
    target = enemy[i];
    if (!target || !target->is_character()
      || target->is_corpse()
      || target == me
      || !me->is_fighting(target))
      continue;
    if (target->query("family/family_name") == "南海普陀山"
      || target->query("family/family_name") == "月宫"
      || target->query("family/family_name") == "百花谷")
      continue;
    succ_msg = ({
      HIR "结果「噗嗤」一声劈出一道焦糊糊的伤口！\n" NOR,
      HIR "结果只听「噗」地一声，$n" HIR "的$l被劈得焦黑一片，痛得$p咬牙切齿！\n" NOR,
      HIR "结果只听见$n" HIR "一声惨嚎，$p的$l被劈开一道深及见骨的可怕伤口，冒起一道黑烟！\n" NOR,
    })[random(3)];
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      damage,
      "kee"
    );
    if (damage < 1)
      message_combatd(HIC "$N" HIC "周身霞光绽放，堪堪抵住了电光。\n" NOR, target);
    else if (!target->query_condition("thunder_poison")) {
      message_combatd(HIG "$N" HIG "周身电光缭绕，看来状态不是很好！\n" NOR, target);
      target->apply_condition("thunder_poison", me->query_skill("spells") / 100 + 1);
    }
  }

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：雷光焦狱
	神通效果：对区域内所有敌方进行法术型气血攻击
		  冷却时间7秒	
		  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
