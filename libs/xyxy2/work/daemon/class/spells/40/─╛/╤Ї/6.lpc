#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage, i;
  string msg, succ_msg;
  object *enemy;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_blxd") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target)) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("「神霄袭雷」只能战斗中使用。\n");
    else return notify_fail("「奔雷袭电」只能战斗中使用。\n");
  }

  if (target->query("family/family_name") == "南海普陀山"
    || target->query("family/family_name") == "月宫"
    || target->query("family/family_name") == "百花谷")
    return notify_fail("这招对对方无效。\n");

  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    damage = 3500;
  else damage = 1500;
  me->add("mana", -400);
  me->set_temp("XST_blxd", time());
  me->add_temp("apply/attack", 90);
  me->set_temp("pfm_msg", 1);

  if (COMBAT_D->query_message_type(me, target) < 2)
    msg = HIC "$N" HIC "口中念动了几句咒语，咒语声不大，而且苦涩难懂，但那缓慢之极的声音中，隐隐有一股蛮荒之气弥漫开来，让人一下就感受到一丝荒古的气息。\n" NOR;
  else {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      msg = HIC "$N" HIC "施展了「" HIG "神霄袭雷" HIC "」。\n" NOR;
    else msg = HIC "$N" HIC "施展了「" HIG "奔雷袭电" HIC "」。\n" NOR;
  }
  message_vision(msg, me);

  msg = HIG "随着一声古雷响起，一道臂膀粗细的闪电夹带着丝丝金光从天而降，笔直劈向$n" HIG "！\n" NOR;
  succ_msg = HIB "$n" HIB "闪避不开，轰鸣声中，只能眼睁睁的看着被雷电笼罩！\n" NOR;
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_QUICK,
    msg,
    succ_msg,
    0,
    damage,
    "kee"
  );
  if (damage < 1)
    message_combatd(HIC "雷光散去，$N" HIC "却是毫发未损。\n" NOR, target);
  else if (!target->query_condition("thunder_poison")) {
    message_combatd(HIG "$N" HIG "周身电光缭绕，看来状态不是很好。\n" NOR, target);
    target->apply_condition("thunder_poison", me->query_skill("spells") / 60 + 1);
  }
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -90);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：神霄袭雷
	神通效果：对敌物理攻击 固定伤害3500
		  冷却时间6秒	
		  对普陀山、月宫、百花谷弟子无效
HELP);
  else write(@HELP
	神通名称：奔雷袭电	
	神通效果：对敌物理攻击 固定伤害1500
		  冷却时间6秒	
		  对普陀山、月宫、百花谷弟子无效
HELP);
  return 1;
}
