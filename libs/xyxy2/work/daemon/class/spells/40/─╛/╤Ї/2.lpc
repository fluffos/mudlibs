#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  object weapon;
  string str;

  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 250)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_leijishan")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「木雷勃发」了。\n");
    else return notify_fail("你已经施展了「雷击闪」了。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")))
    str = weapon->name(1);
  else str = "双手";
  str = COLOR_D->clean_color(str);
  message_vision(HIG "$N" HIG "脸色青气一盛，念动咒语，顿时" + str + "上发出一道霞光，隐约有电光闪烁缠绕！\n" NOR, me);
  me->set_temp("XST_leijishan", 1);
  me->add("mana", -250);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：木雷勃发
	神通效果：使自身鞭、锏、拳、暗器、短兵类伤害+15%
HELP);
  else write(@HELP
	神通名称：雷击闪
	神通效果：使自身鞭、锏、拳、暗器、短兵类伤害+3%
HELP);
  return 1;
}
