#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_guimiandun")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「冥盾附身」了。\n");
    else return notify_fail("你已经施展了「鬼面盾」了。\n");
  }
  message_vision(
    HIB "$N" HIB "念动咒语，凭空乍现一团黑色水气，凌空化作一面盾牌，其实符文纵横，另有狰狞鬼脸在内时隐时现，护住了$N" HIB "周身。\n" NOR,
    me
  );
  me->set_temp("XST_guimiandun", 1);
  me->add("mana", -350);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：冥盾附身	
	神通效果：伤害免疫1800点
HELP);
  else write(@HELP
	神通名称：鬼面盾	
	神通效果：伤害免疫600点
HELP);
  return 1;
}
