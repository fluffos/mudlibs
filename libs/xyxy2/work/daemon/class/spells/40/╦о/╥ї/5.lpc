#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int pp;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_LHL") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");
  if (me->query("kee") >= me->query("eff_kee")
    && me->query("eff_kee") >= me->query_maxkee()
    && me->query("sen") >= me->query("eff_sen")
    && me->query("eff_sen") >= me->query_maxsen())
    return notify_fail("没有这个必要。\n");

  message_vision(
    HIW "$N" HIW "一点虚空，一朵水盘大小的白莲顿时在半空冉冉升起，滴溜溜转了几转，化作道道白光钻入$N" HIW "体内。\n" NOR "$N脸色越发红润。\n",
    me
  );
  me->set_temp("XST_LHL", time());
  me->add("mana", -400);

  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    pp = me->query_maxkee() * 4 / 5 + 1;
    if (pp < 8000)
      pp = 8000;
  } else {
    pp = me->query_maxkee() * 55 / 100 + 1;
    if (pp < 2000)
      pp = 2000;
  }
  me->receive_curing("kee", pp);
  me->receive_heal("kee", pp);

  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    pp = me->query_maxsen() * 5 / 5 + 1;
    if (pp < 8000)
      pp = 8000;
  } else {
    pp = me->query_maxsen() * 55 / 100 + 1;
    if (pp < 2000)
      pp = 2000;
  }
  me->receive_curing("sen", pp);
  me->receive_heal("sen", pp);

  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：莲华落地
	神通效果：恢复并治疗自身80%(至少8000)的气血、精神
		  冷却7秒
HELP);
  else write(@HELP
	神通名称：莲华落
	神通效果：恢复并治疗自身55%(至少2000)的气血、精神
		  冷却7秒
HELP);
  return 1;
}
