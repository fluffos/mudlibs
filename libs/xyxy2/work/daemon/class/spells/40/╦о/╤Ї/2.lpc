#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  object weapon;
  string str;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 250)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_bingzhuci")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「冰刺重劲」了。\n");
    else return notify_fail("你已经施展了「冰柱刺」了。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")))
    str = weapon->name(1);
  else str = "双手";
  str = COLOR_D->clean_color(str);
  message_vision(
    HIW "$N" HIW "张口吐出一道白光，凌空化作数点寒光，在空气中瞬间凝成无数手指长短的冰柱，”嗖“的一声钻进" + str + HIW "不见了。\n" NOR,
    me
  );
  me->set_temp("XST_bingzhuci", 1);
  me->add("mana", -250);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：冰刺重劲
	神通效果：使自身叉、锤、拳脚、内功伤害+3%
HELP);
  else write(@HELP
	神通名称：冰柱刺
	神通效果：使自身叉、锤、拳脚、内功伤害+3%
HELP);
  return 1;
}
