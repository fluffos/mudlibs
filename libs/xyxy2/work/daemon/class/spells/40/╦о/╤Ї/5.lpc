#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  object weapon;
  string str;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_shuangyz")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「双月符纹」了。\n");
    else return notify_fail("你已经施展了「双月斩」了。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")))
    str = weapon->name(1);
  else str = "双手";
  str = COLOR_D->clean_color(str);
  message_vision(
    HIW "$N" HIW "目中白光一闪，凭空化作两面圆月大小的水镜，其上晶莹剔透，符文密布，闪烁着霞光，化作两股白光冲入$p" + str + "中。\n" NOR,
    me
  );
  me->set_temp("XST_shuangyz", 1);
  me->add("mana", -400);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：双月符纹
	神通效果：法术攻击伤害增加1400
HELP);
  else write(@HELP
	神通名称：双月斩
	神通效果：法术攻击伤害增加500
HELP);
  return 1;
}
