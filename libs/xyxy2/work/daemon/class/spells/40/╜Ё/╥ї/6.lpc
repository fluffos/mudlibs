#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int i, k;
  string msg, succ_msg;
  object *enemy;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 450)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_sjsh") + 6)
    return notify_fail("你不能频繁调用天气元气。\n");

  me->clean_up_enemy();
  if (!me->is_fighting())
    return notify_fail("「神剑闪华」只能战斗中使用。\n");
  enemy = me->query_enemy();
  if (!intp(i = sizeof(enemy))
    || i < 1)
    return notify_fail("「神剑闪华」只能战斗中使用。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「神剑闪华」只能对战斗中的对手使用。\n");
  message_vision(HIY "$N" HIY "将手一招，一柄丈许宽的巨剑凌空出现，在半空爆成万道金丝，顿时四下里金光闪烁，宛如天罗地网！\n" NOR, me);
  me->add("mana", -450);
  me->set_temp("XST_sjsh", time());
  msg = HIC "$n" HIC "$l处忽然金光一闪，一道肉眼难辨的金丝飞快划过！\n" NOR;
  me->add_temp("apply/attack", 90);
  me->set_temp("pfm_msg", 1);

  while (i--) {
    target = enemy[i];
    if (!target || !target->is_character()
      || target->is_corpse()
      || target == me
      || !me->is_fighting(target))
      continue;
    if (target->query("family/family") == "蜀山派"
      || target->query("family/family") == "将军府"
      || target->query("family/family") == "方寸山三星洞")
      continue;
    k = 3;
    while (k--) {
      succ_msg = ({
        HIR "结果划出一道细长的血痕。\n" NOR,
        HIR "结果「嗤」地一声划出一道伤口！\n" NOR,
        HIR "结果「嗤」地一声划出一道血淋淋的伤口！\n" NOR,
        HIR "结果「嗤」地一声划出一道又长又深的伤口，溅得$n" HIR "满脸鲜血！\n" NOR,
        HIR "结果只听见$n" HIR "一声惨嚎，$l被划出一道深及见骨的可怕伤口！\n" NOR,
      })[random(5)];
      if (me && me->query_level() >= 90 && me->query("shentong/90"))
        COMBAT_D->do_attack(
          me,
          target,
          me->query_temp("weapon"),
          TYPE_QUICK,
          msg,
          succ_msg,
          0,
          1500
        );
      else COMBAT_D->do_attack(
        me,
        target,
        me->query_temp("weapon"),
        TYPE_QUICK,
        msg,
        succ_msg,
        0,
        500
      );
    }
  }

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -90);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：神剑闪华
	神通效果：对区域内的敌人进行物理型气血攻击
		  冷却时间6秒	
		  对蜀山、将军府、方寸山弟子无效	
HELP);
  return 1;
}
