#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg, color;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 350)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_sanry") + 8)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「三日月斩」只能对战斗中的对手使用。\n");

  if (target->query("family/family") == "蜀山派"
    || target->query("family/family") == "将军府"
    || target->query("family/family") == "方寸山三星洞")
    return notify_fail("对方不吃这一套。\n");

  me->add("mana", -350);
  me->set_temp("XST_sanry", time());
  me->add_temp("apply/attack", 70);
  me->set_temp("pfm_msg", 1);

  msg = HIC "$N" HIC "牵引天地金元之气，顿时天象巨变，$N" HIC "背后阵纹转动，三道光轮层叠出现，绽放万道霞光！\n" NOR;
  message_vision(msg, me);

  color = ({ HIY, HIC, HIW })[random(3)];
  msg = color + "光轮旋转，飞速划向$n" + color + "$l！\n" NOR;
  succ_msg = ({
    color + "结果「嗤」地一声划出一道血淋淋的伤口！\n" NOR,
    color + "结果「嗤」地一声划出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$p的$l被划出一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 1500);
  else COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 600);

  color = ({ HIY, HIC, HIW })[random(3)];
  msg = color + "光轮旋转，飞速划向$n" + color + "$l！\n" NOR;
  succ_msg = ({
    color + "结果「嗤」地一声划出一道血淋淋的伤口！\n" NOR,
    color + "结果「嗤」地一声划出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$p的$l被划出一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 1500);
  else COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 600);


  color = ({ HIY, HIC, HIW })[random(3)];
  msg = color + "光轮旋转，飞速划向$n" + color + "$l！\n" NOR;
  succ_msg = ({
    color + "结果「嗤」地一声划出一道血淋淋的伤口！\n" NOR,
    color + "结果「嗤」地一声划出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$p的$l被划出一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 1500);
  else COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg, succ_msg, 0, 600);

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -70);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：三日月斩
	神通效果：对敌三次物理攻击
                  冷却时间8秒
                  对蜀山、将军府、方寸山弟子无效
HELP);
  return 1;
}
