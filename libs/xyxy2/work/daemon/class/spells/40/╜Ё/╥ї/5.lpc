#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  int damage;
  string msg, succ_msg, color;
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (time() < me->query_temp("XST_sanhz") + 7)
    return notify_fail("你不能频繁调用天气元气。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("「三圣华斩」只能对战斗中的对手使用。\n");

  if (target->query("family/family") == "蜀山派"
    || target->query("family/family") == "将军府"
    || target->query("family/family") == "方寸山三星洞")
    return notify_fail("对方不吃这一套。\n");

  me->add("mana", -400);
  me->set_temp("XST_sanhz", time());
  me->add_temp("apply/attack", 80);
  me->set_temp("pfm_msg", 1);

  msg = HIC "$N" HIC "将手一招，顿时三道" HIY "金色" HIC "刃影出现在$P手中，$N" HIC "顺势一抛，三道" HIY "金刃" HIC "风驰电掣般砍向$n" HIC "！\n" NOR;
  message_vision(msg, me, target);

  color = ({ HIY, HIC, HIW })[random(3)];
  msg = "\n";
  succ_msg = ({
    color + "结果只听「噗」地一声，$n" + color + "的$l被劈得血如泉涌，痛得$p咬牙切齿！\n" NOR,
    color + "结果「噗」地一声砍出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$l被劈开一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      1200,
      "kee"
    );
  else COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    500,
    "kee"
  );

  color = ({ HIY, HIC, HIW })[random(3)];
  msg = "\n";
  succ_msg = ({
    color + "结果只听「噗」地一声，$n" + color + "的$l被劈得血如泉涌，痛得$p咬牙切齿！\n" NOR,
    color + "结果「噗」地一声砍出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$l被劈开一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      1500,
      "kee"
    );
  else COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    550,
    "kee"
  );

  color = ({ HIY, HIC, HIW })[random(3)];
  msg = "\n";
  succ_msg = ({
    color + "结果只听「噗」地一声，$n" + color + "的$l被劈得血如泉涌，痛得$p咬牙切齿！\n" NOR,
    color + "结果「噗」地一声砍出一道又长又深的伤口，溅得$n" + color + "满脸鲜血！\n" NOR,
    color + "结果只听见$n" + color + "一声惨嚎，$l被劈开一道深及见骨的可怕伤口！\n" NOR,
  })[random(3)];
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_CAST,
      msg,
      succ_msg,
      0,
      1800,
      "kee"
    );
  else COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    600,
    "kee"
  );

  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/attack", -80);
  return 1;
}

int help(object me) {
  write(@HELP
	神通名称：三圣华斩
	神通效果：对敌三次法术攻击
                  冷却时间7秒
                  对蜀山、将军府、方寸山弟子无效
HELP);
  return 1;
}
