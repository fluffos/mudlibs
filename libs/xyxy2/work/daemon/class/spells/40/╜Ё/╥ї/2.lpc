#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 250)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_feiqi")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「刀剑无眼」了。\n");
    else return notify_fail("你已经施展了「飞鬼戟」了。\n");
  }

  message_vision(HIY "$N" HIY "口中喃喃念叨了几句咒语，只见四周顿时元气暗涌，凌空出现了一金戈虚影，在$P周身盘旋！\n" NOR, me);
  me->set_temp("XST_feiqi", 1);
  me->add("mana", -250);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：刀剑无眼
	神通效果：使自身刀剑类伤害减少7%
HELP);
  else write(@HELP
	神通名称：飞鬼戟
	神通效果：使自身刀剑类伤害减少3%
HELP);
  return 1;
}
