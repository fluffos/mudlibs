#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_gunshi")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「土石滚阵」。\n");
    else return notify_fail("你已经施展了「滚石」。\n");
  }
  message_vision(HIY "$N" HIY "念了几句咒语，四下土石之气瞬间汇聚，在其周围化作数个石形摆成的法阵。\n" NOR, me);
  me->set_temp("XST_gunshi", 1);
  me->add("mana", -200);
  if (me && me->query_level() >= 90 && me->query("shentong/90")) {
    me->add_temp("apply/combat_def", 800);
    me->add_temp("apply/spells_def", 800);
  } else {
    me->add_temp("apply/combat_def", 200);
    me->add_temp("apply/spells_def", 200);
  }
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：土石滚阵	
	神通效果：自身防御+200
HELP);
  else write(@HELP
	神通名称：滚石	
	神通效果：自身防御+800
HELP);
  return 1;
}
