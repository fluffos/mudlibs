#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 250)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_xuanlong")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「烈火旋龙」了。\n");
    else return notify_fail("你已经施展了「伏焰」了。\n");
  }
  message_vision(HIR "$N" HIR "张口吐出一团拳头大小的火球，凌空化作一道时隐时现的火龙在$P周身盘旋。\n" NOR, me);
  me->set_temp("XST_xuanlong", 1);
  me->add("mana", -250);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：烈火旋龙
	神通效果：枪技、杖技、棍技伤害减少3%
HELP);
  else write(@HELP
	神通名称：旋龙
	神通效果：枪技、杖技、棍技伤害减少7%
HELP);
  return 1;
}
