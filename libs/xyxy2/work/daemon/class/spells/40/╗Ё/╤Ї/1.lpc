#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_fuyan")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「三阳伏焰」了。\n");
    else return notify_fail("你已经施展了「伏焰」了。\n");
  }

  message_vision(HIR "$N" HIR "念动咒语，只见忽然凭空冒起一串火苗，化作星星点点，在$P身上一闪而没！\n" NOR, me);
  me->set_temp("XST_fuyan", 1);
  me->add("mana", -200);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me && me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：三阳伏焰	
	神通效果：使自身枪技、杖技、棍技伤害增加10%
HELP);
  else write(@HELP
	神通名称：伏焰	
	神通效果：使自身枪技、杖技、棍技伤害增加1%
HELP);
  return 1;
}
