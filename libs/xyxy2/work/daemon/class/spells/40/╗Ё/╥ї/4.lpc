#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 400)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_yanliuxing")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「炎流星辰」了。\n");
    else return notify_fail("你已经施展了「炎流星」了。\n");
  }

  message_vision(HIR "$N" HIR "张口吐出一团火球，在半空绽裂成万道火花，急如流星般围绕在$P周身闪烁，红光灼目，宛如繁星。\n" NOR, me);
  me->set_temp("XST_yanliuxing", 1);
  me->add("mana", -400);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：炎流星辰
	神通效果：伤害抵消1500点
HELP);
  else write(@HELP
	神通名称：炎流星
	神通效果：伤害抵消800点
HELP);
  return 1;
}
