#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 200)
    return notify_fail("你的法力不够。\n");
  if (me->query_skill("spells") < 600)
    return notify_fail("你的法术修为过低。\n");
  if (me->query_temp("XST_huolei")) {
    if (me->query_level() >= 90 && me->query("shentong/90"))
      return notify_fail("你已经施展了「赤圈雷炎」了。\n");
    else return notify_fail("你已经施展了「火雷」了。\n");
  }
  message_vision(HIR "$N" HIR "手掐法咒，周身顿时凌空浮现一圈红光，其内热气氤氲，间有各种赤红飞禽盘旋，隐带风雷之声！\n" NOR, me);
  me->set_temp("XST_huolei", 1);
  me->add("mana", -200);
  if (me->is_fighting())
    me->start_busy(3);
  return 1;
}

int help(object me) {
  if (me->query_level() >= 90 && me->query("shentong/90"))
    write(@HELP
	神通名称：赤圈雷炎	
	神通效果：枪技、杖技、棍技伤害减少5%
HELP);
  else write(@HELP
	神通名称：火雷	
	神通效果：枪技、杖技、棍技伤害减少1%
HELP);
  return 1;
}
