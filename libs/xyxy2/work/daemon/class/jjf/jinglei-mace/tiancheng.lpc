#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int succ, i, damage;
  string msg, succ_msg, fail_msg;

  if (me->query_level() < 40)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("family/family_name") != "将军府")
    return notify_fail("你不是将军府门下，如何能领悟得了此招「浑然天成」？\n");
  if (me->query("force") < 800)
    return notify_fail("你的当前内力太少了，会有危险的．\n");
  if (me->query_skill("lengquan-force", 1) < 400)
    return notify_fail("你的冷泉神功级别太低，还用不了这招．\n");
  if (me->query_skill("jinglei-mace", 1) < 400)
    return notify_fail("你的锏法级别太低，还用不了这招．\n");
  if (time() - (int)me->query_temp("jjf_tian") < 6)
    return notify_fail("绝招用多就不灵了！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (weapon->query("skill_type") != "mace" && weapon->query("use_apply_skill") != "mace")
    || me->query_skill_mapped("mace") != "jinglei-mace")
    return notify_fail("此乃惊雷锏法的绝招。\n");
  if (me->query_skill_mapped("force") != "lengquan-force")
    return notify_fail("没有冷泉神功作基础，如何引发这招「浑然天成」？\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你准备对谁用这招「浑然天成」？\n");

  me->add("force", -100);
  msg = HIY "【惊雷诀．．．．．．．．．．雷殛怒火】" NOR "\n" YEL "$N" YEL "双手举起$w" YEL "，以雷霆万钧之势向$n" YEL "砸去，此招看似大拙，实则大巧。$w" YEL "在空中一个转折,向$n" YEL "飞来,$p脸上写满恐怖！\n" NOR;
  fail_msg = HIG "$n" HIG "以柔克刚，以阴克阳，愣是让$N" HIG "的雷霆一击之力化为乌有。\n" NOR;
  succ_msg = HIY "$n" HIY "来不及细想，凭感觉躲闪，但来不及了，肩膀愣是被砸中，顿时行动受损。\n" NOR;
  me->add_temp("apply/combat_succ", 10);
  me->set_temp("pfm_msg", 1);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    succ_msg,
    0,
    800
  );
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/combat_succ", -10);
  if (damage < 1)
    message_combatd(fail_msg, me, target);

  if (me->query_skill("yanxing-steps", 1) >= 400
    && me->query("force") > 50) {
    me->add("force", -50);
    msg = HIM "\n【布阵诀．．．．．．．．．．奇门八卦】" NOR "\n" MAG "$N" MAG "口中念道：乾生天，坤生地，八卦无形，周转复始。绕着$n" MAG "越转越快，同时在地上不知布了一些什么玄机。地上起了些奇异的变化！\n" NOR;
    fail_msg = HIC "但是$n" HIC "却乱闯一通，误打误撞，竟然将$N" HIC "辛苦布成的阵法破坏了。\n" NOR;
    succ_msg = HIM "$n" HIM "只觉得四周有无形之力向自己压来，身形顿时慢了下来。\n" NOR;
    me->add_temp("apply/combat_succ", 15);
    succ = COMBAT_D->attack_percent(me, target, TYPE_PERFORM);
    me->add_temp("apply/combat_succ", -15);
    message_vision(msg, me, target);
    if (succ && !target->is_busy()) {
      message_vision(succ_msg, me, target);
      target->start_busy(3);
    } else message_combatd(fail_msg, me, target);
  }

  if (me->query_skill("changquan", 1) >= 400
    && me->query("force") > 50) {
    me->add("force", -50);
    msg = HIC "\n【勇气诀．．．．．．．．．．神勇无敌】" NOR "\n" CYN "$N" CYN "叫道：“着”同时，双手交换出拳，一拳比一拳快，当真是有万夫莫敌之气势，将长拳发挥得淋漓尽致，直朝着$n" CYN "而去。\n" NOR;
    fail_msg = HIG "就在$N" HIG "的拳头要击中$n" HIG "的瞬间，$p猛然大叫了一声，$N" HIG "一受惊，一下收了回来。\n" NOR;
    succ_msg = HIC "$n" HIC "向后急退，最后退无可退，硬生生的接了$N" HIC "一拳，只觉得五脏六腑都移了位。\n" NOR;
    me->add_temp("apply/combat_succ", 20);
    me->set_temp("pfm_msg", 1);
    me->set("actions", (: call_other, "/daemon/skill/changquan", "query_action" :));
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      200
    );
    me->set_temp("pfm_msg", 0);
    me->add_temp("apply/combat_succ", -20);
    me->reset_action();
    if (damage < 1)
      message_combatd(fail_msg, me, target);
  }

  if (me->query_skill("bawang-qiang", 1) >= 400
    && me->query("force") > 50) {
    me->add("force", -50);
    msg = HIR "\n【枪字诀．．．．．．．．．．星火燎原】" NOR "\n" RED "$N" RED "暗暗将咒语附着在$w" RED "上，向四周虚刺了几下，所到之处，卷起层层烈焰，象是要把$n吞噬一样,$p的脸被火焰映得通红。\n" NOR;
    fail_msg = HIC "$n" HIC "竟然看出身旁的火焰是幻影，丝毫不受$N" HIC "幻影攻击的影响。\n" NOR;
    succ_msg = HIR "$n" HIR "手足无措，被烈火灼伤了胸部，受到了很大的打击。\n" NOR;
    me->add_temp("apply/combat_succ", 25);
    me->set_temp("pfm_msg", 1);
    me->set("actions", (: call_other, "/daemon/skill/bawang-qiang", "query_action" :));
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      300
    );
    me->set_temp("pfm_msg", 0);
    me->add_temp("apply/combat_succ", -25);
    me->reset_action();
    if (damage < 1)
      message_combatd(fail_msg, me, target);
  }

  if (me->query_skill("sanban-axe", 1) >= 400
    && me->query("force") > 50) {
    me->add("force", -50);
    msg = HIB "\n【斧字诀．．．．．．．．．．力劈山河】" NOR "\n" BLU "$N" BLU "突然暴喝一声，将手中$w" BLU "斜向上举起，然后在半空中划出一道圆弧，随即径直斜下斩向$n" BLU "！\n" NOR;
    fail_msg = HIM "$n" HIM "急忙飞身向后跃出数丈，才勉强躲闪过这致命一击。\n" NOR;
    succ_msg = HIB "结果一道寒光从$n" HIB "当头劈过,带出一地鲜血。\n" NOR;
    me->add_temp("apply/combat_succ", 30);
    me->set_temp("pfm_msg", 1);
    me->set("actions", (: call_other, "/daemon/skill/sanban-axe", "query_action" :));
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      300
    );
    me->set_temp("pfm_msg", 0);
    me->add_temp("apply/combat_succ", -30);
    me->reset_action();
    if (damage < 1)
      message_combatd(fail_msg, me, target);
  }

  if ((me->query_skill("wusi-mace", 1) >= 400
    || me->query_skill("jinglei-mace", 1) >= 400)
    && me->query("force") > 50) {
    me->add("force", -50);
    msg = HIG "\n【无私诀．．．．．．．．．．海纳百川】" NOR "\n" NOR "$N抛起$w，合手念起八卦咒，彷佛化作大海，四周灵气向$P奔流而来。$n周身精气蠢蠢欲动，惊吓之下脸色变得苍白。\n" NOR;
    fail_msg = HIR "想不到$n" HIR "逆转心法，硬是抗下了$N" HIR "海纳百川的绝学。\n" NOR;
    succ_msg = HIG "$n" HIG "抵挡不住，只得拼命咬破舌尖，激发潜力平息了精气的骚动。\n" NOR;
    me->add_temp("apply/combat_succ", 35);
    me->set_temp("pfm_msg", 1);
    if (me->query_skill("wusi-mace", 1) >= 400)
      me->set("actions", (: call_other, "/daemon/skill/wusi-mace", "query_action" :));
    else me->set("actions", (: call_other, "/daemon/skill/jinglei-mace", "query_action" :));
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      400
    );
    me->set_temp("pfm_msg", 0);
    me->add_temp("apply/combat_succ", -35);
    me->reset_action();
    if (damage < 1)
      message_combatd(fail_msg, me, target);
  }

  me->start_busy(3);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @LONG
        外功名称：浑然天成
        外功所属：惊雷鞭法
        外功效果：连续攻击对方，命中递增
        	  每增加一击，内力消耗增加50点
                  使用后自身busy 3 秒
        外功条件：
                  人物等级40级
                  内力800点，消耗100点
                  冷泉神功400级并激发
                  惊雷锏法400级并激发
                  
LONG;
  me->start_more(str);
  return 1;
}
