//符水	符类法术伤害+5%
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int valid_cast(object me) {
  if (me->query("family/family_name") != "将军府")
    return notify_fail("这是将军府不传之密！\n");
  if (me->query_level() < 30)
    return notify_fail("你的人物等级不够。\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够了！\n");
  if (me->query("kee") < 200)
    return notify_fail("你现在气血不足，画不了符。\n");
  if (time() < me->query_temp("jjf_rain") + 6)
    return notify_fail("你刚刚画过「神霄雨法符」。\n");
  if (me->query_skill("baguazhou", 1) < 300)
    return notify_fail("你的八卦咒等级不够。\n");
  if (me->query_temp("jjf_raining"))
    return notify_fail("你已经祭出「神霄雨法符」了。\n");
  return 1;
}

void rain(object me, object *tmp) {
  int i;
  object *inv, *team, leader;
  if (!me)
    return;
  if (me->query("mana") < 100 || me->query_temp("jjf_raining") <= 0
    || !tmp || !arrayp(tmp) || sizeof(tmp) < 1) {
    message("vision", HIC + me->name() + HIC "收起「神霄雨法符」的效果。\n" NOR, environment(me), ({ me }));
    tell_object(me, HIC "你收起「神霄雨法符」的效果。\n" NOR);
    me->set_temp("jjf_rain", time());
    me->delete_temp("jjf_raining");
    return;
  }
  if (!objectp(leader = me->query_leader())
    || !pointerp(team = leader->query_team())
    || sizeof(team) < 1) {
    message("vision", HIC + me->name() + HIC "收起「神霄雨法符」的效果。\n" NOR, environment(me), ({ me }));
    tell_object(me, HIC "你收起「神霄雨法符」的效果。\n" NOR);
    me->set_temp("jjf_rain", time());
    me->delete_temp("jjf_raining");
    return;
  }
  inv = all_inventory(environment(me));
  for (i = 0; i < sizeof(inv); i++) {
    if (!living(inv[i]) || member_array(inv[i], team) == -1
      || member_array(inv[i], tmp) == -1)
      continue;
    if (inv[i]->query("eff_kee") < inv[i]->query_maxkee()
      || inv[i]->query("eff_sen") < inv[i]->query_maxsen()
      || inv[i]->query("kee") < inv[i]->query("eff_kee")
      || inv[i]->query("sen") < inv[i]->query("eff_sen")) {
      message_combatd(HIG "$N" HIG "沐浴在一阵春雨中，感觉整个人焕然一新。\n" NOR, inv[i]);
      inv[i]->receive_curing("kee", 50);
      inv[i]->receive_curing("sen", 50);
      inv[i]->receive_heal("kee", 100);
      inv[i]->receive_heal("sen", 100);
      me->add("mana", -10);
    }
  }
  me->add_temp("jjf_raining", -3 - random(3));
  call_out("rain", 5, me, tmp);
}

int cast(object me, object target) {
  int damage, i;
  object seal, *inv, leader, *tmp, *team;
  string msg;

  if (!valid_cast(me))
    return 0;
  seal = present("paper seal", me);
  if (!seal || base_name(seal) != "/obj/paper_seal")
    return notify_fail("你身上没有桃符纸，如何画符？\n");

  message_vision("$N咬破手指，伸手在桃符纸上画了几下。\n", me);
  me->add("mana", -100);
  me->receive_damage("kee", 100, me);
  me->set_temp("jjf_raining", me->query_skill("spells") / 10);
  if (seal->query_amount() < 2)
    destruct(seal);
  else seal->add_amount(-1);
  if (me->is_fighting())
    me->start_busy(3);

  msg = HIC "$N" HIC "大喊一声“着”，手一挥，祭出了一张神霄雨法符！「呼」地一下飞到半空，化作一阵春雨，淅淅沥沥落将下来。\n" NOR;
  message_vision(msg, me);
  tmp = ({});
  tmp += ({ me });
  if (objectp(leader = me->query_leader())
    && pointerp(team = leader->query_team())
    && sizeof(team) > 1) {
    inv = all_inventory(environment(me));
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == me
        || !living(inv[i])
        || member_array(inv[i], team) == -1)
        continue;
      tmp += ({ team[i] });
    }
  }
  call_out("rain", 0, me, tmp);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        法术名称：神霄雨法符
        法术所属：八卦咒
        法术效果：一定时间内每5秒在自身所在区域内治疗自身与队友的气血、精神
                  状态结束后冷却时间 6 秒
                  战斗中使用自身busy3秒
        法术条件：
                  将军府弟子
        	  人物等级30级
        	  需要桃符纸
                  法力500点，消耗100点
                  气血200点，消耗100点
                  八卦咒300级
STR;
  me->start_more(str);
  return 1;
}
