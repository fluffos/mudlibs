//Cracked by Roath
// gouhun.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int cast(object me, object target) {
  string msg, succ_msg;
  int success_adj, damage_adj, dd;

  success_adj = 50;
  damage_adj = 900;

  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill("gouhunshu", 1) < 200)
    return notify_fail("你的勾魂术还不够娴熟。\n");
  if (me->query("family/family_name") != "阎罗地府")
    return notify_fail("你不是地府弟子，不能使用这项技能！\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("现在你自己就魂不守舍！\n");
  if (time() < me->query_temp("last_hell_gouhun") + 6)
    return notify_fail("你不能频繁使用勾魂咒。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要勾谁的魂？\n");

  me->add("mana", -200);
  me->receive_damage("sen", 50);

  if (random(me->query_maxmana()) < 50) {
    write("这次是鬼见鬼了！\n");
    return 1;
  }

  me->set_temp("last_hell_gouhun", time());
  msg = HIB "$N" HIB "对$n" HIB "阴阴地笑着：阎王叫你三更死，不敢留你到五更。。。\n" NOR;
  succ_msg = HIR "结果$n" HIR "受到$N" HIR "影响，显然有点魂不守舍了！\n" NOR;
  me->add_temp("apply/spells_succ", success_adj);
  me->set_temp("pfm_msg", 1);
  dd = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    "头部",
    damage_adj,
    "sen"
  );
  me->set_temp("pfm_msg", 0);
  me->add_temp("apply/spells_succ", -success_adj);

  if (dd < 1) {
    message_combatd(HIC "但是$n" HIC "神情专注，对$N" HIC "理都不理。\n" NOR, me, target);
    me->add_temp("last_hell_gouhun", 3);
  }
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @LONG
        法术名称：勾魂咒
        法术所属：勾魂术
        法术效果：对敌人的心智给予强力的打击
                  冷却 6 秒，失败则增加3秒
        法术条件：
        	  人物等级20级
        	  阎罗(出师)弟子
                  法力500点，消耗100点
                  精神100点，消耗50点     
                  勾魂术200级
LONG;
  me->start_more(str);
  return 1;
}
