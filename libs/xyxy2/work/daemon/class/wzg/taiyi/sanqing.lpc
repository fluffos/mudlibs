// sanqing.c 一气化三清
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me) {
  if (me) {
    me->delete_temp("pfm_action");
    me->delete_temp("cast_action");
    me->delete_temp("wzg_sanqing");
    me->set_temp("wzg_huasanqing", time());
    message_vision("$N收起了三清法身。\n", me);
  }
}

varargs void sanqing(object me, object target, object weapon, int damage) {
  int i, dd;
  string msg, succ_msg;
  if (!me)
    return;
  if (me->query_temp("wzg_sanqing") <= 0) {
    remove_effect(me);
    return;
  }
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target)
    || !living(me))
    return;

  me->add_temp("wzg_sanqing", -1);
  i = me->query_temp("wzg_sanqing") % 4;
  //tell_object(me,sprintf(REV HIW"i=%d/%d"NOR"\n"NOR,i,(int)me->query_temp("wzg_sanqing")));
  if (i == 0)
    return;
  switch (i) {
    case 1:
      msg = "\n" NOR REV HIG "      混元初判道如先，常有常无得自然；紫气东来三万里，函关初度五千年。      \n" NOR HIC "$N" HIC "背后隐现一尊头戴九云冠，穿大红白鹤绛绡衣，骑兽仗剑的道尊，随势朝$n" HIC "也刺一剑！\n" NOR;
      succ_msg = ({
        HIR "结果「噗」地一声刺入了$n" HIR "$l寸许！\n" NOR,
        HIR "结果「噗」地一声刺进$n" HIR "的$l，使$p不由自主地退了步！\n" NOR,
        HIR "结果「噗嗤」地一声，这一剑" HIR "已在$n" HIR "$l刺出一个血肉模糊的血窟窿！\n" NOR,
        HIR "结果只听见$n" HIR "一声惨嚎，这一剑已在$p的$l对穿而出，鲜血溅得满地！\n" NOR,
      })[random(4)];
      break;
    case 2:
      msg = "\n" NOR REV HIG "      函关初出至昆仑，一统华夷属道门；我体本同天地老，须弭山倒性还存。      \n" NOR HIC "$N" HIC "背后隐现一尊头戴如意冠，身穿淡黄八卦衣，骑天马的道尊，随势将手中灵芝如意朝$n" HIC "一砸！\n" NOR;
      succ_msg = ({
        HIR "结果砸个正着，$n" HIR "闷哼一声显然吃了不小的亏！\n" NOR,
        HIR "结果「砰」地一声，$n" HIR "疼得连腰都弯了！\n" NOR,
        HIR "结果这一下「轰」地一声砸得$n" HIR "眼冒金星，差一点摔倒！\n" NOR,
        HIR "结果只听见「轰」地一声巨响，$n" HIR "被砸得血肉模糊，惨不忍睹！\n" NOR,
      })[random(4)];
      break;
    default:
      msg = "\n" NOR REV HIG "      混沌从来不计年，鸿蒙剖处我居先；叁同先天地玄黄理，任我傍门望眼穿。    \n" NOR HIC "$N" HIC "背后隐现一尊头戴九霄冠，身穿八宝万寿紫霞衣，骑地狮的道尊，随势将左手龙须扇朝$n" HIC "一扇，又将右手三宝玉如意朝$p祭去！\n" NOR;
      succ_msg = ({
        HIR "结果一击命中，$n" HIR "闷哼了一声显然吃了不小的亏！\n" NOR,
        HIR "结果这一下「砰」地一声打得$n" HIR "连退了好几步，差一点摔倒！\n" NOR,
        HIR "结果只听见「砰」地一声巨响，$n" HIR "像一捆稻草般飞了出去！\n" NOR,
      })[random(3)];
      break;
  }
  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 100);
  dd = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST_2,
    msg,
    succ_msg,
    0,
    0,
    "kee"
  );
  me->add_temp("apply/attack", -100);
  me->delete_temp("pfm_msg");
  if (dd < 1)
    message_vision(HIC "却被$N" HIC "及时闪过。\n" NOR, target);
}

int cast(object me, object target) {
  string msg;

  if (me->query_level() < 30)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("family/family_name") != "五庄观"
    && me->query("chushi/chushi_wzg") != "yes")
    return notify_fail("这是五庄观绝学。\n");
  if ((int)me->query("mana") < 300)
    return notify_fail("你的法力不够！\n");
  if ((int)me->query_skill("taiyi", 1) < 180)
    return notify_fail("你的太乙仙法还不到家，无法使用「一气化三清」！\n");
  if (me->query_temp("wzg_sanqing") > 0)
    return notify_fail("你已经施展了「一气化三清」。\n");

  msg = HIC "\n$N" HIC "口中念诀，脚踏奇门，身形一转，背后隐隐有三尊道尊虚像一闪！\n\n" NOR;
  message_vision(msg, me);
  me->add("mana", -200);
  me->set_temp("wzg_sanqing", me->query_skill("spells"));
  me->set_temp("pfm_action", "wzg_sanqing");
  me->set_temp("cast_action", "wzg_sanqing");
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        法术名称：(拟)一气化三清
        法术所属：太乙仙法
        法术效果：凝聚三清法身攻击对方
        法术条件：
        	  五庄观(出师)弟子	
        	  人物等级30级	
                  法力300点，消耗200点
                  太乙仙法 180 级
STR;
  me->start_more(str);
  return 1;
}
