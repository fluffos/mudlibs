// bite.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "火球术"; }

int cast(object me, object my_zhu, object target) {
  object zhu;
  int success_adj, damage_adj, damage;
  string msg, succ_msg;

  success_adj = 50;
  damage_adj = 300;

  if (!my_zhu || !present(my_zhu, me))
    return 0;

  if (me->query_level() < 10)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够！\n");
  if (time() < me->query_temp("huoqingzhu_huoqiu") + 5)
    return notify_fail("你不能频繁使用「" + name() + "」。\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展「" + name() + "」？\n");

  if (objectp(zhu = present("huo lingzhu", target))
    && zhu->query("equipped"))
    return notify_fail("对方身携" HIR "火灵珠" NOR "，你无法施展「" + name() + "」。\n");

  me->add("mana", -250);

  msg = HIR "火灵珠猛然红光四射，半空中浮现出一个赤红的三丈巨人，双手一圈，一个硕大的火球冲着$n" HIR "飞去！\n" NOR;
  succ_msg = HIC "结果$n" HIC "躲避不及，被火球撞个正着！须发尽焦。\n" NOR;

  me->set_temp("huoqingzhu_huoqiu", time());
  me->add_temp("apply/spells_succ", success_adj);
  me->set_temp("pfm_msg", 1);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_CAST,
    msg,
    succ_msg,
    0,
    damage_adj,
    "kee"
  );
  me->add_temp("apply/spells_succ", -success_adj);
  me->delete_temp("pfm_msg");
  if (damage < 1)
    message_vision(HIC "$N" HIC "连忙一侧身闪在一旁。\n" NOR, target);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        法术名称：火球术
        法术所属：火灵珠
        法术效果：法术攻击，固定伤害300点
        	  冷却时间5秒
        法术条件：
        	  人物等级10级
                  法力500点，消耗250点
                  
STR;
  me->start_more(str);
  return 1;
}
