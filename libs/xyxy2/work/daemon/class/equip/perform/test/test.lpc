#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "装备绝招(测试)"; }

int perform(object me, object target) {
  string msg, succ_msg;

  if (me->query_level() < 10)
    return notify_fail("你的人物等级不够。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不够！\n");
  if (time() < me->query_temp("lingzhu_test") + 5)
    return notify_fail("你不能频繁使用「" + name() + "」。\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展「" + name() + "」？\n");

  me->add("force", -100);
  msg = HIC "测试绝招：绝招描述。\n" NOR;
  succ_msg = HIR "测试绝招：绝招命中。\n" NOR;
  me->set_temp("lingzhu_test", time());
  me->set_temp("pfm_msg", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM, msg, succ_msg);
  me->delete_temp("pfm_msg");
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：装备绝招(测试)
        外功所属：---
        外功效果：---
        	  冷却时间5秒
        外功条件：
        	  人物等级10级
                  内力500点，消耗100点
                  
STR;
  me->start_more(str);
  return 1;
}
