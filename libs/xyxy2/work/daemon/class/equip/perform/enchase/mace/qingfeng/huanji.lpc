#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "缓中有急"; }

int perform(object me, object equip, object target) {
  mapping *acs;
  object weapon;
  string msg;
  int lvl;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("清风"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 15)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)
    || target->is_ghost())
    return notify_fail("「" HIM "缓中有急" NOR "」只能在战斗中使用！\n");
  if ((int)me->query("force") < 500)
    return notify_fail(HIC "你现在内力不够，没能将「缓中有急」使完！\n" NOR);
  if ((int)me->query_skill("mace") < 200)
    return notify_fail(HIM "你的基本锏法不够娴熟，还使不出「缓中有急」。\n" NOR);
  if ((int)me->query_skill("force") < 200)
    return notify_fail(HIW "你的内功修为火候不够，「缓中有急」不成招式。\n" NOR);
  if (me->query_temp("equip_mace_hj") + 5 > time())
    return notify_fail("你内力使用过度，「" HIM "缓中有急" NOR "」不成招式。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "mace")
    return notify_fail("这是锏法绝招。\n");

  acs = ({
    ([
      "action": "$N身形促进，手中$w带起一阵劲风，朝$n当头扫去。\n",
      "dodge": -5,
      "parry": -25,
      "damage": 80,
      "force": 50,
      "damage_type": "砸伤"
    ]),
    ([
      "action": "\n$N猛吸一口真气，身形暴长，似乎瞬息间长高了一个头。借此威猛之势，手中$w向$n兜头盖脑地砸去。\n",
      "dodge": -15,
      "parry": -35,
      "damage": 95,
      "force": 75,
      "damage_type": "砸伤"
    ]),
    ([
      "action": "\n$N气运丹田，一声怒吼，好似平地起了个焦雷，震得$n耳中嗡嗡直响。趁此良机，$N抡起手中$w，砸向$n的$l。\n",
      "dodge": -25,
      "parry": -55,
      "damage": 105,
      "force": 85,
      "damage_type": "砸伤"
    ]),
  });

  if (COMBAT_D->query_message_type(me, target) > 0)
    message_vision(HIR "$N" HIR "对$n" HIR "使出了「" HIY "缓中有急" HIR "」一招！\n" NOR, me, target);
  else {
    msg = HIY "$N" HIR "手中" + weapon->name(1) + HIY "劲芒跃动，金光暴长，渐渐逼近$n" HIY "，只这一刹，漫天锏影变幻莫测，突来三招，有始有终，有缓有急，循序而来！\n" NOR;
    message_vision(msg, me, target);
  }
  me->add("force", -200);
  me->set_temp("equip_mace_hj", time());
  me->add_temp("apply/attack", lvl * 30);

  me->set_temp("pfm_color", HIY);
  me->set("actions", acs[0]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  me->set("actions", acs[1]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  me->set("actions", acs[2]);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);

  me->add_temp("apply/attack", -lvl * 30);
  me->delete_temp("pfm_color");
  me->reset_action();
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：缓中有急
        外功所属：清风符(镶嵌)
        外功效果：物理攻击对方3次
        	  冷却5秒
        法术条件：
        	  人物等级15级
                  内力500点，消耗200点
                  有效锏法200级
                  有效内功200级

STR;
  me->start_more(str);
  return 1;
}
