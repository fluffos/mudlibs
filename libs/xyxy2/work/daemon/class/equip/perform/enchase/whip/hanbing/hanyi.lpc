//寒意连绵
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "寒意连绵"; }

void hanyi(object me, object victim, object weapon, int damage) {
  if (!me || !victim || !me->is_killing(victim->query("id"))
    || !living(me))
    return;
  if (damage <= 0)
    return;
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "whip")
    return;
  if (victim->is_busy())
    return;
  victim->start_busy(random(2));
  message_vision(WHT + weapon->name() + WHT "散发着丝丝寒意，$N" WHT "冷不丁打了个冷战。" NOR "\n", victim);
}

mapping *action = ({
  ([ "action": "\n",
    "damage": 50,
    "force": 30,
    "parry": -50,
    "dodge": -50,
    "post_action": (: call_other, __FILE__, "hanyi" :),
    "damage_type": "抽伤"
  ]),
  ([ "action": "\n",
    "damage": 50,
    "force": 50,
    "parry": -80,
    "dodge": -80,
    "post_action": (: call_other, __FILE__, "hanyi" :),
    "damage_type": "抽伤"
  ]),
  ([ "action": "\n",
    "damage": 50,
    "force": 80,
    "parry": -100,
    "dodge": -100,
    "post_action": (: call_other, __FILE__, "hanyi" :),
    "damage_type": "抽伤"
  ]),
});

int perform(object me, object equip, object target) {
  object weapon;
  int damage, i, lvl;
  string msg, succ_msg;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("寒冰"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (me->query_skill("whip", 1) < 200)
    return notify_fail("你的基本鞭法太差。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("「寒意连绵」是鞭子的绝招。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招「寒意连绵」？\n");

  message_vision(
    "\n" WHT "$N" WHT "双眼漠然，浑身散发丝丝清冷气息，" + weapon->name(1) + WHT "一式「寒意连绵」，络绎而出。\n" NOR,
    me
  );
  me->add("force", -200);
  me->set_temp("pfm_msg", 1);
  me->add_temp("apply/attack", 10);

  damage = 200;

  msg = HIB "$N" HIB "向前迈一步，平无华地挥出一鞭，慢，却噼啪作响。这一招『清曼念寒』拼的是内力。\n" NOR;
  succ_msg = HIC "$n" HIC "只觉得一股劲气象化作千百枚细针一样，穿体而过！“哇”的一声，喷出一大口鲜血，看来是受了内伤！\n" NOR;
  me->set("actions", action[0]);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    succ_msg,
    0,
    damage
  );
  if (damage < 1)
    message_combatd(CYN "$n" CYN "忙运功相抗，深厚的内力将$N" CYN "的漫天鞭影都击散了。\n" NOR, me, target);
  else if (!target->is_busy())
    target->start_busy(1);

  if (lvl > 1) {
    msg = HIM "$N" HIM "由静转动，一动便急如风，脚踏奇门，鞭走奇招，每一鞭从$n" HIM "意想不到的方位无声无息地挥出！这一招『岁冰勿暖』斗的是鞭法！\n" NOR;
    succ_msg = HIC "$n" HIC "马上手忙脚乱，不知该如何去招架这静若幽冥、快如风的鞭法！果不然，$w" HIC "招招命中，$n" HIW "浑身上下被抽得遍体鳞伤！\n" NOR;
    damage = 200;
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      0,
      damage
    );
    if (damage < 1)
      message_combatd(CYN "$n" CYN "却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N" CYN "这无声的攻势。\n" NOR, me, target);
    else if (!target->is_busy())
      target->start_busy(2);
  }

  if (lvl > 2) {
    msg = HIW "$N" HIW "突然收住身形，回步而立，收鞭于背后，无招胜有招，无形胜有形。这一招『寒夜独寤』比的是经验！\n" NOR;
    succ_msg = HIC "$n" HIC "果然上当，急忙上前想抢攻。$N" HIC "微微一笑，$w" HIC "一抖，直探$n" HIC "的胸口。$n" HIC "连鞭影还没看到，就差点儿被穿的透心凉！\n" NOR;
    damage = 200;
    damage = COMBAT_D->do_attack(
      me,
      target,
      me->query_temp("weapon"),
      TYPE_PERFORM,
      msg,
      succ_msg,
      "胸口",
      damage
    );
    if (damage < 1)
      message_combatd(HIC "$n" HIC "看破了这招的虚实，不慌不忙将之消得无形！\n" NOR, me, target);
    else if (!target->is_busy())
      target->start_busy(3);
  }

  me->add_temp("apply/attack", -10);
  me->delete_temp("pfm_msg");
  me->reset_action();
  me->start_busy(2);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：丝丝入扣
        外功所属：寒冰符(镶嵌)
        外功效果：物理攻击对方1-3次
                  有几率使对方busy1-3秒
        	  自身busy2秒
        法术条件：
        	  人物等级20级
                  内力400点，消耗200点
                  基本鞭法200级

STR;
  me->start_more(str);
  return 1;
}
