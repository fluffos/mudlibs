#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() { return "混世戾斩"; }

int perform(object me, object equip, object target) {
  mapping *acs;
  object weapon;
  string succ_msg, msg;
  int damage, lvl;

  if (!equip || !present(equip, me))
    return 0;
  if (!intp(lvl = equip->query_fu_level("血石"))
    || lvl < 1)
    return 0;
  if (me->query_level() < 20)
    return notify_fail("你的人物等级不够。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)
    || target->is_ghost())
    return notify_fail("「" HIR "混世戾斩" NOR "」只能在战斗中使用！\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你现在内力不够，没能将「混世戾斩」使完！\n");
  if ((int)me->query_skill("axe", 1) < 200)
    return notify_fail("你的基本斧法不够娴熟，还使不出「混世戾斩」。\n");
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你的内功修为火候不够，「混世戾斩」不成招式。\n");
  if (me->query_temp("equip_axe_hs") + 6 > time())
    return notify_fail("你内力使用过度，「" HIR "混世戾斩" NOR "」不成招式。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") != "axe")
    return notify_fail("「" HIR "混世戾斩" NOR "」是斧子的绝招。\n");

  acs = ({
    ([
      "action": "\n",
      "dodge": -35,
      "parry": -55,
      "damage": 250,
      "force": 150,
      "damage_type": "劈伤"
    ]),
  });

  if (lvl > 2)
    lvl = 2;
  me->add("force", -200);
  me->add_temp("apply/attack", lvl * 15);
  me->set_temp("pfm_msg", 1);
  me->set_temp("equip_axe_hs", time());

  msg = "\n" HIR "只听一声爆喝，$N" HIR "双臂肌肉盘虬，手持$w" HIR "好好跃起，催动浑身气血，使出一招焚天化地的混世绝杀！\n" NOR;
  msg += HIY "       ┏━┓    ┏━┓    ┏━┓    ┏━┓\n" NOR;
  msg += HIY "       ┃" HIB "混" HIY "┃    ┃" HIW "世" HIY "┃    ┃" HIR "戾" HIY "┃    ┃" NOR RED "斩" NOR HIY "┃\n" NOR;
  msg += HIY "       ┗━┛    ┗━┛    ┗━┛    ┗━┛\n" NOR;
  succ_msg = HIR "$n" HIR "为$N" HIR "气势所慑，竟然楞在当地，忘了招架。说时迟，那时快，这一招已在$p身上当胸穿过！\n" NOR;
  damage = lvl * 800;
  me->set("actions", acs[0]);
  damage = COMBAT_D->do_attack(
    me,
    target,
    me->query_temp("weapon"),
    TYPE_PERFORM,
    msg,
    succ_msg,
    0,
    damage
  );
  if (damage < 1)
    message_combatd(HIB "$n" HIB "一见情势不妙，连忙就地一滚，于千钧一发之际躲过此雷霆一击。\n" NOR, me, target);

  me->add_temp("apply/attack", -lvl * 15);
  me->delete_temp("pfm_msg");
  me->reset_action();
  me->start_busy(1);
  return 1;
}

int help(object me) {
  string str;
  if (!me) return 0;
  str = @STR

        外功名称：混世戾斩
        外功所属：血石符(镶嵌)
        外功效果：强力攻击对方一次
        	  冷却6秒，自身busy1秒
        法术条件：
        	  人物等级20级
                  内力800点，消耗200点
                  基本斧法200级
                  基本内功200级

STR;
  me->start_more(str);
  return 1;
}
