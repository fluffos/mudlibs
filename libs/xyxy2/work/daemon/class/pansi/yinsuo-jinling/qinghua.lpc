//windflower.c,盘丝情花阵
//created by foc,30-6-01
//edit by qingniu,2009
//特点说明：防御力与攻击力兼具的pfm
#include <ansi.h>
#include <combat.h> 
inherit SSERVER;

void remove_effect(object me, int damage); 
int perform(object me, object target)
{
        int damage, succ, number, num, t;
	object weapon;
	string msg,succ_msg;

	if( me->query_level()<40 )
		return notify_fail("你的人物等级不够。\n");
        if( time()<me->query_temp("WF_busy")+6 )
                return notify_fail("绝招用多就不灵了。\n");
        if((int)me->query_skill("yinsuo-jinling",1)<300)
                return notify_fail("你的银索金铃等级不够。\n");
        if( !objectp(weapon=me->query_temp("weapon")) 
         || weapon->query("skill_type")!="whip" )
         	return notify_fail("你的鞭呢？\n");
        if( !target ) target = offensive_target(me);
        if( !target
         || !target->is_character()
         || target->is_corpse()
         || target==me
         || !me->is_fighting(target) )
                return notify_fail("你要对谁使用「盘丝情花阵」？\n");

	if( (int)me->query("force")<400 ) 
		return notify_fail("你的内力不足，怎么用这招？\n");

	me->set_temp("WF_busy",time());
        damage = COMBAT_D->valid_damage(me,target,"whip",TYPE_CAST);
        if( damage<1500 )
		damage = 1500;
	me->add("force",-100);
        msg = HBBLU+HIG"$N"NOR HBBLU HIG"将手中$w"NOR HBBLU HIG"一抛，那$w"NOR HBBLU HIG"居然围绕着$P旋转起来，强大的妖气形成了如刀般的气流，四射而开。"NOR"\n";
        msg = replace_string(msg,"$w",weapon->query("name"));
	succ_msg = HBBLU HIR"结果$n"NOR HBBLU HIR"惨叫一声，身上已经被划出了几十道深可见骨的伤口！"NOR"\n";
	succ = COMBAT_D->attack_percent(me,target,TYPE_CAST);
	
	message_vision(msg,me,target);
	if( succ>0 )
	{
		if( COMBAT_D->query_message_type(me,target)<2 )
			message_vision(succ_msg,me,target);
		else if( COMBAT_D->query_message_type(me,target)==2 )
			message_vision(HBBLU HIR"结果对$N"NOR HBBLU HIR"造成了"HIY+damage+HIR"点气血减少、"HIY+(damage/2)+HIR"点气血损伤。"NOR"\n",target);
		
		target->receive_wound("kee",damage,me,TYPE_CAST);
                target->receive_damage("kee",damage,me,TYPE_CAST);
                COMBAT_D->report_status(target); 
                COMBAT_D->report_status(target,1); 
        }
        else	message_combatd(HBBLU+HIC"结果被$N"NOR HBBLU HIC"闪开了。"NOR"\n",target);
        
        message_combatd(NOR HBBLU HIC"$N"NOR HBBLU HIC"从头发里拿出一粒种子，运上妖力。那种子立刻变成了一朵漂亮的情花。"NOR"\n",me,target);
        me->add("force",-50);
        message_combatd(NOR HBBLU HIC"$N"NOR HBBLU HIC"将那情花一甩，无数的花瓣从那情花上分出来，好象无穷无尽一般。"NOR"\n",me,target);
        message_vision("\n"NOR HBBLU HIY"$N"NOR HBBLU HIY"大喝一声：“盘丝情花阵！”浑身的妖气发生了变化！"NOR"\n",me);
        
        msg = NOR HBBLU HIW"$N"NOR HBBLU HIW"的全身放出红色的妖气，旋转加剧，最后变成了围绕全身的白色气流，声势惊人。那些情花花瓣立刻随之旋转着四射而开，带着如刀般的锐利妖气袭向$n"NOR HBBLU HIW"！"NOR"\n";
        number = damage/100+1;
        number = number/2+random(number/2)+1;
        succ_msg = NOR HBBLU HIR"结果$n"NOR HBBLU HIR"躲闪不及，身上"+chinese_number(number)+"处中了妖气所化的情花花瓣！"NOR"\n";
        me->add_temp("apply/attack",80);
        me->set_temp("pfm_msg",1);
        damage = COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_CAST,msg,succ_msg,0,damage,"kee");
        me->add_temp("apply/attack",-80);
        me->set_temp("pfm_msg",0);
        if( damage<1 )
        	message_combatd(NOR HBBLU HIG"但是$N"NOR HBBLU HIG"连跳带滚，总算躲了过去。"NOR"\n",target);
        message_vision(NOR HBBLU HIW"$N"NOR HBBLU HIW"将妖气一收，花瓣突地都消失不见了。"NOR"\n",me);
        return 1;
}

int help(object me)
{
        string str;
        if( !me )  return 0;
        str = @STR

        外功名称：盘丝情花阵
        外功所属：银索金玲
        外功效果：法术型气血伤害
                  冷却6秒
        外功条件：
                  盘丝洞弟子
        	  人物等级40级
                  内力400点，消耗150点
                  银索金铃300级并激发
STR;
        me->start_more(str);
        return 1;
}