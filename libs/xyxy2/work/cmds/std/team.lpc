// team.c
#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);

void remove_temp(object who) {
  if (who) {
    who->delete_temp("pending/team");
    who->delete_temp("pending/team_to");
  }
}

int team_name(object who, string arg) {
  object *t;
  int i;
  string name, n;
  if (!pointerp(t = who->query_team()))
    return notify_fail("你没有组队。\n");
  if (who != who->query_leader())
    return notify_fail("你不是队长。\n");
  name = who->query_team_name();
  if (name && name != "默认组队")
    return notify_fail("你已设置战队名为：" + name + "。\n");
  name = COLOR_D->replace_color(arg);
  name = COLOR_D->clean_color(name);
  if (!LOGIN_D->check_legal_name(name))
    return 0;
  arg = COLOR_D->replace_color(arg, 2);
  who->set_team_name(arg);
  who->team_talk(who->name() + HIW "将队伍名称设置为" HIC "「" NOR + arg + NOR HIC "」" HIW "。");
  for (i = 0; i < sizeof(t); i++) {
    if (t[i] && t[i] != who)
      t[i]->set_team_name(arg);
  }
  return 1;
}

string query_team_hp(object who) {
  if (!who)
    return "";
  return sprintf(HIG "血 " HIR "%3d%%" HIY "/" HIR "%3-d%%  " HIG "精 " HIR "%3d%%" HIY "/" HIR "%3-d%%" NOR,
    who->query("kee") * 100 / who->query("eff_kee"),
    who->query("eff_kee") * 100 / who->query_maxkee(),
    who->query("sen") * 100 / who->query("eff_sen"),
    who->query("eff_sen") * 100 / who->query_maxsen(),
  );
}

varargs int create_team(object me, string name) {
  object leader;
  string arg;
  if (!me)
    return 0;
  if (environment(me)->query("no_team"))
    return notify_fail("这里不能使用这个命令。\n");
  if (objectp(leader = me->query_leader()))
    return notify_fail("你已经有队伍了。\n");
  if (!name || !stringp(name) || strlen(name) < 2)
    name = "默认组队";
  name = replace_string(name, "$BLINK$", "");
  name = replace_string(name, "$REV$", "");
  name = replace_string(name, "BLINK", "");
  name = replace_string(name, "REV", "");
  name = COLOR_D->replace_color(name, 1);
  arg = COLOR_D->clean_color(name);
  if (!LOGIN_D->check_legal_name(arg))
    return notify_fail(arg + "不符合游戏中设定的名称要求。\n你可以使用默认组队名，命令格式 team create\n");
  me->set_leader(me);
  me->set_team_name(name);
  me->add_team_member(me);
  tell_object(me, HIW "【队伍】你组建了自己的队伍" HIC "「" NOR + name + NOR HIC "」" HIW "。" NOR "\n");
  message(
    "vision",
    HIY + me->name() + HIY "组建了队伍" HIC "「" NOR + name + NOR HIC "」" HIY "。" NOR "\n",
    environment(me),
    me
  );
  return 1;
}

string his_name(object leader) {
  string name;
  if (!leader)
    return "队伍";
  if (!stringp(name = leader->query_team_name())
    || strlen(name) < 2 || name == "默认组队")
    return "队伍";
  else return name;
}

int team_add(object me, object who) {
  string name;
  object *t, leader, *tmp;
  if (!objectp(leader = me->query_leader())
    || leader != me)
    return 0;
  if (!who->set_leader(me))
    return 0;
  if (!me->add_team_member(who))
    return 0;
  if (!pointerp(t = me->query_team()))
    return 0;
  name = his_name(leader);
  tell_object(who, HIW "【队伍】你加入了" + me->name(1) + "的队伍" HIC + "「" + name + HIC "」" HIW "。\n" NOR);
  who->team_talk(who->name(1) + HIW "进入了队伍。" NOR, 1);
  remove_temp(who);
  if (pointerp(tmp = me->query_temp("pending/team"))
    && member_array(who, tmp) != -1) {
    tmp -= ({ who });
    tmp -= ({ 0 });
    if (sizeof(tmp) < 1)
      me->delete_temp("pending/team");
    else me->set_temp("pending/team", tmp);
  }
  return 1;
}

int more_team(object me, object who) {
  string name, str;
  object *t, leader;
  int i;
  if (!me || !who)
    return 0;
  if (!objectp(leader = who->query_leader()))
    return notify_fail((me == who ? "你" : who->name()) + "现在并没有参加任何队伍。\n");
  if (!pointerp(t = leader->query_team()))
    return notify_fail((me == who ? "你" : who->name()) + "现在并没有参加任何队伍。\n");
  str = (me == who ? "你" : who->name()) + "目前的队伍是： ";
  name = his_name(leader);
  str += NOR REV HIR " " NOR " " + name + " " + NOR REV HIR " " NOR "\n";
  str += "   " HIC "队长：" HIG + (leader == me ? "你" : leader->short(1)) + NOR "\n";
  str += "   " HIC "成员：" NOR "\n";
  for (i = 0; i < sizeof(t); i++) {
    if (t[i])
      str += sprintf(
        "        " HIC "%2s" NOR " %16-s " HIR "LVL " NOR HIY "%3-d" NOR " %s\n",
        t[i] == me ? "★" : "  ",
        me == t[i] ? "你" : (t[i]->name() + "(" + capitalize(t[i]->parse_command_id_list()[0]) + ")"),
        t[i]->query_level(),
        query_team_hp(t[i])
      );
  }
  me->start_more(str);
  return 1;
}

int main(object me, string arg) {
  object *t, ob, who, leader;
  int i;
  string name, msg, str;

  if (!arg)
    return more_team(me, me);
  if (arg == "create" || sscanf(arg, "create %s", name) == 1)
    return create_team(me, name);
  if (sscanf(arg, "name %s", arg) == 1)
    return team_name(me, arg);
  if (sscanf(arg, "talk* %s", arg) == 1) {
    string vb, emote_arg;
    if (!objectp(leader = me->query_leader()))
      return notify_fail("你现在并没有参加任何队伍。\n");
    if (!pointerp(t = leader->query_team()))
      return notify_fail("你现在并没有和别人组成队伍。\n");
    if (sscanf(arg, "%s %s", vb, emote_arg) != 2) {
      vb = arg;
      emote_arg = "";
    }
    if (!(msg = EMOTE_D->do_emote(me, vb, emote_arg, HIW, 1, 0, 0)))
      return 0;
    msg = COLOR_D->clean_color(msg);
    me->team_talk(msg);
    return 1;
  } else if (sscanf(arg, "talk %s", arg) == 1) {
    if (!objectp(leader = me->query_leader()))
      return notify_fail("你现在并没有参加任何队伍。\n");
    if (!pointerp(t = leader->query_team()))
      return notify_fail("你现在并没有和别人组成队伍。\n");
    me->team_talk(me->name(1) + HIW "(" + capitalize(me->query("id")) + ")：" + arg);
    return 1;
  } else if (sscanf(arg, "with %s", arg) != 1) {
    if (environment(me)->query("no_team"))
      return notify_fail("这里不能使用这个命令。\n");
    if (arg == "dismiss" || sscanf(arg, "dismiss %s", name) == 1) {
      if (!objectp(leader = me->query_leader()))
        return notify_fail("你现在并没有参加任何队伍。\n");
      if (!pointerp(t = leader->query_team()))
        return notify_fail("你现在并没有参加任何队伍。\n");
      if (arg == "dismiss") {
        if (me == leader) {
          me->team_talk(me->name(1) + HIW "将队伍解散了。" NOR, 1);
          write(HIW "【队伍】你将队伍解散了。\n" NOR);
        } else {
          me->team_talk(me->name(1) + HIW "离开了队伍。" NOR, 1);
          tell_object(me, "你脱离了你的队伍。\n");
        }
        me->dismiss_team();
        return 1;
      } else {
        ob = find_player(name);
        if (!ob || member_array(ob, t) == -1)
          return notify_fail("队伍中没有这个人。\n");
        if (ob == me)
          return main(me, "dismiss");
        if (leader != me)
          return notify_fail("只有队长才有这个权限。\n");
        ob->team_talk(ob->name(1) + HIW "离开了队伍。" NOR, 1);
        tell_object(ob, HIW "【队伍】你被" + me->name(1) + HIW "请出了队伍。\n" NOR);
        tell_object(ob, "你脱离了你的队伍。\n");
        me->dismiss_team(ob);
        return 1;
      }
    } else if (!wizardp(me))
      return help(me);
    if (!(ob = present(arg, environment(me))))
      ob = find_living(arg);
    if (!ob)
      ob = find_player(arg);
    if (!ob)
      return notify_fail("没有" + arg + "这个人。\n");
    return more_team(me, ob);
  }
  if (!(ob = present(arg, environment(me)))
    || !living(ob)
    || !ob->is_character()
    || ob == me)
    return notify_fail("你想和谁做小伙伴？\n");

  if (environment(me)->query("no_team"))
    return notify_fail("这里不能使用这个命令。\n");
  if (!objectp(leader = me->query_leader())) {
    if (!objectp(leader = ob->query_leader()))
      return notify_fail("你要邀请对方加入队伍，首先要建立一个自己的队伍。\n命令格式 team create [队伍名]\n");
    else if (leader != ob)
      return notify_fail("你只能向对方的队长" + leader->name() + "发出申请。\n");
    else {
      if (ob->query_temp("pending/team") && member_array(me, ob->query_temp("pending/team")) != -1)
        return team_add(ob, me);
      if (!objectp(who = me->query_temp("pending/team_to")))
        me->set_temp("pending/team_to", ob);
      else if (who == ob)
        return notify_fail("你已经提出申请了。\n");
      else {
        tell_object(who, HIW "【队伍】" + me->name() + HIW "撤销了入队申请。\n" NOR);
        me->set_temp("pending/team_to", ob);
      }
      tell_object(me, HIW "【队伍】你申请加入" + ob->name() + HIW "的队伍。\n" NOR);
      tell_object(ob, HIW "【队伍】" + me->name() + HIW "申请加入你的队伍。\n" NOR);
      tell_object(
        ob,
        "如果你愿意加入，请用 " HIR "team with " + me->parse_command_id_list()[0] + NOR " 。\n" NOR
      );
      return 1;
    }
  } else if (leader != me)
    return notify_fail("只有队长" + leader->name(1) + "才能邀请他人加入。\n");
  else {
    name = his_name(leader);
    if (me == ob->query_temp("pending/team_to"))
      return team_add(me, ob);
    if (!me->query_temp("pending/team"))
      me->set_temp("pending/team", ({ ob }));
    else if (member_array(ob, me->query_temp("pending/team")) != -1)
      return notify_fail("你已经向" + (ob->query("gender") == "女性" ? "她" : "他") + "发出邀请了。\n");
    else me->add_temp("pending/team", ({ ob }));
    tell_object(me, HIW "【" + name + NOR HIW "】你邀请" + ob->name() + HIW "加入你的队伍。\n" NOR);
    tell_object(
      ob,
      HIW "【队伍】" + me->name() + HIW "邀请你加入其队伍" HIC + "「" + name + NOR HIC "」" HIW "。\n" NOR
    );
    tell_object(
      ob,
      "如果你愿意加入，请用 " HIR "team with " + me->parse_command_id_list()[0] + NOR " 。\n" NOR
    );
    return 1;
  }
}

int help(object me) {
  write(@HELP
队伍指令使用方法:

team <某人>          - 查看某人的队伍组成。
team with <某人>     - 跟某人组成队伍. 必须要双方都同意加入才会生效。
team dismiss <ID>    - 离开队伍. 若下此指令的是领队, 则整个队伍会解散。
                       若领队对队员使用此命令，则将该队员踢出队伍
team talk <讯息>     - 跟队伍里其他的人谈话, 可以用 tt <讯息> 替代。
team name <队伍名称> - 队长给队伍取一个队名
直接下 team 指令时则会显示你目前是否有加入队伍及队员名单。

注: team 跟 follow 是独立的，你不一定要 follow 队伍的领队。
HELP
  );
  return 1;
}

/*
team form <阵法> - 如果队伍的领队学过阵法的话，可以将队伍中的成员组织成
                   某种阵形，组成阵形的状态只要领队一移动就会解除。
*/
