//装备洗炼
#include <ansi.h>
inherit F_DBASE;

string *Armor_Apply = ({
  "force",
  "ad_force",
  "spells",
  "ad_spells",
  "dodge",
  "ad_dodge",
  "parry",
  "ad_parry"
});
string *Weapon_Apply_Axe = ({ "axe", "ad_axe" });
string *Weapon_Apply_Blade = ({ "blade", "ad_blade" });
string *Weapon_Apply_Fork = ({ "fork", "ad_fork" });
string *Weapon_Apply_Hammer = ({ "hammer", "ad_hammer" });
string *Weapon_Apply_Mace = ({ "mace", "ad_mace" });
string *Weapon_Apply_Rake = ({ "rake", "ad_rake" });
string *Weapon_Apply_Spear = ({ "spear", "ad_spear" });
string *Weapon_Apply_Staff = ({ "staff", "ad_staff" });
string *Weapon_Apply_Stick = ({ "stick", "ad_stick" });
string *Weapon_Apply_Sword = ({ "sword", "ad_sword" });
string *Weapon_Apply_Unarmed = ({ "unarmed", "ad_unarmed" });
string *Weapon_Apply_Whip = ({ "whip", "ad_whip" });
mapping equip_apply_prop = ("/cmds/std/look.lpc")->query_euqip_look1();
mapping equip_apply_prop2 = ("/cmds/std/look.lpc")->query_euqip_look2();

void init_apply() {
  string dir, *files, file;
  int i;
  dir = "/daemon/skill/";
  files = get_dir(dir);
  if (!files || !pointerp(files)
    || sizeof(files) < 1)
    return;
  for (i = 0; i < sizeof(files); i++) {
    if (sscanf(files[i], "%s.lpc", file) != 1)
      continue;
    if (!is_chinese(to_chinese(file)))
      continue;
    if (SKILL_D(file)->type() == "shentong"
      || SKILL_D(file)->type() == "knowledge")
      continue;
    if (SKILL_D(file)->valid_enable("dodge")
      || SKILL_D(file)->valid_enable("force")
      || SKILL_D(file)->valid_enable("spells")) {
      if (member_array("ad_" + file, Armor_Apply) == -1)
        Armor_Apply += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("axe")) {
      if (member_array("ad_" + file, Weapon_Apply_Axe) == -1)
        Weapon_Apply_Axe += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("blade")) {
      if (member_array("ad_" + file, Weapon_Apply_Blade) == -1)
        Weapon_Apply_Blade += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("fork")) {
      if (member_array("ad_" + file, Weapon_Apply_Fork) == -1)
        Weapon_Apply_Fork += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("hammer")) {
      if (member_array("ad_" + file, Weapon_Apply_Hammer) == -1)
        Weapon_Apply_Hammer += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("mace")) {
      if (member_array("ad_" + file, Weapon_Apply_Mace) == -1)
        Weapon_Apply_Mace += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("rake")) {
      if (member_array("ad_" + file, Weapon_Apply_Rake) == -1)
        Weapon_Apply_Rake += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("spear")) {
      if (member_array("ad_" + file, Weapon_Apply_Spear) == -1)
        Weapon_Apply_Spear += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("staff")) {
      if (member_array("ad_" + file, Weapon_Apply_Staff) == -1)
        Weapon_Apply_Staff += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("stick")) {
      if (member_array("ad_" + file, Weapon_Apply_Stick) == -1)
        Weapon_Apply_Stick += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("sword")) {
      if (member_array("ad_" + file, Weapon_Apply_Sword) == -1)
        Weapon_Apply_Sword += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("unarmed")) {
      if (member_array("ad_" + file, Weapon_Apply_Unarmed) == -1)
        Weapon_Apply_Unarmed += ({ "ad_" + file });
    }
    if (SKILL_D(file)->valid_enable("whip")) {
      if (member_array("ad_" + file, Weapon_Apply_Whip) == -1)
        Weapon_Apply_Whip += ({ "ad_" + file });
    }
  }
}

void create() {
  set("channel_id", "洗练系统");
  seteuid(getuid());
  init_apply();
}

mixed temp_apply(object obj) {
  string *applys, *apply2;
  int i;
  if (!obj || (!obj->is_armor() && !obj->is_weapon()))
    return 0;
  /*public_apply
		"strength","courage","intelligence","spirituality","composure","personality",
		"constitution","karma","max_kee","max_sen","max_force","max_mana","receive_force",
		"receive_mana","receive_kee","receive_sen","force_recover","fofce_refresh",
		"receive_heal_kee","receive_heal_sen","receive_curing_kee","receive_curing_sen",
		"receive_exercise","receive_meditate",	
	*/
  if (obj->is_armor()) {
    applys = ({
      //public_apply
      "strength", "courage", "intelligence", "spirituality", "composure", "personality",
      "constitution", "karma", "max_kee", "max_sen", "max_force", "max_mana", "receive_force",
      "receive_mana", "receive_kee", "receive_sen", "force_recover", "fofce_refresh",
      "receive_heal_kee", "receive_heal_sen", "receive_curing_kee", "receive_curing_sen",
      "receive_exercise", "receive_meditate",
      //armor
      "combat_damage", "spells_damage", "def_combat", "def_spells", "def_eff_combat",
      "def_eff_spells", "defense", "spells_dodge", "combat_dodge", "re_spells_damage",
      "re_combat_damage",
    });
    apply2 = Armor_Apply;
  } else {
    applys = ({
      //public_apply
      "strength", "courage", "intelligence", "spirituality", "composure", "personality",
      "constitution", "karma", "max_kee", "max_sen", "max_force", "max_mana", "receive_force",
      "receive_mana", "receive_kee", "receive_sen", "force_recover", "fofce_refresh",
      "receive_heal_kee", "receive_heal_sen", "receive_curing_kee", "receive_curing_sen",
      "receive_exercise", "receive_meditate",
      //weapon
      "spells_def", "combat_def", "attack", "spells_succ", "combat_succ", "weapon_break",
      "combat_parry", "re_spells_effdamage", "re_combat_effdamage",

    });
    switch (obj->query("skill_type")) {
      case "axe": apply2 = Weapon_Apply_Axe; break;
      case "blade": apply2 = Weapon_Apply_Blade; break;
      case "fork": apply2 = Weapon_Apply_Fork; break;
      case "hammer": apply2 = Weapon_Apply_Hammer; break;
      case "mace": apply2 = Weapon_Apply_Mace; break;
      case "spear": apply2 = Weapon_Apply_Spear; break;
      case "staff": apply2 = Weapon_Apply_Staff; break;
      case "stick": apply2 = Weapon_Apply_Stick; break;
      case "sword": apply2 = Weapon_Apply_Sword; break;
      case "unarmed": apply2 = Weapon_Apply_Unarmed; break;
      case "whip": apply2 = Weapon_Apply_Whip; break;
      case "rake": apply2 = Weapon_Apply_Rake; break;
      default: return applys;
    }
  }
  if (!apply2 || !arrayp(apply2) && sizeof(apply2) < 1)
    return applys;
  for (i = 0; i < sizeof(apply2); i++) {
    if (member_array(apply2[i], applys) == -1)
      applys += ({ apply2[i] });
  }
  return applys;
}

varargs mixed show_equip(object me, object obj, int f) {
  string str, str2, arg, *temp, *base, type;
  mapping prop, E_temp, base_prop;
  int i;

  if (!me || !obj || !present(obj, me))
    return 0;

  if (!obj->query("combination")) {
    if (obj->is_armor()) {
      if (!mapp(prop = obj->query("armor_prop"))
        || sizeof(prop) < 1) {
        write("装备无属性。\n");
        return 0;
      }
      if (!mapp(base_prop = ("/d/obj/narmor/newcloth.lpc")->equip_base(obj))
        || sizeof(base_prop) < 1) {
        write("装备无基本属性。\n");
        return 0;
      }
    } else {
      if (!mapp(prop = obj->query("weapon_prop"))
        || sizeof(prop) < 1) {
        write("装备无属性。\n");
        return 0;
      }
      if (!mapp(base_prop = ("/d/obj/nweapon/newweapon.lpc")->equip_base(obj))
        || sizeof(base_prop) < 1) {
        write("装备无基本属性。\n");
        return 0;
      }
    }
  } else {
    if (!stringp(type = obj->query("skill_type"))) {
      write("组合武器无类型。\n");
      return 0;
    }
    if (!mapp(prop = obj->query("combination_dbase/" + type + "/weapon_pro"))
      || sizeof(prop) < 1) {
      write("装备无属性。\n");
      return 0;
    }
    if (!mapp(base_prop = obj->query("combination_dbase/" + type + "/base_prop"))
      || sizeof(base_prop) < 1) {
      write("装备无基本属性。\n");
      return 0;
    }
  }

  arg = " " + obj->name() + "\n";
  arg += "基本属性：\n";
  base = keys(base_prop);
  for (i = 0; i < sizeof(base); i++) {
    if (!obj->query("combination")) {
      if (prop[base[i]] == 0)
        continue;
    } else {
      if (base_prop[base[i]] == 0)
        continue;
    }
    if (!undefinedp(equip_apply_prop[base[i]]))
      str = equip_apply_prop[base[i]];
    else if (!undefinedp(equip_apply_prop2[base[i]]))
      str = equip_apply_prop2[base[i]];
    else {
      str = base[i];
      if (is_chinese(to_chinese(str)))
        str = to_chinese(str) + "有效等级";
      else if (sscanf(str, "ad_%s", str2)) {
        if (is_chinese(to_chinese(str2)))
          str = to_chinese(str2) + "技能等级";
      }
    }
    str2 = sprintf(
      "%d%s",
      base_prop[base[i]] >= 0 ? base_prop[base[i]] : -base_prop[base[i]],
      !undefinedp(equip_apply_prop2[base[i]]) ? "%" : "点"
    );
    arg += sprintf(
      "      %20s : " HIR "%s" HIY "%s" NOR "\n",
      str,
      base_prop[base[i]] > 0 ? "+" : "-",
      str2
    );
    str = str2 = "";
  }

  temp = keys(prop);
  arg += "可洗炼属性：\n";
  E_temp = ([]);
  for (i = 0; i < sizeof(temp); i++) {
    if (prop[temp[i]] == 0)
      continue;
    if (member_array(temp[i], base) != -1)
      continue;
    if (!undefinedp(equip_apply_prop[temp[i]]))
      str = equip_apply_prop[temp[i]];
    else if (!undefinedp(equip_apply_prop2[temp[i]]))
      str = equip_apply_prop2[temp[i]];
    else {
      str = temp[i];
      if (is_chinese(to_chinese(str)))
        str = to_chinese(str) + "有效等级";
      else if (sscanf(str, "ad_%s", str2)) {
        if (is_chinese(to_chinese(str2)))
          str = to_chinese(str2) + "技能等级";
      }
    }
    str2 = sprintf(
      "%d%s",
      prop[temp[i]] >= 0 ? prop[temp[i]] : -prop[temp[i]],
      !undefinedp(equip_apply_prop2[temp[i]]) ? "%" : "点"
    );
    arg += sprintf(
      "      %20s : " HIR "%s" HIY "%s" NOR "\n",
      str,
      prop[temp[i]] > 0 ? "+" : "-",
      str2
    );
    E_temp[str] = temp[i];
    str = str2 = "";
  }
  if (!f)
    return E_temp;
  write(arg);
  return 0;
}

string query_prop_name(string data) {
  mapping all_prop = ("/cmds/std/look.lpc")->query_euqip_look();
  if (!undefinedp(all_prop[data]))
    return all_prop[data];
  if (is_chinese(to_chinese(data)))
    return to_chinese(data) + "有效等级";
  else if (sscanf(data, "ad_%s", data))
    return to_chinese(data) + "技能等级";
  else return data;
}

void xilian_equip(string arg, object me) {
  object shi, obj;
  string data, new_data, *pro, color, type;
  mapping xilian, base_prop;
  int i, p, level, need, num;

  if (!me)
    return;
  if (me->is_busy() || me->is_fighting() || !living(me)) {
    me->delete_temp("pending/xilian");
    me->delete_temp("mark/xilian_room");
    me->delete_temp("pending/xilian_shi");
    me->delete_temp("pending/xilian_need");
    write("你目前自顾不暇，不能洗炼。\n");
    return;
  }
  if (!arg || strlen(arg) < 3) {
    write(HIR "请输入你要洗炼的装备属性：" NOR);
    input_to("xilian_equip", me);
    return;
  }
  arg = replace_string(arg, " ", "");
  if (!objectp(obj = me->query_temp("pending/xilian"))
    || !present(obj, me)) {
    me->delete_temp("pending/xilian");
    me->delete_temp("mark/xilian_room");
    me->delete_temp("pending/xilian_shi");
    me->delete_temp("pending/xilian_need");
    write("你要洗炼的装备呢？\n");
    return;
  }
  if (!intp(need = me->query_temp("pending/xilian_need"))
    || need <= 0) {
    me->delete_temp("pending/xilian");
    me->delete_temp("mark/xilian_room");
    me->delete_temp("pending/xilian_shi");
    me->delete_temp("pending/xilian_need");
    write("萤石消耗计算错误。\n");
    return;
  }
  if ((int)me->query("inventory/yingshi") < need) {
    write("你的萤石不够。\n");
    me->delete_temp("pending/xilian");
    me->delete_temp("mark/xilian_room");
    me->delete_temp("pending/xilian_shi");
    me->delete_temp("pending/xilian_need");
    return;
  }

  me->delete_temp("pending/xilian_need");
  me->delete_temp("pending/xilian");
  me->delete_temp("mark/xilian_room");
  me->delete_temp("pending/xilian_shi");

  if (!mapp(xilian = show_equip(me, obj))
    || sizeof(xilian) < 1) {
    write("返回装备属性出错。\n");
    return;
  }
  if (undefinedp(xilian[arg])) {
    write(obj->name(1) + "不能洗炼 " + arg + " 这个属性。\n");
    return;
  }

  data = xilian[arg];
  if (!obj->query("combination")) {
    if (obj->is_armor())
      base_prop = ("/d/obj/narmor/newcloth.lpc")->equip_base(obj);
    else base_prop = ("/d/obj/nweapon/newweapon.lpc")->equip_base(obj);
  } else {
    if (!stringp(type = obj->query("skill_type"))) {
      write("组合武器无类型。\n");
      return;
    }
    base_prop = obj->query("combination_dbase/" + type + "/base_prop");
  }

  if (member_array(data, keys(base_prop)) != -1) {
    write(arg + "是" + obj->name() + "的基本属性，不能洗炼。\n");
    return;
  }

  if (!arrayp(pro = temp_apply(obj))
    || sizeof(pro) < 1) {
    write("新属性返回错误。\n");
    return;
  }

  if (!obj->query("combination"))
    level = obj->query("level");
  else level = obj->query("combination_dbase/" + type + "/level");
  new_data = pro[random(sizeof(pro))];

  if (obj->is_armor()) {
    while (obj->query("armor_prop/" + new_data))
      new_data = pro[random(sizeof(pro))];
  } else {
    if (!obj->query("combination")) {
      while (obj->query("weapon_prop/" + new_data))
        new_data = pro[random(sizeof(pro))];
    } else {
      while (obj->query("combination_dbase/" + type + "/weapon_pro/" + new_data))
        new_data = pro[random(sizeof(pro))];
    }
  }
  if (!obj->query("combination")) {
    if (obj->is_armor()) {
      obj->set("before_xilian", sprintf("%s#%d", data, obj->query("armor_prop/" + data)));
      obj->delete("armor_prop/" + data);
      color = obj->query("armor_color");
    } else {
      obj->set("before_xilian", sprintf("%s#%d", data, obj->query("weapon_prop/" + data)));
      obj->delete("weapon_prop/" + data);
      color = obj->query("weapon_color");
    }
  } else {
    obj->set(
      "combination_dbase/" + type + "/before_xilian",
      sprintf("%s#%d", data, obj->query("combination_dbase/" + type + "/weapon_pro/" + data))
    );
    obj->delete("combination_dbase/" + type + "/weapon_pro/" + data);
    color = obj->query("combination_dbase/" + type + "/weapon_color");
  }

  if (color && stringp(color)) {
    switch (color) {
      case "HIY": num = 1; break;
      case "HIB": num = 1; break;
      case "HIC": num = 2; break;
      case "HIR": num = 3; break;
      case "HIM": num = 5; break;
    }
  } else num = 1;

  if (!undefinedp(equip_apply_prop2[new_data])) {
    p = num + random(level / 10);
    if (p > 30) p = 30;
    if (p < 1) p = 1;
  } else if (new_data == "combat_damage"
    || new_data == "spells_damage"
    || new_data == "spells_def"
    || new_data == "combat_def")
    p = 35 + p + (level + random(num)) * 5;
  else if (new_data == "max_kee" || new_data == "max_sen"
    || new_data == "max_mana" || new_data == "max_force") {
    p = 30 * (level / 3 + num) + num * 10;
    p += random(p * 2 / 3);
  } else if (new_data == "def_eff_combat" || new_data == "def_eff_spells"
    || new_data == "def_combat" || new_data == "def_spells") {
    p = level * (p / 10 + 1) + num * 3;
    p = p / 2 + random(p * 2 / 8);
  } else p = num * 3 + level / 10 + (random(level / 5) + 1) * 10;

  if (!obj->query("combination")) {
    if (obj->is_armor())
      obj->set("armor_prop/" + new_data, p);
    else obj->set("weapon_prop/" + new_data, p);
    obj->set("after_xilian", sprintf("%s#%d", new_data, p));
  } else {
    obj->set("combination_dbase/" + type + "/weapon_pro/" + new_data, p);
    obj->set("combination_dbase/" + type + "/after_xilian", sprintf("%s#%d", new_data, p));
  }
  write(HBBLU "【洗炼】" + obj->name() + NOR HBBLU "的 " HIY + query_prop_name(data) + HIG " 洗炼为 " HIR + query_prop_name(new_data) + HIG "。" NOR "\n");

  if (obj->save())
    write(HIY "【系统】" + obj->name(1) + HIY "存储成功。\n" NOR);
  else me->add("potential", -300);
  me->add("inventory/yingshi", -need);
  write(HIG "【系统】" + obj->name(1) + HIG "洗炼完毕。\n" NOR);
  log_file(
    "xilian",
    sprintf(
      "%s %s change %O %s -> %s\n",
      XYJTIME_D->chinese_time(time()),
      me->query("id"),
      obj,
      obj->query("before_xilian"),
      obj->query("after_xilian")
    )
  );
  if (obj->query("combination")
    && obj->update_combination(obj->query("skill_type")))
    write(HIG "【系统】" + obj->name(1) + HIG "数据更新完毕。\n" NOR);
  show_equip(me, obj, 1);
}

//参照剑三，需要买了罗盘，在指定的地点使用
int main(object me, string arg) {
  int need, have, score;
  object shi, ob;
  mapping prop, pending, old;
  string color, title;
  /*
	if( wizardp(me) && !arg )
	{
		string *sn;
		ob = new("/d/obj/narmor/armor");
		sn = temp_apply(ob);
		destruct(ob);
		arg = "盔甲能洗炼出的属性：\n";
		for(need=0;need<sizeof(sn);need++)
		{
			arg+= query_prop_name(sn[need]);
			if( need%5==4 )
				arg+="\n";
			else	arg+= "、";
		}
		arg+= "\n";
		ob = new("/d/obj/nweapon/sword");	 
		sn = temp_apply(ob);
		destruct(ob);
		arg+= "武器能洗炼出的属性：\n";
		for(need=0;need<sizeof(sn);need++)
		{
			arg+= query_prop_name(sn[need]);
			if( need%5==4 )
				arg+="\n";
			else	arg+= "、";
		}
		arg+= "\n";
		write(arg);
		return 1;
	}
*/
  if (me->query_level() < 25)
    return notify_fail("此功能25级开放。\n");
  if (!("/cmds/usr/zhaohuan.lpc")->init_player_file(me))
    return notify_fail("你需要重新登录。\n");
  if (!wizardp(me)) {
    if (!me->query_temp("mark/xilian_room"))
      return notify_fail("你需要先找一处灵气浓郁的地方，可以在袁守城处购得「罗盘」来查询。\n");
    else if (base_name(environment(me)) != me->query_temp("mark/xilian_room"))
      return notify_fail("此处灵气稀薄，难以洗炼装备。\n");
  }
  if (!intp(have = me->query("inventory/yingshi"))
    || have < 1)
    return notify_fail("你身上没有萤石。\n");
  if (!arg)
    return notify_fail("你要洗炼哪个装备？\n");
  ob = present(arg, me);
  if (!ob || (!ob->is_armor() && !ob->is_weapon()))
    return notify_fail("你身上没有" + arg + "，或它不是一件装备。\n");

  if (me->query("family/family_name") && ob->query("armor_title") == me->query("family/family_name"))
    return notify_fail("门派套装不能洗炼。\n");

  if (base_name(ob) != me->MyArmorFile(1) && base_name(ob) != me->MyWeaponFile(1))
    return notify_fail(ob->name() + "没有绑定，不能洗炼。\n");

  if (ob->query("equipped"))
    return notify_fail("你得先将" + ob->name(1) + "卸除。\n");
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");
  if ((me->query("potential") - me->query("learned_points")) < 800)
    return notify_fail("你的潜能不够。\n");
  if (ob->is_armor())
    score = ("/cmds/usr/top.lpc")->get_score4(ob);
  else score = ("/cmds/usr/top.lpc")->get_score3(ob);

  need = score / 36;
  if (need < 1)
    need = 1;
  if (have < need)
    return notify_fail("洗炼" + ob->name(1) + "需要消耗" + chinese_number(need) + "颗萤石。\n");

  me->set_temp("pending/xilian_shi", shi);
  me->set_temp("pending/xilian_need", need);
  if (mapp(prop = show_equip(me, ob))
    && sizeof(prop) > 0)
    me->set_temp("pending/xilian", ob);
  else return notify_fail(ob->name(1) + "不能洗炼。\n");
  pending = ([]);
  show_equip(me, ob, 1);
  write(HIR "请输入你要洗炼的装备属性(中文)：" NOR);
  input_to("xilian_equip", me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : xilian [装备ID]

  将装备属性洗炼，需要消耗 萤石。
        装备碎片x100 + 莹玉x3 = 萤石x1
  萤石可以用来洗炼(xilian)装备或回炼(huilian)装备。
  洗炼：你可以指定需要洗炼装备的某一属性，让它重新随机属性及数值
  回炼：使洗炼过的装备回到上一次洗炼前的属性。

  相关帮助 : help fenjie
             help huilian  
HELP);
  write(HIC "
盔甲能洗炼出的属性：\n" NOR);
  write(@HELP
	后天体格、后天胆识、后天悟性、后天灵性、后天定力、
	后天魅力、后天根骨、后天福缘、气血后限、精神后限、
	内力后限、法力后限、内力自动恢复、法力自动恢复、气血自动恢复、
	精神自动恢复、吸气效果追加、凝神效果追加、气血恢复附加率、精神恢复附加率、
	气血治疗附加率、精神治疗附加率、打坐恢复附加率、冥思恢复附加率、物理攻击、
	法术攻击、物理伤害抵消、法术伤害抵消、物理损伤抵消、法术损伤抵消、
	攻击闪避率、法术闪避率、物理闪避率、法术伤害反弹百分比、物理伤害反弹百分比、
	内功心法有效等级、内功心法技能等级、基本法术有效等级、基本法术技能等级、基本轻功有效等级、
	基本轻功技能等级、拆招卸力之法有效等级、拆招卸力之法技能等级、各法术技能等级、
	各轻功技能等级、各内功技能等级。
HELP);
  write(HIC "武器能洗炼出的属性：\n" NOR);
  write(@HELP
	后天体格、后天胆识、后天悟性、后天灵性、后天定力、
	后天魅力、后天根骨、后天福缘、气血后限、精神后限、
	内力后限、法力后限、内力自动恢复、法力自动恢复、
	气血自动恢复、精神自动恢复、吸气效果追加、
	凝神效果追加、气血恢复附加率、精神恢复附加率、气血治疗附加率
	精神治疗附加率、打坐恢复附加率、冥思恢复附加率、
	法术防御、物理防御、攻击命中率、法术命中率、物理命中率
	武器强度、物理招架率、法术损伤反弹百分比、物理损伤反弹百分比
	各武器类型对应的基本技能有效等级、各武器类型对应的基本技能等级、
	各武器类型对应的特殊技能技能等级。
HELP);
  return 1;
}
