inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "花海");
  set("long", @LONG
放眼望去，但见天地间仿佛已被鲜花充满，但却是无人认得出的花
朵，只觉得这些花无比的鲜艳，无比的美丽。真是令人想不到，荒漠之
中，竟有这样的花海。
LONG
  );
  set("exits", ([
    "north": __DIR__ "huahai",
    "south": __DIR__ "huahai2",
  ]));
  set("objects", ([
    __DIR__ "npc/ningmou": 1,
  ]));
  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv;
  int i;
  if (!query("jiangjing"))
    return 0;
  tell_room(
    this_object(),
    "\n" HIC "凝眸仙子说道：明玉神功以吐纳为根基，可吸收天地之灵气。习之可是神清气明，忘却一切杂念，使身心达到一种超脱凡人的境界。\n" NOR
  );
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "百花谷")
      continue;
    tell_object(inv[i], "你在旁边听着，听着，不禁对所学有所领悟。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
