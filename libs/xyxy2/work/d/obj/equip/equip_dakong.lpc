//装备升级
#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void create() {
  set_name(HIR "血纹石" NOR, ({ "xuewen shi", "shi", "stone", }));
  if (clonep())
    set_default_object(__FILE__);
  set("base_unit", "颗");
  set("unit", "些");
  set("long", "先秦时期阵纹师的杰作，可惜被尸气污染了，失去了镶嵌的功效。不过用它可以侵蚀(qinshi)装备而不伤害装备的质地，同时被侵蚀过的装备，将会多出一处可镶嵌的槽位。\n");
  set("value", 0);
  set("changed", 1);
  setup();
  set_amount(1);
}

void init() {
  if (!query("owner_id") && environment() && userp(environment()))
    set("owner_id", environment()->query("id"));
  add_action("do_change", "qinshi");
}

string armor_short(object ob) {
  string str;
  if (!ob)
    return "";
  str = ob->name(1);
  str = COLOR_D->clean_color(str);
  //sscanf(str,"%s(%*s",str);
  return str;
}

int do_change(string arg) {
  int now, max, p, pp;
  object obj, me = this_player();

  if (!arg || !present(this_object(), me))
    return 0;
  obj = present(arg, me);
  if (!obj)
    return err_msg("你身上没有" + arg + "。\n");
  if (!obj->is_armor() && !obj->is_weapon())
    return err_msg(armor_short(obj) + "不能侵蚀。\n");
  if (!query("owner_id") || query("owner_id") != me->query("id"))
    return err_msg(name() + "好似失去了效果。\n");
  if (obj->query("equipped"))
    return err_msg("你要先卸除" + armor_short(obj) + "。\n");
  if (obj->query("combination"))
    return err_msg("组合武器无法侵蚀。\n");
  max = obj->query("level") / 20 + 1;

  if (obj->query("max_enchase") >= max)
    return err_msg("以" + armor_short(obj) + "目前的等级，只能带有" + chinese_number(max) + "个符文槽位。\n");

  write(HIC "你将" + name() + HIC "放在" + armor_short(obj) + HIC "上，顿时一道霞光闪过。\n" NOR);
  obj->add("max_enchase", 1);
  write(HIC + name() + HIC "发出一阵炫目的霞光。\n" NOR);
  write(HIG "【系统】" + armor_short(obj) + HIG "的符文槽位增加至" + chinese_number(obj->query("max_enchase")) + "个！\n" NOR);
  if (obj->save())
    write(HIR "【系统】" + armor_short(obj) + "保存成功。" NOR "\n");
  else write(HIR "【系统】注意：未绑定的装备可能会因各种可能而消失，在未绑定之前，可以存在长安钱庄的" HIY "仓库" HIR "或储物袋里。" NOR "\n");
  if (query_amount() > 1)
    add_amount(-1);
  else destruct(this_object());
  return 1;
}
