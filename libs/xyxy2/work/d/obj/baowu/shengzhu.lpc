#include <ansi.h>
inherit __DIR__ "lingzhu.lpc";

void init_lingzhu() {
  set_name(HIR "圣" HIW "灵" HIC "珠" NOR, ({ "sheng lingzhu", "sheng zhu" }));
  set("long", "天地初开时，清者归于上，浊者归于下；有一种半清半浊归于中，是为此宝！因此五行皆为其子。\n");
  set("cast_dir", "shenglingzhu");
  set("wear_msg", "$N戴上一颗$n，顿感神清气爽。\n");
  set("unequip_msg", "$N将$n轻轻地摘下来。\n");
}
