object offensive_target(object me) { return SSERVER->offensive_target(me); }

void init_lingzhu() { return; }

void create() {
  set_name("灵珠", ({ "lingzhu", "fengzhu" }));
  set("level", 10);
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("material", "crystal");
    set("long", "传说中的五行宝珠之一，佩之可避风吹，并可发出风系法术。\n为祈雨所必需之物。");
    set("armor_prop/combat_def", 10);
    set("armor_prop/spells_def", 15);
  }
  init_lingzhu();
  setup();
  set("no_steal", 1);
  set("no_drop", "如此宝贵的宝物再世难求啊。\n");
  set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
  set("no_zm", 1);
  set("no_name", 1);  //不可改名
}

string cast_spell_file(string spell) {
  string dir;
  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("cast_dir"))
    || strlen(dir) < 2)
    return 0;
  return CLASS_D("equip") + "/cast/" + dir + "/" + spell;
}

string perform_action_file(string action) {
  string dir;
  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("perform_dir"))
    || strlen(dir) < 2)
    return 0;
  return CLASS_D("equip") + "/perform/" + dir + "/" + action;
}

string exert_function_file(string func) {
  string dir;
  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("exert_dir"))
    || strlen(dir) < 2)
    return 0;
  return CLASS_D("equip") + "/exert/" + dir + "/" + func;
}

int exert_function(object me, string arg) {
  string dir, action, target, file, msg;
  object target_ob, ob;

  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("exert_dir"))
    || strlen(dir) < 2)
    return 0;
  if (sscanf(arg, "%s %s", action, target) == 2) {
    target_ob = present(target, environment(me));
    if (!target_ob)
      return notify_fail("这里没有 " + target + "。\n");
  } else action = arg;
  if (!stringp(file = (string)this_object()->exert_function_file(action))
    || file_size(file + ".lpc") <= 0)
    return 0;

  if (time() < (me->query_temp("no_exert/start") + me->query_temp("no_exert/time"))) {
    if (stringp(msg = me->query_temp("no_exert/msg")))
      return notify_fail(msg + "\n" NOR);
  }
  me->set_temp("kill_msg", "exert_equip_" + action);
  return (int)call_other(file, "exert", me, this_object(), target_ob);
}

int perform_action(object me, string arg) {
  string dir, action, target, file, msg;
  object target_ob;

  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("perform_dir"))
    || strlen(dir) < 2)
    return 0;
  if (sscanf(arg, "%s %s", action, target) == 2) {
    target_ob = present(target, environment(me));
    if (!target_ob)
      return notify_fail("这里没有 " + target + "。\n");
  } else action = arg;
  if (!stringp(file = (string)this_object()->perform_action_file(action))
    || file_size(file + ".lpc") <= 0)
    return 0;
  if (time() < (me->query_temp("no_perform/start") + me->query_temp("no_perform/time"))) {
    if (stringp(msg = me->query_temp("no_perform/msg")))
      return notify_fail(msg + "\n" NOR);
    else return notify_fail("你现在不能施展外功。\n");
  }
  me->set_temp("kill_msg", "perform_equip_" + action);
  return (int)call_other(file, "perform", me, this_object(), target_ob);
}

int cast_spell(object me, string arg) {
  string dir, action, target, file, msg;
  object target_ob;

  if (!query("equipped"))
    return 0;
  if (!stringp(dir = query("cast_dir"))
    || strlen(dir) < 2)
    return 0;
  if (sscanf(arg, "%s %s", action, target) == 2) {
    target_ob = present(target, environment(me));
    if (!target_ob)
      return notify_fail("这里没有 " + target + "。\n");
  } else action = arg;
  if (!stringp(file = (string)this_object()->cast_spell_file(action))
    || file_size(file + ".lpc") <= 0)
    return 0;
  if (time() < (me->query_temp("no_cast/start") + me->query_temp("no_cast/time"))) {
    if (stringp(msg = me->query_temp("no_cast/msg")))
      return notify_fail(msg + "\n" NOR);
    else return notify_fail("你现在不能施展法术。\n");
  }
  me->set_temp("kill_msg", "cast_equip_" + action);
  return (int)call_other(file, "cast", me, this_object(), target_ob);
}

int is_5zhu() { return 1; }

void dest_ob() {
  destruct(this_object());
}

void check_lingzhu(object who) {
  int i, num;
  string *files;
  object sz, *inv, *obj;
  if (!who || !present(this_object(), who))
    return;
  if (query_temp("check")
    && query_temp("check") == who->query("id"))
    return;
  inv = all_inventory(who);
  obj = ({});
  files = ({
    "/d/obj/baowu/fengzhu", "/d/obj/baowu/huozhu",
    "/d/obj/baowu/leizhu", "/d/obj/baowu/shuizhu", "/d/obj/baowu/tuzhu",
  });
  files -= ({ base_name(this_object()) });
  num = 0;
  for (i = 0; i < sizeof(inv); i++) {
    if (member_array(base_name(inv[i]), files) == -1
      || inv[i]->query("default_set"))
      continue;
    if (inv[i]->query_temp("check")
      && inv[i]->query_temp("check") == who->query("id")) {
      files -= ({ base_name(inv[i]) });
      obj += ({ inv[i] });
      num++;
    }
  }
  set_temp("check", who->query("id"));
  if (num == 4) {
    sz = new("/d/obj/baowu/shengzhu");
    if (sz->move(who))
      CHANNEL_D->do_channel(
        this_object(),
        "rumor",
        "听说" + who->name(1) + "得到了" + sz->name() + HIM "。" NOR
      );
    else {
      if (sz) destruct(sz);
      return;
    }
    for (i = 0; i < sizeof(obj); i++)
      destruct(obj[i]);
    this_object()->move("/obj/void");
    remove_call_out("dest_ob");
    call_out("dest_ob", 3);
  }
}

void init() {
  object zhu;
  int i;

  add_action("do_xishou", "xishou");
  if (environment()
    && userp(environment())
    && (!query_temp("check") || query_temp("check") != environment()->query("id")))
    check_lingzhu(environment());
}

string long() {
  string str = ::long();
  str += "据说五灵珠乃是天地五行之气精华，通过吸收(xishou)可以强化自身的五行小神通。\n";
  return str;
}

void get_input(string arg, object me) {
  object obj;
  string new_data;
  if (!me || !me->query("shentong/40")
    || !me->query_temp("40shentong_change"))
    return;
  if (!objectp(obj = me->query_temp("40shentong_change/zhu"))
    || !present(obj, me))
    return;
  if (arg && (arg[0..0] == "Y" || arg[0..0] == "y")) {
    message_vision(
      HIC "$N" HIC "手捧" + obj->name() + HIC "冥想了片刻，顿时一道亮光闪起，" + obj->name() + HIC "片刻之后便灵气全无，化作了渣渣。\n" NOR,
      me
    );
    me->set(
      "shentong/40",
      me->query_temp("40shentong_change/wx") + "_" + me->query_temp("40shentong_change/yy") + "_" + me->query_temp("40shentong_change/lvl")
    );
    tell_object(me, HIY "【系统】你成功转换了五行神通，可通过" HIR "help spells_xiaoshen" HIY "查看新小神通技能。" NOR "\n");
    me->delete_temp("40shentong_change");
    destruct(obj);
  } else {
    me->delete_temp("40shentong_change");
    tell_object(me, "OK.\n");
  }
}

int do_xishou(string arg) {
  mapping Ke, Sheng;
  string my_xst, zhu_wx, my_wx, yy;
  string new_wx, new_yy, tmp;
  int lvl, new_lvl;
  object me = this_player();
  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  if (!stringp(my_xst = me->query("shentong/40"))
    || member_array(my_xst, keys(Xst)) == -1)
    return notify_fail("你并没有小神通。\n");
  if (!stringp(zhu_wx = query("wx_type")))
    return notify_fail("这个珠子五行属性紊乱，无法吸收。\n");

  arg = HIY + name() + HIY "五行属" HIR + zhu_wx + HIY "，";
  sscanf(my_xst, "%s_%s_%d", my_wx, yy, lvl);
  arg += "你筑基五行属性是：" HIR + chinese_number(lvl) + "级" + yy + "性" + my_wx + HIY "，";
  arg += "对应小神通：「";
  if (undefinedp(Xst[my_xst]))
    arg += HIC "未知" HIY "」。" NOR "\n";
  else arg += HIC + Xst[my_xst] + HIY "」。" NOR "\n";
  arg += HIY "你可以通过" HIR "help spells_xiaoshen" HIY "命令来查证。" NOR "\n";
  Ke = ([
    "金": "木",
    "木": "土",
    "土": "水",
    "水": "火",
    "火": "金",
  ]);
  Sheng = ([
    "金": "水",
    "水": "木",
    "木": "火",
    "火": "土",
    "土": "金",
  ]);
  //克，等级+1,阳
  //被克,新五行，等级-1,阴
  //生，新五行，等级+1,阳，
  //被生，等级-1，阴
  if (zhu_wx == Ke[my_wx]) {
    new_lvl = lvl + 1;
    new_wx = my_wx;
    new_yy = "阳";
  } else if (my_wx == Ke[zhu_wx]) {
    new_lvl = lvl - 1;
    new_wx = zhu_wx;
    new_yy = "阴";
  } else if (zhu_wx == Sheng[my_wx]) {
    new_wx = zhu_wx;
    new_lvl = lvl + 1;
    new_yy = "阳";
  } else if (my_wx == Sheng[zhu_wx]) {
    new_wx = my_wx;
    new_lvl = lvl - 1;
    new_yy = "阴";
  } else {
    new_wx = my_wx;
    new_lvl = lvl;
    new_yy = yy;
  }
  if (new_lvl > 7)
    new_lvl = 7;
  if (new_lvl < 1)
    new_lvl = 1;
  arg += HIG "吸收后的五行为" HIR + chinese_number(new_lvl) + "级" + new_yy + "性" + new_wx + HIY "，";
  arg += "对应小神通：「";
  tmp = new_wx + "_" + new_yy + "_" + new_lvl;
  if (undefinedp(Xst[tmp]))
    arg += HIC "未知" HIY "」。" NOR "\n";
  else arg += HIC + Xst[tmp] + HIY "」。" NOR "\n";
  arg += "你可以通过" HIY "help xiaoshen" NOR "命令来查询相关神通的具体效果。\n";
  arg += HIR "你确定要吸收吗？" HIY "Y/N" NOR;
  me->set_temp("40shentong_change", ([
    "wx": new_wx,
    "lvl": new_lvl,
    "yy": new_yy,
    "zhu": this_object(),
  ]));
  write(arg);
  input_to("get_input", me,);
  return 1;
}
