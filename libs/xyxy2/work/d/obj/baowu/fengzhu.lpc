#include <ansi.h>
inherit __DIR__ "lingzhu.lpc";

void init_lingzhu() {
  set_name(HIG "风灵珠" NOR, ({ "feng lingzhu", "fengzhu" }));
  set("long", "传说中的五行宝珠之一，佩之可避风吹，并可发出风系法术。\n");
  set("cast_dir", "fenglingzhu");
  set("wear_msg", "$N戴上一颗$n，绿色的风灵珠仿佛没有重量，随风而舞。\n");
  set("unequip_msg", "$N将$n轻轻地摘下来。\n");
  set("wx_type", "金");
}
