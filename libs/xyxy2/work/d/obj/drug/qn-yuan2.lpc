#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup() {}

int query_amount() { return amount; }

private void destruct_me() {
  remove_call_out("destruct_me");
  destruct(this_object());
}

void set_amount(int v) {
  object dest;

  if (v <= 0) {
    amount = 0;
    call_out("destruct_me", 1);
    return;
  } else {
    amount = v;
    this_object()->set_weight(v);
  }
}

void add_amount(int v) { set_amount(amount + v); }

string short() {
  string id;
  if (!stringp(id = query("owner_id")))
    id = "";
  else id = "[" + id + "]";
  return chinese_number(query_amount()) + query("base_unit") + ::short() + id;
}

varargs int move(mixed dest, int silent) {
  object env, *inv;
  int i, total, total0, result;
  string file;

  result = ::move(dest, silent);
  if (env = environment()) {
    file = base_name(this_object());
    inv = all_inventory(env);
    total = (int)query_amount();
    total0 = total;
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == this_object())
        continue;
      if (base_name(inv[i]) == file) {
        if (inv[i]->query("owner_id")
          && query("owner_id") != inv[i]->query("owner_id"))
          continue;
        set("owner_id", inv[i]->query("owner_id"));
        total += (int)inv[i]->query_amount();
        destruct(inv[i]);
      }
    }
    if (total != total0)
      set_amount(total);
  }
  return result;
}

void init() {
  if (userp(environment())) {
    if (!query("owner_id"))
      set("owner_id", environment()->query("id"));
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name("中品潜能加成丹(天监台)", ({ "qianneng dan", "dan", "exp" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "粒");
    set("unit", "些");
    set("long", "天监台秘制的丹药，吃了【袁天罡任务】潜能奖励在15分钟内将加成25%，可叠加使用。\n");
    set("no_sell", "这么珍贵的灵丹你也舍得卖？！\n");
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  int k, t;
  object ob, me = this_player();
  if (!arg)
    return 0;
  if (!objectp(ob = present(arg, me))
    || ob != this_object())
    return 0;
  if (!query("owner_id") || query("owner_id") != me->query("id"))
    return notify_fail("这粒道行加成丹失效了。\n");
  t = (int)me->query_temp("ad_apply/yuan/potential/time") + 900;
  if (t >= 86400)
    return notify_fail("你服用了过多的道行加成丹，感觉一阵反胃。\n");
  if (me->query_temp("ad_apply/yuan/potential/pot") > 0
    && me->query_temp("ad_apply/yuan/potential/pot") != 125)
    return notify_fail("你服用过" + me->query_temp("ad_apply/yuan/potential/pot") + "%的道行加成丹。\n");
  message_vision("$N吃下一粒潜能加成丹。\n", me);
  me->set_temp("ad_apply/yuan/potential", ([
    "start": time(),
    "time": t,
    "pot": 125,
  ]));
  write(HIC "你的【袁天罡任务】潜能奖励在" + XYJTIME_D->report_str_e(time() - me->query_temp("ad_apply/yuan/potential/start") + (int)me->query_temp("ad_apply/yuan/potential/time")) + "内将加成 25% 。\n" NOR);
  if (query_amount() <= 1)
    destruct(this_object());
  else add_amount(-1);
  return 1;
}
