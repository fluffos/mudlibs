inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("大海碗", ({ "dahai wan", "wan", "cha" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大碗新泡的绿茶。\n");
    set("unit", "个");
    set("value", 0);
  }
  set("clear_drunk", 2);
  set("max_liquid", 1000);
  set("recover", 500);
  set("liquid", ([
    "type": "recover_sen",
    "name": "绿茶",
    "remaining": 1000,
  ]));
}
