inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("白玉酒盏", ({ "jiu zhan", "zhan", "cup" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个淡白玉的小酒盏。\n");
    set("unit", "个");
    set("value", 500);
  }
  set("drunk", 7);
  set("max_liquid", 800);  //最大量 
  set("drink_msg", "$N拿起$n一仰脖，”咕嘟咕嘟“喝下了几口$l。\n");
  set("drink_pot", 1);
  set("liquid", ([
    "type": "recover_mana",
    "name": "女儿红",
    "remaining": 750,
  ]));
  set("recover", 550);
}
