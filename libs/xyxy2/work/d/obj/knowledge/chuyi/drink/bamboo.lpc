inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("细雕青竹筒", ({ "bamboo", "long bamboo" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一根尺把长的三节蟠虬雕花青竹筒。\n");
    set("unit", "根");
    set("value", 0);
    set("max_liquid", 300);
  }
  set("clear_drunk", 3);
  set("recover", 800);
  set("liquid", ([
    "type": "recover_mana",
    "name": "清泉碧竹茶",
    "remaining": 300,
  ]));
  setup();
}
