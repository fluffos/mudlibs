inherit COMBINED_ITEM;

void setup() { return; }

void create() {
  set_name("大米", ({ "da mi", "dami" }));
  set("base_weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "吃的大米，不过是生的。\n");
    set("unit", "些");
    set("base_unit", "袋");
    set("value", 50);
  }
  setup();
  set_amount(1);
}
