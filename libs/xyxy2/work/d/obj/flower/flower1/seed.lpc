// created 4/5/1997 by snowcat
#include <ansi.h>
inherit ITEM;

void create() {
  set_name("花籽", ({ "seed" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗小小的花籽。\n");
    set("unit", "颗");
    set("water", 0);
  }
  setup();
  set_heart_beat(3);
}

void init() {
  add_action("do_water", "water");
}

void grow() {
  string name, msg;
  object me = this_object();

  if (!environment()
    || !living(environment())
    || query("dried")) {
    set_heart_beat(0);
    return;
  }
  if (me->query("id") == "seed") {
    if (random(6) == 0) {
      message("vision", "花籽绽裂开，露出了一颗绿芽。\n", environment());
      me->set_name("绿芽", ({ "germ" }));
      me->set("long", "一颗正在长大的小绿芽。\n");
      me->set("unit", "颗");
    } else message("vision", "花籽动了一下，胀大了一点点。\n", environment());
    set_heart_beat(random(5) + 5);
    return;
  }
  if (me->query("id") == "germ") {
    if (random(9) == 0) {
      message("vision", "绿芽终于长高了，在风中欢快地摇弋。\n", environment());
      me->set_name("绿草", ({ "plant" }));
      me->set("long", "一棵茁壮的绿草，上面有花苞。\n");
      me->set("unit", "棵");
    } else message("vision", "绿芽咔嚓一声长高了一截。\n", environment());
    set_heart_beat(random(5) + 5);
    return;
  }
  if (me->query("id") == "plant") {
    if (random(12) == 0) {
      object flower;
      set_heart_beat(0);
      message("vision", "绿草上的花苞绽开了！春天来了！\n", environment());
      flower = new(__DIR__ "flower");
      flower->move(environment());
      destruct(this_object());
      return;
    } else {
      switch (random(3)) {
        case 0: msg = "绿草在风中跳起了舞。\n"; break;
        case 1: msg = "绿草要开花了。\n"; break;
        default: msg = "绿草微笑着。\n"; break;
      }
      set_heart_beat(random(5) + 5);
      return;
    }
  }
}

void heart_beat() {
  object me;
  string msg, name;
  if (!environment()
    || !living(environment())
    || query("dried")) {
    set_heart_beat(0);
    return;
  }
  me = this_object();
  if (me->query("id") == "seed") {
    set_heart_beat(3);
    return;
  }
  name = me->query("name");
  switch (me->query("water")) {
    case 0: msg = name + "长高了一点。\n"; break;
    case 1: msg = name + "有点蔫了，快淋一点水吧。\n"; break;
    case 2: msg = name + "开始发黄了。\n"; break;
    case 3: msg = name + "已经失去了绿色的光泽。\n"; break;
    case 4: msg = name + "看上去严重缺水，奄奄一息了。\n"; break;
    default:
      msg = name + "干枯了。\n";
      me->set("name", "干" + name);
      me->set("dried", 1);
      set_heart_beat(0);
      break;
  }
  message("vision", msg, environment());
  me->add("water", 1);
  grow();
}

int do_water(string arg) {
  string msg, name, str;

  if (!arg || !id(arg)
    || !present(this_object(), this_player()))
    return 0;
  name = query("name");
  if (query("water") >= 5
    || query("dried")) {
    message_vision("$N的泪水一滴滴流在" + name + "上。\n", environment());
    return 1;
  }
  switch (random(9)) {
    case 0: msg = "$N口含清水，喷在" + name + "上。\n"; break;
    case 1: msg = "$N将一点清水洒在" + name + "上。\n"; break;
    case 2: msg = "$N伸出手抓住细细的小雨，淋在" + name + "上。\n"; break;
    case 3: msg = "$N小心地捧起一点点露水，滴在" + name + "上。\n"; break;
    case 4: msg = "$N一阵心痛，泪水流在" + name + "上。\n"; break;
    case 5: msg = "$N双手捧着" + name + "，伸到窗外的小雨中……\n"; break;
    case 6: msg = "$N仔细地拿起一只小杯子，将水滴在" + name + "上。\n"; break;
    case 7: msg = "$N捧起从野外采来的晨露，洒在" + name + "上。\n"; break;
    default: msg = "$N用手指蘸着清水，一点点滴在" + name + "上。\n"; break;
  }
  str = replace_string(msg, "$N", environment()->name());
  message("vision", str, environment(environment()), environment());
  str = replace_string(msg, "$N", "你");
  tell_object(environment(), str);
  set("water", 0);
  return 1;
}
