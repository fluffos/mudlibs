#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "长思馆");
  set("long", @LONG
房中珠帘低垂，案上炉中点着一束沉香，轻烟袅绕。当地放著一张花梨大
理石大案，案上堆著各种名人法帖，并十数方宝砚，各色笔筒；那一边设
著斗大的一个汝窑花囊，插著满满的水晶球的白菊花。书案正中撂着几张
绢纸(paper)，字迹娟秀，似是嫦娥百般无赖之中所涂。
LONG);
  set("item_desc", ([
    "paper": "纸上反反复复地写着一句话：天不老，情难绝，心似双丝网，中有千千结。",
  ]));
  set("objects", ([
    __DIR__ "npc/change.lpc": 1,
    "/d/obj/flower/juhua.lpc": 1,
  ]));
  set("exits", ([
    "east": __DIR__ "huilang.lpc",
  ]));
  setup();
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv;
  int i;
  if (!query("jiangjing"))
    return 0;
  tell_room(this_object(), HIC "嫦娥借着月光载歌载舞起来。\n" NOR);
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "月宫")
      continue;
    tell_object(inv[i], "你在旁边看着，不由得感悟颇多。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
