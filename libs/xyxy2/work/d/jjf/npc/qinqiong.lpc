inherit SUPER_NPC;
#include <ansi.h>

string ask_mieyao();
string ask_cancel();

void create() {
  set_name("秦琼", ({ "qin qiong", "qin", "shubao", "qiong", "qin shubao", "master", "shifu" }));
  set_level(79);
  create_family("将军府", 2, "蓝");
  set("title", HIC "翼国公" NOR);
  set("gender", "男性");
  set("age", 43);
  set("per", 36);
  set("long", "秦叔宝是大唐国开国名臣，更是一位出名的武将。\n");
  set("looking", YEL "面色苍黄，宛如大病初愈" NOR "。");
  set("rank_info/pos_msg", HIR "浑身上下煞气震天" NOR "。\n");

  set_skill("literate", 790);
  set_skill("force", 790);
  set_skill("dodge", 790);
  set_skill("parry", 790);
  set_skill("mace", 790);
  set_skill("spells", 500);
  set_skill("baguazhou", 500);
  map_skill("spells", "baguazhou");
  set_skill("wusi-mace", 790);
  set_skill("yanxing-steps", 790);
  set_skill("lengquan-force", 790);
  set_skill("unarmed", 790);
  set_skill("changquan", 790);
  map_skill("mace", "wusi-mace");
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("parry", "wusi-mace");
  map_skill("dodge", "yanxing-steps");

  set_skill("jiefeng", 790);
  set_skill("shengguang", 790);
  set_skill("jiameng", 790);
  set_skill("jinshui", 790);

  set("force_factor", 80);
  set("env/test", "HIY");
  set("inquiry", ([
    "kill": (: ask_mieyao :),
    "师门任务": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
  ]));
  setup();
  carry_object(0, "mace", 1)->wield();
  carry_object(0, "armor", 1)->wear();
  carry_object(0, "kui", 1)->wear();
  carry_object(0, "pifeng", 1)->wear();
  carry_object(0, "ring", 1)->wear();
  carry_object(0, "cloth", 1)->wear();
  carry_object(0, "shoes", 1)->wear();
  carry_object(0, "wrists", 1)->wear();
  carry_object(0, "waist", 1)->wear();
  carry_object(0, "hand", 1)->wear();
  powerup(0, 1);
}

int accept_fight(object me) {
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。\n");
  return 0;
}

void attempt_apprentice(object ob) {
  if (ob->query("class") == "yaomo" || ob->query("class") == "ghost") {
    EMOTE_D->do_emote(this_object(), "hate", geteuid(ob), CYN, 0, 0, 0);
    tell_object(ob, CYN + name() + CYN "说道：妖怪！老秦杀了你！\n" NOR);
    return;
  }
  if (ob->query_level() > 90) {
    EMOTE_D->do_emote(this_object(), "wow", geteuid(ob), CYN, 0, 0, 0);
    tell_object(ob, CYN + name() + CYN "说道：老夫可教不了你，还是学学老程当年，在梦中看看与那白发仙人是不是有缘。\n" NOR);
    return;
  }
  EMOTE_D->do_emote(this_object(), "pat", geteuid(ob), CYN, 0, 0, 0);
  tell_object(
    ob,
    CYN + name() + CYN "说道：好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们大唐将军府发扬光大，也涨涨人族志气。\n" NOR
  );
  CHANNEL_D->do_channel(this_object(), "chat", "长安将军府又多了一个弟子  " + ob->name(1) + "
                                               大唐将军府的势力加强了。");
  command("recruit " + geteuid(ob));
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "fighter");
}

string ask_mieyao() {
  object who = this_player();
  if ((string)who->query("family/family_name") == "将军府") {
    EMOTE_D->do_emote(
      this_object(),
      ({ "addoil", "touch", "ok" })[random(3)],
      geteuid(who),
      CYN,
      0,
      0,
      0
    );
    return "/quest/family/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}

string ask_cancel() {
  if (this_player()->query("family/family_name") != "将军府")
    return 0;
  return "/quest/family/mieyao"->cancel_me(this_player());
}

void init() {}

int prevent_learn(object me, string skill) {
  if (skill == "shengguang" && me->query_level() < 50)
    return err_msg(CYN + name() + "说道：等你等级高了再教你。\n" NOR);
  if (skill == "jinshui" && me->query_level() < 60)
    return err_msg(CYN + name() + "说道：等你等级高了再教你。\n" NOR);
  if (skill == "jiameng" && me->query_level() < 40)
    return err_msg(CYN + name() + "说道：等你等级高了再教你。\n" NOR);
  return 0;
}
