//created 6-9-97 pickle
//亲兵

#include <ansi.h>
inherit NPC;

void create() {
  set_name("亲兵", ({ "qin bing", "qin", "bing", "soldier", "qinbing" }));
  set_level(10 + random(10));
  set("long", "一个彪形大汉，看身上衣服大概是建府的亲兵，曾经是建王李元吉的近身护卫。\n");
  set("title", "建王府");
  set("gender", "男性");
  set("age", 25);
  set("per", 15 + random(5));
  set_skill("blade", 180);
  set_skill("dodge", 180);
  set_skill("parry", 180);
  set_skill("wuhu-blade", 160);
  map_skill("blade", "wuhu-blade");
  set("inquiry", ([
    "name": "问什么问？长着眼睛不会看哪？",
    "here": "这儿就是醉星楼！造的可比对面那破房子强得多啦！",
    "rumors": " 听说有人想来拆房子，哼！",
    "拆房子": "哼，除非把老子打发了，否则谁也别想来这儿撒野！",
  ]));
  set("chat_msg_combat", ({
    (: perform_action, "blade", "duan" :),
  }));
  setup();
  carry_object(0, "blade", random(3))->wield();
  carry_object(0, "armor", random(3))->wear();
  carry_object(0, "pifeng", random(3))->wear();
  powerup(0, 1);
}

int accept_object(object me, object ob) {
  if (base_name(environment()) != "/d/jjf/zuixing") {
    tell_object(me, CYN + name() + CYN "说道：莫阻我，我还要去醉星楼值守！\n" NOR);
    return 0;
  }
  if ((string)ob->query("name_recognized") != "建府令箭")
    return 0;
  remove_call_out("leavehere");
  call_out("leavehere", 0, me);
  message_vision("$N交给$n一支令箭。\n", me, this_object());
  EMOTE_D->do_emote(this_object(), "wow", 0, CYN, 0, 0, 0);
  EMOTE_D->do_emote(this_object(), "admire", geteuid(me), CYN, 0, 0, 0);
  message_vision(HIC "$N对$n谄笑道：大人有啥事，尽管吩咐小的。\n" NOR, this_object(), me);
  message_vision(
    CYN "$N" CYN "说道：你现在就去替本大人寻来" + ({
      "不凝的寒冰",
      "不灭的冷焰",
      "会飞的蟾蜍",
      "不死的冬虫"
    })[random(4)] + "，大人我有急用。\n" NOR,
    me
  );
  destruct(ob);
  return 2;
}

void leavehere(object me) {
  remove_call_out("leavehere");
  if (!me || !living(me) || !living(this_object())
    || !environment()
    || base_name(environment()) != "/d/jjf/zuixing"
    || !present(me, environment()))
    return;
  EMOTE_D->do_emote(this_object(), "ah", 0, CYN, 0, 0, 0);
  tell_object(me, CYN + name() + CYN "说道：既然大人有急事，我这就去办！\n" NOR);
  message_vision("$N急急忙忙的离开了。\n", this_object());
  destruct(this_object());
  return;
}
