//cheng yaojin, updated 5/7/97, pickle
#include <ansi.h>
#include <combat.h>
inherit SUPER_NPC;

string gloat();
mixed ask_me();

void create() {
  set_name("程咬金", ({ "cheng yaojin", "cheng", "yaojin", "master", "shifu" }));
  set_level(79);
  create_family2("将军府", "三板斧", 2);
  set("title", HIR "卢国公" NOR);
  set("gender", "男性");
  set("age", 45);
  set("kar", 500);
  set("long", "
程咬金是大唐开国出名的福将，曾从梦中学来一套威猛无匹的
宣花三斧，后来又曾拜倒过一面大旗。谈起他的福气，真的是
人人羡慕。
");
  set("looking", HIB "钢须豹眼，宛如混世魔王" NOR "。");
  set("rank_info/pos_msg", HIR "浑身上下煞气震天" NOR "。\n");
  set("rank_info/respect", "将军");
  set_skill("unarmed", 790);
  set_skill("force", 790);
  set_skill("lengquan-force", 790);
  set_skill("axe", 790);
  set_skill("dodge", 790);
  set_skill("parry", 1100);
  set_skill("sanban-axe", 790);
  set_skill("spells", 790);
  set_skill("baguazhou", 790);
  set_skill("yanxing-steps", 790);
  set_skill("literate", 300);
  set_skill("spells", 500);
  set_skill("baguazhou", 500);
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");

  set_skill("jiefeng", 790);
  set_skill("zhishi-chengjin", 790);
  set_skill("baori", 790);

  set("force_factor", 40);
  set("mana_factor", 10);
  set("inquiry", ([
    "name": "我就是人称福将的程咬金！",
    "here": "这里是大唐国都长安府。",
    "rumors": "你看老程象是成天吃饱了撑的打听小道消息的么？",
    "福将": (: gloat :),
    "白发仙人": "那白发仙人是我恩师，若想见他，需得有缘。",
    "有缘": (: ask_me :),
  ]));
  set("env/test", ({ "HIR", "HIB", "HIY" })[random(3)]);
  setup();
  carry_object(0, "axe", 1)->wield();
  carry_object(0, "armor", 1)->wear();
  carry_object(0, "pifeng", 1)->wear();
  carry_object(0, "shoes", 1)->wear();
  carry_object(0, "kui", 1)->wear();
  carry_object(0, "waist", 1)->wear();
  carry_object(0, "wrists", 1)->wear();
  powerup(0, 1);
}

string gloat() {
  object me = this_player();
  if (!environment())
    return 0;
  if (me->query("family/master_id") == query("id"))
    return "好徒儿，要请师傅我吃酒吗？";
  tell_object(me, CYN + name() + CYN "说道：嘿嘿，提起这个可挠到老程的痒处了！\n" NOR);
  tell_object(me, CYN + name() + CYN "说道：老程最得意的就是当年那白发仙人梦中传我斧法。。。\n" NOR);
  if (me->query_temp("jjf/白发有缘")
    || me->query("family/master_id") == "lao ren")
    return "我看你也是个有缘之人哈。";
  else return "你要是想沾着点老程的福气，就应该拜我为师。";
}

mixed ask_me() {
  object who, me = this_player();
  if (!environment())
    return 0;
  if (base_name(environment()) != "/d/jjf/qilin")
    return "此处为何处？";
  if (me->query("family/master_id") == "lao ren")
    return "你去见了师傅，师傅他老人家怎么说？";
  if (me->query_temp("jjf/白发有缘"))
    return "该说的老程已经说了，剩下的就看你自己的造化了！";
  if (time() < me->query("mark/chengyaojin_youyuan") + 1800)
    return "问来问去的，你烦不？！";
  EMOTE_D->do_emote(this_object(), "hoho", geteuid(this_object()), CYN, 0, 0, 0);
  if (objectp(who = query_temp("sanban"))) {
    if (present(who, environment())
      && userp(who) && living(who)) {
      tell_object(me, CYN + name() + CYN "说道：慢慢来，待老程考验完" + who->name() + CYN "再说。\n" NOR);
      return 1;
    } else delete_temp("sanban");
  }
  tell_object(me, CYN + name() + CYN "说道：何为有缘？你若是能接住老程三斧不死，就是有缘人。\n" NOR);
  me->add_temp("pending/jjf/to_be_hit", 1);
  me->set("mark/chengyaojin_youyuan", time());
  return "你可愿意一试？(yuanyi)";
}

void init() {
  add_action("do_agree", ({ "yuanyi", "agree" }));
}

int check_statue(object who, int ratio) {
  if (!who || !living(who)
    || !environment()
    || !present(who, environment()))
    return 0;
  if (who->query("kee") < who->query("eff_kee") * ratio / 100
    || who->query("eff_kee") < who->query_maxkee() * ratio / 100)
    return 0;
  return 1;
}

void sanban3(object me, object npc) {
  string msg, succ_msg, fail_msg;
  int damage;
  object ob;
  remove_call_out("sanban3");
  if (!me || !npc || !environment())
    return;
  if (me != query_temp("sanban"))
    return;
  if (!living(me)) {
    EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：这身子骨，都经不起老程这一斧，哈哈哈。\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (!present(me, environment())) {
    EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：哈哈，居然跑了，哈哈哈。\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (me->query("kee") > me->query_temp("pending/CYJ/kee") + 20) {
    EMOTE_D->do_emote(this_object(), "pei", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：居然当着老程的面运气？！你是不把村子当干部啊？！\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (me->query("eff_kee") > me->query_temp("pending/CYJ/eff_kee") + 20) {
    EMOTE_D->do_emote(this_object(), "gun", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：居然当着老程的面吃药？！你是不把村子当干部啊？！\n" NOR);
    delete_temp("sanban");
    return;
  }

  if (!(ob = query_temp("weapon"))
    || ob->query("skill_type") != "axe") {
    ob = carry_object(0, "axe", 1);
    command("wield " + ob->query("id"));
  }
  msg = "\n\n$N大喊一声「掏耳朵」，翻转斧头，手中" + ob->name(1) + "划出一道银弧，奔着$n的脑袋横劈。\n";
  msg = HIY + COLOR_D->clean_color(msg) + NOR;
  message_vision(msg, npc, me);
  if (random(me->query_kar() / 10) < 3) {
    succ_msg = ({
      "$n似乎已被这三斧连环的威势吓破了胆，懒懒散散地一歪，被大斧横劈在肩头。\n",
      "$n看准来势，以手中兵器架去，但已力不从心，被斧头震得虎口出血，显然内伤不轻！\n",
      "$n眼见来势凌厉，企图低头避过，但不料大斧随着下劈，从$n背上割下一大片皮肉！\n",
    })[random(3)];
    succ_msg += ({
      "结果「噗嗤」一声劈出一道血淋淋的伤口！\n",
      "结果只听「噗」地一声，$n被劈得血如泉涌，痛得$p咬牙切齿！\n",
      "结果「噗」地一声砍出一道又长又深的伤口，溅得$N满脸鲜血！\n",
      "结果只听见$n一声惨嚎，$p身上被劈开一道深及见骨的可怕伤口！\n",
    })[random(4)];
    succ_msg = HIR + COLOR_D->clean_color(succ_msg) + NOR;
    message_vision(succ_msg, npc, me);
    damage = COMBAT_D->valid_damage(npc, me, "axe", TYPE_PERFORM);
    if (me->query("eff_kee") <= damage) {
      EMOTE_D->do_emote(this_object(), "haaa", geteuid(me), CYN, 0, 0, 0);
      tell_object(me, CYN + name() + CYN "说道：你这身子骨，都经不起老程这第三斧，算了算了。\n" NOR);
      delete_temp("sanban");
      return;
    } else {
      me->receive_wound("kee", damage, npc);
      COMBAT_D->report_status(me, 1);
    }
    if (!check_statue(me, 30)) {
      EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
      say(CYN + name() + CYN "说道：这身子骨，都经不起老程这第三斧，哈哈哈。\n" NOR);
      delete_temp("sanban");
      return;
    } else tell_object(me, CYN + name() + CYN "说道：哎呦喂，皮糙肉厚，也算是一个好皮囊。\n" NOR);
  } else {
    fail_msg = ({
      "$n似乎早已熟知大斧来路，斧未到，人已先轻飘飘地避开了。\n",
      "$n眼见躲不过来招，急忙在地上一滚。虽然避得狼狈，但丝毫没有受伤。\n",
      "$n不顾自身危险，中宫直进，向$N攻去，果然将来招化解了。\n",
    })[random(3)];
    fail_msg = HIC + COLOR_D->clean_color(fail_msg) + NOR;
    message_vision(fail_msg, npc, me);
  }
  EMOTE_D->do_emote(this_object(), "great", geteuid(me), CYN, 0, 0, 0);
  delete_temp("sanban");
  me->set_temp("jjf/白发有缘", 1);
  tell_object(me, CYN + name() + CYN "说道：看来你果然是有缘人呐。\n" NOR);
  message_vision(HIC "\n$N" HIC "对$n" HIC "说道：你去找我师父吧！别忘了他是自己来到我梦中的，这种机会是可遇而不可求。\n" NOR, npc, me);
  command("whisper " + geteuid(me) + " 记得潜能够时再去，不然就会像老程一样，灰来灰去只会这三板斧。\n");
}

void sanban2(object me, object npc) {
  string msg, succ_msg, fail_msg;
  int damage;
  object ob;
  remove_call_out("sanban2");
  if (!me || !npc || !environment())
    return;
  if (me != query_temp("sanban"))
    return;
  if (!living(me)) {
    EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：这身子骨，都经不起老程这一斧，哈哈哈。\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (!present(me, environment())) {
    EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：哈哈，居然跑了，哈哈哈。\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (me->query("kee") > me->query_temp("pending/CYJ/kee") + 20) {
    EMOTE_D->do_emote(this_object(), "pei", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：居然当着老程的面运气？！你是不把村子当干部啊？！\n" NOR);
    delete_temp("sanban");
    return;
  }
  if (me->query("eff_kee") > me->query_temp("pending/CYJ/eff_kee") + 20) {
    EMOTE_D->do_emote(this_object(), "gun", 0, CYN, 0, 0, 0);
    say(CYN + name() + CYN "说道：居然当着老程的面吃药？！你是不把村子当干部啊？！\n" NOR);
    delete_temp("sanban");
    return;
  }

  if (!(ob = query_temp("weapon"))
    || ob->query("skill_type") != "axe") {
    ob = carry_object(0, "axe", 1);
    command("wield " + ob->query("id"));
  }
  msg = "\n\n$N大喊一声「剔牙」，顺势带过" + ob->name(1) + "，趁$n一愣之际，以斧尾护手刀向$n面门疾戳。\n";
  msg = HIY + COLOR_D->clean_color(msg) + NOR;
  message_vision(msg, npc, me);
  if (random(me->query_kar() / 10) < 2) {
    succ_msg = ({
      "$n似乎没有觉出危险，顺手一挡。待到发觉来势之疾，为时已晚。脸上已多了一条数寸长的伤口！\n",
      "$n没想道$N攻势如此之快，急忙低头闪避，但无法躲开，被刀刃划得皮开肉绽！\n",
      "$n攻势已然发出，来不及回防，脸上被割掉一片皮，显然伤得不轻！\n",
    })[random(3)];
    succ_msg += ({
      "结果「噗嗤」一声劈出一道血淋淋的伤口！\n",
      "结果只听「噗」地一声，$n被劈得血如泉涌，痛得$p咬牙切齿！\n",
      "结果「噗」地一声砍出一道又长又深的伤口，溅得$N满脸鲜血！\n",
      "结果只听见$n一声惨嚎，$p身上被劈开一道深及见骨的可怕伤口！\n",
    })[random(4)];
    succ_msg = HIR + COLOR_D->clean_color(succ_msg) + NOR;
    message_vision(succ_msg, npc, me);
    damage = COMBAT_D->valid_damage(npc, me, "axe", TYPE_PERFORM);
    if (me->query("eff_kee") <= damage) {
      EMOTE_D->do_emote(this_object(), "haaa", geteuid(me), CYN, 0, 0, 0);
      tell_object(me, CYN + name() + CYN "说道：你这身子骨，都经不起老程这第二斧，算了算了。\n" NOR);
      delete_temp("sanban");
      return;
    } else {
      me->receive_wound("kee", damage, npc);
      COMBAT_D->report_status(me, 1);
    }
    if (!check_statue(me, 20)) {
      EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
      say(CYN + name() + CYN "说道：这身子骨，都经不起老程这第二斧，哈哈哈。\n" NOR);
      delete_temp("sanban");
      return;
    } else tell_object(me, CYN + name() + CYN "说道：哎呦喂，皮糙肉厚，也算是一个好皮囊。\n" NOR);
  } else {
    fail_msg = ({
      "$n脑袋微微一侧，避过了$N的攻势。\n",
      "$n似乎早已料到这一招，顺势在斧杆上一推，避了开去。\n",
      "眼看这招要把$n脑袋戳个对穿，突然间$n使个铁板桥，护手刀落了个空。\n",
    })[random(3)];
    fail_msg = HIC + COLOR_D->clean_color(fail_msg) + NOR;
    message_vision(fail_msg, npc, me);
  }
  EMOTE_D->do_emote(this_object(), "zeze", geteuid(me), CYN, 0, 0, 0);
  tell_object(me, CYN + name() + CYN "说道：不错不错，再来接第三斧！\n" NOR);
  message_vision(HIC "\n$N" HIC "蓄势待发。\n" NOR, npc);
  me->set_temp("pending/CYJ", ([
    "kee": me->query("kee"),
    "eff_kee": me->query("eff_kee"),
  ]));
  remove_call_out("sanban3");
  call_out("sanban3", 2 + random(4), me, npc);
}

int do_agree(string arg) {
  object me = this_player(), npc = this_object(), ob;
  string msg, succ_msg, fail_msg;
  int damage;

  if (!me->query_temp("pending/jjf/to_be_hit"))
    return 0;
  me->delete_temp("pending/jjf/to_be_hit");
  powerup(0, 1);
  set("force_factor", 200);
  if (!(ob = query_temp("weapon"))
    || ob->query("skill_type") != "axe") {
    ob = carry_object(0, "axe", 1);
    command("wield " + ob->query("id"));
  }
  message_vision(
    HIC "\n$N" HIC "朝$n" HIC "点点头，说道：" + RANK_D->query_self(me) + "便接大将军三板斧一试！\n" NOR,
    me,
    npc
  );
  tell_object(me, CYN + name() + CYN "说道：哈哈，有胆子！\n" NOR);
  set_temp("sanban", me);

  msg = "\n$N大喊一声「开瓜」手中" + ob->name(1) + "带着这一吼的威猛之势，朝$n当头劈下。\n";
  msg = HIY + COLOR_D->clean_color(msg) + NOR;
  message_vision(msg, npc, me);
  if (random(me->query_kar() / 10) < 2) {
    succ_msg = ({
      "$n试图侧身避开，但为时已晚。大斧劈在肩上，留下一道深可见骨的伤口！\n",
      "$n高举手中兵刃试图架开，但挡不住$N的来势，被震得吐出一口鲜血！\n",
      "$n以攻为守，但去势不够凌厉。虽逼得$N回斧自护，但还是在$n肩膀带出一道伤口。\n",
    })[random(3)];
    succ_msg += ({
      "结果「噗嗤」一声劈出一道血淋淋的伤口！\n",
      "结果只听「噗」地一声，$n被劈得血如泉涌，痛得$p咬牙切齿！\n",
      "结果「噗」地一声砍出一道又长又深的伤口，溅得$N满脸鲜血！\n",
      "结果只听见$n一声惨嚎，$p身上被劈开一道深及见骨的可怕伤口！\n",
    })[random(4)];
    succ_msg = HIR + COLOR_D->clean_color(succ_msg) + NOR;
    message_vision(succ_msg, npc, me);
    damage = COMBAT_D->valid_damage(npc, me, "axe", TYPE_PERFORM);
    if (me->query("eff_kee") <= damage) {
      EMOTE_D->do_emote(this_object(), "haaa", geteuid(me), CYN, 0, 0, 0);
      tell_object(me, CYN + name() + CYN "说道：你这身子骨，都经不起老程这一斧，算了算了。\n" NOR);
      delete_temp("sanban");
      return 1;
    } else {
      me->receive_wound("kee", damage, npc);
      COMBAT_D->report_status(me, 1);
    }
    if (!check_statue(me, 10)) {
      EMOTE_D->do_emote(this_object(), "haaa", 0, CYN, 0, 0, 0);
      say(CYN + name() + CYN "说道：这身子骨，都经不起老程这一斧，哈哈哈。\n" NOR);
      delete_temp("sanban");
      return 1;
    } else tell_object(me, CYN + name() + CYN "说道：哎呦喂，皮糙肉厚，也算是一个好皮囊。\n" NOR);
  } else {
    fail_msg = ({
      "$n轻轻一闪，大斧带着一阵劲风从身边斩下，但没伤到$n分毫。\n",
      "$n高举手中兵刃奋力一架，只听「当」的一声巨响，$N巨斧已被弹开！\n",
      "$n不顾大斧来势，反而向$N疾攻，逼得$N不得不回斧自保，这一势「开瓜」就此落空。\n",
    })[random(3)];
    fail_msg = HIC + COLOR_D->clean_color(fail_msg) + NOR;
    message_vision(fail_msg, npc, me);
  }
  EMOTE_D->do_emote(this_object(), "zeze", geteuid(me), CYN, 0, 0, 0);
  tell_object(me, CYN + name() + CYN "说道：不错不错，再来接第二斧！\n" NOR);
  message_vision(HIC "\n$N" HIC "蓄势待发。\n" NOR, npc);

  me->set_temp("pending/CYJ", ([
    "kee": me->query("kee"),
    "eff_kee": me->query("eff_kee"),
  ]));

  remove_call_out("sanban2");
  call_out("sanban2", 1 + random(4), me, npc);
  return 1;
}

int accept_fight(object me) {
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。");
  return 0;
}

void attempt_apprentice(object me) {
  int effstr = me->query_str();
  int myuna = me->query_skill("unarmed", 1) / 10 - 2;
  string myrude = RANK_D->query_rude(me);

  if (me->query_level() > 90) {
    EMOTE_D->do_emote(this_object(), "wow", geteuid(me), CYN, 0, 0, 0);
    tell_object(me, CYN + name() + CYN "说道：老程可教不了你，还是学学老程当年，在梦中看看与那白发仙人是不是有缘。\n" NOR);
    return;
  }
  if (me->query("class") == "yaomo" || me->query("class") == "ghost") {
    EMOTE_D->do_emote(this_object(), "pei", geteuid(me), CYN, 0, 0, 0);
    tell_object(me, CYN + name() + CYN "说道：妖魔鬼怪滚一边去，老程可不怕你！\n" NOR);
    return;
  }
  if (myuna < 0)
    myuna = 0;
  effstr += myuna;
  if (random(effstr) < 20) {
    tell_object(me, CYN + name() + CYN "说道：" + myrude + "这点劲连只蚂蚁都捏不死，还能抡斧头？\n" NOR);
    return 0;
  }
  if (me->query_cor() < 30) {
    tell_object(me, CYN + name() + CYN "说道：" + myrude + "见了血，还不得吓破了胆儿？不收！\n" NOR);
    return 0;
  }
  EMOTE_D->do_emote(this_object(), "zeze", geteuid(me), CYN, 0, 0, 0);
  command("say 想不到我老程这三脚猫本事也能收徒。\n");
  command("recruit " + me->query("id"));
  return;
}

int prevent_learn(object me, string skill) {
  if (skill == "zhishi-chengjin" && me->query_level() < 50)
    return err_msg(CYN + name() + "说道：等你等级高了老程再教你。\n" NOR);
  if (skill == "baori" && me->query_level() < 80)
    return err_msg(CYN + name() + "说道：等你等级高了老程再教你。\n" NOR);
  return 0;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "fighter");
    if (!ob->is_titles("三板斧")) {
      if (ob->set_titles("三板斧"))
        tell_object(ob, HIC "【系统】你获得了称号：「" HIR "三板斧" NOR HIC "」。\n" NOR);
    }
  }
}
