inherit NPC;
#include <ansi.h>
#include <armor.h>

void create() {
  set_name("拾遗小妖", ({ "shiyi xiaoyao", "xiao yao", "xiaoyao", "yao", }));
  set("long", @LONG
一个身扎兽皮裙，扛着小旗的小妖怪。因生性敛财，所以喜欢四处游荡，看到宝贝就喜巧取。
虽然没有什么攻击能力，但是因有天生借风神通，故倒也逍遥自在。
LONG);
  set("looking", NOR YEL "龇牙咧嘴，骨瘦如柴" NOR "。");
  set_level(10);
  set("gender", "男性");
  set("age", 20);
  set("attitude", "friendly");
  set("per", 10);
  set_skill("spells", 100);
  set_skill("yaofa", 100);
  set_skill("dodge", 100);
  set_skill("xiaoyaoyou", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
  set_skill("cuixin-zhang", 100);
  set_skill("ningxie-force", 100);

  map_skill("spells", "yaofa");
  map_skill("force", "ningxie-force");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("parry", "cuixin-zhang");

  setup();
  carry_object("/d/obj/baowu/tuzhu", 0, 1)->wear();
  carry_object("/d/obj/cloth/shoupiqun", 0, 1)->wear();
  add_temp("apply/max_kee", 30000);
  add_temp("apply/max_sen", 30000);
  add_temp("apply/combat_dodge", 200);
  add_temp("apply/spells_dodge", 200);
  add_temp("apply/ad_dodge", 500);
  add_temp("apply/dodge", 200);
  set_temp("no_return", 1);
  powerup(0, 1);
}

int accept_fight(object ob) { return 0; }

void unconcious() {
  die();
}

void random_drop() {
  object ob;
  if (!environment()
    || !environment()->query("virtual_room"))
    return;
  stop_busy();
  start_hunluan(0, "");
  start_blind(0, "");
  start_no_move(0, "");
  reset_action();
  switch (random(10)) {
    case 0:
    case 1: ob = new("/obj/money/coin"); ob->set_amount(50 + random(1000)); break;
    case 2: ob = new("/obj/money/silver"); ob->set_amount(10 + random(500)); break;
    case 3: ob = new("/obj/money/gold"); ob->set_amount(1 + random(5)); break;
    case 9:
      ob = new("/d/obj/nweapon/" + ({
        "axe",
        "blade",
        "dagger",
        "fork",
        "hammer",
        "mace",
        "spear",
        "staff",
        "stick",
        "sword",
        "unarmed",
        "whip",
      })[random(12)]);
      set_temp("weapon_level", 1 + random(40));
      set("env/test", ({ "", "", HIC, HIY, HIB, "", "", })[random(7)]);
      ob->init_weapon(this_object());
      break;
    default:
      ob = new("/d/obj/narmor/" + ({
        "armor",
        "cloth",
        "hand",
        "kui",
        "neck",
        "pifeng",
        "ring",
        "shield",
        "shoes",
        "waist",
        "wrists",
      })[random(11)]);
      set_temp("armor_level", 1 + random(40));
      set("env/test", ({ "", "", HIC, HIY, HIB, "", "", })[random(7)]);
      ob->init_armor(this_object());
      break;
  }
  if (!ob)
    return;
  if (!ob->move(environment())) {
    if (ob) destruct(ob);
  } else message_vision(
    HIC "$N" HIC "慌忙丢下一" + (ob->query("unit") ? ob->query("unit") : "个") + ob->name() + HIC "。\n" NOR,
    this_object()
  );
}

int random_go() {
  int x, y;
  string noexit, *ex;
  mapping out;

  if (!environment())
    return 0;
  if (!mapp(out = environment()->query("exits"))
    || sizeof(out) < 1)
    return -1;
  ex = keys(out);
  if (!pointerp(ex) || sizeof(ex) < 1)
    return -2;

  if (!environment()->query("maze/x")
    || !environment()->query("maze/y")) {
    if (environment()->query("virtual_room")
      && environment()->query("channel_id")
      && environment()->query("channel_id") == "土灵珠副本") {
      command("go " + ex[random(sizeof(ex))]);
      return 1;
    } else return -3;
  }
  x = environment()->query("maze/x");
  y = environment()->query("maze/y");
  if (x == 6 && member_array("east", ex) != -1)
    ex -= ({ "east" });
  if (y == 6 && member_array("north", ex) != -1)
    ex -= ({ "north" });
  if (x == 0 && member_array("west", ex) != -1)
    ex -= ({ "west" });
  if (y == 0 && member_array("south", ex) != -1)
    ex -= ({ "south" });
  ex -= ({ 0 });
  if (sizeof(ex) < 1)
    return -2;
  command("go " + ex[random(sizeof(ex))]);
  return 1;
}

void kill_ob(object ob) {
  if (!userp(ob))
    powerup(0, 1);
  if (environment()->query("maze/x") == query_temp("maze/x")
    && environment()->query("maze/y") == query_temp("maze/y")) {
    random_go();
    return;
  }
  ::kill_ob(ob);
}

void reward_ob(object who) {
  object where, zhu;
  string file;
  int i, x, y;
  if (!who || !userp(who) || !present(who, environment())
    || environment()->query("channel_id") != "土灵珠副本") {
    message_vision(YEL "\n$N" YEL "一溜烟跑远了。\n" NOR, this_object());
    destruct(this_object());
    return;
  }
  where = environment();
  powerup(0, 1);
  stop_busy();
  start_hunluan(0, "");
  start_blind(0, "");
  start_no_move(0, "");
  reset_action();
  message_vision(HIY "\n$N" HIY "一对小眼四下乱瞅，貌似在找退路。\n" NOR, this_object());
  message_vision("$N深深吸了几口气，脸色看起来好多了。\n$N略一凝神，吸了口气，精神看起来清醒多了。\n", this_object());
  add("combat_lost", 1);
  if (intp(x = environment()->query("maze/x"))
    && intp(y = environment()->query("maze/y")))
    ;
  else x = y = 7;
  set_temp("maze/x", x);
  set_temp("maze/y", y);
  if (random(query("combat_lost")) > 3) {
    remove_killer(who);
    who->remove_killer(this_object());
    EMOTE_D->do_emote(this_object(), "over", geteuid(this_object()), CYN, 0, 0, 0);
    zhu = new("/d/obj/baowu/tuzhu.lpc");
    if (zhu->move(who)) {
      message_vision(HIC "$N" HIC "丢下一颗" HIY "土灵珠" HIC "。\n", this_object());
      tell_object(who, "你捡起一颗" HIY "土灵珠" NOR "。\n");
      CHANNEL_D->do_channel(
        this_object(),
        "rumor",
        "听说" + who->name(1) + "得到了" HIY "土灵珠" HIM "。" NOR
      );
    } else if (zhu)
      destruct(zhu);
    message_vision(YEL "\n$N" YEL "一溜烟跑远了。\n" NOR, this_object());
    destruct(this_object());
    return;
  } else {
    EMOTE_D->do_emote(this_object(), "escape", 0, CYN, 0, 0, 0);
    random_drop();
    reset_eval_cost();
    i = 3 + random(3);
    while (i--)
      random_go();
    if (environment()->query("maze/x") == query_temp("maze/x")
      && environment()->query("maze/y") == query_temp("maze/y"))
      random_go();
    return;
  }
}
