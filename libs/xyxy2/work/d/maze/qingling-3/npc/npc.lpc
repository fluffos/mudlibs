#include <ansi.h>
inherit F_VENDOR_SALE;

mixed about_busi();
mixed about_map();

void create() {
  set_name("李淳风", ({ "li chunfeng", "li" }));
  set("age", 28);
  set_level(35);
  set("gender", "男性");
  set("long", "清虚观雾渊道长的高徒，奉师命在此镇压尸气，你要是有什么需求，可以找他。\n");
  set("attitude", "friendly");
  set("per", 55);
  set("shen_type", 1);
  set("vendor_goods", ([
    "yao": "/d/obj/drug/jinchuang",
    "dan": "/d/obj/drug/hunyuandan",
    "force": "/d/obj/drug/bihai-yinping",
    "yao3": "/d/obj/drug/jinchuang3",
    "dan3": "/d/obj/drug/hunyuandan3",
    "yao2": "/d/obj/drug/jinchuang2",
    "dan2": "/d/obj/drug/hunyuandan2",
  ]));
  set("inquiry", ([
    "拣取": "三层深处鬼魅横行，不过机会与风险并存，如果你对打到的装备有品质要求，可以在我这里记录(mark)一下。\n",
    "替身傀儡": (: about_busi :),
    "地图": (: about_map: ),
    ])
  );
set("env/test", "HIC");
setup();
carry_object(0, "cloth", 1)->wear();
carry_object(0, "sword", 1)->wear();
}

void init() {
  ::init();
  add_action("do_mark", "mark");
}

int do_mark(string arg) {
  int i;
  string str, *tmp, *temp;
  mapping color = ([
    "HIM": "紫",
    "HIR": "红",
    "HIC": "青",
    "HIB": "蓝",
    "HIY": "金",
  ]);
  if (!arg)
    return notify_fail(name() + "问道：你想记录哪些颜色，多种颜色可以用" HIY " , " NOR "分开。\n示例：mark HIC,HIM");
  arg = replace_string(arg, "，", ",");
  if (strsrch(arg, ",") == -1) {
    if (undefinedp(color[arg]))
      return notify_fail(name() + "说道：" + arg + " 这样颜色可没有。\n");
    else tmp = ({ arg });
  } else {
    temp = explode(arg, ",");
    tmp = ({});
    for (i = 0; i < sizeof(temp); i++) {
      if (undefinedp(color[temp[i]]))
        return notify_fail(name() + "说道：" + temp[i] + " 这样颜色可没有。\n");
      tmp += ({ temp[i] });
    }
  }
  str = "";
  for (i = 0; i < sizeof(tmp); i++) {
    str += color[tmp[i]] + "色";
    if (i < sizeof(tmp) - 1)
      str += "、";
  }
  this_player()->set_temp("maze/equip_color", tmp);
  write(HIC + name() + HIC "朝你点了点头，念了几句咒语朝你一指。\n" NOR);
  write(CYN + name() + CYN "说道：好了，在三层磨练，除了" + str + "，其他品质的装备会自动清除。\n" NOR);
  return 1;
}

mixed about_busi() {
  object me = this_player();
  if (!userp(me) || me->query_level() < 50)
    return 0;
  if (!me->check_pay(1000000))
    return "替身傀儡得来不易，每个你需交纳一百两黄金。";
  me->add_temp("maze/qinling3_full", 1);
  me->money_add(-1000000);
  message_vision("$N从$n处购买了一个替身傀儡。\n", me, this_object());
  write(HIY "【系统】你目前有替身傀儡" + chinese_number(me->query_temp("maze/qinling3_full")) + "个。" NOR "\n");
  write(HIR "【系统】要注意的是：退出副本后，身上的替身傀儡将被清除。" NOR "\n");
  return "此替身傀儡平白多增加了几分生机，不过此等逆天之物，只能在始皇陵三层使用。";
}

mixed about_map() {
  int i, f = 0;
  string arg, str, *strs, color;
  object env, xin, who = this_player();
  env = environment();
  if (this_object()->is_busy())
    return "我现在正忙。";
  if (!who->check_pay(10000))
    return "地图也是在下拼死拼活得来的，你需交纳一两黄金。";
  if (objectp(xin = present("qinling3's map", who))
    && base_name(xin) == "/d/maze/qingling-3/obj/map")
    return "我不是已经给过你了。";

  command("go south");
  str = MAZE_D->query_maze_mainobj(this_object())->display_common_map(environment());
  this_object()->move(env);
  if (!str)
    return "什么地图？在下不知。";
  strs = explode(str, "\n");
  str = "";
  color = ({ HIR, HIG, HIY, HIC, HIM, HIB, HIW, RED, GRN, YEL, CYN, MAG, BLU, WHT, })[random(14)];
  for (i = 0; i < sizeof(strs); i++) {
    arg = strs[i];
    arg = replace_string(arg, "★", "◆");
    arg = replace_string(arg, HBRED "  ", "◇");
    arg = replace_string(arg, BGRN "  ", "※");
    arg = COLOR_D->clean_color(arg);
    if (strsrch(arg, "╭") != -1) {
      f = 1;
      str += arg + "\n";
    } else if (f != 1)
      continue;
    else {
      arg = replace_string(arg, GRN, "");
      arg = replace_string(arg, BGRN, "");
      arg = replace_string(arg, REV, "");
      str += arg + "\n";
    }
  }
  str = replace_string(str, "╭", "  ");
  str = replace_string(str, "─", "  ");
  str = replace_string(str, "┬", "  ");
  str = replace_string(str, "╮", "  ");
  str = replace_string(str, "│", "  ");
  str = replace_string(str, "╯", "  ");
  str = replace_string(str, "╰", "  ");
  str = replace_string(str, "├", "  ");
  str = replace_string(str, "┤", "  ");
  str = replace_string(str, "┤", "  ");
  str = replace_string(str, "┼", "  ");
  str = replace_string(str, "┴", "  ");
  str = replace_string(str, "※", NOR + REV + color + "  " NOR);
  str = "【始皇陵地宫三层地图】\n" + str + "*注：◆为入口(李淳风处#2 south)，◇为出口。\n";
  xin = new("/d/maze/qingling-3/obj/map");
  xin->set("long", str);
  if (!xin->move(who)) {
    destruct(xin);
    tell_object(who, HIR "【系统】你的背包满了。\n" NOR);
  } else {
    tell_object(who, HIG "【副本】始皇陵三层：你得到了 「" HIY "始皇陵地宫三层地图" HIG "」。\n" NOR);
    who->money_add(-10000);
    tell_object(who, HIR "【系统】要注意的是：退出副本后，地图将会重置。" NOR "\n");
  }
  return 1;
}
