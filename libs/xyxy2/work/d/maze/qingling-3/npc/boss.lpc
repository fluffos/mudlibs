        init_texing();
        set("mana_factor",350);
        if( query("family/family_name")!="月宫" )       
        	set("force_factor",250);
	else	set("force_factor",0);
	if( query("family/family_name")=="蜀山派" ) 
        	carry_object("/obj/paper_seal")->set_amount(1000);
	names = ({
        	"cloth","armor","kui","pifeng","hand","neck","ring",
        	"wrists","shoes","waist",
        });
        for(i=0;i<sizeof(names);i++)
        {
        	if( objectp(ob=carry_object(0,names[i],1)) )
        	{
        		ob->set("armor_title",query("name"));
        		ob->wear();
        	}
        }
        if( objectp(ob=carry_object(0,weapon,1)) )
        {
        	ob->set("weapon_title",query("name"));
        	ob->wield();
        }
        add_temp("apply/max_kee",i*5500);
        add_temp("apply/max_sen",i*5500);
        add_temp("apply/max_force",i*800);
        add_temp("apply/max_mana",i*800);
        powerup(0,1);
        return 1;
}

string short()
{
        string str = ::short();
        if( !query("my_type") )
                return str;
        return str+NOR"["+query("my_type")+NOR"]";
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void reward_player(object who,object pl)
{
        string arg,file,*env,color;
        object ob,weapon;
        int i,succ,k;
        
        if( !pl || !living(pl) || time()<pl->query("maze/last_QLboss3")+3600 )
                return;
        arg = "";
        if( !arrayp(env=pl->query_temp("maze/equip_color")) )
                env = 0;
	if( wizardp(pl) || (pl->query_level()==59 && pl->query("combat_exp")>=529000000) )
	{
		ob = new("/d/maze/qingling-3/obj/butian-dan");
		ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) ) destruct(ob);
		CHANNEL_D->do_channel(this_object(),"rumor","听说"+pl->name(1)+"在始皇陵三层得到了"HIG"步天丹"HIM"。"NOR);
	}
	if( sizeof(a_dir)>0 && stringp(file = a_dir[random(sizeof(a_dir))]) )
        {
        	a_dir-=({file});
                ob = new("/d/obj/narmor/"+file);
                ob->set("from","【始皇陵三层副本】");
                set("env/test","HIM");
		ob->init_armor(this_object());
                if( stringp(color=ob->query("armor_color")) )
                {
                	if( env && member_array(color,env)==-1 )
                        {
                        	tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                                destruct(ob);
			}
		}
                else if( !ob->move(pl) )
                {
                	destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
		}
                else    
                {
                	//tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        arg+= obj_name(ob);
                        if( i!=0 && arg!="" )
                        	arg+= "、";
		}
        }
        
	if( sizeof(w_dir)>0 && stringp(file = w_dir[random(sizeof(w_dir))]) )
        {
        	w_dir-= ({file});
        	ob = new("/d/obj/nweapon/"+file);
        	ob->set("from","【始皇陵三层副本】");
        	set("env/test","HIM");
        	ob->init_weapon(this_object());
        	if( stringp(color=ob->query("weapon_color"))
         	&& env && member_array(color,env)==-1 )
		{
        		tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                	destruct(ob);
		}
        	else if( !ob->move(pl) )
        	{
        		destruct(ob);
                	tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
		}
        	else    
        	{
        		//tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
        		if( arg!="" )
        			arg+= "、";
			arg+= obj_name(ob);
        	}
        }
        
        if( sizeof(baoshi)>0 && stringp(file=baoshi[random(sizeof(baoshi))]) )
        {
        	baoshi-= ({file});
        	if( file=="fu" )
        		ob = new( sprintf("/d/maze/qingling-3/obj/fu%d",1+random(5)) );
        	else if( file=="sp" )
        	{
        		ob = new( sprintf("/d/maze/qingling-3/obj/sp%d",1+random(5)) );
        		ob->set_amount(1+random(5));
        	}		
        	else	ob = new(file);
        	k = ob->query_amount();
        	if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
			if( arg!="" )
        			arg+= "、";
			arg+= chinese_number(k)+ob->query("base_unit")+obj_name(ob);
                }
        }
        
        succ = random(pl->query_kar())/10;
        if( succ>2 )
        {
                file = "/d/maze/qingling-3/obj/bangding";
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
			if( arg!="" )
        			arg+= "、";
			arg+= "一块"+obj_name(ob);
                }
        }

        succ = random(pl->query_kar())/10;
        if( succ>2 )
        {
                if( random(2) ) 
                      file = "/d/maze/qingling-3/obj/sj1";
                else  file = "/d/maze/qingling-3/obj/sj2";
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                ob->set_amount(1);
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                                arg+= "、";
                        arg+= "一块"+obj_name(ob);
                }
        }

        
        if( succ>5 )
        {
        	ob = new( sprintf("/d/maze/qingling-3/obj/sp%d",1+random(5)) );
		ob->set_amount(1+random(5));
		k = ob->query_amount();
        	if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
			if( arg!="" )
        			arg+= "、";
			arg+= chinese_number(k)+ob->query("base_unit")+obj_name(ob);
                }
        }
        
        if( succ>5 )
        {
        	ob = new("/d/maze/qingling-3/obj/dakong");
		ob->set_amount(1+random(2));
		k = ob->query_amount();
        	if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
			if( arg!="" )
        			arg+= "、";
			arg+= chinese_number(k)+ob->query("base_unit")+obj_name(ob);
                }
        }
        
        
        k = 4000000+random(1000000);
	pl->add("combat_exp",k);
	if( arg!="" )
        	arg+= "、";
	arg+= k+"点武学经验";

        if( objectp(pl->query_leader()) && arg!="" )
                pl->team_talk(pl->name(1)+"得到了"+arg+HIW"。"NOR);
	else	tell_object(pl,HIG"【系统】你得到了"+arg+HIG"。"NOR"\n"); 
        pl->set("maze/last_QLboss3",time());
}

void reward_ob(object who)
{
        object leader,*t,*py;
        int i;
	string str;
	
	message_vision(HIW"\n$N"HIW"发出嘶嘶不忿的怒吼，口中不住发出恶毒的诅咒：”尔等俗人，孤还会回来！\n\n"NOR,this_object());
	command("chat 待孤的始元功大成之际，便是汝等的死期！\n");
	message_vision(HIW"$N"HIW"浑身散发出阵阵浓重的尸臭，渐渐沉于黑暗之中！\n\n"NOR,this_object());
	
        if( !who || !userp(who) || !present(who,environment()) 
         || environment()->query("channel_id")!="始皇陵三层副本" 
         || !query("created") )
        {
                destruct(this_object());
                return;
        }
        
	if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }         
	if( stringp(str=query_hurt_msg()) && strlen(str)>4 )
		message_vision(str,this_object());
        py = ({});
        if( !objectp(leader=who->query_leader()) )
        	py = ({who});
        else	
        {
        	if( !pointerp(t=leader->query_team()) )
        		py = ({who});
        	else
        	{
        		for(i=0;i<sizeof(t);i++)
        		{
        			if( t[i] && living(t[i]) && present(t[i],environment()) )
        				py+= ({t[i]});
        		}
        	}	
        }
        for(i=0;i<sizeof(py);i++)	
        	reward_player(who,py[i]);
	if( sizeof(py)>1 && objectp(leader) )
		CHANNEL_D->do_channel(this_object(),"rumor","听说"+leader->name(1)+HIM"带着一干人等重创了尸帝，暂时解除了长安之危！"NOR);
	else	CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+HIM"单枪匹马重创了尸帝，暂时解除了长安之危！"NOR);
        destruct(this_object());	
}

int is_boss(){return 1;}

int accept_fight(object who)
{
        tell_object(who,HIC+name()+HIC"大叫道：嘟！大胆！\n"NOR);
        return 0;
}

void check()
{
	object *inv;
	int i;
	remove_call_out("check");
	if( !environment()
	 || environment()->query("channel_id")!="始皇陵三层副本" 
	 || !this_object()->is_fighting() )
	 	return;
	if( query("eff_kee")<this_object()->query_maxkee()/5
	 && query("eff_kee")>this_object()->query_maxkee()/8 )
	{
		if( !query_temp("pw1") )
		{
			set_temp("pw1",1);
			inv = all_inventory(environment());
			message_vision(NOR"\n"HBRED"$N"HBRED"大吼一声：焚书坑儒，灭尽六国！"NOR"\n",this_object());
			for(i=0;i<sizeof(inv);i++)
			{
				if( !inv[i]->is_maze() )
					inv[i]->set_temp("no_perform",([
						"start" : time(),
						"time"  : 25,
						"msg"	: HIR+name()+HIR"发出坑儒煞气，你顿时被吓得忘记了内息的运转！\n"NOR,
					]));	
			}
		}	
	}
	if( query("eff_kee")<this_object()->query_maxkee()/3
	 && query("eff_kee")>this_object()->query_maxkee()/5 )
	{
		if( !query_temp("pw2") )
		{
			set_temp("pw2",1);
			inv = all_inventory(environment());
			message_vision(NOR"\n"HBRED"$N"HBRED"大吼一声：八荒独尊，一统天下！"NOR"\n",this_object());
			for(i=0;i<sizeof(inv);i++)
			{
				if( !inv[i]->is_maze() )
					inv[i]->set_temp("no_perform",([
						"start" : time(),
						"time"  : 15,
						"msg"	: HIC+name()+HIC"发出王霸之气，你顿时被吓得忘记了招式！\n"NOR,
					]));	
			}
		}
	}
	else
	{
		remove_call_out("check");
        	call_out("check",1);
	}
}

void kill_ob(object who)
{
	if( !query("created") )
	{
		remove_killer(who);
		who->remove_killer(this_object());
		tell_object(who,HIC+name()+HIC"大叫道：嘟！大胆！\n"NOR);
		return;
	}
        if( !this_object()->is_fihgting() )
        {
                powerup(0,1);
                stop_busy(100);
        }
        this_object()->set_follow(who);
        ::kill_ob(who);
        command("cast xiaoshen");
        remove_call_out("check");
        call_out("check",1);
}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
	string str,id;
	int p;
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	damage = ::receive_damage(type,damage,who,attack_type);	
        if( damage<=0 || query("eff_kee")<=0 )
		return ::receive_damage(type,0,who,attack_type);		
	if( type=="kee" )
		p = damage*100/(this_object()->query("eff_kee")+1);
	else	p = damage*100/(this_object()->query("eff_sen")+1);
	if( p<1 )
		return damage;
	id = who->query("id");
	if( !Hurt || !mapp(Hurt) )
		Hurt = ([id : p ]);
	else if( undefinedp(Hurt[id]) )
		Hurt[id] = p;
	else	Hurt[id]+= p;
	return damage;
}			

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	string id,str;
	int p;
	if( !who || who==this_object() || !objectp(who) || damage<10 )
		return ::receive_wound(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_wound(type,damage,who,attack_type);	
	
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	
	damage = ::receive_wound(type,damage,who,attack_type);
	if( damage<=0 )
		return ::receive_wound(type,0,who,attack_type);		
	if( type=="kee" )
		p = damage*100/(this_object()->query_maxkee()+1);		
	else	p = damage*100/(this_object()->query_maxsen()+1);
	
	if( p<1 )
		return damage;
	
	id = who->query("id");
	if( !Hurt || !mapp(Hurt) )
		Hurt = ([id : p ]);
	else if( undefinedp(Hurt[id]) )
		Hurt[id] = p;
	else	Hurt[id]+= p;
	return damage;
}

string long()
{
	string str,long = ::long();
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
	 	return long;
		 	
	str = COLOR_D->clean_color(str);	
	switch(str)	
	{
		case "厚土" : long+= HIC"怪物特效：物理免疫。\n"NOR;break;
		case "驭法" : long+= HIC"怪物特效：法术免疫。\n"NOR;break;
		case "轻灵" : long+= HIC"怪物特效：busy状态下伤害降低。\n"NOR;break;
		case "彪悍" : long+= HIC"怪物特效：物理伤害提高100%。\n"NOR;break;
		case "通灵" : long+= HIC"怪物特效：法术伤害提高100%。\n"NOR;break;
		case "吸血" : long+= HIC"怪物特效：击中回复自己1.25%的气血值。\n"NOR;break;
		case "偷心" : long+= HIC"怪物特效：击中回复自己3%的法力值。\n"NOR;break;
		case "反戈" : long+= HIC"怪物特效：受到伤害的50%反弹给攻击者。\n"NOR;break;
		case "登峰" : long+= HIC"怪物特效：物理命中提高100%。\n"NOR;break;
		case "震古" : long+= HIC"怪物特效：法术命中提高100%。\n"NOR;break;
		case "死锋" : long+= HIC"怪物特效：死亡时释放物理伤害。\n"NOR;break;
		case "死毒" : long+= HIC"怪物特效：死亡时释放毒伤害。\n"NOR;break;
		case "死幻" : long+= HIC"怪物特效：死亡时释放混乱伤害。\n"NOR;break;
		case "换日" : long+= HIC"怪物特效：击中回复自己3%的内力值。\n"NOR;break;
	}
	return long;	
}

mixed hit_ob(object me, object who,int damage,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return 0;
	if( !living(me) || !who || !me->is_fighting(who) || damage<=0 )
		return 0;
	str = COLOR_D->clean_color(str);	
	switch(str)
	{
		case "彪悍" : //物理伤害提高100%
			if( attack_type==TYPE_COMBAT || attack_type==TYPE_PERFORM || attack_type==TYPE_QUICK )
				return damage;
			break;	
		case "通灵" : //法术伤害提高100%
			if( attack_type==TYPE_CAST || attack_type==TYPE_CAST_2 )
				return damage;
			break;	
		case "吸血" : //击中回复自己1%的气血值
			me->receive_heal("kee",me->query_maxkee()/80+1);
			me->receive_curing("kee",me->query_maxkee()/80+1);
			return RED"$N"RED"开始疯狂的吸血！\n"NOR;
		case "偷心" : //击中回复自己2%的法力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/30+1);
				return HIC"$N"HIC"只觉得自己的法力越来越充沛了。\n"NOR;
			}
			break;
		case "换日" : //击中回复自己2%的内力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/50+1);
				return HIC"$N"HIC"只觉得自己的内力越来越充沛了。\n"NOR;
			}
			break;
			
	}
	return 0;		
}

int is_maze(){return 1;}
