#include <ansi.h> 
#include <combat.h> 
inherit SUPER_NPC;
#include "guai.h"

void create()
{
	string weapon,*names,title;
        int i;
        object ob;
	
	set("gender","男性");
	set("attitude", "aggressive");
	set("long",HIY"这是始皇陵中的十二将俑之一。\n"NOR);
	set("rank_info",([
		"self"    : "本将军",
		"respect" : "大将军",
		"rude"    : "你这泥糊的假将军",
	]));
	switch(random(13))
	{
		case 0 : 
			set_name("白起",({"bai qi","bai","baiqi",}));
			i = 59;
			title = HBRED"战国人屠"NOR;
			add_temp("apply/combat_damage",500);
			break;
		case 1 :
			set_name("王翦",({"wang jian","wang","wangjian",}));
			i = 59;
			title = HIY"武成侯"NOR;
			add_temp("apply/max_kee",50000);
			break;
		case 2 :
			set_name("王贲",({"wang ben","wang","wangben",}));
			i = 58;
			title = HIR"通武侯"NOR;
			add_temp("apply/max_sen",50000);
			break;
		case 3 :
			set_name("蒙恬",({"meng tian","mengtian","meng",}));
			i = 58;
			title = HIY"大将军"NOR;
			add_temp("apply/def_combat",500);
			break;
		case 4 :
			set_name("蒙毅",({"meng yi","meng","mengyi",}));
			i = 57;
			title = HIR"大将军"NOR;
			add_temp("apply/def_spells",500);
			break;									
		case 5 :
			set_name("赵奢",({"zhao she","zhao","zhaoshe",}));
			i = 59;
			title = HIC"马服君"NOR;
			add_temp("apply/def_eff_combat",500);
			break;
		case 6 :
			set_name("李牧",({"li mu","li","limu",}));
			i = 57;
			title = HIC"武安君"NOR;
			add_temp("apply/def_eff_spells",500);
			break;	
		case 7 :
			set_name("廉颇",({"lian po","lianpo","lian"}));
			i = 58;
			title = HIY"平信君"NOR;
			add_temp("apply/receive_heal_kee",500);
			break;
		case 8 :
			set_name("田单",({"tian dan","tian","tiandan",}));
			i = 59;
			title = HIG"齐相"NOR;
			add_temp("apply/combat_dodge",20);
			break;
		case 9 : 
			set_name("乐毅",({"le yi","leyi","le",}));
			i = 56;
			title = HIG"昌国君"NOR;
			add_temp("apply/spells_damage",500);
			break;
		case 10 :
			set_name("吴起",({"wu qi","wuqi","wu"}));
			i = 59;
			title = HIR"广宗伯"NOR;
			add_temp("apply/max_kee",20000);
			add_temp("apply/max_sen",20000);
			break;
		default :
			set_name("匡章",({"kuang zhang","kuangzhang","kuang",}));
			i = 58;
			title = HIC"大将军"NOR;
			add_temp("apply/max_force",3000);
			add_temp("apply/max_mana",3000);
			break;	
	}

	set("shentong/40",({"金","木","水","火","土",})[random(5)]+"_"+({"阴","阳",})[random(2)]+"_"+3+random(5)+"");
        set("bellicosity",500);
        set_level(i);
        set_skill("unarmed",i*10);
        set_skill("dodge",i*10);
        set_skill("parry",i*10);
        set_skill("stealing",i*10);
        set_skill("throwing",i*10);
        set_skill("spells",i*10);
        set_skill("force",i*10);
        set_skill("sword",i*10);
        set_skill("blade",i*10);
        set_skill("literate",i*10);
        set_skill("whip",i*10);
        set_skill("spear",i*10);
        set_skill("axe",i*10);
        set_skill("fork",i*10);
        set_skill("hammer",i*10);
        set_skill("staff",i*10);
        set_skill("stick",i*10);
        
        if( random(2) )
        {
        	create_family("大雪山",3,"");
        	if( random(10)==0 )
        		set_skill("qisi-huisheng",i*5);	
        	if( random(10)==0 )
        		set_skill("qushen",i*5);	
        	if( random(10)==0 )
        		set_skill("jiuxi-fuqi",i*5);	
        	if( random(10)==0 )
        		set_skill("huitian-fanri",i*5);	
        		
        	if( random(2) )
        	{
        		set_skill("bingpo-blade",i*10);
			map_skill("blade", "bingpo-blade");
        		map_skill("parry", "bingpo-blade");
        		weapon = "blade";
        	}
        	else
        	{
			set_skill("bainiao-jian",i*10);
			map_skill("sword", "bainiao-jian");
        		map_skill("parry", "bainiao-jian");  
        		weapon = "sword"; 
        		if( random(10)==0 )
        			set_skill("jianshu",i*5);
        		if( random(10)==0 )
        			set_skill("zhili",i*5);	     		
        	}
        	set_skill("xiaoyaoyou",i*10);
       		set_skill("dengxian-dafa",i*10);
        	set_skill("ningxie-force",i*10);
        	set_skill("cuixin-zhang",i*10);
        	map_skill("force", "ningxie-force");
        	map_skill("spells", "dengxian-dafa");
        	map_skill("dodge", "xiaoyaoyou");
        	map_skill("unarmed", "cuixin-zhang");
        }
        else if( random(2) )
        {
        	create_family("百花谷",3,"");
        	weapon = "sword";
        	set_skill("zongheng-sword",i*10);
        	map_skill("sword","zongheng-sword");
        	map_skill("parry","zongheng-sword");
		set_skill("wuyou-steps",i*10);
        	set_skill("baihua-xianfa",i*10);
        	set_skill("rainbow-zhi",i*10);
        	set_skill("brightjade-force",i*10);
		map_skill("force", "brightjade-force");
        	map_skill("spells", "baihua-xianfa");
        	map_skill("dodge", "wuyou-steps");
        	map_skill("unarmed", "rainbow-zhi");
		if( random(10)==0 )
			set_skill("butian-yuri",i*5);
		if( random(10)==0 )
			set_skill("huakai-qingke",i*5);
		if( random(10)==0 )
			set_skill("hutian",i*5);
			
        }
        else if( random(2) )
        {
        	create_family("东海龙宫",3,"");
        	set_skill("dragonstep",i*10);
        	set_skill("dragonfight",i*10);
        	set_skill("dragonforce",i*10);
        	set_skill("seashentong",i*10);
        	set_skill("huntian-hammer",i*10);
        	map_skill("force", "dragonforce");
	        map_skill("spells", "seashentong");
        	map_skill("dodge", "dragonstep");
        	map_skill("unarmed", "dragonfight");
        	map_skill("hammer","huntian-hammer");
        	if( random(10)==0 )
        		set_skill("zhidi-chenggang",i*5);	
        	if( random(10)==0 )
        		set_skill("huanyu-hufeng",i*5);	
        	if( random(10)==0 )
        		set_skill("danshan",i*5);	
        	if( random(10)==0 )
        		set_skill("duanliu",i*5);	
        	if( random(10)==0 )
        		set_skill("qiyu",i*5);	
        	
        	if( random(2) )
        	{
        		set_skill("fengbo-cha",i*10);
        		map_skill("fork", "fengbo-cha");
        		map_skill("parry", "fengbo-cha");
        		weapon = "fork";
        	}
        	else if( random(2) )
        	{
        		map_skill("parry", "dragonfight");
        		weapon = "unarmed";
        	}
        	else
        	{
        		map_skill("parry","huntian-hammer");
        		weapon = "hammer";
        	}
        }
        else if( random(2) )
        {
        	create_family("火云洞",3,"");
		set_skill("moyun-shou",i*10);
        	map_skill("unarmed", "moyun-shou");		
        	set_skill("moshenbu",i*10);
        	map_skill("dodge", "moshenbu");        	
        	set_skill("huomoforce",i*10);
        	map_skill("force", "huomoforce");        	
        	set_skill("pingtian-dafa",i*10);
        	map_skill("spells", "pingtian-dafa");
        	if( random(10)==0 )
        		set_skill("huifeng-fanhuo",i*5);	
        	if( random(10)==0 )
        		set_skill("tuyan",i*5);	
        	if( random(10)==0 )
        		set_skill("qiqing",i*5);	
        	if( random(10)==0 )
        		set_skill("zhenshan-handi",i*5);	
        	if( random(10)==0 )
        		set_skill("dali",i*5);	
        	if( random(10)==0 )
        		set_skill("zhidi-chenggang",i*5);	
        	
        	if( random(2) )
        	{
        		weapon = "stick";
        		set_skill("dali-bang",i*10);
        		map_skill("stick","dali-bang");
        		map_skill("parry","dali-bang");
        	}
        	else if( random(2) )
        	{
        		weapon = "spear";
        		set_skill("wuyue-spear",i*10);
        		map_skill("spear","wuyue-spear");
        		map_skill("parry","wuyue-spear");
        	}
        	else
        	{
        		weapon = "spear";
        		set_skill("huoyun-qiang",i*10);
        		map_skill("spear","huoyun-qiang");
        		map_skill("parry","huoyun-qiang");
        	}
        }
        else if( random(2) )
        {
        	create_family("月宫",3,"");
		set("gender","女性");
        	set_skill("moondance",i*10);
        	set_skill("moonshentong",i*10);
        	set_skill("baihua-zhang",i*10);
        	set_skill("moonforce",i*10);
		map_skill("force", "moonforce");
		map_skill("spells", "moonshentong");
	        map_skill("dodge", "moondance");
        	map_skill("unarmed", "baihua-zhang");
        	if( random(10)==0 )
        		set_skill("huifeng-fanhuo",i*5);	
        	if( random(10)==0 )
        		set_skill("jianshu",i*5);	
        	if( random(10)==0 )
        		set_skill("mengtou",i*5);	
        	if( random(10)==0 )
        		set_skill("zuohuo",i*5);	
        	
		if( random(2) )
		{
			weapon = "sword";
			set_skill("snowsword",i*10);
        		map_skill("sword", "snowsword");
        		map_skill("parry", "snowsword");
        	}
        	else
        	{
			weapon = "whip";
			set_skill("jueqingbian",i*10);
        		map_skill("whip", "jueqingbian");
        		map_skill("parry", "jueqingbian");
        	}
        }
        else if( random(2) )
        {
        	create_family("南海普陀山",3,"");
        	set("bellicosity",0);
		set_skill("lotusmove",i*10);
		set_skill("buddhism",i*10);
		set_skill("jienan-zhi",i*10);
		set_skill("lotusforce",i*10);
		map_skill("force", "lotusforce");
		map_skill("spells", "buddhism");
		map_skill("dodge", "lotusmove");
		map_skill("unarmed", "jienan-zhi");        	
        	if( random(10)==0 )
        		set_skill("tianlong-chanchang",i*5);	
        	if( random(10)==0 )
        		set_skill("jingang-sanmei",i*5);	
        	if( random(10)==0 )
        		set_skill("jingang-zhenshen",i*5);	
        	if( random(10)==0 )
        		set_skill("liuli-xindeng",i*5);	
        	if( random(10)==0 )
        		set_skill("longxiang-li",i*5);	
        	if( random(10)==0 )
        		set_skill("qu-yue",i*5);	

        	if( random(2) )
        	{
        		weapon = "staff";
			set_skill("lunhui-zhang",i*10);
			map_skill("staff", "lunhui-zhang");
        		map_skill("parry", "lunhui-zhang");
		}
		else
		{
			weapon = "blade";
			set_skill("cibeidao",i*10);
			map_skill("blade", "cibeidao");
        		map_skill("parry", "cibeidao");
        	}	
        }
        else if( random(2) )
        {
        	create_family("蜀山派",3,"");
        	weapon = "sword";
		set_skill("xianfeng-yunti",i*10);
        	set_skill("zuixian-wangyue",i*10);
        	set_skill("chuanyun-zhang",i*10);
        	set_skill("yujianshu",i*10);
        	set_skill("tianshi-fufa",i*10);
        	map_skill("spells", "tianshi-fufa");
        	map_skill("dodge", "zuixian-wangyue");
        	map_skill("force", "xianfeng-yunti");
        	map_skill("parry", "yujianshu");
        	map_skill("sword", "yujianshu");
        	map_skill("unarmed", "chuanyun-zhang");
		if( random(10)==0 )
        		set_skill("tundao",i*5);
        	if( random(10)==0 )
        		set_skill("yufeng",i*5);
        	if( random(10)==0 )
        		set_skill("jiee",i*5);
        	if( random(10)==0 )
        		set_skill("fushui",i*5);	
        	if( random(10)==0 )
        		set_skill("jiameng",i*5);        	
        }
        else
        {
        	create_family("陷空山无底洞",3,"");
        	if( random(2) )
        	{
        		set_skill("kugu-blade",i*10);
        		map_skill("parry", "kugu-blade");
        		map_skill("blade", "kugu-blade");
        		weapon = "blade";	
		}
		else
		{
			set_skill("qixiu-jian",i*10);
        		map_skill("parry", "qixiu-jian");
        		map_skill("sword", "qixiu-jian");
        		weapon = "sword";
		}
		set_skill("lingfu-steps",i*10);
        	set_skill("yaofa",i*10);
        	set_skill("huntian-qigong",i*10);
        	set_skill("yinfeng-zhua",i*10);
        	map_skill("force", "huntian-qigong");
        	map_skill("spells", "yaofa");
        	map_skill("dodge", "lingfu-steps");
        	map_skill("unarmed", "yinfeng-zhua");
        	if( random(10)==0 )
        		set_skill("zhaoyun",i*5);	
        	if( random(10)==0 )
        		set_skill("zhihua",i*5);	
        	if( random(10)==0 )
        		set_skill("feisha-zoushi",i*5);	
        }
	
        set_temp("armor_level",i);
        set_temp("weapon_level",i);
        set("env/test",({"HIR","HIB",})[random(2)]);
        set("title",title);
        setup();
        init_texing();        
        if( query("family/family_name")!="月宫" )       
        	set("force_factor",250);
	else	set("force_factor",0);
	if( query("family/family_name")=="蜀山派" ) 
        	carry_object("/obj/paper_seal")->set_amount(1000);
	names = ({
        	"cloth","armor","kui","pifeng","hand","neck","ring",
        	"wrists","shoes","waist",
        });
        for(i=0;i<sizeof(names);i++)
        {
        	if( objectp(ob=carry_object(0,names[i],1)) )
        	{
        		ob->set("armor_title",query("name"));
        		ob->wear();
        	}
        }
        if( objectp(ob=carry_object(0,weapon,1)) )
        {
        	ob->set("weapon_title",query("name"));
        	ob->wield();
        }
        add_temp("apply/max_kee",i*4000);
        add_temp("apply/max_sen",i*4000);
        add_temp("apply/max_force",i*600);
        add_temp("apply/max_mana",i*600);
        powerup(0,1);
}

void reward_player(object who,object pl)
{
        string arg,file,*dir,*env,color;
        object ob,weapon;
        int i,succ,k;
        
        if( !pl || !living(pl) ||!userp(pl) )
                return;
        if( pl->query_level()<50 )
        {
                if( random(100)>30 && !wizardp(pl) )
                        return;
        }               
        arg = "";
        succ = pl->query_kar();
        if( pl->query_level()<50 )
                succ = random(20)+1;            
        if( who==pl )
                succ = succ*2;

	if( !arrayp(env=pl->query_temp("maze/equip_color")) )
        	env = 0;                
	if( random(succ/10)>3 )
	{                
         	dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",
        	});
               	file = dir[random(sizeof(dir))];
               	if( file )
               	{
                       	dir-=({file});
                        ob = new("/d/obj/narmor/"+file);
       	                if( random(100)>95 )
       	                	set("env/test",({"HIM","HIR"})[random(2)]);
       	                else	set("env/test",({"HIR","HIB","HIB","HIB","HIC","HIY",})[random(6)]);  
                       	ob->init_armor(this_object());
                       	if( stringp(color=ob->query("armor_color")) 
                       	 && env && member_array(color,env)==-1 )
			{
				tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                                destruct(ob);
                        }
                       	else if( !ob->move(pl) )
       	                {
               	                destruct(ob);
                       	        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                       	}
                        else    
       	                {
               	                //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                       	        arg+= obj_name(ob);
                               	if( i!=0 && arg!="" )
                                       	arg+= "、";
                       	}
       		}
       	}	
        
        succ = random(pl->query_kar())/10;
        if( succ>3 )
        {
        	dir = ({"axe","blade","blade","hammer","mace","spear","staff","stick","sword","unarmed","whip","fork","dagger",});
        	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/nweapon/"+file);
                if( random(100)>95 )
			set("env/test",({"HIM","HIR"})[random(2)]);
                else	set("env/test",({"HIR","HIB","HIB","HIB","HIC","HIY",})[random(6)]);  
                ob->init_weapon(this_object());
                if( stringp(color=ob->query("weapon_color"))
                 && env && member_array(color,env)==-1 )
		{
                	tell_object(pl,HIY"【副本】始皇陵三层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        destruct(ob);
                }        
                else if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                        	arg+= "、";
                        arg+= obj_name(ob);
                }
        }
        
	succ = random(pl->query_kar());
        if( random(succ)>15 )
        {
                file = sprintf("/d/maze/qingling-3/obj/sp%d",1+random(5));
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
		k = random(5)+1;
		ob->set_amount(k);
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                        	arg+= "、";
                        arg+= chinese_number(k)+"颗"+obj_name(ob);
                }
        }        
        
        succ = random(pl->query_kar());
        if( random(succ)>5 )
        {
                file = ("/d/maze/qingling-3/obj/life");
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                else    
                {
                        //tell_object(pl,HIY"【副本】始皇陵三层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
                        	arg+= "、";
                        arg+= obj_name(ob);
                }
        }

        succ = random(pl->query_kar());
        if( succ>8 )
        {
                ob = new("/d/maze/qingling-3/obj/bangding.lpc");
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵三层：你的背包满了。\n"NOR);
                }
                //else    tell_object(pl,HIY"【副本】始皇陵三层：你得到了一块"HIG"绑定用的灵石"HIY"。\n"NOR);
        	if( arg!="" )
			arg+= "、";
                arg+= "一块绑定石";
        }
                
	k = 250000+random(50000);
	pl->add("combat_exp",k);
	if( arg!="" )
        	arg+= "、";
	arg+= k+"点武学经验";
	//tell_object(pl,HIY"【副本】始皇陵三层：你得到了"HIR+k+HIY"点武学经验。\n"NOR);
	if( !pl->query_temp("maze/kill_"+query("name")) )
		pl->set_temp("maze/kill_"+query("name"),1);
        if( objectp(pl->query_leader()) && arg!="" )
                pl->team_talk(pl->name(1)+"得到了"+arg+HIW"。"NOR);
	else	tell_object(pl,HIG"【系统】你得到了"+arg+HIG"。"NOR"\n");                
}

void reward_ob(object who)
{
        object leader,*t,*py;
        int i;
	string str;
	
        if( !who || !userp(who) || !present(who,environment()) 
         || environment()->query("channel_id")!="始皇陵三层副本" )
        {
                message_vision (HIR"\n$N"HIR"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"碎土"NOR HIR"。\n\n"NOR,this_object());
                destruct(this_object());
                return;
        }
        message_vision (HIC"\n$N"HIC"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"碎土"NOR HIC"。\n\n"NOR,this_object());
	if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }        
        py = ({});
        if( !objectp(leader=who->query_leader()) )
        	py = ({who});
        else	
        {
        	if( !pointerp(t=leader->query_team()) )
        		py = ({who});
        	else
        	{
        		for(i=0;i<sizeof(t);i++)
        		{
        			if( t[i] && living(t[i]) && present(t[i],environment()) )
        				py+= ({t[i]});
        		}
        	}	
        }
        for(i=0;i<sizeof(py);i++)	
        	reward_player(who,py[i]);
        if( random(10)==3 )
        {	
        	if( sizeof(py)>1 )
        		str = "等一干人";
        	else	str = "单枪匹马";
        	CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+str+"在始皇陵三层干掉了"HIY+query("name")+"的将俑"HIM"，得到了海量的经验。"NOR);
        }
        destruct(this_object());	
}

int is_boss(){return 1;}

varargs string name(int v)
{
	string str = ::name(v);
	return str+"之将俑";
}