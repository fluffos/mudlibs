#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short","水下");
        set("channel_id","水灵珠副本");
        set("long", @LONG
水底到处都是些水草，还有些小虾米，鱼儿穿来穿去，偶尔还能看到
几具骸骨。

LONG );
        set("alternative_die",1);
        setup();
}

int alternative_die(object who)
{
        object target;
        string file,msg;
        if( !who )
                return 1;
        if( !userp(who) )
        {
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,environment(who)) )
                {
                        who->reward_ob(target);
                        return 0;
                }
                else
                {
                	message_vision(HIR"$N"HIR"脸色大变。\n"NOR,who);
                	return 1;
                }
        }
        target = who->query_temp("last_damage_from");
        if( target && !userp(target) )
        {
        	target->command("chat* haha "+who->query("id"));
        	target->command("chat* nokill "+who->query("id"));
        	destruct(target);
        }
        who->powerup(0,1);
        file = "/d/luoyang/hebian";
       	who->move(file,2);
        who->set("maze/lingzhu-shui",time());
        who->delete_temp("maze");
	message_vision("\n"HIC"$N"HIC"狼狈不堪地从水中跳了出来。\n"NOR,who);
        return 0;
}                       

int do_drop(string arg)
{
	return ("/d/city/droproom.c")->do_main(arg);
}

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "recall","move","maphere","map","find",
                "follow","gen",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}

void init()
{
        if( userp(this_player()) )
        {
                add_action("do_cmds","",1);
                add_action("do_drop","drop");
        }
}