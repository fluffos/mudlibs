//妖fc moon hell jjf shushan
#include <ansi.h>
#include <combat.h>
inherit NPC;

nosave string weapon_type = "unarmed";
nosave int Die = 0;
nosave int Num = 1;
nosave int Super = 0;
nosave int default_level = 390;

void init_skill() {
  string *skills;
  object *inv;
  int i;
  mapping skill;
  skill = query_skills();
  if (!skill || !mapp(skill))
    return;
  skills = keys(skill);
  if (skills && arrayp(skills)) {
    for (i = 0; i < sizeof(skills); i++)
      delete_skill(skills[i]);
  }
  inv = all_inventory();
  if (intp(i = sizeof(inv)) && i > 0) {
    while (i--) {
      if (!userp(inv[i])) {
        inv[i]->unequip();
        inv[i]->move("/obj/empty");
        REMOVE_D->add_obj(inv[i], 1);
      } else inv[i]->move("/obj/void");
    }
  }
  reset_action();
}

