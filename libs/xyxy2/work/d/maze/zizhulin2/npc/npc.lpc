#include <ansi.h>
inherit F_VENDOR_SALE;

void create() {
  object ob;
  set_name("游方行者", ({ "xing zhe", "xingzhe", "monk" }));
  create_family("南海普陀山", 3, "弟子");
  set_level(70);

  set("age", 40);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("force_factor", 120);
  set("mana_factor", 110);

  set("eff_dx", 40000);
  set("nkgain", 250);

  set_skill("literate", 700);
  set_skill("spells", 700);
  set_skill("buddhism", 700);
  set_skill("unarmed", 700);
  set_skill("jienan-zhi", 700);
  set_skill("dodge", 700);
  set_skill("lotusmove", 700);
  set_skill("parry", 700);
  set_skill("force", 700);
  set_skill("lotusforce", 700);
  set_skill("staff", 700);
  set_skill("lunhui-zhang", 700);
  set_skill("blade", 700);
  set_skill("cibeidao", 700);
  map_skill("blade", "cibeidao");
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");

  set("任务", 1);
  set("vendor_goods", ([
    "yao": "/d/obj/drug/jinchuang",
    "dan": "/d/obj/drug/hunyuandan",
    "force": "/d/obj/drug/bihai-yinping",
    "yao3": "/d/obj/drug/jinchuang3",
    "dan3": "/d/obj/drug/hunyuandan3",
    "yao2": "/d/obj/drug/jinchuang2",
    "dan2": "/d/obj/drug/hunyuandan2",
  ]));
  set("inquiry", ([
    "拣取": "如果你对打到的装备有品质要求，可以在我这里记录(mark)一下。\n",
    "地图": "你在迷宫之中可以自行查看地图(map)。\n",
  ]));
  set("env/test", "HIR");
  setup();

  ob = carry_object(0, "armor", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "cloth", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "shoes", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "pifeng", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "kui", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  carry_object(0, "staff", 1)->wield();
  powerup(0, 1);
}

void init() {
  ::init();
  add_action("do_mark", "mark");
}

int do_mark(string arg) {
  int i;
  string str, *tmp, *temp;
  mapping color = ([
    "HIM": "紫",
    "HIR": "红",
    "HIC": "青",
    "HIB": "蓝",
    "HIY": "金",
  ]);
  if (!arg)
    return notify_fail(name() + "问道：你想记录哪些颜色，多种颜色可以用" HIY " , " NOR "分开。\n示例：mark HIC,HIM");
  arg = replace_string(arg, "，", ",");
  if (strsrch(arg, ",") == -1) {
    if (undefinedp(color[arg]))
      return notify_fail(name() + "说道：" + arg + " 这样颜色可没有。\n");
    else tmp = ({ arg });
  } else {
    temp = explode(arg, ",");
    tmp = ({});
    for (i = 0; i < sizeof(temp); i++) {
      if (undefinedp(color[temp[i]]))
        return notify_fail(name() + "说道：" + temp[i] + " 这样颜色可没有。\n");
      tmp += ({ temp[i] });
    }
  }
  str = "";
  for (i = 0; i < sizeof(tmp); i++) {
    str += color[tmp[i]] + "色";
    if (i < sizeof(tmp) - 1)
      str += "、";
  }
  this_player()->set_temp("maze/equip_color", tmp);
  write(HIC + name() + HIC "念叨佛偈，朝你一指。\n" NOR);
  write(CYN + name() + CYN "说道：阿弥陀佛，好了，除了" + str + "，其他品质的装备会自动清除。\n" NOR);
  return 1;
}

void heart_beat() {
  object *inv, me = this_object();
  int i;
  if (!environment())
    return;
  ::heart_beat();
  if (!environment()->query("virtual_room"))
    return;
  inv = all_inventory(environment());
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me
      || userp(inv[i])
      || !inv[i]->is_zzl())
      continue;
    message_vision(HIR "$N" HIR "一见$n" HIR "顿时现了金刚怒相，嗔道：孽障，尚不知悔改！\n" NOR, me, inv[i]);
    switch (random(3)) {
      case 0:
        message_vision(
          HIC "$N" HIC "口中念了几句咒文，半空中现出阿傩，迦叶二尊者，各人手执一根巨大无比的降魔杵，呼！地一声向$n" HIC "当头砸下！\n结果砸个正着，差点没把$n" HIC "砸扁！\n" NOR,
          me,
          inv[i]
        );
        message_vision(NOR "( " RED "$N" RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR " )\n", inv[i]);
        message_vision(NOR "( " RED "$N" RED "心智已经完全迷失，随时都有可能背过气去。" NOR " )\n", inv[i]);
        break;
      default:
        message_vision(
          HIY "只听$N" HIY "垂眉凝目，双掌之上渐渐泛起金光，金光愈来愈强，映得$N" HIY "宝象庄严，$N" HIY "低声诵佛，单手一托，金光闪烁间化作一只金色大佛山，遮天蔽日压向$n" HIR "！\n“轰隆”一声巨响，$n" HIR "顿时被压在佛掌之下，动弹不得！\n" HIY "但见$n" HIY "哇的一声,被佛掌压住，顿时浑身骨骼发出阵阵碎响，整个人给震得倒飞而出！\n" NOR,
          me,
          inv[i]
        );
        message_vision(NOR "( " RED "$N" RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR " )\n", inv[i]);
        break;
    }
    message_vision(HIC "\n$N" HIC "念动真言，收了$n" HIC "！\n" NOR, me, inv[i]);
    all_inventory(environment())->remove_killer(inv[i]);
    inv[i]->remove_all_killer();
    inv[i]->move("/d/maze/zizhulin2/empty");
    REMOVE_D->add_obj(inv[i], 1);
  }
}
