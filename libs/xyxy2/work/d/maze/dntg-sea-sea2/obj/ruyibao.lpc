#include <ansi.h>
inherit ITEM;

void create() {
  string msg;
  set_name(HIG "如意宝" NOR, ({ "ruyi bao", "bao", "jgb" }));
  set(
    "long",
    HIM "天河定底的神珍铁碎片，霞光艳艳，瑞气腾腾，乃是一件神兵的碎片。" NOR "\n用它可以将两件绑定的武器组合(combination)为一件，战斗中可以通过变化(bianhua)命令来转换形态。\n"
  );
  set("unit", "块");
  set("value", 0);
  setup();
}

void gift(object me) {
  remove_call_out("gift");
  if (me && present(this_object(), me)
    && query("used")) {
    me->add("inventory/jgb", 1);
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      "听说" + me->name() + HIM "得到了东海宝藏" HIG "如意宝" HIM "！" NOR
    );
  }
  destruct(this_object());
}

void init() {
  object me = this_player();
  if (!query("used")) {
    if (present(this_object(), me)) {
      set("used", 1);
      remove_call_out("gift");
      call_out("gift", 1, me);
    }
  }
}
