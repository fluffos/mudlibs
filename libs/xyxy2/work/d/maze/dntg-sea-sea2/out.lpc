#include <ansi.h>
inherit "/d/maze/dntg-sea-sea2/room.lpc";

void create() {
  set("short", "海底迷宫");
  set("channel_id", "水晶宫");
  set("long", @LONG
海水又变的清澈了，但你已经很难找到方向了。四周的景物好象都一样，要是没人引路的话看来
很难出去了。
LONG);
  set("virtual_room", 1);
  set("alternative_die", 1);
  set("no_huicheng", 1);
  set("no_chuqiao", 1);
  set("init_guai", 1);
  set("exits", ([
    "enter": __FILE__,
  ]));
  set("item_desc", ([
    "enter": @LONG
海水又变的清澈了，但你已经很难找到方向了。四周的景物好象都一样，要是没人引路的话看来
很难出去了。
LONG,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  object room;
  if (!userp(who) || dir != "enter")
    return ::valid_leave(who, dir);
  who->delete_temp("maze");
  who->dismiss_team();
  room = clone_object("/d/maze/dntg-sea-sea2/haizang");
  who->move(room);
  return 2;
}
