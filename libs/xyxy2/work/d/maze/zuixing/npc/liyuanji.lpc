inherit NPC;
#include <ansi.h>

void yungong() {
  ("/cmds/std/exert.lpc")->main(this_object(), "recover");
  ("/cmds/std/exert.lpc")->main(this_object(), "refresh");
}

void create() {
  set_name("李元吉<鬼魂>", ({ "li yuanji", "li", "yuanji", "liyuanji", "jianwang", "wang", "ghost" }));
  set_level(39);
  create_family("将军府", 3, "蓝");
  set("title", "建王");
  set("gender", "男性");
  set("age", 43);
  set("per", 36);
  set("long", @LONG
李元吉乃是唐高祖李渊的三子，受封建王。三子中以李元吉最
为无用。他空有一身蛮力，但无恶不作，毫不以领地百姓为重。
且在作战时屡失重要据点，实在令高祖大为头痛。后来玄武门之
变，被世宗皇帝斩首。
LONG);
  set("looking", YEL "披头散发，宛如厉鬼" NOR "。");
  set("rank_info/pos_msg", HIB "浑身上下朦朦胧胧，笼罩在一团鬼气之中" NOR "。\n");

  set_skill("literate", 390);
  set_skill("force", 390);
  set_skill("dodge", 390);
  set_skill("parry", 390);
  set_skill("mace", 390);
  set_skill("wusi-mace", 390);
  set_skill("yanxing-steps", 390);
  set_skill("lengquan-force", 390);
  set_skill("unarmed", 390);
  set_skill("changquan", 390);
  map_skill("mace", "wusi-mace");
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("parry", "wusi-mace");
  map_skill("dodge", "yanxing-steps");

  set_skill("jiameng", 390);
  set_skill("jinshui", 390);

  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "mace", "andu" :),
    (: perform_action, "mace", "jingtian" :),
    (: perform_action, "mace", "suo" :),
    (: yungong :),
  }));

  set("force_factor", 80);
  set("env/test", "HIR");
  setup();
}

void set_skills(object who) {
  mapping skill;
  object *inv, ob;
  string *skills, *obj;
  int j, level, i;
  if (!who)
    return;
  level = who->query_level() - random(10);
  if (level < this_object()->query_level())
    level = this_object()->query_level();
  set_level(level);
  j = level * 10;
  j = level * 3 / 5 + random(level * 2 / 5);

  skill = this_object()->query_skills();
  skills = keys(skill);
  for (i = 0; i < sizeof(skills); i++)
    set_skill(skills[i], j);
  inv = all_inventory();
  if (inv && pointerp(inv) && sizeof(inv) > 0) {
    for (i = 0; i < sizeof(inv); i++)
      destruct(inv[i]);
    reset_action();
  }
  setup();
  obj = ({
    "armor", "kui", "pifeng", "ring", "cloth", "shoes", "wrists", "waist", "hand",
  });
  for (i = 0; i < sizeof(obj); i++) {
    ob = carry_object(0, obj[i], 1);
    ob->set("armor_title", "李元吉");
    ob->wear();
  }
  ob = carry_object(0, "mace", 1);
  ob->set("weapon_title", "李元吉");
  if (!command("wield " + ob->query("id")))
    ob->wield();
  add_temp("apply/max_kee", 50000);
  add_temp("apply/max_sen", 50000);
  powerup(0, 1);
}

int accept_fight(object who) { return 0; }

void kill_ob(object who) {
  object jian;
  if (!userp(who)) {
    remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  if (!who->query_temp("jjf/醉星楼2")) {
    remove_killer(who);
    who->remove_killer(this_object());
    tell_object(who, CYN + name() + CYN "说道：冤有头债有主，我只找世民小儿的晦气！\n" NOR);
    return;
  }
  if (query_temp("my_killer")
    && who != query_temp("my_killer")) {
    remove_killer(who);
    who->remove_killer(this_object());
    return;
  } else if (query_temp("my_killer"))
    ;
  else {
    powerup(0, 1);
    set_temp("my_killer", who);
    set_skills(who);
    tell_object(who, CYN + name() + CYN "说道：好好好，定是那六亲不认的竖子指使你来坏某家的醉星楼！\n" NOR);
    if (objectp(jian = present("li jiancheng", environment()))
      && base_name(jian) == "/d/maze/zuixing/npc/lijiancheng"
      && !jian->is_fighting()) {
      say(CYN "李元吉说道：哥哥助我！\n" NOR);
      jian->kill_ob(who);
    }
  }
  ::kill_ob(who);
}

void die() {
  object ob, who;

  message_vision(HIB "\n$N" HIB "惨叫一声，身形渐渐淡出，口中犹在不忿的嘶叫。。。。\n" NOR, this_object());
  who = query_temp("last_damage_from");
  if (!who || who != query_temp("my_killer")
    || !environment()
    || (objectp(ob = present("ling jian", who)) && ob->query("name_recognized") == "建府令箭")) {
    destruct(this_object());
    return;
  }
  ob = new("/d/jjf/obj/lingjian-jian");
  ob->move(environment());
  tell_room(environment(), HIC "\n鬼气散去，原地现出了一支令箭。\n\n" NOR);
  destruct(this_object());
}

void unconcious() {
  die();
}
