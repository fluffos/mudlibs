#include <ansi.h>
inherit "/d/maze/zuixing/room.lpc";

void create() {
  set("short", "醉星楼二楼");
  set("long", @LONG
这里是醉星楼的一角，迎面就是一根巨大的柱子(zhuzi)。拐角
是一面玉石屏风，上绘嫦娥奔月的故事。
    现在空荡荡的，没有一个人影。
LONG);
  set("item_desc", ([
    "zhuzi": "一根巨大的柱子，撑起了醉星楼的一角，可千万别砍(chop)哦。\n",
  ]));
  set("alternative_die", 1);
  setup();
}

void init() {
  add_action("do_kan", "砍");
  add_action("do_kan", "chop");
  add_action("do_kan", "kan");
}

void finish_zuixing(object me) {
  if (!me)
    return;
  if (me->query_temp("jjf/醉星楼2")
    || me->query_temp("jjf/zuixing_break") < 4
    || me->is_knowing("jjf_zuixing"))
    return;
  me->delete_temp("jjf");
  tell_object(me, HIY "恭喜恭喜！你成功拆了醉星楼二楼，一鼓作气，赶紧去拆了一楼就算完事了！\n" NOR);
  message("channel:chat", HIC "\n【谈天说地】尉迟恭哈哈大笑了几声。\n\n" NOR, users());
  tell_object(me, HIG "尉迟恭(Yuchi gong)告诉你：在二楼找到两支令箭，骗走楼下的家兵。\n" NOR);
  me->set_temp("jjf/醉星楼2", 1);
}

int do_kan(string arg) {
  string data;
  object me = this_player(), here = this_object(), weapon;
  int x, y, kar = me->query_kar();

  if (me->query_temp("jjf/醉星楼2"))
    return notify_fail("柱子都塌了，还砍什么砍？要命的快出去吧！\n");
  if ((!arg || arg != "柱子") && (arg != "zhuzi" && arg != "pillar"))
    return err_msg("你要从哪里下手？\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || weapon->query("skill_type") == "unarmed")
    return notify_fail("没顺手的家伙怎么拆得动？\n");
  if (query("breaked"))
    return err_msg("柱子都塌了，还砍什么砍？\n");
  if (me->is_busy() || me->is_fihgting())
    return err_msg("你现在正忙着呢。\n");
  if (me->query("kee") < 300)
    return err_msg("你现在太累了。\n");
  message_vision("$N用足了劲，将" + weapon->name() + "抡圆了砸向彩楼的柱子！只见几片木片四散飞开。\n", me);
  me->add_temp("pending/breaking", 1);
  if (random(me->query_temp("pending/breaking")) > 5) {
    set("breaked", 1);
    x = query("maze/x");
    y = query("maze/y");
    data = x + "_" + y;
    if (!me->query_temp("jjf/zx_" + data)) {
      me->set_temp("jjf/zx_" + data, 1);
      me->add_temp("jjf/zuixing_break", 1);
    }
    arg = "只听一声巨响，柱子从中折断，";
    if (me->query_temp("jjf/zuixing_break") == 1)
      arg += "整栋醉星楼传来一阵轰鸣之声，片刻之后声音才渐渐低去。\n";
    else if (me->query_temp("jjf/zuixing_break") == 2)
      arg += "整栋醉星楼传来一阵轰鸣之声，一炷香的光阴之后声音才渐渐低去。\n";
    else if (me->query_temp("jjf/zuixing_break") == 3)
      arg += "整栋醉星楼传来一阵轰鸣之声，很明显感到整栋楼有些倾斜！\n";
    else arg += "整栋醉星楼轰鸣不绝，四下楼板纷纷落下，要塌了！\n";
    message_vision("\n" + arg + "\n", me);
    if (me->query_temp("jjf/zuixing_break") == 4) {
      finish_zuixing(me);
      return 1;
    }
    set("long", @LONG
这里曾经是一间华丽无比的房间，但现在只剩一片废墟。几块烂木头
下面到处都是酒杯碗筷的碎片。
LONG);
    set("item_desc", ([
      "zhuzi": "早被人砍坏了，一片狼藉。。。。\n",
    ]));
  } else write("结果你累了一脖子的粗汗。。。。\n");
  me->receive_damage("kee", 300);
  return 1;
}
