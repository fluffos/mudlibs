#include <ansi.h>
inherit __DIR__ "wang.lpc";

nosave string *Txs = ({
  HIM "驭法" NOR, HIY "厚土" NOR, HIG "轻灵" NOR, HIR "彪悍" NOR, HIM "通灵" NOR, RED "吸血" NOR, HIB "偷心" NOR, HIC "培元" NOR, HIW "反戈" NOR,
});

void create() {
  string *tx, ss;
  int i;
  object weapon;

  set_name("白无常", ({ "bai wuchang", "wuchang", "bai" }));
  set("long", "一个白衣白净面皮的使者，死白的脸上看不出任何喜怒哀乐。\n");
  set_level(80);
  set("attitude", "peaceful");
  create_family("阎罗地府", 4, "你好");
  set("per", 30);
  set("title", "引魄司主");
  set("class", "ghost");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("force_factor", 220);
  set("mana_factor", 220);

  set_skill("jinghun-zhang", 800);
  set_skill("tonsillit", 800);
  set_skill("gouhunshu", 800);
  set_skill("unarmed", 800);
  set_skill("sword", 800);
  set_skill("whip", 800);
  set_skill("hellfire-whip", 800);
  set_skill("zhuihun-sword", 800);
  set_skill("stick", 800);
  set_skill("kusang-bang", 800);
  set_skill("dodge", 800);
  set_skill("ghost-steps", 800);
  set_skill("parry", 800);
  set_skill("spells", 800);
  set_skill("force", 800);
  set_skill("literate", 800);
  map_skill("stick", "kusang-bang");
  map_skill("sword", "zhuihun-sword");
  map_skill("parry", "kusang-bang");
  map_skill("whip", "hellfire-whip");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  set_skill("jianshu", 800);
  set_skill("mengtou", 800);
  set_skill("dali", 800);
  set_skill("jiefeng", 800);
  set_skill("yanri", 800);
  set("weapon_type", "stick");
  set_temp("weapon_level", 80);
  set_temp("armor_level", 80);
  set("env/test", ({ "HIM", "HIR" })[random(2)]);
  set("wang_pfm", 8);
  set("wang_cast", 8);
  setup();
  tx = ({});
  i = random(2) + 1;
  while (i--) {
    ss = Txs[random(sizeof(Txs))];
    tx += ({ ss });
    Txs -= ({ ss });
  }
  set("my_type", tx);
  init_texing();
  if (objectp(weapon = query_temp("weapon"))) {
    weapon->set_name("哭丧棒", ({ "kusang bang", "bang", "stick" }));
    weapon->set("weapon_title", "白无常");
    weapon->setup();
  }
  set("max_kee", 15000);
  set("max_sen", 15000);
  powerup();
}

void reward_ob(object who) {
  string king, *wangs;
  if (!who || !living(who)
    || !environment()
    || !present(who, environment()))
    return;
  if (who->query("dntg/hell") == "done")
    return;

  all_inventory(environment())->remove_killer(this_object());
  this_object()->remove_all_killer();
  this_object()->powerup();

  all_inventory(environment())->remove_killer(who);
  who->remove_all_killer();
  who->clear_condition();

  if (!arrayp(wangs = who->query_temp("maze/kings"))
    || sizeof(wangs) < 1) {
    wangs = ({
      "秦广王", "楚江王", "宋帝王", "仵官王", "平等王",
      "都市王", "泰山王", "轮转王", "卞城王", "阎罗王",
    });
    who->set_temp("maze/kings", wangs);
  }
  if (!stringp(king = who->query_temp("maze/last_king"))
    || strlen(king) < 2) {
    king = wangs[random(sizeof(wangs))];
    who->set_temp("maze/last_king", king);
    message_vision(
      HIY "\n\n$N" HIY "被打得招架不住，慌忙从怀中掏出一封批文，讨饶道：" + RANK_D->query_respect(who) + "饶命，此乃" HIG + king + HIY "发下的勾魂批文，小的也是照章办事啊！\n" NOR,
      this_object()
    );
    message_vision(HIR "$N" HIR "看罢批文，勃然大怒，把批文撕了个粉碎，大叫：“待我去找这个昏王评理！”\n" NOR, who);
  } else message_vision(
    HIY "\n\n$N" HIY "被打得招架不住，慌忙讨饶：" + RANK_D->query_respect(who) + "饶命，小的亦是奉" HIG + king + HIY "的命令办事。\n" NOR,
    this_object()
  );
  message_vision(HIY "$N" HIY "将手一摆，道：你且滚去一旁，我自去找那昏王评理！\n" NOR, who);
  message_vision("\n$N见$n罢了手，如蒙大赦，慌忙化作一道黑烟散去。\n\n" NOR, this_object(), who);
  destruct(this_object());
  return;
}
