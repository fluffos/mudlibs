#include <ansi.h>
inherit "/d/maze/dntg-hell/room.lpc";

void create() {
  set("short", HIB "阴" HIW "阳" HIR "界" NOR);
  set("channel_id", "阎罗地府");
  set("long", @LONG
LONG);
  set("virtual_room", 1);
  set("alternative_die", 1);
  set("no_huicheng", 1);
  set("no_chuqiao", 1);
  set("init_guai", 1);
  set("outdoors", 0);
  set("exits", ([
    "north": __DIR__ "maze/entry",
  ]));
  set("objects", ([
    "/d/maze/dntg-hell/npc/hei": 1,
    "/d/maze/dntg-hell/npc/bai": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  object npc;
  if (!userp(who))
    return 0;
  if (objectp(npc = present("hei wuchang", this_object()))
    && !userp(npc))
    return notify_fail(npc->name() + "一把拉住了你：汝阳寿已尽，不得乱跑，待判官爷爷来定你的罪！\n");
  if (objectp(npc = present("bai wuchang", this_object()))
    && !userp(npc))
    return notify_fail(npc->name() + "一把拉住了你：汝阳寿已尽，不得乱跑，待判官爷爷来定你的罪！\n");
  return ::valid_leave(who, dir);
}
