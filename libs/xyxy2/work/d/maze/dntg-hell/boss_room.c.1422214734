#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short",HIR"幽司"NOR);
	set("alternative_die",1);
        set("no_huicheng",1);
        set("no_chuqiao",1);
        set("outdoors",0);
        set("hell",1);
        set("long", @LONG
这里便是阴间地府十王之%s的宫殿。平时若是无事，%s便会在殿上处理一
些杂务。殿上一张大木桌，桌上堆了一些文告之类，一个小青铜炉吐着淡淡的的青烟，
一个青衣童子侍立于后。
LONG );
        setup();
}
                     
int do_drop(string arg)
{
	return ("/d/city/droproom.c")->do_main(arg);
}

int do_cmds(string arg)
{
        string *nocmds,verb = query_verb();
        nocmds = ({
                "recall","move","maphere","fight","find",
        });
        if( member_array(verb,nocmds)==-1 )
                return 0;
        write("ok\n");
        return 1;
}

object query_wang()
{
	object *inv;
	int i;
	string name;
	if( !stringp(name=query("wang")) 
	 || strlen(name)<2 )
	 	return 0;
	if( !pointerp(inv=all_inventory()) 
	 || !intp(i=sizeof(inv))
	 || i<1 )
	 	return 0;
	while(i--)
	{
		if( inv[i]->query("name")==name
		 && !userp(inv[i])
		 && inv[i]->is_character() )
		 	return inv[i];
	}
	return 0;	 	
}

varargs void wang_check(object who,int dead)
{
	string name,str,king,*wangs;
	object npc;
	if( !who || query("owner")!=who 
	 || !present(who,this_object()) )
		return;
	if( !stringp(name=query("wang")) 
	 || strlen(name)<2 )
	 	return;
	if( !objectp(npc=query_wang()) )
		return;
	sscanf(name,"%s王",str);
	if( !dead )	
		message_vision(HIY"\n$N"HIY"怒气冲冲闯将进来，喝道：“"+str+"老儿，"+RANK_D->query_self_rude(who)+"本为三界之外，不在五行之中的异人，不归阴司管辖，怎么又来勾我？！”\n\n"NOR,who);
	else	message_vision(HIY"\n$N"HIY"将"+name+"打翻在地，踏上一脚喝道：“"+str+"老儿，"+RANK_D->query_self_rude(who)+"本为三界之外，不在五行之中的异人，不归阴司管辖，怎么又来勾我？！”\n\n"NOR,who);	
	if( who->query_temp("maze/last_king")!=name )
	{
		if( !dead )
		{
			message_vision(HIY"$N"HIY"皱了皱眉头，对$n"HIY"说道：“此事非我经手。冤有头，债有主，既是"HIR+who->query_temp("maze/last_king")+HIY"遣人勾你，你便去找他吧。”\n\n"NOR,npc,who);
			message_vision(HIR"$N"HIR"皱了皱眉头，对$n"HIR"说道：“你我阴阳殊途，我不治你私闯幽冥之罪，也就是了。还不快快退下！”\n\n"NOR,npc,who);
		}
		else	message_vision(HIC"$N"HIC"慌忙求饶：“此事非我经手。冤有头，债有主，既是"HIR+who->query_temp("maze/last_king")+HIY"遣人勾你，你便去找他吧。”\n\n"NOR,npc,who);
	}
	else		
	{
		if( !who->query_temp("maze/"+name+"killed") )
		{
			message_vision("\n"HIR"$N"HIR"恼羞成怒道：“本王叫你三更死，谁敢留你到五更。待我亲自送你去见崔判官！”\n\n"NOR,npc);
			npc->powerup();
			npc->kill_ob(who);
			who->fight_ob(npc);
			return;
		}
		else
		{
			message_vision(HIW"\n$N"HIW"说道：「不打了，不打了，我投降....。」\n\n"NOR,npc);
			wangs = who->query_temp("maze/kings");
			king = wangs[random(sizeof(wangs))];
			
			if( who->query_temp("maze/"+king+"killed") 
			 && random(3)==1 )
			{
				message_vision(HIC"$N"HIC"翻了翻案上的文书，对$n"HIC"说道：“此事乃"HIR+king+HIC"传文至此，要小王勾拿"+RANK_D->query_respect(who)+"，"+RANK_D->query_respect(who)+"还是去找他理论吧。\n\n"NOR,npc,who);				
				message_vision(HIR"$N"HIR"拍案大叫：“怎么又是"+king+"？！你这奸王竟敢耍弄于我！拿命来！”\n\n"NOR,who);
				message_vision(HIR"$N"HIR"吓得魂飞魄散，颤身说：“罢了罢了，依你，都依你。”\n"NOR,npc);
				message_vision(HIY"\n$N"HIY"从案上拿出生死簿，提起朱笔，饱蘸浓墨，将「"+HIC+who->query("name")+HIY"」划去。\n\n"NOR,npc);
				set("channel_id",npc->query("name")+"("+capitalize(npc->query("id"))+")");
				CHANNEL_D->do_channel(this_object(),"chat",who->name()+"这"+RANK_D->query_rude(who)+"逞强行凶，不服拘唤，大闹罗森，强销名号，待我上天禀明玉帝，再来拿你！");
				who->set("dntg/hell","done");
                   who->add("dntg/number",1)
                        who->add("dntg/number",1)
q
q
q
				who->set("life/no_death_decrease",1);
				tell_object(who,HIY"恭喜恭喜！从此以后，你死亡后再也不减少阳寿了。"NOR"\n");
				if( who->level_up() )
				{
					tell_object(who,HIG"【系统】你的等级提升了"HIR"1"HIG"级。\n"NOR);
					CHAR_D->setup_char( who );
					UPDATE_D->check_user(who,1);
					who->powerup();
					who->set_temp("login_data/time", time());
					who->set_temp("login_data/exp", 0);
					who->add("max_gin",800);
				}
				if( !who->query("shentong/90") )
				{
					if( stringp(name=who->query("family/master_name")) )
						tell_object(who,NOR+HBBLU+name+HBBLU"告诉你：好徒儿，好一个造化。速速回来，为师再送你一个造化。"NOR"\n");
					tell_object(who,HIG"看来可以前去找你的师傅询问关于「"HIY"神通"HIG"」一事了。"NOR"\n");		
				}
				who->save();
				return;
			}
			else
			{	
				who->set_temp("maze/last_king",king);
				tell_object(who,CYN+npc->name()+CYN"说道："+who->name()+CYN+RANK_D->query_respect(who)+"神通广大，小王甘拜下风。\n"NOR);
				message_vision(HIC"$N"HIC"翻了翻案上的文书，对$n"HIC"说道：“此事乃"HIR+king+HIC"传文至此，要小王勾拿"+RANK_D->query_respect(who)+"，"+RANK_D->query_respect(who)+"还是去找他理论吧。\n\n"NOR,npc,who);
			}
		}	
	}
		
}

void init()
{
	add_action("do_drop","drop");
	add_action("do_cmds","",1);
	if( wizardp(this_player()) )
	{
		remove_call_out("wang_check");
		call_out("wang_check",1,this_player());
	}	
}

int alternative_die(object who)
{
        object target;
        string file,msg,name;
        if( !who || !clonep(this_object()) 
         || !query("exits") )
                return 1;
        if( !userp(who) )
        {
		if( who->query("name")!=query("wang") )
			return 1;
		
		all_inventory()->remove_killer(who);
		who->remove_all_killer();
		who->powerup();
		
		if( objectp(target = who->query_temp("last_damage_from"))
		 && present(target,this_object()) )
		{
			all_inventory()->remove_killer(target);
			target->remove_all_killer();
			target->clear_condition();
			if( !userp(target) )
				return 0;
			if( target!=query("owner") || !stringp(name=query("wang")) )
				return 0;
			if( !target->query_temp("maze/"+name+"killed") )
				target->set_temp("maze/"+name+"killed",1);
			remove_call_out("wang_check");
			call_out("wang_check",1,target,1);
			return 0;					
		}		 
		else	return 0;
	}		
	//player        	
        who->powerup(0,1);
        tell_object(who,NOR"              "REV HIR" "NOR HBWHT HIM"大闹天宫"NOR REV HIR" "NOR HBCYN HIY"大闹阎罗地府，九幽十类除名 "NOR"\n");
        tell_object(who,HIR"本次大闹天宫失败了！\n"NOR);
        who->move("/d/changan/fendui",2);
	who->delete_temp("mark/dntg-hell");
	who->set("maze/dntg-hell",time());
        who->delete_temp("maze");
        if( who->query("combat_exp")>30000 )
        	who->add("combat_exp",-30000);
        if( who->query("daoxing")>3000 )	
        	who->add("daoxing",-3000);
        message_vision("\n坟上的土动了动，$N顶着满头的杂草钻了出来。\n",who); 
        tell_object(who,HIR"你失去了30000点武学经验以及3年道行。"NOR"\n");
        REMOVE_D->add_object(this_object(),5);
        return 0;
}

void reset()
{
	object who;
	if( clonep(this_object()) && query("init") )
	{
		if( !objectp(who=query("owner"))
		 || !living(who)
		 || !environment(who)
		 || !environment(who)->query("mazeobj")
		 || !query("mazeobj")
		 || environment(who)->query("mazeobj")!=query("mazeobj") )
		{
			REMOVE_D->add_object(this_object(),1);
			return;
		}
	}
	return ::reset();	
}

mixed have_npc(string file)
{
	object *inv;
	int i;
	if( !clonep(this_object()) )
		return 0;
	if( !arrayp(inv = all_inventory()) 
	 || !intp(i=sizeof(inv))
	 || i<1 )
	 	return 0;
	while(i--)
	{
		if( !inv[i] || userp(inv[i]) )
			continue;
		else if( !inv[i]->is_character() )
			continue;
		else if( base_name(inv[i])==file )
			return inv[i];		
	}
	return 0;		
}

int init_wang(object who)
{
	object npc;
	string name,file;
	if( !who || !living(who) || who!=query("owner") 
	 || !stringp(name=query("wang")) )
	{
		remove_call_out("reset");
		call_out("reset",3);
		return 0;
	}
	switch(name)
	{
		case "秦广王" : file = "qinguang";break;
		case "楚江王" : file = "chujiang";break;
		case "宋帝王" : file = "songdi";break;
		case "仵官王" : file = "chuguan";break;
		case "平等王" : file = "pingdeng";break;
		case "都市王" : file = "dushi";break;
		case "泰山王" : file = "taishan";break;
		case "轮转王" : file = "lunzhuan";break;
		case "卞城王" : file = "biancheng";break;
		case "阎罗王" : file = "yanluo";break;
		default : return 0;
	}
	file = "/d/maze/dntg-hell/npc/"+file;
	if( !objectp(npc=have_npc(file)) )
	{
		npc = new(file);
		npc->move(this_object());
	}
	npc->powerup();
	npc->set("my_killer",who);
	return 1;
}	
	
void remove_all_room()
{
	object *inv;
	int i;
	
	inv = children(__FILE__);
	for(i=0;i<sizeof(inv);i++)
	{
		if( clonep(inv[i]) )
			REMOVE_D->add_obj(inv[i],1);
	}
}		
