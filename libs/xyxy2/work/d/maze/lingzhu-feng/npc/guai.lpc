string short()
{
        string arg,str = ::short();
        if( !stringp(arg=query("my_type")) )
                return str;
	return str+"["+arg+NOR"]";
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void hurt_env(string type)
{
	string du,du_name;
	object *inv;
	int i,damage;
	if( !environment() )
		return;
	inv = all_inventory(environment());
	if( !inv || sizeof(inv)<1 )
		return;
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->is_maze() )
			continue;
		if( !inv[i]->is_character() )
			continue;
		switch(type)
		{
			case "combat" : 
				damage = this_object()->query_combat_damage();
				damage = inv[i]->receive_wound("kee",damage,this_object(),TYPE_PERFORM);
				if( damage>0 )
					message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"点物理伤害！\n"NOR,inv[i]);
				break;
			case "du" : 
				damage = 5+random(15);
				if( !this_object()->query("family/family_name") )
				{
					du = "snake_poison";
					du_name = "蛇毒";
				}
				else
				{
					switch(this_object()->query("family/family_name"))
					{
						case "百花谷" : du = "eyeill";du_name = "花毒";break;
						case "蜀山派" : du = "hedinghong_poison";du_name="鹤顶红剧毒";break;
						case "大雪山" : du = "ice_poison";du_name = "冰毒";break;
						case "东海龙宫":du = "root_poison";du_name = "蟥芦草毒";break;
						case "南海普陀山" : du = "dashouyin";du_name = "佛印内伤";break;
						case "陷空山无底洞" : du = "shuyi";du_name = "鼠疫之毒";break;
						case "月宫"   : du = "moon_poison";du_name = "蚀月之毒";break;
						case "火云洞" : du = "rose_poison";du_name = "火玫瑰毒";break;
						default : du = "snake_poison";du_name = "蛇毒";break;
					}
				}
				inv[i]->apply_condition(du,(int)inv[i]->query_condition(du)+damage);
				message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"秒"+HIB+du_name+HIR"伤害！\n"NOR,inv[i]);	
				break;
			case "hl" :
				damage = 3+random(5);
                                inv[i]->start_hunluan(damage,"你只觉眼前金光闪闪，一时不知干啥好。\n");
				message_vision(HIR"结果对$N"HIR"造成了"HIY+damage+HIR"秒混乱伤害！\n"NOR,inv[i]);	
				break;
		}			
	}	
}

void reward_ob(object who)
{
	string file,*dir,*env,color,str;
        object ob,weapon;
        int i;
        
        if( !who || !userp(who) || !present(who,environment()) )
        {
                message_vision (HIR"\n$N"HIR"「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n"NOR,this_object());
                destruct(this_object());
                return;
        }
        message_vision (HIC"\n$N"HIC"「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n"NOR,this_object());
	if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }        
        
        if( !arrayp(env=who->query_temp("maze/equip_color")) )
                env = 0;

	delete("env");
	set("kar",1);
	set_temp("apply/karma",who->query_kar()/2+random(who->query_kar()/2));
	set_temp("armor_level",this_object()->query_level()/3+random(this_object()->query_level()/2));
	set_temp("weapon_level",this_object()->query_level()/2+random(this_object()->query_level()/2));
	
	if( random(2) )
	{
		dir = ({
                	"hand","neck","ring","shield","waist","wrists",
                	"armor","cloth","kui","pifeng","shoes",
        	});
		file = dir[random(sizeof(dir))];
       		ob = new("/d/obj/narmor/"+file);
       	        ob->init_armor(this_object());
       	        if( !stringp(color=ob->query("armor_color"))
       	         || ( stringp(color=ob->query("armor_color")) 
		   && env && member_array(color,env)==-1 ) )
		{
                       	tell_object(who,HIY"【副本】清风寨：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
			destruct(ob);
		}
               	else if( !ob->move(who) )
               	{
               		destruct(ob);
                       	tell_object(who,HIR"【副本】清风寨：你的背包满了。\n"NOR);
		}
               	else    tell_object(who,HIY"【副本】清风寨：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
        }
        
        else
        {
        	dir = ({
                	"axe","blade","blade","hammer","mace","spear",
                	"staff","stick","sword","unarmed","whip","fork",
        	});
        	file = dir[random(sizeof(dir))];
	
               	ob = new("/d/obj/nweapon/"+file);
		ob->init_weapon(this_object());
               	if( stringp(color=ob->query("weapon_color"))
               	 && env && member_array(color,env)==-1 )
		{
               		tell_object(who,HIY"【副本】清风寨：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                       	destruct(ob);
               	}        
               	else if( !ob->move(who) )
               	{
                       	destruct(ob);
                       	tell_object(who,HIR"【副本】清风寨：你的背包满了。\n"NOR);
               	}
               	else    tell_object(who,HIY"【副本】清风寨：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
	}
	
	i = who->query_level()-this_object()->query_level();
	if( i>=10 )
		i = 1;
	else if( i<-10 )
		i = 100;
	else
	{
		if( i<0 )
			i = 0;
		i = (i+1)*600+random(1000);	
	}			
	
	who->add("combat_exp",i);
	tell_object(who,HIY"【副本】清风寨：你得到了 "HIR+i+HIY"点武学经验。\n"NOR);
	
	destruct(this_object());	
}

int accept_fight(object who)
{
        tell_object(who,CYN+name()+CYN"说道：思想有多远，你就滚多远。\n"NOR);
        return 0;
}

int information(object who)
{
	int i,k;
	object ob;
	mapping skill;
	string *skills,*str;
	if( !who || query("createdd") )
		return 0;
	if( !mapp(skill = query_skills())
	 || sizeof(skill)<1 )
	 	return 0;
	if( !pointerp(skills=keys(skill))
	 || sizeof(skills)<1 )
	 	return 0;
		
	set("createdd",1);
	i = who->query_level();
	if( i<this_object()->query_level() )
		i = this_object()->query_level();
	else	i = i/10*10;
	if( i>60 )
		i = 59;
	set_level(i);	 
	for(k=0;k<sizeof(skills);k++)
		set_skill(skills[k],i*10);
	
	setup();
	if( query("family/family_name")=="蜀山派" )
		carry_object("/obj/paper_seal")->set_amount(1000);
	carry_object("/obj/money/silver")->set_amount(10+random(40));	
        str = ({
		"armor","cloth","hand","kui","neck","pifeng","ring","shield","shoes",
		"waist","wrists",
	});
	for(k=0;k<sizeof(str);k++)
	{
		if( objectp(ob=carry_object(0,str[k],1)) )
			ob->set("armor_title","清风寨");
	}
	if( !weapon )
		weapon = "unarmed";
	if( objectp(ob=carry_object(0,weapon,1)) )
		ob->set("weapon_title","清风寨");
	powerup(0,1);
	command("wield all");
	command("wear all");
        return 1;
}

void hurting(object who)
{
	object ob,weapon;
	remove_call_out("hurting");
	if( !who || !present(who,environment()) 
	 || !this_object()->is_fighting(who) 
	 || !living(this_object()) )
	 	return;
	exert_function("recover");
	exert_function("refresh");
	if( this_object()->is_busy() 
	 || this_object()->is_hunluan() 
	 || this_object()->is_blind() )
	{
		call_out("hurting",2,who);
		return;
	}
	if( random(2) )
	{
		QUEST_D->randomPfm(this_object());
		if( random(2) )
			QUEST_D->randomPfm(this_object());
	}
	else	QUEST_D->randomCast(this_object());		
	call_out("hurting",2+random(3),who);
}

void kill_ob(object who)
{
        if( !this_object()->is_fihgting() )
        {
                powerup(0,1);
        	start_busy(0);
        	reset_action();
        }
        if( !query("createdd")
         && !information(who) )
	{
		remove_killer(who);
		who->remove_killer(this_object());
		tell_object(who,CYN+name()+"冷眼看世界。\n"NOR);
		return;
	}	         
        this_object()->set_follow(who);
        ::kill_ob(who);
        remove_call_out("hurting");
        call_out("hurting",0,who);
}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
	string str,id;
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);

	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	
	return ::receive_damage(type,damage,who,attack_type);			
}			

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	string str,id;

	if( !who || who==this_object() || !objectp(who) || damage<10 )
		return ::receive_wound(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_wound(type,damage,who,attack_type);	
	
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
		
	return ::receive_wound(type,damage,who,attack_type);
}		

string long()
{
	string str,long = ::long();
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
	 	return long;
		 	
	str = COLOR_D->clean_color(str);	
	switch(str)	
	{
		case "厚土" : long+= HIC"匪徒特效：物理免疫。\n"NOR;break;
		case "驭法" : long+= HIC"匪徒特效：法术免疫。\n"NOR;break;
		case "轻灵" : long+= HIC"匪徒特效：busy状态下伤害降低。\n"NOR;break;
		case "彪悍" : long+= HIC"匪徒特效：物理伤害提高100%。\n"NOR;break;
		case "通灵" : long+= HIC"匪徒特效：法术伤害提高100%。\n"NOR;break;
		case "吸血" : long+= HIC"匪徒特效：击中回复自己1%的气血值。\n"NOR;break;
		case "偷心" : long+= HIC"匪徒特效：击中回复自己2%的法力值。\n"NOR;break;
		case "反戈" : long+= HIC"匪徒特效：受到伤害的10%反弹给攻击者。\n"NOR;break;
		case "登峰" : long+= HIC"匪徒特效：物理命中提高100%。\n"NOR;break;
		case "震古" : long+= HIC"匪徒特效：法术命中提高100%。\n"NOR;break;
		case "死锋" : long+= HIC"匪徒特效：死亡时释放物理伤害。\n"NOR;break;
		case "死毒" : long+= HIC"匪徒特效：死亡时释放毒伤害。\n"NOR;break;
		case "死幻" : long+= HIC"匪徒特效：死亡时释放混乱伤害。\n"NOR;break;
	}
	return long;	
}

mixed hit_ob(object me, object who,int damage,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return 0;
	if( !living(me) || !who || !me->is_fighting(who) || damage<=0 )
		return 0;
	str = COLOR_D->clean_color(str);	
	switch(str)
	{
		case "彪悍" : //物理伤害提高100%
			if( attack_type==TYPE_COMBAT || attack_type==TYPE_PERFORM || attack_type==TYPE_QUICK )
				return damage;
			break;	
		case "通灵" : //法术伤害提高100%
			if( attack_type==TYPE_CAST || attack_type==TYPE_CAST_2 )
				return damage;
			break;	
		case "吸血" : //击中回复自己1%的气血值
			me->receive_heal("kee",me->query_maxkee()/100+1);
			me->receive_curing("kee",me->query_maxkee()/100+1);
			return RED"$N"RED"开始疯狂的吸血！\n"NOR;
		case "偷心" : //击中回复自己2%的法力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/50+1);
				return HIC"$N"HIC"只觉得自己的法力越来越充沛了。\n"NOR;
			}
			break;
	}
	return 0;		
}

int is_maze(){return 1;}

void init()
{
	::init();
	if( !this_object()->is_fighting()
	 && !this_object()->query("createdd")
	 && userp(this_player()) )
		kill_ob(this_player());
}
