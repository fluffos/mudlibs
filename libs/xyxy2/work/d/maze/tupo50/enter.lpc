#include <ansi.h>
inherit "/d/maze/tupo50/room.lpc";

nosave string color = ({
  HIC,
  HIW,
  HIB,
  HIM,
  HIR,
  HIG,
  HIY,
  CYN,
  WHT,
  MAG,
  BLU,
  RED,
  GRN,
  YEL
})[random(14)];

void create() {
  set("short", "50级突破副本");
  set("channel_id", "50级突破副本");
  set("alternative_die", 1);
  set("virtual_room", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("exits", ([
    "north": __DIR__ "maze/entry",
  ]));
  setup();
}

int valid_leave(object who, string arg) {
  mapping name;
  string str, key, *msg, color;
  int i, k;
  if (query("pushed")) {
    who->delete_temp("maze/leave_key");
    return ::valid_leave(who, arg);
  }
  if (!stringp(key = who->query_temp("maze/leave_key"))
    || strlen(key) < 2) {
    key = ({ "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸",
      "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥",
    })[random(22)];
    who->set_temp("maze/leave_key", key);
  }
  color = ({ HIC, HIR, HIM, HIY, HIG, HIW, HIB, CYN, RED, MAG, YEL, GRN, WHT, BLU, })[random(14)];
  str = CODE_D->Display(key, 18, "x", "y", REV + color, BLK);
  key = HIC "\n一片光幕挡住了你的去路，其上霞光四射，星点闪烁，上面密布天干地支，并有一个巨大的符文流光溢彩：\n" NOR + str + "\n" NOR + HIR "你想要闯过光幕的阻障，还需化去(hua)此符文才行。\n\n" NOR;
  return notify_fail(key);
}

void init() {
  add_action("do_hua", "hua");
  ::init();
}

void init_status(object me) {
  int i, k;
  string str, key, *msg, color;
  remove_call_out("init_status");
  if (!me || !present(me, this_object())
    || !living(me)
    || query("pushed"))
    return;
  key = me->query_temp("maze/leave_key");
  message_vision(HIC "\n光幕一阵波动，其中「" + key + "」亮了几亮又熄去，天干地支星点随着光幕荡漾，又四处游走，片刻之后方才停止。\n\n" NOR, me);
  me->delete_temp("maze/leave_key");
  key = ({ "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸",
    "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥",
  })[random(22)];
  me->set_temp("maze/leave_key", key);
  color = ({ HIC, HIR, HIM, HIY, HIG, HIW, HIB, CYN, RED, MAG, YEL, GRN, WHT, BLU, })[random(14)];
  str = CODE_D->Display(key, 18, "x", "y", REV + color, BLK);
  message_vision(HIY "\n$N" HIY "定睛观看，方发现光幕上的符文已变为：\n" NOR + str + NOR "\n\n", me);
  me->start_busy(1);
}

void pushed(object me) {
  remove_call_out("pushed");
  if (!me || !present(me, this_object())
    || !living(me)
    || query("pushed"))
    return;
  me->delete_temp("maze/leave_key");
  message_vision(HIC "\n光幕骤然一亮，顿时化作无数光点消逝在虚空之中。\n\n" NOR, me);
  set("pushed", 1);
  tell_object(me, HIG "你可以继续前进了。\n" NOR);
  me->start_busy(1);
}

int do_hua(string arg) {
  string *msg, key;
  object me = this_player();

  if (query("pushed"))
    return err_msg("没有这个必要了。\n");
  if (!stringp(key = me->query_temp("maze/leave_key")))
    return 0;
  if (!arg)
    return err_msg("你要化去哪个天干地支？\n");
  msg = ({ "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸",
    "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥",
  });
  if (member_array(arg, msg) == -1)
    return err_msg("你要化去哪个天干地支？\n");
  if (me->is_busy())
    return err_msg("你现在正忙着呢。\n");
  if (me->query("mana") < 100)
    return err_msg("你的法力不足。\n");
  message_vision(HIC "$N" HIC "手掐法咒，对着符文一点，口道：「" + arg + "解」。\n" NOR, me);
  me->add("mana", -100);
  me->start_busy(1);
  if (random(me->query_maxmana() / 10) < 10 || random(me->query("mana_factor") / 10) < 10)
    return err_msg("结果光幕一阵波动，「" + arg + "」字亮了几亮，又黯淡了下来。\n");
  if (arg != key) {
    message_vision(HIG "光幕一阵波动，「" + arg + "」字亮了几亮，又黯淡了下来。$N" HIG "感到束手无策。\n" NOR, me);
    me->start_busy(3);
    remove_call_out("init_status");
    call_out("init_status", 3, me);
    return 1;
  }
  message_vision(HIG "光幕一阵波动，「" + arg + "」字闪烁不已，越来越亮。\n" NOR, me);
  me->start_busy(3);
  remove_call_out("pushed");
  call_out("pushed", 3, me);
  return 1;
}
