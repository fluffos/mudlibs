#include <ansi.h>
inherit ITEM;

mapping Ke = ([
  "金": "木",
  "木": "土",
  "土": "水",
  "水": "火",
  "火": "金",
]);

mapping Sheng = ([
  "金": "水",
  "水": "木",
  "木": "火",
  "火": "土",
  "土": "金",
]);

object query_xk(object who, string type) {
  int i;
  object *inv, obj;
  if (!who)
    return 0;
  inv = all_inventory(who);
  if (!inv || !pointerp(inv) || sizeof(inv) < 1)
    return 0;
  for (i = 0; i < sizeof(inv); i++) {
    obj = inv[i];
    if (!obj->query("type")
      || member_array(obj->query("type"), keys(Ke)) == -1
      || !obj->query("created")
      || obj == this_object())
      continue;
    if (obj->query("type") == Ke[type]
      && obj->is_lingqi())
      return obj;
  }
  return 0;
}

object query_xs(object who, string type) {
  int i;
  object *inv, obj;
  if (!who)
    return 0;
  inv = all_inventory(who);
  if (!inv || !pointerp(inv) || sizeof(inv) < 1)
    return 0;
  for (i = 0; i < sizeof(inv); i++) {
    obj = inv[i];
    if (!obj->query("type")
      || member_array(obj->query("type"), keys(Ke)) == -1
      || !obj->query("created")
      || obj == this_object())
      continue;
    if (obj->query("type") == type
      && obj->is_lingqi())
      return obj;
  }
  return 0;
}

void init_wuxing(object who) {
  int my, his;
  object old;
  string name;

  if (!who)
    return;
  if (!query("type") || member_array(query("type"), keys(Ke)) == -1)
    return;
  set("created", 1);
  if (objectp(old = query_xk(who, query("type")))) {
    tell_object(who, HIW + name() + HIW "发出一道白光，将" + old->name() + HIW "吞噬了！\n" NOR);
    add("level", old->query("level"));
    destruct(old);
  } else if (objectp(old = query_xs(who, query("type")))) {
    name = name();
    set("type", Sheng[query("type")]);
    tell_object(
      who,
      HIW + name + HIW "发出一道白光，和" + old->name() + HIW "渐渐融合成了" + name() + HIW "！\n" NOR
    );
    add("level", old->query("level"));
    destruct(old);
  }
}

void destruct_me() {
  remove_call_out("destruct_me");
  destruct(this_object());
}

void create() {
  set_name("灵气", ({ "ling qi", "qi" }));
  set_weight(1);
  set("base_unit", "丝");
  set("unit", "团");
  set("long", "朦朦胧胧的光团雾气。\n");
  set("type", ({ "金", "木", "水", "火", "土", })[random(5)]);
  set("no_sell", 1);
  set("no_store", 1);
  set("no_put", 1);
  set("level", 1);
  setup();
}

void init() {
  if (userp(environment())) {
    if (query("created"))
      return;
    if (!query("owner_id"))
      set("owner_id", environment()->query("id"));
    else if (query("owner_id") != environment()->query("id")) {
      message("vision", "\n" + name() + "越来越淡，渐渐消失在空气中。\n", environment());
      destruct_me();
      return;
    }
    init_wuxing(environment());
  }
}

string name() {
  string str;
  if (!stringp(str = query("type"))
    || member_array(str, keys(Ke)) == -1)
    return ::name();
  return str + "灵气";
}

string short() {
  int i;
  string str = ::short();
  if (!intp(i = query("level")) || i < 1)
    return str;
  return chinese_number(i) + "级" + str;
}

int is_lingqi() { return 1; }
