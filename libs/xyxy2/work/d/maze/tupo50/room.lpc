#include <ansi.h>
#include <room.h>
inherit ROOM;

nosave string short = "神识海";
nosave string long;

void create() {
  set("short", "50级突破副本");
  set("channel_id", "50级突破副本");
  set("alternative_die", 1);
  set("item_desc", ([
    "west": "四面一片虚空。\n",
    "east": "四面一片虚空。\n",
    "north": "四面一片虚空。\n",
    "south": "四面一片虚空。\n",
  ]));
  setup();
}

int alternative_die(object who) {
  object target;
  string file, msg;
  if (!who)
    return 1;
  if (!userp(who)) {
    target = who->query_temp("last_damage_from");
    who->clear_condition();
    if (target && present(target, this_object())
      && target == who->query_temp("my_kill"))
      who->reward_ob(target);
    else message_vision(HIY "$N" HIY "「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, who);
    if (who) destruct(who);
    return 0;
  }
  //玩家死亡
  if (!wizardp(who)) {
    if (who->query_level() != 49 || who->query("combat_exp") < 36000000
      || who->query("daoxing") < 240000)
      return 1;
  }

  who->powerup(0, 1);
  tell_object(who, HIC "\n你从冥思中清醒了过来。\n" NOR);
  file = who->query_temp("mark/tupo50");
  if (file_size(file + ".lpc") > 0)
    who->move(file, 2);
  else {
    tell_object(who, "\n一阵时空的扭曲将你传送到另一个地方．．．\n");
    who->move("/obj/void");
  }
  who->set("maze/tupo-50", time());
  who->delete_temp("maze");
  who->delete_temp("mark/tupo50");
  tell_object(who, HIR "你在冥思中心神遭到莫名魔物的侵蚀，你的境界跌落了！\n" NOR);
  who->add("combat_exp", -50000);
  who->add("daoxing", -10000);
  who->save(1);
  return 0;
}

int do_drop(string arg) {
  return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg) {
  string *nocmds, verb = query_verb();
  nocmds = ({
    "recall", "move", "maphere", "map", "fight", "find",
  });
  if (member_array(verb, nocmds) == -1)
    return 0;
  write("ok\n");
  return 1;
}

void init_statue(object who) {
  string wx, str, yy, color;
  int lvl;
  if (!who)
    return;
  set("created", 1);
  if (!stringp(str = who->query("shentong/40"))
    || sscanf(str, "%s_%s_%d", wx, yy, lvl) != 3) {
    long = @LONG
    这里是你的神识海之中，四处一片虚空，你的神识在此御风飞行。
    虚空中有方圆数米左右的一片空间，发着青蒙蒙的光华。正中心是一粒发着霞光的核晶，正是你筑基后形成的精华。			
LONG;
    set("short", short);
    set("long", long);
    return;
  }
  str = "";
  switch (wx) {
    case "金": str = HIW "白"; color = "白茫茫"; break;
    case "木": str = HIG "青"; color = "青蒙蒙"; break;
    case "水": str = BLK + HIW "玄"; color = "黑黝黝"; break;
    case "火": str = HIR "赤"; color = "红彤彤"; break;
    case "土": str = HIY "黄"; color = "黄灿灿"; break;
    default:
      long = @LONG
    这里是你的神识海之中，四处一片虚空，你的神识在此御风飞行。
    虚空中有方圆数米左右的一片空间，发着青蒙蒙的光华。正中心是一粒发着霞光的核晶，正是你筑基后形成的精华。			
LONG;
      set("short", short);
      set("long", long);
      return;
  }
  switch (yy) {
    case "阳": str = ({ "炫目", "耀眼", "夺目", "亮彻虚空", })[random(4)] + "的" + str + "光" NOR; break;
    default: str = ({ "温和", "平和", "暖人", "温软", })[random(4)] + "的" + str + "光" NOR; break;
  }
  switch (lvl) {
    case 1: str += "，约有拇指"; break;
    case 2: str += "，约有半掌"; break;
    case 3: str += "，约有鸡蛋"; break;
    case 4: str += "，约有拳头"; break;
    case 5: str += "，约有海碗"; break;
    case 6: str += "，约有沙钵"; break;
    default: str += "，约有面盆"; break;
  }
  long = "    这里是你的神识海之中，四处一片虚空，你的神识在此御风飞行。\n";
  long += "    虚空中有方圆数米左右的一片空间，发着" + color + "的光华。正中心是一颗核晶，散发着" + str + "大小，正是你筑基时形成的精华。\n\n";
  set("short", short);
  set("long", long);
}

void init() {
  if (userp(this_player())) {
    add_action("do_cmds", "", 1);
    add_action("do_drop", "drop");
    if (!query("created"))
      init_statue(this_player());
  }
}

int is_shenshi() { return 1; }

int valid_leave(object who, string dir) {
  object guai;
  if (query("maze/y") == 0 && query("maze/x") == 3
    && !who->query_temp("maze/50tupo_dan_get")) {
    if (objectp(guai = query_temp("guai"))
      && present(guai, this_object()))
      return notify_fail(guai->no_leve_msg());
    guai = new("/d/maze/tupo50/npc/guai");
    guai->move(this_object());
    if (guai->information(who)) {
      set_temp("guai", guai);
      guai->create_job(who);
      return 2;
    } else {
      if (guai) destruct(guai);
      return ::valid_leave(who, dir);
    }
  }

  if (query("maze/y") == 5 && !who->query_temp("maze/50tupo_item_gived")) {
    if (dir != "north")
      return ::valid_leave(who, dir);
    if (objectp(guai = query_temp("guai"))
      && present(guai, this_object()))
      return notify_fail(guai->no_leve_msg());
    guai = new("/d/maze/tupo50/npc/guai2");
    guai->move(this_object());
    if (guai->information(who)) {
      set_temp("guai", guai);
      guai->create_job(who);
      return 2;
    } else {
      if (guai) destruct(guai);
      return ::valid_leave(who, dir);
    }
  }
  return ::valid_leave(who, dir);
}
