#include <ansi.h>
inherit NPC;

void create() {
  object ob;
  set_name("青狮老魔", ({ "qingshi laomo", "qingshi", "laomo" }));
  set_level(120);
  set("title", "明王护法");
  set("gender", "男性");
  set("age", 63);
  set(
    "long",
    "这位青狮老魔原来在狮驼山逍遥，跟大鹏明王颇有交情。\n后来狮驼山被方寸山三星洞的一位得道高人剿灭，\n老魔就投奔大鹏明王做了护法尊者。一个跟和尚有仇，\n一个跟道士有仇，也算是知交好友。\n"
  );
  set("class", "yaomo");
  set("attitude", "peaceful");
  create_family2("大雪山", "狮族", 2, "明王护法");
  set_skill("unarmed", 1200);
  set_skill("cuixin-zhang", 1200);
  set_skill("dodge", 1200);
  set_skill("xiaoyaoyou", 1200);
  set_skill("parry", 1200);
  set_skill("blade", 1200);
  set_skill("bingpo-blade", 1200);
  set_skill("force", 1200);
  set_skill("ningxie-force", 1200);
  set_skill("literate", 1200);
  set_skill("spells", 1200);
  set_skill("throwing", 1200);
  set_skill("dengxian-dafa", 1200);

  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("parry", "cuixin-zhang");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");

  set_skill("jiuxi-fuqi", 1200);
  set_skill("qushen", 1200);
  set("force_factor", 160);
  set("mana_factor", 125);

  set("env/test", "HIB");
  set_temp("weapon_level", 60 + random(50));
  set_temp("armor_level", 60 + random(50));

  set("inquiry", ([
    "任务": "我狮驼山与那猴子怨仇不同戴天，此秘境之内，凡遇到方寸弟子，尽与我杀之！可在我处兑换些(huan)珍奇异品(list)。\n",
  ]));
  set("env/test", "HIR");
  setup();

  ob = carry_object(0, "armor", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "cloth", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "shoes", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "pifeng", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  ob = carry_object(0, "kui", 1);
  ("/d/maze/zizhulin2/npc/equip.lpc")->change_equip(ob);
  ob->delete("armor_title");
  ob->wear();

  carry_object(0, "blade", 1)->wield();
  powerup(0, 1);
}

void die() {
  if (environment())
    message_vision(
      HIY "\n$N" HIY "大吼一声：明王救我！\n虚空之中伸出一只巨大的金纹鹏爪，一把抓起$N" HIY "，顿时扶摇九天之外！\n\n" NOR,
      this_object()
    );
  destruct(this_object());
}

void unconcious() {
  die();
}

void init() {
  add_action("do_list", "list");
  add_action("do_huan", "huan");
}

nosave mapping Huan = ([
  "【冰风雪雨】研习残卷(上)": ({ 10, "/d/maze/xs-xuehai/obj/book_bingxue", }),
  "【冰风雪雨】研习残卷(下)": ({ 20, "/d/maze/xs-xuehai/obj/book_bingxue2", }),
  "【雪风刀波】研习残卷(上)": ({ 20, "/d/maze/xs-xuehai/obj/book_daobo2", }),
  "【雪风刀波】研习残卷(下)": ({ 20, "/d/maze/xs-xuehai/obj/book_daobo", }),
  "【冰谷凝血】研习残卷(上)": ({ 10, "/d/maze/xs-xuehai/obj/book_ningxie2", }),
  "【冰谷凝血】研习残卷(下)": ({ 20, "/d/maze/xs-xuehai/obj/book_ningxie", }),
  "【千蛇出洞】研习残卷(上)": ({ 10, "/d/maze/xs-xuehai/obj/book_qianshe", }),
  "【千蛇出洞】研习残卷(下)": ({ 20, "/d/maze/xs-xuehai/obj/book_qianshe2", }),
  "【百鸟朝凤】研习残卷": ({ 8, "/d/maze/xs-xuehai/obj/book_chaofeng", }),
  "【飞鸟投林】研习残卷(上)": ({ 10, "/d/maze/xs-xuehai/obj/book_feijian2", }),
  "【飞鸟投林】研习残卷(下)": ({ 20, "/d/maze/xs-xuehai/obj/book_feijian", }),
  "【凤舞九天】研习残卷": ({ 20, "/d/maze/xs-xuehai/obj/book_fengwu", }),
  "【凤凰七绝】研习残卷(上)": ({ 10, "/d/maze/xs-xuehai/obj/book_qijue2", }),
  "【凤凰七绝】研习残卷(中)": ({ 15, "/d/maze/xs-xuehai/obj/book_qijue", }),
  "【凤凰七绝】研习残卷(下)": ({ 15, "/d/maze/xs-xuehai/obj/book_qijue3", }),
]);

int do_list() {
  object me = this_player();
  string str = HIM "◇" HIC "秘笈兑换" NOR "\n";
  str += HBBLU "         秘笈          消耗杀生点    称号装备效果                                         " NOR "\n\n";
  str += HIC " 【冰风雪雨】研习残卷(上)      " HIR "10" NOR CYN "     「冰风雪雨」最后一击必出。" NOR "\n\n";
  str += HIC " 【冰风雪雨】研习残卷(下)      " HIR "20" NOR CYN "     「冰风雪雨」最后一击必中。" NOR "\n\n";
  str += HIC " 【雪风刀波】研习残卷(上)      " HIR "10" NOR CYN "     「雪风刀波」最后一击为气血型法术伤害。" NOR "\n\n";
  str += HIC " 【雪风刀波】研习残卷(下)      " HIR "20" NOR CYN "     「雪风刀波」固定伤害增加。" NOR "\n\n";
  str += HIC " 【冰谷凝血】研习残卷(上)      " HIR "10" NOR CYN "     「冰谷凝血」状态时间加倍。" NOR "\n\n";
  str += HIC " 【冰谷凝血】研习残卷(下)      " HIR "20" NOR CYN "     「冰谷凝血」状态支持其他武器。" NOR "\n\n";
  str += HIC " 【千蛇出洞】研习残卷(上)      " HIR "10" NOR CYN "     「千蛇出洞」每击固定伤害增加50点。" NOR "\n\n";
  str += HIC " 【千蛇出洞】研习残卷(下)      " HIR "20" NOR CYN "     「千蛇出洞」能与「冰谷凝血」状态并存。" NOR "\n\n";
  str += HBBLU "	                                                                               " NOR "\n\n";
  str += HIC " 【百鸟朝凤】研习残卷          " HIR " 8" NOR CYN "     「百鸟朝凤」冷却时间降低。" NOR "\n\n";
  str += HIC " 【飞鸟投林】研习残卷(上)      " HIR "10" NOR CYN "     「飞鸟投林」固定伤害增加50点。" NOR "\n\n";
  str += HIC " 【飞鸟投林】研习残卷(下)      " HIR "20" NOR CYN "     「飞鸟投林」投掷效果必中。" NOR "\n\n";
  str += HIC " 【凤舞九天】研习残卷          " HIR "20" NOR CYN "     「凤舞九天」收招后自身僵直减少。" NOR "\n\n";
  str += HIC " 【凤凰七绝】研习残卷(上)      " HIR "10" NOR CYN "     「凤凰七绝」内力消耗减半。" NOR "\n\n";
  str += HIC " 【凤凰七绝】研习残卷(中)      " HIR "15" NOR CYN "     「凤凰七绝」收招后自身僵直减少。" NOR "\n\n";
  str += HIC " 【凤凰七绝】研习残卷(下)      " HIR "15" NOR CYN "     「凤凰七绝」必出隐藏效果。" NOR "\n\n";
  str += HBBLU "	                                                                               " NOR "\n";
  str += sprintf("你目前有杀生点 " HIY "%d" NOR " 点。\n" NOR, me->query("family/xuehai_killed_fc"));
  write(str);
  return 1;
}

int do_huan(string arg) {
  int need;
  string file;
  mixed target;
  object ob, me = this_player();
  if (!arg || undefinedp(Huan[arg])) {
    do_list();
    return notify_fail("你要兑换哪个秘笈？命令格式：huan <秘笈的中文名称>\n");
  }
  target = Huan[arg];
  need = target[0];
  file = target[1];
  if (me->query("family/xuehai_killed_fc") < need)
    return notify_fail("你目前的杀生点不足" + need + "，还是多多灭杀秘境中的方寸弟子吧。\n");
  ob = new(file);
  ob->set("owner_id", me->query("id"));
  if (!ob->move(me))
    write(HIR "【系统】你的背包满了。\n" NOR);
  else {
    me->add("family/xuehai_killed_fc", -need);
    write(HIY "你消耗了 " + need + " 杀生点 换取了 " + ob->query("name") + "。(look book)\n" NOR);
  }
  return 1;
}

int information(object who) {
  if (!who || !environment(who)
    || !environment(who)->is_xsxh())
    return 0;
  this_object()->move(environment(who));
  message_vision("$N走了过来。\n", this_object());
  who->set_temp("maze/quest_npc", this_object());
  return 1;
}
