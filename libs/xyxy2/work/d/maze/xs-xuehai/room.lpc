#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "雪海孤旅副本");
  set("channel_id", "雪海孤旅副本");
  set("alternative_die", 1);
  set("item_desc", ([
    "west": "北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间似已毫无生迹，除了雪还是雪。\n",
    "east": "北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间似已毫无生迹，除了雪还是雪。\n",
    "north": "北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间似已毫无生迹，除了雪还是雪。\n",
    "south": "北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间似已毫无生迹，除了雪还是雪。\n",
  ]));
  set("guai", 3 + random(3));
  set("no_huicheng", 1);
  set("no_chuqiao", 1);
  set("virtual_room", 1);
  setup();
}

int alternative_die(object who) {
  int i, lost;
  object target;
  string id, file, msg;
  if (!who)
    return 1;
  if (!userp(who)) {
    target = who->query_temp("last_damage_from");
    who->powerup(0, 1);
    all_inventory()->remove_killer(who);
    who->remove_all_killer();

    if (who->is_xsxh() && target && present(target, this_object())
      && target->query("family/family_name") == "大雪山")
      who->reward_ob(target);
    else {
      message_vision(HIW "一阵寒风夹着冰碴子呼呼刮来，卷起$N" HIW "，直飞九霄之外....\n" NOR, who);
      who->move("/obj/empty");
      REMOVE_D->add_obj(who, 1);
    }
    return 0;
  }
  if (who->query("family/family_name") != "大雪山")
    return 1;

  //玩家死亡
  target = who->query_temp("last_damage_from");


  who->powerup(0, 1);
  if (random(2))
    msg = COMBAT_D->status_msg((1 + random(5)) * 10);
  else msg = COMBAT_D->eff_status_msg((1 + random(5)) * 10);
  message_vision(NOR "\n( $N" + msg + NOR ")\n", who);
  message_vision("\n" HIW "$N" HIW "跌跌撞撞的向外逃去。\n" NOR, who);

  lost = 5000;
  lost = lost * 9 / 10 + random(lost / 10);
  if (who->query("combat_exp") < lost)
    who->set("combat_exp", 0);
  else who->add("combat_exp", -lost);
  tell_object(who, HIR "【副本】雪海孤旅：你身负重伤，损失了" HIY + lost + "" HIR "点武学经验。" NOR "\n");

  lost = 1000;
  lost = lost * 9 / 10 + random(lost / 10);
  if (who->query("daoxing") < lost)
    who->set("daoxing", 0);
  else who->add("daoxing", -lost);
  tell_object(
    who,
    HIR "【副本】雪海孤旅：你身负重伤，损失了" HIY + COMBAT_D->chinese_daoxing(lost) + "" HIR "道行。" NOR "\n"
  );

  lost = 1000;
  lost = lost * 9 / 10 + random(lost / 10);
  if (who->query("potential") - who->query("learned_points") < lost)
    who->set("potential", who->query("learned_points"));
  else who->add("potential", -lost);
  tell_object(who, HIR "【副本】雪海孤旅：你身负重伤，损失了" HIY + lost + "" HIR "点修为潜能。" NOR "\n");

  who->set("kee", 100);
  who->set("eff_kee", 100);
  who->set("sen", 100);
  who->set("eff_sen", 100);
  who->set("force", 0);
  who->set("mana", 0);

  id = who->query("id");
  file = sprintf("/data/maze/%c/%s/xs-xuehai/enter", id[0], id);
  if (!who->move(file, 2)) {
    file = sprintf("/d/xueshan/xueshan%d", 1 + random(6));
    who->move(file, 2);
  }
  message_vision("\n" HIW "$N" HIW "跌跌撞撞的从雪海孤旅中逃了出来。\n\n" NOR, who);
  who->delete_temp("maze");
  return 0;
}

void create_guai(object who) {
  int i;
  object guai, npc;
  if (!who || !living(who)
    || !present(who, this_object()))
    return;

  if (who->query("family/xuehai_killed_fc") > 5
    && who->query("family/xuehai_killed_wdd") > 5
    && who->query_temp("maze/guai_killed") > 5) {
    if ((!objectp(npc = who->query_temp("maze/quest_npc"))
      || !environment(npc) || !environment(npc)->is_xsxh())
      && !present("baixiang zunzhe", this_object())) {
      npc = new("/d/maze/xs-xuehai/npc/quest_kill");
      if (!npc->information(who))
        destruct(npc);
      else EMOTE_D->do_emote(npc, "pat", geteuid(who), CYN, 0, 0, 0);
    }
    if ((!objectp(npc = who->query_temp("maze/quest_npc2"))
      || !environment(npc) || !environment(npc)->is_xsxh())
      && !present("qingshi laomo", this_object())) {
      npc = new("/d/maze/xs-xuehai/npc/quest_kill2");
      if (!npc->information(who))
        destruct(npc);
      else EMOTE_D->do_emote(npc, "pat", geteuid(who), CYN, 0, 0, 0);
    }
  }

  i = 1 + random(2);
  while (i--) {
    switch (random(4)) {
      case 0:
      case 1:
        if (query("guai") <= 0)
          return;
        if (objectp(guai = who->query_temp("maze/other_dizi"))
          && environment(guai) && environment(guai)->is_xsxh())
          return;
        guai = new("/d/maze/xs-xuehai/npc/guai_other");
        break;
      case 2:
        if (query("guai") <= 0)
          return;
        if (objectp(guai = who->query_temp("maze/wdd_dizi"))
          && environment(guai) && environment(guai)->is_xsxh())
          return;
        guai = new("/d/maze/xs-xuehai/npc/guai_wdd");
        break;
      default:
        if (query("guai") <= 0)
          return;
        if (objectp(guai = who->query_temp("maze/fc_dizi"))
          && environment(guai) && environment(guai)->is_xsxh())
          return;
        guai = new("/d/maze/xs-xuehai/npc/guai_fc");
        break;
    }
    if (!guai)
      return;
    //printf("111\n");	
    if (!guai->information(who)) {
      guai->move("/obj/empty");
      REMOVE_D->add_obj(guai, 1);
      return;
    }
    //printf("222\n");
    add("guai", -1);
  }
}

void init() {
  if (userp(this_player())) {
    add_action("do_map", "map");
    remove_call_out("create_guai");
    call_out("create_guai", 1 + random(2), this_player());
  }
}

int do_map(string arg) {
  object me = this_player();
  if (time() < me->query_temp("last_mazemap") + 10)
    return err_msg("你不能频繁查看地图。\n");
  me->set_temp("last_mazemap", time());
  arg = MAZE_D->query_maze_mainobj(me)->display_common_map(this_object());
  me->start_more(arg);
  return 1;
}

int valid_leave(object who, string dir) {
  object guai;
  if (!userp(who))
    return ::valid_leave(who, dir);
  if (who->is_fighting())
    return notify_fail("你现在正忙着呢。\n");
  return ::valid_leave(who, dir);
}

int is_xsxh() { return 1; }
