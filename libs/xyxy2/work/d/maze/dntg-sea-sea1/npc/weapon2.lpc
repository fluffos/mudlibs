#include <ansi.h>
#include <combat.h>
inherit NPC;

string *guard_msg = ({
  CYN "\n$N" CYN "注视着$n" CYN "的行动，企图寻找机会出手。\n\n" NOR,
  CYN "\n$N" CYN "正盯着$n" CYN "的一举一动，随时准备发动攻势。\n\n" NOR,
  CYN "\n$N" CYN "缓缓地移动脚步，想要找出$n" CYN "的破绽。\n\n" NOR,
  CYN "\n$N" CYN "目不转睛地盯着$n" CYN "的动作，寻找进攻的最佳时机。\n\n" NOR,
  CYN "\n$N" CYN "慢慢地移动着脚步，伺机出手。\n\n" NOR,
});

string pos_msg() {
  object me = this_player();
  if (!me || !userp(me))
    return HIG "浑身上下水纹波动" NOR "。\n";
  if (me->query_temp("pending/dntg_get_weapon2"))
    return HIG "浑身上下水纹波动" NOR "。\n";
  return "扛着一把三千六百斤重的九股托天叉，脸色有点发白。\n";
}

void create() {
  int i = 79;
  set_name("鲌太尉", ({ "bo taiwei", "bo", "taiwei" }));
  set_level(i);
  set("long", "东海龙宫鲌太尉。\n");
  set("gender", "男性");
  set("age", 40);
  set("per", 15);
  create_family("东海龙宫", 3, "");
  set("looking", HIR "奇形怪状，浑不似人形" NOR "。");
  set("rank_info/pos_msg", (: pos_msg :));

  delete("title");
  set_skill("parry", i * 10);
  set_skill("dodge", i * 10);
  set_skill("fork", i * 10);
  set_skill("force", i * 10);
  set_skill("spells", i * 10);
  set_skill("fengbo-cha", i * 10);
  set_skill("dragonforce", i * 10);
  set_skill("dragonstep", i * 10);
  set_skill("seashentong", i * 10);
  map_skill("parry", "fengbo-cha");
  map_skill("fork", "fengbo-cha");
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  set("force_factor", 50);
  set("mana_factor", 10);
  set_temp("armor_level", 79);
  set_temp("weapon_level", 79);
  set("env/test", "HIB");
  setup();
  carry_object(0, "armor", random(2))->wear();
  carry_object(0, "fork", random(2))->wield();
  add_temp("apply/combat_def", 3000);
  add_temp("apply/spells_def", 800);
  add_temp("apply/combat_damage", 2500);
  powerup(0, 1);
}

int information(object who) {
  if (!who || !environment(who)
    || !environment(who)->query("init_place"))
    return 0;
  if (who->query("dntg/donghai") != "weapon2")
    return 0;
  set_temp("my_killer", who);
  this_object()->move(environment(who));
  message_vision(CYN "\n堂下走来了$N" CYN "，与虾兵蟹将扛着一把三千六百斤重的九股托天叉，摇摇晃晃走了过来。\n" NOR, this_object());
  EMOTE_D->do_emote(this_object(), "hi", "ao guang", CYN, 0, 0, 0);
  return 1;
}

void show_msg(object who) {
  if (!who || !environment(who)
    || !environment(who)->query("init_place")
    || who->query("dntg/donghai") != "weapon2")
    return;
  message_vision(
    CYN "$N" CYN "说道：这位爷爷，小的将兵器拿来了，您准备准备，如果要试试就开始(start)；装备好了，我们就切磋切磋(fight)。\n" NOR,
    this_object()
  );
}

void init() {
  add_action("do_start", "start");
  add_action("do_fight", "fight");
}

int do_start(string arg) {
  object weapon, me = this_player();
  if (objectp(weapon = me->query_temp("pending/dntg_get_weapon2"))) {
    if (!present(weapon, me))
      return err_msg(name() + "大惊失色：这位爷爷你怎么将兵器弄丢了，这这这，叫俺如何交差？\n");
    if (weapon != me->query_temp("weapon"))
      return err_msg(CYN + name() + CYN "说道：您不是拿了兵器了吗？装备(wield)上后便与小的切磋切磋(fight)，看看合不合手。\n" NOR);
    else return err_msg(CYN + name() + CYN "说道：您不是拿了兵器了吗？与小的切磋切磋(fight)，看看合不合手。\n" NOR);
  }

  message_vision(HIC "$N" HIC "说道：某家准备好了，将兵器给我试试。\n" NOR, me);
  EMOTE_D->do_emote(this_object(), "ok", geteuid(me), CYN, 0, 0, 0);
  weapon = new("/d/obj/nweapon/fork");
  weapon->init_weapon(79);
  weapon->set_name(HIY "九股托天叉" NOR, ({ "jiugu cha", "cha", "fork" }));
  if (!weapon->move(me)) {
    weapon->move("/d/maze/dntg-sea-sea1/empty");
    REMOVE_D->add_obj(weapon, 1);
    return err_msg("这位爷爷，包裹满了。\n");
  }
  me->set_temp("pending/dntg_get_weapon2", weapon);
  write(name() + "将九股叉交到你手中。\n");
  me->powerup();
  write(CYN + name() + CYN "说道：拿了兵器，装备(wield)上后便与小的切磋切磋(fight)，看看合不合手。\n" NOR);
  return 1;
}

void do_attack(object me, object victim, object weapon) {
  int pp, damage;
  mapping my_act, his_act;
  object wp;
  string result, limb, *limbs, his_skill, my_skill, attack_skill, w_name1, w_name2;
  remove_call_out("_fight");
  if (!me || !victim)
    return;
  if (!mapp(my_act = me->query("actions"))
    || sizeof(my_act) < 1
    || undefinedp(my_act["action"]))
    result = "\n$N开始攻击$n。\n";
  else result = "\n" + my_act["action"];

  if (!mapp(his_act = victim->query("actions"))
    || sizeof(his_act) < 1)
    pp = -1;

  if (!undefinedp(my_act["limb"]))
    limb = my_act["limb"];
  if (!arrayp(limbs = victim->query_temp("apply/limbs")))
    limbs = victim->query("limbs");
  if (!limbs || !arrayp(limbs))
    limbs = ({ "头部", "尾巴", "前脚", "后脚", "屁股", "嘴巴", "后背", });
  if (!limb)
    limb = limbs[random(sizeof(limbs))];

  pp = 5;
  if (random(me->query_kar()) > victim->query("kar"))
    pp += 1;
  if (random(me->query_cor()) > victim->query("cor"))
    pp += 1;
  if (random(me->query_cps()) > victim->query("cps"))
    pp += 1;
  pp = random(pp);
  if (pp == 0) {
    if (!stringp(his_skill = victim->query_skill_mapped("dodge"))
      || !stringp(SKILL_D(his_skill)->query_dodge_msg(limb)))
      result += "结果被$n闪开了。\n";
    else result += SKILL_D(his_skill)->query_dodge_msg(limb);
    damage = 0;
  } else if (pp == 4) {
    if (!stringp(his_skill = victim->query_skill_mapped("parry"))
      || !stringp(SKILL_D(his_skill)->query_parry_msg(victim, me)))
      result += "结果被$n挡住了。\n";
    else result += SKILL_D(his_skill)->query_parry_msg(victim, me);
    damage = 0;
  } else {
    if (!objectp(wp = me->query_temp("weapon"))
      || !stringp(my_skill = wp->query("skill_type")))
      my_skill = "unarmed";
    else my_skill = wp->query("skill_type");
    if (!stringp(attack_skill = me->query_skill_mapped(my_skill)))
      attack_skill = my_skill;
    //damage = COMBAT_D->valid_damage(me,victim,attack_skill,TYPE_COMBAT);
    damage = 800 + random(500);
    result += COMBAT_D->damage_msg(damage, my_act["damage_type"]);
  }
  if (!objectp(wp = me->query_temp("weapon")))
    w_name1 = "双拳";
  else w_name1 = wp->query("name");
  if (!objectp(wp = victim->query_temp("weapon")))
    w_name2 = "双拳";
  else w_name2 = wp->query("name");
  result = replace_string(result, "$w", w_name1);
  result = replace_string(result, "$W", w_name2);
  result = replace_string(result, "$l", limb);
  message_vision(result, me, victim);
  if (damage > 0) {
    if (!undefinedp(my_act["force"])) {
      victim->receive_wound("kee", damage, me, TYPE_COMBAT);
      COMBAT_D->report_status(victim, 1);
    } else {
      victim->receive_damage("kee", damage, me, TYPE_COMBAT);
      COMBAT_D->report_status(victim);
    }
  }
}

int check_hp(object who, object weapon) {
  object lw;
  if (!who || !environment()
    || !environment()->query("init_place"))
    return 0;
  if (!objectp(lw = present("ao guang", environment()))
    || userp(lw)) {
    who->powerup();
    who->start_busy(5);
    environment()->_release(5);
    return 0;
  }
  if (!weapon || weapon != who->query_temp("weapon")) {
    message("vision", HIR "\n东海龙王勃然大怒：本王好心好意借兵器给尔一试，为何不用？！送客！\n\n" NOR, environment());
    who->powerup();
    who->start_busy(5);
    environment()->_release(5);
    return -1;
  }
  if (!living(who) || who->query("eff_kee") * 100 / who->query_maxkee() < 10
    || who->query("eff_sen") * 100 / who->query_maxsen() < 10
    || who->query("kee") * 100 / who->query("eff_kee") < 20
    || who->query("sen") * 100 / who->query("eff_sen") < 20) {
    message("vision", HIR "\n东海龙王哈哈大笑：本王看你不凡，却原来是银样镴枪头！送客！\n\n" NOR, environment());
    who->powerup();
    who->start_busy(5);
    environment()->_release(5);
    return -2;
  }
  if (!living(this_object()) || this_object()->query("eff_kee") * 100 / this_object()->query_maxkee() < 45
    || this_object()->query("eff_sen") * 100 / this_object()->query_maxsen() < 45
    || this_object()->query("kee") * 100 / this_object()->query("eff_kee") < 50
    || this_object()->query("sen") * 100 / this_object()->query("eff_sen") < 50) {
    message_vision(HIY "\n$N" HIY "战罢多时，手中九股叉断为两截！\n$N" HIY "哈哈一笑：兵器还是太轻，换来换来！\n" NOR, who);
    weapon->unequip();
    who->reset_action();
    weapon->set("breaked", 1);
    weapon->set("name", "断了的" + weapon->query("name"));
    weapon->move(environment());
    who->delete_temp("pending/dntg_get_weapon2");
    who->set("dntg/donghai", "weapon3");
    EMOTE_D->do_emote(lw, "fear", geteuid(who), CYN, 0, 0, 0);
    lw->_dntg(who);
    return 2;
  }
  return 1;
}

void _fight(object me, object weapon) {
  int p;
  remove_call_out("_fight");
  if (!me || !environment(me)
    || !environment()->query("init_place")
    || !present(me, environment()))
    return;
  if (me->query("dntg/donghai") != "weapon2")
    return;
  me->start_busy(5);
  p = check_hp(me, weapon);
  if (p != 1)
    return;
  switch (random(4)) {
    case 0:
      if (random(2))
        message_vision(guard_msg[random(sizeof(guard_msg))], me, this_object());
      else message_vision(guard_msg[random(sizeof(guard_msg))], this_object(), me);
      break;
    case 1:
    case 2:
      do_attack(me, this_object(), weapon);
      break;
    default:
      do_attack(this_object(), me, weapon);
      break;
  }
  call_out("_fight", random(5), me, weapon);
}

int do_fight(string arg) {
  object weapon, me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!objectp(weapon = me->query_temp("pending/dntg_get_weapon2"))
    || !present(weapon, me)
    || weapon != me->query_temp("weapon"))
    return err_msg(CYN + name() + CYN "说道：这位爷爷，小的将兵器拿来了，您准备准备，如果要试试就开始(start)；装备好了，我们就切磋切磋(fight)。\n" NOR);
  if (me->is_busy())
    return err_msg("加油加油。\n");
  message_vision(HIW "\n$N" HIW "朝$n" HIW "一拱手：来来来，让俺试试这把兵器合手不合手。\n" NOR, me, this_object());
  me->start_busy(5);
  message_vision(HIR "说罢，俩人便战在了一处。\n\n" NOR, me);
  set_temp("fighitng", 1);
  _fight(me, weapon);
  return 1;
}

varargs string short(int v) {
  string str = ::short(v);
  if (query_temp("fighting"))
    str += HIW " <切磋中>" NOR;
  return str;
}
