#include <ansi.h>
#include <combat.h>
inherit NPC;

nosave string weapon_type = "unarmed";
nosave int Die = 0;
nosave int Num = 1;
nosave int Super = 0;
nosave int default_level = 790;

void init_skill() {
  string *skills;
  object *inv;
  int i;
  mapping skill;
  skill = query_skills();
  if (!skill || !mapp(skill))
    return;
  skills = keys(skill);
  if (skills && arrayp(skills)) {
    for (i = 0; i < sizeof(skills); i++)
      delete_skill(skills[i]);
  }
  inv = all_inventory();
  if (intp(i = sizeof(inv)) && i > 0) {
    while (i--) {
      if (!userp(inv[i])) {
        inv[i]->unequip();
        inv[i]->move("/d/maze/dntg-sea-sea1/empty");
        REMOVE_D->add_obj(inv[i], 1);
      } else inv[i]->move("/obj/void");
    }
  }
  reset_action();
}

void init_family(int default_level) {
  string weapon, fam, *files;
  object ob;
  int i;
  init_skill();
  create_family("东海龙宫", 3, "");
  set_skill("force", default_level);
  set_skill("spells", default_level);
  set_skill("dodge", default_level);
  set_skill("parry", default_level);
  set_skill("literate", default_level);
  set_skill("unarmed", default_level);
  set_skill("axe", default_level);
  set_skill("blade", default_level);
  set_skill("dagger", default_level);
  set_skill("fork", default_level);
  set_skill("hammer", default_level);
  set_skill("mace", default_level);
  set_skill("rake", default_level);
  set_skill("spear", default_level);
  set_skill("staff", default_level);
  set_skill("stick", default_level);
  set_skill("sword", default_level);
  set_skill("throwing", default_level);
  set_skill("whip", default_level);
  set(
    "shentong/40",
    sprintf(
      "%s_%s_%d",
      ({ "金", "木", "水", "火", })[random(4)],
      ({ "阴", "阳", })[random(2)],
      1 + random(7)
    )
  );

  set_skill("seashentong", default_level);
  map_skill("spells", "seashentong");
  set_skill("dragonforce", default_level);
  map_skill("force", "dragonforce");
  set_skill("dragonfight", default_level);
  map_skill("unarmed", "dragonfight");
  set_skill("dragonstep", default_level);
  map_skill("dodge", "dragonstep");
  set_skill("fengbo-cha", default_level);
  map_skill("fork", "fengbo-cha");
  set_skill("huntian-hammer", default_level);
  map_skill("hammer", "huntian-hammer");

  if (random(2)) {
    map_skill("parry", "dragonfight");
    weapon = "unarmed";
  } else if (random(2)) {
    map_skill("parry", "fengbo-cha");
    weapon = "fork";
  } else {
    map_skill("parry", "huntian-hammer");
    weapon = "hammer";
  }

  set_skill("zhidi-chenggang", default_level);
  set_skill("huanyu-hufeng", default_level);
  set_skill("danshan", default_level);
  set_skill("duanliu", default_level);

  delete("title");
  carry_object(0, weapon, 1)->wield();
  files = ({
    "armor", "cloth", "hand", "kui", "neck", "pifeng", "ring", "shield", "shoes", "waist", "wrists",
  });
  for (i = 0; i < sizeof(files); i++)
    carry_object(0, files[i], 1)->wear();
}

int query_max_hp() {
  int level;
  level = this_object()->query_level();
  return 5000 + level * 800;
}

int information(object who) {
  int kee, lvl;
  lvl = 79;
  this_object()->set_level(lvl);
  kee = this_object()->query_max_hp();
  default_level = lvl * 10;
  this_object()->set_temp("weapon_level", 79);
  this_object()->set_temp("armor_level", 79);
  this_object()->init_family(default_level);
  this_object()->set("max_kee", kee);
  this_object()->set("max_sen", kee);
  this_object()->set("max_force", default_level * 15);
  this_object()->set("max_mana", default_level * 18);
  setup();
  this_object()->powerup(0, 1);
  this_object()->set("force", this_object()->query_maxforce() * 2);
  this_object()->set("mana", this_object()->query_maxmana() * 2);
  this_object()->set("mana_factor", default_level * 2);
  this_object()->set("force_factor", default_level * 2);
  this_object()->set("daoxing", this_object()->query_max_daoxing());
  this_object()->set("valid_time", time());

  this_object()->move(environment(who));
  message_vision(
    HIG "\n一道巨浪平地卷起，从里面杀出一位半人半鱼的龙宫护卫。\n" NOR CYN "$N" CYN "说道：大胆！谁人擅闯我东海水晶宫？！\n" NOR,
    this_object(),
    who
  );
  this_object()->kill_ob(who);
  who->fight_ob(this_object());
  this_object()->set_follow(who);
  return 1;
}

void create() {
  int i;
  string id, *ids, *names, name, long;

  names = ({
    "日值虾兵", "xia bing", "一个穿着盔甲的大虾米，正走来走去维护秩序",
    "日值蟹将", "xie jiang", "一个穿着盔甲的大螃蟹，正走来走去维护秩序。",
    "巡海夜叉", "ye cha", "一个巡海的夜叉，长的青面獠牙。",
    "鳊提督", "bian tidu", "东海龙宫鳊提督。",
    "鲤总兵", "li zongbing", "东海龙宫鲤总兵。",
    "鳜都司", "jue dusi", "东海龙宫鳜都司。",
    "鲌太尉", "bo taiwei", "东海龙宫鲌太尉。",
    "鲭都司", "qing dusi", "东海龙宫鲭都司。",
    "青贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "黄贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "白贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "紫贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "银贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "金贝女兵", "bei nu", "一个身后背有彩贝的女兵。",
    "青鳝力士", "li shi", "东海龙宫护卫。",
    "赤鲤力士", "li shi", "东海龙宫护卫。",
    "黄鲳力士", "li shi", "东海龙宫护卫。",
    "白鲨力士", "li shi", "东海龙宫护卫。",
    "紫鲭力士", "li shi", "东海龙宫护卫。",
    "金鳌力士", "li shi", "东海龙宫护卫。",
    "银蛎力士", "li shi", "东海龙宫护卫。",
    "乌鳅力士", "li shi", "东海龙宫护卫。",
  });
  i = random(sizeof(names)) / 3 * 3;
  name = names[i];
  id = names[i + 1];
  long = names[i + 2];
  ids = ({ id, "long wei", "jiang", });
  set_name(name, ids);
  set("long", long);
  set("no_sleep", 1);
  set("任务", 1);
  if (strsrch(name, "女") != -1)
    set("gender", "女性");
  else set("gender", "男性");
  set("env/test", "HIM");
  set("env/brief_message", 3);
  setup();
}

void super_hit() {
  int t = 2 + random(3);
  Super = 0;
  QUEST_D->addEffKee(this_object());
  QUEST_D->addKee(this_object());
  QUEST_D->addSen(this_object());
  QUEST_D->addEffSen(this_object());
  if (this_object() && this_object()->is_fighting()
    && living(this_object())) {
    this_object()->stop_busy();
    Super = 1;
    QUEST_D->randomPfm(this_object());
  }
  remove_call_out("super_hit");
  call_out("super_hit", t);
}

void kill_ob(object who) {
  if (!who || !present(who, environment())) {
    this_object()->powerup(1);
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
  if (Die == 1) {
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
  if (this_object()->is_fighting(who))
    return;
  remove_call_out("super_hit");
  if (Super == 0)
    super_hit();
  ::kill_ob(who);
  if (this_object()->query_level() >= 40)
    command("cast xiaoshen");
}

int follow_me(object ob, string dir) {
  if (!ob || !living(this_object()) || ob == this_object())
    return 0;
  if (ob == follow
    || (query("pursuer") && this_object()->is_killing(ob->query("id"))))
    return follow_path(dir);
  return 0;
}

void reward_ob(object who) {
  if (!who || !userp(who) || !present(who, environment())) {
    message_vision(HIB "\n$N" HIB "化作一道青烟随风散去。\n\n" NOR, this_object());
    this_object()->move("/d/maze/dntg-sea-sea1/empty");
    REMOVE_D->add_obj(this_object(), 1);
    return;
  }

  message_vision(HIR "\n$N" HIR "被打得破头折脚，肉绽皮开，负痛便走：大胆毛贼，休得猖狂，待我禀告我家龙王爷爷去。\n\n" NOR, this_object());
  who->add_temp("maze/killed", 1);

  this_object()->move("/obj/empty");
  REMOVE_D->add_obj(this_object(), 1);
  return;
}

int accept_fight(object who) { return 0; }

int is_sea() { return 1; }
