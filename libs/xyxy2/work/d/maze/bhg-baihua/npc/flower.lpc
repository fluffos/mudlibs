#include <ansi.h>
inherit ITEM;

mapping Flower = ([
  MAG "梦幻玫瑰" NOR: ({
    ({ "menghuan meigui", "mei gui", "meigui" }),
    HIM "铿锵玫瑰，如梦似幻。" NOR,
    "combat_exp"
  }),
  HIC "幻梦幽兰" NOR: ({ ({ "huanmeng youlan", "you lan", "youlan" }), HIW "幽谷之兰，冰清玉洁。" NOR, "skill" }),
  HIB "薄雪花" NOR: ({ ({ "bo xuehua", "xue hua", "xuehua" }), WHT "清新脱俗，不似凡物。" NOR, "faith" }),
  HIG "风野玫" NOR: ({ ({ "feng yemei", "ye mei", "yemei" }), HIG "生于原野，不屑温室，生机勃勃。" NOR, "skill" }),
  HIR "美人血" NOR: ({ ({ "meiren xue", "meiren xue", }), HIR "凄美传说，流传千秋。" NOR, "skill" }),
  HIW "青凰玫" NOR: ({ ({ "qinghuang mei", "qing mei", }), HIG "姐已不在江湖，江湖尽是姐的传说。" NOR, "random" }),
]);

void create() {
  string name, *names, *ids, long, type;

  names = keys(Flower);
  name = names[random(sizeof(names))];
  ids = Flower[name][0];
  long = Flower[name][1];
  long += "\n" HIG "当你有" HIC "灵气珠" HIG "(可以通过击杀" HIR "【百花谷副本】怪物" HIG "获得)时，可以来催化(" HIY "cuihua" HIG ")它。" NOR "\n" HIG "当它成熟后，你能得到相应的" HIY "奖励" HIG "。" NOR "\n";
  type = Flower[name][2];

  ids += ({ "hua", "flower", "dream flower" });
  set_name(name, ids);
  set("type", type);
  set("long", long);
  set("unit", "朵");
  set("level", 1 + random(10));
  set("no_get", HIY "百花谷严禁辣手摧花！" NOR "\n");
  setup();
}

varargs string name(int v) {
  if (v)
    return ::name(v);
  return chinese_number(this_object()->query("level") * 10) + "年" + ::name();
}

void init() {
  add_action("do_cui", "cuihua");
}

void dest_ob() {
  remove_call_out("dest_ob");
  this_object()->move("/d/maze/bhg_baihua/empty");
  REMOVE_D->add_obj(this_object(), 1);
}

void reward_ob(object me) {
  object ob = this_object();
  string type, skill, *skills, *tmp;
  mapping sk;
  int p, i;

  if (!me || !environment()
    || !present(me, environment())
    || !ob->query("finish"))
    return;
  if (!stringp(type = ob->query("type"))
    || strlen(type) < 2)
    type = "combat_exp";
  if (type == "random")
    type = ({ "combat_exp", "skill", "faith", })[random(3)];
  switch (type) {
    case "skill":
      if (!mapp(sk = me->query_skills())
        || sizeof(sk) < 1)
        skills = ({
          "force", "spells", "literate", "dodge", "parry", "spells", "zongheng-sword",
          "unarmed", "baihua-xianfa", "brightjade-force", "rainbow-zhi",
          "siji-zhang", "wuyou-steps", "jiefeng",
        });
      else {
        skills = ({});
        tmp = keys(sk);
        for (i = 0; i < sizeof(tmp); i++) {
          if (sk[tmp[i]] <= 100)
            continue;
          if (!SKILL_D(tmp[i])->valid_learn(me) && !wizardp(me))
            continue;
          skills += ({ tmp[i] });
        }
      }
      skill = skills[random(sizeof(skills))];
      sk[skill] += 1;
      tell_object(me, HIY "你得到了一级「" HIC + to_chinese(skill) + HIY "」！" NOR "\n");
      break;
    case "faith":
      p = (ob->query("level") - 1) * 5 + 1;
      me->add("faith", p * 10000);
      tell_object(me, HIY "你得到了" + chinese_number(p) + "万门派贡献度！" NOR "\n");
      break;
    default:
      p = ob->query("level") * 50000;
      p = p + random(p / 2);
      me->add("combat_exp", p);
      tell_object(me, HIY "你得到了" + p + "点武学经验！" NOR "\n");
      break;
  }
  me->add("family/bhg_mazep", 5 + this_object()->query("level"));
  tell_object(
    me,
    HIC "凝眸仙子对你愈加赏识了！" HIR "[目前好感度" + me->query("family/bhg_mazep") + "]" HIC "。\n你可以在仙子处用好感度兑换各类秘笈" HIY "(list)" HIC "！" NOR "\n"
  );
}

void show_statue(object me) {
  object ob = this_object();
  int p, max;
  float pp;
  if (!me || !environment()
    || !present(me, environment()))
    return;
  ob = this_object();
  max = 100 + ob->query("level") * 10;
  p = ob->query("exp");
  if (p >= max) {
    set("finish", 1);
    tell_object(me, "\n" HIG + ob->query("name") + HIG "迎风招展，顿时发出浓郁的花香，让人如痴如醉。" NOR "\n");
    reward_ob(me);
    remove_call_out("dest_ob");
    call_out("dest_ob", 1);
    return;
  }
  pp = BFB(p, max);
  if (pp > 100) pp = 100;
  if (pp < 0.01) pp = 0.01;
  tell_object(me, ob->query("name") + "迎风招展，发出一阵悉悉索索响声，仿若正高兴地歌唱。" NOR "\n");
  tell_object(
    me,
    HIY "【副本】百花谷：" + ob->query("name") + HIY "成长度目前为 " + sprintf(
      HIR "%3.2f%%" NOR,
      pp
    ) + HIY " 。" NOR "\n"
  );
  if (me->query_temp("maze/bhg_killed") > 0)
    tell_object(me, "你尚有" + me->query_temp("maze/bhg_killed") + "个灵气珠未使用。\n");
}

int do_cui(string arg) {
  int n, max, p;
  object me = this_player(), ob = this_object();

  if (!environment() || !environment(me)
    || !present(ob, environment(me)))
    return 0;
  if (!arg || !id(arg))
    return notify_fail("你要催化什么？\n");
  if (ob->query("finish"))
    return notify_fail(ob->query("name") + "已经成熟了。\n");
  if (!intp(n = me->query_temp("maze/bhg_killed"))
    || n <= 0)
    return err_msg("你身上目前没有" HIC "灵气珠" NOR "。\n");

  p = 5 + random(6);


  write("你用灵气珠开始催化" + ob->query("name") + "。\n");
  write(HIY "【副本】百花谷：" + ob->query("name") + HIY "的成长度增加了 " + p + " 点。" NOR "\n");
  me->add_temp("maze/bhg_killed", -1);
  ob->add("exp", p);
  show_statue(me);
  return 1;
}

string long() {
  int n, max;
  float pp;
  string str = ::long();
  if (!intp(n = query("exp"))
    || n <= 0)
    return str;
  max = 100 + query("level") * 10;
  pp = BFB(n, max);
  if (pp > 100) pp = 100;
  if (pp < 0.01) pp = 0.01;
  str += "\n" + NOR HBBLU HIG "成长度目前为 " HIY + sprintf(
    HIR "%3.2f%%" NOR,
    pp
  ) + NOR HBBLU HIG " 。" NOR "\n";
  return str;
}
