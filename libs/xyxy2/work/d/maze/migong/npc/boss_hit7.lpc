//諸懷 其狀如牛,而四角、人目、彘耳,其名曰諸懷,其音如鳴雁,是食人
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(10) == 5)
    return 1;
  if (random(2)) {
    if (time() < (target->query_temp("no_perform/start") + target->query_temp("no_perform/time")))
      return 1;
    msg = HIY "\n$N" HIY "仰面发出一声巨吼，顿时四周尽被$P发出的金光笼罩！\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("no_perform", ([
      "start": time(),
      "time": 5,
      "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的吼声所扰，顿时章法全无，发不出招来。\n" NOR,
    ]));
  } else {
    damage = target->query("max_kee") / 10;
    msg = HIY "\n$N" HIY "身子一沉，顺势将角朝$n" HIY "一抵！\n" NOR;
    msg += HIR "结果只听见「砰」地一声巨响，$n" HIR "口中鲜血喷出，整个人横飞了出去！\n" NOR;
    message_vision(msg, me, target);
    if (random(2)) {
      damage = target->receive_damage("kee", damage, me, TYPE_CAST);
      if (damage > 0) {
        COMBAT_D->report_status(target);
        if (COMBAT_D->query_message_type(me, target) >= 2)
          message_vision("结果对$N造成了" HIR + damage + NOR "点气血减少。\n", target);
      }
    } else {
      damage = target->receive_wound("kee", damage, me, TYPE_CAST);
      if (damage > 0) {
        COMBAT_D->report_status(target, 1);
        if (COMBAT_D->query_message_type(me, target) >= 2)
          message_vision("结果对$N造成了" HIR + damage + NOR "点气血损伤。\n", target);
      }
    }
  }
  return 1;
}
