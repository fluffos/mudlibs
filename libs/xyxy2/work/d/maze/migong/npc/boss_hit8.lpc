// 作為火神的隨從，甚至有時就是火神的犬類，禍鬥只吃火焰。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(10) == 5)
    return 1;
  damage = target->query("max_kee") / 8;
  msg = HIR "\n$N" HIR "后退数步，鼓腹阖口，吐出一串火焰！\n" NOR;
  switch (random(5)) {
    case 0:
    case 4:
      msg = HIR "凭空落下一个巨大的火球，朝向$n" HIR "砸去！\n" NOR;
      msg += HIR "结果「砰」地一声，$n" HIR "浑身焦臭，疼得连腰都弯了！\n" NOR;
      message_vision(msg, me, target);
      damage = target->receive_damage("kee", damage, me, TYPE_CAST);
      if (damage > 0) {
        COMBAT_D->report_status(target);
        if (COMBAT_D->query_message_type(me, target) >= 2)
          message_vision("结果对$N造成了" HIR + damage + NOR "点气血减少。\n", target);
      }
      break;
    case 3:
      msg = HIY "顿时一团火焰陡地拨起，凌空燃烧，便如一座" NOR RED "火墙" NOR HIY "般，夹着排山倒海之势将$N" HIY "吞没！$N" HIY "全身上下焕然一新！\n" NOR;
      message_vision(msg, me, target);
      me->powerup(0, 1);
      me->start_busy(1);
      break;
    default:
      msg = HIR "顿时凭空化出数道火焰，或作火鸦，或为火蛇，朝向$n" HIR "扑去。\n" NOR;
      msg += HIR "$n" HIR "闪避不及，浑身数处焦黑，一时焦头烂额，狼狈不堪。\n" NOR;
      message_vision(msg, me, target);
      damage = target->receive_wound("kee", damage / 3, me, TYPE_CAST);
      if (damage > 0) {
        COMBAT_D->report_status(target, 1);
        if (COMBAT_D->query_message_type(me, target) >= 2)
          message_vision("结果对$N造成了" HIR + damage + NOR "点气血损伤。\n", target);
      }
      break;
  }
  return 1;
}
