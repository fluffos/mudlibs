//九嬰，既能噴水，又能噴火。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int b, damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(5) == 3)
    return 1;
  damage = target->query("max_sen") / 8;
  if (random(2)) {
    msg = HIM "\n$N" HIM "纵身一吐，一股奇寒无比的水柱喷向$n" HIM "！\n" NOR;
    msg += HIR "结果$n" HIR "躲避不及，被水柱激个正着！\n" NOR;
    message_vision(msg, me, target);
    b = target->query_busy();
    if (intp(b) && b > 0)
      target->start_busy(b + 2);
    else target->start_busy(2);
    damage = target->receive_damage("sen", damage, me, TYPE_PERFORM);
    if (damage > 0) {
      COMBAT_D->report_sen_status(target);
      if (COMBAT_D->query_message_type(me, target) >= 2)
        message_vision("结果对$N造成了" HIR + damage + NOR "点精神减少。\n", target);
    }
  } else {
    msg = HIR "\n$N" HIR "突然张嘴一喷！一个石磨大小的火球“呼”地一声向$n" HIR "砸去！\n" NOR;
    msg += HIC "结果$n被烧得焦头烂额！\n" NOR;
    message_vision(msg, me, target);
    damage = target->receive_wound("sen", damage, me, TYPE_PERFORM);
    if (damage > 0) {
      COMBAT_D->report_sen_status(target);
      if (COMBAT_D->query_message_type(me, target) >= 2)
        message_vision("结果对$N造成了" HIR + damage + NOR "点精神损失。\n", target);
    }
  }
  return 1;
}
