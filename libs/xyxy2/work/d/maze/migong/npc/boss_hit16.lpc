//中國傳說中抑善揚惡的惡神，它的大小如牛、外形象虎、披有刺蝟的毛皮、長有翅膀，
//窮奇的叫聲象狗，靠吃人為生.
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage, i;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  if (time() > (target->query_temp("no_perform/start") + target->query_temp("no_perform/time"))) {
    msg = HIB "\n$N" HIB "仰面发出一声虎啸，顿时四周尽被$P发出的青光笼罩！\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("no_perform", ([
      "start": time(),
      "time": 15,
      "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的虎啸所扰，顿时章法全无，发不出招来。\n" NOR,
    ]));
  }
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(30) == 15)
    return 1;
  damage = target->query("max_kee") / 50;
  msg = HIG "\n$N" HIG "扇动双翅，凌空飞起，俯身发出一阵箭雨！\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < (3 + random(4)); i++) {
    if (!me || !living(me)
      || !target || !living(target)
      || !me->is_fighting(target)) {
      tell_object(target, HIY "你被刺中了！\n" NOR);
      damage = target->receive_damage("kee", damage, me, TYPE_CAST);
    }
  }
  return 1;
}
