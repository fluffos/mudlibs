int query_max_hp() {
  int level;
  if (!environment())
    return 100;
  level = environment()->query("num");
  if (level < 20)
    return 20000 + level * 50;
  else if (level < 50)
    return 50000 + level * 65;
  else if (level < 80)
    return 500000 + level * 80;
  else return 5000000 + level * 100;
}

void init_guai() {
  int kee;
  if (!owner || !environment())
    return;
  kee = query_max_hp();
  default_level = this_object()->query_level() * 10;
  init_family(default_level);
  set("max_force", default_level * 18);
  set("max_mana", default_level * 20);
  set("max_kee", kee);
  set("max_sen", kee);
  setup();
  powerup(0, 1);
  set("force", this_object()->query_maxforce() * 2);
  set("mana", this_object()->query_maxmana() * 2);
  set("mana_factor", default_level * 2);
  if (query("family/family_name") != "月宫")
    set("force_factor", default_level);
  else set("force_factor", 0);
  set("daoxing", this_object()->query_max_daoxing());
  set("valid_time", time());
}

void create() {
  set_name("迷宫怪物", ({ "yao mo", "yao", "mo", "guai" }));
  set("long", "长平尸坑中，因常年阴戾之气淤积，经万年而衍生出的怪物。\n");
  set("fangcun/panlong_accept", "done");
  set("no_sleep", 1);
  set("任务", 1);
  set("env/test", "HIM");
  set("env/brief_message", 3);
  setup();
}

void die() {
  if (query("eff_kee") < this_object()->query_maxkee())
    set("eff_kee", this_object()->query_maxkee());
  if (query("kee") < query("eff_kee") / 2)
    set("kee", query("eff_kee") / 2);
  if (query("eff_sen") < this_object()->query_maxsen())
    set("eff_sen", this_object()->query_maxsen());
  if (query("sen") < query("eff_sen") / 2)
    set("sen", query("eff_sen") / 2);
  if (query("force") < this_object()->query_maxforce() / 2)
    set("force", this_object()->query_maxorce() / 2);
  if (query("mana") < this_object()->query_maxmana() / 2)
    set("mana", this_object()->query_maxmana() / 2);
  return;
}

void unconcious() {
  die();
}

void dies() {
  int p, pp;
  object env, who;
  who = query_temp("last_damage_from");
  if (!who || who != owner || !present(who, environment())) {
    this_object()->powerup(0, 1);
    Die = 0;
    return;
  }
  message_vision("\n$N惨叫一声，化作一道黑烟渐渐散去。\n\n", this_object());
  env = environment();
  if (!env->query("guai")
    || this_object() != env->query("guai")) {
    destruct(this_object());
    return;
  }
  p = this_object()->query("room_num");
  if (p < 1) {
    destruct(this_object());
    return;
  }

  p = p * 1000000;
  p = ("/quest/gift/equip/level_up.lpc")->level_up(who, p);
  if (p > 0) {
    tell_object(who, NOR "\n" HIY "【副本】长平尸坑：你得到了" + p + "点武学经验。\n" NOR);
    who->add("combat_exp", p);
  }
  who->set("Migong/clear_num", env->query("num"));
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    HIY + who->name(1) + HIM "干掉了" HIR "「长平尸坑" + chinese_number(env->query("num")) + "层」" HIM "的" HIR + name() + HIM "，得到了海量的经验。" NOR
  );
  who->add("Migong/score", 1);
  tell_object(
    who,
    NOR "\n" HIY "【副本】长平尸坑：你得到了1点长平积分，目前共有" + who->query("Migong/score") + "点积分，可以在副本中兑换道具(list)。\n" NOR
  );
  destruct(this_object());
  return;
}

varargs int receive_damage(string type, int damage, object who, mixed attack_type) {
  int lvl, max, flag = 0;
  if (!environment())
    return 0;
  if (!who)
    flag = 1;
  else if (!userp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    if (!who || !userp(who))
      flag = 1;
  } else if (who != owner)
    flag = 1;
  if (flag == 1)
    damage = 0;
  max = query_max_hp();
  lvl = environment()->query("num");
  if (lvl < 10)
    max = max / 8;
  else if (lvl < 15)
    max = max / 9;
  else if (lvl < 20)
    max = max / 10;
  else if (lvl < 25)
    max = max / 11;
  else if (lvl < 30)
    max = max / 12;
  else if (lvl < 35)
    max = max / 13;
  else if (lvl < 40)
    max = max / 14;
  else if (lvl < 45)
    max = max / 15;
  else if (lvl < 50)
    max = max / 16;
  else if (lvl < 55)
    max = max / 17;
  else if (lvl < 60)
    max = max / 18;
  else if (lvl < 65)
    max = max / 19;
  else if (lvl < 70)
    max = max / 20;
  else if (lvl < 75)
    max = max / 21;
  else if (lvl < 80)
    max = max / 22;
  else if (lvl < 85)
    max = max / 23;
  else if (lvl < 90)
    max = max / 24;
  else max = max / 25;
  if (this_object()->is_boss())
    max = max * 2 / 3;
  if (damage >= max)
    damage = max;
  damage = ::receive_damage(type, damage, who, attack_type);
  lvl = (100 - lvl) / 10;
  if (lvl < 2)
    lvl = 2;
  if (type == "kee")
    this_object()->add_temp("kee_receive_damaged", 1);
  else this_object()->add_temp("sen_receive_damaged", 1);
  if (Die != 1) {
    if (query("kee") <= 0) {
      if (query("force") > 200 && query_temp("kee_receive_damaged") >= lvl) {
        this_object()->delete_temp("kee_receive_damaged");
        ("/cmds/std/exert.lpc")->main(this_object(), "recover");
      }
      if (query("kee") <= 0) {
        Die = 1;
        remove_call_out("super_hit");
        remove_call_out("dies");
        call_out("dies", 3);
      }
    }
    if (query("sen") <= 0) {
      if (query("force") > 200 && query_temp("sen_receive_damaged") >= lvl) {
        this_object()->delete_temp("sen_receive_damaged");
        ("/cmds/std/exert.lpc")->main(this_object(), "refresh");
      }
      if (query("sen") <= 0) {
        Die = 1;
        remove_call_out("super_hit");
        remove_call_out("dies");
        call_out("dies", 3);
      }
    }
    if (query("eff_sen") <= 0 || query("eff_kee") <= 0) {
      Die = 1;
      remove_call_out("super_hit");
      remove_call_out("dies");
      call_out("dies", 3);
    }
  }
  return damage;
}

varargs int receive_wound(string type, int damage, object who, mixed attack_type) {
  int lvl, max, flag = 0;
  if (!environment())
    return 0;
  if (Die == 1)
    return 0;
  if (!who)
    flag = 1;
  else if (!userp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    if (!who || !userp(who))
      flag = 1;
  } else if (who != owner)
    flag = 1;
  if (flag == 1)
    damage = 0;
  max = query_max_hp();
  lvl = environment()->query("num");
  if (lvl < 10)
    max = max / 8;
  else if (lvl < 15)
    max = max / 9;
  else if (lvl < 20)
    max = max / 10;
  else if (lvl < 25)
    max = max / 11;
  else if (lvl < 30)
    max = max / 12;
  else if (lvl < 35)
    max = max / 13;
  else if (lvl < 40)
    max = max / 14;
  else if (lvl < 45)
    max = max / 15;
  else if (lvl < 50)
    max = max / 16;
  else if (lvl < 55)
    max = max / 17;
  else if (lvl < 60)
    max = max / 18;
  else if (lvl < 65)
    max = max / 19;
  else if (lvl < 70)
    max = max / 20;
  else if (lvl < 75)
    max = max / 21;
  else if (lvl < 80)
    max = max / 22;
  else if (lvl < 85)
    max = max / 23;
  else if (lvl < 90)
    max = max / 24;
  else max = max / 25;
  if (this_object()->is_boss())
    max = max * 2 / 3;
  if (damage >= max)
    damage = max;
  damage = ::receive_wound(type, damage, who, attack_type);
  lvl = (100 - lvl) / 10;
  if (lvl < 2)
    lvl = 2;
  if (type == "kee")
    this_object()->add_temp("kee_receive_wounded", 1);
  else this_object()->add_temp("sen_receive_wounded", 1);
  if (Die != 1) {
    if (query("kee") <= 0) {
      if (query("force") > 200 && query_temp("kee_receive_wounded") >= lvl) {
        this_object()->delete_temp("kee_receive_wounded");
        ("/cmds/std/exert.lpc")->main(this_object(), "recover");
      }
      if (query("kee") <= 0) {
        Die = 1;
        remove_call_out("super_hit");
        remove_call_out("dies");
        call_out("dies", 3);
      }
    }
    if (query("sen") <= 0) {
      if (query("force") > 200 && query_temp("sen_receive_wounded") >= lvl) {
        this_object()->delete_temp("sen_receive_wounded");
        ("/cmds/std/exert.lpc")->main(this_object(), "refresh");
      }
      if (query("sen") <= 0) {
        Die = 1;
        remove_call_out("super_hit");
        remove_call_out("dies");
        call_out("dies", 3);
      }
    }
    if (query("eff_sen") <= 0 || query("eff_kee") <= 0) {
      Die = 1;
      remove_call_out("super_hit");
      remove_call_out("dies");
      call_out("dies", 3);
    }
  }
  return damage;
}

void super_hit(object who) {
  int t;
  t = query_level() / 15;
  if (t < 4) t = 4;
  if (t > 7) t = 7;
  t = 10 - t;
  Super = 0;
  if (this_object() && who
    && this_object()->is_fighting(who)
    && living(this_object())
    && !this_object()->is_die()) {
    Super = 1;
    switch (this_object()->name()) {
      case "蜚廉": (__DIR__ "boss_hit1.lpc")->hit(this_object(), who); break;
      case "屏蓬": (__DIR__ "boss_hit2.lpc")->hit(this_object(), who); break;
      case "牙豚": (__DIR__ "boss_hit3.lpc")->hit(this_object(), who); break;
      case "九嬰": (__DIR__ "boss_hit4.lpc")->hit(this_object(), who); break;
      case "諸犍": (__DIR__ "boss_hit5.lpc")->hit(this_object(), who); break;
      case "梼杌": (__DIR__ "boss_hit6.lpc")->hit(this_object(), who); break;
      case "諸懷": (__DIR__ "boss_hit7.lpc")->hit(this_object(), who); break;
      case "禍鬥": (__DIR__ "boss_hit8.lpc")->hit(this_object(), who); break;
      case "肥遺": (__DIR__ "boss_hit9.lpc")->hit(this_object(), who); break;
      case "猰貐": (__DIR__ "boss_hit10.lpc")->hit(this_object(), who); break;
      case "朱厭": (__DIR__ "boss_hit11.lpc")->hit(this_object(), who); break;
      case "赤鱬": (__DIR__ "boss_hit12.lpc")->hit(this_object(), who); break;
      case "當扈": (__DIR__ "boss_hit13.lpc")->hit(this_object(), who); break;
      case "猙兽": (__DIR__ "boss_hit14.lpc")->hit(this_object(), who); break;
      case "狞兽": (__DIR__ "boss_hit15.lpc")->hit(this_object(), who); break;
      case "窮奇": (__DIR__ "boss_hit16.lpc")->hit(this_object(), who); break;
      case "相柳": (__DIR__ "boss_hit17.lpc")->hit(this_object(), who); break;
    }
  }
  remove_call_out("super_hit");
  call_out("super_hit", t, who);
}

void kill_ob(object who) {
  if (!who || !present(who, environment())) {
    this_object()->powerup(1);
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
  if (Die == 1 || !owner || who != owner) {
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    return;
  }
  if (this_object()->is_fighting(who))
    return;
  remove_call_out("super_hit");
  if (Super == 0)
    super_hit(who);
  ::kill_ob(who);
  if (this_object()->query_level() >= 40)
    command("cast xiaoshen");
}

int is_die() { return Die; }

void set_num(int v) {
  int kee;
  if (v > 0) {
    Num = v;
    kee = query("max_kee") * v;
    set("max_kee", kee);
    set("eff_kee", kee);
    set("kee", kee);
    set("max_sen", kee);
    set("eff_sen", kee);
    set("sen", kee);
  }
}

string short() {
  string str = ::short();
  if (Num > 1)
    str += HIR "x" + Num + NOR "";
  return str;
}

string name() {
  int lvl;
  string str;
  if (!environment())
    return "魔物";
  lvl = environment()->query("num");
  if (lvl == 10)
    str = "蜚廉";
  else if (lvl == 20)
    str = "屏蓬";
  else if (lvl == 30)
    str = "牙豚";
  else if (lvl == 35)
    str = "九嬰";
  else if (lvl == 40)
    str = "諸犍";
  else if (lvl == 45)
    str = "梼杌";
  else if (lvl == 50)
    str = "諸懷";
  else if (lvl == 55)
    str = "禍鬥";
  else if (lvl == 60)
    str = "肥遺";
  else if (lvl == 65)
    str = "猰貐";
  else if (lvl == 70)
    str = "朱厭";
  else if (lvl == 75)
    str = "赤鱬";
  else if (lvl == 80)
    str = "當扈";
  else if (lvl == 85)
    str = "猙兽";
  else if (lvl == 90)
    str = "狞兽";
  else if (lvl == 95)
    str = "窮奇";
  else str = "相柳";
  return str;
}

mixed only_attack_type() {
  if (this_object()->is_fighting()
    && time() < this_object()->query_temp("PWUP/start") + this_object()->query_temp("PWUP/time")
    && living(this_object()))
    return "NONE";
  return 0;
}

void init() {
  if (userp(this_player()) && !this_object()->is_fighting()
    && query("vaile_time") > 0) {
    this_object()->kill_ob(this_player());
    this_player()->fight_ob(this_object());
  }
}

string my_look() {
  switch (this_object()->name()) {
    case "蜚廉": return HIC "鳥身鹿頭，奇形怪状" NOR "。";
    case "屏蓬": return HIB "颈生双首，水火交济" NOR "。";
    case "牙豚": return HIC "猪头猪脑，獠牙朝天" NOR "。";
    case "九嬰": return HIR "双翅遮天，口中青红闪烁" NOR "。";
    case "諸犍": return HIB "人面豹身，牛耳一目，巨聲冲天" NOR "。";
    case "梼杌": return RED "人面，虎足，豬口牙，尾長一丈八尺" NOR "。";
    case "諸懷": return HIC "头生四角，双目炯炯。" NOR "。";
    case "禍鬥": return HIR "宛如毒狼，口中吞吐着浓浓烈焰" NOR "。";
    case "肥遺": return HIM "单頭双體，六足四翅" NOR "。";
    case "猰貐": return HIY "独目如电，状若神灵" NOR "。";
    case "朱厭": return HIB "尖嘴猴腮，白頭紅腳" NOR "。";
    case "赤鱬": return HIY "魚形人面，满嘴碎齿" NOR "。";
    case "當扈": return HIY "双翅遮天，背生金羽" NOR "。";
    case "猙兽": return HIC "状如赤豹，五尾独角，聲如擊石" NOR "。";
    case "狞兽": return RED "面目狰狞，魔焰滔天" NOR "。";
    case "窮奇": return HIR "大小如牛，外形似虎，背生利刺，双翅插天" NOR "。";
    case "相柳": return HIY "九头巨蛇，叫人不寒而栗" NOR "。";
    default: return RED "面目狰狞，魔焰滔天" NOR "。";
  }
}
