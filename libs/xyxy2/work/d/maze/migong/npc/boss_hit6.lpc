//上古異獸之四大凶獸：梼杌 táo wù 有獸焉，其狀如虎而犬毛，長二尺，人面，虎足，豬口牙，尾長一丈八尺，攪亂荒中，名梼杌
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(8) == 5)
    return 1;
  damage = target->query("max_sen") / 7;
  if (random(2)) {
    msg = HIC "\n$N" HIC "退后两步，深深地吸一口气，猛然发出股如山崩海啸般的呼啸！\n" NOR;
    msg += HIR "$n" HIR "顿时觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样！\n" NOR;
    message_vision(msg, me, target);
    damage = target->query("max_sen") / 7;
    damage = target->receive_damage("sen", damage, me, TYPE_CAST);
    if (damage > 0) {
      COMBAT_D->report_sen_status(target);
      if (COMBAT_D->query_message_type(me, target) >= 2)
        message_vision("结果对$N造成了" HIR + damage + NOR "点精神减少。\n", target);
    }
  } else if (random(2)) {
    msg = HIY "\n$N" HIY "俯身将头上的角朝$n" HIY "一戳！\n" NOR;
    msg += HIR "「噗嗤」地一声，$n" HIR "身上被刺出一个血肉模糊的血窟窿！\n" NOR;
    message_vision(msg, me, target);
    damage = target->query("max_kee") / 7;
    damage = target->receive_damage("kee", damage, me, TYPE_CAST);
    if (damage > 0) {
      COMBAT_D->report_status(target);
      if (COMBAT_D->query_message_type(me, target) >= 2)
        message_vision("结果对$N造成了" HIR + damage + NOR "点气血减少。\n", target);
    }
  } else {
    msg = HIY "\n$N" HIY "转身，将屁股后的尾巴一扫，结果只听「啪」地一声，$n" HIY "被抽得皮开肉绽，痛得咬牙切齿！\n" NOR;
    message_vision(msg, me, target);
    damage = target->query("max_kee") / 8;
    damage = target->receive_wound("kee", damage, me, TYPE_CAST);
    if (damage > 0) {
      COMBAT_D->report_status(target, 1);
      if (COMBAT_D->query_message_type(me, target) >= 2)
        message_vision("结果对$N造成了" HIR + damage + NOR "点气血损伤。\n", target);
    }
  }
  return 1;
}
