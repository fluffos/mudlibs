//猰貐 燭龍的兒子
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  me->stop_busy();
  QUEST_D->randomPfm(me);
  if (random(10) == 5)
    return 1;
  if (random(2)) {
    if (time() < (target->query_temp("no_perform/start") + target->query_temp("no_perform/time")))
      return 1;
    msg = HIB "\n$N" HIB "仰面发出一声龙吟，顿时四周尽被$P发出的青光笼罩！\n" NOR;
    message_vision(msg, me, target);
    target->set_temp("no_perform", ([
      "start": time(),
      "time": 5,
      "msg": HIR "\n你刚想发招，却被" + me->name() + HIR "的吼叫所扰，顿时章法全无，发不出招来。\n" NOR,
    ]));
  }
  damage = target->query("max_kee") / 5;
  msg = HIC "\n$N" HIC "凌空飞起，俯身发出一声长吟！";
  if (random(2))
    msg += HIC "只见凭空忽现数道风刃，风驰电掣般朝$n" HIC "飞去！\n" NOR;
  else msg += HIC "顿时半空乌云密布，一道圆柱粗细的怒雷呼啸而已，直扑$n" HIC "！\n" NOR;
  message_vision(msg, me, target);
  msg = HIR "$n" HIR "闪避不及，给打了个正着，顿时血光飞溅！\n" NOR;
  message_combatd(msg, me, target);
  damage = target->receive_damage("kee", damage, me, TYPE_CAST);
  if (damage > 0) {
    COMBAT_D->report_status(target);
    if (COMBAT_D->query_message_type(me, target) >= 2)
      message_vision("结果对$N造成了" HIR + damage + NOR "点气血减少。\n", target);
  }
  return 1;
}
