//飛廉，亦作蜚廉，是中國神話中的神獸，文獻稱飛廉是鳥身鹿頭或者鳥頭鹿身，秦人的先祖之一為飛廉。有說其為風伯。
#include <ansi.h>
#include <combat.h>

int hit(object me, object target) {
  int damage;
  string msg;
  if (!me || !target || !me->is_fighting(target)
    || me->is_die())
    return 0;
  if (random(5) == 3)
    return 0;
  damage = target->query("max_kee") / 10;
  msg = HIC "\n$N" HIC "扇动双翅，凌空飞起，俯身发出一身长吟！";
  if (random(2))
    msg += HIC "只见凭空忽现数道风刃，风驰电掣般朝$n" HIC "飞去！\n" NOR;
  else msg += HIC "顿时半空乌云密布，一道圆柱粗细的怒雷呼啸而已，直扑$n" HIC "！\n" NOR;
  message_vision(msg, me, target);
  msg = HIR "$n" HIR "闪避不及，给打了个正着，顿时血光飞溅！\n" NOR;
  message_combatd(msg, me, target);
  damage = target->receive_damage("kee", damage, me, TYPE_CAST);
  if (damage > 0) {
    COMBAT_D->report_status(target);
    if (COMBAT_D->query_message_type(me, target) >= 2)
      message_vision("结果对$N造成了" HIR + damage + NOR "点气血减少。\n", target);
  }
  return 1;
}
