#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "兵器库");
  set("channel_id", "傲来国兵器库");
  set("no_fight", 1);
  set("long", @LONG
这里是傲来国的兵器库，里面各种兵器(bingqi)：刀、枪、
剑、戟、斧、钺、毛、镰、鞭、钯、挝、锏、弓、弩、叉、
矛，件件俱备。整整齐齐的堆放着，几个威武的武士在这
里保守着。
LONG);
  set("item_desc", ([
    "bingqi": "各种各样的兵器，看来想拿走不方便，得捆(kun)一下才好拿。\n",
  ]));
  set("bingqi", 1 + random(5));
  setup();
}

int do_drop(string arg) {
  return ("/d/city/droproom.lpc")->do_main(arg);
}

void init() {
  add_action("do_drop", "drop");
  add_action("do_kun", "kun");
  add_action("do_ji", "ji");
}

void get_bingqi(object me) {
  remove_call_out("get_bingqi");
  if (!me || !living(me) || !present(me, this_object()))
    return;
  if (me->query("dntg/donghai") != "aolai")
    return;
  message_vision(HIY "捆了半响，$N" HIY "将兵器馆武库中那些器械，刀枪剑戟，斧钺毛镰，鞭钯挝简，弓弩叉矛尽数搬个罄净。\n" NOR, me);
  message_vision(CYN "$N" CYN "说道：哈哈，顺手牵羊，反手牵猪，这就回山将兵器给崩将军拾掇拾掇，看看他对「兵器」一事可还满意。\n" NOR, me);
  me->set("dntg/donghai", "wubingqi");
  me->delete_temp("dntg/donghai/aolai_bingqi");
}

int do_kun(string arg) {
  object npc, me = this_player();

  if (query("bingqi") <= 0)
    return notify_fail("这里已经给搬空了。\n");
  if (me->query("dntg/donghai") == "sea")
    return notify_fail(CYN "你说道：哈哈，顺手牵羊，反手牵猪，这就回山将兵器给崩将军拾掇拾掇，看看他对「兵器」一事可还满意。\n" NOR);
  if (me->query("dntg/donghai") != "aolai")
    return notify_fail("没事你跑这里来捆什么武器？南城客栈的北面有新手兵器赠送的。\n");
  if (!arg || (arg != "bingqi"))
    return notify_fail("你要捆什么？\n");
  if (objectp(npc = present("pian jiang", environment(me)))
    && !userp(npc))
    return notify_fail("偏将大喝道：敢动我国兵器库里的东西，反了不成？\n", me);
  if (me->is_busy())
    return notify_fail("你正在忙着呢。\n");
  if (me->query("kee") < 150) {
    me->start_busy(3);
    me->add_temp("dntg/donghai/aolai_bingqi", -random(10));
    return notify_fail("你现在体力不支。\n");
  }
  me->receive_damage("kee", 100, me);
  me->receive_wound("kee", 5 + random(15), me);
  message_vision(HIC "$N" HIC "急急忙忙收拾起一堆兵器，捆了捆，背了起来，又撒了一些。\n" NOR, me);
  me->add_temp("dntg/donghai/aolai_bingqi", (1 + random(3)));
  add("bingqi", -1);
  if (query("bingqi") <= 0) {
    message_vision(HIR "$N" HIR "干劲十足，将此处的兵器尽数搬个罄净。\n" NOR, me);
    set("long", @LONG
这里是傲来国的兵器库，不知是谁将这里的兵器搬了个一干二净，放眼看去，兵器库内空空荡荡。
LONG);
    return 1;
  }
  me->start_busy(5, 5);
  if (random(me->query_temp("dntg/donghai/aolai_bingqi")) > 6)
    call_out("get_bingqi", 2 + random(3), me);
  return 1;
}

void away(object me) {
  int f = 0;
  string str;
  object jiang;
  remove_call_out("away");
  if (!me || !living(me)
    || !present(me, this_object()))
    return;

  message_vision(HIY "\n只见一阵狂风，飞沙走石，好惊人也---\n" NOR, me);
  if (random(2))
    message_vision(HIY "	炮云起处荡乾坤，黑雾阴霾大地昏。
	江海波翻鱼蟹怕，山林树折虎狼奔。\n\n" NOR, me);
  else if (random(2))
    message_vision(HIY "	诸般买卖无商旅，各样生涯不见人。
	殿上君王归内院，阶前文武转衙门。\n\n" NOR, me);
  else message_vision(HIY "	千秋宝座都吹倒，五凤高楼幌动根。\n\n" NOR, me);

  if (objectp(jiang = present("pian jiang", this_object()))
    && !userp(jiang)) {
    f++;
    jiang->move("/d/maze/dntg-aolai-bingqi/empty");
    REMOVE_D->add_obj(jiang, 3);
  }
  if (objectp(jiang = present("pian jiang", this_object()))
    && !userp(jiang)) {
    f++;
    jiang->move("/d/maze/dntg-aolai-bingqi/empty");
    REMOVE_D->add_obj(jiang, 3);
  }
  if (f > 1)
    str = "几个";
  else str = "";
  message_vision(HIB "\n只见一股狂风刮过，吹得人们都挣不开眼，" + str + "偏将哭嚎着跑了出去。\n\n" NOR, me);
}

int do_ji(string arg) {
  object zhu, jiang, me = this_player();

  if (!arg)
    return err_msg("你想祭什么？\n");

  if (!objectp(zhu = present(arg, me)))
    return err_msg("你身上没有" + arg + "。\n");
  if (!zhu->is_5zhu() || !zhu->query("cast_dir")
    || zhu->query("cast_dir") != "fenglingzhu")
    return err_msg("兵器库内还是小心点好，免得惊动了傲来国兵将。\n");
  if (me->is_busy())
    return err_msg("你现在正忙着呢。\n");
  if (!objectp(jiang = present("pian jiang", this_object()))
    || userp(jiang))
    return err_msg("兵器库内空无一人，放胆施为吧。\n");
  if (me->query("mana") + random(500) < 1000) {
    me->start_busy(1 + random(2));
    return err_msg(HIC "你拿出风灵珠，大喝一声：“风来！”\n但什么也没有发生。”\n" NOR);
  }

  message_vision(HIC "$N" HIC "拿出风灵珠，大喝一声：“风来！”\n" NOR, me);
  remove_call_out("away");
  me->start_busy(3);
  call_out("away", 2 + random(2), me);
  return 1;
}
