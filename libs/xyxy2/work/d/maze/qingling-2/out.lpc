#include <ansi.h>
inherit "/d/maze/qingling-2/room.lpc";

void create() {
  set("short", "始皇陵三层入口");
  set("long", @LONG
这里便是三层的入口，四周笼罩在一片黑暗之中。隐约之中一丝丝血腥味传到你的鼻中。
四周一片寂静，叫人不由心生警惕。
    迎面是一个黑幽幽的青铜巨棺(guan)。
LONG);
  set("virtual_room", 1);
  set("exits", ([
    "down": __FILE__,
    "out": "/d/eastway/shihuang",
  ]));
  set("alternative_die", 1);
  set("item_desc", ([
    "down": "下面黑布隆冬的，你看不清楚。\n",
    "guan": "一具青铜巨棺，上面锈迹斑斑，贴着一张黄符纸(seal)。\n",
    "seal": "一张黄符纸，已经有些岁月了，上面的朱红已快消逝不见。最好还是不要揭(jie)开它。\n",
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  if (dir == "out" && !userp(who)) return 0;
  if (dir == "down") {
    if (!userp(who))
      return 0;
    if (who->query_level() < 50)
      return notify_fail("太危险了，你下去就是「肉包子打狗，有去无回」！\n");
    return notify_fail("尚未开放。\n");
  }
  return ::valid_leave(who, dir);
}

void init() {
  ::init();
  add_action("do_jie", "jie");
}

int do_jie(string arg) {
  object guai;
  if (!arg || arg != "seal")
    return notify_fail("你要揭什么？\n");
  message_vision(HIC "$N" HIC "上前一步，将铜棺上的符纸揭在一旁。\n" NOR, this_player());
  if (time() < this_player()->query("maze/qinling2_boss") + 3600
    || query("pushed")) {
    message_vision(HIR "\n结果什么反应也没有，大家都松了一口气。\n" NOR, this_player());
    return 1;
  }
  guai = new("/d/maze/qingling-2/npc/boss");
  if (guai->move(this_object())) {
    set("pushed", 1);
    message_vision(HIB "\n四下里顿时鬼哭狼嚎，一股股浓烟从棺材中涌出，浓烟中传出一阵嘿嘿的笑声！\n" NOR, this_player());
    guai->kill_ob(this_player());
    this_player()->fight_ob(guai);
  } else {
    message_vision(HIR "\n结果什么反应也没有，大家都松了一口气。\n" NOR, this_player());
    if (guai) destruct(guai);
  }
  return 1;
}
