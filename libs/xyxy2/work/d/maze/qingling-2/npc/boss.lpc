}

string short()
{
        string str = ::short();
        if( !query("my_type") )
                return str;
        return str+NOR"["+query("my_type")+NOR"]";
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void reward_player(object who,object pl)
{
        string arg,file,*dir,*env,color;
        object ob,weapon;
        int i,succ,k;
        
        if( !pl || !living(pl) || time()<pl->query("maze/last_QLboss2")+3600 )
                return;
        if( pl->query_level()>49 || pl->query_level()<40 )
        {
                if( random(100)>10 && !wizardp(pl) )
                        return;
        }               
        arg = "";
        succ = pl->query_kar();
        if( who==pl )
                succ = succ*2;
        dir = ({
                "hand","neck","ring","shield","waist","wrists",
                "armor","cloth","kui","pifeng","shoes",
        });
        i = random(2)+1;
        if( who==pl )
                i+= 1;
        if( !arrayp(env=pl->query_temp("maze/equip_color")) )
                env = 0;
        while(i--)
        {
                file = dir[random(sizeof(dir))];
                if( file )
                {
                        dir-=({file});
                        ob = new("/d/obj/narmor/"+file);
                        ob->set("from","【始皇陵二层副本】");
                        set("env/test","HIM");
                        ob->init_armor(this_object());
                        if( stringp(color=ob->query("armor_color")) )
                        {
                                if( env && member_array(color,env)==-1 )
                                {
                                        tell_object(pl,HIY"【副本】始皇陵二层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                                        destruct(ob);
                                        continue;
                                }
                        }
                        if( !ob->move(pl) )
                        {
                                destruct(ob);
                                tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
                        }
                        else    
                        {
                                tell_object(pl,HIY"【副本】始皇陵二层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                                arg+= obj_name(ob);
                                if( i!=0 && arg!="" )
                                        arg+= "、";
                        }
                }
        }
        
        dir = ({
                "axe","blade","blade","hammer","mace","spear",
                "staff","stick","sword","unarmed","whip","fork",
        });
        file = dir[random(sizeof(dir))];
        file = "/d/obj/nweapon/"+file;
	ob = new(file);
        ob->set("from","【始皇陵二层副本】");
        set("env/test","HIM");
        ob->init_weapon(this_object());
        if( stringp(color=ob->query("weapon_color"))
         && env && member_array(color,env)==-1 )
	{
        	tell_object(pl,HIY"【副本】始皇陵二层：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                destruct(ob);
	}
        else if( !ob->move(pl) )
        {
        	destruct(ob);
                tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
	}
        else    
        {
        	tell_object(pl,HIY"【副本】始皇陵二层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
        	if( arg!="" )
        		arg+= "、";
		arg+= obj_name(ob);
        }
        
        if( random(succ)>8 )
        {
                file = sprintf("/d/maze/qingling-2/obj/%s_sj",({"armor","weapon"})[random(2)]);
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
                }
                else    
                {
                        tell_object(pl,HIY"【副本】始皇陵二层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
			if( arg!="" )
        			arg+= "、";
			arg+= obj_name(ob);
                }
        }

        if( random(succ)>10 )
        {
                file = "/d/maze/qingling-2/obj/change";
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
                }
                else    
                {
                        tell_object(pl,HIY"【副本】始皇陵二层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
        			arg+= "、";
			arg+= obj_name(ob);
                }
        }        
        
        if( random(succ)>5 )
        {
                file = ("/d/maze/qingling-2/obj/life");
                ob = new(file);
                ob->set("owner_id",pl->query("id"));
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
                }
                else    
                {
                        tell_object(pl,HIY"【副本】始皇陵二层：你得到了 "HIG+obj_name(ob)+HIY" 。\n"NOR);
                        if( arg!="" )
        			arg+= "、";
			arg+= obj_name(ob);
                }
        }
        i = random(3)+1;
        k = 0;
        while(i--)
        {
                if( pl->query_level()-this_object()->query_level()>=11
                 || pl->query_level()-this_object()->query_level()<=-11 )
                {
                        if( random(100)!=50 )
                                continue;
                }               
                ob = new("/d/maze/qingling-2/obj/bangding.lpc");
                if( !ob->move(pl) )
                {
                        destruct(ob);
                        tell_object(pl,HIR"【副本】始皇陵二层：你的背包满了。\n"NOR);
                        continue;
                }
                else    tell_object(pl,HIY"【副本】始皇陵二层：你得到了一块"HIG"绑定用的灵石"HIY"。\n"NOR);
                k++;
        }
        if( k>0 )
        {
        	if( arg!="" )
			arg+= "、";
		arg+= chinese_number(k)+"块绑定石";
        }
        if( objectp(pl->query_leader()) && arg!="" )
                pl->team_talk(pl->name(1)+"得到了"+arg+HIW"。"NOR);
        pl->set("maze/last_QLboss2",time());
}

void reward_ob(object who)
{
        object leader,*t,*py;
        int i;
	string str;
	
        if( !who || !userp(who) || !present(who,environment()) 
         || !who->query_temp("maze/qinling2") )
        {
                message_vision (HIR"\n$N"HIR"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"枯骨"NOR HIR"。\n\n"NOR,this_object());
                destruct(this_object());
                return;
        }
        set_temp("weapon_level",49);
        set_temp("armor_level",49);
        message_vision (HIC"\n$N"HIC"「啪」的一声倒在地上，挣扎着抽动了几下就化成了一堆"NOR YEL"枯骨"NOR HIC"。\n\n"NOR,this_object());
	if( stringp(str=query("my_type")) && strlen(str)>2 )
	{	
		str = COLOR_D->clean_color(str);
		switch(str)
		{
			case "死锋" : hurt_env("combat");break;
			case "死毒" : hurt_env("du");break;
			case "死幻" : hurt_env("hl");break;
        	}
        }         
//	if( stringp(str=query_hurt_msg()) && strlen(str)>4 )
//		message_vision(str,this_object());
        py = ({});
        if( !objectp(leader=who->query_leader()) )
        	py = ({who});
        else	
        {
        	if( !pointerp(t=leader->query_team()) )
        		py = ({who});
        	else
        	{
        		for(i=0;i<sizeof(t);i++)
        		{
        			if( t[i] && living(t[i]) && present(t[i],environment()) )
        				py+= ({t[i]});
        		}
        	}	
        }
        for(i=0;i<sizeof(py);i++)	
        	reward_player(who,py[i]);
	if( sizeof(py)>1 && objectp(leader) )
		CHANNEL_D->do_channel(this_object(),"rumor","听说"+leader->name(1)+HIM"带着一干人等在始皇陵二层除掉了"HIR"血骷髅"HIM"！"NOR);
	else	CHANNEL_D->do_channel(this_object(),"rumor","听说"+who->name(1)+HIM"单枪匹马在始皇陵二层除掉了"HIR"血骷髅"HIM"！"NOR);	
        destruct(this_object());	
}

int is_boss(){return 1;}

int accept_fight(object who)
{
        tell_object(who,HIC"骷髅一动不动，什么反应也没有。\n"NOR);
        return 0;
}

void kill_ob(object who)
{
        if( !this_object()->is_fihgting() )
        {
                powerup(0,1);
                stop_busy(100);
        }
        this_object()->set_follow(who);
        ::kill_ob(who);
}

int is_pet(){return 1;}

varargs int receive_damage(string type, int damage, object who,mixed attack_type)
{
	string str,id;
	int p;
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_damage(type,damage,who,attack_type);
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	//damage = ::receive_damage(type,damage,who,attack_type);	
	return ::receive_damage(type,damage,who,attack_type);	
/*	if( type=="kee" )
                p = damage*100/(this_object()->query("eff_kee")+1);
        else    p = damage*100/(this_object()->query("eff_sen")+1);
	if( p<1 )
		return damage;
	id = who->query("id");
	if( !Hurt || !mapp(Hurt) )
		Hurt = ([id : p ]);
	else if( undefinedp(Hurt[id]) )
		Hurt[id] = p;
	else	Hurt[id]+= p;
	return damage;*/
}			

varargs int receive_wound(string type, int damage, object who,mixed attack_type)
{
	string id,str;
	int p;
	if( !who || who==this_object() || !objectp(who) || damage<10 )
		return ::receive_wound(type,damage,who,attack_type);
	if(objectp(who->query_temp("invoker")))
		who=who->query_temp("invoker");
	if( !who || who==this_object() || !objectp(who) )
		return ::receive_wound(type,damage,who,attack_type);	
	
	if( stringp(str=query("my_type")) 
	 && strlen(str)>2 )
	{
		str = COLOR_D->clean_color(str);
		if( str=="厚土" && (attack_type!=TYPE_CAST&&attack_type!=TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="驭法" && (attack_type==TYPE_CAST||attack_type==TYPE_CAST_2) )
        		damage = 0;
        	else if( str=="轻灵" && this_object()->is_busy() )
        		damage = 0;
	}
	return ::receive_wound(type,damage,who,attack_type);/*
	if( damage<=0 )
		return 0;
	if( type=="kee" )
                p = damage*100/(this_object()->query_maxkee()+1);
        else    p = damage*100/(this_object()->query_maxsen()+1);
	
	if( p<1 )
		return damage;
	
	id = who->query("id");
	if( !Hurt || !mapp(Hurt) )
		Hurt = ([id : p ]);
	else if( undefinedp(Hurt[id]) )
		Hurt[id] = p;
	else	Hurt[id]+= p;
	return damage;*/
}

string long()
{
	string str,long = ::long();
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
	 	return long;
		 	
	str = COLOR_D->clean_color(str);	
	switch(str)	
	{
		case "厚土" : long+= HIC"怪物特效：物理免疫。\n"NOR;break;
		case "驭法" : long+= HIC"怪物特效：法术免疫。\n"NOR;break;
		case "轻灵" : long+= HIC"怪物特效：busy状态下伤害降低。\n"NOR;break;
		case "彪悍" : long+= HIC"怪物特效：物理伤害提高100%。\n"NOR;break;
		case "通灵" : long+= HIC"怪物特效：法术伤害提高100%。\n"NOR;break;
		case "吸血" : long+= HIC"怪物特效：击中回复自己1.25%的气血值。\n"NOR;break;
		case "偷心" : long+= HIC"怪物特效：击中回复自己3%的法力值。\n"NOR;break;
		case "反戈" : long+= HIC"怪物特效：受到伤害的50%反弹给攻击者。\n"NOR;break;
		case "登峰" : long+= HIC"怪物特效：物理命中提高100%。\n"NOR;break;
		case "震古" : long+= HIC"怪物特效：法术命中提高100%。\n"NOR;break;
		case "死锋" : long+= HIC"怪物特效：死亡时释放物理伤害。\n"NOR;break;
		case "死毒" : long+= HIC"怪物特效：死亡时释放毒伤害。\n"NOR;break;
		case "死幻" : long+= HIC"怪物特效：死亡时释放混乱伤害。\n"NOR;break;
		case "换日" : long+= HIC"怪物特效：击中回复自己3%的内力值。\n"NOR;break;
	}
	return long;	
}

mixed hit_ob(object me, object who,int damage,mixed attack_type)
{
	string str;
	if( !stringp(str=query("my_type")) 
	 || strlen(str)<2 )
		return 0;
	if( !living(me) || !who || !me->is_fighting(who) || damage<=0 )
		return 0;
	str = COLOR_D->clean_color(str);	
	switch(str)
	{
		case "彪悍" : //物理伤害提高100%
			if( attack_type==TYPE_COMBAT || attack_type==TYPE_PERFORM || attack_type==TYPE_QUICK )
				return damage;
			break;	
		case "通灵" : //法术伤害提高100%
			if( attack_type==TYPE_CAST || attack_type==TYPE_CAST_2 )
				return damage;
			break;		
		case "吸血" : //击中回复自己1%的气血值
			me->receive_heal("kee",me->query_maxkee()/80+1);
			me->receive_curing("kee",me->query_maxkee()/80+1);
			return RED"$N"RED"开始疯狂的吸血！\n"NOR;
		case "偷心" : //击中回复自己2%的法力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/30+1);
				return HIC"$N"HIC"只觉得自己的法力越来越充沛了。\n"NOR;
			}
			break;
		case "换日" : //击中回复自己2%的内力值
			if( me->query("mana")<me->query_maxmana()*2 )
			{
				me->add("mana",me->query_maxmana()/50+1);
				return HIC"$N"HIC"只觉得自己的内力越来越充沛了。\n"NOR;
			}
			break;
			
	}
	return 0;		
}

int is_maze(){return 1;}
