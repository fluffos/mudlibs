#include <ansi.h>
inherit F_VENDOR_SALE;

void create() {
  set_name("李淳风", ({ "li chunfeng", "li" }));
  set("age", 28);
  set_level(35);
  set("gender", "男性");
  set("long", "清虚观雾渊道长的高徒，奉师命在此镇压尸气，你要是有什么需求，可以找他。\n");
  set("attitude", "friendly");
  set("per", 55);
  set("shen_type", 1);
  set("vendor_goods", ([
    "yao": "/d/obj/drug/jinchuang",
    "dan": "/d/obj/drug/hunyuandan",
  ]));
  set("inquiry", ([
    "拣取": "二层深处鬼魅横行，不过机会与风险并存，如果你对打到的装备有品质要求，可以在我这里记录(mark)一下。\n",
  ]));
  set("env/test", "HIC");
  setup();
  carry_object(0, "cloth", 1)->wear();
  carry_object(0, "sword", 1)->wear();
}

void init() {
  ::init();
  add_action("do_mark", "mark");
}

int do_mark(string arg) {
  int i;
  string str, *tmp, *temp;
  mapping color = ([
    "HIM": "紫",
    "HIR": "红",
    "HIC": "青",
    "HIB": "蓝",
    "HIY": "金",
  ]);
  if (!arg)
    return notify_fail(name() + "问道：你想记录哪些颜色，多种颜色可以用" HIY " , " NOR "分开。\n示例：mark HIC,HIM");
  arg = replace_string(arg, "，", ",");
  if (strsrch(arg, ",") == -1) {
    if (undefinedp(color[arg]))
      return notify_fail(name() + "说道：" + arg + " 这样颜色可没有。\n");
    else tmp = ({ arg });
  } else {
    temp = explode(arg, ",");
    tmp = ({});
    for (i = 0; i < sizeof(temp); i++) {
      if (undefinedp(color[temp[i]]))
        return notify_fail(name() + "说道：" + temp[i] + " 这样颜色可没有。\n");
      tmp += ({ temp[i] });
    }
  }
  str = "";
  for (i = 0; i < sizeof(tmp); i++) {
    str += color[tmp[i]] + "色";
    if (i < sizeof(tmp) - 1)
      str += "、";
  }
  this_player()->set_temp("maze/equip_color", tmp);
  write(HIC + name() + HIC "朝你点了点头，念了几句咒语朝你一指。\n" NOR);
  write(CYN + name() + CYN "说道：好了，在二层磨练，除了" + str + "，其他品质的装备会自动清除。\n" NOR);
  return 1;
}
