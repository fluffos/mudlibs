#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "树林");
  set("channel_id", "雷灵珠副本");
  set("long", @LONG
这是一片茂密的树林，好象被人设计了一种阵，一走进来，你仿佛迷失了方向。
LONG);
  set("alternative_die", 1);
  setup();
}

int alternative_die(object who) {
  object target;
  string file, msg;
  if (!who)
    return 1;
  if (!userp(who)) {
    target = who->query_temp("last_damage_from");
    who->clear_condition();
    if (target && present(target, environment(who))) {
      who->reward_ob(target);
      return 0;
    } else {
      message_vision(HIR "$N" HIR "脸色大变。\n" NOR, who);
      return 1;
    }
  }

  tell_object(who, CYN "辛环看着你，捧腹大笑起来。\n" NOR);
  who->powerup(0, 1);
  file = "/d/changan/eside5";
  who->move(file, 2);
  who->set("maze/lingzhu-lei", time());
  who->delete_temp("maze");
  message_vision("\n" HIC "辛环拉着$N" HIC "的手，从小树林中走了出来。\n" NOR, who);
  message_vision(CYN "辛环不知道想到了什么高兴的事，一个人不住地傻笑。\n" NOR, who);
  tell_object(who, CYN "辛环说道：" + RANK_D->query_respect(who) + "，还要多练练啊。\n" NOR);
  message_vision(CYN "辛环淡淡地道：“我．．．我等了三十年，仍无敌手？！”\n" NOR, who);
  MAZE_D->restore_status(who);
  return 0;
}

int do_drop(string arg) {
  return ("/d/city/droproom.lpc")->do_main(arg);
}

int do_cmds(string arg) {
  string *nocmds, verb = query_verb();
  nocmds = ({
    "recall", "move", "maphere", "map", "find",
    "follow", "gen",
  });
  if (member_array(verb, nocmds) == -1)
    return 0;
  write("ok\n");
  return 1;
}

void init() {
  if (userp(this_player())) {
    add_action("do_cmds", "", 1);
    add_action("do_drop", "drop");
  }
}

void valid_move(object who) {
  object env;
  if (!who || who->query_temp("pending/valid_move")
    || !environment(who))
    return;
  env = environment(who);
  if (env->query("virtual_room"))
    return;
  who->set_temp("pending/valid_move", 1);
  MAZE_D->restore_status(who);
}
