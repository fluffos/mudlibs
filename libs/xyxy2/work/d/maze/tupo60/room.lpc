#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山脚");
  set("channel_id", "再入仙山");
  set("long", @LONG
仰望天空，山势压顶，天边的红霞映透了整个山林，呼啸的穿山风刮个不停。你不
禁有些惧意。前方是一条上山小路。
LONG);
  set("exits", ([
    "up": __FILE__,
  ]));
  set("item_desc", ([
    "up": "
山间平地
    你走在山间平地上。林中冷风轻吹门响。很失意的感觉。

    这里明显的出口是 " HIG "north" NOR " 和 " HIG "south。\n" NOR,
  ]));
  setup();
}

string bagua() {
  return "八卦阵内\n    八卦阵内风云变幻，难辨东西。\n\n";
}

void remove_all_rooms(mixed *rooms) {
  int i;
  remove_call_out("remove_all_rooms");
  if (query("num") > 0)
    return;
  for (i = 0; i < sizeof(rooms); i++)
    destruct(rooms[i]);
}

mixed *create_maze(object who) {
  mixed *rooms;
  int i;
  if (!who)
    return 0;
  rooms = allocate(8);
  for (i = 0; i < 8; i++) {
    rooms[i] = new(__FILE__);
    rooms[i]->set("short", chinese_number(i + 1) + "层八卦阵台");
    if (i < 7)
      rooms[i]->set("long", "八卦阵内风云变幻，难辨东西。\n");
    else rooms[i]->set("long", "八卦阵内风云变幻，难辨东西。\n    台子的正中摆放着一枚霞光四射的仙丹(dan)，上面光华游走，浑然不似凡物。\n\n");
    rooms[i]->set("virtual_room", 1);
    rooms[i]->set("num", i + 1);
    rooms[i]->set("exits", ([
      "north": rooms[i],
      "south": rooms[i],
      "west": rooms[i],
      "east": rooms[i],
      "northeast": rooms[i],
      "northwest": rooms[i],
      "southeast": rooms[i],
      "southwest": rooms[i],
    ]));
    rooms[i]->set("item_desc", ([
      "north": (: bagua :),
      "south": (: bagua :),
      "west": (: bagua :),
      "east": (: bagua :),
      "northeast": (: bagua :),
      "northwest": (: bagua :),
      "southeast": (: bagua :),
      "southwest": (: bagua :),
    ]));
    if (i == 7)
      rooms[i]->set("item_desc/dan", "一枚霞光四射的仙丹，上面符文游走，宛如活物，看来不是凡物。\n");
    rooms[i]->set(
      "bagua_sheng",
      ({
        "north",
        "south",
        "west",
        "east",
        "northeast",
        "northwest",
        "southwest",
        "southeast"
      })[random(8)]
    );
  }
  return rooms;
}

int valid_leave(object who, string dir) {
  mixed *rooms, *exit;
  object room, guai;
  mapping go;
  string name, str, msg, men, bg;
  int x, y, z, num;

  if (!userp(who))
    return 0;
  if (!wizardp(who) && (who->query_level() < 59
    || who->query("combat_exp") < 529000000))
    return ::valid_leave(who, dir);
  if (dir == "up") {
    if (query("num") > 0)
      return ::valid_leave(who, dir);
    if (pointerp(rooms = who->query_temp("now_bagua"))
      && sizeof(rooms) > 1)
      ;
    else {
      rooms = create_maze(who);
      who->set_temp("now_bagua", rooms);
      who->set_temp("last_bagua_time", time());
    }
    if (!stringp(name = who->query("mark/20name")))
      name = "神秘女子";
    else name += "山人";
    str = who->level_name(1);
    tell_object(who, HIC "\n半空传来一阵轻笑，却有吴侬细语在耳边传来：与君有缘，上次一别，君进度风驰，如此某之心愿不日可达。\n" NOR);
    tell_object(
      who,
      HBBLU + name + "告诉你：汝虽修为一日千里，已达" + str + "，然登天之路不进则退。某再助君一臂之力，此间有昔日上古所存八卦之阵，阵内有仙丹，食之可提升境界。\n" NOR
    );
    tell_object(who, "\n半空卷下一道祥云，裹起你风驰电掣，瞬间便来到了八卦阵前。\n\n");
    tell_object(who, HIR "努力！你只有三十分钟的时间！\n" NOR);
    who->move(rooms[0]);
    remove_call_out("remove_all_rooms");
    call_out("remove_all_rooms", 1800, rooms);
    return 2;
  }
  if (query("num") <= 0
    || !query("exits/" + dir))
    return ::valid_leave(who, dir);

  if (!stringp(str = query("bagua_sheng")))
    return ::valid_leave(who, dir);

  if (!pointerp(rooms = who->query_temp("now_bagua"))
    && sizeof(rooms) < 1)
    return notify_fail("八卦阵列丢失。\n");

  num = query("num");
  if (num == 8)
    return notify_fail("杀死此间的守护兽，即可得到灵药。\n");

  exit = ({ "生_艮", "伤_震", "杜_巽", "景_离", "死_坤", "惊_兑", "开_乾", "休_坎", });
  go = ([
    "north": 1,
    "south": 5,
    "west": 7,
    "east": 3,
    "northeast": 2,
    "northwest": 8,
    "southeast": 4,
    "southwest": 6,
  ]);

  x = go[str];
  y = go[dir];
  z = y - x;
  if (z < 0)
    z = 8 + z;
  msg = exit[z];
  num = query("num");
  if (str == dir) {
    message_vision(
      HBBLU HIY "【奇门八卦】$N" HBBLU HIY "勘破天机，成功找到" HIC "「艮方生门」" HIY "，顺利进入下一层。" NOR "\n",
      who
    );
    if (num == 7) {
      guai = new("/d/maze/tupo60/npc/shou");
      guai->move(rooms[num]);
      guai->set_owner(who);
    }
    who->move(rooms[num]);
    return 2;
  }
  sscanf(msg, "%s_%s", men, bg);
  if (num == 1)
    return notify_fail("此方向为" + "「" + bg + "方" + men + "门」，还是另找「生门」。\n");

  num -= z;
  if (num < 0)
    num = 0;
  message_vision(
    HBBLU HIY "【奇门八卦】$N" HBBLU HIY "误入" HIC "「" + bg + "方" + men + "门」" HIY "，倒退至" + chinese_number(num + 1) + "层。" NOR "\n",
    who
  );
  who->move(rooms[num]);
  return 2;
}

void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  int t;
  string str;
  object me = this_player();
  if (arg)
    return 0;
  if (query("num") == 0)
    return 0;
  t = 1800 - (time() - me->query_temp("last_bagua_time"));
  str = "\n" HIR "\t剩余时间：" + CHINESE_D->chtime(t) + NOR "\n\n";
  set("long2", str);
  return 0;
}
