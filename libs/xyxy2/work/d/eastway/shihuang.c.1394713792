#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "始皇陵");
  set ("long", @LONG

这是座落在官道以东的一个大丘陵，呈覆斗型。站在丘陵
上极目远眺，不禁心旷神怡。旁边有一座高大的石碑：
“秦始皇陵”。

LONG);

  set("exits", ([
        "east"       : __DIR__"bingma",
        "west"       : __DIR__"guandao3",
      ]));
  set("objects", ([ /* sizeof() == 2 */
         __DIR__"npc/wujiang" : 2,
         __DIR__"npc/bing" : 3,
      ]));

  set("outdoors", __DIR__);

  setup();
}

int valid_leave(object who,string dir)
{
	object leader,*t;
	int i;
	
        if( dir=="east" && userp(who) )
        {
        	if( !who->query_temp("maze/qingling_ask") 
        	 || time()<who->query("maze/qingling")+1800 )
        		return ::valid_leave(who,dir);
		if( objectp(leader=who->query_leader()) )
		{
			if( pointerp(t=leader->query_team()) )
			{
				if( sizeof(t)<2 )
					who->dismiss_team();
				else if( who!=leader )
					return notify_fail( HIR"【副本】始皇陵：需要队长"HIC+leader->query("name")+HIR"触发副本。\n"NOR);
				else if( !leader->query_temp("maze/qingling_ask") )
				 	return notify_fail( HIR"【副本】始皇陵：队长"HIC+leader->query("name")+HIR"尚未领取任务。\n"NOR);	
				else
				{
					for(i=0;i<sizeof(t);i++)
					{
						if( t[i]->query_level()>=(leader->query_level()/10+1)*10 )
							return notify_fail( HIR"【副本】始皇陵："HIC+t[i]->query("name")+HIR"与队长相比，等级过高。\n"NOR);
						if( t[i]->query_level()<leader->query_level()/10*10 )
							return notify_fail( HIR"【副本】始皇陵："HIC+t[i]->query("name")+HIR"与队长相比，等级过低。\n"NOR);
						if( time()<t[i]->query("maze/qingling")+1800 )
						{
							if( t[i]!=who )
								return notify_fail( HIR"【副本】始皇陵："HIC+t[i]->query("name")+HIR"暂时不能进入始皇陵。\n"NOR);
							else	return notify_fail( HIR"【副本】始皇陵："HIC"你"HIR"暂时不能进入始皇陵。\n"NOR);
						}
					}									
				}	
			}
		}

                who->delete_temp("maze");
                if( who->query_level()<40 )
                {
                	if( MAZE_D->enter_maze(who, "qingling-1") )
                	{
                        	who->set("maze/qingling",time());
                        	message_vision(HIC"\n$N"HIC"进入了始皇陵。\n"NOR,who);
                        	return 2;
                	}
                	else    return notify_fail("你有些踌躇不前。\n");
                }
                else if( who->query_level()<50 || wizardp(who) )
                {
                	if( MAZE_D->enter_maze(who, "qingling-2") )
                	{
                        	who->set("maze/qingling",time());
                        	who->set_temp("maze/qingling_ask",1);
                        	who->set_temp("maze/qinling2",1);
                        	message_vision(HIC"\n$N"HIC"进入了始皇陵二层。\n"NOR,who);
                        	return 2;
                	}
                	else    return notify_fail("你有些踌躇不前。\n");
                }	
                else	return notify_fail("始皇陵三层尚未开放。\n");
        }
        else    return ::valid_leave(who,dir);
}
