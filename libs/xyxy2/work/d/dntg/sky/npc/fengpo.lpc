#include <ansi.h>
inherit NPC;

void create() {
  set_name("风婆", ({ "feng po", "feng shen", "po" }));
  set("gender", "女性");
  set("age", 35);
  set("long", "    \n天宫中负责起风的天神，想要刮风下雨时，没有她\n的帮助是不行的。\n");
  set("attitude", "heroism");
  set("class", "xian");
  set_level(151);
  set("daoxing", 2200000);
  set("force_factor", 20);
  set("mana_factor", 130);
  set_skill("dodge", 1480);
  set_skill("moondance", 1380);
  set_skill("unarmed", 1500);
  set_skill("baihua-zhang", 1470);
  set_skill("parry", 1500);
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("parry", "baihua-zhang");
  set_skill("spells", 1500);
  set_skill("force", 1500);
  set("inquiry", ([
    "下雨": "想求雨，光我一个人可不够。",
    "rain": "想求雨，光我一个人可不够。",
    "起风": "巽二为风，其实依老婆子看，小范围的大风有风灵珠即可。",
    "刮风": "巽二为风，其实依老婆子看，小范围的大风有风灵珠即可。",
    "wind": "巽二为风，其实依老婆子看，小范围的大风有风灵珠即可。",
    "name": "我就是负责起风的风神。",
    "here": "这就是天宫呀。",
  ]));
  set_temp("armor_level", 50);
  set_temp("weapon_level", 50);
  setup();
  carry_object(0, "cloth", random(5))->wear();
  carry_object(0, "shoes", random(5))->wear();
  add_money("silver", 10);
}
