#include <ansi.h>
inherit ROOM;

void setup() {
  ::setup();
  set("outdoors", 1);
  set("long2", "               " HBRED HIY "  " NOR REV HIY "    星光灿烂    " NOR HBRED "  " NOR "\n"
    "               " HBRED HIY "千" NOR "                " HBRED HIY "五" NOR "\n"
    "               " HBRED HIY "秋" NOR "                " HBRED HIY "洲" NOR "\n"
    "               " HBRED HIY "万" NOR "                " HBRED HIY "四" NOR "\n"
    "               " HBRED HIY "载" NOR "                " HBRED HIY "海" NOR "\n"
    "               " HBRED HIY "美" NOR "                " HBRED HIY "群" NOR "\n"
    "               " HBRED HIY "名" NOR "                " HBRED HIY "英" NOR "\n"
    "               " HBRED HIY "扬" NOR "                " HBRED HIY "会" NOR "\n"
    "               " HBRED HIY "  " NOR "                " HBRED HIY "  " NOR "\n");
  if (query("name"))
    set("short", query("name") + "宫");
  else set("short", "七大圣宫");
  set("alternative_die", 1);
  set("leitai", 1);
  set("no_bian", 1);
  set("no_chuqiao", 1);
  set("no_huicheng", 1);
  set("no_qiankun", 1);
}

int alternative_die(object who) {
  object target;
  string file, msg;
  if (!who)
    return 1;
  target = who->query_temp("last_damage_from");
  if (!target)
    return 1;
  if (!userp(who)) {
    if (!who->query("startroom")
      || who->query("startroom") != base_name(this_object()))
      return 1;
    /*死亡时NPC判断吧	
		 if( !target->query_temp("pending/7sheng")
		 || !query("name")
		 || target->query_temp("pending/7sheng")!=query("name") )
		 	return 1;
		*/
    who->PlayerWin(target);
    return 0;
  } else {
    if (!who->query_temp("pending/7sheng")
      || !query("name")
      || who->query_temp("pending/7sheng") != query("name"))
      return 1;
    if (!target->query("startroom")
      || target->query("startroom") != base_name(this_object())
      || userp(target))
      return 1;
    target->PlayerLose(who);
    return 0;
  }
}
