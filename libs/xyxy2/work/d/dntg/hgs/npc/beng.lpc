#include <ansi.h>
inherit SUPER_NPC;

mixed about_bingqi() {
  object me = this_player();
  if (me->query("dntg/huaguo") != "done")
    return "我们花果山正缺这玩艺，要能搞点来多好！";
  if (me->query("dntg/donghai") == "done")
    return "大王从傲来国治来的锋利器械，教演我等，守护山场，诚所谓保泰长久之机也。";
  if (me->query("dntg/donghai") == "sea")
    return "我们这铁板桥下，水通东海龙宫。大王若肯下去，寻着老龙王，问他要件什么兵器，却不趁心？";
  if (me->query("dntg/donghai") == "aolai")
    return "大王快去傲来国中置办些兵器，教演我等，守护山场，诚所谓保泰长久之机也。";
  if (me->query("dntg/donghai") == "wubingqi") {
    EMOTE_D->do_emote(this_object(), "great", geteuid(me), CYN, 0, 0, 0);
    message_vision(HIC "$N" HIC "将前使狂风、搬兵器一应事说了一遍。众猴称谢毕，都去抢刀夺剑，挝斧争枪，扯弓扳弩，吆吆喝喝，耍了开来。\n" NOR, me);
    message_vision(
      CYN "$N" CYN "说道：教军场上的兵器架上如今是十八般兵刃样样齐全，大王也取件称手的兵器(bingqi)，舞一上舞(wave)，让我等观上一观。\n" NOR,
      this_object()
    );
    return 1;
  }
  message_vision(
    CYN "$N" CYN "说道：自打大王灭了混世魔王，我等逐日操演武艺，教小猴砍竹为标，削木为刀，治旗幡，打哨子，一进一退，安营下寨，顽耍多时。\n" NOR,
    this_object()
  );
  EMOTE_D->do_emote(this_object(), "hmm", geteuid(me), CYN, 0, 0, 0);
  message_vision(
    CYN "$N" CYN "说道：我等在花果山恐作耍成真，或惊动人王，或有禽王、兽王认此犯头，说我们操兵造反，兴师来相杀，我等皆是竹竿木刀，如何对敌？须得锋利剑戟方可。如今奈何？\n" NOR,
    this_object()
  );
  EMOTE_D->do_emote(this_object(), "think", 0, CYN, 0, 0, 0);
  message_vision(HIY "$N" HIY "想起一事，不由高兴得抓耳挠腮，吱吱直叫。\n" NOR, this_object());
  me->set("dntg/donghai", "aolai");
  message_vision(
    CYN "$N" CYN "说道：花果山向东去有二百里水面，那厢乃傲来国界。满城中军民无数，必有金银铜铁等匠作。大王若去那里，或买或造些兵器，教演我等，守护山场，诚所谓保泰长久之机也。\n" NOR,
    this_object()
  );
  return 1;
}

void create() {
  object ob;
  set_name("崩将军", ({ "beng jiangjun", "beng", "monkey" }));
  set("title", "花果山大将");
  set("gender", "男性");
  set("age", 35);
  set("class", "yao");
  set("long", "一只成了精的通背猿。\n");
  set_level(79);
  set("任务", 1);

  set("attitude", "peaceful");
  set_skill("unarmed", 760);
  set_skill("dodge", 790);
  set_skill("parry", 760);
  set_skill("spells", 760);
  set_skill("blade", 760);
  set_skill("force", 760);
  set_skill("wuhu-blade", 760);
  set_skill("dragonforce", 760);
  set_skill("wuxing-quan", 760);
  set_skill("yaofa", 760);
  set_skill("literate", 500);
  set_skill("xiaoyaoyou", 790);

  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "wuxing-quan");
  map_skill("blade", "wuhu-blade");
  map_skill("parry", "wuhu-blade");
  map_skill("spells", "yaofa");
  map_skill("force", "dragonforce");

  set("env/test", "HIR");
  set("chat_chance", 3);
  set("inquiry", ([
    "大王": "嘿！我家大王就是花果山水帘洞洞主。\n",
    "weapon": (: about_bingqi :),
    "bingqi": (: about_bingqi :),
    "兵器": (: about_bingqi :),
  ]));

  set("chat_msg", ({
    "崩将军说道：要想守卫我花果山，就须操练兵马。\n",
    "崩将军自言自语的说：我等须得些锋利剑戟才能抵御来犯之敌。\n",
    "崩将军低头说道：到哪里才能搞些兵器来呢？\n",
  }));
  set("looking", HIB "尖嘴猴腮，宛如雷公" NOR "。");
  set("rank_info/pos_msg", NOR YEL "浑身上下沾满杂草" NOR "。\n");

  setup();
  ob = carry_object(0, "blade", 1);
  ob->set("weapon_title", "花果山");
  ob->wield();

  ob = carry_object(0, "armor", 1);
  ob->set("armor_title", "花果山");
  ob->wear();

  ob = carry_object(0, "cloth", 1);
  ob->set("armor_title", "花果山");
  ob->wear();

  ob = carry_object(0, "pifeng", 1);
  ob->set("armor_title", "花果山");
  ob->wear();

  ob = carry_object(0, "kui", 1);
  ob->set("armor_title", "花果山");
  ob->wear();

  ob = carry_object(0, "shoes", 1);
  ob->set("armor_title", "花果山");
  ob->wear();
  powerup(0, 1);
}

void init() {}

void kill_ob(object who) {
  remove_killer(who);
  who->remove_killer(this_object());
  message_vision(HIC "$N" HIC "朝$n" HIC "瞥了一眼：莫要扰我教授小猴们武艺。\n" NOR, this_object(), who);
  return;
}
