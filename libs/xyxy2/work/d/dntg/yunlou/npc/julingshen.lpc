#include <ansi.h> 
inherit NPC;

string MSG = NOR""
HIY" 1. "NOR"天宫贡献x20      兑换 "HIY"饕餮符x1    "HIR"说明："HIG"可以将装备属性转移(transfer)到同类型装备中去。
					    "HIM"注意：非绑定类装备可以被其他装备转移，但其本身
					    不能转移其他装备。
					    "HIR"85级以下的门派套装不能转移及被转移。"NOR"
					    "HIC"命令格式：transfer <被转移装备名> to <对象装备名>"NOR"
					    "HIR"注意：转移过程中，如果目标装备有同样的属性，那
					    转移的属性可能会有50%左右的损毁。\n"NOR                                                 
HIY" 2. "NOR"门派贡献x5千万   兑换 "HIW"天宫贡献x1  "HIR"说明："HIG"做人留一线，将来好想见。"NOR"\n\n";   
 
void create()
{
        set_name("巨灵神", ({ "juling shen", "shen", "juling" }) );
        set("gender", "男性" );
        set("long","托塔李天王帐下先锋大将，膀阔腰圆，力大无穷。\n"HIM"你可以在他这里兑换(huan)天宫贡献。"NOR"\n"+MSG);
        set("age",40);
        set_level(150);
	set("title", "先锋大将");
        set("per", 15);
	set("class", "xian");
	set("attitude", "heroism");
	set("force_factor", 60);
	set("mana_factor", 40);

        set("eff_dx", 400000);
        set("nkgain", 400);

	set_skill("unarmed",1250);
        set_skill("dodge",1250);
        set_skill("parry",1250);
	set_skill("axe", 1250);
	set_skill("force", 1250);
	set_skill("spells", 1250);
 	set_skill("changquan", 1250);
	set_skill("sanban-axe", 1250);
	set_skill("baguazhou", 1250);
	set_skill("moshenbu", 1250);
	set_skill("lengquan-force", 1250);
	map_skill("unarmed", "changquan");
	map_skill("force", "lengquan-force");
	map_skill("spells", "baguazhou");
	map_skill("axe", "sanban-axe");
	map_skill("parry", "sanban-axe");
	map_skill("dodge", "moshenbu");
	set_temp("armor_level",30+random(30));
	set_temp("weapon_level",50+random(30));
        setup();
        carry_object(0,"armor",1)->wear();
	carry_object(0,"axe",1)->wield();
}

void kill_ob(object who)
{
	all_inventory(environment())->remove_killer(this_object());
	remove_all_killer();
}

int accept_fight(object who){return 0;}

void die()
{
	powerup();
	all_inventory(environment())->remove_killer(this_object());
	remove_all_killer();
}

void unconcious(){die();}

void init()
{
	add_action("do_huan","huan");
}

int do_huan(string arg)
{
	int v;
	object ob,me = this_player();
	if( me->is_busy() )
		return err_msg("你现在正忙着呢。\n");
	if( !arg 
	 || sscanf(arg,"%d",v)!=1 )
		return err_msg(MSG+HIR"目前你只有两个选择(1|2)。"NOR"\n");
	switch(v)
	{
		case 1 :
			if( me->query("skyscore")<20 )
				return err_msg("你的天宫贡献不足20点。\n");
			ob = new("/d/obj/equip/equip_transfer");
			ob->set_amount(1);
			ob->set("owner_id",me->query("id"));
			if( !ob->move(me) )
			{
				REMOVE_D->add_obj(ob,1);
				return err_msg("你的背包满了。\n");
			}
			CHANNEL_D->do_channel(this_object(),"rumor","听说"+me->name()+HIM"得到了天宫至宝"HIY"饕餮符"HIM"！"NOR);
			me->add("skyscore",-20);
			write(HIR"【系统】你失去了20点天宫贡献。\n"HIY"【系统】你得到了1张饕餮符。"NOR"\n");
			me->save();
			me->start_busy(1);
			return 1;	
		case 2 :
			if( me->query("faith")<50000000 )
				return err_msg("你的门忠不足五千万。\n");
			me->add("faith",-50000000);
			me->add("skyscore",1);
			write(HIR"【系统】你失去了五千万门忠。\n"HIY"【系统】你得到了1点天宫贡献。"NOR"\n");
			me->save();
			me->start_busy(1);
			return 1;	
		default: return err_msg(MSG+HIR"目前你只有两个选择(1|2)。"NOR"\n");
	}	
}	
