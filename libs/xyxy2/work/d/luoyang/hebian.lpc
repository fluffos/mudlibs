// Cracked by 凌惊雪 12-12-2002
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "黄河边");
  set("long", @LONG
这里是黄河岸边。黄河流淌到这里，河床宽阔。黄色的河水在
静静地向东流去，使人忘记它发洪水时的狂威。

LONG);

  set("exits", ([
    "southwest": __DIR__ "gudao4",
    "east": __DIR__ "guandao3",
  ]));
  set("objects", ([
    __DIR__ "npc/wuzhu": 1,
  ]));
  set("outdoors", "luoyang");
  setup();
}

void init() {
  add_action("do_drop", "drop");
}

void check(object who, string name) {
  string *msg;
  remove_call_out("check");
  if (!who || !living(who) || !present(who, this_object()))
    return;
  if (random(3) != 0) {
    msg = ({
      "在水面上浮浮沉沉。\n",
      "人事不省，在水面上一起一浮。\n",
      "随着水波起起伏伏。\n",
      "在水中起伏不定。\n",
    });
    tell_room(this_object(), name + msg[random(sizeof(msg))]);
    call_out("check", 2 + random(3), who, name);
    return;
  }
  tell_room(this_object(), "水面上忽然出现一个巨大的漩涡，一下子将" + name + "吞噬了！\n");
  message_vision(
    HIC "$N" HIC "哈哈一笑：好个造化，来来来，让" + RANK_D->query_self_rude(who) + "看看到底是何方神圣？！\n" NOR,
    who
  );
  message_vision(HIR "$N" HIR "纵身跃进漩涡之中。\n" NOR, who);
  who->dismiss_team();
  who->delete_temp("maze");
  if (!MAZE_D->enter_maze(who, "lingzhu-shui")) {
    message("vision", "\n水花一响，" + who->name() + "又从水中跳了出来，闹了个浑身湿透，狼狈不堪。\n\n", this_object(), who);
    tell_object(who, "\n结果你在水中瞎扑腾了一通，一无所获，只得悻悻而回。\n\n");
    return;
  }
  who->set("maze/lingzhu-shui", time());
  tell_object(who, CYN "你跟随漩涡走向，来到了水底。\n" NOR);
  who->add("gin", -30);
  return;
}

int do_drop(string arg) {
  string name;
  object zhu, ob, me = this_player();

  if (me->is_busy())
    return 0;
  if (!arg || !objectp(ob = present(arg, me))
    || userp(ob) || !ob->is_character()
    || ob->query("no_drop")
    || me->query("gin") < 30
    || time() < me->query("maze/lingzhu-shui") + 1800)
    return 0;

  message_vision("$N将" + ob->name() + "「啪」的一声丢到了黄河里。\n", me);
  if (ob->query("gender") != "女性") {
    ob->move(this_object());
    destruct(ob);
    return err_msg("结果溅起了好大的水花。\n");
  }
  message_vision("“扑通”一声，" + ob->name() + "落在黄河水中，沉沉浮浮。\n", me);
  ob->move(this_object());
  name = ob->name();
  destruct(ob);
  if (objectp(zhu = present("shui lingzhu", me))
    && zhu->is_5zhu())
    return 1;

  remove_call_out("check");
  call_out("check", 1 + random(3), me, name);
  return 1;
}
