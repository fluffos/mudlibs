#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  string msg;
  set_name(HIR "冲灵丹" NOR, ({ "chongling dan", "dan", }));
  set_weight(1);
  set("unit", "粒");
  set(
    "long",
    HIG "灵气皆自然，求之不可得。" NOR "\n" HIM "功效：当人物100级以下且非突破等级(60级以下支持突破等级)时，能提升一级人物等级。" NOR "\n"
  );
  set("value", 0);
  set("no_get", 1);
  set("no_give", 1);
  set("no_put", 1);
  set("no_steal", 1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  if (me->query_level() >= 100)
    return err_msg("这粒仙丹对你来说没什么用。\n");
  if (me->query_level() > 60 && last_num(me->query_level()) == 9)
    return err_msg("这粒仙丹对你来说没什么用。\n");
  if (me->query("giftmark/dengjidan_eat"))
    return err_msg("你只能吃一次。\n");
  message_vision(HIG "$N" HIG "一仰脖，将$n" HIG "吞了下去。\n" NOR, me, this_object());

  if (me->level_up()) {
    write(HIG "【系统】你的等级提升了" HIR "1" HIG "级。\n" NOR);
    CHAR_D->setup_char(me);
    UPDATE_D->check_user(me, 1);
    me->powerup(0, 1);
    me->set_temp("login_data/time", time());
    me->set_temp("login_data/exp", 0);
    me->set("giftmark/dengjidan_eat", 1);
    me->save(1);
  } else write(HIR "结果什么反应也没有。\n" NOR);
  destruct(this_object());
  return 1;
}
