// Room: some place in 西牛贺洲
// inside2.c
inherit ROOM;

mixed check_rack();
void init_rack();

void create() {
  set("short", "练功场");
  set("long", @LONG
一个小小的练功场．场内一个中年道士在教一些小道们武功。周
围兵器架(rack)上放着一些兵器。

LONG);
  set("exits", ([
    "west": __DIR__ "gate1",
    "east": __DIR__ "inside7",
    "north": __DIR__ "inside8",
    "south": __DIR__ "sleep",
  ]));
  set("item_desc", ([
    "rack": (: check_rack :),
  ]));
  set("no_clean_up", 0);
  set("outdoors", 1);
  setup();
}

void reset() {
  ::reset();
  init_rack();
}

void init_rack() {
  if (time() < query("rack_time") + 1800)
    return;
  set("rack", 3 + random(4));
  set("rack_time", time());
}

mixed check_rack() {
  string str, str2, arg;
  int i, k;

  if (!intp(i = query("rack"))
    || i < 1)
    return "兵器架上已经空了。\n";

  return "兵器架上插着" + chinese_number(i) + "根齐眉棍(stick)，方寸弟子可以试着从兵器架(rack)上拿(get)起来。\n";
}

void init() {
  add_action("do_get", "get");
}

int do_get(string arg) {
  int i, lvl;
  object ob, me = this_player();
  if (!arg || sscanf(arg, "%s from rack", arg) != 1)
    return 0;
  if (arg != "stick")
    return 0;
  if (me->query("family/family_name") != "方寸山三星洞")
    return err_msg("只有方寸山的弟子才能拿。\n");
  if (me->is_busy())
    return err_msg("你现在正忙着呢。\n");
  if (!intp(i = query("rack"))
    || i < 1)
    return err_msg("武器架上已经空了。\n");
  lvl = me->query_level();
  if (lvl < 10)
    lvl = 10;
  if (lvl > 20)
    lvl = 20;
  ob = new("/d/obj/nweapon/stick");
  if (!ob)
    return err_msg("奇怪，空的？！\n");
  ob->init_weapon(lvl);
  ob->set_name("齐眉棍", ({ "qimei gun", "gun", "stick", }));
  ob->set("weapon_title", "方寸山");
  ob->set("from", "方寸山三星洞");
  if (ob->move(me)) {
    me->start_busy(1);
    add("rack", -1);
    message_vision("$N从兵器架上拿起一" + ob->query("unit") + ob->name(1) + "。\n", me);
    return 1;
  } else {
    if (ob)
      destruct(ob);
    return err_msg("你背包满了。\n");
  }
}
