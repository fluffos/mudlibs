// worker.c
#include <ansi.h>
inherit SUPER_NPC;

void create() {
  set_name("云清", ({ "yun qing", "yun" }));
  set_level(49);
  set("gender", "男性");
  set("age", 33);
  set("long", "方寸山三星洞第三代弟子中的杰出人物，虽不是很聪明，但师祖却很看重他。\n");
  set("class", "taoist");
  set("attitude", "peaceful");
  create_family("方寸山三星洞", 3, "弟子");
  set("title", "方寸山三代首徒");

  set_skill("unarmed", 490);
  set_skill("dodge", 490);
  set_skill("parry", 490);
  set_skill("spells", 490);
  set_skill("dao", 490);
  set_skill("literate", 490);
  set_skill("sword", 490);
  set_skill("liangyi-sword", 490);
  set_skill("puti-zhi", 490);
  set_skill("jindouyun", 490);
  set_skill("stick", 490);
  set_skill("qianjun-bang", 490);
  set_skill("dodge", 490);
  set_skill("force", 490);
  set_skill("wuxiangforce", 490);

  map_skill("spells", "dao");
  map_skill("unarmed", "puti-zhi");
  map_skill("force", "wuxiangforce");
  map_skill("sword", "liangyi-sword");
  map_skill("parry", "liangyi-sword");
  map_skill("dodge", "jindouyun");
  map_skill("stick", "qianjun-bang");
  set_skill("jiefeng", 490);

  set("env/test", "HIB");
  setup();
  carry_object("/d/lingtai/obj/daoguanq")->wear();
  carry_object("/d/lingtai/obj/cloth")->wear();
  carry_object(0, "sword", 1)->wield();
  carry_object(0, "shoes", 1)->wear();
  carry_object(0, "wrists", 1)->wear();
  carry_object(0, "waist", 1)->wear();
  powerup(0, 1);
}

void init() {}

void create_daohao(object me) {
  int i;
  string str, old, name, *names, mz;
  mapping nn;

  if (!me)
    return;
  names = ({ "广", "悟", "云", "慧", });

  if (!me->query("taoist/class")
    || (me->query("taoist/class") && me->query("taoist/class") == "fangcun")) {
    i = (me->query_level() - 40) / 20;
    if (i < 0)
      i = 0;
    if (i > 3)
      i = 3;
    i = 3 - i;
    if (i < 2)
      i = 2;
    name = names[i];
    if (me->query("taoist/name1") == name)
      return;
    message_vision(
      "$N朝$n点了点头：我三星洞方寸山以『" HIG "广、悟、云、慧" NOR "』排辈，入我门下，以你的资历，便为「" HIG + name + NOR "」字辈吧。\n",
      this_object(),
      me
    );
    if (!stringp(str = me->query("taoist/name2"))
      || strlen(str) < 2) {
      me->set("taoist/name1", name);
      nn = NAME_D->random_name2((me->query("gender") == "女性" ? 1 : 0), 0, 0, 0, 0);
      mz = nn["name"];
      i = strlen(mz);
      str = sprintf("%s", mz[2..i - 1]);
      name = name + str;
      me->set("taoist/name2", str);
      CHANNEL_D->do_channel(
        this_object(),
        "chat",
        "近日，" + me->query("name") + "于三星洞方寸山，归化方外，行冠巾之仪，道名「" + name + "」。"
      );
    } else name = name + str;
    message_vision(
      CYN "$N" CYN "说道：" + me->query("name") + CYN "，按你的修为，道号当为『" + name + "』。\n" NOR,
      this_object(),
      me
    );
    if (stringp(old = me->query("taoist/old_name")))
      ;
    else me->set("taoist/old_name", me->query("name"));
    me->set("name", name);
    me->set("taoist/class", "fangcun");
  }
}

void attempt_apprentice(object ob) {
  int i;
  string name;
  if (ob->query_level() > 40 && !wizardp(ob)) {
    EMOTE_D->do_emote(this_object(), "hmm", geteuid(ob), CYN, 0, 0, 0);
    tell_object(ob, CYN + name() + CYN "说道：阁下的修为已经与贫道在伯仲之间了。\n" NOR);
    return;
  }
  if (ob->query("class") == "bonze") {
    EMOTE_D->do_emote(this_object(), "heng", geteuid(ob), CYN, 0, 0, 0);
    tell_object(ob, CYN + name() + CYN "说道：我们方寸山虽是有教无类，但是偏偏不收秃驴！哼！\n" NOR);
    return;
  }

  EMOTE_D->do_emote(this_object(), "pat", geteuid(ob), CYN, 0, 0, 0);
  tell_object(
    ob,
    CYN + name() + CYN "说道：好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们方寸山发扬光大。\n" NOR
  );
  command("recruit " + geteuid(ob));
  CHANNEL_D->do_channel(
    this_object(),
    "chat",
    "三星洞方寸山又多了一个弟子  " + ob->name(1) + HIW "\n                                 方寸山的势力加强了。\n" NOR
  );
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "taoist");
    create_daohao(ob);
  }
}
