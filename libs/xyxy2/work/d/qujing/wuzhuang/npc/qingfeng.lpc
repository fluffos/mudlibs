  set_name("清风", ({ "qing feng", "qingfeng" }));
  set_level(54);
  set("gender", "男性");
  set("age", 16);
  set("long", "一个机灵的小仙童，在五庄观上下很是吃得开。\n");
  set("class", "xian");

