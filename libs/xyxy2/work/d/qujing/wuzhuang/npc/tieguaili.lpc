// tieguaili.c...weiqi, 98.02.24.

#include <ansi.h>
inherit SUPER_NPC;

string ask_for_leave() {
  object me = this_player();

  if (me->query("family/family_name") == "五庄观") {
    if (me->query_level() < 40)
      return "你现在这等修为，下山岂不是辱没了圣人？！";
    command("say 你既是执意下山，我却有几句话说。");
    me->set_temp("betray", "wzg");
    return ("脱离师门要需要有一定惩罚，你可愿意(agree)？");
  }

  return 0;
}

int do_agree(string arg) {
  if (this_player()->query_temp("betray") == "wzg"
    && this_player()->query("family/family_name") == "五庄观") {
    if (FAMILY_D->leave_family(this_player(), this_object())) {
      message_vision("$N答道：弟子愿意。\n\n", this_player());
      command("say 既是你与五庄观无缘，你便下山去吧！");
      return 1;
    }
  }
  return 0;
}

void create() {
  object ob;
  set_name("铁拐李", ({ "tieguai li", "tieguai", "li" }));
  set_level(89);
  create_family("五庄观", 3, "弟子");
  set("title", "凝阳子");
  set("gender", "男性");
  set("age", 42);
  set("long", "他脚登一双烂草鞋，身着一件早就没了本来面目的脏袍，嘴里哼着走调小曲，一副悠闲神态。\n");
  set("class", "xian");

  set("attitude", "peaceful");

  set_skill("unarmed", 890);
  set_skill("wuxing-quan", 890);
  set_skill("dodge", 890);
  set_skill("baguazhen", 890);
  set_skill("parry", 890);
  set_skill("staff", 690);
  set_skill("fumo-zhang", 890);
  set_skill("force", 890);
  set_skill("zhenyuan-force", 890);
  set_skill("literate", 890);
  set_skill("spells", 890);
  set_skill("taiyi", 890);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("staff", "fumo-zhang");
  map_skill("dodge", "baguazhen");
  map_skill("parry", "fumo-zhang");
  set_skill("jiefeng", 890);
  set_skill("jizhang", 890);
  set_skill("buzhen", 890);

  set("inquiry", ([
    "下山": (: ask_for_leave :),
    "leave": (: ask_for_leave :),
  ]));

  set("force_factor", 240);
  set("mana_factor", 140);

  set("looking", HIB "头顶稻草，身披破衣" NOR "。");
  set("env/test", "HIR");
  setup();
  ob = carry_object(0, "cloth", 1);
  ob->set_name("破布衣", ({ "po yi", "cloth" }));
  ob->set("armor_level", "铁拐李");
  ob->wear();
  ob = carry_object(0, "shoes", 1);
  ob->set_name("草鞋", ({ "cao xie", "xie", "shoes" }));
  ob->set("armor_level", "铁拐李");
  ob->wear();
  ob = carry_object(0, "staff", 1);
  ob->set_name("拐杖", ({ "guai zhang", "zhang", "staff", }));
  ob->set("weapon_title", "铁拐李");
  ob->wield();
  powerup(0, 1);
}

void init() {
  add_action("do_agree", "agree");
}

void attempt_apprentice(object ob) {
  if (ob->query_level() >= 90) {
    EMOTE_D->do_emote(this_object(), "fear", geteuid(ob), CYN, 0, 0, 0);
    return;
  }
  EMOTE_D->do_emote(this_object(), "ok", geteuid(ob), CYN, 0, 0, 0);
  tell_object(
    ob,
    CYN + name() + CYN "说道：好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们道家发扬光大。\n" NOR
  );
  command("recruit " + geteuid(ob));
  if (ob->query("family/family_name") != "五庄观")
    CHANNEL_D->do_channel(
      this_object(),
      "chat",
      "万寿山五庄观又多了一个弟子  " + ob->name(1) + HIW "\n                                 五庄观的势力加强了。\n" NOR
    );
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "xian");
}

int prevent_learn(object me, string skill) {
  if (skill == "buzhen" && me->query_level() < 60) {
    tell_object(me, CYN + name() + CYN "说道：待你修为精深了，我再教予你知。\n");
    return 1;
  }
  if (skill == "jizhang") {
    if (me->query_level() < 80) {
      tell_object(me, CYN + name() + CYN "说道：待你修为精深了，我再教予你知。\n");
      return 1;
    }
    if (!me->is_knowing("wzg_bxgh")
      && (me->query_skill("zhaoyun", 2) > 0
        || me->query_skill("jianshu", 2) > 0
        || me->query_skill("banyun", 2) > 0)) {
      tell_object(me, CYN + name() + CYN "说道：待你与吾等同游东海后再教予你知。\n");
      return 1;
    }
  }
  return 0;
}
