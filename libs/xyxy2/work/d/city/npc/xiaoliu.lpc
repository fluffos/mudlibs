#include <ansi.h>
inherit SELLER;

void create() {
  set_name("姚富贵", ({ "yao fugui", "yao" }));
  set("long",
    "姚老板是高家集人，后来挣了钱，开了家布店。\n");
  set("gender", "男性");
  set("title", "布店老板");
  set("combat_exp", 10000);
  set("age", 36);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 35);
  set_skill("dodge", 30);
  set_skill("parry", 35);

  set("goods", ([
    "level": 6,
    "base_value": 500,
    "goods_dir": "/d/obj/narmor/",
    "goods": ({
      "armor", "cloth", "pifeng", "kui"
    }),
    "type": "cloth",
  ]));

  setup();
  carry_object(0, "cloth", random(2))->wear();
}
