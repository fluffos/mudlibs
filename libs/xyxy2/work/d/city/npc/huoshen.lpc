inherit SUPER_NPC;
#include <ansi.h>

mixed about_huo();

nosave int doing = 0;

void create() {
  object ob;
  set_name("刘环", ({ "liu huan", "liu" }));
  set("long", @LONG
此乃凌霄天宫火部五位正神之一的刘天君。	有诗赞：
鱼尾冠，纯然烈焰；大红袍，片片云生。丝绦悬赤色，麻履长红云。
剑带星星火， 马如赤爪龙。三目光辉观宇宙，火龙岛内有声名。 
LONG);
  set("looking", HIR "面如血泼紫，钢牙暴出唇" NOR "。");
  set("rank_info/pos_msg", HIR "浑身笼罩着层层火星" NOR "。\n");
  set_level(90);
  create_family("火云洞", 2, "蓝");
  set("title", HIR "接火天君" NOR);
  set("gender", "男性");
  set("age", 30);
  set("attitude", "friendly");
  set("per", 30);
  set("force_factor", 180);
  set("mana_factor", 220);

  set("eff_dx", 250000);
  set("nkgain", 400);
  set("class", "taoist");

  set_skill("spear", 900);
  set_skill("force", 900);
  set_skill("dodge", 900);
  set_skill("literate", 900);
  set_skill("parry", 900);
  set_skill("unarmed", 900);
  set_skill("wuyue-spear", 900);
  set_skill("spells", 900);
  set_skill("pingtian-dafa", 900);
  set_skill("moshenbu", 900);
  set_skill("huomoforce", 900);
  set_skill("moyun-shou", 900);
  map_skill("force", "huomoforce");
  map_skill("spells", "pingtian-dafa");
  map_skill("unarmed", "moyun-shou");
  map_skill("spear", "wuyue-spear");
  map_skill("parry", "wuyue-spear");
  map_skill("dodge", "moshenbu");

  set_skill("jiefeng", 900);
  set_skill("qiqing", 900);
  set_skill("tuyan", 900);
  set_skill("huifeng-fanhuo", 900);
  set("env/test", "HIR");
  set("inquiry", ([
    "火灵珠": (: about_huo :),
  ]));
  set_temp("weapon_level", 50);
  setup();
  carry_object("/d/obj/baowu/huozhu", 0, 1)->wear();
  if (objectp(ob = carry_object(0, "cloth", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
  if (objectp(ob = carry_object(0, "shoes", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
  if (objectp(ob = carry_object(0, "pifeng", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
  if (objectp(ob = carry_object(0, "kui", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
  if (objectp(ob = carry_object(0, "hand", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
  if (objectp(ob = carry_object(0, "spear", 1))) {
    ob->set("weapon_title", "刘环");
    ob->wield();
  }
  if (objectp(ob = carry_object(0, "armor", 1))) {
    ob->set("armor_title", "刘环");
    ob->wear();
  }
}

void fail_player(object who) {
  doing = 0;
  remove_call_out("_start");
  if (!who || !environment(who))
    return;
  who->delete_override("unconcious");
  who->delete_override("die");
  who->delete_override("quit");
  tell_object(who, HIR "【火灵珠】你「小火罗阵」历练失败！" NOR "\n");
  who->delete_temp("pending");
  who->set("maze/lingzhu-huo", time());
  command("chat* sigh " + who->query("id"));
  EMOTE_D->do_emote(this_object(), "forgive", geteuid(who), CYN, 0, 0, 0);
}

void win_player(object who) {
  object zhu;

  doing = 0;
  remove_call_out("_start");
  if (!who || !environment())
    return;
  who->delete_override("unconcious");
  who->delete_override("die");
  who->delete_override("quit");
  tell_object(who, HIR "【火灵珠】你「小火罗阵」历练成功！" NOR "\n");
  who->delete_temp("pending");
  who->set("maze/lingzhu-huo", time());
  zhu = new("/d/obj/baowu/huozhu");
  if (zhu->move(who)) {
    command("chat* haha");
    EMOTE_D->do_emote(this_object(), "dabao", geteuid(this_object()), CYN, 0, 0, 0);
    message_vision(
      HIR "$N" HIR "口中念咒，伸出中指对着$n" HIR "一点，顿时一朵菊花的火球在$n" HIR "面前炸开，吓得$p跳起三尺来高。\n" NOR,
      this_object(),
      who
    );
    message_vision(HIC "却不想那火不是凡火，眨眼间就凝聚成一颗火气冲天的" HIR "红色" HIC "珠子。\n" NOR, who);
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      "听说" + who->name(1) + "得到了" HIR "火灵珠" HIM "。" NOR
    );
  } else {
    if (zhu) destruct(zhu);
    message_vision(CYN "$N" CYN "皱了皱眉毛，感到很不满意。\n" NOR, this_object());
    tell_object(who, CYN + name() + CYN "说道：你包裹满了吧。\n" NOR);
  }

}

mixed about_huo() {
  object zhu, me = this_player();

  if (!environment() || base_name(environment()) != "/d/changan/eside5")
    return 0;

  if (doing != 0)
    return "你还需等等，现在有其他人在此历练。";

  if (me->query_temp("pending/hlz_zhen")) {
    tell_object(me, HIR + name() + HIR "怒发冲冠：过阵期间三心二意，你是不是不把本天君当回事？！\n" NOR);
    EMOTE_D->do_emote(this_object(), "qi", 0, CYN, 0, 0, 0);
    fail_player(me);
    return 1;
  }

  if (objectp(zhu = present("huo lingzhu", me))
    && zhu->is_5zhu())
    return "不是已经给你了吗？！";
  if (time() < me->query("maze/lingzhu-huo") + 1800)
    return "莫老来烦本天君，小心把你烧成灰拿去肥田！";
  if (me->query("gin") < 30)
    return "你这么点活力，本天君可不给你。";
  if (!me->query_temp("pending/huoshen")) {
    tell_object(me, CYN + name() + CYN "说道：好好好，今日和辛天君忙里偷闲，下界一游。既然和你有缘，便许你好处。\n" NOR);
    tell_object(me, CYN + name() + CYN "说道：只要能挨过我的「小火罗阵」，珠子给你何妨。\n" NOR);
    tell_object(me, HIC + name() + HIC "说道：准备好了，我们就开始(start)。\n" NOR);
    me->set_temp("pending/huoshen", 1);
    return 1;
  } else return "准备好了吗？";
}

void init() {
  add_action("do_start", "start");
  add_action("do_cmds", "", 1);
}

int check_out(object who) {
  if (!who || !environment() || !present(who, environment()))
    return 0;
  if (doing == 0)
    return 0;
  if (who->query("kee") < 100 || who->query("sen") < 100) {
    who->powerup(0, 1);
    message("vision", who->name() + "被烈火烧烤得浑身焦黑，在原地晃晃悠悠，眼看就要栽倒。\n", environment(), who);
    tell_object(who, "糟糕！你现在的状况极度不好，看来是支撑不下去了！\n");
    fail_player(who);
    return 1;
  }
  return 0;
}

int do_cmds(string arg) {
  string str, verb = query_verb();
  object who = this_player();

  if (doing == 0)
    return 0;
  if (!who->query_temp("pending/hlz_zhen"))
    return 0;
  if (verb == "look") {
    if (!arg) {
      str = "\n" HIY "「" HIR "小火罗阵" HIY "」" NOR "\n";
      str += @LONG
    四下里全是一片火海，你抬眼望去，一望无际的火红，亮瞎了你的狗眼！
    
LONG;
      str += HIR "  接火天君" NOR " 刘环(Liu huan)\n";
      tell_object(who, str);
      return 1;
    }
  }
  if (verb == "exert")
    return err_msg(name() + "在圈外叫道：安心闯阵，本天君要看你的真实水平。\n");
  if (verb == "quit" || verb == "ask") {
    tell_object(who, HIR + name() + HIR "怒发冲冠：过阵期间三心二意，你是不是不把本天君当回事？！\n" NOR);
    EMOTE_D->do_emote(this_object(), "qi", 0, CYN, 0, 0, 0);
    fail_player(who);
    return 1;
  }
  return 0;
}

int valid_damage(object victim) {
  int damage;
  if (!victim || doing == 0)
    return 0;
  damage = 3500;
  damage = damage * 9 / 10 + random(damage / 10);
  damage -= 2000 * victim->query_spells_def() / (victim->query_spells_def() + victim->query_level() * 50 + 360);
  if (victim->query_temp("XST_bamianhuo") > 0)
    damage -= 500;
  if (victim->query_temp("XST_guimiandun") > 0)
    damage -= 600;
  if (victim->query_temp("XST_yanliuxing") > 0)
    damage -= 800;
  if (damage < 100)
    damage = 100;
  return damage;
}

void _start(object who, int num) {
  int damage;
  string str;
  remove_call_out("_start");
  if (!who) {
    doing = 0;
    return;
  }
  if (!environment() || base_name(environment()) != "/d/changan/eside5") {
    fail_player(who);
    return;
  }
  if (!living(who)
    || who->query("kee") < 100
    || who->query("sen") < 100) {
    say(CYN + name() + CYN "说道：哈哈哈，本天君的「小火罗阵」威力又加强了。" NOR "\n");
    fail_player(who);
    return;
  }
  if (!present(who, environment())) {
    tell_object(who, HBBLU "刘环(liu huan)告诉你：哈哈，临阵脱逃可不是好汉行为。" NOR "\n");
    fail_player(who);
    return;
  }
  if (num >= 6) {
    command("chat* gongxi");
    win_player(who);
    return;
  }
  str = ({
    "火焰",
    "火舌",
    "烈焰",
    "烈火",
  })[random(4)] + ({
    "翻腾",
    "一舔",
    "倒卷"
  })[random(3)] + "，只见你" + ({
    "的头发冒起一股青烟！",
    "身上滋滋作响！",
    "的脸上膨起几个大水疱！",
    "发出一股焦味！",
  })[random(4)] + "\n";
  tell_object(who, str);
  damage = valid_damage(who);
  switch (random(5)) {
    case 4:
      damage -= who->query_temp("apply/def_eff_spells");
      if (damage < 100)
        damage = 100;
      who->receive_wound("kee", damage);
      str = "( 你" + COMBAT_D->eff_status_msg((int)who->query("eff_kee") * 100 / (1 + (int)who->query_maxkee())) + " )\n";
      break;
    default:
      damage -= who->query_temp("apply/def_spells");
      if (damage < 100)
        damage = 100;
      who->receive_damage("kee", damage);
      str = "( 你" + COMBAT_D->status_msg((int)who->query("kee") * 100 / (1 + (int)who->query_maxkee())) + " )\n";
      break;
  }
  tell_object(who, str);
  num++;
  call_out("_start", 3 + random(3), who, num);
}

int do_start(string arg) {
  object zhu, me = this_player();

  if (!environment() || base_name(environment()) != "/d/changan/eside5")
    return 0;
  if (doing > 0)
    return 0;
  if (objectp(zhu = present("huo lingzhu", me))
    && zhu->is_5zhu())
    return 0;
  if (me->query("gin") < 30)
    return 0;
  if (!me->query_temp("pending/huoshen"))
    return 0;
  write("你对" + name() + "点了点头，说道：在下准备就绪，玩天君赐教。\n");
  write(CYN + name() + CYN "朝你点了点头。\n" NOR);
  write(HIC + name() + HIC "朝你甩了甩衣袖，一团烈火从袖口中窜了出来，陡然炸开，顿时四下里全是火光！\n" NOR);
  write("\n");
  arg = "\n" HIY "「" HIR "小火罗阵" HIY "」" NOR "\n";
  arg += @LONG
    四下里全是一片火海，你抬眼望去，一望无际的火红，亮瞎了你的狗眼！
    
LONG;
  arg += HIR "  接火天君" NOR " 刘环(Liu huan)\n";
  write(arg);
  me->set_temp("pending/hlz_zhen", 1);
  doing = 1;
  me->set_override("unconcious", (: call_other, __FILE__, "check_out" :));
  me->set_override("die", (: call_other, __FILE__, "check_out" :));
  me->set_override("quit", (: call_other, __FILE__, "check_out" :));

  remove_call_out("_start");
  call_out("_start", 1, me, 1);
  return 1;
}
