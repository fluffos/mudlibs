// wri by bear
inherit ROOM;
#include <ansi.h>

int do_hear();

void create() {
  set("short", "阎罗宝殿");
  set("long", @LONG
这里便是名闻天下，令人提起心惊胆寒的阎罗地府。人死后都会
在这里受到应有的处置。正前一张大桌，后面坐着阎罗王，旁边
立着崔判官。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "new-walk5",
    "north": __DIR__ "walk1",
  ]));
  set("hell", 1);
  set("out_doors", 1);
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/yanluowang": 1,
    //  __DIR__"npc/panguan" : 1,
  ]));
  setup();
  call_other("/obj/board/shengsi_b", "???");
}

void paodian_end() {
  remove_call_out("paodian");
}

void paodian() {
  object *inv;
  int i;
  if (!query("jiangjing"))
    return 0;
  tell_room(this_object(), HIC "阎罗王喊道;小鬼集合开始讲经。\n" HIB "一时鬼气森森,四面阴风煞煞，好不吓人。\n" NOR);
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || !living(inv[i])
      || inv[i]->query("family/family_name") != "阎罗地府")
      continue;
    tell_object(inv[i], "你在旁边听着，听着，不禁对所学有所领悟。\n");
    inv[i]->add("combat_exp", 5000);
    inv[i]->add("daoxing", 800);
    inv[i]->add("potential", 500);
    tell_object(
      inv[i],
      HIG "【门派泡点】你得到了" HIR "5000点" HIG "武学经验、" HIR + COMBAT_D->chinese_daoxing(800) + HIG "道行以及" HIR "500点" HIG "潜能修为。" NOR "\n"
    );
  }
  remove_call_out("paodian");
  call_out("paodian", 5);
}
