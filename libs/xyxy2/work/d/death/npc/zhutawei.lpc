  set_skill("unarmed", 470);
  set_skill("parry", 470);
  set_skill("spells", 470);
  set_skill("gouhunshu", 470);
  set_skill("jinghun-zhang", 470);
  set_skill("force", 470);
  set_skill("tonsillit", 470);
