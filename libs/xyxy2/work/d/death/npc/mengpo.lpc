// gargoyle.c
#include <ansi.h>
inherit SUPER_NPC;

mixed reset_chimeng() {
  object me = this_player();
  if (me->query("family/family_name") != "月宫"
    || (int)me->is_knowing("moon_chimeng") < 1
    || (int)me->is_knowing("moon_chimeng") == 2
    || me->query_temp("mark/chimeng_zui"))
    return "喝了我的汤，生死两相忘。";
  me->set_temp("mark/chimeng_zui", 1);
  tell_object(me, CYN + name() + CYN "说道：其实我这汤主味乃是用了「醉生梦死」和「女儿红」，加上黄泉之水以及我的独家秘方，便成了这道生死之汤。\n" NOR);
  tell_object(me, HIC "看来只需要将两道主味给痴梦仙姑便成了。\n" NOR);
  return 1;
}

void create() {
  set_name("孟婆", ({ "meng po", "po", "meng", }));
  set_level(100);
  set("long", "绝色女子，在世间修行之时，从不记过往，亦不思未来。后道成，乃被封为幽冥之神。\n");
  set("gender", "女性");
  set("attitude", "peaceful");
  set("age", 30);
  set("per", 100);
  create_family("阎罗地府", 3, "你好");
  set("title", "幽冥神");
  set("class", "ghost");
  set("force_factor", 100);
  set("mana_factor", 100);

  set_skill("literate", 1000);
  set_skill("ghost-steps", 1000);
  set_skill("dodge", 1000);
  set_skill("unarmed", 1000);
  set_skill("parry", 1000);
  set_skill("spells", 1000);
  set_skill("gouhunshu", 1180);
  set_skill("jinghun-zhang", 1000);
  set_skill("force", 1000);
  set_skill("tonsillit", 1000);
  set_skill("whip", 1000);
  set_skill("hellfire-whip", 1000);

  map_skill("whip", "hellfire-whip");
  map_skill("parry", "hellfire-whip");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("force", "tonsillit");
  map_skill("unarmed", "jinghun-zhang");
  set_skill("mengtou", 1000);
  set_skill("jiefeng", 1000);
  set_skill("yanri", 1000);

  set("inquiry", ([
    "孟婆汤": (: reset_chimeng :),
  ]));

  set("nkgain", 400);
  set_temp("armor_level", 50);
  set_temp("weapon_level", 50);
  set("env/test", "HIB");
  setup();
  carry_object(0, "whip", random(3))->wield();
  carry_object(0, "cloth", random(3))->wear();
  carry_object(0, "neck", random(3))->wear();
  carry_object(0, "shoes", random(3))->wear();
  carry_object(0, "ring", random(3))->wear();
  carry_object(0, "pifeng", random(3))->wear();
  carry_object(0, "kui", random(3))->wear();
  carry_object(0, "armor", random(3))->wear();
  powerup(0, 1);
}

void attempt_apprentice() {
  object me;
  me = this_player();
  if (me->query_level() > 120) {
    EMOTE_D->do_emote(this_object(), "wow", geteuid(me), CYN, 0, 0, 0);
    tell_object(me, CYN + name() + CYN "说道：" + RANK_D->query_respect(me) + "，这怎么敢当？\n");
    return;
  }
  if (me->query("class") && me->query("class") != "ghost") {
    if (!me->query_temp("pendding/hell_class")) {
      EMOTE_D->do_emote(this_object(), "shake", geteuid(me), CYN, 0, 0, 0);
      tell_object(me, CYN + name() + CYN "说道：吾等不收外门弟子，若诚心想入我门，还是先去帮阎罗核对生死簿吧。\n" NOR);
      return;
    }
  }
  EMOTE_D->do_emote(this_object(), "pat", geteuid(me), CYN, 0, 0, 0);
  tell_object(
    me,
    CYN + name() + CYN "说道：好，希望" + RANK_D->query_respect(me) + "多加努力，把我们地府发扬光大。\n" NOR
  );
  command("recruit " + geteuid(me));
  CHANNEL_D->do_channel(
    this_object(),
    "chat",
    "阎罗地府又多了一个弟子  " + me->name(1) + HIW "\n                                 地府的势力加强了。\n" NOR
  );
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "ghost");
}

int prevent_learn(object me, string skill) {
  string *skills = ({ "mengtou", "yanri", });
  if (member_array(skill, skills) == -1)
    return 0;
  if (me->query_level() < 95) {
    tell_object(me, CYN + name() + CYN "说道：你还要多练练。\n" NOR);
    return 1;
  }
  return 0;
}
