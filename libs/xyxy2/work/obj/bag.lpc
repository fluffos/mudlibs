#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

string query_save_file() {
  string id;
  id = query("owner_id");
  if (!id || !stringp(id))
    return 0;
  return sprintf(DATA_DIR "bag/%c/%s", id[0], id);
}

int restore() {
  if (!query("owner_id"))
    return 0;
  return ::restore();
}

void create() {
  set_name("储物袋", ({ "chuwu dai", "bag", "dai", }));
  set_weight(1000);
  set("level", 1);
  set("long", @LONG
	
此乃修仙者中很寻常的芥子袋，盖以「芥子奈须弥」之意命名。
你可以使用 cunru [数量] <id> 来存入物品。
你可以使用 quchu <序号> 来取出物品。
你可以通过 mark <物品id> <注释内容> 来给物品做注释。

LONG);
  setup();
}

void leave() {
  if (environment())
    message(
      "vision",
      "\n\n”还我宝贝来！“天空中伸出一只大手，一把抓起" + this_object()->name() + "消失在云层之中。\n",
      environment()
    );
  destruct(this_object());
}

int do_cun(string arg) {
  int i, max;
  string file, *prop, name, *ids, mark, f;
  mapping data, store;
  object obj, me = this_player();

  if (!present(this_object(), me)
    || query("owner_id") != me->query("id"))
    return 0;
  if (!arg)
    return notify_fail("你要存什么？\n");

  if (me->is_busy())
    return notify_fail("你现在正忙。\n");

  obj = present(arg, me);
  if (obj == this_object())
    return notify_fail("怎么可能。\n");
  if (!obj)
    return notify_fail("你身上没有" + arg + "。\n");
  if (obj->is_character())
    return notify_fail("你想贩卖人口？\n");

  if (obj->query("equipped"))
    return notify_fail("你得先将" + arg + "卸除。\n");
  if (obj->query("no_store")
    || obj->query("no_put")
    || obj->query("no_give"))
    return notify_fail(arg + "不能保存。\n");

  me->start_busy(1);
  delete("store");
  restore();
  store = query("store");
  max = query("level") * 5 + 25;
  max += me->query("mark/bag");
  if (max > 100)
    max = 100;
  if (store && mapp(store)) {
    if (sizeof(keys(store)) >= max)
      return notify_fail("这个储物袋只能存" NOR HIR + max + NOR CYN "个物品。\n" NOR);
  }
  name = obj->query("name");
  ids = obj->query_my_id();
  data = obj->query_entire_dbase();
  file = base_name(obj);
  f = file_name(obj);
  if (!stringp(mark = me->query_temp("pending/store_" + f))
    || strlen(mark) < 4)
    mark = "";
  else me->delete_temp("pending/store_" + f);
  if (!store || !mapp(store) || sizeof(store) < 1)
    store = ([
      time(): ([
        "ids": ids,
        "dbase": data,
        "name": name,
        "file": file,
        "num": (obj->query_amount() > 1 ? obj->query_amount() : 1),
        "mark": mark,
      ]),
    ]);
  else store[time()] = ([
    "ids": ids,
    "dbase": data,
    "name": name,
    "file": file,
    "num": (obj->query_amount() > 1 ? obj->query_amount() : 1),
    "mark": mark,
  ]);
  set("store", store);
  if (this_object()->save()) {
    message_vision(
      "$N将一" + (obj->query("unit") ? obj->query("unit") : "些") + obj->name() + "放进了储物袋。\n",
      me
    );
    destruct(obj);
    return 1;
  }
  delete("store");
  return notify_fail("好似出问题了。\n");
}

void init() {
  if (environment() && userp(environment())) {
    if (!query("owner_id"))
      set("owner_id", environment()->query("id"));
    else if (query("owner_id") != environment()->query("id")) {
      leave();
      return;
    }
    add_action("do_mark", "mark");
    add_action("do_qu", "quchu");
    add_action("do_cun", "cunru");
  }
}

string long() {
  mixed *names;
  string str, name, id, *ids, mark, long;
  int i, num;
  mapping prop, temp;
  object me;

  long = ::long();

  if (!environment())
    return long;
  me = environment();
  if (query("owner_id") != me->query("id"))
    return long;

  delete("store");
  restore();
  prop = query("store");
  if (!prop || !mapp(prop))
    return long;
  names = keys(prop);
  if (!names || !arrayp(names) || sizeof(names) < 1)
    return long;
  str = "里面有：\n";
  for (i = 0; i < sizeof(names); i++) {
    if (undefinedp(prop[names[i]]))
      continue;
    temp = prop[names[i]];
    name = temp["name"];
    ids = temp["ids"];
    if (!undefinedp(temp["num"]))
      num = temp["num"];
    else num = 1;
    if (!undefinedp(temp["mark"]))
      mark = temp["mark"];
    else mark = "";
    if (num < 1)
      num = 1;
    id = ids[0];
    str += sprintf("%12d 号物品 ：", names[i]);
    str += sprintf("%30-s x" HIR "%5-d" NOR " ", name + "(" + capitalize(id) + ")", num);
    if (mark != "")
      str += sprintf("备注：%22-s\n", mark);
    else str += "\n";

  }
  str += "如果想取出，请用命令 quchu <物品编号>\n";
  long += str;
  return long;
}

int do_qu(string arg) {
  int num, i, v;
  string file, str, name, id, *ids, *tmp;
  mapping prop, temp, dbase;
  object obj, me = this_player();

  if (!present(this_object(), me)
    || query("owner_id") != me->query("id"))
    return 0;
  if (!arg || sscanf(arg, "%d", num) != 1)
    return err_msg("如果想取出，请用命令 qu <物品编号>\n");
  if (me->is_busy())
    return err_msg("你现在正忙。\n");
  me->start_busy(1);
  delete("store");
  restore();
  prop = query("store");
  if (!prop || !mapp(prop))
    return err_msg("这个储物袋是空的。\n");

  if (undefinedp(prop[num]))
    return err_msg("这个储物袋空空如也。\n");

  temp = prop[num];
  file = temp["file"];
  name = temp["name"];
  ids = temp["ids"];
  if (!undefinedp(temp["num"]))
    v = temp["num"];
  else v = 1;
  dbase = temp["dbase"];

  obj = new(file);
  if (!obj)
    return err_msg("暂时没有找到你的物品。\n");
  obj->init_weapon(1);
  obj->set_name(name, ids);
  obj->setup();
  tmp = keys(dbase);
  for (i = 0; i < sizeof(tmp); i++) {
    if (tmp[i] == "actions")
      continue;
    obj->set(tmp[i], dbase[tmp[i]]);
  }
  if (v > 1)
    obj->set_amount(v);
  if (obj->move(me)) {
    map_delete(prop, num);
    set("store", prop);
    if (save()) {
      message_vision(
        "$N从储物袋中翻出了一" + obj->query("unit") ? obj->query("unit") : "些" + obj->name() + "。\n",
        me
      );
      return 1;
    } else {
      if (obj)
        destruct(obj);
      return err_msg("你的仓库保存失败。\n");
    }
  } else {
    if (obj) destruct(obj);
    return err_msg("你身上的家什太多了。\n");
  }
}

int do_mark(string arg) {
  string mark, tmp, file;
  object ob, me = this_player();

  if (!present(this_object(), me)
    || query("owner_id") != me->query("id"))
    return 0;

  if (!arg || sscanf(arg, "%s %s", arg, mark) != 2)
    return notify_fail("你要给哪件物品做注释？命令格式：mark <物品id> <注释内容，支持颜色代码，最长10个汉字>。\n示例：mark bag HIC百宝袋\n");
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");
  ob = present(arg, me);
  if (!ob)
    return notify_fail("你身上没有" + arg + "。\n");
  if (ob->is_character()
    || ob->query("no_store")
    || ob->query("no_give"))
    return notify_fail("这东西不能保存。\n");
  if (ob->query("equipped"))
    return notify_fail("你得先卸除它。\n");

  mark = COLOR_D->replace_color(mark, 1);
  tmp = COLOR_D->clean_color(mark);
  if (strlen(tmp) >= 20 || strlen(tmp) < 4)
    return notify_fail("注释内容长度为：2-10个汉字，支持颜色代码，颜色代码参照 color 命令。\n");
  file = file_name(ob);
  me->set_temp("pending/store_" + file, mark + NOR);
  write("你将" + ob->name(1) + "注释为：" + mark + NOR "\n");
  me->start_busy(1);
  return 1;
}

string short() {
  string id, str = ::short();
  if (!stringp(id = query("owner_id"))
    || strlen(id) < 2)
    return str;
  return query("name") + "(" + capitalize(id + "'s " + query("id")) + ")";
}
