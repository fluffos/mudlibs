inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

string *names = ({
  HIY "麻辣肚丝" NOR,
  HIY "松仁玉米" NOR,
  RED "梅菜扣肉" NOR,
  HIR "五香腊肠" NOR,
  HIM "鱼香肉丝" NOR,
  HIY "红油鸡片" NOR,
  HIW "清炒虾仁" NOR,
  RED "五花焖肉" NOR,
  CYN "青丝熏鱼" NOR,
  RED "糖醋排骨" NOR,
  RED "京酱肉丝" NOR,
  YEL "油炝大虾" NOR,
  HIY "脆皮烤鸭" NOR,
  HIY "红烧素鹅" NOR,
  HIW "宫保鸡丁" NOR,
  HIR "红油肺片" NOR,
  MAG "嫩汆猪肝" NOR,
  YEL "走油脆肠" NOR,
  RED "爆炒腰花" NOR,
  HIG "麝香冬笋" NOR,
  HIW "翡翠豆腐" NOR,
  HIW "麻婆豆腐" NOR,
  YEL "三鲜腐竹" NOR,
  RED "番茄腰柳" NOR,
  HIR "抓炒里脊" NOR,
  HIY "片皮乳猪" NOR,
  HIY "锅巴肉片" NOR,
  HIC "梁溪脆鳝" NOR,
  HIR "干煸尤鱼" NOR,
  HIR "重庆火锅" NOR,
  HIG "碧螺春卷" NOR,
});


void create() {
  set_name("各类菜肴", ({ "cai yao", "cai", "food" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘令人垂涎的菜肴。\n");
    set("unit", "盘");
    set("value", 200);
    set("food_remaining", 5);
    set("food_supply", 35);
  }
}

void init() {
  if (query("name") == "各类菜肴")
    set_name(names[random(sizeof(names))], ({ "cai yao", "cai", "food" }));
  ::init();
}
