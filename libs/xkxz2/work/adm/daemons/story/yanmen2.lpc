// story:yanmen2 雁门关外阻击2

#include <ansi.h>

void create_attacker();

mixed *story = ({
  "雁门关外，马蹄声响，辽人当先的马匹奔近。",
  "只见这些契丹武士身上都披皮裘，或拿长矛，或提弯刀，或弯弓搭箭，或停猎鹰，高歌而来。",
  "带头大哥一声长啸，众人的暗器便射了出去，钢镖、袖箭、飞刀、铁锥……每件都喂了剧毒。",
  "只听得众辽人啊啊呼叫，乱成一团，一大半都摔下马来。",
  "众人一拥而上。刀剑齐施，片刻之间，将这剩下几人尽数杀了，没一个活口逃走。",
  "只听得马蹄声音，西北角又有两骑马驰来，马上是男女二人。",
  "这两人见到那一十九名武士死在地下，那男子立时神色十分凶猛，向众人大声喝问。",
  "辽人：$*@!@#$%^&*！",
  "铁塔方大雄举起一条镔铁棍，喝道：兀那辽狗，纳下命来！挥棍便向那契丹男子打了过去。",
  "那辽人右臂伸出，折断方大雄右臂关节，将他的身子挑了起来，连人带棍，一起摔在道旁。",
  "辽人：#$%^&*$*@!@！",
  "当下六七人一拥而上，向那辽人攻了过去。另外四五人则向那少妇攻击。",
  "那少妇被人一剑便斩断一条手臂，抱着的婴儿跌下地来，跟着便被一刀砍去了半边脑袋。",
  "只听得那辽人眼睛登时红了，脸上神色可怖之极，暴喝一声，冲向敌阵。",
  ".........",
  "夕阳如血，雁关门外朔风呼号.........",
  (: create_attacker :),
});

string prompt() { return HIY "【武林传奇】" NOR; }

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

void create_attacker() {
  object aob;

  catch(aob = new("/d/yanmen/npc/xiao"));
  catch(aob->move("/d/yanmen/luanshi1"));
}
