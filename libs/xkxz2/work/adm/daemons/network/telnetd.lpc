// Last modified by jjgod@FYTX. 01/02/28.

#include <mudlib.h>
#include <net/telnet.h>
#include <net/socket.h>

void load_sites();

string *SITES;

void create() {
  seteuid(getuid(this_object()));
  load_sites();
}

void load_sites() {
  string *tmp, file;
  int loop;

  // 初始化站点列表 array
  SITES = ({});

  // 读入认可站点列表
  file = read_file(APPROVED_SITES);

  // 检测文件中是否包含了一些站点
  if (!file) return;

  tmp = explode(file, "\n");

  for (loop = 0; loop < sizeof(tmp); loop++)
    if (tmp[loop][0] == '#' || tmp[loop][0] == '\n' || tmp[loop] == "")
      continue;
    else SITES += ({ tmp[loop] });
}

/* 无论何时一个 socket 指令被发起，master_ob 中的 valid_socket() 
 * 将询问 telnet 后台来察看是否允许这个连接。
 * Info 这个 array 传送了以下格式的信息：
 *	info[0]	= int fd
 *	info[1] = object owner
 *	info[2] = string ip_address
 *	info[3] = int port */

// 对 telnet 请求的检查
int telnet_permission(object caller, string func, mixed *info) {
  string eff_user, tmp1, tmp2, tmp3;
  int loop;

#ifdef DEBUG
  log_file(
    "telnetd",
    "Caller: " + identify(caller) + "  Func: " + identify(func) + "  Info: " + identify(info) + "\n"
  );
#endif

  // 假如认可站点还没有 load，那么现在来 load。
  if (!SITES) load_sites();

  // 获得呼叫者的 EUID 。
  eff_user = geteuid(caller);
  // 假如呼叫者使用了 ROOT_UID 来呼叫物件，我们允许它通过
  if (eff_user == ROOT_UID) return 1;


  // 假如 telnet 物件是一个被认可的客户端，允许 telnet 尝试
  if (caller && member_array(base_name(caller), APPROVED_TELNET) != -1)
    return 1;


  // 假如在请求中无 IP 地址，我们暂时允许它通过
  if (!info[2]) return 1;


  // 监测发出请求的站点是否一个允许的 telnet 站点
  for (loop = 0; loop < sizeof(SITES); loop++) {

    if (SITES[loop] == info[2]) return 1;  // 绝对直接匹配

    else if (SITES[loop] == "*.*.*.*") return 1;  // 全通配符

    // 监测通配符形式
    else if (sscanf(SITES[loop], "%s.*.*.*", tmp1) == 1) {
      if (sscanf(info[2], tmp1 + ".%s.%s.%s", tmp1, tmp2, tmp3) == 3)
        return 1;
    } else if (sscanf(SITES[loop], "%s.%s.*.*", tmp1, tmp2) == 2) {
      if (sscanf(info[2], tmp1 + "." + tmp2 + ".%s.%s", tmp1, tmp2) == 2)
        return 1;
    } else if (sscanf(SITES[loop], "%s.%s.%s.*", tmp1, tmp2, tmp3) == 3) {
      if (sscanf(info[2], tmp1 + "." + tmp2 + "." + tmp3 + ".%s", tmp1) == 1)
        return 1;
    }

  }

  return 0;
}
