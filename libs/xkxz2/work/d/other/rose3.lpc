// r-rose.c 红玫瑰

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create() {
  set_name(BLU "蓝玫瑰" NOR, ({ "blue rose", "rose", "meigui" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("long", BLU "一朵雪人送的蓝玫瑰，带给你一丝温情。\n" NOR);
    set("value", 5000);
    set("wear_msg", HIM "$N嘻嘻一笑，把花儿别在发髻上，有如天女下凡。\n" NOR);
    set("remove_msg", HIM "$N把花儿从发髻取下，深深闻了闻，揣回怀中。\n" NOR);
    set("armor_prop/armor", 50);
    set("no_get", 1);
    set("no_drop", 1);
  }
  setup();
}

void init() {
  add_action("come_life", "wen");
  add_action("come_life", "smell");
}

int come_life(string arg) {
  object me, ob;
  me = this_player();

  if (!arg) return 0;
  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) return notify_fail("现在没这个人.\n");

  message_vision(BLU "$N用小指轻轻捻住蓝玫瑰，拿起来深深地闻了闻。\n\n" NOR, me);
  printf("%s(%s)现在关于星宿task的状况是：
     目标：   %s，   
     目标ID： %s，
     任务时间：%i，    
     等待时间：%i，
     目前的星宿点：%i。\n",
    (string)ob->name(), geteuid(ob),
    (string)ob->query_temp("xx_target"),
    (string)ob->query_temp("job_id"),
    ob->query_condition("xx_task"),
    ob->query_condition("wait_xx_task"),
    ob->query("xx_points"));
  tell_object(me, HIY "\n嗯。。。啊。。。好香呀！\n" NOR);


  return 1;
}
