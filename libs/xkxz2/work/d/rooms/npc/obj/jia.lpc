#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_SSERVER;

void create() {
  set_name(BLU "突击装甲" NOR, ({ "tuji zhuangjia", "zhuangjia", "tuji", "jia" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一套特种部队使用的突击装甲。\n");
    set("unit", "套");
    set("value", 50000);
    set("material", "steel");
    set("armor_prop/armor", 90);
  }
  setup();
}

int init() {
  add_action("do_att", "att");
}

int do_att() {
  object me, ob;
  me = this_player();
  ob = offensive_target(me);
  if (!me->is_fighting())
    return notify_fail("只能在战斗中使用。\n");

  me->add_temp("apply/strength", 200);
  me->add_temp("apply/attack", 50);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  me->add_temp("apply/strength", -200);
  me->add_temp("apply/attack", -50);
  me->start_busy(1);

  return 1;
}
