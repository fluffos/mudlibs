// changyi.c
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create() {
  set_name(HIY "雀金氅衣" NOR, ({ "quejin-changyi", "changyi", "yi" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "这是件金翠辉煌，碧彩闪烁的乌云豹氅衣，通体以俄罗斯国孔
雀毛拈了线织成，华贵无比。又及晴雯呕心以金线界密，更是通晓人性，
乃成无上至宝。\n" NOR);
    set("material", "steel");
    set("unit", "件");
    set("value", 100000);
    set("wear_msg", HIY "空中飘落一朵金云，正好披在$N背上。\n" NOR);
    set("remove_msg", HIY "只见$N左手轻轻一抖，氅衣化为一缕轻烟飘走了。\n" NOR);
    set("armor_prop/armor", 1000);
    set("treasure", 1);
  }
  setup();
}
