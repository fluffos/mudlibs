#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "纯金腰牌" NOR, ({ "jinpai" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "燕云十八骑卫士所特有的金牌，表示武士中最高的等级。\n");
    set("value", 50000);
    set("material", "gold");
  }
  setup();
}
