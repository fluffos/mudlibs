#include <ansi.h>
inherit NPC;
int p();
void create() {
  string weapon;
  set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
  set("title", HIY "明教第三十四代教主" NOR);
  set("long", "他就是明教的第三十四代教主。脸上带着英资勃发的笑容。\n");
  set("age", 24);
  set("attitude", "friendly");
  set("shen", 40000);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("max_qi", 5000);
  set("max_jing", 3000);
  set("neili", 5000);
  set("eff_jingli", 3000);
  set("max_neili", 5000);
  set("jiali", 20);
  set("combat_exp", 2000000);
  set_skill("sword", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("blade", 200);
  set_skill("piaoyi-shenfa", 200);
  set_skill("tiyunzong", 200);
  set_skill("shenghuo-lingfa", 200);
  set_skill("shenghuo-lingfa", 200);
  set_skill("lieyan-dao", 190);
  set_skill("liehuo-jian", 190);
  set_skill("taiji-jian", 190);
  set_skill("taiji-quan", 190);
  set_skill("parry", 200);
  set_skill("cuff", 200);
  set_skill("qiankun-danuoyi", 200);
  set_skill("qishang-quan", 200);
  set_skill("literate", 150);
  set_skill("medicine", 170);
  set_skill("shenghuo-shengong", 200);
  map_skill("force", "shenghuo-shengong");
  map_skill("cuff", "qishang-quan");
  map_skill("blade", "shenghuo-lingfa");
  map_skill("sword", "taiji-jian");
  map_skill("dodge", "tiyunzong");
  map_skill("parry", "qiankun-danuoyi");
  prepare_skill("cuff", "qishang-quan");
  create_family("明教", 34, "教主");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({ (: p :) }));

  setup();
  carry_object("/clone/weapon/tieling")->wield();
  carry_object("/d/mingjiao/obj/white-cloth")->wear();
}

int p() {
  if (present("tie ling", this_object())) {
    if (!this_object()->query_temp("weapon")) {
      command("wield ling");
      command("bei none");
      command("enable cuff shenghuo-lingfa");
      command("bei shenghuo-lingfa");
      command("enable parry shenghuo-lingfa");
      command("yun tougu");
      command("bei none");
      command("enable cuff qishang-quan");
      command("bei qishang-quan");
      command("enable parry qiankun-danuoyi");
      return 1;
    } else {
      command("unwield ling");
      command("jiali 100");
      command("perform qishang");
      return 1;
    }
  } else return 0;
}
