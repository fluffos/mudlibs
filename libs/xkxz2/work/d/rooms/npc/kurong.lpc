inherit F_MASTER;
inherit NPC;

void create() {
  set_name("枯荣长老", ({ "kurong zhanglao", "kurong", "zhanglao" }));
  set("nickname", "天龙寺长老");
  set("long",
    " 枯荣长老面容奇特之极，左边的一半脸色红润，皮光肉滑，
有如婴儿，右边的一半却如枯骨，除了一张焦黄的面皮之外全
无肌肉，骨头突了出来，宛然便是半个骷髅骨头。他在天龙寺
中辈份最高，在这里独参枯禅已数十年，天龙寺诸僧众，谁也
没见过他真面目。\n");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("age", 99);
  set("shen_type", 1);
  set("str", 27);
  set("int", 23);
  set("con", 29);
  set("dex", 29);
  create_family("天龙寺", 7, "弟子");

  set("qi", 4000);
  set("max_qi", 4000);
  set("jing", 3000);
  set("max_jing", 3000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("eff_jingli", 2000);
  set("jingli", 2000);
  set("jiali", 50);
  set("combat_exp", 1900000);
  set("score", 100000);

  set_skill("force", 200);
  set_skill("kurong-changong", 200);
  set_skill("qiantian-yiyang", 200);
  set_skill("dodge", 200);
  set_skill("tianlong-xiang", 200);
  set_skill("parry", 200);
  set_skill("finger", 200);
  set_skill("yiyang-zhi", 200);
  set_skill("liumai-shenjian", 130);
  set_skill("sword", 180);
  set_skill("buddhism", 180);
  set_skill("literate", 120);

  map_skill("force", "kurong-changong");
  map_skill("dodge", "tianlong-xiang");
  map_skill("parry", "yiyang-zhi");
  map_skill("finger", "yiyang-zhi");
  map_skill("sword", "yiyang-zhi");
  prepare_skill("finger", "yiyang-zhi");

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "finger.sandie" :),
  }));

  setup();
  carry_object("/d/tls/obj/jiasha")->wear();
  carry_object("/d/tls/obj/sengxie")->wear();
}
