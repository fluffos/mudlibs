// xiaofeng.c 萧锋

#include <ansi.h>
inherit NPC;

void create() {
  set_name("萧锋", ({ "xiao feng", "xiao", "feng" }));
  set("nickname", "丐帮前任帮主");
  set("title", BLU "大辽国南院大王" NOR);
  set("gender", "男性");
  set("shen_type", 1);
  set("age", 31);
  set("str", 30);
  set("con", 30);
  set("int", 30);
  set("dex", 30);

  create_family("丐帮", 10, "帮主");
  set("long", "
他身材甚是魁伟，身穿灰色旧布袍，
已微有破烂，浓眉大眼，高鼻阔口，
一张四方的国字脸，颇有风霜之色，
顾盼之际，极有威势。\n");

  set("combat_exp", 2000000);
  set("attitude", "heroism");
  set("max_qi", 5000);
  set("max_jing", 3000);
  set("eff_jingli", 3000);
  set("jiali", 50);
  set_skill("force", 200);
  set_skill("huntian-qigong", 200);
  set_skill("literate", 100);
  set_skill("xianglong-zhang", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("strike", 200);
  set_skill("zuibaxian", 200);

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "strike.paiyun" :),
    (: perform_action, "strike.xiao" :),
    (: perform_action, "dodge.zuijiu" :)
  }));

  map_skill("force", "huntian-qigong");
  map_skill("strike", "xianglong-zhang");
  map_skill("dodge", "zuibaxian");
  map_skill("parry", "xianglong-zhang");
  prepare_skill("strike", "xianglong-zhang");
  setup();
  carry_object("/clone/food/jiudai");
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 10);
}

void kill_ob(object me) {
  command("haha");
  this_object()->apply_condition("drunk", 100);
  ::kill_ob(me);

}
