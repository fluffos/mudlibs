#include <ansi.h>

inherit NPC;
string ask_me();

void create() {
  set_name("耶律莫哥", ({ "yelu moge", "moge" }));
  set("title", "南院枢密使");
  set("shen_type", -1);
  set("str", 22);
  set("con", 22);
  set("int", 25);
  set("dex", 22);
  set("gender", "男性");
  set("age", 45);
  set("long", "耶律莫哥当年为北院左将军，萧峰官拜南院大王后
耶律洪基封他为南院枢密使协助萧峰，是南院第二把手。\n");
  set("combat_exp", 100000 + random(5000));
  set("score", 10000);
  set("attitude", "peaceful");
  set("max_qi", 800);
  set("max_jing", 500);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 20);

  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("force", 60);
  set_skill("blade", 60);
  set_skill("unarmed", 60);
  set_skill("literate", 80);

  set("inquiry", ([
    "萧峰": "萧大王出游在外，你有什么事就跟我说吧。\n",
    "效命": (: ask_me :),
  ]));
  setup();
  carry_object(ARMOR_D("junfu"))->wear();
  add_money("gold", 5);
}

string ask_me() {
  object me, ob, obj;
  me = this_player();
  ob = this_object();

  if (objectp(obj = present("jin shuaijian", me)) && obj->query("master") == me->query("id"))
    return "不是在你身上吗，怎么还要？";
  if (objectp(obj = present(
    "jin shuaijian",
    environment(me)
  )) && obj->query("master") == me->query("id"))
    return "不是就在你身边吗，怎么还要？";
  if (me->query_temp("shiwei")) {
    command("hmm");
    return RANK_D->query_respect(me) + "已加入我院，不要再拿在下开玩笑了。\n";
  }
  if (me->query("combat_exp") < 650000) {
    command("laugh");
    command("say 就凭你这点微薄道行，想加入我们萧大王的南院侍卫署？");
    return "还不快给我滚！\n";
  }
  command("welcome " + me->query("id"));
  command("say 有" + me->name() + "加入，我们的实力又壮大了！\n");
  obj = new("/d/rooms/npc/obj/jin-sjian");
  obj->set("master", me->query("id"));
  obj->set("long", HIY "御赐金箭，是大辽皇帝的传令牌。上面写有" + me->query("id") + HIY "的名字。\n" NOR);
  obj->move(ob);
  command("give jin shuaijian to " + me->query("id"));
  return "将此物拿给你挑选的侍卫就行了。\n";
}

void kill_ob(object ob) {
  ob->remove_killer(this_object());
  remove_killer(ob);
}
