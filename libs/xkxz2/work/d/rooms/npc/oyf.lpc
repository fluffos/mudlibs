// oyf.c 欧阳锋

#include <ansi.h>
inherit NPC;

void create() {
  set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
  set("gender", "男性");
  set("title", BLU "西毒" NOR);
  create_family("白陀山庄", 1, "庄主");
  set("shen_type", -1);
  set("age", 70);
  set("str", 30);
  set("con", 30);
  set("int", 30);
  set("dex", 30);
  set("oyf_hamagong", 4);
  set("long",
    "此人便是当世‘五绝’之一的西毒欧阳锋。
他高鼻深目，满脸雪白短须，根根似铁。\n");

  set("combat_exp", 2000000);
  set("attitude", "heroism");
  set("max_qi", 5000);
  set("max_jing", 4000);
  set("eff_jingli", 3000);
  set("jiali", 50);
  set_skill("force", 200);
  set_skill("hamagong", 200);
  set_skill("literate", 100);
  set_skill("poison", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("strike", 200);
  set_skill("hamabu", 200);
  set_skill("staff", 200);
  set_skill("baituo-shezhang", 200);
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "strike.hama" :)
  }));
  map_skill("dodge", "hamabu");
  map_skill("force", "hamagong");
  map_skill("parry", "hamagong");
  map_skill("strike", "hamagong");
  map_skill("staff", "baituo-shezhang");
  prepare_skill("strike", "hamagong");

  set("inquiry", ([
    "欧阳锋": "欧阳锋、欧阳锋，听起来这名字挺熟的。。。\n",
    "洪七公": "洪七公，这名字也熟。\n",
    "蛤蟆功": "蛤蟆功和九阴真经乃是当世两大奇功，余下的都不足为虑。\n",
  ]));
  setup();
  carry_object("/clone/weapon/gangzhang")->wield();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 10);
}


void kill_ob(object me) {
  if (!present("gangzhang", this_object()))
    command("enable parry hamagong");
  command("haha");
  command("yun nizhuan");
  ::kill_ob(me);
}
