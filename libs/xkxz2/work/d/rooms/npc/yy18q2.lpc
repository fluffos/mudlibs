// yy18q.c 燕云十八骑

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";

void create() {
  set_name("侍卫", ({ "shi wei", "shi", "wei" }));
  set("title", HIY "燕云十八骑" NOR);
  set("nickname", HIY "隐" NOR);
  set("str", 40);
  set("con", 30);
  set("int", 25);
  set("dex", 30);
  set("unique", 2);
  set("location", 1);
  set("南院", 1);
  set("gender", "男性");
  set("age", 40);
  set("luohan_winner", 1);
  set("long", "
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出桃花岛。\n");
  set("combat_exp", 800000 + random(100000));
  set("shen", 0);
  set("attitude", "heroism");
  set("thd/perform", 7);
  set("max_qi", 2800);
  set("max_jing", 2000);
  set("max_jingli", 2500);
  set("eff_jingli", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 50);
  set_skill("force", 150);
  set_skill("bihai-chaosheng", 150);
  set_skill("dodge", 150);
  set_skill("suibo-zhuliu", 150);
  set_skill("parry", 150);
  set_skill("strike", 150);
  set_skill("luoying-zhang", 150);
  set_skill("leg", 150);
  set_skill("xuanfeng-tui", 150);
  set_skill("sword", 150);
  set_skill("yuxiao-jian", 150);
  set_skill("taoism", 150);
  set_skill("literate", 100);
  set_skill("qimen-bagua", 150);
  set_skill("throwing", 150);
  set_skill("tanzhi-shentong", 150);
  map_skill("force", "bihai-chaosheng");
  map_skill("dodge", "suibo-zhuliu");
  map_skill("strike", "luoying-zhang");
  map_skill("throwing", "tanzhi-shentong");
  map_skill("leg", "xuanfeng-tui");
  map_skill("parry", "yuxiao-jian");
  map_skill("sword", "yuxiao-jian");
  prepare_skill("strike", "luoying-zhang");
  prepare_skill("leg", "xuanfeng-tui");
  set("chat_chance", 50);
  set("chat_msg", ({ (: checking :) }));
  set("inquiry", ([
    "停": (: stop :),
    "stop": (: stop :),
    "跟": (: follow :),
    "follow": (: follow :),
    "leave": (: leave :),
    "离开": (: leave :),
    "name": (: ask_shi :),
  ]));
  set("chat_chance_combat", 20);
  set("thd/perform", 7);
  set("chat_msg_combat", ({
    (: perform_action, "sword.yuxiao" :),
    (: perform_action, "strike.kuangfeng" :),
  }));
  setup();
  carry_object(ARMOR_D("armor"))->wear();
  carry_object(BINGQI_D("gangjian"))->wield();
  carry_object("/d/rooms/npc/obj/jinpai");
}

int checking() {
  object master, ob;
  mixed *list;
  int i;
  string force;
  ob = this_object();
  list = users();
  i = sizeof(list);
  if ((string)ob->query("master")) {
    while (i--)
      if (list[i]->query("id") == ob->query("master")) master = list[i];
    if (!master) { dest(ob); return 0; }
    if (environment(ob) != environment(master) && living(ob)
      && !ob->is_busy() && ob->query_leader() == master) {
      message_vision("$N快步离开了。\n\n", ob);
      ob->move(environment(master));
      message_vision("$N快步走了过来。\n\n", ob);
    }
  }
  if (!ob->query("master")) return 1;
  if (environment(ob) == environment(master)) {
    force = master->query_skill_mapped("force");
    if (!living(master)) command("get " + master->query("id"));
    if (file_size("/kungfu/skill/" + force + "/heal.lpc") <= 0 &&
      (int)master->query("eff_qi") < (int)master->query("max_qi") &&
      ob->query("neili") > 500 && !ob->is_fight() && !master->is_fight())
      command("yun lifeheal " + master->query("id"));
  }
  return 1;
}
