#include <ansi.h>

inherit ROOM;

string look_wall();

void create() {
  set("short", "石洞");
  set("long", @LONG
眼前出现了个极大的石洞，足可以容得千人之众，洞中有七具骸骨，或坐
或卧，身旁均有兵刃。右首山壁离地数丈处突出一块大石，大石之下石壁上刻
着十六个尺许见方的大字(dazi)，旁边更刻了无数小字(xiaozi)，满壁(wall)
尽是骂人的语句。
LONG);
  set("item_desc", ([
    "dazi": HIY "五岳剑派，无耻下流，比武不胜，暗算害人\n" NOR,
    "xiaozi": HIG "都是些“卑鄙无耻”、“可耻之极”、“低能”、“懦怯”等等诅咒字眼。\n" NOR,
    "wall": (: look_wall :)
  ]));
  set("exits", ([
    "right": __DIR__ "kongdao",
  ]));
  set("indoors", "华山");

  setup();
}

string look_wall() {
  object me = this_player();

  if (!present("sword book", me)
    || me->query_skill("sword", 1) < 30
    || me->query_skill("sword", 1) > 100) {
    switch (random(2)) {
      case 0:
        return "只见一行字刻着道：“范松赵鹤破恒山剑法于此。”这一行之旁是无数人形，\n"
          "每两个人形一组，一个使剑而另一个使斧，粗略一计，少说也有五六百个人形，\n"
          "显然是使斧的人形在破解使剑人形的剑法。\n";
      case 1:
        return "赫然出现一行字迹：“张乘云张乘风尽破华山剑法。”字旁一个图形，使剑人\n"
          "形一招华山剑法的「有凤来仪」，剑势飞舞而出，轻盈灵动。与之对拆人形手\n"
          "中持着一条直线形的兵刃，直指对方剑尖，姿势异常笨拙。\n";
    }
  }
  write("你对着石壁上的图形揣摩了一会，若有所悟。\n");
  me->receive_damage("jing", 30);
  me->receive_damage("jingli", 10);
  me->improve_skill("sword", me->query("int"));
  return "";
}
