// book-zixia.c  紫霞秘籍

inherit ITEM;

void create() {
  set_name("紫霞秘籍", ({ "zixia miji", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一册紫霞秘籍，上面记录了许多打坐吐呐的图谱。\n");
    set("value", 5000);
    set("treasure", 1);
    set("material", "paper");
    set("skill", ([
      "name": "zixia-gong",  // name of the skill
      "exp_required": 0,  // minimum combat experience required
      "jing_cost": 15,  // jing cost every time study this
      "difficulty": 10,  // the base int to learn this skill
      "max_skill": 41  // the maximum level you can learn
    ]));
  }
}
