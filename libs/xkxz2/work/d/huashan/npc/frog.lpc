// frog.c 青蛙

inherit NPC;

void create() {
  set_name("青蛙", ({ "frog", "qingwa" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "这是一个肥大的青蛙。\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "后脚" }));
  set("verbs", ({ "hoof", "bite" }));

  set("combat_exp", 100);
  set("shen_type", -1);
  set("chat_chance", 10);

  set("chat_msg", ({
    "青哇叫道：呱呱呱。。。呱呱呱。。。\n",
  }));
  set("str", 10);
  set("dex", 15);
  set("con", 10);
  //      set_temp("apply/attack", 5);
  //      set_temp("apply/dodge", 20);
  //      set_temp("apply/armor", 5);

  setup();
}

void die() {
  object ob;
  message_vision("$N凄惨的嚎了几声，死了。\n", this_object());
  ob = new(__DIR__ "frog-meat");
  ob->move(environment(this_object()));
  destruct(this_object());
}
