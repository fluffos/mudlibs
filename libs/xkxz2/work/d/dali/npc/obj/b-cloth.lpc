// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(RED "三点式" NOR, ({ "beyond cloth", "cloth" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件烟儿姑娘穿着的服装，具有极强的保护功能。\n");
    set("unit", "件");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 99000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N不好意思的披上一件" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将身上的" + "$n" NOR + "脱了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
