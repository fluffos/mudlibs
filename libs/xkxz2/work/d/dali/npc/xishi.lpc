//  /d/dali/npc/dasao.c

inherit NPC;
inherit F_DEALER;

void create() {
  set_name("豆腐西施", ({ "doufu xishi", "xishi" }));
  set("title", "豆腐坊老板娘");
  set("shen_type", 1);

  set("gender", "女性");
  set("age", 25);
  set("long",
    "这位老板娘风情万种，颇有几粉姿色。\n");
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/damage", 25);

  set("combat_exp", 8000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/doufu1",
    __DIR__ "obj/doufu2",
    __DIR__ "obj/doufu3",

  }));

  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
