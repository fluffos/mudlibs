//qinbing.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("皇宫亲兵", ({ "huanggong qinbing", "qinbing" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "他是当今大理国守卫皇宫的亲兵。\n");
  set("combat_exp", 50000);
  set("attitude", "heroism");

  set("str", 23);
  set("con", 23);
  set("int", 23);
  set("dex", 23);

  set("max_qi", 400);
  set("eff_qi", 400);
  set("qi", 4500);
  set("max_jing", 250);
  set("jing", 200);
  set("neili", 300);
  set("max_neili", 300);
  set("jiali", 10);

  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);

  set_skill("sword", 60);
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set("chat_chance", 10);

  setup();

  carry_object("/d/city/obj/gangjian")->wield();
  carry_object("/d/city/obj/tiejia")->wear();
}
