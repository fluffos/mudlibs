#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "推荐信" NOR, ({ "tuijian xin", "xin" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long",
      "这是一封镇南王亲笔手书的推荐信，信是写给天龙寺本因大师的。\n");
    set("treasure", 1);
    set("no_get", 1);
    set("value", 0);
    set("material", "paper");
  }
}
