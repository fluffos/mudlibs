inherit ITEM;

void create() {
  set_name("金令", ({ "jin ling", "ling", "iron" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块金色的令牌，上面写着 [巡城令，各城门准予放行] \n");
    set("value", 10000);
    set("material", "iron");
  }
  setup();
}

void init() {
  call_out("dest", 900);
}

void dest() {
  destruct(this_object());
}
