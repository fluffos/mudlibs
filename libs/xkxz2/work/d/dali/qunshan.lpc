inherit ROOM;

void create() {
  set("short", "梅里雪山");
  set("long", @LONG
这里高峰耸立，终年积雪，常年悬挂现代高山冰川，俨然是一个冰雪世
界。春夏之交，部分积雪融化，冰水泻而下，白练悬空，蔚为奇观。地势险
峻，坡度很陡。整个坡面的直线距离为十二公里。如此深切、陡峭的高山纵
谷地形，是罕见的景观。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "futiao",
    "northdown": __DIR__ "tianchi1",
  ]));

  setup();
  replace_program(ROOM);
