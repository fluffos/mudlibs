inherit ROOM;

void create() {
  set("short", "鸡足山");
  set("long", @LONG
巍峨秀丽的鸡足山，屹立在滇西的宾川、大理、邓川、永胜、鹤床等县
的交界处，它以耸入云表的天柱峰为中枢，前列三峰，后拖一岭，形如鸡足
而得名。在方圆二百余里的莽莽大山中，又分为文笔、象鼻、满月等四十余
座小山，有天柱、凤头等古三峰，风汉壁、舍身崖等三十四座石壁，有传经
洞等四十五个崖窟，有乌龙潭、洗心涧、玉龙瀑布等溪泉一百余个。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "westdown": __DIR__ "jzs2",
  ]));

  setup();
  replace_program(ROOM);
}
