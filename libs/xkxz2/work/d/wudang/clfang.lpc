// clfang.c 操练房

inherit ROOM;

void create() {
  set("short", "操练房");
  set("long", @LONG
这是二楼操练房上，四面八方都是打斗声，武当弟子来去匆匆。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "xilang1",
    "west": __DIR__ "wclfang",
    "north": __DIR__ "nclfang",
    "south": __DIR__ "sclfang",
  ]));
  setup();
  replace_program(ROOM);
}
