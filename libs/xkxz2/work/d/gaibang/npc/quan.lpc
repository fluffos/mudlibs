inherit NPC;
inherit __DIR__ "gaibang_npc.lpc";

void create() {
  set_name("全冠清", ({ "quan guanqing", "quan" }));
  set("title", "丐帮大智分舵舵主");
  set("nickname", "十方秀才");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是八袋舵主，掌管大智分舵，为人足智多谋，武功高强。\n");
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 35);
  set("con", 20);
  set("dex", 25);

  set("qi", 1200);
  set("max_qi", 1200);
  set("jing", 900);
  set("max_jing", 900);
  set("neili", 1600);
  set("max_neili", 1600);
  set("jiali", 100);

  set("combat_exp", 400000);

  set_skill("force", 130);  // 基本内功
  set_skill("huntian-qigong", 130);  // 混天气功
  set_skill("strike", 130);  // 基本拳脚
  set_skill("dodge", 130);  // 基本躲闪
  set_skill("xiaoyaoyou", 120);  // 千里行乞 
  set_skill("parry", 120);  // 基本招架
  set_skill("chousui-zhang", 130);

  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("strike", "chousui-zhang");
  map_skill("parry", "chousui-zhang");
  prepare_skill("strike", "chousui-zhang");

  create_family("丐帮", 19, "八袋弟子");
  set("chat_chance", 2);
  set("chat_msg", ({
    "全冠清哼了一声：刘竹庄这小子都不知跑哪去了，干小小事情，这么久了，还没回来。\n",
    //		(: random_move :),
  }));

  set("inquiry", ([
    "丐帮": "我们丐帮是天下第一大帮！\n",
    "乔峰": "嘿嘿，他早给我们废了。\n",
    "升袋": (: ask_me :),
  ]));
  setup();
  carry_object(__DIR__ "obj/gb_budai8")->wear();
}

int accept_object(object who, object ob) {
  if (promotion_checking(who, ob)) return 1;
  else return 0;
}
