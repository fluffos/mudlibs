inherit NPC;

void create() {
  set_name("戚芳", ({ "wan furen", "qi", "furen" }));
  set("long", "这是一个中年女人，容颜俏丽，面含微笑。\n");
  set("gender", "女性");
  set("age", 40);
  set("attitude", "friendly");
  set("str", 30);
  set("dex", 35);
  set("con", 17);
  set("int", 25);
  set("per", 25);
  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("cuff", 80);
  set("chat_chance", 3);
  set("chat_msg", ({
    "戚芳喃喃念叨：“空心菜……空心菜。”\n",
    "戚芳喃喃念叨：“难道你是被人冤枉的？”\n",
  }));

  set_skill("dodge", 80);
  set("combat_exp", 150000);
  set("max_qi", 500);
  set("max_jing", 400);
  set("neili", 900);
  set("max_neili", 900);
  setup();
  carry_object(ARMOR_D("cloth"))->wear();
}
