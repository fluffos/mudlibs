// /d/xueshan/fatan05.c 法坛
// by dubei
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "法坛" NOR);
  set("long", @LONG
这里是大轮寺法坛，每年远在天竺的高僧都要来此研习上乘佛法，这个法
坛的面积远不如紫金法坛大，全是由白石砌成，好不庄严，四壁上雕刻着罗汉
金刚，有的降龙伏虎，有的在打坐讼经，个个都是栩栩如生，令人叹为观止。
其中有个罗汉(luohan)雕的身高体胖，双手合十，注视着面前一座石碑，凝神
不动，似乎要以掌力震碎这块巨石。
LONG);
  set("exits", ([
    "east": __DIR__ "fatan03",
    "northwest": __DIR__ "fatan06"
  ]));

  setup();
}
void init() {
  add_action("do_yanxi", "yanxi");
}

int do_yanxi(string arg) {
  object me;
  int i;
  me = this_player();
  i = me->query_int();

  if (arg != "luohan") return 0;
  if (!living(me)) return 0;

  if (me->is_busy() || me->is_fighting()) {
    write("你此刻正忙着呢,不能研习罗汉！\n");
    return 1;
  }
  if ((int)me->query("jing") < 50) {
    write("你太累了，无法继续研习！\n");
    return 1;
  }
  if ((int)me->query_skill("hand", 1) > 101) {
    write("你已经尽数领悟了这里的功夫。\n");
    return 1;
  }


  if ((int)me->query_skill("literate", 1) < 30) {
    write("你读书写字水平不够,无法领悟此地的经文。\n");
    return 1;
  }
  if ((int)me->query_skill("hand", 1) < 61) {
    write("这里对你来说太难了。\n");
    return 1;
  }
  if ((int)me->query_skill("lamaism", 1) < 61) {
    write("你的密宗心法不够。这些梵文对你来说太难了。\n");

    return 1;
  }
  me->receive_damage("jing", 25 + random(20));
  me->improve_skill("hand", i * 2 / 3);
  message_vision("$N正专心研习四壁上的罗汉，似乎有所心得。\n", me);
  return 1;
}
