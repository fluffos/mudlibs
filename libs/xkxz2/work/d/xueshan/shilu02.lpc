// shilug02.c 石板路
inherit ROOM;


void create() {
  set("short", "石板路");
  set("long", @LONG
你终于走到了石板路的尽头。忽然，你眼前忽然一亮，前面是一座高高的
金色法坛，两侧均是喇嘛们参加法事后研习佛法武功的禅室。本寺高僧金轮法
王就居住在法坛之中的法王禅室。对于刚刚出家的喇嘛们，登上法坛是对法王
的亵渎，将受到严厉惩戒。
LONG);
  set("exits", ([
    "north": __DIR__ "chanshi01",
    "south": __DIR__ "chanshi02",
    "east": __DIR__ "shilu01",
    "westup": __DIR__ "fatan01"
  ]));
  set("objects", ([
    __DIR__ "npc/xlama": 1,
    "/kungfu/class/xueshan/zhishan": 1,
  ]));
  setup();
  replace_program(ROOM);
}
