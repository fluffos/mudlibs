// xiaomen.c 小门
#include <room.h>
inherit ROOM;

void create() {
  set("short", "小门");
  set("long", @LONG 
这里是通往寺院后院的一道小门，只有在寺中修行到一定程度的大喇嘛才
能由此进入后院法坛修行高深佛法，并可以拜见寺中主持大轮明王，吐蕃护国
法王鸠摩智。门口每日不分昼夜，均有武功高强的大喇嘛担任护法，外人擅自
进入法坛，不免得罪佛祖，降祸于身。
LONG);
  set("exits", ([
    "north": __DIR__ "zoulang03",
    "south": __DIR__ "zoulang04",
    "east": __DIR__ "houdian",
    "west": __DIR__ "shilu01",
  ]));
  set("objects", ([
    "/kungfu/class/xueshan/daerba": 1,
    __DIR__ "npc/xlama": 1,
  ]));
  setup();
  create_door("west", "小门", "east", DOOR_CLOSED);
}
int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if ((!myfam || myfam["family_name"] != "密宗") &&
    objectp(present("daerba", environment(me))) && dir == "west" && (!me->query_temp("mz_baijian")))
    return notify_fail("达而巴厉声道：此乃我大轮寺重地，未经过主持许可，不许进入。\n");

  if ((int)me->query_skill("lamaism", 1) < 31 &&
    objectp(present("daerba", environment(me))) && dir == "west")
    return notify_fail("达而巴伸手一拦,说道：你身份不够，不能进入里面。\n");

  return ::valid_leave(me, dir);
}
