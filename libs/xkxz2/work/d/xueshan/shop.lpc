// shop.c

inherit ROOM;

void create() {
  set("short", "杂货店");
  set("long", @LONG
这是一间小小的杂货店，经营些油、盐、酱、醋及日用百货，村子里
的人多数是很穷，除了生活必需品，这里很少贩卖其它物品。
LONG
  );
  set("exits", ([
    "out": __DIR__ "cunluo01",
  ]));
  set("no_clean_up", 0);

  set("objects", ([
    __DIR__ "npc/laoban": 1
  ]));

  setup();
  replace_program(ROOM);
}
