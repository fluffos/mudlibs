// fatan06.c 法坛

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "法坛" NOR);
  set("long", @LONG
这里是大轮寺法坛，每年远在天竺的高僧都要来此研习上乘佛法，这个法
坛的面积远不如紫金法坛大，全是由白石砌成，好不庄严，四壁上雕刻着罗汉
金刚，有的降龙伏虎，有的在打坐讼经，个个都是栩栩如生，令人叹为观止。
两侧是两座高塔，看来是传说中的舍利塔了。
LONG);
  set("exits", ([
    "northeast": __DIR__ "fatan04",
    "southeast": __DIR__ "fatan05"
  ]));

  setup();
  replace_program(ROOM);
}
