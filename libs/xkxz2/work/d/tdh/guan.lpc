// /u/dubei/tdh/npc/guan
// by bubei

inherit NPC;

int ask_me_renwu();
int ask_me_gl();
void create() {
  set_name("关安基", ({ "guan anji", "guan" }));
  set("nickname", "关夫子");
  set("long",
    "他就是天地会青木堂的关安基。\n"
    "此人身高体壮，一部长须飘在胸前，模样甚是威严。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen", 4000);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);
  set("max_qi", 1000);
  set("max_jing", 1500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 50);
  set("combat_exp", 400000);


  set_skill("force", 100);
  set_skill("yinyun-ziqi", 100);
  set_skill("dodge", 100);
  set_skill("tiyunzong", 100);
  set_skill("cuff", 130);
  set_skill("wudang-quan", 100);
  set_skill("parry", 100);
  set_skill("hand", 100);
  set_skill("juehu-shou", 120);
  set_skill("sword", 100);
  set_skill("taoism", 100);
  set_skill("literate", 100);

  map_skill("force", "yinyun-ziqi");
  map_skill("dodge", "tiyunzong");
  map_skill("cuff", "wudang-quan");
  map_skill("hand", "juehu-shou");
  map_skill("parry", "juehu-shou");
  prepare_skill("cuff", "wudang-quan");
  prepare_skill("hand", "juehu-shou");
  //        create_family("天地会", 2, "代香主");
  set("inquiry", ([
    "反清复明": (: ask_me_renwu :),
    "功劳": (: ask_me_gl :),
  ]));

  setup();
  carry_object("/clone/armor/cloth")->wear();

}



int ask_me_renwu() {
  object me;

  me = this_player();

  if (!me->query("tdh_pass"))
    return notify_fail("阁下非我会中好汉，未饮血酒盟誓，怎麽能为天地会出力呢？");
  if (me->query_condition("gb_mission") || me->query_condition("guanfu_task") || me->query_condition("xx_task")
    || me->query_condition("xx_task") || me->query_condition("xx_task2") || me->query_condition("dali_songxin"))
    return notify_fail("你现在和江湖其他帮会纠葛不清，我不能交给你任务。");
  if (me->query_condition("tdhbh_task") || me->query_condition("thdk_task") || me->query_condition("thdx_task")
    || me->query_condition("tdh_task_wait"))
    return notify_fail("你正在执行天地会青木堂的任务！");

  switch (random(3)) {
    case 0:
      me->set_temp("tdh_xuan", 1);
      me->apply_condition("tdh_task_wait", 20);
      command("say 很好，你现在到玄贞道人那里去看看，可能需要人手帮忙。");
      break;
    case 1:
      command("say 很好，你现在到高彦超那里去看看，可能需要人手帮忙。");
      me->set_temp("tdh_guao", 1);
      me->apply_condition("tdh_task_wait", 20);
      break;
    case 2:
      command("say 很好，你现在到李力世那里去看看，可能需要人手帮忙。");
      me->set_temp("tdh_li", 1);
      me->apply_condition("tdh_task_wait", 20);
  }
  //       command("say 目前会中兄弟都出去了，你等等吧。");
  return 1;
}
int ask_me_gl() {
  object me;
  int tdhtime, tdhgl, nos;
  me = this_player();
  tdhtime = (int)me->query("tdh_job", 1);
  tdhgl = (int)me->query("tdh_jilu", 1);
  //       if (!me->query("tdh_jiluno"))
  //       tdhgl == 0

  if (!me->query("tdh_pass"))
    return 0;
  if (tdhtime < 1) {
    command("say 你没为天地会出过什麽力，跑到这里要什麽功劳？");
    return 1;
  }
  if ((tdhtime - 15) > tdhgl) {
    nos = (tdhtime - tdhgl);
    message_vision("关夫子从怀中掏出一本小册子，翻了翻。\n", me);
    command("say  你为反清复明大业出生入死，尽了不少力，我就代总舵主传授给你一些武学要旨吧。");
    message_vision("关夫子在$N耳边轻声说了些什麽。\n", me);
    write("关夫子在你耳边讲述了一些武学要旨和实战经验，你觉得受益非浅。\n");
    me->add("combat_exp", 100 * nos);
    me->add("potential", 50 * nos);
    me->set("tdh_jilu", tdhtime);
    return 1;
  }
  command("say 你目前已经为天地会出过" + tdhtime + "次力，反清复明制日可待了。");
  return 1;
}
