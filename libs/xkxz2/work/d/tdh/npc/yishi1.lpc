inherit NPC;
void create() {
  set_name("反清义士", ({ "yi shi", "yi", "shi" }));
  set("gender", "男性");
  set("age", 22 + random(20));
  set("long",
    "这是位志在反清复明的壮士。\n");
  set("combat_exp", 100000);
  set("shen", 900);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);
  set("max_qi", 500);
  set("max_jing", 1000);
  set("neili", 2000);
  set("max_neili", 1000);
  set("jiali", 50);
  set("combat_exp", 100000);
  set_skill("force", 30);
  set_skill("xuantian-wuji", 30);
  set_skill("dodge", 40);
  set_skill("cuff", 40);
  set_skill("taizu-quan", 40);
  set_skill("kunlun-shenfa", 40);
  set_skill("parry", 30);
  set_skill("sword", 30);

  map_skill("force", "xuantian-wuji");
  map_skill("cuff", "taizu-quan");
  map_skill("dodge", "kunlun-shenfa");
  prepare_skill("cuff", "taizu-quan");
  setup();

  carry_object("/clone/misc/cloth")->wear();
}
