int ask_test3();
int ask_yuxiao();
int ask_shenjian();
int ask_kuangfeng();
int ask_lingxi();
int ask_huayu();
int ask_repair();
int ask_nvxu();

void create() {
  object ob;
  set_name("黄药师", ({ "huang yaoshi", "huang", "yaoshi" }));
  set("nickname", "桃花岛主");
  set("long",
    "他就是桃花岛的岛主，江湖上人人闻名变色的东邪黄药师。\n"
    "他身穿一件青色长袍，腰带上斜插着一只玉箫。\n"
    "他形相清癯，丰姿隽爽，萧疏轩举，湛然若神。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("apprentice", 1);
  set("str", 30);
  set("int", 50);
  set("con", 26);
  set("dex", 30);
  set("max_qi", 4000);
  set("max_jing", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);
  set("combat_exp", 2000000);
