#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIY "聚议厅" NOR);
  set("long", @LONG
这里是教主召集左右使者，四大护法，五散人，五行旗主商议反元抗胡
，行善去恶，除暴安良的对策的地方。东面是龙王殿，西面是狮王殿。后面
是圣火堂。
LONG);
  set("exits", ([
    "south": __DIR__ "xting",
    "northup": __DIR__ "sht",
    "east": __DIR__ "shiwang",
    "west": __DIR__ "longwang",
  ]));
  set("objects", ([
    __DIR__ "npc/fan": 1,
    __DIR__ "npc/f-dizi": 2,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if ((!myfam || myfam["family_name"] != "明教") && dir == "northup" &&
    objectp(present("fan yao", environment(me))))
    return notify_fail("范遥把手一伸拦住你的去路。\n" NOR);
  if (me->query_skill("shenghuo-shengong", 1) < 70 && dir == "northup" &&
    objectp(present("fan yao", environment(me))))
    return notify_fail("范遥对着你摇了摇头：教主现在很忙，你以后再来吧。\n" NOR);
  return ::valid_leave(me, dir);
}
