#include <room.h>
inherit ROOM;
void create() {
  set("short", "黄土坪");
  set("long", @LONG
这是一片较大的黄土坪。周围只有几株已干枯的古树和黄沙。可以看出
这里以前曾是绿洲，东边是一个个小沙丘。
LONG);
  set("exits", ([
    "southeast": __DIR__ "shaqiu4",
    "east": __DIR__ "shaqiu" + (random(3) + 1),
    "west": __DIR__ "dashaqiu",
    "south": __DIR__ "shaqiu" + (random(3) + 1),
  ]));
  set("objects", ([
    __DIR__ "npc/yinwufu": 1,
    __DIR__ "npc/m-dizi": 1,
  ]));
  set("outdoors", "明教光明顶");
  setup();
  replace_program(ROOM);
}
