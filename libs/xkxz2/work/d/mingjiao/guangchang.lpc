inherit ROOM;
void create() {
  set("short", "广场");
  set("long", @LONG
这是一个十分大的广场，它足于容下上千人，这里是当年张教主力拼六
大门派的地方，使得明教和六大门派之间的仇恨得以排除。这里平时可看到
很多的明教弟子在这练功。东面有一株三丈来高的大松树。东西是通往练武
场的走廊。
LONG);
  set("exits", ([
    "west": __DIR__ "zl1",
    "east": __DIR__ "zl2",
    "south": __DIR__ "wu3",
    "north": __DIR__ "wu1",
  ]));
  set("objects", ([
    __DIR__ "npc/wei": 1,
    __DIR__ "npc/m-dizi": 1,
    __DIR__ "npc/f-dizi": 1,
  ]));
  set("outdoors", "明教光明顶");
  setup();
}
