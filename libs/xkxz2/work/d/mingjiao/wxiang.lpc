#include <room.h>
inherit ROOM;
void init();
void create() {
  set("short", "西厢房");
  set("long", @LONG
你一进来一看，这里竟似一间大户人家小姐的闺房。靠窗边的
是一张梳张台，台上红烛高烧，照耀得房中花团锦簇，堂皇富丽，
另一边是一张牙床，床上罗帐(zhang)低垂，西边是一块挂毯。
LONG);
  set("exits", ([
    "east": __DIR__ "yuanzi",
  ]));
  set("item_desc", ([
    "zhang": "这是一条低垂的罗帐，但好象有人在内面睡觉。\n"
  ]));
  set("objects", ([
    __DIR__ "npc/yang1": 1,
  ]));
  setup();
}
void init() {
  add_action("do_xian", "xian");
  add_action("do_tang", "tang");
}

int do_xian(string arg) {
  object me;
  me = this_player();
  if (!arg) return 0;
  if (arg != "zhang") return 0;
  if (arg == "zhang") {
    write("你掀开罗帐，突然发现罗帐内面有一张大牙床，你忍不住想躺(tang)下来美美的睡上一觉。\n");
    this_player()->set_temp("marks/掀1", 1);
    return 1;
  }
}
int do_tang(string arg) {
  object me;
  me = this_player();
  if (me->query_temp("marks/掀1")) {
    message("vision", me->name() + "慢慢的向床上躺去，突然床板一侧，他就摔了下去。\n", environment(me), ({ me }));
    me->move(__DIR__ "didao/bidao1");
    message("vision", me->name() + "突然间从上面摔了下来。\n", environment(me), ({ me }));
    this_player()->delete_temp("marks/掀1");
    return 1;
  }
}
