// Room: /u/xdd/gumu/guoyuan.c

#include <ansi.h>;
inherit ROOM;

void create() {
  set("short", RED "果园" NOR);
  set("long", @LONG
转过山腰，居然出现一大片果林。果树高大茂盛，枝叶繁密，累累鲜果(guo)，
鲜嫩诱人。清风拂叶，沙沙作响，更令这群果随风招摇起舞，送来阵阵果香。但听
密林深处，杜鹃儿间或轻啼。看来你可大大饱餐一顿了。林子边上有一汪清泉(quan).
LONG);
  set("exits", ([
    "south": __DIR__ "rukou",
  ]));
  setup();
}

void init() {
  add_action("do_cai", "cai");
  add_action("do_he", "he");
}

int do_cai(string arg) {
  object me = this_player();
  if (arg == "guo") {
    message_vision("$N伸手从树上摘下一个苹果。\n", me);
    new(__DIR__ "obj/guo")->move(me);
    return 1;
  }
  return notify_fail("你要采什么? \n");
}

int do_he(string arg) {
  object me = this_player();
  if (arg == "quan") {
    if (me->query("water") < me->query("str") * 10 + 100) {
      message_vision("$N捧起一汪清泉，美美地喝了一口。\n", me);
      me->add("water", 50, me);
      return 1;
    }
    return notify_fail("你喝太多了，不怕撑死？\n");
  }
  return notify_fail("你要喝什么？\n");
}
