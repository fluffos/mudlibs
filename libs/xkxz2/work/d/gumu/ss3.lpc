// sl1.c
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", BLU "石室" NOR);
  set("long", @LONG
古墓中阴沉的石室，只听见远远传来你脚步的回音，空荡荡的感觉使你
心中只有恐惧，甚至忘记孤独。你不知身处何地，四周如此漆黑一片，只能
靠摸索前行。
LONG
  );

  set("exits", ([
    "east": __FILE__,
    "west": __DIR__ "ss4",
    "south": __DIR__ "ss1",
    "north": __FILE__,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east")
    me->add_temp("mark/steps", 1);
  if (dir == "south")
    me->add_temp("mark/step", 1);
  if (dir == "west")
    me->add_temp("mark/steps", -1);
  if (dir == "north")
    me->add_temp("mark/step", -1);
  if ((me->query_temp("mark/steps") == 6) &&
    (me->query_temp("mark/step") == 4)) {
    me->move(__DIR__ "gmmshi1");
    me->delete_temp("mark/steps");
    me->delete_temp("mark/step");
  }

  if ((me->query_temp("mark/steps") == -6) &&
    (me->query_temp("mark/step") == -4)) {
    me->move(__DIR__ "rukou");
    me->delete_temp("mark/steps");
    me->delete_temp("mark/step");
  }

  return ::valid_leave(me, dir);
}
