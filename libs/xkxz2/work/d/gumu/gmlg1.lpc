#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", BLU "练功房1" NOR);
  set("long", @LONG
这是一间密闭的石室，室中点着灯火，石室奇小，仅容一人周转，此处
供古墓弟子修炼入门武功，天罗地网势。室内有三只麻雀。
LONG);

  set("exits", ([
    "north": __DIR__ "gmzt",
  ]));
  create_door("north", "石门", "south", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_zhuo", "zhuo");
}

int do_zhuo() {
  mapping fam;
  object me = this_player();
  int i;

  if (!living(me)) return 0;
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派")
    return notify_fail("你非古墓弟子，跑到这里练什麽呢？\n");
  //	  if ( (int)me->query_skill("dodge", 1) < 0 )
  //	  return notify_fail("你的基本轻功不行, 恐怕捉不到麻雀。\n");

  if ((int)me->query_skill("dodge", 1) > 31)
    return notify_fail("你不用在这里浪费时间精力了。\n");

  if ((int)me->query("jingli") < 40 && (int)me->query("jing") < 40)
    return notify_fail("你太累了, 先休息一下。\n");

  //	  i = me->query_skill("dodge", 1) / 10;
  i = (int)(me->query_dex() * 2 / 3);

  me->receive_damage("jing", 5 + random(8));
  me->receive_damage("jingli", 5 + random(8));

  if (random(i) < 3) {
    message_vision("$N气喘吁吁，累得满头大汗，别说捉到，连羽毛也碰不到一根。\n", me);
  } else {
    message_vision("$N累得满头大汗，终於抓到了麻雀。\n", me);
    me->improve_skill("dodge", random(5) + i);

    me->add("combat_exp", random(3));
  }

  return 1;
}
