#include <ansi.h>

inherit ITEM;

void init() {
  if (present(this_object(), this_player())) {
    add_action("do_eat", "eat");
    add_action("do_eat", "chi");
    add_action("do_eat", "yan");
    add_action("do_eat", "tun");
  }
}

void create() {
  set_name(HIG "易骨丹" NOR, ({ "yigu dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一颗" HIG "绿色" NOR "的丹丸，吃了不知道会......\n");
    set("value", 0);
    set("unit", "颗");
    set("no_get", 1);
    set("no_drop", 1);
  }
}

int do_eat(string arg) {
  int i, lvl = 1;
  mapping skills;
  string *sk;

  object me = this_player();
  if (!living(me)) return notify_fail("想当机吗？\n");
  if (!id(arg)) return 0;
  message_vision(HIG "$N大口地吃下一颗"
    +this_object()->query("name") +
    HIG "，脸色由红变绿，由青变黑，大叫一声不动了。\n"
    NOR, me);
  me->add("dex", 11);
  me->add("int", -9);
  me->add("con", -2);
  me->unconcious();
  return 1;
}
