// semote.c

#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *e, out = "";
  int i, j = 0, day;
  mapping emote;

  e = sort_array(EMOTE_D->query_all_emote(), 1);

  if (arg && sscanf(arg, "-r %d", day) && day >= 1) {
    if (day == 0)
      return notify_fail("没有 0 天的天数。\n");
    out = HIM "按照时间顺序显示" + MUD_NAME + "最近" + chinese_number(day) + "天的表情动词：\n" NOR
      "───────────────────────────────────\n";
    for (i = 0; i < sizeof(e); i++) {
      emote = EMOTE_D->query_emote(e[i]);
      if (emote["time"] + 86400 * day < time())
        continue;
      out += sprintf("%-13s%s", e[i], (j++ % 6 == 5) ? "\n" : "");
    }
    me->start_more(out + "\n"
      "───────────────────────────────────\n");
    return 1;
  } else {
    out = HIM + MUD_NAME + (arg ? ("包含 " + arg + " ") : "所有") + "的表情动词列表：\n" NOR + "────────────────────────────────────\n";
    for (i = 0; i < sizeof(e); i++) {
      if (arg && strsrch(e[i], arg))
        continue;
      out += sprintf("%-13s%s", e[i], (j++ % 6 == 5) ? "\n" : "");
    }
    me->start_more(out + "\n"
      "────────────────────────────────────\n");
    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式 : semote [-r] [i]

这个指令可以列出目前所能使用的 emote，如果使用
-r 参数，则列出最近 i 天的新增和新修改的emote。

HELP
  );
  return 1;
}
