// help.c

#include "/doc/help.h"
#include "/doc/wizhelp.h"
#include <ansi.h>;

inherit F_CLEAN_UP;

string *default_search = DEFAULT_SEARCH_PATHS;
string *default_wiz_search = DEFAULT_WIZ_SEARCH_PATHS;

int main(object me, string arg) {
  int i;
  string file, map, *search, output;

  if (!arg) {
    output = trans_color(read_file(HELP_DIR + "help/topics"), 2);
    me->start_more(output);
    return 1;
  }

  seteuid(getuid());

  if (pointerp(search = me->query("help_search_path"))) {
    i = sizeof(search);
    while (i--) if (file_size(search[i] + arg) > 0) {
      output = trans_color(read_file(search[i] + arg), 2);
      me->start_more(output);
      return 1;
    }
  }

  sscanf(arg, "%s()", arg);

  if (wizardp(me) && pointerp(default_wiz_search)) {
    i = sizeof(default_wiz_search);
    while (i--) if (file_size(default_wiz_search[i] + arg) > 0) {
      output = trans_color(read_file(default_wiz_search[i] + arg), 2);
      me->start_more(output);
      return 1;
    }
  }

  if (pointerp(default_search)) {
    i = sizeof(default_search);
    while (i--) if (file_size(default_search[i] + arg) > 0) {
      output = trans_color(read_file(default_search[i] + arg), 2);
      me->start_more(output);
      return 1;
    }
  }

  if (stringp(file = me->find_command(arg))) {
    notify_fail("有这个指令存在，但是并没有详细的说明文件。\n");
    return file->help(me);
  }

  return notify_fail("没有针对这项主题的说明文件。\n");
}

int help(object me) {
  write(@HELP
指令格式：help <主题>              例如：> help cmds
          help <函数名称>()        例如：> help call_out()

这个指令提供你针对某一主题的详细说明文件，若是不指定主题，则提供你有关
主题的文件。
HELP
  );
  return 1;
}
