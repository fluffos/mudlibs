// title.c (Mon 09-04-95)

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!SECURITY_D->valid_grant(me, "(apprentice)"))
    return 0;

  if (!arg) {
    printf(BOLD "%s" NOR "%s\n", RANK_D->query_rank(me), me->short(1));
    return 1;
  }
  if (strlen(arg) > 73)
    return notify_fail("你的title太长了，想一个短一点的、响亮一点的。\n");
  if (arg == "none") {
    me->delete("title");
    write("您的title已经被删除了。\n");
    printf(BOLD "%s" NOR "%s\n", RANK_D->query_rank(me), me->short(1));
    return 1;
  }
  arg = trans_color(arg, 2);
  me->set("title", arg + NOR);
  printf(BOLD "%s" NOR "%s\n", RANK_D->query_rank(me), me->short(1));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: title [none]
 
显示你目前的阶级和头衔。

HELP);
  return 1;
}
