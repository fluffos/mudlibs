// dump.c (should be admin cmd?)

inherit F_CLEAN_UP;

int main(object me, string arg) {
  seteuid(geteuid(me));

  if (!SECURITY_D->valid_grant(me, "(admin)"))
    return 0;

  dumpallobj();
  log_file("DUMP", me->query("id") + " DUMP 了所有物件。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : dump
 
DUMP 所有的物件。

HELP
  );
  return 1;
}
