// /kungu/class/xueshan/xuedao-laozu.c
// by dubei

inherit NPC;
inherit F_MASTER;

string ask_me_1();
void create() {
  object ob;
  set_name("血刀老祖", ({
    "xuedao laozu",
    "laozu",
  }));
  set("long",
    "他就是恶名远扬的血刀门第四代掌教血刀老祖。\n"
    "一个身穿黄色僧的老和尚,尖头削耳,脸上堆满了皱纹.\n"
  );
  set("nickname", "血刀恶僧");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "lama");
  set("per", 8);
  set("age", 79);
  set("shen", -25000);
  set("str", 38);
  set("int", 25);
  set("con", 30);
  set("dex", 32);
  set("max_qi", 4000);
  set("max_jing", 3500);
  set("neili", 3500);
  set("max_neili", 4000);
  set("jiali", 50);
  set("combat_exp", 1800000);
  set("unique", 1);
  set("eff_jingli", 2500);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.jixue" :),
    (: exert_function, "fumozhou" :),
  }));
  set_skill("force", 180);
  set_skill("longxiang-gong", 160);
  set_skill("dodge", 180);
  set_skill("qingshen-fa", 180);
  set_skill("cuff", 180);
  set_skill("fuhu-quan", 180);
  set_skill("parry", 180);
  set_skill("lamaism", 120);
  set_skill("hand", 180);
  set_skill("dashou-yin", 180);
  set_skill("literate", 100);
  set_skill("blade", 180);
  set_skill("xuedao-daofa", 200);
  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "xuedao-daofa");
  map_skill("hand", "dashou-yin");
  map_skill("blade", "xuedao-daofa");
  prepare_skill("hand", "dashou-yin");
  prepare_skill("cuff", "fuhu-quan");
  set("book_count", 1);
  set("inquiry", ([
    "血刀秘籍": (: ask_me_1 :),
  ]));
  create_family("密宗", 10, "血刀门掌教");

  setup();
  carry_object("/clone/armor/yellow-cloth")->wear();
  if (clonep(this_object()))
    if (ob = carry_object("/clone/weapon/xuedao")) ob->wield();

}

void init() {
  object me, ob;
  ::init();
  ob = this_player();
  me = this_object();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}
void greeting(object me) {
  mapping myfam;
  myfam = (mapping)me->query("family");


  if (!myfam) return;
  else if (myfam["family_name"] != "密宗")
    command("say 你这个" + RANK_D->query_rude(me) + "怎麽跑到这里来,扰乱大爷我的清修？");

  else command("say 有没有给我带些好东西,知道最近落花流水他们都在那里出没吗?");
}

string ask_me_1() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "密宗")
    return "你是个什麽东西,向我来要秘籍？";
  if (ob->query_skill("longxiang-gong") < 70)
    return "你龙象般若功火候不足,无法练习我的血刀刀法.";
  if (query("book_count") < 1)
    return "你来晚了，秘籍被别人拿走了。";
  if ((int)ob->query_skill("longxiang-gong", 1) <= 80 || (int)ob->query_skill("lamaism", 1) <= 80)
    return "你现在的修为难以领悟血刀要领。";
  add("book_count", -1);
  ob = new("/d/xueshan/obj/blade_book");
  ob->move(this_player());
  return "好吧,此乃我血刀门至上秘籍,你那去修炼吧。";
}
void attempt_apprentice(object ob) {
  mapping fam;
  fam = ob->query("family");

  if (!fam || fam["family_name"] != "密宗") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill(
    "longxiang-gong",
    1
  ) < 120 || (int)ob->query_skill("lamaism", 1) <= 120) {
    command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。");
    return;
  }
  if (ob->query_str() < 30 || ob->query_skill("blade") < 100) {
    command("say 你臂力不足,基本刀法欠佳,我怎麽能收你这个没用的东西?");
    return;
  }
  if (fam["generation"] <= 10) {
    command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
    return;
  }
  if ((int)ob->query("shen") > -400000) {
    command("say 我血刀老足可不收胆小的家伙。");
    return;
  }
  command("haha");
  command("say 我就收下你吧,今后你就是我的亲传弟子了,希望你能在血刀门中有所作为！");
  command("recruit " + ob->query("id"));
  ob->set("title", "密宗血刀门第十一代底子");


}
