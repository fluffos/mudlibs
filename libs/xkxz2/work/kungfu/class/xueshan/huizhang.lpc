#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("慧彰喇嘛", ({ "huizhang lama", "huizhang" }));
  set("long", @LONG
慧彰喇嘛是雪山寺中护寺僧兵的头领。同时向本寺第子传授武功。
身穿一件青色袈裟。
LONG
  );
  set("nickname", HIG "僧兵头领" NOR);
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("shen", -2000);
  set("str", 36);
  set("int", 20);
  set("con", 28);
  set("dex", 25);
  set("per", 16);
  set("class", "lama");
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 50);
  set("combat_exp", 200000);
  set("eff_jingli", 1500);

  set_skill("hand", 80);
  set_skill("literate", 30);
  set_skill("force", 80);
  set_skill("longxiang-gong", 80);
  set_skill("dodge", 80);
  set_skill("qingshen-fa", 70);
  set_skill("parry", 80);
  set_skill("sword", 80);
  set_skill("mingwang-jian", 80);
  set_skill("cuff", 60);
  set_skill("fuhu-quan", 60);



  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("parry", "mingwang-jian");
  map_skill("sword", "mingwang-jian");
  map_skill("cuff", "fuhu-lun");
  prepare_skill("cuff", "fuhu-quan");
  create_family("密宗", 12, "喇嘛");

  setup();

  carry_object("/clone/armor/q-jiasha")->wear();
  carry_object("/clone/weapon/changjian")->wield();

  add_money("silver", 50);
}
