// lonely-sword.c 独孤九剑
// Written by jjgod.

inherit SKILL;

#include <ansi.h>

#define SKILL_CN_NAME   "独孤九剑"
#define SKILL_EN_NAME   "lonely-sword"

int valid_enable(string usage) {
  return (usage == "sword");
}

int valid_learn(object me) {
  return notify_fail(SKILL_CN_NAME + "只能通过领悟来提高。\n");
}

string perform_action_file(string action) {
  return __DIR__ + SKILL_CN_NAME + "/" + action;
}

// A sword skill whose moves can be borrowed (a missing skill file must not stop the attack).
int sword_moves(string sk) {
  mixed r;
  return !catch(r = SKILL_D(sk)->valid_enable("sword") && arrayp(SKILL_D(sk)->query_actions())) && r;
}

mapping query_action(object me, object weapon) {
  string *skills = get_dir("/kungfu/skill/*.lpc");
  mapping *actions;

  // The security daemon does not let a /kungfu object (euid Domain) list the directory: borrow from the
  // attacker's own sword skills instead, and fall back to the plain weapon moves.
  if (!arrayp(skills)) skills = keys(me->query_skills());
  skills = filter_array(skills, (: sword_moves :));
  if (!sizeof(skills)) {   // nothing to borrow: the weapon's own moves, as an unskilled attack uses them
    if (objectp(weapon) && functionp(weapon->query("actions"))) return evaluate(weapon->query("actions"));
    return ([ "action": "$N用$w往$n的$l刺去", "damage_type": "刺伤", "dodge": 15, "parry": -15 ]);   // weapond's thrust
  }

  actions = SKILL_D(skills[random(sizeof(skills))])->query_actions();

  return actions[random(sizeof(actions))];
}
