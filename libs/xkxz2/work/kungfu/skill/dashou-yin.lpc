// /kungfu/skill/dashou-yin
// dashou-yin.c 密宗大手印

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N使出一招「" HIC "莲花合掌印" NOR "」，双掌合十，直直撞向$n的前胸",
    "skill_name": "莲花合掌印",
    "force": 100,
    "dodge": 0,
    "lvl": 0,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "合掌观音印" NOR "」，飞身跃起，双手如勾，抓向$n的$l",
    "skill_name": "合掌观音印",
    "force": 80,
    "dodge": 10,
    "lvl": 20,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "准提佛母印" NOR "」，运力于指，直取$n的$l",
    "skill_name": "准提佛母印",
    "force": 150,
    "dodge": 5,
    "lvl": 30,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIR "红阎婆罗印" NOR "」，怒吼一声，一掌当头拍向$n的$l",
    "skill_name": "红阎婆罗印",
    "force": 200,
    "dodge": -5,
    "lvl": 50,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "药师佛根本印" NOR "」，猛冲向前，掌如游龙般攻向$n",
    "skill_name": "药师佛根本印",
    "force": 250,
    "dodge": 5,
    "lvl": 80,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "威德金刚印" NOR "」，伏身疾进，双掌自下扫向$n的$l",
    "skill_name": "威德金刚印",
    "force": 180,
    "dodge": 25,
    "lvl": 100,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "上乐金刚印" NOR "」，飞身横跃，双掌前后击出，抓向$n的咽喉",
    "skill_name": "上乐金刚印",
    "force": 270,
    "dodge": -10,
    "lvl": 110,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「" HIC "六臂智慧印" NOR "」，顿时劲气弥漫，天空中出现无数掌影打向$n的$l",
    "skill_name": "六臂智慧印",
    "force": 320,
    "dodge": 5,
    "lvl": 120,
    "damage_type": "瘀伤",
  ]),
});


int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query_skill("fuhu-quan", 1) < 100)
    return notify_fail("你的罗汉伏虎拳火候不够，无法练习密宗大手印。\n");
  if ((int)me->query_str() <= 30)
    return notify_fail("你的臂力不够，无法练习密宗大手印。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练密宗大手印必须空手。\n");
  if ((int)me->query("max_neili") < 500)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("longxiang-gong", 1) <= 80)
    return notify_fail("需要有第四层以上龙象般若功火候，才能练习密宗大手印。\n");
  return 1;

}
int valid_combine(string combo) {
  object me;
  me = this_player();

  if ((int)me->query_str() > 32)
    return combo == "fuhu-quan";
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("dashou-yin", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {


  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练密宗大手印必须空手。\n");
  if ((int)me->query("jingli") < 40)
    return notify_fail("你的体力不够，练不了密宗大手印。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够，练不了密宗大手印。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "dashou-yin/" + action;
}

mapping *query_actions() { return action; }
