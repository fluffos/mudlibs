// liaodu.c, 疗毒
// by snowman

#include <ansi.h>

int exert(object me) {
  if (me->is_fighting())
    return notify_fail("战斗中运功？找死吗？\n");

  if ((int)me->query_skill("huagong-dafa", 1) < 50)
    return notify_fail("你的化功大法修为还不够。\n");
  if ((int)me->query("neili") < 301)
    return notify_fail("你的真气不够。\n");

  if (!me->query_condition("xx_poison"))
    return notify_fail("你只能治疗星宿掌毒。\n");

  message_vision(HIB "$N坐在地上，脸上青一阵白一阵，开始运功疗毒。\n" NOR, me);
  me->clear_condition("xx_poison");
  me->add("neili", -300);
  me->start_busy(31 - (me->query("con")));

  return 1;
}
