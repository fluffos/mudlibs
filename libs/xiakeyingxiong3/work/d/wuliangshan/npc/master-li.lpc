
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("李秋水", ({ "li qiushui", "master" }));

        set("long",@LONG
她是逍遥北宗的开山祖师，也是逍遥派掌门的夫人。她全身白色衣衫，身
形苗条婀娜，气定神闲，轻风动裾，飘飘若仙。她有四十几岁，但看上去
却好象只有二十多岁的样子。她以白绢蒙面，朦胧中可见眉目甚美，但脸
上好象有几条血痕，你不由心中感到一阵寒意....
LONG
        );

        create_family("逍遥北宗", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "女性" );
        set("age", 35);

        set("str", 25);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 25);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 8000000);
        // set("SEN",10000000);

        set_skill("force",    180);     set_skill("wuxiang-force", 180);
        set_skill("sword",    180);     set_skill("xiaoyao-sword", 180);
        set_skill("unarmed",  150);     set_skill("zhemei-shou", 150);
        set_skill("parry",    150);
        set_skill("move",     150);     set_skill("lingbo-steps", 150);
        set_skill("dodge",    150);
        set_skill("literate", 150);

        map_skill("force",      "wuxiang-force");
        map_skill("sword",      "xiaoyao-sword");
        map_skill("unarmed",    "zhemei-shou");
        map_skill("parry",      "zhemei-shou");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/misc/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if( ((int)ob->query("per") < 28)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
