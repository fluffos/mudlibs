#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "青石大道");
 	set("long", @LONG
								
    这里是黑木崖的青石大道。
LONG
	);

	set("outdoors", "kunlunshan");

 	set("exits", ([
		"north"   : __DIR__"hmy-yst",
		"south"   : __DIR__"hmy-bypl",
	]));

	setup();

	replace_program(ROOM);

}

