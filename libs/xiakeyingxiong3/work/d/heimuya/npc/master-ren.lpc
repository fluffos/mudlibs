#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("任我行", ({ "ren woxing", "ren", "master" }));

  set("long", @LONG
他是日月神教的教主。他大约五十来岁，身穿一袭青衫，满脸风霜，但脸
上却无半分血色，便如刚从坟墓出来的僵尸一般。他为人刚愎自用，作风
乖戾，不近人情，对谁都是一副不屑的神情。
LONG
  );

  create_family("日月神教", 1, "教主");
  set("rank_info/respect", "教主");
  set("gender", "男性");
  set("age", 55);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", -600);

  set_skill("force", 150); set_skill("xixing-force", 150);
  set_skill("blade", 220); set_skill("tianmo-blade", 220);
  set_skill("sword", 150); set_skill("tianmo-sword", 150);
  set_skill("unarmed", 150); set_skill("tianmo-zhang", 150);
  set_skill("parry", 150);
  set_skill("move", 160); set_skill("piaomiao-steps", 160);
  set_skill("dodge", 160);
  set_skill("literate", 150);

  map_skill("force", "xixing-force");
  map_skill("sword", "tianmo-sword");
  map_skill("unarmed", "tianmo-zhang");
  map_skill("parry", "tianmo-sword");
  map_skill("move", "piaomiao-steps");
  map_skill("dodge", "piaomiao-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wear();
}

void attempt_apprentice(object ob) {
  /*
        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门只收男徒。");
                return;
        } 
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}

void init() {
  add_action("give_quest", "quest");
}
