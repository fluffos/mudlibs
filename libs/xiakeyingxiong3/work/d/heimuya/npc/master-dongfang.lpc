
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("东方不败", ({ "dongfang bubai", "dongfang", "master" }));

        set("long",@LONG
他是东方神教的开山祖师。他颏下无须，脸上竟施了脂粉，身上衣服式样
男不男，女不女，颜色之妖，便是穿在女子身上也觉得太娇艳、太刺眼了。
他用一副怜爱无限的神情望着你，你只觉周围充满阴森森的妖氛鬼气。他
就是十几年来号称武功天下第一的东方不败。
LONG
        );

        create_family("东方神教", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "无性" );
        set("age", 40);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 8000000);
        set("SEN", -800);

        set_skill("force",    150);     set_skill("tianmo-force", 150);
        set_skill("sword",    190);     set_skill("pixie-sword", 190);
        set_skill("unarmed",  150);     set_skill("tianmo-zhang", 150);
        set_skill("parry",    150);
        set_skill("move",     220);     set_skill("kuihua-steps", 220);
        set_skill("dodge",    220);
        set_skill("literate", 100);

        map_skill("force",      "tianmo-force");
        map_skill("sword",      "pixie-sword");
        map_skill("unarmed",    "tianmo-zhang");
        map_skill("parry",      "pixie-sword");
        map_skill("move",       "kuihua-steps");
        map_skill("dodge",      "kuihua-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/        
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wear();
}

void attempt_apprentice(object ob)
{

        if( ((string)ob->query("gender") != "无性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门不收有性之徒。");
                return;
        } 
/*
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
