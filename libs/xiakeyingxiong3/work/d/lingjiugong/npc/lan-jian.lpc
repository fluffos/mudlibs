#include <ansi.h>

inherit NPC;

void create()
{
        set_name("兰剑", ({ "lan jian", "lan", "jian" }));

        set("long",@LONG
这是个容貌姣好的女子，瓜子脸蛋，眼如点漆，清秀绝俗。
你总觉得好象在哪见过她似的。
LONG
        );

        create_family("灵鹫宫",3,"弟子");
        set("gender", "女性" );
        set("age", 20);

        set("str", 25);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 25);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 1000000);
        set("SEN", 100);

        set_skill("force",    70);      set_skill("bahuang-force", 70);
        set_skill("sword",   120);      set_skill("xiaoyao-sword", 120);
        set_skill("unarmed",  90);      set_skill("zhemei-shou", 90);
        set_skill("parry",   120);
        set_skill("move",     90);      set_skill("lingbo-steps", 90);
        set_skill("dodge",    90);

        map_skill("force",      "bahuang-force");
        map_skill("sword",      "xiaoyao-sword");
        map_skill("unarmed",    "zhemei-shou");
        map_skill("parry",      "zhemei-shou");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");

        set("chat_chance_combat", 60);
/*
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object(__DIR__"obj/cyan-cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
        add_money("silver", 15);
}
