inherit ITEM;
void create()
{
        set_name( "喂狗的碗", ({ "dog bowl", "bowl"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long","这是一只喂狗的碗。\n");
                set("value", 0);
                set("material", "tile");
              }
}
