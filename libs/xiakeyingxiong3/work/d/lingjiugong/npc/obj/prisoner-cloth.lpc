// prisoner-cloth.c 

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( WHT "破旧的囚衣" NOR, ({ "prisoner cloth", "cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一件破旧的囚衣。\n");
                set("unit", "件");
                set("value", 100);
                set("material", "cloth");
                set("armor_type", "cloth");
                set("armor_prop/armor", 1 );
                // set("armor_prop/defense", 0 );
                // set("armor_prop/dodge", 0 );
        }
        setup();
}
