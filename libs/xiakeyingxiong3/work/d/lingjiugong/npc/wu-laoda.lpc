#include <ansi.h>

inherit NPC;

string ask_pill();
string ask_bowl();

void create() {
  set_name("乌老大", ({ "wu laoda", "wu", "laoda" }));

  set("long", @LONG
他就是名动江湖的乌老大，
由于谋反童姥未遂而被囚禁于此。
LONG
  );

  set("title", "岛主");
  set("gender", "男性");
  set("age", 40);

  set("str", 25);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 25);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 4000000);
  set("SEN", 0);

  set("chat_chance_combat", 60);
  /*
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  set("inquiry", ([
    "报答": (: ask_pill :),
    "白云熊胆丸": (: ask_pill :),
    "喂狗的饭": (: ask_bowl :),
    "喂狗的碗": (: ask_bowl :),
    "饭碗": (: ask_bowl :),
  ]));

  set("chat_chance", 3);
  set("chat_msg", ({
    "乌老大喃喃地说：“可惜连白云熊胆丸也救不了我的命！”\n",
    "乌老大喃喃地说：“谁要是来救我，我一定好好报答他！”\n",
    "乌老大喃喃地说：“这里真不是人过的地方！”\n",
  }));

  set("pill_count", 1);
  set("bowl_count", 1);

  setup();

  carry_object(__DIR__ "obj/prisoner-cloth")->wear();
}

string ask_pill() {
  mapping mpFamily;
  object oPlayer, oPill;

  oPlayer = this_player();
  if (oPlayer->query("family/family_name") != "灵鹫宫")
    return RANK_D->query_respect(oPlayer) + "你怎敢要灵鹫宫的镇派宝物呢？";
  if (query("pill_count") < 1)
    return "不好意思，东西已经给别人取走了。";
  add("pill_count", -1);
  oPill = new(__DIR__ "obj/xiongdan-pill");
  oPill->move(oPlayer);
  return "唉，看在你舍身救我的份上，这颗白云熊胆丸就给你吧。";
}

string ask_bowl() {
  mapping fam;
  object oPlayer, oBowl;

  oPlayer = this_player();
  if (query("bowl_count") < 1)
    return "不好意思，东西已经给别人取走了。";
  add("bowl_count", -1);
  oBowl = new(__DIR__ "obj/dog-bowl");
  oBowl->move(oPlayer);
  return "唉，看吧，这就是我平时吃饭用的碗。";
}
