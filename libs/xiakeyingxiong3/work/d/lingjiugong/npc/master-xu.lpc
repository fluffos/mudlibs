#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("虚竹", ({ "xu zhu", "xu", "master" }));

        set("long",@LONG
他是灵鹫宫的少宫主虚竹。他眼大鼻大，耳大口大，广额浓眉，相貌粗野，
再加上鼻孔上翻，双耳招风，嘴唇甚厚，看上去颇为丑陋，但人品却很好。
他身受逍遥子一生功力并得天山童佬的悉心教导，武功已是一日千里。
LONG
        );

        create_family("灵鹫宫", 8, "弟子");
        set("rank_info/respect", "大师");
        set("gender", "男性" );
        set("age", 26);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 4000000);
        // set("SEN",10000000);

        set_skill("force",    150);     set_skill("beiming-force", 150);
        set_skill("blade",    150);     set_skill("ruyi-blade", 150);
        set_skill("unarmed",  150);     set_skill("zhemei-shou", 150);
        set_skill("parry",    150);
        set_skill("move",     150);     set_skill("lingbo-steps", 150);
        set_skill("dodge",    150);
        set_skill("literate", 50);

        map_skill("force",      "beiming-force");
        map_skill("sword",      "ruyi-blade");
        map_skill("unarmed",    "zhemei-shou");
        map_skill("parry",      "zhemei-shou");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
        
        setup();

        carry_object("/obj/misc/cloth")->wear();
        // carry_object("/obj/weapon/longsword")->wear();
}

void attempt_apprentice(object ob)
{

        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "找童姥吧，我不收女徒。");
                return;
        } 
/*
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

