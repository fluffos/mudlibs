inherit ROOM;
#include <room.h>

int do_open(string);

void create()
{
        set("short", "石级甬道");
        set("long", @LONG

暗门后面十来级石阶，往下延伸成条甬道，甬道里燃着灯，灯火下又有一
道门。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
                "north" : __DIR__"secret",
                "west" : __DIR__"midao4",
        ]));

        set("objects", ([
                __DIR__"npc/mei-jian" : 1,
        ]) );

        set("item_desc", ([
            "door" : (: look_door :),
        ]));

        set_temp("door_lock",1);

        setup();
//door here
//        create_door("north", "精铁门", "south", DOOR_CLOSED);

}

int valid_leave(object me, string dir)
{

        if (  (dir == "north") && objectp(present("mei jian", environment(me))) )
                return notify_fail("梅剑伸手拦住你，说道：“对不起，本门重地，请回！”\n");

        if (dir == "north" && query_temp("door_lock") != 0)
                return notify_fail("你不能进去，门已经被铁锁牢牢锁住。\n");

        return ::valid_leave(me, dir);
}

void init()
{
        add_action("do_open", "open");
}

string look_door(string arg)
{
        if (query_temp("door_lock") == 0)
                return "门上的铁锁已经被打开了。\n";
        return "这扇门被铁锁牢牢锁住。\n";
}

int do_open(string arg)
{
        object me=this_player(), room;

        if(!arg || arg!="door")
                return notify_fail("你要开什么？\n");

        if( query_temp("door_lock") == 1 && !present("iron key", me) )
                return notify_fail("钥匙都没有，怎么开门？\n");

        if(!( room = find_object(__DIR__"secret")) )
                room = load_object(__DIR__"secret");

        if(!objectp(room))
                return notify_fail("ERROR:not found 'secret.c' \n");

        if(query_temp("door_lock") == 1 && present("iron key", me))
        {
                set_temp("door_lock", 0);
                message_vision("$N把钥匙插进锁孔，只听见‘卡嗒’一声，锁开了。\n", me);
                message("vision", "外面传来一阵开锁的声音，只听见‘卡嗒’一声，锁开了。\n",room);
        }
        message_vision("$N轻轻推开门，走了进去，随手把门掩了起来。\n",me);
        message("vision", "有人走了进来，随手把门掩上了。\n",room);
        me->move(room);
        return 1;
}
