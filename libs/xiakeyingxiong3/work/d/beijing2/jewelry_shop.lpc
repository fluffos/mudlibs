// jewelry_shop.c- 珠宝店 

inherit ROOM;
string look_sign(object me);

void create() {
  set("short", "珠宝店");
  set("long", @LONG
看门面，金碧辉煌仅能描述出十分之一。在这里，顾客可以挑选到世界各地
最新款式的珠宝。据说这个店的老板是江湖中一个有势力的人士开的。所以
至今还没有发生过抢劫案。
LONG
  );
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "nw_road3",
  ]));
  set("no_clean_up", 0);
  //        set("outdoors", "beijing");
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/jewelry_seller": 1,  //老板一名
  ]));
  setup();
  replace_program(ROOM);
}
string look_sign(object me) {
  return (@LONG
金玉满堂
LONG);
}
