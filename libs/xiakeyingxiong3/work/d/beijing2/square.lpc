// square.c- 天安门广场

inherit ROOM;

void create() {
  set("short", "天安门广场");
  set("long", @LONG
这里是紫禁城前面的广场的。北边就是当今皇上居住的紫禁城。
只见几个锦衣侍卫在这里来回巡逻，行人走到这里，都要加快步伐，
匆匆忙忙的走开。因为他们知道，如果被误会了有什么不轨的举动
的话，侍卫会好不犹豫的拔出钢刀招呼过来。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "ngate1",  //天安门城门
    "west": __DIR__ "w_road1",
    //  "south" : __DIR__"s_road1",
    "east": __DIR__ "e_road1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "beijing");
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/shiwei2": 2,  //侍卫
    __DIR__ "npc/shiwei3": 2,  //侍卫

  ]));
  setup();
  replace_program(ROOM);
}
