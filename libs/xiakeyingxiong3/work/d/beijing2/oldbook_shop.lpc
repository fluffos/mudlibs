// oldbook_shop.c- 书店 

inherit ROOM;

string look_sign(object me);

void create()
{
        set("short", "古玩店");
        set("long", @LONG
这是全国最大书店之一 -- 王府井书店。王府井书店本来在王府井大街的，但是
由于王府井的商业价值剧升，而经营书店利润有限，所以只能让步，搬到这里
惨淡经营了。
LONG
        );
        	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

        set("exits", ([ /* sizeof() == 1 */
           "west" : __DIR__"nw_road4",
]));
        set("no_clean_up", 0);
//        set("outdoors", "beijing");
        set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/book_seller" : 1,  //老板一名
                ]));
        setup();
        replace_program(ROOM);
}
string look_sign(object me)
{
  return "书中自有黄金屋";
}		