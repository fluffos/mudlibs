// zhangfu.c

inherit NPC;
inherit F_VENDOR;

int ask_me_1();

void create()
{
	set_name("张福", ({ "zhang fu","zhang" }) );
	set("gender", "男性" );
	set("age", 50);
	set("long",
		"这位管家拿着本帐簿,正准备出去收账。\n");
	set("combat_exp",1000);
	set("attitude", "friendly");
	set_skill("unarmed", 80);
	set_skill("parry", 80);
	set_skill("dodge", 80);
	set("inquiry", ([
		"拜见" :    (: ask_me_1 :)
	]));

	
	set("score", 100);

	
	setup();
}
 
int ask_me_1()
{
	 
	object ob;
	ob=this_player();
	command("hehe "+ob->query("id") );
	tell_object(ob, "管家悄悄的对你说:这位"+RANK_D->query_respect(ob)+
            "难道没有听说过有钱能使鬼推磨吗?\n" );
        return 1;
}


int accept_object(object who, object ob)
{
	int val;
	object ob1;
        object me;
        
        me=this_object();
	val = ob->value();
	if( val<10000 )
		return notify_fail("张管家对你说:这么点钱还是留给大爷自己用吧。\n");
	message_vision("$N神秘的把$n拉到一边。\n",me,who);
        tell_object(who,"张管家悄悄的告诉你:你穿上这件衣服进去吧.不要告诉别人.\n");
	if(who->query("gender")=="男性")
	      {   ob1 = new("/d/beijing2/zhang/obj/jiacloth");
		  message_vision("$N塞给了$n一件家丁服。\n",me,who);
	      }
	else  {   ob1 = new("/d/beijing2/zhang/obj/yacloth");
                  message_vision("$N塞给了$n一件丫环服。\n",me,who);
	      }
	ob1->move(who);
	
	return 1;
}

 

