// zhang3.c ---张康武

inherit NPC;

void create() {
  set_name("张康武", ({ "zhang kangwu", "zhang" }));
  set("gender", "男性");
  set("age", 37);
  set("long", "一个大汉,一看他的块头,就知道他是习武之人.\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  setup();
  add_money("coin", 10000);
  carry_object("/obj/cloth/cloth")->wear();
}
