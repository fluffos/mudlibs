// zhang2.c ---张康文

inherit NPC;

void create()
{
	set_name("张康文", ({ "zhang kangwen", "zhang" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long", "一个文弱的书生,神色凝重,座立不安。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set_skill("unarmed", 40);
	set_skill("parry", 20);
	set_skill("dodge", 20);
	
	setup();
	add_money("coin", 10000);
	carry_object("/obj/cloth/cloth")->wear();
}

