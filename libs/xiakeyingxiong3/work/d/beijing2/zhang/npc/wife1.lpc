// wife1.c

inherit NPC;

void create() {
  set_name("张李氏", ({ "zhang" }));
  set("gender", "女性");
  set("age", 57);
  set("long", "张百万的老婆,虽然上了年纪,但是仍然可以看出当年是个美女.\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set("per", 30);

  setup();
  add_money("coin", 10000);
  carry_object("/obj/cloth/green-silk")->wear();

}
