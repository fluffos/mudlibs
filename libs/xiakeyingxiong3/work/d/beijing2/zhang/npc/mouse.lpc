// mouse.c

inherit NPC;

void create()
{
	set_name("老鼠", ({ "mouse" }) );
	set("race", "野兽");
	set("age", 4);
	set("long", "一只大老鼠,由于偷吃食物比较容易,所以长的肥肥的,不知道有没有心脏病。\n");
	
	set("str", 24);
	set("cor", 26);

	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set_temp("apply/attack", 10);
	set_temp("apply/damage", 3);
	set_temp("apply/armor", 10);
	set_temp("apply/defense",10);
	
	set("verbs", ({ "bite", "claw" }) );
	

	setup();
}

