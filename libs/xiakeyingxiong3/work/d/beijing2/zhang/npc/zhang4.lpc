// zhang4.c ---张君凯


#include <dbase.h>
#include <ansi.h>
#include <net/dns.h>

inherit NPC;

void increase_skill(object ob);

void create()
{
	set_name("张君凯", ({ "zhang junkai", "zhang" }) );
	set("gender", "男性" );
	set("age", 18);
	set("long", "一个文弱的书生,面带病容。他是张百万的孙子.\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set_skill("unarmed", 10);
	set_skill("parry", 10);
	set_skill("dodge", 10);
	
	setup();
	add_money("coin", 10000);
	carry_object("/obj/cloth/cloth")->wear();
}



void init()
{       
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	 object gao;

	if( !ob || !present(ob, environment(this_object())) )
		 return;
	 if( ((string)this_object()->query("saver"))==((string)ob->query("id")) ) 
	     {
		command("say "+"谢谢恩公的救命之恩.");
		command("bow "+ob->query("id") );
		return ;
	      }
}

int accept_object(object who, object ob)
{
	object zhang;
	int i;
	if( ob->query("name") !="天山雪莲") return 0;
	if (! who->query_temp("ask_zhang")) 
	   { 
	     command("say 爷爷说不能接受陌生人的礼物的.\n");
	     return 0;
	   }
         if(this_object()->query("saved") )
	     {
		 command("say 谢谢这位"+RANK_D->query_respect(this_player())+
		 ",我的病已经好了.");
		 return 0;
	     }
	 this_object()->set("saved",1);
	 this_object()->set("saver",(string)ob->query("id"));
	 this_object()->move("/d/beijiang2/zhang/hall");
         zhang=present("zhang baiwan",environment(this_object()) );
	 if(zhang)        zhang->set("trouble_solved",1);
	 this_object()->move("/d/beijiang2/zhang/room3");
         i = (int)ob->query("combat_exp") / 10;
         if( i > 100000 ) i = 100000;
	 who->add("combat_exp", i );
	 who->add("potential",50); 
	 who->add("SEN",1000);
	 who->set("save_zhang",1);
	 who->delete_temp("ask_zhang");
	 increase_skill(who);
	 tell_object(who,GRN"由于你的出色表现，你的侠义精神、战斗经验和武功都得到了提高。\n"NOR);
	 return 1;
}

