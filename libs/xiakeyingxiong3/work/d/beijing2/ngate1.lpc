// ngate1.c 紫禁城城门

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "紫禁城城门");
	set("long", @LONG
高大雄伟的城门(gate)，几个侍卫在门口守着，等闲人物不能靠近。
LONG
	);


	set("item_desc", ([
		"gate": (: look_door :),
	]) );
	
	set("exits", ([
		"south"    	: __DIR__"square",
		"north"	        : __DIR__"cheng1" ]) );

	set("objects", ([
		__DIR__"npc/shiwei1" : 2 ,
		__DIR__"npc/shiwei2" : 2,  //侍卫
       ]) );
	create_door("north", "城门", "south", DOOR_CLOSED);

	setup();

}

void init()
{
        object ob;

//        ::init();

        if( interactive(ob = this_player()))
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }

}

void greeting(object ob)
{
     object ob2;
     if( ob2 = present("shi wei",this_object() ) )
        tell_room(this_object(),"侍卫大喝一声：大胆刁民，这是你能来的地方吗？还不快快离开。\n");

}

string look_door(object me)
{
	return "一对黑漆的大铁门，看起来有两三千斤重。\n";
	
}
