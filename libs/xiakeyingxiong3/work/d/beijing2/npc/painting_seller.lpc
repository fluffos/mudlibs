// painting_seller.c 字画店老板

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;


void create()
{
        set_name("字画店掌柜", ({ "seller", "boss" }) );
        set("gender", "男性" );
        set("age", 35);
        set("long", "你看到一个高高瘦瘦的中年人, 拿着一支笔，正在聚精会神的\n"
         "习字。\n");
        set("str", 20);
        set("int", 25);
        set("combat_exp", 700);
        set("attitude", "friendly");
        set_skill("unarmed", 20);
        set_skill("parry", 20);
        set_skill("dodge", 20);

/*        set("inquiry", ([
                "唐诗" : "这位客官真的识货了，正所谓熟读唐试三百首......",
        ]) );

        set("vendor_goods", ([
               __DIR__"obj/vase" : 1,
        ]) );

*/
        setup();
        add_money("silver", 12);
        add_money("coin", 500);
        carry_object("/obj/cloth/cloth")->wear();
       
	}
