// cloth.c 侍卫服

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("侍卫服", ({ "shiwei cloth", "cloth" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是件暗红色的侍卫服，胸前用朱色的线绣了一只老虎。\n");
		set("unit", "件");
		set("value", 3000);
		set("material", "cloth");
		set("armor_prop/armor", 3);
                set("armor_prop/dodge", 1);  //加 dodge 1 级。
	}
	setup();
}

