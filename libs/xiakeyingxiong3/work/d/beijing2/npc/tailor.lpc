// tailor.c - 裁缝

#include <ansi.h>

inherit NPC;

#define SET_SKILL       20                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       20                     // 定义特殊武功的值
#define SET_SEN         50                      // 定义正气的值

string ask_me(object who);

void create()
{
        set_name("小得张", ({ "cai feng","tailor" }));

        set("long", @LONG
看起来已经50多岁了，穿着一件长衫，一把软尺挂在脖子上，笑咪咪的看着你。
LONG
        );

        set("rank_info/respect", "老板");
        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 56);

        set("str", 30);                         // 膂力         
        set("cps", 30);                         // 定力
        set("cor", 30);                         // 胆识         
        set("per", 30);                         // 容貌
        set("con", 30);                         // 根骨

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 100);
        set("max_mana", 0);             set("mana", 0);

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );

        set_skill("force",   SET_SKILL);  set_skill("hunyuan-force", SPE_SKILL);
        set_skill("sword",   SET_SKILL);  set_skill("fumo-sword",    SPE_SKILL);
        set_skill("unarmed", SET_SKILL);  set_skill("luohan-quan",   SPE_SKILL);
        set_skill("parry",   SET_SKILL);
        set_skill("move",    SET_SKILL);  set_skill("yiwei-steps",   SPE_SKILL);
        set_skill("dodge",   SET_SKILL);
        set_skill("literate",SET_SKILL);

        map_skill("force",      "hunyuan-force");
        map_skill("sword",      "fumo-sword");
        map_skill("unarmed",    "luohan-quan");
        map_skill("parry",      "fumo-sword");
        map_skill("move",       "yiwei-steps");
        map_skill("dodge",      "yiwei-steps");

        setup();
        
        carry_object("/obj/cloth/cloth")->wear();       // 装备
        carry_object("/obj/weapon/longsword")->wield();

        add_money("silver", 10);                        // 金钱
}

void init()
{
        add_action("do_name", "name");
        add_action("do_wear_msg", "wear_msg");
        add_action("do_remove_msg", "remove_msg");
        add_action("do_make", "make");
}

int do_name(string name)
{
        object me, ob;

        me = this_player();

        if( !name ) return notify_fail( @TEXT
指令格式 : name <命名>

这个指令可以让你为自己身上的独门穿着取一个自定的名字。你如果希望
在名字中使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：

$BLK$ - 黑色            $NOR$ - 恢复正常颜色
$RED$ - 红色            $HIR$ - 亮红色
$GRN$ - 绿色            $HIG$ - 亮绿色
$YEL$ - 土黄色          $HIY$ - 黄色
$BLU$ - 深蓝色          $HIB$ - 蓝色
$MAG$ - 浅紫色          $HIM$ - 粉红色
$CYN$ - 蓝绿色          $HIC$ - 天青色
$WHT$ - 浅灰色          $HIW$ - 白色
 
其中系统自动会在字串尾端加一个 $NOR$。

TEXT
        );

        if( strlen(name) > 40 )
                return notify_fail("你取的名字太长了，想一个短一点的吧。\n");

        name = replace_string(name, "$BLK$", BLK);
        name = replace_string(name, "$RED$", RED);
        name = replace_string(name, "$GRN$", GRN);
        name = replace_string(name, "$YEL$", YEL);
        name = replace_string(name, "$BLU$", BLU);
        name = replace_string(name, "$MAG$", MAG);
        name = replace_string(name, "$CYN$", CYN);
        name = replace_string(name, "$WHT$", WHT);
        name = replace_string(name, "$HIR$", HIR);
        name = replace_string(name, "$HIG$", HIG);
        name = replace_string(name, "$HIY$", HIY);
        name = replace_string(name, "$HIB$", HIB);
        name = replace_string(name, "$HIM$", HIM);
        name = replace_string(name, "$HIC$", HIC);
        name = replace_string(name, "$HIW$", HIW);
        name = replace_string(name, "$NOR$", NOR);
        name = name + NOR;

        me->set("cloth/name", name);
        if ( objectp( ob = present( "my cloth", me ) ) ) {
                ob->set_up();
                tell_object(me, "你将独门穿着的名称定义为：" + name + "。\n");
        }

        return 1;
}

int do_wear_msg(string arg)
{
        object me, ob;

        me = this_player();

        if( !arg ) return notify_fail( @TEXT
指令格式 : wear_msg <命名>
 
这个指令可以让你设定独门穿着的装备信息。
例如：wear_msg $N将一件$n披在身上。

TEXT
        );

        arg = arg + "\n";

        me->set("cloth/wear_msg", arg);
        if ( objectp( ob = present( "my cloth", me ) ) ) {
                ob->set_up();
                tell_object(me, "你将独门穿着的装备信息定义为：" + arg + "\n");
        }

        return 1;
}

int do_remove_msg(string arg)
{
        object me, ob;

        me = this_player();

        if( !arg ) return notify_fail( @TEXT
指令格式 : remove_msg <命名>
 
这个指令可以让你设定独门穿着的卸装信息。
例如：remove_msg $N将身上的$n脱了下来。

TEXT
        );

        arg = arg + "\n";

        me->set("cloth/remove_msg", arg);
        if ( objectp( ob = present( "my cloth", me ) ) ) {
                ob->set_up();
                tell_object(me, "你将独门穿着的卸装信息定义为：" + arg + "\n");
        }

        return 1;
}


int do_make(string arg)
{
        object me, ob;
        int cost, high, low, n;

        me = this_player();

        if( !arg || !sscanf(arg, "%d", cost) ) return notify_fail( @TEXT
指令格式 : make <花费的精和神的值>
TEXT
        );

        if( cost < 10 ) return notify_fail("你最少要花 10 点「精」和「神」。\n");

        if( (int)me->query("gin") < cost || (int)me->query("sen") < cost )
                return notify_fail("你现在的「精」或「神」太少了。\n");

        if ( !objectp( ob = present( "my cloth", me ) ) )
                return notify_fail("你现在没有独门穿着。\n");

        if ( ob->query("equipped") ) return notify_fail("你必须脱下「" + ob->name() + NOR "」。\n");

        if( me->query( "cloth/armor" ) >= 100 ) 
                return notify_fail("你没有必要再升级「" + ob->name() + NOR "」了。\n");

        high = me->query("cloth/points_high");
        low  = me->query("cloth/points_low");
        low += cost;
        if( low > 100 ) {
                high += low / 100;
                low  %= 100;
        }

        if( high >= pow( 2.0, me->query( "cloth/armor" ) / 5.0 + 1.0 ) ) {
                high = 0; low = 0;
                me->add("cloth/armor", 1);
                ob->set_up();
                tell_object(me, WHT "你的「" + me->query("cloth/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("cloth/name") + WHT "」的Armor 级别是：" 
                        + chinese_number( me->query("cloth/armor") ) + "。\n" NOR);
        }
        else {
                n = high * 100 / pow( 2.0, me->query( "cloth/armor" ) / 5.0 + 1.0 );
                tell_object(me, WHT "「" + me->query("cloth/name") + WHT "」的完成度是：百分之" 
                        + chinese_number( n ) + "。\n" NOR);
        }

        me->set("cloth/points_high", high);
        me->set("cloth/points_low", low);

        tell_object(me, "你开始制造「" + ob->name() + "」....\n");

        me->receive_damage("gin", cost);
        me->receive_damage("sen", cost);
        me->start_busy(1);

        return 1;
}

int accept_object(object me, object ob)
{
        object cloth;

        if( !ob->id("stone") ) return 0;
        
        if ( !objectp( cloth = present( "my cloth", me ) ) ) {
                tell_object(me, "你现在没有独门穿着。\n" );
                return 0;
        }

        if ( cloth->query("equipped") ) {
                tell_object(me, "你必须脱下「" + cloth->name() + "」。\n" );
                return 0;
        }

        if( ob->id("gold stone") && me->query("cloth/armor") < 100 ) {
                command( "smile " + me->query("id") );
                me->add("cloth/armor", 1);
                cloth->init();
                tell_object(me, WHT "你的「" + me->query("cloth/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("cloth/name") + WHT "」的Armor 级别是：" 
                        + chinese_number( me->query("cloth/armor") ) + "。\n" NOR);
                return 1;
        }
        if( ob->id("silver stone") && me->query("cloth/defense") < 50 ) {
                command( "smile " + me->query("id") );
                me->add("cloth/defense", 1);
                cloth->init();
                tell_object(me, WHT "你的「" + me->query("cloth/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("cloth/name") + WHT "」的Defense 级别是：" 
                        + chinese_number( me->query("cloth/defense") )  + "。\n" NOR);
                return 1;
        }
        if( ob->id("magenta stone") && me->query("cloth/dodge") < 50 ) {
                command( "smile " + me->query("id") );
                me->add("cloth/dodge", 1);
                cloth->init();
                tell_object(me, WHT "你的「" + me->query("cloth/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("cloth/name") + WHT "」的Dodge 级别是：" 
                        + chinese_number( me->query("cloth/dodge") )  + "。\n" NOR);
                return 1;
        }
        command( "? " + me->query("id") );
        command( "say 你给我这样东西干什么耶。" );

        return 0;
}

