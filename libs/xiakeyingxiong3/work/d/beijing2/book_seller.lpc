// book_seller.c 书店老板

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("书店老板", ({ "seller", "boss" }) );
        set("title", "学富五车");
        set("gender", "男性" );
        set("age", 35);
        set("long", "你看到一个高高瘦瘦的中年人, 拿着一支毛笔，正在练字。\n");
        set("str", 19);
        set("int", 27);
        set("combat_exp", 3000);
        set("attitude", "friendly");
        set_skill("unarmed", 40);
        set_skill("parry", 40);
        set_skill("dodge", 40);

        set("inquiry", ([
                "唐诗" : "这位客官真的识货了，正所谓熟读唐试三百首......",
                "唐诗剑法" : "这位客官真的会说笑了。唐诗是文学方面的书，那能和剑法扯上关系?",
        ]) );

        set("vendor_goods", ([
                "/obj/book/literate_book_a" : 3,
                "/obj/book/dodge_book_a"   :  1,
//                __DIR__"obj/tangshi_book":    2,
//唐诗剑法,以后再加.
        ]) );

        setup();
        add_money("silver", 12);
        add_money("coin", 500);
        carry_object("/obj/cloth/white-pao")->wear();
       
}

void init()
{       
        object ob;

        ::init();
		if( this_object()->query_temp("unconcious") ) return;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，想买书吗？\n");
                        break;
        }
}
