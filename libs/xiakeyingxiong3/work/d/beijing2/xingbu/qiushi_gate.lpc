// /d/beijing2/xingbu/hall.c

inherit ROOM;

void create() {
  set("short", "囚室入口");
  set("long", @LONG
这是刑部囚禁犯人的地方。但是守卫不见得特别森严。
LONG
  );

  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "qiushi1",
    "north": __DIR__ "hall",
  ]));
  set("no_clean_up", 0);
  //        set("outdoors", "beijing");
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/guard": 5,
  ]));

  setup();

}

int valid_leave(object me, string dir) {
  object obj;
  obj = present("guard", environment(me));
  if (dir == "down" && objectp(obj) && !me->is_fighting())  //为做任务加的，可以溜进去。
    return notify_fail("守卫双手一拦：大人有令，谁也不能进去。\n");
  return ::valid_leave(me, dir);
}
