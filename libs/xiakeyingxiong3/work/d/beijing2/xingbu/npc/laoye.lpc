// laoye.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("高英明", ({ "shang shu","gao yingming","lao ye"  }) );
        set("gender", "男性" );
        set("title","刑部尚书");
        set("age", 35);
        set("long", "一脸正气，未怒先威，一看就知道是一个清官。\n");
        set("str", 20);
        set("int", 25);
        set("combat_exp", 15000);
        set("attitude", "friendly");
        set_skill("unarmed", 60);
        set_skill("parry", 60);
        set_skill("dodge", 60);

        set("SEN",1000);
        setup();
        add_money("silver", 12);
        add_money("coin", 500);
        carry_object("/obj/cloth/cloth")->wear();
       
}
void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( this_object()->query_temp("unconcious") || !ob 
                 || environment(ob) != environment() ) return;
	say( "高英明一拍惊堂木，大喝一声：大胆小民，有何冤情，快快道来。\n" );
}
