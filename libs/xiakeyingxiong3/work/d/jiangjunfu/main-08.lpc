#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "前上房");
        set("long", @LONG
                                                                
    这里是侠客城将军府的前上房。
LONG
        );

        // set("outdoors", "xiakecheng");

        set("exits", ([
                "east"   : __DIR__"main-08e",
                "west"   : __DIR__"main-08w",
                "south"  : __DIR__"main-07",
                "north"  : __DIR__"main-09",
        ]));

        set("objects", ([
                __DIR__"npc/da-jiangjun": 1,
                __DIR__"npc/junshi": 1,
        ]) );

        setup();

        replace_program(ROOM);
}