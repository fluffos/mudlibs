#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( HIR "平西战袍" NOR, ({ "pingxi zhanpao", "zhanpao" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "这是一件平西战袍。\n");
                set("unit", "件");
                set("value", 5000);
		set("material", "silk");
		set("armor_type", "cloth");
		set("armor_prop/armor", 5 );
		set("armor_prop/defense", 5 );
                set("armor_prop/dodge", 5 );
        }
        setup();
}
