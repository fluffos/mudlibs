#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name( HIC "碧玉冠" NOR, ({ "biyu guan", "guan" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一顶普通的碧玉冠。\n");
                set("unit", "顶");
                set("value", 10000);
		set("material", "stone");
		set("armor_type", "head");
		set("armor_prop/armor", 8 );
		set("armor_prop/defense", 0 );
                set("armor_prop/dodge", 2 );
        	set("wear_msg", "$N将$n取出戴在头上。\n");
        }
        setup();
}
