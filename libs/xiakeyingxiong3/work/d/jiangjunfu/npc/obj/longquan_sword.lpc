#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIC "龙泉剑" NOR, ({ "longquan sword", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄龙泉剑，它是一把出名的宝剑。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声拔出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(80);
  setup();
}
