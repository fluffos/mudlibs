#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIY "鎏金靴" NOR, ({ "liujin xue", "xue" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双普通的鎏金靴。\n");
    set("unit", "双");
    set("value", 15000);
    set("material", "gold");
    set("armor_type", "boots");
    set("armor_prop/armor", 7);
    set("armor_prop/defense", 0);
    set("armor_prop/dodge", 0);
  }
  setup();
}
