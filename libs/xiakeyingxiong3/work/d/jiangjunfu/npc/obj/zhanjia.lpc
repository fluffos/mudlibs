#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( WHT "战甲" NOR, ({ "zhan jia", "jia" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "这是一件战甲。\n");
                set("unit", "件");
                set("value", 500);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 3 );
		set("armor_prop/defense", 3 );
                set("armor_prop/dodge", 3 );
        }
        setup();
}
