
inherit NPC;
inherit F_MASTER;

void create()
{

        set_name("庄铮", ({ "zhuang zheng", "zhuang", "zheng", "master" }) );
        set("long", @LONG
他是一位高大魁伟的中年男子，身穿一件白布长袍。
他天生神力，手中的两头狼牙棒有万夫不当之勇，真是一条威风凛凛的汉子。
LONG
);

        create_family("明教", 33, "锐金旗掌旗使");

        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 48);

        set("str", 25);         // 膂力         
        set("cps", 25);         // 定力
        set("cor", 25);         // 胆识         
        set("per", 25);         // 容貌
        set("int", 27);         // 悟性         
        set("con", 25);         // 根骨
        set("spi", 25);         // 灵性         
        set("kar", 25);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 800000);
        set("SEN", -30);

        set_skill("force",    70);     set_skill("guangming-force", 70);
        set_skill("sword",    70);     set_skill("guangming-sword", 70);
        set_skill("unarmed",  70);     set_skill("guangming-zhang", 70);
        set_skill("parry",    70);
        set_skill("move",     70);     set_skill("lieyan-steps", 70);
        set_skill("dodge",    70);
        set_skill("literate", 70);

        map_skill("force",      "guangming-force");
        map_skill("sword",      "guangming-sword");
        map_skill("unarmed",    "guangming-zhang");
        map_skill("parry",      "guangming-sword");
        map_skill("move",       "lieyan-steps");
        map_skill("dodge",      "lieyan-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object(__DIR__"obj/white-robe")->wear();
}

void init()
{       
        add_action("give_quest", "quest");
}


void attempt_apprentice(object ob)
{
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}
