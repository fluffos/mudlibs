inherit NPC;

void create() {

  set_name("洪水旗教众", ({ "water disciple", "disciple" }));
  set("long", @LONG
他是一名洪水旗教众。
LONG
  );
  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 54);

  set("str", 25);         // 膂力         
  set("cps", 25);         // 定力
  set("cor", 25);         // 胆识         
  set("per", 25);         // 容貌
  set("int", 27);         // 悟性         
  set("con", 25);         // 根骨
  set("spi", 25);         // 灵性         
  set("kar", 25);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 20000);
  set("SEN", -5);

  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("move", 100);
  set_skill("dodge", 100);

  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/cloth/cloth")->wear();
  add_money("silver", 1);
}

void attempt_apprentice(object ob) {
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
