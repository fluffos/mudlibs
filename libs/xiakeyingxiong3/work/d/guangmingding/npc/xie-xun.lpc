#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {

  set_name("谢逊", ({ "xie xun", "xie", "xun", "master" }));
  set("long", @LONG
他是一位身材魁伟异常的的大汉，身穿一件白布长袍。
他满头黄发，威风凛凛，真如天神一般。
LONG
  );

  create_family("明教", 33, "法王");
  set("nickname", HIY "金毛狮王" NOR);

  // set("class", "bonze");

  set("gender", "男性");
  set("age", 46);

  set("str", 25);         // 膂力         
  set("cps", 25);         // 定力
  set("cor", 25);         // 胆识         
  set("per", 25);         // 容貌
  set("int", 27);         // 悟性         
  set("con", 25);         // 根骨
  set("spi", 25);         // 灵性         
  set("kar", 25);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 4000000);
  set("SEN", -100);

  set_skill("force", 100); set_skill("guangming-force", 100);
  set_skill("blade", 180); set_skill("tulong-blade", 180);
  set_skill("unarmed", 180); set_skill("qishang-quan", 180);
  set_skill("parry", 180);
  set_skill("move", 150); set_skill("lieyan-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 150);

  map_skill("force", "guangming-force");
  map_skill("blade", "tulong-blade");
  map_skill("unarmed", "qishang-quan");
  map_skill("parry", "tulong-blade");
  map_skill("move", "lieyan-steps");
  map_skill("dodge", "lieyan-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object(__DIR__ "obj/white-robe")->wear();
}

void init() {
  add_action("give_quest", "quest");
}


void attempt_apprentice(object ob) {
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
