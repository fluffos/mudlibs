// /d/mytest/liroom.c
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "后堂");
    set("long", @LONG
    堂上空荡荡的没甚麽陈设，只东西两壁都挂著一幅画。
LONG
    );

    set("exits",([
     "south" : __DIR__"mi-edge",
]));
    set("item_desc", ([
        "东壁" : "东壁画中是一个道人，身材甚高，腰悬长剑，右手食指指著东北角，只是背脊向外，
面貌却看不见。\n",
        "西壁" : "西壁画中是两个姑娘。一个二十五六岁，正在对镜梳装，另一个是十四五岁的丫鬟，
手捧面盆，在旁侍候。画中镜□映出那年长女郎容貌极美，秀眉入鬓，眼角之间却
隐隐带著一层杀气。\n",
    ]));

    setup();
    replace_program(ROOM);

}

