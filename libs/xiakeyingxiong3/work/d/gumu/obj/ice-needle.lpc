// ice-needle.c

#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create()
{
	set_name( WHT "冰魄银针" NOR, ({ "needle", "ice needle" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"这是一枚长长的银针，针体喂过剧毒，散发出阵阵腥臭，它是古墓派的独门暗器之一。\n");
		set("unit", "些");
		set("base_unit", "枚");
		set("base_weight", 40);
		set("value", 100);
	}
	set_amount(1);
	init_throwing(20);
	setup();
}
