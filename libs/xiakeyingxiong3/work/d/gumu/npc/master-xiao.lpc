
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("小龙女", ({ "xiao longnu", "xiao", "master" }));

        set("long",@LONG
她是古墓派的小龙女，神雕大侠杨过的心上人。她曾因中情花毒而与杨过
分离，一人独居绝情谷底十六年。她一身白衣，薄施粉黛，如白衣仙子。
她身边，一群群的玉蜂来回飞舞。
LONG
        );

        create_family("古墓派", 2, "弟子");
        set("rank_info/respect", "大侠");
        set("gender", "女性" );
        set("age", 30);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 8000000);
        set("SEN", 100);

        set_skill("force",    150);     set_skill("ninemoon-force", 150);
                                        set_skill("yunu-force", 190);
        set_skill("sword",    150);     set_skill("yunu-sword", 150);
        set_skill("unarmed",  150);     set_skill("tianluo-shi", 150);
        set_skill("parry",    150);
        set_skill("move",     150);     set_skill("yingfeng-steps", 150);
        set_skill("dodge",    150);
        set_skill("literate", 120);

        map_skill("force",      "yunu-force");
        map_skill("sword",      "yunu-sword");
        map_skill("unarmed",    "tianluo-shi");
        map_skill("parry",      "yunu-sword");
        map_skill("move",       "yingfeng-steps");
        map_skill("dodge",      "yingfeng-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
        carry_object("/d/gumu/obj/yu-needle");
        carry_object("/d/gumu/obj/yu-needle");
        carry_object("/d/gumu/obj/yu-needle");
        carry_object("/d/gumu/obj/yu-needle");
        carry_object("/d/gumu/obj/yu-needle");

}

void attempt_apprentice(object ob)
{

        if( ((string)ob->query("gender") != "女性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，我只收女弟子。");
                return;
        } 
/*
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
