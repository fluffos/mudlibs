// /d/gumu/npc/sun.c

#include <ansi.h>
inherit NPC;

#define SET_SKILL       100                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       100                     // 定义特殊武功的值
#define SET_SEN         100                      // 定义正气的值

int ask_mea1();
int ask_mea2();
int ask_meb();

void create()
{
        set_name("孙婆婆", ({ "sun" }) );
        set("nickname", YEL"老仆人"NOR);
        set("gender", "女性");
        set("age", 50);
        set("long",
"一位面带微笑，温柔仁慈的老妇人，以前她是服侍小龙女师傅的女仆，\n"
"现在与小龙女在墓中相依为命。\n"
  
  );
        set("attitude", "peaceful");

        set("str", 20);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 20);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘


	 set("inquiry" , ([
		"祖师" : (: ask_mea1 :),
                "拜祭" : (: ask_mea2 :),
		"练功房" : (: ask_meb :),
		
]));

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 1000000);
        set("SEN",100);

        set_skill("force",    SET_SKILL);     
                                              set_skill("yunu-force", SPE_SKILL);
        set_skill("sword",    SET_SKILL);     set_skill("yunu-sword", SPE_SKILL);
        set_skill("unarmed",  SET_SKILL);     set_skill("tianluo-shi", SPE_SKILL);
        set_skill("parry",    SET_SKILL);
        set_skill("move",     SET_SKILL);     set_skill("yingfeng-steps", SPE_SKILL);
        set_skill("dodge",    SET_SKILL);

        map_skill("force",      "yunu-force");
        map_skill("sword",      "yunu-sword");
        map_skill("unarmed",    "tianluo-shi");
        map_skill("parry",      "yunu-sword");
        map_skill("move",       "yingfeng-steps");
        map_skill("dodge",      "yingfeng-steps");

/*        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/        
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wear();
}

int ask_mea1()
{
	object me;

	me=this_player();
   if  (!me->query("family"))
           return 0;
   if(( me->query("family")["master_name"]!="杨过" )&&(
        me->query("family")["master_name"]!="小龙女" ))
           return 0;
   else{
       say("孙婆婆说道：“咱们的祖师婆婆。她姓林，名字叫做朝英，数十年前，武林中以祖师
婆婆与王重阳二人武功最高！”\n");
       
       write("孙婆婆悄声对你说道：“祖师婆婆的墓室就在地下，想不想去拜祭一下她老人家？”\n");
       return 1;
   }

         
	}
int ask_mea2()
{
	object me;
	me=this_player();
        say("孙婆婆说道：“好，既然你如此诚心，我带你去！”\n");
        me->start_busy(3);
        me->move("/d/gumu/guan-room");
        write("孙婆婆说：“到了！”\n");
        return 1;

}


int ask_meb()
{
	object me;

	me=this_player();
   if  (!me->query("family"))
            return 0;
   if(( me->query("family")["master_name"]!="杨过" )&&(
        me->query("family")["master_name"]!="小龙女" )){
            return 0;
        } 

   else{
            say("孙婆婆说道：“好！我带你去，过儿小时候就是在那里练功的。”\n");
            me->move("/d/gumu/train-room");
            return 1;
       }
}

