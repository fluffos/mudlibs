// /d/gumu/xiao-room.c
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小龙女的房间");
  set("long", @LONG
    这是小龙女休息的地方，摆设非常简单，一块长条青石作床，
床上铺了张草席，一幅白布当作薄被，此外更无别物。
LONG
  );

  set("item_desc", ([
    "床": " 小龙女睡的寒玉床。\n",
  ]));
  set("exits", ([
    "west": __DIR__ "mi-room4",
  ]));

  setup();
}

void init() {
  add_action("do_up", "up");
}


int do_up(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "床") {
    return 0;
  }
  message_vision(BLU "$N跳上了寒玉床！ \n" NOR, ob);
  ob->move(__DIR__ "cool-bed");
  return 1;

}
