// /d/gumu/shiguan.c
#include <ansi.h>

inherit ROOM;

void meetli( object ob ) ;

void create()
{
    set("short", "石棺里");
    set("long", @LONG
    四周黑黑的，什么也看不清。
LONG
    );

    setup();
}

void init()
{
    add_action("do_serch", "search");
    add_action("do_turn", "turn");
}
int do_serch ( string arg )
{
    object ob ;
    ob = this_player () ;
    if(random(20)<10){
       tell_object(ob, HIR "你在石棺里四下摸索，但什么也没发现。\n" NOR ) ;
       return 1;
    }
    tell_object(ob, HIR "你突然摸到个可容一手的凹处，於是紧紧握住了向上一提，却是纹丝不动！\n" NOR ) ;
    ob->set_temp("marks/摸到", 1);        
    return 1 ;
}

int do_turn ( string arg )
{
    object ob ;
    ob = this_player () ;
    if(!ob->query_temp("marks/摸到")) 
	return notify_fail("什么？\n");
    if( !arg ) {
         tell_object(this_player() , "你要怎么转动？\n" ) ;
         return 1 ;
      }
    
    if((arg =="left") ){
        ob->set_temp("marks/向左转", 1);
        message_vision(HIR "$N握紧凹处，用力朝左转动！\n" NOR, ob);
        return 1;
      } 
    if( (arg =="up") && (ob->query_temp("marks/向左转")) ){
       message_vision(HIR "$N握紧凹处，用力朝上一提，只听喀喇一响，棺底石板应手而起！\n" NOR, ob);
       message_vision(HIR "$N脚下一空，掉了下去！\n" NOR, ob);
       ob->move(__DIR__"lingtang");
       ob->set_temp("marks/摸到", 0);
       ob->set_temp("marks/向左转", 0);
       return 1; 
      }
   
    tell_object(ob, HIR "这个方向转不了！\n" NOR ) ;
    return 1 ;


}
     
