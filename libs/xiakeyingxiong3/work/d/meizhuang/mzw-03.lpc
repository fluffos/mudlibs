#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "梅  林");
        set("long", @LONG
                                                                
    这里是杭州梅庄外的梅林。
LONG
        );

        set("outdoors", "meizhuang");

        set("exits", ([
                "east"  : __DIR__"mzw-02",
                "west"  : __DIR__"mzw-04",
                "south" : __DIR__"mzw-03s",
                "north" : __DIR__"mz-01",
        ]));

        setup();

        replace_program(ROOM);
}