// lvke.c - 随机产生的旅客
// Designed by Carlis

#include <ansi.h>

inherit NPC;

#define SET_SKILL       20                      // 定义基本武功的值，自动生成经验
#define SPE_SKILL       0                       // 定义特殊武功的值
#define SET_SEN         0                       // 定义正气的值

string *first_name = ({ "赵","钱","孙","李","周","吴","郑","王","张","陈",
        "刘","林","许" });
string *name_words = ({ "文","武","斌","彦","良","志","忠","良","志","忠",
        "孝","雄","龙","明","勇","元","华","宏","胜","进","铭","彬","东","伟" });

string *rnd_id = ({"ra","ma","ta","pu","gu","du","so","po","lo","phi","tri","ne","she"});
string *rnd_id_tail = ({"ng","gh","ss","h","le","d","ck","m","tte"});


void create()
{
        string name, id;
        int i, _gender;

        name = first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))];
        if( random(10) > 2 ) name += name_words[random(sizeof(name_words))];

        id = rnd_id[random(sizeof(rnd_id))];
        if( random(10) > 4 ) id += rnd_id[random(sizeof(rnd_id))];
        id += rnd_id_tail[random(sizeof(rnd_id_tail))];

        i = random(30);
        if (i == 0) _gender = 0;
        else _gender = random(2);

        set_name(name, ({ id, id[1] }) );

        if (i == 0) set("title", "富商");
        else set("title", "旅客");
        set("long", @LONG
这是一位过往旅客。
LONG
        );

        set("attitude", "friendly");
        set("age", 34);
        if (_gender == 0) set("gender", "男性");
        else set("gender", "女性");

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 10);                   //

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 0);            set("force", 0);        set("force_factor", 0);
        set("max_mana", 0);             set("mana", 0);

        set_skill("unarmed", SET_SKILL);
        set_skill("parry",   SET_SKILL);
        set_skill("dodge",   SET_SKILL);
        set_skill("literate",SET_SKILL);

        setup();

        carry_object("/obj/cloth/cloth")->wear();

        if (i == 0)                                                // 金钱
                add_money("gold", random(200)+100);
        else add_money("silver", random(10));
}

int accept_fight(object me)
{
        command("say 我哪里是你的对手？\n");
        return 0;
}