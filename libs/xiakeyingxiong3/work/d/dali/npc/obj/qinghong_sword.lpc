// qinghong_sword.c 青虹剑
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.9

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIC "青虹剑" NOR, ({ "qinghong sword", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄青虹剑，它是一把出名的宝剑。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声拔出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(80);
  setup();
}
