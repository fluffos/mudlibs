// zbd-seller.c - 珠宝店老板
// Designed by Carlis

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       60                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         0                       // 定义正气的值

void create() {
  int n;

  set_name("珠宝店老板", ({ "seller", "waiter" }));

  set("long", @LONG
她就是珠宝店老板。
LONG
  );

  set("rank_info/respect", "老板");       // 尊称
  set("attitude", "friendly");
  set("gender", "女性");                 // 性别
  set("age", 22);                         // 年纪

  set("per", 26);                      // 容貌

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("vendor_goods", ([
    "/obj/money/diamond-gold": 3,
    "/obj/money/diamond-wood": 3,
    "/obj/money/diamond-water": 3,
    "/obj/money/diamond-fire": 3,
    "/obj/money/diamond-earth": 3,
  ]));

  setup();

  carry_object("/obj/cloth/cloth")->wear();       // 装备

  add_money("gold", 1);                           // 金钱
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想买珠宝吗？\n");
      break;
  }
}
