// datiepu.c - 打铁铺
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "打铁铺");
  set("long", @LONG

    这里是大理城的打铁铺。除了叮叮当当的声音，你只能感觉到一个通
红的世界，和地上的一块牌子(sign)。
LONG
  );

  set("item_desc", ([
    "sign": @TEXT
目前我们提供的服务有：
[36m
type        设定独门兵器类型。
name        设定独门兵器名称。
wield_msg   设定独门兵器装备信息。
unwield_msg 设定独门兵器卸装信息。
make        制造独门兵器。
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "south": __DIR__ "biaoju",
    "west": __DIR__ "bingqipu",
    "east": __DIR__ "jishi-e",
  ]));

  set("objects", ([
    __DIR__ "npc/smith": 1,
  ]));

  setup();

  replace_program(ROOM);
}
