// yuqidian - 玉器店
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "玉器店");
        set("long", @LONG

    这里是大理城的玉器店。在各式各样的玉器中间，坐这一位胖乎乎的
老板，笑咪咪地翻看着帐簿。据说，大理的玉器具有某些神秘的力量。
LONG
        );

        set("exits", ([
                                "south" : __DIR__"chaguan",
                                "west"  : __DIR__"guwandian",
                ]) );

                set("objects", ([
                                __DIR__"npc/yqd-seller": 1,
                                __DIR__"npc/girl": 1,
                                __DIR__"npc/boy": 3,
        ]) );

        setup();

        replace_program(ROOM);
}
