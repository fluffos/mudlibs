// kezhan.c - 云来客栈
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{

                set("short", "云来客栈");
                set("long", @LONG

    这里是大理城云来客栈。江湖上人称“云来神仙”的两大客栈，一家
“神仙客栈”位于侠客城，而“云来客栈”便在眼前。
LONG
        );

                set("exits", ([
                                "south"         : __DIR__"roade2",
                                "east"          : __DIR__"jishi-e",
                                "north"                 : __DIR__"xilou",
                                "up"            : __DIR__"kezhan_2f",
                ]) );

                set("objects", ([
                                __DIR__"npc/waiter" : 1,
                                __DIR__"npc/lvke" : 6,
                ]) );

        setup();

}

int valid_leave(object me,string dir)
{
        if (!me->query_temp("give_sleep_money") && present("waiter",environment(me))
        &&      dir == "up" )
                return notify_fail("店小二拦在楼梯口，白眼一翻，说道：怎么着？想白住？\n");
        if ( me->query_temp("give_sleep_money") && present("waiter",environment(me))
        &&      dir != "up" )
                message("vision", "店小二很奇怪地看着" + me->name() +
                        "的背影，叫道：客官已经付了银子，怎麽不住店就走了呢！\n", environment(me), me);
        me->delete_temp("give_sleep_money");
        return ::valid_leave(me, dir);
}
