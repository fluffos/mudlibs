inherit ROOM;

int valid_leave(object me,string dir);

void create()
{
        set("short", "神仙客栈二楼");
                set("long", @LONG

    这里是云来客栈二楼的走廊。你可以听到一些客房里不时地传出呼呼
的打酣声，一阵高过一阵。不时有睡意朦胧的旅客进进出出。
LONG
        );

        set("exits", ([
                 "down" :    __DIR__"kezhan" ,
                        "1" :    __DIR__"kezhan_2f1" ,
                        "2" :    __DIR__"kezhan_2f2" ,
                        "3" :    __DIR__"kezhan_2f3" ,
                        "4" :    __DIR__"kezhan_2f4" ,
                        "5" :    __DIR__"kezhan_2f5" ,
                        "6" :    __DIR__"kezhan_2f6" ,
                        "7" :    __DIR__"kezhan_2f7" ,
                        "8" :    __DIR__"kezhan_2f8" ,
        ]) );

        setup();

        // replace_program(ROOM);
}

int valid_leave(object me,string dir)
{
        mapping item, exits;
        object env, *inv;
        int i, total;

        env = environment(me);
        if( dir != "down" ) {
                if( mapp(exits = env->query("exits")) && !undefinedp(exits[dir]) ) {
                        if( ! objectp(env = find_object(exits[dir])) ) {
                                call_other(exits[dir], "???");
                                env = find_object(exits[dir]);
                        }
                        inv = all_inventory(env);
                        total = 0;
                        for(i=0; i<sizeof(inv); i++) {
                                if( inv[i]==me ) continue;
                                                if( inv[i]->is_corpse() ) continue;
                                if( !inv[i]->is_character()) continue;
                                if( !me->visible(inv[i]) ) continue;
                                total ++;
                        }
                        if( dir != "down" && total >= 1 ) {
                                return notify_fail("怎么着？想打扰别人睡觉？\n");
                        }
                }
        }
        return ::valid_leave(me,dir);
}
