// roadn1.c - 北大街
// Designed by Carlis

inherit ROOM;

void create()
{
        set("short", "北大街");
                set("long", @LONG

    这里是大理城的北大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆。东面是车马店，来自各地的旅客在那里照料自己心爱
的坐骑；西面是大理城的北集市，讨价还价的声音充满了你的耳朵。南面
是大理段府，不过看起来门口的卫兵似乎不会那么轻易让你进去。再往北
走便可以出城了。
LONG
        );

                set("outdoors", "dali");

        set("exits", ([
                                "east"  : __DIR__"chemadian",
                                "south" : __DIR__"d-men-n",
                                "west"  : __DIR__"jishi-n",
                                "north" : __DIR__"chengmen-n",
        ]));

                setup();

        replace_program(ROOM);
}
