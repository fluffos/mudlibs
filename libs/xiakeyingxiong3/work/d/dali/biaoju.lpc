#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "镖局");
  set("long", @LONG

    这里曾是大理城最大的镖局。可也许是由于近几年山贼猖狂, 镖经常
被截, 这里已经冷冷清清, 没有人光顾了.
LONG
  );

  set("exits", ([
    "north": __DIR__ "datiepu",
    "west": __DIR__ "qianzhuang",
  ]));

  set("objects", ([
    __DIR__ "npc/biaoshi": 1,
  ]));

  setup();

  replace_program(ROOM);
}
