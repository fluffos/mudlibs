#include <room.h>

inherit ROOM;

void create() {
  set("short", "布  庄");
  set("long", @LONG

    这里是大理城的布庄，老板正笑眯眯地招呼每个顾客。想起大理的布
在江湖上的美称，你不禁想掏钱买上一匹....
LONG
  );
  set("exits", ([
    "east": __DIR__ "shizhentang",
    "west": __DIR__ "caifengdian",
    "north": __DIR__ "gongyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/bz-seller": 1,
  ]));

  setup();

  replace_program(ROOM);
}
