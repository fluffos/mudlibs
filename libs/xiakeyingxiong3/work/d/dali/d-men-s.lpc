// d-men-s.c - 大门
// Designed by Carlis

inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "段府大门");
  set("long", @LONG

    这里是大理国段府的大门，门口站着一个卫士，正在警惕地看着你。
LONG
  );

  set("exits", ([
    "south": __DIR__ "roads1",
    "north": __DIR__ "d-lu-s",
  ]));

  set("objects", ([
    "/d/dali/npc/weishi": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object obj;

  if (dir == "north" && !objectp(obj = present(
    "qing tie",
    me
  )) && present("wei shi", environment(me))) {
    return notify_fail("卫士喝道：没有受到邀请的人，一律不准进入，除非你能过得了我这关！\n");
  }
  if (dir == "north" && present(
    "wei shi",
    environment(me)
  )) message_vision("卫士陪笑道：这位" + me->name() + "，请进！请进！\n");
  return ::valid_leave(me, dir);
}
