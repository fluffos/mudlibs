// kaochang.c - 考  场
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "考  场");
        set("long", @LONG

    这是大理城的考场。在国师的大力支持下，这个考场不到半年就开办
了。一名考官背着手踱来踱去，监视着考生的一举一动。
    旁边挂著一块牌子(sign)。
LONG
        );

        set("exits", ([
                                "south" : __DIR__"shuyuan",
                                "north" : __DIR__"dangpu",
        ]) );

        set("item_desc", ([
                "sign": @TEXT
这里可以使用的命令有：
[36m
quest       申请答题
answer, =   回答问题
[2;37;0m
TEXT
        ]) );

        set("objects", ([
                __DIR__"npc/kaoguan": 1,
                __DIR__"npc/kaosheng": 2,
        ]) );

        setup();

        replace_program(ROOM);
}
