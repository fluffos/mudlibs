#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "寺  院");
  set("long", @LONG

    这里是大理城的寺院。每年有许多善男信女来这里拜祭。现在是拜祭
的淡季，你可以看见几个僧人在打扫地面。
LONG
  );

  set("exits", ([
    "west": __DIR__ "chenghuangmiao",
    "north": __DIR__ "jitan",
  ]));

  set("objects", ([
    __DIR__ "npc/saodiseng": 1,
  ]));

  setup();

  replace_program(ROOM);
}
