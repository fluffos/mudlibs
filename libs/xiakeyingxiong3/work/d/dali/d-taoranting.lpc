inherit ROOM;

string look_sign(object me);

void create()
{
                set("short", "陶然亭");
                set("long", @LONG

    这里是大理段府的陶然亭，幽雅宁静的环境让你十分舒心，无论是高
谈阔论还是读书钻研，这里无疑都是上上之选。在陶然亭里站着一位老人。
LONG
                );

                set("exits", ([
                                "east"  : __DIR__"d-lu-n",
                                "south" : __DIR__"d-jiangjun-n",
                ]));

                set("objects", ([
                                "/d/dali/npc/master-gurong": 1,
                ]) );

                setup();

}

