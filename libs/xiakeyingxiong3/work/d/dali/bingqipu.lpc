#include <room.h>

inherit ROOM;

void create()
{
        set("short", "兵器铺");
        set("long", @LONG

    这里是大理城的兵器铺, 地上零乱地放着一些兵器, 主人正在整理之
中.
LONG
        );

        set("exits", ([
                                "south" : __DIR__"qianzhuang",
                                "east"  : __DIR__"datiepu",
                ]) );

        set("objects", ([
                                __DIR__"npc/bqp-seller" : 1,
         ]) );

        setup();

        replace_program(ROOM);
}

