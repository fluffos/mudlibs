#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "遇仙寺");
  set("long", @LONG
								
    这里是峨眉山的遇仙寺。
LONG
  );

  set("outdoors", "emeishan");

  set("exits", ([
    "westup": __DIR__ "main-16",
    "eastdown": __DIR__ "main-15-e",
    "southdown": __DIR__ "main-15-s1",
    "northeast": __DIR__ "main-14",
  ]));

  setup();

  replace_program(ROOM);

}
