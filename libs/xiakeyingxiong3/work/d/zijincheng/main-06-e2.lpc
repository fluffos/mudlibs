// main-06-e2.c - 紫禁城－东华门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "东华门");
  set("long", @LONG

    这里是紫禁城的东华门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    // "east"  : __DIR__"main-06-e3",
    "south": __DIR__ "main-05-e2",
    "west": __DIR__ "main-06-e1",
    "north": __DIR__ "main-07-e2",
  ]));

  setup();

  replace_program(ROOM);
}
