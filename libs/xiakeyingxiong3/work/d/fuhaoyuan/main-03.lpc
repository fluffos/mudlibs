#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "假  山");
	set("long", @LONG

    这里是侠客城富豪的假山。
LONG
	);

	set("exits", ([
                "east"	: __DIR__"main-02",
                "north"	: __DIR__"main-03n1",
                "south"	: __DIR__"main-03s1",
        ]) );			

        set("outdoors", "fuhaoyuan");

	setup();

	replace_program(ROOM);
}