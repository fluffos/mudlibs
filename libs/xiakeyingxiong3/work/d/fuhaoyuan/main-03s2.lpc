#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "小  道");
	set("long", @LONG

    这里是侠客城富豪的小道。
LONG
	);

	set("exits", ([
                "north"	: __DIR__"main-03s1",
                "west"	: __DIR__"main2-01",
        ]) );			

        set("outdoors", "fuhaoyuan");

	setup();

	replace_program(ROOM);
}