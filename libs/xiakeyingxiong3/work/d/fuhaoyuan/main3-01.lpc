#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "九曲桥");
	set("long", @LONG

    这里是侠客城富豪的九曲桥。
LONG
	);

	set("exits", ([
                "west"	: __DIR__"main3-02",
                "south"	: __DIR__"main1-02n",
        ]) );			

        set("outdoors", "fuhaoyuan");

	setup();

	replace_program(ROOM);
}