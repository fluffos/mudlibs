#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "角  门");
	set("long", @LONG

    这里是侠客城富豪的角门。
LONG
	);

	set("exits", ([
                "east"	: __DIR__"main1-01",
                "west"	: __DIR__"main1-03",
                "south"	: __DIR__"main-04",
                "north"	: __DIR__"main1-02n",
        ]) );			

        set("outdoors", "fuhaoyuan");

	setup();

	replace_program(ROOM);
}