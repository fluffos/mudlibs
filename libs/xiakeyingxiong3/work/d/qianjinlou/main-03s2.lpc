#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "花  园");
        set("long", @LONG
                                                                
    这里是千金楼的花园。
LONG
        );

        set("outdoors", "qianjinlou");

        set("exits", ([
                "north"  : __DIR__"main-03s1",
        ]));

        set("objects", ([
                __DIR__"npc/biaoxing-dahan": 2,
                __DIR__"npc/ren-fanzi": 1,
	]) );

        setup();

        replace_program(ROOM);
}