#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "游  廊");
  set("long", @LONG
                                                                
    这里是千金楼的游廊。
LONG
  );

  set("outdoors", "qianjinlou");

  set("exits", ([
    "west": __DIR__ "main-03ne2",
    "east": __DIR__ "main-03ne4",
  ]));

  set("objects", ([
    __DIR__ "npc/piaoke": 1,
    __DIR__ "npc/jinu": 1,
  ]));

  setup();

  replace_program(ROOM);
}
