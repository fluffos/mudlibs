// main-w1.c - 泉州城－西大街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG

    这里是泉州城的西大街。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main",
    "south": __DIR__ "main-w1s1",
    "west": __DIR__ "main-w2",
    "north": __DIR__ "main-w1n1",
  ]));

  setup();

  replace_program(ROOM);
}
