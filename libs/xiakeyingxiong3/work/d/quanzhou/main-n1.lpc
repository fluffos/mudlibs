#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "刺桐北街");
        set("long", @LONG

    你走在一条泉州城的刺桐北街上，人来人往非常繁忙，不时地有人骑着马匆匆
而过。西面是通往泉州府，东面是一家生意兴隆泉州客栈，来自各地的游客进进出
出，南面是泉州的城中心百源川池。 
LONG
        );

        set("city", 1);
        set("outdoors", "quanzhou");

        set("exits", ([
                "east"  : __DIR__"main-e1n1",
                "south" : __DIR__"main",
                "west"  : __DIR__"main-w1n1",
                "north" : __DIR__"main-n3",
        ]));

        setup();

        replace_program(ROOM);
}
