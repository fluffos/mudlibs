#include <ansi.h>

inherit NPC;

void create() {
  set_name("流氓", ({ "liu mang", "liu" }));

  set("long", @LONG
这是一个成天游手好闲的流氓。
LONG
  );

  set("attitude", "heroism");
  set("gender", "男性");
  set("age", 18);

  set("combat_exp", 1500);
  set("SEN", -2);

  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);

  setup();

  carry_object("/obj/misc/cloth")->wear();

  add_money("silver", 10);
}
