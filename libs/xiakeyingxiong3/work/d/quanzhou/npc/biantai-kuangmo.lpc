// biantai-kuangmo.c

#include <ansi.h>

inherit NPC;

object killer;
void bianshen();
void turnback();
void killone();
void askmoney();

void create()
{
        set_name("变态狂魔", ({ "biantai kuangmo", "kuangmo" }) );
        set("long","这是一名变态狂魔，样子很神秘。\n");
        set("gender","男性");
        set("age", 30);

        set("attitude", "heroism");

        set("str", 20 + random(11));            // 膂力         
        set("cps", 20 + random(11));            // 定力
        set("cor", 20 + random(11));            // 胆识         
        set("per", 20 + random(11));            // 容貌
        set("int", 20 + random(11));            // 悟性         
        set("con", 20 + random(11));            // 根骨
        set("spi", 20 + random(11));            // 灵性         
        set("kar", 20 + random(11));            // 福缘
/*
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
        }) );
*/
        set("force", 500);      set("max_force", 500);          set("force_factor", 10);
        set("SEN", - 50 - random( 200 ) );

        set_temp("apply/attack", 40);
        set_temp("apply/defense", 40);
        set_temp("apply/damage", 40);
        set_temp("apply/armor", 40);
        set_temp("apply/move", 40);

        set("chat_chance", 90);
        set("chat_msg", ({
           (: bianshen() :),
           (: turnback() :),     
           (: killone()  :),
           (: askmoney() :),
           (: random_move :),
        }) );

        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/blade")->wield();
        carry_object("/obj/misc/mask");

        add_money("gold", 1);
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
killer = ob;
                remove_call_out("checking");
                call_out("checking", 1, ob);
        }
}

void checking(object ob)
{
        int n;

        if( !ob || !present(ob, environment(this_object())) ) {
                if(ob == query_leader() )  set_leader(0);
                return;
        }

        // 自动生成武功参数

        n = ob->query("combat_exp") + random(10000) - 7000;
        if( n <= 0 ) n = random(3000) + 1;
        set("combat_exp", n );

        n = ob->query_skill("force", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("force", n );
        n = ob->query_skill("unarmed", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("unarmed", n );
        n = ob->query_skill("force", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("blade", n );                 // 本来的做法是取兵器中最强的一项，为了简单，这里用force取代
        n = ob->query_skill("parry", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("parry", n );
        n = ob->query_skill("dodge", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("dodge", n );
        set_skill("move", 100 + random(100) );  // 这里设置move不跟玩家的数值

        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("hunyuan-force", n );
        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("ruyi-blade", n );
        n = ob->query_skill(ob->query_skill_mapped("dodge"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("taxue-steps", n );

        map_skill("dodge", "taxue-steps");
        map_skill("move",  "taxue-steps");
        map_skill("force", "hunyuan-force");
        map_skill("blade", "ruyi-blade");
        map_skill("parry", "ruyi-blade");
}

void bianshen()
{
        string name, id,tempstr;
        object *ob;
        int i, tempnum;
        if(this_object()->is_fighting()) return;
        ob = users();
        i = sizeof(ob);
        if(i) {
                i = random(i);
	// change by fan
   				id = ob[i]->query("id");
				name =ob[i]->query("name");
                set_name(name, ({ id, "biantai kuangmo", "kuangmo" }) );
                tempstr = ob[i]->query("title");
                set("title", tempstr);
                tempstr = ob[i]->query("long");
                set("long", tempstr);
                tempstr = ob[i]->query("gender");
                set("gender", tempstr);
                tempnum = ob[i]->query("age");
                set("age", tempnum);
                tempnum = ob[i]->query("per");
                set("per",tempnum);
                tempstr = ob[i]->query("nickname");
                set("nickname",tempstr);
        
/*              id = file_name(ob[i])->query("id");
                name = file_name(ob[i])->query("name");
                set_name(name, ({ id, "biantai kuangmo", "kuangmo" }) );

				tempstr = file_name(ob[i])->query("title");
                set("title", tempstr);
                tempstr = file_name(ob[i])->query("long");
                set("long", tempstr);
                tempstr = file_name(ob[i])->query("gender");
                set("gender", tempstr);
                tempnum = file_name(ob[i])->query("age");
                set("age", tempnum);
                tempnum = file_name(ob[i])->query("per");
                set("per",tempnum);
                tempstr = ob[i]->query("nickname");
                set("nickname",tempstr);
*/
        }
}

void turnback()
{
        if(this_object()->is_fighting()) return;
        if(random(10) < 5) return;

        set_name("变态狂魔", ({ "biantai kuangmo", "kuangmo" }) );
        set("long","这是一名变态狂魔，样子很神秘。\n");

        set("gender","男性");
        set("age", 30);
        delete("title");
        delete("nickname");

        set("attitude", "heroism");

        set("str", 20 + random(11));            // 膂力         
        set("cps", 20 + random(11));            // 定力
        set("cor", 20 + random(11));            // 胆识         
        set("per", 20 + random(11));            // 容貌
        set("int", 20 + random(11));            // 悟性         
        set("con", 20 + random(11));            // 根骨
        set("spi", 20 + random(11));            // 灵性         
        set("kar", 20 + random(11));            // 福缘
}

void askmoney() 
{
      if( this_object()->query("name")=="变态狂魔" ) return;
      
      if (!killer)	return;
	  // 修改为 query(id)     bye fan
	  if( !present(killer->query("id"), environment(this_object())) ) return;
      command("say "+killer->query("name")+"，你有钱吗？先借给我一点好吗？");
}

int accept_object()
{
        return 1;
}

void killone()
{
      if( this_object()->is_fighting() ) return;
      if (!killer)	return;
	  // 修改为 query(id)     bye fan
      if( !present(killer->query("id"), environment(this_object())) )  return;
      if( random(10) < 2)
            {   command("heihei "+killer->query("id") );
                // command("say " + killer->name() + "，你死定了！！\n");
                // set_leader(killer);
                command("kill "+killer->query("id") );  
            }
}

