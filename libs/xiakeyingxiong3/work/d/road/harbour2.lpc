// Room: /d/quanzhou/harbour2.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "冰火岛");
	set("long", @LONG
这是一个极大的岛屿。岛屿西部都是尖石嶙峋的山峰，奇形怪样，
莫可名状。岛东却是一片望不到尽头的平野。高山处玄冰白雪，平
野上却是极目青绿，苍松翠柏，高大异常，更有诸般奇花异树，皆
为中土所无。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"irland1",
]));

	set("outdoors", "quanzhou");

	setup();
}

void init()
{
	add_action("do_yell","yell");
}

int do_yell(string arg)
{
        object room,me;
	me=this_player();

	if( !arg || arg=="" ) return notify_fail("你想要叫什么？\n");

        if( !(room = find_object("/d/quanzhou/boat")) ) {
		room=load_object("/d/quanzhou/boat");
		if(!room)	return 0;
	}
	
        if( arg=="boat" || arg=="chuan" || arg=="船家") {
		message_vision("$N鼓足中气，长啸一声：“船家！”\n", this_player() );
		if( room->query("idle_flag")==2 || room->query("idle_flag")==1 ) {
			tell_room(environment(me),"只听得海面上隐隐传来：“别急嘛，船才刚刚出海……”\n");
			return 1 ;
		}
		if( room->query("idle_flag")==3) {
			tell_room(environment(me),"岸边一只海船上的老船夫说道：正等着你呢，上来吧。\n");
		}
		else {
			tell_room(environment(me),"一艘海船缓缓地驶了过来，船夫将一块踏脚板搭上堤岸，以便乘客上下。\n");
			set("exits/enter", __DIR__"boat");
			room->set("exits/out",__DIR__"harbour2");
			room->set("idle_flag",3);
			call_out("sail_out", 10,room);
		}
	}
        else {
		message_vision("$N鼓足中气，长啸一声：“"+arg+"！”\n"+
				"海面上远远传来一阵回声：“"+arg+"～～～”\n",this_player() );
		return 1;
	}
	return 1;
}

void sail_out(object room)
{
       delete("exits/enter");
       tell_room(room,"船夫把踏脚板收起来，说了一声“坐稳喽”，划动木桨，大船向\n"+
			"大海驶去。\n");
       room->delete("exits/out");
	room->set("idle_flag",2);

	remove_call_out("sailing");
	call_out("sailing",10,room);
	call_out("stop_boat",20,room);
 }

void sailing(object room)
{
	object *inv;
	int i;

	inv=all_inventory(room);

	tell_room(room,"海流一直向南，带着船只日夜不停的南驶。\n");

	for(i=0;i<sizeof(inv);i++) {
		if(!userp(inv[i]))	continue;
		if(inv[i]->query("mask/north_pole"))	continue;
		if(inv[i]->query("kar")<20)	continue;
		if(random(100)!=33 )	continue;
		tell_object(inv[i],
CYN"便在此时，你眼前一亮，北方映出一片奇异莫可名状的彩光，无数奇丽\n"
"绝伦的光色，在黑暗中忽伸忽缩，大片橙黄之中夹着丝丝淡紫，忽而紫\n"
"色愈深愈长，紫色之中，迸射出一条条金光、蓝光、绿光、红光。\n"NOR
"你的思维在这一瞬间似乎也空旷了起来。\n" );
		inv[i]->add("int",5);
		inv[i]->add("max_atman",100);
		inv[i]->add("max_mana",100);
		inv[i]->set("mask/north_pole",1);
	}
}

void stop_boat(object room)
{
	object room1;
	
       tell_room(room,"船夫说“到啦，上岸吧”，随即把一块踏脚板搭上堤岸。\n");
       room->set("exits/out","/d/quanzhou/harbour1");
	room->set("idle_flag",1);

	room1=find_object("/d/quanzhou/harbour1");
	if(!room1)
		room1=load_object("/d/quanzhou/harbour1");
	if(room1)
		room1->set("exits/enter",__DIR__"boat");
	call_out("start_idle",20,room,room1);
 }

void start_idle(object room,object room1)
{
	object *ob;
	int i;

	room->delete("exits/out");
	room1->delete("exits/enter");

	ob=all_inventory(room);
	for(i=0;i<sizeof(ob);i++) {
		if(userp(ob[i])) {
			call_other("/d/quanzhou/harbour1", "sail_out", room);
			return;
		}
	}
	room->set("idle_flag",0);
}