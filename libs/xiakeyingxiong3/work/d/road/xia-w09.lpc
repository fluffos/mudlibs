#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "白龙江");
  set("long", @LONG
								
    这里是侠客城以西的白龙江。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "xia-w08",
    "west": __DIR__ "xia-w10",
  ]));

  setup();

  replace_program(ROOM);

}
