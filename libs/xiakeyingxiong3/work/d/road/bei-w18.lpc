#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "大漠风沙");
 	set("long", @LONG
								
    这里是北京城西的大漠风沙。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"east"  : __DIR__"bei-w17",
		"west"  : __DIR__"bei-w19",
		"south" : __DIR__"xibei-n15",
	]));

	setup();

	replace_program(ROOM);

}
