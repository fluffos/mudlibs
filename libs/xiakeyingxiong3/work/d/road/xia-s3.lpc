// xia-s3.c - 侠客城向南（丹江口）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "丹江口");
 	set("long", @LONG
								
    这里是侠客城以南的丹江口。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"south"  : __DIR__"xia-s4",
		"north"  : __DIR__"xia-s2",
		"west"   : "/d/wudangshan/main-01",
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
              【侠客城】
                  │
        武当山▲─※
                  │
                  ～
            衡山▲  【泉州】
[2;37;0m
LONG ;

}

