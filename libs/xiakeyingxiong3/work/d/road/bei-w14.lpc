// bei-w14.c - 北京城向西道路（塞外风光）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "塞外风光");
  set("long", @LONG
								
    这里是北京城西的塞外风光。路边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "bei-w13",
    "west": __DIR__ "bei-w15",
    // Micro: 1999-02-25 删除白驼山
    // "south" : __DIR__"temp-baituoshan",
    "north": __DIR__ "bei-w14n",
  ]));

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
      灵鹫宫▲──※──【北京】
    ▲星宿海      │
                  │
                  ▲
                白驼山
[2;37;0m
LONG;

}
