#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "河  流");
 	set("long", @LONG
								
    这里是侠客城西北方向北的河流。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"south"  : __DIR__"xibei-n06",
		"north"  : __DIR__"xibei-n08",
	]));

	setup();

	replace_program(ROOM);

}
