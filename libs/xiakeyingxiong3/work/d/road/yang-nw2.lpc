#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "黄土路");
 	set("long", @LONG
								
    这里是扬州城西北的黄土路。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"southeast"  : __DIR__"yang-nw1",
		"northwest"  : __DIR__"yang-nw3",
	]));

	setup();

	replace_program(ROOM);

}

