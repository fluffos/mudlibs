#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "敦煌石窟");
 	set("long", @LONG
								
    这里是北京城西的敦煌石窟。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"east"  : __DIR__"bei-w11",
		"west"  : __DIR__"bei-w13",
		"south" : __DIR__"temp-daxueshan",
	]));

	setup();

	replace_program(ROOM);

}
