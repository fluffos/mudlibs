// xinan-s18.c - 侠客城西南向南（昆  明）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "昆  明");
 	set("long", @LONG
								
    这里是侠客城西南向南的昆明。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"south"  : __DIR__"xinan-s19",
		"north"  : __DIR__"xinan-s17",
		"west"   : __DIR__"da-e3",
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
            【侠客城】
             ▲峨眉山
                │
    【大理】──※
                │
                └▲无量山
[2;37;0m
LONG ;

}
