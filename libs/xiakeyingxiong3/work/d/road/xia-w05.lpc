// xia-w05.c - 侠客城向西（古战场）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "古战场");
 	set("long", @LONG
								
    这里是侠客城以西的古战场。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"east"  : __DIR__"xia-w04",
		"west"  : __DIR__"xia-w06",
		"north" : __DIR__"zhong-s3",
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
                ▲终南山
    光明顶▲    │
    峨眉山▲──※──【侠客城】
    【西藏】 
[2;37;0m
LONG ;

}

