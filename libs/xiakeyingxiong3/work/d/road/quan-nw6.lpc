#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "炎帝陵");
 	set("long", @LONG
								
    这里是泉州西北的炎帝陵。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"southeast"  : __DIR__"quan-nw5",
		"northwest"  : __DIR__"quan-nw7",
	]));

	setup();

	replace_program(ROOM);

}
