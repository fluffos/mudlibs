#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "快活林");
 	set("long", @LONG
								
    这里是侠客城以东的快活林。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"east"  : __DIR__"xia-e8",
		"west"  : __DIR__"xia-e6",
	]));

	setup();

	replace_program(ROOM);

}
