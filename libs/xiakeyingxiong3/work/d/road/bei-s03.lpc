#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
								
    这是北京城南大官道。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "south": __DIR__ "bei-s04",
    "north": __DIR__ "bei-s02",
  ]));

  setup();

  replace_program(ROOM);

}
