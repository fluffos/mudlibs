// hei-s14.c - 北京城向南（黄土大道）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;
void greeting();

void create() {
  set("short", "黄土大道");
  set("long", @LONG
								
     这里是北京城南黄土大道。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "south": __DIR__ "bei-s15",
    "north": __DIR__ "bei-s13",
  ]));
  setup();


}

void init() {
  call_out("greeting", 1);
}

void greeting() {
  object obj;
  if (objectp(obj = present("stone", this_object())))
    return;
  else {
    if (random(10) == 1)
      obj = new("/obj/wizard/stone");
    else obj = new("/obj/wizard/stone2");
    obj->move(this_object());
    return;
  }

}
