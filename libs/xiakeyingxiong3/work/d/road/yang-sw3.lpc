#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "常  州");
  set("long", @LONG
								
    这里是扬州城西南的常州。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southeast": __DIR__ "yang-sw4",
    "northwest": __DIR__ "yang-sw2",
  ]));

  setup();

  replace_program(ROOM);

}
