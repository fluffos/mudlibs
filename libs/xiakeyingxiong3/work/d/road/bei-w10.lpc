#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "嘉峪关");
  set("long", @LONG
								
    这里是北京城西万里长城嘉峪关。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "bei-w09",
    "west": __DIR__ "bei-w11",
  ]));

  setup();

  replace_program(ROOM);

}
