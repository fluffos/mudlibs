#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "祖尔肯乌拉山");
  set("long", @LONG
								
    这里是侠客城西北方向北的祖尔肯乌拉山。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "south": __DIR__ "xibei-n01",
    "north": __DIR__ "xibei-n03",
  ]));

  setup();

  replace_program(ROOM);

}
