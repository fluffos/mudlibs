// xibei-n05.c - 西北方向北（布喀达坂峰）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "布喀达坂峰");
 	set("long", @LONG
								
    这里是侠客城西北方向北的布喀达坂峰。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"south"  : __DIR__"xibei-n04",
		"north"  : __DIR__"xibei-n06",
		"east"   : __DIR__"guang-w3",
//		"west"   : __DIR__"kun-e3",昆仑暂时关闭
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
/*
[33m
      星宿海▲  ▲灵鹫宫  
              │
  昆仑山▲──※──▲光明顶
              │
           【西藏】
[2;37;0m
*/

	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
      星宿海▲  ▲灵鹫宫  
              │
              ※──▲光明顶
              │
           【西藏】
[2;37;0m
LONG ;

}

