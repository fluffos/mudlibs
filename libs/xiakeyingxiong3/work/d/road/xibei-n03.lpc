#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "沱沱河");
 	set("long", @LONG
								
    这里是侠客城西北方向北的沱沱河。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"south"  : __DIR__"xibei-n02",
		"north"  : __DIR__"xibei-n04",
	]));

	setup();

	replace_program(ROOM);

}
