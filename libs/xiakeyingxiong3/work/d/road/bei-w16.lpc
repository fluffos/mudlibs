#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "戈壁滩");
 	set("long", @LONG
								
    这里是北京城西的戈壁滩。一走进来，你仿佛迷失了方向。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"southeast" : __DIR__"bei-w15",
		"southwest" : __DIR__"bei-w17",
		"northwest" : __DIR__"bei-w16",
		"northeast" : __DIR__"bei-w16",
	]));

	setup();

	replace_program(ROOM);

}
