inherit ROOM;

#include <ansi.h>

void create()
{
        set("short", "阿水的小屋");
        set("long", @LONG

    这里是阿水（radio）的小屋。这是大名鼎鼎「小财神」阿水的房子，
只见房内摆设极其简陋，一张破床上随随便便铺着些稻草；床头挂着一个
酒袋，床边摆着张三条腿的木桌，桌上堆着几个鸡腿和几根吃剩的鸡骨头，
房间内唯一比较耀眼的是床头的一块闪闪发亮的怪石，似乎是天外之物。
再有就是给客人座的几张小板凳，估计是主人自己动手做的，除此之外，
门边还挂着一把似乎已经生绣的破剑，剑鞘隐隐有血光。门上还钉着一幅
朋友送的条幅（tiao fu）。
LONG
        );

        set("item_desc", ([
                "tiao fu" : @LONG
这条幅能告诉你主人的“发财之路”....据说主人的私人财产有XX万金！
LONG, 
        ]));

        set("exits", ([ 
                "east" : "/d/yuanlin-shanzhuang/sz-wsy",
        ]));

        // set("outdoors", "center");

        setup();

        replace_program(ROOM);
}

