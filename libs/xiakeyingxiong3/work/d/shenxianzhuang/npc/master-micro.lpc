#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me1();
string ask_me2();

void create()
{
        set_name("张三丰", ({ "master micro" }));

        set("long",@LONG
他是侠客英雄传的开山祖师。他身材甚是魁伟，二十来岁的年纪，身着淡
黄长衫，腰悬长剑，俊雅清贵，潇洒闲逸。他生得浓眉大眼，脸上微有风
霜之色，顾盼之际，极有威势，举手投足，十分的豪迈自在。
LONG
        );

        create_family("侠客英雄传", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "男性" );
        set("age", 24);

        set("str", 70);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 70);         // 悟性         
        set("con", 70);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 2000);         set("atman", 4000);
        set("max_force", 5000);         set("force", 10000);    set("force_factor", 500);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 10000000);
        // set("SEN",10000000);

        set_skill("force",    300);     set_skill("taixuan-force", 300);
        set_skill("sword",    300);     set_skill("dugu-jianqi", 300);
        set_skill("unarmed",  300);
        set_skill("parry",    300);
        set_skill("move",     300);     set_skill("lingbo-steps", 300);
        set_skill("dodge",    300);
        set_skill("literate", 300);

        map_skill("force",      "taixuan-force");
        map_skill("sword",      "dugu-jianqi");
        map_skill("unarmed",    "dugu-jianqi");
        map_skill("parry",      "dugu-jianqi");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                // (: perform_action :),                // (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
                CYN "张三丰长叹一声，说道：你不是我的对手，你还是去吧。\n" NOR,
                CYN "张三丰随手和你过招，却把关切的眼神向他的夫人灰姑娘身上投去。\n" NOR,
        }) );
        
        set("inquiry", ([
                "叛师"    : (: ask_me1 :),
                "水晶宫"  : (: ask_me2 :),
        ]));

        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob)
{
        command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
        return;
}

string ask_me1()
{
        object me;

        me = this_player();

        if( me->query("betrayer") ) {
                if( me->query("combat_exp") >= 15000 ) {
                        command( "sigh" );
                        return "想叛师？早就对你说要考虑清楚，现在晚啦！";
                }
                else {
                        me->set("betrayer", 0);
                        command( "nod" );
                        return "年轻人，下回拜师可要考虑清楚啊！否则后悔都来不及啦。";
                }
        }
        else {
                command( "hehe" );
                return "想叛师？年纪轻轻还来得及，年纪大了就不行啦。";
        }
}

string ask_me2()
{
        if( this_player()->query("family/family_name") == "神仙山庄" ) {
                command( "nod" );
                this_player()->move("/d/shenxianzhuang/double");
                tell_object(this_player(), "张三丰对你说：你想去神仙山庄的水晶宫吗？这里就是啊。\n");
                return "又多了一个上当受骗的可怜人。";
        }
        return "你说什么我不懂耶。";
}

int do_kill()
{
        object ob;

        if( objectp( ob = present("master cguk", environment(this_object())) ) ) {
                message_vision("张三丰的夫人灰姑娘对$N发动攻击！\n", this_player());
                ob->kill_ob(this_player());    
        }
        else    
                this_object()->kill_ob(this_player());          

        return 1;
}

int accept_fight(object me)
{
        return do_kill();
}

int accept_kill(object me)
{
        return do_kill();
}

