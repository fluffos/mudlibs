void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say( this_object()->query("name") + HIY"笑嘻嘻地说道：你想去神仙山庄的梦幻时空吗？很好玩的耶！\n要玩玩吗？(enter)\n"NOR);
}
