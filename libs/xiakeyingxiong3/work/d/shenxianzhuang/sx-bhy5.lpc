#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "百花园");
  set("long", @LONG
								
    这里是神仙山庄的百花园。
LONG
  );

  set("outdoors", "taishan");

  set("exits", ([
    "east": __DIR__ "sx-bhy2",
    "south": __DIR__ "sx-bhy5",
    "west": __DIR__ "sx-bhy5",
    "north": __DIR__ "sx-gc1",
  ]));

  setup();

  replace_program(ROOM);

}
