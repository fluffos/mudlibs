
inherit ROOM;

void create()
{
	object	con, item;
        set("short", "休息室");
        set("long", @LONG
    这是一间给华山派弟子休息的房子。里面放着几张床，一张桌子和几张椅子
几名华山弟子正在这里休息。他们一边在谈论自己的武功进展一边喝茶，一副优
哉闲哉的样子。墙上除了一扇窗之外，还挂着几把练武用的木剑。
LONG
        );
        set("exits", ([ 
	  "south"    : __DIR__"dating",
]));
        set("item_desc", ([
                "窗": "
                        这是一扇比较破旧的木窗！\n",
        ]) );
	set("objects", ([ 
		"/d/huashan/obj/wall" : 1,
	]));
        setup();
}

void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string 		obj, from;
	object		me, wall, target, taro;

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all") {
			write("一次不能拿太多东西。\n");
			return 1;
		}
		wall =  present("wall",this_object());
		target =  present(from,this_object());
		me = this_player();
		if( target == wall ) {
			taro =  present(obj, target);
			if(taro && random(10) > 4) {
				message_vision("$N趁没人注意的时候，鬼鬼祟祟地拿了点什么，放进怀里！\n", me);
				me->set_temp("marks/steal_weapon", 1); 
			}
		}
	}
	return 0;
}

void reset()
{
        object          *inv;
        object          con, item;
        int             i;

        ::reset();
        con = present("wall", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 2) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new("/d/huashan/obj/sword");
                item->move(con);
                item = new("/d/huashan/obj/sword");
                item->move(con);
				}
}
