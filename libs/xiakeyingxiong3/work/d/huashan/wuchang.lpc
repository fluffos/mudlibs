
inherit ROOM;
#include <room.h>
void create()
{
        set("short", "华山派练武场");
        set("long", @LONG
    这是鼎鼎有名的江湖门派 -- 华山派的练武场。两排兵器架对称的放在场地
的两旁。地上的青石可能是由于长年累月的磨损，已经变成一高一低的小坑地，
练武场的北面有一扇木门，门框已经显得很陈旧。
LONG
        );
        set("exits", ([ 
	  "east"    : __DIR__"gate",
	  "south"    : __DIR__"chufang",
	  "west"    : __DIR__"dating",
	  "north"    : __DIR__"bingqishi",
]));
        set("objects", ([
                __DIR__"npc/gao_genming" : 1,
       ]) );
        set("outdoors", "huashan");
        setup();
        create_door("north", "木门", "south", DOOR_CLOSED);
}
