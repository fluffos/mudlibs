
inherit ROOM;
void create()
{
        set("short", "华山禁地");
        set("long", @LONG
    这是一条比较偏僻的小路。路的两旁杂草丛生，由于这条路可能是没什么
人走动，有些杂草已经覆盖在小路上，让这条小路显得更加荒凉。在路上，一
块大木牌（sign)竖立在正中央    
LONG
        );
        set("item_desc", ([
                "sign" : @TEXT
[1;31m		  华山禁地，擅入者，格杀无论 [2;30;0m
TEXT
        ]) );
        set("exits", ([ 
	  "northup"    : __DIR__"siguoya",
	  "southdown"  : __DIR__"huashan6",
]));
        set("outdoors", "wanmei");
        setup();

}
int valid_leave(object me, string dir)
{
	if(dir == "northup"){
	if( me->query("give_eat") != 0)
		return 1;		
	else
			return notify_fail("忽然你听到一声大喝“不得乱闯！”，你不禁收住刚迈开得脚步。\n");
	}
	return 1;
}

