
// #include <npc.h>
#include <ansi.h>

inherit NPC;

void create()
{
        set_name("华山弟子", ({ "dizi" }));

        create_family("华山派", 15, "弟子");

        set("class", "swordman");

        set("gender", "男性" );
        set("age", 22);

        set("long",@LONG
    华山派普通弟子一个。
LONG
        );

        // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
        // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
        // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
        // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

        set("str", 18);         // 膂力         
        set("cps", 18);         // 定力
        set("cor", 18);         // 胆识         
        set("per", 18);         // 容貌
        set("int", 18);         // 悟性         
        set("con", 18);         // 根骨
        set("spi", 18);         // 灵性         
        set("kar", 18);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 100);         set("force", 150);        set("force_factor", 5);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 100000);
        // set("SEN", 0);

        set_skill("force",    60);     set_skill("zixia-force", 60);
        set_skill("sword",    60);     set_skill("huashan-sword", 60);
        set_skill("unarmed",  60);     set_skill("huashan-zhang", 60);
        set_skill("parry",    60);
        set_skill("move",     60);     set_skill("huashan-steps", 60);
        set_skill("dodge",    60);
        set_skill("literate", 60);

        map_skill("force",      "zixia-force");
        map_skill("sword",      "huashan-sword");
        map_skill("blade",      "fanliangyi-blade");
        map_skill("unarmed",    "huashan-zhang");
        map_skill("parry",      "huashan-sword");
        map_skill("move",       "huashan-steps");
        map_skill("dodge",      "huashan-steps");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "recover" :),
        }) );
        
        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/sword")->wield();
}
