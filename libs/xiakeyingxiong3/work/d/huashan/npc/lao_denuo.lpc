// 华山派NPC -- 劳德诺 （lao_denuo.c）
// Dboykey(Key) 孔雀		1998.2.23

// #include <npc.h>
#include <ansi.h>

inherit NPC;

int steal_book();

void create() {
  set_name("劳德诺", ({ "lao denuo", "lao", "master" }));
  set("nickname", "二师兄");

  create_family("华山派", 14, "弟子");
  set("rank_info/respect", "大侠");
  set("class", "swordman");

  set("gender", "男性");
  set("age", 42);

  set("long", @LONG
他是华山派的弟子中年龄最大的，此人在华山中做事一直都是比较
中规中据。但这几天看到他时，总觉得此人有点怪怪的，不知时为
什么。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎
  set("inquiry", ([
    "秘籍": (: steal_book :),
    "紫霞秘籍": (: steal_book :),
  ]));

  set("str", 18);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 10);         // 胆识         
  set("per", 14);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 18);         // 根骨
  set("spi", 28);         // 灵性         
  set("kar", 18);         // 福缘

  set("max_kee", 50000); set("kee", 50000);
  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 1500); set("force_factor", 50);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 1800000);
  // set("SEN", 0);

  set_skill("force", 140); set_skill("zixia-force", 140);
  set_skill("sword", 140); set_skill("huashan-sword", 140);
  set_skill("unarmed", 140); set_skill("huashan-zhang", 140);
  set_skill("parry", 140);
  set_skill("move", 140); set_skill("huashan-steps", 140);
  set_skill("dodge", 140);
  set_skill("literate", 140);

  map_skill("force", "zixia-force");
  map_skill("sword", "huashan-sword");
  map_skill("blade", "fanliangyi-blade");
  map_skill("unarmed", "huashan-zhang");
  map_skill("parry", "huashan-sword");
  map_skill("move", "huashan-steps");
  map_skill("dodge", "huashan-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

int steal_book() {
  object me;
  me = this_player();
  if (((int)me->query_temp("marks/陆大有")) != 0) {
    if ((string)me->name() == "陆大有") {
      say(HIY "劳德诺神秘的对你说道：前两天我发现了师傅的秘籍放在他们的房里。\n" NOR);
      say(HIY "你找到后，让我也分享一下。\n" NOR);
      me->set_temp("marks/陆大有", 0);
      me->move("/d/huashan/xiangfang");
      me->set_temp("book", 1);
      return 1;
    } else {
      say(HIY "劳德诺说道：你说的事我不是很清楚。\n" NOR);
      say(HIY "劳德诺说道：这位" + RANK_D->query_respect(me)
        + "请到休息室稍为休息，饭菜马上送到。\n" NOR);
      return 1;
    }
  } else {
    say(HIY "劳德诺说道：你说的事我不是很清楚。\n" NOR);
  }
  return 1;
}
