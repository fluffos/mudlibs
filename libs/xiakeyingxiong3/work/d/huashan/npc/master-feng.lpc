#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("风清扬", ({ "feng qingyang", "feng", "master" }));

        set("long",@LONG
他是风清扬。
LONG
        );

        create_family("华山派", 11, "长老");
        set("rank_info/respect", "前辈");
        set("gender", "男性" );
        set("age", 75);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_kee",4000);    set("kee",4000);
        set("max_gin",4000);    set("gin",4000);
        set("max_sen",4000);    set("sen",4000);

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 4000000);
        set("SEN",2000);

        set_skill("force",    190);     set_skill("zixia-force", 190);
        set_skill("sword",    190);     set_skill("dugu-sword", 190);
        set_skill("blade",    220);     set_skill("fanliangyi-blade", 220);
        set_skill("unarmed",  150);     set_skill("huashan-zhang", 150);
        set_skill("parry",    150);
        set_skill("move",     120);     set_skill("shenxing-steps", 120);
        set_skill("dodge",    120);
        set_skill("literate", 150);

        map_skill("force",      "zixia-force");
        map_skill("sword",      "dugu-sword");
        map_skill("blade",      "fanliangyi-blade");
        map_skill("unarmed",    "huashan-zhang");
        map_skill("parry",      "dugu-sword");
        map_skill("move",       "shenxing-steps");
        map_skill("dodge",      "shenxing-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob)
{

        if( (string)ob->query("family/family_name") != "华山派") {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，我只收本门弟子。");
                return;
        } 

        if( ob->query_skill("huashan-sword", 1) < 100) {
                command("say 这位" + RANK_D->query_respect(ob) + "的剑法还学得不够？");
                return;
        } 

        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
