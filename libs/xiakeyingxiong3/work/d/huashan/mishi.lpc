
inherit ROOM;

void create()
{
        set("short", "密室");
        set("long", @LONG
    这里是一间很小的密室，大概只能容纳三，四个人。由于没有光线，四周显
得黑乎乎得，简直就是伸手不见五指。你只能靠摸索才能找到出路。
LONG
        );
        set("exits", ([ 
		"out"  : __DIR__"chuangdi",
]));
	set("no_fight",1);
	set("no_magic",1);
        setup();
}

void init()
{
	add_action("do_search","search");		
}

int do_search(string arg)
{
	object		ob;

	ob = this_player();
	if( ob->is_busy() )
               	return notify_fail("你的动作还没有完成，不能移动。\n");
	message_vision("$N仔细地四周的墙壁 . . . \n", ob);
	ob->start_busy(2);
	call_out("search_obj", 4, ob);
	return 1;
}

int search_obj(object me)
{
	int 	kar;
	int exp;
	object	wimble;

	if(!(this_object()->query("marks/没了"))) {
		kar = (int)me->query("kar");
			exp = (int)me->query("combat_exp");
		if( kar > 60 ) kar = 60;
		if( (random(60 - kar) < 5) && exp >= 20000) {
			this_object()->set("marks/没了", 1);
			message_vision("$N找到了一样东西，放进了怀里。\n", me);
			seteuid( geteuid(me));
			wimble = new("/d/huashan/obj/book1");
			wimble->move(me);
		}
		else
			message_vision("$N什么都没找到。\n", me);
	}
	else
		message_vision("$N什么都没找到。\n", me);

	return 1;
}

void reset()
{	::reset();

	delete("marks/没了");
}
