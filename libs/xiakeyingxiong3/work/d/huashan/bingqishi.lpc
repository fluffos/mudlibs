inherit ROOM;
#include <room.h>
void create() {
  object con, item;
  set("short", "兵器室");
  set("long", @LONG
    从门口透过的点点微光，你可以看到室内摆着几个破旧的兵器架。架上已经
布满了蜘蛛网，架上的兵器也布满了灰尘。一切都显得破旧不堪。地上也布满了
灰尘，一脚踩上去，就留下一个清晰得脚印。可以认为，这是很久没人来过得地
方。
LONG
  );
  set("exits", ([
    "south": __DIR__ "wuchang",
  ]));
  set("objects", ([
    "/d/huashan/obj/shelf": 1,
  ]));
  setup();
  create_door("south", "木门", "north", DOOR_CLOSED);
}

void init() {
  add_action("do_get", "get");
}

int do_get(string arg) {
  string obj, from;
  object me, shelf, target, taro;

  if (sscanf(arg, "%s from %s", obj, from) == 2) {
    if (obj == "all") {
      write("一次不能拿太多东西。\n");
      return 1;
    }
    shelf = present("weapon shelf", this_object());
    target = present(from, this_object());
    me = this_player();
    if (target == shelf) {
      taro = present(obj, target);
      if (taro && random(10) > 4) {
        message_vision("$N趁没人注意的时候，鬼鬼祟祟地拿了点什么，放进怀里！\n", me);
        me->set_temp("marks/steal_weapon", 1);
      }
    }
  }
  return 0;
}

void reset() {
  object *inv;
  object con, item;
  int i;

  ::reset();
  con = present("weapon shelf", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 8) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new("/d/huashan/obj/junksword");
    item->move(con);
    item = new("/d/huashan/obj/junksword");
    item->move(con);
    item = new("/d/huashan/obj/junksword");
    item->move(con);
    item = new("/d/huashan/obj/junkblade");
    item->move(con);
    item = new("/d/huashan/obj/junkblade");
    item->move(con);
    item = new("/d/huashan/obj/junkblade");
    item->move(con);
    item = new("/d/huashan/obj/old_book");
    item->move(con);
    item = new("/d/huashan/obj/old_book");
    item->move(con);
  }
}
