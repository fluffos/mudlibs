
#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create()
{
        set_name( HIY "弯曲了的熟铜棍" NOR, ({ "tong stick", "stick" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根变了型的熟铜棍。\n");
                set("value", 0);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一声抽出一根$n握在手中。\n");
                set("unwield_msg", "$N将放下手中的$n。\n");
        }
        init_stick(45);
        setup();
}
