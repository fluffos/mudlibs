inherit ITEM;

void create()
{
        set_name("粗瓷茶杯", ({ "ci cup", "茶杯"}) );
        set_weight(40);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只粗瓷茶杯。\n");
                set("value", 100);
        }
}

