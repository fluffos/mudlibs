inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "思过崖");
        set("long", @LONG
    这里就是华山派弟子犯错后受罚的地方，四周云雾环绕，在这除了石
头之外就没有其他任何东西了。在一块巨大的石壁前，有一片光滑的凹陷
地方，那是历代犯错的华山弟子由于长期的面壁思过长坐造成的。由于日
光的照射把面壁者的身影投射在石壁上，令一小片石壁的颜色与周围的石
颜色不同，那也可以说是诚之所在的反映了。
LONG
        );
	set("exits", ([ 
		"southdown" : "/d/huashan/jindi",
//		"northdown" : "/d/huashan/yongdao",
	]));
        set("item_desc", ([
                "石壁": "
                        这些石头显得特别奇怪！\n",
                "凹陷地方": "
                        你伸手敲（peen）了一下，听到声音后，觉得石壁好象是中空的！\n",
                "一小片石壁": "
                        这些石壁好象有点与众不同的样子！\n"

        ]) );
        set("objects", ([
                __DIR__"npc/cheng_buyou" : 1,
                __DIR__"npc/feng_buping" : 1,
       ]) );
        setup();
}

void init()
{
        add_action("do_peen", "peen");
}
int do_peen(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要敲开什么？\n");
                return 1;
        }
        if( arg == "小片石壁" || arg == "small stone")
        {
        me = this_player();
        message_vision("$N奋力敲开石壁，发现了一条里面黑漆漆的甬道。\n", me);
	if( !query("exits/northdown") ) {
	set("exits/northdown", __DIR__"yongdao1");
	call_out("close_path", 9);
	}
        return 1;
        }
        else
        {
                write("你不可以敲"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/northdown") ) return;
        message("vision",
"一个无名老叟突然出现在石壁面前，对着甬道轻叹一声，拣起石块封住了甬道。然后消失了！\n",
                this_object() );
		delete("exits/northdown");
}

int valid_leave(object me)
{
	     me->delete("give_eat");
		return 1;		
}
