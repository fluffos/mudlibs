#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "竹  林");
 	set("long", @LONG
								
    这里是武当山竹林。
LONG
	);

	set("outdoors", "wudangshan");

 	set("exits", ([
		"east"      : __DIR__"wd-zl-3",
		"south"     : __DIR__"wd-zl-2",
		"west"      : __DIR__"wd-zl-2",
		"north"     : __DIR__"wd-zl-1",
	]));

	setup();

	replace_program(ROOM);

}

