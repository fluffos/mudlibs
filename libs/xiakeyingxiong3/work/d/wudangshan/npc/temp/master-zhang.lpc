#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("张三丰", ({ "zhang sanfeng", "zhang", "master" }));

  set("long", @LONG
他是武林中的不世奇人，就是他独创出辉映后世、照耀千古的武当一派。
他已经百年高寿，但身躯挺拔如松，毫无老态。他面上红润光滑，一把花
白长须飘于胸前，炯炯双目露出慈善的眼光，一身青布道袍更显仙风道骨。
LONG
  );

  create_family("武当派", 1, "开山祖师");
  set("rank_info/respect", "祖师");
  set("gender", "男性");
  set("age", 100);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", 10000);

  set_skill("force", 200); set_skill("taiji-force", 200);
  set_skill("sword", 200); set_skill("taiji-sword", 250);
  set_skill("unarmed", 200); set_skill("taiji-quan", 250);
  set_skill("parry", 200);
  set_skill("move", 200); set_skill("tiyun-steps", 200);
  set_skill("dodge", 200);
  set_skill("literate", 200); set_skill("taoism", 200);

  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-sword");
  map_skill("move", "tiyun-steps");
  map_skill("dodge", "tiyun-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    // (: exert_function, "powerup" :),
    // (: perform_action :),           // (: perform_action, "sword.counterattack" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob) {
  if (((string)ob->query("gender") != "男性")) {
    command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门只收男徒。");
    return;
  }
  if (((int)ob->query("cps") < 20) || ((int)ob->query("con") < 20)) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
    return;
  }
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
