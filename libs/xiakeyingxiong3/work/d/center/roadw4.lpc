inherit ROOM;

void create()
{
        set("short", "西大街");
        set("long", @LONG

    你走在西大街上，踩着坚实的青石板地面。南边是一间比武讨论室，
北面是一个城隍庙。
    
LONG);
        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"roadw3",
                "south" : __DIR__"taolunshi",
                "west"  : __DIR__"gatew",
                "north" : __DIR__"chenghuangmiao",
        ]));

        setup();

	replace_program(ROOM);
}
