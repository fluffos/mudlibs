inherit ROOM;

void create()
{
        set("short", "西大街");
        set("long", @LONG

    这里是侠客城的西大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆，许多人都往东边走去，那里有一个热闹的广场。南边
是一家钱庄，可以听到叮叮当当的金银声音。北边是这里最高的权力机构－－
神仙楼，据说是神仙居住的地方。
    路边挂著一块牌子(sign)。
LONG
        );

        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"guangchang",
                "south" : __DIR__"bank",
                "west"  : __DIR__"roadw2",
                "north" : "/d/wizard/guest_room",
        ]));

        set("item_desc", ([
                "sign": @TEXT
这里可以使用的命令有：
[36m                           
fight           争位
[2;37;0m
TEXT
        ]) );

        set("objects", ([
                "/obj/npc/zuo-shi": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
