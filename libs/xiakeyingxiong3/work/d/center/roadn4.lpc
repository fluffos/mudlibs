inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG

    你走在北大街上，踩着坚实的青石板地面。北面是城门。东边是车马
店。西边是驿站。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "chemadian",
    "south": __DIR__ "roadn3",
    "west": __DIR__ "posthouse",
    "north": __DIR__ "gaten",
  ]));

  setup();

  replace_program(ROOM);
}
