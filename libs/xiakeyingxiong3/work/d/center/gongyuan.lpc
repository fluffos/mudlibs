#include <room.h>

inherit ROOM;

void create() {
  set("short", "公  园");
  set("long", @LONG

    这里是侠客城的公园。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "xiaoxihu",
    "south": __DIR__ "heisonglin",
    "north": __DIR__ "biwuchang",
  ]));

  set("objects", ([
    __DIR__ "npc/boy": 2,
  ]));

  setup();

  replace_program(ROOM);
}
