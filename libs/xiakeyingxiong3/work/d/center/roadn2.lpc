inherit ROOM;

void create()
{
        set("short", "北大街");
        set("long", @LONG

    你走在北大街上，踩着坚实的青石板地面。东边是一家妓院千金楼，
西边是龙门镖局。
LONG);
        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"jiyuan",
                "south" : __DIR__"roadn1",
                "west"  : __DIR__"biaoju",
                "north" : __DIR__"roadn3",
        ]));

        setup();

	replace_program(ROOM);
}
