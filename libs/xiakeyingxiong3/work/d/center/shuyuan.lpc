#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "白鹿书院");
	set("long", @LONG

    这里是侠客城白鹿书院。窗明几净，一尘不染。一位庄重严肃的老先
生坐在太师椅上讲学。在他的两侧坐满了求学的学生。一张古意盎然的书
案（table） 放在老先生的前面。老先生的身后是一个书架（shelf ）。
讲堂内多历代楹联石刻（shike ），足见书院历史的悠久。值得一提的是
嵌在讲堂前左壁的学规（xuegui）。
LONG
	);

        set("item_desc", ([
                "xuegui": @TEXT
学规上写着：
[36m
日讲经书三起，日看纲目数页。
通晓时务物理，参读古文诗赋。
读书必须过笔，会课按时蚤完。
夜读仍戒晏起，疑误定要力争。

求学需缴学费十两
[2;37;0m
TEXT, 
                "table": @TEXT
这是一张古意盎然的书案，上面摆着几本翻开了的线装书籍（book）。
你忍不住想取（take）过来看看。
TEXT, 
                "shelf": @TEXT
这是老先生身后的一个书架，里面摆着几本的线装书籍（book）。
你忍不住想取（take）出来看看。
TEXT, 
        ]) );

	set("exits", ([
                "south" : __DIR__"shudian",
                "west"  : __DIR__"zhaiyuan",
                "north" : __DIR__"kaochang",
        ]) );			

        set("objects", ([
                __DIR__"npc/teacher": 1,
                __DIR__"npc/student": 3,
	]) );

	setup();
}

void init()
{
        add_action("do_take", "take");
}

void reset()
{
        ::reset();
        set("take_available_table" , 5);
        set("take_available_shelf" , 2);
}

int do_take(string arg)
{
        object obj;

        if( !arg ) return notify_fail("你要拿什麽？\n");
        if( arg == "book" || arg == "book from table" ) {
	        if( query("take_available_table") ) {
        	        obj = new("/obj/book/literate_book_b");
                	obj->move(this_player());
	                message_vision("$N从桌面上拿起$n。\n", this_player(), obj);
        	        add("take_available_table", -1);
                	return 1;
	        }
	        write("桌面上的东西好像被拿光了。\n");
               	return 1;
	}
        if( arg == "book from shelf" ) {
	        if( query("take_available_shelf") ) {
        	        obj = new("/obj/book/literate_book_c");
                	obj->move(this_player());
	                message_vision("$N从书架上拿出$n。\n", this_player(), obj);
        	        add("take_available_shelf", -1);
                	return 1;
	        }
	        write("书架里的东西好像被拿光了。\n");
               	return 1;
	}
        write("你要拿什麽？\n");
        return 1;
}
