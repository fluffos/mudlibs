inherit ROOM;

void create()
{
        set("short", "东大街");
        set("long", @LONG

    你走在东大街上，踩着坚实的青石板地面。东边是是城门。南边是一
家打铁铺。北边是一家杂货铺。
LONG
	);

        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"gatee",
                "south" : __DIR__"datiepu",
                "west"  : __DIR__"roade3",
                "north" : __DIR__"zahuopu",
        ]));

        setup();

	replace_program(ROOM);
}
