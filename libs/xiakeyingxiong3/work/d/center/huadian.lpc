#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "飘香花店");
	set("long", @LONG

    这是侠客城飘香花店。大老远的，你就闻到这里飘出来的花香。还有
几只蜜蜂蝴蝶向这里飞来。里面站着一位姑娘，脸孔就象花儿一样好看。
LONG
	);

	set("exits", ([
                "east"  : __DIR__"zhuqipu",
                "south" : __DIR__"jishitang",
                "west"  : __DIR__"roads3",
        ]) );

        set("objects", ([
                __DIR__"npc/seller-hd": 1,
	]) );

	setup();

	replace_program(ROOM);
}
