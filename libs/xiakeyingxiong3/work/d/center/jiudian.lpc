#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "醉仙楼");
	set("long", @LONG

    这里是侠客城醉仙楼。方圆数百里内提起醉仙楼可以说是无人不知，
无人不晓。当年苏学士云游到此，对醉仙楼的花雕酒赞不绝口，欣然为其
题匾，流下一段传遍海内的佳话，从此醉仙楼名声大震。醉仙楼的二楼雅
座是人们经常聚会娱乐的地方，时不时传来谈笑和打闹的声音。
LONG
	);

/* ==== 放到嘉庆城内
    这里是一间热闹整洁酒店。虽然店中只有一位老人曲三和他的傻孙女
傻姑打点一切，但这个酒店是附近生意最好的，以风味小菜和好的服务闻
名。另外，楼上是侠客城中年轻人聚会娱乐的地方，时不时传来谈笑和打
闹的声音。
*/
	set("exits", ([
                "east"	: __DIR__"roads3",
                "south"	: __DIR__"buzhuang",
                "west"	: __DIR__"xilou",
//		"up"	: __DIR__"",
        ]) );			

        set("objects", ([
                __DIR__"npc/fighter-c": 1,
	]) );

	setup();

	replace_program(ROOM);
}
