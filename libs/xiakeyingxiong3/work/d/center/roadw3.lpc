inherit ROOM;

void create()
{
        set("short", "西大街");
        set("long", @LONG
    你走在西大街上，踩着坚实的青石板地面。南边是一家药店，北面是
一家书院。
    
LONG);
        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"roadw2",
                "south" : __DIR__"yaodian",
                "west"  : __DIR__"roadw4",
                "north" : __DIR__"shudian",
        ]));

        set("objects", ([
                __DIR__"npc/drunk": 1 ]) 
	);

        setup();

	replace_program(ROOM);
}
