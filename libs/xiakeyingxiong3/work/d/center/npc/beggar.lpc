// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

#include <ansi.h>

inherit NPC;

#define SET_SKILL	30			// 定义基本武功的值（随机），自动生成经验
#define SET_SEN		0			// 定义正气的值

void create() {
  int n;

  set_name("乞丐", ({ "beggar" }));

  set("long", @LONG
一个满脸风霜之色的老乞丐。
LONG
  );

  set("attitude", "friendly");
  set("gender", "男性");   // 性别
  set("age", 56);    // 年纪

  // set("str", 30);			// 膂力		
  // set("cps", 30);			// 定力
  // set("cor", 30);			// 胆识		
  // set("per", 30);			// 容貌
  // set("con", 30);			// 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("chat_chance", 15);
  set("chat_msg", ({
    "乞丐说道：好心的大爷哪～赏我要饭的几文钱吧～\n",
    "乞丐说道：好心的大爷哪～可怜可怜我要饭的吧～\n",
    "乞丐伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬糜了。 \n",
    (: random_move :)
  }));

  setup();

  carry_object("/obj/cloth/puo-cloth")->wear();  // 装备
}

int accept_object(object me, object obj) {
  command("smile");
  command("say 多谢这位" + RANK_D->query_respect(me) + "，您好心一定会有好报的！");
  return 1;
}

int accept_fight(object me) {
  command("say " + RANK_D->query_respect(me) + "饶命！小的这就离开！\n");
  return 0;
}
