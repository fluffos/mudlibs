#include <room.h>

inherit ROOM;

void create()
{
	set("short", "小树林");
	set("long", @LONG

    这里是侠客城的一片小树林。
LONG
	);

        set("outdoors", "center");

	set("exits", ([
                "west"	: __DIR__"muqipu",
                "south"	: __DIR__"guancaipu",
                "north"	: __DIR__"qiongren",
        ]) );			

        set("objects", ([
                __DIR__"npc/liumang": 2,
	]) );

	setup();

	replace_program(ROOM);
}
