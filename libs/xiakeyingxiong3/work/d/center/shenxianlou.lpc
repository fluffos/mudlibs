    "/d/jiangjunfu/npc/obj/qinghong_sword",


    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",
    "/obj/money/thousand-gold",                     // skills = 181～200

  });

  int *settime = ({
  });

  int *exp = ({
    1000, 10000, 25000, 55000, 100000, 250000, 500000, 1000000, 3000000, 8000000,
    10000000, 20000000
  });

  int *point = ({
    12, 41, 48, 55, 59, 69, 75, 86, 94,
    96, 99, 102
  });

  object me, bei, mis_ob;
  string pre;
  int time, i, p_begin, p_end;

  me = this_player();
  if (!objectp(bei = present("shi bei"))) return 0;

  pre = sprintf("寻");

  p_begin = 0;
  p_end = 0;
  for (i = 0; i < sizeof(exp); i++) {
    if (me->query("combat_exp") > exp[i]) {
      p_begin = p_end;
      p_end = point[i];
    } else break;
  }

  time = 180 + random(15) * 30;

  if (me->query("combat_exp") >= exp[sizeof(exp) - 1]) {
    time /= 2;
    p_begin = point[sizeof(exp) - 2];
    p_end = point[sizeof(exp) - 1];
  }

  switch (random(10)) {
    case 0:
    case 1: time /= 4;              // 减短时间
    i = random(p_end);
    break;

    case 2:                         // 加入较简单的任务
    case 3:
    case 4: time /= 3;              // 减短时间
    i = random(p_end - p_begin / 2) + p_begin / 2;
    break;

    case 5:                         // 在正常的经验范围内取任务
    case 6:
    case 7:
    case 8:
    case 9: i = random(p_end - p_begin) + p_begin;
    break;
  }
  if (i < 0 || i >= sizeof(obj))  // 超出范围则随机取
    i = random(sizeof(obj));

  if (i < 0) i = 0;              // 数值校正
  if (i >= sizeof(obj)) i = sizeof(obj) - 1;

  mis_ob = new(obj[i]);

  tell_object(me, sprintf("%s显示出一行字迹：你这次的任务是%s%s。\n"
    + "        请在%s内完成它。\n",
    bei->name(), pre, mis_ob->query("name"), clock(time)));
  me->set("quest/start", time());
  me->set("quest/time", time);
  me->set("quest/id", mis_ob->query("id"));
  me->set("quest/name", mis_ob->query("name"));
  me->set("quest/flag", 1);
  destruct(mis_ob);
  return 1;
}

