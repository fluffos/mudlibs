int do_quest(string arg) {
  string *living = ({
    "/obj/npc/meng-zhu",
    "/obj/npc/zuo-shi",
    "/obj/npc/zuo-shi",
    "/obj/npc/you-shi",
    "/obj/npc/you-shi",
    "/obj/npc/shang-shan",
    "/obj/npc/shang-shan",
    "/obj/npc/shang-shan",
    "/obj/npc/fa-e",
    "/obj/npc/fa-e",
    "/obj/npc/fa-e",
  });
  object me, bei, mis_ob;
  int n;

  me = this_player();

  mission(me);
  if (!objectp(bei = present("shi bei"))) return 0;
  if (me->query("quest/flag") == 1) return 0;
  if (me->query("quest/flag") == 2) {      // 玩家的任务失败
    message_vision(CYN "只见$n" CYN "周围的雾气将$N" CYN "团团围住，许久不散。\n" NOR,
      me, bei);
    me->delete("quest/flag");
    me->delete("quest/start");
    me->delete("quest/id");
    me->delete("quest/time");
    me->delete("quest/name");
    me->delete("quest/done");       // 玩家连继完成任务的次数
    me->receive_damage("gin", 30);
    me->receive_damage("sen", 30);
  }
  if (me->query("quest/flag") == 3) {      // 玩家完成任务
    me->delete("quest/flag");
    me->delete("quest/start");
    me->delete("quest/id");
    me->delete("quest/time");
    me->delete("quest/name");
  }

  if (!me->query("quest/flag")) {        // 玩家没有任务时，给任务给玩家
    if (random(100) == 0) {
      n = random(sizeof(living));
      mis_ob = new(living[n]);
      tell_object(me, sprintf("%s显示出一行字迹：你这次的任务是杀%s(%s)。\n"
        + "        请在%s内完成它。\n",
        bei->name(), mis_ob->query("name"), mis_ob->query("id"), clock(600)));
      me->set("quest/start", time());
      me->set("quest/time", 600);
      me->set("quest/id", mis_ob->query("id"));
      me->set("quest/name", mis_ob->query("name"));
      me->set("quest/flag", 1);
      me->set("quest/done", 8);       // 加重奖励, hehe
      destruct(mis_ob);
      return 1;
    }
    if (random(2) == 0) do_find_quest();
    else do_kill_quest();
  }

  return 1;
}

void mission(object me) {
  int t;
  if ((time() - (int)me->query("quest/start")) <= (int)me->query("quest/time")) return;
  if (me->query("quest/flag") == 1) me->set("quest/flag", 2);
}

string clock(int t) {
  if (t < 1) t = 1;
  if (t < 60) return chinese_number(t) + "秒";
  return chinese_number(t / 60) + "分钟" + (t % 60 ? chinese_number(t % 60) + "秒" : "");
}
