inherit ROOM;

#include <ansi.h>
#include <command.h>

void mission(object me);
string clock(int t);

void create() {
  set("short", "神仙楼");
  set("long", @LONG

    这里是侠客城的神仙楼。走进来一看，四面却看不到一堵墙，也看不
到一根柱子，只见凌空有一道奇幻的光柱垂将下来。光柱很柔和地照在一
块通体晶莹、弥漫着仙雾的巨大石碑（stone ）上。但见神光离合，如临
梦境。石碑一看就知道不是凡间之物，相传，自从开天辟地以来，它就一
直放在这里，历代以来的英雄豪杰、旷世巨魔都曾经来过这里潜心钻研武
学的奥秘。在石碑的左侧，有一个天然的小喷泉，正哗哗啦啦地冒出清澈
的水流。
LONG
  );

  set("item_desc", ([
    "stone": @LONG
这是一块表面非常平整的石碑，里面似乎有些字迹。你忍不住想把小水池
里的泉水泼到石碑上面（quest ），来看看石碑上面写的是什么。如果仔
细端详，你可以发现，石碑背后有一个洞（hole）。
LONG,
    "hole": @LONG
这是石碑背后的一个洞，看起来只有尺来深，里面不时地闪烁着各色的光
华。洞里似乎可以放（put ）进什么东西，但是奇怪的是，某些东西一放
进去，就瞬间不见了！
LONG
  ]));

  set("exits", ([
    "up": "/d/wizard/guest_room",
    //                "east"  : __DIR__"roadn1",
    //                "south" : __DIR__"roadw1",
  ]));

  set("objects", ([
    __DIR__ "obj/shibei": 1,
  ]));

  setup();
}

void init() {
  add_action("do_put", "put");
  add_action("do_quest", "quest");
}

int do_put(string arg) {
  object *inv, who, bei, ob;
  int i, m, n;

  who = this_player();
  if (PUT_CMD->main(who, arg)) {
    bei = present("shi bei");
    if (objectp(bei)) {
      if (objectp(ob = present("diamond", bei))
        && who->query("quest/flag")) {
        message_vision("$n" CYN "显示出一行字迹：" + who->name()
          +CYN "，我们正在提炼五行的精华，" + ob->name()
          +CYN "我们就收下了。\n        "
          + "为了表示感谢，你这次的任务就算了吧！\n" NOR,
          who, bei);
        destruct(ob);
        who->delete("quest/flag");
        who->delete("quest/start");
        who->delete("quest/id");
        who->delete("quest/time");
        who->delete("quest/name");
        // who->delete("quest/done");   // 玩家连继完成任务的次数
        return 1;
      }
      if (!stringp(who->query("quest/id"))) return 1;
      if (!objectp(ob = present(who->query("quest/id"), bei))) return 1;
      if (who->query("quest/flag") == 1
        && (time() - (int)who->query("quest/start"))
        <= (int)who->query("quest/time")
        && ob->query("id") == who->query("quest/id")
        && ob->query("name") == who->query("quest/name")) {
        message_vision(CYN "只见$N放到$n" CYN "里的" + ob->name()
          +CYN "瞬间就不见了！\n" NOR,
          who, bei);
        destruct(ob);
        write("你成功的完成了任务！你的潜能和战斗经验都得到了提高。\n");
        who->delete("quest/flag");
        who->delete("quest/start");
        who->delete("quest/id");
        who->delete("quest/time");
        who->delete("quest/name");
        who->add("quest/done", 1);              // 玩家连继完成任务的次数
        n = who->query("combat_exp") / 10000;
        if (n > 100) n = 100;
        m = random(10) + random(n / 2 + 1) + 1;
        if (who->query("quest/done") >= 8) {   // 玩家连续八次完成任务，加大奖励
          who->delete("quest/done");      // 玩家连续完成任务的次数
          m += 50;
          n += 50;
        } else {                                  // 玩家连续完成任务的的奖励
          n += random(n) + 5 * who->query("quest/done");
        }
        n += random(50) + 1;
        who->add("potential", m);
        who->add("combat_exp", n);
        tell_object(who, sprintf("你的潜能增加了%s点！\n", chinese_number(m)));
        tell_object(who, sprintf("你的经验增加了%s点！\n", chinese_number(n)));
      }
    }
    return 1;
  } else return 0;
}

