#include <room.h>
#include <login.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "工作室");
	set("long", @LONG

    这里是侠客城的工作室。老板是一个一看就知道是十分精明的干瘦的
中年人，总是带着一脸奸笑。你可以看到许多人正在忙忙碌碌的工作着，
门口挂著一块牌子(sign)。
LONG
	);

	set("exits", ([
                "east"	: __DIR__"datiepu",
                "south"	: __DIR__"baichaoyuan",
                "north"	: __DIR__"roade3",
        ]) );			

        set("item_desc", ([
                "sign": @TEXT
现在正紧缺人手，急需雇佣一批短工来干活。
[36m
work        开始工作。
[2;37;0m
TEXT
        ]) );

        set("objects", ([
                __DIR__"npc/kuli": 2,
	]) );

	set("no_fight", 1);
	set("no_magic", 1);

	setup();

}

void init()
{
        add_action("do_work", "work");
}

int do_work(string arg)
{
        object me;
	string tempstr;

        me = this_player();

	if(me->query_temp("working") == 1) return notify_fail("你已经在工作当中了！\n");

	message_vision("$N开始了辛苦的工作....\n", me);

	if( random(20) == 0 ) {
		tempstr = "工作室老板突然冒了出来：“$N！你竟敢干活偷懒！”\n";
		message_vision(tempstr, me);
		me->move( START_ROOM );
		tempstr = "工作室老板一脚把$N踢了出来：“给我滚！叫你干活偷懒！”\n";
		message_vision(tempstr, me);
		return 1;
	}

        me->set_temp("working", 1);
        call_out( "compelete_work", 3, me );
	return 1;
}

private void compelete_work(object me)
{
        object ob;
	int i;

        me->delete_temp("working");

	if( present(me) ) {			// 如果玩家还在原地
		message_vision("$N的工作终于结束了，可人也累的要死。\n", me);
		tell_object(me, "你的经验增加了！\n");
		me->add("gin", -20);
		me->add("sen", -20);
		me->add("combat_exp", 1);
		for( i = 0; i < 3; i ++ ) {		// 三两银子
			ob = new("/obj/money/silver");
			ob->move(me);
		}
		tell_object(me, "老板对你说：这是你的工钱，一共三两银子。\n");
	}

	return;
}

