inherit ROOM;

void create()
{
        set("short", "南大街");
        set("long", @LONG

    你走在南大街上，踩着坚实的青石板地面。东边是一家赌场。西边是
一家富豪大院。
LONG);
        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"duchang",
                "south" : __DIR__"roads3",
                "west"  : __DIR__"furen",
                "north" : __DIR__"roads1",
        ]));

        setup();

	replace_program(ROOM);
}
