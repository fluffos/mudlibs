#include <room.h>

inherit ROOM;

void create()
{
        set("short", "布  庄");
        set("long", @LONG

    这里是侠客城的布庄，到处放满了各式各样的布匹。一个肥头大耳的
老板笑嘻嘻地招呼着顾客，和气生财是他的口头禅。伙计殷勤地向你介绍
每钟布料的优点，让你不忍心拒绝。
LONG
        );
        set("exits", ([
                "east"  : __DIR__"roads4",
                "west"  : __DIR__"caifengdian",
                "north" : __DIR__"drinkery",
        ]) );
