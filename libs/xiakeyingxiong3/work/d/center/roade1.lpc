// roade1.c - 东大街
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG

    这里是侠客城的东大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆，许多人都往西边走去，那里有一个热闹的广场。南边
是一家店铺，墙上写着一个大大的“当”字，仔细倾听，可以听到压低的
讨价还价的声音。北边是一家生意兴隆的客栈，门额上悬挂一方横匾，来
自各地的人们进进出出。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "roade2",
    "south": __DIR__ "hockshop",
    "west": __DIR__ "guangchang",
    "north": __DIR__ "inn",
  ]));

  set("item_desc", ([
    "sign": @TEXT
这里可以使用的命令有：
[36m				
fight		争位
[2;37;0m
TEXT
  ]));

  set("objects", ([
    "/obj/npc/you-shi": 1,
  ]));

  setup();

  replace_program(ROOM);
}
