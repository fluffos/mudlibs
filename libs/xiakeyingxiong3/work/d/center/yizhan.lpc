#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "侠客驿");
  set("long", @LONG
								
    这里是负责侠客城官府文书跟军令往来的侠客驿，驿站的官员顺便接
一些百姓的信件，方便玩家之间的通信。交给他一定的钱，就可以给你一
个信箱。驿站大门口上悬著一块木牌（sign）。
LONG
  );

  set("exits", ([
    "east": __DIR__ "roadn4",
    "south": __DIR__ "zaotang",
    "west": __DIR__ "dahuaishu",
  ]));

  set("objects", ([
    __DIR__ "npc/officer": 1,
  ]));

  setup();

  // replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  object mail_box;
  if (objectp(mail_box = present("mailbox", me))) {
    tell_object(me, "驿站站长把你的邮箱收了回去。\n");
    destruct(mail_box);
  }
  return ::valid_leave(me, dir);
}
