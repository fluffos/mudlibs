                $BWHT$$GRN$※※※※※※※※※※※※※※※※※$NOR$
                $BWHT$$GRN$※                              ※$NOR$
                $BWHT$$GRN$※  $BLK$打  遍  天  下  无  敌  手$GRN$  ※$NOR$
                $BWHT$$GRN$※                              ※$NOR$
                $BWHT$$GRN$※※※※※※※※※※※※※※※※※$NOR$

        $BWHT$$GRN$※※※※※$NOR$                              $BWHT$$GRN$※※※※※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$脚$GRN$  ※$NOR$                              $BWHT$$GRN$※  $BLK$拳$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$踢$GRN$  ※$NOR$  这里是侠客城的比武场休息室。$BWHT$$GRN$※  $BLK$打$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$北$GRN$  ※$NOR$  从这里可以看到北面的大擂台。$BWHT$$GRN$※  $BLK$南$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$海$GRN$  ※$NOR$  擂台上面挂着一幅很大的对联。$BWHT$$GRN$※  $BLK$山$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$蛟$GRN$  ※$NOR$                              $BWHT$$GRN$※  $BLK$猛$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※  $BLK$龙$GRN$  ※$NOR$                              $BWHT$$GRN$※  $BLK$虎$GRN$  ※$NOR$
        $BWHT$$GRN$※      ※$NOR$                              $BWHT$$GRN$※      ※$NOR$
        $BWHT$$GRN$※※※※※$NOR$                              $BWHT$$GRN$※※※※※$NOR$
$NOR$
LONG
        )
        );

        // set("outdoors", "center");
        set("only_wiz_open", 1);
        set("only_wiz_close", 1);
        set("watch_fight_room", 1);

        set("exits", ([
                // "northup"  : __DIR__"biwuchang_fight_room",
                "out"      : __DIR__"biwuchang",
        ]) );                   

        ::create();

        create_door("out", "镶着铜钉的大门", "enter", DOOR_CLOSED);
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        string target, where;
        object me, who;

        me = this_player();

        if( nullp(arg) ) arg = "";

        if( sscanf(arg, "%s %s", target, where)==2 );
        else return notify_fail("命令格式：push 某人 某地（left, center, right）\n");

        if(!objectp(who = present(target, environment(me))) || !living(who))
                return notify_fail("这里没有这个人。\n");

        if( query_ip_name(me) == query_ip_name(who) && !wizardp(me)  ) 
                return notify_fail("自己不能推自己上台。\n");

        if( where == "left" ) {
                who->move( __DIR__"biwuchang_rest_room_1");
                message_vision("$N将$n推上左边的休息室。\n", me, who);
        }
        if( where == "center" ) {
                who->move( __DIR__"biwuchang_fight_room");
                message_vision("$N将$n推上比武大擂台。\n", me, who);
        }
        if( where == "right" ) {
                who->move( __DIR__"biwuchang_rest_room_2");
                message_vision("$N将$n推上右边的休息室。\n", me, who);
        }

        who->set("gin", (int)who->query("max_gin"));
        who->set("kee", (int)who->query("max_kee"));
        who->set("sen", (int)who->query("max_sen"));
        who->set("eff_gin", (int)who->query("max_gin"));
        who->set("eff_kee", (int)who->query("max_kee"));
        who->set("eff_sen", (int)who->query("max_sen"));

        who->set("eff_atman", (int)who->query("max_atman"));
        who->set("eff_force", (int)who->query("max_force"));
        who->set("eff_mana", (int)who->query("max_mana"));
        who->set("food", who->max_food_capacity());
        who->set("water", who->max_water_capacity());
        who->set("poison", 0);

        return 1;
}
