#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "瓷器铺");
	set("long", @LONG

    这里是侠客城的瓷器铺。里面放着各式各样的瓷器。最引人注目的就是
屋子中内摆的一个刻有八仙过海图样花瓷瓶（vase），据称是当世少见的精
品。
LONG
	);

	set("exits", ([
                "south" : __DIR__"bingqipu",
                "west"  : __DIR__"caichang",
                "north" : __DIR__"yanzhidian",
        ]) );			

        set("objects", ([
                __DIR__"npc/seller-cqp": 1,
	]) );

	setup();

	replace_program(ROOM);
}
