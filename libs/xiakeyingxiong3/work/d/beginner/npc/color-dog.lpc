// color-dog.c
// 修改：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.7

inherit NPC;

void create()
{
        set_name("小花狗", ({ "dog" }) );
        set("race", "野兽");
        set("age", 3);
        set("long", "一只浑身长满美丽斑点的小花狗。\n");
        
        set("str", 20);
        set("cor", 20);

        set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("chat_chance", 6);
        set("chat_msg", ({
                "小花狗用鼻子闻了闻你的脚。\n",
                "小花狗在你的脚边挨挨擦擦的，想讨东西吃。\n",
                "小花狗对著你摇了摇尾巴。\n" }) );
        set_temp("apply/attack", 10);
        set_temp("apply/armor", 3);

        setup();
}

int accept_object(object who, object ob)
{
        if( ob->id("bone") ) {
                set_leader(who);
                message("vision", name() + "高兴地汪汪叫了起来。\n", environment());
                return 1;
        }
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	say( "小花狗看到你，高兴得汪汪叫，摇着尾巴向你迎了过来。\n" );
}
