// officer.c
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6

inherit NPC;

string ask_me();

void create()
{
        set_name("教官", ({ "officer" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long",
                "他是侠客英雄传的教官，现在正笑咪咪地忙着。\n");

        set("per", 30);
        set("str", 30);
        set("cor", 30);
        set("SEN",10);

        set("combat_exp", 10000);

        set("attitude", "friendly");

        set("chat_chance", 6);
        set("chat_msg", ({
                query("name") + "说道：在一些地方工作（work）可以赚到钱，但小心不要劳累过度了。\n",
                query("name") + "说道：临走之前，请把钱存入钱庄，把必要的东西存入当铺，以及把其它东西卖掉。\n",
                query("name") + "说道：小心不要乱杀其它玩家！唉....江湖恩恩怨怨，几时能了？\n",
                query("name") + "说道：多行侠义之事，必有好报！\n",
        }) );

        set("inquiry", ([
                "帮助"  : (: ask_me :),
                "help"  : (: ask_me :),
        ]));

        setup();

        carry_object("/obj/cloth/cloth")->wear();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say( query("name") + "很高兴地对你说：欢迎您加入侠客英雄传大家庭，您需要什么帮助吗？\n" );
}

string ask_me()
{


        object env, ob;

return "嗯，现在没有了。";


        env = environment(this_player());
        if (  present("gold", env) || present("gold", this_player()) 
        ||      this_player()->query("id") == "guest" )
                return "不是已经给你了吗，怎麽又来要了？真是贪得无厌！";

        ob = new("/obj/food/leg");
        ob -> move(env);
        ob = new("/obj/food/wineskin");
        ob -> move(env);
        // ob = new("/obj/money/gold");
        // ob -> move(env);

        message_vision(query("name")+"从背后的大箱子里取出许多东西。\n", this_player());

        return "拿去吧，这是为您准备的东西，不要让我失望！";
}
