// main-w4s3.c - 北京城－富豪院

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "富豪院");
        set("long", @LONG

    这里是北京城的富豪院。
LONG
        );

        set("city", 1);
        // set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-w3s3",
                "south" : __DIR__"main-w4s4",
                // "west"  : __DIR__"main-w5s3",
                "north" : __DIR__"main-w4s2",
        ]));

        setup();

        replace_program(ROOM);
}
