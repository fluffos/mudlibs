// main-w1n3.c - 北京城－翰林院

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "翰林院");
        set("long", @LONG

    这里是北京城的翰林院。
LONG
        );

        set("city", 1);
        // set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-n3",
                "south" : __DIR__"main-w1n2",
                "west"  : __DIR__"main-w2n3",
                "north" : __DIR__"main-w1n4",
        ]));

        setup();

        replace_program(ROOM);
}
