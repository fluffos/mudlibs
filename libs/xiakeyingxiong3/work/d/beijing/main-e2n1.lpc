// main-e2n1.c - 北京城－户部府

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "户部府");
  set("long", @LONG

    这里是北京城的户部府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e3n1",
    "south": __DIR__ "main-e2",
    "west": __DIR__ "main-e1n1",
    "north": __DIR__ "main-e2n2",
  ]));

  setup();

  replace_program(ROOM);
}
