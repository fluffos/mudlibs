// main-s3.c - 北京城－永定街

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "永定街");
        set("long", @LONG

    这里是北京城的永定街。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e1s3",
                "south" : __DIR__"main-s4",
                "west"  : __DIR__"main-w1s3",
                "north" : __DIR__"main-s2",
        ]));

        setup();

        replace_program(ROOM);
}
