// main-w2s1.c - 北京城－宣武门

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "宣武门");
        set("long", @LONG

    这里是北京城的宣武门。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-w1s1",
                "south" : __DIR__"main-w2s2",
                "west"  : __DIR__"main-w3s1",
                "north" : __DIR__"main-w2",
        ]));

        setup();

        replace_program(ROOM);
}
