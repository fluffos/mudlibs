// main-gw.c - 北京城－西大门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西大门");
  set("long", @LONG

    这里是北京城的西大门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w4",
    "west": "/d/road/bei-w01",
  ]));

  setup();

  replace_program(ROOM);
}
