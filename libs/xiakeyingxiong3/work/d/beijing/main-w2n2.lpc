// main-w2n2.c - 北京城－礼部府

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "礼部府");
  set("long", @LONG

    这里是北京城的礼部府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w1n2",
    "south": __DIR__ "main-w2n1",
    "west": __DIR__ "main-w3n2",
    "north": __DIR__ "main-w2n3",
  ]));

  setup();

  replace_program(ROOM);
}
