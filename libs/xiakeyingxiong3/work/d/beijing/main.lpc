// main.c - 北京城－大广场

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "大广场");
        set("long", @LONG

    这里是北京城的大广场。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e1",
                "south" : __DIR__"main-s1",
                "west"  : __DIR__"main-w1",
                "north" : __DIR__"main-n1",
        ]));

        setup();

        replace_program(ROOM);
}
