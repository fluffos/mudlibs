#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("韦小宝", ({ "wei xiaobao", "wei" }));

        set("long",@LONG
他就是韦小宝。为扬州城丽春园名妓韦春花所生。他年约二十来岁，满面
笑容，但双眼目光四处扫荡，掩盖不住内心的奸滑。他视钱如命，好玩女
人，说话油腔滑调，出口成“脏”，但却受到康熙皇帝的重用，做了一品
鹿鼎公。
LONG
        );

        create_family("鹿鼎门", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "男性");
        set("age", 24);

        set("str", 20);         // 膂力         
        set("cps", 20);         // 定力
        set("cor", 20);         // 胆识         
        set("per", 26);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 5000000);
        set("SEN", -200);

        set_skill("force",    180);     set_skill("weiguan-force", 180);
        set_skill("sword",    180);     set_skill("xiaobao-juehuo", 180);
        set_skill("unarmed",  180);
        set_skill("parry",    180);
        set_skill("move",     120);     set_skill("shenxing-steps", 120);
        set_skill("dodge",    120);

        map_skill("force",      "weiguan-force");
        map_skill("sword",      "xiaobao-juehuo");
        map_skill("unarmed",    "xiaobao-juehuo");
        map_skill("parry",      "xiaobao-juehuo");
        map_skill("move",       "shenxing-steps");
        map_skill("dodge",      "shenxing-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),           // (: perform_action, "sword.counterattack" :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/        
        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob)
{

        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "，咱们还是交个朋友吧。");
                return;
        } 
        if( ((int)ob->query("per") < 20) || ((int)ob->query("int") < 20) ) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
