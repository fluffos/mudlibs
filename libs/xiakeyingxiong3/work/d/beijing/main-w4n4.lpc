// main-w4n4.c - 北京城－西直门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西直门");
  set("long", @LONG

    这里是北京城的西直门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w3n4",
    "south": __DIR__ "main-w4n3",
    // "west"  : __DIR__"main-w5n4",
    // "north" : __DIR__"main-w4n5",
  ]));

  setup();

  replace_program(ROOM);
}
