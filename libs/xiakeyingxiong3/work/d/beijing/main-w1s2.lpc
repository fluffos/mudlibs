#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "酒  楼");
        set("long", @LONG

    这里是北京城的酒  楼。
LONG
        );

        set("city", 1);
        // set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-s2",
                "south" : __DIR__"main-w1s3",
                "west"  : __DIR__"main-w2s2",
                "north" : __DIR__"main-w1s1",
        ]));

        setup();

        replace_program(ROOM);
}
