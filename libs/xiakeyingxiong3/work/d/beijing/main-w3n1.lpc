// main-w3n1.c - 北京城－鳌拜府

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "鳌拜府");
  set("long", @LONG

    这里是北京城的鳌拜府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w2n1",
    "south": __DIR__ "main-w3",
    "west": __DIR__ "main-w4n1",
    "north": __DIR__ "main-w3n2",
  ]));

  setup();

  replace_program(ROOM);
}
