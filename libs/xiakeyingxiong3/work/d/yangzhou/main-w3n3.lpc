// main-w3n3.c - 扬州城－瘦西湖

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "瘦西湖");
  set("long", @LONG

    这里是扬州城的瘦西湖。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-w2n3",
    "south": __DIR__ "main-w3n2",
    // "west"  : __DIR__"main-w4n3",
    // "north" : __DIR__"main-w3n4",
  ]));

  set("objects", ([
    "/d/center/npc/selang": 1,
    "/d/center/npc/nuselang": 1,
  ]));
  setup();

  replace_program(ROOM);
}
