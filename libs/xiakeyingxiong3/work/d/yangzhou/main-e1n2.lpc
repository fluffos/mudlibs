// main-e1n2.c - 扬州城－个  园

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "个  园");
        set("long", @LONG

    这里是扬州城的个  园。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-e2n2",
                "south" : __DIR__"main-e1n1",
                "west"  : __DIR__"main-n2",
                "north" : __DIR__"main-e1n3",
        ]));
        set("objects", ([
                "/d/center/npc/dog": 1 ,
                "/d/center/npc/butterfly": 1,
                "/d/center/npc/bee": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
