// main-n2.c - 扬州城－北大街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG

    这里是扬州城的北大街。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e1n2",
    "south": __DIR__ "main-n1",
    "west": __DIR__ "main-w1n2",
    "north": __DIR__ "main-n3",
  ]));

  setup();

  replace_program(ROOM);
}
