// main-w2s2.c - 扬州城－仙鹤寺

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "仙鹤寺");
        set("long", @LONG

    这里是扬州城的仙鹤寺。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w1s2",
                "south" : __DIR__"main-w2s3",
                "west"  : __DIR__"main-w3s2",
                "north" : __DIR__"main-w2s1",
        ]));

        setup();

        replace_program(ROOM);
}
