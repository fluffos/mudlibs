// main-w3.c - 扬州城－西大街

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "西大街");
        set("long", @LONG

    这里是扬州城的西大街。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w2",
                "south" : __DIR__"main-w3s1",
                "west"  : __DIR__"main-gw",
                "north" : __DIR__"main-w3n1",
        ]));

        setup();

        replace_program(ROOM);
}
