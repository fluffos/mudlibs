inherit ROOM;

void create()
{
        set("short", "书  屋");
        set("long", @LONG

    这里是扬州城的书  屋。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-s3",
