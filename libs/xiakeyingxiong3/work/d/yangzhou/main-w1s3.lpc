                "west"  : __DIR__"main-w2s3",
                "north" : __DIR__"main-w1s2",
        ]));

        set("objects", ([
                "/d/center/npc/teacher": 1,
                "/d/center/npc/student": 3,
     ]));
        setup();

        replace_program(ROOM);
}
