// main-w2s1.c - 扬州城－车马店

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "车马店");
        set("long", @LONG

    这里是扬州城的车马店。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w1s1",
                "south" : __DIR__"main-w2s2",
                "west"  : __DIR__"main-w3s1",
                "north" : __DIR__"main-w2",
        ]));

        set("objects", ([       
                "/d/center/npc/seller-cmd": 1,
                "/d/center/npc/huoji": 1,
        ]) );
        setup();

        replace_program(ROOM);
}
