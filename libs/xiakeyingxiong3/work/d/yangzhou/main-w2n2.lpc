// main-w2n2.c - 扬州城－西  园

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "西  园");
        set("long", @LONG

    这里是扬州城的西  园。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w1n2",
                "south" : __DIR__"main-w2n1",
                "west"  : __DIR__"main-w3n2",
                "north" : __DIR__"main-w2n3",
        ]));

        set("objects", ([
                "/d/center/npc/butterfly": 1,
                "/d/center/npc/butterfly": 1,
                "/d/center/npc/girl": 2,
                "/d/center/npc/bee": 1,

         ]) );
        setup();

        replace_program(ROOM);
}
