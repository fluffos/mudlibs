// main-e2s3.c - 扬州城－何  园

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "何  园");
  set("long", @LONG

    这里是扬州城的何  园。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e3s3",
    // "south" : __DIR__"main-e2s4",
    "west": __DIR__ "main-e1s3",
    "north": __DIR__ "main-e2s2",
  ]));

  set("objects", ([
    "/d/center/npc/youngman": 1,
    "/d/center/npc/younglady": 1,
  ]));
  setup();

  replace_program(ROOM);
}
