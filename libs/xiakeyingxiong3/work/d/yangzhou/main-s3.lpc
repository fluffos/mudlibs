#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "南大街");
        set("long", @LONG

    这里是扬州城的南大街。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-e1s3",
                "south" : __DIR__"main-gs",
                "west"  : __DIR__"main-w1s3",
                "north" : __DIR__"main-s2",
        ]));

        setup();

        replace_program(ROOM);
}
