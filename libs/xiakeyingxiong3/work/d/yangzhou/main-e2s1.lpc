#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "集  市");
        set("long", @LONG

    这里是扬州城的集  市。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-e3s1",
                "south" : __DIR__"main-e2s2",
                "west"  : __DIR__"main-e1s1",
                "north" : __DIR__"main-e2",
        ]));

        set("objects", ([
                "/d/center/npc/xiaotou": 1,
    ]));
        setup();

        replace_program(ROOM);
}
