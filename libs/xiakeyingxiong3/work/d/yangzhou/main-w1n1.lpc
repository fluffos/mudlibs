#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "扬州府");
        set("long", @LONG

    这里是扬州城的扬州府。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-n1",
                "south" : __DIR__"main-w1",
                "west"  : __DIR__"main-w2n1",
                "north" : __DIR__"main-w1n2",
        ]));

       set("objects", ([
               "/obj/npc/xun-bu" : 2,
        ]));
        setup();

        replace_program(ROOM);
}
