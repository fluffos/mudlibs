#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG

    这里是扬州城的广  场。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e1",
    "south": __DIR__ "main-s1",
    "west": __DIR__ "main-w1",
    "north": __DIR__ "main-n1",
  ]));

  set("objects", ([
    // 取消慕容世家
    // "/d/murong/npc/master-mu": 1,
    "/obj/npc/xun-bu": 3,
  ]));

  setup();

  replace_program(ROOM);
}
