#include <room.h>

inherit ROOM;

void create()
{
        set("short", "青竹林");
        set("long", @LONG

    这里是侠客城的一片青竹林。微风拂着你的面孔，送来阵阵清香。
LONG
        );

        set("outdoors", "center");

        set("exits", ([
                "north" : __DIR__"bamboo_hurst_3",
                "south" : __DIR__"bamboo_hurst_1",
        ]) );                   

        set("objects", ([
                __DIR__"npc/presbyter-peng": 1,
        ]) );

        setup();
        replace_program(ROOM);
}

