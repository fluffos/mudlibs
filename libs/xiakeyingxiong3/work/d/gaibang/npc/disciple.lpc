
#include <ansi.h>

inherit NPC;

void create()
{
        set_name("丐帮弟子", ({ "beggar disciple", "disciple" }));

        set("long",@LONG
这是一位丐帮弟子。
LONG
        );

        create_family("丐帮", 20, "弟子");
        set("gender", "男性");
        set("age", 30);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 20);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 500000);
        set("SEN", 50);

        set_skill("force",     30);     set_skill("lotus-force", 30);
        set_skill("stick",     40);     set_skill("dagou-stick", 40);
        set_skill("unarmed",   40);     set_skill("xianglong-zhang", 40);
        set_skill("parry",     40);
        set_skill("move",      40);     set_skill("xiaoyao-steps", 40);
        set_skill("dodge",     40);

        map_skill("force",      "lotus-force");
        map_skill("stick",      "dagou-stick");
        map_skill("unarmed",    "xianglong-zhang");
        map_skill("parry",      "dagou-stick");
        map_skill("move",       "xiaoyao-steps");
        map_skill("dodge",      "xiaoyao-steps");

        setup();

        carry_object(__DIR__"obj/beggar-cloth")->wear();
}

