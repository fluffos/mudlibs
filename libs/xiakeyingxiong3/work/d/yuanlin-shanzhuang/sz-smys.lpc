#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "四面云山");
 	set("long", @LONG

    这里是英雄山庄的四面云山。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"	: __DIR__"sz-xy",
		"south" : __DIR__"sz-zzy",
	]));

	setup();

	replace_program(ROOM);

}

