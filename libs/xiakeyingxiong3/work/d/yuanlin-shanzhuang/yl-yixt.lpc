#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "宜西亭");
 	set("long", @LONG

    这里是侠客园林的宜西亭。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northeast" : __DIR__"yl-bydt",
		"southeast" : __DIR__"yl-ylt",
		"west"      : __DIR__"yl-yyt",
	]));

	setup();

	replace_program(ROOM);

}

