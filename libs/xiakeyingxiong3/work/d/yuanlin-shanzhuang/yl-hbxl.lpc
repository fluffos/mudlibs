#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "河边小路");
 	set("long", @LONG

    这里是侠客园林的河边小路。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north" : __DIR__"yl-yyt",
		"south" : __DIR__"yl-tyt",
	]));

	setup();

	replace_program(ROOM);

}

