#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小桥流水");
  set("long", @LONG

    这里是英雄山庄的小桥流水。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "west": __DIR__ "sz-ptcy",
    "south": __DIR__ "sz-hbsj",
    "north": "/d/player/micro",
  ]));

  setup();

  replace_program(ROOM);

}
