#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "榛子峪");
 	set("long", @LONG

    这里是英雄山庄的榛子峪。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"	: __DIR__"sz-smys",
		"south" : __DIR__"sz-glgb",
	]));

	setup();

	replace_program(ROOM);

}

