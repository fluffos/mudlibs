#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "盆景园");
  set("long", @LONG

    这里是侠客园林的盆景园。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "southeast": __DIR__ "yl-ltg",
    "northeast": __DIR__ "yl-fcg",
  ]));

  setup();

  replace_program(ROOM);

}
