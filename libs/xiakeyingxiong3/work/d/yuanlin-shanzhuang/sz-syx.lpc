#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "松云峡");
 	set("long", @LONG

    这里是英雄山庄的松云峡。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"east" 		: __DIR__"sz-zm",
		"southeast" 	: __DIR__"sz-nsjx",
		"west" 		: __DIR__"sz-xy",
	]));

	setup();

	replace_program(ROOM);

}

