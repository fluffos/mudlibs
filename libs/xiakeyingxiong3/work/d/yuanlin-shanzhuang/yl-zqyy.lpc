#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "志清意远");
 	set("long", @LONG

    这里是侠客园林的志清意远。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northeast" : __DIR__"yl-sft",
		"north"     : __DIR__"yl-dzt",
	]));

	setup();

	replace_program(ROOM);

}

