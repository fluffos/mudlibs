#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "月色江声");
 	set("long", @LONG

    这里是英雄山庄的月色江声。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"      : __DIR__"sz-xqls",
		"east"       : __DIR__"sz-jh",
		"west"       : __DIR__"sz-sh",
	]));

	setup();

	replace_program(ROOM);

}

