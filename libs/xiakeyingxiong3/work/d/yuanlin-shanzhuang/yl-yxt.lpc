#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "远香堂");
  set("long", @LONG

    这里是侠客园林的远香堂。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "yl-htcw",
    "northwest": __DIR__ "yl-yyx",
    "southwest": __DIR__ "yl-sft",
  ]));

  setup();

  replace_program(ROOM);

}
