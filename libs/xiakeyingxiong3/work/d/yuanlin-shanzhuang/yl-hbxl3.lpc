#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "湖边小路");
  set("long", @LONG
								
    这里是侠客园林的湖边小路。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-lyt",
    "south": __DIR__ "yl-dst",
  ]));

  setup();

  replace_program(ROOM);

}
