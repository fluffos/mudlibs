#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小  洲");
 	set("long", @LONG

    这里是侠客园林的小洲。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northeast" : __DIR__"yl-jsl",
		"northwest" : __DIR__"yl-dyl",
		"south"     : __DIR__"yl-bydt",
	]));

	setup();

	replace_program(ROOM);

}

