#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西  峪");
  set("long", @LONG

    这里是英雄山庄的西峪。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "sz-syx",
    "south": __DIR__ "sz-smys",
    "west": "/d/player/stones",
  ]));

  setup();

  replace_program(ROOM);

}
