#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "观莲所");
 	set("long", @LONG

    这里是英雄山庄的观莲所。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"      : __DIR__"sz-qht",
		"west"       : __DIR__"sz-ryh1",
		"south"      : __DIR__"sz-sh",
	]));

	setup();

	replace_program(ROOM);

}

