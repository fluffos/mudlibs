#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "古栎歌碑");
 	set("long", @LONG

    这里是英雄山庄的古栎歌碑。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"	    : __DIR__"sz-zzy",
		"southeast" : __DIR__"sz-cflz",
	]));

	setup();

	replace_program(ROOM);

}

