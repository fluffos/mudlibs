#include <ansi.h>

inherit NPC;

void create()
{
	set_name("黄裳", ({ "huang shang", "huang" }));

	set("long",@LONG
他就是黄裳。
LONG
	);

	set("title", "九阴始祖" );
	set("rank_info/respect", "前辈");
	set("gender", "无性" );
	set("age", 98);

	set("str", 60);		// 膂力		
	set("cps", 30);		// 定力
	set("cor", 30);		// 胆识		
	set("per", 30);		// 容貌
	set("int", 60);		// 悟性		
	set("con", 60);		// 根骨
	set("spi", 30);		// 灵性		
	set("kar", 30);		// 福缘

	set("max_atman", 0);		set("atman", 0);
	set("max_force", 5000);		set("force", 10000);	set("force_factor", 500);
	set("max_mana", 0);		set("mana", 0);

	set("combat_exp", 10000000);
	// set("SEN",10000000);

	set_skill("force",    400);	set_skill("ninemoon-force", 400);
	set_skill("sword",    300);	set_skill("pixie-sword", 300);
	set_skill("unarmed",  300);	set_skill("zhemei-shou", 300);
	set_skill("parry",    300);
	set_skill("move",     300);	set_skill("kuihua-steps", 300);
	set_skill("dodge",    300);
	set_skill("literate", 300);

	map_skill("force", 	"ninemoon-force");
	map_skill("sword", 	"pixie-sword");
	map_skill("unarmed", 	"zhemei-shou");
	map_skill("parry", 	"pixie-sword");
	map_skill("move", 	"kuihua-steps");
	map_skill("dodge", 	"kuihua-steps");

        set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
		(: perform_action :),		// (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
	}) );
        
        set("chat_chance", 20);
        set("chat_msg", ({
                (: random_move :)
        }) );

	setup();

	carry_object("/obj/misc/cloth")->wear();
	carry_object("/obj/weapon/longsword")->wield();
}

