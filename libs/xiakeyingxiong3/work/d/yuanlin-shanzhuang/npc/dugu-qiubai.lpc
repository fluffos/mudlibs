#include <ansi.h>

inherit NPC;

void create()
{
	set_name("独孤求败", ({ "dugu qiubai", "dugu" }));

	set("long",@LONG
他就是独孤求败。
LONG
	);

	set("title", "剑魔" );
	set("rank_info/respect", "前辈");
	set("gender", "男性" );
	set("age", 98);

	set("str", 60);		// 膂力		
	set("cps", 30);		// 定力
	set("cor", 30);		// 胆识		
	set("per", 30);		// 容貌
	set("int", 60);		// 悟性		
	set("con", 60);		// 根骨
	set("spi", 30);		// 灵性		
	set("kar", 30);		// 福缘

	set("max_atman", 0);		set("atman", 0);
	set("max_force", 5000);		set("force", 10000);	set("force_factor", 500);
	set("max_mana", 0);		set("mana", 0);

	set("combat_exp", 10000000);
	// set("SEN",10000000);

	set_skill("force",    300);	set_skill("taixuan-force", 300);
	set_skill("sword",    400);	set_skill("dugu-sword", 400);
	set_skill("unarmed",  300);	set_skill("xianglong-zhang", 300);
	set_skill("parry",    300);
	set_skill("move",     300);	set_skill("lingbo-steps", 300);
	set_skill("dodge",    300);
	set_skill("literate", 300);

	map_skill("force", 	"taixuan-force");
	map_skill("sword", 	"dugu-sword");
	map_skill("unarmed", 	"xianglong-zhang");
	map_skill("parry", 	"dugu-sword");
	map_skill("move", 	"lingbo-steps");
	map_skill("dodge", 	"lingbo-steps");

        set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
		(: perform_action :),		// (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
	}) );
        
        set("chat_chance", 20);
        set("chat_msg", ({
                (: random_move :)
        }) );

	setup();

	carry_object("/obj/misc/cloth")->wear();
	carry_object("/obj/weapon/longsword")->wield();
}

