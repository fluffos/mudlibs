#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "练武场");
 	set("long", @LONG
								
    这里是少林寺的练武场。
LONG
	);

	set("outdoors", "songshan");

 	set("exits", ([
		"south" : __DIR__"sl-lwc5",
		"north" : __DIR__"sl-lwc7",
		"east"  : __DIR__"sl-lh6t",
		"west"  : __DIR__"sl-br6t",
        ]));

	setup();

	replace_program(ROOM);

}

