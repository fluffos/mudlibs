#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "立雪亭");
 	set("long", @LONG
								
    这里是少林寺的立雪亭。
LONG
	);
	
	// set("outdoors", "songshan");

 	set("exits", ([
		"south" : __DIR__"sl-fzs",
		"north" : __DIR__"sl-gc5",
		"west"  : __DIR__"sl-pxd",
		"east"  : __DIR__"sl-wsd",
	]));

	setup();

	replace_program(ROOM);

}

