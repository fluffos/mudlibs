#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "观景台");
 	set("long", @LONG
								
    这里是昆仑山的观景台。
LONG
	);

	set("outdoors", "kunlunshan");

 	set("exits", ([
 		"south"     : __DIR__"main-05",
 		"northwest" : __DIR__"main-07",
 		"northeast" : __DIR__"main-06-ne1",
	]));

	setup();

	replace_program(ROOM);

}

