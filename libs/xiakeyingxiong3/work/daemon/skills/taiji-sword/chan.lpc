// chan.c 太极剑法「缠」字诀

#include <ansi.h>

inherit SSERVER;

void remove(object target,int eff);

int perform(object me, object target)
{      int eff;
	object weapon;
	string msg;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「缠」字诀只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "sword")
			return notify_fail("你使用的武器不对。\n");
	if( (int)target->query("chan"))
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
	if( (int)me->query_skill("taiji-sword", 1) < 40 )
		return notify_fail("你的太剑法极不够娴熟，不会使用「缠」字诀。\n");
	msg = HIW "$N使出太极剑法「缠」字诀，剑光化作柔丝一层层缠住$n的全身。\n"NOR;
       me->add("force",-100);
	me->start_busy(1);
       eff = (int)me->query_skill("taiji-sword",1); 
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/ 3 ) {
		msg += HIR " \n结果$n被$N的剑势一缠，只觉得动作越来越沉重！\n" NOR;
	target->start_busy( eff / 20 );
	target->set_temp("chan",1);
       target->add_temp("apply/attack",-eff); 
       target->add_temp("apply/dodge",-eff); 
       call_out("remove",eff / 20,target,eff);       
	} else {
		msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
	}
	message_vision(msg, me, target);
	return 1;
}

void remove(object target,int eff)
{    if( (int) target->query_temp("chan") )
  {    target->delete_temp("chan");
       target->add_temp("apply/attack",eff); 
       target->add_temp("apply/dodge",eff); 
  }
}
