// longzhua-gong.c - 龙爪功

inherit SKILL;
/*
学识：龙爪手（拿云式、抢珠式、捞月式、捕风式、捉影式、抚琴式、鼓瑟式、批亢式、
        俦虚式、抱残式、守缺式）共三十六式
*/
mapping *action = ({
  ([ "action": "在呼呼风声中，$N使一招「捕风式」，双手如钩如戢，插向$n的$l",
    "force": 50,
    "dodge": -10,
    "parry": -10,
    "damage": 5,
    "lvl": 0,
    "skill_name": "捕风式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N猛地向前跃出，一招「捉影式」，两腿踢出，双手抓向$n的面门",
    "force": 80,
    "dodge": -5,
    "parry": -5,
    "damage": 10,
    "lvl": 10,
    "skill_name": "捉影式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双手平伸，十指微微上下抖动，一招「抚琴式」打向$n的$l",
    "force": 100,
    "dodge": 1,
    "parry": 1,
    "damage": 20,
    "lvl": 20,
    "skill_name": "抚琴式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手上拦，右手内挥，一招「击鼓式」击向$n胸口",
    "force": 120,
    "dodge": 10,
    "parry": 10,
    "damage": 30,
    "lvl": 30,
    "skill_name": "击鼓式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右手虚握，左手掌立如山，一招「批亢式」，猛地击向$n的$l",
    "force": 140,
    "dodge": 20,
    "parry": 20,
    "damage": 40,
    "lvl": 40,
    "skill_name": "批亢式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N腾步上前，左手护胸，右手探出，一招「掏虚式」击向$n的裆部",
    "force": 160,
    "dodge": 30,
    "parry": 30,
    "damage": 50,
    "lvl": 50,
    "skill_name": "掏虚式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双手平提胸前，左手护住面门，一招「抱残式」右手推向$n的$l",
    "force": 180,
    "dodge": 40,
    "parry": 40,
    "damage": 60,
    "lvl": 60,
    "skill_name": "抱残式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」插向$n的顶门",
    "force": 200,
    "dodge": 50,
    "parry": 50,
    "damage": 70,
    "lvl": 70,
    "skill_name": "守缺式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右腿斜插$n二腿之间，一招「抢珠式」，上手取目，下手反勾$n的裆部",
    "force": 220,
    "dodge": 60,
    "parry": 60,
    "damage": 80,
    "lvl": 80,
    "skill_name": "抢珠式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一手虚指$n的剑诀，一招「夺剑式」，一手劈空抓向$n手中的长剑",
    "force": 240,
    "dodge": 70,
    "parry": 70,
    "damage": 100,
    "lvl": 100,
    "skill_name": "夺剑式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手指向$n胸前的五道大穴，右手斜指太阳穴，一招「拿云式」使$n进退两难",
    "force": 240,
    "dodge": 70,
    "parry": 70,
    "damage": 100,
    "lvl": 100,
    "skill_name": "拿云式",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N前脚着地，一手顶天成爪，一手指地，一招「追日式」劲气笼罩$n的全身",
    "force": 240,
    "dodge": 70,
    "parry": 70,
    "damage": 100,
    "lvl": 100,
    "skill_name": "追日式",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return (usage == "unarmed") || (usage == "parry"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练龙爪功必须空手。\n");
  if ((int)me->query_skill("buddhism") < (int)me->query_skill("longzhua-gong") / 2)
    return notify_fail("佛门每种绝技都要有慈悲佛法为之化解，你好象学得不够呀！\n");
  level = me->query_skill("longzhua-gong");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练龙爪功，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("longzhua-gong", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"]) return action[random(i)];
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练龙爪功必须空手。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练龙爪功。\n");
  me->receive_damage("kee", 35);
  write("你按著所学练了一遍龙爪功。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "longzhua-gong/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) {
  if (n < 100) return 120;
  else return 100;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 3; }

int practice_factor() { return 110; }
int practice_bonus() { return 1; }
