// ghostbat-steps.c - 鬼蝠身法

inherit SKILL;

string *dodge_msg = ({
        "忽见$n的身影象鬼一样，向旁边飘然纵出。\n",
        "却见$n象蝙蝠一样，在空中荡了起来，刚好避开了$N的招数。\n",
        "$n双手一伸，象翅膀一样张开，身影象鬼一样在半空中游荡。\n",
        "$n一招「群魔乱舞」，转眼间，四面八方飘动着无数个$n的身影。\n",
        "但是$n身形飘忽，一招「厉鬼缠身」，轻轻一纵，早已避开。\n",
        "却见$n足不点地，一招「百鬼夜行」，往旁窜开数尺，躲了开去。\n",
        "$n一招「鬼影幢幢」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
        "只见$n一招「秋坟鬼唱」，身体向上笔直纵起丈余。\n",
});

int valid_enable(string usage) { return (usage=="dodge" || usage=="move" ) ; }

int valid_learn(object me)
{
        int level;

        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
        level = me->query_skill("ghostbat-steps");      // 这里的负神不用要求太高！！
        if ( - level * level * level / 20 < me->query("SEN"))
                return notify_fail("修练鬼蝠神功，要心狠手辣，奸恶歹毒。你好象做得不够呀！\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        int i;

        i = (int)me->query_skill("ghostbat-steps");
        if( (int)me->query("kee") < 35 )
                return notify_fail("你的气太少了，无法继续练习鬼蝠神功。\n");
        me->receive_damage("kee", 35);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"ghostbat-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) { 
   if (n<100) return 100;
   else return 80;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 1; }

int practice_factor() { return 90; }
int practice_bonus()  { return 1; }
