// force.c - 基本内功

#include <ansi.h>

inherit SKILL;

int valid_learn(object me) { return 1; }

string exert_function_file(string func)
{
        return __DIR__"force/" + func;
}

void skill_improved(object me)
{
        int s;

        s = me->query_skill("force", 1);
        if( s % 10 == 0 && (int)me->query("con") < 50 
        &&      (s / 10) > (int)me->query("con_increase") ) {
                tell_object(me, HIW "由於你的内功修炼有成，你的体质改善了。\n" NOR);
                me->add("con", 1);
                me->add("con_increase",1);
        }
}

int enable_factor() { return 100; }
