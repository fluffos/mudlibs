// xiaoyao-steps.c - 逍遥游

inherit SKILL;

string *dodge_msg = ({
        "只见$n身随意转，施展逍遥游步法，一扭身已飘到$N背后。\n",
        "但是$n施展逍遥游步法，身形飘忽，轻轻一纵，避开这一击。\n",
        "只见$n施展逍遥游步法，轻轻松松地闪过。\n",
        "$n施展逍遥游步法，轻轻巧巧地躲开了$N的攻击。\n",
        "但见$n身影微动，施展逍遥游步法轻轻闪过。\n",
        "$n双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
        "$n施展逍遥游步法，向一旁飘然纵出，轻轻着地。\n",
});

int valid_enable(string usage) { return (usage=="dodge" || usage=="move") ; }

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 80 )
                return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        int i;

        i = (int)me->query_skill("xiaoyao-steps");
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的气太少了，无法继续练习逍遥游。\n");
        me->receive_damage("kee", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"xiaoyao-steps/" + action;
}

int enable_factor() { return 125; }

int learn_factor(int n) { 
   if (n<100) return 120;
   else return 100;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 3; }

int practice_factor() { return 110; }
int practice_bonus()  { return 1; }
