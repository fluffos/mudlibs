// taixuan-force.c - 太玄神功

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me) 
{ 
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的基本内功火候不够，无法研习高深的内功。\n");
        return 1; 
}

int practice_skill(object me)
{
        string s;               
        // 做一个函数：this_skill() 如下法& this_skill_name()取chinese.o的库内容
        sscanf(__FILE__, __DIR__"%s.lpc", s);
        return notify_fail("太玄神功"+s+"只能学习（learn），或是从运用（exert）中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"taixuan-force/" + func;
}
 
int enable_factor() { return 500; }

int learn_factor(int n) { 
   if (n<100) return 100;
   else return 80;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 1; }

