// unarmed.c - 基本拳脚

#include <ansi.h>

inherit SKILL;

string perform_action_file(string action) {
  return "/d/unarmed/" + action;
}

void skill_improved(object me) {
  int s;

  s = me->query_skill("unarmed", 1);
  if (s % 10 == 0 && (int)me->query("str") < 40
    && (s / 10) > (int)me->query("str_increase")) {
    tell_object(me, HIW "由於你勤练武艺，你的膂力提高了。\n" NOR);
    me->add("str", 1);
    me->add("str_increase", 1);
  }
}
