// refresh.c

inherit SSERVER;

int exert(object me, object target) {
  int total;

  if (target != me) return notify_fail("你只能用内功恢复自己的心神。\n");

  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够。\n");

  // 修改：自动加满自己的心神
  total = ((int)me->query("eff_sen") - (int)me->query("sen")) * 20 / (10 + (int)me->query_skill("force") / 3);
  if ((int)me->query("force") >= total) {
    me->set("sen", (int)me->query("eff_sen"));
    me->add("force", -total);
  } else {
    me->receive_heal("sen", (10 + (int)me->query_skill("force") / 3)
      * (int)me->query("force") / 20);
    me->set("force", 0);
  }

  message_vision("$N略一凝神，吸了口气，精神看起来清醒多了。\n", me);

  if (me->is_fighting()) me->start_busy(1);

  return 1;
}
