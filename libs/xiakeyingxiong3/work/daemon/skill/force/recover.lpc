// recover.c

inherit SSERVER;

int exert(object me, object target)
{
	int total;

        if( target != me ) return notify_fail("你只能用内功调匀自己的气息。\n");

        if( (int)me->query("force") < 20 )
                return notify_fail("你的内力不够。\n");

	// 修改：自动加满自己的气息
	total = ( (int)me->query("eff_kee") - (int)me->query("kee") ) * 20 /
		( 10 + (int)me->query_skill("force") / 3 );
	if( (int)me->query("force") >= total ) {
	        me->set("kee", (int)me->query("eff_kee") );
	        me->add("force", - total);
	}
	else {
	        me->receive_heal("kee", (10 + (int)me->query_skill("force") / 3 ) 
			* (int)me->query("force") / 20 );
		me->set("force", 0);
	}

        message_vision("$N深深吸了几口气，脸色看起来好多了。\n", me);

        if( me->is_fighting() ) me->start_busy(1);

        return 1;
}
 
