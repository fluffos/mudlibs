// lieyan-steps.c - 烈焰身法

inherit SKILL;

string *dodge_msg = ({
        "$n施展烈焰身法，身体如陀螺般急转，看得$N眼都花了。\n",
        "$n施展烈焰身法，全身化为一道白影，急速绕着$N打了几转。\n",
        "$N只觉得眼前一花，只觉得四面都是$n的身影。\n",
        "可是$n施展烈焰身法，身子轻轻飘了开去。\n",
        "只见$n身随意转，象火焰一般飘然不定，一扭身已落到$N背后。\n",
        "但是$n施展烈焰身法，身形飘忽，轻轻一纵，避开这一击。\n",
        "$n施展烈焰身法，轻轻巧巧地躲开了$N的攻击。\n",
        "但见$n身影微动，施展烈焰身法轻轻闪过。\n",
});

int valid_enable(string usage) { return (usage=="dodge" || usage=="move") ; }

int valid_learn(object me)
{
        int level;

        if( (int)me->query("max_force") < 80 )
                return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
        level = me->query_skill("lieyan-steps");        // 这里的负神不用要求太高！！
        if ( - level * level * level / 20 < me->query("SEN"))
                return notify_fail("修练烈焰身法，要心狠手辣，奸恶歹毒。你好象做得不够呀！\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        int i;

        i = (int)me->query_skill("lieyan-steps");
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的气太少了，无法继续练习烈焰身法。\n");
        me->receive_damage("kee", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"lieyan-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) { 
    if (n<100) return 130; 
    else return 100;
}
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 3; }

int practice_factor(int n) { 
    if (n<100) return 135; 
    else return 105;
}
int practice_bonus()  { return 1; }
