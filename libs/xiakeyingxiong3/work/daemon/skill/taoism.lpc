// taoism.c - 道家学说

#include <ansi.h>

inherit SKILL;

void create() { seteuid(getuid()); }

// string type() { return "knowledge"; }

int valid_learn(object me) {
  int s;

  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀气太重，无法修炼道家学说。\n");

  s = me->query_skill("taoism", 1);
  if (s % 10 == 0 && (int)me->query("cps") < 50
    && (s / 20) > (int)me->query("cps_increase")) {
    tell_object(me, HIW "由於你的勤学苦读，你的定力提高了。\n" NOR);
    me->add("cps", 1);
    me->add("cps_increase", 1);
  }

  return 1;
}

int enable_factor() { return 100; }
