#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, jing, qi, shen;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［黯然销魂掌］只能对战斗中的对手使用。\n");
  jing = (int)me->query("max_gin") / 20;
  qi = (int)me->query("max_kee") / 20;
  shen = (int)me->query("max_sen") / 20;
  if (me->query("gin") <= jing || me->query("kee") <= qi || me->query("sen") <= shen)
    return notify_fail("你的体力不足以支持你使出［六脉神剑］！\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("xiaohun-zhang", 1);
  if (extra <= 80) return notify_fail("你的黯然销魂掌还不够熟练！\n");
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  message_vision(HIC "只见$N小腹肌肉颤动，同时胸口向后一收，突地弹出，一招“心惊肉跳”撞向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "继而$N手掌斜下，呼地一招“妃人忧天”掌向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "俄而$N突然手足齐动，左掌右袖，双足头锤，胸背腰腹尽有招数发出，使出“无中生有”一起功向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "接着$N左手云袖飘动，宛若流水，右掌却沉滞之极，便似带着几千斤的泥沙一般，一招“拖泥带水”缓缓地击向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "然后$N身体突然头下脚上，倒过身子拍出一掌“倒行逆施”，击向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "最后$N大喝一声：“鹿死谁手！”左一回右一旋，已转到对手后面，左手指节成虎爪之形，意传真气，攻向$n！" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->start_busy(5);
  me->add("gin", -jing);
  me->add("kee", -qi);
  me->add("sen", -shen);
  return 1;
}
