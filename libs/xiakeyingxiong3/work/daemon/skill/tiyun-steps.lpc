// tiyun-steps.c - 梯云纵

inherit SKILL;

string *dodge_msg = ({
  "$n一招「分身化影」，转眼间，四面八方飘动着无数个$n的身影。\n",
  "只见$n一招「白鹤冲天」，双足互点，身体向上笔直纵起丈余。\n",
  "$n使出「大鹏展翅」，向旁边飘然纵出，轻轻落地，如叶之堕，黯然无声。\n",
  "$n左足一点，一个「鸽子翻身」向后纵开数丈，避开$N的凌厉攻势。\n",
  "$n一个转身，一招「云雾萦绕」，身子轻轻飘了开去。\n",
  "$n身影一幌，一招「气冲霄汉」，身形如影随形，轻轻闪到一旁。\n",
  "只见$n一招「豪气千云」使出，轻轻落地，十分潇洒！\n",
  "$n一招「移步换形」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  level = me->query_skill("tiyun-steps");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练梯云纵轻功，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("tiyun-steps");
  if ((int)me->query("kee") < 35)
    return notify_fail("你的气太少了，无法继续练习梯云纵。\n");
  me->receive_damage("kee", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tiyun-steps/" + action;
}

int enable_factor() { return 120; }

int learn_factor(int n) {
  if (n > 75) return 105;
  else return 75;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 1; }

int practice_factor() { return 90; }
int practice_bonus() { return 1; }
