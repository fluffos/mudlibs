// daoism.c - 道家学说

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) 
{
        if( (int)me->query("bellicosity") > 100 )
                return notify_fail("你的杀气太重，无法修炼道家学说。\n");
        return 1;
}

int enable_factor() { return 100; }
