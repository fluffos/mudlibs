// dodge.c - 躲闪之术

inherit SKILL;

string *dodge_msg = ({
        "结果和$p$l偏了一点。\n",
        "但是和$p$l偏了几寸。\n",
        "结果被$p机灵地闪开了。\n",
        "但是被$p机灵地躲开了。\n",
        "结果$n将身子一侧，闪了开去。\n",
        "但是$n身子微微一侧，闪了开去。\n",
        "结果被$p及时闪开。\n",
        "但是被$p及时避开。\n",
        "结果$n早有准备，不慌不忙的闪开。\n",
        "但是$n已有准备，不慌不忙的躲开。\n",
});

string query_dodge_msg()
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int enable_factor() { return 100; }
