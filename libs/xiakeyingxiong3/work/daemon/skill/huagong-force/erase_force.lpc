// erase_force.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  int skill, force, diff = 0;
  string msg;

  if (target == me)
    return notify_fail("你只能化解别人的内力。\n");

  if (!target->is_character() || !living(target))
    return notify_fail("从" + target->query("name") + "上不能化解内力。\n");

  if (!target->is_fighting(me))
    return notify_fail(target->name() + "没有和你交手，你无法化解他的内力！\n");

  if (me->query_temp("weapon")) diff += 10;
  if (target->query_temp("weapon")) diff += 10;
  if (me->query_skill("force") < target->query_skill("force")) diff += 20;

  force = (int)target->query("force") / 4;
  diff += force / 4;
  if (me->query("kee") < force / 4)
    return notify_fail("你的气不够了，不能再化解内力了。\n");

  me->receive_damage("kee", force / 4);
  me->start_busy(2);

  skill = me->query_skill("huagong-force", 1);

  msg = CYN "$N催动体内化功大法真气，顿时一股强大的吸力传向$n体内。\n" NOR;


  if (random(skill) > diff) {
    msg += HIM "$n只觉得被$N牢牢吸住，体内真气源源不断地泄向体外......\n" NOR;
    target->add("force", -force);
    // me->add("force", force * 2 / 3);
    if (me->query("force") > 2 * me->query("max_force")) {
      // me->add("max_force", 1);
      // me->set("force", me->query("max_force") );
    }

    message_vision(msg, me, target);
    return 1;
  }

  if ((int)me->query("force") * 2 < target->query("force")) {
    msg += HIB "$N突然只觉得不能控制内息，体内真气竟源源不断泄向体外......\n" NOR;
    me->add("force", -(int)me->query("force") / 4);
    // target->add("force", (int)me->query("force") / 6);
    // if(target->query("force") > 2 * target->query("max_force") ) {
    //         target->add("max_force", 1);
    //         target->set("force", target->query("max_force") );
    // }

    message_vision(msg, me, target);
    return 1;
  }

  msg += CYN "$N因为化功大法修练不够成熟而失败了。\n" NOR;

  message_vision(msg, me, target);

  return 1;
}
