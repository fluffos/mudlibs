int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_combine(string combo) { return combo=="taiji-quan"; }

int valid_learn(object me)
{
        object ob;
        int level;

        if ((int)me->query("max_force") < 100)
                return notify_fail("你的内力不够。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练太极剑法。\n");
        level= me->query_skill("taiji-sword");
        if (level * level * level/10 > me->query("SEN") )
                return notify_fail("修练太极剑法，要除暴安良，行侠仗义。你好象做得不够呀！\n");
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("taiji-sword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level >= action[i-1]["lvl"]) return action[random(i)];
}

int practice_skill(object me)
{

        if( (int)me->query("kee") < 40
        ||      (int)me->query("force") < 3 )
                return notify_fail("你的内力或气不够，没有办法练习太极剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍太极剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"taiji-sword/" + action;
}

int enable_factor() { return 165; }

int learn_factor(int n) { 
   if (n<75) return 65;
   else return 120;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 1; }

int practice_factor() { return 90; }
int practice_bonus()  { return 1; }
