// qiankun-steps.c - 乾坤步法

inherit SKILL;

string *dodge_msg = ({
        "只见$n使出一招「天字诀」，轻轻巧巧地避了开去。\n",
        "可是$n使一招「地字诀」，身子轻轻飘了开去。\n",
        "只见$n使出一招「人字诀」，向一旁飘然纵出，轻轻着地。\n",
        "但是$n一招「金字诀」使出，早已绕到$N身後。\n",
        "$n一招「木字诀」，转眼间，四面八方飘动着无数个$n的身影。\n",
        "但见$n身影微动，已经藉一招「水字诀」轻轻闪过。\n",
        "$n足下一点，一招「火字诀」，腾空而起，避了开去。\n",
        "$n一招「土字诀」，双脚点地，全身化为一道白影。\n",
});

int valid_enable(string usage) { return (usage=="dodge" || usage=="move") ; }

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        int i;

        i = (int)me->query_skill("qiankun-steps");
        if( (int)me->query("kee") < 35 )
                return notify_fail("你的气太少了，无法继续练习乾坤步法。\n");
        me->receive_damage("kee", 35);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"quankun-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) { 
   if (n<100) return 110;
   else return 90;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 2; }

int practice_factor() { return 100; }
int practice_bonus()  { return 1; }
