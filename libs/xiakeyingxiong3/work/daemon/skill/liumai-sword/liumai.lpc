#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        int extra, jing, qi, shen;
        object weapon;
        extra = me->query_skill("liumai-sword",1);
        if ( extra < 100) return notify_fail("你的六脉神剑还不够纯熟！\n");
        jing = (int)me->query("max_gin") / 20;
        qi = (int)me->query("max_kee") / 20;
        shen = (int)me->query("max_sen") / 20;
        if ( me->query("gin") <= jing || me->query("kee") <= qi || me->query("sen") <= shen )
        return notify_fail("你的体力不足以支持你使出［六脉神剑］！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［六脉神剑］只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        message_vision(HIW "$N抱元归一，低喝一声：“六-脉-神-剑！”双手齐扬，六缕剑气激射！\n\n" NOR, me, target);
        message_vision(HIW "第一剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        message_vision(HIW "第二剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        message_vision(HIW "第三剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        message_vision(HIW "第四剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        message_vision(HIW "第五剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        message_vision(HIW "第六剑！" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        me->start_busy(4);
        me->add("gin", -jing);
        me->add("kee", -qi);
        me->add("sen", -shen);
        return 1;
}
