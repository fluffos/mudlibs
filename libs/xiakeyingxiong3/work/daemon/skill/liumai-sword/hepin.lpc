#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        int extra, forces;
        object weapon;
        extra = me->query_skill("liumai-sword",1);
        if ( extra < 40) return notify_fail("你的六脉神剑还不够纯熟！\n");
        forces = (int)me->query("force_factor") / 3 * 2;
        if ( me->query("force") < forces ) return notify_fail("你的内力不足！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［剑掌合拼，掌剑同行］只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        message_vision(HIW "\n$N回了口气，立刻剑掌交合，一前一后地逼向$n，$n不敢怠慢，马上招架住$N的头一招！\n" NOR, me, target);
        target->start_busy(3);
        message_vision(HIW "\n只见$N面带微笑，左掌已击向了$n的肚腹！\n" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        me->start_busy(2);
        me->add("force", -forces);
        return 1;
}
