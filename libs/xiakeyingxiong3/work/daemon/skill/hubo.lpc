// hobo.c - 双手互搏

inherit SKILL;

string type() { return "martial"; }

int valid_learn(object me) {
  if (me->query("spi") < 28 || me->query("kar") < 28
    || (me->query("int") < 45 && me->query("int") > 15))
    return notify_fail("你的资质不适合学习双手互搏之术。\n");
  return 1;
}

int enable_factor() { return 150; }

int learn_factor(int n) {
  if (n < 100) return 110;
  else return 80;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 1; }

int practice_factor() { return 90; }
int practice_bonus() { return 1; }
