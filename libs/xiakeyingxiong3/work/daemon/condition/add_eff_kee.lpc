// add_eff_kee.c

#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if ((int)me->query("eff_kee") < (int)me->query("max_kee")) {
    me->receive_curing("kee", 15);
    tell_object(me, WHT "由于服用了灵药，你的体力有所恢复！\n" NOR);
  }

  me->apply_condition("add_eff_kee", duration - 1);
  if (!duration) return 0;

  return CND_CONTINUE;
}
