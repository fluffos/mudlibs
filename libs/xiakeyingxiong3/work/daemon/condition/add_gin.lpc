// add_gin.c

#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	if( (int)me->query("gin") < (int)me->query("eff_gin") ) {
		me->receive_heal("gin", 30);
		tell_object(me, WHT "由于服用了灵药，你的精力有所恢复！\n" NOR );
	}

	me->apply_condition("add_gin", duration - 1);
	if( !duration ) return 0;

	return CND_CONTINUE;
}
