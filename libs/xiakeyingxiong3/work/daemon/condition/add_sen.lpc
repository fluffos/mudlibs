// add_sen.c

#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	if( (int)me->query("sen") < (int)me->query("eff_sen") ) {
		me->receive_heal("sen", 30);
		tell_object(me, WHT "由于服用了灵药，你的精神有所恢复！\n" NOR );
	}

	me->apply_condition("add_sen", duration - 1);
	if( !duration ) return 0;

	return CND_CONTINUE;
}
