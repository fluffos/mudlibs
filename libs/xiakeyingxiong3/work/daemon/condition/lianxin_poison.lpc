// lianxin_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  me->receive_wound("gin", 20);
  me->receive_wound("kee", 30);
  me->receive_wound("sen", 15);

  me->apply_condition("lianxin_poison", duration - 1);
  tell_object(me, RED "你中的练心火毒发作了！\n" NOR);
  me->add("poison", 1);

  if (duration < 1) return 0;
  return 1;
}
