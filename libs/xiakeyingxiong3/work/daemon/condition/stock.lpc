// stock.c

#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  mapping stock;
  int i, base, old, new, tmp;
  float inc, temp, t, cycle, phase;
  string *name;

  stock = me->query("stock_base");
  name = keys(stock);
  if (!mapp(stock) || !sizeof(stock)) return 0;

  for (i = 0; i < sizeof(name); i++) {
    base = (int)me->query("stock_base/" + name[i]);
    old = (int)me->query("stock_price1/" + name[i]);
    tmp = (int)me->query("stock_phase/" + name[i]);
    phase = tmp;
    phase /= 100;
    tmp = (int)me->query("stock_cycle/" + name[i]);
    cycle = tmp;
    cycle /= 100;
    t = duration;
    t = t / cycle + phase;

    inc = base;
    inc /= 100;
    inc = inc * sin(t);

    temp = base;
    temp /= 100;
    temp += inc;
    temp *= 100;
    new = (int)temp;
    if (new <= (base / 20)) new = base / 20;
    me->set("stock_price2/" + name[i], old);
    me->set("stock_price1/" + name[i], new);
  }

  duration--;
  if (!duration) me->apply_condition("stock", 500);
  else me->apply_condition("stock", duration);

  return CND_CONTINUE;
}
