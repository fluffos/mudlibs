// cold.c

#include <ansi.h>

int update_condition(object me, int duration) {
  object where;
  where = environment(me);
  if ((string)where->query("short") != "冰川") {
    me->apply_condition("cold", 0);
    return 0;
  }
  me->receive_damage("kee", 30);
  tell_object(me, "你在寒风中打了个冷颤！\n");
  return 1;
}
