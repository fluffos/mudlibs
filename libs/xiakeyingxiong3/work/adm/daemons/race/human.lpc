#define BASE_WEIGHT 80000               // 一个正常人的体重至少有40公斤

inherit F_DBASE;

mapping *combat_action = ({
  ([ "action": "$N挥拳攻击$n的$l",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N对准$n的$l用力挥出一拳",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N提起拳头往$n的$l捶去",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N往$n的$l狠狠地踢了一脚",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N往$n的$l一抓",
    "damage_type": "抓伤",
  ]),
});

// 设定人类的基本资料及属性
void create() {
  seteuid(getuid());
  set("unit", "位");
  set("gender", "男性");
  set("can_speak", 1);
  set("attitude", "peaceful");
  set("limbs", ({
    "头部", "后脑", "左眼", "右眼", "眉心", "左颊", "右颊",
    "下巴", "颈部", "后颈", "前胸", "后背", "胸口", "后心",
    "左肩", "右肩", "左臂", "右臂", "左手", "右手", "左肋",
    "右肋", "腰间", "后腰", "小腹", "臀部", "左胯", "右胯",
    "左腿", "右腿", "左脚", "右脚",
  }));
}

// 设定人类的各项资料
void setup_human(object ob) {
  mapping my;
  int i;

  my = ob->query_entire_dbase();

  ob->set("default_actions", (: call_other, __FILE__, "query_action" :));

  if (undefinedp(my["age"])) my["age"] = random(30) + 15;

  if (undefinedp(my["str"])) my["str"] = random(21) + 10;
  if (undefinedp(my["cor"])) my["cor"] = random(21) + 10;
  if (undefinedp(my["int"])) my["int"] = random(21) + 10;
  if (undefinedp(my["spi"])) my["spi"] = random(21) + 10;
  if (undefinedp(my["cps"])) my["cps"] = random(21) + 10;
  if (undefinedp(my["per"])) my["per"] = random(21) + 10;
  if (undefinedp(my["con"])) my["con"] = random(21) + 10;
  if (undefinedp(my["kar"])) my["kar"] = random(21) + 10;

  /*
        if( ob->query("bank_money") >= 100000000 && ob->query_age() >= 20 )
                ob->set("bank_money", 100000000);

        if( ob->query("bank_money") >= 50000000 && ob->query_age() < 20 )
                ob->set("bank_money", 50000000);

        if( ob->query("bank_money") >= 10000000 && ob->query("combat_exp") < 20000 )
                ob->set("bank_money", 10000000);

        if( ob->query("bank_money") >= 1000000 && ob->query("combat_exp") < 10000 )
                ob->set("bank_money", 1000000);
*/
  if (!ob->query("cloth/name")) ob->set("cloth/name", my["name"] + "的布衣");
  if (!ob->query("cloth/armor")) ob->set("cloth/armor", 1);
  if (!ob->query("weapon/name")) ob->set("weapon/name", my["name"] + "的武器");
  if (!ob->query("weapon/damage")) ob->set("weapon/damage", 1);
  if (!ob->query("animal/name")) ob->set("animal/name", my["name"] + "的坐骑");
  if (!ob->query("animal/max_life")) ob->set("animal/max_life", 5);
  if (!ob->query("animal/life")) ob->set("animal/life", ob->query_age() > 14 ? 0 : 5);

  // Micro: 精：精与灵性有很大关系；道家学说及大乘佛法可以使人精不减
  if (userp(ob) || undefinedp(my["max_gin"])) {
    if (ob->query_age() <= 14) my["max_gin"] = 100 + my["spi"] * 5;
    else if (ob->query_age() <= 20) my["max_gin"] = 100 + (ob->query_age() - 14) * 20 + my["spi"] * 5;
    else if (ob->query_age() <= 30
      || (int)ob->query_skill("taoism", 1) >= 150
      || (int)ob->query_skill("buddhism", 1) >= 150)
      my["max_gin"] = 220 + my["spi"] * 5;
    else if (ob->query_age() <= 60) my["max_gin"] = 220 - (ob->query_age() - 30) * 5 + my["spi"] * 5;
    else my["max_gin"] = 70 + my["spi"] * 5;
    if (my["max_atman"] > 0) my["max_gin"] += my["max_atman"] / 4;
  }
  // Micro: 气：气与根骨有很大的关系
  if (userp(ob) || undefinedp(my["max_kee"])) {
    if (ob->query_age() <= 14) my["max_kee"] = 100 + my["con"] * 5;
    else if (ob->query_age() <= 20) my["max_kee"] = 100 + (ob->query_age() - 14) * 20 + my["con"] * 5;
    else my["max_kee"] = 220 + my["con"] * 5;

    // Micro: 道家练气：３０岁前补气，３０岁后长气
    if ((i = (int)ob->query_skill("taoism", 1)) >= 60) {
      i = i / 2;
      if (ob->query_age() <= 30) i -= ob->query_age();
      else i -= 30;
      if (i > 0) my["max_kee"] += (int)(i * ob->query_skill("taiji-force", 1) / 10);
    }

    if (my["max_force"] > 0) my["max_kee"] += my["max_force"] / 4;
  }
  // Micro: 神：神与灵性有很大关系；道家学说及大乘佛法可以使人神不减
  if (userp(ob) || undefinedp(my["max_sen"])) {
    if (ob->query_age() <= 14) my["max_sen"] = 100 + my["spi"] * 5;
    else if (ob->query_age() <= 20) my["max_sen"] = 100 + (ob->query_age() - 14) * 20 + my["spi"] * 5;
    else if (ob->query_age() <= 30
      || (int)ob->query_skill("taoism", 1) >= 150
      || (int)ob->query_skill("buddhism", 1) >= 150)
      my["max_sen"] = 220 + my["spi"] * 5;
    else if (ob->query_age() <= 60) my["max_sen"] = 220 - (ob->query_age() - 30) * 5 + my["spi"] * 5;
    else my["max_sen"] = 70 + my["spi"] * 5;
    if (my["max_mana"] > 0) my["max_sen"] += my["max_mana"] / 4;
  }

  if (my["eff_gin"] > my["max_gin"]) my["eff_gin"] = my["max_gin"];
  if (my["eff_kee"] > my["max_kee"]) my["eff_kee"] = my["max_kee"];
  if (my["eff_sen"] > my["max_sen"]) my["eff_sen"] = my["max_sen"];

  ob->set_default_object(__FILE__);
  if (!ob->query_weight()) ob->set_weight(BASE_WEIGHT + (my["str"] - 10) * 200);
}

// 传回动作词
mapping query_action() {
  return combat_action[random(sizeof(combat_action))];
}
