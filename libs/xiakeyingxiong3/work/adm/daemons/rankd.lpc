#include <ansi.h>

// 传回玩家的普通 Rank
string query_rank(object ob)
{
        int sen;

        if( ob->is_ghost() ) return HIB "【 鬼  魂 】" NOR;
	if( ob->query("id") == "silverwind" ) return "【 平  民 】" ;

        if( (int) ob->query("title_race") == -1 ) return HIR "【天下第一】" NOR;
        if( (int) ob->query("title_race") == -2 ) return HIR "【天下第二】" NOR;
        if( (int) ob->query("title_race") == -3 ) return HIR "【天下第三】" NOR;

        sen = (int)ob->query("SEN");

        switch(ob->query("gender")) {

        case "女性":
                switch(wizhood(ob)) {
                        // 99-02-08: 取消一些高等级巫师的名称显示, 以下几处同。
                        // case "(admin)":         return HIY "【 大  帝 】" NOR;
                        // case "(arch)":          return HIW "【 大  圣 】" NOR;
                        // case "(wizard)":        return WHT "【 神  仙 】" NOR;
                        // case "(apprentice)":    return WHT "【 小天仙 】" NOR;
                        // case "(immortal)":      return YEL "【 仙  人 】" NOR;
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(hufa)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(monitor)":         return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                                if( ((int)ob->query("PKS") > 100) 
                                &&      ((int)ob->query("PKS") > (int)ob->query("MKS") / 2 ) )
                                        return HIR "【 杀人狂 】" NOR;
                                if( (int)ob->query("thief") > 10 ) 
                                        return HIR "【 惯  窃 】" NOR;
                                if( sen >= 100 && sen <1000 )           return GRN"【 小侠女 】"NOR;
                                if( sen >= 1000 && sen <10000 )         return GRN"【 少侠女 】"NOR;
                                if( sen >= 10000 && sen <50000 )        return HIG"【 侠  女 】"NOR;
                                if( sen >= 50000 && sen <100000 )       return HIG"【 大  侠 】"NOR;
                                if( sen >= 100000 && sen <200000 )      return MAG"【旷世大侠】"NOR;
                                if( sen >= 200000 && sen <500000 )      return MAG"【旷世奇侠】"NOR;
                                if( sen >= 500000 && sen <1000000 )     return HIM"【一代宗师】"NOR;
                                if( sen >= 1000000 && sen < 2000000 )   return HIM"【武林天骄】"NOR;
                                if( sen >= 2000000 )                    return HIM"【笑傲江湖】"NOR;
                                if( sen > -1000 && sen <= -100 )        return CYN"【 小魔女 】"NOR;
                                if( sen > -10000 && sen <= -1000 )      return CYN"【 少魔女 】"NOR;
                                if( sen > -50000 && sen <= -10000 )     return HIC"【 魔  女 】"NOR;
                                if( sen > -100000 && sen <= -50000 )    return HIC"【 妖  女 】"NOR;
                                if( sen > -200000 && sen <= -100000 )   return RED"【 妖  后 】"NOR;
                                if( sen > -500000 && sen <= -200000 )   return RED"【穷凶极恶】"NOR;
                                if( sen > -1000000 && sen <= -500000 )  return HIR"【凶神恶煞】"NOR;
                                if( sen > -1000000 && sen <= -2000000)  return HIR"【无恶不作】"NOR;
                                if( sen <= -2000000 )                   return HIR"【恶贯满盈】"NOR;
                }
        default:
                switch(wizhood(ob)) {
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                                if( ((int)ob->query("PKS") > 100) 
                                &&      ((int)ob->query("PKS") > (int)ob->query("MKS") / 2 ) )
                                        return HIR "【 杀人狂 】" NOR;
                                if( (int)ob->query("thief") > 10 ) 
                                        return HIR "【 惯  窃 】" NOR;
                                if( sen >= 100 && sen <1000 )           return GRN"【 小  侠 】"NOR;
                                if( sen >= 1000 && sen <10000 )         return GRN"【 少  侠 】"NOR;
                                if( sen >= 10000 && sen <50000 )        return HIG"【 侠  客 】"NOR;
                                if( sen >= 50000 && sen <100000 )       return HIG"【 大  侠 】"NOR;
                                if( sen >= 100000 && sen <200000 )      return MAG"【旷世大侠】"NOR;
                                if( sen >= 200000 && sen <500000 )      return MAG"【旷世奇侠】"NOR;
                                if( sen >= 500000 && sen <1000000 )     return HIM"【一代宗师】"NOR;
                                if( sen >= 1000000 && sen < 2000000 )   return HIM"【武林天骄】"NOR;
                                if( sen >= 2000000 )                    return HIM"【笑傲江湖】"NOR;
                                if( sen > -1000 && sen <= -100 )        return CYN"【 小魔头 】"NOR;
                                if( sen > -10000 && sen <= -1000 )      return CYN"【 少魔头 】"NOR;
                                if( sen > -50000 && sen <= -10000 )     return HIC"【 魔  头 】"NOR;
                                if( sen > -100000 && sen <= -50000 )    return HIC"【 大  魔 】"NOR;
                                if( sen > -200000 && sen <= -100000 )   return RED"【 魔  君 】"NOR;
                                if( sen > -500000 && sen <= -200000 )   return RED"【穷凶极恶】"NOR;
                                if( sen > -1000000 && sen <= -500000 )  return HIR"【凶神恶煞】"NOR;
                                if( sen > -1000000 && sen <= -2000000)  return HIR"【无恶不作】"NOR;
                                if( sen <= -2000000 )                   return HIR"【恶贯满盈】"NOR;
                }
        }
        return "【 平  民 】";
}

// 传回玩家的国家 Rank
string query_country_rank(object ob)
{
        string country, rank;

        if( ob->is_ghost() ) return HIB "【 鬼  魂 】" NOR;

        switch(ob->query("gender")) {

        case "女性":
                switch(wizhood(ob)) {
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                }
        default:
                switch(wizhood(ob)) {
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                }
        }

        country = ob->query("marks/国家");
        if (country != 0) {
                rank = ob->query( "marks/" + country );
                return HIG "【" + country + rank + "】" NOR;
        }

        return "【 平  民 】";
}

// 传回玩家的职业 Rank
string query_class_rank(object ob)
{
        if( ob->is_ghost() ) return HIB "【 鬼  魂 】" NOR;

        switch(ob->query("gender")) {
        case "女性":
                switch(wizhood(ob)) {
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                                switch(ob->query("class")) {
                                        case "bonze":           return "【  尼  姑  】";
                                        case "taoist":          return "【  女道士  】";
                                        case "ghost":           return "【  幽  灵  】";
                                        case "bandit":          return "【  女飞贼  】";
                                        case "dancer":          return "【  舞  仙  】";
                                        case "legend":          return "【  侠  女  】";
                                        case "scholar":         return "【  才  女  】";
                                        case "officer":         return "【  女  官  】";
                                        case "fighter":         return "【  女武者  】";
                                        case "traveller" :      return "【  浪  子  】";
                                        case "lishi" :          return "【  女武者  】";
                                        case "swordsman":       return "【  女剑士  】";
                                        case "assassin":        return "【  杀  士  】";
                                        case "xiejiao":         return "【  邪  女  】";
                                        case "shaman":          return "【  巫  医  】";
                                        case "lama":            return "【  藏  尼  】";
                                        case "yinshi":          return "【  隐  士  】";
                                        case "beggar":          return "【  叫化子  】";
                                        default:                return "【  平  民  】";
                        }
                }
        default:
                switch(wizhood(ob)) {
                        case "(admin)":         return HIY "【 神  仙 】" NOR;
                        case "(arch)":          return HIY "【 神  仙 】" NOR;
                        case "(wizard)":        return HIY "【 神  仙 】" NOR;
                        case "(apprentice)":    return HIW "【 仙  人 】" NOR;
                        case "(immortal)":      return HIW "【 半  仙 】" NOR;
                        default:
                                switch(ob->query("class")) {
                                        case "bonze":           return "【  僧  人  】";
                                        case "taoist":          return "【  道  士  】";
                                        case "ghost":           return "【  幽  灵  】";
                                        case "bandit":          return "【  盗  贼  】";
                                        case "scholar":         return "【  书  生  】";
                                        case "legend":          return "【  游  侠  】";
                                        case "officer":         return "【  官  差  】";
                                        case "fighter":         return "【  武  者  】";
                                        case "lishi":           return "【  武  者  】";
                                        case "swordsman":       return "【  剑  士  】";
                                        case "traveller" :      return "【  浪  子  】";
                                        case "assassin":        return "【  杀  士  】";
                                        case "xiejiao":         return "【  邪  男  】";
                                        case "shaman":          return "【  巫  医  】";
                                        case "yinshi":          return "【  隐  士  】";
                                        case "lama":            return "【  藏  僧  】";
                                        case "beggar":          return "【  叫化子  】";
                                        default:                return "【  平  民  】";
                        }
                }
        }
        return "【 平  民 】";
}

// 传回对对方的尊称
string query_respect(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/respect")) )
                return str;

        age = ob->query_age();
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 18 ) return "小师太";
                                else return "师太";
                                break;
                        case "taoist":
                        case "wudang":
                                if( age < 18 ) return "小仙姑";
                                else return "仙姑";
                                break;
                        default:
                                if( age < 18 ) return "小姑娘";
                                else if( age < 50 ) return "姑娘";
                                else return "婆婆";
                                break;
                        }
                case "无性": {
                        if( age < 18 ) return "小公公";
                        else if( age < 50 ) return "公公";
                        else return "老公公";
                        break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 18 ) return "小师父";
                                else return "大师";
                                break;
                        case "taoist":
                        case "wudang":
                                if( age < 18 ) return "道兄";
                                else return "道长";
                                break;
                        case "fighter":
                        case "swordsman":
                                if( age < 18 ) return "小老弟";
                                else if( age < 50 ) return "壮士";
                                else return "老前辈";
                                break;
                        default:
                                if( age < 20 ) return "小兄弟";
                                else if( age < 50 ) return "壮士";
                                else return "老爷子";
                                break;
                        }
        }
}

// 传回对对方粗鲁的称呼
string query_rude(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/rude")) )
                return str;

        age = ob->query_age();
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                return "贼尼";
                                break;
                        case "taoist":
                        case "wudang":
                                return "妖女";
                                break;
                        default:
                                if( age < 30 ) return "小贱人";
                                else if( age < 50 ) return "贱妇"; //
                                else return "死老太婆";
                                break;
                        }
                case "无性": {
                        if( age < 18 ) return "小太监";
                        else if( age < 50 ) return "死太监";
                        else return "死老太监";
                        break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "死秃驴";
                                else return "老秃驴";
                                break;
                        case "taoist":
                        case "wudang":
                                return "死牛鼻子";
                                break;
                        default:
                                if( age < 20 ) return "小王八蛋";
                                if( age < 50 ) return "臭贼";
                                else return "老匹夫";
                                break;
                        }
        }
}

// 传回自称
string query_self(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/self")) )
                return str;

        age = ob->query_age();
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "贫尼";
                                else return "老尼";
                                break;
                        default:
                                if( age < 30 ) return "小女子";
                                else return "妾身";
                                break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "贫僧";
                                else return "老纳";
                                break;
                        case "taoist":
                        case "wudang":
                                return "贫道";
                                break;
                        default:
                                if( age < 50 ) return "在下";
                                else return "老头子";
                                break;
                        }
        }
}

// 传回粗鲁的自称
string query_self_rude(object ob)
{
        int age;
        string str;

        if( stringp(str = ob->query("rank_info/self_rude")) )
                return str;

        age = ob->query_age();
        switch(ob->query("gender")) {
                case "女性":
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "贫尼";
                                else return "老尼";
                                break;
                        default:
                                if( age < 30 ) return "本姑娘";
                                else if( age < 50 ) return "大娘"; //
                                else return "老娘";
                                break;
                        }
                case "无性": {
                        if( age < 50 ) return "公公我";
                        else return "老公公我";
                        break;
                        }
                case "男性":
                default:
                        switch(ob->query("class")) {
                        case "bonze":
                                if( age < 50 ) return "大和尚我";
                                else return "老和尚我";
                                break;
                        case "taoist":
                                return "本山人";
                                break;
                        default:
                                if( age < 50 ) return "大爷我";
                                else return "老子";
                                break;
                        }
        }
}

// 传回对对方亲密的称呼
string query_close(object ob)
{
        int a1, a2;

        if (objectp(ob))
        {
                if (a2 = (int)ob->query("mud_age"))
                {
                        a1 = this_player()->query("mud_age");
                } else 
                {       
                        a1 = this_player()->query_age();
                        a2 = ob->query_age();
                }
        } else 
        {       
                a1 = this_player()->query_age();
                a2 = 0;
        }
                                                        
        switch (ob->query("gender")) {
        case "女性" :
                if (a1 >= a2)
                        return "妹妹";
                else
                        return "姐姐";
                break;
        default :
                if (a1 >= a2)
                        return "弟弟";
                else
                        return "哥哥";
        }
}

// 传回对自己亲密的称呼
string query_self_close(object ob)
{
        int a1, a2;

        if (objectp(ob))
        {
                if (a2 = (int)ob->query("mud_age"))
                {
                        a1 = this_player()->query("mud_age");
                } else 
                {       
                        a1 = this_player()->query_age();
                        a2 = ob->query_age();
                }
        } else 
        {       
                a1 = this_player()->query_age();
                a2 = 0;
        }
                
        switch (this_player()->query("gender")) {
        case "女性" :
                if (a1 >= a2)
                        return "姐姐我";
                else
                        return "小妹我";
                break;
        default :
                if (a1 >= a2)
                        return "愚兄我";
                else
                        return "小弟我";
        }
}

string gender_self(string sex)
{
        switch(sex) {
                case "女性":    return "你";    break;
                default:        return "你";
        }
}

string gender_pronoun(string sex)
{
        switch(sex) {
                case "男性":    return "他";    break;
                case "女性":    return "她";    break;
                case "无性":    return "他";    break;
                case "雄性":    
                case "雌性":    return "它";    break;
                default:        return "它";
        }
}
