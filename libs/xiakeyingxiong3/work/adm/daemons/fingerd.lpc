#include <ansi.h>
#include <command.h>
#include <login.h>
#include <net/dns.h>

void create() { seteuid( getuid() ); }

// 列出线上所有使用者，他们的中英文姓名，上线时间长短及由那里连过来等资料
string finger_all()
{
        object *ob;
        string msg, fip;
        int i;

        ob = users();
        msg = "";
        if ( !wizardp(this_player()) && ((this_player())->query("id") != "silverwind") ) {        // Micro: 普通玩家使用的Finger命令格式
                for( i = 0; i < sizeof(ob); i++ ) {
                        if( this_player() && !this_player()->visible(ob[i]) ) continue;
                        msg = sprintf( "%s%-14s%-14s%-30s%-12s\n",
                                msg, 
                                ob[i]->query("name"), 
                                ob[i]->query("id"),
                                (query_ip_name(this_player()) == query_ip_name(ob[i]) ) 
                                        ? CHINESE_D->chinese_time( (int)ob[i]->query("mud_age")) : "───", 
                                query_idle(ob[i]) + "秒" );
                }
                return "◎ " + MUD_NAME + " ◎\n" 
                + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
                + "  姓  名      帐  号               年  龄                 发  呆\n"
                + "──────────────────────────────────\n"
                + msg 
                + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
        }
        else {                                  // Micro: 巫师使用的Finger命令格式
                for( i = 0; i < sizeof(ob); i++ ) {
                        if( this_player() && !this_player()->visible(ob[i]) ) continue;
                        msg = sprintf( "%s%-14s%-14s%-30s%-12s%s\n",
                                msg, 
                                ob[i]->query("name"), 
                                ob[i]->query("id"),
                                CHINESE_D->chinese_time( (int)ob[i]->query("mud_age")), 
                                query_idle(ob[i]) + "秒", 
                                query_ip_name(ob[i]) );
                }
                return "◎ " + MUD_NAME + " ◎\n" 
                + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
                + "  姓  名      帐  号               年  龄                 发  呆        连  线\n"
                + "──────────────────────────────────────────\n"
                + msg 
                + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
        }
}

// 取得某个使用者的连线资料。如果该使用者是其他的 MUD 的使用者，则此 request 会
// 由 GFINGER_SERVER 负责。若是 local  的玩家，则显示该玩家的相关资料。
string finger_user(string name)
{
        object ob, body;
        string msg, mud;
        int public_flag;

        if(!wizardp(this_player())) return "";
/*
　      if( sscanf(name, "%s@%s", name, mud) == 2 ) {
                GFINGER_Q->send_finger_q(mud, name, this_player(1));
                return "网路指令传送过程可能需要一些时间，请稍候。\n";
        }
*/
        ob = new(LOGIN_OB);
        ob->set("id", name);
        if( !ob->restore() ) return "没有这个玩家。\n";
        
        if ( !wizardp(this_player()) && ((this_player())->query("id") != "silverwind") ) {        // Micro: 普通玩家使用的Finger指令
                if( objectp(body = find_player(name)) && geteuid(body)==name ) {
                        public_flag = body->query("env/public") ? 1 : 0;
                } else {
                        body = LOGIN_D->make_body(ob);
                        if( !body->restore() ) return "没有这个玩家。\n";
                        public_flag = body->query("env/public")?1:0;
                        destruct(body);
                }               
                msg =  sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n"
                        "电子邮件：\t%s\n上次连线：\t%s\n",
                        ob->query("id"), 
                        ob->query("name"), 
                        SECURITY_D->get_status(name),
                        public_flag ? ob->query("email") : "不告诉你",
                        ctime(ob->query("last_on")) );
                if( objectp(body = find_player(name)) && geteuid(body) == name && !wizardp(body)) {
                        msg += sprintf("\n%s目前正在连线中。\n", body->name(1));
                }
        } else {                                // Micro: 巫师使用的Finger指令
                msg =  sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n"
                        "电子邮件：\t%s\n上次连线：\t%s( %s )\n",
                        ob->query("id"), 
                        ob->query("name"), 
                        ((name=="silverwind")?"(player)":SECURITY_D->get_status(name)),
                        ob->query("email"), 
                        ob->query("last_from"),
                        ctime(ob->query("last_on") )
                );
                if( objectp(body = find_player(name)) && geteuid(body)==name ) {
                        msg += sprintf("\n%s目前正在从 %s 连线中。\n", body->name(1), query_ip_name(body));
                }
        }       
        
        destruct(ob);
        return msg;
}

// 其他的 MUD 若有需要我们某个使用者的资料时，REQUEST 将由这个函数处理。如果
// chinese_flag 有传过来，表示对方也可以看得到中文，则所有相关资料将以中文显
// 示，否则以英文显示。
varargs string remote_finger_user(string name, int chinese_flag)
{
        object ob, body;
        string msg;

return "";

        ob = new(LOGIN_OB);
        ob->set("id", name);
        if( !ob->restore() )
                return chinese_flag ? "没有这个玩家。\n" : "No such user.\n";
        if( chinese_flag ) 
                msg = sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n"
                        "电子邮件：\t%s\n上次连线：\t%s( %s )\n",
                        ob->query("id"), 
                        ob->query("name"), 
                        SECURITY_D->get_status(name),
                        ob->query("email"), 
                        ob->query("last_from"), 
                        ctime(ob->query("last_on")) );
        else 
                msg =  sprintf( "\nName\t: %s\nStatus\t: %s\nEmail\t: %s\nLastOn\t: %s( %s )\n",
                        capitalize(ob->query("id")), 
                        SECURITY_D->get_status(name),
                        ob->query("email"), 
                        ob->query("last_from"), 
                        ctime(ob->query("last_on")) );
        if( body = find_player(name) ) {
                if( !this_player() || this_player()->visible(body) )
                        msg += chinese_flag ?
                                ("\n" + ob->query("name") + "目前正在线上。\n"):
                                ("\n" + capitalize(name) + " is currently connected.\n");
        }
        
        destruct(ob);
        return msg;
}

object acquire_login_ob(string id)
{
        object ob;

        if( ob = find_player(id) ) {
                // Check if the player is linkdead
                if( ob->query_temp("link_ob") )
                        return ob->query_temp("link_ob");
        }
        ob = new(LOGIN_OB);
        ob->set("id", id);
        return ob->restore() ? ob : 0;
}

// 用于城门的布告，显示正在缉拿的人犯。
string get_killer()
{
        int i;
        string msg;
        object *ob = users();

        msg = "";
        for (i = 0; i < sizeof(ob); i++)        // Micro: 列出杀害平民的犯人
                if ( (int)ob[i]->query_condition("civilian_killer")
                &&      !(int)ob[i]->query_condition("killer") )
                        msg += ( HIR "杀人犯：" HIR + ob[i]->short() + "\n" NOR );
        for (i = 0; i < sizeof(ob); i++)        // Micro: 列出杀害玩家的犯人
                if ((int)ob[i]->query_condition("killer"))
                        msg += ( HIW "要  犯：" HIR + ob[i]->short() + "\n" NOR );
        
        if (msg == "")
                return "本城治安良好。\n";
        else
                return "本城正在缉拿以下人犯：\n\n" + msg;
}

