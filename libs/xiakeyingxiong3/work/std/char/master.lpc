#include <dbase.h>
#include <login.h>
#include <ansi.h>

void mission(object me);
void complete_mission(object who);

int prevent_learn(object me, string skill)
{
        int betrayer;

        if( betrayer = me->query("betrayer") ) {

// Micro : 加入当技能 enable 大于 100 则要看叛师的情况
//   faint, 这里改不行，要改动 /std/char/master.c
if( SKILL_D(skill)->enable_factor() > 100 ) {

                // 叛师后不能向新的师父学习最高 betrayer * 20 级的武功
                if( me->query_skill(skill, 1) >= this_object()->query_skill(skill, 1) - betrayer * 20 ) {
                        message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前背叛师门的事情....\n", this_object(), me );
                        command("say 嗯....师父能教你的都教了，其他的你自己练吧。");
                        return 1;
                }
}

        }




        if( !me->is_apprentice_of(this_object())
        &&      (int)this_object()->query_skill(skill, 1) <= (int)me->query_skill(skill, 1) * 3 ) {
                // 门下弟子也有可能没有加入门派，但只能学习师父三分之一的武功
                command("hmm");
                command("pat " + me->query("id"));
                command("say 虽然你是我门下的弟子，可是并非我的嫡传弟子....");
                command("say 我只能教你这些粗浅的本门功夫，其他的还是去找你师父学吧。");
                return 1;
        }

        return 0;
}
 
int give_quest(string arg)
{
        string *levels = ({
                "0",                    // 0
                "20000",
                "50000",
                "100000",
                "250000",
                "500000",
                "1000000",
                "3000000",
                "8000000",              // 100
                "20000000",
        });
/* ----------
        string *levels = ({
                "0",                    // 0 ^ 3
                "1000",
                "8000",
                "27000",
                "64000",
                "125000",
                "216000",
                "343000",
                "512000",
                "729000",
                "1000000",              // 100 ^ 3
                "1331000",
                "1728000",
                "2197000",
                "2744000",
                "3375000",
                "4096000",
                "4913000",
                "5832000",
                "6859000",
                "8000000",              // 200 ^ 3
                "9261000",
                "10648000",
                "12167000",
                "13824000",
                "15625000",
        });
---------- */
        string tag = "_new";            // 封顶任务
        mixed *local;
        mapping quest ;
        object who;
        object mis_ob;
        int i, combatexp, timep, lvl=0;
        int n, t;

        who = this_player();

        if( ! arg || !sscanf(arg, "%d", lvl) ) lvl = 0;
        if( lvl < 0 ) lvl = 0;
/*
        local = localtime( time() * 60 );
        t = local[2] * 60 + local[1];       
        if( t < 240 || t > 1440)
        {
                command("zzz");
                command("say 夜深了，还要什么任务！\n");
                return 1;
        }
*/
        if( (int) who->is_ghost() )
        {
                command("poor " + who->query("id"));                
                command("say 你现在还是鬼魂呀！\n");
                return 1;
        }

        if( ! this_object()->query("can_give_quest") ) {
                if( who->query("family/family_name") != this_object()->query("family/family_name")
                ||      who->query("family/master_name") != this_object()->query("name") ) {
                        command("? " + who->query("id"));                
                        command("say 你不是我的弟子！\n");
                        return 1;
                }
        }

        mission( who );
        if(who->query("quest/flag") == 1) return 0;
        if(who->query("quest/flag") == 2) {    // 玩家的任务失败
                command("angry " + who->query("id"));
                command("say 你上次的任务失败了！");
                who->delete("quest/flag");
                who->delete("quest/start");
                who->delete("quest/time");
                who->delete("quest/id");
                who->delete("quest/name");
                who->delete("quest/done");     // 玩家连继完成任务的次数
                who->receive_damage("kee", who->query("kee") / 3 + 1 );
        }
        if(who->query("quest/flag") == 3) {    // 玩家完成任务
                who->delete("quest/flag");
                who->delete("quest/start");
                who->delete("quest/time");
                who->delete("quest/id");
                who->delete("quest/name");
        }

        if( !who->query("quest/flag") ) {      // 玩家没有任务时，给任务给玩家
                combatexp = (int) who->query("combat_exp");
                for(i = sizeof(levels) - 1 ; i >= 0; i --)
                {
                        if( atoi(levels[i])  <= combatexp )
                        {
                                tag = levels[i];
                                if( i < (sizeof( levels ) - lvl) ) tag = levels[ i + lvl ];
                                break;
                        }
                }
                if( ! random( 100 ) ) tag = "_hard";
                if( ! random( 5 ) ) tag = "_common";
                quest = QUEST_D(tag)->query_quest();
                timep = quest[ "time" ];  
                timep = random( timep / 2 ) + timep / 2;
                mis_ob = new( quest[ "quest" ] );
                tell_object( who, this_object()->query("name") + "对你说：“" + 
                                sprintf( "你这次的任务是%s(%s)。\n" 
                                + space( strlen( who->query("name") ) + 10 ) + "请在%s内完成它。”\n",
                                mis_ob->query("name"), mis_ob->query("id"), chinese_time( timep )) );
/*
log_file( "QUEST", sprintf( "%s（%s）经验：%d  这次的任务是%s(%s) -- %s\n",
who->query("name"), who->query("id"), (int)who->query("combat_exp"), 
mis_ob->query("name"), mis_ob->query("id"), ctime(time())) );
*/

                who->set("quest/start", time());
                who->set("quest/time", timep);
                who->set("quest/id", mis_ob->query("id"));
                who->set("quest/name", mis_ob->query("name"));
                who->set("quest/flag", 1);
                who->set("quest/exp", quest[ "exp_bonus" ]);
                destruct(mis_ob);
                
                // 玩家最多连续八次完成任务        
                if( who->query("quest/done") >= 8 ) who->set("quest/done", 0);

                return 1;
        }

        return 1;
}

int accept_quest_object(object who, object ob) {
    int n;
        if( ! this_object()->query("can_give_quest") ) {
                if( who->query("family/family_name") != this_object()->query("family/family_name")
                ||      who->query("family/master_name") != this_object()->query("name") ) {
                        // command("? " + who->query("id"));
                        // command("say 你不是我的弟子！\n");
                        return 0;
                }
        }
    n = who->query("combat_exp") / 10 + 10000;
    if (who->query("quest/flag")==1){
//        if( ( ob->query("money_id") == "silver"   &&  ob->value() >= 100100 )
//              || ( ob->query("money_id") &&  ob->value() >= n) ) {
        if( ob->query("money_id") == "silver"   &&  (ob->value() >= 100100 || ob->value() >= n ) ) {
                // destruct(ob);
                who->delete("quest/flag");
                who->delete("quest/start");
                who->delete("quest/id");
                who->delete("quest/time");
                who->delete("quest/name");
                // who->delete("quest/done");   // 玩家连继完成任务的次数
                command("nod " + who->query("id"));
                command("say 这次的任务就算了吧！\n");
                return 1;
        }
   }

        if( who->query("quest/flag") != 1 
        ||      ( time() - (int)who->query("quest/start") ) > (int)who->query("quest/time")
        ||      ob->query("id") != who->query("quest/id")
        ||      ob->query("name") != who->query("quest/name") ) {
                // command("angry " + who->query("id"));
                // command("say 这样东西我不感兴趣！\n");
                return 0;
        }
        // destruct(ob);
        complete_mission(who);                  // 完成任务的奖励
        
        return 1;
}

void mission(object who)
{
        if( ( time() - (int)who->query("quest/start") ) <= (int)who->query("quest/time") ) return;
        if( who->query("quest/flag") == 1 ) who->set( "quest/flag", 2 );
}

void complete_mission(object who)
{
        int exp, n, m, p;

        write("你成功的完成了任务！你的潜能和战斗经验都得到了提高。\n");
        who->delete("quest/flag");
        who->delete("quest/start");
        who->delete("quest/id");
        who->delete("quest/time");
        who->delete("quest/name");
        who->add("quest/done", 1);              // 玩家连继完成任务的次数

        exp = who->query("quest/exp");
        n = who->query("combat_exp") / 10000;
        if( n > 100 ) n = 100;
        m = random( exp ) / 10 + 1;
        if( who->query("quest/done") >= 8 ) {   // 玩家连续八次完成任务，加大奖励
                who->delete("quest/done");      // 玩家连续完成任务的次数
                m += 50;
                n += 50;
        }
        else {                                  // 玩家连续完成任务的的奖励
                m += m * who->query("quest/done");
                n += random( n ) + 5 * who->query("quest/done");
        }
        n += random( exp ) / 2 + exp / 2 + 1;

        p = (int)who->query("potential") - (int)who->query("learned_points");

        // Micro: 这里的效果，当潜能没到 1000 时，就可增加，否则不能增加
        // 说是 1000 封顶，实际有一次机会可以大于 1000
                // Micro: 再次改，如果有 500XXXX 经验，则以 5000 封顶
        if( p < 1000 + who->query("combat_exp")/10000 ) who->add("potential", m);

        who->add("combat_exp", n);
        who->add("score", 1);
        tell_object(who, sprintf("你的潜能增加了%s点！\n", chinese_number(m)));
        tell_object(who, sprintf("你的经验增加了%s点！\n", chinese_number(n)));
}
