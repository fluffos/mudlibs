// hit.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj, old_target;
	object* member;
	int i;

	if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

	if( !wizardp(me) && environment(me)->query("no_fight") )
		return notify_fail("这里禁止战斗。\n");

	if(!arg || !objectp(obj = present(arg, environment(me))))
		return notify_fail("你想攻击谁？\n");

	if( !obj->is_character() )
		return notify_fail("看清楚一点，那并不是生物。\n");

	if( obj->is_fighting(me) )
		return notify_fail("加油！加油！加油！\n");

	if( !living(obj) )
		return notify_fail(obj->name() + "已经无法战斗了。\n"); 

	if( obj == me ) return notify_fail("你不能攻击自己。\n");

	if( obj->query("no_hit") )
		return notify_fail("你不能攻击" + obj->query("name") + "。\n");

	if( ! me->query_temp("array") )
	{   
	    	if(! obj->query_temp("array"))
	    	{
			message_vision("\n$N大喝一声，开始对$n发动攻击！\n\n", me, obj);
			me->fight_ob(obj);
			if(userp(obj) && !obj->query_temp("kill_first/"+me->query("id")) )
				me->set_temp("kill_first/"+obj->query("id"), 1);

			if( obj->query("can_speak") ) 
			    	obj->fight_ob(me);
			else
		    		obj->kill_ob(me);
	    	}
	    	else
	    	{  
			message_vision("\n$N大喝一声，开始对$n所在的剑阵发动攻击！\n\n", me, obj);
			member= obj->query_team();     
			for(i = 0; i < sizeof(member); i ++)
			{   
				me->fight_ob(member[i]);
			       	member[i]->fight_ob(me);
			}
	     	}      
	}
	else
	{  
	     	member = me->query_team();
	     	message_vision("\n$N大喝一声，开始启动剑阵,对$n发动攻击！\n\n", me, obj);
	     	for(i = 0; i < sizeof(member); i ++ )
	    	{     
		     	member[i]->fight_ob(obj);
	     		obj->fight_ob(member[i]);
	    	}
	}
	return 1;
}

int help(object me)
{
  	write(@HELP
指令格式：hit <人物>

向一个人物「讨教」或者是「切磋武艺」，与fight 不同的是，无论对手
是否愿意和你交手，都必须和你战斗。

其他相关指令：fight，kill

HELP
    	);

    	return 1;
}
 
