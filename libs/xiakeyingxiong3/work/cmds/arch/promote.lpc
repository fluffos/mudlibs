// promote.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6
inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob;
  string old_status, new_status;
  int my_level, ob_level, level;

  if (me != this_player(1)) return 0;

  if (!arg || sscanf(arg, "%s %s", arg, new_status) != 2)
    return help(me);

  if (wiz_level(new_status) < 0) return notify_fail("没有这种等级。\n");

  if (!objectp(ob = present(arg, environment(me)))
    || !userp(ob))
    return notify_fail("你只能改变使用者的权限。\n");

  if (wiz_level(me) < wiz_level(new_status))
    return notify_fail("你没有这种权力。\n");

  old_status = wizhood(ob);

  seteuid(getuid());
  if (!(SECURITY_D->set_status(ob, new_status)))
    return notify_fail("修改失败。\n");

  message_vision("$N将$n的权限从 " + old_status + " 改为 " + new_status + " 。\n", me, ob);
  seteuid(getuid());
  ob->setup();

  log_file("wiz_log/promote_log",
    sprintf("%s(%s) promote %s(%s)->%s at (%s)\n",
      me->name(1), geteuid(me), ob->name(1), geteuid(ob), new_status, ctime(time())));

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : promote <某人> (权限等级)

提升权限等级：(player) (immortal) (apprentice) (wizard) (arch);
(admin) 是不能通过本指令晋升的!
HELP
  );

  return 1;
}
