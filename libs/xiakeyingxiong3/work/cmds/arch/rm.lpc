#include "/doc/help.h"

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string file)
{
	seteuid(geteuid(me));
    	if (!file) return help(me);
	if( rm(resolve_path(me->query("cwd"), file)) ) write("文件删除成功。\n");
	else write("你没有删除这个档案的权力。\n");
	return 1;
}

int help(object me)
{
  	write(@HELP
指令格式 : rm <文件名>

删除文件。

HELP
    	);

    	return 1;
}
