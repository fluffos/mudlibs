// demongorgon.c
// 修改  goblin 顽皮小鬼

#include <login.h>
#include <obj.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string wiz_status;
        object npc;

        if( me != this_player(1) ) return 0;
        
        wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" && wiz_status != "(arch)" )
                return notify_fail("你的等级不足以重新启动" + MUD_NAME + "\n");

        seteuid(getuid());

        npc = new(NPC_DEMOGORGON);
        npc->move(START_ROOM);
        npc->start_shutdown();

        write("系统将重新启动。\n");

	log_file("wiz_log/reboot_log",
		sprintf("%s(%s) reboot system at (%s).\n",
		me->name(), me->query("id"), ctime(time()) ) );

        return 1;
}

int help (object me)
{
        write(@HELP
指令格式：reboot
 
重新启动游戏, 系统会开始倒数计时, 三分钟后重新起动。
 
HELP
        );

        return 1;
}
