#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string msg;

	if( file_size(user_path(geteuid(me)) + "workroom.lpc") <= 0 ) {
		// return notify_fail("你没有自己的工作室。\n");
		me->move("/obj/wizard/workroom");
		return 1;
	}

	if( stringp(msg = me->query("env/msg_home")) )
		message_vision(msg + "\n", me);
	me->move(user_path(geteuid(me)) + "workroom");
	return 1;
}

int help(object me)
{
  	write(@HELP
指令格式：home

直接回到自己的工作室。
如果你对 msg_home 进行设定，则在场的人都会看到那个讯息。

HELP
    	);

    	return 1;
}
