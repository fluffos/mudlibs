#include <skill.h>

inherit F_CLEAN_UP;

string *reject_msg = ({
        "说道：“您太客气了，这怎么敢当？”\n",
        "像是受宠若惊一样，说道：“请教？这怎么敢当？”\n",
        "笑著说道：“您见笑了，我这点雕虫小技怎够资格‘指点’您什么？”\n",
});

int help(object me);
int couple_learn(object me, object couple, string skill);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        object ob, *list , couple_ob, env;
        string skill, teacher, master;
        string target, cardname;
        int master_skill, my_skill, gin_cost, times;
        int i, n, marry_flag, learn_factor, learn_bonus, gain;

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        env = environment(me);
        if( env->query("restrict_action") ) 
                return notify_fail("这里不能做这件事情。\n");

        if( me->is_fighting() ) return notify_fail("临阵磨枪？来不及啦。\n");
        if (!arg || arg=="")    return help(me);
        if(sscanf(arg, "%d %s",times, arg) == 2 ) { 
                if(times < 1) return notify_fail("最少要学一次。\n");
        }
        else times = 1;

        if(times > 100) return notify_fail("你学那么多次干什么？\n");

        if(!arg || sscanf(arg, "%s from %s", skill, teacher)!=2 ) return help(me);

        if( !(ob = present(teacher, environment(me))) || !ob->is_character())
                return notify_fail("你要向谁求教？\n");

        if( !living(ob) ) return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");

        if( ob == me ) return notify_fail("你想向自己请教？\n");

        target = (string)me->query("marry");
 
        if( !me->is_apprentice_of(ob) ) {
                if (ob->query("id") != target) {
                if( (string)me->query("family/family_name") != (string)ob->query("family/family_name")
                ||      (int)ob->query("family/privs") != -1 ) {
                        notify_fail( ob ->name() + reject_msg[random(sizeof(reject_msg))] );
                        if( !(ob->recognize_apprentice(me)) ) return 0;
                }
                }
        }

        if( !master_skill = ob->query_skill(skill, 1) )
                return notify_fail("这项技能你恐怕必须找别人学了。\n");

        notify_fail(ob->name() + "不愿意教你这项技能。\n");
        if( ob->prevent_learn(me, skill) ) return 0;

        // 离一次婚就只能学到下一位伴侣的一半的武功
        // Micro: yuxin说 一定要双方的marry标记都对得上才可以learn.
        if( target == ob->query("id") && me->query("id") == (string)ob->query("marry") )
                if( couple_learn(me,ob,skill) ) return 0;

        my_skill = me->query_skill(skill, 1);

                                                // 叛一次师就只能学到下一位师父低20级的武功
        if( !( i = me->query("betrayer") ) ) i = 0;

// Micro : 加入当技能 enable 大于 100 则要看叛师的情况
if( SKILL_D(skill)->enable_factor() > 100 ) {
printf("%s %d\n", skill, SKILL_D(skill)->enable_factor());
        if( my_skill >= master_skill - 20 * i && my_skill < master_skill )      
                message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前叛师的事情....\n", ob, me );      
}

        if( my_skill >= master_skill )
                return notify_fail("这项技能你的程度已经不输你师父了。\n");

        notify_fail("依你目前的能力，没有办法学习这种技能。\n");
        if( !SKILL_D(skill)->valid_learn(me) ) return 0;


        // gin_cost = 100 / (int)ob->query_int();
        gin_cost = 200 / ( (int)ob->query("int") + (int)me->query("int") );

//      casue problem under query-skill-eff-lvl
        if( !my_skill ) {
                gin_cost *= 2;
                me->set_skill(skill,0);
        }

        if( (int)me->query("learned_points") >= (int)me->query("potential") )
                return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
        printf("你向%s请教有关「%s」的疑问。\n", ob->name(), to_chinese(skill));

        if( ob->query("env/no_teach") )
                return notify_fail("但是" + ob->name() + "现在并不准备回答你的问题。\n");

        tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n",
                me->name(), to_chinese(skill)));

        if( (int)ob->query("sen") > gin_cost/5 + 1 ) {
                if( userp(ob) ) ob->receive_damage("sen", gin_cost/5 + 1);
        } else {
                write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
                tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
                return 1;
        }
                
        n = 20 - (int)(my_skill / 10);
        if( (int)me->query("gin") > gin_cost * times ) {
/*
                if( (string)SKILL_D(skill)->type()=="martial"
                &&      my_skill * my_skill * my_skill / ( (n <= 0) ? 1 : ( n >= 10 ) ? 10 : n ) 
                        * ( (int)SKILL_D(skill)->enable_factor() >= 100 ? (int)SKILL_D(skill)->enable_factor() : 100 )
                        / 100 > (int)me->query("combat_exp") ) {
*/
                // if( (string)SKILL_D(skill)->type()=="martial"
                // 这里所有的东西都与经验相关，所以取消上一行。
                // if((my_skill * my_skill * my_skill) / 10 * (int)SKILL_D(skill)->enable_factor() / 100  >
                // 限制到 10 - 150 要 exp : 2000 - 6750000
                if((my_skill * my_skill * my_skill) * (int)SKILL_D(skill)->enable_factor() / 150  >
                        (int)me->query("combat_exp") ) {

                        printf("也许是缺乏实战经验，你对%s的回答总是无法领会。\n", ob->name() );
                } else {
                        printf("你听了%s的指导，似乎有些心得。\n", ob->name());
/*
                        gain = (int)( me->query("int") / 2 ) + (int)( me->query("combat_exp") / 2000);

                        if(!(learn_factor = SKILL_D(skill)->learn_factor(my_skill)) )
                                learn_factor = 100;

                        learn_bonus = 0;
                        if(!(learn_bonus = SKILL_D(skill)->learn_bonus()) ) ;
                        gain = gain * learn_factor / 100 + learn_bonus;
*/
                        // 算法：( exp / 十万 + int * kar / 30 + skill / 10 ) / learn
                        // NEW : (int + master_int) / 60 * kar / 30 + skill / learn
                        gain = ((int)me->query_int() + (int)ob->query_int()) / 2;

                        gain = gain * ( 11 + random(20) ) / 60;

                        gain = gain + my_skill;  // / 10 + me->query("combat_exp") / 100000;

                        i = SKILL_D(skill)->learn_factor(my_skill);
                        if( i == 0 ) i = 100;
                        else gain = gain * 100 / i;

                        // 10 级到 150 级会学到：30 .. 120 点，修正：
// gain = gain / 2;
                        if( gain < 1 ) gain = 1;

                        me->add("learned_points", times);
                        me->improve_skill(skill, gain * times );
                        // me->improve_skill(skill, (present("jingang zhao", me)) ? gain * 2 : gain );
                }
        } else {
                gin_cost = 0;
                write("你今天太累了，结果什麽也没有学到。\n");
        }

        me->receive_damage("gin", gin_cost * times );

        return 1;
}

int couple_learn(object me, object couple, string skill)
{
        int i, div, mylvl, herlvl, ratio = 1;

        mylvl = me->query_skill(skill,1);
        herlvl = couple->query_skill(skill,1);
        div = (int) me->query("divorced");
        for(  i=1; i<=div; i++) ratio *= 2;


        // if( my_skill >= master_skill - 20 * i && my_skill < master_skill )      
        //         message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前叛师的事情....\n", ob, me );      

        if( mylvl >= herlvl - 20 * div && mylvl < herlvl ) {
                message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前离婚的事情....\n", couple, me );  
                return 1;       
        }
/*
        if( (mylvl >= herlvl / ratio) && ratio != 1) {
                message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前离婚的事情....\n", couple, me );  
                return 1;       
        }
*/
        return 0;
}

int help(object me)
{
        write(@HELP
指令格式：learn <技能> from <某人>

这个指令可以让你向别人请教有关某一种技能的疑难问题，当然，你请教
的对象在这项技能上的造诣必须比你高，而你经由这种方式学习得来的技
能也不可能高於你所请教的人，然而因为这种学习方式相当於一种「经验
的传承」，因此学习可以说是熟悉一种新技能最快的方法。

通常，一个人刚学到一种新技能是不会有什麽疑难问题的，而是经由实际
上的应用中遭遇问题，这些问题对於学习一种新技能的过程是很重要的，
尤其是各种作为其他技能基础的基本技能，更需要经由「发现问题—解决
问题」的过程才能得到较好的效果因此我们将这种发现问题的过程用「潜
能」的观念表示，一个人能够自己发现某些问题，表示他(她)有解决这项
问题的潜能，当你具有这样的潜能时就可以利用这个指令来向其他人请教，
而获得进步。（PS. 潜能还有其他更广义的定义，这里只是其中之一）

此外学习也需要消耗一些精力，而消耗的精力跟你自己、与你学习对象的
悟性有关。

至於如何知道你能从对方学到什麽技能，如果对方是你的师父，可以用 skills 
指令直接查看，如果不是你的师父，那麽通常会有其他的提示，你只好自
己想办法了。

参考指令：practice、study。
HELP
        );

        return 1;
}
 
