// checkenable.c

#include <ansi.h>

int help(object me);

inherit F_CLEAN_UP;

mapping valid_types = ([
  "force": "内功",
  "move": "行动",
  "dodge": "轻功",
  "magic": "法术",
  "spells": "咒术",
  //      "array":        "阵法",
  "parry": "招架",
  "unarmed": "拳脚",
  "sword": "剑法",
  "blade": "刀法",
  "stick": "棍法",
  "whip": "鞭法",
  "throwing": "暗器",
  "qimen": "奇门",
  "iron-cloth": "铁布衫",
  //	"finger" :	"指法",
  //	"claw" :	"爪法",
  //	"staff":        "杖法",
]);

int main(object me, string arg) {
  mapping map;
  string *types, *skill, ski, map_to, id, tmp;
  int i, modify;
  object ob;

  seteuid(getuid());

  if (!arg) {
    map = me->query_skill_map();
    if (!mapp(map) || sizeof(map) == 0)
      return notify_fail("你现在没有使用任何特殊技能。\n");

    skill = keys(valid_types);
    write("以下是你目前使用中的特殊技能。\n");
    for (i = 0; i < sizeof(skill); i++) {
      if (undefinedp(valid_types[skill[i]])) {
        map_delete(map, skill[i]);
        continue;
      }
      if (!me->query_skill(skill[i])) continue;
      modify = me->query_temp("apply/" + skill[i]);
      printf("  %-20s： %-20s  有效等级：%s%3d\n" NOR,
        valid_types[skill[i]] + " (" + skill[i] + ")",
        undefinedp(map[skill[i]]) ? "无" : to_chinese(map[skill[i]]),
        (modify == 0 ? "" : (modify > 0 ? HIC : HIR)),
        me->query_skill(skill[i]));
    }
    return 1;
  }

  // if( arg=="?" ) {
  if ((sscanf(arg, "%s", tmp) == 1) && (arg == "?")) {
    write("以下是可以使用特殊技能的种类：\n");
    skill = sort_array(keys(valid_types), (: strcmp :));
    for (i = 0; i < sizeof(skill); i++) {
      printf("  %s (%s)\n", valid_types[skill[i]], skill[i]
      );
    }
    return 1;
  }

  if ((sscanf(arg, "%s", id) == 1) && (wizardp(me))) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return help(me);
    map = ob->query_skill_map();
    if (!mapp(map) || sizeof(map) == 0)
      return notify_fail((ob->name()) + "现在没有使用任何特殊技能。\n");

    skill = keys(valid_types);
    write((ob->name()) + "目前使用中的特殊技能如下：\n");
    for (i = 0; i < sizeof(skill); i++) {
      if (undefinedp(valid_types[skill[i]])) {
        map_delete(map, skill[i]);
        continue;
      }
      if (!ob->query_skill(skill[i])) continue;
      modify = ob->query_temp("apply/" + skill[i]);
      printf("  %-20s： %-20s  有效等级：%s%3d\n" NOR,
        valid_types[skill[i]] + " (" + skill[i] + ")",
        undefinedp(map[skill[i]]) ? "无" : to_chinese(map[skill[i]]),
        (modify == 0 ? "" : (modify > 0 ? HIC : HIR)),
        ob->query_skill(skill[i]));
    }
    return 1;
  }
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：checkenable ?
	  checkenable <id> or ‘checkenable’

这个指令让你可以查询正在游戏的player的enable状况，
如果加一个 ? 会列出所有能使用特殊技能的技能种类。
 
HELP
  );
  return 1;
}
