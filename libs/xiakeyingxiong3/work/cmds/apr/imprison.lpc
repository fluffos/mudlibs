// imprison.c (监禁player)
// By Key	1999-02-26
 
#include "/doc/help.h"

inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	object ob;
	object room;

	if (!arg) return notify_fail("指令格式: imprison <player>\n");
	ob = find_player(arg);
	if (!ob) return notify_fail("找不到这个玩家。\n");
	message_vision("$N手一挥，一阵微风将$n吹入玩家监狱．．．\n",me,ob);
	if(!room =find_object("/d/wizard/jail"))
	room = load_object("/d/wizard/jail");
	ob->move(room);
	ob -> save();

	log_file("wiz_log/PLAYER_LOG",
		sprintf("%s(%s) coop %s(%s) at (%s)\n\n",
		me->name(1), geteuid(me), ob->name(1), geteuid(ob), ctime(time()) ));

	return 1;
}
 
int help(object me)
{
   write(@HELP
指令格式: imprison <玩家>
将某个玩家禁锢在监狱里，在监狱里什么也做不了，
一直到被提出监狱。

HELP
   );
   return 1;
}
