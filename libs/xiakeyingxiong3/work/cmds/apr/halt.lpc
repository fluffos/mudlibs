// halt.c

#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

// int main(object me, string arg, string str)
int main(object me, string str)
{
        object *obj = users(), env, *inv;
        string str_all;
        int i;

	if (!str) {
	        if( !me->is_fighting() )
	                return notify_fail("你现在并没有在战斗。\n");
	        me->remove_all_killer();
	        // message_vision("$N用巫师的神力停止了于你相关的战斗!\n", me);
		tell_object(me,"于你相关的战斗停止了!\n");
	        return 1;
	}

	if( (sscanf(str, "%s", str_all) == 1) && (str_all == "all") )
                {
		        env = environment(me);
		        inv = all_inventory(env);
		        for(i=0; i<sizeof(inv); i++) {
				if( inv[i]==me ) continue;
				if( inv[i]->is_corpse() ) continue;
				if( !inv[i]->is_character() ) continue;
				inv[i]->remove_all_killer();
                                // message_vision("$N用巫师的神力停止了于你相关的战斗!\n", me);
				tell_object(inv[i],"于你相关的战斗停止了!\n");

		        }
			me->remove_all_killer();
			return 1;
                }
}

int help(object me)
{
   write(@HELP
指令格式: halt
可以停止所有与你(□)有关的战斗。

指令格式: halt all
可以停止本场景的所有战斗。
HELP
   );
   return 1;
}
