inherit F_CLEAN_UP;

int main(object me,string arg)
{
	seteuid(geteuid(me));

	dumpallobj();
	write("结果已经写入文件：/OBJ_DUMP 。\n");

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：dump

将所有物体的状态写入文件：/OBJ_DUMP。

HELP
	);

	return 1;
}
 
