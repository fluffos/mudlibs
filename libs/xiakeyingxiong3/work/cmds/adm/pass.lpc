// pass.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6

int help(object me);

void create()
{
        seteuid(getuid());
}

int main(object me, string arg)
{
        string site;

        if (!arg) BAN_D->print_passed();
        else if (sscanf(arg, "+ %s", site) == 1) {
                if (site[sizeof(site)-1] == '*' || site[sizeof(site)-1] == '?' || site[sizeof(site)-1] == '+')
                        write("不能开放以 *, +, ? 结尾的地址。\n");
                else {
                        BAN_D->add_passed(site);
                        write( "完成。\n" );
                }
        }
        else if (sscanf(arg, "- %s", site) == 1) {
                BAN_D->remove_passed(site);
                write( "完成。\n" );
        }
        else help(me);

	log_file("wiz_log/ban&pass_log",
		sprintf("%s(%s) 'pass %s' at (%s).\n",
		me->name(), me->query("id"), arg, ctime(time()) ) );

        return 1;
        
}

int help(object me)
{
        write(@HELP
指令格式：pass                  显示所有强行开放的地址
          pass +|- site         开放／解封地址

强行开放一些地址，用于防止有人蓄意捣乱。

关联信息：ban
HELP
        );

        return 1;
}
