// save.c

inherit F_CLEAN_UP;

void delete_save(object me);

int main(object me, string arg)
{
        object link_ob;

        seteuid(getuid());

        if( !objectp(link_ob = me->query_temp("link_ob")) )
                return notify_fail("你不是经由正常连线进入，不能储存。\n");

        if( environment(me)->query("valid_startroom") ) {
                me->set("startroom", base_name(environment(me)));
                write("当你下次连线进来时，会从这里开始。\n");
        }
        if( me->query_temp("save") )
                return notify_fail("刚刚才储存了一次，那么快又要储存了？\n");

        if( (int)link_ob->save() && (int)me->save() ) {
                me->set_temp("save",1);
                call_out("delete_save",10,me);
                write("档案储存完毕。\n");
                return 1;
        } else {
                write("储存失败。\n");
                return 0;
        }
}

void delete_save(object me)
{

// 出错，当用户quit
        if (!me) return;

     me->delete_temp("save");
}
   

int help(object me)
{
        write(@HELP
指令格式：save  

把你辛苦奋斗的结果存起来，下次上线，你将会出现在上次储存的地方。

相关讯息：quit

HELP
        );
        
        return 1;
}
