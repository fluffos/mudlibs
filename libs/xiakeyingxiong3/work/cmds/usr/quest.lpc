// quest.c

inherit F_CLEAN_UP;

string clock(int t);

int main(object me, string arg)
{
        int t;
        object ob, m_ob, env;

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        env = environment(me);
        if( env->query("restrict_action") ) 
                return notify_fail("这里不能做这件事情。\n");

        if (!wizardp(me) || arg == "") ob = me;
        else
        {
                if( arg ) {
                        ob = present(arg, environment(me));
                        if (!ob) ob =  find_player(arg);
                        if (!ob) return notify_fail("你要察看谁的任务？\n");
                }
                else
                        ob = me;
        }

        if( m_ob = present("shenxian shizhe", environment(me)) ) {
                if( m_ob->query("can_give_quest") ) m_ob->give_quest();
        }
        else {  if (stringp(me->query("family/master_id")))           //add by Fan
                if( m_ob = present( me->query("family/master_id"), environment(me)) )
                        if( m_ob->query("name") == me-> query("family/master_name") )
                                m_ob->give_quest();
        }

        if(ob->query("quest/flag") == 0) {
                write("你目前没有任何任务。\n");
                return 1;
        }
        
        if((time() - (int)ob->query("quest/start")) > (int)ob->query("quest/time") ) {
                write("太遗憾了！你已经不可能有足够时间来完成你的任务了。\n");
                return 1;
        }
        t = (int)ob->query("quest/time") + (int)ob->query("quest/start") - time();
        printf("你现在的任务是" + ob->query("quest/name") 
                + "（" + ob->query("quest/id") + "）。\n");
        printf("你还有" + chinese_time( t ) + "的时间来完成你的任务。\n");
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：quest

这个指令让你知道你还有多少时间来完成你的任务。

HELP
        );

        return 1;
}
