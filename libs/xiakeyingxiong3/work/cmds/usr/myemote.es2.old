// myemote.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        mapping emote;
        string *e, *str;
        int i, j;

        if(!mapp(emote = me->query("emote")) )
                return notify_fail("你没有编辑任何emote。\n");

        e = keys(emote);

        for(i=0, j=0; i<sizeof(e); i++) {
                str = explode(e[i]+"\n", "__1");
                if(sizeof(str) < 2 )    str = explode(e[i]+"\n", "__2");
                if(sizeof(str) < 2 )    str = explode(e[i]+"\n", "__3");

                printf("%-15s%s", str[0], (i%5==4)?"\n": "");
                j++;
        }
        write("\n");
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：myemote

这个指令可以列出你目前自己定义的emote。
HELP
        );
        
        return 1;
}
