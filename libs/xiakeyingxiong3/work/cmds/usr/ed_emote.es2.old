// edemote.c

inherit F_CLEAN_UP;

int in_use;

int main(object me, string arg)
{
        string s1, s2;

        if( !arg ) return notify_fail("你要编辑什麽 emote？\n");

        if( sscanf(arg, "-d %s", arg) ) {
                write("删除 emote：" + arg + "\n");
                me->delete("emote/"+arg+"__1");
                me->delete("emote/"+arg+"__2");
                me->delete("emote/"+arg+"__3");
                return 1;
        }
        
        if(sizeof(me->query("emote"))>=15)
                return notify_fail("你编辑的emote 太多了，只能用edemote -d删除某条emote 。\n");

        if(sscanf(arg, "%s %s",s1, s2) == 2)
                return notify_fail("指令格式：  edemote [-d] <emote>\n");

        write("编辑 emote：" + arg + "\n");
        write("讯息可以有好几行，用 . 表示结束。\n");
        write("讯息中可使用的参数有以下几种：\n");
        write("  $N  自己的名字。\n");
        write("  $n  使用对象的名字。\n");
        write("  $P  自己的人称代名词，如你、他、她、它、它。\n");
        write("  $p  使用对象的人称代名词，如你、他、她、它、它。\n");
        write("  $r  使用对象的粗鲁代名词，如小王八蛋、臭贼。\n");
        write("  $s  使用对象的尊敬代名词，如小兄弟、小姑娘。\n");
        write("————————————————————————————————————\n");
        write("不指定对象使用这个 emote 时，所有人看到的讯息：\n->");
        me->delete("emote/"+arg+"__1");
        input_to("get_msg", me, arg);
        return 1;
}

int get_msg(string msg, object me, string str)
{
        if (msg==".") {
                write("对别人使用这个 emote 时，所有人看到的讯息：\n->");
                me->delete("emote/"+str+"__2");
                input_to("get_msg_others", me, str);
                return 1;
        }
        if(me->query("emote/"+str+"__1"))
                me->set("emote/"+str+"__1", me->query("emote/"+str+"__1")+msg+"\n");
        else    me->set("emote/"+str+"__1", msg+"\n");

        write("->");
        input_to("get_msg", me, str);
        return 1;
}


int get_msg_others(string msg, object me, string str)
{
        if (msg==".") {
                write("对自己使用这个 emote 时，所有人看到的讯息：\n->");
                me->delete("emote/"+str+"__3");
                input_to("get_msg_self", me, str);
                return 1;
        }
        if(me->query("emote/"+str+"__2"))
                me->set("emote/"+str+"__2", me->query("emote/"+str+"__2")+msg+"\n");
        else    me->set("emote/"+str+"__2", msg+"\n");
        write("->");
        input_to("get_msg_others", me, str);
        return 1;
}

int get_msg_self(string msg, object me, string str)
{
        if (msg==".") {
                write("Emote 编辑结束。\n");
                return 1;
        }
        if(me->query("emote/"+str+"__3"))
                me->set("emote/"+str+"__3", me->query("emote/"+str+"__3")+msg+"\n");
        else    me->set("emote/"+str+"__3", msg+"\n");
        write("->");
        input_to("get_msg_self", me, str);
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：edemote [-d] <emote>

这个指令可以修改、删除自己设置的 emote。加上 -d 参数会删除指定的
emote.
 
输入 emote 讯息时有三个项目：没有目标，指定目标或是对自己。若不
想有某项讯息，则直接在空白行输入 '.' 跳过。
 
一个 emote 讯息可以有很多行，在空白行输入 '.' 结束输入该项 emote。
 
编辑 emote 时可以用以下的符号来表示：
 
$N : 自己的名字
$n : 目标的名字
$P : 自己的人称代名词
$p : 目标的人称代名词
$r : 目标的粗鲁代词
$s : 目标的尊敬代词
 
HELP
        );
        
        return 1;
}