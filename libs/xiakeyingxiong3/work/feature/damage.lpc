#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

int ghost = 0;

// 判断物件是否为鬼魂。
int is_ghost() { return ghost; }

// 让物件某项状况的数值减少。damage 不得为负数。本函数会检查伤害种类是
// 否合法後将物件的状况数值减少，若最後值低於零则设为 -1。最後，打开物
// 件的心跳 (heart_beat)。
varargs int receive_damage(string type, int damage, object who) {
  int val;

  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 伤害种类错误（只能是gin、kee、sen其中之一）。\n");

  if (objectp(who)) set_temp("last_damage_from", who);
  val = (int)query(type) - damage;

  if (val >= 0) set(type, val);
  else {
    set(type, -1);
  }

  set_heart_beat(1);

  return damage;
}

// 让物件某项状况的状态减少。damage 不得为负数。本函数会检查伤害种类是
// 否合法後将物件的状况状态（eff_XXX）减少，若最後值低於零则设为-1。最
// 後，打开物件的心跳 (heart_beat)。
// 同receive_damage。但伤害是加在状态值上（eff_xxx）。
varargs int receive_wound(string type, int damage, object who) {
  int val;

  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 伤害种类错误（只能是 gin、kee、sen 其中之一）。\n");

  if (objectp(who)) set_temp("last_damage_from", who);
  val = (int)query("eff_" + type) - damage;

  if (val >= 0) set("eff_" + type, val);
  else {
    set("eff_" + type, -1);
    val = -1;
  }

  if ((int)query(type) > val) set(type, val);

  set_heart_beat(1);

  return damage;
}

// 与receive damage作用相反，本函数是将某个数值加入状况的数值上。
int receive_heal(string type, int heal) {
  int val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 恢复种类错误（只能是gin、kee、sen其中之一）。\n");

  val = (int)query(type) + heal;

  if (val > (int)query("eff_" + type)) set(type, (int)query("eff_" + type));
  else set(type, val);

  return heal;
}

// 与receive_wound作用相反，本函数是将数值加入状态值上，相当於医疗。
int receive_curing(string type, int heal) {
  int max, val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 恢复种类错误（只能是gin、kee、sen其中之一）。\n");

  val = (int)query("eff_" + type);
  max = (int)query("max_" + type);

  if (val + heal > max) {
    set("eff_" + type, max);
    return max - val;
  } else {
    set("eff_" + type, val + heal);
    return heal;
  }
}

// 把某个物件弄昏，判别及执行步骤如下：没有生命的物件不能设，如果物件
// 是因为受伤而昏的，呼叫在COMBAT_D中的winner_reward() 以处理战胜者的
// 奖赏....删除指定物件的敌人表, 送出相关讯息（让在场的大家都知道）将
// 精气神等状态设为０，关闭指定物件接受讯息的的权力，最後设定清醒的时
// 间，放到call_out上。
void unconcious() {
  object defeater;

  if (!living(this_object())) return;
  if (wizardp(this_object()) && query("env/immortal")) return;
  if (this_object()->query_temp("unconcious")) return;           // 如果已经昏倒，则返回

  if (objectp(defeater = query_temp("last_damage_from")))
    COMBAT_D->winner_reward(defeater, this_object());       // 这个命令处理战胜者的奖赏
    // (else ?) COMBAT_D->loser_penalty(defeater, this_object());

    // if( ! this_object()->query("possessed"))
    this_object()->remove_all_enemy();

  message("system", HIR "\n你的眼前一黑，接著什麽也不知道了....\n\n" NOR, this_object());
  this_object()->disable_player("<昏迷不醒>");
  // this_object()->disable_commands();
  set("gin", 0);
  set("kee", 0);
  set("sen", 0);
  // 改动：将all 改为以下的情况
  // set_temp("block_msg/all", 1);
  set_temp("block_msg/say", 1);
  set_temp("block_msg/vision", 1);
  set_temp("block_msg/sound", 1);

  COMBAT_D->announce(this_object(), "unconcious");        // 昏迷

  // 本来在醒时再用delete(no_put)，但是没有必要了。
  // 这里用于不能将生物放入bag
  set("no_put", 1);

  // 使用后天的con
  call_out("revive", random(100 - this_object()->query_con()) + 30);    // 醒来的时间与随机及根骨有关
}

// 把某人弄醒。如果call_out还在，删掉他。如果清醒的物件本来是在另一个使
// 用者的inventory 中，将之移到使用者的环境中. 呼叫enable_player() 以设
// 定玩家的指令和相关设定，传出对应的讯息并将讯息管道打开。若传入值quiet 
// 为1 ，则清醒的讯息不会送出。
varargs void revive(int quiet) {
  remove_call_out("revive");
  while (environment()->is_character())
    this_object()->move(environment(environment()));
  // this_object()->enable_commands();
  this_object()->enable_player();
  if (!quiet) {
    COMBAT_D->announce(this_object(), "revive");
    set_temp("block_msg/all", 0);
    message("system", HIY "\n慢慢地你终於又有了知觉....\n\n" NOR,
      this_object());
  } else
    // 这里是相对于前面的修改。
    delete_temp("block_msg");
}

void be_ghost(int flag) {
  ghost = flag;
}

// 死了....如果物件是昏迷不醒的状况，先把他弄醒。奖励杀人者并制造一具尸体，
// 把killer表删除，如果死者是玩家，则把他设为鬼魂并送到阴间去，否则直接摧
// 毁该物件.
void die() {
  object corpse, killer;
  int i;

  if (!living(this_object())) revive(1);
  if (wizardp(this_object()) && query("env/immortal")) return;

  // Clear all the conditions by death.
  this_object()->clear_condition();
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());

  this_object()->dismiss_team();

  COMBAT_D->announce(this_object(), "dead");                      // 死亡

  if (objectp(killer = query_temp("last_damage_from"))) {
    if (environment(this_object())->query("valid_fight")
      && userp(this_object()) && userp(killer))
      return;

    set_temp("my_killer", killer->query("id"));
    COMBAT_D->killer_reward(killer, this_object());
  }

  if (this_object()->query("eatable"))
    (new((string)this_object()->query("afterdie")))->move(environment());
  else if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
    corpse->move(environment());

  if (userp(this_object())) {
    set("gin", 1); set("eff_gin", 1);
    set("kee", 1); set("eff_kee", 1);
    set("sen", 1); set("eff_sen", 1);
    ghost = 1;
    this_object()->save();
    this_object()->move(DEATH_ROOM);
    DEATH_ROOM->start_death(this_object());
  } else
    destruct(this_object());
}

// 复活....将物件的ghost 标记去掉。身体的各项状态值设为上限。
void reincarnate() {
  //    修改可能引起的BUG       buy fan     
  if (ghost) {
    ghost = 0;
    set("eff_gin", query("max_gin"));
    set("eff_kee", query("max_kee"));
    set("eff_sen", query("max_sen"));
    if ((int)query("gin") < 0) set("gin", 0);
    if ((int)query("kee") < 0) set("kee", 0);
    if ((int)query("sen") < 0) set("sen", 0);
  }
}

// 返回最大食物数量
int max_food_capacity() { return query_weight() / 200; }

// 返回最大饮水数量
int max_water_capacity() { return query_weight() / 200; }

// 恢复所有状态：gin、kee、sen、fp、mp、ap....
int heal_up() {
  int update_flag, i;
  mapping my;

  // Micro: 打人时不可恢复
  if (this_object()->is_fighting()) return -1;

  update_flag = 0;

  my = query_entire_dbase();

  if (my["water"] > 0) { my["water"] -= 1; update_flag++; }
  if (my["food"] > 0) { my["food"] -= 1; update_flag++; }

  // 如饮水不足，则不能恢复所有的状态（gin, kee, sen）
  // Micro: 如果使用饮水或者食物任一不足都立即返回而不恢复任何值的处理方法，会是不合理的。
  //        原因是，水当然是最必须的，但通过运功通常可以临时解决食物问题。
  if (my["water"] < 1 && userp(this_object())) return update_flag;

  my["gin"] += my["con"] / 3 + my["atman"] / 10;
  if (my["gin"] >= my["eff_gin"]) {
    my["gin"] = my["eff_gin"];
    if (my["eff_gin"] < my["max_gin"]) { my["eff_gin"]++; update_flag++; }
  } else update_flag++;

  my["kee"] += my["con"] / 3 + my["force"] / 10;
  if (my["kee"] >= my["eff_kee"]) {
    my["kee"] = my["eff_kee"];
    if (my["eff_kee"] < my["max_kee"]) { my["eff_kee"]++; update_flag++; }
  } else update_flag++;

  my["sen"] += my["con"] / 3 + my["mana"] / 10;
  if (my["sen"] >= my["eff_sen"]) {
    my["sen"] = my["eff_sen"];
    if (my["eff_sen"] < my["max_sen"]) { my["eff_sen"]++; update_flag++; }
  } else update_flag++;

  // 如食物不足，则不能恢复所有的状态（atman, force, mana）
  if (my["food"] < 1 && userp(this_object())) return update_flag;

  if (my["max_atman"] && my["atman"] < my["max_atman"]) {
    my["atman"] += (int)this_object()->query_skill("magic", 1) / 2;
    if (my["atman"] > my["max_atman"]) my["atman"] = my["max_atman"];
    update_flag++;
  }

  if (my["max_force"] && my["force"] < my["max_force"]) {
    my["force"] += (int)this_object()->query_skill("force", 1) / 2;
    if (my["force"] > my["max_force"]) my["force"] = my["max_force"];
    update_flag++;
  }

  if (my["max_mana"] && my["mana"] < my["max_mana"]) {
    my["mana"] += (int)this_object()->query_skill("spells", 1) / 2;
    if (my["mana"] > my["max_mana"]) my["mana"] = my["max_mana"];
    update_flag++;
  }
  return update_flag;
}

// 睡眠程序
void sleep() {
  object me, env, *inv, *list;
  int i, j, fight_flag, magic_flag;

  if (!living(this_object())) return;

  if (this_object()->query_temp("sleeping") == 1) return;

  magic_flag = 0;
  /*
        env=environment(this_object());
        fight_flag=env->query("no_fight");
        magic_flag=env->query("no_magic");
        if(!fight_flag) env->set("no_fight",1);
        if(!magic_flag) env->set("no_magic",1);
*/
  this_object()->set_temp("sleeping", 1);
  this_object()->remove_all_enemy();
  // this_object()->disable_commands();
  this_object()->disable_player(" <沉睡中>");

  // 加入睡觉的效果：当一个房间中不同性别的人睡觉时....
  if (environment(this_object())->query("valid_sleep")) {

    me = this_object();
    env = environment(me);
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == me) continue;
      if (inv[i]->is_corpse()) continue;
      if (!inv[i]->is_character()) continue;
      if (inv[i]->query_temp("sleeping")
        && inv[i]->query("gender") != me->query("gender")) {
        if (stringp(me->query("marry"))) {
          if (me->query("marry") == (string)inv[i]->query("id"))
            message_vision(HIM "$N用手轻轻地拥着$n睡着了。\n" NOR, me, inv[i]);
          else
            message_vision(HIR "突然有人大喝一声：$N！婚外偷情是犯法的！\n" NOR, me);
        } else message_vision(HIR "突然有人大喝一声：$N！未婚同居是犯法的！\n" NOR, me);

      }
    }
  }

  // set_temp("block_msg/all", 1);

  call_out("wakeup", 5);          // 睡觉时间：5秒

  return;
}

// 睡眠醒来
void wakeup() {
  object me, env, *inv;
  int i, flag;

  me = this_object();
  remove_call_out("wakeup");
  while (environment()->is_character()) me->move(environment(environment()));

  me->delete_temp("sleeping");
  me->enable_player();
  me->enable_commands();
  /*
        env=environment(me);
        if(!fight_flag) env->set("no_fight",0);
        if(!magic_flag) env->set("no_magic",0);
*/
  // 加入睡觉的效果：一个房间只有最后睡眠的人（最多两人）有效....
  if (environment(me)->query("valid_sleep")) {
    env = environment(me);
    inv = all_inventory(env);
    flag = 0;
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == me) continue;
      if (inv[i]->is_corpse()) continue;
      if (!inv[i]->is_character()) continue;
      if (inv[i]->query_temp("sleeping")) flag++;
    }
  } else flag = 1;                          // 当不在可睡觉的房间中（用睡袋），则设置为只有一人睡觉。

  if (flag <= 1) {
    me->set("gin", me->query("eff_gin"));
    me->set("kee", me->query("eff_kee"));
    me->set("sen", me->query("eff_sen"));
    if (me->query("eff_atman") > me->query("atman"))
      me->add("atman", (me->query("eff_atman") - me->query("atman")) / 2);
    if (me->query("eff_force") > me->query("force"))
      me->add("force", (me->query("eff_force") - me->query("force")) / 2);
    if (me->query("eff_mana") > me->query("mana"))
      me->add("mana", (me->query("eff_mana") - me->query("mana")) / 2);
  } else
    printf(HIC "对不起，一个房间最多只能睡两个人。\n" NOR);

  // set_temp("block_msg/all", 0);
  message_vision("$N一觉醒来，活动了几下筋骨，整个人看起来精神了很多。\n", me);

  return;
}
