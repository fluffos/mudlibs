#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(RED+"新年礼包"+NOR, ({"giftbox",}));
    set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个不大的新年礼包，包装得实在太精美了，上面写着你的名字，你恨不得马上打开(dakai)看看里面是什么。\n");
    set("value", 1);
    set("no_drop", "这样的好东西你也到处乱扔？！\n");
    set("no_get", "你费了很大的力气试图捡起来，可就是捡不起来。\n");
  }
    setup();
}
void init()
{
    add_action("do_dakai", "dakai");
}
int do_dakai(string arg)
{
    object me = this_player();
    
  if (!id(arg))  return notify_fail("你要打开什么？\n");
  if ((int) me->query("giftbox") == 2) 
   message_vision(HIC "$N小心翼翼地打开了新年礼包，等待着身体发生变化，不料一阵烟雾过去，什么感觉也没有，\n而且新年礼包也不见了（看来这个不是属于自己的）\n" NOR,me);
  else { 
   me->add("combat_exp", 15000000);
   me->add("max_neili", 750000);
   me->add("max_jingli", 380000);
   me->add("dex", 100);
   message_vision(HIC "$N小心翼翼地打开了新年礼包，一阵紫色的烟雾过去，浑身好不自在，彷佛升仙了一样，\n$N的内力增加了75w，精力增加了38w，经验增加了1500w，先天身法也提高了100点，\n高兴地$N跳了起来，过新年真好。\n" NOR, me);
   me->set("giftbox", 2);
  }
   destruct(this_object());
   return 1;
}
void owner_is_killed() { destruct(this_object()); }
int query_autoload() { return 1; }