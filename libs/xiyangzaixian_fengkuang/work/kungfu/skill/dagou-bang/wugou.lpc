#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  string msg;
  if (!me->is_fighting())
    return notify_fail("「" HIM + "「天下无狗」" + HIC "」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
    return notify_fail("你使用的武器不对。\n");
  if (!wizardp(this_player()) && (me->query("family/family_name") != "丐帮"))
    return notify_fail("天下无狗是丐帮弟子作用的绝招,你不是丐帮弟子,不能使用此绝技.\n");
  if ((int)me->query_str() < 50)
    return notify_fail("你的臂力不够, 还不能使用这项绝技! \n");
  if ((int)me->query_skill("dagou-bang", 1) < 300)
    return notify_fail("你的打狗棒法的火候还不到家, 不能使用这一绝技 !\n");
  if (me->query_skill_mapped("force") != "huntian-qigong")
    return notify_fail("你没有激发混天气功，无法施展「" HIM + "「天下无狗」" + HIC "」。\n");
  if ((int)me->query_skill("huntian-qigong", 1) < 300)
    return notify_fail("你的混天气功的修为不够, 不能使用这一绝技 !\n");
  if ((int)me->query("neili") < 20000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("max_neili") < 20000)
    return notify_fail("你的内力修为不够！\n");
  msg = HIB "\n$N手中兵器幻出一股光芒，光芒如实质般劈天盖地般攻向对方!\n" NOR;
  message_vision(msg, me);
  me->clean_up_enemy();
  ob = me->select_opponent();
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  me->add("neili", -random(4500) - 500);
  me->start_busy(3 + random(1));
  return 1;
}
