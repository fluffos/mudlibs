// sanqing.c 一剑化三清

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;
  if (!target) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("「乱打」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query_skill("dagou-bang", 1) < 80)
    return notify_fail("你的你的打狗棒法不够娴熟，不会使用「乱打」！\n");


  msg = YEL "$N心中一急,没头没脑的向前面打了出去,但正是打狗棒法的精要之所在！" NOR;
  message_vision(msg, me);

  me->add_temp("apply/attack", (int)me->query_skill("dagou-bang", 1) / 2);

  msg = WHT "打狗脚！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "击狗身！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = RED "断狗头！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->add_temp("apply/attack", -(int)me->query_skill("dagou-bang", 1) / 2);

  me->add("neili", -300);
  me->start_busy(2);

  return 1;
}
