// xunfu-jianfa.c 驯夫剑法

inherit SKILL;

mapping *action = ({
([      "action":"$N使一式"HIR"妇唱夫随"NOR"，手中$w金光闪烁，幻成无数棍棒刺向$n的$l",
        "force" : 30,
        "dodge" : 10,
        "damage": 100,
        "lvl" : 0,
        "skill_name" : "妇唱夫随",
        "damage_type":  "刺伤"
]),
([      "action":"$N嫣然一笑，使出"HIY"一笑倾城"NOR"，剑气袅绕，$w轻轻地向$n的$l拂去",
        "force" : 40,
        "dodge" : 10,
        "damage": 150,
        "lvl" : 9,
        "skill_name" : "一笑倾城",
        "damage_type":  "割伤"
]),
([      "action":"$N一式"HIG"再笑倾国"NOR"，纵身飘开数尺，运发剑气，手中$w遥遥指向$n的$l",
        "force" : 60,
        "dodge" : 50,
        "damage" : 200,
        "lvl" : 18,
        "skill_name" : "再笑倾国",
        "damage_type":  "割伤"
]),
([      "action":"$N身影再起，一式"HIM"三笑倾天下"NOR"，手中长剑飘忽，吹向$n的$l",
        "force" : 80,
        "dodge" : 90,
        "damage": 250,
        "lvl" : 27,
        "skill_name" : "三笑倾天下",
        "damage_type":  "割伤"
]),
([      "action":"$N手中$w中宫直进，一式"HIR"奸夫淫妇"NOR"，无声无息地对准$n的$l刺出一剑",
        "force" : 100,
        "dodge" : 120,
        "damage": 300,
        "lvl" : 36,
        "skill_name" : "奸夫淫妇",
        "damage_type":  "刺伤"
]),
([      "action":"$N手中$w斜指苍天，独立寒秋，一式"HIG"浪子回头"NOR"，从$n的$l轻轻拂过",
        "force" : 110,
        "dodge" : 150,
        "damage": 350,
        "lvl" : 44,
        "skill_name" : "浪子回头",
        "damage_type":  "刺伤"
]),
([      "action":"$N昂首青天，右手$w逼出丈许雪亮剑芒，一式"HIC"回头是岸"NOR"刺向$n的$l",
        "force" : 120,
        "dodge" : 200,
        "damage": 400,
        "lvl" : 52,
        "skill_name" : "回头是岸",
        "damage_type":  "刺伤"
]),
([      "action":"$N犹如"HIR"河东狮吼"NOR",只见"HIY"漫天"NOR""HIC"愁云惨淡"NOR",突然一道"HIM"闪电"NOR"击中$n,$n顿时"HIG"两眼无神"NOR",浑身战栗",
        "force" : 180,
        "dodge" : 250,
        "damage": 900,
        "lvl" : 150,
        "skill_name" : "驯夫",
        "damage_type":  "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ( me->query("gender") != "女性")
       return notify_fail("相传驯夫剑法乃大神狐狸箱子专为女性而设,从无男子练习!\n");
        if ((int)me->query("max_neili") < 500)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("bahuang-gong", 1) < 120)
                return notify_fail("你的八皇六合神功火候太浅。\n");
if ((int)me->query_skill("xunfu-jianfa", 1) >= (int)me->query_skill("sword",1))	
return notify_fail("你的基础不够.\n");	
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("xunfu-jianfa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;
        if ( me->query("gender") != "女性")
        return notify_fail("相传驯夫剑法乃大神狐狸箱子专为女子所设,从无男子练习!\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query_skill("bahuang-gong", 1) < 420)
                return notify_fail("你的八皇六合神功火候太浅。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练移风剑法。\n");
        me->receive_damage("qi", 25);
        return 1;
}
