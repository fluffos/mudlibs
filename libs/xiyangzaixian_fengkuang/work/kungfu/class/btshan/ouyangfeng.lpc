///ouyangfeng.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
    set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
    set("long", "他是白驼山庄主，号称“西毒”的欧阳锋。\n"
           +"由于习练「九阴真经」走火入魔，已变得精\n"
           +"神错乱，整日披头散发。\n");
    set("title", "老毒物");
    set("gender", "男性");
    set("age", 53);
    set("nickname", HIR "西毒" NOR);
    set("shen_type",-1);
    set("attitude", "peaceful");
    set("str", 1000);
    set("int", 700);
    set("con", 500);
    set("dex", 1000);
    set("qi", random(10000));
    set("max_qi", 5000000);
    set("max_jing", 5000000);
    set("neili", 90000000);
    set("max_neili", 9000000);
    set("jingli", 9000000);
    set("max_jingli", 100000);
    set("jiali", 50000);
    set("combat_exp", 680000000);
//    set("score", 200000);
    set_skill("force", 3900);
    set_skill("unarmed", 3900);
     set_skill("dodge", 3600);
      set_skill("parry", 3900);
     set_skill("staff", 4000);
     set_skill("hamagong", 3900);
     set_skill("chanchu-bufa",3870);
      set_skill("shexing-diaoshou",3800);
      set_skill("lingshe-zhangfa",4000);
     map_skill("force", "hamagong");
    map_skill("dodge", "chanchu-bufa");
    map_skill("unarmed", "shexing-diaoshou");
    map_skill("parry", "lingshe-zhangfa");
    map_skill("staff", "lingshe-zhangfa");
    create_family("白驼山派",1, "开山祖师");
        set("chat_chance",2);
        set("chat_msg",({
         "欧阳锋自言自语道：何日白驼山派才能重霸江湖呢…\n",
         "欧阳锋道：我儿欧阳克必能够重振白驼山派雄风！\n",
         "欧阳锋道：江湖险恶，困难重重哪！\n",
        }));
    setup();
    carry_object("/clone/weapon/gangzhang")->wield();
    carry_object("/clone/misc/cloth")->wear();
    add_money("silver",50);
}
void attempt_apprentice(object ob)
{
  if((int)ob->query("combat_exp")<350000000)
        {
          message_vision("欧阳锋对$N笑道：你的经验太低了,我还不能收你！\n",ob);
    return ;
         }
   message_vision("欧阳锋拍拍$N的头，微微点了点头。\n",ob);
   command("recruit " + ob->query("id"));
   return;
}
