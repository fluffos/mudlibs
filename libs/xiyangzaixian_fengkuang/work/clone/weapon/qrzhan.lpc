//tulong.c

#include <weapon.h>
inherit BLADE;

void create()
{
set_name( HIM"千" HIY"人" HIR"斩"NOR, ({ "qianren zhan", "qianren","zhan","dao" }) );	
set_weight(25000);
if( clonep() )
set_default_object(__FILE__);
else {
set("unit", "柄");
set("weapon_prop/strength", 500);
set("weapon_prop/karma", 500);
set("weapon_prop/dodge", 500);
set("weapon_prop/blade", 500);
set("weapon_prop/constitution", 500); 
set("value", 5000000);	
set("material", "iron");
set("long", "传说中的神兵利器,上面刻着四个大字-惟我独尊。\n" );
set("wield_msg",HIR"$N轻念一声：“惟我独尊。”冷哼一声：“天下无双。”手中多了一把漆黑的大刀，这刀，在日光下轻轻扭曲，似乎竟然有了生命一般！
"NOR+"\n"NOR);	
set("unwield_msg", HIM"$N将$n"+HIG"回归鞘内，华光敛尽，日光散去，晴空万里，你心头一松，暗呼：“好险！”也许是精神太紧张了，你竟然一下晕了过去。"NOR+"\n"NOR);
}
init_blade(5000,4);	
setup();
}
int query_autoload() { return 1; }	
