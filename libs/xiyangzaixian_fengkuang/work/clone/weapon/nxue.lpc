#include <weapon.h>

inherit SWORD;
#include <ansi.h>

void create()
{
set_name(HIR"凝血"NOR, ({ "ning xue", "xue","ning", "sword" }) );
set_weight(10000);
if( clonep() )
set_default_object(__FILE__);
else {
set("weapon_prop/karma", 300);
set("weapon_prop/intelligence", 300);
set("weapon_prop/strength", 200);
set("unit", "把");
set("value", 10000000);	
set("material", "steel");
set("long", "传说此剑凝聚了无数条人命,阳光照耀下竟然发出一股隐隐的煞气！\n");
set("wield_msg", HIM"$N一挥手,空气之中突然煞气大盛,$N手中多了一把血色长剑\n"
HIG"你轻叹一声，随手轻轻一挥，一股冷洌的杀气扑面而来，手中多了一支若有若无的奇形长剑 \n"
HIR"细长的剑身幽幽的晃动着，剑尖不经意间闪现出一点血色。\n"NOR);
set("unwield_msg", HIC "$N手中的$n" HIC"忽然消失不见。空气之中煞气蓦然消失，你不禁长叹了口气!\n"NOR);
} 

init_sword(2500,2);	
setup();
}
int hit_ob(object me,object victim,int damage_bonus)
{
victim->apply_condition("wuxing_poison", 200);
victim->start_busy(1);
return damage_bonus;
}
void init()	
{	
if(this_player()!=environment())	
add_action("do_get","get");	
}	
int do_get(string arg)	
{	
object me=this_player();	
object ob=this_object();	
string place;	
if(environment(ob)->query("short"))	
place = environment(ob)->query("short");	
else place = "一个不为人知的地方";	
if(arg=="huolin jian"){                  		
if(ob->move(me))	
message("channel:rumor",HIW"\n〖江湖传闻〗：凝血出世，天下大乱之势成矣！\n\n"NOR,users());        	
me->add("jing",-(me->query("max_jing")/3));
me->set("neili",0);
return 1;	
}	
return 0;	
}	
int query_autoload() { return 1; }
