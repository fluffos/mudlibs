// buyun.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(YEL "步云履" NOR, ({ "buyun lv", "buyun", "lv" })
  );
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "双");
    set("long", "据说是当年齐天大圣孙悟空的宝贝,得自东海龙宫。\n");
    set("value", 10000000);
    set("armor_prop/dodge", 1000);
    set("armor_prop/karma", 1000);
    set("armor_prop/constitution", 500);
    set("armor_prop/intelligence", 200);
    set("armor_prop/dexterity", 2000);
    set("armor_prop/personality", 50);
    set("armor_prop/armor", 50000);
    set(
      "wear_msg",
      CYN "$N双足一顿,脚上自动出现一双$n," CYN "脚底闪过一道" HIY "七彩光华，刹那间" HIB "$N顿觉" HIC "全身轻松无比，" HIY "顿时" GRN "乘风而去。\n" NOR
    );
    set("remove_msg", GRN "身影一摇，$n顿时不见踪影。\n" NOR);
  }
  setup();
}
int query_autoload() { return 1; }
