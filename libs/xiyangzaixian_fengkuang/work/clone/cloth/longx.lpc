// bye enter

#include <ansi.h>

#include <armor.h>

inherit NECK;

void create()
{
        set_name(HIC "龙翔" NOR, ({ "long xiang", "necklace" }));
        set("weight", 4000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一条刻有飞龙翻滚花纹的项链,据说有特殊的功效。\n");
                set("unit", "条");
                set("value", 15000000);
                set("wear_msg",HIR "天空中猛然传来一阵龙吟,一条巨大的青龙盘桓在空中,猛的向$N冲了下来,$N浑身一颤,竟然发出不可思议的光芒! \n "NOR );
                set("remove_msg", HIM "长空一声霹雳,$N的身影渐渐的显露出来。\n" NOR);
                set("material", "gold");
set("armor_prop/karma", 3);
set("armor_prop/intelligence", 200);
set("armor_prop/dodge", 150);
set("armor_prop/unarmed", 150);
set("armor_prop/parry", 150);
                set("armor_prop/armor", 500);
        }
        setup();
}   
int query_autoload() { return 1; }
