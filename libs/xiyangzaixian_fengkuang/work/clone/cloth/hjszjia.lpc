// huangji suozijia.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIY "黄金锁子甲" NOR, ({ "huangjin suozijia", "huangjin", "suozijia" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "天地之间灵气所凝聚的宝甲,据说当年齐天大圣孙悟空得自东海龙宫的宝贝。\n" NOR);
    set("material", "copper");
    set("unit", "件");
    set("armor_prop/personality", 1000);
    set("armor_prop/karma", 2000);
    set("armor_prop/intelligence", 500);
    set("armor_prop/dodge", 100);
    set("armor_prop/dexterity", 1000);
    set("armor_prop/constitution", 1000);
    set("armor_prop/armor_vs_force", 1000);
    set("value", 1000000000);
    set("wear_msg", CYN "顿时天地色变，平空泛出一片诡异的云气,$N口中念念有词,伸手一指云气中陡然现出一件霞光万道的$n，$n" CYN "轻轻地落在$N肩上。\n"
      HIR "瞬时间天地风云色变，雷电交加，仿佛充满了鬼神莫测的气氛。\n" NOR);
    set("remove_msg", GRN "$N双肩一抖，$n幻化成一片霞雾逐渐消失不见。\n" NOR);
    set("armor_prop/armor", 50000);
  }
  setup();
}
int query_autoload() { return 1; }
