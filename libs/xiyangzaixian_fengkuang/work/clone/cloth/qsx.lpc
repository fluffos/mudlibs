// wudipifeng.c 超级无敌披风

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIM "超级无敌披风" NOR, ({ "wudi pifeng", "wudi", "pifeng" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "传说中神奇的披风。\n");
    set("material", "cloth");
    set("unit", "件");
    set("armor_prop/personality", 50);
    set("armor_prop/karma", 50);
    set("armor_prop/intelligence", 700);
    set("armor_prop/dodge", 50);
    set("armor_prop/unarmed", 50);
    set("armor_prop/sword", 50);
    set("armor_prop/parry", 50);
    set("armor_prop/blade", 50);
    set("armor_prop/taoism", 500);
    set("armor_prop/throwing", 500);
    set("armor_prop/armor_vs_force", 500);
    set("wear_msg", CYN "一阵仙乐缈缭,九天之上走下一位绝世仙子,对着$N伸手一指,一件$n" CYN "笼罩在$N身上。\n"
      HIM "顿时天地为之色变,万千霞光围绕在$N的身边。\n" NOR);
    set("remove_msg", GRN "$N身影一晃，$n幻变成一道霞光消失在远方。\n" NOR);
    set("armor_prop/armor", 5000);
  }
  setup();
}
int query_autoload() { return 1; }
