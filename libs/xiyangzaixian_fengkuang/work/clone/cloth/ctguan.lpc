// hat.c example belt

#include <ansi.h>

inherit EQUIP;

void create()
{
set_name( HIY "冲天冠" NOR, ({ "chongtian guan","chontian","huan","hat" }) );
set_weight(1000);
if( clonep() )
set_default_object(__FILE__);
else {
set("unit", "顶");
set("long", "据说是当年齐天大圣孙悟空的宝贝,得自东海龙宫。\n");
set("value", 5000000);
set("material", "leather");
set("armor_type", "head");
set("armor_prop/personality", 30);
set("armor_prop/constitution", 100);
set("armor_prop/intelligence", 100);
set("armor_prop/dexterity", 2000);
set("armor_prop/karma", 100);
set("armor_prop/armor", 5000);
set("armor_prop/dodge", 500);
set("wear_msg","$N冲天一指,云气间一片扭曲,一顶$n落在$N的头上,$N戴上一顶$n。\n");
set("remove_msg","天空中慢慢恢复了平静,$N轻轻将$n脱了下来。\n");
}
}
int query_autoload() { return 1; }	
