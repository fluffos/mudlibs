//potential dan.c
#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIC "邪神丹" NOR, ({ "xieshen dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗浅蓝色的邪神丹，似乎附着某些特意的邪恶，
有走上邪道的危险，慎用！\n");
    set("value", 50000000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("shen", -50000);
  if (me->query("shen") > -5000000)
    return notify_fail("你杀人无算，为祸人间，不怕天地不容吗!");
  message_vision(HIR "$N吃下一颗邪神丹,$N顿时眼冒邪光！\n" NOR, me);
  destruct(this_object());
  return 1;
}
