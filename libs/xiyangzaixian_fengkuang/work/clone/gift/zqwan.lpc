//potential dan.c
#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIG"正气丸"NOR, ({"zhengqi wan", "wan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是一颗绿色的正气丸，狐狸箱子特意为玩家准备的，
有瞬间提升正气之效。\n");
                set("value", 50000000);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        me->add("shen",50000);
        if (me->query("shen")>5000000)
        return notify_fail("你现在已经威镇江湖了!");
        message_vision(HIR"$N吃下一颗正气丸,$N顿时一股正气回荡心中！\n"NOR,me);
        destruct(this_object());
        return 1;
}
