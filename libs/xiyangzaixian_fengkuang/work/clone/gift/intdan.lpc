//congming dan.c
#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIB "神奇宝贝" NOR, ({ "congming dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗深蓝的神奇宝贝，狐狸箱子特意为玩家准备的，
据说有神奇的作用。\n");
    set("value", 10000000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("int") > 1000) {
    tell_object("你聪明绝顶,还要这个干吗啊?!");
    message_vision(HIR "适可而止,太贪心小心遭雷劈哦！\n" NOR, me);
    return 1;
  } else
    message_vision(HIR "$N吃下一颗神奇宝贝,$N的眼睛一亮,更聪明了！\n" NOR, me);
  destruct(this_object());
  me->add("int", 100);
  return 1;
}
