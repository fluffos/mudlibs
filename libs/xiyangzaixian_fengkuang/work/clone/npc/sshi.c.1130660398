#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"阿奇门罗丝亚"NOR, ({ "shen shi", "shi","shen" }) );
          set("nickname", HIY"神使"NOR);
        set("gender", "男性" );
        set("age", 88);
         set("long", YEL"据说他是大神亚苏拉第的使者，掌握了可以让人重生的秘密。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "重生" : (: ask_me :)
        ]));
        setup(); 
carry_object("/clone/cloth/qiankun")->wear();
carry_object("/clone/cloth/hjszjia")->wear();
carry_object("/clone/cloth/ctguan")->wear();
carry_object("/clone/cloth/bylv")->wear();
}

void die()
{
        message_vision("抱歉，我是不会死的。\n",this_object());
          return ;
}


string ask_me()
 {
        object me = this_player();

              if ((int) me->query("money")< 0)
                    return "你的钱庄存款不够！";
             if ((int) me->query("potential")< 2000000)
                  return "你的潜能不够！";
             if ((int) me->query("max_neili")< 5000000)
                  return "你的内力不够！";
              if ((int) me->query("max_jingli")< 3000000)
                  return "你的精力不够！";
             if ((int) me->query("combat_exp")< 1000000000)
                  return "你的经验不足以重生,还是先去历练一番罢！";
               else
        {
                             me->add("potential",- 2000000);
               me->set("shen", 0);
                  me->add("money",- 1000000000);
                  me->add("combat_exp",- 1000000000);
                  me->add("max_neili",- 5000000);
                  me->add("neili",- 5000000);
                  me->add("max_jingli",- 3000000);
me->add("birthday", 1)
                  me->add("jingli",- 3000000);
                  me->add("int", 100);
                  me->add("str", 100);
                  me->add("con", 100);
                  me->add("dex", 100);
                  me->add("kar", 100);
                  me->add("per", 100);
   me->start_busy(5);
      tell_object(this_player(),HIR "你突然感觉到一种莫名其妙的感觉！\n"NOR);;
      tell_object(this_player(),HIR "你的悟性提升了！\n"NOR);;
      tell_object(this_player(),HIR "你的身法更加灵活了！\n"NOR);;
      tell_object(this_player(),HIR "你的根骨更加优秀了！\n"NOR);;
      tell_object(this_player(),HIR "你的身体更加强壮了！\n"NOR);;
      tell_object(this_player(),HIR "你的运气更加好了！\n"NOR);;
      tell_object(this_player(),HIR "你的容貌更加出众了！\n"NOR);;
                return HIY"无上的大神亚苏拉第啊，你的臣民回来了！\n"NOR
HIC"突然天空中一道"HIY"金光"HIW"笼罩四方，空中出现七个大字"HIM"我以我血荐轩辕"NOR"转瞬即逝！"NOR;
 CHANNEL_D->do_channel(me, "jh", sprintf("在下%s今日得以无上大神亚苏拉第的保佑\n         现已得到重生！", me->name(1)));
        }
}
