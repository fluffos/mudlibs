// 删除指定方向上的房间

#include <group.h>

int main(object me,string arg)
{
	object env, *inv;
	string file, group_file, arg1;

    env = environment(me);
	if( !env )
		return 0;

    file = file_name( env ) + ".lpc";

	if( !me->query("group") )
		return notify_fail( "你并没有加入任何帮派。\n" );

	if( me->query("group/level") < GROUP_VICE_MASTER )
		return notify_fail( "只有副帮主才能删除房间。\n" );

	if( env->query("group") != me->query("group/group") ) 
		return notify_fail("这里不是我派的领地。\n");

	if( !arg )
		return notify_fail("指令格式：grmroom <方向>\n");
	
	if( arg!="north" && arg!="south" && arg!="east" && arg!="west"
		&& arg!="down" && arg!="up" )
		return notify_fail("没有这个方向。\n");

	if( !env->query("exits/"+arg) )
		return notify_fail( "这个方向并没有房间。\n" );
	
	switch (arg) {
	case "east": arg1 ="东面"; break;             
	case "south": arg1="南面"; break;   
	case "west": arg1="西面"; break;         
	case "north": arg1="北面"; break;
	case "down": arg1="下面"; break;
	case "up": arg1="上面"; break;  
	default : break;
	}
	
	file = env->query("exits/"+arg);

	if( load_object(file)->query( "no_delete" ) )
		return notify_fail( "该房间不能被清除。\n" );

	inv = all_inventory( load_object( file ) );
	if( sizeof(inv) )
		return notify_fail( "该房间里还有东西，不能拆房。\n" );

	
	rm( file + ".lpc" );
	env->delete("exits/"+arg);
	group_file = GROUP_D->query_home( me );
	load_object( group_file )->add( "room", -1 );
	GROUP_D->save_group( me );
	GROUP_D->save_room( me, file_name(env) + ".lpc" );
	message_vision( "$N找了几个帮众将"+ arg1 +"的房间拆了。\n", me);
	return 1;
}

int help(object me)
{
write(@HELP
----------------------------------------
指令格式：grmroom <方向>

说明：
　　删除房间。

相关指令：gmkroom

----------------------------------------
HELP
        );
        return 1;
}

