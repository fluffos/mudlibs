#include <armor.h>
#include <ansi.h>

inherit CLOTH;
#include "chk_owner.lpc"

void create()
{
   set_name(HIY"黄金圣衣"NOR, ({ "huangjin shengyi" }) );
   set_weight(10000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
set("no_drop",1);
     set("no_get",1);
      set("no_sell",1);
       set("value",0);
     set("material", "steel");
	 set("armor_prop/personality", 100);
set("armor_prop/karma", 100);
set("armor_prop/intelligence", 1000);
set("armor_prop/dodge", 100);
set("armor_prop/unarmed", 100);
set("armor_prop/sword", 100);
set("armor_prop/parry", 100);
set("armor_prop/blade", 100);
set("armor_prop/taoism", 1000);
set("armor_prop/throwing", 1000);
set("armor_prop/armor_vs_force", 1000);
     set("armor_prop/armor",12000);
  }
   setup();
}
int query_autoload() { return 1; }
