// xuan-cloth.c
//
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("护法袈裟", ({ "jia sha" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
            set("shaolin",1);
                set("material", "cloth");
set("armor_prop/intelligence", 1);	
set("armor_prop/dodge", 1);
set("armor_prop/parry", 1);
                set("armor_prop/armor", 1);
set("bonze_only",1);
        }
        setup();
}
int query_autoload() { return 1; }
