// greyrobe.c 灰色道袍
// By Marz
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(WHT "灰色道袍" NOR, ({
    "pao", "cloth", "dao pao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件看起来不怎么起眼的灰色道袍。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/taoism", 1);
    set("armor_prop/sword", 1);
    set("armor_prop/unarmed", 1);
    set("armor_prop/intelligence", 1);
  }
  setup();
}
int query_autoload() { return 1; }
