// /d/city2/npc/give_book.c 负责送衣服的npc
#define LAST_PAR "sorry"
#define THIS_PAR "sorrysf"
inherit NPC;
string give_cloth();
int ask_mask(string str);	
void create()
{
set_name(HIM"清馨"NOR, ({ "qing xin", "qing","xin"}));    	
set("title", HIY"传奇人生"NOR);	
set("nickname", HIC"梦幻组合"NOR);	
    set("str", 37);
    set("gender", "男性");
    set("age", 14);
set("per",30);
    set("long",
        "这是一个英俊潇洒的年轻人，眼睛里透着莫名的煞气。\n 他专门在这儿负责给新手发放礼物。\n");
    set("combat_exp", 1500);
set("no_get",1);
    set("attitude", "friendly");
    set("inquiry", ([
        "秘籍" : (: give_cloth :),
"book"  :(: give_cloth :),	
"礼物":"在武庙桌子(table)上就有呀，新人可以拿哦~：）\n",      	
"神兵利器"  :(: ask_mask :),	
	]));
    
    setup();
carry_object("/clone/cloth/cloth")->wear();	
//  carry_object("/d/shaolin/obj/qimeigun")->wield();
}

string give_cloth()
{
    object me,obj;	
object zi;	
me = this_player();	
zi=this_object();	
if (me->query("gender")=="无性") obj=new("/d/heimuya/npc/obj/kuihua2");
	   else obj=new("/clone/book/wuming");
	   obj->move(me);
	   command("xixi");
return "有缘何必相识,重宝认主,好好把握吧：）";
}
int ask_mask(string arg)	
{
object me,obj;	
object zi;	
me = this_player();	
zi=this_object();	
if(present("yuenv chaoyang jian", me) || present("yuenv chaoyang jian", environment()))   	
{
command("say 已经有了还想拿,你怎么如此贪得无厌呢?"); 	
return 1;       	
}
if (me->query("age",1) >=18)
{
command("say 老大不小的了,还只会饭来张口,衣来伸手,该学学独立生活了!");	
return 1;	
}
else {  	
message_vision(CYN "清馨凌空一指,顿时空气中杀气大盛，一把奇异软剑扑向$N \n" NOR,me);	    
obj=new("/clone/weapon/yuenv");      	
obj->move(me);	
command("love");  	
return 1;	
}
}
