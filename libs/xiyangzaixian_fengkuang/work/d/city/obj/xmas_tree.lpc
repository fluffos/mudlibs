#include <ansi.h>
inherit ITEM;
void create() {
  set_name(RED + "新年树" + NOR, ({ "tree" }));
  set_weight(500000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "一棵高入云霄的新年树，比大家现实中见过的要高上何止千倍万倍。上面放满了各式各样的礼物，你可以拿（pick giftbox）一个属于自己的新年礼包下来。");
    set("value", 0);
    set("material", "wood");
  }
}
void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object me, obj;
  me = this_player();
  if (!arg || arg != "giftbox") return notify_fail("你要拿什么？\n");
  if ((int)me->query("combat_exp") < 100000000) return notify_fail("你的经验不足，还不能拥有新年礼包！\n");
  if ((int)me->query("get_giftbox") == 2) return notify_fail("属于你的新年礼包只有一个，还要再拿？别造梦了！\n");

  obj = new(__DIR__ "giftbox");
  obj->move(me);
  message_vision(HIG "$N爬上高大的新年树，寻找属于自己的新年礼包，终于找到并拿起了它，然后轻巧的跳了下来，轻功之高，已是叹为观止的境界。\n", me);
  me->set("get_giftbox", 2);
  return 1;
}

int query_autoload() { return 1; }
