inherit ROOM;
void create()
{
set("short", HIM"龙腾天下"NOR);	
        set("long", @LONG
这疯狂江湖的帮会大厅，你如果想成立帮会的话需要到这里来这里
申请，前提是你要有足够的能力跟足够存款，如果你没有的话，很抱歉，
因为天下没有免费的午餐，一位慈祥的老人家坐在中间的椅子上笑眯眯的
看着你，他，就是闻名天下的巧手——鲁班。墙上挂着一个牌子(paizi)。
LONG
        );
          set("no_fight", 1);
        set("valid_startroom", 1);
        set("no_sleep_room",1);
        set("item_desc", ([
                "paizi" : "天下风云出我辈，一入江湖日月摧
皇图霸业笑谈中，不负人间一场醉。\n",
        ]));
        set("objects", ([
                "/d/city/party/party/lu" : 1,
         ]));
        set("no_clean_up",1);
        set("exits", ([
                "south" : __DIR__"ximen",
                     ]));
        setup();
	replace_program(ROOM);
}


