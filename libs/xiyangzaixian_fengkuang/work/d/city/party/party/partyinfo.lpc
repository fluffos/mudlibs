//isle


#include <ansi.h>

inherit F_CLEAN_UP;
int main(object me, string arg)
{
	object ob,obj;
	if ((int)me->query("jing")<50 )
	return notify_fail("你先集中下精神吧! \n");

	if (!arg) return notify_fail("你要查看谁的帮派信息? \n");
	ob = find_player(arg);
        if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要查看谁的帮派信息？\n");
	if ( ob== me) return notify_fail("你连自己入的哪个帮都不记得了? \n");
	if(wizardp(ob) && !wizardp(me)) return notify_fail("巫师你也能查！你以为你是天神呀......\n");
       if (!ob->query("partyname") ) return notify_fail("对方还没有加入帮派吧! \n");
        
	else  
	 tell_object(me, sprintf( BOLD "%s目前所在的帮派是：%s\n" NOR,ob->query("name")+"("+ob->query("id")+")", ob->query("partyname")));

	me->receive_damage("jing", 50 );
	return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : partyinfo [<某人>]
这个指令可以让你得知对方的帮派信息!
HELP
    );
    return 1;
}

