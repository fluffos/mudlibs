int ask_party(string arg)
{
    object me;
    object lu;
    lu=this_object();	
    me=this_player();
    if (me->query("more_money") < 20)   //20 
    {
	command("say 对不起，你的资金不足,买不起地盘。");
	return 1;
    }
    if (me->query("combat_exp") < 1000000000)
    {
	command("say 对不起，你的经验不足,买不起地盘。");
	return 1;
    }
    if (me->query("max_neili") < 10000000)
    {
	command("say 对不起，你的内力不足,买不起地盘。");
	return 1;
    }
    write("请输入帮派英文名称：");	
    input_to("get_partyid", 1, me );	
    return 1;
}
int get_partyid(string str,object me)
{
if( file_size("/d/party/" + str +"/dating.lpc")!=-1 || me->query("partyid",1) )   {                                           
write("该帮派名称已存在或你还没有退出原有的帮派！\n");
return 1;	
}
write("请再次输入你的帮派英文名：");	
input_to("get_new_partyid", 1, me );            	
}
int get_new_partyid(string str,object me)   	
