int get_partyname(string str,object me)	
{
    me->set("partyname",str);	
    me->set("title",me->query("partyname")+"帮主");        	
CHANNEL_D->do_channel(me,"chat",me->query("partyname")+"帮于今日正式成立,本"+RANK_D->query_respect(me)+"荣誉为"+me->query("partyname")+"帮主!\n");                      	
}
