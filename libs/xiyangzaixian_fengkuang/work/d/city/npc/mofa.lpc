#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "大魔导师" NOR, ({ "mofa shizhe", "mofa" }));
  set("nickname", HIY "清神" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是疯狂江湖的大魔导师，你可以ask mofa about 清神。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("max_neili", 1000);
  set("score", 100000);

  set("inquiry", ([
    "清神": (: ask_me :)
  ]));
  setup();
  carry_object("/clone/cloth/qiankun")->wear();
  carry_object("/clone/cloth/hjszjia")->wear();
  carry_object("/clone/cloth/ctguan")->wear();
  carry_object("/clone/cloth/bylv")->wear();
}

void die() {
  message_vision("抱歉，我是不会死的。\n", this_object());
  return;
}


string ask_me() {
  object me = this_player();

  if ((int)me->query("money") < 0)
    return "你的钱庄存款不够！";
  if ((int)me->query("potential") < 0)
    return "你的潜能不够！";
  else {
    me->add("potential", -0);
    me->set("shen", 0);
    me->add("money", -0);
    me->start_busy(3);
    tell_object(this_player(), HIR "你突然感觉到一种莫名其妙的感觉！\n" NOR); ;
    return HIY "天神啊！让这个心灵受伤害的人重生吧！\n" NOR HIC "突然天空中一道" HIY "金光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
