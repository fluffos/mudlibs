// libuyi.c 李布衣
inherit NPC;
void create() {
  set_name(HIM "李布衣" NOR, ({ "li buyi", "li", "buyi" }));
  set("title", HIG "一代天骄" NOR);
  set("nickname", HIY "笑看风云" NOR);
  set("gender", "男性");
  set("age", 33);
  set("long", "李布衣是个神秘的人物,似乎江湖阅历丰富无比。\n");

  set("max_qi", 3000000);
  set("qi", 3000000);
  set("max_neili", 3000000);
  set("neili", 3000000);
  set("combat_exp", 600000000);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set_skill("unarmed", 2000);
  set_skill("dodge", 2000);
  set_skill("force", 2000);
  set_skill("parry", 2000);
  set_skill("fyue-quan", 2000);
  map_skill("unarmed", "fyue-quan");
  set_temp("apply/attack", 2000);
  set_temp("apply/defense", 2000);
  setup();
  carry_object("/clone/cloth/qiankun")->wear();
  add_money("silver", 2);
}
