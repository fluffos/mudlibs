// shangguanjinhong.c 李布衣
inherit NPC;
void create()
{
	set_name(HIR"上官金虹"NOR, ({ "shangguan jinhong", "shangguan","jinhong" }));
       set("title",HIM"武林至尊"NOR);
       set("nickname",HIY"雄睨天下"NOR);
 	set("gender", "男性");
	set("age", 33);
	set("long", "金钱帮帮主,自从跟小李飞刀一战失败后,就隐居于世,很少看见他出来走动。/n");
	
      set("max_qi", 20000);
      set("qi", 20000);
      set("max_neili", 200000);
      set("neili", 200000);
      	set("combat_exp", 400000000);
	set("shen_type", 0);
	set("attitude", "peaceful");
	
	set_skill("unarmed", 600);
	set_skill("dodge", 600);
       set_skill("force", 600);
       set_skill("parry", 600);
       set_skill("qishang-quan", 600);
       map_skill("unarmed", "qishang-quan");
	set_temp("apply/attack", 2000);
	set_temp("apply/defense", 2000);
	setup();
	carry_object("/clone/cloth/qiankun")->wear();
	add_money("silver",2);
}
