// jiaotou.c 教头
inherit NPC;
void create()
{
	set_name(HIG"教头"NOR, ({ "jiao tou", "jiao" }));
	set("gender", "男性");
	set("age", 33);
	set("long", "一位江湖奇人,江湖阅历丰富,如果你跟他切磋(fight)会有意想不到的好处。\n");
	
	set("combat_exp", 100000000);
	set("shen_type", 0);
	set("attitude", "peaceful");
	
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);
	setup();
	carry_object("/clone/misc/hic_cloth")->wear();
       add_money("silver",2);
}
