//qingqing.c 青青
// shilling 97.2
inherit NPC;
inherit F_MASTER;
//void attempt_apprentice(object ob);
int ask_me();
void create()
{
    set_name(HIC"青青"NOR, ({ "qing qing", "qing" }));
    set("title",HIM"新手导师"NOR);
    set("nickname",HIR"随我疯狂"NOR);
    set("long", 
        "站在你面前的是个怯生生的小姑娘,可是她确实是江湖第一高手哦。\n");
    set("gender", "女性");
    set("age", 18);
    set("attitude", "peaceful");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
        set("inquiry", ([
        "疗伤" : (:ask_me:),
    ]) );
    
    set("max_qi", 750000);
    set("max_jing", 60000);
    set("neili", 10000000);
    set("max_neili", 3000000);
    set("jingli", 1000000);
    set("max_jingli", 1000000);
    set("jiali", 10000);
    set("combat_exp", 1500000000);

    set_skill("force", 2000);
    set_skill("dodge", 2000);
    set_skill("unarmed",2000);
    set_skill("parry", 2000);
    set_skill("sword",2000);
    set_skill("blade",2000);
    set_skill("kuihua-dafa",2000);
    set_skill("kuihua-xinfa",2000);
    set_skill("kuihua-feiying",2000);
    set_skill("literate",2000);
    set_skill("qimen-flee",2000);
    set_skill("throwing",2000);
    set_skill("mantianhuayu",2000);
    set_skill("piaomiao-shenfa",2000);
    set_skill("beiming-shengong",2000);
    set_skill("wuhu-duanmendao",2000);
    set_skill("huagong-dafa",2000);
    set_skill("zhemei-shou", 2000);
    set_skill("qufeng", 2000);
        map_skill("unarmed", "zhemei-shou");
    map_skill("dodge", "kuihua-piaoying");
    map_skill("blade", "wuhu-duanmendao");
    map_skill("throwing", "mantianhuyu");
    map_skill("sword", "shedao-qigong");
    map_skill("force", "kuihua-xinfa");
set("chat_chance",6);
    set("chat_msg", ({
                "青青冲你微微一笑\n",
                "青青手抚长剑,落寞的叹了口气！。\n",
                (: command("'") :),
                (: command("unwield dao"):),
                (: command("unwield jian"):),
                (: command("wield dao"):),
                (: command("wield jian"):),
                }) );
    prepare_skill("unarmed","zhemei-shou");
    prepare_skill("sword","shedao-qigong");
    prepare_skill("dodge","kuihua-feiying");
    prepare_skill("blade","wuhu-duanmendao");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.kuihuashenzhang" :),
                (: perform_action, "unarmed.duo" :),
                (: perform_action, "blade.duan" :),
                (: exert_function, "recover" :),
                (: exert_function, "refresh" :),
                }) );

    create_family("逍遥派", 3, "弟子");
    setup();
    carry_object("clone/cloth/zixuan")->wear();	
carry_object("clone/cloth/lingyun")->wear();     	
carry_object("clone/cloth/fengting")->wear();    
carry_object("d/flypproom/wuping/baiyushouzhuo")->wear(); 
carry_object("d/flypproom/wuping/tianmojie")->wear();	
	carry_object("clone/cloth/qiankun")->wear();
carry_object("d/gumu/obj/xuantiejian")->wield();	
carry_object("clone/weapon/tulong")->wield();          

}
void attempt_apprentice(object ob)
{
    command("say 好吧，我就收下你了，以后要多为逍遥派出力啊。");
    command("recruit " + ob->query("id"));
ob->set("class","shaman");
 }
int ask_me()
{
    object ob;
    ob=this_player();
        if (ob->query("family/family_name") != "逍遥派")
        return notify_fail("你不是我派弟子，我不可以为你疗伤。\n");
    if ((int)ob->query("eff_qi") == (int)ob->query("max_qi"))
    {
        command("?"+ob->query("id"));     
        command("say 你没有受任何伤啊？\n");
        return 1;
    }
    else
    {
        message_vision(HIR"青青用手一指$N,忽然一道金光笼罩着$N的全身。\n"NOR, ob);
        remove_call_out("recover");
        call_out("recover",2,ob);
        return 1;
    }
}

int recover(object ob)
{
    ob->set("eff_qi", (int)ob->query("max_qi"));
    ob->set("eff_jing", (int)ob->query("max_jing"));  
    message_vision(HIY"忽然晴空霹雳,$N顿时全身发出耀眼的光芒。\n"NOR,ob);
    command("say 你的伤势已经全好了,可以走啦。\n");
    return 1;
}
