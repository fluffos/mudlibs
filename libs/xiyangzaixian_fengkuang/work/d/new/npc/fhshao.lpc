// fanghenshao.c 方恨少
inherit NPC;
void create()
{
	set_name(HIG"方恨少"NOR, ({ "fang henshao", "fang","henshao" }));
       set("title",HIM"浪迹天涯"NOR);
       set("nickname",HIY"孤独一生"NOR);
 	set("gender", "男性");
	set("age", 33);
	set("long", "大侠方恨少,仗剑走江湖。十步杀一人，千里不留行。\n");
	
      set("max_qi", 30000);
      set("qi", 30000);
      set("max_neili", 30000);
      set("neili", 30000);
      	set("combat_exp", 600000000);
	set("shen_type", 0);
	set("attitude", "peaceful");
	
	set_skill("unarmed", 800);
	set_skill("dodge", 800);
       set_skill("force", 800);
       set_skill("parry", 800);
       set_skill("zhemei-shou", 800);
       map_skill("unarmed", "zhemei-shou");
	set_temp("apply/attack", 2000);
	set_temp("apply/defense", 2000);
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	add_money("silver",2);
}
