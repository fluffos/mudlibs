//xiaosi.c 小四
// shilling 97.2
inherit NPC;
inherit F_MASTER;
//void attempt_apprentice(object ob);
int ask_me();
void create() {
  set_name(HIC "小四" NOR, ({ "xiao si", "xiao", "si" }));
  set("title", HIG "听雨轩" NOR);
  set("nickname", HIM "开山祖师" NOR);
  set("long",
    HIG "武林神话的开创者,是正义与邪恶的评裁者,据说其功夫已达到天仙的地步！劝你最好别招惹他，不然后果可是很严重的。。。 也是变态与色魔的化身,据说是武林的摧花圣手,各位MM注意了啊!   \n");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("str", 100);
  set("int", 100);
  set("con", 100);
  set("dex", 100);
  set("inquiry", ([
    "疗伤": (: ask_me :),
  ]));

  set("max_qi", 5000000);
  set("max_jing", 5000000);
  set("neili", 90000000);
  set("max_neili", 9000000);
  set("jiali", 50000);
  set("combat_exp", 1900000000);

  set_skill("force", 4500);
  set_skill("dodge", 4500);
  set_skill("yunu-xinjing", 4500);
  set_skill("fyue-quan", 4500);
  set_skill("xuantie-jianfa", 4500);
  set_skill("unarmed", 4500);
  set_skill("parry", 4500);
  set_skill("sword", 4500);
  set_skill("blade", 4500);
  set_skill("literate", 4500);
  set_skill("qimen-flee", 4500);
  set_skill("taoism", 4500);
  set_skill("piaomiao-shenfa", 4500);
  set_skill("taixuan-gong", 4500);
  set_skill("qishen-dao", 4500);
  set_skill("taixuan-gong", 4500);
  set_skill("anranxiaohun-zhang", 4500);
  set_skill("killsword", 4500);
  set_skill("qufeng", 4500);
  map_skill("parry", "anranxiaohun-zhang");
  map_skill("dodge", "piaomiao-shenfa");
  map_skill("taoism", "qimen-flee");
  map_skill("blade", "qishen-dao");
  map_skill("unarmed", "anranxiaohun-zhang");
  map_skill("sword", "killsword");
  map_skill("force", "taixuan-gong");
  set("chat_chance", 6);
  set("chat_msg", ({
    "小四抬头看了你一眼，露出一副淫笑的样子\n",
    "小四长叹一声，女人那,好东西啊！。\n",
    (: command("'") :),
    (: command("unwield dao") :),
    (: command("unwield jian") :),
    (: command("wield dao") :),
    (: command("wield jian") :),
  }));
  prepare_skill("unarmed", "anranxiaohun-zhang");
  prepare_skill("sword", "killsword");
  prepare_skill("blade", "qishen-dao");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xiaohun" :),
    (: perform_action, "sword.tianxie" :),
    (: perform_action, "unarmed.xiaohun" :),
    (: perform_action, "blade.duoming" :),
    (: exert_function, "recover" :),
    (: exert_function, "refresh" :),
  }));
  create_family("杀手楼", 2, "弟子");
  setup();
  carry_object("clone/cloth/hjszjia")->wear();
  carry_object("clone/cloth/bylv")->wear();
  carry_object("clone/cloth/ctguan")->wear();
  carry_object("d/flypproom/wuping/baiyushouzhuo")->wear();
  carry_object("d/flypproom/wuping/tianmojie")->wear();
  carry_object("clone/cloth/qiankun")->wear();
  carry_object("/clone/weapon/qrzhan");
  carry_object("clone/weapon/huolin");

}
void attempt_apprentice(object ob) {
  if ((int)ob->query("combat_exp") < 300000000) {
    message_vision("小四对$N笑道：你的经验太低了,我还不能收你！\n", ob);
    return;
  }

  command("say 好吧，我就收下你了，以后要多为杀手楼出力啊。");
  command("recruit " + ob->query("id"));
  ob->set("class", "shashou");
}
int ask_me() {
  object ob;
  ob = this_player();
  if (ob->query("family/family_name") != "杀手楼")
    return notify_fail("你不是我派弟子，我不可以为你疗伤。\n");
  if ((int)ob->query("eff_qi") == (int)ob->query("max_qi")) {
    command("?" + ob->query("id"));
    command("say 你没有受任何伤啊？\n");
    return 1;
  } else {
    message_vision(HIR "小四用手一指$N,忽然一道金光笼罩着$N的全身。\n" NOR, ob);
    remove_call_out("recover");
    call_out("recover", 2, ob);
    return 1;
  }
}

int recover(object ob) {
  ob->set("eff_qi", (int)ob->query("max_qi"));
  ob->set("eff_jing", (int)ob->query("max_jing"));
  message_vision(HIY "忽然晴空霹雳,$N顿时全身发出耀眼的光芒。\n" NOR, ob);
  command("say 你的伤势已经全好了,可以走啦。\n");
  return 1;
}
