#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m毒[1;36m王[1;32m掌[35m套[2;37;0m", ({ "asdfg" }));
	set_weight(2025);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一双铁掌。
有毒的[2;37;0m
铁掌缘上刻着一行小字：欧阳抚琴(l11l)
");
	set("value", 700000);
	set("point", 30);
	set("material", "iron");
	set("wear_msg", "毒王出示[2;37;0m\n");
	set("remove_msg", "毒王归隐[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/strike", 10);
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/hand", 10);
	set("armor_prop/armor", 10);

	setup();
}

string long() { return query("long") + item_long(); }
