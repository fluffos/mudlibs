#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m血[1;36m龙[1;32m佛[35m爪[2;37;0m", ({ "ssss" }));
  set_weight(1575);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一套指套。
天地灵物[2;37;0m
指套缘上刻着一行小字：清无(l111l)
");
  set("value", 700000);
  set("point", 30);
  set("material", "iron");
  set("wear_msg", "[1;31m一条血龙从天而降加持在手上[2;37;0m\n");
  set("remove_msg", "[1;31m一条血龙飞天而去[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/finger", 10);
  set("armor_prop/claw", 10);

  setup();
}

string long() { return query("long") + item_long(); }
