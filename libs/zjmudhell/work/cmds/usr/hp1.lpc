
#include <ansi.h>
 
inherit F_CLEAN_UP;

string status_color(int current, int max);
 
int main(object me, string arg)
{
	object ob;
	mapping my;
	string sp;

	seteuid(getuid(me));
	ob = me;
 
	my = ob->query_entire_dbase();

	if (userp(ob) && (! stringp(my["born"]) || ! my["born"]))
		return notify_fail("还没有出生呐，察看什么？\n");

	if (my["max_jing"] < 1 || my["max_qi"] < 1)
		return notify_fail("无法察看" + ob->name(1) + "的状态。\n");

	sp  = ZJHPTXT+sprintf("%s:100/100:%s",my["name"],"#000000");
	sp += "║" + sprintf("经.%d:%d/%d:%s",my["combat_exp"],my["combat_exp"],F_LEVEL->level_max_exp(ob),"#BBFF00FF");
	sp += "║" + sprintf("气.%d:%d/%d/%d:%s",my["qi"],my["qi"],my["eff_qi"],my["max_qi"],"#BBFF0000");
	sp += "║" + sprintf("内.%d:%d/%d/%d:%s",my["neili"],my["neili"],my["max_neili"],ob->query_current_neili_limit(),"#BB0000FF");
	sp += "║" + sprintf("精.%d:%d/%d/%d:%s",my["jing"],my["jing"],my["eff_jing"],my["max_jing"],"#BBFF0066");
	sp += "║" + sprintf("精.%d:%d/%d/%d:%s",my["jingli"],my["jingli"],my["max_jingli"],ob->query_current_jingli_limit(),"#BB6600CC");
	sp += "║" + sprintf("食.%d:%d/%d:%s",my["food"],my["food"],ob->max_food_capacity(),"#BBFF6600");
	sp += "║" + sprintf("水.%d:%d/%d:%s",my["water"],my["water"],ob->max_water_capacity(),"#BB0066FF");
	sp += "║" + sprintf("怒.%d:%d/%d:%s",ob->query_craze(),ob->query_craze(),ob->query_max_craze(),"#BB990000");
	sp += "║" + sprintf("潜.%d:%d/%d/%d:%s",my["potential"]-my["learned_points"],my["potential"]-my["learned_points"],my["potential"],ob->query_potential_limit(),"#BB006600");
	sp += "\n";
	tell_object(me, sp);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : hp
	  hp <对象名称>		  (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP );
    return 1;
}


