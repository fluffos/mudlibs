// time.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if(!arg)
		write(ZJBTSET"b12:"HIG"常用"ZJBR"指令"NOR":mycmds ofen"ZJSEP"b13:"HIY"技能"ZJBR"相关"NOR":mycmds skill"ZJSEP"b14:"HIR"战斗"ZJBR"相关"NOR":mycmds fight"ZJSEP
			"b15:"HIM"任务"ZJBR"相关"NOR":mycmds quest"ZJSEP"b16:"HIW"游戏"ZJBR"指南"NOR":mycmds help"ZJSEP"b17:"HIC"频道"ZJBR"交流"NOR":liaotian"+"\n");
	else if(arg=="ofen")
		write(ZJBTSET"b1:查看"ZJBR"背包:i"ZJSEP"b2:综合"ZJBR"属性:score"ZJSEP"b3:健康"ZJBR"状态:hp"
			ZJSEP"b4:查看"ZJBR"装备:arm"ZJSEP"b5:角色"ZJBR"升级:uplv"ZJSEP"b6:地图"ZJBR"相关:help mapb"ZJSEP"b7:暂未"ZJBR"设定:look"
			ZJSEP"b8:睡觉"ZJBR"休息:sleep"ZJSEP"b9:暂未"ZJBR"设定:look:recall back"ZJSEP"b10:在线"ZJBR"玩家:who"+"\n");
	else if(arg=="skill")
		write(ZJBTSET"b1:查看"ZJBR"技能:help chaski"ZJSEP"b2:日常"ZJBR"练功:help liangong"ZJSEP"b3:内力"ZJBR"回血:exert recover"
			ZJSEP"b4:内力"ZJBR"回精:exert regenerate"ZJSEP"b5:内力"ZJBR"疗伤:exert heal"ZJSEP"b6:内力"ZJBR"疗神:exert inspire"
			ZJSEP"b7:内力"ZJBR"疗疾:exert dispel"ZJSEP"b8:内功"ZJBR"加力:enforce"ZJSEP"b9:暂未"ZJBR"设定:look"ZJSEP"b10:暂未"ZJBR"设定:look"+"\n");
	else if(arg=="fight")
		"/cmds/skill/perform"->main(me);
	else if(arg=="quest")
		write(ZJBTSET"b1:查看"ZJBR"任务:quest"ZJSEP"b2:暂未"ZJBR"设定:look"ZJSEP"b3:暂未"ZJBR"设定:look"
			ZJSEP"b4:暂未"ZJBR"设定:look"ZJSEP"b5:暂未"ZJBR"设定:look"ZJSEP"b6:搜索"ZJBR"本地:search"ZJSEP"b7:暂未"ZJBR"设定:look"
			ZJSEP"b8:暂未"ZJBR"设定:look"ZJSEP"b9:暂未"ZJBR"设定:look"ZJSEP"b10:暂未"ZJBR"设定:look"+"\n");
	else if(arg=="help")
		write(ZJBTSET"b1:基本"ZJBR"系统:help"ZJSEP"b2:新手"ZJBR"指南:help newbie"ZJSEP"b3:门派"ZJBR"世家:help menpai"
			ZJSEP"b4:游戏"ZJBR"特色:help feature"ZJSEP"b5:技能"ZJBR"介绍:help skills"ZJSEP"b6:搜索"ZJBR"本地:search"ZJSEP"b7:暂未"ZJBR"设定:look"
			ZJSEP"b8:暂未"ZJBR"设定:look"ZJSEP"b9:暂未"ZJBR"设定:look"ZJSEP"b10:自杀"ZJBR"重来:suicide"+"\n");
	return 1;
}

int help(object me)
{
     write(@HELP

这个指令让设定游戏默认的自定义按钮。

HELP
    );
    return 1;
}
