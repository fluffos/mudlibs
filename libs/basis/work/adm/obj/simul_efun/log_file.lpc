/*
// File: log_file.lpc
// This is a simul_efun module.
//
// log_file() was a real efun on the classic MudOS driver this mudlib
// was written for (append 'str' to a file named 'file' inside the
// mudlib's own LOG_DIR); this driver (FluffOS) never implemented it,
// so it must be reimplemented as a simul_efun -- see AGENTS.md §6.2.
*/

void log_file(string file, string str) {
  // This driver's valid_write() master apply receives current_object()
  // (i.e. this simul_efun object itself, not the calling command) as its
  // "user" argument (AGENTS.md §7.176) -- the simul_efun object's own
  // euid is 0 (never set), so every write_file() call here was silently
  // denied (write_file() returns 0 on denial, no catchable error) no
  // matter how privileged the ACTUAL caller was. The classic MudOS
  // log_file() efun this simulates was a trusted native primitive that
  // always had write access to LOG_DIR regardless of caller privilege;
  // replicate that by elevating this object's own euid before writing.
  seteuid(ROOT_UID);
  write_file(LOG_DIR + "/" + file, str);
}
