/*
// File: log_file.lpc
// This is a simul_efun module.
//
// log_file() was a real efun on the classic MudOS driver this mudlib
// was written for (append 'str' to a file named 'file' inside the
// mudlib's own LOG_DIR); this driver (FluffOS) never implemented it,
// so it must be reimplemented as a simul_efun -- see AGENTS.md §6.2.
*/

void log_file(string file, string str) {
  write_file(LOG_DIR + "/" + file, str);
}
