/*
// File: cat.lpc
// This is a simul_efun module.
//
// cat() and tail() were real efuns on the classic MudOS driver this
// mudlib was written for; this driver (FluffOS) never implemented
// either, so they must be reimplemented as simul_efuns -- see
// AGENTS.md §6.2.
//
// int cat(string file)
// int cat(string file, int start, int num)
//   Writes 'file' (or, in the 3-arg form, lines [start, start+num) of
//   it, 1-indexed, for pager-style paging) directly to the current
//   player, and returns the number of lines actually written (0 for
//   the 1-arg whole-file form).
//
// void tail(string file)
//   Writes the last 10 lines of 'file' to the current player, like the
//   Unix tail(1) default.
*/

varargs int cat(string file, int start, int num) {
  string content;
  string *lines;
  int total, i, end;

  content = read_file(file);
  if (!content) return 0;

  if (!start) {
    write(content);
    return 0;
  }

  lines = explode(content, "\n");
  total = sizeof(lines);
  if (start < 1) start = 1;
  end = (start - 1) + num;
  if (end > total) end = total;
  for (i = start - 1; i < end; i++) {
    write(lines[i] + "\n");
  }
  return end - (start - 1);
}

void tail(string file) {
  string content;
  string *lines;
  int total, start;

  content = read_file(file);
  if (!content) return;

  lines = explode(content, "\n");
  total = sizeof(lines);
  start = total - 10;
  if (start < 0) start = 0;
  write(implode(lines[start..], "\n"));
}
