/* File: author_file(), a simul_efun.
// Description: Gives the name of the author of a file. 
*/

string author_file(string str) {
  string *path;

  path = explode(str, "/");
  // This driver builds with SANE_EXPLODE_STRING (explode("/", "/") is
  // ({}), not old-style MudOS's ({"",""})) -- the original `!path`
  // guard only covered a null return, never an empty array, so
  // path[0] below hard-errored on "/". See AGENTS.md §6.7/
  // domain_file.lpc's identical fix.
  // Files outside /u/<letter>/<name>/ have the author NONAME: the driver
  // asks for the author of the master file once at boot and warns on every
  // boot when the answer is not a string (KB 06 §7.222).
  if (!path || !sizeof(path)) return "NONAME";

  switch (path[0]) {
    case "u":
      // A file right in /u/<letter>/ has no path[3]: indexing it was an
      // error, and author_file() runs for every object that loads.
      if (sizeof(path) > 3) {
        return path[2];
      }
      break;
    default:
      return "NONAME";
  }
  return "NONAME";
}
