/* File: author_file(), a simul_efun.
// Description: Gives the name of the author of a file. 
*/

string author_file(string str) {
  string *path;
  int i;

  path = explode(str, "/");
  // This driver builds with SANE_EXPLODE_STRING (explode("/", "/") is
  // ({}), not old-style MudOS's ({"",""})) -- the original `!path`
  // guard only covered a null return, never an empty array, so
  // path[0] below hard-errored on the driver's own boot-time probe of
  // "/". See AGENTS.md §6.7/domain_file.lpc's identical fix.
  if (!path || !sizeof(path)) return 0;

  switch (path[0]) {
    case "u":
      if (path[2] && path[3]) {
        return path[2];
      }
      break;
    default:
      return 0;
  }
  return 0;
}
