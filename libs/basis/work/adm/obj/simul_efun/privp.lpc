/*
// File: privp.lpc
// This is a simul_efun module.
//
// privp() was a real efun on the classic MudOS driver this mudlib was
// written for (true if 'ob' has an effective uid, i.e. is "privileged");
// this driver (FluffOS) never implemented it, so it must be
// reimplemented as a simul_efun -- see AGENTS.md §6.2.
*/

int privp(object ob) {
  string euid;

  if (!ob) return 0;
  euid = geteuid(ob);
  return euid && strlen(euid);
}
