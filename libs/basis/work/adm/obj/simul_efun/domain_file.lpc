/* File: creator_file(), a simul_efun.
// Description: Gives the name of the domain of a file. 
*/

string domain_file(string str) {
  string *path;
  int i;

  path = explode(str, "/");
  // This driver builds with SANE_EXPLODE_STRING, which drops leading/
  // trailing empty elements that old-style MudOS explode() kept --
  // explode("/", "/") is ({}), not ({"",""}) -- so a lone "/" (the
  // backbone-uid probe the driver itself makes at boot via
  // master::domain_file("/")) yields an empty array here. The
  // original `!path` guard only covered a null return, never an
  // empty one, so path[0] below hard-errored ("Array index out of
  // bounds") on every such call. See AGENTS.md §6.7/tmi2's identical fix.
  if (!path || !sizeof(path)) return 0;

  switch (path[0]) {
    case "adm":
      return "Adm";
    case "std":
      return "Std";
    case "bin":
      return "Bin";
    case "obj":
      return "Obj";
    case "room":
      return "Room";
    case "u":
      return "User";
    case "d":
      return capitalize(path[1]);
    default:
  }
  return "Backbone";
}
