#include <daemons.h>

string help_file(mixed arg) {
  string filename;

  if (objectp(arg)) {
    filename = "/help" + base_name(arg);
  } else if (stringp(arg)) {
    filename = "/help" + (string)COMMAND_D->where(arg);
  } else {
    return 0;
  }
  if (file_exists(filename)) {
    return filename;
  } else {
    return 0;
  }
}
