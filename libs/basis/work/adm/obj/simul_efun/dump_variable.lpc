string dump_variable(mixed arg) {
  mixed *index;
  string rtn;
  int i;

  if (objectp(arg))
    return "(" + file_name(arg) + ")";

  if (stringp(arg))
    return "\"" + arg + "\"";

  if (intp(arg))
    return "#" + arg;

  if (pointerp(arg)) {
    rtn = "ARRAY\n";

    for (i = 0; i < sizeof(arg); i++)
      rtn += "[" + i + "] == " + dump_variable(arg[i]) + "\n";

    return rtn;
  }

  if (mapp(arg)) {
    rtn = "MAPPING\n";

    index = keys(arg);

    for (i = 0; i < sizeof(index); i++)
      rtn += "[" + dump_variable(index[i]) + "] == " + dump_variable(arg[index[i]]) + "\n";

    return rtn;
  }

  return "UNKNOWN";
}
