// file:   /adm/obj/simul_efun/communications.c
// mudlib: Basis
// desc:   communications simul_efuns written to use message()
// note:   originally from Portals mudlib

varargs void say(string msg, mixed exclude) {
  if (!exclude)
    exclude = ({ this_player() });
  else if (objectp(exclude))
    exclude = ({ this_player(), exclude });
  else if (pointerp(exclude))
    exclude += ({ this_player() });
  message(mc_say, msg, environment(this_player()), exclude);
}

varargs void shout(string msg, mixed exclude) {
  if (!exclude)
    exclude = ({ this_player() });
  else if (objectp(exclude))
    exclude = ({ this_player(), exclude });
  else if (pointerp(exclude))
    exclude += ({ this_player() });
  message(mc_shout, msg, users(), exclude);
}

void tell_object(mixed ob, string msg) {
  message(mc_tell, msg, ob);
}

varargs void tell_room(mixed room, string msg, mixed exclude) {
  // This driver's message() efun declares its 4th (exclude) parameter
  // `void | object | object *` -- omittable, but NOT a literal int(0)
  // the way old MudOS accepted. tell_room()'s own varargs default
  // leaves `exclude` as plain 0, so every no-exclude call (e.g. `go`'s
  // "X leaves via..." room broadcast) hard-errored with "Bad argument
  // 4 to EFUN message(), Expected: object, array, Got: int(0)". Fix:
  // normalize to an empty array, an equally-valid "exclude nobody"
  // exclude list. See AGENTS.md §6.2.
  if (!exclude) {
    exclude = ({});
  } else if (objectp(exclude)) {
    exclude = ({ exclude });
  }
  message(mc_tell, msg, room, exclude);
}
