/*
// File: extract.lpc
// This is a simul_efun module.
//
// extract() was a real efun on the classic MudOS/LPmud driver this
// mudlib was written for; this driver (FluffOS) never implemented it,
// so it must be reimplemented as a simul_efun -- see AGENTS.md §6.2.
//
// string extract(string str, int start, int end)
// string extract(string str, int start)
//
// Extract a substring, from character 'start' to character 'end'
// (inclusive), of the string 'str'. If 'end' is omitted, all of the
// characters up to the end of the string are returned. Indices start
// at 0. If start > end, or the string is shorter than requested, an
// empty string is returned.
*/

varargs string extract(string str, int start, int end) {
  int len;

  if (!str) return 0;
  len = strlen(str);
  if (!end) end = len - 1;
  if (start < 0) start = 0;
  if (end >= len) end = len - 1;
  if (start > end) return "";
  return str[start..end];
}
