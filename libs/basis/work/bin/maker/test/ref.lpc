#include <config.h>
inherit BIN;

object obj;

int do_command(string arg) {
  write("dump_variable(obj) = " + dump_variable(obj) + "\n");
  obj = to_object(arg);
  if (!obj) {
    write("couldn't find " + arg + "\n");
  } else {
    write("referencing " + dump_variable(obj) + "\n");
  }
  return 1;
}

void create() {
  obj = 0;
}
