// mudlib:  Basis
// file:    rmemote.c
// author:  Truilkan
// purpose: remove an emote entry

#include <config.h>
#include <daemons.h>
#include <emoted.h>
inherit BIN;

int do_command(string arg) {
  string verb;

  if (!arg) {
    notify_fail("usage: rmemote emote_name\n");
    return 0;
  }
  if (sscanf(arg, "%s/t", verb)) {
    EMOTE_D->delete_temote(verb);
  } else {
    EMOTE_D->delete_emote(arg);
  }
  return 1;
}

int permissions() { return 100; }
