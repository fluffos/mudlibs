#include <config.h>
#include <attributes.h>
inherit BIN;

int do_command(string file) {
  object act_ob;

  act_ob = this_player();
  seteuid(geteuid(act_ob));
  if (file) {
    file = resolv_path((string)this_player()->query(a_cwd), file);
  }
  return (int)act_ob->edit(file);
}

int permissions() { return 10; }
