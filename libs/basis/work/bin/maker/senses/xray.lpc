#include <config.h>
inherit BIN;

int do_command(string str) {
  object obj, *list;
  int j;

  if (!str) {
    str = "here";
  }
  obj = to_object(str);
  if (!obj) {
    notify_fail("couldn't find " + str + "\n");
    return 0;
  }
  write("xraying " + file_name(obj) + "...\n");
  list = all_inventory(obj);
  for (j = 0; j < sizeof(list); j++) {
    printf("    #%3d: %s\n", j, file_name(list[j]));
  }
  return 1;
}
