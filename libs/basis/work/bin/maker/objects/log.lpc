#include <config.h>
inherit BIN;

int do_command(string path) {
  seteuid(getuid(previous_object()));
  if (path) path = LOG_DIR + "/" + path;
  if (!path) {
    path = user_path(getuid(this_player()));
    path += "log";
  }
  if (!path) path = LOG_DIR + "/log";
  write(path + ":\n");
  if (!tail(path)) {
    notify_fail("log: " + path + ": no such file\n");
    return 0;
  }
  return 1;
}

int permissions() { return 0; }

