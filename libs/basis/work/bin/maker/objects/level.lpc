#include <config.h>
#include <attributes.h>

inherit BIN;

int do_command(string who) {
  object p;

  if (!who) {
    notify_fail("level who?\n");
    return 0;
  }
  p = find_player(who);
  if (!p) {
    notify_fail("level: couldn't find " + who + "\n");
    return 0;
  }
  write("permissions: " + (int)p->query(a_permissions) + "\n");
  return 1;
}

int permissions() { return 0; }

/* EOF */
