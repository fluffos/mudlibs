#include <config.h>
#include <daemons.h>
inherit BIN;

int do_command(string str) {
  object obj;

  if (!str) {
    notify_fail("usage: dest object\n");
    return 0;
  }
  obj = to_object(str);
  if (obj) {
    write("destructing " + file_name(obj) + "\n");
    obj->remove();
    if (obj) {
      destruct(obj);
    }
  } else {
    notify_fail("dest: couldn't find " + str + "\n");
    return 0;
  }
  return 1;
}

int permissions() { return 100; }
