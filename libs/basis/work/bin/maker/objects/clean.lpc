#include <config.h>
inherit CLEAN_UP;

int do_command(string str) {
  object obj, *list;
  int j;

  if (!str) {
    str = "here";
  }
  obj = to_object(str);
  if (obj) {
    list = all_inventory(obj);
    write("cleaning " + file_name(obj) + "\n");
    for (j = 0; j < sizeof(list); j++) {
      if (!interactive(list[j])) {
        write(" nuking " + file_name(list[j]) + "\n");
        list[j]->remove();
        if (list[j]) {
          destruct(list[j]);
        }
      }
    }
  } else {
    notify_fail("clean: couldn't find " + str + "\n");
    return 0;
  }
  return 1;
}
