#include <config.h>
inherit BIN;

/* dump_socket_status() was replaced by socket_status() (MudOS compat buster). */
int do_command(string arg) {
#ifdef __PACKAGE_SOCKETS__
  mixed *socks = socket_status();
  string out = "Fd  State          Mode          Local address       Remote address      Owner\n";

  foreach (mixed *s in socks) {
    out += sprintf("%-3d %-14s %-13s %-19s %-19s %s\n", s[0], s[1], s[2], s[3], s[4],
                   s[5] ? file_name(s[5]) : "-");
  }
  write(out);
#else
  write("This driver was built without the sockets package.\n");
#endif
  return 1;
}
