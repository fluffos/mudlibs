#include <config.h>
#include <daemons.h>
#include <attributes.h>
#include <writef.h>
inherit TIMEZONE_D;
inherit BIN;

string divide;

create()
{
        int i;

	for (divide = "", i = 0 ; i<78 ; i++ )
		divide += "_";
	divide += "\n";
}

void divider()
{   write(divide);
}

int do_command(string arg)
{   object *list;
    string line, zone_name;
    int i,time_zone;

    divider();
    list = users();
    if (sizeof(list) > 1)
	write("\t\tThere are "+ sizeof(list) +" users connected.\n");
    else
	write("\t\tYou're the only one here.\n");

// Time zone code, by Docz
    zone_name = (string)this_player()->getenv("TZONE");
    time_zone = query_tzone(zone_name);
    if (!time_zone)
        write( "\t\tMud time is " + ctime( time() ) + "\n" );
    else
	write( "\t\t"+zone_name+" time is " + ctime ( time_zone ) + "\n" );

    divider();
    printf("%-12s%-12s%-10s%-6s%-22s",
	"Name","Position","Guild", "Idle", "Location\n");
    divider();

    for (i=0; i<sizeof(list); i++)
    {   string field;
	mixed val;

	field = (string) list[i] -> query(a_cap_name);
	if (!field)
	    field = "(null)";
	if (in_edit(list[i]) || in_input(list[i]))
		field = "*" + field;
	line = sprintf("%-12s", field);
	field = "-";
	line += sprintf("%-12s", field);
	field = "-";
	line += sprintf("%-10s", field);
	val = query_idle(list[i]);
	if ( val <= 0 ) field = "";
	else if( val >= 3600 ) field = val/3600 + "h";
	else if( val >= 60 ) field = val/60 + "m";
	else field = "";
	line += sprintf("%-6s", field);
	val = environment(list[i]);
	if (!val) field = "(null)";
	else field = file_name(val);
	line += sprintf("%-22s", field);
	write( line + "\n" );
    }
    divider();
    return 1;
}

