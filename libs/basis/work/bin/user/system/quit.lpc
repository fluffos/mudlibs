#include <config.h>
#include <attributes.h>
inherit BIN;

int do_command(string dummy) {
  write("'til laters then\n");
  say((string)this_player()->query(a_cap_name) + " leaves this reality.\n",
    this_player());
  previous_object()->remove();  // does the save_data()
  return 1;
}

int permissions() { return 0; }
