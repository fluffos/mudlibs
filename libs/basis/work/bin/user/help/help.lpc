#include <config.h>
#include <daemons.h>
inherit BIN;

int do_command(string arg) {
  string file;

  if (!arg) {
    notify_fail("usage: help command_name\n");
    return 0;
  }
  file = help_file(arg);
  if (!file) {
    notify_fail("help: no help available on " + arg + ".\n");
    return 0;
  }
  this_player()->more(file);
  return 1;
}

int permissions() { return 0; }
