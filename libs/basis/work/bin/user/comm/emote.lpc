#include <config.h>
#include <attributes.h>
inherit BIN;

int do_command(string str) {
  if (!str) {
    return 0;
  }
  write("You emote: "
    +(string)this_player()->query(a_cap_name) + " " + str + "\n");
  say((string)this_player()->query(a_cap_name) + " " + str + "\n");
  return 1;
}

int permissions() { return 500; }

