/*
 * Command front-end to my mailer front-end!
 *
 * Huthar@portals (5/8/92)
*/

#include <config.h>
#include <mailer.h>
inherit BIN;

int do_command(string arg) {
  object ob;

  seteuid("anonymous");

  ob = clone_object(MAILER);
  ob->move(this_player());

  if (arg)
    ob->do_mail(arg);
  else
    ob->start_mail();
  return 1;

}

int permissions() { return 100; }
