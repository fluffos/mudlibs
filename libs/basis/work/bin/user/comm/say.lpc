#include <config.h>
#include <attributes.h>

inherit BIN;

int do_command(string str) {
  if ((!str) || (str == " ")) {
    notify_fail("You mutter to yourself.\n");
    return 0;
  }
  say((string)previous_object()->query(a_cap_name) + " says: " + str + "\n",
    previous_object());
  write("You say: " + str + "\n");
  return 1;
}

int permissions() { return 0; }
