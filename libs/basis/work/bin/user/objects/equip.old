inherit "/bin/bin_m";

int help();

int cmd_equip(string what) {
  object item;
  if (stringp(what)) {
   if (what == "all") {
     object *inventory;
     int i;
     inventory = all_inventory(previous_object());
     if (sizeof(inventory) > 0) {
       write("You rearrange your equipment.\n");
       say(previous_object()->query_short()+" rearranges "+previous_object()->
            query_possessive()+" equipment.\n");
       for (i=0;i<sizeof(inventory);i++) inventory[i]->unequip();
       for (i=0;i<sizeof(inventory);i++) "/bin/daemon/use_remove"->
            use_remove(previous_object(),inventory[i]);
       for (i=0;i<sizeof(inventory);i++) 
         if (inventory[i]->query_equipped()) {
           write("You now have "+inventory[i]->query_short()+" equipped.\n");
           say(previous_object()->query_cap_name()+" now has "+inventory[i]->
                query_short()+" equipped.\n");
         }
       return 1;
       }
     notify_fail("Nothing to equip.\n");
     return 0;
     }
   item = present(what,previous_object());
   if (item) {
    if (!item->query_equipped()) {
     if ("/bin/daemon/use_remove"->use_remove(previous_object(),item) ) {
       write(item->query_short()+" is now equipped.\n");
       say(previous_object()->query_cap_name()+" has equipped "+item->
           query_short()+".\n");
       return 1;
       }
     notify_fail("Nowhere to equip "+item->query_short()+"...\n");
     return 0;
    }
    notify_fail(item->query_short()+" is already equipped.\n");
    return 0;
   }
   notify_fail(capitalize(what)+" is not here...\n");
   return 0;
  }
  return help();
}

int
help() {
  write("Command: equip\nSyntax: equip <item | all>\n"+
        "This command when given an specific item will\n"+
        "automatically equip the item specified for use in\n"+
        "combat.  The item is automatically equipped to the \n"+
        "proper location.  If all is specified the best items in\n"+
        "the inventory should be automatically equipped.\n");
  return 1;
}
