#include <config.h>
#include <daemons.h>
inherit BIN;

int do_command(string arg) {
  if (!arg) {
    arg = "none.";
  }
  efun::shout("Rebooting the mud, reason given: " + arg + "\n");
  SHUTDOWN_D->do_shutdown(0);
  return 1;
}
int permissions() { return 890; }
