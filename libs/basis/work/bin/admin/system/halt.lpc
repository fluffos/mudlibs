#include <config.h>
#include <daemons.h>
inherit BIN;

int do_command(string arg) {
  if (!arg) {
    arg = "none.";
  }
  efun::shout("Halting the mud, reason given: " + arg + "\n");
  SHUTDOWN_D->do_shutdown(-1);
  return 1;
}

int permissions() { return 910; }
