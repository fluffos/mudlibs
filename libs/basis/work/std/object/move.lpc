#include <move.h>

// The argument 'dest' is either a string or an object.

int move(mixed dest) {
  object ob;

  if (stringp(dest)) {
    ob = find_object_or_load(dest);
    if (!ob) {
      return MOVE_FAILED;
    }
  } else if (objectp(dest)) {
    ob = dest;
  } else {
    return MOVE_FAILED;
  }
  // This driver's move_object() efun takes a single argument (the
  // destination) and always moves this_object() -- the old MudOS
  // 2-arg form's first argument was always this_object() here anyway,
  // so this is behavior-preserving. See AGENTS.md §6.2.
  efun::move_object(ob);
  return MOVE_OK;
}
