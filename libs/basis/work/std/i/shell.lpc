#include <daemons.h>

// file pager
inherit "/std/i/pager";
// standard editor object
inherit "/std/i/edit";
inherit "/std/i/alias";
// nickname substitution (query_nicknames/set_nicknames/query_nickname/
// remove_nickname/empty_nicknames) -- a complete, self-consistent mixin
// that was simply never added to this inherit chain, unlike the
// genuinely-incomplete std/i/history.lpc and std/i/tsh.lpc siblings
// (see NOTES.md); bin/user/shell/{nickname,unnickname}.lpc call these
// but with nothing providing them every player crashed/no-opped.
inherit "/std/i/nicknames";

string process_input(string arg) {
  if (arg && (arg != "")) {
    arg = alias::do_alias(arg);
    arg = (string)ALIAS_D->do_alias(arg);
  }
  return arg;
}

void create() {
  alias::clear_aliases();
}
