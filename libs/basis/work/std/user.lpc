#include <config.h>
#include <daemons.h>
#include <attributes.h>
#include <search_paths.h>

// inherit base user functionality
inherit INTERACTIVE_OB;

void setup() {
  seteuid(getuid(this_object()));
  // Have to some setup here.
  i::setup();
  set_path(USER_SEARCH_PATH);
}
