#include <config.h>

// NOTE: this file used to `private nosave inherit CORE;` here, but never
// actually called any of CORE's query()/set()/delete()/add() methods
// (it manages its own independent `evars` mapping below) -- the inherit
// was dead weight. Worse, on this driver it actively broke living.lpc:
// living inherits BASE (a normal, public `inherit CORE`) and this file,
// and the two inherited copies of `query()` (one public via base, one
// private via this now-removed inherit) made living.lpc's own unqualified
// query() calls ambiguous, resolving to the private/uninitialized copy
// and hard-failing with "Illegal to call inherited private function
// 'query'" (see AGENTS.md §7.48's sibling case). Removed rather than
// changed to `protected`, since a still-present ambiguous second `query()`
// would merely trade a clean compile error for a silent wrong-mapping
// runtime bug (this copy's `attrs` is never initialized, since this
// file's own create() below shadows CORE's).

private mapping evars;

void create() {
  evars = ([]);
}

mixed getenv(string key) {
  return evars[key];
}

void setenv(string key, mixed value) {
  if (geteuid(previous_object()) != ROOT_UID)
    return;
  evars[key] = value;
}

string *envars() {
  return keys(evars);
}

void remove_envar(string key) {
  if (getuid(previous_object()) != ROOT_UID)
    return;
  map_delete(evars, key);
}
