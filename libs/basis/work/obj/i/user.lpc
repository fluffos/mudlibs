#include <config.h>
#include <attributes.h>

inherit USER_OB;

void setup() {
  set_persistent(TRUE);
  user::setup();
  // todo: change from move() to move_living()
  this_object()->move(START_OB);
  set(a_race, "human");
  say(query(a_cap_name) + " enters this reality.\n", this_player());
}

void create() {
  user::create();
}
