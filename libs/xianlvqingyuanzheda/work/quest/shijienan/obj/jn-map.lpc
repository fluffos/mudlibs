// Creat by Repoo 30/08/2001

#include <ansi.h>
inherit NPC;

void create()
{
  set_name("〖"+HIB"十劫难行踪图"NOR+"〗", ({ "jienan map","map" }) );
  set_weight(10);
  set("unit", "张");
  set("long", "地图上的文字若隐若现,看上去很有灵气。\n");
  setup();
}

void init()
{
  add_action("do_ganying", "ganying");
  ::init();
  if(query("owner")==this_player()->query("id")) 
       {
  	set_leader(this_player());
  	}
}
int do_ganying()
{
  object me=this_player(),ghost;
  string where;
  int num = (int)me->query_temp("jienan/num");
  if(environment(me)!=environment()) return 1;
  if(this_object()->query("owner") != me->query("id")) return notify_fail("这不是你的东西吧？\n");
  switch(num)
  {
  	case 2: 
        call_out("jienan_fc", 1, me);
        break;
        case 3:
        call_out("jienan_hell",1,me);
        break;
        case 4:
        call_out("jienan_jjf",1,me);
        break;
        case 5:
        call_out("jienan_moon",1,me);
        break;
        case 6:
        call_out("jienan_putuo",1,me);
        break;
        case 7:
        call_out("jienan_wdd",1,me);
        break;
        case 8:
        call_out("jienan_wzg",1,me);
        break;
        case 9:
        call_out("jienan_xs",1,me);
        break;
        case 10:
        call_out("jienan_hyd",1,me);
        break;
  } 
  return 1;	
}
int jienan_fc(object me)
{	string where;
	object ghost;
        ghost = new("/quest/shijienan/fc-yao");
	where=ghost->invocation(me, 7);
        message_vision("$N中钻出一个小精灵来！\n",this_object());
        message_vision("$N对$n说道："+where+"，"+"快去找吧！\n",this_object(),me);
        destruct(this_object());
	return 1;
}
