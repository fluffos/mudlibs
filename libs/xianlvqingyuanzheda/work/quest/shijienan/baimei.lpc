#include <ansi.h>
inherit NPC;

int report_zhengqi();
void create()
{
     set_name(HIW"白眉道人"NOR, ({ "baimei daoren", "daoren", "baimei" }) );
     set("gender", "男性" );
     set("long","峨眉山首徒\n");
     set("age",50);
     set("title", HIR"峨眉山开山祖师"NOR);
     set("attitude", "heroism");
     set("str",40);
     set("int",30);
     set("max_kee",4100);
     set("kee",4100);
     set("max_sen",3100);
     set("sen",3100);
     set("combat_exp",25000000);
     set("daoxing",75000000);
     set("force",10000);
     set("mana",10000);
     set("max_force",6000);
     set("max_mana",6000);
     set("force_factor",300);
     set("mana_factor",200);
     set("eff_dx", 4500000);
     set("nkgain", 1500);
     
     set_skill("blade",400);
     set_skill("tianlongzhan", 480);
     
     map_skill("blade","tianlongzhan");
     set("inquiry", ([
             "name"     : "老夫乃峨眉山开山祖师。",
		     "天地正气" : (: report_zhengqi: ),

                     ])
         );
        setup();
        carry_object("/d/obj/armor/jinjia")->wear();
} 
int recognize_apprentice(object ob)
{
	
        return 1;
}

int report_zhengqi()
{
	tell_object(
		this_player(),
		sprintf("白眉道人告诉你：好像是%d。\n",this_player()->query("tianlongzhan/zhengqi_point"))
		);
	return 1;
}
