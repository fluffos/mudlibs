// sword.c



inherit SKILL;

int valid_enable(string usage)

{

        return usage == "literate";

}

int practice_skill(object me)

{
    	int skill1,skill2;
	
	skill1 = (int)me->query_skill("zouxiao",1);
	skill2 = (int)me->query_skill("literate",1);
	
    if( (int)me->query("kee") < 50 )
        return notify_fail("你的体力太差了，不能练吹箫之技。\n");

    if ( (int)me->query("force") < 100)
	return notify_fail("你的内力不足，不能练吹箫之技。\n");

    if ( skill1 > 300 && skill1 > skill2 )
	return notify_fail("你的技艺已达超群脱俗，没有很好的读书识字做根底，靠练是很难领悟到吹奏的技巧了！\n");

    me->receive_damage("kee", 40);
    me->add("force", -3);
    write("你俯首弄萧，吹奏了一曲『凤求凰』 。\n");

    return 1;

}
