        "dodge":     -10,
        "parry":     -20,
        "damage":    40,
        "damage_type":     "刺伤"
   ]),  
});
int valid_learn(object me)
{
   object ob;

   if( (int)me->query("max_force") < 150 )
     return notify_fail("你的内力修为不够深，无法学八歧幻魔剑法。\n");
   if( (int)me->query_skill("iori-force", 1) < 20)
     return notify_fail("你的八歧天罡功火候不够，无法学八歧幻魔剑法。\n");
   if (!(ob = me->query_temp("weapon"))
      || (string)ob->query("skill_type") != "sword" )
     return notify_fail("你必须先找一柄剑才能练习剑法。\n");
   return 1;
}

int practice_skill(object me)
{
   int dod=(int)me->query_skill("dodge");
   int swo=(int)me->query_skill("iori-sword");

   if (dod<swo)
     return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
   if ((int)me->query("kee") < 30)
     return notify_fail("你体质欠佳，强练八歧幻魔剑法有害无益。\n");
   if ((int)me->query("force") < 30)
     return notify_fail("你内力不足，强练八歧幻魔剑法有走火入魔的危险。\n");
   me->receive_damage("kee", 30);
   me->add("force", -5);
   message_vision("$N狂喝一声，脸上浮现出一丝狰狞,然后练了一遍八歧幻魔剑。\n", me);
   return 1;
}

int valid_enable(string usage)
{
   return usage=="sword"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
   int i;
   i=me->query_temp("XFJ_perform");
   if( !me->query_temp("XFJ_perform")) {
     return action[random(7)];
   }else {
     return action[i];
   }
//        return action[random(sizeof(action))];
}

int valid_effect(object me, object weapon, string name, int skill)
{
}
string perform_action_file(string func)
{
        return __DIR__"iori-sword/" + func;
}


