#include <ansi.h> 
#include <combat.h>
inherit SSERVER; int 
perform(object me, object target) {
	string dodskill,msg; int extra; int tmp; 
	object weapon,ob; int bs = 0;

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［计出连环］只能对战斗中的对手使用。\n");
	
        if(me->query("family/family_name")!="将军府")
           return notify_fail("“计出连环”只有将军府才可以用！\n");

	if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才行。\n");
                
	tmp = me->query_skill("wuhu-blade",1);
    extra = me->query_skill("lengquan-force",1);
	
    if ( extra < 100 )return notify_fail("你的［冷泉神功］还不够纯熟！\n");	
	
    if ( tmp < 100) return notify_fail("你的［五虎断门刀法］还不够纯熟！\n");

	if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内功太差。\n");
	
	if((int)me->query("force")<500) 
		return notify_fail("你的内力不够了。\n");
	
	tmp /=2;
	extra /=2;
	weapon = me->query_temp("weapon");
    me->add_temp("apply/attack",tmp);
    me->add_temp("apply/damage",extra);
	
	if (me->query_skill("wuhu-blade",1)>100)
	{   
	msg = BLINK""+HIR  "\n［十面埋伏］$N手中"+weapon->query("name")+"直劈$n！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
    	message_vision(msg, me, target);
    	msg = BLINK""+HIY  "［围魏救赵］$N手中"+weapon->query("name")+"斜刺$n！" NOR;
    	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
    	message_vision(msg, me, target);
	msg = BLINK""+HIW  "［暗渡陈仓］ $N手中"+weapon->query("name")+"平削$n！" NOR;
    	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
    	message_vision(msg, me, target);
    	bs = 2; 
	}
    
    me->add_temp("apply/attack",tmp/4);	
    
    if ( random(me->query_skill("wuhu-blade",1))>120)
    {
    msg = BLINK""+HIG  "［釜底抽薪］ $N手中"+weapon->query("name")+"横砍$n！" NOR;
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
    message_vision(msg, me, target);
    } 
    if (random(me->query_skill("wuhu-blade",1))>140)
    {
    msg = BLINK""+HIC  "［借刀杀人］ $N手中"+weapon->query("name")+"反撩$n！" NOR;
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
    message_vision(msg, me, target);
    bs = 3;
    }
    if (random(me->query_skill("wuhu-blade",1))> 160)
    {
     msg = BLINK""+HIR  "［反客为主］ $N手中"+weapon->query("name")+"加紧，旋风般向$n杀去！" NOR;
     COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	 message_vision(msg, me, target);
     if( random(4) == 1 ){
    	 bs = 0;//lucky,no extra busy.
     }
     }
     msg = "\n" NOR;
     message_vision(msg, me, target);
     
    me->add_temp("apply/attack",-tmp/4); 
    me->add_temp("apply/attack",-tmp);
    me->add_temp("apply/damage",-extra);   
        
	me->start_busy(2+random(bs));
	return 1;
}


