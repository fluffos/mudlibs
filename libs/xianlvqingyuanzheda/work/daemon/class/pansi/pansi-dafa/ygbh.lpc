#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{int i;
        if( !target ) target = offensive_target(me);

        if( (int)me->query("mana") < 50 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神无法集中！\n");
        if( me->is_busy() )
            return notify_fail("你正忙着呢！\n");

	if((string)me->query("family/family_name")!="盘丝洞" )
		return notify_fail("没拿到月光宝盒怎么跑路呀！\n");

        message_vision("$N喊到：波若波罗密－－！\n", me);

	me->add("mana", -25);
	me->receive_damage("sen", 20);

	if(me->is_fighting() ) {
		if(random((int)me->query("max_mana")) >(int)target->query("max_mana")/2) {
			message_vision(HIC"只见白光一闪，$N整个人已经被收到宝盒去了。。。\n"NOR, me);
            i=random(4);
			if(i==0) message_vision(HIC"$N升空而去，$n喊到：哇！升仙啦\n"NOR, me, target);
			else if(i==1) message_vision(HIC"$N升空而去，$n喊到：哇！又升仙啦！咦，为什么要说“又”呢？\n"NOR, me, target);
			else if(i==2) message_vision(HIC"$N升空而去，$n喊到：我Kao！又要升啦！\n"NOR, me, target);
			else message_vision(HIC"$N升空而去，$n喊到：娘子，跟牛魔王出来看上帝。\n"NOR, me, target);
			if(random(3)==0) me->move("/d/dntg/hgs/entrance");
			else if(random(3)==1) me->move("/d/pansi/hubian");
			else if (random(3)==2) me->move("/d/pansi/shishi5");
			else me->move("/d/pansi/damen");
			tell_room(environment(me),
HIC"一道白光过后"+me->query("name")+"从天而降。\n"NOR, ({me, me}) );

		} else {
			message_vision(HIC"$N想掏出宝盒，却被$n一把夺走。\n"NOR, me, target);
			me->start_busy(2);
		}
	} else {
		message_vision(HIC"只见白光一闪，$N整个人已经被收到宝盒去了。。。\n"NOR, me);
	//	i=random(3);
			//if(i==0) message_vision(HIC"$N升空而去，$n喊到：哇！升仙啦\n"NOR, me, target);
			//if(i==1) message_vision(HIC"$N升空而去，$n喊到：哇！又升仙啦！咦，为什么要说“又”呢？\n"NOR, me, target);
			//if(i==2) message_vision(HIC"$N升空而去，$n喊到：我Kao！又要升啦！\n"NOR, me, target);
			//if(i==3) message_vision(HIC"$N升空而去，$n喊到：娘子，跟牛魔王出来看上帝。\n"NOR, me, target);
		if(random(3)==0) me->move("/d/dntg/hgs/entrance");
			else if(random(3)==1) me->move("/d/pansi/hubian");
			else if (random(3)==2) me->move("/d/pansi/shishi5");
			else me->move("/d/pansi/damen");
                tell_room(environment(me),
HIC"一道白光过后"+me->query("name")+"从天而降。\n"NOR, ({me, me}) );

	}

        return 5+random(5);
}


