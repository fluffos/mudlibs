// juehu.c 兰花手「大凤尾手」perform
//2000,by lestat
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
        int damage,l_temp;
        string msg;

        if( !target ) target = offensive_target(me);
        if(me->query("family/family_name")!="盘丝洞")
             return notify_fail("“大凤尾手”只有盘丝洞门人才可以用！\n");
        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("神功伤敌只能对战斗中的对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用「大凤尾手」！\n");  
                
        if( (int)me->query_skill("lanhua-shou", 1) < 150 )
                return notify_fail("你的兰花手不够娴熟，不会使用「大凤尾手」。\n");

        if( (int)me->query_skill("jiuyin-xinjing", 1) < 150 )
                return notify_fail("你的九阴心经不够高，不能用「大凤尾手」伤敌。\n");

        if( (int)me->query("force") < 500 )
                return notify_fail("你现在内力太弱，不能使出「大凤尾手」招式。\n");

	if( me->query_temp("fengwei_busy")>time())
                 return notify_fail("你元气大伤，现在没有能力使出「大凤尾手」招式。\n");
                        
        msg = HIB "$N默运神功，脸色白得吓人，突然使出兰花手之「大凤尾手」，企图当场把$n废于掌下。\n\n"NOR;

        if (random(me->query_skill("unarmed")) > (target->query_skill("unarmed")/6 + target->query_skill("parry")/4) )
        {
                damage = (int)me->query_skill("force") + random(2*(int)me->query("unarmed"));
          
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/5);
//                target->receive_damage("sen", damage/2);
//                target->receive_wound("sen", damage/3);
                me->add("force", -damage/6);
                msg += RED"结果$N一击命中，$n只感到一阵刺痛，顿时觉的四肢无力，两腿不停颤抖。\n"NOR;
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);
        } else 
        {
                l_temp= 100 + (int)me->query_skill("jiuyin-xinjing", 1)/10;
                me->add("force", -l_temp);
                msg += CYN"可是$n看破了你的企图，向旁跳开数步，躲开了这凌厉的一击！\n"NOR;                
                 message_vision(msg, me, target);
        }
       
        
        me->set_temp("fengwei_busy",time()+random(3)+2);
        me->start_busy(1+random(2));
        
        return 1;
}

