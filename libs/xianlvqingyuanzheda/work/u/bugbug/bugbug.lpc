int check_obstacle(object player)
{
	mapping obstacle=player->query("obstacle");
	int real_number=0,number,i;
	mixed* done;
	if(!obstacle)
		return 0; //No error.
	
	done=values(obstacle);

	number=obstacle["number"];//"Fake" number
	i=sizeof(obstacle);
	while(i)
	{
		i--;
		if(done[i]==(string)"done") 
			real_number++;    //"Real" number
	}
	return number-real_number;
}

int do_yao(string args)
{
	int n=1;
	object me=this_player();
	int exp = me->query("combat_exp");

	if( n=me->query("new_gift") )
		return notify_fail("你已经要过一次了，不可以太贪心!\n");

	if( !userp(me) )
		return 1;

	if( args !="礼物" && args !="gift" )
		return notify_fail("请用 yao gift或yao 礼物!\n");

	if( exp >= 0)
		return notify_fail(HIC"不要企盼什么， 一切要靠自己去闯荡!\n"NOR);

/*		if( exp<20000 ) me->add("combat_exp",50000);
		else  me->add("combat_exp",30000);
		me->add("potential",25000);
		me->add("daoxing",5000);
*/		
	tell_object(me,"你获得了新人馈赠，可以输入hp查看一下你的状态。\n");

	tell_object(me,"今后的西天之路要靠你自己去完成了！\n");
	
	me->add("new_gift",1);

	me->save();
	
	return 1;
}

