#include <ansi.h>
#define ASSERT_EXISTS(D) (file_size("/daemon/skill/"+D+".lpc")>0)

inherit NPC;
//int do_yao(string arg);
int check_obstacle(object player);
void bug_self_dest(object ob,object me);

string* allowed_attributes=
({
"kee","sen","force","mana","eff_kee","max_kee","eff_sen","max_sen",
"maximum_force","max_force","maximum_mana","max_mana","potential",
"daoxing","combat_exp","bellicosity",
});
string* allowed_attributes_comments=
({
"当前气血","当前精神","当前内力","当前法力","有效的气血(右边项)","最大气血",
"有效的精神(右边项)","最大精神","最大内力(永久)","最大内力(右边项)","最大法力(永久)",
"最大法力(右边项)","潜能","道行","武学","杀气",
});


void create()
{
	set_name("小虫的塑像", ({"admin bugbug"}));
	set("gender", "男性" );
	set("age", 16);
	set("long", 
"
一个机灵的小仙童。
"
	 );
	set("class", "xian");
	set("combat_exp", 10000000);
    set("daoxing", 20000000);

	set("attitude", "peaceful");
	set("title", HIC "开天辟地" NOR );

	set_skill("unarmed", 40);
	set_skill("dodge", 400);
	set_skill("parry", 400);

	set("per", 100);
	set("max_kee", 20000);
	set("kee",20000);
	set("eff_kee",20000);
	set("max_sen",20000);
	set("eff_sen",20000);
	set("sen",200000);
	set("maximum_mana",4000);
	set("max_mana",4000);
	set("maximum_force",4000);
	set("max_force",4000);

	setup();
}

void init()
{
	object me=this_player();
	object* inv;
	int number;
	
	add_action("do_yao","yao");
	
	if( !random(10) && userp(me) && number=check_obstacle(me) > 0 && !wizardp(me))
	{
		me->move("/d/wiz/punish");
		me->add("obstacle/number",-number);
		me->add("bug/obstacle_adjust",-number);
		tell_object(me,"你被怀疑在过关中使用bug,请在10.13.21.88上发信给bugbug,陈述过程！\n");
		return;
	}
	if( !random(10) && userp(me) && !me->query_temp("last_backup") && me->query("age")>15 )
	{
		me->command("backup");
		me->set_temp("last_backup",1);
	}
	/*
	if( !random(4) && userp(me) )
	{
		inv=all_inventory(me);
		foreach(object temp in inv)
		{
			if( temp->query_unique() && temp->query("last_appear")+10800 < time() )
				call_out("bug_self_dest",1,temp,me);
		}
	}*/

}

void bug_self_dest(object ob,object me)
{
	tell_object(me,ob->query("name")+"消失了！\n" );

	if( ob->query("equipped") )
		ob->unequip();
	ob->move("/cmds/std/quitroom");
	destruct(ob);
}
