#include <ansi.h>
inherit SKILL;

inherit COMBINED_ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
       
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( HIY "灵丹" NOR , ({"ling dan", "dan"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
   set("base_unit","颗");
    set("unit", "些");
    set("long", "一颗金黄色的丹丸，wiz用来做些特殊调整之用。\n");
      set("value", 400000);
    set("drug_type", "补品");
  }
  set_amount(1);

  setup();
}

int do_eat(string arg)
{
  mapping me_skill;
  object me;
  int lv,i,size;
  string *strs;

	me = this_player();	
  if (arg!="dan" && arg!="ling dan")	return 0;

  me->add("potential", 100000);
	
  message_vision(HIG "$N轻轻掰开一颗丹药送入嘴中，一时间觉得有些异样！\n" NOR, me);
  add_amount(-1);
  me->save();
  // destruct(this_object());
  return 1;
}


