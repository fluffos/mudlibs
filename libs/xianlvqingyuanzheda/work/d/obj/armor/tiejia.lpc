#include <armor.h>

inherit ARMOR;

void create()
{
set_name("铁甲", ({"tie jia","tiejia","jia","armor"}));
set_weight(8000);
if( clonep() )
set_default_object(__FILE__);
else {
set("unit", "件");
set("long", "一件铁甲。\n");
set("value", 2500);
set("material", "bone");
set("armor_prop/armor", 75);
}
setup();
}

void init ()
{
add_action("do_123","123");
}

int do_123 (string arg)
{
object me = this_player();
int jin, qi, neili, fali;
jin = me->query("max_sen");
qi =me->query("max_kee");
fali = me->query("max_mana");
neili = me->query("max_force");
me->set("eff_sen", jin);
me->set("eff_kee", qi);
me->set("sen", jin);
me->set("kee", qi);
me->set("mana", fali*20);
me->set("force", neili*20);
me->add("daoxing", 1000);
me->add("combat_exp", 1000);
me->add_maximum_force(20);
me->add_maximum_mana(20);
return 1;
}



