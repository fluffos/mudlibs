// 黄金武器

#include <weapon.h>
#include <armor.h>
#include <ansi.h>

inherit EQUIP;
inherit F_SAVE;
inherit F_BACKUP;
void confirm_dispose(string arg, object ob, object fabao_ob);

void create()
{
        seteuid(0);	
        set_name(YEL"黄金装备"NOR, ({"gold object"}));
	//set("spi",1000);
        setup();
}

void init()
{
//	add_action("do_dispose", "dispose");
}


void reset()
{
	if( !environment() ||  //mon 2/4/98
		query("owner_id") != getuid(environment()) )  
	{
		destruct(this_object());
		return;
	}
}
string query_save_file()
{
	string id, series;

	id = query("owner_id");
	series = query("series_no");
	if( !id || !series) return 0;

	return sprintf(DATA_DIR "gold/%c/%s-%d", id[0], id, series);
}

int restore()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) )
                return restore_object(file);
        return 0;
}

int save()
{
	//is this needed?...
	if( query("equipped") )   
	{
		write("必须放下黄金装备才能储存。\n");
		return 0;
	}
	return ::save();
}

void setup()
{
	::setup();
}

int query_unique()  { return 1; }



int  do_dispose(string arg) //销毁
{
   object ob = this_player();
   object fabao_ob;
  
   if( !arg || arg == "" )
	  return notify_fail("你要消除什么法宝？\n");

   if( !objectp(fabao_ob=present(arg, ob)) )
      return notify_fail("你身上没有这样东西啊。\n");
      
   if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no")||!fabao_ob->query("gold")) 
      return notify_fail("那个不是黄金装备耶！\n");
      
   write("你确定要毁灭这件黄金装备吗？(y/n)");
   input_to( (: confirm_dispose :), ob, fabao_ob); 
   return 1;
}

void confirm_dispose(string arg, object ob, object fabao_ob)
{
   mapping  fabao_list;
   string*  names;
   string fabao_name;
   string file_name ;
   int      i;

   if( arg == "y" || arg == "Y" )  {
      seteuid(getuid(ob));
      fabao_list = ob->query("gold");
      if(!mapp(fabao_list) ) return;
         names = keys(fabao_list);
         for(i=0; i<sizeof(names); i++)  {
             if( fabao_list[names[i]] == fabao_ob->query("series_no") )
                {
                 fabao_name = fabao_ob->query("name");
                 write("只听轰！的一声，"+fabao_name+"炸了开来。\n");
                 file_name = fabao_ob->query_save_file() + ".o";
                 seteuid(geteuid(ob));
                //seteuid(getuid(ob));
                //  if(rm(file_name)) write("Ok.\n");
                //  else write(file_name+"删除失败\n");                  
                 ob->delete("gold/"+names[i]);
                 ob->add("gold/gold_num",-1);
                 ob->save();
                 destruct( fabao_ob );
                 break;
                 }
            }
     }     
   return;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro,dam,damage;
        int spi,end_damage ;
        int me_damage,me_armor,ob_damage,ob_armor,ob_dodge ;
        spi = (int) query("spi"); //法宝的攻击力
        me_damage = me->query_temp("apply/damage"),
        me_armor = me->query_temp("apply/armor");
        ob_damage = victim->query_temp("apply/damage"),
        ob_armor = victim->query_temp("apply/armor");
        ob_dodge = victim->query_temp("apply/dodge");
        ob_armor = ob_armor +  ob_dodge;
        end_damage = me_damage + spi;
        
        if(ob_armor<100) ob_armor = 100;
   
        if(random(end_damage) > ob_armor/2)
        
         {
           if(random(3)==0) 
            { 
             victim->receive_damage("sen",spi/2);
             victim->receive_damage("kee",spi/2);
             COMBAT_D->report_status(victim);
            }

         if(victim->query("combat_exp") > me->query("combat_exp"))
           {
           	 if(random(4)==0) add("spi",random(4));
                 return HIY+query("name")+HIY"突然发出金光连续闪了几闪。\n" NOR;
           }
          return YEL+query("name")+HIY"突然发出金光一闪了一闪。\n" NOR;

        }
}
