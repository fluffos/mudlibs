#include <ansi.h>
inherit F_VENDOR_SALE;
//inherit NPC;
string opearator();
void create() {
  reload("sunsimiao");
  set_name("孙思邈", ({ "sun simiao", "sun", "doctor" }));
  set("title", "药王");
  set("gender", "男性");
  set("age", 37);
  set("long",
    "大名鼎鼎的药王，不用多介绍了吧。\n");
  set("kee", 300);
  set("max_kee", 300);
  set("sen", 200);
  set("max_sen", 200);
  set("combat_exp", 10000);
  set("attitude", "friendly");
  //set("env/wimpy", 50);
  set("inquiry", ([
    "变性": (: opearator :),
  ]));

  set("vendor_goods", ([
    "dan": "/u/bible/obj/panshidan",
  ]));

  set_skill("literate", 70);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);

  setup();
  carry_object("/d/obj/cloth/choupao")->wear();

}

void init() {
  object ob;

  ::init();
  add_action("do_no", "fight");
  add_action("do_no", "kill");
  add_action("do_no", "steal");
  add_action("do_no", "cast");
  add_action("do_no", "ji");
  add_action("do_no", "throw");
  add_action("do_no", "perform");
  add_action("no_shop", "bid");
  add_action("do_block", "", 1);
  // call_out("leave",20);   
  add_action("do_vendor_list", "list");
  add_action("do_agree", "agree");


}
int no_shop() {
  object who = this_player();
  tell_object(who, HIW "你想断杨梅的财路呀！\n" NOR);
  return 1;
}

string opearator() {
  object me = this_player();

  if (me->query("married") != 0) {
    command("say 有家有室的，变了性你让你的伴侣怎么办？");
    return ("先去处理完婚姻问题吧。");
  } else {
    if (me->query("balance") < 50000000) {
      command("say 变性手术需要5000两gold。");
      return ("存够钱再来吧。");
    } else {
      command("say 你既是执意要变性，偶就帮帮你吧。");
      me->set_temp("opearator", 1);
      return ("变性手术对身体伤害比较大，你同意吗(agree)？");
    }
  }

  return ("不知道。\n");
}
int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  //if (arg=="sun simiao" || arg=="sun"|| arg=="docotor")
  {
    message_vision("\n空中出现了杨梅的幻影，对$N说道“不看僧面看佛面，你就放过他吧！“！\n\n", who);
    return 1;
  }
}

int do_agree(string arg) {
  if (this_player()->query_temp("opearator")) {
    message_vision("$N答道：偶已经考虑好长时间了，神医就帮帮偶吧。\n\n", this_player());
    command("say 好吧，这就给你手术。");
    message_vision("$N只觉得下体一阵巨疼。接着昏迷了过去。\n\n", this_player());
    this_player()->set_temp("opearator", 0);
    if (this_player()->query("gender") == "男性")
      this_player()->set("gender", "女性");
    else
      this_player()->set("gender", "男性");
    this_player()->add("balance", -50000000);
    this_player()->add("maximum_force", -100);
    this_player()->add("maximum_mana", -100);
    this_player()->add("max_force", -100);
    this_player()->add("max_mana", -100);
    this_player()->save();
    this_player()->unconcious();
    return 1;
  } else {
    command("say 偶还没给你诊断呢，你急什么点头\n");
    return 1;
  }
}
