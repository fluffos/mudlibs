inherit F_VENDOR_SALE;
#include <ansi.h>

void create()
{
    reload("xiaotou");
        set_name(HIW"神偷"NOR, ({"xiao tou", "tou"}));
        set("title", RED"天下第一"NOR);
        set("gender", "男性");
        set("age", 25);
        set("long", "名冠叁界第一神偷。\n");

        set("combat_exp", 70000);
	set_skill("fonxansword", 30);
        set_skill("sword", 50);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
	set_skill("moondance", 50);
	map_skill("dodge", "moondance");
	map_skill("sword", "fonxansword");
	map_skill("parry", "fonxansword");
	set("force", 200);
	set("max_force", 200);
	set("force_factor", 5);

        set("vendor_goods", ([
               "datao": "/d/obj/drug1/datao",
//               "daguo": "/d/obj/drug1/daguo",
               "jzhhd": "/d/obj/drug1/jzhhd",
               "qiongcao": "/d/obj/drug1/qiongcao",
               "shaqiwan": "/d/obj/drug1/shaqiwan",
               "xylxw": "/d/obj/drug1/xylxw",
              "xbw": "/d/obj/drug1/xbw",
        ]) );

        setup();
        carry_object("/d/obj/cloth/pink_cloth")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();

}

void init()
{
        object ob;

        ::init();
        add_action("do_vendor_list", "list");
        add_action("block_cmd","",1);   
}
int block_cmd()
{
        string verb = query_verb();
  
        if (verb=="bid") return 1; 

        return 0;
}



