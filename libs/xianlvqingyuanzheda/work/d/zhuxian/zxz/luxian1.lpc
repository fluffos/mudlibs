inherit ROOM;                                                        
#include "bancast.h"

void create ()
{
  set ("short", "戮仙门内" );   
  set ("long", @LONG   
这里前後有门有户，杀气森森，阴风飒飒。
边上隐约又是一层，似为“戮仙阙”。
LONG);
    set("exits", ([ 
               "southwest" : __DIR__"luxian1",
               "southeast" : __DIR__"luxian1",
               "northeast" : __DIR__"luxian1",
               "northwest" : __DIR__"luxian2",
                  ]));
    set("objects", ([ 
		__DIR__"npc/mobing" : 4,
                  ]));
    setup();
}

void init() 
{
  add_action("do_quit", "quit");
  add_action("do_ji", banned_action);
  add_action("do_cast",({"cast","burn"}));
}

int valid_leave(object me, string dir)
{
        object a;
   if (dir) {
                if(objectp(a=present("mo bing", environment(me))) && living(a) )
        return notify_fail("截教门人一把拦住你道：进来了还想走？ \n");
        }   
        return ::valid_leave(me, dir);
}
