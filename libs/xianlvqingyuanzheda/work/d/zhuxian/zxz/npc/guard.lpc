inherit NPC;

void create()
{

        set_name("守卫", ({ "guard" }) );
        set("race", "人类");
        set("age", 3000);
        set("str", 30);
        set("cor", 30);
        create_family("陷空山无底洞", 2, "弟子");
        set("title", "截教门人");
        
        set("max_force", 4000);
        set("mana", 8000);
        set("force", 8000);
        set("max_mana", 4000);
        set("force_factor", 250);
        set("mana_factor", 250);
        set("max_kee", 5000);
        set("max_sen", 5000);
        set("verbs", ({ "bite", "claw"}) );

        set("combat_exp", 6000000+random(1000000));
  	set("daoxing", 6000000);

    set_skill("dodge", 300);
    set_skill("unarmed", 300);
    set_skill("parry", 300);
    set_skill("moshenbu", 300);
    set_skill("force", 300);
    set_skill("huntian-qigong", 300);
    set_skill("blade", 300);
    set_skill("kugu-blade", 300);
    set_skill("unarmed", 300);
    set_skill("moyun-shou", 300);
    set_skill("dao", 300);
    set_skill("spells", 300);
       map_skill("force", "huntian-qigong");
       map_skill("parry", "kugu-blade");
       map_skill("blade", "kugu-blade");
       map_skill("dodge", "moshenbu");
       map_skill("spells", "dao");
       map_skill("unarmed", "moyun-shou");
         set("chat_chance_combat", 30);
         set("chat_msg_combat", ({
        (: cast_spell, "light" :),
        (: cast_spell, "thunder" :),
//        (: cast_spell, "dingshen" :),
        (: cast_spell, "fenshen" :),
//        (: perform_action, "blade", "pozhan" :),
       }));
        set_temp("apply/armor", 100);
        set_temp("apply/damage",100);
        set_temp("apply/armor_vs_force",300);
        set_weight(1000000);
        setup();
        carry_object("/d/obj/weapon/blade/jindao")->wield();
        carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        ::init();
  	add_action("do_cast", "cast");
  	add_action("do_exert", "exert");
  	add_action("do_perform", "perform");
  	add_action("do_bian", "bian");
  	add_action("do_ji","ji");

}

int do_cast(string arg)
{
        object who = this_player();
        object me = this_object(); 
	message_vision("$N张开嘴，结结吧吧地念了几声咒语。\n", who);
        message_vision ("$N对$n摇了摇头。\n", me, who); 
        return 1;
}        

int do_exert(string arg)
{               
        object who = this_player();
        object me = this_object();
	message_vision("$N鬼鬼祟祟地一运气。\n",who);
        message_vision("$N对$n摇了摇头。\n", me, who); 
        return 1;
}

int do_perform(string arg)
{
        object who = this_player();
        object me = this_object();
	message_vision("$N脸色不大对，好象动了杀机！\n", who);
        message_vision ("$N对$n摇了摇头。\n", me, who);  
        return 1;
} 

int do_ji(string arg)
{
        object who = this_player();
        object me = this_object();
	message_vision("$N偷偷把手伸进怀里，想用什么法宝！\n", who);
        message_vision ("$N对$n摇了摇头。\n", me, who);  
        return 1;
}

