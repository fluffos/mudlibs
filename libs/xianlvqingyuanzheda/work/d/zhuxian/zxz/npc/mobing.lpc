void init ()
{
  object ob = this_player();
  object me = this_object();

  if(living(ob))
  	call_out("greeting", 1, ob);
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() ) return;
  if (ob && interactive(ob) )
  {
    if (! ob->query_temp("mobing_kill"))
      message_vision ("$N喝道：狂妄小子，擅闯诛仙阵！\n",this_object());
    this_object()->kill_ob(ob);
    ob->set_temp("mobing_kill",1);
  }
}

void kill_ob (object ob)
{
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

// tomcat mod
void die()
{
        object dan;
        object ob = query_temp("my_killer");

	if(ob)
		ob->add_temp("mark/zhuxian", 1);

	dan = new("/d/city/obj/xjdan");
    	if( environment() ) 
    	{
    	    message_vision("$N起个云头，将身一纵跳在半空，一拱手道：你家大爷我这就去也！。\n",this_object());
    	    if (random(2))
    	    {
    		message("vision", "一阵狂风刮过，你突然发现地上多了一样东西。\n", environment());
    		dan->move(environment(this_object()));
    	    } 
        }
        destruct(this_object());
	return;
}        

