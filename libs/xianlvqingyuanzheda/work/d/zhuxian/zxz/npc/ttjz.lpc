inherit NPC;
#include <ansi.h>

void create()
{
  set_name("通天教主", ({"tongtian jiaozhu", "tongtian", "jiaozhu"}));
  set("gender", "男性");
  set("attitude", "aggressive");
  set("combat_exp", 16000000+random(2000000));
  set("daoxing", 16000000);
  create_family("陷空山无底洞", 1, "弟子");
  set("title",BLU"截教掌门"NOR);  

  set("age", 10000);
  set("per", 40);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar", 30);
  set("spi", 30);
  set("max_kee", 15000);
  set("max_sen", 15000);
  set("force", 15000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("mana",12000);
  set("mana_factor",600);  
  set("force_factor",600);
  set("bellicosity",600);  
  
  set_skill("literate", 500);   
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("unarmed", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);
  set_skill("blade", 500);
  
  set_skill("huntian-qigong", 500);  
  set_skill("dao", 500);  
  set_skill("yinfeng-zhua", 500);
  set_skill("lingfu-steps", 500);
  set_skill("kugu-blade", 500);
  
  map_skill("dodge", "lingfu-steps");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("spells", "dao");
  map_skill("force", "huntian-qigong");
  map_skill("blade", "kugu-blade");
  map_skill("parry", "kugu-blade");
  
         set("chat_chance_combat", 60);
         set("chat_msg_combat", ({
        (: cast_spell, "fenshen" :),   
        (: cast_spell, "thunder" :), 
        (: cast_spell, "light" :),    
//        (: perform_action, "blade", "pozhan" :),
        (: perform_action, "blade", "diyu" :),
        (: perform_action, "unarmed", "duzun" :),        
       }));
        set_temp("apply/armor", 300);
        set_temp("apply/damage",200);
        set_temp("apply/armor_vs_force", 300);
        set_temp("apply/defense", 150);
        set_temp("apply/strength",200);
        set_weight(1000000);
        set_temp("zxz/ttjz", 0);
        setup();
        carry_object("/d/npc/obj/blade")->wield();
        carry_object("/d/npc/obj/armor")->wear();        
}

void kill_ob (object ob)
{
  object me = this_object();
  object where = environment (me);
  object xue,huo,feng,shui;
  
  xue = present ("xue shen", where);
  huo = present ("huo shen", where);
  shui = present ("shui shen", where);
  feng = present ("feng shen", where);

  if(me->query("no_move"))
  	me->delete_temp("no_move");
  if(me->query("kee") < me->query("eff_kee")-1000)
  	command("exert recover");
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  if(xue)
    xue->kill_ob(ob);
  if(huo)
    huo->kill_ob(ob);    
  if(feng)
    feng->kill_ob(ob);
  if(shui)
    shui->kill_ob(ob);    
}

// tomcat mod
void die()
{
    object me = this_object();
    object ob = query_temp("my_killer");
    object baoshi;
    
/*    if( !me->query_temp("zxz/ttjz"))
    {
    	me->add_temp("zxz/ttjz",1);
    	write(HIC"通天教主摇身一晃，大叫一声：“元神出窍！”\n"NOR);
    	set("eff_kee", 10000);
  	set("eff_sen", 10000);
  	set("kee", 10000);
  	set("sen", 10000);
  	set("force", 12000);
  	set("mana", 12000);
    	return;
    }*/
    
    if( ob )
    {
	ob->add_temp("mark/zhuxian", 7);

	switch( random(6) )
	{		
	    case 0:
	    case 1:
	    	baoshi = new("/d/baoshi/obj/bs_b1"); 
	    	break;
	    case 2:
	    case 3:
	    	baoshi = new("/d/baoshi/obj/bs_g1"); 
	    	break;
	    case 4:
	    	if( random(ob->query("combat_exp")) > 5000000 )
	    		baoshi = new("/d/baoshi/obj/bs_y1"); 
	    	else
	    		baoshi = new("/d/baoshi/obj/bs_b1");
	    case 5:
	    	if( random(ob->query("combat_exp")) > 5000000 )
	    		baoshi = new("/d/baoshi/obj/bs_y1"); 
	    	else
	    		baoshi = new("/d/baoshi/obj/bs_g1");
	}		
	baoshi->move(ob);
	message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"拿到了一块闪闪发亮的"
		+baoshi->query("name")+" \n"+NOR,users() );
    }
    me->command("chat 罢了，罢了！待我回去修炼之后，再来与尔等决一雌雄！");
    me->command("chat* 通天教主觉得万念俱灰，难过地叹了口气。"); 
    destruct(this_object());
    return;
}
void unconcious()
{
  die ();  
}

