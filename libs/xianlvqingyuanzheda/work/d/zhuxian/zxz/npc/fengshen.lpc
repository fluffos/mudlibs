inherit NPC;
#include <ansi.h>

void create()
{
  set_name("风神", ({"feng shen", "fengshen", "shen"}));
  set("gender", "女性");
  set("attitude", "aggressive");
  set("combat_exp", 10000000+random(2000000));
  set("daoxing", 12000000);
  create_family("月宫", 2, "弟子");
  set("title","截教门人");  

  set("age", 2000);
  set("per", 30);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar",30);
  set("spi",30);
  
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 8000);
  set("max_mana", 8000);
  set("mana",8000);  
  set("mana_factor",400);  
  set("force_factor",400);  
  set("bellicosity",500);
  
  set_skill("literate", 400);  
  set_skill("spells", 400);
  set_skill("force", 400);
  set_skill("unarmed", 400);
  set_skill("parry", 400);
  set_skill("dodge", 400);
  set_skill("whip", 400);
  set_skill("sword", 400);
  
  set_skill("moonshentong", 400);  
  set_skill("moonforce", 400);  
  set_skill("baihua-zhang", 400);
  set_skill("moondance", 400);
  set_skill("snowsword", 400);
  set_skill("jueqingbian", 400);
  
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("whip", "jueqingbian");
  map_skill("parry", "jueqingbian");

         set("chat_chance_combat", 50);
         set("chat_msg_combat", ({
        (: cast_spell, "arrow" :),
        (: cast_spell, "qingwang" :),        
        (: perform_action, "sword", "wuxue" :),
       }));
        set_temp("apply/armor", 300);
        set_temp("apply/damage",150);
        set_temp("apply/armor_vs_force",300);
        set_temp("apply/defense", 120);
        set_temp("apply/strength",120);
        set_weight(1000000);
        setup();
       	carry_object("/d/npc/obj/whip")->wield();
        carry_object("/d/npc/obj/armor")->wear();        
}

void kill_ob (object ob)
{
  object me = this_object();
  object jiaozhu;
  object where = environment (me);
  
  jiaozhu = present ("tongtian jiaozhu", where);

  if (me->query("no_move"))
  	me->delete_temp("no_move");
  if (me->query("kee") < me->query("eff_kee")-500)
  	command("exert recover");	
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  
  if (jiaozhu && !jiaozhu->is_fighting() )
    jiaozhu->kill_ob(ob);

}

// tomcat mod
void die()
{
    object ob = query_temp("my_killer");
    object baoshi;
    
    if(ob)
    {
	ob->add_temp("mark/zhuxian", 3);

	if( random(2) )
	{
		switch( random(5) )
		{		
	    		case 0:
	    			baoshi = new("/d/baoshi/obj/bs_r1"); 
	    			break;
	    		case 1:
	    			baoshi = new("/d/baoshi/obj/bs_z1"); 
	    			break;
	    		case 2:
	    			baoshi = new("/d/baoshi/obj/bs_b1"); 
	    			break;
	    		case 3:
	    			baoshi = new("/d/baoshi/obj/bs_g1"); 
	    			break;
	    		case 4:
	    			if( random(ob->query("combat_exp")) > 5000000 )
	    				baoshi = new("/d/baoshi/obj/bs_y1"); 
	    			else
	    				baoshi = new("/d/baoshi/obj/bs_g1");
				break;
		}		
		baoshi->move(ob);
		message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"拿到了一块闪闪发亮的"
			+baoshi->query("name")+" \n"+NOR,users() );
	}
    }
    
    message_vision(HIM"$N大喝一声：我去也。\n"NOR,this_object());
    destruct(this_object());
    return;
}
