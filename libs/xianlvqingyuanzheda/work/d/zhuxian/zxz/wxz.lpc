inherit ROOM;                                                        
#include "bancast.h"

void create ()
{
  set ("short", "万仙阵前" );   
  set ("long", @LONG   
		万
		仙
		阵
LONG);
    set("exits", ([ 
               "south" : __DIR__"lupeng",
                  ]));
    set("objects", ([ 
//               __DIR__"npc/spear_jjf" : 1,
                  ]));
    setup();
}

void init() 
{
  add_action("do_quit", "quit");
  add_action("do_ji", banned_action);
  add_action("do_cast",({"cast","burn"}));
}

int valid_leave(object me, string dir)
{
        object a;
   if (dir == "south" ) {
                if(objectp(a=present("guard", environment(me))) && living(a) )
        return notify_fail("守卫拦住你说道：想进阵先过了我这一关！\n");
        }   
        return ::valid_leave(me, dir);
}
