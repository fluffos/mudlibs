inherit ROOM;                                                        
#include "bancast.h"

void create ()
{
  set ("short", "陷仙阙" );   
  set ("long", @LONG   
由这里就可以直接通往绝仙门。
LONG);
    set("exits", ([ 
               "northeast" : __DIR__"juexian",
                  ]));
    set("objects", ([ 
		"/d/zhuxian/zxz/npc/shuishen" : 1,
               	__DIR__"npc/mobing" : 4,
                  ]));
