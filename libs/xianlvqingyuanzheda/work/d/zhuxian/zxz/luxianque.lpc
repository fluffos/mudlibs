inherit ROOM;
#include "bancast.h"

void create() {
  set("short", "戮仙阙");
  set("long", @LONG   
由这里就可以直接通往陷仙门。
LONG);
  set("exits", ([
    "northwest": __DIR__ "xianxian",
  ]));
  set("objects", ([
    "/d/zhuxian/zxz/npc/huoshen": 1,
    __DIR__ "npc/mobing": 4,
  ]));
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_ji", banned_action);
  add_action("do_cast", ({ "cast", "burn" }));
}

int valid_leave(object me, string dir) {
  object a;
  if (dir) {
    if (objectp(a = present("mo bing", environment(me))) && living(a))
      return notify_fail("截教门人一把拦住你道：进来了还想走？ \n");
  }
  return ::valid_leave(me, dir);
}
