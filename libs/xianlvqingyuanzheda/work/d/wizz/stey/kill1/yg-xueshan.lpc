inherit __DIR__"guai.lpc";


void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/12; 
        else if (level==2) guai_value = max_value+max_value/10; 
        else guai_value = max_value+max_value/8; 
        
        set_skill("cuixin-zhang", guai_value+random(16));
        set_skill("xiaoyaoyou", guai_value+random(16));
        set_skill("sword", guai_value+random(16));
        set_skill("bainiao-jian", guai_value+random(16));
        set_skill("ningxie-force", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("dengxian-dafa", guai_value+20+random(16));
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        map_skill("unarmed", "cuixin-zhang");
        map_skill("parry", "bainiao-jian");
        map_skill("sword", "bainiao-jian");
        map_skill("dodge", "xiaoyaoyou");
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells")/2);
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed","cuixin" :),
        }) );
                
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/obj/weapon/sword/qinghong.lpc")->wield();
}

