inherit ROOM;
#include <ansi.h>

void create() {
  set("short", NOR + HIC "绝情谷 __ 断肠草的生长地" NOR + HIM);
  set("long", HIR "
本来是黑黝黝的山洞里，伸手不见五指。只有一丝微光从洞顶的裂缝
透进来，可以勉强看见正中央有一个石凳，散发着浓厚的甘草类气味，微光
下却依然清楚。一个神一般的人影坐在石壁边，神圣光环你不由心头一楞，
这里是断肠草的生长地，附近还有不少情花。
" NOR);
  set("exits", ([ /* sizeof() == 1 */
    "south": "/d/wiz/jobroom.lpc",
  ]));

  setup();

