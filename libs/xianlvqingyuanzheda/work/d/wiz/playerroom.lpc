inherit ROOM;
int block_cmd(string);
void create() {
  set("short", "仙侣情缘名人堂");
  set("long", @LONG
这里是用来纪念在仙侣情缘史上创造过第一记录的玩家的地方。
LONG
  );

  set("exits", ([
    "down": "/d/wiz/entrance",
  ]));
  set("no_time", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("no_clean_up", 1);
  //		set("valid_startroom",1);
  set("objects", ([ /* sizeof() == 2 */
    "/d/wiz/npc/jojoonpc": 1,
    "/u/bugbug/bugbug.lpc": 1,

  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  object me = this_player();
  add_action("block_cmd", "", 1);
}
int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "bian") return 1;
  if (verb == "steal") return 1;
  if (verb == "throw") return 1;
  if (verb == "kill") return 1;
  if (verb == "cast") return 1;
  if (verb == "chat*") return 1;
  return 0;
}
