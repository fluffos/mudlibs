set("long", "这就是在"+HIR"红叶站"NOR+"MUD史上最强人的"+HIC"星云-星云哥哥。\n"NOR);
set("title",HIR"开天辟地"+HIC+" 强中之强 "+NOR+HIR+"第一人"NOR);
        set("gender", "男性");
        set("age", 20);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per" ,30);
        set("max_kee",2000);
        set("kee",2000);
        set("max_sen",1200);
        set("sen",1200);
        set("max_mana",2600);
        set("mana",5200);
        set("max_force",2300);
        set("force",4600);
        set("combat_exp", 2012144);
	set("daoxing", 953307);
        set_skill("dodge",211);
        set_skill("force",163);
        set_skill("spells",157);
        set_skill("unarmed",151);
        set_skill("sword",211);
        set_skill("literate",185);
        setup();
        carry_object("/obj/cloth/baihu")->wear();
    //    carry_object("/obj/cloth/shoes")->wear();
}


