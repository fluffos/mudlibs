#include <ansi.h>
inherit NPC;

void create()
{
set_name(HIC"令狐仙"NOR, ({ "godkid npc","npc" }));
set("long", "这就是在"+HIR"仙侣情缘-红叶站"NOR+"MUD史上第一个独步天下的玩家"+HIC" 令狐仙。\n"NOR);
set("title",HIY"万古留芳"+HIC+" 独步天下 "+NOR+HIY+"第一人"NOR);
set("gender", "女性");
        set("age", 20);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per" ,30);
        set("combat_exp", 5000000);
	set("daoxing", 5000000);

        setup();
        carry_object("/obj/cloth/baihu")->wear();
    //    carry_object("/obj/cloth/shoes")->wear();
}


