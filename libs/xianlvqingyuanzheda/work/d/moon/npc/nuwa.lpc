#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
       set_name("女娲娘娘",({"nuwa","nu wa"}));
       set("long", "容貌瑞丽，瑞彩翩□国色天姿，宛然如蕊宫仙子临凡\n");
       set("title", HIC"补天神女"NOR);
       set("gender", "女性");
       set("age", 30);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "娘娘");
       set("per", 30);
	set("int", 30);
       set("max_kee", 4000);
       set("max_gin", 4000);
       set("max_sen", 4000);
       set("kee", 4000);
       set("gin", 4000);
       set("sen", 4000);
       set("force", 16000);
       set("max_force", 8000);
       set("force_factor", 300);
       set("max_mana", 8000);
       set("mana", 16000);
       set("mana_factor", 300);
       set("combat_exp", 10000000);
       set("daoxing", 8000000);
       set("eff_dx", 100000);
       
        set_skill("literate", 200);
	   set_skill("unarmed", MAX_SKILL_LEVEL+100);
	   set_skill("dodge", MAX_SKILL_LEVEL+100);
	   set_skill("jueqingbian", MAX_SKILL_LEVEL+100);
	   set_skill("xuanhu-blade", MAX_SKILL_LEVEL+100);
	   set_skill("blade", MAX_SKILL_LEVEL+100);
	   set_skill("force", MAX_SKILL_LEVEL+100);
	   set_skill("parry", MAX_SKILL_LEVEL+100);
	   set_skill("sword", MAX_SKILL_LEVEL+100);
	   set_skill("spells", MAX_SKILL_LEVEL+100);
	   set_skill("moonshentong", MAX_SKILL_LEVEL+100);
	   set_skill("baihua-zhang", MAX_SKILL_LEVEL+100);
	   set_skill("moonforce", MAX_SKILL_LEVEL+100);
	   set_skill("snowsword", MAX_SKILL_LEVEL+100);
	   set_skill("moondance", MAX_SKILL_LEVEL+100);
	   set_skill("whip", MAX_SKILL_LEVEL+100);
	   map_skill("spells", "moonshentong");
       map_skill("unarmed", "baihua-zhang");
	   map_skill("whip", "jueqingbian");
	   map_skill("blade", "xuanhu-blade");
	   map_skill("force", "moonforce");
       map_skill("sword", "snowsword");
       map_skill("parry", "snowsword");
       map_skill("dodge", "moondance");

       create_family("月宫", 1, "弟子");
       set("chat_chance_combat", 90);
       set("chat_msg_combat", ({
                (: cast_spell, "mihun" :),
                (: cast_spell, "arrow" :),
                (: cast_spell, "shiyue":),
                (: perform_action, "sword", "wuxue" :),
                (: perform_action, "sword", "tian" :),
          }) );
       setup();
       carry_object("/d/moon/obj/luoyi")->wear();
       carry_object("/d/moon/obj/feijian")->wield();
       
}

void attempt_apprentice(object ob)
{
   
   ob=this_player();
   
   if ( !((string)ob->query("gender")=="女性"))
   {
           command("shake");
           command("say 我们月宫只收女徒，这位" +
	   RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;
   }
   if(ob->query("obstacle/number") < 34) {
	command("say 这位" + RANK_D->query_respect(ob) + "我等你取经归来的好消息！\n");
	command("addoil");
	return;
	}	
   if ((int)ob->query("daoxing") < 1000000 ) {
  	command("shake");
 	command("say 你道行不够高深。\n");
	return;
      }
   if( (int)ob->query_skill("moonshentong", 1) < 180 ) {
	command("say 这位" + RANK_D->query_respect(ob) + "对月宫仙法领会还不够深，现在收你也是勉为其难！\n");
	command("sigh");
	return;
	}   
   
     command("pat "+ob->query("id"));
     command("say 既然" + RANK_D->query_respect(ob)+ "如此，我就收下你了。\n");
        command("recruit " + ob->query("id") );
        return ;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "xian");
}



