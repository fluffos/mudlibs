// me->query("combat_exp")>10000||(int)me->query("age")>16

#include <ansi.h>
#include <room.h>
inherit ROOM;
void remove_busy();

void create()
{
    set("short", "小树林");
    set("long", @LONG
这是长安郊外的一片小树林，落英缤纷，蜂歌蝶舞，朝露夕光，沁人
心脾。呼朋唤友开怀欢乐正其时。周围小树颗颗健美，上有无数的小鸟小
雀在树梢上欢歌，一点也不怕人。这正是个打鸟（da）的好机会。
LONG );
   set("exits", ([ /* sizeof() == 2 */
   "west" : __DIR__"wside5",
  "east" : __DIR__"wside3",
]));
  set("number",0);

  set("outdoors", 1);

    setup();
}

void init()
{
        add_action("do_da", "da");
}


int do_da()
{
        object ob;
        object me;
        int i, kar, cps, mm,jl,busy;
        me = this_player();

        if(me->is_busy())
             return notify_fail("你还是等弓装好了箭再打鸟吧！\n");
	if(me->query("age")>18)
		me->delete("daniao_exp");

        if (me->query("combat_exp")>100000||(int)me->query("age")>16||me->query("daniao_exp")>5000)
             return notify_fail("你这么大了,还打鸟?羞不羞?\n");
        
        if(me->query("kee")<10)
             return notify_fail(HIR"你还是先休息一下吧，射箭也要用力气哟。。\n"NOR);
        jl = random(me->query_kar());
        if( this_object()->query("number") > 6 )
            return notify_fail("现在人太多了，等会来打吧！\n");

        busy=random(6)+1;

        me->start_busy(busy);
        this_object()->add("number",1);
        call_out("remove_busy",busy);
        message_vision("$N拿起儿时玩耍用的小弓小箭，瞄准树上的小雀射去......\n", me);
        message_vision("$N只听树上一阵鸟儿急鸣…\n",me);
        
        kar = me->query("kar");
          if (random(kar)>20) {
                message_vision("$N打到一只"HIW"百灵鸟。\n"NOR, me);
                me->add("combat_exp",10+jl);
                jl = 10 + jl; 
                tell_object(me,"你得到了"+jl+"点武学经验。\n");
				me->add("daniao_exp",jl);

                me->receive_damage("kee", 10);
                me->add("potential",4+jl);
                jl = 4 + jl; 
               tell_object(me,"你得到了"+jl+"点潜能\n");
               return 1;
                            }
      
      if (random(kar)>15) {
                 message_vision("$N打到一只"HIY"金丝雀。\n"NOR, me);
                 me->add("combat_exp",8+jl);
                 jl = 8 + jl;
                 tell_object(me,"你得到了"+jl+"点武学经验。\n");
				 me->add("daniao_exp",jl);

                 me->receive_damage("kee", 10);
                 me->add("potential",3+jl);
                 jl = 3 + jl; 
                tell_object(me,"你得到了"+jl+"点潜能。\n");
                 return 1;
                           }
        
     if (random(kar)>10)   { 
                 message_vision("$N打到一只"HIG"鹦鹉。\n"NOR, me);
                 jl = 5 + jl;
                 tell_object(me,"你得到了"+jl+"点武学经验。\n");
 				me->add("daniao_exp",jl);

                 me->add("combat_exp",5+jl);
                 me->receive_damage("kee", 10);  
                 me->add("potential",2+jl);
                jl = 2 + jl; 
                tell_object(me,"你得到了"+jl+"点潜能\n");
                 return 1;
                         }
     if (random(kar)>7)  {
                 message_vision("$N打到一只"YEL"麻雀。\n"NOR, me);
                 jl = 2 + jl;
                 tell_object(me,"你得到了"+jl+"点武学经验。\n");
 				me->add("daniao_exp",jl);

                 me->add("combat_exp",2+jl);
                 me->receive_damage("kee", 10);  
                 me->add("potential",1+jl);
                 jl = 1 + jl;
                   tell_object(me,"你得到了"+jl+"点潜能\n");
                       }
     else             {
                me->receive_damage("kee", 10);  

ob=present("caotou shen",environment(me));
  if (!ob) ob=new("/d/city/npc/caotoushen");
ob->move(environment(me));
message_vision(HIR"突然,草头神逮住$N说道:好呀,你敢偷猎?看我不宰了你!\n"NOR,me );
  ob->kill_ob(me);
                return 1;
                        }
}

void remove_busy()
{
    this_object()->add("number",-1);
    if( this_object()->query("number") < 0)
        this_object()->set("number",0);
    return;
}
