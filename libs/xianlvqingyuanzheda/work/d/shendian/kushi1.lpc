#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
  set("short", HIC"天神台二层"NOR);
  set ("long", @LONG

这里是天神台上的其中一个阁楼。是众神坐禅(zuochan)的地方。

LONG);
  set("exits", ([ /* sizeof() == 1 */
                 "down" : __DIR__"tianshentai",
                 "up" : __DIR__"kushi2",
                 ]));
  set("objects", 
        ([ //sizeof() == 1
//       "quest/shijienan/baimei" : 1,
        ]));
  set("no_clean_up", 1);
  set("no_fight", 1);
   set("no_magic", 1);
  set("alternative_die",1);
  set("sleep_room", 1);
  set("outdoors", 0);
  setup();
}       
void init()
{
  add_action("do_zuochan", "zuochan");
}
 
int do_zuochan()
{
	int myforce, myspi, learned, sencost;
    	object me = this_player();
   	int num;
   	
   	num = 450;

   if ( me->query("combat_exp") < 20000000 )
	return notify_fail("你的武学不够，领悟不了什么的！\n");
	
   if ( me->query_skill( me->query_skill_mapped("force"),1 )< num 
		|| me->query_skill("force",1)< num )
	return notify_fail("你的内功底子太差了，学好了再来吧！\n");	
		
   if (!(int)me->query_temp("mark/wanxian"))
             return notify_fail( HIW "你先去万仙阵练练再来吧！\n"NOR);
             
   if((int)me->query_skill( me->query_skill_mapped("force"),1) < 600 )
   {
    	if(me->query("babu/shendian") == "done")
    	{
    		myforce = me->query_skill("force");
      		myspi=(int)me->query_spi();
  		learned=( myforce+myspi )/10;

  		sencost = 50+(myforce/5);

  		if ((int)me->query("sen")<=sencost)
      			return notify_fail("你神智不清，再这样下去会有危险的！\n");
  		if(me->query("force") <= sencost )
    			return notify_fail("你的内力不足，难以领会高深的内功。\n");
    			
  		me->receive_damage("sen", sencost);
  		me->add("force", -sencost);
   		tell_object (me, "你的内功略有进展。\n");
   		me->add_temp("mark/wanxian", -1);
  		me->improve_skill( me->query_skill_mapped("force"),learned);
   		return 1;
    	}
    	else
    	{
    		message_vision(HIY"$N怎么进来的，回去吧！\n"NOR,this_player());
   		message_vision(HIY"$N被一只无行的手抓回了南城客栈！\n"NOR,this_player());
   		this_player()->move("/d/city/kezhan");
    		return 1;
    	}
   }
   else
   {
   	message_vision(HIW"$N的修为已经够高了！\n"NOR,this_player());
       	return 1;
   }
}

