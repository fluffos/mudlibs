inherit NPC;
#include <ansi.h>

void create()
{
  set_name("榴莲",({"star aston","aston","star"}));
  set("gender", "男性");
  set("title", "混天大圣");
  set("age", 66);

  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 20786227);
  set("daoxing", 26213610);
  set("kee", 3194);
  set("max_kee", 3194);
  set("sen", 2838);
  set("max_sen", 2838);
  set("force", 13000);
  set("max_force", 6650);
  set("mana", 15480);
  set("max_mana", 7740);
  set("force_factor", 332);
  set("mana_factor", 388);
  set("str", 34);
  set("per", 13);

  set_skill("force", 431);
  set_skill("spells", 592);
  set_skill("dodge", 322);
  set_skill("parry", 592);
  set_skill("unarmed", 592);
  set_skill("literate", 267);
  set_skill("blade", 592);
  set_skill("sword", 288);
  
  set_skill("zhenyuan-force", 450);
  set_skill("taiyi", 415);
  set_skill("baguazhen", 310);
  set_skill("fumo-zhang", 585);
  set_skill("xiaofeng-sword", 585);
  set_skill("sanqing-jian", 586);
  set_skill("wuxing-quan", 592);
  set_skill("yange-blade", 592);

map_skill("force", "zhenyuan-force");
map_skill("spells", "taiyi");
map_skill("dodge", "baguazhen");
map_skill("parry", "xiaofeng-sword");
map_skill("unarmed", "wuxing-quan");
map_skill("blade", "yange-blade");
map_skill("sword", "sanqing-jian");

         set("chat_chance_combat", 50);
         set("chat_msg_combat", ({
        (: cast_spell, "wuxing" :),        
        (: perform_action, "sword", "jianzhang" :),
       }));
        set_temp("apply/armor", 300);
        set_temp("apply/damage",150);
        set_temp("apply/armor_vs_force",300);
        set_temp("apply/defense", 200);
        set_weight(1000000);

  set("inquiry", ([
]));


setup();
carry_object(__DIR__"obj/sword")->wield();
carry_object(__DIR__"obj/armor")->wear();
carry_object(__DIR__"obj/ring")->wear();

}

void init()
{
  object me=this_object();
  object my_weapon,my_armor1,my_armor2;
  string weapon_id="sword";
  string armor1_id="armor",armor2_id="ring";
  ::init();
  if (my_weapon=present(weapon_id, me))
       my_weapon->set("name",HIY"榴剑");
  if (my_armor1=present(armor1_id, me))
       my_armor1->set("name",HIC"暮云"NOR);
  if (my_armor2=present(armor2_id, me))
       my_armor2->set("name",HIB"思雨"NOR);
}
void unconcious()
{
	die();
}

