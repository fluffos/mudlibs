inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIM "莎拉公主" NOR, ({ "star xiaojia", "xiaojia" }));
  set("gender", "女性");
  set("title", HIB "驱神大圣" NOR);
  set("age", 73);

  set("attitude", "heroism");
  set("class", "yaomo");
  set("combat_exp", 5193562);
  set("daoxing", 12383700);
  set("kee", 1763);
  set("max_kee", 1763);
  set("sen", 1738);
  set("max_sen", 1738);
  set("max_force", 4770);
  set("force", 9540);
  set("max_mana", 4319);
  set("mana", 8638);
  set("force_factor", 250);
  set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
  set_skill("blade", 301);
  set_skill("dao", 301);
  set_skill("dodge", 360);
  set_skill("stick", 500);
  set_skill("force", 332);
  set_skill("huntian-qigong", 316);
  set_skill("kugu-blade", 358);
  set_skill("literate", 145);
  set_skill("parry", 360);
  set_skill("qixiu-jian", 362);
  set_skill("spells", 319);
  set_skill("sword", 361);
  set_skill("unarmed", 301);
  set_skill("yinfeng-zhua", 337);
  map_skill("dodge", "kugu-blade");
  map_skill("blade", "kugu-blade");
  map_skill("parry", "kugu-blade");
  map_skill("sword", "qixiu-jian");
  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("spells", "dao");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "blade", "pozhan" :),
    (: perform_action, "blade", "diyu" :),
    (: cast_spell, "fenshen" :),
  }));
  create_family("陷空山无底洞", 2, "弟子");
  setup();
  carry_object("/d/dntg/sky/stars/obj/chengdu_dao")->wield();
  carry_object("/d/dntg/sky/stars/obj/jmz")->wear();
  carry_object("/d/dntg/sky/stars/obj/vba")->wear();
}
void die() {
  if (environment())
    message("sound", "\n" + this_object()->query("name") + "嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_gin", 1000);
  set("eff_sen", 1500);
  set("kee", 2000);
  set("sen", 1500);
  set("gin", 1000);
}
void unconcious() {
  die();
}
