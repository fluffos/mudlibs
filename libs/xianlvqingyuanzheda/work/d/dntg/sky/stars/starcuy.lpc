inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIY "萧十一郎" NOR, ({ "star yanyan", "yanyan" }));
  set("gender", "男性");
  set("title", HIW "齐天大圣" NOR);
  set("long",
    HIY "天上地下，唯我独尊。\n" NOR);
  set("age", 91);

  set("attitude", "heroism");
  set("class", "mo");
  set("combat_exp", 13013332);
  set("daoxing", 10961000);
  set("kee", 1907);
  set("max_kee", 1907);
  set("sen", 1494);
  set("max_sen", 1494);
  set("max_force", 5200);
  set("force", 14000);
  set("max_mana", 4900);
  set("mana", 9800);
  set("force_factor", 250);
  set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
  set_skill("bainiao-jian", 419);
  set_skill("dodge", 419);
  set_skill("force", 349);
  set_skill("literate", 331);
  set_skill("parry", 419);
  set_skill("dengxian-dafa", 348);
  set_skill("spells", 349);
  set_skill("sword", 412);
  set_skill("ningxie-force", 322);
  set_skill("unarmed", 307);
  set_skill("yingzhaogong", 298);
  set_skill("xiaoyaoyou", 420);
  map_skill("dodge", "xiaoyaoyou");
  map_skill("sword", "bainiao-jian");
  map_skill("parry", "bainiao-jian");
  map_skill("unarmed", "yingzhaogong");
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "chaofeng" :),
  }));
  create_family("大雪山", 2, "弟子");
  setup();
  carry_object("/d/dntg/sky/stars/obj/xtang")->wield();
  carry_object("/d/dntg/sky/stars/obj/missing")->wear();
  carry_object("/d/dntg/sky/stars/obj/hearting")->wear();
}
void die() {
  if (environment())
    message("sound", "\n" + this_object()->query("name") + "嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_gin", 1000);
  set("eff_sen", 1500);
  set("kee", 2000);
  set("sen", 1500);
  set("gin", 1000);
}
void unconcious() {
  die();
}
