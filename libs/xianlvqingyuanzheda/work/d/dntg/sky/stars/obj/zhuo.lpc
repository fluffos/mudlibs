#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
   set_name(HIG "千年温玉镯" NOR, ({ "zhuo" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
      set("long", "采自蓝田的千年温玉，天然润滑。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

