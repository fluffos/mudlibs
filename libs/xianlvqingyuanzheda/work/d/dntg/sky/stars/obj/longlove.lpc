#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
         set_name(CYN "一剑钟情" NOR, ({"longlove"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                 set("unit", "柄");
                set("long", "一剑钟情\n");
                set("value", 0);
                set("material", "steel");
              set("keenness", 50);
        }
        init_sword(10);
        setup();
}


