#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create() {
  set_name(HIM "无敌魔杖" NOR, ({ "deat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "天下无双的魔杖。\n");
    set("value", 0);
    set("material", "steel");
    set("keenness", 50);
  }
  init_staff(10);
  setup();
}
