#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create()
{
  set_name(HIG "永远爱你" NOR, ({ "xjessy" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
   set("long", "永远爱翎儿。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

