string replace_long(string long);

varargs mapping random_location(mixed flag)
{
	string line, dir, tmp,dir_s;
	string *maps, *areas;
	int j,k;
	mixed*  files;
	object room;
	mapping location;
        location=allocate_mapping(4);
        j = random(sizeof(dirs));
        dir_s = dirs[j];
      //  dir_s = "/d/changan";
        files = get_dir( dir_s+"/*.lpc", -1 );
	j = random(sizeof(files));
	reset_eval_cost();
	for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(files));
           if( files[random(sizeof(files))][1] > 0)
             room=load_object(dir_s+"/"+files[j][0]);
	  }
	location["file"]=dir_s+"/"+files[j][0];
	location["room"]=room;
	location["long"]=replace_long(room->query("long"));
	return location;
}

string replace_long(string long)
{
	string tmp="", target="";
	int length, start, i;
	int blank_flag=0;
	
        if(strlen(long)<1) return "";     
	long=replace_string(long, "\n", "");

	for(i=0;i<strlen(long);i++)
		if(long[i]>160 && long[i]<255)
			tmp+=long[i..i];
	length=strlen(tmp);
	if(length<LIMIT_LENGTH*2)
		return "";
	start=random(length-LIMIT_LENGTH);
	if(start%2)
		start--;
	length=0;
	for(i=start;i<start+LIMIT_LENGTH;i+=2)
	{
		if(blank_flag<-random(2)-2)
		{
			target+="■";
			length++;
			if(random(2) || length>2)
			{
				blank_flag=0;
				length=0;
			}
		}
		else
		{
			blank_flag--;
			target+=tmp[i..i+1];
		}
	}
	return target;
}


