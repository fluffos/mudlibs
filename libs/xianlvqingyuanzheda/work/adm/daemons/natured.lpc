// This is called everyday noon by update_day_phase, defined in the
// "event_fun" field in /adm/etc/nature/day_phase

int online_user() {
  int i, ppl_cnt;
  object *usr = users();
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) continue;
    ppl_cnt++;
  }
  return ppl_cnt;
}
