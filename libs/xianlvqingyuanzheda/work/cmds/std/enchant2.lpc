// enchant.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int pts,max_enchant;
	
	max_enchant = (int)me->query("max_mana")/20 +1;
	pts = me->query_skill(me->query_skill_mapped("spells"),1) - 300;
	if(  pts > 0 )
		max_enchant = max_enchant + pts;
	else
		return notify_fail("你的法术等级不够，不能发出超强的威力。\n");
	if( arg == "max" )
	{
		pts = max_enchant;
	}
	else
	{
		return notify_fail("指令格式：enchant2 max \n");
	}

	if( pts > max_enchant )	//	((int)me->query("max_mana")/20+1) )
		return notify_fail("你的法力不足，发不出那么强的威力。\n");

	if( pts < 0 ) return notify_fail("法力点数必须是正数。\n");	
	me->set("mana_factor", pts);
	write("Ok.\n");
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: enchant2 max
 
这个指令让你设定使用魔法武器时要用来导引武器魔力所用的法力强度。
法力点数越高，魔法武器的杀伤力也越强。

HELP
	);
	return 1;
}

