// time.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{       object ob;
        
        seteuid(getuid(me));
        if(!arg) ob = me;
        else if (wizardp(me)) { ob = present(arg, environment(me));
             if (!ob) ob = find_player(arg);
             if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("您要察看谁的状态？\n");
        } 
		else return notify_fail("只有巫师才可以察看别人的状态。\n");
        
if( ( ob->query("family/family_name") != "方寸山三星洞"
            && ob->query("family/family_name") != "南海普陀山"
            && ob->query("family/family_name") != "月宫"
            && me->query("family/family_name") != "东海龙宫" 
            && ob->query("family/family_name") != "将军府"
            && ob->query("family/family_name") != "盘丝洞"
            && ob->query("family/family_name") != "蜀山剑派"
            && ob->query("family/family_name") != "五庄观"))             
         
{
       if(!ob->query("yao/get")) 
              { write("你没有任务在身。\n");
                return 1;
              }      
                                 
	write("你现在的任务是" + ob->query("yao/kind")+"散仙,"+ob->query("yao/where")+"。\n");
	write("难度：" + chinese_number(ob->query("yao/level"))+"\n");
	if(ob->query("yao/kind")=="降") write("要点:与散仙比武fight，打赢两次即可。如果guai受伤了,要给他金创药. \n");
	if(ob->query("yao/kind")=="杀") write("要点:把散仙杀掉就算完成任务. \n");
	if(ob->query("yao/kind")=="擒") write("要点:把散仙打昏，然后带回到通天教主处drop 即可. \n");
	if(ob->query("yao/kind")=="劝") write("要点:差不多打死散仙的时候，用persuade命令，劝散仙入教. \n");
	
	if (wizardp(me)) 
	      printf("妖怪：%O\n",ob->query("yao/guai"));
	return 1;

         if(!ob->query("yao/guai")) 
              { write("你的任务已经失败了。\n");
                return 1;
              }


}else{
        if(!ob->query("xian/get")) 
              { write("你没有任务在身。\n");
                return 1;
              }      
                                 
	write("你现在的任务是" + ob->query("xian/kind")+"妖,"+ob->query("xian/where")+"。\n");
	write("难度：" + chinese_number(ob->query("xian/level"))+"\n");
	if(ob->query("xian/kind")=="降") write("要点:与妖怪比武fight，打赢两次即可。如果guai受伤了,要给他金创药. \n");
	if(ob->query("xian/kind")=="杀") write("要点:把妖怪杀掉就算完成任务. \n");
	if(ob->query("xian/kind")=="擒") write("要点:把妖怪打昏，然后带回到原始天尊处drop 即可. \n");
	if(ob->query("xian/kind")=="劝") write("要点:差不多打死妖怪的时候，用persuade命令，劝妖怪回山. \n");
	
	if (wizardp(me)) 
	      printf("妖怪：%O\n",ob->query("xian/guai"));
	return 1;

         if(!ob->query("xian/guai")) 
              { write("你的妖怪已经不见了。\n");
                return 1;
              }

}

}

int help(object me)
{
     write(@HELP
指令格式: ctask

这个指令让你知道你现在的如来任务。

HELP
    );
    return 1;
}
 


