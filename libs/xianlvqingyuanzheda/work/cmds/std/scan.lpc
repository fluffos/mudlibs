#include <ansi.h>

void free(object target);

int main(object me, string arg)
{

    int ap,dp,i,howlong;
    object who;
    object *ob;
	
	if( me->is_busy())
		return notify_fail("你正忙着呢!\n");

    if (me->query("mana")<300)
	    return notify_fail("你的法力不足。\n");
    me->add("mana",-50);

	message_vision(HIY "$N凝了凝神，开始仔细打量周围!\n" NOR,me);
	
	me->start_busy(2);

    ap=me->query_skill("spells");
	ob= all_inventory(environment(me));
	 
	for( i = 0 ;i < sizeof(ob) ; i ++ )
	{
    dp=ob[i]->query_skill("spells");

    if ( random(ap) < 2*dp/3 )
		continue;
	if (me == ob[i])
	    continue;
	if ( ob[i]->query("env/invisibility") < 1 || wizardp(ob[i]))
	    continue;
	message_vision(HIY "$N的隐身法被$n看透了，$N吓得马上显出身来!\n\n" NOR, ob[i],me);

	ob[i]->set_temp("no_move", 1);
		howlong = random(ap - dp);
		if(howlong<1) howlong=1;
		if(howlong>15) howlong=15;
		call_out("free", howlong, ob[i]);  // alading add
//	ob[i]->set("yinshenstart", time());				
	ob[i]->delete_temp("yinshentime");
	ob[i]->set("env/invisibility", 0);      
	message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, ob[i]);
	ob[i]->delete_temp("no_heal_up/yinshen");
    }
	return 1;
}

void free(object target)
{
	if (target)
	target->delete_temp("no_move");      
	return;
}
	 
int help(object me)
{
      write(@HELP

指令格式 ： scan
	用此指令可以察看你身旁是否有人隐身，法术越强，成功率越高。
HELP
     );
     return 1;
}



