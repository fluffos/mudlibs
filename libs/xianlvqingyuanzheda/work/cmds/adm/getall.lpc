/*请不要连续使用本命令，特别是在人多的时候，会给系统带来很大负担*/

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string what)
{
    object ob, *ob_list, ob1,*inv;
    int i,j,number;
    string str;
    
    
    seteuid(getuid());

    ob_list = users();
    number=0;
    for(i=0; i<sizeof(ob_list); i++)
    {
        ob = ob_list[i];
		inv = all_inventory(ob);
        for(j=0; j<sizeof(inv); j++) 
        {if (inv[j]->query("id")==what)
		{
			destruct(inv[j]);
        tell_object(ob, HIG "你身上的("+what+")已经被巫师收回了\n" NOR);
		number=number+1;
		}
        }            
    }
    str = sprintf("共有 %d 位玩家被拿了%s。\n", number, what);    
    me->start_more(str);
    return 1;
}

int help(object me)
{
        write(@HELP
指令格式：getall 物品名字

从在线的所有玩家身上拿一件物品。
HELP
        );
        return 1;
}

