inherit F_CLEAN_UP;
#include <ansi.h>;
int main(object me, string arg) {
  if (!arg)
    return notify_fail("locate <物品>\n");
  else {
    if (me->query("sen") < 15)
      return notify_fail("你的精神不够了。\n");
    else
      "/adm/daemons/questd"->locate_quest(me, arg);
  }
  me->add("sen", -5);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :locate <物品ID>
探查某一样宝物在什么地方，比如:locate lao gudong.
HELP
  );
  return 1;
}
