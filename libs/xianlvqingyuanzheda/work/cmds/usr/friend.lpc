// make friend with sb
// by driftpho@YSZZ

#include <ansi.h>

inherit F_CLEAN_UP;
int main(object me,string arg)
{
        object ob;
        string* f_ids;
        mapping friends;
        string str,s1,s2,s3;
        int i;

	    if (time()-me->query_temp("scan_time") < 5 )
			return notify_fail("等等，系统喘气中......\n");

        me->set_temp("scan_time",time());


        friends = me->query("friends");
        if(!arg) 
        {
                if(!friends 
                || !mapp(friends)
                ||  (sizeof(friends) == 0))
                        return notify_fail("你还没有朋友呢！\n");
                f_ids = keys(friends);
                write("你现在的朋友有：\n");
                str = "";
                for(i=0;i<sizeof(f_ids);i++)
                {
				ob=find_player(f_ids[i]);
            		str += "  "+friends[f_ids[i]]+"("+f_ids[i]+")    ";
				if (!ob || (ob->query("env/invisibility") && wizardp(ob) )) 
                        str += "状态:离线\n";
				else
                        str += "状态:在线\n";
                }
                write(str);
                return 1;
        }
        if(sscanf(arg,"%s %s",s1,s2) ==2)
        {
                if(s1 == "-a")
                {
                        if(!objectp(ob = find_player(s2)))
                                return notify_fail("没这个人！\n");
//yudian wiz can only add wiz and usr can only add usr
  //                       if(!wizardp(me) && wizardp(ob))  return notify_fail("没这个人！\n");
  //                       if(wizardp(me) && !wizardp(ob))  return notify_fail("你不能将玩家列为好友！\n");
                        if(me->query("id") == s2)
                                return notify_fail("没这个必要吧！\n");
                        if(sizeof(friends)>15)
                                return notify_fail("你的好友也太多了吧!\n");
                        if(me->query("friends/"+s2))
                        return notify_fail(ob->query("name")+"已经是你的朋友了！\n");
                        me->set("friends/"+s2,ob->query("name"));
                        write("你将"+ob->query("name")+"加入好友名单！\n");

                        if(living(ob))
                        tell_object(ob,me->query("name")+"["+me->query("id")+"]把你加入他的好友名单！\n");
                        ob->set("friendof/"+me->query("id"),me->query("name"));
                        return 1;
                }
                else if(s1 == "-u")
                {
                        s3 = me->query("id");
                        if(!objectp(ob = find_player(s2)))
                                return notify_fail("没这个人！\n");
                        if(!ob->query("friends/"+s3))
                        return notify_fail("你不是对方的好友！\n");
                        ob->delete("friends/"+s3);
                        write("你把自己从"+ob->query("name")+"的好友名单中去掉了！\n");
                        return 1;
                }
               
                else if(s1 == "-d")
                {
                        if(!objectp(ob = find_player(s2)))
                                return notify_fail("没这个人！\n");
                        if(!me->query("friends/"+s2))
                        return notify_fail("你没这个朋友！\n");
                        me->delete("friends/"+s2);
                        write("你把"+ob->query("name")+"从好友名单中去掉了！\n");
                        return 1;
                }
        }
        write("用法:friend [-a|-d] name\n");
        return 1;
} 

int help(object me)
{
        string desc_dx, desc_fali, desc_exp;

        write(@HELP
指令格式 : friend [-a|-d|-u] [<某人>]

用这个命令可以让你查看或加,减好友,或从对方的好友名单中去掉自己。
HELP
    );
    return 1;
}



