// summon command..
// new "summon.lpc" by Dboykey (98.6.5)

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string str, string file) {
  object ob, where_me, where_ob, *obj = users();
  string ss_me, ss_ob, ll_me, ll_ob, new_status, str_all;
  string wiz_status;
  int i;

  wiz_status = SECURITY_D->get_status(me);

  where_me = environment(me);
  ss_me = (string)where_me->query("short");
  ll_me = (string)file_name(where_me);

  if (!str) return notify_fail("<Syntax>: Summon <player id>\n");

  if (wiz_status != "(admin)" && wiz_status != "(arch)" && wiz_status != "(wizard)") {
    ob = LOGIN_D->find_body(str);

    if (!ob) return notify_fail("咦... 有这个人吗?\n");
    tell_room(environment(ob), "侠客神使对" + (string)ob->query("name") + "说：'我家主人请您去一聚！请！'\n", ob);
    tell_object(ob, "侠客神使对你说：'我家主人请您去一聚！请！'\n");
    ob->move("/d/wizard/guest_room");
    tell_object(me, "你把" + (string)ob->query("name") + "一把捉起，但是....grin!!!\n");
    tell_object(ob, ".... 你已经被侠客神使带到" + (string)me->query("name") + "所在之处。\n");
    tell_room(environment(ob), (string)ob->query("name") + "被侠客神使带到这里。\n", ({ me, ob }));

    log_file("wiz_log/SUMMON_LOG",
      sprintf("(%s)\n%s summon %s.haha goto hell\n\n",
        ctime(time()), me->query("id"), ob->query("id")));

    return 1;
  }

  if ((sscanf(str, "%s", str_all) == 1) && (str_all == "all")) {
    for (i = 0; i < sizeof(obj); i++) {
      if (obj[i] == me) continue;
      tell_object(
        obj[i],
        HIR "\n你的脚下突然出现一个魔法阵图，并发出奇异的光华!突然，这个魔法阵象黑洞\n一样把你吸了进去，把你传送到遥远的地方去了!\n" NOR
      );
      obj[i]->move(environment(me));
    }
    tell_object(me, HIW "你把所有正在这块大陆上的人都传送到当前环境!\n" NOR);
    log_file("wiz_log/PLAYER_LOG",
      sprintf("(%s),%s summon all player to %s(%s)\n\n",
        ctime(time()), me->query("id"), ss_me, ll_me));

    return 1;
  }

  ob = LOGIN_D->find_body(str);
  where_ob = environment(ob);
  ss_ob = (string)where_ob->query("short");
  ll_ob = (string)file_name(where_ob);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");
  tell_room(environment(ob), "侠客神使对" + (string)ob->query("name") + "说：'我家主人请您去一聚！请！'\n", ob);
  tell_object(ob, "侠客神使对你说：'我家主人请您去一聚！请！'\n");
  ob->move(environment(me));
  tell_object(me, "你把" + (string)ob->query("name") + "请到你的面前.\n");
  tell_object(ob, ".... 你已经被侠客神使带到" + (string)me->query("name") + "所在之处。\n");
  tell_room(environment(ob), (string)ob->query("name") + "被侠客神使带到这里。\n", ({ me, ob }));

  log_file("wiz_log/PLAYER_LOG",
    sprintf("(%s)\n%s summon %s.由 %s(%s) 到 %s(%s)\n\n",
      ctime(time()), me->query("id"), ob->query("id"), ss_ob, ll_ob, ss_me, ll_me));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : summon <某人> or summon all

此指令可让你(□)将某人抓到你面前。
HELP
  );
  return 1;
}
