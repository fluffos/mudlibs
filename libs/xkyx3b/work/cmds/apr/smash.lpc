#include "/doc/help.h"

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob, ob_name, ob_id;

  if (!arg) return help(me);

  ob = present(arg, environment(me));
  if (!ob) return notify_fail("找不到这个生物。\n");

  message_vision("$N手一挥，一道闪电从天而降，将$n化为齑粉！！\n", me, ob);
  ob_name = ob->query("name");
  ob_id = ob->query("id");
  ob->die();

  log_file("wiz_log/PLAYER_LOG",
    sprintf("%s(%s) smash %s(%s) at (%s).\n\n",
      // me->name(1), geteuid(me), ob->name(1), ob->query("id"), ctime(time()) ));
      me->name(1), geteuid(me), ob_name, ob_id, ctime(time())));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: smash <生物>
 
将某个生物打死。

HELP
  );

  return 1;
}
