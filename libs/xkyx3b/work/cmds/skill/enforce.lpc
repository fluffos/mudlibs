// enforce.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  int pts;

  if (!arg || (arg != "none" && !sscanf(arg, "%d", pts))) return help(me);

  if (!me->query_skill_mapped("force"))
    return notify_fail("你必须先 enable 一种内功。\n");

  if (arg == "none") me->delete("force_factor");
  else {
    if (pts < 0 || pts > (int)me->query_skill("force") / 4)
      return notify_fail("你只能用 none 表示不运内力，或者用数字表示每一次攻击用几点内力。\n");
    me->set("force_factor", pts);
  }

  write("内功发力设置完毕。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：enforce <使出几点内力伤敌>    指定每次击中敌人时，发出几点内力伤敌。
          enforce none                  指定每次击中敌人时，不发内力伤敌。
 
指定每次击中敌人时，发出几点内力伤敌。

参考命令：enable、enchant。

HELP
  );

  return 1;
}
