// recruit_player.c
// 修改：大鱼（Chance）----cn_chance@163.net

#include <ansi.h>

//inherit F_CLEAN_UP;

int help(object me);


void give_title(object me)
{
   int number;
   number=me->query("faction/generation");
   switch (number )
    {
      case 0: me->set("title",me->query("faction/name")+"教主");
              break;
      case 1: me->set("title",me->query("faction/name")+"左护法");
              break;
      case 2: me->set("title",me->query("faction/name")+"右护法");
              break;
      case 3:
      case 4:
      case 5:
      case 6:
            me->set("title",me->query("faction/name")+"长老");
             break;
      default: me->set("title",me->query("faction/name")+"帮众");
    }
  
}


int main(object me, string arg)
{
        object ob, old_rec;
        mapping family;
        mapping baozang;
        int i;
        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        if( !arg ) return help(me);
        if( arg == "cancel" ) {
                old_rec = me->query_temp("pending/recruit");
                if( !objectp(old_rec) )
                        return notify_fail("你现在并没有收录任何人为弟子的意思。\n");
                write("你改变主意不想收" + old_rec->name() + "为弟子了。\n");
                tell_object(old_rec, me->name() + "改变主意不想收你为弟子了。\n");
                me->delete_temp("pending/recruit");
                return 1;
        }

        if( !(ob = present(arg, environment(me))) )
                return notify_fail("你想收谁作弟子？\n");

        if( ob == me ) return notify_fail("收自己为弟子？好主意....不过没有用。\n");
        if( me->query("faction/name")==ob->query("faction/name") ) {
                message_vision("$N拍拍$n的头，说道：“好兄弟！”\n", me, ob);
                give_title( ob );        // 重新设定玩家的RANK
                return 1;
        }

        if( !me->query("faction") )
                return notify_fail("你并不属於任何门派，你必须先加入一个门派，或自己创一个才能收徒。\n");
        if(me->query("faction/generation"))
                return notify_fail("只有教主才能接收教众，好好努力吧。");

        // If the target is willing to apprentice us already, we do it.
        if( (object)ob->query_temp("pending/apprentice") == me ) {
                if( !living(ob) ) {
                        message_vision( "$N决定收$n为弟子。\n\n"
                                "不过看样子$n显然没有办法行拜师之礼。\n\n", me, ob);
                        return 1;
                }
                // follow modified by elon 09-10-95 to fix a bug in 1st time recruit
                if((ob->query("faction")) && ( (string)me->query("faction/name") != (string)ob->query("faction/name") ) ) {
                        message_vision(
                                "$N决定背叛师门，改投入$n门下！\n\n"
                                "$N跪了下来向$n恭恭敬敬地磕了四个响头，叫道：「教主！」\n\n", ob, me);
                        ob->set("score", 0);
//                        ob->add("faction/betrayer", 1);
                } else
                        message_vision("$N决定收$n为弟子。\n\n"
                                "$n跪了下来向$N恭恭敬敬地磕了四个响头，叫道：「教主！」\n",
                                me, ob);

                ob->delete_temp("pending/apprentice");

                ob->set("faction/name",me->query("faction/name"))	;
                me->add("faction/times",1);
                ob->set("faction/generation",me->query("faction/times"));
                give_title(ob);

                tell_object( ob, sprintf("恭喜您成为%s。\n", ob->query("title")) );

                write("恭喜你新收了一名弟子！\n");
                return 1;
        

        } else {
                old_rec = me->query_temp("pending/recruit");
                if( ob==old_rec )
                        return notify_fail("你想收" + ob->name() + "为弟子，但是对方还没有答应。\n");
                else if( objectp(old_rec) ) {
                        write("你改变主意不想收" + old_rec->name() + "为弟子了。\n");
                        tell_object(old_rec, me->name() + "改变主意不想收你为弟子了。\n");
                }

                me->set_temp("pending/recruit", ob );
                message_vision("\n$N想要收$n为弟子。\n", me, ob);
                tell_object(ob, YEL "如果你愿意拜" + me->name() + "为师父，用 bai_player 指令。\n" NOR);
                return 1;
        }
}


int help(object me)
{
        write(@HELP
指令格式：recruit_player <对象>
          recruit_player cancel
 
这个指令能让你收某人为弟子，如果对方也答应要加入你的帮派的话。
 
HELP
        );

        return 1;
}
