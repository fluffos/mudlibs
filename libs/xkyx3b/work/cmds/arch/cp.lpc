// cp.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  string src, dst, *dirs;

  seteuid(geteuid(me));
  if (!arg || sscanf(arg, "%s %s", src, dst) != 2) return help(me);

  src = resolve_path(me->query("cwd"), src);
  dst = resolve_path(me->query("cwd"), dst);

  if (file_size(dst) == -2) {
    dirs = explode(src, "/");
    dst += "/" + dirs[sizeof(dirs) - 1];
  }

  if (cp(src, dst)) {
    log_file("wiz_log/FILES_LOG",
      sprintf("%s(%s) copy (%s) to (%s) at (%s)\n",
        me->query("name"), me->query("id"), src, dst, ctime(time())));
    write("文件复制成功。\n");
  } else
    write("你没有足够的读写权利。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：cp <源文件名> <目标文件名>
 
复制文件。

HELP
  );

  return 1;
}
