// mkdir.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  string dir;

  if (!arg) return help(me);

  dir = resolve_path(me->query("cwd"), arg);

  seteuid(geteuid(me));
  if (mkdir(dir)) {
    log_file("wiz_log/FILES_LOG",
      sprintf("%s(%s) mkdir (%s) at (%s)\n",
        me->query("name"), me->query("id"), dir, ctime(time())));
    write("子目录创建成功。\n");
  } else
    write("你没有在这里创建子目录的权利。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : mkdir <子目录名>

创建子目录。

HELP
  );

  return 1;
}
