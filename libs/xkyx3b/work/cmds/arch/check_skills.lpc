// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6

/*
我们打算对目前没有学会任何技能玩家的ＩＤ进行清洗。

我们认为，如果玩家真正想使用一个ＩＤ的话，
通常会在刚上来就学会某种技能，如读书识字，基本拳脚等等，而不至于无一技防身。

如果你的人物到现在还没有学会任何一种技能的话，
就会有被清洗的危险。
*/

#include <ansi.h>

inherit F_CLEAN_UP;

string f, new_f;

int help(object me);
object make_body(object ob);

int main(object me, string arg) {
  object ob, user;
  string *dir, *ppls, name, status;

  mapping skl;

  int i, j, ppl_cnt, count;

  status = wizhood(me);
  if (me != this_player(1) || wiz_level(me) < wiz_level(status))
    return notify_fail("你没有权力使用这个指令。\n");

  seteuid(getuid());
  message("system", "\n*** 整理玩家储存资料，请稍候 ***\n", users());
  write("处理中：\n");
  count = 0;
  ppl_cnt = 0;
  dir = get_dir(USER_DIR);
  for (i = 0; i < sizeof(dir); i++) {
    reset_eval_cost();
    write("扫描目录：" + dir[i] + "....\n");
    ppls = get_dir(USER_DIR + dir[i] + "/");
    ppl_cnt += sizeof(ppls);
    for (j = 0; j < sizeof(ppls); j++) {
      if (sscanf(ppls[j], "%s", name) == 1)
        if ((string)SECURITY_D->get_status(name) != "(player)")
          continue;
      if (file_size(USER_DIR + dir[i] + "/" + ppls[j] + "/login" + __SAVE_EXTENSION__) < 0
        || file_size(USER_DIR + dir[i] + "/" + ppls[j] + "/user" + __SAVE_EXTENSION__) < 0) {
        write("清除非法帐号：" + ppls[j] + "\n");
        rmhirdir(USER_DIR + dir[i] + "/" + ppls[j]);
        count++;
        continue;
      }

      user = new(LOGIN_OB);
      user->set("id", name);
      if (user->restore() && user)
        if (objectp(ob = make_body(user)))
          if (ob->restore()) {

            skl = ob->query_skills();
            if (!sizeof(skl)) {
              write(ob->query("name") + "（" + ob->query("id") + "）目前并没有学会任何技能。\n");
            } else {}

            destruct(user);
            destruct(ob);
          } else {
            write("没有这个玩家：" + ppls[j] + "\n");
            destruct(user);
            continue;
          }
    }
  }
  return 1;
}

object make_body(object ob) {
  string err;
  object user;
  int n;
  if (!ob->query("id")) return 0;
  user = new(USER_OB);
  if (!user) return 0;
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

int help(object me) {
  write(@HELP
指令格式：check_skills           查出所有没有技能的人物

HELP
  );

  return 1;
}
