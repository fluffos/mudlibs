// cleanup.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string str) {
  object ob, where, *ob_list;
  int old_size, i;

  if (!str) return help(me);

  str = resolve_path(me->query("cwd"), str);
  ob_list = children(str);
  old_size = sizeof(ob_list);
  ob_list->clean_up();
  for (i = 0; i < sizeof(ob_list); i++)
    if (ob_list[i] && clonep(ob_list[i]) && !environment(ob_list[i]))
      destruct(ob_list[i]);
  ob_list -= ({ 0 });
  printf("清除 %d 个物件。\n", old_size - sizeof(ob_list));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：cleanup <文件名>

对所有指定文件名的物件执行clean_up，并且清除所有被复制出来的，但
是又没有被放在另一个物件中的散失物件。

HELP
  );

  return 1;
}
