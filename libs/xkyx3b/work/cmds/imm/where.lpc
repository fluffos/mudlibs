// where.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string str) {
  object ob;

  if (!str) return help(me);

  ob = find_player(str);
  if (!ob) ob = find_living(str);
  if (ob) {
    message("vision", "你用神力看到：\n", this_player());
    "/cmds/std/look"->look_room(this_player(), environment(ob));
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: where <玩家的 ID>

得知玩家目前所在的位置。

HELP
  );

  return 1;
}
