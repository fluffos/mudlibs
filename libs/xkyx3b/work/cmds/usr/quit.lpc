// quit.c
#include <ansi.h>

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
  set("name", "离线指令");
  set("id", "quit");
}

int main(object me, string arg) {
  int i;
  object *inv, link_ob, ob;

  object tg_ob, tc_ob, g_ob, s_ob, c_ob;
  int tgc, tcc, gc, sc, cc;


  if (me->query_temp("suicide_countdown")) {
    CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "终于想通了，放弃自杀了。 :)");
    tell_object(me, MAG "\n\n你决定要放弃自杀，太好了，那下次再来吧！\n\n\n" NOR);
  } else {
    if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

    if (!wizardp(me) && me->is_busy()) return notify_fail("你现在正忙着呢！\n");

    if (me->query_encumbrance() >= me->query_max_encumbrance())
      return notify_fail("你身上的东西太重了，不能退出！\n");

    // if( me->query_temp("suicide_countdown") )
    //         return notify_fail("你刚才杀了玩家，十五分钟内不能退出游戏！\n");
  }
  if (ob = present("my animal", me)) {
    me->set("animal/life", ob->query("horse_prop/life"));
  }

  if (!wizardp(me)) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }
  /*
        if (tg_ob = present("thousand-gold", me)) {
                tgc = tg_ob->query_amount();
                destruct(tg_ob);
        }
        else
                tgc = 0;
        if (tc_ob = present("thousand-cash", me)) {
                tcc = tc_ob->query_amount();
                destruct(tc_ob);
        }
        else
                tcc = 0;
        if (g_ob = present("gold_money", me)) {
                gc = g_ob->query_amount();
                destruct(g_ob);
        }
        else
                gc = 0;
        if (s_ob = present("silver_money", me)) {
                sc = s_ob->query_amount();
                destruct(s_ob);
        }
        else
                sc = 0;
        if (c_ob = present("coin_money", me)) {
                cc = c_ob->query_amount();
                destruct(c_ob);
        }
        else
                cc = 0;
        
        me->add("bank_money", cc + sc * 100 + gc * 10000 + tcc * 100000 + tgc * 10000000);
*/
  link_ob = me->query_temp("link_ob");

  // We might be called on a link_dead player, so check this.
  if (link_ob) {

    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }

    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(me));
    link_ob->save();
    destruct(link_ob);
  }

  write("欢迎下次再来！\n");
  message("system", me->name() + "离开游戏。\n", environment(me), me);

  CHANNEL_D->do_channel(this_object(), "sys", me->name() + "离开游戏了。");

  // Micro : check
  if ((int)me->query("combat_exp") - (int)me->query("exp") >= 10000
    || (int)me->query("exp") - (int)me->query("combat_exp") >= 10000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 退出。经验：%d -> %d\n",
      me->query("name"), me->query("id"),
      ctime(time()),
      (int)me->query("exp"), (int)me->query("combat_exp")));
  }
  if ((int)me->query("potential") - (int)me->query("pot") >= 1000
    || (int)me->query("pot") - (int)me->query("potential") >= 1000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 退出。潜能：%d -> %d\n",
      me->query("name"), me->query("id"),
      ctime(time()),
      (int)me->query("pot") - (int)me->query("learned_points"),
      (int)me->query("potential") - (int)me->query("learned_points")));
  }
  me->set("exp", (int)me->query("combat_exp"));
  me->set("pot", (int)me->query("potential"));
  if (me->query_temp("抢劫中")) {
    tell_object(me, "你决定停止拦路抢劫。\n");
    me->delete("greeting_msg");
    me->set("id", me->query("old_id"));
    me->set("name", me->query("old_name"));
    me->set("nickname", me->query("old_nick"));
    me->set("title", me->query("old_title"));
    me->delete("old_id");
    me->delete("old_name");
    me->delete("old_nick");
    me->delete("old_title");
    me->delete_temp("抢劫中");
    me->delete_temp("不准走");
  }

  me->save();

  log_file("USAGE", sprintf("%s（%s）在 %s 退出。经: %d, 潜: %d, 钱: %d\n",
    me->query("name"), me->query("id"),
    ctime(time()),
    me->query("combat_exp"),
    (int)me->query("potential") - (int)me->query("learned_points"),
    me->query("bank_money")));

  destruct(me);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：quit

当你想暂时离开时，可利用此一指令。如果你杀死别的玩家，将在十五分
钟之内不能退出。

相关讯息：save
HELP
  );

  return 1;
}
