int main(object me, string arg) {
  seteuid(geteuid(me));

  PROFILE_D->make_profile(arg);
  write("结果已经写入文件：/FROFILE 。\n");

  return 1;
}
int help(object me) {
  write(@HELP
指令格式：profile
 
打开命令的描述，结果将被写入文件：/FROFILE。
 
HELP
  );

  return 1;
}
