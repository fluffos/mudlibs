// passwd2.c
//用来修改玩家密码，只开放给arch以上巫师。
//Create By Hunter

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob, pl;
  string msg;
  int newob = 0;

  seteuid(getuid());

  if (wizhood(me) == "(admin)" || wizhood(me) == "(arch)") {
    if (!arg) return notify_fail("你想改谁的密码?\n");
    if (me != this_player(1)) return 0;

    if (!pl = find_player(arg)) {
      newob = 1;
      ob = new(LOGIN_OB);
      ob->set("id", arg);
      if (!ob->restore()) return notify_fail("没有这个user。\n");
    }
    if (!newob) {
      ob = pl->query_temp("link_ob");  //在线上，只需要query link_ob
      if (!ob) return 0;
      while (ob && ob->is_character()) ob = ob->query_temp("link_ob");
    }

    if (wiz_level(me) < wiz_level(ob))
      return notify_fail("不能修改权限高于你的人的密码。\n");

    msg = sprintf("请输入玩家%s现在的密码:", arg);
    write(msg);

    input_to("get_new_pass", 1, ob, newob);

    return 1;
  }

  return notify_fail("你没有权限做这种事!\n");

}


private void get_new_pass(string pass, object ob, int newob) {
  // if(!LOGIN_D->check_legal_password(ob,pass))  return ;
  write("\n请再输入一次新的密码：");
  input_to("confirm_new_pass", 1, ob, crypt(pass, 0), newob);
}

private void confirm_new_pass(string pass, object ob, string new_pass, int newob) {
  write("\n");
  if (crypt(pass, new_pass) != new_pass) {
    write("对不起，您输入的密码并不相同，继续使用原来的密码。\n");
    return;
  }
  seteuid(getuid());
  if (!ob->set("password", new_pass)) {
    write("密码变更失败！\n");
    return;
  }

  ob->save();
  write("密码变更成功。\n");
  log_file(
    "wiz_log/ch_passwd",
    geteuid(this_player()) + " 修改了 " + ob->query("id") + " 的密码 on " + ctime(time()) + "\n"
  );

  if (newob) destruct(ob);

}

int help(object me) {
  write(@HELP
指令格式 : passwd2 <玩家名>
 
这个指令可以修改玩家的密码，所做的变更系统将会自动记录下来。
 
HELP
  );
  return 1;
}
