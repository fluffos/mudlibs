// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

#include "/doc/help.h"

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  string option, target, msg;

  object obj;

  if (!arg) return help(me);

  if (sscanf(arg, "%s %s", option, target) != 2) target = arg;

  if (option == "-r" && (string)SECURITY_D->get_status(me) == "(admin)")
    seteuid(ROOT_UID);
  else
    seteuid(geteuid(me));

  obj = find_object(target);
  if (!obj) obj = present(target, me);
  if (!obj) obj = present(target, environment(me));
  if (!obj) obj = find_object(resolve_path(me->query("cwd"), target));
  if (!obj) return notify_fail("没有这样物件。\n");

  if (environment(me) == environment(obj))
    if (!stringp(msg = me->query("env/msg_dest"))) msg = "$N召唤出一个黑洞，将$n吞没了。\n";
  message_vision(msg + "\n", me, obj);

  destruct(obj);
  if (obj) write("你无法将这个物件摧毁。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：dest [-r] <物件之名称或档名>

将某个物件（Object）或者物件定义（Class ）从内存中清除。若清除物
件定义（即：指定档名的情况下）则在下次参考到这个物件的时候会重新
将它编译。

（admin ）可以用 -r 选项以 ROOT_UID 身分来清除被保护物件如使用者。

参考资料：destruct()

HELP
  );

  return 1;
}
