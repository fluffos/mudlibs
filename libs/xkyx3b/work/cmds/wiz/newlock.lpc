// newlock.c	(禁止新手连进)
// By Key	1999-02-26

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int lvl;

  if (me != this_player(1)) return 0;

  if (wiz_level(me) < wiz_level("(wizard)"))
    return notify_fail("你的巫师等级太低，没有使用这个指令的权力。\n");
  if (!arg || arg == "")
    return notify_fail("指令格式：newlock <0/1>\n");

  if (sscanf(arg, "%d", lvl) != 1)
    return notify_fail("指令格式：newlock <0/1>\n");
  seteuid(getuid());
  if (LOGIN_D->set_newuser_lock(lvl)) {
    write(MUD_NAME + "开始不接受新人物！\n");

    log_file("wiz_log/ban&pass_log",
      sprintf("%s(%s) 不收新手 at (%s).\n",
        me->name(), me->query("id"), ctime(time())));

    return 1;
  } else

    log_file("wiz_log/ban&pass_log",
      sprintf("%s(%s) 接受新手 at (%s).\n",
        me->name(), me->query("id"), ctime(time())));

  return notify_fail(MUD_NAME + "开始接受新人物。\n");
}

int help(object me) {
  write(@HELP
指令格式: newlock <0/1>
 
限制本MUD是否接受新人物．
 
HELP
  );
  return 1;
}
