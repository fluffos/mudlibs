// drop.c

#include <move.h>

inherit F_CLEAN_UP;

int can_drop(object me, object obj);
int do_drop(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object obj, *inv, obj2;
  int i, amount;
  string item;

  if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

  if (!arg) return notify_fail("你要丢弃什麽东西？\n");

  if (sscanf(arg, "%d %s", amount, item) == 2) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西。\n");
    if (stringp(obj->query("no_drop")))
      return notify_fail((string)obj->query("no_drop"));
    if (!obj->query_amount())
      return notify_fail(obj->name() + "不能被分开丢弃。\n");
    if (amount < 1)
      return notify_fail("东西的数量至少是一个。\n");
    if (amount > obj->query_amount())
      return notify_fail("你没有那麽多的" + obj->name() + "。\n");
    else if (amount == (int)obj->query_amount()) {
      if (!can_drop(me, obj)) return 0;
      return do_drop(me, obj);
    } else {
      obj->set_amount((int)obj->query_amount() - amount);
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      if (!can_drop(me, obj2)) {
        obj->set_amount(obj->query_amount() + obj2->query_amount());
        destruct(obj2);
        return 0;
      }
      // Micro: drop, get, put, give这个地方都有一个问题
      //        就是query_amount()反应得来否？见bankowner
      if (obj->query_amount() <= 0) destruct(obj);
      return do_drop(me, obj2);
    }
  }

  if (arg == "all") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if (!can_drop(me, inv[i])) continue;
      do_drop(me, inv[i]);
    }
    write("完成。\n");
    return 1;
  }

  if (!objectp(obj = present(arg, me))) return notify_fail("你身上没有这样东西。\n");

  if (!can_drop(me, obj)) return 0;
  return do_drop(me, obj);
}

int do_drop(object me, object obj) {
  object obj2, *inv;

  if (obj->query("no_drop"))
    return notify_fail(stringp(obj->query("no_drop")) ?
      obj->query("no_drop") : "这样东西不能随意丢弃。\n");


  if (userp(me) && obj->query("money_id") && obj->value() >= 10000) {
    log_file("DROP_GET_LOG", sprintf("%s %s（%s）在%s丢下一%s（%d）%s。\n",
      ctime(time()), me->query("name"), me->query("id"),
      (stringp(environment(me)->query("short"))) ?
      environment(me)->query("short") : environment(me)->query("name"),
      obj->query("unit"), obj->query_amount(), obj->name()));
  }


  if (obj->query_amount() && objectp(obj2 = present(obj->query("id"), environment(me)))) {
    obj2->set_amount((int)obj2->query_amount() + (int)obj->query_amount());
    message_vision(sprintf("$N丢下一%s$n。\n", obj->query("unit")), me, obj);
    if ((!obj->query("value") && !obj->value())) {
      write("因为这样东西并不值钱，所以人们并不会注意到它的存在。\n");
    }
    destruct(obj);
    return 1;
  } else {
    // Donnot let the user drop more than 50 things to room.
    inv = all_inventory(environment(me));
    if (sizeof(inv) > MAX_CARRY) {
      return notify_fail("地上已经那么多东西了，你想干嘛？\n");
    }

    if (obj->move(environment(me))) {
      if (obj->is_character())
        message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else {
        if (mapp(obj->query("horse_prop")))   // 判断是否马
          message_vision(sprintf("$N放走一%s$n。\n", obj->query("unit")), me, obj);
        else
          message_vision(sprintf("$N丢下一%s$n。\n", obj->query("unit")), me, obj);
        if (!obj->query("value") && !obj->value()) {
          write("因为这样东西并不值钱，所以人们并不会注意到它的存在。\n");
          destruct(obj);
        }
      }
      return 1;
    }
    return 0;
  }
}

int can_drop(object me, object obj) {
  if (obj->query("no_drop"))
    return notify_fail(stringp(obj->query("no_drop")) ?
      obj->query("no_drop") : "这样东西不能随意丢弃。\n");
  /*
        if( present( "banker", environment(me) ) && stringp(obj->query("money_id")) ) 
                return notify_fail("旁边的人正睁大眼睛盯着你手中的钱！\n");
*/
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：drop <物品名称>
 
丢下所携带的物品。
 
HELP
  );

  return 1;
}
