// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  object weapon;
  extra = me->query_skill("tianmo-blade", 1);
  if (extra < 120) return notify_fail("你的［天魔刀法］还不够纯熟！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天地人魔］只能对战斗中的对手使用。\n");
  if (me->query("force") < 600)
    return notify_fail("你内力不够！\n");
  weapon = me->query_temp("weapon");
  msg = HIR "$N神气贯通，将天魔连环八式一气呵成！\n万魔初醒！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "魔焰万丈！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "魔光乍现！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "天魔独尊！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "万刃天魔！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "天魔回天！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "天魔七现！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "万魔归宗！" NOR; message_vision(msg, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add("force", -500);
  me->start_busy(5);
  return 1;
}
