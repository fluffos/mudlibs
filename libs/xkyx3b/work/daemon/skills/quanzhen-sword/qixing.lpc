// 七星聚会 

#include <ansi.h>

inherit SSERVER;
void qixing(object me, object target, int skill);
int perform(object me, object target) {
  object weapon;
  int i, skill;
  string msg;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("七星聚会只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("quanzhen-sword", 1) < 135)
    return notify_fail("你的全真剑法不够娴熟，不会使用「七星聚会」。\n");

  if ((int)me->query_skill("xiantian-force", 1) < 100)
    return notify_fail("你的先天神功火候不够，不能使用「七星聚会」。\n");

  if ((int)me->query("force") < 700)
    return notify_fail("你的内力不够。\n");
  me->add("force", -600);
  skill = me->query_skill("quanzhen-sword");
  msg = HIC "$N左手捏一个剑决，大喝一声，手中" + weapon->name() + "剑光化作七星，漫天闪向$n!" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", -skill * 2);
  me->add_temp("apply/damage", -skill * 2);
  for (i = 0; i < 7; i++) COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  me->add_temp("apply/attack", skill * 2);
  me->add_temp("apply/damage", skill * 2);
  call_out("qixing", 1, me, target, skill,);
  me->start_busy(1); target->start_busy(1);
  return 1;
}

void qixing(object me, object target, int skill) {
  string msg;
  if (!target || !living(target)) return;
  msg = HIY "\n\n$N把剑光忽地收拢，一招「七星聚会」，如夜空流星瞬间闪出！七星光华，尽在此一剑！\n\n" NOR;
  message_vision(msg, me, target);
  if (random(me->query_skill("sword") + target->query_skill("dodge")) > target->query_skill("dodge") / 2) {
    message_vision(HIR "$n被这股巨力猛然击中，只觉得魂魄一下子空荡荡的，还未感觉到身上已经中招！\n"
      + "“哇”的吐出大口鲜血，带着疑惑的神色，倒下了。\n\n" NOR, me, target);
    target->receive_damage("kee", skill * 20 + random(skill * 10));
    target->receive_wound("kee", skill * 10 + random(skill * 10));
    target->start_busy(2);
    COMBAT_D->report_status(target);
  } else message_vision(WHT "$N冷笑一声，看穿了剑势，往旁边闪了开去。\n" NOR, target);
  me->start_busy(3);
}
