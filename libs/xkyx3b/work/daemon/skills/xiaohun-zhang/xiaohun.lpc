// xiaohun.c 黯然消魂
// By seasong .1999
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit SSERVER;
void end_say(object me, object target, int type);
int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int mul, type, damage, ap, dp;
  me->clean_up_enemy();
  target = me->select_opponent();
  if (!me->is_fighting())
    return notify_fail("「黯然消魂」只能在战斗中使用。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return 0;

  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("xiaohun-zhang", 1) < 160)
    return notify_fail("你的黯然消魂掌火候不够，无法使用「黯然消魂」！\n");
  if ((int)me->query_skill("force") < 400)
    return notify_fail("你的内功修为不够，无法使用「黯然消魂」！\n");
  if ((int)me->query("kee") * 2 > (int)me->query("max_kee"))
    return notify_fail("你现在没到危急时刻，这招怎么也使不出来！\n");
  if (!stringp(me->query("marry")))
    return notify_fail("你没有所爱的人，不能领会「黯然消魂」的精要！\n");
  mul = (int)me->query("max_kee") / ((int)me->query("kee") + 1);
  if (mul > 3) mul = 3;
  damage = me->query_skill("xiaohun-zhang", 1);
  ap = me->query_skill("dodge") + me->query_skill("xiaohun-zhang", 1);
  dp = target->query_skill("dodge");
  ap *= mul; damage *= mul;
  msg = HIM "\n$N" HIC "$N伤痕累累，心头沉重，却思念着爱人，无意之中拍出一掌" HIR "“黯然消魂”！\n\n" NOR;
  if (random(ap + dp) > dp) {
    msg += WHT "这掌无比沉重，恍恍惚惚，无声无息地拍在了$n胸口，$n哪里能躲得开？！\n" NOR;
    target->receive_damage("kee", damage * 3 + random(damage * 2), me);
    target->receive_wound("kee", damage * 2 + random(damage), me);
    target->receive_damage("gin", damage + random(damage), me);
    target->receive_wound("gin", damage / 2 + random(damage), me);
    target->receive_damage("sen", damage + random(damage), me);
    target->receive_wound("sen", damage / 2 + random(damage), me);
    msg += HIR "$n“哇”的一声，鲜血从嘴角流了下来，兀自不相信自己被击中了。\n\n" NOR;
    target->start_busy(3); me->start_busy(4); type = 0;
    if (target->query("kee") < 0 || target->query("sen") < 0 || target->query("gin") < 0) {
      target->set("kee", 1); target->set("sen", 1); target->set("gin", 1); type = 1;
    }
    if (target->query("eff_kee") < 0 || target->query("eff_sen") < 0 || target->query("eff_gin") < 0) {
      target->set("eff_kee", 1); target->set("eff_sen", 1); target->set("eff_gin", 1); type = 2;
    }
    call_out("end_say", 2, me, target, type);
  } else {
    msg += "$N经验老道，心光一闪，在千钧一发一际闪了开去！倒流了一身冷汗。\n\n" NOR;
    damage = 0;
  }
  message_vision(msg, me, target);
  if (damage > 0) COMBAT_D->report_status(target);
  me->add("force", -700);
  me->start_busy(2 + random(3));
  return 1;
}

void end_say(object me, object target, int type) {
  string msg = HIR "\n\n半晌，$N才喃喃的说道：“这.....这就是销魂？！”，脸上肌肉颤抖着。\n" NOR;
  if (!target || !living(target)) return;
  if (type == 1) {
    msg += HIR "$N猛的又吐出一口鲜血，眼前一黑，倒了下去。\n" NOR;
    target->receive_damage("sen", target->query("max_sen") + 100, me);
    target->receive_damage("kee", target->query("max_kee") + 100, me);
  } else if (type == 2) {
    msg += HIR "$N瞪大了眼睛，死不瞑目似的，狂吐鲜血，整个人软软地倒了下去。\n" NOR;
    target->receive_wound("sen", target->query("max_sen") + 100, me);
    target->receive_wound("kee", target->query("max_kee") + 100, me);
  }
  message_vision(msg, target);
}
