mapping fail_action = ([ "action": "你打出一招“黯然销魂掌”，却怎么也体会不到真正“销魂”的感觉。\n",
  "force": -500,
  "dodge": -500,
  "parry": -500,
  "damage": -500,
  "skill_name": "黯然销魂掌",
  "damage_type": "瘀伤"
]);

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if (!stringp(me->query("marry")))
    return notify_fail("你没有所爱的人，不能领会其中的精要！\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练黯然消魂掌必须空手。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力太弱，无法练黯然消魂掌。\n");
  if ((int)me->query("spi") < 35)
    return notify_fail("你的灵性太弱，无法领悟黯然消魂掌。\n");
  if ((int)me->query("str") < 40)
    return notify_fail("你的臂力太弱，无法修炼黯然消魂掌。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("xiaohun-zhang", 1);
  if (!stringp(me->query("marry"))) return fail_action;
  else for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"]) return action[random(i)];
}

int practice_skill(object me) {
  if (!stringp(me->query("marry")))
    return notify_fail("你没有所爱的人，不能领会其中的精要！\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练黯然消魂掌。\n");
  me->receive_damage("kee", 25);
  me->add("force", -30);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("kee", (damage_bonus - 100) / 2);
    return HIR "只听到“哇”的一声，$n喷出了一大口鲜血！\n" NOR;
  }
}
string perform_action_file(string action) {
  return __DIR__ "xiaohun-zhang/" + action;
}


int enable_factor() { return 200; }

int learn_factor(int n) {
  if (n < 100) return 100;
  else return 80;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 1; }

int practice_factor() { return 90; }
int practice_bonus() { return 1; }
