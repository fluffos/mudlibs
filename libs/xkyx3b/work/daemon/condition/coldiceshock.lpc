// clodiceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  me->receive_damage("gin", 5);
  me->receive_wound("kee", 5);
  me->receive_damage("sen", 5);

  me->apply_condition("coldiceshock", duration - 1);

  tell_object(me, HIB "你中的寒冰绵掌的寒毒发作了！\n" NOR);
  if (duration < 1) return 0;

  return CND_CONTINUE;
}
