int valid_combine(string combo) { return combo == "tianmo-sword"; }

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int valid_learn(object me) {
  object ob;
  int level;

  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能练天魔刀法。\n");
  level = me->query_skill("tianmo-blade");
  if (-level * level * level / 10 < me->query("SEN"))
    return notify_fail("修练天魔刀法，要心狠手辣，奸恶歹毒。你好象做得不够呀！\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("tianmo-blade", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"]) return action[random(i)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够练天魔刀法。\n");
  me->receive_damage("kee", 35);
  write("你按著所学练了一遍天魔刀法。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tianmo-blade/" + action;
}

int enable_factor() { return 190; }

int learn_factor(int n) {
  if (n < 100) return 110;
  else return 90;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 1; }

int practice_factor() { return 100; }
int practice_bonus() { return 1; }
