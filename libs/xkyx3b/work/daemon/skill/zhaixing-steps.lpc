// zhaixing-steps.c - 摘星步法

inherit SKILL;

string *dodge_msg = ({
  "只见$n一招「物换星移」，足不点地，一转眼间便绕到了$N的身后。\n",
  "只见$n一招「明月皎皎」，身形飘忽，轻轻一纵，早已避开。\n",
  "但见$n一招「流光逝影」，身形展开，如同一道闪电，转瞬便已消失不见。\n",
  "但见$n一招「星汉西流」，身体如行云流水般滑出丈余，顿时闪过了$N的凌厉攻势。\n",
  "$n一招「日月之行」，身体如陀螺般急转，气流形成一个个漩涡，令$N陷身其间，动弹不得。\n",
  "$n一招「月明星稀」，施展摘星步法，全身顿时化做淡淡的一道灰影，令人眼花缭乱。\n",
  "$n一招「长夜星落」，头下脚上，全身化为一道白影，疾冲而下，有惊无险地避开了$N这一招。\n",
  "$n一招「九天揽月」，全身笔直，拔地而起，半空中一折身，已远远地落到十余丈外。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  level = me->query_skill("zhaixing-steps");
  if (-level * level * level / 10 < me->query("SEN"))
    return notify_fail("修练摘星步法，要心狠手辣，奸恶歹毒。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("zhaixing-steps");
  if ((int)me->query("kee") < 35)
    return notify_fail("你的气太少了，无法继续练习摘星步法。\n");
  me->receive_damage("kee", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "zhaixing-steps/" + action;
}

int enable_factor() { return 110; }

int learn_factor(int n) {
  if (n < 100) return 110;
  else return 90;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 2; }

int practice_factor() { return 100; }
int practice_bonus() { return 1; }
