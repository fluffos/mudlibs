// yiwei-steps.c - 一苇渡江

inherit SKILL;

string *dodge_msg = ({
  "$n一招「一苇渡江」，身体如行云流水般滑出丈余。\n",
  "$n一招「雨燕掠波」，双臂前伸，全身贴地平飞，轻轻巧巧地避了开去。\n",
  "$n一招「移步换形」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
  "$n一招「分身化影」，一转身间，四面八方飘动着无数个$n的身影。\n",
  "$n一招「孤骛落日」，全身笔直，拔地而起，在半空中一转，已落到数丈之外。\n",
  "$n一招「鸿雁双飞」，两臂鹏举如翼，在剌剌风声中，从$N头顶横跃而过。\n",
  "$n一招「苍龙出水」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
  "$n一招「稚凤归巢」，向一旁飘然纵出，轻轻着地。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("buddhism") < (int)me->query_skill("yiwei-steps") / 2)
    return notify_fail("佛门每种绝技都要有慈悲佛法为之化解，你好象学得不够呀！\n");
  level = me->query_skill("yiwei-steps");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练一苇渡江，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("yiwei-steps");
  if ((int)me->query("kee") < 35)
    return notify_fail("你的气太少了，无法继续练习一苇渡江。\n");
  me->receive_damage("kee", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yiwei-steps/" + action;
}

int enable_factor() { return 200; }

int learn_factor(int n) {
  if (n < 100) return 115;
  else return 95;
}

int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 2; }

int practice_factor() { return 105; }
int practice_bonus() { return 1; }
