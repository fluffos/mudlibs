// regenerate.c

inherit SSERVER;

int exert(object me, object target) {
  int total;

  if (target != me) return notify_fail("你只能用内功提振自己的精力。\n");

  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够。\n");

  // 修改：自动加满自己的精力
  total = ((int)me->query("eff_gin") - (int)me->query("gin")) * 20 / (10 + (int)me->query_skill("force") / 3);
  if ((int)me->query("force") >= total) {
    me->set("gin", (int)me->query("eff_gin"));
    me->add("force", -total);
  } else {
    me->receive_heal("gin", (10 + (int)me->query_skill("force") / 3)
      * (int)me->query("force") / 20);
    me->set("force", 0);
  }

  message_vision("$N深深吸了口气，手脚活动了几下，整个人看起来有活力多了。\n", me);

  if (me->is_fighting()) me->start_busy(1);

  return 1;
}
