// spells.c - 基本咒术

#include <ansi.h>

inherit SKILL;

// string type() { return "knowledge"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("spells", 1);
  if (s % 10 == 0 && (int)me->query("spi") < 50
    && (s / 10) > (int)me->query("spi_increase")) {
    tell_object(me, HIW "由於你的仙法修炼有成，你的灵性提高了。\n" NOR);
    me->add("spi", 1);
    me->add("spi_increase", 1);
  }
}

int enable_factor() { return 100; }
