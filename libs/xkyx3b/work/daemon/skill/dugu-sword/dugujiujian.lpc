#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int extra, forces, jing, qi, shen;
  object weapon;
  extra = me->query_skill("dugu-sword", 1);
  if (extra < 120) return notify_fail("你的独孤剑法还不够纯熟！\n");
  jing = (int)me->query("max_gin") / 10;
  qi = (int)me->query("max_kee") / 10;
  shen = (int)me->query("max_sen") / 10;
  if (me->query("gin") <= jing || me->query("kee") <= qi || me->query("sen") <= shen)
    return notify_fail("你的体力不足以支持你使出［独孤九剑］！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［独孤九剑］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  message_vision(HIY "$N大叫一声，挥动手中的剑成半弧形，弧形中渐渐出现了九把剑，以包围式的进攻向对方飞去！\n\n" NOR, me, target);
  message_vision(HIY "第一剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第二剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第三剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第四剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第五剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第六剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第七剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第八剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  message_vision(HIY "第九剑！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  me->start_busy(6);
  me->add("gin", -jing);
  me->add("kee", -qi);
  me->add("sen", -shen);
  return 1;
}
