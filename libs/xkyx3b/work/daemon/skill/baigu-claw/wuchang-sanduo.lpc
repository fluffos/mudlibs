// wuchang-sanduo.c  无常三夺

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

// inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if (!me->is_fighting())
    return notify_fail("「无常三夺」只能在战斗中使用。\n");
  /*
        if( environment(me) != environment(target) )
                return notify_fail("这里没有这个人。\n");
*/
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(sprintf("使用「无常三夺」必须空手。\n"));

  if ((int)me->query("force") < 100)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query_skill("unarmed") < 50
    || me->query_skill_mapped("unarmed") != "baigu-claw")
    return notify_fail("你的九阴白骨爪还不到家，无法使用「无常三夺」！\n");

  msg = HIY "$N使出九阴白骨爪绝技「无常三夺」，身法陡然加快！\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("unarmed"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("unarmed"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("unarmed"), 0);

  me->add("neili", -100);
  me->start_busy(random(3));

  return 1;
}
