// lcy-n2.c - 扬州城－水竹居

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "水竹居");
  set("long", @LONG

    这里是扬州城丽春院的水竹居。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "lcy-e1n2",
    "south": __DIR__ "lcy-n1",
    "west": __DIR__ "lcy-w1n2",
    // "north" : __DIR__"lcy-n2",
  ]));

  setup();

  replace_program(ROOM);
}
