#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "异娼庙");
  set("long", @LONG

    这里是扬州城的异娼庙。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-w2s1",
    "south": __DIR__ "main-w3s2",
    // "west"  : __DIR__"main-w4s1",
    "north": __DIR__ "main-w3",
  ]));

  set("objects", ([
    "/d/center/npc/keeper": 1,
    "/d/center/npc/crazy_dog": 1,
  ]));
  setup();

}
