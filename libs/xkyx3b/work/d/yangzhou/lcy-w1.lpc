#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "宁秋阁");
  set("long", @LONG

    这里是扬州城丽春院的宁秋阁。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "lcy",
    // "south" : __DIR__"lcy-w1",
    // "west"  : __DIR__"lcy-w1",
    "north": __DIR__ "lcy-w1n1",
  ]));

  setup();

  replace_program(ROOM);
}
