// main-w1n3.c - 扬州城－天宁寺

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "天宁寺");
  set("long", @LONG

    这里是扬州城的天宁寺。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-n3",
    "south": __DIR__ "main-w1n2",
    "west": __DIR__ "main-w2n3",
    // "north" : __DIR__"main-w1n4",
  ]));

  set("objects", ([
    "/obj/misc/paper_seal": 4,
    "/d/center/npc/jinxiangke": 1,
    "/d/center/npc/buddhism": 1,
  ]));
  setup();

  replace_program(ROOM);
}
