// lcy-e1n1.c - 扬州城－紫霞居

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "紫霞居");
  set("long", @LONG

    这里是扬州城丽春院的紫霞居。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    // "east"  : __DIR__"lcy-e1n1",
    "south": __DIR__ "lcy-e1",
    "west": __DIR__ "lcy-n1",
    "north": __DIR__ "lcy-e1n2",
  ]));

  setup();

  replace_program(ROOM);
}
