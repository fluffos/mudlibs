// main-w3n2.c - 扬州城－丽春院

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "丽春院");
  set("long", @LONG

    这里是扬州城的丽春院。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-w2n2",
    "south": __DIR__ "main-w3n1",
    // "west"  : __DIR__"main-w4n2",
    "north": __DIR__ "main-w3n3",
    "enter": __DIR__ "lcy",
  ]));

  set("objects", ([
    "/d/qianjinlou/npc/pitiao-ke": 1,
    "/d/qianjinlou/npc/guinu": 1,
  ]));

  setup();

}
