// main-w2.c - 扬州城－西大街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG

    这里是扬州城的西大街。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-w1",
    "south": __DIR__ "main-w2s1",
    "west": __DIR__ "main-w3",
    "north": __DIR__ "main-w2n1",
  ]));

  setup();

}
