#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "裁缝店");
  set("long", @LONG

    这里是扬州城的裁缝店。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e2s3",
    // "south" : __DIR__"main-e1s4",
    "west": __DIR__ "main-s3",
    "north": __DIR__ "main-e1s2",
  ]));

  set("objects", ([
    "/d/center/npc/caifeng": 1,
  ]));
  setup();

  replace_program(ROOM);
}
