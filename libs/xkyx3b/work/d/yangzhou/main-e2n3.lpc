// main-e2n3.c - 扬州城－小树林

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小树林");
  set("long", @LONG

    这里是扬州城的小树林。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e3n3",
    "south": __DIR__ "main-e2n2",
    "west": __DIR__ "main-e1n3",
    // "north" : __DIR__"main-e2n4",
  ]));

  set("objects", ([
    "/d/center/npc/songshu": 2,
    "/d/center/npc/hare": 2,
    "/d/center/npc/bird": 2,
  ]));
  setup();

  replace_program(ROOM);
}
