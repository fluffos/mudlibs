// lcy-n1.c - 扬州城－临水红霞

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "临水红霞");
  set("long", @LONG

    这里是扬州城丽春院的临水红霞。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "lcy-e1n1",
    "south": __DIR__ "lcy",
    "west": __DIR__ "lcy-w1n1",
    "north": __DIR__ "lcy-n2",
  ]));

  setup();

  replace_program(ROOM);
}
