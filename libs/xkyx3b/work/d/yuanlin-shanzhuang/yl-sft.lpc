#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "松风亭");
  set("long", @LONG

    这里是侠客园林的松风亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "northeast": __DIR__ "yl-yxt",
    "east": __DIR__ "yl-llg",
    "northwest": __DIR__ "yl-xfh",
    "southwest": __DIR__ "yl-zqyy",
  ]));

  setup();

  replace_program(ROOM);

}
