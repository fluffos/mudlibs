#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "水流云在");
  set("long", @LONG

    这里是英雄山庄的水流云在。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-wjg",
    "south": __DIR__ "sz-fzll",
    "northeast": __DIR__ "sz-yzqm",
    "southeast": __DIR__ "sz-ryz",
  ]));

  setup();

  replace_program(ROOM);

}
