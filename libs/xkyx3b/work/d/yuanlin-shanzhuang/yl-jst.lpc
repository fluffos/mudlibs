#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "嘉实亭");
  set("long", @LONG

    这里是侠客园林的嘉实亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "northeast": __DIR__ "yl-llg",
    "east": __DIR__ "yl-tyx",
  ]));

  setup();

  replace_program(ROOM);

}
