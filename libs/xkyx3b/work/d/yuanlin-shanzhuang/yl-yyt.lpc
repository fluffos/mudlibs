#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "鸳鸯亭");
  set("long", @LONG

    这里是侠客园林的鸳鸯亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-ltg",
    "south": __DIR__ "yl-hbxl",
    "east": __DIR__ "yl-yxt",
  ]));

  setup();


}
