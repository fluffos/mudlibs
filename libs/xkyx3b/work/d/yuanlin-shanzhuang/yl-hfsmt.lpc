#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "荷风四面亭");
  set("long", @LONG

    这里是侠客园林的荷风四面亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "southeast": __DIR__ "yl-yyx",
    "northeast": __DIR__ "yl-xxzwt",
    "northwest": __DIR__ "yl-jqq",
  ]));

  setup();

  replace_program(ROOM);

}
