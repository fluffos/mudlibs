#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "留听阁");
  set("long", @LONG

    这里是侠客园林的留听阁。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "northwest": __DIR__ "yl-pjy",
    "northeast": __DIR__ "yl-lt",
    "south": __DIR__ "yl-yyt",
  ]));

  setup();

  replace_program(ROOM);

}
