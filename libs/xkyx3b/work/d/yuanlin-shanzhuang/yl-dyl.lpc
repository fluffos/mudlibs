#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "倒影楼");
  set("long", @LONG

    这里是侠客园林的倒影楼。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-hbxl1",
    "southeast": __DIR__ "yl-xiaoz",
    "west": __DIR__ "yl-fcg",
  ]));

  setup();

  replace_program(ROOM);

}
