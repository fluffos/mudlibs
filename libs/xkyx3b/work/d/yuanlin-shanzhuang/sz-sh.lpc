#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "上  湖");
  set("long", @LONG

    这里是英雄山庄的上湖。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-gls",
    "northwest": __DIR__ "sz-ryh1",
    "east": __DIR__ "sz-ysjs",
    "south": __DIR__ "sz-xh",
  ]));

  setup();


}
