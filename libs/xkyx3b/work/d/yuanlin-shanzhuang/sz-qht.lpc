#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "清晖亭");
  set("long", @LONG

    这里是英雄山庄的清晖亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "sz-ch",
    "west": __DIR__ "sz-ryz",
    "south": __DIR__ "sz-gls",
  ]));

  setup();


}
