#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "别有洞天");
  set("long", @LONG

    这里是侠客园林的别有洞天。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-xiaoz",
    "southwest": __DIR__ "yl-yixt",
  ]));

  setup();

  replace_program(ROOM);

}
