#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "见山楼");
  set("long", @LONG

    这里是侠客园林的见山楼。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "northeast": __DIR__ "yl-xqls",
    "southeast": __DIR__ "yl-jqq",
    "southwest": __DIR__ "yl-xiaoz",
  ]));

  setup();


}
