#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "下  湖");
  set("long", @LONG

    这里是英雄山庄的下湖。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-sh",
    "northwest": __DIR__ "sz-ryh2",
    "east": __DIR__ "sz-yh",
  ]));

  setup();

  replace_program(ROOM);

}
