#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "塔影亭");
  set("long", @LONG

    这里是侠客园林的塔影亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-hbxl",
  ]));

  setup();

  replace_program(ROOM);

}
