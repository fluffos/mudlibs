#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "万树园");
  set("long", @LONG

    这里是英雄山庄的万树园。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-zm",
    "south": __DIR__ "sz-yzqm",
    "east": "/d/player/sting",
    "west": "/d/player/scouring",
  ]));

  setup();

  replace_program(ROOM);

}
