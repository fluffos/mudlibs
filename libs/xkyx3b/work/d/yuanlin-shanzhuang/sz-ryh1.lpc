#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "如意湖");
  set("long", @LONG

    这里是英雄山庄的如意湖。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "west": __DIR__ "sz-fyj",
    "east": __DIR__ "sz-gls",
    "south": __DIR__ "sz-ryh2",
    "southeast": __DIR__ "sz-sh",
  ]));

  setup();


}
