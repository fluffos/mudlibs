// /d/mytest/obj/honey.c

inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

void create() {
  set_name("玉蜂浆", ({ "honey" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大瓶香气扑鼻的玉蜂浆。\n");
    set("unit", "瓶");
    set("value", 10000);
    set("max_liquid", 20);
    set("liquid", ([
      "type": "water",
      "name": "蜜浆",
      "remaining": 100,
      "drink_apply": 80,
      "food_apply": 80,
    ]));

  }

  setup();
}

void init() {
  add_action("do_drink", "drink");
  add_action("do_fill", "fill");
}


int do_drink(string arg) {
  if (!this_object()->id(arg)) return 0;
  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!query("liquid/remaining"))
    return notify_fail(name() + (query("liquid/name") ? "已经被喝得一滴也不剩了" : "是空的。\n"));
  if ((int)this_player()->query("water") < (int)this_player()->max_water_capacity())
    this_player()->add("water", (int)query("liquid/drink_apply"));

  if ((int)this_player()->query("food") < (int)this_player()->max_food_capacity())
    this_player()->add("food", (int)query("liquid/food_apply"));

  add("liquid/remaining", -1);
  message_vision("$N拿起" + name() + "咕噜噜地喝了几口" + query("liquid/name")
    + "。\n", this_player());
  if (this_player()->is_fighting()) this_player()->start_busy(2);
  if (!query("liquid/remaining"))
    write("你已经将" + name() + "里的" + query("liquid/name")
      + "喝得一滴也不剩了。\n");

  this_player()->set("gin", this_player()->query("eff_gin"));
  this_player()->set("kee", this_player()->query("eff_kee"));
  this_player()->set("sen", this_player()->query("eff_sen"));
  this_player()->start_busy(1);
  write(HIY "哇！你感到精神一振！\n" NOR);
  return 1;
}

int do_fill(string arg) {
  return notify_fail("什么？\n");
}
