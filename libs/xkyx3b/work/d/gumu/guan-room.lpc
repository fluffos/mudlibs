// /d/gumu/guan-room.c
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "墓室");
  set("long", @LONG
    这是古墓地下的一个大厅，四周空空旷旷。
    大厅里并列放着五具石棺，两具石棺棺盖已密密盖著，
    另外三具的棺盖却只推上一半，也不知其中有无尸体。
LONG
  );

  set("item_desc", ([
    "石棺": "石棺半开着，似乎可以进去（enter）？\n",
  ]));
  set("exits", ([
    "west": __DIR__ "mi-room6",
  ]));

  setup();
}

void init() {
  add_action("do_enter", "enter");
}
int do_enter(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "石棺") {
    tell_object(this_player(), "你要进去哪里？\n");
    return 1;
  }
  tell_object(ob, BLU "你跳进一具半开的石棺！\n" NOR);
  ob->move(__DIR__ "shiguan");
  return 1;
}
