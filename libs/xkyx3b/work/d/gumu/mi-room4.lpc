// /d/gumu/mi-room4.c
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "地下石室");
  set("long", @LONG
    这是古墓的地下石室，四周黑黑的，黑暗中似乎有人影在闪动！
LONG
  );

  set("item_desc", ([
    "wall": "在墙壁的壁角上似乎有一块石头突了出来。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "mi-center5",
  ]));

  setup();
}

void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  object ob;
  string dir;
  if (!arg || arg != "stone") {
    tell_object(this_player(), "你要推动什么？\n");
    return 1;
  }
  ob = this_player();
  message_vision(BLU "抓住墙角的石头用力一推！\n" NOR, ob);
  message_vision(BLU "石头突然转动起来，露出了一道门！\n" NOR, ob);
  ob->move(__DIR__ "xiao-room");
  return 1;
}
