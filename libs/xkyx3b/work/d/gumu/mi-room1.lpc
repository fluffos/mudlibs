// /d/gumu/mi-room1.c
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "地下石室");
  set("long", @LONG
    这是古墓的地下石室，四周黑黑的，黑暗中似乎有人影在闪动！
LONG
  );

  set("item_desc", ([
    "wall": "在墙壁的壁角上似乎有一块石头突了出来。\n",
  ]));
  set("exits", ([
    "west": __DIR__ "mi-dump2",
  ]));

  setup();
}

void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "stone") {
    tell_object(ob, "你要推动什么？\n");
    return 1;
  }
  message_vision(BLU "$N抓住墙角的石头用力推了一下，但什么也没发生！\n" NOR, ob);
  return 1;
}
