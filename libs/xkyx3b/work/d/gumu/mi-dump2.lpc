#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "地下隧道");
  set("long", @LONG
    隧道里一片漆黑，看不清路的方向，黑暗中但觉处处都是歧路岔道，似乎永远也走不完！
LONG
  );

  set("exits", ([
    "east": __DIR__ "mi-room1",
    "west": __DIR__ "mi-center2",
    "south": __DIR__ "mi-center3",
    "north": __DIR__ "mi-center4",
  ]));

  setup();

}
