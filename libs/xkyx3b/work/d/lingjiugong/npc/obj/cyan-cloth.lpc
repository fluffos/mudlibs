// cyan-cloth.c 

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(CYN "青布衣" NOR, ({ "cyan cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是件质量上佳青衣，是由“针神”亲手缝制的。\n");
    set("unit", "件");
    set("value", 100);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 10);
    // set("armor_prop/defense", 0 );
    // set("armor_prop/dodge", 0 );
  }
  setup();
}
