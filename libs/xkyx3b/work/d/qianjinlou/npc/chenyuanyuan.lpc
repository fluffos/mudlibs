#include <ansi.h>

inherit NPC;

#define SET_SKILL	40			// 定义基本武功的值（随机），自动生成经验
#define SET_SEN		0			// 定义正气的值

void create() {
  int n;

  set_name(HIM "陈圆圆" NOR, ({ "chen yuanyuan", "chen" }));

  set("long", @LONG
她是是千金楼的名妓，精通琴棋书画。
LONG
  );

  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 20);

  // set("str", 30);			// 膂力		
  // set("cps", 30);			// 定力
  // set("cor", 30);			// 胆识		
  set("per", 30);    // 容貌
  // set("con", 30);			// 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);
  set_skill("literate", 120);

  set("chat_chance_combat", 25);
  set("chat_msg_combat", ({
    "陈圆圆秀眉微蹙，说道：喂！我哪里得罪您了？干嘛这样跟我拼死拼活？\n",
  }));

  set("inquiry", ([
    "过夜": "官人可要洁身自好啊！",
    "嫖妓": "官人可要洁身自好啊！",
    "学艺": "请您留件信物！",
  ]));

  setup();

  carry_object("/obj/cloth/gong-chai")->wear();  // 装备
  carry_object("/obj/cloth/snow-silk")->wear();
  carry_object("/obj/cloth/flower-boots")->wear();

  add_money("gold", 3);    // 金钱
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/陈圆圆")) {
    say("陈圆圆说道：咦？我不记得您啊....\n");
    return 0;
  }
  return 1;
}

int accept_object(object who, object ob) {
  if (ob->value()) {
    command("say 我对钱没兴趣！");
    return 0;
  }

  if ((this_player()->query("per") < 25)
    || ((string)this_player()->query("gender") == "女性")) {
    command("say 我对您没兴趣！");
    return 0;
  }
  command("say 能做相公的老师，真是三生有幸。");
  who->set("marks/陈圆圆", 1);
  return 1;
}

int accept_fight(object me) {
  command("say 小女子哪里是您的对手？");
  return 0;
}
