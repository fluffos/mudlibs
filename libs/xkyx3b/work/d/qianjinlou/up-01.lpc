#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小  厅");
  set("long", @LONG
                                                                
    这里是千金楼二楼的小厅。
LONG
  );

  // set("outdoors", "qianjinlou");

  set("exits", ([
    "east": __DIR__ "up-01e",
    "south": __DIR__ "up-01s1",
    "north": __DIR__ "up-01n1",
    "down": __DIR__ "main-01",
  ]));

  setup();

  replace_program(ROOM);
}
