#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "通天河");
  set("long", @LONG
								
    这里是侠客城以西的通天河。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "xia-w10",
    "west": __DIR__ "xia-w12",
  ]));

  setup();

  replace_program(ROOM);

}
