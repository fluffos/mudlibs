#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "平  原");
  set("long", @LONG
								
    这里是嵩山以西的平  原。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "west": __DIR__ "song-w4",
    "east": __DIR__ "song-w2",
  ]));

  setup();

  replace_program(ROOM);

}
