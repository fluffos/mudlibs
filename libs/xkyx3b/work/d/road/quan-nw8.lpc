#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "水府庙");
  set("long", @LONG
								
    这里是泉州西北的水府庙。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southeast": __DIR__ "quan-nw7",
    "northwest": __DIR__ "quan-nw9",
  ]));

  setup();

  replace_program(ROOM);

}
