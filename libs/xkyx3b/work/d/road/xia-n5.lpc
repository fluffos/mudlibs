// xia-n5.c - 侠客城向北大道（三门峡）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "三门峡");
  set("long", @LONG
								
    这里是侠客城以北的三门峡。路边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "south": __DIR__ "xia-n4",
    "west": __DIR__ "hua-e2",
    "east": __DIR__ "song-w5",
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
        华山▲──※──▲嵩山
                  │
                  │
              【侠客城】
[2;37;0m
LONG;

}
