#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "博平岭");
  set("long", @LONG
								
    这里是泉州西北的博平岭。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southeast": __DIR__ "quan-nw1",
    "northwest": __DIR__ "quan-nw3",
  ]));

  setup();


}
