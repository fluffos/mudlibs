#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "池  河");
  set("long", @LONG
								
    这里是扬州城西北的池河。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southeast": __DIR__ "yang-w5",
    "northwest": __DIR__ "yang-nw2",
  ]));

  setup();

  replace_program(ROOM);

}
