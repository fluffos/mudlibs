#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "铁狮子园");
  set("long", @LONG
                                                                
    这里是北京城南铁狮子园。旁边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "south": __DIR__ "bei-s10",
    // "north"         : __DIR__"bei-s08",
    "north": __DIR__ "bei-s05",
    "northwest": __DIR__ "hei-se7",
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
             【北京】
      黑木崖▲  │
    恒山▲    ＼│
                ※
                │
              ～～～
                   ▲泰山
      【侠客城】
                  【扬州】
[2;37;0m
LONG;

}
