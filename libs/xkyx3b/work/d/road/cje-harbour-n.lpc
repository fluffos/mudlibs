// cje-harbour-n.c 东长江北岸码头
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

void home(object ob);

void create() {
  set("short", "长江北岸码头");
  set("long", @LONG

    这里是长江北岸码头。一条小船上的船家看到你在东张西望，想找船
过河的样子，连忙向你招手，示意你上他的船（chuan）。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "north": __DIR__ "yang-w4",
  ]));

  set("item_desc", ([
    "chuan": @TEXT
岸边靠着一条小船，也许喊（yell）一声船家就能过江。
TEXT
  ]));

  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_yell", "yell");
  add_action("do_enter", "enter");
}

int do_yell(string arg) {
  object room, me;

  me = this_player();

  if (!arg || arg == "") return notify_fail("你想要叫什么？\n");

  if (!(room = find_object(__DIR__ "cje-boat"))) {
    room = load_object(__DIR__ "cje-boat");
    if (!room) return 0;
  }

  if (arg == "boat" || arg == "chuan" || arg == "船家") {
    message_vision("$N鼓足中气，长啸一声：“船家！”\n", this_player());
    if (room->query("idle_flag") == 2 || room->query("idle_flag") == 3) {
      tell_room(environment(me), "只听得江面上隐隐传来：“别急嘛，船才刚刚离开……”\n");
      return 1;
    }
    if (room->query("idle_flag") == 1) {
      tell_room(environment(me), "岸边一条小船上的艄夫说道：正等着你呢，快上来吧。\n");
    } else {
      tell_room(environment(me), "一条小船缓缓地驶了过来，艄夫将一块踏脚板搭上堤岸，以便乘客上下。\n");
      set("exits/enter", __DIR__ "cje-boat");
      room->set("exits/out", __DIR__ "cje-harbour-n");
      room->set("idle_flag", 1);
      call_out("sail_out", 10, room);
    }
  } else {
    message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n" +
      "江面上远远传来一阵回声：“" + arg + "～～～”\n", this_player());
    return 1;
  }
  return 1;
}

void sail_out(object room) {
  delete("exits/enter");
  tell_room(room, "艄公把踏脚板收了起来，说了一声“坐稳喽”，划动木桨，小船向河对岸驶去。\n");
  room->delete("exits/out");
  room->set("idle_flag", 2);

  remove_call_out("sailing");
  call_out("sailing", 10, room);
  call_out("stop_boat", 20, room);
}

void sailing(object room) {
  tell_room(room, "小船向江对岸划去。\n");
}

void stop_boat(object room) {
  object room1;

  tell_room(room, "艄公说道“到啦，上岸吧”，随即把一块踏脚板搭上堤岸。\n");
  room->set("exits/out", __DIR__ "cje-harbour-s");
  room->set("idle_flag", 3);

  room1 = find_object(__DIR__ "cje-harbour-s");
  if (!room1)
    room1 = load_object(__DIR__ "cje-harbour-s");
  if (room1)
    room1->set("exits/enter", __DIR__ "cje-boat");
  call_out("start_idle", 20, room, room1);
}

void start_idle(object room, object room1) {
  object *ob;
  int i;

  room->delete("exits/out");
  room1->delete("exits/enter");

  ob = all_inventory(room);
  for (i = 0; i < sizeof(ob); i++) {
    if (userp(ob[i])) {
      call_other(__DIR__ "cje-harbour-s", "sail_out", room);
      return;
    }
  }
  room->set("idle_flag", 0);
}

int do_enter(string arg) {
  object ob;
  string dir;
  if (!arg || arg != "chuan") return 0;

  ob = this_player();
  message_vision("艄公一见有人上船，忙叫了一声：开船喽！\n", ob);
  message_vision("艄公一撑竹篙，船就向对岸驶去。\n", ob);

  ob->move(__DIR__ "cje-boat");
  //    ob ->move(__DIR__"huanghe");
  //    tell_object(ob, BLU "你在海上航行了很久很久.......\n" NOR );

  remove_call_out("home");
  call_out("home", 10, ob);

  return 1;
}

void home(object ob) {
  tell_object(ob, "小船终于到达了江对岸。你走下船来。\n");
  ob->move(__DIR__ "cje-harbour-s");
}
