#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
								
    你走在北京城西的大官道上。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "bei-w02",
    "west": __DIR__ "bei-w04",
  ]));

  setup();

  replace_program(ROOM);

}
