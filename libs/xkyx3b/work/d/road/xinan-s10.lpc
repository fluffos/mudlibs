// xinan-s10.c - 侠客城西南向南（贡嘎山）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "贡嘎山");
  set("long", @LONG
								
    这里是侠客城西南向南的贡嘎山。路边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "south": __DIR__ "xinan-s11",
    "north": __DIR__ "xinan-s09",
    "west": "/d/emeishan/main-01",
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
    光明顶▲           ▲终南山
    【西藏】──※──【侠客城】
                │
                │
    峨眉山▲──※
                │
                │
         【大理】▲无量山
[2;37;0m
LONG;

}
