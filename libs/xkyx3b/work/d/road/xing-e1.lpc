#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "河  流");
  set("long", @LONG
								
    这里是星宿海以东的河流。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "xing-e2",
    "west": __DIR__ "temp-xingsuhai",
  ]));

  setup();

  replace_program(ROOM);

}
