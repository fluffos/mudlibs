inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "石破天的山洞");
  set("long", @LONG

    这里是石破天（Stones）的山洞。这是个不算很大的山洞，里面只有
一张石床，一张石桌、一张石凳，显得空空荡荡的，床上、桌上、凳上都
蒙着一层厚厚的灰尘，看来主人已经很久没在这里住了。正面石壁上刻着
一些七扭八拐象蝌蚪一样的字，据说主人就是从中参悟出骇世武功。右边
有一把剑插在石壁上，直没至柄，旁边有几个写得很蹩脚的字（zi），看
来写的人最多只是学过三字经，不过显然是用内力注在指上写就，其武功
实在令人叹服。
LONG
  );

  set("item_desc", ([
    "zi": @LONG
这是一些象蝌蚪一样的文字。
LONG,
  ]));

  set("exits", ([
    "east": "/d/yuanlin-shanzhuang/sz-xy",
  ]));

  // set("outdoors", "center");

  setup();

  replace_program(ROOM);
}
