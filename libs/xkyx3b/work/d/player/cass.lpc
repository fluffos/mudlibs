inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "飞飞的家");
  set("long", @LONG

    这里是飞飞（Cass）的家。只见墙的四壁显露出淡淡的水蓝色，与窗
外的蓝天融合在一起，让你感到仿佛置身于无边无际的大海之中。屋顶是
用琉璃做的，透过琉璃，你可以看见白天的日出日落晚上的星月交辉。屋
子的正中挂着一幅七姐与牛郎在鹊桥相会的画，上面题了一首诗（shi ）。
屋子的西首，你可以看见一个小小的酒吧，你可以在那儿品尝到既香且醇
的女儿红，也可品尝到中国名茶----江苏特产碧螺春。酒吧旁摆了两张太
师椅，是屋子的主人和她的丈夫赏月时坐的。
LONG
  );

  set("item_desc", ([
    "shi": @LONG
    七月七日长生殿，
    夜半无人私语时。
    在天愿做比翼鸟，
    在地愿为连理枝。
LONG,
  ]));

  set("exits", ([
    "down": __DIR__ "sting",
  ]));

  // set("outdoors", "center");

  setup();

  replace_program(ROOM);
}
