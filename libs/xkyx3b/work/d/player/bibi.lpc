#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "小如儿的公寓");
  set("long", @LONG
这里是小如儿(BIBI)办公的地方，当你一进入门口就看见一台崭新的
中华学习机放在地上，据说主人一回家就坐在学习机前玩MUD。学习机的旁
边放着一张镶满钻石的大床(bed)，看上去睡三,四个人也没问题。床上摆
着一个可爱的布娃娃，听说这个布娃娃是小如儿的定情信物。床的周围种
满了一地的野玫瑰。看来主人打算和她的如意郎君在这里安度晚年。房子
的内侧放着一张崭新的办公台，上面放着几张侠客岛的地图和一碗刚煮好
的鸡鲍翅。使你看到口水都流了。:)...墙的正面还挂着一张《天下》的
总图(map)。
LONG
  );

  set("item_desc", ([
    "bed": @LONG
你想如果可以把这张床拿出去卖，一定可以赚不少钱回来。
LONG,
  ]));

  set("valid_startroom", "1");

  set("exits", ([
    "east": "/d/yuanlin-shanzhuang/sz-yzqm",
    "west": "/d/center/guangchang",
    "up": "/d/wizard/wizard_room",
  ]));

  set("objects", ([
    "/obj/npc/change_name": 1
  ]));

  setup();

  // replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  if (dir == "up" && !wizardp(me))
    return notify_fail("那里只有神仙才能进去。\n");
  return ::valid_leave(me, dir);
}
