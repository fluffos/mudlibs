// shiwei.c 锦衣侍卫

inherit NPC;

void create() {
  set_name("锦衣侍卫", ({ "guard", "shi wei" }));
  set("title", "一品带刀侍卫");
  set("gender", "男性");
  set("age", 35);
  set("long", "这是一个强壮侍卫,他面无表情，来回巡逻，监视着过往的行人。\n");
  set("str", 29);
  set("int", 14);
  set("combat_exp", 50000);
  set("attitude", "heroism");
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("blade", 70);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80); ;


  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object("obj/weapon/blade")->wield();
}
