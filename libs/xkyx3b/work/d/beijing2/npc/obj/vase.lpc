// bag.c

inherit ITEM;

void create() {
  set_name("小瓷瓶", ({ "vase" }));
  set_weight(200);
  set_max_encumbrance(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只白色的小瓷瓶，上面描了些花纹，古色古香。\n"
      "很象是唐代的出品。\n");
    set("value", 50);
  };
}

int is_container() { return 1; }
