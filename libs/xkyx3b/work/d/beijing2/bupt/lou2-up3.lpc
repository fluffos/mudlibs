// zhuxi.c -  北邮

#include <ansi.h>
inherit ROOM;


void create() {
  set("short", "系机房");
  set("long", @LONG
30 台 286 一溜的摆在那里，几个同学正在上机．上面有一个牌子（paizi），不知道写
些什么。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "lou2-up4",
    "down": __DIR__ "lou2-up2",
  ]));
  set("objects", ([
    __DIR__ "npc/student": 3,
    __DIR__ "npc/student1": 1,
  ]));

  set("item_desc", ([
    "paizi": convert_color(@TEXT
        $GRN$  本机房严禁玩游戏.如有抓获,禁止上机一周．  $NOR$
        $RED$            以下同学禁止上机一周
        $RED$            9121 大鱼       $NOR$

TEXT
    )
  ]));


  set("no_clean_up", 0);
  setup();

}
