// student.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("学生", ({ "student", "xue sheng" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "一脸稚气，正聚精会神的看着屏幕。\n");
  set("str", 20);
  set("int", 25);
  set("combat_exp", 1500);
  set("attitude", "friendly");
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);

  set("SEN", 1000);
  setup();
  carry_object("/obj/cloth/cloth")->wear();

}
