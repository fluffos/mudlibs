// painting_shop.c- 字画店

inherit ROOM;
string look_sign(object me);

void create() {
  set("short", "字画店");
  set("long", @LONG
装修的古色古香，很有中国文化的色彩。正对着门口的墙上，挂着一幅《仕女图》，
据说是唐伯虎的真迹。
LONG
  );
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "nw_road1",
  ]));
  set("no_clean_up", 0);
  //        set("outdoors", "beijing");
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/painting_seller": 1,  //老板一名
  ]));
  setup();
  replace_program(ROOM);
}
string look_sign(object me) {
  return (@LONG
画
LONG);
}
