// garden1.c

#include <room.h>

inherit ROOM;


void create() {
  set("short", "张家花园");
  set("long", @LONG
你现在正站在张百万家的花园里
    花园里白花盛开,煞是好看,令你精神为之一振.
LONG
  );
  set("exits", ([
    "south": __DIR__ "rich",
    "north": __DIR__ "zoulang1",
    "southwest": __DIR__ "garden2",
    "west": __DIR__ "room1",
    "east": __DIR__ "room2"
  ]));

  set("outdoors", "beijing");
  set("item_desc", ([
    "door": (: look_door, "south" :),
  ]));
  set("objects", ([
    __DIR__ "npc/huyuan": 2,
    __DIR__ "npc/dog": 1 ]));

  create_door("south", "红漆大门", "north", DOOR_CLOSED);


  setup();
  replace_program(ROOM);
}
