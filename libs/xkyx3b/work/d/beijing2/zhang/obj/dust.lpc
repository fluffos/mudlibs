// dust.c

inherit COMBINED_ITEM;

void create() {
  set_name("白色粉末", ({ "white dust", "dust" }));
  set("long", "这是一包白色的粉末,不知道是用来干什么的.要不要试试呢?\n");
  set("value", 1000);
  set("unit", "包");
  set("base_unit", "份");
  set("base_weight", 1);
  set_amount(1);
}
void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me;
  int increasement;

  me = this_player();
  if (!id(arg)) return notify_fail("你想要用什么东西？\n");

  message_vision("$N闭上眼睛,把一份白色粉末放进嘴里。\n", me);
  tell_object(me, "顿时,你觉得腹内翻腾,肝肠尽裂,痛不欲生.\n");

  me->apply_condition("snake_poison", 10);
  add_amount(-1);
  return 1;
}
