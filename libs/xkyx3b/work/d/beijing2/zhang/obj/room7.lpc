// room7.c

#include <room.h>

inherit ROOM;

int do_look(string arg);
int do_get(string arg);
int do_open(string arg);

void create() {
  set("short", "主人卧室");
  set("long", @LONG

这是张家的二公子--张康武的卧室.张家二少奶正坐在梳妆台前化妆.

LONG
  );
  set("exits", ([
    "northwest": __DIR__ "zoulang2"
  ]));

  set("objects", ([
    __DIR__ "npc/zhang3": 1,
    __DIR__ "npc/wife3": 1 ]));
  set("item_desc", ([
    "desk": (: look_desk() :)
  ]));
  set("no_fight", "1");
  set("dest_count", 1);
  setup();
}

void init() {
  add_action("do_open", "open");
  add_action("do_look", "look");
  add_action("do_look", "l");
  add_action("do_get", "get");
}


int do_open() {
  object me;
  me = this_player();
  tell_object(me, "你轻手轻脚的打开了盒子.\n");
  me->set_temp("open", 1);
  return 1;
}



string look_desk(object me) {
  return "梳妆台上放着一个盒子(box),不知道里面有些什么。\n";
}

int do_look(string arg) {
  object me;
  if (arg != "box") return 0;
  me = this_player();
  if (arg == "box") {
    if (me->query_temp("open") && query("dest_count"))
      tell_object(me, "盒子里放着一堆白色粉末(dust),不知道是用来干什么的.\n");
    if (me->query_temp("open") && !query("dest_count")
      tell_object(me, "盒子空空如也,什么东西都没有.\n");
    }
      return 1;
  }

  int get(string arg) {
    object me, obj;
    string err;
    me = this_player();
    if (arg != "dust from box") return 0;
    if (!query("dust_count")) return 0;
    tell_room(environment(me), me - query("name") + "从盒子里捡起了一堆白色粉末.\n");
    err = catch(obj = new("/d/beijing2/zhang/obj/dust.lpc"));
    obj->move(me);
    add("dust_count", -1);
    me->dele_temp("open");
    return 1;
  }
