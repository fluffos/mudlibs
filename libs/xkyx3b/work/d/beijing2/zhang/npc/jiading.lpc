// jiading.c

inherit NPC;
#include <net/dns.h>
void create() {
  set_name("家丁", ({ "jia ding", "jia" }));
  set("gender", "男性");
  set("age", 33);
  set("str", 20);
  set("cor", 26);
  set("cps", 29);
  set("int", 25);
  set("per", 13);
  set("long", @LONG
一个体型魁悟，看起来孔武有力的大个子。
LONG
  );
  set("attitude", "heroism");

  set("combat_exp", 8000);
  set("SEN", -1);
  set("score", 2000);

  set_skill("unarmed", 60);
  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("stick", 70);

  set("chat_chance_combat", 25);
  set("chat_msg_combat", ({
    "家丁大声的呼喊同伴:有贼呀!快来抓贼!\n",
  }));


  setup();
  carry_object("/d/beijing2/zhang/obj/jiacloth")->wear();
  carry_object("/obj/weapon/stick")->wield();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}


void greeting(object ob) {
  object ob2;
  if (!ob || !present(ob, environment(this_object()))) return;
  if (ob->query("gender") == "男性"
    && (!objectp(ob2 = present("jiading cloth", ob))
      || !ob2->query("equipped"))) {
    message_vision("家丁对着$N大喝一声:贼!往哪里走?\n", ob);
    command("kill " + ob->query("id"));
    return;
  }
  if (ob->query("gender") == "女性"
    && (!objectp(ob2 = present("yahuan cloth", ob))
      || !ob2->query("equipped"))) {
    message_vision("家丁对着$N大喝一声:贼!往哪里走?\n", ob);
    command("kill " + ob->query("id"));
    return;
  }
}
