// blader.c

#include <ansi.h>
#include <net/dns.h>

inherit NPC;

void create() {
  set_name("护院", ({ "guard", "hu yuan" }));

  set("gender", "男性");
  set("age", 38);
  set("long", "这是张百万请的护院,保卫张家的安全是他的责任。\n");
  set("combat_exp", 100000);
  set("SEN", 10);
  set("str", 28);
  set("per", 25);
  set("int", 25);
  set("spi", 27);
  set("cps", 20);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 2);

  set("attitude", "heroism");

  set_skill("parry", 80);
  set_skill("unarmed", 60);
  set_skill("dodge", 80);
  set_skill("move", 100);
  set_skill("blade", 100);
  set_skill("fanliangyi-blade", 50);
  set_skill("zixia-force", 50);

  map_skill("force", "zixia-force");
  map_skill("blade", "fanliangyi-blade");

  set("chat_chance_combat", 25);
  set("chat_msg_combat", ({
    "护院大声的呼喊同伴:有贼呀!快来抓贼!\n",
  }));


  setup();

  add_money("gold", 4);
  carry_object("obj/weapon/blade")->wield();
  carry_object("/obj/cloth/cloth")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}



void greeting(object ob) {
  object ob2;
  if (!ob || !present(ob, environment(this_object()))) return;
  if (ob->query("gender") == "男性"
    && (!objectp(ob2 = present("jiading cloth", ob))
      || !ob2->query("equipped"))) {
    message_vision("护院对着$N大喝一声:贼!往哪里走?\n", ob);
    command("kill " + ob->query("id"));
    return;
  }
  if (ob->query("gender") == "女性"
    && (!objectp(ob2 = present("yahuan cloth", ob))
      || !ob2->query("equipped"))) {
    message_vision("护院对着$N大喝一声:贼!往哪里走?\n", ob);
    command("kill " + ob->query("id"));
    return;
  }
}
