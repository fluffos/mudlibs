// wife3.c

inherit NPC;

void goout();
void do_return();

void create() {
  set_name("张杨氏", ({ "zhang" }));
  set("gender", "女性");
  set("age", 30);
  set("long", "张康武的老婆,虽然好象有些担忧的样子,但是隐隐露出一点幸灾乐祸的神色\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set("per", 30);
  set("chat_chance", 15);
  set("chat_msg", ({
    (: goout() : ),
    (: do_return() : ), }
  )
);

return_home("/beijing2/zhang/room7.lpc");
setup();
add_money("coin", 10000);
carry_object("/obj/cloth/green-silk")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object ob1, where;
  ob1 = this_object();
  where = environment(ob1);
  if (!ob || !present(ob, where))
    return;

  if (ob->query_temp("ask_zhang1") && where->query("short") == "厨房") {
    tell_object(ob, "你看见二少奶正巴一包白色的粉末放到给张少爷的食物里.\n");
    tell_object(ob, "你撞破了二少奶的好事,看起来她想杀了你灭口.\n");
    command("kill " + ob->query("id"));
    return;
  }
}

void do_return() {
  object where, ob;
  ob = this_object();
  where = environment(ob);
  if (where->query("short") == "主人卧室") return;
  if (ob->query_temp("unconcious")) return;
  ob->move("/d/beijing2/zhang/room7");
}
void goout() {
  object where, ob;
  ob = this_object();
  where = environment(ob);
  if (where->query("short") == "厨房") return;
  if (ob->query_temp("unconcious")) return;
  ob->move("/d/beijing2/zhang/room4");
}

int return_home(object home) {
  // Are we at home already?
  if (!environment()
    || environment() == home)
    return 1;

  // Are we able to leave?
  if (!living(this_object())
    || is_fighting()
    || !mapp(environment()->query("exits"))) return 0;

  // Leave for home now.
  message("vision", this_object()->name() + "急急忙忙地离开了。\n",
    environment(), this_object());
  return move(home);
}
