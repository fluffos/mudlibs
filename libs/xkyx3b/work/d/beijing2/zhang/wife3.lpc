// wife3.c

inherit NPC;

void goout();
void return ();

void create() {
  set_name("张杨氏", ({ "zhang" }));
  set("gender", "女性");
  set("age", 30);
  set("long", "张康武的老婆,虽然好象有些担忧的样子,但是隐隐露出一点幸灾乐祸的神色\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set("per", 30);
  set("chat_msg", ({
    (: goout() : ),
    (: return () : ), }
  )
);

return_home("/d/beijing2/zhang/room7.lpc");
setup();
add_money("coin", 10000);
carry_object("/d/beijing2/npc/obj/pink_cloth")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object gao;

  if (!ob || !present(ob, environment(this_object())))
    return;
  if (ob->query_temp("ask_zhang1")
    {
      tell_object(ob, "你看见二少奶正巴一包白色的粉末放到给张少爷的食物里.\n");
      tell_object(ob, "你撞破了二少奶的好事,看起来她想杀了你灭口.\n");
      command("kill " + ob->query("id"));
      return;
    }
  }

    void goout() {
      this_object()->move("/d/beijing2/zhang/room4");
    }
  void return () {
    this_object()->move("/d/beijing2/zhang/room7");
  }
