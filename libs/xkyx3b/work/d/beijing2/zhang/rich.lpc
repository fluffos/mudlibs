// rich.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "张百万家");
  set("long", @LONG
你现在正站在张百万家门口,北边是一对红漆大门(door)。
    门口有一双石狮子和一块乌木雕成的招牌(sign)。
LONG
  );
  set("exits", ([
    "east": "/d/beijing2/se_road1",
    "north": __DIR__ "garden1"
  ]));


  set("item_desc", ([
    "sign": (: look_sign :),
    "door": (: look_door, "north" :),
  ]));
  set("objects", ([
    __DIR__ "npc/zhangfu": 1 ]));

  create_door("north", "红漆大门", "south", DOOR_CLOSED);


  setup();

}

string look_sign(object me) {
  return "招牌写著：非请莫入。\n";
}

int valid_leave(object me, string dir) {
  object ob1, ob2;
  int i;

  if (dir != "north") return ::valid_leave(me, dir);

  ob1 = present("zhang fu", environment(me));

  i = 0;

  if (objectp(ob2 = present("jiading cloth", me))
    && ob2->query("equipped")) i = 1;

  if (objectp(ob2 = present("yahuan cloth", me))
    && ob2->query("equipped")) i = 1;

  if (ob1 && !ob1->query_temp("unconcious")
    && (i == 0))
    return notify_fail("张福说道：咱家主人喜欢清静,你还是回去吧！\n");
  return ::valid_leave(me, dir);
}
