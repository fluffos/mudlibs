// garden2.c

#include <room.h>

inherit ROOM;


void create() {
  set("short", "张家花园");
  set("long", @LONG
你现在正站在张百万家的花园里
    花园里白花盛开,煞是好看,令你精神为之一振.
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "garden1"
  ]));

  set("outdoors", "beijing");
  set("objects", ([
    __DIR__ "npc/dog": 1 ]));


  setup();
  replace_program(ROOM);
}
