// curio_seller.c 古玩店老板

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

int accept_object(object who, object item);
void bi_ok(object me, object item);

void create() {
  set_name("古玩店掌柜", ({ "seller", "curio seller", "boss" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "你看到一个高高瘦瘦的中年人, 拿着一个放大镜，眯着眼睛，\n"
    "盯着一个花瓶，一动也不动。\n");
  set("str", 20);
  set("int", 25);
  set("combat_exp", 15000);
  set("attitude", "friendly");
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);

  set("inquiry", ([
    "和氏璧": "和氏璧是上古神玉，价值连城，如果能找到的话就发财了。",
    "古玩": "小店就是专门做古玩生意的,客官有什么需要呢?",

  ]));

  set("vendor_goods", ([
    __DIR__ "obj/vase": 1,
  ]));

  set("heshi", 1);
  setup();
  add_money("silver", 12);
  add_money("coin", 500);
  carry_object("/obj/cloth/cloth")->wear();

}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}

