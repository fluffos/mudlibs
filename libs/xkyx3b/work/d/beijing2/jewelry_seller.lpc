// jewelry_seller.c 珠宝店老板

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;


void create() {
  set_name("珠宝店掌柜", ({ "seller", "boss" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "你看到一个高高瘦瘦的中年人,穿着一件金丝长袍，正在拨弄着一个金算盘。\n");
  set("str", 20);
  set("int", 25);
  set("combat_exp", 70000);
  set("attitude", "friendly");
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  /*        set("vendor_goods", ([
               __DIR__"obj/vase" : 1,
        ]) );
*/

  setup();
  add_money("silver", 12);
  add_money("coin", 500);
  carry_object("/obj/cloth/cloth")->wear();

}

