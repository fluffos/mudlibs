#include <login.h>

inherit ROOM;

void create() {
  set("short", "如何看，如何捡");

  set("long", @LONG

    接着要学会的事情是如何睁眼看世界－－弄清周围的环境。使用的命
令是：look（缩写为：l）。请按下l键并且回车，您将看到您所在的环境....
咦，这里有位教官....不如向他询问一下：ask officer about 帮助
    哇，这里有很多东西捡啊....
    你可以键入look officer看看教官的情况，也可以键入look leg仔细
地看鸡腿....
    真好吃的鸡腿....口水直流....如何捡起来？请输入命令：get leg，
如果你连其它东西也不想放过，就get all吧....嘻嘻。
    如果你已经明白以上内容，请按下s 键继续我们的教程。
LONG
  );

  set("exits", ([
    "south": __DIR__ "start3",
  ]));

  set("objects", ([
    __DIR__ "npc/officer": 1,
  ]));

  set("no_fight", 1);
  set("no_magic", 1);

  setup();
}

int valid_leave(object me, string dir) {
  object *list;
  int i, total;

  list = all_inventory(me);  // 不能取多块金走出此房
  if (sizeof(list) > 0) {
    total = 0;
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("id") == "gold") {
        total = list[i]->query_amount();
        break;
      }
    }
    if (dir == "south" && total > 1)
      return notify_fail("教官拦住你，说道：真是贪得无厌！只能取一两金子。\n");
  }

  me->set("startroom", START_ROOM);  // 防止通过新玩家不断取金

  return ::valid_leave(me, dir);
}
