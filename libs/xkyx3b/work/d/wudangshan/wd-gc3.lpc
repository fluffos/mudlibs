#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是武当山广场。
LONG
  );

  set("outdoors", "wudangshan");

  set("exits", ([
    "east": __DIR__ "wd-zyg",
    "south": __DIR__ "wd-jd",
    "west": __DIR__ "wd-qxg",
    "north": __DIR__ "wd-qd",
  ]));

  setup();

  replace_program(ROOM);

}
