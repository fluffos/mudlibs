#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int consider();

void create() {
  set_name("张三丰", ({ "zhang sanfeng", "zhang", "master" }));

  set("long", @LONG
他是武林中的不世奇人，就是他独创出辉映后世、照耀千古的武当一派。
他已经百年高寿，但身躯挺拔如松，毫无老态。他面上红润光滑，一把花
白长须飘于胸前，炯炯双目露出慈善的眼光，一身青布道袍更显仙风道骨。
LONG
  );

  create_family("武当派", 1, "开山祖师");
  set("rank_info/respect", "祖师");
  set("gender", "男性");
  set("age", 100);

  set("str", 20);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 35);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("inquiry", ([
    "拜师": "贫道老矣，正想找一个悟性和根骨俱佳弟子，继承衣钵，光大武当。\n",
    "帮忙": (: consider :),
    "帮助": (: consider :),
    "难事": (: consider :),

  ]));

  set("combat_exp", 8000000);
  set("SEN", 1000);

  set_skill("force", 220); set_skill("taiji-force", 220);
  set_skill("sword", 210); set_skill("taiji-sword", 210);
  set_skill("unarmed", 180); set_skill("taiji-quan", 180);
  set_skill("parry", 180);
  set_skill("move", 180); set_skill("tiyun-steps", 180);
  set_skill("dodge", 180);
  set_skill("literate", 150); set_skill("taoism", 200);

  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-sword");
  map_skill("move", "tiyun-steps");
  map_skill("dodge", "tiyun-steps");
  /*
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                // (: exert_function, "powerup" :),
                // (: perform_action :),           // (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob) {
  /*        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门只收男徒。");
                return;
        } 
*/
  if (((int)ob->query_cps() < 20) || ((int)ob->query_con() < 25 ||
    (int)ob->query_int() < 34)) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
    return;
  }


  if (((int)ob->query_skill("taiji-sword", 1) < 50)) {
    command("say 太极剑法是本门武功的基础，依我看" +
      RANK_D->query_respect(ob) + "的太极剑法似乎还不够？");
    return;
  }

  if (((int)ob->query_skill("taiji-force", 1) < 60)) {
    command("say 本门武功以呼吸吐纳为主，依我看" +
      RANK_D->query_respect(ob) + "的太极神功似乎还不够？");
    return;
  }


  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
int consider() {
  object ob1, ob2;

  ob2 = find_living("yu daiyan");
  if (ob2->query("eff_kee") == ob2->query("max_kee")) return 0;
  command("sigh");
  command("say 贫道的弟子余岱岩，早年被奸人所害。贫道想尽一切办法都不能治好他的病。");
  command("say 最近贫道听说蒙古的汝阳郡主有一种叫黑玉断续膏的治伤灵药，对治疗各种外伤非常有效。");
  command("say 只是贫道与蒙古人素无往来，那里又守卫森严，所以一直都没有办法取得。");
  command("say " + RANK_D->query_respect(this_player()) + "如果能取得黑玉断续膏，救回余岱岩一命，贫道将不胜感激。");
  this_player()->set_temp("ask_master_zhang", 1);
  return 1;
}

void init() {
  add_action("give_quest", "quest");
}
