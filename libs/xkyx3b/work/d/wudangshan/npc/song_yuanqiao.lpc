// 武当派NPC -- 宋远桥 （song_yuanqiao.c）
// Dboykey(Key) 孔雀            1998.2.23

// #include <npc.h>
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("宋远桥", ({ "song yuanqiao", "song", "master" }));
  set("nickname", "武当首侠");

  create_family("武当派", 2, "弟子");
  set("rank_info/respect", "道长");
  set("class", "taoist");

  set("gender", "男性");
  set("age", 56);

  set("long", @LONG
他是武当七侠之首，近年由于张三丰年事已高，武当派的大小事物都交由
他管理了。武当派在宋大侠的率领下，在武林中的声誉日隆。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 6000); set("force", 4500); set("force_factor", 200);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 5000000);
  set("SEN", 500);

  set_skill("force", 80); set_skill("taiji-force", 60);
  set_skill("sword", 80); set_skill("taiji-sword", 60);  // Micro: 原来是30, 不行
  set_skill("unarmed", 80); set_skill("taiji-quan", 60);
  set_skill("parry", 80);
  set_skill("move", 80); set_skill("tiyun-steps", 60);
  set_skill("dodge", 80);
  set_skill("literate", 60);

  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  map_skill("parry", "taiji-sword");
  map_skill("unarmed", "taiji-quan");
  map_skill("move", "tiyun-steps");
  map_skill("dodge", "tiyun-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.counterattack" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob) {
  if (((int)ob->query_cor() < 20)
    || ((int)ob->query_cps() < 20)) {
    command("say 学剑之人必须胆大心细，依我看" +
      RANK_D->query_respect(ob) + "的资质似乎不宜？");
    return;
  }
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) +
    "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
