#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
                                                                
    这里是武当山广场。
LONG
  );

  set("outdoors", "wudangshan");

  set("exits", ([
    "east": __DIR__ "wd-sl2",
    "south": __DIR__ "wd-ym",
    "west": __DIR__ "wd-sl1",
    "north": __DIR__ "main-01",
    // "north"     : __DIR__"main-13",
  ]));

  setup();


}
