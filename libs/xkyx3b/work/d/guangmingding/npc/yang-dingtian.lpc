#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {

  set_name("阳顶天", ({ "yang dingtian", "yang", "dingtian", "master" }));
  set("long", @LONG
他是明教第三十三代教主阳顶天。
LONG
  );

  create_family("明教", 33, "教主");

  // set("class", "bonze");

  set("gender", "男性");
  set("age", 46);

  set("str", 25);         // 膂力         
  set("cps", 25);         // 定力
  set("cor", 25);         // 胆识         
  set("per", 25);         // 容貌
  set("int", 27);         // 悟性         
  set("con", 25);         // 根骨
  set("spi", 25);         // 灵性         
  set("kar", 25);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", -200);

  set_skill("force", 200); set_skill("nuoyi-force", 200);
  set_skill("sword", 210); set_skill("guangming-sword", 210);
  set_skill("unarmed", 200); set_skill("guangming-zhang", 200);
  set_skill("parry", 220);
  set_skill("move", 250); set_skill("lieyan-steps", 250);
  set_skill("dodge", 250);
  set_skill("literate", 150);

  map_skill("force", "nuoyi-force");
  map_skill("sword", "guangming-sword");
  map_skill("unarmed", "guangming-zhang");
  map_skill("parry", "guangming-sword");
  map_skill("move", "lieyan-steps");
  map_skill("dodge", "lieyan-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object(__DIR__ "obj/white-robe")->wear();
}

void init() {
  add_action("give_quest", "quest");
}


void attempt_apprentice(object ob) {
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
