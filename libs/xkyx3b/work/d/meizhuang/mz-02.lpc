#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大  院");
  set("long", @LONG
                                                                
    这里是梅庄的大院。
LONG
  );

  set("outdoors", "meizhuang");

  set("exits", ([
    "east": __DIR__ "mz-02e",
    "west": __DIR__ "mz-02w",
    "south": __DIR__ "mz-01",
    "north": __DIR__ "mz-03",
  ]));

  setup();

  replace_program(ROOM);
}
