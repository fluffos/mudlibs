#include <weapon.h>

inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HIY "金蛇剑" NOR, ({ "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄外形奇特的剑。\n");
    set("value", 50000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声拔出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(75);
  setup();
}
