#include <weapon.h>
inherit THROWING;
#include <ansi.h>

void create() {
  set_name(HIY "金蛇锥" NOR, ({ "wimble" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "堆");
    set("value", 1000);
    set("base_unit", "把");
    set("base_weight", 1);
    set("base_value", 1);
    set("long", "这是一柄很小的蛇形兵器。\n");
    set("material", "steel");
    set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n藏入怀中。\n");
  }
  set_amount(1);
  init_throwing(20);
  setup();
}
