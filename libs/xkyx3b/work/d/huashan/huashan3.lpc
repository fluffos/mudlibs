inherit ROOM;
int flower_amount = 10;
void create() {
  set("short", "华山小路");
  set("long", @LONG
    一条经过修整的小路盘旋曲折向上延伸。路的两旁的老松树下一些无
名小花(flower)份外妖窈。这些花有红有紫，有些还有浇灌过的痕迹。繁
密的松林间透下点点日光，一阵风吹过，枝条摇摆，忽明忽暗。
LONG
  );
  set("exits", ([
    "west": "/d/huashan/huashan2",
    "up": "/d/huashan/huashan4",
  ]));
  set("outdoors", "huashan");
  set("item_desc", ([
    "无名小花": "
                        野花好美呀．．．采（ｐｉｃｋ）一朵吧！\n",
    "小花": "
                        野花好美呀．．．采（ｐｉｃｋ）一朵吧！\n",
    "flower": "
                        野花好美呀．．．采（ｐｉｃｋ）一朵吧！\n"

  ]));
  setup();
}
void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object flower;
  if (arg != "flower") return notify_fail("你要采什么？\n");
  if (!flower_amount) return notify_fail("野花已经被采光了。\n");
  message_vision("$N弯下腰，采了一朵野花。\n", this_player());
  flower = new(__DIR__ "obj/flower");
  flower->move(this_player());
  flower_amount--;
  return 1;
}

void reset() {
  flower_amount = 10;
  ::reset();
}
