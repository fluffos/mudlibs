inherit ROOM;
void create() {
  set("short", "舍 身 崖");
  set("long", @LONG
    从这往下一看，百丈悬崖笔直而下，妨如置身于天地之间。崖上有一
快比较靠近悬崖的巨石，那些想跳崖的人都是先站在石上，然后才向下跳
的。风在这里显的更加大，一不小心可能会给风吹出悬崖，死无葬身之地。
LONG
  );
  set("exits", ([
    "southdown": "/d/huashan/huashan_5",
  ]));
  set("item_desc", ([
    "巨石": "
这巨石上似乎有个脚印，你也可以踏上去跳下（ｃｈａｒｇｅ）悬崖，一了百了。\n",
  ]));
  set("outdoors", "huashan");
  setup();
}
void init() {
  add_action("do_charge", "charge");
}

int do_charge() {
  object me, room;
  me = this_player();
  message_vision("$N带着无比的哀伤，向悬崖跳去．．．\n", me);
  message_vision("$N身体悬空，如流星一般冲下悬崖，转眼就被层层的云雾吞没了．．\n", me);
  if ((int)me->query_skill("move", 1) < 100) {
    room = load_object(__DIR__ "green");
    me->move(room);
    message_vision("$N重重的摔在地上。耳边传来一阵骨络的碎裂声，接着 . . \n", me);
    me->die();
    return 1;
  } else {
    me->receive_damage("gin", 90);
    me->receive_damage("kee", 90);
    me->receive_damage("sen", 90);
    me->start_busy(3);
    message_vision("$N忽然觉得脚踏实地，揉了揉眼，发觉居然还活着！\n", me);
    room = load_object(__DIR__ "green");
    me->move(room);
  }
  return 1;
}
