inherit NPC;

void create() {
  set_name("大马猴", ({ "monkey" }));
  set("race", "野兽");
  set("age", 15);
  set("long", "它是陆大有的忠实玩伴，每当陆大有要找它的时候，都会突然出现。\n");

  set("limbs", ({ "口", "爪子" }));
  set("verbs", ({ "bite" }));
  set_skill("dodge", 500);
  set("combat_exp", 999999);
  set("bellicosity", 200);
  set_temp("apply/attack", 300);
  set_temp("apply/damage", 50);
  setup();
}
