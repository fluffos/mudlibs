// 华山派NPC -- 岳灵珊 （yue_lingshan.c）
// Dboykey(Key) 孔雀		1998.2.23

// #include <npc.h>
#include <ansi.h>

int send_fan();

inherit NPC;

void create() {
  set_name("岳灵珊", ({ "yue lingshan", "yue" }));
  set("nickname", "小师妹");
  create_family("华山派", 14, "弟子");
  set("rank_info/respect", "大侠");
  set("class", "swordman");
  set("gender", "女性");
  set("age", 22);

  set("long", @LONG
她是华山派掌门人岳不群的爱女，生性天真活泼，整个华山派的人
都很喜欢跟她说话。不过现在的样子好象很焦虑，你想：也许我能
帮她一把吧。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 3000); set("force", 3000); set("force_factor", 40);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 2500000);
  // set("SEN", 0);

  set_skill("force", 100); set_skill("zixia-force", 100);
  set_skill("sword", 100); set_skill("huashan-sword", 100);
  set_skill("unarmed", 100); set_skill("huashan-zhang", 100);
  set_skill("parry", 100);
  set_skill("move", 100); set_skill("huashan-steps", 100);
  set_skill("dodge", 100);
  set_skill("literate", 100);

  map_skill("force", "zixia-force");
  map_skill("sword", "huashan-sword");
  map_skill("blade", "fanliangyi-blade");
  map_skill("unarmed", "huashan-zhang");
  map_skill("parry", "huashan-sword");
  map_skill("move", "huashan-steps");
  map_skill("dodge", "huashan-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));
  set("inquiry", ([
    "饭": (: send_fan :),
    "饭菜": (: send_fan :),
    "大师兄": "他现在正在思过崖面壁，我刚好有事做，大师兄应该肚饿了 . . ."
  ]));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
  carry_object(__DIR__ "obj/basket2");
}

int send_fan() {
  object bag, me, rice, vege, chop;
  int exp;
  string fam;
  me = this_player();
  exp = (int)me->query("combat_exp");
  fam = (string)me->query("family/family_name");
  if ((fam == "华山派") && (exp > 300000)) {
    say("岳灵珊说道：饭菜刚刚才做好，这位" + RANK_D->query_respect(me) +
      "请等等吧。\n");
    if (bag = present("basket", this_object())) {
      say("岳灵珊停了一下又说道：请这位" + RANK_D->query_respect(me) +
        "把这个给我大师兄送去，好吗？！\n");
      me->set("give_eat", 1);
      rice = new(__DIR__ "obj/rice");
      vege = new(__DIR__ "obj/vege");
      chop = new(__DIR__ "obj/chopstick");
      rice->move(bag);
      vege->move(bag);
      chop->move(bag);
      bag->move(me);
      message_vision(HIY "$N将一件物事交给了$n，转身又去帮忙做饭了。\n" NOR, this_object(), me);
    }
  } else {
    if ((fam == "华山派") && (exp < 300000)) {
      say("多谢你的好意，但是你的经验还不够 。\n"); return 1;
    } else if (fam != "华山派") {
      say("你不是华山弟子，帮不了我的 . .\n"); return 1;
    }
  }
}
