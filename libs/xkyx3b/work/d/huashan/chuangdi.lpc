inherit ROOM;

void create() {
  set("short", "床底");
  set("long", @LONG
    这里是岳不群夫妇睡榻之下，四周黑漆漆一片，什么也没有。看来不能
在此呆得太久，不然的话，被主人发现了，那就惨了。
LONG
  );
  set("exits", ([
    "out": "/d/huashan/xiangfang",
  ]));
  set("item_desc", ([
    "wall": "
                        这是床底靠里面的一堵墙，不知道能不能推呢？\n",
  ]));
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_search", "search");
}

int do_search(string arg) {
  object ob;

  ob = this_player();
  if (ob->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");
  message_vision("$N伸出双手到处乱摸 . . . \n", ob);
  ob->start_busy(2);
  return 1;
}
int do_push(string arg) {
  object obj, me;
  if (!arg || arg == "") {
    write("你要推开什么？\n");
    return 1;
  }
  if (arg == "墙壁" || arg == "墙" || arg == "wall") {
    me = this_player();
    message_vision("$N推动靠近里面的墙，那墙居然会动，你用力一推，露出了一个入口。\n", me);
    if (!query("exits/enter")) {
      set("exits/enter", __DIR__ "mishi");
      call_out("close_path", 5);
    }
    return 1;
  } else {
    write("你不可以钻" + arg + "\n");
    return 1;
  }
}
void close_path() {
  if (!query("exits/enter")) return;
  message("vision",
    "一阵机关的响动，那堵墙自动掩上了。\n",
    this_object());
  delete("exits/enter");
}
