#include <room.h>;
#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "厢房");
  set("long", @LONG
    这是华山掌门人岳不群和他妻子的起居室，里面的摆设跟一般的没什么区别
一张小茶几放在房的中央，上面摆着一套普通的茶具；在靠里面的墙边摆着一张
床，床铺叠得整整齐齐；在北面的墙上挂着一幅岳不群练武时的画像；南面的挂
着一幅很大的山水画，画工显的唯妙唯俏，是一幅不可多得的珍品。
LONG
  );
  set("item_desc", ([
    "床": "这是一张架的比较高的床，不知能否钻（plunge）到下面去呢？！\n",
    "画像": "一张岳不群的自画像。\n",
    "山水画": "这是一张古迹，画上面的是华山的山水，很见工夫！\n"
  ]));
  set("exits", ([
    "east": __DIR__ "dating",
  ]));
  setup();
  create_door("east", "木门", "west", DOOR_CLOSED);
}

void init() {
  add_action("do_plunge", "plunge");
}

int do_plunge(string arg) {
  int i;
  object *inv, ro, me, dir;

  me = this_player();

  if (arg != "bed") return 0;

  message_vision("$N鬼祟地环顾四周，发现没人在，马上手脚并用，小心翼翼地钻到床底下去 . . .\n", me);
  if ((int)me->query_temp("book") != 0) {
    tell_room(__DIR__ "chuangdi", me->name() + "从外面钻了进来。\n");
    me->move(__DIR__ "chuangdi");
    me->set_temp("book", 0);
    return 1;
  } else {
    message_vision(HIY "你听到你身後有几个声音大叫：＂有贼呀！来抓贼呀！＂\n" NOR, me);
    message_vision(HIR "接著「咚」地一声，$N的脑后被人重重地打了一棍。\n" NOR, me);
    me->unconcious();
    message_vision(HIY "两个华山弟子把$N所有的东西搜了一遍。\n\n" NOR, me);
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      destruct(inv[i]);
    }
    message_vision(HIY "两个华山弟子把$N抬了出去。\n" NOR, me);
    me->set_temp("book", 0);
    me->move(__DIR__ "shanjiao");
    message("vision", HIY "两个华山弟子把" + me->name() + "重重地摔在了地上，然后转身离开了。\n" NOR, environment(me));
  }
  return 1;
}
