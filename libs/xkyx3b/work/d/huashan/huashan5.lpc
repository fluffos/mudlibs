inherit ROOM;

void create() {
  set("short", "华山山麓");
  set("long", @LONG
    这是一个较为开阔的空地，山势到了这里突然间变的层层叠叠。
再往西北方向则是去华山门派的小路，往东南方向则是去华山的名胜
古迹［舍身崖］的路。在此看得到一条深渊般的裂缝。
LONG
  );
  set("item_desc", ([
    "裂缝": @TEXT
    一条深不可测的裂缝，你可以试着爬(climb)下去。
TEXT
  ]));

  set("exits", ([
    "southeast": "/d/huashan/huashan4",
    "northup": "/d/huashan/huashan6",
  ]));
  set("outdoors", "huashan");

  setup();
}
