#include <ansi.h>

inherit NPC;

#define SET_SKILL       100                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       100                     // 定义特殊武功的值
#define SET_SEN         150                     // 定义正气的值

void create() {
  set_name("后将军", ({ "hou jiangjun", "hou", "jiangjun" }));

  set("long", @LONG
他是一位后将军。
LONG
  );

  set("rank_info/respect", "将军");       // 尊称
  set("attitude", "heroism");
  set("gender", "男性");                 // 性别
  set("age", 30 + random(20));         // 年纪

  set("str", 40);                         // 膂力         
  set("cps", 40);                         // 定力
  set("cor", 40);                         // 胆识         
  set("per", 20 + random(10));         // 容貌
  set("con", 40);                         // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1500); set("force", 3000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));

  set_skill("force", SET_SKILL); set_skill("yijing-force", SPE_SKILL);
  set_skill("blade", SET_SKILL); set_skill("tulong-blade", SPE_SKILL);
  set_skill("unarmed", SET_SKILL); set_skill("qixing-zhang", SPE_SKILL);
  set_skill("parry", SET_SKILL);
  set_skill("move", SET_SKILL); set_skill("xuanfeng-steps", SPE_SKILL);
  set_skill("dodge", SET_SKILL);
  set_skill("literate", SET_SKILL);

  map_skill("force", "yijing-force");
  map_skill("blade", "tulong-blade");
  map_skill("unarmed", "qixing-zhang");
  map_skill("parry", "tulong-blade");
  map_skill("move", "xuanfeng-steps");
  map_skill("dodge", "xuanfeng-steps");

  setup();

  carry_object(__DIR__ "obj/jin-kui")->wear();     // 装备
  carry_object(__DIR__ "obj/gold-zhanjia")->wear();
  carry_object(__DIR__ "obj/jin-xue")->wear();

  carry_object(__DIR__ "obj/bao_blade")->wield();
}
