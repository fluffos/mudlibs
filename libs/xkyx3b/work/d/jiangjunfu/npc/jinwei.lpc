#include <ansi.h>

inherit NPC;

#define SET_SKILL       100                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       100                     // 定义特殊武功的值
#define SET_SEN         10                      // 定义正气的值

void create() {
  set_name("近卫", ({ "jin wei" }));

  set("long", @LONG
他是一位近卫。
LONG
  );

  // set("rank_info/respect", "将军");    // 尊称
  set("attitude", "heroism");
  set("gender", "男性");                 // 性别
  set("age", 30 + random(20));         // 年纪

  set("str", 40);                         // 膂力         
  set("cps", 40);                         // 定力
  set("cor", 40);                         // 胆识         
  set("per", 20 + random(10));         // 容貌
  set("con", 40);                         // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    // (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));

  set_skill("force", SET_SKILL); set_skill("kunlun-force", SPE_SKILL);
  set_skill("blade", SET_SKILL); set_skill("puti-blade", SPE_SKILL);
  set_skill("unarmed", SET_SKILL); set_skill("kunlun-zhang", SPE_SKILL);
  set_skill("parry", SET_SKILL);
  set_skill("move", SET_SKILL); set_skill("kunlun-steps", SPE_SKILL);
  set_skill("dodge", SET_SKILL);
  set_skill("literate", SET_SKILL);

  map_skill("force", "kunlun-force");
  map_skill("blade", "puti-blade");
  map_skill("unarmed", "kunlun-zhang");
  map_skill("parry", "puti-blade");
  map_skill("move", "kunlun-steps");
  map_skill("dodge", "kunlun-steps");

  setup();

  carry_object(__DIR__ "obj/tou-kui")->wear();     // 装备
  carry_object(__DIR__ "obj/zhanpao")->wear();
  carry_object(__DIR__ "obj/xuezi")->wear();

  carry_object(__DIR__ "obj/blade")->wield();
}
