#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(WHT "铁盔" NOR, ({ "tie kui", "kui" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一顶普通的头盔。\n");
    set("unit", "顶");
    set("value", 1000);
    set("material", "iron");
    set("armor_type", "head");
    set("armor_prop/armor", 3);
    set("armor_prop/defense", 0);
    set("armor_prop/dodge", 0);
    set("wear_msg", "$N将$n取出戴在头上。\n");
  }
  setup();
}
