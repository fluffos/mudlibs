#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(YEL "铜靴" NOR, ({ "tong xue", "xue" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双普通的铜靴。\n");
    set("unit", "双");
    set("value", 2000);
    set("material", "corpper");
    set("armor_type", "boots");
    set("armor_prop/armor", 4);
    set("armor_prop/defense", 0);
    set("armor_prop/dodge", 0);
  }
  setup();
}
