#include <weapon.h>

inherit BLADE;

void create() {
  set_name("宝刀", ({ "bao-blade", "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 10000);
    set("material", "steel");
    set("long", "这是一把普通的宝刀。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(50);
  setup();
}
