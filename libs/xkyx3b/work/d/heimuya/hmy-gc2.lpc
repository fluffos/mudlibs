#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是黑木崖的广场。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "south": __DIR__ "hmy-cdm",
    "north": __DIR__ "hmy-gc3",
    "west": __DIR__ "hmy-gc2-xwt",
    "east": __DIR__ "hmy-gc2-flt",
  ]));

  setup();

  replace_program(ROOM);

}
