#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "议事殿");
  set("long", @LONG
								
    这里是黑木崖的议事殿。
LONG
  );

  // set("outdoors", "kunlunshan");

  set("exits", ([
    "north": __DIR__ "hmy-nsm",
