#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "白玉牌楼");
  set("long", @LONG
								
    这里是黑木崖的白玉牌楼。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "north": __DIR__ "hmy-qsdd",
    "south": __DIR__ "hmy-hmyd",
  ]));

  setup();

  replace_program(ROOM);

}
