#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "文武门");
  set("long", @LONG
								
    这里是黑木崖的文武门。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "south": __DIR__ "hmy-nsm",
    "north": __DIR__ "hmy-cdm",
  ]));

  setup();

  replace_program(ROOM);

}
