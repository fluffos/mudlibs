#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小  院");
  set("long", @LONG
								
    这里是黑木崖的小院。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "north": __DIR__ "hmy-gc1-xf1",
    "west": __DIR__ "hmy-gc1-xf2",
    "east": __DIR__ "hmy-qianting",
  ]));

  setup();

  replace_program(ROOM);

}
