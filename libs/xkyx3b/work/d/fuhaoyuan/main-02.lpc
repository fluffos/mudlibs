#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "小  院");
  set("long", @LONG

    这里是侠客城富豪的小院。
LONG
  );

  set("exits", ([
    "east": __DIR__ "main-01",
    "west": __DIR__ "main-03",
    "south": __DIR__ "main-02s",
    "north": __DIR__ "main-02n",
  ]));

  set("outdoors", "fuhaoyuan");

  setup();

  replace_program(ROOM);
}
