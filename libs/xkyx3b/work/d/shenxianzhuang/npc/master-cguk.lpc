#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("灰姑娘", ({ "master cguk", "master" }));

  set("long", @LONG
她是神仙山庄的开山祖师，也是侠客英雄传掌门张三丰（Micro ）的夫人。
她身着雪白的衣衫，雪白的长裙，身形苗条婀娜，气定神闲，轻风动裾，
飘飘兮如仙子下凡尘。你不禁想起庄子的描述：藐姑射之山，有神人居焉，
肌肤若冰雪，绰约若处子，不食五谷，吸风饮露。
LONG
  );

  create_family("神仙山庄", 1, "开山祖师");
  set("nickname", RED "风云女侠" NOR);
  set("rank_info/respect", "祖师");
  set("gender", "女性");
  set("age", 20);

  set("str", 50);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 50);         // 悟性         
  set("con", 50);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 1000); set("atman", 2000);
  set("max_force", 2000); set("force", 4000); set("force_factor", 200);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  // set("SEN",10000000);

  set_skill("force", 130); set_skill("bahuang-force", 130);
  set_skill("sword", 150); set_skill("ruyixiaoyao-sword", 150);
  set_skill("unarmed", 150); set_skill("tianxian-zhang", 150);
  set_skill("parry", 150);
  set_skill("move", 150); set_skill("feixian-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 200);
  set_skill("magic", 200); set_skill("essencemagic", 200);
  set_skill("buddhism", 200);

  map_skill("force", "bahuang-force");
  map_skill("sword", "ruyixiaoyao-sword");
  map_skill("unarmed", "tianxian-zhang");
  map_skill("parry", "ruyixiaoyao-sword");
  map_skill("move", "feixian-steps");
  map_skill("dodge", "feixian-steps");
  map_skill("magic", "essencemagic");
  /*
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                // (: perform_action :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob) {
  if (((string)ob->query("gender") != "女性")) {
    command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门只收女徒。");
    return;
  }
  if (((int)ob->query("per") < 20)) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
    return;
  }
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}

int do_kill() {
  object ob;

  if (objectp(ob = present("master micro", environment(this_object())))) {
    message_vision("灰姑娘的丈夫张三丰对$N发动攻击！\n", this_player());
    ob->kill_ob(this_player());
  } else
    this_object()->kill_ob(this_player());

  return 1;
}

int accept_fight(object me) {
  return do_kill();
}

int accept_kill(object me) {
  return do_kill();
}

void init() {
  add_action("give_quest", "quest");
}
