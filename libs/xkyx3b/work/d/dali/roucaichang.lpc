#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "肉菜场");
  set("long", @LONG

    这里是大理城的肉菜场，往集市供应新鲜的肉菜的第一场所。肉架上
挂满了血淋淋的生肉，地上摆着青菜、白菜等等，不时有几只苍蝇在屋里
飞来飞去。靠近门口的地方有一块招牌(sign)。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "west": __DIR__ "zhubaodian",
    "south": __DIR__ "zahuopu",
    "north": __DIR__ "jishi-w",
  ]));

  set("objects", ([
    __DIR__ "npc/huoji": 1,
    "/d/center/npc/fly": 3,
  ]));

  setup();

}
