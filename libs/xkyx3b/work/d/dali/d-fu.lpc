inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "段  府");
  set("long", @LONG

    这里是段誉居住的地方。四周的摆设非常简单，几盆花、一张木椅，
屏风后面便站着段誉。
LONG
  );

  set("exits", ([
    "east": __DIR__ "d-tingyuan-e",
    "west": __DIR__ "d-tingyuan-w",
    "north": __DIR__ "d-tingyuan-n",
    "south": __DIR__ "d-tingyuan-s",
  ]));

  set("objects", ([
    __DIR__ "npc/master-duan": 1,
  ]));

  setup();
}
