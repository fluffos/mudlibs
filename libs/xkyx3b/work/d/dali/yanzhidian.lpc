#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "胭脂店");
  set("long", @LONG

    这是大理城的胭脂店。刚进门，你就闻到一股沁人心脾的清香。大理
的胭脂是世上最好的。
LONG
  );

  set("exits", ([
    "north": __DIR__ "zhubaodian",
    "east": __DIR__ "zahuopu",
  ]));

  set("objects", ([
    __DIR__ "npc/yzd-seller": 1,
    __DIR__ "npc/girl": 3,
  ]));

  setup();

}
