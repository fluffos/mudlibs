// guoshifu.c - 国师府大门
// Designed by Carlis

inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "国师府大门");
  set("long", @LONG

    这里是大理国国师府的大门，奇怪的是，门口居然连一个卫士也没有。
不过看起来要开这个门并非易事，据说门是采用上等的大理石，由国师亲
自督建成的，比城门还要大几倍。石门上似乎有个缺口(kou)，你凑过去想
看看(look)究竟是什么。
LONG
  );

  set("item_desc", ([
    "kou": @TEXT
这是一块方形的凹进缺口，似乎是开启这个门的机关。缺口上方有个小字，
你趴近了看，原来是一个“玉”字。
TEXT,
  ]));

  set("exits", ([
    "south": __DIR__ "roadw2",
    // "north" : __DIR__"carlis.lpc",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object obj;

  if (dir == "north" && !objectp(obj = present("dali shenyu", me))) {
    message_vision("$N用尽力气想掰开大门，可是大门连动一下都没有。\n", me);
    return notify_fail("");
  }
  if (dir == "north") message_vision("$N将大理神玉放入门上的缺口中，门开了，$N大笑几声走了进去。", me);
  return ::valid_leave(me, dir);
}
