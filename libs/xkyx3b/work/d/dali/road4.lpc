inherit ROOM;

void home(object ob);

void create() {
  set("short", "东大街");
  set("long", @LONG

    这里是大理城的东大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆。北边是大理城的东集市，你可以听到那里传出的此起
彼伏的讨价还价声；南边则是寂静的超渡法场，你远远看见一位禅师在那
儿手舞足蹈，不禁觉得好笑。再往东就是大理东城门，旅客进进出出，喧
闹异常。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "east": __DIR__ "chengmen-e",
    "south": __DIR__ "chaodufachang",
    "west": __DIR__ "roade2",
    "north": __DIR__ "jishi-e",
  ]));
}
