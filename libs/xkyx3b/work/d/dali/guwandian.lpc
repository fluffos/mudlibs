#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "古玩店");
  set("long", @LONG

    这里是大理城的古玩店。四处放的都是一些非常古老的东西，老板笑
咪咪地为客人介绍这些古玩的历史。
LONG
  );

  set("exits", ([
    "east": __DIR__ "yuqidian",
    "south": __DIR__ "xilou",
    "west": __DIR__ "zaotang",
    "north": __DIR__ "ciqipu",
  ]));

  set("objects", ([
    __DIR__ "npc/gwd-seller": 1
  ]));

  setup();

  replace_program(ROOM);
}
