#include <room.h>

inherit ROOM;

void create() {
  set("short", "庭  院");
  set("long", @LONG

    这里是段府庭院，段府中的人没事都喜欢来这里。
LONG
  );

  set("exits", ([
    "east": __DIR__ "d-lu-e",
    "west": __DIR__ "d-fu",
    "south": __DIR__ "d-jiangjun-s",
    "north": __DIR__ "d-jiangjun-e",
  ]));

  setup();

}
