#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "珠宝店");
  set("long", @LONG

    这里是一家新建不久的珠宝店。
LONG
  );

  set("exits", ([
    "east": __DIR__ "roucaichang",
    "south": __DIR__ "yanzhidian",
    "north": __DIR__ "shudian",
  ]));

  set("objects", ([
    __DIR__ "npc/zbd-seller": 1,
    __DIR__ "npc/boy": 1,
  ]));

  setup();

  replace_program(ROOM);
}
