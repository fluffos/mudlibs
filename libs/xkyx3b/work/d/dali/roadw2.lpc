// roadw2.c - 西大街
// Designed by Carlis

inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG

    你走在西大街上，踩着坚实的青石板地面。北面是大理国国师府，听
说那位具有神力的国师萧晨便住在里面。南面是西集市，你可以听见此起
彼伏的讨价还价声。再往东走便是大理段府，不过看起来门口的卫兵似乎
不会那么轻易让你进去。
LONG);
  set("outdoors", "dali");

  set("exits", ([
    "east": __DIR__ "d-men-w",
    "south": __DIR__ "jishi-w",
    "west": __DIR__ "roadw1",
    "north": __DIR__ "guoshifu",
  ]));

  setup();

}
