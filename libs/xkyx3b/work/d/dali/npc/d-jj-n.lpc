#include <ansi.h>

inherit NPC;

#define SET_SKILL       120                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       120                     // 定义特殊武功的值
#define SET_SEN         250                     // 定义正气的值

void create() {
  set_name("镇北将军", ({ "jiangjun" }));

  set("long", @LONG
他是一位大将军。
LONG
  );

  set("rank_info/respect", "将军");       // 尊称
  set("attitude", "heroism");
  set("gender", "男性");                 // 性别
  set("age", 30 + random(20));         // 年纪

  set("str", 40);                         // 膂力
  set("cps", 40);                         // 定力
  set("cor", 40);                         // 胆识
  set("per", 30);                         // 容貌
  set("con", 40);                         // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1500); set("force", 3000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));

  set_skill("force", SET_SKILL); set_skill("taixuan-force", SPE_SKILL);
  set_skill("sword", SET_SKILL); set_skill("xuantie-sword", SPE_SKILL);
  set_skill("unarmed", SET_SKILL); set_skill("xianglong-zhang", SPE_SKILL);
  set_skill("parry", SET_SKILL);
  set_skill("move", SET_SKILL); set_skill("tiyun-steps", SPE_SKILL);
  set_skill("dodge", SET_SKILL);
  set_skill("literate", SET_SKILL);

  map_skill("force", "taixuan-force");
  map_skill("sword", "xuantie-sword");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("parry", "xuantie-sword");
  map_skill("move", "tiyun-steps");
  map_skill("dodge", "tiyun-steps");

  setup();

  carry_object(__DIR__ "obj/zijin-kui")->wear();   // 装备
  carry_object(__DIR__ "obj/gold-baojia")->wear();
  carry_object(__DIR__ "obj/zijin-xue")->wear();

  carry_object(__DIR__ "obj/qinghong_sword")->wield();
}
