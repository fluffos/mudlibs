// bqp-seller.c - 兵器铺主人
// Designed by Carlis

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  int n;

  set_name("兵器铺老板", ({ "seller", "waiter" }));

  set("long", @LONG
他就是兵器铺老板。
LONG
  );

  set("rank_info/respect", "老板");       // 尊称
  set("attitude", "friendly");
  set("gender", "男性");                 // 性别
  set("age", 36);                         // 年纪

  set("str", 50);                      // 膂力
  // set("cps", 30);                      // 定力
  // set("cor", 30);                      // 胆识
  // set("per", 30);                      // 容貌
  // set("con", 30);                      // 根骨

  set("combat_exp", 1000);
  set("SEN", 0);

  set("env/wimpy", 30);                   //

  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);

  set("vendor_goods", ([
    "/obj/weapon/sword": 5,
    "/obj/weapon/blade": 5,
    "/obj/weapon/steel_staff": 5,
    "/obj/weapon/fork": 5,
    "/obj/weapon/stick": 5,
    "/obj/weapon/whip": 5,
  ]));

  setup();

  carry_object("/obj/cloth/cloth")->wear();       // 装备

  add_money("silver", 50);                        // 金钱
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (this_object()->query_temp("unconcious")) return;
  switch (random(1)) {
    case 0:
      say(this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想买兵器吗？大理的剑很便宜哦！\n");
      break;
  }
}
