#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("枯荣大师", ({ "master gurong", "gurong", "master" }));

  set("long", @LONG
他就是枯荣大师。他左边的一半脸色红润，皮光肉滑，有如婴儿，右边的
一半面却如枯骨，除了一张焦黄的面皮之外全无肌肉，骨头突了出来，宛
如半个骷髅头。
LONG
  );

  create_family("大理国", 6, "弟子");
  set("rank_info/respect", "大师");
  set("gender", "男性");
  set("age", 28);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 20);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", 200);

  set_skill("force", 180); set_skill("gumu-force", 180);
  set_skill("sword", 180); set_skill("liumai-sword", 180);
  set_skill("stick", 220); set_skill("tianlong-staff", 220);
  set_skill("unarmed", 150); set_skill("yiyang-zhi", 150);
  set_skill("parry", 150);
  set_skill("move", 220);     // set_skill("lingbo-steps", 220);
  set_skill("dodge", 220);
  set_skill("literate", 200);

  map_skill("force", "gumu-force");
  map_skill("sword", "liumai-sword");
  map_skill("stick", "tianlong-staff");
  map_skill("unarmed", "liumai-sword");
  map_skill("parry", "liumai-sword");
  // map_skill("move",    "lingbo-steps");
  // map_skill("dodge",   "lingbo-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/long_sword")->wear();
}

void attempt_apprentice(object ob) {

  /*
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}

void init() {
  add_action("give_quest", "quest");
}
