// master-Carlis.c
// Designed by Carlis

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me1();

void create() {
  set_name("萧晨", ({ "Carlis" }));
  set("title", "大理国国师");

  set("long", @LONG

他是大理国的老国师, 自大理国建成之初便担任此职,
处理国家的大小事务. 但奇怪的是他可以青春永驻, 活
了一百多年还是个二十多岁的年轻人.

LONG
  );

  create_family("大理国", 1, "国师");
  set("rank_info/respect", "国师");
  set("gender", "男性");
  set("age", 26);

  set("str", 100);         // 膂力
  set("cps", 100);         // 定力
  set("cor", 100);         // 胆识
  set("per", 100);         // 容貌
  set("int", 100);         // 悟性
  set("con", 100);         // 根骨
  set("spi", 100);         // 灵性
  set("kar", 100);         // 福缘

  set("max_kee", 4000); set("kee", 4000);
  set("max_gin", 4000); set("gin", 4000);
  set("max_sen", 4000); set("sen", 4000);

  set("max_atman", 10000); set("atman", 60000);
  set("max_force", 10000); set("force", 60000); set("force_factor", 400);
  set("max_mana", 10000); set("mana", 60000);

  set("combat_exp", 987654321);
  set("SEN", 65535);

  set_skill("force", 300); set_skill("taixuan-force", 300);
  set_skill("sword", 300); set_skill("dugu-sword", 300);
  set_skill("unarmed", 300); set_skill("liumai-sword", 300);
  set_skill("parry", 300);
  set_skill("move", 300); set_skill("lingbo-steps", 300);
  set_skill("dodge", 300);
  set_skill("literate", 300);
  set_skill("spells", 300); set_skill("necromancy", 300);
  set_skill("taoism", 300);
  set_skill("magic", 300); set_skill("essencemagic", 300);

  map_skill("force", "taixuan-force");
  map_skill("sword", "dugu-sword");
  map_skill("unarmed", "liumai-sword");
  map_skill("parry", "dugu-sword");
  map_skill("move", "lingbo-steps");
  map_skill("dodge", "lingbo-steps");
  map_skill("spells", "necromancy");
  map_skill("magic", "essencemagic");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    HIW "萧晨长叹一声，说道：你不是我的对手，你还是去吧....\n" NOR,
    HIW "萧晨沉重地说道：我的事务繁忙，不要再与我纠缠....\n" NOR,
  }));

  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob) {

  command("say 我的事务繁忙，勿要烦我....");
  return;
}

