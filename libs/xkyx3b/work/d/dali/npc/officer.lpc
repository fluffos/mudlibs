// officer.c - 驿站站长
// Designed by Carlis

#include <ansi.h>

inherit NPC;

#define SET_SKILL	80			// 定义基本武功的值（随机），自动生成经验
#define SET_SEN		50			// 定义正气的值

string send_mail();
string receive_mail();

void create() {
  int n;

  set_name("驿站站长", ({ "officer" }));

  set("long", @LONG
他是驿站的站长。
LONG
  );

  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 40);

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 70);   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("inquiry", ([
    "驿站": "是啊....这里就是大理城的驿站，你要寄信吗？",
    "寄信": (: send_mail :),
    "send": (: send_mail :),
    "收信": (: receive_mail :),
    "mail": (: receive_mail :),
  ]));

  setup();

  carry_object("/obj/cloth/cloth")->wear();  // 装备

  add_money("silver", 50);   // 金钱
}

string send_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "你的信箱还在吧？用信箱就可以寄信了。\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "真是抱歉，请您等一下到驿站来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "哦....要寄信是吗？这是你的信箱，寄信的方法信箱上有说明。\n";
}

string receive_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "你的信箱还在吧？你所有的信都在里面。\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "真是抱歉，请您等一下到驿站来找我吧。\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "好，待我找找....有了，你的信箱在这，慢慢看吧，不打搅你了。\n";
}
