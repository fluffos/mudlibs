#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("段誉", ({ "duan yu", "duan", "master" }));

  set("long", @LONG
他是大理国的世子。他身着淡黄长衫，手上拿着描金玉骨扇，风度翩翩，
丰采俊雅，玉树临风，眉宇间隐隐透出帝王之相，但行事为人却傻里傻气，
整日诗书佛经不离口边。
LONG
  );

  create_family("大理国", 8, "弟子");
  set("rank_info/respect", "太子");
  set("gender", "男性");
  set("age", 28);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", 200);

  set_skill("force", 120); set_skill("beiming-force", 120);
  set_skill("sword", 190); set_skill("liumai-sword", 190);
  set_skill("unarmed", 150); set_skill("yiyang-zhi", 150);
  set_skill("parry", 150);
  set_skill("move", 150); set_skill("lingbo-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 200);

  map_skill("force", "beiming-force");
  map_skill("sword", "liumai-sword");
  map_skill("unarmed", "liumai-sword");
  map_skill("parry", "liumai-sword");
  map_skill("move", "lingbo-steps");
  map_skill("dodge", "lingbo-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wear();
}
