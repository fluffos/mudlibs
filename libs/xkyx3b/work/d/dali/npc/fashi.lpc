// fashi.c - 法师
// Designed by Carlis

#include <ansi.h>

inherit NPC;

#define SET_SKILL	30			// 定义基本武功的值（随机），自动生成经验
#define SET_SEN		50			// 定义正气的值

void create() {
  int n;

  set_name("法师", ({ "wizard" }));

  set("long", @LONG
这是一位法师。
LONG
  );

  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 52);

  set("per", 30);   // 容貌

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  setup();

  carry_object("/obj/cloth/cloth")->wear();  // 装备
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("法师说道：这位" + RANK_D->query_respect(ob) + "，有什么需要吗？\n");
}

int accept_object(object who, object ob) {
  int val;

  val = ob->value();
  if (!val)
    return notify_fail("法师不收物品。\n");
  else if (val >= 20000000) {
    say("\n法师说道：嗯，可以开始了。\n");
    message_vision(HIW "只见法师口中念念有词，忽然一道光芒射向$N！！\n" NOR, who);
    say("法师说道：嗯，完成了。今后你就可以使用魔法物品了。\n");
    who->set("magic", 1);
  }

  return 1;
}
