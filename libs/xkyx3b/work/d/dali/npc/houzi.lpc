// houzi.c - 猴子
// Designed by Carlis

#include <ansi.h>

inherit NPC;

void create() {
  set_name("猴子", ({ "monkey", "hou zi", "hou" }));

  set("long", @LONG
一只可爱的小猴子，正模仿着你的动作。
LONG
  );

  set("race", "野兽");
  set("limbs", ({ "头", "胸脯", "肚子", "脚", "手", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("age", 4);

  set("combat_exp", 60000);

  set("chat_chance", 6);
  set("chat_msg", ({
    "猴子在山上跳来跳去，不时模仿一下你的动作。\n",
    "猴子在山上对你扔东西，真让人又爱又恨。\n",
    "猴子对着你咭咭地叫。\n",
    (: this_object(), "random_move" :),
  }));

  set_temp("apply/attack", 80);
  set_temp("apply/armor", 25);
  set_temp("apply/damage", 10);
  set_temp("apply/dodge", 100);

  setup();
}
