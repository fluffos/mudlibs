#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_me1();

void create() {
  set_name("卫士", ({ "wei shi" }));
  set("long", @LONG
这是一名卫士。
LONG
  );

  set("gender", "男性");
  set("age", 36);

  set("str", 30);         // 膂力
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性
  set("kar", 30);         // 福缘

  set("max_kee", 1000); set("kee", 1000);
  set("max_gin", 1000); set("gin", 1000);
  set("max_sen", 1000); set("sen", 1000);

  set("max_force", 5000); set("force", 10000); set("force_factor", 100);

  set("combat_exp", 5000000);
  set("SEN", 100);

  set_skill("force", 150); set_skill("taixuan-force", 180);
  set_skill("sword", 150); set_skill("liumai-sword", 180);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("move", 150); set_skill("taxue-steps", 180);
  set_skill("dodge", 150);
  set_skill("literate", 150);

  map_skill("force", "taixuan-force");
  map_skill("sword", "liumai-sword");
  map_skill("unarmed", "liumai-sword");
  map_skill("parry", "liumai-sword");
  map_skill("move", "taxue-steps");
  map_skill("dodge", "taxue-steps");

  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}
