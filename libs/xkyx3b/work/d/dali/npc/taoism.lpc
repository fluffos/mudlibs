// taoism.c - 小道士
// Designed by Carlis

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       0                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         5                       // 定义正气的值

void create() {
  int n;

  set_name("小道士", ({ "dao shi", "waiter" }));

  set("long", @LONG
他是一位小道士。
LONG
  );

  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 16);

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("vendor_goods", ([
    "/obj/book/taoism_book_a": 3,
    "/obj/book/taoism_book_b": 3,
  ]));

  setup();

  carry_object("/obj/cloth/taoism-pao")->wear();  // 装备
  carry_object("/obj/book/taoism_book_c");
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say("小道士说道：这位" + RANK_D->query_respect(ob)
        + "，我师傅出去了，要看道家学说请跟我说。\n");
      break;
  }
}
