#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "明堂书院");
  set("long", @LONG

    这里是大理城明堂书院。窗明几净，一尘不染。一位庄重严肃的老先
生坐在太师椅上讲学。在他的两侧坐满了求学的学生。一张古意盎然的书
案放在老先生的前面。
LONG
  );

  set("exits", ([
    "south": __DIR__ "roadw1",
    "north": __DIR__ "kaochang",
  ]));

  set("objects", ([
    __DIR__ "npc/teacher": 1,
    __DIR__ "npc/student": 3,
  ]));

  setup();
}
