inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG

    这里是大理城的南大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆。东面是大理城的南集市，讨价还价的声音此起彼伏；
西面是生意红火的药堂时珍堂，里面坐满了探病求医的人。北面是大理段
府，不过看起来门口的卫兵似乎不会那么轻易让你进去。再往南走便是城
门了。
LONG
  );

  set("outdoors", "dali");

  set("exits", ([
    "east": __DIR__ "jishi-s",
    "south": __DIR__ "chengmen-s",
    "west": __DIR__ "shizhentang",
    "north": __DIR__ "d-men-s",
  ]));

  setup();

}
