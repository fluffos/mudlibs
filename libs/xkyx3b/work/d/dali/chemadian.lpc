// chemadian - 车马店
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "车马店");
  set("long", @LONG

    这里是大理城的车马店。旁边放著一块牌子(sign)。
LONG
  );

  set("item_desc", ([
    "sign": @TEXT
目前我们提供的服务有：
[36m
name        设定独门坐骑的名称。
unit        设定独门坐骑的单位。
ride_msg    设定独门坐骑装备信息。
unride_msg  设定独门坐骑卸装信息。
make        训练独门坐骑。
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "east": __DIR__ "huadian",
    "west": __DIR__ "roadn1",
  ]));

  set("objects", ([
    __DIR__ "npc/cmd-seller": 1,
    __DIR__ "npc/huoji": 1,
  ]));

  setup();

}
