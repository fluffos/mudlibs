// caifengdian.c - 裁缝店
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "裁缝店");
  set("long", @LONG

    这里是大理城的裁缝店。店主人正在认真地缝制一件衣服。当你想跟
他说两句时，他示意你不要说话，并指着他身边的一块牌子(sign)让你看。
LONG
  );

  set("item_desc", ([
    "sign": @TEXT
目前我们提供的服务有：
[36m
name        设定独门穿着的名称。
wear_msg    设定独门穿着装备信息。
remove_msg  设定独门穿着卸装信息。
make        制造独门穿着。
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "east": __DIR__ "buzhuang",
    "north": __DIR__ "zahuopu",
  ]));

  set("objects", ([
    __DIR__ "npc/caifeng": 1,
  ]));

  setup();

  replace_program(ROOM);
}
