#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "竹器铺");
  set("long", @LONG

    这里是侠客城的竹器铺。货架上摆着琳琅满目的竹器。侠客城中居民
所需的竹器都是来自这里。老板从二十六岁就继承父业接过了这间竹器店，
凭着价廉物美的宗旨，已经苦心经营了二十多年了。
LONG
  );

  set("exits", ([
    "east": __DIR__ "muqipu",
    "south": __DIR__ "bamboo_hurst",
    "west": __DIR__ "huadian",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-zqp": 1,
  ]));

  setup();

}
