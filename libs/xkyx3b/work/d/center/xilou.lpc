#include <room.h>

inherit ROOM;

void create() {
  set("short", "戏  楼");
  set("long", @LONG

    这里是侠客城的戏楼。
LONG
  );

  set("exits", ([
    "east": __DIR__ "drinkery",
    "south": __DIR__ "caifengdian",
    "west": __DIR__ "xiaoxihu",
  ]));

  set("objects", ([
    __DIR__ "npc/kid": 2,
  ]));

  setup();

}
