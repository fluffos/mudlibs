#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "超渡法场");
  set("long", @LONG

    这里是侠客城的超渡法场。
LONG
  );

  set("exits", ([
    "east": __DIR__ "guancaipu",
    "west": __DIR__ "bamboo_hurst",
    "north": __DIR__ "muqipu",
  ]));

  set("objects", ([
    __DIR__ "npc/chanshi": 1,
  ]));

  setup();

  replace_program(ROOM);
}
