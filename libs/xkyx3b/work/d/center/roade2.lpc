inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG

    你走在东大街上，踩着坚实的青石板地面。南边是通往英雄山庄的大
门。北边是一座威严的将军府。
LONG);
  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "roade3",
    "south": __DIR__ "shanzhuang",
    "west": __DIR__ "roade1",
    "north": __DIR__ "jiangjunfu",
  ]));

  set("objects", ([
    __DIR__ "npc/lao-heshang": 1,
  ]));

  setup();

}
