#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "书  店");
  set("long", @LONG

    这里是侠客城的书店。
LONG
  );

  set("exits", ([
    "south": __DIR__ "roadw3",
    "west": __DIR__ "chenghuangmiao",
    "north": __DIR__ "shuyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/powanjuan": 1,
    __DIR__ "npc/dushuren": 1,
  ]));

  setup();

  replace_program(ROOM);
}
