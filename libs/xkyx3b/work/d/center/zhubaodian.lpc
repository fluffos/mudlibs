#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "珠宝店");
  set("long", @LONG
								
    这里是一家有百年历史的珠宝店。牌匾上写着“童叟无欺”四个大字。
里面摆满了来自全国各地的奇珍异宝，也混杂着一些异域的宝贝，如南洋
的黑珍珠，大食的钻石，欧罗巴的西洋钟等等。相传当年皇上巡视江南的
时候就专门来这里看过，“童叟无欺”四个字就是他命大学士纪晓岚乘兴
写下的。
LONG
  );

  set("exits", ([
    "east": __DIR__ "yanzhidian",
    "south": __DIR__ "caichang",
    "west": __DIR__ "yuqidian",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-zbd": 1,
    __DIR__ "npc/dahan": 1,
  ]));

  setup();

  replace_program(ROOM);
}
