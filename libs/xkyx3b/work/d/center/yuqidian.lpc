#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "玉器店");
  set("long", @LONG

    这里是侠客城的玉器店。在各式各样的玉器中间，坐这一位胖乎乎的
老板，笑咪咪地翻看着帐簿。自古相传玉能辟邪护身，是吉祥的象征。因
为没有竞争对手，这家店一直生意很好，门面最近又换了新的了。
LONG
  );

  set("exits", ([
    "east": __DIR__ "zhubaodian",
    "south": __DIR__ "xiaohuayuan",
    "west": __DIR__ "chemadian",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-yqd": 1,
    __DIR__ "npc/dahan": 1,
  ]));

  setup();

  replace_program(ROOM);
}
