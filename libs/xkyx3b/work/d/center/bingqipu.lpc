#include <room.h>

inherit ROOM;

void create() {
  set("short", "兵器铺");
  set("long", @LONG

    这里是侠客城的兵器铺，到处银光闪闪，让人眼花缭乱。各色各样的
兵器应有尽有，你一时不知道挑什么好。
LONG
  );

  set("exits", ([
    "south": __DIR__ "zahuopu",
    "west": __DIR__ "shambles",
    "north": __DIR__ "ciqipu",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-bqp": 1,
  ]));

  setup();

  replace_program(ROOM);
}
