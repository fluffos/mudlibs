#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "大佛寺");
  set("long", @LONG

    这是侠客城大佛寺。进到寺中，只见满殿香烟迷漫，丈六高的释迦牟
尼居中而坐，拈花普贤，净瓶观音侍立两旁，下面护法金刚都胎骨法身，
五彩装颜，水金沥粉涂身，漫墙壁画看来也粉饰不久，但见满天神佛充塞
满墙，金碧交错。附近好施乐善的人家每月凑了一些钱财或五谷杂粮，让
无家可归的乞丐来这里领取一份食物，聊以充饥。
LONG
  );

  set("exits", ([
    "east": __DIR__ "shuyuan",
    "south": __DIR__ "chenghuangmiao",
    "north": __DIR__ "daoguan",
  ]));

  set("objects", ([
    __DIR__ "npc/buddhism": 1,
    __DIR__ "npc/beggar": 1,
    "/obj/food/bread": 2,
  ]));

  setup();

}
