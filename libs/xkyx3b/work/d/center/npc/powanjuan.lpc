#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       60                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         0                       // 定义正气的值

void create() {
  int n;

  set_name("破万卷", ({ "po wanjuan", "po", "waiter" }));

  set("long", @LONG
他就是破万卷，一位很好学的读书人。
LONG
  );

  set("rank_info/respect", "先生");
  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 35);

  // set("str", 30);                      // 膂力         
  // set("cps", 30);                      // 定力
  // set("cor", 30);                      // 胆识         
  set("per", 26);                         // 容貌
  // set("con", 30);                      // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("vendor_goods", ([
    "/obj/book/literate_book_a": 3,
  ]));

  setup();

  carry_object("/obj/cloth/white-pao")->wear();   // 装备
  carry_object("/obj/cloth/fang-jin")->wear();
}

void init() {
  object ob;

  ::init();
  if (this_object()->query_temp("unconcious")) return;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想买书吗？\n");
      break;
  }
}
