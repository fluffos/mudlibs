#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       50                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         5                       // 定义正气的值

void create() {
  int n;

  set_name("道士", ({ "dao shi", "waiter" }));

  set("long", @LONG
他是一个来传播道术的道士。
LONG
  );

  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 30);

  set("str", 30);                         // 膂力         
  set("cps", 30);                         // 定力
  set("cor", 30);                         // 胆识         
  set("per", 30);                         // 容貌
  set("con", 30);                         // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: command, "say 你再打，我就不客气了！" :),
    (: command, "say 金光速现，覆护真人，急急如光降律令。" :),
  }));

  set("vendor_goods", ([
    "/obj/book/taoism_book_a": 3,
    "/obj/book/taoism_book_b": 3,
  ]));

  setup();

  carry_object("/obj/cloth/taoism-pao")->wear();  // 装备
  carry_object("/obj/book/taoism_book_c");
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say("道士笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想看道家学说吗？\n");
      break;
  }
}
