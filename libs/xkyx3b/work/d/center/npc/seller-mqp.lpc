// seller-mqp.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("平阿四", ({ "seller", "waiter" }));
  set("long", "他就是木器铺老板。\n");
  set("age", 40);

  set("nick", "木器铺老板");
  set("rank_info/respect", "老板");
  set("combat_exp", 3000);

  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("parry", 30);

  set("attitude", "friendly");

  set("vendor_goods", ([
    "/obj/weapon/wood_blade": 5,
    "/obj/weapon/wood_sword": 5,
  ]));

  setup();

  add_money("silver", 50);
  carry_object("/obj/cloth/green-cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (this_object()->query_temp("unconcious")) return;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想买木器吗？\n");
      break;
  }
}
