// killer.c

#include <ansi.h>

inherit NPC;
void leave();

void create() {
  set_name("杀手", ({ "killer" }));
  set("title", "杀手帮 倚云镇二堂主");
  set("gender", "男性");
  set("age", 30);
  set("long", "一个一身黑色劲装的蒙面杀手。看了让人心寒。\n");
  set("combat_exp", 8888888);
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "杀手说道：我还以为是什么涝渣子，一定要我出来摆平；哼！原来...\n",
    "杀手说道：有人出了钱，要你人头，快纳命来！\n",
    "杀手说道：好功夫，怪不得...只可惜...；那些家伙也太草包了。\n",
    "杀手冷冷地说：我以为是谁？原来也只不过如此而已。好！就当为我们的弟兄们报仇！\n",
    (: perform_action, "dodge.quick_attack" :),
    (: exert_function, "recover" :),
  }));
  set("inquiry", ([
    "雇主": "我们杀手就算是死也不会说出雇主的名字的！你别指望了，快纳命来！/n"
  ]));
  set_skill("unarmed", 150);
  set_skill("sword", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set_skill("dugu-sword", 200);
  set_skill("ghostbat-steps", 150);
  set_skill("ninesun-force", 100);
  set_skill("force", 100);
  map_skill("sword", "dugu-sword");
  map_skill("parry", "dugu-sword");
  map_skill("dodge", "ghostbat-steps");
  map_skill("move", "ghostbat-steps");
  map_skill("force", "ninesun-force");
  set("max_gin", 1000);
  set("gin", 1000);
  set("max_kee", 1000);
  set("kee", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 100);
  set("mission_ok", 0);
  set("waiting", 0);
  setup();
  carry_object("/obj/weapon/sword")->wield();
  carry_object("/obj/cloth/cloth")->wear();
};
void killed_enemy(object victim) {
  object me;
  me = this_object();
  if (victim->query("id") == this_object()->query("target")) {
    tell_room(environment(victim), "杀手冷冷地对" + victim->query("name") +
      "的尸体说：再练十年才来跟我较量吧，咳！我该回去睡觉了...\n",
      ({ this_object() }));
    tell_room(environment(victim),
      "接着杀手头也不回施展起轻功，很快地消失在远处......\n",
      ({ this_object() }));
    me->set("mission_ok", 1);
    me->move("/obj/void.lpc");
    //destruct(this_object());
  } else {
    tell_room(environment(victim), "杀手叹了口气：咳，又一个陪葬的...\n",
      ({ this_object() }));
  };
}

int heal_up() {
  ::heal_up();
  if (this_object()->query("mission_ok") == 1) destruct(this_object());
  if (environment() && !is_fighting() && !this_object()->query_temp("unconcious")) {
    call_out("leave", 1);
    return 1;
  }
  return 1;
}

void leave() {
  object me;
  string target_id;
  object where;
  object ob;
  int wait_times;
  me = this_object();
  target_id = (string)me->query("target");
  ob = find_player(target_id);
  if (ob && !ob->is_ghost())
    where = environment(ob);
  else {
    tell_room(environment(me),
      "杀手找了一会儿，发现目标已经找不到了。接着头也不回施展起轻功，很快地消失在远处......\n",
      ({ me }));
    me->move("/d/player/bibi.lpc");
    wait_times = (int)me->query("waiting") + 1;
    if (wait_times > 3600) {
      destruct(me);
      return;
    } else {
      me->set("waiting", wait_times);
      return;
    };
  };
  if (!where) {
    tell_room(environment(me),
      "杀手找了一会儿，发现目标已经找不到了。接着头也不回施展起轻功，很快地消失在远处......\n",
      ({ me }));
    me->move("/d/player/bibi.lpc");
    wait_times = (int)me->query("waiting") + 1;
    if (wait_times > 7200)
      destruct(me);
    else {
      me->set("waiting", wait_times);
      return;
    };
  } else
    me->move(where);
}
