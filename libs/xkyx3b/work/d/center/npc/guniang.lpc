// guniang.c - 二胡姑娘
// Designed by Carlis

#include <ansi.h>

inherit NPC;

#define SET_SKILL       0                       // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         100                     // 定义正气的值

void do_some();

void create() {
  set_name(HIM "二胡姑娘" NOR, ({ "erhu guniang", "guniang" }));

  set("long", @LONG
这是一位穷苦的小姑娘，终日在客栈中拉二胡维持生计。
从来没有人问过她的姓名，后来，人们便以二胡姑娘称呼
她。
LONG
  );

  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 18);

  set("per", 30);                 // 容貌

  set("combat_exp", 0);
  set("SEN", SET_SEN);

  set("chat_msg", ({
    (: do_some :), })
  );

  setup();

  carry_object("/obj/cloth/cloth")->wear();       // 装备
}

void do_some() {
  command("smile");
  command("say 各位客倌，我拉得好听吗？");
  return;
}

int accept_object(object who, object ob) {
  command("smile");
  command("say 多谢客倌了！");
  who->add("SEN", (ob->value() / 5000));
  return 1;
}
