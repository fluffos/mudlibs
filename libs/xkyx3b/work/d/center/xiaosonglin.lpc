#include <room.h>

inherit ROOM;

void create() {
  set("short", "小松林");
  set("long", @LONG

    这里是侠客城的一片小松林。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "hongniangzhuang",
    "south": __DIR__ "daoguan",
  ]));

  set("objects", ([
    __DIR__ "npc/songshu": 2,
    __DIR__ "npc/hare": 2,
    __DIR__ "npc/bird": 2,
  ]));

  setup();

}
