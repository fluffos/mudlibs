inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG

    你走在南大街上，踩着坚实的青石板地面。南边是城门。东边是济世
堂。西边是一家布庄。
LONG);
  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "jishitang",
    "south": __DIR__ "gates",
    "west": __DIR__ "buzhuang",
    "north": __DIR__ "roads3",
  ]));

  setup();

  replace_program(ROOM);
}
