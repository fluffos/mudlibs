#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "穷苦人家");
  set("long", @LONG

    这里是侠客城里一片穷苦人家。
LONG
  );

  set("exits", ([
    "south": __DIR__ "xiaoshulin",
    "west": __DIR__ "baichaoyuan",
    "north": __DIR__ "datiepu",
  ]));

  set("objects", ([
    __DIR__ "npc/old-man": 1,
    __DIR__ "npc/old-woman": 1,
  ]));

  setup();

  replace_program(ROOM);
}
