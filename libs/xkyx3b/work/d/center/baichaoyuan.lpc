#include <room.h>

inherit ROOM;

void create() {
  set("short", "百草园");
  set("long", @LONG

    这里是侠客城百草园。园中景色优美，林木葱绿，碧水环绕，周围到
处都是各种各样的花儿草儿，还有叫不出名字的小鸟跳跃其中，啾啾有声。
你还可以在这里放牧（fangmu）。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "qiongren",
    "south": __DIR__ "muqipu",
    "north": __DIR__ "gongzuoshi",
  ]));

  set("objects", ([
    __DIR__ "npc/kid": 1,
    __DIR__ "npc/ant": 2,
    __DIR__ "npc/ququ": 2,
  ]));

  setup();
}

void init() {
  add_action("do_fangmu", "fangmu");
}

int do_fangmu(string arg) {
  object me, horse, env, *inv;
  int total, i;

  me = this_player();

  if (me->query_temp("fangmu") == 1) return notify_fail("你正在放牧！\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++)
    if (mapp(inv[i]->query("horse_prop")) && inv[i]->query("equipped")) break;
  if (i < sizeof(inv)) horse = inv[i];
  else return notify_fail("你要牧什么？\n");

  message_vision("$N开始放牧“" + horse->name() + "”....\n", me);
  me->set_temp("fangmu", 1);
  call_out("compelete_fangmu", 5, me, horse);
  return 1;
}

private void compelete_fangmu(object me, object horse) {
  object ob;
  int i, m, n;

  me->delete_temp("fangmu");


  if (present(me)) {                     // 如果玩家还在原地

    if (objectp(horse)) {
      if (horse->query("horse_prop/life") >= horse->query("horse_prop/max_life"))
        tell_object(me, "你的“" + horse->name() + "”已经精神百倍了！\n");
      else {
        horse->add("horse_prop/life", horse->query("horse_prop/max_life") / 10 + 1);
        tell_object(me, "你的“" + horse->name() + "”精神好多了！\n");
      }
      tell_object(me, "“" + horse->name() + "”的最大能力是："
        +chinese_number(horse->query("horse_prop/max_life")) + "。\n");
      tell_object(me, "“" + horse->name() + "”的当前能力是："
        +chinese_number(horse->query("horse_prop/life")) + "。\n");
    }

  }

  return;
}

int valid_leave(object me, string dir) {
  if (me->query_temp("fangmu")) return notify_fail("你还没有放牧完呢！\n");
  return ::valid_leave(me, dir);
}
