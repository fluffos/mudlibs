#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "胭脂店");
  set("long", @LONG

    这是侠客城的胭脂店。刚进门，你就闻到一股沁人心脾的清香。里面
站着一位很漂亮的姑娘，旁边放满了各种各样的胭脂。
LONG
  );

  set("exits", ([
    "south": __DIR__ "ciqipu",
    "west": __DIR__ "zhubaodian",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-yzd": 1,
    __DIR__ "npc/yitaitai": 1,
  ]));

  setup();

}
