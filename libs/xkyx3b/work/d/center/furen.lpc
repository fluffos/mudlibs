#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "富豪大院");
  set("long", @LONG

    这里是侠客城富豪大院的大门。只见一座富丽堂皇的大宅院出现在你
的眼前，两头高大的石狮子镇住大门两侧，朱漆大门足足有三寸厚。门上
挂着两个灯笼。几个家丁睁大眼睛瞪着你。他们体格粗壮，全然不似一般
的护院、武师。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "roads2",
    "west": "/d/fuhaoyuan/main-00",
  ]));

  set("objects", ([
    "/u/bibi/hai": 1,
  ]));
  setup();

}
