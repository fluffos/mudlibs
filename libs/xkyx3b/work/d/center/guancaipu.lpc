#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "棺材店");
  set("long", @LONG

    这里是侠客城的棺材店。墙上零散地挂着几串纸钱和元宝，棺材店老板面无
表情地站在柜台里面，对你的到来似乎漠不关心。听说最近城里出现了杀手帮，
店老板的生意好了许多....
LONG
  );

  set("exits", ([
    "west": __DIR__ "chaodufachang",
    "north": __DIR__ "xiaoshulin",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-gcp": 1,
  ]));

  setup();

}
