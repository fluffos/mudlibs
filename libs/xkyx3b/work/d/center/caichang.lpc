#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "菜  场");
  set("long", @LONG

    这里是侠客城的菜场。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "ciqipu",
    "south": __DIR__ "shambles",
    "west": __DIR__ "xiaohuayuan",
    "north": __DIR__ "zhubaodian",
  ]));

  set("objects", ([
    __DIR__ "npc/farmer": 2,
    __DIR__ "npc/caifan": 1,
  ]));

  setup();

}
