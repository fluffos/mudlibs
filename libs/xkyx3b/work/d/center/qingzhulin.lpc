#include <room.h>

inherit ROOM;

void create() {
  set("short", "青竹林");
  set("long", @LONG

    这里是侠客城的一片青竹林。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "chaodufachang",
    "west": __DIR__ "jishitang",
    "north": __DIR__ "zhuqipu",
  ]));

  set("objects", ([
    "/d/gaibang/npc/master-xiao": 1,
    "/d/gaibang/npc/master-lu": 1,
  ]));

  setup();

}
