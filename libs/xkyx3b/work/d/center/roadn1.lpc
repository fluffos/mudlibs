inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG

    这里是侠客城的北大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆，许多人都往南边走去，那里有一个热闹的广场。东边
是一家生意兴隆的客栈，门额上悬挂一方横匾，来自各地的人们进进出出。
西边是这里最高的权力机构－－神仙楼，据说是神仙居住的地方。
    路边挂著一块牌子(sign)。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "inn",
    "south": __DIR__ "guangchang",
    "west": "/d/wizard/guest_room",
    "north": __DIR__ "roadn2",
  ]));

  set("item_desc", ([
    "sign": @TEXT
这里可以使用的命令有：
[36m                           
fight           争位
[2;37;0m
TEXT
  ]));

  set("objects", ([
    "/obj/npc/shang-shan": 1,
  ]));

  setup();

  replace_program(ROOM);
}
