#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "木器铺");
  set("long", @LONG

    这是侠客城的木器铺。货架上摆着琳琅满目的木器。侠客城中居民所
需的木器都是来自这里。老板从二十六岁就继承父业接过了这间木器店，
凭着价廉物美的宗旨，已经苦心经营了二十多年了。
LONG
  );

  set("exits", ([
    "east": __DIR__ "xiaoshulin",
    "south": __DIR__ "chaodufachang",
    "west": __DIR__ "zhuqipu",
    "north": __DIR__ "baichaoyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/seller-mqp": 1,
  ]));

  setup();

  replace_program(ROOM);
}
