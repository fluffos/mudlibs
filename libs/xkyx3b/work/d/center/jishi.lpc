// jishi.c - 集  市
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.7

#include <ansi.h>
#include <room.h>
#include <login.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "集  市");
  set("long", @LONG

    这里是侠客城集市。满街的店铺都挂着一团团、一簇簇的羊角风灯。
一声接一声的叫卖声在各个街口、小巷深处此呼彼应，连绵不绝。集市的
入口处，挂着一块牌子(sign)。
LONG
  );

  set("outdoors", "center");

  set("item_desc", ([
    "sign": @TEXT
在这里你可以做下面的事情。
[36m
join        开展生意
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "east": __DIR__ "zahuopu",
    "south": __DIR__ "roade3",
    "north": __DIR__ "shambles",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);

  set("objects", ([
    __DIR__ "npc/xiaotou": 1,
  ]));

  setup();
}

void init() {
  add_action("do_join", "join");
}

int do_join(string arg) {
  string *name = ({ "私盐", "水果", "食品", "陈酒", "鲜花", "草药", "煤炭", "古董", "珠宝", "玉器",
    "字画", "木材", "竹器", "武器", "铁器", "农具", "马匹", "布匹", "瓷器", "杂货" });
  object me;
  string tempstr, namestr;

  me = this_player();

  if (me->query_temp("working") == 1) return notify_fail("你已经在贩卖当中了！\n");

  namestr = name[random(sizeof(name))];
  tempstr = "$N开始贩卖" + namestr + "....\n";
  message_vision(tempstr, me);

  if (namestr == "私盐") {
    tempstr = "官兵把$N捉了起来：“贩卖" + namestr + "？这可是砍头的罪名！”\n";
    message_vision(tempstr, me);
    if (random(10) == 0) {         // 打入大牢
      me->set("startroom", START_ROOM);
      me->move(__DIR__ "dalao");
      set("name", "官府");
      set("id", "guanfu");
      CHANNEL_D->do_channel(this_object(), "chat", me->name() + "贩卖"
        +namestr + "，被打入大牢，等候秋后处斩！！！");
    } else {
      if (random(20) == 0) {  // 随机流放
        switch (random(9)) {
          case 0: tempstr = "xia-e" + (random(5) + 1);
          break;
          case 1: tempstr = "xia-s" + (random(5) + 1);
          break;
          case 2: tempstr = "xia-w0" + (random(5) + 1);
          break;
          case 3: tempstr = "xia-n" + (random(5) + 1);
          break;
          case 4: tempstr = "bei-s0" + (random(5) + 1);
          break;
          case 5: tempstr = "bei-w0" + (random(5) + 1);
          break;
          case 6: tempstr = "xinan-s0" + (random(5) + 1);
          break;
          case 7: tempstr = "xibei-n0" + (random(5) + 1);
          break;
          case 8: tempstr = "xi-n0" + (random(5) + 1);
          break;
        }
        tempstr = "/d/road/" + tempstr;
        me->set("startroom", tempstr);
        me->move(tempstr);
        tempstr = "$N掏出厚厚一叠银票对官兵说：大爷行行好吧，我家还有八十岁的老娘呢....\n"
          + "官兵将银票一把抢过，放入怀中，探了探头，见到左右无人，喝道：这么少！\n"
          + "官兵一脚把$N踢了出来：“叫你贩卖" + namestr + "！下回再捉往，砍头！”\n";
        message_vision(tempstr, me);
      } else {                  // 放入广场
        me->set("startroom", START_ROOM);
        me->move(START_ROOM);
        tempstr = "官兵一脚把$N踢了出来：“叫你贩卖" + namestr + "！下回再捉往，砍头！”\n";
        message_vision(tempstr, me);
      }
    }
    return 1;
  }

  me->set_temp("working", 1);
  call_out("compelete_join", 6, me);
  return 1;
}

private void compelete_join(object me) {
  object ob;
  int i, n;

  me->delete_temp("working");

  if (present(me)) {                     // 如果玩家还在原地
    message_vision("$N开展生意，人虽然累坏了，但是收益不小。\n", me);
    me->add("gin", -30);
    me->add("sen", -30);
    me->add("potential", (me->query("combat_exp") >= 15000) ? random(2) : 1);
    me->add("combat_exp", (me->query("combat_exp") >= 15000) ? random(2) : 1);
    n = random(10 * me->query("kar")) / 30;
    for (i = 0; i < n; i++) {
      ob = new("/obj/money/silver");
      ob->move(me);
    }
    tell_object(me, "你的潜能和经验增加了！\n");
    tell_object(me, sprintf("你赚到%d两银子。", n));
  }

  return;
}
