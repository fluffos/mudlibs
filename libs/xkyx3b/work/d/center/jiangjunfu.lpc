inherit ROOM;

void create() {
  set("short", "将军府大门");
  set("long", @LONG
                                                                
    这里是侠客城将军府大门。两扇朱红色的大门前面，蹲着两头很大的
铁狮子。大门上挂有“大将军府”四个大字的匾牌，往门内望去，只见几
十名兵丁木桩似的钉在地上一动不动的，没有发出一丝的声响，不仔细看，
真会以为这些都是泥塑的雕像。
LONG
  );

  set("exits", ([
    "south": __DIR__ "roade2",
    "north": "/d/jiangjunfu/main-01",
  ]));

  set("objects", ([
    "/d/jiangjunfu/npc/guanbing": 4,
  ]));

  setup();
}
