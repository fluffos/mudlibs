inherit ROOM;

void create() {
  set("short", "官府大门");
  set("long", @LONG

    这里是侠客城官府大门。两扇朱红色的大门前面，蹲着两头很大的青
铜狮子，旁边分别插着书着“肃静”“回避”金色大字的红牌子。牌子前
面有一个大鼓，显然是供小民鸣冤用的。几名衙役在门前巡逻。
LONG
  );

  set("exits", ([
    "south": __DIR__ "roadw2",
    "north": "/d/guanfu/main-01",
  ]));
  /*
        set("objects", ([
                __DIR__"npc/yayi" : 4,
        ]));
*/
  setup();
}

int valid_leave(object me, string dir) {
  if (!wizardp(me) && objectp(present("ya yi", environment(me))) && dir == "west")
    return notify_fail("衙役喝道：“威……武……。”\n");
  return ::valid_leave(me, dir);
}
