#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "工作室");
  set("long", @LONG

    这里是泉州城的工作室。
LONG
  );

  set("city", 1);
  // set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-s2",
    "south": __DIR__ "main-w1s3",
    "west": __DIR__ "main-w2s2",
    "north": __DIR__ "main-w1s1",
  ]));

  setup();

  replace_program(ROOM);
}
