#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "承天寺");
  set("long", @LONG

    这里是泉州城的承天寺。
LONG
  );

  set("city", 1);
  // set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-e2s1",
    "south": __DIR__ "main-e1s2",
    "west": __DIR__ "main-s1",
    "north": __DIR__ "main-e1",
  ]));

  setup();

  replace_program(ROOM);
}
