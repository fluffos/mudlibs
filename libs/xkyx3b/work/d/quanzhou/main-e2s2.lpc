#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "丝绸店");
  set("long", @LONG

    这里是泉州城的丝绸店。
LONG
  );

  set("city", 1);
  // set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-e3s2",
    "south": __DIR__ "main-e2s3",
    "west": __DIR__ "main-e1s2",
    "north": __DIR__ "main-e2s1",
  ]));

  setup();

  replace_program(ROOM);
}
