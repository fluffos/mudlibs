#include <ansi.h>

inherit NPC;

void create() {
  set_name("流氓头", ({ "liumang tou", "liumang" }));

  set("long", @LONG
他一脸横肉，一副凶神恶煞的样子。
LONG
  );

  set("attitude", "heroism");
  set("gender", "男性");
  set("age", 25);

  set("combat_exp", 3000);
  set("SEN", -10);

  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  setup();

  carry_object("/obj/misc/cloth")->wear();

  add_money("silver", 10);
  add_money("gold", 2);
}
