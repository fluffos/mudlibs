// main-ge.c - 泉州城－东城门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "东城门");
  set("long", @LONG

    这里是泉州城的东城门。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "west": __DIR__ "main-e3",
  ]));
  set("objects", ([
    "/obj/npc/wokou": 4,
  ]));

  setup();

  replace_program(ROOM);
}
