#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "刺桐北街");
  set("long", @LONG
    你走在一条泉州城的刺桐北街上，东面是泉州新开张的美容院，里面传来一阵
阵的欢笑声，北面是泉州城的北城门。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-e1n3",
    "south": __DIR__ "main-n1",
    "west": __DIR__ "main-w1n3",
    "north": __DIR__ "main-gn",
  ]));

  setup();

  replace_program(ROOM);
}
