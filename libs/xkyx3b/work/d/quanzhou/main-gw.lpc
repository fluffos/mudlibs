// main-gw.c - 泉州城－西城门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西城门");
  set("long", @LONG

    这里是泉州城的西城门。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-w3",
    "west": "/d/road/quan-nw1",
  ]));

  setup();

  replace_program(ROOM);
}
