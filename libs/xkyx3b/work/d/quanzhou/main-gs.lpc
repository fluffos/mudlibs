// main-gs.c - 泉州城－南城门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "南城门");
  set("long", @LONG

    这里是泉州城的南城门。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "north": __DIR__ "main-s3",
    "south": __DIR__ "zhu",
  ]));


  setup();

  replace_program(ROOM);
}
