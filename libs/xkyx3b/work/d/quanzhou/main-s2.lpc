// main-s2.c - 泉州城－刺桐南街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "刺桐南街");
  set("long", @LONG

    这里是泉州城的刺桐南街。
LONG
  );

  set("city", 1);
  set("outdoors", "quanzhou");

  set("exits", ([
    "east": __DIR__ "main-e1s2",
    "south": __DIR__ "main-s3",
    "west": __DIR__ "main-w1s2",
    "north": __DIR__ "main-s1",
  ]));

  setup();

  replace_program(ROOM);
}
