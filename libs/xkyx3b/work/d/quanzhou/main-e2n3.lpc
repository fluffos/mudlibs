#include <ansi.h>
inherit ROOM;

int do_test1(string arg);
int valid_leave(object me, string dir);
int do_none(string arg);


void create() {
  set("short", "美容院大厅");
  set("long", @LONG

    这是美容院的大厅，一股幽香扑面而来。各种美容药品琳琅满目，[35m凡士
润肤露[2;30;0m，[37m花王洗面奶[2;30;0m，[34m高露洁牙膏[2;30;0m，[33m诗芬定发雾[2;30;0m......，应有尽有，只要你
拥有其中一件，你一定可以容貌加倍。老板娘周梦蝶正坐在收钱台，慢慢品
尝着她刚刚煮好的鱼翅汤。西侧有几间房，看来是给顾客美容的地方。
LONG
  );

  set("city", 1);
  // set("outdoors", "quanzhou");
  set("objects", ([
    //		"/d/npc/sungoku" : 1,
    "/u/bibi/xiaoruer": 1 ]));


  set("exits", ([
    // "east"  : __DIR__"main-e3n3",
    // "south" : __DIR__"main-e2n2",
    "west": __DIR__ "main-e1n3",
    // "north" : __DIR__"main-e2n4",
  ]));

  setup();

}


void init() {
  add_action("do_none", "learn");
  add_action("do_none", "study");
  add_action("do_none", "exercise");
  add_action("do_none", "practice");
  add_action("do_none", "sleep");
  add_action("do_none", "fight");
  add_action("do_none", "steal");
  add_action("do_none", "kill");
  add_action("do_none", "ride");
  add_action("do_none", "unride");
  add_action("do_none", "wear");
  add_action("do_none", "remove");
  add_action("do_none", "unwield");
  add_action("do_none", "wield");
  add_action("do_none", "cast");
  add_action("do_none", "quit");
  add_action("do_none", "drink");
  add_action("do_none", "eat");
  add_action("do_none", "suicide");
  add_action("do_none", "drop");
  add_action("do_none", "get");
  add_action("do_none", "put");
}

int do_none(string arg) {
  object me;
  me = this_player();
  if (me->query_temp("meirong")) {
    message_vision("周梦蝶把$N按回美容床，轻轻的在$N耳边说：不要乱动，"
      + "否则回破相的。\n", me);
    return 1;
  } else
    return 0;
}

int valid_leave(object me, string dir) {
  if (me->query_temp("meirong")) {
    message_vision("周梦蝶把$N按回美容床，轻轻的在$N耳边说：不要乱动，"
      + "否则回破相的。\n", me);
    return notify_fail(" ");
  }

  return ::valid_leave(me, dir);
}
