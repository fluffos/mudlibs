#include <ansi.h>
#include <localtime.h>
inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;

string diagnose();
void heal_who(object who);

void create() {
  set_name("胡半仙", ({ "hu banxian", "hu", "banxian" }));
  set("long", @LONG
他是一位仙风道骨的年轻人。没有人能想得到他居然会是神仙楼的总管。
他上至天文，下至地理，无所不知。武林中的事可没几件能够瞒得过他。
LONG
  );
  // create_family("神仙山庄", 2, "弟子");

  set("title", "神仙楼总管");
  set("nickname", "赛诸葛");

  set("rank_info/respect", "总管");
  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 21);

  set("str", 50);         // 膂力
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识
  set("per", 30);         // 容貌
  set("int", 50);         // 悟性
  set("con", 50);         // 根骨
  set("spi", 30);         // 灵性
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 200);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 5000000);
  // set("SEN",10000000);

  set_skill("force", 200); set_skill("bahuang-force", 200);
  set_skill("sword", 200); set_skill("ruyixiaoyao-sword", 200);
  set_skill("unarmed", 200); set_skill("tianxian-zhang", 200);
  set_skill("parry", 200);
  set_skill("move", 200); set_skill("feixian-steps", 200);
  set_skill("dodge", 200);
  set_skill("literate", 250);
  set_skill("magic", 200); set_skill("essencemagic", 200);
  set_skill("buddhism", 250);

  map_skill("force", "bahuang-force");
  map_skill("sword", "ruyixiaoyao-sword");
  map_skill("unarmed", "tianxian-zhang");
  map_skill("parry", "ruyixiaoyao-sword");
  map_skill("move", "feixian-steps");
  map_skill("dodge", "feixian-steps");
  map_skill("magic", "essencemagic");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting() && random(3) == 1) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_ask", "ask");
  // add_action("do_where", "where");
}

void get_gift(object ob) {
  object o;
  int i, a, n;

  command("say 小小礼物，就请收下吧。");

  a = ob->query("age");
  n = (ob->query("gender") == "女性") ? 16 : 18;
  if (n < a) {
    for (i = n; i < a; i++) {
      o = new("/obj/money/thousand-cash");
      o->move(ob);
    }
    tell_object(ob, this_object()->name() + "给你" + chinese_number(a - n)
      +o->query("unit") + o->name() + "。\n");
  }

  n = ob->query("combat_exp") / 1000 + random(1000);
  ob->add("potential", n);
  tell_object(ob, "你的潜能上升了" + chinese_number(n) + "点。\n");

  n = ob->query("combat_exp") / 100 + random(1000);
  ob->add("potential", n);
  tell_object(ob, "你的经验上升了" + chinese_number(n) + "点。\n");

  if (random(3) == 0 && ob->query("kar") < 30) {
    ob->add("kar", 1);
    tell_object(ob, "你的福缘上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("per") < 30) {
    ob->add("per", 1);
    tell_object(ob, "你的相貌上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("spi") < 30) {
    ob->add("spi", 1);
    tell_object(ob, "你的灵性上升了一点。");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("cps") < 30) {
    ob->add("cps", 1);
    tell_object(ob, "你的定力上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("cor") < 30) {
    ob->add("cor", 1);
    tell_object(ob, "你的胆识上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("int") < 30) {
    ob->add("int", 1);
    tell_object(ob, "你的悟性上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("str") < 30) {
    ob->add("str", 1);
    tell_object(ob, "你的膂力上升了一点。\n");
    if (random(7) != 0) return;
  }
  if (random(3) == 0 && ob->query("con") < 30) {
    ob->add("con", 1);
    tell_object(ob, "你的根骨上升了一点。\n");
    if (random(7) != 0) return;
  }
  return;
}

void greeting(object ob) {
  mixed *t;
  if (!ob || environment(ob) != environment()) return;

  // 以下加入节日的礼物
  t = localtime(time());
  if (t[LT_MON] == 0 && t[LT_MDAY] == 1) {       // 一月一日
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，元旦到啦，节目快乐！");
    if (ob->query("gift/date") != "元旦") {
      ob->set("gift/date", "元旦");
      get_gift(ob);
    }
    return;
  }
  if (t[LT_MON] == 4 && t[LT_MDAY] == 1) {       // 五月一日
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，劳动节到啦，节目快乐！");
    if (ob->query("gift/date") != "劳动节") {
      ob->set("gift/date", "劳动节");
      get_gift(ob);
    }
    return;
  }
  if (t[LT_MON] == 9 && t[LT_MDAY] == 1) {       // 十月一日
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，国庆节到啦，节目快乐！");
    if (ob->query("gift/date") != "国庆节") {
      ob->set("gift/date", "国庆节");
      get_gift(ob);
    }
    return;
  }
  if (t[LT_MON] == 2 && t[LT_MDAY] == 8
    && ob->query("gender") == "女性" && stringp(ob->query("marry"))) {
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，妇女节到啦，节目快乐！");
    if (ob->query("gift/date") != "妇女节") {
      ob->set("gift/date", "妇女节");
      get_gift(ob);
    }
    return;
  }
  if (t[LT_MON] == 5 && t[LT_MDAY] == 1           // 六月一日
  && ob->query("age") <= 16) {
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，儿童节到啦，节目快乐！");
    if (ob->query("gift/date") != "儿童节") {
      ob->set("gift/date", "儿童节");
      get_gift(ob);
    }
    return;
  }
  if (t[LT_MON] == 7 && t[LT_MDAY] == 9) {       // 八月九日
    command("smile " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，侠客英雄传诞生日到啦，节目快乐！");
    if (ob->query("gift/date") != "诞生日") {
      ob->set("gift/date", "诞生日");
      get_gift(ob);
    }
    return;
  }

  command("smile " + ob->query("id"));
  command("say 这位" + RANK_D->query_respect(ob) + "，想算一卦吗？\n");
}

int do_ask(string arg) {
  object ob, me = this_player();
  string tempstr, name;
  int str, cor, ntg, spi, dex, per, con, kar;

  if (!arg || sscanf(arg, "%s about %s", tempstr, name) != 2) return 0;

  if (name == "成年" && !(int)me->query("gift/grown") && me->query("age") >= 18) {
    command("smile " + me->query("id"));
    command("say 这位" + RANK_D->query_respect(me) + "，恭喜成年！");
    me->set("gift/grown", 1);
    get_gift(me);
    return 1;
  }
  if (name == "新婚" && !(int)me->query("gift/marry") && stringp(me->query("marry"))) {
    command("smile " + me->query("id"));
    command("say 这位" + RANK_D->query_respect(me) + "，新婚快乐！");
    me->set("gift/marry", 1);
    get_gift(me);
    return 1;
  }
  if (name == "大寿" && !(int)me->query("gift/birthday") && me->query("age") == 30) {
    command("smile " + me->query("id"));
    command("say 这位" + RANK_D->query_respect(me) + "，三十大寿快乐！");
    me->set("gift/birthday", 1);
    get_gift(me);
    return 1;
  }

  if (!objectp(ob = find_player(name))) return 0;

  if (!me->query_temp("give_me_money")) {
    command("say 五两银子一卦，先交钱吧。");
    return 1;
  }
  me->delete_temp("give_me_money");

  str = ob->query("str");
  cor = ob->query("cor");
  ntg = ob->query("int");
  spi = ob->query("spi");
  dex = ob->query("cps");
  per = ob->query("per");
  con = ob->query("con");
  kar = ob->query("kar");

  switch (random(6)) {
    case 0:
      if (str + cor + ntg + spi + dex + per + con + kar
        > (ob->query("age") + 6) * 8) {
        command("nod");
        command("say 不错，" + ob->name() + "还算修练有方。");
      } else {
        command("sigh");
        command("say " + ob->name() + "还要在基本功上多下点功夫！");
      }
      break;
    case 1:
      if (ntg > 35 || ntg > 15 + ob->query("age")) {
        command("nod");
        command("say " + ob->name() + "天资过人，若能多加努力，必定能出人头地。");
      } else {
        command("shake");
        command("say " + ob->name() + "如果知道＂笨鸟先飞＂的道理，还是有机会的。");
      }
      break;
    case 2:
      if (spi > 25) {
        command("nod");
        command("say " + ob->name() + "如果有意钻研武学，倒也不难成为一代宗师。");
      } else {
        command("shake");
        command("say " + ob->name() + "应该专精几门武功，不可以贪多。");
      }
      break;
    case 3:
      if (per > 26) {
        command("smile");
        command("say " + ob->name() + "相貌非凡，一定有不少人追求。");
      } else {
        command("hmm");
        if (ob->query("marry"))
          command("say " + ob->name() + "看来好不容易才找到一位情侣。");
        else
          command("say " + ob->name() + "在婚姻生活上看来是要多历磨难了。");
      }
      break;
    case 4:
      if (kar > 22) {
        command("smile");
        command("say " + ob->name() + "福缘深厚，吉人自有天相。");
      } else {
        command("sigh");
        command("say " + ob->name() + "这一生看来是注定要多历磨难了。");
      }
      break;
    case 5:
      if (ob->query("combat_exp") > (ob->query("age") - 14) * 10000) {
        command("smile");
        command("say " + ob->name() + "闯荡江湖这么多年，看来还是学到不少东西。");
      } else {
        command("shake");
        command("say " + ob->name() + "闯荡江湖多年，竟然虚渡了许多光阴。");
      }
      break;
  }

  return 1;
}

int accept_object(object who, object ob) {
  if (!ob->query("money_id") || ob->value() < 500)
    return 0;

  who->set_temp("give_me_money", 1);

  return 1;
}

int do_where(string arg) {
  object ob, me, where;
  if (!arg || arg == "") {
    command("say 你想找谁？");
    return 1;
  }
  me = this_player();
  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) {
    command("tell " + me->query("id") + " 现在没这个。.");
    return 1;
  }
  where = environment(ob);
  if (!where) {
    command("tell " + me->query("id") + " 这个人不知道在那里耶....");
    return 1;
  }
  command("tell " + me->query("id") +
    sprintf(" %s(%s)现在在%s。\n", (string)ob->name(), (string)ob->query("id"),
      (string)where->query("short")));
  return 1;
}
