// jial.c (监狱)

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create() {
  set("short", "监 狱");
  set("long", @LONG
[37m
哈哈哈．．．．在这里好好过你的铁窗生活吧．．．．
出去之后可被再胡来哦，否则又会被丢回来的哦．．．．
[0m
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "guest_room",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("no_steal", 1);

  setup();
}
void init() {
  if (!wizardp(this_player())) {
    "/cmds/std/look"->look_room(this_player(), this_object());
    this_player()->set("startroom", __FILE__);
    add_action("do_nothing", "");
    add_action("do_quit", "quit");
  }
}

int do_nothing() {
  write("被监禁的生活好过吗？知道为什么被监禁了吗？sigh．．．．！\n");
  return 1;
}

int do_quit() {
  "/cmds/usr/quit"->main(this_player(), "");
  return 1;
}
