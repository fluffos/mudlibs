inherit WIZ_ROOM;

void create() {
  set("short", "决策大厅");
  set("long", @LONG

    这里是神仙楼的决策大厅。
LONG
  );

  set("restrict_fly_room", 1);

  set("exits", ([
    "down": __DIR__ "wizard_room",
    "east": __DIR__ "victor_room",
    "west": __DIR__ "micro_room",
  ]));

  setup();

  // To "load" the board, don't ever "clone" a bulletin board.
  call_other("/obj/board/towiz_b", "???");
}
