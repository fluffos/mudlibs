#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("鲁有脚", ({ "lu youjiao", "lu", "youjiao", "master" }));

  set("long", @LONG
鲁有脚虽然武功算不得顶尖高手，可是在江湖上却颇有声望。
因为他在丐帮中有仁有义，行事光明磊落，深得洪七公的器重。
LONG
  );

  create_family("丐帮", 18, "长老");
  set("title", "丐帮九袋长老");
  set("nickname", "掌棒龙头");
  set("gender", "男性");
  set("age", 45);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 20);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 4000000);
  set("SEN", 400);

  set_skill("force", 90); set_skill("lotus-force", 90);
  set_skill("stick", 150); set_skill("dagou-stick", 150);
  set_skill("unarmed", 150); set_skill("xianglong-zhang", 150);
  set_skill("parry", 150);
  set_skill("move", 150); set_skill("xiaoyao-steps", 150);
  set_skill("dodge", 150);

  map_skill("force", "lotus-force");
  map_skill("stick", "dagou-stick");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("parry", "dagou-stick");
  map_skill("move", "xiaoyao-steps");
  map_skill("dodge", "xiaoyao-steps");

  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object(__DIR__ "obj/beggar-cloth")->wear();
  carry_object(__DIR__ "obj/beggar-chicken");
}


void attempt_apprentice(object ob) {
  if (((int)ob->query_skill("dagou-stick", 1) < 90)) {
    command("say 打狗棍法是本门武功的基础，依我看" +
      RANK_D->query_respect(ob) + "的打狗棍法似乎还不够？");
    return;
  }

  if (((int)ob->query_skill("xianglong-zhang", 1) < 90)) {
    command("say 降龙十八掌是本门武功的基础，依我看" +
      RANK_D->query_respect(ob) + "的降龙十八掌似乎还不够？");
    return;
  }

  if ((int)ob->query("int") >= 25) {
    command("say 我们丐帮的武艺一向以刚猛为主，" +
      RANK_D->query_respect(ob) + "聪慧过人，似乎不宜学丐帮的功夫？");
    return;
  }
  command("say 好吧，希望" + RANK_D->query_respect(ob) +
    "能好好学习本门武功，将来在江湖中闯出一番作为。");

  command("recruit " + ob->query("id"));

  if ((string)ob->query("class") != "beggar")
    ob->set("class", "beggar");
}

void init() {
  add_action("give_quest", "quest");
}
