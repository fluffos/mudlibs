#include <room.h>

inherit ROOM;

void create() {
  set("short", "大树");
  set("long", @LONG

    这是一棵林树。树上有一个很大的树洞。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "down": __DIR__ "bamboo_hurst_3",
  ]));

  set("objects", ([
    __DIR__ "npc/traitor": 1,
  ]));

  setup();
  replace_program(ROOM);
}
