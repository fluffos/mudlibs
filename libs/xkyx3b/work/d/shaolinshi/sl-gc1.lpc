#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
                                                                
    这里是少林寺的广场。
LONG
  );

  set("outdoors", "songshan");

  set("exits", ([
    "west": __DIR__ "sl-gc1-sl1",
    "east": __DIR__ "sl-gc1-sl2",
    "north": __DIR__ "sl-sm",
    // "south" : "/d/songshan/main-15",
    "southdown": "/d/songshan/main-01",
  ]));

  setup();

  replace_program(ROOM);

}
