#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是少林寺的广场。
LONG
  );

  set("outdoors", "songshan");

  set("exits", ([
    "south": __DIR__ "sl-fatang",
    "north": __DIR__ "sl-fzs",
    "west": __DIR__ "sl-gc4-kt1",
    "east": __DIR__ "sl-gc4-kt2",
  ]));

  setup();


}
