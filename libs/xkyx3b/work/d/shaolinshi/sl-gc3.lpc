#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是少林寺的广场。
LONG
  );

  set("outdoors", "songshan");

  set("exits", ([
    "south": __DIR__ "sl-tmd",
    "north": __DIR__ "sl-dxbd",
    "west": __DIR__ "sl-gc3-xy1",
    "east": __DIR__ "sl-gc3-xy2",
  ]));

  setup();


}
