#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是少林寺的广场。
LONG
  );

  set("outdoors", "songshan");

  set("exits", ([
    "south": __DIR__ "sl-sm",
    "north": __DIR__ "sl-tmd",
    "west": __DIR__ "sl-cpt",
    "east": __DIR__ "sl-bl",
  ]));

  setup();

  replace_program(ROOM);

}
