// main-s2.c - 北京城－永定街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "永定街");
  set("long", @LONG

    这里是北京城的永定街。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e1s2",
    "south": __DIR__ "main-s3",
    "west": __DIR__ "main-w1s2",
    "north": __DIR__ "main-s1",
  ]));

  setup();

  replace_program(ROOM);
}
