// main-w2s2.c - 北京城－菜市口

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "菜市口");
  set("long", @LONG

    这里是北京城的菜市口。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w1s2",
    "south": __DIR__ "main-w2s3",
    "west": __DIR__ "main-w3s2",
    "north": __DIR__ "main-w2s1",
  ]));

  setup();

  replace_program(ROOM);
}
