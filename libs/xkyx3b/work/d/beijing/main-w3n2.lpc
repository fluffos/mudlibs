inherit ROOM;

void create() {
  set("short", "康亲王府");
  set("long", @LONG

    这里是北京城的康亲王府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w2n2",
    "south": __DIR__ "main-w3n1",
    "west": __DIR__ "main-w4n2",
    "north": __DIR__ "main-w3n3",
  ]));

  setup();

}
