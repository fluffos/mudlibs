// main-gs.c - 北京城－永定门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "永定门");
  set("long", @LONG

    这里是北京城的永定门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "north": __DIR__ "main-s4",
    "south": "/d/road/bei-s01",
  ]));

  setup();

  replace_program(ROOM);
}
