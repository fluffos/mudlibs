// road1.c
//后山小路

#include <room.h>

inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG
王府后院的一条小路。弯弯曲曲的一直通向一片小树林。
LONG
  );
  set("exits", ([
    "south": __DIR__ "door2",
    "north": __DIR__ "road2"
  ]));

  set("outdoors", "beijing");
  set("item_desc", ([
    "door": (: look_door, "south" :),
  ]));
  /*	set("objects", ([
              "/d/npc/sungoku" : 1,
		"/d/snow/npc/waiter" : 1 ]) );
*/
  create_door("south", "红漆大门", "north", DOOR_CLOSED);


  setup();
}
