// main-w1n1.c - 北京城－中南海

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "中南海");
  set("long", @LONG

    这里是北京城的中南海。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-n1",
    "south": __DIR__ "main-w1",
    "west": __DIR__ "main-w2n1",
    "north": __DIR__ "main-w1n2",
  ]));

  setup();

  replace_program(ROOM);
}
