#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "吏部府");
  set("long", @LONG

    这里是北京城的吏部府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w1n1",
    "south": __DIR__ "main-w2",
    "west": __DIR__ "main-w3n1",
    "north": __DIR__ "main-w2n2",
  ]));

  setup();

}
