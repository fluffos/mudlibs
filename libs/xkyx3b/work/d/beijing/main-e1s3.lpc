// main-e1s3.c - 北京城－天  坛

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "天  坛");
  set("long", @LONG

    这里是北京城的天  坛。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e2s3",
    "south": __DIR__ "main-e1s4",
    "west": __DIR__ "main-s3",
    "north": __DIR__ "main-e1s2",
  ]));

  setup();

  replace_program(ROOM);
}
