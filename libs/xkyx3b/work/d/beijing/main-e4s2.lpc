// main-e4s2.c - 北京城－广渠门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广渠门");
  set("long", @LONG

    这里是北京城的广渠门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    // "east"  : __DIR__"main-e5s2",
    "south": __DIR__ "main-e4s3",
    "west": __DIR__ "main-e3s2",
    "north": __DIR__ "main-e4s1",
  ]));

  setup();

}
