// main-e2s1.c - 北京城－崇文门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "崇文门");
  set("long", @LONG

    这里是北京城的崇文门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e3s1",
    "south": __DIR__ "main-e2s2",
    "west": __DIR__ "main-e1s1",
    "north": __DIR__ "main-e2",
  ]));

  setup();

  replace_program(ROOM);
}
