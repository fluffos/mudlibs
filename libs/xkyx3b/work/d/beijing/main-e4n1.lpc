// main-e4n1.c - 北京城－东校场

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "东校场");
  set("long", @LONG

    这里是北京城的东校场。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    // "east"  : __DIR__"main-e5n1",
    "south": __DIR__ "main-e4",
    "west": __DIR__ "main-e3n1",
    "north": __DIR__ "main-e4n2",
  ]));

  setup();

  replace_program(ROOM);
}
