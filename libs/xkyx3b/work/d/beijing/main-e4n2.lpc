// main-e4n2.c - 北京城－朝阳门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "朝阳门");
  set("long", @LONG

    这里是北京城的朝阳门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    // "east"  : __DIR__"main-e5n2",
    "south": __DIR__ "main-e4n1",
    "west": __DIR__ "main-e3n2",
    "north": __DIR__ "main-e4n3",
  ]));

  setup();

}
