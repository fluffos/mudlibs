//后花园北门。

#include <room.h>

inherit ROOM;

void create() {
  set("short", "汝阳王府花园");
  set("long", @LONG
你现在正站在汝阳王府的的后花园里
    花园里白花盛开,煞是好看,令你精神为之一振.
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang1",
    "north": __DIR__ "road1"
  ]));

  set("outdoors", "beijing");
  set("item_desc", ([
    "door": (: look_door, "north" :),
  ]));
  /*	set("objects", ([
              "/d/npc/sungoku" : 1,
		"/d/snow/npc/waiter" : 1 ]) );
*/
  create_door("north", "红漆大门", "south", DOOR_CLOSED);


  setup();
}
