// shulin.c


#include <room.h>

inherit ROOM;

void create() {
  set("short", "小树林");
  set("long", @LONG
各种野生的动物在这里自由自在的生活。
LONG
  );
  set("exits", ([
    "south": __DIR__ "road2",
  ]));

  set("outdoors", "beijing");
  set("objects", ([
    __DIR__ "npc/hare": 2,
    __DIR__ "npc/bird": 1,
    __DIR__ "npc/songshu": 1,
    //             __DIR__"npc/fox"     :1,
  ]));


  setup();
}


void init() {
  object ob;

  //        ::init();

  if (interactive(ob = this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object ob1, ob2;
  if (ob->query_temp("ask_wang") &&
    !ob2 = present("zhao min", this_object()))
    ob1 = new(__DIR__ "npc/zhaomin.lpc");
  ob1->move(environment(ob));
  ob1 = new(__DIR__ "npc/jiading.lpc");
  ob1->move(environment(ob));
  ob1 = new(__DIR__ "npc/jiading.lpc");
  ob1->move(environment(ob));

}
