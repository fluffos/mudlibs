// main-n2.c - 北京城－景  山

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "景  山");
  set("long", @LONG

    这里是北京城的景  山。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e1n2",
    "south": __DIR__ "main-n1",
    "west": __DIR__ "main-w1n2",
    "north": __DIR__ "main-n3",
  ]));

  setup();

  replace_program(ROOM);
}
