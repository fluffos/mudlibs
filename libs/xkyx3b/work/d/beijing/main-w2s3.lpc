// main-w2s3.c - 北京城－肉市场

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "肉市场");
  set("long", @LONG

    这里是北京城的肉市场。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w1s3",
    "south": __DIR__ "main-w2s4",
    "west": __DIR__ "main-w3s3",
    "north": __DIR__ "main-w2s2",
  ]));

  setup();

  replace_program(ROOM);
}
