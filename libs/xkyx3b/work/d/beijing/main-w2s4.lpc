// main-w2s4.c - 北京城－陶然亭

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "陶然亭");
  set("long", @LONG

    这里是北京城的陶然亭。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w1s4",
    // "south" : __DIR__"main-w2s5",
    "west": __DIR__ "main-w3s4",
    "north": __DIR__ "main-w2s3",
  ]));

  setup();

  replace_program(ROOM);
}
