// main-e3s3.c - 北京城－茶  馆

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "茶  馆");
  set("long", @LONG

    这里是北京城的茶  馆。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e4s3",
    "south": __DIR__ "main-e3s4",
    "west": __DIR__ "main-e2s3",
    "north": __DIR__ "main-e3s2",
  ]));

  setup();

  replace_program(ROOM);
}
