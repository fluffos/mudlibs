// main-w1s1.c - 北京城－兵部府

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "兵部府");
  set("long", @LONG

    这里是北京城的兵部府。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-s1",
    "south": __DIR__ "main-w1s2",
    "west": __DIR__ "main-w2s1",
    "north": __DIR__ "main-w1",
  ]));

  setup();

  replace_program(ROOM);
}
