#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "客  栈");
  set("long", @LONG

    这里是北京城的客  栈。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e2s2",
    "south": __DIR__ "main-e1s3",
    "west": __DIR__ "main-s2",
    "north": __DIR__ "main-e1s1",
  ]));

  setup();

  replace_program(ROOM);
}
