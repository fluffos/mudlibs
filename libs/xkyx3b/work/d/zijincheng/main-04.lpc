#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG

    这里是紫禁城的广  场。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-04-e1",
    "south": __DIR__ "main-03",
    "west": __DIR__ "main-04-w1",
    "north": __DIR__ "main-05",
  ]));

  setup();

  replace_program(ROOM);
}
