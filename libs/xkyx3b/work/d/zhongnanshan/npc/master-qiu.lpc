#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("丘处机", ({ "qiu chuji", "qiu", "master" }));

  set("long", @LONG
他是全真七子中的“长春子”。他长髯如漆，神采飞扬，双目神光四射，
可见内功深湛无比。
LONG
  );

  create_family("全真教", 2, "弟子");
  set("rank_info/respect", "道长");
  set("gender", "男性");
  set("age", 40);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 5000000);
  set("SEN", 200);

  set_skill("force", 150); set_skill("dazhoutian-force", 150);
  set_skill("sword", 220); set_skill("qixing-sword", 220);
  set_skill("unarmed", 180); set_skill("qixing-zhang", 180);
  set_skill("parry", 180);
  set_skill("move", 150); set_skill("jinyan-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 100);

  map_skill("force", "dazhoutian-force");
  map_skill("sword", "qixing-sword");
  map_skill("unarmed", "qixing-zhang");
  map_skill("parry", "qixing-sword");
  map_skill("move", "jinyan-steps");
  map_skill("dodge", "jinyan-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wear();
}

void attempt_apprentice(object ob) {

  if (((string)ob->query("gender") != "男性")) {
    command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，我不收女弟子的。");
    return;
  }
  /*
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}

void init() {
  add_action("give_quest", "quest");
}
