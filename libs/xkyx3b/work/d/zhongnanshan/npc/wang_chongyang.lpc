#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("王重阳", ({ "wang chongyang", "wang", "master" }));
  set("nickname", "中神通");

  create_family("全真教", 1, "掌门");
  set("rank_info/respect", "掌门");
  set("class", "swordman");

  set("gender", "男性");
  set("age", 49);

  set("long", @LONG
他是全真教的开山祖师。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 3000); set("force", 5000); set("force_factor", 200);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", 600);

  set_skill("force", 150); set_skill("dazhoutian-force", 150);
  set_skill("sword", 220); set_skill("qixing-sword", 220);
  set_skill("unarmed", 180); set_skill("qixing-zhang", 180);
  set_skill("parry", 180);
  set_skill("move", 150); set_skill("jinyan-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 150);

  map_skill("force", "dazhoutian-force");
  map_skill("sword", "qixing-sword");
  map_skill("unarmed", "qixing-zhang");
  map_skill("parry", "qixing-sword");
  map_skill("move", "jinyan-steps");
  map_skill("dodge", "jinyan-steps");
  /*
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob) {
  return;
}

void init() {
  add_action("give_quest", "quest");
}
