#include <ansi.h>
#include <room.h>

inherit ROOM;

void setup() {
  ::setup();
}

void create() {
  set("fight_room", 1);
  setup();
}


/* ---------------------------------------------------------

        set("item_desc", ([
                "sign" : @TEXT
这里是比武场大擂台，目前我们提供的服务有：
$MAG$
save_all        救人
$NOR$
TEXT,
        ]) );


void init()
{
        add_action("do_save_all", "save_all");
}

int do_save_all( string arg ) {
        object me, env, *inv;
        int i;

        me = this_player();        
        message_vision(HIW "$N口中喃喃地念起咒语....$N说道：“神啊，赐给我力量吧！”\n" NOR, me);
        message_vision(HIY "只见天上雷光闪动，大地被一片金光笼罩着....\n" NOR, me);

        env = environment( me );
        inv = all_inventory(env);
        for(i = 0; i < sizeof(inv); i ++) { 
                if( inv[i] != me && inv[i]->is_character()
                && inv[i]->query_temp("unconcious") ) inv[i]->revive();
        }
        
        return 1;
}

--------------------------------------------------------- */
