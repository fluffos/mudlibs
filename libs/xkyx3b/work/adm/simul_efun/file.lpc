// file.c

// 列示文本文件
void cat(string file) {
  string content;
  content = read_file(file);
  if (stringp(content)) write(content);
}

// 记录日记文件
void log_file(string file, string text) {
  catch(write_file(LOG_DIR + file, text));
}

void assure_file(string file) {
  FILE_D->assure_file(file);
}

string base_name(object ob) {
  return FILE_D->base_name(ob);
}

// Micro: 99-02-08 这个函数要小心使用！它可删除指定目录下的所有东西。
//        连同指定目录本身。函数入口一定要是一个目录名。
int rmhirdir(string dirstr) {
  string *dir;
  int i;

  if (dirstr[<1] != '/') dirstr += "/";
  dir = get_dir(dirstr);

  for (i = 0; i < sizeof(dir); i++) {
    // 目录的情况
    if (file_size(dirstr + dir[i]) == -2) {
      rmhirdir(dirstr + dir[i]);
      rmdir(dirstr + dir[i]);
    }
    // 文件的情况
    else rm(dirstr + dir[i]);
  }
  rmdir(dirstr[0..<2]);

  return 1;
}

// tail() was an efun of the MudOS this archive ran on and is not one here: the last 10 lines of a file, as `cmds/*/tail.lpc` expects.
void tail(string file) {
  string content, *lines;
  int start;

  content = read_file(file);
  if (!stringp(content))
    return;
  lines = explode(content, "\n");
  start = sizeof(lines) - 10;
  if (start < 0)
    start = 0;
  write(implode(lines[start..], "\n") + "\n");
}
