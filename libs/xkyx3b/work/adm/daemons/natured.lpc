  //                                tell_room( environment(ob[i]), MUD_NAME + "突然出现在你面前。\n" 
  //                                        + MUD_NAME + "说道：“" + ob[i]->query("name") + "！每天只能玩六个小时，你走吧！”\n" );
  //                                ob[i]->save();
  //                                ob[i]->unconcious();
  //                        }
  //                }
  //                else {
  //                        ob[i]->set("day_on", datestr);
  //                        ob[i]->set("day_time", (int)ob[i]->query("mud_age") );
  //                }
  //        }

  //        // 每天中午及午夜时自动存盘        
  //        if( day_phase[current_day_phase]["event_fun"] == "event_noon" 
  //        ||      day_phase[current_day_phase]["event_fun"] == "event_midnight" ) 
