inherit F_DBASE;

#include <ansi.h>
#include <login.h>
#include <localtime.h>
#include <net/daemons.h>

#define TIME_TICK (time()*60)

// 天气自动机（这里采取缓慢变化之自动机，假设没有突变状态）：

// 变化：晴（无云）<->晴（有云）<->阴（多云）<->雨（小雨）<->雨（大雨）
//       雾（晚秋及冬天之早晨）->晴
//       霜（冬天之晚上）
//       雪（冬天）
//       晚霞（傍晚）->晴
//
// 规则：晴阴可有０至６级风，小雨可有０至９级风，大雨可有０至１２级风
//       雨均可有云雷电，只是大雨会强烈许多


#define SUNSHINE        0       // 晴
#define CLOUDY_SKY      1       // 阴
#define SPRINKLE        2       // 小雨
#define DING_ON         3       // 大雨
#define FOG             4       // 雾
#define FROST           5       // 霜
#define SNOW            6       // 雪
#define GLOW            7       // 霞

#define CLOUDLESS       0       // 无云
#define NORMAL          1       // 有云
#define CLOUDY          2       // 多云

nosave int current_day_phase, no_auto_save;     // Micro 19990320 减少系统负担
mapping *day_phase;

// 变量：记录各地天气当前状态
mapping mWeather;

string *weather_msg = ({
  "天空中万里无云",
  "几朵淡淡的云彩妆点著晴朗的天空",
  "白云在天空中飘来飘去",
  "厚厚的云层堆积在天边",
  "天空中乌云密布",
});

mapping *read_table(string file);
void init_day_phase();
void auto_save();
void auto_reboot();
void give_gift();
void update_weather();

void create() {
  day_phase = read_table("/adm/etc/nature/day_phase");
  init_day_phase();
}

void init_day_phase() {
  mixed *local;
  int i, t;

  // Get minutes of today.
  local = localtime(TIME_TICK);
  t = local[2] * 60 + local[1];           // hour * 60 + minutes

  // Find the day phase for now.
  for (i = 0; i < sizeof(day_phase); i++)
    if (t >= day_phase[i]["length"])
      t -= (int)day_phase[i]["length"];
    else
      break;

  current_day_phase = (i == 0 ? sizeof(day_phase) - 1 : i - 1);

  // Since in our time scale, 1 minute == 1 second in RL, so we don't need
  // any conversion before using this number as call_out dalay, if you 
  // changed the time scale, be sure to convert it.

  call_out("update_day_phase",
    (int)day_phase[(current_day_phase + 1) % sizeof(day_phase)]["length"] - t);
}

