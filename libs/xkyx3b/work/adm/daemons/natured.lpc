void give_gift()                                // 突发事件
{
  mixed *file;
  object ob, *all_user;
  string dir, filename;
  int l, m, n;

  no_auto_save = 0;

  all_user = users();

  // Micro: 1999-02-21 当少于 5 人时，不开放
  if (!all_user) return;
  if (sizeof(all_user) < 5) return;

  if (random(10) == 0) {
    no_auto_save = 1;

    ob = new("/obj/npc/rascal");
    ob->do_move();

    log_file("STONES", sprintf(HIR "%s : 流氓。\n" NOR, ctime(time())));
  }

  /*      Micro: 这样东西到做得好一些时再放开吧。
        if( random( 100 ) == 0 ) {
no_auto_save = 1;
                ob = new("/obj/npc/man");
                ob->move("/d/center/roadn1");

                log_file( "STONES", sprintf(HIR "%s : 大魔／大侠。\n" NOR, ctime(time()) ) );

        }
*/

  if (random(60) == 0) {              // Micro: 60 * 3分钟一次，天降大石
    no_auto_save = 1;

    log_file("STONES", sprintf(HIR "%s : 石头。\n" NOR, ctime(time())));

    m = random(sizeof(path));
    dir = path[m];

    file = get_dir(dir, -1);
    /*
                if( !sizeof(file) ) {
                        if (file_size(dir) == -2) return;       // notify_fail("目录是空的。\n");
                        else return;                            // notify_fail("没有这个目录。\n");
                }
*/
    // Micro: 990320 什么都没有则返回
    if (!sizeof(file)) return;

    n = random(sizeof(file));
    filename = file[n][0];

    l = strlen(filename);
    if (file[n][1] == -2) return;                  // notify_fail("这是一个目录。\n");
    if (l < 3) return;                             // notify_fail("这不是我们要找的文件。\n");
    /*
                if( sprintf("%c", filename[l-2]) == "." && sprintf("%c", filename[l-1] ) == "c" ) {
                        ob = new( stone[ random(sizeof(stone)) ] );
                        ob->move(dir + filename);
                }

                message("system", HIY"【" MUD_NAME "】占星家（Observer）：天降奇缘，有神光降于"
                        + name[m] + "！\n" NOR, users() );
                CHANNEL_D->do_channel( ob, "sys", sprintf(HIR "%s" NOR, dir + filename), 0 );

                log_file( "STONES", sprintf(HIR "%s : %s 落于 %s\n" NOR, ctime(time()), 
                        ob->query("name"), dir + filename) );
*/
    // Micro 19990320
    if (filename[<2..<1] == ".lpc") {  // 注意！！相应目录只能放场景！
      ob = new(stone[random(sizeof(stone))]);
      ob->move(dir + filename);
      message("system", HIY "【" MUD_NAME "】占星家（Observer）：天降奇缘，有神光降于"
        +name[m] + "！\n" NOR, users());
      CHANNEL_D->do_channel(ob, "sys", sprintf(HIR "%s" NOR, dir + filename), 0);

      log_file("STONES", sprintf(HIR "%s : %s 落于 %s\n" NOR, ctime(time()),
        ob->query("name"), dir + filename));
    }
  }
}
