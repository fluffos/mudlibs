// chard.c
// 这个精灵物件用来对人物物件（包括玩家与NPC）的 setup() 做最後的系统性设
// 定，以及处理一些和人物标准物件(CHAR)相关的琐事。
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com    1997.06
// 修改：Key:1999-02-12  对新加种族后的小问题的修补

#include <race.h>

void create() { seteuid(getuid()); }

// 标准人物物件在执行玩 setup()  之後会呼叫这个系统人物设定函数，以对人物
// 的设定做最後的检查或补充。
void setup_char(object ob) {
  string race, national;
  mapping my;
  int n;

  // begin (Key)
  if (!stringp(national = ob->query("national"))) {
    national = "人类";
    ob->set("national", "人类");
  }
  if (ob->query("national") == "矮人") {
    ob->set("national", "矮人族");
  }
  if (ob->query("national") == "精灵") {
    ob->set("national", "精灵族");
  }
  if (ob->query("national") == "妖精") {
    ob->set("national", "妖精族");
  }
  if (ob->query("national") == "龙人") {
    ob->set("national", "龙人族");
  }
  if (ob->query("national") == "兽人") {
    ob->set("national", "兽人族");
  }
  //end
  if (!stringp(race = ob->query("race"))) {
    race = "人类";
    ob->set("race", "人类");
  }

  switch (race) {
    case "人类":
      HUMAN_RACE->setup_human(ob);
      break;
    case "妖魔":
      MONSTER_RACE->setup_monster(ob);
      break;
    case "野兽":
      BEAST_RACE->setup_beast(ob);
      break;
    default:
      error("Chard: 没有定义种族：" + race + "。\n");
  }

  my = ob->query_entire_dbase();

  if (undefinedp(my["gin"])) my["gin"] = my["max_gin"];
  if (undefinedp(my["kee"])) my["kee"] = my["max_kee"];
  if (undefinedp(my["sen"])) my["sen"] = my["max_sen"];

  if (undefinedp(my["eff_gin"])) my["eff_gin"] = my["max_gin"];
  if (undefinedp(my["eff_kee"])) my["eff_kee"] = my["max_kee"];
  if (undefinedp(my["eff_sen"])) my["eff_sen"] = my["max_sen"];

  if (userp(ob)) {
    // Micro: 最大内力可以有两种：练习到 n * 10，吸人到 n * 12，
    //        以 n * 12为最大限制
    n = ((int)ob->query_skill("force", 1) + ob->query_skill("force") / 5) * 10;
    if (ob->query("max_force") > n * 12 / 10) ob->set("max_force", (int)(n * 12 / 10));

    n = ((int)ob->query_skill("magic", 1) + ob->query_skill("magic") / 5) * 10;
    if (ob->query("max_atman") > n) ob->set("max_atman", n);

    n = ((int)ob->query_skill("spells", 1) + ob->query_skill("spells") / 5) * 10;
    if (ob->query("max_mana") > n) ob->set("max_mana", n);
  }

  if (undefinedp(my["SEN"])) my["SEN"] = 0;

  if (!ob->query_max_encumbrance())
    ob->set_max_encumbrance(my["str"] * 10000);   // 可以在500至20000间取值。

    ob->reset_action();
}

// 人物的死亡程序之一，由 F_DAMAGE 中的 die()  呼叫这个函数以造出人物的尸
// 体，由於 killer 不一定存在( 死於中毒、重伤等 )，因此第二个参数可有可无。
varargs object make_corpse(object victim, object killer) {
  object corpse, *inv;
  int i;

  // 鬼魂死后的处理
  if (victim->is_ghost()) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) inv[i]->move(environment(victim));
    return 0;
  }

  // 僵尸死后的处理
  if (victim->is_zombie()) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) destruct(inv[i]);
    say(victim->name() + "缓缓地倒了下来，化为一滩血水。\n");
    return 0;
  }

  // Guest死后的处理
  if (victim->query("id") == "guest") {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) destruct(inv[i]);
    say(victim->name() + "缓缓地倒了下来，突然之间消失了。\n");
    return 0;
  }

  // 其它死后的处理
  corpse = new(CORPSE_OB);
  corpse->set_name(victim->name(1) + "的尸体", ({ "corpse" }));
  corpse->set("long", victim->long()
    + "然而，" + gender_pronoun(victim->query("gender"))
    + "已经死了，只剩下一具尸体静静地躺在这里。\n");
  corpse->set("age", victim->query("age"));
  corpse->set("gender", victim->query("gender"));
  corpse->set("victim_name", victim->name(1));
  corpse->set_weight(victim->query_weight());
  // * (userp(victim)? 100: 1) 不能搬动玩家的尸体
  // 本来用于对付一个ＢＵＧ：玩家杀玩家再将尸体火化
  // 现在对鬼魂回家进行限制，解决了这个问题。
  corpse->set_max_encumbrance(victim->query_max_encumbrance());
  corpse->move(environment(victim));

  // 巫师死后将不会失去身上的东西。而其它将在尸体里留下应有的东西。
  if (!wizardp(victim)) {
    inv = all_inventory(victim);
    inv->owner_is_killed(killer);
    inv -= ({ 0 });
    i = sizeof(inv);
    while (i--) {
      if ((string)inv[i]->query("equipped") == "worn") {
        inv[i]->move(corpse);
        if (!inv[i]->wear()) inv[i]->move(environment(victim));
      } else {          // 清除no_drop的物品。
        if (!inv[i]->query("no_drop")) inv[i]->move(corpse);
      }
    }
  }

  return corpse;
}
