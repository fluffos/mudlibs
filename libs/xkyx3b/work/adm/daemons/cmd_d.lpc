// cmd_d.c
// 这个 daemon 是用来管理所有的可用的指令，并将新增加的指令列入系统的指令表内。
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com    1997.06

mapping search = ([]);

// 这个函式是用来重新读取 <dir> 底下的所有指令，并将之加入一个指令表内以供日後
// 查询。在有新增或删除 <dir> 里的指令时都会用到。
void rehash(string dir) {
  string *cmds;
  int i;

  if (dir[sizeof(dir) - 1] != '/') dir += "/";
  cmds = get_dir(dir);
  i = sizeof(cmds);
  while (i--)
    if (!sscanf(cmds[i], "%s.lpc", cmds[i])) {
      if (i == 0) cmds = cmds[1..sizeof(cmds)];
      else if (i == sizeof(cmds)) cmds = cmds[0..<2];
      else cmds = cmds[0..i - 1] + cmds[i + 1..<1];
    }
  if (sizeof(cmds)) search[dir] = cmds;
}

// 这个函式会在传入的 *path（阵列型态）中查询 <verb> 是否存在。如果存在则传回该
// 指令的档名（包含路径，减去'.c'）如果不存在则传回 0。如果所传入的 *path里含有
// 未经 rehash() 处理过的子目录。则该目录名会被传入 rehash() 以将指令加入系统指
// 令表。
string find_command(string verb, string *path) {
  int i;

  if (!pointerp(path)) return 0;

  i = sizeof(path);
  while (i--) {
    if (undefinedp(search[path[i]])) rehash(path[i]);
    if (undefinedp(search[path[i]])) continue;
    if (member_array(verb, search[path[i]]) != -1) return path[i] + verb;
  }

  return 0;
}
