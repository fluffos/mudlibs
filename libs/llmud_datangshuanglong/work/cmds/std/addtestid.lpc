

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	
    if(!wizardp(me)&&me->query("id")!="sky")
    return 0;
    
    if(!arg)
    return notify_fail("请输入测试的ID\n");
    log_file("testid",arg+"\n");
    
    tell_object(me,"你增加了测试ID："+arg+"\n");
    
    "/adm/daemons/logind.lpc"->create();
    
    return 1;	
	
}
