// score.c
// modify by yanyan. 2001.  hide the combat_exp.
#include <ansi.h>
#include <combat.h>
#include <org.h>
#include <tomud.h>
inherit F_CLEAN_UP;

string get_shili(object ob);
string query_guanzhi(object ob);

void create() { seteuid(ROOT_UID); }

string get_damage(object me,mapping action,string skill_name)
{
	
  return COMBAT_D->get_damage(me,0,me->query_temp("weapon"),action,0,skill_name);
	
}
string get_attack(object me,mapping action)
{
	
return COMBAT_D->get_attack(me,0,action,0);	
}

string get_parry(object me)
{
return COMBAT_D->get_parry(me);	
}

int main(object me, string arg)
{
	object ob;
	mapping my;
	string line, str, skill_type, parry_type;
	object weapon;
	int attack_points, dodge_points, parry_points;
	mapping action;
	string skill_name;
	
	seteuid(getuid(me));
	if(!arg) ob = me;
	else if (wizardp(me))
	{
	   	ob = present(arg, environment(me));
        	if (!ob) ob = find_player(arg);
	        if (!ob) ob = find_living(arg);
        	if (!ob) return notify_fail("你要察看谁的状态？\n");
	}
	else return notify_fail("只有巫师能察看别人的状态。\n");
	
	if(!ob->query("actionp"))
	{
	  skill_name=ob->reset_action(ob->query_temp("weapon"));
	  action=ob->query("actions");
	}
	else
	{
	  action=ob->query("actionp");
	  skill_name=action["skill_name"];
	}
	my = ob->query_entire_dbase();
	line=ob->name()+"@";  	  	   //姓名
	line+=RANK_D->query_rank(ob)+"@";  //头衔
	line+=chinese_number(ob->query("age"))+"岁@"; //年龄
	line+=ob->query("gender")+"@";    //性别
	
	if( mapp(my["family"]))
	{
		if( my["family"]["master_name"] )
		{
			line+=my["family"]["master_name"]+"@";
	         }
                
	}
	else line+="无@";
	
	if(!ob->query("couple")) line+="未婚@";
	else  line+=ob->query("couple/couple_name")+"@";
	
	line+=my["str"]+" ( "+ob->query_str()+" )@";  	  //膂力
	line+=my["int"]+" ( "+ob->query_int()+" )@";  	  //悟性
	line+=my["con"]+" ( "+ob->query_con()+" )@";  	  //根骨
	line+=my["dex"]+" ( "+ob->query_dex()+" )@";  	  //身法
	line+=my["per"]+" ( "+ob->query_per()+" )@";  	  //容貌
	line+=my["kar"]+" ( "+ob->query_kar()+" )@";  	  //福缘
	
	if(!ob->query("vocation")) line+="无职业@";
	else line+=CHINESE_D->chinese(ob->query("vocation"))+"@";
	line+=get_damage(ob,action,skill_name)+"@";  	  //伤害
	line+=get_attack(ob,action)+"@";  	  	  //敏捷
	line+=get_parry(ob)+"@";  	  		  //招架
	
	line+=ob->query("potential")+"/"+ob->query("max_pot")+"@"; //潜能
	line+=ob->query("combat_exp")+"@";  	          	   //实战
	if(!ob->query("shili/name")) line+= "无@";
	else line+=get_shili(ob)+"@";
	line+=ob->query("deposit")+"@";  	          	   //存款
	line+=ob->query("famous")+"@";  	          	   //江湖声望
	line+=ob->query("vocation_score")+"@";  	           //职业声望
	
	line+=ob->query("bellicosity")+"@";  	           //杀    气
	line+=ob->query("mud_age")/3600+" 小时@";  	           //时间
	
	line+=my["MKS"]+" 次@";  	           	   //杀人
	line+=ob->query("deadtimes")+" 次@";  	           //死亡
	write(TMI("score "+line));
	return 1;
}

  
  

string get_shili(object ob)
{
   return ORG_D->get_shili(ob);
}
string query_guanzhi(object ob)
{
    return ORG_D->query_guanzhi(ob);
}

int help(object me)
{
    write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

HELP
    );
    return 1;
}
