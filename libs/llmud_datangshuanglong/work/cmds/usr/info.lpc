//获取物品信息命令
#include <ansi.h>
#include <tomud.h>   //angelus 2012.2.15

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }


int main(object me, string arg)
{
   string longs;
   object obj;
   

   obj = present(arg, me); 
   longs= obj->query("name")+"@"; 
   longs+=CMD_LOOK->unique_long(obj);
    
	
	write(TMI("info "+longs));
	return 1;
}