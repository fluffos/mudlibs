//arm.c

#include <ansi.h>
#include <tomud.h>
#include <combat.h>
inherit F_CLEAN_UP;

string name_temp(object ob,string type);



int main(object me, string arg)
{
        object ob;
        int islook;
        string line="";
	
	string *armor_type=({"armor/armor","armor/cloth","armor/boots","armor/head","armor/wrists","armor/neck","armor/surcoat","armor/waist","weapon","secondary_weapon"});  

        if (arg)
	{
                ob = find_player(arg);
                if (! ob) ob = find_living(arg);
                if (! ob) ob = present(arg, environment(me));
                if(!ob)
                {
                     return notify_fail("你要察看谁的装备？\n"); 
                }
               
                       
        }
          if (! ob)
          {
              ob = me;
          }
          if( ob==me && me->is_ghost() ) 
          return notify_fail("这些身外之物，生不带来，死不带区，还是算了吧！\n");
         
	  for(int i=0; i< sizeof(armor_type); i++)
          {
		line+=armor_type[i]+"@"+ name_temp(ob,armor_type[i]) +"$" ; 
		write(TMI("arm "+line));
          }	
		
 
        return 1;
}
string name_temp(object ob,string type)
{
    string ids;
    object obj;
    if( objectp(obj=ob->query_temp(type)) ) 
    {
       ids = obj->query("id")+"@"+RANK_D->new_icon(obj) ;
    }
    else
    {
       ids = "@";
    }
   return ids;
}




int help (object me)
{
        write(@HELP
指令格式: arm
 
可列出你(你)目前身上所携带的所有物品。
 
 
HELP );
        return 1;
}