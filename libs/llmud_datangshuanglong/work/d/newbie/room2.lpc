
#include <ansi.h>
inherit ROOM;


void create ()
{
  set ("short","战斗篇");
  set ("long", @LONG
help combat 命令是关于战斗的。

fight  命令来切磋武艺。
kill   命令来杀死对方。
ansuan 命令来暗算对方。
如果你投身杀手职业，可以使用 ansha 命令来暗杀对方。

战斗中的其他心得，还是请教一些江湖豪客吧！
LONG);

  set("exits", ([ 
 "west":__DIR__"room1",
        ]));
  
set("no_fight",1);
set("no_exert",1);
  set("valid_startroom", 1);
  setup();
 
}

