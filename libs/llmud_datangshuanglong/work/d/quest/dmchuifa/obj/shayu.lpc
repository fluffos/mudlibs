
inherit NPC;

#include <job_money.h>

void create()
{
     set_name("鲨鱼",({ "sha yu","sha","yu","shark"}) );
     set("race", "野兽" );
     set("long", "这是一只凶猛的鲨鱼。\n");
     set("verbs",({"bite"}));
     set("limbs",({"头","尾巴","腹部"}));
     set("attitude","aggressive");
     setup();

}

void set_status(object ob)
{
  set("target_id",ob->query("id"));
  set("combat_exp",ob->query("combat_exp"));
  copy_hp_item(ob,this_object(),"kee");
}
  