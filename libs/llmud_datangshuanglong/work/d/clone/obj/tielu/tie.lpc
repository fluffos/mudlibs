

inherit ITEM;

void create()
{
   set_name("铁块", ({ "tie"}) );
   set_weight(5000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("material", "iron");
     set("unit", "块");
     set("value",0);
	 set("weapon",([
		 "damage":10,
		 "strong":10,
		 ]));
    
   }
   setup();
}
