
#include <room.h>

inherit ROOM;

int do_action(string arg);

void create()
{
	set("short", "练武场");
	set("long", @LONG
这里是石龙武馆的练武场，是石龙武馆初级弟子学习武功的地方。
你可以在这里和弟子【切磋】武功。只见这里尘土飞扬，数名弟子正在那里
打得热闹。
LONG+TMI("room_cmd qiecuo di zi*切磋")
);


	set("exits", ([
		"east" :__DIR__"beilang1",
		"north":__DIR__"wuchang6",
		"west":__DIR__"wuchang7",
		"south":__DIR__"wuchang8",
               
	]));
	set("objects",([
	     __DIR__"npc/dizi":2,
	    ]));
       set("no_fight",1);
       set("outdoors", "slwg");
	setup();
}

void init()
{
  add_action("do_action","qiecuo");
}

