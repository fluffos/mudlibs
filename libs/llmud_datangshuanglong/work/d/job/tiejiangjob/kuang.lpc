#include <ansi.h>
// #include <job_money.h>
inherit ITEM;
mapping name=([
RED"红铁矿"NOR:"hongtie",
YEL"橙铁矿"NOR:"chengtie",
HIY"黄铁矿"NOR:"huangtie",
GRN"绿铁矿"NOR:"lvtie",
HIC"青铁矿"NOR:"qingtie",
BLU"蓝铁矿"NOR:"lantie",
MAG"紫铁矿"NOR:"zitie",
]);

void create()
{
   string *n;int i;
   string *w;
    
   n=keys(name);
   i=random(sizeof(n));
   set_name(n[i],({name[n[i]]}));
   set_weight(600);
   
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("long","一块铁矿。\n");     
     set("no_sell",1);
//     set("no_give",1);
     set("no_save",1);
     set("nogive_player",1);
     set("material", "iron");
     set("unit", "块");
     set("value", 0);
     set("weapon",([
		 "damage":10,
		 "strong":10,
		 ]));
           
   }
   setup();
   
}

