#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "船舱");
        set("long", @LONG
你刚走进船舱内，一股清新的油漆味道扑鼻而来。显然这艘船刚建
成不久。不停的有水手从这里经过，从他们的举止看来，其中不乏武林
高手。
LONG
);
        set("exits",([
	"west" : __DIR__"ship_2_4",
	"north" : __DIR__"ship_0_6",
	"east" : __DIR__"ship_2_8",
        ]));
        setup();
//        replace_program(ROOM);
}
