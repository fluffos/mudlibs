#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "丘陵");
  set("long", @LONG
你正走在一条崎岖不平的丘陵上，偶尔听到一阵阵的野兽叫声，头
顶有一些不知名的小鸟在跳来跳去，四周丛林密布，鲜花绿草若隐若现，
四周不时传来哗哗的松涛声和一些淡淡的花香。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "dmjob_2_9",
    "westdown": __DIR__ "dmjob_4_5",
    "southeast": __DIR__ "dmjob_6_9",
  ]));
  set("outdoors", "dmjob");
  setup();
  //        replace_program(ROOM);
}
