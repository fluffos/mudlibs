#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "盘山路");
        set("long", @LONG
这里是屏风山的一条盘山路。东边是一个悬崖。这里地势复杂，道
路曲折，四周被高峰所包围。据说经常有人在这里迷路，你不觉小心起
来。
LONG
);
        set("exits",([
	"southup" : __DIR__"dmjob_6_11",
	"northup" : __DIR__"dmjob_2_11",
	"east" : __DIR__"dmjob_4_13",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
