#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "大峡谷");
        set("long", @LONG
这里是一个大峡谷。四周高峰耸立，挡住了外面的冷气，所
以这里一年四季都是温暖如春。这里风景秀丽，空气清新。地上
有很多漂亮的野花、蒲公英等植物。不时有野兔从你的脚旁跳过。
LONG
);
        set("exits",([
	"west" : __DIR__"dmjob_2_19",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
