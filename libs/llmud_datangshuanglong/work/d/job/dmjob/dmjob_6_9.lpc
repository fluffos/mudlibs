#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小溪");
        set("long", @LONG
这里是一条小溪。北边是一条丘陵。溪水清澈见底，不时可以看到
野兔、松鼠等小动物在溪边喝水。四周丛林密布，鲜花绿草若隐若现。
LONG
);
        set("exits",([
	"northwest" : __DIR__"dmjob_4_7",
	"south" : __DIR__"dmjob_8_9",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
