#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "拜仙台");
        set("long", @LONG
这里是屏风山的拜仙台了。东边是屏风山的清风谷。据说有仙人曾
经在这里讲法，从而使屏风山免遭一场大难。这里气氛宁静，向远处望
可以看到屏风山秀丽的景色。
LONG
);
        set("exits",([
	"northup" : __DIR__"dmjob_2_3",
	"eastdown" : __DIR__"dmjob_4_5",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
