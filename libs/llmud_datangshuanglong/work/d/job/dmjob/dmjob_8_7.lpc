#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "落雁湖");
        set("long", @LONG
这里是屏风山的落雁湖了。这里芦苇丛生，气氛宁静。据说每年都
有许多大雁在这里栖息，所以命之为落雁湖。一阵微风吹来，芦苇在湖
面上轻轻地摆动着。
LONG
);
        set("exits",([
	"east" : __DIR__"dmjob_8_9",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
