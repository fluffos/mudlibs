void create()
{
	set("short", "密林");
        set("long", @LONG
这里是一片一望无垠林海，每棵树木都有十来丈高，周围阡陌交错，
几十丈高的大树簇在一块，密实的枝叶象一蓬蓬巨伞般伸向天空，把阳光
遮得丝毫也无。
LONG
);
        set("exits",([
