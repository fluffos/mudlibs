inherit "obj/monster";
string chat_str, function, type, match;
int done;

#include "/players/tamina/defs.h"

reset(arg) {
  ::reset(arg);
  if (arg) return;
  done = 0;

  if (!chat_str) {
    chat_str = allocate(3);
    chat_str[0] = "The Frost King blows a smoke ring and sends it sailing up to the ceiling.\n";
    chat_str[1] = "The Frost King relaxes in his armchair...\n";
    chat_str[2] = "The Frost King ponders on a logical puzzle for a few moments.\n";
    function = allocate(2);
    type = allocate(2);
    match = allocate(2);
    function [0] = "say_hello";
    type[0] = "arrives";
    function [1] = "gives";
    type[1] = "gives";
  }
  set_name("Frost Giant King");
  set_alias("king");
  set_short("frost giant king");
  set_race("giant");
  set_gender(1);
  set_long(
    "This is the Frost Giant King. He looks more like your typical father\n" +
    "than a king. He is dressed is a bathrobe and is smoking a pipe.\n");
  set_level(25);
  set_ac(15);
  set_hp(1600);
  set_wc(35);
  set_al(-250);
  set_chance(40);
  set_spell_dam(60);
  set_spell_mess1("The Frost Giant King summons a blast of ice bolders!");
  set_spell_mess2("The Frost Giant King blasts you with a hail of ice boulders!");
  load_chat(10, chat_str);
  set_match(TO, function, type, match);
}

hit_player(dam) {
  if (file_name(E(TO)) == TFROST + "study" && !done) {
    dam = 0;
    do_stuff();
  }
  return ::hit_player(dam);
}

heart_beat() {
  ::heart_beat();
  if (file_name(E(TO)) != TFROST + "study" && !done && attacker_ob)
    do_stuff();
  if (file_name(E(TO)) != TFROST + "false" && done && attacker_ob)
    MO(TO, TFROST + "false");
}

do_stuff() {
  object staff, bag, money;

  say("The Frost Giant King makes a magical gesture and disappears!\n");
  TO->move_object(TFROST + "false");
  done = 1;
  "/players/tamina/teds/frost/study"->fking_moved(1);
  set_aggressive(1);

  staff = clone_object(TWP + "staff_of_striking");
  bag = clone_object(TITEMS + "bag_of_holding");
  money = clone_object("obj/money");
  money->set_money(random(2000) + 3200);

  TR(staff, TO);
  TR(money, bag);
  TR(bag, TO);
  TR(clone_object(TITEMS + "regen_ring"), TO);
}

int gives(string str) {
  string who, what, whom;
  object king_ob, ob;

  if (sscanf(str, "%s gives %s to %s.", who, what, whom) != 3)
    return 1;
  if (whom == "King" || whom == "Giant" || whom == "king" || whom == "giant")
    if (what == "key") {
      say("Frost Giant King says: Thank you very much!\n");
      say("Frost Giant King makes a magical gesture and the key is gone!\n");
      say("Frost Giant King says: However, this means you killed my messenger!\n");
      write("The Frost Giant King hails you with Ice Boulders !!\n");
      HIT(35);
      ob = present(what, TO);
      if (ob) {
        call_other(ob, "drop");
        ob->move_object("players/ted/storage");
      }
      do_stuff();
      return 1;
    }
  write("Frost Giant King says: Thank you.\n");
  return 1;
}

int say_hello(string str) {
  string who_say;

  if (sscanf(str, "%s arrives.", who_say) == 1) {
    say("The Frost Giant King says: Who are you and what do you want?\n");
    return 1;
  }
}

second_life() {
  "/players/tamina/teds/frost/study"->fking_moved(0);
  return 0;
}
