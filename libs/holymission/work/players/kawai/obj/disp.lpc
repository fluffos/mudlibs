object g1, g2, g3;

void make() {
  if (!g1)
    g1 = clone_object("players/kawai/areas/dwarves/mole")->move_object("players/kawai/areas/dwarves/field2");
  if (!g2)
    g2 = clone_object("players/kawai/areas/dwarves/mole")->move_object("players/kawai/areas/dwarves/field5");
  if (!g3)
    g3 = clone_object("players/kawai/areas/dwarves/mole")->move_object("players/kawai/areas/dwarves/field10");
}

void init() {
  call_out("make", 15, 0);
}

int id(string str) {
  return str == "disp";
}
