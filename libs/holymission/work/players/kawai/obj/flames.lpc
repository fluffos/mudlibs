#define TP  this_player()
#define ROOM "/players/whisky/garden/room"
#define TO  this_object()
#define TPN TP->query_name()
#define env environment

object e, kill_ob;

int hp, i, r;
int or;

string KON, KOPOS;
string msg1, msg2;

void reset(int arg);

string query_name() {
  return "flames";
}

string short() {
  return "Hot burning flames";
}

string alias() {
  return "burning flames";
}

string query_pronoun() {
  return "they";
}

int query_npc() {
  return 1;
}

int id(string str) {
  return str == "flames";
}

void long() {
  write("Flames burn your hair, your hands, your feet, your whole body !!!\n");
}

void init() {
  // AGENTS.md sec.7.19 (room/prop variant, worse shape than the
  // darkelib room/prop instance -- a plain living() guard is NOT
  // enough here, see below). This "flames" hazard prop is freshly
  // CLONED and moved into players/kawai/hell.lpc every time a living
  // object enters that room (hell.lpc's own init(): `ob =
  // clone_object("players/kawai/obj/flames")->move_object(this_object());`).
  // Because the entering living object is already sitting in hell's
  // inventory at that point, the driver's own item<->room command-
  // registration cascade re-invokes THIS init() on the fresh flames
  // clone while hell.lpc's original init() call is still on the stack;
  // calling enable_commands() here reenters that same cascade, which
  // reenters hell.lpc's OWN init() -- cloning yet ANOTHER brand-new
  // flames object -- which reenters this init() on THAT fresh clone,
  // and so on, recursing until "Too deep recursion." aborts it. A
  // living()-guard (`if (!living(this_object())) enable_commands();`,
  // the fix used for darkelib's structurally simpler pond.lpc case)
  // does NOT stop this: every reentrant pass gets a brand-new,
  // never-yet-living clone, so the guard is always true and never
  // blocks anything -- it's hell.lpc's own init() that needs to stop
  // recursing, not this object's. Live-reproduced via a temporary
  // preload harness, including confirming the living()-guard alone was
  // insufficient: a single trigger left 48 leaked, uninitialized
  // flames clones sitting in the hell room in addition to throwing
  // "Too deep recursion." -- the punishment mechanic (burn_player(),
  // below) never even ran, since the crash happens before hell.lpc's
  // init() reaches that call.
  //
  // Fix: drop the enable_commands() call entirely, rather than guard
  // it. It serves no purpose here -- this object never defines
  // catch_tell() or uses command(), and doesn't even use add_action()
  // (unlike darkelib's pond.lpc, which at least had a real add_action()
  // call after its own enable_commands()) -- so nothing anywhere reads
  // living(this_object()) for this prop. This matches how the SAME bug
  // was already fixed, independently, elsewhere in this very archive:
  // 3 near-identical sibling copies of this file
  // (players/goldsun/mud/flames.lpc, players/goldsun/lank/obj/flames.lpc,
  // players/whisky/garden/obj/flames.lpc) carry a 1993 header comment,
  // "Recoded by Uglymouth 930901: removed enable_commands() and
  // heart_beat(), ... bug (dead 1, ghost 0) solved now" -- this file
  // (players/kawai/obj/flames.lpc) is simply the one copy that never
  // got that fix applied.
}

void burn_player(object ob) {
  if (ob->query_wizard() && ob->query_invis()) {
    destruct(this_object());
    return;
  }
  kill_ob = ob;
  KON = ob->query_name();
  KOPOS = ob->query_possessive();
  ob->attack_object(TO);
  set_heart_beat(1);
}

void heart_beat() {
  if (!kill_ob || kill_ob->query_ghost() || env(kill_ob) != env(TO)) {
    destruct(TO);
    return;
  }
  r = random(5) + 1;
  for (i = 0; i < r; i++) {
    msg1 = "";
    msg2 = "";
    switch (random(5)) {
      case 0: msg1 += "Flames lick up from your shoes to your hair !";
      msg2 += "Flames lick up from " + KON + "'s shoes to " + KOPOS + " hairs !";
      break;
      case 1: msg1 += "The heat of the oven takes your breath away !";
      msg2 += KON + " desperately tries to breath, but\n"
        + "only smoke gets in " + KOPOS + " nostrils !";
      break;
      case 2: msg1 += "You feel like Satan has come to visit you !";
      msg2 += "Satan has come to visit " + KON + " !";
      break;
      case 3: msg1 += "You feel your left eyeball burst as a flame "
        + "burns your head !";
      msg2 += KON + " screems with horror as " + KOPOS + " left eyeball "
        + "burst\nlike a toad being blown up !";
      break;
      case 4: msg1 += "Blisters grow from your back as the flames shift\n"
        + "slowly from your back to your toes !";
      msg2 += "Blisters grow from " + KON + "'s back as the flames\n"
        + "shift slowly from " + KOPOS + " back to " + KOPOS + " toes !";
      break;
    }
    msg1 += "\n";
    msg2 += "\n";
    tell_object(kill_ob, msg1);
    tell_room("room/church", msg2);
  }
  hp = kill_ob->query_hp() / (1 + random(2));
  if (hp < 100)
    hp = random(kill_ob->query_hit_point() * 2);
  kill_ob->misc_hit(hp, 0, 0);
  if (++or == 3 && !kill_ob->query_ghost()) {
    tell_object(kill_ob, "\n\nFinally, by the mercy of the gods, you are released!\n\n");
    kill_ob->set_alignment("burning");
    kill_ob->move_object("room/church");
    say(KON + " arrives, coughing and smoking, still burning a bit !\n", kill_ob);
    kill_ob->force_me("look");
    destruct(this_object());
    return;
  }
}

void add_exp(int i) {
  string name;
  object *ob, th;
  ob = all_inventory(kill_ob);
  for (i = 0; i < sizeof(ob); i++)
    if (!random(3) && (name = ob[i]->query_name()) && !ob[i]->drop()) {
      th = clone_object("obj/thing");
      th->set_name(name);
      th->set_short(ob[i]->short() + " (burning)");
      th->set_weight(1);
      th->set_value(40);
      th->set_can_get(1);
      th->move_object("players/kawai/workroom");
      destruct(ob[i]);
    }
}
