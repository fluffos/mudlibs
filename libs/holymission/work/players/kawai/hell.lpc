inherit "room/room";

#include "/players/kawai/hell.h"
#define env environment

object kill_ob;

void reset(int arg) {
  if (!arg) {
    set_light(1);
    short_desc = "HELL!!!";
    long_desc = "Welcome to Hell, Asshole!  You have offended the gods, so now you " +
      "must pay the price!  Enjoy your stay!!!\n";
  }
}

void init() {
  object ob;
  // Was `ob = clone_object(...)->move_object(this_object());` -- this
  // driver's move_object() (the universal 1-arg compat shim in
  // /include/include.h, `mixed move_object(mixed dest) { return
  // efun::move_object(dest); }`) returns the real efun's int status
  // code, not the moved object, so `ob` ended up holding an int and
  // every use below (`ob->burn_player(...)`, `destruct(ob)`) operated
  // on that int instead of the flames clone. Split into two statements
  // so `ob` keeps the actual object reference. Found live while
  // verifying the AGENTS.md sec.7.19 fix to
  // players/kawai/obj/flames.lpc's own init() -- fixing the reentrancy
  // crash that used to abort this init() before it ever reached this
  // line exposed this second, previously-unreachable bug.
  ob = clone_object("players/kawai/obj/flames");
  ob->move_object(this_object());
  if (this_player()) {
    ob->burn_player(this_player());
    if (!this_player()->query_wizard()) {
      add_action("block", "", 1);
    }
  } else {
    destruct(ob);
  }
}

int block(string str) {
  if (this_player()->query_ghost()) {
    write("\n\nYour smoking remains pass through an opening in the oven ...\n\n");
    this_player()->move_object("room/church");
    say("Smoking remains of " + capitalize(this_player()->query_real_name()) +
      " arrives.\n");
    this_player()->force_me("look");
    return 1;
  }
}

void burn_player(object ob) {
  kill_ob = ob;
}

int query_no_teleport() {
  return 1;
}
