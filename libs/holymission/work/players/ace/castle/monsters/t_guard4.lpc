inherit "obj/monster.lpc";

object weapon, armor;

reset(arg) {
  ::reset(arg);
  set_level(18);
  set_aggressive(0);
  set_ac(12);
  set_al(-500);
  set_name("Guard");
  set_alt_name("guard");
  set_race("human");
  set_wc(15);
  set_short("A tall, burly Castle Guard");
  set_long("Guard of Ace's Castle.\n" +
    "He is very big, and looks very strong.\n"
  );
  weapon = clone_object("/players/ace/castle/weapons/sword.lpc");
  weapon->move_object(this_object());
  this_object()->force_me("wield sword");
  armor = clone_object("/players/ace/castle/armor/chainmail.lpc");
  armor->move_object(this_object());
  this_object()->force_me("wear chainmail");
}
