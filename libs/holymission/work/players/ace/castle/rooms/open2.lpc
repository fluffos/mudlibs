inherit "room/room";

object monster;

reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "Castle Opening";
  long_desc = "To the north is Ace's Castle.  Beware, only the strong\n" +
    "will survive in such an evil place.\n";
  monster = clone_object("/players/ace/castle/monsters/squirrel.lpc");
  monster->move_object(this_object());
  dest_dir = ({
    "/players/ace/castle/rooms/open.lpc", "south",
    "/players/ace/castle/rooms/moat.lpc", "north",
    "/players/ace/castle/rooms/open3.lpc", "east",
    "/players/ace/castle/rooms/open5.lpc", "west"
  });
}
