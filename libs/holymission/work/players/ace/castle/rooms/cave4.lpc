inherit "room/room";

reset(arg) {
  if (arg) return;
  set_light(0);
  short_desc = "A dark, murky cave.";
  long_desc = "You have entered a drak cave near the Castle.\n" +
    "The way you came in has been covered by fallen rocks.\n" +
    "There seems to be an old door in front of you.\n";
  dest_dir = ({
    "/players/ace/castle/rooms/cave4.lpc", "east"
  });
}
