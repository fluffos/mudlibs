inherit "/obj/monster";

reset(arg) {
  ::reset(arg);
  if (!arg) {

    set_name("praying nun");
    set_level(15);
    set_size(4);
    set_alias("nun");
    set_long("A beautiful praying nun.\n");
    set_chance(20);
    set_spell_dam(10);

    clone_object("players/misticalla/guild/obj/mace")->move_object(this_object());

    init_command("wield mace");
  }

}
