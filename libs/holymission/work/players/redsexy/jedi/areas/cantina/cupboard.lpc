inherit "/obj/container";

reset(arg) {
  if (!arg) {
    set_alias("cupboard");
    set_max_weight(12);
    set_long("A large clothes cupboard in the dressing room.\n");
    set_value(0);
    set_weight(1);
    set_can_get(0);
    ::reset(arg);
  }
  clone_object("/players/redsexy/jedi/objects/hat.lpc")->move_object(this_object());
  clone_object("/players/redsexy/jedi/objects/cloak.lpc")->move_object(this_object());
  clone_object("/players/redsexy/jedi/objects/beaker.lpc")->move_object(this_object());

}
