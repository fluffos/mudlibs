inherit "room/room";
object oa, ob, oc, od, oe;

reset(arg) {
  if (arg) return;
  if (!oa) { oa = clone_object("players/warlord/monsters/fairy2"); oa->move_object(this_object()); }
  if (!ob) { ob = clone_object("players/warlord/monsters/fairy2"); ob->move_object(this_object()); }
  if (!oc) { oc = clone_object("players/warlord/monsters/fairy2"); oc->move_object(this_object()); }
  if (!od) { od = clone_object("players/warlord/monsters/fairy2"); od->move_object(this_object()); }
  if (!oe) { oe = clone_object("players/warlord/monsters/fairy2"); oe->move_object(this_object()); }

  set_light(1);
  short_desc = "A room";
  no_castle_flag = 0;
  long_desc = "There are some small flying creatures here... You think they are \n"
    + "fairys, but they are UGLY!\n";
  dest_dir = ({
    "players/warlord/new/room1.lpc", "south",
  });
}
