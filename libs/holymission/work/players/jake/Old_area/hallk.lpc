inherit "room/room";

reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "hallk";
  long_desc = "This is yet another stretch of hallway.\n"
    "To the north is a stairwell, rooms are to the east and west.\n";
  dest_dir = ({ "players/jake/stairj", "north",
    "players/jake/floor2.lpc", "west",
    "players/jake/floor1.lpc", "east",
    "players/jake/halla.lpc", "south" });

  replace_program("room/room");
}
