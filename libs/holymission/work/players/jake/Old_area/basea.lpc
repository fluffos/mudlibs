inherit "room/room";

reset(arg) {
  if (arg) return;
  set_light(2);
  short_desc = "basea";
  long_desc = "You have wandered further into the basement.\n"
    "It is fairly dark in here.\n"
    "You hear some humming sounds coming from the south.\n";
  dest_dir = ({ "players/jake/basej.lpc", "north",
    "players/jake/basek.lpc", "south",
    "players/jake/baseeast.lpc", "east",
    "players/jake/baserooma.lpc", "west" });

  replace_program("room/room");
}
