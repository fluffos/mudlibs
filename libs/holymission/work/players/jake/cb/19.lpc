inherit "room/room";
#include "/players/jake/defs.h"
reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "On the Chessboard";
  long_desc = "You are standing on the chessboard.  You cannot tell how close " +
    "you are to the edge of the board.  Looking down, you see that you are standing " +
    "on a black square.\n";
  dest_dir = ({
    CB + "11.lpc", "north",
    CB + "12.lpc", "northeast",
    CB + "10.lpc", "northwest",
    CB + "20.lpc", "east",
    CB + "18.lpc", "west",
    CB + "27.lpc", "south",
    CB + "28.lpc", "southeast",
    CB + "26.lpc", "southwest",
  });
}
