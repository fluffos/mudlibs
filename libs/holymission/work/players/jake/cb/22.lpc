inherit "room/room";
#include "/players/jake/defs.h"
reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "On the Chessboard";
  long_desc = "You are standing on the chessboard.  You cannot tell how close " +
    "you are to the edge of the board.  Looking down, you see that you are standing " +
    "on a black square.\n";
  dest_dir = ({
    CB + "14.lpc", "north",
    CB + "15.lpc", "northeast",
    CB + "13.lpc", "northwest",
    CB + "23.lpc", "east",
    CB + "21.lpc", "west",
    CB + "30.lpc", "south",
    CB + "31.lpc", "southeast",
    CB + "29.lpc", "southwest",
  });
}
