inherit "room/room";
#include "/players/jake/defs.h"
object a;
reset(arg) {
  if (!a) {
    a = clone_object("obj/monster");
    a->set_name("Black pawn");
    a->set_short("Black pawn");
    a->set_alt_name("pawn");
    a->set_long("A brave pawn of the chessboard.\n");
    a->set_level(9);
    a->set_align(100);
    a->set_aggressive(0);
    a->set_walk_chance(100);
    a->move_object(this_object());
  }
  if (arg) return;
  set_light(1);
  short_desc = "On the Chessboard";
  long_desc = "You are standing on the chessboard.  You cannot tell how close " +
    "you are to the edge of the board.  Looking down, you see that you are standing " +
    "on a black square.\n";
  dest_dir = ({
    CB + "2.lpc", "north",
    CB + "3.lpc", "northeast",
    CB + "1.lpc", "northwest",
    CB + "11.lpc", "east",
    CB + "9.lpc", "west",
    CB + "18.lpc", "south",
    CB + "19.lpc", "southeast",
    CB + "17.lpc", "southwest",
  });
}
