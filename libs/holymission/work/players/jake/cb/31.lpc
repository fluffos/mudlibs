inherit "room/room";
#include "/players/jake/defs.h"
reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "On the Chessboard";
  long_desc = "You are standing on the chessboard.  You cannot tell how close " +
    "you are to the edge of the board.  Looking down, you see that you are standing " +
    "on a white square.\n";
  dest_dir = ({
    CB + "23.lpc", "north",
    CB + "24.lpc", "northeast",
    CB + "22.lpc", "northwest",
    CB + "32.lpc", "east",
    CB + "30.lpc", "west",
    CB + "39.lpc", "south",
    CB + "40.lpc", "southeast",
    CB + "38.lpc", "southwest",
  });
}
