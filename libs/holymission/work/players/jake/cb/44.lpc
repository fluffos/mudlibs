inherit "room/room";
#include "/players/jake/defs.h"
reset(arg) {
  if (arg) return;
  set_light(1);
  short_desc = "On the Chessboard";
  long_desc = "You are standing on the chessboard.  You cannot tell how close " +
    "you are to the edge of the board.  Looking down, you see that you are standing " +
    "on a black square.\n";
  dest_dir = ({
    CB + "36.lpc", "north",
    CB + "37.lpc", "northeast",
    CB + "35.lpc", "northwest",
    CB + "45.lpc", "east",
    CB + "43.lpc", "west",
    CB + "52.lpc", "south",
    CB + "53.lpc", "southeast",
    CB + "51.lpc", "southwest",
  });
}
