#include "lw.h"
inherit "obj/armour";

void reset(int arg) {
  armour::reset(arg);
  if (arg) return;
  set_name("cloak");
  set_alias("nocloak");
  set_short("Cloak of Time and Space");
  set_long(
    "This is the legandary 'Cloak of Time and Space', and seems to be\n" +
    "phasing with in the space/time continium.   The fibers of the\n" +
    "cloak were woven by the Ancient Timelords of the 4th dimension.\n" +
    "\n");
  set_ac(2 + this_player()->query_legend_level() / 3);
  set_weight(0);
  set_value(0);
  set_type("guild");
}



void init() {
  armour::init();
  add_action("drop", "drop");
}

int drop(string str) {
  if (str == "cloak") {
    write("You do not want to drop your cloak.\n");
    return 1;
  } else {
    return 0;
  }
}

int wear(string str) {
  if (id(str)) {
    write("You wear your cloak of time and space.\n");
    clone_object("/players/nylakoorub/guild/obj/cloak.lpc")->move_object(this_player());
    destruct(this_object());
    return 1;
  }
}
