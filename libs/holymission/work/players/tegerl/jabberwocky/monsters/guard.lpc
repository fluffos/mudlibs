/* Tegerl, 8.3.1995 */
/* monsters/guard1 */


inherit "obj/monster";
void reset(int arg) {
  ::reset(arg);

  if (arg) return;
  set_name("guard");
  set_alt_name("man");
  set_race("human");
  set_short("Guard");
  set_long("A guard.\n"
    + "This man seems to be very resolute.\n"
    + "Don't do anything that could make him angry.\n");
  set_gender(1);
  set_level(25);
  add_money(1000);
  clone_object("/players/tegerl/jabberwocky/obj/lance")->move_object(this_object());
  clone_object("/players/tegerl/jabberwocky/obj/shield")->move_object(this_object());
  command("powerup");
}
