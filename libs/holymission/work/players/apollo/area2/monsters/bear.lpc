inherit "/obj/monster";

reset(arg) {
  ::reset(arg);
  if (!arg) {

    set_name("bear");
    set_level(15);
    set_size(4);
    set_alias("brown bear");
    load_chat(8, ({ "B R U mmmmmmmmmmm\n" }));
    set_short("A dangerous brown bear");
    set_long("It looks harmless but very strong.\n");
    set_spell_mess1("The bear hits you with its claw");
    set_spell_mess2("The bear bites you");
    set_chance(20);
    set_spell_dam(8);

    clone_object("players/apollo/area2/obj/bear_claw")->move_object(this_object());
    clone_object("players/apollo/area2/obj/bear_fur")->move_object(this_object());

    init_command("wield claw");
  }

}
