inherit "room/room";

#include "/players/topaz/defs.h"

reset(arg) {
  ::reset(arg);
  if (!arg) {
    short_desc = "Standard Room";
    long_desc = "This is a standard room.\n";

    dest_dir = ({ CONT + "main_street6", "west",
      CONT + "river_road1", "south",
      CONT + "merry_lane1", "northeast",
    });
    items = ({ "room", "A standard room",
    });
    set_light(1);
    return 1;
  }
}
