inherit "room/room";

#include "/players/topaz/defs.h"

object fbread;
reset(arg) {
  if (!fbread) {
    fbread = clone_object(OBJS + "attach/fbread")->move_object(this_object());
  }
  if (arg) return;
  short_desc = "A maze";
  long_desc = "This part of the maze looks easy.  But be careful!\n";

  dest_dir = ({ MAZE1 + "v12", "northeast",
    MAZE1 + "v15", "northwest",
    MAZE1 + "v3", "southwest",
    MAZE1 + "v4", "southeast",
  });
  items = ({ "maze", "This maze may be tricky",
  });
  property = "no_teleport";
  set_light(1);
  return 1;
}
