/* secret_police/interrogation_room.c */

inherit "/room/room";
#include "/obj/door.h"

mixed call; /* Pointer to call_other for speed */ object obj_1, obj_2; /* Used by the MAKE_DOORS macro */ object spm, sps;

void reset(int arg) {
  object obj, key;
  if (!arg) {
    call = (: call_other :);
    set_light(1);
    dest_dir = ({
      "players/padrone/secret_police/cell", "west",
      "players/padrone/secret_police/hall", "east",
    });
    short_desc = "The Police Interrogation Room";
    long_desc = "The Police Interrogation Room.\n"
      + "A dim and barren, gray square cubicle, lacking any windows,\n"
      + "ideal for its purpose.\n";
    MAKE_DOORS(
      "players/padrone/secret_police/interrogation_room",
      "west",
      "players/padrone/secret_police/cell",
      "east",
      "cell",
      "celldoor",
      "This is a thickand solid door with iron hinges.\n",
      1,
      1,
      1
    )
  } else {
    if (!obj_1)
      obj_1 = present("door", this_object());
    if (obj_1) {
      evaluate(call, obj_1, "set_closed", 1);
      evaluate(call, obj_1, "set_locked", 1);
      evaluate(call, obj_1, "set_both_status");
    }
  }

  if (!sps) {
    sps = clone_object("obj/monster");
    evaluate(call, sps, "set_name", "police sergeant");
    evaluate(call, sps, "set_alias", "sergeant");
    evaluate(call, sps, "set_short", "A police sergeant");
    evaluate(call, sps, "set_long",
      "This ugly brute makes you glad you are not a prisoner.\n");
    evaluate(call, sps, "set_level", 5);
    evaluate(call, sps, "set_hp", 200);
    evaluate(call, sps, "set_al", 50);
    evaluate(call, sps, "set_male");
    evaluate(call, sps, "set_spell_mess1",
      "The police sergeant kicks his opponent with a dagger-tipped boot"); evaluate(call, sps, "set_spell_mess2",
      "The police sergeant kicks you with a dagger-tipped boot");
    evaluate(call, sps, "set_chance", 20);
    evaluate(call, sps, "set_spell_dam", 10);
    evaluate(call, sps, "set_aggressive", 1);

    sps->move_object(this_object());

    obj = clone_object("players/padrone/secret_police/membership");
    obj->move_object(sps);

    obj = clone_object("obj/weapon");
    evaluate(call, obj, "set_name", "short sword");
    evaluate(call, obj, "set_alias", "shortsword");
    evaluate(call, obj, "set_alt_name", "sword");
    evaluate(call, obj, "set_class", 15);
    evaluate(call, obj, "set_value", 700);
    evaluate(call, obj, "set_weight", 2);
    evaluate(call, obj, "set_short", "A short sword");
    obj->move_object(sps);
    evaluate(call, sps, "init_command", "wield short sword");

    MAKE_KEY(key, "cell", "celldoor") key->move_object(sps);
  }

  if (!spm) {
    spm = clone_object("obj/monster");
    evaluate(call, spm, "set_name", "policeman");
    evaluate(call, spm, "set_alias", "secret policeman");
    evaluate(call, spm, "set_short", "A policeman");
    evaluate(call, spm, "set_long", "The policeman stands alert upon inspection.\n");
    evaluate(call, spm, "set_level", 1);
    evaluate(call, spm, "set_al", 60);
    evaluate(call, spm, "set_male");
    evaluate(call, spm, "set_spell_mess1", "The policeman throws a quick punch\n");
    evaluate(call, spm, "set_spell_mess2", "The policeman punches you");
    evaluate(call, spm, "set_chance", 10);
    evaluate(call, spm, "set_spell_dam", 10);
    evaluate(call, spm, "set_spell_mess1", "The policeman throws a quick punch\n");
    evaluate(call, spm, "set_spell_mess2", "The policeman punches you");
    evaluate(call, spm, "set_chance", 10);
    evaluate(call, spm, "set_spell_dam", 10);
    evaluate(call, spm, "set_aggressive", 1);

    spm->move_object(this_object());

    obj = clone_object("players/padrone/secret_police/membership");
    obj->move_object(spm);
    evaluate(call, obj, "set_name", "policeman");

    obj = clone_object("obj/weapon");
    evaluate(call, obj, "set_name", "club");
    evaluate(call, obj, "set_alias", "billy club");
    evaluate(call, obj, "set_class", 5);
    evaluate(call, obj, "set_value", 10);
    evaluate(call, obj, "set_weight", 2);
    evaluate(call, obj, "set_short", "A billy club");
    obj->move_object(spm);
    evaluate(call, spm, "init_command", "wield club");
  }
}
