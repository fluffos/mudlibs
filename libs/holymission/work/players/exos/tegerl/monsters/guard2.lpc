/* Tegerl, 8.3.1995 */
/* monsters/guard2 */


inherit "obj/monster";
void reset(int arg) {
  ::reset(arg);

  if (arg) return;
  set_name("guard");
  set_alt_name("man");
  set_race("human");
  set_short("Guard");
  set_long("A guard.\n"
    + "But he is no ordinary guard.\n"
    + "He is a guard of the king.\n"
    + "This man seems to be very resolut.\n"
    + "Don't do anythink that could make him angry.\n");
  set_gender(1);
  set_level(25);
  set_n_ac(15);
  add_money(1000);
  clone_object("/players/tegerl/jabberwocky/obj/lance")->move_object(this_object());
  clone_object("/players/tegerl/jabberwocky/obj/shield")->move_object(this_object());
  command("powerup");
}
void init() {
  ::init();

  add_action("east", "east");
}
int east() {
  if (this_player()->query_level() < 30) {
    write("The guard blocks the way and says: " +
      "You are not allowed to enter.\n");
    return 1;
  }
}
