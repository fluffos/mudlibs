inherit "room/room";

reset(arg) {
  if (arg) return;
  ; : reset(arg);
  if (!present("stormtrooper")) {
    clone_object("players/sargon/monster/storm.lpc")->move_object(this_object());
  }

  set_light(1);
  short_desc = "A clean pure white room";
  long_desc = "You are on a smooth, flat and perfectly white square.To the north,\n" +
    "south and east you see a brown boarder and in the distance you see\n" +
    "a flat plane, it appears to be made up of black and white squares.\n" +
    "You also think you may see some imposing figures.  Maybe you should\n" +
    "go check it out.  To the west there is a brown boarder and a vast\n" +
    "void that appears to have no dimension.\n";





  dest_dir = ({


    "players/sargon/rooms/a3.lpc", "north",
    "players/sargon/rooms/b2.lpc", "east",
    "players/sargon/rooms/a1.lpc", "south",
    "players/sargon/rooms/b3.lpc", "northeast",
    "players/sargon/rooms/b1.lpc", "southeast",
    "players/sargon/rooms/void.lpc", "west"

  });






}
