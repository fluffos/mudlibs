#include "/players/qclxxiv/myroom.h"
object grabbit, gr2, gr3, gr4, gr5;
#undef EXTRA_RESET
#define EXTRA_RESET extra_reset(arg);

extra_reset(arg) {
  if (!grabbit) {
    grabbit = clone_object("players/qclxxiv/grabbit1");
    grabbit->move_object(this_object());
  }
  if (!gr2) {
    gr2 = clone_object("players/qclxxiv/grabbit3");
    gr2->move_object(this_object());
  }
  if (!gr3) {
    gr3 = clone_object("players/qclxxiv/grabbit1");
    gr3->move_object(this_object());
  }
  if (!gr4) {
    gr4 = clone_object("players/qclxxiv/grabbit3");
    gr4->move_object(this_object());
  }
  if (!gr5) {
    gr5 = clone_object("players/qclxxiv/grabbit1");
    gr5->move_object(this_object());
  }
  if (arg) return;
  items = ({ "tunnel", "A dark tunnel",
    "tunnels", "Dark tunnels"
  });
}

THREE_EXIT(
  "players/qclxxiv/leaf1/ghole2", "up",
  "players/qclxxiv/leaf1/ghole3", "west",
  "players/qclxxiv/leaf1/ghole5", "down",
  "A small dark grabbit hole",
  "You are in a small dark grabbit hole. Tunnels lead up, down and to west.\n"
  , 0)
