inherit "obj/monster";

reset(arg) {
  ::reset(arg);
  if (arg) return;
  set_name("salmon");
  set_alias("fish");
  set_level(8);
  set_short("A salmon");
  set_long("A salmon.  The filet makes a tasty soup.\n");
  set_no_steal(1);
  clone_object("players/emerald/lakmir/sfilet")->move_object(this_object());
}
