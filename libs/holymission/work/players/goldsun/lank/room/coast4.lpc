#define PPATH "/players/goldsun/lank/room/"

inherit "/players/goldsun/lank/room/genCoast";

object cottage;

reset(arg) {
  ::reset(arg);

  if (arg) return;

  "/players/goldsun/lank/obj/cott"->move_object(this_object());

  dest_dir = ({ PPATH + "coast3.lpc", "northwest",
    PPATH + "coast8.lpc", "southeast",
    PPATH + "lank2.lpc", "west",
    PPATH + "lank3.lpc", "south" });
}
