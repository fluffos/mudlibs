#define PPATH "/players/goldsun/lank/room/"

inherit "/players/goldsun/lank/room/genCoast2";

reset(arg) {
  ::reset(arg);
  dest_dir = ({ PPATH + "coast14.lpc", "northwest",
    PPATH + "coast13.lpc", "northeast",
    PPATH + "coast17.lpc", "south",
    PPATH + "forest4.lpc", "north" });
}
init() {
  ::init();
  add_action("g_north", "north");
}

g_north() {
  "/players/goldsun/lank/room/forest4"->add_exit("south");
  return ::move("north");
}
