
/* monksoul */
/* new: only joinable for humans and hobbits */

#define SKILLS  "/players/whisky/guild/skills/"
#define HELPDIR "/players/whisky/guild/help/"
#define _gm "/guild/master"
#define _partner "/players/warlord/guild/room"

/* prototyping */
fcn_skills(arg);
inherit "obj/armour";

#include "/obj/descs.h"
#include "lw.h"
#include "/players/whisky/guild/levels.h"
#include "/players/whisky/guild/titles.h"
#include "/players/whisky/guild/protectors.h"
#include "/players/whisky/guild/timer.h"
#include "/players/whisky/guild/extra_look.h"


int timer;
int g_status;
mixed call, out; /* direct adress operator for faster speed */

/* prototyping */
void timer_zero(string *arr);

void reset(int flag) 
{
  string col;
 
  if (objectp(environment()) && !interactive(environment()))
  {
      if (find_call_out("timer_zero"))
      {
          timer = 0;
          remove_call_out("timer_zero");
      }
  }

    ::reset(flag);
    if(flag == 0) 
    {
       call = (: call_other :); /* getting the adress of call_other */
       out = #'call_out;    /* getting the adress of call_out */
       set_name("belt");
       timer = 0;
       set_type("belt");   
       set_ac(1);
       set_long("The belt of the Monks.\n");
       set_weight(0); 
    }
}

int id(string arg)
{
  return arg == "belt" || arg == "monksoul";
}
   
int drop(string arg)
{ 
  return 1;
} 

int get()
{
   string x;
    if (this_player())
    {
   }
    return 1;
}


int remove(string arg) 
{
    if(id(arg)) 
    {
   	write("You can't remove your belt !\n");
	   return 1;
   }
   return 0;
}

void update_legends(int i)
{
   int lg_lev;

   if (evaluate(call,this_player(),"query_exp") > 2000000 &&
       evaluate(call,this_player(),"query_age") > 500000 && 
       evaluate(call,this_player(),"query_level") < 30 )
      {
         lg_lev = (evaluate(call,this_player(),"query_exp")/500000 - 3);
         if (lg_lev > 150)
             lg_lev = 150;
         evaluate(call,this_player(),"add_property","monk_legend",lg_lev);
         evaluate(out,"extra_title",1,this_player());
   }
}

void init() 
{
  object shad;
  int i, sz;
  string *skills, col;
  mixed act;

    ::init();

    if (environment()!=this_player()) 
        return;

    update_legends(0);
    /* setting the belt colours */
    switch(evaluate(call,this_player(),"query_level"))
    {
      case 1..3:   col = "white";  break;
      case 4..6:   col = "brown";  break;
      case 7..10:  col = "green";  break;
      case 11..14: col = "yellow"; break;
      case 15..18: col = "blue";   break;
      case 19..22: col = "red";    break;
      case 23..26: col = "silver"; break;
      default:     col = "golden"; break;
    }
     set_alias(col+" belt");
     set_short("A strong "+col+" belt");

    if (interactive(this_player()) && 
        !evaluate(call,this_player(),"query_immortal") )
         evaluate(out,"query_own_titles",1);

    if (member(PROTECTORS,evaluate(call,this_player(),"query_real_name"))==1)
       g_status = PROTECTORS[evaluate(call,this_player(),"query_real_name")];
    else
      g_status = 0;

    if (g_status > 0 && 
        evaluate(call,this_player(),"query_property","monk_legend") < 1)
    {
        evaluate(call,this_player(),"add_property","monk_legend",1); 
    }

    if (evaluate(call,this_player(),"combat_shad")!=1)
    {
        shad = clone_object("/players/whisky/guild/shadows/combat_shad");
        evaluate(call,shad,"start_shadow",this_player(),0,"combat_shad");
    }
    /* setting the fighting values */
    evaluate(call,this_player(),"recalc_fight");
    skills = m_indices(TIME);

    act = (: add_action :);

    evaluate(act,"fcn_help","help");
    evaluate(act,"fix","fix");

    for (sz = sizeof(skills),i = 0; i < sz; i++)
         evaluate(act,"fcn_skills",skills[i]);

    /* the skillsystem */
    evaluate(out,"load_skills",2,this_player());

    if (this_player() && interactive(this_player()))
        this_player()->force_me("wear belt");
}

int fcn_skills(string arg)
{
   if (timer == 1)
   {
       notify_fail("");
       return 0;
   }
   else 
   {
     timer = 1;
     if (TIME[query_verb()][2] > g_status)
     {
        write("Your guildstatus is too low for that feature !\n");
        timer = 0;
        return 1;
     }
     else if (TIME[query_verb()][0]==-1)
         timer_zero(({ query_verb(), arg }));
     else 
     {
         evaluate(out,"timer_zero",TIME[query_verb()][0],({ query_verb(), arg }));
         write(TIME[query_verb()][1]);
     }
     return 1; 
   }
}

void timer_zero(string *arr)
{
     if (stringp(arr[1]))
         evaluate(call,SKILLS+arr[0],arr[0],arr[1]);
     else 
         evaluate(call,SKILLS+arr[0],arr[0]);
     timer = 0;
} 

void fix()
{
     if (find_call_out("timer_zero"))
     {
         remove_call_out("timer_zero");
         timer = 0;
     }
     /* updating the legend level */
     update_legends(1);

     /* setting the fighting values */
     evaluate(call,this_player(),"recalc_fight");

    /* recalcing the legends for the combat shad */
     evaluate(call,this_player(),"update_values",this_player());

     /* checking bad armours */ 
     evaluate(call,this_player(),"fix_armours");

     /* checking if there is a weight bug */
     evaluate(call,this_player(),"update_weight");
     
     /* setting the heart beat again */
     evaluate(call,this_player(),"set_heart_beat",1);

     write("Ok.\n");
}
mixed fcn_help(string arg)
{
    if (!stringp(arg))
         return 0;
    else if (arg == "levels")
    {
         show_levels();
         return 1;
    } 
    else if (file_size(HELPDIR+arg) > 0) 
    {
         cat(HELPDIR+arg);
         return 1;
    }
  return 0;
}

void load_skills(object mob)
{
  if (!catch(evaluate(call,_partner,"???")) )
      evaluate(call,_partner,"list_skills",mob,0);
}

void extra_title(object mob)
{
     mob->set_title("Legend");
     return;
}

int query_monk_wear()
{
    return 1;
}

int query_guild_status()
{
    return g_status;
}

