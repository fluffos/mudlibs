inherit "/players/goldsun/green_island/room/genResidence";
#define PATH "/players/goldsun/green_island/room/"

reset(arg) {
  if (!arg) {
    clone_list = ({ 1, 1, "cyclops", "/players/goldsun/green_island/monster/cyclops", 0,
      1, 1, "corpse", "/players/goldsun/white_tower/obj/corpse.lpc", 0 });
    dest_dir = ({ PATH + "residence12", "south" });

  }

  ::reset(arg);
  replace_program("/room/room");
}
