/* monkline */

#include "defs.h"

int monk(string arg) {
  int i, sz, num, lv;
  object *u;
  string out;

  if (arg != "legends") {
    evaluate(call, _tp, "guild_line", arg);
    return 1;
  }
  u = users();
  num = 0;
  out = "\n";

  for (sz = sizeof(u), i = 0; i < sz; i++) {
    if (evaluate(call, u[i], "query_guild") == 7 &&
      (lv = evaluate(call, u[i], "query_property", "monk_legend")) > 0) {
      out = out + sprintf("%-15s %-17s %-17s\n",
        capitalize(evaluate(call, u[i], "query_real_name")),
        "Guildlevel: " + to_string(evaluate(call, u[i], "query_level")),
        "Legendlevel: " + to_string(lv));
      num = num + 1;
    }
  }
  if (num == 1)
    write("\n                1 Monk Legend online.\n\n");
  else
    write("\n                " + to_string(num) + " Monk Legends online.\n\n");
  write(out);
  return 1;
}
