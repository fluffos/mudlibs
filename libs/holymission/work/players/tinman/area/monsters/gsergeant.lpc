inherit "obj/monster";
object splate, lsword, helmet, boot;


reset(arg) {
  ::reset(arg);
  if (arg) return;
  set_name("green sergeant");
  set_alias("sergeant");
  set_short("A green Sergeant");
  set_long("A training officer that stayed with Sun Ce during the escape.\n" +
    " He is now set to built up Sun Ce's army and put him up as emperor. He does\n" +
    "not like strangers in the hideout.\n");
  set_level(26);
  set_gender(1);
  set_race("human");
  add_money(1400);
  set_wc(11);
  set_ac(5);
  set_number_of_arms(2);
  splate = clone_object("/players/tinman/area/armors/splate");
  splate->move_object(this_object());
  boot = clone_object("/players/tinman/area/armors/boot");
  boot->move_object(this_object());
  helmet = clone_object("/players/tinman/area/armors/helmet");
  helmet->move_object(this_object());
  lsword = clone_object("/players/tinman/area/weapons/lsword");
  lsword->move_object(this_object());
  command("powerup");
}
