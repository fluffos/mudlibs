#include "/players/tinman/defs.h"
inherit "room/room";

reset(arg) {
  if (!arg) {
    clone_object("/players/sherman/hills/dplate")->move_object(this_object());
    clone_object("/players/llort/secure/wscroll")->move_object(this_object());
    clone_object("/players/llort/secure/lwscroll")->move_object(this_object());
    clone_object("/players/padrone/obj/wizardshat")->move_object(this_object());
    clone_object("/players/llort/guild/obj/regring")->move_object(this_object());
    clone_object("/players/llort/guild/obj/regamulet")->move_object(this_object());
    clone_object("/players/whisky/obj/jeweled_earrings")->move_object(this_object());
    clone_object("/players/whisky/obj/ruby_bracelet")->move_object(this_object());
    clone_object("players/tinman/monsters/anica.lpc")->move_object(this_object());
    clone_object("/players/llort/animals_stuff/diring")->move_object(this_object());
    clone_object("/players/whisky/obj/tower_shield")->move_object(this_object());
    clone_object("/players/sherman/hills/fsword")->move_object(this_object());
    clone_object("/players/sherman/hills/crystal")->move_object(this_object());
    clone_object("/players/kawai/obj/orb.lpc")->move_object(this_object());
    clone_object("/players/kawai/obj/statue.lpc")->move_object(this_object());
    clone_object("/players/kawai/obj/qsword.lpc")->move_object(this_object());
    clone_object("/players/matt/newworld/forestb/objects/seed.lpc")->move_object(this_object());
    clone_object("/players/matt/newworld/forestb/objects/lifefruit.lpc")->move_object(this_object());
    clone_object("/players/matt/newworld/plains/monsters/old_dwarf.lpc")->move_object(this_object());
    clone_object("/players/airborne/weapons/hellfire.lpc")->move_object(this_object());
    clone_object("/players/llort/secure/girdle")->move_object(this_object());
    clone_object("/players/whisky/obj/red_bull_potion")->move_object(this_object());
    set_light(1);
    short_desc = ("Tinman's treasury room");
    long_desc = ("This is Tinman's treasury room.  He keep all his\n" +
      "valuable stuff here.  Don't even think about stealing\n" +
      "his stuff.  He will get very angry if you do.\n");

    dest_dir = ({
      "/players/tinman/workroom", "west",
    });
    hidden_dir = ({
      "/players/tinman/rooms/t", "priss",
    });

    property = ({
      "no_sneak", "no_steal",
    });
    smell = "you smell gold here.\n";
  }
}
init() {
  ::init();
  add_action("blah", "blah");
  add_action("blah2", "blah2");
}
blah() {
  object ob;
  ob = clone_object("/players/airborne/obj/badge.lpc");
  transfer(ob, this_player());
  write("You get a badge.\n");
  return 1;
}
