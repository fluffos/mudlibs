inherit "room/room";
#include "../asgard.h"

reset(int arg) {
  object monster;
  ::reset(arg);
  if (!arg) {
    set_light(1);
    short_desc = "DON'T UPDATE THIS ROOM PLEASE....",
      long_desc = "The secret heartbeat room.....\n";

    no_obvious_msg = "";
    set_heart_beat(1);

    monster = find_living("jukie");

    if (!monster) {
      tell_room("/players/beardy/workroom", "Jukie start clone.\n");
      clone_object(MONST + "jukie")->move_object(ROOM + "asg025");
      clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
      clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
      clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
    } else {
      if (environment(monster) == 0) {
        tell_room("/players/beardy/workroom", "Jukie new clone.\n");
        clone_object(MONST + "jukie")->move_object(ROOM + "asg025");
        clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
        clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
        clone_object(MONST + "berzerker")->move_object(ROOM + "asg025");
      }
    }
  }
}


void heart_beat() {
  object monster;

  monster = find_living("jukie");
  switch (random(10)) {
    case 1: monster->force_me("west"); break;
    case 2: monster->force_me("north"); break;
    case 3: monster->force_me("east"); break;
    case 4: monster->force_me("south"); break;
    case 5: monster->force_me("northwest"); break;
    case 6: monster->force_me("northeast"); break;
    case 7: monster->force_me("southeast"); break;
    case 8: monster->force_me("southwest"); break;
  }
}
