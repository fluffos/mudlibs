inherit "obj/thing";

reset(arg) {
  ::reset(arg);
  if (!arg) {
    set_name("slave");

    set_short("directory slave");
    set_long("Say to and the dir\n");

  }
}

init() {
  add_action("to", "to");
  ::init();
}

to(str) {
  switch (str) {
    case ".p": this_player()->force_me("cd/player"); break;
    case ".p.b": this_player()->force_me("alias slave cd /players/beardy");
    this_player()->force_me("slave");
    break;
    case ".p.w": this_player()->force_me("/sys/cd /player/whisky"); break;
    default: write("No such dir saved.\n");
  }
  return 1;
}
