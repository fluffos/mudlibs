#include "/players/aaa/defs.h"

inherit "room/room";

void reset(int arg) {
  ::reset(arg);
  if (arg) return;
  set_light(1);
  short_desc = "unfinished room";
  long_desc = "unfinished room\n";
  dest_dir = ({ PA + "stown/road6.lpc", "east" });
  items = ({});
}

void init() {
  ::init();
}
