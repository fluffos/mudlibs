#include "/players/aaa/defs.h"
#include <std.h>

inherit "room/room";

void reset(int arg) {
  ::reset(arg);
  if (arg) return;
  set_light(1);
  short_desc = "unfinished room";
  long_desc = "unfinished room\nRoad to Berovang city.\n";
  dest_dir = ({ PA + "stown/road6.lpc", "north",
    "/room/jetty2.lpc", "south" });
  items = ({});
}

void init() {
  ::init();
}
