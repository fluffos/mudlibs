items ({({"windows","Beautiful stained glass windows of all colors and sizes","scales","The draongs these scales came off of must have been HUGE",}),({"sign","The sign reads: \"Welcome to the Thieve's Den\"",}),({"ball","You see yourself moving around the room in the picture!  Must be security.",}),({"cook","The cook looks at you and says: \"Dinner isn't for another 1/2 hour!\"",}),({"china","A wonderous set of china, enough to feed over 100 people from the looks of it",}),0,0,0,0,0,})
