items ({0,({"asztal","Egy kis faasztal a fal mellet par papirral, tollal es ceruzaval","allvany","Egy femvazas, uveglapu telefonasztalka telefonnal es Arany oldalak telefonkonyvvel","tukor","Egy embermagas, faragott diofa keretu hibatlan XVIII. sz.-i velencei tukor","kep","Munkacsy Mihaly egyik csodalatos kepe, a Majalis",}),0,({"kert","Egy gyonyoru viragoskert","agy","Egy hatalmas franciaagy","talalo","Egy gyonyoru, mult szazadi diofa talalo","barszekreny","Egy italszekreny, a legjobb italokkal, es egy jegtaroloval","viragallvany","Egy magas rud, melynek \"karjain\" levo cserepekben kulonfele futok vannak","kepek","Ket eredeti Csontvary Kosztka Tivadar alkotas","kilatas","Egyszeruen lelegzetelallito **",}),0,0,0,0,0,({"Table","A big, elegant, brown table, from mahagoni.","Chair","Nice, comfortable chairs, with mahagoni too.",}),})
