items ({({"vesak","Vyrezavany vesak ve tvaru devitihlaveho draka.","koberec","Koberec s hustym vlasem. Je na nem vysita Krasna naha divka (blondyna)","botnik","Mala drevena skrinka, do ktere se ukladaji boty",}),0,0,({"regal","Police sahaji od podlahy az ke stropu. Jsou zaplneny ruznym harampadim",}),({"roh","Pri blizsim pohledu uz vis co tu smrdi - zvratky od posledni parby",}),0,0,0,0,0,})
