items ({({"cliffs","You feel the majesty of these age old cliffs as you look up","rubble","The home of a few scurrying mice.","door","A strong steel door","sign","It reads, \"Landbase 6 ... Unauthorized entry will be prosecuted\"","terminal","A small, square plate with a hand print on it. A voice analyzer makes up the top of it","path","A untrodden walkway, with a few desert plants growing along side",}),({"spouts","For the saftey of the colony, detoxins are sprayed trough these","walls","Bare walls that are evenly covered with small holes.","floor","A mat of strong steel wire, allowing the escape of the gasses","door","Which door do you want to look at?","south door","A steel door, securely shut","west door","A steel door, with a large '6' written on it",}),({"ambassador","A friendly man, who welcomes you with a warm smile","terminals","Many food and beverage replicators, they provide just about anything you'd like","chairs","Comfortable leather chairs, with the symbol of the colony on them","couches","Leather couches that can seat five people. The mark of the colony decorates these couches","stools","Expertly carved stools with leather tops, perfect for anyone to sit on","lobby","Hundreds of people walk across this room chatting and enjoying themselves",}),({"couch","Four very large couches with the symbol of the colony on them.","table","A computerized entertainment center with a large triangle in the center of it","terminals","More food and beverage terminals","sign","The sign reads. \"Respect\"","sign","The sign reads, \"Respect\"","*","",}),0,0,0,0,0,0,})
