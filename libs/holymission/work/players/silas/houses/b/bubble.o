items ({({"house","A white house made from stone.","flowers","Many blooming flowers in all colours !","stones","They are white and look great.",}),({"lamps","That are big crystallic lamps which looks quite expencive.","lamp","Just a big crystallic expencive lamp.",}),({"stuff","It is magic stuff like staffs powder in all colours","table","A big black table made from wood.","pictures","Some pictures of magic symbols","symbols","Quite a lot of symbols with magic look.","picture","There are many !","symbol","There are more than one !",}),({"table","The eating table of Bubble..","window","You can see many flowers out there.","room","A wonderfull lighted room.",}),({"mirrors","You can see yourself in each of them.","mirror","Just a big mirror made from glass",}),({"musicers","They are good musicers.",}),({"bed","A big bed... Lets sleep !","table","A table with books on it.","window","You can see many flowers and trees from here.","bookshelf","A big bookshelf with many books on it.","book","There are more than one.",}),({"bottle","A bottle full of water.","stuff","Many canes and other things...","oven","It seems there is a pizza in it.",}),0,({"dolls","Some little lovely dolls.","mazes","Realy hard mazes.","puzzles","Puzzles with 2, 20, 200 and 2000 pieces.","books","Books about the life and other interesting things.","bookshelf","A bookshelf full with books",}),})
