items ({({"glow","A enigmatic red glow which is emitted by something in the hallway south of you","house","Having examined it so far, it looks quite agreeable :-)",}),({"floor","WOW! You see yourself","wall","All black in black except of the glowing sign","sign","The brightly glowing sign bans your look for a while","lamp","The lamp is closed. You can't exactly see the light source","ceiling","Black in black",}),({"ceiling","Painted black and covered by the blue-glowing pentagram","pentagram","A perfectly regular pentagram emitting a soft blue glow","floor","As reflecting as the one in the first hallway","walls","Black like the night","","**",}),0,0,0,0,0,0,0,})
