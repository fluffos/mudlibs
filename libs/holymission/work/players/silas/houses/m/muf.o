items ({0,({"statue","Big golden statue of Tomas & Magick ","fountain","Nice ancient fountain with beer in it. (Budweiser)",}),({"bar","Muf's self-serviced bar.","fridge","Great fridge from U.K.","medikit","First aid for drunked people","armchair","Comfortable soft armchair inviting you sit here",}),({"bed","Big double bed inviting you jump in and ...","statue","Small statue. It is Muf and watching you !!","picture","empty frame waiting for his wife",}),({"armchair","Very comfortable looking armchair inviting you to rest in.","flower","Big meat-eating flowers. (It's watching you !!)","statue","Gold statue - Muf & Elmo in bedroom     (c) Muf 1993",}),({"machine","Slot machine with big lever.","picture","Robert Smith's photography with autogram. (He love his songs)",}),0,0,0,0,})
