items ({0,({"picture","small picture of Lukin, ugly adventure",}),({"window","opened window leading to lake","statue","Obiwan Kenobi in real size","carpet","softly persian carpet",}),({"barrels","some kind of wine barrels used for storage of wine","cheese","nothing interested, normal Aidam","bottle","empty bottle made from glass","bread","old bread, maybe you will can use that as stone","table","wooden table with many scars","cellar","very anciently",}),({"tv","colour Tv, going some serial","videorecorder","japanesse Toshiba, given from Muf","cougch","ageeable soft with panther's fur","table","small wooden with some glass of whisky","pictures","Raphael Santi, Leonardo da Vinci and Salvator Dali","fireplace","made from red bricks, on ledge is Troll skull","clock","typical Czech \"cuckoo\" clock",}),({"bed","ancient bed made from oak with bear's fur","picture","marriage photo Tomas & Magick","aquarium","sferical aquarium with some bones and pirania","carpet","persian's carpet",}),({"walls","northern and eastern are made from glass","lake","full of water","junks","sailing on the lake, maybe belongs to villagers","fur","bear's fur","floor","covered by bear's fur","bed","ancient bed for two people","aquarium","sferical aquarium with water, some bones and pirania","table","wooden with aquarium","photo","wedding photo Tomas & Magick","frame","really golden",}),({"house","white, builded on rocky ledge","ledge","rocky ledge raising from the lake","lake","dark and full water, on the shore is some village","people","villagers fishing on the shore","shore","some people are on","castle","dark castle of evil necromancer","village","about 10 houses","smoke","raising from the village","path","path connecting Tomas's house with shore of lake","table","wooden table, nothing interested","chairs","using for sitting",}),0,0,})
