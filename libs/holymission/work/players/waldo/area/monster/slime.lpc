inherit "obj/monster";
object money_ob;
reset(arg) {
  ::reset(arg);
  if (!arg) {
    set_name("slime");
    set_race("ooze");
    set_short("Big black slime");
    set_long("This is some big black slime with big spikes coming out of it.\n");
    set_alias("slime");
    set_level(2 + random(8));
    set_al(-23);
    money_ob = clone_object("obj/money.lpc");
    money_ob->set_money(query_level(this_object()) * 75);
    money_ob->move_object(this_object());
  }
}
