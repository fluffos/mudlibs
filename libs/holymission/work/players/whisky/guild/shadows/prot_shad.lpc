/* prot_shad */

inherit "/players/whisky/obj/std_shadow";

string friend;
object fobj;


mixed attack() {
  object feind;

  feind = evaluate(call, me, "query_attack");

  if (friend && fobj && living(fobj) && environment(me) == environment(fobj)
    && !objectp(evaluate(call, fobj, "query_attack"))) {
    fobj->force_me("rescue " + evaluate(call, me, "query_real_name"));
    if (fobj && feind)
      evaluate(call, fobj, "attack_object", feind);
  }
  return evaluate(call, me, "attack");
}

int prot_shad() {
  return 1;
}

object prot_object() {
  return this_object();
}

void set_protected(string fr) {
  friend = fr;
}

string query_protected() {
  return friend;
}

void set_protector(object o) {
  fobj = o;
}

object query_protector() {
  return fobj;
}
