inherit "obj/monster";
object money_ob;
void reset(int arg) {
  ::reset(arg);
  if (!arg) {
    set_name("rat");
    set_race("rat");
    set_aggressive(1);
    set_short("A red rat");
    set_long("A big red rat, with yellow piercing eyes.\n");
    set_alias("rat");
    set_level(15);
    set_al(-15);
    set_ac(6);
    set_wc(16);
    money_ob = clone_object("obj/money.lpc");
    money_ob->set_money(50);
    transfer(money_ob, this_object());
  }
}
