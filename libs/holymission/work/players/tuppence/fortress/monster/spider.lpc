inherit "obj/monster";
object money_ob;
void reset(int arg) {
  ::reset(arg);
  if (!arg) {
    set_name("Silver spider");
    set_race("spider");
    set_short("Silver spider");
    set_long("A big silver spider, watch out he looks mean.\n");
    set_alias("spider");
    set_level(17);
    set_al(-200);
    set_ac(8);
    set_wc(17);
    money_ob = clone_object("obj/money.lpc");
    money_ob->set_money(800);
    transfer(money_ob, this_object());
  }
}
