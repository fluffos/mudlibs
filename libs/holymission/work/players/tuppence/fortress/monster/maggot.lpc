inherit "obj/monster";
object money_ob;
void reset(int arg) {
  ::reset(arg);
  if (!arg) {
    set_name("maggot");
    set_race("bug");
    set_short("Maggot");
    set_long("A large maggot sits here.\n");
    set_alias("maggot");
    set_level(20);
    set_al(-300);
    set_ac(10);
    set_wc(25);
    money_ob = clone_object("obj/money.lpc");
    money_ob->set_money(500);
    transfer(money_ob, this_object());
  }
}
