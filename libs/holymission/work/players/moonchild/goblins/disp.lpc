object g1, g2, g3, g4;

make() {
  if (!g1) g1 = clone_object("players/moonchild/goblins/goblin")->move_object("room/south/sforst1");
  if (!g2) g2 = clone_object("players/moonchild/goblins/goblin")->move_object("room/forest7");
  if (!g3) g3 = clone_object("players/moonchild/goblins/goblin")->move_object("room/forest8");
  if (!g4) g4 = clone_object("players/moonchild/goblins/redgob")->move_object("room/mine/tunnel20");
}
more() { call_out("make", 300, 0); }
