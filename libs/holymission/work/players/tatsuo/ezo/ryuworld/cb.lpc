#define PPATH     "/players/tatsuo/ezo/ryuworld/"

inherit PPATH + "genCave";

reset(arg) {
  ::reset(arg);

  if (!present("kojin", this_object())) {
    clone_object("/players/tatsuo/eastMonst/kojin")->move_object(this_object());
    if (random(2))
      clone_object("/players/tatsuo/eastMonst/kojin")->move_object(this_object());
  }

  if (arg)
    return;

  dest_dir = ({ PPATH + "cc", "east",
    PPATH + "ca", "west"
  });
}
