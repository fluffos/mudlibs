inherit "/obj/std_shop";

#include "/players/tatsuo/area/tatsuo_defs.h"
int x;
void reset(int flag) {
  ::reset(flag);
  short_desc = "The Merchant's Tent";
  long_desc = "A small tent with objects cluttered around the room.\n" +
    "You can buy and sell items here.\n" +
    "Commands are:\n" +
    "  'list', 'buy <num>', 'buy <item>', 'sell <item>', \n" +
    "          'sell <all>', 'value <item>'.\n";
  store = "/players/tatsuo/area/forest1/shop_store.lpc";
  keeper = "A burly merchant";
  dest_dir = ({ F1PATH + "road6.lpc", "south",
    F1PATH + "forest9.lpc", "north",
    F1PATH + "forest6.lpc", "east" });
  if (!present("torch", query_store())) {
    for (x = 0; x < 5; x++) {
      clone_object("/players/whisky/obj/torch")->move_object(query_store());
    }
  }
  /*
    if (!present("matchbox",query_store()))
    {
        for(x=0;x<3;x++)
        {
            clone_object("/players/whisky/obj/matchbox")->move_object(query_store());
        }
     }
    if (!present("snare",query_store())) {
        for(x=0;x<3;x++)
        {
            clone_object("/players/tatsuo/guild/obj/snare")->move_object(query_store());
        }
   }
*/

  if (!present("trashcan", this_object()))
    clone_object("players/whisky/shops/trashcan")->move_object(this_object());
}
