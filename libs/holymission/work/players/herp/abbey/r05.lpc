#include "abbey.h"
inherit "room/room";

reset(arg) {
  object ob;
  if (!arg) {
    set_light(1);
    short_desc = "The Library";
    long_desc = "You seem to have entered the library.\n" +
      "There are many books here, lying in tumbled heaps.\n";
    dest_dir = ({ PATH + "/r02", "north",
      PATH + "/r08", "south",
      PATH + "/r04", "east",
      PATH + "/r06", "west" });
  }
  if (!present("book")) {
    ob = clone_object("obj/treasure");
    ob->set_name("book");
    ob->set_alias("red book");
    ob->set_short("A red book");
    ob->set_value(15);
    ob->move_object(this_object());
    ob = clone_object("obj/treasure");
    ob->set_name("book");
    ob->set_alias("blue book");
    ob->set_short("A blue book");
    ob->set_value(10);
    ob->move_object(this_object());
    ob = clone_object("obj/treasure");
    ob->set_name("book");
    ob->set_alias("black book");
    ob->set_short("A dark black book");
    ob->set_value(200);
    ob->move_object(this_object());
  }
}
