inherit "room/room";

object obj;

reset(arg) {
  if (arg) return;
  set_light(0);
  no_castle_flag = 1;
  short_desc = "In a cell";
  long_desc = "You're in a cell. There's no opening here except the door to the south.\n";
  items = ({
    "door", "No chance to move it",
  });
  if (!obj) {
    obj = clone_object("obj/monster");
    obj->set_name("rat");
    obj->set_race("rat");
    obj->set_size(2);
    obj->set_level(2);
    obj->set_short("A rat");
    obj->set_long("A dirty rat.\n");
    obj->add_money(random(10) + 5);
    obj->set_aggressive(1);
    obj->move_object(this_object());
  }
}

init() {
  ::init();
  add_action("south", "south");
}

south() {
  if (!"players/bobo/krooms/castel/dungeon1"->query_lever_up())
    this_player() move_player("north#players/bobo/krooms/castle/dungeon3");
  else {
    write("The cell-door is locked!\n");
    say(this_player()->query_name() + " tries to go south, but runs " +
      "straight into the door.\n");
  }
  return 1;
}
