inherit "obj/armour";

// A wearable container.  It used to inherit obj/container before obj/armour,
// which gave it two copies of every item variable and made ::reset()/::init()
// reach only the container's (armour's reset never ran).  The few container
// functions it needs are here instead.
int max_weight, local_weight, pack_light;

int query_container() { return 1; }
int query_open() { return 1; }
int can_put_and_get(mixed a) { return 1; }
int query_max_weight() { return max_weight; }
void set_max_weight(int w) { max_weight = w; }
int update_weight(int w) { return w; }

void recalc_light_level() {
  int new_level, i;
  object *all;

  all = all_inventory(this_object());
  for (i = 0; i < sizeof(all); i++) new_level -= all[i]->query_arm_light();
  set_light(new_level - pack_light);
  pack_light = new_level;
}

int add_weight(int w) {
  if (local_weight + w > max_weight) return 0;
  local_weight += w;
  call_out("recalc_light_level", 1);
  return 1;
}

int prevent_insert() {
  if (local_weight > 0) {
    write("You can't when there are things in the " + query_name() + ".\n");
    return 1;
  }
  return 0;
}

void reset(int arg) {
  ::reset(arg);
  if (arg) return;
  set_name("backpack");
  set_alias("pack");
  set_max_weight(30);
  set_short("A backpack");
  set_long(
    "A big backpack.  There are straps, pockets, loops, and pouches " +
    "all over it.  It looks like it could carry a lot of stuff.  You " +
    "also notice that there are shoulder straps, perhaps you could wear " +
    "it!\n");
  set_type("other");
  set_ac(0);
  set_value(150);
  set_weight(1);
}
int no_clear() {
  return 1;
}
void init() {
  ::init();
  add_action("wear", "wear");
}
