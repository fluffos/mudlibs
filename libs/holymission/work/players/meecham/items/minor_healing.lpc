#define HP this_player()->query_hp()
#define MHP this_player()->query_max_hp()

inherit "obj/treasure";

void reset(int arg) {
  set_id("potion");
  set_short("Potion of minor healing");
  set_long("This is a potion of minor healing, drink or quaff it.\n");
  set_value(0);
  set_weight(1);
}

void init() {
  ::init();
  add_action("_drink", "drink");
  add_action("_drink", "quaff");
}

int _drink(string str) {
  if (!str || str != "potion") return (0);
  write("You quaff a potion of minor healing.\n");
  this_player()->reduce_hit_point(-200);
  if (HP > MHP)
    this_player()->reduce_hit_point(HP - MHP);
  say(this_player()->query_name() + " quaffs a potion of minor healing.\n");
  destruct(this_object());
  return (1);
}
