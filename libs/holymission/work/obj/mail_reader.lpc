/*---------------------------------------------------------------*/
/* Mangla: Added forwarding and cleaned up the code.             */
/* Sauron: Added arches and sheriffs mailing lists.              */
/*---------------------------------------------------------------*/

#include "/sys/arches.h"
#include "/sys/sheriffs.h"

#define NAME "room/post_dir/"

string        messages;      /* The big string of all messages. */
int           new_mail;      /* Flag if there is any new mail. */
int           fwd_mess;      /* is this a fowarded message or not. */

nosave string *arr_messages;  /* the result of explode on 'messages' */
nosave int    loaded;        /* Flag if this users mailbox is loaded */
nosave int    curr_mess;     /* Current message number */
nosave string new_message,
              new_subject,
              new_dest,
              new_cc;

nosave int    is_reading;

int id(string str) {
  return str == "mailread";
}

int get() {
  return 1;
}

void init() {
  add_action("read", "read");
  add_action("mail_to", "mail");
  add_action("headers", "from");
  return;
}

int player_exists(string name) {
  return restore_object("/p/"+name[0..0]+"/"+name);
}

string resolve_list(string list) {
  string *ret;

  ret=({});
  switch(list) {
    case "sheriffs":
      ret+=SHERIFFS;
      ret+=ARCHES;
      break;
    case "arches":
      ret+=ARCHES;
      break;
    case "mentees":
      if(this_player()->query_wizard()) {
        ret+=this_player()->query_mentees();
        ret+=({this_player()->query_real_name()});
      }
      else
        return (string)0;
      break;
    default:
      return (string)0;
      break;
  }
  return implode(ret," ");
}

int valid_list(string list) {
  if(list=="mentees" && this_player()->query_wizard()
                     && sizeof(this_player()->query_mentees()))
    return 1;
  else
    return list=="arches" || list=="sheriffs";
}

void load_player() {

  loaded = 1;
  if (!restore_object(NAME + this_player()->query_real_name()) ||
    messages == "" || messages == 0) {
    arr_messages = 0;
    messages = "";
    return;
  }
  if (new_mail) {
    new_mail = 0;
    save_object(NAME + this_player()->query_real_name());
  }
  arr_messages = explode(messages, "\n**\n") - ({""});
  return;
}

int headers() {

  int i, n;
  string tmp_str, tmp_str2, rest_of_mess;
  string header_list;
  string name;

  if (!loaded)
    load_player();
  if (arr_messages == 0) {
    write("No mail.\n");
    return 1;
  }
  header_list="";
  for (i=0; i < sizeof(arr_messages); i+=2) {
    name = i/2+1 + " " + arr_messages[i];
    if (strlen(name) < 8)
      name += "\t";
    header_list+=name + "\t";
    n = sscanf(arr_messages[i+1],"%sRe:   %s\n%s",
           tmp_str,tmp_str2,rest_of_mess);
    if (n == 3) header_list+=" Re:   " + tmp_str2;
    n = sscanf(arr_messages[i+1],"%sSubj: %s\n%s",
           tmp_str,tmp_str2,rest_of_mess);
    if (n == 3) header_list+=" Subj: " + tmp_str2;
    n = sscanf(arr_messages[i+1],"%sDate: %s\n%s",
           tmp_str,tmp_str2, rest_of_mess);
    if (n == 3) header_list+=" Date: " + tmp_str2;
    header_list+="\n";
    if(strlen(header_list)>800) {
        write(header_list);
        header_list="";
    }
  }
  write(header_list);
  return 1;
}

void loop() {

  string tmp;

  if (!loaded)
    load_player();
  if (arr_messages == 0) {
    write("No messages.\n");
    is_reading = 0;
    return;
  }
  if (curr_mess < 1 || curr_mess > sizeof(arr_messages)/2)
    tmp = " (no current) ";
  else
    tmp = " (current: " + curr_mess + ") ";
  write("[1 - " + (sizeof(arr_messages)/2) + " h d r x p n f - ?]" + tmp);
  input_to("get_cmd");
  return;
}

int read() {

  is_reading = 1;
  if (!loaded) {
    load_player();
    if (arr_messages == 0) {
      write("No mail.\n");
      return 1;
    }
  }
  loop();
  return 1;
}

int too_many() { /* Moonchild 021192 */

  if((!this_player()->query_immortal()
                && sizeof(arr_messages)>60)
                || (!this_player()->query_archwiz()
                && sizeof(arr_messages)>200)
                || (this_player()->query_archwiz()
                && sizeof(arr_messages)>400)) {
    write("You have too many messages. You must delete some before "
          "quitting mail.\n");
    is_reading=1;
    loop();
    return 0;
  }
  if(sizeof(arr_messages))
    write("Messages saved .... but don't let too many pile up.\n");
}

void print_message() {

  if (curr_mess > sizeof(arr_messages)/2 || curr_mess < 1) {
    write("Illegal message number " + curr_mess + "\n");
    return;
  }
  write("Message " + curr_mess + ":\n");
  write("From: " + arr_messages[curr_mess*2-2] + "\n");
  write(arr_messages[curr_mess*2-1] + "\n");
  return;
}

void save_message() {

  string name;

  if (curr_mess > sizeof(arr_messages)/2 || curr_mess < 1) {
    write("Illegal message number " + curr_mess + "\n");
    return;
  }
  name = this_player()->query_real_name() + ".mbox";
  log_file(name, "From: " + arr_messages[curr_mess*2-2] + "\n");
  log_file(name, arr_messages[curr_mess*2-1] + "\n");
  return;
}

void delete() {

  if (curr_mess > sizeof(arr_messages)/2 || curr_mess < 1) {
    write("Illegal message number " + curr_mess + "\n");
    return;
  }
  arr_messages[curr_mess*2-2] = 0;
  arr_messages[curr_mess*2-1] = 0;
  if (sizeof(arr_messages) == 2)
    messages = "";
  else
    messages = implode(arr_messages, "\n**\n") + "\n**\n";
  new_mail = 0;
  save_object(NAME + this_player()->query_real_name());
  if (messages == "")
    arr_messages = 0;
  else
    arr_messages = explode(messages, "\n**\n") - ({""});
  return;
}

int mail_to_continue(string str) {

  str = lower_case(str);
  if(!valid_list(str) && !player_exists(str)) {
    write("No such player.\n");
    if (is_reading)
      loop();
    return 1;
  }
  new_dest = str;
  if(fwd_mess) {
    new_message = arr_messages[curr_mess*2-1];
    write("Cc: ");
    fwd_mess = 0;
    input_to("get_cc");
    return 1;
  }
  new_message = "";
  if (new_subject)
    write("Hit return to get '" + new_subject + "'\n");
  write("Subject: ");
  input_to("get_subject");
  return 1;
}

int mail_to(string str) {

  if (!str || str == "") {
    write("No destination.\n");
    if (is_reading)
      loop();
    return 1;
  }
  new_subject = 0;
  new_cc = "";
  mail_to_continue(str);
  return 1;
}

void get_subject(string str) {

  if (str && str != "")
    new_subject = "Subj: " + str + "\n";
  if (new_subject == 0) {
    write("No subject.\n");
    if (is_reading)
      loop();
    return;
  }
  write("Give message.  Finish message with '**', or '~q' to cancel\n");
  write("]");
  input_to("more_mail");
  return;
}

void more_mail(string str) {
  if (str == "~q") {
    write("Aborted.\n");
    if (is_reading)
      loop();
    return;
  }
  if (str == "**") {
    write("Cc:");
    input_to("get_cc");
    return;
  }
  new_message += str + "\n";
  write("]");
  input_to("more_mail");
  return;
}

void notify_new_mail(string dest,
                     string subj,
                     string name) {

  object ob;

  write("Sending mail to " + capitalize(dest) + ".\n");
  if (ob = find_player(dest)) {
    tell_object(ob,"You have new mail from " +
          this_player()->query_real_name() + ", " + subj + "\n");
    ob = present("mailread", ob);
    if (ob)
      ob->invalidate();
  }
  return;
}

/*
 * Send a complete mail. If the receiver is reading mail, be sure to
 * tell his mail reader that new mail has arrived.
 */
void send_mail_to(string dest,
                  string to,
                  string subj,
                  string mess,
                  string cc) {

/* HERP */
  if(!player_exists(dest)) {
     write("Illegal mail destination ("+dest+").\n");
     return;
  }

  if(cc!="")
    cc="Cc: "+cc+"\n";
  notify_new_mail(dest, subj, this_player()->query_name());
  messages = "";
  restore_object(NAME + dest);
  if (messages == 0)
    messages = "";
  messages += this_player()->query_real_name() + "\n**\nTo: " +
              to + "\n" + subj + cc + "Date: " +
              extract(ctime(time()), 4, 9) + "\n\n" + mess + "\n**\n";
  if(this_player()->query_real_name()=="guest")
    write_file("/log/guest.mail", this_player()->query_real_name() +
                                  " [" + query_ip_number(this_player()) +
                                  "]\n" + "To: " + to + "\n" + subj +
                                  cc + "Date: " +
                                  extract(ctime(), 4, 9) +
                                  "\n\n" + mess + "\n**\n");
  new_mail = 1;
  save_object(NAME + dest);
  return;
}

void send_mail(string dest,string to,string subj,string mess,string cc) {
  string list,*arr;
  int i;

  if(valid_list(dest)) {
    list=resolve_list(dest);
    arr=explode(list," ");
    if(dest==to && strstr(cc,dest)==-1) {
      if(cc=="")
        cc=dest;
      else
        cc=dest+", "+cc;
    }
    for(i=0;i<sizeof(arr);i++)
      send_mail_to(arr[i],(dest==to?arr[i]:to),subj,mess,cc);
  }
  else
    send_mail_to(dest,to,subj,mess,cc);
}

void get_cc(string cc) {
// Rewritten Moonchild 121092 to allow multiple cc's
// Increased flexibility Moonchild 271092 & 021192
  string *cc_to;
  int i;

  if(!cc || cc=="")
    send_mail(new_dest,new_dest,new_subject,new_message,"");
  else {
    send_mail(new_dest,new_dest,new_subject,new_message,cc);
    cc=implode(explode(cc,",")," ");
    cc_to=explode(cc," ");
    cc_to=filter_array(cc_to,lambda(({'str}),({#'>,({(: strlen :),'str}),0})));
    cc=implode(cc_to,", ");
    for(i=0;i<sizeof(cc_to);i++) {
      if(!cc_to[i] || cc_to[i]=="")
        continue;
      else if(!valid_list(cc_to[i]) && !player_exists(cc_to[i]))
        write("Illegal mail destination ("+cc_to[i]+").\n");
      else
        send_mail(cc_to[i],new_dest,new_subject,new_message,cc);
    }
  }

  if(is_reading)
    loop();
  return;
}

void invalidate() {
  loaded = 0;
  return;
}

int drop() {
  return 1;
}

void forward_message(string str) {
  string tmp_str, tmp_str2, rest_of_mess;
  string name;
  int n;

  name=str;
  n=sscanf(arr_messages[curr_mess*2-1],"%sRe:   %s\n%s",
           tmp_str,tmp_str2,rest_of_mess);
  if(n!=3) n=sscanf(arr_messages[curr_mess*2-1],"%sFwd:  %s\n%s",
                    tmp_str,tmp_str2,rest_of_mess);
  if(n!=3) n=sscanf(arr_messages[curr_mess*2-1],"%sSubj: %s\n%s",
                    tmp_str,tmp_str2,rest_of_mess);
  new_subject="Fwd:  "+tmp_str2+"\n";
  new_cc="";
  fwd_mess=1;
  mail_to_continue(name);
  return;
}

void reply_to_message() {
  string tmp_str, tmp_str2, rest_of_mess;
  string name;
  int n;

  name=lower_case(arr_messages[curr_mess*2-2]);
  n=sscanf(arr_messages[curr_mess*2-1],"%sRe:   %s\n%s",
           tmp_str,tmp_str2,rest_of_mess);
  if(n!=3) n=sscanf(arr_messages[curr_mess*2-1],"%sFwd:  %s\n%s",
                    tmp_str,tmp_str2,rest_of_mess);
  if(n!=3) n=sscanf(arr_messages[curr_mess*2-1],"%sSubj: %s\n%s",
                    tmp_str,tmp_str2,rest_of_mess);
  new_subject="Re:   "+tmp_str2+"\n";
  new_cc="";
  mail_to_continue(name);
  return;
}

int help_msg() {
  write("\
x        Exit from mail reading mode.\n\
d        Delete the current message.\n\
d <num>  Delete message number 'num'.\n\
?        This help message.\n\
r        Reply to the current message.\n\
r <num>	 Reply to message number 'num'.\n\
f <name> Forward the current mesage to <name>.\n\
m <name> Mail a message to <name>.\n\
h        Print all headers.\n\
p        Print previous message.\n\
n        Print next message.\n\
l        Append the current message to '/log/"
+this_player()->query_real_name()+".mbox'.\n");
  return 1;
}

void get_cmd(string str) {

  int      n, new_has_arrived;
  string   tmp;

/*
 * First, test all nondestructive commands. The destructive commands
 * will be tested after check if new mail has arrived.
 */
  if (!loaded) {
    load_player();
    new_has_arrived = 1;
  }
  if (str == "r") {
    reply_to_message();
    return;
  }
  if (sscanf(str, "f %s", tmp) == 1) {
    forward_message(tmp);
    return;
  }
  if (sscanf(str, "r %d", curr_mess) == 1) {
    reply_to_message();
    return;
  }
  if (str == "h") {
    headers();
    loop();
    return;
  }
  if (str == "n") {
    curr_mess++;
    print_message();
    loop();
    return;
  }
  if (str == ".") {
    print_message();
    loop();
    return;
  }
  if (str == "l") {
    save_message();
    loop();
    return;
  }
  if (sscanf(str, "m %s", tmp) == 1) {
    mail_to(tmp);
    return;
  }
  if (str == "?") {
    help_msg();
    loop();
    return;
  }
  if (str == "p" || str == "-") {
    curr_mess--;
    print_message();
    loop();
    return;
  }
  if (sscanf(str, "%d", n) == 1) {
    curr_mess = n;
    print_message();
    loop();
    return;
  }
  if (new_has_arrived) {
    write("New mail has arrived. Command ignored\n");
    loop();
    return;
  }
  if (str == "x") {
    is_reading = 0;
    too_many();
    return;
  }
  if (str == "d") {
    delete();
    loop();
    return;
  }
  if (sscanf(str, "d %d", curr_mess) == 1) {
    delete();
    loop();
    return;
  }
  loop();
  return;
}
