inherit "/room/room";

#include "/room/room_defs.h"

string messages;
int new_mail;

int query_mail(int silent) {
  // "new" is a hard-reserved keyword on this driver (object
  // instantiation syntax); renamed to "is_new". See AGENTS.md §6.2.
  string name, is_new;

  name = lower_case(call_other(TP, "query_real_name"));

  if (!restore_object("room/post_dir/" + name) || messages == "")
    return 0;
  if (silent)
    return 1;

  is_new = "";
  if (new_mail)
    is_new = " NEW";
  writelw("There is" + is_new + " mail for you in the post office " +
    "(north of the village square).\n\n");
  return 1;
}

string query_mail_string() {
  // "new" is a hard-reserved keyword on this driver (object
  // instantiation syntax); renamed to "is_new". See AGENTS.md §6.2.
  string name, is_new;

  name = lower_case(call_other(TP, "query_real_name"));
  if (!restore_object("room/post_dir/" + name) || messages == "")
    return "";

  is_new = "";
  if (new_mail)
    is_new = " NEW";

  return ("There is" + is_new + " mail for you in the post office " +
    "(north of the village square).\n");
}

int try_attack(object ob) {
  return "/room/church"->try_attack(ob);
}

void reset(int arg) {
  ::reset(arg);
  if (arg) return;

  set_light(1);
  short_desc = "The post office";

  long_desc = "You are in the post office. Commands:\n" +
    "read         Read from the mailbox.\n" +
    "mail <name>  Mail to player 'name'.\n" +
    "from         List all headers.\n\n" +
    "YOU ARE NOT ALLOWED TO FIGHT IN THE POST OFFICE!\n";
  //  "See the player news for information on the upcoming mail purge.\n";

  dest_dir = ({
    HM_VILLAGE + "square2", "south",
  });

  property = ({ "no_steal", "no_fight", });

  no_castle_flag = 1;
}

void init() {
  ::init();
  clone_object("/obj/mail_reader")->move_object(TP);
}

void exit() {
  object ob;

  if (ob = present("mailread", TP))
    destruct(ob);
  return;
}
