/*
 * This is a mudlib file. Copy it to /obj/simul_efun.c, or
 * wherever the get_simul_efun() in master.c says.
 * The functions defined in this file should only be replacements of efuns
 * no longer supported. Don't use these functions any longer, use the
 * replacement instead.
 */

#pragma strict_types
#pragma save_types

#include "/sys/include/sys_defs.h"
#include "/sys/include/sys_levels.h"

#define MAX_LOG_SIZE		50000
#define MAX_WIZ_LOG_SIZE	20000

nosave mixed call, tell;

// getpwent()/setpwent() compat (see the shim further down): this
// archive's own password storage moved from flat files under
// /secure/passwd/ to an ndbm-backed database (secure/login.c's own
// 94-04-14 comment) that this driver has no equivalent for. Persisted
// via plain save_object()/restore_object() on this simul_efun object
// itself -- the exact same self-save pattern secure/master.c already
// uses for its own /secure/WIZSAVE.
mapping pw_db = ([]);

void log_file(string file, string str);

// text(), loop_tell(), roll() below were originally built at runtime via
// lambda()/#'-quoted closures (the classic Amylaar-driver dialect this
// mudlib was written for). FluffOS has neither the `closure` type nor
// the `#'`/`lambda()` runtime-closure-construction machinery -- rewritten
// as plain LPC functions with identical behavior (see AGENTS.md). `call`
// and `tell` (bare `call_other`/`tell_object` aliases) are kept as
// (: efun :) function-pointer variables since a handful of real objects
// (obj/soul.lpc and its descendants) call through them via evaluate().

string text(string t, string ti, object o, object who) {
  return evaluate(call, who, "is_invis_for", o) ? ti : t;
}

void loop_tell(int i, string act, string msg, object src, object *inv, int kind) {
  while (i >= 0) {
    call_other(inv[i], "lcatch_tell", act, msg, src, kind);
    i = i - 1;
  }
}

int roll(int n, int d, int m) {
  while (n > 0) {
    m = 1 + m + random(d);
    n = n - 1;
  }
  return m;
}

// This driver appears to gate *any* direct call to a function literally
// named "reset" (even an explicit, non-driver-triggered call like the
// one create() below wants to make) behind its own internal scheduled-
// reset bookkeeping -- an explicit reset(0) call can silently no-op if
// the driver doesn't consider a reset "due" yet for this object (same
// root cause as the doc/lib/player.lpc do_reset() rename, see AGENTS.md
// and NOTES.md). The real init logic lives in do_reset(); reset() stays
// as a thin pass-through so the driver's own natural periodic apply
// still works, but create() calls do_reset() directly so it's not
// silently skipped on the very first (most important) load.
void do_reset(int tick);

void create() {
  do_reset(0);
}

void reset(int tick) {
  do_reset(tick);
}

void do_reset(int tick) {
  if (tick) return;

  tell = (: tell_object :);
  call = (: call_other :);
  if (file_size("/secure/PWDB.o") > 0) {
    catch(restore_object("/secure/PWDB"));
  }
  if (!mapp(pw_db))
    pw_db = ([]);
}

// getpwent(name) / setpwent(name, crypted_password) -- classic password-
// database efuns (see the comment on pw_db above). Case-insensitive on
// name, matching this codebase's own player-file convention elsewhere
// (lower_case()'d path components).
mixed getpwent(string name) {
  if (!name)
    return 0;
  return pw_db[lower_case(name)];
}

int setpwent(string name, string crypted) {
  if (!name)
    return 0;
  pw_db[lower_case(name)] = crypted;
  save_object("/secure/PWDB");
  return 1;
}

// addpwent() -- called immediately before setpwent() with the exact
// same arguments at every real call site (secure/login.c's own
// new_password()); alias.
int addpwent(string name, string crypted) {
  return setpwent(name, crypted);
}

// --- Driver-compat shims for classic pre-FluffOS efuns used throughout
// this archive (master.c-era LPMud dialect) that this driver no longer
// provides natively. See AGENTS.md.

// master_object() -> this driver's equivalent bare efun is just master().
object master_object() {
  return master();
}

// creator(object_name) used to be a driver efun returning the wizard/
// domain name that "owns" a path; master.c's own creator()/creator_file()
// functions (real archive content) already implement the exact same
// logic for this mudlib -- just route the classic bare call through them.
mixed creator(mixed object_name) {
  // Real call sites pass either a path string OR an object directly
  // (e.g. `creator(this_object())` -- the classic efun auto-stringified
  // an object argument; master.c's creator_file() needs a real string).
  if (objectp(object_name))
    object_name = file_name(object_name);
  return master()->creator(object_name);
}

// strstr(big, small, start) -> this driver's strsrch() has the identical
// signature/semantics (index of substring, or -1).
varargs int strstr(string big, mixed small, int start) {
  return strsrch(big, small, start);
}

// extract(str, start, [end]) -- classic substring efun, gone from this
// driver in favor of the [start..end] range syntax. `end` omitted (or
// 0) means "to the end of the string", matching every real call site in
// this archive (never a genuine explicit end==0). Negative indices
// count from the end, same convention this codebase already uses for
// real range expressions elsewhere.
varargs string extract(string str, int start, int end) {
  int len;

  if (!str)
    return str;
  len = strlen(str);
  if (start < 0)
    start = len + start;
  if (start < 0)
    start = 0;
  if (start >= len)
    return "";
  if (!end)
    end = len - 1;
  else if (end < 0)
    end = len + end;
  if (end >= len)
    end = len - 1;
  if (end < start)
    return "";
  return str[start..end];
}

// get_error_file(wizname, [clear]) -- classic efun returning the last
// compile error recorded for a wizard's "ed" session ({file, line, msg,
// flag}), gone from this driver with no replacement, and this archive
// never tracked that state anywhere else either. Only reached from
// master.c's own ed_start error-lookup convenience (secure/master.c) --
// degrade to "no error on record" (the caller already null-checks this
// correctly: `if(!error || error[3]) { write("No error.\n"); ...}`).
varargs mixed *get_error_file(string name, int clear) {
  return 0;
}

// to_string(val) -- classic generic stringification efun. Handles the
// plain int/float case (this driver's `+` operator already stringifies
// those against a string operand, same as the original dialect) and the
// idiom this archive repeatedly uses it for: to_string(({ch})) where ch
// is a single character CODE (from indexing a string, e.g. name[0]) --
// turn a 1-element array of char codes back into a string.
string to_string(mixed val) {
  int i, sz;
  string s;

  if (stringp(val))
    return val;
  if (pointerp(val)) {
    s = "";
    sz = sizeof(val);
    for (i = 0; i < sz; i++) {
      if (intp(val[i]))
        s += sprintf("%c", val[i]);
      else
        s += to_string(val[i]);
    }
    return s;
  }
  return "" + val;
}

// ftime(path) -- classic file-modification-time efun; this driver's
// stat() returns ({size, mtime, load_time, create_time}) instead.
int ftime(string path) {
  mixed *st;

  st = stat(path);
  if (!pointerp(st) || sizeof(st) < 2)
    return 0;
  return st[1];
}

// query_once_interactive(ob) -- classic "was this object ever a
// connected player" check (distinct from interactive(), which is only
// true for a CURRENTLY connected one). This mudlib's own convention
// (see RNAME/get_him() etc.) is that every real player object answers
// query_real_name() truthily, so that plus the current-interactive
// check covers both a still-connected and an already-disconnected
// former player.
int query_once_interactive(object ob) {
  return ob && (interactive(ob) || !!(string)ob->query_real_name());
}

// walk_mapping(map, funcname) -- classic mapping-iteration efun, calling
// funcname(key, value) on the CALLING object for every entry. This
// driver has no equivalent; reimplemented directly over keys()/values().
void walk_mapping(mapping m, string func) {
  object caller;
  mixed *k;
  int i, sz;

  caller = previous_object();
  k = keys(m);
  sz = sizeof(k);
  for (i = 0; i < sz; i++)
    call_other(caller, func, k[i], m[k[i]]);
}

// m_delete(map, key) -- classic name for this driver's map_delete(),
// which mutates in place and returns void rather than returning the
// mapping; every call site here uses the old functional-return style
// (`wiz_info = m_delete(wiz_info, name)`), so return it back too.
mapping m_delete(mapping m, mixed key) {
  map_delete(m, key);
  return m;
}

// m_sizeof(map) -- classic name for this driver's (perfectly ordinary,
// polymorphic) sizeof(). (Note: there's also a #if-0'd, dead `sizeof()`
// simul_efun override further down in this same file that itself
// referenced m_sizeof() -- disabled since long before this port, and
// unrelated to real call sites like secure/master.c's, which need this
// name to exist as a real efun regardless.)
int m_sizeof(mapping m) {
  return sizeof(m);
}

// enable_interactive(ob) -- both real call sites are the exact idiom
// `if(interactive(this_object())) enable_interactive(this_object());`,
// one flagged by the archive's OWN author with "do we still need this??"
// (doc/lib/living.lpc). Whatever legacy interactive-state refresh this
// used to do, this driver has no equivalent efun and no evidence it's
// still needed; safe no-op.
void enable_interactive(object ob) {}

// set_prompt(str, [ob]) -- this driver's own contrib.spec has it behind
// a permanent `#if 0` (not gated by any package flag -- genuinely
// unavailable regardless of build config). Used only for a cosmetic
// customizable-terminal-prompt feature (obj/expander.lpc); no-op rather
// than blocking compile.
varargs void set_prompt(string str, object ob) {}

// disable_interactive(ob) -- paired with enable_interactive() above,
// same reasoning: legacy interactive-state call with no driver
// equivalent and no clear evidence it's still needed. Safe no-op.
void disable_interactive(object ob) {}

// set_modify_command(ob) -- classic MudOS efun registering `ob` as a
// per-player command-preprocessing hook (obj/expander.lpc's alias/
// history/command-expansion feature calls this on itself from its own
// reset_expander()). This driver has no such mechanism at all (checked
// the whole driver source -- not even under a different name), and
// every new character's very first reset_expander() call used to crash
// uncaught with "Undefined function called: set_modify_command",
// aborting doc/lib/player.lpc's own move_player_to_start3() partway
// through and silently skipping the real move-into-starting-room call
// further down in that same function -- so nobody ever actually arrived
// anywhere (confirmed live: "It's too dark" / unrecognized room
// commands, right after a brand new character picked a gender). Command
// aliasing/history genuinely won't work without a real driver hook for
// this, but that's a lost cosmetic feature, not a crash; no-op instead
// of blocking every single login. See AGENTS.md, NOTES.md.
void set_modify_command(mixed ob) {}

// cat(file, [start_line], [num_lines]) -- classic "display part of a
// file" efun (doc/lib/player.lpc's `more`/`even_more` pager commands).
// Gone from this driver; reimplemented directly over read_file().
varargs int cat(string file, int start, int num) {
  string content;
  string *lines;
  int total, i, end;

  if (file_size(file) < 0)
    return 0;
  content = read_file(file);
  if (!content)
    return 0;
  lines = explode(content, "\n");
  total = sizeof(lines);
  if (start < 1)
    start = 1;
  if (num < 1)
    num = total;
  end = start + num - 1;
  if (end > total)
    end = total;
  for (i = start; i <= end; i++)
    write(lines[i - 1] + "\n");
  return 1;
}

// mappingp(x) -- this driver's real type-predicate efun is mapp(), not
// mappingp() (confirmed already-established project convention, see
// AGENTS.md's §7.30 corpus sweep). Every OTHER classic type predicate
// (stringp/intp/objectp/pointerp/floatp/functionp/bufferp) already
// matches this driver's real names as-is.
int mappingp(mixed x) {
  return mapp(x);
}

// isalpha(c) -- classic ctype-family efun (c is a character CODE, as
// returned by indexing a string), gone from this driver with no
// replacement.
int isalpha(int c) {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

// query_input_pending(ob) -- this driver's own equivalent is in_input().
int query_input_pending(object ob) {
  return in_input(ob);
}

// filter_objects(arr, func, [args...]) -- classic efun that keeps each
// element `e` of `arr` where `e->func(args...)` is truthy. Distinct
// from this driver's filter()/filter_array() (which instead calls
// func(e, args...) on a caller object, not e->func(...) on the element
// itself) -- reimplemented directly with call_other.
varargs object *filter_objects(object *arr, string func, mixed arg1, mixed arg2) {
  int i, sz;
  object *result;

  sz = sizeof(arr);
  result = ({});
  for (i = 0; i < sz; i++)
    if (call_other(arr[i], func, arg1, arg2))
      result += ({ arr[i] });
  return result;
}

// query_mud_port() -- classic efun returning the mud's listening port;
// this driver only exposes it as the __PORT__ compile-time predefine
// (from config.fluffos's "port number :"), not a callable efun.
int query_mud_port() {
  return __PORT__;
}

// assoc/order_alist/insert_alist -- classic "alist" (association-list)
// efun family: a key/value pair stored as ({keys_array, values_array})
// rather than a real mapping (this predates widespread mapping support
// in old LPMud dialects). Gone from this driver entirely. Used only for
// obj/expander.lpc's alias/nickname command-substitution feature. Two
// distinct call shapes appear in the real call sites, both preserved
// here: assoc(key, ({keys,values})) returns the matching VALUE (or an
// explicit 3rd-arg default, or 0); assoc(key, plain_keys_array) returns
// the matching INDEX (or -1) -- used for manual array-splicing deletes.
varargs mixed assoc(mixed key, mixed *container, mixed def) {
  mixed *keys, *values;
  int i, sz;

  if (sizeof(container) == 2 && pointerp(container[0]) && pointerp(container[1])) {
    keys = container[0];
    values = container[1];
    sz = sizeof(keys);
    for (i = 0; i < sz; i++)
      if (keys[i] == key)
        return values[i];
    return def;
  }
  sz = sizeof(container);
  for (i = 0; i < sz; i++)
    if (container[i] == key)
      return i;
  return -1;
}

// order_alist(({keys,values})) -- sorts the pair together by key
// (insertion sort -- these alias/nickname lists are always small).
mixed *order_alist(mixed *pair) {
  mixed *keys, *values;
  int i, j, sz;
  mixed k, v;

  keys = pair[0];
  values = pair[1];
  sz = sizeof(keys);
  for (i = 1; i < sz; i++) {
    k = keys[i];
    v = values[i];
    j = i - 1;
    while (j >= 0 && keys[j] > k) {
      keys[j + 1] = keys[j];
      values[j + 1] = values[j];
      j--;
    }
    keys[j + 1] = k;
    values[j + 1] = v;
  }
  return ({ keys, values });
}

// insert_alist(key, value, ({keys,values})) -- insert or replace.
mixed *insert_alist(mixed key, mixed value, mixed *pair) {
  mixed *keys, *values;
  int i, sz;

  keys = pair[0];
  values = pair[1];
  sz = sizeof(keys);
  for (i = 0; i < sz; i++) {
    if (keys[i] == key) {
      values[i] = value;
      return ({ keys, values });
    }
  }
  return order_alist(({ keys + ({ key }), values + ({ value }) }));
}

// get_prompt_str([flag]) -- part of a per-player customizable-prompt
// feature (doc/lib/player.lpc, obj/expander.lpc). The flag-TOGGLING
// commands survive (a wizard's personal copy at
// players/kryll/tmp/bin/prompt.lpc), but the actual prompt-string-
// building logic driven by those flags does not exist anywhere in the
// ~24,000-file archive. Degrades to an empty custom-text segment (the
// callers' own surrounding logic still adds the real "> "/">> " prompt
// terminator either way) rather than inventing new prompt text.
varargs string get_prompt_str(int flag) {
  return "";
}

// member(item, container) -- classic membership-test efun distinct from
// this driver's member_array() (which returns an INDEX or -1, not a
// boolean -- every real call site here checks the result against
// 0/1/!, never uses it as an index). Handles both arrays/strings
// (member_array's own native container types) and mappings (checked via
// keys(), so a key whose value happens to be falsy -- e.g. a bank
// account with a 0 balance -- still correctly counts as present).
int member(mixed item, mixed container) {
  if (mapp(container))
    return member_array(item, keys(container)) != -1;
  return member_array(item, container) != -1;
}

// process_string(str) -- classic value-substitution efun, gone from
// this driver (documented in its own docs/ tree but not actually
// compiled into any package here). Replaces every "@@function:object@@"
// (optionally "@@function:object#id@@" -- FluffOS's own clone-name
// syntax already accepts the "#id" suffix as part of the path, so no
// separate parsing needed) with the string result of calling that
// function on that object. room/room.lpc (the room base class) always
// enables this (USE_PROCESS_STRING, unconditional #define) for dynamic
// room-description text. Malformed/unresolvable tags degrade to empty
// rather than erroring, matching the "cosmetic feature, never worth a
// crash" spirit of the original efun's own docs.
string process_string(string str) {
  int start, end, colon;
  string tag, func, objpath, result;
  object target;
  mixed err;

  if (!str)
    return str;
  start = strsrch(str, "@@");
  if (start == -1)
    return str;
  end = strsrch(str, "@@", start + 2);
  if (end == -1)
    return str;
  tag = str[start + 2..end - 1];
  colon = strsrch(tag, ":");
  if (colon == -1)
    return str[0..start - 1] + process_string(str[end + 2..<1]);
  func = tag[0..colon - 1];
  objpath = tag[colon + 1..<1];
  target = find_object(objpath);
  if (!target)
    catch(target = load_object(objpath));
  result = "";
  if (target) {
    err = catch(result = (string)call_other(target, func));
    if (err || !stringp(result))
      result = "";
  }
  return str[0..start - 1] + result + process_string(str[end + 2..<1]);
}

// command(str, ob) -- classic 2-arg "execute str as if ob typed it"
// idiom (~40 real call sites: NPCs auto-wielding weapons, following,
// fleeing, etc.). This driver's compiled-in command() efun only exposes
// the 1-arg form (execute as this_object()), and set_this_player() --
// the obvious workaround -- is compiled out on this build (it's only
// available under NO_ADD_ACTION, mutually exclusive with the
// add_action()-based command dispatch this whole mudlib, and every
// other lib in this corpus, actually uses). Real fix: every 2-arg call
// site was mechanically rewritten to `ob->force_me(str)`, using the
// force_me() compat shim in /include/include.h (spliced into every
// object, so `command(str)` inside it correctly executes as `ob` via
// normal call_other semantics -- no name collision with the real 1-arg
// command() efun here at all). See NOTES.md.

void say(string txt, object ex, object who, string inv_txt) {
  int i, j, k;
  object where, *inv;

  if (!who || !inv_txt) {
    if (ex)
      return efun::say(txt, ex);
    else
      return efun::say(txt);
  }

  if (!ENV(who))
    return;
  where = ENV(who);
  inv = all_inventory(where);
  inv -= ({ who });
  if (ex)
    inv -= ({ ex });
  j = sizeof(inv);
  i = 0;
  while (i < j) {
    tell_object(inv[i], text(txt, inv_txt, inv[i++], who));
  }
  tell_object(where, txt);
  return;
}

// A function to remove an entry from arrays or strings
mixed *del_array(mixed array, int index) {
  int len;

  if (stringp(array))
    len = strlen((string)array);
  else if (pointerp(array))
    len = sizeof(array);
  else
    return array;
  if (index < 0 || index >= len)
    return array;
  return array [0..index - 1] + array [index + 1..<1];
}

string clean_path(string path) {
  string *hlp, tmp;
  int i;

  if (!path)
    return "";
  // 091197: Sauron: Slightly changed the way paths beginning with '~' are
  //                 parsed.
  if (TP && path[0..0] == "~") {
    if (TP && path[1..1] == "/")
      path = "/players/" + TP->RNAME + path[1..<1];
    else {
      tmp = explode(path[1..<1], "/")[0];
      if (file_size("/players/" + tmp) != -2) {
        printf("No such wizard (%s).\n", tmp);
        return "";
      } else
        path = "/players/" + path[1..<1];
    }
  }
  // 091197: Sauron: Added prepending of user's current path.
  if (path[0..0] != "/") {
    /* Sauron: Removed again for now as it caused 'strange' behaviour.
    if(TP && (tmp = (string)TP->query_path()) && tmp != "")
      path = "/" + tmp + "/" + path;
    else
*/
    path = "/" + path;
  }
  if (path == "/")
    return path;
  if (sizeof(explode(path, "...")) > 1)
    return "";
  if (sizeof(explode(path, "//")) > 1)
    return "";
  if (sizeof(explode(path, " ")) > 1)
    return "";
  if (!(hlp = explode(path, "/")))
    return "";
  // Sauron: Remove all entries that are either 0 or "" before we start.
  hlp = regexp(hlp, ".");

  // 091197: Sauron: Rewritten block below:
  i = sizeof(hlp) - 1;

  while (i >= 0) {
    switch (hlp[i]) {
      case "..":
        if (i)
          hlp[i--] = 0;
        // Fall through as we want to remove two entries:
      case ".":
        hlp[i--] = 0;
        break;
      default:
        i--;
        break;
    }
  }

  return "/" + implode(hlp, "/");
}

int roll_dice(int n, int d, int m) {
  return roll(n, d, m);
}

/*
 * The ls() function is no longer needed, as get_dir() can do the same
 * work.
 *
 * RE: Some directories are INCREDIBLY large. Therefore, we reintroduce
 *     the hardcoded ls() efun.
 *     The former lpc-ls is now available as "dir" for a beautful printout
 *     of any directory.
 *
 */
void dir(string path) {
  string *dir, *hlp, orig;
  int trunc_flag, i, num, dirs;

  if (path[0..0] == "/" || path[0..0] == "~") {
    if ((path = clean_path(path)) == "") {
      write("Illegal path!\n");
      return;
    }
    orig = path;
    write("[" + path + "]\n");
    if (file_size(path) == -2 && path != "/")
      dir = get_dir(path + "/*");
    else {
      dir = get_dir(path);
      hlp = explode(path, "/");
      if (sizeof(hlp) < 2)
        path = "";
      else
        path = implode(hlp[0..sizeof(hlp) - 2], "/");
    }
  } else
    dir = get_dir(path);

  if (!sizeof(dir) && file_size(orig) != -2) {
    write("No such file or directory.\n");
    return;
  }
  if ((num = sizeof(dir)) > 330) {
    dir = dir[0..329];
    trunc_flag = 1;
  }
  if (path)
    path += "/";
  dirs = 0;
  for (i = 0; i < sizeof(dir); i++) {
    if (sizeof(explode(path + dir[i], " ")) <= 1) {
#if 0
      /* LLORT */ write("simul_efun: path=" + path + " dir=" + dir[i] + "\n");
#endif
      switch (file_size(path + dir[i])) {
        case -2:
          dir[i] += "/";
          dirs++;
          break;
        case -1: break;
        case 0:
          dir[i] += "-";
          break;
        default:
          if (find_object(path + dir[i]))
            dir[i] += "*";
      }
    } else
      dir[i] += "?!?";
  }
  if (!dir)
    write("No such directory.\n");
  else {
    printf(" %-*#s\n", 79, implode(dir, "\n"));
    if (trunc_flag)
      write("***TRUNCATED***\n");
    printf("The directory contains %i directories and %i files.\n",
      dirs, num - dirs);
  }
}

/*
 * The old 'slice_array' is no longer needed. Use range argument inside
 * a pair of brackets instead.
 */
mixed *slice_array(mixed *arr, int from, int to) {
  return arr[from..to];
}

#define xwrite(str) tell_room(this_object(),str+"\n")

nosave object get_him(object ob) {
  string tmp;
  int l;

  if (!ob)
    return 0;
  if (PO && (tmp = explode(file_name(PO), "#")[0]) &&
    (tmp == "secure/login" ||
      tmp == "obj/tick"))
    return ob;
  if (TP && (tmp = (string)TP->RNAME)
    && tmp == (string)ob->RNAME)
    return ob;
#if 1
  // Sauron: Changed from 'TP->LEVEL >= ob->INVIS' to 'TP->LEVEL > ob->INVIS'
  //         If invis to level 120, level 120 ppl should not see me.
  if (TP && query_ip_number(TP)
    && TP->LEVEL > ob->INVIS)
    return ob;
  if (!(TP && query_ip_number(TP)) && (!ob->query_immortal()))
    return ob;
  return 0;
#else
  if ((TP ? (int)TP->LEVEL : 1) >= ob->INVIS)
    return ob;
  return 0;
#endif
}

nomask object *users() {
  int i, j, sz;
  object *u, *v, herp;

#if 0
  herp = find_player("herp");
  if (herp)
    tell_object(herp, "sim/users called\n");
#endif

  u = efun::users();
  v = allocate(0);
  for (i = 0, sz = sizeof(u); i < sz; i++)
    if (get_him(u[i]) && u[i]->query_player())
      v += u[i..i];
  return v;
}

nomask object find_player(string str) {
  object ob;

  ob = efun::find_player(str);
  return get_him(ob);
}

nomask object find_living(string str) {
  object ob;

  ob = efun::find_living(str);
  return get_him(ob);
}

nomask object query_snoop(object obj) {
  object ob;

  ob = efun::query_snoop(obj);
  if (TP && !TP->query_elder())
    return 0;
  if (master_object()->get_wiz_level(TP)
    < master_object()->get_wiz_level(ob))
    return 0;
  return get_him(ob);
}


