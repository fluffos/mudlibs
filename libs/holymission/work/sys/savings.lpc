/*
 * sys/savings.lpc -- reconstructed placeholder.
 *
 * Found completely EMPTY (0 bytes) in the preserved archive, despite
 * being #include'd (textually) into doc/lib/living.lpc as the "saving
 * throws" subsystem. doc/magik/savings and doc/coding/saving_throws
 * (also real archive content) document the DESIGN in detail --
 * percentage resistance/immunity per damage type, FIRE..NO_SAVE = 1..16
 * -- but nowhere in the ~24,000-file archive does an actual
 * implementation survive. This is a minimal, honest, functional stand-
 * in: an array indexed by damage-type constant, all zero (no
 * resistance/immunity by default) -- it never blocks or weakens any
 * effect, which is the correct "feature genuinely absent" behavior
 * rather than invented balance numbers. See NOTES.md.
 */

#define FIRE              1
#define ELECTRICITY       2
#define COLD              3
#define ACID              4
#define ENERGY            5
#define DRAIN             6
#define TOUCH             7
#define PETRIFICATION     8
#define POISON            9
#define BREATH            10
#define DEATHMAGIC        11
#define MAGIC             12
#define MINDEFFECTIVE     13
#define ILLUSION          14
#define SUMMONING         15
#define NO_SAVE           16
#define MAX_NO_OF_SAVE    16

nosave int *savings;

void init_savings(int n) {
  savings = allocate(n);
}

int query_saving(int which) {
  if (!savings || which < 0 || which >= sizeof(savings))
    return 0;
  return savings[which];
}

int set_saving(int which, int val) {
  if (!savings || which < 0 || which >= sizeof(savings))
    return 0;
  return savings[which] = val;
}
