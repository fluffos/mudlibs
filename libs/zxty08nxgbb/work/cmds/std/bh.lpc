#include <ansi.h>

inherit F_CLEAN_UP;
void delete_busy(object me);

int main(object me, string arg)
{
        object *member;
        string bh;
        int i;



        if( !arg)       return notify_fail("你要说什么？\n");
        bh=(string)me->query("banghui");
        if( !bh)        return notify_fail("你没有加入任何帮会，无法使用帮会频道。\n");
        if( time()-me->query_temp("bh1")<1&&!wizardp(me) ) {me->start_busy(4);
                me->set_temp("bh_busy",1);
                remove_call_out("delete_busy");
                call_out("delete_busy",4);
                me->add("jing",-5);
                write("别急，慢慢说!\n");
                return 1;
                }
                if(me->is_busy()&&me->query_temp("bh_busy")) {
                        me->add("jing",-5);
                        write("你说话太快，一不小心咬到了舌头!\n");
                        return 1;
                        }
        if( time()-me->query_temp("bh1")<1&&!wizardp(me) ) {me->start_busy(4);
                me->set_temp("say_busy",1);
                remove_call_out("delete_busy");
                call_out("delete_busy",4,me);
                me->add("jing",-5);
                write("别急，有话好好讲！\n");
                return 1;
                }
        member=users();
        for(i=0;i<sizeof(member);i++)   {
                if( !objectp(member[i]))        member[i]=0;
                else if( !living(member[i]))    member[i]=0;
                else if( (string)member[i]->query("env/bh"))    member[i]=0;
               else if( (string)member[i]->query("banghui")!=bh && !wizardp(member[i]))       member[i]=0;
        }
        member-=({ 0 });
        message("banghui",HIM"【"+trans_color(bh,2)+NOR+HIM"】"+me->query("name")+"("+me->query("id")+")："+arg+"\n"NOR,
                member);
        me->set_temp("bh1",time());

        return 1;
}
void delete_busy(object me)
{
        if(!me || !environment(me)) return;
        me->delete_temp("bh_busy");
}

int help(object me)
{
        write(@HELP
指令格式 : bh <内容>

本指令用于帮会成员的内部交流。

如果你现在不想看到bh的信息，你可以set hp 1。相反，如果你

现在想接收bh的信息，你可以unset bh。
HELP
        );
        return 1;
}

