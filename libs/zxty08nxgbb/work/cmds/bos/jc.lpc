inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object *ob;
        int i;
   
        ob = ty_users();  
        
        for ( i=0;i<sizeof(ob);i++ ) {    
        if( ob[i]->query("tybang") && ob[i]->query("banghui") )  {
            ob[i]->set("tybang/banghui",trans_color(ob[i]->query("banghui"),2) );
        write(""+ob[i]->query("id")+"有这个变量!\n");
        }
}
write_file("/u/zjb/log/ceshi","事实2\n");
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：jc

检查在线玩家有没有是非正常进入的！
HELP
        );
        return 1;
}


