#include <command.h>
#include <ansi.h>

inherit F_DBASE;
inherit F_CLEAN_UP;
void create() {
  seteuid(getuid());
  set("channel_id", "离线指令");
}
string online_time(int t) {
  int h, m, s;

  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t;

  return sprintf("本次联线时间%d:%d", m, s);
}

int main(object me, string arg) {
  int exp, online;
  object link_ob, *users;
  string ip_num, msg;
  int id_temp; string id_num;
  object xinxiu, room;

  if (me->query_temp("netdead") && me->query("doing"))
    return 0;
  if (me->query_busy() && !me->query_temp("netdead"))
    if (!me->query_temp("suicide") && !me->query("doing"))
      return notify_fail("上一个动作未完成！\n");
    else {
      if (me->query_temp("suicide")) {
        CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "终于想通了，放弃自杀了。 :)");
        tell_object(me, MAG "\n\n你决定要放弃自杀，太好了，那下次再来吧！\n\n\n" NOR);
      }
    }
  if (environment(me)->query("fight_room") && me->is_fighting()) return notify_fail("擂台上不能退出！\n");
  if (me->is_fighting() && !me->query_temp("netdead"))
    return notify_fail("战斗中只能逃跑，不能退出游戏！\n");
  if (me->query_temp("on_paimai"))
    return notify_fail("你目前正参与拍卖，无法退出！\n");
  // We might be called on a link_dead player, so check this.
  link_ob = me->query_temp("link_ob");
  if (link_ob) {
    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }
    if (!living(me)) {
      write("什麽？\n");
      return 0;
    }

    if (me->query("doing")) {
      if (me->query_temp("lixian", 1) < 2) {
        me->add_temp("lixian", 1);
        write(HIR "你现在正在闭关，如果你想断线闭关的话，直接断线(#con)就可以闭关了\n"
          HIR "如果你想quit的话，请再按" + (3 - me->query_temp("lixian")) + "次quit指令，你确定了吗？\n" NOR);
        return 1;
      }
    }

    if (me->query("yipin/failure")) {
      me->delete("yipin/failure");
      write(HIY "\n欢迎下次光临!\n" NOR);
      return 1;
    }
    if (me->query("mud_age") < 1800 && !wizardp(me) && query_ip_number(me)) {
      if (me->query_temp("newid") < 2) {
        me->add_temp("newid", 1);
        write(HIY "\n注意" HIW "：系统为了节省资源对于登陆不到30分钟的ID会将其自动\n" NOR);
        write(HIR "删档" HIW "，您的ID还需要再挂" + ((1800 - me->query("mud_age")) / 60) + "分钟才能给予" HIG "存档" HIW "，如果你确定不\n" NOR);
        write(HIW "不要保存现在这个ID的档的话，请再按" + (3 - me->query_temp("newid")) + "次" HIB "Quit" HIW "指令!\n" NOR);
        return 1;
      }
    }

    if (!wizardp(me)) {
      if (me->query_condition("killer"))
        return notify_fail("你现在不能退出游戏！\n");
      foreach (object ob in all_inventory(me))
        if (ob && !ob->query_autoload())
          DROP_CMD->do_drop(me, ob, 1);
    }


    if ((me->query("id") == "zmud" || me->query("id") == "ahui")
      && !me->query_temp("zjb_tishi")) {
      write(HIG "────────────────────────────────────────\n" NOR);
      if (me->query("wizlog/bugedit") != file_size("/log/edit/bugedit")) {
        me->set("wizlog/bugedit", file_size("/log/edit/bugedit"));
        write(HIC "有巫师越权使用" BLINK HIR "edit" NOR HIC " 指令请查看/log/edit/bugedit 。\n\n" NOR);
      }
      if (me->query("wizlog/call") != file_size("/log/nosave/call_player")) {
        me->set("wizlog/call", file_size("/log/nosave/call_player"));
        write(HIW "有巫师使用了" BLINK HIR "call " NOR HIW "指令请查看/log/nosave/call_player 。\n\n" NOR);
      }
      if (me->query("wizlog/wizgive") != file_size("/log/nosave/wizgive")) {
        me->set("wizlog/wizgive", file_size("/log/nosave/wizgive"));
        write(HIR "有巫师" BLINK HIW "给了玩家东西" NOR HIR ",具体请查看/log/nosave/wizgive 。\n\n" NOR);
      }
      if (me->query("wizlog/promotion") != file_size("/log/nosave/promotion")) {
        me->set("wizlog/promotion", file_size("/log/nosave/promotion"));
        write(HIG "有巫师" BLINK HIR "提了新巫师" NOR HIG ",具体请查看/log/nosave/promotion 。\n\n" NOR);
      }
      if (me->query("wizlog/setskill") != file_size("/log/nosave/setskill")) {
        me->set("wizlog/setskill", file_size("/log/nosave/setskill"));
        write(HIB "有巫师使用了" BLINK HIR "setskill" NOR HIB "指令,具体请查看/log/nosave/setskill 。\n\n" NOR);
      }
      if (me->query("wizlog/purge") != file_size("/log/nosave/purge")) {
        me->set("wizlog/purge", file_size("/log/nosave/purge"));
        write(HIC "有巫师" BLINK HIR "杀玩家档了" NOR HIC ",具体请查看/log/nosave/purge 。\n\n" NOR);
      }
      if (me->query("wizlog/bugcat") != file_size("/log/file/bugcat")) {
        me->set("wizlog/bugcat", file_size("/log/file/bugcat"));
        write(HIM "有巫师越权使用了" BLINK HIR " cat " NOR HIM "指令,具体请查看/log/file/bugcat 。\n\n" NOR);
      }
      if (me->query("wizlog/bugcp") != file_size("/log/file/bugcp")) {
        me->set("wizlog/bugcp", file_size("/log/file/bugcp"));
        write(HIR "有巫师越权使用了" BLINK HIW " cp " NOR HIR "指令,具体请查看/log/file/bugcp 。\n\n" NOR);
      }
      if (me->query("wizlog/dbase") != file_size("/log/nosave/dbase")) {
        me->set("wizlog/dbase", file_size("/log/nosave/dbase"));
        write(HIC "可能有非法数据给玩家" BLINK HIR " set了敏感数值 " NOR HIC "具体请查看/log/nosave/dbase 。\n\n" NOR);
      }
      /*
   if( me->query("wizlog/skill") != file_size("/u/zjb/log/skill") )
{
    me->set("wizlog/skill", file_size("/u/zjb/log/skill"));
 write( HIC"可能有非法数据给玩家"BLINK HIR" set了skill "NOR HIC"具体请查看/u/zjb/log/skill 。\n\n"NOR);
}
*/
      if (me->query("wizlog/update") != file_size("/log/file/update")) {
        me->set("wizlog/update", file_size("/log/file/update"));
        write(HIC "有巫师使用了" BLINK HIR " update " NOR HIC "指令来更新文件了,具体请看/log/file/update 。\n\n" NOR);
      }
      if (me->query("wizlog/bugrm") != file_size("/log/file/bugrm")) {
        me->set("wizlog/bugrm", file_size("/log/file/bugrm"));
        write(HIC "有巫师越权使用了" BLINK HIR " rm " NOR HIC "指令,具体请查看/log/file/bugrm 。\n\n\n" NOR);
      }
      if (me->query("wizlog/exec") != file_size("/log/login/exec")) {
        me->set("wizlog/exec", file_size("/log/login/exec"));
        write(HIM "有人试图调用" BLINK HIR " enter_world来侵入本MUD " NOR HIM ",具体请看/log/login/exec 。\n\n" NOR);
      }

      me->set_temp("zjb_tishi", 1);
      write(HIG "这个只是星空为系统核心管理人物写的一个提示系统,除了提示您此次上线有无人动用\n"
        BLINK HIR "敏感指令和越权" NOR HIG "也是为各位储存您此次下线时各个记录的数值,让您下一次上可以更加\n"
        "准确的提示您查看记录系统!\n" NOR);
      write(HIC "                                                   By zjb@ty\n" NOR);
      write(HIW "                                                   2002.5.15\n" NOR);
      write(HIG "────────────────────────────────────────\n" NOR);
      return 1;
    }

    online = time() - link_ob->query("online_time");
    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(me));
    exp = me->query("combat_exp") - link_ob->query("combat_exp");
    link_ob->set("combat_exp", me->query("combat_exp"));
    if (wizardp(me) && me->query("env/invisibility"))
      ;
    else
      link_ob->save();
    destruct(link_ob);
  }
  users = filter_array(users(), (: $1->query_temp("tomud") :));
  message("system", REM2(me), users);
  write(read_file("/u/zjb/4"));
  write(HIY "\n注意：如果你是在网吧登陆，请确认 Zmud 中是否保留你帐号的密码，\n避免你的帐号被他人盗用。欢迎下次光临！再见！！\n\n");
  message("system", me->name() + "离开游戏。\n", environment(me), me);
  ip_num = query_ip_number(me);
  if (!ip_num)
    msg = me->query("name") + "(" + me->query("id") + ")" + HIR + "断线时间过长" + HIW + ",自动离开游戏了。";
  else
    msg = me->query("name") + "(" + me->query("id") + ")(" + query_ip_number(me) + ")离开游戏了。";
  msg += online_time(online);
  if (exp != 0)
    msg += sprintf("，经验增加" + HIR + "%d" + NOR + WHT + "点。", exp);
  else
    msg += "。";
  CHANNEL_D->do_channel(this_object(), "sys", msg);

  if (me->query("mud_age") > 1800) {
    reclaim_objects();
    me->save();
    destruct(me);
  } else {
    rm(DATA_DIR + "login/" + me->query("id")[0..0] + "/" + me->query("id") + __SAVE_EXTENSION__);
    rm(DATA_DIR + "user/" + me->query("id")[0..0] + "/" + me->query("id") + __SAVE_EXTENSION__);
    write(HIR "\n注意：由于您这个ID登陆不到30分钟，系统为了节省资源不给予存档!\n\n" NOR);
    destruct(me);
    id_num = read_file("/adm/daemons/iduser", 1);
    id_temp = atoi(id_num); id_temp = id_temp - 1;
    id_num = sprintf("%d", id_temp);
    write_file("/adm/daemons/iduser", id_num, 1);
  }
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : quit
当你想暂时离开时, 可利用此一指令。
HELP
  );
  return 1;
}
