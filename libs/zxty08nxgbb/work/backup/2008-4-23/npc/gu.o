dbase (["pighead":0,"str":14,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","int":19,"age":65,"actions":,"food":69,"last_save":1208869839,"no_suck":1,"water":69,"con":14,"default_actions":,"dex":24,"max_jingli":40000,"chat_chance":3,"kar":18,"race":"人类","name":"顾炎武","per":13,"shen_type":1,"gender":"男性","chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"jingli":40000,"max_qi":184,"neili":0,"max_jing":40000,"zhengzhao":1,"shen":40000,"eff_qi":184,"id":"gu yanwu","startroom":"/d/city2/shuyuan","eff_jing":40000,"combat_exp":400000,"jing":40000,"qi":184,])
