dbase (["bellicosity":0,"pighead":0,"str":19,"long":"杜宽担任雪亭镇的驿长已经有十几年了，虽然期间有几次升迁的机会，但是他都因为舍不得离开而放弃了，这次应风子的邀请，终于走出ES2，来到这里当驿站站长，风子对他很是感激。","eff_jingli":0,"attitude":"friendly","int":13,"last_save":1208870153,"con":29,"area_name":"扬州驿站","dex":14,"area_file":"/d/city/npc/post_officer.c","kar":14,"name":"杜宽","per":17,"gender":"男性","area_id":"yzyizhan","max_qi":220,"ziyuan":"信件","neili":0,"kaifa":40,"zhengzhao":3,"zhongcheng":12,"jizhi":65,"id":"post officer","eff_qi":220,"jing":155,"eff_jing":155,"qi":220,"max_zhongcheng":97,"age":43,"actions":,"food":83,"inquiry":(["风子":"我老朋友呀！他看扬州邮件混乱，百姓叫苦连天，让我来当这里的驿站站长。他可是一个好巫师哟！","驿站":"是啊... 这里就是扬州驿，你要寄信吗？",]),"default_actions":,"water":83,"race":"人类","shen_type":0,"jingli":0,"max_jing":155,"tybang":(["banghui":"[1;36m烟[1;37m波[1;34m瀛洲[1;31m阁[2;37;0m",]),"shen":0,"combat_exp":800,"startroom":"/d/city/postoffice","banghui":"$HIC$烟$HIW$波$HIB$瀛洲$HIR$阁","title":"驿长",])
