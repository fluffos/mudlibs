dbase (["bellicosity":0,"pighead":0,"str":25,"long":"韦春芳是当朝鹿鼎公兼红花会总舵主韦小宝他娘，虽是徐娘半老，但风韵犹存。","eff_jingli":0,"attitude":"friendly","int":25,"last_save":1208888761,"con":25,"area_name":"丽春院","dex":25,"chat_chance":15,"area_file":"/d/city/lichunyuan.c","kar":27,"max_neili":500,"name":"韦春芳","per":12,"gender":"女性","area_id":"lichunyuan","chat_msg":({"韦春芳得意地说道：当年老娘我标致得很，每天有好几个客人。","韦春芳怒骂道：辣块妈妈，要是罗刹鬼、红毛鬼子到丽春院来，老娘用大扫帚拍了出去。","韦春芳对你说道：你一双眼睛贼忒嘻嘻的，真像那个喇嘛！",}),"max_qi":300,"ziyuan":"美女","neili":500,"kaifa":40,"zhengzhao":1,"no_get":100,"zhongcheng":17,"jizhi":65,"id":"wei chunfang","eff_qi":300,"jing":90,"eff_jing":100,"qi":300,"max_zhongcheng":96,"age":42,"disable_type":" <昏迷不醒>","actions":,"food":0,"inquiry":(["name":"老娘我就是韦春芳。","here":"我们丽春院可是扬州城里头一份的找乐子去处。","韦小宝":"那是我的乖儿子，长得就像你。","丽春院":"我们丽春院可是扬州城里头一份的找乐子去处。",]),"default_actions":,"water":0,"race":"人类","hunmi":0,"shen_type":1,"jingli":0,"max_jing":100,"tybang":(["banghui":"[1;36m烟[1;37m波[1;34m瀛洲[1;31m阁[2;37;0m",]),"shen":2500,"combat_exp":25000,"startroom":"/d/city/lichunyuan","channel":(["say_count":1,"last_say":1208888750,]),"banghui":"$HIC$烟$HIW$波$HIB$瀛洲$HIR$阁","title":"丽春院老板娘",])
