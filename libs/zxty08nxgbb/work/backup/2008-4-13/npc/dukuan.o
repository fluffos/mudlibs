dbase (["max_zhongcheng":97,"eff_qi":220,"inquiry":(["风子":"我老朋友呀！他看扬州邮件混乱，百姓叫苦连天，让我来当这里的驿站站长。他可是一个好巫师哟！","驿站":"是啊... 这里就是扬州驿，你要寄信吗？",]),"eff_jing":155,"actions":,"shen_type":0,"zhengzhao":2,"race":"人类","title":"驿长","default_actions":,"pighead":0,"combat_exp":800,"jingli":0,"long":"杜宽担任雪亭镇的驿长已经有十几年了，虽然期间有几次升迁的机会，但是他都因为舍不得离开而放弃了，这次应风子的邀请，终于走出ES2，来到这里当驿站站长，风子对他很是感激。","shen":0,"str":19,"bellicosity":0,"max_jing":155,"int":13,"attitude":"friendly","area_id":"yzyizhan","area_name":"扬州驿站","con":29,"area_file":"/d/city/npc/post_officer.c","dex":14,"kar":14,"startroom":"/d/city/postoffice","per":17,"name":"杜宽","jing":155,"age":43,"gender":"男性","qi":220,"ziyuan":"信件","food":63,"zhongcheng":22,"kaifa":40,"jizhi":65,"water":63,"last_save":1207139874,"max_qi":220,"id":"post officer","neili":0,"eff_jingli":0,])
