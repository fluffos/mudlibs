dbase (["chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"max_jingli":40000,"no_suck":1,"eff_qi":160,"eff_jing":40000,"actions":,"shen_type":1,"zhengzhao":1,"race":"人类","con":10,"default_actions":,"dex":13,"pighead":0,"kar":12,"startroom":"/d/city2/shuyuan","per":24,"name":"顾炎武","age":65,"jing":40000,"gender":"男性","food":35,"qi":160,"last_save":1207989500,"water":35,"max_qi":160,"combat_exp":400000,"jingli":40000,"id":"gu yanwu","shen":40000,"neili":0,"str":11,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","chat_chance":3,"max_jing":40000,"int":20,])
