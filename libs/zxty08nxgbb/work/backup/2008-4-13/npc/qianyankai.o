dbase (["chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"eff_qi":233,"max_neili":100,"eff_jing":200,"attitude":"friendly","actions":,"env":(["wimpy":50,]),"area_id":"yzqianzhuang","shen_type":1,"race":"人类","area_name":"扬州钱庄","con":18,"title":"钱庄老板","default_actions":,"area_file":"/d/city/npc/qian.c","dex":18,"pighead":0,"kar":24,"no_put":1,"startroom":"/d/city/qianzhuang","per":11,"nickname":"铁公鸡","name":"钱眼开","jing":200,"age":34,"gender":"男性","food":35,"qi":233,"ziyuan":"黄金","kaifa":40,"jizhi":55,"last_save":1207995363,"water":35,"jiali":10,"max_qi":233,"combat_exp":12500,"id":"qian yankai","shen":0,"neili":200,"str":100,"chat_chance":2,"max_jing":200,"int":24,])
