dbase (["short":"天寰阁","no_fight":1,"long":"天寰阁是洛阳城里最著名的店铺，整个铺面装修得相当精美雅致，显出东都洛阳繁华大方的气派。不过店里的货柜上却空无一物，看样子已经很久没人来打理了。","owner":"VOID_SHOP","no_beg":1,"objects":(["/d/shop/waiter":1,]),"no_clean_up":0,"no_steal":1,"exits":(["east":"/d/shop/bei2",]),"outdoors":"player","shop_type":0,"no_wield":1,"open_long":"天寰阁是洛阳城里最著名的店铺，整个铺面装修得相当精美雅致，显出东都洛阳繁华大方的气派。店铺里的伙计正招呼着客人，忙得满头大汗。",])
