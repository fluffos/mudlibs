dbase (["area_id":"yzqianzhuang","shen":0,"food":44,"max_neili":100,"per":16,"age":34,"eff_qi":233,"max_jing":200,"kar":23,"id":"qian yankai","name":"钱眼开","int":24,"dex":18,"startroom":"/d/city/qianzhuang","con":18,"str":100,"neili":200,"default_actions":,"nickname":"铁公鸡","gender":"男性","pighead":0,"kaifa":40,"env":(["wimpy":50,]),"qi":233,"actions":,"eff_jing":200,"jizhi":55,"combat_exp":12500,"last_save":1208279158,"shen_type":1,"no_put":1,"chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"race":"人类","title":"钱庄老板","jing":200,"jiali":10,"ziyuan":"黄金","chat_chance":2,"area_file":"/d/city/npc/qian.c","water":44,"max_qi":233,"attitude":"friendly","area_name":"扬州钱庄",])
