dbase (["shen":40000,"food":13,"age":65,"per":27,"max_jingli":40000,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","max_jing":40000,"kar":24,"eff_qi":274,"id":"gu yanwu","name":"顾炎武","dex":14,"int":20,"startroom":"/d/city2/shuyuan","con":29,"neili":0,"str":26,"jingli":40000,"gender":"男性","default_actions":,"pighead":0,"qi":274,"actions":,"eff_jing":40000,"combat_exp":400000,"last_save":1208271957,"shen_type":1,"chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"no_suck":1,"race":"人类","jing":40000,"chat_chance":3,"water":13,"max_qi":274,"zhengzhao":1,])
