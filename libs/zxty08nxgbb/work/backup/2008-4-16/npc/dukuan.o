dbase (["shen":0,"area_id":"yzyizhan","food":0,"age":43,"per":17,"long":"杜宽担任雪亭镇的驿长已经有十几年了，虽然期间有几次升迁的机会，但是他都因为舍不得离开而放弃了，这次应风子的邀请，终于走出ES2，来到这里当驿站站长，风子对他很是感激。","eff_qi":220,"kar":14,"int":13,"dex":14,"id":"post officer","con":29,"str":19,"jingli":0,"gender":"男性","kaifa":40,"pighead":0,"qi":220,"jizhi":65,"combat_exp":800,"shen_type":0,"zhongcheng":30,"eff_jingli":0,"title":"驿长","attitude":"friendly","zhengzhao":2,"max_jing":155,"name":"杜宽","startroom":"/d/city/postoffice","bellicosity":0,"neili":0,"max_zhongcheng":99,"default_actions":,"actions":,"eff_jing":155,"last_save":1208270379,"race":"人类","ziyuan":"信件","jing":155,"area_file":"/d/city/npc/post_officer.c","inquiry":(["驿站":"是啊... 这里就是扬州驿，你要寄信吗？","风子":"我老朋友呀！他看扬州邮件混乱，百姓叫苦连天，让我来当这里的驿站站长。他可是一个好巫师哟！",]),"max_qi":220,"water":0,"area_name":"扬州驿站",])
