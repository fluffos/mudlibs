dbase (["shen":0,"combat_exp":12500,"last_save":1208511200,"con":18,"str":100,"dex":18,"kar":15,"int":24,"per":25,"jing":200,"name":"钱眼开","max_neili":100,"attitude":"friendly","gender":"男性","pighead":0,"max_qi":233,"id":"qian yankai","neili":200,"race":"人类","qi":233,"area_id":"yzqianzhuang","nickname":"铁公鸡","eff_qi":233,"max_jing":200,"eff_jing":200,"jiali":10,"age":34,"food":26,"area_name":"扬州钱庄","chat_chance":2,"water":26,"area_file":"/d/city/npc/qian.c","shen_type":1,"chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"actions":,"ziyuan":"黄金","kaifa":40,"jizhi":55,"startroom":"/d/city/qianzhuang","default_actions":,"no_put":1,"env":(["wimpy":50,]),"title":"钱庄老板",])
