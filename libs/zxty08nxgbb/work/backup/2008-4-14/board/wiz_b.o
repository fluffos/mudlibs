#/d/board/wiz_b.c
dbase (["name":"巫师留言簿","no_get":1,"capacity":300,"board_id":"wiz_b","location":"/d/wizard/wizard_room","id":"board","long":"这是一个专供巫师使用的留言板。","notes":({(["author":"医生","owner":"landy","title":"about meng-zhu.c","time":1208033646,"msg":"添加了检查盟主数量，超过一个就自动删掉本身但并不是最根本的解决方法，admin更新后请即时查看/log/Dest_MengZhu.txt文件，以便判断是什么时间产生的问题，有无规律可寻，另外许多地方，比如泰山的南天门用了诸如load_object()这样的函数，这样如果没有载入的话，就会自动载入那个object，问题有可能存在于setup()当某处长时间无人经过的时候，它会将这个物件清除内存，然而此时有人经过南天门load_object()判断到没有载入盟主物件，就会创建它。可能会导致出现多个NPC。也可能不是这样的问题。目前暂时可以用destruct解决。不过无法彻底。请查看ftp. thanks!",]),(["author":"医生","owner":"landy","title":"About tell_user()","time":1208034743,"msg":"新增加超越函数tell_user()支持超长字串。宽度大于tell_object()一倍。",]),(["author":"医生","owner":"landy","title":"Error 无法察看log","time":1208053453,"msg":"【出错精灵】执行时段错误：*Error in loading object '/d/mingjiao/npc/lengqian'程式：inherit/room/room.c 第 22 行",]),}),])
