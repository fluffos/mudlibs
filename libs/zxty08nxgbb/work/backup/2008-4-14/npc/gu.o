dbase (["neili":0,"per":29,"chat_chance":3,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","eff_jing":40000,"id":"gu yanwu","name":"顾炎武","kar":24,"dex":14,"max_jing":40000,"max_qi":208,"con":18,"actions":,"gender":"男性","race":"人类","shen_type":1,"qi":208,"pighead":0,"default_actions":,"combat_exp":400000,"max_jingli":40000,"water":56,"jingli":40000,"last_save":1208074564,"shen":40000,"eff_qi":208,"int":17,"str":13,"food":56,"no_suck":1,"zhengzhao":1,"age":65,"startroom":"/d/city2/shuyuan","chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"jing":40000,])
