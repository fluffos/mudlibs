dbase (["neili":500,"per":12,"chat_chance":15,"long":"韦春芳是当朝鹿鼎公兼红花会总舵主韦小宝他娘，虽是徐娘半老，但风韵犹存。","eff_jing":100,"id":"wei chunfang","kar":27,"dex":25,"max_jing":100,"con":25,"inquiry":(["韦小宝":"那是我的乖儿子，长得就像你。","丽春院":"我们丽春院可是扬州城里头一份的找乐子去处。","name":"老娘我就是韦春芳。","here":"我们丽春院可是扬州城里头一份的找乐子去处。",]),"gender":"女性","qi":300,"shen_type":1,"pighead":0,"default_actions":,"max_neili":500,"combat_exp":25000,"title":"丽春院老板娘","attitude":"friendly","jingli":0,"disable_type":" <昏迷不醒>","zhengzhao":3,"startroom":"/d/city/lichunyuan","eff_jingli":0,"kaifa":40,"hunmi":0,"name":"韦春芳","max_qi":300,"bellicosity":0,"zhongcheng":29,"actions":,"race":"人类","no_get":100,"max_zhongcheng":94,"channel":(["say_count":1,"last_say":1208043474,]),"water":9,"last_save":1208074910,"int":25,"shen":2500,"eff_qi":300,"jizhi":65,"str":25,"food":9,"age":42,"area_id":"lichunyuan","area_file":"/d/city/lichunyuan.c","ziyuan":"美女","area_name":"丽春院","jing":100,"chat_msg":({"韦春芳得意地说道：当年老娘我标致得很，每天有好几个客人。","韦春芳怒骂道：辣块妈妈，要是罗刹鬼、红毛鬼子到丽春院来，老娘用大扫帚拍了出去。","韦春芳对你说道：你一双眼睛贼忒嘻嘻的，真像那个喇嘛！",}),])
