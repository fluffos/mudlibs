dbase (["neili":0,"per":17,"long":"杜宽担任雪亭镇的驿长已经有十几年了，虽然期间有几次升迁的机会，但是他都因为舍不得离开而放弃了，这次应风子的邀请，终于走出ES2，来到这里当驿站站长，风子对他很是感激。","eff_jing":155,"id":"post officer","kar":14,"dex":14,"max_jing":155,"con":29,"inquiry":(["驿站":"是啊... 这里就是扬州驿，你要寄信吗？","风子":"我老朋友呀！他看扬州邮件混乱，百姓叫苦连天，让我来当这里的驿站站长。他可是一个好巫师哟！",]),"gender":"男性","qi":220,"shen_type":0,"pighead":0,"default_actions":,"combat_exp":800,"title":"驿长","attitude":"friendly","jingli":0,"zhengzhao":1,"startroom":"/d/city/postoffice","eff_jingli":0,"kaifa":40,"name":"杜宽","max_qi":220,"bellicosity":0,"zhongcheng":30,"actions":,"race":"人类","max_zhongcheng":94,"water":63,"last_save":1207139874,"int":13,"shen":0,"eff_qi":220,"jizhi":65,"str":19,"food":63,"age":43,"area_id":"yzyizhan","area_file":"/d/city/npc/post_officer.c","ziyuan":"信件","area_name":"扬州驿站","jing":155,])
