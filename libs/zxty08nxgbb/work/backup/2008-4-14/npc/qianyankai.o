dbase (["kaifa":40,"neili":200,"jiali":10,"per":30,"eff_jing":200,"chat_chance":2,"kar":13,"id":"qian yankai","name":"钱眼开","dex":18,"max_qi":233,"max_jing":200,"con":18,"no_put":1,"actions":,"gender":"男性","race":"人类","qi":233,"shen_type":1,"pighead":0,"default_actions":,"title":"钱庄老板","max_neili":100,"combat_exp":12500,"water":21,"attitude":"friendly","last_save":1208082921,"eff_qi":233,"env":(["wimpy":50,]),"shen":0,"int":24,"str":100,"jizhi":55,"food":21,"nickname":"铁公鸡","age":34,"area_id":"yzqianzhuang","area_file":"/d/city/npc/qian.c","startroom":"/d/city/qianzhuang","ziyuan":"黄金","area_name":"扬州钱庄","jing":200,"chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),])
