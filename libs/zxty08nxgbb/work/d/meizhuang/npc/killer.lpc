inherit NPC;
void create()
{
        set_name("杀手", ({ "killer", "shashou" }) );
        set("gender", "男性");
        set("age", 30);
        set("long", "他是一个身行健壮的杀手，两臂粗壮，膀阔腰圆。满脸的凶相。\n");
        set("attitude", "aggressive");
        set("str", 26);
        set("con", 30);
        set("int", 30);
        set("dex", 25);
        set("max_qi", 500);
        set("max_jing", 300);
        set("neili", 500);
        set("max_neili", 500);
        set("jiaji", 50);
        set("combat_exp", 500000);
        set("chat_chance",50);
        set_skill("dodge",200);
        set_skill("unarmed",300);
        set_skill("force",300);
        set_skill("parry",200);
        set_temp("apply/attack", 25);
        set_temp("apply/damage", 20);
        set_temp("apply/armor", 18);
        set_temp("apply/defence",20);
        setup();
        carry_object("/clone/cloth/cloth")->wear();
}

