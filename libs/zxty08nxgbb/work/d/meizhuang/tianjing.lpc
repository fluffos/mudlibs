#include <room.h>

inherit ROOM;
void create() {
  set("short", "天井");
  set("long", @LONG
穿过大门，就来到一个大天井。天井左右各植一棵老梅，
枝干如铁，极是苍劲。
LONG
  );
  set("outdoors", "chengdu");
  set("objects", ([
    __DIR__ "npc/dingjian": 1,
  ]));
  set("exits", ([
    "north": __DIR__ "biwu3",
    "south": __DIR__ "damen",
    "west": __DIR__ "biwu1",
    "east": __DIR__ "biwu2",
  ]));
  setup();

}
int valid_leave(object me, string dir) {

  if (dir == "north" && objectp(present("ding jian", environment(me))))


    return notify_fail(HIW "\n 丁坚喝道：要想见梅庄庄主，先要胜过我手中长剑,! \n\n" NOR);

  return ::valid_leave(me, dir);
}
