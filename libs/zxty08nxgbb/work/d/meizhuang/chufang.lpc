inherit ROOM;
void create()
{
   set("short", "厨房");
    set("long", @LONG
这是梅庄的厨房，中央摆着大圆桌，周围则放着几张竹椅。窗口
还摆着几盆水仙花。你吸了一下鼻子，好香！也不知到底是花香还是
饭香。
LONG
    );
    set("exits",([
     "north" :__DIR__"lang3",
]));
    set("objects", ([
        __DIR__"npc/ruhua" : 1,
   ]) );
    setup();
}
