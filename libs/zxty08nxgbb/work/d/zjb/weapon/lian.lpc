// By zjb@ty 2002-5-15

#include <ansi.h> 
inherit ROOM; 
int check_name(string str,object me);
int do_fen(object me,object obj);
int do_zhu(object me,object obj);
int do_jinshu2(object me,object obj);
void create()
{
        set("short", HIR"合成室"NOR);
        set("long", @LONG
这里是星空为大家写的兵器合成室，大家可以拿着自己辛苦找到的
稀有金属和兵器来这里合成出厉害的合成兵器!
LONG
        );
        set("exits", ([
  "west" : "/d/changan/ca8",
        ]));
        set("no_fight",1);
        set("no_beg",1);
        set("no_steal",1);
        setup();
}

void init()
{ 
        add_action("do_weapon","weapon");
        add_action("do_fenweapon","fen");
        add_action("do_jinshu","jinshu");
        add_action("do_hecheng","hecheng"); 
}

int check_name(string name,object me)
{
        int i;

        i = strlen(name);

       if( (strlen(name) < 4) || (strlen(name) > 50 ) ) {
              tell_object(me,"合成兵器名字请定在50个位数。\n");
                return 0;
        }
        while(i--) {
                if( name[i]<=' ' ) {
                  tell_object(me,"对不起，你的合成兵器名字中不能用控制字符。\n");
                        return 0;
                }
        }
        return 1;
}

int do_fenweapon(string arg)
{
    object obj;
    object ob;
    object me = this_player();

    if(!arg) return notify_fail("你要放什么兵器进去？\n");

    if( !me->query_temp("tyweapon/lb"))
    return notify_fail("合成兵器必须要先放好主兵器,要不然无法合成!\n");

    if( !objectp(obj = present(arg, me)) )
    return notify_fail("你身上并没有这样东西!\n");

    return do_fen(me, obj);
}

int do_jinshu(string arg)
{
    object obj;
    object ob;
    object me = this_player();

    if(!arg) return notify_fail("你要放什么金属进去？\n");

    if( !me->query_temp("tyweapon/lb"))
    return notify_fail("合成兵器必须要先放好主兵器,要不然无法合成!\n");

    if( !objectp(obj = present(arg, me)) )
    return notify_fail("你身上并没有这样东西!\n");

    return do_jinshu2(me, obj);
}

int do_weapon(string arg)
{
    object obj;
    object ob;
    object me = this_player();

    if(!arg) return notify_fail("你要拿什么兵器当主兵器？\n");

    if( !objectp(obj = present(arg, me)) )
    return notify_fail("你身上并没有这样东西!\n");

  if(me->is_busy())
  return notify_fail("您现在正忙,等一下再放进去吧!\n");


    return do_zhu(me, obj);

}

int do_hecheng(string arg)
{
    string w_name, id, lb;
    object weapon;
    object me = this_player();
    lb = me->query_temp("tyweapon/lb");

    if (!arg) return notify_fail("你给合成兵器取个名字呀!\n");

    if (!me->query_temp("tyweapon/lb"))
    return notify_fail("你没放主兵器合成个屁!!\n");

   if (!me->query_temp("tyweapon/fen"))
   return notify_fail("你没放分兵器合成个屁!!\n");

    sscanf(arg ,"%s" ,w_name);

        if(! check_name(w_name,me))        return 1;

    if(!w_name)
    return notify_fail("什么?(使用hecheng 合成兵器的名字\n)");

    w_name = replace_string(w_name, "$BLK$", BLK);
    w_name = replace_string(w_name, "$RED$", RED);
    w_name = replace_string(w_name, "$GRN$", GRN);
    w_name = replace_string(w_name, "$YEL$", YEL);
    w_name = replace_string(w_name, "$BLU$", BLU);
    w_name = replace_string(w_name, "$MAG$", MAG);
    w_name = replace_string(w_name, "$CYN$", CYN);
    w_name = replace_string(w_name, "$WHT$", WHT);
    w_name = replace_string(w_name, "$HIR$", HIR);
    w_name = replace_string(w_name, "$HIG$", HIG);
    w_name = replace_string(w_name, "$HIY$", HIY);
    w_name = replace_string(w_name, "$HIB$", HIB);
    w_name = replace_string(w_name, "$HIM$", HIM);
    w_name = replace_string(w_name, "$HIC$", HIC);
    w_name = replace_string(w_name, "$HIW$", HIW);
    w_name = replace_string(w_name, "$NOR$", NOR);
    if ( me->query_temp("tyweapon/con") )
    me->set("hecheng/con",me->query_temp("tyweapon/con"));
    if ( me->query_temp("tyweapon/dex") )
    me->set("hecheng/dex",me->query_temp("tyweapon/dex"));
    if ( me->query_temp("tyweapon/int") )
    me->set("hecheng/int",me->query_temp("tyweapon/int"));
    if ( me->query_temp("tyweapon/str") )
    me->set("hecheng/str",me->query_temp("tyweapon/str"));

    me->set("hecheng/name",w_name+NOR);  
    me->set("hecheng/id","hecheng "+lb+"");     
    me->set("hecheng/lb",lb);    
    me->set("hecheng/damage",me->query_temp("tyweapon/damage"));
    me->delete_temp("tyweapon");
    weapon=new("/d/zjb/weapon/weapon",1);
    weapon->move(this_player());
    message_vision(HIG"$N合成武器成功!\n"NOR,me);
    return 1;
}

int do_fen(object me,object obj)
{
    object ob;
    string arg=obj->short(1);
   
    if (me->query_temp("tyweapon/fen"))
    return notify_fail("你已经放过分兵器了!\n");
   

    foreach ( ob in all_inventory(me)){
    if (ob->short(1)!=arg) continue;
   if (!ob->query("skill_type")) {
    write("这样东西并不能拿来合成!\n");
    return 1;
    }

    if ( ob ) {
    if ( base_name(ob) == "/d/zjb/weapon/weapon" )
    return notify_fail("拿合成兵器来合成？你想用BUG啊!\n");
    }
    if ( ob->query("zhuren")) {
    if (me->query("id") != ob->query("zhuren")) 
       return notify_fail("你不是这把自制武器的主人，不能使用!!\n");
    }
   if( ob->query("equipped") )
     return notify_fail("这个兵器你已经装备着了，不能合成。\n");
    if (me->query_temp("tyweapon/name")==""+ob->name()+"")
    return notify_fail("你已经把"+ob->name()+"当主兵器放进去合成了!\n");

   me->add_temp("tyweapon/damage",random(ob->query("weapon_prop/damage")));
    me->set_temp("tyweapon/fen",1);
    write(HIB"你把"+ob->name()+HIB"放进去做分兵器!\n"NOR);
    destruct(ob);
    return 1;
    }
}

int do_zhu(object me,object obj)
{
    object ob;
    string arg=obj->short(1);
    me = this_player();

    if (me->query("hecheng"))
    return notify_fail("对不起你已经有"+me->query("hecheng/name")+"做合成兵器了，不能再合成了!\n");

    if (me->query_temp("tyweapon/lb"))
    return notify_fail("对不起你已经"+me->query_temp("tyweapon/name")+"做主兵器了!\n");

    foreach ( ob in all_inventory(me)){
    if (ob->short(1)!=arg) continue;
    if (!ob->query("skill_type")) {
    write("这样东西不是兵器吧??\n");
      return 1;
    }

    if ( ob ) {
    if ( base_name(ob) == "/d/zjb/weapon/weapon" )
    return notify_fail("拿合成兵器来合成？你想用BUG啊!\n");
    }

    if ( ob->query("zhuren")) {
    if (me->query("id") != ob->query("zhuren")) 
       return notify_fail("你不是这把自制武器的主人，不能使用!!\n");
    }

   if( ob->query("equipped") )
     return notify_fail("这个兵器你已经装备着了，不能合成。\n");
    write(HIR"你拿"+ob->name()+HIR"做主兵器!\n"NOR);
    me->set_temp("tyweapon/lb",ob->query("skill_type"));
    me->set_temp("tyweapon/name",""+ob->name()+"");
    if ( ob->query("weapon_prop/damage") > 500 )
    me->set_temp("tyweapon/damage", 500);
    else
    me->set_temp("tyweapon/damage",ob->query("weapon_prop/damage"));
    destruct(ob);
    return 1;
    }
}
int do_jinshu2(object me,object obj)
{
    object ob;
    string arg=obj->short(1);
   
    if (me->query_temp("tyweapon/jinshu")>=2)
    return notify_fail("合成一次最多只能放2个金属!\n");
   
    foreach ( ob in all_inventory(me)){
    if (ob->short(1)!=arg) continue;
    if (!ob->query("skill_type")&&!ob->query("ty_weapon")) {
    write("这样东西并不能拿来合成!\n");
    return 1;
    }
  
    if ( ob->query("int") ) 
    me->add_temp("tyweapon/int",ob->query("int"));
  
    if ( ob->query("str") ) 
    me->add_temp("tyweapon/str",ob->query("str"));    

    if ( ob->query("dex") ) 
    me->add_temp("tyweapon/dex",ob->query("dex"));
  
    if ( ob->query("con") ) 
   me->add_temp("tyweapon/con",ob->query("con"));
 
    if ( ob->query("damage") ) 
    me->add_temp("tyweapon/damage",ob->query("damage"));

   me->add_temp("tyweapon/jinshu",1);
    write(HIB"你把"+ob->name()+HIB"这样金属放进去准备合成!\n"NOR);
    destruct(ob);
    return 1;
    }
}
