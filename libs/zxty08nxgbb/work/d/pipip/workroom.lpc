//小P之家

inherit ROOM;

void create() {
  set("short", HBMAG "小P之家" NOR);
  set("long", HBBLU @LONG 
    这里就是白痴小P住的地方，如何？很帅吧？ 
   _  ___                               _ _ _ _ 
  | |/ (_)                             | | | | |
  | ' / _ ___ ___   _   _  ___  _   _  | | | | |
  |  < | / __/ __| | | | |/ _ \| | | | | | | | |
  | . \| \__ \__ \ | |_| | (_) | |_| | |_|_|_|_|
  |_|\_\_|___/___/  \__, |\___/ \__,_| (_|_|_|_)
                     __/ |                      
                    |___/                       

LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "gc": "/d/city/guangchang",
    "tree": "/d/city/chatroom",
    "yuzh": "/u/yuzh/workroom",
    "zjb": "/u/zjb/workroom",
    "yahoo": "/u/zjb/yahoo",
    "ashima": "d/yihua/ashima",
    "daniel": "/u/daniel/workroom",
    "wizr": "/d/wizard/wizard_room",
  ]));

  set("valid_startroom", 1);
  set("no_clean_up", 0);
  set("sleep_room", 1);
  set("no_magic", 1);
  set("freeze", 1);
  set("no_fight", 1);
  set("objects", ([
    "d/pipip/npc/pipip": 1
  ]));


  setup();
  call_other("/clone/board/pipip_b", "???");
}

void init() {
  add_action("do_study", "study");
  add_action("do_pick", "open");
}
int do_study() {
  message_vision("小P突然出现在$N面前，骂道：臭贼！难道你想污染我家吗？！！\n", this_player());
  return 1;
}

int do_pick(string arg) {
  object sword, me = this_player();

  if (!arg || arg == "") return 0;
  if (me->query("id") != "pipip") return 0;

  if (arg == "西门家的箱子") {
    if (query_temp("nasword")) {
      message_vision("$N想去拿星空币,发现已经被人拿了\n", this_player());
      return 1;
    }
    message_vision(
      HIY "$N在箱子里拿出星空币!\n" NOR, this_player());
    me->add("zjb_money", 20000);
    set_temp("nasword", 100);
    me->set_temp("pipip_money", 1);
    //message("channel:chat", HBRED HIG"〖江湖通缉令〗"+me->query("name")+"在〖小P之家〗盗取了大量的星空币，各路好汉请协作擒拿此贼！\n"NOR,users()); 
    return 1;
  }
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir != "tree" && !wizardp(me))
    return notify_fail("没经过小P的同意不许到处乱跑！！\n");
  return ::valid_leave(me, dir);
}
