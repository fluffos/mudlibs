inherit ITEM;
void create() {
  set_name(HIG "智慧丸" NOR, ({ "int wan", "wan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me = this_player();
  int maxneili, neili;
  neili = me->query("neili");
  maxneili = me->query("max_neili");


  me->add("int", random(5));
  me->set("xmas1", 0);
  message_vision(HIG "一口吞下智慧丸，只觉有一股清香之气正慢慢由脑中溢出。\n" NOR, me);
  destruct(this_object());
  return 1;
}
