inherit ROOM;
void create() {
  set("short", "VIP商店");
  set("long", @LONG
    这是天涯唯一的一家VIP商店，据说可购买到走江湖必备的一些物品。但
由于商店刚刚开业，商品种类还不太多，店主正紧张购置货物上架，或许你过段时
间会有意外发现。
摊上立着一块招牌(zhaopai)。
LONG
  );
  set("item_desc", ([
    "zhaopai": "请用 \"list\" 列出货物表，\"buy\" 向老板购物\"check\" 查询天涯币数量。\n\n首次使用的vip玩家，请ask seller about vip可获得赠送的40天涯币\n",
  ]));
  set("exits", ([
    "west": "/d/city/kedian",
    "east": "/d/vip/shop/cunroom",
    "north": "/d/vip/shop/viproom",

  ]));
  set("objects", ([
    "/d/vip/shop/seller": 1,
  ]));
  set("no_fight", 1);
  setup();
  replace_program(ROOM);
}
