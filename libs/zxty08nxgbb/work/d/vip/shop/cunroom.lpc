inherit ROOM;
void create() {
  set("short", "存放室");
  set("long", @LONG
    这是天涯的存放室，地方非常宽敞，一个个大大小小的储存柜整齐的
摆在四周，房间的中央立着一块招牌(zhaopai)。
LONG
  );
  set("item_desc", ([
    "zhaopai": "请用 \"check\" 列出存放的物品，\"na\" 从储存柜中拿出物品\"cun\" 存物品到储存柜中。\n\n要使用储存柜的玩家，请到VIP商定购买储存柜使用协议，并\n输入指令use xieyi，即可获得本月储存柜的使用权限！\n\n",
  ]));
  set("exits", ([
    "west": "/d/vip/shop/shop",
  ]));
  set("objects", ([
    "/d/vip/shop/cunnpc": 1,
  ]));
  set("no_fight", 1);
  setup();
}
