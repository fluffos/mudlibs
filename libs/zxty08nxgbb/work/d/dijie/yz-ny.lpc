inherit ITEM;
void create()
{
        set_name(HIC"地界牌"NOR, ({ "dijie pai","pai"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "往北走再做船就是南阳城了,往西走就是华山村了,往南走就是扬州北门了!!\n");
                set("unit", "个"); 
                set("no_get",1);
                set("no_drop",1);             
                set("no_put",1);
                set("no_give",1);   
                set("value",10000000);
        }
    setup();
}

