#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
    set_name(HIG"真武神剑"NOR, ({ "zhenwu sword", "sword","zhenwu" }));
    set_weight(50000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "柄");
        set("long", HIG"真武神剑是武当掌门张三丰的随身配剑，剑身由翠玉打造，隐隐浮现“真武”字样！\n"NOR);
        set("no_give", 1);
        set("flag",1);
        set("material", "steel");
        set("weapon_prop/strength", 30);
        set("wield_msg", HIG "$N“唰”的一声抽出$n" + HIW + "，但见绿光吞吐....$N不由得从心底升起一股仙气。\n" NOR);

        set("unwield_msg", HIG "真武神剑"HIG"幻作一道绿光，「唰」地飞入剑鞘。\n" NOR);

    }
      init_sword(500,1);
    setup();
}
int move(mixed dest)
{
        if(! userp(dest))       return ::move(dest);
        if( ::move(dest)==0)    return 0;
         message("channel:rumor",HIB"【神兵利器】"+ "某人：真武神剑被"+
        dest->query("name")+"抢到手了！\n"NOR,users());

        return 1;
}

