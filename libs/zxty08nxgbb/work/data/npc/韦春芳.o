dbase (["actions":,"shen_type":1,"age":42,"food":25,"default_actions":,"race":"人类","max_zhongcheng":93,"zhengzhao":2,"water":25,"area_id":"lichunyuan","con":25,"long":"韦春芳是当朝鹿鼎公兼红花会总舵主韦小宝他娘，虽是徐娘半老，但风韵犹存。","dex":25,"jing":100,"kar":27,"shen":2500,"per":12,"max_qi":300,"neili":500,"name":"韦春芳","no_get":100,"tybang":(["banghui":"[1;36m烟[1;37m波[1;34m瀛洲[1;31m阁[2;37;0m",]),"chat_chance":15,"title":"丽春院老板娘","gender":"女性","inquiry":(["name":"老娘我就是韦春芳。","here":"我们丽春院可是扬州城里头一份的找乐子去处。","韦小宝":"那是我的乖儿子，长得就像你。","丽春院":"我们丽春院可是扬州城里头一份的找乐子去处。",]),"banghui":"$HIC$烟$HIW$波$HIB$瀛洲$HIR$阁","chat_msg":({"韦春芳得意地说道：当年老娘我标致得很，每天有好几个客人。","韦春芳怒骂道：辣块妈妈，要是罗刹鬼、红毛鬼子到丽春院来，老娘用大扫帚拍了出去。","韦春芳对你说道：你一双眼睛贼忒嘻嘻的，真像那个喇嘛！",}),"attitude":"friendly","startroom":"/d/city/lichunyuan","id":"wei chunfang","bellicosity":0,"eff_qi":300,"eff_jing":100,"combat_exp":25000,"str":25,"channel":(["say_count":2,"last_say":1209446742,]),"int":25,"last_save":1209916462,"hunmi":0,"disable_type":" <昏迷不醒>","max_neili":500,"area_name":"丽春院","area_file":"/d/city/lichunyuan.c","max_jing":100,"jingli":0,"eff_jingli":0,"qi":300,"ziyuan":"美女","kaifa":40,"zhongcheng":28,"pighead":0,"jizhi":65,])
