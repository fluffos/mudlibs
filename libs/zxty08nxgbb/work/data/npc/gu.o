dbase (["actions":,"shen_type":1,"age":65,"food":249,"default_actions":,"race":"人类","zhengzhao":1,"water":249,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","con":22,"dex":29,"jing":40000,"kar":19,"shen":40000,"per":21,"max_qi":232,"no_suck":1,"neili":0,"name":"顾炎武","chat_chance":3,"gender":"男性","chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"startroom":"/d/city2/shuyuan","id":"gu yanwu","eff_qi":232,"eff_jing":40000,"combat_exp":400000,"str":24,"int":12,"last_save":1211735427,"max_jingli":40000,"max_jing":40000,"jingli":40000,"qi":232,"pighead":0,])
