int setguaiskill(int chooseguai,int level,object guai)
{  
   guai=this_object();
//   set_std_skills(level,guai);
   switch (chooseguai)
    {
      case 0:set_gumu_guai(level,guai);break;
      case 1:set_emei_guai(level,guai);break;
      case 2:set_quanzhen_guai(level,guai);break;
      case 3:set_wudang_guai(level,guai);break;
      case 4:set_shaolin_guai(level,guai);break;
      case 5:set_baituo_guai(level,guai);break;
      case 6:set_gaibang_guai(level,guai);break;
      case 7:set_huashan_guai(level,guai);break;
      case 8:set_xingxiu_guai(level,guai);break;
      case 9:set_mingjiao_guai(level,guai);break;
      case 10:set_shenlong_guai(level,guai);break;
      case 11:set_taohua_guai(level,guai);break;
      case 10:set_xiaoyao_guai(level,guai);break;
      case 11:set_xueshan_guai(level,guai);break;
      default:set_mz_guai(level,guai);break;
    }
}
//怪怎么也会疗伤?
void heart_beat()
{
   
   int qi,effqi,maxqi;
   maxqi=(int)this_object()->query_temp("maxqi");   
   effqi=(int)this_object()->query("eff_qi");
   qi=query("qi");
      if (effqi<maxqi/3) command("exert heal");

   ::heart_beat();
}

int check_time()
{
   if (!query_temp("appear")) 
     {
       set_temp("appear",1);
       call_out("check_time",900);

       return 1;
     }
   if (me->is_fighting()) 
     {
       call_out("check_time",600);
       return 1;
     }
   remove_call_out("check_time");
   message_vision(MAG"$N眼见情况不妙，大叫一声，溜了。\n"NOR,
);
   destruct (this_object());
}


void die ()
{
        int pot,exp,qn;
                int reward_exp,reward_pot,level=0;
        object killerob,me;
        mixed questob;
        me=this_object();
                    

        if(objectp(questob= me->query_temp("player")))
                questob->set_temp("kill",0); 
        // 如果不是属于被杀而是意外死亡
        if(!objectp(killerob=me->query_temp("last_damage_from"))
        ||!userp(me->query_temp("last_damage_from")))
        {   
                message_vision("$N惨叫一声，死了。\n",this_object());
                tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
                destruct(me);
                return;    
        }
        // 如果打晕和造成死亡的不同一个人
        else if(objectp(killertemp))
        {
                if (killertemp!=killerob)
                {
                        message_vision("$N惨叫一声，死了。\n",this_object());
                        tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
                        destruct(me);
                        return;
                }
        }
        
        if(objectp(killerob) && objectp(questob)
                && killerob->query("id") != questob->query("id"))
        { 
                message_vision("$N惨叫一声，死了。\n",this_object());
                tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
                destruct(me);
                return;
        }
        
        message_vision("$N惨叫一声，死了。\n",this_object());
if ( questob )
MIS_REW->give_reward_questguai_n(questob); 
// CHANNEL_D->do_channel(this_object(),"rumor",questob->name(1)+"将"+HIR+"(通缉犯)"+CYN+this_object()->name()+HIM"就地处决了，得到了"HIY+(exp)+HIM"点经验和"HIY+(pot)+HIM+"点潜能的奖励！\n");
//        }
                destruct(me);
}
//不能让别人帮忙打晕怪   
void unconcious()
{
        killertemp=query_temp("last_damage_from");
        die();
}
void init()
{
        if (is_busy()) return;
        add_action("do_drive","drive");
        username=query_temp("killername");
        if((int)environment(me)->query("no_fight")) return; 
        if(this_player()->query("id")==username)
        {
                if(query_temp("firstsee")==0||!query_temp("firstsee"))
                { 
                        if(random(40)>20){     
                                message_vision(HIR"$N恶狠狠地盯着$n，大叫一声，竟然找上门来了，今天不是你死就是我亡！\n"NOR,
                                this_object(),this_player());
                                this_object()->kill_ob(this_player());  
                                command("follow "+this_player()->query("id"));}
                                else this_object()->command("? "+this_player()->query("id"));
                                set_temp("firstsee",1);
          }

        if(random(40)<20) 
                this_object()->kill_ob(this_player());
        }   
}
int do_drive(string arg)
{

        mapping exits;
        string *dirs;
        int size;

        if(id(arg))
        {
                if(environment()->query("no_fight"))
                {
                        exits=environment()->query("exits");      
                        dirs=keys(exits);
                        size=sizeof(dirs);
                if (size>0)
                { 
                        this_player()->command("follow "+this_object()->query("id"));
                        command("go "+dirs[random(size)]);
                        return 1;
                        }
                }
       }
        return 0;
}

