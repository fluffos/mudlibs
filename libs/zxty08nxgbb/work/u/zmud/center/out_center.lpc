#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "\n天涯会员服务中心" NOR);
  set("long", HIW "这里便是天涯会员服务中心，正前方是一块巨大的玻璃门，\n"
    "远远望去可以看见里面的会员服务大厅。\n" NOR);
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "npc/tian": 1,
    __DIR__ "npc/yubo": 1,
  ]));
  set("exits", ([
    "enter": __DIR__ "sell",
    "south": "/d/city/kedian",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  me = this_player();
  if (dir == "enter" && objectp(present("zmud wizard", environment(me)))
    && !me->query("is_member"))
    return notify_fail(HIG "管理员跳了出来，说道：“非天涯会员不得入内”。\n" NOR);

  return ::valid_leave(me, dir);
}
