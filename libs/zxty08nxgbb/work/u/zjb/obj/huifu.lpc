inherit ITEM;
void create() {
  set_name(HIW "恢复的东西" NOR, ({ "obj", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "恢复的东西。\n");
    set("unit", "碗");
    set("value", 500000);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me = this_player();
  int food, water;
  string *skname;
  mapping skills;
  int i;

  skills = me->query_skills();
  if (mapp(skills)) {
    skname = keys(skills);
    for (i = 0; i < sizeof(skname); i++)
      skills[skname[i]] *= 2;
  }
  destruct(this_object());
  return 1;
}
