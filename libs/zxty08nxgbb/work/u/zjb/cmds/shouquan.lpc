// edit by Zjb@TY

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, lp;
  string cmds, id, myid, banghui;

  myid = me->query("id");

  if (!arg)
    return notify_fail("指令格式：shouquan <某人> <指令>\n");

  if (!stringp(banghui = me->query("banghui")))
    return notify_fail("只有帮主才能使用该指令!\n");
  if (sscanf(arg, "%s del %s", id, cmds) == 2) {
    ob = present(id, environment(me));

    if (!objectp(ob = present(id, environment(me))))
      return notify_fail("这儿没有这么个人。\n");

    banghui = me->query("banghui");
    lp = new("/clone/misc/lingpai");
    lp->create(banghui);

    if (lp->query("no_use")) {
      destruct(lp);
      return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
    }

    if (lp->query("bangzhu_id") != myid) {
      destruct(lp);
      return notify_fail("您没有使用这个指令的权利。\n");
    }

    if (cmds != "renming" && cmds != "yaoqing" && cmds != "kaichu" &&
      cmds != "shouquan" && cmds != "bphelp") {
      destruct(lp);
      return notify_fail("对不起,没有该指令存在。\n");
    }

    if (cmds == "yaoqing")
      lp->add("yaoqingid", -1);

    lp->delete(cmds + "/" + id);
    lp->save();
    destruct(lp);
    message_vision(HIR "$N取消了$n使用" + cmds + "指令的权利！\n" NOR, me, ob);
    return 1;
  }

  if (sscanf(arg, "%s %s", id, cmds) == 2) {
    ob = present(id, environment(me));

    if (!objectp(ob = present(id, environment(me))))
      return notify_fail("这儿没有这么个人。\n");

    lp = new("/clone/misc/lingpai");
    lp->create(banghui);

    if (lp->query("no_use")) {
      destruct(lp);
      return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
    }

    if (lp->query("bangzhu_id") != myid && !lp->query("shouquan/" + myid)) {
      destruct(lp);
      return notify_fail("您没有使用这个指令的权利。\n");
    }

    if (cmds != "renming" && cmds != "yaoqing" && cmds != "kaichu" &&
      cmds != "shouquan" && cmds != "bphelp") {
      destruct(lp);
      return notify_fail("对不起,该指令不能授权。\n");
    }

    if (cmds == "yaoqing") {
      if (lp->query("yaoqingid") >= 3) {
        destruct(lp);
        return notify_fail("一个门派最多只有三个人使用该指令。\n");
      }
      lp->add("yaoqingid", 1);
    }
    lp->set(cmds + "/" + id, 1);
    lp->save();
    destruct(lp);
    message_vision(HIR "$N授予了$n使用" + cmds + "指令的权利！\n" NOR, me, ob);
    return 1;
  } else
    return notify_fail("指令格式：shouquan <某人> <指令>\n");
}

int help(object me) {
  write(@HELP

指令格式：shouquan <某人> <指令>
或        shouquan <某人> del <指令>

这条指令是帮主授权和取消给特殊帮众使用特殊指
令用的，目前可以授权的指令有:
        renming,kaichu,yaoqing,shouquan,bphelp
指令。
使用方法：shouquan zjb renming
提示：你授予了星空使用renming指令的权利！  
          shouquan zjb del renming      
提示：你取消了星空使用renming指令的权利！           

by Zjb@TY
HELP
  );
  return 1;
}
