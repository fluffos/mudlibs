inherit ITEM;
void create()
{
        set_name(HIR"川贝"NOR, ({ "chuan bei","bei"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗"); 
                set("value",2000000);         }
// By zjb@ty 
// 定义该草药的类别!
                set("leibie","nei");
                set("nei",2);
          set("zhuyao",2);
    setup();
}

