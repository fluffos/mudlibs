// canhe-zhi.c 参合指
inherit SKILL;
string type() { return "zhongji"; }
mapping *action = ({
  ([ "action": "$N劲风激荡，双指错落搭置，一招「目不识丁」凶狠地向$n的$l插去",
    "force": this_player()->query_skill("canhe-zhi", 1) / 3,
    "dodge": this_player()->query_skill("dodge", 1) / 6,
    "damage": this_player()->query("zjb_dj/dj") * 60,
    "parry": this_player()->query_skill("parry", 1) / 4,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N大吼一声，十指上下分飞，一招「画龙点睛」，双指直取$n的$l",
    "force": this_player()->query_skill("cuixin-zhang", 1) / 3,
    "dodge": this_player()->query_skill("dodge", 1) / 6,
    "damage": this_player()->query("zjb_dj/dj") * 60,
    "parry": this_player()->query_skill("parry", 1) / 4,
    "damage_type": "瘀伤"
  ]),
});

mapping *action2 = ({
  ([ "action": "$N十指互错，虚幻虚实，一招「" HIY "扑朔迷离" NOR "」，前后左右，瞬息间向$n攻出了六招",
    "force": this_player()->query_skill("canhe-zhi", 1) / 2,
    "dodge": this_player()->query_skill("dodge", 1) / 4,
    "damage": this_player()->query("zjb_dj/dj") * 100,
    "parry": this_player()->query_skill("parry", 1) / 2,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身行腾空而起，一招「" HIB "受宠若惊" NOR "」，来势奇快，向$n的$l猛插下去",
    "force": this_player()->query_skill("canhe-zhi", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("zjb_dj/dj") * 180,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1000,
    "damage_type": "瘀伤"
  ]),
});

mapping *action3 = ({
  ([ "action": HIY "$N身行一闪，若有若无捱到$n身前，一招「滔滔不绝」，插向$n的$l" NOR,
    "force": this_player()->query_skill("canhe-zhi", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("zjb_dj/dj") * 180,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": HIB "$N一招「退避三舍」，右手一拳击出，左掌化指，一掌一指凌空击向$n的$l" NOR,
    "force": this_player()->query_skill("canhe-zhi", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("zjb_dj/dj") * 180,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1200,
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int valid_combine(string combo) { return combo == "xingyi-zhang"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练参合指必须空手。\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 15)
    return notify_fail("你的神元功火候不够，无法学参合指。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练参合指。\n");
  return 1;
}


mapping query_action(object me, object weapon) {
  int i, level;
  mapping a_action;
  level = (int)me->query_skill("canhe-zhi", 1);
  me = this_player();
  if (me->query_skill("canhe-zhi", 1) < 401)
    return action[random(sizeof(action))];

  if (me->query_skill("canhe-zhi", 1) > 400
    && me->query_skill("canhe-zhi", 1) < 1001)
    return action2[random(sizeof(action2))];

  if (me->query_skill("canhe-zhi", 1) > 1000
    && me->query("zjb_dj/dj") >= 5)
    return action3[random(sizeof(action3))];

  if (me->query_skill("canhe-zhi", 1) > 1000
    && me->query("zjb_dj/dj") < 5)
    return action2[random(sizeof(action2))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;

  if (me->query_skill("canhe-zhi", 1) > 400
    && me->query_skill("shenyuan-gong", 1) > 500
    && me->query_skill("canhe-zhi", 1) < 1001
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_damage("qi", (damage_bonus - 100) / 8, me);
    return HIY "$N内息数转，神元功真气竟然透指而出，$n顿时受创！！\n" NOR;
  }

  if (me->query_skill("canhe-zhi", 1) > 1000
    && me->query("zjb_dj/dj") >= 5
    && me->query_skill("shenyuan-gong", 1) > 800
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return HIR "$N趁招式未老之时，催动神元功真气，将手指猛的一收一弹，一股凶猛指力正中$n胸前要害！！\n" NOR;
  }
}

int practice_skill(object me) {
  int lvl = me->query_skill("canhe-zhi", 1);
  int i = sizeof(action);
  mapping learned = me->query_learned();

  if (!mapp(learned)) learned = ([]);
  if (!learned["canhe-zhi"])
    while (i--) if (lvl == action[i]["lvl"]) return 0;

  if ((int)me->query("jing") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练参合指。\n");
  me->receive_damage("jing", 20);
  me->add("neili", -8);
  return 1;
}
string perform_action_file(string action)

{
  return __DIR__ "canhe-zhi/" + action;
}
