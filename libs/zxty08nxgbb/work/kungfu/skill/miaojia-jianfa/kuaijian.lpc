// kuaijian.c 快剑诀
// By Spiderii更新编辑 2007.2.17
#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;
#define MAX_HITS 15

int perform(object me, object target) {
  string weapon;
  int i;

  if (!target) target = offensive_target(me);

  if (!objectp(target)
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「快剑诀」只能对战斗中的对手使用。\n");

  if (me->query_skill("miaojia-jianfa", 1) < 120)
    return notify_fail("你的苗家剑法火候未到，无法施展「快剑诀」！\n");

  if (me->query_skill("sword") < 120)
    return notify_fail("你剑法未到炉火纯青之境，还不会使用「快剑诀」！\n");

  if ((int)me->query("neili") < me->query_skill("force") / 2)
    return notify_fail("你的内力不够使用「快剑诀」！\n");


  if ((int)me->query("jingli") < me->query_skill("force"))

    return notify_fail("你的精力不够使用「快剑诀」！\n");

  if (me->query_skill_mapped("sword") != "miaojia-jianfa"
    || me->query_skill_mapped("parry") != "miaojia-jianfa")
    return notify_fail("你现在无法使用「快剑诀」！\n");

  if (me->query_temp("mjjf_kj"))
    return notify_fail("你正在运用「快剑诀」！\n");

  if (!me->query_temp("weapon") || (me->query_temp("weapon"))->query("skill_type") != "sword")
    return notify_fail("你手中无剑怎能使用「快剑诀」！\n");

  weapon = (me->query_temp("weapon"))->query("name");

  message_vision(
    HIR "\n$N招数越来越快，突然一声轻啸，手中的" + weapon + HIR "剑光暴长，在一弹指间已向$n连刺数剑。\n\n" NOR,
    me,
    target
  );
  me->set_temp("mjjf_kj", 1);
  me->add_temp("apply/attack", me->query_skill("miaojia-jianfa", 1));

  for (i = 0; i < MAX_HITS; i++) {
    if (random(MAX_HITS) >= i) {
      if (me->query_skill_prepared("force") == "lengquan-shengong")

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
      else
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      me->add("neili", -100);
    } else {
      break;
    }
  }
  me->add("neili", -300);
  me->add_temp("apply/attack", -me->query_skill("miaojia-jianfa", 1));
  me->add("jingli", -100);
  me->delete_temp("mjjf_kj");
  me->start_perform(2 + random(3));

  return 1;
}
int help(object me) {
  write(WHT "\n苗家剑法「快剑诀」：" NOR "\n");
  write(@HELP
	 
        苗家剑法也是有名的快剑，这招「快剑诀」最能体现其中的奥义。
        
        要求：  内力大于基本内功等级两倍； 
                精力大于基本内功等级；
                基本剑法120级别以上；
                苗家剑法120级别以上；
                激发招架、剑法均为苗家剑法；
                如果有冷泉神功配合，
                且冷泉神功120等级以上，招数更加凌厉。
HELP
  );
  return 1;
}
