#include <ansi.h>

inherit F_SSERVER;
int qigong(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);


  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「" + HIG "异次元封印" NOR + "」只能对战斗中的对手使用。\n");


  if ((int)target->query("no_yiciyuan", 1))
    return notify_fail("「" + HIG "异次元封印" NOR + "」不能对他使用。\n");

  if ((int)target->query("no_dun", 1))
    return notify_fail("「" + HIG "异次元封印" NOR + "」不能对他使用。\n");

  if ((int)me->query_skill("zhanshen-lu", 1) < 1001)
    return notify_fail("你的战神录不够熟练，不会使用「" + HIY "异次元封印" NOR + "」。\n");

  if (me->query("zjb_dj/dj") < 10)
    return notify_fail("你的等级不够，无法使用「" + HIY "异次元封印" NOR + "」。\n");

  if ((int)me->query("max_neili") < 12000)
    return notify_fail("你的内力修为还不够高。\n");

  if ((int)me->query("neili") < me->query("max_neili") / 3)
    return notify_fail("你的内力不够了。\n");

  msg = HIC "
$N单手凭空划出一个耀眼的六芒星印，施出战神录最诡秘的一招" HIG "『异次元封印』\n" NOR;

  if (random(me->query("zjb_dj/dj")) > target->query("zjb_dj/dj") / 2) {
    me->start_busy(random(5));
    target->start_busy(random(4));
    me->add("neili", -(me->query("neili") / 2));
    target->move("/u/zjb/room/yiciyuan");
    msg += HIB "你只见突然挂起一阵旋风把$n挂走了！！！\n" NOR;
    message_vision(msg, me, target);
    return 1;

  } else {
    me->start_busy(4);
    me->add("neili", -(me->query("neili") / 2));
    msg += HIG "$n临危不乱,口中模模糊糊的念着什么咒语,$N的。
" HIW "『异次元封印』" HIG "根本不起作用\n" NOR;
  }
  message_vision(msg, me, target);

  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
