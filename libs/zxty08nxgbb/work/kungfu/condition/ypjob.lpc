//Ryu

#include <login.h>

int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  me->apply_condition("ypjob", duration - 1);
  if (duration == 1) {
    me->add("yipin/failure", 1);
    me->delete("yipin/done3", 1);
    me->delete_temp("xixia/guess", 1);
    me->delete_temp("xixia/okguess", 1);
    me->delete_temp("xixia/guess3_3", 1);
    me->delete_temp("xixia/guess3_2", 1);
    me->delete_temp("xixia/guess3_1", 1);
    tell_object(me, "青铁令时限已到！\n");
    me->apply_condition("ypjob", 0);
    return 1;
  }
  return 1;
}
