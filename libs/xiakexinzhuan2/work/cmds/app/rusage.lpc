// rusage.c

int main(object me)
{
        mapping info;
        int utime, stime;

        if (! SECURITY_D->valid_grant(me, "(apprentice)"))
                return 0;

        info = rusage();
        utime = info["utime"];
        stime = info["stime"];
        write(sprintf("rusage = %O\n", info));
        write("user time   = " + utime + "ms\n");
        write("system time = " + stime + "ms\n");
        write(sprintf("CPU usage   = %d%%\n", utime / ((utime + stime) / 100)));
        return 1;
}
