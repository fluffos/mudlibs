// who1.c

inherit F_CLEAN_UP;
#include <ansi.h>
int help(object me);

int main(object me, string str) {
  object where, ob, *ob_list;
  int i;
  string stri;
  seteuid(getuid());

  if (!SECURITY_D->valid_grant(me, "(wizard)"))
    return 0;

  ob_list = users();
  ob_list = sort_array(users(), "sort_user", this_object());
  ob_list = filter_array(ob_list, (: environment($1) && !$1->query("env/invisibility") :));

  switch (str) {
    case " ":
    case "-1": {
      str = HIC "   线上玩家           精        气       力      内力     经验值 潜能\n" NOR;
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      for (i = 0; i < sizeof(ob_list); i++) {
        ob = ob_list[i];
        where = environment(ob);

        str += sprintf(HIW " %-16s:  ", ob->name() + "(" + ob->query("id") + ")");
        str += sprintf(HIR "%-4d/%-4d ", ob->query("jing"), ob->query("max_jing"));
        str += sprintf(HIY "%-4d/%-4d ", ob->query("qi"), ob->query("max_qi"));
        str += sprintf(HIG "%-7d ", ob->query("jingli"));
        str += sprintf(HIB "%-4d/%-4d ", ob->query("neili"), ob->query("max_neili"));
        str += sprintf(HIM "%-7d ", ob->query("combat_exp"));
        str += sprintf(HIC "%-3d \n" NOR, ob->query("potential") - ob->query("learned_points"));
      }
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      break;
    }
    case "-2": {
      str = HIG " 玩家    年龄 存款           地址             所在       程序       \n" NOR;
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      for (i = 0; i < sizeof(ob_list); i++) {
        ob = ob_list[i];
        where = environment(ob);

        str += sprintf(HIW " %-8s:  ", ob->name());
        str += sprintf(HIR "%-2d ", ob->query("age"));
        str += sprintf(HIG "%-10d ", ob->query("balance"));
        str += sprintf(HIY "%-15s ", query_ip_name(ob));
        if (where) str += sprintf(HIM "%-10s ", where->query("short"));
        if (!where) str += sprintf("\n" NOR);
        else str += sprintf(HIC "%s\n" NOR, file_name(where));
      }
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      break;
    }
    case "-3": {
      str = HIG " 玩家      悟性-后天 根骨-后天 身法-后天 膂力-后天 福缘 容貌\n" NOR;
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      for (i = 0; i < sizeof(ob_list); i++) {
        ob = ob_list[i];
        str += sprintf(HIW " %-10s  ", ob->name());
        str += sprintf(HIR "%-2d:  ", ob->query("int"));
        str += sprintf(HIR "%-2d   ", ob->query_int());
        str += sprintf(HIG "%-2d:  ", ob->query("con"));
        str += sprintf(HIG "%-2d   ", ob->query_con());
        str += sprintf(HIY "%-2d:  ", ob->query("dex"));
        str += sprintf(HIY "%-2d   ", ob->query_dex());
        str += sprintf(HIB "%-2d:  ", ob->query("str"));
        str += sprintf(HIB "%-2d   ", ob->query_str());
        str += sprintf(HIC "%-2d   ", ob->query("kar"));
        str += sprintf(HIM "%-2d \n" NOR, ob->query("per"));
      }
      str += HIC "≡" HIW "───────────────────────────────────" HIC "≡\n" NOR;
      break;
    }
    default: return help(me);

  }

  str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
  me->start_more(str);
  return 1;
}

int sort_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;
  if (wizardp(ob2) && !wizardp(ob1)) return 1;
  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me) {
  write(@HELP
指令格式：whow [-1|-2|-3]

分类查询玩家信息。
HELP
  );
  return 1;
}
