// qinfo.c
// 获取 QUEST 信息

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        mapping qinfo;
        mapping deep_info;
        string *quest, *quest_key;
        string info, type;
        string msg, key;
        int i, j;
        function *fun;

        if (! SECURITY_D->valid_grant(me, "(admin)"))
	        return 0;

        if (! mapp(qinfo = QUEST_D->query("information")) ||
            ! sizeof(qinfo))
                return notify_fail("目前并没有任何任务信息。\n");
        
        if (! arg)
        {
                info = HIR + MUD_NAME + "目前所有的任务列表：\n" NOR
                       WHT "──────────────────\n" NOR;
                quest = keys(qinfo);
                for (i = 0; i < sizeof(quest); i++)
                {
                        type = base_name(quest[i])[strsrch(base_name(quest[i]), "/", -1) + 1..<1];
                        info += sprintf(CYN "  %-20s" WHT "(%s) " CYN "\n",
                                        quest[i]->name(), up_case(type));
                }
                info += WHT "──────────────────\n" NOR;
                info += HIR "目前一共有 " + sizeof(quest) + " 个任务物件。" NOR;
                me->start_more(info);
                return 1;
        }
        
        info = HIR "以『" NOR WHT + arg + HIR "』为名的任务关键词列表：\n" NOR
               WHT "───────────────────\n" CYN;
        quest = keys(qinfo);
        
        for (i = 0; i < sizeof(quest); i++)
        {
                if (sscanf(arg, "%s.%s", arg, key) == 2)
                {
                        info = HIR "任务『" NOR WHT + arg + HIR "』的关键词"
                               "『" NOR WHT + key + HIR "』的呼叫结果：\n"
                               WHT "────────────────────────\n" CYN;
                        msg = "";

                        if (quest[i]->name() == arg)
                        {
                                if (! mapp(deep_info = qinfo[quest[i]]) ||
                                    ! sizeof(deep_info))
                                        continue;

                                quest_key = keys(deep_info);
                                if (member_array(key, quest_key) != -1 &&
                                    functionp(fun = qinfo[quest[i]][key]))
                                {
                                        msg = evaluate(fun);
                                }
                        }
                        info += msg;
                        info += WHT "\n────────────────────────" NOR;
                        me->start_more(info);
                        return 1;
                }

                if (quest[i]->name() == arg)
                {
                        if (! mapp(deep_info = qinfo[quest[i]]) ||
                            ! sizeof(deep_info))
                                continue;
                                
                        quest_key = keys(deep_info);
                        msg = "";

                        for (j = 0; j < sizeof(quest_key); j++)
                        {
                                msg += sprintf(CYN "%-15s%s" NOR, quest_key[j],
                                                                 ((j + 1) % 3) ? "" : "\n");
                        }
                        info += msg;
                        
                        info += WHT "\n───────────────────\n" NOR;
                        info += HIR "此任务目前一共有 " + sizeof(quest_key) + " 个关键词。" NOR;
                        me->start_more(info);
                        return 1;
                }
        }
        return notify_fail("没有这个任务。\n");
}

int help()
{
        write(@HELP
指令格式：qinfo [任务名称][.关键词]

查询目前的任务信息。如果没有参数，就显示目前所有的
任务信息。如果加上了任务名称，则显示这个任务的所有
关键词。如果加上了关键词，则可以显示这个关键词的查
询结果(此功能尚不完善)。
HELP
	);
        return 1;
}