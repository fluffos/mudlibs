// chatboard.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("留言版", ({ "board" }));
	set("long", "大家都来灌灌水，一起说废话。\n");
	set("no_get", 1);
	set("capacity", 60);
}

void setup()
{
	return;
}

string query_save_file()
{
	string id;

	if(! stringp(id = query("board_id"))) return 0;
	return DATA_DIR + "board/player/" + id;
}

void set_from_me(object me, object room)
{
	set("board_id", me->query("id"));
	set_name(me->name() + "的留言版", ({ "board" }));
	restore();
	move(room);
}