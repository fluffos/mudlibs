// inherit object: knower.c
// 消息灵通人士继承此对象

// 消息灵通人士共有：
// 各地  ：店小二
// 华山村：小流氓
// 华山  ：李铁嘴
// 终南山：小流氓、小贩
// 嵩山  ：乐厚
// 古墓  ：小贩
// 星宿海：商人、牧羊人
// 苏州  ：小贩子
// 襄阳  ：黑衣大盗
// 大雪山：老板
// 大理  ：茶博士
// 成都  ：小贩

#include <ansi.h>

inherit NPC;

int is_knower() { return 1; }

// 接收打听消息
mixed accept_ask(object ob, string topic)
{
        return QUEST_D->generate_information(this_object(), ob, topic);
}
