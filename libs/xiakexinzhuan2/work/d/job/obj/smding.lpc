#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(YEL "神木王鼎" NOR, ({ "wangding", "ding" }));
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "座");
		set("long",
			HIY "一座色作深黄的小小木鼎。\n"
			"雕琢的极为精细，木质坚韧如玉，木理间隐隐约约的泛出红丝。\n" NOR);
                set("treasure", 1);
		set("value", 1200);		
                set("material", "wood");
   }
}

void init()
 { 
  if(objectp(present(this_object(), environment(this_player()))))
 { 
   add_action("do_open","open");
   add_action("do_suck","suck");
 }
}
 int do_open(string arg)
{ 
  object me,ob;
  me=this_player();
  ob=this_object();
  if((arg!="ding")&&(arg!="wangding"))
   return 0;
 if (!ob->query_temp("ding_opened",1))
{ 
 message_vision("$N 用小指和无名指夹住鼎身，以大拇指和中指夹住木鼎向左一旋。\n"
                  "轻轻的转开了鼎盖。\n",me);
 ob->set_temp("ding_opened",1);
  return 1;
}
 return notify_fail("木鼎已经打开了。\n");
}
 int do_suck(object me,object target)
{
 string msg,msg1,msg2; 
  int i,j;
   if( !target ) target = offensive_target(me);
  if (userp(target))
  return notify_fail("你只能用NPC来练毒。\n ");
   if (!(me->query_temp("xiang_ran")))
   return notify_fail("鼎中没有毒物。\n");
   if ((int)me->query_skill("poision",1)<120)
   return notify_fail("你体内聚毒不够。\n");
   if ((int)me->query_skill("huagong-dafa",1)<120)
   return notify_fail("你的化功大法修为不够。\n"); 
   if (!living(target))
   return notify_fail("你还是等他醒过来吧。\n");
   if((int)me->query("neili",1)<100)
   return notify_fail("你内力不够！\n");
   if ((int)me->query("combat_exp",1)<1.2*(int)target->query("combat_exp",1))
    return notify_fail(target->name()+"功力过浅，化炼的毒血将无法使用 。\n");
  if ((int)me->query("combat_exp",1)<5*(int)target->query("combat_exp",1))
    return notify_fail(target->name()+"功力深湛，化的毒血你无法吸收。\n");
    msg=CYN "$N脸上露出诡秘的笑容，猛然伸出右手抓住$n的手腕，向木鼎中探去。\n"; 
    msg1= "\n$n措手不及，手被拉进木鼎。\n"NOR; 
    msg2="\n $n大吃一惊，随即警觉，跳了开去。\n"NOR;
    i=random(5);
    if (i>=3)
     msg=msg+msg2;
    else
     msg=msg+msg1;
     message_vision(msg, me, target);
   if (!target->is_killing(me))
        target->kill_ob(me);
   if (i<3)
   {
     target->apply_condition("suck_posion",60);
     target->set_temp("suck_times",1);
     me->add("neili",-30);
     me->add("jing",-50);
     me->add("potential",random(10));
     me->add("combat_exp",random(30));
     me->improve_skill("poison", random(me->query("dex")));
     me->start_busy(2);
     if (random((int)target->query("suck_times")) >= 8) 
     return notify_fail(target->name()+BLU"中毒已深，无法再用来化毒了。\n"NOR);
    }
    return 1;
}
