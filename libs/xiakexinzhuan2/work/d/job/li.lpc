inherit NPC;

int ask_me();
 
void create()
{
        set_name("李力世", ({ "li lishi", "li"}));
        set("long", 
                "他就是天地会青木堂的李力世。\n"
                "这是一个高高瘦瘦的老者，满脸凄苦的神色，颔下一\n"
                "把稀稀拉拉的胡子，饱经沧桑的样子。\n");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "peaceful");
        set("shen", 3000);
        set("str", 26);
        set("int", 30);
        set("con", 26);
        set("dex", 28);
        set("max_qi", 1000);
        set("max_jing", 1500);
        set("neili", 1500);
        set("max_neili", 1500);
        set("jiali", 50);
        set("combat_exp", 300000);
  

        set_skill("force", 100);
        set_skill("yinyun-ziqi", 100);
        set_skill("dodge", 100);
        set_skill("tiyunzong", 100);
        set_skill("cuff", 130);
        set_skill("wudang-quan", 100);
        set_skill("parry", 100);
        set_skill("hand", 100);
        set_skill("juehu-shou", 120);
        set_skill("sword", 100);
        set_skill("taoism", 100);
        set_skill("literate", 100);
        set_skill("blade", 100);
        set_skill("xuanxu-daofa", 100);

        map_skill("force", "yinyun-ziqi");
        map_skill("dodge", "tiyunzong");
        map_skill("cuff", "wudang-quan");
        map_skill("hand", "juehu-shou");
        map_skill("parry", "xuanxu-daofa");
        map_skill("blade", "xuanxu-daofa");
        prepare_skill("cuff", "wudang-quan");
        prepare_skill("hand", "juehu-shou");
//        create_family("天地会", 2, "代香主");
        set("inquiry", ([
                "反清复明" : (: ask_me :),
        ]));

        setup();
        carry_object("/clone/armor/cloth")->wear();
        carry_object("/clone/weapon/blade")->wield();
}
 
mixed names = ({
        ({
        "史青山", "林震南", "宋青书", "采花贼","独脚大盗","史松",
        }),
        ({
         "狮吼子","飞天子","黯然子","温南扬","侯通海","沙通天",
        }),
        ({
         "温方悟","温方施","史叔刚","武修文","钱青健","温方达","温方义","温方山",
         "齐云敖","天狼子","包不同","风波恶","邓百川",
         }),
        ({
         "殷天正","韦一笑","杨逍","范遥","慕容复","黛绮丝","潇湘子","李莫愁", 
         "齐云敖",
         }), 
        ({
          "张昭重","成昆","丁春秋","归辛树","归二娘","胡逸之","西华子",
        }),
     });

int ask_me()
{ 
       object ob, me;
       int exp,position;
       string target;
       me = this_player();
       ob = this_object();
       exp = me->query("combat_exp",1);
       if(me->query_condition("gb_mission") || me->query_condition("guanfu_task") || me->query_condition("xx_task")
       || me->query_condition("xx_task") || me->query_condition("xx_task2") || me->query_condition("dali_songxin")){
        command("say 你现在和江湖其他帮会纠葛不清，我不能交给你任务。");
        return 1;
        }
       if(me->query_condition("thd_task2") || me->query_condition("thd_task3")){
       command("say 你正在执行天地会青木堂的任务！");
        return 1;
        }
//       if (!me->query_temp("tdh_li") && (me->query_condition("tdh_task_wait")<0)){
//        command("say 没有香主的命令，我不能交给你任务，天地会一向纪律严明。");
//        return 1;
//        }
//       if (!me->query_temp("tdh_li")){
//        command("say 没有香主的命令，我不能交给你任务，天地会一向纪律严明。");
//        return 1;
//        }
 	if(exp>=850000) position=5;
	else if(exp>=600000) position=4;
	else if(exp>=300000) position=3;
	else if(exp>=150000) position=2;
	else position=1;
        target = names[position-1][random(sizeof(names[position-1]))];
        me->set_temp("tdh_target", target);
        me->apply_condition("tdh_task1",30); 
        me->clear_condition("tdh_task_wait");
        command("say "+target+"最近投靠清廷，杀我会中兄弟，你去把此贼的人头提来，以祭亡灵！");
        if(!present("qingmu ling", me)){
        new("/d/tdh/qml")->move(me);
	message_vision("李力世把一枚青木令交给了$N。\n", me);
        return 1;
        }
          return 1;
}
int accept_object(object who, object ob,object me)
{

        if (!who->query("tdh_pass"))  return 0;
             
        if (ob->query("id") != "head" )  return 0;
            
        if ( !who->query_temp("tdh_target"))  return 0; 
  
        if (who->query_temp("tdh_target") && 
        (who->query_condition("tdh_task1")<0)){
        command("say 你来晚了，已经有人为会中兄弟报仇了。");
        return 0;
        }
        if ( ob->query("victim_name") 
        != who->query_temp("tdh_target")+"的首级") {
                command("say 天地会恩怨分明，怎能乱杀无辜呢？下次你要在违反会规我绝不客气！");
                return 0;
        }
        if ( ob->query("victim_user") ) {          
                command("say " + RANK_D->query_rude(who) + 
                        "，敢作弊！");
                return 0;
        }
        if ( ob->query("kill_by") != who) {
                command("say 天地会全是顶天立地的豪杰，你怎麽冒领其他人的功劳呢？");
                return 0;
        }
        command("say 你能手刃恶贼，使会中兄弟大仇得报，好样的！");
        who->add("tdh_job",2);
        who->clear_condition("tdh_task1");
        who->delete_temp("tdh_target");
        who->deltet_temp("tdh_li");
        call_out("destroying", 1, ob);
        call_out("ok", 1, who);
        return 1;
} 

void destroying(object obj)
{
        destruct(obj);
        return;
}
