// Room: /d/maze/smmc/entry.c

#include <ansi.h>

inherit ROOM;

#define MAZE_LEVEL      0

void failed(object me, string dir);

void create()
{
        set("short", "迷城入口");
        set("long", @LONG
只见这里山石渐多，道路曲折，一座白色的山峰巍然耸立在
前，仰望起来，雪白的山峰皎洁如玉，真如仙境一般。此处地势
与大漠的其余地方截然不同，遍地黄沙中混着粗大石砾，丘壑处
处，乱岩嶙嶙，一眼望去，山道竟有十数条之多，不知哪一条才
是正路。
LONG);

        set("outdoors", "shamo");

        set("exits", ([
                "1" : __DIR__"maze/entry",
                "2" : __DIR__"maze/entry",
                "3" : __DIR__"maze/entry",
                "4" : __DIR__"maze/entry",
                "5" : __DIR__"maze/entry",
                "6" : __DIR__"maze/entry",
                "7" : __DIR__"maze/entry",
                "8" : __DIR__"maze/entry",
                "9" : __DIR__"maze/entry",
        ]));
        
        setup();
}

int vaild_leave(object me, string dir)
{
        string entry_dir;

        if (! stringp(entry_dir = me->query_temp("entry")[MAZE_LEVEL]))
        {
                failed(me, dir);
                return notify_fail("");
        }
        if (dir != entry_dir)
        {
                failed(me, dir);
                return notify_fail("");
        }
        return 1;
}

void failed(object me, string dir)
{
        int i;
        string msg;
        object ob;
        
        if (! sscanf(dir, "%d", i))
                return;
        
        switch (i)
        {
        case 1:
                msg = "$N" NOR "小心翼翼的往第" + chinese_number(i) +
                      "个出口走去。\n" HIG "\n突然，暗处显现出" + 
                      "一只绿幽幽的眼睛，一头恶狼扑了上来！\n";
                message_sort(msg, me);
                ob = new(__DIR__ "npc/wolf");
                ob->kill_ob(me);
                break;

        default: return;
        }
        return;
}