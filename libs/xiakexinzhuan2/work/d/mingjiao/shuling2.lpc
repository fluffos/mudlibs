#include <room.h>
inherit ROOM;
void create()
{ 
       set("short","树林");
       set("long", @LONG
这是一片乱树林。几十丈高的树木簇在一块，密实的枝叶象一蓬蓬巨伞
般伸向天空，把阳光遮得丝毫也无。你一走进这这觉得阴阴森林的，你的感
觉告诉你，得赶快离开。
LONG);    
	set("exits", ([
		"south" : __DIR__"shenchu1",			
		"north" : __DIR__"shuling3",
                "west" : __DIR__"muqi",
                "east" : __DIR__"shuling4",
	]));             
	set("objects",([
          "/clone/weapon/da-shugan" : 1,
	]));
        set("outer_times", 10);
        set("outdoors", "明教光明顶");
        setup();
}

