#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", GRN "潭底" NOR);
  set("long", @LONG
潭底，忽然间一股寒气直扑而来，你不由得连打了一个寒颤。往上看，
寒冰盖顶，只透入丝丝阳光，偶有游鱼从你身连滑过。但深潭中确实太冷
，不能久留。
LONG);
  set("exits", ([
    "up": __DIR__ "bishui",
  ]));
  setup();
}
void run(object ob) {
  if (environment(ob) == this_object()) {
    remove_call_out("run");
    call_out("run", 10, ob);
    ob->set_temp("last_damage_from", "掉进潭底淹");
    ob->receive_damage("jing", 10);
    ob->receive_damage("qi", 10);
    write(BLU "\n你只觉一股剌骨的寒气直逼心头。\n\n" NOR);
  }
  return 0;

}
void init() {
  object ob = this_player();
  call_out("run", 10 + random(10), ob);
}
