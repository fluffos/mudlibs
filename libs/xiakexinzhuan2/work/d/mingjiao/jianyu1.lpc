// /d/mingjiao/jiaoyu.c
// Jay 5/27/97 -qingyun
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{ 
       set("short","监狱");
       set("long", @LONG
这里是明教的地下监狱。四面都是石壁，只有一扇铁门，只有外面的人
打开铁门才能出去。想要自已逃出去是不可能的地上十分潮湿，看来在这时
间一久必得重病。石壁上用刀子刻着一些忏悔的话语....“不应斗胆偷上光
明顶来，以到受些活罪”等言语。
LONG
     );
        set("no_fight",1);
        setup();
}
void init()
{       int i;
        object ob = this_player();
              i = ob->query_condition("random_kill",1);
        if( (int)ob->query_condition("mj_jail") <= 0 )
        {
                message("vision",
                        HIY "只听铁门匡地一响，一个昏迷不醒的的家伙被扔了进来！\n\n" NOR, 
                        environment(ob), ob);
                ob->set("startroom", "/d/mingjiao/jianyu");
                ob->apply_condition("mj_jail", i);
        }
	add_action("do_strike","strike");
	add_action("do_xiulian", ({ "dazuo", "excrcise", "tuna", "respirate" }));
}

int do_xiulian()
{
	write("一个声音在黑暗的角落里叹道：别怪我没提醒你，修炼会延长你的关押时间。\n");
	return 0;
}
 
