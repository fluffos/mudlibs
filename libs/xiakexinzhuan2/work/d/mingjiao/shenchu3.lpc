#include <room.h>
inherit ROOM;
void create() {
  set("short", "树林深处");
  set("long", @LONG
这是乱树林深处。几十丈高的树木簇在一块，密实的枝叶象一蓬蓬巨伞
般伸向天空，把阳光遮得丝毫也无。你一走进这这觉得阴阴森林的，你的感
觉告诉你，得赶快离开，不能再深入了。
LONG);
  set("exits", ([
    "south": __DIR__ "shuling4",
    "southwest": __DIR__ "shenchu2",
  ]));
  set("outer_times", 3);
  set("outdoors", "明教光明顶");
  setup();
}

#include "npc/attacker.h";
