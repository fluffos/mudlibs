#include <ansi.h>
inherit ROOM;
int ppl = 0;

void create() {
  set("short", "小冰块");
  set("long", @LONG
这是一块小浮冰，能用手脚划(hua)动它，不远之处就是一块岩石(yanshi)，从
那里可以爬上陆地。
LONG);
  set("no_fight", 1);
  set("no_get_from", 1);
  set("no_sleep_room", 1);
  set("item_desc", ([
    "yanshi": "\n那是一块露出水面的岩石。但见那火柱的周围一片青绿，原来这里是一个极大的岛屿。\n\n",
  ]));
  set("outdoors", "极北");
  setup();
}
void init() {
  object me, ob, *obj;
  int i;
  me = this_player();
  ob = this_object();
  obj = all_inventory(ob);

  if (!this_player()->query_condition("cold_wind"))
    this_player()->apply_condition("cold_wind", 1);
  for (i = 0; i < sizeof(obj); i++) {
    if (obj[i]->is_character()) {
      if (obj[i] == me) continue;
      else {
        tell_object(obj[i], HIR "只见小冰块猛得一震，沉下海去！\n" NOR);
        obj[i]->unconcious();
        obj[i]->move(__DIR__ "dbshan");
        ppl++;
        continue;
      }
      if (ppl > 0) {
        me->unconcious();
        me->move(__DIR__ "dbshan");
        ppl = 0;
        message("vision", "一个昏迷不醒的人被海水冲了上来。\n", environment(me), ({ me }));
      }
    }
  }
  delete("hua_trigger");
  add_action("do_pa", "pa");
  add_action("do_hua", "hua");
}

int do_hua() {
  object ob = this_player();
  if (ob->is_busy()) return notify_fail("你正忙着呢。\n");
  if (ob->query_temp("marks/划1")) return notify_fail("你已经划到岩石边了。\n");
  message_vision("$N手脚划动，吃力的向北边的岩石划去。\n", ob);
  ob->start_busy(1);
  if ((int)query("hua_trigger") >= 7) {
    message_vision("浮冰终于被$N划到达岩石的旁边。\n", ob);
    delete("hua_trigger");
    ob->set_temp("marks/划1", 1);
  } else add("hua_trigger", 1);
  return 1;
}
int do_pa(string arg) {
  object ob;
  ob = this_player();
  if (!ob->query_temp("marks/划1"))
    return notify_fail("你现在离岩石还很远呢。\n");
  if (!arg) return notify_fail("你要爬到那里？\n");
  if (arg != "yanshi" || arg != "岩石") {
    message_vision("\n$N坚难地爬上了岩石。\n\n", ob);
    ob->move(__DIR__ "yanshi");
    message("vision", ob->name() + "从浮冰上爬了上来，浑身上水。\n", environment(ob), ({ ob }));
    EMOTE_D->do_emote(ob, "cold", ob->query("id"));
    EMOTE_D->do_emote(ob, "cold");
    ob->start_busy(2);
    return 1;
  } else return notify_fail("你要爬到那里？\n");
}
