// /d/mingjiao/jingqi.c
// Jay 4/3/97 -qingyun
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{ 
           set("short",HIY"锐金旗"NOR);
       set("long", @LONG
这里是锐金旗所在地，明教的机关武器，都出自锐金旗之手。旗下弟子
不但武功卓越，更是一等一的暗器高手，屋内堆满各类兵器防具，正中央一
只巨大火炉，奇热难当，几个大汉正自滴汗挥锤。东西各有一条长廊。
LONG);    
	set("exits", ([
                "south" : __DIR__"zl7",
                "southeast" : __DIR__"rukou",
		"west" : __DIR__"shiwang",
		"east" : __DIR__"didao/senlin-6",
	]));             
	set("objects",([
		__DIR__"npc/dizi5"  :        3,
		__DIR__"npc/zhuang"  :        1,
	]));
        setup();
}
void init()
{
	add_action("do_datie","datie");
}
int do_datie(string arg)
{
	object me=this_player();
        object weapon;
	int neili_lost;
        neili_lost=(int)(me->query_skill("parry",1)/10);

	if (!me->query_temp("marks/打1"))
		return notify_fail("你想要干什么？\n");
        if (!me->query_temp("weapon"))
                return notify_fail("你空手行吗？\n");
	if (me->query("jing")<20)
		return notify_fail("你现在太累了，还是先休息一下吧。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "hammer")
		return notify_fail("你使用的兵器不对。\n");
	if( (int)me->query("neili") < neili_lost)
                return notify_fail("你的内力不够。\n");
        if (me->query_skill("parry",1)<70) return 0;
	if (me->query_skill("parry",1)>100)
		return notify_fail("你就是再打下去，对你也没有什么好处了。\n");

	message("vision",me->name()+"挥着铁锤，正在专心的打铁。\n",environment(me), ({me}) );
	write("你挥着铁锤，专心致致的打铁。\n");	
        me->receive_damage("jing", 15);
	me->set("neili",(int)me->query("neili")-neili_lost);
	me->improve_skill("parry", me->query_str()/2);
	return 1;
}