#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{ 
       set("short",HIG"巨木旗"NOR);
       set("long", @LONG
这里是巨木旗的所在地。这里放着各种各样的砍伐工具和一根根的大树
木，在南面有几条竖起的木大木桩(zhuang)，上面有许多被掌击过的痕迹，
，为旗中弟子平时练功之用。旗中不但有许多力大如牛的武林高手，更有许
多能工巧匠。光明顶的宏大的建筑就是出自本旗之手。因为光明顶处在高出
，所以这里是光明顶的第一道防线，当真有一夫当关万夫莫开之势。东西面
是一片阴森的大树林。
LONG);    
	set("exits", ([
		"west" : __DIR__"didao/shuling1",
		"east" : __DIR__"didao/shuling2",
                "northup" : __DIR__"gmd",
                "south" : __DIR__"tingtang",
	]));             
	set("objects", ([
		__DIR__"npc/wen"  :        1,
		__DIR__"npc/dizi1" :        3,		
	]));
        set("item_desc", ([
		"zhuang"  :  "大木桩，上面有许多被击打的痕迹。\n"
	]));
        setup();
}
void init()
{
	add_action("do_da","da");
}
int do_da(string arg)
{
	object weapon,me=this_player();
        int stlevel; 
	if(!(arg||arg=="zhuang"))
		return notify_fail("你击打什么？\n");
        if (me->query_temp("weapon"))
                return notify_fail("你必须放下手中的武器。\n");
        if (me->query("jing")<20)
                return notify_fail("你现在太累了，还是先休息一下吧。\n");
        if (me->query_skill("strike",1)>50)
                return notify_fail("你就是再打下去，对你也没有什么好处了。\n");
        stlevel = me->query_skill("strike", 1);
        if((int)me->query("combat_exp") < (int)stlevel*stlevel*stlevel/10 ) {
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
	        }
	if(arg=="zhuang"){
	        message("vision",me->name()+"对着木桩，不断的击打着。\n",environment(me), ({me}) );
		write("你对着木桩不断的击打。\n");
	        me->receive_damage("jing", random(30));
                me->receive_damage("jingli",random(30));
        	me->improve_skill("strike", (int)me->query_skill("strike", 1)/3+10);
  		return 1;
	        }
	return 1;
}
