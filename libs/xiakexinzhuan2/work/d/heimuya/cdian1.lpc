inherit ROOM;

void create()
{
	set("short", "成德殿");
	set("long", @LONG
这座殿堂阔不过三十来尺，纵深却有三百来尺，长端彼端高设一座，坐
着一个长须老者。殿中无窗，殿口点着蜡烛，老者身边却只点着两盏油灯，
相距既远，火光又暗，老者相貌如何便瞧不清楚。
LONG
	);
     
          set("exits", ([
		 "north" : __DIR__"cdian",
		 "southwest" :__DIR__"huayuan",
	]));

        set("objects", ([
//                __DIR__"npc/ " : 1,
        ]));
	setup();
	replace_program(ROOM);
}

