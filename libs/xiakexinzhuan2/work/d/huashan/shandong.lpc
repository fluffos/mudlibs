inherit ROOM;

void create()
{
	set("short", "山洞");
	set("long", "进得山洞，地上有块光溜溜的大石，数百年来，"
	            "华山派不知道有多少前辈曾在这里坐过，以致这"
	            "块大石竟坐得如此滑溜。只见石壁左侧刻着“风"
	            "清扬”三个大字，是以利器所刻，笔划苍劲，深"
	            "有半寸。");
	set("exits", ([
		"out"		: __DIR__"siguoya",
	]));
	set("indoors", "华山" );
        
	setup();
	(CLASS_D("ultra") + "/dugu")->come_here();
}

void init()
{
	object me = this_player();

	me->delete_temp("mianbi_count");
	me->delete_temp("break_flag");
	add_action("do_mianbi", "mianbi");
}

int do_mianbi()
{
	object me = this_player();

	if (me->is_busy() || me->is_fighting())
		return notify_fail("你正忙着呢。\n");

	message_vision("$N对着石壁跌坐静思，良久，若有所悟。\n", me);
	me->receive_damage("jing", 10);
	me->start_busy(random(2));
	if (!me->query_temp("break_flag")
	&& random(me->add_temp("mianbi_count", 1)) > 10) {
		me->set_temp("break_flag", 1);
		add_action("do_break", "break");
		write("你忽然有一种破壁(break wall)的欲望。\n");
	}
	return 1;
}

int do_break(string arg)
{
	object me = this_player();
	object weapon;

	if (me->is_busy() || me->is_fighting())
		return notify_fail("你正忙着呢。\n");
	if (arg != "wall")
		return notify_fail("你要打破什么？\n");
	if (query("exits/enter"))
		return notify_fail("墙壁已经被打破了。\n");

	weapon = me->query_temp("weapon");
	if (!weapon || weapon->query("skill_type") != "sword")
		return notify_fail("你手中无剑，如何破壁？\n");

	message_vision("$N提起"+weapon->name()+"，运足内力刺向石壁。\n", me);
	if (me->query("neili") < 200) {
		me->set("neili", 0);
		message_vision("只听拍的一声，"+weapon->name()+"断为两截，原来$N内力不足。\n", me);
		weapon->move(environment(me));
		weapon->set("name", "断掉的" + weapon->name());
		weapon->set("value", 49);
		weapon->set("weapon_prop", 0);
		me->unconcious();
	} else {
		me->add("neili", -200);
		message_vision("擦的一声，"+weapon->name()+"竟尔插入石壁之中，直至没柄，石壁上露出了一个洞口。\n", me);
		set("exits/enter", __DIR__"kongdao");
		call_out("close", 2);
	}
	return 1;
}

void close()
{
	tell_room(this_object(), "石块塌落下来，又堵住了洞口。\n");
	delete("exits/enter");
}

string long()
{
        object ob;
        string msg;

	msg = query("long");
        if (! objectp(ob = present("dugu qiubai", this_object())))
                return sort_string(msg, 64, 4);

        if (! ob->is_fighting())
                msg += "只见一人坐在地上，手中抱着一柄竹剑，翻了复"
                       "去的看，也不知道在研究什么。\n";
        else
                msg += "只见一人正在与" +
                       (ob->is_fighting(this_player()) ? "你" : "人") +
                       "激战，竹剑施展开来竟然有诺大的威力，真是匪夷所思。\n";

        return sort_string(msg, 64, 4);
}
