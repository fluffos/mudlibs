#include <ansi.h>

inherit NPC;

int ask_me();

void create()
{
	set_name("风清扬", ({ "feng qingyang", "feng" }));
	set("long", 
		"一位穿着朴素的老者，让人不由得心生敬仰。\n");
	create_family("华山派", 12, "剑宗长老");
	set("gender", "男性");
	set("age", 70);
    set("per", 25);
	set("attitude", "heroism");
	set("shen_type", 1);

	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	
	set("max_qi", 5000);
	set("max_jing", 3000);
	set("neili", 5000);
	set("max_neili", 5000);
	set("jiali", 100);

	set("combat_exp", 2000000);

	set_skill("force", 200);
	set_skill("dodge", 200);
	set_skill("strike", 200);
	set_skill("parry", 200);
	set_skill("sword", 200);
	set_skill("dugu-jiujian", 200);
	set_skill("zixia-gong", 200);
	map_skill("sword", "dugu-jiujian");
	map_skill("force", "zixia-gong");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({ (: perform_action, "sword.po" :) }));
	set("inquiry", ([
		"name": (: ask_me :)
	]));

	setup();
	carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/misc/cloth")->wear();
}

int ask_me()
{
	message_vision(CYN "$N叹了口气，说道：“难得世上居然还有人知道风某的名字。”\n" NOR,
		this_object());
	return 1;
}
