// yue_buqun.c 岳不群
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name("岳不群", ({ "yue buqun", "yue" }));
  set("title", "华山派第十三代掌门人");
  set("nickname", "君子剑");
  set("long", "这就是在江湖中侠名远播，疾恶如仇，华山派掌门人。");
  set("age", 40);
  set("attitude", "peaceful");
  set("vendetta_mark", "华山派");
  set("shen_type", 1);
  set("per", 22);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1000);
  set("max_jing", 500);
  set("max_neili", 2000);
  set("neili", 2000);
  set("jiali", 50);
  set("combat_exp", 900000);
  set("score", 30000);

  set_skill("strike", 150);
  set_skill("sword", 150);
  set_skill("dodge", 150);
  set_skill("unarmed", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("literate", 150);
  set_skill("zixia-gong", 150);
  set_skill("huashan-jianfa", 150);
  set_skill("huashan-shenfa", 150);

  map_skill("dodge", "huashan-shenfa");
  map_skill("force", "zixia-gong");
  map_skill("sword", "huashan-jianfa");
  map_skill("parry", "huashan-jianfa");
  map_skill("strike", "hunyuan-zhang");

  create_family("华山派", 13, "掌门");


  set("inquiry", ([
    "以气御剑": (: ask_me :),
  ]));

  set("book_count", 1);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
