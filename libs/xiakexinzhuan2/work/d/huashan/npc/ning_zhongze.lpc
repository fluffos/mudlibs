// ning_zhongze.c 宁中则

inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
    set_name("宁中则",({"ning zhongze","ning"}));
    set("title","华山派掌门夫人");
        set("long", "她是个不让须眉的女中豪杰，华山派君子剑岳不群的夫人。");
    set("gender", "女性");
        set("age", 36);
        set("attitude", "peaceful");
    set("vendetta_mark", "华山派");
    set("per", 22);
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        
        set("max_qi",2000);
        set("max_jing", 400);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 50);
        set("combat_exp", 300000);
	 set("score", 20000);
        
        set_skill("cuff",   100);
        set_skill("sword",  100);
        set_skill("dodge",  100);
        set_skill("unarmed",100); 
        set_skill("force",  100);
        set_skill("parry",  100);
        set_skill("literate",100);
        set_skill("huashan-jianfa", 100);
        set_skill("huashan-shenfa", 100);
        set_skill("huashan-neigong",100);

        map_skill("dodge", "huashan-shenfa");
        map_skill("force","huashan-neigong");
        map_skill("sword","huashan-jianfa");
        map_skill("parry","huashan-jianfa");
        
        create_family("华山派",13,"弟子");

       setup();
       carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
        
}
void attempt_apprentice(object ob)
{
	if( (string)ob->query("gender") != "女性" )
	{
		command ("say 对不起，我只收女弟子。");
		return;
	}

        command("say 咦，不错的小女孩嘛，我就收下你了。");
        command("recruit " + ob->query("id"));
        ob->set("title","华山派第十四代弟子");
}
