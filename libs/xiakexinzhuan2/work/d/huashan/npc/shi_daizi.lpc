// shi_daizi.c 施戴子

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("施戴子", ({ "shi daizi", "shi", "daizi" }));
	set("long", 
"粗手粗脚，脚夫模样的是施戴子，看起来老实吧交，不多说话，他在\n"
"同门中排行第四。\n");
	set("gender", "男性");
	set("age", 24);
	set("attitude", "peaceful");
       set("vendetta_mark", "authority");
	set("shen_type", 1);
	set("str", 23);
	set("int", 23);
	set("con", 23);
	set("dex", 23);
	
	set("max_qi", 400);
	set("max_jing", 200);
	set("neili", 400);
	set("max_neili", 400);
	set("jiali", 20);
	set("combat_exp", 40000);
	set("score", 5000);

        set_skill("sword",  50);
        set_skill("dodge",  50);
        set_skill("unarmed",50); 
        set_skill("force",  50);
        set_skill("parry",  50);
        set_skill("literate",50);
        set_skill("huashan-jianfa",  50);
        set_skill("huashan-shenfa",  50);
        set_skill("huashan-neigong",50);

	map_skill("force", "huashan-neigong");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");
       map_skill("dodge", "huashen-shenfa");
	create_family("华山派", 14, "弟子");

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        command("say 好，我就收下你，你可要为我们华山派争气。");
        command("recruit " + ob->query("id"));
        ob->set("title","华山派第十五代弟子");
}
