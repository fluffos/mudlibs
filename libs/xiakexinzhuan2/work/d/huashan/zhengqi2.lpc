// zhengqi2.c

inherit ROOM;

void create()
{
        set("short", "后堂");
	set("long", @LONG
这里是后堂，梁间有一块匾，上写着「以气御剑」四个大字，堂上布置
肃穆，两壁悬着一柄柄长剑，剑鞘黝黑，剑穗陈旧，料想是华山派前代
各宗师的佩剑，不知有多少奸邪恶贼丧生在这些前代宗师的长剑之下。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
"north" : __DIR__"zhengqi",
"south" : __DIR__"buwei2",
]));
set("objects",([
__DIR__"npc/yue_lingshan" : 1,
__DIR__"npc/dayou" : 1,
]));
	set ("item_desc", ([
		"以气御剑" : 
"四个字刚劲有力、一气荷成，尤其那个气字，简直运足了功要崩发出来一样。\n"
	])  ) ;

        set("no_clean_up", 0);

        setup();
}

int valid_leave(object me, string dir)
{
    object ob;

    if (dir == "south" && objectp(ob = present("lu dayou", environment(me))) && living(ob))
                return notify_fail(
"陆大有喝道：后面是家师寝室，这位" + RANK_D->query_respect(me) + "请止步。\n");
        return ::valid_leave(me, dir);
}
 

