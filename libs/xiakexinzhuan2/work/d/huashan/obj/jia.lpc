#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIW "兵器架" NOR, ({ "bingqi jia", "jia" }) );         
        set_weight(30000000);
        if( clonep() )
                set_default_object(__FILE__);
        else{
        set("unit", "个");
        set("long", "这是一个专门用来放各种兵器的架子。
里面有：
       铁甲(armor)，
       鞭(whip, bian)，
       棍(gun, club)，
       杖(staff, zhang)，
       剑(jian, sword)，
       刀(dao, blade)，
       令(ling)，
       锤(chui, hammer)

等武器护具。\n");
        set("material","wood");
        set("no_get",1);
        }
        setup();
}
void init()
{
    add_action("do_get",({"get","na"}));
}

int do_get(string arg)
{
  object me,ob;
  string arg1,arg2;
  me=this_player();
  if(!arg || sscanf(arg, "%s from %s", arg1, arg2)!=2)
   return notify_fail("命令格式: get <兵器名称> from jia。\n");
  if (arg2!="jia")
     return notify_fail("命令格式: get <兵器名称> from jia。\n");
    switch (arg1){
          case "sword":                
          case "jian":
                ob=new("/clone/weapon/changjian");
                ob->move(me);
                break;   
          case "blade":               
          case "dao":
                ob=new("/clone/weapon/blade");
                ob->move(me);
                break;   
          case "whip":                
          case "bian":
                ob=new("/clone/weapon/whip");
                ob->move(me);
                break;         
          case "ling":
                ob=new("/clone/weapon/tieling");
                ob->move(me);
                break;
          case "zhang":                  
          case "staff":   
                ob=new("/clone/weapon/gangzhang");
                ob->move(me);
                break;
          case "zhen":
          case "needle":
                ob=new("/clone/weapon/xiuhua");
                ob->move(me);
                break;
          case "gun":                 
          case "club":
                ob=new("clone/weapon/tiegun");
                ob->move(me);
                break;           
          case "hammer":
          case "chui":
                ob=new("clone/weapon/tiechui");
                ob->move(me);
                break;
          case "bang":
          case "stick":
                ob=new("clone/weapon/zhubang");
                ob->move(me); 
                break; 
          case  "armor":               
                ob=new("clone/armor/armor");
                ob->move(me);
                break;
          default :
                 return notify_fail("没有这种兵器。\n");
                    }

       message_vision("$N从兵器架上拿出一件$n。\n",me, ob);  
       return 1;
}