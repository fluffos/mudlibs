// island1.c 
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "小岛");
  set("long", @LONG
这是一个小岛，离岸边很近，似乎游(swim)也游得回去。岸边沙滩上
布满了贝壳，还有不少螃蟹在洞里冒着泡沫。前面不远是座岩石，旁边搭
有一个小木棚，里面还有几坛空了的酒罐。
LONG
  );
  set("outdoors", "福州");
  set("exits", ([
    "north": __DIR__ "island2",
    "west": __FILE__,
    "east": __FILE__,
    "south": __FILE__,
  ]));
  setup();
}

void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  object me = this_player();

  if (me->is_busy())
    return notify_fail("你现在正忙着呢！");
  message_vision("$N一个俯冲，跳进海里，往浪里一钻就不见了。\n", me);
  tell_object(me, "你游了一会，看到离岸边不远，往铁锚一按，跃了上去。\n");
  me->move(__DIR__ "yugang");
  tell_room(environment(me), me->name() +
    "抓着岸边铁锚，噔噔噔地爬了上来。\n", me);
  return 1;
}
