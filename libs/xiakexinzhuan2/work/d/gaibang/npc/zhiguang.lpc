// tuoboseng.c
// zhiguang.c 智光和尚
// by pishou

inherit NPC;

void create() {
  set_name("智光和尚", ({ "zhiguang", "monk" }));
  set("long",
    "一个身穿灰布衲袍的老僧，方面大耳，形貌威严。\n"
    "当年他曾发大愿心，飘洋过海，远赴海外蛮荒，\n"
    "采集异种树皮，治愈浙闽两广一带无数染了瘴毒的百姓。\n"
    "他因此而大病两场，结果武功全失，但嘉惠百姓，实非浅鲜。\n"
  );

  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 65);
  set("shen_type", 1);
  set("str", 20);
  set("int", 30);
  set("con", 25);
  set("dex", 23);
  set("max_qi", 380);
  set("max_jing", 300);
  set("neili", 380);
  set("max_neili", 380);
  set("jiali", 15);
  set("combat_exp", 50000);
  set("shen_type", 1);

  set_skill("unarmed", 40);

  setup();
  carry_object("/d/shaolin/obj/cloth")->wear();

  setup();
}

int accept_object(object me, object obj) {
  if (obj->query("name") == "金刚经") {
    command("smile");
    command("say 阿弭陀佛，多谢这位" + RANK_D->query_respect(me) + "了 ！");
    command("say 贫僧正需这本金刚经来叁照石坪上的原文啊 ！");
  }

  return 1;
}
