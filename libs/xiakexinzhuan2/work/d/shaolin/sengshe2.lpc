inherit ROOM;

void create() {
  set("short", "僧舍");
  set("long", @LONG
这里是僧众们饮食起居的地方。靠墙一溜摆着几张木床，床上铺的是篾
席。床头叠着床薄被，冬天想必很冷，僧侣们全靠扎实的内功根基御寒。地
上整齐的放着几个蒲团和木鱼。
LONG
  );
  set("sleep_room", 1);
  set("no_fight", 1);
  set("exits", ([
    "north": __DIR__ "sengshe3",
    "south": __DIR__ "sengshe1",
  ]));
  setup();
  //	replace_program(ROOM);
}
void init() {
  /* 我暂时屏蔽掉，查出来是谁干的，杀他全家！！！ >:< -yuj
      add_action("do_zwy","zwy");
*/
}
int do_zwy() {
  object me;
  int mjing, mjingli;
  me = this_player();
  mjing = (int)me->query("max_jing");
  mjingli = (int)me->query("eff_jingli");
  me->set("jing", mjing);
  me->set("jingli", mjingli);
  return 1;
}
