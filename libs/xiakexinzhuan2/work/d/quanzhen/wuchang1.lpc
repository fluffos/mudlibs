// wuchang1.c 武场
// By Lgg,1998.10

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "练功房");
        set("long", @LONG
这里是全真教弟子练功的房间。这座房间形状甚是奇特，前窄
後宽，成为梯形，东边半圆，西边却作三角形状，原来这是全真教
独有的练功室，前窄练掌，後宽使指，东圆研剑，西角发镖。房间
中央立着几个练功用的木人，吊着几个纸册(paper)。
LONG
        );
        set("outdoors", "quanzhen");
        set("exits", ([
                "south" : __DIR__"wuchang2",
                "north" : __DIR__"houtang2",
                "southeast" : __DIR__"xiuxishi",
        ]));
        set("item_desc", ([
                "paper" : "这是一摞厚厚的牛皮纸册，用铁钉钉在墙上。好象可以
用来练掌法的，打打(da paper)试试看。\n",
                       ]));

               setup();
}
void init()
{
	add_action("do_strike", "da");
}
int do_strike(string arg)
{
	object me;
	me=this_player();
        message("vision", me->name()+"蹲了一个马步，挥掌击向牛皮纸册。\n",
        environment(me), ({me}) );
	if ((int)me->query_skill("strike",1)>100){
		      write("你狠狠地击向牛皮纸册，牛皮纸册噗的一下破了。\n");
	return 1;
	}
        me->receive_damage("jing", 30);
        me->improve_skill("strike", (me->query("int"))*3/2);
        write("你蹲了一个马步，挥掌击向牛皮纸册。\n");
	return 1;
}