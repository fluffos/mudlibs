inherit NPC;

void create() {
  set_name("空心菜", ({ "kongxin cai", "cai", }));
  set("gender", "女性");
  set("age", 4 + random(5));
  set("long", "她是戚芳和万圭的女儿，容貌清秀脱俗。\n");
  set("shen_type", 1);
  set("combat_exp", 3000);
  set("str", 18);
  set("dex", 18);
  set("con", 18);
  set("int", 19);
  set("attitude", "friendly");
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
