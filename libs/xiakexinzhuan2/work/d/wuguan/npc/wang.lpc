
inherit NPC;
#include <ansi.h>

int give_food();
int give_water();
string* foods = ({
       FOOD_D("rice"),
       FOOD_D("mantou"),
       FOOD_D("doufu"),
       FOOD_D("baozi"),
       FOOD_D("yuebing"),
       FOOD_D("zongzi"),
       FOOD_D("shanguo"),
       FOOD_D("fan"),
       });
void create()
{
       set_name("王厨子", ({ "wang chuzi", "chuzi", "wang" }) );
       set("gender", "男性" );
       set("age", 50);
       set("long","他是襄阳武馆的厨子，胖胖的，敦厚老实。\n");
       set("combat_exp", 2500);
       set("attitude", "friendly");
       set("inquiry", ([
             "手艺" : "我做饭的手艺可是襄阳一绝，整个襄阳城谁不夸我！嘿嘿！",
	     "食物" : (: give_food :),
	     "水" : (: give_water :),	
       ]) );
       setup();
}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

int give_food()
{
       object food, me, ob, *obj;
       int i;
       
       me = this_object();
       ob = this_player();

       obj = deep_inventory(me);
       i = sizeof(obj);
       while (i--) 
          if (obj[i]->query("food_remaining")){
              command("say 谁知盘中餐，粒粒皆辛苦！你先把你身上的食物吃掉再说吧。");
              return 0;
              }
       obj = all_inventory(environment(me));
       i = sizeof(obj);
       while (i--) 
          if (obj[i]->query("food_remaining")){
	      command("say 谁知盘中餐，粒粒皆辛苦！你先把地上的食物捡起来吃掉吧。");
              return 0;
	      } 
       command("say 谁知盘中餐，粒粒皆辛苦！别浪费了。用 i 看看你身上的食物，用 eat 吃食物。");
       food = new( foods[random(sizeof(foods))] );
       food->move(ob);
       message_vision("$N交给$n一碗吃的。\n", me, ob);
       return 1;
}
 
int give_water()
{
       object water, me, ob;
       me = this_object();
       ob = this_player();

       if ( objectp(present("tea", environment(me)))){ 
	     command("say 谁知盘中餐，粒粒皆辛苦！你先把地上的茶喝掉吧。");
             return 1;
             } 
       if (present("tea", ob)) { 
	     command("say 你先把身上的茶喝掉吧。");
             return 1;
	     } 
       water = new(FOOD_D("dawancha"));
       water->move(ob);
       command("say 用 i 看看你身上的食物，用 drink 来喝水。");
       message_vision("$N倒了一杯大碗茶交给$n。\n", me, ob);
       return 1;
}
void greeting(object ob)
{
	if( !ob || environment(ob) != environment() || ob->query("combat_exp") > 2500 ) return;
         
       command("pat "+ob->query("id"));
       command("say 这里是饭厅，可以向我要食物"HBCYN HIY"(ask wang about 食物)"NOR"和喝的"HBCYN HIY"(ask wang about 水)"NOR"。\n");
}
