// qiantang.c

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "钱塘江畔");
        set("long", @LONG
钱塘江，每年八月十八是观潮的好日子。“八月十八潮，壮观天
下无”，乃是杭州一大奇景。东边便是平湖秋月的胜景。
LONG);
        set("exits", ([
            "east"    : __DIR__"pinghuqiuyue",
        ]));
        set("objects", ([
            __DIR__"npc/jian-ke" : 1,
        ]));
        set("outdoors", "hangzhou");
        setup();
        replace_program(ROOM);
}
