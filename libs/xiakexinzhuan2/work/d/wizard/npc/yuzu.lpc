// yuzu.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name("狱卒", ({ "yu zu", "zu" }));
  set("title", HIG "永死不得超生" NOR);
  set("gender", "男性");
  set("age", 23);
  set("long", "这是负责看管违规玩家的狱卒。\n");
  set("level", 15);
  setup();

  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  if (!wizardp(this_player()))
    add_action("do_nothing", "");
}

int do_nothing() {
  object me = this_player();

  message_vision("$N抽了$n一鞭子道：“好好站着别动，过" +
    CHINESE_D->chinese_period(me->query_time_to_leave())
    + "放你出去！”\n", this_object(), me);
  return 1;
}
