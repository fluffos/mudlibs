inherit ROOM;

void create()
{
	set("short", "大理盐局");
	set("long", @LONG
这是一座结构宏伟的建筑，左右石坛上各插着一根两丈多高的旗杆，
杆上锦旗飘扬。大理境内盛产井盐，这里的盐有不少都运往中原，官
府为了便于管理, 征得盐税, 特设了大理盐局, 直接听命于朝廷。入
口处有一堆盐商在说笑。
LONG
	);

	set("exits", ([
		"west" : __DIR__"beijie4",
	]));

	set("objects", ([
	        "/d/city/npc/yanshang" : 2,
               "/d/city/npc/yanxiao" : 1,
	]));

	setup();
	replace_program(ROOM);
}

