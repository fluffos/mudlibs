#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "暖阁");
	set("long", @LONG
这里是镇南王平时歇息的地方，四周都有火炉，整个阁子里暖暖和和的，
地上铺者地毯，整个房间都透着一种雍容华贵的氛围。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	    "west" : __DIR__"lang3",
	    ]));
	 set("objects", ([
    __DIR__"npc/dzc" : 1
        ]) );
	 setup();
}
void init()
{
   object me;   
     mapping my_fam;
        me = this_player();
         if (me->query("family"))
        my_fam=me->query("family");       
               
       if ( (me->query("class")=="swordsman")&& (my_fam["family_name"] == "天龙寺")){
            me->set("class", "officer");
                write(HIG "系统已将您的「头衔」转换为「官差」。\n" NOR);
        }
        
}

