inherit ROOM;

void create()
{
	set("short", "荷花池");
	set("long", @LONG
直往西行，垂杨夹道，荷池分列两旁。每当盛夏，那“出淤泥而不染”
的荷花、荷叶或浮或立，密密层层，如碧玉盘，中捧莲花，白、粉、红、深
红、洒金，五色焕然。若值雨后，珠滚玉盘，微风徐来，清香国溢，更令人
快意。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
		"east" : __DIR__"dg1",
		"west" : __DIR__"dg3",
	]));

	setup();
	replace_program(ROOM);
}
