// shuhou.c
// bbb 1997/06/11

inherit ROOM;


void create() {
  set("short", "树丛后");
  set("long", @LONG
这里光秃秃的一大片石壁，爬满藤蔓，但见石壁平整异常，宛然一面铜
镜，只是比湖西的山壁小了许多，再细看那石壁，也只平整光滑而已，别无
他异。
LONG
  );
  set("exits", ([
    "out": __DIR__ "shulin1",
  ]));

  setup();
}

void init() {
  add_action("do_down", "tear");
  add_action("do_down", "si");
}

int do_down(string arg) {
  object me = this_player();
  message_vision("$N把石壁上的藤蔓撕得干干净净，走向后面。\n", me);
  me->move(__DIR__ "shibi");
  return 1;
}
