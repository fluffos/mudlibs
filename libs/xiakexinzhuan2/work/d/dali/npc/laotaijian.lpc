//  taijian2.c
inherit NPC;

void create()
{
	set_name("老太监", ({ "lao taijian","taijian" }) );
	set("gender", "无性");
	set("age", 50);
	set("long",
		"这是大理皇宫内的一个老太监，正在前去镇南王府传圣旨。\n");
	set("combat_exp", 14000);
	set("shen_type", 1);
	set("attitude", "friendly");
	set("inquiry", ([
	"name" :"你问我名字干嘛？有什么好事啊？",
	]) );
	setup();

	set("apply/attack", 30);
	set("apply/defense", 30);

	set_skill("unarmed", 40);
	set_skill("strike", 40);
	set_skill("parry", 40);
	set_skill("dodge", 46);
	setup();

	carry_object("/clone/misc/cloth")->wear();
}       

