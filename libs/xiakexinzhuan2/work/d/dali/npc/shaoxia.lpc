inherit NPC;

void create()
{
	set_name("李少侠", ({ "li shaoxia", "li","shaoxia" }));
	set("long", 
		"一名年轻的少年游侠，自称姓李。\n");
	set("gender", "男性");
	set("age", 19);
	set("attitude", "heroism");
	set("shen_type", 1);

	set("str", 25);
	set("int", 20);
	set("con", 25);
	set("dex", 20);
	
    set("qi", 500);
 	set("max_qi", 500);
	set("max_jing", 200);
	set("neili", 300);
	set("max_neili", 300);

	set("combat_exp", 25000);

	set_skill("force", 50);
	set_skill("dodge", 50);
	set_skill("unarmed", 50);
	set_skill("parry", 50);
       set_skill("liuhe-daofa", 60);
	set_skill("blade", 50);
       set_skill("huntian-qigong", 50);
       set_skill("tiyunzong", 50);
       map_skill("force", "huntian-qigong");
       map_skill("blade", "liuhe-daofa");
       map_skill("dodge", "tiyunzong");
       set("inquiry", ([
        "name" : "在下姓李，名明,字笔昂。",
	"天龙寺" : "天龙寺在大理西门外向北走，怎么，你也想去拜天龙寺。",
	"拜天龙寺" : "我拜了几次都没成，听人讲要持一封什么[推荐信]才能拜的。",
	"推荐信" : "这我也不大清楚了，你问问别人吧。",
	]) );
	setup();

       set("chat_chance", 10);
        set("chat_msg", ({
	"李少侠高兴的说道: “听说天龙寺的一阳指威力无比，不知道我能否拜到天龙寺去！”\n",
       "李少侠自言：“现在天龙收徒越来越难了，也不知怎样才能拜成！”\n",
	       (: random_move :)
        }) );


	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/blade")->wield();
}
