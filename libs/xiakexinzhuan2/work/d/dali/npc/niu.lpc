// niu.c

#include <ansi.h>

inherit NPC;

void create()
{
     set_name("绝色美女",({"niu","nu"}));
    set("gender","女性");
set("age",19);
 set("long", "她年轻貌美，身材丰满，一脸的微笑就象春天一样。\n");
                       set("combat_exp", 350000);
set("attitude", "friendly");
  set("rank_info/respect", "波霸");
	set("inquiry",([
      "name" : "我就是杀手王爷从香港挑来的，给你们提供点服务。",
"here" : "这是杀手王爷的会客室，那边有包厢，咱们去吧！",
"yuj" : "那人只知道玩MUD，其他什么都不懂。 ",
"snowman" : " 假妹妹。。。。。。不认识，不过听名字像太监。",
"jpei" : "听说他要把桃花岛建得非常好，不知道是不是吹牛？ ",
"bbb" : "这个家伙自称杀手,模样还过得去,就可惜...唉,有些话不便出口.",
"rumors" : "这里的巫师们都喜欢我，我可忙不过来了，得让杀手再叫几个我的姐妹来。",
"ahunter" : "他整天玩侠客行，也不来看我，我主人说要杀了他。",
"melin" : "他有两个名字，一个是好美丽，一个是臭鱼。后面的臭鱼才对。",
"max" : "好久没来了，我真想他。",
"limit" : "他学习很认真，好象这几天考试就要结束了，快来了。",
"swl" : "他是臭流氓一个，我不伺候他，他拿AK-47枪来威胁我。",
"stacey" : "好长时间不来，来了后总到我旁边来揩油。",
"fear" : "他喜欢看电影，给自己取名也是什么爱情片，恐怖片什么的。",
"aha" : "他是大学教师，如今教师好象很吃香的，好象国家挺重视的",
"silly" : "他自称小笨猪，其实在我给他按摩时，一点不笨。",
"networm" : "他是侠客行峨眉派的高手，泡妞也是高手。",
"outi" : "他一肚子的坏点子，要是全放在建全真教上就好了。",
"bono" : "唉....他好久没来了.",
"diary" : "她是个真正的小仙女，就是她哥哥老冒充她上来。",
"xdd" : "一个大男人，取名小丁丁？他喜欢我波霸喜欢得很。",
"qingyun" : "他建明教很辛苦，我常给他按摩,对了，他常给我小费。",
"beyond" : "这个人嘛...我看他工作认真，去给他按摩，他老动手动脚。",
"pishou" : "那可是侠客行的老玩家了，比我的主人玩的时间还早。",
"cck" : "可爱的小姑娘，不过身材可比我差远了。",
"zqb" : "唉,,,,他常被人宰，一宰就是几百块的海鲜，连泡妞都没钱了。",
"ydh" : "那人总喜欢眼睛通红的去PK人。",
"know" : "好几天没见他了，我挺想他的。",
"tansh" : "这人本来写MUD挺勤快的，现在不知怎么不来了。",
"hhxs" : "那人一天到晚胡闹，不写东西，还想升级，老来调戏我。",
	]) );
set_skill("sword",250);
set_skill("dodge",250);
set_skill("parry",250);
          setup();
	carry_object(__DIR__"obj/b-cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 0, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch(random(3)) {
		case 0:
                        say( "美女对你笑道：这位" + RANK_D->query_respect
(ob)
              + "，杀手王爷让我给你服务，先按摩好吗！\n");
            break;
		case 1:
 say("美女对" + RANK_D->query_respect(ob) + "眉目传情，说道：大爷累了吧？小女子还是大姑娘一个，难道你不想泡妞吗？ \n");
            break;
		case 2:
                        say( "美女笑咪咪地说道：这位" + RANK_D->query_respect
(ob)
                                + "，不要不好意思嘛，到包厢吧！\n");
            break;
        case 3:
			break;
	}
}
