// fansima.c 
inherit NPC;

void create()
{
	set_name("范骅", ({ "fan hua", "hua","sima" }));
	set("title", "大理国司马");
	set("gender", "男性");
	set("age", 43);
	set("str", 25);
	set("dex", 25);
	set("long", "这是个身材高大的中年人，满面红光。\n");
	set("combat_exp", 4500000);
	set("shen_type", 1);
	set("attitude", "heroism");

	set_skill("unarmed", 100);
	set_skill("force", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_temp("apply/attack", 70);
	set_temp("apply/defense", 70);
	set_temp("apply/armor", 70);
	set_temp("apply/damage", 20);

	set("max_qi", 800);
	set("neili", 800); 
	set("max_neili", 900);
	set("jiali", 20);

	setup();
}

int accept_fight(object me)
{
	command("say 本官不愿与江湖人动手过招了，今日也不想破例。");
	return 0;
}
