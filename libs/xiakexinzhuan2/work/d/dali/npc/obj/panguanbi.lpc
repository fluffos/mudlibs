#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("判官笔", ({ "panguan bi", "bi" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一对精钢打制的判官笔，可以伤人穴道。\n");
    set("value", 220);
    set("material", "iron");
    set("wield_msg", "$N拿出一对$n，在手上转了两圈，握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(20);
  setup();
}
