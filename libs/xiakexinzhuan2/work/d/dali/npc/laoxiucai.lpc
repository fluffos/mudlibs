// 老秀才

inherit NPC;
inherit F_DEALER;

void create()
{
	set_name("老秀才", ({ "lao xiucai", "xiucai","lao" }));
	set("str", 18);
	set("gender", "男性");
	set("age", 60);
	set("combat_exp", 250);
	set("attitude", "friendly");
	set("vendor_goods", ({
                  "/d/shaolin/obj/fojing1",
                  "/d/shaolin/obj/fojing3",
	}));

	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
