
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("段正淳", ({ "duan zhengchun", "duan", "master" }) );
        set("nickname", "镇南王");
        set("gender", "男性" );
        set("age", 44);
        set("str", 22);
        set("con", 23);
        set("dex", 23);
        set("int", 25);

        set("max_qi", 1800);
        set("max_jing", 1800);
        set("eff_jingli", 1000);
        set("max_neili", 3000);
        set("jiali", 20);
        
    set("rank_info/respect", "风流王爷");
        create_family("天龙寺", 13, "俗家弟子");

        set("long", 
        "段正淳是个相当高大的中年儒生，若不是跟随在他左右的铁甲卫士成群，\n"
        "你大概猜不到眼前这个温文儒雅的中年人竟是大理王爷。\n");

        set("combat_exp", 900000);
        set("score", 200000);

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );

    set_skill("parry", 120);
    set_skill("dodge", 120);
    set_skill("force", 120);
    set_skill("finger", 120);
    set_skill("buddhism", 50);
    set_skill("literate", 120);
    set_skill("strike", 120);

    set("rank_info/respect", "风流王爷");
        create_family("天龙寺", 13, "俗家弟子");

        set("long", 
        "段正淳是个相当高大的中年儒生，若不是跟随在他左右的铁甲卫士成群，\n"
        "你大概猜不到眼前这个温文儒雅的中年人竟是大理王爷。\n");

        set("combat_exp", 900000);
        set("score", 200000);

        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );

    set_skill("parry", 120);
    set_skill("dodge", 120);
    set_skill("force", 120);
    set_skill("finger", 120);
    set_skill("sword",120);
    set_skill("buddhism", 80);
    set_skill("literate", 120);
    set_skill("strike", 150);
    set_skill("qingyan-zhang", 140);
    set_skill("tianlong-shengong", 120);
    set_skill("yiyang-zhi", 120);
    set_skill("lingbo-weibu", 120);
    set_skill("duanjia-jianfa",120);
    map_skill("dodge", "lingbo-weibu");
    map_skill("parry", "yiyang-zhi");
    map_skill("finger", "yiyang-zhi");
    map_skill("force", "tianlong-shengong");
