//  /d/dali/npc/dasao.c

inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create()
{
	set_name("打铁匠", ({ "Da tie jiang", "jiang" }));
	set("shen_type", 1);

	set("gender", "男性");
	set("age", 45);
	set("long",
		"这位大汉光着上身,由于长年打铁,肌肉很是发达。\n");
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set_temp("apply/damage", 15);

	set("combat_exp", 4000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		__DIR__"obj/changjian",
		__DIR__"obj/duanjian",
                __DIR__"obj/gangdao",
                __DIR__"obj/gangjian",
                  "/d/dali/obj/tiejia",
	}));
	
	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
