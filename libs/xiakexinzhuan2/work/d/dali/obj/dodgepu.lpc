// lingbo-weibu.c

#include <armor.h>

inherit ITEM;

void create()
{
	set_name("帛卷", ({ "bo juan", "bo", "shu", "book" }));
                set("treasure", 1);
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "卷");
		set("long",
			"这是一卷帛布，上面绘着一个女子，全身一丝不挂。\n");
		set("value", 500);
		set("material", "steel");
		set("armor_prop/armor", 3 );
		set("skill", ([
			"name":	"lingbo-weibu",	// name of the skill
			"exp_required":	500,	// minimum combat experience required
			"jing_cost":	10,	// jing cost every time study this
			"difficulty":	20,	// the base int to learn this skill
			"max_skill":	29	// the maximum level you can learn
		]) );
	}
}

void init()
{
	if( this_player() == environment() )
		add_action("do_study", "study");
}

int do_study(string arg)
{
	object me = this_player();
	int level, jingcost;

	if ( arg != "bo juan" && arg != "bo" )
	return notify_fail("你要学什么？\n");

	level = me->query_skill("lingbo-weibu", 1);
	if (level > me->query_skill("dodge", 1)) {
		write("你先打好轻功的根基吧！\n");	
		return 1;
	}
	if ( me->is_fighting() && level >= 30 && level <= 100 ) {
		jingcost = level / 3 + random(level / 3);
		if (me->query("jing") <= jingcost) {
			write("你太疲倦了，先歇歇吧！\n");
			return 1;
		}
		me->receive_damage("jing", jingcost);
		me->improve_skill("lingbo-weibu", me->query("int"));
		message_vision("$N战斗中闭上双眼，回想着帛卷上的步法。\n", me);
		return 1;
	}

	return 0;
}
