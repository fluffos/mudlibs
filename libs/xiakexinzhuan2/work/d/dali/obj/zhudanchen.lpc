// zhudanchen.c

inherit NPC;

string ask_job();

void create()
{
	set_name("朱丹臣", ({ "zhu danchen", "danchen" }));
	set("title", "大理国镇南王府家将");
	set("gender", "男性");
	set("age", 33);
	set("str", 27);
	set("dex", 26);
	set("long", "这人身穿军服，却是一副书生模样，手里拿着两枝判官笔。\n");
	set("combat_exp", 400000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 100);
	set_skill("force", 100);
	set_skill("hammer", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_temp("apply/attack", 70);
	set_temp("apply/defense", 70);
	set_temp("apply/armor", 70);
	set_temp("apply/damage", 20);

	set("max_qi", 900);
	set("neili", 900); 
	set("max_neili", 900);
	set("jiali", 20);
 set("inquiry", 
                ([
                     	"巡城" : (: ask_job :),
                ]));


	setup();
	carry_object(__DIR__"obj/panguanbi")->wield();
	carry_object(__DIR__"obj/junfu")->wear();
}
void init()
{
	add_action("do_tast","task");
}
string ask_job()
{
        object me;
        object ob;
        ob=this_player();
        me=this_object();
        if (ob->query("title") != "大理国镇南王府随从")
                return RANK_D->query_respect(ob) + 
                "，你不是本王府随从，此话从何说起？";
            if (ob->query("combat_exp")>=30000)
                     return ("我看你的武功已有相当的功底了，就不用在我这里干事了，去找高侯爷吧。\n");
 if (me->query_temp("xuncheng") > 5)
		return ("现在已有足够的人在巡城了，你就等下一次吧。\n");
	me->set("xuncheng_name",ob->query("name"));
	me->add_temp("xuncheng",1);
	ob->set_temp("xuncheng",1);
	ob=new("/d/dali/obj/xuncheng-ling");
	ob->move(this_player());
	write("朱丹臣给你一块金牌。\n");
        return "好吧，你就在大理城周围四处查看一下，巡城时应当小心防范，防止外敌。";
}
int do_tast(string arg)
{
	object ob,me;
	ob=this_player();
	me=this_object();
	if(!(arg||arg=="ok")) return 0;
	if(!ob->query_temp("xuncheng")) return 0;
	if(!ob->query_temp("xunchenged")) return 0;
	if(arg=="ok"&&ob->query_temp("xunchenged")
		&&ob->query("name")==me->query("xuncheng_name"))
	{
		command("pat "+ob->query("id"));
		command("say 哈哈，真难为你了，"+RANK_D->query_respect(ob)+"，你做得好！");
		ob->add("potential",(int)(ob->query_skill("buddhism",1)/10)+10);
ob->add("combat_exp",(int)ob->query_skill("force",1)+100);
		me->delete("xuncheng_name");
		me->add_temp("xuncheng",-1);
		ob->delete_temp("xuncheng");
		ob->delete_temp("xunchenged");
		return 1;
	}
	return 1;
}


