inherit ROOM;
inherit F_DEALER;

void create()
{
	set("name", "云雪楼");
	set("short", "云雪楼");
	set("long", @LONG
这里是大理最有名的酒楼，店名来源于点苍山的云雪峰溪奇观，平时这
里高朋满座，一到节日更是要提前来定下雅间。江湖人物更是把这里当成聚
会的场所，不时有江湖豪客进进出出。
LONG
	);

	set("item_desc", ([
		"paizi" : "本店出售烤鸭及上等花雕酒。\n",
	]));

	set("objects", ([
		__DIR__"npc/xian" : 1,
	]));

	set("exits", ([
		"north" : __DIR__"xijie1",
	]));

	setup();
	replace_program(ROOM);
}
