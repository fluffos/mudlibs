// 房间样本
#include <room.h>

inherit ROOM;

string item2(object);

void create()
{
	set("short", "房间样本");
	set("long", @LONG
这是房间描述的第一行，系统会自动在开头插入四个空格，最长32个汉字，
这是第二行，最长34个汉字。
|<---------------------- 34 个汉字或 68 个英文 --------------------->|
LONG);

	set("outdoors", "位置"); //如果有这条设定表示这里是室外，可以看到天色
	set("no_fight", 1); //如果有这条设定表示这里禁止一切引发战斗的行为
	set("no_get_from", 1); //如果有这条设定表示这里禁止 get from ....
	set("sleep_room", 1); //如果有这条设定表示这里任何人都可以 sleep
	set("no_sleep_room", 1); //如果有这条设定表示这里任何人都不可以 sleep
	set("no_death", 1);	//如果有这条设定表示在这里死的不算真死
	set("valid_startroom", 1); //如果有这条设定表示在这里save下次会从这里进来

	set("item_desc", ([
		"item1": "item1 的描述\n",
		"item2": (: item2 :),
	]));
// 可以用 look item1, look item2 看

	set("objects", ([
//		文件名: 数量,
	]));
// 设置房间里的物品和 npc

	set("exits", ([
//		出口: 文件名,
	]));

	setup(); //这个函数执行后房间才能按上面的设定来产生

//	replace_program(ROOM);
// 注意！！！如果没有其他的函数才可以用这一句
}

string item2(object me)
{
	switch(random(3)) {
		case 0: return "随机的显示0\n";
		case 1: return "随机的显示1\n";
		case 2: return "随机的显示2\n";
	}
}
