// Room: /u/xdd/gumu/gmbedroom.c

#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "卧室");
  set("long", @LONG
这里是古墓弟子的休息室，房中空空洞洞，一如古墓无异。一块长条青石作床，
床上铺了张草席，一幅白布当作薄被，此外除了一根人高的绳索横过室中，别
无他物。
LONG);
  set("exits", ([
    "north": __DIR__ "gmht",
  ]));
  set("objects", ([
    __DIR__ "obj/bed": 1,
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);
  create_door("north", "石门", "south", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_zuo", "zuo");
  add_action("do_liao", "liao");
  add_action("do_sleep", "sleep");
  add_action("do_liaodu", "liaodu");
}

int do_zuo(string arg) {
  object me = this_player();

  if (arg == "bed") {
    if (me->query("qi") < 50)
      return notify_fail("你的气太少，无法抵御严寒。\n");

    message_vision("$N往寒玉床上盘腿而坐. ", me);

    if (me->query_skill("force", 1) < 30) {
      message_vision("结果还未坐稳,已怪叫一声, 从床上跳了下来,
想必是受不了千年古玉之寒气. \n", me);
      return 1;
    }

    if ((int)me->query_skill("force", 1) >= 90)
      return notify_fail("你的内功已有相当火厚,寒玉床不能再
助你修习内功了. \n");
    message_vision("借寒玉床之天然神效, 真气自然流动,
开始修习内功心法, 当真灵验无比. \n", me);
    me->receive_damage("qi", 30, me);
    me->improve_skill("force", (int)(me->query_int() / 2) +
      (int)(me->query_con() / 2));
    return 1;
  }
  return notify_fail("你要坐在哪里? \n");
}

int do_liao(string arg) {
  object me = this_player();

  if (me->is_fighting() || me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你现在身上没有受到任何伤害！\n");

  if ((int)me->query_condition("marks_bed") > 0) {
    me->add("max_neili", -1);
    message_vision(HIR "$N突然只觉得一阵奇寒侵入身体，想是
                                                         两次疗伤时隔太短，身子尚未复原之故。\n" NOR, me);
    me->unconcious();
    return 1;
  }

  if (arg == "bed") {
    message_vision("$N爬上寒玉床, 要借千年寒玉疗伤. \n", me);

    if (me->query_skill("yunu-xinjing", 1) < 30)
      return notify_fail("寒玉床疗伤需以纯熟的玉女心经内功相辅, 否则无法外疗. \n");

    me->set("eff_qi", me->query("max_qi"));
    me->apply_condition("marks_bed", 60);
    return 1;
  }
  return notify_fail("你要在哪疗伤? \n");
}

int do_sleep() {
  object me = this_player();

  if (!me->query_condition("sleep")
    && me->query_skill_mapped("force") == "yunu-xinjing"
    && random(me->query_skill("yunu-xinjing", 1)) > 50
    && random(me->query_skill("force", 1) * 10) > me->query("max_neili")
    && random(10) < 1)
    me->add("max_neili", 1);
  return 0;
}
int do_liaodu(string arg) {
  object me = this_player();

  if (me->is_fighting() || me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if ((int)this_player()->query("eff_jing") ==
    (int)this_player()->query("max_jing"))
    return notify_fail("你现在身上没有受到任何伤害！\n");

  if (!me->query_condition("snake_poison"))
    return notify_fail("你现在没有中蛇毒！\n");

  if (me->query("neili") < 100)
    return notify_fail("你内力不够！\n");

  if (arg == "bed") {
    message_vision("$N爬上寒玉床, 要借千年寒玉疗毒. \n", me);

    if (me->query_skill("yunu-xinjing", 1) < 30)
      return notify_fail("寒玉床疗毒需以纯熟的玉女心经内功相辅, 否则无法外疗. \n");
    message_vision("借寒玉床之天然神效, 开始运功疗毒, 只见丝丝黑气从指间漫出，转眼即消失，当真灵验无比. \n", me);
    me->clear_condition("snake_poison");
    me->add("neili", -100);
    return 1;
  }
  return notify_fail("你要在哪疗毒? \n");
}
