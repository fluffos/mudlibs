// Room: /u/xdd/gumu/gmhout.c

#include <ansi.h>;
#include <room.h>;
inherit ROOM;

void create() {
  set("short", BLU "树中心" NOR);
  set("long", @LONG
你七转八弄居然到了树的中心，此处阴暗暗的，十分怪异。老枝里不知藏了些什么，
看来年代久远。
LONG);
  set("exits", ([
    "out": __DIR__ "tree",
  ]));
  set("count", 5);
  setup();
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object me = this_player();

  if (arg == "tree") {
    message_vision("$N开始上下左右，里里外外仔细搜查这片树顶，想从枝叶中找出点什么。\n", me);
    me->add_temp("mark/searchtree", 1);
    if (me->query_temp("mark/searchtree") < 4)
      return 1;
    if (!query("count")) return 1;
    add("count", -1);
    message_vision("$N满面尘土，终于在一堆树叶下发现一包物件。\n", me);
    me->delete_temp("mark/searchtree");
    new(__DIR__ "obj/silkey")->move(__DIR__ "treetop");
    new(__DIR__ "obj/fengchao")->move(__DIR__ "treetop");
    new(__DIR__ "obj/book")->move(__DIR__ "treetop");
    return 1;
  }

  write("你要搜谁的身？\n");
  return 1;
}
