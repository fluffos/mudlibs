// Room: /u/xdd/gumu/gmchucang.c

#include <room.h>;
inherit ROOM;

void create()
{
     set("short", "储藏室");
     set("long", @LONG
古墓生活甚是清苦，储藏室中除了堆着些日常食品，别无他物。
LONG        );
     set("exits", ([
         "west" : __DIR__"gmht",
         "east" : __DIR__"gmqs",
         ]));    
     setup();
}
void init()
{
        add_action("do_find", ({"find","zhao","search"}));
}

int do_find(string arg)
{
        object me=this_player();
 

        if ( arg )
            return notify_fail("你找来找去什么也没找到。\n");
   if ((string)me->query("family/family_name") != "古墓派")
            return notify_fail("你没事跑到这儿找什么？\n");
        if (  present("jiang", this_player()) || present("yufeng jiang", this_player())  )
return notify_fail("你找来找去什么也没找到。\n");
      if ((int)me->query_condition("medicine") < 1)
          {
     message_vision("$N在室里找了一会，一个小瓶子突然出现在眼前,$N赶紧把它拾起来。\n", me);
               new("/clone/medicine/yufeng-jiang")->move(me);
          }
        else
       message_vision("$N找来找去什么也没找到。\n", me);
     return 1;
}
