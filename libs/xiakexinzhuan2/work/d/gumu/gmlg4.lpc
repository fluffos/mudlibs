#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
     set("short", BLU"古墓练功房4"NOR);
     set("long", @LONG
此间石室比一室稍大，但仍是仅容两人见方。石室密闭，墙上两只火
把。室内飞舞着几只麻雀。
LONG
        );
     set("exits", ([
         "south" : __DIR__"gmht",
         ]));

        setup();
}

void init()
{
     add_action("do_zhuo", "zhuo");
}

int do_zhuo()
{
     object me = this_player();
     int i;

	  if (!living(me)) return 0;

	  if ( (int)me->query_skill("dodge", 1) < 31 )
	  return notify_fail("你的基本轻功不行, 恐怕捉不到麻雀。\n");

	  if ( (int)me->query_skill("dodge", 1) > 61 )
	  return notify_fail("你不用在这里浪费时间精力了。\n");

	  if ( (int)me->query("jingli") < 60 && (int)me->query("jing") < 60 )
	  return notify_fail("你太累了, 先休息一下。\n");

	  i = me->query_skill("dodge", 1) / 10;
	  i = (int)(me->query_dex() * i / 10);
//	  i = i - 3;

	 
	  me->receive_damage("jingli", 15 + random(10));

	  if ( random(i) < 4 ) 
	  {
			 message_vision("$N气喘吁吁，累得满头大汗，别说捉到，连羽毛也碰不到一根。\n", me);}
	  else {
			 message_vision("$N累得满头大汗，终於抓到了麻雀。\n", me);
			 me->improve_skill("dodge", (int)(me->query("dex")/2) +
									 (int)(me->query_skill("dodge", 1)/5) );
	  return 1;
	       }
}






