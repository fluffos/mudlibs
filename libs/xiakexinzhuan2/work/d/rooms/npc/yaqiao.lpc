// yaqiao.c  王亚樵

#include <ansi.h>

inherit NPC;

int waiting(object me);
int do_chase(object me);
string ask_me();

void create()
{
       set_name("王亚樵", ({ "wang yaqiao", "wang" }) );
       set("title", "大亨杀手");
       set("gender", "男性" );
       set("shen_type", 1);
       set("age", 40);
       set("str", 30);
       set("con", 30);
       set("int", 30);
       set("dex", 30);
       set("no_clean_up",1);

       set("long","他是旧上海时代威震上海滩的杀手，连杜月笙都惧他三分，而且他十分爱国。\n" );

       set("combat_exp", 50000);
       set("attitude", "peaceful");
       set("chat_chance", 1);
       set("chat_msg", ({
               "王亚樵说道：青帮算个鸟，惹急了老子，一样把它操翻喽！\n",
       }) );

       set("inquiry", ([
               "杀人"   : (: ask_me :),
       ]) );

       set("max_qi", 2000);
       set("max_jing", 200);
       set("neili", 2000);
       set("max_neili", 2000);
       set("jiali", 100);
       set("env/wimpy", 60);

       set_skill("force", 200); 
       set_skill("unarmed", 200);
       set_skill("blade", 200);
       set_skill("dodge", 200);
       set_skill("parry", 200);
       
       setup();
       
       carry_object("/d/rooms/npc/obj/gun")->wield();
       carry_object(ARMOR_D("cloth"))->wear();
}

void init()
{
                 object me, ob;

                 me = this_object();
                 ob = this_player();

                 ::init();

                 if( !me->query("waiting_target") && ob->query_temp("fee_paid") )
                                        ob->delete_temp("fee_paid");

                 add_action("do_name","杀");

}

string ask_me()
{
       return "哼，说吧，要杀谁？\n";
}

int do_name(string target)
{
       object me, dest, *all;
       int i;
 
       me = this_object();
       all = users();

       if(me->query("waiting_target"))
               return notify_fail("王亚樵大大咧咧的说道：妈的，没这个人，叫我杀个屁，小心老子杀了你！\n");
       
       if( !this_player()->query_temp("fee_paid") ) 
               return notify_fail("王亚樵说道：我要养一大班兄弟，手头太紧。\n");

       if( !target) 
               return notify_fail("王亚樵恶狠狠地说道：妈了个巴子，少废话，快说是谁！\n");

       for(i=0; i<sizeof(all); i++) 
       {
               if( target == all[i]->name() || target == all[i]->query("id") )
                       dest = all[i];
       }
       
       if( !dest )
               return notify_fail("王亚樵皱了皱收说道：看来这家伙现在不在我的地盘，等他来了再说吧。\n");
               
       me->set("waiting_target", dest->query("id"));
       me->set("target_name", target);
       me->set("char", this_player());
       me->set_temp("apply/attack",  50);
       me->set_temp("apply/defense", 50);
       me->set_temp("apply/damage",  20);

       me->delete("chat_chance");
       me->delete("chat_msg");

       message("vision",
               HIY "王亚樵不经意的说道：你在这里等着，我去去就来。\n"NOR,
               environment(), me );

       me->set("pursuer", 1);
       me->set("vendetta/authority", 1);
       me->set("bellicosity", 10000);
       me->set("combat_exp", 2000000);

       message_vision("$N走了出去。\n" NOR, me);

       call_out("do_chase", 1, me);
       
       return 1;
}

int accept_object(object who, object ob)
{
       
       if (ob->query("money_id") && ob->value() >= 100 
               && !this_object()->query("waiting_target")) 
       {
               tell_object(who, "王亚樵沉下脸来：你要我帮你杀谁？\n");
               tell_object(who, "命令格式：杀 玩家的中文名或ID。\n");
               who->set_temp("fee_paid",1);
               return 1;
       }
       else if (ob->query("money_id") && ob->value() < 100) 
       {
               tell_object(who, "王亚樵说：妈的，这么少，买子弹都不够，滚！\n");
               return 1;
       }

       return 0;
}

int do_chase(object me)
{
       
       object dest;
       dest = find_player(me->query("waiting_target"));
       
       if( !objectp(dest) || !environment(dest) )      
       {
               call_out("waiting", 0, me);
               return 1;
       }
       
       me->move(environment(dest));
       message_vision("$N走了过来。\n" NOR, me);
       message_vision(HIR "$N对$n说道：嘿嘿，跟着青帮混的没有一个有好下场，"
                       +RANK_D->query_rude(dest)+"，去死吧！\n" NOR, me, dest);
       me->set_leader(dest);

       command("aim " + dest->query("id"));
       command("shoot");

       call_out("do_back", 1, me);
       return 1;
}


int do_back(object me)
{
       if(objectp(me->query("char")))
       tell_object(me->query("char"), "王亚樵大大咧咧地走过来说道：搞定了。\n王亚樵挥了挥手。\n");
       destruct(this_object());
       return 1;
}

