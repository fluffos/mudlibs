// duan2.c

#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;
int do_back(object me);

int singing() {

  if (present("qu pu", this_object())) {
    switch (random(90)) {
      case 10: command("chang yuanyuan_qu"); break;
      case 20: command("chang bosi_xiaoqu"); break;
      case 30: command("chang wenshi_jian"); break;
      case 40: command("chang dielian_hua"); break;
      case 50: command("chang wanghai_chao"); break;
      case 60: command("chang chunjiang_huayueye"); break;
      case 70: command("chang yinma_changcheng"); break;
      case 80: command("chang jiangjin_jiu"); break;
      default: break;
    }
    return 1;
  } else return 0;
  return 1;
}

string *go_place = ({
  "/d/taishan/shulin1",
  "/d/xiangyang/outnroad3",
  "/d/dali/dalics",
  "/d/emei/huayanding",
  "/d/wudang/sanqingdian",
  "/d/city/qianzhuang",
  "/d/mingjiao/qianting",
  "/d/city/beidajie3",
  "/d/gaibang/fenduo1",
  "/d/thd/kezhan",
  "/d/xingxiu/yili",
  "/d/huashan/yuquan",
  "/d/shaolin/pingtai",
  "/d/mr/yanziwu",
  "/d/guiyun/zoulang6",
  "/d/hj/caoyuan2",
  "/d/emei/baoguosi",
  "/d/xingxiu/jyg",
  "/d/jiaxing/tieqiang",
  "/d/dali/dongjie3",
  "/d/suzhou/majiu",
  //        "/d/huashan/siguoya",
  "/d/fuzhou/biaoju",
});

void create() {
  set_name("段誉", ({ "duan yu", "duan", "yu" }));
  set("con", 30);
  set("int", 30);
  set("dex", 30);
  set("str", 30);
  set("gender", "男性");
  set("age", 20);
  set("per", 28);
  set("location", 1);
  set("unique", 1);
  set("combat_exp", 1500000);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "liumai" :),
  }));
  set("chat_chance", 35);
  set("chat_msg", ({ (: random_move :), (: singing :), }));
  set("max_qi", 4000);
  set("max_jing", 3500);
  set("neili", 10000);
  set("max_neili", 10000);
  set("eff_jingli", 2500);
  set("jiali", 100);
  set("attitude", "friendly");
  set("rank_info/respect", "小王爷");
  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("finger", 200);
  set_skill("sword", 200);
  set_skill("literate", 200);
  set_skill("unarmed", 200);
  set_skill("finger", 200);
  set_skill("beiming-shengong", 200);
  set_skill("liumai-shenjian", 200);
  set_skill("lingbo-weibu", 200);
  map_skill("dodge", "lingbo-weibu");
  map_skill("force", "beiming-shengong");
  map_skill("parry", "liumai-shenjian");
  map_skill("finger", "liumai-shenjian");
  set("inquiry", ([
    "name": "在下姓段，单名一誉字，从来没学过什么武艺。",
  ]));
  setup();
  carry_object(ARMOR_D("pao3"))->wear();
  carry_object("/d/rooms/npc/obj/shan")->wield();
  carry_object("/d/other/qupu");
  carry_object("/d/other/yqin");
  add_money("gold", 10);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && ob->query("gender") == "女性") {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("follow " + ob->query("id"));
  remove_call_out("do_back");
  call_out("do_back", random(200) + 50, this_object());
  delete("chat_chance");
  switch (random(9)) {
    case 0: command("love " + ob->query("id")); break;
    case 1: command("rose " + ob->query("id")); break;
    case 2: command("ysis " + ob->query("id")); break;
    case 3: command("lean " + ob->query("id")); break;
    case 4: command("sister " + ob->query("id")); break;
    case 5: command("seduce " + ob->query("id")); break;
    case 6: command("deadlove " + ob->query("id")); break;
    case 7: command("beauty1 " + ob->query("id")); break;
    case 8: command("love " + ob->query("id")); break;
  }
}

int do_back(object me) {
  me->move(go_place[random(sizeof(go_place))]);
  tell_room(environment(me), me->query("name") + "快步走了过来。\n", ({ me }));
  me->set("chat_chance", 60);
  me->set_leader(0);
  return 1;
}

void reset() {
  remove_call_out("do_back");
  call_out("do_back", 1, this_object());
}
