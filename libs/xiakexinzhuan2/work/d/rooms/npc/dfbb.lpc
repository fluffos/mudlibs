// dfbb.c 东方不败

#include <ansi.h>
inherit NPC;
void create()
{
       set_name("东方不败", ({ "dongfang bubai", "dongfang", "bubai" }) );
       set("gender", "无性" );
       set("title", RED "日月神教教主" NOR);
       set("shen_type", -1);
       set("age", 30);
       set("str", 25);
       set("con", 30);
       set("int", 26);
       set("dex", 35);
       set("long", "他便是日月神教教主、十余年来号称武功天下第一的东方不败。
此刻他剃光了胡须，脸上施了脂粉，身穿粉红衣衫。\n" );
       set("combat_exp", 2000000);
       set("attitude", "heroism");
       create_family("日月神教", 9, "教主");
       set("max_qi", 5000);
       set("max_jing", 3000);
       set("eff_jingli", 3000);
       set("jiali", 10);

       set_skill("force", 200); 
       set_skill("kuihua-feiying", 200); 
       set_skill("kuihua-shengong", 200);
       set_skill("literate", 150);
       set_skill("dodge", 200);
       set_skill("parry", 200);
       set_skill("sword", 200);
       set_skill("claw", 200);
       set_skill("youming-zhao", 200);
       set("chat_chance_combat", 10);
       set("chat_msg_combat", ({
                (: perform_action, "claw.youming" :),
	}));
       map_skill("dodge", "kuihua-feiying");
       map_skill("sword", "kuihua-shengong");
       map_skill("force", "kuihua-shengong");
       map_skill("parry", "kuihua-shengong");
       map_skill("claw", "youming-zhao");       
       prepare_skill("claw", "youming-zhao");	     
       setup();
       set("chat_chance", 2);
       set("chat_msg", ({
 "东方不败左手拿着一个绣花绷架，右手持着一枚绣花针，抬起头来，脸有诧异之色。\n",
       }) );       
       carry_object(BINGQI_D("xiuhua"))->wield();
       carry_object(ARMOR_D("pink_cloth"))->wear();
       carry_object(ARMOR_D("flower_shoe"))->wear();
       add_money("gold", 1);
}

void kill_ob(object me)
{     
      if(!present("needle", this_object())){
             command("enable parry youming-zhao");
             }
      command("grin " + me->query("id"));
      ::kill_ob(me);     
}
