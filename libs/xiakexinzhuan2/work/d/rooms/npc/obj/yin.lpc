//yin.c

#include <ansi.h>
#include <armor.h>
inherit WRISTS;
inherit F_AUTOLOAD;

void create()
{
        set_name(HIY "武林盟主印" NOR, ({"mengzhu yin"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long",HIW "这是第三次武林大会的盟主印。\n" NOR);
                set("value", 10000000);
                set("unit", "个");
                set("no_get", 1);
                set("armor_prop/armor", 60);
                set("treasure",1);    
                set("no_drop", 1);
        }
       setup();
}


int query_autoload()
{
  return 1;
}
