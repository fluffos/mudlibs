#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(GRN"水晶"NOR, ({ "shui jin"}));
        set_weight(5);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("value", 1);
        }
        setup();
}

void init()
{
        add_action("do_sort","sort");
}

int sort2(object obj1, object obj2)
{
  int i, j;
  i=obj1->query("weapon_prop/damage");
  j=obj2->query("weapon_prop/damage");
  if (i>j) return -1;
  else if (i<j) return 1;
  else return 0;
}

int filtdata2(object obj)
{
  string name;
  if( sscanf(obj, "%s.lpc", name)!=1 )
    return 0;
  else return 1;
}

int sort1(object obj1, object obj2)
{
  int exp1,exp2;
  exp1=obj1->query("combat_exp");
  exp2=obj2->query("combat_exp");
  if (exp1>exp2) return -1;
  else if (exp1<exp2) return 1;
  else return 0;
}

int filtdata1(object obj1)
{
  object where;
  if(wizardp(obj1))
    return 0;
  where = environment(obj1);
  if(!where) 
    return 0;
  else return 1;
}

void destroy_ob(object ob)
{
                  if( ob ) destruct(ob);
}


int do_sort(string arg)
{
        int max, i;
        string name,base, arg1,out="";
        object obj1;
        mixed *ob_list,*ob_list_old;

        if (!arg)
          return notify_fail("sort <exp || dir> <sort type>。
      
Z.B：sort exp = sort all online players' exp.
     sort weapon = sort all weapons' damage in /clone/weapon.\n");
        if (arg=="exp")
          {
            ob_list_old = users();
            ob_list_old = filter_array(ob_list_old, (: filtdata1 :));
            max=sizeof(ob_list_old);
            ob_list = sort_array(ob_list_old, (: sort1 :));
            
            for (i=0;i<max;i++)
              {
                obj1 = ob_list[i];
                name = obj1->query("name")+"("+obj1->query("id")+")"+" exp: "+obj1->query("combat_exp");
                printf("No. %d: %s\n",i+1,name);
              }
            return 1;
          }    
        if (arg=="weapon")
          {
            ob_list_old = get_dir("/clone/weapon/");
            ob_list_old = filter_array(ob_list_old, (: filtdata2 :));
            max=sizeof(ob_list_old);
            for (i=0;i<max;i++) ob_list_old[i]="/clone/weapon/"+(string)ob_list_old[i];
            ob_list = sort_array(ob_list_old, (: sort2 :));
            printf(HIW"\n排列 /clone/weapon/ 下所有武器的Damage值。。。\n"NOR);
            for (i=0;i<max;i++)
              {
                obj1 = new(ob_list[i]);
                name = " - "+obj1->query("name")+"("+obj1->query("id")+")";
                base = (string)base_name(obj1)+".lpc";
                out += sprintf("No. %2d: %s%s%3d%s - %30s %s\n",i+1,HIY,"Damage: ",obj1->query("weapon_prop/damage"),NOR,base,name); 
                destruct(obj1);
              }
            this_player()->start_more(out + HIW"排列完毕。\n");
            return 1;
          }     
        
        else return notify_fail("sort <exp || dir> <sort type>。
      
Z.B：sort exp = sort all online players' exp.
     sort weapon = sort all weapons' damage in /clone/weapon.\n");
        return 1;
}




