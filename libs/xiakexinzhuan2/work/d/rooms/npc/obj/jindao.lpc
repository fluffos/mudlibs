// jindao.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
	set_name(HIM "紫金刀" NOR, ({ "jindao", "dao" }));
	set_weight(15000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄精工打造而成的紫金缅刀，燕云十八骑每人一把。\n");
		set("value", 50000);
                set("rigidity", 1);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
	}
	init_blade(45);
	setup();
}
