// yy18q.c 燕云十八骑

#include <ansi.h>
int checking();
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";
string *weapon_list = ({ "blade1", "gun", "gangjian", "chanzhang" });

void create() {
  string weapon = weapon_list[random(sizeof(weapon_list))];
  set_name("侍卫", ({ "shi wei", "shi", "wei" }));
  set("title", HIY "燕云十八骑" NOR);
  set("nickname", HIY "僧" NOR);
  set("str", 40);
  set("con", 30);
  set("int", 25);
  set("dex", 30);
  set("unique", 2);
  set("location", 1);
  set("南院", 1);
  set("gender", "男性");
  set("age", 40);
  set("luohan_winner", 1);
  set("long", "
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出少林派。\n");
  set("combat_exp", 800000 + random(100000));
  set("shen", 0);
  set("attitude", "heroism");
  set("max_qi", 2800);
  set("max_jing", 2000);
  set("max_jingli", 2500);
  set("eff_jingli", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 50);
  set("fenwo", 200);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("blade", 150);
  set_skill("cuff", 150);
  set_skill("jingang-quan", 150);
  set_skill("shaolin-shenfa", 150);
  set_skill("yijin-jing", 150);
  set_skill("ranmu-daofa", 150);
  set_skill("wuchang-zhang", 150);
  set_skill("staff", 150);
  set_skill("club", 150);
  set_skill("zui-gun", 150);
  set_skill("damo-jian", 150);
  set_skill("sword", 150);
  map_skill("sword", "damo-jian");
  map_skill("club", "zui-gun");
  map_skill("staff", "wuchang-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "ranmu-daofa");
  map_skill("force", "yijin-jing");
  map_skill("blade", "ranmu-daofa");
  map_skill("cuff", "jingang-quan");
  prepare_skill("cuff", "jingang-quan");
  set("inquiry", ([
    "停": (: stop :),
    "stop": (: stop :),
    "跟": (: follow :),
    "follow": (: follow :),
    "leave": (: leave :),
    "离开": (: leave :),
    "name": (: ask_shi :),
  ]));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "blade.fenwo" :),
    (: perform_action, "sword.sanjue" :),
    (: perform_action, "club.zuijiu" :),
  }));
  set("chat_chance", 50);
  set("chat_msg", ({ (: checking :) }));
  setup();
  carry_object(ARMOR_D("armor"))->wear();
  carry_object(BINGQI_D(weapon))->wield();
  carry_object("/d/rooms/npc/obj/jinpai");
}

int checking() {
  object master, ob;
  mixed *list;
  int i;
  ob = this_object();
  list = users();
  i = sizeof(list);
  if ((string)ob->query("master")) {
    while (i--)
      if (list[i]->query("id") == ob->query("master")) master = list[i];
    if (!master) { dest(ob); return 0; }
    if (environment(ob) != environment(master) && living(ob)
      && !ob->is_busy() && ob->query_leader() == master) {
      message_vision("$N快步离开了。\n\n", ob);
      ob->move(environment(master));
      message_vision("$N快步走了过来。\n\n", ob);
    }
  }
  if (!ob->query("master")) return 1;
  if (environment(ob) == environment(master) && !living(master))
    command("get " + master->query("id"));
  return 1;
}
