// yy18q.c 燕云十八骑

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";

void create()
{
     string weapon;
       set_name("侍卫", ({ "shi wei", "shi", "wei" }));
       set("title", HIY "燕云十八骑" NOR);
       set("nickname", HIW"侠"NOR);
       set("str", 30);
       set("con", 30);
       set("int", 30);
       set("dex", 35);
       set("unique", 2);
       set("location", 1);
       set("南院", 1);
       set("gender", "女性");
       set("age", 30);
       set("luohan_winner", 1);
       set("long","
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出峨嵋派。\n");
       set("combat_exp", 800000 + random(100000));
       set("shen", 100000); 
       set("attitude", "heroism");      
       set("max_qi", 2800);
	set("max_jing", 2000);
        set("max_jingli", 2500);
        set("eff_jingli", 2500);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali", 50);
        set_skill("dacheng-fofa", 150);
	set_skill("linji-zhuang", 150);
	set_skill("huifeng-jian", 150);
	set_skill("sixiang-zhang", 150);
	set_skill("yanxing-daofa", 150);
	set_skill("literate", 100);
	set_skill("strike", 150);
	set_skill("sword", 150);
	set_skill("blade", 150);
	set_skill("parry", 150);
	set_skill("dodge", 150);
	set_skill("force", 150);
	set_skill("anying-fuxiang", 150);
        map_skill("force", "linji-zhuang");
	map_skill("sword", "huifeng-jian");
	map_skill("blade", "yanxing-daofa");
	map_skill("parry", "yanxing-daofa");
	map_skill("dodge", "anying-fuxiang");
	map_skill("strike", "sixiang-zhang");
	prepare_skill("strike", "sixiang-zhang");
       set("chat_chance", 50);
       set("chat_msg", ({(: checking :)}));
       set("inquiry", ([
                "停" : (: stop :),
                "stop" :  (: stop :),
                "跟" :  (: follow :),
                "follow" :  (: follow :),
                "leave" :  (: leave :),
                "离开" :  (: leave :),
                "name" :  (: ask_shi :),
       ]));
       set("chat_chance_combat", 20);
       set("chat_msg_combat", ({
                (: perform_action, "sword.mie" :),
                (: perform_action, "blade.huanying" :),
	}));
       weapon = random(2)?BINGQI_D("gangjian"):BINGQI_D("blade1");
       setup();
       carry_object(ARMOR_D("armor"))->wear();
       carry_object(weapon)->wield();
       carry_object("/d/rooms/npc/obj/jinpai");
}

int checking()
{
    object master, ob;
    mixed *list;
    int i;
    ob = this_object();    
    list = users();
    i = sizeof(list);
    if((string)ob->query("master")){
       while(i--) 
              if(list[i]->query("id")==ob->query("master")) master = list[i];
       if(!master) {dest(ob); return 0;}
       if(environment(ob) != environment(master) && living(ob) 
          && !ob->is_busy() && ob->query_leader()==master){
              message_vision("$N快步离开了。\n\n", ob); 
              ob->move(environment(master));
              message_vision("$N快步走了过来。\n\n", ob); 
              }
       }  

    if(!ob->is_fighting() && (int)ob->query("eff_qi") < (int)ob->query("max_qi"))
           command("yun tiandi");
    if(!ob->is_fighting() && !ob->query_temp("yun_fengyun") && random(100) > 90)
           command("yun fengyun");
    if(!ob->query("master")) return 1;
    if(environment(ob) == environment(master) && !living(master)) 
                  command("get "+master->query("id"));
           
    return 1;
}
