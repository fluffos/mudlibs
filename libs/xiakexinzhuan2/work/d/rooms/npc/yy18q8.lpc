// yy18q.c 燕云十八骑

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";

void create() {
  set_name("侍卫", ({ "shi wei", "shi", "wei" }));
  set("title", HIY "燕云十八骑" NOR);
  set("nickname", BLU "毒" NOR);
  set("str", 40);
  set("con", 30);
  set("int", 25);
  set("dex", 30);
  set("unique", 2);
  set("location", 1);
  set("南院", 1);
  set("gender", "男性");
  set("age", 40);
  set("luohan_winner", 1);
  set("long", "
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出星宿派。\n");
  set("combat_exp", 800000 + random(100000));
  set("shen", -100000);
  set("attitude", "heroism");
  set("max_qi", 2800);
  set("max_jing", 2000);
  set("max_jingli", 2500);
  set("eff_jingli", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);

  set_skill("force", 160);
  set_skill("huagong-dafa", 160);
  set_skill("dodge", 150);
  set_skill("zhaixingshu", 150);
  set_skill("strike", 160);
  set_skill("chousui-zhang", 160);
  set_skill("parry", 150);
  set_skill("staff", 150);
  set_skill("tianshan-zhang", 150);
  set_skill("literate", 100);
  set_skill("poison", 150);
  set_skill("claw", 160);
  set_skill("sanyin-zhua", 160);
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixingshu");
  map_skill("strike", "chousui-zhang");
  map_skill("parry", "chousui-zhang");
  map_skill("staff", "tianshan-zhang");
  map_skill("claw", "sanyin-zhua");
  prepare_skill("strike", "chousui-zhang");
  prepare_skill("claw", "sanyin-zhua");
  set("chat_chance", 50);
  set("chat_msg", ({ (: checking :) }));
  set("inquiry", ([
    "停": (: stop :),
    "stop": (: stop :),
    "跟": (: follow :),
    "follow": (: follow :),
    "leave": (: leave :),
    "离开": (: leave :),
    "name": (: ask_shi :),
  ]));
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: exert_function, "huagong" :),
    (: exert_function, "judu" :),
  }));
  setup();
  carry_object(ARMOR_D("armor"))->wear();
  carry_object("/d/rooms/npc/obj/jinpai");
}

int checking() {
  object master, ob;
  mixed *list;
  int i;
  ob = this_object();
  list = users();
  i = sizeof(list);
  if ((string)ob->query("master")) {
    while (i--)
      if (list[i]->query("id") == ob->query("master")) master = list[i];
    if (!master) { dest(ob); return 0; }
    if (environment(ob) != environment(master) && living(ob)
      && !ob->is_busy() && ob->query_leader() == master) {
      message_vision("$N快步离开了。\n\n", ob);
      ob->move(environment(master));
      message_vision("$N快步走了过来。\n\n", ob);
    }
  }
  if (!ob->query("master")) return 1;
  if (environment(ob) == environment(master)) {
    if (!living(master)) command("get " + master->query("id"));
    if (ob->query_condition("xx_poison") &&
      ob->query("neili") > 500 && !ob->is_fight())
      command("yun liaodu");
  }

  return 1;
}
