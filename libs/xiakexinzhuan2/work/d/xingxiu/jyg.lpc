#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIY"嘉峪关"NOR);
        set("long", @LONG
这是便是长城最西的关隘嘉峪关，虽岁月沧桑，仍掩不住它的风采。群山环
抱之下，更显它的雄浑。。再往西走便是著名的“丝绸之路”，值通西域，往东
顺着万里长城便可通往中原。这儿驻扎有边防军队，不时盘问来往行人。你小心
翼翼，急步离开这是非之地。
LONG);
        set("outdoors", "jyg");
        set("exits", ([
                "east" : __DIR__"jyge",
                "west" : __DIR__"jygw",
                "south" : __DIR__"jyg_1",
        ]));

        set("objects", ([
                __DIR__"npc/wujiang2" : 1, 
                __DIR__"npc/wujiang1" : 2, 
        ]));
        setup();
        replace_program(ROOM);
}
