// yue lao ting wai 月老亭外

inherit ROOM;

int do_get(string);

void create() {
  set("short", "月老亭外");
  set("long", @LONG
这里是月老亭外，北面紧挨着东大街，南面的小亭子就是天下闻
名的月老亭了。每天都有许多人来此登记婚姻，所以一些专门从事婚
嫁生意的轿夫之流整天在此招徕生意。
LONG
  );

  set("exits", ([
    "northwest": __DIR__ "dongdajie1.lpc",
    "south": __DIR__ "yuelaoting.lpc",
    "east": __DIR__ "yljiulou.lpc",

  ]));

  set("objects", ([
    __DIR__ "npc/jftou.lpc": 1,
    __DIR__ "npc/jiaofu.lpc": 1,
    __DIR__ "npc/lgshou.lpc": 1,
    __DIR__ "npc/snshou.lpc": 1,
    __DIR__ "obj/jiaozi.lpc": 1,
  ]));

  setup();
}
