// baodian.c 葵花宝典

#include <ansi.h>

inherit ITEM;
void setup()
{}

void init()
{
        add_action("do_du", "du");
        add_action("do_du", "study");
        add_action("do_du", "read");
}

void create()
{
        set_name(MAG"葵花宝典"NOR, ({ "kuihua baodian", "baodian", "book", "kuihua"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "一本薄薄的旧册页，十分陈旧。封面上写着《葵花宝典》。\n");
                set("value", 50000);
                set("material", "paper");
                set("no_drop", "这样东西不能离开你。\n");
                set("no_get", "这样东西不能离开那儿。\n");
                set("treasure", 1);

        }
}

int do_du(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
        mapping skill;
        int pxlevel; 
       int neili_lost;

       if (!(arg=="kuihua baodian" || arg == "baodian" || arg == "book"))
       return 0;

/*      if (where->query("pigging")){
                write("你还是专心拱猪吧！\n");
                return 1;
            }
*/        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }

        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来研读新知！\n");
                return 1;
        }

/*        if(!arg || !objectp(ob = present(arg, me)) ){
                write("你要读什么？\n");
                return 1;
        }
*/
        if (!id(arg)) {        
                write("你要读什么？\n");
                return 1;
        }
        if ((string)me->query("gender") == "女性" ){
                write("可惜你是女儿身，无法理解这文字的意思。\n");
                return 1;
        }
        if ((string)me->query("gender") == "男性") {
                   write("你刚看了一小段文字，忽然间欲火高涨、全身燥热，头中一阵眩晕。\n");
                   me->die();
                   return 1;
        }
        if( !me->query_skill("literate", 1) ){
                write("你是个文盲，先学点文化(literate)吧。\n");
                return 1;
        }
       
        message("vision", me->query("name") + "翻出一本书在仔细研读。\n", environment(me), me);
          
        if( (int)me->query("jing") < 25 ) {
                write("你现在过于疲倦，无法专心下来研读新知。\n");
                return 1;
        }

        if ( me->query_skill("pixie-jian", 1) > 150) neili_lost = 20;
       else
       if ( me->query_skill("pixie-jian", 1) > 180) neili_lost = 25;
       else neili_lost = 30;


        if( (int)me->query_skill("literate", 1) < 100) {
               write("你看不懂这上面所写的文字。\n");
                return 1;
        }

        if( (int)me->query("neili") < neili_lost) {
               write("你内力不够，无法钻研这么高深的武功。\n");
                return 1;
        }

        pxlevel = me->query_skill("pixie-jian", 1);
        if( (int)me->query("combat_exp") < (int)pxlevel*pxlevel*pxlevel/10 ) {
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
        }

        if( me->query_skill("pixie-jian", 1) > 29)
            if ((!objectp(ob = present("needle", me)) ) ||
               (!ob->query("equipped") )) {
                write("你没用绣花针，感到无法理解这种阴柔灵活的武功。\n");
                return 1;
        }

        if( me->query_skill("pixie-jian", 1) > 199){
                write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
                return 1;
        }

        if( me->query_skill("pixie-jian", 1) < 150){
                write("你研读了一会儿，但是发现上面所说的对你而言都太深奥了，没有学到任何东西。\n");
                return 1;
        }

       me->receive_damage("jing", 15);
       me->set("neili",(int)me->query("neili")-neili_lost);
        
        me->improve_skill("pixie-jian", (int)me->query_skill("literate", 1)/3+1);
        write("你开始仔细研读葵花宝典。\n");
        return 1;
}