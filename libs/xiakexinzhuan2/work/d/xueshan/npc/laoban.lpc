// laoban.c

#include <ansi.h>

inherit KNOWER;

void create()
{
	set_name("小店老板", ({ "lao ban" }) );
	set("gender", "男性" );

	set("age", 40);

	set("long", "这是整天笑咪咪的小店老板，虽然不卖什么东西，却也过得自在。\n" );

	set("attitude", "peaceful");
	set("chat_chance", 2);
	set("chat_msg", ({
		name() + "说道: 这位客官，您想买些什么东西吗 ?\n",
	}) );

	setup();
	
	carry_object("/d/city/obj/cloth")->wear();
}

