{
	set_name("僧兵头", ({
		"sengbing tou",
		"seng",
		"bing",
	}));
	set("long",
                "他是一位身材高大的壮年僧人，两臂粗壮，膀阔腰圆。他手持僧\n"
                "棍，身穿一袭黑色袈裟，似乎怀有一身武艺。\n"
	);

	set("gender", "男性");
	set("attitude", "peaceful");
	set("class", "lama");

	set("age", 40);
	set("shen", -900);
	set("str", 25);
	set("int", 20);
	set("con", 20);
	set("dex", 25);
	set("max_qi", 1200);
	set("max_jing", 1300);
	set("neili", 1200);
	set("max_neili", 500);
	set("jiaji", 50);
	set("combat_exp", 190000);
 

	set_skill("force", 80);
	set_skill("longxiang-gong", 80);
	set_skill("dodge", 80);
	set_skill("qingshen-fa", 80);
	set_skill("unarmed", 80);
	set_skill("fuhu-quan", 80);
	set_skill("parry", 80);
	set_skill("cuff", 80);

	map_skill("force", "lognxiang-gong");
	map_skill("dodge", "qingshen-fa");
	map_skill("cuff", "fuhu-quan");
	map_skill("parry", "fuhu-quan");
            prepare_skill("cuff", "fuhu-quan");
	setup();
            carry_object("/clone/armor/q-jiasha")->wear();
}

 

