 // zhaitang.c 斋堂

#include <ansi.h>
inherit ROOM;


void create()
{
        set("short",HIG"斋堂"NOR);
        set("long",@LONG 
你刚刚走进这里，一阵阵食物的香气穿来，想不到在雪山里也可以闻到到
如此这样的美味，几个小喇嘛们忙着吃斋。掌管喇嘛膳食的是个中年黄衣喇嘛，
因为食物究竟有限，你要吃斋必须经过他同意。并且不得带偷带食物出斋堂，
违反这将受处罚。
LONG);
	set("no_fight", 1);
        set("no_sleep_room",1);
        set("exits",([
                "north" : __DIR__"zoulang02"
        ]));
              set("objects",([
                __DIR__"npc/x-lama1" : 1,
              ]));
        setup(); 
}
int valid_leave(object me, string dir)
{

        if (  (dir == "north")
                && ( present("tea", this_player())
                          || present("qingke mian", this_player())
                                              || present("matou", this_player())
                          || present("doufu", this_player()))
                          && objectp(present("huangyi lama", environment(me))) )
        switch ( random(2) )
        {
        case 0:
message_vision("黄衣喇嘛伸手拦住了$N：还是先把东西吃完了再走吧。", me);
        return notify_fail("\n");
         break;
        case 1:
         message_vision("黄衣喇嘛拦住$N道：大轮寺主持有令，严禁携带饮食出厨房。", me);
         return notify_fail("\n");
         break;
        }
        return ::valid_leave(me, dir);
}
