 // /d/xueshan/simen.c 雪山大轮寺寺门
// by dubei
#include <ansi.h>
inherit ROOM;


void create()
{
        set("short",HIY"大轮寺"NOR);
        set("long",@LONG
面前是好一座气宇轩昂的寺庙，建筑风格于中原寺庙炯然不同确又自成一
派，因为寺庙向阳而建，虽然地势很高，但不是十分的寒冷，加上寺中香烛飘
出渺渺清烟，你似乎感到一阵温暖。两扇红漆大门紧紧闭着。抬头看横匾上三
个大字：

                        ※※※※※※※※※
                        ※  大  轮  寺  ※
                        ※※※※※※※※※                
LONG          
);
        set("exits",([
                "eastdown" : __DIR__"shijie1", 

        ]));
       set("item_desc", ([
                "door": "一扇红漆大门上有两个金环在阳光照耀下格外耀眼。似乎可以(knock)敲门和砸门(break)。\n",
                "门": "一扇红漆大门上有两个金环在阳光照耀下格外耀眼。似乎可以(knock)敲门和砸门(break)。\n",
        ]) );
              set("outdoors", "xizang");
        setup();
         
}
void init()
{
       	add_action("do_break", "break");
       	add_action("do_knock", "knock");
}

void wantopen(object me)
{
	object	waiter, tao1, tao2, tao3;
	object	room;

	seteuid(geteuid());
	room = find_object(__DIR__"dadian1");
	waiter = new("/d/xueshan/npc/sengbing3");
	message("vision", "\n吱的一声，门向里开了。\n", this_object());
       	message("vision", waiter->name()+ "走了过来。\n", this_object());
	if( room )  message("vision", waiter->name() + "吱的一声把门打开，走了出去。\n", room);
	waiter->move(this_object());
	message("vision", "黄衣喇嘛说道：这位"+ RANK_D->query_respect(me) + 
		"光临大轮寺,请进。\n", this_object());
	call_out("closedoor", 10, me);
}

void wantbreak(object me)
{
	object	waiter, tao1, tao2, tao3;
	object	room;

	seteuid(geteuid());
	room = find_object(__DIR__"dadian1");
	waiter = new("/d/xueshan/npc/sengbing3");
	message("vision", waiter->name()+ "走了过来。\n", this_object());
	waiter->move(this_object());
	message("vision", "\n黄衣僧人狞笑道：哪里来的"+ RANK_D->query_rude(me) + 
		"，敢跑到大轮寺撒野，把命留下来！\n", this_object());
	tao1 = new("/d/xueshan/npc/sengbing2");
	tao1->move(this_object());
	tao2 = new("/d/xueshan/npc/sengbing2");
	tao2->move(this_object());
	tao3 = new("/d/xueshan/npc/sengbing2");
	tao3->move(this_object());
	message_vision(HIB "\n从大轮寺里出来三个护寺喇嘛，怒气冲冲的向$N冲了过去。\n\n" NOR, me);
	tao1->kill_ob(me);
	tao2->kill_ob(me);
	tao3->kill_ob(me);
	me->kill_ob(tao1);
	me->kill_ob(tao2);
	me->kill_ob(tao3);
            waiter->kill_ob(me);
            me->kill_ob(waiter);
	call_out("closedoor", 20, me);
}

int do_break(string arg)
{
	object room, me;

        if( arg=="door" || arg == "门") {
		me = this_player();
		if(query("exits/westup")) {
			message_vision(HIY "$N对着敞开着的红漆大门，狠狠地踢了一脚！\n" NOR, me);
			message_vision(HIY "这一下用力太大，痛得$N直咧嘴！\n" NOR, me);
		}
		else {
		message_vision(HIY "$N用力一脚，咣的一声，把大门踢了开来！\n" NOR, me);
		set("long", @LONG
面前是好一座气宇轩昂的寺庙，建筑风格于中原寺庙炯然不同确又自成一
派，因为寺庙向阳而建，虽然地势很高，但不是十分的寒冷，加上寺中香烛飘
出渺渺清烟，你似乎感到一阵温暖。两扇红漆大门敞开着。抬头看横匾上三个
大字：

                       ※※※※※※※※※
                       ※  大  轮  寺  ※
                       ※※※※※※※※※  
LONG
	);
		set("exits/westup", __DIR__"dadian1");
	        if( room = find_object(__DIR__"dadian1") ) {
			message("vision", HIY "咣的一声，大门被人踢了开来！\n" NOR, room);
			room->set("exits/eastdown", __FILE__);
			room->set("item_desc", ([
                		"door": "铜钉的大门，门是开着的。\n",
                		"门": "铜钉的大门，门是开着的。\n",
        		]) );
		}
		me->start_busy(2);
		call_out("wantbreak", 2, me);
		}
        }
	else {
 		 write("你要踢什么？\n");
	}
	return 1;
}

int do_knock(string arg)
{
	object room, me, thisroom;

        if( arg=="door" || arg == "门") {
		me = this_player();
		if(query("exits/westup")) {
			message_vision(HIY "门是开着的，进去就行了，还用敲什么？\n" NOR, me);
			return 1;
		}
		message_vision(HIY "$N走到门前，轻轻地用门环敲了两下。\n" NOR, me);
		set("long", @LONG
面前是好一座气宇轩昂的寺庙，建筑风格于中原寺庙炯然不同确又自成一
派，因为寺庙向阳而建，虽然地势很高，但不是十分的寒冷，加上寺中香烛飘
出渺渺清烟，你似乎感到一阵温暖。两扇红漆大门敞开着。抬头看横匾上三个
大字：

                       ※※※※※※※※※
                       ※  大  轮  寺  ※
                       ※※※※※※※※※  
LONG
	);
		set("exits/westup", __DIR__"dadian1");
	        if( room = find_object(__DIR__"dadian1") ) {
			message("vision", HIY "你听到当当两声，有人在门外敲门。\n" NOR, room);
			room->set("exits/eastdown", __FILE__);
			room->set("item_desc", ([
                		"door": "两扇红漆的大门向两侧敞开着。\n",
                		"门": "两扇红漆的大门向两侧敞开着。\n",
        		]) );
		}
		me->start_busy(2);
		call_out("wantopen", 2, me);
		
        }
	else {
		write("你要敲什么？\n");
	}
                return 1;
}

void closedoor(object me)
{
	object obj, room, troom;

	troom = this_object();
	if(environment(me) != troom) {
	        room = find_object(__DIR__"dadian1");
		obj = present("seng bing", troom);
		if(obj) {
			message("vision",obj->name() + "走进了大轮寺。\n", troom);
			destruct(obj);
		}
		obj = present("seng bing", troom);
		if(obj) {
			message("vision", obj->name() + "走进了大轮寺。\n", troom);
			destruct(obj);
		}
		obj = present("seng bing", troom);
		if(obj) {
			message("vision", obj->name() + "走进了大轮寺。\n", troom);
			destruct(obj);
		}
		obj = present("sengbing tou", troom);
		if(obj) {
			message("vision", obj->name() + "走进大轮寺，轻轻地把门关上了。\n", troom);
			destruct(obj);
			delete("exits/westup");
			if(room) {
				room->delete("exits/eastdown");
				room->set("item_desc", ([
                	"door": "铜钉的大门，门是关着的，你可以拉(pull)门。\n",
                	"门": "铜钉的大门，门是关着的，你可以拉(pull)门。\n",
        			]) );
			}
	set("long", @LONG
面前是好一座气宇轩昂的寺庙，建筑风格于中原寺庙炯然不同确又自成一
派，因为寺庙向阳而建，虽然地势很高，但不是十分的寒冷，加上寺中香烛飘
出渺渺清烟，你似乎感到一阵温暖。两扇红漆大门紧紧闭着。抬头看横匾上三
个大字：

                       ※※※※※※※※※
                       ※  大  轮  寺  ※
                       ※※※※※※※※※  
LONG
	);
		}
	}
	else
		call_out("closedoor", 15, me);
}
