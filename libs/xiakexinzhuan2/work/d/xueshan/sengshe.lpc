// sengshe.c 僧舍

inherit ROOM;
void create() {

  set("short", "僧舍");
  set("long", @LONG 
这里是喇嘛们休息的地方，一张硬木床，躺上去浑身不适，你不由得感到
当喇嘛的艰辛。你看着躺在床上呼噜连天的喇嘛们，自己也不由的困了起来，
脱了鞋就可以躺下来好好睡(sleep)一觉了。
LONG);
  set("no_fight", 1);
  set("sleep_room", 1);
  set("exits", ([
    "south": __DIR__ "zoulang01"
  ]));

  setup();
  replace_program(ROOM);
}
