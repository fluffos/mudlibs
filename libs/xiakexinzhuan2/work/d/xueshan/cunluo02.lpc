//      cunluo02.c 藏民村落
inherit ROOM;
void create() {
  set("short", "藏民村落");
  set("long", @LONG 
这里主要是藏族的居民区。藏民们热情好客，你应该可以在这里借宿一会
儿，但是白住人家的房子总是不好，你多少也要意思意思。几个藏民在这里有
事没事的闲逛，你可以向他们找间房子借宿一晚。
LONG);
  set("exits", ([
    "north": __DIR__ "muchang04",
    "south": __DIR__ "cunluo01",
    "west": __DIR__ "muchang02",
    "east": __DIR__ "muchang06"
  ]));

  setup();
  replace_program(ROOM);
}
