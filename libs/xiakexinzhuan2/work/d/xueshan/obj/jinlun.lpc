
#include <ansi.h>
#include <weapon.h>
 inherit HAMMER;

void create()
{
      set_name( HIY  "金轮" NOR,({ "jin lun" ,"lun" ,"jinlun" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
                       set("value", 1);
             set("unique", 1);
             set("rigidity", 6);
             set("sharpness", 3);
	           set("unit", "把");
              set("long",HIY"这是一柄金光闪闪的法轮\n" NOR);
	           set("material", "blacksteel");
             set("weapon_prop/dodge", -2);
             set("weapon_prop/parry", 3);
             set("treasure",1);
	           set("wield_neili", 1000);
             set("wield_maxneili", 1500);
             set("wield_str", 35); 
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
             set("unwield_msg","$N将手中的$n放回腰间\n");
	}
	init_hammer(120);
	setup();
}
