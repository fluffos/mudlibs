 // zhonglou.c 钟楼

#include <ansi.h>

inherit ROOM;
string zhong(object);
string chu(object);
void create()
{
        set("short",NOR "钟楼");
        set("long",@LONG
这里是大轮寺钟楼，不知是什么原因，只有武功修为到达一定水平，密宗
心法到一定心境之人才能入内。钟楼内一口千斤大钟(zhong)，厚约一寸，旁边
有一个钟杵(chu)。是用来撞钟之用。低头向窗外一望，但见窗下有很多骸骨散
落在地，不知是什么原因。
LONG);
        set("exits",([
                "eastdown": __DIR__ "cangjingfang",
                "westdown": __DIR__"xiaodao01"
        ]));

        setup();
 
}
string gu(object me)
{
     return "这是一口用生铜铸造成的大钟。\n";
 }
string chui(object me)
{
     return "这是一个甚是巨大的木槌，长约三尺，碗口粗细。\n";
 }
void init()
{
     add_action("do_strike", "ji"); 
}
int do_strike(string arg)
{
            object me = this_player();
            int i;

                if (!living(me)) return 0;
                if (arg != "zhong" && arg != "dazhong")
           return notify_fail("你要敲击什麽？\n");

	  if ( (int)me->query_skill("lamaism", 1) < 31 )
	  return notify_fail("你没有密宗心法，跑这里来击打什麽钟呢？\n");
                
                if ( (int)me->query_skill("hand", 1) > 61 )
	  return notify_fail("你轻轻推动鼓槌敲击大钟，钟声发出阵阵巨响。\n");
               
                if ( (int)me->query_str() < 30 )
	  return notify_fail("你轻轻推动鼓槌敲击大钟，只觉得手臂发麻。\n");

                           if ( (int)me->query_skill("hand",1) < 31 )
	  return notify_fail("你轻轻推动鼓槌敲击大钟，只觉得手臂发麻。\n");

                if ( (int)me->query("jingli") < 60 )
	  return notify_fail("你感觉已经无力再去敲击打鼓了。\n");

              i = me->query("str");
               me->receive_damage("jingli", 25 + random(20));
              message_vision("$N抡起钟槌，向大钟敲去，顿时钟声震撼着整个大轮寺。\n", me);
              me->improve_skill("hammer",i);
	  return 1;
}