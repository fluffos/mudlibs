 // /d/xueshan/cemen.c 石板路
// by dubei
inherit ROOM;

#include <room.h>
int valid_leave();
void create()
{
        set("short","小门");
        set("long",@LONG 
这里是大轮寺的一个小门，一些僧兵在此把守，似乎这里通向什麽重要
地点。青石堆砌的小门有几丈来高，两扇红漆的小门紧紧关闭着。
LONG);
        set("exits",([ 
                "northwest": __DIR__"xl01",
                            "south": __DIR__"xuel01",
        ]));
              set("objects",([
                "/kungfu/class/xueshan/sangjie" : 1,
        ]));
        setup();  
            create_door("south", "小门", "north", DOOR_CLOSED);
}
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");
        if ((!myfam || myfam["family_name"] != "密宗") &&
            objectp(present("sangjie dalama", environment(me))) && dir == "south" && (!me->query_temp("mz_enter")))
           return notify_fail("桑吉厉声呵斥道：这里是我大轮寺禁地，速速离开！否则大爷就要你的命。\n");

   if ((int)me->query_skill("lamaism", 1) < 160 &&
            objectp(present("sangjie dalama", environment(me))) && dir == "south")
           return notify_fail("桑吉伸手一拦,说道：没有支持的传唤，你不能进去。\n");

        return ::valid_leave(me, dir);
}