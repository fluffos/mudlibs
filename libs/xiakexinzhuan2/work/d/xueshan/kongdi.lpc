// /d/xueshan/kongdi
// by dubei

inherit ROOM;

void create() {
  set("short", "林中空地");
  set("long", @LONG 
这里是树林深出的一片空地，周围似乎有一种杀气，几名喇嘛正在
一旁悄声交谈，似乎在策划着什么。
LONG);
  set("exits", ([
    "enter": __DIR__ "kongdi1",
    "east": "/d/hz/liulin2",

  ]));
  set("objects", ([
    "/kungfu/class/xueshan/baoxiang": 1,
    "/kungfu/class/xueshan/shengdi": 1,
    "/kungfu/class/xueshan/shanyong": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if ((!myfam || myfam["family_name"] != "密宗") &&
    objectp(present("shengdi lama", environment(me))) && dir != "east"
    && (!me->query_temp("mz_gf")))
    return notify_fail("胜谛喇嘛恶狠狠的说道，我师傅在里面修炼，快快走开！\n");

  return ::valid_leave(me, dir);
}
