// msdan.c
//蟒蛇胆

#include <ansi.h>

inherit ITEM;

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name("蟒蛇胆", ({"mangshe dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗黑色的蟒蛇胆。\n");
		set("value", 10000);
	}
	setup();
}

int do_eat(string arg)
{	
	int max;
	object me = this_player();

	if (!id(arg))
	return notify_fail("你要吃什么？\n");
    me->add("max_jingli", 1);
    max = me->add("eff_jingli", 1);
	me->set("jingli", max);
	message_vision(HIG "$N吃下一颗蟒蛇胆，全身功力顿然提高！\n" NOR, me);
	destruct(this_object());
	return 1;
}

