// chan.c 缠字诀

#include <ansi.h>

#define PFM_NAME        "缠字诀"

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg;
  int ap, dp;

  if (!target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }

  if (!target || !me->is_fighting(target))
    return notify_fail("「" + PFM_NAME + "」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "sword")
    return notify_fail("必须拿剑才能施展「" + PFM_NAME + "」。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if (me->query("neili") < (int)me->query("max_neili") / 50)
    return notify_fail("你的内力不足以施展「" + PFM_NAME + "」。\n");

  if ((int)me->query_skill("taiji-shengong", 1) < 100)
    return notify_fail("你的太极神功火候不够，难以施展「" + PFM_NAME + "」。\n");

  if (me->query_skill("taiji-jian", 1) < 100)
    return notify_fail("你的太极剑法不够娴熟，不会使用「" + PFM_NAME + "」。\n");

  msg = HIG "$N使出太极剑法「缠」字诀，先是连递数个虚招企图扰乱$n的攻势。\n"
    HIG "忽然手中" + weapon->name() + HIG "划出一个个圆圈，神在剑先，"
    HIG "绵绵不绝，便如撒出了一张大网，逐步向$n收紧。\n" NOR;

  ap = me->query_skill("taiji-jian", 1);
  dp = target->query_skill("parry");
  if (ap / 2 + random(ap) > dp) {
    me->add("neili", -me->query("max_neili") / 50);
    msg += HIC "\n结果太极剑意散发出的细丝越积越多，似是积成了一团团丝棉，将$p紧紧裹了起来！\n" NOR;
    target->start_busy(ap / 20);
    me->start_busy(1);
  } else {
    me->add("neili", -me->query("max_neili") / 80);
    msg += HIY "\n可是$p看破了$P的企图，纵身一跃，已逃出圈外。\n" NOR;
    me->start_busy(1 + random(3));
  }
  message_combatd(msg, me, target);

  return 1;
}
