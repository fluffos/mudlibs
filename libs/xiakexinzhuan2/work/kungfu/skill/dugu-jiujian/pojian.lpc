// po jian.c 独孤九剑 [破剑式]

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  object weapon;
  string msg, skill;
  mapping map_skills;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("独孤九剑的「破剑式」只能向战斗中的对手使用。\n");
  if (weapon = target->query_temp("weapon"))
    skill = weapon->query("skill_type");
  else skill = "else";
  if (skill != "sword")
    return notify_fail("由于对手不是以剑为兵刃，所以「破剑式」无法施展。\n");
  if ((int)me->query_skill("dugu-jiujian", 1) < 50)
    return notify_fail("你的独孤九剑火候不够。\n");
  map_skills = target->query_skill_map();
  if (target->query_skill_mapped(skill) != 0)
    skill = map_skills[skill];
  msg = CYN "$N使出独孤九剑「破剑式」，剑尖直指向$n的" + to_chinese(skill) + "中的破绽。\n" NOR;
  if (random(me->query("int")) > random(target->query("int")) / 2) {
    damage = (int)me->query_skill("dugu-jiujian", 1);
    damage = random(damage * 4 / 3);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 3);
    if (damage < 40) msg += HIY "结果$n被$N造成相当严重的刺伤 ！\n" NOR;
    else if (damage < 80) msg += HIR "结果「嗤」地一声$n被$N刺出了一个又长又深的伤口 ！\n" NOR;
    else msg += RED "结果「噗嗤」地一声，长剑已在$n的身上刺出一个血肉□糊的血窟窿 ！！\n" NOR;
  } else {
    msg += "可是$N看破了$n的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}
