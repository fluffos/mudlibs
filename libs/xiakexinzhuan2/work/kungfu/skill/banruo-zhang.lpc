	"skill_name" : "摘星换斗"
]),
([	"action" : "$N两掌上下护胸，一式「"HIY"翻江搅海"NOR"」，骤然化为满天掌雨，攻向$n",
    "force" : 410,
        "dodge" : 30,
        "damage_type" : "瘀伤",
