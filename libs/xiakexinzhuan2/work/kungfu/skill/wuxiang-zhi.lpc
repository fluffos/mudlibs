/* 
   wuxiang-zhi.c 无相劫指
   和少林罗汉拳(luohan-quan)互备
   取自佛法十二字“广大，智慧，真如，性海，颖悟，圆觉”。
   2/3/98 by snowman
*/

inherit SKILL;

mapping *action = ({
([	"action" : "$N将双手拢在衣袖之中，一招「广大无相劫」，暗劲自袖中悄悄涌出，刺向$n",
	"force" : 150,
	"dodge" : 25,
	"weapon" : "指力",
	"lvl"   : 0,
	"skill_name" : "广大无相劫" ,		
        "damage_type" : "刺伤"
]),
([	"action" : "$N微微一笑，一招「智慧无相劫」，衣袖连摆，指劲随机弹出，叫人琢磨不透，无法躲避",
	"force" : 200,
	"dodge" : 15,
	"weapon" : "指风",
	"lvl"   : 10,
	"skill_name" : "智慧无相劫" ,		
        "damage_type" : "刺伤"
]),
([	"action" : "$N垂手站立，丝毫不动，但闻$n身前哧的一声，闻声不见物，是那招「真如无相劫」",
	"force" : 250,
	"dodge" : 20,
	"weapon" : "无形指力",
	"lvl"   : 30,
	"skill_name" : "真如无相劫" ,		
	"damage_type" : "刺伤"
]),
([	"action" : "$N抬头往天，一指「性海无相劫」暗袭$n$l，本人却见丝毫不动，仿若无事发生一样",
	"force" : 300,
	"dodge" : 10,
	"weapon" : "指力",
	"lvl"   : 60,
	"skill_name" : "性海无相劫" ,		
	"damage_type" : "刺伤"
]),
([	"action" : "$N一招「颖悟无相劫」向$n点出，闻得一破空之声，却见$P微笑点头，却再无任何动静",
        "force" : 350,
	"dodge" : 5,
	"weapon" : "指风",
	"lvl"   : 100,
	"skill_name" : "颖悟无相劫" ,		
        "damage_type" : "刺伤"
]),
([	"action" : "但闻哧哧两声，$n脸色突变，$N却悠闲自在，并无动过手的迹象，这好象是那招「圆觉无相劫」",
        "force" : 400,
	"dodge" : 5,
	"weapon" : "指风",
	"lvl"   : 150,
	"skill_name" : "圆觉无相劫" ,		
	"damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage=="finger" ||  usage=="parry"; }

int valid_combine(string combo){
        if(this_player()->query_skill("wuxiang-zhi", 1) > 100
	   && this_player()->query_int() > 47)
   	         return combo=="luohan-quan";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练无相劫指必须空手。\n");
	if ((int)me->query_skill("yijin-jing", 1) < 170)
		return notify_fail("你的易筋经内功火候不够，无法学无相劫指。\n");
	if ((int)me->query("max_neili") < 2800)
		return notify_fail("你的内力太弱，无法练无相劫指。\n");
        if ((int)me->query_int() > 47)
               return 1;
	else if (!me->query_skill("duoluoye-zhi", 1) 
                 || !me->query_skill("jingang-quan", 1)
                 || !me->query_skill("jingang-zhang", 1)
                 || !me->query_skill("boluomi-shou", 1))
                      return notify_fail("你还未掌握基本的武艺，无法学习无相劫指。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action); i > 0; i--)
		if(level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("wuxiang-zhi",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];

}


int practice_skill(object me)
{
	if ((int)me->query("jingli") < 55)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练无相劫指。\n");
	me->receive_damage("jingli", 50);
	me->add("neili", -20);
	return 1;
}

string perform_action_file(string action)
{
        return __DIR__"wuxiang-zhi/" + action;
}

mapping *query_actions() { return action; }