// suixing-tui.c 如影随形腿

inherit SKILL;

mapping *action = ({
  ([ "action": "$N纵身向前，忽然伸出左腿，一式「仗义执言」，直踢$n的头部",
    "force": 60,
    "dodge": 20,
    "parry": 5,
    "lvl": 0,
    "skill_name": "仗义执言",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形一闪，双足点地，一式「七星伴月」，在空中连踢七脚，直本$n的头、胸、臂",
    "force": 120,
    "dodge": 10,
    "parry": 30,
    "lvl": 8,
    "skill_name": "七星伴月",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身体前倾，左脚画圆，右腿使出一式「佛界无边」，扫向$n的腰部",
    "force": 280,
    "dodge": 50,
    "parry": 5,
    "lvl": 18,
    "skill_name": "佛界无边",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左足倏地弹出，连环六腿，分踢$n的头部，胸部和裆部，正是一式「转世轮回」",
    "force": 300,
    "dodge": 10,
    "parry": 60,
    "lvl": 30,
    "skill_name": "转世轮回",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左足独立，右腿随身形反转横扫，一招「西天极乐」，踢向$n的$l",
    "force": 360,
    "dodge": 30,
    "parry": 40,
    "lvl": 50,
    "skill_name": "西天极乐",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N跃起在半空，双足带起无数劲风，一式「佛祖慈悲」迅捷无伦地卷向$n",
    "force": 410,
    "dodge": 25,
    "parry": 30,
    "lvl": 80,
    "skill_name": "佛祖慈悲",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "leg" || usage == "parry"; }

int valid_combine(string combo) {
  object me;
  me = this_player();

  if ((int)me->query_int() > 48)
    return combo == "qianye-shou";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学如影随形腿时手里不能拿武器。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 60)
    return notify_fail("你的易筋经内功火候不够，无法学如影随形腿。\n");
  if ((int)me->query_int() > 42) {
    return 1;
  } else {
    if ((int)me->query_skill("jingang-quan") &&
      ("yizhi-chan") &&
      ("longzhua-gong") &&
      ("banruo-zhang") &&
      ("qianye-shou"))
      return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
  }

  if ((int)me->query("max_neili") < 600)
    return notify_fail("你的内力太弱，无法练如影随形腿。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("ruying-suixingtui", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练如影随形腿。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "ruying-suixingtui/" + action;
}

mapping *query_actions() { return action; }
