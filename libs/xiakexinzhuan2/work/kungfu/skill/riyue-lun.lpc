string *parry_msg = ({
"$n不躲不避，手中$w摆开，在$P跟前形成了一道光幕，$N此招根本无法再进。\n",
"却见$n踏前一步，手中$w翻飞，其势甚巨，$N前进不能，只好闪身而退。\n",
"$n轮法突变，$w带着风声飞舞出去，后发先至，在$N还没攻出时就破了$p的招数。\n",
"但见$n举$w硬挡，乒的一声架开了来势汹汹的$N。\n",
});

string  *msg = ({
"空中那五只$w对击，声若龙吟，悠悠不绝，就在$n一呆之际，$w飞砸了出去！",
"呜呜声响中，$w旋转飞舞着撞向$n，在$p便要挡隔时，却绕过他飞到了身後",
"$w连续掷出，连续飞回，绕著$n兜个圈子，忽高忽低，或正或斜，所发声音也是有轻有响，旁观众人均给扰得眼花撩乱，心神不定",
"一声「小心了！」，蓦然间$w五体归一，并排向$n撞去，势若五牛冲阵，威不可挡",
"只见$w绕著$n，上下翻飞，$w跳跃灵动，呜呜响声不绝，掀的阵阵狂风有如刀割，似要把$n从中劈开",
"突然，狂风乱起，激荡中那$w相碰相撞，五轮归一，合并了向$n砸去",
"法轮在$n身前环饶，猛地向$p迎头击下，接着又飞来一轮，一抄一送，呜呜声响，兜向$n$l",
"呼呼飞啸声中，那五只$w或直飞、或斜飞、或回旋、或下坠、或上升，霎时间$n的全部退路已被封死",
"猛地里$w向$n$l飞砸下，在$p沉肩卸避之时，$w又突然上飞击出，砸向$p的$l",
"那$w飞旋砸到，$n却并不回头，听风辨器，一一挡开，但$w便如长上了眼睛一般，竟然又旋飞到了$n$l",
});

int valid_enable(string usage) { return usage == "hammer" || usage == "parry"; }

void skill_improved(object me)
{
   int skill = me->query_skill("riyue-lun", 1);
   if(skill >= 200 && !me->query("ryl_add")){
   	 me->set("ryl_add", 1);   
   	 tell_object(me, HIW"\n忽然，你感道体内内息越转越快，瞬时间功力已经上升到了一个新的境界！\n你的精力增加了！\n你的臂力增加了！\n"NOR);
         me->add("max_jingli", skill+random(skill));
         me->add("str", 1);
         }
}

int valid_learn(object me)
{
        if((int)me->query_str() <=23)
            return notify_fail("你的臂力不够学日月五行轮。\n");
	if((int)me->query("max_neili") < 2000)
	    return notify_fail("你的内力不够。\n");
	if((int)me->query_skill("longxiang-gong", 1) <= 160)
            return notify_fail("需要有第八层以上龙象般若功火候,才能学日月五行轮。\n");
	    return 1;

}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        string str, message;
	level   = (int) me->query_skill("riyue-lun",1);

        if(!userp(me) && me->query("env/invisibility")){
             if(weapon->query("id") == "jin lun") str = "金轮";
             else if(weapon->query("id") == "yin lun") str = "银轮";
             else if(weapon->query("id") == "fa lun") str = "法轮";
             else str = weapon->name();
             message = msg[random(sizeof(msg))];
             message = replace_string(message, "$w", str);
             switch(str){
                case "金轮" : message = HIY+message+NOR; break;
                case "银轮" : message = HIW+message+NOR; break;
                case "法轮" : message = HIC+message+NOR; break;
                default : break;
                }
             return ([
                "action":message,
                "damage":(random(4)+1)*50,
                "damage_type":random(2)?"砸伤":"瘀伤",
                "dodge": 5,
                "force":250+random(300)
            ]);
        }
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

string query_parry_msg()
{
     object weapon;
     if (objectp(weapon = this_player()->query_temp("weapon")) && weapon->query("skill_type") == "hammer")
        return parry_msg[random(sizeof(parry_msg))];
}

int practice_skill(object me)
{
	object weapon;

       if (!objectp(weapon = me->query_temp("weapon"))
	    || (string)weapon->query("skill_type") != "hammer")
		return notify_fail("你使用的武器不对。\n");
       if ((int)me->query("jingli") < 30)
                return notify_fail("你的体力太低了。\n");
       if ((int)me->query("neili") < 40)
                return notify_fail("你的现在的内力不足,无法继续练日月五行轮。\n");
       me->receive_damage("jingli", 40);
       me->add("neili", -20); 
       return 1;
}
string perform_action_file(string action)
{
  return __DIR__"riyue-lun/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{                
	object master;
	
        if(!userp(me) && 
           objectp(master = me->query("have_master")) &&
           me->query("env/invisibility") && 
           victim->query("qi")*2 <= victim->query("max_qi"))          	
             me->check_target(master, victim);
}

mapping *query_actions() { return action; }