// powerup.c 混天气功加力

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int count, int amount);

int exert(object me, object target)
{
	int skill;

	if (!me->is_fighting())
		return notify_fail("你只能在战斗中用混天气功来提升战斗力。\n");

	if( (int)me->query("neili") < 100  ) 
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_temp("powerup") ) 
		return notify_fail("你已经在运功中了。\n");

	skill = me->query_skill("force");
	me->add("neili", -100);
	me->receive_damage("qi", 0);

	message_vision(HIR "$N微一凝神，运起混天气功，全身骨节发出一阵爆豆般的声响。\n" NOR, me);

	me->add_temp("apply/attack", skill/3);
	me->add_temp("apply/dodge", skill/3);
	me->set_temp("powerup", 1);

	call_out("remove_effect", 1, me, skill / 2, skill / 3);
    me->start_exert(1, "混天气功");

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int count, int amount)
{
	if (objectp(me)) {
		if (count-- > 0 && me->is_fighting()) {
			call_out("remove_effect", 1, me, count, amount);
            me->start_exert(1, "混天气功");
			return;
		}
		me->add_temp("apply/attack", - amount);
		me->add_temp("apply/dodge", - amount);
		me->delete_temp("powerup");
		tell_object(me, "你的混天气功运行完毕，将内力收回丹田。\n");
	}
}
