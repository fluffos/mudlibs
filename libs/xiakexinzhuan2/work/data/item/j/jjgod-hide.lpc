#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[0;36m神[0;37m藏[0;36m剑[0;37;0m", ({ "hide" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[0;37;0m炼制而成的一柄剑。
[0;36m天[0;37m灵[0;36m地[0;37m意，[0;36m尽归[0;37m神[0;36m藏。[0;37;0m
剑柄上刻着一行小字：阿飞(jjgod)
");
  set("value", 1);
  set("point", 250);
  set("material", "magic stone");
  set(
    "wield_msg",
    "[0;36m九气[0;37m化[0;36m而神藏[0;37m现[0;36m，心魔[0;37m出[0;36m而天地[0;37m裂[0;36m。[0;37;0m\n"
  );
  set(
    "unwield_msg",
    "[0;37m流星[0;36m殒[0;37m而神藏[0;36m隐[0;37m，四方[0;36m合[0;37m而天地[0;36m宁[0;37m。[0;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
