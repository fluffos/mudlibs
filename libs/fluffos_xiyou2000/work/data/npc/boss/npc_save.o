dbase (["sen":288,"age":16,"actions":,"eff_sen":288,"startroom":"/d/moon/xiaolu1","chat_chance":25,"title":"大雪山巡山小妖","max_kee":150,"chat_msg":({"小钻风敲着铜锣吆喝道：巡山的，放哨的注意了！这几天唐僧就要从这过，大家都留点神！","小钻风喊道：唐僧的大徒弟孙悟空尖嘴猴腮，象个雷公！","小钻风喊道：唐僧的二徒弟猪八戒肥头大耳，象个猪骡！","小钻风喊道：唐僧的三徒弟沙和尚满脸秽气，象个鲶鱼精！",,,,}),"kee":-1,"combat_exp":5000,"bellicosity":0,"default_actions":,"limbs":({"头部","颈部","胸口","后心","左肩","右肩","左臂","右臂","左手","右手","腰间","小腹","左腿","右腿","左脚","右脚",}),"max_sen":288,"long":"去雪山路上的一个小妖，手里拿着铜锣正边走边吆喝。","kar":22,"can_speak":1,"str":25,"eff_kee":-1,"race":"人类","cps":15,"name":"小钻风","id":"xiao zuanfeng","int":28,"gender":"男性","inquiry":(["here":"这都不知道？再走两步，就是我们大雪山啦！","二大王":"我家二大王身高三丈，卧蚕眉，丹凤眼，美人声，扁担牙，鼻似蛟龙。若与人争斗，只消一鼻子卷去，就是铁臂铜身，也就魂亡魄丧。","name":,"大大王":"我家大大王神通广大，本事高强，曾一口吞了十万天兵。","三大王":"我家三大王非凡间之物，名号云程万里鹏，又叫大鹏名王，行动时，疾风掠海，振北图南。","雪山":"大雪山就是我家，我们三位大王正在招兵买马，要不要去看看？",]),"cor":19,"unit":"位","max_gin":140,"con":28,"eff_gin":140,"vendor_goods":(["peijian":"/d/obj/weapon/sword/peijian","yinzhen":"/d/obj/weapon/throwing/yinzhen","jiudou":"/d/xueshan/obj/jiudou",]),"gin":140,"spi":20,"per":11,"class":"yaomo","attitude":"peaceful",])
