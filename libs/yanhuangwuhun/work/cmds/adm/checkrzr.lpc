#include <ansi.h>

#define MANMADE_NPC "/clone/npc/rzr"
inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

mixed main(object me, string arg) {
  int count, i, real_count;
  string msg;
  object *rzrs;
  object rzr;
  object env;

  if (arg == "all") {
    rzrs = children(MANMADE_NPC);
    count = sizeof(rzrs);
    msg = "==========================================================\n";

    for (i = 0; i < count; i++) {
      rzr = rzrs[i];
      env = environment(rzr);
      if (!env) {
        continue;
      }

      msg += rzr->query("name") + "("
        +rzr->query("id") + ") 正在(" + env->query("short");
      if (wizardp(this_player())) {
        msg += " - " + file_name(env);
      }
      msg += ")";

      if (rzr->is_fighting()) {
        msg += "    " HIR "<战斗中>" NOR;
      }
      msg += "\n";

      msg += "==========================================================\n";
      real_count++;
    }

    msg += "系统中共有 " + real_count + " 个人造人\n";

    me->start_more(msg);

    return 1;
  } else {
    return notify_fail("指令格式：checkrzr all|rzr_id|rzr_name\n");
  }

}

int help(object me) {
  write(@HELP
指令格式 : checkrzr all|rzr_id|rzr_name

这个指令可以列出所有在系统中的人造人。

-all 列出所有的人造人。
-rzr_id 列出特定的人造人的详细信息。用人造人的ID来查找
-rzr_name 列出特定的人造人的详细信息。用人造人的名字来查找
HELP
  );
  return 1;
}
