inherit ROOM; 

void create() 
{ 
        set("short", "混沌虚空"); 
        set("long", @LONG 
混混沌沌自在天,听说里面封印了一头强大的怪物
LONG
); 
                        
        set("outdoors", "hunduntian"); 
        set("virtual_room", 1);
        set("no_death_penalty", 1);
        set("no_magic", 1);
        set("exits", ([ /* sizeof() == 3 */ 
                "south" : __DIR__"maze/entry", 
        ])); 
        /*set("objects",([
                "/maze/hunduntian/obj/coffin1": 1,  
        ])); */
        setup();
 
}
 
int valid_leave(object me, string dir)
{
        object ob, room;

        if( me->query_temp("hunduntian_step") != 6 &&
            me->query_temp("hunduntian_step") != 13 )
                /*if( objectp(present("xu zhanglao", environment(me))) && dir == "west" )
                        return notify_fail("徐长老拦住你说：你来洛阳聚贤庄撒野？快走开！\n");*/

        if( me->query_temp("hunduntian_step") == 13 && dir == "west" )
        {
           int valid;

                valid = FUBEN_D->valid_enter(me, "hunduntian");
                if( valid >=1 )
                {

                        FUBEN_D->enter_fuben(me, "hunduntian");
                        return -6;
                }
                else
                        return notify_fail("你无法进入混沌天副本。\n");
        }

        return ::valid_leave(me, dir);
}