inherit RINGS;

void create()
{
        set_name(HIC "洪荒戒" NOR, ({ "honghuang jie", "honghuang" }));
        set_weight(1);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/
        {
                set("unit", "枚");
                set("long", HIC "这是由洪荒世界颁发的特殊戒指，散发出一股洪荒气息。\n" NOR);
                set("value", 100);
                set("material", "gold");
                //set("armor_prop/dex", 100);
                set("armor_prop/str", 100);
                set("armor_prop/int", 100);
                set("armor_prop/con", 100);
                set("armor_prop/max_experience", 100000000);
				set("armor_prop/research_effect", 200);
				set("armor_prop/derive_effect", 200);
				set("armor_prop/practice_effect", 200);
				set("armor_prop/add_magic", 200);
				set("armor_prop/damage", 500000);
