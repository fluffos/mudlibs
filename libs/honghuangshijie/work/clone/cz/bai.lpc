#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
        set_name(NOR + WHT "白金剑气" NOR, ({ "zong zi", "zong", "zi" }));
        /*if (clonep())
                set_default_object(__FILE__);
        else*/ {
                set("long",WHT "白金剑气\n");
                set("base_unit", "块");
				set("cz", 2);
               
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        /*if( query("food", me) >= me->max_food_capacity() )
        {
                write("你已经吃太饱了，再也塞不下任何东西了。\n");
                return 1;
        }*/

        message_vision("你学会了白金剑气。\n" NOR, me);
         me->improve_skill("baijin-jianqi", 1500000);

        add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}