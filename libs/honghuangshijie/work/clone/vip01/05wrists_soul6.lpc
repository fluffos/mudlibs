#include <ansi.h>

inherit EQUIP_SOUL;

void create()
{
        set_name(HIM "护腕之魂" NOR, ({"wrists soul6"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIM "完美的护腕之魂，可用来改造护腕。\n" NOR);
                set("unit", "个");
                set("yuanbao", 10);
                set("value", 10000);
                set("no_sell", 1);
        }
        set("type", "wrists");
        set("status", 6);
        set("auto_load", 1);
        
        setup();
}

