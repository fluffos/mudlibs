// gold.c

#include <ansi.h>

inherit MONEY;
void create()
{
        set_name(YEL "小灵脉" NOR , ({"l", "m", "lingmai"}));
        set_weight(400);
        /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
                set("money_id", "lm");
                set("long", "一条灵脉可以吸收里面的灵力修炼，也可以用来换一些东西！\n");
                set("unit", "条");
                set("base_value", 500000000 );
                set("base_unit", "条");
                set("base_weight", 80);
				set("only_do_effect", 1);
        }
        set_amount(1);
}

int do_effect(object me)
{

        message_vision("$N慢慢吸收灵石里的灵力，感觉功力有所增长。\n" NOR, me);
		addn("max_neili", 500000, me);
		addn("max_jingli", 250000, me);

        add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}