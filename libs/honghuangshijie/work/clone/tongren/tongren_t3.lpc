
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "手厥阴脉·天泉穴" NOR, ({ "tongren t3" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren t3")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "手厥阴脉");
        set("xuewei_name", "天泉穴");
        set("chongxue_xiaoguo", "JING:50:NEI:50");
        set("neili_cost", "8000");
        setup();
}


