
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "阳维脉·正营穴" NOR, ({ "tongren d11" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren d11")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "阳维脉");
        set("xuewei_name", "正营穴");
        set("chongxue_xiaoguo", "POT:500");
        set("neili_cost", "600");
        setup();
}


