
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足太阴脉·隐白穴" NOR, ({ "tongren l7" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren l7")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足太阴脉");
        set("xuewei_name", "隐白穴");
        set("chongxue_xiaoguo", "NEI:30");
        set("neili_cost", "800");
        setup();
}


