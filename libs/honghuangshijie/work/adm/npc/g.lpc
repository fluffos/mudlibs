void create()
{
        set_name(HIM "大佬" NOR, ({ "gift angel", "tianshi", "gift", "angel", "liwu" }));
        set("long", @LONG
礼物天使，负责泥潭节庆期间礼物发放的天使。
LONG);
        set("gender", "女性" );
        set("age", 18);
        set("attitude", "friendly");
        set("max_jing", 50000);
        set("max_qi", 50000);
        set("max_jingli", 50000);
        set("jingli", 50000);
        set("max_neili", 50000);
        set("neili", 50000);
        set("jiali", 350);
        set("str", 50);
        set("int", 50);
        set("con", 50);
        set("dex", 50);
        set("combat_exp", 1200000);

        set("inquiry", ([
				 "出师" : (: ask_chushi :),
                 "万圣节" : (:ask_gift1 :),

        ]));

        setup();
        carry_object("/clone/misc/cloth")->wear();

}

int get_reward()
{
        object me;
        string ret;
    
        me = this_player();
        ret = FESTIVAL_D->get_reward(me);
        tell_object(me, ret);
        return 1;
}      

mixed ask_gift()
{
        object ob, me = this_player();
        string *lines;
        string file, gift;
        int time1, time2;

        file = read_file(CONFIG_DIR + "gift");
        if (! stringp(file))
        {
                command("say 可惜，天神还没有打算做任务礼物呢！");
                return 1;
        }

        lines = explode(file, "\n");
        file = lines[sizeof(lines) -1];

        if (sscanf(file, "%s %d to %d", gift, time1, time2) != 3)
        {
                command("say 奇怪，礼物怎么不见了，难道是天神在作怪？！");
                return 1;
        }

        if( query("gifter/"+time1, me) )
        {
                command("say 呵呵～这就是您的不是了！我已经给过您礼物了啊！");
                return 1;
        }

        if (time() < time1 || time() > time2)
        {
                command("say 对不起，你来的不是时候，现在送你礼物，天神会惩罚我的！");
                return 1;
        }

        if (! ob = new(gift))
        {
                 command("say 奇怪，礼物有大问题，你赶快和天神报告吧！");
                 return 1;
        } else
        {
                set("gifter/"+time1, 1, me);
                ob->move(me, 1);

                message_vision(HIW "$N" HIW "凌空一指，突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩$n，转瞬即逝！\n" NOR,
                               this_object(), me);

                tell_object(me, HIG "你身上好象多了一个礼物（gift），你快看看是什么礼物吧。\n" NOR);
                return 1;
        }
}

mixed ask_chushi(object obj)
{
        int exercise_cost;
		int skill;
		int skill1;
		int skill2;
		int skill3;
		int skill4;
		int skill5;
		int skill6;
        object ob;
        object me = this_player() ;
        skill = me->query_skill("force", 1);
		skill1 = me->query_skill("dodge", 1);
		skill2 = me->query_skill("parry", 1);
		skill3 = me->query_skill("unarmed", 1);
		skill4 = me->query_skill("sword", 1);
		skill5 = me->query_skill("blade", 1);
		skill6 = me->query_skill("martial-cognize", 1);
       // td = time() / 86400;
		
		 if (skill < 50000)
                return "你的内功还需多练。\n";
	     if (skill1 < 50000)
                return "你的轻功还需多练。\n";
	    if (skill2 < 50000)
                return "招架还需多练。\n";
	     if (skill5 < 50000)
                return "刀法还需多练。\n";
		  if (skill4 < 50000)
                return "剑法还需多练\n";
		 if (skill3 < 50000)
                return "掌法还需多练。\n";
	     if (skill6 < 50000)
                return "你的武学修养不够,不可以以出师。\n";
			// message_vision("既然你坚持，那就交手续费吧\n", me);
			
			
		        
     /*   if (me->is_busy())
        {
                tell_object(me, NOR BUSY_MESSAGE NOR); 
                return 0;
        }
        else 
                me->start_busy(2);
                
        if (!query("is da lm", obj)){
                tell_object(me, NOR CYN + query("name") + CYN + "摇头对你说道：我只要大灵脉做手续费。\n" NOR); 
                return 0;
    }*/

        tell_object(me, NOR CYN + query("name") + CYN + "点头对你说道：好了,我已飞鸽传书与你师门,你已经是老百姓了。\n" NOR); 
           
		   
		me->set_skill("force", me->query_skill("force", 1) - 50000);
		tell_object(me, HIG "你的基本内下降50000级！\n");
		me->set_skill("dodge", me->query_skill("dodge", 1) - 50000);
        tell_object(me, HIG "你的基本轻功下降50000级！\n");		
		me->set_skill("parry", me->query_skill("parry", 1) - 50000); 
		tell_object(me, HIG "你的基本招架下降50000级！\n");
		me->set_skill("blade", me->query_skill("blade", 1) - 50000);
        tell_object(me, HIG "你的基本刀法下降50000级！\n"); 		
		me->set_skill("sword", me->query_skill("sword", 1) - 50000); 
		tell_object(me, HIG "你的基本剑法下降50000级！\n");
		me->set_skill("unarmed", me->query_skill("unarmed", 1) - 50000); 
		tell_object(me, HIG "你的基本空手下降50000级！\n");
		me->set_skill("martial-cognize", me->query_skill("martial-cognize", 1) - 50000); 
		tell_object(me, HIG "你的武学修养下降50000级！\n");
			  delete("family", me);
               delete("title", me);
                set("title", "普通百姓", me);
				
        return 1;
}

mixed ask_gift1()
{
        int td;
        object ob;
        object me = this_player() ;

        td = time() / 86400;

       if( query("gifter/wsj", me) )
                return "你已经领过面具了。";

        tell_object(me, HIY "\n大佬掏出一个鬼面具呼在了你的脸上,容貌加了30\n" NOR);
        addn("per", 30, me);
        //set("bindable", 3, ob);
       // set("bind_owner",query("id",  me), ob);
        //set("autoload", 1, ob);
        //set("setdbase", 1, ob);
		set("gifter/wsj", 1, me);
      // set("gifter/which_day", td, me);
        return 1;
}


mixed ask_gift2()
{
        //int td;
        object ob;
        object me = this_player();

        //td = time() / 86400;
		if( query("online_time", me) < 86400 * 3){
                tell_object(me,CYN + query("name") + CYN + "说道：你在线年龄都没有超过3天，是小号吧？\n"+ NOR); 
                return 1;
        }      

        if( query("gifter/2018655", me) )
                return "你已经领过礼物了。";

        tell_object(me, HIY "\n你领取了一个今天的礼物(" HIM "器魂" NOR + HIY ")，祝你在王者归来里玩的愉快！\n" NOR);

        ob = new("/clone/qihun3");
        ob->move(me, 1);
        set("bindable", 3, ob);
        set("bind_owner",query("id",  me), ob);
        set("autoload", 1, ob);
        set("setdbase", 1, ob);
        set("gifter/2018655", 1, me);
        return 1;
}

mixed ask_gift7()
{
        int td;
        object ob;
        object me = this_player();
		
		td = time() / 86400;
		if( query("online_time", me) < 86400 * 3){
                tell_object(me,CYN + query("name") + CYN + "说道：你在线年龄都没有超过3天，是小号吧？\n"+ NOR); 
                return 1;
        }      

        //td = time() / 86400;
		if( query("gq", me) <  10 ){
                tell_object(me,CYN + query("name") + CYN + "说道：你活动点不足10点,不能领取\n"+ NOR); 
                return 1;
        }      

        if( query("gifter/20181011", me) )
                return "你已经领过礼物了。";

        tell_object(me, HIY "\n你领取了(" HIM "洪荒属性" NOR + HIY ")！\n" NOR);

        ob = new("/clone/hhsx");
        ob->move(me, 1);
		addn("gq", -10, me);
        set("gifter/20181011", 1, me);
        return 1;
}

