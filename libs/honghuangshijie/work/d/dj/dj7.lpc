#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{ 
	set("short", "荒山野地");
	set("long",@LONG
天空黑乎乎一片朵朵黑云聚集在一起,你掐指一算,看来这就是自己的劫难了
LONG );
	set("outdoors", "dj");
	set("exits", ([
		//"east" :  __DIR__,
		"west" :  __DIR__"dj8",
		//"south" : __DIR__,
		//"north" : __DIR__,
	]));	     
}

int valid_leave(object me, string dir)
{
	int total_steps;


    		me->receive_damage("qi", 20000000);
    		me->receive_wound("qi", 20000000);
    		message_vision(HIR"突然天空降下一道水桶粗的闪电"
				  "射向$N！"NOR"\n", me);




	return ::valid_leave(me,dir);
}

