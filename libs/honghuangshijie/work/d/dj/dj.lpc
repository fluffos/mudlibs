#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{ 
	set("short", "荒山野地");
	set("long",@LONG
天空黑乎乎一片朵朵黑云聚集在一起,你掐指一算,看来这就是自己的劫难了
LONG );
	set("outdoors", "dj");
	set("exits", ([
		//"east" :  __DIR__,
		"west" :  __DIR__"dj",
		//"south" : __DIR__,
		//"north" : __DIR__,
	]));	     
}

int valid_leave(object me, string dir)
{
	int total_steps;
     object ob;

    		me->receive_damage("qi", 100000000);
    		me->receive_wound("max_qi", 100000000);
    		message_vision(HIR"突然天空降下一道水桶粗的闪电"
				  "射向$N！     /n"
                "              /\n"
                "             /\n"
                "             ——\n"
                "                /\n"
                "               /\n"
                "              /\n"
                "\n" HIB"NOR", me);

            if (ob == me)
               set_temp("die_reason", "挑战天威,最终身死道消", ob);

        ob->receive_damage("qi", 1, me);
        ob->die();
        if (ob && wizardp(ob))
                //set("env/immortal", immortal, ob);

        return 1;

}

