// Room:/d/welcome/regroom.c
// Updated by Lonely (08/11/2002)

#include <ansi.h>
inherit ROOM;
int do_register(string arg);

void create()
{
        set("short", "泥潭注册室");
        set("long", "\n这里是新玩家进行注册的地方，请您使用指令 " HIC "register " NOR "加上你的完整及真实" HIC " email " NOR "地址进行注册。请务必认真注册你的电子邮件地址，" HIR "电子邮件地址是保障你一切权益的依据" NOR "，包括你密码的丢失情况下，我们通过你注册的信箱来确认你的身份和归还你的密码。\n\n""现在，请输入" HIW " register 您的email地址\n\n" NOR);



        set("no_fight", 1);
        set("no_magic", 1);
        set("no_steal", 1);
        set("no_beg", 1);   
	set("item_desc", ([
            "【注册】" : "电子邮件地址必须是 player@me.com 格式\n"ZJOBACTS"开始输入:zhuce\n",
	]) );     
        setup();
}

void init()
{
        add_action("do_register", "register");
        add_action("do_register", "zhuce");
}

int do_register(string arg)
{
        object me = this_player();
        string mail;
        string msg;
        
        if (! arg|| strsrch(arg, "@") == -1 
        || sscanf(arg, "%*s@%*s.%*s") != 3 
        || strsrch(arg, ",") != -1)
	    {
		tell_object(me,INPUTTXT("请输入你的邮箱地址：$br#"
						"电子邮件地址必须是 player@me.com 格式。","zhuce $txt#")+"\n");
	    }
        else
        {
                mail = arg;
                set("email", mail, me);

                msg=query("name", me)+"（"+query("id", me)+"）：\n\n";

                msg += "    欢迎进入泥潭的世界，从这一刻起您将有机会体验到其他MUD 无\n" + "法带给您的快乐。\n";
                
                set("registered", 1, me);

                tell_object(me, HIR "\n祝您在泥潭玩的愉快！:)\n\n" NOR);
                message("vision", "只见白光一闪，"+me->name()+"消失了。\n", environment(me), ({me}) ); 
                me->move("/d/register/entry");
                message("vision", "你忽然发现前面多了一个人影。\n", environment(me), me);
                
                return 1;
        }
}
