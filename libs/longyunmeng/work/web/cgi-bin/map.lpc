// board_list.c

#include <net/daemons.h>
#include <net/macros.h>

inherit F_CLEAN_UP;
string gateway(string pattern) 
{
	string result, map;

	result = "<body><pre><font size=2>";

	if ( file_size("/adm/daemons/vrm_server.map") <= 0 )
	{
		result += "没有可显示的地图";
	} else if ( stringp(map = read_file("/adm/daemons/vrm_server.map")) )
	{
		result += map;
	} else {
		result += "没有可显示的地图";
	}

	result += "</font></pre></body>";

	return result;
}

