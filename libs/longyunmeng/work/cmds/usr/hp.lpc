
#include <ansi.h>
#include <liebiao.h>
inherit F_CLEAN_UP;
inherit F_TOMUD;

string status_color(int current, int max);
int potential_lv(int exp);

int main(object me, string arg)
{
	object ob;
	mapping my;
	string level;
        string line="",hy;
	
	seteuid(getuid());
	
	if(!arg)
		ob = me;
	else if (wizardp(me))
	{
		ob = present(arg, environment(me));
		
		if (!ob)
			ob = find_player(arg);
		
		if (!ob)
			ob = find_living(arg);
		
		if (!ob)
			return notify_fail("您要察看谁的状态？\n");
	}
	else
		return notify_fail("只有巫师才可以察看别人的状态。\n");
       
	if ( me->query("env/myhp_show") && !me->query("xieyi/zmud") )
		tell_object(me, my_hp(ob));
	
	my = ob->query_entire_dbase();
	printf(NOR YEL"\n"NOR);
	printf(NOR YEL"┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n"NOR);
	printf(NOR "  "NOR HIY"基本资料——>"NOR  HIW"  中文名："NOR+CYN"["NOR HBBLU"%-12s"NOR CYN"]"NOR HIW"   英文名："NOR+CYN"["NOR HBRED"%-12s"NOR CYN"]"NOR "\n"NOR,ob->name(),capitalize(ob->query("id")));
	printf(NOR YEL"┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n"NOR);
	printf(HIR" 【精神】%s%6d/%6d %s(%3s%%)"NOR,status_color(my["jing"],my["eff_jing"]),my["jing"],my["eff_jing"],status_color(my["eff_jing"],my["max_jing"]),count_div(count_mul(my["eff_jing"],100),my["max_jing"]));
	printf(HIR"   【精力】%s%6d/%6d (+%3d)\n"NOR,status_color(my["jingli"],my["max_jingli"]),my["jingli"],my["max_jingli"],my["jiajing"]);
	printf(HIR" 【气血】%s%6d/%6d %s(%3s%%)"NOR,status_color(my["qi"],my["eff_qi"]),my["qi"],my["eff_qi"],status_color(my["eff_qi"],my["max_qi"]),count_div(count_mul(my["eff_qi"],100),my["max_qi"]));
	printf(HIR"   【内力】%s%6d/%6d (+%3d)\n" NOR,status_color(my["neili"], my["max_neili"]), my["neili"], my["max_neili"],my["jiali"]);
	printf(CYN" 【食物】%s%6d/%6d [%3d%%]"NOR,status_color(my["food"], ob->max_food_capacity()),my["food"], ob->max_food_capacity(),my["food"]*100/ob->max_food_capacity());
	//printf(CYN"  【潜能】%s%6d/%6d\n"NOR,HIY,(int)ob->query("potential") - (int)ob->query("learned_points"),potential_lv(my["combat_exp"]));
	printf(CYN"   【潜能】%s%6d/%6d\n"NOR,HIY,(int)ob->query("potential") - (int)ob->query("learned_points"),ob->query_int()*10);
	printf(CYN" 【饮水】%s%6d/%6d [%3d%%]"NOR,status_color(my["water"], ob->max_water_capacity()),my["water"], ob->max_water_capacity(),my["water"]*100/ob->max_water_capacity());
	printf(HIC"   【怒气】   "HIY"————    "HIW"["HIY"%4s"HIW"]\n"NOR,"0/5");

	if(userp(ob))
		printf(YEL" 【灵力】%s%6d/%6d [%3d%%]"NOR,status_color(my["fashufali"],my["max_fashufali"]),my["fashufali"],my["max_fashufali"],my["fashufali"]*100/my["max_fashufali"]);
	else
		printf(YEL" 【灵力】%s%6d/%6d       "NOR,status_color(my["fashufali"],my["max_fashufali"]),my["fashufali"],my["max_fashufali"]);

	if (!ob->query("wuxing/mofa") || ob->query("wuxing/mofa")<1)
		printf(YEL"   【属性】   "HIC"光明\n"NOR,);
	else
	{
		if (ob->query("wuxing/mofa")==1)
			printf(YEL"   【属性】   "HIY"土\n"NOR,);
		if (ob->query("wuxing/mofa")==2)
			printf(YEL"   【属性】   "HIR"火\n"NOR,);
		if (ob->query("wuxing/mofa")==3)
			printf(YEL"   【属性】   "HIW"水\n"NOR,);
		if (ob->query("wuxing/mofa")==4)
			printf(YEL"   【属性】   "HIG"木\n"NOR,);
		if (ob->query("wuxing/mofa")==5)
			printf(YEL"   【属性】   "HIW"气\n"NOR,);
		if (ob->query("wuxing/mofa")==6)
			printf(YEL"   【属性】   "HIB"雷\n"NOR,);
		if (ob->query("wuxing/mofa")==7)
			printf(YEL"   【属性】   "HIM"心灵\n"NOR,);
		if (ob->query("wuxing/mofa")==8)
			printf(YEL"   【属性】   "WHT"黑暗\n"NOR,);
		if (ob->query("wuxing/mofa")==9)
			printf(YEL"   【属性】   "HIW"空间\n"NOR,);
		if (ob->query("wuxing/mofa")==10)
			printf(YEL"   【属性】   "HIY"金\n"NOR,);
	}
	
	printf(HIB" 【天道】  "HIC"————"NOR);
	printf(HIB"  重"HIW"["HIY"%4s"HIW"]"NOR,"0%");
	printf(HIB"   【天劫】   "HIR"————"HIB"  次"HIW"["HIY"%4s"HIW"]\n"NOR,"0%");

	if ( strlen(level = chinese_number(ob->query("xyzx_sys/level"))) > 10 )
		level = sprintf("%d", ob->query("xyzx_sys/level"));

	printf(HIY" 【等级】  "HIW"%-10s"HIY"级"HIW"["HIY"%4s"HIW"]"NOR,level,ob->query("xyzx_sys/levup_exp")/(ob->get_levelup_exp()/100)+"%");
	printf(CYN"   【经验】%s%10d / %-10d\n"NOR,HIM,ob->query("xyzx_sys/levup_exp"), ob->get_levelup_exp());
	//printf(HIW"%s   "HIY"%16-d"HIW"  %s   "HIY"%-15d\n"NOR, "【属性点】", ob->query("xyzx_sys/shuxingdian"), "【技能点】", ob->query("xyzx_sys/skill_dian"));
	printf(NOR YEL"┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n"NOR);
	line = sprintf(HIG" %s"HIG"在江湖里已经历了"WHT" "+BLINK+HIR"%s\n"NOR, ob==me?"你":ob->name(1),FINGER_D->age_string( (int)ob->query("mud_age")));
	
	if ( ob->query_condition("killer") )
		line += sprintf(HIG" %s"HIG"被官府通缉的时间还余："HIR"%s"HIW"～"HIR"%s\n"NOR, ob==me?"你":ob->name(1), FINGER_D->age_string(ob->query_condition("killer")*10), 
		FINGER_D->age_string(ob->query_condition("killer")*30) );
	if ( ob->query("biguan_is_online") > 0 )
		line += sprintf(HIG" %s"HIG"可离线练功的时间还有："HIY"%s\n"NOR, ob==me?"你":ob->name(1), FINGER_D->age_string( ob->query("biguan_is_online")*2));
	if ( ob->query("exp_jiacheng") > time() )
		line += sprintf(HIG" %s"HIG"今天的双倍经验时间还余："HIY"%s\n"NOR, ob==me?"你":ob->name(1), FINGER_D->age_string(ob->query("exp_jiacheng")-time()));

	// 会员资料
	if ( stringp(hy = ob->query("xy_huiyuan")) )
	{
		if ( ob->query("xyhy_type") == 2 )
			line += sprintf(HIG" %s的有效会员("HIY"黄金"HIG")期限为："HIY"%s"NOR, ob==me?"你":ob->name(1), hy);
		else if ( ob->query("xyhy_type") == 1 )
			line += sprintf(HIG" %s的有效会员("HIW"白银"HIG")期限为："HIW"%s"NOR, ob==me?"你":ob->name(1), hy);
		else
			line += sprintf(HIG" %s的有效会员("NOR"普通"HIG")期限为："NOR"%s"NOR, ob==me?"你":ob->name(1), hy);
	}
        write(line);
        write("\n");
	return 1;
}

string status_color(int current, int max)
{
	int percent;
	
	if( max>0 )
		percent = atoi(count_div(count_mul(current,100),max));
	else
		percent = 100;
	
	if( percent > 100 )
		return HIC;
	
	if( percent >= 90 )
		return HIG;
	
	if( percent >= 60 )
		return HIY;
	
	if( percent >= 30 )
		return YEL;
	
	if( percent >= 10 )
		return HIR;
	
	return RED;
}

int potential_lv(int exp)
{
	int grade;
	
	grade = 100 + exp / 500;
	
	return grade;
}

int help(object me)
{
        write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP
    );
    return 1;
}

