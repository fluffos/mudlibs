// /d/taohua/npc/house_maker.c 小童
//2003.6.5 lisa(ps)

inherit NPC;
void consider();
void make_house(object me);
void make_house(string str);

void create() {
  set_name("小童", ({ "xiao tong", "tong", "xiao" }));
  set("gender", "男性");
  set("age", 14);
  set("per", 30);
  set("long",
    "这是个约十来岁的漂亮的小男孩，眼里还透着丝丝稚气。\n");
  set("attitude", "peaceful");
  set("inquiry", ([
    "建房": "“好呀好呀：） 又多了个邻居了。”小童开心的笑了，“不过建房子要5W GOLD的哦。。”\n\n",   //需要1000两黄金
    "all": "”别告诉别人哦，我知道关于" + HIC + "建房" + NOR + CYN + "的事情。“ 小童调皮的冲你眨了眨眼睛。",
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object xt;
  xt = this_object();
  if (!ob || environment(ob) != environment()) return;
  if (xt->query_temp("name") == ob->name()) {

    tell_room(
      environment(ob),
      "小童看见你，高兴的说：”我已经和村长说了：） 你的房子正在建设中哦，建好了后，从这儿就可以回家了的哦：） 好了，我去玩去了，拜拜！”"
    );
    xt->delete_temp("name");
    xt->move("/d/taohua/taoyuanxiaojing");
    return;
  }
  if (RANK_D->query_respect(ob) == "小姑娘" || RANK_D->query_respect(ob) == "姑娘" || RANK_D->query_respect(ob) == "婆婆") {
    say("小童调皮的绕着你一转，拉起" + ob->name() + "的手笑咪咪地说道：“小姐姐，这儿漂亮吧：） 我好喜欢这儿的，能住这儿真好。”\n");
  } else if (RANK_D->query_respect(ob) == "小兄弟" || RANK_D->query_respect(ob) == "壮士" || RANK_D->query_respect(ob) == "老爷子") {
    say("小童笑眯眯冲" + ob->name() + "一笑，“大哥哥，想买房子吗？这儿可是很漂亮的哦。”\n");
  }
  return;
}

int accept_object(object me, object ob)  //交钱
{
  object xt;
  if (me->query("house")) {
    return notify_fail("小童摇了摇头：“你已经有房子了，还是留给人家吧。”！\n");
  }
  if (!me->query("couple")) {
    return notify_fail("小童犹豫了会儿，说：“您还没结婚呀？想一个人住吗？这个。。现在住房紧张啊，村长恐怕不会给批准的耶！”");

  }
  if (!ob->query("money_id")) {
    return notify_fail("小童疑惑的望着你，谢谢，我只喜欢吃糖。。。。”\n");

  }
  if (ob->value() < 100000000) {
    return notify_fail("小童皱了皱眉头：“这。。这。。这恐怕。。。。”。”\n");

  }
  tell_room(
    environment(me),
    "小童高兴的跳了起来：“太好了，又多了个人陪我玩了，我这就帮你去村长那儿申请去：） 你在广场上来找我吧：）\n小童一蹦一跳的往北去了。\n"
  );
  xt = this_object();
  xt->move("/d/taohua/taoyuanguangchang");
  xt->set_temp("name", me->name());   //记录给钱的人
  me->set("housu", 1);

  write_file("/d/home/houselist", me->name() + "(" + me->query("id") + ") \n", 0);

  return 1;
}
