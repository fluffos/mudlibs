// /d/taohua/taoyuanguangchang.c 桃园广场
// 2003/6/5 lisa(ps)
#include <ansi.h>
#include <room.h>

inherit ROOM;

mapping home = ([
  "lisa": "/d/home/lisa",
]);

string *bgao = ({
  "lisa and icecream",
});





object find_player(string target);
int look_bugao(object me);

void create() {
  set("short", "桃园广场");
  set("long", @LONG
走了一小会儿，你眼前陡然开阔了起来，这是桃花岛边上临海
的一个大广场，黄药师虽然性格孤僻，但也没将这个岛上原本的住
民驱逐出岛，只是严令其不得进入桃花岛深处，而事实上，由于桃
花谜阵的存在，居民们也无法进入。长久以来，彼此倒也相安无事
。居民们在此捕鱼打猎为生，倒也称得上是一片人间仙境。广场上
人来人往，热闹非常，四周，隐隐可见一座座楼房的轮廓。
	广场中间的布告栏上，张贴着一张醒目的布告(bugao)。
LONG
  );
  set("exits", ([
    "south": __DIR__ "taoyuanxiaojing",
  ]));
  set("objects", ([
  ]));

  set("item_desc", ([
    "bugao": (: look_bugao :),
  ]));
  setup();

}

int look_bugao(object me) {
  int i = 0;
  tell_object(me, "分房通知：\n");
  tell_object(me, "现在本村分配有如下住房：\n");
  tell_object(me, "__________________________________________________________\n");

  for (i = 0; i < sizeof(bgao); i++) {
    tell_object(me, bgao[i] + "\n");
    i++;
  }
  tell_object(me, "__________________________________________________________\n");
  tell_object(me, "房主可通过键入\n");
  tell_object(me, "         enter <房间的第一个ID>\n");
  tell_object(me, "\n");
  tell_object(me, "来进入自己的家。\n");
  tell_object(me, "希望大家不要在没有受到邀请的情况下，擅自闯入他人家中。\n");
  tell_object(me, "谢谢！\n");
  tell_object(me, "                                            村长\n");



  return 1;
}

void init() {
  add_action("do_enter", "enter");
}

object find_player(string target) {
  int i;
  object *str;
  str = users();
  for (i = 0; i < sizeof(str); i++)
    if (str[i]->query("id") == target) {
      if (!environment(str[i])) return 0;
      else
        return str[i];
    }
  return 0;
}

int do_enter(string arg) {
  object me, room, ob;
  me = this_player();
  if (!arg) {
    tell_object(me, "你想进入谁的家？\n");
    return 1;
  }
  if (!stringp(home[arg])) {
    tell_object(me, "没有这户人家呀？\n");
    return 1;
  }
  if (!arg == me->name() && !(arg == me->query("couple/couple_id")) && !(arg == me->query_temp("yaoqing"))) {
    tell_object(me, "kick,说了不要乱闯人家的家，怎么不听话？\n");
    return 1;
  }
  if (!room = find_object(home[arg]))
    room = load_object(home[arg]);
  tell_room(environment(me), me->name() + "轻轻推开一扇门，走了进去。\n");
  me->move(room);
  tell_room(environment(me), me->name() + "轻轻推开门，走了进来。\n");
  if (arg == me->query_temp("yaoqing")) {
    ob = find_player(arg);
    if (!(environment(me) == environment(ob))) {
      if (!room = find_object("/d/taohua/taohuaguangchang"))
        room = load_object("/d/taohua/taohuaguangchang");
      me->move(room);
      return notify_fail("进门一开，却发现主人并不在家中，你扫兴的退了回来。\n");
    } else {
      me->delete_temp("yaoqing");
    }
  }
  return 1;
}
