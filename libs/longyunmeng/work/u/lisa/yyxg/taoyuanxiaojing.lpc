// 2003/6/5 lisa(ps)

#include <ansi.h>
#include <room.h>
inherit ROOM;

int look_sign(object me);

void create()
{
        set("short", "桃园小径");
        set("long",@LONG
这是一条窄窄的小径，路面全是大大小小的鹅卵石铺就而成，
走在上面格外的舒服，路两旁，桃林密密，桃花终年不谢，淡淡请
香拌着清风翩翩起舞。你不由疑入梦境。
	左手边，一棵桃树上挂了一个大大的木牌(sign)。
LONG
);
	set("exits", ([
"east" : __DIR__"dating",	
"north" : __DIR__"ph",	
				]));
	set("objects", ([
__DIR__"npc/officer" : 1,        	
					]) );
    set("item_desc", ([
                "sign": (: look_sign :),
					 ]) );
	setup();
     
}

int look_sign(object me)
{
        write(@LOOK
申请住房，请找老头，谢谢。	
LOOK
        );
return 1;
}
