// longsword.c 长剑
#include <weapon.h>
inherit SWORD;
void create() {
  set_name(HIG "心剑" NOR, ({ "xin jian", "changjian", "jian", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", HIC "无心之心，星心之剑。\n" NOR);
    set("value", 100);
    set("material", "steel");
    set("wield_msg", HIR "$N轻吟「我心悠悠...今朝无心...缕魂何归?可怜可叹.....」摇了摇头,无声无息手中已多了一柄$n。\n" NOR);
    set("unwield_msg", HIY "$N微微叹息:心之何所在,魂之何所归!手中的$n摆了摆插回鞘中。\n");
  }
  init_sword(500, 2);
  setup();
}
int query_autoload() { return 1; }
