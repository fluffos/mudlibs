cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "dongdajie1.lpc"),("d/" + "party/" + me->query("party/id") + "/dongdajie1.lpc"));

cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "leitai.lpc"),("d/" + "party/" + me->query("party/id") + "/leitai.lpc"));              
write(HIG"\n请设定帮派中文名称"HIR"(务必使用中文，否则一切损失自负)"HIG"：");	
input_to("get_partyname", 1, me );        	
return 1;
}
int get_partyname(string str,object me)	
{
    int i;
    i = strlen(str);
    while(i--) {
        if( str[i]<=' ' ) {
            write(HIY"\n帮派中文名称不能用控制字元，请重新设定帮派中文名称：\n"NOR);
            //me->delete("party");
            input_to("get_partyname", 1, me );
            return 1;
        }
        if( i%2==0 && !is_chinese(str[i..<0]) ) {
            write(HIY"\n帮派中文名称只能是中文，请重新设定帮派中文名称：\n"NOR);
            //me->delete("party");
			input_to("get_partyname", 1, me );
            return 1;
        }
    }
    me->set("party/name",str);	
    me->set("bh_rank",HIC"帮主"NOR);                   
message("channel:chat", HIY"\n【帮派精灵】"+HIM"："+me->query("name")+"于今日开帮立会，成立"+me->query("party/name")+"帮，武林为之大放异彩。\n"NOR,users());
write_file("/log/cmds/party",sprintf("%s   创建帮派   %s%s on %s\n", me->query("id"),me->query("party/name"),"("+me->query("party/id")+")", ctime(time()) ));	
}
