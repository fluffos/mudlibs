int ask_party(string arg)
{
    object me;
    object lu;
    lu=this_object();	
    me=this_player();
    if (me->query("more_money") < 100)  
    {
	command("say 对不起，你的资金不足,买不起地盘。");
	return 1;
    }
if (!me->query("xy_huiyuan") && me->query("combat_exp") < 50000000)  	
{
command("say 你实战经验不足，无以成为一帮之主。");	
return 1;	
}
    write("请输入帮派英文名称：");	
    input_to("get_partyid", 1, me );	
    return 1;
}
int get_partyid(string str,object me)
{
   int i;
   i = strlen(str);
   while(i--)
        if( str[i]<'a' || str[i]>'z' ) {
            write(HIY"\n你的帮派英文名称只能用英文字母。\n"NOR);
            return 1;
   }
if( file_size("/d/party/" + str +"/dating.lpc")!=-1 || me->query("party/id",1) )   {                                           
write(HIY"\n该帮派名称已存在或你还没有退出原有的帮派！\n"NOR);
return 1;	
}
write(HIG"\n请再次输入以确认你的帮派英文名："NOR);
input_to("get_new_partyid", 1, me );            	
}
int get_new_partyid(string str,object me)   	
{
   int i;
   i = strlen(str);
   while(i--)
        if( str[i]<'a' || str[i]>'z' ) {
            write(HIY"\n你的帮派英文名称只能用英文字母。\n"NOR);
            return 1;
   }
if( file_size("/d/party/" + str +"/dating.lpc")!=-1 || me->query("party/id",1) )   {                                           
write(HIY"\n该帮派名称已存在或你还没有退出原有的帮派！\n"NOR);
return 1;	
}
me->set("party/id",str);	
me->set("party/zhu",1); 	
me->add("more_money",-100);	
mkdir("d/" + "party/" + me->query("party/id"));           	
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "dating.lpc"),("d/" + "party/" + me->query("party/id") + "/dating.lpc"));                           	
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "guanchang.lpc"),("d/" + "party/" + me->query("party/id") + "/guanchang.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "beidajie1.lpc"),("d/" + "party/" + me->query("party/id") + "/beidajie1.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "beidajie2.lpc"),("d/" + "party/" + me->query("party/id") + "/beidajie2.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "beidajie3.lpc"),("d/" + "party/" + me->query("party/id") + "/beidajie3.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "beidajie4.lpc"),("d/" + "party/" + me->query("party/id") + "/beidajie4.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "beidajie5.lpc"),("d/" + "party/" + me->query("party/id") + "/beidajie5.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "nandajie5.lpc"),("d/" + "party/" + me->query("party/id") + "/nandajie5.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "nandajie4.lpc"),("d/" + "party/" + me->query("party/id") + "/nandajie4.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "nandajie3.lpc"),("d/" + "party/" + me->query("party/id") + "/nandajie3.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "nandajie2.lpc"),("d/" + "party/" + me->query("party/id") + "/nandajie2.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "nandajie1.lpc"),("d/" + "party/" + me->query("party/id") + "/nandajie1.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "xidajie1.lpc"),("d/" + "party/" + me->query("party/id") + "/xidajie1.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "xidajie2.lpc"),("d/" + "party/" + me->query("party/id") + "/xidajie2.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "xidajie3.lpc"),("d/" + "party/" + me->query("party/id") + "/xidajie3.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "xidajie4.lpc"),("d/" + "party/" + me->query("party/id") + "/xidajie4.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "xidajie5.lpc"),("d/" + "party/" + me->query("party/id") + "/xidajie5.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "dongdajie5.lpc"),("d/" + "party/" + me->query("party/id") + "/dongdajie5.lpc"));                              
cp(("u/" + "wenwu/"  + "party/" + "youyun/" + "dongdajie4.lpc"),("d/" + "party/" + me->query("party/id") + "/dongdajie4.lpc"));                              
