#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "欲灵之芝" NOR, ({ "ling zhi", "zhi" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "这是一棵成形灵芝，名曰∶仙知芝。只应天上有-无求在人间，仙品也！\n");
    set("owner_id", 1);
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("no_drop", 1);
  }
  setup();
}

int do_eat(string arg) {
  object me, ob;

  me = this_player();

  if (!id(arg) || !objectp(ob = present(arg, me)))
    return notify_fail("你要吃什么？\n");

  me->add("combat_exp", 2000000);
  me->add("potential", 50000);
  message_vision("$N吃下一棵万年灵芝，只觉得自己又变利害了一些 !\n", this_player());
  destruct(this_object());
  return 1;
}

void owner_is_killed() { destruct(this_object()); }
