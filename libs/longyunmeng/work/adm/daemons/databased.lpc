// 数据库服务 Database_Server_v_1.000(MYSQL)

inherit F_DBASE;

int db_handle = 0;

protected void sys_msg(string);
protected void connect_to_database();

void create()
{
	seteuid(getuid());
	set("channel_id", "数据库服务");
	sys_msg("数据库服务已启动"NOR);
	connect_to_database();
}

// 连接数据库
protected void connect_to_database()
{
        mixed n;

        n = db_connect("127.0.0.1", "xyzx_db", "wenwu");

        if (intp(n) && (n > 0))  // 连接成功
        {
                db_handle = n;
                sys_msg("已经与MySQL数据库建立连接！连接号是：" + n);
				sys_msg(db_status());
                return;
        }
        else
        {
			sys_msg("连接失败");
        }
}

// 调试信息
protected void sys_msg(string msg)
{
	message("wiz", HIR"版本服务："HIW+msg+"\n"NOR, users());
}