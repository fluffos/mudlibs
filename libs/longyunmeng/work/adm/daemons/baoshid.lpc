void create() {
  seteuid(getuid());
  set("channel_id", "宝石精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "宝石精灵已经启动。\n" NOR);
  set_heart_beat(150);
}

private void heart_beat() {
  remove_call_out("choose_baoshi");
  call_out("choose_baoshi", 150);
}

void choose_baoshi() {
  int i, j, k, ppl, rd;
  object *list, newob;
  string str, m_name;
  string smp;

  j = random(sizeof(dirs));
  rd = random(6);
  newob = new("/quest/baoshi/baoshis/baoshi");
  str = "神";

  reset_eval_cost();

  if (random_place(dirs[j], newob) == 1)
    message(
      "channel:chat",
      HIG "【" HIM "奇珍异宝" HIG "】：" + HIW "突然空中打了个炸雷,一个火球横空出世,拖着一道" + str + "光向" + dirname[j] + "的方向落去！\n" NOR,
      users()
    );

  if (newob->query("b_lvl") > 14)
    message(
      "channel:chat",
      HIG "【" HIM "奇珍异宝" HIG "】：" HIW + newob->name() + HIW "降临凡间！\n" NOR,
      users()
    );
  return;
}

int random_place(string dirss, object bs) {
  int j, k, m;
  object newob, ob;
  mixed *file, exit;
  string id_name;

  file = get_dir(dirss + "/*.lpc", -1);

  if (!sizeof(file))
    file = get_dir("/binaries" + dirss + "/*.b", -1);

  if (!sizeof(file))
    return 0;

  for (k = 0; k < sizeof(file) - 1; k++)  //进行多次索检
  {
    if (m == 1) {
      m = 0;
      break;
    }

    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirss + "/" + file[j][0][0..<3]);  //去掉文件名后缀，使读.b文件时也正常
      if (!newob) continue;
      if (newob->is_character()) continue;
      id_name = newob->query("short");
      if (newob->is_character())
        destruct(newob);
      if (!id_name) continue;
      if (bs->move(newob)) {
        CHANNEL_D->do_channel(
          this_object(),
          "sys",
          "宝石落到了" HIY + id_name + HIW "(" + file_name(newob) + ")。" NOR
        );
        m = 1;
        return 1;
      }
    }
  }

  CHANNEL_D->do_channel(this_object(), "sys", "本次宝石发布失败");
  return 0;
}
