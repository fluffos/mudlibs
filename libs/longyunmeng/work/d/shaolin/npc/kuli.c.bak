// kuli.c 酷吏
inherit NPC;

void del_shuxing(object ob, int levl_num);

void create()
{
    set_name("赵六", ({ "zhao liu", "liu", "zhao" }));
    set("title", "刑部酷吏");
    set("nickname", "水火棍");
    set("str", 37);
    set("gender", "男性");
    set("age", 35);
    set("long",
        "他是刑部大堂里一名值班的小吏。官不大，可权力却不小\n");
    set("combat_exp", 1500);
    set("attitude", "friendly");
    set("inquiry", ([
        "自首" : "要自首先得交钱。",   //需要30两黄金
    ]));
    
    setup();
    carry_object("/clone/misc/cloth")->wear();
//  carry_object("/d/shaolin/obj/qimeigun")->wield();
}
void init()
{
    object ob;
    
    ::init();
    if (interactive(ob = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_betray","decide");
}
void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    switch(random(2)) {
    case 0 :
        say("赵六笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
            "，快请进来歇口气吧。\n");
        break;
    case 1 :
        say("赵六说道：哟！这位" + RANK_D->query_respect(ob) + 
            "您来了啊！您要清除您的判师记录吗？\n");
        break;
    }
}
int accept_object(object who, object ob)
{
    
    if(! (int)who->query("betrayer"))
	{
        tell_object(who, "赵六说道：你已经没有判师记录了呀！\n");
		return 0;
	}

    if (ob->query("money_id") && ob->value() >= 1000000)
    {
        tell_object(who, "赵六笑眯眯地说到：好吧，每清除一次判师记录要减去15%的经验、并且各门功夫降两级。\n");
        tell_object(who, "你考虑清楚了就请作出决定吧。(decide)\n");
        who->set_temp("fee_paid",1);
        return 1;
    }
    else if (ob->query("money_id") && ob->value() < 1000000) 
    {
        tell_object(who, "赵六嘿嘿一笑，说道：给我这麽多钱？ 将来我可没法还你啊。\n");
        return 1;
    }
    return 0;
}
int do_betray()
{
    int i, level, exper, ob_levl_1, ob_levl_2, levl_num;
	int ob_levl, autolevup_num, sxd;
    object me;
    mapping skill_status;
    string *sname;

    me = this_player();

    if(! (int)me->query("betrayer"))
        return notify_fail("赵六说道：你已经没有判师记录了呀！\n");
    
	if( !me->query_temp("fee_paid") ) 
        return notify_fail("赵六冷冷地说道：不管叫我做什麽，您可得先付钱哪！\n");
    
	me->add("betrayer", -1);
	me->add("potential", -(me->query("potential")/2));

    /*if ( !(skill_status = me->query_skills()) )
    {
		exper = ((me->query("combat_exp"))/100)*85;	
        me->set("combat_exp", exper);
        me->delete_temp("fee_paid");
        tell_object(me, "赵六笑眯眯地说到：好啦，判师记录清除了一次。\n");
        me->unconcious();
        return 1;
    }*/

	if ( skill_status = me->query_skills() )
	{
		sname  = keys(skill_status);
		for(i = 0; i < sizeof(skill_status); i++) 
		{
		    level = skill_status[sname[i]] - 2;
			if(level <= 0)
				me->delete_skill(sname[i]);
			else
				me->set_skill(sname[i], level);
		}
	}

	ob_levl_1 = me->query("xyzx_sys/level");

	//实战经验损失3%
	me->add("combat_exp", -(int)me->query("combat_exp") / 20 * 3);
	//经验损失3%
	me->add("xyzx_sys/levup_exp", -(int)me->query("xyzx_sys/levup_exp") / 20 * 3);
				
	//等级损失
	if ( me->query("xyzx_sys/level") > 1 )
	{
		if ( me->query("xyzx_sys/level") > 0 && me->query("xyzx_sys/level") < 5 )
			me->add("xyzx_sys/level",-1);
		else
			me->add("xyzx_sys/level", -(int)me->query("xyzx_sys/level") / 5);
	}

	// 等级制相关损失
	ob_levl_2 = me->query("xyzx_sys/level");
	ob_levl = ob_levl_1 - ob_levl_2;
	sxd = me->query("xyzx_sys/shuxingdian");
	if ( ob_levl_1 > 1 && ob_levl >= LEVEL_UP_NUM )
	{
		autolevup_num = me->query("xyzx_sys/auto_levup");
		if ( autolevup_num >= ob_levl )
		{
			me->add("xyzx_sys/auto_levup", -ob_levl);
			levl_num = ob_levl / LEVEL_UP_NUM;
			levl_num *= LEVUP_SHUXD_NUM_ONE;
			levl_num += LEVUP_SHUXING_NUM_ONE * 4 * (ob_levl / LEVEL_UP_NUM);
		}
		else
		{
			me->set("xyzx_sys/auto_levup", 0);
			levl_num = autolevup_num / LEVEL_UP_NUM;
			levl_num *= LEVUP_SHUXD_NUM_ONE;
			levl_num += LEVUP_SHUXING_NUM_ONE * 4 * (autolevup_num / LEVEL_UP_NUM);
			levl_num += ((ob_levl - autolevup_num)/LEVEL_UP_NUM) * LEVUP_SHUXD_NUM_TWO;
			levl_num += LEVUP_SHUXING_NUM_TWO * 4 * ((ob_levl - autolevup_num) / LEVEL_UP_NUM);
		}
		if ( sxd >= levl_num )
			me->add("xyzx_sys/shuxingdian", -levl_num);
		else
		{
			me->set("xyzx_sys/shuxingdian", 0);
			levl_num -= sxd;
			del_shuxing(me, levl_num);
		}
	}

    me->delete_temp("fee_paid");
    tell_object(me, "赵六笑眯眯地说到：好啦，判师记录清除了一次。\n");
    me->unconcious();
    return 1;
}

void del_shuxing(object ob, int levl_num)
{
	int num, num1, num2, flat;

	if ( levl_num > 8 )
	{
		num = levl_num/8;
		num1 = num*4;
		num2 = random(num1);
		ob->add("xyzx_sys/jingzhun", -(num+num2));
		num1 -= num2;
		num2 = random(num1);
		ob->add("xyzx_sys/minjie", -(num+num2));
		num1 -= num2;
		num2 = random(num1);
		ob->add("xyzx_sys/lingxing", -(num+num2));
		num1 -= num2;
		ob->add("xyzx_sys/fanying", -(num+num1));
		if ( ob->query("xyzx_sys/jingzhun") < 1 )
			ob->set("xyzx_sys/jingzhun", 1);
		if ( ob->query("xyzx_sys/minjie") < 1 )
			ob->set("xyzx_sys/minjie", 1);
		if ( ob->query("xyzx_sys/lingxing") < 1 )
			ob->set("xyzx_sys/lingxing", 1);
		if ( ob->query("xyzx_sys/fanying") < 1 )
			ob->set("xyzx_sys/fanying", 1);
	}
	else
	{
		flat = 0;
		while ( levl_num > 0 )
		{
			flat++;
			if ( flat > 30 ) break;
			if ( ob->query("xyzx_sys/jingzhun") <= 1
				&& ob->query("xyzx_sys/minjie") <= 1
				&& ob->query("xyzx_sys/lingxing") <= 1
				&& ob->query("xyzx_sys/fanying") <= 1 )
				break;
			switch (random(4))
			{
				case 0:
					if ( ob->query("xyzx_sys/jingzhun") > 1 )
					{
						ob->add("xyzx_sys/jingzhun", -1);
						levl_num--;
						break;
					}
				case 1:
					if ( ob->query("xyzx_sys/minjie") > 1 )
					{
						ob->add("xyzx_sys/minjie", -1);
						levl_num--;
						break;
					}
				case 2:
					if ( ob->query("xyzx_sys/lingxing") > 1 )
					{
						ob->add("xyzx_sys/lingxing", -1);
						levl_num--;
						break;
					}
				case 3:
					if ( ob->query("xyzx_sys/fanying") > 1 )
					{
						ob->add("xyzx_sys/fanying", -1);
						levl_num--;
					}
					break;
				default:log_file( "/cmds/die_levl", sprintf("%s(%s)死亡属性削弱出错。\n",ob->query("name"), ob->query("id")));
			}
		}
	}
}