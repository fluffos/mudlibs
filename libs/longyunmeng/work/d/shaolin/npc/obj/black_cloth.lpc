// xuan-cloth.c
//
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("布衣", ({ "cloth" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("icon","10001");
                set("unit", "件");
            set("shaolin",1);
                set("material", "cloth");
        set("armor_prop/intelligence", 3000);
                set("armor_prop/armor", 50);
        }
        setup();
}

int query_autoload() { return 1; }