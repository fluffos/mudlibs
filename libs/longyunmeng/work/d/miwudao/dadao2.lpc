// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "林荫小道");
  set("long",
    "一条人工修建的土路，绵延向北方延伸，地上有几道轮子的痕迹，\n"
    "看样子北方有人类居住。路的两旁是葱郁的树木，沿着土路，也\n"
    "向远处伸展。\n"
  );
  set("exits", ([
    "south": __DIR__ "huangye1",
    "north": __DIR__ "dadao1",
    "west": __DIR__ "shulin1",
  ]));
  setup();
  //replace_program(ROOM);
}
