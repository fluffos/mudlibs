"再往北走就是迷雾岛的小广场了。\n"
);
	set("exits",([
	"south" : __DIR__"dajie11",
	"north" : __DIR__"xiaoguangchang3",
	]));

	set("objects",([
	__DIR__"npc/boy":1,
	__DIR__"npc/girl":1,
	]));

	setup();
//replace_program(ROOM);
}
