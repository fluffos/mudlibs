//shopkeeper6.c
//低买高卖,是道格拉斯的本行.
inherit NPC;
void add_room_money(object me);
int buy_object(object who, string arg);
void compelete_trade(object who, string arg);
void create()
{
        set_name("道格拉斯", ({ "shopman douglas","douglas"}) );
        set("nickname","当铺老板");
        set("gender", "男性");
        set("age", 35);
        set("long","道格拉斯是个成功的商人,贱买高卖是他最拿手的本领,他是迷雾岛为数不多的\n"
                   "几个富豪之一.\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);
      	set_skill("divinemagic",90);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

        setup();
        
        add_money("silver",random(100)+1);
}

void add_room_money(object me)
{
        int i;
        object room;
        room=environment(this_object());

        i=10000;
        if(room)
        {
        i+=room->query("rich");
        room->set("rich",i);
        return ;
        }
        else
        return;
}
int buy_object(object who, string arg)
{
        int i,index;
        object *inv, ob,storage;
        storage=environment(this_object())->query("storage_ob");

        if( !storage ) return 0;
        inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
        if( !sizeof(inv) ) return 0;

        if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
        index--;
        for(i=0; i<sizeof(inv); i++)
                if( inv[i]->id(arg) && !(index--)) break;

        if( i==sizeof(inv) )
             return 0;
        ob = inv[i];

        return ob->query("value")*2;
}
void compelete_trade(object who, string arg)
{
        int i,index;
        object *inv, ob,storage;

        storage=environment(this_object())->query("storage_ob");

        if( !storage ) return ;
        inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
        if( !sizeof(inv) ) return ;


        if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
        index--;
        for(i=0; i<sizeof(inv); i++)
                if( inv[i]->id(arg) && !(index--)) break;
        if( i==sizeof(inv) )
                return ;
        ob = inv[i];

        this_player()->start_busy(1);

        message_vision("$N掏出钱买下一" + ob->query("unit") + ob->name() + "。\n",
                this_player() );
        environment()->add("rich",ob->query("value")*2);
        ob->delete("pawned_time");
        ob->move(this_player());

        return ;
}
