inherit NPC;
void create() {
  set_name("奥古斯塔", ({ "chamberlain augusta" }));
  set("nickname", "迷雾堡大管家");
  set("gender", "男性");
  set("age", 55);
  set("long", "此人是迈西斯忠实的管家,三十年前就为迈西斯服务,负责整个迷雾堡的一切饮食起居.\n");

  set("combat_exp", 100000);

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("silver", random(20) + 1);
}
