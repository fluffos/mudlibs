#pragma save_binary
// waiter.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>

int ask_heal();
int heal_me(object me);
int cast_heal_magic(object me,int i);
string check_env(object player,object npc);
void create()
{
	set_name("马休斯", ({ "shopman matthews","matthews"}) );
        set("nickname","药店老板");
        set("gender", "男性");
        set("age", 45);
        set("long","马休斯的拥有强大的牧师魔法,能够迅速的为病人疗伤,即使是在死亡边缘挣扎的人\n"
        	   "也能够被他拉回来,因此马休斯在迷雾岛非常受欢迎,其在迷雾岛的声望甚至有些超\n"
        	   "过了堡主迈西斯\n");
	set("combat_exp", 500000);
	set("inquiry", ([
	"治伤": (: ask_heal :),
	"开药": (: ask_heal :),
	"治病": (: ask_heal :),
	"疗伤": (: ask_heal :),
	"救命": (: ask_heal :),
	"恢复": (: ask_heal :),
	]) );
	set("per",30);
	set("where","south");
	set("vendor_goods", ([
	__DIR__"obj/sendrug":12,
	__DIR__"obj/keedrug":22,
	__DIR__"obj/gindrug":12,
	]) );
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(20) ) {
		case 0:
message_vision("$N望了$n一眼，低声说道：你面黄肌瘦，肾水亏空，是否．．．过度？\n",this_object(),ob);
			break;
	}
}

int ask_heal()
{
	object me;
	int damage_point,max_kee,max_sen;
	string msg;
	
	me=this_player();	
        
        if (this_object()->is_fighting())
        {       
        	command("say 没看见有人要杀我吗?");
        	return 1;
        }
	if (me->is_fighting())
	{       
        	command("say 你正在打架，叫我怎么帮你疗伤啊！");
        	return 1;
        }
	if(me->query("max_sen")<0||me->query("max_kee")<0)
	{
		command("say 你已经无药可救了,我帮不上一点忙.你还是回去准备后事吧");
		return 1;			
	}
	if (this_object()->query("cast_heal_magic"))
	{       
        	command("say 请您稍等片刻,我正在为他人疗伤");
        	return 1;
        }

        max_sen=me->query("max_sen");
        max_kee=me->query("max_kee");

        damage_point=((max_kee-me->query("eff_kee"))*100/max_kee+
                      (max_sen-me->query("eff_sen"))*100/max_sen)*100;

	if(damage_point<=0)
	{
		command("say 您根本就没有受伤.");
		return 1;
	}
	if(!me->can_afford(damage_point))
        {
                msg="我也要养活我得家人,没钱我可不会为你疗伤.\n";
                command("say "+msg);
                return 1;
        }

	tell_room(environment(me),"马休斯自言自语不知道在说些什麽。",({me,this_object()}));
	tell_object(me,"马休斯双手轻轻放在你的额头,开始吟诵咒语\n");
	call_out("cast_heal_magic",2,me,0);//0传给i,从msg得第0行开始显示
	set("cast_heal_magic",1);
	return 1;

}

int cast_heal_magic(object me,int i)
{
	string *msg;
	msg=({"天地间神圣的精灵们啊\n",
	    "拥有母性的大地气息啊\n",
	    "祈求您救救在我面前的这个人\n",
	    "用您的慈爱的宽怀,救救他吧!\n",
	    });	
	if(check_env(me,this_object())=="no")
	{
		delete("cast_heal_magic");
		return 1;	
	}
	if(i<=3)
	{
		tell_object(me,HIC+msg[i]+NOR);
		call_out("cast_heal_magic",2,me,i+1);
	}
	else
		call_out("heal_me",random(3),me);
	return 1;	
}


int heal_me(object me)
{
        int damage_point,max_kee,max_sen;
        string msg;

	if(check_env(me,this_object())=="no")
	{
		delete("cast_heal_magic");
		return 1;	
	}
        max_sen=me->query("max_sen");
        max_kee=me->query("max_kee");

      	me->start_busy(2);

        damage_point=((max_kee-me->query("eff_kee"))*100/max_kee+
                      (max_sen-me->query("eff_sen"))*100/max_sen)*100;
	//command("say"+sprintf("damage_point%s  max_kee%s  max_sen%s eff_kee%s  eff_sen%s\n",
	//damage_point,max_kee,max_sen,me->query("eff_kee"),me->query("eff_sen")));
	if(damage_point<=0)
	{
		delete("cast_heal_magic");
		return 1;
	}
	if(!me->can_afford(damage_point))
        {
                delete("cast_heal_magic");
                msg="马休斯念完最后一句咒语,却发现你竟然没钱缴纳施法费,气的立刻硬生生的终止了魔法\n";
                tell_object(me,msg);
                return 1;
        }

	else
        {
        	delete("cast_heal_magic");
        	me->pay_money(damage_point);
                msg="马休斯在念完咒语,你感觉好多了...\n";
                tell_object(me,msg);
                command("say 今天我治好了你的病，以后你要小心啊！");
                me->set("eff_kee",max_kee);
                me->set("eff_sen",max_sen);
                me->set("kee",max_kee);
                me->set("sen",max_sen); 
        	return 1;
        }
}


string check_env(object player,object npc)
{

	if(!player||!objectp(player)||base_name(environment(npc))!=npc->query("startroom")
	||environment(npc)!=environment(player)
	||npc->is_fighting()||player->is_fighting()
	||player->query("max_sen")<0||player->query("max_kee")<0)
	return "no";
	return"";
	
}