#pragma save_binary

#include <ansi.h>

inherit NPC;
void create()
{
	string *name;
	name=({
	"沙皮狗",
	"长毛狗",
	"哈巴狗",
	"牧羊犬",
	"流浪狗",
	});
	set_name(name[random(4)], ({ "dog" }) );
	set("long","一只狗,也不知道是谁家的.\n");
	set("race","野兽");
        set("limbs", ({ "头部", "身体", "尾巴","前爪" }) );
        set("verbs", ({ "bite", "claw" }) );
   

	set("per",30);
	set("str",30);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 5000);


	setup();

        add_money("silver",random(10));

}

