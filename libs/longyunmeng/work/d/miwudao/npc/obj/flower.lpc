// pink_cloth.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  string *name;
  name = ({
    HIR "红玫瑰" NOR, BLU "蓝天鹅" NOR, HIW "白茶花" NOR, BLU "勿忘我" NOR, HIC "满天星" NOR,
    HIM "郁金香" NOR, MAG "紫罗兰" NOR, YEL "黄玫瑰" NOR, "黑牡丹", BLU "君子兰" NOR,
    HIY "白玉兰" NOR,
  });
  set_name(name[random(11)], ({ "flower" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一朵美丽的花。\n");
    set("unit", "朵");
    set("value", 6);
    set("material", "plant");
    set("armor_prop/armor", 5);
    set("armor_prop/personality", 5);
    set("wear_msg", "$N轻轻地把一朵$n戴在头上。\n");
    set("unwield_msg", "$N轻轻地把$n从头上除了下来。\n");

    set("female_only", 1);

  }
  setup();
}
