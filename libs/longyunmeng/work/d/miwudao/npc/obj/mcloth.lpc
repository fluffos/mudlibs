#pragma save_binary

// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("月光之袍", ({ "moon cloth" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 10);
    set("armor_prop/armor_vs_fire", 20);
    //set("armor_prop/armor_vs_ice",15);
    //set("armor_prop/armor_vs_magic",15);
    //set("armor_prop/armor_vs_lightning",15);
    set("value", 1000);
    set("long", "月光之袍,由面料上乘,质地极好,并且经过魔法锻炼过的不料制成.\n");
  }
  setup();
}
