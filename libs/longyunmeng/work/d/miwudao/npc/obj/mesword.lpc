#pragma save_binary
#include <weapon.h>
inherit SWORD;

void create() {
  set_name("大地之剑", ({ "mother earth sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("icon", "10035");
    set("long", "传说中的神兵利器\n");
    set("value", 1500);
    set("rigidity", 100);
    set("material", "steel");
    set("wield_msg", "$N缓缓举起$n。\n");
    set("unwield_msg", "$N将手中的$n插回背后。\n");

  }
  init_sword(80);
  setup();
}
