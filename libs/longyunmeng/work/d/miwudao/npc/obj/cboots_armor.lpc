#pragma save_binary

#include <armor.h>
inherit BOOTS;

void create()
{
        set_name("力量之靴", ({ "power boots" }) );
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("armor_prop/armor", 10);
		//set("armor_prop/armor_vs_fire",10);
		//set("armor_prop/armor_vs_ice",15);
		//set("armor_prop/armor_vs_magic",15);
		//set("armor_prop/armor_vs_lightning",15);
		set("value",2000);
		set("long","由迷雾森林的矿石为原料,防御极好\n");
        }
        setup();
}
