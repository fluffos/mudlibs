#pragma save_binary
#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("力量之剑", ({ "power sword" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("icon", "10035");
		set("long", "世上有名的力量之剑,锋利无比\n");
		set("value", 1000);
		set("rigidity",100);
            	set("material", "steel");
		set("wield_msg", "$N缓缓举起$n。\n");
		set("unwield_msg", "$N将手中的$n插回背后。\n");
		
	}
  	init_sword(70);
	setup();
}
