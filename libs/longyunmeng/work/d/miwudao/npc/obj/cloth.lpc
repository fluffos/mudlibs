#pragma save_binary

// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("魔法披风", ({ "magic cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 5);
		set("armor_prop/armor_vs_fire",15);
		//set("armor_prop/armor_vs_ice",15);
		//set("armor_prop/armor_vs_magic",15);
		//set("armor_prop/armor_vs_lightning",15);
		set("value",200);
		set("long","一件很普通的防火魔法披风,\n");
	}
	setup();
}
