#include <armor.h>
inherit SHIELD;

void create() {
  set_name("力量之盾", ({ "power shield" }));
  set_weight(1200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("icon", "10014");
    set("long", "力量之盾,防御极佳,缺点是有些笨重。\n");
    set("value", 1000);
    set("armor_prop/armor", 30);
    set("material", "leather");
  }

  setup();
}
