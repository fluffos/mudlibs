#pragma save_binary

// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("大地披风", ({ "mother earth cloth" }) );
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 5);
		set("armor_prop/armor_vs_fire",20);
		//set("armor_prop/armor_vs_ice",15);
		//set("armor_prop/armor_vs_magic",15);
		//set("armor_prop/armor_vs_lightning",15);
		set("value",1000);
		set("long","传说中的大地披风\n");
	}
	setup();
}
