inherit NPC;
void create()
{
        set_name("乞丐", ({ "a baggar"}) );
        set("gender", "男性");
        set("age", 45);
        set("long","一名乞丐,衣不蔽体,满脸风霜,\n");

        set("combat_exp", 1000);

        set("str", 15);

        setup();
        
        add_money("silver",random(10)+1);
}
 
