inherit NPC;
void create() {
  set_name("圣莫尔", ({ "st.maur" }));
  set("nickname", "大祭祀");
  set("gender", "男性");
  set("age", 30);
  set("long", "三十年前,大魔法师恩利斯以及他的伙伴们与暗黑龙王进行了一场艰苦的战斗\n"
    "最终恩利斯和他的伙伴们获得了胜利,消灭了暗黑龙王,这个世界因此重新获得\n"
    "了和平.恩利斯的最爱--凯萨琳在那次战斗中用自己的生命,施展了最后一个防\n"
    "护魔法,从而使恩利斯拥有了永远年轻的身体.\n");

  set("combat_exp", 2000000);

  set("class", "divine");
  set("occupation", "enchanter");
  set("appointed", "ultimate");  //恩利斯在战斗中会自动使用ultimate魔法对敌人进行攻击
  set_temp("magic_armor", 1);  //魔法盾
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("mana_factor", 100);

  set("mana", 5000);
  set("max_mana", 5000);

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: cast_spell, "magic_armor" :),
  }));

  set_skill("literate", 100);
  set_skill("magic", 150);
  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 200);

  map_skill("magic", "divinemagic");
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("gold", 5);
}



void init() {
  add_action("give_quest", "quest");
}
void questbonus(object ob) {
  if (random(3) < 1)
    ob->set("quest/fealty", 2);
  else ob->set("quest/fealty", 1);
}
