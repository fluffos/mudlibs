// taolord.c

inherit NPC;
void create() {
  set_name("队长", ({ "captain" }));
  set("nickname", "战士");
  set("gender", "男性性");
  set("age", 25);
  set("long", "温柔可爱的女孩,和比尔,隆一起冒险,后来认识隐藏了自身力量的恩利斯\n"
    "一起和恩利斯进行一些冒险活动\n");

  set("combat_exp", 1500000);

  //set("class", "divine");
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 90);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("gold", 1);
}
