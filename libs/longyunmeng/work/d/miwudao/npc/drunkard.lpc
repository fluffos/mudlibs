inherit NPC;
void create() {
  set_name("酒客", ({ "drunkard" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "普普通通的酒客.\n");

  set("combat_exp", 10000);

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);

  setup();

  add_money("silver", random(30) + 1);
}
