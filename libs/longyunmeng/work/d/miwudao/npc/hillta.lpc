// taolord.c

inherit NPC;
void create() {
  set_name("希尔达", ({ "fighter hillta", "hillta" }));
  set("nickname", "中级战士");
  set("gender", "男性");
  set("age", 20);
  set("long", "伟大战士迈西斯唯一的儿子,颇得有其父亲的风范,是迷雾岛年轻人中的佼佼者.\n");


  set("combat_exp", 1000000);

  set("occupation", "fighter");
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  //set_skill("xiyang-quan",100);
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  //map_skill("unarmed","xiyang-quan");
  //map_skill("parry","xiyang");
  setup();
  carry_object(__DIR__ "obj/harmor")->wear();
  carry_object(__DIR__ "obj/hhead_armor")->wear();
  carry_object(__DIR__ "obj/hboots_armor")->wear();
  carry_object(__DIR__ "obj/hmesword")->wield();

  add_money("gold", 1);
}
