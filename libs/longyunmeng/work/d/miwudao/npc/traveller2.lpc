// taolord.c

inherit NPC;
void create()
{
        set_name("东方旅行者", ({ "traveller"}) );
        set("gender", "男性");
        set("age", 25);
        set("long","来自东方的旅行者,周游列光,见多识广\n");

        set("combat_exp", 20000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",40);
      	set_skill("parry",50);
      	set_skill("dodge",50);
;

        setup();
        
}
 
