inherit F_VENDOR;
inherit NPC;
void create()
{
        set_name("侍者", ({ "waiter"}) );
        set("gender", "男性");
        set("age", 25);
        set("long","一名二十多岁的小伙子,非常热情,不停的招呼着来来往往的客人\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);
      	set_skill("divinemagic",90);

        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);

	set("vendor_goods", ([
	__DIR__"obj/drink":40,
	]));

        setup();
        
        add_money("silver",random(50)+1);
}
int init()
{
	add_action("do_vendor_list", "list");   
}