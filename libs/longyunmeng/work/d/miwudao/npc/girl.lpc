inherit NPC;
void create()
{
        set_name("小女孩", ({ "little girl"}) );
        set("gender", "女性");
        set("age", 8);
        set("long","小女孩长着一双水汪汪的大眼睛,非常可爱\n");

        set("combat_exp", 50);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);


        setup();
        
}
 
