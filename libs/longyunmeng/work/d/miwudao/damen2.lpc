inherit ROOM;
void create()
{
	set("short", "迷雾岛城门");
	set("long",
"城门高三丈，宽约二丈有余，城墙是用巨石堆砌而成。如果对方\n"
"不开门，任何人想要进去都不大可能。城门由卫兵把守。\n"
);
	set("exits",([
	"south" : __DIR__"dadao1",
	"north" : __DIR__"dajie12",
	]));

	set("objects",([
	__DIR__"npc/weibing":2,
	]));

	setup();
//replace_program(ROOM);
}
