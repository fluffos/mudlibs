void create()
{
	set("short", "当铺");
	set("long",
"迷雾岛唯一的当铺，由大富翁道格拉斯掌管。在这里你可以自由\n"
"的买卖货物。在房间的大门口放置了一块醒目的牌子(sign)。上\n"
"面写明了当铺的各种服务。\n"
);
	set("exits",([
	"south" : __DIR__"dajie9",
	"west" : __DIR__"yaodian",
	"east" : __DIR__"lvguan",
	]));

	set("objects",([
	__DIR__"npc/douglas":1,
	]));


       set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

value       估价货物。
sell        卖断货物。

TEXT
        ]) );
	
	set("rich",60000);

	setup();
