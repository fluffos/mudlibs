// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "竞技场门口");
	set("long", @LONG
上面是迷雾岛的竞技场。玩家可以在上面进行比武。

LONG
);
	set("exits",([
             "up" : __DIR__"jingjichang2",
             "down" : __DIR__"guangchang",
	]));

        set("no_fight",1);
        set_temp("light",1);
        set("gaoshou",1);
        set("no_magic",1);
        set("no_arrest",1);
        set("no_death_penalty",1);

	setup();
//replace_program(ROOM);
}


void init()
{
       add_action("do_command", "");
}

int do_command()
{
        string *limit=({
                "study","pratice","read","selflearn","research","kill",
                "exert","cast","beg","perform","du","conj",
                "follow","give","get","drop","do","to",
                "use","check","write","selflearn","research","kill",
                });
        if(member_array(query_verb(),limit)!=-1){
            if(wizardp(this_player())) return 0;
            else return 1;
//            return !wizardp(this_player());
        }
        return 0;
}
