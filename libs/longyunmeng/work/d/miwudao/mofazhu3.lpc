inherit ROOM;
void create() {
  set("short", "魔法之柱");
  set("long",
    "迷雾岛的魔法柱。不知道有何作用。这种魔法柱整个迷雾岛有4\n"
    "处，分别分布在迷雾岛神圣广场的四周。并且派人看管。\n"
  );
  set("exits", ([
    "north": __DIR__ "xiaoguangchang2",
    "east": __DIR__ "xiaoguangchang3",
  ]));

  set("objects", ([
    __DIR__ "npc/jisi2": 1,
  ]));

  setup();
  //replace_program(ROOM);
}
