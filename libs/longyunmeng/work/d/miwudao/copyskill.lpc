#pragma save_binary
#include <ansi.h>;
int main(object me, string arg)
{
        object obj;
        mapping hp_status, skill_status, map_status, prepare_status;
        string *sname, *mname, *pname;
        int i, temp;
        
        
        if(!this_player(1))	return 0;
	if ( !wizardp(me) ) return notify_fail(RED"只有巫师才能copy他人！\n"NOR);        
        
	if(!arg) return notify_fail("命令格式:cpoy <生物id>\n");
	if(!objectp(obj = present(arg, environment(me))))
        {
        	obj=find_player(arg);
        	if (!obj) obj = find_living(arg);
        	if (!obj) return notify_fail("你要copy谁？\n");
        }

/* delete and copy skills */

        if ( mapp(skill_status = me->query_skills()) ) {
                skill_status = me->query_skills();
                sname  = keys(skill_status);

                temp = sizeof(skill_status);
                for(i=0; i<temp; i++) {
                        me->delete_skill(sname[i]);
                }
        }

        if ( mapp(skill_status = obj->query_skills()) ) {

                skill_status = obj->query_skills();
                sname  = keys(skill_status);
                for(i=0; i<sizeof(skill_status); i++) {
                        me->set_skill(sname[i], skill_status[sname[i]]);
                }
        }
        
/* delete and copy skill maps */

        if ( mapp(map_status = me->query_skill_map()) ) {
                mname  = keys(map_status);

                temp = sizeof(map_status);
                for(i=0; i<temp; i++) {
                        me->map_skill(mname[i]);
                }
        }

        if ( mapp(map_status = obj->query_skill_map()) ) {
                mname  = keys(map_status);

                for(i=0; i<sizeof(map_status); i++) {
                        me->map_skill(mname[i], map_status[mname[i]]);
                }
        }
        
/* delete and copy skill prepares */

        if ( mapp(prepare_status = me->query_skill_prepare()) ) {
                pname  = keys(prepare_status);

                temp = sizeof(prepare_status);
                for(i=0; i<temp; i++) {
                        me->prepare_skill(pname[i]);
                }
        }

        if ( mapp(prepare_status = obj->query_skill_prepare()) ) {
                pname  = keys(prepare_status);

                for(i=0; i<sizeof(prepare_status); i++) {
                        me->prepare_skill(pname[i], prepare_status[pname[i]]);
                }
        }
        
        hp_status = obj->query_entire_dbase();

//                me->set("str", hp_status["str"]);
                me->set("int", hp_status["int"]);
                me->set("con", hp_status["con"]);
                me->set("cps", hp_status["cps"]);
                me->set("cor", hp_status["cor"]);
                me->set("spi", hp_status["spi"]);
                me->set("kar", hp_status["kar"]);

                me->set("max_kee",    hp_status["max_kee"]);
                me->set("eff_kee",    hp_status["eff_kee"]);
                me->set("kee",        hp_status["kee"]);
                me->set("max_sen", hp_status["max_sen"]);
                me->set("eff_sen", hp_status["eff_sen"]);
                me->set("sen",     hp_status["sen"]);
                me->set("max_gin", hp_status["max_gin"]);
                me->set("eff_gin",  hp_status["eff_gin"]);
                me->set("gin",      hp_status["gin"]);
                me->set("max_mana", hp_status["max_mana"]);
                me->set("max_atman", hp_status["max_atman"]);
                me->set("atman", hp_status["atman"]);
                me->set("mana", hp_status["mana"]);
                me->set("max_force", hp_status["max_force"]);
                me->set("force",     hp_status["force"]);
                me->set("force_factor",                            hp_status["force_factor"]);
                me->set("combat_exp",hp_status["combat_exp"]);


                me->set("bellicosity",0);
               me->reset_action(); 
 		return notify_fail("身体复制完毕\n");
        
        
        return 1;
}

