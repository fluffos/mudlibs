#include <ansi.h>
inherit ROOM;

int take_out_water(object me,object bottle);
string look_item(object me);
void create()
{
	set("short", "神圣之泉");
	set("long",
	    "岩石形成了一个圆形的水池,水池表面升起淡淡的雾气,里面的水\n"
	    "就是传说中的神圣之泉，据说泉水有不可思议的作用。\n"
	);
	set("exits",([
		"up" : __DIR__"dong1",
	    ]));
	set("item_desc",([      
		"水池": (:look_item:),
	    ]));

	set("resource/water",1);
	set("liquid/name","清水");
	set("liquid/type", "alcohol");
	set("liquid/drunk_apply",10);

	setup();
	//	replace_program(ROOM);
}

int init()
{
	if(this_player()->query("mark/susie's smile")=="killed the dragon")
		add_action("do_fill","fill");
}

int do_fill(string arg)
{
	object me,*obj,bottle;
	int i;


	me=this_player();
	obj=all_inventory(me);

	for(i=0;i<sizeof(obj);i++)
	{
		if(!obj[i]->type()||obj[i]->type()!="food"
		    ||!obj[i]->query("max_liquid")) 
			continue;
		else	break;
	}
	if(i>=sizeof(obj))
	{
		tell_object(me,"天哪,你竟然没有随身带装水的东西!!!看在上帝的份上,让系统帮你一次\n"
		    "让系统以"+YEL+"二两黄金"+NOR+"的价格立刻卖一瓶神圣之水给你,你同意吗?赶快选择\n"
		    "我同意请输入(yes/y),我不同意请输入(no/n),请选择:");
		input_to("do_help",1,me);
		return 1;
	}
	if(!arg)
	{
		tell_object(me,"你想往什么东西里面灌水?\n");
		return 1;
	}
	bottle=present(arg,me);
	if(!bottle)
	{
		tell_object(me,"没有这个东西\n");
		return 1;
	}
	if(!bottle->type()||(string)bottle->type()!="food"
	    ||!bottle->query("max_liquid"))
	{
		tell_object(me,"这个东西不能用来装水\n");
		return 1;

	}
	take_out_water(me,bottle);
	return 1;	
}
int take_out_water(object me,object bottle)
{
	if(!bottle)	bottle=new("/obj/food/jiudai");

	bottle->move(me);

	if(!me) return 0;

	bottle->set("liquid/type", "water");
	bottle->set("liquid/name", "神圣之水");
	bottle->set("liquid/remaining", bottle->query("max_liquid"));
	bottle->set("liquid/drink_func", 0);

	bottle->set("mark/susie's smile",1);//苏西喝水的时候能够做判断
	message_vision("$N用"+bottle->name()+"装满神圣之水\n",me);

	//me->set("mark/susie's smile","take out the water");
	if( me->is_fighting() ) me->start_busy(3);
	//remove_action("do_fill","fill");

}

int do_help(string arg,object me)
{
	object bottle;
	if(arg[0]=='y'||arg[0]=='Y')
	{
		if(!me->can_afford(10000))
		{
			tell_object(me,"可怜的孩子,你身上没有这么多钱,看来你只好重头来过了\n");
			me->delete("mark/susie's smile");
			remove_action("do_fill","fill");
			return 1;
		}
		else
		{
			me->pay_money(100000);
			tell_object(me,"万能的主以二两黄金的价格卖了一瓶神圣之水给你\n");
			take_out_water(me,0);
			remove_action("do_fill","fill");
			return 1;
		}
	}
	else if(arg[0]=='n'||arg[0]=='N')
	{
		tell_object(me,"可怜的孩子,你还是重头来过吧\n");
		me->delete("mark/susie's smile");
		remove_action("do_fill","fill");
		return 1;
	}
	else
	{
		tell_object(me,"让系统以"+YEL+"二两黄金"+NOR+"的价钱卖一瓶神圣之水给你,你同意么?\n"
		    "请选择:");
		input_to("do_help",me);
		return 1;
	}
}

string look_item(object me)
{
	string msg;
	msg="一个大约2平方米的小水池,里面的水就是传说中的神圣之泉.\n";	
	return msg;
}
