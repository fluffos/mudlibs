inherit ROOM;
void create()
{
	set("short", "青龙洞第一层");
	set("long",
"山洞的墙壁上有一个个较大的洞，似乎象是某种生物挖成。其中\n"
"有的洞中竟然有青色的蛋。山洞周围聚集了一些类似龙的生物，\n"
"双眼露出杀意，不怀好意的朝你移动了过来。\n"
);
	set("exits",([
	"west" : __DIR__"dong4",
	"east" : __DIR__"dong6",
	]));

	set("objects",([
	 __DIR__"npc/qinglong":5,
	]));

	setup();
//	replace_program(ROOM);
}
