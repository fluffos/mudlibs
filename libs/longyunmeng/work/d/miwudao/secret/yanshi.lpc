inherit ROOM;
void create() {
  set("short", "巨大岩石");
  set("long",
    "巨大的岩石，即使上百人站在上面也不觉得拥挤。看样子岩石已\n"
    "经有些岁月了。岩石的边缘已经风化了。\n"
  );
  set("exits", ([
    "south": __DIR__ "shangang",
    "north": __DIR__ "kuangye1",
    //"west" : __DIR__"dong6",
    "east": __DIR__ "pingdi",
  ]));
  setup();
  //	replace_program(ROOM);
}
