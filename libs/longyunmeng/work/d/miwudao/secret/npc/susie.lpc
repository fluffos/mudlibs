inherit NPC;
int give_exp(object me);
void create() {
  set_name("苏西", ({ "susie" }));
  set("gender", "女性");
  set("age", 20);
  set("long", "安吉拉的女儿苏西,以前是迷雾岛最有名的美女,\n"
    "自从被女巫诅咒之后,就一直是这个样子.\n");

  set("combat_exp", 500000);

  set("per", 5);
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);


  setup();
  carry_object("/d/miwudao/npc/obj/cloth")->wear();
  add_money("silver", random(50) + 1);
}

int accept_object(object who, object obj) {
  if (who->query("ultimate/susie's smile")) {
    who->delete("mark/susie's smile");  //将该标记最终删除
    who->delete_temp("mark/susie's smile");  //将该标记最终删除
    printf("%s说道:谢谢你上次救了我,这次你又给我什么好东西啊?\n", this_object()->name());
    return 1;
  }

  if (who->query("mark/susie's smile") && who->query("mark/susie's smile") == "killed the dragon") {  //只要玩家亲自将龙杀掉并且将神圣之水交给苏西，那么就算玩家完成任务。
    if (obj->query("mark/susie's smile") &&
      obj->query("liquid/remaining") == obj->query("max_liquid")) {
      tell_object(who, name() + "接过你给她的神圣之水一饮而尽,渐渐的," + name() + "又重新恢复了昔日的容貌\n");
      this_object()->set("per", 35);
      tell_object(who, "恭喜你完成了苏西的微笑,你得到如下奖励:\n");
      give_exp(who);
      return 1;
    }
  }
  return 0;
}

int give_exp(object me) {
  int exp, goldnum, pot;
  string msg;
  object gold;

  exp = 10000; goldnum = 10; pot = 1000;

  me->add("combat_exp", exp);
  me->add("potential", pot);
  gold = new(GOLD_OB);
  gold->set_amount(goldnum);
  gold->move(me);

  msg = "经验:" + exp + "点; 潜能:" + pot + "点 ;黄金:" + goldnum + "两\n";
  tell_object(me, msg);

  me->delete("mark/susie's smile");  //将该标记最终删除
  me->delete_temp("mark/susie's smile");  //将该标记最终删除
  me->set("ultimate/susie's smile", 1);  //该秘密只能完成一次
  me->save();
  return 1;
}
