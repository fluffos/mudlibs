#pragma save_binary

#include <ansi.h>

inherit NPC;
void owner_is_killed(object killer);
void invocation(object me);

void create() {
  set_name("格雷斯", ({ "elf grace" }));
  set("long", "火精灵格雷斯,浑身散发着灼热的火焰,三尺之外都能够感受到,\n"
    "火焰的热量.\n");
  set("nickname", "火精灵");
  set("per", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 25);

  set("kee", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_mana", 1000);
  set("mana", 1000);

  set("combat_exp", 300000);

  set_skill("parry", 10);
  set_skill("dodge", 10);

  setup();
  if (this_object()->query("id") == "elf") {
    carry_object(__DIR__ "obj/cloth")->wear();
  }
}


void invocation(object me) {
  this_object()->set_name(
    this_object()->query("name"),
    ({ me->query("id") + "'s " + this_object()->query("id") })
  );
  command("protect " + me->query("id") + "");

}


void unconcious() {
  die();
}

int die() {
  destruct(this_object());
  return 1;
}
void killed_enemy(object victim) {
  object player;
  player = query("owner");
  if (!player || !objectp(player) || !environment(player)) {
    destruct(this_object());
    return;
  }
  player = query_temp("protecting");
  if (!player || !objectp(player) || !environment(player)) {
    return;
  }
  player->set_temp("last_damage_from", player);
  return;
}
