/*Create by rongg@xbtxIII 2001/4/16
迷雾岛的谜题:名称:苏西(susie)的微笑
1.经常去花店买花,偶然一次听到花店老板安吉拉(angela)的叹息,询问对方为何叹息,
  对方将事情和盘托出.起因:花店老板有一异常美丽的女儿--苏西(susie)三年前在
  苏西的生日宴会上,居住在迷雾岛最南边的一个叫维吉尼亚(virginia)的女巫对他
  的女儿下了最恶毒的诅咒,从此苏西美丽的容貌渐渐消失,相貌变得越来越丑露,苏西
  因此再也不愿意和人交往,一直把自己关在地下室里,谁也不见,终日过着不见天日的
  生活.花店老板想尽了一切办法,都没有办法让苏西的容貌恢复原状.此事一直是花店
  老板心中的痛.玩家此处答应要帮花店老板解决此事
2.去女巫处询问苏西的情况,得知女巫因为嫉妒苏西的美丽而对她下了诅咒.经过一番
  战斗,女巫求饶,告知要破解这个诅咒,必须引用恶龙岛上面的神圣之水.必须去恶龙
  岛取得神圣之水服用,才能使苏西恢复昔日的容貌.但神圣之水由恶龙岛的恶龙把守.
  因此想要取得圣水,困难重重.
3.去港口租船.无奈船夫兰姆(lamb)所有的船都在上次的风暴中被摧毁,因此必须去森
  林当中砍伐一些树木造船.
4.砍够10棵木材交给船夫,一个月之后船夫造好了船只,玩家登船到达了恶龙岛.
5.突破恶龙岛的几个洞穴,消灭恶龙,获得神圣之水.
6.苏西引用神圣之水.终于恢复了往日的容貌.
程序标记流程
1.ask angela about 心事
标记set("mark/susie's smile","asked angela")
2.ask virginia about 苏西
标记set("mark/susie's smile","asked virginia")
3.打败virginia之后
标记set("mark/susie's smile","can go to haven")
4.在船夫兰姆处
ask lamb about 出海
标记set("mark/susie's smile","lumber")
将10棵树木交给lamb,
标记set("mark/susie's smile","go to elongdao")
5.到达恶龙岛海滩
标记set("mark/susie's smile","daoda elongdao")
6.杀死恶龙
标记set("mark/susie's smile","killed dragon")
7.取得圣水
标记set("mark/susie's smile","take out the water")
8.将圣水给苏西服用
标记set("ultimate/susie's smile",1).然后删除mark/susie's smile的标记
*/

inherit NPC;
inherit F_VENDOR;

int ask_me();
int move_dixiashi();
int move_huadian();
int set_mark();
private int step=0;
mixed query_story_message(int step);
private mixed *story = ({
    "安吉拉仔细打量了你半天,终于说:事情是这样的.是关于我的女儿苏西(susie)\n",
    "你说道:原来你还有一个女儿啊?\n",
    "安吉拉说道:是的,我确实还有一个女儿,一个非常漂亮的女儿,不过那是三年前\n"
    "          的事情了\n",
    "安吉拉说道:三年前,我为我的小女儿苏西(susie),全岛最美丽的女孩举行生日宴会\n",
    "安吉拉说道:当时我邀请到了了全岛的名流.但是却忘记了最南边的女巫维吉尼\n"
    "          亚(virginia)\n",
    "安吉拉说道:因此维吉尼亚(virginia)异常愤怒,她在苏西生日的当晚,来到我家\n",
    "安吉拉说道:当众对苏西(susie)下了可怕的诅咒.\n",
    "安吉拉说道:从此我可怜的女儿苏西(susie)渐渐失去了美丽的容貌,变得越来越丑陋\n",
    "安吉拉说道:我女儿终日以泪洗面,再也不肯见人\n",
    "安吉拉说道:一直到现在,我可怜的女儿苏西(susie)都生活在地下室...\n",
    "你说道:我想帮助你,但是我可以看一看你的女儿吗?\n",
    "安吉拉叹了口气:好吧,你随我来.\n",
    (:move_dixiashi:),
    "安吉拉说道:这就是我的女儿...\n",
    "苏西(susie)说道:你给我出去,我不想见任何人\n",
    "安吉拉说道:我们出去吧.\n",
    (:move_huadian:),
    "你说道:请你放心,我一定会找到女巫维吉尼亚(virginia),还你女儿的美貌\n",
    "安吉拉说道:维吉尼亚(virginia)居住在迷雾岛最南方,\n",
    "安吉拉说道:不但维吉尼亚本人非常厉害,同时她身边还有许多怪物保护\n",
    "安吉拉说道:你要小心啊\n",
    "你说道:我从来不惧怕任何事物...\n",
    "安吉拉说道:那好吧,我等着你的好消息,愿上帝保佑你平安\n",
    (:set_mark:),
});


void create()
{
	set_name("安吉拉", ({ "shopman angela","angela"}) );
	set("nickname","花店老板");
	set("gender", "女性");
	set("age", 35);
	set("long","安吉拉从小就喜欢花花草草,长大之后就决定开一家花店.现在看来,她实现了她的愿望\n"
	    "并且生意还不错...\n");

	set("combat_exp", 500000);

	set("str", 30);
	set("int", 30);
	set("cor", 20);
	set("cps", 30);
	set("spi", 30);

	set_skill("unarmed",60);
	set_skill("parry",80);
	set_skill("dodge",80);
	set("vendor_goods", ([
		"/d/fy/npc/obj/purple_flower":30,
		"/d/fy/npc/obj/red_flower":25,
		"/d/fy/npc/obj/yellow_flower":33,
		"/d/fy/npc/obj/blue_flower":44,
		"/d/fy/npc/obj/white_flower":14,
		"/d/fy/npc/obj/black_flower":10,
		"/d/west/miwudao/npc/obj/flower":20,
	    ]) );


	set("inquiry", ([ 
		"心事":     (:ask_me:),
		"麻烦":     (:ask_me:),
		"问题":     (:ask_me:),
		"susie":    "苏西是我的女儿",
	    	"苏西":     "苏西是我的女儿",
	    ]) );


	setup();
	carry_object("/d/miwudao/npc/obj/cloth")->wear();
	add_money("silver",random(50)+1);
}


void init()
{       
	object ob;
	ob=this_player();

	if(random(20)==1) 
	{
		remove_call_out("greeting");
		call_out("greeting",1,this_player());		
	}

	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(5) ) {
	case 0:
		message_vision("$N笑着说道：各种新鲜花朵，买些回去给你的心上人吧。\n",this_object(),ob);
		break;
	case 1:
		message_vision("$N笑咪咪地说道：这位"+RANK_D->query_respect(ob)+
		    "要买什么花儿？\n",this_object(),ob);
		break;
	case 2:
		tell_object(ob,"安吉拉叹了口气..显得心事重重,毫无察觉你的到来...\n");
		set_temp("ok_ask_me",1);//只有这个时候方可开始谜题
		break;

	}
}


int ask_me()
{
	object me;
	me=this_player();

	if(me->query("ultimate/susie's smile"))
	{
		printf("%s说道:谢谢你上次救了我的女儿\n",this_object()->name());
		return 1;
	}
	
	if(me->query("mark/susie's smile"))
	{
		tell_object(me,"你不是已经知道了这件事情么?明知故问?赶快行动吧...\n");
		return 1;
	}

	if(!query_temp("ok_ask_me")) return 0;//机会不大,大约有1/100的机会可以开始这个谜题

	if(me->query("combat_exp")<=1000000)
	{
		tell_object(me,"安吉拉仔细打量了你半天,叹了口气,对你说道:你根本帮不上什么忙, 还是不要问了.\n");
		return 1;
	}
	if(query_temp("talking"))
	{
		tell_object(me,"安吉拉正在和他人聊天,没空和你说话\n");
		return 1;
	}

	else
	{
		set_temp("talking",1);
		call_out("display_story",1,me);
		return 1;
	}
	return 0;
}
int display_story(object me)
{
	mixed line;

	if(environment(me)!=environment(this_object()))
	{
		delete_temp("talking");	
		step=0;
		return 1;
	}
	line=query_story_message(step);
	if (functionp(line)) catch(line = evaluate(line));
	else if(stringp(line))
	{
		tell_object(me,line);

	}
	if(line)
	{
		step++;
		call_out("display_story",4,me);	
		return 1;
	}
	else
	{
		step=0;
		delete_temp("talking");
		remove_call_out("display_stroy");
		return 1;
	}
}

mixed query_story_message(int step)
{
	return step < sizeof(story) ? story[step] : 0;
}

int move_dixiashi()
{
	object me;
	me=this_player();
	this_object()->move("/d/west/miwudao/secret/dixiashi");
	me->move("/d/west/miwudao/secret/dixiashi");
	return 1;
}

int move_huadian()
{
	object me;
	me=this_player();
	this_object()->move("/d/west/miwudao/huadian");
	me->move("/d/west/miwudao/huadian");
	return 1;
}
int set_mark()
{
	object me;
	me=this_player();
	if(me) me->set("mark/susie's smile","asked angela");
	this_object()->delete_temp("ok_ask_me");
	return 1;
}
