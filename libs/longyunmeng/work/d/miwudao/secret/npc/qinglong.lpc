#pragma save_binary

#include <ansi.h>

inherit NPC;
void create()
{
	set_name("青色巨龙", ({ "dragon" }) );
	set("long","一只青色的巨龙,异常凶恶.\n");
	set("race","野兽");
        set("limbs", ({ "头部", "身体", "尾巴","前爪" ,"后爪"}) );
        set("verbs", ({ "bite", "claw" }) );
   

	set("per",30);
	set("str",30);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 5000);


	setup();

        add_money("sliver",random(10));

}

