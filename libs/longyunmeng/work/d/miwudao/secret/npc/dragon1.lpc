inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("蓝龙", ({ "blue dragon" }));
  set("gender", "男性");
  set("age", 20);
  set("long", "安吉拉的女儿苏西,以前是迷雾岛最有名的美女,自从被女巫诅咒之后,就一直是这个样子.\n");

  set("combat_exp", 500000);

  set("per", 5);
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  setup();
  carry_object("/d/miwudao/npc/obj/cloth")->wear();
  add_money("sliver", random(50) + 1);
}

int die() {
  object me;
  string msg;

  me = this_object()->query_temp("last_damage_from");
  if (objectp(me) && me->query_temp("mark/susie's smile")
    && me->query_temp("mark/susie's smile") == "dao da elongdao")
    //只有做船到达恶龙岛的人才会被设置下面的标记
    if (objectp(me) && userp(me)) {
      me->set("mark/susie's smile", "killed the dragon");
      //
      msg = name() + "喊道:无耻的人类啊!为了得到我岛上的神圣之水,不惜杀害我岛上的圣灵,\n"
        "你们会得到我永远最恶毒的诅咒.随着" + name() + "的惨叫声,通往地下的通道被打开了\n";
      message_vision(msg, me);
      if (!environment(this_object())->query("exits/down"))
        environment(this_object())->add("exits", ([
          "down": "/d/west/miwudao/secret/sszq",
        ]));
    }
  ::die();
}
