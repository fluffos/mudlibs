// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "山洞");
	set("long",
"一个巨大的山洞,在恶龙岛这样不大的岛屿上面，竟然有这么大\n"
"的山洞。着实让人觉得惊奇。山洞的中央有一条类似阶梯的东西\n"
"向下延伸。\n"
);
	set("exits",([
		"down" : __DIR__"dong6",
		"up" : __DIR__"pingdi",
	    ]));
	setup();
	//	replace_program(ROOM);
}
