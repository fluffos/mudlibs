// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "恶龙岛海滩");
	set("long",
"恶龙岛海滩，金色的海滩绵延几百米，离海滩不远的地方是一片\n"
"片葱绿的树木。\n"
);
	set("exits",([
	"north" : __DIR__"haitan2",
	]));
	setup();
//	replace_program(ROOM);
}


int init()
{
	object me;
	me=this_player();
	//这个标记是玩家砍树造船,之后,船夫为玩家设置的标记.
	if((string)me->query_temp("mark/susie's smile")=="go to elongdao")
		me->set("mark/susie's smile","dao da elongdao");
	else if(me->query("mark/susie's smile")=="killed the dragon")
	{
		add_action("do_back","back");
		call_out("do_greeting",2,this_player());
		return 1;
	}
	return 1;
}

int do_greeting(object me)
{
	tell_object(me,"如果你已经得到了神圣之水，赶快赶回去吧(back)\n");
	return 1;
}

int do_back()
{
	object me;
	string msg;
	me=this_player();
	me->move(__DIR__"chuanshang");
	me->set_temp("mark/back",1);
	msg="你跳上停靠在岸边的船,开始了回途\n";
	printf("%s",msg);
	return 1;
}
