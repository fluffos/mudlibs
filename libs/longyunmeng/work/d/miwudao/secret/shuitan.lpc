// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "水谭");
	set("long",
"一个小小的水潭，水清澈见底，底下铺着白色的细沙和鹅卵石。\n"
"几只小鱼儿在悠闲的游来游去。\n"
);
	set("exits",([
	"south" : __DIR__"pingdi2",
	"north" : __DIR__"shulin2",
	"west" : __DIR__"pingdi",
//	"east" : __DIR__"dong12",
	]));
	setup();
//	replace_program(ROOM);
}
