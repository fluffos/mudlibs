inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"这里就是迷雾岛的西区。北边是魔法武器店，贩卖各种魔法武器。\n"
"南边是酒馆。可以去该处小憩一番。\n"
);
	set("exits",([
	"south" : __DIR__"jiuguan",
	"north" : __DIR__"wuqidian2",
	"west" : __DIR__"dajie6",
	"east" : __DIR__"dajie2",
	]));

	set("objects",([
	__DIR__"npc/dog":1,
	__DIR__"npc/prowlman2":1,
	]));

	setup();
//replace_program(ROOM);
}
