// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小树林");
	set("long",
"一片树林，树木长得茁壮高达。树林的边缘有被砍伐的痕迹，看\n"
"样子有人经常在这里伐木。\n"
);
	set("exits",([
	"east" : __DIR__"dadao2",
	]));
	setup();
//replace_program(ROOM);
}

int init()
{
	add_action("do_cut",({"cut","kan","砍"}));
	return 1;
}

int do_cut(string arg)
{
	object me,wood;
	me=this_player();
	if(!arg||!(arg=="wood"||arg=="木"||arg=="树")) return notify_fail("你想砍什么东西?\n");
	if(!me->query_temp("weapon")) return notify_fail("身上没有兵器如何将树砍到？难道空手不成？\n");
	wood=new("/d/west/miwudao/secret/obj/wood");
	if(!wood) return notify_fail("程序出错\n");
	if(wood->move(me))
		tell_object(me,"你砍下一棵树\n"); 

	return 1;
}