inherit ITEM; 

mapping *ansi = ({
	([ "yanse" : HIC ]),
	([ "yanse" : HIG ]),
	([ "yanse" : HIR ]),
	([ "yanse" : HIB ]),
	([ "yanse" : HIM,]),
	([ "yanse" : HIY,]),
	([ "yanse" : RED,]),
	([ "yanse" : YEL,]), 
	([ "yanse" : MAG,]),
	([ "yanse" : CYN,]),
	});

mapping *yao = ({
	([  "name"   : "当归",
		"id"     : "dang gui",
		"shoubi" : random(3),   
		"random" : random(5),
		"tui"    : random(3),
	]),
	([  "name"   : "川椒",
		"id"     : "chuan jiao",
		"shoubi" : random(3),   
		"random" : random(3),
		"tui"    : random(3), 
	]),
	([  "name"   : "赤芍",
		"id"     : "chi shao",
		"shoubi" : random(3),   
		"random" : random(4),
		"all"    : random(3),
		"tui"    : random(3), 
	]),
	([  "name"   : "泽兰",
		"id"     : "ze lan",
		"shoubi" : random(3),   
		"random" : 2,
		"all"    : random(3),
		"tui"    : random(3),
	]),
	([  "name"   : "玉竹",
		"id"     : "yu zhu",
		"shoubi" : random(3),   
		"random" : 3,
		"all"    : random(3),
		"tui"    : random(3),
	]),
	([	"name"   : "无名异",
		"id"     : "wuming yi",
		"shoubi" : random(3),   
		"random" : 6,
		"all"    : random(3),
		"tui"    : random(3),
	]),
	([  "name"   : "黄柏",
		"id"     : "huang bo",
		"shoubi" : random(3),   
		"random" : 4,
		"all"    : random(3),
		"tui"    : random(3),
	]),

	([  "name"   : "陈皮",
		"id"     : "chen pi",
		"shoubi" : random(3),
		"random" : 5,
		"all"    : random(3),
		"tui"    : random(3),
	]),
	([  "name"   : "松节",
		"id"     : "song jie",
		"shoubi" : random(3),   
		"random" : 7,
		"all"    : random(3),
		"tui"    : random(3),
		]),
	([  "name"   : "甘草",      
		"id"     : "gan cao", 
		"shoubi" : random(3),   
		"random" : 8,
		"all"    : random(3),
		"tui"    : random(3),
	]),
	([  "name"   : "贝母",
		"id"     : "bei mu",
		"shoubi" : random(3),   
		"random" : 9,
		"all"    : random(3),
		"tui"    : random(3),
	]),

});

void create()
{
	string name, id;
	int shoubi, tui, all, yaoo, yanse, all2;

    yanse = random(sizeof(ansi));
    yaoo = random(sizeof(yao));
    name = yao[yaoo]["name"];
    id = yao[yaoo]["id"]; 
    shoubi = yao[yaoo]["shoubi"]; 
    tui = yao[yaoo]["tui"];
    all = yao[yaoo]["all"];
    all2 = yao[yaoo]["random"];
    
	set_name(ansi[yanse]["yanse"]+name+NOR,({id}) );  
	set_weight(100);
	set("unit", "个");
	set("shoubi",shoubi);
	set("all",all);
	set("tui",tui);
	set("yao",1);
	set("random",all2);
	setup();
}