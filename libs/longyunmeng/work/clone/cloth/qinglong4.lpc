// zixuan pifeng.c

#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create() {
  set_name(HIG "青龙手套" NOR, ({ "qinglong shoutao", "qinglong", "shoutao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "传说中的圣灵装备之" HIG "青龙手套" HIM "。\n");
    set("material", "leather");
    set("unit", "双");
    set("armor_prop/strength", 15);
    set("value", 200000);
    set("armor_prop/armor", 100);
  }
  setup();
}
