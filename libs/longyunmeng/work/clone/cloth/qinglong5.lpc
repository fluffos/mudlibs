// zixuan pifeng.c
#include <ansi.h>
inherit EQUIP;

void create()
{
set_name(HIG"青龙护腰"NOR, ({ "qinglong huyao", "qinglong","huyao" }));
set_weight(2000);
if (clonep())
set_default_object(__FILE__);
else {
set("long", HIM"传说中的圣灵装备之"HIG"青龙护腰"HIM"。\n");
set("material", "leather");
set("armor_type", "waist");
set("unit", "条");
set("armor_prop/constitution", 15);
set("value", 200000);
set("armor_prop/armor", 100);
set("wear_msg",YEL"$N围上一条$n。\n"NOR);
set("remove_msg",YEL"$N将$n解了下来。\n");
}
setup();
}