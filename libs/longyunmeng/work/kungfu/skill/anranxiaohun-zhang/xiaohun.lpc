#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;

    if( !target ) target = offensive_target(me);

    if( !target || !target->is_character() || !me->is_fighting(target) )
   	return notify_fail("「"+HIC"黯然消魂"NOR+"」只能对战斗中的对手使用。\n");
    
    if( (int)me->query_skill("anranxiaohun-zhang", 1) < 300 )
 	  return notify_fail("你的黯然消魂掌不够熟练，不会使用「"+HIC"黯然消魂"NOR+"」。\n");

    if( (int)me->query("max_neili") < 50000 )
	   return notify_fail("你的内力修为还不够高。\n");

    if( (int)me->query("neili") < 800 )
	   return notify_fail("你的内力不够了。\n");

    if( me->query_temp("weapon"))
		return notify_fail("你先放下手中的武器再说吧？！\n");
	
	if(!me->query("couple/have_couple"))
		return notify_fail("你还没有所爱的人，无法体会深切思念一个人的感受。\n");

    msg = HIC"$N深深地思念着自己的爱妻，脸上顿现黯然之色，手掌漫不经意一划无意中使出一招，空气中透出一丝苦涩\n"GRN+
	"\n黯"+NOR"        "HIB+"然"+NOR"        "HIY+"消"+NOR"        "HIM+"魂"+NOR"        "HIC+"掌"+NOR" \n"NOR;  
	
	if(random(me->query("combat_exp")) > target->query("combat_exp")/3)
	{
	me->start_busy(3);
    target->start_busy(2+random(2));
	damage = (int)me->query_skill("anranxiaohuan-zhang", 1)*2+(int)me->query_skill("force",1)*3;
    damage = damage + random(damage);
	target->receive_damage("qi", damage);
    target->receive_wound("qi", damage/2);
    me->add("neili", -damage-500);
    
	msg += HIR"\n只听到“哇”的一声，$n喷出了一大口鲜血！像稻草一样飞了出去。\n"NOR;
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);    
	return 1;
	}
	else
    {
    me->start_busy(4);
	me->add("neili",-300);	 
    msg += HIG"$n看清掌式来路，飞身后纵，脱离了$N的掌力范围。\n"NOR;
    }
    message_vision(msg, me, target);

    if(!target->is_fighting(me)) target->fight_ob(me);
    return 1;
}


