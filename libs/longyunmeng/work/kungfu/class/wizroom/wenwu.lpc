// wenwu.c 李毅
// WENWU 2003/7/27
inherit NPC;
void create() {
  set_name("李毅", ({ "lovell" }));
  set("long", "他是幽云星宫的男主人。据说他的妻子兰不但美丽、贤惠，还是个非常能干的女孩。他常常为能有这样一个好妻子而引为自豪，也深深地爱着他的妻子！\n");
  set("gender", "男性");
  set("age", 22);
  set("attitude", "friendly");
  set("shen_type", 0);
  set("str", 35);
  set("int", 35);
  set("con", 35);
  set("dex", 35);

  set("max_qi", 3500000);
  set("max_jing", 3500000);
  set("max_jingli", 35000);
  set("max_neili", 35000);
  set("neili", 3500000);
  set("jiali", 3500);
  set("combat_exp", 350000000);
  set("score", 35000);

  set_skill("literate", 35000);
  set_skill("unarmed", 3500);
  set_skill("dodge", 3500);
  set_skill("sword", 3500);
  set_skill("parry", 3500);
  set_skill("force", 3500);
  set_skill("anranxiaohun-zhang", 3500);
  set_skill("yan-shuangfei", 3500);
  set_skill("jiuyang-shengong", 3500);
  set_skill("dugu-jiujian", 3500);
  set_skill("xuantie-jianfa", 3500);
  setup();
  carry_object("/clone/cloth/zixuan")->wear();
  carry_object("/clone/cloth/lingyun")->wear();
  carry_object("/clone/cloth/fengting")->wear();
  carry_object("/clone/weapon/longyin")->wield();
  add_money("thousand-gold", 35);
  set("inquiry", ([
    "name": "我就是李毅。",
    "幽云星宫": "一个非常美丽幽雅的地方，是我和妻子兰俩的行宫。",
    "心绪": "我们曾亲密地低语,而现在,我在此岸,你在彼岸.我的心情浮动成远去的江水,追随远去的帆影,幻作青鸟从唐人的诗卷中决然地飞出,停留在你的枝头.而我,知道是徒然.等待花开的消息,不知现在彼岸的季节可是春天?",
    "雨夜心碎": "就在这样的一个雨夜,我的心已被她牵延,不再被幻想所累,离开你学会心碎.就在这样的一个雨夜,心撕裂的声音你没听见,拂去所有的美,我们还是朋友称谓.就在这样的一个雨夜,我只好退..只好退,让梦随着雨丝飞.",
    "待你某日回眸……": "愿是船，泊在烟雨凄迷的江南，泊在你轻轻舒展的臂弯，泊在……你柔柔的眼波里，摘双眉为桨，那一定是最轻快欢乐的桨了，无论沉浮，都划一曲最优美的梦幻。如果，有一天你的眼波远去……愿搁浅，搁在眼波枯涸的海滩，任夕阳照我的影子，投于沙滩上印成无悔的誓言，然后，让每一次嘲汐，把我渗成千古绝唱，待你某日回眸时，为我绘一幅素描…………",
    "问情": "她怨他不给她明白的暗示,他怀疑她是否真爱他,她还牵挂着初恋的感情,他却已爱上另一份美丽,她想为他们写一首歌,却烦恼着心思的枯竭,她想他们是美的.他像孩子般无心伤了人,她沉醉在自我的世界中,他捉摸不定他自己的心,她却一分钟也不会安宁,他们的自由世纪,真心怎样才能碰见?她好想回过头,问你应该要怎么做.",
    "昨天那夜": "那样一个深夜,周遭静谧,夜是寂静,虫子们在窃窃私语,你惊觉这么晚了我还在,我笑看这么晚了你还留.那样一个深夜,风也细细,雨也淅淅,虫子安安静静的在私语,守着窗你沉沉地在低诉,守着窗我默默地在倾听.那样一个深夜,在听那样凄美的故事,我把轻轻的叹息留在那一个瞬间,过后你还迈你坚实的脚步,过后我还踏我轻轻的足迹,那样凄美的故事留给过去的黑夜.",
    "情浓": "漫山的枫叶红了,轻轻地,轻轻地飘落在我手心,仿佛一团熊熊的烈火,燃烧着青春,照亮了生命.你的眼睛温柔地倾诉着心中的秘密,脉脉地传递着爱的讯息,虽然矜持让你羞涩地逃避,但目光里却分明蕴藏着一丝甜蜜的笑意.美丽的红枫啊!我将它送给最爱的你,当它贴近你心房的那一刻,熊熊的烈火征服了两颗渴望爱情的心.",
    "深爱": "漫长的夜里,我在给你写信,纸笔沙沙地窃窃私语,低诉着我对你的思慕之情.亲爱的你可知道,我是多么多么地爱你,从日落到天明,从春天到冬季.我想告诉你,要让全世界都听见我的声音,那个让我梦萦魂牵的人,是你,是你,是我亲爱的澍……",
    "情缘": "你的感受纤细,纤细得象你风中轻扬的发.而我,我是一件历经千载不曾损毁的古瓷.在那江南七月的如丝风雨中,铁为你锈,铜为你绿,然后你将同样的柔情密意洒向我.洗去了千载的浮尘,让我展露出连我自己都早已忘却的真身.",
    "兰兰": "问这个干嘛？她是我的爱妻！",
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "李毅无限深情地说道：不知道兰现在在做什么，能得到兰这么好的女孩做妻子我真是太幸福了！。\n",
  }));
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
    add_action("do_sell", "sell");
  }
}
void greeting(object me) {
  if (!me || environment(me) != environment()) return;
  command("look " + me->query("id"));
  if (me->query("id") != "lisa" && me->query("id") != "love") {
    command("say 对不起，此办公室禁止闲杂人员进入！");
    message("vision", HIY + me->name() + "被李毅请出了办公室。\n" NOR,
      environment(me), ({ me }));
    me->move("/d/city/guangchang");
    message("vision", HIY + me->name() + "被人赶出了私人办公室。\n" NOR,
      environment(me), ({ me }));
  }
  if (me->query("id") == "lisa") {
    command("say 亲爱的老婆，你来了呀！");
    command("kiss lisa");
    command("ppp lisa");
  }
  return;
}
