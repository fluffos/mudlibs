// mishu.c
// WENWU 2003/7/27	

inherit NPC;
#include <ansi.h>;

int ask_npc(string str);	

void create()
{
set_name("女秘书", ({ "lisa-mishu", "mishu" }) );
set("gender", "女性");
set("age", 24);
set("no_get", 1);
set("long","这是一位貌若天仙的小姐，她是兰兰的秘书，很多的业务都是由她来帮忙打理。\n");
set("combat_exp",150000000);
set("shen_type", 1);
set("attitude", "friendly");

set("apply/attack", 50);
set("apply/defense", 50);

set("max_qi", 150000);
set("max_jing", 150000);
set("max_neili", 15000);
set("neili", 1500000);

set_skill("force", 1314);
set_skill("unarmed", 1314);
set_skill("sword",1314);
set_skill("parry",1314);
set_skill("dodge", 1314);

set("inquiry", ([
"迷茫" : "风轻云淡,何苦还要痴痴相思?夜雨中漫步,是否陶冶浪漫情操?心旷神怡,旧事已如烟云.心悠悠,难道昨日悲喜.情深心切,冰心?亦或心冰?", 	
"召唤李毅"       : (: ask_npc :),      	
]));
setup();

carry_object("/clone/cloth/zixuan")->wear();
carry_object("/clone/cloth/lingyun")->wear();
carry_object("/clone/cloth/fengting")->wear();
carry_object("/clone/weapon/longyin")->wield();
}

int ask_npc(string arg)	
{
object me;
object mishu;
object npc;
mishu=this_object();
me=this_player();
if (me->query("id")!="lisa")   	
{
command("say 对不起，你无权让我做事。");
return 1;
}
else {
if (mishu->query_temp("sign"))  
{
command("say 李毅已经在这了。");
return 1;
}
else {
message_vision(CYN "女秘书恭声说道：小姐请稍候，我这就帮你去找他过来。 \n" NOR,me);	
npc=new("/kungfu/class/wizroom/wenwu");
npc->move("/u/lisa/workroom");
mishu->set_temp("sign",1);
return 1;
}
}
}       	
