  set("short", "广场");
  set("long", @LONG
这里是酆都城中心的广场，一座高台耸立在你的西南边，往东有一
条巷子通往城中，你的北边是一间精舍，大门虚掩著，广场往你的西边
与南边延伸　
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "house",
    "south": __DIR__ "square3",
    "west": __DIR__ "square5",
  ]));

  setup();
  create_door("north", "大门", "south", DOOR_CLOSED);
