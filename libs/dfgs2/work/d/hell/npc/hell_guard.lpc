// hell_guard.c

#include <npc.h>

void create() {
  set_name("地府鬼卒", ({ "hell guard", "guard" }));
  set_race("human");
  set_class("fighter");
  set_attr("str", 21);
  set_attr("con", 18);
  set_attr("dex", 18);
  set_level(20);
  set_skill("pike", 60);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("unarmed", 60);
  set("long",
    "一个青面獠牙的鬼卒，双眼大如铜铃，身上穿著有如阳间官兵的衣服　\n");
  setup();
  carry_object(__DIR__ "obj/ironfork")->wield();
  carry_object(__DIR__ "obj/irontorso")->wear();
}
