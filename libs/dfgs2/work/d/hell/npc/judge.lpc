// judge.c

#include <npc.h>

void create() {
  set_name("曹士仑", ({ "tsao hsilen", "tsao", "hsilen" }));
  set("title", "冥府判官");
  set_race("woochan");
  set_class("taoist");
  set_attr("str", 15);
  set_attr("con", 17);
  set_attr("dex", 23);
  set_attr("wis", 25);
  set_level(32);
  set_skill("parry", 65);
  set_skill("dodge", 65);
  set_skill("unarmed", 80);
  set_skill("taoism-fire", 95);
  set_skill("spells", 80);
  map_skill("spells", "taoism-fire");
  set_skill("staff", 75);
  set("age", 32);
  set("long",
    "一个面貌俊秀的年轻人，身上穿著判官的服色，他大概就是传说中\n"
    "勾批生死簿的冥府判官之一吧，说不定你该好好的巴结一下　\n");
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: cast_spell, "earth_fire" :),
    (: cast_spell, "pure_fire" :),
  }));
  setup();
  carry_object(__DIR__ "obj/judge_robe")->wear();
  carry_object(__DIR__ "obj/rune_staff")->wield();
}
