// rune_staff.c

#include <weapon.h>

inherit F_STAFF;

void create() {
  set_name("禁符之杖", ({ "rune staff", "staff" }));
  set_weight(6000);
  setup_staff(2, 9, 50, 5);

  if (!clonep()) {
    set("wield_as", ({ "staff" }));
    set("unit", "把");
    set("value", 32000);
    set("rigidity", 33);
    set("long",
      "这是一种帮助法师施法的法器，杖端是一个圆形的锁片，刻著禁符咒\n"
      "──一种避免法力散失的符咒　\n");
    set("apply_weapon/staff", ([
      "spells": 10,
      "spi": 1,
    ]));
  }
  setup();
}
