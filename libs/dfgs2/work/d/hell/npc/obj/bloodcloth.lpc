// bloodcloth.c

#include <armor.h>

inherit F_CLOTH;

void create() {
  set_name("征衣「血染」", ({ "bloodcloth", "cloth" }));
  set_weight(6000);
  setup_cloth();

  if (!clonep()) {
    set("unit", "件");
    set("value", 100000);
    set("long",
      "一件和阳间将官所穿的征衣类似的战袍，虽然洗得相当乾净，但是\n"
      "闻起来确有一股血腥气　\n");
    set("wear_as", "cloth");
    set("apply_armor/cloth", ([
      "armor": 4,
      "attack": 7,
      "str": 3,
      "wis": -2
    ]));
  }

  setup();
}
