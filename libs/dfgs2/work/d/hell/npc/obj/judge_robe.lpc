// judge_robe.c

#include <armor.h>

inherit F_CLOTH;

void create() {
  set_name("阴判官袍", ({ "judge robe", "robe" }));
  set_weight(3000);
  setup_cloth();

  if (!clonep()) {
    set("unit", "件");
    set("value", 30000);
    set("long",
      "这是一件阴间判官所穿的公服　素黑的布面上没有任何花样，相当\n"
      "朴素　\n");
    set("wear_as", "cloth");
    set("apply_armor/cloth", ([
      "armor": 3,
      "wis": 1,
    ]));
  }

  setup();
}
