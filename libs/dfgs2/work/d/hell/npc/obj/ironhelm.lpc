// irontorso.c

#include <armor.h>

inherit F_HEAD_EQ;

void create() {
  set_name("镔铁头盔", ({ "iron helm", "helm" }));
  set_weight(15000);
  setup_head_eq();

  if (!clonep()) {
    set("unit", "顶");
    set("value", 90000);
    set("long", "一顶黑黝黝的铁头盔，拿在手中就已经相当沈重了　\n");
    set("wear_as", "head_eq");
    set("apply_armor/head_eq", ([
      "armor": 4,
      "armor_vs_fire": 3,
      "dodge": -5,
    ]));
  }

  setup();
}
