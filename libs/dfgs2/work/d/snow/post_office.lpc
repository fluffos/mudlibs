// Room: /d/snow/post_office.c

inherit ROOM;

void create() {
  set("short", "雪亭驿");
  set("long", @LONG
这里是雪亭镇的驿站，虽然驿站主要是替官府递送文书，不过如果你愿意
付一点钱(pay postage)的话，也可以请驿站的人帮你送信收信　
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "nstreet2",
  ]));
  set("post_office", 1);  // mailbox checks this flag.

  setup();
}

void init() {
  add_action("do_pay", "pay");
}

int do_pay(string arg) {
  object mbox;

  if (arg != "postage") return 0;

  if (this_player()->query_temp("mbox_ob"))
    return notify_fail("你已经付过钱了　\n");
  if (this_player()->can_afford(50) != 1)
    return notify_fail("驿站对庶民的统一收费是五十文钱！\n");
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  write("驿站的官员将一个写著你名字的信札递了给你　\n");
  return 1;
}
