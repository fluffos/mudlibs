// strongman.c

#include <npc.h>

inherit F_VILLAGER;

void create() {
  set_name("路人", ({ "man" }));
  set_race("human");
  set_level(2);

  set("long", "一个普通的路人，像这样的人一天可以在路上碰见几十个　\n");
  setup();
  carry_money("coin", 30);
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/shortsword")->wield();
}
