#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("王怀芝", ({ "wang whaiz", "wang", "whaiz" }) );
	set_race("human");
	set_level(5);
	set_stat_maximum("sen", 50);

	set_skill("literate", 60);
	set("long",
		"王怀芝是镇上王员外的独子，前几年上京考试落第，碰巧王太夫人过世\n"
		"，因此留在家乡服丧，闲暇无事，便开了间私塾教镇上孩子读书　\n");
	setup();
}

int accept_fight()
{
	do_chat("王怀芝说道：这 ...武功\我可是半点不会，这位朋友不如去找我们家王教头切磋切磋？\n");
	return 0;
}

