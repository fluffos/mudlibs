// garrison.c

#include <npc.h>

inherit F_SOLDIER;

void create() {
  set_name("官兵", ({ "garrison" }));
  set_attr("con", 19);
  set_attr("str", 20);
  set_race("human");
  set_class("fighter");
  set_level(17);

  set_skill("twohanded sword", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("blade", 50);

  set("long",
    "一位负责维护地方治安的官兵，他们受过相当的训练，有时候\n"
    "也加入军队作战　\n");
  set("vendetta_mark", "authority");
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/broadsword")->wield();
}

void init() {
  ::init();
  add_action("intercept", "go");
}

int intercept(string arg) {
  if ((arg != "north") || !this_player()->visible(this_object())) return 0;

  write(name() + "将你拦了下来　\n");
  do_chat((: command, "say 野羊山最近有盗匪出没，你们走别条路吧　" :));
  return 1;
}

int accept_fight(object ob) {
  do_chat((: command, "emote 瞪了瞪眼，说道：滚开滚开！少在这里罗唆！" :));
  return 0;
}
