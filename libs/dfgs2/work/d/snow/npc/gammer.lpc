// gammer.c

#include <npc.h>

inherit F_VILLAGER;

void create() {
  set_name("瞎眼老太婆", ({ "blind gammer", "gammer" }));
  set_attr("dex", 23);
  set_attr("con", 21);
  set_attr("cor", 22);
  set_race("human");
  set_class("thief");
  set_level(44);

  set_skill("staff", 40);
  set_skill("stealing", 70);
  set_skill("dodge", 90);
  set_skill("blade", 30);
  set_skill("sword", 30);
  set_skill("unarmed", 50);
  set_skill("dagger", 70);
  set_skill("secondhand dagger", 70);

  set("gender", "female");
  set("age", 66);
  set("long",
    "一个瞎了眼睛的老太婆，满脸皱纹，但是却给人一种亲切的感觉　\n");
  set("chat_chance", 8);
  set("chat_msg", ({
    "瞎眼老太婆喃喃地说道：阿宝？是你吗？\n",
    "瞎眼老太婆侧著耳朵似乎在倾听什麽　\n",
    (: random_move :)
  }));
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "瞎眼老太婆叫道：阿宝！有恶人在欺负婆婆哪！快出来啊！\n",
    (: random_move :),
  }));
  set_stat_notify("kee", 40);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/cane")->wield();
  carry_object(__DIR__ "obj/syndicator")->wield("secondhand dagger");
}

void relay_say(object ob, string arg) {
  if (arg == "祖奶奶" && ob->query_temp("thief_qualified")) {
    command("giggle");
    command("pat " + ob->query("id"));
    if ((string)ob->query_class() != "commoner") return;
    ob->set_class("thief");
    tell_object(ob, "你正式成为一名盗贼了　\n");
    return;
  }

  if (strsrch(arg, "阿宝") >= 0)
    do_chat((: command, "say 阿宝？你说阿宝在哪里？" :));
  else switch (random(10)) {
    case 0: do_chat((: command, "shake" :));
    case 1: do_chat((: command, "?" :));
    case 2: do_chat((: command, "steal coin from " + ob->query("id") :));
  }
}

int accept_fight() {
  do_chat((: command, "?" :));
  return notify_fail("瞎眼老太婆对你视若无睹 ...　\n");
}

void init() {
  // Dont call original init() to check autofight.
}

private void ask_join(object player) {
  if (!player || environment(player) != environment()) return;

  if (player->query_class() != "commoner")
    command("say 唉 ... 人老了，连随身的梳子都常常丢掉　\n");
  else {
    command("whisper " + player->query("id") +
      " 好家伙，竟然给你偷去了？想成为小偷是不是？叫我一声「祖奶奶」 ...");
    player->set_temp("thief_qualified", 1);
  }
}

int accept_object(object player, object ob) {
  if (!ob->id("annatto comb")) return 0;

  command("say 咦？这 ... 这是 ... 我的梳子！");
  do_chat((: ask_join, player :));
  return 1;
}
