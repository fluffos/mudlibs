// cloth.c

#include <armor.h>

inherit F_CLOTH;

void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(2000);
  setup_cloth();

  if (!clonep()) {
    set("unit", "件");
    set("value", 600);
    set("long", "一件粗布缝制的布衣，看起来像是乡下人的衣服　\n");
    set("wear_as", "cloth");
    set("apply_armor/cloth", ([
      "armor": 1,
    ]));
  }

  setup();
}
