// hairpin.c

#include <armor.h>

inherit F_HEAD_EQ;

void create() {
  set_name("古铜发簪", ({ "bronze hairpin", "hairpin" }));
  set_weight(400);
  setup_head_eq();
  if (!clonep()) {
    set("unit", "支");
    set("value", 100);
    set("long", "一支生满铜绿，老旧不堪的发簪　\n");
    set("wear_as", "head_eq");
  }
  setup();
}
