// ssilversword.c

#include <weapon.h>

inherit F_SWORD;

void create() {
  set_name("洗银剑", ({ "silver sword", "sword" }));
  set_weight(3000);
  setup_sword(2, 15, 40, 4);

  if (!clonep()) {
    set("wield_as", ({ "sword" }));
    set("unit", "把");
    set("value", 19000);
    set("rigidity", 40);
    set("long", "一把银制的短剑，铸造得十分精美　\n");
    set("wield_msg", "$N抽出一把闪闪发亮的短剑当作武器　\n");
  }
  setup();
}
