// longsword.c

#include <weapon.h>

inherit F_SWORD;

void create() {
  set_name("长剑", ({ "longsword", "sword" }));
  set_weight(5000);
  setup_sword(1, 20, 50, 0);

  if (!clonep()) {
    set("wield_as", "sword");
    set("unit", "把");
    set("value", 4000);
    set("rigidity", 25);
    set("long", "一把精钢铸成的长剑，是武林中人常用的武器　\n");
    set("wield_msg", "$N「唰」地一声抽出一把长剑握在手中　\n");
  }
  setup();
}
