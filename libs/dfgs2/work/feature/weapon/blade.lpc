// sword.c

#include <combat.h>
#include <dbase.h>

void setup_blade(int x, int y, int z, int r) {
  class damage_parameter dp;

  dp = new(class damage_parameter);
  dp->multipler = x;
  dp->range = y;
  dp->bonus = z;
  dp->roll = r;

  set("damage/blade", dp);
  set("damage/secondhand blade", dp);
  set("damage/twohanded blade", dp);
}
