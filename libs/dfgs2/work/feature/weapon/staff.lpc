// sword.c

#include <combat.h>
#include <dbase.h>

class damage_parameter dp;

void setup_staff(int x, int y, int z, int r) {
  dp = new(class damage_parameter);
  dp->multipler = x;
  dp->range = y;
  dp->bonus = z;
  dp->roll = r;

  set("damage/staff", dp);
  set("damage/twohanded staff", dp);
}
