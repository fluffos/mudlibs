// boar_berry.c

inherit COMBINED_ITEM;

void create() {
  set_name("山猪果", ({ "boar berry", "berry" }));
  if (!clonep()) {
    set("unit", "些");
    set("long",
      "山猪果是一种生长在深山中，尤其是野猪的巢穴附近的一种暗红色\n"
      "野莓，有些山猪果是有毒的，有些则是无毒的，无毒的山猪果可以\n"
      "用来当解毒剂的药材，直接服用则可以提神，不过先警告你，味道\n"
      "不....太好　\n");
    set("base_unit", "颗");
    set("base_value", 120);
    set("base_weight", 70);
  }
  set_amount(1);
  setup();
}

int stuff_ob(object me) {
  if (me->query_stat_maximum("food") - me->query_stat("food") < 20)
    return notify_fail("你的肚子已经撑得什麽东西也吞不下去了　\n");
  message_vision("$N吃下一颗发著恶臭的山猪果 ... 天啊，$P竟然吞得下去 .... 　\n", me);
  me->supplement_stat("food", 20);
  me->consume_stat("water", 20);
  me->supplement_stat("sen", 25);
  add_amount(-1);

  return 1;
}
