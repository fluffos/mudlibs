// clone.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string file) {
  int amount;
  object obj;
  string err, msg;

  seteuid(geteuid(this_player(1)));

  if (!file) file = me->query("cwf");

  if (!file)
    return notify_fail("你要复制什麽物件？\n");

  if (sscanf(file, "%d %s", amount, file) == 2
    && amount < 1)
    return notify_fail("复合物品的数量至少必须是 1　\n");

  file = resolve_path(me->query("cwd"), file);
  if (sscanf(file, "%*s.lpc") != 1) file += ".lpc";

  if (file_size(file) < 0)
    return notify_fail("没有这个档案(" + file + ")　\n");

  if (!amount) me->set("cwf", file);
  else me->set("cwf", amount + " " + file);

  if (!find_object(file)) {
    err = catch(call_other(file, "???"));
    if (err) {
      write("载入失败：" + err + "\n");
      return 1;
    }
  }

  err = catch(obj = new(file));
  if (err) {
    write("复制失败：" + err + "\n");
    return 1;
  }


  if (amount) {
    if (function_exists("set_amount", obj))
      obj->set_amount(amount);
    else if (function_exists("set_volume", obj))
      obj->set_volume(amount);
    else
      write("( " + obj->name() + "不是复合物件　 )\n");
  }

  if (!stringp(msg = me->query("env/msg_clone")))
    msg = "只见$N伸手凌空一指，变出了$n　\n";

  notify_fail("无法复制不能移动的物件(" + file + ")　\n");

  if (!obj->query("no_get")
    && !obj->is_character()
    && !living(obj)
    && obj->move(me)) {
    write(obj->query("name") + "复制成功\，放在你的物品栏　\n");
    message_vision(msg + "\n", me, obj);
    return 1;
  }
  if (obj->move(environment(me))) {
    write(obj->query("name") + "复制成功\，放在这个房间　\n");
    message_vision(msg + "\n", me, obj);
    return 1;
  }


  if (function_exists("set_volume", obj)) {
    object bottle = new("/obj/bottle");
    if (obj->move(bottle)) {
      write(obj->query("name") + "复制成功\，放个一个玻璃瓶中　\n");
      bottle->move(me);
      message_vision(msg + "\n", me, obj);
      return 1;
    }
    destruct(bottle);
  }

  destruct(obj);
  return 0;
}

int help(object me) {
  write(@HELP
指令格式 : clone <档名>

利用此指令可复制任何能移动之物件(含怪物)　
HELP
  );
  return 1;
}
