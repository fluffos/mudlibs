// socket_status() is compile-undefined without PACKAGE_SOCKETS (WASM).
// Diagnostic admin tool only -- stub the header when the package is absent
// (same treatment as libs/lpuni's identical file).
string dump_socket_status() {
#ifndef __PACKAGE_SOCKETS__
  return
    "Fd    State      Mode       Local Address          Remote Address            PROGRAM\n"
    "--  ---------  --------  ---------------------  --------------------- ---------------------\n";
#else
  string ret = "Fd    State      Mode       Local Address          Remote Address            PROGRAM\n"
    "--  ---------  --------  ---------------------  --------------------- ---------------------\n";

  foreach (mixed *item in socket_status()) {
    if (item[0] < 0 && item[1] == "CLOSED") continue;
    ret += sprintf(
      "%2d  %|9s  %|8s  %-21s  %-21s %-21O\n",
      item[0],
      item[1],
      item[2],
      item[3],
      item[4],
      objectp(item[5]) ? item[5] : 0
    );
  }

  return ret;
#endif
}
