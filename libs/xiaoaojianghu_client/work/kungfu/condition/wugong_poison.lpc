#include <ansi.h>

int update_condition(object me, int duration) {
  if (me->query_temp("nopoison")) return 0;
  if (duration < 1) return 0;
  me->receive_wound("qi", 15 + random(30));
  me->receive_damage("jing", 15 + random(15));
  me->apply_condition("wugong_poison", duration - 1);
  //       if(environment(me)==find_object("/d/city/wumiao") 
  //         ||environment(me)==find_object("/d/city/wujiaochang"))
  //	me->apply_condition("wugong_poison", duration);
  tell_object(me, HIG "你中的蜈蚣毒发作了！\n" NOR);
  return 1;
}
