// xiaolinger.c 送礼使者
inherit NPC;
string ask_shen();
string ask_du();
int ask_mask(string str);

void create()
{
    set_name(HIC"小玲儿"NOR, ({ "xiao linger", "xiao","linger"}));      	
    set("title", HIM"小天使"NOR);     	
    set("nickname", HIM"紫衣神女"NOR);      	
    set("str", 37);
    set("gender", "女性");
    set("age", 14);
    set("per",30);
    set("combat_exp", 15000000);   	
    set("max_qi", 3000000);   	
    set("max_jing", 3000000);   	
    set("neili", 15000000);   	
    set("jiali", 50000);   	
    set("no_get", 1);	
    set("attitude", "friendly");
    set("inquiry", ([
"礼物"  : "礼物放在茶几上，自己拿吧，不要多拿哦！\n",
"面具"  :(: ask_mask :),
"清毒"  :(: ask_du :),
"清神"  : (: ask_shen :),
"你是谁":"我呀！我是专门给大家发送节日礼物小玲儿呀！\n"
	]));
    
    setup();
carry_object("/clone/cloth/female1-cloth")->wear();	
}

//送面具
int ask_mask(string arg)	
{
object me,obj;	
object zi;	
me = this_player();	
zi=this_object();	
if(present("mask", me) || present("mask", environment()))   	
{
command("say 已经有了还想拿,你怎么如此贪得无厌呢?"); 	
return 1;       	
}
if (me->query("age",1) >=18)
{
command("say 老大不小的了,还只会饭来张口,衣来伸手,该学学独立生活了!");	
return 1;	
}
else {  	
message_vision(CYN "小玲儿微笑着拿出个面具，送了给$N \n" NOR,me);	
obj=new("/clone/misc/mask");      	
obj->move(me);	
command("love");  	
return 1;	
}
}
//清神
string ask_shen()
 {
        object me = this_player();
if (me->query("age",1) >=18)
{
return "老大不小的了,还只会饭来张口,衣来伸手,该学学独立生活了!";	
}else{
               me->set("shen", 0);
   me->start_busy(3);
                return "天神啊！让这个心灵受伤害的人重生吧！\n"
HIW"突然天空中一道"HIY"金光"HIW"笼罩四方，转瞬即逝！"NOR;
}
}
//清毒
string ask_du()
 {
        object me = this_player();
if (me->query("age",1) >=18)
{
return "老大不小的了,还只会饭来张口,衣来伸手,该学学独立生活了!";	
}else{

               me->clear_condition();
   me->start_busy(3);
                return "天神啊！就让这弱小的生灵重生吧！\n"
HIW"突然天空中一道"HIY"金光"HIW"笼罩四方，转瞬即逝！"NOR;
}
}