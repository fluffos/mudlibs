inherit ROOM;
void create()
{
//房间名称叙述
    set("short", "擂台");
    set("long", @LONG
加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 
LONG
    );
//房间属性   
    set("no_new_clean_up", 0);
    set("fight_room", __DIR__"fightroom2");
    set("no_sleep_room",1);
//房间出口    
    set("exits", ([ 
        "down" : __DIR__"fightroom2",
    ]));

    setup();
}

void relay_message(string msg)
{
    object look_fight_room;
    string *msgs;
    int i;
    if (!look_fight_room=find_object("/d/city/fightroom2"))
    look_fight_room=load_object("/d/city/fightroom2");
    msgs=explode(msg, "\n");
    for (i=0;i<sizeof(msgs);i++)
    if (strlen(msgs[i])>5)
    message("vision",NOR+"@@ -->"+msgs[i]+"\n",look_fight_room);
}
int valid_leave(object me, string dir)
{
   if (me->is_fighting() && dir=="down")
	return notify_fail("临阵脱逃，非大丈夫所为呀！\n");
    return ::valid_leave(me, dir);
}
