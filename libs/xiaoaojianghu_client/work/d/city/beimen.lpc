inherit ROOM;
string look_gaoshi();
void create()
{
//房间名称叙述
	set("short", "北门");
	set("long", @LONG
这是北城门，因为曾经失火，到现在城墙还是黑乎乎的，因此白
纸黑字的官府告示(gaoshi)就显得特别现眼。北方是一片崇山峻岭，一条
黄土小径在山里蜿蜒而上。
LONG
	);
//房间属性	
	set("outdoors", "city");
//房间物品人物	
    set("objects", ([
        "/kungfu/class/yunlong/ma" : 1,
        __DIR__"npc/wujiang" : 1,
        __DIR__"npc/bing" : 2,
    ]));
//房间出口    
	set("exits", ([
		"south" : __DIR__"beidajie2",
        "west" : __DIR__"postoffice",
//暂时取消		"north" : "/d/village/hsroad1",
          "east" : __DIR__"paimai",
	]));

	set("item_desc", ([
		"gaoshi" : (:look_gaoshi:),
	]));
	setup();
}
string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n扬州知府\n程药发\n";
}
