inherit ROOM;
void create()
{
//房间名称叙述
	set("short", "正厅");
	set("long", @LONG
这里是福威镖局的正厅，几只太师椅一字排开，正中央坐着总镖头，手持
烟袋杆正在闭目沉思。墙上挂着几幅字画和一把宝剑。
LONG);
//房间属性
    set("no_fight", 1);	
//房间出口
	set("exits", ([
		"north" : __DIR__"biaoju",
	]));
//房间物品人物
	set("objects", ([
		__DIR__"npc/linzhennan" : 1,
	]));
	setup();
}

void reset()
{
    foreach (object ob in all_inventory(this_object()) ){
       if (userp(ob)) return ;
    }
    ::reset();
}
