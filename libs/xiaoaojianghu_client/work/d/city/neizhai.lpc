inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "内宅");
  set("long", @LONG
这里是衙门的内宅，住着知府的家眷。外人到此就该止步了。
LONG);
  //房间出口
  set("exits", ([
    "south": __DIR__ "ymzhengting",
