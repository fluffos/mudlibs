inherit ROOM;
void create()
{
//房间名称叙述
	set("short", "钱庄");
	set("long", @LONG
这是一家老字号的钱庄，已有几百年的历史，在全国各地都有分店。它发
行的银票信誉非常好，通行全国。帐台上有一个牌子(paizi)。
LONG);
//房间属性
    set("no_fight",1);
    set("item_desc", ([
        "paizi": @TEXT
这里是钱庄，目前我们提供的服务有：
convert(huan)     兑换钱币。
deposit(cun)      存钱。
withdraw(qu)      取钱。
check(cha)        查询存款。
每次取钱必需缴纳百分之一的手续费，敝庄会从你的存款中扣取。
TEXT
    ]) );
//房间出口	
	set("exits", ([
		"east" : __DIR__"beidajie1",
	]));
//房间物品人物    
	set("objects", ([
        __DIR__"npc/qian" : 1,
 	]));
	setup();
	replace_program(ROOM);
}
