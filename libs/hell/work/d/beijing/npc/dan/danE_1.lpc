#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
	set_name(HIM "幻灵丹" NOR, ({ "huanling dan", "dan" })); 
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("base_unit", "粒");
                set("base_value", 50);
                set("only_do_effect", 1);
        }
        setup();
        set_amount(1);
}

int do_effect(object me)
{

        if (time() - me->query_temp("last_eat/dan(E)") < 10)
        {
                write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
                return 1;
        }

        me->set_temp("last_eat/dan(E)", time());

        message_vision(HIC "$N吃下一粒" + query("name") + HIC "，只觉得灵台一片空明，纯净无比。\n" NOR, me);
        me->add("magic_points", 50 + random(50));

        me->start_busy(2);

        add_amount(-1);
        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}
int query_autoload() { return 1; }