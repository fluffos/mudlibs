// hua1.c
#include <ansi.h>;
#include <armor.h>;
inherit HEAD;

void create()
{
	set_name(HIW"白合花"NOR, ({"flower", "hua"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "朵");
                set("long", "这是一朵美丽的小野花，香气清新。\n");
                set("value", 0);
                set("only_do_effect", 1);
                set("material", "plant");
                set_weight(10);
                set("armor_prop/armor", 0);
                set("armor_prop/personality", 3);
                set("wear_msg", "$N轻轻地把一朵$n戴在头上。\n");
                set("unequip_msg", "$N轻轻地把$n从头上摘了下来。\n");
        }
        setup();
}
int do_effect(object me)
{
        if (me->query("gift/xiandan") < 5 )
        {
                me->add("gift/xiandan", 1);
                me->add("int", 1);
        }

        if (me->query("gift/unknowdan") < 5 )
        {
                me->add("gift/unknowdan", 1);
                me->add("dex", 1);
        }

        if (me->query("gift/xisuidan") < 5 )
        {
                me->add("gift/xisuidan", 1);
                me->add("con", 1);
        }

        if (me->query("gift/shenliwan") < 5 )
        {
                me->add("gift/shenliwan", 1);
                me->add("str", 1);
        }
       destruct(this_object());
	return 1;
}
