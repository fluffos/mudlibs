// team command: emote

#include <ansi.h>

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        object *t;
	string  verb, emote_arg;

        if (! arg)
		return notify_fail("你要做什么？\n");

	if (! pointerp(t = me->query_team()))
		return notify_fail("你现在并没有和别人组成队伍。\n");

        if (me->ban_say(1))
                return 0;

	if (sscanf(arg, "%s %s", verb, emote_arg) != 2)
	{
		verb = arg;
		emote_arg = 0;
	}

        arg = EMOTE_D->do_emote(me, verb, emote_arg, 1,
                                0, HIW);
	if (! arg)
		return 0;
 
	message("team", HIW "【同伙密谈】" +
                arg + NOR, t);
	return 1;
}
