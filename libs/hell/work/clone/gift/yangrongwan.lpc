// yangrongwan.c 人参养荣丸

#include <ansi.h>

inherit ITEM;

void setup() {}

void create() {
  set("auto_save", 1);
  set_name(MAG "人参养荣丸" NOR, ({ "renshen wan", "renshen", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", MAG "由汤沛持有，有助提神养生。\n");
    set("value", 5000000);
    set("only_do_effect", 1);
  }
  set_amount(1);
  setup();
}

int do_effect(object me) {
  string force;

  message_vision(MAG "$N吃下一颗人参养荣丸,眼睛直冒紫光！\n", me);
  if (me->improve_jingli(200 + random(200)))
    me->set("jingli", me->query("max_jingli"));
  destruct(this_object());
  return 1;
}
int query_autoload() { return 1; }
