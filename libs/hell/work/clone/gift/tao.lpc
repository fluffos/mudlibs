// tao.c 蟠桃

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIC "蟠桃" NOR, ({ "pan tao", "tao", "pantao" }) );
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", HIG "一个刚摘下的蟠桃，看起来非常好吃。\n" NOR);
                set("value", 0);
		  set("no_sell","这个东西放不久，不敢要！");
		set("unit", "个");
		set("only_do_effect", 1);
	}
}

int do_effect(object me)
{
        message_vision("$N拿出一个" + this_object()->name() +
                       "，两口就吃了个精光。\n", me);
	 me->add("food",100000);
	 me->add("water",100000);
	 tell_object(me,HIM "你觉得自己发生了不可思议的变化，顿时饥饿感顿消！\n" NOR);
        CHANNEL_D->do_channel(this_object(), "rumor",
                              sprintf("听说%s(%s)偷吃了" + this_object()->name() + HIM "，再也不觉得饥饿了。",
			      me->name(1), me->query("id")));
        destruct(this_object());
	return 1;
}
int query_autoload() { return 1; }