// xueshen.c

#include <ansi.h>
#include "medicine.h"

void create()
{
        set_name(HIC "雪参丹" NOR, ({"xueshen dan", "dan"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一颗晶莹剔透的雪参丹，由神龙教陆高轩所创制，用以调顺内息。\n");
                set("base_unit", "颗");
                set("base_value", 80000);
                set("no_sell", 1);
                set("base_weight", 70);
                set("only_do_effect", 1);
                set("mixture", ([
                        "herb" : ([ "tianqi"   : 1,
                                    "honghua"  : 1,
                                    "moyao"    : 1,
                                    "xiongdan" : 1,
                                    "heshouwu" : 2,
                                    "renshen"  : 2,
                                    "zzfen"    : 1,
                                    "xuelian"  : 1,
                                    "xuejie"   : 1,
                                    "renshen"  : 1 ]),
                        "neili" : 400,
                        "jing"  : 60,
                        "time"  : 8,
                        "min_level" : 150,
                        "shenlong-mixin" : 250,
                ]));
        }
        setup();
}

int do_effect(object me)
{
        mapping my;

        if (time() - me->query_temp("last_eat/xueshen") < 180)
        {
                write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
                return 1;
        }

         me->set_temp("last_eat/xueshen", time());

        message_vision(HIC "$N" HIC "吞下雪参丹，脸色泛一阵青冥。\n" NOR, me);
        tell_object(me, HIY "你只觉得真气充沛，几乎就要澎湃而出。\n" NOR);

        log_file("nosave/using", sprintf("%s(%s) eat 雪参丹 at %s.\n",
                 me->name(1), me->query("id"), ctime(time())));

        my = me->query_entire_dbase();
        my["neili"] = my["max_neili"] * 2;

	me->start_busy(3);

        add_amount(-1);
        if (query_amount() < 1)
                destruct(this_object());

	return 1;
}
