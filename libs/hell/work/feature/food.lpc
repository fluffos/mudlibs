// food.c

#include <dbase.h>
#include <name.h>

mixed func = 0;

void apply_effect(function f) {
  if (!func)
    func = f;
  else if (functionp(func))
    func = ({ func, f });
  else if (sizeof(func) < 12)
    func += ({ f });
}

void clear_effect() {
  func = 0;
}

mixed query_effect() {
  return func;
}

// drink/eat 对 only_do_effect 的物品用返回值做命令结果，和重载它的物品同型
varargs int do_effect(object me) {
  int i;

  if (functionp(func))
    evaluate(func);
  if (arrayp(func))
    for (i = 0; i < sizeof(func); i++)
      evaluate(func[i]);
  return 1;
}
