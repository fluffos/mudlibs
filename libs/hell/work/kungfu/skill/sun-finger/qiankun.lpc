// qiankun.c 一阳指 「一指乾坤」

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

string *xue_name = ({
  "劳宫穴", "膻中穴", "曲池穴", "关元穴", "曲骨穴", "中极穴",
  "承浆穴", "天突穴", "百会穴", "幽门穴", "章门穴", "大横穴",
  "紫宫穴", "冷渊穴", "天井穴", "极泉穴", "清灵穴", "至阳穴", });

int perform(object me, object target) {
  string msg;
  int i, cp;
  int damage;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("「一指乾坤」只能在战斗中使用。\n");

  if ((int)me->query_skill("sun-finger", 1) < 100)
    return notify_fail("你的一阳指修为不够，目前还不能施展一指乾坤绝技！\n");

  if ((int)me->query_skill("force") < 150)
    return notify_fail("你内功火候不够，难以施展一指乾坤！\n");

  if ((int)me->query("neili") < 400)
    return notify_fail("你的真气不够，无法施展「一指乾坤」！\n");

  if (me->query_skill_mapped("finger") != "sun-finger")
    return notify_fail("你没有激发一阳指法，无法使用「一指乾坤」！\n");

  if (target->query_skill_mapped("force") == "hamagong")
    i = 4;
  else
    i = 2;

  msg = HIY "$N" HIY "使出一阳指绝技「一指乾坤」，攻向$n"
    HIY "的要穴，招式变化精奇之极！\n" HIY;

  cp = me->query_skill("force") - target->query_skill("force");
  if (cp < 0)
    cp = 0;

  if (random(me->query_skill("finger")) + random(cp) > target->query_skill("parry") / i || !living(target)) {
    damage = (int)me->query_skill("sun-finger", 1);
    damage = damage / 2 + random(damage / 2) + random(cp);
    damage = damage * i;
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 50,
      HIR "结果$p" HIR "没能避开$P"
      HIR "这一指，正被点中"
      HIY + xue_name[random(sizeof(xue_name))] +
      HIR "，浑身气血登时倒流，哇哇连吐几口鲜血！\n" NOR);

    if (random(me->query_skill("force")) + random(cp) > target->query_skill("force") / i || !living(target)) {
      damage /= 2;
      msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 80,
        HIR "$n真气受阻，身形一顿,$P"
        HIR "凝神又出一指直点"
        HIY + xue_name[random(sizeof(xue_name))] +
        HIR "，就听$p"
        HIR "一声惨叫，鲜血狂喷不止。\n" NOR);
    }
    me->add("neili", -(int)me->query_skill("finger", 1) / 2);
    me->start_busy(1);
  } else {
    msg += CYN "可是$p" CYN "看破了$P"
      CYN "急忙退闪，连消带打躲开了这一击。\n" NOR;
    me->start_busy(3);
    me->add("neili", -50);
  }
  message_combatd(msg, me, target);

  return 1;
}
