// sandie.c 阳关三叠
// looo/2001/6/28/
#include <ansi.h>

#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg, wp;
  int damage;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target) || !living(target))
    return notify_fail("「阳关三叠」只能在战斗中使用。\n");

  if ((int)me->query_skill("sun-finger", 1) < 180 ||
    (int)me->query_skill("finger", 1) < 180 ||
    (int)me->query_str() < 25)
    return notify_fail("你有的功夫还不够娴熟，不会使用「阳关三叠」。\n");

  if (me->query_skill_mapped("finger") != "sun-finger")
    return notify_fail("你现在无法使用「阳关三叠」进行攻击。\n");


  if ((int)me->query("max_neili") < 1800)
    return notify_fail("你的内力修为太弱，不能使用「阳关三叠」！\n");

  if ((int)me->query("neili") < 800)
    return notify_fail("你的真气不够！\n");

  msg = HIW "突然间";
  if (objectp(weapon = target->query_temp("weapon"))) {
    wp = weapon->name();
    msg += "$N" HIW "单指一扬，径点$n" HIW "持着" + wp + NOR + HIW
      "的手腕上「" HIY "腕骨" HIW "」、「" HIY "阳谷" HIW "」"
      "、「" HIY "养老" HIW "」三穴。\n" NOR;

    if (random(me->query_skill("finger")) > target->query_skill("force") / 2) {
      msg += HIR "霎时间$n" HIR "只觉得手腕一麻，手中" + wp + HIR "再也拿持不住，脱手掉在地上。\n";
      me->add("neili", -150);
      weapon->move(environment(target));
    } else {
      msg += CYN "可是$n" CYN "将手中" + wp + NOR + CYN "转"
        "动如轮，终于化解了这一招。\n";
      me->add("neili", -100);
    }
  }
  if (target->query_skill_mapped("force") == "hamagong") {
    msg += HIY "$N背向$n，凝气于指，一式「阳关三叠」反手缓缓点出，纯阳指力直袭$n胸口！\n" NOR;
    if (random(me->query_skill("force", 1)) > target->query_skill("force", 1) / 4) {
      damage = (int)me->query_skill("sun-finger", 1);
      damage += (int)me->query_skill("force", 1);
      damage = damage / 2 + random(damage / 2);
      msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 50,
        HIR "$n" HIR "大惊下发现这似乎正是自己的克星，已是躲避不及，给重重点中！\n\n" NOR);
      me->start_busy(1);
      target->start_busy(2);
      target->receive_damage("qi", damage);
      target->receive_wound("qi", damage / 3);
      me->add("neili", -300);
      if (me->query_skill("sun-finger", 1) > 189)
        call_out("perform2", 0, me, target);
    } else {
      msg += HIW "$p见这反手点穴似乎正是蛤蟆功的克星，识得厉害，危及之中一个铁板桥，上身向后一倒，艰难的躲过这一招。\n" NOR;
      me->start_busy(1);
      if (target->is_busy()) target->start_busy(1);
      me->add("neili", -200);
    }
  } else {
    msg += HIY "$N凝气于指，一式「阳关三叠」点出，但听得嗤嗤声响，一股纯阳的内力直袭$n胸口！\n" NOR;
    if (me->query_skill("dodge") / 4 + random(me->query_skill("finger")) > target->query_skill("parry") / 2) {
      damage = (int)me->query_skill("sun-finger", 1);
      damage += (int)me->query_skill("force", 1);
      damage = damage / 4 + random(damage / 4);
      msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 50,
        HIR "$n" HIR "一阵闷哼，全身血气倒流，连退数步！！！\n" NOR);
      me->start_busy(1);
      target->start_busy(2);
      if (me->query_skill("sun-finger", 1) > 189)
        call_out("perform2", 0, me, target);
    } else {
      msg += HIW "可是$p一个巧云翻身，远远的躲了开去。\n" NOR;
      me->start_busy(1);
      if (target->is_busy()) target->start_busy(1);
      me->add("neili", -100);
    }
  }
  message_vision(msg, me, target);
  return 1;
}

int perform2(object me, object target) {
  int i;
  string msg;
  int damage;
  if (!me || !target) return notify_fail("对手已经不在这里了！\n");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");

  if ((int)me->query("neili", 1) < 600)
    return notify_fail("你待要再出第二指，却发现自己的内力不够了！\n");

  if (target->query_skill_mapped("force") == "hamagong")
    i = 4;
  else
    i = 2;

  msg = HIY "\n接着$N踏前一步，出第二指隔空点向$n胸前“玉堂穴”，认穴竟无厘毫之差！\n" NOR;

  if (me->query_skill("dodge") / 6 + random(me->query_skill("dodge")) > target->query_skill("dodge") / i) {
    damage = (int)me->query_skill("sun-finger", 1);
    damage += (int)me->query_skill("force", 1);
    damage = damage / 4 + random(damage / 4);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60,
      HIR "结果一指点中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n" NOR);
    me->start_busy(1);
    target->start_busy(me->query_skill("force", 1) / 30);
    me->add("neili", -(me->query_skill("force", 1) / 2));
    if ((int)me->query_skill("sun-finger", 1) > 229)
      call_out("perform3", 0, me, target);
  } else {
    msg += HIW "\n$p眼看避无可避，便也一指点去，两根指尖相碰，$p顺势跳了开去。\n" NOR; me->start_busy(2);
    if (target->is_busy()) target->start_busy(1);
    me->add("neili", -(target->query_skill("force", 1) / i));
    target->add("neili", -(me->query_skill("force", 1) / 2));
  }
  message_vision(msg, me, target);
  return 1;
}

int perform3(object me, object target) {
  int i;
  int skill;
  string msg;
  int damage;
  skill = (int)me->query_skill("sun-finger", 1);
  skill = skill / 10;
  if (!me || !target) return notify_fail("对手已经不在这里了！\n");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");

  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你待要再出第三指，却发现自己的内力不够了！\n");

  if (target->query_skill_mapped("force") == "hamagong")
    i = 4;
  else
    i = 2;

  msg = HIY "\n紧跟着$N一阳指第三次点出，以纯阳内力，同时透入$n体内任脉紫宫穴、
阴维脉大横穴、冲脉幽门穴、带脉章门穴和阴跤脉晴明穴！\n" NOR;

  if (random(me->query_skill("force")) > target->query_skill("force") / i) {
    damage = (int)me->query_skill("sun-finger", 1);
    damage += (int)me->query_skill("force", 1);
    damage = damage / 3 + random(damage / 3);
    me->add("neili", -200);
    msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 70,
      HIR "$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n" NOR);
    target->add_temp("apply/attack", -200);
    target->add_temp("apply/dodge", -200);
    target->add_temp("apply/parry", -200);
    me->start_busy(3);
    if (target->is_busy()) target->start_busy(1 + random(2));
    target->add("neili", -(me->query_skill("force", 1) * 2 * i));
    call_out("back", 4 + skill, target);
  } else {
    msg += HIW "\n$p喘息未定，见$P指力如狂风般点来，连忙又跃开数尺，狼狈地避开。\n" NOR; me->start_busy(2 + random(2));
    me->add("neili", -200);
    target->start_busy(random(2));
  }
  message_vision(msg, me, target);
  return 1;
}

void back(object target) {
  if (!target) return;
  target->add_temp("apply/attack", 200);
  target->add_temp("apply/dodge", 200);
  target->add_temp("apply/parry", 200);
}
