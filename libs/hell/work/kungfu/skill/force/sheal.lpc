// lifeheal.c

#include <ansi.h>

int exert(object me, object target)
{
        string force;
	int delta = 0;
	object *fights;
	object sun_ob;

        if (! target || target == me)
                return notify_fail("你要用真气为谁疗伤？\n");

	if(!target->is_fighting())
		return notify_fail(HIR + target->name() + "并不需要你为他疗伤！\n" NOR);

	//返回正在战斗的对象
	fights = target->query_enemy();

	foreach (sun_ob in fights)
	{
                if(objectp(sun_ob) && sun_ob->id("sun wukong"))
			delta = 1;
	}

	if(delta != 1)
	{
		return notify_fail(HIR + target->name() + "并不需要你为他疗伤！\n" NOR);
	}

        if (target->query("not_living"))
                return notify_fail("你不能给" + target->name() + "疗伤。\n");

        force = me->query_skill_mapped("force");
        if (! force)
                return notify_fail("你必须激发一种内功才能替人疗伤。\n");

        if ((int)me->query_skill("force") < 400)
                return notify_fail("你的内功等级不够。\n");

        if ((int)me->query("max_neili") < 5000)
                return notify_fail("你的内力修为不够。\n");

        if ((int)me->query("neili") < 3000)
                return notify_fail("你现在的真气不够。\n");

        if ((int)target->query("eff_qi") >= (int)target->query("max_qi"))
                return notify_fail( target->name() +
                        "现在没有受伤，不需要你运功治疗！\n");

//        if ((int)target->query("eff_qi") < (int)target->query("max_qi") / 5)
//                return notify_fail( target->name() +
//                        "已经受伤过重，经受不起你的真气震荡！\n");

	delta = (int)(10 + (int)me->query_skill("force") / 100);

	 

        message_vision(
                HIY "$N见$n已然不支，一个箭步跃到$n身后，运起" + to_chinese(force) +
                "，手掌贴在$n的背心，将真气输入$n体内....\n"
                HIG "$n吐出一口瘀血，感觉伤势已有所缓解，立即投入战斗中。\n" NOR,
                me, target );

        target->receive_curing("qi", (int)(delta * 0.01 * target->query("max_qi")));

             target->set("qi",target->query("eff_qi"));
	if(target->is_busy())
		target->interrupt_me(delta);

	me->add_temp("k_sun/score", delta);

	tell_object(me,HIC "你为" + target->name() + "疗伤获得了" + chinese_number(delta) + "点战斗积分！\n" NOR);
        
        if ((int)target->query("qi") > (int)target->query("eff_qi"))
                target->set("qi", (int)target->query("eff_qi"));
        me->add("neili", -1000);
        me->start_busy(1);
        return 1;
}

