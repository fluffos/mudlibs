// pill.c
inherit COMBINED_ITEM;
void setup()
{
}
void init()
{
    add_action("do_eat", "eat");
    add_action("do_use", "use");
}
int do_eat(string arg)
{
    string what = query("cure");
    int howmuch = query("amount");
    if (!id(arg))
        return notify_fail("你想吃什么？\n");
    if ((int)this_player()->query("eff_qi") == 
        (int)this_player()->query("max_qi"))
        return notify_fail("你现在不需要用" + this_object()->name() + "。\n");
    else {
        this_player()->receive_curing("qi", 50);
        message_vision("$N吃下一包金创药，气色看起来好多了。\n", this_player());
        destruct(this_object());
        return 1;
    }
}

int do_use(string arg)
{
        object who, ob;

        who = this_player();
        ob = this_object();

        if( ! id(arg) )  return notify_fail("你想要吃什么东西？\n");

        if( who->is_fighting() ) return notify_fail("你现在正在战斗。\n");

        if( who->is_busy() ) return notify_fail("你正忙着呢！\n");
        
        who->start_busy(1);

        message_vision("$N将一" + ob->query("base_unit") + ob->name()
                + "放到口里，慢慢地吞了下去。\n", who );

        ob->get_effect( who );          // 药品的效果
        
        add_amount( -1 );        

        return 1;
}
