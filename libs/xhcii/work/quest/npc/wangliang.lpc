// NPC: wangliang.c 王亮
// derondog@xhcII

#include <ansi.h>
inherit NPC;

string ask_job();
string ask_fail();

void create() {
  set_name("王亮", ({ "wang liang", "wang" }));
  set("title", HIW "零担行始祖" NOR);
  set("nickname", HIC "货运神州" NOR);
  set("gender", "男性");
  set("age", 23);

  set("no_kill", 1);
  set("no_get", 1);

  set("inquiry", ([
    "job": ( : ask_job: ),
    "任务": ( : ask_job: ),
    "fail": ( : ask_fail: ),
    "失败": ( : ask_fail: ),
  ])),

    setup();
  carry_object("/clone/cloth/cloth")->wear();
}

#include "/quest/include/songhuo.h"
