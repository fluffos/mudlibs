// OBJ: biaoche.c 镖车(运镖用)
// derondog@ZLZY

#include <ansi.h>
#include <copy_player.h>
inherit ITEM;

mapping reverse_dir = ([
  "south": "南面",
  "north": "北面",
  "west": "西面",
  "east": "东面",
  "southup": "南边",
  "northup": "北边",
  "westup": "西边",
  "eastup": "东边",
  "southdown": "南边",
  "northdown": "北边",
  "westdown": "西边",
  "eastdown": "东边",
  "southwest": "西南方向",
  "southeast": "东南方向",
  "northwest": "西北方向",
  "northeast": "东北方向",
  "down": "下面",
  "up": "上面",
  "enter": "外面",
  "out": "里面",
]);

void create() {
  set_name("镖车", ({ "biao che", "che" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一辆满载货物的镖车，里面可能装的东西可能价值连城哦！\n你不禁想……\n");
    set("unit", "辆");
    set("no_get", "扛着车子你不累吗？");
    set("no_clean", 1);
  }
  set_weight(50000);
  set("value", 1000);
}

void init() {
  add_action("do_tui", "tui");
}

int do_tui(string arg) {
  string dir, dest;
  object me, ob, env, obj, robber, bs;
  int exp, pot;
  mapping exit;
  me = this_player();
  env = environment(me);

  ob = present(me->query("id") + "'s che", env);
  if (!ob)
    return 1;

  if (!arg || !sscanf(arg, "che %s", dir))
    return notify_fail("推车的命令格式为：" + CYN + "tui che 方向。\n如：tui che east\n" NOR);

  if (me->over_encumbranced())
    return notify_fail("你的负荷过重，动弹不得。\n");

  if (!mapp(exit = env->query("exits")) || undefinedp(exit[dir]))
    return notify_fail("这个方向没有出路。\n");

  if (me->is_busy())
    return notify_fail("你上一个动作还没完成，怎么推车啊？\n");

  if (me->is_fighting())
    return notify_fail("你还是把你的对手解决了再推车吧！\n");

  if (me->query("qi") < 50)
    return notify_fail("你实在太累了，休息一下再走吧！\n");

  if (objectp(robber = present("jie fei", env)))
    if (robber->query("target") == me->query("id"))
      return notify_fail("那个劫匪好象在打你的注意，先解决了他在说吧！\n");

  dest = exit[dir];
  if (!(obj = find_object(dest)))
    call_other(dest, "???");
  if (!(obj = find_object(dest)))
    return notify_fail("前面形势不太清楚，你走过去看看？。\n");

  if (!undefinedp(reverse_dir[dir]))
    dir = reverse_dir[dir];
  else
    dir = arg;


  message_vision(CYN "$N推着$n向" + dir + "的" + obj->query("short") + "离开了。\n" NOR, me, ob);
  ob->move(obj);
  me->move(obj);
  message_vision(CYN "$N推着$n走到了" + obj->query("short") + "。\n" NOR, me, ob);
  if (objectp(bs = present("biao shi", env)))
    if (bs->query("target") == me->query("id")) {
      bs->move(obj);
      message_vision("$N紧跟着$n走了过来。\n", bs, me);
    }

  me->start_busy(2 + random(4));
  me->add("qi", -25 - random(25));

  if (ob->query("time") < time()) {
    message_vision(CYN "一位镖局弟子跑了过来盯了$N半晌，骂道：你这么磨磨蹭蹭的，什么时候才运得到啊？\n" NOR, me);
    message_vision(CYN "镖局弟子推车$N向前方离去了……\n" NOR, ob);
    destruct(ob);
    return 1;
  }

  if (base_name(obj) == ob->query("dst")) {
    exp = 30 + random(3 * obj->query("bouns"));
    message_vision(CYN "$N累得满头大汗，终于将货车推到了目的地。\n" NOR, me);
    if (objectp(bs)) {
      message_vision(CYN "$N对$n道了声谢，转身离去了。\n" NOR, bs, me);
      destruct(bs);
      exp += 50 + random(50);
    }
    pot = exp + random(exp);

    tell_object(me, sprintf(HIW "你被奖励了：\n%s点实战经验，\n%s点潜能。\n" NOR,
      chinese_number(exp), chinese_number(pot)));
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->delete("quest");
    destruct(ob);
  }

  if (random(me->query_kar()) < 15) {
    robber = new("/quest/npc/robber");
    robber->move(obj);
    robber->set("target", me->query("id"));
    copy_player(me, robber, 30);
    if (objectp(bs)) {
      message_vision(HIR "$N对$n喝道：嘿嘿，红货留下，可保你性命，不然……\n" NOR, robber, bs);
      robber->kill_ob(bs);
      bs->kill_ob(robber);
    } else {
      message_vision(HIR "$N对$n喝道：镖师都了，还那么拼命做什么嘛？快快逃命去吧……\n" NOR, robber, me);
      robber->kill_ob(me);
      me->kill_ob(robber);
    }
  }
  obj->add("bouns", 1);

  return 1;
}
