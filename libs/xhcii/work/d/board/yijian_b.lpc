
inherit "/inherit/misc/jianju.lpc";
void create()
{
     set_name("玩家"HIR"意见簿"NOR, ({"board"}) );
    set("location", "/d/city/beidajie1");
     set("board_id", "yijian_b");
    set("no_get",1);
     set("long", "\n为了一个更"HIY"完善"NOR"，更"HIG"有序"NOR"的江湖风云, 特开通
此留言版供玩家抒发对游戏的不满以及对巫师
和BUG ID的检举, 请玩家站在"HIR"客观的立场"NOR"上发
表自己的意见，巫师不得留言！\n");	

	setup();
	set("unit","块");
        set("capacity", 218);
	replace_program("/inherit/misc/jianju.lpc");
}
