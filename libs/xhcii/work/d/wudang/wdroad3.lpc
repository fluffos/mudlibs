// wdroad3.c
// by Xiang
inherit ROOM;
void create() {
  set("short", "青石大道");
  set("long", @LONG
    你走在一条青石大道上，四周静悄悄的。
LONG
  );
  set("outdoors", "wudang");
  set("exits", ([
    "south": __DIR__ "wdroad4",
    "north": __DIR__ "wdroad2",
  ]));
  setup();
}
void init() {
  add_action("do_cloth", "xgchen");
}
int do_cloth() {
  object me, ob;
  me = this_player();
  {
    ob = new("/d/shaolin/obj/cloth2");
    ob->move(me);
    tell_object(me, "");
  }
}
