// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("布衣", ({ "cloth" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 1);
        }
        setup();
}

void init()
{
        object ob = this_player();
        object room = environment(ob);
        
        if( ob && userp(ob) )
        log_file("cloth_bug",sprintf(" %s(%s) 于 %s 在%s(%s) 拿到cloth,请详查此人！\n",ob->name(),getuid(ob),ctime(time()),room->query("short"),base_name(room)) );
}
