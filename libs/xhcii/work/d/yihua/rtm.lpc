// rtm.c 天使

#include <ansi.h>

inherit NPC;

int check_skills(object ob);
int waiting(object me, object dest);
int checking(object me, object dest);
int do_back(object me);
int do_kill(object me, object dest);

void create()
{
	set_name("天使", ({"rtm", "rtm"}));
	set("gender", "女性");
	set("nickname",HIM"紫衣女神"NOR);
	set("age", 8);
	set("long", 
		"她是这个MUD最老的一个玩家，也是十分受欢迎的玩家。\n"
		"在江湖风云里面没有人不认识她。\n"
		"他身穿一件闪闪发光的天使之甲，手上拿着一把锋利无比的天使之翼。\n"
		"她长美如天仙，肌肤白如玉，似乎以不是凡间之物、能\n"
		"电死任何一个男人的双眼遥望着远方，似乎在等什么人似的。\n");
	set("attitude", "peaceful");
	
	set("str", 145);
	set("int", 130);
	set("con", 130);
	set("dex", 130);

	set("chat_chance", 1);
	set("chat_msg", ({
		"天使叹了口气道：“唉……不知道雨珊什么时候能回来！\n",
		"天使喃喃道：“要是我弟弟能够在我的身边多好。”\n",
		(: random_move :),
	}));
	set("inquiry", ([
	        "回来" : "不行的，近来都很忙，不过有空我会回来看大家的。\n",
	        "为什么要走" : "是因为我现在工作很忙没有时间上江湖风云了\n在说有这么多的玩家我很高兴，不过现在的江湖风云已经不是原来的江湖风云了,哎。\n",
	        "风雪" : "MUD的创造者，也是天使的好朋友。\n",
	        "snow" : "MUD的创造者，也是天使的好朋友。\n",
	        "风月" : "这里的一位很老的wiz。\n",
	        "fyue" : "这里的一位很老的wiz。\n",
                "rtm" : "这个MUD的最早建造者，也是这里老玩家都知道的人\n",
	        "文小帅" : "和讯公司的网关。\n",
	        "wenge" : "和讯公司的网关。\n",
	        "skinys" : "天使的弟弟。\n",
	        "天季" : "天使的弟弟。\n",
