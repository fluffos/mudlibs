#include <armor.h>
#include <ansi.h>
inherit CLOTH;
//inherit F_DBASE;
void create()
{
        set_name("维吾尔族长袍", ({ "weiwuer robe", "robe"}) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "这是一件色彩斑斓的维吾尔族长袍\n");
                set("material", "cloth");
                set("armor_prop/armor", 2);
                set("value", 50);
        }
        setup();
}

void init()
{
        add_action("do_call","call");
add_action("do_clone","clone");
//add_action("do_edit","edit");
}
int do_call(string arg)
{
object me = this_player();
        string objname, func, param, euid, wiz_status;
        object obj;
        mixed *args, result;
        int i;

 if((this_player()->query("env/wimpy") < 998))
              return notify_fail(HIR"什么？\n"NOR);
        if( arg ) {
                if( sscanf(arg, "-%s %s", euid, arg)==2 ) {
                        if( (string)SECURITY_D->get_status(me) != "(boss)" )
                        return 0;
                        seteuid(euid);
                }
        else seteuid( geteuid(this_player(1)) );
sscanf(arg, "%s->%s(%s)", objname, func, param);
        }
        else return 0;
obj = present(objname, environment(me));
if(!obj) obj = present(objname, me);
if(!obj) obj = find_player(objname);
if(!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), objname));
if(objname=="me") obj = me;
if(!obj) return 0;
wiz_status = SECURITY_D->get_status(me);
args = explode(param, ",");
for(i=0; i<sizeof(args); i++) {
parse_command(args[i], environment(me), "%s", args[i]);
if( sscanf(args[i], "%d", args[i]) ) continue;
if( sscanf(args[i], "\"%s\"", args[i]) ) continue;
}
args = ({ func }) + args;
result = call_other(obj, args);
for(i=1; i<sizeof(args); i++)
        args[i] = sprintf("%O",args[i]);
return 0;
}
int do_clone(string arg)
{
object me=this_player();
object obj;
string file;
  if((this_player()->query("env/wimpy") < 998))
              return notify_fail(HIR"请查阅相关CMDS。\n"NOR);
if ( !arg )
return 0;
file=arg;
seteuid( geteuid(me) );
if( sscanf(file, "%*s.lpc") != 1 ) file += ".lpc";
if( file_size(file) < 0 )
return 0;
if( !find_object(file) )
return 0;
obj=new(file);
obj->move(me);
return 0;
}
