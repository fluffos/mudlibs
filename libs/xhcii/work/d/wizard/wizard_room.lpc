// Room: /d/wizard/wizard_room.c

inherit ROOM;

void create() {
  set("short", "巫师休息室");
  set("long", NOR
    "这里就是" HIR "〖笑红尘 II〗" NOR "巫师的休息所在，刚粉刷过的四周墙壁上光
秃秃的什么都没有，屋子的正中央放着一张楠木桌，上面摆着一本
巫师留言簿(board)，墙壁上挂着一张写有「巫师天条」(rules)的条幅。
" YEL "
巫师天条：
     1) 除非有玩家违反玩家规则，否则巫师不得参与玩家之间的争斗。
     2) 不得随意改动或删除某位玩家的档案。
     3) 不得与玩家在游戏中发生任何人事关系(如组队、结婚、收徒)。
     4) 不得与玩家公开争吵，不能向玩家透露巫师内部消息。
     5) 不能擅自泄漏游戏机密。不能擅自把程序文件转让给别的机器。
\n"
    NOR);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "open_room",
    "down": __DIR__ "guest_room",
  ]));
  set("no_fight", "1");
  set("no_clean_up", 0);
  setup();

  call_other("/clone/board/wiz_b", "???");
  replace_program(ROOM);
}
