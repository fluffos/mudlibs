// topkan@xhc
inherit ROOM;

void create() {
  set("short", "开线房");
  set("long", @LONG
这里就是 笑红尘 II 的开线房。
LONG);

  set("exits", ([
    "down": "/d/city/wumiao",
  ]));
  set("no_fight", "1");
  set("no_clean_up", 0);
  setup();

  call_other("/clone/board/opennet_b", "???");
}
void init() {
  add_action("do_open", "open");
}
int do_open(string arg) {
  object obj;
  object me = this_player();
  if ((string)me->query("id") != "zhyhan" && (string)me->query("id") != "adaaa") return 0;
  if (!arg || arg == "") return notify_fail("你想打开哪个方向的门。\n");
  if (arg == "home") {
    message_vision(HIM "$N凌空一指，你突然看见眼前出现了一条通向飞翔工作室的路。\n" NOR, me);
    if (!query("exits/home")) {
      set("exits/home", "/u/zhyhan/workroom.lpc");
      call_out("close_path", 5);
    }
    return 1;
  }
}
void close_path() {
  if (!query("exits")) return;
  message("vision", YEL
    "一眨眼之间，通往飞翔工作室的路已经消失了！\n" NOR,
    this_object());
  delete("exits/home");
}
int valid_leave(object me, string dir) {
  if ((this_player()->query("id") != "zhyhan") && (this_player()->query("id") != "adaaa") && (dir == "home"))
    return notify_fail(
      "这位" + RANK_D->query_respect(me) + "请止步，这条路只有经过飞翔许可的人才可以通过！\n");
  return ::valid_leave(me, dir);
}
