#include <room.h>
inherit ROOM;
void create()
{
    set("short", "巫师会客厅--任务版");
    set("long", @LONG
这里是巫师会客厅的任务版，有关任务方面的问题POST在这里。
LONG
    );
    set("no_fight", 1);
    set("no_steal", 1);
    set("no_sleep_room", "1");
           set("valid_startroom",1);
    set("exits", ([
        "west" : "/d/wizard/guest_room",
            ]));
               setup();
        "/d/wizard/quest_b"->foo();
}
void init()
{
    if (!wizardp(this_user()))
    add_action("discmds",({"duanlian","ansuan","touxi","persuade","teach","exert","exercise","study","learn","sleep","kill","steal","cast","conjure","expell","fight","hit","perform","prcatice","scribe","surrender"}));
}
int discmds()
{
    tell_object(this_player(),"大胆！在神像面前也敢胡来？！\n");
    return 1;
}

