#include <ansi.h>

inherit ROOM;
void check_time(object where);
void appear(object where);
void end(object where);

void create() {
  set("short", "擂台");
  set("long", @LONG

本来这是个唱戏的地方，后来自从清朝繁盛以后，来自各国的挑战
者数不胜数，他们大多是慕华夏武术之大名而来。

LONG
  );

  set("exits", ([
    "down": __DIR__ "wumiao",
  ]));
  setup();
}


void init() {
  //   seteuid(getuid);
  object where = this_object();
  check_time(where);
}

void check_time(object where) {
  mixed *local = localtime(time() * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));
  if (phase == 3) appear(where);
  if (phase == 5) end(where);
  call_out("check_time", 20, where);
}

void appear(object where) {
  object tz;
  if (present("challenger")) return;
  tz = new(__DIR__ "npc/tzer");
  tz->move(where);
  tz->set_temp("invite", "public");
  message(
    "channel:es",
    HIR + "【外国挑战】[1;36m康熙皇帝（king）：来自" + tz->query("nation") + "[1;36m的[m" + tz->query("name") + "[1;36m要挑战我大清，有愿意迎战者，请用（accept challenger）即可。[m\n" + NOR,
    users()
  );
}

void end(object where) {
  object tz;
  if (!present("challenger", where)) return;
  tz = find_living("challenger");
  message(
    "channel:es",
    HIR + "【趾高气扬】[1;36m" + tz->query("name") + "（challenger）：清朝也不过如此嘛！人人都是胆小鬼，难怪叫做东亚病夫！\n" NOR,
    users()
  );
  destruct(tz);
}
