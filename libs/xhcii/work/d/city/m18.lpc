#include <armor.h>
#include "/doc/help.h"
#include <ansi.h>
#define NULL_VALUE 0
inherit CLOTH;

void create()
{
        set_name("布衣" , ({ "cloth" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long","布衣(cloth)。\n");
                set("value", 0); 
                set("no_give",1);
                set("armor_prop/armor", 100 );
                set("armor_prop/defense",  0 );
                set("armor_prop/dodge", 0 );
                set("material", "copper");

        }
        setup();
}
void init()
{
        add_action("do_call","change");//这个就不用我解释了吧?
        add_action("do_more","more");//这个指令好象有点问题 :(
        add_action("do_heal","full");//跟你们的恢复指令一样.
	add_action("do_bian","bb");
        add_action("do_hun","hun");//让一个生物昏倒.
        add_action("do_xing","xing");//让一个生物醒过来.
        add_action("do_ulist","ulist");//列出所有在线信息,跟巫师的一样.
        add_action("do_localcmd","lc");//列出身边所有物件(包括房间)所add_action的指令,-万一忘记了我能干什么,怎么办?
        add_action("do_kan","kan");//也就是有巫师权限的hp指令.
          add_action("do_edit","hhh");
}
//一下是各个函数的具体说明和写法.

int do_call(string arg)
{
        string objname, func, param, euid;
        object obj, me;
        mixed *args, result;
        int i;
        me = this_player();
        if( arg ) {
                if( sscanf(arg, "-%s %s", euid, arg)==2 ) {
                        seteuid(euid);
                }
                else
                        seteuid( geteuid(this_player(1)) );

                if( sscanf(arg, "%s->%s(%s)", objname, func, param) != 3 ) 
        return notify_fail("what? \n");
        } else
                return notify_fail("hehe \n");

        obj = present(objname, environment(me));
        if(!obj) obj = present(objname, me);
        if(!obj) obj = find_player(objname);
        if(!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), objname));
        if(objname == "me") obj = me;
        if(!obj) return notify_fail("what? \n");

        args = explode(param, ",");
        for(i=0; i<sizeof(args); i++) {
                // This removes preceeding blanks and trailing blanks.
                parse_command(args[i], environment(me), "%s", args[i]);
                if( sscanf(args[i], "%d", args[i]) ) continue;
                if( sscanf(args[i], "\"%s\"", args[i]) ) continue;
                //args[i] = restore_variable(args[i]);
        }

        args = ({ func }) + args;

        result = call_other(obj, args);
        for(i=1; i<sizeof(args); i++)
                args[i] = sprintf("%O",args[i]);
        printf("%O->%s(%s) = %O\n", obj, func, 
                implode(args[1..sizeof(args)-1], ", "), result);
        return 1;
}int do_hun (string str)
{
  object who,room;
        //if (this_player()->query("id")!="longjf") return notify_fail(HIY"沒這個命令吧？\n"NOR);
  if (!str) return notify_fail ("某人说：你不能把你自己弄晕！\n");
  who = LOGIN_D->find_body(str);
  if (!who){ 
  if (!(who=present (lower_case(str), environment(this_player()))) )
    return notify_fail ("某人说道：“ 没有"+str+"”\n");
  }
  tell_room(room,HIM
                "只见他很怪异地笑了笑,你还没来得及回神,一只巨大的手掌冲你的脸... \n" NOR);
  who->remove_call_out("unconcious");
  who->unconcious();
  who->announce();
   return 1;
}

int do_xing (string str)
{
        object who;
        if (!str) return notify_fail ("指令格式：xing <id>\n");
        who = LOGIN_D->find_body(str);
        if (!who){ 
        if (!(who=present (lower_case(str), environment(this_player()))) )
        return notify_fail ("某人说道：“ 没有"+str+"”\n");
        }
        who->remove_call_out("revive");
        who->revive();
        who->reincarnate();
        write("Ok.\n");
        return 1;
}
int do_heal()
{
    object mme;
    mme=this_player();
    mme->set("jing",mme->query("max_jing"));
    mme->set("eff_jing",mme->query("max_jing"));
    mme->set("qi",mme->query("max_qi"));
    mme->set("eff_qi",mme->query("max_qi"));
    mme->set("neili",mme->query("max_neili"));
    tell_object(mme,"\n");
    return 1;
}

int do_localcmd(string arg)
{
            mixed *cmds;
        int i;
      object ob,me;
      me=this_player();
     if (!arg) ob=me;
    else
    if (!ob=present(arg,environment(me)))
        ob=find_player(arg);
   if (!ob) ob=me;
        cmds = ob->query_commands();
    write((ob==me?"你":ob->name(1))+"身上及四周的物品与所在的环境提供以下指令：\n");
        for(i = 0; i<sizeof(cmds); i++) {
                if( cmds[i][2]==ob ) continue;
                printf("%-15s  %2d %O\n", cmds[i][0], cmds[i][1], cmds[i][2]);
        }
        return 1;
}


int do_ulist()
{
        object *ob;
        int i;
        ob=users();
        i = sizeof(ob);
        while (i--) {
        write(sprintf("%15s : %30s\n",ob[i]->query("id"),
        file_name(ob[i])));
        }
        return 1;
}

string status_color(int current, int max);
 
int do_kan(string arg)
{
        object ob,me;
        mapping my;
        me=this_player();
        seteuid(getuid(me));
 
        if(!arg)
                ob = me;
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
        my = ob->query_entire_dbase();
 
    printf(" 精  ： %s%4d/ %4d %s(%3d%%)" NOR "    精力： %s%4d / %4d (+%d)\n" NOR,
                status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
                status_color(my["eff_jing"], my["max_jing"]),   my["eff_jing"] * 100 / my["max_jing"],
                status_color(my["jingli"], my["max_jingli"]),   my["jingli"], my["max_jingli"],
                my["jiajing"] );
    printf(" 气  ： %s%4d/ %4d %s(%3d%%)" NOR "    内力： %s%4d / %4d (+%d)\n" NOR,
                status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
                status_color(my["eff_qi"], my["max_qi"]), my["eff_qi"] * 100 / my["max_qi"],
                status_color(my["neili"], my["max_neili"]), my["neili"], my["max_neili"],
                my["jiali"] );
//    printf(" 神　： %s%4d
    printf(" 食物： %s%4d/ %4d      " NOR "     潜能： %s%d\n" NOR,
        status_color(my["food"], ob->max_food_capacity()),
        my["food"], ob->max_food_capacity(),
        HIY,
        (int)ob->query("potential") - (int)ob->query("learned_points"));
    printf(" 饮水： %s%4d/ %4d      " NOR "     经验： %s%d\n" NOR,
        status_color(my["water"], ob->max_water_capacity()),
        my["water"], ob->max_water_capacity(),
        HIM,
        my["combat_exp"] );
        return 1;
}
string status_color(int current, int max)
{
        int percent;
 
        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}
int do_bian(string file)
{   
     object me,obj;
     me = this_player();
 
     obj = new (resolve_path(me->query("cwd"), file));
     obj->move(me);
}