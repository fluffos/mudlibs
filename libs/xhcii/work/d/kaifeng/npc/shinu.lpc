#include <ansi.h>

inherit NPC;

void create() {
  set_name("侍女", ({ "shi nu", "nu", "waiter" }));
  set("gender", "女性");
  set("long", "皇宫中的侍女，负责皇宫里的饮食起居等杂务。\n");
  set("combat_exp", 1000 + random(4000));
  set("attitude", "friendly");
  set("max_qi", 200);
  set("max_jing", 200);
  set("force", 100);
  set_skill("unarmed", 15);
  set_skill("parry", 15);
  set_skill("dodge", 15);

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
