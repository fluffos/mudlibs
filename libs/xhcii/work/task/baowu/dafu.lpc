inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
       set_name(HIW "大斧",({"big axe", "axe"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("long","兵器。\n");
                set("unit", "件");
                set("task_object",1);
          set("owner_name", HIG "俞岱岩");
          set("owner_id", "yu daiyan");
        }
}

