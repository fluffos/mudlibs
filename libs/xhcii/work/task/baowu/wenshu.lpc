inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIW "文书", ({"wen shu", "shu"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "文书。\n");
                set("unit", "件");
               set("owner_name",HIG "梅剑");
               set("owner_id","meijian");
              set("task_object", 1);
        }
}
