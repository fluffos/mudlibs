// topkan@xhc
#include <ansi.h>
inherit ITEM;
#include "task.h"
void create() {
  set_name(HIR "火灵珠" NOR, ({ "huo lingzhu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("material", "crystal");
    set("value", 1);
    set("long", "传说中的五行宝珠之一，佩之可避火烧，并可发出火系
法术。");
    set("task_object", 1);
    set("owner_id", "dongfang bubai");
    set("owner_name", HIG "东方不败");
  }
  setup();
}
