// topkan@xhc
inherit ITEM;
#include <ansi.h>
#include "task.h"
void create() {
  set_name(HIG "银酒壶", ({ "yin jiuhu", "jiuhu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "酒壶。\n");
    set("unit", "件");
    set("task_object", 1);
    set("owner_name", HIR "葛伦布");
    set("owner_id", "ge lunbu");
  }
}
