// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIC "铁枪", ({ "iron spear", "spear" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "兵器。\n");
    set("unit", "件");
    set("owner_name", HIW "静风师太");
    set("owner_id", "jing feng");
    set("task_object", 1);
  }
}
