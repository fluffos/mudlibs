// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIR "烟斗", ({ "yan dou", "dou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "烟斗。\n");
    set("unit", "个");
    set("owner_name", HIG "任我行");
    set("owner_id", "ren woxing");
    set("task_object", 1);
  }
}
