// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIG "山羊胡子", ({"shanyang huzi", "huzi"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "山羊胡子。\n");
                set("unit", "把");
                set("task_object",1);
               set("owner_name",HIB "康熙");
               set("owner_id","kang xi");
        }
}
