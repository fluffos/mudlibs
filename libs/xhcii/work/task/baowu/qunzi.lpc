// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIW "花裙子", ({ "hua qunzi", "qunzi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件很漂亮的裙子。\n");
    set("unit", "件");
    set("task_object", 1);
    set("owner_name", HIR "黄蓉");
    set("owner_id", "huang rong");
  }
}
