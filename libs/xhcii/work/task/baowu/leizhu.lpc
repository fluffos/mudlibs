#include <ansi.h>
#include "task.h"
inherit ITEM;
void create()
{
set_name(HIB "雷灵珠" NOR, ({"lei lingzhu"}) );
 set_weight(200);
        if( clonep() )
  set_default_object(__FILE__);
 else {
  set("unit", "颗");
  set("material", "crystal");
  set("value",1);
                set("long","传说中的五行宝珠之一，佩之可避雷击，并可发出雷击
法术。");
                set("owner_name",HIC "鸠摩智");
                set("owner_id","jiu mozi");
	set("task_object",1);
 }
 setup();
}
