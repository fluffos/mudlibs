inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIG "肚兜", ({"du dou", "dou"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "肚兜。\n");
                set("unit", "件");
                set("task_object",1);
               set("owner_name",HIG "小桂子");
               set("owner_id","xiao guizi");
        }
}
