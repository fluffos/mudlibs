// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(RED "人血", ({ "ren xue", "xue" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "血。\n");
    set("unit", "滴");
    set("owner_name", HIW "任盈盈");
    set("owner_id", "ren yinyin");
    set("task_object", 1);
  }
}
