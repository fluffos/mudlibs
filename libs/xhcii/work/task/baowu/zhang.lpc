// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIC "擀面杖", ({ "ganmian zhang", "zhang" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "擀面杖。\n");
    set("unit", "根");
    set("owner_name", HIB "清缘比丘");
    set("owner_id", "qingyuan biqiu");
    set("task_object", 1);
  }
}
