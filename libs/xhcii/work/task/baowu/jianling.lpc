inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIM "凤尾箭翎", ({"fengwei jianling", "jianling"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一个凤尾箭翎。\n");
                set("unit", "只");
               set("owner_name",HIB "周芷若");
               set("owner_id","zhou ziluo");
	set("task_object",1);
        }
}
