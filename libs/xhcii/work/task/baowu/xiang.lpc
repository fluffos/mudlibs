inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(RED  "一柱香", ({"yizhu xiang", "xiang"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "很常见的一种香。\n");
                set("unit", "根");
                set("owner_name",HIW "达摩祖师");
            set("owner_id","da mo");
	set("task_object",1);
        }
}
