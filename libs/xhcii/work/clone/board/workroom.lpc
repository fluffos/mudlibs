//Room of wizard that haven't modify own workroom.
//Modify by Super 1998.1.2

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", BLINK HIY "封禅屋" NOR);
  set("long", @LONG
LONG);
  set("valid_startroom", 1);
  set("no_fight", "1");
  set("no_clean_up", 0);

  "/clone/board/zen_b"->foo();
  setup();
}
void init() {
  add_action("do_open", "open");
  add_action("do_save", "save");
}

int valid_leave(object me, string dir) {
  if (dir == "north" && !wizardp(me))
    return notify_fail("那里只有巫师才能进去。\n");
  return ::valid_leave(me, dir);
}

int do_open(string arg) {
  object obj;
  object me = this_player();
  if ((string)me->query("id") != "zen" && (string)me->query("id") != "root")
    return notify_fail("你以为你是谁啊？？");
  if (!arg || arg == "") return notify_fail("你想打开哪个方向的门。\n");
  if (arg == "gc") {

    message_vision("$N举手一指，你突然看见眼前出现了一条通向广场的路。\n", me);
    if (!query("exits/gc")) {
      set("exits/gc", "/d/city/guangchang");
      call_out("close_path", 60);
    }
    return 1;
  }

  if (arg == "wiz") {

    message_vision("$N举手一指，你突然看见眼前出现了一条通向工作室的路。\n", me);
    if (!query("exits/north")) {
      set("exits/north", "/d/wizard/wizard_room");
      call_out("close_path", 60);
    }
    return 1;
  } else return notify_fail("你想打开哪个方向的门。\n");
}

void close_path() {
  if (!query("exits")) return;
  {
    message("vision",
      "一眨眼间，所有的出路都不见了。\n",
      this_object());
    delete("exits");
  }
}

int do_save() {
  object obj;
  object me = this_player();
  if ((string)me->query("id") == "zen") {
    me->set("startroom", "/u/root/workroom");
    write("当你下次连线进来时，会从这里开始。\n");
    return 1;
  }
  me->set("startroom", "/d/city/guangchang");
  return 1;
}
