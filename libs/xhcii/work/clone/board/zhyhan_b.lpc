// /clone/board/zhyhan_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name(HIC "航班记录册" NOR, ({ "board" }));
  set("location", "/u/zhyhan/workroom");
  set("board_id", "zhyhan_b");
  set("long", MAG "这是一本为方便其他巫师通知" BLINK + HIC "飞翔" NOR + MAG "最近应该飞去哪的航班记录。\n" NOR);
  setup();
  set("capacity", 30);
}
