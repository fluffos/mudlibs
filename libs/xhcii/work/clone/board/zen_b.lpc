#include <ansi.h>

inherit BULLETIN_BOARD;

void create()
{
        set_name("大"BLINK HIR"bug"NOR"解决板", ({ "board" }) );
        set("location", "/u/zen/workroom");
        set("board_id", "zen_b");
        set("long", "这是一个专供post大bug等zen处理的黑板,如果有什么大问题处理不了就post吧。\n" );
        setup();
        set("capacity", 999);
        replace_program(BULLETIN_BOARD);
}

