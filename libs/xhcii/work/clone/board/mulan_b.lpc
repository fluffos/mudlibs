// /clone/board/zhyhan_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name(HIY "生死簿" NOR, ({ "board" }));
  set("location", "/u/mulan/workroom");
  set("board_id", "mulan_b");
  set("long", MAG "这是一本为方便其他巫师通知记录。\n" NOR);
  setup();
  set("capacity", 30);
  replace_program(BULLETIN_BOARD);
}
