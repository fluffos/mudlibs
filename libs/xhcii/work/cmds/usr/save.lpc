// save.c
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object link_ob;
  seteuid(getuid());
  if (!objectp(link_ob = me->query_temp("link_ob")))
    return notify_fail(HIB "你不是经由正常连线进入，不能储存。\n" NOR);
  if (me->query_temp("save_time") + 60 > time()) {

    write(HIW "档案储存完毕。\n" NOR);
    return 1;
  }
  if (environment(me)->query("valid_startroom")) {
    if (!wizardp(me) && sscanf(base_name(environment(me)), "/u/%*s"))
      ;
    else {
      me->set("startroom", base_name(environment(me)));
      write(HBRED "当你下次连线进来时，会从这里开始。\n" NOR);
    }
  }
  me->set_temp("save_time", time());

  if ((int)link_ob->save() && (int)me->save()) {
    write(HIW "档案储存完毕。\n" NOR);
    return 1;
  } else {
    write(HIB "储存失败。\n" NOR);
    return 0;
  }
}
int help(object me) {
  write(@HELP
指令格式：save
把你辛苦奋斗的结果存起来。
HELP
  );
  return 1;
}
