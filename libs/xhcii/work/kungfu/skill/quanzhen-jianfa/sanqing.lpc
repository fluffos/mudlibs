// sanqing.c 全真剑法  一剑化三清

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
void remove_effect(object me, int amount);
int perform(object me, object target) {
  string msg;
  int extra, time;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("〖一剑化三清〗只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((me->query("family/family_name") != "全真教"))
    return notify_fail("你不是全真弟子，无法使用全真的绝技！\n");


  if ((int)me->query_skill("quanzhen-jian", 1) < 100)
    return notify_fail("你的全真剑法不够娴熟，不会使用〖一剑化三清〗。\n");

  if ((int)me->query_skill("xiantian-qigong", 1) < 60)
    return notify_fail("你的先天功不够娴熟，无法支持〖一剑化三清〗。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你的内力不够，无法使用〖一剑化三清〗。\n");

  if ((int)me->query_temp("sanqing"))
    return notify_fail("你已经在使用〖一剑化三清〗了。\n");


  extra = (int)me->query_skill("quanzhen-jian", 1) + (int)me->query_skill("sword", 1);

  message_vision(HIG "\n$N长啸一声身形突然加快，一剑化为三剑，剑剑快似流星！\n\n" NOR, me, target);

  me->add_temp("apply/attack", extra / 5);
  me->add_temp("apply/damage", extra / 10);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);

  me->set_temp("sanqing", 1);
  me->add("neili", 100);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, extra / 10 :), extra / 10);
  return 1;
}

void remove_effect(object me, int amount) {
  if ((int)me->query_temp("powerup")) {
    me->add_temp("apply/attack", -amount);
    me->add_temp("apply/damage", -amount);
    me->delete_temp("sanqing");
    tell_object(me, HIG "你的长吸一口气，将内力收回丹田。\n" NOR);
  }
}
