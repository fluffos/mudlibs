// ding.c 全真剑-定阳针

#include <ansi.h>
inherit F_SSERVER;

string *name1 = ({ HIR"玉堂穴"NOR, HIW"大横穴"NOR, HIY"幽门穴"NOR, HIG"章门穴"NOR, HIB"晴明穴"NOR, HIC"紫宫穴"NOR,
                   HIC"风池穴"NOR, HIW"太阳穴"NOR, HIY"会阴穴"NOR, HIG"长强穴"NOR, HIB"灵台穴"NOR });

int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg,name;



        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("定阳针只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");


        if((me->query("family/family_name") != "全真教"))
           return notify_fail("你不是全真弟子，无法使用全真的绝技！\n");


        if( (int)me->query_skill("quanzhen-jian", 1) < 80 )
                return notify_fail("你的全真剑法不够娴熟，不能使用定阳针。\n");

        if( target->is_busy()) 
               return notify_fail(target->query("name")+"正自顾不暇放胆攻击吧。\n");

        if( (int)me->query("neili", 1) < 150 )
                return notify_fail("你现在内力太弱，不能使用定阳针。\n");
       
        name = name1[random(sizeof(name1))];    


        msg = HIC "\n$N脚下左弓右箭，神气完足如雷霆五岳，一式「定阳针」斜斜刺出。\n"NOR;

        //if( !target->is_killing(me) ) target->kill_ob(me);

        if (random(me->query_skill("force")) > target->query_skill("force")/2 )
        {
                
                damage = (int)me->query_skill("quanzhen-jian", 1) + (int)me->query_skill("force",1);
                //(全真剑法级别+基本内功) 
                        
                damage = damage/2 + random(damage/2);
                
                target->receive_damage("qi", damage);
                target->start_busy(6);
                me->start_busy(3);
                me->add("neili", -100);
                
                msg += NOR"$n看到$N这气拔千钧的一击，竟不知如何招架！\n"NOR;
                msg += HIW"结果剑气透入$n的〖"+name+HIW"〗$n狂叫一声，竟然全身不听使唤了。\n"NOR;
                msg += NOR"( $n"+HIY+"受伤不轻，看起来状况并不太好。"+NOR" )\n"NOR;
                
        }
        else 
        {
                me->start_busy(3);
                msg += CYN"可是$p看破了$P的企图，斜跃避开。\n"NOR;
        }
        message_vision(msg, me, target);

        return 1;
}

