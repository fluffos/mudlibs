//create for 大唐西游2 by huarong 2003/12
//◆风◆起◆云◆涌◆
//◆锋◆芒◆毕◆露◆
//◆流◆光◆溢◆彩◆
//◆石◆破◆天◆惊◆
//◆纵◆横◆四◆海◆
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string *zongheng= ({
BLU+"\n▂▃▄▅▆▇█"+BLINK+HIY+HBBLU+"风起云涌"+NOR+BLU+"█▇▆▅▄▃▂"NOR,
YEL+"\n▂▃▄▅▆▇█"+BLINK+HIB+HBYEL+"锋芒毕露"+NOR+YEL+"█▇▆▅▄▃▂"NOR,
MAG+"\n▂▃▄▅▆▇█"+BLINK+HIG+HBMAG+"流光溢彩"+NOR+MAG+"█▇▆▅▄▃▂"NOR,
RED+"\n▂▃▄▅▆▇█"+BLINK+HIC+HBRED+"石破天惊"+NOR+RED+"█▇▆▅▄▃▂"NOR,
HIW+"\n▂▃▄▅▆▇█"+BLINK+HIR+HBWHT+"纵横四海"+NOR+HIW+"█▇▆▅▄▃▂"NOR,
});
string query_name() { return "纵横"ZJBR"天下"; }
int perform(object me, object target)
{
        string msg;
        int i,t,mywx,youwx,lmt,skill,myskill;
        object weapon,ob;
        if( !target ) target = offensive_target(me);
        weapon = me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
           return notify_fail("纵横天下只能在战斗中使用。\n");
if (!PFM_D->valid_family(me, "五庄观"))
           return notify_fail("五庄观才能使用。\n");
        if ((int)me->query_skill("fumo-zhang",1)<100)
            return notify_fail("你的伏魔杖修为等级还不够熟练！\n");
        if ((int)me->query_skill("staff",1)<100)
            return notify_fail("你的杖法修为还不够熟练！\n");
        if ((int)me->query_skill("zhenyuan-force",1)<100)
            return notify_fail("你的内功修为还不够熟练！\n");
        if(me->query_temp("zongheng_busy"))
            return notify_fail("「纵横天下」不是说用就能用的。\n");
        if((int)me->query("force") < 600 )
            return notify_fail("你的内力不够！\n");
        if((int)me->query("kee") < 300 )
            return notify_fail("你的气血不足，使用这招怕是有危险！\n");
        t = (int)me->query("force_factor");
        myskill = me->query_skill("fumo-zhang",1)/2+me->query_skill("staff",1)/2;
        msg = WHT"\n$N"+WHT+"眼露诡异的神色，聆神观察着$n"+WHT+"，双手紧握"+ weapon->name()+NOR+WHT+"，一线杀机已然在眼中闪动！\n\n" NOR;
        message_vision(msg, me, target);
       mywx = me->query("combat_exp");
       youwx = target->query("combat_exp");
       lmt = (me->query_skill("fumo-zhang",1)+me->query_skill("staff",1))/100-1;
       if (lmt<0) lmt=0;
       if (lmt>5) lmt=5;
     if( random(mywx+youwx) > youwx/2 )
      {
            msg = MAG "\n$n"+MAG+"被这漫天的杀气所摄,不禁目瞪口呆,一时间，身体竟然无法动弹！\n"NOR;
            target->start_busy(2+random(2));
            message_vision(msg, me, target);
            msg = MAG "\n$N"+MAG+"身型闪动，地面随之起伏一降狂风，手中"+ weapon->name()+ MAG+"也有如狂风暴雨般地向$n"+MAG+"砸来！\n"NOR;
            message_vision(msg, me, target);
            target->add_temp("apply/dodge",-myskill);
            target->add_temp("apply/parry",-myskill);
         if( lmt>0 )
          {
            for(i=1;i<=lmt;i++)
            {
             message_vision(zongheng[i-1], me, target);
             COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
            }
          }
               me->start_busy(1);
               me->add("force",-50-t);
               target->add_temp("apply/dodge",myskill);
               target->add_temp("apply/parry",myskill);
        }
      else
       {
            msg = HIY "\n$n"+HIY+"轻轻的一笑，对$N"+HIY+"耻笑道：“你吓唬谁啊！”$N"+HIY"的杀气立马就消失了。\n"NOR;
            message_vision(msg, me, target);
            me->start_busy(2);
            me->add("force",-50-t);
        }
              me->set_temp("zongheng_busy",1);
              call_out("remove_effect",random(2)+5,me);
     if( !target->is_fighting(me) )
         {
                if( living(target) )
                 {
                  if( userp(target) ) target->fight_ob(me);
                  else target->kill_ob(me);
                 }
         }

        return 1;
}

int remove_effect(object me)
 {
  if (!me) return 0;
    me->delete_temp("zongheng_busy");
 }

