/*
晓风残月剑    dodge  -10    parry  0    damage  20
此剑法用意高妙，轻巧潇洒，剑中颇含诗意，多为江湖
年少所喜。
*/

// 皓月当空，水银泄地，花明月暗，清雨朦胧
// 飞花似梦，丝雨如愁，潇湘夜雨，月白风清
// 金波低转

inherit SKILL;
#include <ansi.h>

string *sound= ({
HIG"\n箫声似春风，似夏雨，似秋夜，又似冬雪。"NOR,
HIW"\n萧声音细而高，一片欢悦之音，如爱侣同行，喁喁私语。"NOR,
HIR"\n萧声倏变，有如楚客悲歌，长亭泣别。"NOR,
HIY"\n萧音调越来越苦，竟然充满了生离死别之恨，征人怨妇之伤。"NOR,
HIB"\n萧声悠悠传来，音韵婴搞，悠扬顿挫。"NOR,
MAG"\n萧声轻若游丝，悦耳柔和，正如“间关莺语花底滑，幽咽流泉冰下滩。”"NOR,
YEL"\n不知不觉间$n"+YEL+"已受那萧声感染，两行泪珠，夺眶而出！"NOR,
RED+BYEL+"\n萧声百转回肠，刚时杀气腾腾，柔时凄然落泪，激荡在空气中。"NOR,
YEL+BRED+"\n一缕萧声，袅袅破空而起，音调十分悲凄。"NOR,
});

mapping *action = ({
   ([   "name":        "皓月当空",
     "action":
"$N轻飘飘地纵身跃起，手中$w连续划出几个光环，向$n的$l圈去",
     "dodge":     -15,
     "parry":     10,
     "damage":     20,
     "damage_type":     "割伤"
   ]),
   ([   "name":        "水银泄地",
     "action":
"$N双脚一顿，笔直跃起，手中$w不停地颤抖着，\n"
"笼罩住$n全身。这势"+HIY+"「水银泄地」"+NOR+"果然是无孔不入",
     "dodge":     -5,
     "parry":     -10,
     "damage":     35,
     "damage_type":     "刺伤"
   ]),
   ([   "name":        "花明月暗",
     "action":
"$N手中$w带起点点寒光，指向$n前胸穴道。$n正专心致志地对付着剑招，\n"
"不料$N左手运力拍向$n的$l。这势"+HIY+"「花明月暗」"+NOR+"亦真亦幻，实是难防",
     "dodge":     -5,
     "parry":     -5,
     "damage":     45,
     "damage_type":     "震伤"
   ]),
   ([   "name":        "清雨朦胧",
     "action":
"$N在$n四周游走，手中$w去势飘忽不定，只看得$n眼花缭乱。\n"
"趁此良机，$N于朦朦胧胧中一抖$w，向$n的$l疾挑",
     "dodge":     -15,
     "parry":     5,
     "damage":     45,
     "damage_type":     "刺伤"
   ]),
   ([   "name":        "飞花似梦",
     "action":
"激战中，$N从$n面前斜斜跃过，手中$w划出五朵桃花，点向$n的$l",
     "dodge":     -5,
     "parry":     0,
     "damage":     35,
     "damage_type":     "刺伤"
   ]),
   ([   "name":        "丝雨如愁",
     "action":
"$N展开身形，$w之攻势绵绵不绝地缠向$n的$l。\n"
"诗云：无边丝雨细如愁。$N的这招果然深得诗中三味",
     "dodge":     -20,
     "parry":     10,
     "damage":     40,
     "damage_type":     "割伤"
   ]),
   ([   "name":        "潇湘夜雨",
     "action":
"$N仗起手中$w，带出点点寒光，罩住$n的胸腹，只等$n的破绽。\n"
"这招"+HIY+"「潇湘夜雨」"+NOR+"直如细雨般紧密，$n实在不知$w将要指向自己身上何处",
     "dodge":     -5,
     "parry":     -10,
     "damage":     40,
     "damage_type":     "刺伤"
   ]),
   ([   "name":        "月白风清",
     "action":
"$N手中$w中宫直进，疾速刺向$n的前心。\n"
"这招"+HIY+"「月白风清」"+NOR+"令人耳目一新。$n只觉浑身一紧，$w已刺到了$l",
     "dodge":     -15,
     "parry":     15,
     "damage":     45,
     "damage_type":     "刺伤"
   ]),
   ([   "name":        "金波低转",
     "action":
"$N手中$w向$n的右手疾刺，但正当$n要招架时，\n"
"$w却突然转向了$n的左足！这招"+HIY+"「金波低转」"+NOR+"确实神鬼莫测",
     "dodge":     -5,
     "parry":     -15,
     "damage":     45,
     "damage_type":     "刺伤"
   ]),
([ "name": "花前月下",
   "action":
HIC"$N一招"+HIM+"「花前月下」"+HIC+",左剑自上而下搏击,模拟冰轮横空,清光铺地的光景.\n"
"右剑却是不住颤动,如鲜花招展风中,来回挥削,只晃得$n"+HIC+"眼花撩乱。"NOR,
    "dodge": -80,
    "parry": -90,
     "damage": 50,
     "force" : 80,
    "damage_type": "刺伤"
]),
});
int valid_learn(object me)
{
   object ob;
// if( (string)me->query("gender") !="男性")
//  return notify_fail("晓风残月剑只有男子才能学习!!\n");
   if( (int)me->query("max_force") < 50 )
     return notify_fail("你的内力修为不够深，晓风残月剑学了也没用。\n");
   if (!(ob = me->query_temp("weapon"))
      || (string)ob->query("skill_type") != "sword" )
     return notify_fail("你必须先找一柄剑才能练习剑法。\n");
   return 1;
}

int practice_skill(object me)
{
   int dod=(int)me->query_skill("dodge");
   int swo=(int)me->query_skill("xiaofeng-sword");
if (dod<swo/2)
     return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
   if ((int)me->query("kee") < 30)
     return notify_fail("你体质欠佳，强练晓风残月风剑有害无益。\n");
   if ((int)me->query("force") < 5)
     return notify_fail("你内力不足，强练晓风残月风剑有走火入魔的危险。\n");
   me->receive_damage("kee", 30);
   me->add("force", -5);
   tell_object(me,HIC"今宵酒醒何处？杨柳岸晓风残月。\n"NOR);
   return 1;
}

mapping query_action(object me, object weapon)
{
     int i;
     i=me->query_temp("XFJ_perform");
  if ( me->query_temp("XFJ_perform")) 
       {
        return action[i];
	}
	return action[random(8)];
}

int valid_enable(string usage)
{
   return usage=="sword"||usage=="parry";
}

string perform_action_file(string func)
{
return __DIR__"xiaofeng-sword/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
       object weapon = me->query_temp("weapon");     
       string msg;
       int skill=me->query_skill("zouxiao",1);
       int damage;
       if( ( damage_bonus < 50 ) && (userp(me))) 
             return 0;
       if(me->query("force")<200) 
             return 0;
       if ((string)me->query("family/family_name") != "五庄观" )
             return 0;
       if (!me->query_temp("xiao_auto")) 
             return 0;
       
       damage=damage_bonus/2+skill*2-180;  
       if ( (int)me->query_skill("force", 1) > random((int)victim->query_skill("force", 1)))
             {
              message_vision(sound[random(sizeof(sound))], me, victim);
                switch(random(3))
                    {
                        case 0:{ victim->receive_damage("sen",damage);
                                 msg = HIW+"$n"+HIW+"不知不觉被扰乱了心神！\n"NOR;
                                 victim->start_busy(1+random(1));
                                 break;};
                                
                        case 1:{
                        	  victim->receive_damage("kee",damage*2);
                        	  victim->receive_wound("kee",random(damage/2)+damage/2);
                                  msg = HIM"$n"+HIM+"被$N"+HIM+"的萧声所打动，以至眼泪涟涟！\n"NOR;
                                 break;};
                                
                        case 2:{
                        	  victim->receive_damage("kee",damage);
                                  victim->receive_damage("sen",damage);
                        	  victim->receive_wound("kee",random(damage/2)+damage/2);
                                  victim->receive_wound("sen",random(damage/2)+damage/2);
                                 msg =HIY"$n"+HIY+"忽闻萧声像水一样幽幽地漫进自己耳内！\n"NOR;
                                 break;};
                    };
	      if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
             }
             return msg;
 }
