//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "无边"ZJBR"地狱"; }
int perform(object me, object target)
{
 string msg;
 int extra,lvl;
 int i;
 object weapon;

 if( !target ) target = offensive_target(me);
 if( !target
 || !target->is_character()
 || !me->is_fighting(target) )
        return notify_fail("无边地狱只能对战斗中的对手使用。\n");
 if(me->query("family/family_name")!="陷空山无底洞")
        return notify_fail("“无边地狱”只有无底洞门人才可以用！\n");
 weapon = me->query_temp("weapon");
 if( (string)weapon->query("skill_type") != "blade" )
        return notify_fail("你手上无刀，不能使用无边地狱！\n");
 if( (int)me->query("force") <= 1000 )
        return notify_fail("你内力不够，不能使用无边地狱！\n");
 if( (int)me->query_skill("kugu-blade", 1) < 120 )
        return notify_fail("你的枯骨刀修为不够深，还使不出这一招！\n");
 if( (int)me->query_skill("blade", 1) < 120 )
        return notify_fail("你的基本刀法修为不够深，还使不出这一招！\n");
 if( time()-(int)me->query_temp("diyu_end") < 5 )
       return notify_fail("绝招用多就不灵了！\n");

// extra = (int)me->query_skill("blade",1)/2+(int)me->query_skill("kugu-blade",1)/2;
 extra = (int)me->query_skill("blade",1)+(int)me->query_skill("kugu-blade",1);
  if (userp(me)) {
 target->add_temp("apply/parry",-extra);
 target->add_temp("apply/dodge",-extra);
 me->add_temp("apply/damage",extra);
 me->add_temp("apply/attack",extra);
  }

 me->set_temp("wddpfm",1); //这里禁止zxzx的效果，见combatd.c   huarong 2003.12
 msg = HIW"\n$N"+HIW+"刀光连闪，$n"+HIW+"周围鬼哭神号，恰似无边地狱！\n\n" NOR;
 message_vision(msg, me, target);
 lvl=extra/30;
 if(lvl>9) lvl =9;
for(i=1;i<=lvl;i++)
 {
 if( ! target ) return 1;
 msg = HIY "$N"+HIY+"劈出一刀！" NOR;
 message_vision(msg,me,target);
 COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR);
}
 if((target->query("eff_kee")<0 || !living(target)) )
 {
    if (random(10)>7)
   {
  msg=target->name()+"被"+me->name()+"用"NOR+BLINK""+HIR"「无边地狱」"NOR+HIM"一刀一刀活活割死了。"NOR+HIW"听说尸体上血肉模糊，惨不忍睹！";
      message("channel:rumor",HIM"【空穴来风】某人："+msg+"\n"NOR,users());
     }
} else {
  if (userp(me)) {
 target->add_temp("apply/dodge",extra);
 target->add_temp("apply/parry",extra);
    }
  }
  if (userp(me)) {
 me->add_temp("apply/damage",-extra);
 me->add_temp("apply/attack",-extra);
  }
 me->add("force", -extra/2);
// me->start_busy(1+random(1));
 me->set_temp("diyu_end",time());
 me->delete_temp("wddpfm");
 return 1;
}

