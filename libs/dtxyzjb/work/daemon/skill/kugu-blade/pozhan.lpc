//Cracked by Roath
// pozhan.c             破绽百出
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>

inherit SSERVER;
string query_name() { return "破绽"ZJBR"百出"; }
int perform(object me, object target)
{
        string msg;
       int delay, myblade,t;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("不在战斗中，露什么破绽？\n");
        if(me->query("family/family_name")!="陷空山无底洞")
              return notify_fail("“破绽”只有无底洞门人才可以用！\n");

        myblade=(int)me->query_skill("kugu-blade",1);
        if(myblade>210) myblade=210; // mon 12/7/98
        if(myblade<90)
                return notify_fail("你的修为不够深，露破绽给人太危险了。\n");
        if( (int)me->query("force") <= 300 )
                return notify_fail("你内力不够，不能使用无边地狱！\n");

       delay=myblade/30;
       if( time()-(int)me->query_temp("pozhan_end") < 5 )
              return notify_fail("绝招用多就不灵了！\n");

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

        msg = CYN "$N"+CYN+"的招式突然一变，变得全无章法，浑身上下破绽百出，\n";
        //change totoal random to half random half ur own value to make the sucessrate more stable
        t=random(me->query("combat_exp"));
        if(t/2 + me->query("combat_exp")/4 > (int)target->query("combat_exp")*3/8 )//mudbug on 2003/3/10
          {
               msg += "$n"+CYN+"想攻，却不知道哪个破绽是真，哪个是假。\n";
               msg += "结果$p"+CYN+"被$P"+CYN+"攻了个措手不及！\n" NOR;
               target->start_busy((1+delay*t/me->query("combat_exp")>2)?(1+delay*t/me->query("combat_exp")):3);//mudbug on 2003/3/10
           }
        else
          {
                msg += "可是$p"+CYN+"看破了$P"+CYN+"的企图，并没有上当。\n" NOR;
				 me->start_busy(2+random(1));
           }
        message_vision(msg, me, target);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
                me->kill_ob(target);
        }
       me->receive_damage("sen", 50);
       me->add("force", -150);
        me->receive_damage("kee", 50);
       me->set_temp("pozhan_end",time());

        return 1;
}

