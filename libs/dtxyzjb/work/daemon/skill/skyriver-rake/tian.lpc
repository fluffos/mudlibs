//huarong 2003.8
#include <ansi.h>

inherit SSERVER;
string query_name() { return "天河"ZJBR"一钯"; }
int perform(object me, object target)
{
        object weapon;
        string msg,str;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"+HIW+"『天河一钯』"+NOR+"？\n");

        if(!me->is_fighting())
                return notify_fail(HIW+"『天河一钯』"+NOR+"只能在战斗中使用！\n");

        if( time()-(int)me->query_temp("tianhe_end") < 5 )
          return notify_fail("绝招用多就不灵了！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if((int)me->query_skill("skyriver-rake", 1) < 100)
                return notify_fail("你的天河钯法级别还不够，使用这一招会有困难！\n");

        me->delete("env/brief_message");

message_vision(HIB"$N"+HIB+"挥着钉钯，高高跳起，仰天大喝："+RANK_D->query_rude(target)+HIB+"吃俺一钯吧！\n"NOR,me);
message_vision(HIW+"        )))))    银      (((((                          \n"NOR, me);
message_vision(HIW+"          (((((             )))))                       \n"NOR, me);
message_vision(HIC+"             )))))    河      (((((                     \n"NOR, me);
message_vision(HIC+"               (((((             )))))                  \n"NOR, me);
message_vision(HIY+"                  )))))    落      (((((                \n"NOR, me);
message_vision(HIY+"                    (((((             )))))             \n"NOR, me);
message_vision(HIG+"                       )))))    九      (((((           \n"NOR, me);
message_vision(HIG+"                         (((((             )))))        \n"NOR, me);
message_vision(HIR+"                            )))))    天      (((((      \n"NOR, me);
message_vision(HIR+"                              (((((             )))))   \n"NOR, me);


        me->set_temp("tianhe", 8);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->delete_temp("tianhe");

        me->receive_damage("kee", 200);
        me->add("force", -200);
    if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
                       {str=target->name()+HIM"被"+me->name()+"用天河钯法之绝学"NOR+HIW"「天河一钯」"+HIM"筑死了，据说尸体上有九个深深的血窟窿！";
                         message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                       }
    me->reset_action();
    me->set_temp("tianhe_end",time());
        return 1;
}


