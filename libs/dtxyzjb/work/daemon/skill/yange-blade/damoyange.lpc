//vikee
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void damoyange_ok(object);
string query_name() { return "大漠"ZJBR"雁歌"; }
int perform(object me, object target)
{       int skill,i,j;
	 skill = (int)me->query_skill("blade",1)/2+(int)me->query_skill("yange-blade",1)/2;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「大漠雁歌」？\n");
         if(me->query("family/family_name") != "五庄观" )
                return notify_fail("你是哪儿偷学来的武功，也想用「大漠雁歌」?\n");

        if(!me->is_fighting())
                return notify_fail("「大漠雁歌」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

	 if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("blade", 1) < 100)
                return notify_fail("你的基本刀法级别还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("yange-blade", 1) < 100)
                return notify_fail("你的雁歌刀法级别还不够，使用这一招会有困难！\n");

        if (me->query_skill_mapped("force")!="zhenyuan-force")
                return notify_fail("大漠雁歌必须配合镇元神功才能使用。\n");


        if (me->query_temp("damoyange_busy"))
                return notify_fail("绝招滥使就不灵了！\n");

        me->delete("env/brief_message");
	 target->delete("env/brief_message");

        message_vision(HIR"\n$N"+HIR+"大喝一声,只见飞沙走石，大雁南行,"+HIY+"「大漠雁歌」"+HIR+"一招一气呵成!\n"NOR,me,target);

        target->add_temp("apply/dodge",-skill/2);
        target->add_temp("apply/parry",-skill/2);
        j=skill/50;
        if(j>8) j=8;
        me->set_temp("damoyange_pfm",1);
        for (i=1;i<=j;i++)
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("damoyange_pfm",1);

        target->add_temp("apply/dodge",skill/2);
        target->add_temp("apply/parry",skill/2);

        me->receive_damage("sen", 100);
        me->add("force", -100-skill/3);
        me->set_temp("damoyange_busy",1);
        call_out("damoyange_ok",5+random(2),me);


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
          me->start_busy(1+random(2));

        return 1;
}

void damoyange_ok(object me)
{ if (!me) return;
      me->delete_temp("damoyange_busy");
}
