//edit by yesi
//lestat modi for hell
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
inherit SSERVER;
string query_name() { return "神·人·鬼"; }
int perform(object me, object target)
{
  object weapon;
  int skill, i, j, k, m, n;
  string str;
  if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「神·人·鬼」？\n");
        if(me->query("family/family_name") != "阎罗地府")
                return notify_fail(HIG"「神·人·鬼」"+NOR"是冥界不传之密！\n");
        if(!me->is_fighting())
                return notify_fail("「神·人·鬼」只能在战斗中使用！\n");
        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");
        if( time()-(int)me->query_temp("three_end") < 6 )
          return notify_fail("绝招用多就不灵了！\n");
        if((int)me->query_skill("kusang-bang", 1) < 150)
                return notify_fail("你的哭丧棒级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("hellfire-whip", 1) < 150)
                return notify_fail("你的烈火鞭级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("jinghun-zhang", 1) < 150)
                return notify_fail("你的惊魂掌级别还不够，使用这一招会有困难！\n");
        if (me->query_skill_mapped("unarmed")!="jinghun-zhang")
                return notify_fail("「神·人·鬼」必须配合惊魂掌才能使用。\n");
        if (me->query_skill_mapped("stick")!="kusang-bang")
                return notify_fail("「神·人·鬼」必须配合苦丧棒才能使用。\n");

        skill = (int)me->query_skill("hellfire-whip",1)+(int)me->query_skill("kusang-bang",1)+(int)me->query_skill("jinghun-zhang",1);

    me->set_temp("hell_pfm",1);
    weapon=me->query_temp("weapon");
    target->add_temp("apply/dodge",-skill);
    target->add_temp("apply/parry",-skill);

    message_vision(HIW"\n$N"+HIW+"双手划一大圆，猛然托天而举，伴着天上雷鸣电闪，祭出了「神·人·鬼」三招。\n"NOR,me,target);
//出鞭
    message_vision(HIB"\n四周磷光点点，$N"+HIB+"舞动"+weapon->name()+NOR+HIB"，咯咯一笑，扑向$n。\n"NOR,me,target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    seteuid(getuid());
//出掌
    me->set("actions", (: call_other, SKILL_D("jinghun-zhang"), "query_action" :) );
    weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
    weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
    weapon->set("use_apply_skill",1);
    weapon->set("apply/skill_type","unarmed");
    message_vision(HIB"\n但见幢幢鬼影四周飘浮，突然$N"+HIB+"鬼唱一声，无数鬼手抓向$n。\n"NOR, me,target);
    COMBAT_D->do_attack(me, target);
//出棍
    message_vision(HIB"\n$N"+HIB+"双手一抖，手中"+weapon->name()+NOR+HIB"顿时变的笔直，如同一根铁棍。\n"NOR,me);
    seteuid(getuid());
    me->set("actions", (: call_other, SKILL_D("kusang-bang"), "query_action" :) );
    weapon->set("use_apply_skill",1);
    weapon->set("apply/skill_type","stick");
    COMBAT_D->do_attack(me, target,weapon);
    weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
    weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
//出剑
    j=(int)me->query_skill("hellfire-whip", 1);
    k=(int)me->query_skill("kusang-bang", 1);
    m=(int)me->query_skill("jinghun-zhang", 1);
    n=(int)me->query_skill("zhuihun-sword", 1);
    i=j+k+m+n;
    if (i > 800 && n > 200 && me->query_skill_mapped("sword")=="zhuihun-sword" && userp(me)) {
    message_vision(HIB"\n$N"+HIB+"反震手中的"+weapon->name()+NOR+HIB"，原来的铁棍居然生出双刃，变成了一柄长剑。\n"NOR,me);
    seteuid(getuid());
    me->set("actions", (: call_other, SKILL_D("zhuihun-sword"), "query_action" :) );
    me->add_temp("apply/damage",i/4);
    me->add_temp("apply/attack",i/4);
    me->set_temp("threeend",1);
    weapon->set("use_apply_skill",1);
    weapon->set("apply/skill_type","sword");
    COMBAT_D->do_attack(me, target,weapon);
    me->add_temp("apply/damage",-i/4);
    me->add_temp("apply/attack",-i/4);
    me->delete_temp("threeend");
    weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
    weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
    }
    me->reset_action();
    if ( target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  {
       str=target->name()+HIM"被"+me->name()+HIM+"用幽冥绝学"NOR+HIB"「神·人·鬼」"+HIM"打死了，尸体面色狰狞可怖，似被恶鬼缠身！";
         message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
        }
   me->add("force", -100-skill/9);
   me->set_temp("three_end",time());
   me->delete_temp("hell_pfm");
   target->add_temp("apply/dodge",skill);
   target->add_temp("apply/parry",skill);
   return 1;
}
