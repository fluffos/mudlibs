//Cracked by huarong for dtxy2004 2004/2
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "绝命锏"; }
int perform(object me,object target)
{
        string msg;
        object weapon;
        int skill, skill1, skill2;

        skill = me->query_skill("lengquan-force",1);
        skill1 = me->query_skill("wusi-mace",1);
        skill2 = me->query_skill("dodge",1);
       if( !target ) target = offensive_target(me);
       if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［绝命锏］只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "mace")
           return notify_fail("你没用锏，不能使用「绝命锏」！\n");

        if( me->query("str") < 22 )
            return notify_fail("你的先天膂力孱弱, 不能使用「绝命锏」！\n");

        if(me->query("family/family_name") != "将军府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「绝命锏」！\n");


        if( !(me->is_fighting() ))
            return notify_fail("「绝命锏」只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("wusi-mace", 1) < 200
          ||(int)me->query_skill("mace", 1) < 200 )
                return notify_fail("你的锏法不够娴熟，不能使用「绝命锏」。\n");

        if( (int)me->query_skill("lengquan-force", 1) < 180 )
                return notify_fail("你的冷泉心法还差些火候。\n");

        if( me->query("force") < 1500 )
                return notify_fail("你的内力不够，无法运用「绝命锏」！\n");

       if( time()-(int)me->query_temp("jueming_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        skill = (int)me->query_skill("lengquan-force", 1)+(int)me->query_skill("wusi-mace", 1)+(int)me->query_skill("mace", 1);
        me->delete("env/brief_message");
        target->delete("env/brief_message");
        msg = HIC "$N"+HIC+"手中"+weapon->name()+HIC+"青光绽放，气吞山河!\n"NOR;
        message_vision(msg, me, target);

        me->set_temp("wusi_pfm",8);
        COMBAT_D->do_attack(me,target, weapon);
        me->set_temp("wusi_pfm",9);
        COMBAT_D->do_attack(me,target, weapon);
        me->set_temp("wusi_pfm",10);
        COMBAT_D->do_attack(me,target, weapon);
        me->delete_temp("wusi_pfm");

        me->start_busy(1+random(1));
        me->add("force",-100-skill/6);
        me->set_temp("jueming_end",time());
        return 1;
}
