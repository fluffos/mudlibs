//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "麟生"ZJBR"雾彩"; }
int perform(object me, object target)
{
        string msg;
        int extra,i,lmt;
        object weapon;

       if( !target ) target = offensive_target(me);
       if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［麟生雾彩］只能对战斗中的对手使用。\n");

        extra = me->query_skill("huntian-jian",1)/10+me->query_skill("sword",1)/10;
        if ( extra < 20) return notify_fail("你的混天一剑与基本剑法还不够等级！\n");

        if(me->query("family/family_name")!="昆仑山玉虚洞")
                return notify_fail("只有昆仑山玉虚洞门人才可以用[麟生雾彩]！\n");

        if(me->query_skill("xuanzong-force",1) < 100)
        return notify_fail("你的玄宗心法还欠火候，怕是使保护出 [麟生雾彩]。\n");

        if((string)me->query_skill_mapped("force")!="xuanzong-force")
        return notify_fail("麟生雾彩必须以麟生雾彩玄宗心法为底子。\n");

        if(me->query("max_force") < 1000)
        return notify_fail("你的内力不够。\n");
        if(me->query("force") < 500)
        return notify_fail("你的内力不足。\n");

        if( time()-(int)me->query_temp("lin_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        weapon = me->query_temp("weapon");
        me->delete("env/brief_message");
        target->delete("env/brief_message");

        msg = HIY  "\n$N"+HIY+"双手持剑，平地随之升起一团彩雾，手中"+ weapon->name()+  HIY "也有如狂漫天飞雨般地向$n"+HIY"卷来！ "NOR+" \n"

          HIR"--------------"+HIY"手中一招 "+HIC"[麟生雾彩] "HIY+"转眼而出"HIR+"-----------------"NOR;

        message_vision(msg,me,target);

        target->add_temp("apply/dodge",-extra*10);
        target->add_temp("apply/parry",-extra*12);
        lmt=extra/10;
        if (lmt>5) lmt=5;
        for(i=1;i<=lmt;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        }
        target->add_temp("apply/dodge",extra*10);
        target->add_temp("apply/parry",extra*12);
        me->add("force",-50-extra*3);
        me->start_busy(1+random(2));
        me->set_temp("lin_end",time());
        return 1;
}
