//icefire  by huarong 2003.3
#include <ansi.h>
inherit SSERVER;
string query_name() { return HIW+"冰"+HIR+"火"+HIC+"诀"+NOR; }
int perform(object me, object target)
{
        int damage,ap,dp,extra,skill;
        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「"+HIW+"冰"+HIR+"火"+HIC+"诀"+NOR+"」只能对战斗中的对手使用。\n");
        if(me->query("family/family_name")!="三界散仙")
              return notify_fail("你忽冷忽热，开始发羊癫疯。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用「"+HIW+"冰"+HIR+"火"+HIC+"诀"+NOR+"」！\n");

       if( (int)me->query_skill("ice_fire_zhang", 1) < 100 )
                return notify_fail("你的玄冰烈焰掌不够级别，不会使用「"+HIW+"冰"+HIR+"火"+HIC+"诀"+NOR+"」！\n");

        if( (int)me->query("force", 1) < 300 )
                return notify_fail("你现在内力太弱，不能使用「"+HIW+"冰"+HIR+"火"+HIC+"诀"+NOR+"」！\n");

       if( time()-(int)me->query_temp("icefire_end") < 7 )
              return notify_fail("你刚用过冰火真气，气息尚未恢复！\n");

       ap = (int)me->query_skill("ice_fire_zhang",1) + (int)me->query_skill("unarmed",1);
       dp = (int)target->query_skill("parry",1) + (int)target->query_skill(target->query_skill_mapped("parry"),1);
       extra= (me->query_skill("ice_fire_zhang") + me->query_skill("unarmed"))/2;
       skill=(int)me->query_skill("butian-force",1)/2+ap/2;
       damage=skill/3+random(skill/3);

message_vision(HIC"\n只听$N"+HIC+"悄无声息，念动补天神诀,体内冰火之气已化成滔天\n"+NOR,me,target);
message_vision(HIC"巨浪,欲在$N与$n"+HIC+"接触之际,将两波真气欲送入$n"+HIC+"的体内！\n\n\n"+NOR,me,target);
if((random(me->query("combat_exp")) > (int)target->query("combat_exp")/4 )||(random(me->query("force")) >= target->query("force")/4))
   {
message_vision(HIY"$n"+HIY+"虽知对方必有重招，然其仗恃自己功力深厚，全无顾忌，\n"+NOR,me,target);
message_vision(HIY"仍以十成功力暴劈一掌过去...\n"+NOR,me,target);
message_vision(HIY"『轰！』的一声劲气交接的巨响，两人同时被震退！\n\n\n"+NOR,me,target);
message_vision(HIR"不料$N"+HIR+"在到退一半之际竟然全身剧震，经脉显然受到了$n"+HIR+"烈火\n"+NOR,target,me);
message_vision(HIR"真气的影响，全身经脉如同被烈火焚烧，劲力登时丧失了许多!\n\n"+NOR,me,target);
message_vision(HIR"$n"+HIR+"大骇之下，$N"+HIR+"趁机又递出一掌！\n\n"+NOR,me,target);
        target->add("force",-extra);//打 force  grin
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage,me);
         if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));

        me->set_temp("icefire_perform", 7);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("icefire_perform");
        me->add("force", -200);
   }
  else
  {
message_vision(HIG"$n"+HIG+"料$N"+HIG+"必有重招，身形一转，不于$N"+HIG+"对掌！\n\n\n"+NOR,me,target);
  }

message_vision(HIB"$n"+HIB+"默念补天神诀，顿时脸色刷白，右掌如玄冰,以迅雷不及眼耳之势拍向$N！\n\n\n"NOR,target,me);
if((random(me->query("combat_exp")) > (int)target->query("combat_exp")/4 )||(random(ap) > dp/4 ))
   {
message_vision(HIW"$n"+HIW+"躲闪不及，被拍了个正着！蓦地感觉身子一寒!\n"NOR,me,target);
message_vision(HIW"$n"+HIW+"急忙撤招，突然打了个冷战！原来$n"+HIW+"的身体早已伏上一层冰霜！\n"NOR,me,target);
message_vision(HIW"玄冰真气开始在$N"HIW"的体内乱窜，$N"HIW"全身经脉就如同被扭在一起，身行顿时慢了下来!\n\n"NOR,target,me);
message_vision(HIR"$N"+HIR+"阴笑一声，趁机又递出一掌！\n\n"+NOR,me,target);
        me->set_temp("icefire_perform", 8);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("icefire_perform");
if (!target->is_busy()) target->start_busy(3+random(2));
        me->start_busy(1+random(1));
   }
   else
   {
   message_vision(HIG"$n"+HIG+"料$N"+HIG+"必有重招，身形一转，避开了$N"+HIG+"的正面攻击！\n\n\n"+NOR,me,target);
    me->start_busy(1+random(2));
    }
         if (random(me->query("force",1)) > 4*target->query("force",1)/5 )
          {
            call_out("action2",0,me,target);
           }
    me->set_temp("icefire_end",time());
        return 1;
}

int action2(object me,object target)
   {
        if(target)
        {
        if(target->is_fighting(me))
        {

message_vision(HIM"正当$N"HIM"凭藉着本身真气将$n"HIM"这两重真气引入地上时，$n"HIM"的这两重真气却已经全无预兆的\n"NOR,target,me);
message_vision(HIM"合为一体侵入到$N"HIM"的精神之中，$N"HIM"顿时整个人一会像是进了炼丹炉，一会像是掉进了寒潭，难\n"NOR,target,me);
message_vision(HIM"受得要命，大脑似若不再听$N"HIM"的指挥，斗志大减!\n"NOR,target,me);
          me->set_temp("icefire_perform", 9);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("icefire_perform");

        }
        }
        return 1;
   }



