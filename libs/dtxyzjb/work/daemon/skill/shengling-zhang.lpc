inherit SKILL;

/*
圣灵杖法    dodge  2.5    parry  -6    damage  23
水月宫。
*/

mapping *action = ({
   ([   "action":     "$N一招「西疆斩风魔」将手里的$w花了了几个大圆，向$n旋了过去",
     "dodge":     15,
     "parry":     -5,
     "damage":     15,
     "damage_type":   "刮伤"
   ]),
   ([   "action":     "$N将$w往右手一摆，化出一招「东海杀雷神」向$n$l直扫了过去",
     "dodge":     0,
     "parry":     -15,
     "damage":     15,
     "damage_type":   "砸伤"
   ]),
   ([   "action":     "$N使出一招「南山收土妖」，高高跃起，手中的$w从上之下带出飞沙走石般的杖风压向$n的$l",
     "dodge":     5,
     "parry":     -5,
     "damage":     15,
     "damage_type":   "砸伤"
   ]),
   ([   "action":     "只见$N略一矮身，旋即一个大跨步，双手握住$w一招「北荒伏火怪」向$n$l挑去",
     "dodge":     5,
     "parry":     0,
     "damage":     20,
     "damage_type":   "刺伤"
   ]),
   ([   "action":     "$N横持$w，身体不住旋转，好一招「终以平水患」，$w带着一股旋风扫向$n的$l",
     "dodge":     -5,
     "parry":     0,
     "damage":     25,
     "damage_type":   "刺伤"
   ]),
   ([   "action":     "$N口中默念，身形晃动，脚踩凌波微步，手中$w毫不留情的使出绝招「大地久重生」攻向$n",
     "dodge":     -5,
     "parry":     -10,
     "damage":     35,
     "damage_type":   "砸伤"
   ]),
});

int valid_learn(object me)
{
   object ob;

   if( (int)me->query("max_force") < 100 )
     return notify_fail("你的内力不够，没有办法学圣灵杖法。\n");

   if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "staff" )
     return notify_fail("你必须先找一条杖才能学圣灵杖法。\n");

   return 1;
}

int valid_enable(string usage)
{
        return (usage=="staff")||(usage=="parry");
}

mapping query_action(object me, object weapon)
{
   return action[random(sizeof(action))];
}

int practice_skill(object me)
{
   if( (int)me->query("kee") < 30 || (int)me->query("force") < 5 )
     return notify_fail("你现在太累了，强练无益。\n");
   me->receive_damage("kee", 25);
   me->add("force", -5);
   write("你按着所学练了一遍伏魔杖。\n");
   return 1;
}
