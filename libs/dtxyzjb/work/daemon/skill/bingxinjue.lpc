// 水月宫spells 冰心决
inherit SKILL;

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
        if( 2*(int)me->query_skill("spells") <= (int)me->query_skill("bingxinjue") )
        return notify_fail("你只觉得全身寒气不能控制，无法学习「冰心决」。\n");
        return 1;
}

string cast_spell_file(string spell)
{
        return __DIR__"bingxinjue/"+spell;
}

string type() { return "magic"; } 
