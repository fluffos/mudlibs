//Cracked by Roath
//Jiz
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>

inherit SSERVER;
string query_name() { return "混元"ZJBR"一破"; }
int perform(object me, object target)
{
    object *inv, obj;
    int i, mypot,tapot,temp_dodge,temp_spells,damage;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「混元一破」？\n");
        if(me->query("family/family_name")!="东海龙宫")
                return notify_fail("非龙宫弟子不能用「混元一破」！\n");
        if(!me->is_fighting())
                return notify_fail("「混元一破」只能在战斗中使用！\n");

        if( time()-(int)me->query_temp("break_end") < 10 )
                return notify_fail("绝招用多就不灵了！\n");
        if((int)me->query("max_force") < 200 )
                return notify_fail("你的内力不够！\n");

     if((int)me->query("force") < 200 )
        return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("huntian-hammer", 1) < 60)
                return notify_fail("你的混天锤级别还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("hammer", 1) < 60)
                return notify_fail("你的基本锤法级别还不够，使用这一招会有困难！\n");

message_vision(HIC"\n$N"+HIC+"运足精神，大喝一声，对着$n"+HIC+"发出了全力一击！\n"NOR, me, target);

    mypot=(int)me->query_skill("hammer");
    mypot=mypot*mypot/10*mypot + (int)me->query("combat_exp");

    tapot=(int)target->query_skill("parry");
    tapot=tapot+(int)target->query_skill("dodge")/10;
    tapot=tapot*tapot/10*tapot + (int)target->query("combat_exp");

//  write("mypot " + mypot + ", tapot " +tapot+ "\n");

        damage=(int)me->query("max_force")/10+(int)me->query("force_factor");

   if( random( mypot+tapot ) > tapot )
     {

        inv = all_inventory(target);
        i = sizeof(inv);

       if ( i < 1 )
          {
        message_vision(HIR"$N"+HIR+"躲闪不及，被砸个正着！\n"NOR, target);
        target->receive_damage("kee",random(damage)+damage,me);
        COMBAT_D->report_status(target);
        }
      else
         {
       if(target->query_temp("armor")||target->query_temp("weapon"))
              {
         if( target->query_temp("armor") )
                 {
//             for (i=1; i < sizeof(inv); i++ )
                  i=random(sizeof(inv));
              obj = inv[i];
              if( obj->query("equipped") != "worn" ) i=i+1;
              if (i>sizeof(inv)) i=sizeof(inv);
                obj->unequip();
//自练法宝不能打断 huarong 2004/4/15
                       if (obj->query("changed"))
                        {
                          message_vision(HIW "只听见「当啷」地一声脆响，$N"+HIW+"身上的" + obj->name() + HIW+"光芒四射，铿然如初。\n" NOR,target,);
                         }
                       else if (obj->query("unbreak"))
                          {
                message_vision(HIW "只听见「嘶啦」地一声，$N"+HIW+"只觉得身上的" + obj->name() + HIW+"被撕开好几条大口子，差点报废。\n" NOR,target,);
                obj->set("durability/now",1);
                  }
                       else
                          {
                obj->set("value", 0);
                obj->set("No_Wear", 1);
                message_vision(HIY"$N"+HIY+"身上的$n"+HIY+"被打的粉碎！\n"NOR, target,obj);
                //here is added by vikee 2000-12-2 0:59
                //防止break后有效轻功和法术不消失.
                temp_dodge=(int)obj->query("armor_prop/dodge",1);
                temp_spells=(int)obj->query("armor_prop/spells",1);
                if (temp_dodge)
                target->add_temp("apply/dodge",-temp_dodge);
                if (temp_spells)
                target->add_temp("apply/spells",-temp_spells);

                obj->set("name", "破碎的"+obj->query("name"));
                call_out("remove_broken_cloth",random(300)+60,obj);
                obj->move(environment(target));
                }

        if (target->query_temp("weapon"))
                    {
            obj=target->query_temp("weapon");
            obj->unequip();
//自练法宝不能打断 huarong 2004/4/15
                       if (obj->query("changed"))
                        {
                          message_vision(HIW "只听见「当啷」地一声脆响，$N"+HIW+"身上的" + obj->name() + HIW+"银光闪烁，铿然如初。\n" NOR,target,);
                         }
            //此处修改，魔法物品不能被打断.wsw于2003年12月4日
                    else if (obj->query("unbreak"))
                        {
                message_vision(HIW "只听见「啪」地一声，$N"+HIW+"只觉得手中" + obj->name() + HIW+"被打得歪七扭八，差点报废。\n" NOR,target,);
                if (obj->query("id")!="eighteen weapon") obj->set("durability/now",1);
               }
                   else
                       {
                obj->set("value", 0);
                message_vision(HIW "只听见「啪」地一声，$N"+HIW+"手中的" + obj->name()+ HIW+"已经断为两截！\n" NOR, target);
                obj->set("name", "断掉的" + obj->query("name"));
                obj->set("weapon_prop", 0);
                        obj->set("armor_prop", 0);
                obj->move(environment(target));
                call_out("remove_broken_cloth",random(300)+60,obj);
                }
            }
//            target->delete_temp("armor");
//                  target->delete_temp("apply");
           }

                     target->receive_damage("kee",damage/2+random(damage));
                     COMBAT_D->report_status(target,0);
         }
               else
                 {
               message_vision(HIR"$N躲闪不及，被打个正着！\n"NOR, target);
                     target->receive_damage("kee",random(damage)+damage);
                     COMBAT_D->report_status(target,0);
               }
        }
     }
          else
          message_vision(HIC"却被$N躲开了！\n"NOR, target);
        me->add("force", -150);
    me->receive_damage("sen", 50);

    target->kill_ob(me);

       me->start_busy(2+random(1));
       me->set_temp("break_end",time());
       return 5+random(5);
}

void remove_broken_cloth(object obj)
{
  if(obj && environment(obj)) {
    tell_object(environment(obj),
      "一阵微风吹过，"+obj->name()+"化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}

