//vikee
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void fuchen_ok(object);
string query_name() { return "千丝"ZJBR"万缕"; }
int perform(object me, object target)
{       int skill,i,j;
         skill = (int)me->query_skill("whip",1)/2+(int)me->query_skill("wuwei-fuchen",1)/2;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「千丝万缕」？\n");
         if(me->query("family/family_name") != "三界散仙" )
                return notify_fail("你是哪儿偷学来的武功，也想用「千丝万缕」?\n");

        if(!me->is_fighting())
                return notify_fail("「千丝万缕」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

         if((int)me->query("force") < 200 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("whip", 1) < 60)
                return notify_fail("你的基本鞭法级别还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("wuwei-fuchen", 1) < 60)
                return notify_fail("你的无为拂尘级别还不够，使用这一招会有困难！\n");

        if (me->query_skill_mapped("force")!="butian-force")
                return notify_fail("千丝万缕必须配合补天心法才能使用。\n");


        if (me->query_temp("fuchen_busy"))
                return notify_fail("绝招滥使就不灵了！\n");

        me->delete("env/brief_message");
         target->delete("env/brief_message");

        message_vision(HIR"\n$N"+HIR+"大喝一声，拂尘一展，招式尤如疾风雷雨一气呵成!\n"NOR,me,target);

        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        me->set_temp("fuchen_auto_pfm",1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->delete_temp("fuchen_auto_pfm");

        me->receive_damage("sen", 100);
        me->add("force", -100-skill/3);
        me->set_temp("fuchen_busy",1);
        call_out("fuchen_ok",5+random(2),me);


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
          me->start_busy(1+random(2));

        return 1;
}

void fuchen_ok(object me)
{ if (!me) return;
      me->delete_temp("fuchen_busy");
}

