//Cracked by Roath
//evil...........2000.4.16
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string *fuhu= ({
BLU+"\n降龙伏虎－－"+BLINK+HIY+"☆降☆"+NOR+BLU+"－－"NOR,
YEL+"\n降龙伏虎－－"+BLINK+HIB+"☆龙☆"+NOR+YEL+"－－"NOR,
MAG+"\n降龙伏虎－－"+BLINK+HIG+"☆伏☆"+NOR+MAG+"－－"NOR,
RED+"\n降龙伏虎－－"+BLINK+HIC+"☆虎☆"+NOR+RED+"－－"NOR,
HIY+"\n降龙伏虎－－"+BLINK+HIW+"☆降☆龙☆伏☆虎☆"+NOR+HIW+"－－"NOR,
});
string query_name() { return "降龙"ZJBR"伏虎"; }
int perform(object me, object target)
{
        string msg;
        int extra,i,lmt,skill,myexp,hisexp,damage;
        object weapon;

       if( !target ) target = offensive_target(me);
       if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［降龙伏虎］只能对战斗中的对手使用。\n");

        extra = me->query_skill("force",1)/10+me->query_skill("staff",1)/10;
        skill=extra*10;
        if ( extra < 30) return notify_fail("你的轮回杖法与基本杖法还不够纯熟，怕是无法运用！\n");

        if(me->query_skill("lotusforce",1) < 150)
        return notify_fail("你的内功底子不足，无法运杖如风，施展不出降龙伏虎。\n");

        if((string)me->query_skill_mapped("force")!="lotusforce")
        return notify_fail("降龙伏虎必须以莲台心法为底子。\n");

        if( time()-(int)me->query_temp("fuhu_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        if(me->query("max_force") < 500)
        return notify_fail("你的内力不足，难以随意挥动一把禅杖。\n");

        weapon = me->query_temp("weapon");
	 myexp = (int)me->query("combat_exp");
	 hisexp= (int)target->query("combat_exp");
        damage=skill/2+random(skill/2);
        msg = HIY  "$N身型闪动，地面随之起伏一降狂风，手中"+ weapon->name()+  "也有如狂风暴雨般地向$n卷来！" NOR;

        message_vision(msg,me,target);

        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        lmt = 4;
        for(i=1;i<=lmt;i++)
        {
        message_vision(fuhu[i-1], me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        }
	  if(  random(myexp+hisexp) > hisexp )
           {
               message_vision(fuhu[4], me, target);
               message_vision(HIR "\n$n"+HIR+"躲闪不及，被打个正着！波的喷出一口鲜血！\n " NOR,me,target);
         	 target->receive_damage("kee",damage,me);
               target->receive_wound("kee",damage/2,me);
               if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
	        COMBAT_D->report_status(target);
            }
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->add("force",-100-skill/4);
        me->start_busy(1+random(2));
        me->set_temp("fuhu_end",time());
        return 1;
}



