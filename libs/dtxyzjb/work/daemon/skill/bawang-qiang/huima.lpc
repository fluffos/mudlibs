//create for 大唐西游2 by huarong 2004/2

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "回马枪"; }
int perform(object me, object target)
{
        object weapon;
        int myskill,times, damage,skill;
        string number;
	skill = (int)me->query_skill("spear",1)/2+(int)me->query_skill("bawang-qiang",1)/2;
        weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);


        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「回马枪」？\n");

        if(!me->is_fighting())
                return notify_fail("「回马枪」只能在战斗中使用！\n");

        if(me->query("family/family_name") != "将军府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「回马枪」?\n");

        if((int)me->query_skill("bawang-qiang", 1) < 100)
                 return notify_fail("你的霸王枪法级别还不够。\n");

        if((int)me->query_skill("lengquan-force", 1) < 100)
                 return notify_fail("你的冷泉神功级别还不够。\n");

        if((int)me->query_skill("spear", 1) < 100)
                return notify_fail("你的基本枪法级别还不够。\n");

        if((int)me->query("max_force") < 800 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 300 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展回马枪！\n");

       if( time()-(int)me->query_temp("huima_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");


        me->delete("env/brief_message");
	target->delete("env/brief_message");
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        me->set_temp("BWQ_perform",7);
        COMBAT_D->do_attack(me, target, weapon);
        me->delete_temp("BWQ_perform");
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);

        me->start_busy(1+random(2));
        me->set_temp("huima_end",time());
        me->add("force",-50-skill/4);
        me->receive_damage("sen", 50);
        return 1;
}

