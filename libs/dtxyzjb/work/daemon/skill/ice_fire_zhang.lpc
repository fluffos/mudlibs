        "dodge": -80,
        "parry": -80,
        "force": 35,
        "damage_type" : "冻伤",
]),
([      "action" : "$N清啸一声，左掌一式"+HIR+"「火焰刀」"+NOR+"，右手招展"+HIW+"「冰魄刀」"+NOR+"，两股截然不同的气劲击向$n的"+HIC+xue_name[random(sizeof(xue_name))]+NOR+"及"+HIC+xue_name[random(sizeof(xue_name))]+NOR,
       "dodge": -90,
        "parry": -90,
        "force": 40,
        "damage_type" : "瘀伤",
])
});

int valid_enable(string usage)
{
        return usage=="unarmed";
}

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail("练玄冰烈焰掌必须空手。\n");
    
    if ((int)me->query("max_force") < 400)
   return notify_fail("你的内力太弱，无法练玄冰烈焰掌");
    if( (string)me->query_skill_mapped("force")!= "butian-force")
    return notify_fail("你的内功心法不对无法练习。\n");
    return 1;
}


mapping query_action(object me, object weapon)
{
   int i;
   i=me->query_temp("icefire_perform");
   if( i<7 ) 
      {     i=random(7);
            me->set_temp("icefire_perform", i);
            return action[i]; 
            me->delete_temp("icefire_perform");
      }
   else 
   {
     return action[i];
    }
}

int practice_skill(object me)
{       string msg;
        object target;
        if ((int)me->query("kee")<30)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("force") < 40)
                return notify_fail("你的内力不够练玄冰烈焰掌。\n");
        me->receive_damage("kee",50);
        me->add("force",-30);
        message_vision(icefire[random(sizeof(icefire))], me, target);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        if( me->query_skill("ice_fire_zhang") > 150)
        victim->apply_condition("ice_fire_poison", random(me->query_skill("ice_fire_zhang")/10) + 5 );
        if( damage_bonus >60 )
        {
        if( random(damage_bonus/2) > (victim->query_str()/5))
             {
                victim->receive_wound("kee", (damage_bonus - 60) / 4 );
                if (me->query_temp("icefire_perform")<=3)  return HIW"$N"+HIW+"寒劲一催，一道凛冽劲气击中$n"+HIW+"的$l！\n"NOR;
                if (me->query_temp("icefire_perform")>3&&me->query_temp("icefire_perform")<=6)  return HIR"$n"+HIR+"的$l被$N"+HIR+"催动的火焰刀烧得血肉模糊！\n"NOR;
                if (me->query_temp("icefire_perform")==7)  return HIR"$n"+HIR+"的$l被$N"+HIR+"催动的火焰刀烧得血肉模糊！\n"NOR;
                if (me->query_temp("icefire_perform")==8)  return HIW"$N"+HIW+"寒劲一催，一道凛冽劲气击中$n"+HIW+"的$l！\n"NOR;
                if (me->query_temp("icefire_perform")==9)  return HIB"$N"+HIB+"左手之"+HIR+"「烈火真气」"+HIB+"，右手之"+HIW+"「玄冰真气」"+HIB+"，两道截然不同的内劲全在$n"+HIB+"体内爆发！\n"NOR;
                                   
             }
        if( random(3*(me->query_skill("ice_fire_zhang"))) > 2*damage_bonus)
        {
                     victim->receive_wound("sen", damage_bonus);
                     return HIB"$n"+HIB+"觉得浑身空荡荡的，元神涣散，顶上三花黯然无光！\n"NOR;
        }
}
       }

string perform_action_file(string func)
{
       return __DIR__"ice_fire_zhang/" + func;
}

void skill_improved(object me)
{
        if( (string)me->query("family/family_name")!="三界散仙")
        {
                tell_object(me,
                        HIW "\n你控制不住体内的寒毒和业火，气息一窒走火入魔了！....\n\n" NOR);
                me->skill_death_penalty();
                me->delete_skill("ice_fire_zhang");
                me->unconcious();
        } 
}



