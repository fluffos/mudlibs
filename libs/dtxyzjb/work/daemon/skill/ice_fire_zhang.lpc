        "damage_type" : "瘀伤",
]),
([      "action" : "$N突然身形一缓，使出一式"+HIR"「非枯非荣」"NOR+"，左掌凝重，右掌轻盈，击往$n的$l",
        "dodge": -10,
        "parry": -30,
        "force": 40,
        "damage_type": "刺伤",
