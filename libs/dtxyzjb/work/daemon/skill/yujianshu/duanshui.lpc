//modify for dtxy by huarong 2004/10
//Ansi 99.12
#include <ansi.h>

inherit SSERVER;
string query_name() { return "断水"ZJBR"无痕"; }
int perform(object me, object target)
{
        int ap,dp,damage,chance;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「断水无痕」？\n");

        if(!me->is_fighting())
                return notify_fail("「断水无痕」只能在战斗中使用！\n");
        if(me->query("family/family_name")!="蜀山派")
                return notify_fail("不是蜀山的不能用「断水无痕」！\n");
//        if(me->query("shushan/duanshui_master")!=1)
//                return notify_fail("你还没领会「断水无痕」！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("yujianshu", 1) < 60)
                return notify_fail("你的御剑术修为还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("zixia-shengong", 1) < 60)
                return notify_fail("你的紫霞神功修为还不够，使用这一招会有困难！\n");

        if( time()-(int)me->query_temp("duanshui_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        msg = CYN"\n$N手腕晃动如疾风，以砍断三千尺飞流的速度，直逼$n！\n"NOR;
        ap = me->query_skill("sword",1);
        ap = ap*ap/10*ap;
        dp = target->query("combat_exp",1);
        chance = to_int( to_float(random( ap + dp )) / to_float(dp) * 100);
        if (target->is_busy()) chance *= 3;
        if( chance > 40 ) {
                damage = (int)me->query_skill("sword")+(int)me->query_skill("zixia-shengong", 1) + random(me->query("force_factor"));
                damage=damage-target->query_temp("apply/armor");
                  if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage/3,me);
                target->start_busy(random(1)+1);
                msg += HIR"结果$n"+HIR+"被$N"+HIR+"的"+HIW+"「断水无痕」"+HIR+"拦腰划过！\n"NOR;
        }

        else
                msg += HIG"但是被$n"+HIG+"躲开了。\n"NOR;
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->add("force",-50-me->query("force_factor"));
        me->start_busy(2+random(1));
        me->set_temp("duanshui_end",time());
        return 1;
}

