#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);
string query_name() { return "显形诀"; }
int exert(object me, object target)
{
        int skill;

        if( target != me )
                return notify_fail("你只能用显形诀保护自己。\n");

        if( (int)me->query("force") < 200 )
                return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("xianxing") )
                return notify_fail("你已经在使用显形诀了。\n");

        skill = me->query_skill("tonsillit",1);

       // me->add("bellicosity", -skill/2);
        if((int)me->query("bellicosity") <= 0)
           me->set("bellicosity", 1);

        me->add("force", -50-skill/4);

        message_vision(HIR"$N将白骨措成一堆磷粉,向四周撒了开去,顿时显现出一些足迹!!\n"NOR, me);

        me->add_temp("apply/dodge", skill/5);
        me->set_temp("xianxing", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me,skill/5 :), skill);

//huarong 2004/10
        if( me->is_fighting() && userp(me) ) me->start_busy(3);

        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/dodge", -amount);
        me->delete_temp("xianxing");
        tell_object(me,HIB"你的显形诀运行一周天完毕，将内力收回丹田。\n"NOR);
}


