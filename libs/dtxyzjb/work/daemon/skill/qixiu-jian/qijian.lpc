//Cracked by Roath
#include <ansi.h>
//modify for 大唐西游2 by huarong 2003/12

#include <combat.h>
inherit SSERVER;
string query_name() { return "夺命"ZJBR"七剑"; }
int perform(object me, object target)
{
        string msg;
        int extra,extra1,i,lmt,skill;
        object weapon;
        extra = me->query_skill("qixiu-jian",1);
        if ( extra < 60) return notify_fail("你的[七修剑]还不够纯熟！\n");
        extra1 = me->query_skill("huntian-qigong",1);
        if ( extra1 < 60) return notify_fail("你的[混天气功]还不够纯熟，无法发挥七修剑的威力！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［夺命七剑］只能对战斗中的对手使用。\n");

        if(me->query("family/family_name")!="陷空山无底洞")
                return notify_fail("你不能用别派的特殊攻击\n");
        if( time()-(int)me->query_temp("qijian_end") < 6 )
                return notify_fail("绝招用多了就不灵了！\n");


        skill=extra+extra1;
        weapon = me->query_temp("weapon");
        msg = YEL  "$N"+NOR+YEL+"狂性大发，手中的"+ weapon->name()+NOR+YEL+"狂风暴雨般地向$n"+NOR+YEL+"袭来！" NOR;
        message_vision(msg,me,target);
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        me->set_temp("wddpfm",1);//这里禁止zxzx的效果，见combatd.c   huarong 2003.12
        lmt = skill/120+1;
        if (lmt>4) lmt=4;
        for(i=0;i<=lmt;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        }
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->start_busy(1+random(2));
        me->delete_temp("wddpfm");
        me->set_temp("qijian_end",time());
        return 1;
}

