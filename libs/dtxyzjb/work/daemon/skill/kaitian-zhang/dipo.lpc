//lestat for 昆仑山
//2001 天龙破
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;
string query_name() { return "地龙破"; }
int perform(object me, object target)
{
        object weapon;
        int skill,damage;

       string msg,str;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「地龙破」?\n");
        if(me->query_temp("dipo_perform"))
                return notify_fail("你已经使出「地龙破」了！\n");
        if( time()-(int)me->query_temp("dipo_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");
        if(!me->is_fighting(target) )
                return notify_fail("地龙破只能在战斗中使用!!\n");

        if((int)me->query("max_force") <1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") <50 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("kaitian-zhang",1) <60)
                return notify_fail("你的混元开天掌级别还不够施展这一招地龙破!!\n");
        if((int)me->query_skill("unarmed",1) <60)
                return notify_fail("你的格斗扑击之术等级不够!!\n");
        if(me->query("family/family_name") != "昆仑山玉虚洞" )
                return notify_fail("你与昆仑无缘,领悟不到掌法的精髓!!\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");
        weapon=me->query_temp("weapon");

        message_vision(HIB"$N"+HIB+"玄宗真气暴涨，使出开天掌绝学中的"+NOR+RED+"「地龙破」，\n"
        +HIB+"只见$N"+HIB+"身旁真气怒涛，玄宗真力充斥在$N"+HIB+"的指上！\n"NOR,me,target);

        message_vision(HIW"$N"+HIW+"低吼一声，无形的指力向$n"+HIW+"狂射而出！"NOR,me,target);
             me->add("kee",-30);
             me->add("force",-50 - ((int)me->query_skill("xuanzong-force",1)));
        if(random(me->query_skill("unarmed",1)+20)>random(target->query_skill("dodge",1)))
         {
           message_vision(HIR"\n$n"+HIR+"躲避不及，已然中招，霎时$N"+HIR+"的内劲在$n"+HIR+"身上乱窜，痛苦异常！\n"NOR,me,target);
           damage=me->query_skill("xuanzong-force",1)*3+random(me->query_skill("xuanzong-force",1)*3);
       damage=damage-target->query_temp("apply/armor");
        if( damage<0) damage=0;
           target->receive_wound("kee",damage);
        target->set_temp("last_damage_from", me);

	   if (wizardp(me) && me->query("env/combat")=="verbose")
                tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
           COMBAT_D->report_status(target);
         }
        else
         {
           message_vision(HIY"\n$n"+HIY+"看出$N"+HIY+"出招方向，千均一发一际，躲过攻击！\n"NOR,me,target);
         }
        me->start_busy(2);
        me->set_temp("dipo_end",time());
      if ((target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))&&random(5)==1)
                       {str=target->name()+HIM"被"+me->name()+"用玉虚秘传"NOR+HIR"「地龙破」"+HIM"之无形指力戳死了！";
	                 message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
	               }
        return 1;
}

