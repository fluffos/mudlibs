//create by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "无极"ZJBR"一指"; }
int perform(object me, object target)
{
      string msg, dodge_skill;
      int damage, myexp,youexp,ratio, skill;
      object weapon=me->query_temp("weapon");
      skill = (int)me->query_skill("unarmed",1)/2+(int)me->query_skill("jienan-zhi",1)/2+(int)me->query_skill("lotusforce",1)/2;

      if( !target ) target = offensive_target(me);

      if( !target || !me->is_fighting(target) || !living(target) )
           return notify_fail("「无极一指」只能在战斗中对对手使用。\n");
      if(me->query("family/family_name") != "南海普陀山" )
                return notify_fail("你是哪儿偷学来的武功！\n");
      if( (int)me->query_skill("jienan-zhi",1) < 100 )
           return notify_fail("你的劫难指不够娴熟，不会使用佛门神功「无极一指」！\n");

      if( (int)me->query_skill("unarmed",1) < 100 )
           return notify_fail("你的基本手法不够娴熟，不会使用佛门神功「无极一指」！\n");

      if( (int)me->query_skill("lotusforce",1) < 100 )
           return notify_fail("你的莲台心法等级不够，不能使用「无极一指」！\n");

      if( (int)me->query_str() < 20 )
           return notify_fail("你的先天臂力不够强，不能使用「无极一指」！\n");

      if( (int)me->query("max_force") < 1200 )
           return notify_fail("你的内力太弱，不能使用「无极一指」！\n");

      if( (int)me->query("force") < 800 )
           return notify_fail("你的内力太少了，无法使用出「无极一指」！\n");

      if( objectp(me->query_temp("weapon")) )
           return notify_fail("你必须空手使用「无极一指」！\n");

      if( time()-(int)me->query_temp("wuji_end") < 6 )
            return notify_fail("绝招用多了就烂了！\n");

        myexp=(int)me->query("combat_exp",1);
        youexp=(int)target->query("combat_exp",1);
        ratio=to_int((to_float(myexp)/10)/(to_float(youexp)/1000));
        if (ratio>200) ratio=200;
        if (ratio<20)  ratio=20;

      me->set_temp("jienan_pfm",6);
      COMBAT_D->do_attack(me, target, weapon);
      me->set_temp("jienan_pfm",7);
      COMBAT_D->do_attack(me, target, weapon);
      me->delete_temp("jienan_pfm");
      message_vision(RED"\n$N"+NOR+RED+"两指之后，招式一变，变指为掌！\n"NOR,me,target);
      message_vision(HIB"\n\n\n            〓"+HIG+"劫难刀"+HIB+"〓\n\n\n"NOR,me,target);
      message_vision(RED"一道森寒的无形刀锋又已相继劈到！\n"NOR,me,target);

        if (random(myexp+youexp)>youexp/2)
          {
           damage =random(skill/2)+skill*2;
           damage -=(int)target->query_temp("apply/armor");
           damage=damage*ratio/100;
           if(damage<0) damage=0;
           target->receive_wound("kee", random(damage/2),me);
            target->receive_damage("kee", damage,me);
            message_vision(HIR"但听一声裂帛大响，$n"+HIR+"身上留下一条深深的血槽！\n"NOR,me,target);
            if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
             COMBAT_D->report_status(target);
           }
         else
          {
              damage=0;
               message_vision(HIG"只见$N"+HIG+"狼狈的从掌刀下躲了过来。\n"NOR,target);
           }
      me->set_temp("wuji_end",time());
      me->add("force",-60-skill/4);
      me->start_busy(1+random(2));
      return 1;
}




