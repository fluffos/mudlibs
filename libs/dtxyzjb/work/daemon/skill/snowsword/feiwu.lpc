//create by huarong 2003/12

#include <ansi.h>
inherit SSERVER;
string query_name() { return "彩蝶"ZJBR"飞舞"; }
int perform(object me, object target)
{
       int damage, skill,mywhip,myunarmed,mysword,i,myexp,youexp;
       object weapon=me->query_temp("weapon");
       string msg,str;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIR+"「彩蝶飞舞」"+NOR+"只能对战斗中的对手使用。\n");
                if(!wizardp(me) && me->query("family/family_name")!="月宫")
             return notify_fail(HIR+"「彩蝶飞舞」"+NOR+"只有月宫门人才可以用！\n");

        if( (int)me->query("force") < 1500)
            return notify_fail("你的内力不够了!\n");

         if( (int)me->query_skill("sword",1) < 150
          ||me->query_skill_mapped("sword") != "snowsword")
             return notify_fail("你的「基本剑术」还不到家，无法使用"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( (int)me->query_skill("baihua-zhang",1) < 150 )
            return notify_fail("你的「百花掌」还不到家，无法使用"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( (int)me->query_skill("snowsword",1) < 150 )
            return notify_fail("你的「风回雪舞剑」还不到家，无法使用"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( (int)me->query_skill("jueqingbian",1) < 150 )
            return notify_fail("你的「绝情鞭」等级不够，无法推动"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( (int)me->query_skill("moonforce",1) < 150 )
            return notify_fail("你的「圆月心法」还不到家，无法自由控制剑进行"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( (int)me->query_skill("moondance",1) < 150 )
            return notify_fail("你的「冷月凝香舞」还不到家，无法施展"+HIW+"「彩蝶飞舞」"+NOR+"！\n");

        if( time()-(int)me->query_temp("feiwu_end") < 10 )
            return notify_fail("此乃月宫之精髓所在，用多了就烂了！\n");

        skill=(int)me->query_skill("whip",1)+(int)me->query_skill("sword",1)+(int)me->query_skill("unarmed",1);
        mywhip=(int)me->query_skill("jueqingbian",1);
        myunarmed=(int)me->query_skill("baihua-zhang",1);
        mysword=(int)me->query_skill("snowsword",1);
        myexp=me->query("combat_exp");
        youexp=target->query("combat_exp");
        target->add_temp("apply/dodge",-skill/2);
        target->add_temp("apply/parry",-skill/2);
        me->delete("env/brief_message");
        target->delete("env/brief_message");
        weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
        weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));

        message_vision(HIW"\n$N"+HIW+"默运圆月心法，手中"+HIY+weapon->query("name")+HIW+"越舞越快，剑影中竟然飞舞出数只蝴蝶！\n"NOR,me,target);
        message_vision(HIW"\n$N"+HIW+"剑招随蝴蝶飞舞而瞬息万变！\n"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        message_vision(RED+"\n"+weapon->query("name")+NOR+RED+"突然转红如同"+HIR+BLINK+"赤蝶"+NOR+RED+"一般直取$n！"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        message_vision(YEL+"\n"+weapon->query("name")+NOR+YEL+"随即变黄如同"+HIY+BLINK+"橙蝶"+NOR+YEL+"一般变幻不定！"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);

     if(mywhip>=200)
        {
        message_vision(GRN+"\n"+weapon->query("name")+NOR+GRN+"随即转绿，$N竟然以剑代鞭使出绝情鞭法！\n"
                     +"                         －－"+HIG+BLINK+"绿蝶"+NOR+GRN+"藏身－－"NOR,me,target);
        me->set("actions", (: call_other, SKILL_D("jueqingbian"), "query_action" :) );
        weapon->set("use_apply_skill",1);
        weapon->set("apply/skill_type","whip");
        COMBAT_D->do_attack(me, target,weapon);
        }
     if(mywhip>=225)
        {
        message_vision(CYN+"\n"+weapon->query("name")+NOR+CYN+"散发出青色光芒！\n"
                     +"                         －－"+HIC+BLINK+"青蝶"+NOR+CYN+"采花－－"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        }
     if(myunarmed>=250)
        {
        message_vision(BLU+"\n迂回之间，$N"+BLU+"突然收剑出掌！夹杂着"+HIB+BLINK+"蓝蝶"+NOR+BLU+"的掌风逼近$n！"NOR,me,target);
        me->set("actions", (: call_other, SKILL_D("baihua-zhang"), "query_action" :) );
        weapon->set("apply/skill_type","unarmed");
        COMBAT_D->do_attack(me, target,weapon);
        }
     if(myunarmed>=275)
        {
        message_vision(HIW+BLK+"\n恍惚中飞舞出一只"+BLINK+"黑蝶"+NOR+HIW+BLK+"直取$n！"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        }
     if(mysword>=300 && (int)me->query_skill("sword",1)>=300 && skill>=900 )
       {
        me->add_temp("apply/attack",skill/3);
        me->add_temp("apply/damage",skill/3);
        message_vision(WHT+"\n$N收剑聚气，然后突然发出彩蝶飞舞精华一式\n\n"
          +HIY"                 〓〓"HIW+BLINK+"白蝶"+NOR+HIR+"索命"+HIY+"〓〓\n"NOR,me,target);
message_vision(HIW+"       _                                 _           \n"NOR,me);
message_vision(HIW+"      ／ `._                        _。' ＼          \n"NOR,me);
message_vision(HIW+"     ( @ : `.                      .' : @ )          \n"NOR,me);
message_vision(HIW+"      ＼  @.  `.    ._     _.    .'  .@  ／          \n"NOR,me);
message_vision(HIW+"       ＼;' @.  `.   ＼   ／   .'  .@ `;／           \n"NOR,me);
message_vision(HIW+"        ＼`.  @.  ＼  ＼_／  ／  .@  .'／            \n"NOR,me);
message_vision(HIW+"          ) :-._@. ＼  (:)  ／ .@_.-: (              \n"NOR,me);
message_vision(HIW+"          (`.....,`.＼／:＼／.',.....')              \n"NOR,me);
message_vision(HIW+"            >------._│:::│_.------<                 \n"NOR,me);
message_vision(HIW+"           ／.'._>_.-│:::│-._<_.'.＼                \n"NOR,me);
message_vision(HIW+"          │o _.-'_.-^│:│^-._`-._ o│                \n"NOR,me);
message_vision(HIW+"          │`'   ;_.-'│:│`-._;   `'│                \n"NOR,me);
message_vision(HIW+"           ＼.o_.-' ;.│:│.; `-._o.／                \n"NOR,me);
message_vision(HIW+"            ＼.__.__  ＼:／  __.__.／                 \n"NOR,me);
message_vision(HIW+"                        ^                            \n"NOR,me);
        me->set("actions", (: call_other, SKILL_D("snowsword"), "query_action" :) );
        weapon->set("apply/skill_type","sword");
        COMBAT_D->do_attack(me, target,weapon);
        me->add_temp("apply/attack",-skill/3);
        me->add_temp("apply/damage",-skill/3);
      if  (  (target->query("eff_kee")<0 || !living(target)) && random(5)==1 )
         {str=target->name()+HIM+"被"+me->name()+HIM+"用月宫秘传"+HIW+"「彩蝶飞舞」"+HIM+"杀死了。听说"
                +target->name()+HIM+"到了阴曹地府还伴随着一只惨白色的蝴蝶！";
            message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
         }

       }

      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
      me->reset_action();
      target->add_temp("apply/dodge",skill/2);
      target->add_temp("apply/parry",skill/2);
      me->start_busy(1+random(1));
      weapon->set("use_apply_skill",0);
      me->set_temp("feiwu_end",time());
      return 1;
}


