#include <ansi.h>
inherit F_CLEAN_UP;
string query_name() { return "天罡"ZJBR"真气"; }
int exert(object me, object target)
{object *ob,where;
int i, damage, force;
if(!wizardp(me))
return notify_fail("拜托你用下大脑，「天罡真气」你有可能会嘛？！\n");
message_vision(MAG"\n$N淡淡的道: 炼就西方居胜境，修成永寿脱尘埃。莲花成体无穷妙，西方首领大仙来。
\n"
NOR, me);
message_vision(MAG"\n只见$N背后缓缓升起"NOR HIC"青、"HIY"黄、"HIG"绿、"HIW"白、"HIR"红"NOR MAG"五道
霞光。\n"NOR, me);
ob = all_inventory(environment(me));
for(i=0; i<sizeof(ob); i++) {if( !living(ob[i]) || ob[i]==me ) continue;
if(!me->visible(ob[i])) continue;
tell_object(ob[i],HIC "\n你顿觉一股强劲的真气扑面而来,你快喘不过气来......\n"NOR);
ob[i]->start_busy(5);
tell_object(ob[i],MAG "\n你被五色霞光击中，像稻草一样飞了出去！\n"NOR);
ob[i]->move("/d/kaifeng/tieta");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/city/center");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/nuerguo/townc3");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/dudi/dudi2");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/firemount/cuiyun1");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/jilei/jilei1");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/jisaiguo/east1");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/xiaoxitian/simen");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/zhuzi/zhuzi3");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/pansi/ling1");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],"路上的行人吃惊的大叫了起来。\n");
ob[i]->move("/d/qujing/lingshan/daxiong");
message_vision("$N身体像稻草一样飞了出去。\n\n", ob[i]);
tell_object(ob[i],HIW"\n远处悠自飘来一丝声音。。。。。。。。。。。。\n\n"NOR);
tell_object(ob[i],MAG"\n功满行完宜沐浴，炼成本性合天真；天开於子方成道，九戒三皈始自新。
脱却羽毛归极乐，超出樊笼养百神；洗尘涤垢全无染，返本还元不坏身！\n"NOR);
ob[i]->unconcious();
}
return 1;}
