// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string query_name() { return "阴字决"; }
int perform(object me, object target)
{
        int extra, myexp, hisexp;
        object weapon;
       if(me->query("family/family_name") != "方寸山三星洞" )
              return notify_fail("你是哪儿偷学来的武功，也想用「阴字决」?\n");
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");
        extra = me->query_skill("liangyi-sword",1) ;
        if ( (int)me->query_skill("liangyi-sword",1)  < 100)
                 return notify_fail("你的[两仪剑法]还不够纯熟！\n");
        if ( (int)me->query_skill("sword",1)  < 100)
                 return notify_fail("你的[基本剑术]还不够纯熟！\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［阴字诀］只能对战斗中的对手使用。\n");
       if((int)me->query("force") < 150 ) return notify_fail("你的内力不足！\n");
       if((int)me->query("sen") < 150 ) return notify_fail("你无法集中精力！\n");
       if(target->is_busy())
             return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

       if( time()-(int)me->query_temp("yin_end") < 5 )
          return notify_fail("绝招用多就不灵了！\n");

       me->add("force", -100);
       me->receive_damage("sen", 100);
        weapon = target->query_temp("weapon");
        myexp = (int)me->query("combat_exp");
        hisexp= (int)target->query("combat_exp");
       message_vision(HIB "\n\n$N"+HIB+"使出一式两仪剑法中的"+HIM+"［阴字诀］"+HIB+"，手中"
              +(me->query_temp("weapon"))->name()+HIB+"向$n"+HIB+"缠去！\n\n" NOR, me,target);
 if(random(hisexp) < myexp )
     {
        message_vision(HIB "结果将$n"+HIB+"越缠越紧，逼的$n"+HIB+"一阵手忙脚乱！\n\n" NOR, me,target);
        target->start_busy(3+random(2));//old is 3+random(7) huarong 2003.3.14
      }
  else message_vision(HIG "\n$n"+HIB+"不为所惑，站了个马步，凝神拆招！\n" NOR, me, target);
  me->start_busy(1+random(1));
  me->improve_skill("liangyi-sword", 1, 1);
  me->set_temp("yin_end",time());
  return 1;
}

