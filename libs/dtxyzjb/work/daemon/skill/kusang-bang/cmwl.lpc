//create by huarong 2004/10
#include <ansi.h>

string *gui_name = ({
HIW"\nㄨ"+HIR+BLINK+"魑"+NOR+HIW+"ㄨ"+HIB+"  ∞∞∞∞∞∞"+HIR+"   凶神恶煞！"NOR,
HIW"\nㄨ"+HIR+BLINK+"魅"+NOR+HIW+"ㄨ"+HIB+"  ∞∞∞∞∞∞"+HIR+"   屠戮成性！"NOR,
HIW"\nㄨ"+HIR+BLINK+"魍"+NOR+HIW+"ㄨ"+HIB+"  ∞∞∞∞∞∞"+HIR+"   灭绝三界！"NOR,
HIW"\nㄨ"+HIR+BLINK+"魉"+NOR+HIW+"ㄨ"+HIB+"  ∞∞∞∞∞∞"+HIR+"   天下为魔！"NOR,
});
string query_name() { return "魑魅"ZJBR"魍魉"; }
int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, skill1,skill2;

        me->clean_up_enemy();
        target = me->select_opponent();

        skill1 = me->query_skill("kusang-bang",1);
        skill2 = me->query_skill("tonsillit",1);
        skill=skill1+skill2;

        if(me->query("family/family_name") != "阎罗地府")
        return notify_fail(HIG"「魑魅魍魉」"+NOR"是冥界不传之密！\n");

        if( !(me->is_fighting() ))
                return notify_fail("「魑魅魍魉」只能对战斗中的对手使用。\n");
        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不够！\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "stick")
        return notify_fail("使用「魑魅魍魉」时手里必须拿着根棍。\n");

        if( skill1 < 60)
        return notify_fail("你的「哭丧棒」等级不够, 不能使用「魑魅魍魉」！\n");

        if( skill2 < 60)
        return notify_fail("你的「摄气决」等级不够, 不能使用「魑魅魍魉」！\n");

        if( me->query_skill("dodge",1) < 60 )
                return notify_fail("你的轻功不够，无法运用「魑魅魍魉」！\n");

        if( time()-(int)me->query_temp("cmwl_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        me->delete("env/brief_message");
         target->delete("env/brief_message");

        message_vision(NOR+WHT"\n$N"+NOR+WHT+"怪声叫道：“拿命来！”手中"+weapon->query("name")+NOR+WHT+"抖起一片灰色光影，无数鬼爪向$n"+NOR+WHT+"直搠而出！\n"NOR,me,target);

        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
            for(int i=1;i<=4;i++)
            {
             message_vision(gui_name[i-1], me, target);
             COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
            }
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);

        me->receive_damage("sen", 100);
        me->add("force", -100-skill/3);
        me->set_temp("cmwl_end",time());


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
          me->start_busy(1+random(2));

        return 1;
}


