// 窒气诀
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>

inherit SSERVER;
string query_name() { return "窒气诀"; }
int perform(object me, object target)
{
	string msg;
	int delay,myunarmed,t;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[窒气诀]只能在战斗中使用\n");

	if(me->query("family/family_name") != "将军府")
                return notify_fail(HIR"「窒气诀」"+NOR"是将军府不传之密！\n");

	myunarmed=(int)me->query_skill("changquan",1);
	if(myunarmed<80)
		return notify_fail("你的长拳修为不够深，无法使用[窒气诀]。\n");

       if( time()-(int)me->query_temp("zhiqi_end") < 5 )
                return notify_fail("绝招用多就不灵了！\n");

	if(myunarmed>240) myunarmed=240;
	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

        msg = HIY "$N"+HIY+"收拳发力，招化长拳之秘奥义[窒气诀]向$n"+HIY+"攻去！\n";

	if( random(me->query("combat_exp",1)) > (int)target->query("combat_exp",1)/2 )
          {
              msg += HIB "$n"+HIB+"被一阵拳风扫中，身形不由慢了下来。\n" NOR;
		delay = random(myunarmed/40);
              t=random(me->query("combat_exp"));
              target->start_busy((1+delay*t/me->query("combat_exp")>2)?(1+delay*t/me->query("combat_exp")):3);
	   }
      else msg += HIG "可是$p"+HIG+"连跳了几步，闪开了这阵拳风！\n" NOR;
	message_vision(msg, me, target);
       me->set_temp("zhiqi_end",time());
       me->start_busy(2+random(1));
       me->receive_damage("sen", 50);
       me->add("force", -150);
	me->receive_damage("kee", 50);

	return 1;
}
