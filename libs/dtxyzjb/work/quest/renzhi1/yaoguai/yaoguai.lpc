string invocation(object who, int level)
{
        copy_status(this_object(),who, level);	
		return _invocation(who, level); 
}

string _invocation(object who, int level)
{       object me=this_object(), env;
        string *dirs; 
        int exp, i, lvl;
	 string where, long;
	
	dirs=dirs1;

        set("owner", who->query("id"));
        set("owner_ob", who);

	  long="一头"+name()+"，修练了有"+
	  chinese_number((query("daoxing")/1000/10)*10)+
	  "多年道行。它";
        if(random(2)==0) {
	  set("long",long+"通体透出一丝仙气。\n");
        } else {
	  set("long",long+"混身上下妖气逼人。\n");
        }
	

	lvl=level;
	
	// choose npc type.
	i=random(1000);
	if(i<10) {
	    set("type","aggressive");
	} else if(i<20) {
	    set("type","blocker");
	} else if(i<220) {
	    set("type","aggressive_on_owner");
	} else if(i<320) {
	    set("type","aggressive_on_owner1");
	} else 
	    set("type","normal");
	
	if(random(10)==0) {
	    set("env/wimpy",40);
	    if(lvl<11) lvl=lvl+1; // as more difficult to kill.
	} else {
	    set("env/wimpy",1);
	}

// as more difficult to kill  ,grin. huarong 2003/12 
	//if(random(100)>97) set("bian",1);

	// determine reward
	exp=(who->query("combat_exp")+who->query("daoxing"))/2;
 
       if(exp<1000000) {
	    dirs=dirs;
	}
       else if(exp<3000000) {
	    dirs=dirs+dirs2;
	}
       else {
	    dirs=dirs+dirs2+dirs3;
	}	

	me->set("stay_time", time()+1800);

	if(!random_place(me, dirs)) {
	    call_out("escape_me",1,this_object(),who);
	    return 0;
	}
	
	env=environment(me);
	where=me->query("name")+"("+
	    capitalize(me->query("id"))+")";
	if(env)
	  where+="在"+MISC_D->find_place(env);
	return where;
}
void copy_status(object me,object ob, int lv)
{
        int lvl,k,m,temp;
        mapping skill_status;
        string *sname;

        object qm=new("/d/changan/npc/qianmian.lpc");
	 int base=20;

	 lvl=lv+base-2;

        if(qm) {
            mapping skill=ob->query_skills();
            int i=sizeof(skill);
            int *level, max_level;
	     int max_sen, max_kee;

	    if(i>0) {
		level=values(skill);
		max_level=level[0];
		while(i--) { // find out victim's maximum level
		    if(level[i]>max_level)
			max_level=level[i];
		}
                max_level=max_level*(lvl+20)/(base+20);

	    } else max_level=1;

            qm->copy_status(this_object(), ob, lvl*5/6);
            destruct(qm);

	    k=(query("daoxing")+query("combat_exp"))/2;
	    for(m=1;m<300;m=m+10) {
		if(m*m*m/10>k) break;
	    }
	    m=m*lvl/base/3;
	    if(max_level<m) max_level=m;

	    // skill level will be set to the maximum level
	    // of the player.

            //huarong 2004/12
            if (mapp(skill_status = me->query_skills()))//判断自己是否有功夫，如有将用这个函数全部删除
               {
                  skill_status = me->query_skills();
                  sname = keys(skill_status);//传回所有自己的功夫阵列
                  temp = sizeof(skill_status);
                  for (i = 0; i < temp; i++)
                 // me->set_skill(sname[i],max_level);
                 me->delete_skill(sname[i]);
                }
	    set_skills(max_level, lv);
	    
            max_sen=query("max_sen")/2;
            max_kee=query("max_kee")/2;
	    add("eff_sen",max_sen);
	    add("eff_kee",max_kee);
	    add("sen",max_sen);
	    add("kee",max_kee);
	    add("max_sen",max_sen);
	    add("max_kee",max_kee);

	} else { // sth goes wrong.
	    call_out("escape_me",1,this_object(),ob);
	    return;
	}

	if((query("daoxing")+query("combat_exp"))/2
		>1000000)
	  add("force",query("force")); // double force.
	                               // because players have fabao.
	                               // mana is doubled when copying.
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query("max_mana")/30+1);
	
	 set("daoxing",(query("daoxing")*2+query("combat_exp"))/3);
}

int accept_fight(object ob)
{       
        object me=this_object();
        object guai,guai1,guai2;
        if (ob != owner())
        {
               command("say " + RANK_D->query_self(this_object())
                 + "怎么可能是" + RANK_D->query_respect(ob)
                 + "的对手？\n");
             return 0;
        }       
        else {
              if ( query("kind")!="占" )
                   {
               command("say " + RANK_D->query_self(this_object())
                 + "怎么可能是" + RANK_D->query_respect(ob)
                 + "的对手？\n");
             return 0;
                   }
                else {

                    if(ob->query("rulaitask/leave",1))
                        {
                                command("say 看来你是不到黄河心不死，今天就让你见识一下我的厉害！");
                                command("say 兄弟们，抄家伙！");
                            message_vision(BLU"一阵青烟过后，出现了无数小头目。\n"NOR);
                            guai = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai->set("owner", ob);
                            guai->move(environment(this_object()));
                            guai1 = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai1->set("owner", ob);
                            guai1->move(environment(this_object()));
                            guai2 = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai2->set("owner", ob);
                            guai2->move(environment(this_object()));
                            guai->copy_status(ob, ob,3);
                            guai1->copy_status(ob,ob, 2);
                            guai2->copy_status(ob, ob,1);
                            ob->delete("rulaitask/leave");
                            ob->set_temp("rulaitask/juedou",1);
                            ob->set("rulaitask/guai",guai);
                            ob->set("rulaitask/guai1",guai1);
                            ob->set("rulaitask/guai2",guai2);
                            guai->set("title","二当家");
                            guai1->set("title","三当家");
                            guai2->set("title","四当家");
                             this_object()->kill_ob(ob);
                             guai->kill_ob(ob);
                             guai1->kill_ob(ob);
                             guai2->kill_ob(ob);
                             guai->delete("chat_msg");
                             guai1->delete("chat_msg");
                             guai2->delete("chat_msg");
                             guai->set_leader(this_object());
                             guai1->set_leader(this_object());
                             guai2->set_leader(this_object());
                             guai->command("protect "+this_object()->query("id"));
                             guai1->command("protect "+this_object()->query("id"));
                             guai2->command("protect "+this_object()->query("id"));
                                 return 1;
                        }
                   else {
                                me->command("say 哪里来的妖怪，竟敢变成我的样子！");
                                me->kill_ob(ob);
                                ob->kill_ob(me);
                                return 1;
                        }

                     }
              }                 
}                 

void leave()
{
      if(this_object()) { 
        if(environment())
          message("vision",HIB + name() + 
                  "身子一晃，变成一股青烟仓皇逃窜......\n" NOR,environment());
      }
      return;
}

void init()
{
        object ob,baixing,env;
        object killer=this_object();        
        ob=this_player();
        if(!this_object()->query("killer"))
                return;

        if (ob->query("id")==query("killer")) {
        	if (ob->query_temp("shan_quest/being_inquiry")) {
        		killer->fight_ob(ob);
       	 		ob->fight_ob(killer);
        		COMBAT_D->do_attack(killer, ob, killer->query_temp("weapon"), 0);
        		killer->command("halt");

        		message_vision(HIB"$n一看到$N, 不由分说，抄出家伙给你一记后，立马溜之大吉！\n"NOR,ob,killer); 
        		random_place(killer, dirs1);
        		ob->set_temp("shan_quest/inquiry",1);
        	} else if (ob->query_temp("shan_quest/being_chased") && !killer->query("baixing")) {   
        		message_vision(HIB"$n一看到$N，冷笑了一声: “又一个活得不耐烦的家伙，自寻死路！” \n"NOR,ob,killer);
        		killer->kill_ob(ob);
        		ob->kill_ob(killer);

        		remove_call_out("kill_baixing"); 
        		call_out("kill_baixing",0,ob);
        	} else {
       			message_vision(HIB"$n不屑地朝$N说道: “原来就是你一直在妨碍老子杀人！人我早杀完了，\n"
        			+"你就来收尸吧，不过就不知道谁能帮你收尸了！” \n"NOR,ob,killer);
        		command("heihei "+ob->query("id"));

        		killer->set_leader(ob);
        		killer->kill_ob(ob);
        		ob->kill_ob(killer);
        	}
		}else {
                add_action("do_kill","team kill");
                add_action("do_kill","kill");
                add_action("do_kill","hit");
                add_action("do_kill","fight");
                add_action("do_kill","touxi");   
                add_action("do_kill","steal");
                add_action("do_kill","beg");
                add_action("do_kill","persuade");
                add_action("do_kill","apprentice");
                add_action("do_kill","recruit");
                
        }

}

void start_escape(object ob,object me)
{
        call_out("escape_me",900,ob,me);
}

int do_kill(string arg)
{
        string what,who;
        if(!arg) return 0;
        if(this_object()->id(arg))
        {
                write("江湖人士，还是少惹为妙。\n");
                return 1;
        }
        else
        if(sscanf(arg,"%s from %s",what,who)==2 && this_object()->id(who))
        {
                write("还是到别处去施展你的本事吧。\n");
                return 1;
        }
        return 0;
}

void escape_me(object ob,object me)
{
        if( !ob ) return;
        if (objectp(me) )    
        {
                me->set_temp("shan_quest/level",0);
                me->delete_temp("shan_quest/being_chased");
                me->delete_temp("shan_quest/being_inquiry");  
                me->delete_temp("shan_quest/inquiry");  
                me->set_temp("shan_quest/have_task",0);
                me->add("score",-random(3));
                me->set_temp("shan_quest/killed",ob->query("id"));

                if( environment(ob) )  
                if(ob->query("shen_type")==-1)
                message_vision(
"$N狞笑了几声：“今天心情好，"+RANK_D->query_self_rude(ob)+
"就放过你，不陪你玩了。”说罢，一个筋斗跳出战圈，不知去向。\n",ob);
        else
                message_vision(
"$N跳出战圈，朗声道：“"+RANK_D->query_self(ob)+"尚
有要事在身，下回再来讨教。”只见身形几晃，已无踪无影。\n",ob);

        }
        remove_call_out("kill_baixing");  
        remove_call_out("bandit_send");  
        remove_call_out("escape_me");
        destruct(ob);
        return;
}

void die()
{
        int reward_exp,reward_pot,count;
        object killer,me,baixing;
        string *dir,file,msg;
        object equip;

        me=this_object();
        killer=me->query_temp("last_damage_from");
        message_vision(HIC"$N惨嚎一声，口喷鲜血，到在地上死了。\n"NOR,me);
 

        if(killer && killer->query("id")==me->query("killer"))
        {
        if((int)killer->query_temp("shan_quest/count") <
              (int)killer->query_temp("shan_quest/quest_cancel")*2)
          count=(int)killer->query_temp("shan_quest/count")/2;
         else
           count=(int)killer->query_temp("shan_quest/count")
                 -(int)killer->query_temp("shan_quest/quest_cancel");
	    count = 1; //成功才算
	    count = killer->query_temp("shan_quest/level");
         reward_exp=killer->query("combat_exp")/5000+count*1000;  

         if(me->query("baixing"))
         if(objectp(baixing=present(me->query("baixing",environment(me)))))
         {
          message_vision(CYN"$N对$n表示衷心的感谢！\n"NOR,baixing,killer);
          baixing->command("bye "+killer->query("id"));
          baixing->remove_call_out("escape_me");
          destruct(baixing);
         }

         if(!me->query_temp("baixing_killed"))
         {
           killer->set_temp("shan_quest/succeed",1);
           tell_object(killer,
             HIY"由于你的卓越表现，成功的解救了当地的百姓！\n"NOR); 
          }  

         if(killer->query("combat_exp") < 2000000)
           reward_exp -=reward_exp/5;
         if(reward_exp > 20000) reward_exp=20000;
           reward_exp=reward_exp/2+random(reward_exp/2);
         if(killer->query_temp("shan_quest/succeed")!=1)
          {
          tell_object(killer,
          HIW"由于你的失误，未能成功解救受害百姓，所得奖励大减！\n"NOR);
          reward_exp = reward_exp/5;
          }
         reward_pot=reward_exp/4+random(50)+50-killer->query_int()/5;
 
         if (reward_pot<0) reward_pot=0;
			msg = CHINESE_D->chinese_number(reward_exp) +"点的『武学』"+
				CHINESE_D->chinese_number(reward_pot)+"点的『潜能』！\n";
                   tell_object(killer,HIW+"你获得了"+msg+NOR); 
     MONITOR_D->report_system_object_msg(killer, "[搭救人质]"+reward_exp+" exp "+reward_pot+" pot.");  
	 CHANNEL_D->do_channel(killer,"rumor",killer->query("name")+"完成了搭救人质任务，得到了"+msg);                  
                   
                   killer->add("shan_quest/reward_exp",reward_exp);
                   killer->add("shan_quest/reward_potential",reward_pot);
                   killer->add("combat_exp",reward_exp);
                   killer->add("potential",reward_pot);
                   killer->add("score",random(5));
                   killer->add_temp("shan_quest/count",1);
                   killer->set_temp("shan_quest/killed",me->query("id"));
                   killer->set_temp("shan_quest/killed_place_name",
                                      me->query("place_name"));
                   killer->set_temp("shan_quest/wait_start",time()); 
                   killer->set_temp("shan_quest/have_task",0);   
                   killer->delete_temp("shan_quest/being_chased");
                   killer->delete_temp("shan_quest/being_inquiry");  
                   killer->set_temp("shan_quest/succeed",0);  
                   killer->delete_temp("shan_quest/bandit_time");
                   killer->delete_temp("shan_quest/bandit");
        } else
        if( objectp( killer = find_living(me->query("killer")) ) )
        {
                killer->delete_temp("shan_quest/being_chased");
                killer->delete_temp("shan_quest/being_inquiry");
                killer->delete_temp("shan_quest/inquiry");
                killer->set_temp("shan_quest/have_task",0);
                killer->add("score",-random(3));
                killer->set_temp("shan_quest/killed",me->query("id"));

        }
        remove_call_out("kill_baixing");
        remove_call_out("bandit_send");
        remove_call_out("escape_me"); 
        destruct(me);
        return;
}

int get_level(int exp)
{
  int level=0;
  do {
      level++;
     } while(level*level*level<(exp*10));

  return level;    
}               

void start_chase(object ob)
{
   call_out("bandit_send",5,ob);
}

int bandit_send(object ob)
{
   object killer;
   int t;

   if(!objectp(ob))
   {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    destruct(this_object());
    return 1;
   }

   t=ob->query("combat_exp")/10000000;
   if( t < 1 ) t=1;
   if( t > 5 ) t=5;

   if(ob->is_ghost() )
   {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    call_out("escape_me",1,this_object(),ob);
    return 1;
   }

   if( (time()-ob->query_temp("shan_quest/bandit_time")) > 30 * t
      && ob->query_temp("shan_quest/bandit"))
   {
   killer=new(__DIR__"quest_bandit");
   killer->set("killer",ob->query("id"));
   killer->move(environment(ob)); 
   ob->set_temp("shan_quest/bandit_time",time());
   ob->add_temp("shan_quest/bandit",-1);
   ob->start_busy(2);
   killer->do_fkill(ob); 
   }

   remove_call_out("bandit_send");
   call_out("bandit_send",10,ob);
   
   return 1;
}

void start_kill(object ob)
{
    int t;  
   if(!objectp(ob))
   {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    destruct(this_object());
    return;
   }         
   t=ob->query("combat_exp")/10000000;
   if( t < 1 ) t=1;
   if( t > 5 ) t=5;

   call_out("kill_baixing",(t*90+30),ob);
}

int kill_baixing(object ob)
{
    object baixing;

    if(!this_object()->query("baixing")) 
   {
    baixing=new(__DIR__"baixing");
    //message_vision(HIW"文件名是："+__DIR__+"baixing"+NOR,ob);
    baixing->set("waiting",ob->query("id"));
    baixing->move(environment(this_object()));

    this_object()->set_leader(baixing);
    baixing->set_leader(this_object());
    kill_ob(baixing);
    set("baixing",baixing->query("id")); 
   }
    return 1;
}





void heart_beat()
{  
   int free,free1,kee_cost,sen_cost;
   object guai = this_object();
   ::heart_beat();
   free=(int)query_skill("force")/40; 
   free1=(int)query_skill("spells")/10; 
   kee_cost=(free-1)*100;
   sen_cost=(free1-1)*100;
   if ( !is_fighting()
        && !query_skill("zixia-shengong",1)
        && !query("unconcious")
        && query("eff_kee") <  query("max_kee") )
       { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert heal");
               command("exert heal");
               command("exert heal");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.lpc");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");
              }
        }
   if ( !is_fighting()
          && query_skill("zixia-shengong",1)
          && !query("unconcious")
          && query("eff_kee") <  query("max_kee") )
        { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert ningshen");
               command("exert ningshen");
               command("exert ningshen");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.lpc");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");   
             } 
        }
   if ( !is_fighting()
        && !query_skill("jiuyin-xinjing",1)
        && !query("unconcious")
        && query("eff_sen") <  query("max_sen") )
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.lpc");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }

   if ( !is_fighting()
        && query_skill("jiuyin-xinjing",1)
        && !query("unconcious")
        && query("eff_sen") <  query("max_sen") )
       {   if (query("eff_sen") >= query("max_sen") / 2 )
             {
               command("exert jingheal");
               command("exert jingheal");
               command("exert jingheal");
              }
       else
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.lpc");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }
       }
   if (is_fighting()  &&  query("force") < query("max_force") )
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
   if (!is_fighting()  &&  query("force") < query("max_force") )
     command("exercise "+kee_cost);   
   if (!is_fighting()  &&  query("mana") < query("max_mana") )
//      command("meditate "+sen_cost);
        command("meditate 1000");
   if (query("kind")=="变" && query_temp("befinded") )
    {
        remove_call_out("random_bian");
         call_out("random_bian",0);
        delete_temp("befinded");
    }

  // if (!owner() || owner()->query("rulaitask/dfail") )    
     //   destruct(guai);


}       

void check2()
{
        int i,k;
        object ob=this_object();
        object me=query_temp("my_killer");
        object weapon,*inv;
        inv=all_inventory(ob);
        i=sizeof(inv);
   
   if(query("family/family_name") == "大雪山")
    {
     if ( ob->query_skill("blade") ) 
       {
         ob->delete_temp("have/blade");  
         for(k=0;k<i;k++) 
          {
            if ( inv[k]->query("skill_type") == "blade" || inv[k]->query("apply/skill_type") == "blade" ) 
            {
             set_temp("have/blade",1);
             }
          }  
        if (!query_temp("have/blade") )
          {
            weapon=new("/d/obj/weapon/blade/iceblade");
            weapon->move(ob);
            message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          }
       }    	
     if ( ob->query_skill("sword") ) 
       {
        ob->delete_temp("have/sword");  
        for(k=0;k<i;k++) 
          {
            if ( inv[k]->query("skill_type") == "sword" || inv[k]->query("apply/skill_type") == "sword" ) 
            {
             set_temp("have/sword",1);
             }
          }  
        if (!query_temp("have/sword") )
          {
            weapon=new("/d/obj/weapon/sword/fenghuangqin");
            weapon->move(ob);
            message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          }
       }   	
    }
   else
    {
      ob->delete_temp("have/weapon");  
      for(k=0;k<i;k++) 
        {
          if ( inv[k]->query("id") == "eighteen weapon" ) 
          {
           set_temp("have/weapon",1);
           }
        }  
      if (!query_temp("have/weapon") )
        {
          weapon=new("/d/obj/weapon/18weapon");
          weapon->move(ob);
          message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          command("wield weapon");
        }
    }
}



