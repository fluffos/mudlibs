
#include <ansi.h>

inherit ITEM;
int do_open(string arg);
void create()
{
  set_name(WHT "一碗饺子" NOR,({"jiaozi"}));
  set("long","这是一碗大唐西游巫师组为了玩家抵御冬至的寒冷特制的饺子，你如果吃了它("+HIR+"chi"+NOR+")会有意想不到的惊喜。");
  set("unit","碗");
  set("value", 0);
  setup();
}

void init()
{
   if (!wizardp(this_player())) {
    set("no_get","这个东西拿不起来。\n");
    set("no_give","这么珍贵的东西，哪能随便给人？\n");
    set("no_drop","这么宝贵的东西，扔了多可惜呀！\n");
    set("no_sell","这东西不能卖。\n");
   }
    if(this_player()==environment())
  add_action("do_chi", "chi");
}

int do_chi(string arg)
{
  object me=this_player();
       if (arg!="jiaozi") return 0;
  if (me->query("dongzhi_liwu")) return notify_fail("你已经吃过饺子了，怎么还想吃？\n");
  message_vision(HIG"$N一口吞下这碗饺子，只觉得浑身温暖，充满了力量!\n" NOR,me);
  me->add("potential",30000);//lxmas 2008.12.19
  me->add("combat_exp",30000); //lxmas 2008.12.19
  me->add("daoxing",30000); //lxmas 2008.12.19
  tell_object(me,HIW"你被奖励了：\n" +
  chinese_number(30000) + "点武学\n"+ 
  chinese_number(30000) + "点潜能\n"+  
  chinese_number(30) + "年道行\n" NOR);
  me->set("dongzhi_liwu",1);
message("chat",HIC+"〖"+HIW+"大唐西游"+HIC+"〗海贼王(lxmas)：玩家"+me->query("name")+"吃了一碗热腾腾的饺子，大唐西游祝你冬至快乐！\n"NOR,users());
  destruct(this_object());
  return 1;
}
