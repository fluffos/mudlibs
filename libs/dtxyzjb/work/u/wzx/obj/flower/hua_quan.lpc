// rose.c
#include <ansi.h>

inherit COMBINED_ITEM;

int value() { return query_amount() * (int)query("base_value"); }

void create()
{
	set_name(HIW "悼念花圈" NOR, ({"hua quan", "huaquan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是用来悼念死人用的花圈，充满了悲痛与哀悼。\n");
		set("unit", "扎");
		set("value", 25);
		set("base_unit", "扎");
        set("base_weight", 100);
	set("flower_w",1);
			}
	set_amount(1);
}
#include "flower.h"