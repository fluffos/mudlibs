#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_get","你手里一松，还阳丹从指间滑落！\n");
    set("no_give","这么珍贵的药，哪能随便给人？\n");
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( HIG "还阳丹" NOR , ({"huanyang dan", "dan"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗金黄色的丹丸，略微能闻到些许香气。\n");
      set("value", 1000);
      set("no_put",1);
      set("no_sell",1);
      set("no_get",1);
    set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  if (arg!="dan" && arg!="huanyang dan")   return 0;

message("channel:rumor", RED"【仙侣情缘】：乌子婿最新报道：独家专题--"+me->name()+"裸奔大揭密！\n\n"NOR,users());
   me->command("remove all");
    me->move("d/city/zhuque-s1");
    me->move("d/city/zhuque-s2");
    me->move("d/city/zhuque-s3");
    me->move("d/city/zhuque-s4");
    me->move("d/city/center");
     message_vision(HIW "只见$N急匆匆的跑了过来，嘴里还叨叨咕咕道：裸奔好爽啊！\n" NOR, me);
    me->move("d/city/xuanwu-n1");
    me->move("d/city/xuanwu-n2");
    me->move("d/city/xuanwu-n3");
    me->move("d/city/xuanwu-n4");
    me->move("d/city/kezhan");
     message_vision(HIW "只见$N急匆匆的跑了过来，嘴里还叨叨咕咕道：裸奔好爽啊！\n" NOR, me);
     me->command("dance");
  message_vision(HIG "$N轻轻掰开一颗还阳丹送入嘴中，一时间香气四溢。
只见$N脸上慢慢泛出红晕，看起来有精神多了！\n" NOR, me);
  destruct(this_object());
  return 1;
}



