inherit NPC;
int give_gqliwu(object me);
#include <ansi.h>
 
void create()
{
    set_name("元宵使者", ({"元宵使者","shizhe"}));
    set ("long", @LONG

元宵的礼物使者，是巫师组答谢各位的礼物。
LONG);
        set("gender", "女性");
        set("title",HIW"使者"NOR);
        set("age", 21);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 100000);
       set("max_force", 20000);
       set("force_factor", 1000);
       set("max_mana", 20000);
       set("mana", 100000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);

        set("inquiry", ([
        "gift":(:give_gqliwu:),
        "礼物":(:give_gqliwu:),
]));
        setup();
}

int give_gqliwu(object me)
{
	me=this_player();
	
 if(me->query("gift/08yx"))   {
    write(HIY"礼物拿了还想要？小心被雷劈哦！\n"NOR);
			return 1;
	}
          write(HIY"元宵节快乐!感谢支持！\n你得到了10000潜能，500内力。\n"NOR);
    me->add("max_force",500);
me->add("max_mana",500);
me->add("mana",500);
me->add("maximum_force",500);
me->add("maximum_mana",500);
me->add("potential",10000);
me->set("gift/08yx",1);
        me->save();
	return 1;
}
