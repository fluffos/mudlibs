inherit ROOM;

void create ()
{
  set ("short", "长廊");
  set ("long", @LONG

天下第一武道会长廊。

LONG);

  set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/duandi" : 1,
  __DIR__"npc/shalu" : 1,
]));
  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"chang2",
  "north" : __DIR__"damen",
  ]));

  setup();
}

int valid_leave(object me, string dir)
{
        if (me->query("quest/reward"))
        return ::valid_leave(me, dir);
        if (dir == "south" ) {
        if (objectp(present("duan di", environment(me)))&&!wizardp(me))
        return notify_fail("短笛喝道：若想进入高级会场需通过我这关！\n");
         if (objectp(present("sha lu", environment(me)))&&!wizardp(me))
        return notify_fail("沙鲁喊道：没看到我在这吗? \n");
        }   
        return ::valid_leave(me, dir);
}

 


