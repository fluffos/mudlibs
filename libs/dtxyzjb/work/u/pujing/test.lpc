// fu-ceting 侧厅
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "侧厅");
        set("long", @LONG
这是正堂旁边的一间小厅，是旅馆老板招待熟客的地方。厅中摆
放着一张桌子和几把椅子，桌上刚沏好的茶还在冒着热气。
LONG
        );
 
        set("no_clean_up", 0);
        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，这是正堂旁边的一间小厅，是旅
馆老板招待熟客的地方。厅中摆放着一张桌子和几把椅子，桌上
刚沏好的茶还在冒着热气。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
侧厅阳光浅浅地透进去。这是旅馆老板招待熟客的地方。厅中摆
放着一张桌子和几把椅子，桌上刚沏好的茶还在冒着热气。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，这是正堂旁边的一间小厅，是旅馆老板招
待熟客的地方。厅中摆放着一张桌子和几把椅子，桌上刚沏好的
茶还在冒着热气。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这是正堂旁边的一间小厅，
是旅馆老板招待熟客的地方。厅中摆放着一张桌子和几把椅子，
桌上刚沏好的茶还在冒着热气。
LONG
);
			else//入夜
				set("long",@LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这是
正堂旁边的一间小厅，是旅馆老板招待熟客的地方。厅中摆放着
一张桌子和几把椅子，桌上刚沏好的茶还在冒着热气。
LONG
);
		}
		return 0;
	}
}

