#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("人参果", ({ "renshen guo","guo" }) );
        set("unit", "颗");
        set("weight", 100);
        set("value", 500);
}
void init()
{
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
        object ob;
        if( !id(arg) ) return notify_fail("你要吃什麽？\n");
        if( living(this_player()) ==0 ) return 0;
        ob=this_player();
        ob->set("per", 28);
        destruct(this_object());
        return 1;
}
