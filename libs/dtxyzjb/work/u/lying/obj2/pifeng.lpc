#include <ansi.h>
#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name(HIY "黄金披风" NOR, ({"golden pifeng", "pifeng"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("unit", "件");
    set("value", 200000);
               set("no_sell", 1);
               set("no_drop", 1);
    set("armor_prop/armor", 70);
    set("armor_prop/courage",8);
    set("need_level",2);
  }
  setup();
}
