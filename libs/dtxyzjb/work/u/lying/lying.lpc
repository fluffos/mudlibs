#include <ansi.h>
inherit NPC;
inherit F_DEALER;
void clear_room();

void create()
{
       set_name(HIW"少主人"NOR, ({"xiao tianying"}));
       set("title",HIB"BrareHeart"NOR);
       set("gender", "男性");
       set("combat_exp", 1000);
       set("age", 20);
       set("per", 40);
       set("attitude", "friendly");
       set("vendor_goods", ({
//           "zhen":"/d/obj/misc/pillow",
                     "u/lying/obj2/armor",
                     "u/lying/obj2/boots",
                     "u/lying/obj2/cloth1",
                     "u/lying/obj2/finger",
                     "u/lying/obj2/hands",
                     //"/d/city/npc/obj/he.lpc",
                     //"u/lying/tfd",
                     "u/lying/obj2/kui",
                     //"/u/wzx/obj/chaojitao",
                     "/u/wzx/obj/xieyao",
                     "u/lying/obj2/neck1",
                     "u/lying/obj2/pifeng",
                     //"/u/take/panshidan",
                     "u/lying/obj2/shield",
                     "u/lying/obj2/waist",
                     "u/lying/obj2/waists",


}));

              setup();
// carry_object("/d/obj/cloth/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_buy", "buy");
        add_action("do_list", "list");
}