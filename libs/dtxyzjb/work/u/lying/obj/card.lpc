//lying 2009.10.26
#include <ansi.h>
inherit ITEM;
int do_to(string arg);

void create()
{
  set_name(HIW"新手卡"NOR , ({"new card", "card"}));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", @LONG
仙侣情缘赠送给新玩家用来拜师的卡片，按如下规则前往各个门派。
指令：“to 门派简称”如：to sx

三界散仙(sx) 大雪山(xs) 阎罗地府(hell) 东海龙宫(lg)
蜀山派(ss) 月宫(moon) 普陀山(pt) 火云洞(hy) 昆仑山(kl)
盘丝洞(ps) 将军府(jjf) 五庄观(wzg) 无底洞(wdd) 方寸山(fc)
天魔宫(tm) 神剑(sj)
LONG);
    set("value", 500000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("drug_type", "补品");
  }
  setup();
  
}


void init()
{
  add_action("do_to", "to");
}

int do_to(string arg)
{
  object me = this_player();
  object ob = this_object();
object deng;
  int time=0;
  if(this_player()->is_busy())
      return notify_fail("你正忙着呢．．．\n");
   
      if (arg=="sx")
     {deng=new("/d/qujing/jinping/obj/denglong36.lpc");
      deng->move(me);me->move("/d/sanxian/huating");time=1;}
else  if (arg=="xs")
     {me->move("/d/xueshan/wuchang-e");time=1;}
else  if (arg=="hell")
     {me->move("/d/death/new-lunhui");time=1;}
else  if (arg=="lg")
     {me->move("/d/sea/girl3");time=1;}
else  if (arg=="ss")
     {me->move("/d/shushan/houdian");time=1;}
else  if (arg=="moon")
     {me->move("/d/moon/xiaoyuan");time=1;}
else  if (arg=="pt")
     {me->move("/d/nanhai/zoulang");time=1;}
else  if (arg=="hy")
     {me->move("/d/westway/jincheng");time=1;}
else  if (arg=="kl")
     {me->move("/d/kunlun/lingyunge");time=1;}
else  if (arg=="ps")
     {me->move("/d/pansi/tao_in");time=1;}
else  if (arg=="jjf")
     {me->move("/d/jjf/front_yard");time=1;}
else  if (arg=="wzg")
     {me->move("/d/qujing/wuzhuang/guangchang");time=1;}
else  if (arg=="wdd")
     {me->move("/d/qujing/wudidong/houdong");time=1;}
else  if (arg=="fc")
     {me->move("/d/lingtai/inside3");time=1;}
else  if (arg=="sj")
     {me->move("/d/shenjian/sjsz");time=1;}
else  if (arg=="tm")
     {me->move("/d/tianmo/shanmen");time=1;}
else  tell_object(me, HIC"你要去哪里？\n"NOR);
    
    if(time==1) destruct(this_object());
    return 1;     
}
