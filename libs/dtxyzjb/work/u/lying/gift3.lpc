inherit NPC;
#include <ansi.h>
int give_gift();
void create()
{
    set_name(HIC"礼物大使"NOR, ({ "gift"}));
       set("age", 18+random(10));
       set("gender", "男性");
  set("title", HIM"国庆专用"NOR);
       set("long","这位就是国庆礼物使者。\n");
        set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
 set("per", 50);
      set("combat_exp", 200000000);
      set("daoxing", 200000000);
      set("max_force", 200000);
      set("max_mana", 200000);
set("max_kee", 40000);
set("max_sen", 40000);
set("force", 400000);
set("force_factor", 1000);
set("mana_factor", 1000);
set("mana", 1000);
       set_skill("unarmed", 1000);
        set_skill("dodge", 1000);
       set_skill("parry", 1000);
   set("inquiry",([
  "国庆礼物": (: give_gift :),
 
]));
     setup();
}

int give_gift()
{
    object me;
    int p;
    me=this_player();
    if(!me) return 0;
    if (me->query("take/中秋")=="2008")
	{
		message_vision("\n\n礼物大使疑惑的看着你道：你不是又想来混一份礼物吧？\n\n"NOR,me);
		return 1;
    }
    me->set("take/劳动节","2009");
    me->add("combat_exp",100000);
	me->add("daoxing",100000);
        me->add("obstacle/number",20);
	me->add("potential",200000);
	message_vision("\n\n礼物大使拱手贺道：\n\n\n\n                  "+HIR"国   "+HIY"庆   "+BLU"快   "+HIG"乐   "+HIC"\n\n"+HIW"                       万   "+HIB"事   "+HIC"如   "+HIM"意\n\n\n\n\n"NOR,me);
	me->add("str",1);
	p=random(10);
	if (p==0)
	{
		me->add("str",1);
		message_vision("\n\n恭喜恭喜，你的先天臂力增加了。\n");
	}
	if (p==1)
	{
		me->add("cor",1);
		message_vision("\n\n恭喜恭喜，你的先天胆识增加了。\n");
	}
	if (p==2)
	{
		me->add("int",1);
		message_vision("\n\n恭喜恭喜，你的先天悟性增加了。\n");
	}
	if (p==3)
	{
		me->add("spi",1);
		message_vision("\n\n恭喜恭喜，你的先天灵性增加了。\n");
	}
	if (p==4)
	{
		me->add("cps",1);
		message_vision("\n\n恭喜恭喜，你的先天定力增加了。\n");
	}
	if (p==5)
	{
		me->add("per",1);
		message_vision("\n\n恭喜恭喜，你的先天容貌增加了。\n");
	}
	if (p==6)
	{
		me->add("con",1);
		message_vision("\n\n恭喜恭喜，你的先天根骨增加了。\n");
	}
	if (p==7)
	{
		me->add("kar",1);
		message_vision("\n\n恭喜恭喜，你的先天福缘增加了。\n");
	}
	if(p==8 || p==9)
	{
		message_vision("\n\n人品问题，不给天赋奖励。\n");
	}
	return 1;
}
void gift()
{
   object me=this_player();
   me->add("obstacle/rebirth",-1);
   write (HIC+"\n你有幸得到了仙侣情缘巫师组赐予的"+HIY+BLINK+"救命毫毛"+NOR+HIC+"。\n\n"NOR);
}
