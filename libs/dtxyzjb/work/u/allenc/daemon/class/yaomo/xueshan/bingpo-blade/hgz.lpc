#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
string msg;
int extra;
object weapon;
if(me->query("family/family_name")!="大雪山")
return notify_fail("「寒光斩」只有大雪山的人才可以用！\n");
 if( !target ) target = offensive_target(me);
if( !target  ||   !target->is_character()   ||      target->is_corpse()   ||      target==me)
return notify_fail("你要对谁施展这「寒光斩」?\n");
if( !me->is_fighting() )
return notify_fail("［寒光斩］只能对战斗中的对手使用。\n");
  extra = me->query_skill("bingpo-blade",1);
if (extra <120) return notify_fail("你的冰魄寒刀还不够纯熟！\n");
   if( (int)me->query("max_force") < 1500)
return notify_fail("你的内力太弱,不够施展「寒光斩」!!\n");
if ((int) me->query("force")<500) return notify_fail("你的内力不够！\n");
  weapon=me->query_temp("weapon");
  extra= extra /3;
me->add_temp("apply/attack",extra);
me->add_temp("apply/damage",extra);
message_vision(HIY  "\n$N使出「寒光斩」第一招，手中的"+ weapon->name()+  "闪电般向$n攻出第一刀！\n\n" NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),2);
message_vision(HIM"\n「寒光斩」第二招！\n\n"NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),2);
message_vision(MAG"\n「寒光斩」第三招！\n\n"NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),2);
me->add_temp("apply/attack",-extra);
me->add_temp("apply/damage",-extra);
me->start_busy(1+random(2));
return 1;
}
