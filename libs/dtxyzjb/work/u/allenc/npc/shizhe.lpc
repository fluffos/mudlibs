#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(MAG"紫藤使者"NOR, ({ "ziteng shizhe", "shizhe" }) );
         set("nickname", HIY"不知情愁枉少年"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是〖紫藤站〗的使者，向他打听“紫藤”，他会带给您想不到的惊喜。\n"NOR);
   //   set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
    //    set("max_qi", 100000);
    //    set("neili", 100000);
    //    set("max_neili", 100000);
    //    set("score", 100000);

        set("inquiry", ([
                         "紫藤" : (: ask_me :)
        ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
   command("whisper " + ob->query("id") + " "HIW"欢迎光临〖紫藤站〗"+HIR+"(ask shizhe about 紫藤) "+NOR+HIW+"， 小的助您行走江湖．"NOR);
//    command("xlqy " + HIC"紫藤站 更换ip 欢迎新老玩家,IP: 202.112.115.94 Port: 6666 \n"NOR);
}

string ask_me()
 {
        object me = this_player();
        object ob; 
        mapping fam; 
        
         if ((int) me->query("welcomexhc"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("welcomexhc", 1);
                me->set("maximum_force", 800);
                me->set("maximum_mana",800);
                me->add("force",1600);
                me->add("max_force",800);
                me->add("max_mana",800);
                me->add("mana",1600);
                me->add("potential", 50000);
                me->add("daoxing",80000);
            //    me->add("food", 1300);
            //    me->add("water", 10000);
                me->add("combat_exp",100000);
//下面就是给钱。其实除了move以外，还可以add存款。就是add banlance.
//目前是1 gold.你自己选奖励是什么。

 CHANNEL_D->do_channel(me, "xlqy", sprintf("在下%s今日光临〖紫藤站〗（ip:202.112.115.94 port: 6666）\n         现已得到紫藤使者的帮助和奖励！即日起开始行走江湖了！", me->name(1)));                return "欢迎光临"NOR+HIR"〖紫藤站〗"NOR"，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}
