#include <ansi.h>

inherit ITEM; 

int do_push(string);

void init()
{
  add_action("do_push", "push"); 
}

void create()
{
  set_name( HIY "紫藤宝树" NOR , ({"tree", "ziteng","ziteng tree"}));
  set_weight(9000);
  set("no_get",1);  
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "株");
    set("long", "这是一棵长在仙界的紫藤树.树上挂满了漂亮的礼盒。树干上有几个字：\n\n"
HIR"                  仙侣奇缘树(push)。\n"NOR);
    set("value", 0);
  }
  set("is_monitored",1);
  setup();
}

int do_push(string arg)
{
  object me, ob;
  int vkar,gain1,gain2;
  me = this_player(); 
  vkar=(int)me->query("kar");

  if (arg!="tree" && arg!="ziteng" && arg!="ziteng tree")
            return notify_fail("你想推什么？看清楚再推啊。。。\n");
            
/* 
  if (ob->query("tree"))
            return message_vision(HIG"你已经推过啦，还推。一人一次嘛。去，一边去玩去!\n\n");
  //限制推的次数，功能保留.*/
  

  message_vision(HIG "$N轻轻的推了推树干一个盒子掉到了你身上.你慢慢的打开盒子，一阵轻烟升起.\n\n" NOR, me);  
  message_vision(HIG "一阵轻烟过后，你觉得自己变强了!\n" NOR, me);  
  me->set("tree",1);
  gain1=vkar * (200+random(500))/2;
  gain2=vkar * (50* (50+random(80)))/2;
  me->add("potential",gain1); 
  me->add("daoxing",gain2);
//摧毁这株树
  destruct(this_object()); 
  return 1;
}
 

