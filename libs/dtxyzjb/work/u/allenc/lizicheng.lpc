void init() 
{ 
 ::init(); 
 set("chat_chance", 10); 
 set("chat_msg", ({ 
  "张自成说道：「武功」本天成，妙手偶得之。\n", 
  "张自成说道：冰水为之而寒于水，青出于蓝而胜于蓝。\n", 
 }) ); 
 add_action("do_query", "query_nova"); 
 add_action("do_rename", "rename_nova"); 
 add_action("do_delete", "delete_nova"); 
} 
int ask_nova() 
{ 
       object me=this_object(); 
       object ob=this_player(); 
       message_vision("张自成一捋胡子，笑呵呵地说道：你算问对人了，" + 
             RANK_D->query_self(me)+"专门负责有关武功自创方面的问题。\n",me) 
; 
       tell_object(ob,"你可以使用下列有关命令：\n\n"); 
       tell_object(ob,"    query_nova    ： 查询当前的自创招式\n"); 
       tell_object(ob,"    rename_nova   ： 将某一自创招式改名\n"); 
       tell_object(ob,"    delete_nova   ： 去掉某一自创招式\n\n"); 
       message_vision(WHT"张自成接着说道：这位"+RANK_D->query_respect(ob)+"下 
一步想做什么？\n"NOR,me,ob); 
       return 1; 
} 
