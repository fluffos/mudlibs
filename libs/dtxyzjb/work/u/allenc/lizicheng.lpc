 "skill_sanqing-jian", 
 "skill_qixiu-jian", 
 "skill_snowsword", 
 "skill_bainiao-jian", 
 "skill_wuying", 
 "skill_yujianshu", 
 "skill_bawang-qiang", 
 "skill_wuyue-spear", 
 "skill_hellfire-whip", 
 "skill_yinsuo-jinling", 
 "skill_qianjun-bang", 
 "skill_huntian-hammer", 
 "skill_lunhui-zhang", 
}); 
string *can_nova_name = ({ 
 "三清剑法", 
 "七修剑法", 
 "风回雪舞剑", 
 "百鸟剑法", 
 "无影剑", 
 "御剑术", 
 "霸王枪法", 
 "五岳神枪", 
 "烈火鞭法", 
 "银索金铃", 
 "千钧棒法", 
 "混天锤法", 
 "轮回杖法", 
}); 
int do_query() 
{ 
   object me=this_player(); 
/* 
自创武功招式的数据结构简述： 
    这里用数组m_actions来读取所有自创武功的所有的自创招式。 
    数组m_actions是由若干元素组成的。每一个元素对应一种可以自创的武功。 
    每一个m_actions元素也是一个数组，由若干个结构完全相同的m_act项构成的。每 
一 
个m_act项对应该项武功的一个自创招式。 
    每一m_act项都是一个mapping的数据类型，有action,name,damage,damage-type, 
force,dodge,parry七个属性，分别对应该项自创招式的招式描述、招式名称、伤害值、 
  
伤害类型、内功修正、闪躲修正和招架修正。 
    由于自创招式的名字可能相同，区别此招式非彼招式的关键是武功被使用时的招式 
描 
述，即m_act中的action项。 
    在武功被自创的时候，action由三部分组成：招式描述的头部，自创武功的招式名 
称 
以及招式描述的尾部。 
    从数据库原理上看，数组m_actions的每一个元素，构成一个关系数据库的表：纵向 
是 
由action作为主键的一个一个m_act，横向为m_act的属性。 
    一个表是一个二维的结构，再加上不同的自创武功，可以看成是一个三维的数据库 
。其 
中三维的数据库是按照不同的武功进行分页的。每一页是一个二维结构的关系数据表， 
对应 
该武功的所有的自创招式。 
    图示如下： 
      |~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ 
      | 霸王枪法 
      |    |~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ 
      |    | 混天锤法 
      |    |    |~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ 
      |    |    | 风回雪舞剑 
      |    |    |    name    damage   force  dodge  parry  ...... 
      |    |    |    雪百合    87       55    -25    -13 
      |    |    |    风雷破    87       55    -25    -13 
      |    |    |    剑霜忍    87       55    -25    -13 
      |    |    |    ...... 
*/ 
   mapping *m_act=({}); 
   int i,j,has_nova=0; 
   for (i=0;i < sizeof(can_nova_skills);i++) { 
        m_act=me->query(can_nova_skills[i]); 
        if(!pointerp(m_act)) 
        { 
             m_act=({}); 
        } 
        else 
        { 
             has_nova++; 
             write(can_nova_name[i]+"：  \n"); 
             for(j=0;j < sizeof(m_act);j++) { 
                 write("  "+(j+1)+".  "HIM+m_act[j]["name"]+NOR"    "); 
                 //巫师调试用。 
                 //write(m_act[j]["action"]); 
                 write("\n"NOR); 
             } 
             m_act=({}); //对于不同的武功，要对m_act清零。 
        } 
   } 
   if(has_nova == 0) 
        tell_object(me,HIR"你目前没有任何自创招式。\n"NOR); 
   else 
        tell_object(me,HIR"\n你目前  "HIW+chinese_number(has_nova)+HIR"  种武 
功有自创招式。\n"NOR); 
   return 1; 
} 
int do_rename(string arg) 
{ 
   object me=this_player(); 
   mapping *m_act=({}); 
   string skillname,newname; 
   int seq; 
   if(!arg || sscanf(arg, "%s of %d to %s", skillname, seq, newname)!=3 ) 
       return notify_fail 
       ("指令格式：rename_nova <武功英文名称> of <自创招式序号> to <新自创名 
字>\n"); 
   skillname = "skill_" + skillname; 
   m_act=me->query(skillname); 
   if(!pointerp(m_act)) 
   { 
        m_act=({}); 
        tell_object(me,HIR"\n你这项武功没有任何自创招式。\n"NOR); 
        return 1; 
   } 
   else 
   { 
        seq=seq-1; 
        if( seq < 0 || seq >sizeof(m_act))  { 

             tell_object(me,HIR"\n你这项武功没有这个自创招式。\n"NOR); 
             return 1; 
        } 
        m_act[seq]["action"]=replace_string(m_act[seq]["action"],"「"+m_act[ 
seq]["name"]+"」","「"+newname+"」"); 
        m_act[seq]["name"]=newname; 
        me->set(skillname,m_act); 
        me->save(); 
        m_act=({}); 
        tell_object(me,HIR"\n自创招式改名成功。\n"NOR); 
        return 1; 
   } 
} 
int do_delete() 
{ 
   object me=this_player(); 
   tell_object(me,HIR"\n目前暂不开放此项服务。\n"NOR); 
   return 1; 
} 