        return 1;
}

int do_dark()
{
        int i;
        object me=this_player();
        string title;
        if(me->query("daoxing") < 100000)
                {
                tell_object(me,"你的道行太低了，不能申请黑暗圣斗士。\n");
                return 1;
                }
        title = me->query("title");
        title=canceltitle(title);
