// create by heyes  2002年5月30日

#include <ansi.h>

inherit ITEM;//继承物品
inherit F_SAVE;//继承可save的属性

mapping *all_biao;//全局变量，储存玩家所有数据

int help();//函数声明
int do_apply(int num);
int do_cancel(int num);
int do_view();
int do_silver();
int do_bronze();
int do_sea();
int do_dark();
int do_getarmor();
string canceltitle(string title);
void enough_rest();

void create()
{
        set_name(HIG "※"+HIY+"黄金圣斗士英雄榜"+HIG+"※" NOR , ({ "bang","yingxiong bang" }) );
        set("long","英雄榜记录着夺得黄金圣斗士称号的玩家名字，而且在这里可以拿到黄金圣衣。\n如想看英雄榜就 view ；如想拿圣衣 getarmor；如想取得各种圣斗士称号 read 。\n");
        set("unit", "张");
        set("no_put", 1);
        set("no_get", 1);
        set_weight(900000000);//设大点不让玩家Get
        seteuid(getuid());
        restore();
}

void init()
{
        add_action("do_apply","apply");
        add_action("do_view","view");
        add_action("do_cancel","cancel");
        add_action("do_silver","silver");
        add_action("do_sea","sea");
        add_action("do_dark","dark");
        add_action("do_bronze","bronze");
        add_action("help","read");
        add_action("do_getarmor","getarmor");

}

string query_save_file()
{
        return DATA_DIR + "12gong/piao.o";//你可以定义一个储存文件的路径
}
string canceltitle(string title)
{
        title = replace_string(title, "白银圣斗士", "");
        title = replace_string(title, "海洋圣斗士", "");
        title = replace_string(title, "青铜圣斗士", "");
        title = replace_string(title, "黑暗圣斗士", "");
        return title;
}
int do_apply(int num)//     1<=num<=12
{
        int i,j;
        object me = this_player();
        if (!me->query("12gong/banghui"))
                {
                printf("你还是先去救出女神，向女神申请圣斗士称号吧\n");
                return 1;
                }
        if(!num || sscanf(num, "%d", num) != 1)//分析玩家指令
                {
                help();
                return 1;
                }
        if ( num<1 || num >12)
                {
                printf("并没有这个圣斗士头衔呀。\n");
        help();
                return 1;
                }
        if( !pointerp(all_biao) || !sizeof(all_biao) ) //表示还没有数据
                {
                        write("\n还没有数据库。\n");
                        return 1;
                }
        for(i=0;i<sizeof(all_biao);i++)
                if(all_biao[i]["id"]==me->query("id"))
                {
                        printf("你已经是%s"+HIY+"黄金圣斗士"+NOR+"了。\n",all_biao[i]["title"]);
                        //me->set("title",all_biao[i]["title"]);
                        me->set("title",all_biao[i]["title"]+HIY+"黄金圣斗士"+NOR);
                        me->save();
                        return 1;
                }
        num=num-1;
        if (all_biao[num]["name"]=="暂缺")// || FINGER_D->finger_date(all_biao[num]["id"])>=15)
                {
                if(!wizardp (me))
                        {
                        all_biao[num]["name"]=me->query("name");
                        all_biao[num]["id"]=me->query("id");
                        save();//储存进这个文件对应的.o文件里
                        }

                me->set("title",all_biao[num]["title"]+HIY+"黄金圣斗士"+NOR);
                me->save();
                message("channel:chat",HIW+"【圣域传说】雅典娜(Athena)："+HIG+me->query("name")+HIW+"顺利闯过黄道十二宫，授予他"+NOR+all_biao[num]["title"]+HIY+"黄金圣斗士"+HIW+"头衔。"+NOR+"\n",users());
                remove_call_out("enough_rest");
                call_out("enough_rest", 1);//1秒后取消busy
                return 1;
                }
        else
                {
                write("\n这个头衔已经有人了，选个别的头衔吧。\n");
                return 1;
                }
        return 0;
}

int do_getarmor()
{
        string *target =({
        "baiyang/obj/baiyang",
        "jinniu/obj/jinniu",
        "shuangzi/obj/shuangzi",
        "juxie/obj/juxie",
        "shizi/obj/shizi",
        "chunv/obj/chunv",
        "tianping/obj/tianping",
        "renma/obj/renma",
        "tianxie/obj/tianxie",
        "shanyang/obj/shanyang",
        "baoping/obj/baoping",
        "shuangyu/obj/shuangyu",
});
        int i;
        object me = this_player();
        object obj;

        if( !pointerp(all_biao) || !sizeof(all_biao) ) //表示还没有数据
                {
                write("\n还没有数据库。\n");
                return 1;
                }
        if(wizardp (me))
                {
                obj=new("/d/12gong/"+target[random(12)]);
                obj->set("armor_prop/armor", 1000);
                obj->move(me);
                message_vision(HIY"雅典娜从五彩祥云中走出来，凌空一指，变出了一件黄金圣衣交给$N。\n"NOR,me);
                return 1;
                }
        if (!me->query("12gong/banghui"))
                {
                printf("你还是先去救出女神，向女神申请圣斗士称号吧\n");
                return 1;
                }
        for(i=0;i<sizeof(all_biao);i++)
                if(all_biao[i]["id"]==me->query("id"))
                {
                obj=new("/d/12gong/"+target[i]);
                obj->set("armor_prop/armor", 200);
                obj->set("no_get",1);
                obj->move(me);
                me->set("title",all_biao[i]["title"]+HIY+"黄金圣斗士"+NOR);
                message_vision(HIY"雅典娜从五彩祥云中走出来，凌空一指，变出了一件黄金圣衣交给$N。\n"NOR,me);
                return 1;
                }

        if (i >= sizeof(all_biao))
                {
                int t=random(12);
                obj=new("/d/12gong/"+target[t]);
                obj->set("armor_prop/armor", 100);
                obj->set("no_get",1);
                obj->move(me);
                me->set("title",all_biao[t]["title"]+HIY+"黄金圣斗士"+NOR);
                write("看来你不是现任的黄金圣斗士，雅典娜只能给你一件防御力较小的黄金圣衣\n");
                }
        return 1;
}

void enough_rest()
{
        delete_temp("busy");
}

int do_view()//玩家查看
{
        int i;
        if( !pointerp(all_biao) || !sizeof(all_biao) ) //表示还没有数据
                {
                write("\n还没有数据库。\n");
                return 1;
                }

        write(WHT+"************   "+HIY+"黄金圣斗士"+HIG+"英雄榜"+NOR+WHT+"   ************\n\n"NOR);
        for ( i=0 ; i<12 ;i++ )
                {
                if(all_biao[i]["name"]=="暂缺")
                        write("\t"+(i+1)+"\t"+all_biao[i]["title"]+NOR+"\t\t"+all_biao[i]["name"]+"\n");
                //else if(FINGER_D->finger_date(all_biao[i]["id"])<=10)
                        //write("\t"+(i+1)+"\t"+all_biao[i]["title"]+"\t\t"+all_biao[i]["name"]+"("+all_biao[i]["id"]+")"+NOR+"\n");
                else
                        printf("\t"+(i+1)+"\t"+all_biao[i]["title"]+"\t\t"+all_biao[i]["name"]+"("+all_biao[i]["id"]+")\n"+NOR);//+"\t\t\t离线：%d天\n",FINGER_D->finger_date(all_biao[i]["id"]));
                }
        return 1;
}

int do_cancel(int num)
{
        object me = this_player();
        if (!wizardp (me))
        {
                write("你没有这个权限!!\n");
                help();
                return 1;
        }
        if(!num || sscanf(num, "%d", num) != 1)//分析玩家指令
                {
                write("指令格式不对!\n");
                help();
                return 1;
                }
        if ( num<1 || num >12)
        {
                printf("没有这个职位。\n");
        help();
                return 1;
        }
        if( !pointerp(all_biao) || !sizeof(all_biao) ) //表示还没有数据
                {
                write("\n还没有数据库。\n");
                return 1;
                }
        num=num-1;
        all_biao[num]["name"]="暂缺";
        all_biao[num]["id"]="000000";
        save();//储存进这个文件对应的.o文件里
        remove_call_out("enough_rest");
        call_out("enough_rest", 1);//1秒后取消busy
        tell_object(me,"你成功的将一个称号删除。\n");
        return 1;
}

int do_silver()
{
        int i;
        object me=this_player();
        string title;
        if(me->query("daoxing") < 300000)
                {
                tell_object(me,"你的道行太低了，不能申请白银圣斗士。\n");
                return 1;
                }
        title = me->query("title");
        title = canceltitle(title);
        me->set("title",HIW+"白银圣斗士"+NOR+title);
        message("channel:chat",HIC+"【圣域传说】雅典娜(Athena)："+HIG+me->query("name")+HIC+"被授予"+HIW+"白银圣斗士"+HIC+"头衔。"+NOR+"\n",users());
        return 1;
}

int do_sea()
{
        int i;
        object me=this_player();
        string title;
        if(me->query("daoxing") < 300000)
                {
                tell_object(me,"你的道行太低了，不能申请海洋圣斗士。\n");
                return 1;
                }
        title = me->query("title");
        title=canceltitle(title);
        me->set("title",HIB+"海洋圣斗士"+NOR+title);
        message("channel:chat",HIC+"【圣域传说】雅典娜(Athena)："+HIG+me->query("name")+HIC+"被授予"+HIB+"海洋圣斗士"+HIC+"头衔。"+NOR+"\n",users());
        return 1;
}

