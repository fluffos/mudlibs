inherit F_VENDOR_SALE;

void create()
{
  reload("yadian_doctor_yadian");
  set_name("老板", ({"laoban", "boss",}));
  set("shop_id", ({"laoban", "boss",}));
  set("shop_title", "老板");
  set("gender", "男性");
  set("combat_exp", 50000);
  set("daoxing", 300000);

  set("age", 28);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set("vendor_goods", ([
        "yao": "/d/12gong/yadian/obj/yao",
        "coffee": "/d/12gong/yadian/obj/coffee",
        "dan": "/d/12gong/yadian/obj/dan",
        //"baowu":"/u/batmanlp/dubo",
        "shan e dian": "/d/12gong/yadian/obj/shanedan",
      ]) );

  setup();
}

void init()
{
  ::init();
  add_action("do_vendor_list", "list");
}


