#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int rank_me();

void create()
{
        set_name(HIC"波士顿"NOR, ({"hai huang","hai","king",}));
        set("gender", "男性" );
        set("age", 20);
        set("title",HIY"海皇"NOR);
        set("long", "他是掌管七海的海皇。\n");
        set("combat_exp", 6000000);
        set("daoxing",5000000);
        set("attitude", "peaceful");
        set("force", 2500);
        set("max_force", 2500);
        set("force_factor", 100);
        set("max_mana", 2500);
        set("mana", 2500);
        set("mana_factor", 100);
        set_skill("dodge", 300);
        set_skill("unarmed", 300);
        set_skill("literate", 300);
        set_skill("parry", 300);
        set("per", 40);
        set("max_kee", 20000);
        set("max_gin", 1000);
        set("max_sen", 10000);
        setup();
        carry_object("/d/7hai/shendian/obj/shenyi")->wear();
        carry_object("/d/7hai/shendian/obj/qiang")->wield();
}
void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
object me = this_object();
 object ob = query_temp("last_damage_from");
 call_out ("haihuang_appearing",1,ob);
 load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/7hai/shendian/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}


