#include <ansi.h>
#include <weapon.h>
inherit SPEAR;

void create()
{
        set_name(HIY "黄金枪"NOR, ({ "qiang"}));
        set_weight(7000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", HIC"希腊神话中海皇波士顿的儿子克修拉的"+HIY+"黄金枪"+HIC+"。\n"+NOR);
                set("value", 1000000);
                set("no_sell",1);
                //set("no_give", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("material", "steel");
                set("weapon_prop/personality", 24);
                set("wield_msg", HIC"$N凌空一指，变出了一只$n"+HIC+"握在手中。\n"NOR);
                set("unwield_msg", "$N把$n向海中抛去，$n消失了。\n");
        }
        init_spear(150);
        setup();
}
