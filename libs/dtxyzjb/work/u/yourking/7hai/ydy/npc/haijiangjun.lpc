#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int rank_me();

void create()
{
        set_name("克修拉", ({"hai jiangjun","hai","jiangjun",}));
        set("gender", "男性" );
        set("age", 20);
        set("title",HIY"海将军"HIW"-"HIC"海皇子星座"NOR);
        set("long", "他是守护印度洋之柱的海斗士。\n");
        set("combat_exp", 3400000);
        set("daoxing",5000000);
        set("attitude", "peaceful");
        set("force", 2500);
        set("max_force", 2500);
        set("force_factor", 100);
        set("max_mana", 2500);
        set("mana", 2500);
        set("mana_factor", 100);
        set_skill("dodge", 180);
        set_skill("unarmed", 180);
        set_skill("literate", 180);
        set_skill("parry", 180);
        set("per", 23);
        set("max_kee", 20000);
        set("max_gin", 1000);
        set("max_sen", 10000);
        setup();
        carry_object("/d/7hai/ydy/obj/linyi")->wear();
        carry_object("/d/7hai/ydy/obj/qiang")->wield();
}
void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
object me = this_object();
 object ob = query_temp("last_damage_from");
 call_out ("haihuang_appearing",1,ob);
 load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/7hai/ydy/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}


