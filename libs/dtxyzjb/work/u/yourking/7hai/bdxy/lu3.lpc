inherit ROOM;

void create ()
{
  set ("short", "小路");
  set ("long", @LONG

    连接海底神殿和各海支柱的小路。

LONG);


  set("exits", ([ /* sizeof() == 2 */
  "southeast" : __DIR__"lu2",
  "northwest" : __DIR__"zhizhu",

]));

  set("no_fly", 1);
  setup();
}
void init()
{
  add_action("do_all", "",1);
}

int do_all(string arg)
{

  if (this_player()->query("7hai/ndxy")=="done")
    set("exits/northwest", __DIR__"zhizhu");
  else
    set("exits/northwest", "/d/7hai/nby/lu2");
  return 0;
}





