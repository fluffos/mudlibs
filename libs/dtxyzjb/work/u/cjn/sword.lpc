#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name( HIW "楚江南的守护" NOR, ({ "cjn's sword", "jian", "sword" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",  HIW"一把由万年寒冰练成的冰剑。\n"NOR);
                set("value", 0);
                set("material", "steel");
                set("wield_msg", HIC"$N"HIC"轻轻一弹,"HIW"$n"HIC"悄然晃出,剑身发出阵阵幽香。\n"NOR);
                set("unwield_msg", HIC"$N"HIC"吹了声口哨"HIW"$n"HIC"随着淡淡的清香消失。\n"NOR);
                set("weapon_prop/int", 2);
                set("music/type", "xiao");     
 }

   set("no_sell", 1);
   set("no_steal", 1);
   set("no_drop", 1);
   set("no_put",1);
        init_sword(300);
        setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;
        pro = (int) victim->query_temp("apply/armor_vs_spells");
        dam = (int) me->query("force");


        damage = (int) me->query("force_factor");
        if(dam > pro)
        {
        victim->start_busy(2);
        return HIC "楚江南的守护发出耀眼光芒，$n眼睛被晃的睁不开了。\n" NOR;
        }
}
int query_autoload(){return 1;}

