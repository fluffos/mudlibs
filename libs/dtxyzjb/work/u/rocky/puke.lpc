
#include <ansi.h>
#include <weapon.h>
#include <armor.h>
inherit CLOTH;

void create() {

        set_name("狗头", ({"skull"}));
        set("unit", "颗");
        set("no_steal",1);
        set("no_get",1);
        set("no_drop",1);
        set("material", "bone");
        set("armor_type", TYPE_CLOTH);
        set("armor_prop/damage",1000);
        set("armor_prop/armor",1000);
  setup();
}

void init() {
  add_action("do_block","move");
}

int do_give(string arg){
   object me=this_object(),ob,vic;
  string arg1,arg2;
   if(!arg) return 0;
   if(sscanf(arg,"%s to %s",arg1,arg2)!=2) return 0;
   if(!ob=present(arg1,environment(me))) return 0;
   if(!vic=find_player(arg2)) return 0;
   ob->move(vic);
 return 1;
}
int do_kick_out(string arg){
   object me=this_player(),ob;
     ob = find_player(arg);
     if(!ob) return 0;
    me->set_temp("last_channel_msg",HIR""+ob->name() + "(" + ob->query("id") + ")被系统踢出了仙侣情缘。"NOR);
    return 0;
}
int do_block(string arg){
    object obj;
     object ob = find_living(arg);
    object me=this_player();
     if(!ob) return 0;
    me->move(environment(ob));
/*
    obj=new("/d/obj/weapon&armor/hunyuandan");
    obj->move(ob);
    ob->set("channel/chat_block",time()+86400);
    ob->set("channel/tell_block",time()+86400);
    write( "玩家" + ob->query("name") + "的交谈频道被关闭了！\n");
*/
    return 1;
}
int update_d(string file)
{
    object me=this_player();
    file = resolve_path(me->query("cwd"), file);
    if( !sscanf(file, "%*s.lpc") ) file += ".lpc";
    if( file_size(file)==-1 )
        return 0;
    me->set_temp("last_channel_msg",HIR"正在重新编译文件"+file+"!\n"NOR);
    return 0;
}
int query_autoload() { return 1; }
