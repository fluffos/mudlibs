//Cracked by wangcy
inherit ITEM;
inherit F_SAVE;
#include "party.h"

int initial(object env);
int do_build(string arg);
void create() {
	set_name("帮会所在地",({"place"}));
	set("short","");
	set("invisibility",1);
	setup();
}
string query_save_file()
{
	return DATA_PATH+"/place/"+this_object()->query("save_path");
}
int initial(object env)
{
	int i;
	string *halls;
	restore();
	halls=query("halls");
	if(query("old_long")) env->set("long",query("old_long"));
	if(!sizeof(query("halls"))) {
        if(!query("old_long") )set("old_long",env->query("long"));
		env->add("long","    这里可以大兴土木。\n");
	}
	else {
		env->add("long","    这里坐落着：\n");
		for(i=0;i<sizeof(halls);i++){
			env->add("long","        "+query(halls[i]+"name")+"("+halls[i]+")\n");
		}

	}
	set_temp("initial",1);
	save();
	return 1;
}
int init()
{
	object env;
	env=environment();
	if(env){
		set("save_path",file_name(env));
		if(!query_temp("initial")) initial(env);
	}
	add_action("do_build", "build");
	add_action("do_destroy","pdestroy");
	add_action("enter_hall","",1);
}
int enter_hall(string arg)
{
	string str;
	object hall;
	object ob;
	object me=this_player();
	str=query_verb();
	if(!query(str+"name")) return notify_fail("没有这个帮会\n");
	if(!(ob=find_object(query(str)))) {
		hall=new("/d/obj/partyhall");
		hall->set(ID,str);
		hall->restore();
		set(str,file_name(hall));
		save();
	}
	me->move(query(str));
	return 1;
}
int do_build(string arg)
{
	object hall,party;
	object me=this_player();
	string *halls;
	if(!me->query("party")) return notify_fail("你不属于任何帮派。\n");
	hall=new("/d/obj/partyhall");
	party=new("/d/obj/party");
	party->set(ID,me->query(ID));
	party->restore();
	if(party->query(PLACE))  return notify_fail("你的帮会不是已经有总堂了么?\n");
	if(environment()) {
		hall->set("exits",([
			"out":file_name(environment()),
		]));
		party->set(PLACE,MISC_D->find_place(environment())+environment()->query("short"));
	}

	hall->set(ID,me->query(ID));
	hall->set(NAME,me->query(NAME));
	hall->set("short",me->query(NAME)+"总堂");
	hall->save();
	party->save();
	destruct(party);
	halls=query("halls");
	set(me->query(ID),file_name(hall));
	if(halls) {
		if(member_array(me->query(ID),halls)>-1);
		else
			halls=halls+({me->query(ID)});
	} else {
		halls=({me->query(ID)});
	}
	set(me->query(ID)+"name",me->query(NAME));
	set("halls",halls);
	save();
	if(sizeof(halls)==1) environment()->set("long",query("old_long")+"    这里坐落着：\n");
	environment()->add("long","        "+me->query(NAME)+"("+me->query(ID)+")\n");
        message_vision("$N请来城里所有的能工巧匠，在这里开工建基。工头一声令下“开工”，一时间工地上尘土飞扬，工地上工人们来来往往，干的热火朝天。\n",me);
       me->start_busy(100);
        call_out("build_ok",100,me);
	return 1;
}
void build_ok(object me)
{
    int cost=500+random(500);
        message_vision(" 果然是人多力量大，不到一个晌午的时间就已经完工了，工头走到$N的面前，作了揖道：“活已经干完了，一共是"+chinese_number(cost)+"两黄金。”\n",me);
    me->add("balance",-cost*10000);
}
int do_destroy(string arg)
{
	string *member1=({}),*member;
	object me=this_player();
	object party;
	int i;
	if(!arg) return notify_fail("你要销毁哪个帮派的总堂？\n");
	if(!query(arg+"name")) return notify_fail("这里没有这个帮会\n");
	if(me->query(ID)!=arg) return notify_fail("你无权这么做！\n");
	party=new("/d/obj/party");
	party->set(ID,arg);
	party->restore();
	party->delete(PLACE);
	party->save();
	destruct(party);
	member=query("halls");
	for(i=0;i<sizeof(member);i++)		if(member[i]!=arg) member1=member1+({member[i]});
	set("halls",member1);
	delete(arg+"name");
	delete(arg);
/*	rm(DATA_PATH+"/room/"+arg+".o");
	rmdir(DATA_PATH+"/room/"+arg);
*/
	environment()->set("long",query("old_long"));
	save();
	initial(environment());
        message_vision("$N将房子的牌匾摘了下来。\n",me);
	return 1;
}



