//pcreat.c
//Wangcy
//建立帮会

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;
#define BANNED_ID                 "/adm/etc/banned_id"
int check_legal_id(string id);
int check_legal_name(string name, int max_len);
void get_name(string arg, string id,object me);
int check_party(object ob);


int main(object me, string arg)
{
	string p_file;
	if(me->query("party")) return notify_fail("难道你想另立门户?\n");
	if(!master_limite(me)) return notify_fail("再积累些经验吧。\n");
	if (!arg) return notify_fail("请输入帮会id\n");
	if (check_legal_id(arg));
	else return 1;
	p_file=DATA_PATH+arg+".o";
	if(file_size(p_file)>0) return notify_fail("这个帮会已经存在了,请更换id\n");
	write("请为你的帮会起一个响亮的名字:(q键取消)");
	input_to( (: get_name :), arg ,me);
	return 1;
}

void get_name(string arg, string id,object me)
{
	if( arg == "q" || arg == "Q" )
		return;
	if (check_legal_name(arg,10));
	else return ;
	message("channel:chat",HIY"\n【帮派天下】"+me->query("name")+"决定开帮立业，建立【"+arg+"】，成就自己的一番事业！还请各位志同道合的兄弟们响应！\n                                                                 指令：pjoin "+me->query("id")+"\n"+NOR,users());
	me->set_temp(CREATING,1);
	me->set_temp(ID,id);
	me->set_temp(NAME,arg);
	call_out("check_party",120,me);
}


int check_legal_id(string id)
{
	int i;
	string	*legalid;
	
	i = strlen(id);
    if( (strlen(id) < 3) || (strlen(id) > 10 ) ) {
                write("对不起，帮会 id 必须是 3 到 10 个英文字母。\n");
		return 0;
    }
    while(i--)
    	if( id[i] != ' ' && (id[i]<'a' || id[i]>'z') )  {
    		write("对不起，帮会 id 只能用英文字母。\n");
    		return 0;
    	}
    
    legalid = explode(read_file(BANNED_ID), "\n");
    for(i=0; i<sizeof(legalid); i++)   {
    	if( id == legalid[i] )   {
    		write("对不起，这种 id 会造成其他人的困扰。\n");
    		return 0;
    	}
    }
    
    return 1;
}
int check_legal_name(string name, int max_len)
{
	int i;
	string	*legalname;		//not implemented..may add later
	
	i = strlen(name);
    if( (strlen(name) < 2) || (strlen(name) > max_len ) ) {
    	write( sprintf("对不起，帮会中文字必须是 1 到 %d 个中文字。\n",
    	 max_len/2) );
		return 0;
    }
    while(i--)   {
    	if( name[i]<=' ' )   {
    		write("对不起，帮会中文字不能用控制字元。\n");
    		return 0;
    	}
    	if( i%2==0 && !is_chinese(name[i..<0]) )  {
    		write("对不起，请您用「中文」给帮会取名字。\n");
    		return 0;
    	}
    }
   
    return 1; 
}
int check_party(object ob)
{
	string *member;
	object ob1;
	int i;
	if(!ob->query_temp(CREATING)) return 1;
	ob->delete_temp(CREATING);
	ob->delete_temp(ID);
	ob->delete_temp(NAME);
	member=ob->query_temp(JOINED);
	ob->delete_temp(JOINED);
	for(i=0;i<sizeof(member);i++){
		ob1=find_player(member[i]);
		if(!ob1) continue;
		ob1->delete_temp(JOINING);
	}
	message("channel:chat",HIY"\n【帮派天下】"+ob->query("name")+"本想开帮立业成就一番事业，苦于无志同之士响应，只好作罢。\n\n"NOR,users());
	return 1;
}
int help()
{
  write(@TEXT
指令格式：pcreat 帮派ID
创建自己的帮会.
TEXT
  );
  return 1;
}
