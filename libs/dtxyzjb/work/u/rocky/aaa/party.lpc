inherit ITEM;
inherit F_SAVE;

#include "party.h"

void create() {

        set_name("帮会", ({"party" }));
        set_weight(10);
        set("unit", "个");
  setup();
}

string query_save_file()
{
  return DATA_PATH +this_object()->query(ID);
}
int initial(){
	set(MASTER_NUM,1);
	set(SUBMASTER_NUM,2);
	set(LEADER_NUM,4);
	set(MEMBER_NUM,-1);
	set(MASTER_NICK,"帮主");
	set(SUBMASTER_NICK,"副帮主");
	set(LEADER_NICK,"堂主");
	set(MEMBER_NICK,"帮众");
	return 1;
}