
#include <ansi.h>

inherit NPC;

void create()
{
  set_name("呦个", ({"yog"}));
  set("gender", "男性" );
  set("attitude", "peaceful");
  set("max_kee", 500);
  set("max_sen", 500);
        remove_call_out("choose_npc");
        call_out("choose_npc",3);      

}

void choose_npc()
{
      object ob;
    if(!this_object()->query("call")) return;
    ob=find_player(this_object()->query("call"));
    if(!ob) return;
     ob->set_temp("mieyao/level",8);
        reset_eval_cost();
        remove_call_out("choose_npc");
        call_out("choose_npc",30);
}

