// dog.c

#include <ansi.h>
inherit NPC;

void create()
{
set_name(""HIW"奔驰S600"NOR"", ({"benchi"}));
        set("race", "野兽");
        set("age", 20);

	set("combat_exp", 10000);
  set("daoxing", 5000);

        set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
        set("verbs", ({ "bite"}));

set("ride/msg", "打开车门,座了进去");
        set("ride/dodge", 18);
        set_temp("apply/attack", 10);
        set_temp("apply/armor", 20);

        setup();
}


