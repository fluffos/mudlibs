void jjf(object me)
{
	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗白发老人(Lao ren)：世事难料，代代倍有人才出，老夫特来道喜。\n\n"NOR,users());
    call_out("wzg", 2, me);
}

void wzg(object me)
{
	object ob;
	ob=new("/d/obj/drug/renshen-guo");
	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗镇元大仙(Zhenyuan daxian)：逢此大喜之事，怎么能缺了老夫，特备"+HIW"人参果"+HIC"三颗赠与hoho"+RANK_D->query_respect(me)+"寥表心意。\n\n"NOR,users());
    ob->move(me);
    message("channel:rumor", HIM + "【谣言】某人：听说幻想西天得到"+HIW"人参果"+HIM"了。\n"NOR,users());
	ob->move(me);    
    message("channel:rumor", HIM + "【谣言】某人：听说幻想西天得到"+HIW"人参果"+HIM"了。\n"NOR,users());
    ob->move(me);    
    message("channel:rumor", HIM + "【谣言】某人：听说幻想西天得到"+HIW"人参果"+HIM"了。\n"NOR,users());
	call_out("pansi", 2, me);
}

