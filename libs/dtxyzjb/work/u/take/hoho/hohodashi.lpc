#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIY"大使"NOR, ({ "da shi", "shi" }) );
        set("title","阁门");
        set("gender", "男性");
        set("age", 60);
        set("combat_exp", 300000+random(20000));
        set("attitude", "heroism");

        set("str", 30);
        set("per", 30);
        set("max_kee", 600);
        set("max_gin", 600);
        set("force", 600);
        set("max_force", 600);
        set("force_factor", random(20)+25);
        set_skill("unarmed", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);

        setup();

        carry_object("/d/qujing/baoxiang/obj/changpao")->wear();
}

void init()
{
   object me = this_player();
   ::init();
   add_action("do_kill", "kill");
   add_action("do_steal", "steal");
   add_action("do_cast", "cast");
   add_action("do_get", "get");
   add_action("do_fight", "fight");
   add_action("do_say", "say");
   if( interactive(me)) {
                remove_call_out("greeting");
                call_out("greeting", 1, me);
        }
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
		if (ob->query("gift/hoho")=="done")
		{
			ob->move("/d/city/kezhan");
            message_vision ("这里正在庆祝巫师hoho喜添小baby，你就不要来添乱子了。\n"NOR,ob);
			return 0;
		}
		ob->add("daoxing",50000);
        if (!wizardp(ob))
        ob->set("gift/hoho","done");
		message_vision (HIY"\n\n\n一到这里$N"+HIY"便被这喜庆的气氛所影响，顿时觉得道行修为大增。\n\n\n"NOR,ob);

		if (wizardp(ob))
		{
            message("chat",HIC+"〖"+HIW+"幻想西天"+HIC+"〗月下老人(Lao ren)：巫师"+HIC""+ob->query("name")+HIC"前来祝贺"+HIY"幻想西天(hoho)"+HIC"喜得贵子！\n"NOR,users());
		}
		if ((!wizardp(ob))&&(userp(ob)))
		{
            message("chat",HIC+"〖"+HIW+"幻想西天"+HIC+"〗月下老人(Lao ren)："+HIC""+ob->query("name")+ RANK_D->query_respect(ob) +"前来祝贺"+HIY"幻想西天(hoho)"+HIC"喜得贵子！\n"NOR,users());
		}
        return;
}

int do_say(string arg)
{
   object me=this_player();
  if (me->query("id")!="hoho")
    return 0;
   if (!arg)
    return notify_fail("老ho你怎么高兴的语无伦次了？\n");
   if (arg=="老婆万岁")
   {
         remove_call_out ("give_gifts");
         call_out ("give_gifts",2,me);
         remove_call_out ("auto_activities");
         call_out ("auto_activities",10,me);
         remove_call_out ("auto_gifts");
         call_out ("auto_gifts",20,me);
         remove_call_out ("auto_signs");
         call_out ("auto_signs",40,me);
         remove_call_out ("fangcun");
         call_out("fangcun", 2, me);
   }
   return 0;
}

void give_gifts (object me)
{
  int i;
  object *list;

  list = all_inventory(environment(me));
  i = sizeof(list);
  while  (i--)
  {
    object ob = list[i];
    object xianyao = new ("/d/obj/food/xianyao");
    object xianzhi = new ("/d/obj/food/xianzhi");

    reset_eval_cost();
    if (!interactive(ob))
      continue;
    if (me == ob)
      continue;

    xianyao->move(ob);
    xianzhi->move(ob);
    message_vision("$N给$n一金碗"+xianyao->query("name")+
                   "一玉壶"+xianzhi->query("name")+"。\n",me,ob);
  }
}


void auto_activities (object me)
{
  string *strs = ({
    "一班仙娥在歌声中翩翩起舞",
    "几位美姬和着节拍轻轻唱着起歌",
    "一阵阵凤箫玉管乐声缥缈",
    "风吹来，瑶池内琼香缭绕",
    "酒官送来一些仙酒",
    "仙女端进来几盘仙桃",
    "一位仙子进来奉上仙蕊仙花",
    "仙桌上的琼浆玉液散发着一阵酒香",
    "仙女唱道：半红半绿喷甘香",
    "仙女唱道：艳丽仙根万载长",
    "仙女唱道：堪笑武陵源上种",
    "仙女唱道：争如天府更奇强",
    "仙女唱道：紫纹娇嫩寰中少",
    "仙女唱道：缃核清甜世莫双",
    "仙女唱道：延寿延年能易体",
    "仙女唱道：有缘食者自非常",
  });

  if (me->query("gift/hoho") != "done")
    return;

  message_vision (random(sizeof(strs))+"\n",me);
  remove_call_out ("auto_activities");
  call_out ("auto_activities",20+random(20),me);
}

void auto_gifts (object me)
{
  object where = environment(me);
  object ob, who, gift;
  object *list;
  int i;
  string room_dir;
  
  room_dir = "/d/pantao/";
  if (me->query("gift/hoho") != "done")
    return;

  list = all_inventory(environment(me));
  for (i = 0; i < 100; i++)
  {
    reset_eval_cost();
    ob = list[random(sizeof(list))];
    if (ob->query("id") == "xian nu")
      break;
    ob = 0;
  }
  if (! ob)
  {
    int j = random(7);
    string npc = room_dir+"xiannu"+sprintf("%d",j);

      ob = new (npc);
    if(ob->move(where))
      message_vision ("$N走了过来。\n",ob);
  }
  for (i = 0; i < 100; i++)
  {
    who = list[random(sizeof(list))];
    if (interactive(who))
      break;
    who = 0;
  }
  if (who)
  {
    if (random(2))
      gift = new ("/d/obj/drug/xiantao");
    else
      gift = new ("/d/obj/drug/xianjiu");
    gift->move(who);
    message_vision ("$N给$n一"+gift->query("unit")+
                    gift->query("name")+"\n",ob,who);
  }
  remove_call_out ("auto_gifts");
  call_out ("auto_gifts",30+random(30),me);
}

void auto_signs (object me)
{
  string str;
  string *strs = ({
    "天空远处隐隐约约霞光万道，好象伊甸园有什么盛大宴会……",
    "天上似乎团团瑞气飘过……",
    "你恍惚看见天光灿烂，好象有什么重大节日……",
    "一阵阵风吹来，传来神仙妖怪们的喧闹声……",
    "空中传来断断续续的音乐声……",
    "你好象听见伊甸园金钟齐鸣……",
  });
  int i;
  object *list;

  if (me->query("gift") != "done")
    return;

  if (DEBUG)
    return;

  list = users();
  i = sizeof(list);
  while  (i--)
  {
    string here, there;

    reset_eval_cost();
    if (!environment(list[i]))
      continue;
    if (!living(list[i]))
      continue;

    here = (string)environment(me);
    there = (string)environment(list[i]);
    if (here == there)
      continue;

    tell_object(list[i],random(sizeof(strs))+"\n");
  }
  remove_call_out ("auto_signs");
  call_out ("auto_signs",60+random(60),me);
}


void shushan(object me)
{
	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗静虚老祖(Master jingxu)：恭喜hoho"+RANK_D->query_respect(me)+"喜添贵子。\n\n"NOR,users());
    call_out("moon", 2, me);
}

