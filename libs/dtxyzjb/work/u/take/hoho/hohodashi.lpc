	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗紫霞仙子(Zixia xianzi)：hoho"+RANK_D->query_respect(me)+"近日得子，小女子也来贺喜了。\n\n"NOR,users());
