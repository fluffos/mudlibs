	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗西王母(Xi wangmu)：老身也来祝贺hoho"+RANK_D->query_respect(me)+"喜得贵子。\n\n"NOR,users());
    call_out("putuo", 2, me);
}

