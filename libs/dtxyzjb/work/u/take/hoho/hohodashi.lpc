{
	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗菩提祖师(Master puti)：听说天神hoho"+RANK_D->query_respect(me)+"喜得贵子，特来道贺。\n\n"NOR,users());
    call_out("shushan", 2, me);
}

