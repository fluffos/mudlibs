message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗红尘微梦(Dreamer)：祝hoho:\n\n              日子越过越好,钞票越赚越多,泥巴越挖越深;  年年有今日,岁岁有今朝,抬头是金块,低头是美钞.\n\n"NOR,users());
    call_out("pujing", 2, me);
}

