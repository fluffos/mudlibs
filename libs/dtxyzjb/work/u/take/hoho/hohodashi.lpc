void take(object me)
{
	message("chat",HIC+"\n\n〖"+HIW+"幻想西天"+HIC+"〗九天(Take)：恭喜恭喜，天天打打杀杀，大家难得如此热闹一回，特此送这个小程序给你庆祝一下，hoho可要再接再厉呀，哈哈！\n\n"NOR,users());
}

int do_steal(string arg)
{
  object who;
  who = this_player();

  message_vision (HIG"九天像贞子一样突然飘了出来对$N颤声道：白痴"+HIW"~~~~"+HIG"，在我眼皮子"+HIW"~~~~~"+HIG"底下还敢乱来"+HIW"~~~~~~~~\n"NOR,who);
  message_vision ("$N吓得口吐白沫，顿时晕了过去。\n",who);
  who->unconcious();
  return 1;
}

int do_kill(string arg)
{
  object who;
  who = this_player();
  message_vision (HIW"刹时间妖风大作，只见九天手持青龙宴月大刀，胯下一头全身雪白的飞天猪(canoe)，杀气腾腾的直奔$N。\n"NOR,who);
  message_vision ("$N躲闪不及被"+HIY"飞天猪"+NOR"(canoe)啃了一口顿时中毒身亡。\n",who);
  who->die();
  return 1;
}

int do_cast(string arg)
{
  object who;
  who = this_player();
  message_vision (BLU"九天皮笑肉不笑的对$N道：谁让你乱念咒文的！\n"NOR,who);
  message_vision ("$N吓得将下半句咒文咽了回去。\n",who);
  return 1;
}

int do_get(string arg)
{
  object who;
  who = this_player();
  message_vision (BLU"九天对$N道：你想在这里拣好东西走？\n"NOR,who);
  message_vision ("$N红着脸灰溜溜的缩了回去。\n",who);
  return 1;
}

int do_fight(string arg)
{
  object who;
  who = this_player();
  message_vision (HIG"九天对$N吼道：谁让你在这里打架的！\n"NOR,who);
  message_vision ("$N吓得立刻缩了回去。\n",who);
  return 1;
}
