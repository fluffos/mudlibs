#include <ansi.h>
inherit ITEM;

void checking(object who);

void create()
{
set_name("混天仪",({"huntian yi","yi"}));
set("unit","个");
setup();
}

int query_autoload(){return 1;}

void init()
{
add_action("do_check","check");
}

string check_str(mapping dir,string arg)
{
int i;  
string *str,msg;
if ( !dir || !arg )
        return 0;
str = keys(dir);
i = sizeof(str);
while(i--)
        {
        if ( dir[str[i]]==arg )
                msg = str[i];
        }
if ( !msg || !stringp(msg) )
        return 0;
return msg;
}                                       

int do_check(string arg)
{
int num,i,k;        
string *damage,*armor;
object *usrs,who,me = this_player();
if ( arg || !wizardp(me) )
        return 0;
usrs = users();         
num = sizeof(usrs);
message("channel:sys",YEL"┝ "HIR"系统"NOR YEL" ┥：游戏者数据检测系统"WHT">>>>>>>>>>>>>>>>>>>"YEL"开始运作\n"NOR,users());
while(num--)
        checking(usrs[num]);
message("channel:sys",YEL"┝ "HIR"系统"NOR YEL" ┥：游戏者数据检测系统"WHT">>>>>>>>>>>>>>>>>>>"YEL"运作完毕\n"NOR,users());
return 1;
}

void checking(object who)
{
int k;  
object obj,*inv;

if ( !who ) return;
inv = all_inventory(who);
k = sizeof(inv);
if ( mapp(who->query("weapon")) ) 
        {
        while(k--)
                {
                obj = inv[k];
                if ( !obj->query("actions") )
                        continue;
                if ( obj==who->query_temp("weapon") )
                        obj->unequip();
                if ( obj->query("id")==who->query("weapon/id") )
                        {
                        message_vision("你丢下一"+obj->query("unit")+"$n。\n",who,obj); 
                        destruct(obj);
                        }
                }
        message("channel:sys",sprintf(YEL"┝ "HIR"系统"NOR YEL" ┥：游戏者 %s 的自制武器强制更新"WHT">>>>>>>>>>>>>>>>>>>"YEL"完毕\n"NOR,who->query("id")),users());          
        }
}

