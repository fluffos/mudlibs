#include <ansi.h>

inherit F_SAVE;
inherit ROOM;

int save_room();
string check_str(string str);
void get_long_text(string str, string text);
void get_bed_long_text(string str, string text);
void fullup(object obj); 

int is_home() {return 1;}

void create()
{
set ("short", HBRED+HIR"坟地"NOR);
set ("long", CYN"\n
这儿是为奖赏玩家举报"NOR+ HIW"ＢＵＧ"NOR+ CYN"而特地建造的名人坊，只要是贡献卓越\n
的玩家均可获得"NOR+HIW"豪宅"NOR+ CYN"一所．\n这一间是"NOR+HIW"测试"NOR+CYN"用的。\n
主人可以在这儿邀请(qing)客人...\n"NOR);

set("exits", ([
                "out": "/d/city/kezhan",
                "up": "/d/player-room/steps",
         ]));
set("water", 1);
set("alternative_die",1);
set("valid_startroom", 1);
set("sleep_room", 1);
set("chat_room", 1);
set("no_time",1);
set("freeze", 1); 
set("no_upgrade_age",1); 
setup();
}

void init()
{
object me=this_player(), env=this_object();

add_action("go_out", "out");

if( me->query("id")=="snowtu" || !userp(me) ) 
	{
tell_object(me,HIC"\n欢迎主人归来！\n你可以用sets来装修，name来取名，qing ID 来邀请客人。\n"NOR);
add_action("set_long", "sets");
add_action("set_short", "name");
add_action("do_get", "qing");
add_action("do_gan", "gan");
       }

else if( me->query_temp("player-room/onwer")!="dai" ) 
	{
	write("主人不在家，您还是呆会儿再来吧。\n");
	me->move("/d/city/kezhan");
       message_vision(CYN"$N尴尬地从"+this_object()->query("short")+CYN"走了出来。\n"NOR,me);
	return;
       } 
else  tell_object(me,HIC"欢迎欢迎热烈欢迎。\n"NOR);
return;
}

int do_get(string arg)
{
string name;
object me,key,where,who;
me = this_player();
where = this_object();
name=where->query("short");
if ( !arg || arg==me->query("id") )
	{
        tell_object(this_player(),"你确定有这个客人......？\n");
	return 0;
	}
key=find_player(arg);
if ( !key || !userp(key) )   return notify_fail("没有这个人...\n");
if ( (string)key->query_temp("player-room/onwer") )
  {
  who=find_player(key->query_temp("player-room/onwer"));
  if ( who ) {
  tell_object(me,key->name()+"已经有人邀请了！\n");
  tell_object(key,me->name()+"想邀请你，可惜你已经被"+who->name()+"邀请了！\n");
return 0;
    }
  else key->delete_temp("player-room/onwer");
  }
tell_object(key,me->name()+"邀请你去"+name+"一聚。\n");
key->set_temp("player-room/onwer",me->query("id"));
tell_object(me,"你邀请"+key->name()+"来"+name+"一聚（可以用gan ID 取消邀请）。\n");
return 1;
}

int do_gan(string arg)
{
object who,me,where;
string name;
me = this_player();
where = this_object();
name=where->query("short");

if ( !arg || arg==me->query("id") )
  return notify_fail("您要赶谁？\n");

who=find_player(arg);

if ( !userp(who) || who->query_temp("player-room/onwer")!=me->query("id") )
  return notify_fail("您并没邀请过这个人？\n");

if ( present(who,where) ) {
tell_object(who,me->name()+"将你赶出了"+name+"！\n");
who->move("/d/city/kezhan");
message_vision("$N被$n从"+name+"赶了出来！\n",who,me);
who->delete_temp("player-room/onwer");
return 1;
 }
tell_object(who,me->name()+"改变主意，不再邀请你去"+name+"了！\n"); 
who->delete_temp("player-room/onwer"); 
tell_object(me,"你改变主意，不再邀请"+who->name()+"来"+name+"了！\n"); 
}
int go_out()
{
object me=this_player();
tell_room(this_object(),me->name()+"推开门，走了出去。\n",({me}));
me->move("/d/city/kezhan");
message_vision("$N推开门，从"+this_object()->query("short")+"里走了出来。\n",me);
return 1;
}

int set_short(string str)
{
    if(!str) return 0;

    str=check_str(str);
    set("short",str);
//    set_name(this_object()->query("short"), ({this_object()->query("file_name")}));
    save_room();
    return 1;
}

int set_long()
{   string str;
    this_player()->edit( (:get_long_text, str :) );
    return 1;
}

void get_long_text(string str, string text)
{
    str=check_str(text);
    set("long",str);
    save_room();
    return;
}

string check_str(string str)
{ 
    str=replace_string(str,"\"","");
    str=replace_string(str,";","");
    str=replace_string(str,"\\","");
    str=replace_string(str,"/","");
    str=replace_string(str,"'","");
    str=replace_string(str,"`","");
    str=replace_string(str,",","");
    str=replace_string(str,"!","");
    str=replace_string(str,"~","");
    str=replace_string(str,"{","");
    str=replace_string(str,"}","");
    str=replace_string(str,"$","");
    str=replace_string(str,"&","");
    return str;
}

int clean_up()
{    //clean_up homes
    object *inv,*inv1;
    int i,j;

    if( !clonep() && this_object()->query("no_clean_up") ) return 1;

    inv = all_inventory();
    for(i=sizeof(inv)-1; i>=0; i--) {
      if(userp(inv[i])) return 1;
      if(inv[i]->query("if_bed")) {  //a bed object
        inv1=all_inventory(inv[i]);
        if(sizeof(inv1)>0)
          for(j=sizeof(inv1)-1; j>=0; j--) {
            if (userp(inv1[j])) return 1;
          }
      }
    }

    destruct(this_object());
    return 0;
}    

void alternative_die(object me)
{
fullup(me);
}

void unconcious(object who)
{
  if (who->query("kee")<0 || who->query("sen")<0) alternative_die(who);
   else unconcious(who);
}

void die(object who)
{
if ( userp(who) )
    alternative_die(who);
else {
 message_vision(BLINK+HIR"$N"HIR"惨叫一声，倒地化作一股臭水！\n"NOR,who);
 destruct(who);
 }
}

void fullup(object obj) {
  if (!obj) return;
  obj->set("kee",(int)obj->query("max_kee"));
  obj->set("eff_kee",(int)obj->query("max_kee"));
  obj->set("sen",(int)obj->query("max_sen"));
  obj->set("eff_sen",(int)obj->query("max_sen"));
  obj->set("force",(int)obj->query("max_force")*2);
  obj->set("mana",(int)obj->query("max_mana")*2);
}

int save_room()
{
string file;

file=this_object()->query_save_file();

write("存档 ．．．．．\n");
if( save() ) {
	write("保存成功.\n");
	return 1;
	} else {
        write("等系统更新，房间自然会恢复原状，您尽情涂鸦吧。\n");
       return 0;
        }
}
