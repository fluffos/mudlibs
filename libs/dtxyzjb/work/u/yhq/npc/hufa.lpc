#include <ansi.h>
inherit NPC;
string send_me(object me);
void create()
{
set_name(HIW"护法兔"NOR, ({ "hufa tu", "tu", "hufa" }) );
set("gender", "女性" );
set("long","眠兔的私人保镖！\n");
set("age",20);
set("title", HIC"眠兔的私人保镖"NOR);
set("attitude", "heroism");
set("str",40);
set("per",40);
set("int",30);
set("max_kee",3200);
set("kee",3200);
set("max_sen",3200);
set("sen",3200);
set("combat_exp",8000000);
set("daoxing",8000000);
set("force",10000);
set("max_force",5000);
set("mana",10000);
set("max_mana",5000);
set("force_factor", 200);
set("mana_factor",200);

set_skill("unarmed",3500);
set_skill("parry",350);
set_skill("dodge",350);
set_skill("sword",350);
set_skill("force",350);
set_skill("spells",350);
set_skill("cuixin-zhang",350);
set_skill("xiaoyaoyou",350);
set_skill("bainiao-jian",350);
set_skill("ningxie-force",350);
set_skill("throwing",350);
set_skill("dengxian-dafa",350);

map_skill("dodge", "xiaoyaoyou");
map_skill("parry", "bainiao-jian");
map_skill("sword","bainiao-jian");
map_skill("unarmed", "cuixin-zhang");
map_skill("force","ningxie-force");
map_skill("spells","dengxian-dafa");
setup();
create_family("大雪山", 2, "弟子");
set("family/master_name","大鹏明王");
carry_object("/d/obj/weapon/sword/qinghong")->wield();
carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/obj/armor/jinyipifeng")->wear();
carry_object("/u/angell/obj/toukui")->wear();
carry_object("/d/obj/cloth/zhanpao")->wear();
set("chat_chance_combat", 100);
set("chat_msg_combat", ({
	(: perform_action, "sword", "feijian" :),
	(: perform_action, "sword", "chaofeng" :),
	(: perform_action, "sword", "chongtian" :),
	(: perform_action, "sword", "fengwu" :),
	(: perform_action, "sword", "zheng" :),
	(: perform_action, "sword", "gui" :),
	(: perform_action, "sword", "qilin" :),

}) );

}

void die()
{
if( environment() ) 
	message_vision(HIW"$N高喝一声“眠兔救我！”\n"NOR,this_object() );
set("kee",(int)query("max_kee") );
set("effkee",(int)query("max_kee") );
set("sen",(int)query("max_sen") );
set("sen",(int)query("max_sen") );
set("force",(int)query("max_force")*2 );
set("mana",(int)query("max_mana")*2 );
}

void unconcious()
{
die ();
}
