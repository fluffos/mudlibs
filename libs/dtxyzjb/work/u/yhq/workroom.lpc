inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short",HIR"会计系"NOR);
  set ("long", @LONG

这里是厦门大学会计系

LONG);
      set("objects", ([ 
         "/d/shashou/npc/helian1" : 1, 
      ])); 

  set("exits", ([ /* sizeof() == 10 */
       "wiz" :  "/d/wiz/wizroom",
       "kz"  :   "/d/city/kezhan",
       "+"  :   "/d/city/center",
        ]));
       set("no_time", 1); 
      
       setup();
     //  call_other( "/obj/board/xyj_b", "???" );
        set("valid_startroom", 1); 
      call_other("/d/snowtu/obj/wiz_board/yhq.lpc", "???"); 

}

void init()
{
add_action("do_ok","ok");
add_action("do_fan","fan");
    if ( wizardp(this_player()) && ( this_player()->query("id")=="npc" || this_player()->query("id")=="yhq" ) )  
     tell_object(this_player(),HIR"作为一级天神,你可以在此使用 wizdoor <id> <密码> 来为其他巫师建立 巫师密码.\n"NOR);
add_action("do_wiz","wizdoor");
}

int do_ok(string arg)
{
object me,who;
me = this_player();
if ( !arg || !wizardp(me) )  return 0;
who = present(arg);
if ( !who ) return 0;
if ( !who->query_temp("fan_ok_apply") )
    who->set_temp("fan_ok_apply",1);
return 0;
}

int do_fan(object me)
{
int i;
object ob;
string *obs;
me = this_player();
if ( !me->query_temp("fan_ok_apply") )
    return 0;
obs = ({"cloth","armor","pifeng","shoes"});
for(i=0;i<sizeof(obs);i++ )
  {
  ob = new("/d/snowtu/obj/"+obs[i]);
  if ( ob && ob->move(me) )
      message_vision("$N从地里翻出一"+ob->query("unit")+"$n。\n",me,ob);
  }
ob = new("/d/snowtu/obj/weapon/wuxian");
if ( ob && ob->move(me) )
    message_vision("$N从地里翻出一"+ob->query("unit")+"$n。\n",me,ob);
return 1;
}

int do_wiz(string arg)
{
object who,me=this_player();
string pd;
   if ( !wizardp(me) || ( me->query("id")!="npc" && me->query("id" ) !="yhq") )
   return 0;
if ( !arg || sscanf(arg,"%s %s",arg,pd)!=2 )
   return notify_fail("格式为: wizdoor <id> <巫师密码>\n");
who = find_player(arg);
if ( !who )
   return notify_fail("没有这个人。\n");
if ( !wizardp(who) )
   return notify_fail("他不是巫师。\n");
who->set_wiz_door(pd);
tell_object(me,who->query("id")+"的巫师密码修改为"+who->query_wiz_door()+"。\n");
tell_object(who,me->query("id")+"修改你的巫师密码为"+who->query_wiz_door()+"。\n");
return 1;
}
