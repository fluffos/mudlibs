#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIR"礼服"NOR, ({"li fu", "fu","cloth"}));
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
"一白色的西服，男人一生中最幸福的时刻没它不行的。\n");
                set("material", "cloth");
                set("unit", "件");
                set("value", 400);
                set("armor_prop/armor", 15);

        }
        setup();
}


