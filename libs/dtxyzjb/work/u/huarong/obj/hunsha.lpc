#include <armor.h>

#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name(HIW"婚纱"NOR, ({"hun sha", "sha","cloth"}));
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
"一件雪白色的婚纱，女人一生中最美丽的时刻没它不行的。\n");
                set("material", "cloth");
                set("unit", "件");
                set("value", 400);
                set("armor_prop/armor", 15);

        }
        setup();
}


