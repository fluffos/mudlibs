//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{
       set_name(HIY"华奇"NOR, ({"hua qi", "hua", "qi"}));
       set("long",
"\n他虽然不是什么帅哥,却也是神采飞扬。－－巫师天狼星为恭喜他们做的礼物。\n");
       set("title", HIR"新郎"NOR);
       set("gender", "男性");
       set("age", 20);
       set("class", "bonze");
       set("attitude", "friendly");
       set("kar", 40);
       set("per", 40);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 300);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

        set_skill("literate", 500);
        set_skill("spells", 500);
        set_skill("buddhism", 500);
        set_skill("unarmed", 500);
        set_skill("jienan-zhi", 500);
        set_skill("dodge", 500);
        set_skill("lotusmove", 500);
        set_skill("parry", 500);
        set_skill("force", 500);
        set_skill("lotusforce", 500);
        set_skill("staff", 500);
        set_skill("lunhui-zhang", 500);
        map_skill("spells", "buddhism");
        map_skill("unarmed", "jienan-zhi");
        map_skill("dodge", "lotusmove");
        map_skill("force", "lotusforce");
        map_skill("parry", "lunhui-zhang");
        map_skill("staff", "lunhui-zhang");
create_family("南海普陀山", 1, "弟子");
setup();
  carry_object("/u/huarong/obj/lifu")->wear();
  carry_object("/d/obj/weapon/staff/muzhang");
}

void init()
{     
        add_action("do_gongxi","gongxi");
       ::init();
}

int do_gongxi(string arg)
{
      object ob = this_object();
      object me = this_player();
      object xiangyan;
      if(!arg) return notify_fail("你要恭喜谁呀？\n");
      if(arg=="hua qi"||arg=="hua"||arg=="qi")
        {
        message_vision("$N说：“多谢多谢”！\n",ob);
        if (!me->query("huarong/xiangyan"))
          {
    message("shout", HIY "【喜讯通告】：" + HIR + "恭喜华奇和王颖喜结连理！\n"+"\n"+ HIR
         " 
         ■        ■ 
    ■■■■■■■■■■■
         ■        ■
     ■■■■■■■■■■
       ■■■    ■■■
       ■  ■    ■  ■
       ■■■    ■■■
        ◆◆      ◆◆
     ■■■■■■■■■■
       ■■■    ■■■
       ■  ■    ■  ■
       ■■■    ■■■\n"             
          NOR,users());  
           message_vision(HIC"$N给$n一包香烟！\n"NOR,ob,me);
           xiangyan=new("/u/huarong/obj/xiangyan.lpc");
           xiangyan->move(me); 
           me->set("huarong/xiangyan",1);
           me->save();
          }
        return 1;
        }
      return notify_fail("你要恭喜谁呀？\n");
 }

void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object(),newnew;
        object ghost;
        object me=query_temp("my_killer");
        int i;
        i=random(10);

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
  remove_call_out("check2");
  call_out("check2",0);                               
 if(me->is_busy())
    {   
        command("enforce max");
        command("enchant max");
        command("exert recover");
    if (i<5)
           {
        command("wield staff");
        command("perform pudu");
           }
    else if(i<8)
           {
        command("unwield staff");
        command("perform rulai");
           }
    else
           {
         command("cast bighammer");
            }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("unwield staff");
        command("exert recover");
        command("perform lingxi");
        remove_call_out("check");
        call_out("check",2);

    }
}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
        command("say 真是横的怕不要命的。");
       command("sigh");
      message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
    }

        destruct(this_object());


}


