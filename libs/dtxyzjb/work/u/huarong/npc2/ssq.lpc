//大唐西游双色球彩票
//by huarong 2005/3

inherit NPC;
#include <ansi.h>

void create()
{

   set_name("小猫咪", ({"little cat","cat"}));
   set("title","双色球");
   set("age",19);
   set("gender","男性");
   set("per",40);
   set("attitude", "peaceful");
   setup();

 }

void init()
{
   add_action("work","ssq");
}

int work()
{
 int i,j,k,n,m,M;
 int *N=({0,0,0,0,0,0,0}),*num=({0,0,0,0,0,0,0});
 
for(k=1;k<=6;k++)
     num[k]=random(33)+1;

//红球筛选
for(j=1;j<=6;j++)
    {
     for(i=1;i<j;i++)
     {
       while(num[i]==num[j])
       {
        num[j]=random(33)+1;
       }
     }
    }
    

//红球排序
   for (k=1;k<=6;k++)
    {
         m=0;
      for(n=1;n<=6;n++)
       {
         if(num[k]>num[n]) m++;
       }
         N[m+1]=num[k];
    }
    
//蓝球筛选
     M=random(16)+1;  

    printf(HIR+"\n              ︵      ︵      ︵      ︵      ︵      ︵      "+HIC+"︵\n"NOR);            
    printf(HIB+"【"+HIY+"双"+HIR+"色"+HIC+"球"+HIB+"】"
    +HIR+"  （"+HIW+"%2'0'd"+HIR+"）  （"+HIW+"%2'0'd"+HIR+"）  （"+HIW+"%2'0'd"+HIR+"）  （"+HIW+"%2'0'd"+HIR+"）  （"+HIW+"%2'0'd"+HIR+"）  （"+HIW+"%2'0'd"+HIR+"）  "+HIC+"（"+HIW+"%2'0'd"+HIC+"）\n"+NOR,N[1],N[2],N[3],N[4],N[5],N[6],M);
    printf(HIR+"              ︶      ︶      ︶      ︶      ︶      ︶      "+HIC+"︶\n"NOR);            
    return 1;


}

