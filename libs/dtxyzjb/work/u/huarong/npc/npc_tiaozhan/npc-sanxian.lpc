//sanxian妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/npc_tiaozhan/npc_cjnpc.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
       guai_value = max_value+max_value/4;
       set("old_flag/jiandao",9);

       set_skill("sword", guai_value+random(16));
       set_skill("whip", guai_value+random(16));
       set_skill("binfen-steps", guai_value+random(16));
       set_skill("ice_fire_zhang", guai_value+random(16));
       set_skill("whip", guai_value+random(16));
       set_skill("butian-force", guai_value+random(16));
       set_skill("mysticism", guai_value+random(16));
       set_skill("wuwei-fuchen", guai_value+random(16));
       set_skill("spysword", guai_value+random(16));
       map_skill("dodge", "binfen-steps");        
       map_skill("parry", "spysword");
       map_skill("sword", "spysword");
       map_skill("force", "butian-force");
       map_skill("spells", "mysticism");
       map_skill("unarmed", "ice_fire_zhang");
       map_skill("whip", "wuwei-fuchen");
       create_family("三界散仙", 1, "弟子");
       carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
        carry_object("/d/obj/weapon/sword/mujian.lpc")->wield();
        carry_object("/d/obj/weapon/whip/wuchou.lpc");
}
   
void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");

        int i=random(10),j=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()||!me->is_fighting(ob))
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");
        remove_call_out("check2");
        call_out("check2",0);                               
  if(me->is_busy())
    {   
        command("unwield whip");
        command("exert recover");
    if (i<3)
           {
            command("wield sword");
            command("perform dunnoname on "+me->query("id"));
           }
    else if(i<4)
           {
            command("wield sword");
            command("perform dunnotruth on "+me->query("id"));
           }
    else if(i<7)
           {
            command("wield sword");
            command("perform bishou on "+me->query("id"));
           }
    else
           {
            command("cast gold on "+me->query("id"));
           }
     remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("unwield sword");
        command("unwield whip");
        command("exert recover");
        command("jiali max");
        command("perform icefire on "+me->query("id"));
        remove_call_out("check");
       call_out("check",3);

    }


}
      



