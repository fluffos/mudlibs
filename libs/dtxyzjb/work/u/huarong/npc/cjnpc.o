inherit NPC;

#include <ansi.h>

string *banned_cast=({"chuqiao","qiankun","jieti","jinsheng","love","jiushen"});
string *banned_perform=({"badao"});
string *banned_action=({"ji","quit"});

object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}


void init()
{       
  ::init();
//       add_action("do_quit",banned_action);
        add_action("do_ji","ji");
        add_action("do_perform","perform");
       add_action("do_bian","bian");
       add_action("do_tianlong","tianlong");
        add_action("do_cast","cast");
        add_action("do_quit","quit");
}

int do_ji(string arg,object ob)
{
        object me = this_object();
        ob = offensive_target(me);
     if(!arg) return 0;
   if(!me->is_fighting(ob) ) return 0;
if (!userp(ob))  return 0;
         message_vision("$N冷笑一声：你想耍什么花样？\n",me);
        return 1;
}
  

int do_quit(string arg) 
{
        object me = this_object();
        message_vision("$N冷笑一声：哪里走!\n",me);
        return 1;
}

int do_perform(string arg,object ob)
{     
      object me = this_object();
      ob = offensive_target(me);
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(member_array(arg,banned_perform)==-1) return 0;
   if(!me->is_fighting(ob) )   return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
    return 1;
 }
int do_bian(string arg)
{
      object me = this_object();
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
     if(!arg==this_object()->id(arg) ) return 0;
     message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;
 }

int do_tianlong(string arg)
{
      object me = this_object();
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(!arg==this_object()->id(arg) ) return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;
 }


int do_cast(string arg)
{     
      object me = this_object();
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(member_array(arg,banned_cast)==-1) return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;
 }



void heart_beat()
{  
   int free,kee_cost;
   object guai = this_object();
   ::heart_beat();
   free=(int)query_skill("force")/40; 
   kee_cost=(free-1)*100;
   if ( !is_fighting()
          && query_skill("butian-force",1)
          && query("eff_kee") <  query("max_kee") )
        { 
               command("exert xiaobutian");
        }


   if ( !is_fighting()
        && !query_skill("zixia-shengong",1)
        && query("eff_kee") <  query("max_kee") )
       { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert heal");
               command("exert heal");
               command("exert heal");
               command("exert heal");
               command("exert heal");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.c");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");
              }
        }
        if ( !is_fighting()
          && query_skill("zixia-shengong",1)
          && query("eff_kee") <  query("max_kee") )
        { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert ningshen");
               command("exert ningshen");
               command("exert ningshen");
               command("exert ningshen");
               command("exert ningshen");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.c");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");   
             } 
        }
   if ( !is_fighting()
        && !query_skill("jiuyin-xinjing",1)
        && query("eff_sen") <  query("max_sen") )
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.c");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }
   if ( !is_fighting()
        && query_skill("jiuyin-xinjing",1)
        && query("eff_sen") <  query("max_sen") )
       {   if (query("eff_sen") >= query("max_sen") / 2 )
             {
               command("exert jingheal");
               command("exert jingheal");
               command("exert jingheal");
               command("exert jingheal");
               command("exert jingheal");
              }
       else
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.c");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }
       }
   if (is_fighting()  &&  query("force") < query("max_force") )
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
   if (!is_fighting()  &&  query("force") < query("max_force") )
     command("exercise "+kee_cost);   
}       


