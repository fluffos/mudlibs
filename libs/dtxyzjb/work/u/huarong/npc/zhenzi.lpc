//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{
       set_name(HIR"贞子"NOR, ({"zhen zi", "zhen", "zi"}));
       set("long",
"她就是吓死人不偿命的恶鬼。\n");
       set("title", HIW"午夜凶铃"NOR);
       set("gender", "女性");
       set("age", 20);
       set("class", "youling");
       set("attitude", "friendly");
       set("per", 10);
       set("int", 30);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 300);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

   set_skill("unarmed", 500);
   set_skill("whip", 500);
   set_skill("hellfire-whip", 500);
   set_skill("dodge", 500);
   set_skill("parry", 500);
   set_skill("literate", 500);
   set_skill("spells", 500);
   set_skill("force", 500);
   set_skill("tonsillit", 500);
   set_skill("ghost-steps", 500);
   set_skill("gouhunshu", 500);
   set_skill("jinghun-zhang", 500);
   set_skill("kusang-bang", 500);
   set_skill("zhuihun-sword", 500);
   set_skill("sword", 500);
   set_skill("stick", 500);

  map_skill("force", "tonsillit");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("spells", "gouhunshu");
  map_skill("parry", "hellfire-whip");
  map_skill("whip", "hellfire-whip");
  map_skill("sword", "zhuihun-sword");
  map_skill("stick", "kusang-bang");

create_family("阎罗地府", 1, "弟子");
setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/whip/longsuo")->wield();
}


void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object ghost;
        object me=query_temp("my_killer");

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
        remove_call_out("check2");
        call_out("check2",0);
 if(me->is_busy())
    {   
        command("wield whip");
        command("jiali max");
        command("exert recover");
      command("perform ldlh");
       command("perform three");
       command("perform xingyun");
        remove_call_out("check");
        call_out("check",5);
    }
  if(!me->is_busy())
    {
        command("unwield whip");
        command("exert recover");
        command("perform zhua");
        remove_call_out("check");
        call_out("check",3);

    }
}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
        command("say 真是横的怕不要命的。");
       command("sigh");
      message("sound", "\n贞子身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
    }

        destruct(this_object());


}
