int accept_object(object me, object ob)
{
    if(!me->query_temp("chili")) return 0;
//    remove_call_out("checkyao");
//    call_out("checkyao",1);
    if (ob->query("name") == me->query("rulaitask/yaoname1"))
    {
      command ("hmm "+me->query("id"));
      me->add_temp("rulaitask/yaonum1",1);
      call_out("destroy", 1, ob);
      return 1;
     }
    if (ob->query("name") == me->query("rulaitask/yaoname2"))
    {
      command ("hmm "+me->query("id"));
      me->add_temp("rulaitask/yaonum2",1);
      call_out("destroy", 1, ob);
      return 1;
     }
     if ( (me->query("rulaitask/kind")=="解") &&(me=ob->query("owner")) &&(ob->query("gudu")) )
        {
          message_vision(CYN "敕里仔细观察了"+ob->query("name")+"一番。\n\n\n"NOR);
          call_out("gudu",3,me,ob);
          return 1;
        }
}


void gudu(object me,object ob)
{    
    message_vision(CYN "过了片刻......\n" NOR,me);
    command ("sigh");
    command ("say 此蛊乃九冥尸蛊也。九冥尸蛊乃是一种非常厉害的蛊毒，可吞噬、控制人兽
              元神。现可点一堆火，先将蛊虫驱除，但是虫卵在三五日之后可能又会成虫，蛊
              母在放蛊之人体内，若要治本，可去找到放蛊之人，并杀之。\n");
    command ("say 另外，去抓"+chinese_number(me->query("rulaitask/yaonum1"))+me->query("rulaitask/yaoname1")+"和"+chinese_number(me->query("rulaitask/yaonum2"))+me->query("rulaitask/yaoname2")+"作为辅助用药。\n");
    command ("sigh");
    message_vision(CYN "话音刚落，一阵风似的飘走了......\n\n\n" NOR,me);
    call_out("gudu1",4,me,ob);
    return;
}

void gudu1(object me,object ob)
{
  message_vision(CYN "片刻之间，敕里又回到你眼前......手里提着不知道从哪儿弄来的几只动物的尸体。\n" NOR,me);
  message_vision(CYN "敕里取出一个红色的火褶子。。。\n" NOR,me);
  message_vision(CYN "点燃了屋里的枯树枝，火势渐大，敕里开始焚烧动物的尸体。\n" NOR,me);
  message_vision(CYN "过了片刻，"+ob->query("name")+CYN+"伤口迸裂，十几只九冥尸蛊电窜而出。。。\n" NOR,me);
  message_vision(CYN "敕里早有准备，骨针飞弹，将尸蛊牢牢钉在地上，撩火将几只尸蛊点着，恶臭更甚。\n" NOR,me);
  message_vision(CYN+ob->query("name")+CYN+"全身震动，转瞬间又有数十只尸蛊飞射而出，被敕里一一钉死。\n" NOR,me);
  message_vision(CYN "如此迥圈几次，"+ob->query("name")+CYN+"体内的尸蛊成虫已经尽数清除。\n\n\n" NOR,me);
  ob->delete("gudu");
  call_out("gudu2",5,me,ob);
  return;
}


void gudu2(object me,object ob)
{
  message_vision(CYN "一盏茶功夫后。。。\n" NOR,me);
  message_vision(CYN "敕里取出一个金黄的小盒子。。。\n" NOR,me);
  message_vision(CYN "从里面拿出一只奇怪的虫子，那虫子在"+ob->query("name")+CYN"飞舞了几圈，\n" NOR,me);
  message_vision(CYN "然后飞到敕里的耳边嗡嗡了几声。。。\n" NOR,me);
  message_vision(CYN "直看得$N目瞪口呆。。。\n\n\n" NOR,me);
  call_out("gudu3",4,me,ob);
  return;
}

void gudu3(object me,object ob)
{
  object dguai1;
  string where1;
  int level=4;
  dguai1 = new("/u/huarong/npc/rulainew/yaoguai/"+list2[random(sizeof(list2))]);
  where1=dguai1->invocation(me, level);
  dguai1->set("gumu",1);
  me->set("rulaitask/dguai1",dguai1);
  me->set("rulaitask/where1",where1);
  message_vision(CYN "片刻，敕里起身收回小虫子。。。\n" NOR,me);
  message_vision(CYN "敕里说到："+ob->query("name")+CYN"的蛊母在一个叫"+HIY+dguai1->query("name")+NOR+CYN+"的恶鬼体内。\n" NOR,me);
  message_vision(CYN "若想救人的话，去宰了那恶鬼吧。。。\n\n\n" NOR,me);
  message_vision(CYN "敕里将病人交还给你。。。\n" NOR,me);
  me->set_temp("gumuask",1);
  ob->move(me);
  return;
}

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
      command("say 我会回来找你的。");
      command("grin");
      message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
       }
       destruct(this_object());
}


