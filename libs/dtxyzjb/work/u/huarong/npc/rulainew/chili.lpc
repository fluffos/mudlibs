//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>
string test_player();
string *list2=({"yg-wdd","yg-shushan","yg-pansi","yg-jjf","yg-xueshan","yg-kunlun","yg-hell",
               "yg-sanxian","yg-putuo","yg-huoyun","yg-fangcun","yg-moon","yg-wzg","yg-longgong",
        });//huarong 2003.7



void create()
{
       set_name("敕里", ({"chi li", "chi", "li","chili"}));
       set("long",
"\n用蛊高手，李亿如的叔叔。\n");
       set("title", HIG"鬼蛊"NOR);
       set("gender", "男性");
       set("age", 20+random(10));
       set("attitude", "friendly");
       set("per", 30);
       set("int", 30);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 200);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);
       set("old_flag/jiandao",9);

       set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("force", 500);
       set_skill("parry", 500);
       set_skill("sword", 500);
       set_skill("whip", 500);
       set_skill("spells", 500);
       set_skill("literate", 500);
       set_skill("binfen-steps", 500);        
       set_skill("ice_fire_zhang", 500);
       set_skill("whip", 500);
       set_skill("butian-force", 500);
       set_skill("mysticism", 500);
       set_skill("wuwei-fuchen", 500);
       set_skill("spysword", 500);        
       map_skill("dodge", "binfen-steps");        
       map_skill("parry", "spysword");
       map_skill("sword", "spysword");
       map_skill("force", "butian-force");
       map_skill("spells", "mysticism");
       map_skill("unarmed", "ice_fire_zhang");
       map_skill("whip", "wuwei-fuchen");
create_family("三界散仙", 1, "弟子");
        set("inquiry", ([
                "name": "吾乃敕里是也。",
                "here": "本山人粗通蛊毒，要治病(cure)不妨试试。",
                "cure": (: test_player :),
                "救人": (: test_player :),
        ]));

setup();
        carry_object("/d/npc/obj/magua.lpc")->wear();
        carry_object("/d/npc/obj/sword2.lpc");
        carry_object("/d/npc/obj/whip.lpc")->wield();
}

string test_player()
{
    object me=this_player();
    if(!me->query_temp("chili") )
     {
        me->set_temp("chili",1);
        return "你要替谁求医？\n";
      }
 if ( me->query_temp("gumuask") )
   {
  if ( me->query("rulaitask/gumukill") )
    {
      if (  (me->query_temp("rulaitask/yaonum1")>=me->query("rulaitask/yaonum1") ) && (me->query_temp("rulaitask/yaonum2")>=me->query("rulaitask/yaonum2")) )
        {
          command ("great "+me->query("id"));
          me->set_temp("rulaitask/yaogive",1);
          command ("say 就是这些辅助用药，放心吧，你带来的人会安然无恙的！\n\n");
          message_vision(CYN "敕里取出一个土黄色的小鼎，把药材放在里面，又放进了一只小虫子。\n" NOR,me);
          message_vision(CYN "口中念念有词。。。\n\n\n" NOR,me);
          message_vision(CYN "片刻后。。。\n" NOR,me);
          return "病人已经没有什么大碍，你讲他唤醒(xing ***)吧。\n";
        }
      else
       {
         command("? "+me->query("id"));
         return "这位" + RANK_D->query_respect(me) + "，我让你寻的药材可配齐了？\n";
        }
    }
  else
    {
    command("sigh");
    return "莫非" + RANK_D->query_respect(me) + "敌不过那体内有蛊母的恶鬼？\n";
     }
  }
        return "你要替谁求医？\n";
}

void destroy(object ob)
{
        destruct(ob);
        return;
}



void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        int i=random(10),j=random(10);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()||!me->is_fighting(ob))
     {
     remove_call_out("check");
     return;
     }                               
  if(me->is_busy())
    {   
        command("unwield whip");
        command("exert recover");
        command("jiali max");
    if (i<4)
           {
            command("wield sword");
            command("perform dunnoname");
           }
    else if(i<6)
           {
            command("wield sword");
            command("perform dunnotruth");
           }
    else if(i<8)
           {
            command("wield sword");
            command("perform bishou");
           }
    else
           {
            command("cast gold");
           }
     remove_call_out("check");
        call_out("check",1);
    }
  if(!me->is_busy())
    {
       if(j<7)
       {
        command("unwield sword");
        command("unwield whip");
        command("exert recover");
        command("perform icefire");
        }
       else
        {
        command("unwield sword");
        command("wield whip");
        }
        remove_call_out("check");
        call_out("check",1);

    }


}

