#include <ansi.h>

inherit ITEM;

void create()
{
       set_name("灵符", ({"ling fu", "seal", "fu","lingfu", "paper"}));
        set_weight(100);
        if(clonep())
                set_default_object(__FILE__);
        else {

        set("long","一张画上了符咒的桃符纸。\n");
        set("unit", "张");
        set("value", 0);
        set("no_put",1);
        set("no_sell",1);
        set("no_give",1);
        }
        setup();
}

void init()
{
        add_action("do_burn", "burn");
        add_action("do_xing", "xing");
if( (int)this_object()->query("created") != 1 )
        {
                this_object()->set("created", 1);
                remove_call_out ("destroy_it");
                call_out ("destroy_it", 1800);//30 min

        }
}

void destroy_it()
{
        message_vision("一阵风吹来，" + (string)this_object()->query("name") + "片片碎落，随风而去。\n", environment(this_object()));
        destruct(this_object());
}

int do_burn(string arg,object me,object target)
{
        object fu;
       string funame,targetname;
       object ob=this_object();
       string name=ob->query("name");
        me=this_player();
        
       if(me != ob->query("owner")&&!wizardp(me)) 
                return notify_fail("这张符好像不是你的吧？\n");
    if( sscanf(arg, "%s on %s", funame, targetname)==2 )
    {
        fu=present(funame, me);
        if(!fu) return notify_fail("你没有灵符。\n");
        target = present(targetname, environment(me));
        if (me->is_busy())
            return notify_fail("你上一个动作还没有完成，无暇分身祭灵符。\n");
        if(!target) return notify_fail("这里没有 " + targetname + "。\n");
        if(target==me)
            return notify_fail("对自己搞什么飞机？\n");
       if(me != target->query("owner")) 
                return notify_fail("这个任务好像和你无关吧？\n");
       if(!me->is_fighting(target) )
                return notify_fail("战斗中才能祭符！\n");
       if( target->query("unconcious") )
                return notify_fail("对方已经昏倒了！\n");
        
     message_vision(RED"$N"RED"祭出了一张灵符，双手合十，念动咒语。。。\n\n"NOR, me);
       me->start_busy(1+random(1));
    if(userp(target))
        {
       message_vision("结果什么都没有发生。\n", me);
        destruct(this_object());
        return 1;
       }
       message_vision(HIB+target->query("name")+HIB+"被牢牢锁死。。。\n\n"NOR, me);
       target->set_temp("lingfu",1);
       target->remove_call_out("revive");
        return 1;
     }
     else
     {
             return notify_fail("你想对谁祭"+name+"？\n");
      }
        return 1;

}

int do_xing (string str,object me,object target)
{
  if (!str) return notify_fail ("xing <id>\n");
  me=this_player();
  target = present(str, environment(me));
  if(!target)                         return notify_fail ("没有"+str+"呀？\n");
  if(target==me)                      return notify_fail("对自己搞什么飞机？\n");
  if(!target->query_temp("lingfu"))         return notify_fail("对方没有被灵符封睡吧？\n"); 
  if(userp(target))                   return notify_fail("搞错对象了吧？\n"); 
  message_vision(RED"$N"+RED+"念动咒语。。。\n"NOR, me);
  target->remove_call_out("revive");
  target->revive();
  target->delete_temp("lingfu",1);
    if ( me->query_temp("rulaitask/yaogive")  && me->query("rulaitask/gumukill") )
      {
         message_vision(CYN+target->query("name")+CYN"说到：多谢"+RANK_D->query_respect(me)+CYN+"仗义相住，我们后会有期。\n\n"NOR,me);
         destruct(target);
          me->delete("rulaitask/dfail");
         me->set("rulaitask/daccomplish",1);
         me->set("rulaitask/end_time",time());
         me->delete("rulaitask/dget"); 
         me->delete_temp("chili");
         me->delete_temp("rulaitask");
         me->delete_temp("given_fu");
         message_vision(RED"灵符消失在一段火焰之中。。。\n"NOR, me);
         destruct(this_object());
       }
  return 1;
}



