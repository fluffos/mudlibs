//huarong 2003.7
#include <ansi.h>
inherit ITEM;
inherit "/u/huarong/npc/rulainew/jingshud.lpc";
inherit "/u/huarong/npc/rulainew/nianjing.lpc";

void init();
int do_read(string arg);


void setname()
{
        string name,long;
       long=HIY"\n西天大雷音寺我佛藏经阁";
        if(random(13)==1){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsahan[random(sizeof(jsahan))]+"』"NOR;long +=HIR"阿含部"HIY;} 
  else if(random(13)==2){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsbenyuan[random(sizeof(jsbenyuan))]+"』"NOR;long +=HIR"本缘部"HIY;} 
  else if(random(13)==3){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsbanruo[random(sizeof(jsbanruo))]+"』"NOR;long +=HIR"般若部"HIY;} 
  else if(random(13)==4){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jshuafa[random(sizeof(jshuafa))]+"』"NOR;long +=HIR"法华部"HIY;} 
  else if(random(13)==5){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jshuayan[random(sizeof(jshuayan))]+"』"NOR;long +=HIR"华严部"HIY;} 
  else if(random(13)==6){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsbaoji[random(sizeof(jsbaoji))]+"』"NOR;long +=HIR"宝积部"HIY;} 
  else if(random(13)==7){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsniepan[random(sizeof(jsniepan))]+"』"NOR;long +=HIR"涅槃部"HIY;} 
  else if(random(13)==8){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsdaji[random(sizeof(jsdaji))]+"』"NOR;long +=HIR"大集部"HIY;} 
  else if(random(13)==9){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsjingji[random(sizeof(jsjingji))]+"』"NOR;long +=HIR"经集部"HIY;} 
  else if(random(13)==10){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jslvbu[random(sizeof(jslvbu))]+"』"NOR;long +=HIR"律部"HIY;} 
  else if(random(13)==11){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsshijing[random(sizeof(jsshijing))]+"』"NOR;long +=HIR"释经论部"HIY;} 
  else if(random(13)==12){name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jszhongguan[random(sizeof(jszhongguan))]+"』"NOR;long +=HIR"中观部"HIY;} 
                   else {name=COLOR_D->random_color(random(4),((random(10)<8)?0:1))+"『"+jsyujia[random(sizeof(jsyujia))]+"』"NOR;long +=HIR"瑜伽部"HIY;} 
     
  long +="之经书。"NOR;
        set_name(name, ({ "fo jing", "jing", "book"}) );
       set("long", long+"\n\n");

}

void create()
{
        seteuid(getuid());
        setname();
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("material", "paper");
                set("value", 500);   
//                set("no_give","这么珍贵的东西，哪能随便给人？\n");
                set("no_drop","这么珍贵的东西，哪能随便丢掉？\n");
             }
}

void init()
{
        add_action("do_read", "read");
        add_action("do_read", "study");

        if( (int)this_object()->query("created") != 1 )
        {
                this_object()->set("created", 1);
                remove_call_out ("destroy_book");
                call_out ("destroy_book", 3600);//1 hours

        }
}



void destroy_book()
{
        message_vision("天空中翻出一只宽大的手掌，将" + (string)this_object()->query("name") + "轻轻一卷，消失在云端。\n", environment(this_object()));
        destruct(this_object());
}

string give_reward(object me) {
  mapping skill=me->query_skills();
  string *skillnames;
  string selected,msg;
  int level, inc=0;

  if (!skill) return "none";
  skillnames=keys(skill);
  selected=skillnames[random(sizeof(skillnames))];
  level=skill[selected];
  me->set_skill(selected,level+1);
  tell_object(me,"你从佛经中领悟了一级"+ to_chinese(selected) + "。\n");
  return selected;

}


int do_read(string arg)
{
        object me;
       string skill,msg;
        int sen_cost, gain, i, j, k, l, exp_r,dx_r, pot_r;
        
        me=this_player();

        if( !this_object()->id(arg) ) return 0;
        if( environment(this_object())!=me ) return notify_fail("书要拿起来读。\n");
        if( me->is_busy() )
                        return notify_fail("你现在不是正在读了吗，不要急于求成...\n");
        if( me->is_fighting() )
                        return notify_fail("现在才想到精研佛法，太晚了吧？\n");
        if( (int)me->query_skill("literate", 1) < 240 ) 
                return notify_fail("你看了半天，里面不少字都是它认得你你不认得它。\n");
       if( !this_object()->query("canread") )
                return notify_fail("你翻了翻经书，发现里面居然没有一个字。\n");
       if( me->query("rulaitask/bookname1")!=this_object()->query("name") )
                return notify_fail("你翻了翻经书，发现里面居然没有一个字。\n");
        if(!environment(me)->query("readplace"))
                return notify_fail("此地没有读书氛围，不是熟读经书的地方。\n");
       k=me->query("combat_exp")/10000000;
       j= 10 + k + random(k)/2;
       if (me->query_temp("readbook")>j )
           {
              me->delete_temp("addskill");
           }
       if( me->query_temp("readbook_ok") )
     {
           message_vision(HIB"$N看了半天，觉得书上之内容都熟记于胸了。\n"NOR, me);
          return 1;
     }

        sen_cost = 25 + random((100-(int)me->query("int")));
        if( sen_cost < 10 ) sen_cost = 10;
        if( (int)me->query("sen")<sen_cost )
                return notify_fail("你现在头晕脑胀，该休息休息了。\n"); 
        me->receive_damage("sen", sen_cost);
        message_vision("\n"+COLOR_D->random_color(random(4),0)+nianjing[random(sizeof(nianjing))]+NOR, me);
        message_vision(COLOR_D->random_color(random(4),0)+nianjing[random(sizeof(nianjing))]+NOR+"\n", me);
       i=random(100);
       l=random(10);
       if ( i>98 &&!me->query_temp("addskill"))
           {       
                 if (me->query("rulaitask/daccomplish") )
                   {
                     skill=give_reward(me);
                         msg=HIY+ me->query("name")+ HIM+"在熟读佛经时领悟了一级"+HIG+ to_chinese(skill)+ "。\n"+NOR;
                         CHANNEL_D->do_channel(me,"rumor",msg);
                      me->set_temp("addskill",1);
                    }
                  else
                    {
                        if ( l>8)
                         {
                          skill=give_reward(me);
                              msg=HIY+ me->query("name")+ HIM+"在熟读佛经时领悟了一级"+HIG+ to_chinese(skill)+ "。\n"+NOR;
                              CHANNEL_D->do_channel(me,"rumor",msg);
                           me->set_temp("addskill",1);
                          }
                        else
                         {
                           pot_r=random( me->query("combat_exp")/200000 );
                             me->add("potential",pot_r*3);
                           message_vision(HIB"$N在熟读佛经时顿觉自己境界又提高了一层。\n"NOR, me);
                         }
                    }
           }

       else if ( i>92 )
          {      exp_r=random( me->query("combat_exp")/100000 );
                    me->add("combat_exp",exp_r);
                  message_vision(HIB"$N在熟读佛经时顿悟了一些武功精要。\n"NOR, me);
          }
       else if ( i>88 )
          {       dx_r=random( me->query("daoxing")/100000 );
                    me->add("daoxing",dx_r);
                  message_vision(HIB"$N在熟读佛经时顿悟了一些仙家精要。\n"NOR, me);
          }
       else if ( i>84 )
          {       pot_r=random( me->query("combat_exp")/200000 );
                    me->add("potential",pot_r);
                  message_vision(HIB"$N在熟读佛经时顿觉自己境界又提高了一层。\n"NOR, me);
          } 
       else if ( i>76 )
          {
                  exp_r=random( me->query("combat_exp")/100000 );
                    me->add("combat_exp",-exp_r*2);
                  message_vision(HIB"$N看到经书上面的文字，长篇大幅，觉得头昏眼花。\n"NOR, me);
          }
       else if ( i>62 )
          {
                 dx_r=random( me->query("daoxing")/100000 );
                    me->add("daoxing",-dx_r*2);
                  message_vision(HIB"$N看到经书上面的文字，长篇大幅，觉得头昏眼花。\n"NOR, me);
          }
       else if ( i>8 )
          { 
                  message_vision(HIB"$N看到经书上面的文字，长篇大幅，觉得头昏眼花，上眼皮搭下眼皮。\n"NOR, me);
                  message_vision(HIB"只觉得佛祖交代的事情一定要完成，所以就硬着头皮读下去。\n"NOR, me);
          }
       else if ( i>2 )
          { 
                  message_vision(HIB"$N看到经书上面的文字，长篇大幅，觉得昏昏沉沉，上眼皮搭下眼皮。\n"NOR, me);
                  me->set("last_sleep",time()-270);
                  me->interrupt_me();
                  me->set_temp("force_sleep",1);
                  me->command_function("sleep");
                  pot_r=random( me->query("combat_exp")/200000 );
                    me->add("potential",-pot_r*2); 
                    if ((me->query("potential") -pot_r*2)<0) {me->set("potential",0);}
                  me->delete_temp("force_sleep");
         }
      else
         {
                  message_vision(HIB"$N熟读佛经，忽觉有所领悟，但又无法豁然开朗，心里一着急……\n"NOR, me);
                  me->unconcious();
         }

        me->start_busy(2+random(2));
        me->add_temp("readbook",1);
     if (me->query_temp("readbook")>=j )
        me->set_temp("readbook_ok",1);
        return 1;
}


