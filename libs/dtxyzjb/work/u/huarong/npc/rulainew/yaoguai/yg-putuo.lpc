//putuo妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/rulainew/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
       guai_value = max_value+max_value/4;
        set_skill("buddhism", guai_value+random(16));
        set_skill("jienan-zhi", guai_value+random(16));
        set_skill("lotusmove", guai_value+random(16));
        set_skill("lotusforce", guai_value+random(16));
        set_skill("staff", guai_value+random(16));
        set_skill("lunhui-zhang",guai_value+random(16));
        map_skill("spells", "buddhism");
        map_skill("unarmed", "jienan-zhi");
        map_skill("dodge", "lotusmove");
        map_skill("force", "lotusforce");
        map_skill("parry", "lunhui-zhang");
        map_skill("staff", "lunhui-zhang");
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
       create_family("南海普陀山", 1, "弟子");
       carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
       carry_object("/d/obj/weapon/staff/shugan")->wield();
       carry_object("/d/nanhai/obj/jingu-huarong");
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object();
        object me = owner();
        int i;
        i=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");                               
        remove_call_out("check2");
        call_out("check2",0);

 if(me->is_busy())
    {   
        command("exert recover");
    if (i<5)
           {
        command("wield staff");
        command("perform pudu on "+me->query("id"));
           }
    else if(i<8)
           {
        command("unwield staff");
        command("perform rulai on "+me->query("id"));
           }
    else
           {
         command("cast bighammer on "+me->query("id"));
            }
        remove_call_out("check");
        call_out("check",4);
    }
  if(!me->is_busy())
    {
        command("unwield staff");
        command("exert recover");
        command("perform lingxi on "+me->query("id"));
        remove_call_out("check");
        call_out("check",4);

    }
}
      


