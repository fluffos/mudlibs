//huarong 2003.4 for cjnpc(超级npc)
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{ 
       set_name(HIY"孙悟空"NOR, ({"sun wukong", "sun", "wukong"}));
       set("long",
"他就是五百年前大闹天宫的齐天大圣。\n");
       set("title", HIB"齐天大圣"NOR);
       set("gender", "男性");
       set("age", 20);
       set("class", "taoist");
       set("attitude", "friendly");
       set("rank_info/respect", "孙大圣");
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 200);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

       set("int", 30);
        set("per", 40);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("parry", 500);
        set_skill("stick", 500);
        set_skill("spells", 500);
        set_skill("dao", 500);
        set_skill("puti-zhi", 500);
       set_skill("sword", 500);
       set_skill("liangyi-sword", 500);
        set_skill("wuxiangforce", 500);
        set_skill("force", 500);
        set_skill("qianjun-bang", 500);
        set_skill("jindouyun", 500);
      set("fangcun/panlong_accept","done");
        
        map_skill("spells", "dao");
        map_skill("unarmed", "puti-zhi");
        map_skill("force", "wuxiangforce");
        map_skill("stick", "qianjun-bang");
        map_skill("parry", "qianjun-bang");
        map_skill("dodge", "jindouyun");
        map_skill("sword", "liangyi-sword");
        
create_family("方寸山三星洞", 1, "弟子");
setup();
       carry_object("/d/moon/obj/luoyi")->wear();
        carry_object("/d/obj/weapon/sword/mujian.lpc");
        carry_object("/d/obj/weapon/stick/fake-jingubang.lpc")->wield();
        
}


void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object ghost;
        object me=query_temp("my_killer");

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
      if(!ob->query_temp("jldl")) command("exert jldl");
  if(me->is_busy())
    {   
        command("unwield sword");
        command("wield stick");
        command("exert recover");
        command("jiali max");
        command("perform pili");
        command("perform qiankun");
if (random(10)>3) {
        command("perform wu");
      }
else  {
        command("cast light");
          }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("unwield stick");
        command("wield sword");
        command("exert recover");
        command("perform yin");
        remove_call_out("check");
       call_out("check",1);

    }
   if ( ob->is_fighting()&& !ob->is_busy())
      {   if (  (ob->query("eff_kee")) <  (ob->query("max_kee") / 2) )
             {
               command("say 逼我出绝招啊。");
               command("say 让你见识一下盘龙的威力！");
               command("unwield sword");
               command("wield stick");
               command("perform panlong");
              }
       }

}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
      command("say 真是横的怕不要命的。");
       command("young");
      message("sound", "\n孙悟空身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
      }
       destruct(this_object());
}
