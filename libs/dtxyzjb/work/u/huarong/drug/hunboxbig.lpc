//huarong 2003.7
inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIR"精装大丹盒"NOR, ({ "hunyuandan box","box" }) );
        set_weight(5000);
        set_max_encumbrance(8000);
  if( clonep() ){
    object a;
    seteuid(getuid());
    if(a=new("/u/huarong/drug/hunbig") )
      a->move(this_object());
    seteuid(getuid());
    set_default_object(__FILE__);
  } else {
                set("unit", "只");
                set("long", "这是一只四百粒装的非常精致的混元丹药盒。\n");
                set("value", 100000);
                set("no_sell",1);
                set("no_drop",1);
        }
}

int is_container() { return 1; }


