// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(GRN "仙灵丹" NOR, ({ "xianling dan", "dan", "xianling" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗可以提高十年道行的仙丹。\n");
                set("value", 1000000);
                set("unit", "粒");
				//set("credit",50);
				set("no_get",1);
                set("only_do_effect", 1);
        }
}
void init()
{
  add_action("do_eat", "eat");
}


int do_eat(string arg)
{
	object me = this_player();
	if (arg!="xianling dan" && arg!="xianling")
		return 0;
	message_vision("$N一仰脖，吞下了一粒" + this_object()->name() + "。\n", me);
	me->add("daoxing", 10000);
	destruct(this_object());
	return 1;
}

int query_autoload() { return 1; }