//flowray 2005.6.20
#include <ansi.h>
inherit SPEC;

void create()
{
	set_name (HIR"月卡"NOR, ({ "month card"}));
	set("long","这是一张会员月卡，"ZJURL("cmds:use month card")+ZJSIZE(20)+"使用"NOR"之后可以增加30天的会员时间。\n");

	set("unit","张");
	set_weight(100);
	set("value",3000000);
	set("no_drop",1);
	set("degree",1);
	set("flag","spec/mcard");
	set("desc","增加30天会员时间。");
	//set("credit",200);
	setup();
}

void init()
{
	add_action("do_eat","use");

}

int do_eat(string arg)
{
int vip_time;
	object me=this_player();
	vip_time=30 * 24 * 3600;

	if (arg!="month card")
      		return notify_fail("你要用什么?\n");

	if((int)me->query("vip/vip_time")!=0 && (int)me->query("vip/vip_time") < time())
	{
		me->delete("vip/vip_time");
		me->delete("vip/vip_start_time");
	}

	if (!(int)me->query("vip/vip_start_time"))
	{
		me->set("vip/vip_time",vip_time + time());
		me->set("vip/vip_start_time",time());
	}
	else
	{
		me->add("vip/vip_time",vip_time);
		me->set("vip/vip_start_time",time());
	}

	me->add("potential",1);
	write(ZJFORCECMD("time"));
	write(HIY"你用掉了一张"HIR"月卡"HIY"，会员时间增加30天，你可以用time查看。\n"NOR);

	degree();
	return 1;
}

int query_autoload() { return 1; }