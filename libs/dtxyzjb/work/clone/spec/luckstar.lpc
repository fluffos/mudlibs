#include <ansi.h>
inherit ITEM;

int do_use(string);
void create()
{
 set_name(HIY "幸运星" NOR, ({"luck star", "star"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗幸运星，可以使用它(use)让使用者获得1次100%的提炼宝石成功率。\n");
    set("no_sell", 1);
    set("no_drop", 1);
	//set("credit",100);
    set("value", 5000000);
  }
   setup();
}

void init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
  object ob = this_object();
  object me = this_player();
  int i;
  if (!id(arg))
    return notify_fail("你要使用什么？\n");
  if (!me->query("luckdazao"))
          {
    me->set("luckdazao",1);
   message_vision(HIW"$N捧起"HIY"幸运星"HIW"念念有词，只见$N周身顿时散发出耀眼光芒，一闪而过。\n"NOR, me);
   destruct(this_object());
      }
else
  {
    return notify_fail("你正在使用幸运星，不能累计使用！\n");
        }

return 1;
}

int query_autoload() { return 1; }
