// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "福缘丹" NOR, ({ "kar dan", "dan", "kar" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗园园的仙丹，据说吃了可以增强运气。\n");
                set("value", 5000000);
                set("unit", "粒");
				//set("credit",50);
				set("no_get",1);
                set("only_do_effect", 1);
        }
}
void init()
{
  add_action("do_eat", "eat");
}


int do_eat(string arg)
{
		object me = this_player();
		if (arg!="kar dan" && arg!="kar")
			return 0;
        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() + "。\n", me);
        if (me->query("kar") >= 40)
        {
                message_vision("$N忽然“哇哇”，吐了一地。\n", me);
                tell_object(me, "你觉得嘴里非常的苦。\n");
        } else
        {
                tell_object(me, HIG "你开始觉得你的运气开始不错起来，你的福缘指数提升了。\n" NOR);
                me->add("kar", 1+random(2));
				write(HIW"你当前的福源值为:"+HIC+me->query("kar")+NOR"\n");
				destruct(this_object());
        }


        return 1;
}

int query_autoload() { return 1; }