inherit ITEM;
void create()
{
     set_name(HIW"护身符"NOR, ({ "hushenfu" }));
        set_weight(100);

        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
				set("long", "张天师画的一张符，据说带在身上可保一命。\n");
				//set("credit",50);
                set("value", 2000000);
                set("no_drop", 1);
            }
}

int query_autoload() { return 1; }
