inherit NPC;

void create()
{
        set_name("老者", ({"lao zhe", "lao"}));
        set("age", 52);
        set("gender", "男性");
        set("long",
"一个精神抖擞的老头。\n");
        set("title", "无名居士");
        set("attitude", "peaceful");

        set("combat_exp", 20000);
  set("daoxing", 5000);

        set("shen_type", 1);
	set("max_force", 200);
	set("force", 200);
	set("force_factor", 5);
        set_skill("unarmed", 30);
        set_skill("dodge", 30);
	set_skill("force", 30);
        set_skill("parry", 30);
	setup();
        carry_object("/d/obj/cloth/linen")->wear();
}

int recognize_apprentice(object ob)
{
	return 1;
}


