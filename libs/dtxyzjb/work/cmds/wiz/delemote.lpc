//add by pujing

inherit F_CLEAN_UP;

int in_use;

int main(object me, string arg)
{
        mapping emote;

         if( !arg ) {
                   write("delemote 格式: delemote xxx \n");
                   return 1;
                   }

                emote = EMOTE_D->query_emote(arg);
                if ( ! emote["updated"] ) 
                    return notify_fail("没有这个 emote .\n");
                if( (emote["updated"] == me->query("id") )
                    || wizardp(me) || me->query("emote_del") )
                      {
                       EMOTE_D->delete_emote(arg);
                       write("此 emote 被成功的删除了。\n"); 
                      }
                else write("你无权删除此 emote.\n");
                    return 1;
}                
