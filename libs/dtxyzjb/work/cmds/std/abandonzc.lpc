// abandon.c

inherit F_CLEAN_UP;

// mon@xyj 10/15/98
void do_abandon(string yn, object me, string arg, int i);

int main(object me, string arg)
{
    mapping skills;
    int i;

        if( !arg || arg=="" ) return notify_fail("你要放弃哪一项技能的自创招式？\n");


        skills=me->query("skill_"+arg);
        i=sizeof(skills);
        if( !skills )
            return notify_fail("你并没有这项技能的自创招式。\n");

            write("你确定要放弃"+to_chinese(arg)+
                    "的自创招式？(y/n)");
            input_to("do_abandon",me,arg,i);
	
	return 1;
}

void do_abandon(string yn, object me, string arg, int i)
{
     if(!me) return;

     if(!yn) {
	 write("什么？\n");
	 return;
     }

     if(yn[0]=='y' || yn[0]=='Y' ) {
        if( !me->delete("skill_"+arg) ) {
                write("你没有这项技能的自创招式。\n");
		return;
	}

        write("你决定放弃" + to_chinese(arg) + "的自创招式。\n");
        me->add("zichuang/times",-i);
	
	if(MISC_D->random_capture(me,8000,0)) return;

	return;
     } else {
         write("你决定保留这项技能的自创招式。\n");
	 return;
     }
}

int help()
{
	write(@TEXT
指令格式：abandonzc <技能名称>

放弃你所学的技能的自创招式，注意这里所说的「放弃」是指将这项技能的所有自创招式
从你人物的资料中删除，请务必考虑清楚。

TEXT
	);
	return 1;
}
