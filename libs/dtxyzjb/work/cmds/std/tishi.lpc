#include <ansi.h>;
int main(object me, string arg)
{
   if( userp(me) && !wizardp(me) )
     return notify_fail("玩家无权做系统提示。\n");
   if (!arg) return notify_fail("你想要提示什么?\n");
   shout( HIW"【系统提示】"+NOR+HIY+me->name()+HIY+"("+me->query("id")+")："+HIY+ arg + "\n"NOR);
   write( HIW"【系统提示】"+NOR+HIY+me->name()+HIY+"("+me->query("id")+")："+HIY+ arg + "\n"NOR);
   return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : tishi <讯息>

这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话，巫师和NPC才能使用此命令。

HELP
    );
    return 1;
}



