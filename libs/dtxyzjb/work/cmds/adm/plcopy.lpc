inherit NPC;
inherit F_SAVE;

string query_save_file()
{
        string path;

        path = query("true_id", 1);
        if( !stringp(path) ) return 0;
        return sprintf("/data/user/%c/%s", path[0], path);
}

void create(string arg)
{
        set("true_id",arg);

//      seteuid(getuid());

        if (restore())
        {
                set_name( this_object()->query("name"), ({ arg }));
                set("id",arg);
                setup();
        }
        else    {
                set_name("失败品",({"error"}));
                set("no_this_player",1);
                setup();
        }
        set("true_id",arg);
}
void init()
{
        add_action("do_save","write");
}
int do_save()
{
        object me;
        me=this_player();
        if(!wizardp(me))        return notify_fail("?\n");
        if((int)this_object()->query("no_this_player"))
                return notify_fail("由于是失败品，你不能对它写数据。\n");
        if(save())      {
                tell_object(me,this_object()->query("name")+"记录写入成功。\n");
                return 1;
        }
        tell_object(me,"error to write\n");
        return 1;
}
