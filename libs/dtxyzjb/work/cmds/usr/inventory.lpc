//inventory.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i,j,all,page;
	object *inv, bao,ob;
	mapping count;
	mapping equiped;
	mapping unit;
	mapping ids;
	mapping itype;
	string *text,pops,short_name;

	string str,sss;
	string *dk=({});

	if( !arg )
	{
		page = 1;
	}
	else if(sscanf(arg,"%d %s",page,arg)!=2)
	{
		page = 1;
	}

	if (wizardp(me) && arg)
	{
		ob = find_player(arg);
		if (! ob) ob = find_living(arg);
		if (! ob) ob = present(arg, environment(me));
		if (! ob) return notify_fail("没有这个玩家。\n");
	}

	if (! ob) ob = me;

	inv = all_inventory(ob);
	if (! sizeof(inv))
	{
		write(ZJOBLONG+((ob == me) ? "你共有"HIY+me->query("yuanbao")+"元宝。"NOR+ZJBR"目前你身上没有任何东西。\n" : ob->name() + "共有"HIY+ob->query("SJ_Credit")+"通宝。"NOR+ZJBR"身上没有携带任何东西。\n"));
		return 1;
	}
	for (i = 0; i < sizeof(inv); i++)
	{
		short_name = inv[i]->query("name");
		if(inv[i]->query_amount())
			short_name = inv[i]->query_amount() + inv[i]->query("base_unit") + short_name;

		sss = short_name;
		if (inv[i]->query("equipped"))
			sss = HIG"口"NOR+sss;
		else sss = "　"+sss;
		sss += ZJBR+"　"+inv[i]->query("id");

		pops = ZJPOPMENU+ZJMENUF(2,3,9,30);
		pops += "查看 "+inv[i]->query("name")+"|look "+file_name(inv[i])+ZJSP2;
		if (inv[i]->query("equipped")&&mapp(inv[i]->query("weapon_prop")))
			pops += "放下 "+inv[i]->query("name")+"|unwield "+file_name(inv[i])+ZJSP2;
		else if (inv[i]->query("equipped")&&mapp(inv[i]->query("armor_prop")))
			pops += "脱掉 "+inv[i]->query("name")+"|remove "+file_name(inv[i])+ZJSP2;
		else if (mapp(inv[i]->query("weapon_prop")))
			pops += "装备 "+inv[i]->query("name")+"|wield "+file_name(inv[i])+ZJSP2;
		else if (mapp(inv[i]->query("armor_prop")))
			pops += "穿戴 "+inv[i]->query("name")+"|wear "+file_name(inv[i])+ZJSP2;
		else if (inv[i]==me->query_temp("is_riding"))
			pops += "下来 "+inv[i]->query("name")+"|unride "+file_name(inv[i])+ZJSP2;

		if (inv[i]->query("food_remaining"))
			pops += "吃 "+inv[i]->query("name")+"|eat "+file_name(inv[i])+ZJSP2;
		else if (inv[i]->query("liquid/remaining"))
			pops += "喝 "+inv[i]->query("name")+"|drink "+file_name(inv[i])+ZJSP2;
		else if (inv[i]->query("skill"))
			pops += "研读 "+inv[i]->query("name")+"|study "+file_name(inv[i])+ZJSP2;

		if(objectp(bao=present("bag",me))&&file_name(inv[i])!="baibao nang")
			pops += "存入"+bao->query("name")+"|cunbao "+file_name(inv[i])+ZJSP2;
		pops += "出售 "+inv[i]->query("name")+"|sellob "+file_name(inv[i])+ZJSP2;
		pops += "丢弃 "+inv[i]->query("name")+"|drop "+file_name(inv[i]);
		dk += ({ sss + ":look " + file_name(inv[i]) });
	}
	text = sort_array(dk, 1);

	str = ZJOBLONG+sprintf("%s共有"HIY"%d元宝。"NOR+ZJBR"身上带著下列这些东西(%d件，负重 %d%%)：\n",
		      (ob == me)? "你" : ob->name(),ob->query("yuanbao"),sizeof(text),
		      (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance());

	str += ZJOBACTS2+ZJMENUF(2,2,9,30);

	all = sizeof(text)/30;
	if(sizeof(text)%30) all += 1;
	if(page<1) page = 1;
	if(page>all) page = all;
	j = (page-1)*30;
	i = page*30;
	if (i >= sizeof(text)) i = sizeof(text);
	i--;
	if(all>1)
		str += "上一页:inventory "+(page-1)+" "+ob->query("id")+ZJSEP"下一页:inventory "+(page+1)+" "+ob->query("id")+ZJSEP;
	str += implode(text[j..i], ZJSEP);
	write(str+"\n");
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: inventory

可列出你(你)目前身上所携带的所有物品。

注 : 此指令可以 " i " 代替。

HELP );
	return 1;
}
