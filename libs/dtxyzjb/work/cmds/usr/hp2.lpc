
#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg)
{
	object ob;
	mapping my;
	string sp;

	seteuid(getuid(me));
	ob = me;

	my = ob->query_entire_dbase();

	sp  = ZJHPTXT+sprintf("气血.%d:%d/%d/%d:%s",my["kee"],my["kee"],my["eff_kee"],my["max_kee"],"#BBFF0000");
	sp += "║" + sprintf("精神.%d:%d/%d/%d:%s",my["sen"],my["sen"],my["eff_sen"],my["max_sen"],"#BBFF0066");
	sp += "║" + sprintf("法力.%d:%d/%d/%d:%s",my["mana"],my["mana"],my["mana"],my["max_mana"],"#BBFF0000");
	sp += "║" + sprintf("内力.%d:%d/%d/%d:%s",my["force"],my["force"],my["max_force"],my["max_force"],"#BB0000FF");
	sp += "║" + sprintf("武学.%d:%d/%d:%s",my["combat_exp"],my["combat_exp"],my["combat_exp"],"#BBFF00FF");
	sp += "║" + sprintf("潜能.%d:%d/%d/%d:%s",my["potential"]-my["learned_points"],my["potential"]-my["learned_points"],my["potential"],my["potential"],"#BB006600");
	sp += "\n";
	tell_object(me, sp);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : hp
	  hp <对象名称>		  (巫师专用)

这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。

see also : score
HELP );
    return 1;
}


