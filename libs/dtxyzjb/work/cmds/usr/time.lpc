	*/
}

int modify = 0;

int main(object me, string arg)
{
	int t;
	if (!wizardp(me) || !arg) {
		int GMT = time() + localtime(0)[8] + modify;

		write("现在是"HIR"大唐"HIG"盛世"NOR + NATURE_D->game_time() + "。\n");
		write("北京时间 " + Ctime(GMT+28800) + "\n");

		do_vip(me);
	} else if (arg != "-cond") {
		int i;

		if (sscanf(arg, "%d", i) == 1) {
			modify += i;
			//save();
			write(ctime(time() + localtime(0)[8] + 28800 + modify) + "\n");
			return 1;
		}
		me = LOGIN_D->find_body(arg);
		if (!me) return notify_fail("没有这个玩家。\n");
	}


	return 1;
}

int help(object me)
{
 	write(@HELP
指令格式: time

这个指令让你(你)知道现在的时辰和您的游戏贵宾情况和上次贵宾生效时间记录。

HELP
    );
    return 1;
}
