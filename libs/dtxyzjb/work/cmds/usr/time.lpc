			me->set("ggs/left_time",0);

		write (HIY"武曲附体："NOR+"已经使用"+CHINESE_D->chinese_time(t) +",本周还可以使用"+CHINESE_D->chinese_time(me->query("ggs/left_time") -t) +"。\n");
	}
	else if(me->query("registered") != 3)
		write (HIY"武曲附体："NOR+"你不是会员，不能使用武曲附体，如何成为会员请看( help vip )。\n");
	else if(this_week > me->query("ggs/last_week"))
		write (HIY"武曲附体："NOR+"当前你没有使用武曲附体，本周还可以使用十个小时。\n");
