#include <ansi.h>

inherit F_CLEAN_UP;


void do_look_eye(string player_id,string target);
void do_show_eye(object player,string objname);

int main(object me, string arg)
{
	//设置使用者 其实就是玩家英文账号

	object player,ob;
	//act_type 动作类型 target 目标
	string r, objname, target,player_id;
	//这句必须放在变量定义之后 没查为什么
	seteuid( getuid() );

	player = me;
	//if 必须花括号，不要用非主流!!
	if (! arg ){
		return notify_fail("你要搞点什么小动作？\n");
	}





	if (sscanf(arg, "look %s %s", player_id,target)==2){
		do_look_eye(player_id,target);
		return 1;
	}

	if (sscanf(arg, "%s", objname)==1){
			do_show_eye(player,objname);
				return 1;
		}


}


void do_show_eye(object player,string objname){
	object ob;
	string mtr_id,player_id;
	ob = present( objname, player );


	if (!ob){
		write("你身上没有这个东西!\n");
	}

	if (!objectp(ob)){
		write("你确定这是个物品?\n");
	}
	//look book of xxx
		mtr_id	 = (string)ob->query("id");
	player_id	 = player->query("id");
	CHANNEL_D->do_channel(player, "chat", "物品展示-"+ZJURL("cmds:show look "+player_id+" "+mtr_id)+ZJSIZE(24)+ob->query("name")+NOR"\n");


}


void do_look_eye(string player_id, string target){
	//先查找玩家
	int j;
	int i;
	mixed *inv;
	object player,obj;
	string show_txt,val,valt,*str2,str1,look_msg = "";
	string *bind_type=({"不绑定","装备绑定","拾取绑定","直接绑定"});
	mapping tianfu=([
        "str":"体    格",
        "con":"根    骨",
        "int":"悟    性",
        "per":"容    貌",
        "cps":"定    力",
        "spi":"灵    性",
        "cor":"胆    识",
        "kar":"福    缘",
                  ]);


	 player = find_player(player_id);

	 if (!objectp(player)){
	 		write("对方好像下线了..!\n");
	 		return;
	 	 }


	 	 obj = present( target, player );

	 	 if (!objectp(obj)){
	 		write("没有这个东西!\n");
	 		return;
	 	 }

	 	show_txt =ZJOBLONG+ZJSIZE(26)+obj->query("name")+NOR+replace_string(ZJBR+obj->query("long"),"\n","")+NOR+ZJBR;
	 	show_txt+="==========================="+ZJBR;

		if(obj->query("changed")>=1 )
		{
			str2=keys(tianfu);
			for (i=0;i<sizeof(tianfu);i++)
			{
				j=obj->query("weapon_wiel/"+str2[i]);
				if (j>0) {str1=tianfu[str2[i]];break;}
			}
			if (obj->query("armor_prop") && obj->query("type") == "dazao")
			{
				look_msg+=sprintf(HIM+"\n                    ※%22|s"+HIM+"※\n"+NOR,obj->short());
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"装备等级： "+HIM+chinese_number(obj->query("level"))+HIR+"级。\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"增加轻功级别数： "+HIM+obj->query("armor_prop/dodge")+"/30\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"增加物理防御力： "+HIM+obj->query("armor_prop/armor")+"/75\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"增加魔法攻击力： "+HIM+obj->query("armor_prop/spells")+"/30\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"增加内功抵抗力： "+HIM+obj->query("armor_prop/armor_vs_force")+"/700\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"增加魔法抵抗力： "+HIM+obj->query("armor_prop/armor_vs_spells")+"/700\n"+NOR);
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
			}
			else if (obj->query("weapon_prop"))
			{
				for (i=0;i<sizeof(tianfu);i++)
				{
					j=obj->query("weapon_wiel/"+str2[i]);
					if (j>0) {str1=tianfu[str2[i]];break;}
				}

				look_msg=sprintf(HIM+"\n                    ※%22|s"+HIM+"※\n"+NOR,obj->short());
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"基本属性： "+HIM+"                                                     ※\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"重    量：%10|d\t\t"+"价    值：%10|d"+HIM+"      ※\n"+NOR,obj->query_weight(),obj->query("value"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"耐 久 度：%5|d"+"/%5|d"+"\t\t"+"攻 击 力：%10|d"+HIM+"      ※\n"+NOR,obj->query("durability/now"),obj->query("durability/max"),obj->query("weapon_prop/damage"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"绑定类型：%-8s\t\t"+"绑定ＩＤ：%-10s"+HIM+"      ※\n"+NOR,bind_type[obj->query("bind_type")],obj->query("bind_id")?obj->query("bind_id"):"无");
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"附加属性： "+HIM+"                                                     ※\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"宝石插孔：%3|d"+"/%3|d"+"\t\t"+"幸 运 值：%3|d"+HIM+"             ※\n"+NOR,obj->query("sockets/now"),obj->query("sockets/max"),obj->query("weapon_prop/luck"));
				if (obj->query("cold_attack"))
				{
					look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"属性特征：  冰    "+"\t\t最高等级：%3|d"+HIM+"             ※\n"+NOR,obj->query("cold_attack/max_level"));
					look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"当前等级：%3|d"+"\t\t\t经 验 值：%10|d"+HIM+"      ※\n"+NOR,obj->query("weapon_prop/cold_attack"),obj->query("cold_attack/exp"));
				}
				else if(obj->query("fire_attack"))
				{
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"属性特征：  火    "+"\t\t最高等级：%3|d"+HIM+"             ※\n"+NOR,obj->query("fire_attack/max_level"));
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"当前等级：%3|d"+"\t\t\t经 验 值：%10|d"+HIM+"      ※\n"+NOR,obj->query("weapon_prop/fire_attack"),obj->query("fire_attack/exp"));
				}
				else if(obj->query("lightning_attack"))
				{
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"属性特征：  电    "+"\t\t最高等级：%3|d"+HIM+"             ※\n"+NOR,obj->query("lightning_attack/max_level"));
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"当前等级：%3|d"+"\t\t\t经 验 值：%10|d"+HIM+"      ※\n"+NOR,obj->query("weapon_prop/lightning_attack"),obj->query("lightning_attack/exp"));
				}
				else if(obj->query("poison_attack"))
				{
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"属性特征：  毒    "+"\t\t最高等级：%3|d"+HIM+"             ※\n"+NOR,obj->query("poison_attack/max_level"));
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"当前等级：%3|d"+"\t\t\t经 验 值：%10|d"+HIM+"      ※\n"+NOR,obj->query("weapon_prop/poison_attack"),obj->query("poison_attack/exp"));
				}
				else if(obj->query("wind_attack"))
				{
					look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"属性特征：  风    "+"\t\t最高等级：%3|d"+HIM+"             ※\n"+NOR,obj->query("wind_attack/max_level"));
					  look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"当前等级：%3|d"+"\t\t\t经 验 值：%10|d"+HIM+"      ※\n"+NOR,obj->query("weapon_prop/wind_attack"),obj->query("wind_attack/exp"));
				}
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"灵 性 值：%3|d"+"\t\t\t                 "+HIM"         ※\n"+NOR,obj->query("grade"),obj->query("grade"));
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"装备要求： "+HIM+"                                                     ※\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"道    行：%14s"+"年\t"+str1+"：%4|d"+HIM+"            ※\n"+NOR,chinese_number(obj->query("weapon_wiel/exp")),j);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+to_chinese(obj->query("skill_type",1))+"：%5|d"+"级\t\t"+"最大气血：%5|d"+HIM+"           ※\n"+NOR,obj->query("weapon_wiel/skill"),obj->query("weapon_wiel/max_kee"));
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"额外加成："+HIM+"                                                      ※\n"NOR);
				if (obj->query("weapon_prop/attack"))
					  look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加命中率： "+HIC+obj->query("weapon_prop/attack")+"  "+HIM+"                                            ※\n"+NOR);
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);

			}
			else if (obj->query("armor_prop"))
			{
				for (i=0;i<sizeof(tianfu);i++)
				{
					j=obj->query("armor_wiel/"+str2[i]);
					if (j>0) {str1=tianfu[str2[i]];break;}
				}
				look_msg=sprintf(HIM+"\n                   ※%22|s"+HIM+"※\n"+NOR,obj->short());
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"基本属性："+HIM+"                                                      ※\n"NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"重    量：%10|d"+"\t\t"+"价    值：%10|d"+HIM+"      ※\n"+NOR,obj->query_weight(),obj->query("value"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"耐 久 度：%7|d"+"/%7|d"+"\t"+"防 御 力：%7|d"+HIM+"         ※\n"+NOR,obj->query("durability/now"),obj->query("durability/max"),obj->query("armor_prop/armor"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"绑定类型：%-8s\t\t"+"绑定ＩＤ：%-10s"+HIM+"      ※\n"+NOR,bind_type[obj->query("bind_type")],obj->query("bind_id")?obj->query("bind_id"):"无");
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"附加属性："+HIM+"                                                      ※\n"NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"宝石插孔：%2|d"+"/%2|d"+"\t\t\t"+"防    风：%3|d"+"％"+HIM+"           ※\n"+NOR,obj->query("sockets/now"),obj->query("sockets/max"),obj->query("armor_prop/wind_defence"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"防    冰：%3|d"+"％\t\t\t"+"防    火：%3|d"+"％"+HIM+"           ※\n"+NOR,obj->query("armor_prop/cold_defence"),obj->query("armor_prop/fire_defence"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"防    电：%3|d"+"％\t\t\t"+"防    毒：%3|d"+"％"+HIM+"           ※\n"+NOR,obj->query("armor_prop/lightning_defence"),obj->query("armor_prop/poison_defence"));
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"装备要求： "+HIM+"                                                     ※\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"道    行：%14s"+"年\t"+str1+"：%4|d"+HIM+"          ※\n"+NOR,chinese_number(obj->query("armor_wiel/exp")),j);
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"额外加成："+HIM+"                                                      ※\n"NOR);
				if (obj->query("armor_prop/dodge"))
					look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加轻功有效等级： "+HIC+obj->query("armor_prop/dodge")+"级  "+HIM+"                                        ※\n"+NOR);
				if (obj->query("armor_prop/parry"))
					look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加招架有效等级： "+HIC+obj->query("armor_prop/parry")+"级  "+HIM+"                                        ※\n"+NOR);
				if (obj->query("armor_prop/spells"))
					look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加法术攻击力： "+HIC+obj->query("armor_prop/spells")+"点  "+HIM+"                                        ※\n"+NOR);
				if (obj->query("armor_prop/armor_vs_spells"))
					look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加法术抵抗力： "+HIC+obj->query("armor_prop/armor_vs_spells")+"点  "+HIM+"                                        ※\n"+NOR);
				if (obj->query("armor_prop/armor_vs_force"))
					look_msg+=sprintf(HIM+"※"+NOR+HIC+"增加内功抵抗力： "+HIC+obj->query("armor_prop/armor_vs_force")+"点  "+HIM+"                                        ※\n"+NOR);
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);

			}
			else if (obj->query("prop"))
			{
				look_msg=sprintf(HIM+"\n                 ※%22|s"+HIM+"※\n"+NOR,obj->short());
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
				look_msg+=sprintf(HIM+"※"+NOR+HIR+"属性："+HIM+"                                                          ※\n"NOR);
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"加攻击（防御）：%3|d"+"％"+HIM+"                                     ※\n"+NOR,obj->query("prop/damage"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"加魔攻（魔防）机率：%3|d"+"％"+HIM+"                                 ※\n"+NOR,obj->query("prop/attack"));
				look_msg+=sprintf(HIM+"※"+NOR+"\t"+HIC+"加幸运（插入宝石数）机率：%3|d"+"％"+HIM+"                           ※\n"+NOR,obj->query("prop/luck"));
				look_msg+=sprintf(HIM+repeat_string("※",34)+"\n"+NOR);
			}


			/*inv = all_inventory(obj);
			if( sizeof(inv) )
			{
				inv = map_array(inv, "inventory_look", this_object() );
					message("vision", sprintf("里面有：\n  %s\n",implode(inv, "\n  ") ), me);
			}
			if(me->query("ll")) me->set_temp("ll",valt);*/
		}
		if(obj->query("weapon_prop/damage")&&!obj->query("changed"))
		{
			valt += HIC"【攻击】: "+chinese_number((int)obj->query("weapon_prop/damage"))+NOR"\n";
		}
		if(obj->query("armor_prop/armor")&&!obj->query("changed"))
		{
			valt += HIC"【防御】: "+chinese_number((int)obj->query("armor_prop/armor"))+NOR"\n";
		}
		if(obj->query("durability")&&!obj->query("changed"))
		{
			valt += HIC"【耐久】: "+chinese_number((int)obj->query("durability/now"))+" / "+chinese_number((int)obj->query("durability/max"))+NOR"\n";
		}

	 	val = MONEY_D->money_str( obj->query("value") );
	 	if (val==""){
	 		valt = "价值:保密";
	 	}else{
	 		valt = "价值:"+val;
	 	}

		show_txt+=look_msg;
	 	show_txt+=valt;
	show_txt = replace_string(show_txt,"\n",ZJBR);
	if(show_txt[(strlen(show_txt)-4)..(strlen(show_txt)-1)]=="$br#")
		show_txt = show_txt[0..(strlen(show_txt)-5)];
	show_txt += "\n";
	write(show_txt);

}



int help(object me)
{
	write(@HELP
