#include <ansi.h>

#define MYSHOP_DIR	"/clone/spec/"
#define GSHOP_DIR	"/clone/shop/"

int main(object me, string arg)
{
	string str,*all_file,*g_file,file,price;
	int i,credit,value;
	object ob;
	int amount;

	all_file = get_dir(MYSHOP_DIR);
	g_file = get_dir(GSHOP_DIR);

	if (userp(me) && !query_heart_beat(me))
	{
         "/cmds/usr/quithy"->main(me);
         write("由于你没有心跳，请重新登陆!!\n");
		 return 0;
	}

	if(!sizeof(all_file))
		return notify_fail("商城中暂无商品出售。\n");

	if (! arg)
	{
		str = ZJOBLONG"你目前有"+me->query("yuanbao")+"元宝，请选择您想购买的道具：\n"ZJOBACTS2+ZJMENUF(4,4,8,35);
		for(i=0;i<sizeof(all_file);i++)
		{
			file = MYSHOP_DIR+all_file[i];
			if(file_size(file)<0) continue;
			credit = file->query("credit");
			price = credit?(credit+"元宝"):(MONEY_D->money_str(file->query("value")));
			str += sprintf("%s"ZJBR"%s:myshop look %s"ZJSEP,file->query("name"),price,file);
		}
		/*for(i=0;i<sizeof(g_file);i++)
		{
			file = GSHOP_DIR+g_file[i];
			if(file_size(file)<0) continue;
			credit = file->query("credit");
			price = credit?(credit+"元宝"):(MONEY_D->money_str(file->query("value")));
			str += sprintf("%s"ZJBR"%s:myshop look %s"ZJSEP,file->query("name"),price,file);
		}*/
		write(str+"\n");
		return 1;
	}
	else if (sscanf(arg,"look %s",file)==1)
	{
		credit = file->query("credit");
		price = credit?(credit+"元宝"):(MONEY_D->money_str(file->query("value")));
		str = ZJOBLONG+"【"+file->query("name")+"】　　价格："+price+NOR+ZJBR"一一一一一一一一一一一一一一一一一一一一一一一"ZJBR;
		str += replace_string(file->long(),"\n",ZJBR)+"\n";
		str += ZJOBACTS2+ZJMENUF(4,4,10,28);
		str += "购买1个:myshop buy 1 "+file+ZJSEP"批量购买:myshop buy "+file+"\n";
		//str += "购买:myshop buy "+file;
		write(str+"\n");
		return 1;
	}
	else if (sscanf(arg,"buy %s",file)==1)
	{
		if (sscanf(file, "%d %s", amount, file) != 2)
		{
			write(INPUTTXT("你想买多少个"+file->query("name")+"？"ZJBR"请确认你的背包空间足够。","myshop buy $txt# "+file)+"\n");
			return 1;
		}

		if(file_size(file)<0||(strsrch(file,MYSHOP_DIR)!=0&&strsrch(file,GSHOP_DIR)!=0))
			return notify_fail(HIM"没有这个道具！！"NOR"\n");

//		if(file_size(file)<0||strsrch(file,MYSHOP_DIR)!=0)
//			return notify_fail(HIM"没有这个道具！！"NOR"\n");

		if(file->query("no_shop"))
			return notify_fail(HIM"已下架商品，无法购买！！"NOR"\n");
		if(amount<1)
			return notify_fail(HIM"你要买多少个？？"NOR"\n");
		if(!file->query_amount()&&amount>100)
			return notify_fail(HIM"不可叠加物品一次最多买100个！！"NOR"\n");

		credit = file->query("credit");
		if(!value=file->query("base_value"))
			value = file->query("value");
		if(!credit&&!value)
			return notify_fail(HIM"购买失败！！"NOR"\n");

		if(credit)
		{
			if(!me->query("yuanbao")||me->query("yuanbao")<(credit*amount))
				return notify_fail(HIM"你的元宝不足，请充值！！"NOR"\n");
			me->add("yuanbao",-credit*amount);
			log_file("pay/myshop", sprintf("%s:%s(%s)消费%d元宝，从随身商城购买%d个%s(%s)。\n",
				ctime(time()),me->query("name"),me->query("id"),credit*amount,amount,file->query("name"),file->query("id")));
			me->add("yuanbao_Used",credit*amount);
		}
		else
		{
			if(!MONEY_D->player_pay(me, value * amount))
				return notify_fail(HIM"你的钱没那么多了！！"NOR"\n");
			log_file("pay/myshop2", sprintf("%s:%s(%s)消费%s，从随身商城购买%d个%s(%s)。\n",
				ctime(time()),me->query("name"),me->query("id"),MONEY_D->money_str(value*amount),amount,file->query("name"),file->query("id")));
		}
		if(file->query_amount())
		{
			ob = new(file);
			ob->set_amount(amount);
			write("你从商城中成功购买到"+ob->short()+"。"NOR"\n");
			ob->move(me,1);
		}
		else
		{
			for(i=0;i<amount;i++)
			{
				ob = new(file);
				ob->move(me,1);
			}
			write("你从商城中成功购买到"+amount+ob->query("unit")+ob->short()+"。"NOR"\n");
		}
		return 1;
	}
	else
		return notify_fail(HIM"你想干什么？？"NOR"\n");

	return 1;
}

int help(object me)
{
     write(@HELP

随身商城。

HELP
    );
    return 1;
}
