#include <ansi.h>
inherit F_CLEAN_UP;

int check_add_max(int max);
int check_sub_max(int max);

int main(object me, string arg)
{
	object ob;
	mapping my;
	int dao,x,i;
	int max,maxx;
	string str,msg;
	seteuid(getuid(me));

	if(!arg) ob = me;
	else if (wizardp(me))
	{ ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("您要察看谁的状态？\n");
	}
	else
		return notify_fail("只有巫师才可以察看别人的状态。\n");

	msg = ZJOBLONG;
	msg += sprintf(NOR CYN"━━━━━━━━━━"HIY"D"HIR"·"HIY"T"HIR"·"HIY"X"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━\n"NOR);
	msg += sprintf(NOR CYN""NOR WHT" 个人状态"NOR CYN" 姓 名："NOR WHT"%s "NOR CYN" 性别："NOR WHT"%s "NOR CYN"I D："NOR WHT"%s"NOR CYN"\n"NOR,ob->name(),ob->query("gender"),"["+capitalize(ob->query("id"))+"]");
	msg += sprintf(NOR CYN"━━━━━━━━━━━━━━━━━━━━━━\n"NOR);
	msg += sprintf(NOR CYN"                  攻击         防御             \n"NOR);
	max = check_add_max(ob->query_temp("apply/lightning_attack"));
	maxx = ob->query_temp("apply/lightning_attack");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIB" 雷系"NOR+CYN" 〗"NOR+"%s %d%%"NOR     , (max >= 175)? HIY: WHT,max , maxx/2,maxx*3/2);

	max = check_sub_max(ob->query_temp("apply/lightning_defence"));
	maxx = ob->query_temp("apply/lightning_defence");
	if(ob->query_temp("apply/immune_jin"))
        msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
		msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(ob->query_temp("apply/poison_attack"));
	maxx = ob->query_temp("apply/poison_attack");
	msg += sprintf(NOR CYN""NOR CYN"〖" HIG" 毒系"NOR+CYN" 〗"NOR+"%s %d%%"NOR, (max >= 175)? HIY: WHT,max , maxx*3/4,maxx*6/5);

	max = check_sub_max(ob->query_temp("apply/poison_defence"));
	maxx = ob->query_temp("apply/poison_defence");
	if(ob->query_temp("apply/immune_mu"))
		msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
		msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(ob->query_temp("apply/cold_attack"));
	maxx = ob->query_temp("apply/cold_attack");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIC" 冰系"NOR+CYN" 〗"NOR+"%s %d%%"NOR    , (max >= 175)? HIY: WHT,max , maxx*4/5,maxx*4/3);

	max = check_sub_max(ob->query_temp("apply/cold_defence"));
	maxx = ob->query_temp("apply/cold_defence");
	if(ob->query_temp("apply/immune_shui"))
		msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
		msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(ob->query_temp("apply/fire_attack"));
	maxx = ob->query_temp("apply/fire_attack");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIR" 火系"NOR+CYN" 〗"NOR+"%s %d%%"NOR    , (max >= 175)? HIY: WHT,max , maxx,maxx*5/4);

	max = check_sub_max(ob->query_temp("apply/fire_defence"));
	maxx = ob->query_temp("apply/fire_defence");
	if(ob->query_temp("apply/immune_huo"))
        msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
		msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(ob->query_temp("apply/wind_attack"));
	maxx = ob->query_temp("apply/wind_attack");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIM" 风系"NOR+CYN" 〗"NOR+"%s %d%%"NOR    , (max >= 175)? HIY: WHT,max , maxx*5/6,maxx*9/8);
	max = check_sub_max(ob->query_temp("apply/wind_defence"));
	maxx = ob->query_temp("apply/wind_defence");
	if(ob->query_temp("apply/immune_phy"))
        msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
        msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(( ob->query_temp("apply/add_max_spells_kee")+ob->query_temp("apply/add_max_spells_all"))/100);
	maxx =  ob->query_temp("apply/add_spells_kee")+ob->query_temp("apply/add_spells_all");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIY" 魔法气血"NOR+CYN" 〗"NOR+   "%s%d%%"NOR    , (max >= 175)? HIY: WHT,max , maxx*2/3,maxx*8/7);

	max = check_sub_max((ob->query_temp("apply/sub_max_spells_kee")+ob->query_temp("apply/sub_max_spells_all"))/100);
	maxx = ob->query_temp("apply/sub_spells_kee")+ob->query_temp("apply/sub_spells_all");
	if(ob->query_temp("apply/immune_magic"))
        msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
        msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	max = check_add_max(( ob->query_temp("apply/add_max_spells_sen")+ob->query_temp("apply/add_max_spells_all"))/100);
	maxx =  ob->query_temp("apply/add_spells_sen")+ob->query_temp("apply/add_spells_all");

	msg += sprintf(NOR CYN""NOR CYN"〖" HIY" 魔法精神"NOR+CYN" 〗"NOR+   "%s%d%%"NOR    , (max >= 175)? HIY: WHT,max ,maxx*2/3,maxx*8/7);

	max = check_sub_max((ob->query_temp("apply/sub_max_spells_sen")+ob->query_temp("apply/sub_max_spells_all"))/100);
	maxx = ob->query_temp("apply/sub_spells_sen")+ob->query_temp("apply/sub_spells_all");
	if(ob->query_temp("apply/immune_magic"))
        msg += sprintf(HIW"%10s"NOR CYN"\n"NOR ,"免疫");
	else
	msg += sprintf(WHT"%s %s%10d%%"NOR CYN"\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);

	msg += sprintf(NOR CYN"━━━━━━━━━━━━━━━━━━━━━━\n"NOR);
	/*max = ob->query_temp("combat/bless");
	if(max >= 10) { str = HIY;}
	else if(max <= -10) {str = RED;}
	else str = WHT;
	msg += sprintf(NOR CYN""NOR MAG"〖 祝福 〗  "NOR "%s%3d"NOR , str,max);
	max = ob->query_temp("combat/luck");
	if(max >= 10) { max = 10;str = HIY;}
	else if(max <= -10) {max = -10;str = RED;}
	else str = WHT;

	msg += sprintf(NOR CYN""NOR MAG"  〖 幸运 〗   "NOR "%s%3d\n"NOR ,str,max);*/

	max = ob->query_temp("apply/magic_find")/100;
	if(ob->query("age") > 17)
	{
		max += ob->query_kar();
		msg += sprintf(NOR CYN""NOR MAG"〖 物品找寻 〗"NOR WHT"%7d%%"NOR CYN"%6s\n"NOR ,max," ");
	}
	else
	{
		max = 0;
		msg += sprintf(NOR CYN""NOR MAG"〖 物品找寻 〗"NOR  HIY"%6s"NOR CYN"      \n"NOR ,"暂时保密");
	}
	msg += sprintf(NOR CYN"━━━━━━━━━━"HIY"D"HIR"·"HIY"T"HIR"·"HIY"X"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━\n"NOR);
	msg = replace_string(msg,"\n",ZJBR);
	if(msg[(strlen(msg)-4)..(strlen(msg)-1)]=="$br#")
		msg = msg[0..(strlen(msg)-5)];
	msg += "\n";
	message("vision", msg, me);
        return 1;
}
int check_add_max(int max)
{
        if(max > 175) max = 175;

        return max;
}
int check_sub_max(int max)
{
        if(max > 75) max = 75;

        return max;
}
int help(object me)
{
        write(@HELP
指令格式 : wx
           wx <对象名称>                   (巫师专用)
这个指令可以显示你(你)或指定对象(含怪物)的五行攻击防御等属性?
see also : score,help wuxin
HELP
  );
 return 1;
}
