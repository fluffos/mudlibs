// time.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string str;
	if(!arg)
	{
		if(!me->query_temp("pindao"))
		{
			arg = "chat";
			str = "仙侣情缘";
		}
	}
	else if(arg=="chat")
	{
		str = "仙侣情缘";
	}
	else if(arg=="rumor")
	{
		str = "长安夜话";
	}
	else if(arg=="xyj")
	{
		str = "西游记";
	}
	else if(arg=="bh")
	{
		str = "帮派";
	}
	else if(arg=="party")
	{
		str = "门派";
	}
	else if(arg=="trade")
	{
		str = "交易";
	}
	else if(arg=="qq")
	{
		str = "好友";
	}
	else if(arg=="pindao")
	{
		write(ZJOBLONG"请选择聊天频道：\n"+ZJOBACTS2+ZJMENUF(3,3,8,30)
				+"仙侣情缘:liaotian chat"ZJSEP"长安夜话:liaotian rumor"ZJSEP"西游记:liaotian xyj"ZJSEP"门派:liaotian party"ZJSEP"帮派:liaotian bh"
				ZJSEP"交易:liaotian trade\n");
		return 1;
	}

	if(arg)
	{
		me->set_temp("pindao/id",arg);
		me->set_temp("pindao/name",str);
	}
	write(INPUTTXT("当前频道【"+me->query_temp("pindao/name")+"】，请输入内容：",
			me->query_temp("pindao/id")+" $txt#")+"\n"+ZJOBACTS2+ZJMENUF(3,3,8,30)"选择频道:liaotian pindao"ZJSEP"好友频道:liaotian qq\n");
	return 1;
}

int help(object me)
{
     write(@HELP
指令格式: time

这个指令告诉你现实世界中现在的时间。

HELP
    );
    return 1;
}
