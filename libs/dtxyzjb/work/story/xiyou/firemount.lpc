
#include <ansi.h>

int give_gift(string money, int amount, string name);

private mixed *story = ({
      "～～～～翠云山 芭蕉洞～～～～",
      "悟空：  嫂嫂！",
      "公主：  啊？我怎么听到好像是那猴子的声音啊？",
      "丫鬟：  是啊，我也听到了！",
      "公主：  你……你在哪里啊？",
      "悟空：  量你也想不到，刚才你喝茶的时候，我已经和茶水一起到你的肚子里面来了！",
      "公主：  喝茶？我没喝啊？是……是我的丫鬟喝的！",
      "悟空：  什么！",
      "丫鬟：  啊呀！好象真的是在我的肚子里面耶！",
      "悟空：  靠！这都能搞错？明明以为是嫂嫂喝的……真是失败！",
      "公主：  你钻到她肚子里干什么？",
      "悟空：  当然是想借您的扇子用一用了！",
      "公主：  我要是不借呢？",
      "悟空：  那我就……催情大法~~~~~~~~~~~！",
      "丫鬟立时觉得欲火中烧，还做出了许多的挑逗性动作。",
           (: give_gift, "gold", 1 + random(4), HIY"黄金"NOR :),
      "公主：  求求您不要再练大法了，这样下去的话，说不定她会做出什么动作，
                     到时候上级审查的时候会通不过的啊！我给你芭蕉扇就是了！",
      "悟空：  好，你可得说话算数，你让丫鬟张开嘴，我这就出去！",
      "biu~~~~~~~~~悟空从丫鬟的嘴里跳了出来，果然见到铁扇公主的手里拿着一把扇子。",
      "悟空：  如此就多谢嫂嫂了！老孙走也！",
      "公主：  哎！你还没拿扇子哪？！",
      "悟空：  靠！又忘了！",
           (: give_gift, "thousand-cash", 1 + random(2), HIW"银票"NOR :),
});

void create()
 
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

int give_gift(string money, int amount, string name)
{
        STORY_D->give_gift("/obj/money/" + money, amount,
                           HIM "\n“啪”的一声一些" + name + HIM"掉到你面前。\n\n" NOR);
        return 1;
}

