//by seawind

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "十面埋伏--树阵");
	set("long", @LONG
苍苍的林木，无边无涯，你渐渐的迷失了方向。
LONG );
	set("exits", ([
		"east" : "/d/bwbj/fight7",
		"south" : __DIR__"shulin"+(random(8)+6),
		"west" : __DIR__"shulin"+(random(8)+6),
		"north" : __DIR__"shulin"+(random(8)+6),
	]));
	set("no_clean_up", 0);
	set("objects",([
		__DIR__"npc/hanbing2" : 3
]));
	setup();
}

void init()
{

	object ob, room;
	mapping fam;

	int i = random(2);
	if( i == 0) return;

	ob = this_player();
	room = this_object();

	room->delete("exits");
	
	ob->set("startroom", "/d/bwbj/szzy");
       

	message_vision(HIR "\n$N一不小心，走进了汉兵们设下的陷阱！
静观其变吧，阵行会慢慢变化的！
\n\n" NOR, ob);

	

	call_out("trapping", 220, ob, room);

}

void trapping(object ob, object room)
{
	if ( !living(ob) ) return;

	message_vision(HIY "\n一丝天光透过树林射了进来，你终于辨清了方向！\n\n\n" NOR, ob);
     	ob->move(__DIR__"shulin1"); 

	room->set("exits/south", __DIR__"shulin"+(random(8)+6));
	room->set("exits/north", __DIR__"shulin"+(random(8)+6));
	room->set("exits/east", __DIR__"shulin"+(random(8)+6));
	room->set("exits/west", __DIR__"shulin"+(random(8)+6));
}
