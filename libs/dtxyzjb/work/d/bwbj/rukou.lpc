inherit ROOM;

void create()
{
	set("short", "十面埋伏--五行洞入口");
	set("long", @LONG
这里是五行阵的入口。韩信用兵，取天之巧，取地之灵，无处不为阵，
无阵不为巧！
LONG );
	set("exits", ([
		"south" : __DIR__"wuxing"+random(5),
		"east" : __DIR__"fight7",
	]));
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}

