
inherit ITEM;   
int fail_to_xunzhao(object who);
int ok_to_xunzhao(object who);
        
void create()
{
        set_name("污泥堆",({"wuni"}));
        set_weight(5000000);
        if (clonep())
                set_default_object(__FILE__);
        else {  
                set("long","臭哄哄的污泥堆。\n");
                set("unit", "堆");
    }
 
        setup();
}
        
void init()     
{
        add_action("do_xunzhao", "xunzhao");
}       
        
                
int do_xunzhao(string arg)
{	object who=this_player();
                
        if( !arg || arg!="wuni")
                return notify_fail("你要在哪里找，找什么？\n");
                call_out("ok_to_xunzhao", 1, who);
		return 1;
}
int fail_to_xunzhao(object who)
{	
        if( !who || environment(who) != environment(this_object()) ) return 1;
        if( (int)who->query("kee") < 100
        ||      (int)who->query("force") < 100
        ||      (int)who->query_str() < 20 ) {

		message_vision("$N试着想找什么，但是看了看那恶心的污泥，摇摇头，算了。\n",who);
                return 1;
        }
        who->receive_damage("kee", 80);
        who->add("force", -30);

	message_vision("$N累的半死，只找到一些垃圾。\n",who);
        return 1;
}
int ok_to_xunzhao(object who)
{	
        if( !who || environment(who) !=environment(this_object()) ) return 1;
        if( (int)who->query("kee") <100
        ||      (int)who->query("force") < 100
        ||      (int)who->query_str() < 20 ) {
		call_out("fail_to_xunzhao", 2, who);
		return 1;
        }

	if( (int)this_object()->query("poxiedone") ) {
		call_out("fail_to_xunzhao", 2, who);
		return 1;
	}

      if( !who->query_temp("enter_position") ) {
		call_out("fail_to_xunzhao", 2, who);
		return 1;
	}
	if( (string)who->query_temp("enter_position")==(string)who->query_temp("heard_position")){
                call_out("succeed", 2, who);
		return 1;
        }
	if ( (string)who->query_temp("enter_position") =="桥1" ) {
                call_out("qiao1", 2, who);
        	return 1;
	}
	if ( (string)who->query_temp("enter_position") =="桥2" ) {
                call_out("qiao2", 2, who);
        	return 1;
	}
	if ( (string)who->query_temp("enter_position") =="桥3" ) {
                call_out("qiao3", 2, who);
		return 1;
        }
	if ( (string)who->query_temp("enter_position") =="桥4" ) {
                call_out("qiao4", 2, who);
		return 1;
        }
	if ( (string)who->query_temp("enter_position") =="桥5" ) {
                call_out("qiao5", 2, who);
        	return 1;
	} 
	if ( (string)who->query_temp("enter_position") =="桥6" ) {
                call_out("qiao6", 2, who);
        	return 1;
	}
	if ( (string)who->query_temp("enter_position") =="桥7" ) {
                call_out("qiao7", 2, who);
        	return 1;
	}
	if ( (string)who->query_temp("enter_position") =="桥8" ) {
                call_out("qiao8", 2, who);
		return 1;
        }
}
int succeed(object who)
{	object m;
        if( !who || environment(who) !=environment(this_object()) ) return 1;
	if( m = new("/d/bwbj/obj/poxie") ){
	m->move(who);
	message_vision("$N累了满头大汗，终于，，，天见可怜，找到了那该死的鞋子。\n", who);
	message_vision("$N伸手将鞋子拎在手里。\n", who);
	}
	this_object()->set("poxiedone", 1);
	return 1;
}
int qiao1(object who)
{	int i;
	i=(int)who->query("max_kee")/5;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("$N污泥里头钻出了只螃蟹。\n",who);
        message_vision("\n螃蟹狠狠的咬了$N一口。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 1, who);
        return 1;
	}
        who->receive_wound("kee", i);
	COMBAT_D->report_status(who);
        who->add_temp("xunzhao_time", 1);   
        return 1;
}
int qiao2(object who)
{	int i;
	i=(int)who->query("max_kee")/5;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("突然，从污泥里钻出一只水蛇。\n",who);
        message_vision("\n$N吓的哇哇大叫。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N身上被桥洞擦破好几处，一幅狼狈不堪的样子。\n", who);
        who->receive_wound("kee", i);
        COMBAT_D->report_status(who);  
        who->add("xunzhao_time", 1);   
        return 1;
}
int qiao3(object who)
{	int i;
	i=(int)who->query("max_kee")/5;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("$N找的正起劲，忽然，喷出了一股地下水！\n",who);
	message_vision("\n$N被冲的满脸漆黑。\n",who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N狼狈不堪的擦着脸，丧气极了。\n", who);
        who->receive_wound("kee", i);
        COMBAT_D->report_status(who);
        who->add("xunzhao_time", 1);   
        return 1;
}
int qiao4(object who)
{	int i;
	i=(int)who->query("max_sen")/5;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("$N哭丧着脸开始找鞋子，突然一只蝎子出现了。\n",who);
        message_vision("\n蝎子狠狠的咬了你一口。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N看起来相当狼狈。\n", who);
        who->receive_wound("sen", i);
        COMBAT_D->report_sen_status(who);
        who->add_temp("xunzhao_time", 1);   
        return 1;
}
int qiao5(object who)
{	int i;
	i= (int)who->query("max_sen")/5 ;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("$N一不小心抓住了埋在土里的一把断刀。\n",who);
        message_vision("\n完了,可能要得破伤风了。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N瘫坐在地下,气的直骂娘!\n", who);
        who->receive_wound("sen", i);
        COMBAT_D->report_sen_status(who);
        who->add_temp("xunzhao_time", 1);   
        return 1;
}
int qiao6(object who)
{	int i;
        i= (int)who->query("max_sen")/5 ;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

	message_vision("污泥底下露出黑黝黝的一个洞口。\n",who);
        message_vision("\n洞口中忽然刮出一阵阴风，夹头夹脑的吹向$N！\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N被吹的晕头转向，不知所措。\n", who);
        who->receive_wound("sen", i);
        COMBAT_D->report_sen_status(who);
        who->add_temp("xunzhao_time", 1);
	return 1;
}
int qiao7(object who)
{	int i;
        i= (int)who->query("max_kee")/5 ;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("污泥突然变的十分奇怪。\n",who);
        message_vision("\n污泥粘住了$N的手心。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}
        message_vision("\n$N浑身上下都是泥，气的直打哆嗦。\n", who);
        who->receive_wound("kee", i);
        COMBAT_D->report_status(who);
        who->add_temp("xunzhao_time", 1);   
        return 1;
}
int qiao8(object who)
{	int i;
        i= (int)who->query("max_kee")/5 ;
        if( !who || environment(who) !=environment(this_object()) ) return 1;

        message_vision("一只大蜈蚣钻了出来！n",who);
        message_vision("\n蜈蚣口一张，轻轻的吻了一下$N。\n", who);
        if( (int)who->query_temp("xunzhao_time") > 3) {
                call_out("faint_him", 0, who);
        return 1;
	}

        message_vision("\n$N哇的一声，嚎叫了起来。\n", who);
        who->receive_wound("kee",i);
        COMBAT_D->report_status(who);
        who->add_temp("xunzhao_time", 1);   
        return 1;
}
int faint_him(object who)
{	who->delete_temp("xunzhao_time");
	who->unconcious();
	return 1;
}

