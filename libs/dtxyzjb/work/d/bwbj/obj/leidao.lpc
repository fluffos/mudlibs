// leidao.c

#include <ansi.h>
#include <weapon.h>

//inherit F_UNIQUE; 
inherit BLADE;

void create()
{
	set_name( MAG "地 狱 雷 刀" NOR, ({ "diyu leidao", "blade", "dao" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
        set("value", 1000000000000);
      set("no_sell","小店小本经营，买不起这么贵重的宝物。\n");
    set("no_give","雷刀杀气过于浓郁，常人勉强使用反易为刀伤!\n");
		set("material", "gold");
                set("no_drop", "怎么，你真舍的扔？");
		set("replace_file", "/d/obj/weapon/blade/blade");
		set("long", "一把紫色的大刀，刀锋锐利，吹毛而过。此等凶物似乎不是人所能用，还是葬（bury)它到它该去的地方吧！\n");
		set("wield_msg", MAG"$N「唰」地一声抽出一把$n"NOR+MAG"握在手中，刹那之间，幽冥剧震！紫雷暴鸣！\n"NOR);

		set("unwield_msg", "$N背负双手，虚空凝劲，九幽雷刀缓缓入鞘！\n");
	}
	init_blade(160);
	setup();
}
