// by seawind


#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("贴身水靠", ({ "shui kao", "cloth" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一袭漆黑的水靠．\n");
    set("unit", "袭");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 30);
    set("armor_prop/dodge", 10);
  }
  setup();
}

