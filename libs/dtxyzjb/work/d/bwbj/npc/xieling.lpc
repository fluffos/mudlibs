//by seawind

inherit NPC;
void create()
{
  set_name("雷刀邪灵", ({"xie ling"}));
  set("gender", "男性");
  set("long", "只见他全身笼罩在一片紫气之中，傲然立在你的面前，杀气腾腾!\n");
  set("attitude", "aggressive");
  set("combat_exp", 5000000+random(1000000));
  set("daoxing", 5500000);

  set("age", 100);
  set("per", 30);
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);
  set("max_kee", 3500+random(1500));
  set("max_sen", 4000);
  set("force", 4000);
  set("max_force", 4000);
  set("max_mana", 6000);
  set("mana",6000);	
  set_skill("spells", 100);
  set_skill("force",100);
  set_skill("parry", 50+random(150));
  set_skill("dodge", 150+random(150));
  set_skill("unarmed", 150+random(150));
  set_skill("huxiaoquan", 150+random(150));
  set_skill("zhaoyangbu", 150+random(150));
  map_skill("dodge", "zhaoyangbu");
  map_skill("unarmed", "huxiaoquan");

carry_object("/d/bwbj/obj/leidao")->wield();


  setup();
}

  



void die()
{
    object dao;
    string ld="/d/bwbj/obj/leidao.lpc";

    if( ld->in_mud() )
    {
	dao = new(ld->query("replace_file"));
    }
    else
	dao = new(ld);
    if( environment() ) {
	message("vision", "一阵紫光闪过，锵然一声，雷刀破锁而出，仿佛贯穿着万古灵性，缓缓凝在空气中，那撕天紫气，似乎要破狱而出！！！\n", environment());
    }
    dao->move(environment(this_object()));
    destruct(this_object());
}
