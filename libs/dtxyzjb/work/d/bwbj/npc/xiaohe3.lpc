// by seawind
 
#include <ansi.h>;
inherit NPC;
#include "star.h"



void create()
{
        set_name("萧 何", ({ "xiao he", "xiaohe", "xiao" }) );
        set("gender", "男性" );
	set("long",
		"汉王骑下----萧 何\n"
	);
	set("str", 20);
	set("per", 130);
	set("age", 86);
	set("cor", 30);
	set("task",1);
	set("cps", 75);
	set("kar", 1000);
	set("family/family_name","江湖浪子");
	set("class","human");
	set("int", 40);
	set("con", 40);
	set("spi", 40);
	set("title", HIG"成也萧何，败亦萧何"NOR);
	set("combat_exp", 5400000);
	set("daoxing", 3400000);
	set("max_sen", 6000);
	set("max_kee", 6000);
	set("force", 600000); 
	set("max_force", 6000);
	set("force_factor", 100);
	set("max_mana", 6000);
	set("mana", 6000);
	set("mana_factor", 250);
	set_skill("spells",450);
        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("sword", 350);
        set_skill("wuji-force", 350);
        set_skill("piaoxiang", 350);
        set_skill("tanzhishentong", 350);
        set_skill("literate", 350);
        set_skill("unarmed", 350);
        set_skill("yujianshu", 400);
set_skill("baiyun-sword", 350);
        set_skill("tianjijue",350);
        map_skill("spells", "tianjijue");
        map_skill("dodge", "piaoxiang");
        map_skill("force", "zixia-shengong");
        map_skill("parry", "baiyun-sword");
        map_skill("sword", "baiyun-sword");
        map_skill("unarmed", "tanzhishentong");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "freeze" :),
                (: perform_action, "sword","feixian" :),
	
}) );

	setup();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
	add_action("do_none","get");
	
        add_action("do_none","fight");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/er")=="done") && (ob&&ob->query("bieji1/san")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【雁门关外】项 羽(Xiang yu):"+ob->name()+
        "天纵将才，萧何，你也有今天！虞，你究竟在何方？\n"NOR,users());
        ob->set("bieji1/san","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"$N的尸体上露出诡异的笑容.... \n"NOR,this_object() );
       ::die();
}


