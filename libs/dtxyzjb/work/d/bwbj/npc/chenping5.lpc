#include <ansi.h>;
inherit "/u/wiz/super_npc.lpc";
void create()
{
       set_name("陈 平", ({ "chen ping", "chenping", "chen" }) );
        set("gender", "男性" );
        set("long",
                "计略天下----陈平\n"
        );
set("str", 25);
set("attitude", "aggressive");
set("per", 40);
set("age", 40);
set("cor", 30);
set("cps", 75);
set("task",1);
set("kar", 1000);
set("int", 40);
set("family/family_name","蜀山剑派");
set("class","human");
set("con", 40);
set("spi", 40);
set("title", HIM"计略天下"NOR);
set("combat_exp", 39000000);
set("daoxing", 29800000);
set("max_sen", 26000);
set("max_kee", 28000);
set("force", 12000); 
set("max_force", 6000);
set("force_factor", 240);
set("max_mana", 6000);
set("mana", 12000);
set("mana_factor", 250);
        
set_skill("spells",350);
set_skill("force", 350);
set_skill("dodge", 350);
set_skill("parry", 350);
set_skill("sword", 350);
set_skill("zixia-shengong", 350);
set_skill("sevensteps", 350);
set_skill("hunyuan-zhang", 350);
set_skill("literate", 350);
set_skill("unarmed", 350);
set_skill("yujianshu", 400);
set_skill("shushan-jianfa", 350);
set_skill("taoism",350);
map_skill("spells", "taoism");
map_skill("dodge", "sevensteps");
map_skill("force", "zixia-shengong");
map_skill("parry", "mindsword");
map_skill("sword", "yujianshu");
map_skill("unarmed", "hunyuan-zhang");
 set("chat_chance_combat", 90);
   set("chat_msg_combat", 
   ({
     (: cast_spell, "shou" :),
     (: perform_action, "sword","wanjian" :),
     (: perform_action, "unarmed","feilong" :),
   }) );


        setup();
   carry_object("/d/obj/weapon/sword/qingfeng")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
add_action("do_none","get");
add_action("do_none","fight");
        add_action("do_none","cast");
        add_action("do_none","whisper");
        add_action("do_none","recall");
        
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("last_damage_from");

if( ob->query("bieji1/number")==4)
        {
        ob->start_busy(3);
        message("chat",HIR+"【十面埋伏】刘 邦(Liu bang):"+ob->name()+
        "已经闯入我军营帐，众将听令，有斩其首级者，赏黄金千两，官封千户！\n"NOR,users());
        ob->set("bieji1/wu","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"$N的尸体上露出诡异的笑容.... \n"NOR,this_object() );
       ::die();
}



