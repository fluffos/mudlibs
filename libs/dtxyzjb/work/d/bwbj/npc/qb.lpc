#include <ansi.h>

inherit NPC;

void create()
{
  set_name("骑 兵", ({"qi bing","qibing"}));
  set("gender", "男性");
  set("age", 40);
  set("long","一个骑兵，，威风八面的坐在高头大马上！\n");
  set("attitude", "aggressive");
  set("combat_exp", 4500000);
  set("daoxing", 4500000);
  
  set("no_nk_reward",1);

  set("per", 25);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("blade", 180);
  set_skill("fork", 180);
  set_skill("gouhunshu", 180);
  set_skill("tonsillit", 180);
  set_skill("sword", 180);
  set_skill("spear", 180);
  set_skill("ghost-steps", 180);
  set_skill("bawang-qiang", 180);
  set_skill("rake", 180);
  set_skill("stick", 180);
  set_skill("staff", 180);
  set_skill("bawang-qiang", 180);
map_skill("spear","bawang-qiang");
map_skill("parry","jinghun-zhang");
map_skill("dodge","ghost-steps");
map_skill("force","tonsillit");
map_skill("spells","gouhunshu");
  set("max_sen",1400);
  set("max_gee",1400);
  set("max_gin",1400);
  set("force",1400);
  set("max_force",1400);
  set("max_mana",1400);
  set("force_factor",200);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
 carry_object("/d/obj/weapon/spear/changqiang")->wield();
       call_out ("riding",1); 

}

void die ()
{
  object me = this_object();
  object where = environment (me);
  object bone = present ("bone 4",where);

  if (! bone)
  {
    bone = new ("/d/bwbj/obj/bone");
    bone->move(where);
  }

  message_vision ("\n$N倒了下去，只剩下一堆骨架。\n",me);  
  if (! present("qi bing 5",where) &&
      where->query("short")==HIW "月下小径" NOR)
  {
         object ob = new ("/d/bwbj/npc/qb"); 
    ob->move(where);
    message_vision ("\n突然，白骨重新站立了起来！骑兵又向你扑来！\n",me);   
  }
  destruct (me);  
}

void unconcious ()
{
  die();
}
void kill_ob(object who)
{
  int i;
  object* inv;

	inv = all_inventory(who);

	for(i=0; i<sizeof(inv); i++) 
	{
		if( inv[i]->query_unique() ) {
	
			message_vision("突然间，$n化一道白光飞去，无影无踪！\n",who,inv[i]);
			destruct(inv[i]);
		}
	}

	::kill_ob(who);
}

void riding ()
{
  command ("mount horse");command ("mount horse 2");command ("mount horse 3");command ("mount horse 4");
}

