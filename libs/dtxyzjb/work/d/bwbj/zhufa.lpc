void init ()
{
  add_action ("do_zha","zha");
}
int do_zha (string arg)
{
  object fazi,zhaob;
  object who = this_player();
/*
  if ( !arg || !(zhaob=present(arg, who)) )

  return notify_fail("你要弄些竹子来!\n");

        else if (arg != "bamboo") 
           return notify_fail("都跟你说了要竹子了。\n");  

 
  
   destruct(zhaob);
*/
  message_vision ("$N耐心的搓了根麻绳，开始扎木筏！\n",who);
 
  who->add("kee",-1000);
     
  if (who->query("combat_exp") < 10000000 ||
      random(5))
  {
    return 1;
  }

  if (present("fazi",this_object()))
    return 1;
  fazi = new (__DIR__"obj/fazi");
 
  fazi->move(this_object());
  message_vision ("$N好不容易扎好了一个竹筏，把它推到水里！！\n",who);
  return 1;
}
