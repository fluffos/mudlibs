
#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create()
{
        set_name(HIR "铁棒"NOR, ({ "tie bang", "stick" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 150000);
                set("material", "steel");
                set("long", "这是一根通体发红的竹棒。\n");
                set("wield_msg", "一道紫光闪过，$N手中已多了根$n。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_stick(10);
        setup();
}
