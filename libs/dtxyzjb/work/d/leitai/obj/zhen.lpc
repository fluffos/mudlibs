#include <weapon.h>

inherit THROWING;

void create()
{
        set_name(HIR"铁针"NOR, ({ "tie zhen","zhen" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",HIR"这是一些普通的绣花针。\n"NOR);
                set("unit", "些");
                set("base_unit", "枝");
                set("base_weight", 40);
                       set("value", 20000);
                set("base_value", 50);
        }
        set_amount(30);
        init_throwing(10);
        setup();
}

