#include <weapon.h>

inherit FORK;

void create()
{
        set_name("龙角叉", ({ "dragon fork", "cha","fork" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 5000);
                set("material", "iron");
                set("long", "一柄长长的龙角叉。\n");
                set("wield_msg", "$N抄起一柄$n，在胸前挥舞了一个大圈。\n");
        }
        init_fork(50);
        setup();
}


