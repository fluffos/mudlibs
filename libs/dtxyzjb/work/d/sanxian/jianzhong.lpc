inherit ROOM;
#include <room.h>
#include <ansi.h>
void jiang_jing(object where);
void finish_jing(object where);
void check_time(object where);
int do_hear();
void create ()
{
        set("short", CYN"剑冢"NOR);
        set("long", @LONG
，便是自碗里发出来的。碗里，果然是只烧得红红的鸡。四面的椅子上，都是空
这里是中山夫子祭剑的地方，听说刺客剑法就是在这里悟出来的！
LONG
  );
  set("exits",([
  "east" : "/d/sanxian/sleep",
      ]));  
   set("objects", ([
      
"/d/sanxian/npc/guiguzi" : 1,
"/d/sanxian/npc/zhangmen" : 1,
     ]) );  
        

        setup();
  call_other("/obj/board/jian_b", "???");
}
