void check_time(object where)
{

   mixed *local = localtime((time()-900000000)*60);
   int t = local[2] * 60 + local[1];
   int phase=((int)(t/120));
   if(phase==2&&(!query("jiangjing"))) jiang_jing(where);
if(phase==5&&query("jiangjing")) finish_jing(where);
   call_out("check_time",60,where);
}

void jiang_jing(object where)
{
message("channel:es",CYN+"◇"RED"三界散仙"CYN"◇"WHT"鬼谷子[Gui guzi]"CYN"：三界众仙速到剑冢领悟神机。\n"+NOR,users());
tell_object(where,"鬼谷子说道;众仙归位合开始领悟神机。\n");
tell_object(where,"一时仙云腾起，祥光呈照大厅。\n");
    set("jiangjing",1);
}
void finish_jing(object where)
{
  tell_object(where,"鬼谷子朗声道:弟子们辛苦了。\n");
   set("jiangjing",0);
   }
int do_hear()
{

   object me=this_player();

   if(me->is_busy())
      return notify_fail("你正忙着呢。\n");
  if(!query("jiangjing"))
     return notify_fail("三界散仙还没有开始领悟神机。\n");

 if((string)me->query("family/family_name")!="三界散仙")
      return notify_fail("非三界散仙大仙不得在此听经。\n");
   if(me->query("faith")>40000)
      return notify_fail("你已经有一定功底,不用再领悟了。\n");
       tell_object(me,"你听着听着似乎若有所悟。\n");
   me->start_busy(5);
if((int)me->query_skill("mysticism", 1) < 700)
{me->improve_skill("mysticism",random((int)(me->query("spi")+me->query("int"))/2));tell_object(me,"你觉得玄玄神机进步了！\n");}
else {   tell_object(me,"你的玄玄神机已经达到一定高度，只能自己钻研了。\n");}
if((int)me->query_skill("butian-force", 1) < 700)
{me->improve_skill("butian-force",random((int)(me->query("spi")+me->query("int"))/2));tell_object(me,"你觉得补天心法进步了！\n");}
else {   tell_object(me,"你的补天心法已经达到一定高度，只能自己钻研了。\n");}

   me->receive_damage("kee",20);
   me->receive_damage("sen",20);
  return 1;
}
