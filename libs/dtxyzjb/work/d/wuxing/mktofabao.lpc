//convert item to one's fabao 
//daofeng 2001.07.23

#include <ansi.h>
#include <weapon.h>
#include <armor.h>
#include <login.h>

inherit ROOM;

void get_name(string,object);
void get_unit(string,object);
int  do_sm();
int  do_dispose(string arg);
int check_player(object who);
void confirm_dispose(string arg, object ob, object fabao_ob);

void init()
{
	add_action("do_change_item_to_fabao", "zhu");
    add_action("do_drop", "drop");
            add_action("do_dispose","hui");
	seteuid(getuid());
}

void create ()
{
  set ("short","冶山");
        set ("long", @LONG

冶剑于山，淬剑于池。这里是欧冶子冶剑的地方。
LONG);
// 这里零零散散的对着一些废弃的装备，在这里可以把一些特殊的装备
//铸成自己的法宝（zhu），但是如果已经有了相同类型的装备，就不能
//铸了。你可以先注销（hui）掉原来的法宝，在来这里铸新的法宝。


	set("exits", 
	([ //sizeof() == 1 
//                "out" : __DIR__"muwu",
                "east" : __DIR__"centre",
	]));
        set("objects", 
        ([ //sizeof() == 1
//                 __DIR__"npc/vendor" : 1,
        ]));


	set("no_fight", 1);
	set("no_magic", 1);

      set("no_fight", 1);
	setup();
}

int do_change_item_to_fabao(string arg)
{
	object ob,me=this_player();
            mapping base;
	string fabao_num, fabao_id,fabao_name,ch;
	string *id_list, *list;
	int i,rev;
            if (check_player(me)!=1) return notify_fail("以你现在能力，还不能再多铸一件法宝。\n");
            if (!arg) return notify_fail("你要把什么物品铸成法宝？\n");
            if (!(ob=present(arg,me)) )return notify_fail("你身上没有这样东西。\n");
            if (!ob->query("newitem")) return notify_fail("你不能把这件物品铸成法宝。\n");
            ch=ob->query("type/kind");         
            ch="wuxing_fabao/"+ch;
            if (me->query(ch)) return notify_fail("你已经有了相同类型的法宝了。\n");
            if (ob->query("equipped")) return notify_fail("你必须不用物品时才能铸宝。\n");
            ob->set("oldname",ob->query("name"));
            ob->set("oldunit",ob->query("unit"));
             write("请给法宝取一个名字：");
           input_to( (: get_name :), ob);
            
        me->set_temp(ch,1);
	me->add("wuxing_fabao/num",  1);
            me->set(ch,1);
	me->save();
	
            
	return 1;
}


int  do_dispose(string arg)
{
   object ob = this_player();
   object fabao_ob;
  
   if( !arg || arg == "" )
	  return notify_fail("你要消除什么法宝？\n");

   if( !objectp(fabao_ob=present(arg, ob)) )
      return notify_fail("你身上没有这样东西啊。\n");
      
   if(!(fabao_ob->query("owner_id"))) 
      return notify_fail("那个不是法宝耶！\n");
      
   write("你确定要毁灭该法宝吗？(y/n)");
   input_to( (: confirm_dispose :), ob, fabao_ob); 
   return 1;
}

void confirm_dispose(string arg, object ob, object fabao_ob)
{
   string fabao_name,fabao_type,ch;

   if( arg == "y" || arg == "Y" )  {
               fabao_type=fabao_ob->query("type/kind");
               ob->add("wuxing_fabao/num",-1);
               ch="wuxing_fabao/"+fabao_type;
               ob->delete(ch);
	   fabao_name = fabao_ob->query("name");
//           destruct( fabao_ob );
             fabao_ob->delete("owner_id");
             fabao_ob->delete("no_give");
             fabao_ob->delete("no_get");
             fabao_ob->delete("no_drop");
             fabao_ob->delete("no_put");
             fabao_ob->delete("no_sell");
            if(fabao_ob->query("oldname"))
             fabao_ob->set("name",fabao_ob->query("oldname"));
            if(fabao_ob->query("oldunit"))
             fabao_ob->set("unit",fabao_ob->query("unit"));
           write("只听轰！的一声，"+fabao_name+"上的金光渐渐退去了。\n");
   }

   return;
}
int do_drop(string arg){
     "/d/city/droproom"->do_main(arg);
       return 1;
}
int check_legal_name(string name, int max_len)
{
        int i;
        string  *legalname;
        i = strlen(name);
    if( (strlen(name) < 2) || (strlen(name) > max_len ) ) {
        write( sprintf("对不起，法宝中文名字必须是 1 到 %d 个中文字。\n",
        max_len/2) );
                return 0;
    }
    while(i--)   {
        if( name[i]<=' ' )   {
               write("对不起，法宝中文字不能用控制字元。\n");
                return 0;
        }
        if( i%2==0 && !is_chinese(name[i..<0]) )  {
                write("对不起，请您用「中文」给法宝取名字。\n");
                return 0;
        }
   }
   return 1;
}
void get_name(string arg, object ob)
{
        string  arg_old;
        arg += "$NOR$";
        arg_old = arg;
        arg = replace_string(arg, "$BLK$", "");
        arg = replace_string(arg, "$RED$", "");
        arg = replace_string(arg, "$GRN$", "");
        arg = replace_string(arg, "$YEL$", "");
        arg = replace_string(arg, "$BLU$", "");
        arg = replace_string(arg, "$MAG$", "");
        arg = replace_string(arg, "$CYN$", "");
        arg = replace_string(arg, "$WHT$", "");
        arg = replace_string(arg, "$HIR$", "");
        arg = replace_string(arg, "$HIG$", "");
        arg = replace_string(arg, "$HIY$", "");
        arg = replace_string(arg, "$HIB$", "");
        arg = replace_string(arg, "$HIM$", "");
        arg = replace_string(arg, "$HIC$", "");
        arg = replace_string(arg, "$HIW$", "");
        arg = replace_string(arg, "$NOR$", "");
        if( !check_legal_name(arg, 12) )  {
            write("请设定中文名：(可加颜色)");
                input_to( (: get_name :), ob);
                return;
        }
        arg = arg_old;
        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
        arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
        ob->set("name", arg );
             write("法宝量词：");
                input_to( (: get_unit :), ob);
}
void get_unit(string arg, object ob)
{
       string pet_unit, pet_type;
    if( arg == "" )
       pet_unit = "";
        else if( !check_legal_name(arg, 2) )  {
           write("法宝量词：(Return for defult)");
           input_to( (: get_unit :), ob);
           return;
    }
   else
       pet_unit = arg;
        ob->set("unit", pet_unit);
            ob->set("owner_id",this_player()->query("id"));
          ob->set("no_give",1);
          ob->set("no_get",1);
          ob->set("no_drop",1);
          ob->set("no_put",1);
          ob->set("no_sell",1);
            ob->set_temp("befabao",1);
            ob->save();
            ob->setup();
        write(ob->query("name")+"上渐渐闪现出一层金光。\n"+"铸法宝成功。\n");
}

int check_player(object who)
{
   int i;
   if (!i=who->query("wuxing_fabao/num")) return 1;
   if (i*10>who->query("wuxing/level")) return 0;
   if (i*(i+1)*500000>who->query("daoxing")) return 0;
   return 1;
}
