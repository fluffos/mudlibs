
#include <ansi.h>
//inherit F_VENDOR;
inherit NPC;
void create()
{
       set_name(HIW"神农氏"NOR, ({"shennong shi","shi","" "shennong"}));
       set("long",
"神农氏经常去万劫谷采集药材，炼出了不少灵丹妙药。\n");
       set("gender", "男性");
        set("per", 40);
       set("age", 56);
       set("attitude", "friendly");
       set("shen_type", 1);
       set_skill("unarmed", 35);
	set_skill("dodge", 30);
	set_skill("parry", 35);
       set("vendor_goods", ([
                "force_400 potion" : "/d/wuxing/obj/forceping1",
                "force_800 potion" : "/d/wuxing/obj/forceping2",
                "force_1000 potion": "/d/wuxing/obj/forceping3",
                "force_2000 potion": "/d/wuxing/obj/forceping4",
                "force_mini potion" : "/d/wuxing/obj/forceping5",
                "force_mid potion" : "/d/wuxing/obj/forceping6",
                "force_full potion": "/d/wuxing/obj/forceping7",
                "mana_400 potion" : "/d/wuxing/obj/manaping1",
                "mana_800 potion" : "/d/wuxing/obj/manaping2",
                "mana_1000 potion": "/d/wuxing/obj/manaping3",
                "mana_2000 potion": "/d/wuxing/obj/manaping4",
                "mana_mini potion" : "/d/wuxing/obj/manaping5",
                "mana_mid potion" : "/d/wuxing/obj/manaping6",
                "mana_full potion": "/d/wuxing/obj/manaping7",
                "full potion": "/d/wuxing/obj/ping",
       ]) );
        setup();
        carry_object("/d/obj/cloth/choupao")->wear();

}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
//        add_action("do_vendor_list", "list");
}

