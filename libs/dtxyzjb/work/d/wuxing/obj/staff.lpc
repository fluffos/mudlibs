// staff.c

#include <weapon.h>
#include <ansi.h>
inherit STAFF;
#include "zhuangbei.h"
#define TYPE_NUM 7;
string *nametype=({"二字拐","卜字拐","上下拐","钩镰拐","鸳鸯拐","少林龙头杖","少林达摩杖"});
string *longtype=({
"在柄的两端各有一横拐，二横拐与柄垂直，因上下横拐构成\"二\"字形，故名。\n",
"短拐的一种。柄上端垂直一横拐，呈\"卜\"字形，故名。\n",
"短拐的一种。在拐柄的上下两端各有一突出的横柄，故名。\n",
"拐柄的两端各有一钩镰枪头。距拐柄两端各三分之一处，均有一突出之横柄。横柄方向相同。\n",
"拐柄中间有一弯曲。拐柄两端各有一突出之横柄，方向相反。\n",
"比一般杖稍长些。\n",
"全长二尺五寸，把长六寸六分。\n",
});
int *damagetype=({75,100,140,170,200,240,270});


void create()
{
	set_name( "杖", ({ "staff" }) );
       set("type/kind","staff");
       set("type/large","weapon");
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "一条沉重的铁杖。\n");
		set("value", 500);
		set("material", "steel");
              set("wield_msg","$N拿出一把$n，握在手中。\n");
              set("unwield_msg", "$N放下手中的$n。\n");
	}

	init_staff(20);
	setup();
}
void initobject (object me)
{
              int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
              if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}
