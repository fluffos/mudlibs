// manaping1.c 恢复法力的药水
#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "drink");
}

void create()
{
        set_name(HIB"蓝药瓶"NOR, ({"mana_400 potion", "potion", "fali ping"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
             set("base_unit","个");
        set("unit","些");
                set("long", "这是一瓶恢复法力的药水，能恢复400左右的法力。\n");
                set("value", 3000);
				set("drug_type", "良药");
        }
   set_amount(1);
        setup();
}

int do_eat(string arg)
{
        object me=this_player();
        if (!id(arg))
                return notify_fail("你要用什么？\n");
       if (me->query("mana") < me->query("max_mana") )
         me->add("mana",391+random(20));
       else if (me->query("mana") < 2*me->query("max_mana") )
         me->add("mana",191+random(20));
       message_vision(HIB"$N喝下一瓶药水。\n"NOR,me);
         add_amount(-1);
                return 1;
}

