#include <armor.h>
#include <ansi.h>
inherit CLOTH;
#include "zhuangbei.h"

void create()
{
  set_name("战袍", ({"cloth"}));
        set("type/kind","cloth");
        set("type/large","armor");

  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件战袍。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 600);
    set("armor_prop/armor", 100);
  }
  setup();
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),100);
}

