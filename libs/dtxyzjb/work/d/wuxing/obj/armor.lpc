// jinjia.c 金甲
#include <armor.h>
#include <ansi.h>
inherit ARMOR;
#include "zhuangbei.h"

void create()
{
        set_name("金环锁子甲", ({"armor"}));
        set("type/kind","armor");
        set("type/large","armor");
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
	    set("long", "一件金线织就的宝甲．\n");
                set("material", "steel");
                set("value", 10000);
                set("armor_prop/armor", 150);
        }
        setup();
//        call_out("disappear",30);
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),150);
}



