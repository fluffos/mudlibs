// mihoutao.c 猕猴桃

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void destroy();
void init();

void init()
{
  add_action("do_eat", "drink");
}

void create()
{
  set_name(MAG "神秘药瓶" NOR, ({"yao ping","yaoping","ping"}));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long", "一个紫色小药瓶，也不知里面装了什么。\n");
    set("value", 400000);
    set("drug_type", "补品");
  }
  
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  
  if (!id(arg))
    return notify_fail("你要喝什么？\n");
  
  me->set("food", (int)me->max_food_capacity());
  me->add_maximum_force(10);
  me->set("mana",0);
  me->set("force",0);
  me->add_maximum_mana(10);
  message_vision(HIY "$N揭开瓶盖，咬咬牙，一口喝了进去。 \n" NOR, me);
  message_vision(HIW "$N身上忽红忽蓝，功力又有所增进！ \n" NOR, me);
  
  destruct(this_object());
  return 1;
}

