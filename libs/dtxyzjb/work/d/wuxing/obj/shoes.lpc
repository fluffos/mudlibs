// shoe.c
#include <armor.h>
#include <ansi.h>
inherit BOOTS;
#include "zhuangbei.h"

void create()
{
        set_name("踏云靴", ({ "shoes" }) );
         set("type/kind","shoes");
        set("type/large","armor");
       set_weight(1700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("value", 10000);
                set("material", "cloth");
                set("armor_prop/armor", 30);
        }
        setup();
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),30);
}

