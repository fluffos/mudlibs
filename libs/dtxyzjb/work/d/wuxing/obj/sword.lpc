// changjian.c 长剑

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
#include "zhuangbei.h"
#define TYPE_NUM 8;
string *nametype=({"七星剑","子午鸳鸯剑","龙泉剑","逸龙剑","少林子母鸳鸯剑","龙凤双剑","雌雄剑","拂尘剑"});
string *longtype=({
"剑身近柄处饰有北斗七星文，故名。\n",
"剑长三尺，剑身为扁平状，下部宽一寸半，上部宽八寸，剑身两侧为向上倾斜的尖剑，浑体如锯条。\n",
"亦称\"龙渊剑\"。出自河南西平县。取当地龙泉水淬剑而得名。\n",
"剑身有龙形图案，因而得名。无剑穗。\n",
"少林双兵器之一。全长三尺，为历代少林僧徒习武防身之用。\n",
"双兵器之一。浙江龙泉出此剑，在两剑有脊的一面分别配有龙（为右手所使之剑）、凤（为左手所使之剑）图案。\n",
"古代双兵之剑。舞练技法与其他双剑同。但制此剑之材料甚是高级。雌剑为左手使，雄剑乃右手使。\n",
"古代异样双兵之一，为道家所使之兵械。由一把拂尘与一把单剑组成。\n",
});
int *damagetype=({75,100,130,160,190,220,250,270});

void create()
{
	set_name("剑", ({"sword"}));
            set("type/kind","sword");
            set("type/large","weapon");
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄长长的精钢剑，剑口锋利。\n");
		set("value", 500);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(25);
	setup();
}
void initobject(object me)
{
                 int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
                 if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}
                             
            
