#include <armor.h>
#include <ansi.h>
inherit HANDS;
#include "zhuangbei.h"
string *names = ({
  "铁手套",
  "铜手套",
});

string *ids = ({
  "tie shou tao",
  "tong shou tao",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({"hands"}));
        set("type/kind","hands");
        set("type/large","armor");
  set_weight(3000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "副");
   set("value", 200);
   set("material", "metal");
   set("armor_prop/armor", 20);
  }
  setup();
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),20);
}
