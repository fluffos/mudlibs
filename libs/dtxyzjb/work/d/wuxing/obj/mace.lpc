//mace.c

#include <weapon.h>
#include <ansi.h>
inherit MACE;
#include "zhuangbei.h"
#define TYPE_NUM 7;
string *nametype=({"八棱锏","平棱锏","凹面锏","四棱锏","浑圆锏","狼牙锏","少林方楞铜锏"});
string *longtype=({
"由一根八棱形铁杆制成，故得其名，长约四尺。\n"
"长四尺，锏把为圆柱形，尾短有一小孔，可作穿绳之用。锏把前有六边形铜护盘。锏身呈六棱形，尾部粗而丰。锏顶端粗为一寸。\n",
"锏长二尺五寸左右。锏把为圆柱形。锏身为方形，内中有槽，故得其名。\n",
"锏体呈四棱形状，故得其名。\n",
"锏身长为四尺，通体呈圆柱形，以铁制成。\n",
"锏身是一根前端小，后端粗得圆形木棒。其长为二尺。棒长装有四排铁钉，每排四至六刺，交错排列。棒之顶尾各有一刺。铁钉呈三角形。\n",
"少林兵器之一，全长三尺。\n",
});
int *damagetype=({75,100,140,170,200,240,270});

void create()
{
  set_name("锏", ({"mace"}));
  set("type/kind","mace");
  set("type/large","weapon");
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 18000);
    set("material", "steel");
    set("long", "这是一柄精钢铸成的虎尾鞭，据说是一对雌雄双鞭中的雄鞭。\n");
    set("wield_msg", "$N抽出了$n，喃喃道：锏儿，锏儿，再请你一回！\n");
    set("unwield_msg", "$N收起了$n，长吁了一口气道：宝锏果然又显雄风！\n");
  }
  
  init_mace(85);
  setup();
}
void initobject(object me)
{
               int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
               if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}

