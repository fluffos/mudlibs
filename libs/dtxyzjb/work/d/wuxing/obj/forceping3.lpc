// forceping1.c 恢复内力的药水
#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "drink");
}

void create()
{
        set_name(HIR"红药瓶"NOR, ({"force_1000 potion", "potion", "neili ping"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
             set("base_unit","个");
        set("unit","些");
                set("long", "这是一瓶恢复内力的药水，能恢复1000左右的内力。\n");
                set("value", 10000);
				set("drug_type", "良药");
        }
   set_amount(1);
        setup();
}

int do_eat(string arg)
{
        object me=this_player();
        if (!id(arg))
                return notify_fail("你要用什么？\n");
       if (me->query("force") < me->query("max_force") )
         me->add("force",951+random(100));
       else if (me->query("force") < 2*me->query("max_force") )
         me->add("force",451+random(100));
       message_vision(HIR"$N喝下一瓶药水。\n"NOR,me);
         add_amount(-1);
                return 1;
}

