// 用来update wuxing 的随机迷宫地图
//     by yog

#include <ansi.h>

inherit F_DBASE;
int update_each_map(string file);


void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "内存精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "五行随机迷宫地图更新系统已经启动。\n"); 
        set("name","wuxingmap");
        call_out("update_map",10);

}

int update_map()
{
      int i=1;
     object obj;
      int j;
      remove_call_out("update_map");
//      obj=find_object("/d/wuxing/obj/bojian.lpc");
      j=update_each_map("/d/wuxing/wanjiegu1.lpc");
      i=i*j;
//      j="/cmds/wiz/update.lpc"->main(obj,"/d/wuxing/wanjiegu1.lpc");
      j=update_each_map("/d/wuxing/wanjiegu2.lpc");
      i=i*j;
      j=update_each_map("/d/wuxing/wanjiegu3.lpc");
      i=i*j;
      j=update_each_map("/d/wuxing/wanjiegu4.lpc");
      i=i*j;
      if (i==0) {
        CHANNEL_D->do_channel( this_object(), "sys", "本次地图更新失败\n");
        call_out("update_map",10);
        return 0;
      } else {
        message("channel:chat",HIG"【"+HIR"柏鉴"+HIG"】"+HIW"万劫谷地图更新。\n"+NOR,users());
        call_out("update_map",1800);
        return 1;
      }
}
void stop()
{
      remove_call_out("update_map");
}

int update_each_map(string file)
{
   object obj;
   object *inv;
   string err;
   int i;
   if (obj=find_object(file)) {
     inv = all_inventory(obj);
     i = sizeof(inv);
     while (i--)
       if (userp(inv[i])) inv[i]->move(VOID_OB,1);
       else inv[i]=0;
   destruct(obj);
   }
   if (obj) return 0;
   err = catch(call_other(file,"???") );
   if (err) return 0;
   else return 1;
}
