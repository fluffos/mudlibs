inherit NPC;
#include <ansi.h>

string *list=({"yg-qiankun","yg-jianmang","yg-jianzhang","yg-zxzx",
                "yg-ba","yg-jldl","yg-xueshan","yg-shushan","yg-kunlun","yg-putuo",
"yg-pansi","yg-moon","yg-hell","yg-wusheng","yg-shaolin","yg-swordman","yg-wudidong",
        });
                        
int ask_mieyao();

void create()
{
  set_name("店小二", ({ "xiao er", "er" }));
  set("gender", "男性");
  set("age", 10000);
  set("attitude", "peaceful");
  set("str",100);
  set("per",100);
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 3000);
  set("mana", 3000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 300);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 300);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
   (: cast_spell, "bighammer" :),
  }) );
  set("inquiry", ([
          "消息": (: ask_mieyao :),
          ]) );

  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}


int ask_mieyao()
{
        object me = this_player();
    object guai;
    int level,time,money,maxlevel;
    string kind,where,msg;
    
         // if ( !me->query("yc1") )   
          {
                     // tell_object(me,name()+"对你说道：你的没有见过霸王别姬的气势，去杀强盗有些危险啊! \n"); 
                      return 1; 
          }
 //if ( me->query("level")*400000 < me->query("combat_exp") ) 
  { tell_object(me,name()+"对你说道：你的等级不足 "+chinese_number(me->query("combat_exp")/400000+1)+" ，你先出去转转吧。\n");return 1;} 
        money = random(sizeof(list))*50000;
   
   // if ( me->query("level") < 1 )  
        {
                tell_object(me,name()+"对你说道：你的等级不足 400 ，去杀强盗有些危险啊! \n");
                return 1;
        }
        time= (int)me->query("baotu/start");
    
    if( (time<=time() && time()<time+180 || present ("zhi tiao", me)) && me->query("id")!="ken")
    {
                tell_object(me,name()+"笑着对你说着:这位"+ RANK_D->query_respect(me) +",最近没有什么强盗的消息。\n"); 
                return 1;
        }
                
        if ( me->query("c_balance") < money )
        {
                tell_object(me,name()+"笑着对你说着:这位"+ RANK_D->query_respect(me) +",您的卡上的钱好像不够。\n"); 
                return 1;
        }
             
        //确定任务等级		

        maxlevel = random(3+ (me->query("level")-400)/40 )+1;
                if(me->query("level")>500) maxlevel=maxlevel+random( (me->query("level")-500)/10 );
                if(me->query("level")>600) maxlevel=maxlevel+random( (me->query("level")-600)/8 );
                if(maxlevel<1) maxlevel=1;
				if(maxlevel>18) maxlevel=18;
level = random(3)+1;


        //确定任务种类
        kind = "杀";
        
              me->delete("baotu/done"); 
              me->delete("baotumaxlevel");
             me->set("baotumaxlevel",maxlevel); 
        me->set("baotu/no_die",1);
        me->set("baotu/level",level);
        me->set("baotu/kind",kind);
        guai = new("/d/baotu/yaoguai/"+list[random(sizeof(list))]);
        guai->set("baotu_level",1);

		//guai->set_baotulevel(1);      
		
        where=guai->invocation(me, level);
        guai->set("host",me->query("id"));
        tell_object(me,HIY"店小二说道："+where+"附近打劫呢。\n"NOR);
        me->set("baotu/guai",guai);
        me->set("baotu/where",where);
        me->set("baotu/start",time());
        me->add("c_balance",-money);
        msg = me->name()+"接到一个难度"+chinese_number(maxlevel)+"的"+kind+"强盗任务。\n";
		 tell_object(me,HIY+msg+NOR);
       // MONITOR_D->report_system_msg (msg);
	    message("channel:wiz",HIG"【"HIW"强盗任务"HIG"】："+msg+"\n"NOR,users());
        return 1;
}        


void die()
{
  if (environment())
    message("sound", "\n我是不死的！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

void unconcious()
{
  die ();
}

