string setname()
{
int i;
string name,id;

//if(query("baotu_level")<3 || (random(2)==1&& query("baotu_level")<9) )
 if(random(5)>1)
 {
	    if(random(3)==1)
	 {
				i=(random(sizeof(wnames)/2))*2;
				set("gender","女性");
				name=wnames[i];
		id=wnames[i+1];
	 }
	 else
	 {
		i=(random(sizeof(names)/2))*2;
						set("gender","男性");
						name=names[i];
		id=names[i+1];
	 }
		
		set_name(name, ({ id,"qiang dao"}) );
		
 }
 else
 {
		i=(random(sizeof(xnnames)/2))*2;
		set("gender","男性");
		name=xnnames[i];
		id=xnnames[i+1];
	   	set_name(name, ({ id,"xiong nu"}) );
		set("is_xiongnu",1);
		set("lingwu/gumu_jiuyin","done");
		set("lingwu/hyd_huohun","done");
		set("family/family_name","精武门");
 }
 //message("channel:wiz",HIG"【"HIW"强盗任务"HIG"】：setname query_baotulevel"+query_baotulevel()+NOR+"_\n",users());
 return name;
}

void create()
{        
object horse;
 //message("channel:wiz",HIG"【"HIW"强盗任务"HIG"】：create query baotu_level"+query("baotu_level")+NOR+"____\n",users());
        setname();
        set("age", 44);
        //set("gender", "男性");
        set("attitude", "heroism");

		set("per", 1+random(40));

        set("int", 30+random(20));
        set("spi", 20+random(30));
        set("cps", 30-random(20));
        set("kar", 40+random(20));
    
    	if(query("is_xiongnu")==1)          
		{
			set("title",HBBLU"匈奴"NOR);
		    set("str", 100+random(50));
            set("cor", 50+random(10));
	        set("con", 40+random(20));
		    set("cps", random(10));  
			set("family/family_name","精武门");
		}
		else
		{
		    set("title",HBBLU"强盗"NOR);
			set("str", 50+random(50));
            set("cor", 40+random(20));
	        set("con", 30+random(20));   
	
		}
        
        set("max_gin", 1000);
        set("food", 10000);
        set("water", 10000);
        set_weight(30000);
        set("no_steal",1);
        set("chat_chance", 5);
        set("chat_msg", ({
                (: random_move :)
        }) );
        set("inquiry", ([ 
             "消息": (: ask_xiaoxi :), 
             "师门": (: ask_shimen :), 
           ]) ); 
        set("new_time",time());
        setup();
		
	
}

