int random_place(object me, string* dirs)
{
        int  i, j, k;
        object  newob;
        mixed*  file, exit;

        if( !sizeof(dirs) )  return 0;

        i = random(sizeof(dirs));    // pick up one directory

        file = get_dir( dirs[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             return 0;

        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirs[i]+"/"+file[j][0]);
             if (newob) {  
               if(newob->query("no_fight") ||
                       newob->query("no_magic") ||
                       newob->query("no_mieyao") ||
                       !(exit=newob->query("exits")) ||
                       sizeof(exit)<1 ||
                       !newob->query("outdoors") )
                   continue;

               if(me->move(newob)) {
				   object horse;
			if(query("is_xiongnu")==1)     
			{
				 me->set("family/family_name","精武门");
				 message_vision("$N呼啸一声，远处跑来一匹好马。\n",environment(me));
				 horse=new("/d/kaifeng/npc/thorse.lpc");
		         horse->move(environment());
				 me->command("mount horse");     
		
			    if(random(16)!=7&&query("baotu_level")<9)
				{
					me->map_skill("force", "jiuyin-force");		
					me->command("exert jiuyin");
				}
 			    else
				{
					me->map_skill("force", "huomoforce");		 
 				    me->map_skill("spells", "pingtian-dafa");	
					me->command("exert huohun");
				}								 
		     }
                   message_vision("$N走了过来。\n",me);
                   return 1;
               }
             }
           }
        }

        return 0;
}

string invocation(object me, int level)
{
        object guai,env;        
        string *dirs, where;
		//setname();
        //message("channel:wiz",HIG"【"HIW"强盗任务"HIG"】：invocation query baotu_level"+query("baotu_level")+NOR+"_\n",users());
        dirs=dirs1;
        guai=this_object();
        copy_status(me, level);
        
        set("owner", me);
        set("baotu_guai",me);
        if ( query("baotu_level") > 3 )
        {
                set("title",HBBLU"强盗队长"NOR);
				 if (query("is_xiongnu")==1 )
		        {
			        set("title",HBBLU"匈奴散兵"NOR);
		        }
                set("die",random(3)+3);
        }
        if ( query("baotu_level") > 6 )
        {
                set("title",HBBLU"强盗头领"NOR);
				 if (query("is_xiongnu")==1 )
		        {
			        set("title",HBBLU"匈奴巡骑"NOR);
		        }
                set("die",random(6)+6);
        }
        if ( query("baotu_level") > 9 )
        {

                set("die",random(9)+9);
				 if (query("is_xiongnu")==1 )
		        {
			        set("title",HBBLU"匈奴骁骑"NOR);
		        }
				else
				{
	                set("title",HBBLU"强盗头目"NOR);
				}
        }
		if ( query("baotu_level") > 12 && query("is_xiongnu")==1)
        {
                set("title",HBBLU"匈奴旋风骑"NOR);
                set("die",random(9)+9);
				if ( query("baotu_level") > 17 )
                {
                    set("title",HBBLU"匈奴狂风骑"NOR);
                    set("die",random(9)+12);
					apply_condition("drunk",200+random(100));
                 }
        }


        set("kind",me->query("baotu/kind"));
        set("level",level);
        set("dienumber",query("die"));

        
        if(!random_place(guai, dirs))  return "没妖怪。";
        
        env=environment(guai);
        where=guai->query("name");
          
        if(env)
        where += "在"+"/d/baotu/yaoguai/miscd"->find_place(env);
        return where;
        
        
}

void copy_status(object me, int level)
{
        mapping me_skill;
        int *skill_value, max_value, i;
        
        me_skill = me->query_skills();
        i=sizeof(me_skill);
        if(i>0) {
                skill_value=values(me_skill);
                max_value=skill_value[0];
                while(i--) { // 找出玩家skill最大值
                    if(skill_value[i]>max_value)
                        max_value=skill_value[i];
                }
          } else max_value=1;
                 
          set_skills(max_value, level);
          
          set_hp_status(me,level);
            
}         
          
void set_skills(int max_value, int level)
{
        object guai=this_object();       
        int guai_value;
        
        if (level==1) guai_value = max_value+max_value/4;
        else if (level==2) guai_value = max_value+max_value/2;
        else guai_value = max_value+max_value/1;
        
        set_skill("unarmed", guai_value+random(200));
        set_skill("dodge", guai_value+random(200));
        set_skill("parry", guai_value+random(200));
        set_skill("force", guai_value+random(200));
        set_skill("spells", guai_value+20+random(200));
		if(query("is_xiongnu")==1)
		{
			set_skill("jiuyin-force", guai_value+20+random(200));
			set_skill("huomoforce", 400+random(300));
			set_skill("pingtian-dafa", 400+random(300));
		}
		// message("channel:wiz",HIG"【"HIW"强盗任务"HIG"】：set_skills query baotu_level"+query("baotu_level")+NOR+"_\n",users());

}       


void set_hp_status(object me, int level)
{       int max_kee,max_sen,maximum_force,skill_force,maximum_mana,exp,daoxing;
        max_kee = me->query("max_kee");
        max_sen = me->query("max_sen");
        skill_force = query_skill("force");
        maximum_mana = me->query("maximum_mana");
        maximum_force = me->query("maximum_force");
        exp = me->query("combat_exp");
        daoxing = me->query("daoxing");
        
        set("max_force", skill_force*20);
        set("max_mana", skill_force*20);
        set("force", maximum_force);
        set("force_factor", skill_force/6);
        set("mana_factor", (int)query_skill("spells",1)/3);
        
        if (level==1)
           {
                set("max_kee", max_kee*5);
                set("eff_kee", max_kee*5);
                set("max_sen", max_sen*5);
                set("eff_sen", max_sen*5);
                set("kee", max_kee*4);
                set("sen", max_sen*4);
                set("max_mana", maximum_mana*3/2);
                set("mana",maximum_mana*3);
                set("max_force", maximum_force*3/2);
                set("force",maximum_force*3);
                set("combat_exp", exp+exp/4+random(exp/3));				
                set("daoxing", daoxing+daoxing*1+random(daoxing*1));
                set_temp("apply/armor", 350);
                set_temp("apply/damage", 120);
           }
           
        else if (level==2)
           {
                set("max_kee", max_kee*10);
                set("eff_kee", max_kee*10);
                set("max_sen", max_sen*10);
                set("eff_sen", max_sen*10);
                set("kee", max_kee*4);
                set("sen", max_sen*4);
                set("max_mana", maximum_mana*2);
                set("mana",maximum_mana*4);
                set("max_force", maximum_force*2);
                set("force",maximum_force*4);
                set("combat_exp", exp+exp/3+random(exp/2));
                set("daoxing", daoxing+daoxing/2+random(daoxing/2));
                set_temp("apply/armor",400);
                set_temp("apply/damage", 160);
           }   
           
           else
           {
                set("max_kee", max_kee*15);
                set("eff_kee", max_kee*15);
                set("max_sen", max_sen*15);
                set("eff_sen", max_sen*15);
                set("kee", max_kee*5);
                set("sen", max_sen*5);
                set("max_mana", maximum_mana*5/2);
                set("mana",maximum_mana*5);
                set("max_force", maximum_force*5/2);
                set("force",maximum_force*5);
                set("combat_exp", exp+exp/2+random(exp));
                set("daoxing", daoxing+daoxing*1+random(daoxing*1));
                set_temp("apply/armor", 450);
                set_temp("apply/damage", 200);
           } 
		   
		   if(query("is_xiongnu")==1)  
			{
			   set("max_kee", 50000+max_kee*25);
  			   set("max_sen", 50000+max_sen*5);
			   set("eff_kee", 50000+max_kee*25);
  			   set("eff_sen", 50000+max_sen*5);
			   set("kee", 50000+max_kee*25);
  			   set("sen", 50000+max_sen*5);
			   set("bellicosity", 10000);
			   set("daoxing", daoxing-random(daoxing)/3);
			}
}

int accept_fight(object ob)
{       
        object me=this_object();
        if (ob != owner())
        {
                message_vision(CYN"$N说道：快走开，要不我吃了你。\n"NOR,me);
                return 0;
        }
}  


void heart_beat()
{  object guai = this_object();

   ::heart_beat();
   
   if ( !is_fighting()
        && query("eff_kee") >= query("max_kee") / 2 
        && !query_skill("tonsillit",1)
        && !query_skill("shushan-force",1)
        && query("kind") != "降" 
        && query("eff_kee") <  query("max_kee") )
	{	 
     command("exert heal");
    
	}
      
   if (query("kee") < query("eff_kee")-10 && query("kind") != "降")
         command("exert recover");
   if (query("sen") < query("eff_sen")-10) 
     command("exert refresh");
   if (query("force") < query("max_force"))
     command("cast transfer");
   if (!owner() || owner()->query("baotu/done") )
   destruct(guai);
}       


void die()
{       
        object ob = this_object();
        object me = ob -> query("owner");
     
        if ( query("die") <= 0 )
        {
                if (me->query("baotu/guai") == ob &&  me->query("baotu/kind") == "杀"  && query("kind") == "杀" && (ob->query_temp("last_opponent")==me || ob->query_temp("last_damage_from")==me) )
                {
                        me->delete("baotu/no_die");
                        me->set("baotu/done",1);						
                        me->add_temp("baotu/gongde",100*query("baotu_level")+random(20)); 
						if(ob->query("is_xiongnu")==1)    me->add_temp("baotu/gongde",100*query("baotu_level")+random(100)); 
						//tell_object(me,ob->name()+"一溜烟的跑了\n"); 
                    rondom_baotu(me);
                }
                else 
                { 
                        me->delete("baotu/no_die");
                        me->set("baotu/done",1);
                        //tell_object(me,ob->name()+"一溜烟的跑了\n"); 
                }
                ::die();
				//destruct(this_object());
        }
        else
        {
                if (environment())
        message("sound", ob->name()+"大吼：小的们给我上！\n", environment());
        set("eff_kee", query("max_kee"));
                set("eff_sen", query("max_sen"));
                set("kee", query("max_kee"));
                set("sen", query("max_sen"));
                set("force", query("maximum_force")*2);
                set("mana", query("maximum_mana")*2);
                add("die", -1);
                add("recall",1);
                ::kill_ob(me);
        call_npc();
        }
}

void kill_ob (object ob)
{
        object me = this_object();  
        if (me->query("level")>1)
        me->set_leader(ob);
        if ( me->query("baotu_level") > 3 )
                call_npc();
        ::kill_ob(ob);
}           

void rondom_baotu(object me)
{
        object map;
        int i = random(30);
        if ( i == 100 )
        {
                map = new("d/baotu/obj/map");
                map->set("level",query("baotu_level"));
                map->move(me);
                tell_object(me,"你意外的得到了一张藏宝图。\n");
        }
       else if (( random(me->query("spi"))>20 || random(me->query("cps"))>15 || random(me->query("cor"))>15  )) //&&(random(me->query_temp("baotu/gongde")/100)<400)
        {
                 if ( query("baotu_level") >= me->query("baotumaxlevel") )
			     {
				   if ( query("baotu_level") < 10 ) {return;}
			       i = random(10);
			       if ( i < 3 )
			       {
			              map = new("/d/obj/drug/renshen-guo");
			        }
			       else 
				      {
		                   map = new("/u/ken/obj/qiannianzui"); 
				      }
		            map->move(me);
			        message("channel:rumor",HIY"【为民除害】店小二(xiao er)："+me->name()+"浴血奋战杀死强盗头目，特奖励 "+map->name()+" 一个。\n"NOR,users());
                 return;
                }
        
                map = new("/d/baotu/obj/page");
                map->set("level",query("baotu_level"));
                map->move(me);
                tell_object(me,"你意外的得到了一张纸条。\n");
        }
}
void call_npc()
{
    object me = query("owner");
    int level,i,j;
    object guai;
    
    //确定任务等级
             level = random(3)+1; 
        
        if ( query("call/no") )
        {
                if ( query("call/guai1") ) 
                {
                        query("call/guai1")->move(environment(this_object()));
                        query("call/guai1")->kill_ob(me);
                }
                if ( query("call/guai2") ) 
                {
                        query("call/guai2")->move(environment(this_object()));
                        query("call/guai2")->kill_ob(me);
                }
                if ( query("call/guai3") )
                {
                        query("call/guai3")->move(environment(this_object()));
                        query("call/guai3")->kill_ob(me);
                }
                return;
        }
        
        if ( query("recall") >= query("dienumber") )
        return;
        j = random(query("dienumber"))+1;
		if(j>3) j=3+j/4;
        
        for ( i = 1 ; i <= j ; i++  )
        {
                guai = new("/d/baotu/yaoguai/npc/"+list[random(sizeof(list))]+".lpc");
                guai->invocation(me, this_object() , level);
                set("call/guai"+i,guai);
                guai->set("call","guai"+i);
                guai->move(environment(this_object()));
                guai->kill_ob(me);
                add("call/no",1);
                add("recall",1);
        }
}

int heal_up()
{
  if( environment() && time()-query("new_time")>600&&!is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}


void leave()
{
    //object me=query("pre_killer");
    tell_room(environment(),query("name")+"一溜烟的跑了！\n");
    destruct(this_object());
}