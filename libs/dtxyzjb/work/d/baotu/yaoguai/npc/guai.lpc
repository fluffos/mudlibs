void setname()
{
int i;
string name,id;
i=(random(sizeof(names)/2))*2;
name=names[i];
id=names[i+1];
set_name(name, ({ id,"lou luo"}) );
}

void create()
{        
        setname();
        set("age", 24);
        set("gender", "男性");
        set("attitude", "heroism");
        set("title",HBBLU"喽罗"NOR);
        set("per", 30+random(30));
        set("str", 30+random(30));
        set("cor", 30+random(30));
        set("con", 10+random(50));
        set("int", 10+random(20));
        set("spi", 10+random(30));
        set("cps", 30-random(30));
        set("kar", 30+random(30));
        set("max_gin", 1000);
        set("food", 10000);
        set("water", 10000);
        set_weight(30000);
        set("no_steal",1);
        set("chat_chance", 5);
        set("chat_msg", ({
                (: random_move :)
        }) );
        set("new_time",time());
        setup();
}

void invocation(object me, object ob, int level)
{
        object guai,env;        
        guai=this_object();
        copy_status(me, level);
        set("owner", me);
        set("king",ob);
        set("level",level);
        set("baotu_guai",me);
        set("kind",me->query("baotu/kind"));
}

void copy_status(object me, int level)
{
        mapping me_skill;
        int *skill_value, max_value, i;
        
        me_skill = me->query_skills();
        i=sizeof(me_skill);
        if(i>0) {
                skill_value=values(me_skill);
                max_value=skill_value[0];
                while(i--) { // 找出玩家skill最大值
                    if(skill_value[i]>max_value)
                        max_value=skill_value[i];
                }
          } else max_value=1;
                 
          set_skills(max_value, level);
          
          set_hp_status(me,level);
            
}         
          
void set_skills(int max_value, int level)
{
        object guai=this_object();       
        int guai_value;
        
        if (level==1) guai_value = max_value+max_value/4;
        else if (level==2) guai_value = max_value+max_value/2;
        else guai_value = max_value+max_value/1;
        
        set_skill("unarmed", guai_value+random(200));
        set_skill("dodge", guai_value+random(200));
        set_skill("parry", guai_value+random(200));
        set_skill("force", guai_value+random(200));
        set_skill("spells", guai_value+20+random(200));
}       


void set_hp_status(object me, int level)
{       int max_kee,max_sen,maximum_force,skill_force,maximum_mana,exp,daoxing;
        max_kee = me->query("max_kee");
        max_sen = me->query("max_sen");
        skill_force = query_skill("force");
        maximum_mana = me->query("maximum_mana");
        maximum_force = me->query("maximum_force");
        exp = me->query("combat_exp");
        daoxing = me->query("daoxing");
        
        set("max_force", skill_force*20);
        set("max_mana", skill_force*20);
        set("force", maximum_force);
        set("force_factor", skill_force/6);
        set("mana_factor", (int)query_skill("spells",1)/3);
        
        if (level==1)
           {
                set("max_kee", max_kee*5);
                set("eff_kee", max_kee*5);
                set("max_sen", max_sen*5);
                set("eff_sen", max_sen*5);
                set("kee", max_kee*4);
                set("sen", max_sen*4);
                set("max_mana", maximum_mana*3/2);
                set("mana",maximum_mana*3);
                set("max_force", maximum_force*3/2);
                set("force",maximum_force*3);
                set("combat_exp", exp+exp/4+random(exp/3));
                set("daoxing", daoxing+daoxing*1+random(daoxing*1));
                set_temp("apply/armor", 350);
                set_temp("apply/damage", 120);
           }
        else if (level==2)
           {
                set("max_kee", max_kee*10);
                set("eff_kee", max_kee*10);
                set("max_sen", max_sen*10);
                set("eff_sen", max_sen*10);
                set("kee", max_kee*4);
                set("sen", max_sen*4);
                set("max_mana", maximum_mana*2);
                set("mana",maximum_mana*4);
                set("max_force", maximum_force*2);
                set("force",maximum_force*4);
                set("combat_exp", exp+exp/3+random(exp/2));
                set("daoxing", daoxing+daoxing/2+random(daoxing/2));
                set_temp("apply/armor",400);
                set_temp("apply/damage", 160);
           }   
           
           else
           {
                set("max_kee", max_kee*15);
                set("eff_kee", max_kee*15);
                set("max_sen", max_sen*15);
                set("eff_sen", max_sen*15);
                set("kee", max_kee*5);
                set("sen", max_sen*5);
                set("max_mana", maximum_mana*5/2);
                set("mana",maximum_mana*5);
                set("max_force", maximum_force*5/2);
                set("force",maximum_force*5);
                set("combat_exp", exp+exp/2+random(exp));
                set("daoxing", daoxing+daoxing*1+random(daoxing*1));
                set_temp("apply/armor", 450);
                set_temp("apply/damage", 200);
           }   
}

int accept_fight(object ob)
{       
        object me=this_object();
        if (ob != owner())
        {
                message_vision(CYN"$N说道：快走开，要不我吃了你。\n"NOR,me);
                return 0;
        }
}  


void heart_beat()
{  object guai = this_object();
   ::heart_beat();
   
   if ( !is_fighting()
        && query("eff_kee") >= query("max_kee") / 2 
        && !query_skill("tonsillit",1)
        && !query_skill("shushan-force",1)
        && query("kind") != "降" 
        && query("eff_kee") <  query("max_kee") )
     command("exert heal");
      
   if (query("kee") < query("eff_kee")-10 && query("kind") != "降")
         command("exert recover");
   if (query("sen") < query("eff_sen")-10) 
     command("exert refresh");
   if (query("force") < query("max_force"))
     command("cast transfer");
   if (!owner() || owner()->query("baotu/done") )
   destruct(guai);
}       

void die()
{       
        object ob = this_object();
        object me = ob -> query("owner");
        object who = ob -> query("king");
     
                if ( me->query("baotu/kind") == "杀"  && query("kind") == "杀" && (ob->query_temp("last_opponent")==me || ob->query_temp("last_damage_from")==me) )
                {
                        me->add_temp("baotu/gongde",20*query("level")+random(10));
                        who->add("die",-1);
                        who->delete("call/"+query("call"));
			who->add("call/no",-1);
			tell_object(me,ob->name()+"一溜烟的跑了\n"); 
                //::die();
				destruct(ob);
                }
                else 
                { 
                        tell_object(me,ob->name()+"一溜烟的跑了\n"); 
                        who->add("die",1);
                        who->delete("call/"+query("call"));
                        who->add("call/no",-1);
                        destruct(ob);
                }
}

void kill_ob (object ob)
{
        object me = this_object();  
        if (me->query("level")>1)
        me->set_leader(ob);
        ::kill_ob(ob);
}
           

void unconcious()
{
  die ();
}

int heal_up()
{
  if( environment() && time()-query("new_time")>600&&!is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}


void leave()
{
    //object me=query("pre_killer");
    tell_room(environment(),query("name")+"一溜烟的跑了！\n");
    destruct(this_object());
}