inherit ROOM;
#include <ansi.h>

void create()
{
set("short", "官道");
set("long", @LONG
    

　　一条宽阔的大道，贯穿南北，直同边关。

LONG );


set("exits", ([
//   "north"   : __DIR__"guandao2",
  "northeast"   : "/d/shengdoushi/12gong/toby1",
"west"   : "/d/kaifeng/tieta",
#if VRM_0501_SUPPORT
"south": VRM_DIR"VRM_0501/entry",
#endif 
]));


set("outdoors", 1);

setup();
}

int valid_leave(object me, string dir)
{
int i;
object* inv;
int exp, dx, xz;
exp = me->query("combat_exp");
dx = me->query("daoxing");
xz = 40000000;
inv = all_inventory(this_player());
for(i=0; i<sizeof(inv); i++)
        if ( dir == "south"&&userp(inv[i]))
        {
                         message_vision(HIM"一股强大的力量阻止了你。\n"NOR,this_player());
                         me->start_busy(3);
                         return notify_fail("");
         }
          if ( dir == "south"&&exp > xz)
                      {
                   me->start_busy(3);
           return notify_fail(HIW"  你的武学太高了，不适合进入"HIM" 蛇洞 "HIW"！\n"NOR);
           return notify_fail("");
          }
        
        if ( dir == "south"&&dx > xz)
                      {
                   me->start_busy(3);
           return notify_fail(HIW"  你的道行太高了，不适合进入"HIM" 蛇洞 "HIW"！\n"NOR);
           return notify_fail("");
          }
           
             return ::valid_leave(me, dir);
          
}
