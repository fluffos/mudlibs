#include <ansi.h>
inherit "/d/snowtu/npc/super_npc";

object offensive_target(object me);

void create()
{
object ob;
set_name("鬼王", ({ "gui wang", "gui" }) );
set("gender", "男性");
set("age", 1500);
set("long","这是古战场最老，也是最凶狠的一个鬼，被称为鬼王 ！\n");
set("str", 48);
set("cor", 52);
set("cps", 22);
set("max_kee", 5000);
set("max_gin", 5000);
set("max_sen", 5000);
set("force",4500);
set("max_force",4500);
set("mana",4500);
set("max_mana",4500);
set("force_factor",50);

set_skill("unarmed",350);
set_skill("jinghun-zhang",350);
map_skill("unarmed","jinghun-zhang");

set_skill("force",350);
set_skill("tonsillit",350);
map_skill("force","tonsillit");

set_skill("spells",350);
set_skill("gouhunshu",350);
map_skill("spells","gouhunshu");

set_skill("stick",350);
set_skill("kusang-bang",350);
map_skill("stick","kusang-bang");
set_skill("parry",350);
map_skill("parry","kusang-bang");

set_skill("dodge",350);
set_skill("ghost-steps",350);
map_skill("dodge","ghost-steps");

set_skill("whip",350);
set_skill("hellfire-whip",350);
map_skill("whip","hellfire-whip");

create_family("阎罗地府",2,MAG"鬼兵"NOR HIR"幽冥"NOR);
set("nickname",BLINK RED"六畜无道"NOR);
set("莲花",1); //这里是为了防止summon,smash类的BT法术或pfm加的限制，希望后面的wiz在做此类的pfm等时加上此限制

set("combat_exp", 8000000+random(16000000));
set("daoxing", 8000000+random(16000000));

set_temp("perf_quick/stick",1); 
set_temp("perf_quick/msg",HIR"$N"HIR"微一凝神，运起反五行摄气诀，头上冒出一股青气，脸部现出一个鬼形。。。\n");
set_temp("perf_quick/damage",800); 
setup();
ob = new("/d/city/npc/obj/stick");
ob->set_name(HIG"辟毒珠"NOR,({"pi du zhu","stick"}));
ob->set("unit",HIG"颗"NOR);
ob->move(this_object());
command("wield all");
add_temp("apply/armor",500);
add_temp("apply/damage",200);
add_temp("apply/dodge",100);
add_temp("apply/parry",100);
add_temp("apply/attack",100);
if ( random(2) )
    carry_object("/d/snowtu/obj/attack_yao2");
if ( !random(10) )
    carry_object("/d/snowtu/obj/dodge_yao");
}

void die()
{
int i;
object me,gold;

me = query_temp("last_damage_from");

if ( me && objectp(me) && present(me,environment()) )
        {
        gold = new("/obj/money/jinbi");
        if ( me->query("balance")/10000+me->query("c_balance")/10000 >50000 )
                  gold->set_amount(1);
        else    gold->set_amount(1+random(5));
        if ( !gold->move(me) )
                tell_object(me,YEL"你负重满了，没有得到奖励！\n"NOR);
        else    message("channel:rumor",RED+"【谣言】某人："+me->query("name")+"从鬼王处抢得"+chinese_number(gold->query_amount())+"枚金币！\n"+NOR,users());
        }
::die();
}

void init()
{
//add_action("do_none","",1);
add_action("do_kill","kill");
}

int do_none()
{
object me = this_player();
string verb = query_verb();
string *no_cmds = ({
                        "ji","apply","wear","remove","cast","steal","fight",
                });
if ( member_array(verb,no_cmds)!=-1 && this_object()->is_fighting(me) )
        {
        say(CYN+name()+CYN"说道："+me->name()+CYN"不要搞破坏！\n"NOR);
        return 1;
        }
return 0;
}

int do_kill(string arg)
{
if ( arg && id(arg) )
  set_temp("is_killed",time());
return 0;
}

int heal_up()
{
object target,weapon,ob = this_object();
weapon = query_temp("weapon");
if ( !weapon || !objectp(weapon) )
        {
        weapon = new("/d/city/npc/obj/stick");
        weapon->set_name(HIG"辟毒珠"NOR,({"pi du zhu","stick"}));
        weapon->set("unit",HIG"颗"NOR);
        weapon->move(this_object());
        command("wield all");
        }

if ( ob->is_fighting() )
        {
        target = offensive_target(ob);
        if ( !target )
                {
                if ( query_temp("last_damage_from") )
                        delete_temp("last_damage_from");
                ob->remove_all_enemy();
                return ::heal_up()+1;
                }
        else if ( !living(target) || !present(target,environment()) )
                {
                if ( query_temp("last_damage_from") )
                        delete_temp("last_damage_from");
                ob->remove_all_enemy();
                target->remove_killer(ob);
                return ::heal_up()+1;
                }                               
        }
return ::heal_up()+1;
}

varargs int receive_damage(string type, int damage, object who)
{
if ( time()<query_temp("is_killed")+2 )
    damage/=10;
if ( damage>0 && damage<10 ) 
        damage = 10;
if ( damage>600 ) 
        damage = 600;
return ::receive_damage(type,damage,who);
}

varargs int receive_wound(string type, int damage, object who)
{
damage = 0;
return ::receive_wound(type,damage,who);
}

object offensive_target(object who)
{
int i;
object *enemy;
if ( !who ) return 0;
enemy = who->query_enemy();
if( !enemy || !arrayp(enemy) ) return 0;
i = sizeof(enemy);
if( i > 0 ) return enemy[random(i)];
else return 0;
}

void remove_all_enemy()
{
::remove_all_enemy();
if ( query("force")<query("max_force")*2 )
  SDS_D->powerup(this_object(),1);
}

int attack()
{
if ( random(3) )        
        SDS_D->super_attack(this_object(),offensive_target(this_object()),500);
return ::attack();
}       
