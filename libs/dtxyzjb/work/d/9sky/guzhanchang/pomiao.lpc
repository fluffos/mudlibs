// /d/guzhanchang/pomiao.c
#include <ansi.h>
inherit ROOM;

int do_out();

void create()
{
string msg;     
set("short", "破庙");
msg = "这里是一个破庙，到处贴满了符(fu)，看起来相当诡异。\n";
msg+= YEL+@LONG
         
        */.    .   .    *      .
        .\*    .    []           *  __
        */ .   ./\~~~~~~~~~~~~'\. |◆  
        \*   ,/,..,\,...........,\.◆  
        ||  ..▎#  ▎田  田 ▎ | ▎◆
        ||  &&▎   ▎       ▎'|'▎ o   
        || ##■■■■■■■■■■〓   
   
LONG+NOR;
msg = replace_string(msg,"◆",NOR BLINK HIG"◆"NOR YEL);
set("long",msg);
set("exits", ([
        "down" : __DIR__"road0",
        ]));
set("item_desc",([
        "fu" : "破烂不堪一张符纸，可以揭(jie)开看看。\n",
]));            
set("no_clean_up", 0);
setup();
}

void init()
{
add_action("do_out","out");
add_action("do_jie","jie"); 
}

int do_out()
{
object room;
object who = this_player();
message_vision("$N决定要离开了，不觉心中一轻，飞一般的跑了出去！\n",who);
who->recieve_damage(who->query("kee")/5);
who->recieve_wound(who->query("max_kee")/5);
who->start_busy(5);
who->move("/d/guzhanchang/mi8");
return 1;
}

int valid_leave(object me, string dir)
{       
object a;

if (dir == "down") 
        {
        if(objectp(a=present("gui wang", environment(me))) && living(a) )
                return notify_fail("鬼王大叫：“哪里跑？不打死我你进不了九重天！！！”！\n");
        return ::valid_leave(me, dir);
        }
return ::valid_leave(me, dir);
}

int do_jie(string arg)
{
object npc,me = this_player();
if ( !arg || arg!="fu" )
        return 0;
if ( query("jied") && userp(me) )
        return notify_fail("你将符纸揭开，结果什么反应也没有。\n");

message_vision("$N上前将符纸小心翼翼的揭了开来。。。。\n",me);
switch(random(4))
        {
        case 0 : npc = new(__DIR__"npc/guiwang3");break;
        case 3 : npc = new(__DIR__"npc/guiwang2");break;                
        default: npc = new(__DIR__"npc/guiwang");break;         
        }
if ( npc && npc->move(this_object()) )
        {
        message_vision("\n结果一阵阴风刮过，$n从中杀出！\n\n",me,npc);          
        this_object()->set("jied",1);
        npc->fight_ob(me);
        me->fight_ob(npc);
        }
else    message_vision("结果什么也没发生。\n",me);
return 1;
}

void reset()
{
if ( query("jied") )
        delete("jied");         
::reset();
}       

