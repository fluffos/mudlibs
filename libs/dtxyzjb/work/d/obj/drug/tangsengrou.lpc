
#include <ansi.h>


inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
       
    set("no_drop","这可是人人想尺的唐僧肉呀，你竟然想扔了？？\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( RED "唐僧肉" NOR , ({"tangseng rou", "rou"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
   set("unit","块");
    set("long", "一颗暗红的丹药。\n");
    set("value", 1000000);
    set("drug_type", "补品");
  }

  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  if (arg!="rou" && arg!="tangseng rou") return 0;
  
  me->add("bellicosity",2000);
  message_vision(RED "\n你满足的拍了拍肚子，打了个饱嗝。\n\n"NOR,me);
  message_vision(RED "\n突然觉得一股恶气冲上心头，只觉得想杀人....\n\n"NOR,me);
 destruct(this_object());
  return 1;
}

