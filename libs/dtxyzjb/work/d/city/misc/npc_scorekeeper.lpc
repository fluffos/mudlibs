#include <ansi.h>
#include <dbase.h>

inherit  NPC_SAVE;

void greeting(object me);

void create()
{
        set_name("黑子"NOR, ({"hei zi","hei","zi"}));
        set("long","一名威风凛凛的蒙面人，专门负责维持会场秩序。\n");
        set("title", HIC"场监"NOR);

        set("gender", "男性");
        set("age", 44);
        set("per",30);
        set("class", "yaomo");
       set("attitude", "friendly");
       set("int", 30);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 300);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);
       set("faith", 1000);

   set_skill("unarmed", 500);
   set_skill("stealing", 500);
   set_skill("qixiu-jian", 500);
   set_skill("dodge", 500);
   set_skill("parry", 500);
   set_skill("literate", 500);
   set_skill("spells", 500);
   set_skill("force", 500);
   set_skill("huntian-qigong", 500);
   set_skill("yaofa", 500);
   set_skill("yinfeng-zhua", 500);
   set_skill("kugu-blade", 500);
   set_skill("sword", 500);
   set_skill("blade", 500);

   map_skill("force", "huntian-qigong");
   map_skill("unarmed", "yinfeng-zhua");
   map_skill("dodge", "kugu-blade");
   map_skill("spells", "yaofa");
   map_skill("parry", "qixiu-jian");
   map_skill("sword", "qixiu-jian");
   map_skill("blade", "kugu-blade");

   create_family("陷空山无底洞", 1, "弟子");
   setup();
   carry_object("/d/obj/cloth/baipao")->wear();
   carry_object("/d/obj/weapon/sword/zhujian.lpc")->wield();
   carry_object("/d/obj/weapon/blade/jindao.lpc");
}

int accept_object (object who, object ob)
{
  object me;
  me = this_object();

  if ((! ob) ||
       ob->value() < 10000) 
  {
    message_vision ("$N淡淡的说到：每次一两黄金！这年头钱不容易挣啊！\n", me);
    return 1;
  }  
  who->set_temp("npc_leitai/givemoney",1);
  return 1;
}

void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
        remove_call_out("check2");
        call_out("check2",0);

 if(me->is_busy())
    {   
       command("unwield blade");
       command("wield sword");
       command("jiali max");
       command("exert recover");
       if(!ob->query_temp("zxzx")) command("perform zxzx");
       command("unwield sword");
       command("wield blade");
       command("perform diyu");
       command("unwield blade");
       command("wield sword");
      if (random(10)>3)
        {
         command("perform yaowu");
         }
      else 
        {
         command("cast bite");
         }
        remove_call_out("check");
        call_out("check",2);
    }
  if(!me->is_busy())
    {
        command("unwield sword");
        command("exert recover");
        command("perform duzun");
        command("wield blade");
        command("perform pozhan");
        command("perform duo");
        remove_call_out("check");
        call_out("check",3);

    }
}


