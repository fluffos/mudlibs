// waiter.c

#include <ansi.h>
inherit F_VENDOR_SALE;

void create()
{
//      reload("zhoutiejiang");
        set_name("周铁匠", ({ "zhou tiejiang", "zhou", "tiejiang", "smith"}) );
        set("gender", "男性" );
         set("title","铁匠");
        set("age", 42);
        set("long","周铁匠四十多岁，长得虎背熊腰。。\n");
        set("combat_exp", 10000);
        set("attitude", "peaceful");

        set_skill("dodge", 40);
        set_skill("unarmed", 40);
        set_skill("literate", 40);

        set("max_kee", 600);
        set("max_sen", 600);


        set("vendor_goods", ([
                "dagger": "/d/obj/weapon/dagger/dagger.lpc",
                "axe": "/d/obj/weapon/axe/tiefu.lpc",
                "hammer": "/d/obj/weapon/hammer/hammer",
                "fork": "/d/obj/weapon/fork/fork",
                "tiegun": "/d/obj/weapon/stick/bintiegun",
                "tielian":"/d/obj/weapon/whip/tielian",
        ]) );
        setup();

        carry_object("/d/obj/cloth/linen")->wear();
        carry_object("/d/obj/weapon/hammer/hammer")->wield();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
        }
        add_action("do_vendor_list", "list");
        add_action("do_repair", "repair");   
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( name()+"说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来随便看看吧。\n");
                        break;
                case 1:
                        say(name()+ "用脖子上的毛巾抹了抹手，说道：这位" +
RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say(name()+ "说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来挑一件称手的兵器吧。\n");
                        break;
        }
}

int do_repair(string arg)
{
        object obj;
        int value,afford;
        object me = this_player();
        
        if( !arg ) return notify_fail("你要修理什么东西？\n");
        else if( (obj = present(arg, me)) )//|| (obj = present(arg, environment(me))))
        {
                if( obj->is_character() ) return notify_fail("你要修理什么东西？\n");
                else
                {
                        if (obj->query("durability/max")<=obj->query("durability/now"))
                                return notify_fail("这样东西好象不用修吧？\n");
                        else
                        {
                                switch(obj->query("material"))
                                {
                                   case "bronz": value=2;break;
                                   case "steel": value=3;break;                                    
                                   case "iron":  value=4;break;                                    
                                   case "gold":  value=5;break;                                    
                                   case "jade":  value=6;break;
                                   case "xianling":  value=7;break;                                                                    
                                   case "datang":  value=8;break;                                       
                                   default:value=1;
                                }
                    value*=(obj->query("durability/max")-obj->query("durability/now"))*100;
                                write(CYN "一共需要"+price_string(value)+"。\n" NOR, me);
                                if( afford = me->can_afford(value) )
                                {
                                        if( afford==2 ) return notify_fail("你没有足够的零钱，而银票又没人找得开。\n");
                                         me->pay_money(value);
                                        obj->set("durability/now",obj->query("durability/max"));
                                        return notify_fail(obj->query("name")+"修好了。\n");
                                }else return notify_fail("你的钱不够。\n");
                                
                        }
                }// result = look_item(me, obj);
        
        } else return notify_fail("你要修理什么东西？\n");      
} 

