
int set_pk(string arg);
int do_yes(string arg);
int do_no();

// #include "norumor.lpc"

inherit NPC;

#include <ansi.h>
void create()
{
       set_name(MAG"紫藤天使"NOR, ({"zt angel","zt","angel"}));
       set("title",HIG"放下屠刀 "HIY" 立地成佛"NOR);
       set("gender", "女性");
       set("combat_exp", 1000);
       set("age", 26);
       set("per", 30);
       set("attitude", "friendly");
       set("shen_type", 1);
       set_skill("unarmed", 10);
       set("inquiry",([
              "承诺": "关于承诺的详细情况,可以(Help pk)。\n"
          ]) );
       setup();

       carry_object("/d/obj/cloth/xianyi")->wear();
       carry_object("/d/obj/cloth/xiuhuaxie")->wear();
}

void init()
{
        ::init();
        add_action("set_pk","chengnuo");
        add_action("do_yes","yes");
        add_action("do_no","no");

}

int set_pk(string arg)
{
	object me,obj;
	
	me=this_player();
	if(!arg) return notify_fail("你承诺(chengnuo)什么？\n");
	
	if ( me->query("pk/chengnuo") )
                return notify_fail("\n"+"  "HIR"大丈夫一诺千金，怎能随便更改？？\n\n"NOR);
			
	if(arg=="pk")
	{
message_vision(HIR "紫藤使者对$N说道：$N在今后的MUD生涯中会有选择的PK？(Yes)\n"NOR, me);
	}
	
	if(arg=="no_pk")
	{
message_vision(HIG "紫藤使者对$N说道：$N以后不会介入纷繁的杀戮之中？(Yes)\n"NOR, me);
	}
	
	me->set_temp("chengnuopk",1);
	return 1;
}

int do_yes(string arg)
{
        string who,id;
	object me,obj;
		
	me=this_player();
        id=me->query("id");
        who=me->query("name");
	if(!me->query_temp("chengnuopk")) return notify_fail("什么?\n");
        if(!arg) return notify_fail("你还没选择呢？（yes no_pk/yes pk）\n");
	
	me->set_temp("chengnuopk",0);
        if(arg=="pk")
        {
        me->set("pk/no_pk_death",0);
        seteuid(ROOT_UID);
        set("channel_id", HIR"紫藤天使(Zt angel)");
        CHANNEL_D->do_channel( this_object(), "chat",  HIR""+ who +"("+ id +")"+ HIR"选择了ｐｋ。\n"NOR);
        me->delete_temp("chengnuopk");
        }
        else if(arg=="no_pk")
        {
        me->set("pk/no_pk_death",1);
        set("channel_id", HIG"紫藤天使(Zt angel)");
        CHANNEL_D->do_channel( this_object(), "chat",  HIG""+ who +"("+ id +")"+ HIG"打算不介入江湖的杀戮纷争。\n"NOR); 
        me->delete_temp("chengnuopk");
        }
             else return notify_fail("你的回答不符合要求。\n");
message_vision("紫藤使者对$N点点头，$N承诺完了。\n"NOR, me);
        me->set("pk/chengnuo",1);
	
	
	if(objectp(obj = present("chengnuo jinpai", me))) destruct(obj);
	return 1;
}

int do_no()
{
	object me;
	
	me=this_player();
	if(!me->query_temp("chengnuopk")) return notify_fail("什么?\n");
	me->set_temp("chengnuopk",0);
	command("? "+me->query("id"));
	command("ok "+me->query("id"));
	command("say 那你想好了再来吧。不过没想好之前是不能下kill命令的哦。");
	command("heihei "+me->query("id"));
	
	return 1;
	
}
