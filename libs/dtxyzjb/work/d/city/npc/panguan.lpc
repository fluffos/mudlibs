void create()
{
    set_name(HIR"门派使者"NOR, ({"pan guan", "panguan", "guan"}));
        set("gender", "男性" );
        set("age", 35);
    set("title","铁面无私");
        set("per", 5);

    set("long", HIR"无人不知的铁面判官，专为维护本站良好游戏环境而设，并且为新手传送至自己想要加入的门派。\n"NOR);
        set("combat_exp", 5000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 800);
        set_skill("dodge", 800);
        set_skill("parry", 800);
        set_skill("blade", 800);
        set_skill("force", 800);
        set_skill("literate", 800);
//      set("no_shown", 1);
        set("max_force", 40000);
        set("force", 40000);
        set("max_mana", 40000);
        set("mana", 40000);
        set("max_kee", 40000);
        setup();

	set("inquiry", ([
		"门派选择" : (: ask_mp :),
	]));
//以下是被监控的频道，各MUD不同。
       if( clonep() ) CHANNEL_D->register_relay_channel("rumor");
       if( clonep() ) CHANNEL_D->register_relay_channel("chat");
       if( clonep() ) CHANNEL_D->register_relay_channel("party");
       if( clonep() ) CHANNEL_D->register_relay_channel("qq");
       if( clonep() ) CHANNEL_D->register_relay_channel("es");
       if( clonep() ) CHANNEL_D->register_relay_channel("xyj");
       if( clonep() ) CHANNEL_D->register_relay_channel("sldh");
       if( clonep() ) CHANNEL_D->register_relay_channel("bh");
}

void init()
{
	add_action("ask_menpai","ask_menpai");
}

void relay_channel(object ob, string channel, string msg)
 {
          int i;
          if( !userp(ob) || (channel == "sys") )
                  return; //npc与系统信息不受此限制
         if(wizardp(ob)) return;//wizard不受限制
          for(i=0; i<sizeof(msg_d); i++) //逐条检验
         {
              if( strsrch(msg, msg_d[i]) >= 0) //搜索(在频道的话中)
                    {
                       ob->add_temp("maren",1);
                   if(ob->query_temp("maren")>1||time()-ob->query("last_maren") <60)
                      {
                      ob->delete_temp("maren");
                      call_out("punish0",0,ob);
                      }
                   else tell_object(ob,HIW"你突然浑身一抖,原来是不小心用脏字!\n你被盯上了,小心被关哦!\n"NOR);
                     ob->set("last_maren", time());
                     return;
                    }
          }
  }
void punish0(object ob)
{
//added by huarong 2003/12
        if (!wizardp(ob) && time()-(int)ob->query("birthday") < 1800 )
           {
            command("chat* 铁面判官一脚将"+ob->query("name")+"踢得飞灰烟灭!");
            seteuid(ROOT_UID);
            ob->set_temp("force_quit",1);
            ob->command("quit");
            return;
           }
           ob->start_busy(30);
           command("chat* 忽听铁面判官一声怒喝："+ob->query("name")+"骂人了，小的们,打入地狱!");
           ob->set("channel/chat_block",time()+900);
           call_out("punish", 30, ob);
        }

void punish(object ob,string msg)
  {
          object *inv;
          int i;
   if(ob->is_fighting()||ob->is_busy())
    {
    call_out("punish", 1, ob); return; }
         message_vision(HIC"空中飞下一根绳子，一下就套住$N的脖子。\n"NOR+CYN"$N伸长舌头、翻"+
   "着白眼地被拖走了。\n"NOR, ob);
          ob->move("/d/city/prison");
          message_vision(CYN"环境判官狂笑道:小的们,大刑伺候!\n"NOR, ob);
          message_vision(CYN"说着，绳子一松，$N被扔在地上。\n"NOR, ob);
          inv = all_inventory(ob);
          for(i=0; i<sizeof(inv); i++)
              {
                         if (!inv[i]->query("changed")) destruct(inv[i]);
               }
          ob->be_ghost(1);
          ob->add("gab_word",1);  //第一次说脏话只是警告。
       ob->apply_condition("maren",5+(int)ob->query("gab_word")*5);
          return;
          }

string ask_mp()
{
	object me = this_player();

	write(ZJOBLONG"你要拜哪里:\n"ZJOBACTS2+ZJMENUF(3,3,9,30)
		"东海龙宫:ask_menpai dhlg"ZJSEP
		"天魔宫:ask_menpai tmg"ZJSEP
		"五庄观:ask_menpai wzg"ZJSEP
		"大雪山:ask_menpai dxs"ZJSEP
		"盘丝洞:ask_menpai psd"ZJSEP
		"三界散仙:ask_menpai sx"ZJSEP
		"蜀山派:ask_menpai ss"ZJSEP
		"阎罗地府:ask_menpai df"ZJSEP
		"神剑山庄:ask_menpai sj"ZJSEP
		"将军府:ask_menpai jjf"ZJSEP
		"普陀山:ask_menpai pt"ZJSEP
		"月宫:ask_menpai yg"ZJSEP
		"方寸山:ask_menpai fcs"ZJSEP
		"火云洞:ask_menpai hyd"ZJSEP
		"昆仑玉虚洞:ask_menpai kl"ZJSEP
		"陷空山无底洞:ask_menpai wdd\n"
	);
	return "希望你能够走上人生的巅峰吧！";
}

int ask_menpai(string arg)
{
    object ob;
    ob=this_player();

	if(!arg)
		return notify_fail("你要选哪个门派？\n");

    if (ob->query("xiyou_bai")) return notify_fail("新手只能传送一次\n");

    if(arg == "dhlg")
    {
		ob->move("/d/sea/gate");
		ob->set("xiyou_bai",1);
    }
    else if(arg == "tmg")
    {
		ob->move("/d/tianmo/changlang1");
		ob->set("xiyou_bai",1);
    }
    else if(arg == "wzg")
    {
		ob->move("/d/qujing/wuzhuang/guangchang");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "dxs")
    {
		ob->move("/d/xueshan/shanpo");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "psd")
    {
		ob->move("/d/pansi/tao_in");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "sx")
    {
		ob->move("/d/city/caotang");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "ss")
    {
		ob->move("/d/shushan/path1");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "df")
    {
		ob->move("/d/death/new-walk3");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "sj")
    {
		ob->move("/d/shenjian/road");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "jjf")
    {
		ob->move("/d/jjf/qilin");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "pt")
    {
		ob->move("/d/nanhai/xiaoyuan");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "hyd")
    {
		ob->move("/d/qujing/jilei/dating");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "fcs")
    {
		ob->move("/d/lingtai/uphill6");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "yg")
    {
		ob->move("/d/moon/ghg_zhengdian");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "kl")
    {
		ob->move("/d/kunlun/gate");
		ob->set("xiyou_bai",1);
    }
	else if(arg == "wdd")
    {
		ob->move("/d/city/minju3");
		ob->set("xiyou_bai",1);
    }
    else
	return notify_fail("你要选哪个门派？\n");

    return 1;
}