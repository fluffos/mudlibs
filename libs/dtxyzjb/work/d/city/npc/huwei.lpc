#include <ansi.h>
inherit NPC;

void create()
{
	set_name(HIB"护卫"NOR,({ "huwei","wei" }) );
	set("title",HIY"高楼门总堂"NOR);
        set("gender", "女性" );
        set("age", 22);
        set("long", 
"这是高楼门总堂的女护卫，手持长枪，整齐地排在两边。\n");

  set("age", 22);
  set("str", 60);
  set("cor", 60);
  set("cps", 60);
  set("spi", 30);
  set("per", 35);
  set("con", 60);
  set("int", 30);
  set("kar", 35);
//        set("attitude", "aggressive");
//        set("shen_type", -1);

	set("kee", 20000);
	set("max_kee", 20000);
	set("sen", 20000);
	set("max_sen", 20000);
	set("force", 4000);
	set("max_force", 4000);
   set("mana", 40000);
   set("max_mana", 40000);
	set("force_factor", 20);
	set("combat_exp", 2000000);
//	set("score", 15000);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 20);

	set_skill("unarmed",150);
	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("spear", 150);
	set_skill("staff", 150);
	set_skill("literate", 150);
	set_skill("wuxing-quan", 150);
	set_skill("yanxing-steps",150);
	set_skill("bawang-qiang", 150);
	set_skill("zixia-shengong", 150);
//	set_skill("jiuyin-xinjing", 150);
	set_skill("wuxiangforce", 150);

	map_skill("force", "zixia-shengong");
	map_skill("unarmed", "wuxing-quan");
	map_skill("dodge", "yanxing-steps");
	map_skill("parry", "bawang-qiang");
	map_skill("spear", "bawang-qiang");
       
   create_family("将军府", 2, "弟子");
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
           (: perform_action, "spear","meihua" :),
           }));
        setup();

        carry_object("/d/obj/weapon/spear/tiespear")->wield();
        carry_object("/d/obj/armor/tongjia")->wear();
	 add_money("gold",3);
}

int accept_fight(object me)
{
        message_vision("女护卫对$N哈哈大笑：算你的，赢了我就以身相许。\n", me);
        me->apply_condition("killer", 100);
        kill_ob(me);
        return 1;
}


