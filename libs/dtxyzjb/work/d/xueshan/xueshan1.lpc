//xueshan2.c

inherit ROOM;
#include <ansi.h>


void create ()
{
	set ("short", "茫茫雪峰");
	set ("long", @LONG

北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间
似已毫无生迹，除了雪还是雪。
LONG);


	set("exits", 
	([ //sizeof() == 4
		"south" : "/d/moon/kunlun",
		"north" : __DIR__"xueshan2",
"east": VRM_DIR"VRM_0502/entry",
	]));
	
	set("outdoors", "xueshan");
        setup(); 
}


int valid_leave(object me, string dir)
{
int i;
object* inv;
int zslev, exp, dx, xz;
zslev = 0;
exp = me->query("combat_exp");
dx = me->query("daoxing");
xz = 5000000;
zslev = me->query("lunhui_zhuanshi");
inv = all_inventory(this_player());
for(i=0; i<sizeof(inv); i++)
        if ( dir == "east"&&userp(inv[i]))
        {
                         message_vision(HIM"一股强大的力量阻止了你。\n"NOR,this_player());
                         me->start_busy(3);
                         return notify_fail("");
         }
          
         if ( dir == "east"&&exp < xz)
                      {
                   me->start_busy(3);
          return notify_fail(HIW" 你的武学不够高，就别去送死了\n"NOR);
           return notify_fail("");
          }
        
        if ( dir == "east"&&dx < xz)
                      {
                   me->start_busy(3);
          return notify_fail(HIW" 你的道行不够高，就别去送死了\n"NOR);
           return notify_fail("");
          }
  
         return ::valid_leave(me, dir);
          
}
