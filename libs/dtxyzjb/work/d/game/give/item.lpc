void create()
{
int i;
string owner,name,id;

i = random(sizeof(objs)/3)*3;
owner = objs[i];
 name =  objs[i+1];
id = objs[i+2];

set_name(name,({id}));
set("myowner",owner);
set_weight(2000);
set("unit","个");
set("value",1);
set("no_put",1);
setup();
}

string long()
{
return ::long()+YEL"这是"NOR+HIG+query("myowner")+NOR YEL"的"+name()+YEL"，
将它交给"HIW"袁天罡"NOR YEL"吧。\n"NOR;
}       

string short()
{
return query("myowner")+"的"+::short();
}
