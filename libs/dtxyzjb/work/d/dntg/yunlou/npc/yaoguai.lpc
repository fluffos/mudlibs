object offensive_target(object me)
{
        int sz;
        object *enemy;

        if( !me || !me->query_enemy() || !arrayp(me->query_enemy()) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}


