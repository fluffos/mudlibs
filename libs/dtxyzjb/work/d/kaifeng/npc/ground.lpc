// create by error 6/8/2000

inherit ROOM;
inherit __DIR__"ground3";

#include <ground.h>
#include <localtime.h>
void check_time()
{
   int t, i, k, week, hour, min, dealy, start_time;
   mixed*  lt;
   object *list;
   t = time();
   lt = localtime( t );
   week = lt[LT_WDAY], hour = lt[LT_HOUR],min = lt[LT_MIN];
   if( week == 6 && hour >= 8 && hour < 10 && min < 59 ) {
   	if( this_room()->query("auto_start") )
   		return;
	this_room()->delete("match");	//删除以前的设置
	this_room()->set("can_enter",1);//设置场地可自由出入
	this_room()->set("auto_start", 1);
	this_room()->set("match/mode",5);//设置比赛方式 —— 自动
	//设置比赛队伍 共五组
	this_room()->do_team("l");//菜
	this_room()->do_team("m");//低
	this_room()->do_team("n");//中
	this_room()->do_team("o");//高
	this_room()->do_team("p");//超
	dealy = (10 - hour)*3600 - min*60;
	start_time = time() + dealy;
    remove_call_out("check_time");
    remove_call_out("sign_up");
	call_out("sign_up", 60, dealy );
//	call_out("do_ready_start", dealy );
	return;
    }
   if( week == 6 && hour < 8 ) {
       remove_call_out("check_time");
   	   call_out("check_time", (8-hour)*3600-min*60 );
   	   return;
    }
   if( week >= 6 ) k = week -7;
   else
   		k = week;
   remove_call_out("check_time");
   call_out("check_time", (32-hour)*3600-min*60 + (5-k)*24*3600 );
}

void sign_up(int dealy)
{
   remove_call_out("sign_up");
   if( start_time == 0 )
   	   start_time = time() + dealy;
   dealy = start_time - time();
   if( dealy > 300 ) {
	   announce ("「水陆大会」现在开始报名，" + CHINESE_D->time_string(dealy)
	   			+ "钟后「"+ CHINESE_D->chinese_time(start_time) + "左右」开始比赛。\n");
   	   call_out("sign_up", 300, dealy );
	}
	else {
		if( dealy != 0 )
			announce ("「水陆大会」报名就要结束，"+CHINESE_D->time_string(dealy)+"钟后开始清理赛场，要参加的请赶快报名。\n");
	   remove_call_out("do_ready_start");
	   call_out("do_ready_start", dealy );
	}
}

void do_ready_start()
{
   int i;
   object *list;
   string *dirs = ({
	__DIR__"west",
	__DIR__"east",
	__DIR__"north",
	__DIR__"south",
    });
   remove_call_out("sign_up");
   remove_call_out("check_time");
   remove_call_out("do_ready_start");
   announce ("水陆大会比赛时间已到 ．．．现在开始清理赛场！\n");
   this_room()->delete("can_enter");
   list=all_inventory(this_room());
   i = sizeof(list);
   while(i--) {//清场
	if( userp(list[i]) && !wizardp(list[i]) )
		list[i]->move(dirs[random(sizeof(dirs))]);
    }
   remove_call_out("do_start");
   call_out("do_start",30);
}


void create ()
{
  set ("short", "赛场");
  set ("long", @LONG

赛场四周是高高的贵宾观礼台，十丈见方的场地上整整齐齐地
铺着一圈彩色玛瑙石，架着香烟袅绕的四个巨大金银铜铁鼎，
场地中间是软松的皮绒织锦毯。

LONG);

  set("exits", ([
        "westup"  : __DIR__"west",
        "eastup"  : __DIR__"east",
        "northup"  : __DIR__"north",
        "southup"  : __DIR__"south",
      ]));
  set("objects", ([
        __DIR__"npc/wei"  : 1,
        __DIR__"npc/siguan"  : 2,
      ]));
  set("no_quit",1);
  set("no_flee",1);
  set("no_mieyao",1);
  set("no_fight",1);
  set("no_magic",1);
  set("broadcast",1);
  set("alternative_die",1);
  setup();
  call_out("check_time",60);
}


void init ()
{
  object who = this_player();
  if (wizardp(who))
  {
    init0();
    init1();
    init2();
    init3();
    call_out ("hinting",1,who);
  }
  add_action ("do_fight","fight");
  add_action ("do_fight","kill");
  
  add_action("do_join", "join");
  add_action("do_quit",banned_action);
  add_action("do_cast",({"cast","perform","exert"}));
}

int do_quit(string arg){
  write("你不能在这里用这条命令。\n");
  if (wizardp(this_player()))
     write("巫师请参阅同一路径内的ground.h文档。\n");
  return 1;
}

int do_cast(string arg)
{
   if(!arg) return 0;
        while(sscanf(arg,"%s %*s",arg)==2);
   if(member_array(arg,banned_cast)==-1) return 0;
        write("赛场上请勿使用 "+arg+",多谢合作。\n");
   return 1;
}

int check_fighters (object who, object ob)
{
  object *inv = all_inventory (environment(who));
  object wei = present ("wei zheng", environment(who));
  string names = "";
  int i = sizeof (inv);

  if (ob == wei)
    return 0;

  while (i--)
  {
    if (inv[i]==who || inv[i]==ob || inv[i]==wei)
      continue;
    if (inv[i]->is_fighting())
      names += inv[i]->name();
  }
  if (names != "")
  {
    message_vision ("$N对$n说道：这场上"+names+"等正在拚死厮杀，请稍候片刻！\n",wei,who);
    return 0;
  }
  if (! userp(who) || ! userp(ob))
    return 1;
  call_out ("wait_and_announce",1,who,ob);
  return 1;
}

void wait_and_announce (object who, object ob)
{
  mapping match = this_room()->query("match");
  int step;
  string name0, name1, names;

  if (! match)
    return;
  step = match["step"];
  if (step != STEP_FIGHT)
    return;
  if (! who || ! ob)
    return;
  name0 = who->query("name");
  name1 = ob->query("name");
  if (strcmp(name0,name1) > 0)
    names = name0 + name1;
  else
    names = name1 + name0;
  if (match["fighters"] == names)
    return;

  match["fighters"] = names;
  announce (name0 + "与" + name1 + "水陆大会生死相搏！\n");
}

int do_fight (string arg)
{
  object who = this_player();
  object ob;

  if (! arg)
    return 0;
  ob = present (arg, environment(who));
  if (! ob)
    return 0;
  if (! check_fighters (who, ob))
    return 1;
  "/cmds/std/kill"->main(who,arg);
  return 1;
}

void hinting (object who)
{
  tell_object (who, "\n");
  tell_object (who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object (who, "◇大会分筹备、比赛、结束等阶段，不同阶段有不同命令。◇\n");
  tell_object (who, "◇使用命令时请注意是否有其他巫师也在此设置比赛数据。◇\n");
  tell_object (who, "◇　　　　　　　　　　　　　　　　　　　　　　　　　◇\n");
  tell_object (who, "◇请您随时使用 ? 或 what 来查询您可以使用的命令。 　◇\n");
  tell_object (who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object (who, "\n");
}

int do_join()
{
        int exp, step;
        object who = this_player();
        step = this_room()->query("match/step");
        
        if (step > STEP_PREPARE)
          {
            write ("比赛已开始了，安心比赛吧。\n");
            return 1;
          }
        if (who->is_busy()) return notify_fail("你正忙着呢。\n");
        exp = who->query("combat_exp");
          if (exp >= 20000000)
          this_room()->do_teammember("4 + "+ who->query("id"));
          else if (exp >= 10000000)
          this_room()->do_teammember("3 + "+ who->query("id"));
          else if (exp >= 5000000)
          this_room()->do_teammember("2 + "+ who->query("id"));
          else if (exp >= 1000000)
          this_room()->do_teammember("1 + "+ who->query("id"));
          else if (exp >= 500000)
          this_room()->do_teammember("0 + "+ who->query("id"));
        else {
              write ("你还没有资格参加水陆大会。\n");
              return 1;
             }
        who->start_busy(1);
        return 1;
}

int valid_leave (object who, string dir)
{
        int mode = this_room()->query("match/mode");
        if (wizardp(who))
                return ::valid_leave(who, dir);
        if (mode == MODE_AUTO && !this_room()->query("can_enter") )
        return notify_fail ("对不起，您不能擅自离场。\n");
        else
        return ::valid_leave(who, dir);
}

int clean_up()
{
      return 0;
}

