inherit NPC;

void create()
{
  set_name("八神 庵", ({"iori"}));
  set("gender", "男性");
  set("long", "他是未来世界的格斗天尊，身上有很多的宝贝，如果你想得到，那么你就把他杀掉吧。\n");
  set("looking", "仪容清俊貌堂堂，两耳垂肩目有光。");
  set("combat_exp", 5000000);
  set("daoxing", 7000000);
  set("title", "格斗天尊");
  set("age", 30);
  set("str", 40);
  set("int", 40);
  set("per", 30);
  set("con", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin",20000);
  set("max_kee",20000);
  set("max_sen",20000);
  set("max_force",10000);
  set("force_factor", 250);
  set("force",20000);
  set("mana",20000);
  set("max_mana",10000);
  set("mana_factor", 250);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("dragonstep", 350);
  set_skill("spells", 350);
  set_skill("parry", 350);
  set_skill("seashentong", 350);
  set_skill("dragonfight", 350);
  map_skill("spells", "seashentong");
  map_skill("parry", "dragonfight");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
          (: perform_action, "unarmed", "three" :),
          (: cast_spell, "spells","bazhinu" :),
        }) );
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
//       carry_object("u/ling/obj/kuihua");
}

