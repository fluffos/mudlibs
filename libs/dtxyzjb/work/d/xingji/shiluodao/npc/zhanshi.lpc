inherit NPC;

void create()
{
  set_name("战士", ({"zhan shi", "shi"}));
  set("gender", "男性");
  set("long", "他是未来世界的格斗天尊，身上有很多的宝贝，如果你想得到，那么你就把他杀掉吧。\n");
  set("looking", "已经看不清楚脸上的相貌了，唯一看的清楚的就是他的眼睛，发出的光带有一种寒气。");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);
  set("title", "低级");
  set("age", 30);
  set("str", 40);
  set("int", 40);
  set("per", 30);
  set("con", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin",2000);
  set("max_kee",2000);
  set("max_sen",2000);
  set("max_force",3000);
  set("force_factor", 100);
  set("force",4000);
  set("mana",4000);
  set("max_mana",3000);
  set("mana_factor", 100);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("moshenbu", 200);
  set_skill("spells", 200);
  set_skill("parry", 300);
  set_skill("iori-spells", 200);
  set_skill("iori-kuihua", 200);
  map_skill("spells", "iori-spells");
  map_skill("parry", "iori-kuihua");
  map_skill("dodge", "moshenbu");
  map_skill("unarmed", "iori-kuihua");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
          (: perform_action, "unarmed", "three" :),
          (: cast_spell, "bazhinu" :),
        }) );
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("d/xingji/shiluodao/obj/jldan");
  set("no_nk_reward",1);
}

