// yuanqi.c


inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m天地元气[2;37;0m", ({"yuanqi"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "开天辟地时才产生的天地元气，似乎兑换使者正需要它。\n");
                set("unit", "些");
                set("base_unit", "份");
                set("base_weight", 1);
                set("value", 1);
                }
        set_amount(1);
        setup();
}

