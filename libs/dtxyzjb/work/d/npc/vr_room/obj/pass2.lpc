#include <ansi.h>
inherit ITEM;

int do_use(string);
void create()
{
 set_name(HIW "高级护身符" NOR, ({"high amulet", "amulet"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张能使群魔退避的护身符，可以使用它(use)在迷宫中任意来去(500次效果)。\n");
    set("no_sell", 1);
    set("no_drop", 1);
    set("value", 15000000);
  }
   setup();
}

void init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
  object ob = this_object();
  object me = this_player();
  int i;
  i = 0;
  i = me->query_temp("passmaze");
  if (!id(arg))
    return notify_fail("你要使用什么？\n");
  if (i > 0)  
      {
    return notify_fail("你正在使用护身符，不能累计使用！\n");
        }
   else
      {
    me->add_temp("passmaze",500);
   message_vision(HIW"$N祭起一张"HIW"初级护身符"HIW"，只见$N周身顿时散发出耀眼光芒，一闪而过。\n"NOR, me); 
   destruct(this_object());
} 
return 1;
}

