// qihun.c

inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIG"通灵神兵"NOR, ({ "tongling weapon" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",    "这是一把被封印的通灵神兵，它似乎很虚弱的样子。\n");
                set("value", 0);
                set("no_sell", 1);
                set("no_get", 1);
           }
setup();
}

void init()
{
	add_action("do_insert", "insert");
}

int do_insert(string arg)
{
        object ob, me;
	me=this_player();
     	if( !arg)
		return notify_fail("你要放什么东西？\n");

        if( !arg || arg!="soul weapon" || !(ob=present(arg, me)) )             
           {
		return notify_fail("这个东西似乎并不能与通灵神兵相合。\n");
               }
           else
        {
            
                message_vision(HIY"器魂"NOR""MAG"一靠近"HIG"通天神兵"NOR""MAG"，只听嗖的一声，从$N"MAG"的手中脱离与神兵居然融合在了一起。\n",me );
                me->set("fengcun","done");
                call_out("weapon",2, me);     
                destruct(ob);
     	}
	return 1;
}

void weapon(object me)
{
     message_vision(HIG"\n    通天神兵"NOR""MAG"浑身震动，发出强烈的嗡嗡声，慢慢浮倒了空中\n"NOR,me);
 call_out("weapon1",2, me);
}

void weapon1(object me)
{
     message_vision(HIG"\n    通天神兵"NOR""MAG"和"HIY"器魂"NOR""MAG"结合后，似乎变的更有灵性了，全身流光溢彩\n"NOR,me);
 call_out("weapon2",2, me);
}

void weapon2(object me)
{
     message_vision(HIG"\n    通天神兵"NOR""MAG"围着$N"MAG"打了几个转，似乎想确认什么似的，最后停留在$N"MAG"面前，居然说话了。\n"NOR,me);
call_out("weapon3",2, me);
}

void weapon3(object me)
{
     message_vision(HIG"\n    通天神兵"NOR""MAG"说道：谢谢你！我本事一件太古神器，自从我有了灵性之，看到洪荒世界的残酷后。\n        慢慢的也变的邪恶，最终被如今的14派掌门联合起来封印于此。\n"NOR,me);
call_out("weapon4",2, me);
}

void weapon4(object me)
{
     message_vision(HIG"\n   通天神兵"MAG"似乎在考虑什么话要不要说……。\n"NOR,me);
call_out("weapon5",2, me);
} 


void weapon5(object me)
{
     message_vision(MAG"\n        其实哪些各门派的叛徒，都是因为受到我散发出的邪气侵蚀，才会变得如此邪恶。\n        幸好$N消灭了我的邪恶之念，并且找回了我的本源器魂，恢复了我的本性。\n        现如今我要回去找我的主人，我能感觉到他在遥远的地方等着我。\n"NOR,me);
call_out("weapon6",2, me);
} 

void weapon6(object me)
{
     message_vision(MAG"\n        我的朋友，为了感谢你为我做的一切，我会给与你与兵器沟通的能力。\n        能让你更加了解手中的兵器，或许某一天它也能成长为像我一样的存在。\n"NOR,me);
call_out("weapon7",2, me);
} 

void weapon7(object me)
{
     message_vision(HIG"\n通天神兵"HIB"散发出阵阵蓝光围绕在$N"HIB"的周围……。\n"NOR,me);
call_out("weapon8",2, me);
} 

void weapon8(object me)
{
     message_vision(MAG"\n    一会儿蓝光退去$N"MAG"显得精神奕奕，眼神中散发着不可思议的光芒，似乎领略到了非常深奥的东西……。\n"NOR,me);
     tell_object(me, HIW"\n     恭喜你领悟到了神兵的封印技能。\n      在以后的战斗中有灵性的神兵会自动激发封印技能\n"NOR); 
message("channel:rumor",HIG+"【副本信息】通灵神兵"HIC"：恭喜"+me->query("name")+"消灭凶魔，找回"HIY"器魂"HIC"，特奖励神器天赋-"HIW"封印之技"HIC"。\n"+NOR,me);
 call_out("weapon9",2, me);
} 

void weapon9(object me)
{
     message_vision(HIG"\n 通灵神兵"NOR""MAG"器身颤抖，发出嗡嗡的颤响，突然，光芒一吐，居然刺破了空间，划开了一条空间裂缝。\n    嗖的一声"HIG"通灵神兵"MAG"穿过空间裂缝消失的无影无踪。\n"NOR,me);
destruct(this_object());
 } 

