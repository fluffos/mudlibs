inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIY"乾坤袋"NOR, ({ "bag" }) );
        set_weight(1000);
        set_max_encumbrance(10000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "水火不浸，刀枪不入，能纳世间万物，切记，下线前要把包里的宝贝取出，不然乾坤袋会吞掉所有物品。\n");
                set("value", 50000);
                set("no_drop", 1);
           }
}
int is_container() { return 1; }
int query_autoload() { return 1; }
