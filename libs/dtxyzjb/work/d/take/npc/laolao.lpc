//Cracked by Take
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("月姥姥", ({"yue laolao","laolao"}));
  set("gender", "女性");
  set("age", 1000);
  set("title", HIR"千年蛇妖"NOR);
  set("long",HIR"仙灵岛灵儿的姥姥,看起来是一位精神矍铄的老妇人.\n"NOR);
  set("combat_exp", 5000000+random(30000));
  set("daoxing", 5000000);
  set("rank_info/respect", "老人家");
  set("per", 18);
  set_skill("dodge", 120);
  set_skill("parry", 100);
  set_skill("force", 80);
  set_skill("spells", 120);
  set_skill("bingxinjue", 150);
  set_skill("yuanlingforce", 100);
  set_skill("lingbo-step", 120);
  set_skill("sword", 120);
   set_skill("wuyue-sword",100);
  map_skill("force", "yuanlingforce");
  map_skill("spells", "bingxinjue");
  map_skill("parry", "wuyue-sword");
  map_skill("sword", "wuyue-sword");
  map_skill("dodge", "lingbo-step");

  set("max_sen",2300);
  set("max_kee",1800);

  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 100);
  set("mana", 2000);
  set("max_mana", 2000);
  set("mana_factor", 200);

        set("inquiry", ([
                "离宫":"哼.要走还不容易?\n" ,
                "leave": "哼.要走还不容易?\n" ,
				"补天石": "嗯，这个要问巫后娘娘，老太婆可不知道。\n",
]) );

    create_family("水月宫", 2, "蓝");

  setup();

  carry_object("/d/qujing/kusong/obj/tongjia")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();

}

void attempt_apprentice(object ob)
{       ob=this_player();

        if( (string)ob->query("family/family_name") != "水月宫") {
		command("say  "+ RANK_D->query_rude(ob) +"想跟姥姥耍花样?\n");
		return;
	}
          if( ob->query_skill("spells") < 50)  {
		command("say  "+ RANK_D->query_respect(ob) +"还是先打好法术基础再来吧.\n");
		return;
	}
	if( ob->query("daoxing") < 100000)  {
		command("say  "+ RANK_D->query_respect(ob) +"的修为太浅，不要操之过急。\n");
		return;
	}
		if( ob->query("family/generation") < 3)  {
		command("say  "+ RANK_D->query_respect(ob) +"修为已远胜老太婆,何需再行此大礼.\n");
		return;
	}
	        if( (string)ob->query("family/shuiyue_master") == "gailuojiao")  {
		command("say  "+ RANK_D->query_respect(ob) +"武功已得盖将军的指点,老太婆没什么好教你的了.\n");
		return;
	}


				command("nod " + ob->query("id"));
                command("say 既然入了我门下,我会逐步将水月宫的法术精髓传授给你,能不能运用自如就看你自己的努力了。\n");
				command("recruit " + ob->query("id"));
				ob->set("family/shuiyue_master","laolao");
                return ;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) {
                ob->set("class", "yaomo");
                ob->set("title", "水月宫人身蛇妖");
        }
}
