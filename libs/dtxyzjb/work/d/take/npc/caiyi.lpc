//Cracked by Take
#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string expell_me(object me);

void create()
{
  set_name("彩衣", ({"cai yi","yi"}));
  set("gender", "女性");
  set("age", 1000);
  set("title", HIY"千"+HIR"年"+HIB"蝴"+HIG"蝶"NOR);
  set("long",HIR"雖然是妖精,但從彩衣身上絲毫察覺不到一點妖氣。\n"NOR);
  set("combat_exp", 1000000+random(3000));
  set("daoxing", 1000000);
  set("rank_info/respect", "神仙姐姐");
  set("per", 35);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);
  set_skill("force", 60);
  set_skill("spells", 60);
  set_skill("bingxinjue", 40);
  set_skill("yuanlingforce", 40);
  set_skill("linghuan-finger", 40);
  set_skill("lingbo-step", 40);
  set_skill("sword", 60);
  set_skill("staff", 60);
   set_skill("wuyue-sword",60);
   set_skill("shengling-zhang", 60);
  map_skill("force", "yuanlingforce");
  map_skill("spells", "bingxinjue");
  map_skill("parry", "wuyue-sword");
  map_skill("sword", "wuyue-sword");
  map_skill("unarmed", "linghuan-finger");
  map_skill("dodge", "lingbo-step");

  set("max_sen",800);
  set("max_kee",800);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 20);
  set("mana", 400);
  set("max_mana", 400);
  set("mana_factor", 20);

        set("inquiry", ([
                "离宫": (: expell_me :),
                "leave": (: expell_me :),
]) );

    create_family("水月宫", 3, "蓝");

  setup();

        carry_object("/d/gao/obj/pink_cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob)
{       ob=this_player();

        if( (string)ob->query("family/family_name") == "水月宫") {
		command("say  大家同门中人，"+ RANK_D->query_respect(ob) +"何必如此多理?\n");
		return;
	}

				command("smile " + ob->query("id"));
                command("say 太好了，巫后娘娘一定会很高兴的,你一定要努力呀。\n");
				command("recruit " + ob->query("id"));
                return ;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) {
                ob->set("class", "yaomo");
        }
}

string expell_me(object me)
{       me=this_player();
        if((string)me->query("family/family_name")=="水月宫") {
                me->set_temp("betray", 1);
                return ("既是要离宫，却需受惩罚，你可愿意(agree)?");
        }
        return (""+RANK_D->query_respect(me) +"不要跟奴家开玩笑了!");
}
void init()
{
::init();
        add_action("do_agree", "agree");
}

int do_agree(string arg)
{
      if(this_player()->query_temp("betray") &&
                  this_player()->query("family/family_name")=="水月宫") {
                message_vision("$N答道：愿意。\n\n", this_player());
                this_player()->add("betray/count", 1);
                this_player()->add("betray/shuiyue", 1);
		this_player()->set("combat_exp", this_player()->query("combat_exp")*95/100);
                this_player()->delete("family");
                this_player()->delete("class");
                this_player()->set("title", "普通百姓");
                this_player()->save();
                command("say 那你去吧！\n");
                return 1;
                }
        return 0;
}

