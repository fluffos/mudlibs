#include <ansi.h>
inherit NPC;
void create()
{
  set_name(HIY"金色凤凰"NOR, ({"feng huang"}));
  set("race", "野兽");
  set("age", 100000);
  set("long", "一只巨大的黄金凤凰。\n");
  set("daoxing", 150000000);

  set("combat_exp", 150000000);
  set("limbs", ({ "头部", "身体", "腿部", "翅膀", "尾巴" }) );
  set("verbs", ({ "bite"}));

   set("max_kee", 10000);
   set("kee", 10000);
  set("max_sen", 20000);
  set("sen", 20000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 200);
  set("mana", 10000);
  set("max_mana", 10000);
  set("mana_factor", 200);

  set_skill("dodge", 1000);
  set_skill("parry", 1000);

  set("bird", 1);

  setup();
}

void init()
{
        object me=this_player();
		::init();
        
if (me->query_temp("get_stone"))
	{
		    kill_ob(me);
			remove_call_out("check");
			call_out("check",1);
	}
}

void check()
{
	 object ob=this_object();
     object me=query_temp("killer");
        if (( ! me )||(! present(me,environment())))
     {
     remove_call_out("check");
	 destruct(ob);
     return;
     }                               
     if (ob->query_temp("last_opponent"))
{
	if (ob->query_temp("last_opponent")!=ob->query_temp("killer"))
	{
		message_vision("只见"+ob->name()+"振起双翅，直冲云霄去了.\n",me);
		destruct(this_object());
		return;
	}

}
if (ob->query_temp("last_damage_from"))
{
    if(ob->query_temp("last_damage_from")!=ob->query_temp("killer")) 
{
     message_vision("只见"+ob->name()+"振起双翅，直冲云霄去了.\n",me);
    destruct(this_object());
	return;
}
}
     switch(random(2))
     {        
        case 0:
        {
        message_vision(YEL"$N振起黄金色的翅膀，沙石带着金色的锐气向$n卷卷而来！\n",ob,me);


       if(random(2)!=0)
                {
              message_vision(YEL"$N被黄金凤凰的双翅打伤，全身像被击穿了一样！\n"NOR,me);
               me->add("eff_kee",-(me->query("max_kee")/10));
               me->add("eff_sen",-(me->query("max_sen")/10));
                }
        else
        message_vision(YEL"$N见势头不妙，猛然间拔地而起，侥幸躲过了这致命的一击！\n"NOR,me);
        }
        break;


        case 1:
        {

        message_vision(YEL"$N挥动双翅，从半空中俯冲下来双爪带着两道银光抓向$n！\n",ob,me);

                if(random(2)!=0)

                {
              message_vision(YEL"$N躲闪不及从肩到腰顿时被抓出数道血痕！\n"NOR,me);
               me->add("eff_kee",-2*me->query("max_kee")/10);
                me->add("eff_sen",-2*me->query("max_sen")/10);
                }
				else
        message_vision(YEL"$N看准时机，奋力向前扑出，金色凤凰的双爪如两道寒光从$N的头顶数寸处呼啸而过！\n"NOR,me);
        }
        break;

        case 2:
        {

        message_vision(HIR"数次攻击未果，$N头顶金翎倒立，全身羽毛泛起淡淡黄光，竟然被$N发出的怒气击得喷射出来。\n",ob,me);

                if(random(3)!=0)

                {
              message_vision(HIR"金翎四面攻来，$N已然无处可躲，全身都被金翎贯穿！\n"NOR,me);
               me->add("eff_sen",-3*me->query("max_sen")/10);
               me->add("eff_kee",-3*me->query("max_kee")/10);
                }
        else
        message_vision(HIR"$N性命悬于一线之间，运劲灌及全身，左躲右闪竟然侥幸闪过致命攻击！\n"NOR,me,ob);
        }
        break;

  }
        remove_call_out("check");
        call_out("check",7+random(3));
}

void die()
{
	object stone;
	object ob = query_temp("killer");
    remove_call_out("check");
	if (!ob)
	{
		destruct (this_object());
		return ;
	}
	message_vision(HIC"\n\n\n金色凤凰朝天一声鸣叫，振起双翅冲天而去，半空中慢慢飘下来一件东西落在$N的脚下！\n\n\n"NOR,ob);
	stone=new("/d/take/obj/stone");
	stone->set_temp("owner",ob);
	stone->move("/d/shuiyue/xianlingdao/xianlingdao_0_6");
	destruct (this_object());
}




