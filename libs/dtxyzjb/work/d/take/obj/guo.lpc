// by take

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
  set_name( HIC"鼠儿果"NOR, ({"shuer guo", "guo"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这种小果子是苗族山岭上的野生果子，味道甘甜可口。\n");
    set("value", 1000);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_put", 1);
    set("food_supply", 50);
    set("food_remaining", 2);
  }
  setup();
}
