void setname()
{
        mapping name;
       string title,temp_title;
       int i;
       i=random(100);
        if(i>68)
            {
                 name=NAME_D->random_name("male");
                temp_title=TITLE_D->random_title("male");
             } 
       else if(i>35)
            {
                 name=NAME_D->random_name("female");
                temp_title=TITLE_D->random_title("female");     
            } 
        else if(i>4)
            {   
                 name=NAME_D->random_name("yaoguai");
               temp_title=TITLE_D->random_title("yaoguai");
              }
        else 
            {   
                name=NAME_D->random_name("japan");
               temp_title=TITLE_D->random_title("japan");
              }
        set_name(name["name"], name["id"]);
        title=COLOR_D->random_color(((random(10)>5)?3:4),((random(10)<8)?0:1))+temp_title+NOR;
        set("title",title);
}

void random_bian()
{
 
       int  i, j, k;
        object newnpc;
        string newnew;
        mixed*  file;

        if( !sizeof(dirs2) )  return;

        i = random(sizeof(dirs2));    // pick up one directory

        file = get_dir( dirs2[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             return;

        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newnew = dirs2[i]+"/"+ file[j][0];
                  newnpc=new(newnew);
                  if(newnpc)
                  {
                  newnpc->move(environment(this_object()));
                  command("bian "+newnpc->query("id") );
                  destruct(newnpc);
                  }
                  else
                  {
                    random_bian();
                    return;
                  }
        if (query("kind") == "变")
                {
            remove_call_out("random_bian");
            call_out("random_bian",60);
                 }
              return;                                
           }
        }
}


void create()
{        
         setname();
         set("age", 14+random(10));
         set("gender", random(2)?"男性":"女性");
         set("attitude", "heroism");
         set("per", 40);
         set("str", 30);
         set("cor", 40);
         set("con", 40);
         set("int", 40);
         set("spi", 40);
         set("cps", 40);
         set("kar", 40);
         set("max_gin", 1000);
         set("food", 10000);
         set("water", 10000);
         set_weight(30000);
         set("no_steal",1);
         set("taskguai2",1);
         set("faith", 1000);
         set_temp("apply/courage",100);
         set("chat_chance",5);
         set("chat_msg", ({
           (: random_move :),
          }));
setup();
       set("inquiry", ([ 
           "心事": (: begin_jiemi :),
        ]) );
}

int random_place(object me, string* dirs)
{
        int  i, j, k;
        object  newob;
        mixed*  file, exit;

        if( !sizeof(dirs) )  return 0;

        i = random(sizeof(dirs));    // pick up one directory

        file = get_dir( dirs[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             return 0;

        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 )
            {
             newob=load_object(dirs[i]+"/"+file[j][0]);
             if (newob)
              {  
               if(newob->query("no_fight") ||
                       newob->query("no_magic") ||
                       newob->query("no_mieyao") ||
                       !(exit=newob->query("exits")) ||
                       sizeof(exit)<1  )
                   continue;
               if(this_object()->move(newob)) 
               {
                   message_vision("$N走了过来。\n",me);
                   return 1;
               }
             }
           }
        }

        return 0;
}

string invocation(object me, int level)
{
        object guai,env;        
        string *dirs, where,guaiid;
        
        dirs=dirs1;
        guai=this_object();
        copy_status(me, level);
        
        set("owner", me);
        set("kind",me->query("rulaitask/kind"));
       set("kind_du",me->query("rulaitask/kind_du"));
        set("level",level);
        if (query("kind") == "解")
        {
        add("str",15);
        set("gudu",1);
       }
        if (query("kind") == "占")
        {
        guaiid=guaiids[random(sizeof(guaiids))];
        set_name((me->query("name")), ({me->query("id")+" "+guaiid,guaiid}));
        set("title",    me->query("title"));
        set("short",    me->query("short"));
        set("long",     me->query("long"));
        set("inquiry", ([ 
           "你是谁": (: ask :),
           "whoareyou": (: ask :),
           "找佛祖": (: ask1 :),
           "zhaofozu": (: ask1 :),
        ]) );
       }
        if (query("kind") == "变")
        {
            if(random(10)>5)
             {
                set("env/wimpy",20);
               } 

        remove_call_out("random_bian");
         call_out("random_bian",0);
       }
        if(!random_place(guai, dirs))  return "没妖怪";
        
        env=environment(guai);
        where=HIB+guai->query("name")+NOR;
          
        if(env)
         where += HIY+MISC_D->find_place(env)+NOR;
        return where;
        
        
}

void copy_status(object me, int level)
{
        mapping me_skill;
        int *skill_value, max_value, i;
        
        me_skill = me->query_skills();
        i=sizeof(me_skill);
        if(i>0) {
                skill_value=values(me_skill);
                max_value=skill_value[0];
                while(i--) { // 找出玩家skill最大值
                    if(skill_value[i]>max_value)
                        max_value=skill_value[i];
                }
          } else max_value=1;
                 
          set_skills(max_value, level);
          
          set_hp_status(me,level);
            
}         
          
void set_skills(int max_value, int level)
{
        object guai=this_object();       
        int guai_value;
        
//      if (level==4) guai_value = max_value+max_value/4;
        guai_value = max_value+max_value/8;
        set_skill("unarmed", guai_value+random(16));
        set_skill("dodge", guai_value+random(16));
        set_skill("parry", guai_value+random(16));
        set_skill("force", guai_value+random(16));
        set_skill("spells", guai_value+20+random(16));
        set_skill("literate", guai_value+random(16));
}       



void set_hp_status(object me, int level)
{       int max_kee,max_sen,skill_force,maximum_mana,maximum_force,exp,daoxing;
        max_kee = me->query("max_kee");
        max_sen = me->query("max_sen");
        skill_force = query_skill("force");
        maximum_mana = me->query("maximum_mana");
        maximum_force = me->query("maximum_force");
        exp = me->query("combat_exp");
        daoxing = me->query("daoxing");
        
//        set("max_force", skill_force*10);
//        set("force", skill_force*20);
        set("force_factor", skill_force/2);
        set("mana_factor", query_skill("spells",1));
        
       if (maximum_mana < maximum_force) maximum_mana=maximum_force;
//      if (level==4)
                set("max_kee", max_kee*4);
                set("eff_kee", max_kee*4);
                set("max_sen", max_sen*4);
                set("eff_sen", max_sen*4);
                set("kee", max_kee*4);
                set("sen", max_sen*4);
                set("max_mana", maximum_mana*10/9);
                set("mana",maximum_mana*20/9);
                set("max_force", maximum_force*10/9);
                set("force",maximum_force*20/9);

                set("combat_exp", exp+exp*1/6+random(exp*1/6));
                set("daoxing", daoxing+daoxing*1/6+random(daoxing*1/6));
                set_temp("apply/armor", 400);
                set_temp("apply/damage", 50);
}

int accept_fight(object ob)
{       
        object me=this_object();
        object guai,guai1,guai2;
        if (ob != owner())
        {
               command("say " + RANK_D->query_self(this_object())
                 + "怎么可能是" + RANK_D->query_respect(ob)
                 + "的对手？\n");
             return 0;
        }       
        else {
              if ( query("kind")!="占" )
                   {
               command("say " + RANK_D->query_self(this_object())
                 + "怎么可能是" + RANK_D->query_respect(ob)
                 + "的对手？\n");
             return 0;
                   }
                else {

                    if(ob->query("rulaitask/leave",1))
                        {
                                command("say 看来你是不到黄河心不死，今天就让你见识一下我的厉害！");
                                command("say 兄弟们，抄家伙！");
                            message_vision(BLU"一阵青烟过后，出现了无数小头目。\n"NOR);
                            guai = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai->set("owner", ob);
                            guai->move(environment(this_object()));
                            guai1 = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai1->set("owner", ob);
                            guai1->move(environment(this_object()));
                            guai2 = new("/d/qujing/lingshan/npc/rulai1/"+list[random(sizeof(list))]);
                       guai2->set("owner", ob);
                            guai2->move(environment(this_object()));
                            guai->copy_status(ob, 3);
                            guai1->copy_status(ob, 2);
                            guai2->copy_status(ob, 1);
                            ob->delete("rulaitask/leave");
                            ob->set_temp("rulaitask/juedou",1);
                            ob->set("rulaitask/guai",guai);
                            ob->set("rulaitask/guai1",guai1);
                            ob->set("rulaitask/guai2",guai2);
                            guai->set("title","二当家");
                            guai1->set("title","三当家");
                            guai2->set("title","四当家");
                             this_object()->kill_ob(ob);
                             guai->kill_ob(ob);
                             guai1->kill_ob(ob);
                             guai2->kill_ob(ob);
                             guai->delete("chat_msg");
                             guai1->delete("chat_msg");
                             guai2->delete("chat_msg");
                             guai->set_leader(this_object());
                             guai1->set_leader(this_object());
                             guai2->set_leader(this_object());
                             guai->command("protect "+this_object()->query("id"));
                             guai1->command("protect "+this_object()->query("id"));
                             guai2->command("protect "+this_object()->query("id"));
                                 return 1;
                        }
                   else {
                                me->command("say 哪里来的妖怪，竟敢变成我的样子！");
                                me->kill_ob(ob);
                                ob->kill_ob(me);
                                return 1;
                        }

                     }
              }                 
}                 

void leave()
{
      if(this_object()) { 
        if(environment())
          message("vision",HIB + name() + 
                  "身子一晃，变成一股青烟仓皇逃窜......\n" NOR,environment());
      }
      return;
}

void unconcious()
{
     object me = owner();
     object ob=this_object();
     if (me->query("rulaitask/kind") == "占"  && ob->query("kind") == "占")
       {
        if( me->query_temp("rulaitask/juedou") )
           {
            ob->remove_all_killer();
            call_out("zhenjia",3);    
            me->delete_temp("rulaitask/juedou");
           }
       }
    ::unconcious();
}


void destruct_ob (object ob)
{
  destruct (ob);
}

void die()
{
        object me = owner();
        object book,dan,dguai1;
        string *dirs,bookname;
        dirs=dirs1;
        me->set("rulaitask/dfail",1);
         if (me->query("rulaitask/kind") == "解" && query("gumu"))
        {
          dguai1=me->query("rulaitask/dguai1");
           if ( dguai1->query("name")==this_object()->query("name") && dguai1->query("id")==this_object()->query("id") )
              {
                me->set("rulaitask/gumukill",1);
             me->delete("rulaitask/dfail");
               }
         }
        if (me->query("rulaitask/kind") == "变"  && query("kind") == "变")
             {
          if(me->query("rulaitask/leave",1))
                {
                  command("bian");
                  message("vision",HIB +"怀中掉下一本经书。\n" NOR,environment());
                  book = new ("/d/qujing/lingshan/npc/rulai2/obj/jingshu");
                  book->move(environment(this_object()));
                  me->delete("rulaitask/leave");
                  bookname=book->query("name");
                  me->set("rulaitask/bookname",bookname);
                }
           else {
               me->delete("rulaitask/dfail");
               leave();
               set("sen", (int)me->query("max_sen"));
               set("kee", (int)me->query("max_kee"));
               set("eff_sen", (int)me->query("max_sen"));
               set("eff_kee", (int)me->query("max_kee"));
               set("mana", (int)me->query("max_mana")*2);
               set("force", (int)me->query("max_force")*2);
               remove_all_killer();
               command("follow none");
//               if (!random_place(this_object(),dirs))
//               tell_object(find_player("huarong"),HIM"小花狗，不见了！\n"NOR);               
               random_place(this_object(),dirs);
               remove_call_out("random_bian");
               call_out("random_bian",0);
               me->set("rulaitask/leave",1);
               return 0;
                }
               me->delete("rulaitask/dfail");
             }  
/*
        if (me->query("rulaitask/kind") == "占"  && query("kind") == "占")
             {
              if (environment())
              message("sound", CYN+query("name")+"说道："+RANK_D->query_self(this_object())+"是杀不死的！\n"NOR, environment());
              this_object()->set_hp_status();
               me->delete("rulaitask/dfail");
            }
*/     
        ::die();
}

void init()
{     
       ::init();
        add_action("do_ji","ji");
        add_action("do_perform","perform");
        add_action("do_tianlong","tianlong");
        add_action("do_cast","cast");
         add_action("do_duhua", "duhua");
         add_action("do_quanhui", "quanhui");
        if(is_fighting())
        {
         remove_call_out("check");
         call_out("check",0);
         }
     if (!owner() || owner()->query("rulaitask/fail") || owner()->query("rulaitask/dfail") ) //huarong 2003.10   
          destruct(this_object());
}

int zhenjia()
{
     object me = owner();
     object ob=this_object();
     object tudi;

     if (me->query("rulaitask/kind") != "占"  || ob->query("kind") != "占") return 0;
     message_vision(CYN"地上冒出一股清烟，从地里钻出一个土地来把"+ob->query("name")+"弄醒了。"NOR,ob);
     tudi = new("/d/qujing/start/tudi/tudi");
     tudi->move(environment(me));
     ob->set("eff_sen", (int)ob->query("max_sen"));
     ob->set("eff_kee", (int)ob->query("max_kee"));

     ob->set("sen", (int)ob->query("max_sen"));
     ob->set("kee", (int)ob->query("max_kee"));

     ob->remove_call_out("revive");
     ob->revive();
     ob->remove_all_killer();
//     all_inventory(environment(ob))->remove_killer(ob);
     me->remove_all_killer();
     ob->delete("chat_msg");     
     me->set_temp("rulaitask/ask",1);
  return 1;
}

string ask()
{
     object me = owner();
     object ob=this_object();
     if (!me->query_temp("rulaitask/ask"))  return 0;
     me->set_temp("rulaitask/ask1",1);
     remove_call_out("ask2");    
     call_out("ask2",2);    
     return "我是"+me->query("name")+"。\n";
}

string ask1()
{
     object me = owner();
     object ob=this_object();
     if (!me->query_temp("rulaitask/ask2"))  return 0;
     message_vision(CYN+ob->query("name")+"说道：找就找，谁怕谁啊？\n"NOR,ob);
     me->set_temp("rulaitask/ask3",1);
     call_out("ask3",3);    
     return "我们这就动身去。\n";
}

void ask2()
{
     object me = owner();
     if (!me->query_temp("rulaitask/ask1"))  return 0;
     message_vision(CYN"$N大怒道：我才是"+me->query("name")+"。\n"NOR,me);
}

void ask3()
{
     object me = owner();
     object ob = this_object();
     if (!me->query_temp("rulaitask/ask3"))  return 0;
     message_vision(HIY+ob->query("name")+"随手一招，踏上一朵白云，飘然而去。\n"NOR,me);
     ob->move("/d/qujing/lingshan/daxiong");
     ob->delete("chat_msg");
}

int begin_jiemi()
{
     object me = owner();
     object ob=this_object();

     if (me->query("rulaitask/kind") != "渡"  || ob->query("kind") != "渡") return 0;
     if (!me->query("rulaitask/du_done") ) return 0;
     remove_call_out("test_player");    
     call_out("test_player",1);    

  return 1;
}


int do_duhua(string arg)
{
        object me =this_player();
        object ob;
        int guai_max_kee,guai_eff_kee;
        
        if(!arg) return notify_fail("你要渡谁？\n");
        ob = present(arg, environment(me));
        if (!ob) return notify_fail("你要渡谁？\n");
        if (me->query("rulaitask/kind") != "渡"  || ob->query("kind") != "渡") return 0;
        
        if (me->is_busy())
             return notify_fail("你正忙着呢。\n");
        
        message_vision(du_say[random(sizeof(du_say))],me);

        if ( !living(ob) )   return notify_fail("很显然，"+ob->name()+"听不见你说的话。\n");
        
        if ( me != ob->query("owner") || !ob->is_fighting(me) )  return 0;

         guai_max_kee = ob->query("max_kee");
         guai_eff_kee = ob->query("eff_kee");
         
         if ( guai_eff_kee*100/guai_max_kee < 10 )
              {
              if ( guai_eff_kee >= 0 )
                {
                    command("say "+ RANK_D->query_respect(me)+ "果然武艺不凡，"+ RANK_D->query_self(ob)+ "佩服。");
                   ob->remove_all_killer();
                  message_vision(CYN"$N说道：只是"+ RANK_D->query_self(ob)+ "尚且有一件"+HIY+"心事"+NOR+CYN+"未了。\n"NOR,ob);
                    command("follow none");
                    me->set("rulaitask/du_done",1);
//                  me->set("rulaitask/accomplish",1);
//                  me->set("rulaitask/end_time",time());
//                  me->delete("rulaitask/dget");
//                 destruct(ob);
                   return 1;
                }
              else
                {
                return 0;
                }
             }
       else 
          {
                      if (query("kind_du") == "情")
                        {
                          message_vision(CYN"$N说道：此番我要大开杀戒，杀尽天下负心之人。\n"NOR,ob);
                          }
                      if (query("kind_du") == "武")
                         {
                          message_vision(CYN"$N说道：老子武功天下第一，谁能胜得过我？\n"NOR,ob);
                          }
                     if (query("kind_du") == "愧")
                         {
                          message_vision(CYN"$N说道：既然大错已铸成，一不做二不休，杀尽天下之人。\n"NOR,ob);
                          }
                      if (query("kind_du") == "仇")
                        {
                          message_vision(CYN"$N说道：宁可我负天下人，天下人不可负我！\n"NOR,ob);
                          }
                    if (query("kind_du") == "名")
                        {
                          message_vision(CYN"$N说道：不管是好是坏，我只要全天下人知道我的大名。杀！杀！杀！\n"NOR,ob);
                          }
                     me->start_busy(1+random(2));
                    return 1;
         }
}

int do_quanhui(string arg)
{
        object me =this_player();
        object ob,dan,env;
        int guai_max_kee,guai_eff_kee;
       string where1;
        
        if(!arg) return notify_fail("你要劝谁？\n");
        ob = present(arg, environment(me));
        if (!ob) return notify_fail("你要劝谁？\n");
        if (me->query("rulaitask/kind") != "占"  || ob->query("kind") != "占") return 0;
        
        if (me->is_busy())
             return notify_fail("你正忙着呢。\n");
        
        me->command("say 汝冒吾之名，我可以不予你计较，回山去吧！");

        if ( !living(ob) )   return notify_fail("很显然，"+ob->name()+"听不见你说的话。\n");
        
        if ( me != ob->query("owner") || !ob->is_fighting(me) )  return 0;

         guai_max_kee = ob->query("max_kee");
         guai_eff_kee = ob->query("eff_kee");
         
         if ( guai_eff_kee*100/guai_max_kee < 25 )
              {
              if ( guai_eff_kee >= 0 )
                {
                  if(me->query("rulaitask/leave",1))
                   {
                    me->delete("rulaitask/leave");
//                  destruct(this_object());
                    }
                  else
                   {
                      command("say "+ RANK_D->query_rude(me)+ "，算你狠，咱们走着瞧！");
                    message_vision(HIY"\n$N撒出一把金沙，顷刻间飞沙走石，连眼都挣不开！\n"NOR,ob);
                    leave();
                    random_place(this_object(),dirs1);
                     this_object()->command("follow none");
                     env=environment(ob);
                     where1 = HIY+MISC_D->find_place(env)+NOR;
                    me->set("rulaitask/where1",where1);
                    dan = new("/d/city/obj/xjdan");
                    dan ->move(this_object());
                    command("eat dan");
                    this_object()->remove_all_killer();
                    me->set("rulaitask/leave",1);
                    me->set_temp("rulaitask/escape",1);
                    return 1;
                   }
                 }
               else
                {
                  return 0;
                 }
               }
            else 
               {
                   message_vision(CYN"$N说道：你这个冒牌货，少来这一套，看招！\n"NOR,ob);
                     me->start_busy(1+random(2));
                    return 1;
                }
                  
}


int do_ji(string arg, object ob)
{
      object me = this_object();
      ob = offensive_target(me);
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(!me->is_fighting(ob) )   return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;
}

int do_perform(string arg,object ob)
{     
      object me = this_object();
      ob = offensive_target(me);
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(member_array(arg,banned_perform)==-1) return 0;
      if(!me->is_fighting(ob) )   return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
    return 1;
 }

int do_tianlong(string arg,object ob)
{
      object me = this_object();
      ob = offensive_target(me);
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(!arg==this_object()->id(arg) ) return 0;
      if(!me->is_fighting(ob) )   return 0;
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;
 }


int do_cast(string arg,object ob)
{     
      object me = this_object();
      string arg1;
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(member_array(arg,banned_cast)==-1) return 0;
      if( sscanf(arg, "%s on %s", arg, arg1)==2 )
             {
                ob = present(arg1, environment(me));
                if(member_array(arg,banned_cast)==-1) return 0;
             }
      message_vision("$N冷笑一声：你想耍什么花样？\n",me);
      return 1;

 }



void heart_beat()
{  
   int free,free1,kee_cost,sen_cost;
   object guai = this_object();
   ::heart_beat();
   free=(int)query_skill("force")/40; 
   free1=(int)query_skill("spells")/10; 
   kee_cost=(free-1)*100;
   sen_cost=(free1-1)*100;
   if ( !is_fighting()
        && !query_skill("zixia-shengong",1)
        && !query("unconcious")
        && query("eff_kee") <  query("max_kee") )
       { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert heal");
               command("exert heal");
               command("exert heal");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.lpc");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");
              }
        }
   if ( !is_fighting()
          && query_skill("zixia-shengong",1)
          && !query("unconcious")
          && query("eff_kee") <  query("max_kee") )
        { 
           if (query("eff_kee") >= query("max_kee") / 2 )
             {
               command("exert ningshen");
               command("exert ningshen");
               command("exert ningshen");
              }
          else
             {
           for (int i=3;i>0;i--) {carry_object("/d/obj/drug/jinchuang-huarong.lpc");}
               command("eat jinchuang yao");
               command("eat jinchuang yao");
               command("eat jinchuang yao");   
             } 
        }
   if ( !is_fighting()
        && !query_skill("jiuyin-xinjing",1)
        && !query("unconcious")
        && query("eff_sen") <  query("max_sen") )
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.lpc");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }

   if ( !is_fighting()
        && query_skill("jiuyin-xinjing",1)
        && !query("unconcious")
        && query("eff_sen") <  query("max_sen") )
       {   if (query("eff_sen") >= query("max_sen") / 2 )
             {
               command("exert jingheal");
               command("exert jingheal");
               command("exert jingheal");
              }
       else
             {
            for (int j=3;j>0;j--) {carry_object("/d/obj/drug/hunyuandan-huarong.lpc");}
               command("eat hunyuan dan");
               command("eat hunyuan dan");
               command("eat hunyuan dan");
              }
       }
   if (is_fighting()  &&  query("force") < query("max_force") )
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
   if (!is_fighting()  &&  query("force") < query("max_force") )
     command("exercise "+kee_cost);   
   if (!is_fighting()  &&  query("mana") < query("max_mana") )
//      command("meditate "+sen_cost);
        command("meditate 1000");
   if (query("kind")=="变" && query_temp("befinded") )
    {
        remove_call_out("random_bian");
         call_out("random_bian",0);
        delete_temp("befinded");
    }

   if (!owner() || owner()->query("rulaitask/dfail") )    
        destruct(guai);


}       

void check2()
{
        int i,k;
        object ob=this_object();
        object me=query_temp("my_killer");
        object weapon,*inv;
        inv=all_inventory(ob);
        i=sizeof(inv);
   
   if(query("family/family_name") == "大雪山")
    {
     if ( ob->query_skill("blade") ) 
       {
         ob->delete_temp("have/blade");  
         for(k=0;k<i;k++) 
          {
            if ( inv[k]->query("skill_type") == "blade" || inv[k]->query("apply/skill_type") == "blade" ) 
            {
             set_temp("have/blade",1);
             }
          }  
        if (!query_temp("have/blade") )
          {
            weapon=new("/d/obj/weapon/blade/iceblade");
            weapon->move(ob);
            message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          }
       }    	
     if ( ob->query_skill("sword") ) 
       {
        ob->delete_temp("have/sword");  
        for(k=0;k<i;k++) 
          {
            if ( inv[k]->query("skill_type") == "sword" || inv[k]->query("apply/skill_type") == "sword" ) 
            {
             set_temp("have/sword",1);
             }
          }  
        if (!query_temp("have/sword") )
          {
            weapon=new("/d/obj/weapon/sword/fenghuangqin");
            weapon->move(ob);
            message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          }
       }   	
    }
   else
    {
      ob->delete_temp("have/weapon");  
      for(k=0;k<i;k++) 
        {
          if ( inv[k]->query("id") == "eighteen weapon" ) 
          {
           set_temp("have/weapon",1);
           }
        }  
      if (!query_temp("have/weapon") )
        {
          weapon=new("/d/obj/weapon/18weapon");
          weapon->move(ob);
          message_vision(HIW "只见白光一闪，$N"+HIW+"的手里多了柄"+weapon->query("name")+"！\n" NOR, ob);
          command("wield weapon");
        }
    }
}



