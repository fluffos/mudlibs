//huoyun妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/d/qujing/lingshan/npc/rulai2/yaoguai/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
       guai_value = max_value+max_value/4;
        
      set_skill("spear", guai_value+random(16));
      set_skill("stick", guai_value+random(16));
      set_skill("dali-bang", guai_value+random(16));
      set_skill("huoyun-qiang", guai_value+random(16));
      set_skill("wuyue-spear", guai_value+random(16));
      set_skill("pingtian-dafa", guai_value+random(16));
      set_skill("moshenbu", guai_value+random(16));
      set_skill("huomoforce", guai_value+random(16));
      set_skill("moyun-shou", guai_value+random(16));
      map_skill("force", "huomoforce");
      map_skill("spells", "pingtian-dafa");
      map_skill("unarmed", "moyun-shou");
      map_skill("spear", "wuyue-spear");
      map_skill("parry", "wuyue-spear");
      map_skill("stick", "dali-bang");
      map_skill("dodge", "moshenbu");
      create_family("火云洞", 1, "弟子");
      carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
      carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object(),newnew;
        object me = owner();
        int i;
        i=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");
        remove_call_out("check2");
        call_out("check2",0);
        command("wield weapon");
        command("exert recover");
        command("perform shenli");
        command("perform zhangxinlei on "+me->query("id"));                               
        command("perform zhangxinlei");                               
 if(me->is_busy())
    {   
    if (i<2)
           {
        map_skill("spear", "huoyun-qiang");
        command("perform lihuo on "+me->query("id"));
        command("perform lihuo");
        map_skill("spear", "wuyue-spear");
           }
    else if(i<5)
           {
        command("perform fengchan on "+me->query("id"));
        command("perform fengchan");
           }
    else if(i<7)
           {
        command("perform buhui on "+me->query("id"));
        command("perform buhui");
           }
    else if(i<8)
           {
        command("perform baiyun on "+me->query("id"));
        command("perform baiyun");
           }
    else
           {
         command("cast sanmei");
            }
        remove_call_out("check");
        call_out("check",4);
    }
  if(!me->is_busy())
    {
        map_skill("spear", "huoyun-qiang");
        command("perform dian on "+me->query("id"));
        command("perform dian");
        map_skill("spear", "wuyue-spear");
        remove_call_out("check");
        call_out("check",2);

    }
}
      



