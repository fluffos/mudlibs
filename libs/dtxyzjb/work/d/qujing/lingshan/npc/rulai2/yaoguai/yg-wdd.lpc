//wdd妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/d/qujing/lingshan/npc/rulai2/yaoguai/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
       guai_value = max_value+max_value/4;
       set("faith", 1000);
       set_skill("stealing", guai_value+random(16));
       set_skill("qixiu-jian", guai_value+random(16));
       set_skill("huntian-qigong", guai_value+random(16));
       set_skill("yaofa", guai_value+random(16));
       set_skill("yinfeng-zhua", guai_value+random(16));
       set_skill("kugu-blade", guai_value+random(16));
       set_skill("sword", guai_value+random(16));
       set_skill("blade", guai_value+random(16));
       map_skill("force", "huntian-qigong");
       map_skill("unarmed", "yinfeng-zhua");
       map_skill("dodge", "kugu-blade");
       map_skill("spells", "yaofa");
       map_skill("parry", "qixiu-jian");
       map_skill("sword", "qixiu-jian");
       map_skill("blade", "kugu-blade");
       create_family("陷空山无底洞", 1, "弟子");
       carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
       carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object();
        object me = owner();
        int i=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");                               
        remove_call_out("check2");
        call_out("check2",0);
        command("wield weapon");

 if(me->is_busy())
    {   
        command("exert recover");
       if(!ob->query_temp("zxzx")) command("perform zxzx");
        command("perform diyu on "+me->query("id"));
     if (i<3)
         {
           command("perform yaowu on "+me->query("id"));
           command("perform yaowu");
         }
     else if (i<5)
         {
           command("perform qijian on "+me->query("id"));
           command("perform qijian");
         }
     else if (i<7)
         {
           command("perform duzun on "+me->query("id"));
           command("perform duzun");
         }
     else   
         {
           command("cast bite");
         }
        remove_call_out("check");
        call_out("check",4);
    }
  if(!me->is_busy())
    {
        command("exert recover");
        command("perform pozhan on "+me->query("id"));
        command("perform pozhan");
        command("perform duo on "+me->query("id"));
        command("perform duo");
        remove_call_out("check");
        call_out("check",3);
    }
}
      


