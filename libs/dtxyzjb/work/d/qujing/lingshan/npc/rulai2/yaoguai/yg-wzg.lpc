//wzg妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/d/qujing/lingshan/npc/rulai2/yaoguai/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value,skill;
        ::set_skills(max_value, level);
        
       guai_value = max_value+max_value/4;
       if( guai_value /2 > 180 )
         skill=guai_value/2;
       else
         skill=180+random(20);
        
       set_skill("wuxing-quan", guai_value+random(16));
       set_skill("baguazhen", guai_value+random(16));
       set_skill("sword", guai_value+random(16));
       set_skill("sanqing-jian", guai_value+random(16));
       set_skill("xiaofeng-sword", guai_value+random(16));
       set_skill("staff", guai_value+random(16));
       set_skill("fumo-zhang", guai_value+random(16));
//     set_skill("hammer", guai_value+random(16));
//     set_skill("kaishan-chui", guai_value+random(16));
       set_skill("blade", guai_value+random(16));
       set_skill("yange-blade", guai_value+random(16));
       set_skill("zhenyuan-force", guai_value+random(16));
       set_skill("taiyi", guai_value+random(16));
       set_skill("zouxiao", skill);
       map_skill("spells", "taiyi");
       map_skill("force", "zhenyuan-force");
       map_skill("unarmed", "wuxing-quan");
       map_skill("sword", "xiaofeng-sword");
       map_skill("parry", "xiaofeng-sword");
       map_skill("dodge", "baguazhen");
       map_skill("staff", "fumo-zhang");
       map_skill("blade", "yange-blade");
       map_skill("hammer", "kaishan-chui");
       create_family("五庄观", 1, "弟子");
       carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
       carry_object("/d/obj/weapon/18weapon.lpc")->wield();
       carry_object("/d/obj/weapon/sword/yudi");
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object();
        object me = owner();
        int i,j;
        i=random(10);
        j=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");                               
        remove_call_out("check2");
        call_out("check2",0);
        command("wield weapon");

 if(me->is_busy())
    {   
        command("exert recover");
        map_skill("sword", "sanqing-jian");
        if(!ob->query_temp("jianmang"))  command("perform jianmang");
        command("perform jianzhang on "+me->query("id"));
        command("perform jianzhang");
    if (i<2)
       {
        command("perform sanqing on "+me->query("id"));
        command("perform sanqing");
       }
    else if (i<4)
       {
        command("perform damoyange on "+me->query("id"));
        command("perform damoyange");
       }
    else if (i<6)
       {
        map_skill("sword", "xiaofeng-sword");
        command("perform jianxiao on "+me->query("id"));
        command("perform jianxiao");
       }
    else if(i<8)
       {
        map_skill("sword", "xiaofeng-sword");
        command("perform huichang on "+me->query("id"));
        command("perform huichang");
       }
    else if(i<9)
       {
        map_skill("sword", "xiaofeng-sword");
        command("perform huaqian on "+me->query("id"));
        command("perform huaqian");
       }
    else
       {
        command("cast zhenhuo on "+me->query("id"));
        command("cast zhenhuo");
       }
       remove_call_out("check");
       call_out("check",4);
    }
  if(!me->is_busy())
    {
    if (j<7)
       {
        command("perform zongheng on "+me->query("id"));
        command("perform zongheng");
       }
    else
       {
        command("enchant max");
        command("cast sanqing on "+me->query("id"));
        command("cast sanqing");
       }
        remove_call_out("check");
        call_out("check",3);

    }
}
      


