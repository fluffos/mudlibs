// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name( HIC "灵玉剑" NOR, ({ "jade sword" ,"sword"}) );
	set_weight(20);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把长剑，是高级剑客常用的武器，是由千年寒铁铸成的。\n");		
		set("unbreak",1);		
		set("value", 120000);
		set("material", "steel");
		//set("grade",5);
		//set("durability/max",145);
		//set("durability/now",145);
		//set("weapon_prop/luck",1);
		//set("sockets/now",0);
		//set("sockets/max",2);
		//set("fire_attack/max_level",4);
		//set("weapon_prop/fire_attack",1);
		//set("fire_attack/exp",1);
	}
	init_sword(121);	
	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int dam,myexp,youexp,exp;    
	dam = (int) me->query("max_force");
	myexp=(int) me->query("combat_exp") + 100;
	youexp=(int)victim->query("combat_exp") + 100;
	dam=dam / 10;	
	if(dam>500) dam=500;
	if(dam<100) dam=100;
	victim->receive_damage("kee", dam);
    victim->receive_wound("kee", dam/2);	
	me->add("combat_exp",(dam+random(dam)));
	me->add("daoxing",dam);
	return notify_fail("\n");	
}
int query_autoload() { return 1; }
 