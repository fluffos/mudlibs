
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIR"玫瑰之路"NOR);
  set ("long", HIR@LONG

 扑满玫瑰的路。
 
LONG NOR);

  set("exits", ([
  "north"   : __DIR__"rose14",
  "east"   : __DIR__"rose1",
  "west"   : __DIR__"rose13",
  "south"   : __DIR__"rose11",
]));
  set("outdoors", 1);

  setup();
}
 void init()
{ object ob;
  if( interactive( ob = this_player()))
  add_action("do_fly", "fly");
  call_out("blowing", random(10) + 1, ob);
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
 {
 tell_object(this_object(), HIR "\n\n周围玫瑰花的香气从你的皮肤中渗入。\n" NOR);
 COMBAT_D->report_status(ob,1);
 ob->receive_wound("kee", random(200)+10);
 if( environment(ob) == this_object())
 call_out("blowing",random(10)+1, ob);
 }
 else
 return 1;
}




