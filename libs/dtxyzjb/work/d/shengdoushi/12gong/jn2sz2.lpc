inherit ROOM;
int valid_leave(object me, string dir);
int block_cmd(string args);
void leave_here(object me) {
   if(me) me->move(__DIR__"szchoose");
}

void create ()
{
        set ("short", "双子宫内");
        set ("long", @LONG

似乎仍然走在往双子宫的路上，你有一丝迷茫。
LONG);


        set("exits", ([
        "eastup"    :       __DIR__"shuangzi",
            "out"  :       __DIR__"door3",
        ]));

        set("outdoors", "12gong");
        setup();
}


int valid_leave(object me, string dir)
{
        if (dir == "eastup" && me->query_temp("12gong/cike") != "done")
	       {
			 
         call_out("leave_here",1,me);
      return notify_fail("你一阵迷茫。\n");
		   }
return ::valid_leave(me, dir);
}

void init()
{
    add_action("block_cmd", "", 1);
}


int block_cmd(string args)
{
string verb;
verb = query_verb();
    if (verb == "recall") return 1;
    return 0;
}
