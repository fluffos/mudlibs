
inherit ROOM;
#include <room.h>

void create ()
{
  set ("short", "圣域入口");
  set ("long", @LONG

 这里是圣域的入口，即圣域竞技场，通向十二宫。
 
LONG);

  set("objects", ([
  "/d/shengdoushi/bang" : 1,
]));
  set("outdoors", __DIR__"");
  set("exits", ([
  "southup" : __DIR__"toby2",
  "northdown" : __DIR__"toby1",
]));


set("valid_startroom", 1);
setup();


}
 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();
 if (wizardp(me)) return 0;

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}

