#include <ansi.h>
inherit ROOM;

void create()
{
	set("short","海边");
	set("long",@LONG
潜水(dive)可以去海底神殿，不过......
LONG
	);

	set("objects",([

	]));
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
void init()
{
        //add_action("do_swim", "swim");
            add_action("do_fly", "fly");
       add_action("do_dive", "dive");
}


int do_fly (string arg)
{
  object me;
  me = this_player();
  if (wizardp(me)) return 0;
  message_vision("只见$N刚向上跳起，马上被宝宝猪用火箭筒打了下来。\n", me); //不能飞。yourking by 2004.7
  tell_object(me,"看来在圣域还是不要乱飞的好……\n");
  return 1;
}

int do_dive()
{       object me, zhou;
    object ridee;
        me=this_player();
   ridee=me->ride();



	    if(( !(zhou=present("bishui zhou", me))
		||(string)zhou->query("unit")!="张")
		&& (string)me->query("family/family_name")!="龙宫"
		&& (string)me->query("family/family_name")!="东海龙宫")

		return notify_fail("你一个猛子扎到水里．．．\n"+
		  "\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");

   if (ridee && ridee->query("under_water")) {
     message_vision(HIY"$N一拍$n的头，连人带马跃入水中。\n"NOR,me,ridee);
     ridee->move("/d/shengdoushi/7hai/maze/haidimigong");
  }

      else  message_vision(HIY "$N一个猛子扎到水中，然后不见了．\n" NOR, me);
                me->move("/d/shengdoushi/7hai/maze/haidimigong");
		message_vision("$N潜了过来。\n",me);
                return 1;
}
