
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"双鱼宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

         C        C
          C      C
         CCCCCCCCCC
           C    C
          C      C
         C        C

LONG NOR);

  set("exits", ([
  "southdown" : __DIR__"bp2sy2",
  "enter" : __DIR__"shuangyu",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




