
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"处女宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

        666 666 666 6
       6   6   6   6 6
           6   6   66
           6   6   6
           6   6  6 6
           6   6  6  6

LONG NOR);

  set("exits", ([
  "northdown" : __DIR__"sz2sn2",
  "enter" : __DIR__"shinu",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




