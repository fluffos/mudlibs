
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"金牛宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

         2             2
         22           22
            2 22222 2
             2     2
             2     2
              22222
              
LONG NOR);

  set("exits", ([
  "northdown" : __DIR__"by2jn2",
  "enter" : __DIR__"jinniu",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




