#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
   object target;
   int num;
  if( me->is_ghost() )
    return notify_fail("做了鬼了，就老实点吧！\n");

  if( me->is_fighting() )
    return notify_fail("战斗中不能应战。\n");

  if (me->query_temp("ask_yingzhan"))
     {
       message_vision("$N消失在一团烟雾之中。\n",me);
       me->move(me->query_temp("yingzhan_place"));
       message_vision("$N出现在大家的面前。\n",me);
       target=me->query_temp("yingzhan_man");
       message_vision("$N对$n大喝一声："+RANK_D->query_rude(target)+"敢到我们的地头上来捣乱！\n",me,target);
       me->kill_ob(target);
       target->kill_ob(me);
       me->delete_temp("yingzhan_man");
       me->delete_temp("no_move");
       me->delete_temp("ask_yingzhan");
       me->delete_temp("yingzhan_place");
       me->set_temp("in_tiaozhan",1);
       return 1;
    }
  if (me->query_temp("12gong/asked_tiaozhan"))
    {
       message_vision(HIY"$N消失在一耀眼的光芒之中。\n"NOR,me);
       me->move("/d/shengdoushi/tz_place");
       message_vision(HIY"$N出现在大家的面前。\n"NOR,me);
       target=me->query_temp("12gong/yingzhan_man");
       target->move("/d/shengdoushi/tz_place");
       num=target->query_temp("12gong/tiaozhan",1);
       "/d/shengdoushi/tz_place"->set_temp("12gong/tiaozhan",num);
       message_vision("$N对$n大喝一声：黄金圣斗士的头衔可不是这么好拿的！\n",me,target);
       me->kill_ob(target);
       target->kill_ob(me);
       me->start_busy(3);
       target->start_busy(3);
       me->delete_temp("12gong/yingzhan_man");
       me->delete_temp("12gong/asked_yingzhan");
       me->set_temp("12gong/in_tiaozhan",1);
       return 1;    	

    }
    return notify_fail("你没有应战的任务。\n");
}

int help(object me)
{
write(@HELP
指令格式 : yingzhan

这个指令让你到指定的地点应战。

HELP
    );
    return 1;
}


