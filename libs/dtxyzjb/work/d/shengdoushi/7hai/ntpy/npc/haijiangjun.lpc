#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();


string *zhaoshi= ({
BLU+"\n∨∨∨"+BLINK+HIY+HBBLU+"魔鹰之爪"+NOR+BLU+"∨∨∨\n"NOR,
YEL+"\n∧∧∧"+BLINK+HIB+HBYEL+"凶狼之牙"+NOR+YEL+"∧∧∧\n"NOR,
MAG+"\n——————"+BLINK+HIG+HBMAG+"蜂后之刺"+NOR+MAG+"——————\n"NOR,
RED+"\n∨∧∨"+BLINK+HIC+HBRED+"蟒蛇之牙"+NOR+RED+"∨∧∨\n"NOR,
HIW+"\n∵∴∵"+BLINK+HIR+HBWHT+"吸血蝙蝠之牙"+NOR+HIW+"∵∴∵\n"NOR,
CYN+"\n☆☆☆"+BLINK+HIW+HBCYN+"巨熊之掌"+NOR+BLU+"☆☆☆\n"NOR,
});

string *dongzuo= ({   
HIC+"$N跳至半空，展翅俯冲而下，一道电光划来。\n"NOR,
HIB+"$N头盔青光绽放，犹如恶狼般急奔而来。\n"NOR,
HIM+"$N右手食指一点，青光万道，如利剑一般飞射而来！\n"NOR,
HIY+"$N单举左手，上之蛇型护腕两眼放光，犹如蟒蛇出洞。\n"NOR,
HIR+"$N双翅一展，周围出现无数的吸血蝙蝠！\n"NOR,
HIW+"$N双臂一沉，仰天咆哮，排山倒海的掌风压将过来！\n"NOR,
});
     
void create()
{
        set_name("斯基拉", ({"hai jiangjun","hai","jiangjun",}));
        set("gender", "男性" );
        set("age", 20);
        set("per", 23);
        set("title",HIY"海将军"HIW"-"HIC"六圣兽"NOR);
        set("long", "他是守护南太平洋之柱的海斗士。\n传说中上半身是美女，下半身却是六头狰狞怪兽的海怪。\n");
        set("combat_exp", 12000000);
        set("douxing",12000000);
        set("attitude", "peaceful");
        set("force", 13000);
        set("max_force", 6500);
        set("force_factor", 200);
        set("max_mana", 6500);
        set("mana", 13000);
        set("mana_factor", 300);
        set_skill("literate", 350);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("sword", 350);
        set_skill("westsword",350);
	set_skill("balei",350);
	set_skill("boxing",350);
        set_skill("baiyang", 350);
        map_skill("sword","westsword");
	map_skill("parry","westsword");
	map_skill("dodge","balei");
        map_skill("unarmed","boxing");
        map_skill("spells","baiyang");
        set("max_kee", 12000);
        set("max_sen", 12000);
        add("armor_prop/armor", 400);
        add("armor_prop/dodge", 200);
        setup();
        carry_object("/d/shengdoushi/7hai/ntpy/obj/linyi")->wear();
}

void destruct_me (object me)
{
  destruct (me);
}

void unconcious()
{
die ();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");
  call_out ("haihuang_appearing",1,ob);
  load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/shengdoushi/7hai/ntpy/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}
void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","burn");
        add_action("do_none","tianlong");

}
int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！\n",me);
        return 1;
} 

int accept_fight(object ob)
{       
     object me=this_object();
     command("say 闲杂人等，在此骚扰，杀无赦！");
     me->kill_ob(ob);
     return 1;
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        int i,j,k,hit;    
     if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     }

     j=random(7);
     
     for (i=1;i<=j;i++)
       {
             k=random(6);
             message_vision(zhaoshi[k], me, ob);
             message_vision(dongzuo[k], me, ob);
        if(random(2))        
                {
                 hit=1;
                 me->add("eff_kee",-query("max_kee")/30);
                 me->add("eff_sen",-query("max_sen")/30);
                }
       }

       if (hit) 
       {
       	message_vision(HIR"$N被打个正着，全身骨头像要粉碎掉一样！\n“波”的吐出一口鲜血，满身疮痍。\n"NOR,me);
        hit=0;
       }
       else
       message_vision(HIG"$N轻而易举的躲过了$n的攻击！\n"NOR,me,ob);             
       
       if( random(7) > 4 )
       powerup();

       remove_call_out("check");
       call_out("check",5+random(2));
}
