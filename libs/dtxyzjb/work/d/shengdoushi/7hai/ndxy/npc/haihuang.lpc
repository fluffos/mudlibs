#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name(HIY"波士顿"NOR, ({ "hai huang", }));
        set("title", HIY"海皇"NOR);
        set("long", "海皇波士顿！\n");
        set("gender", "男性");
        set("age", 18);
        set("attitude", "peaceful");
        set("env/wimpy", 110);
        set("str", 18);
        set("int", 28);
        set("per", 30);
        set("con", 20);
        set("dex", 24);        
        set("max_see", 5000);
        set("max_sen", 3000);
        set("force", 5000);
        set("max_force", 5000);
        set("jiali", 100);
        set("combat_exp", 40000000);
    set_skill("dodge", 10000);
    set_skill("literate", 10000);
        setup();

}
void announce_success (object who)
{
  int i;

  if (who->query("combat_exp") < 2000000)
    return;
  if (who->query("7hai/ndxy") == "done")
    return;
  i = random(600);
  if (who->query("7hai/ndxy") == "ok")
  who->add("7hai/number",1);
  who->set("7hai/ndxy","done");
  who->add("7hai/number",1);
  who->add("combat_exp",i+3000);
  command("chat "+HIM+who->query("name")+HIC"把支撑南大西洋的柱子推倒了！"NOR);
  tell_object (who,"你赢得了"+chinese_number(i+3000)+"点武学！\n");
  who->save();
}
