#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();

string *death_msg = ({  
        HIW "崔判官向你招招手，说道：新来的，你莫乱跑，画了生死簿，我好送你还阳。\n\n" NOR,
        HIW "崔判官看着你笑了笑，说道：生死有命，你也不要太难过了。\n\n" NOR,
        HIW "崔判官从怀中拿出一个黑底白字的册子翻看着。。。\n\n" NOR,
        HIW "崔判官合上册子，说道：命不该死，多留无益，我这便送你还阳去吧！\n\n" NOR,
        HIW "崔判官伸手向你一指，你的魂魄又回到了自己身上。。。\n\n"
                "一股阴冷的浓雾突然出现，很快地包围了你。\n\n" NOR,
});

void create()
{
        set_name("隆奈狄斯", ({"hai jiangjun","hai","jiangjun"}));
        set("gender", "男性" );
        set("age", 20);
        set("title",HIY"海将军"HIW"-"HIC"水妖"NOR);
        set("long", "他是守护南冰洋之柱的海斗士。\n");
        set("combat_exp", 15000000);
        set("daoxing",15000000);
        set("attitude", "peaceful");
        set("force", 15000);
        set("max_force", 7500);
        set("force_factor", 200);
        set("max_mana", 7500);
        set("mana", 15000);
        set("mana_factor", 200);
        set_skill("literate", 350);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("sword", 350);
        set_skill("dragonforce",350);
        set_skill("westsword",350);
	set_skill("balei",350);
	set_skill("boxing",350);
        set_skill("baiyang", 350);
        map_skill("sword","westsword");
	map_skill("parry","westsword");
	map_skill("dodge","balei");
        map_skill("unarmed","boxing");
        map_skill("spells","baiyang");
        map_skill("force","dragonforce");
        set("max_kee", 15000);
        set("max_sen", 15000);
        add("armor_prop/armor", 400);
        add("armor_prop/dodge", 200);
        setup();
        carry_object("/d/shengdoushi/7hai/nby/obj/linyi")->wear();
}

void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");
  call_out ("haihuang_appearing",1,ob);
  load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/shengdoushi/7hai/nby/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}

void init()
{
        object ob;
        if (interactive(ob = this_player()) && !is_fighting()) {
        	start_busy(10);
        	ob->start_busy(10);
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
   }
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","burn");
        add_action("do_none","tianlong");

}

void greeting(object me)
{
//    me=this_player();
    message("vision", "筱勰走了过来。\n",me);
    message("vision", HIW"你和筱勰一碰面，二话不说就打了起来！\n"NOR,me);
    message("vision", RED"筱勰目不转睛地盯着你，准备发出致命一击。\n\n\n"NOR,me);
    call_out("greeting2", 2, me);
}

void greeting2(object me)
{
    message("vision", HIW "筱勰使出剑术绝技中最强的" + HIC "筱勰夺命剑" +HIW "，你只觉得眼前一花，咽喉已被对穿而过！！！\n\n"NOR,me) ;
    message("vision", HIR"一股血箭喷涌而出．．你的眼睛死鱼般的突了出来．．\n\n"NOR,me);
    message("vision", "你死了。\n"NOR,me);
    message("vision", HIM"【空穴来风】某人："+me->name()+"莫名其妙地死了。\n"NOR,me);
    message("vision", HIW"阴阳界 "NOR"- \n",me);
    message("vision", "隐约北方现出一座黑色城楼，光线太暗，看不大清楚。许多亡魂正
哭哭啼啼地列队前进，因为一进鬼门关就无法再回阳间了。周围尺
高的野草随风摇摆，草中发出呼呼的风声。\n",me);
    message("vision", "\n这里明显的出口是 "HIG"north、east、west "NOR"和"HIG" south。\n\n"NOR,me);
    message("vision", HIW"朱笔判官 崔珏"NOR"(Cui jue)\n",me);
    call_out( "death_stage", 5, me,0 );
}

void death_stage(object ob, int stage)
{
        tell_object(ob, death_msg[stage]);
        if( ++stage < sizeof(death_msg) )
         {
                call_out( "death_stage", 5, ob, stage );
                return;
         }
}        

int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n",me);
        return 1;
} 

int accept_fight(object ob)
{       
     object me=this_object();
     command("say 闲杂人等，在此骚扰，杀无赦！");
     me->kill_ob(ob);
     return 1;
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
     if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     }

     switch(random(2))
     {        
        case 0:
        {
        message_vision(HIC"$N：尝尝水怪的绝招吧！\n",ob,me);
        message_vision(HIW+"\n\n\t\t\t "+BLINK+"雷电神爪 \n\n"NOR,me);
        if(random(2))        
                {
                 message_vision(HIR"$N为对方所迷惑，目瞪口呆之中，被抓了个正着！\n"NOR,me);
                 me->add("eff_kee",-query("max_kee")/15);
                 me->add("eff_sen",-query("max_sen")/15);
                }
        else
        message_vision(HIG"$N轻而易举的躲过了$n的攻击！\n"NOR,me,ob);
        }
        break;
      }

            
       if( random(7) > 4 )
       powerup();

       remove_call_out("check");
       call_out("check",5+random(2));
}
