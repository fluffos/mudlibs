inherit ROOM;
void create()
{
	set("short", "石桥");
        set("long", @LONG
    说是小桥，却没有栏杆，只不过是条用青石铺成的略略高于水面的石路
罢了。弯弯折折，直延到荷花荡里。桥边，几片荷叶（lotus-leaf）随波浮荡，
十分可爱。

LONG
);
        set("exits",([
