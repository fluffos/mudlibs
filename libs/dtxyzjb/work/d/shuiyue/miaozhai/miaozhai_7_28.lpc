#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小溪尽头");
        set("long", @LONG
     小溪渐渐变宽,竟然一直延伸到一片大海边,海天相接的地方隐隐的有
个小岛,周围没有渡船,不知道能不能游过去(swim).
LONG
);
        set("exits",([
	"southwest" : __DIR__"miaozhai_9_26",
        ]));
set("outdoors","miaozhai");
        setup();
//        replace_program(ROOM);
}

void init()
{
    add_action("do_swim", "swim");
}
 
int do_swim()
{
    object me;
    me=this_player();
   if (me->is_busy() || me->query_temp("pending"))
          return notify_fail("你现在正忙着呢。\n");
    message_vision(HIY "$N跃入海中，没想到海水冰凉刺骨，$N咬着牙向小岛游去。\n" NOR, me);
   me->move(__DIR__"miaozhai_6_30");
    message_vision(HIY "只见$N浑身湿漉漉地从海中里游了上来。\n" NOR, me);
    me->receive_damage("kee", 300);
 me->receive_damage("sen", 300);
   return 1;
}
