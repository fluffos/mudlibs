#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "竹林深处");
        set("long", @LONG
    竹林深处，隐隐约约站着一位白苗族打扮的将军，有条小道被她挡着。
看起来好像是守着这片竹林的，不知道她身后的小道是通向哪里去的路，
也许应该问问她[过路]的情况。

LONG
);
        set("exits",([
	"south" : __DIR__"miaozhai_21_6",
	"northeast" : __DIR__"miaozhai_17_8",

        ]));
   set("objects", ([
       "/d/take/npc/gailuojiao"   :1,]));
        setup();
//        replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if ( dir == "northeast" &&  present("gai luojiao") && !me->query("shuiyue/go"))
	        return notify_fail("盖罗娇伸手挡住了你：你要到哪里去？\n");
        if ( dir == "northeast" && !me->query("shuiyue/go") && me->query("family/family_name")=="水月宫")
 	        return notify_fail("盖将军不在你不能乱闯。\n");
		return ::valid_leave(me, dir);
}
