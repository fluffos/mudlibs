// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
   set_name(HIW"冰魔剑"NOR, ({"bingmo sword", "sword",  "jian", "bingmojian", }) );
   set_weight(1000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "把");
     set("value", 0);
     set("no_sell", 1);
     set("no_give", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("long", "一把白色透明的细长宝剑，当你仔细观看时，隐隐发现剑身散发出淡淡的冰寒黑气。\n");
     set("wield_msg", "$N「唰」地一声抽出一把$n握在手中．顿时$N身上笼罩着层层阴寒之气。\n");
     set("unequip_msg", "$N将手中的$n盘入腰间，顿时云开雾散。\n");
   }
   init_sword(80);
   setup();
}
