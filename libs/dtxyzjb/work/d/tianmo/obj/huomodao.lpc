// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
   set_name(HIR"火魔刀"NOR, ({"huomo dao", "huomodao",  "dao", "blade", }) );
   set_weight(1000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("value", 0);
     set("no_sell", 1);
     set("no_give", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("long", "这是一柄火红色的弯刀，看刀身是弯弯的圆形,但却让人看上去更觉得象是一团火。\n");
     set("wield_msg", "$N的脸上突然变得象火一样红，再看时，手中原来已多了一柄弯弯的$n。\n");
     set("unequip_msg", "$N反手将$n插会鞘中，脸色顿时恢复正常了。\n");
   }
   init_blade(80);
   setup();
}
