inherit ROOM;

void create ()
{
  set ("short", "琴室");
  set ("long", @LONG
  
一间简单得不能再简单的房间，中间放置了一个檀香炉，靠墙
摆放了一张檀木桌，上面空空如也，但可以看出来，好象是放
置什么乐器的，除此之外，桌正对的墙上摆放了一张《抚琴图
》(picture)画的是天魔老祖弹琴的样子，也不知道是谁画的，
简直太象了。
LONG);

  set("objects", ([ /* sizeof() == 1 */
    __DIR__"npc/table" : 1,
]));

  set("item_desc", ([ /* sizeof() == 1 */
  "picture" : "一张天魔老祖的画像，底下隐隐约约可以看到几个小字，你仔细
看来，好象是《抚琴图》三个字。
画中的天魔老祖端坐桌前，十指轻弹一张古琴，你虽未亲临，但
也似乎听到了古琴的琴音。
",
]));
  set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"bdoor",
]));
  setup();
}
void init()
{
	add_action("do_put", "put");
}
int do_put(string arg)
{
        object mishi, ob, me;
	me=this_player();
	if( !arg )
		return notify_fail("你要放什么东西？\n");

	if( !arg || arg!="gu qin" || !(ob=present(arg, me)) )
		return notify_fail("在这里放这样的东西不合适吧。\n");


        if( !(mishi = find_object(__DIR__"mishi")) )
                mishi = load_object(__DIR__"mishi");

        if( mishi = find_object(__DIR__"mishi") ) 
        {
                set("exits/enter", __DIR__"mishi");
                message_vision("$N将古琴放在了檀木桌上，这是对面的墙上发出了隆隆巨响，只见墙壁中间裂开了一个大缝。\n", me, ob);
                message("vision", "墙壁被人从外面打开了。。\n", mishi );
		mishi->set("exits/out", __DIR__"qinshi");
		destruct(ob);
        call_out("close_down", 10);
	}
	return 1;
}

void close_down()
{
        object mishi;

        message("vision", "墙壁轰地一声又恢复到了原状。\n", this_object() );
        if( mishi= find_object(__DIR__"mishi")) {
        message("vision", "墙壁轰地一声又恢复到了原状。\n", mishi);
        mishi->delete("exits/out");
        }

        delete("exits/enter");

}

