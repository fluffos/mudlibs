//puti.c
inherit NPC;
inherit F_MASTER;
string expell_me(object me);
void create()
{
       set_name("冰魔使", ({"bing moshi", "master", "bingmoshi","moshi"}));
       set("long", "冰魔使是天魔老祖手下二弟子，虽是二弟子，但由于做事谨慎，
心思慎密，故极得天魔老祖的信任，如果天魔老祖闭关的话，都是由她来发号司令\n");
       set("gender", "女性");
   set("title", "魔宫冰使");
   set("class", "yaomo");
       set("age", 28);
       set("attitude", "friendly");
       set("shen_type", 1);
       set("rank_info/respect", "小女子");
       set("per", 30);
   set("int", 30);
   set("str", 30);
   set("cps", 30);
       set("max_kee", 1100);
       set("max_gin", 1100);
       set("max_sen", 1100);
       set("force", 2300);
       set("max_force", 1200);
       set("force_factor", 80);
       set("max_mana", 1200);
       set("mana", 2300);
       set("mana_factor", 60);
       set("combat_exp", 800000);
       set("daoxing", 800000);

        set("eff_dx", 250000);
        set("nkgain", 400);

       set_skill("unarmed", 120);
       set_skill("dodge", 120);
       set_skill("parry", 120);
   set_skill("sword", 120);
   set_skill("spells", 120);
   set_skill("tianmo-dafa", 120);
   set_skill("tianmo-zhang", 120);
   set_skill("tianmo-force", 120);
   set_skill("force", 120);
   set_skill("bingmo-sword", 120);
   set_skill("tianmostep", 120);
   map_skill("spells", "tianmo-dafa");
   map_skill("unarmed", "tianmo-zhang");
   map_skill("force", "tianmo-force");
   map_skill("stick", "bingmo-sword");
   map_skill("parry", "bingmo-sword");
   map_skill("dodge", "tianmostep");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
     (: cast_spell, "shihun" :),
        }) );

        set("inquiry", ([
     "离开": (: expell_me :),
     "leave": (: expell_me :),
]) );

create_family("天魔宫", 2, "弟子");
setup();

        carry_object("/d/tianmo/obj/luoyi")->wear();
        carry_object("/d/tianmo/obj/bingmosword")->wield();
}

void attempt_apprentice(object ob)
{
   if ( (string)ob->query("family/family_name")=="天魔宫") {
   if (((int)ob->query("combat_exp") < 120000 )) {
   command("say 要做我的徒弟，道行太低可不行" + RANK_D->query_respect(ob) + "练练再来吧。\n");
   return;
   }
        command("nod");
   command("say 不错，不错，跟我学的话，一定可以学到好东西的。\n");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必胜为师。\n");
       command("recruit " + ob->query("id") );
   return;
   }
   command("shake");
   command("say 你不是本宫人士，" + RANK_D->query_respect(ob) + "还是另投明师吧！\n");
        return;
}
string expell_me(object me)
{       me=this_player();
        if((string)me->query("family/family_name")=="天魔宫") {
                command("say 你既是执意离开，为师有话要说在前头。");
                me->set_temp("betray", 1);
     command("say 我天魔宫虽不是什么好地方，但也不能随你要来就来，要走就走！");
                return ("既是要离开，就一定要接受本宫的惩罚，你可愿意(agree)?");
        }
        return ("我不知道。");
}
void init()
{
::init();
        add_action("do_agree", "agree");
}

int do_agree(string arg)
{
        if(this_player()->query_temp("betray")) {
                message_vision("$N答道：弟子愿意。\n\n", this_player());
     this_player()->add("betray/count", 1);
     this_player()->add("betray/tianmo", 1);
                command("say 既是我天魔宫不能留住阁下，你就请快快离开吧！");
this_player()->set("combat_exp", this_player()->query("combat_exp")*95/100);
                this_player()->delete("family");
                this_player()->delete("class");
                this_player()->set("title", "普通百姓");
     this_player()->save();
                command("say 我们毕竟有师徒之谊，记住江湖风波，善恶无形，你好自为之。。。\n");
                return 1;
                }
        return 0;
}
