//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(0);

    // 迷宫进入要求最高等级。
    set_enter_max_level(10);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0502");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0502/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(100);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0502/boss");

    //迷宫的单边长
    set_maze_long(8);

    //入口方向(出口在对面)
    set_entry_dir("east");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/xueshan/xueshan1");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/xueshan/xueshan1");

    //入口房间短描述
    set_entry_short("试炼之地入口");

    //入口房间描述
    set_entry_desc(@LONG
这里就是封印之地了，内部都是各大派镇压的邪魔，洞口设有封印。
众邪魔皆不敢越雷池一步，于是这里便成为各门派弟子锻炼身手之地了。
LONG
);

    //BOSS房间短描述
    set_exit_short("封印天碑");

    //BOSS房间描述
    set_exit_desc("这里是试炼之地的最深处，相传这里被封印着一柄通灵神兵。");

    //迷宫房间的短描述
    set_maze_room_short("试炼之地");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
这里就是试炼之地了，内部都是各大派镇压的邪魔，洞口设有封印。
众邪魔皆不敢越雷池一步，于是这里便成为各门派弟子锻炼身手之地了。
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}