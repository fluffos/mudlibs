//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(2);

    // 迷宫进入要求最高等级。
    set_enter_max_level(2);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0003");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0003/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(70);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0003/boss");

    //迷宫的单边长
    set_maze_long(8);

    //入口方向(出口在对面)
    set_entry_dir("south");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/changan/eastseashore");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/changan/eastseashore");

    //入口房间短描述
    set_entry_short("镇魔塔林入口");

    //入口房间描述
    set_entry_desc(@LONG
四周是无边无际的海洋，海水到了这里似乎陷了下去，亿万吨的海水倾倒而下，
海水塌陷形成了一片庞大的真空，真空中漂浮着无数的佛塔，佛塔有大有小，似乎
还能看见佛塔底座还有鲜血流出，靠近仔细看居然发现每坐佛塔上印有不少文字
  邪魔至尊镇压于此塔   三万魔头镇压于此塔
  域外天魔镇压于此塔   洪荒十二神魔镇压于此塔
…… 这里上万座漂浮的佛塔居然都镇压着无上魔气的邪魔！ 
远处塔林中心居然还耸立着一座巨大的佛塔!极远眺望都能看见佛塔上
数不清的咒文、封印！                      
LONG
);

    //BOSS房间短描述
    set_exit_short("塔林中心");

    //BOSS房间描述
    set_exit_desc("这里便是塔林中心了，眼前高高耸立着一座巨大的佛塔，佛塔上写着八个大字。     
              \n
              无  天  佛  祖  镇  压  于  此
\n
下面还有行小字写着：魔罗无天本为佛教阿米托佛座下护法大圣，奈何其心存邪念
离经判道，欲一统三界而毁灭洪荒。此魔神通广大,我佛如来联合三大古佛靠着十七
颗佛祖舍利的威力才将无天封印于此。入塔林者切不可放出此魔！切忌！切忌！
");

    //迷宫房间的短描述
    set_maze_room_short("镇魔塔林");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
四周是无边无际的海洋，海水到了这里似乎陷了下去，亿万吨的海水倾倒而下，
海水塌陷形成了一片庞大的真空，真空中漂浮着无数的佛塔，佛塔有大有小，似乎
还能看见佛塔底座还有鲜血流出，靠近仔细看居然发现每坐佛塔上印有不少文字
  邪魔至尊镇压于此塔   三万魔头镇压于此塔
  域外天魔镇压于此塔   洪荒十二神魔镇压于此塔
…… 这里上万座漂浮的佛塔居然都镇压着无上魔气的邪魔！ 
远处塔林中心居然还耸立着一座巨大的佛塔!极远眺望都能看见佛塔上
数不清的咒文、封印！                      
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}