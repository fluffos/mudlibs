//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(1);

    // 迷宫进入要求最高等级。
    set_enter_max_level(1);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0002");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0002/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(70);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0002/boss");

    //迷宫的单边长
    set_maze_long(7);

    //入口方向(出口在对面)
    set_entry_dir("west");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/dntg/sky/dadao1");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/dntg/sky/dadao1");

    //入口房间短描述
    set_entry_short("天外天入口");

    //入口房间描述
    set_entry_desc(@LONG
四周混沌一片，不时有道道亮光呼啸而过，远处随处可以看见星球与
星球发生碰撞时发出的强光和巨大声响，这里便是盘古还未开辟的天
外天空间。似乎从极远的地方传来阵阵强大的能量波动。
LONG
);

    //BOSS房间短描述
    set_exit_short("黑洞");

    //BOSS房间描述
    set_exit_desc("这里就是天外天的中心了，眼前的一幕让你头皮发麻，巨大的黑洞吞噬着一切。");

    //迷宫房间的短描述
    set_maze_room_short("天外天");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
四周混沌一片，不时有道道亮光呼啸而过，远处随处可以看见星球与
星球发生碰撞时发出的强光和巨大声响，这里便是盘古还未开辟的天
外天空间。似乎从极远的地方传来阵阵强大的能量波动。
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}