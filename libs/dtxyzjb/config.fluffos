###############################################################################
#                      MudOS 0.9.20定制运行设置文件                            #
###############################################################################
# 注意: 所有的罗列在这里的路径都是和这个mudlib目录有关的，除了                   #
#       mudlib目录和binaries目录，其余所指路径均为相对路径。                    #
# 	 由#开头的行是被忽略的，与.c文件中//具有相同效果。                        #
###############################################################################
 
# 这个MUD的名字
name : 大唐西游指间版
 
# 允许用户登陆的端口号
port number : 40267

# mudlib的绝对路径
mudlib directory : /home/sunyc/src/mudlib/libs/dtxyzjb/work

# debug.log 和作者/区域纪录存放位置
log directory : /log

# 用来查询#include <...>的路径（文件包含的头文件目录）
# 如果有多个目录，它们之间用':'来分隔
include directories : /include
 
# 存储binaries的目录.  (如果BINARIES已经被定义了。)
save binaries directory : /binaries
 
# 定义了Master物件的文件。
master file : /adm/obj/master

# 被自动包含的全局定义文件。 
global include file : <globals.h>

# 定义所有的全局外部仿真函数的文件。
simulated efun file : /adm/obj/simul_efun
 
# 清出物件的文件; 如果交换时间为0则不启用
swap file : /adm/tmp/swapfile
 
# 交替的 debug.log 文件名 (假定被指定在'log 目录')
debug log file : debug.log

# 如果一个物件被left alone了一段确定的时间, 那么clean_up函数将被呼叫.
# 这个函数可以做任何事。比如说摧毁那个物件。如果这个函数没有被那个物件定义，
# 那么，什么事都不会发生。
# 这个时间必须远大于swapping time.
time to clean up : 20000
 
# 一个未用到的物件将在多长时间后清出内存。
# 玩家多而内存小的服务器: 900 (15 分钟一次)
# 玩家少而内存大的服务器: 10000
# 如果有无限内存的服务器：0（永不清除）
time to swap : 10000 
 
# 多长时间内物件将被重置.
time to reset : 900
 
# 定义二进制域内所包含数值的最大数量，二进制数值将储存在可输出的字符串中，
# 每字节可以储存六位。
maximum bits in a bitfield : 1200
 
# 在一个函数钟的本地变量最大数目
maximum local variables : 40
 
# 定义 每个线程中 eval cost 的最大数量，当运行中值超过该数目时
# 将停止运行。
# 鉴于服务器负担沉重，将此数值放大以度过难关
# maximum evaluation cost : 100000
maximum evaluation cost : 600000
 
# 最大数组大小。
maximum array size : 30000

# 最大的 'buffer'大小。
maximum buffer size : 500000
 
# 映射的最大值
maximum mapping size : 30000
 
# 最大继承链大小
inherit chain size : 60
 
# 字符变量的最大值
maximum string length : 300000
 
#  'read_file()'函数允许阅读的最大文件大小.
maximum read file size : 400000
 
# 允许使用read_bytes 和write_bytes读写的最大字节数目
maximum byte transfer : 50000
 
# 定义保留的内存空间的大小，保留一块额外的内存能缓解内存溢出
# 如果定义为 0 则不保留额外的内存
reserved size : 0
 
# 定义共享字符串散列表的大小
# 此数值应当是一个素数，推荐在 1000 到 30000 之间
# 如果你将其设置为接近使用的不同字符数的五分之一，你将得到一接近于 1 的
# 几率(比较标记来查找字符)，同时被找到的字符将自动被提取到表头
# 由于不需要过大的数值，建议你使用一个较小的表
hash table size : 7001
 
# 定义对象散列表的大小
# 定义此数值和以上定义的字符串散列表内容相似
# 如果将此数值设置成大约游戏中物件数目四分之一的值，作为分配存取的对象将
# 比字符串更加统一
object table size : 1501
 
# 缺省的无匹配指令动作时的输出信息
default fail message : 你要输入什么？

# 偶然发生的错误的缺省信息（可选项）
default error message : [1;33m系统局部错误，请向巫师汇报。[2;37;0m

###############################################################################
#          下列各项还没有普遍运用或执行                                         #
###############################################################################

# 最大用户数量
maximum users : 100

# 定义用于堆栈机器的最大堆栈大小. 
# 这个堆栈也能够包含所有本地的局部变量variables和参数arguments.(没有普遍运用)
evaluator stack size : 1000
 
# 定义编译器堆栈的大小。 这个定义能综合编译器能够分析的表达式.  (没有普遍运用)
compiler stack size : 300
 
# 定义函数的最大呼叫深度 (没有普遍运用)
maximum call depth : 30

# 这是一个用于生物的hash table, 由find_living()函数使用.
# (没有普遍运用)
living hash table size : 100

