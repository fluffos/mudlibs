// lady.c

inherit NPC;

void create() {
  set_name("妇人", ({ "lady" }));
  set("long", "一个衣饰华丽的妇人正跪在这里虔诚地膜拜著。\n");
  set("age", 32);
  set("gender", "女性");
  set("attitude", "peaceful");
  set("combat_exp", 10);
  set("env/wimpy", 100);
  setup();
  {
    object carried_ob = carry_object(__DIR__ "obj/lady_dress");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object(__DIR__ "obj/silver_clasp");
    if (carried_ob) carried_ob->wear();
  }
  add_money("silver", 10);
}
