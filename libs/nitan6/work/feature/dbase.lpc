// dbase.c

#include <dbase.h>

inherit F_TREEMAP;

mapping dbase = ([]);
nosave mapping tmp_dbase = ([]);

// The default_ob provides the default values of the dbase. It is set to
// be master copy of an object.
nosave mixed default_ob = 0;

// set/query/delete (+ _temp variants) were only ever defined in the
// simul_efun object's own wizard.lpc, as bare global functions. That is
// broken for the overwhelmingly common calling convention used across this
// mudlib (`query(prop, ob)` with an explicit target object -- 35000+ call
// sites; `set(prop, data, ob)` -- 4000+): a bare call to an undefined-
// locally function resolves as a genuine simul_efun call on this driver,
// and per FluffOS's call_direct(), current_object (and so this_object())
// becomes the SIMUL_EFUN OBJECT itself for the duration of that call, not
// the original caller. Every object that relies on the simul_efun's
// wizard.lpc set()/query() for its own bare (self, no `ob`) calls -- which
// is every character/room/item inheriting F_DBASE without its own local
// override, i.e. nearly everything -- was actually reading/writing the
// simul_efun's own single shared `dbase`, not its own: confirmed
// empirically (see AGENTS.md) with a two-object lpcc test where a value
// set by one object was visible, unset, on another.
//
// The real fix: define set/query/delete directly HERE, so every object
// that inherits F_DBASE gets them as genuine local (inherited) functions
// -- bare calls from any feature file composed into that object's program
// then resolve locally against ITS OWN `dbase`, never touching the
// simul_efun at all. The optional trailing `ob` argument, when given and
// not this_object(), redirects via call_other to that object's own copy
// of these same functions (which is a perfectly ordinary call_other,
// current_object becomes `ob` correctly, no simul_efun involved).
varargs mixed set(string prop, mixed data, object ob)
{
        if( ob && ob != this_object() )
                return ob->set(prop, data);

        if( !mapp(dbase) ) dbase = ([]);

        if( strsrch(prop, '/') != -1 )
                return _set( dbase, explode(prop, "/"), data );

        return dbase[prop] = data;
}

// Second positional argument does double duty across call sites: an int
// "raw" flag (skip evaluate()), or a target object to redirect to -- see
// the `set` comment above for why bare set/query can't just always take a
// separate `ob` param and call it a day (most callers never pass one).
varargs mixed query(string prop, mixed raw_or_ob)
{
        mixed data;
        object ob;
        int raw;

        if( objectp(raw_or_ob) )
                ob = raw_or_ob;
        else
                raw = raw_or_ob;

        if( ob && ob != this_object() )
                return ob->query(prop);

        if( !mapp(dbase) ) return 0;

        if( undefinedp(dbase[prop]) && (strsrch(prop, '/')!=-1) )
                data = _query(dbase, explode(prop, "/"));
        else
                data = dbase[prop];

        if( undefinedp(data) && default_ob )
                data = default_ob->query(prop, 1);

        if( raw ) return data;

        return evaluate( data, this_object() );
}

varargs int delete(string prop, object ob)
{
        if( ob && ob != this_object() )
                return ob->delete(prop);

        if( !mapp(dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                return _delete(dbase, explode(prop, "/"));
        else {
                map_delete(dbase, prop);
                return 1;
        }
}

varargs mixed set_temp(string prop, mixed data, object ob)
{
        if( ob && ob != this_object() )
                return ob->set_temp(prop, data);

        if( !mapp(tmp_dbase) ) tmp_dbase = ([]);

        if( strsrch(prop, '/') != -1 )
                return _set( tmp_dbase, explode(prop, "/"), data );

        return tmp_dbase[prop] = data;
}

varargs mixed query_temp(string prop, mixed raw_or_ob)
{
        mixed data;
        object ob;
        int raw;

        if( objectp(raw_or_ob) )
                ob = raw_or_ob;
        else
                raw = raw_or_ob;

        if( ob && ob != this_object() )
                return ob->query_temp(prop);

        if( !mapp(tmp_dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                data = _query(tmp_dbase, explode(prop, "/"));
        else
                data = tmp_dbase[prop];

        if( functionp(data) && !raw )
                return (*data)( this_object() );
        else
                return data;
}

varargs int delete_temp(string prop, object ob)
{
        if( ob && ob != this_object() )
                return ob->delete_temp(prop);

        if( !mapp(tmp_dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                return _delete(tmp_dbase, explode(prop, "/"));
        else {
                map_delete(tmp_dbase, prop);
                return 1;
        }
}

mixed query_default_object() { return default_ob; }

void set_default_object(mixed ob)
{
        // if( geteuid(previous_object()) != ROOT_UID )
        //      error("dbase: Only this_object() or object with root euid can set default_ob.\n");
        if( !geteuid() ) seteuid(getuid());

        if( stringp(ob) ) ob = get_object(ob);

        if( objectp(ob) )
        {
                default_ob = ob;
                set("no_clean_up", 1, ob);
                set("shadow_ob", ob);
        }
}

mixed add(string prop, mixed data)
{
        mixed old;

        if( !mapp(dbase) || !(old = query(prop)) )
                return set(prop, data);

        if( functionp(old) )
                error("dbase: add() - called on a function type property.\n");

        return set(prop, old + data);
}

mapping query_entire_dbase()
{
        // if( (previous_object() != this_object())
        // &&  (geteuid(previous_object()) != ROOT_UID) )
        //      error("dbase: query_entire_dbase() - must has root euid or be this_object().\n");

        return dbase;
}

mixed add_temp(string prop, mixed data)
{
        mixed old;

        if( !mapp(tmp_dbase) || !(old = query_temp(prop)) )
                return set_temp(prop, data);

        if( functionp(old) )
                error("dbase: add_temp() - called on a function type property.\n");

        return set_temp(prop, old + data);
}

mapping query_entire_temp_dbase()
{
        // if( (previous_object() != this_object())
        // &&  (geteuid(previous_object()) != ROOT_UID) )
        //      error("dbase: query_entire_temp_dbase() - must has root euid or be this_object().\n");

        return tmp_dbase;
}

nomask void set_dbase(mapping data)
{
        // if( !is_root(previous_object()) )
        //      return;

        if( !mapp(data) )
                return;

        dbase = data;
}

nomask void set_temp_dbase(mapping data)
{
        // if( !is_root(previous_object()) )
        //      return;

        if( !mapp(data) )
                return;

        tmp_dbase = data;
}

nomask void delete_all_dbase()
{
        // if( !is_root(previous_object()) )
        //      return;

        dbase = ([]);
}

nomask void delete_all_temp_dbase()
{
        // if( !is_root(previous_object()) )
        //      return;

        tmp_dbase = ([]);
}

