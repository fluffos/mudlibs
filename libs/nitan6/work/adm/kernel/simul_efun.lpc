#pragma optimize
#pragma save_binary

#include <ansi.h>

private inherit __DIR__ "check_config";
// wizard.lpc (#include'd below) uses `dbase`/`_query`/`_set`/`_delete`
// without ever getting them -- this was apparently dropped; every sibling
// piece needing it just assumed it was already present.
//
// NOTE: this inherits F_TREEMAP directly (for _query/_set/_delete) and
// declares the storage variables inline, rather than `inherit F_DBASE`.
// F_DBASE's own higher-level methods (set_default_object, add, etc.) call
// bare `set`/`query`/`get_object`, expecting them to resolve as simul_efuns
// -- fine for F_DBASE's dozens of *other* inheriters (compiled after
// simul_efun already exists), but fatal here: simul_efun.lpc is composing
// those very functions in this same file, so the compiler would resolve
// F_DBASE's calls against its own not-yet-defined local prototypes instead
// of falling back to simul_efun dispatch. Nothing in this file's own
// composition actually needs F_DBASE's helper methods, only the bare
// storage + treemap helpers, so inheriting the smaller F_TREEMAP sidesteps
// the whole bootstrapping problem.
inherit F_TREEMAP;
mapping dbase = ([]);
nosave mapping tmp_dbase = ([]);
nosave mixed default_ob = 0;

#include "/adm/kernel/simul_efun/atoi.lpc"
// wizard.lpc (query/set/delete on `dbase`) and ansi_util.lpc (remove_ansi)
// moved ahead of chinese/file/gender.lpc, which call them as bare
// functions -- this driver resolves same-file functions strictly in
// #include order, no forward declarations.
#include "/adm/kernel/simul_efun/wizard.lpc"
#include "/adm/kernel/simul_efun/ansi_util.lpc"
#include "/adm/kernel/simul_efun/db_compat.lpc"
#include "/adm/kernel/simul_efun/chinese.lpc"
#include "/adm/kernel/simul_efun/file.lpc"
#include "/adm/kernel/simul_efun/gender.lpc"
#include "/adm/kernel/simul_efun/object.lpc"
#include "/adm/kernel/simul_efun/override.lpc"
#include "/adm/kernel/simul_efun/path.lpc"
#include "/adm/kernel/simul_efun/user.lpc"

// This must be after gender.c
#include "/adm/kernel/simul_efun/message.lpc"

// This is the utilitis
#include "/adm/kernel/simul_efun/util.lpc"
#include "/adm/kernel/simul_efun/ntefun.lpc"

void create()
{
        seteuid(getuid());
        write("simul_efun loaded successfully.\n");
}
