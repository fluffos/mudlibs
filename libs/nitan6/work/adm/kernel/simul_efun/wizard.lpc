// wiz.c

string wizhood(mixed ob)
{
        return SECURITY_D->get_status(ob);
}

int wiz_level(mixed ob)
{
        return SECURITY_D->get_wiz_level(ob);
}
///////////////////////
// set/query/delete here are a FALLBACK ONLY, hit exclusively by objects
// that don't inherit F_DBASE at all (nearly everything does -- see
// feature/dbase.lpc, which now defines the *real*, per-object versions of
// these same functions). A bare call to these, resolved as a genuine
// simul_efun call, runs with this_object() == the simul_efun object
// itself (confirmed empirically, see AGENTS.md) -- so the `dbase` used
// below is this file's own, shared by every caller that lands here. The
// `ob` redirect at least makes the extremely common `query(prop, ob)` /
// `set(prop, data, ob)` calling convention behave correctly (delegating
// to ob's own, real F_DBASE-provided storage) instead of silently reading
// or corrupting this shared fallback dbase.
varargs mixed set(string prop, mixed data, object ob)
{
        if( ob && ob != this_object() )
                return ob->set(prop, data);

        if( !mapp(dbase) ) dbase = ([]);

        if( strsrch(prop, '/')!=-1 )
                return _set( dbase, explode(prop, "/"), data );

        return dbase[prop] = data;
}

varargs mixed query(string prop, mixed raw_or_ob)
{
        mixed data;
        object ob;
        int raw;

        if( objectp(raw_or_ob) )
                ob = raw_or_ob;
        else
                raw = raw_or_ob;

        if( ob && ob != this_object() )
                return ob->query(prop);

        if( !mapp(dbase) ) return 0;

        if( undefinedp(dbase[prop]) && (strsrch(prop, '/')!=-1) )
                data = _query(dbase, explode(prop, "/"));
        else
                data = dbase[prop];

        if( undefinedp(data) && default_ob )
                data = default_ob->query(prop, 1);

        if( raw ) return data;

        return evaluate( data, this_object() );
}


// Called all over the mudlib (feature/food.lpc, banker.lpc, damage.lpc,
// logind.lpc, ...) as a bare global function, but never actually defined
// as one -- it only ever existed as an `efun::addn(...)` call inside
// baby.lpc's local override, i.e. it used to be a genuine driver efun on
// the original server binary. This fluffos build has no such efun, so
// it's restored here as a simul_efun delegating to F_DBASE's own add()
// (numeric-or-first-set increment) on the target object, matching what
// every call site already expects.
varargs mixed addn(string prop, mixed data, object ob)
{
        if( !ob ) ob = this_object();
        return ob->add(prop, data);
}

// Same gap as addn() above, for the temp (nosave) dbase.
varargs mixed addn_temp(string prop, mixed data, object ob)
{
        if( !ob ) ob = this_object();
        return ob->add_temp(prop, data);
}

varargs int delete(string prop, object ob)
{
        if( ob && ob != this_object() )
                return ob->delete(prop);

        if( !mapp(dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                return _delete(dbase, explode(prop, "/"));
        else {
                map_delete(dbase, prop);
                return 1;
        }
}

varargs mixed set_temp(string prop, mixed data, object ob)
{
        if( ob && ob != this_object() )
                return ob->set_temp(prop, data);

        if( !mapp(tmp_dbase) ) tmp_dbase = ([]);

        if( strsrch(prop, '/')!=-1 )
                return _set( tmp_dbase, explode(prop, "/"), data );

        return tmp_dbase[prop] = data;
}

varargs mixed query_temp(string prop, mixed raw_or_ob)
{
        mixed data;
        object ob;
        int raw;

        if( objectp(raw_or_ob) )
                ob = raw_or_ob;
        else
                raw = raw_or_ob;

        if( ob && ob != this_object() )
                return ob->query_temp(prop);

        if( !mapp(tmp_dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                data = _query(tmp_dbase, explode(prop, "/"));
        else
                data = tmp_dbase[prop];

        if( functionp(data) && !raw )
                return (*data)( this_object() );
        else
                return data;
}

varargs int delete_temp(string prop, object ob)
{
        if( ob && ob != this_object() )
                return ob->delete_temp(prop);

        if( !mapp(tmp_dbase) ) return 0;

        if( strsrch(prop, '/')!=-1 )
                return _delete(tmp_dbase, explode(prop, "/"));
        else {
                map_delete(tmp_dbase, prop);
                return 1;
        }
}































