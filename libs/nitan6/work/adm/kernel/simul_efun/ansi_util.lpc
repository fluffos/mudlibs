// ansi_util.c
//
// remove_ansi() was only ever defined inside /feature/quest.lpc (an
// ordinary inherited object, not part of the simul_efun composition), but
// chinese.lpc and file.lpc call it as a bare (simul_efun-style) function.
// Restored here as an actual simul_efun using the same color table/logic
// as quest.lpc's copy, so both call sites resolve.

string remove_ansi(string str)
{
        int i;
        string *color = ({ BLK, RED, GRN, YEL, BLU, MAG, CYN, WHT,
                           HIR, HIG, HIY, HIB, HIM, HIC, HIW,
                           HBRED, HBGRN, HBYEL, HBBLU, HBMAG, HBCYN, HBWHT,
                           BBLK, BRED, BYEL, BBLU, BMAG, BCYN,
                           NOR, BOLD });

        if( !str || !stringp(str) ) return 0;
        i = sizeof(color);
        while( i-- ) {
                str = replace_string(str, color[i], "");
        }
        return str;
}

// channeld.lpc's only call site -- another never-actually-defined global,
// same shape as remove_ansi() above.
int noansi_strlen(string str)
{
        if( !str ) return 0;
        return strlen(remove_ansi(str));
}
