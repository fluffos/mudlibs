inherit Q_ITEM;  //此处继承标准物件，即qitem.c
//publish_msg 某个NPC发布任务时的描述信息

void create() {
  string *tname = ({
    "丛镜月", "游客", "朱如土",
  });
  set_name("青城派信物", ({ "quest xinwu" }));
  set_weight(300);
  set("unit", "块");
  set("long",
    "这是一块神奇的铁牌，上面刻着一些青山绿树。\n");
  /*
	set("value", 0);
	set("no_get", 1);
	set("no_drop", 1);
*/
  set("quest_reward", 0);
  set("publish_msg", "丛镜月好象打听到了青城派最近的动向。");
  set("talk_name", tname[random(2)]);  //此处设置随机姓名，解迷时增加了不确定性
  set("talk_msg", "$N对$n抱拳说道：请问这位前辈，去东门怎么走？\n");
  //本测试物件没有后继物件，故没有设置talk_file
}
