inherit NPC;
#include <ansi.h>
void create() {
  set_name("仁山头陀", ({ "renshan" }));
  set("gender", "男性");
  set("age", 31);
  set("nickname", HIW "仁义如山" NOR);
  set("long",
    "“仁义如山”仁山头陀是披枝和尚的结拜义弟，江东八侠之一。\n");
  set("combat_exp", 700000);
  set("attitude", "friendly");
  set("per", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 10);
  set("score", 90000);
  set_skill("blade", 150);
  set_skill("spring-blade", 150);
  set_skill("pyrobat-steps", 150);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 150);
  set_skill("wuxing-quan", 150);
  set_skill("force", 150);
  set_skill("lotusforce", 150);
  map_skill("dodge", "pyrobat-steps");
  map_skill("parry", "spring-blade");
  map_skill("blade", "spring-blade");
  map_skill("unarmed", "wuxing-quan");
  map_skill("force", "lotusforce");
  setup();
  carry_object("/obj/cloth/monk_cloth")->wear();
  carry_object("/obj/blade")->wield();
}
