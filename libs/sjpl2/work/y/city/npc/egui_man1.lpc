inherit NPC;
string reward_more(object who);

void create() {
  set_name("骂不三", ({ "ma busan", "ma" }));
  set("age", 22);
  set("gender", "男性");
  set("title", "地痞流氓");
  set("long",
    "虽然武功不怎么样，但心黑手辣，也不好惹。\n");
  set("attitude", "heroism");

  set("combat_exp", 10000 + random(2000));
  set("shen_type", 1);

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set_skill("blade", 20);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "骂不三大喊，敢跟老子过不去，去死吧！\n",
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/d/city/obj/weapon/blade/blade")->wield();
  carry_object("/d/city/obj/cloth/linen")->wear();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 90000) return "1";
      if (enemy[i]->query("combat_exp") > 120000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") > 700) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
