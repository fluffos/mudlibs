inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("酱油", ({ "jiangyou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶烧菜的酱油。\n");
    set("unit", "瓶");
    set("value", 90);
    set("food_remaining", 1);
    set("food_supply", 1);
  }
}
