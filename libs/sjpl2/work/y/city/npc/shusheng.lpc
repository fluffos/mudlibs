#include <ansi.h>

inherit NPC;
//inherit F_VENDOR;
void create() {
  set_name("阮行冲", ({ "ruan xingchong", "ruan" }));
  set("gender", "男性");
  set("title", "落第才子");
  set("nickname", HIW "漫卷书生" NOR);
  set("age", 29);
  set("long",
    "这位穷酸秀才正用白多黑少的双眼盯着你\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set("per", 20);
  set_skill("literate", 30);
  set("inquiry", ([
    "告状": "要写状纸？给我三两金子就成。",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      message_vision("$N用无精打采的眼睛盯了$n一眼．\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N叹了口气，说道：如今这世道，财比才重？！\n", this_object(), ob);
      break;
    case 2:
      message_vision("$N喃喃道：要写状纸？给我三两金子就成！\n", this_object());
  }
}
int accept_object(object who, object ob) {
  int val;
  object paper;

  val = ob->value();
  if (!val)
    return 0;
  else if (val >= 30000) {
    paper = new(__DIR__ "obj/zhuangzhi");
    if (paper) {
      paper->set("targetprice", val);
      paper->move(who);
    }
  }
  say("阮行冲说道：这位" + RANK_D->query_respect(who)
    + "可真有眼力，居然认出我这个天下第一大才子！\n");

  return 1;
}

int recognize_apprentice(object ob)

{

  return 1;

}
