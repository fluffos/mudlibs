#include <ansi.h>

inherit NPC;
/*
inherit F_PAWNOWNER;
inherit F_VENDOR;
*/

void create() {
  set_name("欧阳显", ({ "ouyang xian", "ouyang", "boss" }));
  set("gender", "男性");
  set("age", 39);
  set("nickname", "欧阳当铺老板");
  set("long",
    "这是长安城最大的当铺欧阳当铺的老板，十分精明。\n");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("per", 30);
  set("no_arrest", 1);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}

