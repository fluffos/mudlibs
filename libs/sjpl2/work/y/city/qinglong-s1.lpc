//changan city

inherit ROOM;

void create() {
  set("short", "青龙大街");
  set("long", @LONG

你走在一条宽阔的石板大街上，北面就快到西市中心了，可以看到
一座鼓楼耸立于前。西面是长安府知府衙门，纪律森严，老百姓可以到
那里鸣冤上诉。东边是一家当铺。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "qinglong-s2",
      "north": __DIR__ "xishi-center",
      "west": __DIR__ "yamen",
      "east": __DIR__ "dangpu",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/army": 2,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
