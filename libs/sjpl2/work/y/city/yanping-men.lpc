//changan city

inherit ROOM;

void create() {
  set("short", "延平门");
  set("long", @LONG

这里是长安城的延平门。往北是金光门，远望人山人海，往来行人车
流不绝。西南一条大路通向藏边。城门下有一些执勤的兵士。时下虽
已天下太平，但一干兵将还是英姿勃勃，警惕的盯着往来人士。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "southwest": "/u/guanwai/tulu",  //goto lamasi
    "north": __DIR__ "yan-street2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    //                __DIR__"npc/wujiang" : 1,
    __DIR__ "npc/bing": 3,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  //	replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  if (me->query("wiz") == "baiwt")
    return ::valid_leave(me, dir);
  else if (dir == "southwest")
    return notify_fail("只听城楼上小兵喊道：城里戒严了，任何人未经允许不得出城！\n");
  else
    return ::valid_leave(me, dir);
}
