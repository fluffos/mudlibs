inherit ROOM;

void create() {
  set("short", "朱雀大街");
  set("long", @LONG
眼前一条笔直的青石大道,南通明德门，北往朱雀门,平整而光滑,却是十分冷清,
全没有了其它地方的车马喧嚣.只有稀稀拉拉的几个行人急匆匆的走过,气氛肃穆而冷清。
再往南即是兵部尚书大人的官邸了.旁边就是尚书府高大的院墙了。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zhuque-n3",
    "north": __DIR__ "zhuque-men",
  ]));
  set("objects", ([
    NPC_DIR "people/army": 3,
  ]));
  set("outdoors", "changan");
  setup();
  replace_program(ROOM);
}
