//changan city

inherit ROOM;

void create() {
  set("short", "青龙大街");
  set("long", @LONG

你走在一条宽阔的石板大街上，这是青龙大街的南段，西面是一家
茶馆，东边是神秘莫测的占星屋，据说占卜师可以预测未来。往南便是
安化门，从那里出城可以通往川中。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "anhua-men",
      "north": __DIR__ "qinglong-s2",
      "west": __DIR__ "chaguan",
      "east": __DIR__ "zhanxing",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/boy": 1,
      NPC_DIR "people/girl": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
