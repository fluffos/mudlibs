// Room: /changan/nanchengkou.c

inherit ROOM;

void create() {
  set("short", "明德门");
  set("long", @LONG

这里是长安的明德门。往北望去已可看到南城门络绎不绝的人流及城
口守卫的官兵。往南便是宽阔的长江渡口，从那里可以去往古都金陵
。由于长安是当代经济中心和交通枢纽，远远就有一种繁华的氛围，
让人感叹不愧是王都之气象。
LONG);

  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "guanroad3",  //goto jinling and xiaoyao
    "north": __DIR__ "zhuque-s4",
  ]));
  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/leiqin": 1,
      __DIR__ "npc/bing": 3,
    ]));

  set("outdoors", "changan");

  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("wiz") == "baiwt")
    return ::valid_leave(me, dir);
  if (dir == "south") {
    if (objectp(present("lei qin", environment(me))))
      return notify_fail("雷钦把手一拦，喝道：本城戒严，任何人不得出城！\n");
    if (objectp(present("xiao bing", environment(me))))
      return notify_fail("小兵喊道：我家将军不在，小人不敢放您进去！\n");
  }
  return ::valid_leave(me, dir);
}
