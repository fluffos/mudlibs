#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "长安府大堂");
  set("long", @LONG

大堂之上有一种威严之势，不由让人心惊胆颤。前方一张大桌，后面
坐着知府大人。上有一幅大匾，写着＂清正廉名＂四个烫金大字。一边墙
上有一块大的投状栏，栏旁立着一位大内名捕。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "yamen",
    "north": __DIR__ "ympianting",
    "south": __DIR__ "shufang",
  ]));
  set("item_desc", ([
    "投状栏": "这是个用来贴状纸的布告栏，里面有些纸片。\n"
  ]));

  set("objects", ([
    __DIR__ "npc/yayi": 1,
    __DIR__ "npc/yayi1": 1,
    __DIR__ "npc/yayi2": 1,
  ]));
  set("NONPC", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("light_up", 1);
  setup();
  replace_program(ROOM);
}
