//changan city

inherit ROOM;

void create() {
  set("short", "玄武大街");
  set("long", @LONG

这里的路相当的宽，能容好几匹马车并行，长长的道路贯穿东西。
这是玄武大街的东段，再往东便是东市中心，往西可以看见中心广场，
北面是一家家具店，南边是一家肉铺。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "roupu",
      "north": __DIR__ "jiaju",
      "east": __DIR__ "dongshi-center",
      "west": __DIR__ "center",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/army": 1,
      NPC_DIR "people/oldman": 1,
      __DIR__ "npc/caifan": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
