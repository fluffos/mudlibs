//changan city

inherit ROOM;

void create() {
  set("short", "白虎大街");
  set("long", @LONG
这里已是白虎大街的北段，西面是朝廷迎接各国使臣的迎宾馆，看上
去金碧辉煌，气派非凡。东面是御林军营，隔着老远都可以听到军营
里旗风招展，士兵演练呼喝的声音。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "baihu-n1",
      "north": __DIR__ "baihu-n3",
      "west": __DIR__ "guobinguan",
      "east": __DIR__ "yulinjun",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/oldman": 1,
      NPC_DIR "people/oldwoman": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
