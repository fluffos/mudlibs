//changan city

inherit ROOM;

void create() {
  set("short", "叶氏粮店");
  set("long", @LONG
这里是长安城里最大的粮店，几个伙计正忙着给人量米，柜台后叶老
板正笑眯眯的看这每一个买米的人，心里正在盘算着今天有赚了多少钱，
虽然叶老板是出了名的"吸血鬼"，米价是出奇的贵，可是"民以食为天"，
人们还得来这里买米,叶老板也成了一方豪富。活计们在一边忙忙碌碌地工
作着。如果你身无分文，你还可以在这里向叶老板打一些零工，以赚一些
钱。粮店的墙上贴着一张破旧的告示(gaoshi)。
LONG);

  set("item_desc", ([ "gaoshi": "现在正紧缺人手，急需雇佣一批短工来干活。

work	开始工作。
", ]));

  set("exits",
    ([  //sizeof() == 4
    "north": __DIR__ "xuanwu-w2",
    ]));

  set("objects",
    ([  //sizeof() == 2
    __DIR__ "npc/liang_boss": 1,
      __DIR__ "npc/huoji": 2,
    ]));
  set("no_fight", 1);

  //        set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}


void init() {
  add_action("do_work", "work");
}

int do_work(string arg) {
  object ob;
  object me;

  me = this_player();

  if (!me->query_temp("working_in_liangdian")) {
    message_vision("$N从车上卸下一袋袋的大米，又垒在墙边，累的腰酸腿疼！\n", me);
    me->add("kee", -30);
    me->add("sen", -30);
    ob = new("/obj/money/silver");
    ob->move(me);
    message_vision("叶老板笑眯眯地对$N说：辛苦啦，这是你的工钱。\n", me);
    me->set_temp("working_in_liangdian", 1);
    remove_call_out("reset_work");
    call_out("reset_work", 1, me);
  } else {
    message_vision("叶老板赶紧把$N扶起来：先歇一会儿。\n", me);
  }
  return 1;
}
void reset_work(object me) {
  me->set_temp("working_in_liangdian", 0);
}
