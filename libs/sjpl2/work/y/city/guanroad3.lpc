void create() {
  set("short", "青石官道");
  set("long", @LONG
这是一条宽敞坚实的青石大道，向南延伸。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "guanroad4",  //goto jinling and xiaoyao
    "north": __DIR__ "nanmen",
