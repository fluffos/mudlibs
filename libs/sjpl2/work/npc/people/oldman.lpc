// by baiwt 

inherit NPC;

string *names = ({
  "驻着拐杖的老人",
  "卖馄饨的老汉",
  "老员外",
  "私塾老先生",
  "卖烧饼的老汉",
  "老富商",
  "老管家",
  "清瞿老者",
  "老农夫",
  "老医生",
});

string *ids = ({
  "guaizhang laoren",
  "huntun laoren",
  "lao yuanwai",
  "sishu laoren",
  "shaobing laoren",
  "lao fushang",
  "lao guanjia",
  "qingqu laozhe",
  "lao nongfu",
  "lao yisheng",
});

string *genders = ({
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", genders[i]);
  set("combat_exp", 100 + random(1000));
  set("age", 40 + random(50));
  set("per", 4 + random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10 + random(80));
  set_skill("dodge", 10 + random(80));
  set_skill("parry", 10 + random(80));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  carry_object("/obj/cloth/changpao")->wear();
  carry_object("/obj/cloth/buxie")->wear();
  carry_object("/obj/cloth/headband")->wear();
  add_money("silver", random(8));
}
