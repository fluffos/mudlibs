// by baiwt 

inherit NPC;

string *names = ({
  "军士",
  "官差",
  "官兵",
  "军兵",
  "士兵",
});

string *ids = ({
  "jun shi",
  "guan chai",
  "guan bing",
  "jun bing",
  "shi bing",
});

string *titles = ({
  "御林军",
  "衙门",
  "泾原军",
  "禁卫军",
  "凤翔军",
});

string *weapons = ({
  "/obj/weapon/spear",
  "/obj/weapon/whip",
  "/obj/weapon/blade",
  "/obj/weapon/dagger",
  "/obj/weapon/axe",
});

string *armors = ({
  "/obj/cloth/tiejia",
  "/obj/cloth/g_cloth",
  "/obj/weapon/shield",
  "/obj/cloth/tiejia",
  "/obj/weapon/shield",
});

void create() {
  int i = random(sizeof(names));
  string cnname = names[i];
  set_name(names[i], ({ ids[i] }));
  set("title", titles[i]);
  set("gender", "男性");
  set("combat_exp", 1000 + random(50000));
  set("age", 15 + random(20));
  set("per", 4 + random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的士兵。\n");
  set_skill("unarmed", 30 + random(70));
  set_skill("blade", 20 + random(60));
  set_skill("spear", 20 + random(66));
  set_skill("axe", 20 + random(66));
  set_skill("dagger", 20 + random(66));
  set_skill("whip", 20 + random(66));
  set_skill("dodge", 30 + random(70));
  set_skill("parry", 30 + random(70));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :),
    cnname + "大声嚷嚷道：秦军进城了，闲杂人等一律闪开！\n",
    (: random_move :),
    cnname + "拍了拍你的肩膀，说道：你，干什么的？\n",
    (: random_move :),
    cnname + "上下打量你一眼，说道：看你人模狗样的，没事不要在这里乱晃！\n",
    (: random_move :),
    cnname + "拍了拍你的肩膀，说道：你，干什么的？\n",
    (: random_move :),
    cnname + "小声对你说道：泾原刺史姚令言攻入长安，是龙将军作内应的。\n",
    (: random_move :),
    cnname + "大声骂道：你他妈活得不耐烦了，看老子干嘛？\n",
    (: random_move :),
    cnname + "一脚将路边的小男孩踢翻在地，小男孩连滚带爬哭叫着逃开了。\n",
    (: random_move :),
    cnname + "不由份说一拳打得一位老婆婆血流满面，老婆婆被惊慌的旁人掺扶走了。\n",
    (: random_move :),
    cnname + "狞笑着拦住一位姑娘要行非礼，那姑娘尖叫着逃开了。\n",
    (: random_move :),
    cnname + "抢了一位过路游客的银子，喝道：你想造反吗？这些钱没收了，快滚！\n",
  }));

  setup();
  carry_object(armors[i])->wear();
  carry_object(weapons[i])->wield();
  add_money("silver", random(5));
}
