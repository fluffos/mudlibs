// by baiwt 

inherit NPC;

string *names = ({
  "千金小姐",
  "卖唱女子",
  "卖花少女",
  "天真的女孩",
  "花裙少女",
  "胖胖的女孩",
  "害羞的女孩",
  "穷苦女子",
  "赶集的少女",
  "渔家少女",
});

string *ids = ({
  "xiao jie",
  "maichang nv",
  "maihua nv",
  "nv hai",
  "shao nv",
  "pang nvhai",
  "xiu nv",
  "qiong nv",
  "ganji shaonv",
  "yujia nv",
});

string *genders = ({
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", genders[i]);
  set("combat_exp", 100 + random(600));
  set("age", 9 + random(20));
  set("per", 4 + random(50));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10 + random(20));
  set_skill("dodge", 10 + random(20));
  set_skill("parry", 10 + random(20));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  carry_object("/obj/cloth/color_cloth")->wear();
  carry_object("/obj/cloth/flower-shoes")->wear();
  carry_object("/obj/cloth/dudou")->wear();
  add_money("silver", random(5));
}
