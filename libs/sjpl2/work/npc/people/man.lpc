// by baiwt 

inherit NPC;

string *names = ({
  "卖鱼的汉子",
  "卖柴的大汉",
  "挑扁担的瘦汉子",
  "白面书生",
  "中年文士",
  "胖胖的商人",
  "卖水果的汉子",
  "算命先生",
  "中年武师",
  "过路的游客",
  "满面病容的汉子",
});

string *ids = ({
  "maiyu ren",
  "maichai ren",
  "shou hanzi",
  "shu sheng",
  "wen shi",
  "shang ren",
  "shuiguo han",
  "suan ming ren",
  "wu shi",
  "you ke",
  "bing fu",
});

string *genders = ({
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", genders[i]);
  set("combat_exp", 100 + random(1000));
  set("age", 20 + random(30));
  set("per", 4 + random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10 + random(80));
  set_skill("dodge", 10 + random(80));
  set_skill("parry", 10 + random(80));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/cloth/buxie")->wear();
  carry_object("/obj/cloth/belt")->wear();
  add_money("silver", random(5));
}
