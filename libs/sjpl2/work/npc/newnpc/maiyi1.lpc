#include <ansi.h>
inherit NPC;
int custom();
void reward_more(object who);
void create() {
  set_name("卖艺大汉", ({ "maiyi han", "maiyi" }));
  set("gender", "男性");
  set("age", 35);
  set("combat_exp", (random(10) + 1) * 10000);
  set("title", "普通百姓");
  set("chat_chance", 10);
  set("chat_msg", ({
    (: custom :)
  }));
  set("str", 20);
  set("id_type", 9);

  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 1226);
  set("atman", 731);
  set("mana", 592);
  set_skill("force", 30);
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("bai-quan", 30);
  map_skill("unarmed", "bai-quan");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (this_object()->query("kee") < 300) return;
  if (this_object()->query("sen") < 200) return;
  command("fight maiyi ren");
}
int custom() {
  if (this_object()->query("kee") < 200) return 1;
  if (this_object()->query("sen") < 100) return 1;
  command("fight maiyi ren");
  return 1;
}
void reward_more(object who) {
  int i;
  object env, *inv;
  object me = this_object();
  me->set("food", 100);
  me->set("water", 100);
  env = environment(me);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query_skill("parry", 1) < 20) {
      tell_object(inv[i], "\n你看着卖艺人的招式，似乎有所领悟。\n");
      inv[i]->improve_skill("parry", 2);
    }
  }
  return;
}
