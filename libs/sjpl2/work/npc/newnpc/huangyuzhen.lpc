#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("黄羽真", ({ "huang yuzhen", "huang" }));
  set("gender", "男性");
  set("age", 30);
  set("combat_exp", (random(7) + 1) * 100000);
  set("title", "武当剑客");
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("str", 70);
  set("id_type", 1);

  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 1226);
  set("force_factor", 30);
  set("atman", 731);
  set("mana", 592);
  set_skill("dodge", 180);
  set_skill("unarmed", 80);
  set_skill("parry", 170);
  set_skill("force", 180);
  set_skill("sword", 80);

  set_skill("taiji-sword", 80);
  set_skill("taiji-ken", 80);
  set_skill("taiji-force", 100);
  set_skill("tiyunzong", 160);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.tianti" :),
  }));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();

}
int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  if (me->query("bellicosity") > 10)
    me->set("bellicosity", 1);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 2)
      me->fight_ob(inv[i]);
  }
  return 1;
}
