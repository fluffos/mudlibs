#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("唐鹘", ({ "tang hu", "tang" }));
  set("gender", "男性");
  set("age", 33);
  set("combat_exp", (random(7) + 1) * 100000);
  set("nickname", HIG "四川豹囊" NOR);
  set("title", "蜀中唐门");
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("str", 70);
  set("id_type", 2);

  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 1226);
  set("force_factor", 30);
  set("atman", 731);
  set("mana", 592);
  set_skill("unarmed", 200);
  set_skill("throwing", 180);
  set_skill("dodge", 100);
  setup();
  carry_object("/obj/cloth")->wear();
  for (int i = 1; i <= 15; i++) {
    carry_object("/obj/weapon/dart")->wield();
  }
}

int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  command("heihei");
  if (me->query("bellicosity") > 10)
    me->set("bellicosity", 1);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 1)
      me->fight_ob(inv[i]);
  }
  return 1;
}
