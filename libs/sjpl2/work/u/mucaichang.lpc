// mucaichang.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "木材场");
  set("long", @LONG
院子里码放着一段段的木材，一些人正在忙碌着作着木匠活
逍遥派内的所有房屋都是用的木头都是在这里处理的。接受
大自然完备的恩赐，那是随意生活的所在。
LONG
  );
  set("exits", ([
    "west": __DIR__ "ground",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi2": 4,
  ]));
  setup();
}

void init() {
  if (this_player()->query("xiaoyao/quest") == 12)
    add_action("do_cut", "cut");
}

int do_cut(string arg) {
  int n;
  n = random(5) + 7;
  if (this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n");
  if (arg)
    return notify_fail("要作木工？(cut)\n");
  if (this_player()->query("xiaoyao/quest") != 12)
    return notify_fail("弟子笑了笑，我们这里人手够了，你还是去好好练功吧\n");
  if (this_player()->query_temp("busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query("sen") < 40 || this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("busy", 1);
  if (this_player()->query_temp("num") >= n) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N擦了擦额头的汗水，拍拍身上的粘满的木屑收工了!\n", this_player());

    this_player()->delete_temp("ju");
    this_player()->delete_temp("num");
    this_player()->set_temp("over", 1);
    this_player()->delete_temp("busy");
    return 1;
  }
  write(YEL "看着锯子在木缝间，晦涩的反复移动，你看到的生活的轨迹。\n" NOR);
  message_vision("$N喊着豪迈的号子：“拉大锯，扯大锯。。。” \n", this_player());
  this_player()->start_busy(1);
  call_out("improve", 1, this_player());
  return 1;
}

void improve(object who) {

  object ob;

  who->improve_skill("parry", random((int)who->query("int")));
  who->add("sen", -(30 - (int)who->query_skill("parry", 1) / 8));
  who->add("gin", -(30 - (int)who->query_skill("parry", 1) / 8));

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
}
