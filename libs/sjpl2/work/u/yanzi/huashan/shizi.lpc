// Room: /u/yanzi/huashan/shizi.c 
 
inherit ROOM; 

#include <ansi.h> 
void create() 
{ 
	set("short", HIC"狮子岭"NOR);
	set("long", @LONG
这里便是华山狮子岭，它是华山西部高度仅次于西峰的高岭，往
岭下往去有千丈之深，云雾袅绕，不能见底。常有人从这里跳下寻死
，希望死后能长眠于这青山之中。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "eastdown" : __DIR__"road1",
]));
	set("no_clean_up", 0);
	set("outdoors", "huashan");

	setup();
}
void init()
{
	add_action("do_jump", "jump");
}
int do_jump(string arg)
{
	object ob;
	int kar;
	ob = this_player();
	kar = (int)ob->query("kar",1);
	if (kar > 40) kar = 40;
		
	if( !arg || arg!="down" )
	{
        write("这里地势这么险，你乱跳小心掉下去！\n");
        return 1;
	}
	if (ob->query("marks/huashan/gudi") )
		{
		message_vision("$N轻轻一跃，向谷地跃了下去，转眼间便不见踪迹。\n",ob);
		tell_object(ob,"伴着耳边呼呼风声，你已可隐隐看见地面。\n");
		tell_object(ob,"你在空中一提真气，速度顿时缓下，轻巧得落在地上。\n");
		ob->move(__DIR__"gudi1");
		message("vision","只见一个黑影从山崖之上呼啸而下！\n",environment(ob),ob);
		message("vision",ob->name() + "在空中一提真气，速度顿时缓下，轻巧得落在地上。\n",environment(ob),ob);
		return 1;
		}
	message_vision("$N只觉万念俱空，人生在世再无任何意义，便一跃而下，向那千丈深渊跳下。\n", ob);
	if ((int)ob->query_skill("dodge",1) >= 130 && (random(40-kar) < 20))
		{
		tell_object(ob,HIR"出乎你的意料，你先在空中给一棵松树勾了一下，缓了下下落速度，又噼里啪啦\n"
		"掉进谷底的树上，最后摔在一片柔软的草地上，即便如此你也摔得十分地重。\n"NOR);
		ob->unconcious();
		ob->set("marks/huashan/gudi",1);
		ob->move(__DIR__"gudi1");
		message("vision",ob->name() + "从突然从山谷之上重重地摔下来。\n",environment(ob), ob );
		return 1;
		}
	else if ((int)ob->query_skill("dodge",1) < 80)
		{
		ob->move(__DIR__"gudi1");
		ob->die();
		message("vision",ob->name() + "从突然从山谷之上重重地摔下来，看来是活不成了。\n",environment(ob), ob );
		CHANNEL_D->do_channel(this_object(), "rumor",
                        sprintf("%s摔下华山死了。", ob->name())); 

		return 1;
		}
	else {
		ob->move(__DIR__"songshu");
		message("vision",ob->name() + "突然从上面落了下来，和你掉在了一起。\n",environment(ob),ob);
		return 1;
	}
}