// Room: /u/yanzi/huashan/room.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIC "房舍" NOR);
  set("long", @LONG
这里是一大片的房舍，都是华山派所建，因为年久失修，正在进
行整修，几个工人在这里忙得不可开交。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "zlxj2",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "npc/worker": 1,
  ]));

  setup();

}
void init() {
  add_action("do_work", "work");
}
int do_work() {
  object me;
  int cost;
  me = this_player();
  cost = 40 + (25 - me->query("int"));

  if (me->query_temp("over"))
    return notify_fail("你已经完工了，快复命去吧。\n");
  if (!me->query_temp("repair"))
    return notify_fail("工人笑了笑：我这里不缺人手。\n");
  if (me->query_temp("busy"))
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < cost || me->query("gin") < cost)
    return notify_fail("你够累的了，休息一下吧!\n");

  me->set_temp("busy", 1);
  if (me->query_temp("num") == me->query_temp("repair")) {
    tell_object(me, "工人说道：好了，这里没有需要你帮忙的了。”\n");
    message_vision("$N擦了擦额头的汗水，收工了。\n", me);
    tell_object(me, "你在" + chinese_number((int)me->query_temp("repair")) +
      "次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
      "次。\n");
    if ((int)me->query_temp("success") == (int)me->query_temp("repair"))
      me->set_temp("wonderful", 1);
    me->delete_temp("repair");
    me->delete_temp("num");
    me->set_temp("over", 1);
    me->delete_temp("busy");
    return 1;
  }
  message_vision("$N开始忙碌地干起活来。\n", me);
  switch (random(4)) {
    case 0:
      message_vision("$N抱着一大堆砖头，给工人们送去。\n", me);
      break;
    case 1:
      message_vision("$N拿着刷子，给墙壁粉刷。\n", me);
      break;
    case 2:
      message_vision("$N帮着工人们扛木头。\n", me);
      break;
    case 3:
      message_vision("$N在旁边给工人们送茶水。\n", me);
      break;
  }
  call_out("improve", 1, me);
  me->start_busy(1);
  return 1;
}
void improve(object who) {

  object ob;
  int cost, i, n;
  i = random(100);
  n = 30 + who->query("int") + who->query_skill("unarmed", 1) / 10;
  cost = 40 + (25 - who->query("int"));

  who->add("sen", -cost);
  who->add("gin", -cost);
  who->add_temp("num", 1);
  who->set_temp("busy", 0);
  if (i < n) {
    tell_object(who, "\n你这次的活干得相当不错。\n");
    who->add_temp("success", 1);
  } else
    tell_object(who, "\n你这次的表现似乎不太好啊。\n");
}
