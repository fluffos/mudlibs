inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"苍龙岭"NOR);
	set("long", @LONG
你来到一条长几十丈，宽仅二尺余，坡度极陡的名为“苍龙岭”
的山脊前，这里两旁千丈绝壁，仅有这条石脊通达对岸，人若行走其
间，会感到心惊肉跳。好在两旁设有栏杆，扶着栏慢慢往前走，眼睛
别向险处看就可以了。
    传说唐代大文学家韩愈游华山，好容易鼓足勇气才爬上了“苍龙
岭”，回头一望，见山路如此险绝，不禁大惊失色，想着这次可能回
不去于是写了遗书投下山涧。这里的崖壁(bi)上刻着些字。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "bi" : "[1;37m			韩愈投书处
[2;37;0m",
]));
	set("outdoors", "huashan");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "southup" : __DIR__"road4",
  "northdown" : __DIR__"chuangwang",
]));

	setup();

}
