// duanmu.c
inherit NPC;
#include <ansi.h> 

void create()
{
	set_name("端木明", ({ "duanmu ming", "ming","duanmu" }) );
	set("gender", "男性");
	set("age",44);
	set("nickname", HIY"琴痴"NOR);
	set("long",@LONG
端木明是莫天雄的师弟，与百里云合称双璧，一个爱剑如命，一个则
是为琴痴狂，。
LONG
	);
	set("attitude", "peaceful");
	set("int", 25);
	set("cor", 25);
	set("agi", 25);
	set("con", 20);
	set("str", 20);
	set("tol", 20);
	set("spi", 20);
	set("dur", 20);
	set("per", 30);
	set("fle", 20);
	set("cps", 20);
	set("max_force", 2500);
	set("force", 3700);
	set("force_factor", 120);
	set("combat_exp", 2000000);
	set("score", 70000);
//	set("daode", 49000);

	set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
	(: perform_action, "sword.taiyue" :),

        }) );
	set_skill("dodge", 200);
	set_skill("parry", 180);
	set_skill("sword", 150);
	set_skill("force", 150);
	set_skill("unarmed", 100);
	set_skill("literate", 200);
	set_skill("music", 200);
        set_skill("hs-zhengqi", 160);
	set_skill("huashan-force", 160);
	set_skill("zixia-shengong", 150);
	set_skill("huashan-sword", 150);
	set_skill("huashan-strike", 120);
	set_skill("tianluo-steps", 200);
	set("perform/huashan/taiyue",2000);	//perform lvl = 2

	map_skill("sword", "huashan-sword");
	map_skill("parry", "huashan-sword");
	map_skill("force", "zixia-shengong");
	map_skill("unarmed", "huashan-strike");
	map_skill("dodge", "tianluo-steps");

	create_family("华山派", 15, "长老");

	setup();
	carry_object(__DIR__"obj/qin");
	carry_object("/obj/cloth")->wear();
}
void init()
{
	add_action("do_killing", "kill");
	add_action("do_answer", "answer");
	add_action("do_learn", "learn");
	add_action("do_skills","skills");
	add_action("do_app", "apprentice");
}
int do_killing(string arg)
{
	object player,victim;
	player = this_player();
	if(!arg)
	return 0;
	if( objectp(victim = present(arg, environment(this_object()))))
	{
		if(victim->query("id") == this_object()->query("id")) {
			if(present("qin",this_object()));
				command("wield qin sword");
			return 0;
		}
		else if (victim->query("family/family_name")== "华山派" ) {
		message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
		if( present("qin",this_object()) );
			command("wield qin sword");
		this_object()->kill_ob(player);
		player->kill_ob(this_object());
		return 0;
		}
		else return 0;
	}
	else return 0;
}
void killed_enemy(object ob)
{
	command("say 哈哈, 不自量力的家伙！");
	if(present("qin sword",this_object()));
		command("unwield qin sword");
}
int accept_fight(object ob)
{
	command("shake");
	command("say 老夫一生只爱琴音韵律，已有很长时间不碰剑了，阁下如要比武不妨找我百里师兄去吧。");
	return 0;
}
int do_app(string arg)
{
	object ob,master;
	int spi;
	ob = this_player();
	master = this_object();
	spi = (int)ob->query("spi", 1);

	if(arg != this_object()->query("id") || !arg) {
		tell_object(ob,"你要拜谁？\n");
		return 1;
	}
	if(ob->query("marks/huashan/learn_music")) {
		message_vision("$N恭恭敬敬地向$n磕头请安，叫道：「师父！」\n", ob, this_object());
		command("haha");
		command("pat " + ob->query("id"));
		command("say 我说了几次了，我只是见你在琴音韵律方面有天赋，指点你几下，不必师徒相称。\n");
		return 1;
	}
	else if (spi < 20){ 
		command("shake");
		command("say 我只对琴音韵律感兴趣，你拜我是学不了一身好武功的，我可不想误人子弟。");
		return 1;
	}
	else if (ob->query("class") == "huashan" ){
		command("smile");
		message_vision("端木明说道：拜师不敢当，不过我看" + RANK_D->query_respect(ob) + 
                "颇具灵性，我到可以在琴音韵律方面指点你一二，你是否愿意？\n我等你的回复(answer)\n",ob);


		ob->set_temp("marks/huashan/answer" ,1);
		return 1;
		}
	return 0;
}
int do_answer(string arg)
{
	object me,obj;
	me = this_player();
	obj = present("qin",this_object());
	if(!arg) return 0;
        if(!me->query_temp("marks/huashan/answer")) return 0;

	if(arg == "yes" || arg == "是"){
		command("smile");
		command("say 我定会将我所学倾囊相授，你以后可以向我学习(learn)琴音韵律方面的疑问。");
		command("say 你也可以查我在琴音韵律方面的所学。");
		me->delete_temp("marks/huashan/answer");
		me->set("marks/huashan/learn_music",1);
		return 1;
		}
	else if(arg == "no" || arg == "否") {
		command("sigh");
		command("say 可惜你如此好的天赋......");
		command("sigh");
		if(obj) {
			command("say 真是可惜啊，你虽然不愿意，但我也要将这把琴赠于你，就当是留念吧。");
			message_vision("$N把一把古琴给了$n。\n",this_object(),me);
			obj->move(me);
			}
		return 1;
	}
	else return notify_fail("你回答些什么乱七八糟的？\n");
}
int do_learn(string arg)
{
	object ob,me;
	string from;
	int pot,sk,amount,gin_cost;
	ob = this_object();
	me = this_player();
	sk = (int)me->query_skill("music",1);
	pot = (int)me->query("potential",1);
	if(!arg)
		return notify_fail("指令格式：qiujiao music from duanmu with <潜能数>\n");
	if( sscanf(arg, "%s from %s with %d", arg, from,pot)!=3 ) 
		return notify_fail("指令格式：qiujiao music from duanmu with <潜能数>\n");
	if(arg != "music" || from != ob->query("id") ) 
		return notify_fail("指令格式：qiujiao music from duanmu with <潜能数>\n");
	if(!me->query("marks/huashan/learn_music") )
		return notify_fail("端木明并不想教你。\n");
	if ( pot <=0 )
		return notify_fail("潜能点最少是一！\n");
	if( !living(ob) )
		return notify_fail("嗯....你得先把" + ob->name() +"弄醒再说。\n");
	if(sk > 200)
		return notify_fail("端木明已不能再指点你什么了。\n");
	gin_cost = 100 / (int)ob->query_int();
	if( (int)me->query_skill("music",1) == 0 ) {
                gin_cost *= 2;
                me->set_skill("music",0);
        }
	gin_cost *= pot;
	if( (int)me->query("potential") - (int)me->query("learned_points") < pot )
                return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
     	tell_object(me,"你向"+ob->name()+"请教有关「琴音韵律」的疑问。\n");
	if( (int)me->query("gin") > gin_cost ) {
		if((sk*sk*sk)/10 > (int)me->query("combat_exp") ) {
			printf("也许是因为缺乏经验，你对%s的回答总是无法领会。\n", ob->name() );
	               	} 
		else {
			printf("你听了%s的指导，似乎有些心得。\n",ob->name());
			me->add("learned_points", pot);
			amount = (sk - 75) * SKILL_D("music")->black_white_ness()/100;
			if((amount < -50) && (sk < 75)) amount = -50;
				amount += SKILL_D("music")->learn_bonus() + (int)me->query_int()
				 * (int)me->query_int() + to_int(pow(to_float((int)me->query("combat_exp")),0.3));
			amount = amount/50 + random(amount/50);
			if( amount < 2) amount = 2;	
				amount *= pot;
			if( me->query_skill("music",1) <= 300 )
			me->improve_skill("music",amount);
		}
	}
	else {
		gin_cost = me->query("gin");
		write("你今天太累了，结果什麽也没有学到。\n");
        }
	me->receive_damage("gin", gin_cost );
	return 1;
}
int do_skills(string arg)
{
	object me,ob;
	string msg;
	me = this_player();
	ob = this_object();

	if(!arg || arg != ob->query("id") )
		return 0;
	if(wizardp(me)) 
		return 0;
	if(!me->query("marks/huashan/learn_music") )
		return 0;
	msg = "琴音韵律 (music)                         - 深不可测 200/    0\n";
	tell_object(me,"端木明告诉你：我琴音韵律的所学：\n" + msg );
	return 1;
}
