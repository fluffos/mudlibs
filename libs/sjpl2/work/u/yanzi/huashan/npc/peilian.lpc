inherit NPC;

string reward_more(object who);
void create() {
  set_name("陪练弟子", ({ "peilian" }));
  set("gender", "男性");
  set("age", 28);
  set("str", 2);
  set("cor", 30);
  set("cps", 20);
  set("con", 50);
  set("per", 27);
  set("int", 10);
  set("max_kee", 20000);
  set("kee", 20000);
  set("food", 500);
  set("water", 500);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  set("attitude", "peaceful");
  setup();
}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;
  if (ob->query("combat_exp") > 20000) {
    command("say " + RANK_D->query_self(this_object())
      + "武艺低微，怎么可能是" + RANK_D->query_respect(ob)
      + "的对手？\n");
    return 0;
  }

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("chat_chance_combat", 50);
  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 100);
  if (query("combat_exp") > 100000) set("combat_exp", 100000);
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);

  return 1;
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") > 20000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 90) return "1";
      else if (random(9) < 5)
        enemy[i]->add("potential", 1);
      else
        enemy[i]->add("life_exp", 1);
    }
  }
  return "1";
}
