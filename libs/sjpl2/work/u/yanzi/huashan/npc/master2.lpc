// master.c 华山掌门

inherit NPC;
inherit F_MASTER;

#include <ansi.h>
int ask_miji();
int ask_me();
int ask_ling();

void create() {
  set_name("莫天雄", ({ "master mo", "master", "mo" }));
  set("long", @LONG
他就是华山派的现任掌门人，江湖上人称“夺命剑”的莫天雄。他看上去
是个和善的中年人，对人总是彬彬有礼，但是武林中谁都知道，他如果一
出手，却象换了一个人，招招狠毒！
LONG
  );
  set("gender", "男性");
  set("age", 52);
  set("attitude", "peaceful");
  set("int", 25);
  set("cor", 25);
  set("agi", 26);
  set("con", 24);
  set("str", 22);
  set("tol", 30);
  set("spi", 23);
  set("dur", 18);
  set("per", 26);
  set("fle", 23);
  set("cps", 21);
  set("max_force", 3000);
  set("force", 5000);
  set("force_factor", 100);
  set("combat_exp", 3000000);
  set("score", 80000);
  //      set("daode", 49900);

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: perform_action, "sword.taiyue" :),

  }));
  set_skill("dodge", 200);
  set_skill("move", 200);
  set_skill("parry", 190);
  set_skill("sword", 180);
  set_skill("force", 200);
  set_skill("unarmed", 200);
  set_skill("literate", 180);
  set_skill("hs-zhengqi", 180);
  set_skill("huashan-force", 200);
  set_skill("zixia-shengong", 200);
  set_skill("huashan-sword", 200);
  set_skill("huashan-strike", 200);
  set_skill("tianluo-steps", 200);

  set("perform/huashan/taiyue", 2000);
  set("perform/huashan/yujian", 2000);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");

  create_family("华山派", 15, "掌门");

  set("inquiry", ([
    "独孤九剑": "唉，独孤九剑乃是天下无双的剑法，但我派历史上也只有\n令狐冲和风清扬两位前辈懂得。\n",
    "令狐冲": "令狐冲乃我师叔，他老人家仙逝也有十几年了。\n",
    "老沈": "嘿嘿，你可别小看他，他可是我的师伯，还是令狐师叔的高徒，武功\n尤在我之上，只是他早对江湖厌倦，隐居于华山卖凉茶，不理江湖恩怨了。\n",
    "华山剑谱": "前几日来了个小偷，盗走了剑谱，我正派人找呢。\n",
    "紫霞秘籍": (: ask_miji :),
    "玉萧": (: ask_me :),
    "魔教玄铁令": (: ask_ling :),
  ]));
  set("xiao_count", 1);
  set("book_count", 1);
  setup();
  carry_object(__DIR__ "obj/purple_sword");
  carry_object(__DIR__ "obj/silk-cloth")->wear();
}
void attempt_apprentice(object ob) {
  int exp = (int)ob->query("combat_exp");
  if (ob->query("family/master_name") == "老沈") {
    command("say 沈师伯武功高我许多，你拜了他又何必再来拜我呢？\n");
    return;
  } else if (exp > 200000) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 我华山乃名门正派，我派弟子在江湖上必须行侠仗义，你可记清楚了。\n");
    command("say 本门门规不多，但需遵守以下华山七戒：\n" +
      "\n本派首戒欺师灭祖，不敬尊长。\n" +
      "\n二戒恃强欺弱，擅伤无辜。\n" +
      "\n三戒奸淫好色，调戏妇女。\n" +
      "\n四戒同门嫉妒，自相残杀。\n" +
      "\n五戒见利忘义，偷窃财物。\n" +
      "\n六戒骄傲自大，得罪同道。\n" +
      "\n七戒滥交匪类，勾结妖邪。\n");
    command("say 从今日起，我传你紫霞神功。\n");
    ob->set("class", "huashan");
    ob->set("marks/huashan/zixia", 1);
    ob->set("huashan/last_daode", ob->query("daode"));
    ob->set("huashan/last_PKS", ob->query("PKS"));
    return;
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是先向我的大弟子学点武功吧。\n");
    return;
  }
}
int ask_me() {
  object me, ob, xiao;
  int sk;
  me = this_player();
  ob = this_object();
  sk = (int)me->query_skill("music", 1);
  if ((sk > 100) && (ob->query("xiao_count") < 1)) {
    command("shrug");
    command("say 你来晚了，玉萧我已经送人了。\n");
    return 1;
  } else if (sk > 100) {
    command("say 我本对琴音韵律不敢兴趣，而阁下却对此精通，就送于你吧，令狐师\n叔泉下有知，也会同意的吧。\n");
    command("whisper " + me->query("id") + " 当初令狐师叔赠我此物时对我说过，如你有缘，当能\n在他的卧室发现另有相赠。\n");
    ob->add("xiao_count", -1);
    xiao = new(__DIR__ "obj/yuxiao");
    xiao->move(me);
    message_vision("$N给$n一枝玉萧。\n", ob, me);
    return 1;
  } else {
    command("shake");
    command("say 这是令狐师叔所赠之物，岂可随意赠人！\n");
    return 1;
  }
}
int ask_ling() {
  object me, obj;
  me = this_player();
  obj = present("tiepai", me);
  if (!obj) {
    command("say 传说魔教玄铁令上记载着极高深的内功心法，因而十一年前，众多正邪高手在华山大战，\n但结果却是众高手死的死，伤的伤，玄铁令也绝迹江湖。\n");
    return 1;
  } else {
    command("say 咦？你身上的铁牌不就是传说中的魔教玄铁令吗？你怎么找到的？\n");
    destruct(obj);
    obj = new(__DIR__ "obj/xuantieling");
    obj->move(me);
    return 1;
  }
}
int ask_miji() {
  object me, obj;
  me = this_player();
  if (me->query("class") != "huashan") {
    command("say 你又不是华山弟子！");
    return 1;
  }
  if (me->query("family/master_name") != "莫天雄") {
    command("say 你不是我的亲传弟子！\n");
    return 1;
  }
  if ((int)me->query("huashan/siguo") > 1) {
    command("say 你犯过华山门规，还想要紫霞秘籍，别做梦了。\n");
    return 1;
  }
  if ((int)me->query("huashan/biaoyang") > 10) {
    //      && (int)me->query("score") > 20000)
    if (query("book_count") < 1) {
      command("shrug");
      command("say 你来晚了，紫霞秘籍我已经给人了。\n");
      return 1;
    }
    command("smile");
    command("say 你最近表现十分出色，这本紫霞秘籍就给了你吧。\n");
    obj = new(__DIR__ "obj/zixia-miji");
    obj->move(me);
    message_vision("$N给$n一本$n。\n", this_object(), me);
    command("say 这本书是我华山无上秘籍，你可要好好妥善保管啊！\n");
    return 1;
  }
  command("pat " + me->query("id"));
  command("say 你要好好努力，他日我自会将紫霞秘籍授于你。\n");
  command("addoil " + me->query("id"));
  return 1;
}
void init() {
  add_action("do_qingan", "qingan");
  add_action("do_killing", "kill");
  add_action("do_qiujiao", "qiujiao");
  add_action("do_learn", "learn");
  add_action("do_app", "apprentice");
}
int do_learn() {
  object me = this_player();
  if (me->query("family/master_name") == "莫天雄"
    && !me->query("marks/huashan/请安")) {
    tell_object(me, "你还没有给你师傅请安！\n");
    return 1;
  }
  return 0;
}
int do_app(string arg) {
  object ob, master;
  int exp, sk, daode, last_daode, PKS, last_PKS;
  ob = this_player();
  master = this_object();
  daode = (int)ob->query("daode");
  last_daode = (int)ob->query("huashan/last_daode");
  PKS = (int)ob->query("PKS");
  last_PKS = (int)ob->query("last_PKS");

  if (ob->query("family/master_name") != "莫天雄")
    return 0;
  if (ob->query("marks/huashan/请安")) {
    tell_object(ob, "你已经请过安了。\n");
    return 1;
  }
  message_vision("$N走到$n前磕头请安，并说道：弟子下山归来，特向师父请安。\n", ob, master);
  ob->set("marks/huashan/请安", 1);

  if ((daode - last_daode) >= last_daode % 5) {
    command(":)");
    command("say 很好，你最近在江湖上又做了不少好事啊，再接再厉啊。\n");
    ob->add("huashan/biaoyang", 1);
  } else if (daode < last_daode || PKS > last_PKS) {
    if ((int)ob->query("huashan/siguo") >= 10) {
      command("sigh");
      command("say 我华山怎么会有你如此的孽徒，你下山去吧，从此不再是我华山中人。\n");
      command("expell " + ob->query("id"));
      ob->delete("huashan/siguo");
      ob->delete("huashan/biaoyang");
      return 1;
    }
    message_vision("$N脸色一沉，说道：你这孽徒，在江湖只逛了几天，便犯了门规，败坏\n我华山清誉，你去思过崖好好反省反省吧。\n", master);
    ob->move("/u/yanzi/huashan/siguoy");
    ob->add("huashan/siguo", 1);
  } else {
    command("say 我华山弟子在江湖之上应行侠仗义，你以后应多加油啊。\n");
  }
  ob->set("huashan/last_daode", ob->query("daode"));
  ob->set("huashan/last_PKS", ob->query("PKS"));
  return 1;
}
int do_killing(string arg) {
  object player, victim;
  player = this_player();
  if (!arg)
    return 0;
  if (objectp(victim = present(arg, environment(this_object())))) {
    if (victim->query("id") == this_object()->query("id")) {
      if (present("purple sword", this_object()))
        command("wield sword");
      return 0;
    } else if (victim->query("family/family_name") == "华山派") {
      message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n", this_object());
      if (present("purple sword", this_object()))
        command("wield sword");
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 0;
    } else return 0;
  } else return 0;
}
void killed_enemy(object ob) {
  command("say 哈哈, 不自量力的家伙！");
  if (present("purple sword", this_object()))
    command("unwield sword");
}
void die() {
  object sword, ob;
  ob = this_player();
  sword = present("purple sword", this_object());
  if (sword) {
    message_vision(MAG "只见一把泛着紫芒的长剑从莫天雄身上掉了下来，落到地上。\n" NOR, ob);
    sword->move(environment(ob));
  }
  ::die();
}
int accept_fight(object ob) {
  command("say 进招吧！");
  if (present("purple sword", this_object()))
    command("wield sword");
  return 1;
}
int do_qiujiao(string arg) {
  string from;
  object me;
  int cz, lit;
  me = this_player();
  cz = (int)me->query("int", 1);
  lit = (int)me->query_skill("literate", 1);

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  if (me->query("class") != "huashan")
    return notify_fail("你非我华山弟子！\n");
  if (sscanf(arg, "%s from %s", arg, from) == 2) {
    if (from != "master" && from != "master mo" && from != "mo")
      return notify_fail("你要向谁求教？\n");
    if (arg == "太岳三青峰" || arg == "taiyue") {
      if ((int)me->query("gin") < 30)
        return notify_fail("你的精力不足，该休息休息了。\n");
      if ((int)me->query_skill("huashan-sword", 1) < 80)
        return notify_fail("你的华山剑法所学不足，无法领悟太岳三青峰第二重。\n");
      if ((int)me->query("perform/huashan/taiyue", 1) < 1000)
        return notify_fail("你先向我徒弟去学习太岳三青峰第一重吧。\n");
      if ((int)me->query("perform/huashan/taiyue", 1) >= 2000)
        return notify_fail("你已学会太岳三青峰第二重，莫天雄已不能指点你什么了。\n");
      if ((int)me->query("potential") < 20)
        return notify_fail("你的潜能不足，学习太岳三青峰第二重至少需要20点潜能。\n");
      tell_object(me, "你向莫天雄求教有关华山绝技「太岳三青峰」的疑问。\n");
      tell_object(me, "你听了莫天雄的指导，似乎有些心得。\n");
      me->add("perform/huashan/taiyue", cz + lit / 8 + random(20));
      me->add("potential", -20);
      me->add("gin", -30);
      if (me->query("perform/huashan/taiyue") >= 2000)
        tell_object(me, HIC "你学会了华山绝技--太岳三青峰第二重！\n" NOR);
      return 1;
    }
    if (arg == "以气驭剑" || arg == "yujian") {
      if ((int)me->query("gin") < 30)
        return notify_fail("你的精力不足，该休息休息了。\n");
      if ((int)me->query_skill("zixia-shengong", 1) < 80)
        return notify_fail("你的紫霞神功所学不足，无法领悟以气驭剑。\n");
      if ((int)me->query("perform/huashan/yujian") >= 1000)
        return notify_fail("你已学会以气驭剑中莫天雄所领悟的部分了，他已不能指点你什么了。\n");
      if ((int)me->query("potential") < 20)
        return notify_fail("你的潜能不足，学习以气驭剑至少需要20点潜能。\n");
      tell_object(me, "你向莫天雄请教有关华山绝技「以气驭剑」的疑问。\n");
      tell_object(me, "你听了莫天雄的指导，似乎有些心得。\n");
      me->add("perform/huashan/yujian", cz + lit / 9 + random(15));
      me->add("potential", -20);
      me->add("gin", -30);
      if ((int)me->query("perform/huashan/yujian") >= 1000)
        tell_object(me, HIC "你似乎粗通了华山绝技--以气驭剑！\n" NOR);
      return 1;
    }
    return notify_fail("你要向莫天雄求教什么？\n");
  }
  return notify_fail("指令格式：qiujiao (perform) from (sb)\n");
}
