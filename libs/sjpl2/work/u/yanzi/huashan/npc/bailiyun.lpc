// bailiyun.c
inherit NPC;
#include <ansi.h>

void create() {
  set_name("百里云", ({ "baili yun", "yun", "baili" }));
  set("gender", "男性");
  set("age", 49);
  set("nickname", HIG "剑痴" NOR);
  set("long", @LONG
百里云是莫天雄的师弟，据说是华山使剑的第一高手，一生浸淫于剑
术之中，除此之外别无所爱，故人称剑痴。
LONG
  );
  set("attitude", "peaceful");
  set("int", 25);
  set("cor", 25);
  set("agi", 25);
  set("con", 20);
  set("str", 20);
  set("tol", 20);
  set("spi", 20);
  set("dur", 20);
  set("per", 30);
  set("fle", 20);
  set("cps", 20);
  set("max_force", 2800);
  set("force", 4000);
  set("force_factor", 120);
  set("combat_exp", 2000000);
  set("score", 70000);
  //      set("daode", 49000);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.taiyue" :),
  }));
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("sword", 250);
  set_skill("force", 150);
  set_skill("unarmed", 40);
  set_skill("literate", 20);
  set_skill("hs-zhengqi", 100);
  set_skill("huashan-force", 200);
  set_skill("zixia-shengong", 150);
  set_skill("huashan-sword", 250);
  set_skill("huashan-strike", 70);
  set_skill("tianluo-steps", 150);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");
  set("perform/huashan/taiyue", 3000);     //perform lvl = 3

  create_family("华山派", 15, "长老");

  setup();
  carry_object(__DIR__ "obj/gangjian");
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob, weapon;
  ::init();
  if (interactive(ob = this_player())) {
    message_vision("$N眼睛一眨不眨地紧盯着进来的$n\n", this_object(), this_player());
    if (objectp(weapon = ob->query_temp("weapon"))
      && (string)weapon->query("skill_type") == "sword"
      && (int)ob->query("combat_exp") > 500000
      && present("gangjian", this_object())
      && !ob->query("marks/huashan/learn_sword")) {
      message_vision("$N对着$n呵呵笑着，这位" + RANK_D->query_respect(this_player()) +
        "的剑法看上去不赖啊，我就来领教领教。\n", this_object(), this_player());
      command("wield jian");
      set("force_factor", 10);
      set("chat_chance_combat", 0);
      this_player()->fight_ob(this_object());
      this_object()->fight_ob(this_player());
    }
    add_action("do_killing", "kill");
    add_action("do_qiujiao", "qiujiao");
    add_action("do_learn", "learn");
    add_action("do_skills", "skills");
    add_action("do_app", "apprentice");
  }
}
int do_killing(string arg) {
  object player, victim;
  player = this_player();
  if (!arg)
    return 0;
  if (objectp(victim = present(arg, environment(this_object())))) {
    if (victim->query("id") == this_object()->query("id")) {
      if (present("gangjian", this_object()));
      command("wield jian");
      return 0;
    } else if (victim->query("family/family_name") == "华山派") {
      message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n", this_object());
      if (present("gangjian", this_object()));
      command("wield jian");
      set("force_factor", 120);
      set("chat_chance_combat", 50);
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 0;
    } else return 0;
  } else return 0;
}
void killed_enemy(object ob) {
  command("say 哈哈, 不自量力的家伙！");
  set("force_factor", 120);
  set("chat_chance_combat", 50);
  if (present("gangjian", this_object()))
    command("unwield jian");
}
int accept_fight(object ob) {
  object weapon;
  if (objectp(weapon = ob->query_temp("weapon"))
    && (string)weapon->query("skill_type") == "sword") {
    command("say 我正愁没人跟我比剑呢？出招吧！");
    if (present("gangjian", this_object()))
      command("wield jian");
    set("chat_chance_combat", 0);
    set("force_factor", 10);
    return 1;
  }
  command("say 你又不使剑，我没有兴趣。");
  return 0;
}
int do_app(string arg) {
  object ob = this_player();
  if (arg != this_object()->query("id") || !arg) {
    tell_object(ob, "你要拜谁？\n");
    return 1;
  }
  if (ob->query("marks/huashan/learn_sword")) {
    message_vision("$N恭恭敬敬地向$n磕头请安，叫道：「师父！」\n", ob, this_object());
    command("haha");
    command("pat " + ob->query("id"));
    command("say 我是见你乃是块可雕良材，怕你被莫天雄那个朽木疙瘩给调教坏了，才在剑法上指点你一二，何必师徒相称。\n");
    return 1;
  } else if (ob->query_temp("marks/huashan/loser")) {
    command("heng " + ob->query("id"));
    command("say 就凭你那两手还想拜我，再去好好练练吧！\n");
    return 1;
  } else if (ob->query_temp("marks/huashan/winner")) {
    command("smile");
    message_vision("百里明说道：拜师不敢当，不过你能胜我，看来是块可雕之材，你可以向我学习(learn)有关剑法上的疑问！\n", ob);
    ob->set("marks/huashan/learn_sword", 1);
    ob->delete_temp("marks/huashan/winner");
    return 1;
  }
  return 0;
}
void lose_enemy(object winner)  //fight lose
{
  int sk = (int)winner->query_skill("sword", 1);
  if (present("gangjian", this_object()))
    command("unwield jian");
  command("haha");
  command("say 痛快，痛快，今天打得真过瘾！");
  if (sk < 250 && winner->query("class") == "huashan")
    winner->set_temp("marks/huashan/winner", 1);
  set("chat_chance_combat", 50);
  set("foce_factor", 120);
}
void defeated_enemy(string loser)  //fight win
{
  if (present("gangjian", this_object()))
    command("unwield jian");
  set("chat_chance_combat", 50);
  set("foce_factor", 120);
  command("heihei");
  command("say 凭你那两下子，还赢不了我的，再去练几年吧。");
  loser->set_temp("marks/huashan/loser", 1);
}
int do_learn(string arg) {
  object ob, me;
  string from;
  int pot, sk, amount, gin_cost;
  ob = this_object();
  me = this_player();
  sk = (int)me->query_skill("sword", 1);
  pot = (int)me->query("potential");
  if (!arg)
    return 0;
  if (sscanf(arg, "%s from %s with %d", arg, from, pot) != 3)
    return 0;
  if (arg != "sword" || from != ob->query("id"))
    return 0;
  if (!me->query("marks/huashan/learn_sword"))
    return notify_fail("百里云并不想教你。\n");
  if (pot <= 0)
    return notify_fail("潜能点最少是一！\n");
  if (!living(ob))
    return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");
  if (sk > 250)
    return notify_fail("百里云已不能再指点你什么了。\n");
  gin_cost = 100 / (int)ob->query_int();
  if ((int)me->query_skill("sword", 1) == 0) {
    gin_cost *= 2;
    me->set_skill("sword", 0);
  }
  gin_cost *= pot;
  if ((int)me->query("potential") - (int)me->query("learned_points") < pot)
    return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
  tell_object(me, "你向" + ob->name() + "请教有关「基本剑术」的疑问。\n");
  if ((int)me->query("gin") > gin_cost) {
    if ((sk * sk * sk) / 10 > (int)me->query("combat_exp")) {
      printf("也许是因为缺乏经验，你对%s的回答总是无法领会。\n", ob->name());
    } else {
      printf("你听了%s的指导，似乎有些心得。\n", ob->name());
      me->add("learned_points", pot);
      amount = (sk - 75) * SKILL_D("sword")->black_white_ness() / 100;
      if ((amount < -50) && (sk < 75)) amount = -50;
      amount += SKILL_D("sword")->learn_bonus() + (int)me->query_int() * (int)me->query_int() + to_int(pow(
        to_float((int)me->query("combat_exp")),
        0.3
      ));
      amount = amount / 50 + random(amount / 50);
      if (amount < 2) amount = 2;
      amount *= pot;
      me->improve_skill("sword", amount);
    }
  } else {
    gin_cost = me->query("gin");
    write("你今天太累了，结果什麽也没有学到。\n");
  }
  me->receive_damage("gin", gin_cost);
  return 1;
}
int do_skills(string arg) {
  object me, ob;
  string msg;
  me = this_player();
  ob = this_object();

  if (!arg || arg != ob->query("id"))
    return 0;
  if (wizardp(me))
    return 0;
  if (!me->query("marks/huashan/learn_sword"))
    return 0;
  msg = "基本剑术 (sword)                         - 深不可测 250/    0\n";
  tell_object(me, "百里云告诉你：我剑术的所学：\n" + msg);
  return 1;
}
int do_qiujiao(string arg) {
  string from;
  object me;
  int cz, lit;
  me = this_player();
  cz = (int)me->query("int", 1);
  lit = (int)me->query_skill("literate", 1);

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  if (!me->query("marks/huashan/learn_sword"))
    return notify_fail("百里云并不想教你。\n");
  if ((int)me->query_skill("huashan-sword", 1) < 150)
    return notify_fail("你的华山剑法所学不足，无法领悟太岳三青峰第三重。\n");
  if ((int)me->query("perform/huashan/taiyue", 1) < 2000)
    return notify_fail("你连太岳三青峰第二重都没有学会，何谈第三重！\n");
  if ((int)me->query("perform/huashan/taiyue") > 3000)
    return notify_fail("你已学会太岳三青峰第三重，百里云已不能指点你什么了。\n");
  if ((int)me->query("potential") < 30)
    return notify_fail("你的潜能不足，学习太岳三青峰第三重至少需要30点潜能。\n");
  if ((int)me->query("gin") < 40)
    return notify_fail("你的精力不足，该休息休息了。\n");
  if (sscanf(arg, "%s from %s", arg, from) == 2) {
    if (from != "baili" && from != "baili yun" && from != "yun")
      return notify_fail("你要向谁求教？\n");
    if (arg == "太岳三青峰" || arg == "taiyue") {
      tell_object(me, "你向百里云求教有关华山绝技「太岳三青峰」的疑问。\n");
      tell_object(me, "你听了百里云的指导，似乎有些心得。\n");
      me->add("perform/huashan/taiyue", cz + lit / 8 + random(20));
      me->add("potential", -30);
      me->add("gin", -40);
      if (me->query("perform/huashan/taiyue") >= 3000)
        tell_object(me, HIC "你学会了华山绝技--太岳三青峰第三重！\n" NOR);
      return 1;
    }
    return notify_fail("你只能向百里云求教太岳三青峰(taiyue)。\n");
  }
  return notify_fail("指令格式：qiujiao (perform) from (sb)\n");
}
