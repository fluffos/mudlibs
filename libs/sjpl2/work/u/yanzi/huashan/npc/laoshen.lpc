// laoshen.c
inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;
#include <ansi.h> 
int on_service = 0;

void create()
{
        set_name("老沈", ({ "laoshen", "shen" }) );
        set("gender", "男性");
        set("title", "凉茶沈");
        set("age",64);
        set("long",@LONG
他就是这间茶铺的老板，他看上去六十出头，多年的劳碌使得人浑身
黝黑，但仍然体格健壮，太阳穴高高鼓起，看上去并不只象一个普通的老头。
你可以用list看有什么可买的，用buy来购买。
LONG
        );
        set("int", 28);
        set("cor", 25);
        set("agi", 20);
        set("con", 20);
        set("str", 20);
        set("tol", 30);
        set("spi", 20);
        set("dur", 15);
        set("per", 10);
        set("fle", 20);
        set("cps", 30);
        set("max_force", 4500);
        set("force", 8000);
        set("force_factor", 120);
        set("combat_exp", 5000000);
        set("score", 80000);
//      set("daode", 59900);

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
        (: perform_action, "sword.taiyue" :),

        }) );
        set_skill("dodge", 250);
        set_skill("move", 250);
        set_skill("parry", 250);
        set_skill("sword", 270);
        set_skill("force", 250);
        set_skill("unarmed", 180);
        set_skill("literate", 120);
        set_skill("dg9-sword", 99);
        set_skill("hs-zhengqi", 250);
        set_skill("huashan-force", 250);
        set_skill("zixia-shengong", 250);
        set_skill("huashan-sword", 270);
        set_skill("huashan-strike", 200);
        set_skill("tianluo-steps", 240);
        set("perform/huashan/taiyue",3000);     //perform lvl = 3
        set("perform/huashan/yujian",2000);     //perform lvl = 2

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");
        map_skill("move", "tianluo-steps");

        create_family("华山派", 15, "弟子");

        set("inquiry", ([
                "独孤九剑" : "独孤九剑乃是天下无双的剑法，师父只传了我三句剑\n决，我花了二十余年仍无法完全悟得。\n",
                "令狐冲" : "令狐冲乃是我的师父，他是我华山派不世出的一代大侠。\n",
                "令狐传人" : "我师父一共收了两个弟子，我是一个，另一个是我师兄李志平。\n",
                "李志平" : "李师兄虽比我小，却先我拜入先师门下，他比我聪慧多了，听说已得师\n父剑法的真传，武功比先师有过之而无不及，师父去世后他便不知所踪，不知是否尚在人世。\n",
                "莫天雄" : "莫师弟武功了得，也是华山派的罕见人才，现正职掌我华山派门户。\n",
        ]));
        
        set("vendor_goods", ([
                __DIR__"obj/shuihu"  : 50,
                __DIR__"obj/liangcha"   :50,
                __DIR__"obj/huasheng"   :50,
                __DIR__"obj/guazi" :50,
                __DIR__"obj/bamboo_staff" :10,
        ]));

        setup();
        carry_object("/obj/cloth")->wear();
        carry_object(__DIR__"obj/gangjian");
}
void attempt_apprentice(object ob)
{
        if((int)ob->query("combat_exp") > 1000000
        && (int)ob->query("int") > 30
        && (int)ob->query_skill("sword") > 150
        && ob->query("class") == "huashan" ) {
        command("haha");
        command("say 难得华山竟然还有"+ RANK_D->query_respect(ob) +
"如此人才，老夫便破例收了你！\n");
        command("recruit " + ob->query("id") );
        return;
        }
        else {
        command("shake");
        command("say 老夫退隐江湖，又怎么会再收徒弟呢？");
        return;
        }
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
//              remove_call_out("greeting");
//              call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        add_action("do_killing", "kill");
        add_action("do_learn", "qiujiao");
}
int accept_fight(object ob)
{
        command("say 我人老了，不再过问江湖恩怨了。\n");
        return 0;
}
int do_killing(string arg)
{
        object player,victim;
        string name;
        player = this_player();
        if(!arg)
        return 0;
        if( objectp(victim = present(arg, environment(this_object()))))
        {
                name = victim->name();
                if (name == "老沈")
                {
                message_vision("$N大怒，阁下如此相逼，在下也就不退让了，看招。\n",this_object());
                command("wield jian");
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 1;
                }
                else if (victim->query("family/family_name")== "华山派") 
                {
                message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
                command("wield jian");
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 0;
                }
                else 
                command("say 老夫这小茶铺可不是给各位打架生事的！\n");
                message_vision("说着，$N便双手轻轻一挥。\n",this_object());
                tell_object(player,HIY"你只觉一股劲风袭来，整个人差点窒息过去，不得将攻势停下。\n"NOR);
                message_vision("$N一露身手，中止了这场即将开始的打斗。\n", this_object());
                return 1;
        }
        else return 0;
}
void killed_enemy(object ob)
{
        command("say 哈哈, 不自量力的家伙！");
        command("unwield jian");
}
int do_learn(string arg)
{
        string from;
        object me;
        int cz,lit;
        me = this_player();     
        cz = (int)me->query("int",1);
        lit = (int)me->query_skill("literate",1);

        if(me->is_busy() )      return notify_fail("你正忙着呢！\n");
        if (me->query("family/master_name")!= "老沈") 
                return notify_fail("你不是老沈的弟子。\n");
        if((int)me->query("gin") < 40) 
                return notify_fail("你的精力不足，该休息休息了。\n");
        if(sscanf(arg, "%s from %s", arg, from)==2 ) {
                if(from != this_object()->query("id")) 
                        return notify_fail("你要向谁求教？\n");
                if(arg == "太岳三青峰" || arg == "taiyue") {
                        if((int)me->query_skill("huashan-sword",1) < 150) 
                                return notify_fail("你的华山剑法所学不足，无法领悟太岳三青峰第三重。\n");
                        if((int)me->query("perform/huashan/taiyue",1) < 2000 )
                                return notify_fail("你连太岳三青峰第二重都没有学会，何谈第三重！\n");
                        if((int)me->query("perform/huashan/taiyue") >= 3000 )
                                return notify_fail("你已学会太岳三青峰第三重，老沈已不能指点你什么了。\n");
                        if((int)me->query("potential") < 30) 
                                return notify_fail("你的潜能不足，学习太岳三青峰第三重至少需要30点潜能。\n");
                        tell_object(me,"你向老沈求教有关华山绝技「太岳三青峰」的疑问。\n");
                        tell_object(me,"你听了老沈的指导，似乎有些心得。\n");
                        me->add("perform/huashan/taiyue", cz+lit/8+random(20));
                        me->add("potential", -30);
                        me->add("gin", -40);
                        if(me->query("perform/huashan/taiyue") >= 3000 ) 
                                tell_object(me,HIC"你学会了华山绝技--太岳三青峰第三重！\n"NOR);
                        return 1;
                }
                if(arg == "以气驭剑" || arg == "yujian") {
                        if((int)me->query_skill("zixia-shengong",1) < 120)
                                return notify_fail("你的紫霞神功所学不足，无法进一步领悟以气驭剑。\n");
                        if((int)me->query("perform/huashan/yujian") < 1000)
                                return notify_fail("你连以气驭剑的基本用法都没有学会，高级的更别谈了。\n");
                        if((int)me->query("perform/huashan/yujian") >= 2000)
                                return notify_fail("你已学会以气驭剑，老沈已不能指点你什么了。\n");
                        if((int)me->query("potential") < 30) 
                                return notify_fail("你的潜能不足，学习以气驭剑至少需要30点潜能。\n");
                        tell_object(me,"你向老沈请教有关华山绝技「以气驭剑」的疑问。\n");
                        tell_object(me,"你听了老沈的指导，似乎有些心得。\n");
                        me->add("perform/huashan/yujian", cz+lit/9+random(15));
                        me->add("potential", -30);
                        me->add("gin", -40);
                        if((int)me->query("perform/huashan/yujian") >= 2000 )
                                tell_object(me,HIC"你已完全掌握了华山绝技--以气驭剑！\n"NOR);
                        return 1;
                }
                return notify_fail("你只能向老沈求教什么？\n");
        }
        return notify_fail("指令格式：qiujiao (perform) from (sb)\n");
}

