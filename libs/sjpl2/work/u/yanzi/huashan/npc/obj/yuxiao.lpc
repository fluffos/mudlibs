// yuxiao.c

#include <weapon.h>
//inherit ITEM;
inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HIG "玉萧" NOR, ({ "yu xiao", "xiao" }));
  set_weight(500);
  seteuid(getuid());
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枝");
    set("long", "一枝通体碧绿，以上等玉石所制的萧。\n");
    set("value", 12000);
    set("material", "iade");
    set("wield_msg", "$N以萧代剑，拿出一枝$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_sword(50);
  setup();
}
void init() {
  add_action("do_play", "chui");
}
int do_play(string arg) {
  object *ob, me, target;
  int i, skill, heal;
  me = this_player();
  skill = me->query_skill("music", 1);
  if (me->is_fighting())
    return notify_fail("战斗中无法吹箫！\n");

  switch (arg) {
    case "清心普善咒":
    case "qingxin":
      if (skill < 100)
        return notify_fail("你的琴音韵律所学不足！\n");
      if (((int)me->query("force") - (int)me->query("max_force")) < 200)
        return notify_fail("你的真气不够。\n");
      message_vision(HIG "$N以萧代琴，吹起一曲《清心普善咒》。\n" NOR, me);
      me->set("force", (int)me->query("max_force"));
      heal = skill / 2;
      break;
    case "笑傲江湖":
    case "xojh":
      if (skill < 200)
        return notify_fail("你的琴音韵律所学不足！\n");
      if (((int)me->query("force") - (int)me->query("max_force")) < 400)
        return notify_fail("你的真气不够。\n");
      if (!present("yan yu", me))
        return notify_fail("《笑傲江湖》必须琴萧合奏！\n");
      if (!present("xojh book", me))
        return notify_fail("你身上没有笑傲江湖曲谱，如何演奏？\n");
      message_vision(HIG "$N一手弹七弦琴，一手持玉萧，琴萧合奏，正是一曲《笑傲江湖》！\n" NOR, me);
      me->set("force", (int)me->query("max_force"));
      heal = skill;
      break;
    default:
      return notify_fail("你要吹什么？\n");
  }
  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    heal = skill;
    if (heal > 0) {
      ob[i]->receive_heal("gin", heal);
      ob[i]->receive_heal("sen", heal);
      tell_object(ob[i], "你只觉得曲声时而慷慨激昂，时而温柔雅致，回旋婉转，不觉整个人都沉醉其中。\n");
    }

  }
  return 1;
}
