// xuantieling.c

inherit ITEM;

void create() {
  set_name("魔教玄铁令", ({ "xuantie ling", "ling" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块锈迹斑斑的铁牌，也是当年群雄在大战所为的魔教玄铁令，\n据说上面记载着极高深的心法。\n");
    set("value", 20000);
    set("material", "icon");
  }
}
int init() {
  add_action("do_learn", "du");
  add_action("do_learn", "study");
}
int do_learn(string arg) {
  object me, fire;
  int my_skill;
  me = this_player();

  if (!arg || (arg != "xuantieling" && arg != "ling")) return 0;
  if ((int)me->query_skill("literate") < 80) {
    write("玄铁令上的字很古怪，你看不懂。\n");
    return 1;
  };

  my_skill = my_skill = me->query_skill("force", 1) / 2;

  if (my_skill * my_skill * my_skill > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你对玄铁令上的文字总是无法理解。\n");
    return 1;
  }
  if (me->query("sen") < 40) {
    write("你的确太困倦了。\n");
    return 1;
  }
  me->add("sen", (-1) * random(40));
  message_vision("$N正专心研究手中的玄铁令。\n", me);
  if ((int)me->query_skill("force", 1) < 150) {
    me->improve_skill("force", random(me->query("int") + me->query_skill("literate", 1) / 5));
    write("你认真研究玄铁令上的文字，似乎对内功心法有点心得。\n");
  } else
    write("玄铁令上的内功心法对于你来说已经太浅了。\n");
  return 1;
}
