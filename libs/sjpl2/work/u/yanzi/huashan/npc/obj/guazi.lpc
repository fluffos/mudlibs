// guazi.c

inherit ITEM;

string *titles = ({
  "奶油瓜子", "五香瓜子",
  "葵花子", "酱油瓜子",
  "陈皮瓜子", "小刘瓜子",
});


void create() {
  int i = random(sizeof(titles));
  set_name(titles[i], ({ "guazi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碟香脆的瓜子。\n");
    set("unit", "碟");
    set("value", 50);
    set("remaining", 5);
    set("food_supply", 15);
  }
  setup();
}
void init() {
  add_action("do_eat", "eat");
}


int do_eat(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (!ob->id(arg)) return 0;
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if ((int)me->query("food") >= (int)me->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也吃不下了。\n");

  set("value", 0);
  me->add("food", (int)query("food_supply"));

  if (me->is_fighting()) me->start_busy(2);

  add("remaining", -1);
  if (query("remaining")) {
    message_vision("$N抓起一把" + ob->query("name") + "送进嘴里, 一边吃一边还吐出许多瓜子壳。 \n", me);
  } else {
    message_vision("$N拿起碟子，把剩下的" + ob->query("name") + "吃了个精光。\n", me);
    message_vision("$N将碟子往后一扔，咋咋嘴，赞道：好香！\n", me);
    destruct(this_object());
  }

  return 1;
}
