// thekid.c
inherit NPC;
#include <ansi.h> 

int count =0;
int ct_ok =0;
int ask_me();

void create()
{
        set_name("徐达", ({ "xu da", "xu" }) );
        set("gender", "男性");
        set("nickname", HIR"追魂夺命剑"NOR);
        set("age",37);
        set("long",@LONG
徐达原为魔教中人，四年前因称欲改邪归正而投于华山门下，但其为
人仍保留在魔教的作风，出手毒辣，常奉师命下山诛杀那些大奸大恶
之人每次都完成得十分漂亮，因此莫天雄十分信任他，派他在这看守
内书房。徐达一身武功融正邪于一身，已是一等一的高手。
LONG
        );
        set("attitude", "peaceful");
        set("int", 20);
        set("cor", 25);
        set("agi", 18);
        set("con", 25);
        set("str", 30);
        set("tol", 15);
        set("spi", 17);
        set("dur", 23);
        set("per", 12);
        set("fle", 21);
        set("cps", 19);
        set("max_force", 2000);
        set("force", 3500);
        set("force_factor", 70);
        set("combat_exp", 800000);
        set("score", 30000);
        set("daode", 5000);

        set_skill("dodge", 140);
        set_skill("parry", 140);
        set_skill("sword", 140);
        set_skill("force", 120);
        set_skill("unarmed", 120);
        set_skill("literate", 50);
        set_skill("hs-zhengqi", 30);
        set_skill("huashan-force", 120);
        set_skill("huashan-sword", 140);
        set_skill("huashan-strike", 120);
        set_skill("tianluo-steps", 140);
//      set_skill("tm-sword", 150);

        set("perform/huashan/taiyue",1000);

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "huashan-force");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");

        create_family("华山派", 16, "弟子");
        set("inquiry", ([
                "卧底": (: ask_me :),
                "紫霞秘籍": (: ask_me :),
        ]) );

        setup();
        carry_object(__DIR__"obj/longsword");
        carry_object("/obj/cloth")->wear();
}
void killed_enemy(object ob)
{
        command("say 哈哈, 不自量力的家伙！");
        command("unwield jian");
}
int accept_fight(object ob)
{
        command("say 进招吧！");
        command("wield jian");
        return 1;
}
int ask_me()
{
        int i;
        object *ob, book;
        count++;
        if(count<2 ) {
        command("say 哼！我不懂你的意思！\n");
        return 1;
        }
        if(count == 2) {
        command("say 你不要在这里和我胡搅蛮缠！\n");
        return 1;
        }
        if(count == 3) {
        command("say 你再不走，我就不客气了！\n");
        return 1;
        }
        if(ct_ok == 0) {
        command("say 你小子确实有两下子，能查到我实乃魔教卧底，来华山只是为了紫霞秘籍，不过\n你只能把这个秘密带到地狱了！\n");
        command("grin");
        book=new(__DIR__"obj/zixia-paper");
        book->move(this_object());
        set("bellicosity", 10000);
//      set("daode", -30000);
//      map_skill("sword", "tm-sword");
        command("wield jian");
        ob = all_inventory(environment());
        for(i=sizeof(ob)-1; i>=0; i--) {
                if( !ob[i]->is_character() || ob[i]==this_object() ) continue;
                kill_ob(ob[i]);
                ob[i]->fight(this_object());
                }
        ct_ok=1;
        count=0;
        return 1;
        }
}
void init()
{
        add_action("do_killing", "kill");
}
int do_killing(string arg)
{
        object player,victim;
        player = this_player();
        if(!arg)
        return 0;
        if( objectp(victim = present(arg, environment(this_object()))))
        {
                if(victim->query("id") == this_object()->query("id")) {
                        if(present("changjian",this_object()));
                                command("wield changjian");
                        return 0;
                }
                else if (victim->query("family/family_name")== "华山派" ) {
                message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
                if( present("changjian",this_object()) );
                        command("wield changjian");
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 0;
                }
                else return 0;
        }
        else return 0;
}
