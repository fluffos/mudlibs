// Room: /u/yanzi/huashan/qunxian.c

inherit ROOM;

void create() {
  set("short", "[1;36m群仙观[2;37;0m");
  set("long", @LONG
这里是华山之上的群仙观，供奉着太上老君，原始天尊等众多道
教仙翁的塑像，因而得名，来华山游览的游客都喜欢在这里歇歇脚，
然后再攀登北峰，地上放着几个蒲团，是供人膜拜群仙之用。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/laodao": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "southup": __DIR__ "laojun",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_drop", "drop");
  add_action("do_put", "put");
  add_action("do_give", "give");
}
int do_drop() {
  if (this_player()->query_temp("allow_quan")) {
    tell_object(this_player(), "为了防止利用drop来牟利，这里禁止drop！\n");
    return 1;
  }
}
int do_put() {
  if (this_player()->query_temp("allow_quan")) {
    tell_object(this_player(), "为了防止利用put来牟利，这里禁止put！\n");
    return 1;
  }
}
int do_give() {
  if (this_player()->query_temp("allow_quan")) {
    tell_object(this_player(), "为了防止利用give来牟利，这里禁止give！\n");
    return 1;
  }
}
int valid_leave(object me, string dir) {
  if (me->query_temp("allow_quan")) me->delete_temp("allow_quan");
  return ::valid_leave();
}
