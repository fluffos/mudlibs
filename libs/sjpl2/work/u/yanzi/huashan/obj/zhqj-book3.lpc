//zhqj-book3.c

inherit ITEM;

void create() {
  set_name("正气决--下", ({ "zhengqi-jue3", "zhangqijue", "book", }));
  set_weight(600);
  set("unit", "张");
  set("long", "这是几张介绍华山正气决精要的纸片。\n");
  set("value", 0);
  set("skill", ([
    "name": "hs-zhengqi",          // name of the skill
    "exp_required": 200000,               // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 25,                  // gin cost every time study this
    "difficulty": 25,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 150   // the maximum level you can learn from this object.
  ]));
}
