//zhqj-book.c

inherit ITEM;

void create() {
  set_name("掌法入门", ({ "strike-book", "book", }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本主要供华山新弟子学习掌法所用的书，不过由于华山并不精于掌法，因而写得十分简单。\n");
  set("value", 100);
  set("skill", ([
    "name": "unarmed",          // name of the skill
    "exp_required": 0,               // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 20,                  // gin cost every time study this
    "difficulty": 30,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 20   // the maximum level you can learn from this object.
  ]));
}
