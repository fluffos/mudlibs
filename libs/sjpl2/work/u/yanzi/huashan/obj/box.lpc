//box.c
inherit ITEM;

void create() {
  set_name("铁盒", ({ "box" }));
  set_weight(300);
  set_max_encumbrance(100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个已被打开的铁盒，里面什么都没有，可以用来放东西。\n");
    set("unit", "个");
    set("value", 500);
  }
  setup();
}
