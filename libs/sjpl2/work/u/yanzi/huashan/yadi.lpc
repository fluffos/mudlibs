// Room: /u/yanzi/huashan/yadi.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIC "崖底" NOR);
  set("long", @LONG
你走到了山谷的尽头，这里一侧是一条十分陡峭的山崖，几根蔓
藤从从崖上垂下，附在崖壁之上。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "southwest": __DIR__ "gudi3",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string arg) {
  object me = this_player();
  if (!arg || arg != "up")
    return notify_fail("你要往哪里爬？\n");
  message_vision("$N攀着藤蔓，很艰难地向上爬。哎呀唷。，哎呀。。唷。。\n", me);
  me->move(__DIR__ "lianhua");
  message("vision", me->name() + "从突然从崖底下爬了上来。\n", environment(me), me);
}
