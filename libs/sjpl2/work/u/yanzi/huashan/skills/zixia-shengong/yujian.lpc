// yujian.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount, object weapon);

int exert(object me, object target, object weapon) {
  int skill;
  skill = me->query_skill("zixia-shengong", 1);

  if (target != me)
    return notify_fail("「以气驭剑」只能对自己起作用。\n");
  if ((int)me->query_temp("yujian"))
    return notify_fail("你已经在运功中了。\n");
  if (!objectp(weapon = target->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所持武器不对。\n");
  if ((int)me->query("perform/huashan/yujian") < 1000)
    return notify_fail("你还没有学会「以气驭剑」！\n");
  else if ((int)me->query("perform/huashan/yujian") < 2000) {
    if ((int)me->query("force") < 150)
      return notify_fail("你的内力不够。\n");
    me->add("force", -150);
    message_vision(MAG "$N「以气驭剑」，只见其手中$n" + MAG "只是被一阵薄薄的紫雾所笼罩，想是所学不精吧！\n" NOR, me, weapon);
    me->add_temp("apply/damage", skill / 4);
    me->set_temp("yujian", 1);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 4 :), skill);
    if (me->is_fighting()) me->start_busy(2);
    return 1;
  } else {
    if ((int)me->query("force") < 300)
      return notify_fail("你的内力不够。\n");
    me->add("force", -300);
    message_vision(MAG "$N「以气驭剑」，，只见其手中$n" + MAG "顿时紫气暴长，剑刃上闪烁着磷磷紫光！\n" NOR, me, weapon);
    me->add_temp("apply/damage", skill / 2);
    me->set_temp("yujian", 1);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);
    if (me->is_fighting()) me->start_busy(2);
    return 1;
  }
}

void remove_effect(object me, int amount, object weapon) {
  me->add_temp("apply/damage", -amount);
  me->delete_temp("yujian");
  tell_object(me, "你运功完毕，剑上紫气逐渐消失，恢复原状。\n");
}
