inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"青柯坪"NOR);
	set("long", @LONG
走过崎岖的十八盘，就来到了青柯坪。青柯坪是一山间盆地，地
势略为平坦。远远望见一个小小石亭，便是赌棋亭了。相传宋太祖与
华夷先生曾弈棋于此，将华山作为赌注，宋太祖输了，从此华山上的
土地就不须缴纳钱粮。
    从这里往西上山，可到狮子岭，东面有快大石，就是回心石了。
LONG
	);
	set("outdoors", "huashan");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 3 */
  "westdown" : __DIR__"18pan",
  "east" : __DIR__"huixin",
  "westup" : __DIR__"road1",
]));

	setup();

}
