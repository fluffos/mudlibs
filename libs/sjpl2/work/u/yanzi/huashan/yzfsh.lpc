inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIC "鹞子翻身" NOR);
  set("long", @LONG
这里是华山两大绝险之处之一的鹞子翻身，既使是鹞子来这里，
也要翻身，几个武林人士在这里跳来跳出，似乎在炫耀自己的绝世轻
功。
LONG
  );
  set("outdoors", "huashan");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "westdown": __DIR__ "ntmen",
  ]));

  setup();
}
void init() {
  add_action("do_jump", "jump");
}
