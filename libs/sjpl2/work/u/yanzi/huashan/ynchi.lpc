// Room: /u/yanzi/huashan/ynchi.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIC "玉女池" NOR);
  set("long", @LONG
一来到这，你大吃一惊，想不到在华山绝顶之上，竟还有这么一
个水池，传说这里因为处于极高之处，吸收天地精华，水质特别清纯
，乃是上天玉女沐浴的所在，往池中望去，清澈见底，闪烁着磷磷碧
光，确实与众不同，周围长满个各色树木花朵。
LONG
  );
  set("outdoors", "huashan");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "southwest": __DIR__ "beifeng",
  ]));

  setup();
}
void init() {
  add_action("do_fillwater", "fillwater");
  add_action("do_drink", "drink");
  add_action("do_jump", "jump");
}
int do_fillwater(string arg) {
  object *list, ob;
  int i, can_fillwater;
  string dir;

  if (!arg || arg == "") {
    write("你要往什么东西里灌水？\n");
    return 1;
  }
  if (!ob = present(arg, this_player())) {
    write("你身上没有这个东西。\n");
    return 1;
  }

  if (ob->query("liquid/type") == "alcohol"
    || ob->query("liquid/type") == "water") {
    ob->set("liquid", ([
      "type": "water",
      "name": HIG "玉女池水" NOR,
      "remaining": 15,
      "drunk_apply": 6,
    ]));
    write("你从玉女池里装满了池水! \n");
    return 1;
  } else {
    write("你没有装水的东西啊....\n");
    return 1;
  }
}
int do_drink(string arg) {
  object ob;
  ob = this_player();

  if (ob->is_busy())
    return notify_fail("你正忙着其他事情呢。\n");
  if ((int)ob->query("water") >= (int)ob->max_water_capacity())
    return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
  ob->set("water", (int)ob->max_water_capacity());
  if (ob->is_fighting()) ob->start_busy(2);
  message_vision("$N伏到玉女池边喝了个够。\n", ob);
  return 1;
}
int do_jump(string arg) {
  object me = this_player();

  if ((!arg) || (!(arg == "chi" || arg == "池")))
    return notify_fail("你要往哪里跳？\n");

  message_vision("$N一下子跳进了玉女池中。\n", me);
  me->move(__DIR__ "chizhong");
  return 1;
}
