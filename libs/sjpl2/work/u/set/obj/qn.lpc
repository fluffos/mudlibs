// qn.c 潜能神丹
inherit ITEM;
int do_eat(string);
void init();
void init() {
  if (!wizardp(this_player())) {
    set("no_get", "嘿嘿，做梦吧! \n");
    set("no_drop", "这么宝贵的潜能神丹，哪能乱扔! \n");
  }
  add_action("do_eat", "eat");
}
void create() {
  set_name("潜能神丹", ({ "qianneng dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "一粒潜能神丹，据说有增加潜能之效。\n");
    set("value", 100000);
  }
  set("is_monitored", 1);
  setup();
}
int do_eat(string arg) {
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (!this_player()->query_temp("wiz_prize")) return 0;
  victim->add("potential", 20000);
  victim->save();
  if (userp(victim)) log_file(
    "RECOVER",
    sprintf("%s(%s) Got recovered on %s.\n", victim->name(1), geteuid(victim), ctime(time()))
  );
  message_vision("\n$N吃下一粒潜能神丹，只觉得浑身发热，你的潜能增加了。\n\n", victim);
  destruct(this_object());
  return 1;
}
