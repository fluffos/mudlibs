// beer.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("蓝带啤酒", ({ "beer", "pijiu" }) );
        set_weight(700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一听从美国进口的的啤酒，看起来度数很低。\n");
                set("unit", "听");
                set("value", 20);
                set("max_liquid", 15);
        }
        set("liquid", ([
                "type": "alcohol",
                "name": "啤酒",
                "remaining": 15,
                "drunk_apply": 6,
        ]) );
}
