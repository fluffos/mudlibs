// xxsheng.c  by set
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "" HIR + BLINK "爱苗轩" NOR "");
  set("long", HIM @LONG

    这是一间明亮而整洁的房间，明媚的阳光从窗户射进来，照在古朴、典雅的家具
上，透出一份温馨、和谐的气氛。房子被女主人收拾的一尘不染。如蝉翼般丝薄的淡
篮色窗帘被微风轻轻吹起，有如仙女的长裙在随风摇曳，不时飘来淡淡的清香。屋内
的家具也以淡蓝色为主，古朴、典雅、安静、祥和。心形的冰玉床是男主人精心设计
的，冰玉床(bed)的四周挂着淡蓝色的蓝丝帷幕，帷幕被从窗户吹进的微风轻轻掀起，
露出床上铺放整齐的蓝丝凉被，整个房间充满着浓浓爱意。一切都是如此的简单却又
都是被精心设计过的。床前是北浪特意为爱妻苗苗新买的梳妆台(cabinet)。
LONG NOR);
  set("item_desc", ([ "bed": "这是一张心形的冰玉床。(gosleep,gobed,bed)。 \n", ]));
  set("item_desc", ([ "梳妆台": "这是用上好的楠木打做的梳妆台，上面放了好多叫不上名的化妆品，下面还有一个抽屉。\n", ]));
  set("item_desc", ([ "cabinet": "这是用上好的楠木打做的梳妆台，上面放了好多叫不上名的化妆品，下面还有一个抽屉。\n", ]));
  set("exits", ([ /* sizeof() == 4 */
    "south": "/u/set/room/hualang2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/u/set/obj/bingxiang": 1,
    "/obj/toy/baby_tiger": 1,
  ]));
  set("no_clean_up", 0);
  //        set("valid_startroom", 1);
  setup();
}
void init() {
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed");
  add_action("do_bed", "bed");
}
int do_bed() {
  object me;
  me = this_player();
  message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  me->move(__DIR__ "bed_xxsheng");
  message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}
void reset() {
  object *inv;
  object con, item;
  int i;

  ::reset();
  con = present("bingxiang", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 8) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new("/u/set/obj/beer");
    item->move(con);
    item = new("/d/city/obj/food/dishes/dish09");
    item->move(con);
    item = new("/d/city/obj/food/dishes/dish07");
    item->move(con);
    item = new("/d/city/obj/food/dishes/dish08");
    item->move(con);
  }
}
