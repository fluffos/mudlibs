//room:player
#include <ansi.h>
inherit ROOM;
string look_sig(object me);
void create() {
  set("short", "小院");
  set("long", @LONG
白色的围墙里这里是一片安静的院落是弟子们日常起居的场所，
新修葺的葛草屋顶，散发着幽幽的清新。如果你愿意可以有自
己一套单独的小屋。门口挂着一块木牌(sign).
LONG
  );
  set("exits", ([
    "west": __DIR__ "xy2",
    "east": __DIR__ "room",
  ]));
  set("home", ({
    ([ "id": "lark",
      "name": "海青",
    ]),
    ([
      "id": "fyy",
      "name": "飞越",
    ]),
    ([
      "id": "xzero",
      "name": "唠唠叨叨的:飞影",
    ]),
    ([
      "id": "zht",
      "name": "还算正常的:欢乐英雄",
    ]),

    ([
      "id": "zlly",
      "name": "黑山*老妖",
    ]),
    ([
      "id": "pta",
      "name": "清花",
    ]),
    ([
      "id": "yhws",
      "name": "天才",
    ]),
    ([
      "id": "sttt",
      "name": "爱发牢骚的：宋图腾塔",
    ]),
    ([
      "id": "xiaoln",
      "name": "小龙女",
    ]),
    ([
      "id": "noheart",
      "name": "无心",
    ]),
  }));
  set("item_desc", ([
    "sign": (: look_sig :),
  ]));
  setup();
  call_other("/obj/board/xiaoyao-board", "???");
}

string look_sig(object me) {
  string msg;
  mapping *rooms, room;
  int i, n;

  rooms = query("home");
  n = sizeof(rooms);
  if (n == 0) return "逍遥派人丁单薄没有新弟子加入！\n\n";
  msg = HIC "我们逍遥的兄弟姐妹在这里开房的有：\n\n" NOR HIC "※※※※※※※※※※※※※※※※※※※※※※※※\n" NOR;
  for (i = 0; i < n; i++) {
    room = rooms[i];
    msg += sprintf(HIC "※" HIM "  %-30s%-12s" NOR "\n",
      room["id"], room["name"]);
  }

  msg += HIC "※※※※※※※※※※※※※※※※※※※※※※※※\n" NOR;
  msg += "\n"
    "逍遥弟子如果需要自己的房间，需要在post上进行申请，并付一定费用(10 gold),否则\n"
    "统一在公共休息室休息\n"
    "1. 进自己家用huijia 指令\n"
    "2. 进别人家用 chuanmen <sb> 指令\n"
    "\n"
    "在自己家里可使用以下命令：\n"
    "\n"
    "allowin <sb>    ：给此人以串门的权利\n"
    "preventin <sb>  ：取消此人串门的权利\n"
    "privatehere     ：不让任何人来串门\n"
    "savehere        ：当你下次连线进来时，会从家里开始\n";
  return msg;
}


void init() {
  if (this_player()->query_temp("clear"))
    add_action("do_clear", "clear");
  add_action("huijia", "huijia");
  add_action("chuanmen", "chuanmen");
}

int huijia(string arg) {
  mapping *rooms, room;
  int i, n;
  string meid;

  if (arg) notify_fail("Syntax error : 只用敲 huijia\n");
  rooms = query("home");
  if (!mapp(rooms)) notify_fail("现在所有的房子都是空的！\n");
  n = sizeof(rooms);
  meid = this_player()->query("id");
  for (i = 0; i < n; i++) {
    room = rooms[i];
    if (room["id"] == meid) {
      tell_room(__DIR__ "playerroom/" + meid,
        this_player()->name() + "回家来了！\n");

      tell_object(this_player(),
        "回家啦！真温馨！\n\n");
      this_player()->move(__DIR__ "playerroom/" + meid);
      tell_object(__FILE__, this_player()->name() +
        "打开家门走了进去\n");
      return 1;
    }
  }
  return notify_fail("你还没在这里申请房子呢！\n");
}

int chuanmen(string dir) {
  string meid, roomfile;
  object ob, me = this_player();
  mapping *rooms, room;
  int i, n;

  if (!dir) return notify_fail("Syntax error: canguan <sb>\n");
  meid = me->query("id");
  if (dir == meid) return notify_fail("啥？参观自己家？\n");
  rooms = query("home");
  n = sizeof(rooms);
  if (n == 0) notify_fail("现在所有的房子都是空的！没法串门！\n");
  for (i = 0; i < n; i++) {
    room = rooms[i];
    if (room["id"] == dir) {  // the home exists
      roomfile = "/u/lark/xiaoyao/playerroom/" + dir;
      tell_room(roomfile, "Hi! 有客人!\n");
      if (!(ob = find_object(roomfile))) {
        return 0;
      }
      if (!wizardp(me) && !ob->query("right/" + meid)) {
        tell_object(me, ob->query("refusemsg"));
        message("vision", me->name() + "很狼狈的走过来，好象是被人赶出来的！\n",
          "/u/wuhan/dragon_residence", me);
        me->move(this_object());
        return 1;
      }
      break;
    }
  }
  if (i == n)    // there is no such room
    return notify_fail("此人在这儿没有住房!\n");

  // ok you can enter
  tell_object(ob, me->name() + "敲敲门走了进来，一边叫道：我来了！\n");
  message_vision("$N敲敲" + room["name"] + "的门走了进去！\n\n",
    this_player());
  me->move(ob);
  return 1;
}

int do_clear(string arg) {
  int n;
  if (this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n");
  if (arg)
    return notify_fail("打扫院子?？(clear)\n");
  if (this_player()->query_temp("busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query("sen") < 40 && this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("busy", 1);
  if (this_player()->query_temp("num") == this_player()->query_temp("clear")) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N擦了擦额头的汗水，拍拍身上的粘满的尘土收工了!\n", this_player());
    this_player()->delete_temp("clear");
    this_player()->delete_temp("num");
    this_player()->set_temp("over", 1);
    this_player()->delete_temp("busy");
    return 1;
  }
  message_vision("$N正在认真的打扫院子\n", this_player());
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);
  return 1;
}



void improve(object who) {

  object ob;

  who->improve_skill("dodge", random((int)who->query("int")));
  who->add("sen", -(35 - (int)who->query_skill("dodge", 1) / 5));
  who->add("gin", -(35 - (int)who->query_skill("dodge", 1) / 5));

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
}
