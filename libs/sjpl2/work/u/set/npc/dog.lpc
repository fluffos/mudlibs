inherit NPC;

void create() {
  set_name("水晶花儿", ({ "qwertyuiop" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 20);
  set("long", "这是一只凶猛无比的金毛吼\n");

  set("str", 48);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 600);
  set("max_gin", 600);
  set("max_sen", 900);
  set("attitude", "aggressive");
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "claw" }));
  set("max_force", 3600);
  set("force", 3600);
  set("force_factor", 800);

  set("combat_exp", 1900000);
  set("bellicosity", 30000);
  set_skill("dodge", 200);
  set_skill("unarmed", 100);

  set_temp("apply/attack", 100);
  set_temp("apply/armor", 220);
  set_temp("apply/damage", 100);
  setup();
  add_money("gold", 100);
  carry_object("/u/set/obj/qn");
  carry_object("/u/baiwt/xueshan/xsobj/windsheet");
  carry_object("/u/lark/xiaoyao/obj/book1");
  carry_object("/u/baiwt/xueshan/obj/jade2");
}
