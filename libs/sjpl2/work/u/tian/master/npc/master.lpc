// wangqr.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("石海风", ({ "shi haifeng", "master", "shi" }));
  set("nickname", HIY "酒仙神丐" NOR);
  set("title", "丐帮第七代帮主");
  set("gender", "男性");
  set("age", 55);
  set("long",
    "他就是丐帮的现任帮主，施楠的嫡传弟子，其武功人品都超过了师父当年的风采。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？必须先通过打狗阵的修行，把破碗拿来。",
    "老帮主": "哎，老帮主已经失踪多年。",
    "打狗帮": "打狗帮被老帮主的师弟北宫平盗走了。",
    "打狗阵": "过打狗阵随时都有死的危险，你要想清楚呀。",
  ]));
  set("str", 56);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("max_kee", 8000);
  set("kee", 8000);
  set("force", 9500);
  set("max_force", 9000);
  set("force_factor", 150);
  set("combat_exp", 8000000);

  set_skill("unarmed", 280);
  set_skill("sword", 200);
  set_skill("force", 280);
  set_skill("parry", 280);
  set_skill("dodge", 280);
  set_skill("stick", 280);
  set_skill("begging", 280);

  set_skill("iron_strike", 250);
  set_skill("xianglong_strike", 250);
  set_skill("hidden_dodge", 250);
  set_skill("canyun_force", 250);
  set_skill("literate", 80);
  set_skill("penyuntuwu", 80);
  set_skill("qingyun_stick", 250);
  set_skill("hitdog_stick", 250);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 8, "弟子");

  setup();

  carry_object(__DIR__ "obj/green_stick")->wield();
  carry_object(__DIR__ "obj/linen")->wear();
}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "dog-stick") {
    command("say 别这么做！！");
    command("say 这不是我们丐帮的打狗棒。\n");
  } else {
    command("say 多谢帮我找回了打狗棒。");
    command("say 我把这本秘籍传受于你吧！");
    ob = new(__DIR__ "obj/canyun_book");
    ob->move(me);
    me->set("title", "丐帮掌棒龙头");
    me->set("marks/baishi", 1);
  }
  return 1;
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/baishi")) {
    command("say 这位" + RANK_D->query_respect(ob) + "还是先向传功长老讨教武功吧。\\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->delete("marks/baishi", 1);
    ob->set("title", "丐帮掌棒龙头");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
