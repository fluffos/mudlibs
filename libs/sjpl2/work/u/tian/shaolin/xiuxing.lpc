// xiuxing.c 修行室
#include <room.h>
inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "修行室");
  set("long", @LONG
这里便是少林寺弟子领取任务的地方，凡是少林弟子都可以
到此请求各种各样的任务，来验证自己修行的功力如何，也会得
到很多好处。不过要是完不成，嘿嘿，可要小心了。
    这里墙上挂着个木牌(sign)。木牌边好象有只毛笔，有个老
年僧人站在一边。
LONG
  );

  set("exits", ([
    "north": __DIR__ "liangong3",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/huiguang": 1,
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "sign": "少林寺修行室布告：

    少林弟子可以到此申请任务，任务有各种各样，完成后有
不同的奖励。要是完不成，可以到此注销，但要扣经验和声望。
希望少林弟子努力。

以下是有关的命令：
        申请：shenqing 任务
        查看：chakan
        完成：wancheng
        注销：zhuxiao

                          少林弟子修行室
",
  ]));


  setup();
}

void init() {
  add_action("do_search", ({ "search", "zhao" }));
}

int do_search(string arg) {
  object ob;

  if (arg != "木牌") return 0;
  if ((int)query("zhao1") == 1)
    return notify_fail("这是一个木牌，写着些字。\n");
  set("zhao1", 1);
  message_vision("$N找到什么东西。\n", this_player());
  ob = new(__DIR__ "obj/maobi");
  ob->set("own_name", this_player()->query("id"));
  ob->move(this_player());
  return 1;
}

void reset() {
  ::reset();
  delete("zhao1");
}
