//cjge2  藏经阁二楼
inherit ROOM;

string look_fojing();
string look_book();
string *book = ({
  "『未曾有经』", "magic", 20, 20,
  "『无常经』", "force", 20, 20,
  "『大孔雀经』", "parry", 20, 20,
  "『去烦恼经』", "dodge", 20, 20,
  "『无色无相经』", "buddhism", 20, 20,
  "『多罗叶经』", "unarmed", 20, 20,

  "『大智度经』", "sword", 20, 20,
  "『波罗蜜多心经』", "blade", 20, 20,
  "『菩萨戒经』", "throwing", 20, 20,
  "『首楞严经』", "staff", 20, 20,
  "『菩萨经』", "magic", 10, 20,
  "『释迦经』", "buddhism", 10, 20,
});

void create() {
  set("short", "藏经阁二楼");
  set("long", @LONG
这是藏经阁二楼，只见阁中窗明几净，打扫的纤尘不染。左右两排
红木书架摆满了佛经，几个中年僧人正专心致志的默读佛经。有个老年
僧人在整理架上的经书。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "up": __DIR__ "cjge3",
    "down": __DIR__ "cjge1",
  ]));
  set("item_desc", ([
    "书架": (: look_book :),
    "佛经": (: look_fojing :),
    "格子": "每个书架分成六个格子，里面的佛经排放整齐。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/oldseng": 1,
  ]));

  set("no_fight", 1);
  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  object me = this_player(), seng;

  this_player()->set_temp("left", 6);

  add_action("do_du", ({ "read" }));
  add_action("do_zou", ({ "zou" }));

  seng = present("old seng", environment(me));
  if (!seng) {
    seng = new(__DIR__ "npc/oldseng");
    seng->move(this_object());
  }

}

void reset() {
  ::reset();
  //	delete("left");
  //	delete("right");
}

int valid_leave(object me, string dir) {
  string class_name;
  object seng, room;

  seng = present("old seng", environment(me));
  class_name = me->query("class");
  if (dir != "up") return 1;
  if (class_name != "shaolin" && class_name != "shaolin1") {
    if (objectp(seng)) {
      return notify_fail("老僧伸手拦住你，笑着说道：“施主请留步。”\n");
    }
    write("你刚登上上楼的楼梯，突听后面有人大喊：来人呀，有人要闯藏经阁！\n\n");
    write("只听后面跑来几个少林武僧，领头的一个指着你喊道：大胆狂徒，哪里跑！\n");
    write("你心里一慌，脚下一软，竟然坐到地上，被武僧上前按住，五花大绑捆了起来。\n\n");
    write("领头武僧说：哈哈，你小子好大胆，敢在少林寺撒野，把他丢到地牢里去！\n");
    write("你被武僧推推搡搡地带到地牢门口，武僧打开铁门，一把将你推了进去。\n\n");
    room = (object)__DIR__ "dilao";
    message("vision", "只听“哐铛”一声，铁门打开，接着一个人踉跄着进来，差点摔到你身上。\n", room);
    me->move(room);
    message("vision", "\n只听的耳边一阵喧闹，你回头一看\n", this_object());
    message("vision", me->query("name") + "不知因为什么被几个少林武僧抓走了。\n\n", this_object());
    return 0;
  }
  if (class_name == "shaolin1")
    return notify_fail("老僧伸手拦住你，说道：“俗家弟子不能进入。”\n");
  if (this_player()->query("family/generation") > 8)
    return notify_fail("老僧伸手拦住你，说道：“上面是藏经阁顶层，你现在辈分太低，不能进。”\n");
  return 1;
}

string look_book() {
  object me = this_player();

  if (me->query_temp("left") == 6)
    return "左右各是一排高大的红木书架，分成好多格子，放满了各种佛经。\n";
  if (me->query_temp("left") < 6)
    return "你站在左边书架的第" + (string)(6 - me->query_temp("left")) + "个格子的前面。\n";
  if (me->query_temp("left") > 6)
    return "你站在右边书架的第" + (string)(me->query_temp("left") - 6) + "个格子的前面。\n";
  return 0;
}

string look_fojing() {
  object me = this_player();

  if (me->query_temp("left") == 6)
    return "你离佛经太远了，看不清是什么佛经。\n";
  if (me->query_temp("left") < 6)
    return "你看看格子里的佛经，发现是一本" + book[me->query_temp("left") * 4] + "。\n";
  if (me->query_temp("left") > 6)
    return "你看看格子里的佛经，发现是一本" + book[(me->query_temp("left") - 1) * 4] + "。\n";
  return 0;
}

int do_zou(string arg) {
  object ob, ob1, me = this_player();
  string sth, sb;

  if (!arg) return 0;
  if (sscanf(arg, "%s %s", sth, sb) != 2) return 0;
  if (sth != "书架") return 0;
  if (sb == "左") {
    if (me->query_temp("left") <= 0) {
      write("你已经走到书架的最左边了！\n");
      me->set_temp("left", 0);
      return 1;
    }
    write("你往左走了一步。\n");
    me->add_temp("left", -1);
    return 1;
  }
  if (sb == "右") {
    if (me->query_temp("left") >= 12) {
      write("你已经走到书架的最右边了！\n");
      me->set_temp("left", 12);
      return 1;
    }
    write("你往右走了一步。\n");
    me->add_temp("left", 1);
    return 1;
  }
  return 0;
}

int do_du(string arg) {
  object ob = this_object(), me = this_player();
  int my_skill;
  int cost, cost1, cc, nn;

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (me->query_temp("sleeping") || me->query_temp("dazuo") || me->is_fighting()) {
    write("你现在无法学习！\n");
    return 1;
  }
  if (arg != "佛经") {
    write("你要看什么？\n");
    return 1;
  }
  nn = me->query_temp("left");
  if (nn == 6) {
    write("你站在走道里看什么？\n");
    return 1;
  }
  if (nn < 0) nn = 0;
  if (nn > 6) nn = nn - 1;
  if (nn > 12) nn = 12;

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }

  message("vision", me->name() + "专心读了一遍佛经。\n", environment(me), me);
  cc = 35 - me->query("kar");
  if (cc < 0) cc = 0;

  if ((int)me->query("combat_exp") < 10000 * cc + 10000) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  //	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

  cost1 = (int)book[nn * 4 + 2] + cc * 2;

  cost = cost1 + cost1 * ((int)book[nn * 4 + 3] - (int)me->query_int()) / 20;
  printf("%d ", cost);
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  me->receive_damage("sen", cost);

  if (!me->query_skill(book[nn * 4 + 1], 1))
    me->set_skill(book[nn * 4 + 1], 0);

  my_skill = me->query_skill(book[nn * 4 + 1], 1);
  if (my_skill > (me->query_kar() - 20) * 10) {
    write("好象是缘分已尽，你再怎么读也没用。\n");
    return 1;
  }
  if (my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你没有任何收获。\n");
    return 1;
  }

  me->improve_skill(book[nn * 4 + 1], (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese(book[nn * 4 + 1]) + "的技巧，有点心得。\n");
  return 1;
}
