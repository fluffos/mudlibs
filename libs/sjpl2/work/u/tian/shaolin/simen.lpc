inherit ROOM;

//void do_check();

void create() {
  set("short", "寺门");
  set("long", @LONG
你站在少林寺的门前，抬眼望去，门上一块大匾上书“少林寺”
三个大字，金碧辉煌，圆润刚劲，竟然是皇上御笔亲书。两扇大门
紧闭，旁边的小门却开着。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "guangchang1",
    "south": __DIR__ "guangchang",
  ]));
  set("objects", ([
    __DIR__ "npc/qingming": 1,
  ]));


  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
  //        replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  string class_name;
  object seng;

  seng = present("qing ming", environment(me));
  class_name = me->query("class");
  if (class_name == "shaolin" || class_name == "shaolin1") {
    return 1;
  }
  if (me->query_temp("visit"))
    return 1;
  if ((dir == "north") && (objectp(seng)))
    return notify_fail("清明伸手拦住你，笑着说道：“施主有何贵干？”\n");
  else if (dir == "north")
    return notify_fail("少林寺的大门紧闭着。\n");
  return 1;
}

void init() {
  int j;
  object ob, me = this_player(), seng;
  j = this_object()->query_temp("permit_enter");
  me->set_delay(3);
  seng = present("qing ming", this_object());
  if (!seng && j < 3) {
    seng = new(__DIR__ "npc/qingming");
    seng->move(this_object());
    this_object()->add_temp("permit_enter", 1);
  }
}
