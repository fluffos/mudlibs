inherit ROOM;

void create() {
  set("short", "塔林");
  set("long", @LONG
你眼前一亮，来到一块空地，原来是少林历代高僧安放骨灰的塔林。
周围是一座座的石塔，有方的，圆的，高的，矮的，精致的，简陋的，
完整的，破损的，莲花座的，须弥座的，各具特色。你入迷的看着，猛
然发现你迷失了方向，糟糕，找不到出去的路了。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "talin1",
    "west": __DIR__ "talin1",
    "south": __DIR__ "talin1",
    "north": __DIR__ "talin1",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
}
