//qiaobi2.c

inherit ROOM;

void create() {
  set("short", "峭壁");
  set("long", @LONG
下面是一个深不见底的山谷，你双手紧紧扣着峭壁上的石缝，累的气喘吁吁，
可绝不敢松劲，摔下去就会粉身碎骨的。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
  ]));

  set("item_desc", ([
    "峭壁": "是一个万丈峭壁，往下一看云雾缭绕，深不可测。\n",
    "石缝": "石缝里居然顽强的生长着一些小草。\n",
  ]));

  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_climb", ({ "climb", "pa" }));
}

int do_climb(string arg) {
  object ob, me = this_player();

  if (arg != "down" && arg != "up") return 0;
  if (arg == "up") {
    message_vision("$N用手攀着峭壁上的石缝，小心翼翼地向上爬去。\n", me);
    ob = (object)__DIR__ "qiaobi1";
    tell_room(ob, me->query("name") + "从峭壁爬了上来，差点累瘫了。\n");
    me->move(ob);
    return 1;
  } else {
    message_vision("$N用手攀着峭壁上的石缝，小心翼翼地向下爬去。\n", me);
    message_vision("突然脚下一滑，手一松，$N直直的摔了下去。\n", me);
    message_vision("$N不由的大叫一声：啊！！救命呀！！！。\n", me);
    write("迷迷乎乎中只觉的被什么东西挡了一下。\n");
    me->unconcious();
    ob = (object)__DIR__ "qiaobi3";
    tell_room(ob, me->query("name") + "从上面摔了下来，昏了过去。\n");
    me->move(ob);
    return 1;
  }
}
