// jlyuan  戒律院

#include <room.h>
inherit ROOM;

void create() {
  set("short", "戒律院");
  set("long", @LONG
这里是少林寺的戒律院。是惩罚犯戒僧人的地方，几个虎背熊
腰的武僧手持戒律棍站在佛像前紧紧盯着你，你的头皮不由一阵发
紧，腿也有点发颤，心想还是赶快离开这地方，
    墙边是个大青石台，是犯戒僧人受戒的地方。南面是一条长廊。
LONG
  );

  set("exits", ([
    "south": __DIR__ "zoulang4",
  ]));
  set("objects", ([
    __DIR__ "npc/xuyuan": 1,
    __DIR__ "npc/chijieseng": 1,
    __DIR__ "npc/shouluseng": 1,
  ]));

  setup();
  replace_program(ROOM);
}
