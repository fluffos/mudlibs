// sengshe2. 僧舍

#include <room.h>
inherit ROOM;

void create() {
  set("short", "僧舍");
  set("long", @LONG
这是一间极为简陋的僧舍。环视四周，除了几张床外，室
内空荡荡地别无他物。
LONG
  );

  set("exits", ([
    "south": __DIR__ "zoulang2",
  ]));
  set("sleep_room", 1);
  set("if_bed", 1);

  setup();
  replace_program(ROOM);
}
