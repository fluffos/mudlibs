// maobi.c : 毛笔

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("毛笔", ({ "maobi", "pen" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只写字用的毛笔，好象是狼毫的，制作的挺精致的。\n");
    set("value", 100);
    set("material", "wood");
    set("wield_msg", "$N从怀里掏出一只$n，握在手中。\n");
    set("unwield_msg", "$N将手中的$n放进怀里。\n");
  }
  init_sword(2);

  setup();
}
