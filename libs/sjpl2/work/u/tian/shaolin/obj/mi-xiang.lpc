// oil.c

inherit ITEM;
setup() {}
void create() {
  set_name("迷香", ({ "mixiang" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一包粉红色的粉末，使用(use)后会令人昏昏欲睡。\n");
    set("unit", "包");
    set("value", 150);
    set("oil_left", 5);
  }
}
void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  string item, target;
  object me, ob;
  if (!arg)
    return notify_fail("命令格式： use 某物 to 某人\n");

  if (sscanf(arg, "%s to %s", item, target) != 2)
    return notify_fail("命令格式： use 某物 to 某人\n");
  me = this_player();

  if (!objectp(ob = present(target, environment(me))) || !living(ob))
    return notify_fail("这里没有这个人。\n");

  if (!this_object()->id(item)) return notify_fail("你使用什么？\n");

  write("你用指甲从包里挑了小许" + name() + "，向着" + ob->name() + "轻轻弹了过去。\n");
  add("oil_left", -1);
  if (!query("oil_left")) {
    write("你把包里" + name() + "用完了。\n");
    destruct(this_object());
  }
  if (ob->query_condition("mixiang")) return 1;

  tell_object(ob,
    "你觉得脸上似乎沾上了什麽东西，伸手一摸却什么也没有。\n");
  if (random(me->query("combat_exp")) > (int)ob->query("combat_exp") / 5) {
    if ((me->query_skill("poison", 1) + me->query_skill("force", 0)) >
      (ob->query_skill("poison", 1) + ob->query_skill("force", 0))) {
      ob->apply_condition("mixiang", 5);
      tell_object(me, name() + "轻轻的撒在了" + ob->name() + "的脸上。\n");
    } else
      tell_object(me, name() + "被" + ob->name() + "体内的真气荡开了。\n");
    return 1;
  }
  tell_object(me, name() + "被" + ob->name() + "体内的真气荡开了。\n");
  return 1;

}
