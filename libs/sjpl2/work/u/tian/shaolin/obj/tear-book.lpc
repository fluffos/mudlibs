//zhqj-book.c

inherit ITEM;

void create() {
  set_name("《大光明经》", ({ "bright-jing", "jing" }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本记载高深佛法的书籍。\n");
  set("value", 100);
  set("skill", ([
    "name": "buddhism",          // name of the skill
    "exp_required": 0,               // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 20,                  // gin cost every time study this
    "difficulty": 30,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 80   // the maximum level you can learn from this object.
  ]));
  setup();
}
void init() {
  add_action("do_tear", "tear");
}
int do_tear(string arg) {
  object me, book;
  me = this_player();
  if (!(arg == "jing" || arg == "bright-book"))
    return 0;
  if (!(arg)) {
    write("你要撕什么？\n");
    return 1;
  }
  if (me->query("marks/xisui")) {
    write("你撕开经书，发现里边什么都没有？\n");
    destruct(this_object());
    return 1;
  }
  tell_object(me, @TEXT
你撕下经书的封皮，发现里边另加有一行小字：
   《洗髓经》，有缘人得之。
TEXT
  );
  message_vision("$N十分利索地把《大光明经》拆开，再重新粘好订好。\n", me);
  book = new(__DIR__ "xisui-jing");
  me->set("marks/xisui", 1);
  book->move(me);
  destruct(this_object());
  return 1;
}
