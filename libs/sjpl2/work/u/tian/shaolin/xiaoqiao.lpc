inherit ROOM;

void create() {
  set("short", "小桥");
  set("long", @LONG
一座独木桥，横跨在一条山中小溪上，由于年久失修，桥身已大半
腐烂，不能用了。小溪水流潺潺，清澈见底，还有小鱼游来游去。岸边
一棵高大的垂柳，枝叶茂密，微风吹来，柳条轻舞，柳絮飞扬。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "xiaolu8",
    "north": __DIR__ "xiaolu9",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
  replace_program(ROOM);
}
