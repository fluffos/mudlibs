// zhaiyuan. 斋院
#include <room.h>
inherit ROOM;

void create() {
  set("short", "斋院");
  set("long", @LONG
这里便是少林寺普通僧人用斋的地方。斋院极大，从南到北一排
排摆满了长长的餐桌和长凳，几位小和尚正来回忙碌着布置素斋，看
情形可以容纳几百个人同时进餐。
LONG
  );

  set("exits", ([
    "west": __DIR__ "zoulang2",
  ]));
  set("objects", ([
    __DIR__ "npc/juewu": 1,
    //	"/obj/food/baozi": 2,
    //	"/obj/food/shuigang": 1,
  ]));

  set("no_sleep", 1);
  setup();
}
