//cjge4.c 藏经阁顶

inherit ROOM;

mapping skill = ([
  "name": "force",
  "exp_required": 100000,
  "sen_cost": 50,
  "difficulty": 30,
  "max_skill": 150,
]);


void create() {
  set("short", "藏经阁暗室");
  set("long", @LONG
这是藏经阁的一个小暗室，黑黑的，几乎什么都看不到。
这里没有明显的出口。
LONG
  );

  set("item_desc", ([
    "地上": "你爬在地上仔细的看看，发现有一道缝隙。\n",
    "墙上": "你瞪大眼睛，在四面墙上看了半天，也没发现什么。\n",
    "墙角": "黑呼呼的，什么也看不清。\n",
  ]));


  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  object ob1, ob = this_object();

  set("du", 0);
  set("zhao", 0);
  if (ob1 = present("po muban", ob))
    destruct(ob1);

  add_action("do_du", ({ "study", "du" }));
  add_action("do_open", ({ "open" }));
  add_action("do_search", ({ "search", "zhao" }));
  add_action("do_ca", ({ "ca" }));

}

void reset() {
  ::reset();
  delete("zhao");
  delete("du");
}

int do_ca(string arg) {
  object ob1, ob = this_object(), me = this_player();

  if (query("zhao") != 1) return 0;
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (ob->query("du") == 1) {
    write("已经干净了，不用再擦了！\n");
    return 1;
  }
  if (arg != "木板") {
    write("无效的命令。\n");
    return 1;
  }
  if (ob1 = present("ma bu", me)) {
    write("你用抹布在破木板上擦了半天，好象没有什么效果。\n");
    return 1;
  }
  if (!(ob1 = present("shi mabu", me))) return 0;
  seteuid(getuid());
  if (me->query("id") != ob1->query("own_name")) {
    write("这不是你的东西，你不能用!\n");
    return 1;
  }
  write("你用湿抹布把破木板使劲的擦了一遍，把上面的灰尘全擦掉了。\n");
  if (ob1 = present("po muban", ob)) {
    ob1->set("long", "一块檀香木的木板，上面刻着很多天竺文字和图形。\n");
    ob1->set("own_name", me->query("id"));
  }
  ob->set("du", 1);
  return 1;
}


int do_search(string arg) {
  object ob1, ob = this_object(), me = this_player();
  int kk;

  if (arg != "墙角") {
    write("无效的命令。\n");
    return 1;
  }
  write("你蹲在地上，伸手在墙角处摸索。\n");
  kk = random(me->query("kar"));
  if (kk < 5) {
    write("哇，你找到一只臭烘烘的死老鼠，恶心的你直想吐，你一甩手，把它扔到一边。\n");
    return 1;
  }
  if (kk < 8) {
    write("你摸到一个软呼呼的东西，吱的一叫，原来是只老鼠，它狠狠地咬了你一口。\n");
    me->receive_damage("kee", kk * 10);
    me->receive_wound("kee", kk * 10);
    return 1;
  }
  if (kk < 15 || query("zhao") == 1) {
    write("那里黑呼呼的，什么也没有。\n");
    return 1;
  }
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") {
    write("那里黑呼呼的，什么也没有。\n");
    return 1;
  }
  write("你摸索了半天，找到一块破木板。\n");
  ob1 = new(__DIR__ "obj/pomuban");
  ob1->move(ob);
  set("zhao", 1);
  return 1;
}

int do_du(string arg) {

  object ob1, ob = this_object(), me = this_player();
  int my_skill;
  int cost;

  if (ob->query("du") != 1) return 0;
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (!(ob1 = present("po muban", ob))) return 0;
  if (me->query_temp("sleeping") || me->query_temp("dazuo") || me->is_fighting()) {
    write("你现在无法学习！\n");
    return 1;
  }
  if (me->query("id") != ob1->query("own_name")) {
    write("这不是你的东西，你不能读!\n");
    return 1;
  }

  if (arg != "破木板") {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }
  if (me->query_skill("literate", 1) < 70) {
    write("你文化水平太低，看不懂上面的文字。\n");
    return 1;
  }
  if (me->query_skill("force", 1) < 100) {
    write("上面的东西太高深，你没有什么收获。\n");
    return 1;
  }

  message("vision", me->name() + "专心看了一遍木板。\n", environment(me), me);

  if ((int)me->query("combat_exp") < skill["exp_required"]) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  //	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query("int")) / 20;
  //printf("%d ",cost);
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  //	if( me->query_skill(skill["name"], 1) > skill["max_skill"] ) {
  //		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
  //		return 1;
  //	}

  me->receive_damage("sen", cost);

  if (!me->query_skill(skill["name"], 1))
    me->set_skill(skill["name"], 0);

  my_skill = me->query_skill(skill["name"], 1);
  if (my_skill > (me->query("kar") - 5) * 10) {
    write("好象是缘分已尽，你再怎么读也没用。\n");
    return 1;
  }
  if (my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你没有任何收获。\n");
    return 1;
  }

  me->improve_skill(skill["name"], (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese(skill["name"]) + "的技巧，有点心得。\n");
  return 1;
}

int do_open(string arg) {
  object ob1, ob = this_object(), me = this_player();

  if (arg != "缝隙") {
    write("无效的命令。\n");
    return 1;
  }
  write("你用手使劲的扣地上的缝隙，居然把你脚下的楼板扣开了。\n");
  write("你大叫一声，直摔到楼下。\n");
  ob = (object)__DIR__ "cjge";
  tell_room(ob, me->query("name") + "走了过来。\n");
  me->move(ob);
  tell_room(this_object(), me->query("name") + "一闪身，不见了。\n");
  return 1;
}
