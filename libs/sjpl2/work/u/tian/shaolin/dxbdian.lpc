//dxbdian  大雄宝殿
inherit ROOM;

void create() {
  set("short", "大雄宝殿");
  set("long", @LONG
这里是少林寺的主殿大雄宝殿。殿前台阶宽阔，雕栏环抱，衬托着
整个大殿峻极雄伟，气宇轩昂，殿顶上覆黄琉璃瓦，殿内雕梁画栋，令
人叹为观止。正中是一个高大的神龛，上有莲花宝座，端坐着佛祖如来
的金身塑像，慈颜庄重，佛光普照。在佛祖旁边的墙上插着一把剑。佛
祖的东西两边是八大金刚的塑像，怒目圆睁，栩栩如生，不怒自威。
    神龛前有一长条供桌，上面摆满供品。桌上青烟缭绕，香火旺盛。
桌前放着几个蒲团，几个香客正虔诚的磕头拜佛。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "剑": "这把剑有一半剑身插在墙中，剑柄上写着两个字——青冥。\n",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "tingyuan",
    "north": __DIR__ "bwchang",
  ]));
  set("objects", ([
    __DIR__ "npc/kongdan": 1,
  ]));

  set("no_sleep", 1);
  //         set("no_fight", 1)
  set("no_clean_up", 0);

  setup();

}

int valid_leave(object me, string dir) {
  string class_name;
  object seng;

  seng = present("kong dan", environment(me));
  class_name = me->query("class");
  if (class_name == "shaolin" || class_name == "shaolin1") return 1;
  if ((dir != "north") || !(objectp(seng))) return 1;
  if (!me->query_temp("visit"))
    return notify_fail("空淡伸手拦住你，笑着说道：“施主是怎么混进少林寺的？”\n");
  if (me->query_temp("visit") == 1)
    return notify_fail("空淡伸手拦住你，笑着说道：“施主参观就到此止步吧。”\n");
  return 1;
}
