// wsshe5 武僧舍

#include <room.h>
inherit ROOM;

void create() {
  set("short", "武僧舍");
  set("long", @LONG
这里是寺里的武僧居住的地方。三张床，三把椅子，三个小桌。
屋里收拾的干净利索，几个僧人正在休息。
    南北两头各有一间武僧舍，东面是走廊。
LONG
  );

  set("exits", ([
    "east": __DIR__ "zoulang4",
    "south": __DIR__ "wsshe4",
    "north": __DIR__ "wsshe6",
  ]));
  set("objects", ([
    __DIR__ "npc/wuseng": 3,
  ]));

  setup();
}
