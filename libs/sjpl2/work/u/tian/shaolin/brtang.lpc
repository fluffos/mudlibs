// brtang 般若堂

#include <room.h>
inherit ROOM;

void create() {
  set("short", "般若堂");
  set("long", @LONG
这里是少林寺的般若堂，北面有一尊小佛像。这里地方很宽敞，
是少林弟子钻研武技，切磋武功的地方，能到般若堂来学习武功可
是少林弟子个个心驰神往的事。所以这里一天到晚人很多。般若堂
的弟子都有一身好武艺。
    南面出去是一条长廊。
LONG
  );
  set("item_desc", ([
    "佛像": "佛像前的供桌上两边插着粗大的蜡烛，中间放着一个玉瓶。\n",
    "玉瓶": "一个碧玉瓶，晶莹剔透，甚是精巧。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/huixin": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "zoulang3",
  ]));

  setup();
}
