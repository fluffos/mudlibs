// xiaofan.c
inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("小贩", ({ "xiaofan" }));

  set("age", 21);
  set("gender", "男性");
  set("long",
    "一个手挎小竹篮的小贩，穿着朴素，看来是附近农村的。\n",);

  set("vendor_goods", ([
    "/obj/example/wineskin": 10,
    "/obj/example/dumpling": 30,
    "/obj/example/jitui": 40,
  ]));

  setup();
}

void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("小贩说道：这位" + RANK_D->query_respect(ob) + "走累了吧？在这歇息一下吧，想吃点什么？\n",);
}


int accept_fight(object ob) {
  command("fear");
  say("小贩说道：俺是庄户人家，怎么是您的对手。\n");
  return 0;
}
