// wuseng.c 少林寺--武僧

inherit NPC;
string ask_for_jia();

void create() {

  set_name("年青武僧", ({ "wu seng", "seng" }));
  set("long",
    "这是少林寺的年青武僧，身材高大魁梧。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");

  set("age", 30);
  set(
    "str",
    25
  ); /* = 膂力*/ set(
    "cor",
    25
  ); /* = 胆识*/ set(
    "int",
    25
  ); /* = 悟性*/ set(
    "spi",
    25
  ); /* = 灵性*/ set(
    "cps",
    30
  ); /* = 定力*/ set("per", 25); /* = 容貌*/ set("con", 60); /* = 根骨*/ set("kar", 30); /* = 福缘*/

  set("food", 600);
  set("water", 600);
  set("max_kee", 2000);
  set("eff_kee", 2000);
  set("kee", 2000);
  set("max_force", 2000);
  set("force", 3500);

  set("force_factor", 50);
  set_temp("apply/attack", 200);
  set_temp("apply/defense", 200);
  set("combat_exp", 1000000);

  set_skill("force", 200);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);

  set("inquiry", ([
    "加人": (: ask_for_jia :),
  ]));


  setup();

}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;

  if ((string)ob->query("class") == "shaolin" || (string)ob->query("class") == "shaolin1") {
    if (ob->query("combat_exp") < 200000) {
      command("say " + RANK_D->query_respect(ob) + "还是到前院练功吧。\n");
      return 0;
    }
    command("say 既然" + RANK_D->query_respect(ob) + "赐教，" + RANK_D->query_self(this_object()) + "只好奉陪。\n");


    set("food", 600);
    set("water", 600);
    set("max_kee", 20000);
    set("eff_kee", 20000);
    set("kee", 20000);
    set("max_force", 2000);
    set("force", 2000);
    set("str", 5); /* = 膂力*/

    set_temp("apply/attack", 30);
    set_temp("apply/defense", 50);
    set("force_factor", 5);
    set("combat_exp", ob->query("combat_exp") + 100);
    if (query("combat_exp") > 1000000) set("combat_exp", 1000000);
    return 1;
  }
  return 0;

}

string ask_for_jia() {
  object *ob, me = this_player();
  int i, nn = 0, mm;

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query("id") == "wu seng") nn++;
  }
  message_vision("$N看看四周，说：这里有" + (string)nn + "个武僧。\n", this_object());
  if (me->query("combat_exp") < 200000)
    return "你现在好象不适合和我们练功！\n";
  if (me->query("combat_exp") < 500000)
    mm = (me->query("kar") + me->query("age")) / 8;
  else if (me->query("combat_exp") < 1000000)
    mm = (me->query("kar") + me->query("age")) / 6;
  else if (me->query("combat_exp") < 2000000)
    mm = (me->query("kar") + me->query("age")) / 4;
  else mm = me->query("kar") + me->query("age") / 4;
  if (nn >= mm)
    return "这些武僧已经足够了！\n";
  command("nod");
  command("say 人数是少了点，我帮你叫几个来。\n");
  message_vision("$N把头伸出门外，喊道：过来几个人，帮小师父练功！\n", this_object());
  message_vision("从外面应声走进来三个武僧。\n", this_object());
  new(__DIR__ "wuseng")->move(environment(me));
  new(__DIR__ "wuseng")->move(environment(me));
  new(__DIR__ "wuseng")->move(environment(me));
  return "加油练吧，光大少林！\n";
}
