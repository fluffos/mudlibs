// tiebushan.c 铁布衫
//

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("铁布衫", ({ "tie bushan", "cloth" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "tie");
    set("value", 1000);
    set("armor_prop/armor", 20);
    set("armor_prop/dodge", 1);
    set("armor_prop/defense", 10);
  }
  setup();
}
