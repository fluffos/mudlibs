//tiehuwan.c 铁护腕

#include <armor.h>

inherit WRISTS;

void create() {
  set_name("铁护腕", ({ "tie huwan", "huwan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "tie");
    set("unit", "对");
    set("value", 3000);
    set("armor_prop/armor", 15);
    set("armor_prop/dodge", -1);
    set("armor_prop/defense", 5);
  }
  setup();
}
