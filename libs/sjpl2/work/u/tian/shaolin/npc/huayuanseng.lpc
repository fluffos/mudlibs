// huayuanseng.c

inherit NPC;

void create() {
  set_name("化缘僧", ({ "huayuan seng", "seng" }));
  set("title", "少林弟子");
  set("long",
    "一位手托木钵的化缘和尚，云游四方，风尘仆仆。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");
  //	set("class", "shaolin");

  set("age", 30);

  set("max_gin", 1000);
  set("max_kee", 2500);
  set("max_sen", 1000);
  set("force", 1600);
  set("max_force", 1500);
  set("force_factor", 50);
  set("combat_exp", 1000000);

  set("chat_chance", 10);

  set("chat_msg", ({
    "化缘僧说道: 阿弥陀佛，施主，积点阴德，化几两银子给贫僧吧。\n",
    (: random_move :)
  }));

  set_skill("force", 140);
  set_skill("unarmed", 140);
  set_skill("dodge", 140);
  set_skill("parry", 140);
  set_skill("blade", 140);
  set_skill("shaolin-dodge", 140);
  set_skill("fuhu-ken", 140);
  set_skill("cibei-blade", 140);

  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "fuhu-ken");
  map_skill("parry", "cibei-blade");
  map_skill("blade", "cibei-blade");

  setup();
  carry_object(__DIR__ "obj/seng_cloth")->wear();
  carry_object(__DIR__ "obj/jieblade")->wield();
}

int accept_object(object me, object ob) {
  object ling;

  command("smile");
  command("say 阿弥陀佛，多谢这位" + RANK_D->query_respect(me) + " ！");

  if (ob->query("money_id") && ob->value() >= 10000 && me->query("class") != "shaolin") {
    command("say " + RANK_D->query_respect(me) +
      "如此乐善好施，兼又身怀绝艺，本寺方丈正欲一晤天下英雄，不知可愿赴少林寺内一游？");

    //		ling=new("/u/tian/shaolin/obj/tie-ling");
    //		ling->move(me);
    //		message_vision("化缘僧给$N一块铁铸令牌。\n", me);

    //		command("say 此牌限时一日，逾时失效，请于限时前离寺，否则多有不便，切记切记！"); 
    return 1;
  }

  return 1;
}
