// xuanbei.c 玄悲

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("玄悲", ({ "xuan bei master", "xuan bei", "master", }));
  set("long",
    "这是一位年过古稀的老僧人，不知何故，他看起来很痛苦。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "空见": "空见是现任少林主持。\n",
    "受伤": "唉，老衲练功不慎，走火入魔，内伤严重。。\n",
    "伤": "唉，老衲练功不慎，走火入魔，内伤严重。。\n",
    "治疗": "这是内伤，无药可治的，除非。。。\n",
    "易筋经": "被一个头陀偷走了，我师弟玄难追查，也一去不回。\n",
    "拜师": "过了罗汉阵在来找我！\n",
  ]));

  set("age", 85);
  set("str", 85);

  set("max_gin", 2500);
  set("max_kee", 5000);
  set("eff_kee", 2000);
  set("kee", 2000);
  set("max_sen", 2500);
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 180);
  set("combat_exp", 15000000);

  set_skill("force", 280);
  set_skill("fuxiang_force", 250);
  set_skill("weituo_chu", 250);
  set_skill("dodge", 280);
  set_skill("shaolin-dodge", 250);
  set_skill("staff", 280);
  set_skill("yizhi-chan", 250);
  set_skill("parry", 300);
  set_skill("unarmed", 280);
  set_skill("jingang-strike", 50);
  set_skill("damo-force", 250);
  set_skill("hammer", 280);

  set_skill("essencemagic", 200);
  set_skill("buddhism", 250);
  set_skill("magic", 200);
  set_skill("literate", 240);
  set_skill("zaahan_gong", 250);

  map_skill("force", "fuxiang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "jingang-strike");

  set("title", "少林寺高僧");
  create_family("少林寺", 2, "弟子");
  set("family/privs", 1);

  setup();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void init() {
  set("eff_kee", 2000);
  set("kee", 2000);
  add_action("do_apprentice", "apprentice");
}

void attempt_apprentice(object ob) {
  string name, new_name;
  mapping family = ob->query("family");
  string *prename = ({ "无", "玄", "空", "明", "静", "智", "虚", "慧", "觉", "清" });

  if (ob->query("shaolin/lh18") != 1 || (ob->query("family/master_name") != "空见")) {
    command("shake");
    message_vision("$n双手合十，对$N说道: 我是不轻易收徒弟的！\n", ob, this_object());
    ob->delete_temp("pending/apprentice");
    return;
  }

  command("say 阿弥陀佛！老衲就收下你这个徒弟吧。");
  command("say 阿弥陀佛，善哉！善哉！没想到老衲行将就木，还能得此佳徒！");
  command("recruit " + ob->query("id"));

  name = ob->query("name");
  new_name = prename[(int)family["generation"] - 2] + name[2..3];
  command("say 从今天起你就改名为" + new_name + "了。");
  ob->set("name", new_name);
  ob->set("title", "少林寺高僧");
  ob->set("class", "shaolin");
  ob->set("shaolin/tuijian", 0);
  ob->set("shaolin/renwu", 0);
  ob->delete("shaolin/lh18");
}


int do_apprentice(string arg) {
  int exp, nn, ii, rr;
  string old_t;
  object ob, me = this_player();

  if (!(me->is_apprentice_of(this_object()))) return 0;
  message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n", me, this_object());
  command("smile");
  me->set("shaolin/renwu", 0);
  return 1;
}
