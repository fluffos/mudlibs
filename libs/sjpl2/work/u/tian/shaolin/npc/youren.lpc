inherit NPC;

void create() {
  set_name("游人", ({ "you ren", "visitor" }));
  set("race", "人类");
  set("age", 25);
  set("long", "一位文诌诌书生打扮的游客，正在欣赏风景。\n");
  set("attitude", "friendly");
  set("per", 20);
  set("str", 26);
  set("cor", 30);
  set("kar", 15);
  set("gender", "男性");
  set_skill("unarmed", 20);
  set_skill("dodge", 30);
  set_skill("parry", 20);
  set("combat_exp", 3000);

  set("chat_chance", 10);
  set("chat_msg", ({
    "游人说道：少室山的风景确实不同一般。\n",
    "游人兴致忽来，吟到：飞流直下三千尺，疑是银河落九天！\n",
    "游人说：唉，清明这小僧说我福缘不够，不能学艺少林。\n",
    "游人皱皱眉头说：怎么能提高福缘呢？我是没福的样吗？真是莫名其妙。\n",
  }));

  setup();
  carry_object(__DIR__ "obj/changshan")->wear();

  add_money("silver", 15);
}

