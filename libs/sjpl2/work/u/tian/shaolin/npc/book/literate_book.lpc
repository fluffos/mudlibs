// literate_book.c

inherit ITEM;

void create() {
  set_name("诗词入门", ({ "literate book", "book", }));
  set_weight(600);
  set("unit", "本");
  set("long", "一本诗词入门的书，是讲解诗词歌赋的入门书。\n");
  set("value", 300);
  set("skill", ([
    "name": "literate",
    "exp_required": 100,
    "sen_cost": 20,
    "difficulty": 30,
    "max_skill": 30
  ]));
}
