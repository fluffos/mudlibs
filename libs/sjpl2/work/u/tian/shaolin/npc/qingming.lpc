// qingming.c 知客僧-清明

inherit NPC;

string ask_for_visit();
string ask_for_xue();
string ask_for_chujia();

void create() {

  set_name("清明", ({ "qing ming", "qing", "ming", }));
  set("long",
    "他是一位身穿青布袈裟的青年僧人。双手合十，站在门旁。\n"
  );

  set("title", "少林寺知客僧");
  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");
  create_family("少林寺", 10, "弟子");

  set("age", 17);

  set("max_gin", 400);
  set("max_kee", 600);
  set("max_sen", 400);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 60);
  set("combat_exp", 100000);

  set("chat_chance", 5);

  set("chat_msg", ({
    "清明说道: 这位施主到这里有何贵干？\n",
  }));

  set_skill("force", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("sword", 80);

  set_skill("luohan-ken", 80);
  set_skill("xinyi_force", 80);
  set_skill("yecha_stick", 80);
  set_skill("shaolin-dodge", 80);

  map_skill("force", "xinyi_force");
  map_skill("unarmed", "luohan-ken");
  map_skill("stick", "yecha_stick");
  map_skill("parry", "yecha_stick");
  map_skill("dodge", "shaolin-dodge");
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);


  set("inquiry", ([
    "name": "阿弥陀佛，小僧名叫清明。欢迎施主到此参观。\n",
    "here": "这里便是天下闻名的佛教胜地少林寺。前来拜师学艺出家的可不少。\n",
    "贵干": "每天到少林寺参观的人很多，出家学艺的也不少。\n",
    "参观": (: ask_for_visit :),
    "学艺": (: ask_for_xue :),
    "出家": (: ask_for_chujia :),
  ]));

  setup();
  //	carry_object("/obj/weapon/stick")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();


}

void init() {
  object me = this_player();

  if ((string)me->query("class") == "shaolin" || (string)me->query("class") == "shaolin1") {
    delete("qu");
    remove_call_out("do_check");
    call_out("do_check", 1, me);
  }

}

void do_check(object me) {
  int nn;
  object room, master, seng;

  if (query("qu") == 1) return;
  printf("清明仔细地打量你半天\n");
  if (!me->query("K_record")) me->set("K_record", me->query("PKS") + me->query("MKS"));
  if (!me->query("tou")) me->set("tou", me->query("thief"));
  if (me->query("bellicosity") > 500) {
    command("say 你杀气太重了，还是到心禅堂好好忏悔吧！\n");
  }

  nn = 0;
  if (me->query("K_record") < me->query("PKS") + me->query("MKS")) nn = 1;
  if (me->query("tou") < me->query("thief")) nn = 1;
  if (nn == 1) {
    command("sigh " + me->query("id"));
    command("say 又触犯佛门戒律了！在这里老老实实呆着，哪里也不许去！！\n");
    command("say 我到戒律院去一趟。");
    message_vision("清明转身进了寺里。\n\n", me);

    this_object()->move("/u/tian/shaolin/jlyuan");
    room = find_object("/u/tian/shaolin/jlyuan");
    master = present("xu yuan master", room);
    seng = present("hui yan", room);
    if (master && seng) {
      message("vision", "\n知客僧清明走了进来，对虚圆说：门口有个弟子犯戒了。\n\n", room);
      message("vision", "虚圆说：哦，是吗？慧严你去看看。\n", room);
      message("vision", "慧严说：是，师傅。\n", room);
      message("vision", "慧严和清明一起出去了。\n\n", room);
      message_vision("一转眼的工夫，清明和持戒僧慧严一起回来了。\n\n", me);
      this_object()->move("/u/tian/shaolin/simen");
      seng->move("/u/tian/shaolin/simen");

      message_vision("慧严狠狠地瞪了$N一眼，说：跟我到戒律院去接受惩戒吧！\n", me);
      message_vision("慧严一把抓住$N的手，象抓小鸡似的把$N带走了。\n\n", me);
      message("vision", "一会儿的工夫，慧严象抓个小鸡似的把" + me->query("name") + "给抓了进来。\n", room);
      seng->move("/u/tian/shaolin/jlyuan");
      me->move("/u/tian/shaolin/jlyuan");
    } else {
      message_vision("一转眼的工夫，清明回来了。\n\n", me);
      this_object()->move("/u/tian/shaolin/simen");
      command("say 算你走运，戒律院的人有事，这次先放过你！");
      set("qu", 1);
    }
  }
}

string ask_for_visit() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "shaolin" || (string)me->query("class") == "shaolin1")
    return "你这家伙，回家了还这么客气！\n";
  if (me->query_temp("visit"))
    return "怎么这么罗嗦？请进呀！\n";
  this_player()->set_temp("visit", 1);
  return "阿弥陀佛，欢迎施主前来参观少林寺。\n";
}

string ask_for_xue() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "shaolin" || (string)me->query("class") == "shaolin1")
    return "师兄怎么跟我开玩笑？\n";
  if (me->query_temp("visit") == 2)
    return "怎么这么罗嗦？站在门口怎么学？请进呀！\n";
  if (me->query_kar() < 10) {
    command("shake");
    command("say 施主似乎福缘不足，唉，可惜呀，与佛门无缘！");
    return "阿弥陀佛，唉，请施主另选地方吧。\n";
  }
  this_player()->set_temp("visit", 2);
  return "哈哈，少林寺武功集天下武学之大成，博大精深，到这里学艺算你找对了。\n";
}

string ask_for_chujia() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "shaolin" || (string)me->query("class") == "shaolin1")
    return "你脑袋发昏了吗？还不赶快进去？方丈正到处找你呢。\n";
  if (me->query_temp("visit") == 3)
    return "想出家就请进吧，去找觉渡就是。\n";
  if (me->query("kar") < 10) {
    command("shake");
    command("say 施主似乎福缘不足，唉，可惜呀，与佛门无缘！");
    return "阿弥陀佛，唉，请施主另选地方吧。\n";
  }
  this_player()->set_temp("visit", 3);
  return "施主要投身少林？哈哈，少林广开善门，接纳天下豪杰。\n";
}


void attempt_apprentice(object ob) {
  command("say 我怎么配当施主的师父呢，施主见笑了。\n");
  this_player()->delete_temp("pending/apprentice");
  return;
}

int accept_fight(object ob) {
  command("say 阿弥陀佛，佛门圣地怎能动武？");
  return 0;
}


void killed_enemy(object who) {
  command("say 哈哈, 这样低微的本事也胆敢擅闯少林寺？不要命的家伙！");
}
