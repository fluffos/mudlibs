inherit NPC;
string reward_more(object who);

void create() {
  set_name("关东大汉", ({ "dahan" }));
  set("gender", "男性");
  set("age", 32 + random(10));
  set("long", "这是一位从白山黑水来的关东大汉。\n");
  set("combat_exp", 5000);
  set("attitude", "aggrensive");
  set_skill("unarmed", 30 + random(100));
  set("chat_chance", 10);
  set("chat_msg", ({
    "关东大汉豪爽得向你大笑！\n",
    (: random_move :),
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  add_money("silver", 50);
  carry_object("/obj/cloth")->wear();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 10000) return "1";
      if (enemy[i]->query("combat_exp") > 15000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") > 500) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
