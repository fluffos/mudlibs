// oldseng.c 藏经阁老僧

#include <ansi.h>;
inherit NPC;

void create() {
  set_name("老僧", ({ "old seng", "seng" }));
  set("title", "藏经阁");
  set("long",
    "一位年逾花甲的老僧，在藏经阁已呆了四十多年了。\n"
  );

  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "shaolin");

  set("age", 95);

  set("max_gin", 1000);
  set("max_kee", 5500);
  set("max_sen", 1000);
  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 50);
  set("combat_exp", 2000000);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);

  set("chat_chance", 2);

  set("chat_msg", ({
    "老僧自言自语道；人老了，耳朵也不好使了。\n",
    "老僧自言自语道；什么山屋无衣的，真是莫名其妙。\n",
    "老僧叹了口气：唉，怎么都看不破这些空名虚利呢？\n",
    "老僧摇了摇头：武功第一又有什么用？唉！\n",
    "老僧无可奈何说：现在这些弟子呀，不如从前啦，看把好好的书架给翻的。\n",
  }));

  set_skill("force", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("shaolin-dodge", 200);
  set_skill("bright_ken", 200);
  set_skill("damo-force", 200);

  map_skill("force", "damo-force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "bright_ken");


  setup();
  carry_object(__DIR__ "obj/seng_cloth")->wear();

}

int accept_object(object who, object ob) {
  if (!who->query("marks/jingang")) {
    if ((string)ob->query("name") != "《洗髓经》" && (string)ob->query("id") != "xisui-jing") {
      say("老僧说道：我佛慈悲。\n");
      return 0;
    } else {
      say("老僧平平淡淡地说道：施主大恩大得，贫僧无以回报，就传你一招武功吧。\n\n");
      message_vision("老僧传授$N有关光明拳法的秘诀，$N似乎有所领悟。\n", who);
      tell_object(who, HIC "你的「光明拳法」进步了！\n" NOR);
      who->set("marks/jingang", 1);
      who->set_skill("bright_ken", 1);
      return 1;
    }
  } else
    say("老僧平平淡淡说道：感谢施主。\n");
  return 1;
}
