// juechan.c 小广场-觉禅

inherit NPC;
inherit F_MASTER;

string *title = ({
  "少林寺俗家第五弟子", 5000,
  "少林寺俗家第四弟子", 10000,
  "少林寺俗家第三弟子", 15000,
  "少林寺俗家第二弟子", 20000,
  "少林寺俗家大弟子", 30000,
});


string ask_me();

void create() {
  set_name("觉禅", ({ "jue chan master", "jue chan", "master", }));
  set("long",
    "这是一位强壮的青年僧人，他长个国字脸，生得浓眉大眼，\n"
    "虎背熊腰，全身似乎蕴含着无穷劲力。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin1");

  set("inquiry", ([
    "学艺": "阿弥陀佛，贫僧武艺粗浅，只收些俗家弟子，传些少林入门的功夫。\n",
    "拜师": "还上哪里找？拜我就是！\n",
    "慧能大师": "慧能大师你都不知道？他是我的师傅，是[心禅堂]首座！\n",
    "推荐信": (: ask_me :),
  ]));

  set("age", 25);

  set("max_gin", 300);
  set("max_kee", 500);
  set("max_sen", 300);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);
  set("combat_exp", 300000);



  set_skill("force", 70);
  set_skill("xinyi_force", 70);
  set_skill("dodge", 70);
  set_skill("shaolin-dodge", 70);
  set_skill("yecha_stick", 70);
  set_skill("stick", 70);
  set_skill("luohan-ken", 70);
  set_skill("parry", 70);
  set_skill("unarmed", 70);

  //	set_skill("essencemagic", 80);
  set_skill("buddhism", 70);
  set_skill("magic", 30);
  set_skill("literate", 30);

  map_skill("force", "xinyi_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("stick", "yecha_stick");
  map_skill("unarmed", "luohan-ken");

  set("title", "少林寺俗家弟子师傅");
  create_family("少林寺", 9, "弟子");
  set("no_teach", 1);

  setup();
  carry_object("/obj/weapon/stick")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void init() {
  add_action("do_apprentice", "apprentice");
}

string ask_me() {
  object me = this_player(), ob;

  if (!(me->is_apprentice_of(this_object()))) return 0;
  if (!(me->query("shaolin/tuijian"))) return 0;
  if (ob = present("letter", me)) {
    if (me->query("id") == ob->query("own_name")) {
      return "推荐信不是在你身上吗？快去吧!\n";
    }
  }

  command("faint " + me->query("id"));
  tell_object(me, "推荐信搞丢了？真是粗心！\n");
  message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n", me, this_object());
  ob = new(__DIR__ "obj/letter1");
  ob->set("own_name", me->query("id"));
  ob->move(me);
  return "仔细保管好，不要再搞丢了！\n";

}


void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("ah");
    command("say 阿弥陀佛！女施主呀，贫僧可不敢开这等玩笑啊。");
    ob->delete_temp("pending/apprentice");
    return;
  }
  if (ob->query("family/family_name") == "少林寺" && ob->query("generation") < 10 && ob->query("generation") != 0) {
    command("say 阿弥陀佛，大师如此多礼小僧可不敢当！");
    ob->delete_temp("pending/apprentice");
    return;
  }

  if (!(ob->query_temp("visit"))) {
    command("ah");
    command("say 你是怎么混进少林寺的？");
    ob->delete_temp("pending/apprentice");
    return;
  }

  if (ob->query_temp("visit") == 1) {
    command("?");
    command("say 阿弥陀佛，施主不是来参观的吗？好好看看吧。");
    ob->delete_temp("pending/apprentice");
    return;
  }

  if (ob->query("kar") < 10) {
    command("shake");
    command("say 施主似乎福缘不足，唉，可惜呀，与佛门无缘！");
    command("say 阿弥陀佛，唉，请施主另选地方吧。");
    ob->delete_temp("pending/apprentice");
    return;
  }

  if ((string)ob->query("class") == "shaolin") {
    command("say 阿弥陀佛，贫僧武艺粗浅，只收些俗家弟子，传些少林入门的功夫。\n");
    ob->delete_temp("pending/apprentice");
    return;
  }
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }

  if (ob->query("betrayer")) {
    command("shake");
    message_vision("觉禅双手合十，对$N说道: 少林寺从不收叛师之徒!\n", ob);
    ob->delete_temp("pending/apprentice");
    return;
  }

  if ((string)ob->query("class") != "shaolin1") {
    command("say 阿弥陀佛！贫僧就收下你做『少林寺俗家第五弟子』了。");
    command("say 阿弥陀佛，善哉！善哉！");
    command("recruit " + ob->query("id"));
    ob->set("title", title[0]);
    ob->set("class", "shaolin1");
    ob->set("id_type", 1);
    ob->set("shaolin/tuijian", 0);
    ob->set("shaolin/renwu", 0);
  }
}


int do_apprentice(string arg) {
  int exp, nn, ii, rr;
  string old_t;
  object ob, me = this_player();

  if (arg != "jue chan master" && arg != "jue chan" && arg != "master") return 1;
  if (!(me->is_apprentice_of(this_object()))) return 0;
  if (me->query("shaolin/tuijian")) {
    command("ah " + me->query("id"));
    tell_object(me, "你还没拜我师傅慧能大师？快去吧，别耽误了你的修行!\n");
    return 1;
  }

  old_t = me->query("title");
  exp = me->query("combat_exp");
  message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n", me, this_object());

  if (old_t == title[8] && exp > (int)title[9]) {
    command("sigh");
    command("say 真是长江后浪推前浪，一代新人换旧人！为师已没有什么可教你的了。");
    command("say 拿上我的推荐信到慧能大师那里学艺吧！\n");
    message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n", me, this_object());
    ob = new(__DIR__ "obj/letter1");
    ob->set("own_name", me->query("id"));
    ob->move(me);

    //		command("say 你我师徒一场，为师也没有什么东西，现在要分手了，送你个纪念品吧！\n");
    me->set("shaolin/tuijian", 1);
    me->set("shaolin/renwu", 0);
    return 1;
  }
  for (ii = 0; ii < 5; ii++) {
    if (old_t == title[ii * 2]) {
      if (exp <= (int)title[ii * 2 + 1]) {
        command("pat " + me->query("id"));
        command("say 你的功夫还不行，要抓紧时间练呀，别光聊天贪玩！\n");
        return 1;
      } else {
        command("haha");
        command("spank " + me->query("id"));
        command("say 很好，现在就提升你为" + title[(ii + 1) * 2] + "。\n");
        me->set("title", title[(ii + 1) * 2]);
        me->set("shaolin/renwu", 0);
        return 1;
      }
    }
  }
  return 1;
}
