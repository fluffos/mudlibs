// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name("熟铜棍", ({ "tong gun", "stick", "gun" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条沉甸甸的熟铜棍。\n");
    set("value", 100);
    set("material", "copper");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(35);
  setup();
}
