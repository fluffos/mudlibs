// qing_jiasha.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("青布袈裟", ({ "qing jiasha", "jiasha" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件青布缝制的袈裟。\n");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
