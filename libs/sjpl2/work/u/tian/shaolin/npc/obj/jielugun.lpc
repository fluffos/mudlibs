// jielugun.c 戒律棍

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name("戒律棍", ({ "jielu gun", "stick", "gun" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条黑黝黝的戒律棍，不知惩戒了多少少林弟子。\n");
    set("value", 100);
    set("material", "wood");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(45);
  setup();
}
