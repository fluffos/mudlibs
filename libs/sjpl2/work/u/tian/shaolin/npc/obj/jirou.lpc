inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("鸡肉", ({ "ji rou", "rou", "chicken" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块新鲜的鸡肉。\n");
    set("unit", "块");
    set("value", 60);
    set("food_remaining", 3);
    set("food_supply", 60);
    set("material", "rib");
  }

  setup();
}
