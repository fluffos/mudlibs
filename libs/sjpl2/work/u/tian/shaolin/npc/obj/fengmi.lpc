// fengmi.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("蜂蜜", ({ "feng mi", "honey", "feng", "mi" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("long", "一些蜂蜜，很甜的。\n");
    set("value", 0);
    set("food_remaining", 1);
    set("food_supply", 5);
  }
  setup();
}

void init() {
  add_action("do_eat", ({ "eat" }));
}


int do_eat(string arg) {
  if (!id(arg)) return 0;
  if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

  tell_object(this_player(), "好甜的蜂蜜，可惜太少了，你不由的咽了一些口水。\n");
  switch (random(4)) {
    case 1:
      {
        int limit;
        limit = (int)(this_player()->query_skill("force", 1) +
          this_player()->query_skill("force") / 5) * 13 - this_player()->query("max_force");
        if (limit > 1) limit = 1;
        if (limit < 0) limit = 0;
        this_player()->add("max_force", limit);
      }

      this_player()->add("combat_exp", 1);
      this_player()->add("potential", 1);
      break;
    case 2: this_player()->add("combat_exp", 5);
    break;
    case 3: this_player()->add("potential", 2);
    break;
    case 0: this_player()->add("combat_exp", -10);
    this_player()->add("potential", -4);
    break;
  }
  this_player()->add("food", query("food_supply"));
  this_player()->add("water", query("food_supply"));
  if (this_player()->is_fighting()) this_player()->start_busy(2);
  message_vision("$N将" + name() + "吃得乾乾净净。\n", this_player());
  destruct(this_object());
  return 1;

}
