// wuiqun.c 

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("白布围裙", ({ "wei qun", "wei", "qun", "apron" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件白布做的大围裙，洗得干干净净的。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
