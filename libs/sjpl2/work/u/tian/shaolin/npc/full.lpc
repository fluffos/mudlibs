// jingshan.c 僧医-静善

inherit NPC;

string ask_for_zhi();

void create() {

  set_name("静善", ({ "jing shan", "shan", }));
  set("long",
    "他是一位身材矮小，面目清瘦的老僧，别看其貌不扬，可是医术高超，
还善于配制丹药，治疗内伤、外伤更是拿手绝活。\n"
  );

  //	set("nickname", "知客僧");
  set("title", "少林寺僧医");
  set("gender", "男性");
  set("attitude", "heroism");
  //	set("class", "shaolin");
  //	create_family("少林寺", 10, "弟子");

  set("age", 67);

  set("max_gin", 1000);
  set("max_kee", 2000);
  set("max_sen", 1000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 100);
  set("combat_exp", 1000000);

  set_skill("force", 200);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("luohan-ken", 250);
  set_skill("puti_force", 200);
  set_skill("shaolin-dodge", 250);

  map_skill("force", "puti_force");
  map_skill("unarmed", "luohan-ken");
  map_skill("dodge", "shaolin-dodge");

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);


  set("inquiry", ([
    "治疗": (: ask_for_zhi :),
    "配制丹药": "我还没配好呢，等会吧！",
    "千年灵芝": "哇，千年灵芝？那可是好东西，你要有别忘了拿给我看看。\n",
  ]));

  setup();

}

string ask_for_zhi() {
  object me = this_player();

  if (is_fighting(this_object()))
    return "战斗中怎么治疗？\n";
  if (!living(this_object()))
    return "看样子静善是顾不了你了！\n";

  if ((string)me->query("class") != "shaolin" && (string)me->query("class") != "shaolin1") {
    if (me->query("max_kee") == 100 / me->query("eff_kee"))
      return "你没有受伤呀！\n";
    command("say 虽然" + RANK_D->query_respect(me) + "不是少林的人，但我佛慈悲为怀，不会见死不救的。");
    message_vision("静善伸出双手贴在$N的后心，运起疗伤大法，不一会，$N的脸色恢复正常。\n", me);
    me->set("eff_kee", me->query("max_kee"));
    me->set("kee", me->query("max_kee"));
    return "阿弥陀佛，救人一命胜造七级浮屠";
  }
  message_vision("静善伸出双手贴在$N的后心，运起疗伤大法，不一会，$N的状态完全恢复正常。\n", me);
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("sen", me->query("max_sen"));
  me->set("gin", me->query("max_gin"));
  me->set("eff_gin", me->query("max_gin"));
  me->set("eff_sen", me->query("max_sen"));
  return "呵呵，全好了，继续加油干吧";
}


int accept_fight(object ob) {
  command("say 阿弥陀佛，佛门圣地怎能动武？");
  return 0;
}


void killed_enemy(object who) {
  command("say 哈哈, 这样低微的本事也胆敢擅闯少林寺？不要命的家伙！");
}
