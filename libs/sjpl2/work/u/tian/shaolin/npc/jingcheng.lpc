// jingcheng.c 方丈室外 静成

inherit NPC;

void create() {
  set_name("静成", ({ "jing cheng", "cheng", }));
  set("long",
    "这是一位眉清目秀的小僧，虽然年纪轻轻，但武功辈分都不低。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "方丈": "方丈正在入定，不得打扰！\n",
    "拜见方丈": "方丈正在入定，闲人无事不得打扰！\n",
  ]));

  set("age", 18);

  set("max_gin", 1000);
  set("max_kee", 2500);
  set("max_sen", 1000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 100);
  set("combat_exp", 2000000);


  set_skill("force", 250);
  set_skill("puti_force", 250);
  set_skill("dodge", 250);
  set_skill("shaolin-dodge", 250);
  set_skill("wenshu_staff", 160);
  set_skill("staff", 250);
  set_skill("longzhua", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("blade", 250);
  set_skill("sword", 250);

  //	set_skill("essencemagic", 180);
  set_skill("buddhism", 180);
  //	set_skill("magic", 180);
  set_skill("literate", 80);

  map_skill("force", "puti_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("staff", "wenshu_staff");
  map_skill("unarmed", "longzhua");

  set("title", "少林寺方丈室小僧");
  //	create_family("少林寺", 5, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();

  carry_object("/obj/weapon/staff")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}
