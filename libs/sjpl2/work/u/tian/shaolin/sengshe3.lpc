// sengshe3. 休息室

#include <room.h>
inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG
这是一间极为简陋的休息室。供游人和香客休息，环视四周，有
几张长凳，在凳子下边好象有些东西，室内空荡荡地别无他物。
LONG
  );

  set("exits", ([
    "north": __DIR__ "zoulang1",
  ]));

  set("sleep_room", 1);
  setup();
}

void init() {
  add_action("do_search", ({ "search", "zhao" }));
}

int do_search(string arg) {
  object ob;

  if (arg != "凳子下") return 0;
  if ((int)query("zhao") == 1)
    return notify_fail("这里什么都没有。\n");
  set("zhao", 1);
  message_vision("$N从地上找到什么东西。\n", this_player());
  ob = new(__DIR__ "obj/zhuzi");
  ob->move(this_player());
  return 1;
}

void reset() {
  ::reset();
  delete("zhao");
}
