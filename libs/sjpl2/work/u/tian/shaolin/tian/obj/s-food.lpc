// super_food.c 超级太空食品
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "超级太空食品" NOR, ({ "food" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long",
      "这是一包超级现代太空食品，包装很精致，看上去花花绿绿。\n");
    set("value", 10);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->set("food", 9999);
  me->set("water", 9999);
  message_vision(
    "$N吃下一包超级太空食品，觉得肚子撑的难受，大概一个月不用吃饭了！\n", me);

  destruct(this_object());
  return 1;
}
