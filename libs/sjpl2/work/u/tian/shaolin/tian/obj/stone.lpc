// stone.c

inherit ITEM;

void create() {
  set_name("石头", ({ "stone" }));
  set_weight(1000000);
  set("long", @LONG 
这是一块奇特的石头，使用后可瞬间到达某个地方。
使用方法：    tiao 目的地        (例如： tiao sl)
sl : 少林寺    sy :  山烟寺   hz : 杭州
fz : 福州      ms :  茅山派   syan:   水烟阁
wh : 武汉      hk :  汉口
还有一些字你没看懂。
LONG
  );
  //    set("value", 300);
  set("unit", "块");
  set("material", "paper");
  set("no_get", "这块石头看来无法拿起。\n");

  //    set("no_drop","风之符看来无法丢弃。\n");

}

void init() {
  add_action("do_fly", "tiao");
}

int do_fly(string arg) {
  string obj;
  if (!arg)
    return notify_fail("你想跳到哪里 ？\n");

  if (this_player()->is_fighting())
    return notify_fail("你在战斗中，无法使用这块石头。\n");
  switch (arg) {
    case "sl":
      obj = "/u/shaolin/tulu1";
      break;
    case "sy":
      obj = "/d/sanyen/door";
      return 1;
      break;
    case "fz":
      return 1;
      obj = "/u/fuzhou/entrance";
      break;
    case "hz":
      obj = "/new/hangzhou/inn";
      break;
    case "syan":
      return 1;
      obj = "/d/waterfog/entrance";
      break;
    case "ms":
      return 1;
      obj = "/d/temple/ladder1";
      break;
    case "wh":
      return 1;
      obj = "/uwuhan/lou1";
      break;
    case "hk":
      obj = "/u/wuhan/hankou/proad1";
      break;
    default:
      return notify_fail("你不能条到那个地方 !\n");
      return 1;

  }
  message_vision("在一阵烟幕中，只见$N的身影忽然消失了。\n", this_player());

  this_player()->move(obj);

  message_vision("$N的身影忽然在一阵烟幕中神秘地出现了。\n", this_player());

  return 1;
}
