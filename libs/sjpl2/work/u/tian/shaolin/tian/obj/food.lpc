// food.c 太空食品
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("太空食品", ({ "food" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long",
      "这是一包现代太空食品，看上去很普通。\n");
    set("value", 10);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  message_vision(
    "$N吃下一包太空食品，只觉得肚子饱饱的，不再感到饥饿干渴！\n", me);

  destruct(this_object());
  return 1;
}
