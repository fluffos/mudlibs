#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黑色长袍", ({ "black-cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件黑色的长袍，上面有青龙会的标记。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
