// This is a room made by roommaker.

inherit ROOM;

void create() {
  object ob;

  set("short", "宝物室");
  set("long", "一间很大的房间，架子上堆满各种奇珍异宝和灵丹妙药。\n");

  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "test",
  ]));

  set("objects", ([ /* sizeof() == 2 */
    //		__DIR__"obj/guo1" : 1,
  ]));



  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_get", "get");
  add_action("do_open", "open");
}

int do_open(string arg) {
  object ob;
  if (arg == "架子") {
    if (!query("_get_")) {
      message_vision("$N打开架子，顿时觉得眼前一亮，上面出现好多东西。\n", this_player());
      ob = new("/obj/money/gold");
      ob->set_amount(200);
      ob->move(this_object());
      ob = new(__DIR__ "obj/guo1");
      ob->move(this_object());
      ob = new(__DIR__ "obj/passport");
      ob->move(this_object());
      ob = new(__DIR__ "obj/s-food");
      ob->move(this_object());
      ob = new(__DIR__ "obj/9zhuan-pill");
      ob->move(this_object());
      ob = new(__DIR__ "obj/food");
      ob->move(this_object());

      set("_get_", 1);
      return 1;
    }
    return notify_fail("架子是空的!\n");
  }
  return 0;
}


int do_get(string arg) {

  if (!arg || arg == "") return 0;
  message_vision("随便拿人家的东西，不太好吧。\n", this_player());
  return notify_fail("");
}

void reset() {
  ::reset();
  delete("_get_");
}
