//dzdian  大藏殿

inherit ROOM;

void create() {
  set("short", "大藏殿");
  set("long", @LONG
这里是少林寺的后殿大藏殿。高高的须弥座上是大藏菩萨的塑像。
供桌上供品很少，香火也不多，显得有些冷清。这里连一般的少林弟子
都很少来，四周静悄悄的，没有动静。
    往北是讲经台，南面是比武场。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "bwchang",
    "north": __DIR__ "jjtai",
  ]));
  set("item_desc", ([
    "塑像": "大藏菩萨的金身佛像，有些时候没打扫了，蒙上一层灰尘。\n",
  ]));

  set("no_clean_up", 0);

  setup();
}
