// lhtang  罗汉堂
#include <room.h>
inherit ROOM;

void create() {
  set("short", "罗汉阵");
  set("long", @LONG
你进入了罗汉阵中，这里九死一生，你还是回去吧。
LONG
  );

  set("exits", ([
    "enter": __DIR__ "lhzhen4",
  ]));
  set("objects", ([
    __DIR__ "npc/luohan": 1,
  ]));
  set("outdoors", "gaibang");

  setup();
}
int valid_leave(object who, string exit) {
  object ob;
  ob = present("luohan", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "enter") && (present("luohan", environment(who))))
    return notify_fail("罗汉说道：“阿弥陀佛，苦海无崖，回头是岸！”\n");
  return ::valid_leave(who, exit);
}
