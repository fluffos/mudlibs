  set("short", "武僧舍");
  set("long", @LONG
这里是寺里的武僧居住的地方。三张床，三把椅子，三个小桌。
屋里收拾的干净利索，几个僧人正在休息。
LONG
  );

  set("exits", ([
    "south": __DIR__ "wsshe5",
  ]));
