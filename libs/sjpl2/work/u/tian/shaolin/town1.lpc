inherit ROOM;
void create() {
  set("short", "登封县");
  set("long", @LONG
这里是河南登封县城。丈许宽的城墙又高又厚，给人一种安全的感觉。
遥望城外，绿色的田野一望无垠，一座座小小的农房星星点点的点缀着宽
广的田野，傍晚时，炊烟袅袅，夕阳斜照，美不胜收。远处连绵的群山更
是令人感到威武壮观。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "tangguo",
    "north": __DIR__ "tulu3",
    "south": __DIR__ "tulu2",
  ]));
  set("objects",
    ([
      "/npc/nknpc": 1,
    ]));
  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
