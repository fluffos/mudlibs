inherit ITEM;

void create() {
  set_name("书架", ({ "book shelf", "shelf" }));
  set_weight(50000);
  set_max_encumbrance(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("prep", "on");
    set("unit", "个");
    set("long", "一个书架，上面插满了各种经书。\n");
    set("value", 1);
    set("no_get", "你可拿不动它。\n");
  }
}

int is_container() { return 1; }
