//cjge3  藏经阁三楼
inherit ROOM;

void create() {
  set("short", "藏经阁三楼");
  set("long", @LONG
这是藏经阁三楼，只见阁中窗明几净，打扫的纤尘不染。左右两排
红木书架摆满了佛经，几个老年僧人正专心致志的默读佛经。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    //           "up" : __DIR__"cjge3",
    "down": __DIR__ "cjge2",
  ]));
  set("objects", ([
    __DIR__ "obj/shelf": 1,
  ]));

  set("no_fight", 1);
  set("no_clean_up", 0);

  setup();
}

void init() {
  this_player()->set_temp("left", 6);
  set("push", 0);

  add_action("do_push", ({ "push" }));
  add_action("do_get", "get");

}

int do_get(string arg) {
  string obj, from;
  object me, shelf, target, taro;

  if (sscanf(arg, "%s from %s", obj, from) == 2) {
    if (obj == "all") {
      write("拿那么多经书干什么？\n");
      return 1;
    }
    shelf = present("book shelf", this_object());
    target = present(from, this_object());
    me = this_player();
    if (target == shelf) {
      taro = present(obj, target);
      if (taro) {
        message_vision("$N从书架上拿下一本经书。\n", me);
      }
    }
  }
  return 0;
}
void reset() {
  object *inv;
  object con, item;
  int i;

  ::reset();
  delete("push");
  con = present("book shelf", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 8) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new("/u/tian/shaolin/obj/sword-book");
    item->move(con);
    item = new("/u/tian/shaolin/obj/unarmed-book1");
    item->move(con);
    item = new("/u/tian/shaolin/obj/dodge-book1");
    item->move(con);
    item = new("/u/tian/shaolin/obj/parry-book1");
    item->move(con);
    item = new("/u/tian/shaolin/obj/fanwen-jing");
    item->move(con);
    item = new("/u/tian/shaolin/obj/magic-book");
    item->move(con);
    item = new("/u/tian/shaolin/obj/tear-book");
    item->move(con);
  }
}

int do_push(string arg) {
  object ob, ob1, me = this_player();

  if (!arg) return 0;
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (arg != "佛经") return 0;
  if (me->query_temp("left") != 6) {
    write("你伸手在佛经上一推，只见佛经微微一动，你身边传来喀哒一声。\n");
    if (me->query_temp("left") == 3 && query("push") == 0) {
      set("push", 1);
      return 1;
    }
    if (me->query_temp("left") == 11 && query("push") == 1) {
      set("push", 2);
      return 1;
    }
    if (me->query_temp("left") == 1 && query("push") == 2) {
      set("push", 3);
      return 1;
    }
    if (me->query_temp("left") == 7 && query("push") == 3) {
      if (random(me->query("kar")) > 15) {
        write("你发现身边的墙上居然打开一道暗门，里面很暗，看不清有什么。\n");
        write("你犹豫了一下，还是鼓足勇气钻了进去。\n");
        if (random(me->query("kar")) > 15) {
          write("暗门在你身后又关上了。\n");
          ob = (object)__DIR__ "cjge4";
          tell_room(ob, me->query("name") + "走了进来。\n");
          me->move(ob);
          tell_room(this_object(), me->query("name") + "一闪身，不见了。\n");
          return 1;
        }
        write("你一脚踏进去，发现里面居然是空的，连楼板都没有。\n");
        write("你大叫一声，直摔到楼下。\n");
        ob = (object)__DIR__ "cjge";
        tell_room(ob, me->query("name") + "走了过来。\n");
        me->move(ob);
        tell_room(this_object(), me->query("name") + "一闪身，不见了。\n");
        return 1;
      }
      set("push", 4);
      return 1;
    }
    set("push", 99);
    return 1;
  }
  return 0;
}
