// yudi.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("白石笛", ({ "baishi di", "yudi", "baishidi", "di" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 20000);
    set("material", "wood");
    set("long", "一根白石制就的笛子，白亮亮地甚是精致。\n");
    set("wield_msg", "$N拿起一根$n放在唇边轻轻一吹。\n");
    set("unwield_msg", "$N笑了一笑，将$n插回腰间。\n");
  }
  init_sword(15);
  setup();
}
