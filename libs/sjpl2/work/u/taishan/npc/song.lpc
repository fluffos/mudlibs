#include <ansi.h>

inherit NPC;
int about_quest();
string summon_more(object who);

void create() {
  set_name("宋和桂", ({ "song hegui", "song" }));
  set("gender", "男性");
  set("age", 20);
  set("long",
    "宋和桂主要负责守护天地人三才剑阵的阵门。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的泰山。",
    "三才剑阵": (: about_quest :),
    "进阵": (: about_quest :),
    "闯阵": (: about_quest :),
  ]));
  set("attitude", "peaceful");
  set("max_kee", 600);
  set("max_gin", 600);
  set("max_sen", 600);
  set("kee", 600);
  set("gin", 600);
  set("sen", 600);

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 10);
  set("combat_exp", 300000);
  set("score", 3000);

  set_skill("dodge", 40);
  set_skill("move", 30);
  set_skill("literate", 20);
  set_skill("parry", 40);
  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("sword", 40);

  set_skill("three-sword", 46);
  set_skill("pine_strike", 46);
  set_skill("liumai_force", 46);
  set_skill("star_dodge", 46);

  map_skill("dodge", "star_dodge");
  map_skill("unarmed", "pine_strike");
  map_skill("force", "liumai_force");
  map_skill("parry", "three-sword");
  map_skill("sword", "three-sword");
  create_family("泰山派", 3, "弟子");
  set("class", "taishan");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));

  setup();

  carry_object("obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg == "northup") {
    command("say 这是本派天地人三才剑阵，请勿乱闯！\n");
    write("这个方向的路被宋和桂挡住了 。\n");
    return 1;
  } else
    return 0;
}
int about_quest() {
  object me = this_player();
  /*
	if( this_object()->query_temp("taishan/counter") )
	{
	command("say 有人正在闯阵，请明天再来。\n");
	return 1;
	}
*/
  if (me->query("id_type") == 2) {
    command("say 嘿嘿，正邪势不两立，你要来破阵，且看你有没有这个本事！\n");
    me->move("/u/taishan/shixin");
    message_vision(HIR "\n宋和桂领$N进入了三才剑阵，随后冷笑着走开了。\n" NOR, me);
    this_object()->set_temp("taishan/counter", 1);
    return 1;
  }
  if (me->query("class") != "taishan") {
    command("say 这是本派天地人三才剑阵，非泰山弟子请勿入内！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < 600000) {
    command("say 你的武功太差了，进入本派三才剑阵会有性命危险！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") > 1000000) {
    command("say 你武艺超群，闯本派三才剑阵已经没有意义了！\n");
    return 1;
  } else {
    command("say 难得你有这般胆识，那就进去闯一闯吧！\n");
    me->set_temp("taishan/jianzhen", 1);
    me->move("/u/taishan/shixin");
    this_object()->set_temp("taishan/counter", 1);
    message_vision(CYN "\n宋和桂领$N进入了三才剑阵，随后微笑着走开了。\n" NOR, me);
    return 1;
  }
  return 1;
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "tsdizi2");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "1";
}
int accept_fight(object me) {
  command("say 请不要在这里惹是生非。");
  return 0;
}
