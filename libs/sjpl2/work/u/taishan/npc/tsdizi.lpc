#include <ansi.h>
int do_detect(object me);

inherit NPC;
void create() {

  set_name("泰山弟子", ({ "taishan dizi", "dizi" }));
  set("long", "这是一位泰山弟子，专门担任保护之责。\n");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("str", 40);
  set("cor", 30);
  set("cps", 25);
  set("food", 500);
  set("water", 500);

  set("combat_exp", 90000);
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("force", 30);

  set_skill("three-sword", 30);
  set_skill("mian_strike", 30);
  set_skill("taiqing_force", 30);
  set_skill("ganchan_steps", 30);
  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "three-sword");
  map_skill("sword", "three-sword");
  set("chat_chance", 50);
  set("chat_msg", ({
    (: do_detect :),
  }));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
int do_detect(object me) {
  string str;
  //	object owner, player;
  me = this_object();
  //	owner = me->query("possessed");
  if (me->query("water") < 1) {
    me->dismiss_team();
    destruct(me);
    return 1;
  }
  return 1;
}
