#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_shizu();
int about_taohua();
void create() {
  set_name("飘浮子", ({ "master piaofu", "piaofuzi", "master" }));
  set("title", "南门三奇");
  set("gender", "男性");
  set("age", 45);
  set("nickname", HIC "武夷一奇" NOR);
  set("long",
    "飘浮子是南门三奇之一，曾是武林中的一大奇人，据说长年在武夷山隐居。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);

  set("combat_exp", 2000000);
  set("score", 600);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 180);
  set_skill("move", 180);
  set_skill("literate", 170);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("force", 180);
  set_skill("sword", 180);

  set_skill("sanqing-jian", 180);
  set_skill("liheforce", 250);
  set_skill("zhengqijue", 250);
  set_skill("luohua_steps", 180);

  map_skill("dodge", "luohua_steps");
  map_skill("force", "liheforce");
  map_skill("parry", "sanqing-jian");
  map_skill("sword", "sanqing-jian");
  /*
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: exert_action, "maoheshenli" :),
        }) );
*/
  set("inquiry", ([
    "师祖": (: about_shizu :),
    "桃花岛": (: about_taohua :),
  ]));

  create_family("桃花岛", 2, "弟子");
  set("class", "taohua");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "taohua") {
    command("say 贫道归隐山林多年，早已不收弟子了！\n");
    return;
  }

  if (ob->query_skill("liheforce", 1) < 120) {
    command("say 贫道归隐山林多年，早已不收弟子了！\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "既然与贫道有缘，那就收下你吧！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "taohua");
  ob->set("id_type", 1);
}
int about_taohua() {
  object me = this_player();
  command("say 唉，师妹这又是何苦呢？远避东海，离尘索居，还不是为了当年的一段情孽？\n");
  command("say 桃树犹催少年泪，花自飘零水自流。一纸旧书离别苦，不忍断剑泣红尘！\n");
  me->set_temp("taohua/permit_going", 1);
  return 1;
}

int about_shizu() {
  command("say 师祖就是武林三逸中的南山野叟，只是他老人家萍踪不定，现在也不知身在何方？\n");
  return 1;
}
