// dragon-book

inherit ITEM;

void create() {
  set_name("《降龙十八掌掌谱》", ({ "dragon-book" }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本记载降龙十八掌的武功秘籍。\n");
  set("value", 0);
  set("skill", ([
    "name": "xianglong_strike",          // name of the skill
    "exp_required": 200,           // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 50,                  // gin cost every time study this
    "difficulty": 45,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 20   // the maximum level you can learn from this object.
  ]));
}
