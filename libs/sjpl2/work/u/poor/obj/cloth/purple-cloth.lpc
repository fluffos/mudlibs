// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(MAG "紫花上衣" NOR, ({ "purple-cloth", "cloth" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 50);
  }
  setup();
}
