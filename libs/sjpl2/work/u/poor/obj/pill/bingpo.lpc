// guazi.c
#include <ansi.h>;

inherit ITEM;
inherit F_FOOD;
int do_use(string arg);

void create() {
  set_name(WHT "冰魄" NOR, ({ "bingpo" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一种增强体质的圣药，可以ＵＳＥ。\n");
    set("unit", "个");
    set("value", 0);
    set("remaining", 1);
    set("food_supply", 1);
  }
  setup();
}
void init() {
  add_action("do_use", "use");
}


int do_use(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (arg != "bingpo") return 0;
  if (this_player()->query_temp("block_msg/all"));
  return notify_fail("什么？\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if ((int)me->query("food") >= (int)me->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也吃不下了。\n");
  message_vision("$N吃下了个$n！\n", me, ob);
  me->add("food", (int)query("food_supply"));
  if (me->query("extraforce/bingpo") < 10)
    me->add("max_force", 1);
  me->add("extraforce/bingpo", 1);
  tell_object(me, HIB "你只觉一股真气在体内游走，你的功力似乎提高了！\n" NOR);
  if (me->is_fighting()) me->start_busy(2);
  destruct(ob);
  return 1;
}
