// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name("竹杖", ({ "bamboo stick", "stick" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条短细的竹杖，使用起来很顺手。\n");
    set("value", 10);
    set("material", "bamboo");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(10);
  setup();
}
