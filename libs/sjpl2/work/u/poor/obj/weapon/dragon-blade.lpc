// blade.c

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name(HIY "金龙白玉刀" NOR, ({ "dragon-blade" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 5000);
    set("material", "iron");
    set("long", "这是一把宝刀。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(120);
  setup();
}
