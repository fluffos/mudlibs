// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name(HIG "青竹杖" NOR, ({ "green stick", "stick" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条碧绿的竹杖，但是有点隐隐发黄。\n");
    set("value", 20);
    set("material", "bamboo");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(100);
  setup();
}
