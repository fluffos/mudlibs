// hammer.c

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("木槌", ({ "hammer" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条又粗又长的木头。\n");
    set("value", 2);
    set("material", "wood");
    set("wield_msg", "$N拿出一条$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(5);
  setup();
}
