// ruoming

#include <ansi.h>
inherit NPC;

void create() {
  set_name("玉池若明", ({ "yuchi ruoming", "master", "ruoming" }));
  set("nickname", HIW "白面书生" NOR);
  set("title", "丐帮大智分舵舵主");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他就是丐帮大智分舵的舵主。\n");

  set("max_kee", 800);
  set("kee", 800);
  set("force", 1200);
  set("max_force", 800);
  set("force_factor", 50);
  set("combat_exp", 120000);
  set("class", "gaibang");

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("stick", 100);
  set_skill("begging", 100);

  set_skill("iron_strike", 100);
  set_skill("hitdog_zhen", 100);
  set_skill("canyun_force", 100);
  set_skill("literate", 100);
  set_skill("hitdog_stick", 100);

  map_skill("dodge", "hitdog_zhen");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/stick")->wield();
  carry_object("/obj/cloth")->wear();
}
