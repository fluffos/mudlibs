// chiling

#include <ansi.h>
inherit NPC;

void create() {
  set_name("邹处灵", ({ "zou chuling", "master", "chuling" }));
  set("nickname", HIC "青天孤鹤" NOR);
  set("title", "丐帮大孝分舵舵主");
  set("gender", "女性");
  set("age", 16);
  set("long",
    "她就是丐帮大孝分舵的舵主。\n");

  set("max_kee", 500);
  set("kee", 500);
  set("force", 900);
  set("max_force", 500);
  set("force_factor", 20);
  set("combat_exp", 90000);
  set("class", "gaibang");

  set_skill("unarmed", 70);
  set_skill("force", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set_skill("stick", 70);
  set_skill("begging", 70);

  set_skill("iron_strike", 70);
  set_skill("hitdog_zhen", 70);
  set_skill("canyun_force", 70);
  set_skill("hitdog_stick", 70);

  map_skill("dodge", "hitdog_zhen");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/stick")->wield();
  carry_object("/obj/cloth")->wear();
}
