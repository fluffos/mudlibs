// Room: /u/poor/yidao.c

inherit ROOM;

void create() {
  set("short", "花园");
  set("long", @LONG
这是黑风寨中的一个花园。在花园中央有一大片水塘，
水塘中种满了荷花。在池塘南边有座假山，山上有座小亭
子。东边是弟子休息的地方，南边是寨主的卧房。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "卧房": "卧房的门关着呢。不到开饭时间寨主一般不出去。
",
  ]));
  set("exits", ([
    "north": __DIR__ "hfqian",
    "west": __DIR__ "hffen",
    "east": __DIR__ "hfrest",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/louluo1": 2,
  ]));
  set("outdoors", "zhang");
  setup();
}
void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
  add_action("do_knock", "knock");
  add_action("do_knock", "qiao");
}

int do_jump(string arg) {
  if (arg == "池塘" || arg == "水塘") {
    if (this_player()->query_skill("dodge", 1) <= 100) {
      write("你犹豫了一下，没敢跳下去。\n");
      return 1;
    }
    message_vision("$N深吸一口气，从池塘边跳了下去。\n", this_player());
    this_player()->move(__DIR__ "hfchidi");
    message("vision", this_player()->name() + "跳到了池塘中。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}

int do_knock(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "门" || arg == "door" || arg == "卧房门") {
    if (!objectp(ob = present("kaorou", me))) {
      write("房中没人理你。\n");
      return 1;
    }
    message_vision("$N敲了敲房门，寨主说道：开饭了？进来吧。\n", me);
    message_vision("$N端着烤肉走了进去。\n", me);
    me->move(__DIR__ "hfboss");
    return 1;
  } else return 0;
}
