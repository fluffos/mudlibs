#include <ansi.h>
inherit NPC;
void create() {
  set_name("薛苦", ({ "xue ku", "xueku" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "黑风寨狂堂堂主");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "薛苦说道：寨主怎么还不来？。\n",
  }));
  set("long", "他是黑风寨狂堂堂主。\n");

  set("combat_exp", 600000);
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 1500);
  set("force_factor", 30);
  set("attitude", "aggressive");

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("iron_strike", 100);
  set_skill("shaolin-dodge", 100);
  set_skill("dodge", 120);
  set_skill("literate", 50);
  map_skill("unarmed", "iron_strike");
  map_skill("dodge", "shaolin-dodge");

  setup();

  carry_object("/u/poor/obj/cloth/tiejia")->wear();
}
