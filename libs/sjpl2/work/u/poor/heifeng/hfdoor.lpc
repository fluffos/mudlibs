// Room: /u/poor/yidao.c

inherit ROOM;

void create() {
  set("short", "黑风寨大门");
  set("long", @LONG
你来到了黑风寨的大门口，在大门的两边各有一个旗杆。
左边的旗子上写“惟我独尊”四个大字，右边的旗子上写着
“千秋万载”四个大字。在门口有几个巡逻的喽罗。
LONG
  );

  set("exits", ([
    "west": __DIR__ "hfqian",
    "northeast": __DIR__ "hfroad3",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/louluo": 3,
  ]));
  set("outdoors", "zhang");
  setup();
}
int valid_leave(object who, string exit) {
  object ob;
  ob = present("louluo", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "west") && (present("louluo", environment(who))))
    return notify_fail("喽罗说道：“你找死呀！”\n");
  return ::valid_leave(who, exit);
}
