// Room: /u/poor/yidao.c

inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你走在上山的小路上，西南边有一座巨大的山寨，远处
是连绵起伏的山脉。路的两边是低矮的灌木。
LONG
  );

  set("exits", ([
    "southwest": __DIR__ "hfdoor",
    "northeast": __DIR__ "hfroad2",
  ]));
  set("outdoors", "zhang");
  setup();
}
void init() {
  add_action("do_go", "go");
}

int do_go() {
  if (random(2)) {
    this_player()->move(this_object());
    return 1;
  }
}
