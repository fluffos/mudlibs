// Room: /u.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "中练武场" NOR);
  set("long", @LONG
这里是丐帮智舵弟子练功的地方，有不少丐帮的弟子在此修习
武功。在这里有几个木桩，你可以在这里练习拳脚的功夫。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "southwest": __DIR__ "zkongdi2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/muzhuang": 2,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_hit", "hit");
}
int do_hit() {
  object me;
  me = this_player();

  if ((int)me->query("gin") < 30) {
    tell_object(me, "你太疲倦了。\n");
    return 1;
  }
  message_vision("$N用尽全力向木桩打去。\n", me);
  if ((int)me->query_skill("unarmed", 1) <= 40) {
    message_vision("$N什么也没领悟到。\n", me);
    return 1;
  } else if ((int)me->query_skill("unarmed", 1) <= 80) {
    me->receive_damage("gin", 20);
    me->improve_skill("unarmed", (int)me->query_skill("literate", 1) / 3 + 1);
    return 1;
  } else {
    tell_object(me, "你已经不需要打木桩了。\n");
    return 1;
  }
}
