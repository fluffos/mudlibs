// Room: /gaibang/gbwuch4.c

inherit ROOM;
#include <ansi.h>;

create() {
  set("short", "水中");
  set("long", @LONG
你跳进了井水当中，这里一片朦胧，能够隐隐约约看见井
底有些亮光。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "zwell",
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_dive", "dive");
}

int do_dive(string arg) {
  if (arg == "down" || arg == "井底") {
    if (this_player()->query_skill("dodge", 1) <= 20) {
      write("你犹豫了一下，不敢向下游了。\n");
      return 1;
    }
    message_vision("$N向水的深处游了过去。\n", this_player());
    this_player()->move(__DIR__ "zwell2");
    message("vision", this_player()->name() + "向水的深处游去。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
