// Room: /gaibang/gbwuch4.c

inherit ROOM;
#include <ansi.h>;

create() {
  set("short", "黑松林");
  set("long", @LONG
你走进了黑松林中，这里四周都是层层叠叠的松树，几乎看
不见日光，每棵松树都高大挺拔，树的四周长着一些低小的植物。
在树林中能看见有一口井。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "井": "井中的井水清澈，好象从井底传了一阵阵的声音。
",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "zsonglin4",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/mengxc": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
}

int do_jump(string arg) {
  if (arg == "井" || arg == "well") {
    if (this_player()->query_skill("dodge", 1) <= 20) {
      write("你犹豫了一下，没敢跳下去。\n");
      return 1;
    }
    message_vision("$N深吸一口气，从井边跳了下去。\n", this_player());
    this_player()->move(__DIR__ "zwell1");
    message("vision", this_player()->name() + "跳到了井中。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
