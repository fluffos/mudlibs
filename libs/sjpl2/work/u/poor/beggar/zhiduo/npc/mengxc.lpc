// mengxiance

#include <ansi.h>
inherit NPC;

void create() {
  set_name("孟献策", ({ "meng xiance", "master", "meng" }));
  set("nickname", HIC "神算子" NOR);
  set("title", "丐帮六袋弟子");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是丐帮智舵中弟子，聪明无比，经常给舵主出谋划策。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "井": "传说井底能通到什么地方，但没人下去过。",
  ]));
  set("max_kee", 1500);
  set("kee", 1500);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 50);
  set("combat_exp", 100000);

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("begging", 100);

  set_skill("iron_strike", 100);
  set_skill("xianglong_strike", 50);
  set_skill("hidden_dodge", 100);
  set_skill("canyun_force", 100);
  set_skill("literate", 150);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮", 6, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 80) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮智舵大弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找付崎修习武功吧。\n");
  }
}
