inherit ROOM;

void create() {
  set("short", "红叶林");
  set("long", @LONG
你走进了红叶林中，这里树的叶子到了秋天就全变成了
红色的，所以人们叫这里为红叶林，但是走进这里很容易迷
失方向，还是快点离开吧。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "shulin1",
    "east": __DIR__ "shulin3",
    "west": __DIR__ "shulin2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}
void init() {
  add_action("do_go", "go");
}

int do_go() {
  if (random(2)) {
    this_player()->move(this_object());
    return 1;
  }
}
