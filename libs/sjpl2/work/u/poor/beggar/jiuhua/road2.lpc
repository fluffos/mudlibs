// /u/poor/gaibang/hj
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你走在上山的小路上，北边就是雄壮、秀奇的九华山，
南边是一条通往扬州城的小路。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "road3",
    "south": __DIR__ "road1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}
void init() {
  add_action("do_go", "go");
}

int do_go() {
  if (random(3)) {
    this_player()->move(this_object());
    return 1;
  }
}
