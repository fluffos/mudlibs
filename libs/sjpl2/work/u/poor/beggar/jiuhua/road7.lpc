  set("short", "山路");
  set("long", @LONG
你走在九华山西边的山路上，四周是山中的仓松翠竹，在东
边是隐约能看见有一座寺庙。在这里不时能听到几声寺中敲钟的
声音。北边是蜿蜒的山路。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "road8",
    "south": __DIR__ "road6",
    "east": __DIR__ "gldoor",
  ]));
