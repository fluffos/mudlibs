// /u/poor/gaibang/hj
inherit ROOM;

void create() {
  set("short", "峭壁");
  set("long", @LONG
你的面前是高不可攀的峭壁，峭壁上边就是「九华十景」
中的一景“天柱仙踪”。在光秃秃的峭壁上隐约能看见几株紫
色的小草。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "road3",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "峭壁" || arg == "qiaobi") {
    if (!objectp(ob = present("masheng", me))) {
      write("你慢慢的向悬崖上爬去，一不小心摔了下来。\n");
      this_player()->unconcious();
      return 1;
    }
    message_vision("$N把麻绳荡到了峭壁上的一块突出的石头上，双手抓住麻绳向上爬去。\n", me);
    me->move(__DIR__ "qiaobis");
    return 1;
  } else return 0;
}
