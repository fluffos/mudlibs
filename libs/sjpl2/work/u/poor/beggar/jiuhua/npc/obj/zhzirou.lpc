// rou

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("獐子肉", ({ "zhzirou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块新鲜的獐子肉。\n");
    set("unit", "块");
    set("value", 3000);
    set("food_remaining", 3);
    set("food_supply", 40);
  }
}
