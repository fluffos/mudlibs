// sengyi.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("僧袍", ({ "sengpao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("value", 40);
    set("armor_prop/armor", 2);
  }
  setup();
}
