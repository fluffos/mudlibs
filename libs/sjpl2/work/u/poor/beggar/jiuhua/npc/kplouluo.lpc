// banker.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("喽罗", ({ "louluo" }));
  set("title", "飞鹰寨鲲鹏堂");
  set("gender", "男性");
  set("age", 31);
  set("long",
    "他是飞鹰寨中的喽罗，干尽了各种伤天害理的坏事。\n");

  set("combat_exp", 30000);
  set("attitude", "aggressive");

  set("max_force", 800); set("force", 800);
  set("force_factor", 10);

  set_skill("unarmed", 80);
  set_skill("parry", 70);
  set_skill("dodge", 80);
  set_skill("sword", 70);
  set_skill("crazy_sword", 50);
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  setup();
  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}

int accept_fight(object me) {
  command("say 咦... 要打就真打吧，光是较量多没意思？");
  kill_ob(me);
  return 1;
}
