#include <ansi.h>
inherit NPC;
void create() {
  set_name("段鹏飞", ({ "pengfei" }));
  set("nickname", HIR "嗜血罗煞" NOR);
  set("title", "飞鹰寨大寨主");
  set("gender", "男性");
  set("age", 55);
  set("long", "他是这里的大寨主，是个杀人不眨眼的魔头。\n");
  set("max_kee", 5000);
  set("kee", 5000);
  set("force", 4000);
  set("max_force", 3500);
  set("force_factor", 50);
  set("combat_exp", 300000);
  set("attitude", "aggressive");

  set_skill("unarmed", 150);
  set_skill("force", 150);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("crazy_sword", 100);
  set_skill("hidden_dodge", 100);
  set_skill("iron_strike", 100);
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");
  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");

  setup();
  carry_object(__DIR__ "obj/sword")->wear();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/mapleft");
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 你想来送死吗？");
}

int accept_fight(object me) {
  command("say 咦... 要打就真打吧，光是较量多没意思？");
  kill_ob(me);
  return 1;
}
