// magic book

inherit ITEM;

void create() {
  set_name("《禅说》", ({ "chanshuo", "jing", }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本介绍坐禅术的书。\n");
  set("value", 3000);
  set("skill", ([
    "name": "zuochanshu",          // name of the skill
    "exp_required": 2000,           // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 40,                  // gin cost every time study this
    "difficulty": 15,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 44   // the maximum level you can learn from this object.
  ]));
}
