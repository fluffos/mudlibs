#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create() {
  set_name(RED "玄铁戒指" NOR, ({ "iron_finger", "finger" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一只玄铁打造的戒指，戒指隐隐透出红色。\n");
    set("unit", "只");
    set("value", 20000);
    set("material", "iron");
    set("armor_prop/damage", 50);
    set("armor_prop/personality", 50);
    set("female_only", 0);
  }
  setup();
}
