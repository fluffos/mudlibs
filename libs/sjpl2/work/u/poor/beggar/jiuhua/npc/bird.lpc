// fish.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("喜鹊", ({ "bird" }));
  set("long", "一只全身黑色的大喜鹊。\n");

  set("race", "野兽");
  set("age", 2);

  set("max_gin", 100);
  set("max_kee", 100);
  set("max_sen", 100);
  set_skill("move", 10);
  set_skill("unarmed", 10);
  set_skill("parry", 10);

  set("str", 10);
  set("cor", 50);

  set("limbs", ({ "头部", "身体" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 30);
  set("combat_exp", 3000);
  setup();
}
