#include <ansi.h>
inherit NPC;
void create() {
  set_name("王红燕", ({ "hongyan" }));
  set("nickname", HIM "凌波仙子" NOR);
  set("title", "飞鹰寨寨主夫人");
  set("gender", "女性");
  set("age", 25);
  set("per", 40);
  set("long", "她以前是江湖上有名的美人，不知道因为什么嫁给了段寨主。\n");
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("combat_exp", 100000);

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("hidden_dodge", 100);
  set_skill("iron_strike", 100);
  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");

  setup();
  carry_object(__DIR__ "obj/hcloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 哪来的毛贼，敢来这里捣乱。");
}

int accept_fight(object me) {
  command("say 咦... 要打就真打吧，光是较量多没意思？");
  kill_ob(me);
  return 1;
}
