// Room: /gaibang/gbwuch4.c

inherit ROOM;
#include <ansi.h>;

create() {
  set("short", "黑松林");
  set("long", @LONG
你走进了黑松林中，这里四周都是层层叠叠的松树，几乎看
不见日光，每棵松树都高大挺拔，树的四周长着一些低小的植物。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "松树": "这是一棵高大挺拔的松树，在树上有一个鸟巢。
",
  ]));

  set("exits", ([ /* sizeof() == 4 */
    "southeast": __DIR__ "songlin3",
    "southwest": __DIR__ "songlin2",
    "northwest": __DIR__ "songlin5",
    "north": __DIR__ "house1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}

void init() {
  add_action("do_climb", "climb");
  add_action("do_climb", "pa");
}

int do_climb(string arg) {
  if (arg == "松树" || arg == "tree") {
    if (this_player()->query_skill("dodge", 1) <= 30) {
      write("你没有勇气爬上松树。\n");
      return 1;
    }
    message_vision("$N双手抓住树干，向树上爬去。\n", this_player());
    this_player()->move(__DIR__ "songshu");
    message("vision", this_player()->name() + "爬到了树上。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
