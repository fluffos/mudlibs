// Room: /poor/jingstreet.c

inherit ROOM;

int rou_num = 4;

void create() {
  set("short", "黑松林");
  set("long", @LONG
你走进了黑松林中，这里四周都是层层叠叠的松树，几乎看
不见日光，每棵松树都高大挺拔，树的四周长着一些低小的植物。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "松树": "在树干的底部长着一片鲜嫩的松蘑。
",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "songlin1",
    "northeast": __DIR__ "songlin4",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "snake": 2,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}

void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object obj;
  if (arg == "松蘑" || arg == "songmo") {
    if (rou_num != 0) {
      obj = new(__DIR__ "songmo");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N摘下一朵松蘑。\n", this_player());
      rou_num--;
    } else write("树下什么都没有了。\n");
    return 1;
  } else return 0;
}
