// beggar.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("乞丐", ({ "beggar" }));
  set("title", "丐帮三袋弟子");
  set("gender", "男性");
  set("age", 25);
  set("long",
    "他是负责守护礼舵的弟子。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "进门": "只有本帮弟子才能进入智舵。",
  ]));
  set("max_kee", 500);
  set("kee", 500);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 10);
  set("combat_exp", 10000);

  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("begging", 50);

  set_skill("iron_strike", 50);
  set_skill("hidden_dodge", 50);
  set_skill("canyun_force", 50);
  set_skill("literate", 20);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮", 8, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
