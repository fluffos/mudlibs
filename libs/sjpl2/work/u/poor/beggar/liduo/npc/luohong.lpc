// luohong

#include <ansi.h>
inherit NPC;

void create() {
  set_name("罗洪", ({ "luo hong", "master", "luohong" }));
  set("nickname", HIY "震八方" NOR);
  set("title", "丐帮大礼分舵舵主");
  set("gender", "男性");
  set("age", 45);
  set("long",
    "他就是丐帮大礼分舵的舵主。\n");
  set("inquiry", ([
    "酒": "听说百草酒甘甜可口，可不知道哪有。",
    "好酒": "听说百草酒甘甜可口，可不知道哪有。",
    "喜好": "我十分喜欢喝好酒。",
    "钥匙": "你问那么多干吗？",
  ]));
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("combat_exp", 200000);
  set("class", "gaibang");

  set_skill("unarmed", 100);
  set_skill("force", 140);
  set_skill("parry", 140);
  set_skill("dodge", 140);
  set_skill("stick", 150);
  set_skill("literate", 140);
  set_skill("begging", 140);

  set_skill("iron_strike", 100);
  set_skill("hidden_dodge", 140);
  set_skill("canyun_force", 140);
  set_skill("hitdog_stick", 140);
  set_skill("qingyun_stick", 140);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 4, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/stick")->wield();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 90) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮礼舵副舵主");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找惊无命修习武功吧。\n");
  }
}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "baicao-jiu") {
    command("say 这不是我要的百草酒。\n");
    return 0;
  } else {
    command("say 这酒味道不错！");
    command("say 这把钥匙你就拿走吧。");
    ob = new(__DIR__ "obj/white-key");
    ob->move(me);
  }
  return 1;
}
