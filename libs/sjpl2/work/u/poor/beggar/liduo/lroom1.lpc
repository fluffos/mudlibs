// chanfang

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "禅房" NOR);
  set("long", @LONG
这是一间极为简陋的禅房。室内空荡荡地别无他物。
LONG
  );

  set("exits", ([
    "west": __DIR__ "lqianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/songqing": 1,
  ]));

  set("sleep_room", 1);
  set("no_clean_up", 0);

  setup();
}
