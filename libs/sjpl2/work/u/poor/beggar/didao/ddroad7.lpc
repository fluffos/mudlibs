// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "地道" NOR);
  set("long", @LONG
你走在丐帮的地道之中，这里光线十分昏暗，几乎看无清
四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在南边有两
个岔口。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "ddroad8",
    "west": __DIR__ "ddroad6",
    "southeast": __DIR__ "ddwu1",
    "southwest": __DIR__ "ddwu1",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_go", "go");
}

int do_go(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "southwest") {
    message_vision("$N向西南边的岔口走去。\n\n", me);
    message_vision(HIR "突然从墙壁上射出几只箭刺中了$N。\n" NOR, me);
    me->die();
    return 1;
  } else return 0;
}
