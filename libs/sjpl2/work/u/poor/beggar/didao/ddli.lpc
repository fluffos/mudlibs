// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "食堂" NOR);
  set("long", @LONG
你来到了地道中的一个食堂，这里早已经没有人生火做饭。
在食堂的左边有两个灶。右边是一个空架子。
LONG
  );
  set("item_desc", ([
    "灶": "这个灶长年都不点火做饭。\n",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "ddroad13",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/beggar": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  if (arg == "灶" || arg == "cooker") {
    if (this_player()->query_skill("force", 1) <= 40) {
      write("你身子过大，钻不进去。\n");
      return 1;
    }
    message_vision("$N运起丐帮身功[缩骨法]，身子突然瘦小了许多，钻进了灶中。\n", this_player());
    this_player()->move("/u/poor/beggar/liduo/lkitchen");
    message("vision", this_player()->name() + "钻进了灶中。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
