#include <ansi.h>
inherit NPC;
void create() {
  set_name("周明", ({ "zhou ming", "zhou ming" }));
  set("gender", "男性");
  set("age", 45);
  set("title", "丐帮五袋弟子");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "周明缓缓说道：那天我看见罗舵主拿了一把钥匙。。。。\n",
    "周明自言自语道：罗舵主也喜好喝酒。。。。。\n",
    "周明打了一个嗝。\n",
  }));
  set("long", "他已经喝的醉醺醺了。\n");

  set("combat_exp", 600000);

  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("literate", 20);
  set_skill("unarmed", 40);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
