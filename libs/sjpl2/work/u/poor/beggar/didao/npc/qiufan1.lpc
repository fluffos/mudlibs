// beggar.c

#include <ansi.h>
inherit NPC;
int paper_count = 1;
int ask_letter();

void create() {
  set_name("孔伦", ({ "kong lun", "kong" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "他是个囚犯。\n");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "孔伦说道：你能帮我带封家书给我娘吗？\n",
  }));
  set("inquiry", ([
    "你娘": "我娘叫何秀花，别人都叫她何寡妇。",
    "张家口": "张家口就在北面不远。",
    "家书": (: ask_letter :),
  ]));
  set("max_kee", 150);
  set("kee", 150);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 2);
  set("combat_exp", 100 + random(5000));
  set_skill("unarmed", 20 + random(10));
  set_skill("stick", 20 + random(10));
  set_skill("parry", 20 + random(10));
  set_skill("dodge", 20 + random(10));


  setup();

  carry_object("/u/poor/obj/cloth/qiufu")->wear();
}
int ask_letter() {
  object me, ob, xiao;
  int sk;
  me = this_player();
  ob = this_object();
  sk = (int)me->query_skill("literate", 1);
  if ((sk > 20) && (ob->query("paper_count") < 0)) {
    command("say 我的家书已经让别人代送了。\n");
    return 1;
  } else if ((sk > 20)) {
    command("say 你把我的家书带到张家口豆腐店，给我娘就行了。\n");
    command("say 谢谢您了！\n");
    ob->add("paper_count", -1);
    xiao = new(__DIR__ "obj/jiashu");
    xiao->move(me);
    message_vision("$N给$n一封家书。\n", ob, me);
    return 1;
  } else {
    command("shake");
    command("say 你不可靠，我不能让你帮我带家书！\n");
    return 1;
  }
}
