// beggar.c

#include <ansi.h>
inherit NPC;


void create() {
  string *order = ({ "赵贵", "王喜", "梁空轮", "郭强", "白谷", "范叶", "杨福喜", "胡泊羊", "顾岷" });

  set_name((order[random(9)]), ({ "qiufan" }));
  set("gender", "男性");
  set("age", 15 + random(50));
  set("long",
    "他是个囚犯。\n");
  set("max_kee", 150);
  set("kee", 150);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 2);
  set("combat_exp", 100 + random(5000));
  set_skill("unarmed", 20 + random(10));
  set_skill("stick", 20 + random(10));
  set_skill("parry", 20 + random(10));
  set_skill("dodge", 20 + random(10));


  setup();

  carry_object("/u/poor/obj/cloth/qiufu")->wear();
}
