#include <ansi.h>
inherit NPC;
void create() {
  set_name("张桐", ({ "zhang tong", "zhangtong" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "丐帮礼舵弟子");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "张桐自言自语道：真不知道我们舵主喜好什么？\n",
    "张桐小声对你说道：听说开石门的三把钥匙分别在三个舵主手里。\n",
    "张桐小声对你说道：听说孝舵舵主喜好好看的衣服。\n",
  }));
  set("long", "他是一个胖胖的乞丐。\n");

  set("combat_exp", 600000);

  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("literate", 20);
  set_skill("unarmed", 100);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
