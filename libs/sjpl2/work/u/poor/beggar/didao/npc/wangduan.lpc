#include <ansi.h>
inherit NPC;
void create() {
  set_name("王端", ({ "wang duan", "wangduan" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "丐帮五袋弟子");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "王端说道：也不知道石门后关的是什么人？\n",
  }));
  set("long", "他是一个丐帮弟子，负责看守石门。\n");

  set("combat_exp", 600000);

  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("literate", 20);
  set_skill("unarmed", 100);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
