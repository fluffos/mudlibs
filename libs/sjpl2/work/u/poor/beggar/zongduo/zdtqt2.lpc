// Room: /jing/duankit.c

inherit ROOM;
#include <ansi.h>

int rou_num = 2;

void create() {
  set("short", HIB "唾弃厅" NOR);
  set("long", @LONG
这是丐帮的议事大厅，看不到一把倚子，只是后墙的正中有一
张小方桌，桌上放着一些小瓶子，瓶子中不知道装着什么。在桌子
的旁边站着一个人。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "小瓶子": "不知道里边装了什么东西。
",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "out": __DIR__ "zdzoul1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/masterz": 1,
  ]));
  set("no_clean_up", 0);

  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object obj, me;
  me = this_player();
  if (arg == "小瓶子" || arg == "瓶子") {
    if (rou_num != 0) {
      obj = new("/u/poor/obj/pill/huanhun-dan");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N从瓶子中倒出一粒丹药。\n", this_player());
      rou_num--;
    } else write("瓶子中已经空了。\n");
    return 1;
  } else return 0;
}
