// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", HIB "大门" NOR);
  set("long", @LONG
一条小石路，路的两侧是大片的竹林，阳光透过竹林泻在路上，映射
出斑驳的影象，又不时有阵阵微风吹过，发出“沙，沙”地声音。再向里
走就是丐帮总舵了。
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "zdwuch1",
    "south": __DIR__ "zhulin15",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/guoshilong": 1,
  ]));
  set("outdoors", "gaibang");
  set("no_clean_up", 0);

  setup();
  //	replace_program(ROOM);
}

int valid_leave(object who, string exit) {
  object ob;
  ob = present("guo", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "north") && (who->query("class") != "gaibang") && (present("guo", environment(who))))
    return notify_fail("郭世龙说道：“前面是本帮总舵，请您速速离去！”\n");
  return ::valid_leave(who, exit);
}
