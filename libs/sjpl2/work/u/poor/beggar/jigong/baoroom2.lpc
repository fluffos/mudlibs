// Room: /jing/duankit.c

inherit ROOM;
string look_yin();

mapping skill = ([
  "name": "force",
  "exp_required": 10000,
  "sen_cost": 50,
  "difficulty": 30,
  "max_skill": 161,
]);

void create() {
  set("short", "商殷宝库");
  set("long", @LONG
你通过生门来到这里，这里并没有什么值钱的东西。在地
上堆满了书卷。在北边的墙壁上隐隐约约能看见一位绝世美女
的图案。在南边的墙壁上可以清晰的看出一位帝王的画相。
LONG
  );
  set("item_desc", ([ /* sizeof() == 2 */
    "美女的图案": "你看了一眼美女的图案(draw)便神魂颠倒，似乎对修习武功有很大易处。
",
    "帝王的画相": "你看了一眼帝王的画像，画中的帝王有几分像传说中的商纣王。
",
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "baohall",
  ]));
  set("objects", ([ /* sizeof() == 4 */
    __DIR__ "obj/book1": 1,
    __DIR__ "obj/book2": 1,
    __DIR__ "obj/book3": 1,
    __DIR__ "obj/book4": 1,
  ]));
  set("no_clean_up", 0);

  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_du", ({ "study" }));
  add_action("do_du", ({ "du" }));

}

int do_du(string arg) {

  object ob = this_object(), me = this_player();
  int my_skill;
  int cost;

  if (arg != "draw") {
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }

  message("vision", me->name() + "专心看了一遍美女的图案。\n", environment(me), me);

  if ((int)me->query("combat_exp") < skill["exp_required"]) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  if (!SKILL_D(skill["name"])->valid_learn(me)) return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query("int")) / 20;
  //printf("%d ",cost);
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来修习。\n");
    return 1;
  }

  if (me->query_skill(skill["name"], 1) > skill["max_skill"]) {
    write("美女的图案渐渐消失了。\n");
    return 1;
  }

  me->receive_damage("sen", cost);

  if (my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你没有任何收获。\n");
    return 1;
  }

  me->improve_skill(skill["name"], (int)me->query_skill("literate", 1) / 5 + 1);
  write("你看了一遍美女的图案，对有关" + to_chinese(skill["name"]) + "的技巧有些帮助。\n");
  return 1;
}
