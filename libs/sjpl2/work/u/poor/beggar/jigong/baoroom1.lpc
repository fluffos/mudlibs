// Room: /jing/duankit.c

inherit ROOM;
int sword_num = 4;
int cezi_num = 3;

void create() {
  set("short", "商殷宝库");
  set("long", @LONG
你来到了商殷宝库之中，这里四处金光闪闪。墙壁全是
有金砖砌成的，有的金砖上还镶嵌着一两块钻石。在地上还
散落着不少珍宝。在正中的墙上有一个石头做成的拉杆。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "baohall",
  ]));
  set("item_desc", ([ /* sizeof() == 3 */
    "金砖": "这是在墙上的一块块的金砖，你可以试着挖出来。
",
    "钻石": "这是镶嵌的墙上的钻石，你可以试着凿下来。
",
    "拉杆": "这是一个控制机关的拉杆，你可以拉(pull)一下。
",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "obj/yuzhuo": 2,
    __DIR__ "obj/shanhu": 1,
    __DIR__ "obj/jinzhuan": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_wa", "wa");
  add_action("do_zao", "zao");
  add_action("do_pull", "pull");
}

int do_pull(string arg) {
  if (arg == "拉杆" || arg == "lagan") {
    if (this_player()->query_skill("unarmed", 1) <= 40) {
      write("你用力拉动拉杆，可是什么都没有发生。\n");
      return 1;
    }
    message_vision("$N用力拉动拉杆，只听“咚”的一声，开起了一道石门。\n", this_player());
    message_vision("$N走了进去。\n", this_player());
    message_vision("只听“咚”的一声，石门关上了。\n", this_player());
    this_player()->move(__DIR__ "baodie");
    //		message("vision", this_player()->name() + "钻了进去。\n",
    //		message_vision("只听“咚”的一声，石门关上了。\n", this_player());
    //			environment(this_player()), this_player());
    return 1;
  } else return 0;
}
int do_wa(string arg) {
  object obj;
  if (arg == "金砖" || arg == "jinzhuan") {
    if (sword_num != 0) {
      obj = new(__DIR__ "obj/jinzhuan");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N用力挖出了一块金砖。\n", this_player());
      sword_num--;
    } else write("这些金砖太牢固了，你挖不出来。\n");
    return 1;
  } else return 0;
}
int do_zao(string arg) {
  object obj;
  if (arg == "zuanshi" || arg == "钻石") {
    if (cezi_num != 0) {
      obj = new(__DIR__ "obj/zuanshi");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N凿下了一颗钻石。\n", this_player());
      cezi_num--;
    } else write("钻石已经没了。\n");
    return 1;
  } else return 0;
}
