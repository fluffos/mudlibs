// Room: /gaibang/gbwuch4.c

inherit ROOM;
#include <ansi.h>;

create() {
  set("short", "小桥");
  set("long", @LONG
你走上了一座普通的小桥，桥下是清澈见底的河水。在东边有
个小村子，西边的远处是一片树林。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "river": "小河里有很多游来游去的鱼。
",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "jhw2",
    "west": __DIR__ "jhhebian1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/yu_seller": 1,
    __DIR__ "npc/girl": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
}

int do_jump(string arg) {
  if (arg == "小河" || arg == "river") {
    if (this_player()->query_skill("dodge", 1) <= 20) {
      write("你犹豫了一下，没敢跳下去。\n");
      return 1;
    }
    message_vision("$N深吸一口气，从桥上跳了下去。\n", this_player());
    this_player()->move(__DIR__ "jhriver");
    message("vision", this_player()->name() + "跳到了河中。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
