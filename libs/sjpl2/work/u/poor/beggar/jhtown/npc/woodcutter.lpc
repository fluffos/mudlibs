#include <ansi.h>
inherit NPC;
void create() {
  set_name("樵夫", ({ "woodcutter" }));
  set("gender", "男性");
  set("age", 45);
  set("str", 30);
  set("cor", 10);
  set("cps", 15);
  set("per", 10);
  set("int", 20);
  set("chat_chance_combat", 10);
  set("chat_chance", 20);
  set("chat_msg", ({
    "樵夫说道：过了林子就到钟前辈的茅屋了。\n",
  }));
  set("long", "他是一个普普通通的樵夫，他家世世代代以这片树林为生。\n");

  set("combat_exp", 50000);

  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 欢迎你来到黑松林。");
}
