// hammer.c

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("鱼杆", ({ "yugan" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根钓鱼用的鱼杆。\n");
    set("value", 1000);
    set("material", "wood");
    set("wield_msg", "$N拿出一条$n，握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(1);
  setup();
}
