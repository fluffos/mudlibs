#include <ansi.h>
inherit NPC;
void create() {
  set_name("老酒鬼", ({ "oldman" }));
  set("gender", "男性");
  set("age", 85);
  set("str", 30);
  set("cor", 10);
  set("cps", 15);
  set("per", 10);
  set("int", 20);
  set("chat_chance", 1);
  set("chat_msg", ({
    "老酒鬼醉醺醺的说道：那天我在山中看见了一个仙女，一眨眼就消失了。\n",
    "老酒鬼舔了舔嘴，说道：江湖上传说十五年前，丐帮帮主施楠与古墓派传人在无尘崖比武，争夺天下第一的称号。\n",
    "老酒鬼睁大了眼睛，说道：在咱们村外住着一个高人。\n",
  }));
  set("long", "他是个视酒如命的酒鬼。\n");

  set("combat_exp", 50000);
  set("max_kee", 200);
  set("kee", 200);
  set("force", 400);
  set("max_force", 500);
  set("force_factor", 10);

  set_skill("unarmed", 40);
  set_skill("force", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set_skill("literate", 30);

  setup();
  carry_object(__DIR__ "obj/linen")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 来来，一起喝酒。");
}
