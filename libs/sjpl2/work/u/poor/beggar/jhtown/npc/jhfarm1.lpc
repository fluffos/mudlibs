#include <ansi.h>
inherit NPC;
void create() {
  set_name("闫云", ({ "yan yun", "farmer" }));
  set("gender", "女性");
  set("age", 35);
  set("str", 10);
  set("cor", 10);
  set("cps", 15);
  set("title", "鸡华村农姑");
  set("per", 10);
  set("int", 20);
  set("chat_chance_combat", 10);
  set("chat_chance", 20);
  set("chat_msg", ({
    "闫云说道：曹大嫂呀，你家的妞妞多大了？\n",
  }));
  set("long", "她是一个普普通通的农民，世世代代以种田为生。\n");

  set("combat_exp", 600);

  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("literate", 20);
  set_skill("unarmed", 20);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  setup();

  carry_object("/u/poor/obj/cloth/gcloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 村长又要开会，好象有什么大事。");
}
