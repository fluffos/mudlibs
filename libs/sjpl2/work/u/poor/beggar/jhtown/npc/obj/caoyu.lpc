// fish

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("草鱼", ({ "caoyu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条刚死不久的草鱼。\n");
    set("unit", "条");
    set("value", 1000);
    set("food_remaining", 3);
    set("food_supply", 20);
  }
}
