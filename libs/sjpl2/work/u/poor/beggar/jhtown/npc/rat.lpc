// rat.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("老鼠", ({ "rat" }));
  set("long", "这是一只大老鼠。\n");

  set("race", "野兽");
  set("age", 3);

  set("max_gin", 150);
  set("max_kee", 200);
  set("max_sen", 150);
  set_skill("dodge", 40);
  set_skill("unarmed", 10);
  set_skill("parry", 20);

  set("str", 10);
  set("cor", 50);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 20);

  set("combat_exp", 3000);
  setup();
}
