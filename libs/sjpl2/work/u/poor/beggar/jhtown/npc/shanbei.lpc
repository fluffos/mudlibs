// fish.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("扇贝", ({ "shanbei" }));
  set("long", "一个很大的扇贝。\n");

  set("race", "野兽");
  set("age", 3);

  set("max_gin", 800);
  set("max_kee", 800);
  set("max_sen", 800);
  set_skill("dodge", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);

  set("str", 10);
  set("cor", 50);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 20);
  set("combat_exp", 30000);
  setup();
}
void die() {
  object rou;
  rou = new(__DIR__ "obj/shanbeirou");
  rou->move(this_object());
  ::die();
}
