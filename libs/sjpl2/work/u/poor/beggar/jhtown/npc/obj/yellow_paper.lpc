// stone.c

inherit ITEM;

void create() {
  set_name("黄色纸片", ({ "yellow_paper" }));
  set_weight(100);
  set("long", @LONG 
纸片上写着：
                何   本   明   菩
      无        处   来   镜   提
      名        惹   无   亦   本
      老        尘   一   非   无
      僧        埃   物   台   树
      书

LONG
  );
  set("unit", "张");
  set("material", "paper");
}
