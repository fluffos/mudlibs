// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me) return notify_fail("你只能用「风卷残云功」来提升自己的战斗力！\n");

  if ((int)me->query("force") < 100) return notify_fail("你的内力不够！\n");
  if ((int)me->query_temp("powerup")) return notify_fail("你正在运功只中，不可以再次运功。\n");

  skill = me->query_skill("force");

  me->add("bellicosity", 100 + skill / 2);
  me->add("force", -100);
  me->receive_damage("kee", 0);

  message_vision(
    HIB
    "$N低吟一声，头上的白气越聚越多，双眼已经渐渐发出蓝光。\n" NOR, me);

  me->add_temp("apply/attack", skill / 2);
  me->add_temp("apply/dodge", skill / 3);
  me->set_temp("powerup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 3 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("powerup");
  tell_object(me, HIC "你头顶的白气慢慢散去，双眼中的蓝光也渐渐退去。 NOR\n");
}
