//黯然销魂掌法 by poor
inherit SKILL;
mapping *action = ({
  ([ "action":
    "$N胸前门户大开，使出一招「心惊肉跳」，胸口向内一吸，突然弹出。",
    "dodge": -80,
    "parry": 10,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N抬头向天，浑若不见，一招「杞人忧天」，掌力化成弧形拍向$n的$l",
    "dodge": -60,
    "parry": 10,
    "force": 140,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N呵道：“「无中生有」”，手足齐动，左掌右拳、双足头锤，一齐攻向$n的$l",
    "dodge": -50,
    "parry": 30,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N双掌一错，使出「穷头末路」，对准$n的$l连续拍出数掌。",
    "dodge": -40,
    "parry": 20,
    "force": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N突然头下脚上，倒过身子，使出「倒行逆施」，拍出一掌击向$n$l",
    "dodge": -20,
    "parry": 30,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N右手飘动，宛若流水，左掌却重滞之极，一招「拖泥带水」从左右同时功向$n！",
    "dodge": -120,
    "parry": -80,
    "force": 350,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练黯然销魂掌法必须空手。\n");
  return 1;
}

int valid_enable(string usage) { return usage == "unarmed"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  int sk = me->query_skill("xiaohun_strike", 1);

  if (sk == 60 || sk == 100 || sk == 180)
    return notify_fail("你练了一次掌法，发现自己已经不能再提高了。看来是得找人指点一下了。\n");

  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}
int effective_level() { return 15; }

string *parry_msg = ({
  "$n运气在指，使出一招「废寝忘食」，「啪」的一声用手指将$N的$w弹了开。\n",
  "$n向前跨出一步，一招「想入非非」迫得$N收回这招。\n",
  "$n使出「拖泥带水」的第六种变化，双掌忽左忽右，使得$N不知所措。\n",
  "$n施展出「倒行逆施」的最终变化，用嘴咬向$N手张的$w，吓的$N退后三尺。\n",
});

string *unarmed_parry_msg = ({
  "$n步走五行，一招「饮恨吞声」拍出五掌，逼得$N撤招自保。\n",
  "$n后撤几步，施展出「力不从心」，化解了$N的攻势。\n",
  "$n脚步加快，身形不定，一招「行尸走肉」，迫使$N退后三尺。\n",
  "$n使出「呆若木鸡」，双掌拍向$N，掌风震得$N胸中血气翻滚。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 5;
}
int black_white_ness() {
  return 10;
}

string perform_action_file(string action) {
  return CLASS_D("gaibang") + "/xiaohun_strike/" + action;
}
