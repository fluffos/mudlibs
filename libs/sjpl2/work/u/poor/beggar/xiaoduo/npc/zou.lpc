// wang.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("邹处灵", ({ "zou chuling", "master", "chuling" }));
  set("nickname", HIC "青天孤鹤" NOR);
  set("title", "丐帮大孝分舵舵主");
  set("gender", "女性");
  set("age", 16);
  set("long",
    "她就是丐帮大孝分舵的舵主。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "小木屋": "那是刘长老住的地方。",
    "衣服": "我想要一件紫花上衣。",
    "喜好": "我十分喜欢好看的衣服。",
    "钥匙": "你问那么多干吗？",
  ]));
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("combat_exp", 200000);

  set_skill("unarmed", 80);
  set_skill("force", 110);
  set_skill("parry", 110);
  set_skill("dodge", 110);
  set_skill("blade", 110);
  set_skill("begging", 110);

  set_skill("golden_blade", 110);
  set_skill("iron_strike", 80);
  set_skill("hidden_dodge", 110);
  set_skill("canyun_force", 110);
  set_skill("literate", 100);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "golden_blade");
  map_skill("blade", "golden_blade");

  create_family("丐帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
  carry_object("/u/poor/obj/weapon/blade")->wield();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 60) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮孝舵副舵主");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找王其然修习武功吧。\n");
  }
}
int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "purple-cloth") {
    command("say 这不是我要的紫花上衣。\n");
    return 0;
  } else {
    command("say 多谢帮我找到紫花上衣。");
    command("say 这把钥匙你就拿走吧。");
    ob = new(__DIR__ "obj/red-key");
    ob->move(me);
  }
  return 1;
}
