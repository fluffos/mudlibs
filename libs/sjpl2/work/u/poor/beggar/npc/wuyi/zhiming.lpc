// fourth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("智明", ({ "zhi ming", "master", "zhiming" }));
  set("title", "甘露寺");
  set("gender", "男性");
  set("age", 45);
  set("long",
    "他是一个甘露寺的和尚，已经修行了很长时间。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("chat_chance_combat", 1);
  set("chat_chance", 1);
  set("chat_msg", ({
    "智明说道：阿弥陀佛。\n"
  }));
  set("str", 36);
  set("max_kee", 1300);
  set("kee", 1300);
  set("force", 700);
  set("max_force", 700);
  set("force_factor", 50);
  set("combat_exp", 100000);

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("begging", 100);
  set_skill("stick", 100);
  set_skill("zui_stick", 100);
  set_skill("begging", 100);
  set_skill("fanwen", 80);

  set_skill("hidden_dodge", 100);
  set_skill("canyun_force", 100);
  set_skill("literate", 90);
  set_skill("sanhua-strike", 100);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "sanhua-strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "zui_stick");
  map_skill("parry", "zui_stick");

  create_family("丐帮污衣帮", 7, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi3")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮孝舵弟子");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi3")) {
    if ((string)ob->query("id") != "literate-book") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "智明接过《诗词详解》，仔细的读了两遍。\n\n"
        "智明说道：阿弥陀佛！你去找丐帮大智分舵的章大凯，告诉他暗号，他就会收你为徒弟的。\n\n");
      tell_object(me, HIM "你增加了200点经验。\n" NOR);
      tell_object(me, HIM "你增加了150点潜能。\n\n" NOR);
      me->set("marks/wuyi4", 1);
      me->delete("marks/wuyi3", 1);
      me->set("combat_exp", (int)exp + 200);
      me->set("potential", (int)pot + 150);
      return 1;
    }
  } else
    say("智明接过《诗词详解》，仔细的读了两遍。\n\n");
  return 1;
}
int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi3")) {
    tell_object(me, "智明说道：阿弥陀佛！我不知道施主在说什么。\n");
    return 1;
  } else {
    tell_object(me, "智明说道：阿弥陀佛，既然这样我就收你这个徒弟吧。\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 40) {
    tell_object(me, "智明说道：阿弥陀佛，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "智明说道：阿弥陀佛，请施主帮我把《诗词详解》找来。\n\n");
    return 1;
  }
}
