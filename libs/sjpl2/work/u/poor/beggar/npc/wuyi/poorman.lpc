// seventh npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("穷老头", ({ "qiong laotou", "master", "qiong" }));
  set("gender", "男性");
  set("title", "");
  set("age", 76);
  set("long",
    "他是一个无依无靠的穷苦老头。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("str", 26);
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 50);
  set("combat_exp", 200000);

  set_skill("unarmed", 130);
  set_skill("force", 130);
  set_skill("parry", 130);
  set_skill("dodge", 130);
  set_skill("blade", 130);
  set_skill("begging", 130);

  set_skill("hidden_dodge", 130);
  set_skill("canyun_force", 130);
  set_skill("literate", 120);
  set_skill("iron_strike", 130);
  set_skill("xianglong_strike", 100);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮污衣帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi6")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮智舵弟子");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi6")) {
    if ((string)ob->query("id") != "shanbeirou") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "穷老头接过扇贝肉，用舌头慢慢的舔了几下。\n\n"
        "穷老头说道：你去找那个什么智舵的鲁智，告诉他暗号，他就会收下你的。\n\n");
      tell_object(me, HIM "你增加了350点经验。\n" NOR);
      tell_object(me, HIM "你增加了300点潜能。\n\n" NOR);
      me->set("marks/wuyi7", 1);
      me->delete("marks/wuyi6", 1);
      me->set("combat_exp", (int)exp + 350);
      me->set("potential", (int)pot + 300);
      return 1;
    }
  } else
    say("穷老头接过扇贝肉，用舌头慢慢的舔了几下。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi6")) {
    tell_object(me, "穷老头抬头看了你一眼，又低下了头！\n");
    return 1;
  } else {
    tell_object(me, "穷老头说道：是柳无言那个小姑娘让你来的？那我就收下你吧。\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 70) {
    tell_object(me, "穷老头说道：你再去多学学乞讨的功夫。\n");
    return 1;
  } else {
    tell_object(me, "穷老头说道：我很想吃扇贝肉呀。\n\n");
    return 1;
  }
}
