// wu
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create() {
  set_name("寒鹏飞", ({ "han pengfei", "master" }));
  set("gender", "男性");
  set("title", "寒灵山庄管家");
  set("age", 61);
  set("str", 40);
  set("per", 20);
  set("long", @LONG
他是寒灵山庄的管家，早年曾经辅助过天帝。
LONG
  );
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 1000 + random(2500));
  set("max_force", 2000);
  set("force_factor", 10 + random(20));
  set("combat_exp", 100000 + random(500000));

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.guixi" :),
    (: perform_action, "dodge.baoxing" :),
  }));

  set_skill("unarmed", 60 + random(100));
  set_skill("blade", 60 + random(100));
  set_skill("parry", 60 + random(100));
  set_skill("dodge", 60 + random(100));
  set_skill("xianyin_blade", 60);
  set_skill("hidden_dodge", 60 + random(100));
  set_skill("canyun_force", 60 + random(100));

  map_skill("dodge", "hidden_dodge");
  map_skill("blade", "xianyin_blade");
  map_skill("parry", "xianyin_blade");
  map_skill("force", "canyun_force");


  create_family("寒灵山庄", 3, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/blade")->wield();
  carry_object("/u/poor/obj/cloth/heiyi")->wear();
  carry_object(__DIR__ "obj/lingpai");
}

void attempt_apprentice(object ob) {
  int exp = (int)ob->query("combat_exp");
  if (exp > 5000000) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) +
      "跟随我修炼，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "hanling");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "不要异想天开了，我怎么能收你为徒。\n");
  }
}
