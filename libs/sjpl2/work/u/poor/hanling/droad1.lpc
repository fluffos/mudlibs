// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", "地道");
  set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在左
边的墙上镶嵌着块石头。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "northeast": __DIR__ "droad2",
  ]));

  setup();
}

void init() {
  add_action("do_zhuan", "zhuan");
}

int do_zhuan(string arg) {
  if (arg == "石头" || arg == "stone") {
    message_vision("$N用手转了一下石头，结果左边出现了个暗门。\n", this_player());
    message_vision("$N走了进去。\n\n", this_player());
    this_player()->move(__DIR__ "dhole");
    message("vision", this_player()->name() + "走进了暗门。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
