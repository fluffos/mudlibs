// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", "地道");
  set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在西
边是一扇巨大的石门。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "石门": "这是一扇十分巨大的石门，在门上有一个蓝色的钥匙孔。
",
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "droad5",
    "south": __DIR__ "droad3",
  ]));
  set("objects", ([
    __DIR__ "npc/han1": 1,
  ]));
  setup();
}
void init() {
  add_action("do_use", "use");
}
int do_use(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "钥匙" || arg == "key" || arg == "blue-key") {
    if (!objectp(ob = present("blue-key", me))) {
      write("钥匙怎么也插不进去。\n");
      return 1;
    }
    message_vision("$N把蓝色的钥匙插了进去，“咚”的一声，石门开了，你走了进去。\n", me);
    me->move(__DIR__ "dshinan1");
    return 1;
  } else return 0;
}
