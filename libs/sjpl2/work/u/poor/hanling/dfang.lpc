// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", "地道");
  set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。有块
巨石堵住了路。
       这里没有明显的出口。
LONG
  );
  set("objects", ([
    __DIR__ "obj/rock": 1,
  ]));
  setup();
}
void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  object me, ob;
  me = this_player();

  if (!(arg == "rock" || arg == "巨石" || arg == "大岩石"))
    return 0;
  if (me->query("marks/killfang")) {
    message_vision("$N用力挪开巨石，向巨石后的路走去。\n", me);
    me->move(__DIR__ "droad3");
    return 1;
  } else {
    message_vision("$N用力挪开巨石，向巨石后的路走去。\n", me);
    me->move(__DIR__ "dfang1");
    return 1;
  }
}
