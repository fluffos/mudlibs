// Room: /beggar/door.c
#include <ansi.h>;
int do_wield1(object me, object ob);

inherit ROOM;

void create() {
  set("short", "上山石阶");
  set("long", @LONG
你正走在一道长长的石阶上, 阶梯的两侧种植著一排高耸
的松树。抬头能望见北边那令江湖人恐惧的寒灵山庄。一股股
白色的烟雾从山庄中升起。
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "hlroad3",
    "northup": __DIR__ "hlroad5",
  ]));
  set("objects", ([
    __DIR__ "npc/han1": 2,
  ]));
  set("outdoors", "hanling");
  setup();
}
int valid_leave(object me, string dir) {
  object *inv, ob = this_player(), ob1;
  int i, count, ii;
  string ss, class_name;
  object seng, seng1;

  seng = present("zhuangke", environment(me));
  class_name = me->query("class");
  if (!objectp(seng)) return 1;

  if ((dir == "northup")) {
    if ((ob1 = this_player()->query_temp("weapon"))) {
      if (objectp(ob1)) {
        ss = (string)ob1->name();
        message_vision("庄客没收了$N手上的" + ss + "。\n", ob);
        destruct(ob1);
      }
    }
    ob = this_player();
    inv = all_inventory(ob);
    for (count = 0, i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped")) continue;
      //          printf("%s\n",inv[i]->name());
      if (do_wield1(ob, inv[i])) count++;
    }
    //      printf("%d %d ",count,i);
    if (count > 0) {
      message_vision("庄客伸手拦住$N，说道：“想上寒灵山，就得放下兵器！”\n", ob);
      return notify_fail("");
    }
  }
  return 1;
}

int do_wield1(object me, object ob) {
  string str;

  if (ob->wield()) {
    ob->unequip();
    destruct(ob);
    return 1;
  } else return 0;
}
