// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", "地道");
  set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "northeast": __DIR__ "droad3",
    "southwest": __DIR__ "droad1",
  ]));
  set("objects", ([
    __DIR__ "npc/han1": 3,
  ]));
  setup();
}

int valid_leave(object who, string exit) {
  object ob;
  ob = present("zhuangke", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "northeast") && (present("zhuangke", environment(who))))
    return notify_fail("庄客说道：“不许向前走了！”\n");
  return ::valid_leave(who, exit);
}
