// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;
int rou_num = 1;

void create() {
  set("short", "山洞");
  set("long", @LONG
这里一片漆黑，只能借助洞口的点点光亮来分辨四周
围的事物。不时能听到石钟乳流下的水声。在右侧有一株
小草隐隐发光。
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    "southeast": __DIR__ "hlroad6",
  ]));
  set("objects", ([
    __DIR__ "npc/bear": 1,
  ]));
  set("outdoors", "hanling");
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object obj;
  if (arg == "xiaocao" || arg == "小草") {
    if (rou_num != 0) {
      obj = new(__DIR__ "obj/lingzhi-cao");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N摘下一株小草。\n", this_player());
      rou_num--;
    } else write("你的手够不到小草。\n");
    return 1;
  } else return 0;
}
