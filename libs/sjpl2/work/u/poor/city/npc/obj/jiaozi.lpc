// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("饺子", ({ "dumpling" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗茴香馅的饺子。\n");
    set("unit", "碗");
    set("value", 20);
    set("food_remaining", 1);
    set("food_supply", 20);
  }
}
