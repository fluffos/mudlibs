// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("豆腐", ({ "doufu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块豆腐。\n");
    set("unit", "块");
    set("value", 20);
    set("food_remaining", 1);
    set("food_supply", 20);
  }
}
