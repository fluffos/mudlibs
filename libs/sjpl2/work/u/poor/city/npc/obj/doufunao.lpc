// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("豆腐脑", ({ "doufunao" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗可口的豆腐脑。\n");
    set("unit", "碗");
    set("value", 80);
    set("food_remaining", 3);
    set("food_supply", 30);
  }
}
