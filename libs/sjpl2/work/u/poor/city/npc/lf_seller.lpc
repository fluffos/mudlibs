// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("徐朴", ({ "xu pu", "xu" }));
  set("title", "凉粉店掌柜");
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set("gender", "男性");

  set("force", 700);
  set("max_force", 700);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 60000);

  set("age", 36);
  set("long", @LONG
他是这家凉粉店的掌柜。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/liangfen": 15,
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
