// golder.c

inherit NPC;

void create() {
  set_name("老道", ({ "laodao" }));
  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  set_skill("shaolin-dodge", 80);
  set_skill("canyun_force", 60);
  set_skill("literate", 100);
  set_skill("iron_strike", 60);

  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  set("gender", "男性");

  set("force", 800);
  set("max_kee", 800);
  set("max_force", 20);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100000);

  set("age", 48);
  set("long", @LONG
他是茅山派弟子。
LONG
  );
  set("inquiry", ([
    "七星道袍": "此乃先师遗物，不可送人。",
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/star-cloth")->wear();
}
