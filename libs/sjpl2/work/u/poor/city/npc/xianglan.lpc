// golder.c

inherit NPC;
int ask_me();
#include <ansi.h>

void create() {
  set_name("香兰", ({ "xianglan" }));
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set("gender", "女性");

  set("per", 20);
  set("force", 100);
  set("max_kee", 100);
  set("max_force", 10);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 1000);

  set("age", 19);
  set("long", @LONG
她正在冲着你笑呢。
LONG
  );
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "香兰冲你甩了个眉眼，说道：大爷来吗？\n",
  }));
  set("inquiry", ([
    "过夜": (: ask_me :),
    "sex": (: ask_me :),
    "上床": (: ask_me :),
    "name": "大家都管我叫小淫妇。",
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}
int ask_me() {
  object me, ob;
  me = this_player();

  tell_object(me, "香兰把你推到床上，给你宽衣解带。\n");
  tell_object(me, "你躺在了床上，看着香兰脱掉了一件件衣服，露出了洁白的身躯。\n");
  tell_object(me, "香兰依偎在你的怀里。\n\n");
  tell_object(me, HIW "半个时辰过后。\n\n" NOR);
  tell_object(me, "你感到有些累了。\n");
  this_player()->unconcious();
  return 1;
}
