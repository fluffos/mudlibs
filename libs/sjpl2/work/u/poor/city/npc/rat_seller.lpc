// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("老田", ({ "lao tian", "tian" }));
  set("title", "卖药的");
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set("gender", "男性");

  set("force", 700);
  set("max_force", 700);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 60000);

  set("age", 46);
  set("long", @LONG
他是个卖药的。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/rat-medicine": 10,
    __DIR__ "obj/jinchuang": 15,
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
