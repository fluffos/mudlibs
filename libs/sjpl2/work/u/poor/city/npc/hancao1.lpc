// golder.c

inherit NPC;
int ask_me();
#include <ansi.h>

void create() {
  set_name("少妇", ({ "woman" }));
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set("gender", "女性");

  set("per", 40);
  set("force", 1000);
  set("max_kee", 1000);
  set("max_force", 40);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100000);

  set("age", 20);
  set("long", @LONG
她是个美貌的少妇。正在冲着你笑呢。
LONG
  );
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "少妇说道：唉。。。。。\n",
    "少妇仔细的打量了一下你。\n",
    "少妇自言自语：今朝有酒今朝醉。\n",
    "少妇对你说道：不请我喝杯酒吗？？\n",
    "少妇冲你甩了个眉眼，说道：不请我喝杯酒吗？\n",
  }));
  set("inquiry", ([
    "请喝酒": (: ask_me :),
    "name": "大家都管我叫[草]。",
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}
int ask_me() {
  object me, ob;
  me = this_player();

  if (!objectp(ob = present("white-blade", me))) {
    tell_object(me, "少妇说道：请我喝酒？你还不够资格。\n\n");
    return 1;
  } else {
    tell_object(me, "少妇用纤纤玉手端起了酒杯，冲你微微一笑，把酒送到你的口中。\n\n");
    tell_object(me, HIW "半个时辰过后。\n\n" NOR);
    tell_object(me, "你用右手搂着少妇的蜂腰，进入了房间。\n");
    me->move("/u/poor/city/jiulou4");
    tell_object(me, "少妇脱去了自己的衣服，露出了雪白的身躯。。。。。\n");
    tell_object(me, "你只觉得天旋地转。\n\n");
    this_player()->unconcious();
    return 1;
  }
}
