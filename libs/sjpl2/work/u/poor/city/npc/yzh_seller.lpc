// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("张嫣", ({ "zhang yan", "seller" }));
  set("title", "胭脂店掌柜");
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set("gender", "女性");

  set("force", 1000);
  set("max_force", 800);
  set("per", 30);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100000);

  set("age", 26);
  set("long", @LONG
她是这家胭脂店的掌柜的。
LONG
  );
  set("inquiry", ([
    "无色胭脂": "这个。。。。。我也不知道。除非。。。。。",
    "除非": "你给我找黑珍珠来，我把胭脂给你。",
  ]));

  set("vendor_goods", ([
    __DIR__ "obj/yanzhi": 20,
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/purple-cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "hei-zhenzhu") {
    command("say 这不是黑珍珠。\n");
    return 0;
  } else {
    command("say 这珍珠我可得到了！");
    command("say 给你这盒胭脂。");
    ob = new(__DIR__ "obj/wuse-yanzhi");
    ob->move(me);
  }
  return 1;
}
