// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("凌恐晗", ({ "ling konghan", "ling" }));
  set("title", "古玩店掌柜");
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("shaolin-dodge", 100);
  set_skill("canyun_force", 100);
  set_skill("literate", 100);
  set_skill("iron_strike", 100);
  set_skill("crazy_sword", 100);
  set_skill("sword", 100);

  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  set("gender", "男性");

  set("force", 2400);
  set("max_force", 2400);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 600000);

  set("age", 36);
  set("long", @LONG
他是这家古玩店的老板，收藏了许多奇珍异宝。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/guwan1": 5,
    __DIR__ "obj/guwan2": 5,
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
  carry_object("/u/poor/obj/weapon/poor-sword")->wield();
  carry_object(__DIR__ "obj/hei-zhenzhu")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
