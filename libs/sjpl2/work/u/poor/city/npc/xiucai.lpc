// golder.c

inherit NPC;

void create() {
  set_name("秀才", ({ "xiucai" }));
  set("title", "生病的");
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set("gender", "男性");

  set("force", 100);
  set("eff_kee", 200);
  set("max_kee", 400);
  set("max_force", 80);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 10000);

  set("age", 28);
  set("long", @LONG
他是一个生病的秀才。
LONG
  );
  set("inquiry", ([
    "灵芝草": "我也不知道哪有。",
    "name": "我叫罗光祖。",
    "治病": "医生说只有用灵芝草才能治好我的病。",
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}


int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "lingzhi-cao") {
    command("say 这不是灵芝草。\n");
    return 0;
  } else {
    command("say 多谢你帮我找到灵芝草，总算能治好我的病了。");
    command("say 给你这本诗集做为感谢吧。");
    ob = new("/u/poor/obj/book/literate-book2");
    ob->move(me);
  }
  return 1;
}
