// golder.c

inherit NPC;

void create() {
  set_name("容进材", ({ "rong jincai" }));
  set("title", "钱庄掌柜");
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set("gender", "男性");

  set("force", 1000);
  set("max_kee", 1000);
  set("max_force", 30);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100000);

  set("age", 58);
  set("long", @LONG
他是钱庄的掌柜。
LONG
  );
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "容进财说道：最近生意不好做呀。\n",
  }));

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}
