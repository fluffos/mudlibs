// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("薛铁匠", ({ "xue tiejiang", "xue" }));
  set("title", "铁匠铺老板");
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set("gender", "男性");

  set("force", 900);
  set("max_force", 900);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 60000);

  set("age", 36);
  set("long", @LONG
他是这家铁匠铺的老板，有着一身的力气。
LONG
  );

  set("vendor_goods", ([
    "/u/poor/obj/weapon/sword": 15,
    "/u/poor/obj/weapon/blade": 15,
    "/u/poor/obj/weapon/whip": 15,
    "/u/poor/obj/cloth/tiejia": 15,
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
