// golder.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("何寡妇", ({ "he guafu", "he" }));
  set("long", @LONG
她是豆腐店的女老板，早年丧夫。
LONG
  );
  set("title", "豆腐店老板娘");
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set("gender", "女性");
  set("per", 30);
  set("age", 46);

  set("force", 700);
  set("max_force", 700);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 60000);

  set("vendor_goods", ([
    __DIR__ "obj/doufu": 15,
    __DIR__ "obj/doufunao": 15,
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}

int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if ((string)ob->query("id") != "jiashu") {
    command("say 这是什么？\n");
  } else {
    command("say 谢谢你带来我儿子的信！！\n");
    tell_object(me, HIM "你增加了50点经验。\n" NOR);
    tell_object(me, HIM "你增加了50点潜能。\n\n" NOR);
    me->set("combat_exp", exp + 50);
    me->set("potential", pot + 50);
    return 1;
  }
  return 0;
}
