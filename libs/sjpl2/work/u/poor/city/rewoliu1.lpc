// Room: /city/nandajie2.c

inherit ROOM;

void create() {
  set("short", "密室");
  set("long", @LONG
你来到一间密室之中，这里摆放了许多刑具，好象是折磨人
用的。在地上还有几句尸体。在右边的墙上有个拉杆。
    这里没有明显的出口。
LONG
  );
  set("objects", ([
    __DIR__ "npc/hancao2": 1,
    __DIR__ "npc/corpse": 3,
  ]));

  setup();
}
void init() {
  add_action("do_pull", "pull");
}

int do_pull(string arg) {
  if (arg == "拉杆" || arg == "杆") {
    if (this_player()->query_skill("unarmed", 1) <= 20) {
      write("你没有那么大力气，拉不动。\n");
      return 1;
    }
    message_vision("$N拉下拉杆，在墙上出现一道石门，走了进去。\n", this_player());
    this_player()->move(__DIR__ "rewo2");
    message("vision", this_player()->name() + "拉下拉杆，走进了墙上出现的石门。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
