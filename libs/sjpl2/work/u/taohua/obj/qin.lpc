#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create() {
  set_name("桃花伴月琴", ({ "qin" }));
  set_weight(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 500);
    set("objattrib", 1);
    set("material", "wood");
    set("long", "一个古色古香的桃花伴月琴,琴上刻有月光照映的桃树。\n");
    set("weapon_prop/karma", 3);
  }
  init_staff(25);
  setup();
}
void init() {
  add_action("do_play", "play");
}

int do_play(string arg) {
  object *ob, me, target, weapon;
  int i, skill, heal;
  me = this_player();
  skill = me->query_skill("watersong", 1);
  weapon = me->query_temp("weapon");
  me->set_temp("played_qin", 1);
  if (!arg) return notify_fail("你要弹什么？\n");
  if (me->query("class") != "taohua")
    return notify_fail("你抚琴弹了一会，但没有奏出什么象样的曲子。\n");
  if (me->query_delay())
    return notify_fail("你现在心绪紊乱，不能弹奏。\n");
  if (me->query("force") < 70)
    return notify_fail("你现在内力不足。\n");
  if (weapon && weapon->query("name") != "桃花伴月琴")
    return notify_fail("你必须先装备桃花伴月琴。\n");
  else if (!weapon)
    return notify_fail("你必须先装备桃花伴月琴。\n");

  switch (arg) {
    case "暮霭苍茫曲":
    case "muaicangmang":
      if (skill < 100)
        return notify_fail("你的“似水流音”所学不足！\n");
      if (((int)me->query("force") - (int)me->query("max_force")) <= 0)
        return notify_fail("你的真气不够。\n");
      //                                if(!present("jh book", me) )
      //                        return notify_fail("你身上没有曲谱，如何演奏？\n");
      message_vision(HIC "$N手弹桃花伴月琴，奏出一首婉转如流水般的《暮霭苍茫曲》！\n" NOR, me);
      me->add("force", -20);
      if (me->query("bellicosity") > 0)
        me->add("bellicosity", -random(10));
      ob = all_inventory(environment(me));
      for (i = 0; i < sizeof(ob); i++) {
        if (!living(ob[i]) || ob[i] == me || !ob[i]->is_character()) continue;
        if (skill > 0) {
          if (ob[i]->query("bellicosity") > 0)
            ob[i]->add("bellicosity", -random(10));
          if (ob[i]->is_fighting())
            ob[i]->remove_all_killer();
          if (!ob[i]->query_delay())
            ob[i]->set_delay(10);
          tell_object(ob[i], "你只觉得曲声苍凉萧杀，回旋婉转，不觉整个人都悲从中来。\n");
        }
      }
      break;
    default:
      return notify_fail("你要弹什么？\n");
  }
  if (!me->query_delay())
    me->set_delay(3);
  return 1;
}
