#include <ansi.h>

inherit NPC;

void create() {
  set_name("吕雪君", ({ "lv xuejun", "lv", "xuejun" }));
  set("long", "这是一个妙龄少女，是“晶莹如雪”四大弟子之一。\n");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("str", 30);
  set("per", 32);
  set("con", 17);
  set("int", 25);
  set("class", "taohua");
  create_family("桃花岛", 3, "弟子");
  set("combat_exp", 380000);
  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 10);
  set_skill("unarmed", 80);
  set_skill("parry", 60);
  set_skill("dodge", 80);
  set_skill("sword", 80);
  set_skill("force", 80);
  set_skill("literate", 100);
  set_skill("liheforce", 80);
  set_skill("zhengqijue", 90);
  set_skill("beauty-force", 80);
  set_skill("luoying_sword", 80);
  set_skill("luohua_steps", 80);
  set_skill("tenderzhi", 80);

  map_skill("unarmed", "tenderzhi");
  map_skill("force", "beauty-force");
  map_skill("sword", "luoying_sword");
  map_skill("parry", "luoying_sword");
  map_skill("dodge", "luohua_steps");

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}

int accept_object(object who, object ob) {
  object me;
  string mat, typ, newobj;
  int newrank;
  me = this_player();
  if (me->query_temp("use_jiguan_ren") != "taohua") {
    say(CYN "吕雪君摇了摇头，说道：你没有掌握本派机关制造术，我帮不了你。\n" NOR);
    return 0;
  }
  if (ob->query("mat_type")) {
    mat = ob->query("material");
    typ = ob->query("mat_type");
    newobj = typ + "-" + mat;
    newrank = TROOP_D(newobj)->effective_level();
    me->set_troop(newobj, newrank);
    say(CYN "吕雪君把" + ob->name() + "放入火炉中，不久炼成了" + to_chinese(newobj) + "。\n" NOR);
    message_vision(CYN "吕雪君将" + to_chinese(newobj) + "交给$N，说道：请善加利用这些机关元件。\n" NOR, me);
    return 1;
  } else {
    say(CYN "吕雪君摇了摇头，说道：这东西无法作为机关原料。\n" NOR);
    return 0;
  }
  return 1;
}

int accept_fight(object me) {
  command("say 不准在桃花岛动武。");
  return 0;
}
void die() {
  int i;
  object killer, who;
  seteuid(getuid());
  who = this_object();
  if (objectp(killer = query_temp("last_damage_from"))) {
    message_vision(HIW "\n$N伸指一弹，指间突然射出一团白茫茫的奇寒之气！" NOR, who, killer);
    message_vision(HIW "\n琼宫不传之秘“玄冰真气”透过$n的护体神功，直摧丹田！\n" NOR, who, killer);
    killer->receive_wound("kee", killer->query("max_kee"), who);
    COMBAT_D->report_status(killer, 1);
  }
  ::die();
}
