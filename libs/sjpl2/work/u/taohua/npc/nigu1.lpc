inherit NPC;
void create() {
  set_name("小尼姑", ({ "nigu" }));
  set("gender", "女性");
  set("class", "taohua");
  set("age", 19);
  set("cor", 24);
  set("cps", 29);
  set("int", 25);
  set("long", "她是一个表情严肃的尼姑，看上去不沾半点人间烟火。\n");
  set("combat_exp", random(5000));
  set("attitude", "friendly");
  set("max_force", 100);
  set("force", 100);
  set("force_factor", 5);
  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  setup();
  carry_object(__DIR__ "obj/monk_cloth")->wear();
  carry_object(__DIR__ "obj/shoe2")->wear();
}
int accept_fight(object me) {
  command("say 阿弥陀佛！贫身武功低微，施主不要开这种玩笑。\n");
  return 0;
}
