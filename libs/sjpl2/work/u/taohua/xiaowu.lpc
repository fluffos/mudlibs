inherit ROOM;

void create() {
  set("short", "小屋");
  set("long", @LONG
这是专供尼姑休息的小屋。屋里放着五六张床，挤挤地占掉了屋子的一大半
地方。屋角很散乱地放了一些日常生活用具。中央放着一张桌子，上面摆一
茶壶和几个杯子。
LONG);
  set("exits", ([
    "east": __DIR__ "houyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/nigu1": 1,
    __DIR__ "npc/nigu2": 1,
    __DIR__ "npc/nigu3": 1,
  ]));
  setup();
  replace_program(ROOM);
}
