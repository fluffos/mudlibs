#include <room.h>
inherit ROOM;

void create() {
  set("short", "伽蓝殿");
  set("long", @LONG
伽蓝殿内供奉的是守护伽蓝土地的神像，最左为施造祗园精舍的
孤独长者，居中为祗陀太子，其父波斯匿王在右。殿中央放置着一只
烧得通红的炼器炉，平常都是清尘庵主的关门弟子在此照看火炉。
LONG
  );
  set("exits", ([
    "east": __DIR__ "dating",

  ]));

  set("objects", ([
    __DIR__ "obj/yuxiao": 1,
    __DIR__ "npc/lv": 1,
  ]));
  setup();
}
