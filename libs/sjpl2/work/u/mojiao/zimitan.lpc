#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "紫迷坛");
  set("long", @LONG
在这紫竹林深处，就是四大神坛的紫迷坛。紫色的石块儿堆积成的一
个六角祭坛。在这坛的四周摆着三个大鼎，里面焚的有香。那香的味道独
特，气味在空气中缥缈着。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northwest": __DIR__ "zhulin2",
    "southeast": __DIR__ "zhulin1",
  ]));
  set("objects", ([
    __DIR__ "npc/jiruyu": 1,
  ]));
  setup();
}
