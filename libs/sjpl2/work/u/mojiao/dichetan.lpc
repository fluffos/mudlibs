#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "地徹坛");
  set("long", @LONG
此处乃是地徹坛主发布号令的冲天塔。塔不高，也就是两丈左右。木
头柱子均被漆成了红色。在塔顶上插着一面旗。上面的那个图案就是刻在
石柱上的图案，被风一吹，随风摆动，倒像一只鸟在飞一般。此塔也奇怪
的很，从下到上也没有梯子，整个塔就悬在崖边。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "eastup": __DIR__ "didong3",
    "west": __DIR__ "didong1",
  ]));
  set("objects", ([
    __DIR__ "npc/jiuchenyang": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "eastup") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
