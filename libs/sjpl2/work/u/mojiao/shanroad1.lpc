//shanroad1.c written by john darks
inherit ROOM;
void create() {
  set("short", "山路");
  set("long", @LONG
小路逐渐延伸，路渐渐的变得较为平坦起来。山峰中的那些黄白小点
也变得真切起来。原来，那些乃是一些旗帜。在山风的劲吹下，迎风舞动。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northup": __DIR__ "shanroad2",
    "southwest": __DIR__ "shanjiao1",
    "southeast": __DIR__ "shanjiao2",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob, room;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
小路逐渐延伸，路渐渐的变得较为平坦起来。山峰中的那些黄白小点
也变得真切起来。原来，那些乃是一些旗帜。在山风的劲吹下，迎风舞动。
LONG);
  } else {
    set("long", @LONG
从天柱峰下来，渐渐接近山脚，道路也变得崎岖起来，不过可以看见远处
的平原了。身后还似乎响动着旗帜飘动的声音。
LONG);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northup") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
