#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int performdodge();
void create() {
  set_name("九阴夫人", ({ "master jiuyin", "jiuyin", "master" }));
  set("title", "魔教教主");
  set("gender", "女性");
  set("age", 16);
  set("attitude", "peaceful");
  set("start_vote", 0);
  set("shaolin", ({}));
  set("wudang", ({}));
  set("xiaoyao", ({}));
  set("huashan", ({}));
  set("str", 230);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);
  set("force", 20000);
  set("max_force", 20000);
  set("force_factor", 20);
  set("combat_exp", 50000000);
  set("score", 20000);
  set_skill("literate", 250);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("whip", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("huangsha-whip", 250);
  set_skill("huashu-steps", 300);
  set_skill("hansha-force", 150);
  set_skill("senluo-force", 200);
  set_skill("leaf-strike", 200);
  map_skill("whip", "huangsha-whip");
  map_skill("force", "senluo-force");
  map_skill("parry", "huangsha-whip");
  map_skill("dodge", "huashu-steps");
  create_family("魔教", 2, "教主");
  set("class", "mojiao");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: performdodge :),
    (: perform_action, "whip.fengshamangmang" :),
    (: perform_action, "whip.fengshamangmang" :),
  }));
  setup();
  carry_object("/obj/cloth/clothw")->wear();
  carry_object("/obj/weapon/rainbowbelt")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 1) {
    command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
    return;
  }
  if ((int)ob->query_skill("senluo-force", 1) < 150) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练森罗万象变？");
    return;
  }
  if (ob->query("class") == "mojiao") {
    message_vision("九阴夫人说道：“好吧, 我就收下你了。”\n", ob);
    command("recruit " + ob->query("id"));
    ob->set("class", "mojiao");
    ob->set("id_type", 2);
    return;
  }
  return;
}

void killed_enemy(object victim) {
  object realkiller;
  mapping quest;
  int i, teamsize, exp, pot;
  object *mem;
  if (victim->query_temp("my_skiller") != this_object()->query("id")) {
    realkiller = find_player(victim->query_temp("my_killer"));
    if (realkiller) {
      if (interactive(realkiller)
        && (!userp(victim) || victim->query("combat_exp") * 2 > realkiller->query("combat_exp"))
        && victim->query("family/family_name") == realkiller->query("mojiao/menpai")) {
        exp = (int)to_int(pow(victim->query("combat_exp") * 10.0, 0.333333));
        exp = exp * random(4) + random(50) + 50;
        exp = (int)(exp / 2 + random((int)exp / 2));
        pot = (int)(exp / 5 + random((int)exp / 5));
        mem = realkiller->query_team();
        teamsize = sizeof(mem);
        if (teamsize < 1) teamsize = 1;
        if (teamsize <= 1) {
          realkiller->add("combat_exp", exp);
          realkiller->add("potential", pot);
          tell_object(realkiller, HIY "你被奖励了：\n" +
            chinese_number(exp) + "点实战经验\n" +
            chinese_number(pot) + "点潜能\n" + NOR);
        } else {
          exp = exp / teamsize;
          pot = pot / teamsize;
          for (i = 0; i < sizeof(mem); i++) {
            if (mem[i])
              if ((mem[i]->query_temp("ttarget") == victim->query("id")) || mem[i] == realkiller)
                if (environment(realkiller) == environment(mem[i])) {
                  mem[i]->add("combat_exp", exp);
                  mem[i]->add("potential", pot);
                  tell_object(mem[i], HIY "你被奖励了：\n" +
                    chinese_number(exp) + "点实战经验\n" +
                    chinese_number(pot) + "点潜能\n" NOR);
                }
          }
        }
      }
    }
  }
}

int performdodge() {
  exert_function("yihuajiemu");
  perform_action("dodge.huashudieying");
  return 1;
}
