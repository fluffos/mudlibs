//guard.c for quest written by john darks
#include <ansi.h>
inherit NPC;
void backattack();
void create() {
  set_name("侍卫", ({ "guard" }));
  set("long", "这是一位大内高手，专门担任朝廷命官的保护之责。\n");
  set("title", "御前带刀");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);
  set("max_kee", 2000);
  set("str", 50);
  set("cor", 30);
  set("cps", 25);
  set("combat_exp", 3000000);
  set_skill("sword", 170);
  set_skill("parry", 170);
  set_skill("dodge", 270);
  set_skill("move", 170);
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object owner;
  object me = this_object();
  if (objectp(owner = me->query("possessed")))
    message_vision(CYN "$N拱手对$n说道：属下暂且告退！\n\n$N说完，就隐入黑暗中消失不见了。\n" NOR, me, owner);
  else
    message_vision("$N闪了闪，就隐入黑暗中消失不见了。\n", me);
  destruct(me);
}

void again() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }
  }
}

void die() {
  again();
  ::die();
}
