void create() {
  set_name("王乞儿", ({ "wang qier", "wang", "qier", "王乞儿" }));
  set("nickname", HIR " 赌到山穷水尽" NOR);
  set("gender", "男性");
  set("age", 19);
  set("long",
    "据说他乃当今赌仙，此人年纪轻轻，却好赌如命．．．\n他的一个朋友叫天草四郎，好像也是个赌徒．．．\n");
  set("attitude", "peaceful");
  set("skill_public", 1);
  set("str", 10);
  set("cor", 30);
  set("dur", 30);
  set("agi", 40);
  set("int", 24);
  set("cps", 30);
  set("per", 18);
  set("chat_chance", 1);
  set("chat_msg", ({
    "王乞儿长笑一声：“世上难道无人与我一赌．．．”\n",
    "王乞儿低叹一声：“雨花石雨花石．．．”\n",
  }));
  set("inquiry", ([
    "拜师": (: bai_master :),
    "apprentice": (: bai_master :),
    "任务":
    "你想要任务？直接领任务(quest)不就得了，还拐弯抹角？！\n",
    "quest":
    "你想要任务？直接领任务(quest)不就得了，还拐弯抹角？！\n",
    "赌": (: do_betting :),
    "bet": (: do_betting :),
    "瓶颈": (: ask_skill :),
    "bottleneck": (: ask_skill :),
    "雨花石": "拾之可惜，弃之可叹．．．\n",
  ]));
  set("max_sen", 3000);
  set("max_gin", 3000);
  set("max_kee", 3000);
  set("force", 2000);
  set("max_force", 2000);
  set("combat_exp", 600000);
  set("score", 5000);
  set("daode", 3000);
  set_skill("unarmed", 200);
  set_skill("force", 300);
  set_skill("iron-cloth", 150);
  set_skill("begging", 350);
  set_skill("betting", 190);
  set_skill("perception", 220);
  set_skill("dodge", 300);
  set_skill("literate", 100);
  set_skill("throwing", 200);
  set_skill("jl-shibagua", 150);
  set_skill("thforce", 300);
  set_skill("jiusuojinmen", 100);
  map_skill("force", "thforce");   //天和内气	
  map_skill("unarmed", "jl-shibagua");  //金陵十八卦
  map_skill("throwing", "jl-shibagua");
  map_skill("dodge", "jl-shibagua");
  map_skill("perception", "betting");
  create_family("流云派", 2, "小太师");
  set("title", HIY "九世乞丐" NOR);
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  this_object()->delete("vendetta");
  add_action("give_quest", "quest");
  add_action("do_answer", "answer");
}

//GIVE EXP and POT ------------------------------------------------------------------------
int accept_object(object who, object ob) {
  int exp, pot, score, val;
  string test;
  mapping quest;
  val = ob->value();
  if (strsrch((string)ob->query("name"), "雨花石") != (-1) && ob->query("id") == "stone") {
    command("xixi");
    command("say 想不到你居然有此悟性，我就给你一个和我切磋的机会吧。");
    who->set_temp("wangqier/canfight", 1);
    return 1;
  }
  if (val && val == 10100) {
    if (!(who->query("wqrquest"))) {
      if (who->query("class") == "official") {
        message("vision", who->name() + "给了王乞儿一些银子。\n", environment(who), who);
        tell_object(who, "王乞儿嘻嘻一笑，道：阁下不愧是个官场中人！\n");
        who->set_temp("wangqier/offcan", 1);
        return 1;
      } else {
        tell_object(who, "王乞儿哼了一声，道：银子了不起？老子有的是钱！\n");
        return 0;
      }
    }
    who->set("wqrquest", 0);
    who->set("wangqier/time", 0);
    if (random(5) > 3)
      who->set_temp("wangqier/quest_num", 0);
    tell_object(who, "王乞儿说道：好吧，就算了吧．．\n");
    return 1;
  }
  if (!(quest = who->query("wqrquest"))) {
    tell_object(who, "王乞儿摇头道：这不是我想要的。\n");
    return 0;
  }
  if ((string)ob->query("name") != quest["quest"]) {
    tell_object(who, "王乞儿叹说道：这不是我想要的。\n");
    return 0;
  }
  if (ob->is_character()) {
    tell_object(who, "王乞儿嘿嘿一笑，道：这种东西也给我？\n");
    return 0;
  }
  if ((int)who->query("wangqier/time") < time()) {
    tell_object(who, "王乞儿惋惜地说道：真可惜！你没有在指定的时间内完成！\n");
    who->add("combat_exp", random(5) + 1);
    who->add("potential", random(3));
    tell_object(who, HIW "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n" NOR);
    if (who->query("class") == "official")
      who->set_temp("wangqier/offcan", 0);
    who->set("wqrquest", 0);
    who->set("wangqier/time", 0);
    who->set_temp("wangqier/quest_num", 0);
    return 1;
  } else {
    tell_object(who, "王乞儿说道：谢了！\n");
    exp = (int)to_int(pow(who->query("combat_exp") * 10.0, 0.333333));
    exp = (int)(exp + random((int)exp)) / 2;
    exp = exp * (int)who->query_temp("wangqier/quest_num");
    if (400 - exp < 0)
      exp = random(10) + 50;
    else if (exp > 300) exp = random(30) + 50;
    else exp = 400 - exp;
    pot = exp / 3;
    who->add("combat_exp", exp);
    who->add("mojiao/combat_exp", exp);
    who->add("potential", pot);
    tell_object(who, HIW "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n" NOR);
    if (who->query("class") == "official")
      who->set_temp("wangqier/offcan", 0);
    who->set("wqrquest", 0);
    who->set("wangqier/time", 0);
    return 1;
  }
  return 0;
}

void killed_enemy(object victim) {
  object realkiller;
  mapping quest;
  int i, teamsize, exp, pot;
  object *mem;
  if (victim->query_temp("my_skiller") != this_object()->query("id")) {
    realkiller = find_player(victim->query_temp("my_killer"));
    if (realkiller) {
      if (interactive(realkiller) && (quest = realkiller->query("wqrquest"))
        && ((int)realkiller->query("wangqier/time") >= time())
        && (victim->name() == quest["quest"])
        && !userp(victim)) {
        exp = (int)to_int(pow(victim->query("combat_exp") * 10.0, 0.333333));
        exp = exp * (int)realkiller->query_temp("wangqier/quest_num");
        exp = (int)(exp / 2 + random((int)exp / 2));
        pot = (int)(exp / 6 + random((int)exp / 6));
        mem = realkiller->query_team();
        teamsize = sizeof(mem);
        if (teamsize < 1) teamsize = 1;
        if (teamsize <= 1) {
          realkiller->add("combat_exp", exp);
          realkiller->add("potential", pot);
          tell_object(realkiller, HIY "你被奖励了：\n" +
            chinese_number(exp) + "点实战经验\n" +
            chinese_number(pot) + "点潜能\n" + NOR);
        } else {
          exp = exp / teamsize;
          pot = pot / teamsize;
          for (i = 0; i < sizeof(mem); i++) {
            if (mem[i])
              if ((mem[i]->query_temp("ttarget") == victim->query("id")) || mem[i] == realkiller)
                if (environment(realkiller) == environment(mem[i])) {
                  mem[i]->add("combat_exp", exp);
                  mem[i]->add("potential", pot);
                  tell_object(mem[i], HIY "你被奖励了：\n" +
                    chinese_number(exp) + "点实战经验\n" +
                    chinese_number(pot) + "点潜能\n" NOR);
                }
          }
        }
        realkiller->set("wqrquest", 0);
        realkiller->set("wangqier/time", 0);
        realkiller->delete("possessed");
      }
    }
  }
}

//recruit---------------------------------------------------------------------
int bai_master() {
  object me = this_object();
  object ob = this_player();
  if (ob->query("family/master_id") == me->query("id")) {
    say("\n王乞儿大模大样的拍拍你的头道：你已经证明你是一个可造之才了！\n");
    return 1;
  } else {
    say("\n王乞儿嘻嘻一笑，道：我问你个问题，如果答(answer)上来，我就考虑考虑。\n");
    switch (random(4)) {
      case 0:
        message_vision("$N对$n笑问道：什么是首尾相顾，一气呵成？\n", me, ob);
        ob->set_temp("wangqier/ask", 1);
        break;
      case 1:
        message_vision("$N对$n笑问道：什么是虚空境界？＂\n", me, ob);
        ob->set_temp("wangqier/ask", 2);
        break;
      case 2:
        message_vision("$N对$n笑问道：什么是神龙见首不见尾？\n", me, ob);
        ob->set_temp("wangqier/ask", 3);
        break;
      case 3:
        message_vision("$N对$n笑问道：什么是气贯重天？\n", me, ob);
        ob->set_temp("wangqier/ask", 4);
        break;
    }
    return 1;
  }
}

int do_answer(string arg) {
  object me = this_object();
  object ob = this_player();
  if (!arg) return notify_fail("你要回答什么？\n");
  switch ((int)ob->query_temp("wangqier/ask")) {
    case 0:
      message_vision("$N摇摇头。\n", me);
      break;
    case 1:
      if ((arg == "一条龙" || arg == "yitiaolong") && ob->query_int() > 30) {
        message_vision("$N嘻嘻一笑，道：果然有点慧根。\n", me);
        ob->set_temp("wangqier/canbai", 1);
      } else
        message_vision("$N摇摇头。\n", me);
      break;
    case 2:
      if ((arg == "十三幺" || arg == "shisanyao") && ob->query_int() > 30) {
        message_vision("$N嘻嘻一笑，道：果然有点慧根。\n", me);
        ob->set_temp("wangqier/canbai", 1);
      } else
        message_vision("$N摇摇头。\n", me);
      break;
    case 3:
      if ((arg == "天和" || arg == "tianhu") && ob->query_int() > 30) {
        message_vision("$N嘻嘻一笑，道：果然有点慧根。\n", me);
        ob->set_temp("wangqier/canbai", 1);
      } else
        message_vision("$N摇摇头。\n", me);
      break;
    case 4:
      if ((arg == "九莲宝灯" || arg == "jiulianbaodeng") && ob->query_int() > 30) {
        message_vision("$N嘻嘻一笑，道：果然有点慧根。\n", me);
        ob->set_temp("wangqier/canbai", 1);
      } else
        message_vision("$N摇摇头。\n", me);
      break;
  }
  return 1;
}

void attempt_apprentice(object me) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, me);
  } else {
    command("say 本太师每天至多只收一个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  if (ob->query_temp("wangqier/canbai") && !ob->query("mojiao/弃子")) {
    if (ob->query_int() < 3) {
      command("say 想不到你不但灵性十足，才智也如此聪慧，我就收你为徒吧！\n");
      command("recruit " + ob->query("id"));
    }
  } else command("say 本太师不收徒的！！\n");
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "wangsha");
    ob->set("marks/帮派", "魔教");
    ob->set("marks/魔教", "教徒");
    ob->set("id_type", 0);
    add("apprentice_availavble", -1);
  }
}

int recognize_apprentice(object ob) {
  if ((string)ob->query("class") == "wangsha")
    return 1;
  if (ob->query_temp("wangqier/canlearn") > time() && ob->query_int() > 20 && ob->query_temp("wangqier/canfight"))
    return 1;
  else ob->set_temp("wangqier/canlearn", 0);
  return 0;
}

int ask_skill() {
  object ob = this_player();
  if (ob->query("class") != "wangsha")
    command("say 本门武功秘密岂可随便外泄！\n");
  else {
    message_vision("$N在$n耳边嘀咕了几句．．\n", this_object(), ob);
    tell_object(ob, "嘻嘻，你只有传内力(Exert Jiayi)给别人，才能突破瓶颈！\n不过是会废了你内功的！！\n");
  }
  return 1;
}
//QUEST LINE-------------------------------------------------------------
int give_quest(string arg) {
  mapping quest;
  object me, glass;
  int timep;
  me = this_player();
  if ((int)me->query("combat_exp") < 10000) {
    command("look " + me->query("id"));
    write("王乞儿看了看你，摇头道：你武功不行，领任务只怕有生命之忧！\n");
    return 1;
  }
  if (me->query("class") == "official" && (!me->query_temp("wangqier/offcan"))) {
    message_vision("$N白眼一翻，对$n道：我是乞丐，你是高官，我怎么敢当呢？\n", this_object(), me);
    return 1;
  }
  if ((int)me->query("combat_exp") > 1500000 || (int)me->query("mojiao/combat_exp") > 1200000) {
    message_vision("$N弓身一辑，对$n道：阁下武功盖世，说笑了！！\n", this_object(), me);
    return 1;
  }
  if ((int)me->is_ghost()) {
    message_vision("$N口吐白沫翻身就倒，道：鬼魂也来要任务？这世道．．．\n", this_object());
    return 1;
  }
  if (quest = me->query("wqrquest")) {
    if (((int)me->query("wangqier/time")) > time())
      return 0;
    else {
      me->set("kee", me->query("kee") / 2 + 1);  //有好有坏
      me->delete_temp("wangqier/quest_num");
      tell_object(me, "王乞儿说道：真是太可惜了！！\n");
    }
  }
  quest = load_questobj();
  if (!quest) {
    write("目前没有任务！\n");
    return 1;
  }
  if (!objectp(glass = present("questtime", me))) {
    tell_object(me, "王乞儿递给你一个任务时间器。\n");
    glass = new(__DIR__ "obj/queststone");
    glass->move(me);
  }
  timep = random(400) + 1000;
  time_period(timep, me);
  tell_object(me, "找来『" + quest["quest"] + "』给我。\n" NOR);
  me->set("wqrquest", quest);
  me->set("wangqier/time", (int)time() + (int)timep);
  if ((int)me->query_temp("wangqier/quest_num") < 5)
    me->add_temp("wangqier/quest_num", 1);
  return 1;
}

void kill_smbd(object me) {
  mapping quest;
  int timep;
  object glass;
  quest = load_questnpc();
  if (!quest) {
    tell_object(me, HIY "王乞儿隐隐的低声说道：看来你要去杀一个武功与你相当的“人”！！\n" NOR);
    if (!me->set("wangqier/killer"))
      me->set("wangqier/killer", me->query("PKS") + 1);
  } else {
    if (!objectp(glass = present("questtime", me))) {
      tell_object(me, "王乞儿递给你一个任务时间器。\n");
      glass = new(__DIR__ "obj/queststone");
      glass->move(me);
    }
    me->set("possessed", this_object());
    timep = random(1200) + 2400;
    time_period(timep, me);
    tell_object(me, "替我杀了『" + quest["quest"] + "』。\n" NOR);
    me->set("wqrquest", quest);
    me->set("wangqier/time", (int)time() + (int)timep);
    if ((int)me->query_temp("wangqier/quest_num") < 5)
      me->add_temp("wangqier/quest_num", 1);
  }
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, HIW "王乞儿说道：\n请在" + time + "内");
  return 1;
}

//FIGHTING--------------------------------------------------------------
object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

int accept_fight(object me) {
  int i, timep;
  mapping quest;
  i = (int)(me->query("combat_exp") / 100000);
  if (!me->query_temp("wangqier/canfight")) {
    command("xixi");
    command("say 你不是我的对手！");
    return 0;
  } else if (((int)me->query("wangqier/time")) > time() || (int)me->query("wangqier/killer") > me->query("PKS")) {
    command("sigh");
    command("say 你还没有没有完成任务呢？");
    me->set_temp("wangqier/canfight", 0);
    return 0;
  } else {
    if ((int)me->query("combat_exp") >= 500000 && random(20 + i) < i) {
      command("grin");
      command("say 你武功不错嘛，不如替我去杀个人吧！\n");
      me->set_temp("wangqier/canfight", 0);
      kill_smbd(me);
      return 0;
    } else if ((int)me->query("combat_exp") >= 300000 && random(20 + i) < i) {
      command("hmm");
      quest = load_questobj();
      if (!quest) {
        command("say 好吧，你可要小心了！\n");
        me->start_call_out((: call_other, __FILE__, "remove_fight", this_object(), me :), 3600);
        return 1;
      } else {
        command("say 我想要件东西，你替我去找来。\n");
        timep = random(200) + 400;
        time_period(timep, me);
        tell_object(me, "找回『" + quest["quest"] + "』给我。\n" NOR);
        me->set("wqrquest", quest);
        me->set("wangqier/time", (int)time() + (int)timep);
        if ((int)me->query_temp("wangqier/quest_num") < 5)
          me->add_temp("wangqier/quest_num", 1);
        me->set_temp("wangqier/canfight", 0);
        return 0;
      }
    } else {
      command("smile");
      if (me->query("wangqier/fight_time") > time()) {
        command("say 改天再来吧，回去再练练。\n");
        me->set_temp("wangqier/canfight", 0);
        return 0;
      }
      command("say 好吧，你可要小心了！");
      me->start_call_out((: call_other, __FILE__, "remove_fight", this_object(), me :), 3600);
      return 1;
    }
  }
}


void heart_beat() {
  object me = this_object();
  object target;
  int urexp;
  if (me->is_fighting()) {
    target = offensive_target(me);
    urexp = (int)target->query("combat_exp");
    if (urexp < 600000)
      me->set("combat_exp", urexp);
    else me->set("combat_exp", (urexp / 5) * 6);
    if (userp(target) && target->query_temp("wangqier/canfight") && !target->is_killing(me->query("id"))) {
      target->add("combat_exp", random(2) + 1);
      if (!random(3)) target->add("potential", 1);
    } else {
      me->set("force_factor", 150);
      me->set("str", 200);
      me->set("combat_exp", (int)urexp * 5);
      me->set_temp("apply/damage", 500);
      target->set_temp("apply/defense", -500);
      target->set_temp("apply/attack", -500);
    }
  } else {
    me->set("str", 10);
    me->set("eff_sen", 3000);
    me->set("eff_gin", 3000);
    me->set("eff_kee", 3000);
    me->set("sen", 3000);
    me->set("gin", 3000);
    me->set("kee", 3000);
    me->set("force_factor", 0);
    me->set("combat_exp", 600000);
    me->delete_temp("apply/damage");
    me->delete("vendetta");
  }
  return ::heart_beat();
}

void win_enemy(object victim) {
  if (victim->query_temp("wangqier/canfight"))
    victim->set_temp("wangqier/canfight", 0);
  victim->set_temp("wangqier/canlearn", 0);
  victim->set("wangqier/fight_time", time() + 3600);
}

void lose_enemy(object victim) {
  if (!random(5)) {
    message_vision(CYN "\n$N哈哈大笑，说道：果然好武功！\n\n" NOR, this_object());
    victim->set_temp("wangqier/canlearn", time() + 600);
  }
  if (victim->query_temp("wangqier/canfight"))
    victim->set_temp("wangqier/canfight", 0);
  victim->set("wangqier/fight_time", time() + 3600);
}

void die() {
  object me = this_object();
  command("sigh");
  me->set("str", 10);
  me->set("eff_sen", 3000);
  me->set("eff_gin", 3000);
  me->set("eff_kee", 3000);
  me->set("sen", 3000);
  me->set("gin", 3000);
  me->set("kee", 3000);
  me->set("force", 2000);
  me->set("force_factor", 0);
  me->set("combat_exp", 600000);
  me->delete_temp("apply/damage");
  me->delete("vendetta");
  me->remove_all_killer();
  return;
}

void remove_fight(object me, object target) {
  int nowtime;
  nowtime = time();
  if (me->is_fighting(target)) {
    message_vision(CYN "$N" + CYN "突然一闪身，欺入$n" + CYN "中宫，一掌击在$n" + CYN "胸口。\n" NOR, me, target);
    message_vision(HIR "$n" + HIR "被$N" + HIR "震得气血翻腾，大惊失色。\n" NOR, me, target);
    me->remove_killer(target);
    target->remove_killer(me);
    message_vision(winner_msg[random(sizeof(winner_msg))], me, target);
  }
  target->delete_temp("wangqier/canfight");
  target->set("wangqier/fight_time", nowtime + 3600);
}

//------------------------------------------------------------------------------------
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "流云派弟子");
    return;
  } else if (exp <= 64000) {
    student->set("title", "流云派小侠");     //
    return;
  } else if (exp <= 128000) {
    student->set("title", "流云派小侠");
    return;
  } else if (exp <= 256000) {
    student->set("title", "流云派少侠");  //
    return;
  } else if (exp <= 512000) {
    student->set("title", "流云派少侠");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "流云派大侠");  //
    return;
  } else if (exp <= 1536000) {
    student->set("title", "流云派大侠");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "流云派奇侠");  //
    return;
  } else if (exp <= 3456000) {
    student->set("title", "流云派奇侠");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "流云派小太师");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "流云派太师");
    return;
  } else
    student->set("title", "流云派元老");
  return;
}

void reset() {
  delete_temp("learned");
  set("apprentice_available", 2);
}

//BET -------------------------------------------------------

int do_betting() {
  command("say 你哪里是我的对手！\n");
  return 1;
}

//LOAD_quest--------------------------

mapping load_questnpc() {
  mapping quest;
  object questnpc;
  mixed objfile;
  int i, j;
  string path = killerlist[random(sizeof(killerlist))];
  object me = this_player();
  objfile = get_dir(path);
  if (!sizeof(objfile)) {
    if (file_size(path) == -2) return quest;
    else return quest;
  }
  path = replace_string(path, "*.lpc", "");
  i = sizeof(objfile);
  for (j = 0; j < i; j++) {
    questnpc = find_object(path + objfile[random(i)]);
    if (!questnpc) questnpc = load_object(path + objfile[random(i)]);
    if (!questnpc) continue;
    if (!questnpc->is_character()) continue;
    break;
  }
  if (!questnpc || !questnpc->is_character()) return quest;
  quest = ([ "quest": questnpc->name(),
    "quest_type": "杀",
  ]);
  return quest;
}

mapping load_questobj() {
  mapping quest;
  object questobj;
  mixed objfile;
  string path;
  int i, j, m;
  m = random(sizeof(objlist));
  path = objlist[m];
  objfile = get_dir(path);
  if (!sizeof(objfile)) {
    if (file_size(path) == -2) return quest;
    else return quest;
  }
  path = replace_string(path, "*.lpc", "");
  i = sizeof(objfile);
  for (j = 0; j < i; j++) {
    questobj = find_object(path + objfile[random(i)]);
    if (!questobj) questobj = load_object(path + objfile[random(i)]);
    if (!questobj) continue;
    if (questobj->is_character()) continue;
    if (questobj->query("no_get") || questobj->query("no_drop") || questobj->query("owner"))
      continue;
    break;
  }
  if (!questobj || questobj->is_character()) return quest;
  quest = ([ "quest": questobj->name(),
    "quest_type": "寻",
    "exp": m,
  ]);
  return quest;
}
