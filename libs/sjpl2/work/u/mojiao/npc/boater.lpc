// boater.c written by john darks
#include <ansi.h>
inherit NPC;
void create() {
  set_name("老婆子", ({ "old boater" }));
  set("long", "她面容被岁月侵蚀，风雨吹打，划出了千百条皱纹，
显得那么衰老但一双眼睛，却仍亮如闪电，似是只
要一眼瞧过去，任何人的秘密，就再也休想瞒过她。\n");
  set("gender", "女性");
  set("age", 62);
  set("no_arrest", 1);
  set("attitude", "friendly");
  set("chat_chance", 2);
  set("chat_msg", ({
    "老婆子手中的竹竿轻轻一点江面，小舟立刻荡去老远。\n",
  }));
  set("inquiry", ([
    "*": "你先管你自己吧，做稳了。\n",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/changgao")->wield();
}

void unconcious() {
  ::die();
}

void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  if (arg != "old boater")
    return 0;
  write(this_object()->query("long"));
  write("她看起来约六十多岁。\n");
  write("她相貌平平,还看得过去。\n");
  write("武功看起来好象" + HIR "深不可测" NOR + "，出手似乎极重。\n");
  write("她" + HIG "精神饱满，正处于巅峰状态" NOR + "。\n");
  write("她身上带著：\n");
  write(HIC "  √" NOR + "布衣(Cloth)\n");
  write(HIC "  √" NOR + "竹竿(Zhugan)\n");
  return 1;
}
