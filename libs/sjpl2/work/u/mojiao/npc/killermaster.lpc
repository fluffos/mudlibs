//killermaster.c written by john darks
inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
int ask_join();
int ask_quest();
void create() {
  set_name("老瞎子", ({ "old man" }));
  set("gender", "男性");
  set("age", 69);
  set("long",
    "这位瞎子正用白多黑少的双眼盯着你\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("force_factor", 500);
  set("fle", 112);
  set("cor", 66);
  set("agi", 41);
  set("str", 34);
  set("per", 30);
  set("vendor_goods", ([
    "/obj/example/dumpling": 30,
    "/obj/paper_seal": 50,
    "/obj/example/wineskin": 15,
  ]));
  set("inquiry", ([
    "任务": (: ask_quest :),
    "quest": (: ask_quest :),
    "here": "这里就是天柱山了。\n",
    "name": "唉，又有谁会记得我老头子的名字呢。\n",
    "rumors": "最近江湖中好像出现了一个新的杀手组织，唉，咳咳．．．\n",
    "killer": (: ask_join :),
    "杀手组织": (: ask_join :),
  ]));
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      message_vision("$N用白多黑少的眼睛看了看门口，伏下身深深的咳嗽起来．\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N捶了捶自己的后背，茫然的看着门口，说道：这位" + RANK_D->query_respect(ob) +
        "要买什么？\n", this_object(), ob);
      break;
    case 2:
      message_vision("$N轻轻的咳嗽了一下，道：买干粮还是买．．．？\n", this_object());
  }
}

int accept_object(object who, object ob) {
  int val;
  object paper;

  val = ob->value();
  if (!val)
    return 0;
  else if (val >= 10000) {
    paper = new(__DIR__ "obj/youzhi");
    if (paper) {
      paper->set("targetprice", (int)val / 100);
      paper->move(who);
    }
  }
  say("老瞎子仔细的摸了摸你的手，说道：多谢这位" + RANK_D->query_respect(who)
    + "可怜我这没用的穷瞎人．\n");

  return 1;
}

int ask_quest() {
  object me = this_player();
  object ob = this_object();
  mapping *killer;
  string msg;
  int i;
  if (!me->query("marks/killer"))
    command("say 最近江湖中好像出现了一个新的杀手组织，唉，咳咳．．．\n");
  else {
    message_vision("$N在$n耳边嘀咕了几句．．\n", ob, me);
    msg = HIR "***** 目前的刺杀任务有：  *****\n" NOR;
    killer = ob->query("killer");
    for (i = 0; i < sizeof(killer); i++) {
      msg += killer[i]["time"] + killer[i]["ownername"] + "(" + killer[i]["killer"] + ")用" + killer[i]["targetprice"] + "两白银杀" + killer[i]["targetname"] + "(" + killer[i]["targetid"] + ")";
      if (killer[i]["killed"])
        msg += "(已被完成)\n";
      else if (killer[i]["killing"])
        msg += "(已被领取)\n";
      else msg += "\n*****                   *****\n";
    }
    me->start_more(msg);
  }
  return 1;
}

int ask_join() {
  object ob = this_player();
  if (!ob->query("marks/killer"))
    command("hmm");
  else {
    command("hmm");
    command("whisper " + ob->query("id") + " 这次算了，下次如果泄密，就要处罚你了。\n");
  }
  return 1;
}
