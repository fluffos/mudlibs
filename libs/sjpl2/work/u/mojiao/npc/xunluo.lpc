inherit NPC;


void create() {
  set_name("杨小邪", ({ "yang" }));

  set("age", 85);
  set("long",
    "一个约八十来岁的老人，太阳穴高高鼓起，目光炯炯有神。\n"
    "你可以 list 看可以点什么菜，用 buy 跟店小二点菜。\n");
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}


void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("杨小邪笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝杯茶，歇歇腿吧。\n");
      break;
    case 1:
      say("杨小邪用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
    case 2:
      say("杨小邪说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。\n");
      break;
  }
  this_object()->kill_ob(ob);
}
