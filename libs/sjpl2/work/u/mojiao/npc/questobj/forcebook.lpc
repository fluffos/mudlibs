//forcebook.c written by john darks
inherit ITEM;
void create() {
  set_name("无坎真阴秘笈", ({ "forcebook" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本页面发黄的武功秘笈。\n");
    set("value", 0);
    set("questvalue", 100);
    set("material", "paper");
    set("skill", ([
      "name": "force",
      "exp_required": 150000,
      "sen_cost": 35,
      "difficulty": 30,
      "max_skill": 200,
    ]));
  }
}
