//nothingbook.c written by john darks
inherit ITEM;
void create() {
  set_name("无字天书", ({ "book" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "三清道术，茅山道教镇教秘籍。\n");
    set("value", 260);
    set("questvalue", 120);
    set("material", "paper");
  }
}
