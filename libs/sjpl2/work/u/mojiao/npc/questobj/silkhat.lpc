//天蚕斗笠 silkhat.c  written by john darks
#include <ansi.h>
#include <armor.h>
inherit HEAD;
void create() {
  set_name(HIC "天蚕斗笠" NOR, ({ "silk-hat" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个带有天蚕巾的斗笠。\n");
    set("unit", "个");
    set("value", 10000);
    set("questvalue", 300);
    set("armor_prop/armor", 20);
    set("armor_prop/personality", 3);
    set("armor_prop/astral_vision", 1);
    set("wear_msg", "$N轻轻地把$n戴在头上。\n");
    set("unwield_msg", "$N轻轻地把$n从头上除了下来。\n");
  }
  setup();
}
