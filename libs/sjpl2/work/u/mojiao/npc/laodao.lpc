#include <ansi.h>
inherit NPC;
int ask_skill();
void remove_canwu(object me, string *oldshort);
void create() {
  set_name("天道人", ({ "tian daoren", "tian", "daoren" }));
  set("title", HIC "悠闲道士" NOR);
  set("nickname", HIY "天地任我游" NOR);
  set("gender", "男性");
  set("age", 52);
  set("agi", 35);
  set("str", 70);
  set("max_force", 12000);
  set("force", 20000);
  set("attitude", "peaceful");
  set("my_perform/canpfm", 1);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("customskill", 150);
  set_temp("apply/damage", 100);
  //set_skill("yanyun-steps",200);
  //map_skill("dodge","yanyun-steps");
  map_skill("parry", "customskill");
  map_skill("unarmed", "customskill");
  set("my_skill/skill_type", "unarmed");
  set("my_skill/eff_level", 20);
  set("my_skill/skill_actions", ({
    "$N吐气扬声，一招「气撼九重天」双掌并力推出",
    "$N吐气扬声，一招「气撼七重天」双掌并力推出",
    "$N吐气扬声，一招「气撼五重天」双掌并力推出",
    "$N吐气扬声，一招「气撼三重天」双掌并力推出",
    "$N吐气扬声，一招「气撼一重天」双掌并力推出",
  }));
  set("combat_exp", 50000000);
  set("inquiry", ([
    "参悟": (: ask_skill :),
    "canwu": (: ask_skill :),
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "悠闲道士仰天长笑了一声．．．”\n",
  }));
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.myperform" :),
  }));
  setup();
}

int recognize_apprentice(object ob) {
  return 0;
}

int ask_skill() {
  int pot, my_skill, mybusy;
  string title, nick, str, *mask, *oldshort;
  object me = this_player();
  object ob = this_object();
  if (!(int)me->query_skill("customskill", 1)) {
    command("shake");
    return 1;
  }
  my_skill = me->query_skill_eff_lvl("customskill");
  if (me->is_busy()) {
    write("( 你上一个动作还没有完成，无法安心参悟。)\n");
    return 1;
  }
  if ((my_skill * my_skill * my_skill) / 10 > (int)me->query("combat_exp")) {
    write("由于缺乏经验，你的参悟毫无效果。\n");
    return 1;
  }
  if (me->query("sen") < me->query("max_sen")) {
    write("你的心神不够，无法专心参悟！\n");
    return 1;
  }
  if (me->query("gin") < me->query("max_gin")) {
    write("你的精力不够，无法专心参悟！\n");
    return 1;
  }
  if (me->query("kee") < me->query("max_kee")) {
    write("你的身体状况太差，无法专心参悟！\n");
    return 1;
  }
  pot = (int)me->query("potential") - (int)me->query("learned_points");
  if (pot < 2500) {
    write("你的潜能不够，无法专心参悟！\n");
    return 1;
  }
  message_vision(CYN "悠闲道士含笑点了点头，说道：参悟之道，源自内心。\n" NOR, me);
  message_vision("$N安坐下来，开始专心参悟自创技！\n", me);
  me->set_temp("block_msg/all", 1);
  me->set_temp("is_unconcious", 1);
  if (!stringp(str = me->query("short")))
    str = me->name() + "(" + capitalize(me->query("id")) + ")";
  if (sizeof(mask = me->query_temp("apply/short")))
    str = (string)mask[sizeof(mask) - 1];
  else {
    if (stringp(nick = me->query("nickname")))
      str = sprintf("「%s」%s", nick, str);

    if (stringp(title = me->query("title")))
      str = sprintf("%s%s%s", title, (nick ? "" : " "), str);
  }
  str += HIW " <参悟中>" NOR;
  oldshort = me->query_temp("apply/short");
  me->set_temp("apply/short", ({ str }));
  mybusy = random(60 - (int)me->query_con());
  if (mybusy < 20) mybusy = 20;
  me->start_busy(mybusy);
  me->start_call_out((: call_other, __FILE__, "remove_canwu", me, oldshort :), mybusy);
  return 1;
}

void remove_canwu(object me, string *oldshort) {
  me->delete_temp("block_msg/all");
  me->delete_temp("is_unconcious");
  me->set_temp("apply/short", oldshort);
  if (!me->is_ghost())
    message_vision("$N从忘我的境界中回神敛气，睁开了眼睛。\n", me);
  tell_object(me, "你参悟了一会儿，似有所悟。\n");
  me->improve_skill("customskill", 10 + me->query_int() * me->query_int());
  me->add("learned_points", 2500);
  me->start_busy(1);
}
