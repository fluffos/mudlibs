#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_skills();
void create() {
  set_name("朴一虎", ({ "piao yihu", "piao", "master" }));
  set("title", "魔教四大护法弟子");
  set("gender", "男性");
  set("age", 36);
  set("nickname", HIB "龙虎干戈" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("combat_exp", 1000000);
  set("score", 2000);
  set_skill("literate", 60);
  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("stick", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("stickarray", 140);
  set_skill("pyrobat-steps", 100);
  set_skill("senluo-force", 100);
  map_skill("stick", "stickarray");
  map_skill("force", "senluo-force");
  create_family("魔教", 5, "弟子");
  set("class", "mojiao");
  set("inquiry", ([
    "棍阵": (: about_skills :),
    "stickarray": (: about_skills :),
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/stick")->wield();
}

void attempt_apprentice(object ob) {
  message_vision(CYN "朴一虎说道：“在下武功低微，阁下说笑了。”\n" NOR, ob);
  return;
}

int about_skills() {
  object me = this_player();
  object ob = this_object();
  if (me->query("marks/帮派") != "魔教" || me->query("mojiao/array1") < 1) {
    message_vision(CYN "朴一虎说道：“在下武功低微，阁下说笑了。”\n" NOR, ob);
    return 1;
  }
  if (me->query("mojiao/兵刃") < 500) {
    message_vision(CYN "朴一虎说道：“阁下似乎对兵刃没有太多的喜好。”\n" NOR, ob);
    return 1;
  }
  if (me->query("mojiao/忠心") < 100000) {
    message_vision(CYN "朴一虎说道：“阁下职位低微，还是去做些其它对本教有益的事吧。”\n" NOR, ob);
    return 1;
  }
  if (!me->query_skill("stickarray", 1)) {
    message_vision(CYN "朴一虎说道：“蒙阁下垂青，属下自当倾力相授龙虎干戈棍阵(stickarray)。”\n" NOR, ob);
    me->improve_skill("stickarray", me->query_int() * me->query_int() / 100);
  } else
    message_vision(CYN "朴一虎说道：“属下自当倾力相授龙虎干戈棍阵(stickarray)。”\n" NOR, ob);
  me->set("mojiao/array1", 2);
  return 1;
}

int recognize_apprentice(object ob) {
  if (ob->query("mojiao/array1") > 1)
    return 1;
  return 0;
}
