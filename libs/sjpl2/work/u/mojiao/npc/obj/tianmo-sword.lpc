#include <weapon.h>

inherit SWORD;

void create() {
  set_name("天魔剑", ({ "tianmo sword", "sword", "jian" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",

      "这是一把外表普通的铁剑，剑身血迹斑斑，闪耀着暗淡的紫光，剑未出鞘已经令人感到\n"

      "它的杀气。\n");
    set("value", 12000);
    set("material", "blacksteel");
    set("wield_msg",
      "只感到一阵杀气袭来，$N的手中已经多了一把血迹斑斑的怪剑——$n。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  }
  init_sword(220);
  setup();
}
