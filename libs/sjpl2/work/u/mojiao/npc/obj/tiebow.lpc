//tiebow.c written by john darks
#include <weapon.h>
inherit HAMMER;
void create() {
  set_name("大铁弓", ({ "tiebow" }));
  set_weight(100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 500);
    set("material", "blackstone");
    set("long", "一把铁弓\n");
  }
  init_hammer(65);
  setup();
}
