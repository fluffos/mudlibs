#include <ansi.h>

inherit NPC;

void create() {
  set_name("魔教弟子", ({ "mojiao dizi", "dizi" }));
  set("long",

    "这是个魔教的弟子，负责守卫总坛。魔教中人凶残无比，谁也不愿得罪他们。\n");

  set("attitude", "heroism");
  set("pursuer", 1);    // 追捕？  1=yes 0=no
  set("vendetta_mark", "mojiao");
  set("str", 20);
  set("force", 1000);
  set("max_force", 1000);
  set("cor", 20);
  set("cps", 20);

  set("combat_exp", random(50) * 1000);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :),
  }));

  set("chat_chance_combat", 1);
  set("chat_msg_combat", ({
    "魔教弟子喝道：受死吧！！！我们的人不会放过你的！\n",
  }));

  set_skill("unarmed", 70);
  set_skill("sword", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set_skill("move", 70);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 30);
  set_temp("apply/move", 30);

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}
