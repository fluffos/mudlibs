// boater.c written by john darks
#include <ansi.h>
#include <command.h>
inherit NPC;
void use_poison();
void create() {
  set_name("渔家少女", ({ "yu girl" }));
  set("long", "她面容消瘦，但一双眼睛，却极明亮，更充满了一股野性，
似乎一眼就可以把人的魂勾走。这时她正睁着清澈的大眼
睛打量着你，你很想跟她认识认识（know）。\n");
  set("gender", "女性");
  set("age", 18);
  set("per", 25);
  set("max_gin", 5000);
  set("max_kee", 10000);
  set("max_sen", 5000);
  set_temp("mojiao/baochou", 4);
  set("no_arrest", 1);
  set("attitude", "friendly");
  set("chat_chance", 2);
  set("chat_msg", ({
    "小姑娘手中的竹竿轻轻一点江面，小舟立刻避开礁石荡了开去。\n",
  }));
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: use_poison :),
  }));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/changgao")->wield();
}

void unconcious() {
  ::die();
}

void init() {
  add_action("do_know", "know");
}

int do_know(string arg) {
  object ob = this_player();
  object me = this_object();
  if (arg != "yu girl")
    return 0;
  else {
    message_vision(CYN "$N浅笑盈盈，说道：“我叫红棉，这位" + RANK_D->query_respect(ob) + "要去哪里呀？”\n" NOR, me);
    me->set_name("红棉", ({ "yu girl", "hong mian" }));
    ob->set_temp("mojiao/baochou", 1);
    return 1;
  }
}

void use_poison() {
  object me = this_object();
  object ob = present("qi meng", environment(this_object()));
  if (!ob) {
    message_vision(RED "$N虚晃一招，纵身向外跳开，企图避开敌人的攻势，\n" NOR, me);
    GO_CMD->do_flee(me);
  }
}
