//tianhu.c	written by john darks
inherit NPC;
#include <ansi.h>
inherit F_MASTER;
string *killerlist = ({
  "/u/wudang/npc/*.lpc",
  "/u/tian/shaolin/npc/*.lpc",
  "/u/yanzi/huashan/npc/*.lpc",
  "/d/city/npc/*.lpc",
  "/u/baiwt/xueshan/npc/*.lpc",
  "/d/yangzhou/npc/*.lpc"
});
int time_period(int timep, object me);
void re_rank(object student);
int ask_skill();
mapping load_questnpc();

void create() {
  set_name("天和", ({ "tianhu", "天和" }));
  set("title", HIY "奇道人" NOR);
  set("gender", "男性");
  set("age", 99);
  set("long", "天和道人一身道袍，负手而立．．．\n");
  set("attitude", "peaceful");
  set("skill_public", 1);
  set("apprentice_available", 2);
  set("str", 40);
  set("cor", 100);
  set("dur", 30);
  set("agi", 100);
  set("int", 30);
  set("cps", 30);
  set("per", 21);
  set("chat_chance", 1);
  set("chat_msg", ({
    "天和道人长笑一声：“世事如烟云．．．”\n",
  }));
  set("inquiry", ([
    "任务": "你想要任务？直接领任务(quest)吧。\n",
    "quest": "你想要任务？直接领任务(quest)吧。\n",
    "瓶颈": (: ask_skill :),
    "bottleneck": (: ask_skill :),
  ]));
  set("max_sen", 3000);
  set("max_gin", 3000);
  set("max_kee", 3000);
  set("force", 17000);
  set("max_force", 10000);
  set("force_factor", 100);
  set("combat_exp", 23000000);
  set_temp("apply/parry", 200);
  set_temp("apply/damage", 500);
  set_temp("apply/attack", 300);
  set("score", 5000);
  set_skill("literate", 260);
  set_skill("betting", 300);
  set_skill("perception", 200);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("iron-cloth", 300);
  set_skill("move", 200);
  set_skill("sanshoubapu", 250);
  set_skill("thforce", 300);
  set_skill("jiusuojinmen", 150);
  set_skill("yanyun-steps", 200);
  map_skill("perception", "betting");
  map_skill("force", "thforce");   //天和内气	
  map_skill("unarmed", "sanshoubapu");  //散手八扑
  map_skill("iron-cloth", "jiusuojinmen");  //九锁金门
  map_skill("dodge", "yanyun-steps");  //烟云缥缈步
  map_skill("move", "yanyun-steps");
  map_skill("parry", "sanshoubapu");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.zhemei" :),
    (: perform_action, "dodge.sihaizongheng" :),
  }));
  create_family("流云派", 1, "太师");
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  this_object()->delete("vendetta");
  add_action("give_quest", "quest");
  add_action("cancel_quest", "cancel");
}

//GIVE EXP and POT ------------------------------------------------------------------------
int accept_object(object who, object ob) {
  int exp, pot, score, val;
  string test;
  mapping quest;
  val = ob->value();
  if (val && val == 10100) {
    who->set("thquest", 0);
    who->set("tianhu/time", 0);
    if (random(5) > 3)
      who->set_temp("tianhu/quest_num", 0);
    tell_object(who, "天和道人说道：好吧，就算了吧．．\n");
    return 1;
  }
  if (ob->is_character()) {
    tell_object(who, "天和道人嘿嘿一笑，道：这种东西也给我？\n");
    return 0;
  }
  return 0;
}

void killed_enemy(object victim) {
  object realkiller;
  mapping quest;
  int i, teamsize, exp, pot;
  object *mem;
  if (victim->query_temp("my_skiller") != this_object()->query("id")) {
    realkiller = find_player(victim->query_temp("my_killer"));
    if (realkiller) {
      if (interactive(realkiller) && (quest = realkiller->query("thquest"))
        && ((int)realkiller->query("tianhu/time") >= time())
        && (victim->name() == quest["quest"])
        && !userp(victim)) {
        exp = (int)to_int(pow(victim->query("combat_exp") * 10.0, 0.333333));
        exp = exp * (int)realkiller->query_temp("tianhu/quest_num") + 40 + random(10);
        exp = (int)(exp / 3 + random((int)exp / 3));
        pot = (int)(exp / 6 + random((int)exp / 6));
        mem = realkiller->query_team();
        teamsize = sizeof(mem);
        if (teamsize < 1) teamsize = 1;
        if (teamsize <= 1) {
          if (exp > 200) exp = random(100) + 100;
          if (pot > 100) pot = random(60) + 20;
          realkiller->add("combat_exp", exp);
          realkiller->add("life_exp", pot + 20);
          realkiller->add("potential", pot);
          tell_object(realkiller, HIY "你被奖励了：\n" +
            chinese_number(exp) + "点实战经验\n" +
            chinese_number(pot + 20) + "点江湖阅历\n" +
            chinese_number(pot) + "点潜能\n" + NOR);
        } else {
          exp = exp / teamsize;
          pot = pot / teamsize;
          for (i = 0; i < sizeof(mem); i++) {
            if (mem[i])
              if ((mem[i]->query_temp("ttarget") == victim->query("id")) || mem[i] == realkiller)
                if (environment(realkiller) == environment(mem[i])) {
                  if (exp > 200) exp = random(100) + 100;
                  if (pot > 100) pot = random(70) + 30;
                  mem[i]->add("combat_exp", exp);
                  mem[i]->add("life_exp", pot + 20);
                  mem[i]->add("potential", pot);
                  tell_object(mem[i], HIY "你被奖励了：\n" +
                    chinese_number(exp) + "点实战经验\n" +
                    chinese_number(pot + 20) + "点江湖阅历\n" +
                    chinese_number(pot) + "点潜能\n" NOR);
                }
          }
        }
        realkiller->set("thquest", 0);
        realkiller->set("tianhu/time", 0);
        realkiller->delete("possessed");
      }
    }
  }
}

//recruit---------------------------------------------------------------------
void attempt_apprentice(object me) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, me);
  } else {
    command("say 本太师每天至多只收一个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  object me = this_object();
  if (ob->query("family/master_id") == me->query("id")) {
    say("\n天和道人点点头道：你已经证明你是一个可造之才了！\n");
  } else if ((string)ob->query("family/family_name") == (string)me->query("family/family_name")) {
    if (ob->query("combat_exp") <= 512000) {
      say("\n天和道人微笑道：原来是乞儿的徒儿，看来还需多加磨练。\n");
    } else {
      command("smile");
      command("say 果然颇有才气，想不到本太师百岁之年还可以觅得如此好徒儿！\n");
      command("recruit " + ob->query("id"));
    }
  } else command("say 本道人不收徒的！！\n");
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    re_rank(ob);
    add("apprentice_availavble", -1);
  }
}

int recognize_apprentice(object ob) {
  if ((string)ob->query("class") == "wangsha")
    return 1;
  return 0;
}

int ask_skill() {
  object ob = this_player();
  if (ob->query("class") != "wangsha")
    command("say 本门武功秘密岂可随便外泄！\n");
  else {
    message_vision("$N在$n耳边嘀咕了几句．．\n", this_object(), ob);
    tell_object(ob, "你只有传内力(Exert Jiayi)给别人，才能突破瓶颈！\n不过是会废了你天和内功！！\n");
  }
  return 1;
}
//QUEST LINE-------------------------------------------------------------
int give_quest(string arg) {
  mapping quest;
  object me, glass;
  int timep;
  me = this_player();
  if ((int)me->is_ghost()) {
    message_vision("$N皱皱眉道：鬼魂不可以要任务！\n", this_object());
    return 1;
  }
  if ((int)me->query("id_type") != 2) {
    message_vision("$N微微摇头，叹道：你我非同道中人。\n", this_object());
    return 1;
  }
  if (quest = me->query("thquest")) {
    if (((int)me->query("tianhu/time")) > time())
      return 0;
    else {
      me->set("kee", me->query("kee") / 2 + 1);  //有好有坏
      me->delete_temp("tianhu/quest_num");
      tell_object(me, "天和道人说道：真是太可惜了！！\n");
      me->set("thquest", 0);
      me->set("tianhu/time", 0);
      return 1;
    }
  }
  quest = load_questnpc();
  if (!quest) {
    tell_object(me, HIY "天和道人隐隐的低声说道：看来你要去杀一个武功与你相当的“人”！！\n" NOR);
    if (!me->set("tianhu/killer"))
      me->set("tianhu/killer", me->query("PKS") + 1);
    return 1;
  } else {
    if (!objectp(glass = present("questtime", me))) {
      tell_object(me, "天和道人递给你一个任务时间器。\n");
      glass = new(__DIR__ "obj/queststone");
      glass->move(me);
    }
    me->set("possessed", this_object());
    timep = random(1200) + 2400;
    time_period(timep, me);
    tell_object(me, "替我杀了『" + quest["quest"] + "』。\n" NOR);
    me->set("thquest", quest);
    me->set("tianhu/time", (int)time() + (int)timep);
    if ((int)me->query_temp("tianhu/quest_num") < 5)
      me->add_temp("tianhu/quest_num", 1);
    return 1;
  }
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, HIW "天和道人说道：\n请在" + time + "内");
  return 1;
}

int accept_fight(object me) {
  command("say 你不是我的对手！不要自寻死路！");
  return 0;
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "流云派弟子");
    return;
  } else if (exp <= 64000) {
    student->set("title", "流云派小侠");     //
    return;
  } else if (exp <= 128000) {
    student->set("title", "流云派小侠");
    return;
  } else if (exp <= 256000) {
    student->set("title", "流云派少侠");  //
    return;
  } else if (exp <= 512000) {
    student->set("title", "流云派少侠");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "流云派大侠");  //
    return;
  } else if (exp <= 1536000) {
    student->set("title", "流云派大侠");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "流云派奇侠");  //
    return;
  } else if (exp <= 3456000) {
    student->set("title", "流云派奇侠");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "流云派小太师");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "流云派太师");
    return;
  } else
    student->set("title", "流云派元老");
  return;
}

void reset() {
  delete_temp("learned");
  set("apprentice_available", 2);
}

mapping load_questnpc() {
  mapping quest;
  object questnpc;
  mixed objfile;
  int i, j;
  string path = killerlist[random(sizeof(killerlist))];
  object me = this_player();
  objfile = get_dir(path);
  if (!sizeof(objfile)) {
    if (file_size(path) == -2) return quest;
    else return quest;
  }
  path = replace_string(path, "*.lpc", "");
  i = sizeof(objfile);
  for (j = 0; j < i; j++) {
    questnpc = find_object(path + objfile[random(i)]);
    if (!questnpc) questnpc = load_object(path + objfile[random(i)]);
    if (!questnpc) continue;
    if (!questnpc->is_character()) continue;
    break;
  }
  if (!questnpc || !questnpc->is_character()) return quest;
  quest = ([ "quest": questnpc->name(),
    "quest_type": "杀",
  ]);
  return quest;
}

int cancel_quest(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return 0;
  me->set("thquest", 0);
  me->set("tianhu/time", 0);
  me->set_temp("tianhu/quest_num", 0);
  me->add("tianhu/cel_quest", 1);
  tell_object(me, "天和道人说道：好吧，就算了吧．．\n");
  if ((int)me->query("tianhu/cel_quest") > 20) {
    tell_object(me, "天和道人皱眉道：你没有完成任务,太可惜了．．\n");
    if ((int)me->query("combat_exp") > 5000)
      me->add("combat_exp", -1000);
    me->set("kee", (int)me->query("eff_kee") / 2 + 1);
    me->set("tianhu/cel_quest", 0);
  }
  return 1;
}
