//long.c 龙步青 written by john darks
inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void use_yanyun();
void kill_target(string arg);
void auto_kill(string arg);
object offensive_target(object me);
void create() {
  set_name("龙步青", ({ "long buqing", "long", "master" }));
  set("title", "魔教“天玄坛”坛主");
  set("gender", "男性");
  set("age", 26);
  set("nickname", HIG "八手书生" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("combat_exp", 7800000);
  set("score", 20000);
  set_skill("literate", 180);
  set_skill("force", 180);
  set_skill("unarmed", 180);
  set_skill("sword", 180);
  set_skill("parry", 180);
  set_skill("dodge", 180);
  set_skill("wind_sword", 180);
  set_skill("huashu-steps", 180);
  set_skill("sanhua-strike", 180);
  set_skill("siri_force", 180);
  map_skill("sword", "wind_sword");
  map_skill("force", "siri_force");
  map_skill("parry", "wind_sword");
  map_skill("dodge", "huashu-steps");
  map_skill("unarmed", "sanhua-strike");
  create_family("魔教", 3, "坛主");
  set("class", "mojiao");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 1) {
    command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
    return;
  }
  if (ob->query("帮派") != "魔教") {
    command("say 你非本教弟子，我怎能收你为徒！\n");
    return;
  }
  if (ob->query("mojiao/弃子")) {
    command("say 你没有资格成为我的弟子！\n");
    return;
  }
  if (ob->query("mojiao/势力") != "教主系") {
    switch (ob->query("mojiao/势力")) {
      case "教主系":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见两大长老才对。");
        return;
        break;
      case "地撤坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见地撤坛主才对。");
        return;
        break;
      case "紫迷坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见紫迷坛主才对。");
        return;
        break;
      case "伏兽坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见伏兽坛主才对。");
        return;
        break;
    }
  }
  message_vision(CYN "龙步青说道：“好吧, 我就收下你了。”\n" NOR, ob);
  command("recruit " + ob->query("id"));
  ob->set("class", "mojiao");
  ob->set("id_type", 2);
  return;
}

void use_yanyun() {
  object *yanyun, guard;
  int i;
  object me = this_object();
  message_vision(HIR "\n$N" + HIR "大喝一声：燕云十三骑！！\n" NOR, me);
  yanyun = children(__DIR__ "yanyun");
  if (sizeof(yanyun)) {
    for (i = 0; i < sizeof(yanyun); i++)
      destruct(yanyun[i]);
  }
  for (i = 0; i < 12; i++) {
    guard = new(__DIR__ "yanyun");
    guard->getname(i);
    guard->set("possessed", me);
  }
  yanyun = children(__DIR__ "yanyun");
  if (!sizeof(yanyun))
    return notify_fail("没有燕云十三骑！\n");
  for (i = 0; i < sizeof(yanyun); i++) {
    yanyun[i]->move(environment(me));
    yanyun[i]->set_leader(me);
  }
  message_vision(HIW "一队铁骑应声而来！\n" NOR, me);
}

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}


void kill_target(string arg) {
  object ob, *yanyun;
  object me = this_object();
  int i;
  if (!arg) {
    ob = offensive_target(me);
    if (!ob
      || !ob->is_character()
      || ob->is_corpse()
      || ob == me)
      return notify_fail("你要射谁？\n");
  } else {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob || !environment(ob))
      return notify_fail("没有这个人。\n");
  }
  yanyun = children(__DIR__ "yanyun");
  if (!sizeof(yanyun))
    return notify_fail("没有燕云十三骑！\n");
  message_vision(HIW "\n$N" + HIW "大喝一声：命在我手不由天！！散开" + HIR "杀～～～" + HIW "！！\n\n" NOR, me);
  for (i = 0; i < sizeof(yanyun); i++) {
    yanyun[i]->set("to_killed", ob);
    yanyun[i]->move(environment(me));
  }
  message_vision(HIR "\n燕云十三骑应声四下穿梭散开！\n" NOR, me);
  remove_call_out("auto_kill");
  remove_call_out("remove_kill");
  call_out("auto_kill", 1, arg);
  call_out("remove_kill", 60, ob);
  return;
}

void auto_kill(string arg) {
  object ob, *yanyun;
  mapping exits;
  string *dirs, *thisdir;
  object me = this_object();
  int i, j, k;
  if (!arg) {
    ob = offensive_target(me);
    if (!ob
      || !ob->is_character()
      || ob->is_corpse()
      || ob == me)
      return notify_fail("你要射谁？\n");
  } else {
    ob = find_player(arg);
    if (!ob || ob->is_ghost()) ob = find_living(arg);
    if (!ob || !environment(ob))
      return notify_fail("没有这个人。\n");
  }
  yanyun = children(__DIR__ "yanyun");
  if (!sizeof(yanyun))
    return notify_fail("没有燕云十三骑！\n");
  for (i = 0; i < sizeof(yanyun); i++)
    yanyun[i]->move(environment(ob));
  message_vision("四处马蹄声不断，似有万马奔腾之势．．．只见无数铁骑来回穿梭。\n", ob);
  if (mapp(exits = environment(ob)->query("exits"))) {
    dirs = keys(exits);
    j = sizeof(dirs);
    while (j--) {
      if (dirs[j] == "east" || dirs[j] == "south" || dirs[j] == "west" || dirs[j] == "north") {
        if (sizeof(thisdir) == 0)
          thisdir = ({ dirs[j] });
        else
          thisdir += ({ dirs[j] });
      }
    }
    if (sizeof(thisdir))
      j = to_int(ceil(to_float(sizeof(yanyun)) / to_float(sizeof(thisdir))));
    for (i = 0; i < sizeof(thisdir); i++)
      for (k = 0; k < j; k++) {
        if (k * sizeof(thisdir) + i < 13) {
          yanyun[k * sizeof(thisdir) + i]->ccommand("go " + thisdir[i]);
          yanyun[k * sizeof(thisdir) + i]->ccommand("go " + thisdir[i]);
          yanyun[k * sizeof(thisdir) + i]->ccommand("go " + thisdir[i]);
        } else break;
      }
  }
  for (i = 0; i < sizeof(yanyun); i++)
    yanyun[i]->do_shoot(arg);
  remove_call_out("auto_kill");
  call_out("auto_kill", 3 + random(3), arg);
  return;
}

void remove_kill(object ob) {
  object *yanyun;
  mapping exits;
  string *dirs, *thisdir;
  object me = this_object();
  int i, j;
  if (userp(ob) && !me->is_fighting(ob)) {
    yanyun = children(__DIR__ "yanyun");
    if (!sizeof(yanyun))
      return notify_fail("没有燕云十三骑！\n");
    for (i = 0; i < sizeof(yanyun); i++)
      yanyun[i]->move(environment(me));
    remove_call_out("auto_kill");
    message_vision(HIR "\n$N" + HIR "突然长啸一声，燕云十三骑应声而来！\n" NOR, me);
  } else return;
}
