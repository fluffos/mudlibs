#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int performdodge();
void create() {
  set_name("姬如玉", ({ "ji ruyu", "ji", "master" }));
  set("title", "魔教“紫迷坛”坛主");
  set("gender", "女性");
  set("age", 36);
  set("nickname", HIM "玄裳仙子" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("per", 50);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("combat_exp", 7500000);
  set("score", 20000);
  set_skill("literate", 180);
  set_skill("force", 180);
  set_skill("whip", 180);
  set_skill("parry", 180);
  set_skill("dodge", 180);
  set_skill("music", 180);
  set_skill("huangsha-whip", 100);
  set_skill("stormdance", 100);
  set_skill("senluo-force", 150);
  map_skill("whip", "huangsha-whip");
  map_skill("force", "senluo-force");
  map_skill("parry", "huangsha-whip");
  map_skill("dodge", "stormdance");
  create_family("魔教", 3, "坛主");
  set("class", "mojiao");
  set("mojiao/势力", "紫迷坛");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: performdodge :),
    (: perform_action, "whip.fengshamangmang" :),
    (: perform_action, "whip.fengshamangmang" :),
  }));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 1) {
    command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
    return;
  }
  if (ob->query("帮派") != "魔教") {
    command("say 你非本教弟子，我怎能收你为徒！\n");
    return;
  }
  if (ob->query("mojiao/弃子")) {
    command("say 你没有资格成为我的弟子！\n");
    return;
  }
  if (ob->query("mojiao/势力") != "紫迷坛") {
    switch (ob->query("mojiao/势力")) {
      case "教主系":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见两大长老才对。");
        return;
        break;
      case "地撤坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见地撤坛主才对。");
        return;
        break;
      case "天玄坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见天玄坛主才对。");
        return;
        break;
      case "伏兽坛":
        command("say " + RANK_D->query_respect(ob) + "好像应该去见见伏兽坛主才对。");
        return;
        break;
    }
  }
  message_vision(CYN "姬如玉说道：“好吧, 我就收下你了。”\n" NOR, ob);
  command("recruit " + ob->query("id"));
  ob->set("class", "mojiao");
  ob->set("id_type", 2);
  return;
}

int performdodge() {
  exert_function("yihuajiemu");
  perform_action("dodge.huashudieying");
  return 1;
}
