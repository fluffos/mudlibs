//qimeng4.c written by john darks
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "后院");
  set("long", @LONG
一个小小的厅落，种栽着花树，地上铺着厚厚的树叶。显然很少有人
来到这里。后院门前堆满了石块，中间的一块特别大，挡住了出口。
LONG
  );
  set("exits", ([
    "south": __DIR__ "qimeng4",
  ]));
  set("objects", ([
    __DIR__ "npc/hongmian": 1,
  ]));
  set("item_desc", ([
    "stone": "这块石头挡住了出路，看来只有挪开(move)它了。\n",
    "石块": "这块石头挡住了出路，看来只有挪开(move)它了。\n",
  ]));
  set("outdoors", "tianzhu");
  setup();

}

void init() {
  if (interactive(this_player())) {
    remove_call_out("dropleaf");
    call_out("dropleaf", random(10) + 10, this_player());
  }
  add_action("do_move", "move");
}

void dropleaf(object me) {
  object leaf;
  if (me)
    if (environment(me) == this_object()) {
      tell_object(me, "一片树叶随风飘下．．．．\n");
      leaf = present("leaf", this_object());
      if (objectp(leaf))
        leaf->add_amount(1);
      else {
        leaf = new(__DIR__ "obj/leaf");
        leaf->move(this_object());
      }
      call_out("dropleaf", random(10) + 10, me);
    }
}

int do_move(string arg) {
  int exp, pot;
  object me = this_player();
  object ob = this_object();
  object girl = present("hong mian", ob);
  if (!arg || (arg != "stone" && arg != "石块"))
    return 0;
  if (!girl) {
    if (!me->query("mojiao/movestone")) {
      message_vision("$N用力挪了挪石块,石块却纹丝不动！\n", me);
      me->set("force", 0);
      return 1;
    }
    message_vision("$N用力挪开了石块！\n", me);
    ob->add("exits", ([ "north": __DIR__ "songlin3" ]));
    me->set("force", 0);
    tell_object(me, HIY "你的眼前视野突然开阔，已置身于一片松林之前！\n" NOR);
    if (!me->query("mojiao/迷魂大阵")) {
      me->set("mojiao/迷魂大阵", 1);
      me->add("score", 1000);
      exp = (int)to_int(pow((int)me->query("combat_exp"), 0.5));
      exp = (int)(exp + random((int)exp));
      pot = (int)(exp / 3);
      me->add("combat_exp", exp);
      me->add("potential", pot);
      tell_object(me, HIY "恭喜你突破了魔教迷魂大阵，你感觉信心大增！\n" + HIW "你被奖励了：\n" +
        chinese_number(exp) + "点实战经验\n" +
        chinese_number(pot) + "点潜能\n" NOR);
    }
  } else {
    message_vision(HIR "$N" + HIR "用力的想挪开石块，红棉突然向$N" + HIR "展开了攻击！\n" NOR, me);
    if ((int)me->query("force") > 1000)
      me->add("force", -1000);
    else me->set("force", 0);
    me->receive_damage("kee", 200, ob);
    COMBAT_D->report_status(me);
    girl->kill_ob(me);
    me->kill_ob(girl);
    message_vision(CYN "$N冷笑道：你留下来陪绮梦姑娘吧！\n" NOR, girl);
  }
  return 1;
}

void reset() {
  set("exits", ([
    "south": __DIR__ "qimeng4",
  ]));
  ::reset();
}
