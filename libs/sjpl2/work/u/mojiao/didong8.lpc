//didong-1.c written by john darks
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "地狱洞深处");
  set("long", @LONG
风声到这里突然小了，但在阴森幽暗之中，恐怖与杀机更浓了。
LONG
  );
  set("exits", ([
    "east": __DIR__ "didong9",
    "north": __DIR__ "didong7",
    "south": __DIR__ "didong7",
    "west": __DIR__ "didong9",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  if (interactive(this_player())) {
    remove_call_out("attacking");
    call_out("attacking", random(5) + 1, this_player());
  }
  add_action("do_look", ({ "l", "look" }));
  add_action("do_nothing", ({ "chat", "chat*", "tell" }));
  add_action("do_id", "id");
  add_action("do_go", "go");
}

int do_look() {
  string msg;
  object me = this_player();
  object room = environment(me);
  msg = room->query("short") + " - ";
  msg += wizardp(me) ? file_name(room) : "";
  write(msg + "\n    这里阴森幽暗，伸手不见五指，静寂中你隐隐约约可以听到黑暗中传来\n的喘息声。\n");
  return 1;
}

int do_nothing(string arg) {
  object me = this_player();
  write("你大声的叫道：" + arg + "～～～\n");
  message("vision", "你突然听到有人大叫道：" + arg + "～～～\n", environment(me), me);
  message_vision("不久，在洞穴深处也传来一个人的呼声：" + arg + "～～～\n", me);
  return 1;
}

int do_id(string arg) {
  if (arg == "here") {
    if (this_player()->query_skill("perception") > 150)
      return 0;
    else {
      write("这里伸手不见五指，什么也看不到，只有满耳的风声！\n");
      return 1;
    }
  }
}

int attacking(object ob) {
  int damage;
  object killer;
  string attack_msg;
  if (ob && environment(ob) == this_object()) {
    switch (random(3)) {
      case 0:
        attack_msg = HIR "\n黑暗中忽然似乎某个地方亮了亮，掌风剑气一起向" + ob->name() + HIR "袭来！！\n" NOR;
        break;
      case 1:
        attack_msg = HIR "\n黑暗中忽然似乎某个地方亮了亮，拳影刀风一起向" + ob->name() + HIR "袭来！！\n" NOR;
        break;
      case 2:
        attack_msg = HIR "\n黑暗中忽然似乎某个地方亮了亮，枪棍暗器一起向" + ob->name() + HIR "袭来！！\n" NOR;
        break;
    }
    killer = new(__DIR__ "npc/killer");
    killer->set("combat_exp", 100000 * random(20));
    killer->set_temp("apply/damage", 30 * random(20));
    killer->move(this_object());
    COMBAT_D->do_attack(killer, ob, killer->query_temp("weapon"), 0, attack_msg, "瘀伤");
    if (ob->query_skill("perception") > 150) {
      killer->set("combat_exp", (int)ob->query("combat_exp") + 500000);
      killer->set_temp("apply/damage", 100);
      killer->fight_ob(ob);
      ob->add_temp("mojiao/passing", 1);
      if ((int)ob->query_temp("mojiao/passing") < 4)
        call_out("attacking", 1 + random(2), ob);
    } else {
      destruct(killer);
      call_out("attacking", 1 + random(2), ob);
    }
  } else return 1;
}

void reset() {
  ::reset();
  remove_call_out("attacking");
}

int do_go() {
  object room, me;
  int exp, pot;
  me = this_player();
  me->delete_temp("mojiao/passing");
  remove_call_out("attacking");
  if (userp(me) && me->query_temp("mojiao/pass") > 5) {
    me->set_temp("wangsha/wfrom", "south");
    room = find_object(__DIR__ "didong3");
    if (!room) room = load_object(__DIR__ "didong3");
    me->move(room);
    me->set_temp("wangsha/wfrom", "south");
    message("vision", me->name() + "走了过来。\n", environment(me), me);
    me->delete_temp("mojiao/pass");
    tell_object(me, HIY "你的眼前突然一亮，居然来到了洞口！\n" NOR);
    if (!me->query("mojiao/地撤大阵")) {
      me->set("mojiao/地撤大阵", 1);
      me->add("score", 1000);
      exp = (int)to_int(pow((int)me->query("combat_exp"), 0.5));
      exp = (int)(exp + random((int)exp));
      pot = (int)(exp / 3);
      me->add("combat_exp", exp);
      me->add("potential", pot);
      tell_object(me, HIY "恭喜你突破魔教地撤大阵，你感觉信心大增！\n" + HIW "你被奖励了：\n" +
        chinese_number(exp) + "点实战经验\n" +
        chinese_number(pot) + "点潜能\n" NOR);
    }
    return 1;
  }
  me->add_temp("mojiao/unpass", 1);
  if (userp(me) && me->query_temp("mojiao/unpass") > 5 && random(2)) {
    me->set_temp("wangsha/wfrom", "north");
    room = find_object(__DIR__ "didong3");
    if (!room) room = load_object(__DIR__ "didong3");
    me->move(room);
    me->set_temp("wangsha/wfrom", "north");
    message("vision", me->name() + "走了过来。\n", environment(me), me);
    tell_object(me, HIY "你的眼前突然一亮，居然来到了洞口！\n" NOR);
    me->delete_temp("mojiao/unpass");
    return 1;
  } else {
    me->set_temp("wangsha/wfrom", "north");
    room = find_object(__DIR__ "didong1");
    if (!room) room = load_object(__DIR__ "didong1");
    me->move(room);
    me->set_temp("wangsha/wfrom", "north");
    message("vision", me->name() + "走了过来。\n", environment(me), me);
    tell_object(me, HIY "你的眼前突然一亮，居然来到了洞口！\n" NOR);
    me->delete_temp("mojiao/unpass");
    return 1;
  }
  return 0;
}
