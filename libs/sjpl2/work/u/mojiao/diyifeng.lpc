#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "天下第一峰");
  set("long", @LONG
这里很少有游人前来，因此山势险恶，且无什么绝妙的景色。山顶怪
石林立，杂草丛生，丝毫不见有人的迹象。唯一奇特的是一屏石碑，上面
以狂书写了五个大字“天下第一峰”，字体若游龙，似飞凤，别有一番风
景。
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "feiyun.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/laodao": 1,
  ]));
  setup();
  replace_program(ROOM);
}
