#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "渡仙桥");
  set("long", @LONG
山路曲曲弯弯的折到了山崖边。一道瀑布从上而下冲了下来。山崖间
用了两条铁链连接了起来。那铁链有胳膊粗细，两条铁链之间用了几个细
些的铁链连了起来。瀑布在这铁桥旁边呼啸，要是常人，别说是过，就是
在这桥边站上一会儿恐怕也要昏了过去。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "west": __DIR__ "tianchi",
    "eastdown": __DIR__ "qianzhang",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
}
