inherit ROOM;
void create() {
  set("short", "麒麟岩");
  set("long", @LONG
此处乃是麒麟岩，在一个宽约三十丈的广场中心，被人堆砌了一个
黑色的石头坛，坛角立着八个黑色石柱。柱子上刻着一个巨大的图腾，
好像是个很抽象的动物的图案。图腾的底部刻满了密密麻麻的字。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "north": __DIR__ "shenmigu",
    "southdown": __DIR__ "shanlu1",
  ]));
  set("objects", ([
    __DIR__ "npc/tianhu": 1,
    __DIR__ "obj/tianhu_stone": 1,
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_sleep", 1);
  set("no_clean_up", 0);
  setup();
  call_other(__DIR__ "obj/board/tianhu_b", "???");
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "north") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}

void init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me = this_player();
  if (me->query_skill("bamohuantian", 1) < 20) {
    write("你的八魔环天大法等级不够，没法研读此功。\n");
    return 1;
  }
  return 0;
}
