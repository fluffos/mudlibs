//bedroom.c written by john darks
#include <ansi.h>
inherit ROOM;
void fulldown(object me);
void create() {
  set("short", "迷魂春帐");
  set("long", @LONG
这是卧室，轻罗帐，绿牙床，屋中陈设不多，但全部恰到好处，正中
的桌上一个青瓷官窑花瓶中错落有致的插着几束刚刚采来得野花，为屋子
凭添了一丝淡淡的清香，满是春意。
LONG
  );
  set("exits", ([
    "west": __DIR__ "bedroom",
  ]));
  set("objects", ([
    __DIR__ "npc/prettygirl": 1,
  ]));
  setup();
}

void fulldown(object me) {
  object room, girl;
  if (!objectp(room = find_object(__DIR__ "bedroom2")))
    room = load_object(__DIR__ "bedroom2");
  me->move(room);
  message("vision", me->name() + "被人抬了过来。\n", room, me);
}

void init() {
  add_action("do_enjoy", "enjoy");
}

int do_enjoy() {
  object me, girl;
  object *inv;
  int maxgin, maxkee, maxsen;
  int i;
  me = this_player();
  girl = present("tianhua", this_object());
  message_vision(CYN "$N轻轻的向$n靠了过来，温柔的抚弄$n的黑发．．．\n" NOR, girl, me);
  me->unconcious();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  maxgin = (int)me->query("max_gin");
  maxkee = (int)me->query("max_kee");
  maxsen = (int)me->query("max_sen");
  me->set("eff_gin", maxgin);
  me->set("gin", maxgin);
  me->set("eff_kee", maxkee);
  me->set("kee", maxkee);
  me->set("eff_sen", maxsen);
  me->set("sen", maxsen);
  fulldown(me);
  return 1;
}
