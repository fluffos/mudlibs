//shanroad2.c written by john darks
inherit ROOM;
void create() {
  set("short", "山路");
  set("long", @LONG
山路随着山势延伸，山峰中古木参差，山风中隐隐约约传来虎啸猿啼。
在山路旁边立着一根三丈长的红木大旗，上面一个丈宽大旗被山风吹得呼
呼作响。此旗乃是黑底，却不见上面绣有一字。真是奇怪的很。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northup": __DIR__ "shanroad3",
    "southdown": __DIR__ "shanroad1",
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northup") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
