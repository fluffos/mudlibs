#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "天柱峰");
  set("long", @LONG
青石路蜿蜒曲折的向着上面延伸着。四周的景色变化，是那么迷人。
让人永远都看不够似的。山中多泉，石头缝儿里都透着水意。掬一捧入口
，那么甘甜。再往上走，就可以看到天池了。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "westdown": __DIR__ "shanlu3",
    "eastup": __DIR__ "tianchi",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
}
