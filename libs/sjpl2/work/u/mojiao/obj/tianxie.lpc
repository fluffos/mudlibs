// tianxie.c written by john darks
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "魔教天邪令" NOR, ({ "tianxie" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long",
      "魔教信物\n");
    set("value", 0);
    //set("no_drop",1);
    set("material", "stone");
  }
}

void init() {
  add_action("do_talk", "mojiao");
}

int do_talk(string arg) {
  object *ob, *target;
  int i;
  string mebang, obbang, outarg;
  object me = this_player();
  if (me->query("chblk_on"))
    return notify_fail("你的频道被关了！\n");
  mebang = (string)me->query("marks/帮派");
  if (!mebang) return notify_fail("你不属于任何帮派！\n");
  ob = users();
  i = sizeof(ob);
  while (i--) {
    obbang = (string)ob[i]->query("marks/帮派");
    if ((mebang == obbang) && !ob[i]->query("env/mojiao")) {
      if (sizeof(target) == 0)
        target = ({ ob[i] });
      else
        target += ({ ob[i] });
    }
  }
  if (!stringp(outarg = arg))
    outarg = "．．．．．";
  message("vision", HIW "【" + mebang + "】" +
    me->query("name") + "(" + capitalize(me->query("id")) + ")" +
    "：" + outarg + "\n" NOR, target);
  return 1;
}
