#include <weapon.h>
inherit THROWING;
void create() {
  set_name("一片枫树叶", ({ "maple leaf", "leaf" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "张");
    set("base_weight", 1);
    set("base_value", 1);
  }
  set_amount(1);
  init_throwing(2 + (int)this_player()->query("force") / 50);
  setup();
}
