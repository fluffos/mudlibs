#include <ansi.h>
inherit ITEM;
void create() {
  set_name("七指煞君的骸骨", ({ "skeleton", "骸骨" }));
  set_weight(500000);
  set_max_encumbrance(800000);
  set("no_get", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "具");
    set("long", "七指煞君本为魔教副教主，但如今他已经死了。
看起来，这副骸骨已经躺在这里很久了。\n");
  }
  setup();
}

int is_container() { return 1; }
