//inriver.c written by john darks
#include <ansi.h> 
inherit ROOM;
void create()
{
        set("short", "激流中");
        set("long", @LONG
这里是激流的中央，河流不但比你想象中的要深，也比你想象中的湍
急。水面波涛起伏与日光辉映，发出鱼鳞般的光芒。但混浊中却有一股杀
气。
LONG
        );
	set("outdoors","tianzhu");
        set("objects", ([
                __DIR__"npc/eyu" :3,
                        ]) );
	setup();
}

void init()
{
	if(interactive(this_player()))
	call_out("do_flush",5,this_player());
}

void do_flush(object me)
{
	object room;
        if(!me || environment(me) != this_object())
                return;
	tell_object(me,BLU"一阵暗流涌来，你被冲往河下游．．\n"NOR);
	if (!objectp(room = find_object(__DIR__"lowriver")))
		room = load_object(__DIR__"lowriver");
	me->move(room);
	message("vision",me->name()+"被激流冲了过来。\n",room,me);
}	
