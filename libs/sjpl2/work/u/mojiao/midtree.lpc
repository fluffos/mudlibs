//midtree.c written by john darks
#include <ansi.h>
#include <login.h>
inherit ROOM;
void create() {
  set("short", "树枝上");
  set("long", @LONG
四周烟云弥漫，透着一种神秘的气息！一棵寒松自悬崖边伸出，欢迎
着来自其他地方的陌生人。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "east": __DIR__ "hole1",
  ]));
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object corpse;
  object me = this_player();
  if (!arg) return 0;
  if (arg == "down") {
    message_vision("$N小心翼翼的往下爬去。\n", me);
    me->move(__DIR__ "yadi");
    message("vision", me->name() + "小心翼翼的爬了下来。\n", environment(me), me);
    return 1;
  } else {
    message_vision("$N小心翼翼沿着山崖爬去，突然脚下一滑，大叫一声，掉了下去。\n", me);
    me->move(__DIR__ "yadi");
    tell_object(me, HIR "你从空中重重的落了下去．．．．\n" NOR);
    message("vision", me->name() + "从上面直掉了下来，啪的一声摔在了地上．．．．\n", environment(me), me);
    if (random(me->query_kar() + 10) < 20) {
      //me->clear_condition();
      message_vision("\n$N死了。\n\n", me);
      CHANNEL_D->do_channel(this_object(), "rumor", me->name(1) + "在天柱山摔死了！\n");
      if (objectp(corpse = CHAR_D->make_corpse(me, me)))
        corpse->move(__DIR__ "yadi");
      me->remove_all_killer();
      me->dismiss_team();
      if (userp(me)) {
        me->set("gin", 1); me->set("eff_gin", 1);
        me->set("kee", 1); me->set("eff_kee", 1);
        me->set("sen", 1); me->set("eff_sen", 1);
        me->be_ghost(1);
        me->save();
        me->move(DEATH_ROOM);
        DEATH_ROOM->start_death(me);
      } else destruct(me);
    } else me->unconcious();
    return 1;
  }
}
