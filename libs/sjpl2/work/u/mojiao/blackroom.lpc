//blackroom.c , written by John Darks
inherit ROOM;
void create() {

  set("short", "昏暗的小屋");
  set("long", @LONG
一间昏暗的小屋，在屋的上首供着一尊土地像。地上铺着干草，在
屋的一角，放着一只小箱子。就像在其他地方常见到的武庙文庙的摆设
一般。不过这里似乎人迹罕至，到处都挂满了蜘蛛网，只是门槛是被磨
光滑的，箱子是没有灰尘的。每当狂风吹过，整个屋子都在摇晃，似乎
马上就会倒塌下来。一支残烛在风中摇曳，忽明忽暗，鬼气森森。
LONG);
  set("exits", ([
    "east": __DIR__ "tianshi",
  ]));
  set("objects", ([
    __DIR__ "npc/killermaster": 1,

  ]));
  set("item_desc", ([
    "box": "这个功德箱开口很窄，正好可扔下一张纸(throw)。\n",
    "小箱子": "这个功德箱开口很窄，正好可扔下一张纸(throw)。\n",
    "功德箱": "这个功德箱开口很窄，正好可扔下一张纸(throw)。\n",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_throw", "throw");
}

int do_throw(string arg) {
  object *inv;
  object me, ob;
  object paper;
  string target, targetname;
  int targetprice, i;
  mapping *killer;
  if (!arg) return notify_fail("你要放什么入功德箱？\n");
  ob = present("old man", this_object());
  if (arg != "youzhi" && arg != "又皱又油的纸")
    return notify_fail("你不可把" + arg + "放入功德箱．\n");
  me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("name")) == "又皱又油的纸") {
      paper = inv[i];
      break;
    }
  }
  if (!paper) return notify_fail("你身上没有又皱又油的纸．\n");
  if (!stringp(paper->query("targetid")))
    return notify_fail("你的纸上没写字(print)．\n");
  if ((int)ob->query("killernum") > 100)
    return notify_fail("看上去箱子似乎已被塞满了。\n");
  me->start_busy(2);

  target = (string)paper->query("targetid");
  targetprice = (int)paper->query("targetprice");
  targetname = (string)paper->query("targetname");
  destruct(paper);
  ob->add("killernum", 1);
  message_vision("$N阴笑一声，面目阴陈的把纸放入功德箱里．\n", me);
  log_file("KILLER_LOG", sprintf("(%s)%s雇了杀手杀%s\n",
    ctime(time()),
    me->query("id"),
    target));
  message_vision("一阵阴风掠过，$N不禁打了个冷战．\n", me);
  killer = ob->query("killer");
  if (sizeof(killer) == 0)
    killer = ({ ([ "killer": me->query("id"),
      "ownername": me->name(),
      "targetid": target,
      "targetprice": targetprice,
      "targetname": targetname,
      "time": NATURE_D->game_time(),
    ]) });
  else killer += ({ ([ "killer": me->query("id"),
    "ownername": me->name(),
    "targetid": target,
    "targetprice": targetprice,
    "targetname": targetname,
    "time": NATURE_D->game_time(),
  ]) });
  ob->set("killer", killer);
  return 1;
}
