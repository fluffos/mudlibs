//luwei2.c written by john darks
inherit ROOM;
void create() {
  set("short", "瀑布");
  set("long", @LONG
这里是一个谷地，一道瀑布之崖上飞泻而下，在谷中央形成一个水潭。
这里谷地开阔，辽阔的山景极为壮丽。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "southwest": __DIR__ "downriver",
  ]));
  set("resource/water", 1);
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "southwest") {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    }
  return 1;
}
