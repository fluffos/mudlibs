inherit ROOM;
void create() {
  set("short", "石像林");
  set("long", @LONG
	只见那群山嶙峋峭绝，苍翠环抱之中，出现了一片奇异的石林。林
中怪石罗列，巧石逼真，或散或立，极其精致。著名的有“天柱石”、
“天笋石”、“猎头石”、“鹦哥石”，状狮虎龙猿，肖花鸟虫鱼，乃
“天然雕饰”，且变化无穷。
LONG
  );
  set("exits", ([
    "north": __DIR__ "zhulin1",
    "south": __DIR__ "tianxuantan",
  ]));
  set("outdoors", "tianzhu");
  setup();
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(3)) {
    this_player()->move(this_object());
    return 1;
  }
}
