#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "紫竹林");
  set("long", @LONG
在这茂密的竹林里，你走来走去的，突然发现自己迷失了方向。真是
好奇怪的一种感觉。你总是觉得在这林中好像在哪里有一双眼睛注视着你。
四周的竹叶在你的眼前晃来晃去，你都觉得要醉了。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "west": __DIR__ "dichetan",
    "southeast": __DIR__ "zimitan",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(3)) {
    this_player()->move(this_object());
    return 1;
  }
}
