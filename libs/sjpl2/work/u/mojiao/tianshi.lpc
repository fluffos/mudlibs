//tianshi.c written by john darks
inherit ROOM;
void create() {
  set("short", "天狮峰");
  set("long", @LONG
山路在这里变得开阔了些，不知道什么时候，山雾已经环绕在你的身
边，把周围变得也有些朦胧了。这里是一个小山峰，在峰旁有一块儿山石，
也不知道是什么时候从山上滚下来的。仿佛一头卧狮在山边休息。难怪当
地人称此峰叫天狮峰。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northwest": __DIR__ "gudong1",
    "southeast": __DIR__ "shanroad3",
    "west": __DIR__ "blackroom",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi2000": 4,
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob, room;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
山路在这里变得开阔了些，不知道什么时候，山雾已经环绕在你的身
边，把周围变得也有些朦胧了。这里是一个小山峰，在峰旁有一块儿山石，
也不知道是什么时候从山上滚下来的。仿佛一头卧狮在山边休息。难怪当
地人称此峰叫天狮峰。
LONG);
  } else {
    set("long", @LONG
自石洞过来，山路在这里变得开阔了些，山雾环绕在你的身边，把周
围变得也有些朦胧了。这里是一个小山峰，在峰旁有一块儿山石，仿佛一
头卧狮在山边休息。是谓天狮峰。
LONG);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northwest") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
