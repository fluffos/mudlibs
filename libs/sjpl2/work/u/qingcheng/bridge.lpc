inherit ROOM;

void create() {
  set("short", "接仙桥");
  set("long", @LONG
你面前出现了一座石桥，桥下溪水淙淙，桥的两边石栏上生满了青
苔。相传汉代张道陵在此处接元始天尊下凡，经三清点化而创建道教，
从此青城山成为道教发源地之一，接仙桥之名也由此得来。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "shanroad3",
    "southwest": __DIR__ "xiaolu22",
  ]));
  set("objects", ([
    __DIR__ "npc/yude": 1,
  ]));
  set("outdoors", "qingcheng");
  setup();
}
