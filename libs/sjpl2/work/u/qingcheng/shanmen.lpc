inherit ROOM;

void create() {
  set("short", "山门");
  set("long", @LONG
这是青城山的山门。山门并不高，却很宽阔，两边门柱以松纹石雕
而成，好似一对葱翠挺拔的苍松。山门上方悬挂着一块石匾，上书“青
城山”三个大字，苍劲有力。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "shanroad2",
    "westup": __DIR__ "shanroad3",
  ]));
  set("objects", ([
    __DIR__ "npc/ding": 1,
  ]));
  set("outdoors", "qingcheng");
  setup();
}
