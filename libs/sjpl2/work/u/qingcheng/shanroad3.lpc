inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你正走在青城山的山路上。青城山是川中四大名山之一，方圆二百
四十余里，山上终年常绿，岁寒不凋，诸峰环绕，壮若城郭，故名青城
山。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "shanmen",
    "westup": __DIR__ "bridge",
  ]));
  set("outdoors", "qingcheng");
  setup();
}
