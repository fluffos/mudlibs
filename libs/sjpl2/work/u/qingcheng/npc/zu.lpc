inherit NPC;
inherit F_MASTER;

void create() {
  set_name("祖冲迟", ({ "zuchong chi", "chi", "master" }));
  set("gender", "男性");
  set("nickname", "涵养剑");
  set("age", 50);
  set("long",
    "祖冲迟是铁肩道人的二弟子，为人谦逊，很有涵养。\n");
  set("inquiry", ([
    "here": "这里就是青城派。",
  ]));
  set("attitude", "peaceful");
  set("class", "qingcheng");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 3000000);
  set("score", 30000);

  set_skill("dodge", 160);
  set_skill("move", 160);
  set_skill("literate", 170);
  set_skill("parry", 170);
  set_skill("unarmed", 130);
  set_skill("force", 150);
  set_skill("sword", 140);

  set_skill("rain_sword", 140);
  set_skill("rain_strike", 130);
  set_skill("siri_force", 150);
  set_skill("five-steps", 160);
  set_skill("dormancy", 160);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));
  create_family("青城派", 5, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "qingcheng") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("siri_force", 1) < 100) {
    command("say 你的本门内功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("five-steps", 1) < 100) {
    command("say 你的本门轻功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}
