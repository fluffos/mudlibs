#include <ansi.h>
inherit NPC;
int about_quest();
string *names = ({
  "兽骨甲",
  "金环锁子甲",
  "牛皮盾",
  "狼皮裙",
  "藤甲",
  "铁甲",
  "熟铜甲",
  "亮银甲",
});

void create() {
  set_name("游仙羽士", ({ "youxian yushi", "yushi", "youxian" }));
  set("long",
    "这是一个六十多岁的老人, 精神矍铄，神态安详。\n" +
    "他是青城派宿老，久已不问江湖事务。你可以向他申请任务\n");
  set("title", "青城异人");
  set("gender", "男性");
  set("age", 64);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("kee", 9000);
  set("gin", 9000);
  set("sen", 9000);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set("mana", 2000);
  set("max_mana", 2000);

  set("inquiry", ([
    "quest": (: about_quest :),
  ]));

  set("combat_exp", 7000000);
  set("score", 20000);

  set_skill("dodge", 190);
  set_skill("move", 190);
  set_skill("literate", 200);
  set_skill("parry", 190);
  set_skill("unarmed", 190);
  set_skill("force", 190);
  set_skill("sword", 200);
  set_skill("dormancy", 200);

  set_skill("rain_sword", 200);
  set_skill("rain_strike", 190);
  set_skill("siri_force", 190);
  set_skill("five-steps", 180);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}

void init() {
  add_action("do_cancel", "cancel");
}

int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  if (!me->query("marks/qcjob"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "游仙羽士叹道：不想做了吗？好吧，你自己反省一下。\n" NOR);
  if ((int)me->query("combat_exp") <= 100) {
    me->delete("marks/qcjob");
    me->unconcious();
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->delete("marks/qcjob");
  me->unconcious();
  return 1;
}

int about_quest() {
  int task;
  object me = this_player();
  string questname = names[random(sizeof(names))];
  if (random(9) < 5 && !me->query("marks/qcjob")) {
    command("say 你去山腰的竹林砍些竹子来给我，弟子们正需要用来做竹刀竹剑。");
    me->set("marks/qcjob", "bamboo");
    me->set_temp("workobj_name", "bamboo");
    return 1;
  }
  if (!me->query("marks/qcjob")) {
    say(CYN "游仙羽士说道：我想要［" + questname + "］，你去给我找来。\n" NOR);
    me->set("marks/qcjob", questname);
    return 1;
  } else {
    command("say 你还站在这里干什么？好好用功才是啊！");
    return 1;
  }
  return 1;
}

int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (ob->name() == (string)me->query("marks/qcjob")
    || (ob->query("id") == (string)me->query_temp("workobj_name") && ob->query("objattrib"))) {
    say(CYN "游仙羽士微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(50) + 30);
    me->set("potential", (int)pot + random(30) + 20);
    me->add("score", random(10));
    me->add("life_exp", random(20));
    if (me->query("marks/qcjob"))
      me->delete("marks/qcjob");
    if (me->query_temp("workobj_name"))
      me->delete_temp("workobj_name");
    return 1;
  } else {
    say(CYN "游仙羽士说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
int accept_fight(object me) {
  return 0;
}
