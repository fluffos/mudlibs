#include <ansi.h>

inherit NPC;
void create() {

  set_name("青城弟子", ({ "qingcheng dizi", "dizi" }));
  set("long", "这是一位青城弟子，专门担任保护之责。\n");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("str", 40);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 90000);
  set_skill("sword", 90);
  set_skill("parry", 90);
  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("force", 90);

  set_skill("rain_sword", 50);
  set_skill("rain_strike", 50);
  set_skill("siri_force", 50);
  set_skill("five-steps", 50);
  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  destruct(this_object());
}
