inherit NPC;
inherit F_MASTER;

void create() {
  set_name("庄天霖", ({ "zhuang tianlin", "zhuang" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "庄天霖是祖冲迟的弟子，是六代弟子中掌法最高的。\n");
  set("inquiry", ([
    "here": "这里就是青城派。",
  ]));
  set("attitude", "peaceful");
  set("class", "qingcheng");
  set("max_kee", 1600);
  set("max_gin", 1600);
  set("max_sen", 1600);
  set("kee", 1600);
  set("gin", 1600);
  set("sen", 1600);

  set("force", 1600);
  set("max_force", 1600);
  set("force_factor", 30);

  set("combat_exp", 900000);
  set("score", 10000);

  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("literate", 90);
  set_skill("parry", 110);
  set_skill("unarmed", 130);
  set_skill("force", 80);
  set_skill("sword", 70);

  set_skill("rain_sword", 70);
  set_skill("rain_strike", 130);
  set_skill("siri_force", 80);
  set_skill("five-steps", 100);
  set_skill("dormancy", 80);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.baoyu" :),
  }));
  create_family("青城派", 6, "弟子");

  setup();

  //        carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "qingcheng") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("rain_strike", 1) < 80) {
    command("say 你的本门掌法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}
