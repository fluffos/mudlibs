inherit ROOM;
mapping *placelist = ({
  ([ "name": "大门",
    "place": __DIR__ "gate.lpc"
  ]),
});

void create() {
  set("short", "三楼");
  set("long", @LONG
这是三楼，在这里你可以清楚的看到山庄大门的情形。山庄有专人
在这里负责监视大门发生的事情。你可以look 大门。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "lou2",
  ]));

  setup();
}

void init() {
  add_action("do_lookout", "look");
}

int do_lookout(string arg) {
  int i;
  string place;
  object room;
  object me = this_player();
  if (!arg) return 0;
  for (i = 0; i < sizeof(placelist); i++) {
    if (arg != placelist[i]["name"]) continue;
    else {
      place = placelist[i]["place"];
      break;
    }
  }
  if (!place) return 0;
  room = find_object(place);
  if (!room) room = load_object(place);
  if (!room) return 0;
  "cmds/std/look"->look_room(me, room);
  return 1;
}
