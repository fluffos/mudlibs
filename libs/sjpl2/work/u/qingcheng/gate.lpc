// Room: /u/qingcheng/gate.c written by john darks

inherit ROOM;

void create() {
  set("short", "无量山庄大门");
  set("long", @LONG
你抬头一看，不禁惊呆了。这里竟然是传说中的神秘的无量山庄?
你捏捏自己的耳朵，才相信自己不是做梦。你抬腿就想进去，可是
仔细一想，又有些迟疑，进去了会发生什么？
LONG
  );
  set("no_fight", 1);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/men": 2,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "qiaobi1",
    "west": __DIR__ "ro1",
  ]));
  set("no_clean_up", 0);
  set("no_magic", 1);

  setup();
}

void init() {
  if (this_player())
    tell_room(__DIR__ "lou3", this_player()->name() + "走到了大门。\n");
}

int valid_leave(object me, string dir) {
  tell_room(__DIR__ "lou3", "大门的" + me->name() + "往" + to_chinese(dir) + "离开了。\n");
  return 1;
}
