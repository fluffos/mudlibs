// master.c 华山掌门
#include <ansi.h>

inherit NPC;

void create() {
  set_name("莫天雄", ({ "master mo", "master", "mo" }));
  set("long", @LONG
他就是华山派的现任掌门人，江湖上人称“夺命剑”的莫天雄。他看上去
是个和善的中年人，对人总是彬彬有礼，但是武林中谁都知道，他如果一
出手，却象换了一个人，招招狠毒！
LONG
  );
  set("gender", "男性");
  set("age", 52);
  set("attitude", "peaceful");
  set("int", 25);
  set("cor", 25);
  set("agi", 26);
  set("con", 24);
  set("str", 22);
  set("tol", 30);
  set("spi", 23);
  set("dur", 18);
  set("per", 26);
  set("fle", 23);
  set("cps", 21);
  set("max_force", 3000);
  set("force", 5000);
  set("force_factor", 100);
  set("combat_exp", 3000000);
  set("score", 80000);
  //	set("daode", 49900);

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: perform_action, "sword.taiyue" :),

  }));
  set_skill("dodge", 200);
  set_skill("parry", 190);
  set_skill("sword", 180);
  set_skill("force", 200);
  set_skill("unarmed", 200);
  set_skill("literate", 180);
  set_skill("hs-zhengqi", 180);
  set_skill("huashan-force", 200);
  set_skill("zixia-shengong", 200);
  set_skill("huashan-sword", 200);
  set_skill("huashan-strike", 200);
  set_skill("tianluo-steps", 200);

  set("perform/huashan/taiyue", 2000);
  set("perform/huashan/yujian", 2000);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");

  create_family("华山派", 15, "掌门");

  set("inquiry", ([
    "独孤九剑": "唉，独孤九剑乃是天下无双的剑法，但我派历史上也只有\n令狐冲和风清扬两位前辈懂得。\n",
    "令狐冲": "令狐冲乃我师叔，他老人家仙逝也有十几年了。\n",
    "老沈": "嘿嘿，你可别小看他，他可是我的师伯，还是令狐师叔的高徒，武功\n尤在我之上，只是他早对江湖厌倦，隐居于华山卖凉茶，不理江湖恩怨了。\n",
    "华山剑谱": "前几日来了个小偷，盗走了剑谱，我正派人找呢。\n",
  ]));
  setup();
  carry_object(__DIR__ "weapon/sword");
  carry_object(__DIR__ "obj/silk-cloth")->wear();
}
void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
