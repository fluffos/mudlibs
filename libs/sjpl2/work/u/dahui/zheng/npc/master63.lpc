// thekid.c
#include <ansi.h> 
inherit NPC;

void create()
{
        set_name("徐达", ({ "xu da", "xu" }) );
        set("gender", "男性");
        set("nickname", HIR"追魂夺命剑"NOR);
        set("age",37);
        set("long",@LONG
徐达原为魔教中人，四年前因称欲改邪归正而投于华山门下，但其为
人仍保留在魔教的作风，出手毒辣，常奉师命下山诛杀那些大奸大恶
之人每次都完成得十分漂亮，因此莫天雄十分信任他，派他在这看守
内书房。徐达一身武功融正邪于一身，已是一等一的高手。
LONG
        );
        set("attitude", "peaceful");
        set("int", 20);
        set("cor", 25);
        set("agi", 18);
        set("con", 25);
        set("str", 30);
        set("tol", 15);
        set("spi", 17);
        set("dur", 23);
        set("per", 12);
        set("fle", 21);
        set("cps", 19);
        set("max_force", 2000);
        set("force", 3500);
        set("force_factor", 70);
        set("combat_exp", 800000);
        set("score", 30000);
        set("daode", 5000);

        set_skill("dodge", 140);
        set_skill("parry", 140);
        set_skill("sword", 140);
        set_skill("force", 120);
        set_skill("unarmed", 120);
        set_skill("literate", 50);
        set_skill("hs-zhengqi", 30);
        set_skill("huashan-force", 120);
        set_skill("huashan-sword", 140);
        set_skill("huashan-strike", 120);
        set_skill("tianluo-steps", 140);
//      set_skill("tm-sword", 150);

        set("perform/huashan/taiyue",1000);

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "huashan-force");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");

        create_family("华山派", 16, "弟子");

        setup();
        carry_object(__DIR__"weapon/sword");
        carry_object(__DIR__"obj/jinzhuang")->wear();
}
void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

